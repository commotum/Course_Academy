nLet's compute the unknown elements of $AB,$ one element at a time:\n\n$$\n\\begin{aligned} & [\\begin{aligned}2 & -1 & 0 \\\\ 4 & 3 & 1\\end{aligned}][\\begin{aligned}1 & 2 \\\\ -3 & 0 \\\\ 5 & -1\\end{aligned}]=[\\begin{aligned}5 & 4 \\\\ 0 & ∗\\end{aligned}], &  & \\,5=2\\cdot 1+(-1)\\cdot (-3)+0\\cdot 5 \\\\  & [\\begin{aligned}2 & -1 & 0 \\\\ 4 & 3 & 1\\end{aligned}][\\begin{aligned}1 & 2 \\\\ -3 & 0 \\\\ 5 & -1\\end{aligned}]=[\\begin{aligned}5 & 4 \\\\ 0 & 7\\end{aligned}], &  & \\,7=4\\cdot 2+3\\cdot 0+1\\cdot (-1)\\end{aligned}\n$$\n\nTherefore,\n\n$$\nAB=[\\begin{aligned}5 & 4 \\\\ 0 & 7\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-317847/field-1" "q-317847/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "92dd864a-8bc0-547c-84c9-ffd562909315"] :knowledge-point/questions ["q-317847"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129496/selection/2fc2e0e56ffe1506ff781b31e9de4ff41d49ea6924a9cc0ece986d869383d613" :answer/id #uuid "9645efe6-75ef-565e-9866-844ac5d4107c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-6 & 12\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-129496/selection/c71d650c6f509d07cb5a98250fd1aae5462f83e0094ea13caf4995df49745a51" :answer/id #uuid "d40096ae-a894-5da9-81ca-25494ccfc531" :answer/type :answer.type/math :answer/value "[\\begin{aligned}10 \\\\ -4 \\\\ 8\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-129496/selection/21ea1c80d16aa34c3c6b5e2a14ddf72fcde2666b1ee8cf98df8328146b8834a5" :answer/id #uuid "b880d45c-201a-5580-98af-87ee30ea651d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}12 & 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-129496/selection/83bf890baae5927d7022d2dbe8c08f411fa8d70d27718a191b8cd4316bf44bf3" :answer/id #uuid "9f229e6c-2aeb-507d-8b93-6853b7fa7032" :answer/type :answer.type/math :answer/value "[\\begin{aligned}15 & 9\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-129496/selection/5cb9ebb79890e5332ebc1a3255ca93fc3b9bd2e8203f62e2beaea4737dc8bbb9" :answer/id #uuid "f050807e-f61b-5057-b7c3-7ed60912f070" :answer/type :answer.type/math :answer/value "[\\begin{aligned}22 & 9\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-129496/selection" :answer-field/id #uuid "cd8ae80c-92ec-598e-bc37-4f1a3c90a0cd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129496/selection/5cb9ebb79890e5332ebc1a3255ca93fc3b9bd2e8203f62e2beaea4737dc8bbb9" :answer-field/choices ["q-129496/selection/2fc2e0e56ffe1506ff781b31e9de4ff41d49ea6924a9cc0ece986d869383d613" "q-129496/selection/c71d650c6f509d07cb5a98250fd1aae5462f83e0094ea13caf4995df49745a51" "q-129496/selection/21ea1c80d16aa34c3c6b5e2a14ddf72fcde2666b1ee8cf98df8328146b8834a5" "q-129496/selection/83bf890baae5927d7022d2dbe8c08f411fa8d70d27718a191b8cd4316bf44bf3" "q-129496/selection/5cb9ebb79890e5332ebc1a3255ca93fc3b9bd2e8203f62e2beaea4737dc8bbb9"] :db/ensure [:answer-field/validate]} {:db/id "q-129496" :question/id #uuid "19539af7-afd1-5493-a91f-368214eb0f6e" :question/math-academy-id "q-129496" :question/problem "Find $XY$,  if  $X=[\\begin{aligned}5 & -2 & 4\\end{aligned}]$ and $Y=[\\begin{aligned}2 & 3 \\\\ -2 & 1 \\\\ 2 & -1\\end{aligned}].$" :question/worked-solution "Here, $X$ is a $1\\times 3$ matrix and $Y$ is a $3\\times 2$ matrix. \n\nThere are $3$ columns in $X$ and $3$ rows in $Y,$ so $X$ and $Y$ are conformable for multiplication:\n\n$$\n{X}_{1\\times \\boxed{\\text{3}}}{\\cdot }_{✓}{Y}_{\\boxed{\\text{3}}\\times 2}={XY}_{1\\times 2}\n$$\n\nLet's compute $XY,$ one element at a time:\n\n$$\n\\begin{aligned} & [\\begin{aligned}5 & -2 & 4\\end{aligned}][\\begin{aligned}2 & 3 \\\\ -2 & 1 \\\\ 2 & -1\\end{aligned}]=[\\begin{aligned}22 & ∗\\end{aligned}], &  & \\,22=5\\cdot 2+(-2)\\cdot (-2)+4\\cdot 2 \\\\  & [\\begin{aligned}5 & -2 & 4\\end{aligned}][\\begin{aligned}2 & 3 \\\\ -2 & 1 \\\\ 2 & -1\\end{aligned}]=[\\begin{aligned}22 & 9\\end{aligned}], &  & \\,9=5\\cdot 3+(-2)\\cdot 1+4\\cdot (-1)\\end{aligned}\n$$\n\nTherefore, \n$XY=[\\begin{aligned}22 & 9\\end{aligned}].$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-129496/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "92dd864a-8bc0-547c-84c9-ffd562909315"] :knowledge-point/questions ["q-129496"] :db/ensure [:knowledge-point/validate]} {:db/id "q-317848/field-1/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "00e74b05-392a-5179-b1f0-a5f316634188" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-317848/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "1c7f7655-8c9a-58c6-9f6f-f23c33d44a24" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-317848/field-1" :answer-field/id #uuid "366a3d39-6762-58ff-8e77-2343751ccea3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317848/field-1/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer-field/choices ["q-317848/field-1/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" "q-317848/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-317848/field-2/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "34bbace8-8a5e-5af2-9279-cb4cbe38a1af" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-317848/field-2" :answer-field/id #uuid "46a56a97-585f-516a-9cd3-712ae9cbc014" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317848/field-2/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-317848/field-2/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-317848" :question/id #uuid "3dc50e98-61c5-5f25-8298-f940a1fdb966" :question/math-academy-id "q-317848" :question/problem "Determine $AB$ given that \n$A=[\\begin{aligned}1 & 0 & -2 & 3 \\\\ 4 & 1 & 0 & -1\\end{aligned}]$\nand\n$B=[\\begin{aligned}2 & -1 \\\\ 1 & 3 \\\\ 0 & 4 \\\\ -2 & 1\\end{aligned}].$\n\n| $AB=\\,\\,$ |  | {{field-1}} | $-6$ |  |\n| --- | --- | --- | --- | --- |\n|  | $11$ | {{field-2}} |  |  |" :question/worked-solution "Here, $A$ is a $2\\times 4$ matrix and $B$ is a $4\\times 2$ matrix. \n\nThere are $4$ columns in $A$ and $4$ rows in $B,$ so $A$ and $B$ are conformable for multiplication:\n\n$$\n{A}_{2\\times \\boxed{\\text{4}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{4}}\\times 2}={AB}_{2\\times 2}\n$$\n\nLet's compute the unknown elements of $AB,$ one element at a time:\n\n$$\n\\begin{aligned} & [\\begin{aligned}1 & 0 & -2 & 3 \\\\ 4 & 1 & 0 & -1\\end{aligned}][\\begin{aligned}2 & -1 \\\\ 1 & 3 \\\\ 0 & 4 \\\\ -2 & 1\\end{aligned}]=[\\begin{aligned}-4 & -6 \\\\ 11 & ∗\\end{aligned}], &  & \\,-4=1\\cdot 2+0\\cdot 1+(-2)\\cdot 0+3\\cdot (-2) \\\\  & [\\begin{aligned}1 & 0 & -2 & 3 \\\\ 4 & 1 & 0 & -1\\end{aligned}][\\begin{aligned}2 & -1 \\\\ 1 & 3 \\\\ 0 & 4 \\\\ -2 & 1\\end{aligned}]=[\\begin{aligned}-4 & -6 \\\\ 11 & -2\\end{aligned}], &  & \\,-2=4\\cdot (-1)+1\\cdot 3+0\\cdot 4+(-1)\\cdot 1\\end{aligned}\n$$\n\nTherefore,\n\n$$\nAB=[\\begin{aligned}-4 & -6 \\\\ 11 & -2\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-317848/field-1" "q-317848/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "92dd864a-8bc0-547c-84c9-ffd562909315"] :knowledge-point/questions ["q-317848"] :db/ensure [:knowledge-point/validate]} {:db/id "q-1035/selection/1e53f505626dafed790382a86780e2a1898d1cb4b55715b60e41356ad4ac65e2" :answer/id #uuid "11187f3b-1bcb-596c-9f51-5d9418a82bfc" :answer/type :answer.type/math :answer/value "[\\begin{aligned}24 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-1035/selection/46e651dd6ecf6bc9008a687cbc6748dc877c3b64e352f471cb84531d630424e2" :answer/id #uuid "392edab7-655c-5162-a4b4-bada8ec33f3c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}20 \\\\ 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-1035/selection/a5b0f25aa396dd4c561ed76d31981df6067eba0525eedd25480aec464681b5c4" :answer/id #uuid "460f3c33-9362-55a2-af9e-ab4d0693fcc1" :answer/type :answer.type/math :answer/value "[\\begin{aligned}20 & 24 \\\\ 4 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-1035/selection/ff4db88b60f60385f88998af3066ddcdc5f369b33de4eec6d65eb801e1613f30" :answer/id #uuid "eb60d008-dcf2-50be-a70e-3a28969daef4" :answer/type :answer.type/math :answer/value "[\\begin{aligned}12 & -24\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-1035/selection/ae2da2b0f6a59cb2874af5359c9cd3a7f131dd15a817df4214b779690d15c516" :answer/id #uuid "61330e29-da40-50af-9e64-86a4db773926" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-20 \\\\ -4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-1035/selection" :answer-field/id #uuid "e3da0ad9-f9c5-5cd8-a0a9-221064800de5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-1035/selection/1e53f505626dafed790382a86780e2a1898d1cb4b55715b60e41356ad4ac65e2" :answer-field/choices ["q-1035/selection/1e53f505626dafed790382a86780e2a1898d1cb4b55715b60e41356ad4ac65e2" "q-1035/selection/46e651dd6ecf6bc9008a687cbc6748dc877c3b64e352f471cb84531d630424e2" "q-1035/selection/a5b0f25aa396dd4c561ed76d31981df6067eba0525eedd25480aec464681b5c4" "q-1035/selection/ff4db88b60f60385f88998af3066ddcdc5f369b33de4eec6d65eb801e1613f30" "q-1035/selection/ae2da2b0f6a59cb2874af5359c9cd3a7f131dd15a817df4214b779690d15c516"] :db/ensure [:answer-field/validate]} {:db/id "q-1035" :question/id #uuid "07a1dff2-e7c5-5216-8b23-f0d5e4981e24" :question/math-academy-id "q-1035" :question/problem "Find $ST$,  if  $S=[\\begin{aligned}2 & -3 & 1 & 4\\end{aligned}]$ and $T=[\\begin{aligned}1 & -2 \\\\ 0 & 4 \\\\ -2 & 1 \\\\ 6 & 4\\end{aligned}].$" :question/worked-solution "Here, $S$ is a $1\\times 4$ matrix and $T$ is a $4\\times 2$ matrix. \n\nThere are $4$ columns in $S$ and $4$ rows in $T,$ so $S$ and $T$ are conformable for multiplication:\n\n$$\n{S}_{1\\times \\boxed{\\text{4}}}{\\cdot }_{✓}{T}_{\\boxed{\\text{4}}\\times 2}={ST}_{1\\times 2}\n$$\n\nLet's compute $ST,$ one element at a time:\n\n$$\n\\begin{aligned} & [\\begin{aligned}2 & -3 & 1 & 4\\end{aligned}][\\begin{aligned}1 & -2 \\\\ 0 & 4 \\\\ -2 & 1 \\\\ 6 & 4\\end{aligned}]=[\\begin{aligned}24 & ∗\\end{aligned}], &  & \\,24=2\\cdot 1+(-3)\\cdot 0+1\\cdot (-2)+4\\cdot 6 \\\\  & [\\begin{aligned}2 & -3 & 1 & 4\\end{aligned}][\\begin{aligned}1 & -2 \\\\ 0 & 4 \\\\ -2 & 1 \\\\ 6 & 4\\end{aligned}]=[\\begin{aligned}24 & 1\\end{aligned}], &  & \\,1=2\\cdot (-2)+(-3)\\cdot 4+1\\cdot 1+4\\cdot 4\\end{aligned}\n$$\n\nTherefore, \n$ST=[\\begin{aligned}24 & 1\\end{aligned}].$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-1035/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "92dd864a-8bc0-547c-84c9-ffd562909315"] :knowledge-point/questions ["q-1035"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70949/selection/23c0b4da815e7ba954fedc5e75955047cfe471feec4d2029849a63511c000fa3" :answer/id #uuid "4f7fbc9b-77e6-5454-89ed-04197e61d223" :answer/type :answer.type/math :answer/value "-11" :db/ensure [:answer/validate]} {:db/id "q-70949/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "c654ea52-9d09-5363-81b1-b00aca47d558" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-70949/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "1fef5080-abf0-58b3-a46e-69f296ce2680" :answer/type :answer.type/math :answer/value "1" :db/ensure [:a