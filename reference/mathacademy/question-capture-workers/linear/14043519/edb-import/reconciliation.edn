\cdot 6+1\\cdot (-3) \\\\  & [\\begin{aligned}2 & -1 & 1 \\\\ 1 & 0 & 2\\end{aligned}][\\begin{aligned}-3 & 2 \\\\ 6 & 5 \\\\ -3 & 4\\end{aligned}]=[\\begin{aligned}-15 & 3 \\\\ ∗ & ∗\\end{aligned}], &  & \\,3=2\\cdot 2+(-1)\\cdot 5+1\\cdot 4 \\\\  & [\\begin{aligned}2 & -1 & 1 \\\\ 1 & 0 & 2\\end{aligned}][\\begin{aligned}-3 & 2 \\\\ 6 & 5 \\\\ -3 & 4\\end{aligned}]=[\\begin{aligned}-15 & 3 \\\\ -9 & ∗\\end{aligned}], &  & \\,-9=1\\cdot (-3)+0\\cdot 6+2\\cdot (-3) \\\\  & [\\begin{aligned}-2 & 1 & 1 \\\\ 1 & 0 & 2\\end{aligned}][\\begin{aligned}-3 & 2 \\\\ 6 & 5 \\\\ -3 & 4\\end{aligned}]=[\\begin{aligned}-15 & 3 \\\\ -9 & 10\\end{aligned}], &  & \\,10=1\\cdot 2+0\\cdot 5+2\\cdot 4\\end{aligned}\n$$\n\nTherefore, \n$AB=[\\begin{aligned}-15 & 3 \\\\ -9 & 10\\end{aligned}].$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043519/state.json" "file_sha256" "cfbcf7b6e5c1f7aa53f14785f46e107e947eba6c126c52ca1290c2fd9cec4692"} {"question" "q-129495" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043519/activity-metadata.json" "file_sha256" "5e6c172c2caa6d0d0725c2b891546114c170f4d73ee6417c0178db562015d18c"} {"question" "q-129495" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043519/state.json" "file_sha256" "cfbcf7b6e5c1f7aa53f14785f46e107e947eba6c126c52ca1290c2fd9cec4692"} {"question" "q-129495" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-15 & 10 \\\\ -2 & -3\\end{aligned}]"] ["math" "[\\begin{aligned}-15 & 3 \\\\ -9 & 10\\end{aligned}]"] ["math" "[\\begin{aligned}-5 & 6 \\\\ -3 & 10\\end{aligned}]"] ["math" "[\\begin{aligned}-9 & 10 \\\\