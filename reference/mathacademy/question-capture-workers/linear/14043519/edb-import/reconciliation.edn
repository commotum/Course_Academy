nd{aligned}].$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13989257/state.json" "file_sha256" "939378941b1b240fc9eda29d1c952f1e9dc654ef59d6525bdca716014224e3ff" "basis" 992 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13989257/edb-import/verification.json"} {"question" "q-129495" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13989257/activity-metadata.json" "file_sha256" "7d96e938c0db5aa001000cfa946e741477822f22159b87d2b18f23ef7c43eed6" "basis" 992 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13989257/edb-import/verification.json"} {"question" "q-129495" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13989257/state.json" "file_sha256" "939378941b1b240fc9eda29d1c952f1e9dc654ef59d6525bdca716014224e3ff" "basis" 992 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13989257/edb-import/verification.json"} {"question" "q-129495" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}-15 & 10 \\\\ -2 & -3\\end{aligned}]"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13989257/state.json" "file_sha256" "939378941b1b240fc9eda29d1c952f1e9dc654ef59d6525bdca716014224e3ff" "basis" 992 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13989257/edb-import/verification.json"} {"question" "q-129495" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}-15 & 3 \\\\ -9 & 10\\end{aligned}]"] "category" "ma_capture" "file" "/home/jake/Deve