\\\ ∗ & ∗\\end{aligned}], &  & \\,6=2\\cdot 3 \\\\  & [\\begin{aligned}2 \\\\ -1\\end{aligned}][\\begin{aligned}-2 & 3\\end{aligned}]=[\\begin{aligned}-4 & 6 \\\\ 2 & ∗\\end{aligned}], &  & \\,2=-1\\cdot -2 \\\\  & [\\begin{aligned}2 \\\\ -1\\end{aligned}][\\begin{aligned}-2 & 3\\end{aligned}]=[\\begin{aligned}-4 & 6 \\\\ 2 & -3\\end{aligned}], &  & \\,-3=-1\\cdot 3\\end{aligned}\n$$\n\nTherefore, \n$AB=[\\begin{aligned}-4 & 6 \\\\ 2 & -3\\end{aligned}].$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043519/state.json" "file_sha256" "cfbcf7b6e5c1f7aa53f14785f46e107e947eba6c126c52ca1290c2fd9cec4692"} {"question" "q-275545" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043519/activity-metadata.json" "file_sha256" "5e6c172c2caa6d0d0725c2b891546114c170f4d73ee6417c0178db562015d18c"} {"question" "q-275545" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043519/state.json" "file_sha256" "cfbcf7b6e5c1f7aa53f14785f46e107e947eba6c126c52ca1290c2fd9cec4692"} {"question" "q-275545" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-4"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043519/state.json" "file_sha256" "cfbcf7b6e5c1f7aa53f14785f46e107e947eba6c126c52ca1290c2fd9cec4692"} {"question" "q-275545" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043519/state.json" "file_sha256" "cfbcf7b6e5c1f7aa53f14785f46e107e947eba