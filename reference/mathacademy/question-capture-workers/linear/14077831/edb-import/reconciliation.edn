d ${\\sigma }_{2}=4.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077831/state.json" "file_sha256" "8db308feb568fa0c1c2b6c0d11e8647c4baf266f2cbe17415f677e15d5c71807"} {"question" "q-139550" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077831/activity-metadata.json" "file_sha256" "13159d7d5c6860406c5296d68a4d24ed916db843734f36548e75b4a55bbef43c"} {"question" "q-139550" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077831/state.json" "file_sha256" "8db308feb568fa0c1c2b6c0d11e8647c4baf266f2cbe17415f677e15d5c71807"} {"question" "q-139550" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "$18$ and $8$"] ["text" "$3$ and $\\sqrt{2}$"] ["text" "$9$ and $4$"] ["text" "$9{v}_{1}$ and $4{v}_{1}$"] ["text" "${v}_{1}$ and ${v}_{1}$"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077831/state.json" "file_sha256" "8db308feb568fa0c1c2b6c0d11e8647c4baf266f2cbe17415f677e15d5c71807"} {"question" "q-139550" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "$9$ and $4$"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077831/state.json" "file_sha256" "8db308feb568fa0c1c2b6c0d11e8647c4baf266f2cbe17415f677e15d5c71807"} {"question" "q-139547" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077831/assets/d4947e37239d2ac2950b536d7afc2d0810ea713c437b7095a43e123d50ff2b34.png