n \n\nTherefore, the semi-major axis of our ellipse is ${\\sigma }_{1}=6.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-139542/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fd0e91f0-abbc-52e2-8d8b-94597e4892cd"] :knowledge-point/questions ["q-139542"] :db/ensure [:knowledge-point/validate]} {:db/id "q-139541/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "f0509299-f403-5509-9ee8-bab8ec47a49f" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-139541/selection/f8f12b478d0323f303a6e66b7a5ba6a7f9a8c130ea62fc433a4fcbcf716a57c6" :answer/id #uuid "d9b69228-fcd0-5024-9b40-7247b0e65f82" :answer/type :answer.type/math :answer/value "5\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-139541/selection/4ef0fcc340e40ad6bcef1c832215cd28abf240aabeed43296dfece28d20d1935" :answer/id #uuid "423b097e-f5ad-5a52-bdb0-0076f40e34e8" :answer/type :answer.type/math :answer/value "\\sqrt{10}" :db/ensure [:answer/validate]} {:db/id "q-139541/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "d03e6e09-c0ca-50ee-adfc-d2fde9f95f72" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-139541/selection/219347bb4a6f51134d7f5aff5da33544f44afee934064621ebff9cf9e335ee59" :answer/id #uuid "524e30eb-87c6-5cfc-a4a2-a7116a462d5a" :answer/type :answer.type/math :answer/value "\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "q-139541/selection" :answer-field/id #uuid "8b6cbd92-c5a9-5668-a313-a79d3f989987" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-139541/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-139541/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-139541/selection/f8f12b478d0323f303a6e66b7a5ba6a7f9a8c130ea62fc433a4fcbcf716a57c