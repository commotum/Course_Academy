T}\\,{A}^{T})(Ax) \\\\  & ={x}^{T}\\,({A}^{T}\\,A)x,\\end{aligned}\n$$\n\n  \n\nwhere ${x}^{T}({A}^{T}A)x$ is the quadratic form with the matrix ${A}^{T}A.$ \n\nThe maximum value of this quadratic form, when $‖x‖=1,$ is equal to the largest eigenvalue of the matrix ${A}^{T}A.$\n\nSince the largest eigenvalue of ${A}^{T}A$ is $12,$ we obtain\n\n$$\n{max}_{‖x‖=1}{‖Ax{‖}^{2}}=12\\,⟹\\,{max}_{‖x‖=1}{‖Ax‖}=\\sqrt{12}=2\\sqrt{3}.\n$$\n\n \n\nTherefore, the semi-major axis of our ellipse is $2\\sqrt{3}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-139492/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d116374b-b693-5d50-8019-fcc5a7766b9b"] :knowledge-point/questions ["q-139492"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-139415"] :question/problem "A $2\\times 3$ matrix $A$ maps the unit sphere ${x\\,|\\,‖x‖=1}$ from ${R}^{3}$ onto an ellipse in ${R}^{2}.$ Given that the eigenvalues of ${A}^{T}A$ are $5,$ $3,$ and $0,$ find the length of the ellipse's semi-major axis." :question/worked-solution "The matrix $A$ maps the unit sphere ${x\\,|\\,‖x‖=1}$ from ${R}^{3}$ onto the ellipse ${Ax\\,|\\,‖x‖=1}$ in ${R}^{2}.$\n\nFirst, let's re-write the squared distance from the origin to the point $Ax$ on our ellipse, as follows:\n\n$$\n\\begin{aligned}‖Ax{‖}^{2} & =(Ax)^{T}(Ax) \\\\  & =({x}^{T}\\,{A}^{T})(Ax) \\\\  & ={x}^{T}\\,({A}^{T}\\,A)x,\\end{aligned}\n$$\n\n  \n\nwhere ${x}^{T}({A}^{T}A)x$ is the quadratic form with the matrix ${A}^{T}A.$ \n\nThe maximum value of this quadratic form, when $‖x‖=1,$ is equal to the largest eigenvalue of the matrix ${A}^{T}A.$\n\nSince the largest eigenvalue of ${A}^{T}A$ is $5,$ we obtain\n\n$$\n{max}_{‖x‖=1}{‖Ax{‖}^{2}}=5\\,⟹\\,{max}_{‖x‖=1}{‖Ax‖}=\\sqrt{5}.\n$$\n\n \n\nTherefore, the semi-major axis of our ellipse is $\\sqrt{5}.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-139528/selection/9f6bfd6