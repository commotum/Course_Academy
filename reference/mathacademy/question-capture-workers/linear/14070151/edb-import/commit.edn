  & \\begin{aligned}{R}_{1}:=\\frac{1}{8}{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & -\\frac{1}{2} & \\frac{5}{4} & -\\frac{1}{4} \\\\ 2 & 2 & 2 & 2\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}-2{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & -\\frac{1}{2} & \\frac{5}{4} & -\\frac{1}{4} \\\\ 0 & 3 & -\\frac{1}{2} & \\frac{5}{2}\\end{aligned}] &  & \\begin{aligned}{R}_{2}:=\\frac{1}{3}{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & -\\frac{1}{2} & \\frac{5}{4} & -\\frac{1}{4} \\\\ 0 & 1 & -\\frac{1}{6} & \\frac{5}{6}\\end{aligned}] &  & \\begin{aligned}{R}_{1}:={R}_{1}+\\frac{1}{2}{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & \\frac{7}{6} & \\frac{1}{6} \\\\ 0 & 1 & -\\frac{1}{6} & \\frac{5}{6}\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n[\\,T\\,]_{B}=[\\begin{aligned}\\frac{7}{6} & \\frac{1}{6} \\\\ -\\frac{1}{6} & \\frac{5}{6}\\end{aligned}].\n$$" 13194139535767 true] [17592186365277 1000 #edb/ref 17592186365278 13194139535767 true] [17592186365277 1000 #edb/ref 17592186365279 13194139535767 true] [17592186365277 1000 #edb/ref 17592186365280 13194139535767 true] [17592186365277 1000 #edb/ref 17592186365281 13194139535767 true] [17592186365277 1000 #edb/ref 17592186365282 13194139535767 true] [17592186365277 1040 #edb/ref 17592186045450 13194139535767 true] [17592186365277 1041 "selection" 13194139535767 true] [17592186365277 1104 #edb/ref 17592186365282 13194139535767 true] [17592186365277 1110 #uuid "90fbf554-932a-5d03-80b4-8ca780d58d86" 13194139535767 true] [17592186365278 1034 "[\\begin{aligned}1 & 0 \\\\ -\\frac{1}{6} & \\frac{5}{6}\\end{aligned}]" 13194139535767 true] [17592186365278 1103 #edb/ref 17592186045453 13194139535767 true] [17592186365278 1111 #uuid "1649d14f-54d9-5949-a983-9ee90b1747db" 13194139535767 true] [17592186365279 1034 "[\\begin{aligned}\\frac{8}{6} & 2 \\\\ -\\frac{5}{6} & \\frac{5}{6}\\end{aligned}]" 13194139535767 true] [17592186365279 1103 #edb/ref 17592186045453 13194139535767 true]