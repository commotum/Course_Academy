2} & T({b}_{1}) & T({b}_{2}) \\\\ | & | & | & |\\end{aligned}].\n$$\n\nNow, we reduce the left-hand side to reduced row echelon form using Gaussian elimination. Then, on the right-hand side, we will obtain the $B$-matrix for $T:$\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 1 & 3 & 5 \\\\ 1 & 2 & -1 & 2\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}-{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 1 & 3 & 5 \\\\ 0 & 1 & -4 & -3\\end{aligned}] &  & \\begin{aligned}{R}_{1}:={R}_{1}-{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & 7 & 8 \\\\ 0 & 1 & -4 & -3\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n[\\,T\\,]_{B}=[\\begin{aligned}7 & 8 \\\\ -4 & -3\\end{aligned}].\n$$" 13194139535767 true] [17592186365284 1000 #edb/ref 17592186365285 13194139535767 true] [17592186365284 1000 #edb/ref 17592186365286 13194139535767 true] [17592186365284 1000 #edb/ref 17592186365287 13194139535767 true] [17592186365284 1000 #edb/ref 17592186365288 13194139535767 true] [17592186365284 1000 #edb/ref 17592186365289 13194139535767 true] [17592186365284 1040 #edb/ref 17592186045450 13194139535767 true] [17592186365284 1041 "selection" 13194139535767 true] [17592186365284 1104 #edb/ref 17592186365287 13194139535767 true] [17592186365284 1110 #uuid "3703df40-3179-5bd7-ac77-0777e13c696f" 13194139535767 true] [17592186365285 1034 "[\\begin{aligned}7 & -4 \\\\ 8 & -3\\end{aligned}]" 13194139535767 true] [17592186365285 1103 #edb/ref 17592186045453 13194139535767 true] [17592186365285 1111 #uuid "bbb0c906-41aa-5fbd-a9ef-2ed1b9374135" 13194139535767 true] [17592186365286 1034 "[\\begin{aligned}-4 & -3 \\\\ 7 & 8\\end{aligned}]" 13194139535767 true] [17592186365286 1103 #edb/ref 17592186045453 13194139535767 true] [17592186365286 1111 #uuid "e1afe158-a3bd-5472-acb5-5d8f2311e133" 13194139535767 true] [17592186365287 1034 "[\\begin{aligned}7 & 8 \\\\ -4 & -3\\end{aligned}]" 13194139535767 true] [17592186365287 1103 #edb/ref 17592186045453 13194139535767 true] [17592186365287 1111 #uuid "45cf231b-bcb0-550b-a16b-e1a5eac1516b" 13194139535767 true] [17592186365288 1034 "[\\begin{aligned}8 & 7 \\\\ -3 & -4\\end{aligned}]" 13194139535767 true] [17592186365288 1103 #edb/ref 17592186045453 13194139535767 true] [17592186365288 1111 #uuid "59707974-1c8a-5bcd-9699-b38eb1633877" 13194139535767 true] [17592186365289 1034 "[\\begin{aligned}-3 & 8 \\\\ -4 & 7\\end{aligned}]" 13194139535767 true] [17592186365289 1103 #edb/ref 17592186045453 13194139535767 true] [17592186365289 1111 #uuid "f780fbd2-e3b7-5817-b790-2fd8ae2810ca" 13194139535767 true] [17592186365290 1017 #edb/ref 17592186365291 13194139535767 true] [17592186365290 1089 "q-82496" 13194139535767 true] [17592186365290 1091 #edb/ref 17592186045464 13194139535767 true] [17592186365290 1100 "The basis $B$ of ${R}^{3}$ and the matrix $[\\,T\\,]_{B}$ of the linear transformation $T:{R}^{3}\\to {R}^{3}$ relative to $B$ are given by\n\n$$\nB={[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}],[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}0 \\\\ 0 \\\\ 2\\end{aligned}]},\\,[\\,T\\,]_{B}=[\\begin{aligned}2 & -1 & c \\\\ a & 1 & 0 \\\\ -\\frac{3}{2} & b & -2\\end{aligned}].\n$$\n\nWhat is the value of $\\,a+b+c,\\,$ given that  \n\n$$\nT([\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}])=[\\begin{aligned}x-y+z \\\\ x+y \\\\ y-z\\end{aligned}]\n$$" 13194139535767 true] [17592186365290 1113 #uuid "90b6c4fc-18d0-517d-977f-8977fe2f7ba4" 13194139535767 true] [17592186365290 1145 "Let's denote the vectors of $B$ as ${{b}_{1},{b}_{2},{b}_{3}}.$ The $B$-matrix for $T$ is a matrix whose columns are the coordinates of the vectors $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B.$\n\nFirst, let's find the image of ${b}_{1},$ ${b}_{2},$ and ${b}_{3}$ under $T,$ as follows:\n\n$$\n\\begin{aligned}T({b}_{1}) & =T([\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}])=[\\begin{aligned}2 \\\\ 1 \\\\ -1\\end{aligned}] \\\\ T({b}_{2}) & =T([\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}])=[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}] \\\\ T({b}_{3}) & =T([\\begin{aligned}0 \\\\ 0 \\\\ 5\\end{aligned}])=[\\begin{aligned}2 \\\\ 0 \\\\ -2\\end{aligned}]\\end{aligned}\n$$\n\nTo find the coordinates of $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B$, we consider the matrix\n\n$$\nM=[\\begin{aligned}| & | & | & | & | & | \\\\ {b}_{1} & {b}_{2} & {b}_{3} & T({b}_{1}) & T({b}_{2}) & T({b}_{3}) \\\\ | & | & | & | & | & |\\end{aligned}].\n$$\n\nNow, we reduce the left-hand side to reduced row echelon form using Gaussian elimination. Then, on the right-hand side, we will obtain the $B$-matrix for $T:$\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 0 & 0 & 2 & -1 & 2 \\\\ 0 & 1 & 0 & 1 & 1 & 0 \\\\ 1 & 0 & 2 & -1 & 1 & -2\\end{aligned}] &  & \\begin{aligned}{R}_{3}:={R}_{3}-{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 2 & -1 & 2 \\\\ 0 & 1 & 0 & 1 & 1 & 0 \\\\ 0 & 0 & 2 & -3 & 2 & -4\\end{aligned}] &  & \\begin{aligned}{R}_{3}:=\\frac{1}{2}{R}_{3}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 2 & -1 & 2 \\\\ 0 & 1 & 0 & 1 & 1 & 0 \\\\ 0 & 0 & 1 & -\\frac{3}{2} & 1 & -2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n[\\,T\\,]_{B}=[\\begin{aligned}2 & -1 & 2 \\\\ 1 & 1 & 0 \\\\ -\\frac{3}{2} & 1 & -2\\end{aligned}].\n$$\n\nFinally, $a=1,$ $b=1,$ $c=2$ and \n\n$$\na+b+c=1+1+2=4.\n$$" 13194139535767 true] [17592186365291 1000 #edb/ref 17592186365292 13194139535767 true] [17592186365291 1000 #edb/ref 17592186365293 13194139535767 true] [17592186365291 1000 #edb/ref 17592186365294 13194139535767 true] [17592186365291 1000 #edb/ref 17592186365295 13194139535767 true] [17592186365291 1000 #edb/ref 17592186365296 13194139535767 true] [17592186365291 1040 #edb/ref 17592186045450 13194139535767 true] [17592186365291 1041 "selection" 13194139535767 true] [17592186365291 1104 #edb/ref 17592186365295 13194139535767 true] [17592186365291 1110 #uuid "631d070c-197a-547c-89c3-d64b47b42139" 13194139535767 