igned}5 \\\\ 2\\end{aligned}],\\,$ and $\\,B={[\\begin{aligned}1 \\\\ 1\\end{aligned}],[\\begin{aligned}1 \\\\ 2\\end{aligned}]}.$" :question/worked-solution "Let's denote the vectors of $B$ as ${{b}_{1},{b}_{2}}.$ The $B$-matrix for $T$ is a matrix whose columns are the coordinates of the vectors $T({b}_{1})$ and $T({b}_{2})$ relative to the basis $B.$\n\nTo find the coordinates of $T({b}_{1})$ and $T({b}_{2})$ relative to the basis $B$, we consider the matrix\n\n$$\nM=[\\begin{aligned}| & | & | & | \\\\ {b}_{1} & {b}_{2} & T({b}_{1}) & T({b}_{2}) \\\\ | & | & | & |\\end{aligned}].\n$$\n\nNow, we reduce the left-hand side to reduced row echelon form using Gaussian elimination. Then, on the right-hand side, we will obtain the $B$-matrix for $T:$\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 1 & 3 & 5 \\\\ 1 & 2 & -1 & 2\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}-{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 1 & 3 & 5 \\\\ 0 & 1 & -4 & -3\\end{aligned}] &  & \\begin{aligned}{R}_{1}:={R}_{1}-{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & 7 & 8 \\\\ 0 & 1 & -4 & -3\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n[\\,T\\,]_{B}=[\\begin{aligned}7 & 8 \\\\ -4 & -3\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-82474/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "56260e5b-1f89-58db-8833-b8efa77b5e9f"] :knowledge-point/questions ["q-82474"] :db/ensure [:knowledge-point/validate]} {:db/id "q-82496/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "369aeef7-3872-5f7c-bd40-d2abc45540fe" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-82496/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "d9bef8eb-cc2c-5a71-af62-a2025f9cca8d" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-82496/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "ead2ede2-4ea0-5dc0-bca9-f1da1d16940d" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-82496/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "fdd6f76e-b089-53e4-8795-33b7dfecdcc8" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-82496/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "a06efe20-a1ee-526e-8cc1-6f434ef554ff" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-82496/selection" :answer-field/id #uuid "631d070c-197a-547c-89c3-d64b47b42139" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-82496/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-82496/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-82496/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-82496/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-82496/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-82496/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-82496" :question/id #uuid "90b6c4fc-18d0-517d-977f-8977fe2f7ba4" :question/math-academy-id "q-82496" :question/problem "The basis $B$ of ${R}^{3}$ and the matrix $[\\,T\\,]_{B}$ of the linear transformation $T:{R}^{3}\\to {R}^{3}$ relative to $B$ are given by\n\n$$\nB={[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}],[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}0 \\\\ 0 \\\\ 2\\end{aligned}]},\\,[\\,T\\,]_{B}=[\\begin{aligned}2 & -1 & c \\\\ a & 1 & 0 \\\\ -\\frac{3}{2} & b & -2\\end{aligned}].\n$$\n\nWhat is the value of $\\,a+b+c,\\,$ given that  \n\n$$\nT([\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}])=[\\begin{aligned}x-y+z \\\\ x+y \\\\ y-z\\end{aligned}]\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${{b}_{1},{b}_{2},{b}_{3}}.$ The $B$-matrix for $T$ is a matrix whose columns are the coordinates of the vectors $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B.$\n\nFirst, let's find the image of ${b}_{1},$ ${b}_{2},$ and ${b}_{3}$ under $T,$ as follows:\n\n$$\n\\begin{aligned}T({b}_{1}) & =T([\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}])=[\\begin{aligned}2 \\\\ 1 \\\\ -1\\end{aligned}] \\\\ T({b}_{2}) & =T([\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}])=[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}] \\\\ T({b}_{3}) & =T([\\begin{aligned}0 \\\\ 0 \\\\ 5\\end{aligned}])=[\\begin{aligned}2 \\\\ 0 \\\\ -2\\end{aligned}]\\end{aligned}\n$$\n\nTo find the coordinates of $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B$, we consider the matrix\n\n$$\nM=[\\begin{aligned}| & | & | & | & | & | \\\\ {b}_{1} & {b}_{2} & {b}_{3} & T({b}_{1}) & T({b}_{2}) & T({b}_{3}) \\\\ | & | & | & | & | & |\\end{aligned}].\n$$\n\nNow, we reduce the left-hand side to reduced row echelon form using Gaussian elimination. Then, on the right-hand side, we will obtain the $B$-matrix for $T:$\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 0 & 0 & 2 & -1 & 2 \\\\ 0 & 1 & 0 & 1 & 1 & 0 \\\\ 1 & 0 & 2 & -1 & 1 & -2\\end{aligned}] &  & \\begin{aligned}{R}_{3}:={R}_{3}-{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 2 & -1 & 2 \\\\ 0 & 1 & 0 & 1 & 1 & 0 \\\\ 0 & 0 & 2 & -3 & 2 & -4\\end{aligned}] &  & \\begin{aligned}{R}_{3}:=\\frac{1}{2}{R}_{3}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 2 & -1 & 2 \\\\ 0 & 1 & 0 & 1 & 1 & 0 \\\\ 0 & 0 & 1 & -\\frac{3}{2} & 1 & -2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n[\\,T\\,]_{B}=[\\begin{aligned}2 & -1 & 2 \\\\ 1 & 1 & 0 \\\\ -\\frac{3}{2} & 1 & -2\\end{aligned}].\n$$\n\nFinally, $a=1,$ $b=1,$ $c=2$ and \n\n$$\na+b+c=1+1+2=4.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-82496/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "22ca4f81-6fec-5822-b281-5ce1e23d399e"] :knowledge-point/questions ["q-82496"] :db/ensure [:knowledge-point/validate]}]
