 {:answer/id #uuid "cc828ed3-0161-5a7c-8ddb-e58055889b59" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186320900}] :answer-field/correct {:answer/id #uuid "2ca819d4-62b8-5b8a-ab01-fa0566a07af4" :answer/type {:db/ident :answer.type/math} :answer/value "-55" :db/id #edb/ref 17592186320898} :answer-field/id #uuid "be267c52-bece-5d9b-9459-908f4bd3dfd3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186320895}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ea1424fe-f77c-5da4-b333-1587877692aa" :question/math-academy-id "q-130682" :question/problem "Suppose $X$ is a $5\\times 5$ matrix and $det(X)=55.$ The matrix $Y$ is obtained from $X$ by applying the elementary row operation ${R}_{5}↔{R}_{3}$ (switching the fifth and the third rows). What is the value of $det(Y)?$" :question/worked-solution "Since swapping any two rows changes the sign of the determinant to the opposite sign, we have\n\n$$\n\\begin{aligned}det(Y) & =-det(X) \\\\  & =-(55) \\\\  & =-55.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186320901 :knowledge-point/_questions [{:knowledge-point/id #uuid "2f11b223-edd2-59b8-b761-164d56e29746" :knowledge-point/title "Calculating a Determinant After Multiplying a Row by a Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88b3f6e9-e5f7-5425-bee6-512cad4946c8" :answer/type {:db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186320903} {:answer/id #uuid "91384f03-38bc-5304-ada4-d1bc608b3c84" :answer/type {:db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186320904} {:answer/id #uuid "c1701c59-fc3a-5b9d-8afc-67854803268c" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186320905} {:answer/id #uuid "f9df9402-e9d1-5cb4-ac18-136b51ff57e3" :answer/type {:db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186320906} {:answer/id #uuid "aeb419b7-5a5c-5a45-9fca-f35cfba8ee47" :answer/type {:db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186320907}] :answer-field/correct {:answer/id #uuid "88b3f6e9-e5f7-5425-bee6-512cad4946c8" :answer/type {:db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186320903} :answer-field/id #uuid "e0df4169-12a3-5638-afd0-87ca09b9130e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186320902}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "100e6634-3f05-5452-b172-3ccda4159e53" :question/math-academy-id "q-130732" :question/problem "Suppose $A$ is a $4\\times 4$ matrix and $det(A)=-63.$ The matrix $B$ is obtained from $A$ by applying the elementary row operation ${R}_{3}:=\\frac{2}{9}{R}_{3}.$ What is the value of $det(B)?$" :question/worked-solution "The row operation applied to $A$ consists of multiplying a row by the number $\\frac{2}{9}.$\n\nWhen we do this, the determinant is multiplied by the same number. So, we have\n\n$$\n\\begin{aligned}det(B) & =\\frac{2}{9}det(A) \\\\  & =\\frac{2}{9}\\cdot (-63) \\\\  & =-14.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186320908 :knowledge-point/_questions [{:knowledge-point/id #uuid "2f11b223-edd2-59b8-b761-164d56e29746" :knowledge-point/title "Calculating a Determinant After Multiplying a Row by a Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "780eac2a-f799-5eaf-8c44-a239111e1cae" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186320910} {:answer/id #uuid "0d6a9d18-6782-55ca-a922-6f0f5aa9b616" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186320911} {:answer/id #uuid "99fbb630-da8e-5361-8cfc-94ff908bf532" :answer/type {:db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186320912} {:answer/id #uuid "a8a979f3-9cba-5