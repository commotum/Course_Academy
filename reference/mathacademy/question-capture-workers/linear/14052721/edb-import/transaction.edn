[{:db/id "q-130536/selection/a87eda55b14aa90512b8290c42bdeb8be42cb617ced3fe61b043cd74ead9bca4" :answer/id #uuid "de515c60-ce9c-5b30-a66e-1f60183adff5" :answer/type :answer.type/math :answer/value "a=-4,\\,b=8,\\,c=-3" :db/ensure [:answer/validate]} {:db/id "q-130536/selection/4c32f25c0ac00e82009fa5be6024749cf24403cfdaa3d147716de28ce3fb2ddc" :answer/id #uuid "c8ba4a9f-e65a-5490-ac8f-28df29be2287" :answer/type :answer.type/math :answer/value "a=-6,\\,b=8,\\,c=5" :db/ensure [:answer/validate]} {:db/id "q-130536/selection/274f18f86ee4f74b72da1822bbaf65afaf5ce14d0f9da4b3523d805fd5ef535b" :answer/id #uuid "4fd6aaf3-2f2b-5b4e-9a66-8e97e1dc63d7" :answer/type :answer.type/math :answer/value "a=1,\\,b=7,\\,c=8" :db/ensure [:answer/validate]} {:db/id "q-130536/selection/f9394419392469f418dd0c71e257f1c21f17ae3decda4e2fe7128644d4f3d7c0" :answer/id #uuid "4befcde8-81c2-5d6a-a25a-429241bec310" :answer/type :answer.type/math :answer/value "a=0,\\,b=8,\\,c=1" :db/ensure [:answer/validate]} {:db/id "q-130536/selection/7ff6109bd70aa7b5ced91e9a146f47079775f64fda44835b47cb29cb84f07e01" :answer/id #uuid "a73157f4-b120-5860-8093-087aee68e1fa" :answer/type :answer.type/math :answer/value "a=-3,\\,b=1,\\,c=2" :db/ensure [:answer/validate]} {:db/id "q-130536/selection" :answer-field/id #uuid "ddaa1d36-3be6-53f0-83e1-f0abbc7f9daa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-130536/selection/4c32f25c0ac00e82009fa5be6024749cf24403cfdaa3d147716de28ce3fb2ddc" :answer-field/choices ["q-130536/selection/a87eda55b14aa90512b8290c42bdeb8be42cb617ced3fe61b043cd74ead9bca4" "q-130536/selection/4c32f25c0ac00e82009fa5be6024749cf24403cfdaa3d147716de28ce3fb2ddc" "q-130536/selection/274f18f86ee4f74b72da1822bbaf65afaf5ce14d0f9da4b3523d805fd5ef535b" "q-130536/selection/f9394419392469f418dd0c71e257f1c21f17ae3decda4e2fe7128644d4f3d7c0" "q-130536/selection/7ff6109bd70aa7b5ced91e9a146f47079775f64fda44835b47cb29cb84f07e01"] :db/ensure [:answer-field/validate]} {:db/id "q-130536" :question/id #uuid "e2ddb9ae-e08d-5346-95be-8df31e1fb92f" :question/math-academy-id "q-130536" :question/problem "The system of equations\n\n$$\n{\\begin{aligned}-3x+y+7z=5 \\\\ x-4y+8z=1 \\\\ -6y+9z=2\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n$$\n[\\begin{aligned}-3 & 1 & 7 \\\\ 1 & -4 & b \\\\ 0 & a & 9\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}c \\\\ 1 \\\\ 2\\end{aligned}].\n$$\n\nWhat are the values of $a,b,$ and $c?$" :question/worked-solution "First, let's write the system so that $x$, $y$, and $z$ appear in each equation:\n\n$$\n{\\begin{aligned}-3x+y+7z=5 \\\\ x-4y+8z=1 \\\\ 0x-6y+9z=2\\end{aligned}\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=[\\begin{aligned}-3 & 1 & 7 \\\\ 1 & -4 & 8 \\\\ 0 & -6 & 9\\end{aligned}]\n$$\n\nis the coefficient matrix,\n\n$$\nb=[\\begin{aligned}5 \\\\ 1 \\\\ 2\\end{aligned}]\n$$\n\nis the column vector of constants, and\n\n$$\nx=[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n[\\begin{aligned}-3 & 1 & 7 \\\\ 1 & -4 & 8 \\\\ 0 & -6 & 9\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}5 \\\\ 1 \\\\ 2\\end{aligned}].\n$$\n\nTherefore, $a=-6,\\,b=8,\\,c=5.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-130536/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1938c5da-d01a-53b7-a811-9afe1e43d152"] :knowledge-point/questions ["q-130536"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-36181"] :question/problem "The system of equations\n\n$$\n{\\begin{aligned}3x-4y+z=2 \\\\ x-6y+11z=3 \\\\ 3x-4y-z=4\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n$$\n[\\begin{aligned}3 & -4 & a \\\\ 1 & b & c \\\\ 3 & -4 & -1\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}2 \\\\ 3 \\\\ 4\\end{aligned}].\n$$\n\nWhat are the values of $a,b$ and $c?$" :question/worked-solution "We can write the system in the form $Ax=b,$ where\n\n$$\nA=[\\begin{aligned}3 & -4 & 1 \\\\ 1 & -6 & 11 \\\\ 3 & -4 & -1\\end{aligned}]\n$$\n\nis the coefficient matrix,\n\n$$\nb=[\\begin{aligned}2 \\\\ 3 \\\\ 4\\end{aligned}]\n$$\n\nis the column vector of constants, and\n\n$$\nx=[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n[\\begin{aligned}3 & -4 & 1 \\\\ 1 & -6 & 11 \\\\ 3 & -4 & -1\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}2 \\\\ 3 \\\\ 4\\end{aligned}].\n$$\n\nTherefore, $a=1,\\,b=-6,\\,c=11.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-130535/selection/41cac9c9e8c90c47d95a5a72bb21805cfaa86cab90a9beefe9ae34e7310f55ae" :answer/id #uuid "7070e989-c302-5af5-85f8-1e38e0014a7e" :answer/type :answer.type/math :answer/value "a=2,\\,b=-3,\\,c=1" :db/ensure [:answer/validate]} {:db/id "q-130535/selection/c235e9e0b624ae9028ac715af76e0e0865658a6cff83f1a5f71a38bb8f5e3993" :answer/id #uuid "a40bc766-b4f8-537b-9d5a-a11eff851db2" :answer/type :answer.type/math :answer/value "a=-1,\\,b=-5,\\,c=9" :db/ensure [:answer/validate]} {:db/id "q-130535/selection/6b95009cca68b0c192bfe19a194864ccf56e98a6369676296b17d0c5de09222a" :answer/id #uuid "e576cf28-423c-563b-9e57-2ef308902b3f" :answer/type :answer.type/math :answer/value "a=2,\\,b=-7,\\,c=-1" :db/ensure [:answer/validate]} {:db/id "q-130535/selection/d2b97ef27316fea9abadd75acf043eac2c5765e785524fa4ae55b73117be5e73" :answer/id #uuid "40655041-f289-502a-9ea2-871995a7eeab" :answer/type :answer.type/math :answer/value "a=4,\\,b=-3,\\,c=1" :db/ensure [:answer/validate]} {:db/id "q-130535/selection/ec0464047aaae7b039ab541a70b834c605752395a2139b79a921df2cf22222be" :answer/id #uuid "5df9f508-b858-5678-a4ae-e472f4e46b69" :answer/type :answer.type/math :answer/value "a=4,\\,b=-1,\\,c=1" :db/ensure [:answer/validate]} {:db/id "q-130535/selection" :answer-field/id #uuid "d8f1c6a1-1a09-556a-a7fa-a22787f05e4d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-130535/selection/d2b97ef27316fea9abadd75acf043eac2c5765e785524fa4ae55b73117be5e73" :answer-field/choices ["q-130535/selection/41cac9c9e8c90c47d95a5a72bb21805cfaa86cab90a9beefe9ae34e7310f55ae" "q-130535/selection/c235e9e0b624ae9028ac715af76e0e0865658a6cff83f1a5f71a38bb8f5e3993" "q-130535/selection/6b95009cca68b0c192bfe19a194864ccf56e98a6369676296b17d0c5de09222a" "q-130535/selection/d2b97ef27316fea9abadd75acf043eac2c5765e785524fa4ae55b73117be5e73" "q-130535/selection/ec0464047aaae7b039ab541a70b834c605752395a2139b79a921df2cf22222be"] :db/ensure [:answer-field/validate]} {:db/id "q-130535" :question/id #uuid "6e2fbe52-d918-52c4-aea4-f6898d19b9a9" :question/math-academy-id "q-130535" :question/problem "The system of equations\n\n$$\n{\\begin{aligned}2x-5y+z=1 \\\\ -x-3y+9z=-2 \\\\ 4x-7y-z=5\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n$$\n[\\begin{aligned}2 & -5 & c \\\\ -1 & b & 9 \\\\ a & -7 & -1\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}1 \\\\ -2 \\\\ 5\\end{aligned}].\n$$\n\nWhat are the values of $a,b$ and $c?$" :question/worked-solution "We can write the system in the form $Ax=b,$ where\n\n$$\nA=[\\begin{aligned}2 & -5 & 1 \\\\ -1 & -3 & 9 \\\\ 4 & -7 & -1\\end{aligned}]\n$$\n\nis the coefficient matrix,\n\n$$\nb=[\\begin{aligned}1 \\\\ -2 \\\\ 5\\end{aligned}]\n$$\n\nis the column vector of constants, and\n\n$$\nx=[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n[\\begin{aligned}2 & -5 & 1 \\\\ 1 & -3 & 9 \\\\ 4 & -7 & -1\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}1 \\\\ -2 \\\\ 5\\end{aligned}].\n$$\n\nTherefore, $a=4,\\,b=-3,\\,c=1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-130535/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1938c5da-d01a-53b7-a811-9afe1e43d152"] :knowledge-point/questions ["q-130535"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316977/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "a06272f1-09a1-5cce-8677-dc083ac5d764" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-316977/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "9f25993d-ae7b-5da6-a4d1-7978da5a4184" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-316977/field-1" :answer-field/id #uuid "702a739e-5086-5ea9-b0a9-b90d58ecd33c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316977/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-316977/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-316977/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-316977/field-2/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce" :answer/id #uuid "02f41715-2c7e-5689-9722-da15011365a8" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "q-316977/field-2" :answer-field/id #uuid "f655572f-6a5d-57b7-a956-d2c6f8408c73" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316977/field-2/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce" :answer-field/choices ["q-316977/field-2/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce"] :db/ensure [:answer-field/validate]} {:db/id "q-316977/field-3/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "602a1d1b-7952-543f-981f-253c836d23a8" :answer/type