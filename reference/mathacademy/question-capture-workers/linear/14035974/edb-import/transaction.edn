d #uuid "cbe1676f-06f9-53bc-a80d-57e29b37d0ee" :question/math-academy-id "q-317342" :question/problem "Calculate $det(S)$ given that\n$S=[\\begin{aligned}6 & -2 \\\\ 5 & 7\\end{aligned}].$\n\n$det(S)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(S) & =|\\begin{aligned}6 & -2 \\\\ 5 & 7\\end{aligned}| \\\\  & =(6)(7)-(-2)(5) \\\\  & =42+10 \\\\  & =52.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-317342/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1"] :knowledge-point/questions ["q-317342"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-1089"] :question/problem "Calculate $det(Z)$, if\n $Z=[\\begin{aligned}\\sqrt{x} & y \\\\ {y}^{2} & \\sqrt{x}\\end{aligned}].$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(Z) & =|\\begin{aligned}\\sqrt{x} & y \\\\ {y}^{2} & \\sqrt{x}\\end{aligned}| \\\\  & =\\sqrt{x}\\cdot \\sqrt{x}-y\\cdot {y}^{2} \\\\  & =x-{y}^{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-317374/field-1/e1880242b5ac4474684f1ab6c77c074eb5d189144b9ea596725c4d092b38d984" :answer/id #uuid "8d28e367-2fb3-53f0-8fe6-2e1f7452d1ce" :answer/type :answer.type/math :answer/value "6+4y" :db/ensure [:answer/validate]} {:db/id 17592186275856 :answer-field/choices ["q-317374/field-1/e1880242b5ac4474684f1ab6c77c074eb5d189144b9ea596725c4d092b38d984"] :db/ensure [:answer-field/validate]} {:db/id "q-1087/selection/12b48b00f9c1ff14570ca66bc629787a88856efba1cda24cfb28da58c148801a" :answer/id #uuid "57db962f-21