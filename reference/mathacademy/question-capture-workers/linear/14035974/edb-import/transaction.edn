/answer-fields ["q-69649/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a"] :knowledge-point/questions ["q-69649"] :db/ensure [:knowledge-point/validate]} {:db/id "q-317377/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "07b9fe54-a3d7-5307-8022-d68799288896" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-317377/field-1" :answer-field/id #uuid "272a163a-71ab-5b16-a72d-979fbf4c2d82" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317377/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer-field/choices ["q-317377/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe"] :db/ensure [:answer-field/validate]} {:db/id "q-317377" :question/id #uuid "497ebc79-47d9-56cd-8228-6042a370e5bb" :question/math-academy-id "q-317377" :question/problem "If\n    $D=[\\begin{aligned}2 & m \\\\ 3 & 5\\end{aligned}]$\nand\n$\\text{det}(D)=-11,$ determine the value of $m.$\n\n$m=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(D) & =|\\begin{aligned}2 & m \\\\ 3 & 5\\end{aligned}| \\\\  & =2\\cdot 5-m\\cdot 3 \\\\  & =10-3m.\\end{aligned}\n$$\n\nSince $det(D)=-11,$ we get\n\n$$\n\\begin{aligned}det(D) & =-11 \\\\ 10-3m & =-11 \\\\ -3m & =-21 \\\\ m & =7.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-317377/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a"] :knowledge-point/questions ["q-317377"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127609/selection/15e4df905f760d5f390a000f165fecae1a509f84f1834c998b6f869ffc6965ad" :answer/id #uuid "1b0ba246-bc1c-5dcc-b6a1-0f384425788e" :answer/type :answer.type/math :answer/value "y=-9" :db/ensure [:answer/validate]} {:db/id "q-127609/selection/25eb914fe9ac4d670cc8b64d7e8deee9c4123c32ede90f0fd11dc435564dd91d" :answer/id #uuid "52d9ae28-ea52-5166-bea1-7661ec2e168c" :answer/type :answer.type/math :answer/value "y=3" :db/ensure [:answer/validate]} {:db/id "q-127609/selection/9962d71b295b753eb05519f410458ae7ef91a88e4ff65fd831f51f6be8c3feb7" :answer/id #uuid "e994887a-4321-5624-a277-f61e5cedd6ab" :answer/type :answer.type/math :answer/value "y=\\frac{9}{2}" :db/ensure [:answer/validate]} {:db/id "q-127609/selection/21e0b8ba1631ef33e70db3185f1d8d6849541cc7dde81b811a9304162730031f" :answer/id #uuid "05e08c95-f787-5813-bd41-8b2c1d8a0f1a" :answer/type :answer.type/math :answer/value "y=18" :db/ensure [:answer/validate]} {:db/id "q-127609/selection/42f602f01ca43d6fd2661811784e74bee43db6e64770deb25948ad9b5baa3e62" :answer/id #uuid "5a78b881-0d56-595b-9c45-4294d9aa58f1" :answer/type :answer.type/math :answer/value "y=\\frac{18}{2}" :db/ensure [:answer/validate]} {:db/id "q-127609/selection" :answer-field/id #uuid "147498ae-5ed1-529e-912f-f4533ec04ed3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127609/selection/25eb914fe9ac4d670cc8b64d7e8deee9c4123c32ede90f0fd11dc435564dd91d" :answer-field/choices ["q-127609/selection/15e4df905f760d5f390a000f165fecae1a509f84f1834c998b6f869ffc6965ad" "q-127609/selection/25eb914fe9ac4d670cc8b64d7e8deee9c4123c32ede90f0fd11dc435564dd91d" "q-127609/selection/9962d71b295b753eb05519f410458ae7ef91a88e4ff65fd831f51f6be8c3feb7" "q-127609/selection/21e0b8ba1631ef33e70db3185f1d8d6849541cc7dde81b811a9304162730031f" "q-127609/selection/42f602f01ca43d6fd2661811784e74bee43db6e64770deb25948ad9b5baa3e62"] :db/ensure [:answer-field/validate]} {:db/id "q-127609" :question/id #uuid "46665cfd-2504-5a96-8529-a4a426e21403" :question/math-academy-id "q-127609" :question/problem "If\n$A=[\\begin{aligned}3y & y \\\\ 3 & y-5\\end{aligned}]$\nand $det(A)=-27$, what is the value of $y?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}3y & y \\\\ 3 & y-5\\end{aligned}| \\\\  & =3y\\cdot (y-5)-y\\cdot 3 \\\\  & =3{y}^{2}-18y\\end{aligned}\n$$\n\nSince $det(A)=-27$, we obtain:\n\n$$\n\\begin{aligned}det(A) & =-27 \\\\ 3{y}^{2}-18y & =-27 \\\\ 3{y}^{2}-18y+27 & =0 \\\\ {y}^{2}-6y+9 & =0 \\\\ (y-3)^{2} & =0 \\\\ y & =3\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-127609/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a"] :knowledge-point/questions ["q-127609"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127608/selection/be79a6a27a77cd69ea8acb19ccaa127bd741db264e30725d8de78ad029629b9e" :answer/id #uuid "97169bc8-e53f-5875-ade1-bee062952b34" :answer/type :answer.type/math :answer/value "p=\\frac{2}{5}" :db/ensure [:answer/validate]} {:db/id "q-127608/selection/21753214a69319484b3b0de4ebf80ef7edcfcb54fc074aa2279064d0d39fb513" :answer/id #uuid "d24ecc5b-a14f-52d3-a4aa-0e0fe11aa898" :answer/type :answer.type/math :answer/value "p=3" :db/ensure [:answer/validate]} {:db/id "q-127608/selection/e00a03555980e0a9a4e2101573e31033bee769fc62c874da7a0d5d08d21106e6" :answer/id #uuid "0c9dced2-2083-5d7c-9230-7a4761063b46" :answer/type :answer.type/math :answer/value "p=\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-127608/selection/0fcd6cc5ce96d74603b05c55312e1ef17d4d2d7b00408c3407b1fcfebc2a96e9" :answer/id #uuid "f80b679e-4438-5c8e-88d7-bb296ac68264" :answer/type :answer.type/math :answer/value "p=-5" :db/ensure [:answer/validate]} {:db/id "q-127608/selection/f5d312574b20a2d1254cdaa5ab057575a97429c96f34377f123fdc7eda30a6f3" :answer/id #uuid "2d815262-99d7-543f-9604-15c362487da9" :answer/type :answer.type/math :answer/value "p=1" :db/ensure [:answer/validate]} {:db/id "q-127608/selection" :answer-field/id #uuid "ff2eebfe-f0a2-589b-808f-85c15aa1cdbf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127608/selection/f5d312574b20a2d1254cdaa5ab057575a97429c96f34377f123fdc7eda30a6f3" :answer-field/choices ["q-127608/selection/be79a6a27a77cd69ea8acb19ccaa127bd741db264e30725d8de78ad029629b9e" "q-127608/selection/21753214a69319484b3b0de4ebf80ef7edcfcb54fc074aa2279064d0d39fb513" "q-127608/selection/e00a03555980e0a9a4e2101573e31033bee769fc62c874da7a0d5d08d21106e6" "q-127608/selection/0fcd6cc5ce96d74603b05c55312e1ef17d4d2d7b00408c3407b1fcfebc2a96e9" "q-127608/selection/f5d312574b20a2d1254cdaa5ab057575a97429c96f34377f123fdc7eda30a6f3"] :db/ensure [:answer-field/validate]} {:db/id "q-127608" :question/id #uuid "59405864-30f5-59fd-9aaa-ccc85a3d8b1f" :question/math-academy-id "q-127608" :question/problem "If\n$B=[\\begin{aligned}5-p & p \\\\ 3 & p\\end{aligned}]$\nand $det(B)=1$, what is the value of $p?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(B) & =|\\begin{aligned}5-p & p \\\\ 3 & p\\end{aligned}| \\\\  & =(5-p)\\cdot p-p\\cdot 3 \\\\  & =-{p}^{2}+2p\\end{aligned}\n$$\n\nSince $det(B)=1$, we obtain:\n\n$$\n\\begin{aligned}det(B) & =1 \\\\ -{p}^{2}+2p & =1 \\\\ -{p}^{2}+2p-1 & =0 \\\\ {p}^{2}-2p+1 & =0 \\\\ (p-1)^{2} & =0 \\\\ p & =1\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-127608/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a"] :knowledge-point/questions ["q-127608"] :db/ensure [:knowledge-point/validate]} {:db/id "q-317382/field-1/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c" :answer/id #uuid "06a54019-60c1-5f46-8e07-6f5452901550" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "q-317382/field-1/5d34995cddd0166b343cae457ee45643c04c739e08758db1204c66c5ee04158e" :answer/id #uuid "6cb3fff2-cbbf-500b-a4f0-a6391d8ecee1" :answer/type :answer.type/math :answer/value "-20" :db/ensure [:answer/validate]} {:db/id "q-317382/field-1" :answer-field/id #uuid "bb646917-11de-5c00-805b-60b7845aa4a6" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317382/field-1/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c" :answer-field/choices ["q-317382/field-1/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c" "q-317382/field-1/5d34995cddd0166b343cae457ee45643c04c739e08758db1204c66c5ee04158e"] :db/ensure [:answer-field/validate]} {:db/id "q-317382" :question/id #uuid "22b71e24-60d9-590e-bc8b-7593a1f46cd2" :question/math-academy-id "q-317382" :question/problem "If\n$U=[\\begin{aligned}1+r & 2-r \\\\ -5 & 4\\end{aligned}]$\nand $det(U)=-6$, what is the value of $r?$\n\n$r=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(U) & =|\\begin{aligned}1+r & 2-r \\\\ -5 & 4\\end{aligned}| \\\\  & =(1+r)\\cdot 4-(2-r)\\cdot (-5) \\\\  & =4+4r+10-5r \\\\  & =14-r.\\end{aligned}\n$$\n\nSince $det(U)=-6,$ we get\n\n$$\n\\begin{aligned}det(U) & =-6 \\\\ 14-r & =-6 \\\\ -r & =-20 \\\\ r & =20.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-317382/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a"] :knowledge-point/questions ["q-317382"] :db/ensure [:knowledge-point/validate]} {:db/id "q-317385/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "89b672d2-4e0d-5e75-9f86-3404a92ad3bc" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-317385/field-1" :answer-field/id #uuid "1c863bce-16cd-5283-a864-a3a22a1fb458" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317385/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-317385/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-317385" :question/id #uuid "10e29f3e-ff24-5d9c-b609-46c4b86687cf" :question/math-academy-id "q-317385" :question/problem "If\n$S=[\\begin{aligned}3+s & 2s \\\\ -4 & 3-s\\end{aligned}]$\nand $det(S)=25,$ what is the value of $s?$\n\n$s=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(S) & =|\\begin{aligned}3+s & 2s \\\\ -4 & 3-s\\end{aligned}| \\\\  & =(3+s)(3-s)-2s(-4) \\\\  & =9-{s}^{2}+8s \\\\  & =-{s}^{2}+8s+9.\\end{aligned}\n$$\n\nSince $det(S)=25,$ we get\n\n$$\n\\begin{aligned}det(S) & =25 \\\\ -{s}^{2}+8s+9 & =25 \\\\ -{s}^{2}+8s-16 & =0 \\\\ {s}^{2}-8s+16 & =0 \\\\ (s-4)^{2} & =0 \\\\ s & =4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-317385/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a"] :knowledge-point/questions ["q-317385"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-4434"] :question/problem "Calculate $\\det(A),$ if $[\\begin{aligned}3 & 2 \\\\ 5 & 6\\end{aligned}]$" :question/worked-solution "For a $2 \\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}3 & 2 \\\\ 5 & 6\\end{aligned}| \\\\  & =3\\cdot 6-2\\cdot 5 \\\\  & =18-10 \\\\  & =8\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4435"] :question/problem "Calculate $\\det(A),$ if $[\\begin{aligned}\\sqrt{2} & -2 \\\\ 0 & \\sqrt{3}\\end{aligned}]$" :question/worked-solution "For a $2 \\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}\\sqrt{2} & -2 \\\\ 0 & \\sqrt{3}\\end{aligned}| \\\\  & =\\sqrt{2}\\cdot \\sqrt{3}-(-2)\\cdot 0 \\\\  & =\\sqrt{6}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4436"] :question/problem "If\n${A} = \n    \\left\\lbrack\n    \\matrix {\n        2 & -1 \\\n        -3 & k\n    }\n    \\right\\rbrack$\nand\n$\\det({A}) = 5$, what is the value of $k?$" :question/worked-solution "For a $2 \\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}2 & -1 \\\\ -3 & k\\end{aligned}| \\\\  & =2\\cdot k-(-1)\\cdot (-3) \\\\  & =2k-3\\end{aligned}\n$$\n\nSince $\\det(A)=5,$ we obtain:\n\n$$\n\\begin{aligned}det(A) & =5 \\\\ 2k-3 & =5 \\\\ 2k & =8 \\\\ k & =4\\end{aligned}\n$$" :db/ensure [:question/validate]}]
