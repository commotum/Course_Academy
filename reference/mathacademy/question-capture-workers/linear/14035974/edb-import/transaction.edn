[{:db/id [:question/math-academy-id "q-1079"] :question/problem "Calculate $\\text{det}(A)$, if\n$A=[\\begin{aligned}1 & 2 \\\\ 3 & 0\\end{aligned}].$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(A) & =|\\begin{aligned}1 & 2 \\\\ 3 & 0\\end{aligned}| \\\\  & =1\\cdot 0-2\\cdot 3 \\\\  & =0-6 \\\\  & =-6\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-127580/selection/e0e0a3ac4fe95f021c8f8aece7092270d36ad30c356733db1e628dc4f0b1d434" :answer/id #uuid "a590c217-db5e-529e-8b82-5d5274c7b576" :answer/type :answer.type/math :answer/value "-25" :db/ensure [:answer/validate]} {:db/id "q-127580/selection/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c" :answer/id #uuid "969fb704-7595-5e3e-937a-0441f150c779" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "q-127580/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "d3696e5a-cf25-5f0e-9624-2d5ece38b1d1" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-127580/selection/283bc09f1a097ae8400558511ca45f1013e17c797fdb7407be52694190fd744b" :answer/id #uuid "28d8751f-56ee-5c5d-b387-e3f127d82977" :answer/type :answer.type/math :answer/value "-15" :db/ensure [:answer/validate]} {:db/id "q-127580/selection/8642573b27c8383f67a645c39127977f20fbab89a940b170bac777f18f881b9b" :answer/id #uuid "20de722b-4c36-5104-898b-a88e64c19928" :answer/type :answer.type/math :answer/value "50" :db/ensure [:answer/validate]} {:db/id "q-127580/selection" :answer-field/id #uuid "ee1b78fc-d743-53e5-968d-95e26c933070" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127580/selection/e0e0a3ac4fe95f021c8f8aece7092270d36ad30c356733db1e