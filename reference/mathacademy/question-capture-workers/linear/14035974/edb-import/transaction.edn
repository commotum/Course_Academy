question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(T) & =|\\begin{aligned}\\frac{1}{2} & 17 \\\\ 1 & 10\\end{aligned}| \\\\  & =\\frac{1}{2}\\cdot 10-17\\cdot 1 \\\\  & =5-17 \\\\  & =-12\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-1087/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a"] :knowledge-point/questions ["q-1087"] :db/ensure [:knowledge-point/validate]} {:db/id "q-1083/selection/f44c1f439c6a79e9963cd6e8fa4ee8a2980ae0db79245e65a2027d2885860783" :answer/id #uuid "0e6da321-3a79-5ee8-92ef-92e8728beba9" :answer/type :answer.type/math :answer/value "6x-{y}^{2}z" :db/ensure [:answer/validate]} {:db/id "q-1083/selection/bddfa4daa9d599b0cfbcf704a08db95f2c4a22635cc6c4ecca6c69fdd439ccf4" :answer/id #uuid "65cc8dbb-b6bb-583c-af38-104ad3020f61" :answer/type :answer.type/math :answer/value "6x-{y}^{2}" :db/ensure [:answer/validate]} {:db/id "q-1083/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "4b2c90c0-5634-510d-a4b1-bf3807125744" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-1083/selection/416e8717ecedc9a0488e0340ea14a93d9f7d3fbfa9f008255bc16cc5da48e53f" :answer/id #uuid "3e244273-c5e9-5120-bfc7-60839a825c30" :answer/type :answer.type/math :answer/value "-6x-{y}^{2}z" :db/ensure [:answer/validate]} {:db/id "q-1083/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "c989c076-1c37-5dad-893b-61912a865fef" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-1083/selection" :answer-field/id #uuid "9db6b8cb-1fb0-5912-9e47-5c781b7ad1f8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-1083/selection/416e8717ecedc9a0488e0340ea14a93d9f7d3fbfa9f008255bc16cc5da48e53f" :answer-field/choices ["q-1083/selection/f44c1f439c6a79e9963cd6e8fa4ee8a2980ae0db79245e65a2027d2885860783" "q-1083/selection/bddfa4daa9d599b0cfbcf704a08db95f2c4a22635cc6c4ecca6c69fdd439ccf4" "q-1083/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-1083/selection/416e8717ecedc9a0488e0340ea14a93d9f7d3fbfa9f008255bc16cc5da48e53f" "q-1083/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-1083" :question/id #uuid "ab8533d5-13ed-5e86-bbbc-79eac648f6a4" :question/math-academy-id "q-1083" :question/problem "$|\\begin{aligned}2x & {y}^{2} \\\\ z & -3\\end{aligned}|=$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}|\\begin{aligned}2x & {y}^{2} \\\\ z & -3\\end{aligned}| & =2x\\cdot (-3)-{y}^{2}\\cdot z \\\\  & =-6x-{y}^{2}z\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-1083/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a"] :knowledge-point/questions ["q-1083"] :db/ensure [:knowledge-point/validate]} {:db/id "q-69649/selection/e605081b400e51444d83ad8b9997bea891fc82f0e8335edf22e1f18a34ab73c3" :answer/id #uuid "31567239-589f-5e4f-920a-1ee23c5eab51" :answer/type :answer.type/math :answer/value "-2x-3y{z}^{2}" :db/ensure [:answer/validate]} {:db/id "q-69649/selection/f2d6426b3af7f26c3a8401e5b1e18dfc665ca225fdae6fc99ea7098f28d72a93" :answer/id #uuid "398623cc-4c4a-5111-baad-0c7180eaa7b6" :answer/type :answer.type/math :answer/value "3x-2{z}^{2}y" :db/ensure [:answer/validate]} {:db/id "q-69649/selection/053f499bd068c05913ce37ac535d6103ca3f629d2785703f6fec7082b43d6a7c" :answer/id #uuid "f00ffe5a-58a7-