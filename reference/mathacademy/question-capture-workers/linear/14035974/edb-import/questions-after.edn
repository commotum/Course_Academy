#{[{:db/id #edb/ref 17592186059481 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"}] :question/id #uuid "2b6e8845-a53d-510c-b44f-1b00271ee507" :question/math-academy-id "e-4434" :question/problem "Calculate $\\det(A),$ if $[\\begin{aligned}3 & 2 \\\\ 5 & 6\\end{aligned}]$" :question/worked-solution "For a $2 \\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}3 & 2 \\\\ 5 & 6\\end{aligned}| \\\\  & =3\\cdot 6-2\\cdot 5 \\\\  & =18-10 \\\\  & =8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059482 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/id #uuid "b066b73a-c777-550c-9c6e-af8093bf7fab" :question/math-academy-id "e-4435" :question/problem "Calculate $\\det(A),$ if $[\\begin{aligned}\\sqrt{2} & -2 \\\\ 0 & \\sqrt{3}\\end{aligned}]$" :question/worked-solution "For a $2 \\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}\\sqrt{2} & -2 \\\\ 0 & \\sqrt{3}\\end{aligned}| \\\\  & =\\sqrt{2}\\cdot \\sqrt{3}-(-2)\\cdot 0 \\\\  & =\\sqrt{6}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059483 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/id #uuid "043a5e58-e1a0-50a5-b1be-d404e6262991" :question/math-academy-id "e-4436" :question/problem "If\n${A} = \n    \\left\\lbrack\n    \\matrix {\n        2 & -1 \\\n        -3 & k\n    }\n    \\right\\rbrack$\nand\n$\\det({A}) = 5$, what is the value of $k?$" :question/worked-solution "For a $2 \\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}2 & -1 \\\\ -3 & k\\end{aligned}| \\\\  & =2\\cdot k-(-1)\\cdot (-3) \\\\  & =2k-3\\end{aligned}\n$$\n\nSince $\\det(A)=5,$ we obtain:\n\n$$\n\\begin{aligned}det(A) & =5 \\\\ 2k-3 & =5 \\\\ 2k & =8 \\\\ k & =4\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059904 :knowledge-point/_questions [{:knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93a51bf2-61bd-5e0d-ae01-0acd2ce020ac" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186056144} {:answer/id #uuid "9adadbee-04e7-590f-8f1b-01af8d071dc0" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186056145} {:answer/id #uuid "f4560220-46d1-593f-b388-7fc88a31b06e" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186056146} {:answer/id #uuid "5588e2e0-eafc-55da-8239-f81b5b429467" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186056147} {:answer/id #uuid "6b96e68f-0685-58ec-817e-ac8e81f2d2a5" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186056148}] :answer-field/correct {:answer/id #uuid "f4560220-46d1-593f-b388-7fc88a31b06e" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186056146} :answer-field/id #uuid "f767903c-0606-5234-9a95-44518189a6ee" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056143}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "67459f8a-4276-51e0-8ff0-10c56a6d248e" :question/math-academy-id "q-1079" :question/problem "Calculate $\\text{det}(A)$, if\n$A=[\\begin{aligned}1 & 2 \\\\ 3 & 0\\end{aligned}].$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(A) & =|\\begin{aligned}1 & 2 \\\\ 3 & 0\\end{aligned}| \\\\  & =1\\cdot 0-2\\cdot 3 \\\\  & =0-6 \\\\  & =-6\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186264420 :knowledge-point/_questions [{:knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1bd19d9-2d4c-5a5f-8e21-97be4390286c" :answer/type {:db/ident :answer.type/math} :answer/value "43" :db/id #edb/ref 17592186264422} {:answer/id #uuid "e4894c5e-9c7c-59e7-8403-c8d73cfeb131" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186264423} {:answer/id #uuid "c54b2bf8-0541-5a5f-96cf-e4e5d4a58dcd" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186264424} {:answer/id #uuid "2af255c5-4f69-5f75-be7c-41116e8df588" :answer/type {:db/ident :answer.type/math} :answer/value "-34" :db/id #edb/ref 17592186264425} {:answer/id #uuid "fcd29854-4108-5324-9166-c6b1c9360708" :answer/type {:db/ident :answer.type/math} :answer/value "37" :db/id #edb/ref 17592186264426}] :answer-field/correct {:answer/id #uuid "b1bd19d9-2d4c-5a5f-8e21-97be4390286c" :answer/type {:db/ident :answer.type/math} :answer/value "43" :db/id #edb/ref 17592186264422} :answer-field/id #uuid "f834a283-9d4f-569a-aa6f-c125d3230257" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186264421}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f27dd693-1931-5315-9ec0-4cfe813b59f1" :question/math-academy-id "q-1080" :question/problem "Calculate $\\text{det}(X)$, if\n    $X=[\\begin{aligned}10 & -3 \\\\ 1 & 4\\end{aligned}].$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(X) & =|\\begin{aligned}10 & -3 \\\\ 1 & 4\\end{aligned}| \\\\  & =10\\cdot 4-(-3)\\cdot 1 \\\\  & =40-(-3) \\\\  & =43\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295027 :knowledge-point/_questions [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e244273-c5e9-5120-bfc7-60839a825c30" :answer/type {:db/ident :answer.type/math} :answer/value "-6x-{y}^{2}z" :db/id #edb/ref 17592186295029} {:answer/id #uuid "4b2c90c0-5634-510d-a4b1-bf3807125744" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186295030} {:answer/id #uuid "65cc8dbb-b6bb-583c-af38-104ad3020f61" :answer/type {:db/ident :answer.type/math} :answer/value "6x-{y}^{2}" :db/id #edb/ref 17592186295031} {:answer/id #uuid "c989c076-1c37-5dad-893b-61912a865fef" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186295032} {:answer/id #uuid "0e6da321-3a79-5ee8-92ef-92e8728beba9" :answer/type {:db/ident :answer.type/math} :answer/value "6x-{y}^{2}z" :db/id #edb/ref 17592186295033}] :answer-field/correct {:answer/id #uuid "3e244273-c5e9-5120-bfc7-60839a825c30" :answer/type {:db/ident :answer.type/math} :answer/value "-6x-{y}^{2}z" :db/id #edb/ref 17592186295029} :answer-field/id #uuid "9db6b8cb-1fb0-5912-9e47-5c781b7ad1f8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186295028}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ab8533d5-13ed-5e86-bbbc-79eac648f6a4" :question/math-academy-id "q-1083" :question/problem "$|\\begin{aligned}2x & {y}^{2} \\\\ z & -3\\end{aligned}|=$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}|\\begin{aligned}2x & {y}^{2} \\\\ z & -3\\end{aligned}| & =2x\\cdot (-3)-{y}^{2}\\cdot z \\\\  & =-6x-{y}^{2}z\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295034 :knowledge-point/_questions [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57db962f-2176-59b9-97da-bdfeefaeda13" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186295036} {:answer/id #uuid "88aaf5de-2b7d-5415-8c5d-da819b82e120" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186295037} {:answer/id #uuid "8e020749-daa8-5a4b-9d2c-10a1e395de0c" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186295038} {:answer/id #uuid "c665e25a-f4a9-5c44-8ca4-bbd6798491d6" :answer/type {:db/ident :answer.type/math} :answer/value "-17" :db/id #edb/ref 17592186295039} {:answer/id #uuid "2dae8158-efcd-5f7a-ab13-9089d93bdff5" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186295040}] :answer-field/correct {:answer/id #uuid "2dae8158-efcd-5f7a-ab13-9089d93bdff5" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186295040} :answer-field/id #uuid "1b3cfd8e-5dfc-5837-97e1-86bcc7a68c19" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186295035}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "49c9e659-104e-5b14-a7e2-9c499b4a61b7" :question/math-academy-id "q-1087" :question/problem "Calculate $det(T)$, if\n    $T=[\\begin{aligned}\\frac{1}{2} & 17 \\\\ 1 & 10\\end{aligned}].$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(T) & =|\\begin{aligned}\\frac{1}{2} & 17 \\\\ 1 & 10\\end{aligned}| \\\\  & =\\frac{1}{2}\\cdot 10-17\\cdot 1 \\\\  & =5-17 \\\\  & =-12\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059906 :knowledge-point/_questions [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3ececb7-1edf-52b2-a7f3-e6fadfbf6a24" :answer/type {:db/ident :answer.type/math} :answer/value "x - 2y^{2}" :db/id #edb/ref 17592186056156} {:answer/id #uuid "b6ce8258-1b57-5ce6-8236-4bc0c8b9d0cf" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{x} - y^{3}" :db/id #edb/ref 17592186056157} {:answer/id #uuid "e3d79055-0502-58f8-a3f2-b111c388fb1e" :answer/type {:db/ident :answer.type/math} :answer/value "x - y^{2}" :db/id #edb/ref 17592186056158} {:answer/id #uuid "fcb96daf-6d06-52d9-b16a-ca528d597957" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{x} - 2y^{3}" :db/id #edb/ref 17592186056159} {:answer/id #uuid "738cb90b-d3bd-5cac-9bf7-699185b3b0ab" :answer/type {:db/ident :answer.type/math} :answer/value "x - y^{3}" :db/id #edb/ref 17592186056160}] :answer-field/correct {:answer/id #uuid "738cb90b-d3bd-5cac-9bf7-699185b3b0ab" :answer/type {:db/ident :answer.type/math} :answer/value "x - y^{3}" :db/id #edb/ref 17592186056160} :answer-field/id #uuid "c29f36e7-996f-56c1-83f6-bf13329e360d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056155}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "31d5493d-598a-5cd3-9717-dec41584eaba" :question/math-academy-id "q-1089" :question/problem "Calculate $det(Z)$, if\n $Z=[\\begin{aligned}\\sqrt{x} & y \\\\ {y}^{2} & \\sqrt{x}\\end{aligned}].$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(Z) & =|\\begin{aligned}\\sqrt{x} & y \\\\ {y}^{2} & \\sqrt{x}\\end{aligned}| \\\\  & =\\sqrt{x}\\cdot \\sqrt{x}-y\\cdot {y}^{2} \\\\  & =x-{y}^{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295041 :knowledge-point/_questions [{:knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "969fb704-7595-5e3e-937a-0441f150c779" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186295043} {:answer/id #uuid "28d8751f-56ee-5c5d-b387-e3f127d82977" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186295044} {:answer/id #uuid "20de722b-4c36-5104-898b-a88e64c19928" :answer/type {:db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186295045} {:answer/id #uuid "a590c217-db5e-529e-8b82-5d5274c7b576" :answer/type {:db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186295046} {:answer/id #uuid "d3696e5a-cf25-5f0e-9624-2d5ece38b1d1" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186295047}] :answer-field/correct {:answer/id #uuid "a590c217-db5e-529e-8b82-5d5274c7b576" :answer/type {:db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186295046} :answer-field/id #uuid "ee1b78fc-d743-53e5-968d-95e26c933070" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186295042}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b7d081a1-41e6-5a83-bf29-6367f8ce8846" :question/math-academy-id "q-127580" :question/problem "$|\\begin{aligned}-1 & -10 \\\\ -2 & 5\\end{aligned}|=$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}|\\begin{aligned}-1 & -10 \\\\ -2 & 5\\end{aligned}| & =-1\\cdot 5-(-10)\\cdot (-2) \\\\  & =-5-20 \\\\  & =-25\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295048 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f80b679e-4438-5c8e-88d7-bb296ac68264" :answer/type {:db/ident :answer.type/math} :answer/value "p=-5" :db/id #edb/ref 17592186295050} {:answer/id #uuid "d24ecc5b-a14f-52d3-a4aa-0e0fe11aa898" :answer/type {:db/ident :answer.type/math} :answer/value "p=3" :db/id #edb/ref 17592186295051} {:answer/id #uuid "97169bc8-e53f-5875-ade1-bee062952b34" :answer/type {:db/ident :answer.type/math} :answer/value "p=\\frac{2}{5}" :db/id #edb/ref 17592186295052} {:answer/id #uuid "0c9dced2-2083-5d7c-9230-7a4761063b46" :answer/type {:db/ident :answer.type/math} :answer/value "p=\\frac{1}{3}" :db/id #edb/ref 17592186295053} {:answer/id #uuid "2d815262-99d7-543f-9604-15c362487da9" :answer/type {:db/ident :answer.type/math} :answer/value "p=1" :db/id #edb/ref 17592186295054}] :answer-field/correct {:answer/id #uuid "2d815262-99d7-543f-9604-15c362487da9" :answer/type {:db/ident :answer.type/math} :answer/value "p=1" :db/id #edb/ref 17592186295054} :answer-field/id #uuid "ff2eebfe-f0a2-589b-808f-85c15aa1cdbf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186295049}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "59405864-30f5-59fd-9aaa-ccc85a3d8b1f" :question/math-academy-id "q-127608" :question/problem "If\n$B=[\\begin{aligned}5-p & p \\\\ 3 & p\\end{aligned}]$\nand $det(B)=1$, what is the value of $p?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(B) & =|\\begin{aligned}5-p & p \\\\ 3 & p\\end{aligned}| \\\\  & =(5-p)\\cdot p-p\\cdot 3 \\\\  & =-{p}^{2}+2p\\end{aligned}\n$$\n\nSince $det(B)=1$, we obtain:\n\n$$\n\\begin{aligned}det(B) & =1 \\\\ -{p}^{2}+2p & =1 \\\\ -{p}^{2}+2p-1 & =0 \\\\ {p}^{2}-2p+1 & =0 \\\\ (p-1)^{2} & =0 \\\\ p & =1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295055 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b0ba246-bc1c-5dcc-b6a1-0f384425788e" :answer/type {:db/ident :answer.type/math} :answer/value "y=-9" :db/id #edb/ref 17592186295057} {:answer/id #uuid "05e08c95-f787-5813-bd41-8b2c1d8a0f1a" :answer/type {:db/ident :answer.type/math} :answer/value "y=18" :db/id #edb/ref 17592186295058} {:answer/id #uuid "52d9ae28-ea52-5166-bea1-7661ec2e168c" :answer/type {:db/ident :answer.type/math} :answer/value "y=3" :db/id #edb/ref 17592186295059} {:answer/id #uuid "5a78b881-0d56-595b-9c45-4294d9aa58f1" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{18}{2}" :db/id #edb/ref 17592186295060} {:answer/id #uuid "e994887a-4321-5624-a277-f61e5cedd6ab" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{9}{2}" :db/id #edb/ref 17592186295061}] :answer-field/correct {:answer/id #uuid "52d9ae28-ea52-5166-bea1-7661ec2e168c" :answer/type {:db/ident :answer.type/math} :answer/value "y=3" :db/id #edb/ref 17592186295059} :answer-field/id #uuid "147498ae-5ed1-529e-912f-f4533ec04ed3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186295056}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "46665cfd-2504-5a96-8529-a4a426e21403" :question/math-academy-id "q-127609" :question/problem "If\n$A=[\\begin{aligned}3y & y \\\\ 3 & y-5\\end{aligned}]$\nand $det(A)=-27$, what is the value of $y?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}3y & y \\\\ 3 & y-5\\end{aligned}| \\\\  & =3y\\cdot (y-5)-y\\cdot 3 \\\\  & =3{y}^{2}-18y\\end{aligned}\n$$\n\nSince $det(A)=-27$, we obtain:\n\n$$\n\\begin{aligned}det(A) & =-27 \\\\ 3{y}^{2}-18y & =-27 \\\\ 3{y}^{2}-18y+27 & =0 \\\\ {y}^{2}-6y+9 & =0 \\\\ (y-3)^{2} & =0 \\\\ y & =3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186264473 :knowledge-point/_questions [{:knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ae0a43f-4a24-5c8c-9751-66e2c3806304" :answer/type {:db/ident :answer.type/math} :answer/value "47" :db/id #edb/ref 17592186264475} {:answer/id #uuid "e0d5ff1f-31c3-570f-893f-adf43e8033de" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186264476}] :answer-field/correct {:answer/id #uuid "9ae0a43f-4a24-5c8c-9751-66e2c3806304" :answer/type {:db/ident :answer.type/math} :answer/value "47" :db/id #edb/ref 17592186264475} :answer-field/id #uuid "12378f4c-0b12-5f63-930c-c04949c67a95" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264474}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f9d7ffc6-c6c4-5b96-90f8-c539ddd148a6" :question/math-academy-id "q-317335" :question/problem "Calculate $det(R)$ given that\n$R=[\\begin{aligned}8 & -5 \\\\ 3 & 4\\end{aligned}].$\n\n$det(R)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(R) & =|\\begin{aligned}8 & -5 \\\\ 3 & 4\\end{aligned}| \\\\  & =(8)(4)-(-5)(3) \\\\  & =32+15 \\\\  & =47.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295062 :knowledge-point/_questions [{:knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cebb3da8-3bb8-58a4-ae1a-64ee2a5434fb" :answer/type {:db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186295064}] :answer-field/correct {:answer/id #uuid "cebb3da8-3bb8-58a4-ae1a-64ee2a5434fb" :answer/type {:db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186295064} :answer-field/id #uuid "49b8801c-974c-5630-adc2-ae7696160b47" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186295063}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "cbe1676f-06f9-53bc-a80d-57e29b37d0ee" :question/math-academy-id "q-317342" :question/problem "Calculate $det(S)$ given that\n$S=[\\begin{aligned}6 & -2 \\\\ 5 & 7\\end{aligned}].$\n\n$det(S)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(S) & =|\\begin{aligned}6 & -2 \\\\ 5 & 7\\end{aligned}| \\\\  & =(6)(7)-(-2)(5) \\\\  & =42+10 \\\\  & =52.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275855 :knowledge-point/_questions [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2721fb1b-944f-514b-9459-32c248390c5f" :answer/type {:db/ident :answer.type/math} :answer/value "6-4y" :db/id #edb/ref 17592186275857} {:answer/id #uuid "8d28e367-2fb3-53f0-8fe6-2e1f7452d1ce" :answer/type {:db/ident :answer.type/math} :answer/value "6+4y" :db/id #edb/ref 17592186295065}] :answer-field/correct {:answer/id #uuid "2721fb1b-944f-514b-9459-32c248390c5f" :answer/type {:db/ident :answer.type/math} :answer/value "6-4y" :db/id #edb/ref 17592186275857} :answer-field/id #uuid "9689caa6-d67d-586d-afb2-3478b2ba698d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275856}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "31f29a1f-5ce7-5787-80e1-70b0610804ac" :question/math-academy-id "q-317374" :question/problem "Evaluate the determinant:\n\n$|\\begin{aligned}\\sqrt{6} & y \\\\ 4 & \\sqrt{6}\\end{aligned}|=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}\\sqrt{6} & y \\\\ 4 & \\sqrt{6}\\end{aligned}| & =\\sqrt{6}\\cdot \\sqrt{6}-y\\cdot 4 \\\\  & =6-4y.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295066 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07b9fe54-a3d7-5307-8022-d68799288896" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186295068}] :answer-field/correct {:answer/id #uuid "07b9fe54-a3d7-5307-8022-d68799288896" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186295068} :answer-field/id #uuid "272a163a-71ab-5b16-a72d-979fbf4c2d82" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186295067}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "497ebc79-47d9-56cd-8228-6042a370e5bb" :question/math-academy-id "q-317377" :question/problem "If\n    $D=[\\begin{aligned}2 & m \\\\ 3 & 5\\end{aligned}]$\nand\n$\\text{det}(D)=-11,$ determine the value of $m.$\n\n$m=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(D) & =|\\begin{aligned}2 & m \\\\ 3 & 5\\end{aligned}| \\\\  & =2\\cdot 5-m\\cdot 3 \\\\  & =10-3m.\\end{aligned}\n$$\n\nSince $det(D)=-11,$ we get\n\n$$\n\\begin{aligned}det(D) & =-11 \\\\ 10-3m & =-11 \\\\ -3m & =-21 \\\\ m & =7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295069 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06a54019-60c1-5f46-8e07-6f5452901550" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186295071} {:answer/id #uuid "6cb3fff2-cbbf-500b-a4f0-a6391d8ecee1" :answer/type {:db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186295072}] :answer-field/correct {:answer/id #uuid "06a54019-60c1-5f46-8e07-6f5452901550" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186295071} :answer-field/id #uuid "bb646917-11de-5c00-805b-60b7845aa4a6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186295070}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "22b71e24-60d9-590e-bc8b-7593a1f46cd2" :question/math-academy-id "q-317382" :question/problem "If\n$U=[\\begin{aligned}1+r & 2-r \\\\ -5 & 4\\end{aligned}]$\nand $det(U)=-6$, what is the value of $r?$\n\n$r=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(U) & =|\\begin{aligned}1+r & 2-r \\\\ -5 & 4\\end{aligned}| \\\\  & =(1+r)\\cdot 4-(2-r)\\cdot (-5) \\\\  & =4+4r+10-5r \\\\  & =14-r.\\end{aligned}\n$$\n\nSince $det(U)=-6,$ we get\n\n$$\n\\begin{aligned}det(U) & =-6 \\\\ 14-r & =-6 \\\\ -r & =-20 \\\\ r & =20.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295073 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89b672d2-4e0d-5e75-9f86-3404a92ad3bc" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186295075}] :answer-field/correct {:answer/id #uuid "89b672d2-4e0d-5e75-9f86-3404a92ad3bc" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186295075} :answer-field/id #uuid "1c863bce-16cd-5283-a864-a3a22a1fb458" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186295074}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "10e29f3e-ff24-5d9c-b609-46c4b86687cf" :question/math-academy-id "q-317385" :question/problem "If\n$S=[\\begin{aligned}3+s & 2s \\\\ -4 & 3-s\\end{aligned}]$\nand $det(S)=25,$ what is the value of $s?$\n\n$s=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(S) & =|\\begin{aligned}3+s & 2s \\\\ -4 & 3-s\\end{aligned}| \\\\  & =(3+s)(3-s)-2s(-4) \\\\  & =9-{s}^{2}+8s \\\\  & =-{s}^{2}+8s+9.\\end{aligned}\n$$\n\nSince $det(S)=25,$ we get\n\n$$\n\\begin{aligned}det(S) & =25 \\\\ -{s}^{2}+8s+9 & =25 \\\\ -{s}^{2}+8s-16 & =0 \\\\ {s}^{2}-8s+16 & =0 \\\\ (s-4)^{2} & =0 \\\\ s & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295076 :knowledge-point/_questions [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f00ffe5a-58a7-53cd-8f3b-1477d08dbfd0" :answer/type {:db/ident :answer.type/math} :answer/value "-3x-2{y}^{2}z" :db/id #edb/ref 17592186295078} {:answer/id #uuid "9d155f84-9e98-55d1-996b-97cc1307c7cc" :answer/type {:db/ident :answer.type/math} :answer/value "2x+3y{z}^{2}" :db/id #edb/ref 17592186295079} {:answer/id #uuid "c1d3ffe4-ec5c-5bce-a669-5ce1ec173629" :answer/type {:db/ident :answer.type/math} :answer/value "-3x-2y{z}^{2}" :db/id #edb/ref 17592186295080} {:answer/id #uuid "31567239-589f-5e4f-920a-1ee23c5eab51" :answer/type {:db/ident :answer.type/math} :answer/value "-2x-3y{z}^{2}" :db/id #edb/ref 17592186295081} {:answer/id #uuid "398623cc-4c4a-5111-baad-0c7180eaa7b6" :answer/type {:db/ident :answer.type/math} :answer/value "3x-2{z}^{2}y" :db/id #edb/ref 17592186295082}] :answer-field/correct {:answer/id #uuid "c1d3ffe4-ec5c-5bce-a669-5ce1ec173629" :answer/type {:db/ident :answer.type/math} :answer/value "-3x-2y{z}^{2}" :db/id #edb/ref 17592186295080} :answer-field/id #uuid "04389665-0eb5-58ac-8373-a4e875f7a7f0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186295077}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "85251ba4-f49c-560b-9c32-b25c1968114a" :question/math-academy-id "q-69649" :question/problem "$|\\begin{aligned}3\\sqrt{x} & {z}^{2} \\\\ 2y & -\\sqrt{x}\\end{aligned}|=$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}|\\begin{aligned}3\\sqrt{x} & {z}^{2} \\\\ 2y & -\\sqrt{x}\\end{aligned}| & =3\\sqrt{x}\\cdot (-\\sqrt{x})-{z}^{2}\\cdot 2y \\\\  & =-3x-2y{z}^{2}\\end{aligned}\n$$"}]}
