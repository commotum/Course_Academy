ion-capture/13950375/state.json" "file_sha256" "9e3355d2162a5bacce4fd5f14810aae23ea22b4778d77a8f345f2b3dce5f1300" "basis" 585 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13950375/edb-import/verification.json"} {"question" "q-317335" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13950375/activity-metadata.json" "file_sha256" "974f7dfbe78cfb6dbb3d1f645606733895a2d3e60c2f321581b288e22d7d9ac4" "basis" 585 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13950375/edb-import/verification.json"} {"question" "q-317335" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13950375/state.json" "file_sha256" "9e3355d2162a5bacce4fd5f14810aae23ea22b4778d77a8f345f2b3dce5f1300" "basis" 585 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13950375/edb-import/verification.json"} {"question" "q-317374" "field" nil "attribute" "question/problem" "value" "Evaluate the determinant:\n\n$|\\begin{aligned}\\sqrt{6} & y \\\\ 4 & \\sqrt{6}\\end{aligned}|=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13974230/state.json" "file_sha256" "0e7a21f039339f492eb31ebff17b8e0f483a33408339059353ef9e6b3a1f16d3" "basis" 711 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13974230/edb-import/verification.json"} {"question" "q-317374" "field" nil "attribute" "question/worked-solution" "value" "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}\\sqrt{6} & y \\\\ 4 & \\sqrt{6}\\end{aligned}| & =\\sqrt{6}\\cdot \\sqrt{6}-y\\cdot 4 \\\\  & =6-4y.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13974230/state.json" "file_sha256" "0e7a21f039339f492eb31ebff17b8e0f483a33408339059353ef9e6b3a1f16d3" "basis" 711 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13974230/edb-import/verification.json"} {"question" "q-317374" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13974230/activity-metadata.json" "file_sha256" "0510e57de7a3782588cfbae83eceaa161c665c939346a0623bb1b74a9cd49b39" "basis" 711 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13974230/edb-import/verification.json"} {"question" "q-317374" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13974230/state.json" "file_sha256" "0e7a21f039339f492eb31ebff17b8e0f483a33408339059353ef9e6b3a1f16d3" "basis" 711 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13974230/edb-import/verification.json"} {"question" "q-317374" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "6-4y"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13974230/state.json" "file_sha256" "0e7a21f039339f492eb31ebff17b8e0f483a33408339059353ef9e6b3a1f16d3" "basis" 711 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13974230/edb-import/verification.json"}] "sources" [{"question" "q-317335" "field" nil "attribute" "question/problem" "value" "Calculate $det(R)$ given that\n$R=[\\begin{aligned}8 & -5 \\\\ 3 & 4\\end{aligned}].$\n\n$det(R)=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035974/state.json" "file_sha256" "464a9853726e71fd3fbc4bba1d41431ea1a32d0ba724fb022afe59bcff3a67cf"} {"question" "q-317335" "field" nil "attribute" "question/worked-solution" "value" "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(R) & =|\\begin{aligned}8 & -5 \\\\ 3 & 4\\end{aligned}| \\\\  & =(8)(4)-(-5)(3) \\\\  & =32+15 \\\\  & =47.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035974/state.json" "file_sha256" "464a9853726e71fd3fbc4bba1d41431ea1a32d0ba724fb022afe59bcff3a67cf"} {"question" "q-317335" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035974/activity-metadata.json" "file_sha256" "c323ef1fed74d1acacb1fab4011c663923b6a74751cbc3bc72ea57d81f81b951"} {"question" "q-317335" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035974/state.json" "file_sha256" "464a9853726e71fd3fbc4bba1d41431ea1a32d0ba724fb022afe59bcff3a67cf"} {"question" "q-317335" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "47"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035974/state.json" "file_sha256" "464a9853726e71fd3fbc4bba1d41431ea1a32d0ba724fb022afe59bcff3a67cf"} {"question" "q-1079" "field" nil "attribute" "question/problem" "value" "Calculate $\\text{det}(A)$, if\n$A=[\\begin{aligned}1 & 2 \\\\ 3 & 0\\end{aligned}].$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035974/state.json" "file_sha256" "464a9853726e71fd3fbc4bba1d41431ea1a32d0ba724fb022afe59bcff3a67cf"} {"question" "q-1079" "field" nil "attribute" "question/worked-solution" "value" "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(A) & =|\\begin{aligned}1 & 2 \\\\ 3 & 0\\end{aligned}| \\\\  & =1\\cdot 0-2\\cdot 3 \\\\  & =0-6 \\\\  & =-6\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035974/state.json" "file_sha256" "464a9853726e71fd3fbc4bba1d41431ea1a32d0ba724fb022afe59bcff3a67cf"} {"question" "q-1079" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035974/activity-metadata.json" "file_sha256" "c323ef1fed74d1acacb1fab4011c663923b6a74751cbc3bc72ea57d81f81b951"} {"question" "q-1079" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035974/state.json" "file_sha256" "464a9853726e71fd3fbc4bba1d41431ea1a32d0ba724fb022afe59bcff3a67cf"} {"question" "q-1079" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-6"] ["math" "0"] ["math" "1"] ["math" "6"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035974/state.json" "file_sha256" "464a9853726e71fd3fbc4bba1d41431ea1a32d0ba724fb022afe59