#{[{:db/id #edb/ref 17592186059481 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"}] :question/id #uuid "2b6e8845-a53d-510c-b44f-1b00271ee507" :question/math-academy-id "e-4434" :question/problem "Calculate $\\det(A)$, if $\\begin{bmatrix}3 & 2 \\\\ 5 & 6\\end{bmatrix}$" :question/worked-solution "For a $2 \\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\ndet(A) &= \\begin{vmatrix}3 & 2 \\\\ 5 & 6\\end{vmatrix} \\\\\n&= 3 \\cdot 6 - 2 \\cdot 5 \\\\\n&= 18 - 10 \\\\\n&= 8\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059482 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/id #uuid "b066b73a-c777-550c-9c6e-af8093bf7fab" :question/math-academy-id "e-4435" :question/problem "Calculate $\\det(A)$, if $\\begin{bmatrix}\\sqrt{2} & -2 \\\\ 0 & \\sqrt{3}\\end{bmatrix}$" :question/worked-solution "For a $2 \\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\ndet(A) &= \\begin{vmatrix}\\sqrt{2} & -2 \\\\ 0 & \\sqrt{3}\\end{vmatrix} \\\\\n&= \\sqrt{2} \\cdot \\sqrt{3} - (-2) \\cdot 0 \\\\\n&= \\sqrt{6}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059483 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/id #uuid "043a5e58-e1a0-50a5-b1be-d404e6262991" :question/math-academy-id "e-4436" :question/problem "If\n${A} = \\left\\lbrack \\matrix {2 & -1 \\ -3 & k} \\right\\rbrack$\nand\n$\\det({A}) = 5$, what is the value of $k$?" :question/worked-solution "For a $2 \\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\ndet(A) &= \\begin{vmatrix}2 & -1 \\\\ -3 & k\\end{vmatrix} \\\\\n&= 2 \\cdot k - (-1) \\cdot (-3) \\\\\n&= 2k - 3\n\\end{aligned}\n$$\n\nSince $\\det(A)=5$, we obtain:\n\n$$\n\\begin{aligned}\ndet(A) &= 5 \\\\\n2k - 3 &= 5 \\\\\n2k &= 8 \\\\\nk &= 4\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059904 :knowledge-point/_questions [{:knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93a51bf2-61bd-5e0d-ae01-0acd2ce020ac" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186056144} {:answer/id #uuid "9adadbee-04e7-590f-8f1b-01af8d071dc0" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186056145} {:answer/id #uuid "f4560220-46d1-593f-b388-7fc88a31b06e" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186056146} {:answer/id #uuid "5588e2e0-eafc-55da-8239-f81b5b429467" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186056147} {:answer/id #uuid "6b96e68f-0685-58ec-817e-ac8e81f2d2a5" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186056148}] :answer-field/correct {:answer/id #uuid "f4560220-46d1-593f-b388-7fc88a31b06e" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186056146} :answer-field/id #uuid "f767903c-0606-5234-9a95-44518189a6ee" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056143}] :question/id #uuid "67459f8a-4276-51e0-8ff0-10c56a6d248e" :question/math-academy-id "q-1079" :question/problem "Calculate $det(A)$, if\n\n$A = \\begin{bmatrix}1 & 2 \\\\ 3 & 0\\end{bmatrix}$."}] [{:db/id #edb/ref 17592186264420 :knowledge-point/_questions [{:knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1bd19d9-2d4c-5a5f-8e21-97be4390286c" :answer/type {:db/ident :answer.type/math} :answer/value "43" :db/id #edb/ref 17592186264422} {:answer/id #uuid "e4894c5e-9c7c-59e7-8403-c8d73cfeb131" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186264423} {:answer/id #uuid "c54b2bf8-0541-5a5f-96cf-e4e5d4a58dcd" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186264424} {:answer/id #uuid "2af255c5-4f69-5f75-be7c-41116e8df588" :answer/type {:db/ident :answer.type/math} :answer/value "-34" :db/id #edb/ref 17592186264425} {:answer/id #uuid "fcd29854-4108-5324-9166-c6b1c9360708" :answer/type {:db/ident :answer.type/math} :answer/value "37" :db/id #edb/ref 17592186264426}] :answer-field/correct {:answer/id #uuid "b1bd19d9-2d4c-5a5f-8e21-97be4390286c" :answer/type {:db/ident :answer.type/math} :answer/value "43" :db/id #edb/ref 17592186264422} :answer-field/id #uuid "f834a283-9d4f-569a-aa6f-c125d3230257" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186264421}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f27dd693-1931-5315-9ec0-4cfe813b59f1" :question/math-academy-id "q-1080" :question/problem "Calculate $\\text{det}(X)$, if\n    $X=[\\begin{aligned}10 & -3 \\\\ 1 & 4\\end{aligned}].$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(X) & =|\\begin{aligned}10 & -3 \\\\ 1 & 4\\end{aligned}| \\\\  & =10\\cdot 4-(-3)\\cdot 1 \\\\  & =40-(-3) \\\\  & =43\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059906 :knowledge-point/_questions [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3ececb7-1edf-52b2-a7f3-e6fadfbf6a24" :answer/type {:db/ident :answer.type/math} :answer/value "x - 2y^{2}" :db/id #edb/ref 17592186056156} {:answer/id #uuid "b6ce8258-1b57-5ce6-8236-4bc0c8b9d0cf" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{x} - y^{3}" :db/id #edb/ref 17592186056157} {:answer/id #uuid "e3d79055-0502-58f8-a3f2-b111c388fb1e" :answer/type {:db/ident :answer.type/math} :answer/value "x - y^{2}" :db/id #edb/ref 17592186056158} {:answer/id #uuid "fcb96daf-6d06-52d9-b16a-ca528d597957" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{x} - 2y^{3}" :db/id #edb/ref 17592186056159} {:answer/id #uuid "738cb90b-d3bd-5cac-9bf7-699185b3b0ab" :answer/type {:db/ident :answer.type/math} :answer/value "x - y^{3}" :db/id #edb/ref 17592186056160}] :answer-field/correct {:answer/id #uuid "738cb90b-d3bd-5cac-9bf7-699185b3b0ab" :answer/type {:db/ident :answer.type/math} :answer/value "x - y^{3}" :db/id #edb/ref 17592186056160} :answer-field/id #uuid "c29f36e7-996f-56c1-83f6-bf13329e360d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056155}] :question/id #uuid "31d5493d-598a-5cd3-9717-dec41584eaba" :question/math-academy-id "q-1089" :question/problem "Calculate $det(Z)$, if\n\n$Z = \\begin{bmatrix}\\sqrt{x} & y \\\\ y^{2} & \\sqrt{x}\\end{bmatrix}$."}] [{:db/id #edb/ref 17592186264473 :knowledge-point/_questions [{:knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ae0a43f-4a24-5c8c-9751-66e2c3806304" :answer/type {:db/ident :answer.type/math} :answer/value "47" :db/id #edb/ref 17592186264475} {:answer/id #uuid "e0d5ff1f-31c3-570f-893f-adf43e8033de" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186264476}] :answer-field/correct {:answer/id #uuid "9ae0a43f-4a24-5c8c-9751-66e2c3806304" :answer/type {:db/ident :answer.type/math} :answer/value "47" :db/id #edb/ref 17592186264475} :answer-field/id #uuid "12378f4c-0b12-5f63-930c-c04949c67a95" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264474}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f9d7ffc6-c6c4-5b96-90f8-c539ddd148a6" :question/math-academy-id "q-317335" :question/problem "Calculate $det(R)$ given that\n$R=[\\begin{aligned}8 & -5 \\\\ 3 & 4\\end{aligned}].$\n\n$det(R)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(R) & =|\\begin{aligned}8 & -5 \\\\ 3 & 4\\end{aligned}| \\\\  & =(8)(4)-(-5)(3) \\\\  & =32+15 \\\\  & =47.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275855 :knowledge-point/_questions [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2721fb1b-944f-514b-9459-32c248390c5f" :answer/type {:db/ident :answer.type/math} :answer/value "6-4y" :db/id #edb/ref 17592186275857}] :answer-field/correct {:answer/id #uuid "2721fb1b-944f-514b-9459-32c248390c5f" :answer/type {:db/ident :answer.type/math} :answer/value "6-4y" :db/id #edb/ref 17592186275857} :answer-field/id #uuid "9689caa6-d67d-586d-afb2-3478b2ba698d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275856}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "31f29a1f-5ce7-5787-80e1-70b0610804ac" :question/math-academy-id "q-317374" :question/problem "Evaluate the determinant:\n\n$|\\begin{aligned}\\sqrt{6} & y \\\\ 4 & \\sqrt{6}\\end{aligned}|=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}\\sqrt{6} & y \\\\ 4 & \\sqrt{6}\\end{aligned}| & =\\sqrt{6}\\cdot \\sqrt{6}-y\\cdot 4 \\\\  & =6-4y.\\end{aligned}\n$$"}]}
