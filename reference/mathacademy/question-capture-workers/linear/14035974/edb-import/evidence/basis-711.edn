#{[{:db/id #edb/ref 17592186275855 :knowledge-point/_questions [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2721fb1b-944f-514b-9459-32c248390c5f" :answer/type {:db/ident :answer.type/math} :answer/value "6-4y" :db/id #edb/ref 17592186275857}] :answer-field/correct {:answer/id #uuid "2721fb1b-944f-514b-9459-32c248390c5f" :answer/type {:db/ident :answer.type/math} :answer/value "6-4y" :db/id #edb/ref 17592186275857} :answer-field/id #uuid "9689caa6-d67d-586d-afb2-3478b2ba698d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275856}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "31f29a1f-5ce7-5787-80e1-70b0610804ac" :question/math-academy-id "q-317374" :question/problem "Evaluate the determinant:\n\n$|\\begin{aligned}\\sqrt{6} & y \\\\ 4 & \\sqrt{6}\\end{aligned}|=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}\\sqrt{6} & y \\\\ 4 & \\sqrt{6}\\end{aligned}| & =\\sqrt{6}\\cdot \\sqrt{6}-y\\cdot 4 \\\\  & =6-4y.\\end{aligned}\n$$"}]}
