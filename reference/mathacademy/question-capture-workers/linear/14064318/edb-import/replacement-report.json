    {
      "question": "e-4816",
      "field": null,
      "attribute": "question/worked-solution",
      "old_sha256": "4284547ceb41f964e936aa82ad67aecf68f7f8ec87f537da9d1f490974c23f4c",
      "new_sha256": "597e46ababf121c2cc2e00a53383e8caeb09b8bf128fd011847d5b0b70989b8e",
      "category": "ma_capture",
