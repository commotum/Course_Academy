ces ["q-101406/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-101406/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-101406/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" "q-101406/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-101406/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af"] :db/ensure [:answer-field/validate]} {:db/id "q-101406" :question/id #uuid "d8830dd6-6b8a-5551-9a8b-8f792cfe3f0c" :question/math-academy-id "q-101406" :question/problem "Let $p=⟨1,-2⟩$ and $q=⟨4,-1⟩.$ Find $p\\cdot q.$" :question/worked-solution "Summing up the products of corresponding components, we obtain:\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y} \\\\  & =1\\cdot 4+(-2)\\cdot (-1) \\\\  & =4+2 \\\\  & =6\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-101406/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "68abb4f0-c532-5cb6-882c-dacfe6a945dc"] :knowledge-point/questions ["q-101406"] :db/ensure [:knowledge-point/validate]} {:db/id "q-317911/field-1/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "21937840-cba4-50c0-8f75-02b1f7dfacf9" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-317911/field-1" :answer-field/id #uuid "8eb315ea-bab6-5e92-9762-ad690dad8e11" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317911/field-1/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer-field/choices ["q-317911/field-1/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97"] :db/ensure [:answer-field/validate]} {:db/id "q-317911" :question/id #uuid "347973c0-bec7-5a8b-9bd7-a26994fb98fa" :question/math-academy-id "q-317911" :question/problem "If $u=⟨8,-2⟩$ and $v=⟨3,6⟩,$ then $u\\cdot v=${{field-1}}." :question/worked-solution "Summing up the products of corresponding components, we obtain\n\n$$\n\\begin{aligned}u\\cdot v & ={u}_{x}\\cdot {v}_{x}+{u}_{y}\\cdot {v}_{y} \\\\  & =8\\cdot 3+(-2)\\cdot 6 \\\\  & =24-12 \\\\  & =12.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-317911/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "68abb4f0-c532-5cb6-882c-dacfe6a945dc"] :knowledge-point/questions ["q-317911"] :db/ensure [:knowledge-point/validate]} {:db/id "q-317932/field-1/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer/id #uuid "45a45810-42fd-57c2-930b-0359659b0cfe" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "q-317932/field-1/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "2052cef9-31f9-59eb-a157-68a3c4019d85" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-317932/field-1" :answer-field/id #uuid "4343e620-a8d5-5ead-8f76-2094411d05d2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317932/field-1/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer-field/choices ["q-317932/field-1/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" "q-317932/field-1/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af"] :db/ensure [:answer-field/validate]} {:db/id "q-317932" :question/id #uuid "a411d783-aaa8-56ea-9240-b467f4a9cb6e" :question/math-academy-id "q-317932" :question/problem "If $c=[\\begin{aligned}k \\\\ 2k \\\\ 4\\end{aligned}],$ $d=[\\begin{aligned}-3 \\\\ 2 \\\\ 2\\end{aligned}],$ and $c⊥d,$ then $k=${{field-1}}." :question/worked-solution "We know that $c⊥d$ ($c$ and $d$ are perpendicular) if and only if $c\\cdot d=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}c\\cdot d & ={c}_{x}\\cdot {d}_{x}+{c}_{y}\\cdot {d}_{y}+{c}_{z}\\cdot {d}_{z} \\\\  & =k\\cdot (-3)+2k\\cdot 2+4\\cdot 2 \\\\  & =-3k+4k+8 \\\\  & =k+8.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain\n\n$$\n\\begin{aligned}c\\cdot d & =0 \\\\ k+8 & =0 \\\\ k & =-8.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-317932/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8bff08bf-0035-5f05-9607-493b301e8717"] :knowledge-point/questions ["q-317932"] :db/ensure [:knowledge-point/validate]} {:db/id "q-1348/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "0f645c8f-d00c-5cec-8767-76d492b017c3" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-1348/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer/id #uuid "d6f5d61a-5f4d-55d5-a20b-20eec6b14e1c" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "q-1348/selection/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce" :answer/id #uuid "2691de04-6ddb-53f8-8e75-a69b030bcd67" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "q-1348/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer/id #uuid "efe793d2-ff51-54c7-8ecb-f4354f84ccf2" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "q-1348/selection/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" :answer/id #uuid "79bcec83-4dc2-5a83-8fe1-3e9d865f8c57" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "q-1348/selection" :answer-field/id #uuid "d0244f95-1c0d-5a3f-bcc0-0fee54474c34" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-1348/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer-field/choices ["q-1348/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" "q-1348/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" "q-1348/selection/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce" "q-1348/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" "q-1348/selection/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a"] :db/ensure [:answer-field/validate]} {:db/id "q-1348" :question/id #uuid "12e62824-fc02-5a8d-8379-e67039c07bc0" :question/math-academy-id "q-1348" :question/problem "Let $p=[\\begin{aligned}7 \\\\ n\\end{aligned}]$ and $q=[\\begin{aligned}4 \\\\ -4\\end{aligned}].$ Given that $p⊥q$, find the value of $n.$" :question/worked-solution "We know that $p⊥q$ ($p$ and $q$ are perpendicular) if and only if $p\\cdot q=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y} \\\\  & =7\\cdot 4+n\\cdot (-4) \\\\  & =28-4n.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 28-4n & =0 \\\\ 28 & =4n \\\\ n & =7\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-1348/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8bff08bf-0035-5f05-9607-493b301e8717"] :knowledge-point/questions ["q-1348"] :db/ensure [:knowledge-point/validate]} {:db/id "q-317945/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "19382e00-ca59-50b9-84d8-0478e4b121bf" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-317945/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "bc5f625b-06cc-53be-a1c6-e3d112cd2a75" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-317945/field-1" :answer-field/id #uuid "240955df-3d58-5743-a358-3e2c195bafc7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317945/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-317945/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-317945/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-317945" :question/id #uuid "4a8b5a23-ade1-5e2d-9cfe-f55808f3f82d" :question/math-academy-id "q-317945" :question/problem "Let $a=⟨2{x}^{2},-4⟩$ and $b=⟨8,4⟩.$ If $a⊥b$ and $x>0,$ then $x=${{field-1}}." :question/worked-solution "We know that $a⊥b$ ($a$ and $b$ are perpendicular) if and only if $a\\cdot b=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y} \\\\  & =2{x}^{2}\\cdot 8+(-4)\\cdot 4 \\\\  & =16{x}^{2}-16.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 16{x}^{2}-16 & =0 \\\\ 16{x}^{2} & =16 \\\\ {x}^{2} & =1 \\\\ x & =\\pm 1.\\end{aligned}\n$$\n\nWe disregard the negative solution since we are told that $x>0.$ Therefore, $x=1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-317945/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8bff08bf-0035-5f05-9607-493b301e8717"] :knowledge-point/questions ["q-317945"] :db/ensure [:knowledge-point/validate]} {:db/id "q-19023/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45" :answer/id #uuid "2eb9dbe7-f10b-53d3-823f-d8b8de791bce" :answer/type :answer.type/math :answer/value "-12" :db/ensure [:answer/validate]} {:db/id "q-19023/selection/c6aee8d6d50719f300760eb2495148ceeb4788aba7a3722d82e109afb19d07de" :answer/id #uuid "bcb50249-8d55-5082-9855-02174c0caed2" :answer/type :answer.type/math :answer/value "-\\sqrt{6}" :db/ensure [:answer/validate]} {:db/id "q-19023/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "39cc4771-47ed-5369-9295-727f333c1a28" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-19023/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "57f0ac27-9fa0-5dd2-91df-cd19a59d18a1" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-19023/selection/6ed93402e3f8355619e122841b8554104a9e4b66626e3165eaca69a6020cae34" :answer/id #uuid "37971105-c43c-5ba0-ab46-037839975f37" :answer/type :answer.type/math :answer/value "-\\sqrt{12}" :db/ensure [:answer/validate]} {:db/id "q-19023/selection" :answer-field/id #uuid "edd6a8a9-ca60-56e7-a1c6-4bd13fd66694" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-19023/selection/c6aee8d6d50719f300760eb2495148ceeb4788aba7a3722d82e109afb19d07de" :answer-field/choices ["q-19023/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45" "q-19023/selection/c6aee8d6d50719f300760eb2495148ceeb4788aba7a3722d82e109afb19d07de" "q-19023/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" "q-19023/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-19023/selection/6ed93402e3f8355619e122841b8554104a9e4b66626e3165eaca69a6020cae34"] :db/ensure [:answer-field/validate]} {:db/id "q-19023" :question/id #uuid "6cc90301-024a-5ba4-9afa-a95be9b8e595" :question/math-academy-id "q-19023" :question/problem "Let $g=[\\begin{aligned}{r}^{2} \\\\ -1 \\\\ -6\\end{aligned}]$ and $h=[\\begin{aligned}3 \\\\ {r}^{2} \\\\ 2\\end{aligned}].$ Given that $g⊥h$ and $r<0$, find the value of $r.$" :question/worked-solution "We know that $g⊥h$ ($g$ and $h$ are perpendicular) if and only if $g\\cdot h=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}g\\cdot h & ={g}_{x}\\cdot {h}_{x}+{g}_{y}\\cdot {h}_{y}+{g}_{z}\\cdot {h}_{z} \\\\  & ={r}^{2}\\cdot 3+(-1)\\cdot {r}^{2}+(-6)\\cdot 2 \\\\  & =3{r}^{2}-{r}^{2}-12 \\\\  & =2{r}^{2}-12.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}g\\cdot h & =0 \\\\ 2{r}^{2}-12 & =0 \\\\ 2{r}^{2} & =12 \\\\ {r}^{2} & =6 \\\\ r & =\\pm \\sqrt{6}\\end{aligned}\n$$\n\nWe disregard the positive solution since we are told that $r<0.$ Therefore, $r=-\\sqrt{6}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-19023/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8bff08bf-0035-5f05-9607-493b301e8717"] :knowledge-point/questions ["q-19023"] :db/ensure [:knowledge-point/validate]} {:db/id "q-77152/selection/10293ac0295e0e79554137a949f5c5c46b9812dcc0a3ecb6349c4cb5e6acdff3" :answer/id #uuid "539ce263-6b84-5cbd-abef-7e7369f00338" :answer/type :answer.type/math :answer/value "-9" :db/ensure [:answer/validate]} {:db/id "q-77152/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "778fb45b-3f80-5de9-9acc-6281942f8091" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-77152/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "a07a5fc6-0808-5a5d-96da-e30f50fc9d93" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-77152/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer/id #uuid "c8da9be2-1d42-5429-9acf-21ee85a2e9ef" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "q-77152/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "f4ef04c4-d9ae-52d4-8600-8950d3319403" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-77152/selection" :answer-field/id #uuid "f58711c7-ccbd-558a-a2f7-105490661a59" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-77152/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer-field/choices ["q-77152/selection/10293ac0295e0e79554137a949f5c5c46b9812dcc0a3ecb6349c4cb5e6acdff3" "q-77152/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-77152/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-77152/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" "q-77152/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473"] :db/ensure [:answer-field/validate]} {:db/id "q-77152" :question/id #uuid "6b0d4192-2013-565b-ac9f-79ea30bb05ae" :question/math-academy-id "q-77152" :question/problem "Let $u=[\\begin{aligned}a \\\\ 2 \\\\ 4\\end{aligned}]$ and $v=[\\begin{aligned}a \\\\ -4 \\\\ -2\\end{aligned}].$ Given that $u⊥v$ and $a<0$, find the value of $a.$" :question/worked-solution "We know that $u⊥v$ ($u$ and $v$ are perpendicular) if and only if $u\\cdot v=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}u\\cdot v & ={u}_{x}\\cdot {v}_{x}+{u}_{y}\\cdot {v}_{y}+{u}_{z}\\cdot {v}_{z} \\\\  & =a\\cdot a+2\\cdot (-4)+4\\cdot (-2) \\\\  & ={a}^{2}-16.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}u\\cdot v & =0 \\\\ {a}^{2}-16 & =0 \\\\ {a}^{2} & =16 \\\\ a & =\\pm 4\\end{aligned}\n$$\n\nWe disregard the positive solution since we are told that $a<0.$ Therefore, $a=-4.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-77152/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8bff08bf-0035-5f05-9607-493b301e8717"] :knowledge-point/questions ["q-77152"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-4323"] :question/problem "Let $\\mathbf{a}=\\langle 0,-0.4,11 \\rangle$ and $\\mathbf{b}=\\langle 2,5,2 \\rangle.$ Find $\\mathbf{a} \\cdot \\mathbf{b}.$" :question/worked-solution "Summing up the products of corresponding components, we obtain:\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =0\\cdot 2+(-0.4)\\cdot 5+11\\cdot 2 \\\\  & =0-2+22 \\\\  & =20\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4324"] :question/problem "Let $[\\begin{aligned}4 \\\\ -2 \\\\ 1\\end{aligned}]$ and $[\\begin{aligned}-2 \\\\ 5 \\\\ t\\end{aligned}]$. Given that $\\mathbf{a} \\perp \\mathbf{b}$, find the value of $t$." :question/worked-solution "We know that $\\mathbf{a} \\perp \\mathbf{b}$ ($\\mathbf{a}$ and $\\mathbf{b}$ are perpendicular) if and only if $\\mathbf{a} \\cdot \\mathbf{b} = 0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =4\\cdot (-2)+(-2)\\cdot 5+1\\cdot t \\\\  & =-8-10+t \\\\  & =t-18.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ t-18 & =0 \\\\ t & =18\\end{aligned}\n$$" :db/ensure [:question/validate]}]
