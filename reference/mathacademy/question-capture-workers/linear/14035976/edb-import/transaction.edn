[{:db/id [:question/math-academy-id "q-1340"] :question/problem "Let $u=⟨-3,2⟩$ and $v=⟨7,9⟩.$ Find $u\\cdot v.$" :question/worked-solution "Summing up the products of corresponding components, we obtain:\n\n$$\n\\begin{aligned}u\\cdot v & ={u}_{x}\\cdot {v}_{x}+{u}_{y}\\cdot {v}_{y} \\\\  & =(-3)\\cdot 7+2\\cdot 9 \\\\  & =-21+18 \\\\  & =-3\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-317910/field-1/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" :answer/id #uuid "4dc3356d-045b-5f2c-a0fc-d143302024a2" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "q-317910/field-1" :answer-field/id #uuid "d19c2ae9-b14d-5008-b508-852dc7967b05" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317910/field-1/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" :answer-field/choices ["q-317910/field-1/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a"] :db/ensure [:answer-field/validate]} {:db/id "q-317910" :question/id #uuid "acc1f282-97d6-5abd-b80b-66b721a6548f" :question/math-academy-id "q-317910" :question/problem "If $a=⟨5,1⟩$ and $b=⟨2,4⟩,$ then $a\\cdot b=${{field-1}}." :question/worked-solution "Summing up the products of corresponding components, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y} \\\\  & =5\\cdot 2+1\\cdot 4 \\\\  & =10+4 \\\\  & =14.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-317910/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "68abb4f0-c532-5cb6-882c-dacfe6a945dc"] :knowledge-point/questions ["q-317910"] :db/ensure [:knowledge-point/validate]} {:db/id "q-1341/selection/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" :answer/id #uuid "29116c10-ee3b-5ee3-8f5e-0f9220d7379e" :answer/type :answer.type/math :answer/value "15" 