d "2691de04-6ddb-53f8-8e75-a69b030bcd67" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186295304} {:answer/id #uuid "0f645c8f-d00c-5cec-8767-76d492b017c3" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186295305} {:answer/id #uuid "79bcec83-4dc2-5a83-8fe1-3e9d865f8c57" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186295306} {:answer/id #uuid "efe793d2-ff51-54c7-8ecb-f4354f84ccf2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186295307}] :answer-field/correct {:answer/id #uuid "0f645c8f-d00c-5cec-8767-76d492b017c3" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186295305} :answer-field/id #uuid "d0244f95-1c0d-5a3f-bcc0-0fee54474c34" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186295302}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "12e62824-fc02-5a8d-8379-e67039c07bc0" :question/math-academy-id "q-1348" :question/problem "Let $p=[\\begin{aligned}7 \\\\ n\\end{aligned}]$ and $q=[\\begin{aligned}4 \\\\ -4\\end{aligned}].$ Given that $p⊥q$, find the value of $n.$" :question/worked-solution "We know that $p⊥q$ ($p$ and $q$ are perpendicular) if and only if $p\\cdot q=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y} \\\\  & =7\\cdot 4+n\\cdot (-4) \\\\  & =28-4n.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 28-4n & =0 \\\\ 28 & =4n \\\\ n & =7\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295308 :knowledge-point/_questions [{:knowledge-point/id #uuid "8bff08bf-0035-5f05-9607-493b301e8717" :knowledge-point/title "Solving for an Unknown Given Two Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37971105-c43c-5ba0-ab46-037839975f37" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{12}" :db/id #edb/ref 17592186295310} {:answer/id #uuid "57f0ac27-9fa0-5dd2-91df-cd19a59d18a1" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186295311} {:answer/id #uuid "bcb50249-8d55-5082-9855-02174c0caed2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{6}" :db/id #edb/ref 17592186295312} {:answer/id #uuid "2eb9dbe7-f10b-53d3-823f-d8b8de791bce" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186295313} {:answer/id #uuid "39cc4771-47ed-5369-9295-727f333c1a28" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186295314}] :answer-field/correct {:answer/id #uuid "bcb50249-8d55-5082-9855-02174c0caed2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{6}" :db/id #edb/ref 17592186295312} :answer-field/id #uuid "edd6a8a9-ca60-56e7-a1c6-4bd13fd66694" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186295309}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6cc90301-024a-5ba4-9afa-a95be9b8e595" :question/math-academy-id "q-19023" :question/problem "Let $g=[\\begin{aligned}{r}^{2} \\\\ -1 \\\\ -6\\end{aligned}]$ and $h=[\\begin{aligned}3 \\\\ {r}^{2} \\\\ 2\\end{aligned}].$ Given that $g⊥h$ and $r<0$, find the value of $r.$" :question/worked-solution "We know that $g⊥h$ ($g$ and $h$ are perpendicular) if and only if $g\\cdot h=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}g\\cdot h & ={g}_{x}\\cdot {h}_{x}+{g}_{y}\\cdot {h}_{y}+{g}_{z}\\cdot {h}_{z} \\\\  & ={r}^{2}\\cdot 3+(-1)\\cdot {r}^{2}+(-6)\\cdot 2 \\\\  & =3{r}^{2}-{r}^{2}-12 \\\\  & =2{r}^{2}-12.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}g\\cdot h & =0 \\\\ 2{r}^{2}-12 & =0 \\\\ 2{r}^{2} & =12 \\\\ {r}^{2} & =6 \\\\ r & =\\pm \\sqrt{6}\\end{aligned}\n$$\n\nWe disregard the positive solution since we are told that $r<0.$ Therefore, $r=-\\sqrt{6}.$"}] [{:db/id #edb/ref 17592186295315 :knowledge-point/_questions [{:knowledge-point/id #uuid "68abb4f0-c532-5cb6-882c-dacfe6a945dc" :knowledge-point/title "Calculating the Dot Product Using the General Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4dc3356d-045b-5f2c-a0fc-d143302024a2" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186295317}] :answer-field/correct {:answer/id #uuid "4dc3356d-045b-5f2c-a0fc-d143302024a2" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186295317} :answer-field/id #uuid "d19c2ae9-b14d-5008-b508-852dc7967b05" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186295316}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "acc1f282-97d6-5abd-b80b-66b721a6548f" :question/math-academy-id "q-317910" :question/problem "If $a=⟨5,1⟩$ and $b=⟨2,4⟩,$ then $a\\cdot b=${{field-1}}." :question/worked-solution "Summing up the products of corresponding components, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y} \\\\  & =5\\cdot 2+1\\cdot 4 \\\\  & =10+4 \\\\  & =14.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295318 :knowledge-point/_questions [{:knowledge-point/id #uuid "68abb4f0-c532-5cb6-882c-dacfe6a945dc" :knowledge-point/title "Calculating the Dot Product Using the General Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21937840-cba4-50c0-8f75-02b1f7dfacf9" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186295320}] :answer-field/correct {:answer/id #uuid "21937840-cba4-50c0-8f75-02b1f7dfacf9" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186295320} :answer-field/id #uuid "8eb315ea-bab6-5e92-9762-ad690dad8e11" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186295319}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "347973c0-bec7-5a8b-9bd7-a26994fb98fa" :question/math-academy-id "q-317911" :question/problem "If $u=⟨8,-2⟩$ and $v=⟨3,6⟩,$ then $u\\cdot v=${{field-1}}." :question/worked-solution "Summing up the products of corresponding components, we obtain\n\n$$\n\\begin{aligned}u\\cdot v & ={u}_{x}\\cdot {v}_{x}+{u}_{y}\\cdot {v}_{y} \\\\  & =8\\cdot 3+(-2)\\cdot 6 \\\\  & =24-12 \\\\  & =12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295321 :knowledge-point/_questions [{:knowledge-point/id #uuid "8bff08bf-0035-5f05-9607-493b301e8717" :knowledge-point/title "Solving for an Unknown Given Two Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45a45810-42fd-57c2-930b-0359659b0cfe" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186295323} {:answer/id #uuid "2052cef9-31f9-59eb-a157-68a3c4019d85" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186295324}] :answer-field/correct {:answer/id #uuid "45a45810-42fd-57c2-930b-0359659b0cfe" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186295323} :answer-field/id #uuid "4343e620-a8d5-5ead-8f76-2094411d05d2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186295322}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a411d783-aaa8-56ea-9240-b467f4a9cb6e" :question/math-academy-id "q-317932" :question/problem "If $c=[\\begin{aligned}k \\\\ 2k \\\\ 4\\end{aligned}],$ $d=[\\begin{aligned}-3 \\\\ 2 \\\\ 2\\end{aligned}],$ and $c⊥d,$ then $k=${{field-1}}." :question/worked-solution "We know that $c⊥d$ ($c$ and $d$ are perpendicular) if and only if $c\\cdot d=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}c\\cdot d & ={c}_{x}\\cdot {d}_{x}+{c}_{y}\\cdot {d}_{y}+{c}_{z}\\cdot {d}_{z} \\\\  & =k\\cdot (-3)+2k\\cdot 2+4\\cdot 2 \\\\  & =-3k+4k+8 \\\\  & =k+8.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain\n\n$$\n\\begin{aligned}c\\cdot d & =0 \\\\ k+8 & =0 \\\\ k & =-8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295325 :knowledge-point/_questions [{:knowledge-point/id #uuid "8bff08bf-0035-5f05-9607-493b301e8717" :knowledge-point/title "Solving for an Unknown Given Two Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19382e00-ca59-50b9-84d8-0478e4b121bf" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186295327} {:answer/id #uuid "bc5f625b-06cc-53be-a1c6-e3d112cd2a75" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186295328}] :answer-field/correct {:answer/id #uuid "19382e00-ca59-50b9-84d8-0478e4b121bf" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186295327} :answer-field/id #uuid "240955df-3d58-5743-a358-3e2c195bafc7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186295326}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "4a8b5a23-ade1-5e2d-9cfe-f55808f3f82d" :question/math-academy-id "q-317945" :question/problem "Let $a=⟨2{x}^{2},-4⟩$ and $b=⟨8,4⟩.$ If $a⊥b$ and $x>0,$ then $x=${{field-1}}." :question/worked-solution "We know that $a⊥b$ ($a$ and $b$ are perpendicular) if and only if $a\\cdot b=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y} \\\\  & =2{x}^{2}\\cdot 8+(-4)\\cdot 4 \\\\  & =16{x}^{2}-16.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 16{x}^{2}-16 & =0 \\\\ 16{x}^{2} & =16 \\\\ {x}^{2} & =1 \\\\ x & =\\pm 1.\\end{aligned}\n$$\n\nWe disregard the negative solution since we are told that $x>0.$ Therefore, $x=1.$"}] [{:db/id #edb/ref 17592186295329 :knowledge-point/_questions [{:knowledge-point/id #uuid "8bff08bf-0035-5f05-9607-493b301e8717" :knowledge-point/title "Solving for an Unknown Given Two Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "539ce263-6b84-5cbd-abef-7e7369f00338" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186295331} {:answer/id #uuid "c8da9be2-1d42-5429-9acf-21ee85a2e9ef" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186295332} {:answer/id #uuid "f4ef04c4-d9ae-52d4-8600-8950d3319403" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186295333} {:answer/id #uuid "a07a5fc6-0808-5a5d-96da-e30f50fc9d93" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186295334} {:answer/id #uuid "778fb45b-3f80-5de9-9acc-6281942f8091" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186295335}] :answer-field/correct {:answer/id #uuid "f4ef04c4-d9ae-52d4-8600-8950d3319403" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186295333} :answer-field/id #uuid "f58711c7-ccbd-558a-a2f7-105490661a59" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186295330}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6b0d4192-2013-565b-ac9f-79ea30bb05ae" :question/math-academy-id "q-77152" :question/problem "Let $u=[\\begin{aligned}a \\\\ 2 \\\\ 4\\end{aligned}]$ and $v=[\\begin{aligned}a \\\\ -4 \\\\ -2\\end{aligned}].$ Given that $u⊥v$ and $a<0$, find the value of $a.$" :question/worked-solution "We know that $u⊥v$ ($u$ and $v$ are perpendicular) if and only if $u\\cdot v=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}u\\cdot v & ={u}_{x}\\cdot {v}_{x}+{u}_{y}\\cdot {v}_{y}+{u}_{z}\\cdot {v}_{z} \\\\  & =a\\cdot a+2\\cdot (-4)+4\\cdot (-2) \\\\  & ={a}^{2}-16.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}u\\cdot v & =0 \\\\ {a}^{2}-16 & =0 \\\\ {a}^{2} & =16 \\\\ a & =\\pm 4\\end{aligned}\n$$\n\nWe disregard the positive solution since we are told that $a<0.$ Therefore, $a=-4.$"}]}
