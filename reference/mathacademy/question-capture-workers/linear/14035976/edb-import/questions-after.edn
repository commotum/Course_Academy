#{[{:db/id #edb/ref 17592186059467 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "68abb4f0-c532-5cb6-882c-dacfe6a945dc" :knowledge-point/title "Calculating the Dot Product Using the General Formula"}] :question/id #uuid "1ab8245a-39fb-5633-b5ff-865ab17dbfb9" :question/math-academy-id "e-4323" :question/problem "Let $\\mathbf{a}=\\langle 0,-0.4,11 \\rangle$ and $\\mathbf{b}=\\langle 2,5,2 \\rangle.$ Find $\\mathbf{a} \\cdot \\mathbf{b}.$" :question/worked-solution "Summing up the products of corresponding components, we obtain:\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =0\\cdot 2+(-0.4)\\cdot 5+11\\cdot 2 \\\\  & =0-2+22 \\\\  & =20\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059468 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "8bff08bf-0035-5f05-9607-493b301e8717" :knowledge-point/title "Solving for an Unknown Given Two Perpendicular Vectors"}] :question/id #uuid "dfc10727-c0d7-5b83-a4f6-afe3eb4831cd" :question/math-academy-id "e-4324" :question/problem "Let $[\\begin{aligned}4 \\\\ -2 \\\\ 1\\end{aligned}]$ and $[\\begin{aligned}-2 \\\\ 5 \\\\ t\\end{aligned}]$. Given that $\\mathbf{a} \\perp \\mathbf{b}$, find the value of $t$." :question/worked-solution "We know that $\\mathbf{a} \\perp \\mathbf{b}$ ($\\mathbf{a}$ and $\\mathbf{b}$ are perpendicular) if and only if $\\mathbf{a} \\cdot \\mathbf{b} = 0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =4\\cdot (-2)+(-2)\\cdot 5+1\\cdot t \\\\  & =-8-10+t \\\\  & =t-18.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ t-18 & =0 \\\\ t & =18\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295287 :knowledge-point/_questions [{:knowledge-point/id #uuid "68abb4f0-c532-5cb6-882c-dacfe6a945dc" :knowledge-point/title "Calculating the Dot Product Using the General Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c0dec7f9-1321-5d29-8483-861b8256a108" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186295289} {:answer/id #uuid "8207c941-b2d6-5c55-81d9-3cfde0824e94" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186295290} {:answer/id #uuid "a24bdf52-d59a-5479-82b3-4e0b250dbb5e" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186295291} {:answer/id #uuid "0c5e8eaa-5436-5c5c-b56f-115afcdd83cf" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186295292} {:answer/id #uuid "0edf2239-9d21-50f9-84a4-29dbdeb62d6d" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186295293}] :answer-field/correct {:answer/id #uuid "a24bdf52-d59a-5479-82b3-4e0b250dbb5e" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186295291} :answer-field/id #uuid "48d9ad0c-7937-590e-a5ee-7d5d31aaebf3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186295288}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d8830dd6-6b8a-5551-9a8b-8f792cfe3f0c" :question/math-academy-id "q-101406" :question/problem "Let $p=⟨1,-2⟩$ and $q=⟨4,-1⟩.$ Find $p\\cdot q.$" :question/worked-solution "Summing up the products of corresponding components, we obtain:\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y} \\\\  & =1\\cdot 4+(-2)\\cdot (-1) \\\\  & =4+2 \\\\  & =6\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059952 :knowledge-point/_questions [{:knowledge-point/id #uuid "68abb4f0-c532-5cb6-882c-dacfe6a945dc" :knowledge-point/title "Calculating the Dot Product Using the General Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b9c7bbd-a81a-5beb-99fb-69a24ae99e23" :answer/type {:db/ident :answer.type/math} :answer/value "39" :db/id #edb/ref 17592186056432} {:answer/id #uuid "a0e81485-e594-5a31-a714-8052d1c5515f" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186056433} {:answer/id #uuid "b26b218b-4861-55ea-a5f0-f6c5d20e9d7b" :answer/type {:db/ident :answer.type/math} :answer/value "57" :db/id #edb/ref 17592186056434} {:answer/id #uuid "00e7b84f-f6bc-5c94-a534-276b5a94944a" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186056435} {:answer/id #uuid "5f3a85f9-f5e5-5513-867d-beff8976dd97" :answer/type {:db/ident :answer.type/math} :answer/value "63" :db/id #edb/ref 17592186056436}] :answer-field/correct {:answer/id #uuid "00e7b84f-f6bc-5c94-a534-276b5a94944a" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186056435} :answer-field/id #uuid "c4244e13-a09a-5a8f-a072-11e4298c8a78" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056431}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "299fd51e-9aaf-5d57-966c-4d85ff141159" :question/math-academy-id "q-1340" :question/problem "Let $u=⟨-3,2⟩$ and $v=⟨7,9⟩.$ Find $u\\cdot v.$" :question/worked-solution "Summing up the products of corresponding components, we obtain:\n\n$$\n\\begin{aligned}u\\cdot v & ={u}_{x}\\cdot {v}_{x}+{u}_{y}\\cdot {v}_{y} \\\\  & =(-3)\\cdot 7+2\\cdot 9 \\\\  & =-21+18 \\\\  & =-3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295294 :knowledge-point/_questions [{:knowledge-point/id #uuid "68abb4f0-c532-5cb6-882c-dacfe6a945dc" :knowledge-point/title "Calculating the Dot Product Using the General Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5db06d97-3597-5722-b99f-cf08cf0e33ed" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186295296} {:answer/id #uuid "29116c10-ee3b-5ee3-8f5e