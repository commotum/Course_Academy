\\\ 6\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 2 \\\\ 1 & 0 \\\\ 1 & 2\\end{aligned}]\\cdot \\frac{1}{24}[\\begin{aligned}8 & -8 \\\\ -8 & 11\\end{aligned}]\\cdot [\\begin{aligned}9 \\\\ 6\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 2 \\\\ 1 & 0 \\\\ 1 & 2\\end{aligned}]\\cdot \\frac{1}{4}[\\begin{aligned}4 \\\\ 1\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}5 \\\\ 2 \\\\ 1\\end{aligned}].\\end{aligned}\n$$\n\n \n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x.$ Equivalently, it is the acute angle between $x$ and any non-zero vector that is parallel to ${\\text{proj}}_{S}x.$ So, to make calculations easier, we can find the angle between the vectors\n\n$\\,$ $x=[\\begin{aligned}2 \\\\ 2 \\\\ 1\\end{aligned}]\\,$ and $\\,2\\,{\\text{proj}}_{S}x=[\\begin{aligned}5 \\\\ 2 \\\\ 1\\end{aligned}].$\n\nComputing the cosine using the dot product, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{x\\cdot {\\text{proj}}_{S}x}{‖x‖‖{\\text{proj}}_{S}x‖} \\\\  & =\\frac{2\\cdot 5+2\\cdot 2+1\\cdot 1}{\\sqrt{{2}^{2}+{2}^{2}+{1}^{2}}\\cdot \\sqrt{{5}^{2}+{2}^{2}+{1}^{2}}} \\\\  & =\\frac{15}{\\sqrt{9}\\sqrt{30}} \\\\  & =\\frac{15}{3\\sqrt{30}} \\\\  & =\\frac{5}{\\sqrt{30}}\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{5}{\\sqrt{30}})≈{24.09}^{∘},\n$$\n\nwhich is already an acute angle." 13194139535838 true] [17592186369309 1000 #edb/ref 17592186369310 13194139535838 true] [17592186369309 1000 #edb/ref 17592186369311 13194139535838 true] [17592186369309 1000 #edb/ref 17592186369312 13194139535838 true] [17592186369309 1000 #edb/ref 17592186369313 13194139535838 true] [17592186369309 1000 #edb/ref 17592186369314 13194139535838 true] [17592186369309 1040 #edb/ref 17592186045450 13194139535838 true] [17592186369309 1041 "selection" 13194139535838 true] [17592186369309 1104 #edb/ref 17592186369314 13194139535838 true] [17592186369309 1110 #uuid "7681410e-317d-58c1-93