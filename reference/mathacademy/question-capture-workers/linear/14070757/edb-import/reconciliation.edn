igned}0 \\\\ 1 \\\\ 0\\end{aligned}]+{x}_{3}[\\begin{aligned}2 \\\\ 0 \\\\ 1\\end{aligned}],\\,{x}_{2},\\,{x}_{3}\\in R.\n$$\n\nConsequently, $B={[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}2 \\\\ 0 \\\\ 1\\end{aligned}]}$ is the basis of the solution space of the system.\n\nNow, we find the orthogonal projection of $x$ onto the solution space of the system:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x \\\\  & =[\\begin{aligned}0 & 2 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot {([\\begin{aligned}0 & 1 & 0 \\\\ 2 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}0 & 2 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}0 & 1 & 0 \\\\ 2 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}-5 \\\\ 2 \\\\ -5\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 2 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot {[\\begin{aligned}1 & 0 \\\\ 0 & 5\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}2 \\\\ -15\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 2 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot \\frac{1}{5}[\\begin{aligned}5 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ -15\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 2 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}-6 \\\\ 2 \\\\ -3\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070757/state.json" "file_sha256" "13b365e05a449e36435067efbdfb2b40b798a38e1ab0edec6a3f64d447d70bd1"} {"question" "q-86844" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070757/activity-metadata.json" "file_sha256" "159578338113af9e880a73a2290c85b1f474b881efbb78f5a2c6b4f033834018"} {"question" "q-86844" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070757/state.json" "file_sha256" "13b365e05a449e36435067efbdfb2b40b798a38e1ab0edec6a3f64d447d70bd1"} {"question" "q-86844" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-3 \\\\ 2 \\\\ -6\\end{aligned}]"] ["math" "[\\begin{aligned}-6 \\\\ 2 \\\\ -3\\end{aligned}]"] ["math" "[\\begin{aligned}2 \\\\ -3 \\\\ -6\\end{aligned}]"] ["math" "[\\begin{aligned}2 \\\\ 6 \\\\ -3\\end{aligned}]"] ["math" "[\\begin{aligned}6 \\\\ 3 \\\\ -2\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070757/state.json" "file_sha256" "13b365e05a449e36435067efbdfb2b40b798a38e1ab0edec6a3f64d447d70bd1"} {"question" "q-86844" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}-6 \\\\ 2 \\\\ -3\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070757/state.json" "file_sha256" "13b365e05a449e36435067efbdfb2b40b798a38e1ab0edec6a3f64d447d70bd1"} {"question" "q-139516" "field" nil "attribute" "question/problem" "value" "Given the vector $x$ and the system of linear equations below, find the projection of $x$ onto the solution space of the system.\n\n$$\nx=[\\begin{aligned}7 \\\\ 2 \\\\ -1\\end{aligned}],\\,{\\begin{aligned}3{x}_{1}-4{x}_{3}=0 \\\\ 6{x}_{1}-8{x}_{3}=0\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070757/state.json" "file_sha256" "13b365e05a449e36435067efbdfb2b40b798a38e1ab0edec6a3f64d447d70bd1"} {"question" "q-139516" "field" nil "attribute" "question/worked-solution" "value" "First, we need to find a basis for the solution space of the system. \n\nConsider the augmented matrix $M$ of the system, which we reduce to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}3 & 0 & -4 & 0 \\\\ 6 & 0 & -8 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}3 & 0 & -4 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, there is $1$ pivot column (the $1$st one). Thus, ${x}_{2},\\,{x}_{3}$ are free variables. Now, from the first equation, we get $3{x}_{1}=4{x}_{3}.$ Therefore, the general solution is\n\n$$\n[\\begin{aligned}\\frac{4}{3}{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]={x}_{2}[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]+\\frac{{x}_{3}}{3}[\\begin{aligned}4 \\\\ 0 \\\\ 3\\end{aligned}],\\,{x}_{2},\\,{x}_{3}\\in R.\n$$\n\nConsequently, $B={[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}4 \\\\ 0 \\\\ 3\\end{aligned}]}$ is the basis of the solution space of the system.\n\nNow, we find the orthogonal projection of $x$ onto the solution space of the system:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x \\\\  & =[\\begin{aligned}0 & 4 \\\\ 1 & 0 \\\\ 0 & 3\\end{aligned}]\\cdot {([\\begin{aligned}0 & 1 & 0 \\\\ 4 & 0 & 3\\end{aligned}]\\cdot [\\begin{aligned}0 & 4 \\\\ 1 & 0 \\\\ 0 & 3\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}0 & 1 & 0 \\\\ 4 & 0 & 3\\end{aligned}]\\cdot [\\begin{aligned}7 \\\\ 2 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 4 \\\\ 1 & 0 \\\\ 0 & 3\\end{aligned}]\\cdot {[\\begin{aligned}1 & 0 \\\\ 0 & 25\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}2 \\\\ 25\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 4 \\\\ 1 & 0 \\\\ 0 & 3\\end{aligned}]\\cdot \\frac{1}{25}[\\begin{aligned}25 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 25\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 4 \\\\ 1 & 0 \\\\ 0 & 3\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ 2 \\\\ 3\\end{aligned}]\\end{aligned}\n$$" "category" 