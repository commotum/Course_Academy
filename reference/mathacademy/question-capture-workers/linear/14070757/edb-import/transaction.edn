 1 & 0\\end{aligned}]\\,\\cdot \\,[\\begin{aligned}0 & 1 \\\\ -1 & 0 \\\\ 1 & 1 \\\\ 0 & 0\\end{aligned}])}^{-1}\\,\\,\\,\\,\\cdot \\,[\\begin{aligned}0 & -1 & 1 & 0 \\\\ 1 & 0 & 1 & 0\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ 0 \\\\ 3 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 1 \\\\ -1 & 0 \\\\ 1 & 1 \\\\ 0 & 0\\end{aligned}]\\cdot {[\\begin{aligned}2 & 1 \\\\ 1 & 2\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}3 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 1 \\\\ -1 & 0 \\\\ 1 & 1 \\\\ 0 & 0\\end{aligned}]\\cdot \\frac{1}{3}[\\begin{aligned}2 & -1 \\\\ -1 & 2\\end{aligned}]\\cdot [\\begin{aligned}3 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 1 \\\\ -1 & 0 \\\\ 1 & 1 \\\\ 0 & 0\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ -1 \\\\ 2 \\\\ 0\\end{aligned}]=\\overset{^}{x}\\end{aligned}\n$$\n\n \n\nFinally, the distance between $x$ and the subspace $S$ is given by\n\n$$\n\\begin{aligned}d(x,\\overset{^}{x}) & =‖x-\\overset{^}{x}‖ \\\\  & =\\sqrt{({x}_{1}-{\\overset{^}{x}}_{1})^{2}+({x}_{2}-{\\overset{^}{x}}_{2})^{2}+({x}_{3}-{\\overset{^}{x}}_{3})^{2}+({x}_{4}-{\\overset{^}{x}}_{4})^{2}} \\\\  & =\\sqrt{(0-1)^{2}+(0-(-1))^{2}+(3-2)^{2}+(1-0)^{2}} \\\\  & =\\sqrt{1+1+1+1} \\\\  & =\\sqrt{4} \\\\  & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-86822/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9d702975-166e-5067-ae3c-1152fade8248"] :knowledge-point/questions ["q-86822"] :db/ensure [:knowledge-point/validate]} {:db/id "q-139468/selection/9f6bfd6fa85d96298a99db901d9b73f609ef64ac0bcf5fbdc4a7ac6d3b733558" :answer/id #uuid "1604be33-d3fe-5057-8040-4102d2087b8b" :answer/type :answer.type/math :answer/value "\\sqrt{6}" :db/ensure [:answer/validate]} {:db/id "q-139468/selection/219347bb4a6f51134d7f5aff5da33544f44afee934064621ebff9cf9e335ee59" :answer/id #uuid "aa72b907-3578-5706-a228-889fdf415a4e" :answer/type :answer.type/math :answer/value "\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "q-139468/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "0a2b5be0-5ebf-5f10-a5c7-23bbb98b8dd1" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-139468/selection/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" :answer/id #uuid "06af6678-2a1a-5294-b539-9e4f2958ae2d" :answer/type :answer.type/math :answer/value "\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-139468/selection/0c8b08d4b198d89c5fe756f861bd5b37e398d2a5b3237908210d9646370a666f" :answer/id #uuid "560d65fe-c36d-59c3-9f82-c645f52063b8" :answer/type :answer.type/math :answer/value "2\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "q-139468/selection" :answer-field/id #uuid "d1959036-a512-5f06-bf9e-f677fd9e32dc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-139468/selection/219347bb4a6f51134d7f5aff5da33544f44afee934064621ebff9cf9e335ee59" :answer-field/choices ["q-139468/selection/9f6bfd6fa85d96298a99db901d9b73f609ef64ac0bcf5fbdc4a7ac6d3b733558" "q-139468/selection/219347bb4a6f51134d7f5aff5da33544f44afee934064621ebff9cf9e335ee59" "q-139468/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-139468/selection/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" "q-139468/selection/0c8b08d4b198d89c5fe756f861bd5b37e398d2a5b3237908210d9646370a666f"] :db/ensure [:answer-field/validate]} {:db/id "q-139468" :question/id #uuid "b595c831-bfc4-5d77-8498-0eeef4435bd4" :question/math-academy-id "q-139468" :question/problem "Find the distance between the vector $x$ and the subspace spanned by the linearly independent vectors ${{a}_{1},{a}_{2}},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}-1 \\\\ -2 \\\\ -2\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-1 \\\\ -2 \\\\ 1\\end{aligned}],\\,x=[\\begin{aligned}5 \\\\ 5 \\\\ 1\\end{aligned}].\n$$" :question/worked-solution "The orthogonal projection of $x$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have \n\n$$\nA=[\\begin{aligned}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{aligned}]=[\\begin{aligned}-1 & -1 \\\\ -2 & -2 \\\\ -2 & 1\\end{aligned}]\\,⟹\\,{A}^{T}=[\\begin{aligned}-1 & -2 & -2 \\\\ -1 & -2 & 1\\end{aligned}].\n$$\n\nTherefore, we get the following projection: \n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}-1 & -1 \\\\ -2 & -2 \\\\ -2 & 1\\end{aligned}]\\cdot {([\\begin{aligned}-1 & -2 & -2 \\\\ -1 & -2 & 1\\end{aligned}]\\cdot [\\begin{aligned}-1 & -1 \\\\ -2 & -2 \\\\ -2 & 1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}-1 & -2 & -2 \\\\ -1 & -2 & 1\\end{aligned}]\\cdot [\\begin{aligned}5 \\\\ 5 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & -1 \\\\ -2 & -2 \\\\ -2 & 1\\end{aligned}]\\cdot {[\\begin{aligned}9 & 3 \\\\ 3 & 6\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}-17 \\\\ -14\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & -1 \\\\ -2 & -2 \\\\ -2 & 1\\end{aligned}]\\cdot \\frac{1}{15}[\\begin{aligned}2 & -1 \\\\ -1 & 3\\end{aligned}]\\cdot [\\begin{aligned}-17 \\\\ -14\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & -1 \\\\ -2 & -2 \\\\ -2 & 1\\end{aligned}]\\cdot \\frac{1}{3}[\\begin{aligned}-4 \\\\ -5\\end{aligned}] \\\\  & =[\\begin{aligned}3 \\\\ 6 \\\\ 1\\end{aligned}]=\\overset{^}{x}\\end{aligned}\n$$\n\nFinally, the distance between $x$ and the subspace $S$ is given by\n\n$$\n\\begin{aligned}d(x,\\overset{^}{x}) & =‖x-\\overset{^}{x}‖ \\\\  & =\\sqrt{({x}_{1}-{\\overset{^}{x}}_{1})^{2}+({x}_{2}-{\\overset{^}{x}}_{2})^{2}+({x}_{3}-{\\overset{^}{x}}_{3})^{2}} \\\\  & =\\sqrt{(5-3)^{2}+(5-6)^{2}+(1-1)^{2}} \\\\  & =\\sqrt{4+1} \\\\  & =\\sqrt{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-139468/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9d702975-166e-5067-ae3c-1152fade8248"] :knowledge-point/questions ["q-139468"] :db/ensure [:knowledge-point/validate]} {:db/id "q-39866/selection/219347bb4a6f51134d7f5aff5da33544f44afee934064621ebff9cf9e335ee59" :answer/id #uuid "c2c09171-a4b2-5f69-b1c6-0c8a9a168608" :answer/type :answer.type/math :answer/value "\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "q-39866/selection/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d" :answer/id #uuid "c4c9e918-217d-5a38-a273-becd90bf2b63" :answer/type :answer.type/math :answer/value "\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-39866/selection/af5580a233ee3709064249d6732fc822dfb93f38caf90c025deb51b127e90b2c" :answer/id #uuid "6a084fd4-83fc-52a2-b00d-dde39ec1f2dd" :answer/type :answer.type/math :answer/value "2\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-39866/selection/05402db46107d70ece210f0bd5e24b332ae4f43bd474d592035c3e3c92625629" :answer/id #uuid "2b9f0ae2-4555-5dd0-b437-c45c530101ee" :answer/type :answer.type/math :answer/value "2\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-39866/selection/f00d8b7a5eeed0dcaa02b7f16c350647a90a461726a760f9ecdf0379dbf8fa63" :answer/id #uuid "bddb2d59-dfe0-5250-b209-4febc8089607" :answer/type :answer.type/math :answer/value "3\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-39866/selection" :answer-field/id #uuid "d8a23c01-4a8c-5875-8ed9-f392e54afeac" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-39866/selection/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d" :answer-field/choices ["q-39866/selection/219347bb4a6f51134d7f5aff5da33544f44afee934064621ebff9cf9e335ee59" "q-39866/selection/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d" "q-39866/selection/af5580a233ee3709064249d6732fc822dfb93f38caf90c025deb51b127e90b2c" "q-39866/selection/05402db46107d70ece210f0bd5e24b332ae4f43bd474d592035c3e3c92625629" "q-39866/selection/f00d8b7a5eeed0dcaa02b7f16c350647a90a461726a760f9ecdf0379dbf8fa63"] :db/ensure [:answer-field/validate]} {:db/id "q-39866" :question/id #uuid "3d1ef28e-6b50-5aa2-aa6e-fcfe1d837ad1" :question/math-academy-id "q-39866" :question/problem "Find the distance between the vector $x$ and the subspace spanned by the linearly independent vectors ${{a}_{1},{a}_{2}},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}-1 \\\\ -1 \\\\ -1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-3 \\\\ -2 \\\\ -3\\end{aligned}],\\,x=[\\begin{aligned}3 \\\\ 2 \\\\ 1\\end{aligned}].\n$$" :question/worked-solution "The orthogonal projection of $x$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have \n\n$$\nA=[\\begin{aligned}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{aligned}]=[\\begin{aligned}-1 & -3 \\\\ -1 & -2 \\\\ -1 & -3\\end{aligned}]\\,⟹\\,{A}^{T}=[\\begin{aligned}-1 & -1 & -1 \\\\ -3 & -2 & -3\\end{aligned}].\n$$\n\nTherefore, we get the following projection: \n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}-1 & -3 \\\\ -1 & -2 \\\\ -1 & -3\\end{aligned}]\\cdot {([\\begin{aligned}-1 & -1 & -1 \\\\ -3 & -2 & -3\\end{aligned}]\\cdot [\\begin{aligned}-1 & -3 \\\\ -1 & -2 \\\\ -1 & -3\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}-1 & -1 & -1 \\\\ -3 & -2 & -3\\end{aligned}]\\cdot [\\begin{aligned}3 \\\\ 2 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & -3 \\\\ -1 & -2 \\\\ -1 & -3\\end{aligned}]\\cdot {[\\begin{aligned}3 & 8 \\\\ 8 & 22\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}-6 \\\\ -16\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & -3 \\\\ -1 & -2 \\\\ -1 & -3\\end{aligned}]\\cdot \\frac{1}{2}[\\begin{aligned}22 & -8 \\\\ -8 & 3\\end{aligned}]\\cdot [\\begin{aligned}-6 \\\\ -16\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & -3 \\\\ -1 & -2 \\\\ -1 & -3\\end{aligned}]\\cdot [\\begin{aligned}-2 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ 2 \\\\ 2\\end{aligned}]=\\overset{^}{x}\\end{aligned}\n$$\n\nFinally, the distance between $x$ and the subspace $S$ is given by\n\n$$\n\\begin{aligned}d(x,\\overset{^}{x}) & =‖x-\\overset{^}{x}‖ \\\\  & =\\sqrt{({x}_{1}-{\\overset{^}{x}}_{1})^{2}+({x}_{2}-{\\overset{^}{x}}_{2})^{2}+({x}_{3}-{\\overset{^}{x}}_{3})^{2}} \\\\  & =\\sqrt{(3-2)^{2}+(2-2)^{2}+(1-2)^{2}} \\\\  & =\\sqrt{1+1} \\\\  & =\\sqrt{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-39866/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9d702975-166e-5067-ae3c-1152fade8248"] :knowledge-point/questions ["q-39866"] :db/ensure [:knowledge-point/validate]} {:db/id "q-139513/selection/d41b26ec084b736985025f3db240c9f0a793d17e7be0a3c7f68a6a541e6f09e1" :answer/id #uuid "44d5e454-7a7a-5f99-a111-ed1883d29fd6" :answer/type :answer.type/math :answer/value "{24.09}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-139513/selection/a54bbacfbe6c981c045c778bf7557d47eeb12a782e548b42092ab1785b61b02a" :answer/id #uuid "538d740c-4ac2-5fd9-ba38-4ec72ab5150f" :answer/type :answer.type/math :answer/value "{22.73}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-139513/selection/d39303f8e705b6238de69800988bc8f03a20b371aca7c3837ea771595112ab10" :answer/id #uuid "31e43407-1442-5956-8857-bb872dc6f4fc" :answer/type :answer.type/math :answer/value "{19.24}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-139513/selection/65d215aa6c465ec601871345ca05f187700ac8acf2e281f1fe677a7e925c0f29" :answer/id #uuid "f6012c3f-1f92-56c0-baee-561ddb5da57d" :answer/type :answer.type/math :answer/value "{24.11}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-139513/selection/34f745667849b198a969b5f7f3b84565a7044f0a605c4324851e0ff3664f5d45" :answer/id #uuid "e8d0bf2b-8633-5361-b638-546c369cf72b" :answer/type :answer.type/math :answer/value "{27.53}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-139513/selection" :answer-field/id #uuid "7681410e-317d-58c1-93e8-abd78f1d6867" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-139513/selection/d41b26ec084b736985025f3db240c9f0a793d17e7be0a3c7f68a6a541e6f09e1" :answer-field/choices ["q-139513/selection/d41b26ec084b736985025f3db240c9f0a793d17e7be0a3c7f68a6a541e6f09e1" "q-139513/selection/a54bbacfbe6c981c045c778bf7557d47eeb12a782e548b42092ab1785b61b02a" "q-139513/selection/d39303f8e705b6238de69800988bc8f03a20b371aca7c3837ea771595112ab10" "q-139513/selection/65d215aa6c465ec601871345ca05f187700ac8acf2e281f1fe677a7e925c0f29" "q-139513/selection/34f745667849b198a969b5f7f3b84565a7044f0a605c4324851e0ff3664f5d45"] :db/ensure [:answer-field/validate]} {:db/id "q-139513" :question/id #uuid "d9996e39-90ec-58ab-ae29-8285c60eba59" :question/math-academy-id "q-139513" :question/problem "Find the acute angle between the vector $x$ and the subspace spanned by the linearly independent vectors ${{a}_{1},{a}_{2}},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}3 \\\\ 1 \\\\ 1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}2 \\\\ 0 \\\\ 2\\end{aligned}],\\,\\,x=[\\begin{aligned}2 \\\\ 2 \\\\ 1\\end{aligned}].\n$$\n\nRound the answer to $2$ decimal places." :question/worked-solution "The orthogonal projection of $x$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have\n\n$$\nA=[\\begin{aligned}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{aligned}]=[\\begin{aligned}3 & 2 \\\\ 1 & 0 \\\\ 1 & 2\\end{aligned}]\\,⟹\\,{A}^{T}=[\\begin{aligned}3 & 1 & 1 \\\\ 2 & 0 & 2\\end{aligned}].\n$$\n\n \n\nTherefore, we get the following projection: \n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}3 & 2 \\\\ 1 & 0 \\\\ 1 & 2\\end{aligned}]\\cdot {([\\begin{aligned}3 & 1 & 1 \\\\ 2 & 0 & 2\\end{aligned}]\\cdot [\\begin{aligned}3 & 2 \\\\ 1 & 0 \\\\ 1 & 2\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}3 & 1 & 1 \\\\ 2 & 0 & 2\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 2 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 2 \\\\ 1 & 0 \\\\ 1 & 2\\end{aligned}]\\cdot {[\\begin{aligned}11 & 8 \\\\ 8 & 8\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}9 \\\\ 6\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 2 \\\\ 1 & 0 \\\\ 1 & 2\\end{aligned}]\\cdot \\frac{1}{24}[\\begin{aligned}8 & -8 \\\\ -8 & 11\\end{aligned}]\\cdot [\\begin{aligned}9 \\\\ 6\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 2 \\\\ 1 & 0 \\\\ 1 & 2\\end{aligned}]\\cdot \\frac{1}{4}[\\begin{aligned}4 \\\\ 1\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}5 \\\\ 2 \\\\ 1\\end{aligned}].\\end{aligned}\n$$\n\n \n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x.$ Equivalently, it is the acute angle between $x$ and any non-zero vector that is parallel to ${\\text{proj}}_{S}x.$ So, to make calculations easier, we can find the angle between the vectors\n\n$\\,$ $x=[\\begin{aligned}2 \\\\ 2 \\\\ 1\\end{aligned}]\\,$ and $\\,2\\,{\\text{proj}}_{S}x=[\\begin{aligned}5 \\\\ 2 \\\\ 1\\end{aligned}].$\n\nComputing the cosine using the dot product, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{x\\cdot {\\text{proj}}_{S}x}{‖x‖‖{\\text{proj}}_{S}x‖} \\\\  & =\\frac{2\\cdot 5+2\\cdot 2+1\\cdot 1}{\\sqrt{{2}^{2}+{2}^{2}+{1}^{2}}\\cdot \\sqrt{{5}^{2}+{2}^{2}+{1}^{2}}} \\\\  & =\\frac{15}{\\sqrt{9}\\sqrt{30}} \\\\  & =\\frac{15}{3\\sqrt{30}} \\\\  & =\\frac{5}{\\sqrt{30}}\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{5}{\\sqrt{30}})≈{24.09}^{∘},\n$$\n\nwhich is already an acute angle." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-139513/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1224e2dd-96bc-5c24-aacf-3c36a7c3a1e1"] :knowledge-point/questions ["q-139513"] :db/ensure [:knowledge-point/validate]} {:db/id "q-139477/selection/82f0679237d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5" :answer/id #uuid "b94c84d1-b842-5198-97bf-ce27c396ffdd" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-139477/selection/e0bd991ac2e2f2a23ec920e03c6d5103be6b20c12a25d724ab290d4ba5292c3e" :answer/id #uuid "2ebcc90d-1933-58ad-aa8d-13d1e34bfe78" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{6}" :db/ensure [:answer/validate]} {:db/id "q-139477/selection/1e940709a1b00fa910544fd0093551b452ea4b241ad5d9959525312e8a27fa19" :answer/id #uuid "81f0e5ed-ce34-558b-9247-be1e4682bb04" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{8}" :db/ensure [:answer/validate]} {:db/id "q-139477/selection/adbad78d33491a071139fe589fefda7e9ba65cf97ebbcae14d252ac90459e198" :answer/id #uuid "e8207bc8-ff83-5660-a5ae-3c6eb5ac0fec" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "q-139477/selection/7b1b8538b264eef6681d0ab5f3b14d51b6cdff67f34fba59d0886ae5c6acf80a" :answer/id #uuid "7fdd3461-c777-54d8-befe-8255827f1071" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-139477/selection" :answer-field/id #uuid "3cf33214-5c7c-5783-8173-23a86bd525a5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-139477/selection/82f0679237d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5" :answer-field/choices ["q-139477/selection/82f0679237d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5" "q-139477/selection/e0bd991ac2e2f2a23ec920e03c6d5103be6b20c12a25d724ab290d4ba5292c3e" "q-139477/selection/1e940709a1b00fa910544fd0093551b452ea4b241ad5d9959525312e8a27fa19" "q-139477/selection/adbad78d33491a071139fe589fefda7e9ba65cf97ebbcae14d252ac90459e198" "q-139477/selection/7b1b8538b264eef6681d0ab5f3b14d51b6cdff67f34fba59d0886ae5c6acf80a"] :db/ensure [:answer-field/validate]} {:db/id "q-139477" :question/id #uuid "ff6bf7f2-41a6-5715-86f4-17d527b45999" :question/math-academy-id "q-139477" :question/problem "Find the acute angle between the vector $x$ and the subspace spanned by the linearly independent vectors ${{a}_{1},{a}_{2}},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}-2 \\\\ 2 \\\\ -1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-1 \\\\ 1 \\\\ -1\\end{aligned}],\\,x=[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}].\n$$" :question/worked-solution "The orthogonal projection of $x$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have\n\n$$\nA=[\\begin{aligned}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{aligned}]=[\\begin{aligned}-2 & -1 \\\\ 2 & 1 \\\\ -1 & -1\\end{aligned}]\\,⟹\\,{A}^{T}=[\\begin{aligned}-2 & 2 & -1 \\\\ -1 & 1 & -1\\end{aligned}].\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}-2 & -1 \\\\ 2 & 1 \\\\ -1 & -1\\end{aligned}]\\cdot {([\\begin{aligned}-2 & 2 & -1 \\\\ -1 & 1 & -1\\end{aligned}]\\cdot [\\begin{aligned}-2 & -1 \\\\ 2 & 1 \\\\ -1 & -1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}-2 & 2 & -1 \\\\ -1 & 1 & -1\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -1 \\\\ 2 & 1 \\\\ -1 & -1\\end{aligned}]\\cdot {[\\begin{aligned}9 & 5 \\\\ 5 & 3\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}2 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -1 \\\\ 2 & 1 \\\\ -1 & -1\\end{aligned}]\\cdot \\frac{1}{2}[\\begin{aligned}3 & -5 \\\\ -5 & 9\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -1 \\\\ 2 & 1 \\\\ -1 & -1\\end{aligned}]\\cdot \\frac{1}{2}[\\begin{aligned}1 \\\\ -1\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}-1 \\\\ 1 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x.$ Equivalently, it is the acute angle between $x$ and any non-zero vector that is parallel to ${\\text{proj}}_{S}x.$ So, to make calculations easier, we can find the angle between the vectors\n\n$\\,$ $x=[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]\\,$ and $\\,2\\,{\\text{proj}}_{S}x=[\\begin{aligned}-1 \\\\ 1 \\\\ 0\\end{aligned}].$\n\nComputing the cosine using the dot product, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{0\\cdot (-1)+1\\cdot 1+0\\cdot 0}{\\sqrt{{0}^{2}+{1}^{2}+{0}^{2}}\\sqrt{(-1)^{2}+{1}^{2}+{0}^{2}}} \\\\  & =\\frac{1}{\\sqrt{1}\\sqrt{2}} \\\\  & =\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{\\sqrt{2}}{2})=\\frac{\\pi }{4},\n$$\n\nwhich is already an acute angle." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-139477/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1224e2dd-96bc-5c24-aacf-3c36a7c3a1e1"] :knowledge-point/questions ["q-139477"] :db/ensure [:knowledge-point/validate]} {:db/id "q-139478/selection/82f0679237d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5" :answer/id #uuid "aec2a2dc-703c-57e2-a67b-d6104024bc69" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-139478/selection/adbad78d33491a071139fe589fefda7e9ba65cf97ebbcae14d252ac90459e198" :answer/id #uuid "59a611c7-e9d6-504d-b4e1-2fa62b6e08f0" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "q-139478/selection/7b1b8538b264eef6681d0ab5f3b14d51b6cdff67f34fba59d0886ae5c6acf80a" :answer/id #uuid "a3aa7f63-5de7-539e-89d4-1cfdfbc0fdb0" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-139478/selection/e0bd991ac2e2f2a23ec920e03c6d5103be6b20c12a25d724ab290d4ba5292c3e" :answer/id #uuid "92705817-5c59-541b-b3a1-69d977f2cb0e" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{6}" :db/ensure [:answer/validate]} {:db/id "q-139478/selection/8d714c1fd416e58da765395a7a57c526e1b97a45c41a59520f74d433a1e9ba87" :answer/id #uuid "92d5f5ba-d359-5cd7-a409-3b38a0a2815a" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{12}" :db/ensure [:answer/validate]} {:db/id "q-139478/selection" :answer-field/id #uuid "9dd3a21e-7267-5a2e-b7c7-0304198825d4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-139478/selection/adbad78d33491a071139fe589fefda7e9ba65cf97ebbcae14d252ac90459e198" :answer-field/choices ["q-139478/selection/82f0679237d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5" "q-139478/selection/adbad78d33491a071139fe589fefda7e9ba65cf97ebbcae14d252ac90459e198" "q-139478/selection/7b1b8538b264eef6681d0ab5f3b14d51b6cdff67f34fba59d0886ae5c6acf80a" "q-139478/selection/e0bd991ac2e2f2a23ec920e03c6d5103be6b20c12a25d724ab290d4ba5292c3e" "q-139478/selection/8d714c1fd416e58da765395a7a57c526e1b97a45c41a59520f74d433a1e9ba87"] :db/ensure [:answer-field/validate]} {:db/id "q-139478" :question/id #uuid "261f695d-8bc5-5597-b165-65e42fe2448f" :question/math-academy-id "q-139478" :question/problem "Find the acute angle between the vector $x$ and the subspace spanned by the linearly independent vectors ${{a}_{1},{a}_{2}},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}-1 \\\\ 1 \\\\ 0\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-3 \\\\ 3 \\\\ 3\\end{aligned}],\\,x=[\\begin{aligned}-6 \\\\ -3 \\\\ 3\\end{aligned}].\n$$" :question/worked-solution "The orthogonal projection of $x$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have\n\n$$\nA=[\\begin{aligned}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{aligned}]=[\\begin{aligned}-1 & -3 \\\\ 1 & 3 \\\\ 0 & 3\\end{aligned}]\\,⟹\\,{A}^{T}=[\\begin{aligned}-1 & 1 & 0 \\\\ -3 & 3 & 3\\end{aligned}].\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}-1 & -3 \\\\ 1 & 3 \\\\ 0 & 3\\end{aligned}]\\cdot {([\\begin{aligned}-1 & 1 & 0 \\\\ -3 & 3 & 3\\end{aligned}]\\cdot [\\begin{aligned}-1 & -3 \\\\ 1 & 3 \\\\ 0 & 3\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}-1 & 1 & 0 \\\\ -3 & 3 & 3\\end{aligned}]\\cdot [\\begin{aligned}-6 \\\\ -3 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & -3 \\\\ 1 & 3 \\\\ 0 & 3\\end{aligned}]\\cdot {[\\begin{aligned}2 & 6 \\\\ 6 & 27\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}3 \\\\ 18\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & -3 \\\\ 1 & 3 \\\\ 0 & 3\\end{aligned}]\\cdot \\frac{1}{18}[\\begin{aligned}27 & -6 \\\\ -6 & 2\\end{aligned}]\\cdot [\\begin{aligned}3 \\\\ 18\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & -3 \\\\ 1 & 3 \\\\ 0 & 3\\end{aligned}]\\cdot \\frac{1}{2}[\\begin{aligned}-3 \\\\ 2\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}-3 \\\\ 3 \\\\ 6\\end{aligned}]\\end{aligned}\n$$\n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x.$ Equivalently, it is the acute angle between $x$ and any non-zero vector that is parallel to ${\\text{proj}}_{S}x.$ So, to make calculations easier, we can find the angle between the vectors\n\n$\\,$ $x=[\\begin{aligned}-6 \\\\ -3 \\\\ 3\\end{aligned}]\\,$ and $\\,2\\,{\\text{proj}}_{S}x=[\\begin{aligned}-3 \\\\ 3 \\\\ 6\\end{aligned}].$\n\nComputing the cosine using the dot product, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{(-6)\\cdot (-3)+(-3)\\cdot 3+3\\cdot 6}{\\sqrt{(-6)^{2}+(-3)^{2}+{3}^{2}}\\sqrt{(-3)^{2}+{3}^{2}+{6}^{2}}} \\\\  & =\\frac{27}{\\sqrt{54}\\sqrt{54}} \\\\  & =\\frac{27}{54} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{1}{2})=\\frac{\\pi }{3},\n$$\n\nwhich is already an acute angle." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-139478/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1224e2dd-96bc-5c24-aacf-3c36a7c3a1e1"] :knowledge-point/questions ["q-139478"] :db/ensure [:knowledge-point/validate]} {:db/id "q-86829/selection/b9661382b01f6848b7a8c0a326b15196449ed0bdade76cab30650efadc3a7fad" :answer/id #uuid "144daa9b-0b6c-5296-b492-7cf4a67b6646" :answer/type :answer.type/math :answer/value "{45.77}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-86829/selection/ae820741ab75b63270e97d9ba1c227802b7c3202a87bf59fa68811f6ac862520" :answer/id #uuid "9a072932-26b9-56ea-b1b9-d577630f78ea" :answer/type :answer.type/math :answer/value "{19.47}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-86829/selection/afe728cf34cd8ead218f0f5265f8a42a2d4c10c959060911a3890d41699ec0b6" :answer/id #uuid "456fb80b-4f23-583e-8981-7131042a6096" :answer/type :answer.type/math :answer/value "{32.54}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-86829/selection/e72de562c7b6e499859099a87925b9e505257e3ffa864de9eb0228a0ffe3652e" :answer/id #uuid "8af40672-e0ba-573c-8071-00ca71ec7b83" :answer/type :answer.type/math :answer/value "{21}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-86829/selection/fc860c175b32483df1979720748b5c5f67376781a87673b851c9d840d009a9f7" :answer/id #uuid "3459e90e-5976-5703-b769-16dcfff6e116" :answer/type :answer.type/math :answer/value "{37}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-86829/selection" :answer-field/id #uuid "b28da0ea-38d9-5b50-b8dd-aa7d0bdc12a2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-86829/selection/ae820741ab75b63270e97d9ba1c227802b7c3202a87bf59fa68811f6ac862520" :answer-field/choices ["q-86829/selection/b9661382b01f6848b7a8c0a326b15196449ed0bdade76cab30650efadc3a7fad" "q-86829/selection/ae820741ab75b63270e97d9ba1c227802b7c3202a87bf59fa68811f6ac862520" "q-86829/selection/afe728cf34cd8ead218f0f5265f8a42a2d4c10c959060911a3890d41699ec0b6" "q-86829/selection/e72de562c7b6e499859099a87925b9e505257e3ffa864de9eb0228a0ffe3652e" "q-86829/selection/fc860c175b32483df1979720748b5c5f67376781a87673b851c9d840d009a9f7"] :db/ensure [:answer-field/validate]} {:db/id "q-86829" :question/id #uuid "54fe32be-53ae-55c1-bdf3-064634d40b4c" :question/math-academy-id "q-86829" :question/problem "Find the acute angle between the vector $x$ and the subspace spanned by the linearly independent vectors ${{a}_{1},{a}_{2}},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}-1 \\\\ 1 \\\\ 0\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}1 \\\\ 0 \\\\ -1\\end{aligned}],\\,x=[\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}].\n$$\n\nRound the answer to $2$ decimal places." :question/worked-solution "The orthogonal projection of $x$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have\n\n$$\nA=[\\begin{aligned}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{aligned}]=[\\begin{aligned}-1 & 1 \\\\ 1 & 0 \\\\ 0 & -1\\end{aligned}]\\,⟹\\,{A}^{T}=[\\begin{aligned}-1 & 1 & 0 \\\\ 1 & 0 & -1\\end{aligned}].\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}-1 & 1 \\\\ 1 & 0 \\\\ 0 & -1\\end{aligned}]\\cdot {([\\begin{aligned}-1 & 1 & 0 \\\\ 1 & 0 & -1\\end{aligned}]\\cdot [\\begin{aligned}-1 & 1 \\\\ 1 & 0 \\\\ 0 & -1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}-1 & 1 & 0 \\\\ 1 & 0 & -1\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 1 \\\\ 1 & 0 \\\\ 0 & -1\\end{aligned}]\\cdot {[\\begin{aligned}2 & -1 \\\\ -1 & 2\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}0 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 1 \\\\ 1 & 0 \\\\ 0 & -1\\end{aligned}]\\cdot \\frac{1}{3}[\\begin{aligned}2 & 1 \\\\ 1 & 2\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 1 \\\\ 1 & 0 \\\\ 0 & -1\\end{aligned}]\\cdot \\frac{1}{3}[\\begin{aligned}2 \\\\ 4\\end{aligned}] \\\\  & =\\frac{1}{3}[\\begin{aligned}2 \\\\ 2 \\\\ -4\\end{aligned}]\\end{aligned}\n$$\n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x.$ Equivalently, it is the acute angle between $x$ and any non-zero vector that is parallel to ${\\text{proj}}_{S}x.$ So, to make calculations easier, we can find the angle between the vectors\n\n$\\,$ $x=[\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}]\\,$ and $\\,3\\,{\\text{proj}}_{S}x=[\\begin{aligned}2 \\\\ 2 \\\\ -4\\end{aligned}].$ \n\nComputing the cosine using the dot product, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{1\\cdot 2+1\\cdot 2+(-1)\\cdot (-4)}{\\sqrt{{1}^{2}+{1}^{2}+(-1)^{2}}\\sqrt{{2}^{2}+{2}^{2}+(-4)^{2}}} \\\\  & =\\frac{8}{\\sqrt{3}\\sqrt{24}} \\\\  & =\\frac{8}{\\sqrt{3}\\sqrt{3\\cdot 8}} \\\\  & =\\frac{\\sqrt{8}}{3}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{\\sqrt{8}}{3})≈{19.47}^{∘},\n$$\n\nwhich is already an acute angle." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-86829/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1224e2dd-96bc-5c24-aacf-3c36a7c3a1e1"] :knowledge-point/questions ["q-86829"] :db/ensure [:knowledge-point/validate]} {:db/id "q-39877/selection/88b1905ae8cf460c2a84a32c5d8c6f90d2ce7d0370cd85427f3bb58fd7738404" :answer/id #uuid "1e3756c7-f8fd-554a-b52f-7422bacedc3b" :answer/type :answer.type/math :answer/value "{14.21}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-39877/selection/cc90dd9a51e2091505fa17aa90737c4d130ab3f984ee2d12a9a7b13d4eca8c2c" :answer/id #uuid "c4090e9f-99a9-520d-9bc6-613091d28576" :answer/type :answer.type/math :answer/value "{54.05}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-39877/selection/1e4d45c70c5685a750a5a4496b19190d98adef9706655a4bcd903f6ab81e3036" :answer/id #uuid "3a912902-59f7-5bf5-a2bc-fa66cc2f3b81" :answer/type :answer.type/math :answer/value "{22.21}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-39877/selection/efee379e5a6b109338cf92beef80d59b4ac7099946aad7ded2dd36bcb5085e41" :answer/id #uuid "c3706f4b-0c2f-5499-8301-b6a65cd68eda" :answer/type :answer.type/math :answer/value "{45.12}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-39877/selection/f83be2d4e1733f0eee0d3737d99e36b4d8c9d569a49a73efd0c31b98b44491e1" :answer/id #uuid "c2637d29-2ea4-5da5-8466-6ed05a914dad" :answer/type :answer.type/math :answer/value "{34.05}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-39877/selection" :answer-field/id #uuid "935ea930-c8d1-59e3-8b84-8bf4ae88a3be" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-39877/selection/1e4d45c70c5685a750a5a4496b19190d98adef9706655a4bcd903f6ab81e3036" :answer-field/choices ["q-39877/selection/88b1905ae8cf460c2a84a32c5d8c6f90d2ce7d0370cd85427f3bb58fd7738404" "q-39877/selection/cc90dd9a51e2091505fa17aa90737c4d130ab3f984ee2d12a9a7b13d4eca8c2c" "q-39877/selection/1e4d45c70c5685a750a5a4496b19190d98adef9706655a4bcd903f6ab81e3036" "q-39877/selection/efee379e5a6b109338cf92beef80d59b4ac7099946aad7ded2dd36bcb5085e41" "q-39877/selection/f83be2d4e1733f0eee0d3737d99e36b4d8c9d569a49a73efd0c31b98b44491e1"] :db/ensure [:answer-field/validate]} {:db/id "q-39877" :question/id #uuid "ee51df09-14be-50a6-b4c6-cd6a74d7c695" :question/math-academy-id "q-39877" :question/problem "Find the acute angle between the vector $x$ and the subspace spanned by the linearly independent vectors ${{a}_{1},{a}_{2}},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 2 \\\\ 1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}2 \\\\ 1 \\\\ 2\\end{aligned}],\\,\\,x=[\\begin{aligned}3 \\\\ 2 \\\\ 1\\end{aligned}].\n$$\n\nRound the answer to $2$ decimal places." :question/worked-solution "The orthogonal projection of $x$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have\n\n$$\nA=[\\begin{aligned}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{aligned}]=[\\begin{aligned}1 & 2 \\\\ 2 & 1 \\\\ 1 & 2\\end{aligned}]\\,⟹\\,{A}^{T}=[\\begin{aligned}1 & 2 & 1 \\\\ 2 & 1 & 2\\end{aligned}].\n$$\n\n \n\nTherefore, we get the following projection: \n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}1 & 2 \\\\ 2 & 1 \\\\ 1 & 2\\end{aligned}]\\cdot {([\\begin{aligned}1 & 2 & 1 \\\\ 2 & 1 & 2\\end{aligned}]\\cdot [\\begin{aligned}1 & 2 \\\\ 2 & 1 \\\\ 1 & 2\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}1 & 2 & 1 \\\\ 2 & 1 & 2\\end{aligned}]\\cdot [\\begin{aligned}3 \\\\ 2 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 \\\\ 2 & 1 \\\\ 1 & 2\\end{aligned}]\\cdot {[\\begin{aligned}6 & 6 \\\\ 6 & 9\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}8 \\\\ 10\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 \\\\ 2 & 1 \\\\ 1 & 2\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{2} & -\\frac{1}{3} \\\\ -\\frac{1}{3} & \\frac{1}{3}\\end{aligned}]\\cdot [\\begin{aligned}8 \\\\ 10\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 \\\\ 2 & 1 \\\\ 1 & 2\\end{aligned}]\\cdot [\\begin{aligned}\\frac{2}{3} \\\\ \\frac{2}{3}\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ 2 \\\\ 2\\end{aligned}].\\end{aligned}\n$$\n\n \n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x.$   \n\nComputing the cosine using the dot product, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{x\\cdot {\\text{proj}}_{S}x}{‖x‖‖{\\text{proj}}_{S}x‖} \\\\  & =\\frac{3\\cdot 2+2\\cdot 2+1\\cdot 2}{\\sqrt{{3}^{2}+{2}^{2}+{1}^{2}}\\cdot \\sqrt{{2}^{2}+{2}^{2}+{2}^{2}}} \\\\  & =\\frac{12}{\\sqrt{14}\\sqrt{12}} \\\\  & =\\frac{12}{2\\sqrt{42}} \\\\  & =\\frac{6}{\\sqrt{42}}\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{6}{\\sqrt{42}})≈{22.21}^{∘},\n$$\n\nwhich is already an acute angle." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-39877/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1224e2dd-96bc-5c24-aacf-3c36a7c3a1e1"] :knowledge-point/questions ["q-39877"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81435/selection/a51b5d98d135312d006e556f37cffdda39fee6cebfacdc46fdfba370ab35568c" :answer/id #uuid "d47aa629-8c84-531e-8794-726e06d6f2fa" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 2 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81435/selection/534fd6d4e5793d4a1582637186a09c98d05692ca6a330880c84d7557874b8273" :answer/id #uuid "f7f1a2b2-1868-5065-8d57-32deb213c39c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ 2 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81435/selection/2a2dfa122b83e1fbc6b70be6ef717447914d5f79f3dfea05d917ce624c516d65" :answer/id #uuid "9a9c4018-9771-53ad-bc7f-cc7b25ecc92d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 2 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81435/selection/097bf54e53fd44fd496a8806d7ef0ea4f567d8a5a994b298b0fe8b19f4b98622" :answer/id #uuid "150b5714-c0f4-5d89-81a2-537a245fcea1" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ 2 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81435/selection/582bc38e6734262003622b06fe4f989a93a6c9f61114201f0f1b6f007c8e21a4" :answer/id #uuid "60e15c0b-d880-5bdf-90de-35b23a896f70" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 \\\\ 2 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81435/selection" :answer-field/id #uuid "1e7cd7ef-e6a4-5d83-942e-a6ff8e11d25e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81435/selection/a51b5d98d135312d006e556f37cffdda39fee6cebfacdc46fdfba370ab35568c" :answer-field/choices ["q-81435/selection/a51b5d98d135312d006e556f37cffdda39fee6cebfacdc46fdfba370ab35568c" "q-81435/selection/534fd6d4e5793d4a1582637186a09c98d05692ca6a330880c84d7557874b8273" "q-81435/selection/2a2dfa122b83e1fbc6b70be6ef717447914d5f79f3dfea05d917ce624c516d65" "q-81435/selection/097bf54e53fd44fd496a8806d7ef0ea4f567d8a5a994b298b0fe8b19f4b98622" "q-81435/selection/582bc38e6734262003622b06fe4f989a93a6c9f61114201f0f1b6f007c8e21a4"] :db/ensure [:answer-field/validate]} {:db/id "q-81435" :question/id #uuid "76b489c8-5c8f-576c-ba37-1623ccf3438d" :question/math-academy-id "q-81435" :question/problem "Given the vector $x$ and the system of linear equations below, find the projection of $x$ onto the solution space of the system.\n\n$$\nx=[\\begin{aligned}0 \\\\ 2 \\\\ 2\\end{aligned}],\\,{\\begin{aligned}2{x}_{1}-2{x}_{3}=0 \\\\ 4{x}_{1}-4{x}_{3}=0\\end{aligned}\n$$" :question/worked-solution "First, we need to find the basis of the solution space of the system.\n\nConsider the augmented matrix $M$ of the system, which we reduce to its row echelon form. Then\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}2 & 0 & -2 & 0 \\\\ 4 & 0 & -4 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼[\\begin{aligned}2 & 0 & -2 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nIn the reduced matrix above, there is $1$ pivot column (the $1$st one). Thus, ${x}_{2},\\,{x}_{3}$ are free variables. Now, from the first equation, we get ${x}_{1}={x}_{3}.$ Therefore, the general solution is\n\n$$\n[\\begin{aligned}{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]={x}_{2}[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]+{x}_{3}[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}],\\,{x}_{2},\\,{x}_{3}\\in R.\n$$\n\nConsequently, $B={[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}]}$ is the basis of the solution space of the system.\n\nNow, we find the orthogonal projection of $x$ onto the solution space of the system:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x \\\\  & =[\\begin{aligned}0 & 1 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot {([\\begin{aligned}0 & 1 & 0 \\\\ 1 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}0 & 1 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}0 & 1 & 0 \\\\ 1 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ 2 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 1 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot {[\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}2 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 1 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot \\frac{1}{2}[\\begin{aligned}2 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 1 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 2 \\\\ 1\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-81435/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "26b41192-9680-55c3-930c-52ff235e1800"] :knowledge-point/questions ["q-81435"] :db/ensure [:knowledge-point/validate]} {:db/id "q-40619/selection/f98c18a27dcb118caf5a5576c91aab2f7c6ef2dcdc9bdea8485ada011f865eac" :answer/id #uuid "869d3e16-1f66-5469-a612-8c940906905f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-40619/selection/7894546b3903677da13bdeaf9d7d2b29dd1b9c4bd056c1fb4a4b4fec38ca0754" :answer/id #uuid "66f05c7d-c36e-5918-a866-f4581e7ac1bd" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 \\\\ 2 \\\\ 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-40619/selection/b224d6448f48c09556b4f6674038dfa9570ee65bf4bf2c5ccecdf8f650448c7b" :answer/id #uuid "4627d89e-72e6-522f-8cac-645db740f4c7" :answer/type :answer.type/math :answer/value "[\\begin{aligned}5 \\\\ 2 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-40619/selection/f12c752ed8360bb4ce7c111a93f078cadfcd91bfc44f4cd9f457b1c0d8f0e8b1" :answer/id #uuid "7981359a-6fd8-519a-99c5-8b654de4356c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}5 \\\\ 4 \\\\ 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-40619/selection/c4ab24e23f8cb36bf53d1c59f12b1ed8d02382bdd0169936fd1e25a4ec01e78a" :answer/id #uuid "6f65ffca-b426-573f-8b89-3c97a3afa649" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 \\\\ 5 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-40619/selection" :answer-field/id #uuid "f0421023-47eb-599c-ad84-e8bf73ef9c74" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-40619/selection/c4ab24e23f8cb36bf53d1c59f12b1ed8d02382bdd0169936fd1e25a4ec01e78a" :answer-field/choices ["q-40619/selection/f98c18a27dcb118caf5a5576c91aab2f7c6ef2dcdc9bdea8485ada011f865eac" "q-40619/selection/7894546b3903677da13bdeaf9d7d2b29dd1b9c4bd056c1fb4a4b4fec38ca0754" "q-40619/selection/b224d6448f48c09556b4f6674038dfa9570ee65bf4bf2c5ccecdf8f650448c7b" "q-40619/selection/f12c752ed8360bb4ce7c111a93f078cadfcd91bfc44f4cd9f457b1c0d8f0e8b1" "q-40619/selection/c4ab24e23f8cb36bf53d1c59f12b1ed8d02382bdd0169936fd1e25a4ec01e78a"] :db/ensure [:answer-field/validate]} {:db/id "q-40619" :question/id #uuid "f5bf46cf-96b9-5877-b08c-6edcfc02797d" :question/math-academy-id "q-40619" :question/problem "Given the vector $x$ and the system of linear equations below, find the projection of $x$ onto the solution space of the system.\n\n$$\nx=[\\begin{aligned}5 \\\\ 5 \\\\ 0\\end{aligned}],\\,{\\begin{aligned}{x}_{1}-2{x}_{3}=0 \\\\ 2{x}_{1}-4{x}_{3}=0\\end{aligned}\n$$" :question/worked-solution "First, we need to find a basis for the solution space of the system. \n\nConsider the augmented matrix $M$ of the system, which we reduce to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 0 & -2 & 0 \\\\ 2 & 0 & -4 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & -2 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nIn the reduced matrix above, there is $1$ pivot column (the $1$st one). Thus, ${x}_{2},\\,{x}_{3}$ are free variables. Now, from the first equation, we get ${x}_{1}=2{x}_{3}.$ Therefore, the general solution is\n\n$$\n[\\begin{aligned}2{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]={x}_{2}[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]+{x}_{3}[\\begin{aligned}2 \\\\ 0 \\\\ 1\\end{aligned}],\\,{x}_{2},\\,{x}_{3}\\in R.\n$$\n\nConsequently, $B={[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}2 \\\\ 0 \\\\ 1\\end{aligned}]}$ is the basis of the solution space of the system.\n\nNow, we find the orthogonal projection of $x$ onto the solution space of the system:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x \\\\  & =[\\begin{aligned}0 & 2 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot {([\\begin{aligned}0 & 1 & 0 \\\\ 2 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}0 & 2 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}0 & 1 & 0 \\\\ 2 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}5 \\\\ 5 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 2 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot {[\\begin{aligned}1 & 0 \\\\ 0 & 5\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}5 \\\\ 10\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 2 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot \\frac{1}{5}[\\begin{aligned}5 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}5 \\\\ 10\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 2 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}5 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ 5 \\\\ 2\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-40619/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "26b41192-9680-55c3-930c-52ff235e1800"] :knowledge-point/questions ["q-40619"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-39858"] :question/problem "Given the vector $x$ and the system of linear equations below, find the projection of $x$ onto the solution space of the system.\n\n$$\nx=[\\begin{aligned}0 \\\\ 0 \\\\ 14\\end{aligned}],\\,{\\begin{aligned}{x}_{1}-3{x}_{2}+2{x}_{3}=0 \\\\ 3{x}_{1}-9{x}_{2}+6{x}_{3}=0\\end{aligned}\n$$" :question/worked-solution "First, we need to find a basis for the solution space of the system. \n\nConsider the augmented matrix $M$ of the system, which we reduce to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -3 & 2 & 0 \\\\ 3 & -9 & 6 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, there is $1$ pivot column (the $1$st one). Thus, ${x}_{2},\\,{x}_{3}$ are free variables. Now, from the first equation, we get ${x}_{1}=3{x}_{2}-2{x}_{3}.$ Therefore, the general solution is\n\n$$\n[\\begin{aligned}3{x}_{2}-2{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]={x}_{2}[\\begin{aligned}3 \\\\ 1 \\\\ 0\\end{aligned}]+{x}_{3}[\\begin{aligned}-2 \\\\ 0 \\\\ 1\\end{aligned}],\\,{x}_{2},\\,{x}_{3}\\in R.\n$$\n\nConsequently, $B={[\\begin{aligned}3 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}-2 \\\\ 0 \\\\ 1\\end{aligned}]}$ is the basis of the solution space of the system.\n\nNow, we find the orthogonal projection of $x$ onto the solution space of the system:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x \\\\  & =[\\begin{aligned}3 & -2 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot {([\\begin{aligned}3 & 1 & 0 \\\\ -2 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}3 & -2 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}3 & 1 & 0 \\\\ -2 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ 0 \\\\ 14\\end{aligned}] \\\\  & =[\\begin{aligned}3 & -2 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot {[\\begin{aligned}10 & -6 \\\\ -6 & 5\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}0 \\\\ 14\\end{aligned}] \\\\  & =[\\begin{aligned}3 & -2 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot \\frac{1}{14}[\\begin{aligned}5 & 6 \\\\ 6 & 10\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ 14\\end{aligned}] \\\\  & =[\\begin{aligned}3 & -2 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}6 \\\\ 10\\end{aligned}] \\\\  & =[\\begin{aligned}-2 \\\\ 6 \\\\ 10\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-86844/selection/aa30dc4497c0de5584f0b0073677c0ec241ab570128703ad44be5c4e1fe7af6a" :answer/id #uuid "e7d12810-d30c-5d34-ad6b-def055f930ea" :answer/type :answer.type/math :answer/value "[\\begin{aligned}6 \\\\ 3 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-86844/selection/61d8f3b0415f1db1b7d49eeed16209ab9d88a2b949a2a6c9c1b3800c45fb571a" :answer/id #uuid "252e1f38-7120-5853-9a20-ff0cc5a7b327" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ 6 \\\\ -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-86844/selection/c093dd6b3f7eeaea34b8b04bb4c6e0c974f84027488fbd527c8aa45771a885a3" :answer/id #uuid "e05f3fbe-0f1d-5a95-af14-b381f3934d30" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-6 \\\\ 2 \\\\ -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-86844/selection/12a82d62fa4913d067a64402d8f5fa2394a51a610db9005abca2d8e64cdf74db" :answer/id #uuid "925dfb05-7f5b-54b3-9be2-c1d7e108f60b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3 \\\\ 2 \\\\ -6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-86844/selection/402897df92001c1b73833a38e80f6ff3f4b8fa3960377b3439dbc15d26fbc072" :answer/id #uuid "d4d34806-bb37-55be-a37a-6cdd3020cacd" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ -3 \\\\ -6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-86844/selection" :answer-field/id #uuid "748ec448-a33b-5f0f-bd63-dadc1df15e17" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-86844/selection/c093dd6b3f7eeaea34b8b04bb4c6e0c974f84027488fbd527c8aa45771a885a3" :answer-field/choices ["q-86844/selection/aa30dc4497c0de5584f0b0073677c0ec241ab570128703ad44be5c4e1fe7af6a" "q-86844/selection/61d8f3b0415f1db1b7d49eeed16209ab9d88a2b949a2a6c9c1b3800c45fb571a" "q-86844/selection/c093dd6b3f7eeaea34b8b04bb4c6e0c974f84027488fbd527c8aa45771a885a3" "q-86844/selection/12a82d62fa4913d067a64402d8f5fa2394a51a610db9005abca2d8e64cdf74db" "q-86844/selection/402897df92001c1b73833a38e80f6ff3f4b8fa3960377b3439dbc15d26fbc072"] :db/ensure [:answer-field/validate]} {:db/id "q-86844" :question/id #uuid "953a99ad-c0c2-51c8-971f-e6b5efdaa5df" :question/math-academy-id "q-86844" :question/problem "Given the vector $x$ and the system of linear equations below, find the projection of $x$ onto the solution space of the system.\n\n$$\nx=[\\begin{aligned}-5 \\\\ 2 \\\\ -5\\end{aligned}],\\,{\\begin{aligned}{x}_{1}-2{x}_{3}=0 \\\\ -2{x}_{1}+4{x}_{3}=0\\end{aligned}\n$$" :question/worked-solution "First, we need to find a basis for the solution space of the system. \n\nConsider the augmented matrix $M$ of the system, which we reduce to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 0 & -2 & 0 \\\\ -2 & 0 & 4 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & -2 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, there is $1$ pivot column (the $1$st one). Thus, ${x}_{2},\\,{x}_{3}$ are free variables. Now, from the first equation, we get ${x}_{1}=2{x}_{3}.$ Therefore, the general solution is\n\n$$\n[\\begin{aligned}2{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]={x}_{2}[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]+{x}_{3}[\\begin{aligned}2 \\\\ 0 \\\\ 1\\end{aligned}],\\,{x}_{2},\\,{x}_{3}\\in R.\n$$\n\nConsequently, $B={[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}2 \\\\ 0 \\\\ 1\\end{aligned}]}$ is the basis of the solution space of the system.\n\nNow, we find the orthogonal projection of $x$ onto the solution space of the system:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x \\\\  & =[\\begin{aligned}0 & 2 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot {([\\begin{aligned}0 & 1 & 0 \\\\ 2 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}0 & 2 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}0 & 1 & 0 \\\\ 2 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}-5 \\\\ 2 \\\\ -5\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 2 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot {[\\begin{aligned}1 & 0 \\\\ 0 & 5\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}2 \\\\ -15\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 2 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot \\frac{1}{5}[\\begin{aligned}5 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ -15\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 2 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}-6 \\\\ 2 \\\\ -3\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-86844/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "26b41192-9680-55c3-930c-52ff235e1800"] :knowledge-point/questions ["q-86844"] :db/ensure [:knowledge-point/validate]} {:db/id "q-139516/selection/040f12217fd4c55006e9b7b0e816d79acde487bdbc4528091f5873c3896d67ae" :answer/id #uuid "a65c1bc8-4b33-5d36-b817-dec9b0038cbe" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{4}{5} \\\\ 2 \\\\ \\frac{3}{5}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-139516/selection/53321fdba5028ab6f6f8cc9219552e05a79d1a80e4ecb46bc6aabf3cf6d86a16" :answer/id #uuid "5711a42c-26f0-5cf9-99c2-ef6d4cbc408e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ 2 \\\\ 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-139516/selection/1ffc1c01fc3856a61430aa5a2cb278e763ea62ff6354a8f35160b303b34c8803" :answer/id #uuid "0bb8e6d1-3bb1-546b-a280-71624a66fe03" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 \\\\ 2 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-139516/selection/31af65010ac0eb2c78ff87a699e2639f0e87b88be488193e4cae3d7c07a40164" :answer/id #uuid "7fc217ea-8eab-587c-838f-e4a35720a795" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 \\\\ 0 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-139516/selection/f98c18a27dcb118caf5a5576c91aab2f7c6ef2dcdc9bdea8485ada011f865eac" :answer/id #uuid "dc0f4689-5991-5477-b887-a0e74a7011e0" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-139516/selection" :answer-field/id #uuid "adf380d1-6281-5390-85d1-4552b27f87e3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-139516/selection/1ffc1c01fc3856a61430aa5a2cb278e763ea62ff6354a8f35160b303b34c8803" :answer-field/choices ["q-139516/selection/040f12217fd4c55006e9b7b0e816d79acde487bdbc4528091f5873c3896d67ae" "q-139516/selection/53321fdba5028ab6f6f8cc9219552e05a79d1a80e4ecb46bc6aabf3cf6d86a16" "q-139516/selection/1ffc1c01fc3856a61430aa5a2cb278e763ea62ff6354a8f35160b303b34c8803" "q-139516/selection/31af65010ac0eb2c78ff87a699e2639f0e87b88be488193e4cae3d7c07a40164" "q-139516/selection/f98c18a27dcb118caf5a5576c91aab2f7c6ef2dcdc9bdea8485ada011f865eac"] :db/ensure [:answer-field/validate]} {:db/id "q-139516" :question/id #uuid "c7d56d31-3a61-59f1-a64c-afde74e4f804" :question/math-academy-id "q-139516" :question/problem "Given the vector $x$ and the system of linear equations below, find the projection of $x$ onto the solution space of the system.\n\n$$\nx=[\\begin{aligned}7 \\\\ 2 \\\\ -1\\end{aligned}],\\,{\\begin{aligned}3{x}_{1}-4{x}_{3}=0 \\\\ 6{x}_{1}-8{x}_{3}=0\\end{aligned}\n$$" :question/worked-solution "First, we need to find a basis for the solution space of the system. \n\nConsider the augmented matrix $M$ of the system, which we reduce to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}3 & 0 & -4 & 0 \\\\ 6 & 0 & -8 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}3 & 0 & -4 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, there is $1$ pivot column (the $1$st one). Thus, ${x}_{2},\\,{x}_{3}$ are free variables. Now, from the first equation, we get $3{x}_{1}=4{x}_{3}.$ Therefore, the general solution is\n\n$$\n[\\begin{aligned}\\frac{4}{3}{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]={x}_{2}[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]+\\frac{{x}_{3}}{3}[\\begin{aligned}4 \\\\ 0 \\\\ 3\\end{aligned}],\\,{x}_{2},\\,{x}_{3}\\in R.\n$$\n\nConsequently, $B={[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}4 \\\\ 0 \\\\ 3\\end{aligned}]}$ is the basis of the solution space of the system.\n\nNow, we find the orthogonal projection of $x$ onto the solution space of the system:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x \\\\  & =[\\begin{aligned}0 & 4 \\\\ 1 & 0 \\\\ 0 & 3\\end{aligned}]\\cdot {([\\begin{aligned}0 & 1 & 0 \\\\ 4 & 0 & 3\\end{aligned}]\\cdot [\\begin{aligned}0 & 4 \\\\ 1 & 0 \\\\ 0 & 3\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}0 & 1 & 0 \\\\ 4 & 0 & 3\\end{aligned}]\\cdot [\\begin{aligned}7 \\\\ 2 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 4 \\\\ 1 & 0 \\\\ 0 & 3\\end{aligned}]\\cdot {[\\begin{aligned}1 & 0 \\\\ 0 & 25\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}2 \\\\ 25\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 4 \\\\ 1 & 0 \\\\ 0 & 3\\end{aligned}]\\cdot \\frac{1}{25}[\\begin{aligned}25 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 25\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 4 \\\\ 1 & 0 \\\\ 0 & 3\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ 2 \\\\ 3\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-139516/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "26b41192-9680-55c3-930c-52ff235e1800"] :knowledge-point/questions ["q-139516"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-5922"] :question/problem "Find the distance between the vector $\\mathbf{x}$ and the subspace spanned by the linearly independent vectors $\\{ \\mathbf{a}_1, \\mathbf{a}_2 \\},$ where\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070757/assets/faad91efe9dd5872c09b3dc05dbdb333a1180880e1f072062c4b1f74e5754e61.png)" :question/worked-solution "The orthogonal projection of $\\mathbf{x}$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n\\textrm{proj}_{S} \\: \\mathbf{x} = A(A^T\\!A)^{-1}\\!A^T\\,\\mathbf{x}.\n$$\n\nIn our case, we have \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070757/assets/60ff5bf60ca0505446961f9bfae83d1ece21d53cd180fdd6a687dba1ca767b68.png)\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}1 & 1 \\\\ 1 & 3 \\\\ 1 & 2 \\\\ 1 & 2\\end{aligned}]\\cdot {([\\begin{aligned}1 & 1 & 1 & 1 \\\\ 1 & 3 & 2 & 2\\end{aligned}]\\,\\cdot \\,[\\begin{aligned}1 & 1 \\\\ 1 & 3 \\\\ 1 & 2 \\\\ 1 & 2\\end{aligned}])}^{-1}\\,\\,\\,\\,\\cdot \\,[\\begin{aligned}1 & 1 & 1 & 1 \\\\ 1 & 3 & 2 & 2\\end{aligned}]\\cdot [\\begin{aligned}-3 \\\\ 5 \\\\ -1 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 \\\\ 1 & 3 \\\\ 1 & 2 \\\\ 1 & 2\\end{aligned}]\\cdot {[\\begin{aligned}4 & 8 \\\\ 8 & 18\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}4 \\\\ 16\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 \\\\ 1 & 3 \\\\ 1 & 2 \\\\ 1 & 2\\end{aligned}]\\cdot \\frac{1}{4}[\\begin{aligned}9 & -4 \\\\ -4 & 2\\end{aligned}]\\cdot [\\begin{aligned}4 \\\\ 16\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 \\\\ 1 & 3 \\\\ 1 & 2 \\\\ 1 & 2\\end{aligned}]\\cdot [\\begin{aligned}-7 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}-3 \\\\ 5 \\\\ 1 \\\\ 1\\end{aligned}]=\\overset{^}{x}\\end{aligned}\n$$\n\nFinally, the distance between $\\mathbf{x}$ and the subspace $S$ is given by\n\n$$\n\\begin{aligned}d(x,\\overset{^}{x}) & =‖x-\\overset{^}{x}‖ \\\\  & =\\sqrt{({x}_{1}-{\\overset{^}{x}}_{1})^{2}+({x}_{2}-{\\overset{^}{x}}_{2})^{2}+({x}_{3}-{\\overset{^}{x}}_{3})^{2}+({x}_{4}-{\\overset{^}{x}}_{4})^{2}} \\\\  & =\\sqrt{(-3-(-3))^{2}+(5-5)^{2}+(-1-1)^{2}+(3-1)^{2}} \\\\  & =\\sqrt{0+0+4+4} \\\\  & =\\sqrt{8} \\\\  & =2\\sqrt{2}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-9906"] :question/problem "Find the acute angle between the vector $\\mathbf{x}$ and the subspace spanned by the linearly independent vectors $\\{ \\mathbf{a}_1,\\mathbf{a}_2\\},$ where\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070757/assets/2c71360d859e203a5e1533b3c9aaa91c11243c1eba0bca05f92a03378850b067.png)" :question/worked-solution "The orthogonal projection of $\\mathbf{x}$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n\\textrm{proj}_{S} \\: \\mathbf{x} = A(A^T\\!A)^{-1}\\!A^T\\,\\mathbf{x}.\n$$\n\nIn our case, we have\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070757/assets/9cdf7153834225217e3cfd680182777f47f2cc0d09185a66742b46fc67ebd7b6.png)\nTherefore, we get the following projection: \n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}3 & 3 \\\\ -3 & -3 \\\\ -3 & 3\\end{aligned}]\\cdot {([\\begin{aligned}3 & -3 & -3 \\\\ 3 & -3 & 3\\end{aligned}]\\cdot [\\begin{aligned}3 & 3 \\\\ -3 & -3 \\\\ -3 & 3\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}3 & -3 & -3 \\\\ 3 & -3 & 3\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 3 \\\\ -3 & -3 \\\\ -3 & 3\\end{aligned}]\\cdot {[\\begin{aligned}27 & 9 \\\\ 9 & 27\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}-3 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 3 \\\\ -3 & -3 \\\\ -3 & 3\\end{aligned}]\\cdot \\frac{1}{72}[\\begin{aligned}3 & -1 \\\\ -1 & 3\\end{aligned}]\\cdot [\\begin{aligned}-3 \\\\ -3\\end{aligned}] \\\\  & =\\frac{1}{12}[\\begin{aligned}3 & 3 \\\\ -3 & -3 \\\\ -3 & 3\\end{aligned}]\\cdot [\\begin{aligned}-1 \\\\ -1\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}-1 \\\\ 1 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nThe acute angle between $\\mathbf{x}$ and $S$ is the acute angle between $\\mathbf{x}$ and $\\textrm{proj}_S \\mathbf{x}.$ Equivalently, it is the acute angle between $\\mathbf{x}$ and any non-zero vector that is parallel to $\\textrm{proj}_S \\mathbf{x}.$ So, to make calculations easier, we can find the angle between the vectors\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070757/assets/4e59afb848b5180340b05874c2dd63d04c22186c0c8e2235535e19551cab983a.png)\n\nComputing the cosine using the dot product, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{0\\cdot (-1)+1\\cdot 1+0\\cdot 0}{\\sqrt{{0}^{2}+{1}^{2}+{0}^{2}}\\sqrt{{(-1)}^{2}+{1}^{2}+{0}^{2}}} \\\\  & =\\frac{1}{\\sqrt{1}\\cdot \\sqrt{2}} \\\\  & =\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta = \\arccos\\left( \\dfrac{\\sqrt{2}}2\\right)= \\dfrac\\pi 4,\n$$\n\nwhich is already an acute angle, as desired." :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5923"] :question/problem "Given the vector $\\mathbf{x}$ and the system of linear equations below, find the projection of $\\mathbf{x}$ onto the solution space of the system.\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070757/assets/043050d4ab229a40aef87d4a404f5af2337a36d1ba54926dcb9a214fdad5e245.png)" :question/worked-solution "First, we need to find a basis for the solution space of the system. \n\nConsider the augmented matrix $M$ of the system, which we reduce to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -2 & 3 & 0 \\\\ 2 & -4 & 6 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 3 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, there is $1$ pivot column (the $1$st one). Thus, $x_2,$ and $x_3$ are free variables. Now, from the first equation, we get $x_1 = 2x_2-3x_3.$ Therefore, the general solution is\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070757/assets/8aac548229fb8312eefaed282dd27daadf560b17009f163d568ca1edda949a69.png)\n\nConsequently, \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070757/assets/b241f88f83f96ef2f393b7450e5933831b300b98522b16b02208298db1b4ea91.png)\nis a basis of the solution space of the system.\n\nNow, we let $A$ be a matrix whose columns equal the elements of $\\mathcal B,$ and we find the orthogonal projection of $\\mathbf{x}$ onto the solution space of the system as follows:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x \\\\  & =[\\begin{aligned}2 & -3 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot {([\\begin{aligned}2 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 & -3 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}2 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}4 \\\\ 2 \\\\ 14\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -3 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot {[\\begin{aligned}5 & -6 \\\\ -6 & 10\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}10 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -3 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot \\frac{1}{14}[\\begin{aligned}10 & 6 \\\\ 6 & 5\\end{aligned}]\\cdot [\\begin{aligned}10 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -3 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}8 \\\\ 5\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 8 \\\\ 5\\end{aligned}]\\end{aligned}\n$$" :db/ensure [:question/validate]}]
