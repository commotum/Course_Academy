}+3{C}_{2} \\\\ {C}_{4}:={C}_{4}+(-4){C}_{2}\\end{aligned} \\\\  & =|\\begin{aligned}-3 & -1 & -7 & 5 \\\\ 0 & 1 & 0 & 0 \\\\ 5 & 2 & 10 & -10 \\\\ -2 & -2 & -4 & 13\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $2$nd row, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}-3 & -1 & -7 & 5 \\\\ 0 & 1 & 0 & 0 \\\\ 5 & 2 & 10 & -10 \\\\ -2 & -2 & -4 & 13\\end{aligned}| \\\\  & =1\\cdot (-1)^{2+2}|\\begin{aligned}-3 & -7 & 5 \\\\ 5 & 10 & -10 \\\\ -2 & -4 & 13\\end{aligned}| \\\\  & =|\\begin{aligned}-3 & -7 & 5 \\\\ 5 & 10 & -10 \\\\ -2 & -4 & 13\\end{aligned}|.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/state.json" "file_sha256" "8b8c1a36b45ee80b8eae27abfb992b604a32b593eb2ab4e0e1b14d19d24dfd8f"} {"question" "q-91218" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/activity-metadata.json" "file_sha256" "9a9c5b9d5c6d4071482066f8a11cb4fd6e5ea09b44a5432efa00d710dabfd4fd"} {"question" "q-91218" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/state.json" "file_sha256" "8b8c1a36b45ee80b8eae27abfb992b604a32b593eb2ab4e0e1b14d19d24dfd8f"} {"question" "q-91218" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "|\\begin{aligned}-1 & -1 & -4 \\\\ 1 & 2 & 4 \\\\ 2 & -2 & 2\\end{aligned}|"] ["math" "|\\begin{aligned}-1 & -4 & 1 \\\\ -2 & -3 & 4 \\\\ 1 & 4 & -2\\end{aligned}|"] ["math" "|\\begin{aligned}-1 & -4 & 1 \\\\ 2 & 4 & -2 \\\\ -2 & 2 & 5\\end{aligned}|"] ["math" "|\\begin{aligned}-3 & -7 & 5 \\\\ 5 & 10 & -1 \\\\ -3 & -2 & 10\\end{aligned}|"] ["math" "|\\begin{aligned}-3 & -7 & 5 \\\\ 5 & 10 & -10 \\\\ -2 & -4 & 13\\end{aligned}|"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/state.json" "file_sha256" "8b8c1a36b45ee80b8eae27abfb992b604a32b593eb2ab4e0e1b14d19d24dfd8f"} {"question" "q-91218" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "|\\begin{aligned}-3 & -7 & 5 \\\\ 5 & 10 & -10 \\\\ -2 & -4 & 13\\end{aligned}|"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/state.json" "file_sha256" "8b8c1a36b45ee80b8eae27abfb992b604a32b593eb2ab4e0e1b14d19d24dfd8f"} {"question" "q-91232" "field" nil "attribute" "question/problem" "value" "Calculate the value of \n$\\,|\\begin{aligned}3 & 1 & 1 & 2 \\\\ 2 & 3 & -3 & -1 \\\\ 1 & 4 & -2 & -3 \\\\ -2 & -1 & 3 & 1\\end{aligned}|.$\n\n*Hint: Use elementary column operations to make the entries to the left of ${a}_{44}$ equal to zero. You should be able to reduce the given $4\\times 4$ determinant to a $3\\times 3$ determinant.*" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/state.json" "file_sha256" "8b8c1a36b45ee80b8eae27abfb992b604a32b593eb2ab4e0e1b14d19d24dfd8f"} {"question" "q-91232" "field" nil "attribute" "question/worked-solution" "value" "Using elementary column operations, let's make entries to the left of ${a}_{44}=1$ equal to zero.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}3 & 1 & 1 & 2 \\\\ 2 & 3 & -3 & -1 \\\\ 1 & 4 & -2 & -3 \\\\ -2 & -1 & 3 & 1\\end{aligned}| &  & \\,\\begin{aligned}{C}_{1}:={C}_{1}+2{C}_{4} \\\\ {C}_{2}:={C}_{2}+{C}_{4} \\\\ {C}_{3}:={C}_{3}+(-3){C}_{4}\\end{aligned} \\\\  & =|\\begin{aligned}7 & 3 & -5 & 2 \\\\ 0 & 2 & 0 & -1 \\\\ -5 & 1 & 7 & -3 \\\\ 0 & 0 & 0 & 1\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $4$th row, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}7 & 3 & -5 & 2 \\\\ 0 & 2 & 0 & -1 \\\\ -5 & 1 & 7 & -3 \\\\ 0 & 0 & 0 & 1\\end{aligned}| \\\\  & =1\\cdot (-1)^{4+4}|\\begin{aligned}7 & 3 & -5 \\\\ 0 & 2 & 0 \\\\ -5 & 1 & 7\\end{aligned}| \\\\  & =|\\begin{aligned}7 & 3 & -5 \\\\ 0 & 2 & 0 \\\\ -5 & 1 & 7\\end{aligned}| \\\\  & =2\\cdot (-1)^{2+2}|\\begin{aligned}7 & -5 \\\\ -5 & 7\\end{aligned}| \\\\  & =2(49-25) \\\\  & =48.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/state.json" "file_sha256" "8b8c1a36b45ee80b8eae27abfb992b604a32b593eb2ab4e0e1b14d19d24dfd8f"} {"question" "q-91232" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/activity-metadata.json" "file_sha256" "9a9c5b9d5c6d4071482066f8a11cb4fd6e5ea09b44a5432efa00d710dabfd4fd"} {"question" "q-91232" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/state.json" "file_sha256" "8b8c1a36b45ee80b8eae27abfb992b604a32b593eb2ab4e0e1b14d19d24dfd8f"} {"question" "q-91232" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-25"] ["math" "-36"] ["math" "24"] ["math" "48"] ["math" "49"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/state.json" "file_sha256" "8b8c1a36b45ee80b8eae27abfb992b604a32b593eb2ab4e0e1b14d19d24dfd8f"} {"question" "q-91232" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "48"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/state.json" "file_sha256" "8b8c1a36b45ee80b8eae27abfb992b604a32b593eb2ab4e0e1b14d19d24dfd8f"} {"question" "q-132163" "field" nil "attribute" "question/problem" "value" "Calculate the value of \n$\\,|\\begin{aligned}3 & 9 & -6 & -3 \\\\ -5 & -6 & 10 & 12 \\\\ 2 & 2 & -1 & -1 \\\\ 4 & 8 & -8 & -2\\end{aligned}|.$\n\n*Hint: Use elementary column operations to make the entries to the right of ${a}_{11}$ equal to zero. You should be able to reduce the given $4\\times 4$ determinant to a $3\\times 3$ determinant.*" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/state.json" "file_sha256" "8b8c1a36b45ee80b8eae27abfb992b604a32b593eb2ab4e0e1b14d19d24dfd8f"} {"question" "q-132163" "field" nil "attribute" "question/worked-solution" "value" "Using elementary column operations, let's make entries to the right of ${a}_{11}=3$ equal to zero.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}3 & 9 & -6 & -3 \\\\ -5 & -6 & 10 & 12 \\\\ 2 & 2 & -1 & -1 \\\\ 4 & 8 & -8 & -2\\end{aligned}| &  & \\,\\begin{aligned}{C}_{2}:={C}_{2}+(-3){C}_{1} \\\\ {C}_{3}:={C}_{3}+2{C}_{1} \\\\ {C}_{4}:={C}_{4}+{C}_{1}\\end{aligned} \\\\  & =|\\begin{aligned}3 & 0 & 0 & 0 \\\\ -5 & 9 & 0 & 7 \\\\ 2 & -4 & 3 & 1 \\\\ 4 & -4 & 0 & 2\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $1$st row, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}3 & 0 & 0 & 0 \\\\ -5 & 9 & 0 & 7 \\\\ 2 & -4 & 3 & 1 \\\\ 4 & -4 & 0 & 2\\end{aligned}| \\\\  & =3\\cdot (-1)^{1+1}|\\begin{aligned}9 & 0 & 7 \\\\ -4 & 3 & 1 \\\\ -4 & 0 & 2\\end{aligned}| \\\\  & =3\\cdot |\\begin{aligned}9 & 0 & 7 \\\\ -4 & 3 & 1 \\\\ -4 & 0 & 2\\end{aligned}| \\\\  & =3\\cdot (3)\\cdot (-1)^{2+2}|\\begin{aligned}9 & 7 \\\\ -4 & 2\\end{aligned}| \\\\  & =9(18+28) \\\\  & =9(46) \\\\  & =414.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/state.json" "file_sha256" "8b8c1a36b45ee80b8eae27abfb992b604a32b593eb2ab4e0e1b14d19d24dfd8f"} {"question" "q-132163" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/activity-metadata.json" "file_sha256" "9a9c5b9d5c6d4071482066f8a11cb4fd6e5ea09b44a5432efa00d710dabfd4fd"} {"question" "q-132163" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/state.json" "file_sha256" "8b8c1a36b45ee80b8eae27abfb992b604a32b593eb2ab4e0e1b14d19d24dfd8f"} {"question" "q-132163" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "298"] ["math" "378"] ["math" "414"] ["math" "462"] ["math" "531"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/state.json" "file_sha256" "8b8c1a36b45ee80b8eae27abfb992b604a32b593eb2ab4e0e1b14d19d24dfd8f"} {"question" "q-132163" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "414"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/state.json" "file_sha256" "8b8c1a36b45ee80b8eae27abfb992b604a32b593eb2ab4e0e1b14d19d24dfd8f"} {"question" "q-91229" "field" nil "attribute" "question/problem" "value" "Calculate the value of \n$\\,|\\begin{aligned}1 & 3 & 1 & -1 \\\\ 1 & 2 & 3 & -2 \\\\ 2 & 4 & 4 & -4 \\\\ -2 & 1 & -2 & -2\\end{aligned}|.$\n\n*Hint: Use elementary column operations to make the entries to the right of ${a}_{21}$ equal to zero. You should be able to reduce the given $4\\times 4$ determinant to a $3\\times 3$ determinant.*" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/state.json" "file_sha256" "8b8c1a36b45ee80b8eae27abfb992b604a32b593eb2ab4e0e1b14d19d24dfd8f"} {"question" "q-91229" "field" nil "attribute" "question/worked-solution" "value" "Using elementary column operations, let's make entries to the right of ${a}_{21}=1$ equal to zero.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}1 & 3 & 1 & -1 \\\\ 1 & 2 & 3 & -2 \\\\ 2 & 4 & 4 & -4 \\\\ -2 & 1 & -2 & -2\\end{aligned}| &  & \\,\\begin{aligned}{C}_{2}:={C}_{2}+(-2){C}_{1} \\\\ {C}_{3}:={C}_{3}+(-3){C}_{1} \\\\ {C}_{4}:={C}_{4}+2{C}_{1}\\end{aligned} \\\\  & =|\\begin{aligned}1 & 1 & -2 & 1 \\\\ 1 & 0 & 0 & 0 \\\\ 2 & 0 & -2 & 0 \\\\ -2 & 5 & 4 & -6\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $2$nd row, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}1 & 1 & -2 & 1 \\\\ 1 & 0 & 0 & 0 \\\\ 2 & 0 & -2 & 0 \\\\ -2 & 5 & 4 & -6\\end{aligned}| \\\\  & =1\\cdot (-1)^{2+1}|\\begin{aligned}1 & -2 & 1 \\\\ 0 & -2 & 0 \\\\ 5 & 4 & -6\\end{aligned}| \\\\  & =-|\\begin{aligned}1 & -2 & 1 \\\\ 0 & -2 & 0 \\\\ 5 & 4 & -6\\end{aligned}| \\\\  & =(-1)\\cdot (-2)\\cdot (-1)^{2+2}|\\begin{aligned}1 & 1 \\\\ 5 & -6\\end{aligned}| \\\\  & =2(-6-5) \\\\  & =-22.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/state.json" "file_sha256" "8b8c1a36b45ee80b8eae27abfb992b604a32b593eb2ab4e0e1b14d19d24dfd8f"} {"question" "q-91229" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/activity-metadata.json" "file_sha256" "9a9c5b9d5c6d4071482066f8a11cb4fd6e5ea09b44a5432efa00d710dabfd4fd"} {"question" "q-91229" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/state.json" "file_sha256" "8b8c1a36b45ee80b8eae27abfb992b604a32b593eb2ab4e0e1b14d19d24dfd8f"} {"question" "q-91229" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-11"] ["math" "-22"] ["math" "11"] ["math" "22"] ["math" "33"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/state.json" "file_sha256" "8b8c1a36b45ee80b8eae27abfb992b604a32b593eb2ab4e0e1b14d19d24dfd8f"} {"question" "q-91229" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-22"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/state.json" "file_sha256" "8b8c1a36b45ee80b8eae27abfb992b604a32b593eb2ab4e0e1b14d19d24dfd8f"} {"question" "q-132144" "field" nil "attribute" "question/problem" "value" "Calculate the value of \n$\\,|\\begin{aligned}1 & -6 & -2 & 4 \\\\ 2 & -3 & 7 & -5 \\\\ -2 & 3 & -1 & 2 \\\\ -2 & 3 & 1 & 7\\end{aligned}|.$\n\n*Hint: Use elementary row operations to make the entries above and below ${a}_{32}$ equal to zero. You should be able to reduce the given $4\\times 4$ determinant to a $3\\times 3$ determinant.*" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/state.json" "file_sha256" "8b8c1a36b45ee80b8eae27abfb992b604a32b593eb2ab4e0e1b14d19d24dfd8f"} {"question" "q-132144" "field" nil "attribute" "question/worked-solution" "value" "Using elementary row operations, let's make entries above and below ${a}_{32}=3$ equal to zero.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}1 & -6 & -2 & 4 \\\\ 2 & -3 & 7 & -5 \\\\ -2 & 3 & -1 & 2 \\\\ -2 & 3 & 1 & 7\\end{aligned}| &  & \\,\\begin{aligned}{R}_{1}:={R}_{1}+2{R}_{3} \\\\ {R}_{2}:={R}_{2}+{R}_{3} \\\\ {R}_{4}:={R}_{4}+(-1){R}_{3}\\end{aligned} \\\\  & =|\\begin{aligned}-3 & 0 & -4 & 8 \\\\ 0 & 0 & 6 & -3 \\\\ -2 & 3 & -1 & 2 \\\\ 0 & 0 & 2 & 5\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $2$nd column, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}-3 & 0 & -4 & 8 \\\\ 0 & 0 & 6 & -3 \\\\ -2 & 3 & -1 & 2 \\\\ 0 & 0 & 2 & 5\\end{aligned}| \\\\  & =3\\cdot (-1)^{3+2}|\\begin{aligned}-3 & -4 & 8 \\\\ 0 & 6 & -3 \\\\ 0 & 2 & 5\\end{aligned}| \\\\  & =-3|\\begin{aligned}-3 & -4 & 8 \\\\ 0 & 6 & -3 \\\\ 0 & 2 & 5\\end{aligned}| \\\\  & =(-3)\\cdot -3\\cdot (-1)^{1+1}|\\begin{aligned}6 & -3 \\\\ 2 & 5\\end{aligned}| \\\\  & =9(30+6) \\\\  & =324.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/state.json" "file_sha256" "8b8c1a36b45ee80b8eae27abfb992b604a32b593eb2ab4e0e1b14d19d24dfd8f"} {"question" "q-132144" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/activity-metadata.json" "file_sha256" "9a9c5b9d5c6d4071482066f8a11cb4fd6e5ea09b44a5432efa00d710dabfd4fd"} {"question" "q-132144" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/state.json" "file_sha256" "8b8c1a36b45ee80b8eae27abfb992b604a32b593eb2ab4e0e1b14d19d24dfd8f"} {"question" "q-132144" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "256"] ["math" "278"] ["math" "312"] ["math" "315"] ["math" "324"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/state.json" "file_sha256" "8b8c1a36b45ee80b8eae27abfb992b604a32b593eb2ab4e0e1b14d19d24dfd8f"} {"question" "q-132144" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "324"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/state.json" "file_sha256" "8b8c1a36b45ee80b8eae27abfb992b604a32b593eb2ab4e0e1b14d19d24dfd8f"} {"question" "q-132142" "field" nil "attribute" "question/problem" "value" "Calculate the value of \n$\\,|\\begin{aligned}-3 & 1 & 4 & 3 \\\\ 2 & -2 & -8 & -1 \\\\ -3 & 3 & 7 & 5 \\\\ -4 & -1 & -4 & -1\\end{aligned}|.$\n\n*Hint: Use elementary row operations to make the entries below ${a}_{12}$ equal to zero. You should be able to reduce the given $4\\times 4$ determinant to a $3\\times 3$ determinant.*" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/state.json" "file_sha256" "8b8c1a36b45ee80b8eae27abfb992b604a32b593eb2ab4e0e1b14d19d24dfd8f"} {"question" "q-132142" "field" nil "attribute" "question/worked-solution" "value" "Using elementary row operations, let's make entries below ${a}_{12}=1$ equal to zero.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}-3 & 1 & 4 & 3 \\\\ 2 & -2 & -8 & -1 \\\\ -3 & 3 & 7 & 5 \\\\ -4 & -1 & -4 & -1\\end{aligned}| &  & \\,\\begin{aligned}{R}_{2}:={R}_{2}+2{R}_{1} \\\\ {R}_{3}:={R}_{3}+(-3){R}_{1} \\\\ {R}_{4}:={R}_{4}+{R}_{1}\\end{aligned} \\\\  & =|\\begin{aligned}-3 & 1 & 4 & 3 \\\\ -4 & 0 & 0 & 5 \\\\ 6 & 0 & -5 & -4 \\\\ -7 & 0 & 0 & 2\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $2$nd column, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}-3 & 1 & 4 & 3 \\\\ -4 & 0 & 0 & 5 \\\\ 6 & 0 & -5 & -4 \\\\ -7 & 0 & 0 & 2\\end{aligned}| \\\\  & =1\\cdot (-1)^{1+2}|\\begin{aligned}-4 & 0 & 5 \\\\ 6 & -5 & -4 \\\\ -7 & 0 & 2\\end{aligned}| \\\\  & =-|\\begin{aligned}-4 & 0 & 5 \\\\ 6 & -5 & -4 \\\\ -7 & 0 & 2\\end{aligned}| \\\\  & =(-1)\\cdot -5\\cdot (-1)^{2+2}|\\begin{aligned}-4 & 5 \\\\ -7 & 2\\end{aligned}| \\\\  & =5(-8+35) \\\\  & =135.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/state.json" "file_sha256" "8b8c1a36b45ee80b8eae27abfb992b604a32b593eb2ab4e0e1b14d19d24dfd8f"} {"question" "q-132142" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/activity-metadata.json" "file_sha256" "9a9c5b9d5c6d4071482066f8a11cb4fd6e5ea09b44a5432efa00d710dabfd4fd"} {"question" "q-132142" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/state.json" "file_sha256" "8b8c1a36b45ee80b8eae27abfb992b604a32b593eb2ab4e0e1b14d19d24dfd8f"} {"question" "q-132142" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "135"] ["math" "160"] ["math" "175"] ["math" "27"] ["math" "35"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/state.json" "file_sha256" "8b8c1a36b45ee80b8eae27abfb992b604a32b593eb2ab4e0e1b14d19d24dfd8f"} {"question" "q-132142" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "135"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/state.json" "file_sha256" "8b8c1a36b45ee80b8eae27abfb992b604a32b593eb2ab4e0e1b14d19d24dfd8f"} {"question" "e-8054" "field" nil "attribute" "question/problem" "value" "$$\n|\\begin{aligned}1 & 2 & 3 & 1 \\\\ 2 & -1 & 5 & -7 \\\\ 4 & -2 & 4 & -5 \\\\ -3 & 3 & -3 & -4\\end{aligned}|\n$$\n\nConsider the above $4\\times 4$ determinant. Find a $3\\times 3$ determinant that has the same value.\n\n*Hint: Use elementary row operations to make the entries below $a_{11}$ equal to zero.*" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/example-8054.json" "file_sha256" "81c4e8e50b0ebce934dceeb456a480bd86b23356076136cdba0071ed288a5d30"} {"question" "e-8054" "field" nil "attribute" "question/worked-solution" "value" "Let's make entries below $a_{11}=1$ equal to zero using elementary row operations.\n\nSince adding a multiple of one row (or column) to another row (or column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}1 & 2 & 3 & 1 \\\\ 2 & -1 & 5 & -7 \\\\ 4 & -2 & 4 & -5 \\\\ -3 & 3 & -3 & -4\\end{aligned}| &  & \\,\\begin{aligned}{R}_{2}:={R}_{2}+(-2){R}_{1} \\\\ {R}_{3}:={R}_{3}+(-4){R}_{1} \\\\ {R}_{4}:={R}_{4}+3{R}_{1}\\end{aligned} \\\\  & =|\\begin{aligned}1 & 2 & 3 & 1 \\\\ 0 & -5 & -1 & -9 \\\\ 0 & -10 & -8 & -9 \\\\ 0 & 9 & 6 & -1\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $1$st column, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}1 & 2 & 3 & 1 \\\\ 0 & -5 & -1 & -9 \\\\ 0 & -10 & -8 & -9 \\\\ 0 & 9 & 6 & -1\\end{aligned}| \\\\  & =1\\cdot (-1)^{1+1}|\\begin{aligned}-5 & -1 & -9 \\\\ -10 & -8 & -9 \\\\ 9 & 6 & -1\\end{aligned}| \\\\  & =|\\begin{aligned}-5 & -1 & -9 \\\\ -10 & -8 & -9 \\\\ 9 & 6 & -1\\end{aligned}|.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/example-8054.json" "file_sha256" "81c4e8e50b0ebce934dceeb456a480bd86b23356076136cdba0071ed288a5d30"} {"question" "e-8060" "field" nil "attribute" "question/problem" "value" "$$\n|\\begin{aligned}2 & 3 & 2 & 2 \\\\ -1 & 2 & 1 & -3 \\\\ 2 & -2 & -2 & 4 \\\\ -4 & -4 & 3 & 2\\end{aligned}|\n$$\n\nConsider the above $4\\times 4$ determinant. Find a $3\\times 3$ determinant that has the same value.\n\n*Hint: Use elementary column operations to make the entries to the left and to the right of $a_{23}$ equal to zero.*" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/example-8060.json" "file_sha256" "dbec2b32beac50d66d66cbd8b7985d8a5d42967fa89d2f7ddf43fa13e5b9d3ee"} {"question" "e-8060" "field" nil "attribute" "question/worked-solution" "value" "Let's make entries to the left and to the right of $a_{23}=1$ equal to zero using elementary column operations.\n\nSince adding a multiple of one row (or column) to another row (or column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}2 & 3 & 2 & 2 \\\\ -1 & 2 & 1 & -3 \\\\ 2 & -2 & -2 & 4 \\\\ -4 & -4 & 3 & 2\\end{aligned}| &  & \\,\\begin{aligned}{C}_{1}:={C}_{1}+{C}_{3} \\\\ {C}_{2}:={C}_{2}+(-2){C}_{3} \\\\ {C}_{4}:={C}_{4}+3{C}_{3}\\end{aligned} \\\\  & =|\\begin{aligned}4 & -1 & 2 & 8 \\\\ 0 & 0 & 1 & 0 \\\\ 0 & 2 & -2 & -2 \\\\ -1 & -10 & 3 & 11\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $2$nd row, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}4 & -1 & 2 & 8 \\\\ 0 & 0 & 1 & 0 \\\\ 0 & 2 & -2 & -2 \\\\ -1 & -10 & 3 & 11\\end{aligned}| \\\\  & =1\\cdot (-1)^{2+3}|\\begin{aligned}4 & -1 & 8 \\\\ 0 & 2 & -2 \\\\ -1 & -10 & 11\\end{aligned}| \\\\  & =-|\\begin{aligned}4 & -1 & 8 \\\\ 0 & 2 & -2 \\\\ -1 & -10 & 11\\end{aligned}|.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/example-8060.json" "file_sha256" "dbec2b32beac50d66d66cbd8b7985d8a5d42967fa89d2f7ddf43fa13e5b9d3ee"} {"question" "e-8005" "field" nil "attribute" "question/problem" "value" "Calculate the value of \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/assets/9cb26049b5e3d06f9ef9e07ce617042166330b1eddb84063d7970799ebf6d8e5.png)\n\n*Hint: Use elementary column operations to make the entries to the right of $a_{31}$ equal to zero. You should be able to reduce the given $4 \\times 4$ determinant to a $3 \\times 3$ determinant.*" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/example-8005.json" "file_sha256" "e51a9c36c5dc00c96088a815fd3899d1146a800bc016be3dc1352ffceb672b17"} {"question" "e-8005" "field" nil "attribute" "question/worked-solution" "value" "Using elementary column operations, let's make entries to the right of $a_{31}=1$ equal to zero.\n\nSince adding a multiple of one row (or column) to another row (or column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}1 & -1 & 3 & 2 \\\\ 2 & -4 & -2 & 6 \\\\ 1 & -2 & -3 & 3 \\\\ -3 & 3 & 4 & 2\\end{aligned}| &  & \\,\\begin{aligned}{C}_{2}:={C}_{2}+2{C}_{1} \\\\ {C}_{3}:={C}_{3}+3{C}_{1} \\\\ {C}_{4}:={C}_{4}+(-3){C}_{1}\\end{aligned} \\\\  & =|\\begin{aligned}1 & 1 & 6 & -1 \\\\ 2 & 0 & 4 & 0 \\\\ 1 & 0 & 0 & 0 \\\\ -3 & -3 & -5 & 11\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $3$rd row, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}1 & 1 & 6 & -1 \\\\ 2 & 0 & 4 & 0 \\\\ 1 & 0 & 0 & 0 \\\\ -3 & -3 & -5 & 11\\end{aligned}| \\\\  & =1\\cdot (-1)^{3+1}|\\begin{aligned}1 & 6 & -1 \\\\ 0 & 4 & 0 \\\\ -3 & -5 & 11\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 6 & -1 \\\\ 0 & 4 & 0 \\\\ -3 & -5 & 11\\end{aligned}| \\\\  & =4\\cdot (-1)^{2+2}|\\begin{aligned}1 & -1 \\\\ -3 & 11\\end{aligned}| \\\\  & =4(11-3) \\\\  & =32.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/example-8005.json" "file_sha256" "e51a9c36c5dc00c96088a815fd3899d1146a800bc016be3dc1352ffceb672b17"} {"question" "q-91166" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-3|\\begin{aligned}-11 & 4 & 10 \\\\ -3 & -2 & -3 \\\\ 3 & 1 & -5\\end{aligned}|"] "category" "reviewed_ma_solution" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/answer-source-reviews.json" "file_sha256" "38d8dd4c963e67331dc04722119b75f0742f79d9ce862a47f8d6cd5e841c3bf7" "reviewer_session" "01a118cc-89a0-7c90-9221-d6599ae13bca" "rationale" "Apply R2:=R2-4R1, R3:=R3+2R1, and R4:=R4+R1. These preserve the determinant and make column 4 equal to [3,0,0,0]. Expansion gives coefficient 3(-1)^(1+4)=-3 and the minor with rows [-11,4,10], [-3,-2,-3], [3,1,-5]. This is exactly original option 4 and the stored answer. This source-backed derived judgment is corroborated by the authentic solution and Correct grade." "bindings" {"problem" "75fe3b2892b8ab69698d16574a78ead1382d8aa686efbd5c4258a8cb24835f7b" "worked_solution" "0014f9e2f0c8a602d1f25da85e7e52333f7ea174b0bf8370f6b13d890b56dab5" "original_field" "b7bd336b32d8f38605a0d18ad52e1f296cab372e793a21a64b2a8721cc97afb6" "reviewed_field" "24120f74fdc0ef8594ae61e1e4aa53d5e474ab911c063e8ead5561dec1a1e496" "raw_widget" "a7a45ce73e12e4b925e73f13dc473a0859ab1f80831fc5312eedac20a850a0c7"} "evidence_files" [{"path" "q-91166-before.png" "sha256" "35a66790987c5255bf81b23f27524bc8e19610791fafd6526210e73b4d3de732"} {"path" "history-q-91166.png" "sha256"