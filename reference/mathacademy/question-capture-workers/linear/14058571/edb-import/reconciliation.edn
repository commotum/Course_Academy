45ee80b8eae27abfb992b604a32b593eb2ab4e0e1b14d19d24dfd8f"} {"question" "q-91169" "field" nil "attribute" "question/worked-solution" "value" "Let's make entries above and below ${a}_{23}=-2$ equal to zero using elementary row operations.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}4 & 2 & 4 & 3 \\\\ 2 & 1 & -2 & 5 \\\\ 3 & 5 & 8 & 6 \\\\ 4 & 3 & 2 & 5\\end{aligned}| &  & \\,\\begin{aligned}{R}_{1}:={R}_{1}+2{R}_{2} \\\\ {R}_{3}:={R}_{3}+4{R}_{2} \\\\ {R}_{4}:={R}_{4}+{R}_{2}\\end{aligned} \\\\  & =|\\begin{aligned}8 & 4 & 0 & 13 \\\\ 2 & 1 & -2 & 5 \\\\ 11 & 9 & 0 & 26 \\\\ 6 & 4 & 0 & 10\\end{aligned}|\\end{aligned}\n$$\n\nExpanding the result along the $3$rd column, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}8 & 4 & 0 & 13 \\\\ 2 & 1 & -2 & 5 \\\\ 11 & 9 & 0 & 26 \\\\ 6 & 4 & 0 & 10\\end{aligned}| \\\\  & =(-2)\\cdot (-1)^{2+3}|\\begin{aligned}8 & 4 & 13 \\\\ 11 & 9 & 26 \\\\ 6 & 4 & 10\\end{aligned}| \\\\  & =2|\\begin{aligned}8 & 4 & 13 \\\\ 11 & 9 & 26 \\\\ 6 & 4 & 10\\end{aligned}|.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/state.json" "file_sha256" "8b8c1a36b45ee80b8eae27abfb992b604a32b593eb2ab4e0e1b14d19d24dfd8f"} {"question" "q-91169" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/activity-metadata.json" "file_sha256" "9a9c5b9d5c6d4071482066f8a11cb4fd6e5ea09b44a5432efa00d710dabfd4fd"} {"question" "q-91169" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/state.json" "file_