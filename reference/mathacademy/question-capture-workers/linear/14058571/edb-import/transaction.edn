 & -2 & 1\\end{aligned}|.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-42902/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6b0edd60-2801-59d3-b9df-18bfbf8763bb"] :knowledge-point/questions ["q-42902"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186120473 :question/answer-fields 17592186119312] {:db/id "q-91166/selection/ma-v1/aff77b10136606220e2a2678ca2fa7356497f6cc7634451685b9809b6a703033/a4b12cc50ff7540f5c60364ccf8e8b8e8652ca26f460ce9e3423850dadb87981" :answer/id #uuid "ba9895e0-af93-5b2e-972f-911321acf81d" :answer/type :answer.type/math :answer/value "-|\\begin{aligned}-2 & -3 & 3 \\\\ -4 & -2 & 12 \\\\ 2 & 3 & -6\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-91166/selection/ma-v1/aff77b10136606220e2a2678ca2fa7356497f6cc7634451685b9809b6a703033/d7fd6d1a94288f3912dcce83e28e2dad8ad79ab33d20918683b8c3f15748036c" :answer/id #uuid "1957f911-7530-53dd-b2fd-eba5c74ce21f" :answer/type :answer.type/math :answer/value "-12|\\begin{aligned}2 & -2 & -3 \\\\ -7 & 2 & 3 \\\\ 1 & 3 & -2\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-91166/selection/ma-v1/aff77b10136606220e2a2678ca2fa7356497f6cc7634451685b9809b6a703033/61d98a987ba981b542e3bb0c5292fdc5e654d58ac1a1839271ff36ffd73b0ae9" :answer/id #uuid "0bf7fb21-4d39-5e94-8aa1-33d2f7bc8fd6" :answer/type :answer.type/math :answer/value "-3|\\begin{aligned}-11 & 4 & 10 \\\\ -3 & -2 & 5 \\\\ 1 & 3 & -3\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-91166/selection/ma-v1/aff77b10136606220e2a2678ca2fa7356497f6cc7634451685b9809b6a703033/6882881b3584ace0dfed236b6dd93eff232d8fdeafd4e19c7e46d1d7e0b7db81" :answer/id #uuid "444d7a36-92b5-5dc7-9598-48e41bc1ac63" :answer/type :answer.type/math :answer/value "-3|\\begin{aligned}2 & -2 & 3 \\\\ -3 & -4 & 12 \\\\ -7 & 2 & -6\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-91166/selection/ma-v1/aff77b10136606220e2a2678ca2fa7356497f6cc7634451685b9809b6a703033