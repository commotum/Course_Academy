70f71a8a9638b" "q-91092/selection/ma-v1/67d9f562809b421cef6d31441de2abb967dff42e6d970c9f5ecc88116c6f53f7/ba0e04f31f5e387c27f07f6d4b9dfe63c522d7b4cb0b4b852c7ec7ce0fc1f81a" "q-91092/selection/ma-v1/67d9f562809b421cef6d31441de2abb967dff42e6d970c9f5ecc88116c6f53f7/7f7fb9eb1423ed31b10c2fef1066f631426213d0d3ee738db9500ddf2df5c776" "q-91092/selection/ma-v1/67d9f562809b421cef6d31441de2abb967dff42e6d970c9f5ecc88116c6f53f7/140f7009a9448e04d03c3e7e2e994901814971115af1136e7cdeae646133a234" "q-91092/selection/ma-v1/67d9f562809b421cef6d31441de2abb967dff42e6d970c9f5ecc88116c6f53f7/614c79a8d7150b47cb26ea42f8bc8242488a02b9d187a94624ffe908b3aceb37"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-91092"] :question/problem "$$\n|\\begin{aligned}1 & -2 & -7 & 10 \\\\ -9 & -1 & -6 & 9 \\\\ -2 & 2 & 2 & -6 \\\\ 2 & 1 & 4 & -7\\end{aligned}|\n$$\n\nConsider the above $4\\times 4$ determinant. Which of the following $3\\times 3$ determinants has the same value?\n\n*Hint: Use elementary column operations to make the entries to the left and to the right of ${a}_{32}$ equal to zero.*" :question/worked-solution "Let's make entries to the left and to the right of ${a}_{32}=2$ equal to zero using elementary column operations.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}1 & -2 & -7 & 10 \\\\ -9 & -1 & -6 & 9 \\\\ -2 & 2 & 2 & -6 \\\\ 2 & 1 & 4 & -7\\end{aligned}| &  & \\,\\begin{aligned}{C}_{1}:={C}_{1}+{C}_{2} \\\\ {C}_{3}:={C}_{3}+(-1){C}_{2} \\\\ {C}_{4}:={C}_{4}+3{C}_{2}\\end{aligned} \\\\  & =|\\begin{aligned}-1 & -2 & -5 & 4 \\\\ -10 & -1 & -5 & 6 \\\\ 0 & 2 & 0 & 0 \\\\ 3 & 1 & 3 & -4\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $3$rd row, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}-1 & -2 & -5 & 4 \\\\ -10 & -1 & -5 & 6 \\\\ 0 & 2 & 0 & 0 \\\\ 3 & 1 & 3 & -4\\end{aligned}| \\\\  & =2\\cdot (-1)^{3+2}|\\begin{aligned}-1 & -5 & 4 \\\\ -10 & -5 & 6 \\\\ 3 & 3 & -4\\end{aligned}| \\\\  & =-2|\\begin{aligned}-1 & -5 & 4 \\\\ -10 & -5 & 6 \\\\ 3 & 3 & -4\\end{aligned}|.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-91092/selection/ma-v1/67d9f562809b421cef6d31441de2abb967dff42e6d970c9f5ecc88116c6f53f7"] :db/ensure [:question/validate]} {:db/id "q-132024/selection/ffd857c5224df241b6239367b0fab201d5123b0cfd71acddd48d40a60b776caa" :answer/id #uuid "7f6ece9a-0497-5a58-9a32-833f91e1801c" :answer/type :answer.type/math :answer/value "-|\\begin{aligned}4 & 2 & -3 \\\\ 6 & -4 & -5 \\\\ 10 & -5 & 1\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-132024/selection/8687f5af36f2fac82172f804ce0a056db756da18704a112c3183e08912373023" :answer/id #uuid "bc58d283-1459-57cd-9ade-e7a6f8b88412" :answer/type :answer.type/math :answer/value "-3|\\begin{aligned}2 & -1 & 6 \\\\ -9 & 0 & -6 \\\\ 11 & -3 & 10\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-132024/selection/b2622c50d288dee6179923b2a02b7f85671c75b7cb3f87431f74720dfbb9ea4f" :answer/id #uuid "0d3f1477-bf8f-5be3-915e-16c350d44ce0" :answer/type :answer.type/math :answer/value "3|\\begin{aligned}2 & 7 & 6 \\\\ -9 & 8 & -2 \\\\ 13 & -5 & -7\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-132024/selection/42be269e851544763ea48efa8f4180f8c02fbb9ed7ffd5c01dc4fa483a99746e" :answer/id #uuid "73a85f4d-6ce1-53bc-9c1a-dd39a8b334c7" :answer/type :answer.type/math :answer/value "-3|\\begin{aligned}4 & -7 & 6 \\\\ -9 & 4 & -6 \\\\ 11 & -5 & 1\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-132024/selection/985915756dbda56b638096ef054496ba297356fca928a11831ce93a9a9b685aa" :answer/id #uuid "59fa360c-9b19-5a09-93d9-e3b424a78a77" :answer/type :answer.type/math :answer/value "-5|\\begin{aligned}4 & -7 & -3 \\\\ -5 & 4 & 9 \\\\ -1 & -2 & 11\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-132024/selection" :answer-field/id #uuid "745488a4-df38-5c6e-b714-a3d07738386e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-132024/selection/42be269e851544763ea48efa8f4180f8c02fbb9ed7ffd5c01dc4fa483a99746e" :answer-field/choices ["q-132024/selection/ffd857c5224df241b6239367b0fab201d5123b0cfd71acddd48d40a60b776caa" "q-132024/selection/8687f5af36f2fac82172f804ce0a056db756da18704a112c3183e08912373023" "q-132024/selection/b2622c50d288dee6179923b2a02b7f85671c75b7cb3f87431f74720dfbb9ea4f" "q-132024/selection/42be269e851544763ea48efa8f4180f8c02fbb9ed7ffd5c01dc4fa483a99746e" "q-132024/selection/985915756dbda56b638096ef054496ba297356fca928a11831ce93a9a9b685aa"] :db/ensure [:answer-field/validate]} {:db/id "q-132024" :question/id #uuid "3a9dab18-4457-5979-bd0f-fac7f073a015" :question/math-academy-id "q-132024" :question/problem "$$\n|\\begin{aligned}-6 & 9 & -3 & 3 \\\\ 2 & -4 & 5 & 1 \\\\ -3 & -5 & -3 & -3 \\\\ 1 & 10 & -4 & 5\\end{aligned}|\n$$\n\nConsider the above $4\\times 4$ determinant. Which of the following $3\\times 3$ determinants has the same value?\n\n*Hint: Use elementary column operations to make the entries to the left of ${a}_{14}$ equal to zero.*" :question/worked-solution "Let's make entries to the left of ${a}_{14}=3$ equal to zero using elementary column operations.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}-6 & 9 & -3 & 3 \\\\ 2 & -4 & 5 & 1 \\\\ -3 & -5 & -3 & -3 \\\\ 1 & 10 & -4 & 5\\end{aligned}| &  & \\,\\begin{aligned}{C}_{1}:={C}_{1}+2{C}_{4} \\\\ {C}_{2}:={C}_{2}+(-3){C}_{4} \\\\ {C}_{3}:={C}_{3}+{C}_{4}\\end{aligned} \\\\  & =|\\begin{aligned}0 & 0 & 0 & 3 \\\\ 4 & -7 & 6 & 1 \\\\ -9 & 4 & -6 & -3 \\\\ 11 & -5 & 1 & 5\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $1$st row, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}0 & 0 & 0 & 3 \\\\ 4 & -7 & 6 & 1 \\\\ -9 & 4 & -6 & -3 \\\\ 11 & -5 & 1 & 5\\end{aligned}| \\\\  & =3\\cdot (-1)^{1+4}|\\begin{aligned}4 & -7 & 6 \\\\ -9 & 4 & -6 \\\\ 11 & -5 & 1\\end{aligned}| \\\\  & =-3|\\begin{aligned}4 & -7 & 6 \\\\ -9 & 4 & -6 \\\\ 11 & -5 & 1\\end{aligned}|.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-132024/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "01ff3b37-83e6-506a-a6e8-07858a2bcb66"] :knowledge-point/questions ["q-132024"] :db/ensure [:knowledge-point/validate]} {:db/id "q-91217/selection/c633ed30442d4990b0368a279760f4b0ae39ec802a903daa2d1be5743648441d" :answer/id #uuid "1330083e-c51b-519b-a26e-7ada59c9301e" :answer/type :answer.type/math :answer/value "|\\begin{aligned}3 & 2 & 1 \\\\ 2 & -1 & 3 \\\\ -1 & 1 & 2\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-91217/selection/3e3e159c3c50228ddcdabe1e85c86e50fc44d5ee0a12c2f053e19dbc42da91e0" :answer/id #uuid "8c805bb3-4946-5767-91eb-69cd2ae6bbac" :answer/type :answer.type/math :answer/value "|\\begin{aligned}2 & 1 & 1 \\\\ 1 & 2 & -1 \\\\ -1 & 3 & -2\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-91217/selection/760ec833732443ca3b6cedf4d8ba36e5519fa828d41f6a49954d3859ec1a94ea" :answer/id #uuid "a17c353f-1c66-5848-8236-dc3f7b03b3b4" :answer/type :answer.type/math :answer/value "|\\begin{aligned}5 & -3 & 7 \\\\ 0 & 0 & 5 \\\\ -5 & 2 & 1\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-91217/selection/7c8f73cdfdbfd0a400466ec93c48fdae14c155e4ab30cd0cd1a67f6e314401a9" :answer/id #uuid "4f1b4389-df88-566b-9cfa-a33e317759b4" :answer/type :answer.type/math :answer/value "|\\begin{aligned}3 & 1 & 1 \\\\ -1 & 2 & -1 \\\\ 2 & 3 & -2\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-91217/selection/fce0bdb44dab109019188cfe72224ab03a46d68d084a7abfececdd440e2284b5" :answer/id #uuid "06d43315-2e07-5ef5-97ff-6537b6cacce6" :answer/type :answer.type/math :answer/value "|\\begin{aligned}5 & -3 & 7 \\\\ 0 & 0 & 2 \\\\ 1 & 5 & -5\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-91217/selection" :answer-field/id #uuid "6d392098-66a4-50be-bcfd-2eef5ca1ef36" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-91217/selection/fce0bdb44dab109019188cfe72224ab03a46d68d084a7abfececdd440e2284b5" :answer-field/choices ["q-91217/selection/c633ed30442d4990b0368a279760f4b0ae39ec802a903daa2d1be5743648441d" "q-91217/selection/3e3e159c3c50228ddcdabe1e85c86e50fc44d5ee0a12c2f053e19dbc42da91e0" "q-91217/selection/760ec833732443ca3b6cedf4d8ba36e5519fa828d41f6a49954d3859ec1a94ea" "q-91217/selection/7c8f73cdfdbfd0a400466ec93c48fdae14c155e4ab30cd0cd1a67f6e314401a9" "q-91217/selection/fce0bdb44dab109019188cfe72224ab03a46d68d084a7abfececdd440e2284b5"] :db/ensure [:answer-field/validate]} {:db/id "q-91217" :question/id #uuid "5ff3ecd8-fc32-55c0-acc0-bdc23d568e06" :question/math-academy-id "q-91217" :question/problem "$$\n|\\begin{aligned}3 & 2 & 1 & 1 \\\\ -1 & 1 & 2 & -1 \\\\ 2 & -1 & 3 & -2 \\\\ -1 & 1 & 2 & -3\\end{aligned}|\n$$\n\nConsider the above $4\\times 4$ determinant. Which of the following $3\\times 3$ determinants has the same value?\n\n*Hint: Use elementary column operations to make the entries to the left and to the right of ${a}_{42}$ equal to zero.*" :question/worked-solution "Let's make entries to the left and to the right of ${a}_{42}=1$ equal to zero using elementary column operations.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}3 & 2 & 1 & 1 \\\\ -1 & 1 & 2 & -1 \\\\ 2 & -1 & 3 & -2 \\\\ -1 & 1 & 2 & -3\\end{aligned}| &  & \\,\\begin{aligned}{C}_{1}:={C}_{1}+{C}_{2} \\\\ {C}_{3}:={C}_{3}+(-2){C}_{2} \\\\ {C}_{4}:={C}_{4}+3{C}_{2}\\end{aligned} \\\\  & =|\\begin{aligned}5 & 2 & -3 & 7 \\\\ 0 & 1 & 0 & 2 \\\\ 1 & -1 & 5 & -5 \\\\ 0 & 1 & 0 & 0\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $4$th row, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}5 & 2 & -3 & 7 \\\\ 0 & 1 & 0 & 2 \\\\ 1 & -1 & 5 & -5 \\\\ 0 & 1 & 0 & 0\\end{aligned}| \\\\  & =1\\cdot (-1)^{4+2}|\\begin{aligned}5 & -3 & 7 \\\\ 0 & 0 & 2 \\\\ 1 & 5 & -5\\end{aligned}| \\\\  & =|\\begin{aligned}5 & -3 & 7 \\\\ 0 & 0 & 2 \\\\ 1 & 5 & -5\\end{aligned}|.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-91217/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "01ff3b37-83e6-506a-a6e8-07858a2bcb66"] :knowledge-point/questions ["q-91217"] :db/ensure [:knowledge-point/validate]} {:db/id "q-91218/selection/c83f96674603c022113eefd0a1af30d7dcf2a6af6147e10e4cf0155a79ba0c7e" :answer/id #uuid "39d189a2-7168-540f-8b00-ea4e38057bcf" :answer/type :answer.type/math :answer/value "|\\begin{aligned}-1 & -4 & 1 \\\\ 2 & 4 & -2 \\\\ -2 & 2 & 5\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-91218/selection/0d6f089b6545942873c8953f3831ff383046f803c920b7d31fd3e3e09ed301ea" :answer/id #uuid "7fddc869-efe8-53ee-9b0d-89ab336e3063" :answer/type :answer.type/math :answer/value "|\\begin{aligned}-3 & -7 & 5 \\\\ 5 & 10 & -1 \\\\ -3 & -2 & 10\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-91218/selection/f6a328054e0c5399ee7d0dbd09efe3ab3abaa34cf660051837b87fe1838e66e4" :answer/id #uuid "a588ee1b-f967-5090-9d9e-0c88d8a2f3b8" :answer/type :answer.type/math :answer/value "|\\begin{aligned}-1 & -4 & 1 \\\\ -2 & -3 & 4 \\\\ 1 & 4 & -2\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-91218/selection/14623b288bfe912917bc640a780991e34952c59f4726aae5d6d867cd456b449d" :answer/id #uuid "1d8fbf63-c761-52fb-8d32-069afb324476" :answer/type :answer.type/math :answer/value "|\\begin{aligned}-3 & -7 & 5 \\\\ 5 & 10 & -10 \\\\ -2 & -4 & 13\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-91218/selection/a4d896933ff66c0d3ef6ccfe09770c665dcff97caa45d6badd441ea66fcb0a28" :answer/id #uuid "d453a4e3-5d1a-562d-82f2-c4286d075639" :answer/type :answer.type/math :answer/value "|\\begin{aligned}-1 & -1 & -4 \\\\ 1 & 2 & 4 \\\\ 2 & -2 & 2\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-91218/selection" :answer-field/id #uuid "3e05ab5d-32c7-5503-bdef-8a5bc423e9bd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-91218/selection/14623b288bfe912917bc640a780991e34952c59f4726aae5d6d867cd456b449d" :answer-field/choices ["q-91218/selection/c83f96674603c022113eefd0a1af30d7dcf2a6af6147e10e4cf0155a79ba0c7e" "q-91218/selection/0d6f089b6545942873c8953f3831ff383046f803c920b7d31fd3e3e09ed301ea" "q-91218/selection/f6a328054e0c5399ee7d0dbd09efe3ab3abaa34cf660051837b87fe1838e66e4" "q-91218/selection/14623b288bfe912917bc640a780991e34952c59f4726aae5d6d867cd456b449d" "q-91218/selection/a4d896933ff66c0d3ef6ccfe09770c665dcff97caa45d6badd441ea66fcb0a28"] :db/ensure [:answer-field/validate]} {:db/id "q-91218" :question/id #uuid "8b6963e3-5249-5961-8869-b1c3b881e091" :question/math-academy-id "q-91218" :question/problem "$$\n|\\begin{aligned}-1 & -1 & -4 & 1 \\\\ -2 & 1 & -3 & 4 \\\\ 1 & 2 & 4 & -2 \\\\ 2 & -2 & 2 & 5\\end{aligned}|\n$$\n\nConsider the above $4\\times 4$ determinant. Which of the following $3\\times 3$ determinants has the same value?\n\n*Hint: Use elementary column operations to make the entries to the left and to the right of ${a}_{22}$ equal to zero.*" :question/worked-solution "Let's make entries to the left and to the right of ${a}_{22}=1$ equal to zero using elementary column operations.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}-1 & -1 & -4 & 1 \\\\ -2 & 1 & -3 & 4 \\\\ 1 & 2 & 4 & -2 \\\\ 2 & -2 & 2 & 5\\end{aligned}| &  & \\,\\begin{aligned}{C}_{1}:={C}_{1}+2{C}_{2} \\\\ {C}_{3}:={C}_{3}+3{C}_{2} \\\\ {C}_{4}:={C}_{4}+(-4){C}_{2}\\end{aligned} \\\\  & =|\\begin{aligned}-3 & -1 & -7 & 5 \\\\ 0 & 1 & 0 & 0 \\\\ 5 & 2 & 10 & -10 \\\\ -2 & -2 & -4 & 13\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $2$nd row, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}-3 & -1 & -7 & 5 \\\\ 0 & 1 & 0 & 0 \\\\ 5 & 2 & 10 & -10 \\\\ -2 & -2 & -4 & 13\\end{aligned}| \\\\  & =1\\cdot (-1)^{2+2}|\\begin{aligned}-3 & -7 & 5 \\\\ 5 & 10 & -10 \\\\ -2 & -4 & 13\\end{aligned}| \\\\  & =|\\begin{aligned}-3 & -7 & 5 \\\\ 5 & 10 & -10 \\\\ -2 & -4 & 13\\end{aligned}|.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-91218/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "01ff3b37-83e6-506a-a6e8-07858a2bcb66"] :knowledge-point/questions ["q-91218"] :db/ensure [:knowledge-point/validate]} {:db/id "q-91232/selection/cee37ae0a2921bd3973a5cb0592c822dbbfafcfefba8d7007910ead797b9112f" :answer/id #uuid "be40011b-55d7-536f-8dea-1d30d74113b8" :answer/type :answer.type/math :answer/value "48" :db/ensure [:answer/validate]} {:db/id "q-91232/selection/5cd5dc93f37c743976373ab57c37b5388ba149bd286c5b2139ed2c89c249424d" :answer/id #uuid "e6789823-26ec-5ebc-a96b-4e310960ff89" :answer/type :answer.type/math :answer/value "-36" :db/ensure [:answer/validate]} {:db/id "q-91232/selection/ed46a7ab66f4e1f0492ab8ee0b3b7d22df7bff44011d5a9f713d6c9393035ddc" :answer/id #uuid "e7d8799b-1d29-5b44-8f0e-5bc7837d2929" :answer/type :answer.type/math :answer/value "49" :db/ensure [:answer/validate]} {:db/id "q-91232/selection/e0e0a3ac4fe95f021c8f8aece7092270d36ad30c356733db1e628dc4f0b1d434" :answer/id #uuid "1df06396-adf4-5c4a-863a-df96cecc57df" :answer/type :answer.type/math :answer/value "-25" :db/ensure [:answer/validate]} {:db/id "q-91232/selection/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd" :answer/id #uuid "9ba858ff-6303-557f-8584-806b0c8092d4" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "q-91232/selection" :answer-field/id #uuid "2eb7b472-7759-529a-ba71-85151572d36f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-91232/selection/cee37ae0a2921bd3973a5cb0592c822dbbfafcfefba8d7007910ead797b9112f" :answer-field/choices ["q-91232/selection/cee37ae0a2921bd3973a5cb0592c822dbbfafcfefba8d7007910ead797b9112f" "q-91232/selection/5cd5dc93f37c743976373ab57c37b5388ba149bd286c5b2139ed2c89c249424d" "q-91232/selection/ed46a7ab66f4e1f0492ab8ee0b3b7d22df7bff44011d5a9f713d6c9393035ddc" "q-91232/selection/e0e0a3ac4fe95f021c8f8aece7092270d36ad30c356733db1e628dc4f0b1d434" "q-91232/selection/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd"] :db/ensure [:answer-field/validate]} {:db/id "q-91232" :question/id #uuid "e1e3c7d7-0f45-570f-9572-185c6fec00c0" :question/math-academy-id "q-91232" :question/problem "Calculate the value of \n$\\,|\\begin{aligned}3 & 1 & 1 & 2 \\\\ 2 & 3 & -3 & -1 \\\\ 1 & 4 & -2 & -3 \\\\ -2 & -1 & 3 & 1\\end{aligned}|.$\n\n*Hint: Use elementary column operations to make the entries to the left of ${a}_{44}$ equal to zero. You should be able to reduce the given $4\\times 4$ determinant to a $3\\times 3$ determinant.*" :question/worked-solution "Using elementary column operations, let's make entries to the left of ${a}_{44}=1$ equal to zero.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}3 & 1 & 1 & 2 \\\\ 2 & 3 & -3 & -1 \\\\ 1 & 4 & -2 & -3 \\\\ -2 & -1 & 3 & 1\\end{aligned}| &  & \\,\\begin{aligned}{C}_{1}:={C}_{1}+2{C}_{4} \\\\ {C}_{2}:={C}_{2}+{C}_{4} \\\\ {C}_{3}:={C}_{3}+(-3){C}_{4}\\end{aligned} \\\\  & =|\\begin{aligned}7 & 3 & -5 & 2 \\\\ 0 & 2 & 0 & -1 \\\\ -5 & 1 & 7 & -3 \\\\ 0 & 0 & 0 & 1\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $4$th row, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}7 & 3 & -5 & 2 \\\\ 0 & 2 & 0 & -1 \\\\ -5 & 1 & 7 & -3 \\\\ 0 & 0 & 0 & 1\\end{aligned}| \\\\  & =1\\cdot (-1)^{4+4}|\\begin{aligned}7 & 3 & -5 \\\\ 0 & 2 & 0 \\\\ -5 & 1 & 7\\end{aligned}| \\\\  & =|\\begin{aligned}7 & 3 & -5 \\\\ 0 & 2 & 0 \\\\ -5 & 1 & 7\\end{aligned}| \\\\  & =2\\cdot (-1)^{2+2}|\\begin{aligned}7 & -5 \\\\ -5 & 7\\end{aligned}| \\\\  & =2(49-25) \\\\  & =48.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-91232/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37209e5f-a6e8-55d5-b76f-19f79db67566"] :knowledge-point/questions ["q-91232"] :db/ensure [:knowledge-point/validate]} {:db/id "q-132163/selection/82438e38f307b1eba0599feaf2c5d6413b7ec0e0c4ee653339da6ce03fea97a9" :answer/id #uuid "9ca79b3e-ccee-5a00-a019-1843e98337b6" :answer/type :answer.type/math :answer/value "531" :db/ensure [:answer/validate]} {:db/id "q-132163/selection/7718725696084b27a8d0f3181d0933443e803a3ced9eaa236c93738ad408c2d3" :answer/id #uuid "3fd493ee-05b8-560a-87f7-dc40dadcfb2f" :answer/type :answer.type/math :answer/value "298" :db/ensure [:answer/validate]} {:db/id "q-132163/selection/f4cd09cf679beb61f08afc67c0906bd8b52507a0f86b92f4abe0bd979bb63f1b" :answer/id #uuid "1ffbe4dc-0f2c-5b32-ad0c-fea3976140a7" :answer/type :answer.type/math :answer/value "462" :db/ensure [:answer/validate]} {:db/id "q-132163/selection/4bc37b66d33b6f69d9e1f310bda9c1887eaf7b1d96a54977fc326afe20dcbff3" :answer/id #uuid "219049fa-15c0-565c-bb51-4ad687cc38f8" :answer/type :answer.type/math :answer/value "414" :db/ensure [:answer/validate]} {:db/id "q-132163/selection/575a65e950f9ca842dae328efe9ed373a9bf95cf2c5ef5637b1a72cc8eebbcdd" :answer/id #uuid "8022e9df-6893-5d2c-a1e7-c005e27a312b" :answer/type :answer.type/math :answer/value "378" :db/ensure [:answer/validate]} {:db/id "q-132163/selection" :answer-field/id #uuid "26ad3bfd-67fa-5606-abe8-49971b346b92" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-132163/selection/4bc37b66d33b6f69d9e1f310bda9c1887eaf7b1d96a54977fc326afe20dcbff3" :answer-field/choices ["q-132163/selection/82438e38f307b1eba0599feaf2c5d6413b7ec0e0c4ee653339da6ce03fea97a9" "q-132163/selection/7718725696084b27a8d0f3181d0933443e803a3ced9eaa236c93738ad408c2d3" "q-132163/selection/f4cd09cf679beb61f08afc67c0906bd8b52507a0f86b92f4abe0bd979bb63f1b" "q-132163/selection/4bc37b66d33b6f69d9e1f310bda9c1887eaf7b1d96a54977fc326afe20dcbff3" "q-132163/selection/575a65e950f9ca842dae328efe9ed373a9bf95cf2c5ef5637b1a72cc8eebbcdd"] :db/ensure [:answer-field/validate]} {:db/id "q-132163" :question/id #uuid "3183b669-59a5-59fd-b05c-573c33b432b8" :question/math-academy-id "q-132163" :question/problem "Calculate the value of \n$\\,|\\begin{aligned}3 & 9 & -6 & -3 \\\\ -5 & -6 & 10 & 12 \\\\ 2 & 2 & -1 & -1 \\\\ 4 & 8 & -8 & -2\\end{aligned}|.$\n\n*Hint: Use elementary column operations to make the entries to the right of ${a}_{11}$ equal to zero. You should be able to reduce the given $4\\times 4$ determinant to a $3\\times 3$ determinant.*" :question/worked-solution "Using elementary column operations, let's make entries to the right of ${a}_{11}=3$ equal to zero.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}3 & 9 & -6 & -3 \\\\ -5 & -6 & 10 & 12 \\\\ 2 & 2 & -1 & -1 \\\\ 4 & 8 & -8 & -2\\end{aligned}| &  & \\,\\begin{aligned}{C}_{2}:={C}_{2}+(-3){C}_{1} \\\\ {C}_{3}:={C}_{3}+2{C}_{1} \\\\ {C}_{4}:={C}_{4}+{C}_{1}\\end{aligned} \\\\  & =|\\begin{aligned}3 & 0 & 0 & 0 \\\\ -5 & 9 & 0 & 7 \\\\ 2 & -4 & 3 & 1 \\\\ 4 & -4 & 0 & 2\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $1$st row, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}3 & 0 & 0 & 0 \\\\ -5 & 9 & 0 & 7 \\\\ 2 & -4 & 3 & 1 \\\\ 4 & -4 & 0 & 2\\end{aligned}| \\\\  & =3\\cdot (-1)^{1+1}|\\begin{aligned}9 & 0 & 7 \\\\ -4 & 3 & 1 \\\\ -4 & 0 & 2\\end{aligned}| \\\\  & =3\\cdot |\\begin{aligned}9 & 0 & 7 \\\\ -4 & 3 & 1 \\\\ -4 & 0 & 2\\end{aligned}| \\\\  & =3\\cdot (3)\\cdot (-1)^{2+2}|\\begin{aligned}9 & 7 \\\\ -4 & 2\\end{aligned}| \\\\  & =9(18+28) \\\\  & =9(46) \\\\  & =414.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-132163/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37209e5f-a6e8-55d5-b76f-19f79db67566"] :knowledge-point/questions ["q-132163"] :db/ensure [:knowledge-point/validate]} {:db/id "q-91229/selection/12b48b00f9c1ff14570ca66bc629787a88856efba1cda24cfb28da58c148801a" :answer/id #uuid "73d90982-0e20-59bc-a30a-726600dce87d" :answer/type :answer.type/math :answer/value "22" :db/ensure [:answer/validate]} {:db/id "q-91229/selection/23c0b4da815e7ba954fedc5e75955047cfe471feec4d2029849a63511c000fa3" :answer/id #uuid "a70f5b14-1e01-5eb1-a8a0-a6789300c0d8" :answer/type :answer.type/math :answer/value "-11" :db/ensure [:answer/validate]} {:db/id "q-91229/selection/b556bb502f914dc4fab0f40312f13f23b29e033ef49212306202180f04718e6f" :answer/id #uuid "1199db10-ded7-55d5-88e7-6df87244d76e" :answer/type :answer.type/math :answer/value "-22" :db/ensure [:answer/validate]} {:db/id "q-91229/selection/84ba06c5ef46c5ec9648beb7e3447fc668d456369383b0c063fb4b9a83b2adb9" :answer/id #uuid "6bdee810-5a81-57a9-b9e0-774a49905a94" :answer/type :answer.type/math :answer/value "33" :db/ensure [:answer/validate]} {:db/id "q-91229/selection/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce" :answer/id #uuid "e1f1eab1-6e0d-59be-b418-06d6b6ae0cf6" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "q-91229/selection" :answer-field/id #uuid "4e17c15e-feff-549b-b204-6d4b34f4110d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-91229/selection/b556bb502f914dc4fab0f40312f13f23b29e033ef49212306202180f04718e6f" :answer-field/choices ["q-91229/selection/12b48b00f9c1ff14570ca66bc629787a88856efba1cda24cfb28da58c148801a" "q-91229/selection/23c0b4da815e7ba954fedc5e75955047cfe471feec4d2029849a63511c000fa3" "q-91229/selection/b556bb502f914dc4fab0f40312f13f23b29e033ef49212306202180f04718e6f" "q-91229/selection/84ba06c5ef46c5ec9648beb7e3447fc668d456369383b0c063fb4b9a83b2adb9" "q-91229/selection/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce"] :db/ensure [:answer-field/validate]} {:db/id "q-91229" :question/id #uuid "3736ca09-423c-5fd6-a72b-820ba0574201" :question/math-academy-id "q-91229" :question/problem "Calculate the value of \n$\\,|\\begin{aligned}1 & 3 & 1 & -1 \\\\ 1 & 2 & 3 & -2 \\\\ 2 & 4 & 4 & -4 \\\\ -2 & 1 & -2 & -2\\end{aligned}|.$\n\n*Hint: Use elementary column operations to make the entries to the right of ${a}_{21}$ equal to zero. You should be able to reduce the given $4\\times 4$ determinant to a $3\\times 3$ determinant.*" :question/worked-solution "Using elementary column operations, let's make entries to the right of ${a}_{21}=1$ equal to zero.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}1 & 3 & 1 & -1 \\\\ 1 & 2 & 3 & -2 \\\\ 2 & 4 & 4 & -4 \\\\ -2 & 1 & -2 & -2\\end{aligned}| &  & \\,\\begin{aligned}{C}_{2}:={C}_{2}+(-2){C}_{1} \\\\ {C}_{3}:={C}_{3}+(-3){C}_{1} \\\\ {C}_{4}:={C}_{4}+2{C}_{1}\\end{aligned} \\\\  & =|\\begin{aligned}1 & 1 & -2 & 1 \\\\ 1 & 0 & 0 & 0 \\\\ 2 & 0 & -2 & 0 \\\\ -2 & 5 & 4 & -6\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $2$nd row, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}1 & 1 & -2 & 1 \\\\ 1 & 0 & 0 & 0 \\\\ 2 & 0 & -2 & 0 \\\\ -2 & 5 & 4 & -6\\end{aligned}| \\\\  & =1\\cdot (-1)^{2+1}|\\begin{aligned}1 & -2 & 1 \\\\ 0 & -2 & 0 \\\\ 5 & 4 & -6\\end{aligned}| \\\\  & =-|\\begin{aligned}1 & -2 & 1 \\\\ 0 & -2 & 0 \\\\ 5 & 4 & -6\\end{aligned}| \\\\  & =(-1)\\cdot (-2)\\cdot (-1)^{2+2}|\\begin{aligned}1 & 1 \\\\ 5 & -6\\end{aligned}| \\\\  & =2(-6-5) \\\\  & =-22.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-91229/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37209e5f-a6e8-55d5-b76f-19f79db67566"] :knowledge-point/questions ["q-91229"] :db/ensure [:knowledge-point/validate]} {:db/id "q-132144/selection/f1c75845439f7547b2a89eaac59f436d7ce65dcfcf9ca28c1b66d939a351c89c" :answer/id #uuid "616b59bf-7c90-52b1-9718-799656892c27" :answer/type :answer.type/math :answer/value "312" :db/ensure [:answer/validate]} {:db/id "q-132144/selection/d144965a68a71154d2438737e51156d9918da199ac2f07b96e885a6c60965580" :answer/id #uuid "c5ea8d63-274b-5730-8d3a-59930b9f567f" :answer/type :answer.type/math :answer/value "256" :db/ensure [:answer/validate]} {:db/id "q-132144/selection/81fc88ee4d570bc36d4360a64e75695682c2b5fd44d69f5b55803bea981ce5d1" :answer/id #uuid "92a34893-3e6e-552c-8bfe-aca7a6282c86" :answer/type :answer.type/math :answer/value "278" :db/ensure [:answer/validate]} {:db/id "q-132144/selection/76da391199c7c0055883be9f3f4e9942c2c66c2d57814df96f93a604bb6b0dd0" :answer/id #uuid "80abfa9b-0bc6-5a72-bffd-f546b318a434" :answer/type :answer.type/math :answer/value "315" :db/ensure [:answer/validate]} {:db/id "q-132144/selection/3e7cbc60aeb406b2a38fdfde54e0578703dcf715eff2e4ddb792368c6d7589f3" :answer/id #uuid "34f62ff9-dca1-5597-a531-6202f13c697b" :answer/type :answer.type/math :answer/value "324" :db/ensure [:answer/validate]} {:db/id "q-132144/selection" :answer-field/id #uuid "39716324-40b5-5742-b56e-7ae616ee4311" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-132144/selection/3e7cbc60aeb406b2a38fdfde54e0578703dcf715eff2e4ddb792368c6d7589f3" :answer-field/choices ["q-132144/selection/f1c75845439f7547b2a89eaac59f436d7ce65dcfcf9ca28c1b66d939a351c89c" "q-132144/selection/d144965a68a71154d2438737e51156d9918da199ac2f07b96e885a6c60965580" "q-132144/selection/81fc88ee4d570bc36d4360a64e75695682c2b5fd44d69f5b55803bea981ce5d1" "q-132144/selection/76da391199c7c0055883be9f3f4e9942c2c66c2d57814df96f93a604bb6b0dd0" "q-132144/selection/3e7cbc60aeb406b2a38fdfde54e0578703dcf715eff2e4ddb792368c6d7589f3"] :db/ensure [:answer-field/validate]} {:db/id "q-132144" :question/id #uuid "f73568a9-ff00-5c95-a522-dda148a52036" :question/math-academy-id "q-132144" :question/problem "Calculate the value of \n$\\,|\\begin{aligned}1 & -6 & -2 & 4 \\\\ 2 & -3 & 7 & -5 \\\\ -2 & 3 & -1 & 2 \\\\ -2 & 3 & 1 & 7\\end{aligned}|.$\n\n*Hint: Use elementary row operations to make the entries above and below ${a}_{32}$ equal to zero. You should be able to reduce the given $4\\times 4$ determinant to a $3\\times 3$ determinant.*" :question/worked-solution "Using elementary row operations, let's make entries above and below ${a}_{32}=3$ equal to zero.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}1 & -6 & -2 & 4 \\\\ 2 & -3 & 7 & -5 \\\\ -2 & 3 & -1 & 2 \\\\ -2 & 3 & 1 & 7\\end{aligned}| &  & \\,\\begin{aligned}{R}_{1}:={R}_{1}+2{R}_{3} \\\\ {R}_{2}:={R}_{2}+{R}_{3} \\\\ {R}_{4}:={R}_{4}+(-1){R}_{3}\\end{aligned} \\\\  & =|\\begin{aligned}-3 & 0 & -4 & 8 \\\\ 0 & 0 & 6 & -3 \\\\ -2 & 3 & -1 & 2 \\\\ 0 & 0 & 2 & 5\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $2$nd column, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}-3 & 0 & -4 & 8 \\\\ 0 & 0 & 6 & -3 \\\\ -2 & 3 & -1 & 2 \\\\ 0 & 0 & 2 & 5\\end{aligned}| \\\\  & =3\\cdot (-1)^{3+2}|\\begin{aligned}-3 & -4 & 8 \\\\ 0 & 6 & -3 \\\\ 0 & 2 & 5\\end{aligned}| \\\\  & =-3|\\begin{aligned}-3 & -4 & 8 \\\\ 0 & 6 & -3 \\\\ 0 & 2 & 5\\end{aligned}| \\\\  & =(-3)\\cdot -3\\cdot (-1)^{1+1}|\\begin{aligned}6 & -3 \\\\ 2 & 5\\end{aligned}| \\\\  & =9(30+6) \\\\  & =324.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-132144/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37209e5f-a6e8-55d5-b76f-19f79db67566"] :knowledge-point/questions ["q-132144"] :db/ensure [:knowledge-point/validate]} {:db/id "q-132142/selection/c59421689e9802bbe55dc885ef3b88a565922fc724e5a7225b403918fe48989b" :answer/id #uuid "54379468-bff4-52ce-9743-8a635670383f" :answer/type :answer.type/math :answer/value "35" :db/ensure [:answer/validate]} {:db/id "q-132142/selection/c89a78e01f135d27857f87b29786d3bde75753fd31e9ec00c0c39b58d64c0b12" :answer/id #uuid "5e575ac8-d52e-547b-a645-b827ad41fab9" :answer/type :answer.type/math :answer/value "135" :db/ensure [:answer/validate]} {:db/id "q-132142/selection/c9ec5d6cdf4e67c7f8bce68475bed400e56bf403f3d09b5928f78b6baa512eab" :answer/id #uuid "b374b0eb-9504-5f09-8296-be9c533d5e11" :answer/type :answer.type/math :answer/value "27" :db/ensure [:answer/validate]} {:db/id "q-132142/selection/ae1ec0bcc83ac82fe7d363f2ad54fe23dc343f2913e126433b39173ac74d85e6" :answer/id #uuid "5495067b-1029-50db-866f-f4605ecdb608" :answer/type :answer.type/math :answer/value "160" :db/ensure [:answer/validate]} {:db/id "q-132142/selection/847483ae4109ff75c27729fee007e8bdf84f2e2e07940230f8901b2f90ae663c" :answer/id #uuid "b8091471-fb90-557b-bb9e-8cdcfdbdaa76" :answer/type :answer.type/math :answer/value "175" :db/ensure [:answer/validate]} {:db/id "q-132142/selection" :answer-field/id #uuid "5eab9cdf-e173-553b-812d-0f9f1a778f55" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-132142/selection/c89a78e01f135d27857f87b29786d3bde75753fd31e9ec00c0c39b58d64c0b12" :answer-field/choices ["q-132142/selection/c59421689e9802bbe55dc885ef3b88a565922fc724e5a7225b403918fe48989b" "q-132142/selection/c89a78e01f135d27857f87b29786d3bde75753fd31e9ec00c0c39b58d64c0b12" "q-132142/selection/c9ec5d6cdf4e67c7f8bce68475bed400e56bf403f3d09b5928f78b6baa512eab" "q-132142/selection/ae1ec0bcc83ac82fe7d363f2ad54fe23dc343f2913e126433b39173ac74d85e6" "q-132142/selection/847483ae4109ff75c27729fee007e8bdf84f2e2e07940230f8901b2f90ae663c"] :db/ensure [:answer-field/validate]} {:db/id "q-132142" :question/id #uuid "d31e66c9-759f-52b2-8d86-9070451608b9" :question/math-academy-id "q-132142" :question/problem "Calculate the value of \n$\\,|\\begin{aligned}-3 & 1 & 4 & 3 \\\\ 2 & -2 & -8 & -1 \\\\ -3 & 3 & 7 & 5 \\\\ -4 & -1 & -4 & -1\\end{aligned}|.$\n\n*Hint: Use elementary row operations to make the entries below ${a}_{12}$ equal to zero. You should be able to reduce the given $4\\times 4$ determinant to a $3\\times 3$ determinant.*" :question/worked-solution "Using elementary row operations, let's make entries below ${a}_{12}=1$ equal to zero.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}-3 & 1 & 4 & 3 \\\\ 2 & -2 & -8 & -1 \\\\ -3 & 3 & 7 & 5 \\\\ -4 & -1 & -4 & -1\\end{aligned}| &  & \\,\\begin{aligned}{R}_{2}:={R}_{2}+2{R}_{1} \\\\ {R}_{3}:={R}_{3}+(-3){R}_{1} \\\\ {R}_{4}:={R}_{4}+{R}_{1}\\end{aligned} \\\\  & =|\\begin{aligned}-3 & 1 & 4 & 3 \\\\ -4 & 0 & 0 & 5 \\\\ 6 & 0 & -5 & -4 \\\\ -7 & 0 & 0 & 2\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $2$nd column, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}-3 & 1 & 4 & 3 \\\\ -4 & 0 & 0 & 5 \\\\ 6 & 0 & -5 & -4 \\\\ -7 & 0 & 0 & 2\\end{aligned}| \\\\  & =1\\cdot (-1)^{1+2}|\\begin{aligned}-4 & 0 & 5 \\\\ 6 & -5 & -4 \\\\ -7 & 0 & 2\\end{aligned}| \\\\  & =-|\\begin{aligned}-4 & 0 & 5 \\\\ 6 & -5 & -4 \\\\ -7 & 0 & 2\\end{aligned}| \\\\  & =(-1)\\cdot -5\\cdot (-1)^{2+2}|\\begin{aligned}-4 & 5 \\\\ -7 & 2\\end{aligned}| \\\\  & =5(-8+35) \\\\  & =135.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-132142/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37209e5f-a6e8-55d5-b76f-19f79db67566"] :knowledge-point/questions ["q-132142"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-8054"] :question/problem "$$\n|\\begin{aligned}1 & 2 & 3 & 1 \\\\ 2 & -1 & 5 & -7 \\\\ 4 & -2 & 4 & -5 \\\\ -3 & 3 & -3 & -4\\end{aligned}|\n$$\n\nConsider the above $4\\times 4$ determinant. Find a $3\\times 3$ determinant that has the same value.\n\n*Hint: Use elementary row operations to make the entries below $a_{11}$ equal to zero.*" :question/worked-solution "Let's make entries below $a_{11}=1$ equal to zero using elementary row operations.\n\nSince adding a multiple of one row (or column) to another row (or column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}1 & 2 & 3 & 1 \\\\ 2 & -1 & 5 & -7 \\\\ 4 & -2 & 4 & -5 \\\\ -3 & 3 & -3 & -4\\end{aligned}| &  & \\,\\begin{aligned}{R}_{2}:={R}_{2}+(-2){R}_{1} \\\\ {R}_{3}:={R}_{3}+(-4){R}_{1} \\\\ {R}_{4}:={R}_{4}+3{R}_{1}\\end{aligned} \\\\  & =|\\begin{aligned}1 & 2 & 3 & 1 \\\\ 0 & -5 & -1 & -9 \\\\ 0 & -10 & -8 & -9 \\\\ 0 & 9 & 6 & -1\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $1$st column, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}1 & 2 & 3 & 1 \\\\ 0 & -5 & -1 & -9 \\\\ 0 & -10 & -8 & -9 \\\\ 0 & 9 & 6 & -1\\end{aligned}| \\\\  & =1\\cdot (-1)^{1+1}|\\begin{aligned}-5 & -1 & -9 \\\\ -10 & -8 & -9 \\\\ 9 & 6 & -1\\end{aligned}| \\\\  & =|\\begin{aligned}-5 & -1 & -9 \\\\ -10 & -8 & -9 \\\\ 9 & 6 & -1\\end{aligned}|.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8060"] :question/problem "$$\n|\\begin{aligned}2 & 3 & 2 & 2 \\\\ -1 & 2 & 1 & -3 \\\\ 2 & -2 & -2 & 4 \\\\ -4 & -4 & 3 & 2\\end{aligned}|\n$$\n\nConsider the above $4\\times 4$ determinant. Find a $3\\times 3$ determinant that has the same value.\n\n*Hint: Use elementary column operations to make the entries to the left and to the right of $a_{23}$ equal to zero.*" :question/worked-solution "Let's make entries to the left and to the right of $a_{23}=1$ equal to zero using elementary column operations.\n\nSince adding a multiple of one row (or column) to another row (or column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}2 & 3 & 2 & 2 \\\\ -1 & 2 & 1 & -3 \\\\ 2 & -2 & -2 & 4 \\\\ -4 & -4 & 3 & 2\\end{aligned}| &  & \\,\\begin{aligned}{C}_{1}:={C}_{1}+{C}_{3} \\\\ {C}_{2}:={C}_{2}+(-2){C}_{3} \\\\ {C}_{4}:={C}_{4}+3{C}_{3}\\end{aligned} \\\\  & =|\\begin{aligned}4 & -1 & 2 & 8 \\\\ 0 & 0 & 1 & 0 \\\\ 0 & 2 & -2 & -2 \\\\ -1 & -10 & 3 & 11\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $2$nd row, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}4 & -1 & 2 & 8 \\\\ 0 & 0 & 1 & 0 \\\\ 0 & 2 & -2 & -2 \\\\ -1 & -10 & 3 & 11\\end{aligned}| \\\\  & =1\\cdot (-1)^{2+3}|\\begin{aligned}4 & -1 & 8 \\\\ 0 & 2 & -2 \\\\ -1 & -10 & 11\\end{aligned}| \\\\  & =-|\\begin{aligned}4 & -1 & 8 \\\\ 0 & 2 & -2 \\\\ -1 & -10 & 11\\end{aligned}|.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8005"] :question/problem "Calculate the value of \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058571/assets/9cb26049b5e3d06f9ef9e07ce617042166330b1eddb84063d7970799ebf6d8e5.png)\n\n*Hint: Use elementary column operations to make the entries to the right of $a_{31}$ equal to zero. You should be able to reduce the given $4 \\times 4$ determinant to a $3 \\times 3$ determinant.*" :question/worked-solution "Using elementary column operations, let's make entries to the right of $a_{31}=1$ equal to zero.\n\nSince adding a multiple of one row (or column) to another row (or column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}1 & -1 & 3 & 2 \\\\ 2 & -4 & -2 & 6 \\\\ 1 & -2 & -3 & 3 \\\\ -3 & 3 & 4 & 2\\end{aligned}| &  & \\,\\begin{aligned}{C}_{2}:={C}_{2}+2{C}_{1} \\\\ {C}_{3}:={C}_{3}+3{C}_{1} \\\\ {C}_{4}:={C}_{4}+(-3){C}_{1}\\end{aligned} \\\\  & =|\\begin{aligned}1 & 1 & 6 & -1 \\\\ 2 & 0 & 4 & 0 \\\\ 1 & 0 & 0 & 0 \\\\ -3 & -3 & -5 & 11\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $3$rd row, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}1 & 1 & 6 & -1 \\\\ 2 & 0 & 4 & 0 \\\\ 1 & 0 & 0 & 0 \\\\ -3 & -3 & -5 & 11\\end{aligned}| \\\\  & =1\\cdot (-1)^{3+1}|\\begin{aligned}1 & 6 & -1 \\\\ 0 & 4 & 0 \\\\ -3 & -5 & 11\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 6 & -1 \\\\ 0 & 4 & 0 \\\\ -3 & -5 & 11\\end{aligned}| \\\\  & =4\\cdot (-1)^{2+2}|\\begin{aligned}1 & -1 \\\\ -3 & 11\\end{aligned}| \\\\  & =4(11-3) \\\\  & =32.\\end{aligned}\n$$" :db/ensure [:question/validate]}]
