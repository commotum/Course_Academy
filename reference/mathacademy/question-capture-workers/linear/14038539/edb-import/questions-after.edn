9 & 0 & 3\\end{aligned}]\\,{R}_{1}:={R}_{1}+(-2)\\cdot {R}_{2} \\\\  & ∼[\\begin{aligned}-8 & -6 & 0 \\\\ 0 & 8 & 3 \\\\ 9 & 0 & 3\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{1}:={R}_{1}+(-2){R}_{2}.\n$$"}] [{:db/id #edb/ref 17592186303801 :knowledge-point/_questions [{:knowledge-point/id #uuid "0464b51e-8568-521e-96a5-a65c04569c2a" :knowledge-point/title "Identifying the Appropriate Row Operation To Transform a Given Entry to a Desired Value"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a50837e7-df0f-54e0-8ed6-5a9e744aea2f" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}↔{R}_{3}" :db/id #edb/ref 17592186303803} {:answer/id #uuid "ae21326b-7ba5-5d77-b882-066abbd80efe" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+\\frac{1}{4}{R}_{1}" :db/id #edb/ref 17592186303804} {:answer/id #uuid "aa8a35dc-2d20-5fb7-a7b6-cde09370b30f" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=\\frac{1}{2}{R}_{2}" :db/id #edb/ref 17592186303805} {:answer/id #uuid "0a6a59a3-d13d-535a-8dc2-99fb6bb4220a" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+\\frac{1}{2}{R}_{3}" :db/id #edb/ref 17592186303806} {:answer/id #uuid "45df6e68-95ff-5317-9e4b-eaa85adfa092" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}↔{R}_{1}" :db/id #edb/ref 17592186303807}] :answer-field/correct {:answer/id #uuid "0a6a59a3-d13d-535a-8dc2-99fb6bb4220a" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+\\frac{1}{2}{R}_{3}" :db/id #edb/ref 17592186303806} :answer-field/id #uuid "27706dba-0275-59c7-94b1-374ad6393762" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186303802}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "2af516b7-e7fe-5e6e-8cca-463d0861c5fc" :question/math-academy-id "q-130301" :question/problem "Given \n$T=[\\begin{aligned}6 & 4 & 8 \\\\ 2 & 1 & 2 \\\\ 2 & -6 & -4\\end{aligned}]$,\n which of the following elementary row operations makes ${a}_{23}=0?$" :question/worked-solution "Of the given options, we consider the row operation \n\n$$\n{R}_{2}:={R}_{2}+\\frac{1}{2}{R}_{3}.\n$$\n\nApplying the above row operation, we obtain the following:\n\n$$\n\\begin{aligned}T & =[\\begin{aligned}6 & 4 & 8 \\\\ 2 & 1 & 2 \\\\ 2 & -6 & -4\\end{aligned}]\\,{R}_{2}:={R}_{2}+\\frac{1}{2}\\cdot {R}_{3} \\\\  & ∼[\\begin{aligned}6 & 4 & 8 \\\\ 3 & -2 & 0 \\\\ 2 & 1 & 2\\end{aligned}]\\end{aligned}\n$$\n\n \n\nTherefore, the required row operation is\n\n$$\n{R}_{2}:={R}_{2}+\\frac{1}{2}{R}_{3}.\n$$"}] [{:db/id #edb/ref 17592186303808 :knowledge-point/_questions [{:knowledge-point/id #uuid "0464b51e-8568-521e-96a5-a65c04569c2a" :knowledge-point/title "Identifying the Appropriate Row Operation To Transform a Given Entry to a Desired Value"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5496d40d-d9e5-533d-b879-144b8b0d5bb3" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}+2{R}_{1}" :db/id #edb/ref 17592186303810} {:answer/id #uuid "d3ad2fc8-6cfe-589c-b242-30807e1f971e" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:=(-3){R}_{3}" :db/id #edb/ref 17592186303811} {:answer/id #uuid "77cc71b8-4f5f-5a70-bbab-cb9252cf341b" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}↔{R}_{2}" :db/id #edb/ref 17592186303812} {:answer/id #uuid "5d1ef382-5b59-58ca-b26d-8913eb0d3998" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}↔{R}_{2}" :db/id #edb/ref 17592186303813} {:answer/id #uuid "3fbb733f-ec6c-5a13-ae21-7ebb71a7830c" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}+(-3){R}_{2}" :db/id #edb/ref 17592186303814}] :answer-field/correct {:answer/id #uuid "3fbb733f-ec6c-5a13-ae21-7ebb71a7830c" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}+(-3){R}_{2}" :db/id #edb/ref 17592186303814} :answer-field/id #uuid "ac615ca1-6855-54c3-88a3-1617254e4b9a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186303809}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "64851f22-f730-58fd-9de0-c0d4ddfd60dd" :question/math-academy-id "q-130304" :question/problem "Given \n$M=[\\begin{aligned}1 & 3 & 0 \\\\ 9 & 2 & 1 \\\\ 7 & 6 & 4\\end{aligned}]$,\nwhich of the following elementary row operations makes ${a}_{32}=0?$" :question/worked-solution "Of the given options, we consider the row operation \n\n$$\n{R}_{3}:={R}_{3}+(-3){R}_{2}.\n$$\n\nApplying the above row operation, we obtain the following:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 3 & 0 \\\\ 9 & 2 & 1 \\\\ 7 & 6 & 4\\end{aligned}]\\,{R}_{3}:={R}_{3}+(-3)\\cdot {R}_{2} \\\\  & ∼[\\begin{aligned}1 & 3 & 0 \\\\ 9 & 2 & 1 \\\\ -20 & 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\n \n\nTherefore, the required row operation is\n\n$$\n{R}_{3}:={R}_{3}+(-3){R}_{2}.\n$$"}] [{:db/id #edb/ref 17592186303815 :knowledge-point/_questions [{:knowledge-point/id #uuid "eb1afe82-86ba-5a15-9037-74717692ecb2" :knowledge-point/title "Applying Row Operations To a Coefficients Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aae4eb4e-0656-5535-84d5-a0daee22233b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & -3 & -1 \\\\ 1 & 2 & 1 \\\\ 3 & -1 & 1\\end{aligned}]" :db/id #edb/ref 17592186303817} {:answer/id #uuid "f0022234-9092-5f54-9357-e7a328887a34" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -1 & 1 \\\\ 3 & -10 & 1 \\\\ 2 & -3 & 2\\end{aligned}]" :db/id #edb/ref 17592186303818} {:answer/id #uuid "cc5365e1-6eab-5f9c-b190-2c0eb7ee6d0d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & -7 & -2 \\\\ 1 & 2 & 1 \\\\ 2 & 3 & 2\\end{aligned}]" :db/id #edb/ref 17592186303819} {:answer/id #uuid "c366ba39-ce8b-52ca-96b8-d08b150db2ee" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 & 1 \\\\ 3 & -1 & 1 \\\\ -1 & -3 & -1\\end{aligned}]" :db/id #edb/ref 17592186303820} {:answer/id #uuid "06672ea5-c6cb-5dd6-a3f7-dfe35de211d5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 & 1 \\\\ 0 & -7 & -2 \\\\ 2 & 3 & 2\\end{aligned}]" :db/id #edb/ref 17592186303821}] :answer-field/correct {:answer/id #uuid "06672ea5-c6cb-5dd6-a3f7-dfe35de211d5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 & 1 \\\\ 0 & -7 & -2 \\\\ 2 & 3 & 2\\end{aligned}]" :db/id #edb/ref 17592186303821} :answer-field/id #uuid "50c827fe-6e27-54d8-a531-b16ec99f5716" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186303816}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "844e847d-b91d-5aef-a876-39b85115a0cd" :question/math-academy-id "q-20239" :question/problem "Consider the matrix $X,$ given by\n\n$$\nX=[\\begin{aligned}1 & 2 & 1 \\\\ 3 & -1 & 1 \\\\ 2 & 3 & 2\\end{aligned}].\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{2}:={R}_{2}-3{R}_{1}$ on $X?$" :question/worked-solution "The operation ${R}_{2}:={R}_{2}-3{R}_{1}$ means that we need to add $-3$ times the first row to the second row. \n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}1 & 2 & 1 \\\\ 3 & -1 & 1 \\\\ 2 & 3 & 2\\end{aligned}]\\,{R}_{2}:={R}_{2}+(-3)\\cdot {R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & 1 \\\\ 3+(-3)(1) & -1+(-3)(2) & 1+(-3)(1) \\\\ 2 & 3 & 2\\end{aligned}] \\\\  & ∼[\\begin{aligned}1 & 2 & 1 \\\\ 0 & -7 & -2 \\\\ 2 & 3 & 2\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186303822 :knowledge-point/_questions [{:knowledge-point/id #uuid "0464b51e-8568-521e-96a5-a65c04569c2a" 