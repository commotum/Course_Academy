 & -2 \\\\ 0 & -1 & -1\\end{aligned}],\\,L=[\\begin{aligned}1 & 3 & 2 \\\\ 0 & 10 & 2 \\\\ 0 & -1 & -1\\end{aligned}]?\n$$" :question/worked-solution "First, notice that the $1$st and the $3$rd rows are the same in both matrices. The only row that has changed is the $2$nd row. \n\nBy considering the given row operations that modify the $2$nd row, we notice that\n\n$$\n\\begin{aligned}K & =[\\begin{aligned}1 & 3 & 2 \\\\ -2 & 4 & -2 \\\\ 0 & -1 & -1\\end{aligned}]\\,{R}_{2}:={R}_{2}+2\\cdot {R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 2 \\\\ 0 & 10 & 2 \\\\ 0 & -1 & -1\\end{aligned}] \\\\  & =L.\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{2}:={R}_{2}+2{R}_{1}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-72856/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "691b9107-a935-5965-b3ac-0f3a193ce9bd"] :knowledge-point/questions ["q-72856"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130095/selection/be71220e2aa1fec8024d32825065c3c63b16e7174958912ecce2b2df820805df" :answer/id #uuid "01062b74-e719-5bd9-89b8-9f8977629eb5" :answer/type :answer.type/math :answer/value "{R}_{1}:={R}_{1}+(-\\frac{4}{7})\\cdot {R}_{2}" :db/ensure [:answer/validate]} {:db/id "q-130095/selection/134d2670a7358d364ebe089b1525b2e089e2baaf11192f2cbb1957e9d8ab28e7" :answer/id #uuid "e6dd7ee0-eff3-5149-9711-e60607c6fbdd" :answer/type :answer.type/math :answer/value "{R}_{1}:=\\frac{1}{3}\\cdot {R}_{1}" :db/ensure [:answer/validate]} {:db/id "q-130095/selection/9807fc86b6184799d0b84ed44cf1c93f667a2da2bd611708238a694493a2b199" :answer/id #uuid "682b8f5e-399b-518b-b219-9deba15df7a5" :answer/type :answer.type/math :answer/value "{R}_{1}:={R}_{1}+{R}_{2}" :db/ensure [:answer/validate]} {:db/id "q-130095/selection/ca3404a9dcb14c92cd24f70f9b0055193ecb7c3210b66a8ced963edbca9af5f4" :answer/id #uuid "01bf9546-f7c6-50b5-a629-2234b7111b44" :answer/type :answer.type/math :answer/value "{R}_{1}↔{R}_{3}" :db/ensure 