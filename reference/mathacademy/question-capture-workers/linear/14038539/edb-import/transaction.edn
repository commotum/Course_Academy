tion.difficulty/easy :question/answer-fields ["q-10244/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "eb1afe82-86ba-5a15-9037-74717692ecb2"] :knowledge-point/questions ["q-10244"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72760/selection/280eedbb14c4d4bca7fcbc9cd36c0fcc6d811b843144dd215f20064bb1bc3953" :answer/id #uuid "b40863de-c6ca-598f-a666-6295cf70cd3e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 & 2 & 1 \\\\ 1 & 5 & -1 & 1 \\\\ 3 & 4 & -2 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72760/selection/058d5cf7118c5977b398ecfb5a73f37acbdc4463b26308ad5474801739acc8ea" :answer/id #uuid "991e3e8a-9fae-5d49-bf20-3e73ad09a651" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 & 2 & 1 \\\\ 0 & 2 & -3 & 2 \\\\ 3 & 4 & -2 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72760/selection/339fb71302356d860b3290c394b5fa914c73f56645c98771692272941807e3e5" :answer/id #uuid "bb783518-5b0a-5f87-89ae-18359ba2a2a2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 & 2 & 1 \\\\ 3 & 4 & -2 & 3 \\\\ 0 & 2 & -3 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72760/selection/95c59fc717bbda252c0947b23d481ab8c791bd12d393713ac2ee2e54f470c9a7" :answer/id #uuid "fcd81525-a1f9-5c2f-bfb7-2a7d18c5ce3f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 & 1 & 2 \\\\ 1 & 5 & 2 & -1 \\\\ 3 & 4 & 3 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72760/selection/13777a54a3be478ef2e4d68bdb3d5d72c1884ff0baef6b2f1b377e7055705dfe" :answer/id #uuid "16f1456c-a49f-5292-bff6-d5d68cc61f17" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 & 2 & 1 \\\\ 0 & 2 & -3 & 1 \\\\ 3 & 4 & -2 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72760/selection" :answer-field/id #uuid "8abf023e-83f5-5c6e-9ccb-926042f5a7d4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72760/selection/13777a54a3be478ef2e4d68bdb3d5d72c1884ff0baef6b2f1b377e7055705dfe" :answer-field/choices ["q-72760/selection/280eedbb14c4d4bca7fcbc9cd36c0fcc6d811b843144dd215f20064bb1bc3953" "q-72760/selection/058d5cf7118c5977b398ecfb5a73f37acbdc4463b26308ad5474801739acc8ea" "q-72760/selection/339fb71302356d860b3290c394b5fa914c73f56645c98771692272941807e3e5" "q-72760/selection/95c59fc717bbda252c0947b23d481ab8c791bd12d393713ac2ee2e54f470c9a7" "q-72760/selection/13777a54a3be478ef2e4d68bdb3d5d72c1884ff0baef6b2f1b377e7055705dfe"] :db/ensure [:answer-field/validate]} {:db/id "q-72760" :question/id #uuid "4f1ba7f0-e4f6-511d-875d-abce33676c37" :question/math-academy-id "q-72760" :question/problem "Consider the augmented matrix $X,$ given by\n\n$$\nX=[\\begin{aligned}1 & 3 & 2 & 1 \\\\ 1 & 5 & -1 & 2 \\\\ 3 & 4 & -2 & 3\\end{aligned}].\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{2}:={R}_{2}+(-1)\\cdot {R}_{1}$ on $X?$" :question/worked-solution "The operation ${R}_{2}:={R}_{2}+(-1)\\cdot {R}_{1}$ means that we need to add $-1$ times the first row to the second row. \n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}1 & 3 & 2 & 1 \\\\ 1 & 5 & -1 & 2 \\\\ 3 & 4 & -2 & 3\\end{aligned}]\\,{R}_{2}:={R}_{2}+(-1)\\cdot {R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 2 & 1 \\\\ 1+(-1)(1) & 5+(-1)(3) & -1+(-1)(2) & 2+(-1)(1) \\\\ 3 & 4 & -2 & 3\\end{aligned}] \\\\  & ∼[\\begin{aligned}1 & 3 & 2 & 1 \\\\ 0 & 2 & -3 & 1 \\\\ 3 & 4 & -2 & 3\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-72760/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c27a3f3c-77c7-55e9-8714-1f24c4a48063"] :knowledge-point/questions ["q-72760"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-10217"] :question/problem "Consider the augmented matrix $M,$ given by\n\n$$\nM=[\\begin{aligned}1 & 3 & 9 & 1 \\\\ 5 & -1 & 2 & 1 \\\\ 5 & 2 & -1 & 1\\end{aligned}].\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{2}:={R}_{2}+(-1)\\cdot {R}_{3}$ on $M?$" :question/worked-solution "The operation ${R}_{2}:={R}_{2}+(-1)\\cdot {R}_{3}$ means that we need to add $-1$ times the third row to the second row.\n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 3 & 9 & 1 \\\\ 5 & -1 & 2 & 1 \\\\ 5 & 2 & -1 & 1\\end{aligned}]\\,{R}_{2}:={R}_{2}+(-1)\\cdot {R}_{3} \\\\  & ∼[\\begin{aligned}1 & 3 & 9 & 1 \\\\ 5+(-1)(5) & -1+(-1)(2) & 2+(-1)(-1) & 1+(-1)(1) \\\\ 5 & 2 & -1 & 1\\end{aligned}] \\\\  & ∼[\\begin{aligned}1 & 3 & 9 & 1 \\\\ 0 & -3 & 3 & 0 \\\\ 5 & 2 & -1 & 1\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-130071/selection/a527db12f7c35780d6b86473a6d0e88d39cb705f88bd7eb5be3d41ca3bcad0f5" :answer/id #uuid "ca3443bf-0685-543c-ba75-ea41d82d0cdf" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & -1 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ -2 & 1 & -3 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130071/selection/6c3f3b65b9cd1e8a59cbea14cc8617f68efa3b77be43a2732665f861e8b8a263" :answer/id #uuid "fe5379c6-ef0c-5d61-b7ef-f3e5f3d16489" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ 6 & -3 & -3 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130071/selection/158277c82e5adc271ec636da9196398b32b962b4281ecb7604522c2a6486056e" :answer/id #uuid "79015750-280a-5d95-bc2d-b110e5e31c23" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 & -\\frac{8}{3} & -1 \\\\ 7 & 1 & 3 & 4 \\\\ 6 & -3 & -3 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130071/selection/a9e82b112bcc84ba0421b9a5193068cfc68d346d7970247a2ddafbfe3b8f4cb0" :answer/id #uuid "1418b72b-2afd-57c6-ad33-07c3a0805b3d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ -2 & -3 & 9 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130071/selection/73e3ddf808be6e18f67766d9c3b641b38c776f6ee75dec15d1de60eadb7a0dc8" :answer/id #uuid "2b2f76b1-8986-5c05-982f-5df431b961a3" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ -2 & 1 & -3 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130071/selection" :answer-field/id #uuid "122ffef5-c2d8-5dfa-8c63-5f500c860742" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-130071/selection/73e3ddf808be6e18f67766d9c3b641b38c776f6ee75dec15d1de60eadb7a0dc8" :answer-field/choices ["q-130071/selection/a527db12f7c35780d6b86473a6d0e88d39cb705f88bd7eb5be3d41ca3bcad0f5" "q-130071/selection/6c3f3b65b9cd1e8a59cbea14cc8617f68efa3b77be43a2732665f861e8b8a263" "q-130071/selection/158277c82e5adc271ec636da9196398b32b962b4281ecb7604522c2a6486056e" "q-130071/selection/a9e82b112bcc84ba0421b9a5193068cfc68d346d7970247a2ddafbfe3b8f4cb0" "q-130071/selection/73e3ddf808be6e18f67766d9c3b641b38c776f6ee75dec15d1de60eadb7a0dc8"] :db/ensure [:answer-field/validate]} {:db/id "q-130071" :question/id #uuid "0f08a2c2-eb16-5d85-a714-beb36e4a0c94" :question/math-academy-id "q-130071" :question/problem "Consider the augmented matrix $A,$ given by\n\n$$\nA=[\\begin{aligned}1 & 3 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ 6 & -3 & 9 & 0\\end{aligned}].\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{3}:=-\\frac{1}{3}{R}_{3}$ on $A?$" :question/worked-solution "The operation ${R}_{3}:=-\\frac{1}{3}{R}_{3}$ means that we need to multiply the third row of the matrix by $-\\frac{1}{3}.$\n\nMultiplying the $3$rd row by $-\\frac{1}{3}$, we obtain the following:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 3 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ 6 & -3 & 9 & 0\\end{aligned}]\\,{R}_{3}:=(-\\frac{1}{3})\\cdot {R}_{3} \\\\  & ∼[\\begin{aligned}1 & 3 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ (-\\frac{1}{3})\\cdot 6 & (-\\frac{1}{3})\\cdot (-3) & (-\\frac{1}{3})\\cdot 9 & (-\\frac{1}{3})\\cdot 0\\end{aligned}] \\\\  & ∼[\\begin{aligned}1 & 3 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ -2 & 1 & -3 & 0\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-130071/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c27a3f3c-77c7-55e9-8714-1f24c4a48063"] :knowledge-point/questions ["q-130071"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72786/selection/2525bd90d69c33092d013145427b148456df1f21693274ad96ce5d2f10bf1ce1" :answer/id #uuid "b03b377e-52c2-5601-836e-0c789017abce" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 2 & -2 \\\\ 0 & 1 & 0 & 6 \\\\ 0 & 0 & -3 & 10\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72786/selection/328ccd4291e0f679d33100366877d103fa384f12d52060de70917608c6a4276c" :answer/id #uuid "67fc3f05-1890-562d-97df-b11ac7651db2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 2 & -2 \\\\ 0 & 2 & 0 & 6 \\\\ 0 & 1 & -3 & 10\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72786/selection/71d2d1a537046540b2820260a0d73fbd4e01e5e0a0fa4fc38ef58e0698381785" :answer/id #uuid "3ab77215-1622-5a98-b3bc-f51de2ab2d52" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 2 & -2 \\\\ 0 & 2 & 0 & 6 \\\\ 0 & 2 & -3 & 10\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72786/selection/2fb08b8e668f53386406cb2a4124ce6f480974503f0cee7c0c76ad20789d7ffa" :answer/id #uuid "c03faa06-1be8-5785-ad4e-1882eb8bd0cf" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 2 & -2 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & -3 & 7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72786/selection/bd8d19b8d0c8c4a419b5961fc2f083825911b2e7787c644d078787c97702ca5f" :answer/id #uuid "1b6fc5fc-3932-5a19-b6f9-ae7bc20821e0" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & -2 & 2 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 1 & 3 & -7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72786/selection" :answer-field/id #uuid "a678e252-cf00-5cad-b213-20ce8b5eb303" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72786/selection/2fb08b8e668f53386406cb2a4124ce6f480974503f0cee7c0c76ad20789d7ffa" :answer-field/choices ["q-72786/selection/2525bd90d69c33092d013145427b148456df1f21693274ad96ce5d2f10bf1ce1" "q-72786/selection/328ccd4291e0f679d33100366877d103fa384f12d52060de70917608c6a4276c" "q-72786/selection/71d2d1a537046540b2820260a0d73fbd4e01e5e0a0fa4fc38ef58e0698381785" "q-72786/selection/2fb08b8e668f53386406cb2a4124ce6f480974503f0cee7c0c76ad20789d7ffa" "q-72786/selection/bd8d19b8d0c8c4a419b5961fc2f083825911b2e7787c644d078787c97702ca5f"] :db/ensure [:answer-field/validate]} {:db/id "q-72786" :question/id #uuid "37f94344-aca2-5d87-b57e-e260d336958f" :question/math-academy-id "q-72786" :question/problem "Consider the augmented matrix $U,$ given by\n\n$$\nU=[\\begin{aligned}1 & 0 & 2 & -2 \\\\ 0 & 2 & 0 & 6 \\\\ 0 & -1 & -3 & 4\\end{aligned}].\n$$\n\nWhat matrix results from carrying out the following row operations on $U?$\n\n$$\n\\begin{aligned}{R}_{2} & :=\\frac{1}{2}{R}_{2} \\\\ {R}_{3} & :={R}_{3}+{R}_{2}\\end{aligned}\n$$" :question/worked-solution "Let's list the required operations:\n\n- The operation ${R}_{2}:=\\frac{1}{2}{R}_{2}$ means that we need to multiply the second row of the matrix by $\\frac{1}{2}.$\n\n- The operation ${R}_{3}:={R}_{3}+{R}_{2}$ means that we need to add $1$ times the second row to the third row.\n\nApplying the operations, we obtain the following:\n\n$$\n\\begin{aligned}U & =[\\begin{aligned}1 & 0 & 2 & -2 \\\\ 0 & 2 & 0 & 6 \\\\ 0 & -1 & -3 & 4\\end{aligned}]\\,{R}_{2}:=\\frac{1}{2}\\cdot {R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 2 & -2 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & -1 & -3 & 4\\end{aligned}]\\,{R}_{3}:={R}_{3}+{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 2 & -2 \\\\ 0 & 1 & 0 & 3 \\\\ 0+0 & -1+1 & -3+0 & 4+3\\end{aligned}] \\\\  & ∼[\\begin{aligned}1 & 0 & 2 & -2 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & -3 & 7\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-72786/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c27a3f3c-77c7-55e9-8714-1f24c4a48063"] :knowledge-point/questions ["q-72786"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130072/selection/d2720c8c92f6fe21d1126f14c76c08db619638dc18e0f663f601284771395870" :answer/id #uuid "497d59d9-ad3d-5e2b-bfe2-a86e8abe6dba" :answer/type :answer.type/math :answer/value "[\\begin{aligned}9 & 0 & 5 & 7 \\\\ 4 & 4 & 6 & 7 \\\\ -1 & 9 & -2 & 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130072/selection/daa37c13d519042e4335a22403684ac5e272eabfffc953395768435ffbc6400f" :answer/id #uuid "bf35f16a-1ebc-5434-a2f0-bf2b3606d964" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 & 4 & 6 & 7 \\\\ -10 & 9 & -7 & -1 \\\\ 9 & 0 & 5 & 7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130072/selection/7bdc274ad2921304b0edd5ddb8a0be9a3fe7cf03569476d6df9c087ac770fe82" :answer/id #uuid "a680c5fd-f83d-5b29-9e4d-996bb9ba9e7f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}9 & 0 & 5 & 7 \\\\ 5 & -5 & 8 & 1 \\\\ -1 & 9 & -2 & 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130072/selection/0b4dd8b038d7228e5a46e1932e6b217cd6fa2d9d609215d06c795b32e06a6abd" :answer/id #uuid "9a66fe5d-99c6-50a1-8dd0-2bfdf26188c3" :answer/type :answer.type/math :answer/value "[\\begin{aligned}9 & 0 & 5 & 7 \\\\ -5 & 4 & 1 & 0 \\\\ -1 & 9 & -2 & 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130072/selection/c8bf15aac7792e03ec7718636ee402eb9d39271ca2829ace7c4294788410bed9" :answer/id #uuid "feb9bda7-c609-5e9e-94c2-c8e6e44d91f6" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 & 9 & -2 & 6 \\\\ -5 & 4 & 1 & 0 \\\\ 9 & 0 & 5 & 7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130072/selection" :answer-field/id #uuid "ae95e35e-7214-5649-b004-be41d40c67a1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-130072/selection/7bdc274ad2921304b0edd5ddb8a0be9a3fe7cf03569476d6df9c087ac770fe82" :answer-field/choices ["q-130072/selection/d2720c8c92f6fe21d1126f14c76c08db619638dc18e0f663f601284771395870" "q-130072/selection/daa37c13d519042e4335a22403684ac5e272eabfffc953395768435ffbc6400f" "q-130072/selection/7bdc274ad2921304b0edd5ddb8a0be9a3fe7cf03569476d6df9c087ac770fe82" "q-130072/selection/0b4dd8b038d7228e5a46e1932e6b217cd6fa2d9d609215d06c795b32e06a6abd" "q-130072/selection/c8bf15aac7792e03ec7718636ee402eb9d39271ca2829ace7c4294788410bed9"] :db/ensure [:answer-field/validate]} {:db/id "q-130072" :question/id #uuid "37f7576f-ad33-50dc-9b99-0070faaebd2c" :question/math-academy-id "q-130072" :question/problem "Consider the augmented matrix $V,$ given by\n\n$$\nV=[\\begin{aligned}-1 & 9 & -2 & 6 \\\\ 4 & 4 & 6 & 7 \\\\ 9 & 0 & 5 & 7\\end{aligned}].\n$$\n\nWhat matrix results from carrying out the following row operations on $V?$\n\n$$\n\\begin{aligned}{R}_{1} & ↔{R}_{3} \\\\ {R}_{2} & :={R}_{2}+(-1)\\cdot {R}_{3}\\end{aligned}\n$$" :question/worked-solution "Let's list the required operations:\n\n- The operation ${R}_{1}↔{R}_{3}$ means that we need to swap the first and third rows.\n\n- The operation ${R}_{2}:={R}_{2}+(-1)\\cdot {R}_{3}$ means that we need to add $-1$ times the third row to the second row.\n\nApplying the operations, we obtain the following:\n\n$$\n\\begin{aligned}V & =[\\begin{aligned}-1 & 9 & -2 & 6 \\\\ 4 & 4 & 6 & 7 \\\\ 9 & 0 & 5 & 7\\end{aligned}]\\,{R}_{1}↔{R}_{3} \\\\  & ∼[\\begin{aligned}9 & 0 & 5 & 7 \\\\ 4 & 4 & 6 & 7 \\\\ -1 & 9 & -2 & 6\\end{aligned}]\\,{R}_{2}:={R}_{2}+(-1)\\cdot {R}_{3} \\\\  & ∼[\\begin{aligned}9 & 0 & 5 & 7 \\\\ 4+(-1)(-1) & 4+(-1)(9) & 6+(-1)(-2) & 7+(-1)(6) \\\\ -1 & 9 & -2 & 6\\end{aligned}] \\\\  & ∼[\\begin{aligned}9 & 0 & 5 & 7 \\\\ 5 & -5 & 8 & 1 \\\\ -1 & 9 & -2 & 6\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-130072/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c27a3f3c-77c7-55e9-8714-1f24c4a48063"] :knowledge-point/questions ["q-130072"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130100/selection/7a5ecf8ce9cb6caf0cc91225e5dfc4bc097b02a2444cb6c00286469a9d30b4b7" :answer/id #uuid "5ce5a669-1c80-5025-accc-912f22a0c58e" :answer/type :answer.type/math :answer/value "{R}_{2}:=(-\\frac{3}{8})\\cdot {R}_{2}" :db/ensure [:answer/validate]} {:db/id "q-130100/selection/f1ab89a91a97d3d45ecebcb7d07692e12e60a7890b32b7a262c9cbd3b146303a" :answer/id #uuid "11acf7bb-dbc8-542e-873a-c88a5f8c6b22" :answer/type :answer.type/math :answer/value "{R}_{2}:={R}_{2}+(-5)\\cdot {R}_{1}" :db/ensure [:answer/validate]} {:db/id "q-130100/selection/e3d146138d1d5075afa678007f637e74b2795048ac6b61fcb8dd668c1758b512" :answer/id #uuid "4fde6ee0-9fc6-5e95-94f0-e68a513f4f9c" :answer/type :answer.type/math :answer/value "{R}_{3}:={R}_{3}-{R}_{1}" :db/ensure [:answer/validate]} {:db/id "q-130100/selection/04429f4ea15eb4af81d44cead2195a435aa8607effac07fc8f0664fde9195a2c" :answer/id #uuid "01a82c6a-e362-5ace-a989-0eeec2bd6f1c" :answer/type :answer.type/math :answer/value "{R}_{2}↔{R}_{3}" :db/ensure [:answer/validate]} {:db/id "q-130100/selection/8a5ff3f868942d6fae69ffdd91736d808df820a09cd5147faed7017f48d84d7d" :answer/id #uuid "59cbfde2-fbc3-5389-8d76-6e5820b8b784" :answer/type :answer.type/math :answer/value "{R}_{3}:=(-\\frac{8}{3})\\cdot {R}_{3}" :db/ensure [:answer/validate]} {:db/id "q-130100/selection" :answer-field/id #uuid "ae4347f5-9c5d-549b-ac48-61bb96bcc333" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-130100/selection/04429f4ea15eb4af81d44cead2195a435aa8607effac07fc8f0664fde9195a2c" :answer-field/choices ["q-130100/selection/7a5ecf8ce9cb6caf0cc91225e5dfc4bc097b02a2444cb6c00286469a9d30b4b7" "q-130100/selection/f1ab89a91a97d3d45ecebcb7d07692e12e60a7890b32b7a262c9cbd3b146303a" "q-130100/selection/e3d146138d1d5075afa678007f637e74b2795048ac6b61fcb8dd668c1758b512" "q-130100/selection/04429f4ea15eb4af81d44cead2195a435aa8607effac07fc8f0664fde9195a2c" "q-130100/selection/8a5ff3f868942d6fae69ffdd91736d808df820a09cd5147faed7017f48d84d7d"] :db/ensure [:answer-field/validate]} {:db/id "q-130100" :question/id #uuid "a29313ba-5280-5024-8d89-692c77d56928" :question/math-academy-id "q-130100" :question/problem "Which of the following elementary row operations transforms the matrix $E$ into the matrix $F$, where\n\n$$\nE=[\\begin{aligned}5 & -2 & 3 \\\\ 8 & -3 & 7 \\\\ -3 & 1 & -3\\end{aligned}],\\,F=[\\begin{aligned}5 & -2 & 3 \\\\ -3 & 1 & -3 \\\\ 8 & -3 & 7\\end{aligned}]?\n$$" :question/worked-solution "First, notice that the $1$st row is the same in both matrices. The only rows that have changed are the $2$nd row and the $3$rd row.   \n\nBy considering the given row operations that change both the $2$nd and the $3$rd row, we notice that \n\n$$\n\\begin{aligned}E & =[\\begin{aligned}5 & -2 & 3 \\\\ 8 & -3 & 7 \\\\ -3 & 1 & -3\\end{aligned}] & {R}_{2}↔{R}_{3} \\\\  & ∼[\\begin{aligned}5 & -2 & 3 \\\\ -3 & 1 & -3 \\\\ 8 & -3 & 7\\end{aligned}] \\\\  & =F.\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{2}↔{R}_{3}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-130100/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "691b9107-a935-5965-b3ac-0f3a193ce9bd"] :knowledge-point/questions ["q-130100"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72856/selection/04429f4ea15eb4af81d44cead2195a435aa8607effac07fc8f0664fde9195a2c" :answer/id #uuid "00473e68-2cb8-5b58-a46e-51b025f68b5b" :answer/type :answer.type/math :answer/value "{R}_{2}↔{R}_{3}" :db/ensure [:answer/validate]} {:db/id "q-72856/selection/994ec7b3c61e2f914a