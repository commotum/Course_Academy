6cbf47bc3f6d07b9a4354459758c55a04b288a87ec475b83025d15af553" "q-20239/selection/f777c3bd32b28bc6bf3c7122a8c2742b367cd63a54dbad5d6fff669345ad368d" "q-20239/selection/2a9ce4a5662da7bdba3819323f95a37ac830d75b3cfabbe6cb4314ef3b707b71"] :db/ensure [:answer-field/validate]} {:db/id "q-20239" :question/id #uuid "844e847d-b91d-5aef-a876-39b85115a0cd" :question/math-academy-id "q-20239" :question/problem "Consider the matrix $X,$ given by\n\n$$\nX=[\\begin{aligned}1 & 2 & 1 \\\\ 3 & -1 & 1 \\\\ 2 & 3 & 2\\end{aligned}].\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{2}:={R}_{2}-3{R}_{1}$ on $X?$" :question/worked-solution "The operation ${R}_{2}:={R}_{2}-3{R}_{1}$ means that we need to add $-3$ times the first row to the second row. \n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}1 & 2 & 1 \\\\ 3 & -1 & 1 \\\\ 2 & 3 & 2\\end{aligned}]\\,{R}_{2}:={R}_{2}+(-3)\\cdot {R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & 1 \\\\ 3+(-3)(1) & -1+(-3)(2) & 1+(-3)(1) \\\\ 2 & 3 & 2\\end{aligned}] \\\\  & ∼[\\begin{aligned}1 & 2 & 1 \\\\ 0 & -7 & -2 \\\\ 2 & 3 & 2\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-20239/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "eb1afe82-86ba-5a15-9037-74717692ecb2"] :knowledge-point/questions ["q-20239"] :db/ensure [:knowledge-point/validate]} {:db/id "q-10245/selection/d959691844c30c077b5240823cfa12ac4f72360d6a2395664a07188c7fd5772b" :answer/id #uuid "1a04f7f7-d117-59b2-939f-e5fcf2277ceb" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 & 6 \\\\ 0 & 24 & 27 \\\\ 0 & -5 & 10\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-10245/selection/0abeabe931c6942ee26e4dda96241b3d221f84f9bbcddddcda91359ce1e54ced" :answer/id #uuid "c446ec29-13e0-55fa-9e32-45e5ff1a7468" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 & 6 \\\\ 0 & 24 & 27 \\\\ 1 & 5 & 10\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-10245/selection/fcee21fc23828eaa297de4865e89421f61995ea310f093f00cb5b9ffc0673bb8" :answer/id #uuid "88653b97-b9f1-548a-b8ee-69abdb4b501c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 & 6 \\\\ 0 & 24 & 25 \\\\ 0 & 5 & 10\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-10245/selection/8440eed4283e3577a8dae11ffd35a76b848d92beee31a5ec79d9ab0abfb4b663" :answer/id #uuid "4a599b53-f226-5344-87c7-cb51bcf132d3" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 & 6 \\\\ 0 & 24 & 27 \\\\ 0 & 5 & 10\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-10245/selection/214d9c556af7a7127d6e4e0e5f5136453fa383b1d9d6b5f19bdd7fea4058bc59" :answer/id #uuid "2be7c1ed-aac3-5540-9b6f-3186ecef5984" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 & 6 \\\\ 0 & 21 & 27 \\\\ 0 & 5 & 10\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-10245/selection" :answer-field/id #uuid "0472c2c6-804e-561e-b6f7-9db0c550e50f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-10245/selection/8440eed4283e3577a8dae11ffd35a76b848d92beee31a5ec79d9ab0abfb4b663" :answer-field/choices ["q-10245/selection/d959691844c30c077b5240823cfa12ac4f72360d6a2395664a07188c7fd5772b" "q-10245/selection/0abeabe931c6942ee26e4dda96241b3d221f84f9bbcddddcda91359ce1e54ced" "q-10245/selection/fcee21fc23828eaa297de4865e89421f61995ea310f093f00cb5b9ffc0673bb8" "q-10245/selection/8440eed4283e3577a8dae11ffd35a76b848d92beee31a5ec79d9ab0abfb4b663" "q-10245/selection/214d9c556af7a7127d6e4e0e5f5136453fa383b1d9d6b5f19bdd7fea4058bc59"] :db/ensure [:answer-field/validate]} {:db/id "q-10245" :question/id #uuid "d89fad28-1b46-55f3-b90e-6ed4c3f194da" :question/math-academy-id "q-10245" :question/problem "Consider the matrix $B,$ given by\n\n$$\nB=[\\begin{aligned}1 & 3 & 6 \\\\ -4 & 12 & 3 \\\\ -1 & 2 & 4\\end{aligned}].\n$$\n\nWhat matrix results from carrying out the following row operations on $B?$\n\n$$\n\\begin{aligned}{R}_{2} & :={R}_{2}+4{R}_{1} \\\\ {R}_{3} & :={R}_{3}+{R}_{1}\\end{aligned}\n$$" :question/worked-solution "Let's list the required operations:\n\n- The operation ${R}_{2}:={R}_{2}+4{R}_{1}$ means that we need to add $4$ times the first row to the second row.\n\n- The operation ${R}_{3}:={R}_{3}+{R}_{1}$ means that we need to add $1$ times the first row to the third row.\n\nApplying the operations, we obtain the following:\n\n$$\n\\begin{aligned}B & =[\\begin{aligned}1 & 3 & 6 \\\\ -4 & 12 & 3 \\\\ -1 & 2 & 4\\end{aligned}]\\,{R}_{2}:={R}_{2}+4\\cdot {R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 6 \\\\ -4+(4)(1) & 12+(4)(3) & 3+(4)(6) \\\\ -1 & 2 & 4\\end{aligned}] \\\\  & ∼[\\begin{aligned}1 & 3 & 6 \\\\ 0 & 24 & 27 \\\\ -1 & 2 & 4\\end{aligned}]\\,{R}_{3}:={R}_{3}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 6 \\\\ 0 & 24 & 27 \\\\ -1+1 & 2+3 & 4+6\\end{aligned}] \\\\  & ∼[\\begin{aligned}1 & 3 & 6 \\\\ 0 & 24 & 27 \\\\ 0 & 5 & 10\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-10245/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "eb1afe82-86ba-5a15-9037-74717692ecb2"] :knowledge-point/questions ["q-10245"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-10250"] :question/problem "Consider the matrix $A,$ given by\n\n$$\nA=[\\begin{aligned}0 & 8 & 1 \\\\ 3 & 3 & 6 \\\\ 4 & -1 & 3\\end{aligned}].\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{1}↔{R}_{2}$ on $A?$" :question/worked-solution "The operation ${R}_{1}↔{R}_{2}$ means that we need to swap the first and second rows.\n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}0 & 8 & 1 \\\\ 3 & 3 & 6 \\\\ 4 & -1 & 3\\end{aligned}] & {R}_{1}↔{R}_{2} \\\\  & ∼[\\begin{aligned}3 & 3 & 6 \\\\ 0 & 8 & 1 \\\\ 4 & -1 & 3\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-10248"] :question/problem "Consider the matrix $M,$ given by\n\n$$\nM=[\\begin{aligned}-1 & 2 & 4 \\\\ 8 & 3 & 1 \\\\ 3 & -1 & 9\\end{aligned}].\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{3}:={R}_{3}+3{R}_{1}$ on $M?$" :question/worked-solution "The operation ${R}_{3}:={R}_{3}+3{R}_{1}$ means that we need to add $3$ times the first row to the third row.\n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-1 & 2 & 4 \\\\ 8 & 3 & 1 \\\\ 3 & -1 & 9\\end{aligned}]\\,{R}_{3}:={R}_{3}+3\\cdot {R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & -4 \\\\ 8 & 3 & 1 \\\\ 3+(3)(-1) & -1+(3)(2) & 9+(3)(4)\\end{aligned}] \\\\  & ∼[\\begin{aligned}-1 & 2 & 4 \\\\ 8 & 3 & 1 \\\\ 0 & 5 & 21\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-10244/selection/be2f9c0f1b3198ae2f6a408d8e55b7aee9beaed2600279e8c8755983fcd1e89a" :answer/id #uuid "d99ac1ea-75ae-554c-9428-8713d7e4a534" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 5 & -3 \\\\ 7 & 4 & -1 \\\\ 0 & 5 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-10244/selection/19690816b24d04c8c01160fea8c1edf5e99af014fdc5dcbd2fcf0956c32317f5" :answer/id #uuid "86844dec-65ec-5d2f-8476-0a0966f37846" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 5 & -2 \\\\ 7 & 4 & -1 \\\\ 1 & 5 & -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-10244/selection/98c5fa31ef32dc6ff3ceccbb699ce47fdc707da27c7ce4f5a8f6f81937d8a009" :answer/id #uuid "879fd200-a145-5245-bc88-78b31af276a3" :answer/type :answer.type/math :answer/value "[\\begin{aligned}7 & 4 & -1 \\\\ 7 & 4 & -1 \\\\ 0 & 5 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-10244/selection/0cae667f1fba513c6232b13929e107345e7a540f3b6894772ef0183061f244b1" :answer/id #uuid "8e94d933-1292