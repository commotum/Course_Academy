69eb3f141026ad1aef5cfd27a7c0ca679e1a"} {"question" "q-130103" "field" nil "attribute" "question/worked-solution" "value" "First, notice that the $2$nd and the $3$rd rows are the same in both matrices. The only row that has changed is the $1$st row. \n\nBy considering the given row operations that modify the $1$st row, we notice that\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}0 & 0 & 5 \\\\ 5 & 6 & 10 \\\\ 1 & -1 & -3\\end{aligned}]\\,{R}_{1}:={R}_{1}+5\\cdot {R}_{3} \\\\  & ∼[\\begin{aligned}5 & -5 & -10 \\\\ 5 & 6 & 10 \\\\ 1 & -1 & -3\\end{aligned}] \\\\  & =W.\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{1}:={R}_{1}+5{R}_{3}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038539/state.json" "file_sha256" "4c0d6d44e1075987ba2cc1c738cd69eb3f141026ad1aef5cfd27a7c0ca679e1a"} {"question" "q-130103" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038539/activity-metadata.json" "file_sha256" "1d3886a32f041ff3d54ead8d7bedf6ee51066c77018660135ca1dc42931a9d61"} {"question" "q-130103" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038539/state.json" "file_sha256" "4c0d6d44e1075987ba2cc1c738cd69eb3f141026ad1aef5cfd27a7c0ca679e1a"} {"question" "q-130103" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{R}_{1}:={R}_{1}+5{R}_{3}"] ["math" "{R}_{1}:={R}_{1}+\\frac{1}{5}{R}_{3}"] ["math" "{R}_{1}:={R}_{1}+{R}_{2}"] ["math" "{R}_{1}↔{R}_{2}"] ["math" "{R}_{3}:={R}_{3}+5{R}_{1}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038539/state.json" "