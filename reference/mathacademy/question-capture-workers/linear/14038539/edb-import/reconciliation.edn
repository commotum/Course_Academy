 6 & 4 \\\\ 2 & 3 & 1\\end{aligned}]\\,{R}_{2}:={R}_{2}+(-2)\\cdot {R}_{3} \\\\  & ∼[\\begin{aligned}4 & 6 & 2 \\\\ -1 & 0 & 2 \\\\ 2 & 3 & 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{2}:={R}_{2}+(-2){R}_{3}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038539/state.json" "file_sha256" "4c0d6d44e1075987ba2cc1c738cd69eb3f141026ad1aef5cfd27a7c0ca679e1a"} {"question" "q-20388" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038539/activity-metadata.json" "file_sha256" "1d3886a32f041ff3d54ead8d7bedf6ee51066c77018660135ca1dc42931a9d61"} {"question" "q-20388" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038539/state.json" "file_sha256" "4c0d6d44e1075987ba2cc1c738cd69eb3f141026ad1aef5cfd27a7c0ca679e1a"} {"question" "q-20388" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{R}_{1}↔{R}_{3}"] ["math" "{R}_{2}:=(-2){R}_{2}"] ["math" "{R}_{2}:={R}_{2}+(-2){R}_{3}"] ["math" "{R}_{2}:={R}_{2}+(-3){R}_{1}"] ["math" "{R}_{2}↔{R}_{3}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038539/state.json" "file_sha256" "4c0d6d44e1075987ba2cc1c738cd69eb3f141026ad1aef5cfd27a7c0ca679e1a"} {"question" "q-20388" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{R}_{2}:={R}_{2}+(-2){R}_{3}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038539/state.json" "file_sha256" "4c0d6d44e1075987ba2cc1c738cd69eb3f141026ad1aef5cfd27a7c0ca679e1a"} {"question" "q-130304" "field" nil "attribute" "question/problem" "value" "Given \n$M=[\\begin{aligned}1 & 3 & 0 \\\\ 9 & 2 & 1 \\\\ 7 & 6 & 4\\end{aligned}]$,\nwhich of the following elementary row operations makes ${a}_{32}=0?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038539/state.json" "file_sha256" "4c0d6d44e1075987ba2cc1c738cd69eb3f141026ad1aef5cfd27a7c0ca679e1a"} {"question" "q-130304" "field" nil "attribute" "question/worked-solution" "value" "Of the given options, we consider the row operation \n\n$$\n{R}_{3}:={R}_{3}+(-3){R}_{2}.\n$$\n\nApplying the above row operation, we obtain the following:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 3 & 0 \\\\ 9 & 2 & 1 \\\\ 7 & 6 & 4\\end{aligned}]\\,{R}_{3}:={R}_{3}+(-3)\\cdot {R}_{2} \\\\  & ∼[\\begin{aligned}1 & 3 & 0 \\\\ 9 & 2 & 1 \\\\ -20 & 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\n \n\nTherefore, the required row operation is\n\n$$\n{R}_{3}:={R}_{3}+(-3){R}_{2}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038539/state.json" "file_sha256" "4c0d6d44e1075987ba2cc1c738cd69eb3f141026ad1aef5cfd27a7c0ca679e1a"} {"question" "q-130304" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038539/activity-metadata.json" "file_sha256" "1d3886a32f041ff3d54ead8d7bedf6ee51066c77018660135ca1dc42931a9d61"} {"question" "q-130304" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038539/state.json" "file_sha256" "4c0d6d44e1075987ba2cc1c738cd69eb3f141026ad1aef5cfd27a7c0ca679e1a"} {"question" "q-130304" "field" "selection" "attribute" "answer-fi