#{[{:db/id #edb/ref 17592186277082 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ba5decc-4f40-528a-a242-a3d3e92808a2" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186277084} {:answer/id #uuid "80a494ed-44d2-5724-9640-8d14f9568a20" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186277085} {:answer/id #uuid "10f774ec-34c7-5491-b105-7e351e4551a5" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186277086} {:answer/id #uuid "0ab1e606-956f-5e6a-9469-fed13fe02408" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186277087} {:answer/id #uuid "318c1cb7-b02b-5fd4-86c9-3bba63f9bdc6" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186277088}] :answer-field/correct {:answer/id #uuid "4ba5decc-4f40-528a-a242-a3d3e92808a2" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186277084} :answer-field/id #uuid "2776ffed-7e53-5e1b-9126-769874216821" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277083}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "cb5cfafe-438d-561a-bfca-e1cc33842ff2" :question/math-academy-id "q-127755" :question/problem "Which of the matrices below does **not** have an inverse?\n\n$$\nA=[\\begin{aligned}1 & 0\\end{aligned}],\\,B=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}],\\,C=[\\begin{aligned}1 & 1 \\\\ 2 & 2\\end{aligned}].\n$$" :question/worked-solution "- The matrix $A$ is a $1\\times 2$ matrix. So, it is not invertible.\n\n- For the matrix $B$, we have\n\n$$\ndet(B)=0\\cdot 0-(-1)\\cdot 1=1.\n$$\n\nBecause $det(B)\\ne 0,$ we conclude that $B$ is invertible.\n\n- For the matrix $C$, we have\n\n$$\ndet(C)=1\\cdot 2-2\\cdot 1=0.\n$$\n\nBecause $det(C)=0,$ we conclude that $C$ is not invertible.\n\nTherefore, only $A$ and $C$ do not have an inverse."}] [{:db/id #edb/ref 17592186277127 :knowledge-point/_questions [{:knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01" :knowledge-point/title "Solving for a Variable in a Singular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a2432f1-06ef-596e-a4ad-a7b950fab294" :answer/type {:db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186277129} {:answer/id #uuid "d2c77e6d-18f5-5b5d-8323-5394b92b24e6" :answer/type {:db/ident :answer.type/math} :answer/value "t=5" :db/id #edb/ref 17592186277130} {:answer/id #uuid "f965bb0f-74c0-548e-b2a8-2b56e74fca3d" :answer/type {:db/ident :answer.type/math} :answer/value "t=-5" :db/id #edb/ref 17592186277131} {:answer/id #uuid "019324c7-81c8-5b53-bf56-b700abdaa7c0" :answer/type {:db/ident :answer.type/math} :answer/value "t=\\frac{3}{4}" :db/id #edb/ref 17592186277132} {:answer/id #uuid "105cab17-a1b0-5700-a8de-e49a40cb8f6c" :answer/type {:db/ident :answer.type/math} :answer/value "t=-\\frac{3}{4}" :db/id #edb/ref 17592186277133}] :answer-field/correct {:answer/id #uuid "7a2432f1-06ef-596e-a4ad-a7b950fab294" :answer/type {:db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186277129} :answer-field/id #uuid "d6d60900-5445-5716-b671-a3f6295914cc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277128}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "02eff272-95c3-5a34-a191-db8af4578dbd" :question/math-academy-id "q-71969" :question/problem "If $M=[\\begin{aligned}t & 4 \\\\ t & 10\\end{aligned}]$ is a singular matrix, calculate the value of $t.$" :question/worked-solution "The matrix $M$ is singular if and only if $det(M)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(M) & =t\\cdot 10-t\\cdot 4 \\\\  & =10t-4t \\\\  & =6t\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $t:$\n\n$$\n\\begin{aligned}6t & =0 \\\\ t & =0\\end{aligned}\n$$\n\nTherefore, the value of $t$ is $t=0.$"}]}
