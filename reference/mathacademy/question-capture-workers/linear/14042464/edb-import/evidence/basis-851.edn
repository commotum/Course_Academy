#{[{:db/id #edb/ref 17592186279751 :knowledge-point/_questions [{:knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01" :knowledge-point/title "Solving for a Variable in a Singular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73b09fe9-123a-5bd9-9a49-9c4bf0d7981e" :answer/type {:db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186279753} {:answer/id #uuid "65e2035c-7c48-5f63-ab3d-9359709749a0" :answer/type {:db/ident :answer.type/math} :answer/value "t=9" :db/id #edb/ref 17592186279754} {:answer/id #uuid "71b0eb63-47df-5ab2-95ff-bd6dc1b84ae1" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\pm 7" :db/id #edb/ref 17592186279755} {:answer/id #uuid "7f736c4c-0089-59de-a3dc-c6938c5587b7" :answer/type {:db/ident :answer.type/math} :answer/value "t=4" :db/id #edb/ref 17592186279756} {:answer/id #uuid "04ee3fe8-3f9f-52df-8f7b-4eb7f210589f" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\pm 10" :db/id #edb/ref 17592186279757}] :answer-field/correct {:answer/id #uuid "73b09fe9-123a-5bd9-9a49-9c4bf0d7981e" :answer/type {:db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186279753} :answer-field/id #uuid "9f9c18ff-ecd5-5bbc-b0ea-962b9111ae44" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186279752}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "acbeeb79-18dc-516f-93ba-82ddf3fe8247" :question/math-academy-id "q-127903" :question/problem "If $M=[\\begin{aligned}t & 5 \\\\ t & 9\\end{aligned}]$ is a singular matrix, calculate the value(s) of $t.$" :question/worked-solution "The matrix $M$ is singular if and only if $det(M)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(M) & =t\\cdot 9-t\\cdot 5 \\\\  & =9t-5t \\\\  & =4t\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $t:$\n\n$$\n\\begin{aligned}4t & =0 \\\\ t & =0\\end{aligned}\n$$\n\nTherefore, the value of $t$ is $t=0.$"}] [{:db/id #edb/ref 17592186279761 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e828c40-5af3-5275-a151-b4a86d05ae24" :answer/type {:db/ident :answer.type/text} :answer/value "$T$ only" :db/id #edb/ref 17592186279763} {:answer/id #uuid "26d9357a-fee8-58d9-81a4-e28e74153883" :answer/type {:db/ident :answer.type/text} :answer/value "$R$ and $T$ only" :db/id #edb/ref 17592186279764} {:answer/id #uuid "0282c561-94e2-5116-ad0e-1161283efe30" :answer/type {:db/ident :answer.type/text} :answer/value "$S$ only" :db/id #edb/ref 17592186279765} {:answer/id #uuid "b4e6ea5c-6625-58f7-bd40-7417279456c2" :answer/type {:db/ident :answer.type/text} :answer/value "$R$ and $S$ only" :db/id #edb/ref 17592186279766} {:answer/id #uuid "13f86d40-79de-5f73-af23-79138bb48962" :answer/type {:db/ident :answer.type/text} :answer/value "$R$ only" :db/id #edb/ref 17592186279767}] :answer-field/correct {:answer/id #uuid "b4e6ea5c-6625-58f7-bd40-7417279456c2" :answer/type {:db/ident :answer.type/text} :answer/value "$R$ and $S$ only" :db/id #edb/ref 17592186279766} :answer-field/id #uuid "4147700b-537e-5ff3-ae62-abe8362e4d45" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186279762}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7d719636-2650-52a5-a453-2a2dc5859fac" :question/math-academy-id "q-71934" :question/problem "Which of the matrices below does **not** have an inverse?\n\n$$\nR=[\\begin{aligned}5 & 2 \\\\ 10 & 4\\end{aligned}],\\,S=[\\begin{aligned}15 & 0 \\\\ 1 & -1 \\\\ 10 & 0\\end{aligned}],\\,T=[\\begin{aligned}2 & 2 \\\\ -2 & 2\\end{aligned}].\n$$" :question/worked-solution "- For the matrix $R$, we have\n\n$$\ndet(R)=5\\cdot 4-10\\cdot 2=0.\n$$\n\nBecause $det(R)=0,$ we conclude that $R$ is not invertible.\n\n- The matrix $S$ is a $3\\times 2$ matrix. So, it is not invertible.\n\n- For the matrix $T$, we have\n\n$$\ndet(T)=2\\cdot 2-(-2)\\cdot 2=8.\n$$\n\nBecause $det(T)\\ne 0,$ we conclude that $T$ is invertible.\n\nTherefore, only $R$ and $S$ do not have an inverse."}]}
