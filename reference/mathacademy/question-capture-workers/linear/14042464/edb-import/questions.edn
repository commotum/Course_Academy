#{[{:db/id #edb/ref 17592186277082 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ba5decc-4f40-528a-a242-a3d3e92808a2" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186277084} {:answer/id #uuid "80a494ed-44d2-5724-9640-8d14f9568a20" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186277085} {:answer/id #uuid "10f774ec-34c7-5491-b105-7e351e4551a5" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186277086} {:answer/id #uuid "0ab1e606-956f-5e6a-9469-fed13fe02408" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186277087} {:answer/id #uuid "318c1cb7-b02b-5fd4-86c9-3bba63f9bdc6" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186277088}] :answer-field/correct {:answer/id #uuid "4ba5decc-4f40-528a-a242-a3d3e92808a2" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186277084} :answer-field/id #uuid "2776ffed-7e53-5e1b-9126-769874216821" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277083}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "cb5cfafe-438d-561a-bfca-e1cc33842ff2" :question/math-academy-id "q-127755" :question/problem "Which of the matrices below does **not** have an inverse?\n\n$$\nA=[\\begin{aligned}1 & 0\\end{aligned}],\\,B=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}],\\,C=[\\begin{aligned}1 & 1 \\\\ 2 & 2\\end{aligned}].\n$$" :question/worked-solution "- The matrix $A$ is a $1\\times 2$ matrix. So, it is not invertible.\n\n- For the matrix $B$, we have\n\n$$\ndet(B)=0\\cdot 0-(-1)\\cdot 1=1.\n$$\n\nBecause $det(B)\\ne 0,$ we conclude that $B$ is invertible.\n\n- For the matrix $C$, we have\n\n$$\ndet(C)=1\\cdot 2-2\\cdot 1=0.\n$$\n\nBecause $det(C)=0,$ we conclude that $C$ is not invertible.\n\nTherefore, only $A$ and $C$ do not have an inverse."}] [{:db/id #edb/ref 17592186283810 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22f462bf-af92-5f66-b161-1437e27ac16d" :answer/type {:db/ident :answer.type/text} :answer/value "$B$  and $C$ only" :db/id #edb/ref 17592186283812} {:answer/id #uuid "6f1e8475-4581-5d54-82c8-30a79f5b84c3" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186283813} {:answer/id #uuid "bfd23f33-7e15-58a1-8b3c-cfba4dd114bd" :answer/type {:db/ident :answer.type/text} :answer/value "$A$  and $C$ only" :db/id #edb/ref 17592186283814} {:answer/id #uuid "2fa270f1-39b7-5559-91a0-c3ac999965f0" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186283815} {:answer/id #uuid "dfd5b2c0-51ad-5626-9b43-54b1a0d7fccf" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186283816}] :answer-field/correct {:answer/id #uuid "6f1e8475-4581-5d54-82c8-30a79f5b84c3" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186283813} :answer-field/id #uuid "cca04b2b-a4de-5524-b216-2806fb864de7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283811}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "41a5decc-6a63-5e15-9219-32df767b7987" :question/math-academy-id "q-127821" :question/problem "Which of the matrices below are singular?\n\n$$\nA=[\\begin{aligned}-2 & 6 \\\\ 1 & -3\\end{aligned}],\\,B=[\\begin{aligned}-3 & 1\\end{aligned}],\\,C=[\\begin{aligned}1 & 0 \\\\ 7 & 5\\end{aligned}].\n$$" :question/worked-solution "- For the matrix $A$, we have\n\n$$\ndet(A)=-2\\cdot (-3)-1\\cdot 6=0.\n$$\n\nBecause $det(A)=0,$ we conclude that $A$ is not invertible. Since $A$ is a square matrix that is not invertible, we also say that $A$ is singular.\n\n- The matrix $B$ is a $1\\times 2$ matrix. So, it is not invertible. Since the matrix is not square, we can't say that it's singular.\n\n- For the matrix $C$, we have\n\n$$\ndet(C)=1\\cdot 5-7\\cdot 0=5.\n$$\n\nBecause $det(C)\\ne 0,$ we conclude that $C$ is invertible.\n\nTherefore, only $A$ is singular."}] [{:db/id #edb/ref 17592186279751 :knowledge-point/_questions [{:knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01" :knowledge-point/title "Solving for a Variable in a Singular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73b09fe9-123a-5bd9-9a49-9c4bf0d7981e" :answer/type {:db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186279753} {:answer/id #uuid "65e2035c-7c48-5f63-ab3d-9359709749a0" :answer/type {:db/ident :answer.type/math} :answer/value "t=9" :db/id #edb/ref 17592186279754} {:answer/id #uuid "71b0eb63-47df-5ab2-95ff-bd6dc1b84ae1" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\pm 7" :db/id #edb/ref 17592186279755} {:answer/id #uuid "7f736c4c-0089-59de-a3dc-c6938c5587b7" :answer/type {:db/ident :answer.type/math} :answer/value "t=4" :db/id #edb/ref 17592186279756} {:answer/id #uuid "04ee3fe8-3f9f-52df-8f7b-4eb7f210589f" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\pm 10" :db/id #edb/ref 17592186279757}] :answer-field/correct {:answer/id #uuid "73b09fe9-123a-5bd9-9a49-9c4bf0d7981e" :answer/type {:db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186279753} :answer-field/id #uuid "9f9c18ff-ecd5-5bbc-b0ea-962b9111ae44" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186279752}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "acbeeb79-18dc-516f-93ba-82ddf3fe8247" :question/math-academy-id "q-127903" :question/problem "If $M=[\\begin{aligned}t & 5 \\\\ t & 9\\end{aligned}]$ is a singular matrix, calculate the value(s) of $t.$" :question/worked-solution "The matrix $M$ is singular if and only if $det(M)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(M) & =t\\cdot 9-t\\cdot 5 \\\\  & =9t-5t \\\\  & =4t\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $t:$\n\n$$\n\\begin{aligned}4t & =0 \\\\ t & =0\\end{aligned}\n$$\n\nTherefore, the value of $t$ is $t=0.$"}] [{:db/id #edb/ref 17592186279761 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e828c40-5af3-5275-a151-b4a86d05ae24" :answer/type {:db/ident :answer.type/text} :answer/value "$T$ only" :db/id #edb/ref 17592186279763} {:answer/id #uuid "26d9357a-fee8-58d9-81a4-e28e74153883" :answer/type {:db/ident :answer.type/text} :answer/value "$R$ and $T$ only" :db/id #edb/ref 17592186279764} {:answer/id #uuid "0282c561-94e2-5116-ad0e-1161283efe30" :answer/type {:db/ident :answer.type/text} :answer/value "$S$ only" :db/id #edb/ref 17592186279765} {:answer/id #uuid "b4e6ea5c-6625-58f7-bd40-7417279456c2" :answer/type {:db/ident :answer.type/text} :answer/value "$R$ and $S$ only" :db/id #edb/ref 17592186279766} {:answer/id #uuid "13f86d40-79de-5f73-af23-79138bb48962" :answer/type {:db/ident :answer.type/text} :answer/value "$R$ only" :db/id #edb/ref 17592186279767}] :answer-field/correct {:answer/id #uuid "b4e6ea5c-6625-58f7-bd40-7417279456c2" :answer/type {:db/ident :answer.type/text} :answer/value "$R$ and $S$ only" :db/id #edb/ref 17592186279766} :answer-field/id #uuid "4147700b-537e-5ff3-ae62-abe8362e4d45" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186279762}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7d719636-2650-52a5-a453-2a2dc5859fac" :question/math-academy-id "q-71934" :question/problem "Which of the matrices below does **not** have an inverse?\n\n$$\nR=[\\begin{aligned}5 & 2 \\\\ 10 & 4\\end{aligned}],\\,S=[\\begin{aligned}15 & 0 \\\\ 1 & -1 \\\\ 10 & 0\\end{aligned}],\\,T=[\\begin{aligned}2 & 2 \\\\ -2 & 2\\end{aligned}].\n$$" :question/worked-solution "- For the matrix $R$, we have\n\n$$\ndet(R)=5\\cdot 4-10\\cdot 2=0.\n$$\n\nBecause $det(R)=0,$ we conclude that $R$ is not invertible.\n\n- The matrix $S$ is a $3\\times 2$ matrix. So, it is not invertible.\n\n- For the matrix $T$, we have\n\n$$\ndet(T)=2\\cdot 2-(-2)\\cdot 2=8.\n$$\n\nBecause $det(T)\\ne 0,$ we conclude that $T$ is invertible.\n\nTherefore, only $R$ and $S$ do not have an inverse."}] [{:db/id #edb/ref 17592186277127 :knowledge-point/_questions [{:knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01" :knowledge-point/title "Solving for a Variable in a Singular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a2432f1-06ef-596e-a4ad-a7b950fab294" :answer/type {:db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186277129} {:answer/id #uuid "d2c77e6d-18f5-5b5d-8323-5394b92b24e6" :answer/type {:db/ident :answer.type/math} :answer/value "t=5" :db/id #edb/ref 17592186277130} {:answer/id #uuid "f965bb0f-74c0-548e-b2a8-2b56e74fca3d" :answer/type {:db/ident :answer.type/math} :answer/value "t=-5" :db/id #edb/ref 17592186277131} {:answer/id #uuid "019324c7-81c8-5b53-bf56-b700abdaa7c0" :answer/type {:db/ident :answer.type/math} :answer/value "t=\\frac{3}{4}" :db/id #edb/ref 17592186277132} {:answer/id #uuid "105cab17-a1b0-5700-a8de-e49a40cb8f6c" :answer/type {:db/ident :answer.type/math} :answer/value "t=-\\frac{3}{4}" :db/id #edb/ref 17592186277133}] :answer-field/correct {:answer/id #uuid "7a2432f1-06ef-596e-a4ad-a7b950fab294" :answer/type {:db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186277129} :answer-field/id #uuid "d6d60900-5445-5716-b671-a3f6295914cc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277128}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "02eff272-95c3-5a34-a191-db8af4578dbd" :question/math-academy-id "q-71969" :question/problem "If $M=[\\begin{aligned}t & 4 \\\\ t & 10\\end{aligned}]$ is a singular matrix, calculate the value of $t.$" :question/worked-solution "The matrix $M$ is singular if and only if $det(M)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(M) & =t\\cdot 10-t\\cdot 4 \\\\  & =10t-4t \\\\  & =6t\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $t:$\n\n$$\n\\begin{aligned}6t & =0 \\\\ t & =0\\end{aligned}\n$$\n\nTherefore, the value of $t$ is $t=0.$"}]}
