#{[{:db/id #edb/ref 17592186275628 :knowledge-point/_questions [{:knowledge-point/id #uuid "27da4eb7-48c8-58f4-9676-c88d659f5fbb" :knowledge-point/title "Dividing an Imaginary Number by a Complex Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1de0b10b-47fe-56b5-b937-b5569e5e9101" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186275630}] :answer-field/correct {:answer/id #uuid "1de0b10b-47fe-56b5-b937-b5569e5e9101" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186275630} :answer-field/id #uuid "764ff62d-2f8e-5ef3-af41-de7e5875e934" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275629} {:answer-field/choices [{:answer/id #uuid "2c0eb84b-6c92-5b7e-a069-18784297930a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186275632}] :answer-field/correct {:answer/id #uuid "2c0eb84b-6c92-5b7e-a069-18784297930a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186275632} :answer-field/id #uuid "c07b9bab-4835-5fbd-a748-3f03e4df9125" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275631}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e8165711-54b7-5043-aeb6-860843b30537" :question/math-academy-id "q-316847" :question/problem "Evaluate the expression below, expressing your answer in the form $a+b\\text{i},$ where $a$ and $b$ are real numbers.\n\n$\\frac{5\\text{i}}{1+3\\text{i}}=($\n{{field-1}} \n$)\\,+\\,($\n{{field-2}}\n$)\\,\\text{i}$" :question/worked-solution "The denominator is $1+3\\text{i}$ and its conjugate is $1-3\\text{i}.$ We multiply both the numerator and the denominator by $1-3\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{5\\text{i}}{1+3\\text{i}} & =\\frac{5\\text{i}}{1+3\\text{i}}\\cdot \\frac{1-3\\text{i}}{1-3\\text{i}} \\\\  & =\\frac{5\\text{i}-15{\\text{i}}^{2}}{{1}^{2}-(3\\text{i})^{2}} \\\\  & =\\frac{5\\text{i}-15(-1)}{1-(-9)} \\\\  & =\\frac{5\\text{i}+15}{10} \\\\  & =\\frac{15+5\\text{i}}{10}.\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\frac{15+5\\text{i}}{10}=(\\frac{3}{2})+(\\frac{1}{2})\\,\\text{i}.\n$$"}]}
