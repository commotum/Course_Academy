umber, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\frac{-7+21\\text{i}}{10}=(-\\frac{7}{10})+(\\frac{21}{10})\\,\\text{i}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037457/state.json" "file_sha256" "58f5edaf06cd6791fd9538b3fe60824e8e81fbf9036f0d7e894a6e906346c178"} {"question" "q-316848" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037457/activity-metadata.json" "file_sha256" "c494780e4970659270872b5cd5b1ab0e6be9b4fef0c02cbecb5ab0822ce4b831"} {"question" "q-316848" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037457/state.json" "file_sha256" "58f5edaf06cd6791fd9538b3fe60824e8e81fbf9036f0d7e894a6e906346c178"} {"question" "q-316848" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{7}{10}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037457/state.json" "file_sha256" "58f5edaf06cd6791fd9538b3fe60824e8e81fbf9036f0d7e894a6e906346c178"} {"question" "q-316848" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037457/state.json" "file_sha256" "58f5edaf06cd6791fd9538b3fe60824e8e81fbf9036f0d7e894a6e906346c178"} {"question" "q-316848" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{21}{10}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037457/stat