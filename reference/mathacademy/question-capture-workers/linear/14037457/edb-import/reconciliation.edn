0\\text{i}}{100} & =-\\frac{90}{100}+\\frac{50}{100}\\text{i} \\\\  & =(-\\frac{9}{10})+(\\frac{1}{2})\\,\\text{i}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037457/state.json" "file_sha256" "58f5edaf06cd6791fd9538b3fe60824e8e81fbf9036f0d7e894a6e906346c178"} {"question" "q-316891" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037457/activity-metadata.json" "file_sha256" "c494780e4970659270872b5cd5b1ab0e6be9b4fef0c02cbecb5ab0822ce4b831"} {"question" "q-316891" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037457/state.json" "file_sha256" "58f5edaf06cd6791fd9538b3fe60824e8e81fbf9036f0d7e894a6e906346c178"} {"question" "q-316891" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{9}{10}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037457/state.json" "file_sha256" "58f5edaf06cd6791fd9538b3fe60824e8e81fbf9036f0d7e894a6e906346c178"} {"question" "q-316891" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037457/state.json" "file_sha256" "58f5edaf06cd6791fd9538b3fe60824e8e81fbf9036f0d7e894a6e906346c178"} {"question" "q-316891" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037457/state.json" "file_sha256" "58f5edaf06cd6791fd9538b3fe60824e8e81fbf9036f0d7e894a6e906346c178"} {"question" "q-167676" "field" nil "attribute" "question/problem" "value" "$\\frac{6-4\\text{i}}{3\\text{i}}=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037457/state.json" "file_sha256" "58f5edaf06cd6791fd9538b3fe60824e8e81fbf9036f0d7e894a6e906346c178"} {"question" "q-167676" "field" nil "attribute" "question/worked-solution" "value" "Here, the denominator is the imaginary number $3\\text{i}.$ Note that this can be written as $0+3\\text{i},$ so the conjugate is $0-3\\text{i},$ or simply $-3\\text{i}.$\n\nSo, we multiply both the numerator and the denominator by $-3\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{6-4\\text{i}}{3\\text{i}} & =\\frac{6-4\\text{i}}{3\\text{i}}\\cdot \\frac{-3\\text{i}}{-3\\text{i}} \\\\  & =\\frac{-18\\text{i}+12{\\text{i}}^{2}}{-9{\\text{i}}^{2}} \\\\  & =\\frac{-18\\text{i}+12(-1)}{-9(-1)} \\\\  & =\\frac{-12-18\\text{i}}{9}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\frac{-12-18\\text{i}}{9} & =-\\frac{12}{9}-\\frac{18}{9}\\text{i} \\\\  & =-\\frac{4}{3}-2\\text{i}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037457/state.json" "file_sha256" "58f5edaf06cd6791fd9538b3fe60824e8e81fbf9036f0d7e894a6e906346c178"} {"question" "q-167676" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037457/activity-metadata.json" "file_sha256" "c494780e4970659270872b5cd5b1ab0e6be9b4fef0c02cbecb5ab0822ce4b831"} {"question" "q-167676" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037457/state.json" "file_sha256" "58f5edaf06cd6791fd9538b3fe60824e8e81fbf9036f0d7e894a6e906346c178"} {"question" "q-167676" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{4}{3}+2\\text{i}"] ["math" "-\\frac{4}{3}-2\\text{i}"] ["math" "1-\\frac{2}{9}i"] ["math" "\\frac{2}{9}+\\frac{1}{9}i"] ["math" "\\frac{4}{3}-\\frac{2}{3}\\text{i}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037457/state.json" "file_sha256" "58f5edaf06cd6791fd9538b3fe60824e8e81fbf9036f0d7e894a6e906346c178"} {"question" "q-167676" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{4}{3}-2\\text{i}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037457/state.json" "file_sha256" "58f5edaf06cd6791fd9538b3fe60824e8e81fbf9036f0d7e894a6e906346c178"} {"question" "q-74659" "field" nil "attribute" "question/problem" "value" "If ${z}_{1}=1-12\\text{i}$ and ${z}_{2}=8\\text{i}$, then ${z}_{1}$ divided by ${z}_{2}$ equals" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037457/state.json" "file_sha256" "58f5edaf06cd6791fd9538b3fe60824e8e81fbf9036f0d7e894a6e906346c178"} {"question" "q-74659" "field" nil "attribute" "question/worked-solution" "value" "First, we set up the fraction:\n\n$$\n\\frac{1-12\\text{i}}{8\\text{i}}\n$$\n\nThe denominator is the imaginary number $8\\text{i}.$ Note that this can be written as $0+8\\text{i},$ so the conjugate is $0-8\\text{i},$ or simply $-8\\text{i}.$\n\nSo, we multiply both the numerator and the denominator by $-8\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{{z}_{1}}{{z}_{2}} & =\\frac{1-12\\text{i}}{8\\text{i}} \\\\  & =\\frac{1-12\\text{i}}{8\\text{i}}\\cdot \\frac{-8\\text{i}}{-8\\text{i}} \\\\  & =\\frac{-8\\text{i}+96{\\text{i}}^{2}}{-64{\\text{i}}^{2}} \\\\  & =\\frac{-8\\text{i}+96(-1)}{-64(-1)} \\\\  & =\\frac{-96-8\\text{i}}{64}\\end{aligned}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{-96-8\\text{i}}{64}=-\\frac{96}{64}-\\frac{8}{64}\\text{i}=-\\frac{3}{2}-\\frac{1}{8}\\text{i}\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037457/state.json" "file_sha256" "58f5edaf06cd6791fd9538b3fe60824e8e81fbf9036f0d7e894a6e906346c178"} {"question" "q-74659" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037457/activity-metadata.json" "file_sha256" "c494780e4970659270872b5cd5b1ab0e6be9b4fef0c02cbecb5ab0822ce4b831"} {"question" "q-74659" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037457/state.json" "file_sha256" "58f5edaf06cd6791fd9538b3fe60824e8e81fbf9036f0d7e894a6e906346c178"} {"question" "q-74659" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{1}{2}-\\frac{5}{8}\\text{i}"] ["math" "-\\frac{3}{2}-\\frac{1}{8}\\text{i}"] ["math" "-\\frac{5}{2}-\\frac{3}{8}\\text{i}"] ["math" "\\frac{3}{2}+\\frac{1}{8}\\text{i}"] ["math" "\\frac{7}{2}-\\frac{1}{8}\\text{i}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037457/state.json" "file_sha256" "58f5edaf06cd6791fd9538b3fe60