#{[{:db/id #edb/ref 17592186278145 :knowledge-point/_questions [{:knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f" :knowledge-point/title "Calculating a Vector Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "400bd356-c1fe-5ed0-8242-025adf5f7a15" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,0,0⟩" :db/id #edb/ref 17592186278147} {:answer/id #uuid "7cb0afd9-989d-53b8-86c0-53eb4639a4c1" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\frac{57}{35},\\frac{19}{14},-\\frac{57}{35}⟩" :db/id #edb/ref 17592186278148} {:answer/id #uuid "ca29111c-2e32-53d7-8c62-ce1b88a8033e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\frac{57}{35},\\frac{19}{14},-\\frac{57}{70}⟩" :db/id #edb/ref 17592186278149} {:answer/id #uuid "0ac030f5-2ec3-5198-9d0d-fcd67017c94c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\frac{57}{35},\\frac{19}{35},-\\frac{57}{35}⟩" :db/id #edb/ref 17592186278150} {:answer/id #uuid "c87db22e-acff-5a20-a106-6fc38ab20a59" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\frac{57}{70},\\frac{19}{14},-\\frac{57}{70}⟩" :db/id #edb/ref 17592186278151}] :answer-field/correct {:answer/id #uuid "ca29111c-2e32-53d7-8c62-ce1b88a8033e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\frac{57}{35},\\frac{19}{14},-\\frac{57}{70}⟩" :db/id #edb/ref 17592186278149} :answer-field/id #uuid "d5784fa7-b9b4-503f-8178-7f044d1f4788" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278146}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "16afdc3e-3de7-5f89-a577-96cb66b16553" :question/math-academy-id "q-19194" :question/problem "Let $a=⟨-2,-1,-4⟩$ and $b=⟨6,-5,3⟩.$ Find the vector projection of $a$ onto $b.$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{(-2)\\cdot 6+(-1)\\cdot (-5)+(-4)\\cdot 3}{{6}^{2}+(-5)^{2}+{3}^{2}}b \\\\  & =-\\frac{19}{70}⟨6,-5,3⟩ \\\\  & =⟨-\\frac{57}{35},\\frac{19}{14},-\\frac{57}{70}⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278199 :knowledge-point/_questions [{:knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf" :knowledge-point/title "Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69eee15f-675e-5451-9bf0-87f26f881a43" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186278201}] :answer-field/correct {:answer/id #uuid "69eee15f-675e-5451-9bf0-87f26f881a43" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186278201} :answer-field/id #uuid "6889c208-b26b-546c-9fe1-cb0a3c998435" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186278200}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6fd1a3fd-cf3d-56c3-88b8-eb3ea7bb8999" :question/math-academy-id "q-316761" :question/problem "Let $r=⟨-5,1,3⟩$ and $s=⟨n,-2,4⟩.$ Given that the projection of $r$ onto $s$ is the zero vector, find the value of $n.$\n\n$n=$\n{{field-1}}" :question/worked-solution "Since $r$ is a nonzero vector, its projection onto another nonzero vector $s$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\nr⊥s\\,⟹\\,r\\cdot s=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}r\\cdot s & ={r}_{x}\\cdot {s}_{x}+{r}_{y}\\cdot {s}_{y}+{r}_{z}\\cdot {s}_{z} \\\\  & =(-5)\\cdot n+1\\cdot (-2)+3\\cdot 4 \\\\  & =-5n-2+12 \\\\  & =10-5n.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}r\\cdot s & =0 \\\\ 10-5n & =0 \\\\ n & =2.\\end{aligned}\n$$"}]}
