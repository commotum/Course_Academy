beee-ef7867f5e3fc" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317655/field-3/adb728599602a1a3a50484f34a901ee3faaa5562325b61d23044fdd525aadbb3" :answer-field/choices ["q-317655/field-3/adb728599602a1a3a50484f34a901ee3faaa5562325b61d23044fdd525aadbb3"] :db/ensure [:answer-field/validate]} {:db/id "q-317655" :question/id #uuid "f2920eb9-1d3b-596b-ab0b-8356f94ab348" :question/math-academy-id "q-317655" :question/problem "Let $r=[\\begin{aligned}-3 \\\\ 2 \\\\ 7\\end{aligned}]$ and $s=[\\begin{aligned}1 \\\\ 0 \\\\ -2\\end{aligned}].$ Find the vector projection of $r$ onto $s.$\n\n${\\text{proj}}_{s}\\,r=⟨$ \n{{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}\n$⟩$" :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{s}\\,r & =\\frac{r\\cdot s}{s\\cdot s}s \\\\  & =\\frac{{r}_{x}{s}_{x}+{r}_{y}{s}_{y}+{r}_{z}{s}_{z}}{{s}_{x}^{2}+{s}_{y}^{2}+{s}_{z}^{2}}s \\\\  & =\\frac{(-3)\\cdot 1+2\\cdot 0+7\\cdot (-2)}{{1}^{2}+{0}^{2}+(-2)^{2}}s \\\\  & =\\frac{-17}{5}⟨1,0,-2⟩ \\\\  & =⟨\\,-\\frac{17}{5},0,\\frac{34}{5}\\,⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-317655/field-1" "q-317655/field-2" "q-317655/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f"] :knowledge-point/questions ["q-317655"] :db/ensure [:knowledge-point/validate]} {:db/id "q-317658/field-1/29ff1058d592a5f16a2e75412d6b4d51166f3c3d7c0cbd4b74d3ce98d98e93bc" :answer/id #uuid "bf88465b-8e08-5fc3-99f3-9eba8917c055" :answer/type :answer.type/math :answer/value "\\frac{23}{15}" :db/ensure [:answer/validate]} {:db/id "q-317658/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "39528bc1-a581-5d8f-a4aa-b4d66383ed91" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-317658/field-1" :answer-field/id #uuid "01e9eb54-4d26-5449-8384-0204a61f9b8a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317658/field-1/29ff1058d592a5f16a2e75412d6b4d51166f3c3d7c0cbd4b74d3ce98d98e93bc" :answer-field/choices ["q-317658/field-1/29ff1058d592a5f16a2e75412d6b4d51166f3c3d7c0cbd4b74d3ce98d98e93bc" "q-317658/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-317658/field-2/261b86b9a4ece8c8bb6b2a712b25cb85f6503ebccec3a40aa209961563450bfc" :answer/id #uuid "f5d7de62-7456-537a-ad3d-f8d66835a9f9" :answer/type :answer.type/math :answer/value "-\\frac{23}{30}" :db/ensure [:answer/validate]} {:db/id "q-317658/field-2" :answer-field/id #uuid "ae3e7c4c-817d-5d1d-9bcd-606104c1741c" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317658/field-2/261b86b9a4ece8c8bb6b2a712b25cb85f6503ebccec3a40aa209961563450bfc" :answer-field/choices ["q-317658/field-2/261b86b9a4ece8c8bb6b2a712b25cb85f6503ebccec3a40aa209961563450bfc"] :db/ensure [:answer-field/validate]} {:db/id "q-317658/field-3/60f8a54dc1dcf8c89b88d272a72a9ef597f9ca86d19ef6fc8121a3b45c6ae8b2" :answer/id #uuid "d55a3030-f5df-5e17-b900-8321e7fd3d22" :answer/type :answer.type/math :answer/value "-\\frac{23}{6}" :db/ensure [:answer/validate]} {:db/id "q-317658/field-3" :answer-field/id #uuid "da469bd5-bb6d-5cf1-8dba-a8a8964f8965" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317658/field-3/60f8a54dc1dcf8c89b88d272a72a9ef597f9ca86d19ef6fc8121a3b45c6ae8b2" :answer-field/choices ["q-317658/field-3/60f8a54dc1dcf8c89b88d272a72a9ef597f9ca86d19ef6fc8121a3b45c6ae8b2"] :db/ensure [:answer-field/validate]} {:db/id "q-317658" :question/id #uuid "c31af608-e82f-58a7-8e9f-7b25673a8228" :question/math-academy-id "q-317658" :question/problem "Let $c=⟨-2,1,5⟩$ and $d=⟨4,0,-3⟩.$ Find the vector projection of $d$ onto $c.$\n\n${\\text{proj}}_{c}\\,d=⟨$\n{{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}\n$⟩$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{c}\\,d & =\\frac{c\\cdot d}{c\\cdot c}c \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{{c}_{x}^{2}+{c}_{y}^{2}+{c}_{z}^{2}}c \\\\  & =\\frac{(-2)\\cdot 4+1\\cdot 0+5\\cdot (-3)}{(-2)^{2}+{1}^{2}+{5}^{2}}c \\\\  & =\\frac{-8+0-15}{4+1+25}⟨-2,1,5⟩ \\\\  & =\\frac{-23}{30}⟨-2,1,5⟩ \\\\  & =⟨\\,\\frac{23}{15},-\\frac{23}{30},-\\frac{23}{6}\\,⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-317658/field-1" "q-317658/field-2" "q-317658/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f"] :knowledge-point/questions ["q-317658"] :db/ensure [:knowledge-point/validate]} {:db/id "q-317943/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "028a24f9-5e93-5702-80aa-ab05cbd11e76" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-317943/field-1" :answer-field/id #uuid "22761255-ef3b-5c42-b829-10485bd5fbc7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317943/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-317943/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-317943" :question/id #uuid "7abe39d5-ad94-5425-8d03-ad9ace9d6e8d" :question/math-academy-id "q-317943" :question/problem "Let $a=t\\,i+4j-k$ and $b=2i-j.$ Given that the projection of $a$ onto $b$ is the zero vector, find the value of $t.$\n\n$t=$\n{{field-1}}" :question/worked-solution "Since $a$ is a nonzero vector, its projection onto another nonzero vector $b$ equals the zero vector only when the vectors are perpendicular.\n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =t\\cdot 2+4\\cdot (-1)+(-1)\\cdot 0 \\\\  & =2t-4+0 \\\\  & =2t-4.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 2t-4 & =0 \\\\ 2t & =4 \\\\ t & =2 \\\\ t & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-317943/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf"] :knowledge-point/questions ["q-317943"] :db/ensure [:knowledge-point/validate]}]
