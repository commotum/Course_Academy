#{[{:db/id #edb/ref 17592186278145 :knowledge-point/_questions [{:knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f" :knowledge-point/title "Calculating a Vector Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "400bd356-c1fe-5ed0-8242-025adf5f7a15" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,0,0⟩" :db/id #edb/ref 17592186278147} {:answer/id #uuid "7cb0afd9-989d-53b8-86c0-53eb4639a4c1" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\frac{57}{35},\\frac{19}{14},-\\frac{57}{35}⟩" :db/id #edb/ref 17592186278148} {:answer/id #uuid "ca29111c-2e32-53d7-8c62-ce1b88a8033e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\frac{57}{35},\\frac{19}{14},-\\frac{57}{70}⟩" :db/id #edb/ref 17592186278149} {:answer/id #uuid "0ac030f5-2ec3-5198-9d0d-fcd67017c94c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\frac{57}{35},\\frac{19}{35},-\\frac{57}{35}⟩" :db/id #edb/ref 17592186278150} {:answer/id #uuid "c87db22e-acff-5a20-a106-6fc38ab20a59" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\frac{57}{70},\\frac{19}{14},-\\frac{57}{70}⟩" :db/id #edb/ref 17592186278151}] :answer-field/correct {:answer/id #uuid "ca29111c-2e32-53d7-8c62-ce1b88a8033e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\frac{57}{35},\\frac{19}{14},-\\frac{57}{70}⟩" :db/id #edb/ref 17592186278149} :answer-field/id #uuid "d5784fa7-b9b4-503f-8178-7f044d1f4788" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278146}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "16afdc3e-3de7-5f89-a577-96cb66b16553" :question/math-academy-id "q-19194" :question/problem "Let $a=⟨-2,-1,-4⟩$ and $b=⟨6,-5,3⟩.$ Find the vector projection of $a$ onto $b.$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{(-2)\\cdot 6+(-1)\\cdot (-5)+(-4)\\cdot 3}{{6}^{2}+(-5)^{2}+{3}^{2}}b \\\\  & =-\\frac{19}{70}⟨6,-5,3⟩ \\\\  & =⟨-\\frac{57}{35},\\frac{19}{14},-\\frac{57}{70}⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278199 :knowledge-point/_questions [{:knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf" :knowledge-point/title "Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69eee15f-675e-5451-9bf0-87f26f881a43" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186278201} {:answer/id #uuid "f6f93de1-7b45-526b-ada3-fcd1756ef81f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186370864}] :answer-field/correct {:answer/id #uuid "69eee15f-675e-5451-9bf0-87f26f881a43" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186278201} :answer-field/id #uuid "6889c208-b26b-546c-9fe1-cb0a3c998435" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186278200}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6fd1a3fd-cf3d-56c3-88b8-eb3ea7bb8999" :question/math-academy-id "q-316761" :question/problem "Let $r=⟨-5,1,3⟩$ and $s=⟨n,-2,4⟩.$ Given that the projection of $r$ onto $s$ is the zero vector, find the value of $n.$\n\n$n=$\n{{field-1}}" :question/worked-solution "Since $r$ is a nonzero vector, its projection onto another nonzero vector $s$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\nr⊥s\\,⟹\\,r\\cdot s=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}r\\cdot s & ={r}_{x}\\cdot {s}_{x}+{r}_{y}\\cdot {s}_{y}+{r}_{z}\\cdot {s}_{z} \\\\  & =(-5)\\cdot n+1\\cdot (-2)+3\\cdot 4 \\\\  & =-5n-2+12 \\\\  & =10-5n.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}r\\cdot s & =0 \\\\ 10-5n & =0 \\\\ n & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186370865 :knowledge-point/_questions [{:knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f" :knowledge-point/title "Calculating a Vector Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed260bc3-b345-5403-8a01-aa01cf948172" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{17}{5}" :db/id #edb/ref 17592186370867}] :answer-field/correct {:answer/id #uuid "ed260bc3-b345-5403-8a01-aa01cf948172" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{17}{5}" :db/id #edb/ref 17592186370867} :answer-field/id #uuid "d6c262dd-28db-5c7f-b2e1-2c4112261be4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186370866} {:answer-field/choices [{:answer/id #uuid "37d56d15-5369-5d44-8136-f5b1e442e0be" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186370869}] :answer-field/correct {:answer/id #uuid "37d56d15-5369-5d44-8136-f5b1e442e0be" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186370869} :answer-field/id #uuid "6c7f3ff9-dc23-5335-b708-d73cd4d24fab" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186370868} {:answer-field/choices [{:answer/id #uuid "3c5e16d8-a0df-5927-b273-02c823e8046f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{34}{5}" :db/id #edb/ref 17592186370871}] :answer-field/correct {:answer/id #uuid "3c5e16d8-a0df-5927-b273-02c823e8046f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{34}{5}" :db/id #edb/ref 17592186370871} :answer-field/id #uuid "3b7bcef2-d01d-5499-beee-ef7867f5e3fc" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186370870}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f2920eb9-1d3b-596b-ab0b-8356f94ab348" :question/math-academy-id "q-317655" :question/problem "Let $r=[\\begin{aligned}-3 \\\\ 2 \\\\ 7\\end{aligned}]$ and $s=[\\begin{aligned}1 \\\\ 0 \\\\ -2\\end{aligned}].$ Find the vector projection of $r$ onto $s.$\n\n${\\text{proj}}_{s}\\,r=⟨$ \n{{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}\n$⟩$" :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{s}\\,r & =\\frac{r\\cdot s}{s\\cdot s}s \\\\  & =\\frac{{r}_{x}{s}_{x}+{r}_{y}{s}_{y}+{r}_{z}{s}_{z}}{{s}_{x}^{2}+{s}_{y}^{2}+{s}_{z}^{2}}s \\\\  & =\\frac{(-3)\\cdot 1+2\\cdot 0+7\\cdot (-2)}{{1}^{2}+{0}^{2}+(-2)^{2}}s \\\\  & =\\frac{-17}{5}⟨1,0,-2⟩ \\\\  & =⟨\\,-\\frac{17}{5},0,\\frac{34}{5}\\,⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186370872 :knowledge-point/_questions [{:knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f" :knowledge-point/title "Calculating a Vector Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf88465b-8e08-5fc3-99f3-9eba8917c055" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{23}{15}" :db/id #edb/ref 17592186370874} {:answer/id #uuid "39528bc1-a581-5d8f-a4aa-b4d66383ed91" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186370875}] :answer-field/correct {:answer/id #uuid "bf88465b-8e08-5fc3-99f3-9eba8917c055" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{23}{15}" :db/id #edb/ref 17592186370874} :answer-field/id #uuid "01e9eb54-4d26-5449-8384-0204a61f9b8a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186370873} {:answer-field/choices [{:answer/id #uuid "f5d7de62-7456-537a-ad3d-f8d66835a9f9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{23}{30}" :db/id #edb/ref 17592186370877}] :answer-field/correct {:answer/id #uuid "f5d7de62-7456-537a-ad3d-f8d66835a9f9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{23}{30}" :db/id #edb/ref 17592186370877} :answer-field/id #uuid "ae3e7c4c-817d-5d1d-9bcd-606104c1741c" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186370876} {:answer-field/choices [{:answer/id #uuid "d55a3030-f5df-5e17-b900-8321e7fd3d22" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{23}{6}" :db/id #edb/ref 17592186370879}] :answer-field/correct {:answer/id #uuid "d55a3030-f5df-5e17-b900-8321e7fd3d22" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{23}{6}" :db/id #edb/ref 17592186370879} :answer-field/id #uuid "da469bd5-bb6d-5cf1-8dba-a8a8964f8965" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186370878}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c31af608-e82f-58a7-8e9f-7b25673a8228" :question/math-academy-id "q-317658" :question/problem "Let $c=⟨-2,1,5⟩$ and $d=⟨4,0,-3⟩.$ Find the vector projection of $d$ onto $c.$\n\n${\\text{proj}}_{c}\\,d=⟨$\n{{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}\n$⟩$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{c}\\,d & =\\frac{c\\cdot d}{c\\cdot c}c \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{{c}_{x}^{2}+{c}_{y}^{2}+{c}_{z}^{2}}c \\\\  & =\\frac{(-2)\\cdot 4+1\\cdot 0+5\\cdot (-3)}{(-2)^{2}+{1}^{2}+{5}^{2}}c \\\\  & =\\frac{-8+0-15}{4+1+25}⟨-2,1,5⟩ \\\\  & =\\frac{-23}{30}⟨-2,1,5⟩ \\\\  & =⟨\\,\\frac{23}{15},-\\frac{23}{30},-\\frac{23}{6}\\,⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186370880 :knowledge-point/_questions [{:knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf" :knowledge-point/title "Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "028a24f9-5e93-5702-80aa-ab05cbd11e76" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186370882}] :answer-field/correct {:answer/id #uuid "028a24f9-5e93-5702-80aa-ab05cbd11e76" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186370882} :answer-field/id #uuid "22761255-ef3b-5c42-b829-10485bd5fbc7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186370881}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "7abe39d5-ad94-5425-8d03-ad9ace9d6e8d" :question/math-academy-id "q-317943" :question/problem "Let $a=t\\,i+4j-k$ and $b=2i-j.$ Given that the projection of $a$ onto $b$ is the zero vector, find the value of $t.$\n\n$t=$\n{{field-1}}" :question/worked-solution "Since $a$ is a nonzero vector, its projection onto another nonzero vector $b$ equals the zero vector only when the vectors are perpendicular.\n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =t\\cdot 2+4\\cdot (-1)+(-1)\\cdot 0 \\\\  & =2t-4+0 \\\\  & =2t-4.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 2t-4 & =0 \\\\ 2t & =4 \\\\ t & =2 \\\\ t & =2.\\end{aligned}\n$$"}]}
