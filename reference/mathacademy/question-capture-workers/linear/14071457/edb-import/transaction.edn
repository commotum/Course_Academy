 \\\\ {C}_{3}:={C}_{3}+(-2){C}_{2} \\\\ {C}_{4}:={C}_{4}+2{C}_{2}\\end{aligned} \\\\  & =|\\begin{aligned}3 & 4 & -6 & 15 \\\\ 2 & -5 & 6 & -2 \\\\ 0 & 1 & 0 & 0 \\\\ -4 & 7 & -5 & 8\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $3$rd row, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}3 & 4 & -6 & 15 \\\\ 2 & -5 & 6 & -2 \\\\ 0 & 1 & 0 & 0 \\\\ -4 & 7 & -5 & 8\\end{aligned}| \\\\  & =1\\cdot (-1)^{3+2}|\\begin{aligned}3 & -6 & 15 \\\\ 2 & 6 & -2 \\\\ -4 & -5 & 8\\end{aligned}| \\\\  & =-|\\begin{aligned}3 & -6 & 15 \\\\ 2 & 6 & -2 \\\\ -4 & -5 & 8\\end{aligned}|.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-132003/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "01ff3b37-83e6-506a-a6e8-07858a2bcb66"] :knowledge-point/questions ["q-132003"] :db/ensure [:knowledge-point/validate]} {:db/id "q-132146/selection/2e3ac8a9be268ab7b7c07f98cd54459f6b3b2f925f90387606bc9479a0d5dbfd" :answer/id #uuid "5f89018a-ae0c-57a5-a5a3-8cbfd22b5e62" :answer/type :answer.type/math :answer/value "340" :db/ensure [:answer/validate]} {:db/id "q-132146/selection/f1c75845439f7547b2a89eaac59f436d7ce65dcfcf9ca28c1b66d939a351c89c" :answer/id #uuid "3ed58fb5-1434-5b8f-a88f-2e72116c7121" :answer/type :answer.type/math :answer/value "312" :db/ensure [:answer/validate]} {:db/id "q-132146/selection/6462af4934bbe2cc3a61a3d3c8a7baaaec43f6185a7fc59a1823ec4bdc0b8f59" :answer/id #uuid "c54b94c8-1002-5bb0-9b71-401fe64a4815" :answer/type :answer.type/math :answer/value "296" :db/ensure [:answer/validate]} {:db/id "q-132146/selection/146ef59b9a85058c08e5f4d772c10028788f315c29fe2290468e61807b6d55f4" :answer/id #uuid "bcfeeb69-27e6-5b5b-9004-0e05bb260a4b" :answer/type :answer.type/math :answer/value "234" :db/ensure [:answer/validate]} {:db/id "q-132146/selection/dfbe136e10923b73c7f02b13e5f2e415b976db41f642d960c010b4276c692eff" :answer/id #uuid "01b8cd19-f7ee-588b-a719-a58acc0a1ece" :answer/type :answer.type/math :answer/value "304" :db/ensure [:answer/validate]} {:db/id "q-132146/selection" :answer-field/id #uuid "1c377356-42c5-57be-bfb7-316cb0a18d54" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-132146/selection/2e3ac8a9be268ab7b7c07f98cd54459f6b3b2f925f90387606bc9479a0d5dbfd" :answer-field/choices ["q-132146/selection/2e3ac8a9be268ab7b7c07f98cd54459f6b3b2f925f90387606bc9479a0d5dbfd" "q-132146/selection/f1c75845439f7547b2a89eaac59f436d7ce65dcfcf9ca28c1b66d939a351c89c" "q-132146/selection/6462af4934bbe2cc3a61a3d3c8a7baaaec43f6185a7fc59a1823ec4bdc0b8f59" "q-132146/selection/146ef59b9a85058c08e5f4d772c10028788f315c29fe2290468e61807b6d55f4" "q-132146/selection/dfbe136e10923b73c7f02b13e5f2e415b976db41f642d960c010b4276c692eff"] :db/ensure [:answer-field/validate]} {:db/id "q-132146" :question/id #uuid "0cc5bbef-3b38-57a9-8cd0-0b1ff80a0540" :question/math-academy-id "q-132146" :question/problem "Calculate the value of \n$\\,|\\begin{aligned}1 & 7 & -2 & 5 \\\\ 5 & -6 & 4 & 1 \\\\ 4 & -4 & 2 & -2 \\\\ -6 & 1 & -3 & 3\\end{aligned}|.$\n\n*Hint: Use elementary column operations to make the entries to the left and to the right of ${a}_{33}$ equal to zero. You should be able to reduce the given $4\\times 4$ determinant to a $3\\times 3$ determinant.*" :question/worked-solution "Using elementary column operations, let's make entries to the left and to the right of ${a}_{33}=2$ equal to zero.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}1 & 7 & -2 & 5 \\\\ 5 & -6 & 4 & 1 \\\\ 4 & -4 & 2 & -2 \\\\ -6 & 1 & -3 & 3\\end{aligned}| &  & \\,\\begin{aligned}{C}_{1}:={C}_{1}+(-2){C}_{3} \\\\ {C}_{2}:={C}_{2}+2{C}_{3} \\\\ {C}_{4}:={C}_{4}+{C}_{3}\\end{aligned} \\\\  & =|\\begin{aligned}5 & 3 & -2 & 3 \\\\ -3 & 2 & 4 & 5 \\\\ 0 & 0 & 2 & 0 \\\\ 0 & -5 & -3 & 0\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $3$rd row, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}5 & 3 & -2 & 3 \\\\ -3 & 2 & 4 & 5 \\\\ 0 & 0 & 2 & 0 \\\\ 0 & -5 & -3 & 0\\end{aligned}| \\\\  & =2\\cdot (-1)^{3+3}|\\begin{aligned}5 & 3 & 3 \\\\ -3 & 2 & 5 \\\\ 0 & -5 & 0\\end{aligned}| \\\\  & =2|\\begin{aligned}5 & 3 & 3 \\\\ -3 & 2 & 5 \\\\ 0 & -5 & 0\\end{aligned}| \\\\  & =2\\cdot (-5)\\cdot (-1)^{3+2}|\\begin{aligned}5 & 3 \\\\ -3 & 5\\end{aligned}| \\\\  & =10(25+9) \\\\  & =340.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-132146/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37209e5f-a6e8-55d5-b76f-19f79db67566"] :knowledge-point/questions ["q-132146"] :db/ensure [:knowledge-point/validate]}]
