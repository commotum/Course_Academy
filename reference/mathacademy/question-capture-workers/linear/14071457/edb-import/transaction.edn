58cffaa4/7f25e693f1f2293f6257e294f7deae30e0f8b1accb9eaef87c221811007d340f" :answer-field/choices ["q-91220/selection/ma-v1/99384de3f1f1d9e92c86409322bc733a9f32db0abdd1ee353fd71e9158cffaa4/298a0faf60e26b9e69061203d85fcc2bb83b218312361e851a4d1b57b64dc4d8" "q-91220/selection/ma-v1/99384de3f1f1d9e92c86409322bc733a9f32db0abdd1ee353fd71e9158cffaa4/7ca9ef8ccc266685b9d3533c2eedc390d597f9c94618d8c6cdad23645bd7a696" "q-91220/selection/ma-v1/99384de3f1f1d9e92c86409322bc733a9f32db0abdd1ee353fd71e9158cffaa4/7f25e693f1f2293f6257e294f7deae30e0f8b1accb9eaef87c221811007d340f" "q-91220/selection/ma-v1/99384de3f1f1d9e92c86409322bc733a9f32db0abdd1ee353fd71e9158cffaa4/f5390a5a3b224b2ecb620586c7608a1d981c540287114b54218ba1f973f31230" "q-91220/selection/ma-v1/99384de3f1f1d9e92c86409322bc733a9f32db0abdd1ee353fd71e9158cffaa4/7b3bb1bdad40ba904a86454780cb97107b32eb603a3e42e9b0975178d69898b4"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-91220"] :question/problem "$$\n|\\begin{aligned}-2 & -4 & 2 & 1 \\\\ 3 & 2 & 1 & 2 \\\\ 6 & -4 & 2 & 2 \\\\ 2 & -3 & -2 & -3\\end{aligned}|\n$$\n\nConsider the above $4\\times 4$ determinant. Which of the following $3\\times 3$ determinants has the same value?\n\n*Hint: Use elementary column operations to make the entries to the left and to the right of ${a}_{33}$ equal to zero.*" :question/worked-solution "Let's make entries to the left and to the right of ${a}_{33}=2$ equal to zero using elementary column operations.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}-2 & -4 & 2 & 1 \\\\ 3 & 2 & 1 & 2 \\\\ 6 & -4 & 2 & 2 \\\\ 2 & -3 & -2 & -3\\end{aligned}| &  & \\,\\begin{aligned}{C}_{1}:={C}_{1}+(-3){C}_{3} \\\\ {C}_{2}:={C}_{2}+2{C}_{3} \\\\ {C}_{4}:={C}_{4}+(-1){C}_{3}\\end{aligned} \\\\  & =|\\begin{aligned}-8 & 0 & 2 & -1 \\\\ 0 & 4 & 1 & 1 \\\\ 0 & 0 & 2 & 0 \\\\ 8 & -7 & -2 & -1\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $3$rd row, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}-8 & 0 & 2 & -1 \\\\ 0 & 4 & 1 & 1 \\\\ 0 & 0 & 2 & 0 \\\\ 8 & -7 & -2 & -1\\end{aligned}| \\\\  & =2\\cdot (-1)^{3+3}|\\begin{aligned}-8 & 0 & -1 \\\\ 0 & 4 & 1 \\\\ 8 & -7 & -1\\end{aligned}| \\\\  & =2|\\begin{aligned}-8 & 0 & -1 \\\\ 0 & 4 & 1 \\\\ 8 & -7 & -1\\end{aligned}|.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-91220/selection/ma-v1/99384de3f1f1d9e92c86409322bc733a9f32db0abdd1ee353fd71e9158cffaa4"] :db/ensure [:question/validate]} {:db/id "q-91221/selection/cf498dff208cde645e7e0c8fccf1d62b90535894498512d89fca484adc0298a7" :answer/id #uuid "d3182fd5-446d-59dd-86db-cfa2612690b4" :answer/type :answer.type/math :answer/value "|\\begin{aligned}3 & 0 & 1 \\\\ -10 & 1 & 10 \\\\ 11 & -3 & 5\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-91221/selection/ca989ba67d45cb053813baa7a6db90403c4aecbe8efd66d4060fa0b44e496b00" :answer/id #uuid "bba49d8c-6671-5cc4-b6f3-6419f01356b4" :answer/type :answer.type/math :answer/value "|\\begin{aligned}2 & -3 & -1 \\\\ -3 & 1 & 2 \\\\ 1 & 4 & -2\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-91221/selection/cbb7b07b83e5399ec49e3c94ed5150094cdf0107df44b12bed94a639f4a3be3d" :answer/id #uuid "ca979a87-40a5-507b-a8f2-549f278b2145" :answer/type :answer.type/math :answer/value "|\\begin{aligned}-1 & 2 & -3 \\\\ -2 & -3 & 1 \\\\ 3 & 1 & 4\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-91221/selection/42132249e658c4aca319c6507ee48cdeddab0d24e879ba2a4932bf8eeb60345f" :answer/id #uuid "307043d0-7464-5cf2-97b9-c8c906f9a039" :answer/type :answer.type/math :answer/value "|\\begin{aligned}-1 & 2 & -3 \\\\ -2 & -3 & 1 \\\\ 4 & -2 & 1\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-91221/selection/5606444504a4905c707c9c59f7a8927aa071acc9198ec6046a2b5b5f88bc7056" :answer/id #uuid "68c53f8d-7bc3-5fd5-93a0-94c653f71247" :answer/type :answer.type/math :answer/value "|\\begin{aligned}3 & 0 & 0 \\\\ -10 & 1 & -5 \\\\ 11 & -3 & 10\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-91221/selection" :answer-field/id #uuid "5392364c-2ade-5143-acf9-62d56cad907e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-91221/selection/5606444504a4905c707c9c59f7a8927aa071acc9198ec6046a2b5b5f88bc7056" :answer-field/choices ["q-91221/selection/cf498dff208cde645e7e0c8fccf1d62b90535894498512d89fca484adc0298a7" "q-91221/selection/ca989ba67d45cb053813baa7a6db90403c4aecbe8efd66d4060fa0b44e496b00" "q-91221/selection/cbb7b07b83e5399ec49e3c94ed5150094cdf0107df44b12bed94a639f4a3be3d" "q-91221/selection/42132249e658c4aca319c6507ee48cdeddab0d24e879ba2a4932bf8eeb60345f" "q-91221/selection/5606444504a4905c707c9c59f7a8927aa071acc9198ec6046a2b5b5f88bc7056"] :db/ensure [:answer-field/validate]} {:db/id "q-91221" :question/id #uuid "2c634aee-e652-57bc-9f32-1580a82e9134" :question/math-academy-id "q-91221" :question/problem "$$\n|\\begin{aligned}-1 & 2 & -3 & -1 \\\\ -2 & -3 & 1 & 2 \\\\ 3 & 1 & 4 & -2 \\\\ 4 & -2 & 3 & 1\\end{aligned}|\n$$\n\nConsider the above $4\\times 4$ determinant. Which of the following $3\\times 3$ determinants has the same value?\n\n*Hint: Use elementary column operations to make the entries to the left of ${a}_{44}$ equal to zero.*" :question/worked-solution "Let's make entries to the left of ${a}_{44}=1$ equal to zero using elementary column operations.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}-1 & 2 & -3 & -1 \\\\ -2 & -3 & 1 & 2 \\\\ 3 & 1 & 4 & -2 \\\\ 4 & -2 & 3 & 1\\end{aligned}| &  & \\,\\begin{aligned}{C}_{1}:={C}_{1}+(-4){C}_{4} \\\\ {C}_{2}:={C}_{2}+2{C}_{4} \\\\ {C}_{3}:={C}_{3}+(-3){C}_{4}\\end{aligned} \\\\  & =|\\begin{aligned}3 & 0 & 0 & -1 \\\\ -10 & 1 & -5 & 2 \\\\ 11 & -3 & 10 & -2 \\\\ 0 & 0 & 0 & 1\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $4$th row, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}3 & 0 & 0 & -1 \\\\ -10 & 1 & -5 & 2 \\\\ 11 & -3 & 10 & -2 \\\\ 0 & 0 & 0 & 1\\end{aligned}| \\\\  & =1\\cdot (-1)^{4+4}|\\begin{aligned}3 & 0 & 0 \\\\ -10 & 1 & -5 \\\\ 11 & -3 & 10\\end{aligned}| \\\\  & =|\\begin{aligned}3 & 0 & 0 \\\\ -10 & 1 & -5 \\\\ 11 & -3 & 10\\end{aligned}|.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-91221/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "01ff3b37-83e6-506a-a6e8-07858a2bcb66"] :knowledge-point/questions ["q-91221"] :db/ensure [:knowledge-point/validate]} {:db/id "q-132003/selection/72889f34f3dbc7241210a01735a26c14fd44cc9d9610b6b0eabf3e3181754160" :answer/id #uuid "520b96bb-95ea-55e5-ae87-1b02165294f9" :answer/type :answer.type/math :answer/value "2|\\begin{aligned}3 & 6 & 15 \\\\ -2 & 6 & 2 \\\\ -4 & 0 & 8\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-132003/selection/830f35d57198fb061fc6f741c9956d41356bfc219d19a15a49392fd0acb5b82b" :answer/id #uuid "879e1ffb-632a-5095-8792-8453fa0fb890" :answer/type :answer.type/math :answer/value "-|\\begin{aligned}3 & -6 & 15 \\\\ 2 & 6 & -2 \\\\ -4 & -5 & 8\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-132003/selection/d24d064b0daa6ad1e0af37cd93cc86d21a929f7d941a36643082a8b49c3f649f" :answer/id #uuid "cd4e5260-7e39-5028-b15f-5686d56067bd" :answer/type :answer.type/math :answer/value "-2|\\begin{aligned}3 & 9 & 15 \\\\ 2 & 6 & -4 \\\\ -4 & -10 & 8\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-132003/selection/e70ded597961e1cd9154da1f54c666cbb24fb8ddf399498125a3b686b79e0aa7" :answer/id #uuid "3c783b67-8495-54fb-bbfb-eed70a4350e3" :answer/type :answer.type/math :answer/value "-|\\begin{aligned}3 & -6 & 12 \\\\ 7 & 6 & -2 \\\\ 8 & -5 & 8\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-132003/selection/75e5d1b3