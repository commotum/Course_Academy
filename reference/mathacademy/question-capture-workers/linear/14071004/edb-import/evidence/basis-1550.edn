#{[{:db/id #edb/ref 17592186315678 :knowledge-point/_questions [{:knowledge-point/id #uuid "1d752aac-6187-595d-8818-b0179fd7380e" :knowledge-point/title "Evaluating a Definite Integral Using Multiple Properties of Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c9e9463-cf26-5397-aa9f-1a4cb6b1c09d" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186315680}] :answer-field/correct {:answer/id #uuid "9c9e9463-cf26-5397-aa9f-1a4cb6b1c09d" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186315680} :answer-field/id #uuid "84427e48-6112-5d6f-b1f0-44c153ce084a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186315679}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c37702e7-83e5-59fe-8b7e-6f801a08f386" :question/math-academy-id "q-346213" :question/problem "Suppose that $f(x)$ is a function such that ${\\int }_{7}^{2}(-5)\\,f(x)\\,\\text{d}x=15$ and ${\\int }_{-1}^{2}f(x)\\,\\text{d}x=1.$ What is the value of ${\\int }_{-1}^{7}f(x)\\,\\text{d}x?$\n\n${\\int }_{-1}^{7}f(x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's simplify one of the given integrals:\n\n$$\n\\begin{aligned}{\\int }_{7}^{2}(-5)\\,f(x)\\,\\text{d}x & =15 \\\\ (-5){\\int }_{7}^{2}f(x)\\,\\text{d}x & =15 \\\\ 5{\\int }_{2}^{7}f(x)\\,\\text{d}x & =15 \\\\ {\\int }_{2}^{7}f(x)\\,\\text{d}x & =3\\end{aligned}\n$$\n\nThen, from the adjacent intervals rule, we get\n\n$$\n\\begin{aligned}{\\int }_{-1}^{7}f(x)\\,\\text{d}x & ={\\int }_{-1}^{2}f(x)\\,\\text{d}x+{\\int }_{2}^{7}f(x)\\,\\text{d}x \\\\  & =1+3 \\\\  & =4.\\end{aligned}\n$$"}]}
