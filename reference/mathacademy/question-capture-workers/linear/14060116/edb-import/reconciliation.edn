16/state.json" "file_sha256" "3377500f01fe1e57d901ee3e1ae1b8c7ffa6e13bff2fee3807ecc82b8263344e"} {"question" "q-139992" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-1 & -1 \\\\ -1 & 1\\end{aligned}]"] ["math" "[\\begin{aligned}-1 & -1 \\\\ 1 & -1\\end{aligned}]"] ["math" "[\\begin{aligned}-1 & 1 \\\\ -1 & -1\\end{aligned}]"] ["math" "[\\begin{aligned}-1 & 1 \\\\ -1 & 1\\end{aligned}]"] ["math" "[\\begin{aligned}1 & -1 \\\\ -1 & -1\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060116/state.json" "file_sha256" "3377500f01fe1e57d901ee3e1ae1b8c7ffa6e13bff2fee3807ecc82b8263344e"} {"question" "q-139992" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}1 & -1 \\\\ -1 & -1\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060116/state.json" "file_sha256" "3377500f01fe1e57d901ee3e1ae1b8c7ffa6e13bff2fee3807ecc82b8263344e"} {"question" "q-77959" "field" nil "attribute" "question/problem" "value" "The linear transformation $T$ has the standard matrix \n\n$$\nT=[\\begin{aligned}1 & -4 & -1 \\\\ -3 & 5 & -2 \\\\ 0 & -1 & 0\\end{aligned}].\n$$\n\nWhat are the respective images of the standard basis vectors ${i,j,k}$ of ${R}^{3}$ under the action of $T?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060116/state.json" "file_sha256" "3377500f01fe1e57d901ee3e1ae1b8c7ffa6e13bff2fee3807ecc82b8263344e"} {"question" "q-77959" "field" nil "attribute" "question/worked-solution" "value" "**Method 1**\n\nThe images of the vectors in the standard basis ${i,j,k}$ are the first, second, and third columns of $T,$ respectively. \n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}T(i) & =T[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]=[\\begin{aligned}1 \\\\ -3 \\\\ 0\\end{aligned}] \\\\ T(j) & =T[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]=[\\begin{aligned}-4 \\\\ 5 \\\\ -1\\end{aligned}] \\\\ T(k) & =T[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]=[\\begin{aligned}-1 \\\\ -2 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\n**Method 2**\n\nWe can find the images of the vectors in the standard basis ${i,j,k}$ by computing the matrix products $T\\cdot i,$ $T\\cdot j,$ and $T\\cdot k:$\n\n$$\n\\begin{aligned}T(i) & =T\\cdot i=[\\begin{aligned}1 & -4 & -1 \\\\ -3 & 5 & -2 \\\\ 0 & -1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]=[\\begin{aligned}1 \\\\ -3 \\\\ 0\\end{aligned}] \\\\ T(j) & =T\\cdot j=[\\begin{aligned}1 & -4 & -1 \\\\ -3 & 5 & -2 \\\\ 0 & -1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]=[\\begin{aligned}-4 \\\\ 5 \\\\ -1\\end{aligned}] \\\\ T(k) & =T\\cdot k=[\\begin{aligned}1 & -4 & -1 \\\\ -3 & 5 & -2 \\\\ 0 & -1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]=[\\begin{aligned}-1 \\\\ -2 \\\\ 0\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060116/state.json" "file_sha256" "3377500f01fe1e57d901ee3e1ae1b8c7ffa6e13bff2fee3807ecc82b8263344e"} {"question" "q-77959" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060116/activity-metadata.json" "file_sha256" "05a740a6c02b37abdaeebf43897898fc03edc0913dcb46481d4c5781746136db"} {"question" "q-77959" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060116/state.json" "file_sha256" "3377500f01fe1e57d901ee3e1ae1b8c7ffa6e13bff2fee3807ecc82b8263344