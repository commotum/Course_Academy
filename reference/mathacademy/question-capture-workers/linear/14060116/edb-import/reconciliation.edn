formation is \n\n$$\nT=[\\begin{aligned}1 & 5 \\\\ 4 & -1\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060116/state.json" "file_sha256" "3377500f01fe1e57d901ee3e1ae1b8c7ffa6e13bff2fee3807ecc82b8263344e"} {"question" "q-43892" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060116/activity-metadata.json" "file_sha256" "05a740a6c02b37abdaeebf43897898fc03edc0913dcb46481d4c5781746136db"} {"question" "q-43892" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060116/state.json" "file_sha256" "3377500f01fe1e57d901ee3e1ae1b8c7ffa6e13bff2fee3807ecc82b8263344e"} {"question" "q-43892" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-1 & 5 \\\\ 4 & 1\\end{aligned}]"] ["math" "[\\begin{aligned}1 & 4 \\\\ 5 & -1\\end{aligned}]"] ["math" "[\\begin{aligned}1 & 4 \\\\ 5 & 1\\end{aligned}]"] ["math" "[\\begin{aligned}1 & 5 \\\\ -4 & 1\\end{aligned}]"] ["math" "[\\begin{aligned}1 & 5 \\\\ 4 & -1\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060116/state.json" "file_sha256" "3377500f01fe1e57d901ee3e1ae1b8c7ffa6e13bff2fee3807ecc82b8263344e"} {"question" "q-43892" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}1 & 5 \\\\ 4 & -1\\end{aligned}]"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060116/state.json" "file_sha256" "3377500f01fe1e57d901ee3e1ae1b8c7ffa6e13bff2fee3807ecc82b8263344e"} {"questio