gned}1 \\\\ 0 \\\\ 0\\end{aligned}]=[\\begin{aligned}3 \\\\ 4 \\\\ -1\\end{aligned}] \\\\ T(j) & =T\\cdot j=[\\begin{aligned}3 & 5 & -1 \\\\ 4 & 0 & 3 \\\\ -1 & -4 & 2\\end{aligned}][\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]=[\\begin{aligned}5 \\\\ 0 \\\\ -4\\end{aligned}] \\\\ T(k) & =T\\cdot k=[\\begin{aligned}3 & 5 & -1 \\\\ 4 & 0 & 3 \\\\ -1 & -4 & 2\\end{aligned}][\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]=[\\begin{aligned}-1 \\\\ 3 \\\\ 2\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-77956/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bca46ab2-488a-5596-b96b-559463731556"] :knowledge-point/questions ["q-77956"] :db/ensure [:knowledge-point/validate]} {:db/id "q-139993/selection/29903f9290bdcc3720dc60f4e74311e200cf2bfd1faec2354921d70d91a85f69" :answer/id #uuid "177c704d-c85b-5bbc-8b89-0b79b01c6fa5" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}6 \\\\ 3\\end{aligned}]$ and $[\\begin{aligned}-1 \\\\ 2\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-139993/selection/810a6ebe5d742107880aebb3c262fb229f27e12d923335385b90f0bbf06008f8" :answer/id #uuid "18a4a93e-e19b-52a3-88a1-339a2ed152dc" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}6 \\\\ 1\\end{aligned}]$ and $[\\begin{aligned}3 \\\\ -2\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-139993/selection/fe94f81ebff72f4f41b768d99dac97b826e3d4c91a46ad838e6fc8c0770c0795" :answer/id #uuid "0b2b6d7d-3b43-50b0-b6b4-ca942e85bbc8" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}-3 \\\\ 6\\end{aligned}]$ and $[\\begin{aligned}1 \\\\ -2\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-139993/selection/5f22505d5ece4db135ff9a1913f46028d8077155bf360c708b8a101f928e5b7e" :answer/id #uuid "63424a80-baa4-5c8d-b93c-d8d0ffa93c11" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}6 \\\\ 3\\end{aligned}]$ and $[\\begin{aligned}1 \\\