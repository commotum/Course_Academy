/id #uuid "df8ec8be-83d6-5002-be89-c4e70b901522" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}1 \\\\ -4 \\\\ -1\\end{aligned}]$, $[\\begin{aligned}-3 \\\\ 5 \\\\ -2\\end{aligned}]$, and $[\\begin{aligned}0 \\\\ -1 \\\\ 0\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-77959/selection/51551978117d7d117f3c9a460adf22ae241ee951a993dd428fba61931bc29fca" :answer/id #uuid "e0eb1c4b-5d0c-5c1e-b53b-78e511949c12" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}-3 \\\\ 1 \\\\ 0\\end{aligned}]$, $[\\begin{aligned}5 \\\\ -4 \\\\ -1\\end{aligned}]$, and $[\\begin{aligned}-2 \\\\ -1 \\\\ 0\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-77959/selection/ed97816e37a38eb6a498ca716833296245612efc0b4aa4a585e5e744ef543967" :answer/id #uuid "98fe58a7-561d-5deb-969e-ece258c81755" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}1 \\\\ -3 \\\\ 0\\end{aligned}]$, $[\\begin{aligned}-4 \\\\ 5 \\\\ -1\\end{aligned}]$, and $[\\begin{aligned}-1 \\\\ -2 \\\\ 0\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-77959/selection/cedb5ba0f33ddbb09cb8f64a3b679526cc50623e0c99f8ad84105bd379915049" :answer/id #uuid "c9c6191a-16bf-52ca-ae04-1442a5a74b24" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}-3 \\\\ 5 \\\\ -2\\end{aligned}]$, $[\\begin{aligned}1 \\\\ -4 \\\\ -1\\end{aligned}]$, and $[\\begin{aligned}0 \\\\ -1 \\\\ 0\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-77959/selection" :answer-field/id #uuid "18111578-c492-56fd-a07c-e4919a6f6d09" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-77959/selection/ed97816e37a38eb6a498ca716833296245612efc0b4aa4a585e5e744ef543967" :answer-field/choices ["q-77959/selection/4ffcb272c75094aabecc0dea3c71ae4c6f383cee2f244a44a840bef242aba2c8" "q-77959/selection/c5c0bb897b94167a3d9c9b42e20acf112cfc04950baaeca8d4e70a08353c7ae0" "q-77959/selection/51551978117d7d117f3c9a460adf22ae241ee951a993dd428fba61931bc29fca" "q-77959/selection/ed97816e37a38eb6a498ca716833296245612efc0b4aa4a585e5e744ef543967" "q-77959/selection/cedb5ba0f33ddbb09cb8f64a3b679526cc50623e0c99f8ad84105bd379915049"] :db/ensure [:answer-field/validate]} {:db/id "q-77959" :question/id #uuid "0d760f8c-5521-5c50-bb26-dcdfa4a2f288" :question/math-academy-id "q-77959" :question/problem "The linear transformation $T$ has the standard matrix \n\n$$\nT=[\\begin{aligned}1 & -4 & -1 \\\\ -3 & 5 & -2 \\\\ 0 & -1 & 0\\end{aligned}].\n$$\n\nWhat are the respective images of the standard basis vectors ${i,j,k}$ of ${R}^{3}$ under the action of $T?$" :question/worked-solution "**Method 1**\n\nThe images of the vectors in the standard basis ${i,j,k}$ are the first, second, and third columns of $T,$ respectively. \n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}T(i) & =T[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]=[\\begin{aligned}1 \\\\ -3 \\\\ 0\\end{aligned}] \\\\ T(j) & =T[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]=[\\begin{aligned}-4 \\\\ 5 \\\\ -1\\end{aligned}] \\\\ T(k) & =T[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]=[\\begin{aligned}-1 \\\\ -2 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\n**Method 2**\n\nWe can find the images of the vectors in the standard basis ${i,j,k}$ by computing the matrix products $T\\cdot i,$ $T\\cdot j,$ and $T\\cdot k:$\n\n$$\n\\begin{aligned}T(i) & =T\\cdot i=[\\begin{aligned}1 & -4 & -1 \\\\ -3 & 5 & -2 \\\\ 0 & -1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]=[\\begin{aligned}1 \\\\ -3 \\\\ 0\\end{aligned}] \\\\ T(j) & =T\\cdot j=[\\begin{aligned}1 & -4 & -1 \\\\ -3 & 5 & -2 \\\\ 0 & -1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]=[\\begin{aligned}-4 \\\\ 5 \\\\ -1\\end{aligned}] \\\\ T(k) & =T\\cdot k=[\\begin{aligned}1 & -4 & -1 \\\\ -3 & 5 & -2 \\\\ 0 & -1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]=[\\begin{aligned}-1 \\\\ -2 \\\\ 0\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-77959/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bca46ab2-488a-5596-b96b-559463731556"] :knowledge-point/questions ["q-77959"] :db/ensure [:knowledge-point/validate]} {:db/id "q-77953/selection/33d3dab6539e9867a505698a08fce7400d8c2c84bfb297a9cd3cb12a969b6236" :answer/id #uuid "3e91870f-e5e6-54b2-bea9-3c983cba79d2" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}4 \\\\ -5\\end{aligned}]$ and $[\\begin{aligned}2 \\\\ 1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-77953/selection/66b72153ef870f9911697edde51e59675aa64dd22a2d12120f7211e5f2addde2" :answer/id #uuid "c0ef0b99-29d8-5ac5-8e3a-c7cd396b90d2" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}1 \\\\ -5\\end{aligned}]$ and $[\\begin{aligned}2 \\\\ 4\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-77953/selection/e75fb69961a392bd97e2fecb4618c5047d8eea589d581810bd87674d35c75859" :answer/id #uuid "28d58c4e-4aa6-5d25-8cce-2b7554d6660a" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}2 \\\\ 1\\end{aligned}]$ and $[\\begin{aligned}4 \\\\ -5\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-77953/selection/f290d33680ba5cdb437598cbf454804efad9c0bf3d2a40d9499bff56e6ffa59c" :answer/id #uuid "2b2e4a62-de36-5b33-9843-57f95fd024a4" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}1 \\\\ 2\\end{aligned}]$ and $[\\begin{aligned}-5 \\\\ 4\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-77953/selection/9323f05156dd94757a3f46ef252f944889dc3c8f0294d39120527d1631213358" :answer/id #uuid "2f030885-a243-5108-90b5-a73a7570afa5" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}2 \\\\ 4\\end{aligned}]$ and $[\\begin{aligned}1 \\\\ -5\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-77953/selection" :answer-field/id #uuid "f4b6e0ef-1ada-5c20-865c-67ad25f72bef" :answer-field/key "selection" :answer-field/type :answer-field.type/radi