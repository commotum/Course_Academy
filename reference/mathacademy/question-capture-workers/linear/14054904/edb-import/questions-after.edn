#{[{:db/id #edb/ref 17592186133492 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "e46fa568-0a40-5b36-a01f-20555db9b055" :knowledge-point/title "Calculating the Inner Product of Two Vectors"}] :question/id #uuid "d8ab385f-ca7e-5ac2-9c0c-23ec78c9b1f7" :question/math-academy-id "e-5542" :question/problem "An inner product on $V = \\mathbb{R}^3$ is given by $\\langle \\mathbf{x}, \\mathbf{y} \\rangle =  3 x_1 y_1 + x_2 y_2 + 7 x_3 y_3.$ Find $\\langle \\mathbf{x}, \\mathbf{y} \\rangle,$ if\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14054904/assets/028bb3befd54071fcae6cb88bd3e054d3325557ef31274ec23146e1da81f8258.png)" :question/worked-solution "Computing the inner product according to the definition, we get\n\n$$\n\\begin{aligned}⟨x,y⟩ & =3{x}_{1}{y}_{1}+{x}_{2}{y}_{2}+7{x}_{3}{y}_{3} \\\\  & =3\\cdot 1\\cdot (-3)+(-2)\\cdot 1+7\\cdot 0\\cdot 5 \\\\  & =-9-2+0 \\\\  & =-11.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186133493 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "efed2bff-625e-556d-99a3-9b51f9d68937" :knowledge-point/title "Calculating the Inner Product of Two Vectors in a Vector Space of Polynomials"}] :question/id #uuid "d7217dd1-5e4d-5ecb-96a4-e4c7064f2f88" :question/math-academy-id "e-5543" :question/problem "Let $V=\\mathbb{R}_2[t]$ be the vector space of all polynomials of degree at most $2$, equipped with the inner product \n\n$$\n\\langle {x}(t), {y}(t) \\rangle = x(1)y(1) + x(2)y(2) + x(3)y(3).\n$$\n\n Find $\\langle \\mathbf{x}(t), \\mathbf{y}(t) \\rangle,$ if\n\n$$\n{x}(t) = 1-2t+3t^2,\n\t\\quad\n\t{y}(t) = t-t^2.\n$$" :question/worked-solution "Computing the inner product according to the definition, we get\n\n$$\n\\begin{aligned}⟨x(t),y(t)⟩ & =x(1)y(1)+x(2)y(2)+x(3)y(3) \\\\  & =2\\cdot 0+9\\cdot (-2)+22\\cdot (-6) \\\\  & =0-18-132 \\\\  & =-150.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186133494 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "4c553cb8-9f5c-5fa5-bc43-db7d7b64755f" :knowledge-point/title "Calculating the Inner Product of Two Vectors in a Vector Space of Continuous Functions"}] :question/id #uuid "007b171e-6587-5835-a59c-443b29c2b667" :question/math-academy-id "e-5544" :question/problem "Let $V=\\mathcal{C}\\left[0,2\\pi\\right],$ the vector space of all functions that are continuous on $\\left[0,2\\pi\\right].$ Find $\\langle \\sin t, \\cos t \\rangle$ if the inner product on $V$ is defined as\n\n$$\n\\langle x(t),y(t) \\rangle = \\displaystyle\\int_{0}^{2\\pi} x(t) y(t) \\, \\textrm{d}t.\n$$" :question/worked-solution "We need to evaluate\n\n$$\n\\langle \\sin t, \\cos t \\rangle  =  \\int_{0}^{2\\pi}\\sin{t} \\cos{t} \\,\\textrm{d}t.\n$$\n\nWe can evaluate this integral using the identity $\\sin2t =2\\sin t\\cos t,$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2\\pi }\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\,\\text{d}t & =\\frac{1}{2}{\\int }_{0}^{2\\pi }\\operatorname{sin}⁡2t\\,\\text{d}t \\\\  & =-\\frac{1}{4}\\operatorname{cos}⁡2t{|}_{0}^{2\\pi } \\\\  & =-\\frac{1}{4}(\\operatorname{cos}⁡4\\pi -\\operatorname{cos}⁡0) \\\\  & =-\\frac{1}{4}(1-1) \\\\  & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186333846 :knowledge-point/_questions [{:knowledge-point/id #uuid "e46fa568-0a40-5b36-a01f-20555db9b055" :knowledge-point/title "Calculating the Inner Product of Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "876caeb6-844e-5f64-967b-3f188764a19b" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186333848} {:answer/id #uuid "f27feb54-ef8a-5ed6-8b3b-8352bec9ece0" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186333849} {:answer/id #uuid "3d0ab54e-4f5d-55a4-a270-39c9bb71a323" :answer/type {:db/ident :answer.type/math} :answer/value "-26" :db/id #edb/ref 17592186333850} {:answer/id #uuid "7dcd4b7d-c278-5923-8dfc-e0021261bc88" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186333851} {:answer/id #uuid "10e2c2a7-ee1c-55e7-82a4-4aac63469036" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186333852}] :answer-field/correct {:answer/id #uuid "3d0ab54e-4f5d-55a4-a270-39c9bb71a323" :answer/type {:db/ident :answer.type/math} :answer/value "-26" :db/id #edb/ref 17592186333850} :answer-field/id #uuid "c87b02d9-f8f1-5ca8-87be-f5ecf40f2530" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186333847}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "cc8646fd-56c5-56a3-b836-0c35d2861c86" :question/math-academy-id "q-139971" :question/problem "An inner product on $V={R}^{3}$ is given by $⟨p,q⟩=2{p}_{1}{q}_{1}+2{p}_{2}{q}_{2}+3{p}_{3}{q}_{3}.$ Find $⟨p,q⟩$, if\n\n$$\np=[\\begin{aligned}1 \\\\ -3 \\\\ -4\\end{aligned}],\\,q=[\\begin{aligned}5 \\\\ 2 \\\\ 2\\end{aligned}].\n$$" :question/worked-solution "Computing the inner product according to the definition, we get\n\n$$\n\\begin{aligned}⟨p,q⟩ & =2{p}_{1}{q}_{1}+2{p}_{2}{q}_{2}+3{p}_{3}{q}_{3} \\\\  & =2\\cdot 1\\cdot 5+2\\cdot (-3)\\cdot 2+3\\cdot (-4)\\cdot 2 \\\\  & =10-12-24 \\\\  & =-26.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186333853 :knowledge-point/_questions [{:knowledge-point/id #uuid "efed2bff-625e-556d-99a3-9b51f9d68937" :knowledge-point/title "Calculating the Inner Product of Two Vectors in a Vector Space of Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ad07fa8-4f34-520b-8452-6672c6e5ef36" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186333855} {:answer/id #uuid "2f9471cf-e965-5024-abef-6f46df1aeeb7" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186333856} {:answer/id #uuid "40655672-f6bc-59a4-a990-123954407d25" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186333857} {:answer/id #uuid "1b1907a6-7df3-5256-8434-89ee4077ab3d" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186333858} {:answer/id #uuid "8c13f272-244a-557f-b6a0-54642be95f17" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186333859}] :answer-field/correct {:answer/id #uuid "1ad07fa8-4f34-520b-8452-6672c6e5ef36" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186333855} :answer-field/id #uuid "4df759ef-3c22-5464-b0d6-387cd0fc5d28" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186333854}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "de1f1b34-1c8d-52ca-95bd-35371ad09de9" :question/math-academy-id "q-139995" :question/problem "Let $V={R}_{2}[t]$ be the vector space of all polynomials of degree at most $2$, equipped with the inner product \n\n$$\n⟨x(t),y(t)⟩=x(1)y(1)+x(2)y(2)+x(3)y(3).\n$$\n\n Find $⟨x(t),y(t)⟩$, if\n\n$$\nx(t)={t}^{2}-2t-3,\\,y(t)={t}^{2}-1.\n$$" :question/worked-solution "Computing the inner product according to the definition, we get\n\n$$\n\\begin{aligned}⟨x(t),y(t)⟩ & =x(1)y(1)+x(2)y(2)+x(3)y(3) \\\\  & =-4\\cdot 0+(-3)\\cdot 3+0\\cdot 8 \\\\  & =0-9+0 \\\\  & =-9.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186333860 :knowledge-point/_questions [{:knowledge-point/id #uuid "efed2bff-625e-556d-99a3-9b51f9d68937" :knowledge-point/title "Calculating the Inner Product of Two Vectors in a Vector Space of Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89da18cf-0577-5466-b658-07d7ba369211" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186333862} {:answer/id #uuid "37903fd9-afaf-5791-9bee-7fbc177ccae1" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186333863} {:answer/id #uuid "1da3cb8e-daf9-55fa-a19c-601163be104e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186333864} {:answer/id #uuid "725c3a11-a2e0-5f15-bd74-c1390cccc290" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186333865} {:answer/id #uuid "37ff5c2d-e7b1-5bb1-82b8-52911db01de7" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186333866}] :answer-field/correct {:answer/id #uuid "37ff5c2d-e7b1-5bb1-82b8-52911db01de7" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186333866} :answer-field/id #uuid "5bcae02d-71e8-551c-a2c9-bc0369de5ad1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186333861}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e4b5e657-b208-5234-bf29-13d5bc2c6c08" :question/math-academy-id "q-139996" :question/problem "Let $V={R}_{2}[t]$ be the vector space of all polynomials of degree at most $2$, equipped with the inner product \n\n$$\n⟨x(t),y(t)⟩=x(-2)y(-2)+x(-1)y(-1)+x(0)y(0).\n$$\n\n Find $⟨x(t),y(t)⟩$, if\n\n$$\nx(t)={t}^{2}+3t+2,\\,y(t)=t-1.\n$$" :question/worked-solution "Computing the inner product according to the definition, we get\n\n$$\n\\begin{aligned}⟨x(t),y(t)⟩ & =x(-2)y(-2)+x(-1)y(-1)+x(0)y(0). \\\\  & =0\\cdot (-3)+0\\cdot (-2)+2\\cdot (-1) \\\\  & =0+0-2 \\\\  & =-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186333867 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c553cb8-9f5c-5fa5-bc43-db7d7b64755f" :knowledge-point/title "Calculating the Inner Product of Two Vectors in a Vector Space of Continuous Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b9f17853-f9e4-590c-be97-60602c224ce8" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186333869} {:answer/id #uuid "b126e052-2cea-5df6-960e-8edbb2a68f89" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186333870} {:answer/id #uuid "da300585-c499-58ee-8d8a-dc05ef4fe4b0" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186333871} {:answer/id #uuid "68171de2-88d3-505f-a12e-dacc0e7b9d7b" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186333872} {:answer/id #uuid "8356cbfc-eadd-57ca-81c7-a3d4eb37409c" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186333873}] :answer-field/correct {:answer/id #uuid "8356cbfc-eadd-57ca-81c7-a3d4eb37409c" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186333873} :answer-field/id #uuid "cbdcab7d-3226-56df-b9bf-d5cbbe4e6107" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186333868}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "459ccc68-d7d9-5cf4-b185-3c6efbba8e15" :question/math-academy-id "q-139997" :question/problem "Let $V=C[0,\\pi ],$ the vector space of all functions that are continuous on $[0,\\pi ].$ Find $⟨t,\\operatorname{cos}⁡t⟩$ if the inner product on $V$ is defined as\n\n$$\n⟨x(t),y(t)⟩={\\int }_{0}^{\\pi }x(t)y(t)\\,\\text{d}t.\n$$" :question/worked-solution "We need to evaluate\n\n$$\n⟨t,\\operatorname{cos}⁡t⟩={\\int }_{0}^{\\pi }t\\operatorname{cos}⁡t\\,\\text{d}t.\n$$\n\nLet's use integration by parts. We denote\n\n$$\n\\begin{aligned}u=t & ⟹ & {u}^{′}=1, \\\\ {v}^{′}=\\operatorname{cos}⁡t & ⟹ & v=\\int {v}^{′}\\,\\text{d}t=\\int \\operatorname{cos}⁡t\\,\\text{d}t=\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nNow, substituting into the formula for the integration by parts, we obtain \n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi }t\\operatorname{cos}⁡t\\,\\text{d}t & =uv{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}t \\\\  & =(t\\operatorname{sin}⁡t){|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }\\operatorname{sin}⁡t\\,\\text{d}t \\\\  & =(\\pi \\cdot \\operatorname{sin}⁡\\pi +0\\cdot \\operatorname{sin}⁡0)+\\operatorname{cos}⁡t{|}_{0}^{\\pi } \\\\  & =0+(\\operatorname{cos}⁡\\pi -\\operatorname{cos}⁡0) \\\\  & =-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186333874 :knowledge-point/_questions [{:knowledge-point/id #uuid "e46fa568-0a40-5b36-a01f-20555db9b055" :knowledge-point/title "Calculating the Inner Product of Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bc48db0-694e-52e2-837d-592b5370d0bb" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186333876} {:answer/id #uuid "e5386926-2c09-5ff6-b0b8-611d816a6bf5" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186333877} {:answer/id #uuid "ee36f845-8ec7-5521-a1e7-130005c7641e" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186333878} {:answer/id #uuid "76608cf4-6881-58e6-8d91-47988c7788bf" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186333879} {:answer/id #uuid "954ccd59-40d8-5fb1-a5c2-f9a1913112af" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186333880}] :answer-field/correct {:answer/id #uuid "954ccd59-40d8-5fb1-a5c2-f9a1913112af" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186333880} :answer-field/id #uuid "345f634f-45d5-50b4-89b4-7f5da78aad55" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186333875}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "208528fb-c9ee-5d0c-863a-2787b45ee26e" :question/math-academy-id "q-42240" :question/problem "An inner product on $V={R}^{3}$ is given by $⟨x,y⟩={x}_{1}{y}_{1}+{x}_{2}{y}_{2}+5{x}_{3}{y}_{3}.$ Find $⟨x,y⟩$, if\n\n$$\nx=[\\begin{aligned}-1 \\\\ -2 \\\\ 0\\end{aligned}],\\,y=[\\begin{aligned}2 \\\\ 0 \\\\ 1\\end{aligned}].\n$$" :question/worked-solution "Computing the inner product according to the definition, we get\n\n$$\n\\begin{aligned}⟨x,y⟩ & ={x}_{1}{y}_{1}+{x}_{2}{y}_{2}+5{x}_{3}{y}_{3} \\\\  & =(-1)\\cdot 2+(-2)\\cdot (0)+5\\cdot 0\\cdot 1 \\\\  & =-2+0+0 \\\\  & =-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186134306 :knowledge-point/_questions [{:knowledge-point/id #uuid "e46fa568-0a40-5b36-a01f-20555db9b055" :knowledge-point/title "Calculating the Inner Product of Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97694f59-7fe3-5365-a1cf-785a14149844" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186132279} {:answer/id #uuid "d7a64bc4-b71b-5a87-a7d2-a08c49f0fdaa" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186132280} {:answer/id #uuid "e80d8c55-f19e-5464-825d-2df656ce62a5" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186132281} {:answer/id #uuid "2582659f-fad9-52a0-a50c-7eefc9224ac0" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186132282} {:answer/id #uuid "5012543b-11ef-5095-8361-dcf6950cdf4a" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186132283}] :answer-field/correct {:answer/id #uuid "d7a64bc4-b71b-5a87-a7d2-a08c49f0fdaa" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186132280} :answer-field/id #uuid "5057cec3-ec1f-54d7-b30a-e70242e52388" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186132278}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f0a0476a-0d30-57c3-9399-be41486cbf3d" :question/math-academy-id "q-42248" :question/problem "An inner product on $V={R}^{3}$ is given by $⟨x,y⟩=2{x}_{1}{y}_{1}+{x}_{2}{y}_{2}+9{x}_{3}{y}_{3}.$ Find $⟨x,y⟩$, if\n\n$$\nx=[\\begin{aligned}1 \\\\ -2 \\\\ 1\\end{aligned}],\\,y=[\\begin{aligned}5 \\\\ 3 \\\\ 1\\end{aligned}].\n$$" :question/worked-solution "Computing the inner product according to the definition, we get\n\n$$\n\\begin{aligned}⟨x,y⟩ & =2{x}_{1}{y}_{1}+{x}_{2}{y}_{2}+9{x}_{3}{y}_{3} \\\\  & =2\\cdot 1\\cdot 5+(-2)\\cdot 3+9\\cdot 1\\cdot 1 \\\\  & =10-6+9 \\\\  & =13.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186294755 :knowledge-point/_questions [{:knowledge-point/id #uuid "efed2bff-625e-556d-99a3-9b51f9d68937" :knowledge-point/title "Calculating the Inner Product of Two Vectors in a Vector Space of Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d7d7a1c-b55d-5247-8e8e-97aef855613c" :answer/type {:db/ident :answer.type/math} :answer/value "94" :db/id #edb/ref 17592186294757} {:answer/id #uuid "230a6ae5-a766-55fd-a00f-515a025c7db1" :answer/type {:db/ident :answer.type/math} :answer/value "-92" :db/id #edb/ref 17592186294758} {:answer/id #uuid "89d67d74-aabd-51a3-9668-070d98580d28" :answer/type {:db/ident :answer.type/math} :answer/value "-61" :db/id #edb/ref 17592186294759} {:answer/id #uuid "f088c822-61b3-5df3-9c7a-15cabc3440af" :answer/type {:db/ident :answer.type/math} :answer/value "76" :db/id #edb/ref 17592186294760} {:answer/id #uuid "46686adf-d76e-5f52-971d-08083196b440" :answer/type {:db/ident :answer.type/math} :answer/value "84" :db/id #edb/ref 17592186294761}] :answer-field/correct {:answer/id #uuid "8d7d7a1c-b55d-5247-8e8e-97aef855613c" :answer/type {:db/ident :answer.type/math} :answer/value "94" :db/id #edb/ref 17592186294757} :answer-field/id #uuid "5e6601b8-d481-5613-bf42-250282037392" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294756}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6b166cbc-794d-58a9-965a-fda333434d5e" :question/math-academy-id "q-42249" :question/problem "Let $V={R}_{2}[t]$ be the vector space of all polynomials of degree at most $2$, equipped with the inner product\n\n$$\n⟨x(t),y(t)⟩=x(1)y(1)+x(2)y(2)+x(3)y(3).\n$$\n\nFind $⟨x(t),y(t)⟩$, if\n\n$$\nx(t)={t}^{2}-2,\\,y(t)={t}^{2}+t.\n$$" :question/worked-solution "Computing the inner product according to the definition, we get\n\n$$\n\\begin{aligned}⟨x(t),y(t)⟩ & =x(1)y(1)+x(2)y(2)+x(3)y(3) \\\\  & =(-1)\\cdot 2+2\\cdot 6+7\\cdot 12 \\\\  & =-2+12+84 \\\\  & =94.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186134307 :knowledge-point/_questions [{:knowledge-point/id #uuid "efed2bff-625e-556d-99a3-9b51f9d68937" :knowledge-point/title "Calculating the Inner Product of Two Vectors in a Vector Space of Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83c50a94-73c0-598a-af15-5966c595b5b6" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186132285} {:answer/id #uuid "f70c18a2-b752-555c-8c59-652e9ac566e8" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186132286} {:answer/id #uuid "1b8fd7c7-cc3c-5bd4-a208-5273d1f422af" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186132287} {:answer/id #uuid "38d8c0a5-6fe8-5152-b8d8-8ba80f4b9364" :answer/type {:db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186132288} {:answer/id #uuid "3cd34a9f-834b-54d7-9ece-af5f7ecceade" :answer/type {:db/ident :answer.type/math} :answer/value "t^{2} - t + 4" :db/id #edb/ref 17592186132289}] :answer-field/correct {:answer/id #uuid "38d8c0a5-6fe8-5152-b8d8-8ba80f4b9364" :answer/type {:db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186132288} :answer-field/id #uuid "928b063e-7d62-5848-8f4d-1dfc173f1e1a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186132284}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "26d059cc-b327-5568-bdbd-81c6e2f0a4fd" :question/math-academy-id "q-42250" :question/problem "Let $V={R}_{2}[t]$ be the vector space of all polynomials of degree at most $2$, equipped with the inner product\n\n$$\n⟨x(t),y(t)⟩=x(-1)y(-1)+x(0)y(0)+x(1)y(1).\n$$\n\n Find $⟨x(t),y(t)⟩$, if\n\n$$\nx(t)=5-2t+{t}^{2},\\,y(t)=t-1.\n$$" :question/worked-solution "Computing the inner product according to the definition, we get\n\n$$\n\\begin{aligned}⟨x(t),y(t)⟩ & =x(-1)y(-1)+x(0)y(0)+x(1)y(1) \\\\  & =8\\cdot (-2)+5\\cdot (-1)+4\\cdot 0 \\\\  & =-16-5+0 \\\\  & =-21.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186134309 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c553cb8-9f5c-5fa5-bc43-db7d7b64755f" :knowledge-point/title "Calculating the Inner Product of Two Vectors in a Vector Space of Continuous Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "919384a6-c759-599e-8b6c-8389c9b8abfb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186132297} {:answer/id #uuid "9d3da174-e4a0-544c-a905-368c53321fff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186132298} {:answer/id #uuid "a698f712-8a16-5d2b-80f2-b4f9d6cba994" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186132299} {:answer/id #uuid "d403c84c-21cd-5d05-9af1-9ec5b1049d40" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186132300} {:answer/id #uuid "407a2bd7-e0ba-5a80-8008-c73f26cac545" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186132301}] :answer-field/correct {:answer/id #uuid "919384a6-c759-599e-8b6c-8389c9b8abfb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186132297} :answer-field/id #uuid "64682202-ef61-58ad-96c3-91e2cdb82c77" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186132296}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "663f08e4-70a8-54d4-a465-2c24f8e60288" :question/math-academy-id "q-42254" :question/problem "Let $V=C[-\\frac{\\pi }{2},\\frac{\\pi }{2}],$ the vector space of all functions that are continuous on $[-\\frac{\\pi }{2},\\frac{\\pi }{2}].$ Find $⟨{sin}^{2}⁡t,\\operatorname{cos}⁡t⟩$ if the inner product on $V$ is defined as\n\n$$\n⟨x(t),y(t)⟩={\\int }_{-\\pi /2}^{\\pi /2}x(t)y(t)\\,\\text{d}t.\n$$" :question/worked-solution "We need to evaluate\n\n$$\n⟨{sin}^{2}⁡t,\\operatorname{cos}⁡t⟩={\\int }_{-\\pi /2}^{\\pi /2}{sin}^{2}⁡t\\operatorname{cos}⁡t\\,\\text{d}t.\n$$\n\nWe can evaluate this integral using the substitution $u=\\operatorname{sin}⁡t,$ $\\text{d}u=\\operatorname{cos}⁡t\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{-\\pi /2}^{\\pi /2}{sin}^{2}⁡t\\operatorname{cos}⁡t\\,\\text{d}t & ={\\int }_{-1}^{1}{u}^{2}\\,\\text{d}u \\\\  & ={\\frac{1}{3}{u}^{3}|}_{-1}^{1} \\\\  & =[\\frac{1}{3}(1)^{3}]-[\\frac{1}{3}(-1)^{3}] \\\\  & =\\frac{1}{3}+\\frac{1}{3} \\\\  & =\\frac{2}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186333881 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c553cb8-9f5c-5fa5-bc43-db7d7b64755f" :knowledge-point/title "Calculating the Inner Product of Two Vectors in a Vector Space of Continuous Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f4c97068-908a-5d68-a03d-6a6c3bc570d3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186333883} {:answer/id #uuid "cc7266f3-dbbe-58a8-b5b3-3adbd50fff03" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186333884} {:answer/id #uuid "732b6fe3-f810-581e-95f6-7e6d1fd4a414" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186333885} {:answer/id #uuid "373c8e9c-cd43-5cd4-9102-44bf90a376d9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{2}" :db/id #edb/ref 17592186333886} {:answer/id #uuid "faaf0265-6393-53f6-9e40-c4626a51666a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186333887}] :answer-field/correct {:answer/id #uuid "732b6fe3-f810-581e-95f6-7e6d1fd4a414" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186333885} :answer-field/id #uuid "06a3c639-92d1-557f-8db2-57d3ced9275b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186333882}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "3cc9ef9c-fc7a-5c00-b52f-1c2bdfbdac79" :question/math-academy-id "q-42255" :question/problem "Let $V=C[-\\frac{\\pi }{2},0],$ the vector space of all functions that are continuous on $[-\\frac{\\pi }{2},0].$ Find $⟨\\operatorname{sin}⁡t,{cos}^{2}⁡t⟩$ if the inner product on $V$ is defined as\n\n$$\n⟨x(t),y(t)⟩={\\int }_{-\\pi /2}^{0}x(t)y(t)\\,\\text{d}t.\n$$" :question/worked-solution "We need to evaluate\n\n$$\n⟨\\operatorname{sin}⁡t,{cos}^{2}⁡t⟩={\\int }_{-\\pi /2}^{0}\\operatorname{sin}⁡t{cos}^{2}⁡t\\,\\text{d}t.\n$$\n\nWe can evaluate this integral using the substitution $u=\\operatorname{cos}⁡t,$ $\\text{d}u=-\\operatorname{sin}⁡t\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{-\\pi /2}^{0}\\operatorname{sin}⁡t{cos}^{2}⁡t\\,\\text{d}t & =-{\\int }_{0}^{1}{u}^{2}\\,\\text{d}u \\\\  & =-\\frac{{u}^{3}}{3}{|}_{0}^{1} \\\\  & =[-\\frac{(1)^{3}}{3}]-[-\\frac{(0)^{3}}{3}] \\\\  & =-\\frac{1}{3}+0 \\\\  & =-\\frac{1}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186134310 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c553cb8-9f5c-5fa5-bc43-db7d7b64755f" :knowledge-point/title "Calculating the Inner Product of Two Vectors in a Vector Space of Continuous Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c4b0991-a25b-59a7-819a-5c7c645a1461" :answer/type {:db/ident :answer.type/math} :answer/value "e^{2} + 1" :db/id #edb/ref 17592186132303} {:answer/id #uuid "a353d221-9d5c-5e0b-acc0-ba41b1db7faf" :answer/type {:db/ident :answer.type/math} :answer/value "e^{t} - t + 1" :db/id #edb/ref 17592186132304} {:answer/id #uuid "ac521640-f469-5379-8688-a653d14ed1e9" :answer/type {:db/ident :answer.type/math} :answer/value "e^{2}" :db/id #edb/ref 17592186132305} {:answer/id #uuid "cc474b83-85ce-58d1-8e28-2d436e352b88" :answer/type {:db/ident :answer.type/math} :answer/value "e^{t} + 1" :db/id #edb/ref 17592186132306} {:answer/id #uuid "dc598f1c-c0d2-5424-9860-3cb239a015de" :answer/type {:db/ident :answer.type/math} :answer/value "e^{2} - 2" :db/id #edb/ref 17592186132307}] :answer-field/correct {:answer/id #uuid "9c4b0991-a25b-59a7-819a-5c7c645a1461" :answer/type {:db/ident :answer.type/math} :answer/value "e^{2} + 1" :db/id #edb/ref 17592186132303} :answer-field/id #uuid "895e43d9-9e72-54bf-a284-3526018432c1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186132302}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "71904bfc-c560-50f5-ac2b-41eb0a528292" :question/math-academy-id "q-42256" :question/problem "Let $V=C[0,2],$ the vector space of all functions that are continuous on $[0,2].$ Find $⟨t,{e}^{t}⟩$ if the inner product on $V$ is defined as\n\n$$\n⟨x(t),y(t)⟩={\\int }_{0}^{2}x(t)y(t)\\,\\text{d}t.\n$$" :question/worked-solution "We need to evaluate\n\n$$\n⟨t,{e}^{t}⟩={\\int }_{0}^{2}t{e}^{t}\\,\\text{d}t.\n$$\n\nLet's use integration by parts. We denote\n\n$$\n\\begin{aligned}u=t & ⟹ & {u}^{′}=1, \\\\ {v}^{′}={e}^{t} & ⟹ & v=\\int {v}^{′}\\,\\text{d}t=\\int {e}^{t}\\,\\text{d}t={e}^{t}.\\end{aligned}\n$$\n\nNow, substituting into the formula for the integration by parts, we obtain \n\n$$\n\\begin{aligned}{\\int }_{0}^{2}t{e}^{t}\\,\\text{d}t & =uv{|}_{0}^{2}-{\\int }_{0}^{2}v{u}^{′}\\,\\text{d}t \\\\  & =(t{e}^{t}){|}_{0}^{2}-{\\int }_{0}^{2}{e}^{t}\\,\\text{d}t \\\\  & =(2{e}^{2}-0{e}^{0})-{e}^{t}{|}_{0}^{2} \\\\  & =2{e}^{2}-({e}^{2}-1) \\\\  & ={e}^{2}+1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186333888 :knowledge-point/_questions [{:knowledge-point/id #uuid "e46fa568-0a40-5b36-a01f-20555db9b055" :knowledge-point/title "Calculating the Inner Product of Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "690331bd-423e-5006-9ec4-ed8b298a7bc7" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186333890} {:answer/id #uuid "4afbe345-4bba-5320-a2d0-973ca3e6a3b2" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186333891} {:answer/id #uuid "f2ae1312-e4e7-5744-aaae-6d76c5f518bc" :answer/type {:db/ident :answer.type/math} :answer/value "38" :db/id #edb/ref 17592186333892} {:answer/id #uuid "daddc389-7afd-5d4b-9968-3831b1ee1622" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186333893} {:answer/id #uuid "77f37e19-6c9e-5d05-a314-9f074e552bd7" :answer/type {:db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186333894}] :answer-field/correct {:answer/id #uuid "4afbe345-4bba-5320-a2d0-973ca3e6a3b2" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186333891} :answer-field/id #uuid "b35340ba-97ee-5cfc-b9c3-33efbcc6c70f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186333889}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "bcb58ecb-b3f5-5ed5-9033-1a92893dad2a" :question/math-academy-id "q-43814" :question/problem "An inner product on $V={R}^{3}$ is given by $⟨x,y⟩=6{x}_{1}{y}_{1}+6{x}_{2}{y}_{2}+{x}_{3}{y}_{3}.$ Find $⟨x,y⟩$, if\n\n$$\nx=[\\begin{aligned}1 \\\\ 3 \\\\ 4\\end{aligned}],\\,y=[\\begin{aligned}2 \\\\ 1 \\\\ -2\\end{aligned}].\n$$" :question/worked-solution "Computing the inner product according to the definition, we get\n\n$$\n\\begin{aligned}⟨x,y⟩ & =6{x}_{1}{y}_{1}+6{x}_{2}{y}_{2}+{x}_{3}{y}_{3} \\\\  & =6\\cdot 1\\cdot 2+6\\cdot 3\\cdot 1+4\\cdot (-2) \\\\  & =12+18-8 \\\\  & =22.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186333895 :knowledge-point/_questions [{:knowledge-point/id #uuid "efed2bff-625e-556d-99a3-9b51f9d68937" :knowledge-point/title "Calculating the Inner Product of Two Vectors in a Vector Space of Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e7df757-a1f9-57da-a070-9b68a4becab6" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186333897} {:answer/id #uuid "31db2f69-3114-508b-bcbb-dedfa7845096" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186333898} {:answer/id #uuid "5f7cf48d-5feb-5df8-8f83-c51822ca2c2c" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186333899} {:answer/id #uuid "3952e819-bab6-5a3b-b2f1-43a4ad1b3e3b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186333900} {:answer/id #uuid "c4a663cf-800b-5e1a-b5a6-d940494d7dde" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186333901}] :answer-field/correct {:answer/id #uuid "3952e819-bab6-5a3b-b2f1-43a4ad1b3e3b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186333900} :answer-field/id #uuid "4c18613b-422b-54da-80f2-3258e4f932db" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186333896}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "69eed8f6-c7de-5ae2-bbb9-21c428d14ef6" :question/math-academy-id "q-43815" :question/problem "Let $V={R}_{2}[t]$ be the vector space of all polynomials of degree at most $2$, equipped with the inner product \n\n$$\n⟨x(t),y(t)⟩=x(1)y(1)+x(2)y(2)+x(-2)y(-2).\n$$\n\n Find $⟨x(t),y(t)⟩$, if\n\n$$\nx(t)={t}^{2}-5,\\,y(t)={t}^{2}-3t.\n$$" :question/worked-solution "Computing the inner product according to the definition, we get\n\n$$\n\\begin{aligned}⟨x(t),y(t)⟩ & =x(1)y(1)+x(2)y(2)+x(-2)y(-2) \\\\  & =(-4)\\cdot (-2)+(-1)\\cdot (-2)+(-1)\\cdot 10 \\\\  & =8+2-10 \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186333902 :knowledge-point/_questions [{:knowledge-point/id #uuid "e46fa568-0a40-5b36-a01f-20555db9b055" :knowledge-point/title "Calculating the Inner Product of Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9fa243f7-2b07-5cd3-b8da-2702ef21bbfe" :answer/type {:db/ident :answer.type/math} :answer/value "-40" :db/id #edb/ref 17592186333904} {:answer/id #uuid "516a6d96-5190-593e-85eb-60fac1a02ff1" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186333905} {:answer/id #uuid "f0b860f9-e4e8-5426-b489-ea191cc3b0fd" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186333906} {:answer/id #uuid "90fa09f4-444f-5eb2-8b23-8f2f4f03d6fc" :answer/type {:db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186333907} {:answer/id #uuid "ba2290ad-fb72-5b16-aab1-6c019714fd47" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186333908}] :answer-field/correct {:answer/id #uuid "90fa09f4-444f-5eb2-8b23-8f2f4f03d6fc" :answer/type {:db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186333907} :answer-field/id #uuid "b0737e2b-60f5-5410-a59b-69d111176253" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186333903}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "630d06ec-4272-5f53-a01a-e3af1ddd0e6b" :question/math-academy-id "q-43816" :question/problem "An inner product on $V={R}^{3}$ is given by $⟨x,y⟩=2{x}_{1}{y}_{1}+5{x}_{2}{y}_{2}+7{x}_{3}{y}_{3}.$ Find $⟨x,y⟩$, if\n\n$$\nx=[\\begin{aligned}2 \\\\ 1 \\\\ -2\\end{aligned}],\\,y=[\\begin{aligned}3 \\\\ -3 \\\\ -2\\end{aligned}].\n$$" :question/worked-solution "Computing the inner product according to the definition, we get\n\n$$\n\\begin{aligned}⟨x,y⟩ & =2{x}_{1}{y}_{1}+5{x}_{2}{y}_{2}+7{x}_{3}{y}_{3} \\\\  & =2\\cdot 2\\cdot 3+5\\cdot 1\\cdot (-3)+7\\cdot (-2)\\cdot (-2) \\\\  & =12-15+28 \\\\  & =25.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186333909 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c553cb8-9f5c-5fa5-bc43-db7d7b64755f" :knowledge-point/title "Calculating the Inner Product of Two Vectors in a Vector Space of Continuous Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f0608d1-1377-5e74-b20a-1d527a336991" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186333911} {:answer/id #uuid "981d2a8a-95e3-5739-b087-202d0ce9df76" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186333912} {:answer/id #uuid "c6c1139d-f7ca-5f55-9439-ef5b8b46746d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{1-{t}^{2}}}{3}" :db/id #edb/ref 17592186333913} {:answer/id #uuid "fcee6a49-1328-5ab1-8e00-550ceca991fb" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186333914} {:answer/id #uuid "c4e3ee02-f048-5633-ae7b-1b136526bc54" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186333915}] :answer-field/correct {:answer/id #uuid "981d2a8a-95e3-5739-b087-202d0ce9df76" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186333912} :answer-field/id #uuid "4c6e170a-4c93-5b96-a7a8-d2fa5353391c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186333910}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "94de83fd-a553-50b8-b88f-58c41cefa36b" :question/math-academy-id "q-43855" :question/problem "Let $V=C[-1,0],$ the vector space of all functions that are continuous on $[-1,0].$ Find $⟨t,\\sqrt{1-{t}^{2}}⟩$ if the inner product on $V$ is defined as\n\n$$\n⟨x(t),y(t)⟩={\\int }_{-1}^{0}x(t)y(t)\\,\\text{d}t.\n$$" :question/worked-solution "We need to evaluate\n\n$$\n⟨t,\\sqrt{1-{t}^{2}}⟩={\\int }_{-1}^{0}t\\sqrt{1-{t}^{2}}\\,\\text{d}t.\n$$\n\nWe can evaluate this integral using the substitution $u=1-{t}^{2},$ $\\text{d}u=-2t\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{-1}^{0}t\\sqrt{1-{t}^{2}}\\,\\text{d}t & =-\\frac{1}{2}{\\int }_{0}^{1}\\sqrt{u}\\,\\text{d}u \\\\  & =-\\frac{1}{2}\\cdot \\frac{2}{3}{u}^{3/2}\\,{|}_{0}^{1} \\\\  & =-\\frac{1}{3}{u}^{3/2}\\,{|}_{0}^{1} \\\\  & =[-\\frac{1}{3}(1)^{3/2}]-[-\\frac{1}{3}(0)^{3/2}] \\\\  & =-\\frac{1}{3}\\end{aligned}\n$$"}]}
