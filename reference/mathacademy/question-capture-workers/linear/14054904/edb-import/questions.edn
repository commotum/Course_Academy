17592186294756}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6b166cbc-794d-58a9-965a-fda333434d5e" :question/math-academy-id "q-42249" :question/problem "Let $V={R}_{2}[t]$ be the vector space of all polynomials of degree at most $2$, equipped with the inner product\n\n$$\n⟨x(t),y(t)⟩=x(1)y(1)+x(2)y(2)+x(3)y(3).\n$$\n\nFind $⟨x(t),y(t)⟩$, if\n\n$$\nx(t)={t}^{2}-2,\\,y(t)={t}^{2}+t.\n$$" :question/worked-solution "Computing the inner product according to the definition, we get\n\n$$\n\\begin{aligned}⟨x(t),y(t)⟩ & =x(1)y(1)+x(2)y(2)+x(3)y(3) \\\\  & =(-1)\\cdot 2+2\\cdot 6+7\\cdot 12 \\\\  & =-2+12+84 \\\\  & =94.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186134307 :knowledge-point/_questions [{:knowledge-point/id #uuid "efed2bff-625e-556d-99a3-9b51f9d68937" :knowledge-point/title "Calculating the Inner Product of Two Vectors in a Vector Space of Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83c50a94-73c0-598a-af15-5966c595b5b6" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186132285} {:answer/id #uuid "f70c18a2-b752-555c-8c59-652e9ac566e8" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186132286} {:answer/id #uuid "1b8fd7c7-cc3c-5bd4-a208-5273d1f422af" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186132287} {:answer/id #uuid "38d8c0a5-6fe8-5152-b8d8-8ba80f4b9364" :answer/type {:db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186132288} {:answer/id #uuid "3cd34a9f-834b-54d7-9ece-af5f7ecceade" :answer/type {:db/ident :answer.type/math} :answer/value "t^{2} - t + 4" :db/id #edb/ref 17592186132289}] :answer-field/correct {:answer/id #uuid "38d8c0a5-6fe8-5152-b8d8-8ba80f4b9364" :answer/type {:db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186132288} :answer-field/id #uuid "928b063e-7d62-5848-8f4d-1dfc173f1e1a" :an