[{:db/id [:question/math-academy-id "q-42248"] :question/problem "An inner product on $V={R}^{3}$ is given by $⟨x,y⟩=2{x}_{1}{y}_{1}+{x}_{2}{y}_{2}+9{x}_{3}{y}_{3}.$ Find $⟨x,y⟩$, if\n\n$$\nx=[\\begin{aligned}1 \\\\ -2 \\\\ 1\\end{aligned}],\\,y=[\\begin{aligned}5 \\\\ 3 \\\\ 1\\end{aligned}].\n$$" :question/worked-solution "Computing the inner product according to the definition, we get\n\n$$\n\\begin{aligned}⟨x,y⟩ & =2{x}_{1}{y}_{1}+{x}_{2}{y}_{2}+9{x}_{3}{y}_{3} \\\\  & =2\\cdot 1\\cdot 5+(-2)\\cdot 3+9\\cdot 1\\cdot 1 \\\\  & =10-6+9 \\\\  & =13.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-43816/selection/a84d639d380e10cb74c92005685f9f65779377dfb51342c280c63c645679bbea" :answer/id #uuid "90fa09f4-444f-5eb2-8b23-8f2f4f03d6fc" :answer/type :answer.type/math :answer/value "25" :db/ensure [:answer/validate]} {:db/id "q-43816/selection/286fb92e9ba180b012d241bb7e762701483c9c864420d9df6597147f2e2fb458" :answer/id #uuid "516a6d96-5190-593e-85eb-60fac1a02ff1" :answer/type :answer.type/math :answer/value "28" :db/ensure [:answer/validate]} {:db/id "q-43816/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45" :answer/id #uuid "ba2290ad-fb72-5b16-aab1-6c019714fd47" :answer/type :answer.type/math :answer/value "-12" :db/ensure [:answer/validate]} {:db/id "q-43816/selection/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" :answer/id #uuid "f0b860f9-e4e8-5426-b489-ea191cc3b0fd" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "q-43816/selection/008b962e8dba6a793a19582d7b90d25ecc915fb39cdb8821fa797599cabe57ab" :answer/id #uuid "9fa243f7-2b07-5cd3-b8da-2702ef21bbfe" :answer/type :answer.type/math :answer/value "-40" :db/ensure [:answer/validate]} {:db/id "q-43816/selection" :answer-field/id #uuid "b0737e2b-60f5-5410-a59b-69d111176253" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-438