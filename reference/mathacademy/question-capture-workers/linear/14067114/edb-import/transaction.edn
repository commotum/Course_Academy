1}+4{c}_{2}-2{c}_{3} & \\,⟹\\,[T({b}_{1})]_{C}=[\\begin{aligned}-2 \\\\ 4 \\\\ -2\\end{aligned}] \\\\ T({b}_{2})=3{c}_{2}-7{c}_{3}+{c}_{1} & \\,⟹\\,[T({b}_{2})]_{C}=[\\begin{aligned}1 \\\\ 3 \\\\ -7\\end{aligned}]\\end{aligned}\n$$\n\nNow, $[T]_{B|C}$ is the matrix whose columns are the coordinates of the vectors $T({b}_{1})$ and  $T({b}_{2})$ relative to the basis $C:$\n\n$$\n[T]_{B|C}=[\\begin{aligned}-2 & 1 \\\\ 4 & 3 \\\\ -2 & -7\\end{aligned}]\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-38529/selection/ma-v1/417cbf9f9a9dcdf5a71199dce321b88b02158dc95f97c2da2fca6c31a769252d"] :db/ensure [:question/validate]} [:db/retract 17592186125044 :question/answer-fields 17592186123286] {:db/id "q-38530/selection/ma-v1/399476c63490a1635317a2edec2f4249e39877e6f2373240baf341fcd4d26fe5/c2b82a17ebe97b38c20166e9bf097f138a2a11cd70daf705ab29093b5e04b4d3" :answer/id #uuid "b5e00d25-2820-5ef9-9572-a2e5d8114083" :answer/type :answer.type/math :answer/value "[T]_{B|C}=[\\begin{aligned}6 & -5 \\\\ 4 & 7 \\\\ 0 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-38530/selection/ma-v1/399476c63490a1635317a2edec2f4249e39877e6f2373240baf341fcd4d26fe5/cbbb11b0ef7d9690d9f71bd1de9ce9280f2c8512f822489e1fdbe45687317005" :answer/id #uuid "93988b8f-89b8-5b98-a50f-84edbcd95e1f" :answer/type :answer.type/math :answer/value "[T]_{B|C}=[\\begin{aligned}7 & -2 & -5 \\\\ 4 & 0 & 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-38530/selection/ma-v1/399476c63490a1635317a2edec2f4249e39877e6f2373240baf341fcd4d26fe5/41caf81c236255f6ddc728113b54654563a61d39badabde78dfbe12602a1ae9d" :answer/id #uuid "3bb78148-c648-5271-8c63-41205da64cae" :answer/type :answer.type/math :answer/value "[T]_{B|C}=[\\begin{aligned}6 & 4 & 0 \\\\ -5 & 7 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-38530/selection/ma-v1/399476c63490a1635317a2edec2f4249e39877e6f2373240baf341fcd4d26fe5/7733dcf9b249d34f82e3cc8078e5285f4baf5a2942e272e584c43442b4ac81db" :answer/i