mbda )\\end{aligned}]=[\\begin{aligned}1 & 6 \\\\ -6 & 1\\end{aligned}]\\ne C,\n$$\n\nwhile\n\n$$\n[\\begin{aligned}\\text{Re}(\\overset{―}{\\lambda }) & \\text{Im}(\\overset{―}{\\lambda }) \\\\ -\\text{Im}(\\overset{―}{\\lambda }) & \\text{Re}(\\overset{―}{\\lambda })\\end{aligned}]=[\\begin{aligned}1 & -6 \\\\ 6 & 1\\end{aligned}]=C.\n$$\n\nSo, our rotation-scaling matrix $C$ corresponds to the eigenvalue $\\overset{―}{\\lambda }=1-6\\text{i},$ \n the complex conjugate of $\\lambda .$ Hence, to construct the matrix $P,$ we use the eigenvector $\\overset{―}{v},$ the complex conjugate of $v.$\n\nNext, we find the real and imaginary parts of our eigenvector:\n\n$$\n\\begin{aligned}\\overset{―}{v} & =[\\begin{aligned}\\text{i} \\\\ 2-3\\text{i}\\end{aligned}]={{[\\begin{aligned}0 \\\\ 2\\end{aligned}]}_{⏟}}_{\\text{Re}(\\overset{―}{v})}+\\text{i}{{[\\begin{aligned}1 \\\\ -3\\end{aligned}]}_{⏟}}_{\\text{Im}(\\overset{―}{v})}\\end{aligned}\n$$\n\nFinally, we can now construct $P:$ \n\n$$\n\\begin{aligned}P & =[\\begin{aligned}| & | \\\\ \\text{Re}(\\overset{―}{v}) & \\text{Im}(\\overset{―}{v}) \\\\ | & |\\end{aligned}]=[\\begin{aligned}0 & 1 \\\\ 2 & -3\\end{aligned}].\\end{aligned}\n$$" 13194139536068 true] [17592186382058 1017 #edb/ref 17592186382059 13194139536068 true] [17592186382058 1089 "q-140498" 13194139536068 true] [17592186382058 1091 #edb/ref 17592186045465 13194139536068 true] [17592186382058 1100 "$$\nv=[\\begin{aligned}2\\text{i}-1 \\\\ \\text{i}+2\\end{aligned}],\\,C=[\\begin{aligned}2 & -3 \\\\ 3 & 2\\end{aligned}]\n$$\n\nConsider the vector $v$ and the rotation-scaling matrix $C$ shown above. Given that $v$ is an eigenvector of a $2\\times 2$ matrix $A$ corresponding to the eigenvalue $\\lambda =2+3\\text{i},$ find a matrix $P$ such that $A=PC{P}^{-1}.$" 13194139536068 true] [17592186382058 1113 #uuid "1a9407fa-0156-51d0-868b-a6bb68a8909c" 13194139536068 true] [17592186382058 1145 "Recall that for any $2\\times 2$ real matrix $A$ with complex eigenvalues, we have $A=PC{P}^{-1},$ where \n\n$$\nP=[\\begin{aligned}| & | \\\\ \\text{Re}(v) & \\text{Im}(v) \\\\ | & |\\end{aligned}],\\,C=[\\begin{aligned}\\text{Re}(\\lambda ) & \\text{Im}(\\lambda ) \\\\ -\\text{Im}(\\lambda ) & \\text{Re}(\\lambda )\\end{aligned}],\n$$\n\nand $v$ is an eigenvector of $A$ corresponding to the complex eigenvalue  $\\lambda .$\n\nFirst, notice that \n\n$$\n[\\begin{aligned}\\text{Re}(\\lambda ) & \\text{Im}(\\lambda ) \\\\ -\\text{Im}(\\lambda ) & \\text{Re}(\\lambda )\\end{aligned}]=[\\begin{aligned}2 & 3 \\\\ -3 & 2\\end{aligned}]\\ne C,\n$$\n\nwhile\n\n$$\n[\\begin{aligned}\\text{Re}(\\overset{―}{\\lambda }) & \\text{Im}(\\overset{―}{\\lambda }) \\\\ -\\text{Im}(\\overset{―}{\\lambda }) & \\text{Re}(\\overset{―}{\\lambda })\\end{aligned}]=[\\begin{aligned}2 & -3 \\\\ 3 & 2\\end{aligned}]=C.\n$$\n\nSo, our rotation-scaling matrix $C$ corresponds to the eigenvalue $\\overset{―}{\\lambda }=2-3\\text{i},$ \n the complex conjugate of $\\lambda .$ Hence, to construct the matrix $P,$ we use the eigenvector $\\overset{―}{v},$ the complex conjugate of $v.$\n\nNext, we find the real and imaginary parts of our eigenvector:\n\n$$\n\\begin{aligned}\\overset{―}{v} & =[\\begin{aligned}-1-2\\text{i} \\\\ 2-\\text{i}\\end{aligned}]={{[\\begin{aligned}-1 \\\\ 2\\end{aligned}]}_{⏟}}_{\\text{Re}(\\overset{―}{v})}+\\text{i}{{[\\begin{aligned}-2 \\\\ -1\\end{aligned}]}_{⏟}}_{\\text{Im}(\\overset{―}{v})}\\end{aligned}\n$$\n\nFinally, we can now construct $P:$ \n\n$$\n\\begin{aligned}P & =[\\begin{aligned}| & | \\\\ \\text{Re}(\\overset{―}{v}) & \\text{Im}(\\overset{―}{v}) \\\\ | & |\\end{aligned}]=[\\begin{aligned}-1 & -2 \\\\ 2 & -1\\end{aligned}].\\end{aligned}\n$$" 13194139536068 true] [17592186382059 1000 #edb/ref 17592186382060 13194139536068 true] [17592186382059 1000 #edb/ref 17592186382061 13194139536068 true] [17592186382059 1000 #edb/ref 17592186382062 13194139536068 true] [17592186382059 1000 #edb/ref 17592186382063 13194139536068 true] [17592186