igned}1 & 0 & 1 \\\\ 0 & 2 & -3 \\\\ 7 & 18 & -19\\end{aligned}] & {R}_{3} & :={R}_{3}+(-7){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 \\\\ 0 & 2 & -3 \\\\ 0 & 18 & -26\\end{aligned}] & {R}_{3} & :={R}_{3}+(-9){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 \\\\ 0 & 2 & -3 \\\\ 0 & 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, ${u}_{33}=1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-106963/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c159d750-ab1f-538b-b8cc-ae66ef1ae414"] :knowledge-point/questions ["q-106963"] :db/ensure [:knowledge-point/validate]} {:db/id "q-106960/selection/d8bb7c27ace5469b6ebaea147aa6ab08ecfa8eda07c29bea54a3851f7a667634" :answer/id #uuid "2943b15a-484f-5cda-a6cf-271a6f937827" :answer/type :answer.type/math :answer/value "0,\\,5,\\,9" :db/ensure [:answer/validate]} {:db/id "q-106960/selection/4aabc1a90b1c1ba66519c33d6a1d7091f8bd6c30e9eba9db4f27f1708e34306d" :answer/id #uuid "6845d3a5-c14d-5902-b763-7be6cdaf976c" :answer/type :answer.type/math :answer/value "0,\\,3,\\,2" :db/ensure [:answer/validate]} {:db/id "q-106960/selection/7589e6da6c904c8411a6c68b21800ab78532b2fcfdc789eac0d701902fe49e1d" :answer/id #uuid "a167a1b5-eefa-5e8f-ae8d-2ef55ac61851" :answer/type :answer.type/math :answer/value "0,\\,11,\\,9" :db/ensure [:answer/validate]} {:db/id "q-106960/selection/8979e9a0b3d052e6b6ce3d49a36f2c1aa15262165c5dd68c4584e1e14fee9f07" :answer/id #uuid "73b07bd4-d32c-557a-960d-f2b492a60500" :answer/type :answer.type/math :answer/value "0,\\,5,\\,2" :db/ensure [:answer/validate]} {:db/id "q-106960/selection/c9acb2693b69c02c5d975a7b54361a3809345a0bfbc6b65396ac0711a4998bf8" :answer/id #uuid "09cdd341-e94a-537b-ae31-7023fcc8b4a8" :answer/type :answer.type/math :answer/value "0,\\,3,\\,9" :db/ensure [:answer/validate]} {:db/id "q-106960/selection" :answer-field/id #uuid "8d8b114c-aec3-567e-bbc2-2d881254d285" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :