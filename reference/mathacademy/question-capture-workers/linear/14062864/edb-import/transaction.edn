& 0 \\\\ -1 & 1 & 0 \\\\ -3 & 1 & 1\\end{aligned}],\\,U=[\\begin{aligned}2 & 3 & 4 \\\\ 0 & 11 & 16 \\\\ 0 & 0 & -8\\end{aligned}].\n$$\n\nFinally, since ${l}_{31}=-3$ and ${u}_{22}=11,$ we get\n\n$$\n{l}_{31}\\cdot {u}_{22}=(-3)\\cdot 11=-33.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-105887/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e28bd3d9-649d-5cc3-a12e-e1f821caaf24"] :knowledge-point/questions ["q-105887"] :db/ensure [:knowledge-point/validate]} {:db/id "q-32789/selection/e326a281f601aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666" :answer/id #uuid "3986a43c-e06b-557a-b677-dca9741a8319" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "q-32789/selection/aa4e4239377eb61b8bdf37e9f4374abeb3a1fdeaaf409dc6e37519ad01509799" :answer/id #uuid "a6b0c353-6a18-5ebe-a90f-64fa9cbcfddf" :answer/type :answer.type/math :answer/value "-27" :db/ensure [:answer/validate]} {:db/id "q-32789/selection/aa57a8d17f569b619e62bd602a6af7cff5d106888256da51f23b5b66e6987fe8" :answer/id #uuid "5a8c9518-bd36-59f8-bde2-277280b632a5" :answer/type :answer.type/math :answer/value "-26" :db/ensure [:answer/validate]} {:db/id "q-32789/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "96ec2f53-3be9-5931-a612-2f1beadfed1a" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-32789/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "855394de-a106-57da-a2a5-2e0642f8d913" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-32789/selection" :answer-field/id #uuid "17cd55f9-5857-5dce-8eb9-985dbaaa814b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-32789/selection/e326a281f601aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666" :answer-field/choices ["q-32789/selection/e