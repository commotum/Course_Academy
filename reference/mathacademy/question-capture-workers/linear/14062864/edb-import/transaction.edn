_{32}=-2$ and ${u}_{34}=-9,$ we get\n\n$$\n{l}_{32}\\cdot {u}_{34}=(-2)\\cdot (-9)=18.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-32789/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a86c24c2-97c2-534e-9c03-9735b031bb23"] :knowledge-point/questions ["q-32789"] :db/ensure [:knowledge-point/validate]} {:db/id "q-107065/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "8130554d-3388-590a-a322-5841d9b71c21" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-107065/selection/b556bb502f914dc4fab0f40312f13f23b29e033ef49212306202180f04718e6f" :answer/id #uuid "8efb8ad1-0cdb-54c3-9ec6-64ddf25de59c" :answer/type :answer.type/math :answer/value "-22" :db/ensure [:answer/validate]} {:db/id "q-107065/selection/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c" :answer/id #uuid "564bc5a2-4397-5225-8d47-d50e7fa69631" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "q-107065/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "eb234ef0-06d1-5dfa-9e78-a00f7c2c5bd8" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-107065/selection/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce" :answer/id #uuid "de5bfd46-7036-59e6-9d96-12bb6c1ba9e1" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "q-107065/selection" :answer-field/id #uuid "42b67fcd-52f8-5ea6-8b14-440d474607be" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-107065/selection/b556bb502f914dc4fab0f40312f13f23b29e033ef49212306202180f04718e6f" :answer-field/choices ["q-107065/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-107065/selection/b556bb502f914dc4fab0f40312f13f23b29e033ef49212306202180f04718e6f" "q-107