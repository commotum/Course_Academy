#{[{:db/id #edb/ref 17592186356870 :knowledge-point/_questions [{:knowledge-point/id #uuid "82e761b5-ec1c-549d-b726-e0909cfe460b" :knowledge-point/title "Finding the Intersection Point of a Line in Parametric Form and a Plane in Cartesian Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42068190-cf84-57fe-bbaf-140c2463d46e" :answer/type {:db/ident :answer.type/math} :answer/value "(20,29,40)" :db/id #edb/ref 17592186356872} {:answer/id #uuid "527a7770-d5f8-5a3d-8f3c-9ed5af2d3a60" :answer/type {:db/ident :answer.type/math} :answer/value "(-6,-23,-25)" :db/id #edb/ref 17592186356873} {:answer/id #uuid "f5d807c9-264d-511a-9190-73c4168381a9" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-7,-5)" :db/id #edb/ref 17592186356874} {:answer/id #uuid "66f3bab9-e5a6-5f04-94ae-e823f168663e" :answer/type {:db/ident :answer.type/text} :answer/value "No intersection" :db/id #edb/ref 17592186356875} {:answer/id #uuid "7e39da6c-a7b5-5af6-b99d-edf48043b61e" :answer/type {:db/ident :answer.type/math} :answer/value "(10,9,15)" :db/id #edb/ref 17592186356876}] :answer-field/correct {:answer/id #uuid "7e39da6c-a7b5-5af6-b99d-edf48043b61e" :answer/type {:db/ident :answer.type/math} :answer/value "(10,9,15)" :db/id #edb/ref 17592186356876} :answer-field/id #uuid "85b5821d-cbb8-5c03-9816-ea997524331b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186356871}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3ee9813a-b1b3-5ef0-86f7-ac30b2000775" :question/math-academy-id "q-108368" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:{\\begin{aligned}x=4+2t \\\\ y=-3+4t \\\\ z=5t\\end{aligned}\\,\\text{and}\\,Π:3x+2y-z=33.\n$$" :question/worked-solution "We can substitute the parametric expressions for $x,$ $y,$ and $z$ of the line into the equation of the plane immediately:\n\n$$\n\\begin{aligned}3x+2y-z & =33 \\\\ 3(4+2t)+2(-3+4t)-(5t) & =33 \\\\ 12+6t-6+8t-5t & =33 \\\\ 9t & =27 \\\\ t & =3\\end{aligned}\n$$\n\nTo get the position vector $p$ of the intersection point $P$, we substitute $t=3$ into the parametric equations of the line:\n\n$$\n{\\begin{aligned}x=4+2(3)=10 \\\\ y=-3+4(3)=9 \\\\ z=5(3)=15\\end{aligned}\n$$\n\nSo, the intersection point is $P(10,9,15).$"}] [{:db/id #edb/ref 17592186356877 :knowledge-point/_questions [{:knowledge-point/id #uuid "caf29808-4551-56a0-ac86-a4587a06fc0f" :knowledge-point/title "Finding the Intersection Point of a Line and a Plane Given in Other Forms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79a653c8-b4aa-594e-99f5-7bdd4b9ec4c0" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,0,1)" :db/id #edb/ref 17592186356879} {:answer/id #uuid "b37cdbe3-b6af-5b8b-8187-a7041d20b8b8" :answer/type {:db/ident :answer.type/math} :answer/value "(1,4,-1)" :db/id #edb/ref 17592186356880} {:answer/id #uuid "6d2a8077-a027-5fd7-8c52-7fa90052e334" :answer/type {:db/ident :answer.type/math} :answer/value "(5,4,-3)" :db/id #edb/ref 17592186356881} {:answer/id #uuid "a9d396de-d5f4-5ba4-a270-d0a28f1f0cae" :answer/type {:db/ident :answer.type/math} :answer/value "(4,8,-3)" :db/id #edb/ref 17592186356882} {:answer/id #uuid "800ecb37-1966-513c-b261-63d50c33f347" :answer/type {:db/ident :answer.type/text} :answer/value "No intersection" :db/id #edb/ref 17592186356883}] :answer-field/correct {:answer/id #uuid "b37cdbe3-b6af-5b8b-8187-a7041d20b8b8" :answer/type {:db/ident :answer.type/math} :answer/value "(1,4,-1)" :db/id #edb/ref 17592186356880} :answer-field/id #uuid "a62b7884-84dc-538a-9bba-dca997f72e34" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186356878}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "51708de4-81da-5999-acf1-9c92facc1391" :question/math-academy-id "q-108891" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:\\frac{x+2}{3}=\\frac{y}{4}=\\frac{1-z}{2},\\,Π:r\\cdot ⟨4,-3,1⟩=-9.\n$$" :question/worked-solution "From the equation of the line $l$, we know that it passes through the point $A(-2,0,1)$ and it is parallel to the vector $v=⟨3,4,-2⟩.$ Therefore, its vector equation is given by\n\n$$\n\\begin{aligned}r & =⟨-2,0,1⟩+t⟨3,4,-2⟩ \\\\  & =⟨-2+3t,4t,1-2t⟩,\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nNow, substituting $r=⟨-2+3t,4t,1-2t⟩$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨4,-3,1⟩ & =-9 \\\\ ⟨-2+3t,4t,1-2t⟩\\cdot ⟨4,-3,1⟩ & =-9 \\\\ 4(-2+3t)-3(4t)+(1-2t) & =-9 \\\\ -8+12t-12t+1-2t & =-9 \\\\ -2t & =-2 \\\\ t & =1.\\end{aligned}\n$$\n\nFinally, to get the position vector $p$ of the intersection point $P,$ we substitute $t=1$ into the equation of the line:\n\n$$\n\\begin{aligned}p & =⟨-2+3(1),4(1),1-2(1)⟩ \\\\  & =⟨1,4,-1⟩.\\end{aligned}\n$$\n\nSo, we get $P(1,4,-1).$"}] [{:db/id #edb/ref 17592186120222 :knowledge-point/_questions [{:knowledge-point/id #uuid "82e761b5-ec1c-549d-b726-e0909cfe460b" :knowledge-point/title "Finding the Intersection Point of a Line in Parametric Form and a Plane in Cartesian Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4a4aa12-ec57-528d-a613-68082ac3a5a1" :answer/type {:db/ident :answer.type/text} :answer/value "No intersection" :db/id #edb/ref 17592186117833} {:answer/id #uuid "3b881aca-0a05-5a49-a7a3-77e6ccf04ebb" :answer/type {:db/ident :answer.type/math} :answer/value "(-13, 16, 15)" :db/id #edb/ref 17592186117834} {:answer/id #uuid "4d9bf5b6-802f-523f-a98b-5115f58eafeb" :answer/type {:db/ident :answer.type/math} :answer/value "(2, 5, 8)" :db/id #edb/ref 17592186117835} {:answer/id #uuid "688465f7-dccc-5d6f-aa9b-b0c31524a882" :answer/type {:db/ident :answer.type/math} :answer/value "(13, 15, 16)" :db/id #edb/ref 17592186117836} {:answer/id #uuid "780ca9da-990f-5722-83a9-930d355d6bf8" :answer/type {:db/ident :answer.type/math} :answer/value "(15,-13, 16)" :db/id #edb/ref 17592186117837}] :answer-field/correct {:answer/id #uuid "688465f7-dccc-5d6f-aa9b-b0c31524a882" :answer/type {:db/ident :answer.type/math} :answer/value "(13, 15, 16)" :db/id #edb/ref 17592186117836} :answer-field/id #uuid "555053cd-a695-5603-8467-a93fdb5b0629" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117832}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "aeb82fb0-8960-53a5-b9a1-90d3db98fe43" :question/math-academy-id "q-33986" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:{\\begin{aligned}x=4+3t \\\\ y=3+4t \\\\ z=-2+6t\\end{aligned}\\,\\text{and}\\,Π:2x+5y+8z=229.\n$$" :question/worked-solution "We can substitute the parametric expressions for $x,$ $y,$ and $z$ of the line into the equation of the plane immediately:\n\n$$\n\\begin{aligned}2x+5y+8z & =229 \\\\ 2(4+3t)+5(3+4t)+8(-2+6t) & =229 \\\\ 8+6t+15+20t-16+48t & =229 \\\\ 74t & =222 \\\\ t & =3\\end{aligned}\n$$\n\nTo get the position vector $p$ of the intersection point $P$, we substitute $t=3$ into the parametric equations of the line:\n\n$$\n{\\begin{aligned}x=4+3(3)=13 \\\\ y=3+4(3)=15 \\\\ z=-2+6(3)=16\\end{aligned}\n$$\n\nSo, the intersection point is $P(13,15,16).$"}] [{:db/id #edb/ref 17592186356884 :knowledge-point/_questions [{:knowledge-point/id #uuid "caf29808-4551-56a0-ac86-a4587a06fc0f" :knowledge-point/title "Finding the Intersection Point of a Line and a Plane Given in Other Forms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e9a8717a-e212-55ad-8b4a-a5d2b7477ad8" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,4,2)" :db/id #edb/ref 17592186356886} {:answer/id #uuid "442f8d07-d442-5966-af16-0a1adb12fbc4" :answer/type {:db/ident :answer.type/math} :answer/value "(9,5,3)" :db/id #edb/ref 17592186356887} {:answer/id #uuid "c9e93674-08ab-5156-a97c-e6b26e2d1934" :answer/type {:db/ident :answer.type/math} :answer/value "(3,5,9)" :db/id #edb/ref 17592186356888} {:answer/id #uuid "49066f88-8216-564b-a1d2-7cdc03998fea" :answer/type {:db/ident :answer.type/math} :answer/value "(4,-1,6)" :db/id #edb/ref 17592186356889} {:answer/id #uuid "46499e9f-2421-5073-8b5f-8a92d43805eb" :answer/type {:db/ident :answer.type/text} :answer/value "No intersection" :db/id #edb/ref 17592186356890}] :answer-field/correct {:answer/id #uuid "46499e9f-2421-5073-8b5f-8a92d43805eb" :answer/type {:db/ident :answer.type/text} :answer/value "No intersection" :db/id #edb/ref 17592186356890} :answer-field/id #uuid "2fb6d432-3990-5462-9174-0583dac17339" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186356885}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "cbfd2820-3a30-53a2-832d-407032fe3cf1" :question/math-academy-id "q-33987" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:r=⟨3,5,9⟩+t⟨4,-1,6⟩,\\,Π:-2x+4y+2z-16=0.\n$$" :question/worked-solution "Let's start by writing the equation of the line as\n\n$$\nr=⟨3+4t,5-t,9+6t⟩.\n$$\n\nLet's also write the equation of the plane in the dot product form:\n\n$$\n\\begin{aligned}-2x+4y+2z-16 & =0 \\\\ -2x+4y+2z & =16 \\\\ ⟨x,y,z⟩\\cdot ⟨-2,4,2⟩ & =16 \\\\ r\\cdot ⟨-2,4,2⟩ & =16\\end{aligned}\n$$\n\nNow, substituting $r=⟨3+4t,5-t,9+6t⟩$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨-2,4,2⟩ & =16 \\\\ ⟨3+4t,5-t,9+6t⟩\\cdot ⟨-2,4,2⟩ & =16 \\\\ -2(3+4t)+4(5-t)+2(9+6t) & =16 \\\\ -6-8t+20-4t+18+12t & =16 \\\\ 32 & =16.\\end{aligned}\n$$\n\nThe equation has no solution. Therefore, we conclude that the line $l$ and the plane $Π$ do not intersect."}] [{:db/id #edb/ref 17592186120223 :knowledge-point/_questions [{:knowledge-point/id #uuid "82e761b5-ec1c-549d-b726-e0909cfe460b" :knowledge-point/title "Finding the Intersection Point of a Line in Parametric Form and a Plane in Cartesian Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8977164a-8ad7-56e9-94a7-d1231f0c5ade" :answer/type {:db/ident :answer.type/math} :answer/value "(-9, 9, 7)" :db/id #edb/ref 17592186117839} {:answer/id #uuid "fd122388-c8df-5ba9-8c16-8ce6fa095bc2" :answer/type {:db/ident :answer.type/math} :answer/value "(5,-1, 3)" :db/id #edb/ref 17592186117840} {:answer/id #uuid "46f916f3-3853-57e9-ba4e-59cb01cf50fe" :answer/type {:db/ident :answer.type/math} :answer/value "(9,-9, 7)" :db/id #edb/ref 17592186117841} {:answer/id #uuid "670f3c35-0bae-5d98-a7f7-406e9c05c9eb" :answer/type {:db/ident :answer.type/math} :answer/value "(9, 7,-9)" :db/id #edb/ref 17592186117842} {:answer/id #uuid "6812f233-b49b-50e7-80f8-912186dc94d2" :answer/type {:db/ident :answer.type/text} :answer/value "No intersection" :db/id #edb/ref 17592186117843}] :answer-field/correct {:answer/id #uuid "46f916f3-3853-57e9-ba4e-59cb01cf50fe" :answer/type {:db/ident :answer.type/math} :answer/value "(9,-9, 7)" :db/id #edb/ref 17592186117841} :answer-field/id #uuid "8efee06f-3bfd-5143-ad04-c2e4495511e7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117838}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c755ffbb-8374-5c52-a967-a6387ef6da9c" :question/math-academy-id "q-33992" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:{\\begin{aligned}x=5-2t \\\\ y=-1+4t \\\\ z=-3-5t\\end{aligned}\\,\\text{and}\\,Π:2x-5y+3z-84=0.\n$$" :question/worked-solution "We can substitute the parametric expressions for $x,$ $y,$ and $z$ of the line into the equation of the plane immediately:\n\n$$\n\\begin{aligned}2x-5y+3z-84 & =0 \\\\ 2(5-2t)-5(-1+4t)+3(-3-5t) & =84 \\\\ 10-4t+5-20t-9-15t & =84 \\\\ -39t & =78 \\\\ t & =-2\\end{aligned}\n$$\n\nTo get the position vector $p$ of the intersection point $P$, we substitute $t=-2$ into the parametric equations of the line:\n\n$$\n{\\begin{aligned}x=5-2(-2)=9 \\\\ y=-1+4(-2)=-9 \\\\ z=-3-5(-2)=7\\end{aligned}\n$$\n\nSo, the intersection point is  $P(9,-9,7).$"}]}
