t{i})\\overset{―}{k}\\end{aligned}]\\end{aligned}\n$$\n\nSo, we obtain the system\n\n$$\n{\\begin{aligned}4\\overset{―}{k}=-20+28\\text{i} \\\\ (-5+\\text{i})\\overset{―}{k}=18-40\\text{i}.\\end{aligned}\n$$\n\nFrom the first equation, we get\n\n$$\n\\overset{―}{k}=-5+7\\text{i}\n$$\n\nSubstituting this into the second equation, we obtain the true statement\n\n$$\n(-5+\\text{i})(-5+7\\text{i})=18-40\\text{i}\n$$\n\nTherefore, $k=\\overset{―}{-5+7\\text{i}}=-5-7\\text{i}.$\n\nFinally, $\\text{Re}(k)=-5.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-130894/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3eaed693-68df-5da8-942d-408d6871358a"] :knowledge-point/questions ["q-130894"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130893/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "e69c8bcd-2fad-58b8-b682-8ab26abf8eaf" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-130893/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "7bc4f20f-a7d4-5a88-9e81-ebeb1010d6ab" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-130893/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "a48050f4-91ad-5d08-8b56-bff5e769d8c8" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-130893/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "a9976bdc-ebac-51b2-9cf7-bf42027ee299" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-130893/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "3f995f06-2886-51c5-8b9e-c30b48b4d81b" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-130893/selection" :answer-field/id #uuid "b79