ate]} {:db/id "q-82077" :question/id #uuid "b6bfb7ac-3794-5dd9-860a-433b1e53b12c" :question/math-academy-id "q-82077" :question/problem "Find $\\text{Im}(k)$ given that \n$v=[\\begin{aligned}-2\\text{i} \\\\ 0\\end{aligned}]$\nand\n$\\overset{―}{kv}=[\\begin{aligned}4\\text{i}-12 \\\\ 0\\end{aligned}].$" :question/worked-solution "Since $\\overset{―}{kv}=\\overset{―}{k}\\,\\overset{―}{v},$ we get the following equation:\n\n$$\n\\begin{aligned}\\overset{―}{kv} & =\\overset{―}{k}\\,\\overset{―}{v} \\\\ [\\begin{aligned}4\\text{i}-12 \\\\ 0\\end{aligned}] & =\\overset{―}{k}\\,\\overset{―}{[\\begin{aligned}-2\\text{i} \\\\ 0\\end{aligned}]} \\\\ [\\begin{aligned}4\\text{i}-12 \\\\ 0\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}\\overset{―}{-2\\text{i}} \\\\ \\overset{―}{0}\\end{aligned}] \\\\ [\\begin{aligned}4\\text{i}-12 \\\\ 0\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}2\\text{i} \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}4\\text{i}-12 \\\\ 0\\end{aligned}] & =[\\begin{aligned}2\\text{i}\\,\\overset{―}{k} \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nSo, we obtain that \n\n$$\n2\\text{i}\\,\\overset{―}{k}=4\\text{i}-12\\,⟹\\,\\overset{―}{k}=\\frac{4\\text{i}-12}{2\\text{i}}=2+6\\text{i}.\n$$\n\n \n\nTherefore, $k=\\overset{―}{2+6\\text{i}}=2-6\\text{i}.$\n\nFinally, $\\text{Im}(k)=-6.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-82077/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3eaed693-68df-5da8-942d-408d6871358a"] :knowledge-point/questions ["q-82077"] :db/ensure [:knowledge-point/validate]} {:db/id "q-82034/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "3d4abbaa-fa95-5684-b7c0-35bc90a7f929" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-82034/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "e6ffb90f-6e0a-5d23-b993-e0008ad07f7d" :answer/type :a