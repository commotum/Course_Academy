"q-76053"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-38388"] :question/problem "If $\\,\\text{Re}(x)=[\\begin{aligned}a \\\\ b\\end{aligned}]\\,$ and $\\,\\text{Im}(x)=[\\begin{aligned}c \\\\ d\\end{aligned}]\\,$ are the real and imaginary parts of the vector $\\,x=[\\begin{aligned}2+4\\text{i} \\\\ 5-2\\text{i}\\end{aligned}]\\,$ then what is the value of $ad+bc?$" :question/worked-solution "For the given vector $\\,x=[\\begin{aligned}2+4\\text{i} \\\\ 5-2\\text{i}\\end{aligned}]\\,$ we have that\n\n$$\n\\begin{aligned}x & =[\\begin{aligned}2+4\\text{i} \\\\ 5-2\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}2 \\\\ 5\\end{aligned}]}_{⏟}}_{\\text{Re}(x)}+\\text{i}{{[\\begin{aligned}4 \\\\ -2\\end{aligned}]}_{⏟}}_{\\text{Im}(x)}.\\end{aligned}\n$$\n\nTherefore $\\,a=2,b=5,c=4$ and $d=-2$, which implies that \n\n$$\nad+bc=2\\cdot (-2)+5\\cdot 4=16.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-130894/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "4c472f45-4815-5427-ba1f-d20ee4856748" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-130894/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "28bd076f-0625-5b80-ab0a-437a83339ff6" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-130894/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "b0ca16cc-a1de-51ab-9634-ebce60d2e6b3" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-130894/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "f09e9b58-9de6-5320-89b8-a58bfdb47824" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-130894/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe