bb1ae52e12e6109729b3098d3990ab53ac" "q-77546/selection/bbe1e5ffd4927cbcdae9b78c04ac7681a4b3e049c7111df7646f4a2ded4f1e6d"] :db/ensure [:answer-field/validate]} {:db/id "q-77546" :question/id #uuid "a34ce566-d765-59b4-b453-cb1921569c8b" :question/math-academy-id "q-77546" :question/problem "If $\\,x=[\\begin{aligned}7-8\\text{i} \\\\ 6\\end{aligned}]\\,$ then $\\,\\overset{―}{x}=$" :question/worked-solution "To find the complex conjugate of a vector, we take the complex conjugate of the entries of the vector. So, we have\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\overset{―}{[\\begin{aligned}7-8\\text{i} \\\\ 6\\end{aligned}]} \\\\  & =[\\begin{aligned}\\overset{―}{7-8\\text{i}} \\\\ \\overset{―}{6}\\end{aligned}] \\\\  & =[\\begin{aligned}7+8\\text{i} \\\\ 6\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-77546/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2b677c92-5390-5cd1-b1d3-b84d180c2b3e"] :knowledge-point/questions ["q-77546"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-38387"] :question/problem "Given the vectors ${x}_{1}=[\\begin{aligned}1+\\text{i} \\\\ 2+2\\text{i}\\end{aligned}]$ and ${x}_{2}=[\\begin{aligned}2-4\\text{i} \\\\ 2+3\\text{i}\\end{aligned}]$, then ${\\overset{―}{x}}_{1}+\\text{i}\\cdot {x}_{2}=$" :question/worked-solution "To find the complex conjugate of a vector, we take the complex conjugate of the entries of the vector. So, we have\n\n$$\n\\begin{aligned}{\\overset{―}{x}}_{1} & =\\overset{―}{[\\begin{aligned}1+\\text{i} \\\\ 2+2\\text{i}\\end{aligned}]} \\\\  & =[\\begin{aligned}\\overset{―}{1+\\text{i}} \\\\ \\overset{―}{2+2\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}1-\\text{i} \\\\ 2-2\\text{i}\\end{aligned}].\\end{aligned}\n$$\n\nMultiplying the second vector, we get\n\n$$\n\\begin{aligned}\\text{i}\\cdot {x}_{2} & =\\text{i}\\cdot [\\begin{aligned}2-4\\text{i} \\\\ 2+3\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}2\\text{i}-4{\\text{i}}^{2} \\\\ 2\\text{i}+3{\\text{i}}^{2}\\end{aligned}] \\\\  & =[\\begin{aligned}4+2\\text{i} \\\\ -3+2\\text{i}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{\\overset{―}{x}}_{1}+\\text{i}\\cdot {x}_{2} & =[\\begin{aligned}1-\\text{i} \\\\ 2-2\\text{i}\\end{aligned}]+[\\begin{aligned}4+2\\text{i} \\\\ -3+2\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}5+\\text{i} \\\\ -1\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-76039/selection/3fc3e45cb198ddfe41ed5c53b1a6b568f5231c558fb7dbdc7d68f0ec119ff20e" :answer/id #uuid "d271ec7b-25d5-5634-bff1-4522194bc878" :answer/type :answer.type/math :answer/value "[\\begin{aligned}6+9\\text{i} \\\\ 3+9\\text{i} \\\\ -3\\text{i}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-76039/selection/208cf14e1f419045d9856585fb15164621d31b42df9747dc05539a2a19f109f0" :answer/id #uuid "6b1ccfe2-5149-5296-910c-5891c834dd3b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-9+6\\text{i} \\\\ -9+3\\text{i} \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-76039/selection/f1ecebd2687bf1e7a2ca1034252f73798704fc5a63211a137b0ef9ebe1789511" :answer/id #uuid "129a1cd3-fad5-5439-b92d-52344ec5d010" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-9-6\\text{i} \\\\ -9-3\\text{i} \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-76039/selection/f1119d8189e7bf7b05d28eda982f3c8b63625b1d094e1a6f368d8f00344ddc71" :answer/id #uuid "1e9beca8-bf24-5244-bcf2-3ec9628f3732" :answer/type :answer.type/math :answer/value "[\\begin{aligned}9+6\\text{i} \\\\ 9+3\\text{i} \\\\ -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-76039/selection/e2b139805e7bff05512ec5a29734387c8dc1abcbe3dc8f3e09d537fb66b8c285" :answer/id #uuid "5abca682-36e9-5d81-8a32-03a5f7696bde" :answer/type :answer.type/math :answer/value "[\\begin{aligned}6-9\\text{i} \\\\