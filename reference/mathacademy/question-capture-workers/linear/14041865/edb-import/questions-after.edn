begin{aligned}\\overset{―}{7-8\\text{i}} \\\\ \\overset{―}{6}\\end{aligned}] \\\\  & =[\\begin{aligned}7+8\\text{i} \\\\ 6\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186324026 :knowledge-point/_questions [{:knowledge-point/id #uuid "3eaed693-68df-5da8-942d-408d6871358a" :knowledge-point/title "Finding the Real or Imaginary Part of a Scalar Given the Conjugate of a Scaled Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e6ffb90f-6e0a-5d23-b993-e0008ad07f7d" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186324028} {:answer/id #uuid "3d4abbaa-fa95-5684-b7c0-35bc90a7f929" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186324029} {:answer/id #uuid "5a9941ca-b1d5-5e16-b82d-709b3f7c86fe" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186324030} {:answer/id #uuid "4035a6f8-9c2f-52f7-92be-24aa8a1aeef2" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186324031} {:answer/id #uuid "c16f20c3-5a73-528b-a8de-c3bc30d66782" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186324032}] :answer-field/correct {:answer/id #uuid "4035a6f8-9c2f-52f7-92be-24aa8a1aeef2" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186324031} :answer-field/id #uuid "5d029c77-2d78-5c95-bf94-f4ea7057e0f2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324027}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "095c99b8-e6ef-5b03-87e7-b89e96b42b60" :question/math-academy-id "q-82034" :question/problem "Find $\\text{Re}(k)$ given that\n$v=[\\begin{aligned}-4+8\\text{i} \\\\ 4\\end{aligned}]$\nand\n$\\overset{―}{kv}=[\\begin{aligned}20 \\\\ -4+8\\text{i}\\end{aligned}].$" :question/worked-solution "Since $\\overset{―}{kv}=\\overset{―}{k}\\,\\overset{―}{v},$ we get the following equation:\n\n$$\n\\begin{aligned}\\overset{―}{kv} & =\\overset{―}{k}\\,\\overset{―}{v} \\\\ [\\begin{aligned}20 \\\\ -4+8\\text{i}\\end{aligned}] & =\\overset{―}{k}\\,\\overset{―}{[\\begin{aligned}-4+8\\text{i} \\\\ 4\\end{aligned}]} \\\\ [\\begin{aligned}20 \\\\ -4+8\\text{i}\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}\\overset{―}{-4+8\\text{i}} \\\\ \\overset{―}{4}\\end{aligned}] \\\\ [\\begin{aligned}20 \\\\ -4+8\\text{i}\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}-4-8\\text{i} \\\\ 4\\end{aligned}] \\\\ [\\begin{aligned}20 \\\\ -4+8\\text{i}\\end{aligned}] & =[\\begin{aligned}(-4-8\\text{i})\\overset{―}{k} \\\\ 4\\overset{―}{k}\\end{aligned}]\\end{aligned}\n$$\n\nSo, we obtain the system\n\n$$\n{\\begin{aligned}(-4-8\\text{i})\\overset{―}{k}=20 \\\\ 4\\overset{―}{k}=-4+8\\text{i}.\\end{aligned}\n$$\n\nFrom the second equation, we get \n\n$$\n\\overset{―}{k}=-1+2\\text{i}.\n$$\n\nSubstituting this into the first equation, we obtain the true statement\n\n$$\n(-4-8\\text{i})(-1+2\\text{i})=20.\n$$\n\nTherefore, $k=\\overset{―}{-1+2\\text{i}}=-1-2\\text{i}.$\n\nFinally, $\\text{Re}(k)=-1.$"}] [{:db/id #edb/ref 17592186324033 :knowledge-point/_questions [{:knowledge-point/id #uuid "3eaed693-68df-5da8-942d-408d6871358a" :knowledge-point/title "Finding the Real or Imaginary Part of a Scalar Given the Conjugate of a Scaled Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a992d9e-7ddd-571d-8153-1792e803cea1" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186324035} {:answer/id #uuid "4b7a9821-6486-5487-8d68-f22c49b7135f" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186324036} {:answer/id #uuid "f86a741d-0853-570f-8fc2-ef812ed63cfd" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186324037} {:answer/id #uuid "d5ae6018-5efc-526f-a7c4-4c9f42d46bd1" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186324038} {:answer/id #uuid "16ffafe3-eb6b-5642-8253-3ef78dd8ab7a" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186324039}] :answer-field/correct {:answer/id #uuid "16ffafe3-eb6b-5642-8253-3ef78dd8ab7a" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186324039} :answer-field/id #uuid "84f5c7db-7e4b-5978-8fa1-53e521fbd362" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324034}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b6bfb7ac-3794-5dd9-860a-433b1e53b12c" :question/math-academy-id "q-82077" :question/problem "Find $\\text{Im}(k)$ given that \n$v=[\\begin{aligned}-2\\text{i} \\\\ 0\\end{aligned}]$\nand\n$\\overset{―}{kv}=[\\begin{aligned}4\\text{i}-12 \\\\ 0\\end{aligned}].$" :question/worked-solution "Since $\\overset{―}{kv}=\\overset{―}{k}\\,\\overset{―}{v},$ we get the following equation:\n\n$$\n\\begin{aligned}\\overset{―}{kv} & =\\overset{―}{k}\\,\\overset{―}{v} \\\\ [\\begin{aligned}4\\text{i}-12 \\\\ 0\\end{aligned}] & =\\overset{―}{k}\\,\\overset{―}{[\\begin{aligned}-2\\text{i} \\\\ 0\\end{aligned}]} \\\\ [\\begin{aligned}4\\text{i}-12 \\\\ 0\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}\\overset{―}{-2\\text{i}} \\\\ \\overset{―}{0}\\end{aligned}] \\\\ [\\begin{aligned}4\\text{i}-12 \\\\ 0\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}2\\text{i} \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}4\\text{i}-12 \\\\ 0\\end{aligned}] & =[\\begin{aligned}2\\text{i}\\,\\overset{―}{k} \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nSo, we obtain that \n\n$$\n2\\text{i}\\,\\overset{―}{k}=4\\text{i}-12\\,⟹\\,\\overset{―}{k}=\\frac{4\\text{i}-12}{2\\text{i}}=2+6\\text{i}.\n$$\n\n \n\nTherefore, $k=\\overset{―}{2+6\\text{i}}=2-6\\text{i}.$\n\nFinally, $\\text{Im}(k)=-6.$"}]}
