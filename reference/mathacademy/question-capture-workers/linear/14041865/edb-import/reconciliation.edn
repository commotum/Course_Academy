7\\text{i} \\\\ 5-2\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}-3 \\\\ 5\\end{aligned}]}_{⏟}}_{\\text{Re}(x)}+\\text{i}\\,{{[\\begin{aligned}7 \\\\ -2\\end{aligned}]}_{⏟}}_{\\text{Im}(x)}.\\end{aligned}\n$$\n\nTherefore $a=-3, b=5, c=7$ and $d=-2,$ which implies that\n\n$$\nab+cd=(-3) \\cdot 5 + 7 \\cdot (-2) = -29.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041865/example-6560.json" "file_sha256" "f8ec08868c2fc7d65d96b7b60fff2dcb4d2079f5890907b31c35aaaf0ca4c704"} {"question" "e-7345" "field" nil "attribute" "question/problem" "value" "Find $\\textrm{Im}(k)$ given that \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041865/assets/c51689b9c3a6e7c0e16e5121c725d9400b377ceab8f955bba851c2686991365b.png)\nand\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041865/assets/1dbce6fee97471e3eb80d3ad5791f70311d6304f7a4d75fac77160e5ad9bee09.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041865/example-7345.json" "file_sha256" "9bdacf852e90fc6d990eb01fc7d446694c93372c72f166e292506d111d2bc630"} {"question" "e-7345" "field" nil "attribute" "question/worked-solution" "value" "Since $\\overline{k\\mathbf{v}} = \\overline{k} \\, \\overline{\\mathbf{v}},$ we get the following equation:\n\n$$\n\\begin{aligned}\\overset{―}{kv} & =\\overset{―}{k}\\,\\overset{―}{v} \\\\ [\\begin{aligned}8\\text{i}-12 \\\\ 0\\end{aligned}] & =\\overset{―}{k}\\,\\overset{―}{[\\begin{aligned}-4\\text{i} \\\\ 0\\end{aligned}]} \\\\ [\\begin{aligned}8\\text{i}-12 \\\\ 0\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}\\overset{―}{-4\\text{i}} \\\\ \\overset{―}{0}\\end{aligned}] \\\\ [\\begin{aligned}8\\text{i}-12 \\\\ 0\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}4\\text{i} \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}8\\text{i}-12 \\\\ 0\\end{aligned}] & =[\\begin{aligned}4\\text{i}\\,\\overset{―}{k} \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nSo, we obtain that \n\n$$\n4\\textrm{i}\\,\\overline{k}  = 8\\textrm{i}-12\n\\qquad\\Longrightarrow\\qquad\n\\overline{k}=\\dfrac{8\\textrm{i}-12}{4\\textrm i} = 2+3\\textrm{i}.\n$$\n\n \n\nTherefore, $k=\\overline{2+3\\textrm{i}}=2-3\\textrm{i}.$\n\nFinally, $\\textrm{Im}(k)=-3.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041865/example-7345.json" "file_sha256" "9bdacf852e90fc6d990eb01fc7d446694c93372c72f166e292506d111d2bc630"}] "usage" {"e-7345" [] "q-38388" [] "q-38387" [] "e-6559" [] "e-6560" []} "basis" 1661 "retractions" [[17592186152512 :question/problem "Given the vectors $x_{1} = \\begin{bmatrix}1 + \\textrm{i} \\\\ 2 + 2\\textrm{i}\\end{bmatrix}$ and $x_{2} = \\begin{bmatrix}2 - 4\\textrm{i} \\\\ 2 + 3\\textrm{i}\\end{bmatrix}$, then $x^(―)_{1} + \\textrm{i} \\cdot x_{2} =$"] [17592186152513 :question/problem "If $Re(x) = \\begin{bmatrix}a \\\\ b\\end{bmatrix}$ and $Im(x) = \\begin{bmatrix}c \\\\ d\\end{bmatrix}$ are the real and imaginary parts of the vector $x = \\begin{bmatrix}2 + 4\\textrm{i} \\\\ 5 - 2\\textrm{i}\\end{bmatrix}$ then what is the value of $ad + bc$?"] [17592186151883 :question/problem "If $\\begin{bmatrix}-2 + 5\\textrm{i} \\\\ 5 - 9\\textrm{i} \\\\ -7 + 8\\textrm{i}\\end{bmatrix}$ find $\\,\\overline{\\mathbf{x}}$."] [17592186151883 :question/worked-solution "To find the complex conjugate of a vector, we take the complex conjugate of the entries of the vector. So, we have\n\n$$\n\\begin{aligned}\nx^(―) &= \\begin{bmatrix}-2 + 5\\textrm{i} \\\\ 5 - 9\\textrm{i} \\\\ -7 + 8\\textrm{i}\\end{bmatrix}^(―) \\\\\n&= \\begin{bmatrix}-2 + 5\\textrm{i}^(―) \\\\ 5 - 9\\textrm{i}^(―) \\\\ -7 + 8\\textrm{i}^(―)\\end{bmatrix} \\\\\n&= \\begin{bmatrix}-2 - 5\\textrm{i} \\\\ 5 + 9\\textrm{i} \\\\ -7 - 8\\textrm{i}\\end{bmatrix}\n\\end{aligned}\n$$"] [17592186151884 :question/problem "If $\\begin{bmatrix}a \\\\ b\\end{bmatrix}$ and $\\begin{bmatrix}c \\\\ d\\end{bmatrix}$ are the real and imaginary parts of the vector $\\begin{bmatrix}-3 + 7\\textrm{i} \\\\ 5 - 2\\textrm{i}\\end{bmatrix}$ what is the value of $ab+cd$?"] [17592186151884 :question/worked-solution "For the given vector $\\begin{bmatrix}-3 + 7\\textrm{i} \\\\ 5 - 2\\textrm{i}\\end{bmatrix}$ we have that\n\n$$\n\\begin{aligned}\nx &= \\begin{bmatrix}-3 + 7\\textrm{i} \\\\ 5 - 2\\textrm{i}\\end{bmatrix} \\\\\n&= \\begin{bmatrix}-3 \\\\ 5\\end{bmatrix}_(⏟)_(Re(x)) + \\textrm{i}\\begin{bmatrix}7 \\\\ -2\\end{bmatrix}_(⏟)_(Im(x))\n\\end{aligned}\n$$\n\nTherefore\n\n$$\na=-3, b=5, c=7\n$$\n\nand $d=-2$, which implies that\n\n$$\nab+cd=(-3) \\cdot 5 + 7 \\cdot (-2) = -29\n$$"] [17592186151943 :question/problem "Find $\\textrm{Im}(k)$ given that\n$\\begin{bmatrix}-4\\textrm{i} \\\\ 0\\end{bmatrix}$\nand\n$\\begin{bmatrix}8\\textrm{i} - 12 \\\\ 0\\end{bmatrix}$"] [17592186151943 :question/worked-solution "Since\n\n$$\n\\overline{k\\mathbf{v}} = \\overline{k} \\, \\overline{\\mathbf{v}}\n$$\n\nwe get the following equation:\n\n$$\n\\begin{aligned}\nkv^(―) &= k^(―)v^(―) \\\\\n\\begin{bmatrix}8\\textrm{i} - 12 \\\\ 0\\end{bmatrix} &= k^(―)\\begin{bmatrix}-4\\textrm{i} \\\\ 0\\end{bmatrix}^(―) \\\\\n\\begin{bmatrix}8\\textrm{i} - 12 \\\\ 0\\end{bmatrix} &= k^(―)\\begin{bmatrix}-4\\textrm{i}^(―) \\\\ 0^(―)\\end{bmatrix} \\\\\n\\begin{bmatrix}8\\textrm{i} - 12 \\\\ 0\\end{bmatrix} &= k^(―)\\begin{bmatrix}4\\textrm{i} \\\\ 0\\end{bmatrix} \\\\\n\\begin{bmatrix}8\\textrm{i} - 12 \\\\ 0\\end{bmatrix} &= \\begin{bmatrix}4\\textrm{i}k^(―) \\\\ 0\\end{bmatrix}\n\\end{aligned}\n$$\n\nSo, we obtain that\n\n$$\n4\\textrm{i}\\,\\overline{k} = 8\\textrm{i}-12 \\qquad\\Longrightarrow\\qquad \\overline{k}=\\dfrac{8\\textrm{i}-12}{4\\textrm i} = 2+3\\textrm{i}\n$$\n\nTherefore,\n\n$$\nk=\\overline{2+3\\textrm{i}}=2-3\\textrm{i}\n$$\n\nFinally,\n\n$$\n\\textrm{Im}(k)=-3\n$$"]] "imm