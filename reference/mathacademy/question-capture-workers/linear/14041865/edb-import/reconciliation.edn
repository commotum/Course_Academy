\\text{i}} \\\\ \\overset{―}{5\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}4-3\\text{i} \\\\ 2+2\\text{i} \\\\ -5\\text{i}\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041865/state.json" "file_sha256" "a9302120e50a88bb29d91cba43d547f5184d2c95789086b343ed6ba943c592d7"} {"question" "q-76044" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041865/activity-metadata.json" "file_sha256" "f4b86640334b0f49f7977fb59639aabb6d7aff9789dae17642a4e607e693d252"} {"question" "q-76044" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041865/state.json" "file_sha256" "a9302120e50a88bb29d91cba43d547f5184d2c95789086b343ed6ba943c592d7"} {"question" "q-76044" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-3+4\\text{i} \\\\ -2+2\\text{i} \\\\ 5\\end{aligned}]"] ["math" "[\\begin{aligned}-4+3\\text{i} \\\\ -2-2\\text{i} \\\\ -5\\text{i}\\end{aligned}]"] ["math" "[\\begin{aligned}-4-3\\text{i} \\\\ -2+2\\text{i} \\\\ -5\\text{i}\\end{aligned}]"] ["math" "[\\begin{aligned}3-4\\text{i} \\\\ 2+2\\text{i} \\\\ -5\\end{aligned}]"] ["math" "[\\begin{aligned}4-3\\text{i} \\\\ 2+2\\text{i} \\\\ -5\\text{i}\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041865/state.json" "file_sha256" "a9302120e50a88bb29d91cba43d547f5184d2c95789086b343ed6ba943c592d7"} {"question" "q-76044" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}4-3\\text{i} \\\\ 2+2\\text{i} \\\\ -5\\text{i}\\end{al