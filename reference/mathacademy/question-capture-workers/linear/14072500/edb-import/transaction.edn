2 & 2\\end{aligned}][\\begin{aligned}3 & 2 \\\\ 2 & 1\\end{aligned}][\\begin{aligned}2 & 2 \\\\ 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}8 & 5 \\\\ 10 & 6\\end{aligned}][\\begin{aligned}2 & 2 \\\\ 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}21 & 26 \\\\ 26 & 32\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-94182/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "331cb610-6168-5161-b821-237c713dedaa"] :knowledge-point/questions ["q-94182"] :db/ensure [:knowledge-point/validate]} {:db/id "q-94183/selection/b215271ff25701f1cc09006c618f21e6d87f7c0c13f4fee23e6ebbe177b58275" :answer/id #uuid "7b003303-3562-52f2-a40e-491ed273eaa4" :answer/type :answer.type/math :answer/value "[\\begin{aligned}27 & 20 \\\\ 20 & 9\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-94183/selection/9c468aaa3467cf7cada24ceb58b666a3b5917752f30de88b03c6c4fc68ab2c6c" :answer/id #uuid "2c1d776a-5292-5fba-8ef7-b081cb8ff082" :answer/type :answer.type/math :answer/value "[\\begin{aligned}5 & 6 \\\\ 6 & 9\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-94183/selection/0c35aacc556f5f260ee4b2bbd5540f3c1c3e97e293d865eeaeebfe6f8a58acae" :answer/id #uuid "30c2ab12-6b74-570d-bc81-d699ba963f40" :answer/type :answer.type/math :answer/value "[\\begin{aligned}27 & 15 \\\\ 15 & 10\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-94183/selection/9d88dabe67456866f9d90b77c6803a1db16a7f23f59ca4c787c36bfebcfd81d2" :answer/id #uuid "e8df4f73-746d-5651-97bc-7dee7f8fc7b2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}12 & 20 \\\\ 20 & 11\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-94183/selection/be8ecea906f2b3eb72a1f04ffd358298242e046fb036b3c3e90632c29b02c4d3" :answer/id #uuid "2ee424b9-7a3e-5f0a-bbd0-cac781ee1f6e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}47 & 30 \\\\ 30 & 19\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-94183