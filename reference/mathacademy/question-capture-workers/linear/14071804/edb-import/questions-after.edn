#{[{:db/id #edb/ref 17592186373098 :knowledge-point/_questions [{:knowledge-point/id #uuid "004c4177-ca0e-586c-962a-1220b4b64f47" :knowledge-point/title "Finding the Dimension of a Span Using Row Reduction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d029549d-0445-5999-b1a0-35fa06566c10" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186373100} {:answer/id #uuid "4a78461e-6132-529a-8257-feea5fe0d7db" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186373101} {:answer/id #uuid "635b25db-38a7-5d46-9e2b-b2fd7545a4dc" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186373102} {:answer/id #uuid "b67ca563-1392-50c4-9383-ab70f47853b6" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186373103} {:answer/id #uuid "8aca29e5-0541-5481-9bdc-5b79cec7b633" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186373104}] :answer-field/correct {:answer/id #uuid "4a78461e-6132-529a-8257-feea5fe0d7db" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186373101} :answer-field/id #uuid "6c23dc4f-050f-5ba4-89bb-48c875c699b7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373099}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3de84742-74a1-56db-b7ee-7f9d41adc27b" :question/math-academy-id "q-34725" :question/problem "$\\text{dim}(\\text{Span}{[\\begin{aligned}1 \\\\ -2\\end{aligned}],[\\begin{aligned}-1 \\\\ 2\\end{aligned}],[\\begin{aligned}-1 \\\\ -2\\end{aligned}]})=$" :question/worked-solution "We start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned} & [\\begin{aligned}1 & -1 & -1 \\\\ -2 & 2 & -2\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & -1 \\\\ 0 & 0 & -4\\end{aligned}]\\end{aligned}\n$$\n\nThe pivot columns correspond to basis vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the reduced matrix has $2$ pivot columns (or alternatively, it has exactly $2$ non-zero rows). \n\nTherefore, \n$\\text{dim}(\\text{Span}{[\\begin{aligned}1 \\\\ -2\\end{aligned}],[\\begin{aligned}-1 \\\\ 2\\end{aligned}],[\\begin{aligned}-1 \\\\ -2\\end{aligned}]})=2.$"}] [{:db/id #edb/ref 17592186373105 :knowledge-point/_questions [{:knowledge-point/id #uuid "004c4177-ca0e-586c-962a-1220b4b64f47" :knowledge-point/title "Finding the Dimension of a Span Using Row Reduction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2affd556-b83d-522e-ad98-2dd7fd57de31" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186373107} {:answer/id #uuid "262799ff-b132-5e55-9eda-a9ac31f13823" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186373108} {:answer/id #uuid "ca0cf7f8-2eb0-5dbb-a8a8-feb96cd787cb" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186373109} {:answer/id #uuid "d1a576db-ad67-5df6-b441-cc40af5d3bda" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186373110} {:answer/id #uuid "add58012-f37f-51c5-bbc6-27f52e16359b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186373111}] :answer-field/correct {:answer/id #uuid "2affd556-b83d-522e-ad98-2dd7fd57de31" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186373107} :answer-field/id #uuid "33483c7e-6944-599b-a784-832903e514e1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373106}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "46f7a4e3-0c58-596d-bb3c-a64412f6ff71" :question/math-academy-id "q-35299" :question/problem "Determine the dimension of\n$\\text{Span}{[\\begin{aligned}2 \\\\ 0 \\\\ -1\\end{aligned}],[\\begin{aligned}-3 \\\\ 5 \\\\ 3\\end{aligned}],[\\begin{aligned}-1 \\\\ 5 \\\\ -2\\end{aligned}]}.$" :question/worked-solution "We start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned} & [\\begin{aligned}2 & -3 & -1 \\\\ 0 & 5 & 5 \\\\ -1 & 3 & -2\\end{aligned}] & {R}_{3} & :={R}_{3}+\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}2 & -3 & -1 \\\\ 0 & 5 & 5 \\\\ 0 & \\frac{3}{2} & -\\frac{5}{2}\\end{aligned}] & {R}_{3} & :={R}_{3}+(-\\frac{3}{10}){R}_{2} \\\\  & ∼[\\begin{aligned}2 & -3 & -1 \\\\ 0 & 5 & 5 \\\\ 0 & 0 & -4\\end{aligned}]\\end{aligned}\n$$\n\nThe pivot columns correspond to basis vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the reduced matrix has $3$ pivot columns (or alternatively, it has exactly $3$ non-zero rows). \n\nTherefore, the dimension of the span is $3.$"}] [{:db/id #edb/ref 17592186373112 :knowledge-point/_questions [{:knowledge-point/id #uuid "8a5d11c2-4a7c-5fdc-a363-8a87b90db19e" :knowledge-point/title "Finding the Dimension of a Span by Inspection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98d49020-8876-5ba0-88ed-a09aff3b042f" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186373114} {:answer/id #uuid "930863fc-491c-5746-a597-629228754232" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186373115} {:answer/id #uuid "bab82802-6085-5503-b4fb-51786c4d1e74" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186373116} {:answer/id #uuid "cb6269d4-64ec-5f6c-9af7-fdc4aabe68a0" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186373117} {:answer/id #uuid "106f7333-24fa-5439-8d27-9c68d8bfc544" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186373118}] :answer-field/correct {:answer/id #uuid "930863fc-491c-5746-a597-629228754232" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186373115} :answer-field/id #uuid "dd24a302-597c-53b5-8fd6-47ea7529e3e5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373113}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ff2a6a98-3129-57aa-aa6a-602aaba51867" :question/math-academy-id "q-79313" :question/problem "$\\text{dim}(\\text{Span}{[\\begin{aligned}4 \\\\ 0 \\\\ 0\\end{aligned}],[\\begin{aligned}-1 \\\\ 2 \\\\ 0\\end{aligned}]})=$" :question/worked-solution "We start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned}[\\begin{aligned}4 & -1 \\\\ 0 & 2 \\\\ 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn this case, our matrix is already in a row echelon form.\n\nThe pivot columns correspond to basis vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the reduced matrix has $2$ pivot columns (or alternatively, $2$ non-zero rows). \n\nTherefore,\n$\\text{dim}(\\text{Span}{[\\begin{aligned}4 \\\\ 0 \\\\ 0\\end{aligned}],[\\begin{aligned}-1 \\\\ 2 \\\\ 0\\end{aligned}]})=2.$"}] [{:db/id #edb/ref 17592186373119 :knowledge-point/_questions [{:knowledge-point/id #uuid "8a5d11c2-4a7c-5fdc-a363-8a87b90db19e" :knowledge-point/title "Finding the Dimension of a Span by Inspection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a8284fd-e415-559a-9499-67de3827fa8c" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186373121} {:answer/id #uuid "e19eef0e-99a8-52a2-b435-adbbcb326e75" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #e