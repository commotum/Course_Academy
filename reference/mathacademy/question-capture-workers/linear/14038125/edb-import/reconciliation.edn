}\\,\\text{d}x \\\\  & =\\frac{x{5}^{x}}{\\operatorname{ln}⁡(5)}-\\frac{{5}^{x}}{(\\operatorname{ln}⁡(5))^{2}}+C \\\\  & =\\frac{{5}^{x}}{\\operatorname{ln}⁡5}(x-\\frac{1}{\\operatorname{ln}⁡5})+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038125/state.json" "file_sha256" "21e3e196aff192f4c4050903a8272d9961cccd1bdfd206a269712b9a6f763352"} {"question" "q-2420" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038125/activity-metadata.json" "file_sha256" "f12dea770497d297247a2cb79ecdcc904740445870ab69551b14378c475ea87c"} {"question" "q-2420" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038125/state.json" "file_sha256" "21e3e196aff192f4c4050903a8272d9961cccd1bdfd206a269712b9a6f763352"} {"question" "q-2420" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{{5}^{x}}{\\operatorname{ln}⁡5}(1-\\frac{x}{\\operatorname{ln}⁡5})+C"] ["math" "\\frac{{5}^{x}}{\\operatorname{ln}⁡5}(\\frac{1}{x}-\\frac{x}{\\operatorname{ln}⁡5})+C"] ["math" "\\frac{{5}^{x}}{\\operatorname{ln}⁡5}(x+\\frac{1}{\\operatorname{ln}⁡5})+C"] ["math" "\\frac{{5}^{x}}{\\operatorname{ln}⁡5}(x-1)+C"] ["math" "\\frac{{5}^{x}}{\\operatorname{ln}⁡5}(x-\\frac{1}{\\operatorname{ln}⁡5})+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038125/state.json" "file_sha256" "21e3e196aff192f4c4050903a8272d9961cccd1bdfd206a269712b9a6f763352"} {"question" "q-2420" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{{5}^{x}}{\\operatorname{ln}⁡5}(x-\\frac{1}{\\