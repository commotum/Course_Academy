01e1bff8d42af9bd410b499f0a7ab693d9aeb8d3c0c9f2d1dbc19bf6" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"} {"question" "q-114299" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{x\\operatorname{sin}⁡4x}{2}+\\frac{\\operatorname{cos}⁡4x}{8}+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "5018c91201e1bff8d42af9bd410b499f0a7ab693d9aeb8d3c0c9f2d1dbc19bf6" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"} {"question" "q-14437" "field" nil "attribute" "question/problem" "value" "Calculate $\\int 2x\\operatorname{sin}⁡(x)\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "5018c91201e1bff8d42af9bd410b499f0a7ab693d9aeb8d3c0c9f2d1dbc19bf6" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"} {"question" "q-14437" "field" nil "attribute" "question/worked-solution" "value" "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int 2x\\operatorname{sin}⁡(x)\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=2x\\, & ⟹\\,{u}^{′}=2 \\\\ {v}^{′}=\\operatorname{sin}⁡(x)\\, & ⟹\\,v=-\\operatorname{cos}⁡(x).\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 2x\\cdot \\operatorname{sin}⁡(x)\\,\\text{d}x & =2x\\cdot (-\\operatorname{cos}⁡(x))-\\int (-\\operatorname{cos}⁡(x))\\cdot 2\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int 2x\\operatorname{sin}⁡(x)\\,\\text{d}x & =-2x\\operatorname{cos}⁡(x)+2\\int \\operatorname{cos}⁡(x)\\,\\text{d}x \\\\  & =-2x\\operatorname{cos}⁡(x)+2\\operatorname{sin}⁡(x)+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "5018c91201e1bff8d42af9bd410b499f0a7ab693d9aeb8d3c0c9f2d1dbc19bf6" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"} {"question" "q-14437" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/activity-metadata.json" "file_sha256" "1a77b5d0d3582ab92a8158644acff6d27ec0cbf8ee8f7abf77b21d7ef73cdffb" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"} {"question" "q-14437" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "5018c91201e1bff8d42af9bd410b499f0a7ab693d9aeb8d3c0c9f2d1dbc19bf6" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"} {"question" "q-346870" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1}2x{e}^{x}\\,\\text{d}x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "5018c91201e1bff8d42af9bd410b499f0a7ab693d9aeb8d3c0c9f2d1dbc19bf6" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"} {"question" "q-346870" "field" nil "attribute" "question/worked-solution" "value" "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=2x & ⇒ & {u}^{′}=2 \\\\ {v}^{′}={e}^{x} & ⇒ & v={e}^{x}.\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 2x\\cdot {e}^{x}\\,\\text{d}x & =2x\\cdot {e}^{x}-\\int {e}^{x}\\cdot 2\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}2x{e}^{x}\\,\\text{d}x & =2x{e}^{x}\\,{|}_{0}^{1}-2{\\int }_{0}^{1}{e}^{x}\\,\\text{d}x \\\\  & =2x{e}^{x}\\,{|}_{0}^{1}-2{e}^{x}\\,{|}_{0}^{1} \\\\  & =2(1\\cdot {e}^{1}-0\\cdot {e}^{0})-2({e}^{1}-{e}^{0}) \\\\  & =2e-2(e-1) \\\\  & =2.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "5018c91201e1bff8d42af9bd410b499f0a7ab693d9aeb8d3c0c9f2d1dbc19bf6" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"} {"question" "q-346870" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/activity-metadata.json" "file_sha256" "1a77b5d0d3582ab92a8158644acff6d27ec0cbf8ee8f7abf77b21d7ef73cdffb" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"} {"question" "q-346870" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "5018c91201e1bff8d42af9bd410b499f0a7ab693d9aeb8d3c0c9f2d1dbc19bf6" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"} {"question" "q-346870" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "5018c91201e1bff8d42af9bd410b499f0a7ab693d9aeb8d3c0c9f2d1dbc19bf6" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"} {"question" "e-491" "field" nil "attribute" "question/problem" "value" "Calculate $\\displaystyle \\int xe^{7x} \\textrm{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/example-491.json" "file_sha256" "7c46823a076f27418f687c1c57f0be26c1c0d58db148bd07e8215baee597f933" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"} {"question" "e-491" "field" nil "attribute" "question/worked-solution" "value" "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int uv' \\, \\textrm{d}x= uv - \\int vu' \\, \\textrm{d}x.\n$$\n\nWe need to express $\\displaystyle  \\int xe^{7x} \\textrm{d}x$ as $\\displaystyle  \\int uv'\\,\\textrm{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′}={e}^{7x}\\, & ⟹\\,v=\\frac{1}{7}{e}^{7x}.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get the following:\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot {e}^{7x}\\,\\text{d}x & =x\\cdot \\frac{1}{7}{e}^{7x}-\\int \\frac{1}{7}{e}^{7x}\\cdot 1\\,\\text{d}x\\end{aligned}\n$$\n\nFinally, we calculate the integral:\n\n$$\n\\begin{aligned}\\int x{e}^{7x}\\,\\text{d}x & =\\frac{1}{7}x{e}^{7x}-\\frac{1}{7}\\int {e}^{7x}\\,\\text{d}x \\\\  & =\\frac{1}{7}x{e}^{7x}-\\frac{1}{7}(\\frac{{e}^{7x}}{7})+C \\\\  & =\\frac{1}{7}x{e}^{7x}-\\frac{1}{49}{e}^{7x}+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/example-491.json" "file_sha256" "7c46823a076f27418f687c1c57f0be26c1c0d58db148bd07e8215baee597f933" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"} {"question" "e-492" "field" nil "attribute" "question/problem" "value" "Calculate $\\displaystyle\\int x \\cos{2x}\\,\\textrm d x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/example-492.json" "file_sha256" "6ea45868b53e6a7ef46cd6a099a1f9edf4ee7fd285ddd7f1dc86b89a549281ab" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"} {"question" "e-492" "field" nil "attribute" "question/worked-solution" "value" "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int uv'\\,\\textrm{d}x= uv- \\int vu'\\,\\textrm{d}x.\n$$\n\nWe need to express $\\displaystyle \\int x \\cos{2x} \\textrm{d}x$ as $\\displaystyle \\int uv'\\,\\textrm{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′}=\\operatorname{cos}⁡2x\\, & ⟹\\,v=\\frac{1}{2}\\operatorname{sin}⁡2x.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\operatorname{cos}⁡2x\\,\\text{d}x & =x\\cdot \\frac{1}{2}\\operatorname{sin}⁡2x-\\int \\frac{1}{2}\\operatorname{sin}⁡2x\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int x\\operatorname{cos}⁡2x\\,\\text{d}x & =\\frac{1}{2}x\\operatorname{sin}⁡2x-\\frac{1}{2}\\int \\operatorname{sin}⁡2x\\,\\text{d}x \\\\  & =\\frac{1}{2}x\\operatorname{sin}⁡2x-\\frac{1}{2}(-\\frac{1}{2}\\operatorname{cos}⁡2x)+C \\\\  & =\\frac{1}{2}x\\operatorname{sin}⁡2x+\\frac{1}{4}\\operatorname{cos}⁡2x+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/example-492.json" "file_sha256" "6ea45868b53e6a7ef46cd6a099a1f9edf4ee7fd285ddd7f1dc86b89a549281ab" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"} {"question" "e-6209" "field" nil "attribute" "question/problem" "value" "Evaluate $\\displaystyle \\int_0^{\\pi/5} x\\sin(5x) \\, \\textrm{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/example-6209.json" "file_sha256" "873e4784b82e098e69e17d1c87e19a6fff599f58729fd44e363879ddeff1d870" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"} {"question" "e-6209" "field" nil "attribute" "question/worked-solution" "value" "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′}=\\operatorname{sin}⁡(5x) & ⟹\\,v=-\\frac{1}{5}\\operatorname{cos}⁡(5x).\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot \\operatorname{sin}⁡(5x)\\,\\text{d}x & =-x\\cdot \\frac{1}{5}\\operatorname{cos}⁡(5x)-\\int (-\\frac{1}{5}\\operatorname{cos}⁡(5x))\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /5}x\\operatorname{sin}⁡(5x)\\,\\text{d}x & =-{\\frac{1}{5}x\\operatorname{cos}⁡(5x)|}_{0}^{\\pi /5}+\\frac{1}{5}{\\int }_{0}^{\\pi /5}\\operatorname{cos}⁡(5x)\\,\\text{d}x \\\\  & =-{\\frac{1}{5}x\\operatorname{cos}⁡(5x)|}_{0}^{\\pi /5}+{\\frac{1}{5}(\\frac{\\operatorname{sin}⁡(5x)}{5})|}_{0}^{\\pi /5} \\\\  & =[-\\frac{1}{5}\\cdot \\frac{\\pi }{5}\\operatorname{cos}⁡(\\pi )+\\frac{1}{5}\\cdot 0\\cdot \\operatorname{cos}⁡(0)]+[\\frac{1}{25}\\operatorname{sin}⁡(\\pi )-\\frac{1}{25}\\operatorname{sin}⁡(0)] \\\\  & =[-\\frac{\\pi }{25}\\cdot (-1)+0]+[0-0] \\\\  & =\\frac{\\pi }{25}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/example-6209.json" "file_sha256" "873e4784b82e098e69e17d1c87e19a6fff599f58729fd44e363879ddeff1d870" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"}] "sources" [{"question" "q-12556" "field" nil "attribute" "question/problem" "value" "Calculate the integral $\\int x{e}^{-3x}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038125/state.json" "file_sha256" "21e3e196aff192f4c4050903a8272d9961cccd1bdfd206a269712b9a6f763352"} {"question" "q-12556" "field" nil "attribute" "question/worked-solution" "value" "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int x{e}^{-3x}\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′}={e}^{-3x}\\, & ⟹\\,v=-\\frac{{e}^{-3x}}{3}.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot {e}^{-3x}\\,\\text{d}x & =x\\cdot (-\\frac{{e}^{-3x}}{3})-\\int (-\\frac{{e}^{-3x}}{3})\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int x{e}^{-3x}\\,\\text{d}x & =-\\frac{x{e}^{-3x}}{3}+\\frac{1}{3}\\int {e}^{-3x}\\,\\text{d}x \\\\  & =-\\frac{x{e}^{-3x}}{3}-\\frac{{e}^{-3x}}{9}+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038125/state.json" "file_sha256" "21e3e196aff192f4c4050903a8272d9961cccd1bdfd206a269712b9a6f763352"} {"question" "q-12556" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038125/activity-metadata.json" "file_sha256" "f12dea770497d297247a2cb79ecdcc904740445870ab69551b14378c475ea87c"} {"question" "q-12556" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038125/state.json" "file_sha256" "21e3e196aff192f4c4050903a8272d9961cccd1bdfd206a269712b9a6f763352"} {"question" "q-12556" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{x{e}^{-3x}}{3}-\\frac{{e}^{-3x}}{9}+C"] ["math" "-\\frac{x{e}^{3x}}{3}+\\frac{{e}^{3x}}{9}+C"] ["math" "\\frac{x{e}^{-3x}}{9}+\\frac{{e}^{-3x}}{9}+C"] ["math" "\\frac{x{e}^{-3x}}{9}-\\frac{{e}^{-3x}}{3}+C"] ["math" "\\frac{{e}^{-3x}}{3}-\\frac{x{e}^{-3x}}{9}+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038125/state.json" "file_sha256" "21e3e196aff192f4c4050903a8272d9961cccd1bdfd206a269712b9a6f763352"} {"question" "q-12556" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{x{e}^{-3x}}{3}-\\frac{{e}^{-3x}}{9}+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038125/state.json" "file_sha256" "21e3e196aff192f4c4050903a8272d9961cccd1bdfd206a269712b9a6f763352"} {"question" "q-114287" "field" nil "attribute" "question/problem" "value" "Calculate $\\int 6x{e}^{-3x}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038125/state.json" "file_sha256" "21e3e196aff192f4c4050903a8272d9961cccd1bdfd206a269712b9a6f763352"} {"question" "q-114287" "field" nil "attribute" "question/worked-solution" "value" "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int 6x{e}^{-3x}\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=6x\\, & ⟹\\,{u}^{′}=6 \\\\ {v}^{′}={e}^{-3x}\\, & ⟹\\,v=-\\frac{{e}^{-3x}}{3}.\\end{aligned}\n$$\n\nWe, substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 6x\\cdot {e}^{-3x}\\,\\text{d}x & =6x\\cdot (-\\frac{{e}^{-3x}}{3})-\\int (-\\frac{{e}^{-3x}}{3})\\cdot 6\\,\\text{d}x \\\\  & =-2x{e}^{-3x}+2\\int {e}^{-3x}\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int 6x{e}^{-3x}\\,\\text{d}x & =-2x{e}^{-3x}+2\\int {e}^{-3x}\\,\\text{d}x \\\\  & =-2x{e}^{-3x}-\\frac{2{e}^{-3x}}{3}+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038125/state.json" "file_sha256" "21e3e196aff192f4c4050903a8272d9961cccd1bdfd206a269712b9a6f763352"} {"question" "q-114287" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038125/activity-metadata.json" "file_sha256" "f12dea770497d297247a2cb79ecdcc904740445870ab69551b14378c475ea87c"} {"question" "q-114287" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038125/state.json" "file_sha256" "21e3e196aff192f4c4050903a8272d9961cccd1bdfd206a269712b9a6f763352"} {"question" "q-114287" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2x{e}^{-3x}-\\frac{2{e}^{-3x}}{3}+C"] ["math" "-3x{e}^{-3x}-\\frac{{e}^{-3x}}{3}+C"] ["math" "-x{e}^{-3x}+\\frac{2{e}^{-3x}}{3}+C"] ["math" "4x{e}^{-3x}-\\frac{3{e}^{-3x}}{2}+C"] ["math" "\\frac{x{e}^{-3x}}{2}-\\frac{2{e}^{-3x}}{3}+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038125/state.json" "file_sha256" "21e3e196aff192f4c4050903a8272d9961cccd1bdfd206a269712b9a6f763352"} {"question" "q-114287" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-2x{e}^{-3x}-\\frac{2{e}^{-3x}}{3}+C"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038125/state.json" "file_sha256" "21e3e196aff192f4c4050903a8272d9961cccd1bdfd206a269712b9a6f763352"} {"question" "q-12462" "field" nil "attribute" "question/problem" "value" "Calculate the integral $\\int 3x{e}^{-x}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038125/state.json" "file_sha256" "21e3e196aff192f4c4050903a8272d9961cccd1bdfd206a269712b9a6f763352"} {"question" "q-12462" "field" nil "attribute" "question/worked-solution" "value" "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int 3x{e}^{-x}\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=3x\\, & ⟹\\,{u}^{′}=3 \\\\ {v}^{′}={e}^{-x}\\, & ⟹\\,v=-{e}^{-x}.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 3x\\cdot {e}^{-x}\\,\\text{d}x & =3x\\cdot (-{e}^{-x})-\\int (-{e}^{-x})\\cdot 3\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int 3x{e}^{-x}\\,\\text{d}x & =-3x{e}^{-x}+3\\int {e}^{-x}\\,\\text{d}x \\\\  & =-3x{e}^{-x}-3{e}^{-x}+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038125/state.json" "file_sha256" "21e3e196aff192f4c4050903a8272d9961cccd1bdfd206a269712b9a6f763352"} {"question" "q-12462" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038125/activity-metadata.json" "file_sha256" "f12dea770497d297247a2cb79ecdcc904740445870ab69551b14378c475ea87c"} {"question" "q-12462" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038125/state.json" "file_sha256" "21e3e196aff192f4c4050903a8272d9961cccd1bdfd206a269712b9a6f763352"} {"question" "q-12462" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-3x{e}^{-x}+{e}^{-x}+C"] ["math" "-3x{e}^{-x}-2{e}^{-x}+C"] ["math" "-3x{e}^{-x}-3{e}^{-x}+C"] ["math" "2{e}^{-x}-3x{e}^{-x}+C"] ["math" "3{e}^{-x}-x{e}^{-x}+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038125/state.json" "file_sha256" "21e3e196aff192f4c4050903a8272d9961cccd1bdfd206a269712b9a6f763352"} {"question" "q-12462" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-3x{e}^{-x}-3{e}^{-x}+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038125/state.json" "file_sha256" "21e3e196aff192f4c4050903a8272d9961cccd1bdfd206a269712b9a6f763352"} {"question" "q-114289" "field" nil "attribute" "question/problem" "value" "Calculate $\\int x{3}^{x}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038125/state.json" "file_sha256" "21e3e196aff192f4c4050903a8272d9961cccd1bdfd206a269712b9a6f763352"} {"question" "q-114289" "field" nil "attribute" "question/worked-solution" "value" "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int x{3}^{x}\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u & =x\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′} & ={3}^{x}\\, & ⟹\\,v=\\frac{{3}^{x}}{\\operatorname{ln}⁡3}.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot {3}^{x}\\,\\text{d}x & =x\\cdot \\frac{{3}^{x}}{\\operatorname{ln}⁡3}-\\int \\frac{{3}^{x}}{\\operatorname{ln}⁡3}\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int x{3}^{x}\\,\\text{d}x & =\\frac{x{3}^{x}}{\\operatorname{ln}⁡3}-\\int \\frac{{3}^{x}}{\\operatorname{ln}⁡3}\\,\\text{d}x \\\\  & =\\frac{x{3}^{x}}{\\operatorname{ln}⁡3}-\\frac{{3}^{x}}{(\\operatorname{ln}⁡3)^{2}}+C \\\\  & =\\frac{{3}^{x}}{\\operatorname{ln}⁡3}(x-\\frac{1}{\\operatorname{ln}⁡3})+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038125/state.json" "file_sha256" "21e3e196aff192f4c4050903a8272d9961cccd1bdfd206a269712b9a6f763352"} {"question" "q-114289" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038125/activity-metadata.json" "file_sha256" "f12dea770497d297247a2cb79ecdcc904740445870ab69551b14378c475ea87c"} {"question" "q-114289" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038125/state.json" "file_sha256" "21e3e196aff192f4c4050903a8272d9961cccd1bdfd206a269712b9a6f763352"} {"question" "q-114289" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{{3}^{x}}{\\operatorname{ln}⁡3}(2x+\\frac{1}{\\operatorname{ln}⁡3})+C"] ["math" "\\frac{{3}^{x}}{\\operatorname{ln}⁡3}(\\frac{1}{\\operatorname{ln}⁡3}-\\frac{x}{2})+C"] ["math" "\\frac{{3}^{x}}{\\operatorname{ln}⁡3}(x-1)+C"] ["math" "\\frac{{3}^{x}}{\\operatorname{ln}⁡3}(x-\\frac{1}{3})+C"] ["math" "\\frac{{3}^{x}}{\\operatorname{ln}⁡3}(x-\