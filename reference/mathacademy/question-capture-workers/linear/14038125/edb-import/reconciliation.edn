31626/edb-import/verification.json"} {"question" "q-49682" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "-\\pi "] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14031626/state.json" "file_sha256" "3ddbf1755e389721b5699fd87b6d64f8c9041b32617e322cc23dfb2983b00e34" "basis" 1215 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14031626/edb-import/verification.json"} {"question" "q-49682" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "2\\pi "] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14031626/state.json" "file_sha256" "3ddbf1755e389721b5699fd87b6d64f8c9041b32617e322cc23dfb2983b00e34" "basis" 1215 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14031626/edb-import/verification.json"} {"question" "q-49682" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{\\pi }{2}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14031626/state.json" "file_sha256" "3ddbf1755e389721b5699fd87b6d64f8c9041b32617e322cc23dfb2983b00e34" "basis" 1215 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14031626/edb-import/verification.json"} {"question" "q-49682" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-4\\pi "] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14031626/state.json" "file_sha256" "3ddbf1755e389721b5699fd87b6d64f8c9041b32617e322cc23dfb2983b00e34" "basis" 1215 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14031626/edb-import/verification.json"} {"question" "q-14449" "field" nil "attribute" "question/problem" "value" "Calculate $\\int 5x\\operatorname{sin}⁡(x)\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "5018c91201e1bff8d42af9bd410b499f0a7ab693d9aeb8d3c0c9f2d1dbc19bf6" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"} {"question" "q-14449" "field" nil "attribute" "question/worked-solution" "value" "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int 5x\\operatorname{sin}⁡(x)\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=5x\\, & ⟹\\,{u}^{′}=5 \\\\ {v}^{′}=\\operatorname{sin}⁡(x)\\, & ⟹\\,v=-\\operatorname{cos}⁡(x).\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 5x\\cdot \\operatorname{sin}⁡(x)\\,\\text{d}x & =5x\\cdot (-\\operatorname{cos}⁡(x))-\\int (-\\operatorname{cos}⁡(x))\\cdot 5\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int 5x\\operatorname{sin}⁡(x)\\,\\text{d}x & =-5x\\operatorname{cos}⁡(x)+5\\int \\operatorname{cos}⁡(x)\\,\\text{d}x \\\\  & =-5x\\operatorname{cos}⁡(x)+5\\operatorname{sin}⁡(x)+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "5018c91201e1bff8d42af9bd410b499f0a7ab693d9aeb8d3c0c9f2d1dbc19bf6" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"} {"question" "q-14449" "field" nil "attribute" "question/difficulty" "value" :question.difficul