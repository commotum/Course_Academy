d410b499f0a7ab693d9aeb8d3c0c9f2d1dbc19bf6" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"} {"question" "q-114299" "field" nil "attribute" "question/problem" "value" "Calculate $\\int 2x\\operatorname{cos}⁡4x\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "5018c91201e1bff8d42af9bd410b499f0a7ab693d9aeb8d3c0c9f2d1dbc19bf6" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"} {"question" "q-114299" "field" nil "attribute" "question/worked-solution" "value" "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int 2x\\operatorname{cos}⁡4x\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=2x\\, & ⟹\\,{u}^{′}=2 \\\\ {v}^{′}=\\operatorname{cos}⁡4x\\, & ⟹\\,v=\\frac{1}{4}\\operatorname{sin}⁡4x.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 2x\\operatorname{cos}⁡4x\\,\\text{d}x & =2x\\cdot \\frac{1}{4}\\operatorname{sin}⁡4x-\\int \\frac{1}{4}\\operatorname{sin}⁡4x\\cdot 2\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int 2x\\operatorname{cos}⁡4x\\,\\text{d}x & =\\frac{1}{2}x\\operatorname{sin}⁡4x-\\frac{1}{2}\\int \\operatorname{sin}⁡4x\\,\\text{d}x \\\\  & =\\frac{1}{2}x\\operatorname{sin}⁡4x-\\frac{1}{2}(-\\frac{1}{4}\\operatorname{cos}⁡4x)+C \\\\  & =\\frac{1}{2}x\\operatorname{sin}⁡4x+\\frac{1}{8}\\operatorname{cos}⁡4x+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "5018c91201e1bff8d42af9bd410b499f0a7ab693d9aeb8d3c0c9f2d1dbc19bf6" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"} {"question" "q-114299" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/activity-metadata.json" "file_sha256" "1a77b5d0d3582ab92a8158644acff6d27ec0cbf8ee8f7abf77b21d7ef73cdffb" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"} {"question" "q-114299" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "5018c91201e1bff8d42af9bd410b499f0a7ab693d9aeb8d3c0c9f2d1dbc19bf6" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"} {"question" "q-114299" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "-\\frac{\\operatorname{sin}⁡4x}{4}+\\frac{x\\operatorname{cos}⁡4x}{6}+C"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "5018c91201e1bff8d42af9bd410b499f0a7ab693d9aeb8d3c0c9f2d1dbc19bf6" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"} {"question" "q-114299" "field" "selection" "attrib