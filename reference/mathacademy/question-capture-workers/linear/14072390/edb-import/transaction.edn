[{:db/id "q-34738/selection/81ec9cf26b4d634e9c6dd41dfa456114165178124fc4fbd86ade95b2369b8a6b" :answer/id #uuid "26cabdff-ccdb-525e-a6c1-6e735d7ed9e5" :answer/type :answer.type/math :answer/value "x\\notin \\text{span}{{b}_{1},{b}_{2}}" :db/ensure [:answer/validate]} {:db/id "q-34738/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "de24a0cb-0910-5e6e-9b02-49dade778705" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-34738/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "76be420d-79aa-50e4-aa8d-65977f7c1735" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-34738/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "7685ab4e-ccfc-5683-9954-f79488394b7a" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-34738/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "e34e2c77-989a-5e4d-8c31-d5411aa10ff7" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-34738/selection" :answer-field/id #uuid "300dac44-41e8-5043-a8f5-0b3b37ed3438" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-34738/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-34738/selection/81ec9cf26b4d634e9c6dd41dfa456114165178124fc4fbd86ade95b2369b8a6b" "q-34738/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-34738/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-34738/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-34738/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-34738" :question/id #uuid "0e77bc71-9715-5d3f-9eeb-ecdf8d1080d9" :question/math-academy-id "q-34738" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B={{b}_{1},{b}_{2}},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}-1 \\\\ 5 \\\\ 0\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}4 \\\\ 2 \\\\ -3\\end{aligned}],\\,x=[\\begin{aligned}6 \\\\ -8 \\\\ -3\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ then what is the value of ${x}_{1}+{x}_{2}?$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2} & =x \\\\ {x}_{1}[\\begin{aligned}-1 \\\\ 5 \\\\ 0\\end{aligned}]+{x}_{2}[\\begin{aligned}4 \\\\ 2 \\\\ -3\\end{aligned}] & =[\\begin{aligned}6 \\\\ -8 \\\\ -3\\end{aligned}].\\end{aligned}\n$$\n\nThe equation above gives the system with the augmented matrix \n\n$$\nM=[\\begin{aligned}-1 & 4 & 6 \\\\ 5 & 2 & -8 \\\\ 0 & -3 & -3\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following: \n\n$$\n\\begin{aligned}M= & [\\begin{aligned}-1 & 4 & 6 \\\\ 5 & 2 & -8 \\\\ 0 & -3 & -3\\end{aligned}] & {R}_{2}:={R}_{2}+5{R}_{1} \\\\ ∼ & [\\begin{aligned}-1 & 4 & 6 \\\\ 0 & 22 & 22 \\\\ 0 & -3 & -3\\end{aligned}] & {R}_{3}:={R}_{3}+\\frac{3}{22}{R}_{2} \\\\ ∼ & [\\begin{aligned}-1 & 4 & 6 \\\\ 0 & 22 & 22 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n{\\begin{aligned}-{x}_{1}+4{x}_{2}=6 \\\\ 22{x}_{2}=22.\\end{aligned}\n$$\n\nFrom the second equation, we get ${x}_{2}=1.$ Substituting this into the first equation, we obtain\n\n$$\n-{x}_{1}+4(1)=6\\,⟹\\,{x}_{1}=-2.\n$$\n\nTherefore, $[x]_{B}=[\\begin{aligned}-2 \\\\ 1\\end{aligned}].$ \n\nFinally, ${x}_{1}+{x}_{2}=-2+1=-1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-34738/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "841f498b-f737-5086-8f79-44f1a143bebb"] :knowledge-point/questions ["q-34738"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186120291 :question/answer-fields 17592186118221] {:db/id "q-34764/selection/ma-v1/929bdad643697423e92232a4f0873f53f6ddf5cf7a0307e6c25f69b93e26a669/f6dab1aaf947cb8c1f47690c13a34f270ff23312486a212e76af727dcf7e93a5" :answer/id #uuid "59f01964-7b49-5b40-b040-d4dce8a8f47f" :answer/type :answer.type/math :answer/value "x\\notin \\text{Span}{{b}_{1},{b}_{2},{b}_{3}}" :db/ensure [:answer/validate]} {:db/id "q-34764/selection/ma-v1/929bdad643697423e92232a4f0873f53f6ddf5cf7a0307e6c25f69b93e26a669/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "bfdf9a35-040c-5f59-9752-d1d0aa562f8c" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-34764/selection/ma-v1/929bdad643697423e92232a4f0873f53f6ddf5cf7a0307e6c25f69b93e26a669/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "dd6c4879-b546-5922-8f67-0c0085e2778a" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-34764/selection/ma-v1/929bdad643697423e92232a4f0873f53f6ddf5cf7a0307e6c25f69b93e26a669/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "79e25a86-b41c-504f-adde-9dd7ff20841f" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-34764/selection/ma-v1/929bdad643697423e92232a4f0873f53f6ddf5cf7a0307e6c25f69b93e26a669/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "a6d53a3d-1e13-5272-80c7-b960c1108b4f" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-34764/selection/ma-v1/929bdad643697423e92232a4f0873f53f6ddf5cf7a0307e6c25f69b93e26a669" :answer-field/id #uuid "ec6ac049-0b64-523f-b2c8-c18f60cfaf71" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-34764/selection/ma-v1/929bdad643697423e92232a4f0873f53f6ddf5cf7a0307e6c25f69b93e26a669/f6dab1aaf947cb8c1f47690c13a34f270ff23312486a212e76af727dcf7e93a5" :answer-field/choices ["q-34764/selection/ma-v1/929bdad643697423e92232a4f0873f53f6ddf5cf7a0307e6c25f69b93e26a669/f6dab1aaf947cb8c1f47690c13a34f270ff23312486a212e76af727dcf7e93a5" "q-34764/selection/ma-v1/929bdad643697423e92232a4f0873f53f6ddf5cf7a0307e6c25f69b93e26a669/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-34764/selection/ma-v1/929bdad643697423e92232a4f0873f53f6ddf5cf7a0307e6c25f69b93e26a669/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-34764/selection/ma-v1/929bdad643697423e92232a4f0873f53f6ddf5cf7a0307e6c25f69b93e26a669/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-34764/selection/ma-v1/929bdad643697423e92232a4f0873f53f6ddf5cf7a0307e6c25f69b93e26a669/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-34764"] :question/problem "Find the coordinates of the vector $x$ relative to the basis $B={{b}_{1},{b}_{2},{b}_{3}},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}1 \\\\ -1 \\\\ 2 \\\\ 0\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}2 \\\\ 0 \\\\ 0 \\\\ 4\\end{aligned}],\\,{b}_{3}=[\\begin{aligned}0 \\\\ 0 \\\\ -1 \\\\ 0\\end{aligned}],\\,x=[\\begin{aligned}2 \\\\ 2 \\\\ -5 \\\\ 4\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]$ then what is the value of ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "We need to find ${x}_{1}$,  ${x}_{2}$, and ${x}_{3}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+{x}_{3}{b}_{3} & =x \\\\ {x}_{1}[\\begin{aligned}1 \\\\ -1 \\\\ 2 \\\\ 0\\end{aligned}]+{x}_{2}[\\begin{aligned}2 \\\\ 0 \\\\ 0 \\\\ 4\\end{aligned}]+{x}_{3}[\\begin{aligned}0 \\\\ 0 \\\\ -1 \\\\ 0\\end{aligned}] & =[\\begin{aligned}2 \\\\ 2 \\\\ -5 \\\\ 4\\end{aligned}]\\end{aligned}\n$$\n\nFrom this, we get the system with the augmented matrix $M$, which we reduce using Gaussian elimination:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}1 & 2 & 0 & 2 \\\\ -1 & 0 & 0 & 2 \\\\ 2 & 0 & -1 & -5 \\\\ 0 & 4 & 0 & 4\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\ ∼ & [\\begin{aligned}1 & 2 & 0 & 2 \\\\ 0 & 2 & 0 & 4 \\\\ 2 & 0 & -1 & -5 \\\\ 0 & 4 & 0 & 4\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\ ∼ & [\\begin{aligned}1 & 2 & 0 & 2 \\\\ 0 & 2 & 0 & 4 \\\\ 0 & -4 & -1 & -9 \\\\ 0 & 4 & 0 & 4\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\ ∼ & [\\begin{aligned}1 & 2 & 0 & 2 \\\\ 0 & 2 & 0 & 4 \\\\ 0 & 0 & -1 & -1 \\\\ 0 & 4 & 0 & 4\\end{aligned}] & {R}_{4} & :={R}_{4}+(-2){R}_{2} \\\\ ∼ & [\\begin{aligned}1 & 2 & 0 & 2 \\\\ 0 & 2 & 0 & 4 \\\\ 0 & 0 & -1 & -1 \\\\ 0 & 0 & 0 & -4\\end{aligned}]\\end{aligned}\n$$\n\n \nThe system is now \n\n$$\n{\\begin{aligned}{x}_{1}+2{x}_{2}=2 \\\\ 2{x}_{2}=4 \\\\ -{x}_{3}=-1 \\\\ 0=4,\\end{aligned}\n$$\n\nwhere the fourth equation is always false. Therefore, the system has no solution and we conclude that \n\n$$\nx\\notin \\text{Span}{{b}_{1},{b}_{2},{b}_{3}}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-34764/selection/ma-v1/929bdad643697423e92232a4f0873f53f6ddf5cf7a0307e6c25f69b93e26a669"] :db/ensure [:question/validate]} {:db/id "q-35218/selection/81ec9cf26b4d634e9c6dd41dfa456114165178124fc4fbd86ade95b2369b8a6b" :answer/id #uuid "0336c701-b11c-5513-b084-e39045181e46" :answer/type :answer.type/math :answer/value "x\\notin \\text{span}{{b}_{1},{b}_{2}}" :db/ensure [:answer/validate]} {:db/id "q-35218/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "1ea84afc-8460-510b-af4b-13c9682f27a7" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-35218/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "56f75496-d833-5e48-8802-652af403d20f" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-35218/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "999ae8ae-067a-5f7f-a9c2-99588ff3291f" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-35218/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "b6262ea9-faf5-5c50-a682-f23f69671116" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-35218/selection" :answer-field/id #uuid "6e80b78c-9770-532d-9280-fc4aa6cff9d5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-35218/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-35218/selection/81ec9cf26b4d634e9c6dd41dfa456114165178124fc4fbd86ade95b2369b8a6b" "q-35218/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-35218/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-35218/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-35218/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-35218" :question/id #uuid "6262ea2d-1b8c-5ef7-8314-13d0b021a42e" :question/math-academy-id "q-35218" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B={{b}_{1},{b}_{2}},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}4 \\\\ 0 \\\\ -8\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}3 \\\\ -2 \\\\ 2\\end{aligned}],\\,x=[\\begin{aligned}10 \\\\ -4 \\\\ -4\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ then what is the value of ${x}_{1}+{x}_{2}?$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2} & =x \\\\ {x}_{1}[\\begin{aligned}4 \\\\ 0 \\\\ -8\\end{aligned}]+{x}_{2}[\\begin{aligned}3 \\\\ -2 \\\\ 2\\end{aligned}] & =[\\begin{aligned}10 \\\\ -4 \\\\ -4\\end{aligned}].\\end{aligned}\n$$\n\nThe equation above gives the system with the augmented matrix \n\n$$\nM=[\\begin{aligned}4 & 3 & 10 \\\\ 0 & -2 & -4 \\\\ -8 & 2 & -4\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}4 & 3 & 10 \\\\ 0 & -2 & -4 \\\\ -8 & 2 & -4\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼[\\begin{aligned}4 & 3 & 10 \\\\ 0 & -2 & -4 \\\\ 0 & 8 & 16\\end{aligned}] & {R}_{3} & :={R}_{3}+4{R}_{2} \\\\  & ∼[\\begin{aligned}4 & 3 & 10 \\\\ 0 & -2 & -4 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\n \n\nThe system is now \n\n$$\n{\\begin{aligned}4{x}_{1}+3{x}_{2}=10 \\\\ -2{x}_{2}=-4.\\end{aligned}\n$$\n\nFrom the second equation, we get ${x}_{2}=2.$ Substituting this into the first equation, we obtain\n\n$$\n4{x}_{1}+3\\cdot 2=10\\,⟹\\,{x}_{1}=1.\n$$\n\nTherefore, $[x]_{B}=[\\begin{aligned}1 \\\\ 2\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=1+2=3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-35218/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "841f498b-f737-5086-8f79-44f1a143bebb"] :knowledge-point/questions ["q-35218"] :db/ensure [:knowledge-point/validate]} {:db/id "q-75978/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "a45ac095-7173-5c16-ae91-98bc3a666f5d" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-75978/selection/f6dab1aaf947cb8c1f47690c13a34f270ff23312486a212e76af727dcf7e93a5" :answer/id #uuid "770c5fec-eafe-5148-968c-463cb3e6829e" :answer/type :answer.type/math :answer/value "x\\notin \\text{Span}{{b}_{1},{b}_{2},{b}_{3}}" :db/ensure [:answer/validate]} {:db/id "q-75978/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "25adc6ea-7510-5281-8f39-bdc696d378f1" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-75978/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "53bed3b7-231b-5590-90a4-37bce6a1440f" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-75978/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer/id #uuid "be07f9a6-5a2d-5659-947a-7368bbbcec1d" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "q-75978/selection" :answer-field/id #uuid "d030d03f-b2d0-5fe7-b249-5906677fc1cd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-75978/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-75978/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-75978/selection/f6dab1aaf947cb8c1f47690c13a34f270ff23312486a212e76af727dcf7e93a5" "q-75978/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-75978/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-75978/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96"] :db/ensure [:answer-field/validate]} {:db/id "q-75978" :question/id #uuid "52b5c214-bc2d-534d-b80a-9f39a6e9621b" :question/math-academy-id "q-75978" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B={{b}_{1},{b}_{2},{b}_{3}},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}],\\,{b}_{3}=[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}],\\,x=[\\begin{aligned}2 \\\\ -8 \\\\ 4\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]$ then what is the value of ${x}_{2}?$" :question/worked-solution "Remember, the order of the vectors in a basis is important.\n\nNotice that \n\n$$\n{{[\\begin{aligned}2 \\\\ -8 \\\\ 4\\end{aligned}]}_{⏟}}_{x}={{(\\,-8\\,)}_{⏟}}_{{x}_{1}}\\cdot {{[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]}_{⏟}}_{{b}_{1}}+{{(\\,4\\,)}_{⏟}}_{{x}_{2}}\\cdot {{[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]}_{⏟}}_{{b}_{2}}+{{(\\,2\\,)}_{⏟}}_{{x}_{3}}\\cdot {{[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]}_{⏟}}_{{b}_{3}}\n$$\n\nwhich means that\n\n$$\nx=-8\\cdot {b}_{1}+4\\cdot {b}_{2}+2\\cdot {b}_{3}\n$$\n\nand therefore\n\n$$\n[x]_{B}=[\\begin{aligned}-8 \\\\ 4 \\\\ 2\\end{aligned}],\n$$\n\nFinally, ${x}_{2}=4.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-75978/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a2926764-dfbc-5e4e-a6b0-db24a7298a64"] :knowledge-point/questions ["q-75978"] :db/ensure [:knowledge-point/validate]} {:db/id "q-112203/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "8c6cc9be-4f3f-5476-9381-77a31c7e54d6" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-112203/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "6218d430-4f42-5d4b-bf46-b135270ce4b2" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-112203/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "7c40e002-2750-5bca-aa67-7ad7b995382c" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-112203/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "4a36f596-d06c-58a5-b0a5-43a44efaa366" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-112203/selection/ee656f2f7acc785a949760828ef3e60f674870aa37fc70a0a8d876b682813bfb" :answer/id #uuid "6a8b83a1-01bf-5928-8908-3d5b523835d1" :answer/type :answer.type/math :answer/value "x\\notin \\text{Span}{{b}_{1},{b}_{2}}" :db/ensure [:answer/validate]} {:db/id "q-112203/selection" :answer-field/id #uuid "4f22d063-8a2c-58d2-b88f-d248441ec029" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-112203/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-112203/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-112203/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-112203/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-112203/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-112203/selection/ee656f2f7acc785a949760828ef3e60f674870aa37fc70a0a8d876b682813bfb"] :db/ensure [:answer-field/validate]} {:db/id "q-112203" :question/id #uuid "e2c04b67-de2c-5ab9-a498-90cefe771bc9" :question/math-academy-id "q-112203" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B={{b}_{1},{b}_{2}},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}],\\,x=[\\begin{aligned}0 \\\\ 8 \\\\ 3\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ then what is the value of ${x}_{1}?$" :question/worked-solution "Remember, the order of the vectors in a basis is important.\n\nNotice that \n\n$$\n{{[\\begin{aligned}0 \\\\ 8 \\\\ 3\\end{aligned}]}_{⏟}}_{x}={{(\\,3\\,)}_{⏟}}_{{x}_{1}}\\cdot {{[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]}_{⏟}}_{{b}_{1}}+{{(\\,8\\,)}_{⏟}}_{{x}_{2}}\\cdot {{[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]}_{⏟}}_{{b}_{2}}\n$$\n\nwhich means that\n\n$$\nx=3\\cdot {b}_{1}+8\\cdot {b}_{2}\n$$\n\nand therefore\n\n$$\n[x]_{B}=[\\begin{aligned}3 \\\\ 8\\end{aligned}].\n$$\n\nFinally, we have that ${x}_{1}=3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-112203/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a2926764-dfbc-5e4e-a6b0-db24a7298a64"] :knowledge-point/questions ["q-112203"] :db/ensure [:knowledge-point/validate]}]
