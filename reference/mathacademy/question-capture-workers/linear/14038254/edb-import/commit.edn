627 true] [17592186299685 1113 #uuid "51ebacf4-4834-51d5-a1f9-2ee93b265bad" 13194139534627 true] [17592186299685 1145 "Notice that the lower and upper limits are the same. So, the integral evaluates to zero:\n\n$$\n{\\int }_{\\pi /6}^{\\pi /6}\\frac{\\operatorname{sin}⁡x+2}{\\operatorname{cos}⁡x+3}\\,\\text{d}x=0\n$$" 13194139534627 true] [17592186299686 1000 #edb/ref 17592186299687 13194139534627 true] [17592186299686 1040 #edb/ref 17592186045449 13194139534627 true] [17592186299686 1041 "field-1" 13194139534627 true] [17592186299686 1104 #edb/ref 17592186299687 13194139534627 true] [17592186299686 1110 #uuid "25fa9f34-6ca3-5794-a56b-47c2db5b35dd" 13194139534627 true] [17592186299687 1034 "0" 13194139534627 true] [17592186299687 1103 #edb/ref 17592186045453 13194139534627 true] [17592186299687 1111 #uuid "1aabaa26-53df-545d-b909-1cebe7c902d2" 13194139534627 true] [17592186299688 1034 "221" 13194139534627 true] [17592186299688 1103 #edb/ref 17592186045453 13194139534627 true] [17592186299688 1111 #uuid "e5df40b7-7bf5-5abe-af09-2bf0ec8fff4d" 13194139534627 true] [17592186299689 1034 "36" 13194139534627 true] [17592186299689 1103 #edb/ref 17592186045453 13194139534627 true] [17592186299689 1111 #uuid "d08883f8-2bd8-51d9-9738-2b4a2ee078c2" 13194139534627 true] [17592186299690 1017 #edb/ref 17592186299691 13194139534627 true] [17592186299690 1089 "q-346197" 13194139534627 true] [17592186299690 1091 #edb/ref 17592186045463 13194139534627 true] [17592186299690 1100 "Given that ${\\int }_{-2}^{2}f(x)\\,\\text{d}x=1$ and ${\\int }_{2}^{6}f(x)\\,\\text{d}x=3,$ \nthen what is ${\\int }_{-2}^{6}(6f(x)+1)\\,\\text{d}x?$\n\n${\\int }_{-2}^{6}(6f(x)+1)\\,\\text{d}x=$ \n{{field-1}}" 13194139534627 true] [17592186299690 1113 #uuid "a3a94b52-09ef-5e3b-95bc-abd8e35262ec" 13194139534627 true] [17592186299690 1145 "From the adjacent intervals rule, we know that\n\n$$\n{\\int }_{-2}^{2}f(x)\\,\\text{d}x+{\\int }_{2}^{6}f(x)\\,\\text{d}x={\\int }_{-2}^{6}f(x)\\,\\text{d}x.\n$$\n\nPlugging in the known information gives\n\n$$\n1+3={\\int }_{-2}^{6}f(x)\\,\\text{d}x\\,⇒\\,{\\int }_{-2}^{6}f(x)\\,\\text{d}x=4.\n$$\n\nFinally, compute the desired integral:\n\n$$\n\\begin{aligned}{\\int }_{-2}^{6}(6f(x)+1)\\,\\text{d}x & =6{\\int }_{-2}^{6}f(x)\\,\\text{d}x+{\\int }_{-2}^{6}1\\,\\text{d}x \\\\  & =6(4)+x\\,{|}_{-2}^{6} \\\\  & =24+(6-(-2)) \\\\  & =24+8 \\\\  & =32\\end{aligned}\n$$" 13194139534627 true] [17592186299691 1000 #edb/ref 17592186299692 13194139534627 true] [17592186299691 1040 #edb/ref 17592186045449 13194139534627 true] [17592186299691 1041 "field-1" 13194139534627 true] [17592186299691 1104 #edb/ref 17592186299692 13194139534627 true] [17592186299691 1110 #uuid "8a43a8be-fd07-5e4f-b858-31c70459151b" 13194139534627 true] [17592186299692 1034 "32" 13194139534627 true] [17592186299692 1103 #edb/ref 17592186045453 13194139534627 true] [17592186299692 1111 #uuid "ca7b46ee-dca8-5a16-910f-d6a0eae420e3" 13194139534627 true] [17592186299693 1017 #edb/ref 17592186299694 13194139534627 true] [17592186299693 1089 "q-346209" 13194139534627 true] [17592186299693 1091 #edb/ref 17592186045465 13194139534627 true] [17592186299693 1100 "Suppose that $f(x)$ is a function such that ${\\int }_{8}^{3}\\frac{5}{2}\\,f(x)\\,\\text{d}x=15$ and ${\\int }_{2}^{3}f(x)\\,\\text{d}x=\\frac{7}{2}.$ What is the value of ${\\int }_{2}^{8}f(x)\\,\\text{d}x?$\n\n${\\int }_{2}^{8}f(x)\\,\\text{d}x=$\n{{field-1}}" 13194139534627 true] [17592186299693 1113 #uuid "094c3f1e-b09f-5c71-8d44-1fe87887214f" 13194139534627 true] [17592186299693 1145 "Let's simplify one of the given integrals:\n\n$$\n\\begin{aligned}{\\int }_{8}^{3}\\frac{5}{2}\\,f(x)\\,\\text{d}x & =15 \\\\ \\frac{5}{2}{\\int }_{8}^{3}f(x)\\,\\text{d}x & =15 \\\\ -\\frac{5}{2}{\\int }_{3}^{8}f(x)\\,\\text{d}x & =15 \\\\ {\\int }_{3}^{8}f(x)\\,\\text{d}x & =-6\\end{aligned}\n$$\n\nThen, from the adjacent intervals rule, we get\n\n$$\n\\begin{aligned}{\\int }_{2}^{8}f(x)\\,\\text{d}x & ={\\int }_{2}^{3}f(x)\\,\\text{d}x+{\\int }_{3}^{8}f(x)\\,\\text{d}x \\\\  & =\\frac{7}{2}+(-6) \\\\  & =-\\frac{5}{2}.\\end{aligned}\n$$" 13194139534627 true] [17592186299694 1000 #edb/ref 17592186299695 13194139534627 true] [17592186299694 1040 #edb/ref 17592186045449 13194139534627 true] [17592186299694 1041 "field-1" 13194139534627 true] [17592186299694 1104 #edb/ref 17592186299695 13194139534627 true] [17592186299694 1110 #uuid "7e17e6cb-5215-5a37-9c99-a3d8004de3f3" 13194139534627 true] [17592186299695 1034 "-\\frac{5}{2}" 13194139534627 true] [17592186299695 1103 #edb/ref 17592186045453 13194139534627 true] [17592186299695 1111 #uuid "e65620d8-eaaa-5171-823e-087857c22465" 13194139534627 true] [17592186299696 1017 #edb/ref 17592186299697 13194139534627 true] [17592186299696 1089 "q-4725" 13194139534627 true] [17592186299696 1091 #edb/ref 17592186045465 13194139534627 true] [17592186299696 1100 "Suppose that $f(x)$ is a  function such that ${\\int }_{5}^{12}f(x)\\,\\text{d}x=12$ and ${\\int }_{5}^{-5}6\\,f(x)\\,\\text{d}x=18.$ What is the value of ${\\int }_{-5}^{12}f(x)\\,\\text{d}x?$" 13194139534627 true] [17592186299696 1113 #uuid "9158dfe0-6963-54d7-b306-c014d6cd6bf4" 13194139534627 true] [17592186299696 1145 "Let's simplify one of the given integrals:\n\n$$\n\\begin{aligned}{\\int }_{5}^{-5}6\\,f(x)\\,\\text{d}x & =18 \\\\ 6{\\int }_{5}^{-5}\\,f(x)\\,\\text{d}x & =18 \\\\ -6{\\int }_{-5}^{5}f(x)\\,\\text{d}x & =18 \\\\ {\\int }_{-5}^{5}f(x)\\,\\text{d}x & =-3\\end{aligned}\n$$\n\nThen, from the adjacent intervals rule, we get  \n\n$$\n\\begin{aligned}{\\int }_{-5}^{12}f(x)\\,\\text{d}x & ={\\int }_{-5}^{5}f(x)\\,\\text{d}x+{\\int }_{5}^{12}f(x)\\,\\text{d}x \\\\  & =-3+12 \\\\  & =9.\\end{aligned}\n$$" 13194139534627 true] [17592186299697 1000 #edb/ref 17592186299698 13194139534627 true] [17592186299697 1000 #edb/ref 17592186299699 13194139534627 true] [17592186299697 1000 #edb/ref 17592186299700 13194139534627 true] [17592186299697 1000 #edb/ref 17592186299701 13194139534627 true] [175921