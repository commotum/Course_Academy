7592186299687}] :answer-field/correct {:answer/id #uuid "1aabaa26-53df-545d-b909-1cebe7c902d2" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186299687} :answer-field/id #uuid "25fa9f34-6ca3-5794-a56b-47c2db5b35dd" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299686}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "51ebacf4-4834-51d5-a1f9-2ee93b265bad" :question/math-academy-id "q-345635" :question/problem "Evaluate the following integral:\n\n${\\int }_{\\pi /6}^{\\pi /6}\\frac{\\operatorname{sin}⁡x+2}{\\operatorname{cos}⁡x+3}\\,\\text{d}x=$ \n{{field-1}}" :question/worked-solution "Notice that the lower and upper limits are the same. So, the integral evaluates to zero:\n\n$$\n{\\int }_{\\pi /6}^{\\pi /6}\\frac{\\operatorname{sin}⁡x+2}{\\operatorname{cos}⁡x+3}\\,\\text{d}x=0\n$$"}] [{:db/id #edb/ref 17592186298356 :knowledge-point/_questions [{:knowledge-point/id #uuid "ff2f1a9d-2b0e-5a18-98d5-4f49f6f1527b" :knowledge-point/title "Evaluating an Integral Given Another Integral With Reversed Limits of Integration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a7fbd40-a307-5e2a-9ca7-da314561c49b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{33}{2}" :db/id #edb/ref 17592186298358}] :answer-field/correct {:answer/id #uuid "5a7fbd40-a307-5e2a-9ca7-da314561c49b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{33}{2}" :db/id #edb/ref 17592186298358} :answer-field/id #uuid "cf2e93b8-c705-5690-ac25-ecf35f01f174" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298357}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a789764d-6c23-5081-bf29-e1cefd94e0a5" :question/math-academy-id "q-346059" :question/problem "Given that ${\\int }_{0}^{-3}\\,f(x)\\,\\text{d}x=6,$ calculate ${\\int }_{-3}^{0}(5x-f(x))\\,\\text{d}x.$\n\n${\\int }_{-3}^{0}(5x-f(x))\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{-3}^{0}\\,f(x)\\,\\text{d}x=-{\\int }_{0}^{-3}\\,f(x)\\,\\text{d}x=-6\\end{aligned}\n$$\n\nNow, we can split up the given integral using the sum rule and factor out the constants. We get\n\n$$\n\\begin{aligned}{\\int }_{-3}^{0}(5x-f(x))\\,\\text{d}x & =5{\\int }_{-3}^{0}x\\,\\text{d}x\\,-\\,{\\int }_{-3}^{0}f(x)\\,\\text{d}x \\\\  & =5\\cdot \\frac{{x}^{2}}{2}\\,{|}_{-3}^{0}\\,-\\,(-6) \\\\  & =5\\cdot \\frac{0-9}{2}\\,+\\,6 \\\\  & =-\\frac{45}{2}\\,+\\,6 \\\\  & =-\\frac{33}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186298363 :knowledge-point/_questions [{:knowledge-point/id #uuid "ff2f1a9d-2b0e-5a18-98d5-4f49f6f1527b" :knowledge-point/title "Evaluating an Integral Given Another Integral With Reversed Limits of Integration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f3a01c27-b258-5f2f-8181-05b3000f48a8" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186298365} {:answer/id #uuid "522d036b-4e1a-5bf6-94e7-e1a343f49cc8" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186298366} {:answer/id #uuid "e5df40b7-7bf5-5abe-af09-2bf0ec8fff4d" :answer/type {:db/ident :answer.type/math} :answer/value "221" :db/id #edb/ref 17592186299688}] :answer-field/correct {:answer/id #uuid "f3a01c27-b258-5f2f-8181-05b3000f48a8" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186298365} :answer-field/id #uuid "32c7b002-864b-5b0e-b82d-79cd606e879a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298364}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "443dc647-fc7d-5181-add0-610b67501f3f" :question/math-academy-id "q-346181" :question/problem "Given that ${\\int }_{6}^{-3}\\,f(x)\\,\\text{d}x=\\frac{113}{9},$ calculate ${\\int }_{-3}^{6}(9f(x)+8x)\\,\\text{d}x.$\n\n${\\int }_{-3}^{6}(9f(x)+8x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{-3}^{6}\\,f(x)\\,\\text{d}x=-{\\int }_{6}^{-3}\\,f(x)\\,\\text{d}x=-\\frac{113}{9}\\end{aligned}\n$$\n\nNow, we can split up the given integral using the sum rule and factor out the constants. We get\n\n$$\n\\begin{aligned}{\\int }_{-3}^{6}(9f(x)+8x)\\,\\text{d}x & =9{\\int }_{-3}^{6}f(x)\\,\\text{d}x\\,+\\,8{\\int }_{-3}^{6}x\\,\\text{d}x \\\\  & =9(-\\frac{113}{9})\\,+\\,8\\cdot \\frac{{x}^{2}}{2}\\,{|}_{-3}^{6} \\\\  & =-113\\,+\\,8\\cdot \\frac{{6}^{2}-(-3)^{2}}{2} \\\\  & =-113\\,+\\,8\\cdot \\frac{27}{2} \\\\  & =-113\\,+\\,108 \\\\  & =-5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186298370 :knowledge-point/_questions [{:knowledge-point/id #uuid "9693b76e-ba77-5314-bfbf-508b25bb1072" :knowledge-point/title "Evaluating a Definite Integral Given Integrals Over Adjacent Intervals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01080b51-c0d9-5a7d-9e36-5bc67d4b4cae" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186298372} {:answer/id #uuid "d08883f8-2bd8-51d9-9738-2b4a2ee078c2" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186299689}] :answer-field/correct {:answer/id #uuid "01080b51-c0d9-5a7d-9e36-5bc67d4b4cae" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186298372} :answer-field/id #uuid "55dc33ab-63c5-507f-9f01-dd46c490a9e8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298371}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "abacc09f-e24f-5083-9902-ea5b1af36c84" :question/math-academy-id "q-346187" :question/problem "Given that ${\\int }_{4}^{6}f(x)\\,\\text{d}x=-1$ and ${\\int }_{6}^{10}f(x)\\,\\text{d}x=11,$ \nthen what is ${\\int }_{4}^{10}(6-3f(x))\\,\\text{d}x?$\n\n${\\int }_{4}^{10}(6-3f(x))\\,\\text{d}x=$ \n{{field-1}}" :question/worked-solution "From the adjacent intervals rule, we know that\n\n$$\n{\\int }_{4}^{6}f(x)\\,\\text{d}x+{\\int }_{6}^{10}f(x)\\,\\text{d}x={\\int }_{4}^{10}f(x)\\,\\text{d}x.\n$$\n\nPlugging in the known information gives\n\n$$\n(-1)+11={\\int }_{4}^{10}f(x)\\,\\text{d}x\\,⇒\\,{\\int }_{4}^{10}f(x)\\,\\text{d}x=10.\n$$\n\nFinally, compute the desired integral:\n\n$$\n\\begin{aligned}{\\int }_{4}^{10}(6-3f(x))\\,\\text{d}x & =6{\\int }_{4}^{10}1\\,\\text{d}x-3{\\int }_{4}^{10}f(x)\\,\\text{d}x \\\\  & =6\\cdot x{|}_{4}^{10}-3(10) \\\\  & =6(10-4)-30 \\\\  & =36-30 \\\\  & =6\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299690 :knowledge-point/_questions [{:knowledge-point/id #uuid "9693b76e-ba77-5314-bfbf-508b25bb1072" :knowledge-point/title "Evaluating a Definite Integral Given Integrals Over Adjacent Intervals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ca7b46ee-dca8-5a16-910f-d6a0eae420e3" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186299692}] :answer-field/correct {:answer/id #uuid "ca7b46ee-dca8-5a16-910f-d6a0eae420e3" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186299692} :answer-field/id #uuid "8a43a8be-fd07-5e4f-b858-31c70459151b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299691}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a3a94b52-09ef-5e3b-95bc-abd8e35262ec" :question/math-academy-id "q-346197" :question/problem "Given that ${\\int }_{-2}^{2}f(x)\\,\\text{d}x=1$ and ${\\int }_{2}^{6}f(x)\\,\\text{d}x=3,$ \nthen what is ${\\int }_{-2}^{6}(6f(x)+1)\\,\\text{d}x?$\n\n${\\int }_{-2}^{6}(6f(x)+1)\\,\\text{d}x=$ \n{{field-1}}" :question/worked-solution "From the adjacent intervals rule, we know that\n\n$$\n{\\int }_{-2}^{2}f(x)\\,\\text{d}x+{\\int }_{2}^{6}f(x)\\,\\text{d}x={\\int }_{-2}^{6}f(x)\\,\\text{d}x.\n$$\n\nPlugging in the known information gives\n\n$$\n1+3={\\int }_{-2}^{6}f(x)\\,\\text{d}x\\,⇒\\,{\\int }_{-2}^{6}f(x)\\,\\text{d}x=4.\n$$\n\nFinally, compute the desired integral:\n\n$$\n\\begin{aligned}{\\int }_{-2}^{6}(6f(x)+1)\\,\\text{d}x & =6{\\int }_{-2}^{6}f(x)\\,\\text{d}x+{\\int }_{-2}^{6}1\\,\\text{d}x \\\\  & =6(4)+x\\,{|}_{-2}^{6} \\\\  & =24+(6-(-2)) \\\\  & =24+8 \\\\  & =32\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299693 :knowledge-point/_questions [{:knowledge-point/id #uuid "1d752aac-6187-595d-8818-b0179fd7380e" :knowledge-point/title "Evaluating a Definite Integral Using Multiple Properties of Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e65620d8-eaaa-5171-823e-087857c22465" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186299695}] :answer-field/correct {:answer/id #uuid "e65620d8-eaaa-5171-823e-087857c22465" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186299695} :answer-field/id #uuid "7e17e6cb-5215-5a37-9c99-a3d8004de3f3" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299694}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "094c3f1e-b09f-5c71-8d44-1fe87887214f" :question/math-academy-id "q-346209" :question/problem "Suppose that $f(x)$ is a function such that ${\\int }_{8}^{3}\\frac{5}{2}\\,f(x)\\,\\text{d}x=15$ and ${\\int }_{2}^{3}f(x)\\,\\text{d}x=\\frac{7}{2}.$ What is the value of ${\\int }_{2}^{8}f(x)\\,\\text{d}x?$\n\n${\\int }_{2}^{8}f(x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's simplify one of the given integrals:\n\n$$\n\\begin{aligned}{\\int }_{8}^{3}\\frac{5}{2}\\,f(x)\\,\\text{d}x & =15 \\\\ \\frac{5}{2}{\\int }_{8}^{3}f(x)\\,\\text{d}x & =15 \\\\ -\\frac{5}{2}{\\int }_{3}^{8}f(x)\\,\\text{d}x & =15 \\\\ {\\int }_{3}^{8}f(x)\\,\\text{d}x & =-6\\end{aligned}\n$$\n\nThen, from the adjacent intervals rule, we get\n\n$$\n\\begin{aligned}{\\int }_{2}^{8}f(x)\\,\\text{d}x & ={\\int }_{2}^{3}f(x)\\,\\text{d}x+{\\int }_{3}^{8}f(x)\\,\\text{d}x \\\\  & =\\frac{7}{2}+(-6) \\\\  & =-\\frac{5}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299696 :knowledge-point/_questions [{:knowledge-point/id #uuid "1d752aac-6187-595d-8818-b0179fd7380e" :knowledge-point/title "Evaluating a Definite Integral Using Multiple Properties of Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7643b430-6a58-567f-8afb-0d2bab38dd10" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186299698} {:answer/id #uuid "650fcab9-82e9-5458-ba93-6b01ad0c05e0" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186299699} {:answer/id #uuid "12202125-5933-5fd5-b801-e5c47fe9e606" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186299700} {:answer/id #uuid "2489c7a1-1702-56f4-895d-9e79182e8fd0" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186299701} {:answer/id #uuid "95a14ead-c92b-5ca8-9ed3-b7308b8f3643" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186299702}] :answer-field/correct {:answer/id #uuid "7643b430-6a58-567f-8afb-0d2bab38dd10" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186299698} :answer-field/id #uuid "d3e0bf60-af5c-53b0-b458-194e62e27b2d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186299697}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "9158dfe0-6963-54d7-b306-c014d6cd6bf4" :question/math-academy-id "q-4725" :question/problem "Suppose that $f(x)$ is a  function such that ${\\int }_{5}^{12}f(x)\\,\\text{d}x=12$ and ${\\int }_{5}^{-5}6\\,f(x)\\,\\text{d}x=18.$ What is the value of ${\\int }_{-5}^{12}f(x)\\,\\text{d}x?$" :question/worked-solution "Let's simplify one of the given integrals:\n\n$$\n\\begin{aligned}{\\int }_{5}^{-5}6\\,f(x)\\,\\text{d}x & =18 \\\\ 6{\\int }_{5}^{-5}\\,f(x)\\,\\text{d}x & =18 \\\\ -6{\\int }_{-5}^{5}f(x)\\,\\text{d}x & =18 \\\\ {\\int }_{-5}^{5}f(x)\\,\\text{d}x & =-3\\end{aligned}\n$$\n\nThen, from the adjacent intervals rule, we get  \n\n$$\n\\begin{aligned}{\\int }_{-5}^{12}f(x)\\,\\text{d}x & ={\\int }_{-5}^{5}f(x)\\,\\text{d}x+{\\int }_{5}^{12}f(x)\\,\\text{d}x \\\\  & =-3+12 \\\\  & =9.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186298373 :knowledge-point/_questions [{:knowledge-point/id #uuid "1d752aac-6187-595d-8818-b0179fd7380e" :knowledge-point/title "Evaluating a Definite Integral Using Multiple Properties of Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad292ea9-dd5f-5514-b897-9d26801459df" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186298375} {:answer/id #uuid "5dd4e0dc-2414-5dbd-a02c-4ed071f332f4" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186298376} {:answer/id #uuid "ee03515b-63c9-5a57-a099-0a91174bb038" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186298377} {:answer/id #uuid "e9c8eb6d-129d-5988-aaeb-86043df1b923" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186298378} {:answer/id #uuid "7c3b158d-7679-5c83-ba2f-9c82989ff367" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186298379}] :answer-field/correct {:answer/id #uuid "7c3b158d-7679-5c83-ba2f-9c82989ff367" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186298379} :answer-field/id #uuid "55d599d0-48dd-5bd4-bca8-58ce8dd874e0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186298374}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "e39e611c-2e6a-5118-851f-9558e33dfe9e" :question/math-academy-id "q-4726" :question/problem "Let $f$ and $g$ be continuous functions such that ${\\int }_{0}^{7}f(x)\\,\\text{d}x=18,{\\int }_{0}^{7}\\frac{1}{2}g(x)\\,\\text{d}x=5,$ and ${\\int }_{3}^{7}(f(x)-g(x))\\text{d}x=4.$ What is the value of ${\\int }_{0}^{3}(f(x)-g(x))\\text{d}x?$" :question/worked-solution "Let's simplify one of the given integrals:\n\n$$\n\\begin{aligned}{\\int }_{0}^{7}\\frac{1}{2}\\,g(x)\\,\\text{d}x & =5 \\\\ \\frac{1}{2}{\\int }_{0}^{7}g(x)\\,\\text{d}x & =5 \\\\ {\\int }_{0}^{7}g(x)\\,\\text{d}x & =10\\end{aligned}\n$$\n\nThen, using the adjacent intervals rule and substituting the known values, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{7}(f(x)-g(x))\\text{d}x & ={\\int }_{0}^{3}(f(x)-g(x))\\text{d}x+{\\int }_{3}^{7}(f(x)-g(x))\\text{d}x \\\\ {\\int }_{0}^{7}(f(x)-g(x))\\text{d}x & ={\\int }_{0}^{3}(f(x)-g(x))\\text{d}x+4.\\end{aligned}\n$$\n\nFinally, by applying the sum rule for definite integrals and substituting the known values, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{7}(f(x)-g(x))\\text{d}x & ={\\int }_{0}^{3}(f(x)-g(x))\\text{d}x+4 \\\\ {\\int }_{0}^{7}f(x)\\,\\text{d}x-{\\int }_{0}^{7}g(x)\\,\\text{d}x & ={\\int }_{0}^{3}(f(x)-g(x))\\text{d}x+4 \\\\ 18-10 & ={\\int }_{0}^{3}(f(x)-g(x))\\text{d}x+4 \\\\ 4 & ={\\int }_{0}^{3}(f(x)-g(x))\\text{d}x\\end{aligned}\n$$\n\nTherefore, ${\\int }_{0}^{3}(f(x)-g(x))\\text{d}x=4.$"}] [{:db/id #edb/ref 17592186298387 :knowledge-point/_questions [{:knowledge-point/id #uuid "1d752aac-6187-595d-8818-b0179fd7380e" :knowledge-point/title "Evaluating a Definite Integral Using Multiple Properties of Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49e8904f-7cbe-5fcf-8a34-e9861f46e3f3" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186298389} {:answer/id #uuid "b1a1b409-1a13-52dc-93b6-19a7061f9933" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186298390} {:answer/id #uuid "a9ee562e-1a00-517d-81a4-7041ea4d844f" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186298391} {:answer/id #uuid "b5d95299-ac10-5eb9-b5f6-19067958467c" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186298392} {:answer/id #uuid "5a48057a-c503-527e-b209-24eb83285ac3" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186298393}] :answer-field/correct {:answer/id #uuid "5a48057a-c503-527e-b209-24eb83285ac3" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186298393} :answer-field/id #uuid "81ae0418-fa3d-59f6-8cd8-b0a00150d751" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186298388}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "2f7e1e9b-4799-51a0-a138-eeebd44e608b" :question/math-academy-id "q-4795" :question/problem "Suppose that $f(x)$ is a  function such that ${\\int }_{2}^{7}f(x)\\,\\text{d}x=8$ and ${\\int }_{2}^{0}2f(x)\\,\\text{d}x=4.$ What is the value of ${\\int }_{0}^{7}f(x)\\,\\text{d}x?$" :question/worked-solution "Let's simplify one of the given integrals:\n\n$$\n\\begin{aligned}{\\int }_{2}^{0}2f(x)\\,\\text{d}x & =4 \\\\ 2{\\int }_{2}^{0}f(x)\\,\\text{d}x & =4 \\\\ -2{\\int }_{0}^{2}f(x)\\,\\text{d}x & =4 \\\\ {\\int }_{0}^{2}f(x)\\,\\text{d}x & =-2\\end{aligned}\n$$\n\nThen, from the adjacent intervals rule, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{7}f(x)\\,\\text{d}x & ={\\int }_{0}^{2}f(x)\\,\\text{d}x+{\\int }_{2}^{7}f(x)\\,\\text{d}x \\\\  & =(-2)+8 \\\\  & =6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299703 :knowledge-point/_questions [{:knowledge-point/id #uuid "7a2c6bf6-41f2-5f8d-8799-5664ba941dc8" :knowledge-point/title "Evaluating an Integral Over an Interval of Length Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5dc6ed21-4d14-5487-9e2a-cd7137502302" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{31}" :db/id #edb/ref 17592186299705} {:answer/id #uuid "8ddbe6ee-3579-5f79-a8dc-bf9830a4b795" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186299706} {:answer/id #uuid "88c5ad39-d8bb-5051-ad7c-cc706e6cfd20" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186299707} {:answer/id #uuid "6ac1308a-ed19-5aac-ab91-83edf5215d3d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{31}" :db/id #edb/ref 17592186299708} {:answer/id #uuid "c70deaec-200f-50f2-b249-669d65f73ade" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186299709}] :answer-field/correct {:answer/id #uuid "c70deaec-200f-50f2-b249-669d65f73ade" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186299709} :answer-field/id #uuid "39e36167-84f9-5e67-be00-821f7eaf5a43" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186299704}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a43c6ed7-caed-50ef-a12f-59346cc46a69" :question/math-academy-id "q-73282" :question/problem "Calculate ${\\int }_{-2}^{-2}\\frac{1}{1+{x}^{5}}\\,\\text{d}x.$" :question/worked-solution "Notice that the lower and upper limits are the same. So, the integral evaluates to zero:\n\n$$\n{\\int }_{-2}^{-2}\\frac{1}{1+{x}^{5}}\\,\\text{d}x=0\n$$"}] [{:db/id #edb/ref 17592186299710 :knowledge-point/_questions [{:knowledge-point/id #uuid "ff2f1a9d-2b0e-5a18-98d5-4f49f6f1527b" :knowledge-point/title "Evaluating an Integral Given Another Integral With Reversed Limits of Integration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8da95193-8058-5c27-8283-3b59408ff8b4" :answer/type {:db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186299712} {:answer/id #uuid "fe147f2b-dd6c-50a2-8624-dcc10267850e" :answer/type {:db/ident :answer.type/math} :answer/value "-46" :db/id #edb/ref 17592186299713} {:answer/id #uuid "4f594b83-07c0-5c45-926e-4094083fdce0" :answer/type {:db/ident :answer.type/math} :answer/value "-23" :db/id #edb/ref 17592186299714} {:answer/id #uuid "d66cd3d1-e484-558e-baa3-b97b1c04ee50" :answer/type {:db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186299715} {:answer/id #uuid "90180e16-1913-5b30-a0b9-291e401355ce" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186299716}] :answer-field/correct {:answer/id #uuid "8da95193-8058-5c27-8283-3b59408ff8b4" :answer/type {:db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186299712} :answer-field/id #uuid "1d454a38-9ba8-58f8-b68e-2af8dc76037b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186299711}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "045da1f5-585f-50b0-a924-5246fd98534c" :question/math-academy-id "q-73319" :question/problem "Given that ${\\int }_{5}^{1}\\,f(x)\\,\\text{d}x=-2$, calculate\n${\\int }_{1}^{5}(f(x)+4x)\\,\\text{d}x.$" :question/worked-solution "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{1}^{5}\\,f(x)\\,\\text{d}x=-{\\int }_{5}^{1}\\,f(x)\\,\\text{d}x=2\\end{aligned}\n$$\n\n \n\nNow, we can split up the given integral using the sum rule and factoring out the constants. We get\n\n$$\n\\begin{aligned}{\\int }_{1}^{5}(f(x)+4x)\\,\\text{d}x & ={\\int }_{1}^{5}f(x)\\,\\text{d}x+4{\\int }_{1}^{5}x\\,\\text{d}x \\\\  & =2+4\\cdot {\\frac{{x}^{2}}{2}\\,|}_{1}^{5} \\\\  & =2+2({5}^{2}-{1}^{2}) \\\\  & =2+48 \\\\  & =50.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299717 :knowledge-point/_questions [{:knowledge-point/id #uuid "9693b76e-ba77-5314-bfbf-508b25bb1072" :knowledge-point/title "Evaluating a Definite Integral Given Integrals Over Adjacent Intervals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62986d9f-787b-52ea-beb1-7ab62ba412b1" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186299719} {:answer/id #uuid "42cec27c-6635-518c-85f2-e610275da339" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186299720} {:answer/id #uuid "0de6a3ae-c754-52b2-ac18-4be79113b5ea" :answer/type {:db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186299721} {:answer/id #uuid "e2dbe223-645b-5df0-b654-807a3d10ff05" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186299722} {:answer/id #uuid "a9968c03-d588-573c-9507-cbc3422119e0" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186299723}] :answer-field/correct {:answer/id #uuid "42cec27c-6635-518c-85f2-e610275da339" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186299720} :answer-field/id #uuid "3fbb5dbd-83e9-54c1-9085-a33407090a26" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186299718}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f0db4b9e-8908-5d65-a628-6adf818864cf" :question/math-academy-id "q-73341" :question/problem "Given that ${\\int }_{3}^{4}f(x)\\,\\text{d}x=2$ and ${\\int }_{4}^{7}f(x)\\,\\text{d}x=6$ then what is ${\\int }_{3}^{7}(2f(x)+3)\\,\\text{d}x?$" :question/worked-solution "From the adjacent intervals rule, we know that\n\n$$\n\\begin{aligned}{\\int }_{3}^{4}f(x)\\,\\text{d}x+{\\int }_{4}^{7}f(x)\\,\\text{d}x={\\int }_{3}^{7}f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nPlugging in the known information into the above gives the following:\n\n$$\n\\begin{aligned}2+6={\\int }_{3}^{7}f(x)\\,\\text{d}x \\\\ 8={\\int }_{3}^{7}f(x)\\,\\text{d}x\\end{aligned}\n$$\n\nFinally, we compute the desired integral and get\n\n$$\n\\begin{aligned}{\\int }_{3}^{7}(2f(x)+3)\\,\\text{d}x & =2{\\int }_{3}^{7}f(x)\\,\\text{d}x+3{\\int }_{3}^{7}\\,\\text{d}x \\\\  & =2(8)+3\\cdot x\\,{|}_{3}^{7} \\\\  & =16+3(7-3) \\\\  & =28.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186298401 :knowledge-point/_questions [{:knowledge-point/id #uuid "9693b76e-ba77-5314-bfbf-508b25bb1072" :knowledge-point/title "Evaluating a Definite Integral Given Integrals Over Adjacent Intervals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34252ab6-fa19-5895-a0e0-0dc3a26dfb6c" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186298403} {:answer/id #uuid "4c340bc5-4510-59f3-945b-72aaa54dacb6" :answer/type {:db/ident :answer.type/math} :answer/value "34" :db/id #edb/ref 17592186298404} {:answer/id #uuid "4c6b8493-9750-5e2b-b79e-f0a945888ca3" :answer/type {:db/ident :answer.type/math} :answer/value "33" :db/id #edb/ref 17592186298405} {:answer/id #uuid "2b81ae64-1626-5219-922b-3aab9508aef5" :answer/type {:db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186298406} {:answer/id #uuid "f2db9976-3a9a-5eaf-921f-70211aaea110" :answer/type {:db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186298407}] :answer-field/correct {:answer/id #uuid "4c340bc5-4510-59f3-945b-72aaa54dacb6" :answer/type {:db/ident :answer.type/math} :answer/value "34" :db/id #edb/ref 17592186298404} :answer-field/id #uuid "b8a38726-a848-5322-86a1-54290e3fc398" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186298402}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b061a43c-1108-5502-a0d5-189a5c9a0b07" :question/math-academy-id "q-73350" :question/problem "Given that ${\\int }_{0}^{3}f(x)\\,\\text{d}x=5$ and ${\\int }_{3}^{6}f(x)\\,\\text{d}x=\\frac{1}{3}$ then what is ${\\int }_{0}^{6}(3f(x)+3)\\,\\text{d}x?$" :question/worked-solution "From the adjacent intervals rule, we know that\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}f(x)\\,\\text{d}x+{\\int }_{3}^{6}f(x)\\,\\text{d}x={\\int }_{0}^{6}f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nPlugging in the known information into the above gives the following:\n\n$$\n\\begin{aligned}5+\\frac{1}{3}={\\int }_{0}^{6}f(x)\\,\\text{d}x \\\\ \\frac{16}{3}={\\int }_{0}^{6}f(x)\\,\\text{d}x\\end{aligned}\n$$\n\nFinally, we compute the desired integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{6}(3f(x)+3)\\,\\text{d}x & =3{\\int }_{0}^{6}f(x)\\,\\text{d}x+3{\\int }_{0}^{6}\\,\\text{d}x \\\\  & =3(\\frac{16}{3})+3\\cdot x\\,{|}_{0}^{6} \\\\  & =16+3(6-0) \\\\  & =34.\\end{aligned}\n$$"}]}
