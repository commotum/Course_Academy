2 & -2\\end{aligned}] \\\\  & =\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 & -2 & 3 \\\\ -9 & 2 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{\\sqrt{2}} & -\\sqrt{2} & \\frac{3}{\\sqrt{2}} \\\\ -\\frac{9}{\\sqrt{2}} & \\sqrt{2} & -\\frac{1}{\\sqrt{2}}\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are \n\n$$\n(\\frac{1}{\\sqrt{2}},-\\frac{9}{\\sqrt{2}}),\\,(-\\sqrt{2},\\sqrt{2}),\\,(\\frac{3}{\\sqrt{2}},-\\frac{1}{\\sqrt{2}}).\n$$\n\nSo, the correct answer is \"I only.\"" 13194139535277 true] [17592186341182 1000 #edb/ref 17592186341183 13194139535277 true] [17592186341182 1000 #edb/ref 17592186341184 13194139535277 true] [17592186341182 1000 #edb/ref 17592186341185 13194139535277 true] [17592186341182 1000 #edb/ref 17592186341186 13194139535277 true] [17592186341182 1000 #edb/ref 17592186341187 13194139535277 true] [17592186341182 1040 #edb/ref 17592186045450 13194139535277 true] [17592186341182 1041 "selection" 13194139535277 true] [17592186341182 1104 #edb/ref 17592186341184 13194139535277 true] [17592186341182 1110 #uuid "0a037ae4-f475-5b77-8a80-815950d0ed7a" 13194139535277 true] [17592186341183 1034 "I and III only" 13194139535277 true] [17592186341183 1103 #edb/ref 17592186045454 13194139535277 true] [17592186341183 1111 #uuid "a292373a-0678-503f-b6b2-face9659abcf" 13194139535277 true] [17592186341184 1034 "I only" 13194139535277 true] [17592186341184 1103 #edb/ref 17592186045454 13194139535277 true] [17592186341184 1111 #uuid "fd86f9b4-2355-5769-a6f5-faf7b0d12fad" 13194139535277 true] [17592186341185 1034 "III only" 13194139535277 true] [17592186341185 1103 #edb/ref 17592186045454 13194139535277 true] [17592186341185 1111 #uuid "f806d4a5-4506-5b33-871c-4dd9744adbc7" 13194139535277 true] [17592186341186 1034 "I and II only" 13194139535277 true] [17592186341186 1103 #edb/ref 17592186045454 13194139535277 true] [17592186341186 1111 #uuid "0bdd1861-289b-5d16-a934-6f3fc430a970" 13194139535277 true] [1759