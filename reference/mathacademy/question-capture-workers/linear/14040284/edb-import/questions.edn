C$" :db/id #edb/ref 17592186195322} {:answer/id #uuid "71bac5b8-cff3-5995-8451-3a97664bf3a3" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186195323}] :answer-field/correct {:answer/id #uuid "71bac5b8-cff3-5995-8451-3a97664bf3a3" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186195323} :answer-field/id #uuid "b1af7eea-31a3-54f3-a457-f175984dd3f3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186195318}] :question/id #uuid "9d5b151a-6cd5-5110-8e22-9ecd5205fa7c" :question/math-academy-id "q-181668" :question/problem "Which of the following sets are infinite?\n\n1. $A = {n ∈ Z: \\cos n = 0}$\n2. $B = {q ∈ Q: \\cos q = 0}$\n3. $C = {x ∈ R: \\cos x = 0}$\n\nHint: The arguments of the trigonometric functions are in radians."}] [{:db/id #edb/ref 17592186198724 :knowledge-point/_questions [{:knowledge-point/id #uuid "efdb77bf-dd8b-5ccc-8265-79bd319afaa3" :knowledge-point/title "Sets Defined Using Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c3e35ca3-250a-591d-8bf3-166daf3f5b2c" :answer/type {:db/ident :answer.type/text} :answer/value "$A, B$, and $C$" :db/id #edb/ref 17592186195349} {:answer/id #uuid "0e68795a-2639-550e-af12-a40dd089a168" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186195350} {:answer/id #uuid "14f8c1e0-a934-5f5e-a1ca-6c1e93c3ced7" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186195351} {:answer/id #uuid "169d115d-d691-53af-b2d5-535475109040" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186195352} {:answer/id #uuid "480055cc-aa96-5658-914f-f20fa4cd3df0" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186195353}] :answer-field/correct {:answer/id #uuid "c3e35ca3-250a-591d-8bf3-166daf3f5b2c" :answer/type {:db/ident :answer.type/text} :answer/value "$A, B$, and $C$" :db/id #edb/ref 17592186195349} :answer-field/id #uuid "6640c02a-6dc7-5907-ad05-93213c24d773" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186195348}] :question/id #uuid "16d5f3be-e7a0-5c29-a089-f858318b66bd" :question/math-academy-id "q-181722" :question/problem "Which of the following sets are infinite?\n\n1. $A = {n ∈ Z: \\mid 2n \\mid > 5}$\n2. $B = {q ∈ Q: \\mid 2q \\mid > 5}$\n3. $C = {x ∈ R: \\mid 2x \\mid > 5}$"}]}
