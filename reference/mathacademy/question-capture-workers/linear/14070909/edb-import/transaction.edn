[:answer/validate]} {:db/id "q-181684/field-3/55f4eef1ef55065220056c9644bf18d21761bc8db2d8f5c41f767a2fc9186b70" :answer/id #uuid "384d1552-cd36-5798-be91-60d2db72e406" :answer/type :answer.type/math :answer/value "\\ne " :db/ensure [:answer/validate]} {:db/id "q-181684/field-3" :answer-field/id #uuid "bff1c0f5-3fc5-5c66-b379-2ea2f67735a6" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "q-181684/field-3/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e" :answer-field/choices ["q-181684/field-3/22814de28a0b1b4f20d5edd62707d192b78050d457a70349795d30d86dfcd7fa" "q-181684/field-3/7d149b60a8e2a3be02476cb4e4d26616193c2006082edf79693d6816cf527c19" "q-181684/field-3/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e" "q-181684/field-3/cc57b3a2811193b1201e1d8d139011f0b8b63f9cad9aaf57f40ab2b8d40ee2eb" "q-181684/field-3/55f4eef1ef55065220056c9644bf18d21761bc8db2d8f5c41f767a2fc9186b70"] :db/ensure [:answer-field/validate]} {:db/id "q-181684" :question/id #uuid "2d9148a1-f08f-56d1-8203-ef863292b3b2" :question/math-academy-id "q-181684" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070909/assets/09df7202fbe0c9160e6c10dc10a813bc6b4b00aae7d95a01068dd4154fb5d929.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n{(x,y)\\in {{field-1}}\\,:\\,-2\\,{{field-2}}\\,y\\,{{field-3}}\\,x}\n$$" :question/worked-solution "The points in our set include all those that lie *above* the line $y=-2$ and *below* the line $y=x.$\n\nA point $P(x,y)$ lies *inside* the shaded region if the following conditions are satisfied:\n\n$$\ny>-2,\\,y<x.\n$$\n\n \n\nCombining this into a single condition, we have\n\n$$\n-2<y<x\n$$\n\nSince the boundary is not included in the set (the lines are dashed), the inequalities are strict.\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,-2<y<x}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-181684/field-1" "q-181684/field-2" "q-181684/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5a3df69f-653e-5148-bd46-580097e43362"] :knowledge-point/questions ["q-181684"] :db/ensure [:knowledge-point/validate]} {:db/id "q-181690/field-1/62fc74d0eb6ece7bf9beb52d92d3e5dd4c591eb0e1df3eb95bec90a49e0fa322" :answer/id #uuid "4b0ccffc-a75a-5a7d-9b9c-37d6f77e2099" :answer/type :answer.type/math :answer/value "{C}^{2}" :db/ensure [:answer/validate]} {:db/id "q-181690/field-1/5fc5100246d98d57a3a3e1d40181b00e6e8dff5d4a097ce2d7b7f6ae0b08578e" :answer/id #uuid "dd575423-bf9d-5854-813f-3a5f16a08d90" :answer/type :answer.type/math :answer/value "C" :db/ensure [:answer/validate]} {:db/id "q-181690/field-1/07d4d169afe54b72e6508fedd544e5d357fac0ff0f623249ab3b7f264f513fcf" :answer/id #uuid "91c3a338-d3df-5647-8d17-7585b889cc0a" :answer/type :answer.type/math :answer/value "{R}^{2}" :db/ensure [:answer/validate]} {:db/id "q-181690/field-1/203f88d94a38bb859e78e84aea518cf34952815758cf391887040455367d62ef" :answer/id #uuid "72333bce-f8b6-504f-b557-d6daa8a3ce75" :answer/type :answer.type/math :answer/value "N" :db/ensure [:answer/validate]} {:db/id "q-181690/field-1/a1f44d584f3d5c0539cb338e6289ad49d176231f52c1da87f334282351fe2472" :answer/id #uuid "741b6eda-a590-537e-9e8b-647f4ac8965f" :answer/type :answer.type/math :answer/value "R" :db/ensure [:answer/validate]} {:db/id "q-181690/field-1" :answer-field/id #uuid "8476287f-51f6-518b-bd7e-b5cdbdf4073d" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-181690/field-1/07d4d169afe54b72e6508fedd544e5d357fac0ff0f623249ab3b7f264f513fcf" :answer-field/choices ["q-181690/field-1/62fc74d0eb6ece7bf9beb52d92d3e5dd4c591eb0e1df3eb95bec90a49e0fa322" "q-181690/field-1/5fc5100246d98d57a3