795d30d86dfcd7fa" "q-181690/field-3/cc57b3a2811193b1201e1d8d139011f0b8b63f9cad9aaf57f40ab2b8d40ee2eb"] :db/ensure [:answer-field/validate]} {:db/id "q-181690" :question/id #uuid "4fc79ba8-2e9f-5cc7-8c64-5ba490045273" :question/math-academy-id "q-181690" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070909/assets/883d270ae063f134ee0ac04f717bcc9b5800adb939be3c7f19f25602ad52360e.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n{(x,y)\\in {{field-1}}\\,:\\,-2\\,{{field-2}}\\,y\\,{{field-3}}\\,2}\n$$" :question/worked-solution "The points in our set include all those that lie *above* the line $y=-2$ and *below* the line $y=2.$\n\nA point $P(x,y)$ lies *inside* the shaded region if the following conditions are satisfied:\n\n$$\ny>-2,\\,y<2.\n$$\n\nCombining this into a single condition, we have\n\n$$\n-2<y<2.\n$$\n\nWe must also include the line $y=2$ since the boundary is included in the set (the curve is solid). So, we change the corresponding inequality symbol above as follows:\n\n$$\n-2<y\\le 2\n$$\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,-2<y\\le 2}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-181690/field-1" "q-181690/field-2" "q-181690/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5a3df69f-653e-5148-bd46-580097e43362"] :knowledge-point/questions ["q-181690"] :db/ensure [:knowledge-point/validate]} {:db/id "q-181692/field-1/904a9c19982d1c360bd0486a099ef7bc8a84d0ace236de1e1f77c56ca4d4caec" :answer/id #uuid "78a36867-6f64-5527-8d74-0837869c5c29" :answer/type :answer.type/math :answer/value "{Z}^{2}" :db/ensure [:answer/validate]} {:db/id "q-181692/field-1/a1f44d584f3d5c0539cb338e6289ad49d176231f52c1da87f334282351fe2472" :answer/id #uuid "d0336e32-9c9e-5412-9296-812b79187e7c" :answer/type :answer.type/math :answer/value "R" :db/ensure [:answer/validate]} {:db/id "q-181692/field-1/7d512723ec7933fc53d818fe067378407b0cca1985b020babe9fcffa79cfd32b" :answer/id #uuid "deeb79a1-4d8e-509c-915f-894121624834" :answer/type :answer.type/math :answer/value "Z" :db/ensure [:answer/validate]} {:db/id "q-181692/field-1/07d4d169afe54b72e6508fedd544e5d357fac0ff0f623249ab3b7f264f513fcf" :answer/id #uuid "45e4aa80-0b18-5d61-92cc-09a3625afcae" :answer/type :answer.type/math :answer/value "{R}^{2}" :db/ensure [:answer/validate]} {:db/id "q-181692/field-1" :answer-field/id #uuid "f6313efc-774e-5136-b7f3-ce5f837cfe2e" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-181692/field-1/07d4d169afe54b72e6508fedd544e5d357fac0ff0f623249ab3b7f264f513fcf" :answer-field/choices ["q-181692/field-1/904a9c19982d1c360bd0486a099ef7bc8a84d0ace236de1e1f77c56ca4d4caec" "q-181692/field-1/a1f44d584f3d5c0539cb338e6289ad49d176231f52c1da87f334282351fe2472" "q-181692/field-1/7d512723ec7933fc53d818fe067378407b0cca1985b020babe9fcffa79cfd32b" "q-181692/field-1/07d4d169afe54b72e6508fedd544e5d357fac0ff0f623249ab3b7f264f513fcf"] :db/ensure [:answer-field/validate]} {:db/id "q-181692/field-2/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e" :answer/id #uuid "1423901f-3ead-5043-936f-ebed308598a8" :answer/type :answer.type/math :answer/value "<" :db/ensure [:answer/validate]} {:db/id "q-181692/field-2/7d149b60a8e2a3be02476cb4e4d26616193c2006082edf79693d6816cf527c19" :answer/id #uuid "50758b39-91c1-57cf-8713-e80a03f8a180" :answer/type :answer.type/math :answer/value "\\le " :db/ensure [:answer/validate]} {:db/id "q-181692/field-2/55f4eef1ef55065220056c9644bf18d21761bc8db2d8f5c41f767a2fc9186b70" :answer/id #uuid "c529f59c-5905-5126-b2cc-23fbc1f667af" :answer/type :answer.type/math :answer/value "\\ne " :db/ensure [:answer/validate]} {:db/id "q-181692/field-2/22814de28a0b1b4f20d5edd62707d192b78050d457a70349795d30d86dfcd7fa" :answer/id #uuid "998b3818-315b-5b25-8281-21d4bb2b7ad4" :answer/type :answer.type/math :answer/value ">" :db/ensure [:answer/validate]} {:db/id "q-181692/field-2/cc57b3a2811193b1201e1d8d139011f0b8b63f9cad9aaf57f40ab2b8d40ee2eb" :answer/id #uuid "198dd157-092d-56af-9733-19632bf4e178" :answer/type :answer.type/math :answer/value "\\ge " :db/ensure [:answer/validate]} {:db/id "q-181692/field-2" :answer-field/id #uuid "d223cb66-4872-5918-b5e0-b58a4c692240" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-181692/field-2/cc57b3a2811193b1201e1d8d139011f0b8b63f9cad9aaf57f40ab2b8d40ee2eb" :answer-field/choices ["q-181692/field-2/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e" "q-181692/field-2/7d149b60a8e2a3be02476cb4e4d26616193c2006082edf79693d6816cf527c19" "q-181692/field-2/55f4eef1ef55065220056c9644bf18d21761bc8db2d8f5c41f767a2fc9186b70" "q-181692/field-2/22814de28a0b1b4f20d5edd62707d192b78050d457a70349795d30d86dfcd7fa" "q-181692/field-2/cc57b3a2811193b1201e1d8d139011f0b8b63f9cad9aaf57f40ab2b8d40ee2eb"] :db/ensure [:answer-field/validate]} {:db/id "q-181692" :question/id #uuid "3633038f-6f7f-5196-bcd7-797a232f08ea" :question/math-academy-id "q-181692" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070909/assets/7021cfd590d7e090128061d42c140ab81633f20e8cd1bff60f6252bc8e9aa882.png)\n\nUse set builder notation to describe the shaded region given in the diagram above:\n\n$$\n{(x,y)\\in {{field-1}}\\,:\\,x\\,{{field-2}}\\,-{y}^{2}}\n$$" :question/worked-solution "The points in our set include all those that lie *to the right* of the curve $x=-{y}^{2}.$\n\nTherefore, a point $P(x,y)$ lies *inside* the shaded region if the following condition is satisfied:\n\n$$\nx>-{y}^{2}\n$$\n\nWe must also include the curve $x=-{y}^{2}$ since the boundary is included in the set (the curve is solid). So, we change the inequality symbol above as follows:\n\n$$\nx\\ge -{y}^{2}\n$$\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,x\\ge -{y}^{2}}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-181692/field-1" "q-181692/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "36fa0f2f-3812-521a-aca3-900556be84ff"] :knowledge-point/questions ["q-181692"] :db/ensure [:knowledge-point/validate]} {:db/id "q-182032/field-1/904a9c19982d1c360bd0486a099ef7bc8a84d0ace236de1e1f77c56ca4d4caec" :answer/id #uuid "c04c6aea-608c-5197-8405-dbdcb69d96ef" :answer/type :answer.type/math :answer/value "{Z}^{2}" :db/ensure [:answer/validate]} {:db/id "q-182032/field-1/203f88d94a38bb859e78e84aea518cf34952815758cf391887040455367d62ef" :answer/id #uuid "d43cf466-d4ae-5a98-aec1-024211220d1c" :answer/type :answer.type/math :answer/value "N" :db/ensure [:answer/validate]} {:db/id "q-182032/field-1/7d512723ec7933fc53d818fe067378407b0cca1985b020babe9fcffa79cfd32b" :answer/id #uuid "7ea9ffe8-9d4e-5120-9d4d-64da8ef5c971" :answer/type :answer.type/math :answer/value "Z" :db/ensure [:answer/validate]} {:db/id "q-182032/field-1/07d4d169afe54b72e6508fedd544e5d357fac0ff0f623249ab3b7f264f513fcf" :answer/id #uuid "ed47bf61-9f12-53a7-a16c-0adc14b8e7fb" :answer/type :answer.type/math :answer/value "{R}^{2}" :db/ensure [:answer/validate]} {:db/id "q-182032/field-1/cfebd74d1bfcdc28a2ab76bc7b9cb134cbb44312ed3e16d5a0610048f75355ad" :answer/id #uuid "88436d1d-883a-5550-89d9-3f16007d216e" :answer/type :answer.type/math :answer/value "{N}^{2}" :db/ensure [:answer/validate]} {:db/id "q-182032/field-1/a1f44d584f3d5c0539cb338e6289ad49d176231f52c1da87f334282351fe2472" :answer/id #uuid "d2aff669-07b9-559a-abcc-29f31fff5c71" :answer/type :answer.type/math :answer/value "R" :db/ensure [:answer/validate]} {:db/id "q-1