eld/choices [{:answer/id #uuid "99820d53-aecf-5107-aa57-3a206bb63b45" :answer/type {:db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186368791} {:answer/id #uuid "384d1552-cd36-5798-be91-60d2db72e406" :answer/type {:db/ident :answer.type/math} :answer/value "\\ne " :db/id #edb/ref 17592186368792} {:answer/id #uuid "8d7acfef-6f19-561e-a5bb-a1c9f7fae465" :answer/type {:db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186368793} {:answer/id #uuid "81eab7f7-f8ae-5396-b874-7e1619bf2f57" :answer/type {:db/ident :answer.type/math} :answer/value "\\ge " :db/id #edb/ref 17592186368794} {:answer/id #uuid "655e55da-b6f7-5c2d-840e-36e1aad0dcc3" :answer/type {:db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186368795}] :answer-field/correct {:answer/id #uuid "655e55da-b6f7-5c2d-840e-36e1aad0dcc3" :answer/type {:db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186368795} :answer-field/id #uuid "bff1c0f5-3fc5-5c66-b379-2ea2f67735a6" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186368790}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "2d9148a1-f08f-56d1-8203-ef863292b3b2" :question/math-academy-id "q-181684" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070909/assets/09df7202fbe0c9160e6c10dc10a813bc6b4b00aae7d95a01068dd4154fb5d929.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n{(x,y)\\in {{field-1}}\\,:\\,-2\\,{{field-2}}\\,y\\,{{field-3}}\\,x}\n$$" :question/worked-solution "The points in our set include all those that lie *above* the line $y=-2$ and *below* the line $y=x.$\n\nA point $P(x,y)$ lies *inside* the shaded region if the following conditions are satisfied:\n\n$$\ny>-2,\\,y<x.\n$$\n\n \n\nCombining this into a single condition, we have\n\n$$\n-2<y<x\n$$\n\nSince the boundary is not included in the set (the lines are dashed), the inequalities are strict.\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,-2<y<x}.\n$$"}] [{:db/id #edb/ref 17592186368796 :knowledge-point/_questions [{:knowledge-point/id #uuid "5a3df69f-653e-5148-bd46-580097e43362" :knowledge-point/title "Linear Boundaries, Two Conditions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91c3a338-d3df-5647-8d17-7585b889cc0a" :answer/type {:db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186368798} {:answer/id #uuid "72333bce-f8b6-504f-b557-d6daa8a3ce75" :answer/type {:db/ident :answer.type/math} :answer/value "N" :db/id #edb/ref 17592186368799} {:answer/id #uuid "dd575423-bf9d-5854-813f-3a5f16a08d90" :answer/type {:db/ident :answer.type/math} :answer/value "C" :db/id #edb/ref 17592186368800} {:answer/id #uuid "4b0ccffc-a75a-5a7d-9b9c-37d6f77e2099" :answer/type {:db/ident :answer.type/math} :answer/value "{C}^{2}" :db/id #edb/ref 17592186368801} {:answer/id #uuid "741b6eda-a590-537e-9e8b-647f4ac8965f" :answer/type {:db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186368802}] :answer-field/correct {:answer/id #uuid "91c3a338-d3df-5647-8d17-7585b889cc0a" :answer/type {:db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186368798} :answer-field/id #uuid "8476287f-51f6-518b-bd7e-b5cdbdf4073d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186368797} {:answer-field/choices [{:answer/id #uuid "87d6b4eb-8801-5e88-bfbc-9928cec13c1f" :answer/type {:db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186368804} {:answer/id #uuid "29342e46-3819-58ee-a0ea-01a2a2a11b15" :answer/type {:db/ident :answer.type/math} :answer/value "\\ne " :db/id #edb/ref 17592186368