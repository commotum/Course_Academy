#{[{:db/id #edb/ref 17592186292380 :knowledge-point/_questions [{:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15a2f1a4-070e-5df9-bc96-f9a4de74982d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡7}{4}\\cdot {log}_{7}^{2}⁡x+C" :db/id #edb/ref 17592186292382} {:answer/id #uuid "319ec15c-ba68-5e46-9aaf-8ac3f4fab1e5" :answer/type {:db/ident :answer.type/math} :answer/value "4\\cdot {log}_{7}^{2}⁡x+C" :db/id #edb/ref 17592186292383} {:answer/id #uuid "0af5c69f-4a32-5280-8629-56cf6cc6a40e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡7}{2}\\cdot {log}_{7}⁡x+C" :db/id #edb/ref 17592186292384} {:answer/id #uuid "4564c6d0-559d-5e06-9ade-60604719e2da" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡7}{2}\\cdot {log}_{7}^{2}⁡x+C" :db/id #edb/ref 17592186292385} {:answer/id #uuid "09910614-5f8e-57ca-b9bb-cdbbdc063de9" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡7\\cdot {log}_{7}^{2}⁡x+C" :db/id #edb/ref 17592186292386}] :answer-field/correct {:answer/id #uuid "15a2f1a4-070e-5df9-bc96-f9a4de74982d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡7}{4}\\cdot {log}_{7}^{2}⁡x+C" :db/id #edb/ref 17592186292382} :answer-field/id #uuid "cd76030c-9865-5c76-b381-8194bd798e5f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292381}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8ffcfa20-542a-5da6-b7ce-c73215ba6769" :question/math-academy-id "q-114021" :question/problem "$\\int \\frac{{log}_{7}⁡x}{2x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{7}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡7}\\,⟹\\,\\operatorname{ln}⁡7\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{7}⁡x}{2x}\\,\\text{d}x & =\\frac{1}{2}\\int {log}_{7}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{2}\\int u\\cdot \\operatorname{ln}⁡7\\,\\text{d}u \\\\  & =\\frac{\\operatorname{ln}⁡7}{2}\\int u\\,\\text{d}u \\\\  & =\\frac{\\operatorname{ln}⁡7}{2}\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\frac{\\operatorname{ln}⁡7}{4}\\cdot {log}_{7}^{2}⁡x+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288924 :knowledge-point/_questions [{:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8fd13c43-9507-5941-86aa-5411c48ed808" :answer/type {:db/ident :answer.type/math} :answer/value "{log}_{3}⁡x+C" :db/id #edb/ref 17592186288926} {:answer/id #uuid "c6f3c4e1-90a5-55d9-8b37-bec463cfa521" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{3x}+C" :db/id #edb/ref 17592186288927} {:answer/id #uuid "dc0bfd8a-1337-5353-9115-afd616cf4dee" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3\\cdot \\operatorname{ln}⁡|{log}_{3}⁡x|+C" :db/id #edb/ref 17592186288928} {:answer/id #uuid "9d776e92-57ee-56b1-a88d-9435df509800" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}+C" :db/id #edb/ref 17592186288929} {:answer/id #uuid "76fd98a9-5f72-5ada-af96-9f5e50a16e30" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|{log}_{3}⁡x|+C" :db/id #edb/ref 17592186288930}] :answer-field/correct {:answer/id #uuid "dc0bfd8a-1337-5353-9115-afd616cf4dee" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3\\cdot \\operatorname{ln}⁡|{log}_{3}⁡x|+C" :db/id #edb/ref 17592186288928} :answer-field/id #uuid "65594974-9339-5cbb-aaea-daf806666fb3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288925}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "7d778489-5860-55d0-a860-26c713534ade" :question/math-academy-id "q-31397" :question/problem "$\\int \\frac{1}{x{log}_{3}⁡x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{3}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡3}\\,⟹\\,\\operatorname{ln}⁡3\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{x{log}_{3}⁡x}\\,\\text{d}x & =\\int \\frac{1}{{log}_{3}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡3\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡3\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡3\\cdot \\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡3\\cdot \\operatorname{ln}⁡|{log}_{3}⁡x|+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288938 :knowledge-point/_questions [{:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ecf8598e-6eea-5703-9c31-ff8196baf45d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡x{log}_{2}^{2}⁡({x}^{2})}{2}+C" :db/id #edb/ref 17592186288940} {:answer/id #uuid "243a3bd8-64e9-5a14-82ca-22d97fda1b37" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2{log}_{2}⁡({x}^{2})}{4}+C" :db/id #edb/ref 17592186288941} {:answer/id #uuid "e2247c3f-e755-57a0-ae66-bfdfc706cc1f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2{log}_{2}⁡({x}^{2})}{2}+C" :db/id #edb/ref 17592186288942} {:answer/id #uuid "fae7eb33-6046-5f29-b1b7-5e65446b8fad" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2{log}_{2}^{2}⁡({x}^{2})}{2}+C" :db/id #edb/ref 17592186288943} {:answer/id #uuid "48938fcd-ea07-58eb-956b-7b982f09e7b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2{log}_{2}^{2}⁡({x}^{2})}{4}+C" :db/id #edb/ref 17592186288944}] :answer-field/correct {:answer/id #uuid "48938fcd-ea07-58eb-956b-7b982f09e7b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2{log}_{2}^{2}⁡({x}^{2})}{4}+C" :db/id #edb/ref 17592186288944} :answer-field/id #uuid "ac3879c7-cbb1-5376-b8fc-d1131727dee1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288939}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "3c53474e-e877-5764-b2e1-1623184bc76e" :question/math-academy-id "q-31400" :question/problem "$\\int \\frac{{log}_{2}⁡({x}^{2})}{x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{2}⁡({x}^{2}).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{2}{x\\operatorname{ln}⁡2}\\,⟹\\,\\frac{\\operatorname{ln}⁡2}{2}\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{2}⁡({x}^{2})}{x}\\,\\text{d}x & =\\int {log}_{2}⁡({x}^{2})\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int u\\cdot (\\frac{\\operatorname{ln}⁡2}{2}\\text{d}u) \\\\  & =\\frac{\\operatorname{ln}⁡2}{2}\\int u\\,\\text{d}u \\\\  & =\\frac{\\operatorname{ln}⁡2}{2}\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\frac{\\operatorname{ln}⁡2{log}_{2}^{2}⁡({x}^{2})}{4}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186353333 :knowledge-point/_questions [{:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "263bfea4-7d5b-5deb-a4a4-975ae147f3e6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2}{2\\sqrt{x}}" :db/id #edb/ref 17592186353335} {:answer/id #uuid "ce10e671-9e69-5f5e-ad77-4ff21db26502" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡|x|}{2\\sqrt{2}}" :db/id #edb/ref 17592186353336} {:answer/id #uuid "952e7f15-841c-5fbf-b990-5f59a3b35c42" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\operatorname{ln}⁡2}{\\sqrt{2}}" :db/id #edb/ref 17592186353337} {:answer/id #uuid "857434d6-f56c-52aa-a158-dfb327ff784d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9\\operatorname{ln}⁡2}{\\sqrt{2}}" :db/id #edb/ref 17592186353338} {:answer/id #uuid "18be6160-4935-593d-b1e1-4e9b66f932bc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9\\operatorname{ln}⁡|x|}{\\sqrt{2}}" :db/id #edb/ref 17592186353339}] :answer-field/correct {:answer/id #uuid "857434d6-f56c-52aa-a158-dfb327ff784d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9\\operatorname{ln}⁡2}{\\sqrt{2}}" :db/id #edb/ref 17592186353338} :answer-field/id #uuid "cc859e45-63ae-56e2-b353-6e9930331126" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353334}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3c89dbbb-b9dc-5cdd-91a1-54766fc66584" :question/math-academy-id "q-31648" :question/problem "What is the value of  ${\\int }_{2}^{4}\\frac{3{log}_{2}⁡({x}^{2})}{\\sqrt{2}x}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{2}⁡({x}^{2}).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{{x}^{2}\\operatorname{ln}⁡2}\\cdot 2x=\\frac{2}{x\\operatorname{ln}⁡2}\\,⟹\\,\\frac{\\operatorname{ln}⁡2}{2}\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $2$ | $4$ |\n| --- | --- | --- |\n| $u$ | $2$ | $4$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{2}^{4}\\frac{3{log}_{2}⁡({x}^{2})}{\\sqrt{2}x}\\,\\text{d}x & =\\frac{3}{\\sqrt{2}}{\\int }_{2}^{4}{log}_{2}⁡({x}^{2})\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{3}{\\sqrt{2}}{\\int }_{2}^{4}u\\cdot \\frac{\\operatorname{ln}⁡2}{2}\\,\\text{d}u \\\\  & =\\frac{3}{\\sqrt{2}}\\cdot \\frac{\\operatorname{ln}⁡2}{2}{\\int }_{2}^{4}u\\,\\text{d}u \\\\  & =\\frac{3\\operatorname{ln}⁡2}{2\\sqrt{2}}\\cdot \\frac{{u}^{2}}{2}{|}_{2}^{4} \\\\  & =\\frac{3\\operatorname{ln}⁡2}{4\\sqrt{2}}\\cdot (16-4) \\\\  & =\\frac{9\\operatorname{ln}⁡2}{\\sqrt{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186353340 :knowledge-point/_questions [{:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ceb5e7a-f5f3-5037-b333-cae220246998" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{31\\operatorname{ln}⁡5}{\\sqrt{5}}" :db/id #edb/ref 17592186353342} {:answer/id #uuid "08dd8ec2-09ec-5077-ad03-c629dfa7cc2f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{21\\operatorname{ln}⁡5}{2}" :db/id #edb/ref 17592186353343} {:answer/id #uuid "7baf3d1a-b181-52e2-b731-b0d2ccd7ae5b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{ln}⁡3}{2\\sqrt{5}}" :db/id #edb/ref 17592186353344} {:answer/id #uuid "83456534-86b4-5d98-ba85-d0c4c7ba9f9b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{33\\operatorname{ln}⁡5}{\\sqrt{5}}" :db/id #edb/ref 17592186353345} {:answer/id #uuid "71f222fd-939c-5da0-94c7-63b648380514" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡5}{3}" :db/id #edb/ref 17592186353346}] :answer-field/correct {:answer/id #uuid "08dd8ec2-09ec-5077-ad03-c629dfa7cc2f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{21\\operatorname{ln}⁡5}{2}" :db/id #edb/ref 17592186353343} :answer-field/id #uuid "35a8ae4d-9fce-5505-bdd5-144817391d19" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353341}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "504eff42-500f-51b3-ba62-293b84b5aef3" :question/math-academy-id "q-31669" :question/problem "What is the value of ${\\int }_{1}^{5}\\frac{7{log}_{5}⁡(5x)}{x}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{5}⁡(5x).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{5x\\operatorname{ln}⁡5}\\cdot 5=\\frac{1}{x\\operatorname{ln}⁡5}\\,⟹\\,\\operatorname{ln}⁡5\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $5$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{5}\\frac{7{log}_{5}⁡(5x)}{x}\\,\\text{d}x & =7{\\int }_{1}^{5}{log}_{5}⁡(5x)\\cdot \\frac{\\text{d}x}{x} \\\\  & =7{\\int }_{1}^{2}u\\cdot \\operatorname{ln}⁡5\\,\\text{d}u \\\\  & =7\\operatorname{ln}⁡5{\\int }_{1}^{2}u\\,\\text{d}u \\\\  & =7\\operatorname{ln}⁡5\\cdot \\frac{{u}^{2}}{2}{|}_{1}^{2} \\\\  & =7\\operatorname{ln}⁡5\\cdot (\\frac{4}{2}-\\frac{1}{2}) \\\\  & =\\frac{21\\operatorname{ln}⁡5}{2}\\end{aligned}\n$$"}]}
