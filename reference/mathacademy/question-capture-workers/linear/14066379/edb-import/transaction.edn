[{:db/id "q-31648/selection/4f48601f6f8b84dfb24e588e640a61dc8f80290432cee674fd0e4318abd71d47" :answer/id #uuid "952e7f15-841c-5fbf-b990-5f59a3b35c42" :answer/type :answer.type/math :answer/value "\\frac{3\\operatorname{ln}⁡2}{\\sqrt{2}}" :db/ensure [:answer/validate]} {:db/id "q-31648/selection/846e1342a52c1589880383126bd48b6cdeb79b804bb1374ab81f1958fa4ccee0" :answer/id #uuid "857434d6-f56c-52aa-a158-dfb327ff784d" :answer/type :answer.type/math :answer/value "\\frac{9\\operatorname{ln}⁡2}{\\sqrt{2}}" :db/ensure [:answer/validate]} {:db/id "q-31648/selection/07dd3726753635b515891383405b51e18244f6be39321616cdc1ad6641124d32" :answer/id #uuid "263bfea4-7d5b-5deb-a4a4-975ae147f3e6" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡2}{2\\sqrt{x}}" :db/ensure [:answer/validate]} {:db/id "q-31648/selection/95e727c2ea6f69025d252fb2236a88c8bbf5d76a2401768861b5ed617c7d7ef8" :answer/id #uuid "18be6160-4935-593d-b1e1-4e9b66f932bc" :answer/type :answer.type/math :answer/value "\\frac{9\\operatorname{ln}⁡|x|}{\\sqrt{2}}" :db/ensure [:answer/validate]} {:db/id "q-31648/selection/1af79b250223c8e8b874de714458b825a925177bbfa3902345ba6f1253a2af4c" :answer/id #uuid "ce10e671-9e69-5f5e-ad77-4ff21db26502" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡|x|}{2\\sqrt{2}}" :db/ensure [:answer/validate]} {:db/id "q-31648/selection" :answer-field/id #uuid "cc859e45-63ae-56e2-b353-6e9930331126" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-31648/selection/846e1342a52c1589880383126bd48b6cdeb79b804bb1374ab81f1958fa4ccee0" :answer-field/choices ["q-31648/selection/4f48601f6f8b84dfb24e588e640a61dc8f80290432cee674fd0e4318abd71d47" "q-31648/selection/846e1342a52c1589880383126bd48b6cdeb79b804bb1374ab81f1958fa4ccee0" "q-31648/selection/07dd3726753635b515891383405b51e18244f6be39321616cdc1ad6641124d32" "q-31648/selection/95e727c2ea6f69025d252fb2236a88c8bbf5d76a2401768861b5ed617c7d7ef8" "q-31648/selection/1af79b250223c8e8b874de714458b825a925177bbfa3902345ba6f1253a2af4c"] :db/ensure [:answer-field/validate]} {:db/id "q-31648" :question/id #uuid "3c89dbbb-b9dc-5cdd-91a1-54766fc66584" :question/math-academy-id "q-31648" :question/problem "What is the value of  ${\\int }_{2}^{4}\\frac{3{log}_{2}⁡({x}^{2})}{\\sqrt{2}x}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{2}⁡({x}^{2}).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{{x}^{2}\\operatorname{ln}⁡2}\\cdot 2x=\\frac{2}{x\\operatorname{ln}⁡2}\\,⟹\\,\\frac{\\operatorname{ln}⁡2}{2}\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $2$ | $4$ |\n| --- | --- | --- |\n| $u$ | $2$ | $4$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{2}^{4}\\frac{3{log}_{2}⁡({x}^{2})}{\\sqrt{2}x}\\,\\text{d}x & =\\frac{3}{\\sqrt{2}}{\\int }_{2}^{4}{log}_{2}⁡({x}^{2})\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{3}{\\sqrt{2}}{\\int }_{2}^{4}u\\cdot \\frac{\\operatorname{ln}⁡2}{2}\\,\\text{d}u \\\\  & =\\frac{3}{\\sqrt{2}}\\cdot \\frac{\\operatorname{ln}⁡2}{2}{\\int }_{2}^{4}u\\,\\text{d}u \\\\  & =\\frac{3\\operatorname{ln}⁡2}{2\\sqrt{2}}\\cdot \\frac{{u}^{2}}{2}{|}_{2}^{4} \\\\  & =\\frac{3\\operatorname{ln}⁡2}{4\\sqrt{2}}\\cdot (16-4) \\\\  & =\\frac{9\\operatorname{ln}⁡2}{\\sqrt{2}}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-31648/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05"] :knowledge-point/questions ["q-31648"] :db/ensure [:knowledge-point/validate]} {:db/id "q-31669/selection/9b698f280c987b3cedfd35d125697cbbd61f4845ac2bacfb388fa870524a3ccf" :answer/id #uuid "83456534-86b4-5d98-ba85-d0c4c7ba9f9b" :answer/type :answer.type/math :answer/value "\\frac{33\\operatorname{ln}⁡5}{\\sqrt{5}}" :db/ensure [:answer/validate]} {:db/id "q-31669/selection/85e62199b3d089720fe84f7048c1d9648678c8ac931934dda6ac73c95b3bf1d2" :answer/id #uuid "7baf3d1a-b181-52e2-b731-b0d2ccd7ae5b" :answer/type :answer.type/math :answer/value "\\frac{2\\operatorname{ln}⁡3}{2\\sqrt{5}}" :db/ensure [:answer/validate]} {:db/id "q-31669/selection/737a681c61274bdf1fe73082719811c163b0a16ba189b6c882102f43f20a7029" :answer/id #uuid "08dd8ec2-09ec-5077-ad03-c629dfa7cc2f" :answer/type :answer.type/math :answer/value "\\frac{21\\operatorname{ln}⁡5}{2}" :db/ensure [:answer/validate]} {:db/id "q-31669/selection/fcc14378b783349c4844c4299a2223d4d6217585e711748db2a181e5155b9bb8" :answer/id #uuid "71f222fd-939c-5da0-94c7-63b648380514" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡5}{3}" :db/ensure [:answer/validate]} {:db/id "q-31669/selection/53365c368c59e684a7d955d73871888b68f983f06c134a22d82c05c9c662c25f" :answer/id #uuid "7ceb5e7a-f5f3-5037-b333-cae220246998" :answer/type :answer.type/math :answer/value "\\frac{31\\operatorname{ln}⁡5}{\\sqrt{5}}" :db/ensure [:answer/validate]} {:db/id "q-31669/selection" :answer-field/id #uuid "35a8ae4d-9fce-5505-bdd5-144817391d19" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-31669/selection/737a681c61274bdf1fe73082719811c163b0a16ba189b6c882102f43f20a7029" :answer-field/choices ["q-31669/selection/9b698f280c987b3cedfd35d125697cbbd61f4845ac2bacfb388fa870524a3ccf" "q-31669/selection/85e62199b3d089720fe84f7048c1d9648678c8ac931934dda6ac73c95b3bf1d2" "q-31669/selection/737a681c61274bdf1fe73082719811c163b0a16ba189b6c882102f43f20a7029" "q-31669/selection/fcc14378b783349c4844c4299a2223d4d6217585e711748db2a181e5155b9bb8" "q-31669/selection/53365c368c59e684a7d955d73871888b68f983f06c134a22d82c05c9c662c25f"] :db/ensure [:answer-field/validate]} {:db/id "q-31669" :question/id #uuid "504eff42-500f-51b3-ba62-293b84b5aef3" :question/math-academy-id "q-31669" :question/problem "What is the value of ${\\int }_{1}^{5}\\frac{7{log}_{5}⁡(5x)}{x}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{5}⁡(5x).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{5x\\operatorname{ln}⁡5}\\cdot 5=\\frac{1}{x\\operatorname{ln}⁡5}\\,⟹\\,\\operatorname{ln}⁡5\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $5$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{5}\\frac{7{log}_{5}⁡(5x)}{x}\\,\\text{d}x & =7{\\int }_{1}^{5}{log}_{5}⁡(5x)\\cdot \\frac{\\text{d}x}{x} \\\\  & =7{\\int }_{1}^{2}u\\cdot \\operatorname{ln}⁡5\\,\\text{d}u \\\\  & =7\\operatorname{ln}⁡5{\\int }_{1}^{2}u\\,\\text{d}u \\\\  & =7\\operatorname{ln}⁡5\\cdot \\frac{{u}^{2}}{2}{|}_{1}^{2} \\\\  & =7\\operatorname{ln}⁡5\\cdot (\\frac{4}{2}-\\frac{1}{2}) \\\\  & =\\frac{21\\operatorname{ln}⁡5}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-31669/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05"] :knowledge-point/questions ["q-31669"] :db/ensure [:knowledge-point/validate]}]
