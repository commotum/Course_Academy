#{[{:db/id #edb/ref 17592186292380 :knowledge-point/_questions [{:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15a2f1a4-070e-5df9-bc96-f9a4de74982d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡7}{4}\\cdot {log}_{7}^{2}⁡x+C" :db/id #edb/ref 17592186292382} {:answer/id #uuid "319ec15c-ba68-5e46-9aaf-8ac3f4fab1e5" :answer/type {:db/ident :answer.type/math} :answer/value "4\\cdot {log}_{7}^{2}⁡x+C" :db/id #edb/ref 17592186292383} {:answer/id #uuid "0af5c69f-4a32-5280-8629-56cf6cc6a40e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡7}{2}\\cdot {log}_{7}⁡x+C" :db/id #edb/ref 17592186292384} {:answer/id #uuid "4564c6d0-559d-5e06-9ade-60604719e2da" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡7}{2}\\cdot {log}_{7}^{2}⁡x+C" :db/id #edb/ref 17592186292385} {:answer/id #uuid "09910614-5f8e-57ca-b9bb-cdbbdc063de9" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡7\\cdot {log}_{7}^{2}⁡x+C" :db/id #edb/ref 17592186292386}] :answer-field/correct {:answer/id #uuid "15a2f1a4-070e-5df9-bc96-f9a4de74982d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡7}{4}\\cdot {log}_{7}^{2}⁡x+C" :db/id #edb/ref 17592186292382} :answer-field/id #uuid "cd76030c-9865-5c76-b381-8194bd798e5f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292381}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8ffcfa20-542a-5da6-b7ce-c73215ba6769" :question/math-academy-id "q-114021" :question/problem "$\\int \\frac{{log}_{7}⁡x}{2x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{7}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡7}\\,⟹\\,\\operatorname{ln}⁡7\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{7}⁡x}{2x}\\,\\text{d}x & =\\frac{1}{2}\\int {log}_{7}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{2}\\int u\\cdot \\operatorname{ln}⁡7\\,\\text{d}u \\\\  & =\\frac{\\operatorname{ln}⁡7}{2}\\int u\\,\\text{d}u \\\\  & =\\frac{\\operatorname{ln}⁡7}{2}\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\frac{\\operatorname{ln}⁡7}{4}\\cdot {log}_{7}^{2}⁡x+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288938 :knowledge-point/_questions [{:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ecf8598e-6eea-5703-9c31-ff8196baf45d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡x{log}_{2}^{2}⁡({x}^{2})}{2}+C" :db/id #edb/ref 17592186288940} {:answer/id #uuid "243a3bd8-64e9-5a14-82ca-22d97fda1b37" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2{log}_{2}⁡({x}^{2})}{4}+C" :db/id #edb/ref 17592186288941} {:answer/id #uuid "e2247c3f-e755-57a0-ae66-bfdfc706cc1f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2{log}_{2}⁡({x}^{2})}{2}+C" :db/id #edb/ref 17592186288942} {:answer/id #uuid "fae7eb33-6046-5f29-b1b7-5e65446b8fad" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2{log}_{2}^{2}⁡({x}^{2})}{2}+C" :db/id #edb/ref 17592186288943} {:answer/id #uuid "48938fcd-ea07-58eb-956b-7b982f09e7b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2{log}_{2}^{2}⁡({x}^{2})}{4}+C" :db/id #edb/ref 17592186288944}] :answer-field/correct {:answer/id #uuid "48938fcd-ea07-58eb-956b-7b982f09e7b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2{log}_{2}^{2}⁡({x}^{2})}{4}+C" :db/id #edb/ref 17592186288944} :answer-field/id #uuid "ac3879c7-cbb1-5376-b8fc-d1131727dee1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288939}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "3c53474e-e877-5764-b2e1-1623184bc76e" :question/math-academy-id "q-31400" :question/problem "$\\int \\frac{{log}_{2}⁡({x}^{2})}{x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{2}⁡({x}^{2}).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{2}{x\\operatorname{ln}⁡2}\\,⟹\\,\\frac{\\operatorname{ln}⁡2}{2}\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{2}⁡({x}^{2})}{x}\\,\\text{d}x & =\\int {log}_{2}⁡({x}^{2})\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int u\\cdot (\\frac{\\operatorname{ln}⁡2}{2}\\text{d}u) \\\\  & =\\frac{\\operatorname{ln}⁡2}{2}\\int u\\,\\text{d}u \\\\  & =\\frac{\\operatorname{ln}⁡2}{2}\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\frac{\\operatorname{ln}⁡2{log}_{2}^{2}⁡({x}^{2})}{4}+C.\\end{aligned}\n$$"}]}
