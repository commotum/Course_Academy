#{[{:db/id #edb/ref 17592186288924 :knowledge-point/_questions [{:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8fd13c43-9507-5941-86aa-5411c48ed808" :answer/type {:db/ident :answer.type/math} :answer/value "{log}_{3}⁡x+C" :db/id #edb/ref 17592186288926} {:answer/id #uuid "c6f3c4e1-90a5-55d9-8b37-bec463cfa521" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{3x}+C" :db/id #edb/ref 17592186288927} {:answer/id #uuid "dc0bfd8a-1337-5353-9115-afd616cf4dee" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3\\cdot \\operatorname{ln}⁡|{log}_{3}⁡x|+C" :db/id #edb/ref 17592186288928} {:answer/id #uuid "9d776e92-57ee-56b1-a88d-9435df509800" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}+C" :db/id #edb/ref 17592186288929} {:answer/id #uuid "76fd98a9-5f72-5ada-af96-9f5e50a16e30" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|{log}_{3}⁡x|+C" :db/id #edb/ref 17592186288930}] :answer-field/correct {:answer/id #uuid "dc0bfd8a-1337-5353-9115-afd616cf4dee" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3\\cdot \\operatorname{ln}⁡|{log}_{3}⁡x|+C" :db/id #edb/ref 17592186288928} :answer-field/id #uuid "65594974-9339-5cbb-aaea-daf806666fb3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288925}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "7d778489-5860-55d0-a860-26c713534ade" :question/math-academy-id "q-31397" :question/problem "$\\int \\frac{1}{x{log}_{3}⁡x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{3}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡3}\\,⟹\\,\\operatorname{ln}⁡3\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{x{log}_{3}⁡x}\\,\\text{d}x & =\\int \\frac{1}{{log}_{3}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡3\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡3\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡3\\cdot \\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡3\\cdot \\operatorname{ln}⁡|{log}_{3}⁡x|+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288938 :knowledge-point/_questions [{:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ecf8598e-6eea-5703-9c31-ff8196baf45d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡x{log}_{2}^{2}⁡({x}^{2})}{2}+C" :db/id #edb/ref 17592186288940} {:answer/id #uuid "243a3bd8-64e9-5a14-82ca-22d97fda1b37" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2{log}_{2}⁡({x}^{2})}{4}+C" :db/id #edb/ref 17592186288941} {:answer/id #uuid "e2247c3f-e755-57a0-ae66-bfdfc706cc1f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2{log}_{2}⁡({x}^{2})}{2}+C" :db/id #edb/ref 17592186288942} {:answer/id #uuid "fae7eb33-6046-5f29-b1b7-5e65446b8fad" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2{log}_{2}^{2}⁡({x}^{2})}{2}+C" :db/id #edb/ref 17592186288943} {:answer/id #uuid "48938fcd-ea07-58eb-956b-7b982f09e7b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2{log}_{2}^{2}⁡({x}^{2})}{4}+C" :db/id #edb/ref 17592186288944}] :answer-field/correct {:answer/id #uuid "48938fcd-ea07-58eb-956b-7b982f09e7b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2{log}_{2}^{2}⁡({x}^{2})}{4}+C" :db/id #edb/ref 17592186288944} :answer-field/id #uuid "ac3879c7-cbb1-5376-b8fc-d1131727dee1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288939}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "3c53474e-e877-5764-b2e1-1623184bc76e" :question/math-academy-id "q-31400" :question/problem "$\\int \\frac{{log}_{2}⁡({x}^{2})}{x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{2}⁡({x}^{2}).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{2}{x\\operatorname{ln}⁡2}\\,⟹\\,\\frac{\\operatorname{ln}⁡2}{2}\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{2}⁡({x}^{2})}{x}\\,\\text{d}x & =\\int {log}_{2}⁡({x}^{2})\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int u\\cdot (\\frac{\\operatorname{ln}⁡2}{2}\\text{d}u) \\\\  & =\\frac{\\operatorname{ln}⁡2}{2}\\int u\\,\\text{d}u \\\\  & =\\frac{\\operatorname{ln}⁡2}{2}\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\frac{\\operatorname{ln}⁡2{log}_{2}^{2}⁡({x}^{2})}{4}+C.\\end{aligned}\n$$"}]}
