d}-3{x}_{3} \\\\ 4{x}_{3} \\\\ {x}_{3}\\end{aligned}]={x}_{3}[\\begin{aligned}-3 \\\\ 4 \\\\ 1\\end{aligned}].\n$$\n\nTherefore, a basis for $\\text{Null}(A)$ is\n\n$$\nB={[\\begin{aligned}-3 \\\\ 4 \\\\ 1\\end{aligned}]}\n$$\n\nsince it is a linearly independent set and its vectors generate $\\text{Null}(A).$"}] [{:db/id #edb/ref 17592186120321 :knowledge-point/_questions [{:knowledge-point/id #uuid "3e66c269-233b-57f8-9dae-46eb78c228bc" :knowledge-point/title "Finding a Basis for a Given Null Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c5256421-9fa5-5f02-b542-58a6cc81dcbf" :answer/type {:db/ident :answer.type/math} :answer/value "B={[\\begin{aligned}3 \\\\ -2 \\\\ 0 \\\\ 1\\end{aligned}],[\\begin{aligned}-2 \\\\ 5 \\\\ 1 \\\\ 0\\end{aligned}]}" :db/id #edb/ref 17592186349473} {:answer/id #uuid "a7054484-2857-580e-b54d-a53ed01e018b" :answer/type {:db/ident :answer.type/math} :answer/value "B={[\\begin{aligned}-3 \\\\ -2 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}2 \\\\ 5 \\\\ 0 \\\\ 1\\end{aligned}]}" :db/id #edb/ref 17592186349474} {:answer/id #uuid "5b409964-e8b2-5fc1-9004-2297939fd51e" :answer/type {:db/ident :answer.type/math} :answer/value "B={[\\begin{aligned}-3 \\\\ 2 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}2 \\\\ -5 \\\\ 0 \\\\ 1\\end{aligned}]}" :db/id #edb/ref 17592186349475} {:answer/id #uuid "babd6949-4b06-5c34-9068-e82adf9563a5" :answer/type {:db/ident :answer.type/math} :answer/value "B={[\\begin{aligned}3 \\\\ 2 \\\\ 1 \\\\ 0\\end{aligned}]}" :db/id #edb/ref 17592186349476} {:answer/id #uuid "fe94a68d-557a-54db-90f3-82fc2d531fce" :answer/type {:db/ident :answer.type/math} :answer/value "B={[\\begin{aligned}-1 \\\\ -3 \\\\ 1 \\\\ 1\\end{aligned}]}" :db/id #edb/ref 17592186349477}] :answer-field/correct {:answer/id #uuid "5b409964-e8b2-5fc1-9004-2297939fd51e" :answer/type {:db/ident :answer.type/math} :answer/value "B={[\\begin{aligned}-3 \\\\ 2 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}2 \\\\ -5 \\\\ 0 \\\