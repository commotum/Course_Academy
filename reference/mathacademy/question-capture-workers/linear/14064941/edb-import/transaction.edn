c4fe72ce753bc87a1c1cca1fd8b636e986e9328ecf7d1edaa78a8a5df32aa/0d294253ab145d2a2b86e5805bef0b8f17b1cb2f8a43b1ac2dcd70a0f36a9947" "q-35460/selection/ma-v1/de8c4fe72ce753bc87a1c1cca1fd8b636e986e9328ecf7d1edaa78a8a5df32aa/1c787ae6680cda27f4788d44571a9de3718ff7ded7a9fdb1f8f9124a4aac02cb"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-35460"] :question/problem "Given that  $\\text{Null}(A)={[\\begin{aligned}-3{x}_{3} \\\\ 4{x}_{3} \\\\ {x}_{3}\\end{aligned}]\\,:\\,{x}_{3}\\in R}$, find a basis for $\\text{Null}(A).$" :question/worked-solution "Any vector in $\\text{Null}(A)$ has the form\n\n$$\n[\\begin{aligned}-3{x}_{3} \\\\ 4{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in R.\n$$\n\nExpanding, we get\n\n$$\n[\\begin{aligned}-3{x}_{3} \\\\ 4{x}_{3} \\\\ {x}_{3}\\end{aligned}]={x}_{3}[\\begin{aligned}-3 \\\\ 4 \\\\ 1\\end{aligned}].\n$$\n\nTherefore, a basis for $\\text{Null}(A)$ is\n\n$$\nB={[\\begin{aligned}-3 \\\\ 4 \\\\ 1\\end{aligned}]}\n$$\n\nsince it is a linearly independent set and its vectors generate $\\text{Null}(A).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-35460/selection/ma-v1/de8c4fe72ce753bc87a1c1cca1fd8b636e986e9328ecf7d1edaa78a8a5df32aa"] :db/ensure [:question/validate]} [:db/retract 17592186120314 :question/answer-fields 17592186118359] {:db/id "q-35450/selection/ma-v1/6ba6018a332189776c5804709d109fc0463adcaab5d8ab208ce689c19b1cc1a0/47ca9b38dee9e032667a6d1f10eb87228e6fa93da8cb157c8506929d2e22ee67" :answer/id #uuid "78572a1d-946f-5635-8fd7-7dd5630f03d8" :answer/type :answer.type/math :answer/value "B={\\,}" :db/ensure [:answer/validate]} {:db/id "q-35450/selection/ma-v1/6ba6018a332189776c5804709d109fc0463adcaab5d8ab208ce689c19b1cc1a0/4be4a3bfd439438f983baecb41e7e6192f46de01bf06b7499cfd1f33c35028cf" :answer/id #uuid "e033ce09-5e81-585a-b959-7367e6bb25b1" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}-1 \\\\ 2 \\\\ -3\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-35450/selection/ma-v1/6ba6018a332189776c5804709d109fc0463adcaab5d8ab208ce689c19b1cc1a0/72dd8b68058b8f8385a76392c52df033b95e553e24688cb5fa90a87b13857958" :answer/id #uuid "39d7cd50-6f1c-5ef4-b20c-1d7bd27bddd2" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}1 \\\\ 0 \\\\ 0 \\\\ 1\\end{aligned}],[\\begin{aligned}0 \\\\ 2 \\\\ -3 \\\\ 0\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-35450/selection/ma-v1/6ba6018a332189776c5804709d109fc0463adcaab5d8ab208ce689c19b1cc1a0/fc93bd3b22bc9277fee970950ac6cebf9bf8f7daf785845eca544e9898b2cf6c" :answer/id #uuid "000e8ca6-d93a-5b2b-8187-d79b46ee170d" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}1 \\\\ 2 \\\\ 3 \\\\ -1\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-35450/selection/ma-v1/6ba6018a332189776c5804709d109fc0463adcaab5d8ab208ce689c19b1cc1a0/616898ebb6eeb28a07f3d226180b695abcf95a8b34fb4245ab01d4a3efcf2c05" :answer/id #uuid "00169b3a-0add-5b51-97d2-084cff2a0d7c" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}1 \\\\ -2 \\\\ 3 \\\\ 1\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-35450/selection/ma-v1/6ba6018a332189776c5804709d109fc0463adcaab5d8ab208ce689c19b1cc1a0" :answer-field/id #uuid "7ecdae69-ffab-5439-b617-434984b16154" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-35450/selection/ma-v1/6ba6018a332189776c5804709d109fc0463adcaab5d8ab208ce689c19b1cc1a0/616898ebb6eeb28a07f3d226180b695abcf95a8b34fb4245ab01d4a3efcf2c05" :answer-field/choices ["q-35450/selection/ma-v1/6ba6018a332189776c5804709d109fc0463adcaab5d8ab208ce689c19b1cc1a0/47ca9b38dee9e032667a6d1f10eb87228e6fa93da8cb157c8506929d2e22ee67" "q-35450/selection/ma-v1/6ba6018a332189776c5804709d109fc0463adcaab5d8ab208ce689c19b1cc1a0/4be4a3bfd439438f983baecb41e7e6192f46de01bf06b7499cfd1f33c35028cf" "q-35450/selection/ma-v1/6ba6018a332189776c5804709d109fc0463adcaab5d8ab208ce689c19b1cc1a0/72dd8b68058b8f8385a76392c52df033b95e553e24688cb5fa90a87b13857958" "q-35450/selection/ma-v1/6ba6018a332189776c5804709d109fc0463adcaab5d8ab208ce689c19b1cc1a0/fc93bd3b22bc9277fee970950ac6cebf9bf8f7daf785845eca544e9898b2cf6c" "q-35450/selection/ma-v1/6ba6018a332189776c5804709d109fc0463adcaab5d8ab208ce689c19b1cc1a0/616898ebb6eeb28a07f3d226180b695abcf95a8b34fb4245ab01d4a3efcf2c05"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-35450"] :question/problem "Find a basis of the null space of the matrix $A=[\\begin{aligned}1 & 0 & 0 & -1 \\\\ 0 & 1 & 0 & 2 \\\\ 0 & 0 & 1 & -3\\end{aligned}].$" :question/worked-solution "To find a basis of $\\text{Null}(A),$ we need to solve the equation $Ax=0$ and express the solution as a linear combination of linearly independent vectors. Those vectors form a basis of $\\text{Null}(A).$\n\nThe given matrix is already in reduced row echelon form. So, the equation $Ax=0$ corresponds to the following system:\n\n$$\n{\\begin{aligned}{x}_{1}-{x}_{4}=0 \\\\ {x}_{2}+2{x}_{4}=0 \\\\ {x}_{3}-3{x}_{4}=0\\end{aligned}\\,⟹\\,{\\begin{aligned}{x}_{1}={x}_{4} \\\\ {x}_{2}=-2{x}_{4} \\\\ {x}_{3}=3{x}_{4}\\end{aligned}\n$$\n\nHere, ${x}_{1}$, ${x}_{2}$, and ${x}_{3}$ are basic variables corresponding to the pivot columns ($1$st, $2$nd, and $3$rd) and ${x}_{4}$ is a free variable corresponding to the non-pivot column. Therefore, if $x\\in \\text{Null}(A),$ then\n\n$$\n[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3} \\\\ {x}_{4}\\end{aligned}]=[\\begin{aligned}{x}_{4} \\\\ -2{x}_{4} \\\\ 3{x}_{4} \\\\ {x}_{4}\\end{aligned}]={x}_{4}[\\begin{aligned}1 \\\\ -2 \\\\ 3 \\\\ 1\\end{aligned}],\n$$\n\nwhere ${x}_{4}\\in R.$ This implies that\n\n$$\nB={[\\begin{aligned}1 \\\\ -2 \\\\ 3 \\\\ 1\\end{aligned}]}\n$$\n\nis a basis of $\\text{Null}(A)$ since it is a linearly independent set and its vectors generate the $\\text{Null}(A).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-35450/selection/ma-v1/6ba6018a332189776c5804709d109fc0463adcaab5d8ab208ce689c19b1cc1a0"] :db/ensure [:question/validate]} {:db/id "q-75000/selection/52d82beac4e579873446faca1492041cec944dff84d5458211d55ad20073b326" :answer/id #uuid "f342f476-5f0f-5287-875d-22155c51e4f2" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}1 \\\\ 1\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-75000/selection/9b50c133e7b4ee63cd05dfc669784b997a5bf72e08ae39396109ab018583d42b" :answer/id #uuid "a8ba9c81-8634-5741-b9e9-352fe266c9fc" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}1 \\\\ 0\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-75000/selection/df9700a7d8f6f794b8fff42f1ee90d4e134f2ca99d457add50a35c68dac277b6" :answer/id #uuid "bbf4fba3-cd27-5ecc-9f6e-6519d8c5f413" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}1 \\\\ 0\\end{aligned}],[\\begin{aligned}0 \\\\ 1\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-75000/selection/a1b5fe2a6083a9b954df42e362e8e9a4bcc017e8782b68b6a50f7f82469f619d" :answer/id #uuid "8c48cb49-70b1-52ba-baf6-1cffc30c0fc9" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}0 \\\\ 1\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-75000/selection/47ca9b38dee9e032667a6d1f10eb87228e6fa93da8cb157c8506929d2e22ee67" :answer/id #uuid "b4bbf6b8-f7c9-5403-99b1-f1e318b7e0a7" :answer/type :answer.type/math :answer/value "B={\\,}" :db/ensure [:answer/validate]} {:db/id "q-75000/selection" :answer-field/id #uuid "e9317130-4424-53c0-8c59-659333be679a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-75000/selection/47ca9b38dee9e032667a6d1f10eb87228e6fa93da8cb157c8506929d2e22ee67" :answer-field/choices ["q-75000/selection/52d82beac4e579873446faca1492041cec944dff84d5458211d55ad20073b326" "q-75000/selection/9b50c133e7b4ee63cd05dfc669784b997a5bf72e08ae39396109ab018583d42b" "q-75000/selection/df9700a7d8f6f794b8fff42f1ee90d4e134f2ca99d457add50a35c68dac277b6" "q-75000/selection/a1b5fe2a6083a9b954df42e362e8e9a4bcc017e8782b68b6a50f7f82469f619d" "q-75000/selection/47ca9b38dee9e032667a6d1f10eb87228e6fa93da8cb157c8506929d2e22ee67"] :db/ensure [:answer-field/validate]} {:db/id "q-75000" :question/id #uuid "a2d0b327-ae1c-51cb-bd3d-36107e93ddd6" :question/math-academy-id "q-75000" :question/problem "Find a basis of the null space of the matrix $A=[\\begin{aligned}1 & 5 \\\\ 0 & 1 \\\\ 0 & 0\\end{aligned}].$" :question/worked-solution "To find a basis of $\\text{Null}(A),$ we need to solve the equation $Ax=0$ and express the solution as a linear combination of linearly independent vectors. Those vectors form a basis of $\\text{Null}(A).$\n\nThe given matrix is already in row echelon form. So, the equation $Ax=0$ corresponds to the following system:\n\n$$\n{\\begin{aligned}{x}_{1}+5{x}_{2}=0 \\\\ {x}_{2}=0\\end{aligned}\\,⟹\\,{\\begin{aligned}{x}_{1}=0 \\\\ {x}_{2}=0\\end{aligned}\n$$\n\nThis implies that the only solution of $Ax=0$ is $x=0.$ So, $\\text{Null}(A)={0},$ which means that the basis of $\\text{Null}(A)$ is the empty set, i.e., $B={\\,}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-75000/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5c70963f-589d-532b-9286-559f68693df7"] :knowledge-point/questions ["q-75000"] :db/ensure [:knowledge-point/validate]} {:db/id "q-75005/selection/4bbce5e0804dd619d92166f501b208e7a5fad60f792ff13ef1cdb2d07d03040b" :answer/id #uuid "66cd3ef6-e517-578f-ac2a-1939c1155392" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}3 \\\\ 1 \\\\ 1 \\\\ 0\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-75005/selection/b8db0972ec561fa2948dac828093de02b1e2b5b6227c59ea09eea74b226faad2" :answer/id #uuid "91c7c38c-6bf8-56ec-a726-b18d26c3c8f1" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}-3 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-75005/selection/9f2765042198fd0cdfe5d6191e237debed5f5c5308aefcba55c030fa2622ed63" :answer/id #uuid "ec81cf60-eb23-50c7-b7c7-795623b43327" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}-3 \\\\ 1 \\\\ 0 \\\\ 0\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-75005/selection/47ca9b38dee9e032667a6d1f10eb87228e6fa93da8cb157c8506929d2e22ee67" :answer/id #uuid "318a9f04-e408-548f-b246-fa387985cc40" :answer/type :answer.type/math :answer/value "B={\\,}" :db/ensure [:answer/validate]} {:db/id "q-75005/selection/957c426992f83f41ca03957947f625bc7ac78da31ab5b7deadfee8470befe1e8" :answer/id #uuid "d1595f7e-4a5d-51ce-9d77-d992986773fe" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}3 \\\\ 1 \\\\ 0 \\\\ 1\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-75005/selection" :answer-field/id #uuid "e44b1ae3-efbd-5cfd-b72a-3e1cac1855f7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-75005/selection/9f2765042198fd0cdfe5d6191e237debed5f5c5308aefcba55c030fa2622ed63" :answer-field/choices ["q-75005/selection/4bbce5e0804dd619d92166f501b208e7a5fad60f792ff13ef1cdb2d07d03040b" "q-75005/selection/b8db0972ec561fa2948dac828093de02b1e2b5b6227c59ea09eea74b226faad2" "q-75005/selection/9f2765042198fd0cdfe5d6191e237debed5f5c5308aefcba55c030fa2622ed63" "q-75005/selection/47ca9b38dee9e032667a6d1f10eb87228e6fa93da8cb157c8506929d2e22ee67" "q-75005/selection/957c426992f83f41ca03957947f625bc7ac78da31ab5b7deadfee8470befe1e8"] :db/ensure [:answer-field/validate]} {:db/id "q-75005" :question/id #uuid "c7daf4e8-d852-5394-bca1-f1c8e53a083e" :question/math-academy-id "q-75005" :question/problem "Find a basis of the null space of the matrix $A=[\\begin{aligned}1 & 3 & -1 & 0 \\\\ 0 & 0 & 1 & 2 \\\\ 0 & 0 & 0 & 1\\end{aligned}].$" :question/worked-solution "To find a basis of $\\text{Null}(A),$ we need to solve the equation $Ax=0$ and express the solution as a linear combination of linearly independent vectors. Those vectors form a basis of $\\text{Null}(A).$\n\nThe given matrix is already in row echelon form. So, the equation $Ax=0$ corresponds to the following system:\n\n$$\n{\\begin{aligned}{x}_{1}+3{x}_{2}-{x}_{3}=0 \\\\ {x}_{3}+2{x}_{4}=0 \\\\ {x}_{4}=0\\end{aligned}\\,⟹\\,{\\begin{aligned}{x}_{1}=-3{x}_{2} \\\\ {x}_{3}=0 \\\\ {x}_{4}=0\\end{aligned}\n$$\n\nHere, ${x}_{1}$, ${x}_{3}$, and ${x}_{4}$ are basic variables corresponding to the pivot columns ($1$st, $3$rd, and $4$th) and ${x}_{2}$ is a free variable corresponding to the non-pivot column. Therefore, if $x\\in \\text{Null}(A),$ then\n\n$$\n[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3} \\\\ {x}_{4}\\end{aligned}]=[\\begin{aligned}-3{x}_{2} \\\\ {x}_{2} \\\\ 0 \\\\ 0\\end{aligned}]={x}_{2}[\\begin{aligned}-3 \\\\ 1 \\\\ 0 \\\\ 0\\end{aligned}],\n$$\n\nwhere ${x}_{2}\\in R.$ This implies that\n\n$$\nB={[\\begin{aligned}-3 \\\\ 1 \\\\ 0 \\\\ 0\\end{aligned}]}\n$$\n\nis a basis of $\\text{Null}(A)$ since it is a linearly independent set and its vectors generate the $\\text{Null}(A).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-75005/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5c70963f-589d-532b-9286-559f68693df7"] :knowledge-point/questions ["q-75005"] :db/ensure [:knowledge-point/validate]} {:db/id "q-111398/selection/de9515c039e252a3deb3ffb253290c910a760f902877a3bc9a5ae8ad34c739d7" :answer/id #uuid "6b553acd-3df6-5552-8350-421674d434b4" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}-4 \\\\ -2 \\\\ 1\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-111398/selection/725c81a79a0516863160809d4c90a0dac506a77597e097f16e09a389d2783447" :answer/id #uuid "f25d8840-4a2e-54a0-aa13-eb1224d3e1c6" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}-4 \\\\ -2 \\\\ 0\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-111398/selection/2ded5b5321f2da4f94480d08e5313fceb3d61416263443bc233d63409a580526" :answer/id #uuid "ff5db1e5-d880-5335-9afc-efc46c8aefd2" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}1 \\\\ 0 \\\\ -4\\end{aligned}],[\\begin{aligned}0 \\\\ 1 \\\\ -2\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-111398/selection/b5645755c22f6d94bda961f71f1a41ccf4270c75aba300258339fa0d345bc7ee" :answer/id #uuid "579f272a-748f-5981-ad24-2c07f6edfed6" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}4 \\\\ 2 \\\\ 1\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-111398/selection/47ca9b38dee9e032667a6d1f10eb87228e6fa93da8cb157c8506929d2e22ee67" :answer/id #uuid "0a301330-3b7f-5fe9-8c73-8a50d23cb1d1" :answer/type :answer.type/math :answer/value "B={\\,}" :db/ensure [:answer/validate]} {:db/id "q-111398/selection" :answer-field/id #uuid "a843ae87-7398-5149-9549-67942003d764" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-111398/selection/b5645755c22f6d94bda961f71f1a41ccf4270c75aba300258339fa0d345bc7ee" :answer-field/choices ["q-111398/selection/de9515c039e252a3deb3ffb253290c910a760f902877a3bc9a5ae8ad34c739d7" "q-111398/selection/725c81a79a0516863160809d4c90a0dac506a77597e097f16e09a389d2783447" "q-111398/selection/2ded5b5321f2da4f94480d08e5313fceb3d61416263443bc233d63409a580526" "q-111398/selection/b5645755c22f6d94bda961f71f1a41ccf4270c75aba300258339fa0d345bc7ee" "q-111398/selection/47ca9b38dee9e032667a6d1f10eb87228e6fa93da8cb157c8506929d2e22ee67"] :db/ensure [:answer-field/validate]} {:db/id "q-111398" :question/id #uuid "7095989b-ba77-5498-ade8-c79cbe233a38" :question/math-academy-id "q-111398" :question/problem "Find a basis of the null space of the matrix $A=[\\begin{aligned}1 & 0 & -4 \\\\ 0 & 1 & -2\\end{aligned}].$" :question/worked-solution "To find a basis of $\\text{Null}(A),$ we need to solve the equation $Ax=0$ and express the solution as a linear combination of linearly independent vectors. Those vectors form a basis of $\\text{Null}(A).$\n\nThe given matrix is already in reduced row echelon form. So, the equation $Ax=0$ corresponds to the following system:\n\n$$\n{\\begin{aligned}{x}_{1}-4{x}_{3}=0 \\\\ {x}_{2}-2{x}_{3}=0\\end{aligned}\\,⟹\\,{\\begin{aligned}{x}_{1}=4{x}_{3} \\\\ {x}_{2}=2{x}_{3}\\end{aligned}\n$$\n\nHere, ${x}_{1}$ and ${x}_{2}$ are basic variables corresponding to the pivot columns ($1$st and $2$nd) and ${x}_{3}$ is a free variable corresponding to the non-pivot column. Therefore, if $x\\in \\text{Null}(A),$ then\n\n$$\n[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]=[\\begin{aligned}4{x}_{3} \\\\ 2{x}_{3} \\\\ {x}_{3}\\end{aligned}]={x}_{3}[\\begin{aligned}4 \\\\ 2 \\\\ 1\\end{aligned}],\n$$\n\nwhere ${x}_{3}\\in R.$ This implies that\n\n$$\nB={[\\begin{aligned}4 \\\\ 2 \\\\ 1\\end{aligned}]}\n$$\n\nis a basis of $\\text{Null}(A)$ since it is a linearly independent set and its vectors generate the $\\text{Null}(A).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-111398/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5c70963f-589d-532b-9286-559f68693df7"] :knowledge-point/questions ["q-111398"] :db/ensure [:knowledge-point/validate]} {:db/id "q-111465/selection/f571b89b43f089109d740f54c1823a69b13f46ef0476661044220bb043aa778f" :answer/id #uuid "d8b001e6-0b75-5373-9dca-239f74c8d198" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}1 \\\\ 1 \\\\ -6 \\\\ 3\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-111465/selection/fc7e49c546f774aec307630f3f55ebef26e05677b9bdb4f4d5176870b33cf447" :answer/id #uuid "16cab098-118e-5afb-a016-a369a4188885" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}0 \\\\ 6 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}-3 \\\\ 0 \\\\ 0 \\\\ 1\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-111465/selection/428639d2eebf7174f2065b2933ecb7ae00171238497b7f475859723062557d8c" :answer/id #uuid "7fcf2413-e0cf-5bf3-aae7-46247575f755" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}3 \\\\ 0 \\\\ 0 \\\\ 1\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-111465/selection/3b23dc4eafb315e9adf10263f6832690d743db232905ff6a097a55c78629eaaa" :answer/id #uuid "64a59b1c-c6bf-515c-8b99-bbb624cedca2" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}0 \\\\ -6 \\\\ 0 \\\\ 0\\end{aligned}],[\\begin{aligned}3 \\\\ 0 \\\\ 0 \\\\ 0\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-111465/selection/3838598d107837b36ccf4d3b0626a3120cddade7b65781d71a9afaeec21754b7" :answer/id #uuid "ef0ec330-75b9-5a76-8954-43f9986d770f" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}0 \\\\ 6 \\\\ 1 \\\\ 0\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-111465/selection" :answer-field/id #uuid "950cce46-5a0e-50fc-9595-9d45dca794a9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-111465/selection/fc7e49c546f774aec307630f3f55ebef26e05677b9bdb4f4d5176870b33cf447" :answer-field/choices ["q-111465/selection/f571b89b43f089109d740f54c1823a69b13f46ef0476661044220bb043aa778f" "q-111465/selection/fc7e49c546f774aec307630f3f55ebef26e05677b9bdb4f4d5176870b33cf447" "q-111465/selection/428639d2eebf7174f2065b2933ecb7ae00171238497b7f475859723062557d8c" "q-111465/selection/3b23dc4eafb315e9adf10263f6832690d743db232905ff6a097a55c78629eaaa" "q-111465/selection/3838598d107837b36ccf4d3b0626a3120cddade7b65781d71a9afaeec21754b7"] :db/ensure [:answer-field/validate]} {:db/id "q-111465" :question/id #uuid "f19d57e6-6b89-55e7-b813-b424786f66b7" :question/math-academy-id "q-111465" :question/problem "Find a basis of the null space of the matrix $A=[\\begin{aligned}1 & 0 & 0 & 3 \\\\ 0 & 1 & -6 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}].$" :question/worked-solution "To find a basis of $\\text{Null}(A),$ we need to solve the equation $Ax=0$ and express the solution as a linear combination of linearly independent vectors. Those vectors form a basis of $\\text{Null}(A).$\n\nThe given matrix is already in reduced row echelon form. So, the equation $Ax=0$ corresponds to the following system:\n\n$$\n{\\begin{aligned}{x}_{1}+3{x}_{4}=0 \\\\ {x}_{2}-6{x}_{3}=0\\end{aligned}\\,⟹\\,{\\begin{aligned}{x}_{1}=-3{x}_{4} \\\\ {x}_{2}=6{x}_{3}\\end{aligned}\n$$\n\nHere, ${x}_{1}$ and  ${x}_{2}$ are basic variables corresponding to the pivot columns ($1$st and $2$nd), and ${x}_{3}$ and ${x}_{4}$ are free variable corresponding to the non-pivot columns. Therefore, if $x\\in \\text{Null}(A),$ then\n\n$$\n[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3} \\\\ {x}_{4}\\end{aligned}]=[\\begin{aligned}-3{x}_{4} \\\\ 6{x}_{3} \\\\ {x}_{3} \\\\ {x}_{4}\\end{aligned}]={x}_{3}[\\begin{aligned}0 \\\\ 6 \\\\ 1 \\\\ 0\\end{aligned}]+{x}_{4}[\\begin{aligned}-3 \\\\ 0 \\\\ 0 \\\\ 1\\end{aligned}],\n$$\n\nwhere ${x}_{3},\\,{x}_{4}\\in R.$ This implies that\n\n$$\nB={[\\begin{aligned}0 \\\\ 6 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}-3 \\\\ 0 \\\\ 0 \\\\ 1\\end{aligned}]}\n$$\n\nis a basis of $\\text{Null}(A)$ since it is a linearly independent set and its vectors generate the $\\text{Null}(A).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-111465/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5c70963f-589d-532b-9286-559f68693df7"] :knowledge-point/questions ["q-111465"] :db/ensure [:knowledge-point/validate]} {:db/id "q-111507/selection/957c426992f83f41ca03957947f625bc7ac78da31ab5b7deadfee8470befe1e8" :answer/id #uuid "80f7f54f-0c08-58e2-9757-43c869cff3b5" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}3 \\\\ 1 \\\\ 0 \\\\ 1\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-111507/selection/47ca9b38dee9e032667a6d1f10eb87228e6fa93da8cb157c8506929d2e22ee67" :answer/id #uuid "bf8be069-ae1d-57c5-9191-cbfcca9f22ca" :answer/type :answer.type/math :answer/value "B={\\,}" :db/ensure [:answer/validate]} {:db/id "q-111507/selection/d55b2d5cf38a58d062750612cc39284014fb078bf3bfbc6d14368025438751eb" :answer/id #uuid "04