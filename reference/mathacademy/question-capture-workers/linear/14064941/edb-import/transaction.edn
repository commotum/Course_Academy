igned}1 & 2 & 1 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 0\\end{aligned}] & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nSo, the equation $Ax=0$ is equivalent to the system\n\n$$\n{\\begin{aligned}{x}_{1}+{x}_{3}=0 \\\\ {x}_{2}=0.\\end{aligned}\n$$\n\nThe general solution is ${x}_{1}=-{x}_{3}$ and ${x}_{2}=0,$ where ${x}_{3}$ is a free variable. Therefore, if $x\\in \\text{Null}(A),$ then\n\n$$\n[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]=[\\begin{aligned}-{x}_{3} \\\\ 0 \\\\ {x}_{3}\\end{aligned}]={x}_{3}[\\begin{aligned}-1 \\\\ 0 \\\\ 1\\end{aligned}],\\,{x}_{3}\\in R.\n$$\n\nThis implies that \n\n$$\nB={[\\begin{aligned}-1 \\\\ 0 \\\\ 1\\end{aligned}]}\n$$\n\nis a basis of $\\text{Null}(A)$ since it is a linearly independent set and its vectors generate $\\text{Null}(A).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-34422/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0fd5a675-c692-505e-900b-d7500fb7c653"] :knowledge-point/questions ["q-34422"] :db/ensure [:knowledge-point/validate]} {:db/id "q-75026/selection/2e78a17ddd3947c55e112bc269d8f597286218848d94c0c86472cfd9f7b07d5b" :answer/id #uuid "e20def63-ccf3-5295-837b-31bfcbee3ff1" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}0 \\\\ 5 \\\\ 1 \\\\ 0\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-75026/selection/72108857ee31710090fdc8fddf057b791fc2d3d6890b99b02a3a8f05da04d958" :answer/id #uuid "7d89c54f-27e6-58b0-8de9-629b124aca96" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}2 \\\\ -5 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}-2 \\\\ 1 \\\\ 0 \\\\ 1\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-75026/selection/6450834329779423574815fb0c49f62181ce91d6e4b7dc1b4810860f4263e79b" :answer/id #uuid "f5e8bcf7-5566-583d-9c52-b2682c54f6ed" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}-2 \\\\ -5 \\\\ 1 \\\\ 0\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-75026/selection/47ca9b38dee9e032667a6d1f10eb87228e6fa93da8cb157c8506929d2e22ee67" :answer/id #uuid "3bbfc578-daae-565b-89b0-730e331eb50e" :answer/type :answer.type/math :answer/value "B={\\,}" :db/ensure [:answer/validate]} {:db/id "q-75026/selection/eb2515a059148b0bfa0bdf227e4dd10eb161ae64c5eb45d04529c450c934b86c" :answer/id #uuid "e0d5d98c-34a1-529e-8d28-5f1e544b5f86" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}2 \\\\ 0 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}-2 \\\\ 5 \\\\ 0 \\\\ 1\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-75026/selection" :answer-field/id #uuid "63f64c12-cb0f-5f0c-a29f-4a46a19b29d0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-75026/selection/72108857ee31710090fdc8fddf057b791fc2d3d6890b99b02a3a8f05da04d958" :answer-field/choices ["q-75026/selection/2e78a17ddd3947c55e112bc269d8f597286218848d94c0c86472cfd9f7b07d5b" "q-75026/selection/72108857ee31710090fdc8fddf057b791fc2d3d6890b99b02a3a8f05da04d958" "q-75026/selection/6450834329779423574815fb0c49f62181ce91d6e4b7dc1b4810860f4263e79b" "q-75026/selection/47ca9b38dee9e032667a6d1f10eb87228e6fa93da8cb157c8506929d2e22ee67" "q-75026/selection/eb2515a059148b0bfa0bdf227e4dd10eb161ae64c5eb45d04529c450c934b86c"] :db/ensure [:answer-field/validate]} {:db/id "q-75026" :question/id #uuid "63b870f4-333b-532e-9d7a-cc7f9a127a52" :question/math-academy-id "q-75026" :question/problem "Given the matrix $A=[\\begin{aligned}-1 & 0 & 2 & -2 \\\\ 1 & 1 & 3 & 1\\end{aligned}]$, find a basis of $\\text{Null}(A).$" :question/worked-solution "First, we reduce the matrix $A$ to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}-1 & 0 & 2 & -2 \\\\ 1 & 1 & 3 & 1\\end{aligned}] & {R}_{1} & :=-{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & -2 & 2 \\\\ 1 & 1 & 3 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & -2 & 2 \\\\ 0 & 1 & 5 & -1\\end{aligned}]\\end{aligned}\n$$\n\nSo, equation $Ax=0$ is equivalent to the system\n\n$$\n{\\begin{aligned}{x}_{1}-2{x}_{3}+2{x}_{4}=0 \\\\ {x}_{2}+5{x}_{3}-{x}_{4}=0.\\end{aligned}\n$$\n\nThe general solution is ${x}_{1}=2{x}_{3}-2{x}_{4}$ and ${x}_{2}=-5{x}_{3}+{x}_{4},$ where ${x}_{3}$ and ${x}_{4}$ are free variables. Therefore, if $x\\in \\text{Null}(A),$ then\n\n$$\n\\begin{aligned}[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3} \\\\ {x}_{4}\\end{aligned}] & =[\\begin{aligned}2{x}_{3}-2{x}_{4} \\\\ -5{x}_{3}+{x}_{4} \\\\ {x}_{3} \\\\ {x}_{4}\\end{aligned}] \\\\  & =[\\begin{aligned}2{x}_{3} \\\\ -5{x}_{3} \\\\ {x}_{3} \\\\ 0\\end{aligned}]+[\\begin{aligned}-2{x}_{4} \\\\ {x}_{4} \\\\ 0 \\\\ {x}_{4}\\end{aligned}] \\\\  & ={x}_{3}[\\begin{aligned}2 \\\\ -5 \\\\ 1 \\\\ 0\\end{aligned}]+{x}_{4}[\\begin{aligned}-2 \\\\ 1 \\\\ 0 \\\\ 1\\end{aligned}],\\,{x}_{3},{x}_{4}\\in R.\\end{aligned}\n$$\n\nThis implies that \n\n$$\nB={[\\begin{aligned}2 \\\\ -5 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}-2 \\\\ 1 \\\\ 0 \\\\ 1\\end{aligned}]}\n$$\n\nis a basis of $\\text{Null}(A)$ since it is a linearly independent set and its vectors generate $\\text{Null}(A).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-75026/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0fd5a675-c692-505e-900b-d7500fb7c653"] :knowledge-point/questions ["q-75026"] :db/ensure [:knowledge-point/validate]} {:db/id "q-75024/selection/a44378ee17b469e76e7bee3ed8a669cfd07ca3f863f9860c180cf2fc6a5b9581" :answer/id #uuid "dd20b1ec-c9cc-5380-b9c5-21149b782330" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}0 \\\\ 1 \\\\ 0 \\\\ 0\\end{aligned}],[\\begin{aligned}-4 \\\\ 0 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}2 \\\\ 0 \\\\ 0 \\\\ 1\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-75024/selection/377f4627f244a9d8642628dd0b4cdd216ca7322e6499411a6f2c37ee0938e6f6" :answer/id #uuid "a8867b84-cda1-5d86-91d8-9eab3a3a5f44" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}4 \\\\ 0 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}-2 \\\\ 0 \\\\ 0 \\\\ 1\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-75024/selection/0e682956089fc6d7ef52c60c385754a0ee0dc402251e7058c94df0474e3637cc" :answer/id #uuid "e3efce6a-3f31-5499-9af7-06ec4ac3a4a3" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}0 \\\\ 1 \\\\ 0 \\\\ 0\\end{aligned}],[\\begin{aligned}4 \\\\ 0 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}-2 \\\\ 0 \\\\ 0 \\\\ 1\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-75024/selection/251a464ae89d0cfe32dc1506e302f553b47a6e40ef3d9bb28b74aef772d8f35d" :answer/id #uuid "c6601957-7bf0-53fd-bbe1-d5d8d52e3e33" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}4 \\\\ 1 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}-2 \\\\ 0 \\\\ 0 \\\\ 1\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-75024/selection/47ca9b38dee9e032667a6d1f10eb87228e6fa93da8cb157c8506929d2e22ee67" :answer/id #uuid "d213720e-e3d0-5d1e-8a89-ce2798b4dbaa" :answer/type :answer.type/math :answer/value "B={\\,}" :db/ensure [:answer/validate]} {:db/id "q-75024/selection" :answer-field/id #uuid "525f3c0d-8b1b-55d8-a83c-c3f612a4ed3b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-75024/selection/0e682956089fc6d7ef52c60c385754a0ee0dc402251e7058c94df0474e3637cc" :answer-field/choices ["q-75024/selection/a44378ee17b469e76e7bee3ed8a669cfd07ca3f863f9860c180cf2fc6a5b9581" "q-75024/selection/377f4627f244a9d8642628dd0b4cdd216ca7322e6499411a6f2c37ee0938e6f6" "q-75024/selection/0e682956089fc6d7ef52c60c385754a0ee0dc402251e7058c94df0474e3637cc" "q-75024/selection/251a464ae89d0cfe32dc1506e302f553b47a6e40ef3d9bb28b74aef772d8f35d" "q-75024/selection/47ca9b38dee9e032667a6d1f10eb87228e6fa93da8cb157c8506929d2e22ee67"] :db/ensure [:answer-field/validate]} {:db/id "q-75024" :question/id #uuid "3d8eef93-735e-5ee8-8363-b800d4ca0ad1" :question/math-academy-id "q-75024" :question/problem "Given the matrix $A=[\\begin{aligned}-2 & 0 & 8 & -4\\end{aligned}]$, find a basis of $\\text{Null}(A).$" :question/worked-solution "First, we reduce the matrix $A$ to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}-2 & 0 & 8 & -4\\end{aligned}] & {R}_{1} & :=-\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & -4 & 2\\end{aligned}]\\end{aligned}\n$$\n\nSo, the equation $Ax=0$ is equivalent to the system\n\n$$\n{\\begin{aligned}{x}_{1}-4{x}_{3}+2{x}_{4}=0.\\end{aligned}\n$$\n\nThe general solution is ${x}_{1}=4{x}_{3}-2{x}_{4},$ where ${x}_{2},$ ${x}_{3},$ and ${x}_{4}$ are free variables. Therefore, if $x\\in \\text{Null}(A),$ then\n\n$$\n\\begin{aligned}[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3} \\\\ {x}_{4}\\end{aligned}] & =[\\begin{aligned}4{x}_{3}-2{x}_{4} \\\\ {x}_{2} \\\\ {x}_{3} \\\\ {x}_{4}\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ {x}_{2} \\\\ 0 \\\\ 0\\end{aligned}]+[\\begin{aligned}4{x}_{3} \\\\ 0 \\\\ {x}_{3} \\\\ 0\\end{aligned}]+[\\begin{aligned}-2{x}_{4} \\\\ 0 \\\\ 0 \\\\ {x}_{4}\\end{aligned}] \\\\  & ={x}_{2}[\\begin{aligned}0 \\\\ 1 \\\\ 0 \\\\ 0\\end{aligned}]+{x}_{3}[\\begin{aligned}4 \\\\ 0 \\\\ 1 \\\\ 0\\end{aligned}]+{x}_{4}[\\begin{aligned}-2 \\\\ 0 \\\\ 0 \\\\ 1\\end{aligned}],\\,{x}_{2},{x}_{3},{x}_{4}\\in R.\\end{aligned}\n$$\n\nThis implies that \n\n$$\nB={[\\begin{aligned}0 \\\\ 1 \\\\ 0 \\\\ 0\\end{aligned}],[\\begin{aligned}4 \\\\ 0 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}-2 \\\\ 0 \\\\ 0 \\\\ 1\\end{aligned}]}\n$$\n\nis a basis of $\\text{Null}(A)$ since it is a linearly independent set and its vectors generate $\\text{Null}(A).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-75024/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0fd5a675-c692-505e-900b-d7500fb7c653"] :knowledge-point/questions ["q-75024"] :db/ensure [:knowledge-point/validate]} {:db/id "q-112149/selection/6c1594fc5ab879b28df227035a86bda77b234920cf89aa2345dfd5d0b97cfbed" :answer/id #uuid "05e98b75-1171-5f04-90eb-de2b6df70ae1" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}0 \\\\ 6 \\\\ 0 \\\\ 1\\end{aligned}],[\\begin{aligned}1 \\\\ 0 \\\\ -1 \\\\ 1\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-112149/selection/2e8e0ea9dd108d058af61f088fc4c49ba6712241c2e8265aea090ce575a0d143" :answer/id #uuid "92d6af79-d22d-544d-81ef-a6d1fe0815ef" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}1 \\\\ -2 \\\\ 0 \\\\ 0\\end{aligned}],[\\begin{aligned}1 \\\\ 1 \\\\ 0 \\\\ 1\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-112149/selection/b7f061f5837fb7892457e046066169e0fa15a6d7147a7f46df95ac7ff816a5bb" :answer/id #uuid "d8e98535-8a6a-5e65-a25b-4fcb74e85f24" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}1 \\\\ 0 \\\\ 0 \\\\ 0\\end{aligned}],[\\begin{aligned}1 \\\\ -1 \\\\ -7 \\\\ 1\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-112149/selection/47ca9b38dee9e032667a6d1f10eb87228e6fa93da8cb157c8506929d2e22ee67" :answer/id #uuid "18b7c4c2-054e-5b2f-8fda-465730de537c" :answer/type :answer.type/math :answer/value "B={\\,}" :db/ensure [:answer/validate]} {:db/id "q-112149/selection/e93a1f0dc698ac0d2a49d5651466608edbc71d3bebc3120d8ca6583cff70d752" :answer/id #uuid "6932ab4e-13e2-58ec-a681-21da38bd07fd" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}-9 \\\\ 6 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}4 \\\\ -3 \\\\ 0 \\\\ 1\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-112149/selection" :answer-field/id #uuid "9dbf2520-6a18-5ad8-bc2f-1e2bb49cb438" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-112149/selection/e93a1f0dc698ac0d2a49d5651466608edbc71d3bebc3120d8ca6583cff70d752" :answer-field/choices ["q-112149/selection/6c1594fc5ab879b28df227035a86bda77b234920cf89aa2345dfd5d0b97cfbed" "q-112149/selection/2e8e0ea9dd108d058af61f088fc4c49ba6712241c2e8265aea090ce575a0d143" "q-112149/selection/b7f061f5837fb7892457e046066169e0fa15a6d7147a7f46df95ac7ff816a5bb" "q-112149/selection/47ca9b38dee9e032667a6d1f10eb87228e6fa93da8cb157c8506929d2e22ee67" "q-112149/selection/e93a1f0dc698ac0d2a49d5651466608edbc71d3bebc3120d8ca6583cff70d752"] :db/ensure [:answer-field/validate]} {:db/id "q-112149" :question/id #uuid "9806fa2a-123d-528f-bcfe-05b6a48eeb82" :question/math-academy-id "q-112149" :question/problem "Given the matrix $A=[\\begin{aligned}2 & 3 & 0 & 1 \\\\ 1 & 1 & 3 & -1\\end{aligned}]$, find a basis of $\\text{Null}(A).$" :question/worked-solution "First, we reduce the matrix $A$ to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2 & 3 & 0 & 1 \\\\ 1 & 1 & 3 & -1\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 1 & 3 & -1 \\\\ 2 & 3 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 3 & -1 \\\\ 0 & 1 & -6 & 3\\end{aligned}] & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 9 & -4 \\\\ 0 & 1 & -6 & 3\\end{aligned}]\\end{aligned}\n$$\n\nSo, equation $Ax=0$ is equivalent to the system\n\n$$\n{\\begin{aligned}{x}_{1}+9{x}_{3}-4{x}_{4}=0 \\\\ {x}_{2}-6{x}_{3}+3{x}_{4}=0.\\end{aligned}\n$$\n\nThe general solution is ${x}_{1}=-9{x}_{3}+4{x}_{4}$ and ${x}_{2}=6{x}_{3}-3{x}_{4},$ where ${x}_{3}$ and ${x}_{4}$ are free variables. Therefore, if $x\\in \\text{Null}(A),$ then\n\n$$\n\\begin{aligned}[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3} \\\\ {x}_{4}\\end{aligned}] & =[\\begin{aligned}-9{x}_{3}+4{x}_{4} \\\\ 6{x}_{3}-3{x}_{4} \\\\ {x}_{3} \\\\ {x}_{4}\\end{aligned}] \\\\  & =[\\begin{aligned}-9{x}_{3} \\\\ 6{x}_{3} \\\\ {x}_{3} \\\\ 0\\end{aligned}]+[\\begin{aligned}4{x}_{4} \\\\ -3{x}_{4} \\\\ 0 \\\\ {x}_{4}\\end{aligned}] \\\\  & ={x}_{3}[\\begin{aligned}-9 \\\\ 6 \\\\ 1 \\\\ 0\\end{aligned}]+{x}_{4}[\\begin{aligned}4 \\\\ -3 \\\\ 0 \\\\ 1\\end{aligned}],\\,{x}_{3},{x}_{4}\\in R.\\end{aligned}\n$$\n\nThis implies that \n\n$$\nB={[\\begin{aligned}-9 \\\\ 6 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}4 \\\\ -3 \\\\ 0 \\\\ 1\\end{aligned}]}\n$$\n\nis a basis of $\\text{Null}(A)$ since it is a linearly independent set and its vectors generate $\\text{Null}(A).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-112149/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0fd5a675-c692-505e-900b-d7500fb7c653"] :knowledge-point/questions ["q-112149"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-4820"] :question/problem "Given that  ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14064941/assets/412e5084f88d0eb270b0e8a1f5613f85e1cec2c9f89879ccda30ff4c0794fb3d.png) find a basis for $\\textrm{Null}(A).$" :question/worked-solution "Any vector in $\\textrm{Null}(A)$ has the form\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14064941/assets/7bba2b6227c4fe42901e654d6025c54d7937c13743dfc74586fc72c767c31c06.png)\n\nExpanding, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}3{x}_{3}-{x}_{4} \\\\ 4{x}_{3} \\\\ {x}_{3} \\\\ {x}_{4}\\end{aligned}] & =[\\begin{aligned}3{x}_{3} \\\\ 4{x}_{3} \\\\ {x}_{3} \\\\ 0\\end{aligned}]+[\\begin{aligned}-{x}_{4} \\\\ 0 \\\\ 0 \\\\ {x}_{4}\\end{aligned}] \\\\  & ={x}_{3}[\\begin{aligned}3 \\\\ 4 \\\\ 1 \\\\ 0\\end{aligned}]+{x}_{4}[\\begin{aligned}-1 \\\\ 0 \\\\ 0 \\\\ 1\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, a basis for $\\textrm{Null}(A)$ is\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14064941/assets/60eca2d19c167355d263c471cb876e181db49ab5ac65b27561e6fb95bcc21ec0.png)\n\nsince it is a linearly independent set and its vectors generate $\\textrm{Null}(A).$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4821"] :question/problem "Find a basis of the null space of the matrix ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14064941/assets/e85d4892dc0bad0c6019b0434eff3d140fcf654171f6fda480b109b324e7b443.png)" :question/worked-solution "To find a basis of $\\textrm{Null}(A),$ we need to solve the equation $A\\mathbf{x} = \\mathbf{0}$ and express the solution as a linear combination of linearly independent vectors. Those vectors form a basis of $\\textrm{Null}(A).$\n\nThe given matrix is already in reduced row echelon form. So, the equation $A\\mathbf{x}=\\mathbf{0}$ corresponds to the following system:\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14064941/assets/367b1779ba31df69791a24ab485f1715cedb46f57e383053fd17a189c465d09a.png)\n\nHere, $x_1$ and $x_3$ are basic variables corresponding to the pivot columns ($1$st and $3$rd) and $x_2,x_4$ are free variables corresponding to the non-pivot columns. Therefore, if $\\mathbf{x} \\in \\textrm{Null}(A),$ then\n\n$$\n\\begin{aligned}[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3} \\\\ {x}_{4}\\end{aligned}] & =[\\begin{aligned}-3{x}_{2} \\\\ {x}_{2} \\\\ 4{x}_{4} \\\\ {x}_{4}\\end{aligned}] \\\\  & =[\\begin{aligned}-3{x}_{2} \\\\ {x}_{2} \\\\ 0 \\\\ 0\\end{aligned}]+[\\begin{aligned}0 \\\\ 0 \\\\ 4{x}_{4} \\\\ {x}_{4}\\end{aligned}] \\\\  & ={x}_{2}[\\begin{aligned}-3 \\\\ 1 \\\\ 0 \\\\ 0\\end{aligned}]+{x}_{4}[\\begin{aligned}0 \\\\ 0 \\\\ 4 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nwhere $x_2,x_4\\in\\mathbb{R}.$ This implies that\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14064941/assets/9b2704bbd684106b7c1c7dbe52eb957e65e6634d9adb6ba7fb415b0097af7e64.png)\n\nis a basis of $\\textrm{Null}(A)$ since it is a linearly independent set and its vectors generate $\\textrm{Null}(A).$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4819"] :question/problem "The matrices $A$ and $B$ are given below. If $A$ is row equivalent to $B$, then find a basis of $\\textrm{Null}(A).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14064941/assets/5971723fe2da8b35c0c965b25bf084080b2602b52a1099b6c97f637ca62fb2c2.png)" :question/worked-solution "To find a basis of $\\textrm{Null}(A),$ we need to solve the equation $A\\mathbf{x} = \\mathbf{0}$ and express the solution as a linear combination of linearly independent vectors. Those vectors form a basis of $\\textrm{Null}(A).$\n\nSince $A\\sim B,$ the equation $A \\mathbf{x} = \\mathbf{0}$ is equivalent to the equation $B\\mathbf{x}=\\mathbf{0},$ which corresponds to the following system:\n\n$$\n{\\begin{aligned}{x}_{1}=0 \\\\ {x}_{2}-\\frac{1}{3}{x}_{3}+\\frac{2}{3}{x}_{4}=0\\end{aligned}\n$$\n\nSo, the general solution is $x_1=0$ and $x_2=\\dfrac{1}{3}x_3 - \\dfrac{2}{3} x_4$ where $x_3$ and $x_4$ are free variables. Therefore, if $\\mathbf{x}\\in\\textrm{Null}(A),$ then\n\n$$\n\\begin{aligned}[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3} \\\\ {x}_{4}\\end{aligned}] & =[\\begin{aligned}0 \\\\ \\frac{1}{3}{x}_{3}-\\frac{2}{3}{x}_{4} \\\\ {x}_{3} \\\\ {x}_{4}\\end{aligned}]={x}_{3}[\\begin{aligned}0 \\\\ \\frac{1}{3} \\\\ 1 \\\\ 0\\end{aligned}]+{x}_{4}[\\begin{aligned}0 \\\\ -\\frac{2}{3} \\\\ 0 \\\\ 1\\end{aligned}],\\,{x}_{3},{x}_{4}\\in R.\\end{aligned}\n$$\n\nThis implies that\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14064941/assets/7c7c6711d4453e0e8365dbec263cf23e0c8e4bf05ff091ecc3bf9593797ff538.png)\n\nis a basis of $\\textrm{Null}(A)$ since it is a linearly independent set and its vectors generate $\\textrm{Null}(A).$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4822"] :question/problem "Given the matrix ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14064941/assets/13a1fbdcd6620ab5ccc41283da5ded8996053f9a59fd8c820ea786837ae05222.png) find a basis of $\\textrm{Null}(A).$" :question/worked-solution "First, we reduce the matrix $A$ to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 0 & 2 \\\\ 0 & 1 & 2 \\\\ 0 & 2 & 5\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 2 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 2 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+(-2){R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nSo, the equation $A\\mathbf{x} = \\mathbf{0}$ is equivalent to the system\n\n$$\n{\\begin{aligned}{x}_{1}=0 \\\\ {x}_{2}=0 \\\\ {x}_{3}=0.\\end{aligned}\n$$\n\nThis implies that the only solution of $A\\mathbf{x}=\\mathbf{0}$ is $\\mathbf{x}=\\mathbf{0}.$ So $\\textrm{Null}(A)=\\{ \\mathbf{0} \\},$ which means that the basis of $\\textrm{Null}(A)$ is the empty set, i.e., $\\mathcal{B}=\\{\\,\\}.$" :db/ensure [:question/validate]}]
