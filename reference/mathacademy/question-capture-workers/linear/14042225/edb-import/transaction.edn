d}1 & 3 \\\\ 3 & 3\\end{aligned}],\\,B=[\\begin{aligned}0 & 1 \\\\ 3 & 0\\end{aligned}],\\,C=[\\begin{aligned}0 & 3 \\\\ 3 & 3\\end{aligned}]\n$$" :question/worked-solution "Let's apply the operations to each of the matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 3 \\\\ 3 & 3\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}3 & 3 \\\\ 1 & 3\\end{aligned}] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 \\\\ 1 & 3\\end{aligned}] \\\\  & \\ne I\\,\\times  \\\\ B & =[\\begin{aligned}0 & 1 \\\\ 3 & 0\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}3 & 0 \\\\ 0 & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =I\\,✓ \\\\ C & =[\\begin{aligned}0 & 3 \\\\ 3 & 3\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}3 & 3 \\\\ 0 & 3\\end{aligned}] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 \\\\ 0 & 3\\end{aligned}] \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only\"." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-131347/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "77d78574-a17c-5fc3-8c14-3aaec7753b3c"] :knowledge-point/questions ["q-131347"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130868/selection/685c02320dbe687345f93d820499dea4c0c82808b910e8a0e5841f77aa82209d" :answer/id #uuid "822b1894-de17-5a39-b99c-38ebb8d1cf37" :answer/type :answer.type/text :answer/value "$A$ only" :db/ensure [:answer/validate]} {:db/id "q-130868/selection/e956c3af673c94782038951d8de50bf89c9a53bf4daf2ca6725a4bea4229074c" :answer/id #uuid "b78a6998-7559-5bed-9ec2-a1771dd67f0b" :answer/type :answer.type/text :answer/value "$B$ only" :db/ensure [:answer/validate]} {:db/id "q-130868/selection/e432f1020975ada4c83798ae75bfd6c0ae4dfe63215763f08b8be8ccabf8a5d3" :answer/id #uuid "610741b1-d059-5614-beb3-7a8eec8ec8a6" :answer/type :answer.typ