gned}1 & 0 \\\\ 2 & 2\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}] \\\\  & \\ne I,\\,\\times  \\\\ B & =[\\begin{aligned}2 & 1 \\\\ 1 & 0\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =I\\,✓ \\\\ C & =[\\begin{aligned}2 & 1 \\\\ -1 & 0\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}-1 & 0 \\\\ 2 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}-1 & 0 \\\\ 4 & 1\\end{aligned}] \\\\  & \\ne I,\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only\"." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-130868/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "77d78574-a17c-5fc3-8c14-3aaec7753b3c"] :knowledge-point/questions ["q-130868"] :db/ensure [:knowledge-point/validate]} {:db/id "q-75599/selection/e956c3af673c94782038951d8de50bf89c9a53bf4daf2ca6725a4bea4229074c" :answer/id #uuid "3ba49cca-3f6d-5df2-a9b6-9e766d7a856e" :answer/type :answer.type/text :answer/value "$B$ only" :db/ensure [:answer/validate]} {:db/id "q-75599/selection/685c02320dbe687345f93d820499dea4c0c82808b910e8a0e5841f77aa82209d" :answer/id #uuid "398fdd89-5890-5788-aaa8-1a2c4c31962f" :answer/type :answer.type/text :answer/value "$A$ only" :db/ensure [:answer/validate]} {:db/id "q-75599/selection/2377e3ffc3b5cd65e1036103e0b988e5af6634b2438c63c3b7cc0592571401ab" :answer/id #uuid "c552824b-e24d-5fb3-821a-3a0dd043f6cd" :answer/type :answer.type/text :answer/value "$A$ and $C$ only" :db/ensure [:answer/validate]} {:db/id "q-75599/selection/b967c3002b3f913c5b31990d1f8159d3e1e979aa07e2842a8b67bfff1a2fd3f2" :answer/id #uuid "b657b32e-6798-5b1f-8c0c-cddb8cb717bb" :answer/type :answer.type/text :answer/value "$A$ and $B$ only" :db/ensure [:answer/validate]} {:db/id "q-75599/selection/e