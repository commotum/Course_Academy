4038863/state.json" "file_sha256" "f66ce7d6be3334cff21aaca28820dbf192362f25e77804ff8388e910bd03ac52"} {"question" "q-174432" "field" nil "attribute" "question/worked-solution" "value" "The union of a family of indexed sets is the set containing all elements belonging to *at least one* set in the indexed family:\n\n$$\n{⋃}_{i\\in I}{A}_{i}={x\\in U\\,:\\,x\\in {A}_{i}\\,\\,\\text{for at least one }{A}_{i},\\,\\,i\\in I}\n$$\n\nwhere $U$ is a universal set.\n\nTherefore, in our case, we have\n\n$$\n\\begin{aligned}{⋃}_{i\\in I}{X}_{i} & ={X}_{-2}\\cup {X}_{1}\\cup {X}_{2} \\\\  & ={-2,-1,0}\\,\\cup \\,{0,1}\\,\\cup \\,{0,1,2} \\\\  & ={-2,-1,0,1,2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038863/state.json" "file_sha256" "f66ce7d6be3334cff21aaca28820dbf192362f25e77804ff8388e910bd03ac52"} {"question" "q-174432" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038863/activity-metadata.json" "file_sha256" "738a4e0cbcad33d280093808d8491a29f9b6bae5ddd19b897166250d0475262a"} {"question" "q-174432" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038863/state.json" "file_sha256" "f66ce7d6be3334cff21aaca28820dbf192362f25e77804ff8388e910bd03ac52"} {"question" "q-174432" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{-2,-1,0,1,2}"] ["math" "{-2,0,1,2}"] ["math" "{-2,0,2}"] ["math" "{0,1,2}"] ["math" "{0}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038863/state.json" "file_sha256" "f66ce7d6be3334cff21aaca28820dbf192362f25e77804ff8388e910bd03ac52"} {"question" "q-174432" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{-2,-1,0,1,2}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038863/state.json" "file_sha256" "f66ce7d6be3334cff21aaca28820dbf192362f25e77804ff8388e910bd03ac52"} {"question" "q-174431" "field" nil "attribute" "question/problem" "value" "Find ${⋃}_{i\\in I}{X}_{i}$, given that $I={3,5,7},$ and\n\n$$\n\\begin{aligned}{X}_{3}={-3,0,3},\\,{X}_{5}={3,5},\\,{X}_{7}={-7,0,3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038863/state.json" "file_sha256" "f66ce7d6be3334cff21aaca28820dbf192362f25e77804ff8388e910bd03ac52"} {"question" "q-174431" "field" nil "attribute" "question/worked-solution" "value" "The union of a family of indexed sets is the set containing all elements belonging to *at least one* set in the indexed family:\n\n$$\n{⋃}_{i\\in I}{A}_{i}={x\\in U\\,:\\,x\\in {A}_{i}\\,\\,\\text{for at least one }{A}_{i},\\,\\,i\\in I}\n$$\n\nwhere $U$ is a universal set.\n\nTherefore, in our case, we have\n\n$$\n\\begin{aligned}{⋃}_{i\\in I}{X}_{i} & ={X}_{3}\\cup {X}_{5}\\cup {X}_{7} \\\\  & ={-3,0,3}\\,\\cup \\,{3,5}\\,\\cup \\,{-7,0,3} \\\\  & ={-7,-3,0,3,5}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038863/state.json" "file_sha256" "f66ce7d6be3334cff21aaca28820dbf192362f25e77804ff8388e910bd03ac52"} {"question" "q-174431" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038863/activity-metadata.json" "file_sha256" "738a4e0cbcad33d280093808d8491a29f9b6bae5ddd19b897166250d0475262a"} {"question" "q-174431" "field" "selection" "attribute" "a