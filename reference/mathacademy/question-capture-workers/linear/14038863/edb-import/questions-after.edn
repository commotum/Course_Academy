#{[{:db/id #edb/ref 17592186054275 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "3f986c29-111e-5cb3-8104-62ab734f1c47" :knowledge-point/title "Identifying Elements of an Indexed Family"}] :question/id #uuid "154d4cf7-a72a-51b1-bbb3-9bcf83b88e98" :question/math-academy-id "e-12665" :question/problem "Find $T_2$ given that $T_n = \\{ 1, 2, \\ldots, 2n+1 \\},$ where $n \\in \\mathbb{N}.$" :question/worked-solution "To write down the elements of $T_2,$ we substitute $n=2$ into the expression and get\n\n$$\n\\begin{aligned}{T}_{2} & ={1,2,…,2(2)+1} \\\\  & ={1,2,…,5} \\\\  & ={1,2,3,4,5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054282 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "957a2f61-61b1-5675-ba84-5348a47af986" :knowledge-point/title "Finding Unions and Intersections of Finite Families of Indexed Sets"}] :question/id #uuid "60e24dac-c47a-53ee-9c91-0e6987e966f0" :question/math-academy-id "e-12763" :question/problem "Find $\\,\\displaystyle \\bigcup_{i \\in I} S_i$, given that $I = \\{ -1, 0, 1 \\},$ and $S_i = (i-1, \\,i+1).$" :question/worked-solution "The union of a family of indexed sets is the set containing all elements belonging to *at least one* set in the indexed family:\n\n$$\n\\bigcup_{i \\in I} A_i = \\big\\{ x\\in U \\: : \\: x \\in A_i \\:\\:\\textrm{for at least one } A_i,\\:\\: i \\in I \\big\\}\n$$\n\nwhere $U$ is a universal set.\n\nTherefore, in our case, we have \n\n$$\n\\begin{aligned}{⋃}_{i\\in I}{S}_{i} & ={S}_{-1}\\cup {S}_{0}\\cup {S}_{1} \\\\  & =(-2,0)\\,\\cup \\,(-1,1)\\,\\cup \\,(0,2) \\\\  & =(-2,2).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054283 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "c1e93acb-6c0b-5263-9df9-9dcc00680845" :knowledge-point/title "Finding Unions and Intersections of (Countably) Infinite Families of Indexed Sets"}] :question/id #uuid "842ee2c1-8e78-56dd-b109-b9fcc273704e" :question/math-academy-id "e-12764" :question/problem "Find $\\,\\displaystyle \\bigcap_{i \\in I} X_i$  given that $I = \\mathbb{N}$ and $X_i = \\{ i, \\, 2i \\}.$" :question/worked-solution "The intersection of a family of indexed sets $\\{A_i\\}_{i\\in I}$ contains all elements that belong to *all* sets in our family:\n\n$$\n\\bigcap_{i \\in I} A_i = \\big\\{ x\\in U \\: : \\: x \\in A_i \\:\\:\\textrm{for all } A_i,\\:\\: i \\in I \\big\\}\n$$\n\nwhere $U$ is a universal set.\n\nLet's now write down a few instances of our indexed sets:\n\n- if $i=1,$ we have $X_1 = \\{ 1, 2 \\}$\n\n- if $i=2,$ we have $X_2 = \\{ 2, 4 \\}$\n\n- if $i=3,$ we have $X_3 = \\{ 3, 6 \\}$\n\n- if $i=4,$ we have $X_4 = \\{ 4, 8 \\}$\n\nand so on. \n\nNotice that there is no element that belongs to all the sets. Therefore,\n\n$$\n\\begin{aligned}{⋂}_{i\\in I}{X}_{i}=∅.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054960 :knowledge-point/_questions [{:knowledge-point/id #uuid "3f986c29-111e-5cb3-8104-62ab734f1c47" :knowledge-point/title "Identifying Elements of an Indexed Family"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "891c57e7-7a8a-5a83-af70-6e0a6138792b" :answer/type {:db/ident :answer.type/math} :answer/value "{1, 2, …, 41}" :db/id #edb/ref 17592186051702} {:answer/id #uuid "dd10fbcf-f5f8-5985-bdde-e51481dc5833" :answer/type {:db/ident :answer.type/math} :answer/value "{-5,-4, …, 4, 5}" :db/id #edb/ref 17592186051703} {:answer/id #uuid "1a08f111-d2ce-56fa-a5aa-7848cd20fe16" :answer/type {:db/ident :answer.type/math} :answer/value "{1, 2, 3, 4}" :db/id #edb/ref 17592186051704} {:answer/id #uuid "66e3711c-df15-5144-a652-2053423cbc5c" :answer/type {:db/ident :answer.type/math} :answer/value "{1, 2, 3, 4, 5}" :db/id #edb/ref 17592186051705} {:answer/id #uuid "6daee3a7-a690-5985-8150-de2b8d250f3a" :answer/type {:db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186051706}] :answer-field/correct {:answer/id #uuid "66e3711c-df15-5144-a652-2053423cbc5c" :answer/type {:db/ident :answer.type/math} :answer/value "{1, 2, 3, 4, 5}" :db/id #edb/ref 17592186051705} :answer-field/id #uuid "5034b73e-83b1-57b2-b792-e9e5c81b2e5c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186051701}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "3bbe0ff8-2b59-5a83-81b0-7e5b39b20a89" :question/math-academy-id "q-172665" :question/problem "Let ${S}_{n}={1,2,…,n+1},$ where $n\\in N.$ Then, ${S}_{4}=$" :question/worked-solution "To write down the elements of ${S}_{4},$ we substitute $n=4$ into the expression and get\n\n$$\n\\begin{aligned}{S}_{4} & ={1,2,…,4+1} \\\\  & ={1,2,…,5} \\\\  & ={1,2,3,4,5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186301837 :knowledge-point/_questions [{:knowledge-point/id #uuid "3f986c29-111e-5cb3-8104-62ab734f1c47" :knowledge-point/title "Identifying Elements of an Indexed Family"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f1d70040-3661-5c8f-a202-b312f83f8c37" :answer/type {:db/ident :answer.type/math} :answer/value "{0,1,2}" :db/id #edb/ref 17592186301839} {:answer/id #uuid "a6068690-7340-5af7-9af3-4a46faf38598" :answer/type {:db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186301840} {:answer/id #uuid "6f287108-616a-527f-a7c2-13bd348ce872" :answer/type {:db/ident :answer.type/math} :answer/value "{0,1,3}" :db/id #edb/ref 17592186301841} {:answer/id #uuid "c35f2a07-e624-5d9a-99fa-6127d82266a0" :answer/type {:db/ident :answer.type/math} :answer/value "{0,1,2,3,4}" :db/id #edb/ref 17592186301842} {:answer/id #uuid "36b72640-0d38-5ab8-80ee-5b581273e77e" :answer/type {:db/ident :answer.type/math} :answer/value "{0,1,4}" :db/id #edb/ref 17592186301843}] :answer-field/correct {:answer/id #uuid "36b72640-0d38-5ab8-80ee-5b581273e77e" :answer/type {:db/ident :answer.type/math} :answer/value "{0,1,4}" :db/id #edb/ref 17592186301843} :answer-field/id #uuid "6014c28f-f171-5876-a557-1f68b86d8e5c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301838}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f056d602-ed67-57b7-98ab-7fd6713d6edc" :question/math-academy-id "q-174340" :question/problem "Let ${B}_{i}={0,\\frac{i}{3},i+1},$ where $i\\in {1,2,3,4}.$ Then, ${B}_{3}=$" :question/worked-solution "To write down the elements of ${B}_{3},$ we substitute $i=3$ into the expression and get\n\n$$\n\\begin{aligned}{B}_{3} & ={0,\\frac{3}{3},3+1} \\\\  & ={0,1,4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186301844 :knowledge-point/_questions [{:knowledge-point/id #uuid "3f986c29-111e-5cb3-8104-62ab734f1c47" :knowledge-point/title "Identifying Elements of an Indexed Family"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b570d4d-cbbd-504e-b675-e33b9ee98042" :answer/type {:db/ident :answer.type/math} :answer/value "{1,2,4}" :db/id #edb/ref 17592186301846} {:answer/id #uuid "3326a8fe-ea1b-591e-9ad3-a0e938646fa9" :answer/type {:db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186301847} {:answer/id #uuid "ad416d02-a389-5019-8f13-ae8f940f79e4" :answer/type {:db/ident :answer.type/math} :answer/value "{1,2,6}" :db/id #edb/ref 17592186301848} {:answer/id #uuid "c4f9d2eb-efde-55b6-af17-3442b1192134" :answer/type {:db/ident :answer.type/math} :answer/value "{1,2,4,6}" :db/id #edb/ref 17592186301849} {:answer/id #uuid "a704e3ff-0bd4-5c71-8050-a1c15aeae2d0" :answer/type {:db/ident :answer.type/math} :answer/value "{2,4,6}" :db/id #edb/ref 17592186301850}] :answer-field/correct {:answer/id #uuid "ad416d02-a389-5019-8f13-ae8f940f79e4" :answer/type {:db/ident :answer.type/math} :answer/value "{1,2,6}" :db/id #edb/ref 17592186301848} :answer-field/id #uuid "041b88a1-46ba-54c7-9e93-ccde6a45dab6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301845}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7a95f959-608e-5e46-b852-21661f61cc79" :question/math-academy-id "q-174341" :question/problem "Let ${C}_{i}={1,i-2,i+2},$ where $i\\in {2,4,6}.$ Then, ${C}_{4}=$" :question/worked-solution "To write down the elements of ${C}_{4},$ we substitute $i=4$ into the expression and get\n\n$$\n\\begin{aligned}{C}_{4} & ={1,4-2,4+2} \\\\  & ={1,2,6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186301851 :knowledge-point/_questions [{:knowledge-point/id #uuid "3f986c29-111e-5cb3-8104-62ab734f1c47" :knowledge-point/title "Identifying Elements of an Indexed Family"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e35fc74-89e4-5adc-8459-5d3d6f93b25f" :answer/type {:db/ident :answer.type/math} :answer/value "{0,1,2}" :db/id #edb/ref 17592186301853} {:answer/id #uuid "8e13f82b-0316-52a5-9b6f-96060e3bdf18" :answer/type {:db/ident :answer.type/math} :answer/value "{-3,0,1,2,4}" :db/id #edb/ref 17592186301854} {:answer/id #uuid "8fc13b85-40ef-5682-ae0d-a44f080ba811" :answer/type {:db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186301855} {:answer/id #uuid "7e3fa304-33de-5d04-9384-65fc9798d053" :answer/type {:db/ident :answer.type/math} :answer/value "{1,3,4}" :db/id #edb/ref 17592186301856} {:answer/id #uuid "2b047952-2ef7-5b5c-b594-76d1f9d7bb8b" :answer/type {:db/ident :answer.type/math} :answer/value "{-3,1,4}" :db/id #edb/ref 17592186301857}] :answer-field/correct {:answer/id #uuid "2b047952-2ef7-5b5c-b594-76d1f9d7bb8b" :answer/type {:db/ident :answer.type/math} :answer/value "{-3,1,4}" :db/id #edb/ref 17592186301857} :answer-field/id #uuid "af6d0081-1f64-592b-b15b-af69a7677cb9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301852}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "831b13ab-db90-5aa8-ae96-e44ddb67b36f" :question/math-academy-id "q-174343" :question/problem "Let ${E}_{i}={1-2i,1,{i}^{2}},$ where $i\\in {0,1,2}.$ Then, ${E}_{2}=$" :question/worked-solution "To write down the elements of ${E}_{2},$ we substitute $i=2$ into the expression and get\n\n$$\n\\begin{aligned}{E}_{2} & ={1-2(2),1,{2}^{2}} \\\\  & ={-3,1,4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186301858 :knowledge-point/_questions [{:knowledge-point/id #uuid "3f986c29-111e-5cb3-8104-62ab734f1c47" :knowledge-point/title "Identifying Elements of an Indexed Family"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c47c3fe-ec07-5b80-aa8c-fa8e851f2afa" :answer/type {:db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186301860} {:answer/id #uuid "93ebb613-fdf9-5e54-b8f1-14a90aec09b3" :answer/type {:db/ident :answer.type/math} :answer/value "(1,{\\pi }^{2}]" :db/id #edb/ref 17592186301861} {:answer/id #uuid "bc00795a-0ae9-5144-9e4f-755af8782a89" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\pi ]" :db/id #edb/ref 17592186301862} {:answer/id #uuid "a043c953-86ec-56ed-9a0b-4dbdd57daf5e" :answer/type {:db/ident :answer.type/math} :answer/value "(0,2{\\pi }^{2}]" :db/id #edb/ref 17592186301863} {:answer/id #uuid "3d293630-1ea0-50f6-929b-fef5636b0265" :answer/type {:db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186301864}] :answer-field/correct {:answer/id #uuid "a043c953-86ec-56ed-9a0b-4dbdd57daf5e" :answer/type {:db/ident :answer.type/math} :answer/value "(0,2{\\pi }^{2}]" :db/id #edb/ref 17592186301863} :answer-field/id #uuid "652575d2-1133-52ba-aa18-1777b2241940" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301859}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "3b913652-35e0-5990-a89e-87d94dd9275f" :question/math-academy-id "q-174350" :question/problem "Let ${S}_{x}=(\\operatorname{sin}⁡x,{x}^{2}+{\\pi }^{2}],$ where $x\\in [0,2\\pi ).$ Then, ${S}_{\\pi }=$" :question/worked-solution "To write down the elements of ${S}_{\\pi },$ we substitute $x=\\pi $ into the expression and get\n\n$$\n\\begin{aligned}{S}_{\\pi } & =(\\operatorname{sin}⁡(\\pi ),\\,(\\pi )^{2}+{\\pi }^{2}] \\\\  & =(0,2{\\pi }^{2}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186301865 :knowledge-point/_questions [{:knowledge-point/id #uuid "957a2f61-61b1-5675-ba84-5348a47af986" :knowledge-point/title "Finding Unions and Intersections of Finite Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f008f046-84ed-5c7e-a0a0-c45d3848d790" :answer/type {:db/ident :answer.type/math} :answer/value "{2,4,5}" :db/id #edb/ref 17592186301867} {:answer/id #uuid "1a7cc1e5-20d8-59bf-931d-e5689a8884dc" :answer/type {:db/ident :answer.type/math} :answer/value "{6}" :db/id #edb/ref 17592186301868} {:answer/id #uuid "1f7be0ac-0576-5f9c-b75a-8262a35034a4" :answer/type {:db/ident :answer.type/math} :answer/value "{5,6}" :db/id #edb/ref 17592186301869} {:answer/id #uuid "0d76b397-b546-5514-9e5c-0ba358e2052b" :answer/type {:db/ident :answer.type/math} :answer/value "{2,3,4}" :db/id #edb/ref 17592186301870} {:answer/id #uuid "2b3d4bce-18fc-5506-bbe2-ff66b11f3e49" :answer/type {:db/ident :answer.type/math} :answer/value "{2,3,4,5,6}" :db/id #edb/ref 17592186301871}] :answer-field/correct {:answer/id #uuid "1f7be0ac-0576-5f9c-b75a-8262a35034a4" :answer/type {:db/ident :answer.type/math} :answer/value "{5,6}" :db/id #edb/ref 17592186301869} :answer-field/id #uuid "07bd7ece-0b07-582d-a99e-a09d579fc78a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301866}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "066c218f-a212-58e8-8ad0-d4072cc0fba8" :question/math-academy-id "q-174430" :question/problem "Find ${⋂}_{i\\in I}{X}_{i}$, given that $I={2,4,5},$ and\n\n$$\n\\begin{aligned}{X}_{i}={i,\\,i+1,…,6}.\\end{aligned}\n$$" :question/worked-solution "The intersection of a family of indexed sets ${{A}_{i}}_{i\\in I}$ contains all elements that belong to *all* sets in our family:\n\n$$\n{⋂}_{i\\in I}{A}_{i}={x\\in U\\,:\\,x\\in {A}_{i}\\,\\,\\text{for all }{A}_{i},\\,\\,i\\in I}\n$$\n\nwhere $U$ is a universal set.\n\nTherefore, in our case, we have\n\n$$\n\\begin{aligned}{⋂}_{i\\in I}{X}_{i} & ={X}_{2}\\cap {X}_{4}\\cap {X}_{5} \\\\  & ={2,3,4,5,6}\\,\\cap \\,{4,5,6}\\,\\cap \\,{5,6} \\\\  & ={5,6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186301872 :knowledge-point/_questions [{:knowledge-point/id #uuid "957a2f61-61b1-5675-ba84-5348a47af986" :knowledge-point/title "Finding Unions and Intersections of Finite Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab10a51c-f859-546b-8bb0-36def076aab4" :answer/type {:db/ident :answer.type/math} :answer/value "{0,3,5,7}" :db/id #edb/ref 17592186301874} {:answer/id #uuid "6cee5ce9-58e1-5415-9898-e05c1a17d475" :answer/type {:db/ident :answer.type/math} :answer/value "{0,3}" :db/id #edb/ref 17592186301875} {:answer/id #uuid "b6a8997b-810a-56a7-8217-b7c2d57559bd" :answer/type {:db/ident :answer.type/math} :answer/value "{-7,-3,0,3,5}" :db/id #edb/ref 17592186301876} {:answer/id #uuid "0f6ebdd0-30fb-505f-a22e-5baebaf50f60" :answer/type {:db/ident :answer.type/math} :answer/value "{-7,0,3,5}" :db/id #edb/ref 17592186301877} {:answer/id #uuid "8410c892-6fd6-58d8-905e-2ef0a2355a39" :answer/type {:db/ident :answer.type/math} :answer/value "{3}" :db/id #edb/ref 17592186301878}] :answer-field/correct {:answer/id #uuid "b6a8997b-810a-56a7-8217-b7c2d57559bd" :answer/type {:db/ident :answer.type/math} :answer/value "{-7,-3,0,3,5}" :db/id #edb/ref 17592186301876} :answer-field/id #uuid "38e906e6-0ada-59eb-a7cf-0d9577fd01c5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301873}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c960963c-99d2-5392-9aea-05d11962bf23" :question/math-academy-id "q-174431" :question/problem "Find ${⋃}_{i\\in I}{X}_{i}$, given that $I={3,5,7},$ and\n\n$$\n\\begin{aligned}{X}_{3}={-3,0,3},\\,{X}_{5}={3,5},\\,{X}_{7}={-7,0,3}.\\end{aligned}\n$$" :question/worked-solution "The union of a family of indexed sets is the set containing all elements belonging to *at least one* set in the indexed family:\n\n$$\n{⋃}_{i\\in I}{A}_{i}={x\\in U\\,:\\,x\\in {A}_{i}\\,\\,\\text{for at least one }{A}_{i},\\,\\,i\\in I}\n$$\n\nwhere $U$ is a universal set.\n\nTherefore, in our case, we have\n\n$$\n\\begin{aligned}{⋃}_{i\\in I}{X}_{i} & ={X}_{3}\\cup {X}_{5}\\cup {X}_{7} \\\\  & ={-3,0,3}\\,\\cup \\,{3,5}\\,\\cup \\,{-7,0,3} \\\\  & ={-7,-3,0,3,5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186301879 :knowledge-point/_questions [{:knowledge-point/id #uuid "957a2f61-61b1-5675-ba84-5348a47af986" :knowledge-point/title "Finding Unions and Intersections of Finite Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70aa514d-ce85-5ef3-a4d6-34797ec872d3" :answer/type {:db/ident :answer.type/math} :answer/value "{0,1,2}" :db/id #edb/ref 17592186301881} {:answer/id #uuid "c97317a8-a746-5750-b28a-a07f90a98120" :answer/type {:db/ident :answer.type/math} :answer/value "{0}" :db/id #edb/ref 17592186301882} {:answer/id #uuid "0d101027-229f-52b6-9945-fbbf2fd4db44" :answer/type {:db/ident :answer.type/math} :answer/value "{-2,0,1,2}" :db/id #edb/ref 17592186301883} {:answer/id #uuid "d8ef49f9-ab3d-5220-a75f-ce3b42b6e7e0" :answer/type {:db/ident :answer.type/math} :answer/value "{-2,0,2}" :db/id #edb/ref 17592186301884} {:answer/id #uuid "9602fe9e-1b01-562b-bd1a-e0f9e9a4c054" :answer/type {:db/ident :answer.type/math} :answer/value "{-2,-1,0,1,2}" :db/id #edb/ref 17592186301885}] :answer-field/correct {:answer/id #uuid "9602fe9e-1b01-562b-bd1a-e0f9e9a4c054" :answer/type {:db/ident