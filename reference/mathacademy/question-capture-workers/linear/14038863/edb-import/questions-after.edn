/_questions [{:knowledge-point/id #uuid "c1e93acb-6c0b-5263-9df9-9dcc00680845" :knowledge-point/title "Finding Unions and Intersections of (Countably) Infinite Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84ceb6b2-f3f9-5592-847a-a07c621f7bd7" :answer/type {:db/ident :answer.type/math} :answer/value "{0,2,4,…}" :db/id #edb/ref 17592186301909} {:answer/id #uuid "0d06b4d4-1cdf-564a-9c46-3e0984a22f48" :answer/type {:db/ident :answer.type/math} :answer/value "N" :db/id #edb/ref 17592186301910} {:answer/id #uuid "3b54f3dc-7378-520e-9fc8-2768204bc6fb" :answer/type {:db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186301911} {:answer/id #uuid "94945d98-88df-536d-bdaf-f985f1bc5dde" :answer/type {:db/ident :answer.type/math} :answer/value "{0}" :db/id #edb/ref 17592186301912} {:answer/id #uuid "5c2fc86e-6cd5-5aad-a112-c2dbefbf5404" :answer/type {:db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186301913}] :answer-field/correct {:answer/id #uuid "94945d98-88df-536d-bdaf-f985f1bc5dde" :answer/type {:db/ident :answer.type/math} :answer/value "{0}" :db/id #edb/ref 17592186301912} :answer-field/id #uuid "68083be8-080d-5546-bac1-0bf96223797f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301908}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "26a35533-94eb-50ff-92d0-54467eca9c05" :question/math-academy-id "q-184609" :question/problem "Let ${X}_{i}={0,i,2i},$ then ${⋂}_{i=1}^{\\infty }{X}_{i}=$" :question/worked-solution "The intersection of a family of indexed sets ${{A}_{i}}_{i\\in I}$ contains all elements that belong to *all* sets in our family:\n\n$$\n{⋂}_{i\\in I}{A}_{i}={x\\in U\\,:\\,x\\in {A}_{i}\\,\\,\\text{for all }{A}_{i},\\,\\,i\\in I}\n$$\n\nwhere $U$ is a universal set.\n\nThe notation ${⋂}_{i=1}^{\\infty }$ means that index set is \n$N={1,2,3…}.$ \n\nLet's now write down a few instances of our indexed sets:\n\n- if $i=1,$ we have ${X}_{1}={0,1,2}$\n\n- if $i=2,$ we have ${X}_{2}={0,2,4}$\n\n- if $i=3,$ we have ${X}_{3}={0,3,6}$\n\n- $⋯$\n\nand so on. \n\nNotice that the only element that lies in all the sets is $0.$ Therefore,\n\n$$\n\\begin{aligned}{⋂}_{i=1}^{\\infty }{X}_{i}={0}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186301914 :knowledge-point/_questions [{:knowledge-point/id #uuid "c1e93acb-6c0b-5263-9df9-9dcc00680845" :knowledge-point/title "Finding Unions and Intersections of (Countably) Infinite Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b9b7a714-4b46-5fb5-8e07-3ed3063a7ff0" :answer/type {:db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186301916} {:answer/id #uuid "63c54abd-6de4-58fa-abf6-580d26bff415" :answer/type {:db/ident :answer.type/math} :answer/value "{0}" :db/id #edb/ref 17592186301917} {:answer/id #uuid "49bafac6-a4e5-54cf-be64-74fcb5e26586" :answer/type {:db/ident :answer.type/math} :answer/value "(0,1]" :db/id #edb/ref 17592186301918} {:answer/id #uuid "92d5b274-f75b-534e-8792-de21f1347a3e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\frac{1}{3},1]" :db/id #edb/ref 17592186301919} {:answer/id #uuid "850690a6-7908-5bb5-a648-7aaa71e606d9" :answer/type {:db/ident :answer.type/math} :answer/value "[0,1]" :db/id #edb/ref 17592186301920}] :answer-field/correct {:answer/id #uuid "49bafac6-a4e5-54cf-be64-74fcb5e26586" :answer/type {:db/ident :answer.type/math} :answer/value "(0,1]" :db/id #edb/ref 17592186301918} :answer-field/id #uuid "87642fd7-4cc1-5195-b563-5cd389257aa0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301915}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "cd104de2-d81c-52d9-87d0-72a643320832" :question/math-academy-id "q-184610" :question/problem "Let ${S}_{i}=[0+\\frac{1}{i},1],$ then ${⋃}_{i=3}^{\\infty }{S}_{i}=$" :question/worked-solution "The union of a family of indexed sets is the set containing all elements belonging to *at least one* set in the indexed family:\n\n$$\n{⋃}_{i\\in I}{A}_{i}={x\\in U\\,:\\,x\\in {A}_{i}\\,\\,\\text{for at least one }{A}_{i},\\,\\,i\\in I}\n$$\n\nwhere $U$ is a universal set.\n\nThe notation ${⋃}_{i=3}^{\\infty }$ means that our set of indexes is \n${3,4,5…}.$ \n\nLet's now write down a few instances of our indexed sets:\n\n- if $i=3,$ we have ${S}_{3}=[\\frac{1}{3},1]$\n\n- if $i=4,$ we have ${S}_{4}=[\\frac{1}{4},1]$\n\n- if $i=5,$ we have ${S}_{5}=[\\frac{1}{5},1]$\n\n- $⋯$\n\nand so on. \n\nNotice that as $i$ increases, \n\n- the left endpoint of the intervals approaches $0$ but never reaches it, and\n\n- the right endpoint of the intervals equals $1$ for all the sets.\n\nTherefore,\n\n$$\n\\begin{aligned}{⋃}_{i=3}^{\\infty }{S}_{i}=(0,1].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186301921 :knowledge-point/_questions [{:knowledge-point/id #uuid "c1e93acb-6c0b-5263-9df9-9dcc00680845" :knowledge-point/title "Finding Unions and Intersections of (Countably) Infinite Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b65a6df7-9c3c-5e06-87aa-3c5ed8904190" :answer/type {:db/ident :answer.type/math} :answer/value "{∅}" :db/id #edb/ref 17592186301923} {:answer/id #uuid "399de6b9-0245-5eeb-9845-6c236ea2c348" :answer/type {:db/ident :answer.type/math} :answer/value "{0}" :db/id #edb/ref 17592186301924} {:answer/id #uuid "f87c9640-4ad3-5f41-9862-e7db08e74d26" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,0]" :db/id #edb/ref 17592186301925} {:answer/id #uuid "d357c9b9-784a-538c-9872-1ec971ef5399" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,0)" :db/id #edb/ref 17592186301926} {:answer/id #uuid "1e544743-c519-5a2c-b4de-8202dfff306a" :answer/type {:db/ident :answer.type/math} :answer/value "[0,\\infty )" :db/id #edb/ref 17592186301927}] :answer-field/correct {:answer/id #uuid "f87c9640-4ad3-5f41-9862-e7db08e74d26" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,0]" :db/id #edb/ref 17592186301925} :answer-field/id #uuid "31c18fd2-b026-516b-8e3d-a58d2f0f77f6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301922}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1a10ce36-2ff7-513a-836c-62ac2a987dc6" :question/math-academy-id "q-184654" :question/problem "Let ${Y}_{i}=[-i,0],$ then ${⋃}_{i=3}^{\\infty }{Y}_{i}=$" :question/worked-solution "The union of a family of indexed sets is the set containing all elements belonging to *at least one* set in the indexed family:\n\n$$\n{⋃}_{i\\in I}{A}_{i}={x\\in U\\,:\\,x\\in {A}_{i}\\,\\,\\text{for at least one }{A}_{i},\\,\\,i\\in I}\n$$\n\nwhere $U$ is a universal set.\n\nThe notation ${⋃}_{i=3}^{\\infty }$ means that our set of indexes is \n${3,4,5…}.$ \n\nLet's now write down a few instances of our indexed sets:\n\n- if $i=3,$ we have ${Y}_{3}=[-3,0]$\n\n- if $i=4,$ we have ${Y}_{4}=[-4,0]$\n\n- if $i=5,$ we have ${Y}_{5}=[-5,0]$\n\n- $⋯$\n\nand so on. \n\nNotice that as $i$ increases, \n\n- the sequence of left endpoints of the intervals approaches $-\\infty ,$ and\n\n- the right endpoint equals $0$ for all the sets.\n\nTherefore,\n\n$$\n\\begin{aligned}{⋃}_{i=3}^{\\infty }{Y}_{i}=(-\\infty ,0].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186301928 :knowledge-point/_questions [{:knowledge-point/id #uuid "c1e93acb-6c0b-5263-9df9-9dcc00680845" :knowledge-point/title "Finding Unions and Intersections of (Countably) Infinite Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5298c8bc-7851-59cf-8943-ae1daf2534df" :answer/type {:db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186301930} {:answer/id #uuid "63604c13-67fd-53ca-a4da-59b80177c90e" :answer/type {:db/ident :answer.type/math} :answer/value "[-2,0]" :db/id #edb/ref 17592186301931} {:answer/id #uuid "374ac312-2be3-5de1-b027-42015b3097b1" :answer/type {:db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186301932} {:answer/id #uuid "3fca15ad-33cd-5896-afd9-aa60707cd647" :answer/type {:db/ident :answer.type/math} :answer/value "(1,2]" :db/id #edb/ref 17592186301933} {:answer/id #uuid "196bab72-8843-5909-a2d2-53250168ed6a" :answer/type {:db/ident :answer.type/math} :answer/value "[-2,1)" :db/id #edb/ref 17592186301934}] :answer-field/correct {:answer/id #uuid "3fca15ad-33cd-5896-afd9-aa60707cd647" :answer/type {:db/ident :answer.type/math} :answer/value "(1,2]" :db/id #edb/ref 17592186301933} :answer-field/id #uuid "f4f200f3-d5cd-5483-b5c3-807020550944" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301929}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b9f1ae01-18c1-5847-8362-efc080d66155" :question/math-academy-id "q-184656" :question/problem "Let ${S}_{i}=[1+\\frac{1}{i},2],$ then ${⋃}_{i=5}^{\\infty }{S}_{i}=$" :question/worked-solution "The union of a family of indexed sets is the set containing all elements belonging to *at least one* set in the indexed family:\n\n$$\n{⋃}_{i\\in I}{A}_{i}={x\\in U\\,:\\,x\\in {A}_{i}\\,\\,\\text{for at least one }{A}_{i},\\,\\,i\\in I}\n$$\n\nwhere $U$ is a universal set.\n\nThe notation ${⋃}_{i=5}^{\\infty }$ means that our set of indexes is \n${5,6,7…}.$ \n\nLet's now write down a few instances of our indexed sets:\n\n- if $i=5,$ we have ${S}_{5}=[1+\\frac{1}{5},2]=[\\frac{6}{5},2]$\n\n- if $i=6,$ we have ${S}_{6}=[1+\\frac{1}{6},2]=[\\frac{7}{6},2]$\n\n- if $i=7,$ we have ${S}_{7}=[1+\\frac{1}{7},2]=[\\frac{8}{7},2]$\n\n- $⋯$\n\nand so on. \n\nNotice that as $i$ increases, \n\n- the left endpoint of the intervals approaches $1$ but never reaches it, and\n\n- the right endpoint of the intervals equals $2$ for all the sets.\n\nTherefore,\n\n$$\n\\begin{aligned}{⋃}_{i=5}^{\\infty }{S}_{i}=(1,2].\\end{aligned}\n$$"}]}
