[{:db/id "q-320394/field-1/4e0d8402ce61a9969d16a551582a4c98e6792e5edb3c1272d991dba7d5c92279" :answer/id #uuid "5f12c2d1-1d19-544e-b268-8a66bf089fbd" :answer/type :answer.type/math :answer/value "-14" :db/ensure [:answer/validate]} {:db/id 17592186275580 :answer-field/choices ["q-320394/field-1/4e0d8402ce61a9969d16a551582a4c98e6792e5edb3c1272d991dba7d5c92279"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-320394"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14067751/assets/f63cf622acc15681e3815118bbd2a187ea6039a548d4be1773634c0dc450c343.png)\n\nDetermine the area $A$ of the parallelogram in the figure.\n\n$\\,\\,A=$ {{field-1}}" :db/ensure [:question/validate]} {:db/id "q-320412/field-1/abe476e447976564bc5c670fe73789666287b967d49bbed12b1d85144449e63e" :answer/id #uuid "02d2d5fb-294b-5392-a209-504583d6181e" :answer/type :answer.type/math :answer/value "23" :db/ensure [:answer/validate]} {:db/id "q-320412/field-1" :answer-field/id #uuid "03ba4332-1564-569d-a64b-3bdaab195601" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320412/field-1/abe476e447976564bc5c670fe73789666287b967d49bbed12b1d85144449e63e" :answer-field/choices ["q-320412/field-1/abe476e447976564bc5c670fe73789666287b967d49bbed12b1d85144449e63e"] :db/ensure [:answer-field/validate]} {:db/id "q-320412" :question/id #uuid "8c1b998f-4ad3-5fe1-accd-c83c39bcb757" :question/math-academy-id "q-320412" :question/problem "Determine the area $A$ of the parallelogram spanned by $\\text{u}=⟨2,7⟩$ and $\\text{v}=⟨-3,1⟩.$\n\n$\\,\\,A=$ {{field-1}}" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}2 & -3 \\\\ 7 & 1\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}2 & -3 \\\\ 7 & 1\\end{aligned}| \\\\  & =2\\cdot 1-(-3)\\cdot 7 \\\\  & =2-(-21) \\\\  & =23\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|\\,23\\,|=23\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-320412/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "288e49b0-f706-54de-86b7-a17248fe2408"] :knowledge-point/questions ["q-320412"] :db/ensure [:knowledge-point/validate]}]
