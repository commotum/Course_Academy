uestion-capture/13949104/assets/1aa848f287660c0858d5d6478da71c5baab9252c13f0a2d4a48c38d61f6bce51.png)"}] [{:db/id #edb/ref 17592186263707 :knowledge-point/_questions [{:knowledge-point/id #uuid "bbf50e27-a8c3-52e7-be21-5d7ed61e5512" :knowledge-point/title "Filling a Table of Values for a Parametric Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d1a526b0-6ceb-553c-ae95-84b0ce05871c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186263709}] :answer-field/correct {:answer/id #uuid "d1a526b0-6ceb-553c-ae95-84b0ce05871c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186263709} :answer-field/id #uuid "eb0064fb-c987-5cb6-88d1-98c208ae2570" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186263708} {:answer-field/choices [{:answer/id #uuid "6720d6ed-a4b4-559b-acce-c6d66e5cf707" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{2}" :db/id #edb/ref 17592186263711}] :answer-field/correct {:answer/id #uuid "6720d6ed-a4b4-559b-acce-c6d66e5cf707" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{2}" :db/id #edb/ref 17592186263711} :answer-field/id #uuid "83cf9500-d3a8-5900-a83e-e42277cd333a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186263710} {:answer-field/choices [{:answer/id #uuid "0b138873-6644-5893-8633-49c3e42ea4cb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{4}" :db/id #edb/ref 17592186263713}] :answer-field/correct {:answer/id #uuid "0b138873-6644-5893-8633-49c3e42ea4cb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{4}" :db/id #edb/ref 17592186263713} :answer-field/id #uuid "a8af02ca-12c5-5bcf-bb12-b6ea86475d9a" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186263712}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "04af7c3e-29ba-55d1-9de5-2657b1fa8459" :question/math-academy-id "q-326242" :question/problem "Consider the curve with parametric equations\n\n$$\nx=\\frac{3}{2}t+1,\\,y=-\\frac{5}{4}t+2,\\,-1\\le t\\le 4.\n$$\n\nFill in the blanks in the following table of values:\n\n| **$t$** | $-1$ | $0$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | {{field-1}} | $1$ | $\\frac{5}{2}$ | $4$ | {{field-2}} | $7$ |\n| $y$ | {{field-3}} | $2$ | $\\frac{3}{4}$ | $-\\frac{1}{2}$ | $-\\frac{7}{4}$ | $-3$ |" :question/worked-solution "- To find the value of $x(-1),$ we substitute $t=-1$ into $x=\\frac{3}{2}t+1.$ This gives\n\n$$\nx(-1)=\\frac{3}{2}(-1)+1=-\\frac{3}{2}+\\frac{2}{2}=-\\frac{1}{2}.\n$$\n\n- To find the value of $y(-1),$ we substitute $t=-1$ into $y=-\\frac{5}{4}t+2.$ This gives\n\n$$\ny(-1)=-\\frac{5}{4}(-1)+2=\\frac{5}{4}+\\frac{8}{4}=\\frac{13}{4}.\n$$\n\n- To find the value of $x(3),$ we substitute $t=3$ into $x=\\frac{3}{2}t+1.$ This gives\n\n$$\nx(2)=\\frac{3}{2}(3)+1=\\frac{9}{2}+\\frac{2}{2}=\\frac{11}{2}.\n$$\n\nThen the table is \n\n \n\n| **$t$** | $-1$ | $0$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $-\\frac{1}{2}$ | $1$ | $\\frac{5}{2}$ | $4$ | $\\frac{11}{2}$ | $7$ |\n| $y$ | $\\frac{13}{4}$ | $2$ | $\\frac{3}{4}$ | $-\\frac{1}{2}$ | $-\\frac{7}{4}$ | $-3$ |"}] [{:db/id #edb/ref 17592186263714 :knowledge-point/_questions [{:knowledge-point/id #uuid "bbf50e27-a8c3-52e7-be21-5d7ed61e5512" :knowledge-point/title "Filling a Table of Values for a Parametric Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2c4babc-f016-555f-95f6-24e4320c9d0a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186263716} {:answer/id #uuid "6a948c48-01de-58fa-9dfb-933a17d01e40" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186263717}] :answer-field/correct {:answer/id #uuid "d2c4babc-f016-555f-95f6-24e4320c9d0a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186263716} :answer-field/id #uuid "46013532-a405-5c62-85be-c220efe3cf22" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186263715} {:answer-field/choices [{:answer/id #uuid "638a3879-8b9e-5686-bedb-77f7c8732fa5" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186263719}] :answer-field/correct {:answer/id #uuid "638a3879-8b9e-5686-bedb-77f7c8732fa5" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186263719} :answer-field/id #uuid "9d2a0c3c-2012-5456-aa8a-b3f41c4c8eec" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186263718} {:answer-field/choices [{:answer/id #uuid "cae88c29-ef32-5409-8407-90990777ecb3" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186263721}] :answer-field/correct {:answer/id #uuid "cae88c29-ef32-5409-8407-90990777ecb3" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186263721} :answer-field/id #uuid "99ba54f9-b6f6-56e6-b8f8-f4a7db344f85" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186263720}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "4cc20620-c2d3-5cb5-adf6-4d97890f6861" :question/math-academy-id "q-326256" :question/problem "Consider the curve with parametric equations\n\n$$\nx=cos\\,(\\frac{\\pi t}{2}),\\,y=tan\\,(\\frac{\\pi t}{3}),\\,-1\\le t\\le 4.\n$$\n\nFill in the blanks in the following table of values:\n\n| **$t$** | $-1$ | $0$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $0$ | {{field-1}} | $0$ | {{field-2}} | $0$ | $1$ |\n| $y$ | $-\\sqrt{3}$ | $0$ | {{field-3}} | $-\\sqrt{3}$ | $0$ | $\\sqrt{3}$ |" :question/worked-solution "- To find the value of $x(0),$ we substitute $t=0$ into $x=cos\\,(\\frac{\\pi t}{2}).$ This gives\n\n$$\nx(0)=cos\\,(\\frac{\\pi (0)}{2})=\\operatorname{cos}⁡(0)=1.\n$$\n\n- To find the value of $y(1),$ we substitute $t=1$ into $y=tan\\,(\\frac{\\pi t}{3}).$ This gives\n\n$$\ny(1)=tan\\,(\\frac{\\pi (1)}{3})=tan\\,(\\frac{\\pi }{3})=\\sqrt{3}.\n$$\n\n- To find the value of $x(2),$ we substitute $t=2$ into $x=cos\\,(\\frac{\\pi t}{2}).$ This gives\n\n$$\nx(2)=cos\\,(\\frac{\\pi (2)}{2})=\\operatorname{cos}⁡(\\pi )=-1.\n$$\n\nThen the table is \n\n \n\n| **$t$** | $-1$ | $0$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $0$ | $1$ | $0$ | $-1$ | $0$ | $1$ |\n| $y$ | $-\\sqrt{3}$ | $0$ | $\\sqrt{3}$ | $-\\sqrt{3}$ | $0$ | $\\sqrt{3}$ |"}] [{:db/id #edb/ref 17592186263732 :knowledge-point/_questions [{:knowledge-point/id #uuid "3cbf0ad0-a7c5-5c0f-a06c-9210fdc244ef" :knowledge-point/title "Determining the Range of a Parametric Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a214fa4-411a-5089-a292-840a2c7f57f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\leq" :db/id #edb/ref 17592186263734} {:answer/id #uuid "8c61ef48-0185-5262-be2b-e8b45d2a040e" :answer/type {:db/ident :answer.type/math} :answer/value "\\geq" :db/id #edb/ref 17592186263735}] :answer-field/correct {:answer/id #uuid "8c61ef48-0185-5262-be2b-e8b45d2a040e" :answer/type {:db/ident :answer.type/math} :answer/value "\\geq" :db/id #edb/ref 17592186263735} :answer-field/id #uuid "4c6091f5-8534-5e13-a093-7b7411a34aeb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186263733} {:answer-field/choices [{:answer/id #uuid "94d75044-3115-5ee2-8809-6540fb4c85b3" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186263737}] :answer-field/correct {:answer/id #uuid "94d75044-3115-5ee2-8809-6540fb4c85b3" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186263737} :answer-field/id #uuid "716d47e9-2344-5b5b-aea5-e64d8fd0ae5f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186263736} {:answer-field/choices [{:answer/id #uuid "c2a05504-6038-5410-881d-24cdfafdca72" :answer/type {:db/ident :answer.type/math} :answer/value "\\geq" :db/id #edb/ref 17592186263739}] :answer-field/correct {:answer/id #uuid "c2a05504-6038-5410-881d-24cdfafdca72" :answer/type {:db/ident :answer.type/math} :answer/value "\\geq" :db/id #edb/ref 17592186263739} :answer-field/id #uuid "02956170-4454-51ee-83f3-5eca5b96acf8" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186263738} {:answer-field/choices [{:answer/id #uuid "70c57606-7131-5407-9091-2c1a01aa3807" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186263741}] :answer-field/correct {:answer/id #uuid "70c57606-7131-5407-9091-2c1a01aa3807" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186263741} :answer-field/id #uuid "b985bfe9-a2d2-5c05-a3c7-8ec8a354bd9c" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186263740}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "30b04f17-aee8-5e9e-9e8e-8855a22f81b8" :question/math-academy-id "q-326305" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=2{t}^{2}-4t,\\,y=(t-1)^{2}+2,\\,t\\in (-\\infty ,\\infty ),\n$$\n\ndetermine the ranges of $x$ and $y.$\n\n$x$\n{{field-1}}{{field-2}}$,\\,y$\n{{field-3}}{{field-4}}" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ we can start by completing the square, as follows:\n\n$$\n\\begin{aligned}x & =2{t}^{2}-4t \\\\  & =2({t}^{2}-2t) \\\\  & =2({t}^{2}-2t+1)-2 \\\\  & =2(t-1)^{2}-2\\end{aligned}\n$$\n\nSince $2(t-1)^{2}-2\\ge -2,$ we conclude that the range of $x$ is\n\n$$\nx\\ge -2.\n$$\n\n- To find the range of $y,$ notice that $(t-1)^{2}+2\\ge 2.$ Consequently, the range of $y$ is\n\n$$\ny\\ge 2.\n$$"}] [{:db/id #edb/ref 17592186275691 :knowledge-point/_questions [{:knowledge-point/id #uuid "cddc940d-2185-569c-a62b-b507e95d3c35" :knowledge-point/title "Determining the Range of a Parametric Equation Defined in Terms of Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1439d71d-e477-5ab7-a9df-19d21bf0a7ae" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186275693}] :answer-field/correct {:answer/id #uuid "1439d71d-e477-5ab7-a9df-19d21bf0a7ae" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186275693} :answer-field/id #uuid "1153ffde-e611-58da-9d82-1d65ede3e9aa" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275692} {:answer-field/choices [{:answer/id #uuid "1dff59b0-ae65-5ff1-be74-2aa4d4f2850e" :answer/type {:db/ident :answer.type/math} :answer/value "\\le" :db/id #edb/ref 17592186275695}] :answer-field/correct {:answer/id #uuid "1dff59b0-ae65-5ff1-be74-2aa4d4f2850e" :answer/type {:db/ident :answer.type/math} :answer/value "\\le" :db/id #edb/ref 17592186275695} :answer-field/id #uuid "b95821a5-d7c8-521c-84b6-4cb82d0310c4" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275694} {:answer-field/choices [{:answer/id #uuid "3ecf2b05-b421-5469-801e-96074a279592" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186275697}] :answer-field/correct {:answer/id #uuid "3ecf2b05-b421-5469-801e-96074a279592" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186275697} :answer-field/id #uuid "e7c318f0-493c-596a-b