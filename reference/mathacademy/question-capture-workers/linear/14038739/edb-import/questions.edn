ts/ef5f33b74b59b5a62fd8670a8feb6487b01a97aed4a44a098a576d10d891bd68.png)"}] [{:db/id #edb/ref 17592186258555 :knowledge-point/_questions [{:knowledge-point/id #uuid "3cbf0ad0-a7c5-5c0f-a06c-9210fdc244ef" :knowledge-point/title "Determining the Range of a Parametric Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11128e59-218c-564c-899f-33d1f4d59de3" :answer/type {:db/ident :answer.type/text} :answer/value "$x\\ge-\\frac14$ and $y\\le-2$" :db/id #edb/ref 17592186271158} {:answer/id #uuid "ffb5f3b5-57fe-5b71-965f-7f1372d6b1f8" :answer/type {:db/ident :answer.type/text} :answer/value "$x\\le-\\frac14$ and $y\\ge-2$" :db/id #edb/ref 17592186271159} {:answer/id #uuid "68efaf3c-951d-5bf1-b314-a48ce708f80d" :answer/type {:db/ident :answer.type/text} :answer/value "$x\\ge-\\frac14$ and $y\\ge2$" :db/id #edb/ref 17592186271160} {:answer/id #uuid "cb06738f-cefd-5df9-a3f8-c1aecac469f2" :answer/type {:db/ident :answer.type/text} :answer/value "$x\\ge\\frac14$ and $y\\ge-2$" :db/id #edb/ref 17592186271161} {:answer/id #uuid "78856cb5-8ef8-556d-b19f-eab43588da3c" :answer/type {:db/ident :answer.type/text} :answer/value "$x\\ge-\\frac14$ and $y\\ge-2$" :db/id #edb/ref 17592186271162}] :answer-field/correct {:answer/id #uuid "78856cb5-8ef8-556d-b19f-eab43588da3c" :answer/type {:db/ident :answer.type/text} :answer/value "$x\\ge-\\frac14$ and $y\\ge-2$" :db/id #edb/ref 17592186271162} :answer-field/id #uuid "df9393bf-8b86-527d-966c-3fb1ffe4016c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274508}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a4387361-c86a-55f1-abee-652931e3d6d3" :question/math-academy-id "q-16149" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx={t}^{2}+t,\\,\\,\\,y={t}^{2}-2,\\,t\\in (-\\infty ,\\infty ),\n$$\n\ndetermine the ranges of $x$ and $y.$" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ we can start by completing the square, as follows:\n\n$$\n\\begin{aligned}x & ={t}^{2}+t \\\\  & ={(t+\\frac{1}{2})}^{2}-{(\\frac{1}{2})}^{2} \\\\  & ={(t+\\frac{1}{2})}^{2}-\\frac{1}{4}\\end{aligned}\n$$\n\nSince ${(t+\\frac{1}{2})}^{2}\\ge 0,$ we can conclude that $x\\ge -\\frac{1}{4}.$\n\n- To find the range of $y,$ notice that ${t}^{2}\\ge 0.$ Therefore, we can conclude that $y\\ge -2.$\n\nSo, the ranges are $x\\ge -\\frac{1}{4}$ and $y\\ge -2.$"}] [{:db/id #edb/ref 17592186087968 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0dc11d5-8eda-52b1-b7b1-42b481813ff4" :knowledge-point/title "Graphing a Curve Defined Parametrically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f29a511c-7868-5cb1-81f4-9d3980ad8f1b" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/803/Source/Images/q-16190-a-2.png" :db/id #edb/ref 17592186084820} {:answer/id #uuid "f3b68a80-cbc5-5be5-96a2-36e49ca90c2c" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/803/Source/Images/q-16190-a-4.png" :db/id #edb/ref 17592186084821} {:answer/id #uuid "2379493d-13ba-52ba-ad91-b4225afbf29b" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/803/Source/Images/q-16190-a-3.png" :db/id #edb/ref 17592186084822} {:answer/id #uuid "3a30a836-7cc2-59a5-864a-eadb28c0be44" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/803/Source/Images/q-16190-a-5.png" :db/id #edb/ref 17592186084823} {:answer/id #uuid "58d40a67-a2b3-5515-bb12-bf78f2155c14" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/803/Source/Images/q-16190-a-1.png" :db/id #edb/ref 17592186084824}] :answer-field/correct {:answer/id #uuid "58d40a67-a2b3-5515-bb12-bf78f2155c14" :answer/type {:db/ident :answer.type/image} :answ