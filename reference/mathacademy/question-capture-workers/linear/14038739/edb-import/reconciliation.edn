256" "04ee7a68d2030797b5734e4b1aed9f05e0ee75f180ee5fd6ab516739b5a92b6b"} {"question" "q-123789" "field" nil "attribute" "question/worked-solution" "value" "We need to create a table of values and then sketch the curve. First, we work out the $x$-values using the formula $x=2\\sqrt{t}.$ This gives\n\n| **$t$** | $0$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- | --- |\n| $x$ | $0$ | $2$ | $2.83$ | $3.46$ | $4$ |\n| $y$ | $$ | $$ | $$ | $$ | $$ |\n\n$$\n\n$$\n\nNow, we work out the $y$ values using $y=t.$ This gives\n\n| **$t$** | $0$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- | --- |\n| $x$ | $0$ | $2$ | $2.83$ | $3.46$ | $4$ |\n| $y$ | $0$ | $1$ | $2$ | $3$ | $4$ |\n\n$$\n\n$$\n\nPlotting these points, we obtain the following curve:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/assets/898075d0f74bdfcbab28e50ee327770400f6f58d82728cd8bf55cc75e852d161.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/state.json" "file_sha256" "04ee7a68d2030797b5734e4b1aed9f05e0ee75f180ee5fd6ab516739b5a92b6b"} {"question" "q-123789" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/activity-metadata.json" "file_sha256" "9042a3bb57b43217cf1bb0cf5cc16f1106958207637db566b7d3aa09aea4bef8"} {"question" "q-123789" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/state.json" "file_sha256" "04ee7a68d2030797b5734e4b1aed9f05e0ee75f180ee5fd6ab516739b5a92b6b"} {"question" "q-123789" "field" "selection" "attribute" "answer-field/choices" "value" [["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/assets/1f4b9a578aeac87cba0fa2278be29853866cf1a1e111ca1aa90e0f0f75eb68ba.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/assets/680af5d00bb645a44b134905834a4fcb8e12bd124596c2c084e707477a663997.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/assets/967c68b4beee66c2cb59cc9fa16436b1f5ed9e0c4a8193afee0b60af9687ab54.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/assets/a739c54dfbbebbf1cdadcfc6edbe357aee1902263236fd626685d4f9a7e0e27b.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/assets/cca5b74de9fbc46ef45214601a53a7d3b1d84b3536365a62560b8ec1b825643a.png"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/state.json" "file_sha256" "04ee7a68d2030797b5734e4b1aed9f05e0ee75f180ee5fd6ab516739b5a92b6b"} {"question" "q-123789" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/image "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/assets/967c68b4beee66c2cb59cc9fa16436b1f5ed9e0c4a8193afee0b60af9687ab54.png"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/state.json" "file_sha256" "04ee7a68d2030797b5734e4b1aed9f05e0ee75f180ee5fd6ab516739b5a92b6b"} {"question" "q-16149" "field" nil "attribute" "question/problem" "value" "Given that a curve is defined parametrically as\n\n$$\nx={t}^{2}+t,\\,\\,\\,y={t}^{2}-2,\\,t\\in (-\\infty ,\\infty ),\n$$\n\ndetermine the ranges of $x$ and $y.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/state.json" "file_sha256" "04ee7a68d2030797b5734e4b1aed9f05e0ee75f180ee5fd6ab516739b5a92b6b"} {"question" "q-16149" "field" nil "attribute" "question/worked-solution" "value" "Let's consider each variable in turn.\n\n- To find the range of $x,$ we can start by completing the square, as follows:\n\n$$\n\\begin{aligned}x & ={t}^{2}+t \\\\  & ={(t+\\frac{1}{2})}^{2}-{(\\frac{1}{2})}^{2} \\\\  & ={(t+\\frac{1}{2})}^{2}-\\frac{1}{4}\\end{aligned}\n$$\n\nSince ${(t+\\frac{1}{2})}^{2}\\ge 0,$ we can conclude that $x\\ge -\\frac{1}{4}.$\n\n- To find the range of $y,$ notice that ${t}^{2}\\ge 0.$ Therefore, we can conclude that $y\\ge -2.$\n\nSo, the ranges are $x\\ge -\\frac{1}{4}$ and $y\\ge -2.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/state.json" "file_sha256" "04ee7a68d2030797b5734e4b1aed9f05e0ee75f180ee5fd6ab516739b5a92b6b"} {"question" "q-16149" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/activity-metadata.json" "file_sha256" "9042a3bb57b43217cf1bb0cf5cc16f1106958207637db566b7d3aa09aea4bef8"} {"question" "q-16149" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/state.json" "file_sha256" "04ee7a68d2030797b5734e4b1aed9f05e0ee75f180ee5fd6ab516739b5a92b6b"} {"question" "q-16149" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "x\\ge -4,\\,y\\ge 0"] ["math" "x\\ge -\\frac{1}{4},\\,y\\ge -2"] ["math" "x\\ge \\frac{1}{4},\\,y\\le -2"] ["math" "x\\le -\\frac{1}{2},\\,y\\ge 1"] ["math" "x\\le \\frac{1}{2},\\,y\\le -4"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/state.json" "file_sha256" "04ee7a68d2030797b5734e4b1aed9f05e0ee75f180ee5fd6ab516739b5a92b6b"} {"question" "q-16149" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "x\\ge -\\frac{1}{4},\\,y\\ge -2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/state.json" "file_sha256" "04ee7a68d2030797b5734e4b1aed9f05e0ee75f180ee5fd6ab516739b5a92b6b"} {"question" "q-73617" "field" nil "attribute" "question/problem" "value" "Given that a curve is defined parametrically as\n\n$$\nx=1-t,\\,\\,\\,y={t}^{2}-4,\\,t\\ge -1,\n$$\n\ndetermine the ranges of $x$ and $y.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/state.json" "file_sha256" "04ee7a68d2030797b5734e4b1aed9f05e0ee75f180ee5fd6ab516739b5a92b6b"} {"question" "q-73617" "field" nil "attribute" "question/worked-solution" "value" "Let's consider each variable in turn.\n\n- To find the range of $x,$ note that $1-t\\le 2$ for all $t\\ge -1.$ Consequently, $x=1-t\\le 2.$\n\n- To find the range of $y,$ note that ${t}^{2}\\ge 0$ for all $t.$ Consequently, $y={t}^{2}-4\\ge -4.$\n\nTherefore, the ranges are $x\\le 2$ and $y\\ge -4.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/state.json" "file_sha256" "04ee7a68d2030797b5734e4b1aed9f05e0ee75f180ee5fd6ab516739b5a92b6b"} {"question" "q-73617" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/activity-metadata.json" "file_sha256" "9042a3bb57b43217cf1bb0cf5cc16f1106958207637db566b7d3aa09aea4bef8"} {"question" "q-73617" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/state.json" "file_sha256" "04ee7a68d2030797b5734e4b1aed9f05e0ee75f180ee5fd6ab516739b5a92b6b"} {"question" "q-73617" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "x\\ge -1,\\,y\\ge 0"] ["math" "x\\ge 0,\\,y\\le -4"] ["math" "x\\ge 1,\\,y\\le -4"] ["math" "x\\le 2,\\,y\\ge -4"] ["math" "x\\le 4,\\,y\\ge 1"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/state.json" "file_sha256" "04ee7a68d2030797b5734e4b1aed9f05e0ee75f180ee5fd6ab516739b5a92b6b"} {"question" "q-73617" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "x\\le 2,\\,y\\ge -4"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/state.json" "file_sha256" "04ee7a68d2030797b5734e4b1aed9f05e0ee75f180ee5fd6ab516739b5a92b6b"} {"question" "q-326305" "field" nil "attribute" "question/problem" "value" "Given that a curve is defined parametrically as\n\n$$\nx=2{t}^{2}-4t,\\,y=(t-1)^{2}+2,\\,t\\in (-\\infty ,\\infty ),\n$$\n\ndetermine the ranges of $x$ and $y.$\n\n$x$\n{{field-1}}{{field-2}}$,\\,y$\n{{field-3}}{{field-4}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/state.json" "file_sha256" "04ee7a68d2030797b5734e4b1aed9f05e0ee75f180ee5fd6ab516739b5a92b6b"} {"question" "q-326305" "field" nil "attribute" "question/worked-solution" "value" "Let's consider each variable in turn.\n\n- To find the range of $x,$ we can start by completing the square, as follows:\n\n$$\n\\begin{aligned}x & =2{t}^{2}-4t \\\\  & =2({t}^{2}-2t) \\\\  & =2({t}^{2}-2t+1)-2 \\\\  & =2(t-1)^{2}-2\\end{aligned}\n$$\n\nSince $2(t-1)^{2}-2\\ge -2,$ we conclude that the range of $x$ is\n\n$$\nx\\ge -2.\n$$\n\n- To find the range of $y,$ notice that $(t-1)^{2}+2\\ge 2.$ Consequently, the range of $y$ is\n\n$$\ny\\ge 2.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/state.json" "file_sha256" "04ee7a68d2030797b5734e4b1aed9f05e0ee75f180ee5fd6ab516739b5a92b6b"} {"question" "q-326305" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/activity-metadata.json" "file_sha256" "9042a3bb57b43217cf1bb0cf5cc16f1106958207637db566b7d3aa09aea4bef8"} {"question" "q-326305" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/state.json" "file_sha256" "04ee7a68d2030797b5734e4b1aed9f05e0ee75f180ee5fd6ab516739b5a92b6b"} {"question" "q-326305" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\ge"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/state.json" "file_sha256" "04ee7a68d2030797b5734e4b1aed9f05e0ee75f180ee5fd6ab516739b5a92b6b"} {"question" "q-326305" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/state.json" "file_sha256" "04ee7a68d2030797b5734e4b1aed9f05e0ee75f180ee5fd6ab516739b5a92b6b"} {"question" "q-326305" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "-2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/state.json" "file_sha256" "04ee7a68d2030797b5734e4b1aed9f05e0ee75