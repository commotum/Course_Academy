reference/mathacademy/question-capture/13948638/assets/bcb2b08bab14ce74347d37a0e896451750db0203ab830b835a83de6b7a81b61d.png"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/state.json" "file_sha256" "d861e251665aa8f66e9fc750b615829a7af27a63204e9fbbe3201691e0a8edd4" "basis" 577 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/edb-import/verification.json"} {"question" "q-123783" "field" "selection" "attribute" "answer/value" "value" [:answer.type/image "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/assets/c477137fe47dc3f0475f44658117545da3dae94f18e3bf2ce897d2a89fad2a37.png"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/state.json" "file_sha256" "d861e251665aa8f66e9fc750b615829a7af27a63204e9fbbe3201691e0a8edd4" "basis" 577 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/edb-import/verification.json"} {"question" "q-123783" "field" "selection" "attribute" "answer/value" "value" [:answer.type/image "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/assets/d1cec5ea2da4a0b5f141bb24b4addc797defbc48e76cdfdbfab3a303e348b8cc.png"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/state.json" "file_sha256" "d861e251665aa8f66e9fc750b615829a7af27a63204e9fbbe3201691e0a8edd4" "basis" 577 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/edb-import/verification.json"} {"question" "q-326305" "field" nil "attribute" "question/problem" "value" "Given that a curve is defined parametrically as\n\n$$\nx=2{t}^{2}-4t,\\,y=(t-1)^{2}+2,\\,t\\in (-\\infty ,\\infty ),\n$$\n\ndetermine the ranges of $x$ and $y.$\n\n$x$\n{{field-1}}{{field-2}}$,\\,y$\n{{field-3}}{{field-4}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/state.json" "file_sha256" "d861e251665aa8f66e9fc750b615829a7af27a63204e9fbbe3201691e0a8edd4" "basis" 577 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/edb-import/verification.json"} {"question" "q-326305" "field" nil "attribute" "question/worked-solution" "value" "Let's consider each variable in turn.\n\n- To find the range of $x,$ we can start by completing the square, as follows:\n\n$$\n\\begin{aligned}x & =2{t}^{2}-4t \\\\  & =2({t}^{2}-2t) \\\\  & =2({t}^{2}-2t+1)-2 \\\\  & =2(t-1)^{2}-2\\end{aligned}\n$$\n\nSince $2(t-1)^{2}-2\\ge -2,$ we conclude that the range of $x$ is\n\n$$\nx\\ge -2.\n$$\n\n- To find the range of $y,$ notice that $(t-1)^{2}+2\\ge 2.$ Consequently, the range of $y$ is\n\n$$\ny\\ge 2.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/state.json" "file_sha256" "d861e251665aa8f66e9fc750b615829a7af27a63204e9fbbe3201691e0a8edd4" "basis" 577 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/edb-import/verification.json"} {"question" "q-326305" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/activity-metadata.json" "file_sha256" "e1117fbad5be03ecebc64ce9149e81bbdb780c8c224296509439d3786f64bfb3" "basis" 577 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/edb-import/verification.json"} {"question" "q-326305" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/state.json" "file_sha256" "d861e251665aa8f66e9fc750b615829a