56" "04ee7a68d2030797b5734e4b1aed9f05e0ee75f180ee5fd6ab516739b5a92b6b"} {"question" "q-123768" "field" nil "attribute" "question/worked-solution" "value" "To find the range of $y,$ note that $4\\sqrt{t}\\ge 0$ for all $t\\ge 0.$ Consequently, $y=4\\sqrt{t}-1\\ge -1.$\n\nTherefore, we can conclude that $y\\ge -1.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/state.json" "file_sha256" "04ee7a68d2030797b5734e4b1aed9f05e0ee75f180ee5fd6ab516739b5a92b6b"} {"question" "q-123768" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/activity-metadata.json" "file_sha256" "9042a3bb57b43217cf1bb0cf5cc16f1106958207637db566b7d3aa09aea4bef8"} {"question" "q-123768" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/state.json" "file_sha256" "04ee7a68d2030797b5734e4b1aed9f05e0ee75f180ee5fd6ab516739b5a92b6b"} {"question" "q-123768" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "y\\ge -1"] ["math" "y\\ge 1"] ["math" "y\\ge 4"] ["math" "y\\le -1"] ["math" "y\\le 4"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/state.json" "file_sha256" "04ee7a68d2030797b5734e4b1aed9f05e0ee75f180ee5fd6ab516739b5a92b6b"} {"question" "q-123768" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "y\\ge -1"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/state.json" "file_sha256" "04ee7a68d2030797b5734e4b1aed9f05e0ee75f180ee5fd6ab516739b5a92b6b"} {"question" "q-327861" "field" nil "attribute" "question/problem" "value" "Given that a curve is defined parametrically as\n\n$$\nx=6\\operatorname{cos}⁡\\theta ,\\,y=-3\\operatorname{sin}⁡\\theta ,\\,0\\le \\theta <2\\pi ,\n$$\n\nwhat are the ranges of $x$ and $y?$\n\nThe range of $x$ is \n{{field-1}} $\\le $\n$x$\n{{field-2}}{{field-3}}.\n\n \n\nThe range of $y$ is \n{{field-4}}\n$\\le y$\n{{field-5}}{{field-6}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/state.json" "file_sha256" "04ee7a68d2030797b5734e4b1aed9f05e0ee75f180ee5fd6ab516739b5a92b6b"} {"question" "q-327861" "field" nil "attribute" "question/worked-solution" "value" "Let's consider each variable in turn.\n\n- To find the range of $x,$ notice that for $0\\le \\theta <2\\pi ,$ we have \n$-1\\le \\operatorname{cos}⁡\\theta \\le 1.$ Consequently,\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{cos}⁡\\theta \\le 1 \\\\ -6 & \\le 6\\operatorname{cos}⁡\\theta \\le 6 \\\\ -6 & \\le x\\le 6.\\end{aligned}\n$$\n\nSo, we can conclude that $-6\\le x\\le 6.$\n\n- To find the range of $y,$ notice that for $0\\le \\theta <2\\pi ,$ we have \n$-1\\le \\operatorname{sin}⁡\\theta \\le 1.$ Consequently,\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{sin}⁡\\theta \\le 1 \\\\ 3 & \\text{ }\\ge -3\\operatorname{sin}⁡\\theta \\text{ }\\ge -3 \\\\ -3 & \\le -3\\operatorname{sin}⁡\\theta \\le 3 \\\\ -3 & \\le y\\le 3.\\end{aligned}\n$$\n\nSo, we can conclude that $-3\\le y\\le 3.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/state.json" "file_sha256" "04ee7a68d2030797b5734e4b1aed9f05e0ee75f180ee5fd6ab516739b5a92b6b"} {"question" "q-327861" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/activity-metadata.js