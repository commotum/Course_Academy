veloper/Course_Academy/reference/mathacademy/question-capture/13948638/edb-import/verification.json"} {"question" "q-123767" "field" nil "attribute" "question/worked-solution" "value" "To find the range of $y,$ note that $y=1-t<1$ for all $t>0.$ \n\nConsequently, the range of $y$ is $y<1.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/state.json" "file_sha256" "d861e251665aa8f66e9fc750b615829a7af27a63204e9fbbe3201691e0a8edd4" "basis" 577 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/edb-import/verification.json"} {"question" "q-123767" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/activity-metadata.json" "file_sha256" "e1117fbad5be03ecebc64ce9149e81bbdb780c8c224296509439d3786f64bfb3" "basis" 577 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/edb-import/verification.json"} {"question" "q-123767" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/state.json" "file_sha256" "d861e251665aa8f66e9fc750b615829a7af27a63204e9fbbe3201691e0a8edd4" "basis" 577 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/edb-import/verification.json"} {"question" "q-123767" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "y<-1"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/state.json" "file_sha256" "d861e251665aa8f66e9fc750b615829a7af27a63204e9fbbe3201691e0a8edd4" "basis" 577 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/