Academy/reference/mathacademy/history-question-import-2026-10-04/format-audit/repairs.json" "file_sha256" "0328005daa91919dd8bb81fd729228440954ec812e808e91c99da77efc57aee9" "transaction" "/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/format-audit/database-repair/transaction.edn" "transaction_sha256" "571ee7e4f8997fdfae74f800edd84d0efce760607b5043aa85a8d9d81962095f" "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/format-audit/database-repair/verification.json" "basis" 653} {"question" "q-326256" "field" nil "attribute" "question/problem" "value" "Consider the curve with parametric equations\n\n$$\nx=cos\\,(\\frac{\\pi t}{2}),\\,y=tan\\,(\\frac{\\pi t}{3}),\\,-1\\le t\\le 4.\n$$\n\nFill in the blanks in the following table of values:\n\n| **$t$** | $-1$ | $0$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $0$ | {{field-1}} | $0$ | {{field-2}} | $0$ | $1$ |\n| $y$ | $-\\sqrt{3}$ | $0$ | {{field-3}} | $-\\sqrt{3}$ | $0$ | $\\sqrt{3}$ |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/state.json" "file_sha256" "d861e251665aa8f66e9fc750b615829a7af27a63204e9fbbe3201691e0a8edd4" "basis" 577 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/edb-import/verification.json"} {"question" "q-326256" "field" nil "attribute" "question/worked-solution" "value" "- To find the value of $x(0),$ we substitute $t=0$ into $x=cos\\,(\\frac{\\pi t}{2}).$ This gives\n\n$$\nx(0)=cos\\,(\\frac{\\pi (0)}{2})=\\operatorname{cos}⁡(0)=1.\n$$\n\n- To find the value of $y(1),$ we substitute $t=1$ into $y=tan\\,(\\frac{\\pi t}{3}).$ This gives\n\n$$\ny(1)=tan\\,(\\frac{\\pi (1)}{3})=tan\\,(\\frac{\\pi }{3})=\\sqrt{3}.\n$$\n\n- To find the value of $x(2),$ we substitute $t=2$ into $x=cos\\,(\\frac{\\pi t}{2}).$ This gives\n\n$$\nx(2)=cos\\,(\\frac{\\pi (2)}{2})=\\operatorname{cos}⁡(\\pi )=-1.\n$$\n\nThen the table is \n\n \n\n| **$t$** | $-1$ | $0$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $0$ | $1$ | $0$ | $-1$ | $0$ | $1$ |\n| $y$ | $-\\sqrt{3}$ | $0$ | $\\sqrt{3}$ | $-\\sqrt{3}$ | $0$ | $\\sqrt{3}$ |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/state.json" "file_sha256" "d861e251665aa8f66e9fc750b615829a7af27a63204e9fbbe3201691e0a8edd4" "basis" 577 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/edb-import/verification.json"} {"question" "q-326256" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/activity-metadata.json" "file_sha256" "e1117fbad5be03ecebc64ce9149e81bbdb780c8c224296509439d3786f64bfb3" "basis" 577 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/edb-import/verification.json"} {"question" "q-326256" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/state.json" "file_sha256" "d861e251665aa8f66e9fc750b615829a7af27a63204e9fbbe3201691e0a8edd4" "basis" 577 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/edb-import/verification.json"} {"question" "q-326256" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/state.json" "file_sha256" "d861e251665aa8f66e9fc750b615829a7af27a63204e9fbbe3201691e0a8edd4" "basis" 577 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/edb-import/verification.json"} {"question" "q-326256" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/state.json" "file_sha256" "d861e251665aa8f66e9fc750b615829a7af27a63204e9fbbe3201691e0a8edd4" "basis" 577 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/edb-import/verification.json"} {"question" "q-326242" "field" nil "attribute" "question/problem" "value" "Consider the curve with parametric equations\n\n$$\nx=\\frac{3}{2}t+1,\\,y=-\\frac{5}{4}t+2,\\,-1\\le t\\le 4.\n$$\n\nFill in the blanks in the following table of values:\n\n| **$t$** | $-1$ | $0$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | {{field-1}} | $1$ | $\\frac{5}{2}$ | $4$ | {{field-2}} | $7$ |\n| $y$ | {{field-3}} | $2$ | $\\frac{3}{4}$ | $-\\frac{1}{2}$ | $-\\frac{7}{4}$ | $-3$ |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/state.json" "file_sha256" "d861e251665aa8f66e9fc750b615829a7af27a63204e9fbbe3201691e0a8edd4" "basis" 577 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/edb-import/verification.json"} {"question" "q-326242" "field" nil "attribute" "question/worked-solution" "value" "- To find the value of $x(-1),$ we substitute $t=-1$ into $x=\\frac{3}{2}t+1.$ This gives\n\n$$\nx(-1)=\\frac{3}{2}(-1)+1=-\\frac{3}{2}+\\frac{2}{2}=-\\frac{1}{2}.\n$$\n\n- To find the value of $y(-1),$ we substitute $t=-1$ into $y=-\\frac{5}{4}t+2.$ This gives\n\n$$\ny(-1)=-\\frac{5}{4}(-1)+2=\\frac{5}{4}+\\frac{8}{4}=\\frac{13}{4}.\n$$\n\n- To find the value of $x(3),$ we substitute $t=3$ into $x=\\frac{3}{2}t+1.$ This gives\n\n$$\nx(2)=\\frac{3}{2}(3)+1=\\frac{9}{2}+\\frac{2}{2}=\\frac{11}{2}.\n$$\n\nThen the table is \n\n \n\n| **$t$** | $-1$ | $0$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $-\\frac{1}{2}$ | $1$ | $\\frac{5}{2}$ | $4$ | $\\frac{11}{2}$ | $7$ |\n| $y$ | $\\frac{13}{4}$ | $2$ | $\\frac{3}{4}$ | $-\\frac{1}{2}$ | $-\\frac{7}{4}$ | $-3$ |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/state.json" "file_sha256" "d861e251665aa8f66e9fc750b615829a7af27a63204e9fbbe3201691e0a8edd4" "basis" 577 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/edb-import/verification.json"} {"question" "q-326242" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/activity-metadata.json" "file_sha256" "e1117fbad5be03ecebc64ce9149e81bbdb780c8c224296509439d3786f64bfb3" "basis" 577 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/edb-import/verification.json"} {"question" "q-326242" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/state.json" "file_sha256" "d861e251665aa8f66e9fc750b615829a7af27a63204e9fbbe3201691e0a8edd4" "basis" 577 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/edb-import/verification.json"} {"question" "q-326242" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{1}{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/state.json" "file_sha256" "d861e251665aa8f66e9fc750b615829a7af27a63204e9fbbe3201691e0a8edd4" "basis" 577 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948638/edb-import/verification.json"} {"questio