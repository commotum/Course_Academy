[{:db/id "q-326251/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "064dada6-813e-5fa4-8e1b-1c9a28bc69a5" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-326251/field-1" :answer-field/id #uuid "4bc03e44-c691-5927-b19c-cefe4658eefe" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-326251/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-326251/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-326251/field-2/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" :answer/id #uuid "b2a9454b-3567-54e1-824c-9a76f9e00dee" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "q-326251/field-2" :answer-field/id #uuid "f8fb061e-80e8-540a-87a4-ed021b4b7a69" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-326251/field-2/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" :answer-field/choices ["q-326251/field-2/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856"] :db/ensure [:answer-field/validate]} {:db/id "q-326251/field-3/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "7cfb2a80-fa63-5a5c-8b2b-eaad187b6a42" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-326251/field-3" :answer-field/id #uuid "ede85813-e8f1-5d08-9ccb-18f26453d2af" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-326251/field-3/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-326251/field-3/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-326251" :question/id #uuid "6aebe50f-dc47-519c-b6ab-6e3d67578350" :question/math-academy-id "q-326251" :question/problem "Consider the curve with parametric equations\n\n$$\nx=\\sqrt{\\,t+4\\,},\\,y=\\frac{3}{2}{t}^{2}-t,\\,-3\\le t\\le 2.\n$$\n\nFill in the blanks in the following table of values:\n\n| **$t$** | $-3$ | $-2$ | $-1$ | $0$ | $1$ | $2$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | {{field-1}} | $\\sqrt{2}$ | $\\sqrt{3}$ | $2$ | $\\sqrt{5}$ | $\\sqrt{6}$ |\n| $y$ | $\\frac{33}{2}$ | $8$ | {{field-2}} | $0$ | $\\frac{1}{2}$ | {{field-3}} |" :question/worked-solution "- To find the value of $x(-3),$ we substitute $t=-3$ into $x=\\sqrt{\\,t+4\\,}.$ This gives\n\n$$\nx(-3)=\\sqrt{-3+4}=\\sqrt{1}=1.\n$$\n\n- To find the value of $y(-1),$ we substitute $t=-1$ into $y=\\frac{3}{2}{t}^{2}-t.$ This gives\n\n$$\ny(-1)=\\frac{3}{2}(-1)^{2}-(-1)=\\frac{3}{2}+1=\\frac{3}{2}+\\frac{2}{2}=\\frac{5}{2}.\n$$\n\n- To find the value of $y(2),$ we substitute $t=2$ into $y=\\frac{3}{2}{t}^{2}-t.$ This gives\n\n$$\ny(2)=\\frac{3}{2}(2)^{2}-(2)=6-2=4.\n$$\n\nThen the table is \n\n \n\n| **$t$** | $-3$ | $-2$ | $-1$ | $0$ | $1$ | $2$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $1$ | $\\sqrt{2}$ | $\\sqrt{3}$ | $2$ | $\\sqrt{5}$ | $\\sqrt{6}$ |\n| $y$ | $\\frac{33}{2}$ | $8$ | $\\frac{5}{2}$ | $0$ | $\\frac{1}{2}$ | $4$ |" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-326251/field-1" "q-326251/field-2" "q-326251/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bbf50e27-a8c3-52e7-be21-5d7ed61e5512"] :knowledge-point/questions ["q-326251"] :db/ensure [:knowledge-point/validate]} {:db/id "q-326255/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "4aca2a8d-03df-5b1a-878c-e4b4b145e34f" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-326255/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "b50723ef-f568-522b-90c5-7e98d4d78cf0" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-326255/field-1" :answer-field/id #uuid "d7022e67-98ee-596d-9862-17eabed94a8e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-326255/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-326255/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-326255/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-326255/field-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "4aedc190-bcbd-525f-b0cd-b6bed6e1eae4" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-326255/field-2" :answer-field/id #uuid "eed95de1-9871-5e7c-8a2e-0443abd83b3b" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-326255/field-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-326255/field-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-326255/field-3/e7f6c27482797e11bd6b0013338edc6789517ab47eb94f4fe9912fc5f8b6c4b8" :answer/id #uuid "c83b2c3a-57d2-573b-b5c0-7ab2a61da47e" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "q-326255/field-3" :answer-field/id #uuid "63b55842-3a70-569f-b530-a69017c74857" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-326255/field-3/e7f6c27482797e11bd6b0013338edc6789517ab47eb94f4fe9912fc5f8b6c4b8" :answer-field/choices ["q-326255/field-3/e7f6c27482797e11bd6b0013338edc6789517ab47eb94f4fe9912fc5f8b6c4b8"] :db/ensure [:answer-field/validate]} {:db/id "q-326255" :question/id #uuid "1bd0a058-ab8d-59a2-8e73-0f34d8fb9db0" :question/math-academy-id "q-326255" :question/problem "Consider the curve with parametric equations\n\n$$\nx=cos\\,(\\frac{\\pi t}{4}),\\,y=sin\\,(\\frac{\\pi t}{6}),\\,0\\le t\\le 5.\n$$\n\nFill in the blanks in the following table of values:\n\n| **$t$** | $0$ | $1$ | $2$ | $3$ | $4$ | $5$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $1$ | $\\frac{\\sqrt{2}}{2}$ | {{field-1}} | $-\\frac{\\sqrt{2}}{2}$ | $-1$ | $-\\frac{\\sqrt{2}}{2}$ |\n| $y$ | $0$ | $\\frac{1}{2}$ | $\\frac{\\sqrt{3}}{2}$ | {{field-2}} | {{field-3}} | $\\frac{1}{2}$ |" :question/worked-solution "- To find the value of $x(2),$ we substitute $t=2$ into $x=cos\\,(\\frac{\\pi t}{4}).$ This gives\n\n$$\nx(2)=cos\\,(\\frac{\\pi (2)}{4})=cos\\,(\\frac{\\pi }{2})=0.\n$$\n\n- To find the value of $y(3),$ we substitute $t=3$ into $y=sin\\,(\\frac{\\pi t}{6}).$ This gives\n\n$$\ny(3)=sin\\,(\\frac{\\pi (3)}{6})=sin\\,(\\frac{\\pi }{2})=1.\n$$\n\n- To find the value of $y(4),$ we substitute $t=4$ into $y=sin\\,(\\frac{\\pi t}{6}).$ This gives\n\n$$\ny(1)=sin\\,(\\frac{\\pi (4)}{6})=sin\\,(\\frac{2\\pi }{3})=\\frac{\\sqrt{3}}{2}.\n$$\n\nThen the table is \n\n \n\n| **$t$** | $0$ | $1$ | $2$ | $3$ | $4$ | $5$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $1$ | $\\frac{\\sqrt{2}}{2}$ | $0$ | $-\\frac{\\sqrt{2}}{2}$ | $-1$ | $-\\frac{\\sqrt{2}}{2}$ |\n| $y$ | $0$ | $\\frac{1}{2}$ | $\\frac{\\sqrt{3}}{2}$ | $1$ | $\\frac{\\sqrt{3}}{2}$ | $\\frac{1}{2}$ |" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-326255/field-1" "q-326255/field-2" "q-326255/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bbf50e27-a8c3-52e7-be21-5d7ed61e5512"] :knowledge-point/questions ["q-326255"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186261094 :question/answer-fields 17592186274880] {:db/id "q-6832/selection/ma-v1/3f137cd2c94f1df7872de8fb3c2c74374f690a572c1c1cfad972dbbc8589b7b5/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "f3c98dd4-620a-5da3-9782-0b10fe6807b