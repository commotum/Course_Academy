#{[{:db/id #edb/ref 17592186258555 :knowledge-point/_questions [{:knowledge-point/id #uuid "3cbf0ad0-a7c5-5c0f-a06c-9210fdc244ef" :knowledge-point/title "Determining the Range of a Parametric Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11128e59-218c-564c-899f-33d1f4d59de3" :answer/type {:db/ident :answer.type/text} :answer/value "$x\\ge-\\frac14$ and $y\\le-2$" :db/id #edb/ref 17592186271158} {:answer/id #uuid "ffb5f3b5-57fe-5b71-965f-7f1372d6b1f8" :answer/type {:db/ident :answer.type/text} :answer/value "$x\\le-\\frac14$ and $y\\ge-2$" :db/id #edb/ref 17592186271159} {:answer/id #uuid "68efaf3c-951d-5bf1-b314-a48ce708f80d" :answer/type {:db/ident :answer.type/text} :answer/value "$x\\ge-\\frac14$ and $y\\ge2$" :db/id #edb/ref 17592186271160} {:answer/id #uuid "cb06738f-cefd-5df9-a3f8-c1aecac469f2" :answer/type {:db/ident :answer.type/text} :answer/value "$x\\ge\\frac14$ and $y\\ge-2$" :db/id #edb/ref 17592186271161} {:answer/id #uuid "78856cb5-8ef8-556d-b19f-eab43588da3c" :answer/type {:db/ident :answer.type/text} :answer/value "$x\\ge-\\frac14$ and $y\\ge-2$" :db/id #edb/ref 17592186271162}] :answer-field/correct {:answer/id #uuid "78856cb5-8ef8-556d-b19f-eab43588da3c" :answer/type {:db/ident :answer.type/text} :answer/value "$x\\ge-\\frac14$ and $y\\ge-2$" :db/id #edb/ref 17592186271162} :answer-field/id #uuid "df9393bf-8b86-527d-966c-3fb1ffe4016c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274508}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a4387361-c86a-55f1-abee-652931e3d6d3" :question/math-academy-id "q-16149" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx={t}^{2}+t,\\,\\,\\,y={t}^{2}-2,\\,t\\in (-\\infty ,\\infty ),\n$$\n\ndetermine the ranges of $x$ and $y.$" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ we can start by completing the square, as follows:\n\n$$\n\\begin{aligned}x & ={t}^{2}+t \\\\  & ={(t+\\frac{1}{2})}^{2}-{(\\frac{1}{2})}^{2} \\\\  & ={(t+\\frac{1}{2})}^{2}-\\frac{1}{4}\\end{aligned}\n$$\n\nSince ${(t+\\frac{1}{2})}^{2}\\ge 0,$ we can conclude that $x\\ge -\\frac{1}{4}.$\n\n- To find the range of $y,$ notice that ${t}^{2}\\ge 0.$ Therefore, we can conclude that $y\\ge -2.$\n\nSo, the ranges are $x\\ge -\\frac{1}{4}$ and $y\\ge -2.$"}] [{:db/id #edb/ref 17592186261094 :knowledge-point/_questions [{:knowledge-point/id #uuid "bbf50e27-a8c3-52e7-be21-5d7ed61e5512" :knowledge-point/title "Filling a Table of Values for a Parametric Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0af30daa-3d96-58b7-acb0-e2e362ed73ab" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186272983} {:answer/id #uuid "64f3aff4-f0f5-53c7-a481-70325eab1e50" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186272984} {:answer/id #uuid "e20a281d-a20d-5f04-b509-4c51021151c0" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186272985} {:answer/id #uuid "03ab8aaf-b5d3-5f9c-a7f7-0a85cba57a44" :answer/type {:db/ident :answer.type/math} :answer/value "− 10" :db/id #edb/ref 17592186272986} {:answer/id #uuid "9b0b79eb-363b-53bc-b27c-c70aef0fc31b" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186272987}] :answer-field/correct {:answer/id #uuid "9b0b79eb-363b-53bc-b27c-c70aef0fc31b" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186272987} :answer-field/id #uuid "09922fb0-776c-5727-889c-7e382c43b2f0" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274880}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "bb6b00ad-d0da-51b8-947a-ae3a849534d3" :question/math-academy-id "q-6832" :question/problem "For the parametric curve\n\n$$\nx=\\operatorname{sin}(\\frac{\\pi t}{2}),\\,\\,\\,y=\\operatorname{cos}(\\frac{\\pi t}{3}),\\,-3\\le t\\le 3,\n$$\n\nconsider the following table of values:\n\n| **$t$** | $-3$ | $-2$ | $-1$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $1$ | $0$ | $b$ | $0$ | $1$ | $0$ | $c$ |\n| $y$ | $a$ | $-\\frac{1}{2}$ | $\\frac{1}{2}$ | $1$ | $\\frac{1}{2}$ | $-\\frac{1}{2}$ | $-1$ |\n\n$$\n\n$$\n\nFind the value of $-a+b+c.$" :question/worked-solution "- To find the value of $a,$ we substitute $t=-3$ into $y=\\operatorname{cos}(\\frac{\\pi t}{3}).$ This gives\n\n$$\na=\\operatorname{cos}(\\frac{\\pi (-3)}{3})=\\operatorname{cos}(-\\pi )=-1.\n$$\n\n- To find the value of $b,$ we substitute $t=-1$ into $y=\\operatorname{sin}(\\frac{\\pi t}{2}).$ This gives\n\n$$\nb=\\operatorname{sin}(\\frac{\\pi (-1)}{2})=\\operatorname{sin}(-\\frac{\\pi }{2})=-1.\n$$\n\n- To find the value of $c,$ we substitute $t=3$ into $y=\\operatorname{sin}(\\frac{\\pi t}{2}).$ This gives\n\n$$\nc=\\operatorname{sin}(\\frac{\\pi (3)}{2})=\\operatorname{sin}(\\frac{3\\pi }{2})=-1.\n$$\n\nFinally, we have\n\n$$\n-a+b+c=-(-1)+(-1)+(-1)=-1.\n$$"}]}
