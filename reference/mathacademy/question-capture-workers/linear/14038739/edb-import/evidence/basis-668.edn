ac{7}{2}" :db/id #edb/ref 17592186275699}] :answer-field/correct {:answer/id #uuid "08570f08-3382-54e2-ba36-8eaeda2e6813" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{2}" :db/id #edb/ref 17592186275699} :answer-field/id #uuid "6c5e1b44-c6d1-558e-85b2-b32ed41c48b4" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275698} {:answer-field/choices [{:answer/id #uuid "d073bb12-45a5-596c-ad76-515cb245032e" :answer/type {:db/ident :answer.type/math} :answer/value "\\le" :db/id #edb/ref 17592186275701}] :answer-field/correct {:answer/id #uuid "d073bb12-45a5-596c-ad76-515cb245032e" :answer/type {:db/ident :answer.type/math} :answer/value "\\le" :db/id #edb/ref 17592186275701} :answer-field/id #uuid "06770541-4ec7-5f6f-a644-22e8d966b3b6" :answer-field/key "field-5" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275700} {:answer-field/choices [{:answer/id #uuid "0c1d7cab-eb59-55e4-a06e-03b4822cd9f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186275703}] :answer-field/correct {:answer/id #uuid "0c1d7cab-eb59-55e4-a06e-03b4822cd9f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186275703} :answer-field/id #uuid "df3ebeab-b70a-5a51-8b19-b8740996ed88" :answer-field/key "field-6" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275702}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e19f9d2f-d1af-57bd-aeba-378c8da0ab0f" :question/math-academy-id "q-327880" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=4\\operatorname{cos}⁡\\theta +1,\\,y=-\\frac{7}{2}\\operatorname{sin}⁡\\theta ,\\,0\\le \\theta <2\\pi ,\n$$\n\nwhat are the ranges of $x$ and $y?$\n\nThe range of $x$ is \n{{field-1}}{{field-2}}\n$x\\le $\n{{field-3}}.\n\nThe range of $y$ is \n{{field-4}}\n$\\le y$\n{{field-5}}{{field-6}}." :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ notice that for $0\\le \\theta <2\\pi ,$ \nwe have $-1\\le \\operatorname{cos}⁡\\theta \\le 1.$ Consequently,\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{cos}⁡\\theta \\le 1 \\\\ -4 & \\le 4\\operatorname{cos}⁡\\theta \\le 4 \\\\ -4+1 & \\le 4\\operatorname{cos}⁡\\theta +1\\le 4+1 \\\\ -3 & \\le x\\le 5.\\end{aligned}\n$$\n\nSo, we can conclude that $-3\\le x\\le 5.$\n\n- To find the range of $y,$ notice that for $0\\le \\theta <2\\pi ,$ \nwe have $-1\\le \\operatorname{sin}⁡\\theta \\le 1.$ Consequently,\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{sin}⁡\\theta \\le 1 \\\\ \\frac{7}{2} & \\text{ }\\ge -\\frac{7}{2}\\operatorname{sin}⁡\\theta \\text{ }\\ge -\\frac{7}{2} \\\\ -\\frac{7}{2} & \\le -\\frac{7}{2}\\operatorname{sin}⁡\\theta \\le \\frac{7}{2} \\\\ -\\frac{7}{2} & \\le y\\le \\frac{7}{2}.\\end{aligned}\n$$\n\nSo, we can conclude that $-\\frac{7}{2}\\le y\\le \\frac{7}{2}.$"}]}
