#{[{:db/id #edb/ref 17592186258555 :knowledge-point/_questions [{:knowledge-point/id #uuid "3cbf0ad0-a7c5-5c0f-a06c-9210fdc244ef" :knowledge-point/title "Determining the Range of a Parametric Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed7518da-2a73-5f44-b43b-c16f91d894a6" :answer/type {:db/ident :answer.type/math} :answer/value "[-\\frac14,\\infty)" :db/id #edb/ref 17592186258557}] :answer-field/correct {:answer/id #uuid "ed7518da-2a73-5f44-b43b-c16f91d894a6" :answer/type {:db/ident :answer.type/math} :answer/value "[-\\frac14,\\infty)" :db/id #edb/ref 17592186258557} :answer-field/id #uuid "9e463822-912d-5d8d-9273-4f346c0c5a2d" :answer-field/key "x-range" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258556} {:answer-field/choices [{:answer/id #uuid "aea19993-d64a-5538-8260-3c61f7186752" :answer/type {:db/ident :answer.type/math} :answer/value "[-2,\\infty)" :db/id #edb/ref 17592186258559}] :answer-field/correct {:answer/id #uuid "aea19993-d64a-5538-8260-3c61f7186752" :answer/type {:db/ident :answer.type/math} :answer/value "[-2,\\infty)" :db/id #edb/ref 17592186258559} :answer-field/id #uuid "42d036ae-7bbb-5cf5-8be4-b64c524400e8" :answer-field/key "y-range" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258558}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a4387361-c86a-55f1-abee-652931e3d6d3" :question/math-academy-id "q-16149" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx={t}^{2}+t,\\,\\,\\,y={t}^{2}-2,\\,t\\in (-\\infty ,\\infty ),\n$$\n\ndetermine the ranges of $x$ and $y.$\n\nX range: {{x-range}}\n\nY range: {{y-range}}" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ we can start by completing the square, as follows:\n\n$$\n\\begin{aligned}x & ={t}^{2}+t \\\\  & ={(t+\\frac{1}{2})}^{2}-{(\\frac{1}{2})}^{2} \\\\  & ={(t+\\frac{1}{2})}^{2}-\\frac{1}{4}\\end{aligned}\n$$\n\nSince ${(t+\\frac{1}{2})}^{2}\\ge 0,$ we can conclude that $x\\ge -\\frac{1}{4}.$\n\n- To find the range of $y,$ notice that ${t}^{2}\\ge 0.$ Therefore, we can conclude that $y\\ge -2.$\n\nSo, the ranges are $x\\ge -\\frac{1}{4}$ and $y\\ge -2.$"}] [{:db/id #edb/ref 17592186261094 :knowledge-point/_questions [{:knowledge-point/id #uuid "bbf50e27-a8c3-52e7-be21-5d7ed61e5512" :knowledge-point/title "Filling a Table of Values for a Parametric Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d07a408d-61e2-5c18-ae4f-c310d6a3fc68" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186261096}] :answer-field/correct {:answer/id #uuid "d07a408d-61e2-5c18-ae4f-c310d6a3fc68" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186261096} :answer-field/id #uuid "757137c4-df81-5d0c-9722-1fd017aa21a9" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261095}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "bb6b00ad-d0da-51b8-947a-ae3a849534d3" :question/math-academy-id "q-6832" :question/problem "For the parametric curve\n\n$$\nx=\\operatorname{sin}(\\frac{\\pi t}{2}),\\,\\,\\,y=\\operatorname{cos}(\\frac{\\pi t}{3}),\\,-3\\le t\\le 3,\n$$\n\nconsider the following table of values:\n\n| **$t$** | $-3$ | $-2$ | $-1$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $1$ | $0$ | $b$ | $0$ | $1$ | $0$ | $c$ |\n| $y$ | $a$ | $-\\frac{1}{2}$ | $\\frac{1}{2}$ | $1$ | $\\frac{1}{2}$ | $-\\frac{1}{2}$ | $-1$ |\n\n$$\n\n$$\n\nFind the value of $-a+b+c.$\n\nAnswer: {{answer}}" :question/worked-solution "- To find the value of $a,$ we substitute $t=-3$ into $y=\\operatorname{cos}(\\frac{\\pi t}{3}).$ This gives\n\n$$\na=\\operatorname{cos}(\\frac{\\pi (-3)}{3})=\\operatorname{cos}(-\\pi )=-1.\n$$\n\n- To find the value of $b,$ we substitute $t=-1$ into $y=\\operatorname{sin}(\\frac{\\pi t}{2}).$ This gives\n\n$$\nb=\\operatorname{sin}(\\frac{\\pi (-1)}{2})=\\operatorname{sin}(-\\frac{\\pi }{2})=-1.\n$$\n\n- To find the value of $c,$ we substitute $t=3$ into $y=\\operatorname{sin}(\\frac{\\pi t}{2}).$ This gives\n\n$$\nc=\\operatorname{sin}(\\frac{\\pi (3)}{2})=\\operatorname{sin}(\\frac{3\\pi }{2})=-1.\n$$\n\nFinally, we have\n\n$$\n-a+b+c=-(-1)+(-1)+(-1)=-1.\n$$"}]}
