[{:db/id "q-34601/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "d2f20cc7-771d-5044-ba85-ba83e0b94627" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-34601/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "7bcd222c-0104-570f-8f16-602a9cb65046" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-34601/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "af33eac0-fead-5aa4-b942-7ed01bb02efa" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-34601/selection/9b7434427674375d5ea83db171159165ffe665e9e355697a96ae180983fa29ca" :answer/id #uuid "7c30856c-03d5-56c4-bb1b-377ab9fe821a" :answer/type :answer.type/math :answer/value "-53" :db/ensure [:answer/validate]} {:db/id "q-34601/selection/f18416f35432d431c72acfc39d7e01add033f359c3a10a94fc360561f773edf6" :answer/id #uuid "582eedc7-c97b-5fc7-8ce3-eb42318ed701" :answer/type :answer.type/math :answer/value "53" :db/ensure [:answer/validate]} {:db/id "q-34601/selection" :answer-field/id #uuid "f264819e-3819-5dc5-97dc-3265241aee8d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-34601/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer-field/choices ["q-34601/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" "q-34601/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" "q-34601/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-34601/selection/9b7434427674375d5ea83db171159165ffe665e9e355697a96ae180983fa29ca" "q-34601/selection/f18416f35432d431c72acfc39d7e01add033f359c3a10a94fc360561f773edf6"] :db/ensure [:answer-field/validate]} {:db/id "q-34601" :question/id #uuid "699da302-dc6b-5ab6-a923-64ab693ea43f" :question/math-academy-id "q-34601" :question/problem "Find the value of ${x}_{3}-{x}_{4}$ given that  $6a-2x=b$ and\n\n$$\na=[\\begin{aligned}4 \\\\ -2 \\\\ 6 \\\\ 8\\end{aligned}],\\,x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3} \\\\ {x}_{4}\\end{aligned}],\\,b=[\\begin{aligned}8 \\\\ -6 \\\\ -12 \\\\ -10\\end{aligned}].\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate $x,$ we get\n\n$$\n\\begin{aligned}6a-2x & =b \\\\ -2x & =b-6a \\\\ x & =-\\frac{1}{2}(b-6a) \\\\ x & =-\\frac{1}{2}([\\begin{aligned}8 \\\\ -6 \\\\ -12 \\\\ -10\\end{aligned}]-6[\\begin{aligned}4 \\\\ -2 \\\\ 6 \\\\ 8\\end{aligned}]) \\\\ x & =-\\frac{1}{2}[\\begin{aligned}-16 \\\\ 6 \\\\ -48 \\\\ -58\\end{aligned}] \\\\ x & =[\\begin{aligned}8 \\\\ -3 \\\\ 24 \\\\ 29\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, ${x}_{3}-{x}_{4}=24-29=-5.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-34601/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "590953b8-2533-5a4b-bf4f-f002b0367919"] :knowledge-point/questions ["q-34601"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74006/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "16a743f7-e4e3-5d42-9e43-e42ea305e97d" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-74006/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer/id #uuid "94cf71a5-f8ef-5532-a031-12ce96ac2b75" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "q-74006/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45" :answer/id #uuid "4205870b-a3f8-5699-9ead-23401f0c49e8" :answer/type :answer.type/math :answer/value "-12" :db/ensure [:answer/validate]} {:db/id "q-74006/selection/6d6811ceb4fb69a54ce1b24e6804e5f0148bafa1b76b847b06436eb966d36b67" :answer/id #uuid "ab1728ec-9dc5-5478-b27b-eeb2b310bece" :answer/type :answer.type/text :answer/value "No solution" :db/ensure [:answer/validate]} {:db/id "q-74006/selection/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" :answer/id #uuid "72d7c196-9c5f-5d5e-a08a-07caafcfb195" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "q-74006/selection" :answer-field/id #uuid "c0384bab-b8d7-5abd-89f3-0cb9d80d27c5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74006/selection/6d6811ceb4fb69a54ce1b24e6804e5f0148bafa1b76b847b06436eb966d36b67" :answer-field/choices ["q-74006/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" "q-74006/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" "q-74006/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45" "q-74006/selection/6d6811ceb4fb69a54ce1b24e6804e5f0148bafa1b76b847b06436eb966d36b67" "q-74006/selection/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a"] :db/ensure [:answer-field/validate]} {:db/id "q-74006" :question/id #uuid "e9890d0f-a574-5442-8aa8-be48658bceab" :question/math-academy-id "q-74006" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}2 \\\\ -1 \\\\ -1\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}0 \\\\ -1 \\\\ -3\\end{aligned}],\\,b=[\\begin{aligned}-2 \\\\ 5 \\\\ 1\\end{aligned}].\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then   we have\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}]+{x}_{2}[\\begin{aligned}2 \\\\ -1 \\\\ -1\\end{aligned}]+{x}_{3}[\\begin{aligned}0 \\\\ -1 \\\\ -3\\end{aligned}] & =[\\begin{aligned}-2 \\\\ 5 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}{x}_{1} \\\\ 0 \\\\ {x}_{1}\\end{aligned}]+[\\begin{aligned}2{x}_{2} \\\\ -{x}_{2} \\\\ -{x}_{2}\\end{aligned}]+[\\begin{aligned}0 \\\\ -{x}_{3} \\\\ -3{x}_{3}\\end{aligned}] & =[\\begin{aligned}-2 \\\\ 5 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}{x}_{1}+2{x}_{2} \\\\ -{x}_{2}-{x}_{3} \\\\ {x}_{1}-{x}_{2}-3{x}_{3}\\end{aligned}] & =[\\begin{aligned}-2 \\\\ 5 \\\\ 1\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n{\\begin{aligned}{x}_{1}+2{x}_{2}=-2 \\\\ -{x}_{2}-{x}_{3}=5 \\\\ {x}_{1}-{x}_{2}-3{x}_{3}=1\\end{aligned}\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=[\\begin{aligned}1 & 2 & 0 & -2 \\\\ 0 & -1 & -1 & 5 \\\\ 1 & -1 & -3 & 1\\end{aligned}].\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 2 & 0 & -2 \\\\ 0 & -1 & -1 & 5 \\\\ 1 & -1 & -3 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}+(-1){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & 0 & -2 \\\\ 0 & -1 & -1 & 5 \\\\ 0 & -3 & -3 & 3\\end{aligned}] & {R}_{2} & :=(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 2 & 0 & -2 \\\\ 0 & 1 & 1 & -5 \\\\ 0 & -3 & -3 & 3\\end{aligned}] & {R}_{3} & :={R}_{3}+3{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 2 & 0 & -2 \\\\ 0 & 1 & 1 & -5 \\\\ 0 & 0 & 0 & -12\\end{aligned}].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n{\\begin{aligned}{x}_{1}+2{x}_{2}=-2 \\\\ {x}_{2}+{x}_{3}=-5 \\\\ 0=-12.\\end{aligned}\n$$\n\nHowever, the final equation $0=-12$  gives a false statement. So the system has no solution." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-74006/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "13a44dc8-4699-519f-8cb1-87ad77471ebe"] :knowledge-point/questions ["q-74006"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74035/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "7495ac1a-eec6-562b-b0c1-bfde9ebd34ae" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-74035/selection/6d6811ceb4fb69a54ce1b24e6804e5f0148bafa1b76b847b06436eb966d36b67" :answer/id #uuid "b0fe467a-2dce-51a7-8f4b-e6ab0a9425f2" :answer/type :answer.type/text :answer/value "No solution" :db/ensure [:answer/validate]} {:db/id "q-74035/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "19eafb9c-823d-51b5-942f-a440bdfc1cc6" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-74035/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "1ea5e1b9-2c80-508a-8cf6-48716e54d21b" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-74035/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "37b19c26-618f-536e-9d18-d253ddfc349b" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-74035/selection" :answer-field/id #uuid "948b8786-95d1-58a2-94ad-53d105929fbc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74035/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-74035/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-74035/selection/6d6811ceb4fb69a54ce1b24e6804e5f0148bafa1b76b847b06436eb966d36b67" "q-74035/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" "q-74035/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-74035/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-74035" :question/id #uuid "4659fe52-f91a-51a6-a6b4-a2d78caaefe9" :question/math-academy-id "q-74035" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 0 \\\\ 3\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-1 \\\\ 5 \\\\ 2\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}],\\,b=[\\begin{aligned}-3 \\\\ 4 \\\\ -4\\end{aligned}].\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}1 \\\\ 0 \\\\ 3\\end{aligned}]+{x}_{2}[\\begin{aligned}-1 \\\\ 5 \\\\ 2\\end{aligned}]+{x}_{3}[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}] & =[\\begin{aligned}-3 \\\\ 4 \\\\ -4\\end{aligned}] \\\\ [\\begin{aligned}{x}_{1} \\\\ 0 \\\\ 3{x}_{1}\\end{aligned}]+[\\begin{aligned}-{x}_{2} \\\\ 5{x}_{2} \\\\ 2{x}_{2}\\end{aligned}]+[\\begin{aligned}0 \\\\ {x}_{3} \\\\ 0\\end{aligned}] & =[\\begin{aligned}-3 \\\\ 4 \\\\ -4\\end{aligned}] \\\\ [\\begin{aligned}{x}_{1}-{x}_{2} \\\\ 5{x}_{2}+{x}_{3} \\\\ 3{x}_{1}+2{x}_{2}\\end{aligned}] & =[\\begin{aligned}-3 \\\\ 4 \\\\ -4\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n{\\begin{aligned}{x}_{1}-{x}_{2}=-3 \\\\ 5{x}_{2}+{x}_{3}=4 \\\\ 3{x}_{1}+2{x}_{2}=-4\\end{aligned}\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=[\\begin{aligned}1 & -1 & 0 & -3 \\\\ 0 & 5 & 1 & 4 \\\\ 3 & 2 & 0 & -4\\end{aligned}]\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -1 & 0 & -3 \\\\ 0 & 5 & 1 & 4 \\\\ 3 & 2 & 0 & -4\\end{aligned}] & {R}_{3} & :={R}_{3}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 0 & -3 \\\\ 0 & 5 & 1 & 4 \\\\ 0 & 5 & 0 & 5\\end{aligned}] & {R}_{3} & :={R}_{3}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & 0 & -3 \\\\ 0 & 5 & 1 & 4 \\\\ 0 & 0 & -1 & 1\\end{aligned}] & {R}_{2} & :=\\frac{1}{5}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & 0 & -3 \\\\ 0 & 1 & 0.2 & 0.8 \\\\ 0 & 0 & -1 & 1\\end{aligned}] & {R}_{3} & :=-{R}_{3} \\\\  & ∼[\\begin{aligned}1 & -1 & 0 & -3 \\\\ 0 & 1 & 0.2 & 0.8 \\\\ 0 & 0 & 1 & -1\\end{aligned}].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n{\\begin{aligned}{x}_{1}-{x}_{2}=-3 \\\\ {x}_{2}+\\,0.2{x}_{3}=0.8 \\\\ {x}_{3}=-1.\\end{aligned}\n$$\n\nFrom the third equation, we get ${x}_{3}=-1.$ Substituting this value into the second equation, we get \n\n$$\n{x}_{2}+0.2(-1)=0.8\\,⟹\\,{x}_{2}=1.\n$$\n\n   \n\nFinally,  substituting ${x}_{2}=1$ into the first equation, we obtain\n\n$$\n{x}_{1}-(1)=-3\\,⟹\\,{x}_{1}=-2.\n$$\n\nSo, the solution of the system is ${x}_{1}=-2$, ${x}_{2}=1$, and ${x}_{3}=-1,$ which means  \n\n$$\n-2{a}_{1}+{a}_{2}-{a}_{3}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}+{x}_{3}=-2+1-1=-2.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-74035/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "13a44dc8-4699-519f-8cb1-87ad77471ebe"] :knowledge-point/questions ["q-74035"] :db/ensure [:knowledge-point/validate]} {:db/id "q-105160/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "9baf7df9-92ad-526b-85f8-aa369c591006" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-105160/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "e42a7588-d111-5478-b34b-95670c6d36d1" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-105160/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "7cb4d354-ab4d-5892-9cfa-e868adccf1eb" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-105160/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "9d3a7318-2ac6-57d8-aabe-645d5a38808a" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-105160/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "3d451b05-a3cf-5777-a459-