\\\\ -2 & 1 & 0 \\\\ 0 & 0 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nLikewise, computing $FE$, we get\n\n$$\n\\begin{aligned}FE & =\\frac{1}{3}[\\begin{aligned}1 & 1 & -3 \\\\ -2 & 1 & 0 \\\\ 0 & 0 & 3\\end{aligned}][\\begin{aligned}1 & -1 & 1 \\\\ 2 & 1 & 2 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nSo, statement I is true.\n\n- Now, we check whether $FG=GF={I}_{3}.$ Computing $FG$, we get\n\n$$\n\\begin{aligned}FG & =\\frac{1}{3}[\\begin{aligned}1 & 1 & -3 \\\\ -2 & 1 & 0 \\\\ 0 & 0 & 3\\end{aligned}][\\begin{aligned}1 & -3 & 4 \\\\ 0 & 2 & 3 \\\\ 3 & 0 & 1\\end{aligned}] \\\\  & =\\frac{1}{3}[\\begin{aligned}-8 & ∗ & ∗ \\\\ ∗ & ∗ & ∗ \\\\ ∗ & ∗ & ∗\\end{aligned}] \\\\  & \\ne {I}_{3}.\\,\\times \\end{aligned}\n$$\n\nSo, statement II is false. As a result, $F\\ne {G}^{-1}$ and statement III is false too.\n\nTherefore, the correct answer is \"I only\"." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-149833/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a75c67e5-3469-5730-9181-54df4ec6d5b2"] :knowledge-point/questions ["q-149833"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-11642"] :question/problem "Consider the matrices\n\n$$\nC=[\\begin{aligned}1 & 2 & 1 \\\\ 0 & 1 & 1 \\\\ 1 & 2 & 0\\end{aligned}],\\,D=[\\begin{aligned}2 & -2 & -1 \\\\ -1 & 1 & 1 \\\\ 1 & 0 & -1\\end{aligned}],\\,E=[\\begin{aligned}2 & -2 & -1 \\\\ 1 & 1 & 1 \\\\ 1 & 0 & -1\\end{aligned}].\n$$\n\nWhich of the following statements are true?\n\n- $CD=DC={I}_{3}$\n- $CE=EC={I}_{3}$\n- $E={C}^{-1}$" :question/worked-solution "- First, we check whether $CD=DC={I}_{3}.$ Computing $CD$, we get\n\n$$\n\\begin{aligned}CD & =[\\begin{aligned}1 & 2 & 1 \\\\ 0 & 1 & 1 \\\\ 1 & 2 & 0\\end{aligned}][\\begin{aligned}2 & -2 & -1 \\\\ -1 & 1 & 1 \\\\ 1 & 0 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nLikewise, computing $DC$, we get\n\n$$\n\\begin{aligned}DC & =[\\begin{aligned}2 & -2 & -1 \\\\ -1 & 1 & 1 \\\\ 1 & 0 & -1\\end{aligned}][\\begin{aligned}1 & 2 & 1 \\\\ 0 & 1 & 1 \\\\ 1 & 2 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nSo, statement I is true.\n\n- Now, we check whether $CE=EC={I}_{3}.$ Computing $CE$, we get\n\n$$\n\\begin{aligned}CE & =[\\begin{aligned}1 & 2 & 1 \\\\ 0 & 1 & 1 \\\\ 1 & 2 & 0\\end{aligned}][\\begin{aligned}2 & -2 & -1 \\\\ 1 & 1 & 1 \\\\ 1 & 0 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}5 & ∗ & ∗ \\\\ ∗ & ∗ & ∗ \\\\ ∗ & ∗ & ∗\\end{aligned}] \\\\  & \\ne {I}_{3}.\\,\\times \\end{aligned}\n$$\n\nSo, statement II is false. As a result, $E\\ne {C}^{-1}$ and statement III is false too.\n\nTherefore, the correct answer is \"I only\"." :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]}]
