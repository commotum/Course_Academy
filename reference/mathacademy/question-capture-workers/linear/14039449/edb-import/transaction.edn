} \\\\ -\\frac{1}{2} & 0\\end{aligned}].\n$$\n\nWhich of the following statements are true?\n\n- $BC=CB={I}_{2}$\n- $BD=DB={I}_{2}$\n- $D={B}^{-1}$" :question/worked-solution "- First, we check whether $BC=CB={I}_{2}.$ Computing $BC$, we get\n\n$$\n\\begin{aligned}BC & =[\\begin{aligned}0 & -2 \\\\ 2 & 0\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}0 & ∗ \\\\ ∗ & ∗\\end{aligned}] \\\\  & \\ne {I}_{2}.\\,\\times \\end{aligned}\n$$\n\nSo, statement I is false.\n\n- Now, we check whether $BD=DB={I}_{2}.$ Computing $BD$, we get\n\n$$\n\\begin{aligned}BD & =[\\begin{aligned}0 & -2 \\\\ 2 & 0\\end{aligned}][\\begin{aligned}0 & \\frac{1}{2} \\\\ -\\frac{1}{2} & 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & ={I}_{2}.\\,✓\\end{aligned}\n$$\n\nLikewise, computing $DB$, we get\n\n$$\n\\begin{aligned}DB & =[\\begin{aligned}0 & \\frac{1}{2} \\\\ -\\frac{1}{2} & 0\\end{aligned}][\\begin{aligned}0 & -2 \\\\ 2 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & ={I}_{2}.\\,✓\\end{aligned}\n$$\n\nSo, statement II is true. As a result, $D={B}^{-1}$ and statement III is true too.\n\nTherefore, the correct answer is \"II and III only\"." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-71817/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9b9ef325-2358-5041-8a8d-b459e8ed9f09"] :knowledge-point/questions ["q-71817"] :db/ensure [:knowledge-point/validate]} {:db/id "q-102669/selection/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25" :answer/id #uuid "927af9a2-2efa-5578-8c28-0f9e1016e485" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id "q-102669/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "19e63d16-9b79-5c82-887f-d529fe29d764" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} 