gned}1 & 1 & -3 \\\\ -2 & 1 & 0 \\\\ 0 & 0 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nLikewise, computing $FE$, we get\n\n$$\n\\begin{aligned}FE & =\\frac{1}{3}[\\begin{aligned}1 & 1 & -3 \\\\ -2 & 1 & 0 \\\\ 0 & 0 & 3\\end{aligned}][\\begin{aligned}1 & -1 & 1 \\\\ 2 & 1 & 2 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nSo, statement I is true.\n\n- Now, we check whether $FG=GF={I}_{3}.$ Computing $FG$, we get\n\n$$\n\\begin{aligned}FG & =\\frac{1}{3}[\\begin{aligned}1 & 1 & -3 \\\\ -2 & 1 & 0 \\\\ 0 & 0 & 3\\end{aligned}][\\begin{aligned}1 & -3 & 4 \\\\ 0 & 2 & 3 \\\\ 3 & 0 & 1\\end{aligned}] \\\\  & =\\frac{1}{3}[\\begin{aligned}-8 & ∗ & ∗ \\\\ ∗ & ∗ & ∗ \\\\ ∗ & ∗ & ∗\\end{aligned}] \\\\  & \\ne {I}_{3}.\\,\\times \\end{aligned}\n$$\n\nSo, statement II is false. As a result, $F\\ne {G}^{-1}$ and statement III is false too.\n\nTherefore, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186302825 :knowledge-point/_questions [{:knowledge-point/id #uuid "9b9ef325-2358-5041-8a8d-b459e8ed9f09" :knowledge-point/title "Determining the Inverse of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ca043124-609a-59f3-b3db-80d190b5edcf" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186302827} {:answer/id #uuid "30efe924-4c98-5324-89ce-a8ceab358f30" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186302828} {:answer/id #uuid "c1b10f1d-cd0b-5a25-b24e-bc59ff406c86" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186302829} {:answer/id #uuid "1cee3227-419b-52dc-85fc-710df84274b8" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186302830} {:answer/id #uuid "65