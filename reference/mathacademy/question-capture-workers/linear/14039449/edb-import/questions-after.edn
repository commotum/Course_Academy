1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nLikewise, computing $CB$, we get\n\n$$\n\\begin{aligned}CB & =[\\begin{aligned}0 & -\\frac{1}{2} & -1 \\\\ 0 & \\frac{1}{2} & 0 \\\\ 1 & \\frac{1}{2} & 1\\end{aligned}][\\begin{aligned}1 & 0 & 1 \\\\ 0 & 2 & 0 \\\\ -1 & -1 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nSo, statement II is true.\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186282084 :knowledge-point/_questions [{:knowledge-point/id #uuid "a75c67e5-3469-5730-9181-54df4ec6d5b2" :knowledge-point/title "Determining the Inverse of a Larger Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40dc8cd5-8acf-5926-8c3a-92d1b4bd1131" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186282086} {:answer/id #uuid "c440b37b-ab2b-5063-89ff-f7c31bc39b11" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186282087} {:answer/id #uuid "4f926357-0eb0-52c2-8d2f-13ec05273812" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186282088} {:answer/id #uuid "8964cb6e-6229-58ad-9ebf-5919c6b6ea8c" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186282089} {:answer/id #uuid "7b7932e2-fbf0-5dc6-8e5f-54b23b150c48" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186282090}] :answer-field/correct {:answer/id #uuid "40dc8cd5-8acf-5926-8c3a-92d1b4bd1131" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186282086} :answer-field/id #uuid "5c2ce841-181d-5659-9d6f-388d4545c13a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186282085}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "844ae92f-8c0f-52d1-8608-6350213d5537" :question/math-academy-id "q-7907" :question/problem "Consider the matrices\n\n$$\nB=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -4 & 1\\end{aligned}],\\,C=\\frac{1}{15}[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -4 & 1\\end{aligned}],\\,D=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 4 & 1\\end{aligned}].\n$$\n\nWhich of the following statements are true?\n\n- $BC=CB={I}_{3}$\n- $BD=DB={I}_{3}$\n- $D={B}^{-1}$" :question/worked-solution "- First, we check whether $BC=CB={I}_{3}.$ Computing $BC$, we get\n\n$$\n\\begin{aligned}BC & =\\frac{1}{15}[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -4 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -4 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{15} & ∗ & ∗ \\\\ ∗ & ∗ & ∗ \\\\ ∗ & ∗ & ∗\\end{aligned}] \\\\  & \\ne {I}_{3}.\\,\\times \\end{aligned}\n$$\n\nSo, statement I is false.\n\n- Note, we check whether $BD=DB={I}_{3}.$ Computing $BD$, we get\n\n$$\n\\begin{aligned}BD & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -4 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 4 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nLikewise, computing $DB$, we get\n\n$$\n\\begin{aligned}DB & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 4 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -4 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nSo, statement II is true. As a result, $D={B}^{-1}$ and statement III is true too.\n\nTherefore, the correct answer is \"II and III only\"."}]}
