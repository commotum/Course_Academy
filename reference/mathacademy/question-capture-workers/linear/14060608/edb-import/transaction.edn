4aeae2f725d" :answer/id #uuid "7110120b-b1b7-5c7c-9ebb-86992df8a86f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78302/selection/16d4141643bd2732b6c3d76b14744e546aa05b4bdaa0e7f60defb96106f3c9a9" :answer/id #uuid "7bf23604-bb13-58cc-8506-6641e9d53196" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78302/selection" :answer-field/id #uuid "cecc8867-93ee-5695-aec1-982b7d2707ed" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-78302/selection/870cc5df514b212a33382339d57a8f1736472f2a2dae5305ee0150222d5d3e47" :answer-field/choices ["q-78302/selection/870cc5df514b212a33382339d57a8f1736472f2a2dae5305ee0150222d5d3e47" "q-78302/selection/2389d22ac96573ae4abd1dab5d118d9b28b57ad1e9feea801c16b42019c2ef8a" "q-78302/selection/65b9637c0afe12708a3772402a0c07eca95c1f147bf1ad07d091bc17f76dfd4d" "q-78302/selection/eed85fff1c310132f0359c50f92366bdd4fa19a46b8ed174cc9094aeae2f725d" "q-78302/selection/16d4141643bd2732b6c3d76b14744e546aa05b4bdaa0e7f60defb96106f3c9a9"] :db/ensure [:answer-field/validate]} {:db/id "q-78302" :question/id #uuid "a51c70cd-319b-5de1-a71f-816af37c3370" :question/math-academy-id "q-78302" :question/problem "Which of the following represents a reflection in the line $y=-x?$" :question/worked-solution "The correct answer is $T=[\\begin{aligned}0 & -1 \\\\ -1 & 0\\end{aligned}].$ Indeed, consider the standard basis ${i,j}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors, as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060608/assets/9e322e6ed1ddb8f1d094633e931cd179b7eb9d6f47acd7c7d0809f113df91b22.png)\n\nNow, we can find the images of ${i,j}$ under $T$, as follows:\n\n$$\n\\begin{aligned}{i}^{′} & =T(i)=[\\begin{aligned}0 & -1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}0 \\\\ -1\\end{aligned}]=-j \\\\ {j}^{′} & =T(j)=[\\begin{aligned}0 & -1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0\\end{aligned}]=-i\\end{aligned}\n$$\n\nTherefore, we obtain the following image:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060608/assets/4a83673a409fd2e5d33b0b5f743f57af08cfb27c38e312a636179102c2172b04.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-78302/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cf99414e-f1cf-528f-adbb-407cf6e82c4c"] :knowledge-point/questions ["q-78302"] :db/ensure [:knowledge-point/validate]} {:db/id "q-78301/selection/870cc5df514b212a33382339d57a8f1736472f2a2dae5305ee0150222d5d3e47" :answer/id #uuid "d5ed3328-c7a4-5bf3-8087-947b079fa46b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & -1 \\\\ -1 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78301/selection/2389d22ac96573ae4abd1dab5d118d9b28b57ad1e9feea801c16b42019c2ef8a" :answer/id #uuid "a90a0b84-9f32-5dbe-a7ae-d285e9287e44" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78301/selection/eed85fff1c310132f0359c50f92366bdd4fa19a46b8ed174cc9094aeae2f725d" :answer/id #uuid "c76fcb16-1af1-5e77-a170-608a3f6fe97e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78301/selection/16d4141643bd2732b6c3d76b14744e546aa05b4bdaa0e7f60defb96106f3c9a9" :answer/id #uuid "878d8b5a-332e-57b8-ad3f-4a150d6d1701" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78301/selection/65b9637c0afe12708a3772402a0c07eca95c1f147bf1ad07d091bc17f76dfd4d" :answer/id #uuid "a0599022-189a-5283-b4c2-f1dcc5c4c096" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78301/selection" :answer-field/id #uuid "4f6c406f-d5be-58bb-91fb-2f154d007181" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-78301/selection/16d4141643bd2732b6c3d76b14744e546aa05b4bdaa0e7f60defb96106f3c9a9" :answer-field/choices ["q-78301/selection/870cc5df514b212a33382339d57a8f1736472f2a2dae5305ee0150222d5d3e47" "q-78301/selection/2389d22ac96573ae4abd1dab5d118d9b28b57ad1e9feea801c16b42019c2ef8a" "q-78301/selection/eed85fff1c310132f0359c50f92366bdd4fa19a46b8ed174cc9094aeae2f725d" "q-78301/selection/16d4141643bd2732b6c3d76b14744e546aa05b4bdaa0e7f60defb96106f3c9a9" "q-78301/selection/65b9637c0afe12708a3772402a0c07eca95c1f147bf1ad07d091bc17f76dfd4d"] :db/ensure [:answer-field/validate]} {:db/id "q-78301" :question/id #uuid "184c771a-5e73-5330-965f-3d9f2f0e7498" :question/math-academy-id "q-78301" :question/problem "Which of the following represents a reflection in the line $y=x?$" :question/worked-solution "The correct answer is $T=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}].$ Indeed, consider the standard basis ${i,j}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors, as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060608/assets/9e322e6ed1ddb8f1d094633e931cd179b7eb9d6f47acd7c7d0809f113df91b22.png)\n\nNow, we can find the images of ${i,j}$ under $T$, as follows:\n\n$$\n\\begin{aligned}{i}^{′} & =T(i)=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}0 \\\\ 1\\end{aligned}]=j \\\\ {j}^{′} & =T(j)=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}1 \\\\ 0\\end{aligned}]=i\\end{aligned}\n$$\n\nTherefore, we obtain the following image:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060608/assets/0e37a258ea833a2d490fc34a34af40a5c7a18f7589f107c6d0ed631b331c8f2a.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-78301/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cf99414e-f1cf-528f-adbb-407cf6e82c4c"] :knowledge-point/questions ["q-78301"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-5452"] :question/problem "A linear transformation $\\mathbf{T}$ represents a dilation. Given that ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060608/assets/bd6574ee05b60919de656a889f8532e5a512b381eae63f7a65f251a7afe72738.png) and ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060608/assets/be73c2a933a6fb99eaa389774a618848bdadd9cafdf0fcd2f6af126b49b87707.png) what is the standard matrix of $\\mathbf{T}?$" :question/worked-solution "We can write $\\mathbf{T}(\\mathbf{v})$ as follows:\n\n$$\n\\begin{aligned}T(v) & =[\\begin{aligned}6 \\\\ 4\\end{aligned}] \\\\  & =\\frac{1}{4}\\cdot [\\begin{aligned}24 \\\\ 16\\end{aligned}] \\\\  & =\\frac{1}{4}v\\end{aligned}\n$$\n\nSince we have $\\mathbf{T}(\\mathbf{v}) = \\dfrac{1}{4}\\mathbf{v},$ we conclude that the linear transformation $\\mathbf T$ is a dilation with scale factor $k = \\dfrac{1}{4}.$\n\nRemember that the matrix representing a dilation of scale factor $k$ is given by\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060608/assets/4866597a50fbdb530e9275c77f2ca926c932c7cc334635bd05191aaddd510d75.png)\n\nTherefore, the standard matrix of $\\mathbf{T}$ is\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060608/assets/962b9458714f9b7f6b17fe2259e140dfabba443d8ecb5b9e2328172ab3f8a1a2.png)" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5451"] :question/problem "What linear transformation is represented by the matrix\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060608/assets/0394b5d3a371caf95d5e701c0ffb00894eb685e706d8b70af2149057de0b0cb5.png)" :question/worked-solution "Consider the standard basis $\\{ \\mathbf{i},\\mathbf{j} \\}$ of the Euclidean plane $\\mathbb{R}^2$ and the unit square spanned by the vectors, as depicted below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060608/assets/9e322e6ed1ddb8f1d094633e931cd179b7eb9d6f47acd7c7d0809f113df91b22.png)\n\nWe can find the images of $\\{ \\mathbf{i},\\mathbf{j} \\}$ under $T,$ as follows:\n\n$$\n\\begin{aligned}{i}^{′} & =T(i)=[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}1 \\\\ 0\\end{aligned}]=i \\\\ {j}^{′} & =T(j)=[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}0 \\\\ -1\\end{aligned}]=-j\\end{aligned}\n$$\n\nThen, we obtain the following image:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060608/assets/b93bb91dae85a3e3b40a8d0ade3d4f420064aaa6926431fa7f664c977bb8fd59.png)\n\nTherefore, the matrix represents the reflection across the $x$-axis." :db/ensure [:question/validate]}]
