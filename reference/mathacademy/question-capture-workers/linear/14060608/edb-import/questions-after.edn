wer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186340008} {:answer-field/choices [{:answer/id #uuid "c969b756-e474-5464-ac69-454ade1eecc6" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186340011}] :answer-field/correct {:answer/id #uuid "c969b756-e474-5464-ac69-454ade1eecc6" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186340011} :answer-field/id #uuid "9f8272c7-a7ab-544e-b2be-56def18287f9" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186340010}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b6aca598-d6fd-5c6e-b244-73c44aeee7a4" :question/math-academy-id "q-328222" :question/problem "A  linear transformation $T$ represents a dilation. Given that $v=[\\begin{aligned}-3 \\\\ -2\\end{aligned}]$ and $T(v)=[\\begin{aligned}-12 \\\\ -8\\end{aligned}],$ what is the standard matrix $T$ of $T?$\n\n| $T=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |" :question/worked-solution "We can write $T(v)$ as follows:\n\n$$\n\\begin{aligned}T(v) & =[\\begin{aligned}-12 \\\\ -8\\end{aligned}] \\\\  & =4\\cdot [\\begin{aligned}-3 \\\\ -2\\end{aligned}] \\\\  & =4v\\end{aligned}\n$$\n\nSo we have $T(v)=4v,$ and so the linear transformation $T$ is a dilation with scale factor $k=4.$\n\nThe matrix that represents a dilation of scale factor $k$ is given by\n\n$$\n[\\begin{aligned}k & 0 \\\\ 0 & k\\end{aligned}].\n$$\n\nTherefore, the standard matrix of $T$ is\n\n$$\nT=[\\begin{aligned}4 & 0 \\\\ 0 & 4\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186340012 :knowledge-point/_questions [{:knowledge-point/id #uuid "166cd7e4-5568-5769-8bc6-4ffc4ed8b508" :knowledge-point/title "Finding the Standard Matrix of a Dilation Given a Vector and its Image"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ccc318ac-1320-5010-b665-564cb7b3c33c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & 1 \\\\ 1 & 7\\end{aligned}]" :db/id #edb/ref 17592186340014} {:answer/id #uuid "7d497299-7007-51d9-8099-e2156203666b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 7 \\\\ 7 & 0\\end{aligned}]" :db/id #edb/ref 17592186340015} {:answer/id #uuid "8da2bd9d-f18a-5c78-91c7-7bdf0c96fa8b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}17 & 1 \\\\ -7 & 17\\end{aligned}]" :db/id #edb/ref 17592186340016} {:answer/id #uuid "910a3f59-5d46-5d4a-8653-edb6aaf08c53" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}17 & 17 \\\\ 17 & 17\\end{aligned}]" :db/id #edb/ref 17592186340017} {:answer/id #uuid "727f8944-8375-531d-a201-1a83d1026e8d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}17 & 0 \\\\ 0 & 17\\end{aligned}]" :db/id #edb/ref 17592186340018}] :answer-field/correct {:answer/id #uuid "727f8944-8375-531d-a201-1a83d1026e8d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}17 & 0 \\\\ 0 & 17\\end{aligned}]" :db/id #edb/ref 17592186340018} :answer-field/id #uuid "4d7f824c-b827-506f-a064-0f502fcfbaa1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340013}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ce9fd52a-eff4-5470-8dd1-42e7a1e8d09d" :question/math-academy-id "q-78246" :question/problem "A linear transformation $T$ represents a dilation.  Given that $v=[\\begin{aligned}-5 \\\\ -7\\end{aligned}]$ and $T(v)=[\\begin{aligned}-85 \\\\ -119\\end{aligned}],$ what is the standard matrix of $T?$" :question/worked-solution "We can write $T(v)$ as follows:\n\n$$\n\\begin{aligned}T(v) & =[\\begin{aligned}-85 \\\\ -119\\end{aligned}] \\\\  & =17\\cdot [\\begin{aligned}-5 \\\\ -7\\end{aligned}] \\\\  & =17v\\end{aligned}\n$$\n\nSo we have $T(v)=17v,$ and so the linear transformation $T$ is a dilation with scale factor $k=17.$\n\nThe matrix that represents a dilation of scale factor $k$ is given by\n\n$$\n[\\begin{aligned}k & 0 \\\\ 0 & k\\end{aligned}].\n$$\n\nTherefore, the standard matrix of $T$ is\n\n$$\nT=[\\begin{aligned}17 & 0 \\\\ 0 & 17\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186340019 :knowledge-point/_questions [{:knowledge-point/id #uuid "166cd7e4-5568-5769-8bc6-4ffc4ed8b508" :knowledge-point/title "Finding the Standard Matrix of a Dilation Given a Vector and its Image"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90ef9595-d847-5979-b71e-b922289814ca" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & \\frac{1}{3} \\\\ \\frac{1}{3} & 0\\end{aligned}]" :db/id #edb/ref 17592186340021} {:answer/id #uuid "c23ae6f6-900c-5bd1-8087-ccba66e5857d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{3} & 1 \\\\ 1 & \\frac{1}{3}\\end{aligned}]" :db/id #edb/ref 17592186340022} {:answer/id #uuid "2c352065-6a0b-57d8-84fd-6bc3a2ba0559" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{3} & 0 \\\\ 0 & \\frac{1}{3}\\end{aligned}]" :db/id #edb/ref 17592186340023} {:answer/id #uuid "cec459f5-195c-5c54-9b15-cd6da891c1a8" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 1 \\\\ 1 & 3\\end{aligned}]" :db/id #edb/ref 17592186340024} {:answer/id #uuid "a46eb332-be83-5ff3-a8ae-aadebd540835" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 0 \\\\ 0 & 3\\end{aligned}]" :db/id #edb/ref 17592186340025}] :answer-field/correct {:answer/id #uuid "2c352065-6a0b-57d8-84fd-6bc3a2ba0559" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{3} & 0 \\\\ 0 & \\frac{1}{3}\\end{aligned}]" :db/id #edb/ref 17592186340023} :answer-field/id #uuid "ea9b7365-4078-5822-81fa-131f2d46bfdf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340020}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9e22d249-389a-52e9-bbc0-d4b4de64dd64" :question/math-academy-id "q-78253" :question/problem "A linear transformation $T$ represents a dilation.  Given that $v=[\\begin{aligned}-60 \\\\ -9\\end{aligned}]$ and $T(v)=[\\begin{aligned}-20 \\\\ -3\\end{aligned}],$ what is the standard matrix of $T?$" :question/worked-solution "We can write $T(v)$ as follows:\n\n$$\n\\begin{aligned}T(v) & =[\\begin{aligned}-20 \\\\ -3\\end{aligned}] \\\\  & =\\frac{1}{3}\\cdot [\\begin{aligned}-60 \\\\ -9\\end{aligned}] \\\\  & =\\frac{1}{3}v\\end{aligned}\n$$\n\nSo we have $T(v)=\\frac{1}{3}v,$ and so the linear transformation $T$ is a dilation with scale factor $k=\\frac{1}{3}.$\n\nThe matrix that represents a dilation of scale factor $k$ is given by\n\n$$\n[\\begin{aligned}k & 0 \\\\ 0 & k\\end{aligned}].\n$$\n\nTherefore, the standard matrix of $T$ is\n\n$$\nT=[\\begin{aligned}\\frac{1}{3} & 0 \\\\ 0 & \\frac{1}{3}\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186340026 :knowledge-point/_questions [{:knowledge-point/id #uuid "cf99414e-f1cf-528f-adbb-407cf6e82c4c" :knowledge-point/title "Identifying the Linear Transformation Represented by a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "878d8b5a-332e-57b8-ad3f-4a150d6d1701" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]" :db/id #edb/ref 17592186340028} {:answer/id #uuid "a90a0b84-9f32-5dbe-a7ae-d285e9287e44" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186340029} {:answer/id #uuid "a0599022-189a-5283-b4c2-f1dcc5c4c096" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186340030} {:answer/id #uuid "d5ed3328-c7a4-5bf3-8087-947b079fa46b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & -1 \\\\ -1 & 0\\end{aligned}]" :db/id #edb/ref 17592186340031} {:answer/id #uuid "c76fcb16-1af1-5e77-a170-608a3f6fe97e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186340032}] :answer-field/correct {:answer/id #uuid "878d8b5a-332e-57b8-ad3f-4a150d6d1701" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]" :db/id #edb/ref 17592186340028} :answer-field/id #uuid "4f6c406f-d5be-58bb-91fb-2f154d007181" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340027}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "184c771a-5e73-5330-965f-3d9f2f0e7498" :question/math-academy-id "q-78301" :question/problem "Which of the following represents a reflection in the line $y=x?$" :question/worked-solution "The correct answer is $T=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}].$ Indeed, consider the standard basis ${i,j}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors, as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060608/assets/9e322e6ed1ddb8f1d094633e931cd179b7eb9d6f47acd7c7d0809f113df91b22.png)\n\nNow, we can find the images of ${i,j}$ under $T$, as follows:\n\n$$\n\\begin{aligned}{i}^{′} & =T(i)=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}0 \\\\ 1\\end{aligned}]=j \\\\ {j}^{′} & =T(j)=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}1 \\\\ 0\\end{aligned}]=i\\end{aligned}\n$$\n\nTherefore, we obtain the following image:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060608/assets/0e37a258ea833a2d490fc34a34af40a5c7a18f7589f107c6d0ed631b331c8f2a.png)"}] [{:db/id #edb/ref 17592186340033 :knowledge-point/_questions [{:knowledge-point/id #uuid "cf99414e-f1cf-528f-adbb-407cf6e82c4c" :knowledge-point/title "Identifying the Linear Transformation Represented by a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7bf23604-bb13-58cc-8506-6641e9d53196" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]" :db/id #edb/ref 17592186340035} {:answer/id #uuid "6e1126d0-a5c0-512c-b1c1-3e07adfb0694" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186340036} {:answer/id #uuid "eaa614ad-6ab5-546f-8394-f45dfa3068b9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186340037} {:answer/id #uuid "f9c677ca-346c-53de-bd6e-1c4347c4b195" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & -1 \\\\ -1 & 0\\end{aligned}]" :db/id #edb/ref 17592186340038} {:answer/id #uuid "7110120b-b1b7-5c7c-9ebb-86992df8a86f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186340039}] :answer-field/correct {:answer/id #uuid "f9c677ca-346c-53de-bd6e-1c4347c4b195" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & -1 \\\\ -1 & 0\\end{aligned}]" :db/id #edb/ref 17592186340038} :answer-field/id #uuid "cecc8867-93ee-5695-aec1-982b7d2707ed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340034}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "a51c70cd-319b-5de1-a71f-816af37c3370" :question/math-academy-id "q-78302" :question/problem "Which of the following represents a reflection in the line $y=-x?$" :question/worked-solution "The correct answer is $T=[\\begin{aligned}0 & -1 \\\\ -1 & 0\\end{aligned}].$ Indeed, consider the standard basis ${i,j}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors, as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060608/assets/9e322e6ed1ddb8f1d094633e931cd179b7eb9d6f47acd7c7d0809f113df91b22.png)\n\nNow, we can find the images of ${i,j}$ under $T$, as follows:\n\n$$\n\\begin{aligned}{i}^{′} & =T(i)=[\\begin{aligned}0 & -1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}0 \\\\ -1\\end{aligned}]=-j \\\\ {j}^{′} & =T(j)=[\\begin{aligned}0 & -1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0\\end{aligned}]=-i\\end{aligned}\n$$\n\nTherefore, we obtain the following image:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060608/assets/4a83673a409fd2e5d33b0b5f743f57af08cfb27c38e312a636179102c2172b04.png)"}] [{:db/id #edb/ref 17592186340040 :knowledge-point/_questions [{:knowledge-point/id #uuid "cf99414e-f1cf-528f-adbb-407cf6e82c4c" :knowledge-point/title "Identifying the Linear Transformation Represented by a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26b7b347-c6b2-5d74-aac4-2e7a5cc58499" :answer/type {:db/ident :answer.type/text} :answer/value "Reflection across the $x$-axis" :db/id #edb/ref 17592186340042} {:answer/id #uuid "915e9cf5-f84b-51eb-b1e7-e8e7cfe49532" :answer/type {:db/ident :answer.type/text} :answer/value "Dilation with scale factor $7$" :db/id #edb/ref 17592186340043} {:answer/id #uuid "3816d20e-19e5-5888-a70c-0dcf36d68d32" :answer/type {:db/ident :answer.type/text} :answer/value "Reflection in the line $x=7$" :db/id #edb/ref 17592186340044} {:answer/id #uuid "797910a5-edfe-55a1-ab8c-07362f943a1b" :answer/type {:db/ident :answer.type/text} :answer/value "Reflection across the $y$-axis" :db/id #edb/ref 17592186340045} {:answer/id #uuid "93db7508-1051-5730-b155-6c24c024cea0" :answer/type {:db/ident :answer.type/text} :answer/value "Dilation with scale factor $\\frac{1}{7}$" :db/id #edb/ref 17592186340046}] :answer-field/correct {:answer/id #uuid "915e9cf5-f84b-51eb-b1e7-e8e7cfe49532" :answer/type {:db/ident :answer.type/text} :answer/value "Dilation with scale factor $7$" :db/id #edb/ref 17592186340043} :answer-field/id #uuid "3b64b693-2979-51cd-91d4-04d9bcbcf76e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340041}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "762395a3-9b52-5e28-b68b-fdb205195ab3" :question/math-academy-id "q-8087" :question/problem "What linear transformation $T$ is represented by the matrix $T=[\\begin{aligned}7 & 0 \\\\ 0 & 7\\end{aligned}]?$" :question/worked-solution "Recall that a dilation of scale factor $k$ is represented by the matrix\n\n$$\n[\\begin{aligned}k & 0 \\\\ 0 & k\\end{aligned}].\n$$\n\nHere, we have $k=7.$ Therefore, the matrix represents a dilation with a scale factor of $7.$"}]}
