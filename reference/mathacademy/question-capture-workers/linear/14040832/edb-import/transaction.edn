g cofactor expansion along the $1$st row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}0 & 0 & 3 & 0 \\\\ 1 & 2 & 1 & -1 \\\\ 0 & 1 & 2 & 0 \\\\ 2 & -1 & 0 & 3\\end{aligned}| & =0\\cdot {C}_{11}+0\\cdot {C}_{12}+3\\cdot {C}_{13}+0\\cdot {C}_{14} \\\\  & =3\\cdot (-1)^{1+3}\\cdot |\\begin{aligned}1 & 2 & -1 \\\\ 0 & 1 & 0 \\\\ 2 & -1 & 3\\end{aligned}| \\\\  & =3|\\begin{aligned}1 & 2 & -1 \\\\ 0 & 1 & 0 \\\\ 2 & -1 & 3\\end{aligned}|.\\end{aligned}\n$$\n\nNow, computing the $3\\times 3$ determinant by applying a Laplace expansion along the $2$nd row, we obtain:\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & -2 & -1 \\\\ 0 & 1 & 0 \\\\ 2 & -1 & 3\\end{aligned}| & =0\\cdot {C}_{21}+1\\cdot {C}_{22}+0\\cdot {C}_{23} \\\\  & =1\\cdot (-1)^{2+2}\\cdot |\\begin{aligned}1 & -1 \\\\ 2 & 3\\end{aligned}| \\\\  & =|\\begin{aligned}1 & -1 \\\\ 2 & 3\\end{aligned}| \\\\  & =3+2 \\\\  & =5\\end{aligned}\n$$\n\nTherefore,\n\n$$\n|\\begin{aligned}0 & 0 & 3 & 0 \\\\ 1 & 2 & 1 & -1 \\\\ 0 & 1 & 2 & 0 \\\\ 2 & -1 & 0 & 3\\end{aligned}|=3\\cdot 5=15.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-70108/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d1637e23-6566-5e45-af4c-b27333f882d1"] :knowledge-point/questions ["q-70108"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70109/selection/cee37ae0a2921bd3973a5cb0592c822dbbfafcfefba8d7007910ead797b9112f" :answer/id #uuid "65e33c62-4830-518a-aeeb-423f7f5aca40" :answer/type :answer.type/math :answer/value "48" :db/ensure [:answer/validate]} {:db/id "q-70109/selection/4f1ffa38d73b18554a47d8d9cea1139f02bb33ce8900fc955ea927ce75c224e3" :answer/id #uuid "d4599ba1-8a4a-5cfb-af5e-7fa2b66ba320" :answer/type :answer.type/math :answer/value "62" :db/ensure [:answer/validate]} {:db/id "q-70109/selection/879a225aaf1b8272157c33247ace982b7e338d5701ba0d4d6c31dd38d4da6784" :answer/id #uuid "a8263dae-1961-50ce-a3c0-aa6b48e48fcd" :answer/type :answer.type/math :answer/value "56" :db/ensure [:answer/validate]} {:db/id "q-70109/selection/bdda2450817a39aa33f63c44268d508ac25aa607d31de284a7a3098288a61525" :answer/id #uuid "a14133d7-d56e-53ab-b1b6-a82a5b3d77d6" :answer/type :answer.type/math :answer/value "72" :db/ensure [:answer/validate]} {:db/id "q-70109/selection/2671fdc3a44bd3421ded09be4e881743067a96eb4e584e442a30f737593eae71" :answer/id #uuid "0083ab03-f418-54bc-b77c-011523add475" :answer/type :answer.type/math :answer/value "38" :db/ensure [:answer/validate]} {:db/id "q-70109/selection" :answer-field/id #uuid "531f8204-f26a-5f24-9fc5-4dec7edde1d3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-70109/selection/879a225aaf1b8272157c33247ace982b7e338d5701ba0d4d6c31dd38d4da6784" :answer-field/choices ["q-70109/selection/cee37ae0a2921bd3973a5cb0592c822dbbfafcfefba8d7007910ead797b9112f" "q-70109/selection/4f1ffa38d73b18554a47d8d9cea1139f02bb33ce8900fc955ea927ce75c224e3" "q-70109/selection/879a225aaf1b8272157c33247ace982b7e338d5701ba0d4d6c31dd38d4da6784" "q-70109/selection/bdda2450817a39aa33f63c44268d508ac25aa607d31de284a7a3098288a61525" "q-70109/selection/2671fdc3a44bd3421ded09be4e881743067a96eb4e584e442a30f737593eae71"] :db/ensure [:answer-field/validate]} {:db/id "q-70109" :question/id #uuid "51530761-8765-59bf-9fe1-f2c72e1c8f5f" :question/math-academy-id "q-70109" :question/problem "Compute the following determinant using a cofactor expansion along the $4$th row:\n\n$$\n|\\begin{aligned}1 & 4 & 3 & 1 \\\\ 1 & 2 & 0 & 0 \\\\ 0 & 1 & 2 & 3 \\\\ 4 & 0 & 0 & 0\\end{aligned}|.\n$$" :question/worked-solution "Using cofactor expansion along the $4$th row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 4 & 3 & 1 \\\\ 1 & 2 & 0 & 0 \\\\ 0 & 1 & 2 & 3 \\\\ 4 & 0 & 0 & 0\\end{aligned}| & =4\\cdot {C}_{41}+0\\cdot {C}_{42}+0\\cdot {C}_{43}+0\\cdot {C}_{44} \\\\  & =4\\cdot (-1)^{4+1}\\cdot |\\begin{aligned}4 & 3 & 1 \\\\ 2 & 0 & 0 \\\\ 1 & 2 & 3\\end{aligned}| \\\\  & =-4|\\begin{aligned}4 & 3 & 1 \\\\ 2 & 0 & 0 \\\\ 1 & 2 & 3\\end{aligned}|.\\end{aligned}\n$$\n\nNow, computing the $3\\times 3$ determinant by applying a Laplace expansion along the $2$nd row, we obtain:\n\n$$\n\\begin{aligned}|\\begin{aligned}4 & 3 & 1 \\\\ 2 & 0 & 0 \\\\ 1 & 2 & 3\\end{aligned}| & =2\\cdot {C}_{21}+0\\cdot {C}_{22}+0\\cdot {C}_{23} \\\\  & =2\\cdot (-1)^{2+1}\\cdot |\\begin{aligned}3 & 1 \\\\ 2 & 3\\end{aligned}| \\\\  & =-2|\\begin{aligned}3 & 1 \\\\ 2 & 3\\end{aligned}| \\\\  & =-2(9-2) \\\\  & =-14\\end{aligned}\n$$\n\nTherefore,\n\n$$\n|\\begin{aligned}1 & 4 & 3 & 1 \\\\ 1 & 2 & 0 & 0 \\\\ 0 & 1 & 2 & 3 \\\\ 4 & 0 & 0 & 0\\end{aligned}|=-4\\cdot (-14)=56.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-70109/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d1637e23-6566-5e45-af4c-b27333f882d1"] :knowledge-point/questions ["q-70109"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70133/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "1c231934-6584-57b8-ac43-c0e7f685c418" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-70133/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer/id #uuid "fcf49848-68aa-575a-bfce-4238ebdd14bf" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "q-70133/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "7053da08-4864-5c3f-a287-a36a946f9372" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-70133/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "06166dd0-1fe2-5cc4-a2bf-01e656baf5cd" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-70133/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "e63eee5d-0b0f-57b9-ac5e-3648a128d80a" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-70133/selection" :answer-field/id #uuid "9c0c259b-2449-503b-ae64-4d8fb9a4423f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-70133/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer-field/choices ["q-70133/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" "q-70133/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" "q-70133/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" "q-70133/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" "q-70133/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53"] :db/ensure [:answer-field/validate]} {:db/id "q-70133" :question/id #uuid "82444eda-7c10-5fb4-8db7-2e302de54e6c" :question/math-academy-id "q-70133" :question/problem "Calculate\n$|\\begin{aligned}2 & 1 & -2 & 3 \\\\ -1 & -1 & 2 & 0 \\\\ 0 & 1 & 1 & 1 \\\\ 2 & 0 & 0 & 3\\end{aligned}|.$" :question/worked-solution "The $4$th row of the given matrix contains two zeros, more than any other row. So, using a Laplace expansion along the $4$th row, we have   \n\n$$\n\\begin{aligned}|\\begin{aligned}2 & 1 & -2 & 3 \\\\ -1 & -1 & 2 & 0 \\\\ 0 & 1 & 1 & 1 \\\\ 2 & 0 & 0 & 3\\end{aligned}| & =2\\cdot {C}_{41}+0\\cdot {C}_{42}+0\\cdot {C}_{43}+3\\cdot {C}_{44} \\\\  & =2\\cdot (-1)^{4+1}\\cdot |\\begin{aligned}1 & -2 & 3 \\\\ -1 & 2 & 0 \\\\ 1 & 1 & 1\\end{aligned}|+3\\cdot (-1)^{4+4}\\cdot |\\begin{aligned}2 & 1 & -2 \\\\ -1 & -1 & 2 \\\\ 0 & 1 & 1\\end{aligned}| \\\\  & =-2|\\begin{aligned}1 & -2 & 3 \\\\ -1 & 2 & 0 \\\\ 1 & 1 & 1\\end{aligned}|+3|\\begin{aligned}2 & 1 & -2 \\\\ -1 & -1 & 2 \\\\ 0 & 1 & 1\\end{aligned}|.\\end{aligned}\n$$\n\nNow, computing the first $3\\times 3$  determinant by applying a Laplace expansion along the $2$nd row, we obtain:\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & -2 & 3 \\\\ -1 & 2 & 0 \\\\ 1 & 1 & 1\\end{aligned}| & =(-1)\\cdot {C}_{21}+2\\cdot {C}_{22}+0\\cdot {C}_{23} \\\\  & =(-1)\\cdot (-1)^{2+1}\\cdot |\\begin{aligned}-2 & 3 \\\\ 1 & 1\\end{aligned}|+2\\cdot (-1)^{2+2}\\cdot |\\begin{aligned}1 & 3 \\\\ 1 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}-2 & 3 \\\\ 1 & 1\\end{aligned}|+2|\\begin{aligned}1 & 3 \\\\ 1 & 1\\end{aligned}| \\\\  & =(-2-3)+2(1-3) \\\\  & =-5+2\\cdot (-2) \\\\  & =-9\\end{aligned}\n$$\n\nFinally, we compute the second $3\\times 3$ determinant by applying a Laplace expansion along its $3$rd row:\n\n$$\n\\begin{aligned}|\\begin{aligned}2 & 1 & -2 \\\\ -1 & -1 & 2 \\\\ 0 & 1 & 1\\end{aligned}| & =0\\cdot {C}_{31}+1\\cdot {C}_{32}+1\\cdot {C}_{33} \\\\  & =1\\cdot (-1)^{3+2}\\cdot |\\begin{aligned}2 & -2 \\\\ -1 & 2\\end{aligned}|+1\\cdot (-1)^{3+3}\\cdot |\\begin{aligned}2 & 1 \\\\ -1 & -1\\end{aligned}| \\\\  & =-|\\begin{aligned}2 & -2 \\\\ -1 & 2\\end{aligned}|+|\\begin{aligned}2 & 1 \\\\ -1 & -1\\end{aligned}| \\\\  & =-(4-2)+(-2+1) \\\\  & =-2+(-1) \\\\  & =-3\\end{aligned}\n$$\n\nTherefore,\n\n$$\n|\\begin{aligned}2 & 1 & -2 & 3 \\\\ -1 & -1 & 2 & 0 \\\\ 0 & 1 & 1 & 1 \\\\ 2 & 0 & 0 & 3\\end{aligned}|=-2\\cdot (-9)+3\\cdot (-3)=18-9=9.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-70133/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d1637e23-6566-5e45-af4c-b27333f882d1"] :knowledge-point/questions ["q-70133"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70128/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "ea4fdcc7-0c89-5a51-a1e5-9a7d44340bb5" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-70128/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "06b66420-a83b-54e7-8d9f-6daa997cf057" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-70128/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "eaf3bae0-4587-571f-833d-603dc165eaf0" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-70128/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "ff90cc2f-8aa8-5cc2-b795-5f0ee8d9fd41" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-70128/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer/id #uuid "28bdb29b-ada1-5ca0-834d-d618dfcc8a65" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "q-70128/selection" :answer-field/id #uuid "1e39cdb9-1132-5003-a0b7-74420f01bd6e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-70128/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer-field/choices ["q-70128/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" "q-70128/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-70128/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" "q-70128/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-70128/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96"] :db/ensure [:answer-field/validate]} {:db/id "q-70128" :question/id #uuid "bd7d3e76-f528-5065-b591-2bc192b9c16d" :question/math-academy-id "q-70128" :question/problem "Calculate\n$|\\begin{aligned}0 & 1 & 2 & -1 \\\\ 0 & -1 & 0 & 1 \\\\ 2 & 3 & 1 & 1 \\\\ 2 & 0 & -3 & 3\\end{aligned}|.$" :question/worked-solution "The $2$nd row of the given matrix contains two zeros, more than any other row. So, using a Laplace expansion along the $2$nd row, we have   \n\n$$\n\\begin{aligned}|\\begin{aligned}0 & 1 & 2 & -1 \\\\ 0 & -1 & 0 & 1 \\\\ 2 & 3 & 1 & 1 \\\\ 2 & 0 & -3 & 3\\end{aligned}| & =0\\cdot {C}_{21}+(-1)\\cdot {C}_{22}+0\\cdot {C}_{23}+1\\cdot {C}_{24} \\\\  & =(-1)\\cdot (-1)^{2+2}\\cdot |\\begin{aligned}0 & 2 & -1 \\\\ 2 & 1 & 1 \\\\ 2 & -3 & 3\\end{aligned}|+1\\cdot (-1)^{2+4}\\cdot |\\begin{aligned}0 & 1 & 2 \\\\ 2 & 3 & 1 \\\\ 2 & 0 & -3\\end{aligned}| \\\\  & =-|\\begin{aligned}0 & 2 & -1 \\\\ 2 & 1 & 1 \\\\ 2 & -3 & 3\\end{aligned}|+|\\begin{aligned}0 & 1 & 2 \\\\ 2 & 3 & 1 \\\\ 2 & 0 & -3\\end{aligned}|.\\end{aligned}\n$$\n\nNow, computing the first $3\\times 3$  determinant by applying a Laplace expansion along the $1$st row, we obtain:\n\n$$\n\\begin{aligned}|\\begin{aligned}0 & 2 & -1 \\\\ 2 & 1 & 1 \\\\ 2 & -3 & 3\\end{aligned}| & =0\\cdot {C}_{11}+2\\cdot {C}_{12}+(-1)\\cdot {C}_{13} \\\\  & =2\\cdot (-1)^{1+2}\\cdot |\\begin{aligned}2 & 1 \\\\ 2 & 3\\end{aligned}|+(-1)\\cdot (-1)^{1+3}\\cdot |\\begin{aligned}2 & 1 \\\\ 2 & -3\\end{aligned}| \\\\  & =-2|\\begin{aligned}2 & 1 \\\\ 2 & 3\\end{aligned}|-|\\begin{aligned}2 & 1 \\\\ 2 & -3\\end{aligned}| \\\\  & =-2(6-2)-(-6-2) \\\\  & =-8-(-8) \\\\  & =0\\end{aligned}\n$$\n\nFinally, we compute the second $3\\times 3$ determinant by applying a Laplace expansion along the $1$st row:\n\n$$\n\\begin{aligned}|\\begin{aligned}0 & 1 & 2 \\\\ 2 & 3 & 1 \\\\ 2 & 0 & -3\\end{aligned}| & =0\\cdot {C}_{11}+1\\cdot {C}_{12}+2\\cdot {C}_{13} \\\\  & =1\\cdot (-1)^{1+2}\\cdot |\\begin{aligned}2 & 1 \\\\ 2 & -3\\end{aligned}|+(2)\\cdot (-1)^{1+3}\\cdot |\\begin{aligned}2 & 3 \\\\ 2 & 0\\end{aligned}| \\\\  & =-|\\begin{aligned}2 & 1 \\\\ 2 & -3\\end{aligned}|+2|\\begin{aligned}2 & 3 \\\\ 2 & 0\\end{aligned}| \\\\  & =-(-6-2)+2(0-6) \\\\  & =-(-8)+2\\cdot (-6) \\\\  & =8-12 \\\\  & =-4\\end{aligned}\n$$\n\nTherefore,\n\n$$\n|\\begin{aligned}1 & 2 & 1 & -1 \\\\ 0 & -4 & -2 & 1 \\\\ 2 & 0 & 0 & 1 \\\\ -3 & 1 & 2 & 0\\end{aligned}|=-0+(-4)=-4.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-70128/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d1637e23-6566-5e45-af4c-b27333f882d1"] :knowledge-point/questions ["q-70128"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-42095"] :question/problem "Calculate\n$|\\begin{aligned}1 & 2 & 1 & -1 \\\\ 0 & -4 & -2 & 1 \\\\ 2 & 0 & 0 & 1 \\\\ -3 & 1 & 2 & 0\\end{aligned}|.$" :question/worked-solution "The $3$rd row of the matrix contains two zeros, more than any other row. So using a Laplace expansion along the $3$rd row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 2 & 1 & -1 \\\\ 0 & -4 & -2 & 1 \\\\ 2 & 0 & 0 & 1 \\\\ -3 & 1 & 2 & 0\\end{aligned}| & =2\\cdot {C}_{31}+0\\cdot {C}_{32}+0\\cdot {C}_{33}+1\\cdot {C}_{34} \\\\  & =2\\cdot (-1)^{3+1}\\cdot |\\begin{aligned}2 & 1 & -1 \\\\ -4 & -2 & 1 \\\\ 1 & 2 & 0\\end{aligned}|+1\\cdot (-1)^{3+4}\\cdot |\\begin{aligned}1 & 2 & 1 \\\\ 0 & -4 & -2 \\\\ -3 & 1 & 2\\end{aligned}| \\\\  & =2|\\begin{aligned}2 & 1 & -1 \\\\ -4 & -2 & 1 \\\\ 1 & 2 & 0\\end{aligned}|-|\\begin{aligned}1 & 2 & 1 \\\\ 0 & -4 & -2 \\\\ -3 & 1 & 2\\end{aligned}|.\\end{aligned}\n$$\n\nNow, computing the first $3\\times 3$ determinant by applying a Laplace expansion along the $3$rd row, we obtain:\n\n$$\n\\begin{aligned}|\\begin{aligned}2 & 1 & -1 \\\\ -4 & -2 & 1 \\\\ 1 & 2 & 0\\end{aligned}| & =1\\cdot {C}_{31}+2\\cdot {C}_{32}+0\\cdot {C}_{33} \\\\  & =1\\cdot (-1)^{3+1}\\cdot |\\begin{aligned}1 & -1 \\\\ -2 & 1\\end{aligned}|+2\\cdot (-1)^{3+2}\\cdot |\\begin{aligned}2 & -1 \\\\ -4 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}1 & -1 \\\\ -2 & 1\\end{aligned}|-2|\\begin{aligned}2 & -1 \\\\ -4 & 1\\end{aligned}| \\\\  & =(1-2)-2(2-4) \\\\  & =-1+4 \\\\  & =3\\end{aligned}\n$$\n\nNow, computing the second $3\\times 3$ determinant by applying a Laplace expansion along the $2$nd row, we obtain:\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 2 & 1 \\\\ 0 & -4 & -2 \\\\ -3 & 1 & 2\\end{aligned}| & =0\\cdot {C}_{21}+(-4)\\cdot {C}_{22}+(-2)\\cdot {C}_{23} \\\\  & =(-4)\\cdot (-1)^{2+2}\\cdot |\\begin{aligned}1 & 1 \\\\ -3 & 2\\end{aligned}|+(-2)\\cdot (-1)^{2+3}\\cdot |\\begin{aligned}1 & 2 \\\\ -3 & 1\\end{aligned}| \\\\  & =-4|\\begin{aligned}1 & 1 \\\\ -3 & 2\\end{aligned}|+2|\\begin{aligned}1 & 2 \\\\ -3 & 1\\end{aligned}| \\\\  & =-4(2+3)+2(1+6) \\\\  & =-20+14 \\\\  & =-6\\end{aligned}\n$$\n\nTherefore,\n\n$$\n|\\begin{aligned}1 & 2 & 1 & -1 \\\\ 0 & -4 & -2 & 1 \\\\ 2 & 0 & 0 & 1 \\\\ -3 & 1 & 2 & 0\\end{aligned}|=2\\cdot 3-(-6)=12.\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-77500/selection/43cfe60bd3ca66bf3ee9c5de8e942d80ee2e55e50c3ec94f0dc629b36820ca1f" :answer/id #uuid "ed790e9a-fa98-5ff0-b93c-5ab6a1d3fd2c" :answer/type :answer.type/math :answer/value "5\\cdot |\\begin{aligned}3 & -1 & 4 \\\\ 1 & 5 & 0 \\\\ 1 & 5 & 4\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-77500/selection/6d361c28d3aff35571a3721164bb8c4137f668d979314dce0e0a730668835bd1" :answer/id #uuid "676d3596-7c4d-5317-97e1-b51ab277cf49" :answer/type :answer.type/math :answer/value "3\\cdot |\\begin{aligned}3 & -1 & 4 \\\\ 1 & 2 & 0 \\\\ 1 & 2 & 0\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-77500/selection/445023042f8907d8b7f6c91093ea39f1734f2a8b0cd1c72df7516b488688d392" :answer/id #uuid "fedaa660-adba-5579-83da-f4ba82adc395" :answer/type :answer.type/math :answer/value "8\\cdot |\\begin{aligned}3 & -1 & 0 \\\\ 1 & 2 & 5 \\\\ -1 & 2 & 4\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-77500/selection/be0f36eaca3c0826e1adffe8454bfd3e6177615eefcd60bbf8bab37bc3fc6640" :answer/id #uuid "3a624a3d-dc8d-59b2-a194-bc8e6a65d85c" :answer/type :answer.type/math :answer/value "2\\cdot |\\begin{aligned}3 & -1 & 4 \\\\ 2 & 0 & 2 \\\\ 1 & 2 & 4\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-77500/selection/80abbceadb28a0bfc441a872f19418f759d3526c1afbb8a7fe4e7b8cb51ce2da" :answer/id #uuid "f48cdf69-3a8e-5955-80a8-ef3b059ec74f" :answer/type :answer.type/math :answer/value "5\\cdot |\\begin{aligned}3 & -1 & 4 \\\\ 1 & 2 & 0 \\\\ 1 & 2 & 4\\e