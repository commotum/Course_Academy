2 & 0 \\\\ 1 & -4 & -3 & 8 \\\\ 9 & 5 & -3 & -6 \\\\ -2 & 6 & 7 & 0\\end{aligned}|=$" :question/worked-solution "The $1$rst row of the matrix contains two zeros, more than any other row. So using a Laplace expansion along the $1$st row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}0 & -3 & 2 & 0 \\\\ 1 & -4 & -3 & 8 \\\\ 9 & 5 & -3 & -6 \\\\ -2 & 6 & 7 & 0\\end{aligned}| & =0\\cdot {C}_{11}+-3\\cdot {C}_{12}+2\\cdot {C}_{13}+0\\cdot {C}_{14} \\\\  & =-3\\cdot (-1)^{1+2}|\\begin{aligned}1 & -3 & 8 \\\\ 9 & -3 & -6 \\\\ -2 & 7 & 0\\end{aligned}|+2\\cdot (-1)^{1+3}\\cdot |\\begin{aligned}1 & -4 & 8 \\\\ 9 & 5 & -6 \\\\ -2 & 6 & 0\\end{aligned}| \\\\  & =3\\cdot |\\begin{aligned}1 & -3 & 8 \\\\ 9 & -3 & -6 \\\\ -2 & 7 & 0\\end{aligned}|+2\\cdot |\\begin{aligned}1 & -4 & 8 \\\\ 9 & 5 & -6 \\\\ -2 & 6 & 0\\end{aligned}|.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-77798/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a88f6712-2115-55ce-abe4-b3c27e2e105f"] :knowledge-point/questions ["q-77798"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186120330 :question/answer-fields 17592186118455] {:db/id "q-36221/selection/ma-v1/d31536994d177ada0a95e391b56bba155d74524828eae29303f12133e4239104/0119192800019bf0df61b67fa09714bcf09c631998b1824c2eccebc8900e0a37" :answer/id #uuid "13649c1e-6e49-511d-8a0f-cebfd6146cfb" :answer/type :answer.type/math :answer/value "-5\\cdot |\\begin{aligned}3 & 2 & -3 \\\\ 3 & -4 & 1 \\\\ -1 & 5 & 2\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-36221/selection/ma-v1/d31536994d177ada0a95e391b56bba155d74524828eae29303f12133e4239104/3632236a273b39196ae2f0a133fb01e9613c4ebcc85e022356f3eedf4f615671" :answer/id #uuid "e8dc526b-83bd-5293-8dcf-406816f93090" :answer/type :answer.type/math :answer/value "-5\\cdot |\\begin{aligned}3 & 1 & -3 \\\\ 3 & 6 & 1 \\\\ -1 & 1 & 2\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-36221/selection/ma-v1/d315369