0f7be5f790201a73847bbdb0de6e0de12254b6388f60a8f47b5d5fe01bc6ed" "q-130030/selection/c9ae11e1a974547fdcebfc936144d6c8e44ca018ef0fa09373830bad012819bb" "q-130030/selection/28c563ccd5d83834746a5f06fb5acb437f02f719183b7da15a1b3f488582271b" "q-130030/selection/65498c4d3285be24825562b9ce4211cd1ab62536f903a9c221f9b858e150fbc5" "q-130030/selection/41b9f4e523abca310f949a3c0d5fe094af683a8dd09b98c72eaa4a220e1dbdb8"] :db/ensure [:answer-field/validate]} {:db/id "q-130030" :question/id #uuid "91852bdb-57b1-599b-9b25-e04eee5aaa16" :question/math-academy-id "q-130030" :question/problem "$|\\begin{aligned}2 & 1 & -1 & 0 \\\\ 1 & 3 & -3 & 1 \\\\ 1 & -1 & 2 & 3 \\\\ 0 & -2 & 1 & 0\\end{aligned}|=$" :question/worked-solution "The $4$th row of the matrix contains two zeros, more than any other row. So using a Laplace expansion along the $4$th row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}2 & 1 & -1 & 0 \\\\ 1 & 3 & -3 & 1 \\\\ 1 & -1 & 2 & 3 \\\\ 0 & -2 & 1 & 0\\end{aligned}| & =0\\cdot {C}_{41}+(-2)\\cdot {C}_{42}+1\\cdot {C}_{43}+0\\cdot {C}_{44} \\\\  & =(-2)\\cdot (-1)^{4+2}\\cdot |\\begin{aligned}2 & -1 & 0 \\\\ 1 & -3 & 1 \\\\ 1 & 2 & 3\\end{aligned}|+1\\cdot (-1)^{4+3}\\cdot |\\begin{aligned}2 & 1 & 0 \\\\ 1 & 3 & 1 \\\\ 1 & -1 & 3\\end{aligned}| \\\\  & =-2\\cdot |\\begin{aligned}2 & -1 & 0 \\\\ 1 & -3 & 1 \\\\ 1 & 2 & 3\\end{aligned}|-|\\begin{aligned}2 & 1 & 0 \\\\ 1 & 3 & 1 \\\\ 1 & -1 & 3\\end{aligned}|\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-130030/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a88f6712-2115-55ce-abe4-b3c27e2e105f"] :knowledge-point/questions ["q-130030"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70108/selection/ac46d580a95a8fc03d1a7cb07de70e107b73fba6bf1bc1d13103b84eff3df012" :answer/id #uuid "464534ba-1a34-50d1-acab-d3fde6daeb7e" :answer/type :answer.type/math :answer/value "17" :db/ensure [:answer/validate]} {:db/id "q-70108/selection/83c228576338