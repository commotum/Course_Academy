ed}|" :db/id #edb/ref 17592186309831} {:answer/id #uuid "83b90bcf-fb3d-5741-958e-b153542639f2" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\cdot |\\begin{aligned}-2 & 1 & 5 \\\\ -4 & -3 & 2 \\\\ -1 & -1 & 2\\end{aligned}|" :db/id #edb/ref 17592186309832} {:answer/id #uuid "f007ee6c-641b-53f8-816f-c4e32be2b0f6" :answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}-2 & 1 & 5 \\\\ -4 & -3 & 2 \\\\ -1 & -1 & 2\\end{aligned}|" :db/id #edb/ref 17592186309833} {:answer/id #uuid "0d1dbd43-5cce-5017-9667-6c20f6d94d2c" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cdot |\\begin{aligned}-2 & 1 & 5 \\\\ -4 & -3 & 2 \\\\ -1 & -1 & 2\\end{aligned}|" :db/id #edb/ref 17592186309834} {:answer/id #uuid "a9c7a1e7-4245-5279-8a57-d735ab26ee0b" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-2 & 1 & 5 \\\\ -4 & -3 & 2 \\\\ -1 & -1 & 2\\end{aligned}|" :db/id #edb/ref 17592186309835}] :answer-field/correct {:answer/id #uuid "fdf6e5f1-ab1f-59ec-83fd-02fa557b602c" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\cdot |\\begin{aligned}-2 & 1 & 5 \\\\ -4 & -3 & 2 \\\\ -1 & -1 & 2\\end{aligned}|" :db/id #edb/ref 17592186309831} :answer-field/id #uuid "5d43a708-a39f-5d0d-ba16-08595e942492" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186309830}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "8b759b0b-f17e-5dda-a1e2-24359ead1d08" :question/math-academy-id "q-69974" :question/problem "$|\\begin{aligned}-2 & 0 & 1 & 5 \\\\ -4 & 0 & -3 & 2 \\\\ 1 & 2 & -4 & 3 \\\\ -1 & 0 & -1 & 2\\end{aligned}|=$" :question/worked-solution "Using a cofactor expansion along the $2$nd column, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}-2 & 0 & 1 & 5 \\\\ -4 & 0 & -3 & 2 \\\\ 1 & 2 & -4 & 3 \\\\ -1 & 0 & -1 & 2\\end{aligned}| & =0\\cdot {C}_{12}+0\\cdot {C}_{22}+2\\cdot {C}_{32}+0\\cdot {C}_{42} \\\\  & =2\\cdot (-1)^{3+2}\\cdot |\\begin{aligned}-2 & 1 & 5 \\\\ -4 & -3 & 2 \\\\ -1 & -1 & 2\\end{aligned}| \\\\  & =-2\\cdot |\\begin{aligned}-2 & 1 & 5 \\\\ -4 & -3 & 2 \\\\ -1 & -1 & 2\\end{aligned}|.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186309836 :knowledge-point/_questions [{:knowledge-point/id #uuid "d1637e23-6566-5e45-af4c-b27333f882d1" :knowledge-point/title "Calculating a Determinant Using a Laplace Expansion Across a Row"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b622b428-c3e2-51d6-9b66-32607ad448ef" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186309838} {:answer/id #uuid "8c8e772e-51b4-597a-9bb9-c4d78aa48fcc" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186309839} {:answer/id #uuid "164a7e20-e435-5876-8068-8cef66b618d7" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186309840} {:answer/id #uuid "0050ec6b-68c1-569b-b5e8-e4e965240be0" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186309841} {:answer/id #uuid "464534ba-1a34-50d1-acab-d3fde6daeb7e" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186309842}] :answer-field/correct {:answer/id #uuid "164a7e20-e435-5876-8068-8cef66b618d7" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186309840} :answer-field/id #uuid "d73ebc07-95ae-5ad7-a032-093a05707908" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186309837}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6d011bae-a4d7-529c-a458-c67d8283f882" :question/math-academy-id "q-70108" :question/problem "Compute the following determinant using a cofactor expansion along the $1$st row:\n\n$$\n|\\begin{aligned}0 & 0 & 3 & 0 \\\\ 1 & 2 & 1 & -1 \\\\ 0 & 1 & 2 & 0 \\\\ 2 & -1 & 0 & 3\\end{aligned}|.\n$$" :question/worked-solution "Using cofactor expansion along the $1$st row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}0 & 0 & 3 & 0 \\\\ 1 & 2 & 1 & -1 \\\\ 0 & 1 & 2 & 0 \\\\ 2 & -1 & 0 & 3\\end{aligned}| & =0\\cdot {C}_{11}+0\\cdot {C}_{12}+3\\cdot {C}_{13}+0\\cdot {C}_{14} \\\\  & =3\\cdot (-1)^{1+3}\\cdot |\\begin{aligned}1 & 2 & -1 \\\\ 0 & 1 & 0 \\\\ 2 & -1 & 3\\end{aligned}| \\\\  & =3|\\begin{aligned}1 & 2 & -1 \\\\ 0 & 1 & 0 \\\\ 2 & -1 & 3\\end{aligned}|.\\end{aligned}\n$$\n\nNow, computing the $3\\times 3$ determinant by applying a Laplace expansion along the $2$nd row, we obtain:\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & -2 & -1 \\\\ 0 & 1 & 0 \\\\ 2 & -1 & 3\\end{aligned}| & =0\\cdot {C}_{21}+1\\cdot {C}_{22}+0\\cdot {C}_{23} \\\\  & =1\\cdot (-1)^{2+2}\\cdot |\\begin{aligned}1 & -1 \\\\ 2 & 3\\end{aligned}| \\\\  & =|\\begin{aligned}1 & -1 \\\\ 2 & 3\\end{aligned}| \\\\  & =3+2 \\\\  & =5\\end{aligned}\n$$\n\nTherefore,\n\n$$\n|\\begin{aligned}0 & 0 & 3 & 0 \\\\ 1 & 2 & 1 & -1 \\\\ 0 & 1 & 2 & 0 \\\\ 2 & -1 & 0 & 3\\end{aligned}|=3\\cdot 5=15.\n$$"}] [{:db/id #edb/ref 17592186309843 :knowledge-point/_questions [{:knowledge-point/id #uuid "d1637e23-6566-5e45-af4c-b27333f882d1" :knowledge-point/title "Calculating a Determinant Using a Laplace Expansion Across a Row"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0083ab03-f418-54bc-b77c-011523add475" :answer/type {:db/ident :answer.type/math} :answer/value "38" :db/id #edb/ref 17592186309845} {:answer/id #uuid "d4599ba1-8a4a-5cfb-af5e-7fa2b66ba320" :answer/type {:db/ident :answer.type/math} :answer/value "62" :db/id #edb/ref 17592186309846} {:answer/id #uuid "a8263dae-1961-50ce-a3c0-aa6b48e48fcd" :answer/type {:db/ident :answer.type/math} :answer/value "56" :db/id #edb/ref 17592186309847} {:answer/id #uuid "a14133d7-d56e-53ab-b1b6-a82a5b3d77d6" :answer/type {:db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186309848} {:answer/id #uuid "65e33c62-4830-518a-aeeb-423f7f5aca40" :answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186309849}] :answer-field/correct {:answer/id #uuid "a8263dae-1961-50ce-a3c0-aa6b48e48fcd" :answer/type {:db/ident :answer.type/math} :answer/value "56" :db/id #edb/ref 17592186309847} :answer-field/id #uuid "531f8204-f26a-5f24-9fc5-4dec7edde1d3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186309844}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "51530761-8765-59bf-9fe1-f2c72e1c8f5f" :question/math-academy-id "q-70109" :question/problem "Compute the following determinant using a cofactor expansion along the $4$th row:\n\n$$\n|\\begin{aligned}1 & 4 & 3 & 1 \\\\ 1 & 2 & 0 & 0 \\\\ 0 & 1 & 2 & 3 \\\\ 4 & 0 & 0 & 0\\end{aligned}|.\n$$" :question/worked-solution "Using cofactor expansion along the $4$th row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 4 & 3 & 1 \\\\ 1 & 2 & 0 & 0 \\\\ 0 & 1 & 2 & 3 \\\\ 4 & 0 & 0 & 0\\end{aligned}| & =4\\cdot {C}_{41}+0\\cdot {C}_{42}+0\\cdot {C}_{43}+0\\cdot {C}_{44} \\\\  & =4\\cdot (-1)^{4+1}\\cdot |\\begin{aligned}4 & 3 & 1 \\\\ 2 & 0 & 0 \\\\ 1 & 2 & 3\\end{aligned}| \\\\  & =-4|\\begin{aligned}4 & 3 & 1 \\\\ 2 & 0 & 0 \\\\ 1 & 2 & 3\\end{aligned}|.\\end{aligned}\n$$\n\nNow, computing the $3\\times 3$ determinant by applying a Laplace expansion along the $2$nd row, we obtain:\n\n$$\n\\begin{aligned}|\\begin{aligned}4 & 3 & 1 \\\\ 2 & 0 & 0 \\\\ 1 & 2 & 3\\end{aligned}| & =2\\cdot {C}_{21}+0\\cdot {C}_{22}+0\\cdot {C}_{23} \\\\  & =2\\cdot (-1)^{2+1}\\cdot |\\begin{aligned}3 & 1 \\\\ 2 & 3\\end{aligned}| \\\\  & =-2|\\begin{aligned}3 & 1 \\\\ 2 & 3\\end{aligned}| \\\\  & =-2(9-2) \\\\  & =-14\\end{aligned}\n$$\n\nTherefore,\n\n$$\n|\\begin{aligned}1 & 4 & 3 & 1 \\\\ 1 & 2 & 0 & 0 \\\\ 0 & 1 & 2 & 3 \\\\ 4 & 0 & 0 & 0\\end{aligned}|=-4\\cdot (-14)=56.\n$$"}] [{:db/id #edb/ref 17592186309850 :knowledge-point/_questions [{:knowledge-point/id #uuid "d1637e23-6566-5e45-af4c-b27333f882d1" :knowledge-point/title "Calculating a Determinant Using a Laplace Expansion Across a Row"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28bdb29b-ada1-5ca0-834d-d618dfcc8a65" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186309852} {:answer/id #uuid "06b66420-a83b-54e7-8d9f-6daa997cf057" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186309853} {:answer/id #uuid "eaf3bae0-4587-571f-833d-603dc165eaf0" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186309854} {:answer/id #uuid "ff90cc2f-8aa8-5cc2-b795-5f0ee8d9fd41" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186309855} {:answer/id #uuid "ea4fdcc7-0c89-5a51-a1e5-9a7d44340bb5" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186309856}] :answer-field/correct {:answer/id #uuid "eaf3bae0-4587-571f-833d-603dc165eaf0" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186309854} :answer-field/id #uuid "1e39cdb9-1132-5003-a0b7-74420f01bd6e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186309851}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "bd7d3e76-f528-5065-b591-2bc192b9c16d" :question/math-academy-id "q-70128" :question/problem "Calculate\n$|\\begin{aligned}0 & 1 & 2 & -1 \\\\ 0 & -1 & 0 & 1 \\\\ 2 & 3 & 1 & 1 \\\\ 2 & 0 & -3 & 3\\end{aligned}|.$" :question/worked-solution "The $2$nd row of the given matrix contains two zeros, more than any other row. So, using a Laplace expansion along the $2$nd row, we have   \n\n$$\n\\begin{aligned}|\\begin{aligned}0 & 1 & 2 & -1 \\\\ 0 & -1 & 0 & 1 \\\\ 2 & 3 & 1 & 1 \\\\ 2 & 0 & -3 & 3\\end{aligned}| & =0\\cdot {C}_{21}+(-1)\\cdot {C}_{22}+0\\cdot {C}_{23}+1\\cdot {C}_{24} \\\\  & =(-1)\\cdot (-1)^{2+2}\\cdot |\\begin{aligned}0 & 2 & -1 \\\\ 2 & 1 & 1 \\\\ 2 & -3 & 3\\end{aligned}|+1\\cdot (-1)^{2+4}\\cdot |\\begin{aligned}0 & 1 & 2 \\\\ 2 & 3 & 1 \\\\ 2 & 0 & -3\\end{aligned}| \\\\  & =-|\\begin{aligned}0 & 2 & -1 \\\\ 2 & 1 & 1 \\\\ 2 & -3 & 3\\end{aligned}|+|\\begin{aligned}0 & 1 & 2 \\\\ 2 & 3 & 1 \\\\ 2 & 0 & -3\\end{aligned}|.\\end{aligned}\n$$\n\nNow, computing the first $3\\times 3$  determinant by applying a Laplace expansion along the $1$st row, we obtain:\n\n$$\n\\begin{aligned}|\\begin{aligned}0 & 2 & -1 \\\\ 2 & 1 & 1 \\\\ 2 & -3 & 3\\end{aligned}| & =0\\cdot {C}_{11}+2\\cdot {C}_{12}+(-1)\\cdot {C}_{13} \\\\  & =2\\cdot (-1)^{1+2}\\cdot |\\begin{aligned}2 & 1 \\\\ 2 & 3\\end{aligned}|+(-1)\\cdot (-1)^{1+3}\\cdot |\\begin{aligned}2 & 1 \\\\ 2 & -3\\end{aligned}| \\\\  & =-2|\\begin{aligned}2 & 1 \\\\ 2 & 3\\end{aligned}|-|\\begin{aligned}2 & 1 \\\\ 2 & -3\\end{aligned}| \\\\  & =-2(6-2)-(-6-2) \\\\  & =-8-(-8) \\\\  & =0\\end{aligned}\n$$\n\nFinally, we compute the second $3\\times 3$ determinant by applying a Laplace expansion along the $1$st row:\n\n$$\n\\begin{aligned}|\\begin{aligned}0 & 1 & 2 \\\\ 2 & 3 & 1 \\\\ 2 & 0 & -3\\end{aligned}| & =0\\cdot {C}_{11}+1\\cdot {C}_{12}+2\\cdot {C}_{13} \\\\  & =1\\cdot (-1)^{1+2}\\cdot |\\begin{aligned}2 & 1 \\\\ 2 & -3\\end{aligned}|+(2)\\cdot (-1)^{1+3}\\cdot |\\begin{aligned}2 & 3 \\\\ 2 & 0\\end{aligned}| \\\\  & =-|\\begin{aligned}2 & 1 \\\\ 2 & -3\\end{aligned}|+2|\\begin{aligned}2 & 3 \\\\ 2 & 0\\end{aligned}| \\\\  & =-(-6-2)+2(0-6) \\\\  & =-(-8)+2\\cdot (-6) \\\\  & =8-12 \\\\  & =-4\\end{aligned}\n$$\n\nTherefore,\n\n$$\n|\\begin{aligned}1 & 2 & 1 & -1 \\\\ 0 & -4 & -2 & 1 \\\\ 2 & 0 & 0 & 1 \\\\ -3 & 1 & 2 & 0\\end{aligned}|=-0+(-4)=-4.\n$$"}] [{:db/id #edb/ref 17592186309857 :knowledge-point/_questions [{:knowledge-point/id #uuid "d1637e23-6566-5e45-af4c-b27333f882d1" :knowledge-point/title "Calculating a Determinant Using a Laplace Expansion Across a Row"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7053da08-4864-5c3f-a287-a36a946f9372" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186309859} {:answer/id #uuid "fcf49848-68aa-575a-bfce-4238ebdd14bf" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186309860} {:answer/id #uuid "e63eee5d-0b0f-57b9-ac5e-3648a128d80a" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186309861} {:answer/id #uuid "06166dd0-1fe2-5cc4-a2bf-01e656baf5cd" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186309862} {:answer/id #uuid "1c231934-6584-57b8-ac43-c0e7f685c418" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186309863}] :answer-field/correct {:answer/id #uuid "e63eee5d-0b0f-57b9-ac5e-3648a128d80a" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186309861} :answer-field/id #uuid "9c0c259b-2449-503b-ae64-4d8fb9a4423f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186309858}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "82444eda-7c10-5fb4-8db7-2e302de54e6c" :question/math-academy-id "q-70133" :question/problem "Calculate\n$|\\begin{aligned}2 & 1 & -2 & 3 \\\\ -1 & -1 & 2 & 0 \\\\ 0 & 1 & 1 & 1 \\\\ 2 & 0 & 0 & 3\\end{aligned}|.$" :question/worked-solution "The $4$th row of the given matrix contains two zeros, more than any other row. So, using a Laplace expansion along the $4$th row, we have   \n\n$$\n\\begin{aligned}|\\begin{aligned}2 & 1 & -2 & 3 \\\\ -1 & -1 & 2 & 0 \\\\ 0 & 1 & 1 & 1 \\\\ 2 & 0 & 0 & 3\\end{aligned}| & =2\\cdot {C}_{41}+0\\cdot {C}_{42}+0\\cdot {C}_{43}+3\\cdot {C}_{44} \\\\  & =2\\cdot (-1)^{4+1}\\cdot |\\begin{aligned}1 & -2 & 3 \\\\ -1 & 2 & 0 \\\\ 1 & 1 & 1\\end{aligned}|+3\\cdot (-1)^{4+4}\\cdot |\\begin{aligned}2 & 1 & -2 \\\\ -1 & -1 & 2 \\\\ 0 & 1 & 1\\end{aligned}| \\\\  & =-2|\\begin{aligned}1 & -2 & 3 \\\\ -1 & 2 & 0 \\\\ 1 & 1 & 1\\end{aligned}|+3|\\begin{aligned}2 & 1 & -2 \\\\ -1 & -1 & 2 \\\\ 0 & 1 & 1\\end{aligned}|.\\end{aligned}\n$$\n\nNow, computing the first $3\\times 3$  determinant by applying a Laplace expansion along the $2$nd row, we obtain:\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & -2 & 3 \\\\ -1 & 2 & 0 \\\\ 1 & 1 & 1\\end{aligned}| & =(-1)\\cdot {C}_{21}+2\\cdot {C}_{22}+0\\cdot {C}_{23} \\\\  & =(-1)\\cdot (-1)^{2+1}\\cdot |\\begin{aligned}-2 & 3 \\\\ 1 & 1\\end{aligned}|+2\\cdot (-1)^{2+2}\\cdot |\\begin{aligned}1 & 3 \\\\ 1 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}-2 & 3 \\\\ 1 & 1\\end{aligned}|+2|\\begin{aligned}1 & 3 \\\\ 1 & 1\\end{aligned}| \\\\  & =(-2-3)+2(1-3) \\\\  & =-5+2\\cdot (-2) \\\\  & =-9\\end{aligned}\n$$\n\nFinally, we compute the second $3\\times 3$ determinant by applying a Laplace expansion along its $3$rd row:\n\n$$\n\\begin{aligned}|\\begin{aligned}2 & 1 & -2 \\\\ -1 & -1 & 2 \\\\ 0 & 1 & 1\\end{aligned}| & =0\\cdot {C}_{31}+1\\cdot {C}_{32}+1\\cdot {C}_{33} \\\\  & =1\\cdot (-1)^{3+2}\\cdot |\\begin{aligned}2 & -2 \\\\ -1 & 2\\end{aligned}|+1\\cdot (-1)^{3+3}\\cdot |\\begin{aligned}2 & 1 \\\\ -1 & -1\\end{aligned}| \\\\  & =-|\\begin{aligned}2 & -2 \\\\ -1 & 2\\end{aligned}|+|\\begin{aligned}2 & 1 \\\\ -1 & -1\\end{aligned}| \\\\  & =-(4-2)+(-2+1) \\\\  & =-2+(-1) \\\\  & =-3\\end{aligned}\n$$\n\nTherefore,\n\n$$\n|\\begin{aligned}2 & 1 & -2 & 3 \\\\ -1 & -1 & 2 & 0 \\\\ 0 & 1 & 1 & 1 \\\\ 2 & 0 & 0 & 3\\end{aligned}|=-2\\cdot (-9)+3\\cdot (-3)=18-9=9.\n$$"}] [{:db/id #edb/ref 17592186309864 :knowledge-point/_questions [{:knowledge-point/id #uuid "db6f57f3-d9f0-5ea7-a557-e729a8c0777f" :knowledge-point/title "Calculating a Determinant Using a Laplace Expansion Across a Column"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed790e9a-fa98-5ff0-b93c-5ab6a1d3fd2c" 