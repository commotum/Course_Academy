 -2 & 1 & -1 \\\\ -1 & 5 & 1\\end{aligned}|-\\sqrt{5}\\cdot |\\begin{aligned}-1 & 0 & 1 \\\\ 1 & 0 & -1 \\\\ 5 & \\sqrt{5} & 1\\end{aligned}|" :db/id #edb/ref 17592186309877}] :answer-field/correct {:answer/id #uuid "c4f051ba-97df-5697-9e45-45b3137ebdd9" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}\\cdot |\\begin{aligned}-1 & -1 & 1 \\\\ -2 & 1 & -1 \\\\ -1 & 5 & 1\\end{aligned}|-\\sqrt{5}\\cdot |\\begin{aligned}3 & 2 & -1 \\\\ -1 & -1 & 1 \\\\ -2 & 1 & -1\\end{aligned}|" :db/id #edb/ref 17592186309875} :answer-field/id #uuid "45dde8a7-0c5c-54a0-bdff-4598f2273f14" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186309872}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "3ec0fb73-379b-5a1f-918f-29c718e49441" :question/math-academy-id "q-77501" :question/problem "$|\\begin{aligned}3 & 2 & \\sqrt{3} & -1 \\\\ -1 & -1 & 0 & 1 \\\\ -2 & 1 & 0 & -1 \\\\ -1 & 5 & \\sqrt{5} & 1\\end{aligned}|=$" :question/worked-solution "Using a cofactor expansion along the $3$rd column, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}3 & 2 & \\sqrt{3} & -1 \\\\ -1 & -1 & 0 & 1 \\\\ -2 & 1 & 0 & -1 \\\\ -1 & 5 & \\sqrt{5} & 1\\end{aligned}| & =\\sqrt{3}\\cdot {C}_{13}+0\\cdot {C}_{23}+0\\cdot {C}_{33}+\\sqrt{5}\\cdot {C}_{43} \\\\  & =\\sqrt{3}\\cdot (-1)^{1+3}\\cdot |\\begin{aligned}-1 & -1 & 1 \\\\ -2 & 1 & -1 \\\\ -1 & 5 & 1\\end{aligned}|+\\sqrt{5}\\cdot (-1)^{4+3}\\cdot |\\begin{aligned}3 & 2 & -1 \\\\ -1 & -1 & 1 \\\\ -2 & 1 & -1\\end{aligned}| \\\\  & =\\sqrt{3}\\cdot |\\begin{aligned}-1 & -1 & 1 \\\\ -2 & 1 & -1 \\\\ -1 & 5 & 1\\end{aligned}|-\\sqrt{5}\\cdot |\\begin{aligned}3 & 2 & -1 \\\\ -1 & -1 & 1 \\\\ -2 & 1 & -1\\end{aligned}|.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186309878 :knowledge-point/_questions [{:knowledge-point/id #uuid "db6f57f3-d9f0-5ea7-a557-e729a8c0777f" :knowledge-point/title "Calculating a Determinant Using a La