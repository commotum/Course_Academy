2 & 0\\end{aligned}|+1\\cdot (-1)^{3+4}\\cdot |\\begin{aligned}1 & 2 & 1 \\\\ 0 & -4 & -2 \\\\ -3 & 1 & 2\\end{aligned}| \\\\  & =2|\\begin{aligned}2 & 1 & -1 \\\\ -4 & -2 & 1 \\\\ 1 & 2 & 0\\end{aligned}|-|\\begin{aligned}1 & 2 & 1 \\\\ 0 & -4 & -2 \\\\ -3 & 1 & 2\\end{aligned}|.\\end{aligned}\n$$\n\nNow, computing the first $3\\times 3$ determinant by applying a Laplace expansion along the $3$rd row, we obtain:\n\n$$\n\\begin{aligned}|\\begin{aligned}2 & 1 & -1 \\\\ -4 & -2 & 1 \\\\ 1 & 2 & 0\\end{aligned}| & =1\\cdot {C}_{31}+2\\cdot {C}_{32}+0\\cdot {C}_{33} \\\\  & =1\\cdot (-1)^{3+1}\\cdot |\\begin{aligned}1 & -1 \\\\ -2 & 1\\end{aligned}|+2\\cdot (-1)^{3+2}\\cdot |\\begin{aligned}2 & -1 \\\\ -4 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}1 & -1 \\\\ -2 & 1\\end{aligned}|-2|\\begin{aligned}2 & -1 \\\\ -4 & 1\\end{aligned}| \\\\  & =(1-2)-2(2-4) \\\\  & =-1+4 \\\\  & =3\\end{aligned}\n$$\n\nNow, computing the second $3\\times 3$ determinant by applying a Laplace expansion along the $2$nd row, we obtain:\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 2 & 1 \\\\ 0 & -4 & -2 \\\\ -3 & 1 & 2\\end{aligned}| & =0\\cdot {C}_{21}+(-4)\\cdot {C}_{22}+(-2)\\cdot {C}_{23} \\\\  & =(-4)\\cdot (-1)^{2+2}\\cdot |\\begin{aligned}1 & 1 \\\\ -3 & 2\\end{aligned}|+(-2)\\cdot (-1)^{2+3}\\cdot |\\begin{aligned}1 & 2 \\\\ -3 & 1\\end{aligned}| \\\\  & =-4|\\begin{aligned}1 & 1 \\\\ -3 & 2\\end{aligned}|+2|\\begin{aligned}1 & 2 \\\\ -3 & 1\\end{aligned}| \\\\  & =-4(2+3)+2(1+6) \\\\  & =-20+14 \\\\  & =-6\\end{aligned}\n$$\n\nTherefore,\n\n$$\n|\\begin{aligned}1 & 2 & 1 & -1 \\\\ 0 & -4 & -2 & 1 \\\\ 2 & 0 & 0 & 1 \\\\ -3 & 1 & 2 & 0\\end{aligned}|=2\\cdot 3-(-6)=12.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/state.json" "file_sha256" "66957468364924e0d88f073f88579bb8126c0661e2a19cd104e310f958496971"} {"question" "q-42095" "field" nil "attribute" "question/difficulty" "value" :question.difficu