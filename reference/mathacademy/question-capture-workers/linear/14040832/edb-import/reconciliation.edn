-1 \\\\ 2 & 6 & -2\\end{aligned}| \\\\  & =-7\\cdot |\\begin{aligned}1 & -4 & 3 \\\\ 2 & 6 & -2 \\\\ -2 & -9 & 4\\end{aligned}|-8\\cdot |\\begin{aligned}1 & -4 & 3 \\\\ -1 & 5 & -1 \\\\ 2 & 6 & -2\\end{aligned}|.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/state.json" "file_sha256" "66957468364924e0d88f073f88579bb8126c0661e2a19cd104e310f958496971"} {"question" "q-77808" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/activity-metadata.json" "file_sha256" "7adbcc7d52bf654d087d6f7659d0f66e0953a7b1d71173c43b6e23d57ef5d320"} {"question" "q-77808" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/state.json" "file_sha256" "66957468364924e0d88f073f88579bb8126c0661e2a19cd104e310f958496971"} {"question" "q-77808" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-7\\cdot |\\begin{aligned}1 & -4 & 3 \\\\ 2 & 6 & -2 \\\\ -2 & -9 & 4\\end{aligned}|-8\\cdot |\\begin{aligned}1 & -4 & 3 \\\\ -1 & 5 & -1 \\\\ 2 & 6 & -2\\end{aligned}|"] ["math" "-8\\cdot |\\begin{aligned}1 & -4 & 3 \\\\ -1 & 5 & -1 \\\\ 2 & 6 & -2\\end{aligned}|"] ["math" "-8\\cdot |\\begin{aligned}1 & -4 & 3 \\\\ 2 & 6 & -2 \\\\ -2 & -9 & 4\\end{aligned}|+7\\cdot |\\begin{aligned}1 & -4 & 3 \\\\ -1 & 5 & -1 \\\\ 2 & 6 & -2\\end{aligned}|"] ["math" "7\\cdot |\\begin{aligned}1 & -4 & 3 \\\\ 2 & 6 & -2 \\\\ -2 & -9 & 4\\end{aligned}|"] ["math" "7\\cdot |\\begin{aligned}1 & -4 & 3 \\\\ 2 & 6 & -2 \\\\ -2 & -9 & 4\\end{aligned}|-8\\cdot |\\begin{aligned}1 & -4 & 3 \\\\ -1 & 5 & -1 \\\\ 2 & 6 & -2\\end{aligned}|"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/state.json" "file_sha256" "66957468364924e0d88f073f88579bb8126c0661e2a19cd104e310f958496971"} {"question" "q-77808" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-7\\cdot |\\begin{aligned}1 & -4 & 3 \\\\ 2 & 6 & -2 \\\\ -2 & -9 & 4\\end{aligned}|-8\\cdot |\\begin{aligned}1 & -4 & 3 \\\\ -1 & 5 & -1 \\\\ 2 & 6 & -2\\end{aligned}|"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/state.json" "file_sha256" "66957468364924e0d88f073f88579bb8126c0661e2a19cd104e310f958496971"} {"question" "e-5182" "field" nil "attribute" "question/problem" "value" "Using a cofactor expansion along the $4$th row, write the following determinant as a combination of $3 \\times 3$ determinants:\n\n$$\n\\begin{aligned}10 & 2 & -2 & -1 \\\\ 1 & -2 & 7 & 9 \\\\ -2 & 1 & -2 & 3 \\\\ -6 & 0 & 0 & 1\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/example-5182.json" "file_sha256" "135bfffe33dda4b28df0be5f9eab19093feabcb547ef11cb13bd54efb6a2902b"} {"question" "e-5182" "field" nil "attribute" "question/worked-solution" "value" "Using a Laplace expansion along the $4$th row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}10 & 2 & -2 & -1 \\\\ 1 & -2 & 7 & 9 \\\\ -2 & 1 & -2 & 3 \\\\ -6 & 0 & 0 & 1\\end{aligned}| & =(-6)\\cdot {C}_{41}+0\\cdot {C}_{42}+0\\cdot {C}_{43}+1\\cdot {C}_{44} \\\\  & =(-6)\\cdot (-1)^{4+1}\\cdot |\\begin{aligned}2 & -2 & -1 \\\\ -2 & 7 & 9 \\\\ 1 & -2 & 3\\end{aligned}|+1\\cdot (-1)^{4+4}\\cdot |\\begin{aligned}10 & 2 & -2 \\\\ 1 & -2 & 7 \\\\ -2 & 1 & -2\\end{aligned}| \\\\  & =6\\cdot |\\begin{aligned}2 & -2 & -1 \\\\ -2 & 7 & 9 \\\\ 1 & -2 & 3\\end{aligned}|+|\\begin{aligned}10 & 2 & -2 \\\\ 1 & -2 & 7 \\\\ -2 & 1 & -2\\end{aligned}|.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}10 & 2 & -2 & -1 \\\\ 1 & -2 & 7 & 9 \\\\ -2 & 1 & -2 & 3 \\\\ -6 & 0 & 0 & 1\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/example-5182.json" "file_sha256" "135bfffe33dda4b28df0be5f9eab19093feabcb547ef11cb13bd54efb6a2902b"} {"question" "e-4418" "field" nil "attribute" "question/problem" "value" "Calculate\n$\\begin{aligned}1 & -1 & 0 & 2 \\\\ 0 & 1 & -4 & 2 \\\\ 0 & -2 & 3 & 1 \\\\ 0 & 0 & 0 & -1\\end{aligned}$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/example-4418.json" "file_sha256" "9de4bd1eb91b83dce25f6303dde58aaa5c28379bccc0171fc46d946818156917"} {"question" "e-4418" "field" nil "attribute" "question/worked-solution" "value" "The $4$th row of the matrix contains three zeros, more than any other row. So using a Laplace expansion along the $4$th row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & -1 & 0 & 2 \\\\ 0 & 1 & -4 & 2 \\\\ 0 & -2 & 3 & 1 \\\\ 0 & 0 & 0 & -1\\end{aligned}| & =0\\cdot {C}_{41}+0\\cdot {C}_{42}+0\\cdot {C}_{43}+(-1)\\cdot {C}_{44} \\\\  & =(-1)\\cdot (-1)^{4+4}\\cdot |\\begin{aligned}1 & -1 & 0 \\\\ 0 & 1 & -4 \\\\ 0 & -2 & 3\\end{aligned}| \\\\  & =-|\\begin{aligned}1 & -1 & 0 \\\\ 0 & 1 & -4 \\\\ 0 & -2 & 3\\end{aligned}|.\\end{aligned}\n$$\n\nNow, computing the $3 \\times 3$ determinant by applying a Laplace expansion along the $1$st row, we obtain:\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & -1 & 0 \\\\ 0 & 1 & -4 \\\\ 0 & -2 & 3\\end{aligned}| & =1\\cdot |\\begin{aligned}1 & -4 \\\\ -2 & 3\\end{aligned}|-(-1)\\cdot |\\begin{aligned}0 & -4 \\\\ 0 & 3\\end{aligned}|+0\\cdot |\\begin{aligned}0 & 1 \\\\ 0 & -2\\end{aligned}| \\\\  & =|\\begin{aligned}1 & -4 \\\\ -2 & 3\\end{aligned}|+|\\begin{aligned}0 & -4 \\\\ 0 & 3\\end{aligned}| \\\\  & =(3-8)+(0-0) \\\\  & =-5\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}1 & -1 & 0 & 2 \\\\ 0 & 1 & -4 & 2 \\\\ 0 & -2 & 3 & 1 \\\\ 0 & 0 & 0 & -1\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/example-4418.json" "file_sha256" "9de4bd1eb91b83dce25f6303dde58aaa5c28379bccc0171fc46d946818156917"} {"question" "e-4419" "field" nil "attribute" "question/problem" "value" "Using a cofactor expansion along the $2$nd column, write the following determinant as a combination of $3 \\times 3$ determinants:\n\n$$\n\\begin{aligned}1 & 0 & -3 & -2 \\\\ 2 & 3 & -1 & 5 \\\\ 1 & 0 & 8 & 9 \\\\ 2 & 0 & 3 & -1\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/example-4419.json" "file_sha256" "a599703f4517b0dbb35c786809bc84ccdbfc997e7e50650ea9c11657bccafd60"} {"question" "e-4419" "field" nil "attribute" "question/worked-solution" "value" "Using a Laplace expansion along the $2$nd column, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 0 & -3 & -2 \\\\ 2 & 3 & -1 & 5 \\\\ 1 & 0 & 8 & 9 \\\\ 2 & 0 & 3 & -1\\end{aligned}| & =0\\cdot {C}_{12}+3\\cdot {C}_{22}+0\\cdot {C}_{32}+0\\cdot {C}_{42} \\\\  & =3\\cdot (-1)^{2+2}\\cdot |\\begin{aligned}1 & -3 & -2 \\\\ 1 & 8 & 9 \\\\ 2 & 3 & -1\\end{aligned}| \\\\  & =3\\cdot |\\begin{aligned}1 & -3 & -2 \\\\ 1 & 8 & 9 \\\\ 2 & 3 & -1\\end{aligned}|.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}1 & 0 & -3 & -2 \\\\ 2 & 3 & -1 & 5 \\\\ 1 & 0 & 8 & 9 \\\\ 2 & 0 & 3 & -1\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/example-4419.json" "file_sha256" "a599703f4517b0dbb35c786809bc84ccdbfc997e7e50650ea9c11657bccafd60"} {"question" "q-36221" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "5\\cdot |\\begin{aligned}3 & 2 & -3 \\\\ 3 & -4 & 1 \\\\ -1 & 5 & 2\\end{aligned}|-5\\cdot |\\begin{aligned}3 & 1 & -3 \\\\ 3 & 6 & 1 \\\\ -1 & 1 & 2\\end{aligned}|"] "category" "reviewed_ma_solution" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/answer-source-reviews.json" "file_sha256" "a52a1589007a9993a94ae7a4b5802e15446542878c336c450293879c2d062f53" "reviewer_session" "01a118cc-89a0-7c90-9221-d6599ae13bca" "rationale" "Expanding along row 3, [0,-5,-5,0], leaves only columns 2 and 3. Their cofactor signs are (-1)^(3+2)=-1 and (-1)^(3+3)=1, giving coefficients +5 and -5 respectively. Deleting the corresponding row and columns yields exactly the two determinants in original option 3. The stored answer has identical entries and signs. This is a source-backed derived judgment from the original problem and authentic worked solution. The saved Incorrect grade concerns the submitted single-term option 0, not this reviewed answer." "bindings" {"problem" "f82259d0583b66e69b1f21a1a77c3ec1eb4eb2bebdc8e982daef90f22e8f4921" "worked_solution" "7441c48184e7f60d56ed63577b96bcd96315cedf567251b742805691581cf2ea" "original_field" "7b8f2fdc62f60f8d68913b35bdb2c9025d6e1fd3649c97cf3ad60b8eacfa0651" "reviewed_field" "f1255ca038d708747dc7d7aa1f70dba6b77dc9706e92979a60dd23a6efe03275" "raw_widget" "7bc7b34173ed3dd2d4dcf3c3a1e02e53246831d6fd2912a5a118df119c86fb34"} "evidence_files" [{"path" "q-36221-before.png" "sha256" "b0936a526089344aa5bd007c3ce7dc158dc8cfdb31e0e3e77f504797cb94fe57"} {"path" "history-q-36221.png" "sha256" "c81c170eab2363c84423c29a575cad74c27b2a79a7cb3dabaf0d96d2ef9ebade"} {"path" "q-36221-after.json" "sha256" "c063ab797f0a024f016b441b08e5e6d407666153e19f3281db6c2b44229ab24d"}]} {"question" "q-36221" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-5\\cdot |\\begin{aligned}3 & 1 & -3 \\\\ 3 & 6 & 1 \\\\ -1 & 1 & 2\\end{aligned}|"] ["math" "-5\\cdot |\\begin{aligned}3 & 2 & -3 \\\\ 3 & -4 & 1 \\\\ -1 & 5 & 2\\end{aligned}|"] ["math" "-5\\cdot |\\begin{aligned}3 & 2 & -3 \\\\ 3 & -4 & 1 \\\\ -1 & 5 & 2\\end{aligned}|-5\\cdot |\\begin{aligned}3 & 1 & -3 \\\\ 3 & 6 & 1 \\\\ -1 & 1 & 2\\end{aligned}|"] ["math" "5\\cdot |\\begin{aligned}3 & 2 & -3 \\\\ 3 & -4 & 1 \\\\ -1 & 5 & 2\\end{aligned}|+5\\cdot |\\begin{aligned}3 & 1 & -3 \\\\ 3 & 6 & 1 \\\\ -1 & 1 & 2\\end{aligned}|"] ["math" "5\\cdot |\\begin{aligned}3 & 2 & -3 \\\\ 3 & -4 & 1 \\\\ -1 & 5 & 2\\end{aligned}|-5\\cdot |\\begin{aligned}3 & 1 & -3 \\\\ 3 & 6 & 1 \\\\ -1 & 1 & 2\\end{aligned}|"]] "category" "reviewed_ma_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/answer-source-reviews.json" "file_sha256" "a52a1589007a9993a94ae7a4b5802e15446542878c336c450293879c2d062f53" "rationale" "Expanding along row 3, [0,-5,-5,0], leaves only columns 2 and 3. Their cofactor signs are (-1)^(3+2)=-1 and (-1)^(3+3)=1, giving coefficients +5 and -5 respectively. Deleting the corresponding row and columns yields exactly the two determinants in original option 3. The stored answer has identical entries and signs. This is a source-backed derived judgment from the original problem and authentic worked solution. The saved Incorrect grade concerns the submitted single-term option 0, not this reviewed answer."}] "usage" {"e-4419" [] "e-5182" [] "e-4418" [] "q-36221" [] "q-42095" []} "basis" 1469 "retractions" [[17592186120330 :question/problem "What is $\\begin{vmatrix}3 & 1 & 2 & -3 \\\\ 3 & 6 & -4 & 1 \\\\ 0 & -5 & -5 & 0 \\\\ -1 & 1 & 5 & 2\\end{vmatrix}$?"] [17592186120330 :question/answer-fields 17592186118455] [17592186120351 :question/problem "Calculate\n\n$\\begin{vmatrix}1 & 2 & 1 & -1 \\\\ 0 & -4 & -2 & 1 \\\\ 2 & 0 & 0 & 1 \\\\ -3 & 1 & 2 & 0\\end{vmatrix}$."] [17592186119584 :question/problem "Using a cofactor expansion along the $4$th row, write the following determinant as a combination of $3 \\times 3$ determinants:\n\n$\\begin{bmatrix}10 & 2 & -2 & -1 \\\\ 1 & -2 & 7 & 9 \\\\ -2 & 1 & -2 & 3 \\\\ -6 & 0 & 0 & 1\\end{bmatrix}$"] [17592186119584 :question/worked-solution "Using a Laplace expansion along the $4$th row, we have\n\n$$\n\\begin{aligned}\n\\begin{vmatrix}10 & 2 & -2 & -1 \\\\ 1 & -2 & 7 & 9 \\\\ -2 & 1 & -2 & 3 \\\\ -6 & 0 & 0 & 1\\end{vmatrix} &= (-6) \\cdot C_{41} + 0 \\cdot C_{42} + 0 \\cdot C_{43} + 1 \\cdot C_{44} \\\\\n&= (-6) \\cdot (-1)^{4 + 1} \\cdot\\begin{vmatrix}2 & -2 & -1 \\\\ -2 & 7 & 9 \\\\ 1 & -2 & 3\\end{vmatrix}+ 1 \\cdot (-1)^{4 + 4} \\cdot\\begin{vmatrix}10 & 2 & -2 \\\\ 1 & -2 & 7 \\\\ -2 & 1 & -2\\end{vmatrix} \\\\\n&= 6 \\cdot\\begin{vmatrix}2 & -2 & -1 \\\\ -2 & 7 & 9 \\\\ 1 & -2 & 3\\end{vmatrix}+\\begin{vmatrix}10 & 2 & -2 \\\\ 1 & -2 & 7 \\\\ -2 & 1 & -2\\end{vmatrix}\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{bmatrix}10 & 2 & -2 & -1 \\\\ 1 & -2 & 7 & 9 \\\\ -2 & 1 & -2 & 3 \\\\ -6 & 0 & 0 & 1\\end{bmatrix}\n$$"] [17592186119514 :question/problem "Calculate\n$\\begin{bmatrix}1 & -1 & 0 & 2 \\\\ 0 & 1 & -4 & 2 \\\\ 0 & -2 & 3 & 1 \\\\ 0 & 0 & 0 & -1\\end{bmatrix}$"] [17592186119514 :question/worked-solution "The $4$th row of the matrix contains three zeros, more than any other row. So using a Laplace expansion along the $4$th row, we have\n\n$$\n\\begin{aligned}\n\\begin{vmatrix}1 & -1 & 0 & 2 \\\\ 0 & 1 & -4 & 2 \\\\ 0 & -2 & 3 & 1 \\\\ 0 & 0 & 0 & -1\\end{vmatrix} &= 0 \\cdot C_{41} + 0 \\cdot C_{42} + 0 \\cdot C_{43} + (-1) \\cdot C_{44} \\\\\n&= (-1) \\cdot (-1)^{4 + 4} \\cdot\\begin{vmatrix}1 & -1 & 0 \\\\ 0 & 1 & -4 \\\\ 0 & -2 & 3\\end{vmatrix} \\\\\n&= -\\begin{vmatrix}1 & -1 & 0 \\\\ 0 & 1 & -4 \\\\ 0 & -2 & 3\\end{vmatrix}\n\\end{aligned}\n$$\n\nNow, computing the $3 \\times 3$ determinant by applying a Laplace expansion along the $1$st row, we obtain:\n\n$$\n\\begin{aligned}\n\\begin{vmatrix}1 & -1 & 0 \\\\ 0 & 1 & -4 \\\\ 0 & -2 & 3\\end{vmatrix} &= 1 \\cdot\\begin{vmatrix}1 & -4 \\\\ -2 & 3\\end{vmatrix}- (-1) \\cdot\\begin{vmatrix}0 & -4 \\\\ 0 & 3\\end{vmatrix}+ 0 \\cdot\\begin{vmatrix}0 & 1 \\\\ 0 & -2\\end{vmatrix} \\\\\n&=\\begin{vmatrix}1 & -4 \\\\ -2 & 3\\end{vmatrix}+\\begin{vmatrix}0 & -4 \\\\ 0 & 3\\end{vmatrix} \\\\\n&= (3 - 8) + (0 - 0) \\\\\n&=-5\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{bmatrix}1 & -1 & 0 & 2 \\\\ 0 & 1 & -4 & 2 \\\\ 0 & -2 & 3 & 1 \\\\ 0 & 0 & 0 & -1\\end{bmatrix}\n$$"] [17592186119515 :question/problem "Using a cofactor expansion along the $2$nd column, write the following determinant as a combination of $3 \\times 3$ determinants:\n\n$\\begin{bmatrix}1 & 0 & -3 & -2 \\\\ 2 & 3 & -1 & 5 \\\\ 1 & 0 & 8 & 9 \\\\ 2 & 0 & 3 & -1\\end{bmatrix}$"] [17592186119515 :question/worked-solution "Using a Laplace expansion along the $2$nd column, we have\n\n$$\n\\begin{aligned}\n\\begin{vmatrix}1 & 0 & -3 & -2 \\\\ 2 & 3 & -1 & 5 \\\\ 1 & 0 & 8 & 9 \\\\ 2 & 0 & 3 & -1\\end{vmatrix} &= 0 \\cdot C_{12} + 3 \\cdot C_{22} + 0 \\cdot C_{32} + 0 \\cdot C_{42} \\\\\n&= 3 \\cdot (-1)^{2 + 2} \\cdot\\begin{vmatrix}1 & -3 & -2 \\\\ 1 & 8 & 9 \\\\ 2 & 3 & -1\\end{vmatrix} \\\\\n&= 3 \\cdot\\begin{vmatrix}1 & -3 & -2 \\\\ 1 & 8 & 9 \\\\ 2 & 3 & -1\\end{vmatrix}\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{bmatrix}1 & 0 & -3 & -2 \\\\ 2 & 3 & -1 & 5 \\\\ 1 & 0 & 8 & 9 \\\\ 2 & 0 & 3 & -1\\end{bmatrix}\n$$"]] "immutable_answers" [17592186118456 17592186118457 17592186118458 17592186118459 17592186118460 17592186118582 17592186118583 17592186118584 17592186118585 17592186118586] "immutable_fields" [[17592186118455 :answer-field/correct] [17592186118455 :answer-field/id] [17592186118455 :answer-field/key] [17592186118455 :answer-field/type] [17592186118581 :answer-field/correct] [17592186118581 :answer-field/id] [17592186118581 :answer-field/key] [17592186118581 :answer-field/type]] "no_history" []}
