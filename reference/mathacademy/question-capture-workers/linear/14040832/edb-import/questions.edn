#{[{:db/id #edb/ref 17592186119514 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "d1637e23-6566-5e45-af4c-b27333f882d1" :knowledge-point/title "Calculating a Determinant Using a Laplace Expansion Across a Row"}] :question/id #uuid "8235213e-4e88-57f6-89b0-de589ad2b38d" :question/math-academy-id "e-4418" :question/problem "Calculate\n$\\begin{bmatrix}1 & -1 & 0 & 2 \\\\ 0 & 1 & -4 & 2 \\\\ 0 & -2 & 3 & 1 \\\\ 0 & 0 & 0 & -1\\end{bmatrix}$" :question/worked-solution "The $4$th row of the matrix contains three zeros, more than any other row. So using a Laplace expansion along the $4$th row, we have\n\n$$\n\\begin{aligned}\n\\begin{vmatrix}1 & -1 & 0 & 2 \\\\ 0 & 1 & -4 & 2 \\\\ 0 & -2 & 3 & 1 \\\\ 0 & 0 & 0 & -1\\end{vmatrix} &= 0 \\cdot C_{41} + 0 \\cdot C_{42} + 0 \\cdot C_{43} + (-1) \\cdot C_{44} \\\\\n&= (-1) \\cdot (-1)^{4 + 4} \\cdot\\begin{vmatrix}1 & -1 & 0 \\\\ 0 & 1 & -4 \\\\ 0 & -2 & 3\\end{vmatrix} \\\\\n&= -\\begin{vmatrix}1 & -1 & 0 \\\\ 0 & 1 & -4 \\\\ 0 & -2 & 3\\end{vmatrix}\n\\end{aligned}\n$$\n\nNow, computing the $3 \\times 3$ determinant by applying a Laplace expansion along the $1$st row, we obtain:\n\n$$\n\\begin{aligned}\n\\begin{vmatrix}1 & -1 & 0 \\\\ 0 & 1 & -4 \\\\ 0 & -2 & 3\\end{vmatrix} &= 1 \\cdot\\begin{vmatrix}1 & -4 \\\\ -2 & 3\\end{vmatrix}- (-1) \\cdot\\begin{vmatrix}0 & -4 \\\\ 0 & 3\\end{vmatrix}+ 0 \\cdot\\begin{vmatrix}0 & 1 \\\\ 0 & -2\\end{vmatrix} \\\\\n&=\\begin{vmatrix}1 & -4 \\\\ -2 & 3\\end{vmatrix}+\\begin{vmatrix}0 & -4 \\\\ 0 & 3\\end{vmatrix} \\\\\n&= (3 - 8) + (0 - 0) \\\\\n&=-5\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{bmatrix}1 & -1 & 0 & 2 \\\\ 0 & 1 & -4 & 2 \\\\ 0 & -2 & 3 & 1 \\\\ 0 & 0 & 0 & -1\\end{bmatrix}\n$$"}] [{:db/id #edb/ref 17592186119515 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "db6f57f3-d9f0-5ea7-a557-e729a8c0777f" :knowledge-point/title "Calculating a Determinant Using a Laplace Expansion Across a Column"}] :question/id #uuid "6f0a6499-03db-5833-b175-4835325d34d6" :question/math-academy-id "e-4419" :question/problem "Using a cofactor expansion along the $2$nd column, write the following determinant as a combination of $3 \\times 3$ determinants:\n\n$\\begin{bmatrix}1 & 0 & -3 & -2 \\\\ 2 & 3 & -1 & 5 \\\\ 1 & 0 & 8 & 9 \\\\ 2 & 0 & 3 & -1\\end{bmatrix}$" :question/worked-solution "Using a Laplace expansion along the $2$nd column, we have\n\n$$\n\\begin{aligned}\n\\begin{vmatrix}1 & 0 & -3 & -2 \\\\ 2 & 3 & -1 & 5 \\\\ 1 & 0 & 8 & 9 \\\\ 2 & 0 & 3 & -1\\end{vmatrix} &= 0 \\cdot C_{12} + 3 \\cdot C_{22} + 0 \\cdot C_{32} + 0 \\cdot C_{42} \\\\\n&= 3 \\cdot (-1)^{2 + 2} \\cdot\\begin{vmatrix}1 & -3 & -2 \\\\ 1 & 8 & 9 \\\\ 2 & 3 & -1\\end{vmatrix} \\\\\n&= 3 \\cdot\\begin{vmatrix}1 & -3 & -2 \\\\ 1 & 8 & 9 \\\\ 2 & 3 & -1\\end{vmatrix}\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{bmatrix}1 & 0 & -3 & -2 \\\\ 2 & 3 & -1 & 5 \\\\ 1 & 0 & 8 & 9 \\\\ 2 & 0 & 3 & -1\\end{bmatrix}\n$$"}] [{:db/id #edb/ref 17592186119584 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "a88f6712-2115-55ce-abe4-b3c27e2e105f" :knowledge-point/title "Applying a Laplace Expansion Across a Row"}] :question/id #uuid "5cc1443c-03cd-5f86-bcfc-b9b7f4c6a565" :question/math-academy-id "e-5182" :question/problem "Using a cofactor expansion along the $4$th row, write the following determinant as a combination of $3 \\times 3$ determinants:\n\n$\\begin{bmatrix}10 & 2 & -2 & -1 \\\\ 1 & -2 & 7 & 9 \\\\ -2 & 1 & -2 & 3 \\\\ -6 & 0 & 0 & 1\\end{bmatrix}$" :question/worked-solution "Using a Laplace expansion along the $4$th row, we have\n\n$$\n\\begin{aligned}\n\\begin{vmatrix}10 & 2 & -2 & -1 \\\\ 1 & -2 & 7 & 9 \\\\ -2 & 1 & -2 & 3 \\\\ -6 & 0 & 0 & 1\\end{vmatrix} &= (-6) \\cdot C_{41} + 0 \\cdot C_{42} + 0 \\cdot C_{43} + 1 \\cdot C_{44} \\\\\n&= (-6) \\cdot (-1)^{4 + 1} \\cdot\\begin{vmatrix}2 & -2 & -1 \\\\ -2 & 7 & 9 \\\\ 1 & -2 & 3\\end{vmatrix}+ 1 \\cdot (-1)^{4 + 4} \\cdot\\begin{vmatrix}10 & 2 & -2 \\\\ 1 & -2 & 7 \\\\ -2 & 1 & -2\\end{vmatrix} \\\\\n&= 6 \\cdot\\begin{vmatrix}2 & -2 & -1 \\\\ -2 & 7 & 9 \\\\ 1 & -2 & 3\\end{vmatrix}+\\begin{vmatrix}10 & 2 & -2 \\\\ 1 & -2 & 7 \\\\ -2 & 1 & -2\\end{vmatrix}\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{bmatrix}10 & 2 & -2 & -1 \\\\ 1 & -2 & 7 & 9 \\\\ -2 & 1 & -2 & 3 \\\\ -6 & 0 & 0 & 1\\end{bmatrix}\n$$"}] [{:db/id #edb/ref 17592186120330 :knowledge-point/_questions [{:knowledge-point/id #uuid "a88f6712-2115-55ce-abe4-b3c27e2e105f" :knowledge-point/title "Applying a Laplace Expansion Across a Row"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08496b68-218b-5a86-8b63-342dfa01e766" :answer/type {:db/ident :answer.type/math} :answer/value "5 \\cdot\\begin{vmatrix}3 & 2 & -3 \\\\ 3 & -4 & 1 \\\\ -1 & 5 & 2\\end{vmatrix}+ 5 \\cdot\\begin{vmatrix}3 & 1 & -3 \\\\ 3 & 6 & 1 \\\\ -1 & 1 & 2\\end{vmatrix}" :db/id #edb/ref 17592186118456} {:answer/id #uuid "176de608-0e76-543a-aa15-543214d1c894" :answer/type {:db/ident :answer.type/math} :answer/value "-5 \\cdot\\begin{vmatrix}3 & 1 & -3 \\\\ 3 & 6 & 1 \\\\ -1 & 1 & 2\\end{vmatrix}" :db/id #edb/ref 17592186118457} {:answer/id #uuid "2cbfc7d1-5131-567d-a6cb-a7e684c187da" :answer/type {:db/ident :answer.type/math} :answer/value "-5 \\cdot\\begin{vmatrix}3 & 2 & -3 \\\\ 3 & -4 & 1 \\\\ -1 & 5 & 2\\end{vmatrix}" :db/id #edb/ref 17592186118458} {:answer/id #uuid "478382e5-9e4a-5f81-9c2a-aa14e016f41a" :answer/type {:db/ident :answer.type/math} :answer/value "-5 \\cdot\\begin{vmatrix}3 & 2 & -3 \\\\ 3 & -4 & 1 \\\\ -1 & 5 & 2\\end{vmatrix}- 5 \\cdot\\begin{vmatrix}3 & 1 & -3 \\\\ 3 & 6 & 1 \\\\ -1 & 1 & 2\\end{vmatrix}" :db/id #edb/ref 17592186118459} {:answer/id #uuid "51375af5-f71e-58ec-984d-dc2b834ac926" :answer/type {:db/ident :answer.type/math} :answer/value "5 \\cdot\\begin{vmatrix}3 & 2 & -3 \\\\ 3 & -4 & 1 \\\\ -1 & 5 & 2\\end{vmatrix}- 5 \\cdot\\begin{vmatrix}3 & 1 & -3 \\\\ 3 & 6 & 1 \\\\ -1 & 1 & 2\\end{vmatrix}" :db/id #edb/ref 17592186118460}] :answer-field/correct {:answer/id #uuid "51375af5-f71e-58ec-984d-dc2b834ac926" :answer/type {:db/ident :answer.type/math} :answer/value "5 \\cdot\\begin{vmatrix}3 & 2 & -3 \\\\ 3 & -4 & 1 \\\\ -1 & 5 & 2\\end{vmatrix}- 5 \\cdot\\begin{vmatrix}3 & 1 & -3 \\\\ 3 & 6 & 1 \\\\ -1 & 1 & 2\\end{vmatrix}" :db/id #edb/ref 17592186118460} :answer-field/id #uuid "264d4a23-c8c1-5368-b782-e42ba2e715ba" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186118455}] :question/id #uuid "b5116353-6062-5b65-a3e1-05950bfbb7b0" :question/math-academy-id "q-36221" :question/problem "What is $\\begin{vmatrix}3 & 1 & 2 & -3 \\\\ 3 & 6 & -4 & 1 \\\\ 0 & -5 & -5 & 0 \\\\ -1 & 1 & 5 & 2\\end{vmatrix}$?"}] [{:db/id #edb/ref 17592186120351 :knowledge-point/_questions [{:knowledge-point/id #uuid "d1637e23-6566-5e45-af4c-b27333f882d1" :knowledge-point/title "Calculating a Determinant Using a Laplace Expansion Across a Row"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8008cdf5-2e0b-59d2-b581-2578fc0886e0" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186118582} {:answer/id #uuid "a96b4d68-da37-5fb1-9ec3-30e7eb64add4" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186118583} {:answer/id #uuid "e88d6f32-cd05-5d9d-90a2-27f611ba8577" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186118584} {:answer/id #uuid "ec2cb425-cbcb-5457-88de-eb204a164629" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186118585} {:answer/id #uuid "2573458a-044a-5685-813c-edae467237cb" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186118586}] :answer-field/correct {:answer/id #uuid "a96b4d68-da37-5fb1-9ec3-30e7eb64add4" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186118583} :answer-field/id #uuid "5327bc26-56ef-50c6-8800-0c8e8669eceb" :answer-field/ke