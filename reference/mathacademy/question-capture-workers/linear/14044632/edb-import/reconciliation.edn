thacademy/question-capture-workers/linear/14044632/state.json" "file_sha256" "3f13ea6518011f995527c2cbfcbe84beaa89d5795a02cce6e033b41d0a26694f"} {"question" "q-139968" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044632/activity-metadata.json" "file_sha256" "589d7ba12e1dd64c8adb14c0668ccfde6c89b193b06b0e537a3101540f23b186"} {"question" "q-139968" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044632/state.json" "file_sha256" "3f13ea6518011f995527c2cbfcbe84beaa89d5795a02cce6e033b41d0a26694f"} {"question" "q-139968" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-4"] ["math" "-\\frac{4}{5}"] ["math" "16"] ["math" "8"] ["math" "\\frac{4}{5}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044632/state.json" "file_sha256" "3f13ea6518011f995527c2cbfcbe84beaa89d5795a02cce6e033b41d0a26694f"} {"question" "q-139968" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "8"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044632/state.json" "file_sha256" "3f13ea6518011f995527c2cbfcbe84beaa89d5795a02cce6e033b41d0a26694f"} {"question" "q-74131" "field" nil "attribute" "question/problem" "value" "Given the vector $w=[\\begin{aligned}-2 \\\\ -4 \\\\ 2 \\\\ 1\\end{aligned}]$, find $‖-\\frac{w}{5}‖.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044632/state.json" "file_sha256" "3f13ea6518011f995527c2cbfcbe84beaa89d5795a02cce6e033b41d0a26694f"} {"question" "q-74131" "