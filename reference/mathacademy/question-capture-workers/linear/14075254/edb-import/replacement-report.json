      "old_sha256": "2708173b9d103dcc38386fc48e329ab6973ce2f06c67aa0f061f7e54ff0c65c4",
      "new_sha256": "1a05e33f381ef8782ad0d5d9cc9d4ba852edf96b28ae341a5e524fdefd436ef5",
      "category": "ma_capture",
