- the norm of the second column must be equal to $1.$\n\nAmong the given options, only the vector $[\\begin{aligned}\\frac{\\sqrt{5}}{5} \\\\ \\frac{2\\sqrt{5}}{5}\\end{aligned}]$ has both properties."}] [{:db/id #edb/ref 17592186381765 :knowledge-point/_questions [{:knowledge-point/id #uuid "a6598e4e-7ea6-56ce-abef-95e64d010e96" :knowledge-point/title "Identifying Parts of an Orthogonal Diagonalization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63d9208d-49f3-5121-ac54-f04d59bafcae" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186381767} {:answer/id #uuid "85bd951f-d463-5569-8cb1-e30da33bb712" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{4}{5} \\\\ \\frac{3}{5}\\end{aligned}]" :db/id #edb/ref 17592186381768} {:answer/id #uuid "c9947571-c428-59d9-a357-f455d4a03e9a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186381769} {:answer/id #uuid "235c0cba-c47c-581b-be19-cb504891aac9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{4}{5} \\\\ -\\frac{3}{5}\\end{aligned}]" :db/id #edb/ref 17592186381770} {:answer/id #uuid "31a62a96-8092-5cfc-8419-23959e3fbf23" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{3}{5} \\\\ \\frac{4}{5}\\end{aligned}]" :db/id #edb/ref 17592186381771}] :answer-field/correct {:answer/id #uuid "85bd951f-d463-5569-8cb1-e30da33bb712" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{4}{5} \\\\ \\frac{3}{5}\\end{aligned}]" :db/id #edb/ref 17592186381768} :answer-field/id #uuid "11ad76fa-2111-5d02-9b01-03b61105b297" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381766}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid 