n$$\n\nTherefore, the equivalent notation in terms of matrix multiplication is $EA:$\n\n$$\n[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -\\frac{3}{2}\\end{aligned}]\\cdot A\n$$"}] [{:db/id #edb/ref 17592186383872 :knowledge-point/_questions [{:knowledge-point/id #uuid "09d8ec89-4d75-51ac-a870-1d2f8a1800ba" :knowledge-point/title "Finding the Matrix Left Multiplication Equivalent To a Given Row Operation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d018aba2-3fb9-5e8d-8c7e-4dfead037777" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 4\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186383874} {:answer/id #uuid "c59a1611-ee83-5cb7-90ef-886bfea7bb1d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & 0 & 1\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186383875} {:answer/id #uuid "d8062d52-39bf-5a01-a2b6-92c159613fcb" :answer/type {:db/ident :answer.type/math} :answer/value "A\\cdot [\\begin{aligned}1 & 0 & 4 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186383876} {:answer/id #uuid "1f135ab8-94e2-5f0a-bc03-dc68de334b23" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 4 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186383877} {:answer/id #uuid "8ec34b42-0f41-5afd-a96f-d9c8e804aed7" :answer/type {:db/ident :answer.type/math} :answer/value "A\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186383878}] :answer-field/correct {:answer/id #uuid "1f135ab8-94e2-5f0a-bc03-dc68de334b23" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 4 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186383877} :answer-field/id #uuid "1c661d99-3430-5d97-bf8b-55fea4bbc2a6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383873}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "2fa1b5a8-9348-5a30-9ac3-222fed9c8d10" :question/math-academy-id "q-42533" :question/problem "Suppose that the elementary row operation ${R}_{1}:={R}_{1}+4{R}_{3}$ is applied to a $3\\times 3$ matrix $A.$ What is the equivalent notation in terms of matrix multiplication?" :question/worked-solution "We need to find a matrix $E$ such that $EA$ is equivalent to applying the elementary row operation ${R}_{1}:={R}_{1}+4{R}_{3}$ to $A.$\n\nTo find $E,$ we apply the given row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+4{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 4 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =E\\end{aligned}\n$$\n\nTherefore, the equivalent notation in terms of matrix multiplication is $EA:$\n\n$$\n[\\begin{aligned}1 & 0 & 4 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A\n$$"}] [{:db/id #edb/ref 17592186383879 :knowledge-point/_questions [{:knowledge-point/id #uuid "00b69189-1ae1-5625-adfb-e5460845c776" :knowledge-point/title "Finding the Matrix Left Multiplication Equivalent To a Sequence of Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bab549b-abe1-5115-be07-d6463720792c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -9\\end{aligned}]\\cdot [\\begin{aligned}1 & 3 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ -5 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186383881} {:answer/id #uuid "78211ba8-a254-55ef-a09a-3a419cdf4d12" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ -5 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -9\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186383882} {:answer/id #uuid "1fe70b61-6d4e-530b-a4d9-6e9d5f4491f2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & -5 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 3 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}-9 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186383883} {:answer/id #uuid "3f2a3991-4289-5395-b6f3-45b2dff290ce" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 5 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & -3 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 9\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186383884} {:answer/id #uuid "61b6cd3c-9cac-595e-9f9c-54a7f5a8e679" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -5 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 3 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -9\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186383885}] :answer-field/correct {:answer/id #uuid "61b6cd3c-9cac-595e-9f9c-54a7f5a8e679" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -5 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 3 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -9\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186383885} :answer-field/id #uuid "c323ff46-7224-59ca-ae32-7bad16469d44" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383880}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "77d9f39b-3a09-5cee-ac5d-0a4b5d06250c" :question/math-academy-id "q-75164" :question/problem "Suppose that the following elementary row operations are applied to a $3\\times 3$ matrix $A$ in the given order:\n\n$$\n{R}_{3}:=-9{R}_{3},\\,{R}_{1}:={R}_{1}+3{R}_{2},\\,{R}_{2}:={R}_{2}-5{R}_{1}\n$$\n\nWhat is the equivalent notation in terms of matrix multiplication?" :question/worked-solution "First, let's find the elementary matrices corresponding to the given elementary row operations.\n\n- The first operation is ${R}_{3}:=-9{R}_{3}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{3} & :=-9{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -9\\end{aligned}] \\\\  & ={E}_{1}\\end{aligned}\n$$\n\n- The second operation is ${R}_{1}:={R}_{1}+3{R}_{2}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+3{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 3 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={E}_{2}\\end{aligned}\n$$\n\n- The third operation is ${R}_{2}:={R}_{2}-5{R}_{1}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}-5{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ -5 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={E}_{3}\\end{aligned}\n$$\n\nTo apply the first elementary row operation to the matrix $A,$ we multiply by ${E}_{1}$ on the left and get ${E}_{1}A:$\n\n$$\n[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -9\\end{aligned}]\\cdot A\n$$\n\nThen, to apply the second elementary row operation to ${E}_{1}A,$ we multiply by ${E}_{2}$ on the left and get ${E}_{2}{E}_{1}A:$\n\n$$\n[\\begin{aligned}1 & 3 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -9\\end{aligned}]\\cdot A\n$$\n\nFinally, to apply the third elementary row operation to ${E}_{2}{E}_{1}A,$ we multiply by ${E}_{3}$ on the left and get ${E}_{3}{E}_{2}{E}_{1}A:$ \n\n$$\n[\\begin{aligned}1 & 0 & 0 \\\\ -5 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 3 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -9\\end{aligned}]\\cdot A\n$$"}]}
