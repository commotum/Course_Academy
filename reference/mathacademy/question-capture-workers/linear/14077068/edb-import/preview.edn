 1\\end{aligned}] \\\\  & ={E}_{2}\\end{aligned}\n$$\n\n- The third operation is ${R}_{2}:={R}_{2}-5{R}_{1}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}-5{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ -5 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={E}_{3}\\end{aligned}\n$$\n\nTo apply the first elementary row operation to the matrix $A,$ we multiply by ${E}_{1}$ on the left and get ${E}_{1}A:$\n\n$$\n[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -9\\end{aligned}]\\cdot A\n$$\n\nThen, to apply the second elementary row operation to ${E}_{1}A,$ we multiply by ${E}_{2}$ on the left and get ${E}_{2}{E}_{1}A:$\n\n$$\n[\\begin{aligned}1 & 3 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -9\\end{aligned}]\\cdot A\n$$\n\nFinally, to apply the third elementary row operation to ${E}_{2}{E}_{1}A,$ we multiply by ${E}_{3}$ on the left and get ${E}_{3}{E}_{2}{E}_{1}A:$ \n\n$$\n[\\begin{aligned}1 & 0 & 0 \\\\ -5 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 3 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -9\\end{aligned}]\\cdot A\n$$" 13194139536105 true] [17592186383880 1000 #edb/ref 17592186383881 13194139536105 true] [17592186383880 1000 #edb/ref 17592186383882 13194139536105 true] [17592186383880 1000 #edb/ref 17592186383883 13194139536105 true] [17592186383880 1000 #edb/ref 17592186383884 13194139536105 true] [17592186383880 1000 #edb/ref 17592186383885 13194139536105 true] [17592186383880 1040 #edb/ref 17592186045450 13194139536105 true] [17592186383880 1041 "selection" 13194139536105 true] [17592186383880 1104 #edb/ref 17592186383885 13194139536105 true] [17592186383880 1110 #uuid "c323ff46-7224-59ca-ae32-7bad