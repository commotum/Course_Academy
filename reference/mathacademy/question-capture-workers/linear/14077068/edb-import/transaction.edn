}\\end{aligned}] \\\\  & =E\\end{aligned}\n$$\n\nTherefore, the equivalent notation in terms of matrix multiplication is $EA:$\n\n$$\n[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -\\frac{3}{2}\\end{aligned}]\\cdot A\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-32144/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "09d8ec89-4d75-51ac-a870-1d2f8a1800ba"] :knowledge-point/questions ["q-32144"] :db/ensure [:knowledge-point/validate]} {:db/id "q-42533/selection/17c232b8a11c2c537693d8e6680804078d691e451674951833e0ef7e58da58ff" :answer/id #uuid "c59a1611-ee83-5cb7-90ef-886bfea7bb1d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & 0 & 1\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "q-42533/selection/5986105be17a0dcd88c73f582aae38b29d2e18e63478245bdb0c254295583f6b" :answer/id #uuid "1f135ab8-94e2-5f0a-bc03-dc68de334b23" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 4 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "q-42533/selection/1041a741ec41bb71d5311381eebdb85d97f4aa971a38a0b4ce806db354e88216" :answer/id #uuid "d018aba2-3fb9-5e8d-8c7e-4dfead037777" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 4\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "q-42533/selection/a2306a9a7752df31a85f176c58b991b4bef40dfd89b2000cc7553f1bae48ddb9" :answer/id #uuid "8ec34b42-0f41-5afd-a96f-d9c8e804aed7" :answer/type :answer.type/math :answer/value "A\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-42533/selection/3662590ccced856f2a876d0238e1dc8a4ccb5d56c3c99c9b8445a1ad6e754c1a" :answer/id #uuid "d8062d52-39bf-5a01-a2b6-92c159613fcb" :answer/type :answer.type/math :answer/value "A\\cdot [\\begin{aligned}1 & 0 & 4 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-42533/selection" :answer-field/id #uuid "1c661d99-3430-5d97-bf8b-55fea4bbc2a6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-42533/selection/5986105be17a0dcd88c73f582aae38b29d2e18e63478245bdb0c254295583f6b" :answer-field/choices ["q-42533/selection/17c232b8a11c2c537693d8e6680804078d691e451674951833e0ef7e58da58ff" "q-42533/selection/5986105be17a0dcd88c73f582aae38b29d2e18e63478245bdb0c254295583f6b" "q-42533/selection/1041a741ec41bb71d5311381eebdb85d97f4aa971a38a0b4ce806db354e88216" "q-42533/selection/a2306a9a7752df31a85f176c58b991b4bef40dfd89b2000cc7553f1bae48ddb9" "q-42533/selection/3662590ccced856f2a876d0238e1dc8a4ccb5d56c3c99c9b8445a1ad6e754c1a"] :db/ensure [:answer-field/validate]} {:db/id "q-42533" :question/id #uuid "2fa1b5a8-9348-5a30-9ac3-222fed9c8d10" :question/math-academy-id "q-42533" :question/problem "Suppose that the elementary row operation ${R}_{1}:={R}_{1}+4{R}_{3}$ is applied to a $3\\times 3$ matrix $A.$ What is the equivalent notation in terms of matrix multiplication?" :question/worked-solution "We need to find a matrix $E$ such that $EA$ is equivalent to applying the elementary row operation ${R}_{1}:={R}_{1}+4{R}_{3}$ to $A.$\n\nTo find $E,$ we apply the given row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+4{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 4 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =E\\end{aligned}\n$$\n\nTherefore, the equivalent notation in terms of matrix multiplication is $EA:$\n\n$$\n[\\begin{aligned}1 & 0 & 4 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-42533/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "09d8ec89-4d75-51ac-a870-1d2f8a1800ba"] :knowledge-point/questions ["q-42533"] :db/ensure [:knowledge-point/validate]} {:db/id "q-75164/selection/a6cb40291a44e9ae13468df000deb50d86356e8a13ba2e1e9ae9def802bfe81e" :answer/id #uuid "3f2a3991-4289-5395-b6f3-45b2dff290ce" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 5 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & -3 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 9\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "q-75164/selection/4aa1143ccec15ac112ad2726e884e6f0b7b42567aa5f0582c1beb7eb936c5b0e" :answer/id #uuid "78211ba8-a254-55ef-a09a-3a419cdf4d12" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ -5 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -9\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "q-75164/selection/11302f804f2332c0e26072fa14886b647be9d61c2d244d2b102e85ff1b65ee86" :answer/id #uuid "2bab549b-abe1-5115-be07-d6463720792c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -9\\end{aligned}]\\cdot [\\begin{aligned}1 & 3 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ -5 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "q-75164/selection/fa6d968edf0f704afe9e5fa46e4ea5a323853cda6357fbe51ee544293dd1bfa3" :answer/id #uuid "61b6cd3c-9cac-595e-9f9c-54a7f5a8e679" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -5 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 3 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -9\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "q-75164/selection/7fda1561eef0fedd04be32ac1842ce37bb87ac923523df443b9d7a2503f1a17b" :answer/id #uuid "1fe70b61-6d4e-530b-a4d9-6e9d5f4491f2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & -5 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 3 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}-9 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "q-75164/selection" :answer-field/id #uuid "c323ff46-7224-59ca-ae32-7bad16469d44" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-75164/selection/fa6d968edf0f704afe9e5fa46e4ea5a323853cda6357fbe51ee544293dd1bfa3" :answer-field/choices ["q-75164/selection/a6cb40291a44e9ae13468df000deb50d86356e8a13ba2e1e9ae9def802bfe81e" "q-75164/selection/4aa1143ccec15ac112ad2726e884e6f0b7b42567aa5f0582c1beb7eb936c5b0e" "q-75164/selection/11302f804f2332c0e26072fa14886b647be9d61c2d244d2b102e85ff1b65ee86" "q-75164/selection/fa6d968edf0f704afe9e5fa46e4ea5a323853cda6357fbe51ee544293dd1bfa3" "q-75164/selection/7fda1561eef0fedd04be32ac1842ce37bb87ac923523df443b9d7a2503f1a17b"] :db/ensure [:answer-field/validate]} {:db/id "q-75164" :question/id #uuid "77d9f39b-3a09-5cee-ac5d-0a4b5d06250c" :question/math-academy-id "q-75164" :question/problem "Suppose that the following elementary row operations are applied to a $3\\times 3$ matrix $A$ in the given order:\n\n$$\n{R}_{3}:=-9{R}_{3},\\,{R}_{1}:={R}_{1}+3{R}_{2},\\,{R}_{2}:={R}_{2}-5{R}_{1}\n$$\n\nWhat is the equivalent notation in terms of matrix multiplication?" :question/worked-solution "First, let's find the elementary matrices corresponding to the given elementary row operations.\n\n- The first operation is ${R}_{3}:=-9{R}_{3}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{3} & :=-9{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -9\\end{aligned}] \\\\  & ={E}_{1}\\end{aligned}\n$$\n\n- The second operation is ${R}_{1}:={R}_{1}+3{R}_{2}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+3{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 3 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={E}_{2}\\end{aligned}\n$$\n\n- The third operation is ${R}_{2}:={R}_{2}-5{R}_{1}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}-5{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ -5 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={E}_{3}\\end{aligned}\n$$\n\nTo apply the first elementary row operation to the matrix $A,$ we multiply by ${E}_{1}$ on the left and get ${E}_{1}A:$\n\n$$\n[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -9\\end{aligned}]\\cdot A\n$$\n\nThen, to apply the second elementary row operation to ${E}_{1}A,$ we multiply by ${E}_{2}$ on the left and get ${E}_{2}{E}_{1}A:$\n\n$$\n[\\begin{aligned}1 & 3 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -9\\end{aligned}]\\cdot A\n$$\n\nFinally, to apply the third elementary row operation to ${E}_{2}{E}_{1}A,$ we multiply by ${E}_{3}$ on the left and get ${E}_{3}{E}_{2}{E}_{1}A:$ \n\n$$\n[\\begin{aligned}1 & 0 & 0 \\\\ -5 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 3 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -9\\end{aligned}]\\cdot A\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-75164/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "00b69189-1ae1-5625-adfb-e5460845c776"] :knowledge-point/questions ["q-75164"] :db/ensure [:knowledge-point/validate]} {:db/id "q-110471/selection/3ab2532a7001eaa6e8e5d584500ab1ff64eddf6e12f7c65a2236ed461649ec67" :answer/id #uuid "e8acb90f-f0ff-5180-b4c9-3f2ce56526ea" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 3 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "q-110471/selection/30563312c25df8a034fd1cf898d06f9c4fb4fef8e0ec1f87eb1809438f36e25b" :answer/id #uuid "c7229ed6-7988-530d-a977-60c39c21da12" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "q-110471/selection/0e6d0dc60a16cd71ec59b8f727dc31cca14d6b3178bb39c9845a562fc1ff9912" :answer/id #uuid "76e1d450-b3ef-57af-9c64-ab8be1886d53" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 3 & 1\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "q-110471/selection/3a8824437b14e12b50242116d6e7235d609708ce0b667e4c1602df15c29e067b" :answer/id #uuid "c74b1327-57a3-5079-9810-08cee14b8c4f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "q-110471/selection/d98d9dc672b16ec473e8ab43da77b6c5f3a498c4892e08fc6728a9d8e1c0493b" :answer/id #uuid "4a9a90e1-5dba-5ab0-9ee2-104f8632a37f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "q-110471/selection" :answer-field/id #uuid "d1c3165d-bd53-5d9a-a729-a417d9b41a88" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-110471/selection/d98d9dc672b16ec473e8ab43da77b6c5f3a498c4892e08fc6728a9d8e1c0493b" :answer-field/choices ["q-110471/selection/3ab2532a7001eaa6e8e5d584500ab1ff64eddf6e12f7c65a2236ed461649ec67" "q-110471/selection/30563312c25df8a034fd1cf898d06f9c4fb4fef8e0ec1f87eb1809438f36e25b" "q-110471/selection/0e6d0dc60a16cd71ec59b8f727dc31cca14d6b3178bb39c9845a562fc1ff9912" "q-110471/selection/3a8824437b14e12b50242116d6e7235d609708ce0b667e4c1602df15c29e067b" "q-110471/selection/d98d9dc672b16ec473e8ab43da77b6c5f3a498c4892e08fc6728a9d8e1c0493b"] :db/ensure [:answer-field/validate]} {:db/id "q-110471" :question/id #uuid "c63ff4bb-da6b-5999-bbc7-816dc82a29a6" :question/math-academy-id "q-110471" :question/problem "Suppose that the elementary row operation \n${R}_{2}:=3{R}_{2}$ is applied to a $3\\times 3$ matrix $A.$ What is the equivalent notation in terms of matrix multiplication?" :question/worked-solution "We need to find a matrix $E$ such that $EA$ is equivalent to applying the elementary row operation ${R}_{2}:=3{R}_{2}$ to $A.$\n\nTo find $E,$ we apply the given row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{2} & :=3{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =E\\end{aligned}\n$$\n\nTherefore, the equivalent notation in terms of matrix multiplication is $EA:$\n\n$$\n[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-110471/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "09d8ec89-4d75-51ac-a870-1d2f8a1800ba"] :knowledge-point/questions ["q-110471"] :db/ensure [:knowledge-point/validate]}]
