tegory" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037236/state.json" "file_sha256" "75661d8cdcfeae369dbfac0e887fbab0e2fb2a4c43ef6ceec0b8a442517b4276"} {"question" "q-105113" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037236/activity-metadata.json" "file_sha256" "8d61b54b933e218322ca738b2b317f663e9af4d08773e3b029d666bf4b3c0dcf"} {"question" "q-105113" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037236/state.json" "file_sha256" "75661d8cdcfeae369dbfac0e887fbab0e2fb2a4c43ef6ceec0b8a442517b4276"} {"question" "q-105113" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "4"] ["math" "5"] ["math" "6"] ["math" "7"] ["math" "8"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037236/state.json" "file_sha256" "75661d8cdcfeae369dbfac0e887fbab0e2fb2a4c43ef6ceec0b8a442517b4276"} {"question" "q-105113" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "5"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037236/state.json" "file_sha256" "75661d8cdcfeae369dbfac0e887fbab0e2fb2a4c43ef6ceec0b8a442517b4276"} {"question" "q-73949" "field" nil "attribute" "question/problem" "value" "Let $l=[\\begin{aligned}5 \\\\ x \\\\ 2 \\\\ x \\\\ 2x\\end{aligned}]$ and $m=[\\begin{aligned}1 \\\\ x \\\\ 4 \\\\ -1 \\\\ -3\\end{aligned}].$\nIf $l\\cdot m=3$ and $x>3$, find the value of $x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-captu