{aligned}]+[\\begin{aligned}-3 \\\\ 2 \\\\ 5 \\\\ 7\\end{aligned}] \\\\  & =[\\begin{aligned}-2-3 \\\\ 0+2 \\\\ -1+5 \\\\ 4+7\\end{aligned}] \\\\  & =[\\begin{aligned}-5 \\\\ 2 \\\\ 4 \\\\ 11\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297420 :knowledge-point/_questions [{:knowledge-point/id #uuid "1ce19559-0f08-5ef7-9ce4-58e8e14094ab" :knowledge-point/title "Calculating a Multiple of a Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b46e3a83-2482-5be2-86e7-8eacf1afec4c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ 1 \\\\ 2 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186297422} {:answer/id #uuid "b19166bb-f410-5bfc-a9cb-5e59b886c9e3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-16 \\\\ 0 \\\\ 4 \\\\ -12\\end{aligned}]" :db/id #edb/ref 17592186297423} {:answer/id #uuid "71f24c75-20b6-5477-a132-db699ddf5e82" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ 0 \\\\ 1 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186297424} {:answer/id #uuid "d2636126-1059-5197-a1d1-a9f64ce859d1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ 0 \\\\ -1 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186297425} {:answer/id #uuid "c5fe5373-0aa2-5de5-9275-27453e6d706a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 \\\\ 0 \\\\ -1 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186297426}] :answer-field/correct {:answer/id #uuid "71f24c75-20b6-5477-a132-db699ddf5e82" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ 0 \\\\ 1 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186297424} :answer-field/id #uuid "65e71e33-986c-5acc-bd3f-92c55639076f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297421}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8972b624-d396-5686-85e2-b86ff24317e5" :question/math-academy-id "q-34164" :question/problem "If $b=[\\begin{aligned}8 \\\\ 0 \\\\ -2 \\\\ 6\\end{aligned}]$, then $-\\frac{1}{2}b=$" :question/worked-solution "Multiplying each component of $b$ by $-\\frac{1}{2},$ we get\n\n$$\n\\begin{aligned}-\\frac{1}{2}b & =-\\frac{1}{2}[\\begin{aligned}8 \\\\ 0 \\\\ -2 \\\\ 6\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{1}{2}\\cdot 8 \\\\ -\\frac{1}{2}\\cdot 0 \\\\ -\\frac{1}{2}\\cdot (-2) \\\\ -\\frac{1}{2}\\cdot 6\\end{aligned}] \\\\  & =[\\begin{aligned}-4 \\\\ 0 \\\\ 1 \\\\ -3\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297427 :knowledge-point/_questions [{:knowledge-point/id #uuid "ec386a91-fc52-56d8-8531-7e78a8464380" :knowledge-point/title "Calculating the Dot Product of Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f986a71c-dc6b-50c1-82e0-933b578114dc" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186297429} {:answer/id #uuid "2d25663a-e4aa-5157-acb7-20efb9f9d224" :answer/type {:db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186297430} {:answer/id #uuid "f660e178-5f4c-5e8c-98b3-784fb14668f5" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186297431} {:answer/id #uuid "140d7bd8-22ea-5c69-8fb4-9b03fc8473ed" :answer/type {:db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186297432} {:answer/id #uuid "6a60df87-9eb5-539b-a908-96595b784ffe" :answer/type {:db/ident :answer.type/math} :answer/value "-37" :db/id #edb/ref 17592186297433}] :answer-field/correct {:answer/id #uuid "6a60df87-9eb5-539b-a908-96595b784ffe" :answer/type {:db/ident :answer.type/math} :answer/value "-37" :db/id #edb/ref 17592186297433} :answer-field/id #uuid "8e4baa6e-3b58-5695-a613-1e713d3f3c3d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297428}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1b5bfcf1-7b65-5f8c-b969-d426772dbfc8" :question/math-academy-id "q-34166" :question/problem "If $p=[\\begin{aligned}-5 \\\\ 4 \\\\ -1 \\\\ 3 \\\\ -2\\end{aligned}]$ and $q=[\\begin{aligned}2 \\\\ -1 \\\\ 4 \\\\ -3 \\\\ 5\\end{aligned}]$, then $p\\cdot q=$" :question/worked-solution "To compute the dot product, we add up the products of corresponding components:\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{1}\\cdot {q}_{1}+{p}_{2}\\cdot {q}_{2}+{p}_{3}\\cdot {q}_{3}+{p}_{4}\\cdot {q}_{4}+{p}_{5}\\cdot {q}_{5} \\\\  & =(-5)\\cdot 2+4\\cdot (-1)+(-1)\\cdot 4+3\\cdot (-3)+(-2)\\cdot 5 \\\\  & =-10-4-4-9-10 \\\\  & =-37\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297434 :knowledge-point/_questions [{:knowledge-point/id #uuid "94f8e0e5-8d8a-516a-8f46-d76e94305df4" :knowledge-point/title "Finding the Value of an Unknown Quantity in an Expression Involving the Dot Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ee18bbc-16d2-5e9e-a0c3-dedbf1e2965d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186297436} {:answer/id #uuid "80905519-a9f8-55e7-b111-362478b6c8ce" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186297437} {:answer/id #uuid "6775c1b9-346e-5040-ac5e-d90057fbf9ae" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186297438} {:answer/id #uuid "b7a2f5c3-060b-5a73-a1c1-954d9a33e0d8" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186297439} {:answer/id #uuid "52400ada-8177-5139-a7fb-1e126270104c" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186297440}] :answer-field/correct {:answer/id #uuid "80905519-a9f8-55e7-b111-362478b6c8ce" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186297437} :answer-field/id #uuid "b8fc8f13-33ca-5124-8bbb-11949a16315f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297435}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "b473e158-894c-5e8f-9a39-9a3f46be7f95" :question/math-academy-id "q-34169" :question/problem "Let $u=[\\begin{aligned}2{x}^{4} \\\\ 4 \\\\ 12 \\\\ 6\\end{aligned}]$ and $v=[\\begin{aligned}2{x}^{-2} \\\\ -8x \\\\ 4 \\\\ 2\\end{aligned}].$ If $u\\cdot v=12$ and $x<6$, find the value of $x.$" :question/worked-solution "Starting from the equation $u\\cdot v=12,$ we compute the dot product in terms of $x$ and then solve for $x$ in the resulting equation:\n\n$$\n\\begin{aligned}u\\cdot v & =12 \\\\ 2{x}^{4}\\cdot 2{x}^{-2}+4\\cdot (-8x)+12\\cdot 4+6\\cdot 2 & =12 \\\\ 4{x}^{2}-32x+48+12 & =12 \\\\ 4{x}^{2}-32x+48 & =0 \\\\ {x}^{2}-8x+12 & =0 \\\\ (x-2)(x-6) & =0\\end{aligned}\n$$\n\nWe get two solutions, ${x}_{1}=2$ and ${x}_{2}=6.$ Since we need $x<6$, our final answer is $x=2$ only."}] [{:db/id #edb/ref 17592186120240 :knowledge-point/_questions [{:knowledge-point/id #uuid "ab0d2c2f-e7a4-51bb-a20a-f28c2f7ded8b" :knowledge-point/title "Adding Multiples of Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b89ce1f0-45a4-5b8c-8777-490bc279cec2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-15 \\\\ 2 \\\\ 17 \\\\ 13 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186117941} {:answer/id #uuid "cc4a3b03-ad7e-5333-bc7f-6d9664fe0c1f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-12 \\\\ 10 \\\\ -15 \\\\ 13 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186117942} {:answer/id #uuid "db9f77f7-101f-5cca-905d-e9316275b6fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-15 \\\\ 7 \\\\ 12 \\\\ 16 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186117943} {:answer/id #uuid "0375b870-fab5-57a1-883f-f6da42a4ce63" :answer/type {:db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186117944} {:answer/id #uuid "2ea72a57-e705-551e-bf5d-1365f4ae2098" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-13 \\\\ 6 \\\\ 17 \\\\ 15 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186117945}] :answer-field/correct {:answer/id #uuid "b89ce1f0-45a4-5b8c-8777-490bc279cec2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-15 \\\\ 2 \\\\ 17 \\\\ 13 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186117941} :answer-field/id #uuid "81c8ae7a-126c-5cc0-aa76-a86c4772b015" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117940}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b41bd59f-46c7-542b-bca0-d17f42387db0" :question/math-academy-id "q-34223" :question/problem "Let $a=[\\begin{aligned}-3 \\\\ 2 \\\\ 5 \\\\ 1 \\\\ -2\\end{aligned}]$ and $b=[\\begin{aligned}-3 \\\\ -2 \\\\ 1 \\\\ 5 \\\\ 6\\end{aligned}].$ Find $3a+2b.$" :question/worked-solution "First, we multiply each component of $a$ by $3$ and each component of $b$ by $2.$ Then, we add the vectors:\n\n$$\n\\begin{aligned}3a+2b & =3\\cdot [\\begin{aligned}-3 \\\\ 2 \\\\ 5 \\\\ 1 \\\\ -2\\end{aligned}]+2\\cdot [\\begin{aligned}-3 \\\\ -2 \\\\ 1 \\\\ 5 \\\\ 6\\end{aligned}] \\\\  & =[\\begin{aligned}-9 \\\\ 6 \\\\ 15 \\\\ 3 \\\\ -6\\end{aligned}]+[\\begin{aligned}-6 \\\\ -4 \\\\ 2 \\\\ 10 \\\\ 12\\end{aligned}] \\\\  & =[\\begin{aligned}-9-6 \\\\ 6-4 \\\\ 15+2 \\\\ 3+10 \\\\ -6+12\\end{aligned}] \\\\  & =[\\begin{aligned}-15 \\\\ 2 \\\\ 17 \\\\ 13 \\\\ 6\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297441 :knowledge-point/_questions [{:knowledge-point/id #uuid "ab0d2c2f-e7a4-51bb-a20a-f28c2f7ded8b" :knowledge-point/title "Adding Multiples of Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3defda6b-2443-5b97-b400-8133eedefad4" :answer/type {:db/ident :answe