point/title "Calculating the Dot Product of Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "966c6f07-0492-55e9-b562-fdcd0af933b8" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186297478} {:answer/id #uuid "8a34f8c5-93c6-57e8-8e3a-7d88970e42f7" :answer/type {:db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186297479} {:answer/id #uuid "a06b4818-e4c5-5c24-af72-b947db0395b6" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186297480} {:answer/id #uuid "5a368577-382c-5281-98b6-1747d192f789" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186297481} {:answer/id #uuid "a0b0b51e-35a2-5a1e-ab0e-f66cccfc5f70" :answer/type {:db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186297482}] :answer-field/correct {:answer/id #uuid "a06b4818-e4c5-5c24-af72-b947db0395b6" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186297480} :answer-field/id #uuid "a3b6fd1c-3030-5a10-9002-6d227ca69575" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297477}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e696dd78-621c-510b-8bd3-068a10e2c656" :question/math-academy-id "q-73941" :question/problem "Let $c=[\\begin{aligned}0 \\\\ -6 \\\\ 12 \\\\ 9 \\\\ 3\\end{aligned}]$ and $d=[\\begin{aligned}9 \\\\ 4 \\\\ -2 \\\\ 1 \\\\ 6\\end{aligned}].$ What is $(-\\frac{1}{3}c)\\cdot d?$" :question/worked-solution "First, multiplying each component of $c$ by $-\\frac{1}{3}$, we get\n\n$$\n\\begin{aligned}-\\frac{1}{3}c & =-\\frac{1}{3}[\\begin{aligned}0 \\\\ -6 \\\\ 12 \\\\ 9 \\\\ 3\\end{aligned}]=[\\begin{aligned}0 \\\\ 2 \\\\ -4 \\\\ -3 \\\\ -1\\end{aligned}]\\,.\\end{aligned}\n$$\n\nTo compute the dot product, we add up the products of corresponding components:\n\n$$\n\\begin{aligned}(-\\frac{1}{3}c)\\cdot d & =0\\cdot 9+2\\cdot 4+(-4)\\cdot (-2)+(-3)\\cdot 1+(-1)\\cdot 6 \\\\  & =0+8+8-3-6 \\\\  & =7\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297483 :knowledge-point/_questions [{:knowledge-point/id #uuid "94f8e0e5-8d8a-516a-8f46-d76e94305df4" :knowledge-point/title "Finding the Value of an Unknown Quantity in an Expression Involving the Dot Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f87414d4-21c6-5a6c-ba5a-40f679330698" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186297485} {:answer/id #uuid "4dba2444-c837-5ced-812d-27b51c18a5ad" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186297486} {:answer/id #uuid "623335d0-eaaf-5d80-9c98-1716ce280977" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186297487} {:answer/id #uuid "c66a270e-ca86-5beb-9729-02aa274201e3" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186297488} {:answer/id #uuid "06508f63-3cd2-50d2-8d94-b65c50c16a4e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186297489}] :answer-field/correct {:answer/id #uuid "4dba2444-c837-5ced-812d-27b51c18a5ad" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186297486} :answer-field/id #uuid "930120b1-a410-5cff-a8f8-6c2bb9be6141" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297484}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "d6e32ca4-4a9b-5134-925b-9f278db48738" :question/math-academy-id "q-73948" :question/problem "Let $v=[\\begin{aligned}x \\\\ 2x \\\\ 4 \\\\ -5\\end{aligned}]$ and $w=[\\begin{aligned}3x \\\\ -3 \\\\ x \\\\ 2\\end{aligned}].$\nIf $v\\cdot w=-2$ and $x>0$, find the value of $x.$" :question/worked-solution "Starting from the equation $v\\cdot w=-2,$ we compute the dot product in terms of $x$ and then solve for $x$ in the resulting equation:\n\n$$\n\\begin{aligned}v\\cdot w & =-2 \\\\ x\\cdot 3x+2x\\cdot (-3)+4\\cdot x+(-5)\\cdot 2 & =-2 \\\\ 3{x}^{2}-6x+4x-10 & =-2 \\\\ 3{x}^{2}-2x-8 & =0\\end{aligned}\n$$\n\nNow, using the quadratic formula, we obtain\n\n$$\n\\begin{aligned}x & =\\frac{-(-2)\\pm \\sqrt{(-2)^{2}-4(3)(-8)}}{2(3)} \\\\  & =\\frac{2\\pm \\sqrt{100}}{6} \\\\  & =\\frac{2\\pm 10}{6} \\\\  & =\\frac{1\\pm 5}{3}.\\end{aligned}\n$$\n\nSo, we get two solutions, ${x}_{1}=-\\frac{4}{3}$ and ${x}_{2}=2.$ Since we need $x>0$, our final answer is $x=2$ only."}] [{:db/id #edb/ref 17592186297490 :knowledge-point/_questions [{:knowledge-point/id #uuid "94f8e0e5-8d8a-516a-8f46-d76e94305df4" :knowledge-point/title "Finding the Value of an Unknown Quantity in an Expression Involving the Dot Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d3401eb8-1fc2-5492-b728-ef77e99762d3" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186297492} {:answer/id #uuid "d48b785e-520b-5b77-b990-4bde3e3fba82" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186297493} {:answer/id #uuid "cfaa92dc-4c2a-5e5d-bd32-c34aa1b32e9d" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186297494} {:answer/id #uuid "5bbd3c76-a99c-54a6-b4c2-77377681645b" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186297495} {:answer/id #uuid "35040f39-f44c-540b-bd7d-953decacae85" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186297496}] :answer-field/correct {:answer/id #uuid "35040f39-f44c-540b-bd7d-953decacae85" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186297496} :answer-field/id #uuid "80fe0d7c-a2dd-5aa5-9b76-56ed8936a756" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297491}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "df5b07b2-0d2e-5614-b4a7-fb6d8b9d36d1" :question/math-academy-id "q-73949" :question/problem "Let $l=[\\begin{aligned}5 \\\\ x \\\\ 2 \\\\ x \\\\ 2x\\end{aligned}]$ and $m=[\\begin{aligned}1 \\\\ x \\\\ 4 \\\\ -1 \\\\ -3\\end{aligned}].$\nIf $l\\cdot m=3$ and $x>3$, find the value of $x.$" :question/worked-solution "Starting from the equation $l\\cdot m=3,$ we compute the dot product in terms of $x$ and then solve for $x$ in the resulting equation:\n\n$$\n\\begin{aligned}l\\cdot m & =3 \\\\ 5\\cdot 1+x\\cdot x+2\\cdot 4+x\\cdot (-1)+2x\\cdot (-3) & =3 \\\\ 5+{x}^{2}+8-x-6x & =3 \\\\ {x}^{2}-7x+13 & =3 \\\\ {x}^{2}-7x+10 & =0 \\\\ (x-5)(x-2) & =0\\end{aligned}\n$$\n\nWe get two solutions, ${x}_{1}=5$ and ${x}_{2}=2.$ Since we need $x>3$, our final answer is $x=5$ only."}]}
