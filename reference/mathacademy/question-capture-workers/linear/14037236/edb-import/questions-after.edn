#{[{:db/id #edb/ref 17592186119539 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "1ce19559-0f08-5ef7-9ce4-58e8e14094ab" :knowledge-point/title "Calculating a Multiple of a Vector"}] :question/id #uuid "13fa2a8c-de7c-59ee-a838-2997494edc56" :question/math-academy-id "e-4782" :question/problem "Let $[\\begin{aligned}-4 \\\\ 6 \\\\ 3 \\\\ 0\\end{aligned}]$ Find $\\dfrac{1}{2} \\mathbf{a}.$" :question/worked-solution "Multiplying each component of $\\mathbf{a}$ by $\\dfrac{1}{2},$ we get\n\n$$\n\\begin{aligned}\\frac{1}{2}a & =\\frac{1}{2}[\\begin{aligned}-4 \\\\ 6 \\\\ 3 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{2}\\cdot (-4) \\\\ \\frac{1}{2}\\cdot 6 \\\\ \\frac{1}{2}\\cdot 3 \\\\ \\frac{1}{2}\\cdot 0\\end{aligned}] \\\\  & =[\\begin{aligned}-2 \\\\ 3 \\\\ \\frac{3}{2} \\\\ 0\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186119540 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "ab0d2c2f-e7a4-51bb-a20a-f28c2f7ded8b" :knowledge-point/title "Adding Multiples of Vectors"}] :question/id #uuid "1e82713d-4063-5bcd-bc2e-1d35c831ab34" :question/math-academy-id "e-4783" :question/problem "Let $[\\begin{aligned}-3 \\\\ 6 \\\\ 12 \\\\ -9 \\\\ 3\\end{aligned}]$ and $[\\begin{aligned}-4 \\\\ -6 \\\\ 2 \\\\ -8 \\\\ 10\\end{aligned}]$ Find $\\dfrac{1}{3}\\mathbf{a}+\\dfrac{1}{2}\\mathbf{b}.$" :question/worked-solution "First, we multiply each component of $\\mathbf{a}$ by $\\dfrac{1}{3}$ and each component of $\\mathbf{b}$ by $\\dfrac{1}{2}.$ Then, we add the vectors:\n\n$$\n\\begin{aligned}\\frac{1}{3}a+\\frac{1}{2}b & =\\frac{1}{3}\\cdot [\\begin{aligned}-3 \\\\ 6 \\\\ 12 \\\\ -9 \\\\ 3\\end{aligned}]+\\frac{1}{2}\\cdot [\\begin{aligned}-4 \\\\ -6 \\\\ 2 \\\\ -8 \\\\ 10\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ 2 \\\\ 4 \\\\ -3 \\\\ 1\\end{aligned}]+[\\begin{aligned}-2 \\\\ -3 \\\\ 1 \\\\ -4 \\\\ 5\\end{aligned}] \\\\  & =[\\begin{aligned}-1-2 \\\\ 2-3 \\\\ 4+1 \\\\ -3-4 \\\\ 1+5\\end{aligned}] \\\\  & =[\\begin{aligned}-3 \\\\ -1 \\\\ 5 \\\\ -7 \\\\ 6\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186119541 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "ec386a91-fc52-56d8-8531-7e78a8464380" :knowledge-point/title "Calculating the Dot Product of Two Vectors"}] :question/id #uuid "ba38ff28-b4f3-59b8-b18a-a278db26294d" :question/math-academy-id "e-4784" :question/problem "If $[\\begin{aligned}-1 \\\\ 4 \\\\ 3 \\\\ -5\\end{aligned}]$ and $[\\begin{aligned}-2 \\\\ 3 \\\\ -4 \\\\ 6\\end{aligned}]$ then what is $\\mathbf{u} \\cdot \\mathbf{v}?$" :question/worked-solution "To compute the dot product, we add up the products of corresponding components:\n\n$$\n\\begin{aligned}u\\cdot v & ={u}_{1}\\cdot {v}_{1}+{u}_{2}\\cdot {v}_{2}+{u}_{3}\\cdot {v}_{3}+{u}_{4}\\cdot {v}_{4} \\\\  & =(-1)\\cdot (-2)+4\\cdot 3+3\\cdot (-4)+(-5)\\cdot 6 \\\\  & =2+12-12-30 \\\\  & =-28\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186119542 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "94f8e0e5-8d8a-516a-8f46-d76e94305df4" :knowledge-point/title "Finding the Value of an Unknown Quantity in an Expression Involving the Dot Product"}] :question/id #uuid "3ec5f9d5-327b-59e5-8df7-fb37d4054021" :question/math-academy-id "e-4785" :question/problem "Let be $[\\begin{aligned}10 \\\\ x \\\\ 0 \\\\ 5\\end{aligned}]$ and $[\\begin{aligned}x \\\\ x \\\\ 8 \\\\ 5\\end{aligned}]$ If $\\mathbf{a}\\cdot \\mathbf{b}=0,$ find the value of $x.$" :question/worked-solution "Starting from the equation $\\mathbf{a} \\cdot \\mathbf{b}=0,$ we compute the dot product in terms of $x$ and then solve for $x$ in the resulting equation:\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 10\\cdot x+x\\cdot x+0\\cdot 8+5\\cdot 5 & =0 \\\\ 10x+{x}^{2}+25 & =0 \\\\ {x}^{2}+10x+25 & =0 \\\\ (x+5)^{2} & =0 \\\\ x & =-5\\end{aligned}\n$$\n\nTherefore, we conclude that $x=-5.$"}] [{:db/id #edb/ref 17592186297378 :knowledge-point/_questions [{:knowledge-point/id #uuid "ab0d2c2f-e7a4-51bb-a20a-f28c2f7ded8b" :knowledge-point/title "Adding Multiples of Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf6e3a6b-7ac9-545b-8f3a-17d49475cc42" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ -7 \\\\ 2 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186297380} {:answer/id #uuid "c0d34daa-0c40-5bd1-a730-040b1035cc52" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 \\\\ -1 \\\\ 0 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186297381} {:answer/id #uuid "1c833e93-e1be-5f9c-9321-a5f3b5aeebde" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ -12 \\\\ -1 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186297382} {:answer/id #uuid "52a5332e-e605-5b02-8277-c46f7db474c5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ -1 \\\\ 0 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186297383} {:answer/id #uuid "e49d7f59-8f5f-575c-b7bd-ee98d501daf4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{7}{2} \\\\ 1 \\\\ -\\frac{1}{2} \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186297384}] :answer-field/correct {:answer/id #uuid "52a5332e-e605-5b02-8277-c46f7db474c5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ -1 \\\\ 0 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186297383} :answer-field/id #uuid "1052ae36-303c-594f-bea8-c617c77ab273" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297379}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "87482b37-7f08-5ad9-946b-53fb6f8d693a" :question/math-academy-id "q-105097" :question/problem "Let $a=[\\begin{aligned}1 \\\\ -4 \\\\ 1 \\\\ 0\\end{aligned}]$ and $b=[\\begin{aligned}6 \\\\ 6 \\\\ -2 \\\\ 4\\end{aligned}].$ Find $a+\\frac{1}{2}b.$" :question/worked-solution "First, we multiply each component of $b$ by $\\frac{1}{2}.$ Then, we add the vectors:\n\n$$\n\\begin{aligned}a+\\frac{1}{2}b & =[\\begin{aligned}1 \\\\ -4 \\\\ 1 \\\\ 0\\end{aligned}]+\\frac{1}{2}\\cdot [\\begin{aligned}6 \\\\ 6 \\\\ -2 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ -4 \\\\ 1 \\\\ 0\\end{aligned}]+[\\begin{aligned}3 \\\\ 3 \\\\ -1 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}1+3 \\\\ -4+3 \\\\ 1+(-1) \\\\ 0+2\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ -1 \\\\ 0 \\\\ 2\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297385 :knowledge-point/_questions [{:knowledge-point/id #uuid "ab0d2c2f-e7a4-51bb-a20a-f28c2f7ded8b" :knowledge-point/title "Adding Multiples of Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d7ead273-baff-5ef0-9787-f7a8bb62cd67" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}16 \\\\ 24 \\\\ 0 \\\\ -8 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186297387} {:answer/id #uuid "823d1369-e112-5610-9542-23bf7282886e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}18 \\\\ 12 \\\\ 4 \\\\ 2 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186297388} {:answer/id #uuid "324faae6-90c9-5c47-b628-d95400c5eac0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}18 \\\\ 6 \\\\ 4 \\\\ 2 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186297389} {:answer/id #uuid "791dde69-b09d-5662-a294-5ff53686076d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}8 \\\\ 12 \\\\ 0 \\\\ -4 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186297390} {:answer/id #uuid "4552047e-b87d-5e61-94a0-e4cf5d17631d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ 6 \\\\ 0 \\\\ -2 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186297391}] :answer-field/correct {:answer/id #uuid "324faae6-90c9-5c47-b628-d95400c5eac0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}18 \\\\ 6 \\\\ 4 \\\\ 2 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186297389} :answer-field/id #uuid "0c8dcf33-8087-51cf-8704-df153bf6e2ac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297386}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e3e014c9-7e0f-5613-9d77-d53b9ab4992b" :question/math-academy-id "q-105102" :question/problem "Let $v=[\\begin{aligned}5 \\\\ -3 \\\\ 2 \\\\ -1 \\\\ 0\\end{aligned}]$ and $w=[\\begin{aligned}-1 \\\\ 9 \\\\ -2 \\\\ 3 \\\\ -1\\end{aligned}].$ Find $4v+2w.$" :question/worked-solution "First, we multiply each component of $v$ by $4$ and each component of $w$ by $2.$ Then, we add the vectors:\n\n$$\n\\begin{aligned}4v+2w & =4\\cdot [\\begin{aligned}5 \\\\ -3 \\\\ 2 \\\\ -1 \\\\ 0\\end{aligned}]+2\\cdot [\\begin{aligned}-1 \\\\ 9 \\\\ -2 \\\\ 3 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}20 \\\\ -12 \\\\ 8 \\\\ -4 \\\\ 0\\end{aligned}]+[\\begin{aligned}-2 \\\\ 18 \\\\ -4 \\\\ 6 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}20+(-2) \\\\ -12+18 \\\\ 8+(-4) \\\\ -4+6 \\\\ 0+(-2)\\end{aligned}] \\\\  & =[\\begin{aligned}18 \\\\ 6 \\\\ 4 \\\\ 2 \\\\ -2\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297392 :knowledge-point/_questions [{:knowledge-point/id #uuid "ec386a91-fc52-56d8-8531-7e78a8464380" :knowledge-point/title "Calculating the Dot Product of Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6f180e7-957b-553b-9c95-47057a5f90bb" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186297394} {:answer/id #uuid "9aa085ef-b637-5798-b161-7ff94aebd986" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186297395} {:answer/id #uuid "a89edb2c-bade-5f81-b4d9-74ec05693d36" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186297396} {:answer/id #uuid "b16585e9-7603-5dd4-9aa6-6459372c62b4" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186297397} {:answer/id #uuid "ba2dfc1e-1e88-5392-b1c7-6de148a166c3" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186297398}] :answer-field/correct {:answer/id #uuid "ba2dfc1e-1e88-5392-b1c7-6de148a166c3" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186297398} :answer-field/id #uuid "4c7e25bd-f4ea-5979-98d6-1d84d3976d9c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297393}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0ab5a547-f58e-52b2-ba02-c7fbbb5da6b2" :question/math-academy-id "q-105107" :question/problem "Let $r=[\\begin{aligned}15 \\\\ 9 \\\\ 6 \\\\ -3\\end{aligned}]$ and $s=[\\begin{aligned}1 \\\\ -7 \\\\ 6 \\\\ 2\\end{aligned}].$ What is $(\\frac{1}{3}r)\\cdot s?$" :question/worked-solution "First, multiplying each component of $r$ by $\\frac{1}{3}$, we get\n\n$$\n\\begin{aligned}\\frac{1}{3}r & =\\frac{1}{3}[\\begin{aligned}15 \\\\ 9 \\\\ 6 \\\\ -3\\end{aligned}]=[\\begin{aligned}5 \\\\ 3 \\\\ 2 \\\\ -1\\end{aligned}]\\,.\\end{aligned}\n$$\n\nTo compute the dot product, we add up the products of corresponding components:\n\n$$\n\\begin{aligned}(\\frac{1}{3}r)\\cdot s & =5\\cdot 1+3\\cdot (-7)+2\\cdot 6+(-1)\\cdot 2 \\\\  & =5-21+12-2 \\\\  & =-6\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297399 :knowledge-point/_questions [{:knowledge-point/id #uuid "94f8e0e5-8d8a-516a-8f46-d76e94305df4" :knowledge-point/title "Finding the Value of an Unknown Quantity in an Expression Involving the Dot Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47b981d4-ee99-56d8-982e-79b7e21382e8" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186297401} {:answer/id #uuid "3553b9ed-8bc4-581a-8bbd-893215a9ee29" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186297402} {:answer/id #uuid "af48bc56-a6d6-59b4-8ec9-de84230c3367" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186297403} {:answer/id #uuid "a8e44d2d-ed07-5a7f-9939-69bb167432d9" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186297404} {:answer/id #uuid "3a37d95b-af0f-5033-95a0-34db41d8cb34" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186297405}] :answer-field/correct {:answer/id #uuid "47b981d4-ee99-56d8-982e-79b7e21382e8" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186297401} :answer-field/id #uuid "b84b2e70-d118-5a43-b272-6382b997fbba" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297400}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "64634ee1-b105-533f-8237-440ecbf93930" :question/math-academy-id "q-105110" :question/problem "Let\n$p=[\\begin{aligned}9 \\\\ y-3 \\\\ 3 \\\\ 4\\end{aligned}]$ and $q=[\\begin{aligned}0 \\\\ 1 \\\\ -4 \\\\ y\\end{aligned}].$\nIf $p\\cdot q=0$, find the value of $y.$" :question/worked-solution "Starting from the equation $p\\cdot q=0,$ we compute the dot product in terms of $y$ and then solve for $y$ in the resulting equation:\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 9\\cdot 0+(y-3)\\cdot 1+3\\cdot (-4)+4\\cdot y & =0 \\\\ y-3-12+4y & =0 \\\\ 5y & =15 \\\\ y & =3\\end{aligned}\n$$\n\nTherefore, we conclude that $y=3.$"}] [{:db/id #edb/ref 17592186297406 :knowledge-point/_questions [{:knowledge-point/id #uuid "94f8e0e5-8d8a-516a-8f46-d76e94305df4" :knowledge-point/title "Finding the Value of an Unknown Quantity in an Expression Involving the Dot Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ba8f1240-5a0d-52d6-b03a-99f40265474b" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186297408} {:answer/id #uuid "15797e5e-9db9-5a58-b532-a11a341516de" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186297409} {:answer/id #uuid "bb8aa89d-459b-5736-9406-264cd54f38da" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186297410} {:answer/id #uuid "6458f8b5-2971-5ee5-8d26-f6916e85f5a0" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186297411} {:answer/id #uuid "7a01e5a4-790d-518e-9285-f827d352dde4" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186297412}] :answer-field/correct {:answer/id #uuid "7a01e5a4-790d-518e-9285-f827d352dde4" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186297412} :answer-field/id #uuid "74cbb51e-7793-5eb0-898a-dfd50b4adfbc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297407}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "deac67dd-ac41-532e-b698-b59c2d48e196" :question/math-academy-id "q-105113" :question/problem "Let $u=[\\begin{aligned}7 \\\\ 9 \\\\ 3t \\\\ 1 \\\\ -1\\end{aligned}]$ and $v=[\\begin{aligned}t \\\\ 2 \\\\ -5 \\\\ {t}^{2} \\\\ 5\\end{aligned}].$\nIf $u\\cdot v=-2$ and $t>3$, find the value of $t.$" :question/worked-solution "Starting from the equation $u\\cdot v=-2,$ we compute the dot product in terms of $t$ and then solve for $t$ in the resulting equation:\n\n$$\n\\begin{aligned}u\\cdot v & =-2 \\\\ 7\\cdot t+9\\cdot 2+3t\\cdot (-5)+1\\cdot {t}^{2}+(-1)\\cdot 5 & =-2 \\\\ 7t+18-15t+{t}^{2}-5 & =-2 \\\\ {t}^{2}-8t+15 & =0 \\\\ (t-3)(t-5) & =0\\end{aligned}\n$$\n\nWe get two solutions, ${t}_{1}=3$ and ${t}_{2}=5.$ Since we need $t>3$, our final answer is $t=5$ only."}] [{:db/id #edb/ref 17592186297413 :knowledge-point/_questions [{:knowledge-point/id #uuid "ab0d2c2f-e7a4-51bb-a20a-f28c2f7ded8b" :know