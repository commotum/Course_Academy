ademy-id "q-34226" :question/problem "Let $r=[\\begin{aligned}-4 \\\\ 2 \\\\ -3 \\\\ 1\\end{aligned}]$ and $s=[\\begin{aligned}1 \\\\ 5 \\\\ 2 \\\\ -8\\end{aligned}].$ Find $r+s.$" :question/worked-solution "We add the vectors:\n\n$$\n\\begin{aligned}r+s & =[\\begin{aligned}-4 \\\\ 2 \\\\ -3 \\\\ 1\\end{aligned}]+[\\begin{aligned}1 \\\\ 5 \\\\ 2 \\\\ -8\\end{aligned}] \\\\  & =[\\begin{aligned}-4+1 \\\\ 2+5 \\\\ -3+2 \\\\ 1-8\\end{aligned}] \\\\  & =[\\begin{aligned}-3 \\\\ 7 \\\\ -1 \\\\ -7\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-34226/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ab0d2c2f-e7a4-51bb-a20a-f28c2f7ded8b"] :knowledge-point/questions ["q-34226"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-34227"] :question/problem "If $u=[\\begin{aligned}-4 \\\\ 1 \\\\ 2 \\\\ 3\\end{aligned}]$ and $v=[\\begin{aligned}2 \\\\ -4 \\\\ 6 \\\\ -7\\end{aligned}]$, then $u\\cdot v=$" :question/worked-solution "To compute the dot product, we add up the products of corresponding components:\n\n$$\n\\begin{aligned}u\\cdot v & ={u}_{1}\\cdot {v}_{1}+{u}_{2}\\cdot {v}_{2}+{u}_{3}\\cdot {v}_{3}+{u}_{4}\\cdot {v}_{4} \\\\  & =(-4)\\cdot 2+1\\cdot (-4)+2\\cdot 6+3\\cdot (-7) \\\\  & =-8-4+12-21 \\\\  & =-21\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-73941/selection/801bcdd9cb6a10cec998162e05f71050c8aaf0c6974f095bdcaef715a09f4aee" :answer/id #uuid "5a368577-382c-5281-98b6-1747d192f789" :answer/type :answer.type/math :answer/value "21" :db/ensure [:answer/validate]} {:db/id "q-73941/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer/id #uuid "966c6f07-0492-55e9-b562-fdcd0af933b8" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "q-73941/selection/f4f7e304b38327904d9fdebbac3479cccadb547b1c29d7b8e5938e7012f9d65b" :a