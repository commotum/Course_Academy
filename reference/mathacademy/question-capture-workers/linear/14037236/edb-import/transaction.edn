.\\end{aligned}\n$$\n\nTo compute the dot product, we add up the products of corresponding components:\n\n$$\n\\begin{aligned}(\\frac{1}{2}a)\\cdot b & =2\\cdot 5+(-1)\\cdot (-3)+1\\cdot 1+3\\cdot 0+5\\cdot 2 \\\\  & =10+3+1+0+10 \\\\  & =24\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-73939/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ec386a91-fc52-56d8-8531-7e78a8464380"] :knowledge-point/questions ["q-73939"] :db/ensure [:knowledge-point/validate]} {:db/id "q-34166/selection/5d34995cddd0166b343cae457ee45643c04c739e08758db1204c66c5ee04158e" :answer/id #uuid "2d25663a-e4aa-5157-acb7-20efb9f9d224" :answer/type :answer.type/math :answer/value "-20" :db/ensure [:answer/validate]} {:db/id "q-34166/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "f660e178-5f4c-5e8c-98b3-784fb14668f5" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-34166/selection/94b1e608a1bece13c117321c62644f2051416b0003719c2dd4b9ea44af9d6b64" :answer/id #uuid "140d7bd8-22ea-5c69-8fb4-9b03fc8473ed" :answer/type :answer.type/math :answer/value "-28" :db/ensure [:answer/validate]} {:db/id "q-34166/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "f986a71c-dc6b-50c1-82e0-933b578114dc" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-34166/selection/adaafdd6cfa63b95a15d8153d3c525ad9b315fab7423a3f33ab84c840b75b98d" :answer/id #uuid "6a60df87-9eb5-539b-a908-96595b784ffe" :answer/type :answer.type/math :answer/value "-37" :db/ensure [:answer/validate]} {:db/id "q-34166/selection" :answer-field/id #uuid "8e4baa6e-3b58-5695-a613-1e713d3f3c3d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-34166/selection/adaafdd6cfa63b95a15d8153d3c525ad9b315fab7423a3f33ab84c840b75b98d" :answer-field/choices ["q-34166/selection/5d34995cddd0166b343cae457ee45643c04c739e08758db1204c66c5ee04158e" "q-34166/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-34166/selection/94b1e608a1bece13c117321c62644f2051416b0003719c2dd4b9ea44af9d6b64" "q-34166/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" "q-34166/selection/adaafdd6cfa63b95a15d8153d3c525ad9b315fab7423a3f33ab84c840b75b98d"] :db/ensure [:answer-field/validate]} {:db/id "q-34166" :question/id #uuid "1b5bfcf1-7b65-5f8c-b969-d426772dbfc8" :question/math-academy-id "q-34166" :question/problem "If $p=[\\begin{aligned}-5 \\\\ 4 \\\\ -1 \\\\ 3 \\\\ -2\\end{aligned}]$ and $q=[\\begin{aligned}2 \\\\ -1 \\\\ 4 \\\\ -3 \\\\ 5\\end{aligned}]$, then $p\\cdot q=$" :question/worked-solution "To compute the dot product, we add up the products of corresponding components:\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{1}\\cdot {q}_{1}+{p}_{2}\\cdot {q}_{2}+{p}_{3}\\cdot {q}_{3}+{p}_{4}\\cdot {q}_{4}+{p}_{5}\\cdot {q}_{5} \\\\  & =(-5)\\cdot 2+4\\cdot (-1)+(-1)\\cdot 4+3\\cdot (-3)+(-2)\\cdot 5 \\\\  & =-10-4-4-9-10 \\\\  & =-37\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-34166/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ec386a91-fc52-56d8-8531-7e78a8464380"] :knowledge-point/questions ["q-34166"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73948/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "c66a270e-ca86-5beb-9729-02aa274201e3" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-73948/selection/9ab64b945e95c1c3798cea70f4ae7ad55133b01b9b894848e70b56c91ffbae97" :answer/id #uuid "623335d0-eaaf-5d80-9c98-1716ce280977" :answer/type :answer.type/math :answer/value "\\frac{4}{3}" :db/ensure [:answer/validate]} {:db/id "q-73948/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "4dba2444-c837-5ced-812d-27b51c18a5ad" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-73948/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "f87414d4-21c6-5a6c-ba5a-40f679330698" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-73948/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer/id #uuid "06508f63-3cd2-50d2-8d94-b65c50c16a4e" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "q-73948/selection" :answer-field/id #uuid "930120b1-a410-5cff-a8f8-6c2bb9be6141" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73948/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-73948/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-73948/selection/9ab64b945e95c1c3798cea70f4ae7ad55133b01b9b894848e70b56c91ffbae97" "q-73948/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-73948/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-73948/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393"] :db/ensure [:answer-field/validate]} {:db/id "q-73948" :question/id #uuid "d6e32ca4-4a9b-5134-925b-9f278db48738" :question/math-academy-id "q-73948" :question/problem "Let $v=[\\begin{aligned}x \\\\ 2x \\\\ 4 \\\\ -5\\end{aligned}]$ and $w=[\\begin{aligned}3x \\\\ -3 \\\\ x \\\\ 2\\end{aligned}].$\nIf $v\\cdot w=-2$ and $x>0$, find the value of $x.$" :question/worked-solution "Starting from the equation $v\\cdot w=-2,$ we compute the dot product in terms of $x$ and then solve for $x$ in the resulting equation:\n\n$$\n\\begin{aligned}v\\cdot w & =-2 \\\\ x\\cdot 3x+2x\\cdot (-3)+4\\cdot x+(-5)\\cdot 2 & =-2 \\\\ 3{x}^{2}-6x+4x-10 & =-2 \\\\ 3{x}^{2}-2x-8 & =0\\end{aligned}\n$$\n\nNow, using the quadratic formula, we obtain\n\n$$\n\\begin{aligned}x & =\\frac{-(-2)\\pm \\sqrt{(-2)^{2}-4(3)(-8)}}{2(3)} \\\\  & =\\frac{2\\pm \\sqrt{100}}{6} \\\\  & =\\frac{2\\pm 10}{6} \\\\  & =\\frac{1\\pm 5}{3}.\\end{aligned}\n$$\n\nSo, we get two solutions, ${x}_{1}=-\\frac{4}{3}$ and ${x}_{2}=2.$ Since we need $x>0$, our final answer is $x=2$ only." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-73948/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "94f8e0e5-8d8a-516a-8f46-d76e94305df4"] :knowledge-point/questions ["q-73948"] :db/ensure [:knowledge-point/validate]} {:db/id "q-105113/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "15797e5e-9db9-5a58-b532-a11a341516de" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-105113/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "7a01e5a4-790d-518e-9285-f827d352dde4" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-105113/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "6458f8b5-2971-5ee5-8d26-f6916e85f5a0" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-105113/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "ba8f1240-5a0d-52d6-b03a-99f40265474b" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-105113/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "bb8aa89d-459b-5736-9406-264cd54f38da" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-105113/selection" :answer-field/id #uuid "74cbb51e-7793-5eb0-898a-dfd50b4adfbc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-105113/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-105113/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" "q-105113/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-105113/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-105113/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-105113/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-105113" :question/id #uuid "deac67dd-ac41-532e-b698-b59c2d48e196" :question/math-academy-id "q-105113" :question/problem "Let $u=[\\begin{aligned}7 \\\\ 9 \\\\ 3t \\\\ 1 \\\\ -1\\end{aligned}]$ and $v=[\\begin{aligned}t \\\\ 2 \\\\ -5 \\\\ {t}^{2} \\\\ 5\\end{aligned}].$\nIf $u\\cdot v=-2$ and $t>3$, find the value of $t.$" :question/worked-solution "Starting from the equation $u\\cdot v=-2,$ we compute the dot product in terms of $t$ and then solve for $t$ in the resulting equation:\n\n$$\n\\begin{aligned}u\\cdot v & =-2 \\\\ 7\\cdot t+9\\cdot 2+3t\\cdot (-5)+1\\cdot {t}^{2}+(-1)\\cdot 5 & =-2 \\\\ 7t+18-15t+{t}^{2}-5 & =-2 \\\\ {t}^{2}-8t+15 & =0 \\\\ (t-3)(t-5) & =0\\end{aligned}\n$$\n\nWe get two solutions, ${t}_{1}=3$ and ${t}_{2}=5.$ Since we need $t>3$, our final answer is $t=5$ only." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-105113/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "94f8e0e5-8d8a-516a-8f46-d76e94305df4"] :knowledge-point/questions ["q-105113"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73949/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "35040f39-f44c-540b-bd7d-953decacae85" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-73949/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "d48b785e-520b-5b77-b990-4