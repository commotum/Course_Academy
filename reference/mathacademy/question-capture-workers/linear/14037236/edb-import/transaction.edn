dd up the products of corresponding components:\n\n$$\n\\begin{aligned}(-\\frac{1}{3}c)\\cdot d & =0\\cdot 9+2\\cdot 4+(-4)\\cdot (-2)+(-3)\\cdot 1+(-1)\\cdot 6 \\\\  & =0+8+8-3-6 \\\\  & =7\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-73941/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ec386a91-fc52-56d8-8531-7e78a8464380"] :knowledge-point/questions ["q-73941"] :db/ensure [:knowledge-point/validate]} {:db/id "q-105107/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "ba2dfc1e-1e88-5392-b1c7-6de148a166c3" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-105107/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "9aa085ef-b637-5798-b161-7ff94aebd986" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-105107/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "b16585e9-7603-5dd4-9aa6-6459372c62b4" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-105107/selection/23c0b4da815e7ba954fedc5e75955047cfe471feec4d2029849a63511c000fa3" :answer/id #uuid "a6f180e7-957b-553b-9c95-47057a5f90bb" :answer/type :answer.type/math :answer/value "-11" :db/ensure [:answer/validate]} {:db/id "q-105107/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "a89edb2c-bade-5f81-b4d9-74ec05693d36" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-105107/selection" :answer-field/id #uuid "4c7e25bd-f4ea-5979-98d6-1d84d3976d9c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-105107/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer-field/choices ["q-105107/selection/f853eeffac47c628af4a2b7e7b0ecd024652