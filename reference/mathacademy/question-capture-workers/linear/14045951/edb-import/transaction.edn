e]} {:db/id "q-317343/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "cb436df1-fc5e-5aa3-b304-7ae429d09dd4" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-317343/field-1" :answer-field/id #uuid "7bbda927-e36e-56a1-b2b5-82057a775df9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317343/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-317343/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-317343" :question/id #uuid "e1f1473a-4a24-51a0-9ef9-8abd69416c51" :question/math-academy-id "q-317343" :question/problem "Find $b\\cdot (c\\times a),$ if $b\\times c=⟨4,-1,6⟩$ and $a=⟨2,3,-1⟩.$\n\n$b\\cdot (c\\times a)=$\n{{field-1}}" :question/worked-solution "First, we compute the triple scalar product \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨2,3,-1⟩\\cdot ⟨4,-1,6⟩ \\\\  & =2\\cdot 4+3\\cdot (-1)+(-1)\\cdot 6 \\\\  & =8-3-6 \\\\  & =-1.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}b\\cdot (a\\times c)=1\\end{aligned}\n$$\n\nand again we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}b\\cdot (c\\times a)=-1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-317343/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3e0b4d33-7699-5068-90f1-663534cd662d"] :knowledge-point/questions ["q-317343"] :db/ensure [:knowledge-point/validate]}]
