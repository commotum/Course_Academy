#{[{:db/id #edb/ref 17592186105516 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "7ba6b6b5-ac1d-5a3a-876a-af51fdf50e0a" :knowledge-point/title "Calculating the Scalar Triple Product Using the Definition"}] :question/id #uuid "2f380683-0d93-541d-a07d-95a1d889c761" :question/math-academy-id "e-4347" :question/problem "Let $\\mathbf{a}=\\langle 2,-3,2 \\rangle,$ $\\mathbf{b}=\\langle -1,0,5 \\rangle,$ and $\\mathbf{c}=\\langle 1,2,3 \\rangle.$ Find $\\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c}).$" :question/worked-solution "First, we find the cross product:\n\n$$\n\\begin{aligned}b\\times c & =|\\begin{aligned}i & j & k \\\\ -1 & 0 & 5 \\\\ 1 & 2 & 3\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 5 \\\\ 2 & 3\\end{aligned}|i-|\\begin{aligned}-1 & 5 \\\\ 1 & 3\\end{aligned}|j+|\\begin{aligned}-1 & 0 \\\\ 1 & 2\\end{aligned}|k \\\\  & =(0\\cdot 3-5\\cdot 2)i-(-1\\cdot 3-5\\cdot 1)j+(-1\\cdot 2-0\\cdot 2)k \\\\  & =-10i+8j-2k \\\\  & =⟨-10,8,-2⟩\\end{aligned}\n$$\n\nNow, we can compute the scalar triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨2,-3,2⟩\\cdot ⟨-10,8,-2⟩ \\\\  & =2\\cdot (-10)+(-3)\\cdot 8+2\\cdot (-2) \\\\  & =-48\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105517 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "ff317cd2-0896-5134-b3a3-4e9f84e22b68" :knowledge-point/title "Calculating the Scalar Triple Product Using a Determinant"}] :question/id #uuid "b5cf98f2-087d-580c-a2f6-c37ad2af4c2c" :question/math-academy-id "e-4348" :question/problem "Let $\\mathbf{a}=\\langle 4,2,-1 \\rangle,$ $\\mathbf{b}=\\langle 0,2,1 \\rangle,$ and $\\mathbf{c}=\\langle -1,-1,2 \\rangle.$ Find $\\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c}).$" :question/worked-solution "Remember that the scalar triple product $\\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c})$ is just the determinant of the matrix whose rows are given by $\\mathbf{a},$ $\\mathbf{b},$ and $\\mathbf{c}.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}4 & 2 & -1 \\\\ 0 & 2 & 1 \\\\ -1 & -1 & 2\\end{aligned}| \\\\  & =4\\cdot |\\begin{aligned}2 & 1 \\\\ -1 & 2\\end{aligned}|-2\\cdot |\\begin{aligned}0 & 1 \\\\ -1 & 2\\end{aligned}|+(-1)\\cdot |\\begin{aligned}0 & 2 \\\\ -1 & -1\\end{aligned}| \\\\  & =4\\cdot (2\\cdot 2-1\\cdot (-1))-2\\cdot (0\\cdot 2-1\\cdot (-1))+(-1)\\cdot (0\\cdot (-1)-2\\cdot (-1)) \\\\  & =20-2-2 \\\\  & =16.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105518 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "3e0b4d33-7699-5068-90f1-663534cd662d" :knowledge-point/title "Calculating Scalar Triple Products Using Its Properties"}] :question/id #uuid "483b758a-9b14-5a72-87e5-70f27a0acf48" :question/math-academy-id "e-4349" :question/problem "Find $\\mathbf{c} \\cdot (\\mathbf{a} \\times \\mathbf{b}),$ if $2\\mathbf{a} \\cdot (\\mathbf{b} \\times 3\\mathbf{c}) = 5.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}2a\\cdot (b\\times 3c) & =5 \\\\ 2\\cdot [a\\cdot (b\\times 3c)] & =5 \\\\ 2\\cdot 3\\cdot [a\\cdot (b\\times c)] & =5 \\\\ a\\cdot (b\\times c) & =\\frac{5}{6}.\\end{aligned}\n$$\n\nThen, we swap $\\mathbf{a}$ and $\\mathbf{c}$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a) & =-\\frac{5}{6},\\end{aligned}\n$$\n\nand again we swap $\\mathbf{a}$ and $\\mathbf{b}$ to get\n\n$$\n\\begin{aligned}c\\cdot (a\\times b) & =\\frac{5}{6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186325460 :knowledge-point/_questions [{:knowledge-point/id #uuid "ff317cd2-0896-5134-b3a3-4e9f84e22b68" :knowledge-point/title "Calculating the Scalar Triple Product Using a Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f9a0d3d-a344-5650-a35c-669ce3abe6b6" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186325462} {:answer/id #uuid "34e5d4e2-f3bd-5976-808f-b3b817d0f2af" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186325463} {:answer/id #uuid "b0cb846b-dd4b-5919-8673-dfb4b693d399" :answer/type {:db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186325464} {:answer/id #uuid "83ee1e28-3663-5964-be84-3da65f02e2e3" :answer/type {:db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186325465} {:answer/id #uuid "7929220b-ecbf-5865-8f07-c382248e9103" :answer/type {:db/ident :answer.type/math} :answer/value "-60" :db/id #edb/ref 17592186325466}] :answer-field/correct {:answer/id #uuid "83ee1e28-3663-5964-be84-3da65f02e2e3" :answer/type {:db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186325465} :answer-field/id #uuid "8a2ca15b-e28e-511b-9ea3-53f0905a2721" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186325461}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e91f9522-ea1f-56c1-860c-f828215fa23d" :question/math-academy-id "q-128347" :question/problem "Let $p=⟨7,4,9⟩,$ $q=⟨1,2,-2⟩$ and $r=⟨3,0,5⟩.$ Find $q\\cdot (r\\times p).$" :question/worked-solution "Remember that the scalar triple product $q\\cdot (r\\times p)$ is just the determinant of the matrix whose rows are given by $q,$ $r,$ and $p.$\n\nSo, we have\n\n$$\n\\begin{aligned}q\\cdot (r\\times p) & =|\\begin{aligned}1 & 2 & -2 \\\\ 3 & 0 & 5 \\\\ 7 & 4 & 9\\end{aligned}| \\\\  & =1\\cdot |\\begin{aligned}0 & 5 \\\\ 4 & 9\\end{aligned}|-2\\cdot |\\begin{aligned}3 & 5 \\\\ 7 & 9\\end{aligned}|+(-2)\\cdot |\\begin{aligned}3 & 0 \\\\ 7 & 4\\end{aligned}| \\\\  & =(0\\cdot 9-4\\cdot 5)-2(3\\cdot 9-7\\cdot 5)-2(3\\cdot 4-7\\cdot 0) \\\\  & =-20+16-24 \\\\  & =-28.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186325467 :knowledge-point/_questions [{:knowledge-point/id #uuid "3e0b4d33-7699-5068-90f1-663534cd662d" :knowledge-point/title "Calculating Scalar Triple Products Using Its Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a5f5ed7-00f0-5a58-b323-53a0c4747865" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186325469} {:answer/id #uuid "7fb3313f-f8d2-526e-851f-b9b3e2fe73c1" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186325470} {:answer/id #uuid "577a7cf6-7241-5e85-957d-f553fe7bab7a" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186325471} {:answer/id #uuid "a0230f34-e505-50e0-89af-e4c66eed4fa0" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186325472} {:answer/id #uuid "2a7ce25e-f24a-519b-b1bb-d8a17c60d21a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186325473}] :answer-field/correct {:answer/id #uuid "2a7ce25e-f24a-519b-b1bb-d8a17c60d21a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186325473} :answer-field/id #uuid "c1bfe344-08ca-55a1-8b7a-55afdd906ddc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186325468}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f8a439b3-4c92-5c3c-9684-a208933c8994" :question/math-academy-id "q-128352" :question/problem "Find $c\\cdot (a\\times b),$ if $a\\cdot ((-3b)\\times (-7c))=7.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}a\\cdot ((-3b)\\times (-7c)) & =7 \\\\ (-3)\\cdot (-7)\\cdot [a\\cdot (b\\times c)] & =7 \\\\ a\\cdot (b\\times c) & =\\frac{1}{3}.\\end{aligned}\n$$\n\nThen, we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a) & =-\\frac{1}{3},\\end{aligned}\n$$\n\nand again we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}c\\cdot (a\\times b) & =\\frac{1}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304212 :knowledge-point/_questions [{:knowledge-point/id #uuid "3e0b4d33-7699-5068-90f1-663534cd662d" :knowledge-point/title "Calculating Scalar Triple Products Using Its Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a97dd138-70f2-5d39-8ba1-22919ce2fa27" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186304214} {:answer/id #uuid "93887c8c-3dd7-5829-88d6-832b484164cb" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186304215} {:answer/id #uuid "c16e8bc2-ebc8-5175-85b1-ab014e408913" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186304216} {:answer/id #uuid "d31af9ee-b637-534f-b2ef-8fc4ae864f4b" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186304217} {:answer/id #uuid "1e83007f-d2c6-5839-9037-7656b6766b65" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186304218}] :answer-field/correct {:answer/id #uuid "93887c8c-3dd7-5829-88d6-832b484164cb" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186304215} :answer-field/id #uuid "0bd0ac1c-3cb4-51e7-aa4a-416abf6f0134" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304213}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "3510e83f-4adc-58a8-b3a5-d0db2be677d4" :question/math-academy-id "q-18658" :question/problem "Find $b\\cdot (a\\times c)$, if $4a\\cdot (-b\\times c)=12.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}4a\\cdot (-b\\times c) & =12 \\\\ 4\\cdot (-1)\\cdot [a\\cdot (b\\times c)] & =12 \\\\ a\\cdot (b\\times c) & =-3.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}b\\cdot (a\\times c) & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186325474 :knowledge-point/_questions [{:knowledge-point/id #uuid "ff317cd2-0896-5134-b3a3-4e9f84e22b68" :knowledge-point/title "Calculating the Scalar Triple Product Using a Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b02e43b6-a39a-5839-820f-bdccba980028" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186325476} {:answer/id #uuid "788fa611-640d-59dd-b2fb-ea5d01bc150c" :answer/type {:db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186325477} {:answer/id #uuid "45faa782-fc29-53e5-a718-071ccacb4705" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186325478} {:answer/id #uuid "4033cd33-832d-53e6-b865-ae41e2ef2163" :answer/type {:db/ident :answer.type/math} :answer/value "-17" :db/id #edb/ref 17592186325479} {:answer/id #uuid "9ef7194e-11f6-58e6-9a8c-11ae27d85690" :answer/type {:db/ident :answer.type/math} :answer/value "-19" :db/id #edb/ref 17592186325480}] :answer-field/correct {:answer/id #uuid "b02e43b6-a39a-5839-820f-bdccba980028" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186325476} :answer-field/id #uuid "15bdc85a-e237-59dc-a0ba-40d345c47ee5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186325475}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "80db0c1a-ee85-5aeb-8256-d87509771477" :question/math-academy-id "q-20050" :question/problem "Let $a=⟨1,3,2⟩$, $b=⟨3,4,1⟩$ and $c=⟨2,0,1⟩.$ Find $a\\cdot (b\\times c).$" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}1 & 3 & 2 \\\\ 3 & 4 & 1 \\\\ 2 & 0 & 1\\end{aligned}| \\\\  & =1\\cdot |\\begin{aligned}4 & 1 \\\\ 0 & 1\\end{aligned}|-3\\cdot |\\begin{aligned}3 & 1 \\\\ 2 & 1\\end{aligned}|+2\\cdot |\\begin{aligned}3 & 4 \\\\ 2 & 0\\end{aligned}| \\\\  & =(4\\cdot 1-0\\cdot 1)-3(3\\cdot 1-2\\cdot 1)+2(3\\cdot 0-2\\cdot 4) \\\\  & =4-3-16 \\\\  & =-15.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186325481 :knowledge-point/_questions [{:knowledge-point/id #uuid "3e0b4d33-7699-5068-90f1-663534cd662d" :knowledge-point/title "Calculating Scalar Triple Products Using Its Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95bdd564-5852-571f-a336-ee429eb3aa63" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{4}" :db/id #edb/ref 17592186325483} {:answer/id #uuid "416f30c9-011b-59f1-8040-bfda6da11b9a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186325484} {:answer/id #uuid "ec7a6c59-cbb6-57d2-ba83-d418e738b7b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186325485} {:answer/id #uuid "da2e7952-3ee9-5e6f-b80b-46050f955d0d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186325486} {:answer/id #uuid "ab90d642-1c79-5806-adf1-31cb6141d483" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186325487}] :answer-field/correct {:answer/id #uuid "ec7a6c59-cbb6-57d2-ba83-d418e738b7b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186325485} :answer-field/id #uuid "7103bd9a-dd65-5ef5-a508-8b8340f8acc6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186325482}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a8f0a7e6-1e2f-5e30-bc7c-a856a460928b" :question/math-academy-id "q-20057" :question/problem "Find $b\\cdot (a\\times c)$, if $3a\\cdot (2b\\times (-c))=8.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}3a\\cdot (2b\\times (-c)) & =8 \\\\ 3\\cdot 2\\cdot (-1)\\cdot [a\\cdot (b\\times c)] & =8 \\\\ a\\cdot (b\\times c) & =-\\frac{4}{3}.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}b\\cdot (a\\times c) & =\\frac{4}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106055 :knowledge-point/_questions [{:knowledge-point/id #uuid "7ba6b6b5-ac1d-5a3a-876a-af51fdf50e0a" :knowledge-point/title "Calculating the Scalar Triple Product Using the Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2cc2c7d-6d7d-56bb-b0fc-a5d11a91631b" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186102568} {:answer/id #uuid "ccfdc17e-7f15-5084-877d-c62e5720d840" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186102569} {:answer/id #uuid "cf66877f-e1d9-57de-af50-b55875e6ff35" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186102570} {:answer/id #uuid "e261fb8f-6784-533a-92b6-65d53f3d4043" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186102571} {:answer/id #uuid "5b693362-98a6-5a3b-96da-aed5339f5de2" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186102572}] :answer-field/correct {:answer/id #uuid "ccfdc17e-7f15-5084-877d-c62e5720d840" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186102569} :answer-field/id #uuid "0b75aa05-f8f6-5186-83de-01946b258fe2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186102567}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "54e446ca-f780-515b-91f0-06748b3e67bc" :question/math-academy-id "q-20063" :question/problem "Find $a\\cdot (b\\times c)$ given that $a=⟨1,0,2⟩$ and $b\\times c=⟨-2,1,8⟩.$" :question/worked-solution "Substituting given vectors into the formula for the scalar triple product, we obtain \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨1,0,2⟩\\cdot ⟨-2,1,8⟩ \\\\  & =1\\cdot (-2)+0\\cdot 1+2\\cdot 8 \\\\  & =14.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186325488 :knowledge-point/_questions [{:knowledge-point/id #uuid "7ba6b6b5-ac1d-5a3a-876a-af51fdf50e0a" :knowledge-point/title "Calculating the Scalar Triple Product Using the Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f04a743f-843d-5a0f-b8c0-a4589a3b9158" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186325490}] :answer-field/correct {:answer/id #uuid "f04a743f-843d-5a0f-b8c0-a4589a3b9158" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186325490} :answer-field/id #uuid "365eded9-c6b0-5308-b4dd-28f04dbd12ce" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186325489}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1e96fc98-4911-5113-ab88-6925162a0a47" :question/math-academy-id "q-317302" :question/problem "Find $a\\cdot (b\\times c)$ given that $a=⟨\\sqrt{7},-2,5⟩$ and $b\\times c=⟨\\sqrt{7},3,-1⟩.$\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Substituting given vectors into the formula for the scalar triple product, we obtain \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨\\sqrt{7},-2,5⟩\\cdot ⟨\\sqrt{7},3,-1⟩ \\\\  & =(\\sqrt{7})(\\sqrt{7})+(-2)(3)+(5)(-1) \\\\  & =7-6-5 \\\\  & =-4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186325491 :knowledge-point/_questions [{:knowledge-point/id #uuid "7ba6b6b5-ac1d-5a3a-876a-af51fdf50e0a" :knowledge-point/title "Calculating the Scalar Triple Product Using the Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a288b65-8b71-5aea-9ff8-fdf518da6529" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186325493}] :answer-field/correct {:answer/id #uuid "5a288b65-8b71-5aea-9ff8-fdf518da6529" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186325493} :answer-field/id #uuid "b17956e5-6ff6-5f04-9344-be6df426cdb0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186325492}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f8084faa-c83e-5fad-abf5-bedd210fd50c" :question/math-academy-id "q-317304" :question/problem "Find $a\\cdot (b\\times c)$ given that $a=⟨0,\\,5,\\,\\sqrt{11}⟩$ and $b\\times c=⟨7,\\,-2,\\,\\sqrt{11}⟩.$\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Substituting given vectors into the formula for the scalar triple product, we obtain \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨0,\\,5,\\,\\sqrt{11}⟩\\cdot ⟨7,\\,-2,\\,\\sqrt{11}⟩ \\\\  & =(0)(7)+(5)(-2)+(\\sqrt{11})(\\sqrt{11}) \\\\  & =0-10+11 \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186325494 :knowledge-point/_questions [{:knowledge-point/id #uuid "ff317cd2-0896-5134-b3a3-4e9f84e22b68" :knowledge-point/title "Calculating the Scalar Triple Product Using a Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1ed1115-a6c4-56a4-bdd3-321959029acf" :answer/type {:db/ident :answer.type/math} :answer/value "56" :db/id #edb/ref 17592186325496}] :answer-field/correct {:answer/id #uuid "e1ed1115-a6c4-56a4-bdd3-321959029acf" :answer/type {:db/ident :answer.type/math} :answer/value "56" :db/id #edb/ref 17592186325496} :answer-field/id #uuid "4c1769f0-f697-5810-af19-6cb2fc87c80d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186325495}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "192e5009-8f66-524e-8d13-2212ca08e2eb" :question/math-academy-id "q-317317" :question/problem "Let $a=⟨1,2,3⟩$, $b=⟨4,0,-2⟩$ and $c=⟨5,6,1⟩.$ Find $a\\cdot (b\\times c)$ using a determinant.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}1 & 2 & 3 \\\\ 4 & 0 & -2 \\\\ 5 & 6 & 1\\end{aligned}| \\\\  & =1\\cdot |\\begin{aligned}0 & -2 \\\\ 6 & 1\\end{aligned}|\\,-\\,2\\cdot |\\begin{aligned}4 & -2 \\\\ 5 & 1\\end{aligned}|\\,+\\,3\\cdot |\\begin{aligned}4 & 0 \\\\ 5 & 6\\end{aligned}| \\\\  & =1\\,(0\\cdot 1-(-2)\\cdot 6)\\,-\\,2\\,(4\\cdot 1-(-2)\\cdot 5)\\,+\\,3\\,(4\\cdot 6-0\\cdot 5) \\\\  & =1\\,(12)\\,-\\,2\\,(14)\\,+\\,3\\,(24) \\\\  & =12-28+72 \\\\  & =56.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186325497 :knowledge-point/_questions [{:knowledge-point/id #uuid "ff317cd2-0896-5134-b3a3-4e9f84e22b68" :knowledge-point/title "Calculating the Scalar Triple Product Using a Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "343e78a7-96a6-5858-bb16-a9baff5872dd" :answer/type {:db/ident :answer.type/math} :answer/value "61" :db/id #edb/ref 17592186325499} {:answer/id #uuid "d9ea412a-ac59-54dc-a0f3-117c08a84eb2" :answer/type {:db/ident :answer.type/math} :answer/value "-61" :db/id #edb/ref 17592186325500}] :answer-field/correct {:answer/id #uuid "d9ea412a-ac59-54dc-a0f3-117c08a84eb2" :answer/type {:db/ident :answer.type/math} :answer/value "-61" :db/id #edb/ref 17592186325500} :answer-field/id #uuid "219e93a6-8a1d-5bd2-8a85-573a14d9975d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186325498}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "57d195f2-409b-5b85-9dc0-07acb5129669" :question/math-academy-id "q-317319" :question/problem "Let $a=⟨2,1,3⟩$, $b=⟨1,4,0⟩$ and $c=⟨6,-1,2⟩.$ Find $a\\cdot (b\\times c)$ using a determinant.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}2 & 1 & 3 \\\\ 1 & 4 & 0 \\\\ 6 & -1 & 2\\end{aligned}| \\\\  & =2\\cdot |\\begin{aligned}4 & 0 \\\\ -1 & 2\\end{aligned}|\\,-\\,1\\cdot |\\begin{aligned}1 & 0 \\\\ 6 & 2\\end{aligned}|\\,+\\,3\\cdot |\\begin{aligned}1 & 4 \\\\ 6 & -1\\end{aligned}| \\\\  & =2\\,(4\\cdot 2-0\\cdot (-1))\\,-\\,1\\,(1\\cdot 2-0\\cdot 6)\\,+\\,3\\,(1\\cdot (-1)-4\\cdot 6) \\\\  & =2\\,(8)\\,-\\,1\\,(2)\\,+\\,3\\,(-25) \\\\  & =16-2-75 \\\\  & =-61.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304252 :knowledge-point/_questions [{:knowledge-point/id #uuid "ff317cd2-0896-5134-b3a3-4e9f84e22b68" :knowledge-point/title "Calculating the Scalar Triple Product Using a Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1295f0c8-5405-5e5f-99c1-5d971d8e8a45" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186304254} {:answer/id #uuid "2334afd9-0be7-54c0-b5f2-0035f77eb0ee" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186304255} {:answer/id #uuid "80757b26-c636-5750-8f74-753e22c144e2" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186325501}] :answer-field/correct {:answer/id #uuid "1295f0c8-5405-5e5f-99c1-5d971d8e8a45" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186304254} :answer-field/id #uuid "abdf043b-d193-5249-a5fe-a761777736d5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304253}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c99f8fbd-de15-5333-b100-1f2625b9ef0c" :question/math-academy-id "q-317320" :question/problem "Let $a=⟨1,0,2⟩$, $b=⟨3,1,0⟩$ and $c=⟨4,2,5⟩.$ Find $a\\cdot (b\\times c)$ using a determinant.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}1 & 0 & 2 \\\\ 3 & 1 & 0 \\\\ 4 & 2 & 5\\end{aligned}| \\\\  & =1\\cdot |\\begin{aligned}1 & 0 \\\\ 2 & 5\\end{aligned}|\\,-\\,0\\cdot |\\begin{aligned}3 & 0 \\\\ 4 & 5\\end{aligned}|\\,+\\,2\\cdot |\\begin{aligned}3 & 1 \\\\ 4 & 2\\end{aligned}| \\\\  & =1\\,(1\\cdot 5-0\\cdot 2)\\,-\\,0\\,(3\\cdot 5-0\\cdot 4)\\,+\\,2\\,(3\\cdot 2-1\\cdot 4) \\\\  & =1\\,(5)\\,-\\,0\\,(15)\\,+\\,2\\,(2) \\\\  & =5+0+4 \\\\  & =9.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186325502 :knowledge-point/_questions [{:knowledge-point/id #uuid "3e0b4d33-7699-5068-90f1-663534cd662d" :knowledge-point/title "Calculating Scalar Triple Products Using Its Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cb436df1-fc5e-5aa3-b304-7ae429d09dd4" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186325504}] :answer-field/correct {:answer/id #uuid "cb436df1-fc5e-5aa3-b304-7ae429d09dd4" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186325504} :answer-field/id #uuid "7bbda927-e36e-56a1-b2b5-82057a775df9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186325503}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e1f1473a-4a24-51a0-9ef9-8abd69416c51" :question/math-academy-id "q-317343" :question/problem "Find $b\\cdot (c\\times a),$ if $b\\times c=⟨4,-1,6⟩$ and $a=⟨2,3,-1⟩.$\n\n$b\\cdot (c\\times a)=$\n{{field-1}}" :question/worked-solution "First, we compute the triple scalar product \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨2,3,-1⟩\\cdot ⟨4,-1,6⟩ \\\\  & =2\\cdot 4+3\\cdot (-1)+(-1)\\cdot 6 \\\\  & =8-3-6 \\\\  & =-1.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}b\\cdot (a\\times c)=1\\end{aligned}\n$$\n\nand again we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}b\\cdot (c\\times a)=-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186325505 :knowledge-point/_questions [{:knowledge-point/id #uuid "7ba6b6b5-ac1d-5a3a-876a-af51fdf50e0a" :knowledge-point/title "Calculating the Scalar Triple Product Using the Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e729854-4bf1-5961-beb3-ba1a72b2c6d7" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186325507} {:answer/id #uuid "d09e15a4-7c13-568e-a570-fc9e3902259d" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186325508} {:answer/id #uuid "a92c2ee1-6a99-5609-b4e3-631380d9c995" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186325509} {:answer/id #uuid "9e82e3a2-053e-5768-8a34-8f3d881ac045" :answer/type {:db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186325510} {:answer/id #uuid "94c25a54-1110-5d27-b12b-bbc3dcb2c220" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186325511}] :answer-field/correct {:answer/id #uuid "4e729854-4bf1-5961-beb3-ba1a72b2c6d7" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186325507} :answer-field/id #uuid "5058bb6e-7250-5d26-8ec4-d5b0a463e069" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186325506}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6d564fbe-e6b5-5480-8918-6d6776762bbd" :question/math-academy-id "q-73458" :question/problem "Given that $a=⟨-2,4,3⟩,$ $b=⟨-1,3,2⟩,$ and $c=⟨2,-1,4⟩,$ find $a\\cdot (b\\times c)$ using the definition of the scalar triple product." :question/worked-solution "First, we find the cross product:\n\n$$\n\\begin{aligned}b\\times c & =|\\begin{aligned}i & j & k \\\\ -1 & 3 & 2 \\\\ 2 & -1 & 4\\end{aligned}| \\\\  & =|\\begin{aligned}3 & 2 \\\\ -1 & 4\\end{aligned}|i-|\\begin{aligned}-1 & 2 \\\\ 2 & 4\\end{aligned}|j+|\\begin{aligned}-1 & 3 \\\\ 2 & -1\\end{aligned}|k \\\\  & =(3\\cdot 4-2\\cdot (-1))i-((-1)\\cdot 4-2\\cdot 2)j+((-1)\\cdot (-1)-3\\cdot 2)k \\\\  & =14i+8j-5k \\\\  & =⟨14,8,-5⟩\\end{aligned}\n$$\n\nNow, we can compute the scalar triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-2,4,3⟩\\cdot ⟨14,8,-5⟩ \\\\  & =(-2)\\cdot 14+4\\cdot 8+3\\cdot (-5) \\\\  & =-11.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186325512 :knowledge-point/_questions [{:knowledge-point/id #uuid "7ba6b6b5-ac1d-5a3a-876a-af51fdf50e0a" :knowledge-point/title "Calculating the Scalar Triple Product Using the Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb8877e6-767d-58e7-b176-1f5f6c2f2e72" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186325514} {:answer/id #uuid "48465873-5c8f-504f-a6d0-ce053462ea2b" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186325515} {:answer/id #uuid "72a718ff-6323-558a-a858-67fc7e2271a3" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186325516} {:answer/id #uuid "afab3324-438b-5276-b49e-7969bc2eb9f4" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186325517} {:answer/id #uuid "a9cfe596-e861-5273-a5e2-95fd4d21ab3c" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186325518}] :answer-field/correct {:answer/id #uuid "72a718ff-6323-558a-a858-67fc7e2271a3" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186325516} :answer-field/id #uuid "e8aee5a4-6f62-54f7-bdf9-b5eefaadfa02" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186325513}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "753f723d-a0a1-5e8a-8afb-5f9d1f35cfae" :question/math-academy-id "q-73459" :question/problem "Given that $a=⟨-2,0,-1⟩,$ $b=⟨-2,-1,0⟩,$ and $c=⟨3,1,4⟩,$ find $a\\cdot (b\\times c)$ using the definition of the scalar triple product." :question/worked-solution "First, we find the cross product:\n\n$$\n\\begin{aligned}b\\times c & =|\\begin{aligned}i & j & k \\\\ -2 & -1 & 0 \\\\ 3 & 1 & 4\\end{aligned}| \\\\  & =|\\begin{aligned}-1 & 0 \\\\ 1 & 4\\end{aligned}|i-|\\begin{aligned}-2 & 0 \\\\ 3 & 4\\end{aligned}|j+|\\begin{aligned}-2 & -1 \\\\ 3 & 1\\end{aligned}|k \\\\  & =((-1)\\cdot 4-0\\cdot 1)i-((-2)\\cdot 4-0\\cdot 3)j+((-2)\\cdot 1-(-1)\\cdot 3)k \\\\  & =-4i+8j+k \\\\  & =⟨-4,8,1⟩\\end{aligned}\n$$\n\nNow, we can compute the scalar triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-2,0,-1⟩\\cdot ⟨-4,8,1⟩ \\\\  & =(-2)\\cdot (-4)+0\\cdot 8+(-1)\\cdot 1 \\\\  & =7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304266 :knowledge-point/_questions [{:knowledge-point/id #uuid "3e0b4d33-7699-5068-90f1-663534cd662d" :knowledge-point/title "Calculating Scalar Triple Products Using Its Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b10548b2-ba23-57c9-8e9f-efb6408540fa" :answer/type {:db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186304268} {:answer/id #uuid "882fee4d-a313-5036-8aa0-6990f6344c53" :answer/type {:db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186304269} {:answer/id #uuid "7c36065e-c546-5040-892d-0afeb58e039c" :answer/type {:db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186304270} {:answer/id #uuid "257852e8-5d5a-5e0d-bf36-26c0bddadb95" :answer/type {:db/ident :answer.type/math} :answer/value "-26" :db/id #edb/ref 17592186304271} {:answer/id #uuid "d27156bd-b73a-55a3-8410-555a0fa4c033" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186304272}] :answer-field/correct {:answer/id #uuid "257852e8-5d5a-5e0d-bf36-26c0bddadb95" :answer/type {:db/ident :answer.type/math} :answer/value "-26" :db/id #edb/ref 17592186304271} :answer-field/id #uuid "3bf5f324-5e79-5cde-aeed-51d58a38a052" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304267}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6b76eac9-1fca-591a-8edf-8b517293adda" :question/math-academy-id "q-73470" :question/problem "Find $c\\cdot (b\\times a)$, if $b\\times c=⟨3,-1,2⟩$ and $a=⟨4,-2,6⟩.$" :question/worked-solution "First, we compute the triple scalar product \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨4,-2,6⟩\\cdot ⟨3,-1,2⟩ \\\\  & =4\\cdot 3+(-2)\\cdot (-1)+6\\cdot 2 \\\\  & =12+2+12 \\\\  & =26.\\end{aligned}\n$$\n\nThen, we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a)=-26.\\end{aligned}\n$$"}]}
