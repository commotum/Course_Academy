4139534994 true] [17592186325460 1145 "Remember that the scalar triple product $q\\cdot (r\\times p)$ is just the determinant of the matrix whose rows are given by $q,$ $r,$ and $p.$\n\nSo, we have\n\n$$\n\\begin{aligned}q\\cdot (r\\times p) & =|\\begin{aligned}1 & 2 & -2 \\\\ 3 & 0 & 5 \\\\ 7 & 4 & 9\\end{aligned}| \\\\  & =1\\cdot |\\begin{aligned}0 & 5 \\\\ 4 & 9\\end{aligned}|-2\\cdot |\\begin{aligned}3 & 5 \\\\ 7 & 9\\end{aligned}|+(-2)\\cdot |\\begin{aligned}3 & 0 \\\\ 7 & 4\\end{aligned}| \\\\  & =(0\\cdot 9-4\\cdot 5)-2(3\\cdot 9-7\\cdot 5)-2(3\\cdot 4-7\\cdot 0) \\\\  & =-20+16-24 \\\\  & =-28.\\end{aligned}\n$$" 13194139534994 true] [17592186325461 1000 #edb/ref 17592186325462 13194139534994 true] [17592186325461 1000 #edb/ref 17592186325463 13194139534994 true] [17592186325461 1000 #edb/ref 17592186325464 13194139534994 true] [17592186325461 1000 #edb/ref 17592186325465 13194139534994 true] [17592186325461 1000 #edb/ref 17592186325466 13194139534994 true] [17592186325461 1040 #edb/ref 17592186045450 13194139534994 true] [17592186325461 1041 "selection" 13194139534994 true] [17592186325461 1104 #edb/ref 17592186325465 13194139534994 true] [17592186325461 1110 #uuid "8a2ca15b-e28e-511b-9ea3-53f0905a2721" 13194139534994 true] [17592186325462 1034 "12" 13194139534994 true] [17592186325462 1103 #edb/ref 17592186045453 13194139534994 true] [17592186325462 1111 #uuid "4f9a0d3d-a344-5650-a35c-669ce3abe6b6" 13194139534994 true] [17592186325463 1034 "20" 13194139534994 true] [17592186325463 1103 #edb/ref 17592186045453 13194139534994 true] [17592186325463 1111 #uuid "34e5d4e2-f3bd-5976-808f-b3b817d0f2af" 13194139534994 true] [17592186325464 1034 "-20" 13194139534994 true] [17592186325464 1103 #edb/ref 17592186045453 13194139534994 true] [17592186325464 1111 #uuid "b0cb846b-dd4b-5919-8673-dfb4b693d399" 13194139534994 true] [17592186325465 1034 "-28" 13194139534994 true] [17592186325465 1103 #edb/ref 17592186045453 13194139534994 true] [17592186325465 1111 #uuid "83e