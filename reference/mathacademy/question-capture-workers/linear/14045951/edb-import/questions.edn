/ref 17592186304253}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c99f8fbd-de15-5333-b100-1f2625b9ef0c" :question/math-academy-id "q-317320" :question/problem "Let $a=⟨1,0,2⟩$, $b=⟨3,1,0⟩$ and $c=⟨4,2,5⟩.$ Find $a\\cdot (b\\times c)$ using a determinant.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}1 & 0 & 2 \\\\ 3 & 1 & 0 \\\\ 4 & 2 & 5\\end{aligned}| \\\\  & =1\\cdot |\\begin{aligned}1 & 0 \\\\ 2 & 5\\end{aligned}|\\,-\\,0\\cdot |\\begin{aligned}3 & 0 \\\\ 4 & 5\\end{aligned}|\\,+\\,2\\cdot |\\begin{aligned}3 & 1 \\\\ 4 & 2\\end{aligned}| \\\\  & =1\\,(1\\cdot 5-0\\cdot 2)\\,-\\,0\\,(3\\cdot 5-0\\cdot 4)\\,+\\,2\\,(3\\cdot 2-1\\cdot 4) \\\\  & =1\\,(5)\\,-\\,0\\,(15)\\,+\\,2\\,(2) \\\\  & =5+0+4 \\\\  & =9.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304266 :knowledge-point/_questions [{:knowledge-point/id #uuid "3e0b4d33-7699-5068-90f1-663534cd662d" :knowledge-point/title "Calculating Scalar Triple Products Using Its Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b10548b2-ba23-57c9-8e9f-efb6408540fa" :answer/type {:db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186304268} {:answer/id #uuid "882fee4d-a313-5036-8aa0-6990f6344c53" :answer/type {:db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186304269} {:answer/id #uuid "7c36065e-c546-5040-892d-0afeb58e039c" :answer/type {:db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186304270} {:answer/id #uuid "257852e8-5d5a-5e0d-bf36-26c0bddadb95" :answer/type {:db/ident :answer.type/math} :answer/value "-26" :db/id #edb/ref 17592186304271} {:answer/id #uuid "d27156bd-b73a-55a3-8410-555a0fa4c033" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186304272}] :answer-field/correct {:answer/id #uuid "257852e8-5d5a-5e0d-bf36-26c0bddadb95" :answer/type {:db/ident :answer.type/math} :answer/value "-26" :db/id #edb/ref 17592186304271} :answer-field/id #uuid "3bf5f324-5e79-5cde-aeed-51d58a38a052" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304267}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6b76eac9-1fca-591a-8edf-8b517293adda" :question/math-academy-id "q-73470" :question/problem "Find $c\\cdot (b\\times a)$, if $b\\times c=⟨3,-1,2⟩$ and $a=⟨4,-2,6⟩.$" :question/worked-solution "First, we compute the triple scalar product \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨4,-2,6⟩\\cdot ⟨3,-1,2⟩ \\\\  & =4\\cdot 3+(-2)\\cdot (-1)+6\\cdot 2 \\\\  & =12+2+12 \\\\  & =26.\\end{aligned}\n$$\n\nThen, we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a)=-26.\\end{aligned}\n$$"}]}
