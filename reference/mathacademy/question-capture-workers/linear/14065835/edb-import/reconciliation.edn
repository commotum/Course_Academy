3}\\cdot {v}_{3}=1.\\end{aligned}$\n\n- ${w}_{1}\\cdot {w}_{2}=0\\,\\text{and}\\,{\\begin{aligned}{w}_{1}\\cdot {w}_{1}=1 \\\\ {w}_{2}\\cdot {w}_{2}=1.\\end{aligned}$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ we get the following:\n\n$$\n\\begin{aligned}{u}_{1}\\cdot {u}_{2} & =[\\begin{aligned}\\frac{2}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}}\\end{aligned}]\\cdot [\\begin{aligned}-\\frac{3}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}}\\end{aligned}]=-\\frac{6}{13}+\\frac{6}{13}=0 & ✓ \\\\ {u}_{1}\\cdot {u}_{1} & =[\\begin{aligned}\\frac{2}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{2}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}}\\end{aligned}]=\\frac{4}{13}+\\frac{9}{13}=1 & ✓ \\\\ {u}_{2}\\cdot {u}_{2} & =[\\begin{aligned}-\\frac{3}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}}\\end{aligned}]\\cdot [\\begin{aligned}-\\frac{3}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}}\\end{aligned}]=\\frac{9}{13}+\\frac{4}{13}=1 & ✓\\end{aligned}\n$$\n\nSo, the set $U$ is orthonormal.\n\n- For the set $V,$ notice that\n\n$$\n\\begin{aligned}{v}_{1}\\cdot {v}_{2} & =[\\begin{aligned}2 \\\\ 1 \\\\ -2\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ 1 \\\\ -4\\end{aligned}]=0+1+8=9\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $V$ is not an orthonormal set.\n\n- For the set $W,$ we get the following:\n\n$$\n\\begin{aligned}{w}_{1}\\cdot {w}_{2} & =[\\begin{aligned}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}}\\end{aligned}]=\\frac{2}{5}-\\frac{2}{5}=0 & ✓ \\\\ {w}_{1}\\cdot {w}_{1} & =[\\begin{aligned}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{aligned}]=\\frac{4}{5}+\\frac{1}{5}=1 & ✓ \\\\ {w}_{2}\\cdot {w}_{2} & =[\\begin{aligned}\\frac{1}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}}\\end{aligned}]=\\frac{1}{5}+\\frac{4}{5}=1 & ✓\\end{aligned}\n$$\n\nSo, $W$ is an orthonormal set.\n\nTherefore, we conclude that the correct answer is \"$U$ and $W$ only\"." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14065835/state.json" "file_sha256" "90bc1d1c02215c18ab4d5ef38d8b0c7be605d3ca5dddcc3462a3a343d11dbe98"} {"question" "q-83745" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14065835/activity-metadata.json" "file_sha256" "52fb4d41f7f79cc37fe0f30820d6d822a80db72567db5d73b391c781369ab09d"} {"question" "q-83745" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14065835/state.json" "file_sha256" "90bc1d1c02215c18ab4d5ef38d8b0c7be605d3ca5dddcc3462a3a343d11dbe98"} {"question" "q-83745" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "$U$ and $V$ only"] ["text" "$U$ and $W$ only"] ["text" "$U$ only"] ["text" "$V$ and $W$ only"] ["text" "$W$ only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14065835/state.json" "file_sha256" "90bc1d1c02215c18ab4d5ef38d8b0c7be605d3ca5dddcc3462a3a343d11dbe98"} {"question" "q-83745" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "$U$ and $W$ only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14065835/state.json" "file_sha256" "90bc1d1c02215c18ab4d5ef38d8b0c7be605d3ca5dddcc3462a3a343d11dbe98"} {"question" "q-39398" "field" nil "attribute" "question/problem" "value" "Which of the following sets are orthonormal?\n\n- $U={[\\begin{aligned}-\\frac{3}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}}\\end{aligned}],[\\begin{aligned}\\frac{1}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}}\\end{aligned}]}$\n- $V={[\\begin{aligned}2 \\\\ 3 \\\\ -1\\end{aligned}],[\\begin{aligned}3 \\\\ 1 \\\\ 9\\end{aligned}],[\\begin{aligned}28 \\\\ -21 \\\\ -7\\end{aligned}]}$\n- $W={[\\begin{aligned}\\frac{3}{5} \\\\ \\frac{4}{5}\\end{aligned}],[\\begin{aligned}\\frac{4}{5} \\\\ -\\frac{3}{5}\\end{aligned}]}$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14065835/state.json" "file_sha256" "90bc1d1c02215c18ab4d5ef38d8b0c7be605d3ca5dddcc3462a3a343d11dbe98"} {"question" "q-39398" "field" nil "attribute" "question/worked-solution" "value" "Let's denote the vectors of the given sets as \n${{u}_{1},{u}_{2}},$ \n${{v}_{1},{v}_{2},{v}_{3}},$ and \n${{w}_{1},{w}_{2}},$ respectively. \n\nThe sets $U,V,$ and $W$ are orthonormal if the following conditions on each set hold:\n\n- ${u}_{1}\\cdot {u}_{2}=0\\,\\text{and}\\,{\\begin{aligned}{u}_{1}\\cdot {u}_{1}=1 \\\\ {u}_{2}\\cdot {u}_{2}=1.\\end{aligned}$\n\n- ${\\begin{aligned}{v}_{1}\\cdot {v}_{2}=0 \\\\ {v}_{1}\\cdot {v}_{3}=0 \\\\ {v}_{2}\\cdot {v}_{3}=0\\end{aligned}\\,\\text{and}\\,{\\begin{aligned}{v}_{1}\\cdot {v}_{1}=1 \\\\ {v}_{2}\\cdot {v}_{2}=1 \\\\ {v}_{3}\\cdot {v}_{3}=1.\\end{aligned}$\n\n- ${w}_{1}\\cdot {w}_{2}=0\\,\\text{and}\\,{\\begin{aligned}{w}_{1}\\cdot {w}_{1}=1 \\\\ {w}_{2}\\cdot {w}_{2}=1.\\end{aligned}$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ we get the following:\n\n$$\n\\begin{aligned}{u}_{1}\\cdot {u}_{2} & =[\\begin{aligned}-\\frac{3}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}}\\end{aligned}]=-\\frac{3}{10}+\\frac{3}{10}=0 & ✓ \\\\ {u}_{1}\\cdot {u}_{1} & =[\\begin{aligned}-\\frac{3}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}}\\end{aligned}]\\cdot [\\begin{aligned}-\\frac{3}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}}\\end{aligned}]=\\frac{9}{10}+\\frac{1}{10}=1 & ✓ \\\\ {u}_{2}\\cdot {u}_{2} & =[\\begin{aligned}\\frac{1}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}}\\end{aligned}]=\\frac{1}{10}+\\frac{9}{10}=1 & ✓\\end{aligned}\n$$\n\nSo, the set $U$ is orthonormal.\n\n- For the set $V,$ notice that\n\n$$\n\\begin{aligned}{v}_{1}\\cdot {v}_{1} & =[\\begin{aligned}2 \\\\ 3 \\\\ -1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 3 \\\\ -1\\end{aligned}]=4+9+1=14\\ne 1 & \\times \\end{aligned}\n$$\n\nSo, $V$ is not an orthonormal set.\n\n- For the set $W,$ we get the following:\n\n$$\n\\begin{aligned}{w}_{1}\\cdot {w}_{2} & =[\\begin{aligned}\\frac{3}{5} \\\\ \\frac{4}{5}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{4}{5} \\\\ -\\frac{3}{5}\\end{aligned}]=\\frac{12}{25}-\\frac{12}{25}=0 & ✓ \\\\ {w}_{1}\\cdot {w}_{1} & =[\\begin{aligned}\\frac{3}{5} \\\\ \\frac{4}{5}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{3}{5} \\\\ \\frac{4}{5}\\end{aligned}]=\\frac{9}{25}+\\frac{16}{25}=1 & ✓ \\\\ {w}_{2}\\cdot {w}_{2} & =[\\begin{aligned}\\frac{4}{5} \\\\ -\\frac{3}{5}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{4}{5} \\\\ -\\frac{3}{5}\\end{aligned}]=\\frac{16}{25}+\\frac{9}{25}=1 & ✓\\end{aligned}\n$$\n\nSo, $W$ is an orthonormal set.\n\nTherefore, we conclude that the correct answer is \"$U$ and $W$ only\"." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14065835/state.json" "file_sha256" "90bc1d1c02215c18ab4d5ef38d8b0c7be605d3ca5dddcc3462a3a343d11dbe98"} {"question" "q-39398" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14065835/activity-metadata.json" "file_sha256" "52fb4d41f7f79cc37fe0f30820d6d822a80db72567db5d73b391c781369ab