ype/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186131677}] :answer-field/correct {:answer/id #uuid "f5cab8ee-13da-5fc7-9a96-16992918ff9f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186131675} :answer-field/id #uuid "25ce97c3-2de2-5a97-b4d1-c06708bd1f09" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186131672}] :question/id #uuid "455820f5-9352-535f-a3b2-e3fbc55031b5" :question/math-academy-id "q-40297" :question/problem "Consider the orthogonal set $U$ below. By adding a new vector $x = [x_{1}, x_{2}, x_{3}]^{T}$, extend the set so that it forms an orthogonal basis of $R^{3}$. What is the value of $\\frac{x_{1}}{x_{2}}$?\n\n$U = {\\begin{bmatrix}1 \\\\ 2 \\\\ 1\\end{bmatrix}, \\begin{bmatrix}0 \\\\ -3 \\\\ 6\\end{bmatrix}}$"}] [{:db/id #edb/ref 17592186134438 :knowledge-point/_questions [{:knowledge-point/id #uuid "baf333d2-6bd9-5d79-9c07-85856c81672a" :knowledge-point/title "Extending a Set to Form an Orthonormal Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "adfa01f5-5f50-5732-a9db-ac0621c041cb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{\\sqrt{13}}" :db/id #edb/ref 17592186133071} {:answer/id #uuid "d3d6d15e-984d-5cc1-8a0a-28097dea73fa" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186133072} {:answer/id #uuid "e72e8102-ebfc-5bbd-a48a-99e7c0980a11" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}" :db/id #edb/ref 17592186133073} {:answer/id #uuid "2c75ffbf-3ef4-5005-92fe-66944038f963" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{\\sqrt{13}}" :db/id #edb/ref 17592186133074} {:answer/id #uuid "53621beb-a184-5c08-8412-4681af661920" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{\\sqrt{2}}" :db/id #edb/ref 17592186133075}] :answer-field/correct {:answer/id #uuid "2c75ffbf-3ef4-5005