 \\\\ 5\\end{aligned}],[\\begin{aligned}-3 \\\\ 4 \\\\ 2\\end{aligned}],[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]}$\n- $V={[\\begin{aligned}-2 \\\\ 5\\end{aligned}],[\\begin{aligned}4 \\\\ 2\\end{aligned}]}$\n- $W={[\\begin{aligned}3 \\\\ 4 \\\\ -1\\end{aligned}],[\\begin{aligned}5 \\\\ -3 \\\\ 1\\end{aligned}],[\\begin{aligned}-2 \\\\ -1 \\\\ -2\\end{aligned}]}$" :question/worked-solution "Let's denote the vectors of the given sets as \n${{u}_{1},{u}_{2},{u}_{3}},$\n${{v}_{1},{v}_{2}},$ and \n${{w}_{1},{w}_{2},{w}_{3}},$ respectively. \n\nThe sets $U,V,$ and $W$ are orthogonal if the following conditions on each set hold:\n\n- ${u}_{1}\\cdot {u}_{2}=0,\\,{u}_{1}\\cdot {u}_{3}=0,\\,{u}_{2}\\cdot {u}_{3}=0.$\n\n- ${v}_{1}\\cdot {v}_{2}=0.$\n\n- ${w}_{1}\\cdot {w}_{2}=0,\\,{w}_{1}\\cdot {w}_{3}=0,\\,{w}_{2}\\cdot {w}_{3}=0.$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ we get the following:\n\n$$\n\\begin{aligned}{u}_{1}\\cdot {u}_{2} & =[\\begin{aligned}-2 \\\\ -4 \\\\ 5\\end{aligned}]\\cdot [\\begin{aligned}-3 \\\\ 4 \\\\ 2\\end{aligned}]=6-16+10=0 & ✓ \\\\ {u}_{1}\\cdot {u}_{3} & =[\\begin{aligned}-2 \\\\ -4 \\\\ 5\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]=0+0+0=0 & ✓ \\\\ {u}_{2}\\cdot {u}_{3} & =[\\begin{aligned}-3 \\\\ 4 \\\\ 2\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]=0+0+0=0 & ✓\\end{aligned}\n$$\n\nSo, the set $U$ is orthogonal.\n\n- For the set $V,$ notice that\n\n$$\n\\begin{aligned}{v}_{1}\\cdot {v}_{2} & =[\\begin{aligned}-2 \\\\ 5\\end{aligned}]\\cdot [\\begin{aligned}4 \\\\ 2\\end{aligned}]=-8+10=2\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $V$ is not an orthogonal set.\n\n- For the set $W,$ notice that \n\n$$\n\\begin{aligned}{w}_{1}\\cdot {w}_{2} & =[\\begin{aligned}3 \\\\ 4 \\\\ -1\\end{aligned}]\\cdot [\\begin{aligned}5 \\\\ -3 \\\\ 1\\end{aligned}]=15-12-1=2\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $W$ is not an orthogonal set.\n\nTherefore, we conclude that the correct answer is \"$U$ only\"." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-39396/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ee1838df-f1d6-5bc4-908c-b96e2ad577c9"] :knowledge-point/questions ["q-39396"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81109/selection/ada5cc9b7cb3c1f0ee40e3f0daf3ce48624840426207eb57c599d2352c73fca0" :answer/id #uuid "0eb755b4-1961-5662-889a-786a379f3c93" :answer/type :answer.type/text :answer/value "$U$ and $V$ only" :db/ensure [:answer/validate]} {:db/id "q-81109/selection/1454d2f1915a335c7d01677c9b98fbae5aedebb848a7a30361c0ea47ca70fb1e" :answer/id #uuid "6861ec02-a13f-554b-b9fb-32dc2bce9f14" :answer/type :answer.type/text :answer/value "$V$ and $W$ only" :db/ensure [:answer/validate]} {:db/id "q-81109/selection/e2d52a456cba49e8b5bad42a80eb2a8b1b2bb244f8c178b51f34d013592f152f" :answer/id #uuid "c7d397c7-b17c-5495-bb75-530b8fa38635" :answer/type :answer.type/text :answer/value "$W$ only" :db/ensure [:answer/validate]} {:db/id "q-81109/selection/6c5d8db382b33f30f332b189fe1fe2973356c5fdb6f69748c83cf4a47a8bf0ab" :answer/id #uuid "40a06e60-3da0-5fee-a32a-2f9c8c68c98c" :answer/type :answer.type/text :answer/value "$V$ only" :db/ensure [:answer/validate]} {:db/id "q-81109/selection/04646d488959d0b10c98bd9055615c2535925a7b59f21ec7dcdb79a9fb18da0d" :answer/id #uuid "21b29d5d-4a22-5353-be43-060388a35327" :answer/type :answer.type/text :answer/value "$U$ and $W$ only" :db/ensure [:answer/validate]} {:db/id "q-81109/selection" :answer-field/id #uuid "4aee4e82-3e74-5c3d-8489-7a7e325b4b51" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81109/selection/1454d2f1915a335c7d01677c9b98fbae5aedebb848a7a30361c0ea47ca70fb1e" :answer-field/choices ["q-81109/selection/ada5cc9b7cb3c1f0ee40e3f0daf3ce48624840426207eb57c599d2352c73fca0" "q-81109/selection/1454d2f1915a335c7d01677c9b98fbae5aedebb848a7a30361c0ea47ca70fb1e" "q-81109/selection/e2d52a456cba49e8b5bad42a80eb2a8b1b2bb244f8c178b51f34d013592f152f" "q-81109/selection/6c5d8db382b33f30f332b189fe1fe2973356c5fdb6f69748c83cf4a47a8bf0ab" "q-81109/selection/04646d488959d0b10c98bd9055615c2535925a7b59f21ec7dcdb79a9fb18da0d"] :db/ensure [:answer-field/validate]} {:db/id "q-81109" :question/id #uuid "d80cbd9a-e77a-5108-ac36-72cd3ed5f0f6" :question/math-academy-id "q-81109" :question/problem "Which of the following sets are orthonormal?\n\n- $U={[\\begin{aligned}1 \\\\ -5 \\\\ -2\\end{aligned}],[\\begin{aligned}2 \\\\ 0 \\\\ 1\\end{aligned}],[\\begin{aligned}-2 \\\\ -2 \\\\ 4\\end{aligned}]}$\n- $V={[\\begin{aligned}\\frac{2}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}}\\end{aligned}],[\\begin{aligned}-\\frac{3}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}}\\end{aligned}]}$\n- $W={[\\begin{aligned}\\frac{1}{\\sqrt{6}} \\\\ \\frac{2}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{6}}\\end{aligned}],[\\begin{aligned}\\frac{1}{\\sqrt{3}} \\\\ -\\frac{1}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{3}}\\end{aligned}]}$" :question/worked-solution "Let's denote the vectors of the given sets as \n${{u}_{1},{u}_{2},{u}_{3}},$ \n${{v}_{1},{v}_{2}},$ and \n${{w}_{1},{w}_{2}},$ respectively. \n\nThe sets $U,V,$ and $W$ are orthonormal if the following conditions on each set hold:\n\n- ${\\begin{aligned}{u}_{1}\\cdot {u}_{2}=0 \\\\ {u}_{1}\\cdot {u}_{3}=0 \\\\ {u}_{2}\\cdot {u}_{3}=0\\end{aligned}\\,\\text{and}\\,{\\begin{aligned}{u}_{1}\\cdot {u}_{1}=1 \\\\ {u}_{2}\\cdot {u}_{2}=1 \\\\ {u}_{3}\\cdot {u}_{3}=1.\\end{aligned}$\n\n- ${v}_{1}\\cdot {v}_{2}=0\\,\\text{and}\\,{\\begin{aligned}{v}_{1}\\cdot {v}_{1}=1 \\\\ {v}_{2}\\cdot {v}_{2}=1.\\end{aligned}$\n\n- ${\\begin{aligned}{w}_{1}\\cdot {w}_{2}=0 \\\\ {w}_{1}\\cdot {w}_{3}=0 \\\\ {w}_{2}\\cdot {w}_{3}=0\\end{aligned}\\,\\text{and}\\,{\\begin{aligned}{w}_{1}\\cdot {w}_{1}=1 \\\\ {w}_{2}\\cdot {w}_{2}=1 \\\\ {w}_{3}\\cdot {w}_{3}=1.\\end{aligned}$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ notice that\n\n$$\n\\begin{aligned}{u}_{1}\\cdot {u}_{1} & =[\\begin{aligned}1 \\\\ -5 \\\\ -2\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ -5 \\\\ -2\\end{aligned}]=1+25+4=30\\ne 1 & \\times \\end{aligned}\n$$\n\nSo, $U$ is not an orthonormal set.\n\n- For the set $V,$ we get the following:\n\n$$\n\\begin{aligned}{v}_{1}\\cdot {v}_{2} & =[\\begin{aligned}\\frac{2}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}}\\end{aligned}]\\cdot [\\begin{aligned}-\\frac{3}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}}\\end{aligned}]=-\\frac{6}{13}+\\frac{6}{13}=0 & ✓ \\\\ {v}_{1}\\cdot {v}_{1} & =[\\begin{aligned}\\frac{2}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{2}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}}\\end{aligned}]=\\frac{4}{13}+\\frac{9}{13}=1 & ✓ \\\\ {v}_{2}\\cdot {v}_{2} & =[\\begin{aligned}-\\frac{3}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}}\\end{aligned}]\\cdot [\\begin{aligned}-\\frac{3}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}}\\end{aligned}]=\\frac{9}{13}+\\frac{4}{13}=1 & ✓\\end{aligned}\n$$\n\nSo, the set $V$ is orthonormal.\n\n- For the set $W,$ we get the following:\n\n$$\n\\begin{aligned}{w}_{1}\\cdot {w}_{2} & =[\\begin{aligned}\\frac{1}{\\sqrt{6}} \\\\ \\frac{2}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{6}}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{\\sqrt{3}} \\\\ -\\frac{1}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{3}}\\end{aligned}]=\\frac{1}{\\sqrt{18}}-\\frac{2}{\\sqrt{18}}+\\frac{1}{\\sqrt{18}}=0 & ✓ \\\\ {w}_{1}\\cdot {w}_{1} & =[\\begin{aligned}\\frac{1}{\\sqrt{6}} \\\\ \\frac{2}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{6}}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{\\sqrt{6}} \\\\ \\frac{2}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{6}}\\end{aligned}]=\\frac{1}{6}+\\frac{4}{6}+\\frac{1}{6}=1 & ✓ \\\\ {w}_{2}\\cdot {w}_{2} & =[\\begin{aligned}\\frac{1}{\\sqrt{3}} \\\\ -\\frac{1}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{3}}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{\\sqrt{3}} \\\\ -\\frac{1}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{3}}\\end{aligned}]=\\frac{1}{3}+\\frac{1}{3}+\\frac{1}{3}=1 & ✓\\end{aligned}\n$$\n\nSo, the set $W$ is orthonormal.\n\nTherefore, we conclude that the correct answer is \"$V$ and $W$ only\"." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-81109/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ed5c8af7-e617-5e8c-be01-45a26eb17d4d"] :knowledge-point/questions ["q-81109"] :db/ensure [:knowledge-point/validate]} {:db/id "q-83745/selection/e2d52a456cba49e8b5bad42a80eb2a8b1b2bb244f8c178b51f34d013592f152f" :answer/id #uuid "9cced40f-8e2a-56e2-b80d-bbd8ee748e87" :answer/type :answer.type/text :answer/value "$W$ only" :db/ensure [:answer/validate]} {:db/id "q-83745/selection/ada5cc9b7cb3c1f0ee40e3f0daf3ce48624840426207eb57c599d2352c73fca0" :answer/id #uuid "b9584e86-bc05-5ff7-85e3-710fbfcff284" :answer/type :answer.type/text :answer/value "$U$ and $V$ only" :db/ensure [:answer/validate]} {:db/id "q-83745/selection/1454d2f1915a335c7d01677c9b98fbae5aedebb848a7a30361c0ea47ca70fb1e" :answer/id #uuid "ae649ed9-0fe4-5f8f-ac89-4bbc4eef7330" :answer/type :answer.type/text :answer/value "$V$ and $W$ only" :db/ensure [:answer/validate]} {:db/id "q-83745/selection/04646d488959d0b10c98bd9055615c2535925a7b59f21ec7dcdb79a9fb18da0d" :answer/id #uuid "208c607d-7f92-5871-a206-4fb48a7bd71b" :answer/type :answer.type/text :answer/value "$U$ and $W$ only" :db/ensure [:answer/validate]} {:db/id "q-83745/selection/16b50194516e7dcad35bdecafc4c70a67642e9c995267daaf0accfcc873be095" :answer/id #uuid "0f3f89d6-888b-592f-baee-731c4c5c8490" :answer/type :answer.type/text :answer/value "$U$ only" :db/ensure [:answer/validate]} {:db/id "q-83745/selection" :answer-field/id #uuid "8b3331e1-e576-59d5-9720-1defdcf53068" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-83745/selection/04646d488959d0b10c98bd9055615c2535925a7b59f21ec7dcdb79a9fb18da0d" :answer-field/choices ["q-83745/selection/e2d52a456cba49e8b5bad42a80eb2a8b1b2bb244f8c178b51f34d013592f152f" "q-83745/selection/ada5cc9b7cb3c1f0ee40e3f0daf3ce48624840426207eb57c599d2352c73fca0" "q-83745/selection/1454d2f1915a335c7d01677c9b98fbae5aedebb848a7a30361c0ea47ca70fb1e" "q-83745/selection/04646d488959d0b10c98bd9055615c2535925a7b59f21ec7dcdb79a9fb18da0d" "q-83745/selection/16b50194516e7dcad35bdecafc4c70a67642e9c995267daaf0accfcc873be095"] :db/ensure [:answer-field/validate]} {:db/id "q-83745" :question/id #uuid "26a7cf30-8a66-5018-a53e-6ace9edd956a" :question/math-academy-id "q-83745" :question/problem "Which of the following sets are orthonormal?\n\n- $U={[\\begin{aligned}\\frac{2}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}}\\end{aligned}],[\\begin{aligned}-\\frac{3}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}}\\end{aligned}]}$\n- $V={[\\begin{aligned}2 \\\\ 1 \\\\ -2\\end{aligned}],[\\begin{aligned}0 \\\\ 1 \\\\ -4\\end{aligned}],[\\begin{aligned}6 \\\\ -1 \\\\ -7\\end{aligned}]}$\n- $W={[\\begin{aligned}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{aligned}],[\\begin{aligned}\\frac{1}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}}\\end{aligned}]}$" :question/worked-solution "Let's denote the vectors of the given sets as \n${{u}_{1},{u}_{2}},$ \n${{v}_{1},{v}_{2},{v}_{3}},$ and \n${{w}_{1},{w}_{2}},$ respectively. \n\nThe sets $U,V,$ and $W$ are orthonormal if the following conditions on each set hold:\n\n- ${u}_{1}\\cdot {u}_{2}=0\\,\\text{and}\\,{\\begin{aligned}{u}_{1}\\cdot {u}_{1}=1 \\\\ {u}_{2}\\cdot {u}_{2}=1.\\end{aligned}$\n\n- ${\\begin{aligned}{v}_{1}\\cdot {v}_{2}=0 \\\\ {v}_{1}\\cdot {v}_{3}=0 \\\\ {v}_{2}\\cdot {v}_{3}=0\\end{aligned}\\,\\text{and}\\,{\\begin{aligned}{v}_{1}\\cdot {v}_{1}=1 \\\\ {v}_{2}\\cdot {v}_{2}=1 \\\\ {v}_{3}\\cdot {v}_{3}=1.\\end{aligned}$\n\n- ${w}_{1}\\cdot {w}_{2}=0\\,\\text{and}\\,{\\begin{aligned}{w}_{1}\\cdot {w}_{1}=1 \\\\ {w}_{2}\\cdot {w}_{2}=1.\\end{aligned}$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ we get the following:\n\n$$\n\\begin{aligned}{u}_{1}\\cdot {u}_{2} & =[\\begin{aligned}\\frac{2}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}}\\end{aligned}]\\cdot [\\begin{aligned}-\\frac{3}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}}\\end{aligned}]=-\\frac{6}{13}+\\frac{6}{13}=0 & ✓ \\\\ {u}_{1}\\cdot {u}_{1} & =[\\begin{aligned}\\frac{2}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{2}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}}\\end{aligned}]=\\frac{4}{13}+\\frac{9}{13}=1 & ✓ \\\\ {u}_{2}\\cdot {u}_{2} & =[\\begin{aligned}-\\frac{3}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}}\\end{aligned}]\\cdot [\\begin{aligned}-\\frac{3}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}}\\end{aligned}]=\\frac{9}{13}+\\frac{4}{13}=1 & ✓\\end{aligned}\n$$\n\nSo, the set $U$ is orthonormal.\n\n- For the set $V,$ notice that\n\n$$\n\\begin{aligned}{v}_{1}\\cdot {v}_{2} & =[\\begin{aligned}2 \\\\ 1 \\\\ -2\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ 1 \\\\ -4\\end{aligned}]=0+1+8=9\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $V$ is not an orthonormal set.\n\n- For the set $W,$ we get the following:\n\n$$\n\\begin{aligned}{w}_{1}\\cdot {w}_{2} & =[\\begin{aligned}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}}\\end{aligned}]=\\frac{2}{5}-\\frac{2}{5}=0 & ✓ \\\\ {w}_{1}\\cdot {w}_{1} & =[\\begin{aligned}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{aligned}]=\\frac{4}{5}+\\frac{1}{5}=1 & ✓ \\\\ {w}_{2}\\cdot {w}_{2} & =[\\begin{aligned}\\frac{1}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}}\\end{aligned}]=\\frac{1}{5}+\\frac{4}{5}=1 & ✓\\end{aligned}\n$$\n\nSo, $W$ is an orthonormal set.\n\nTherefore, we conclude that the correct answer is \"$U$ and $W$ only\"." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-83745/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ed5c8af7-e617-5e8c-be01-45a26eb17d4d"] :knowledge-point/questions ["q-83745"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-39398"] :question/problem "Which of the following sets are orthonormal?\n\n- $U={[\\begin{aligned}-\\frac{3}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}}\\end{aligned}],[\\begin{aligned}\\frac{1}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}}\\end{aligned}]}$\n- $V={[\\begin{aligned}2 \\\\ 3 \\\\ -1\\end{aligned}],[\\begin{aligned}3 \\\\ 1 \\\\ 9\\end{aligned}],[\\begin{aligned}28 \\\\ -21 \\\\ -7\\end{aligned}]}$\n- $W={[\\begin{aligned}\\frac{3}{5} \\\\ \\frac{4}{5}\\end{aligned}],[\\begin{aligned}\\frac{4}{5} \\\\ -\\frac{3}{5}\\end{aligned}]}$" :question/worked-solution "Let's denote the vectors of the given sets as \n${{u}_{1},{u}_{2}},$ \n${{v}_{1},{v}_{2},{v}_{3}},$ and \n${{w}_{1},{w}_{2}},$ respectively. \n\nThe sets $U,V,$ and $W$ are orthonormal if the following conditions on each set hold:\n\n- ${u}_{1}\\cdot {u}_{2}=0\\,\\text{and}\\,{\\begin{aligned}{u}_{1}\\cdot {u}_{1}=1 \\\\ {u}_{2}\\cdot {u}_{2}=1.\\end{aligned}$\n\n- ${\\begin{aligned}{v}_{1}\\cdot {v}_{2}=0 \\\\ {v}_{1}\\cdot {v}_{3}=0 \\\\ {v}_{2}\\cdot {v}_{3}=0\\end{aligned}\\,\\text{and}\\,{\\begin{aligned}{v}_{1}\\cdot {v}_{1}=1 \\\\ {v}_{2}\\cdot {v}_{2}=1 \\\\ {v}_{3}\\cdot {v}_{3}=1.\\end{aligned}$\n\n- ${w}_{1}\\cdot {w}_{2}=0\\,\\text{and}\\,{\\begin{aligned}{w}_{1}\\cdot {w}_{1}=1 \\\\ {w}_{2}\\cdot {w}_{2}=1.\\end{aligned}$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ we get the following:\n\n$$\n\\begin{aligned}{u}_{1}\\cdot {u}_{2} & =[\\begin{aligned}-\\frac{3}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}}\\end{aligned}]=-\\frac{3}{10}+\\frac{3}{10}=0 & ✓ \\\\ {u}_{1}\\cdot {u}_{1} & =[\\begin{aligned}-\\frac{3}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}}\\end{aligned}]\\cdot [\\begin{aligned}-\\frac{3}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}}\\end{aligned}]=\\frac{9}{10}+\\frac{1}{10}=1 & ✓ \\\\ {u}_{2}\\cdot {u}_{2} & =[\\begin{aligned}\\frac{1}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}}\\end{aligned}]=\\frac{1}{10}+\\frac{9}{10}=1 & ✓\\end{aligned}\n$$\n\nSo, the set $U$ is orthonormal.\n\n- For the set $V,$ notice that\n\n$$\n\\begin{aligned}{v}_{1}\\cdot {v}_{1} & =[\\begin{aligned}2 \\\\ 3 \\\\ -1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 3 \\\\ -1\\end{aligned}]=4+9+1=14\\ne 1 & \\times \\end{aligned}\n$$\n\nSo, $V$ is not an orthonormal set.\n\n- For the set $W,$ we get the following:\n\n$$\n\\begin{aligned}{w}_{1}\\cdot {w}_{2} & =[\\begin{aligned}\\frac{3}{5} \\\\ \\frac{4}{5}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{4}{5} \\\\ -\\frac{3}{5}\\end{aligned}]=\\frac{12}{25}-\\frac{12}{25}=0 & ✓ \\\\ {w}_{1}\\cdot {w}_{1} & =[\\begin{aligned}\\frac{3}{5} \\\\ \\frac{4}{5}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{3}{5} \\\\ \\frac{4}{5}\\end{aligned}]=\\frac{9}{25}+\\frac{16}{25}=1 & ✓ \\\\ {w}_{2}\\cdot {w}_{2} & =[\\begin{aligned}\\frac{4}{5} \\\\ -\\frac{3}{5}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{4}{5} \\\\ -\\frac{3}{5}\\end{aligned}]=\\frac{16}{25}+\\frac{9}{25}=1 & ✓\\end{aligned}\n$$\n\nSo, $W$ is an orthonormal set.\n\nTherefore, we conclude that the correct answer is \"$U$ and $W$ only\"." :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-82401/selection/04646d488959d0b10c98bd9055615c2535925a7b59f21ec7dcdb79a9fb18da0d" :answer/id #uuid "67dab52e-dd02-5178-b7b0-6dca9d782e2c" :answer/type :answer.type/text :answer/value "$U$ and $W$ only" :db/ensure [:answer/validate]} {:db/id "q-82401/selection/e2d52a456cba49e8b5bad42a80eb2a8b1b2bb244f8c178b51f34d013592f152f" :answer/id #uuid "bce6a255-d956-5b7b-a1a4-6e2eb2f4dd8d" :answer/type :answer.type/text :answer/value "$W$ only" :db/ensure [:answer/validate]} {:db/id "q-82401/selection/6c5d8db382b33f30f332b1