#{[{:db/id #edb/ref 17592186157023 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "19fb3196-439e-5466-b50c-615c492167b4" :knowledge-point/title "Finding the Complement of a Set Using a Venn Diagram"}] :question/id #uuid "7bd73f85-c4d5-57c4-a3ba-094d93c105cc" :question/math-academy-id "e-7163" :question/problem "Let $U = \\{ a, b, c, d, e, f, g \\}$ be the universal set and let $B = \\{ b, d, f \\}.$ What is $\\overline{B}?$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035973/assets/25f40492b0466495519d6ff94859d0cef4c206e291d31eba2a980732b497af31.png)" :question/worked-solution "The complement of $B,$ denoted $\\overline B,$ consists of all the elements in $U$ that are not in $B.$ To represent $\\overline B,$ we will shade in all the area of $U$ that is *outside* of $B,$ as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035973/assets/daad235ef63e127e99bf3eec7b7bbe75fe6adb969f5b54ebb5a3fb010773b680.png)\n\nThe elements in the shaded area are $a,$ $c,$ $e,$ and $g.$ These are the elements of $U$ that are not in $B.$ Therefore, the complement of $B$ is\n\n$$\n\\overline{B} = \\{ a,c,e,g \\}.\n$$"}] [{:db/id #edb/ref 17592186157024 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "9a55a708-abb0-5e23-8862-153561d022c8" :knowledge-point/title "Finding the Complement of a Set Without a Venn Diagram"}] :question/id #uuid "1c497253-5007-52a4-9f93-838d4b4699b0" :question/math-academy-id "e-7164" :question/problem "Let $U = \\{ a, b, c, d, e, f, g \\}$ be the universal set and let $A = \\{ b, c, d, f, g \\}.$ What is $\\overline{A}?$" :question/worked-solution "The complement of $A,$ denoted $\\overline{A},$ consists of every element in the universal set $U$ that is not in the set $A.$\n\nThe only elements of $U$ that are not in $A$ are $a$ and $e.$\n\nTherefore, the complement of $A$ is\n\n$$\n\\overline{A} = \\{ a, e \\}.\n$$"}] [{:db/id #edb/ref 17592186157025 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "49251196-c06b-5718-82e6-5ed9450301af" :knowledge-point/title "Finding the Complement of a Set Given Using Ellipsis Notation"}] :question/id #uuid "2647b940-84c6-5b52-9c99-6a4ee5ebb669" :question/math-academy-id "e-7165" :question/problem "Let $U = \\{ 1, 2, 3, \\ldots, 30 \\}$ be the universal set and let $B = \\{ 5, 6, 7, \\ldots, 28 \\}.$ What is $\\overline{B}?$" :question/worked-solution "The complement of $B,$ denoted $\\overline{B},$ consists of every element in the universal set $U$ that is not in the set $B.$\n\nThe universal set $U$ consists of the integers $1$ through $30,$ while the set $B$ consists of the integers $5$ through $28.$\n\nSo, the only elements of $U$ that are not in $B$ are $1,$ $2,$ $3,$ $4,$ $29,$ and $30.$\n\nTherefore, the complement of $B$ is\n\n$$\n\\overline{B} = \\{ 1,2,3,4,29,30 \\}.\n$$"}] [{:db/id #edb/ref 17592186295922 :knowledge-point/_questions [{:knowledge-point/id #uuid "19fb3196-439e-5466-b50c-615c492167b4" :knowledge-point/title "Finding the Complement of a Set Using a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a720f432-1c86-5d6a-83cc-a44862548e85" :answer/type {:db/ident :answer.type/math} :answer/value "{◻,△}" :db/id #edb/ref 17592186295924} {:answer/id #uuid "2d5f577a-bfa2-5db1-8a14-c87b624b6d4a" :answer/type {:db/ident :answer.type/math} :answer/value "{◻,♣,△,♢}" :db/id #edb/ref 17592186295925} {:answer/id #uuid "018cc880-cdae-5f49-9ca6-85fb1e41d34e" :answer/type {:db/ident :answer.type/math} :answer/value "{◻,♣}" :db/id #edb/ref 17592186295926} {:answer/id #uuid "95bc243a-ec60-5c1c-85a3-9366b4f17495" :answer/type {:db/ident :answer.type/math} :answer/value "{◻,♣,△}" :db/id #edb/ref 17592186295927} {:answer/id #uuid "f34b206d-3534-588a-8910-cc2790ddf1f9" :answer/type {:db/ident :answer.type/math} :answer/value "{△,♢}" :db/id #edb/ref 17592186295928}] :answer-field/correct {:answer/id 