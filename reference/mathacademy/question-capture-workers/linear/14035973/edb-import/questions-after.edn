-5,-3,…,7}" :db/id #edb/ref 17592186295984}] :answer-field/correct {:answer/id #uuid "befe2a4d-7c1e-5a51-965d-bf123ddd3764" :answer/type {:db/ident :answer.type/math} :answer/value "{-8,-6,-4,…,8}" :db/id #edb/ref 17592186295981} :answer-field/id #uuid "9b17abee-6d2e-58ab-a7ee-41ed42426e9e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186295979}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "965ee94a-ddac-5d41-9c93-0113d98e39e1" :question/math-academy-id "q-105806" :question/problem "If $U={-8,-7,-6,…,8}$ is the universal set and $A={-7,-5,-3,…,7},$ then $\\overset{―}{A}=$" :question/worked-solution "The complement of $A,$ denoted $\\overset{―}{A},$ consists of every element in the universal set $U$ that is not in the set $A.$\n\nThe universal set $U$ consists of the integers from $-8$ through $8,$ while the set $A$ consists of the odd numbers from  $-7$ through $7.$\n\nSo, the only elements of $U$ that are not in $A$ are the even numbers from $-8$ through $8.$\n\nTherefore, the complement of $A$ is\n\n$$\n\\overset{―}{A}={-8,-6,-4,…,8}.\n$$"}] [{:db/id #edb/ref 17592186295985 :knowledge-point/_questions [{:knowledge-point/id #uuid "49251196-c06b-5718-82e6-5ed9450301af" :knowledge-point/title "Finding the Complement of a Set Given Using Ellipsis Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "496b9ec6-2905-59dd-a5cc-f6edede1cabc" :answer/type {:db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186295987} {:answer/id #uuid "6906a418-7004-52da-b878-298c47091b20" :answer/type {:db/ident :answer.type/math} :answer/value "{1,2,3,...,100}" :db/id #edb/ref 17592186295988} {:answer/id #uuid "af9ee695-a4f3-5e60-be93-094a933446aa" :answer/type {:db/ident :answer.type/math} :answer/value "{1,3,5,...,99}" :db/id #edb/ref 17592186295989} {:answer/id #uuid "b96400c8-8361-5c73-9076-160df4c82491" :answer/type {:db/ident :answer.type/math} :answer/value "{2,4,6}" :db/id #edb/ref 17592186295990} {:answer/id #uuid "ab76e746-193c-5650-955a-0b49b0415750" :answer/type {:db/ident :answer.type/math} :answer/value "{2,4,6,...,100}" :db/id #edb/ref 17592186295991}] :answer-field/correct {:answer/id #uuid "ab76e746-193c-5650-955a-0b49b0415750" :answer/type {:db/ident :answer.type/math} :answer/value "{2,4,6,...,100}" :db/id #edb/ref 17592186295991} :answer-field/id #uuid "8221a6fe-919e-575f-b1fc-b4590bc13405" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186295986}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "3b5b8f35-6079-5a75-89c2-580c9d97b323" :question/math-academy-id "q-1229" :question/problem "If $U={1,2,3,...,100}$ is the universal set and $S={1,3,5,...,99}$, then $\\overset{―}{S}=$" :question/worked-solution "The complement of $S,$ denoted $\\overset{―}{S},$ consists of every element in the universal set $U$ that is not in the set $S.$\n\nThe universal set $U$ consists of the integers $1$ through $100,$ while the set $S$ consists of the odd integers $1$ through $99.$\n\nSo, the only elements of $U$ that are not in $S$ are the even integers $2$ through $100.$\n\nTherefore, the complement of $S$ is\n\n$$\n\\overset{―}{S}={2,4,6,...,100}.\n$$"}] [{:db/id #edb/ref 17592186295992 :knowledge-point/_questions [{:knowledge-point/id #uuid "9a55a708-abb0-5e23-8862-153561d022c8" :knowledge-point/title "Finding the Complement of a Set Without a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "998a622e-4d31-5ccd-be45-2170e014a86b" :answer/type {:db/ident :answer.type/math} :answer/value "{b,c,e,f,h}" :db/id #edb/ref 17592186295994} {:answer/id #uuid "ab102b76-029d-5b86-8dc5-1e5781c5934e" :answer/type {:db/ident :answer.type/math} :answer/value "{b,c,e,f}" :db/id #edb/ref 17592186295995} {:answer/id #uuid "1e78ea61-f871-