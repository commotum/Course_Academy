db/id #edb/ref 17592186296009} {:answer/id #uuid "3eac568b-ac47-58f2-b447-255751f9bf3b" :answer/type {:db/ident :answer.type/math} :answer/value "{10,30,50}" :db/id #edb/ref 17592186296010} {:answer/id #uuid "e50ba075-97c2-51af-82cf-a4da92068b00" :answer/type {:db/ident :answer.type/math} :answer/value "{10,30,40}" :db/id #edb/ref 17592186296011} {:answer/id #uuid "f9488100-0ddb-5ea2-a00c-66b54089e1ef" :answer/type {:db/ident :answer.type/math} :answer/value "{20,30,50}" :db/id #edb/ref 17592186296012}] :answer-field/correct {:answer/id #uuid "9097636d-2d77-5e8f-b964-f8deb6167a22" :answer/type {:db/ident :answer.type/math} :answer/value "{20,50}" :db/id #edb/ref 17592186296009} :answer-field/id #uuid "39e3acb9-054a-587e-ba89-d6ad7a4423f8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296007}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "79e30452-45d7-5e2c-9f22-89ba29aa6267" :question/math-academy-id "q-81551" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035973/assets/a0674c068305434109322c2ade681279f11b78944356d7663198f9bfbf9cf962.png)\n\nLet $U={10,20,30,40,50}$ be the universal set and let $Q={10,30,40}.$ What is $\\overset{―}{Q}?$" :question/worked-solution "The complement of $Q,$ denoted $\\overset{―}{Q},$ consists of all the elements in $U$ that are not in $Q.$ To represent $\\overset{―}{Q},$ we will shade in all the area of $U$ that is *outside* of $Q,$ as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035973/assets/a29068d63563404b495e603e473a990186fed086439318d9ac26685b9474f331.png)\n\nThe elements in the shaded area are $20$ and $50.$ These are the elements of $U$ that are not in $Q.$ Therefore, the complement of $Q$ is\n\n$$\n\\overset{―}{Q}={20,50}.\n$$"}] [{:db/id #edb/ref 17592186296013 :knowledge-point/_questions [{:knowledge-point/id #uuid "19fb3196-439e-5466-b50c-615c492167b4" :knowledge-point/title "Finding the Complement of a Set Using a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46b0f61d-d714-5476-876e-fe5181e67e6e" :answer/type {:db/ident :answer.type/math} :answer/value "{c,40}" :db/id #edb/ref 17592186296015} {:answer/id #uuid "bf9631a2-60e9-537e-99b5-10437ae0cc74" :answer/type {:db/ident :answer.type/math} :answer/value "{a,40}" :db/id #edb/ref 17592186296016} {:answer/id #uuid "43ac4a15-9666-5d49-b631-4352900a2fd8" :answer/type {:db/ident :answer.type/math} :answer/value "{20,40}" :db/id #edb/ref 17592186296017} {:answer/id #uuid "6e8fee0d-1383-5240-80a2-48b9c7b3831a" :answer/type {:db/ident :answer.type/math} :answer/value "{a,c}" :db/id #edb/ref 17592186296018} {:answer/id #uuid "faccb8df-3601-5631-9e54-3e0457372e87" :answer/type {:db/ident :answer.type/math} :answer/value "{a,b,c}" :db/id #edb/ref 17592186296019}] :answer-field/correct {:answer/id #uuid "6e8fee0d-1383-5240-80a2-48b9c7b3831a" :answer/type {:db/ident :answer.type/math} :answer/value "{a,c}" :db/id #edb/ref 17592186296018} :answer-field/id #uuid "1d58d9ae-d235-5db6-8a73-ab07cae3dc86" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296014}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ffcf60cf-7bfd-53f1-a544-3178bf8a52a6" :question/math-academy-id "q-86587" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035973/assets/02dabe7099c201f717885a05842e0cb8543bd01cccf0d6c52147f674cde15dce.png)\n\nLet $U={a,b,c,20,40}$ be the universal set and let $R={b,20,40}.$ What is the complement of $R?$" :question/worked-solution "The complement of $R,$ denoted $\\overset{―}{R},$ consists of all the elements in $U$ that are not in $R.$ To represent $\\overset{―}{R},$ we will shade in all the area of $U$ that is *outside* of $R,$ as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035973/assets/79900f22c35570b35cf10664768ecf4460a7953ddf7f91dac1893b3ce81339bf.png)\n\nThe elements in the shaded area are $a$ and $c.$ These are the elements of $U$ that are not in $R.$ Therefore, the complement of $R$ is\n\n$$\n\\overset{―}{R}={a,c}.\n$$"}]}
