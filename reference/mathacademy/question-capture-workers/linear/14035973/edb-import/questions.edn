#{[{:db/id #edb/ref 17592186157023 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "19fb3196-439e-5466-b50c-615c492167b4" :knowledge-point/title "Finding the Complement of a Set Using a Venn Diagram"}] :question/id #uuid "7bd73f85-c4d5-57c4-a3ba-094d93c105cc" :question/math-academy-id "e-7163" :question/problem "Let $U = \\{a, b, c, d, e, f, g \\}$ be the universal set and let $B = \\{b, d, f \\}$. What is $\\overline{B}$?\n\n![](/home/jake/Developer/MA/DATA/Lessons/2829/Source/Images/e3286d4e435a020e578a009552a1be73.png)" :question/worked-solution "The complement of $B$, denoted $\\overline B$, consists of all the elements in $U$ that are not in $B$. To represent $\\overline B$, we will shade in all the area of $U$ that is *outside* of $B$, as follows:\n\n![](/home/jake/Developer/MA/DATA/Lessons/2829/Source/Images/9385e4e8c3b0eab7bcb5e0f0d1bb2955.png)\n\nThe elements in the shaded area are $a$, $c$, $e$, and $g$. These are the elements of $U$ that are not in $B$. Therefore, the complement of $B$ is\n\n$$\n\\overline{B} = \\{a,c,e,g \\}\n$$"}] [{:db/id #edb/ref 17592186157024 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "9a55a708-abb0-5e23-8862-153561d022c8" :knowledge-point/title "Finding the Complement of a Set Without a Venn Diagram"}] :question/id #uuid "1c497253-5007-52a4-9f93-838d4b4699b0" :question/math-academy-id "e-7164" :question/problem "Let $U = \\{a, b, c, d, e, f, g \\}$ be the universal set and let $A = \\{b, c, d, f, g \\}$. What is $\\overline{A}$?" :question/worked-solution "The complement of $A$, denoted $\\overline{A}$, consists of every element in the universal set $U$ that is not in the set $A$.\n\nThe only elements of $U$ that are not in $A$ are $a$ and $e$.\n\nTherefore, the complement of $A$ is\n\n$$\n\\overline{A} = \\{a, e \\}\n$$"}] [{:db/id #edb/ref 17592186157025 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "49251196-c06b-5718-82e6-5ed9450301af" :knowledge-point/title "Finding the Complement of a Set Given Using Ellipsis Notation"}] :question/id #uuid "2647b940-84c6-5b52-9c99-6a4ee5ebb669" :question/math-academy-id "e-7165" :question/problem "Let $U = \\{1, 2, 3, \\ldots, 30 \\}$ be the universal set and let $B = \\{5, 6, 7, \\ldots, 28 \\}$. What is $\\overline{B}$?" :question/worked-solution "The complement of $B$, denoted $\\overline{B}$, consists of every element in the universal set $U$ that is not in the set $B$.\n\nThe universal set $U$ consists of the integers $1$ through $30$, while the set $B$ consists of the integers $5$ through $28$.\n\nSo, the only elements of $U$ that are not in $B$ are $1$, $2$, $3$, $4$, $29$, and $30$.\n\nTherefore, the complement of $B$ is\n\n$$\n\\overline{B} = \\{1,2,3,4,29,30 \\}\n$$"}] [{:db/id #edb/ref 17592186157502 :knowledge-point/_questions [{:knowledge-point/id #uuid "9a55a708-abb0-5e23-8862-153561d022c8" :knowledge-point/title "Finding the Complement of a Set Without a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b419e438-749c-541f-ba91-62101d297b0c" :answer/type {:db/ident :answer.type/math} :answer/value "{w, x, y}" :db/id #edb/ref 17592186153588} {:answer/id #uuid "0704c40c-cfaf-500c-825a-2a6d217638dd" :answer/type {:db/ident :answer.type/math} :answer/value "{x, y}" :db/id #edb/ref 17592186153589} {:answer/id #uuid "47be6c11-5ce5-5c52-b6df-8beeb600f086" :answer/type {:db/ident :answer.type/math} :answer/value "{t, u, v, w}" :db/id #edb/ref 17592186153590} {:answer/id #uuid "52d5cc1b-7def-5ddd-997f-d2f380488b88" :answer/type {:db/ident :answer.type/math} :answer/value "{u, v, w}" :db/id #edb/ref 17592186153591} {:answer/id #uuid "57833e76-5ea7-58b1-80ed-e6b052d2fc4b" :answer/type {:db/ident :answer.type/math} :answer/value "{t, u, v}" :db/id #edb/ref 17592186153592}] :answer-field/correct {:answer/id #uuid "57833e76-5ea7-58b1-80ed-e6b052d2fc4b" :answer/type {:db/ident :answer.type/math} :answer/value "{t, u, v}" :db/id #edb/ref 17592186153592} :answer-field/id #uuid "760c9548-7071-5ac0-ae45-2da5985d43fc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186153587}] :question/id #uuid "3f055d6f-1cdc-5ef1-b961-6fabfca25e69" :question/math-academy-id "q-1236" :question/problem "If $U = {t, u, v, w, x, y}$ is the universal set and $S = {w, x, y}$, then the complement of $S$ is"}]}
