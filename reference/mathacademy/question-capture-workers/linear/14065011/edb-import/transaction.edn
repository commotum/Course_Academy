d}]\\end{aligned}\n$$\n\nThe pivot columns correspond to basis vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the reduced matrix has $2$ pivot columns (or alternatively, it has exactly $2$ non-zero rows). \n\nTherefore, \n$\\text{dim}(\\text{Span}{[\\begin{aligned}-2 \\\\ 0 \\\\ -1 \\\\ 0\\end{aligned}],[\\begin{aligned}5 \\\\ 1 \\\\ 0 \\\\ -2\\end{aligned}],[\\begin{aligned}-6 \\\\ -2 \\\\ 2 \\\\ 4\\end{aligned}],[\\begin{aligned}3 \\\\ 1 \\\\ -1 \\\\ -2\\end{aligned}]})=2.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-35302/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "004c4177-ca0e-586c-962a-1220b4b64f47"] :knowledge-point/questions ["q-35302"] :db/ensure [:knowledge-point/validate]} {:db/id "q-35298/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "acfe5f33-c92d-51fa-bebc-e8aad46184ba" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-35298/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "a083a7d5-a3e1-5896-8b92-7a8b6e4d4025" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-35298/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "997e8260-7d34-5077-a6a6-4f6b53f980d2" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-35298/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "a38ab039-c6eb-5218-b8a7-44a5b762b502" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-35298/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "452a7eb0-d4fb-58c5-bf83-d8a70de3030c" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-35298/selection" :answer