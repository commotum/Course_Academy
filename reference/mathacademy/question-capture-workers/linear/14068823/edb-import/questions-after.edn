\\text{Span}{{a}_{2}}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{v}\\,x & =\\frac{x\\cdot v}{v\\cdot v}v=\\frac{(-2)\\cdot (-3)+(-2)\\cdot 2+(-9)\\cdot 1}{(-3)^{2}+{2}^{2}+{1}^{2}}v=-\\frac{1}{2}[\\begin{aligned}-3 \\\\ 2 \\\\ 1\\end{aligned}] \\\\ {\\text{proj}}_{w}\\,x & =\\frac{x\\cdot w}{w\\cdot w}w=\\frac{(-2)\\cdot 1+(-2)\\cdot 2+(-9)\\cdot (-1)}{{1}^{2}+{2}^{2}+(-1)^{2}}w=\\frac{1}{2}[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}]\\end{aligned}\n$$\n\n \n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x \\\\  & =-\\frac{1}{2}[\\begin{aligned}-3 \\\\ 2 \\\\ 1\\end{aligned}]+\\frac{1}{2}[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}] \\\\  & =\\frac{1}{2}(-[\\begin{aligned}-3 \\\\ 2 \\\\ 1\\end{aligned}]+[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}]) \\\\  & =[\\begin{aligned}2 \\\\ 0 \\\\ -1\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186309428 :knowledge-point/_questions [{:knowledge-point/id #uuid "acb4bd03-9b89-5775-a700-e1f3ea9fa62e" :knowledge-point/title "Finding the Orthogonal Projection of a Vector Onto a Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02a5c59a-7294-5e50-a808-8270f997a1dd" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-10 \\\\ -11 \\\\ 12\\end{aligned}]" :db/id #edb/ref 17592186309430} {:answer/id #uuid "75c6f8ae-0cc3-5e3b-94f7-e26b3a503329" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-13 \\\\ -12 \\\\ 11\\end{aligned}]" :db/id #edb/ref 17592186309431} {:answer/id #uuid "32d0f948-46b4-5cc2-aec4-c62b11ab3bd9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-12 \\\\ -11 \\\\ 10\\end{aligned}]" :db/id #edb/ref 17592186309432} {:answer/id #uuid "0e5f1bca-6083-5b56-b7c2-c4fec7155deb" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-13 \\\\ -14 \\\\ 15\\end{aligned}]" :db/id #edb/ref 17592186309433} {:answer/id #