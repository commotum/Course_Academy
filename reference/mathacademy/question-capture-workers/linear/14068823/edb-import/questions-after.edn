6 \\\\ 3 \\\\ -17\\end{aligned}].\n$$\n\nFind the orthogonal projection of $x$ onto the subspace $S$ given that the set ${{a}_{1},{a}_{2},{a}_{3}}$ is orthogonal." :question/worked-solution "Since the set ${{a}_{1},{a}_{2},{a}_{3}}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+{\\text{proj}}_{{a}_{3}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}},$ $\\text{Span}{{a}_{2}},$ and $\\text{Span}{{a}_{3}}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{4\\cdot 1+6\\cdot 1+3\\cdot 0+(-17)\\cdot 2}{{1}^{2}+{1}^{2}+{0}^{2}+(-2)^{2}}{a}_{1}=-\\frac{24}{6}[\\begin{aligned}1 \\\\ 1 \\\\ 0 \\\\ 2\\end{aligned}]=[\\begin{aligned}-4 \\\\ -4 \\\\ 0 \\\\ -8\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{4\\cdot 3+6\\cdot (-5)+3\\cdot 0+(-17)\\cdot 1}{{3}^{2}+(-5)^{2}+{0}^{2}+{1}^{2}}{a}_{2}=-\\frac{35}{35}[\\begin{aligned}3 \\\\ -5 \\\\ 0 \\\\ 1\\end{aligned}]=[\\begin{aligned}-3 \\\\ 5 \\\\ 0 \\\\ -1\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{3}}x & =\\frac{x\\cdot {a}_{3}}{{a}_{3}\\cdot {a}_{3}}{a}_{3}=\\frac{4\\cdot 11+6\\cdot 5+3\\cdot 0+(-17)\\cdot (-8)}{{11}^{2}+{5}^{2}+{0}^{2}+(-8)^{2}}{a}_{2}=\\frac{210}{210}[\\begin{aligned}11 \\\\ 5 \\\\ 0 \\\\ -8\\end{aligned}]=[\\begin{aligned}11 \\\\ 5 \\\\ 0 \\\\ -8\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+{\\text{proj}}_{{a}_{3}}x \\\\  & =[\\begin{aligned}-4 \\\\ -4 \\\\ 0 \\\\ -8\\end{aligned}]+[\\begin{aligned}-3 \\\\ 5 \\\\ 0 \\\\ -1\\end{aligned}]+[\\begin{aligned}11 \\\\ 5 \\\\ 0 \\\\ -8\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ 6 \\\\ 0 \\\\ -17\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186358796 :knowledge-point/_questions [{:knowledge-point/id #uuid "acb4bd03-9b89-5775-a700-e1f3ea9fa62e" :knowledge-point/title "Finding the Orthogonal Projection of a Vector Onto a Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b3050ac-8837-5759-9d63-26f73afc4fcd" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-8 \\\\ 8 \\\\ -7\\end{aligned}]" :db/id #edb/ref 17592186358798} {:answer/id #uuid "3ec8b575-341a-56ed-a333-efc9606a2181" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 \\\\ 2 \\\\ -7\\end{aligned}]" :db/id #edb/ref 17592186358799} {:answer/id #uuid "50b84ec6-d3d7-5e6e-908b-092e445cdae4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 \\\\ 8 \\\\ -7\\end{aligned}]" :db/id #edb/ref 17592186358800} {:answer/id #uuid "c194a635-49bd-5063-ad3d-2ce922af9175" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 \\\\ 8 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186358801} {:answer/id #uuid "bfff28de-339b-5304-8272-e91f64cddb5e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 \\\\ 6 \\\\ -9\\end{aligned}]" :db/id #edb/ref 17592186358802}] :answer-field/correct {:answer/id #uuid "50b84ec6-d3d7-5e6e-908b-092e445cdae4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 \\\\ 8 \\\\ -7\\end{aligned}]" :db/id #edb/ref 17592186358800} :answer-field/id #uuid "9ee58e23-7830-5e80-b997-b99eb0475346" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186358797}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c7a96c11-4c5f-5a12-a6e5-6ac0294535f1" :question/math-academy-id "q-81580" :question/problem "Consider the vector $x$ and the plane $r=sv+tw,$ where $s,t\\in R,$ and\n\n$$\nv=[\\begin{aligned}4 \\\\ -1 \\\\ 2\\end{aligned}],\\,w=[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}],\\,\\,x=[\\begin{aligned}-8 \\\\ 14 \\\\ 2\\end{aligned}].\n$$\n\nFind the orthogonal projection of $x$ onto the plane given that $v⊥w.$" :question/worked-solution "Since our plane passes through the origin, it defines the subspace $S=\\text{Span}{v,w}$ in ${R}^{3}.$ \nAnd, since the set ${v,w}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by \n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}}$ and $\\text{Span}{{a}_{2}}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{v}\\,x & =\\frac{x\\cdot v}{v\\cdot v}v=\\frac{(-8)\\cdot 4+14\\cdot (-1)+2\\cdot 2}{{4}^{2}+(-1)^{2}+{2}^{2}}v=-2[\\begin{aligned}4 \\\\ -1 \\\\ 2\\end{aligned}]=[\\begin{aligned}-8 \\\\ 2 \\\\ -4\\end{aligned}] \\\\ {\\text{proj}}_{w}\\,x & =\\frac{x\\cdot w}{w\\cdot w}w=\\frac{(-8)\\cdot 1+14\\cdot 2+2\\cdot (-1)}{{1}^{2}+{2}^{2}+(-1)^{2}}w=3[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}]=[\\begin{aligned}3 \\\\ 6 \\\\ -3\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x \\\\  & =[\\begin{aligned}-8 \\\\ 2 \\\\ -4\\text{ }\\end{aligned}]+[\\begin{aligned}3 \\\\ 6 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}-5 \\\\ 8 \\\\ -7\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186358803 :knowledge-point/_questions [{:knowledge-point/id #uuid "acb4bd03-9b89-5775-a700-e1f3ea9fa62e" :knowledge-point/title "Finding the Orthogonal Projection of a Vector Onto a Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e9bfcf0a-51af-5545-a02e-f1dc720ea602" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 2 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186358805} {:answer/id #uuid "679c0874-e0e8-5b5f-8ef5-a9a5352b62c2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ -1 \