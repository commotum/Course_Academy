\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x \\\\  & =\\frac{1}{2}[\\begin{aligned}4 \\\\ -4 \\\\ 2\\end{aligned}]-5[\\begin{aligned}3 \\\\ 2 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ -2 \\\\ 1\\end{aligned}]+[\\begin{aligned}-15 \\\\ -10 \\\\ 10\\end{aligned}] \\\\  & =[\\begin{aligned}-13 \\\\ -12 \\\\ 11\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186358810 :knowledge-point/_questions [{:knowledge-point/id #uuid "acb4bd03-9b89-5775-a700-e1f3ea9fa62e" :knowledge-point/title "Finding the Orthogonal Projection of a Vector Onto a Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "017b9a99-a383-5aef-bbd1-4912ca325cab" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 \\\\ 7 \\\\ 11\\end{aligned}]." :db/id #edb/ref 17592186358812} {:answer/id #uuid "0e7ddbd2-8f20-56d4-8279-1e1d1a66a46c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 \\\\ 6 \\\\ 3\\end{aligned}]." :db/id #edb/ref 17592186358813} {:answer/id #uuid "6b19f978-61fa-5143-8b8f-7ab351545a47" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 5 \\\\ -13\\end{aligned}]." :db/id #edb/ref 17592186358814} {:answer/id #uuid "599d5004-fffc-57ef-8e9b-0a2350dfc27e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 \\\\ 3 \\\\ 1\\end{aligned}]." :db/id #edb/ref 17592186358815} {:answer/id #uuid "132d1bd0-ba63-5d24-af55-336ee1a315c2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}9 \\\\ 6 \\\\ 0\\end{aligned}]." :db/id #edb/ref 17592186358816}] :answer-field/correct {:answer/id #uuid "132d1bd0-ba63-5d24-af55-336ee1a315c2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}9 \\\\ 6 \\\\ 0\\end{aligned}]." :db/id #edb/ref 17592186358816} :answer-field/id #uuid "a4f15928-7232-5a5a-a699-dfe2df51438c" :answer-field/key "selection" :answer-field/type {:db/ident 