0 \\\\ -2 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ -2 \\\\ -5 \\\\ -3\\end{aligned}]=x.\\end{aligned}\n$$\n\nSince $x$ coincides with the projection, the distance between $x$ and the subspace $S$ is zero $0.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068823/state.json" "file_sha256" "e17857f99f1248b4b20894fdfb6976eb50fd23565097f524a0779507212390b1"} {"question" "q-82915" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068823/activity-metadata.json" "file_sha256" "748144e91d47d8b68a80cf7b0ffb60680993bc9ca26aa4558cf96603d9db5041"} {"question" "q-82915" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068823/state.json" "file_sha256" "e17857f99f1248b4b20894fdfb6976eb50fd23565097f524a0779507212390b1"} {"question" "q-82915" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "0"] ["math" "1"] ["math" "2"] ["math" "2\\sqrt{2}"] ["math" "\\sqrt{2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068823/state.json" "file_sha256" "e17857f99f1248b4b20894fdfb6976eb50fd23565097f524a0779507212390b1"} {"question" "q-82915" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068823/state.json" "file_sha256" "e17857f99f1248b4b20894fdfb6976eb50fd23565097f524a0779507212390b1"} {"question" "q-82917" "field" nil "attribute" "question/problem" "value" "Consider the vector $x$ and the subspace $S=\\text{Span}{{a}_{1},{a}_{2},{a}_{3}}$ where\n\n$$\n{a}_{1}=[\\begin{aligned}0 \\\\ 4 \\\\ 1 \\\\ 1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-2 \\\\ 0 \\\\ -1 \\\\ 1\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}2 \\\\ -1 \\\\ 0 \\\\ 4\\end{aligned}],\\,\\,x=[\\begin{aligned}3 \\\\ -3 \\\\ -9 \\\\ 3\\end{aligned}].\n$$\n\nFind the distance between $x$ and the subspace $S$ given that the set ${{a}_{1},{a}_{2},{a}_{3}}$ is orthogonal." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068823/state.json" "file_sha256" "e17857f99f1248b4b20894fdfb6976eb50fd23565097f524a0779507212390b1"} {"question" "q-82917" "field" nil "attribute" "question/worked-solution" "value" "Since the set ${{a}_{1},{a}_{2},{a}_{3}}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+{\\text{proj}}_{{a}_{3}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}},$ $\\text{Span}{{a}_{2}},$ and $\\text{Span}{{a}_{3}}:$ \n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{3\\cdot 0+(-3)\\cdot 4+(-9)\\cdot 1+3\\cdot 1}{{0}^{2}+{4}^{2}+{1}^{2}+{1}^{2}}{a}_{1}=(-1)[\\begin{aligned}0 \\\\ 4 \\\\ 1 \\\\ 1\\end{aligned}]=[\\begin{aligned}0 \\\\ -4 \\\\ -1 \\\\ -1\\end{aligned}], \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{3\\cdot (-2)+(-3)\\cdot 0+(-9)\\cdot (-1)+3\\cdot 1}{(-2)^{2}+{0}^{2}+(-1)^{2}+{1}^{2}}{a}_{2}=[\\begin{aligned}-2 \\\\ 0 \\\\ -1 \\\\ 1\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{3}}x & =\\frac{x\\cdot {a}_{3}}{{a}_{3}\\cdot {a}_{3}}{a}_{3}=\\frac{3\\cdot 2+(-3)\\cdot (-1)+(-9)\\cdot 0+3\\cdot 4}{{2}^{2}+(-1)^{2}+{0}^{2}+{4}^{2}}{a}_{3}=[\\begin{aligned}2 \\\\ -1 \\\\ 0 \\\\ 4\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+{\\text{proj}}_{{a}_{3}}x \\\\  & =[\\begin{aligned}0 \\\\ -4 \\\\ -1 \\\\ -1\\end{aligned}]+[\\begin{aligned}-2 \\\\ 0 \\\\ -1 \\\\ 1\\end{aligned}]+[\\begin{aligned}2 \\\\ -1 \\\\ 0 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ -5 \\\\ -2 \\\\ 4\\end{aligned}]=\\overset{^}{x}.\\end{aligned}\n$$\n\nFinally, the distance between $x$ and the subspace $S$ is given by\n\n$$\n\\begin{aligned}d(x,\\overset{^}{x}) & =‖x-\\overset{^}{x}‖ \\\\  & =\\sqrt{({x}_{1}-{\\overset{^}{x}}_{1})^{2}+({x}_{2}-{\\overset{^}{x}}_{2})^{2}+({x}_{3}-{\\overset{^}{x}}_{3})^{2}+({x}_{4}-{\\overset{^}{x}}_{4})^{2}} \\\\  & =\\sqrt{(3-0)^{2}+(-3-(-5))^{2}+(-9-(-2))^{2}+(3-4)^{2}} \\\\  & =\\sqrt{63} \\\\  & =3\\sqrt{7}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068823/state.json" "file_sha256" "e17857f99f1248b4b20894fdfb6976eb50fd23565097f524a0779507212390b1"} {"question" "q-82917" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068823/activity-metadata.json" "file_sha256" "748144e91d47d8b68a80cf7b0ffb60680993bc9ca26aa4558cf96603d9db5041"} {"question" "q-82917" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068823/state.json" "file_sha256" "e17857f99f1248b4b20894fdfb6976eb50fd23565097f524a0779507212390b1"} {"question" "q-82917" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2\\sqrt{7}"] ["math" "3\\sqrt{3}"] ["math" "3\\sqrt{5}"] ["math" "3\\sqrt{7}"] ["math" "\\sqrt{7}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068823/state.json" "file_sha256" "e17857f99f1248b4b20894fdfb6976eb50fd23565097f524a0779507212390b1"} {"question" "q-82917" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "3\\sqrt{7}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068823/state.json" "file_sha256" "e17857f99f1248b4b20894fdfb6976eb50fd23565097f524a0779507212390b1"} {"question" "q-82948" "field" nil "attribute" "question/problem" "value" "Consider the vector $x$ and the subspace $S=\\text{Span}{{a}_{1},{a}_{2}}$ where\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}1 \\\\ 2 \\\\ 1\\end{aligned}],\\,\\,x=[\\begin{aligned}2 \\\\ 6 \\\\ -2\\end{aligned}].\n$$\n\nFind the acute angle between $x$ and the subspace $S$ given that the set ${{a}_{1},{a}_{2}}$ is orthogonal.   Round the answer to $2$ decimal places." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068823/state.json" "file_sha256" "e17857f99f1248b4b20894fdfb6976eb50fd23565097f524a0779507212390b1"} {"question" "q-82948" "field" nil "attribute" "question/worked-solution" "value" "Since the set ${{a}_{1},{a}_{2}}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}}$ and $\\text{Span}{{a}_{2}}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{2\\cdot 1+6\\cdot (-1)+(-2)\\cdot 1}{{1}^{2}+(-1)^{2}+{1}^{2}}{a}_{1}=(-2)[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}]=[\\begin{aligned}-2 \\\\ 2 \\\\ -2\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{2\\cdot 1+6\\cdot 2+(-2)\\cdot 1}{{1}^{2}+{2}^{2}+{1}^{2}}{a}_{2}=2[\\begin{aligned}1 \\\\ 2 \\\\ 1\\end{aligned}]=[\\begin{aligned}2 \\\\ 4 \\\\ 2\\end{aligned}]\\end{aligned}\n$$\n\n \n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x \\\\  & =[\\begin{aligned}-2 \\\\ 2 \\\\ -2\\end{aligned}]+[\\begin{aligned}2 \\\\ 4 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 6 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\n \n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x$ or any other non-zero vector that is parallel to ${\\text{proj}}_{S}x.$ \n\nComputing the cosine using the dot product, we obtain \n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{x\\cdot {\\text{proj}}_{S}\\,x}{‖x‖\\,‖{\\text{proj}}_{S}\\,x‖} \\\\  & =\\frac{2\\cdot 0+6\\cdot 6+(-2)\\cdot 0}{\\sqrt{{2}^{2}+{6}^{2}+(-2)^{2}}\\sqrt{{0}^{2}+{6}^{2}+{0}^{2}}} \\\\  & =\\frac{36}{\\sqrt{44}\\sqrt{36}} \\\\  & =\\frac{36}{2\\sqrt{11}\\cdot 6} \\\\  & =\\frac{3\\sqrt{11}}{11}.\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{3\\sqrt{11}}{11})≈{25.24}^{∘},\n$$\n\nwhich is already an acute angle." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068823/state.json" "file_sha256" "e17857f99f1248b4b20894fdfb6976eb50fd23565097f524a0779507212390b1"} {"question" "q-82948" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068823/activity-metadata.json" "file_sha256" "748144e91d47d8b68a80cf7b0ffb60680993bc9ca26aa4558cf96603d9db5041"} {"question" "q-82948" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/1