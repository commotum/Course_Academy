99fcbb38ecda6b3475" "basis" 1463 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/edb-import/verification.json"} {"question" "q-40605" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "9\\sqrt{3}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/state.json" "file_sha256" "7453e424f23cae5d25e530c9ae80bde4210e35b478fd0499fcbb38ecda6b3475" "basis" 1463 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/edb-import/verification.json"} {"question" "q-40605" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "3"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/state.json" "file_sha256" "7453e424f23cae5d25e530c9ae80bde4210e35b478fd0499fcbb38ecda6b3475" "basis" 1463 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/edb-import/verification.json"} {"question" "q-82950" "field" nil "attribute" "question/problem" "value" "Consider the vector $x$ and the subspace $S=\\text{Span}{{a}_{1},{a}_{2}}$ where\n\n$$\n{a}_{1}=[\\begin{aligned}2 \\\\ -2 \\\\ 0 \\\\ 1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}3 \\\\ 2 \\\\ 1 \\\\ -2\\end{aligned}],\\,\\,x=[\\begin{aligned}5 \\\\ 1 \\\\ 3 \\\\ 1\\end{aligned}].\n$$\n\nFind the acute angle between $x$ and the subspace $S$ given that the set ${{a}_{1},{a}_{2}}$ is orthogonal." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/state.json" "file_sha256" "7453e424f23cae5d25e530c9ae80bde4210e35b478fd0499fcbb38ecda6b3475" "basis" 1463 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/edb-import/verification.json"} {"question" "q-82950" "field" nil "attribute" "question/worked-solution" "value" "Since the set ${{a}_{1},{a}_{2}}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}}$ and $\\text{Span}{{a}_{2}}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{5\\cdot 2+1\\cdot (-2)+3\\cdot 0+1\\cdot 1}{{2}^{2}+(-2)^{2}+{0}^{2}+{1}^{2}}{a}_{1}=[\\begin{aligned}2 \\\\ -2 \\\\ 0 \\\\ 1\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{5\\cdot 3+1\\cdot 2+3\\cdot 1+1\\cdot (-2)}{{3}^{2}+{2}^{2}+{1}^{2}+(-2)^{2}}{a}_{2}=[\\begin{aligned}3 \\\\ 2 \\\\ 1 \\\\ -2\\end{aligned}]\\end{aligned}\n$$\n\n \n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x \\\\  & =[\\begin{aligned}2 \\\\ -2 \\\\ 0 \\\\ 1\\end{aligned}]+[\\begin{aligned}3 \\\\ 2 \\\\ 1 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}5 \\\\ 0 \\\\ 1 \\\\ -1\\end{aligned}].\\end{aligned}\n$$\n\n \n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x$ or any other non-zero vector that is parallel to ${\\text{proj}}_{S}x.$ \n\nComputing the cosine using the dot product, we obtain \n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{x\\cdot {\\text{proj}}_{S}\\,x}{‖x‖\\,‖{\\text{proj}}_{S}\\,x‖} \\\\  & =\\frac{5\\cdot 5+1\\cdot 0+3\\cdot 1+1\\cdot (-1)}{\\sqrt{{5}^{2}+{1}^{2}+{3}^{2}+{1}^{2}}\\sqrt{{5}^{2}+{0}^{2}+{1}^{2}+(-1)^{2}}} \\\\  & =\\frac{27}{\\sqrt{36}\\sqrt{27}} \\\\  & =\\frac{27}{6\\cdot 3\\sqrt{3}} \\\\  & =\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{\\sqrt{3}}{2})=\\frac{\\pi }{6},\n$$\n\nwhich is already an acute angle." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/state.json" "file_sha256" "7453e424f23cae5d25e530c9ae80bde4210e35b478fd0499fcbb38ecda6b3475" "basis" 1463 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/edb-import/verification.json"} {"question" "q-82950" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/activity-metadata.json" "file_sha256" "3944de6a3727f3f405b7dd162373a24dc2a6fe43affdd3ae40a780ce8bceb465" "basis" 1463 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/edb-import/verification.json"} {"question" "q-82950" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/state.json" "file_sha256" "7453e424f23cae5d25e530c9ae80bde4210e35b478fd0499fcbb38ecda6b3475" "basis" 1463 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/edb-import/verification.json"} {"question" "q-82950" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{2\\pi }{5}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/state.json" "file_sha256" "7453e424f23cae5d25e530c9ae80bde4210e35b478fd0499fcbb38ecda6b3475" "basis" 1463 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/edb-import/verification.json