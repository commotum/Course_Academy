y/question-capture-workers/differential/14040677/state.json" "file_sha256" "7453e424f23cae5d25e530c9ae80bde4210e35b478fd0499fcbb38ecda6b3475" "basis" 1463 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/edb-import/verification.json"} {"question" "q-81593" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}-12 \\\\ -11 \\\\ 10\\end{aligned}]"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/state.json" "file_sha256" "7453e424f23cae5d25e530c9ae80bde4210e35b478fd0499fcbb38ecda6b3475" "basis" 1463 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/edb-import/verification.json"} {"question" "q-81593" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}-13 \\\\ -12 \\\\ 11\\end{aligned}]"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/state.json" "file_sha256" "7453e424f23cae5d25e530c9ae80bde4210e35b478fd0499fcbb38ecda6b3475" "basis" 1463 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/edb-import/verification.json"} {"question" "q-81593" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}-13 \\\\ -14 \\\\ 15\\end{aligned}]"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/state.json" "file_sha256" "7453e424f23cae5d25e530c9ae80bde4210e35b478fd0499fcbb38ecda6b3475" "basis" 1463 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/edb-import/verification.json"} {"question" "q-81593" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}-13 \\\\ -12 \\\\ 11\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/state.json" "file_sha256" "7453e424f23cae5d25e530c9ae80bde4210e35b478fd0499fcbb38ecda6b3475" "basis" 1463 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/edb-import/verification.json"} {"question" "q-82915" "field" nil "attribute" "question/problem" "value" "Consider the vector $x$ and the subspace $S=\\text{Span}{{a}_{1},{a}_{2},{a}_{3}}$ where\n\n$$\n{a}_{1}=[\\begin{aligned}-1 \\\\ 3 \\\\ 0 \\\\ 1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}3 \\\\ 1 \\\\ -3 \\\\ 0\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}1 \\\\ 0 \\\\ 1 \\\\ 1\\end{aligned}],\\,\\,x=[\\begin{aligned}2 \\\\ -2 \\\\ -5 \\\\ -3\\end{aligned}].\n$$\n\nFind the distance between $x$ and the subspace $S$ given that the set ${{a}_{1},{a}_{2},{a}_{3}}$ is orthogonal." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/state.json" "file_sha256" "7453e424f23cae5d25e530c9ae80bde4210e35b478fd0499fcbb38ecda6b3475" "basis" 1463 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/edb-import/verification.json"} {"question" "q-82915" "field" nil "attribute" "question/worked-solution" "value" "Since the set ${{a}_{1},{a}_{2},{a}_{3}}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+{\\text{proj}}_{{a}_{3}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}},$ $\\text{Span}{{a}_{2}},$ and $\\text{Span}{{a}_{3}}:$ \n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{2\\cdot (-1)+(-2)\\cdot 3+(-5)\\cdot 0+(-3)\\cdot 1}{(-1)^{2}+{3}^{2}+{0}^{2}+{1}^{2}}{a}_{1}=(-1)[\\begin{aligned}-1 \\\\ 3 \\\\ 0 \\\\ 1\\end{aligned}]=[\\begin{aligned}1 \\\\ -3 \\\\ 0 \\\\ -1\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{2\\cdot 3+(-2)\\cdot 1+(-5)\\cdot (-3)+(-3)\\cdot 0}{{3}^{2}+{1}^{2}+(-3)^{2}+{0}^{2}}{a}_{2}=[\\begin{aligned}3 \\\\ 1 \\\\ -3 \\\\ 0\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{3}}x & =\\frac{x\\cdot {a}_{3}}{{a}_{3}\\cdot {a}_{3}}{a}_{3}=\\frac{2\\cdot 1+(-2)\\cdot 0+(-5)\\cdot 1+(-3)\\cdot 1}{{1}^{2}+{0}^{2}+{1}^{2}+{1}^{2}}{a}_{3}=(-2)[\\begin{aligned}1 \\\\ 0 \\\\ 1 \\\\ 1\\end{aligned}]=[\\begin{aligned}-2 \\\\ 0 \\\\ -2 \\\\ -2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+{\\text{proj}}_{{a}_{3}}x \\\\  & =[\\begin{aligned}1 \\\\ -3 \\\\ 0 \\\\ -1\\end{aligned}]+[\\begin{aligned}3 \\\\ 1 \\\\ -3 \\\\ 0\\end{aligned}]+[\\begin{aligned}-2 \\\\ 0 \\\\ -2 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ -2 \\\\ -5 \\\\ -3\\end{aligned}]=x.\\end{aligned}\n$$\n\nSince $x$ coincides with the projection, the distance between $x$ and the subspace $S$ is zero $0.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/state.json" "file_sha256" "7453e424f23cae5d25e530c9ae80bde4210e35b478fd0499fcbb38ecda6b3475" "basis" 1463 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/edb-import/verification.json"} {"question" "q-82915" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/activity-metadata.json" "file_