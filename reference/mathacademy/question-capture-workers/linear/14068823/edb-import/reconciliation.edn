+\\frac{1}{2}[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}] \\\\  & =\\frac{1}{2}(-[\\begin{aligned}-3 \\\\ 2 \\\\ 1\\end{aligned}]+[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}]) \\\\  & =[\\begin{aligned}2 \\\\ 0 \\\\ -1\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068823/state.json" "file_sha256" "e17857f99f1248b4b20894fdfb6976eb50fd23565097f524a0779507212390b1"} {"question" "q-81583" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068823/activity-metadata.json" "file_sha256" "748144e91d47d8b68a80cf7b0ffb60680993bc9ca26aa4558cf96603d9db5041"} {"question" "q-81583" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068823/state.json" "file_sha256" "e17857f99f1248b4b20894fdfb6976eb50fd23565097f524a0779507212390b1"} {"question" "q-81583" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-4 \\\\ -2 \\\\ -8\\end{aligned}]"] ["math" "[\\begin{aligned}1 \\\\ -1 \\\\ -2\\end{aligned}]"] ["math" "[\\begin{aligned}1 \\\\ 1 \\\\ \\frac{9}{2}\\end{aligned}]"] ["math" "[\\begin{aligned}2 \\\\ 0 \\\\ -1\\end{aligned}]"] ["math" "[\\begin{aligned}2 \\\\ 2 \\\\ 4\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068823/state.json" "file_sha256" "e17857f99f1248b4b20894fdfb6976eb50fd23565097f524a0779507212390b1"} {"question" "q-81583" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}2 \\\\ 0 \\\\ -1\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jak