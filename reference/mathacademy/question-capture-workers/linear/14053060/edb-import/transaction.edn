[{:db/id "q-70824/selection/99fd10123cd9620f7306d51d5f61348372377dc3e059d1f208f9d30ab69e5a56" :answer/id #uuid "9aab0509-0713-554b-bd43-62d0da345e2c" :answer/type :answer.type/math :answer/value "(r-⟨0,0,-13⟩)\\cdot ⟨1,7,-1⟩=0" :db/ensure [:answer/validate]} {:db/id "q-70824/selection/bafcbbbf671f7955e4851139c14aeb0064c9d08518a661c960b6ec6d00ac3b00" :answer/id #uuid "d2448346-43c6-590b-9968-d4ed7fc8748b" :answer/type :answer.type/math :answer/value "(r-⟨0,0,-13⟩)\\cdot ⟨0,7,-1⟩=0" :db/ensure [:answer/validate]} {:db/id "q-70824/selection/1cbb2968855394969708151198a3e2c636fab43a508ced4c9cce9aafec7c34c3" :answer/id #uuid "458d73e7-e69a-5e49-aa1b-7ae669f9ba1b" :answer/type :answer.type/math :answer/value "(r-⟨0,0,-13⟩)\\cdot ⟨7,-1,-13⟩=0" :db/ensure [:answer/validate]} {:db/id "q-70824/selection/6380ad62ae656bab4d23ec965196c9abb8119516514814661d9012306014a6a1" :answer/id #uuid "fccba118-c501-5493-8815-fce15a059ff9" :answer/type :answer.type/math :answer/value "(r-⟨0,0,13⟩)\\cdot ⟨0,7,-1⟩=0" :db/ensure [:answer/validate]} {:db/id "q-70824/selection/8f28f947eafb09da8735bed36e6768b41657390300a08d391ea50de6e0a3b33f" :answer/id #uuid "d13d7a66-dcff-5762-9e7c-e3f5f296895c" :answer/type :answer.type/math :answer/value "(r-⟨0,0,13⟩)\\cdot ⟨7,-1,-13⟩=0" :db/ensure [:answer/validate]} {:db/id "q-70824/selection" :answer-field/id #uuid "13bdc4cb-6d8d-5740-a5fd-192e72ab4302" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-70824/selection/bafcbbbf671f7955e4851139c14aeb0064c9d08518a661c960b6ec6d00ac3b00" :answer-field/choices ["q-70824/selection/99fd10123cd9620f7306d51d5f61348372377dc3e059d1f208f9d30ab69e5a56" "q-70824/selection/bafcbbbf671f7955e4851139c14aeb0064c9d08518a661c960b6ec6d00ac3b00" "q-70824/selection/1cbb2968855394969708151198a3e2c636fab43a508ced4c9cce9aafec7c34c3" "q-70824/selection/6380ad62ae656bab4d23ec965196c9abb8119516514814661d9012306014a6a1" "q-70824/selection/8f28f947eafb09da8735bed36e6768b41657390300a08d391ea50de6e0a3b33f"] :db/ensure [:answer-field/validate]} {:db/id "q-70824" :question/id #uuid "7d906b68-2682-5ae7-a3b1-5cdc64fb4dd3" :question/math-academy-id "q-70824" :question/problem "Given the Cartesian equation $7y-z-13=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨0,7,-1⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $z$:\n\n$$\n\\begin{aligned}7y-z-13 & =0 \\\\ z & =7y-13.\\end{aligned}\n$$\n\nIf we put, say, $y=0$, we get $z=-13.$ Hence, the point $P(0,0,-13)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,0,-13⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,0,-13⟩)\\cdot ⟨0,7,-1⟩ & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-70824/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "80c443e5-a0b2-5aae-ac8d-27449a8049a3"] :knowledge-point/questions ["q-70824"] :db/ensure [:knowledge-point/validate]} {:db/id "q-128383/selection/7d0a6ed292141ca2dc9936b0f799d0338963b5c72ead7b42a53a54a0fd7e044d" :answer/id #uuid "6f6c7545-300a-5f79-9ad5-7f782ed66287" :answer/type :answer.type/math :answer/value "(r-⟨0,0,17⟩)\\cdot ⟨0,5,-1⟩=0" :db/ensure [:answer/validate]} {:db/id "q-128383/selection/9915f5cdcd13bea90a28f3c1bbc427ca247134de6386c10409539750df502945" :answer/id #uuid "aa61c838-b3e4-5a91-adcd-a4b5442e3c76" :answer/type :answer.type/math :answer/value "(r-⟨0,0,13⟩)\\cdot ⟨0,-1,5⟩=0" :db/ensure [:answer/validate]} {:db/id "q-128383/selection/950368ea899da0ca8011aeb35b9b2b984a8174985059acd0012d7e0276189621" :answer/id #uuid "f7906bff-53ba-5d37-a117-b6295b92ec3c" :answer/type :answer.type/math :answer/value "(r-⟨0,0,-21⟩)\\cdot ⟨5,0,-1⟩=0" :db/ensure [:answer/validate]} {:db/id "q-128383/selection/c9d637ba66a5ecc7f1cc2a6500fa853633606dba41af22cbb4f133a2181a0bb7" :answer/id #uuid "7b76d532-b19d-53d8-af16-cf5c