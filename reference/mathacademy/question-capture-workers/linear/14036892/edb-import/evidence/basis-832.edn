#{[{:db/id #edb/ref 17592186278569 :knowledge-point/_questions [{:knowledge-point/id #uuid "7c2791d4-f801-5555-a859-1d373f91a67e" :knowledge-point/title "Evaluating Arcsine When a Coterminal Angle is Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "751c92b4-3b48-546b-902e-6679a757225c" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\pi " :db/id #edb/ref 17592186278571} {:answer/id #uuid "e80728a9-3025-5675-8bbd-4f6c11fc4c4a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5\\pi }{3}" :db/id #edb/ref 17592186278572} {:answer/id #uuid "485d1a06-bc45-55d7-bc84-3ff478f6c358" :answer/type {:db/ident :answer.type/math} :answer/value "10\\pi " :db/id #edb/ref 17592186278573} {:answer/id #uuid "41e81461-54b6-55ff-bb29-74298379cdaa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{2}" :db/id #edb/ref 17592186278574} {:answer/id #uuid "ee2cea99-320f-5686-80a6-703358b8b96f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{10\\pi }{3}" :db/id #edb/ref 17592186278575}] :answer-field/correct {:answer/id #uuid "751c92b4-3b48-546b-902e-6679a757225c" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\pi " :db/id #edb/ref 17592186278571} :answer-field/id #uuid "1375ee2f-e69d-5865-9f2a-987fca463960" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278570}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "2dbc0e3f-52e0-5c91-bb08-00ee163a5979" :question/math-academy-id "q-117412" :question/problem "$10\\operatorname{arcsin}⁡(-1)=$" :question/worked-solution "First, note that the range of $\\theta =\\operatorname{arcsin}⁡x$ is given by\n\n$$\n-\\frac{\\pi }{2}\\le \\theta \\le \\frac{\\pi }{2}.\n$$\n\nNow, let's take a look at the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978511/assets/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the values in the unit circle, we see that\n\n$$\n\\operatorname{sin}⁡(\\frac{3\\pi }{2})=-1.\n$$\n\nHowever, $\\frac{3\\pi }{2}$ does not lie within the range of $\\theta .$ To get an angle that's coterminal with $\\frac{3\\pi }{2}$ that lies within the range of $\\theta ,$ we subtract $2\\pi .$\n\n$$\n\\frac{3\\pi }{2}-2\\pi =-\\frac{\\pi }{2}.\n$$\n\nHence,\n\n$$\n\\operatorname{arcsin}⁡(-1)=-\\frac{\\pi }{2}.\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}10\\operatorname{arcsin}⁡(-1) & =10\\cdot (-\\frac{\\pi }{2}) \\\\  & =-5\\pi .\\end{aligned}\n$$"}]}
