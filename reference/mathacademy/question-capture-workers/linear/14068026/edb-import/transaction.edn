dot (1+t-{t}^{2}) \\\\  & =-1-t-{t}^{2}+1+t-{t}^{2} \\\\  & =-2{t}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-106738/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bf357ee2-b8b4-538c-b269-f7546cf5374f"] :knowledge-point/questions ["q-106738"] :db/ensure [:knowledge-point/validate]} {:db/id "q-106734/selection/bcdb9c2fa2a3242a405a3ffde4af5317c0bf3260cff70c0f2d28ebbcea1fb16d" :answer/id #uuid "c4570e4d-6dbd-5fb6-98b3-49558a9bb987" :answer/type :answer.type/math :answer/value "1+7{t}^{2}+3{t}^{3}" :db/ensure [:answer/validate]} {:db/id "q-106734/selection/70a07b257a2b6f5b6278631d3221c87d4980304a85e43712c65a7dd98a98cb0e" :answer/id #uuid "1405f7d0-0c63-57d7-917e-bdcd478c70a9" :answer/type :answer.type/math :answer/value "-1+3{t}^{2}" :db/ensure [:answer/validate]} {:db/id "q-106734/selection/aedbd5c20e433dff735a93895c1644ae482297f97e53946f6316caefd2966f20" :answer/id #uuid "f5aee792-0b83-5755-ada4-b58520de2b5d" :answer/type :answer.type/math :answer/value "-2+3{t}^{3}" :db/ensure [:answer/validate]} {:db/id "q-106734/selection/c5a2d031ecb6a450fe879e4d7dd305c8663866039278e87021f809cb8d141e74" :answer/id #uuid "7c4ab561-ecca-57bb-8995-41648db1a16f" :answer/type :answer.type/math :answer/value "-2-{t}^{3}" :db/ensure [:answer/validate]} {:db/id "q-106734/selection/afbf5d020f97c839293a9351338ad88dbcaeadfa94656a57550ddab6b9748e44" :answer/id #uuid "40dad6c3-5ef4-5182-94bb-4e75088301d8" :answer/type :answer.type/math :answer/value "1+2{t}^{3}" :db/ensure [:answer/validate]} {:db/id "q-106734/selection" :answer-field/id #uuid "d6e5277b-f16d-59d2-ac9b-3a19a2327087" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-106734/selection/aedbd5c20e433dff735a93895c1644ae482297f97e53946f6316caefd2966f20" :answer-field/choices ["q-106734/selection/bcdb9c2fa2a3242a405a3ffde4af5317c0bf3260cff70c0f2d28ebbcea1fb16d" "q-106734/selection/70a07b257a2b6f5b6278631d3221c87d4980304a85e43712c65a7dd98a98cb0e" "q-106734/selection/aedbd5c20e433dff735a93895c1644ae482297f97e53946f6316caefd2966f20" "q-106734/selection/c5a2d031ecb6a450fe879e4d7dd305c8663866039278e87021f809cb8d141e74" "q-106734/selection/afbf5d020f97c839293a9351338ad88dbcaeadfa94656a57550ddab6b9748e44"] :db/ensure [:answer-field/validate]} {:db/id "q-106734" :question/id #uuid "36c572db-161a-5a7b-ac35-d9a1bb392d6b" :question/math-academy-id "q-106734" :question/problem "Consider the polynomials ${p}_{1}(t)$ and ${p}_{2}(t),$ given by\n\n$$\n{p}_{1}(t)=2{t}^{2}+{t}^{3},\\,{p}_{2}(t)=1+3{t}^{2}.\n$$\n\nFind $p(t)$ given that $B={{p}_{1}(t),{p}_{2}(t)}$ is a basis of $\\text{Span}{{p}_{1},{p}_{2}},$ and the coordinates of $p(t)$ relative to $B$ are $[p(t)]_{B}=[\\begin{aligned}3 \\\\ -2\\end{aligned}].$" :question/worked-solution "Any vector in  $\\text{Span}{{p}_{1},{p}_{2}}$ can be written as\n\n$$\n\\begin{aligned}{x}_{1}{p}_{1}(t)+{x}_{2}{p}_{2}(t).\\end{aligned}\n$$\n\nIn our case, we have \n\n$$\n[p(t)]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}3 \\\\ -2\\end{aligned}].\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}p(t) & =3\\cdot (2{t}^{2}+{t}^{3})+(-2)\\cdot (1+3{t}^{2}) \\\\  & =6{t}^{2}+3{t}^{3}-2-6{t}^{2} \\\\  & =-2+3{t}^{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-106734/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bf357ee2-b8b4-538c-b269-f7546cf5374f"] :knowledge-point/questions ["q-106734"] :db/ensure [:knowledge-point/validate]} {:db/id "q-95003/selection/7f51f34b28508c08fdcb519381c3fcfcbaab6fbeba9c9e17acafee912ceabe86" :answer/id #uuid "ab03593a-6334-5fee-8805-ae0f8d9e5b92" :answer/type :answer.type/math :answer/value "p(t)=1+2t-{t}^{2}" :db/ensure [:answer/validate]} {:db/id "q-95003/selection/c36a7f15b9e33565de3af845123b88161c008442f785a1c184bd008eefa8573a" :answer/id #uuid "91948abf-3c11-5964-af8e-c5fa4762fb6c" :answer/type :answer.