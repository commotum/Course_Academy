gned}1 \\\\ 3\\end{aligned}].$" :question/worked-solution "Any vector in  $\\text{Span}{{p}_{1},{p}_{2}}$ can be written as\n\n$$\n\\begin{aligned}{x}_{1}{p}_{1}(t)+{x}_{2}{p}_{2}(t).\\end{aligned}\n$$\n\nIn our case, we have \n\n$$\n[p(t)]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}1 \\\\ 3\\end{aligned}].\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}p(t) & =1\\cdot (1-t+2{t}^{2})+3\\cdot (t-{t}^{2}) \\\\  & =1-t+2{t}^{2}+3t-3{t}^{2} \\\\  & =1+2t-{t}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-95003/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bf357ee2-b8b4-538c-b269-f7546cf5374f"] :knowledge-point/questions ["q-95003"] :db/ensure [:knowledge-point/validate]} {:db/id "q-106731/selection/c454a4c97206ef14c450bb6d41ceaf60e16ad0e4fd6e809cc474ddca0b616f3e" :answer/id #uuid "da8c6082-9fc3-54ae-adf3-5181d9e294da" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & 0 \\\\ -4 & 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-106731/selection/0b23fbb60394b96e44436a3e9a0f11b30247af5d8e9af8955e0b1be9428538fa" :answer/id #uuid "034d28dc-bddb-546b-b2a9-ca856946ff50" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & 0 \\\\ 6 & -4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-106731/selection/25244366628ec6a1139ea77d6bdf4fe307f2b8fd757414935d9d90a14bf7f938" :answer/id #uuid "ce2d02ba-13a5-554a-9a5b-33138abff037" :answer/type :answer.type/math :answer/value "[\\begin{aligned}6 & 0 \\\\ 2 & -4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-106731/selection/3f84056b095eeb6e87d9b74c4364f9dcee320d072c370348cbc9ed7095f05e13" :answer/id #uuid "c615bbe7-5fa8-5c95-b74e-1fcb5157e024" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & -4 \\\\ 6 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-106731/selection/d684b2d54e83ff13de8332b1738c3a3cbeeabbcf4bbbfd21d7af3c840e13d1e9" :answer/id #uuid "511021be-4fc1-5e5d-af0d-ee33b5168075" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 2 \\\\ 6 & -4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-106731/selection" :answer-field/id #uuid "2d4b7fe2-441e-5524-90b9-0a9d8224bd7d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-106731/selection/0b23fbb60394b96e44436a3e9a0f11b30247af5d8e9af8955e0b1be9428538fa" :answer-field/choices ["q-106731/selection/c454a4c97206ef14c450bb6d41ceaf60e16ad0e4fd6e809cc474ddca0b616f3e" "q-106731/selection/0b23fbb60394b96e44436a3e9a0f11b30247af5d8e9af8955e0b1be9428538fa" "q-106731/selection/25244366628ec6a1139ea77d6bdf4fe307f2b8fd757414935d9d90a14bf7f938" "q-106731/selection/3f84056b095eeb6e87d9b74c4364f9dcee320d072c370348cbc9ed7095f05e13" "q-106731/selection/d684b2d54e83ff13de8332b1738c3a3cbeeabbcf4bbbfd21d7af3c840e13d1e9"] :db/ensure [:answer-field/validate]} {:db/id "q-106731" :question/id #uuid "e6e0ce47-91dc-5e23-9eed-7afbcab835c8" :question/math-academy-id "q-106731" :question/problem "$$\n{A}_{1}=[\\begin{aligned}0 & 1 \\\\ -1 & 2\\end{aligned}],\\,{A}_{2}=[\\begin{aligned}1 & 1 \\\\ 2 & 0\\end{aligned}]\n$$\n\nConsider the matrices shown above. Find the matrix $C$ given that $B={{A}_{1},{A}_{2}}$ is a basis of $\\text{Span}{{A}_{1},{A}_{2}},$ and the coordinates of the matrix $C$ relative to $B$ are $[C]_{B}=[\\begin{aligned}-2 \\\\ 2\\end{aligned}].$" :question/worked-solution "Any vector in $\\text{Span}{{A}_{1},{A}_{2}}$ can be written as\n\n$$\n\\begin{aligned}{x}_{1}{A}_{1}+{x}_{2}{A}_{2}.\\end{aligned}\n$$\n\nIn our case, we have \n\n$$\n[C]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}-2 \\\\ 2\\end{aligned}].\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}C & =(-2)\\cdot [\\begin{aligned}0 & 1 \\\\ -1 & 2\\end{aligned}]+2\\cdot [\\begin{aligned}1 & 1 \\\\ 2 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}0 & -2 \\\\ 2 & -4\\end{aligned}]+[\\begin{aligned}2 & 2 \\\\ 4 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 0 \\\\ 6 & -4\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-106731/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bf357ee2-b8b4-538c-b269-f7546cf5374f"] :knowledge-point/questions ["q-106731"] :db/ensure [:knowledge-point/validate]} {:db/id "q-95016/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "5708ea06-b04b-5638-a054-a56fe0c20711" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-95016/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "aab392c5-9efe-5e63-b461-eca271523402" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-95016/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "bcf79ca7-0f57-55c0-8882-f595d83222ab" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-95016/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "123a4976-8481-52fe-b3d0-b3027426bbf4" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-95016/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "fce6f491-9599-5367-aac9-715e94e4ea00" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-95016/selection" :answer-field/id #uuid "dab64fb8-3555-5c2f-8161-57e09097b214" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-95016/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-95016/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-95016/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-95016/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-95016/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-95016/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-95016" :question/id #uuid "84ea530c-a658-5939-9d7a-dcc4269fa091" :question/math-academy-id "q-95016" :question/problem "Consider the following matrices:\n\n$$\n{B}_{1}=[\\begin{aligned}4 & -1 \\\\ 3 & 0\\end{aligned}],\\,{B}_{2}=[\\begin{aligned}6 & 3 \\\\ 2 & 0\\end{aligned}],\\,A=[\\begin{aligned}-2 & 5 \\\\ -4 & 0\\end{aligned}]\n$$\n\nIf $B={{B}_{1},{B}_{2}}$ is a basis of $\\text{Span}{{B}_{1},{B}_{2}},$ and $[A]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],$ then ${x}_{1}+{x}_{2}=$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{B}_{1}+{x}_{2}{B}_{2}=A.\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}4 & -1 \\\\ 3 & 0\\end{aligned}]+{x}_{2}[\\begin{aligned}6 & 3 \\\\ 2 & 0\\end{aligned}] & =[\\begin{aligned}-2 & 5 \\\\ -4 & 0\\end{aligned}] \\\\ [\\begin{aligned}4{x}_{1}+6{x}_{2} & -{x}_{1}+3{x}_{2} \\\\ 3{x}_{1}+2{x}_{2} & 0\\end{aligned}] & =[\\begin{aligned}-2 & 5 \\\\ -4 & 0\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding entries, we obtain\n\n$$\n{\\begin{aligned}4{x}_{1}+6{x}_{2}=-2 \\\\ -{x}_{1}+3{x}_{2}=5 \\\\ 3{x}_{1}+2{x}_{2}=-4.\\end{aligned}\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=[\\begin{aligned}4 & 6 & -2 \\\\ -1 & 3 & 5 \\\\ 3 & 2 & -4\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}4 & 6 & -2 \\\\ -1 & 3 & 5 \\\\ 3 & 2 & -4\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+\\frac{1}{4}{R}_{1} \\\\ {R}_{3}:={R}_{3}+(-\\frac{3}{4}){R}_{1}\\end{aligned} \\\\ ∼ & [\\begin{aligned}4 & 6 & -2 \\\\ 0 & \\frac{9}{2} & \\frac{9}{2} \\\\ 0 & -\\frac{5}{2} & -\\frac{5}{2}\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n{\\begin{aligned}4{x}_{1}+6{x}_{2}=-2 \\\\ \\frac{9}{2}{x}_{2}=\\frac{9}{2} \\\\ -\\frac{5}{2}{x}_{2}=-\\frac{5}{2}.\\end{aligned}\n$$\n\nFrom the second and third equations, we get ${x}_{2}=1.$ From the first equation, we get \n\n$$\n\\begin{aligned}4{x}_{1}+6\\cdot 1 & =-2 \\\\ 4{x}_{1} & =-8 \\\\ {x}_{1} & =-2.\\end{aligned}\n$$\n\n \n\nTherefore, $[A]_{B}=[\\begin{aligned}-2 \\\\ 1\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=-2+1=-1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-95016/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b0a6b6e1-fb99-5ebe-9f3f-000878f79f0d"] :knowledge-point/questions ["q-95016"] :db/ensure [:knowledge-point/validate]} {:db/id "q-95019/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "befce8bc-d889-5fdb-b67c-29beff1198ac" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-95019/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "faded25f-b002-5c83-accb-c26c50c30a5d" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-95019/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "8ce0956e-19a7-56e6-91eb-768d935e33ca" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-95019/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer/id #uuid "0529de1a-e2f7-523f-b1f3-efaea7141ed0" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-95019/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "4ee55576-9bba-592f-a54a-bf90901ec82a" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-95019/selection" :answer-field/id #uuid "3a95c201-0b8b-55b7-b96d-5085de88ffe6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-95019/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer-field/choices ["q-95019/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-95019/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-95019/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-95019/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" "q-95019/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873"] :db/ensure [:answer-field/validate]} {:db/id "q-95019" :question/id #uuid "afea1de7-9432-5f54-8eea-c94a31190309" :question/math-academy-id "q-95019" :question/problem "Consider the following matrices:\n\n$$\n{B}_{1}=[\\begin{aligned}2 & 0 \\\\ 0 & -2\\end{aligned}],\\,{B}_{2}=[\\begin{aligned}5 & -3 \\\\ 0 & 4\\end{aligned}],\\,A=[\\begin{aligned}4 & -3 \\\\ 0 & 5\\end{aligned}]\n$$\n\nIf $B={{B}_{1},{B}_{2}}$ is a basis of $\\text{Span}{{B}_{1},{B}_{2}},$ and $[A]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],$ then ${x}_{1}+{x}_{2}=$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{B}_{1}+{x}_{2}{B}_{2}=A.\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}2 & 0 \\\\ 0 & -2\\end{aligned}]+{x}_{2}[\\begin{aligned}5 & -3 \\\\ 0 & 4\\end{aligned}] & =[\\begin{aligned}4 & -3 \\\\ 0 & 5\\end{aligned}] \\\\ [\\begin{aligned}2{x}_{1}+5{x}_{2} & -3{x}_{2} \\\\ 0 & -2{x}_{1}+4{x}_{2}\\end{aligned}] & =[\\begin{aligned}4 & -3 \\\\ 0 & 5\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding entries, we obtain\n\n$$\n{\\begin{aligned}2{x}_{1}+5{x}_{2}=4 \\\\ -3{x}_{2}=-3 \\\\ -2{x}_{1}+4{x}_{2}=5.\\end{aligned}\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=[\\begin{aligned}2 & 5 & 4 \\\\ 0 & -3 & -3 \\\\ -2 & 4 & 5\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}2 & 5 & 4 \\\\ 0 & -3 & -3 \\\\ -2 & 4 & 5\\end{aligned}] &  & \\begin{aligned}{R}_{3}:={R}_{3}+{R}_{1}\\end{aligned} \\\\ ∼ & [\\begin{aligned}2 & 5 & 4 \\\\ 0 & -3 & -3 \\\\ 0 & 9 & 9\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n{\\begin{aligned}2{x}_{1}+5{x}_{2}=4 \\\\ -3{x}_{2}=-3 \\\\ 9{x}_{2}=9.\\end{aligned}\n$$\n\nFrom the second and third equations, we get ${x}_{2}=1.$ From the first equation, we get \n\n$$\n\\begin{aligned}2{x}_{1}+5\\cdot 1 & =4 \\\\ 2{x}_{1} & =-1 \\\\ {x}_{1} & =-\\frac{1}{2}.\\end{aligned}\n$$\n\n \n\nTherefore, $[A]_{B}=[\\begin{aligned}-\\frac{1}{2} \\\\ 1\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=-\\frac{1}{2}+1=\\frac{1}{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-95019/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b0a6b6e1-fb99-5ebe-9f3f-000878f79f0d"] :knowledge-point/questions ["q-95019"] :db/ensure [:knowledge-point/validate]} {:db/id "q-95021/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" :answer/id #uuid "739cd2a1-5a1e-53dc-8acb-f2b06faf2244" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-95021/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "05f3ae63-922a-5860-b37b-e32c286bfc69" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-95021/selection/3a619fab2616dab0463f9c76cb72cd9f101e45e62111356a5b0b111e062a8dcf" :answer/id #uuid "5f9c0363-5960-510b-bb27-0c46b7229f37" :answer/type :answer.type/math :answer/value "-\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-95021/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "acd0504f-f5b9-5d55-9e5b-172b1742dc12" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-95021/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer/id #uuid "4e791db8-f35b-58c5-8e02-3d2b6c2d0081" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-95021/selection" :answer-field/id #uuid "f8560350-b85b-576d-a9b0-536bd49e1a1e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-95021/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" :answer-field/choices ["q-95021/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" "q-95021/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-95021/selection/3a619fab2616dab0463f9c76cb72cd9f101e45e62111356a5b0b111e062a8dcf" "q-95021/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-95021/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833"] :db/ensure [:answer-field/validate]} {:db/id "q-95021" :question/id #uuid "13bb45a0-733a-5979-8561-2d8d7531fe0c" :question/math-academy-id "q-95021" :question/problem "Consider the following matrices:\n\n$$\n{B}_{1}=[\\begin{aligned}1 & -3 \\\\ 1 & 0\\end{aligned}],\\,{B}_{2}=[\\begin{aligned}2 & 3 \\\\ -4 & 0\\end{aligned}],\\,A=[\\begin{aligned}1 & 0 \\\\ -1 & 0\\end{aligned}]\n$$\n\nIf $B={{B}_{1},{B}_{2}}$ is a basis of $\\text{Span}{{B}_{1},{B}_{2}},$ and $[A]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],$ then ${x}_{1}+{x}_{2}=$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{B}_{1}+{x}_{2}{B}_{2}=A.\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}1 & -3 \\\\ 1 & 0\\end{aligned}]+{x}_{2}[\\begin{aligned}2 & 3 \\\\ -4 & 0\\end{aligned}] & =[\\begin{aligned}1 & 0 \\\\ -1 & 0\\end{aligned}] \\\\ [\\begin{aligned}{x}_{1}+2{x}_{2} & -3{x}_{1}+3{x}_{2} \\\\ {x}_{1}-4{x}_{2} & 0\\end{aligned}] & =[\\begin{aligned}1 & 0 \\\\ -1 & 0\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding entries, we obtain\n\n$$\n{\\begin{aligned}{x}_{1}+2{x}_{2}=1 \\\\ -3{x}_{1}+3{x}_{2}=0 \\\\ {x}_{1}-4{x}_{2}=-1.\\end{aligned}\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=[\\begin{aligned}1 & 2 & 1 \\\\ -3 & 3 & 0 \\\\ 1 & -4 & -1\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}1 & 2 & 1 \\\\ -3 & 3 & 0 \\\\ 1 & -4 & -1\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+3{R}_{1} \\\\ {R}_{3}:={R}_{3}-{R}_{1}\\end{aligned} \\\\ ∼ & [\\begin{aligned}1 & 2 & 1 \\\\ 0 & 9 & 3 \\\\ 0 & -6 & -2\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n{\\begin{aligned}{x}_{1}+2{x}_{2}=1 \\\\ 9{x}_{2}=3 \\\\ -6{x}_{2}=-2.\\end{aligned}\n$$\n\nFrom the second and third equations, we get ${x}_{2}=\\frac{1}{3}.$ From the first equation, we get \n\n$$\n\\begin{aligned}{x}_{1}+2\\cdot \\frac{1}{3} & =1 \\\\ {x}_{1} & =1-\\frac{2}{3} \\\\ {x}_{1} & =\\frac{1}{3}.\\end{aligned}\n$$\n\n \n\nTherefore, $[A]_{B}=[\\begin{aligned}\\frac{1}{3} \\\\ \\frac{1}{3}\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=\\frac{1}{3}+\\frac{1}{3}=\\frac{2}{3}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-95021/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b0a6b6e1-fb99-5ebe-9f3f-000878f79f0d"] :knowledge-point/questions ["q-95021"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-36587"] :question/problem "Consider the following matrices:\n\n$$\n{B}_{1}=[\\begin{aligned}4 & 5 \\\\ 4 & 0\\end{aligned}],\\,{B}_{2}=[\\begin{aligned}0 & -3 \\\\ 2 & 0\\end{aligned}],\\,A=[\\begin{aligned}2 & 1 \\\\ 3 & 0\\end{aligned}]\n$$\n\nIf $B={{B}_{1},{B}_{2}}$ is a basis of $\\text{Span}{{B}_{1},{B}_{2}},$ and $[A]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],$ then ${x}_{1}+{x}_{2}=$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{B}_{1}+{x}_{2}{B}_{2}=A.\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}4 & 5 \\\\ 4 & 0\\end{aligned}]+{x}_{2}[\\begin{aligned}0 & -3 \\\\ 2 & 0\\end{aligned}] & =[\\begin{aligned}2 & 1 \\\\ 3 & 0\\end{aligned}] \\\\ [\\begin{aligned}4{x}_{1} & 5{x}_{1}-3{x}_{2} \\\\ 4{x}_{1}+2{x}_{2} & 0\\end{aligned}] & =[\\begin{aligned}2 & 1 \\\\ 3 & 0\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding entries, we obtain\n\n$$\n{\\begin{aligned}4{x}_{1}=2 \\\\ 5{x}_{1}-3{x}_{2}=1 \\\\ 4{x}_{1}+2{x}_{2}=3.\\end{aligned}\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=[\\begin{aligned}4 & 0 & 2 \\\\ 5 & -3 & 1 \\\\ 4 & 2 & 3\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}4 & 0 & 2 \\\\ 5 & -3 & 1 \\\\ 4 & 2 & 3\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-\\frac{5}{4}){R}_{1} \\\\ {R}_{3}:={R}_{3}+(-1){R}_{1}\\end{aligned} \\\\ ∼ & [\\begin{aligned}4 & 0 & 2 \\\\ 0 & -3 & -\\frac{3}{2} \\\\ 0 & 2 & 1\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n{\\begin{aligned}4{x}_{1}=2 \\\\ -3{x}_{2}=-\\frac{3}{2} \\\\ 2{x}_{2}=1.\\end{aligned}\n$$\n\nFrom the second and third equations, we get ${x}_{2}=\\frac{1}{2}.$ From the first equation, we get ${x}_{1}=\\frac{1}{2}.$ \n\nTherefore, $[A]_{B}=[\\begin{aligned}\\frac{1}{2} \\\\ \\frac{1}{2}\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=\\frac{1}{2}+\\frac{1}{2}=1.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-106754/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "57c69f71-b8cb-5391-a29a-6dd0743209c2" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-106754/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "17628429-f69b-5236-9a21-11d3d0af5fd1" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-106754/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "64fea624-acea-5cf4-b16d-0568f284b3cd" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-106754/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "06a0f92a-05aa-5af5-902c-cc55ff38c8fc" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-106754/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "d6c25450-143c-5989-b394-4c41a0954d07" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-106754/selection" :answer-field/id #uuid "8e007509-0bcf-592e-8589-2e45781774fd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-106754/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-106754/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-106754/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-106754/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-106754/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-106754/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc"] :db/ensure [:answer-field/validate]} {:db/id "q-106754" :question/id #uuid "44ae9122-cee2-505f-a379-1662f2833f82" :question/math-academy-id "q-106754" :question/problem "Consider the following matrices:\n\n$$\n{B}_{1}=[\\begin{aligned}0 & 2 \\\\ 3 & -2\\end{aligned}],\\,{B}_{2}=[\\begin{aligned}0 & -2 \\\\ 4 & 3\\end{aligned}],\\,A=[\\begin{aligned}0 & 4 \\\\ 20 & -2\\end{aligned}]\n$$\n\nIf $B={{B}_{1},{B}_{2}}$ is a basis of $\\text{Span}{{B}_{1},{B}_{2}},$ and $[A]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],$ then ${x}_{1}+{x}_{2}=$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{B}_{1}+{x}_{2}{B}_{2}=A.\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}0 & 2 \\\\ 3 & -2\\end{aligned}]+{x}_{2}[\\begin{aligned}0 & -2 \\\\ 4 & 3\\end{aligned}] & =[\\begin{aligned}0 & 4 \\\\ 20 & -2\\end{aligned}] \\\\ [\\begin{aligned}0 & 2{x}_{1}-2{x}_{2} \\\\ 3{x}_{1}+4{x}_{2} & -2{x}_{1}+3{x}_{2}\\end{aligned}] & =[\\begin{aligned}0 & 4 \\\\ 20 & -2\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding entries, we obtain\n\n$$\n{\\begin{aligned}2{x}_{1}-2{x}_{2}=4 \\\\ 3{x}_{1}+4{x}_{2}=20 \\\\ -2{x}_{1}+3{x}_{2}=-2.\\end{aligned}\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=[\\begin{aligned}2 & -2 & 4 \\\\ 3 & 4 & 20 \\\\ -2 & 3 & -2\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}2 & -2 & 4 \\\\ 3 & 4 & 20 \\\\ -2 & 3 & -2\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-\\frac{3}{2}){R}_{1} \\\\ {R}_{3}:={R}_{3}+{R}_{1}\\end{aligned} \\\\ ∼ & [\\begin{aligned}2 & -2 & 4 \\\\ 0 & 7 & 14 \\\\ 0 & 1 & 2\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n{\\begin{aligned}2{x}_{1}-2{x}_{2}=4 \\\\ 7{x}_{2}=14 \\\\ {x}_{2}=2.\\end{aligned}\n$$\n\nFrom the second and third equations, we get ${x}_{2}=2.$ From the first equation, we get \n\n$$\n\\begin{aligned}2{x}_{1}-2\\cdot 2 & =4 \\\\ 2{x}_{1} & =8 \\\\ {x}_{1} & =4.\\end{aligned}\n$$\n\n \n\nTherefore, $[A]_{B}=[\\begin{aligned}4 \\\\ 2\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=4+2=6.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-106754/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b0a6b6e1-fb99-5ebe-9f3f-000878f79f0d"] :knowledge-point/questions ["q-106754"] :db/ensure [:knowledge-point/validate]} {:db/id "q-106781/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "d407ee49-d375-5f07-96f7-3edff2a9b14a" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-106781/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "fc6db49c-f6cf-534f-9256-3ea85e849f3b" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-106781/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "a8f09e20-8e48-5d9b-a50e-db968a8a1b39" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-106781/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "dde077ac-17fc-5257-b315-7fc1f1136f27" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-106781/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "2f2a6cca-1263-57ba-84d1-617ceb3fedbc" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-106781/selection" :answer-field/id #uuid "3942f42e-f4aa-51bc-84fa-59c082b9c472" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-106781/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-106781/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-106781/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-106781/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-106781/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-106781/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-106781" :question/id #uuid "d81b7258-84b1-569c-b6cf-ebc3733c7061" :question/math-academy-id "q-106781" :question/problem "Consider the following polynomials:\n\n$$\n{p}_{1}(t)=2+{t}^{2},\\,{p}_{2}(t)=1-t+2{t}^{2},\\,q(t)=6+2t.\n$$\n\nIf $B={{p}_{1}(t),{p}_{2}(t)}$ is a basis of $\\text{Span}{{p}_{1}(t),{p}_{2}(t)},$ and $[q(t)]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],$ then ${x}_{1}+{x}_{2}=$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{p}_{1}(t)+{x}_{2}{p}_{2}(t)=q(t)\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}(2+{t}^{2})+{x}_{2}(1-t+2{t}^{2}) & =6+2t \\\\ (2{x}_{1}+{x}_{2})-{x}_{2}t+({x}_{1}+2{x}_{2}){t}^{2} & =6+2t.\\end{aligned}\n$$\n\nEquating the coefficients of $t$, we obtain\n\n$$\n{\\begin{aligned}2{x}_{1}+{x}_{2}=6 \\\\ -{x}_{2}=2 \\\\ {x}_{1}+2{x}_{2}=0.\\end{aligned}\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=[\\begin{aligned}2 & 1 & 6 \\\\ 0 & -1 & 2 \\\\ 1 & 2 & 0\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}2 & 1 & 6 \\\\ 0 & -1 & 2 \\\\ 1 & 2 & 0\\end{aligned}] &  & \\begin{aligned}{R}_{3}:={R}_{3}+(-\\frac{1}{2}){R}_{1}\\end{aligned} \\\\ ∼ & [\\begin{aligned}2 & 1 & 6 \\\\ 0 & 1 & -2 \\\\ 0 & \\frac{3}{2} & -3\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n{\\begin{aligned}2{x}_{1}+{x}_{2}=6 \\\\ {x}_{2}=-2 \\\\ \\frac{3}{2}{x}_{2}=-3.\\end{aligned}\n$$\n\nFrom the second and third equations we get ${x}_{2}=-2.$  Substituting this into the first equation yields\n\n$$\n2{x}_{1}+(-2)=6\\,⟹\\,{x}_{1}=4.\n$$\n\nTherefore, $[q(t)]_{B}=[\\begin{aligned}4 \\\\ -2\\end{aligned}].$ \n\nFinally, ${x}_{1}+{x}_{2}=4+(-2)=2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-106781/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2d8f8be0-0fe9-5734-87d3-5c432b7f298f"] :knowledge-point/questions ["q-106781"] :db/ensure [:knowledge-point/validate]} {:db/id "q-95031/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "a5f96750-b2db-5034-80a4-9f92c926c377" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-95031/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "42b3f908-dcc2-5231-b3fc-3e645f86168d" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-95031/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "24266f26-8cbd-51f3-98ed-e7061225ccb3" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-95031/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "374d3563-41a5-51c6-93e5-c4d7358a0ec6" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-95031/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "05888a38-fbdc-5671-882f-ffed16f41343" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-95031/selection" :answer-field/id #uuid "3ba7f75f-81d0-5cbb-ba23-0dc7c282f102" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-95031/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-95031/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-95031/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-95031/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-95031/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-95031/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-95031" :question/id #uuid "062748fc-307b-5d8e-a117-e78a8a5bc2f5" :question/math-academy-id "q-95031" :question/problem "Consider the following polynomials:\n\n$$\n{p}_{1}(t)=-{t}^{3}+{t}^{2}+t,\\,{p}_{2}(t)=2{t}^{2}+4,\\,{p}_{3}(t)=3{t}^{3}-{t}^{2}-3t+3,\\,\\,q(t)=-1.\n$$\n\nIf $B={{p}_{1}(t),{p}_{2}(t),{p}_{3}(t)}$ is a basis of $\\text{Span}{{p}_{1}(t),{p}_{2}(t),{p}_{3}(t)},$ and $[q(t)]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}],$ then ${x}_{3}=$" :question/worked-solution "We need to find ${x}_{1},{x}_{2}$ and ${x}_{3}$ such that \n\n$$\n{x}_{1}{p}_{1}(t)+{x}_{2}{p}_{2}(t)+{x}_{3}{p}_{3}(t)=q(t).\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}(-{t}^{3}+{t}^{2}+t)+{x}_{2}(2{t}^{2}+4)+{x}_{3}(3{t}^{3}-{t}^{2}-3t+3) & =-1 \\\\ (-{x}_{1}+3{x}_{3}){t}^{3}+({x}_{1}+2{x}_{2}-{x}_{3}){t}^{2}+({x}_{1}-3{x}_{3})t+(4{x}_{2}+3{x}_{3}) & =-1.\\end{aligned}\n$$\n\nEquating the coefficients of $t$, we obtain\n\n$$\n{\\begin{aligned}-{x}_{1}+3{x}_{3}=0 \\\\ {x}_{1}+2{x}_{2}-{x}_{3}=0 \\\\ {x}_{1}-3{x}_{3}=0 \\\\ 4{x}_{2}+3{x}_{3}=-1.\\end{aligned}\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=[\\begin{aligned}-1 & 0 & 3 & 0 \\\\ 1 & 2 & -1 & 0 \\\\ 1 & 0 & -3 & 0 \\\\ 0 & 4 & 3 & -1\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}-1 & 0 & 3 & 0 \\\\ 1 & 2 & -1 & 0 \\\\ 1 & 0 & -3 & 0 \\\\ 0 & 4 & 3 & -1\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+{R}_{1} \\\\ {R}_{3}:={R}_{3}+{R}_{1}\\end{aligned} \\\\ ∼ & [\\begin{aligned}-1 & 0 & 3 & 0 \\\\ 0 & 2 & 2 & 0 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 4 & 3 & -1\\end{aligned}] &  & \\begin{aligned}{R}_{3}:={R}_{4}+(-2){R}_{2}\\end{aligned} \\\\ ∼ & [\\begin{aligned}-1 & 0 & 3 & 0 \\\\ 0 & 2 & 2 & 0 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & -1 & -1\\end{aligned}] &  & \\begin{aligned}{R}_{3}↔{R}_{4}\\end{aligned} \\\\ ∼ & [\\begin{aligned}-1 & 0 & 3 & 0 \\\\ 0 & 2 & 2 & 0 \\\\ 0 & 0 & -1 & -1 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n{\\begin{aligned}-{x}_{1}+3{x}_{3}=0 \\\\ 2{x}_{2}+2{x}_{3}=0 \\\\ -{x}_{3}=-1.\\end{aligned}\n$$\n\nFrom the third equation, we get ${x}_{3}=1.$ Substituting this into the second equation, we get\n\n$$\n2{x}_{2}+2\\cdot 1=0\\,⟹\\,{x}_{2}=-1.\n$$\n\nNow, substituting the obtained values into the first equation, we get\n\n$$\n-{x}_{1}+3\\cdot 1=0\\,⟹\\,{x}_{1}=3.\n$$\n\nTherefore, $[q(t)]_{B}=[\\begin{aligned}3 \\\\ -1 \\\\ 1\\end{aligned}],$ and therefore ${x}_{3}=1.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-95031/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2d8f8be0-0fe9-5734-87d3-5c432b7f298f"] :knowledge-point/questions ["q-95031"] :db/ensure [:knowledge-point/validate]} {:db/id "q-106835/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "81fad37a-ee5c-5e43-8625-45c1aa60de68" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-106835/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "0e29e7ba-7442-5d81-922e-828ba309aa4a" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-106835/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "a3238e4d-f030-5358-b30c-66daee1c05f9" :answer/type :answer.type/math :answer/value "1" :db/ensure [:an