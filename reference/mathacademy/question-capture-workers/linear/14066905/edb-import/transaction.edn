db/ensure [:answer/validate]} {:db/id "q-94842/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "4af688d0-5940-50fe-98d8-6a8da97c79e6" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-94842/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "e3792050-133b-5950-9239-0589103e2d61" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-94842/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "f20771d3-d836-592c-915b-5fd3f9efe16d" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-94842/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "c9d8ac32-e0c0-5b79-b847-ff0e2c266f85" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-94842/selection" :answer-field/id #uuid "6a972219-0012-59de-85e8-5df60d3b64df" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-94842/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer-field/choices ["q-94842/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-94842/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-94842/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-94842/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-94842/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9"] :db/ensure [:answer-field/validate]} {:db/id "q-94842" :question/id #uuid "59aeb63f-48ff-5d40-a72b-4e3bc7237625" :question/math-academy-id "q-94842" :question/problem "Consider the vector space ${R}_{2}[t]$ of all polynomials in the variable $t$ over $R$ with degrees at most $2.$\n\nWhich of the following statements are true?\n\n- ${t,{t}^{2}}$ is a linearly independent set in ${R}_{2}[t]$\n- ${t}^{2}+1$ can be expressed as a linear combination of ${t,{t}^{2}}$\n- ${t,{t}^{2}}$ is a basis of ${R}_{2}[t]$" :question/worked-solution "Let's examine each of the statements in turn.\n\n- Statement I is true. Indeed, the equation \n\n$$\n{x}_{1}\\cdot t+{x}_{2}\\cdot {t}^{2}=0,\n$$\n\n \nis true if and only if ${x}_{1}={x}_{2}=0.$ So, the set is linearly independent.\n\n- Statement II is false. Notice that all linear combinations of\n\n$$\n{t,{t}^{2}}\n$$\n\nresult in polynomials without the constant term.\n\n- Statement III is false. Indeed, the polynomial ${t}^{2}+1$ can't be written as a linear combination of the set  ${t,{t}^{2}}.$\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-94842/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2588e089-4786-5346-b42d-65c2740ae2ab"] :knowledge-point/questions ["q-94842"] :db/ensure [:knowledge-point/validate]} {:db/id "q-94848/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "521b5b83-98c0-538d-85e2-94c7caac9623" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-94848/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "3e3dac58-10f2-543d-870c-e9b2d1a8d109" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-94848/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "baf901df-6236-5188-8375-b5c72bdd1570" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-94848/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "443a5afd-0ed0-5576-8a2c-121ad59b3774" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-94848/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "879949be-59e2-508f-b0fb-d83ce7f68ccf" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-94848/selection" :answer-field/id #uuid "848fb521-5aa8-5236-b959-8f90bcea7451" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-94848/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer-field/choices ["q-94848/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-94848/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-94848/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-94848/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-94848/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6"] :db/ensure [:answer-field/validate]} {:db/id "q-94848" :question/id #uuid "d3dbd149-5d7e-5b16-9331-ef71db3c04ad" :question/math-academy-id "q-94848" :question/problem "Consider the vector space ${R}_{3}[t]$ of all polynomials in the variable $t$ over $R$ with degrees at most $3.$\n\nWhich of the following statements are true?\n\n- ${1,t,{t}^{2},{t}^{3}}$ is a linearly independent set in ${R}_{3}[t]$\n- ${t}^{3}-3t+8$ can be expressed as a linear combination of ${1,t,{t}^{2},{t}^{3}}$\n- ${1,t,{t}^{2},{t}^{3}}$ is a basis of ${R}_{3}[t]$" :question/worked-solution "Let's examine each of the statements in turn.\n\n- Statement I is true. Indeed, the equation \n\n$$\n{x}_{1}\\cdot 1+{x}_{2}\\cdot t+{x}_{3}\\cdot {t}^{2}+{x}_{4}\\cdot {t}^{3}=0,\n$$\n\n \nis true if and only if ${x}_{1}={x}_{2}={x}_{3}={x}_{4}=0.$ So, the set is linearly independent.\n\n- Statement II is true. Indeed,\n\n$$\n{t}^{3}-3t+8=8\\cdot 1+(-3)\\cdot t+0\\cdot {t}^{2}+1\\cdot {t}^{3}.\n$$\n\n- Statement III is true. Indeed, the set is linearly independent and for any polynomial in ${R}_{3}[t],$ we get \n\n$$\na{t}^{3}+b{t}^{2}+ct+d=d\\cdot 1+c\\cdot t+b\\cdot {t}^{2}+a\\cdot {t}^{3}.\n$$\n\nTherefore, the correct answer is \"I, II, and III.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-94848/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2588e089-4786-5346-b42d-65c2740ae2ab"] :knowledge-point/questions ["q-94848"] :db/ensure [:knowledge-point/validate]} {:db/id "q-94862/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "95adffec-da91-5795-a2e2-5e541d77b805" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-94862/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "80d0cc8f-3100-5cc0-9aeb-a55d7d74a2a2" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-94862/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "a60bc9cb-01dc-5af4-9fc3-6ce29458f538" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-94862/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "f71d541a-664b-542f-bbba-ec31afe4b5ce" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-94862/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "2fd6cb3a-569b-5894-9237-437ef1f0f427" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-94862/selection" :answer-field/id #uuid "aa64e478-8a9e-5952-ae36-9d940db88de4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-94862/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer-field/choices ["q-94862/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-94862/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-94862/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-94862/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-94862/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23"] :db/ensure [:answer-field/validate]} {:db/id "q-94862" :question/id #uuid "ccdb3ffd-4686-5aa2-99e2-6114757497aa" :question/math-academy-id "q-94862" :question/problem "Consider the vector space ${\\text{M}}_{2}(R)$ of all $2\\times 2$ matrices over $R.$\n\nWhich of the following statements are true?\n\n- ${[\\begin{aligned}0 & 0 \\\\ 1 & 0\\end{aligned}],[\\begin{aligned}0 & 0 \\\\ 0 & 2\\end{aligned}]}$ is a linearly independent set in ${\\text{M}}_{2}(R)$\n- $[\\begin{aligned}0 & 0 \\\\ 3 & -2\\end{aligned}]$ can be expressed as a linear combination of ${[\\begin{aligned}0 & 0 \\\\ 1 & 0\\end{aligned}],[\\begin{aligned}0 & 0 \\\\ 0 & 2\\end{aligned}]}$\n- ${[\\begin{aligned}0 & 0 \\\\ 1 & 0\\end{aligned}],[\\begin{aligned}0 & 0 \\\\ 0 & 2\\end{aligned}]}$ is a basis of ${\\text{M}}_{2}(R)$" :question/worked-solution "Let's examine each of the statements in turn.\n\n- Statement I is true. Indeed, the equation\n\n$$\n{x}_{1}\\cdot [\\begin{aligned}0 & 0 \\\\ 1 & 0\\end{aligned}]+{x}_{2}\\cdot [\\begin{aligned}0 & 0 \\\\ 0 & 2\\end{aligned}]=[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]\n$$\n\nis true if and only if ${x}_{1}={x}_{2}=0.$ So, the set is linearly independent.\n\n- Statement II is true. Indeed,\n\n$$\n[\\begin{aligned}0 & 0 \\\\ 3 & -2\\end{aligned}]=3\\cdot [\\begin{aligned}0 & 0 \\\\ 1 & 0\\end{aligned}]+(-1)\\cdot [\\begin{aligned}0 & 0 \\\\ 0 & 2\\end{aligned}].\n$$\n\n- Statement III is false. For example, the matrix $[\\begin{aligned}1 & 0 \\\\ 4 & -1\\end{aligned}]$ can't be written as a linear combination of \n\n$$\n{[\\begin{aligned}0 & 0 \\\\ 1 & 0\\end{aligned}],[\\begin{aligned}0 & 0 \\\\ 0 & 2\\end{aligned}]}\n$$\n\nsince all these linear combinations result in matrices with the entry ${a}_{11}=0:$\n\n$$\na\\cdot [\\begin{aligned}0 & 0 \\\\ 1 & 0\\end{aligned}]+b\\cdot [\\begin{aligned}0 & 0 \\\\ 0 & 2\\end{aligned}]=[\\begin{aligned}0 & 0 \\\\ a & 2b\\end{aligned}]\n$$\n\nTherefore, the correct answer is \"I and II only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-94862/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "073042ee-d96d-5872-9681-ddcea43a2d37"] :knowledge-point/questions ["q-94862"] :db/ensure [:knowledge-point/validate]} {:db/id "q-94859/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "b40878ec-07a6-5118-a845-b10467e1c4c9" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-94859/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "783582a2-287f-55ee-81b7-12b9f824b173" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-94859/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "5abda7e6-4767-5499-bcac-706b22b4fd46" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-94859/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "b5bb8575-e3b0-5eda-83fb-2d5d018bb83b" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-94859/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "cdda9fdd-8d47-5722-8b0d-bb7a6750e2bc" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-94859/selection" :answer-field/id #uuid "ef424bbb-01f9-5c32-8735-cf9974d2e079" :answer-fiel