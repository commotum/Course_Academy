on/validate]} {:db/id [:knowledge-point/id #uuid "434a82c2-7964-525a-85b9-eb17fa7b5b26"] :knowledge-point/questions ["q-40372"] :db/ensure [:knowledge-point/validate]} {:db/id "q-38454/selection/6902f5e0173f210b7cbbffd5ddd76a34a283b9f1218dbf0f5651bf50bcebf0ba" :answer/id #uuid "1f8ffc8f-6d2f-556f-989c-57025b795c68" :answer/type :answer.type/math :answer/value "[\\begin{aligned}23 & -26 \\\\ 3 & -4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-38454/selection/bc09eefcd32bbe1fe9a08ac4c7c0cfb9a8cea632badc0487e4b5dcee80661357" :answer/id #uuid "698dc4f6-5811-57e2-99fc-87982411ed0b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-7 & 16 \\\\ -2 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-38454/selection/c9eacb1404e9793543b8a09eb001228911b8c427e55f02823b67ace22deda0e2" :answer/id #uuid "dbe1e884-5434-5c6b-a68e-7921d04d60df" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-9 & -16 \\\\ -1 & -4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-38454/selection/1912470a739aa5e742879dc5f735d78561d85a08389b9ee607e42fa9b7710148" :answer/id #uuid "c8f30951-884b-5209-af41-72d6a477aaf6" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-7 & -26 \\\\ -1 & -5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-38454/selection/44cdc57ec577ff5a9822ccbdcaf56f6a75867201ebaa1af3728ee77bcabcf78d" :answer/id #uuid "5b017ce2-7ac6-5e80-86b1-78a21842ef15" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-7 & 34 \\\\ -1 & 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-38454/selection" :answer-field/id #uuid "cf4ebcdc-cfc0-5eba-8251-897b1c25545a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-38454/selection/44cdc57ec577ff5a9822ccbdcaf56f6a75867201ebaa1af3728ee77bcabcf78d" :answer-field/choices ["q-38454/selection/6902f5e0173f210b7cbbffd5ddd76a34a283b9f1218dbf0f5651bf50bcebf0ba" "q-38454/selection/bc09eefcd32bbe1fe9a08ac4c7c0cfb9a8cea632badc0487e4b5dcee80661357" "q-38454/selection/c9eacb1404e9793543b8a09eb001228911b8c427e55f02823b67ace22deda0e2" "q-38454/selection/1912470a739aa5e742879dc5f735d78561d85a08389b9ee607e42fa9b7710148" "q-38454/selection/44cdc57ec577ff5a9822ccbdcaf56f6a75867201ebaa1af3728ee77bcabcf78d"] :db/ensure [:answer-field/validate]} {:db/id "q-38454" :question/id #uuid "8c205c90-4798-5e63-8aaa-99473a11c651" :question/math-academy-id "q-38454" :question/problem "$$\n[T]_{C}=[\\begin{aligned}1 & 2 \\\\ -1 & -3\\end{aligned}],\\,{P}_{C\\to B}=[\\begin{aligned}5 & 6 \\\\ 1 & 1\\end{aligned}]\n$$\n\nConsider the matrix $[T]_{C}$ of a linear transformation $T$ with respect to the basis $C$ and the change-of-coordinates matrix ${P}_{C\\to B}$ shown above. Find the matrix of $T$ relative to the basis $B.$" :question/worked-solution "The connection between the matrices of our linear transformation $T$ relative to the bases $B$ and $C$ is given by the following diagram:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14067267/assets/2e82c232614bec8a98f079ea56d7913ee13e7b457e33e418198278d2e369fc5c.png)\n\nHere, moving along an arrow means pre-multiplying by the corresponding matrix. Algebraically, we can write this as\n\n$$\n[T]_{C}={P}_{C\\to B}^{-1}\\cdot [T]_{B}\\cdot {P}_{C\\to B}.\n$$\n\nwhere ${P}_{C\\to B}$ is the change-of-coordinates matrix from $C$ to $B.$\n\nOur goal is to compute $[T]_{B}.$ Solving this equation for $[T]_{B},$ we obtain the alternative formulation\n\n$$\n[T]_{B}={P}_{C\\to B}\\cdot [T]_{C}\\cdot {P}_{C\\to B}^{-1}.\n$$\n\nFirst, we compute the inverse of ${P}_{C\\to B}:$\n\n$$\n\\begin{aligned}{P}_{C\\to B}^{-1} & ={[\\begin{aligned}5 & 6 \\\\ 1 & 1\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{1\\cdot 5-1\\cdot 6}[\\begin{aligned}1 & -6 \\\\ -1 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 6 \\\\ 1 & -5\\end{aligned}]\\end{aligned}\n$$\n\nNow, we can compute the matrix of $T$ relative to the basis $B:$\n\n$$\n\\begin{aligned}[T]_{B} & ={P}_{C\\to B}\\cdot [T]_{C}\\cdot {P}_{C\\to B}^{-1} \\\\  & =[\\begin{aligned}5 & 6 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}1 & 2 \\\\ -1 & -3\\end{aligned}][\\begin{aligned}-1 & 6 \\\\ 1 & -5\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & -8 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}-1 & 6 \\\\ 1 & -5\\end{aligned}] \\\\  & =[\\begin{aligned}-7 & 34 \\\\ -1 & 5\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-38454/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "61bd0b4f-165c-5f31-b4ec-e0eff7e758e1"] :knowledge-point/questions ["q-38454"] :db/ensure [:knowledge-point/validate]} {:db/id "q-97114/selection/47b445ebb6a11e9bb023e54df3ff66b08c49955d77e41c645e23039afa9ac9d1" :answer/id #uuid "a22fac5f-c21a-5af7-a68b-eda1d1b29b11" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 & -4 \\\\ 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-97114/selection/8711afb81652181945dc11b1e4cc01c42a83108d7e9094a139451ef53a40a748" :answer/id #uuid "241eda8e-332a-52be-9d61-3214d30067a4" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-6 & 8 \\\\ -8 & 11\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-97114/selection/a6f6822b5848f624bf47560b5f1bb827915f22701202d773478ac0d98ea7b74b" :answer/id #uuid "7f6f0664-3583-5dfb-b141-0b5ee013bbe8" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-6 & -8 \\\\ -4 & -5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-97114/selection/295cf77f7921821a185d03dbe097f6c2adaf573123b6e40e87482f31c4920f70" :answer/id #uuid "da1b8239-8d13-503d-b523-fb390ee7963d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-6 & -16 \\\\ 4 & 11\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-97114/selection/e282033b4d3afc0d071901a9f14fcda9e30911d959afc524add84b33a641f0d2" :answer/id #uuid "f3921790-347c-5828-bd1e-5177a0c77fa2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}14 & -20 \\\\ -12 & 17\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-97114/selection" :answer-field/id #uuid "e102fefd-564f-5a23-acf2-838a3f60a4a2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-97114/selection/8711afb81652181945dc11b1e4cc01c42a83108d7e9094a139451ef53a40a748" :answer-field/choices ["q-97114/selection/47b445ebb6a11e9bb023e54df3ff66b08c49955d77e41c645e23039afa9ac9d1" "q-97114/selection/8711afb81652181945dc11b1e4cc01c42a83108d7e9094a139451ef53a40a748" "q-97114/selection/a6f6822b5848f624bf47560b5f1bb827915f22701202d773478ac0d98ea7b74b" "q-97114/selection/295cf77f7921821a185d03dbe097f6c2adaf573123b6e40e87482f31c4920f70" "q-97114/selection/e282033b4d3afc0d071901a9f14fcda9e30911d959afc524add84b33a641f0d2"] :db/ensure [:answer-field/validate]} {:db/id "q-97114" :question/id #uuid "c8232ae8-3dbc-5fa7-a890-a6276b10aff3" :question/math-academy-id "q-97114" :question/problem "$$\n[T]_{C}=[\\begin{aligned}2 & -4 \\\\ -2 & 3\\end{aligned}],\\,{P}_{C\\to B}=[\\begin{aligned}3 & 4 \\\\ 2 & 3\\end{aligned}]\n$$\n\nConsider the matrix $[T]_{C}$ of a linear transformation $T$ with respect to the basis $C$ and the change-of-coordinates matrix ${P}_{C\\to B}$ shown above. Find the matrix of $T$ relative to the basis $B.$" :question/worked-solution "The connection between the matrices of our linear transformation $T$ relative to the bases $B$ and $C$ is given by the following diagram:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14067267/assets/2e82c232614bec8a98f079ea56d7913ee13e7b457e33e418198278d2e369fc5c.png)\n\nHere, moving along an arrow means pre-multiplying by the corresponding matrix. Algebraically, we can write this as\n\n$$\n[T]_{C}={P}_{C\\to B}^{-1}\\cdot [T]_{B}\\cdot {P}_{C\\to B}.\n$$\n\nwhere ${P}_{C\\to B}$ is the change-of-coordinates matrix from $C$ to $B.$\n\nOur goal is to compute $[T]_{B}.$ Solving this equation for $[T]_{B},$ we obtain the alternative formulation\n\n$$\n[T]_{B}={P}_{C\\to B}\\cdot [T]_{C}\\cdot {P}_{C\\to B}^{-1}.\n$$\n\nFirst, we compute the inverse of ${P}_{C\\to B}:$\n\n$$\n\\begin{aligned}{P}_{C\\to B}^{-1} & ={[\\begin{aligned}3 & 4 \\\\ 2 & 3\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{3\\cdot 3-2\\cdot 4}[\\begin{aligned}3 & -4 \\\\ -2 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}3 & -4 \\\\ -2 & 3\\end{aligned}]\\end{aligned}\n$$\n\nNow, we can compute the matrix of $T$ relative to the basis $C:$\n\n$$\n\\begin{aligned}[T]_{B} & ={P}_{C\\to B}\\cdot [T]_{C}\\cdot {P}_{C\\to B}^{-1} \\\\  & =[\\begin{aligned}3 & 4 \\\\ 2 & 3\\end{aligned}][\\begin{aligned}2 & -4 \\\\ -2 & 3\\end{aligned}][\\begin{aligned}3 & -4 \\\\ -2 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 0 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}3 & -4 \\\\ -2 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}-6 & 8 \\\\ -8 & 11\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-97114/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "61bd0b4f-165c-5f31-b4ec-e0eff7e758e1"] :knowledge-point/questions ["q-97114"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-38356"] :question/problem "$$\n[T]_{B}=[\\begin{aligned}-5 & 6 \\\\ -3 & 4\\end{aligned}],\\,{P}_{B\\to C}=[\\begin{aligned}-1 & 2 \\\\ 1 & -1\\end{aligned}]\n$$\n\nConsider the matrix $[T]_{B}$ of a linear transformation $T$ with respect to the basis $B$ and the change-of-coordinates matrix ${P}_{B\\to C}$ shown above. Find the matrix of $T$ relative to the basis $C.$" :question/worked-solution "The connection between the matrices of our linear transformation $T$ relative to the bases $B$ and $C$ is given by the following diagram:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14067267/assets/1b81504d6fdcabee0e1f586fef3dd2af5a57a8411ba4d22429e00e09b171a4d1.png)\n\n \n\nHere, moving along an arrow means pre-multiplying by the corresponding matrix. Algebraically, we can write this as\n\n$$\n[T]_{C}={P}_{B\\to C}\\cdot [T]_{B}\\cdot {P}_{B\\to C}^{-1}\\,,\n$$\n\nwhere ${P}_{B\\to C}$ is the change-of-coordinates matrix from $B$ to $C.$\n\nOur goal is to compute $[T]_{C}.$ First, we compute the inverse of ${P}_{B\\to C}:$\n\n$$\n\\begin{aligned}{P}_{B\\to C}^{-1} & ={[\\begin{aligned}-1 & 2 \\\\ 1 & -1\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{(-1)\\cdot (-1)-2\\cdot 1}[\\begin{aligned}-1 & -2 \\\\ -1 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 \\\\ 1 & 1\\end{aligned}]\\end{aligned}\n$$\n\nNow, we can compute the matrix of $T$ relative to the basis $C:$\n\n$$\n\\begin{aligned}[T]_{C} & ={P}_{B\\to C}\\cdot [T]_{B}\\cdot {P}_{B\\to C}^{-1} \\\\  & =[\\begin{aligned}-1 & 2 \\\\ 1 & -1\\end{aligned}][\\begin{aligned}-5 & 6 \\\\ -3 & 4\\end{aligned}][\\begin{aligned}1 & 2 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 2 \\\\ -2 & 2\\end{aligned}][\\begin{aligned}1 & 2 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & -2\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-140454/selection/6049a620a38236403df5d670ad016ac24d85a49fdd454987b0db842f9dc827d4" :answer/id #uuid "84c10c33-8477-5173-af44-665c312feb37" :answer/type :answer.type/math :answer/value "[\\begin{aligned}20 & 36 \\\\ -25 & 14\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-140454/selection/984684f973ed98f7384711cb7f161f87bd157e949d3eafacab533f7a8e902f49" :answer/id #uuid "240c3118-37e8-51f6-a5ff-f32c209338e8" :answer/type :answer.type/math :answer/value "[\\begin{aligned}14 & -36 \\\\ 20 & -25\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-140454/selection/7a8b2e00e89d36b1822171344492d0788ce97c9047e9399d0d3f989f4228009d" :answer/id #uuid "ab2f9795-931f-5650-98c4-5c77aa13a6fe" :answer/type :answer.type/math :answer/value "[\\begin{alig