83a100e" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-78557" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "9"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/state.json" "file_sha256" "125b930adbc81933b58b38886760ab94b8bf8fd24cd18ba2b9bce5c1c83a100e" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-78557" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "8"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/state.json" "file_sha256" "125b930adbc81933b58b38886760ab94b8bf8fd24cd18ba2b9bce5c1c83a100e" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-275787" "field" nil "attribute" "question/problem" "value" "Consider the following system of linear equations:\n\n$$\n{\\begin{aligned}x+z=4x+y+2 \\\\ x+y=2z+2 \\\\ y=x-y+z+1\\end{aligned}\n$$\n\nFind the solution $x=[x,y,z]^{T}$ of the system by computing the inverse of the coefficient matrix.\n\n|  |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n| $x=\\,\\,$ |  | {{field-2}} |  |\n|  |  | {{field-3}} |  |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/state.json" "file_sha256" "125b930adbc81933b58b38886760ab94b8bf8fd24cd18ba2b9bce5c1c83a100e" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-275787" "field" nil "attribute" "question/worked-solution" "value" "First, let's rewrite the system in the correct order:\n\n$$\n{\\begin{aligned}-3x-y+z=2 \\\\ x+y-2z=2 \\\\ -x+2y-z=1\\end{aligned}\n$$\n\nNext, we  write the system in the form $Ax=b$, where $A$ is a $3\\times 3$ matrix and $x$ and $b$ are $3\\times 1$ column vectors. We can do this as follows:\n\n$$\n[\\begin{aligned}-3 & -1 & 1 \\\\ 1 & 1 & -2 \\\\ -1 & 2 & -1\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}2 \\\\ 2 \\\\ 1\\end{aligned}].\n$$\n\nNow, the solution to $Ax=b$ is given by $x={A}^{-1}b.$ So, we compute ${A}^{-1}$ as follows:\n\n*Step 1:*\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}-3 & -1 & 1 \\\\ 1 & 1 & -2 \\\\ -1 & 2 & -1\\end{aligned}| \\\\  & =-3|\\begin{aligned}1 & -2 \\\\ 2 & -1\\end{aligned}|-(-1)|\\begin{aligned}1 & -2 \\\\ -1 & -1\\end{aligned}|+1|\\begin{aligned}1 & 1 \\\\ -1 & 2\\end{aligned}| \\\\  & =-3(-1+4)+(-1-2)+(2+1) \\\\  & =-9-3+3 \\\\  & =-9.\\end{aligned}\n$$\n\n*Step 2:*\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}|\\begin{aligned}1 & -2 \\\\ 2 & -1\\end{aligned}| & |\\begin{aligned}1 & -2 \\\\ -1 & -1\\end{aligned}| & |\\begin{aligned}1 & 1 \\\\ -1 & 2\\end{aligned}| \\\\ |\\begin{aligned}-1 & 1 \\\\ 2 & -1\\end{aligned}| & |\\begin{aligned}-3 & 1 \\\\ -1 & -1\\end{aligned}| & |\\begin{aligned}-3 & -1 \\\\ -1 & 2\\end{aligned}| \\\\ |\\begin{aligned}-1 & 1 \\\\ 1 & -2\\end{aligned}| & |\\begin{aligned}-3 & 1 \\\\ 1 & -2\\end{aligned}| & |\\begin{aligned}-3 & -1 \\\\ 1 & 1\\end{aligned}|\\end{aligned}] \\\\  & =[\\begin{aligned}3 & -3 & 3 \\\\ -1 & 4 & -7 \\\\ 1 & 5 & -2\\end{aligned}].\\end{aligned}\n$$\n\n*Step 3:*\n\n$$\nC=[\\begin{aligned}3 & 3 & 3 \\\\ 1 & 4 & 7 \\\\ 1 & -5 & -2\\end{aligned}].\n$$\n\n*Step 4:*\n\n$$\n{C}^{T}=[\\begin{aligned}3 & 1 & 1 \\\\ 3 & 4 & -5 \\\\ 3 & 7 & -2\\end{aligned}].\n$$\n\n*Step 5:*\n\n$$\n{A}^{-1}=\\frac{1}{det(A)}{C}^{T}=-\\frac{1}{9}[\\begin{aligned}3 & 1 & 1 \\\\ 3 & 4 & -5 \\\\ 3 & 7 & -2\\end{aligned}].\n$$\n\nFinally, the solution to the given system is\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{9}[\\begin{aligned}3 & 1 & 1 \\\\ 3 & 4 & -5 \\\\ 3 & 7 & -2\\end{aligned}][\\begin{aligned}2 \\\\ 2 \\\\ 1\\end{aligned}] \\\\  & =-\\frac{1}{9}[\\begin{aligned}9 \\\\ 9 \\\\ 18\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ -1 \\\\ -2\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/state.json" "file_sha256" "125b930adbc81933b58b38886760ab94b8bf8fd24cd18ba2b9bce5c1c83a100e" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-275787" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/activity-metadata.json" "file_sha256" "a25c47371cb5ede8ec6ee3fdcdcd7c8a35474135dbd8aff72edb68649a8c7c23" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-275787" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/state.json" "file_sha256" "125b930adbc81933b58b38886760ab94b8bf8fd24cd18ba2b9bce5c1c83a100e" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-275787" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/state.json" "file_sha256" "125b930adbc81933b58b38886760ab94b8bf8fd24cd18ba2b9bce5c1c83a100e" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-275787" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/state.json" "file_sha256" "125b930adbc81933b58b38886760ab94b8bf8fd24cd18ba2b9bce5c1c83a100e" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-78442" "field" nil "attribute" "question/problem" "value" "Consider a system of $3$ linear equations in $3$ variables, written in matrix form as $D\\,y=w.$ Here, $D$ is the non-singular coefficient matrix of the system, $y$ is the column vector containing the variables, and $w$ is the column vector containing the constants. The unique solution of the system can be found using the method shown below:\n\n$$\n\\begin{aligned}D\\,y & =w \\\\ {D}^{-1}D\\,y & =w \\\\ {I}_{3}\\,y & ={D}^{-1}\\,w \\\\  & ={D}^{-1}\\,w\\end{aligned}\n$$\n\nFrom top to bottom and left to right, what are the missing parts of the derivation?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/state.json" "file_sha256" "125b930adbc81933b58b38886760ab94b8bf8fd24cd18ba2b9bce5c1c83a100e" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-78442" "field" nil "attribute" "question/worked-solution" "value" "Since $D$ is not singular, it must have an inverse ${D}^{-1}.$ Now, pre-multiplying both sides of the equation $D\\,y=w$ by ${D}^{-1},$ we obtain the following:\n\n$$\n\\begin{aligned}D\\,y & =w \\\\ {D}^{-1}D\\,y & ={D}^{-1}w \\\\ {I}_{3}\\,y & ={D}^{-1}\\,w \\\\ y & ={D}^{-1}\\,w\\end{aligned}\n$$\n\nTherefore, the missing parts are ${D}^{-1}$ and $y.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/state.json" "file_sha256" "125b930adbc81933b58b38886760ab94b8bf8fd24cd18ba2b9bce5c1c83a100e" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-78442" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/activity-metadata.json" "file_sha256" "a25c47371cb5ede8ec6ee3fdcdcd7c8a35474135dbd8aff72edb68649a8c7c23" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-78442" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/state.json" "file_sha256" "125b930adbc81933b58b38886760ab94b8bf8fd24cd18ba2b9bce5c1c83a100e" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-78442" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "$y$ and $D$"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/state.json" "file_sha256" "125b930adbc81933b58b38886760ab94b8bf8fd24cd18ba2b9bce5c1c83a100e" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-78561" "field" nil "attribute" "question/problem" "value" "Consider a system of $n$ linear equations in $n$ variables, written in matrix form as $D\\,t=q.$ Here, $D$ is the non-singular coefficient matrix of the system, $t$ is the column vector containing the variables, and $q$ is the column vector containing the constants. The unique solution of the system can be found using the method shown below:\n\n$$\n\\begin{aligned}D\\,t & =q \\\\ D\\,t & ={D}^{-1}\\,q \\\\ {I}_{n}\\,t & ={D}^{-1}\\, \\\\ t & ={D}^{-1}\\,q\\end{aligned}\n$$\n\nFrom top to bottom and left to right, what are the missing parts of the derivation?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/state.json" "file_sha256" "125b930adbc81933b58b38886760ab94b8bf8fd24cd18ba2b9bce5c1c83a100e" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-78561" "field" nil "attribute" "question/worked-solution" "value" "Since $D$ is not singular, it must have an inverse ${D}^{-1}.$ Now, pre-multiplying both sides of the equation $D\\,t=q$ by ${D}^{-1},$ we obtain the following:\n\n$$\n\\begin{aligned}D\\,t & =q \\\\ {D}^{-1}D\\,t & ={D}^{-1}\\,q \\\\ {I}_{n}\\,t & ={D}^{-1}\\,q \\\\ t & ={D}^{-1}\\,q\\end{aligned}\n$$\n\nTherefore, the missing parts are ${D}^{-1}$ and $q.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/state.json" "file_sha256" "125b930adbc81933b58b38886760ab94b8bf8fd24cd18ba2b9bce5c1c83a100e" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-78561" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/activity-metadata.json" "file_sha256" "a25c47371cb5ede8ec6ee3fdcdcd7c8a35474135dbd8aff72edb68649a8c7c23" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-78561" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/state.json" "file_sha256" "125b930adbc81933b58b38886760ab94b8bf8fd24cd18ba2b9bce5c1c83a100e" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-78561" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "$D$ and $q$"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/state.json" "file_sha256" "125b930adbc81933b58b38886760ab94b8bf8fd24cd18ba2b9bce5c1c83a100e" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-78561" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "$D$ and ${I}_{n}$"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/state.json" "file_sha256" "125b930adbc81933b58b38886760ab94b8bf8fd24cd18ba2b9bce5c1c83a100e" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-78561" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "${D}^{-1}$ and $D$"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/state.json" "file_sha256" "125b930adbc81933b58b38886760ab94b8bf8fd24cd18ba2b9bce5c1c83a100e" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-78561" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "${D}^{-1}$ and $q$"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/state.json" "file_sha256" "125b930adbc81933b58b38886760ab94b8bf8fd24cd18ba2b9bce5c1c83a100e" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-78561" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "${D}^{-1}$ and $t$"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/state.json" "file_sha256" "125b930adbc81933b58b38886760ab94b8bf8fd24cd18ba2b9bce5c1c83a100e" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-78571" "field" nil "attribute" "question/problem" "value" "Consider a matrix equation $A\\,x={B}^{-1}\\,d,$ where $A$ and $B$ are $2\\times 2$ non-singular matrices, while $x$ and $d$ are $2\\times 1$ column vectors. Solve the equation for $x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/state.json" "file_sha256" "125b930adbc81933b58b38886760ab94b8bf8fd24cd18ba2b9bce5c1c83a100e" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-78571" "field" nil "attribute" "question/worked-solution" "value" "Since $A$ is not singular, it must have an inverse ${A}^{-1}.$ Now, pre-multiplying both sides of the equation $A\\,x={B}^{-1}\\,d$ by ${A}^{-1},$ we obtain\n\n$$\n\\begin{aligned}A\\,x & ={B}^{-1}\\,d \\\\ {A}^{-1}A\\,x & ={A}^{-1}{B}^{-1}\\,d \\\\ {I}_{2}\\,x & ={A}^{-1}{B}^{-1}\\,d \\\\ x & ={A}^{-1}{B}^{-1}\\,d.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/state.json" "file_sha256" "125b930adbc81933b58b38886760ab94b8bf8fd24cd18ba2b9bce5c1c83a100e" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-78571" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/activity-metadata.json" "file_sha256" "a25c47371cb5ede8ec6ee3fdcdcd7c8a35474135dbd8aff72edb68649a8c7c23" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-78571" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/state.json" "file_sha256" "125b930adbc81933b58b38886760ab94b8bf8fd24cd18ba2b9bce5c1c83a100e" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-78571" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "x=A{B}^{-1}\\,d"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/state.json" "file_sha256" "125b930adbc81933b58b38886760ab94b8bf8fd24cd18ba2b9bce5c1c83a100e" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-78571" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "x={A}^{-1}{B}^{-1}\\,d"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/state.json" "file_sha256" "125b930adbc81933b58b38886760ab94b8bf8fd24cd18ba2b9bce5c1c83a100e" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-78571" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "x={B}^{-1}\\,d\\,A"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/state.json" "file_sha256" "125b930adbc81933b58b38886760ab94b8bf8fd24cd18ba2b9bce5c1c83a100e" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-78571" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "x={B}^{-1}\\,d\\,{A}^{-1}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/state.json" "file_sha256" "125b930adbc81933b58b38886760ab94b8bf8fd24cd18ba2b9bce5c1c83a100e" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-78571" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "x={B}^{-1}{A}^{-1}\\,d"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/state.json" "file_sha256" "125b930adbc81933b58b38886760ab94b8bf8fd24cd18ba2b9bce5c1c83a100e" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-78571" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "x={A}^{-1}{B}^{-1}\\,d"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/state.json" "file_sha256" "125b930adbc81933b58b38886760ab94b8bf8fd24cd18ba2b9bce5c1c83a100e" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "e-4520" "field" nil "attribute" "question/problem" "value" "Consider the following system of linear equations:\n\n$$\n{\\begin{aligned}-2x+5y-2z=-2 \\\\ -3y+z=-2 \\\\ 3x-7y+3z=3\\end{aligned}\n$$\n\nThe system above has the matrix representation $A \\mathbf{x} = \\mathbf{b}.$ Given that $\\mathbf x = \\langle x,y,z\\rangle$ is unique, what is the value of $x+y+z?$ \n\n*Hint: The inverse of the coefficient matrix is given by*\n\n$$\n[\\begin{aligned}-2 & -1 & -1 \\\\ 3 & 0 & 2 \\\\ 9 & 1 & 6\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/example-4520.json" "file_sha256" "4b964b7c03e97a8bf8af4cc8d124ec6130966bfd79fd36f3bd67246aa35667f2" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "e-4520" "field" nil "attribute" "question/worked-solution" "value" "First, let's write our system in matrix form as follows:\n\n$$\n\\begin{aligned}Ax & =b \\\\ [\\begin{aligned}-2 & 5 & -2 \\\\ 0 & -3 & 1 \\\\ 3 & -7 & 3\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-2 \\\\ -2 \\\\ 3\\end{aligned}]\\end{aligned}\n$$\n\nRecall that the solution to $A\\mathbf{x}=\\mathbf{b}$ is given by $\\mathbf{x}= A^{-1}\\mathbf{b}.$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =[\\begin{aligned}-2 & -1 & -1 \\\\ 3 & 0 & 2 \\\\ 9 & 1 & 6\\end{aligned}][\\begin{aligned}-2 \\\\ -2 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}3 \\\\ 0 \\\\ -2\\end{aligned}].\\end{aligned}\n$$\n\nSo, the solution is $x=3, y=0, z=-2.$\n\nFinally, $x+y+z=3+0+(-2)=1.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/example-4520.json" "file_sha256" "4b964b7c03e97a8bf8af4cc8d124ec6130966bfd79fd36f3bd67246aa35667f2" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "e-4521" "field" nil "attribute" "question/problem" "value" "Solve the following system of linear equations using matrices:\n\n$$\n\\begin{aligned}{\\begin{aligned}3y+x+z=0 \\\\ z+4y-5=2 \\\\ 1+2x-y=-3\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/example-4521.json" "file_sha256" "be553980ec8cec33fd10c27c0e9f4cf2ef8fc4ab564cbe596ba93edddc265b14" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "e-4521" "field" nil "attribute" "question/worked-solution" "value" "First, we organize the system so that the variables are in the correct order and every variable has a coefficient:\n\n$$\n\\begin{aligned}{\\begin{aligned}x+3y+z=0 \\\\ 0x+4y+z=7 \\\\ 2x-y+0z=-4\\end{aligned}\\end{aligned}\n$$\n\nNext, we  write the system in the form $A\\mathbf{x} = \\mathbf{b}$, where $A$ is a $3\\times 3$ matrix and $\\mathbf{x}$ and $\\mathbf{b}$ are $3\\times 1$ column vectors. We can do this as follows:\n\n$$\n[\\begin{aligned}1 & 3 & 1 \\\\ 0 & 4 & 1 \\\\ 2 & -1 & 0\\end{aligned}]\n$$\n\nNow, the solution to $A\\mathbf{x}=\\mathbf{b}$ is given by $\\mathbf{x}= A^{-1}\\mathbf{b}.$ So, we compute $A^{-1}$ as follows:\n\n*Step 1*: Find the determinant of $A.$\n\n$$\n\\begin{aligned}det(A)=|\\begin{aligned}1 & 3 & 1 \\\\ 0 & 4 & 1 \\\\ 2 & -1 & 0\\end{aligned}| & =1|\\begin{aligned}4 & 1 \\\\ -1 & 0\\end{aligned}|-3|\\begin{aligned}0 & 1 \\\\ 2 & 0\\end{aligned}|+1|\\begin{aligned}0 & 4 \\\\ 2 & -1\\end{aligned}| \\\\  & =(1)-3(-2)+(-8) \\\\  & =1+6-8 \\\\  & =-1\\end{aligned}\n$$\n\n*Step 2*: Compute the matrix of minors.\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}|\\begin{aligned}4 & 1 \\\\ -1 & 0\\end{aligned}| & |\\begin{aligned}0 & 1 \\\\ 2 & 0\\end{aligned}| & |\\begin{aligned}0 & 4 \\\\ 2 & -1\\end{aligned}| \\\\ |\\begin{aligned}3 & 1 \\\\ -1 & 0\\end{aligned}| & |\\begin{aligned}1 & 1 \\\\ 2 & 0\\end{aligned}| & |\\begin{aligned}1 & 3 \\\\ 2 & -1\\end{aligned}| \\\\ |\\begin{aligned}3 & 1 \\\\ 4 & 1\\end{aligned}| & |\\begin{aligned}1 & 1 \\\\ 0 & 1\\end{aligned}| & |\\begin{aligned}1 & 3 \\\\ 0 & 4\\end{aligned}|\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -2 & -8 \\\\ 1 & -2 & -7 \\\\ -1 & 1 & 4\\end{aligned}]\\end{aligned}\n$$\n\n*Step 3*:  Find the matrix of cofactors.\n\n$$\n[\\begin{aligned}1 & 2 & -8 \\\\ -1 & -2 & 7 \\\\ -1 & -1 & 4\\end{aligned}]\n$$\n\n*Step 4*: Transpose the matrix of cofactors.\n\n$$\n[\\begin{aligned}1 & -1 & -1 \\\\ 2 & -2 & -1 \\\\ -8 & 7 & 4\\end{aligned}]\n$$\n\n*Step 5*: Apply the inverse matrix formula.\n\n$$\n[\\begin{aligned}1 & -1 & -1 \\\\ 2 & -2 & -1 \\\\ -8 & 7 & 4\\end{aligned}]\n$$\n\nFinally, we can calculate the solution as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =[\\begin{aligned}-1 & 1 & 1 \\\\ -2 & 2 & 1 \\\\ 8 & -7 & -4\\end{aligned}][\\begin{aligned}0 \\\\ 7 \\\\ -4\\end{aligned}] \\\\  & =[\\begin{aligned}3 \\\\ 10 \\\\ -33\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the solution is $x=3,$ $y=10,$ $z=-33.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/example-4521.json" "file_sha256" "be553980ec8cec33fd10c27c0e9f4cf2ef8fc4ab564cbe596ba93edddc265b14" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "e-4604" "field" nil "attribute" "question/problem" "value" "Consider a matrix equation $B\\,\\mathbf{x} = A^{-1}\\,\\mathbf{d},$ where $A$ and $B$ are $10 \\times 10$ non-singular matrices, while $\\mathbf{x}$ and $\\mathbf{d}$ are $10 \\times 1$ column vectors. Solve the equation for $\\mathbf{x}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/example-4604.json" "file_sha256" "7f11d799b12cb75f7411868211e4d49d5dbc09e704590655d9074f0567510cf7" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "e-4604" "field" nil "attribute" "question/worked-solution" "value" "Since $B$ is not singular, it must have an inverse $B^{−1}.$ Now, pre-multiplying both sides of the equation $B\\,\\mathbf{x} = A^{-1}\\,\\mathbf{d}$ by $B^{-1},$ we obtain\n\n$$\n\\begin{aligned}B\\,x & ={A}^{-1}\\,d \\\\ {B}^{-1}B\\,x & ={B}^{-1}{A}^{-1}\\,d \\\\ {I}_{10}\\,x & ={B}^{-1}{A}^{-1}\\,d \\\\ x & ={B}^{-1}{A}^{-1}\\,d.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/example-4604.json" "file_sha256" "7f11d799b12cb75f7411868211e4d49d5dbc09e704590655d9074f0567510cf7" "basis" 1065 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995994/edb-import/verification.json"} {"question" "q-10074" "field" nil "attribute" "question/problem" "value" "Solve the following system of linear equations by finding the inverse of the coefficient matrix:\n\n$$\n\\begin{aligned}{\\begin{aligned}2y+3z=-1-x \\\\ 4y=-5z \\\\ x+6z-3=0\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14006196/state.json" "file_sha256" "fbc7043ca09de6693709e6fc649ea429407de8bcb5dfb93a81499d257b0e9e6d" "basis" 1114 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14006196/edb-import/verification.json"} {"question" "q-10074" "field" nil "attribute" "question/worked-solution" "value" "We organize the system so that it’s in the correct order first:\n\n$$\n\\begin{aligned}{\\begin{aligned}x+2y+3z=-1 \\\\ 4y+5z=0 \\\\ x+6z=3\\end{aligned}\\end{aligned}\n$$\n\nWe wish to write this system in the form $Ax=b$, where $A$ is a $3\\times 3$ matrix and $x$ and $b$ are $3\\times 1$ column vectors. We can do this as follows:\n\n$$\n[\\begin{aligned}1 & 2 & 3 \\\\ 0 & 4 & 5 \\\\ 1 & 0 & 6\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0 \\\\ 3\\end{aligned}].\n$$\n\nNow, the solution to $Ax=b$ is given by $x={A}^{-1}b.$ So, we compute ${A}^{-1}$ as follows:\n\n*Step 1:*\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}1 & 2 & 3 \\\\ 0 & 4 & 5 \\\\ 1 & 0 & 6\\end{aligned}| \\\\  & =1|\\begin{aligned}4 & 5 \\\\ 0 & 6\\end{aligned}|-2|\\begin{aligned}0 & 5 \\\\ 1 & 6\\end{aligned}|+3|\\begin{aligned}0 & 4 \\\\ 1 & 0\\end{aligned}| \\\\  & =1(24)-2(-5)+3(0-4) \\\\  & =24+10-12 \\\\  & =22.\\end{aligned}\n$$\n\n*Step 2:*\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}|\\begin{aligned}4 & 5 \\\\ 0 & 6\\end{aligned}| & |\\begin{aligned}0 & 5 \\\\ 1 & 6\\end{aligned}| & |\\begin{aligned}0 & 4 \\\\ 1 & 0\\end{aligned}| \\\\ |\\begin{aligned}2 & 3 \\\\ 0 & 6\\end{aligned}| & |\\begin{aligned}1 & 3 \\\\ 1 & 6\\end{aligned}| & |\\begin{aligned}1 & 2 \\\\ 1 & 0\\end{aligned}| \\\\ |\\begin{aligned}2 & 3 \\\\ 4 & 5\\end{aligned}| & |\\begin{aligned}1 & 3 \\\\ 0 & 5\\end{aligned}| & |\\begin{aligned}1 & 2 \\\\ 0 & 4\\end{aligned}|\\end{aligned}] \\\\  & =[\\begin{aligned}24 & -5 & -4 \\\\ 12 & 3 & -2 \\\\ -2 & 5 & 4\\end{aligned}].\\end{aligned}\n$$\n\n*Step 3:*\n\n$$\nC=[\\begin{aligned}24 & 5 & -4 \\\\ -12 & 3 & 2 \\\\ -2 & -5 & 4\\end{aligned}].\n$$\n\n*Step 4:*\n\n$$\n{C}^{T}=[\\begin{aligned}24 & -12 & -2 \\\\ 5 & 3 & -5 \\\\ -4 & 2 & 4\\end{aligned}].\n$$\n\n*Step 5:*\n\n$$\n{A}^{-1}=\\frac{1}{det(A)}{C}^{T}=\\frac{1}{22}[\\begin{aligned}24 & -12 & -2 \\\\ 5 & 3 & -5 \\\\ -4 & 2 & 4\\end{aligned}].\n$$\n\nHence\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{22}[\\begin{aligned}24 & -12 & -2 \\\\ 5 & 3 & -5 \\\\ -4 & 2 & 4\\end{aligned}][\\begin{aligned}-1 \\\\ 0 \\\\ 3\\end{aligned}] \\\\  & =\\frac{1}{22}[\\begin{aligned}-30 \\\\ -20 \\\\ 16\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{15}{11} \\\\ -\\frac{10}{11} \\\\ \\frac{8}{11}\\end{aligned}].\\end{aligned}\n$$\n\nHence the solution is $x=-\\frac{15}{11},y=-\\frac{10}{11},z=\\frac{8}{11}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14006196/state.json" "file_sha256" "fbc7043ca09de6693709e6fc649ea429407de8bcb5dfb93a81499d257b0e9e6d" "basis" 1114 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14006196/edb-import/verification.json"} {"question" "q-10074" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14006196/activity-metadata.json" "file_sha256" "521dbf399261aa539af449884a786ee73350a9b93f5f1f04cd961fa1322612ad" "basis" 1114 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14006196/edb-import/verification.json"} {"question" "q-10074" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14006196/state.json" "file_sha256" "fbc7043ca09de6693709e6fc649ea429407de8bcb5dfb93a81499d257b0e9e6d" "basis" 1114 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14006196/edb-import/verification.json"} {"question" "q-10074" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "x=-15,y=-10,z=8"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14006196/state.json" "file_sha256" "fbc7043ca09de6693709e6fc649ea429407de8bcb5dfb93a81499d257b0e9e6d" "basis" 1114 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14006196/edb-import/verification.json"} {"question" "q-10074" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "x=-30,y=-20,z=16"] "category" "ma_capture" "file" "/home/jake/De