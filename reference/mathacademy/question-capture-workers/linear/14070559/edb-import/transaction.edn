}^{2}+4{x}_{2}^{2} \\\\  & =4({x}_{1}^{2}+{x}_{2}^{2}).\\end{aligned}\n$$\n\nNow, recall that $‖x‖=1$ is equivalent to ${x}_{1}^{2}+{x}_{2}^{2}=1.$ So, \n\n$$\n\\begin{aligned}4({x}_{1}^{2}+{x}_{2}^{2})=4(1)=4.\\end{aligned}\n$$\n\nand, in turn, $Q(x)\\le 4.$\n\nSo, the value of $Q(x)$ can be no greater than $4.$ But before we conclude that $4$ is the maximum, we need to find a vector such that $Q(x)=4.$\n\nNotice that when  $x={[\\begin{aligned}1 & 0\\end{aligned}]}^{T},$ we get\n\n$$\n\\begin{aligned}Q(x) & =4{x}_{1}^{2}+2{x}_{2}^{2} \\\\  & =4(1)^{2}+2(0)^{2} \\\\  & =4.\\end{aligned}\n$$\n\nTherefore, given that $‖x‖=1,$ the maximum value of $Q(x)$ is equal to $4.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-138018/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a8666dd9-b763-589d-8ae3-af203068f1a4"] :knowledge-point/questions ["q-138018"] :db/ensure [:knowledge-point/validate]} {:db/id "q-138029/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "d145fba2-acb3-56f2-9f48-0f09f260ee4f" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-138029/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "e5499d20-c5b5-5532-a813-9537f78c6116" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-138029/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "f4b8b977-6e39-53be-b4da-d34761c5d4cc" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-138029/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "64e7e46d-326a-5593-b01c-ca195e51a5ef" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-138029/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "0ec6758d-d203-5c7d-afa2-7e15c53f12d4" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-138029/selection" :answer-field/id #uuid "c75bd729-b8dc-556b-b331-d0a1a47a64ca" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-138029/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-138029/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" "q-138029/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-138029/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-138029/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-138029/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-138029" :question/id #uuid "4c0412d6-580b-5534-97ba-10917d9a71d4" :question/math-academy-id "q-138029" :question/problem "Find the minimum value of $Q(x)=4{x}_{1}^{2}+3{x}_{2}^{2}+2{x}_{3}^{2}$ given that $‖x‖=1.$" :question/worked-solution "First, notice that ${x}_{1}^{2}\\ge 0$ and ${x}_{3}^{2}\\ge 0.$ So, we have that\n\n$$\n4{x}_{1}^{2}\\ge 2{x}_{1}^{2},\\,3{x}_{2}^{2}\\ge 2{x}_{2}^{2}.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}Q(x) & =4{x}_{1}^{2}+3{x}_{2}^{2}+2{x}_{3}^{2} \\\\  & \\ge 2{x}_{1}^{2}+2{x}_{2}^{2}+2{x}_{3}^{2} \\\\  & =2({x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}).\\end{aligned}\n$$\n\nNow, recall that $‖x‖=1$ is equivalent to ${x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}=1.$ So, \n\n$$\n\\begin{aligned}2({x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2})=2(1)=2.\\end{aligned}\n$$\n\nand, in turn, $Q(x)\\ge 2.$\n\nSo, the value of $Q(x)$ can be no smaller than $2.$ But before we conclude that $2$ is the minimum, we need to find a vector such that $Q(x)=2.$\n\nNotice that when  $x={[\\begin{aligned}0 & 0 & 1\\end{aligned}]}^{T},$ we get\n\n$$\n\\begin{aligned}Q(x) & =4{x}_{1}^{2}+3{x}_{2}^{2}+2{x}_{3}^{2} \\\\  & =4(0)^{2}+3(0)^{2}+2(1)^{2} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, given that $‖x‖=1,$ the minimum value of $Q(x)$ is equal to $2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-138029/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "33f7fa4d-9ac0-552a-9f3e-9e09c2ed0286"] :knowledge-point/questions ["q-138029"] :db/ensure [:knowledge-point/validate]} {:db/id "q-138065/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "14522301-01af-583b-b89d-25b17c705bdf" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-138065/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "4b680c18-9c6b-550c-9b08-a609bbe208b5" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-138065/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "54b0e57c-b70b-5fbe-ac9f-9b32c7bde4ca" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-138065/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "2731b785-d188-52a4-a776-167905787c2e" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-138065/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "0add60c4-4aa7-59f5-8faf-b0058826fb58" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-138065/selection" :answer-field/id #uuid "b8981759-b67d-5478-972f-51259def7b1e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-138065/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer-field/choices ["q-138065/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-138065/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" "q-138065/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" "q-138065/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-138065/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-138065" :question/id #uuid "51fe0971-9f79-57cb-b9e7-66881287b5f5" :question/math-academy-id "q-138065" :question/problem "Find the minimum value of $Q(x)=-3{x}_{1}^{2}-4{x}_{2}^{2}+5{x}_{3}^{2}$ given that $‖x‖=1.$" :question/worked-solution "First, notice that ${x}_{1}^{2}\\ge 0$ and ${x}_{3}^{2}\\ge 0.$ So, we have that\n\n$$\n-3{x}_{1}^{2}\\ge -4{x}_{1}^{2},\\,5{x}_{3}^{2}\\ge -4{x}_{3}^{2}.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}Q(x) & =-3{x}_{1}^{2}-4{x}_{2}^{2}+5{x}_{3}^{2} \\\\  & \\ge -4{x}_{1}^{2}-4{x}_{2}^{2}-4{x}_{3}^{2} \\\\  & =-4({x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}).\\end{aligned}\n$$\n\nNow, recall that $‖x‖=1$ is equivalent to ${x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}=1.$ So, \n\n$$\n\\begin{aligned}-4({x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2})=-4(1)=-4.\\end{aligned}\n$$\n\nand, in turn, $Q(x)\\ge -4.$   \n\nSo, the value of $Q(x)$ can be no smaller than $-4.$ But before we conclude that $-4$ is the minimum, we need to find a vector such that $Q(x)=-4.$\n\nNotice that when $x={[\\begin{aligned}0 & 1 & 0\\end{aligned}]}^{T},$ we get\n\n$$\n\\begin{aligned}Q(x) & =-3{x}_{1}^{2}-4{x}_{2}^{2}+5{x}_{3}^{2} \\\\  & =-3(0)^{2}-4(1)^{2}+5(0)^{2} \\\\  & =-4.\\end{aligned}\n$$\n\nTherefore, given that $‖x‖=1,$ the minimum value of $Q(x)$ is equal to $-4.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-138065/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "33f7fa4d-9ac0-552a-9f3e-9e09c2ed0286"] :knowledge-point/questions ["q-138065"] :db/ensure [:knowledge-point/validate]} {:db/id "q-138064/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "f5593af0-9696-5471-9677-b1a9d7c1c163" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-138064/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "7d273c53-c4bc-5668-8108-bf73ee8be2dd" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-138064/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "5723b1b4-0bee-5d2e-b437-1814dc68d1cb" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-138064/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "3ca4b54b-6647-5028-855c-870a5359746e" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-138064/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "78045ed6-ca34-5f81-8667-1a655fbaf95c" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-138064/selection" :answer-field/id #uuid "95310221-de35-5754-aa26-fd9ea199694f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-138064/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-138064/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" "q-138064/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-138064/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-138064/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-138064/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-138064" :question/id #uuid "fa4bb6b4-8b09-52db-958b-3d34503b56c8" :question/math-academy-id "q-138064" :question/problem "Find the minimum value of $Q(x)=4{x}_{1}^{2}-{x}_{2}^{2}-2{x}_{3}^{2}$ given that $‖x‖=1.$" :question/worked-solution "First, notice that ${x}_{1}^{2}\\ge 0$ and ${x}_{2}^{2}\\ge 0.$ So, we have that\n\n$$\n4{x}_{1}^{2}\\ge -2{x}_{1}^{2},\\,-{x}_{2}^{2}\\ge -2{x}_{2}^{2}.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}Q(x) & =4{x}_{1}^{2}-{x}_{2}^{2}-2{x}_{3}^{2} \\\\  & \\ge -2{x}_{1}^{2}-2{x}_{2}^{2}-2{x}_{3}^{2} \\\\  & =-2({x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}).\\end{aligned}\n$$\n\nNow, recall that $‖x‖=1$ is equivalent to ${x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}=1.$ So, \n\n$$\n\\begin{aligned}-2({x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2})=-2(1)=-2.\\end{aligned}\n$$\n\nand, in turn, $Q(x)\\ge -2.$ \n\nSo, the value of $Q(x)$ can be no smaller than $-2.$ But before we conclude that $-2$ is the minimum, we need to find a vector such that $Q(x)=-2.$\n\nNotice that when $x={[\\begin{aligned}0 & 0 & 1\\end{aligned}]}^{T},$ we get\n\n$$\n\\begin{aligned}Q(x) & =4{x}_{1}^{2}-{x}_{2}^{2}-2{x}_{3}^{2} \\\\  & =4(0)^{2}-(0)^{2}-2(1)^{2} \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, given that $‖x‖=1,$ the minimum value of $Q(x)$ is equal to $-2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-138064/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "33f7fa4d-9ac0-552a-9f3e-9e09c2ed0286"] :knowledge-point/questions ["q-138064"] :db/ensure [:knowledge-point/validate]} {:db/id "q-158529/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "5916a263-8ee6-5c22-9977-82d2d2b23f3f" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-158529/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "7ecac5c1-0865-5d5d-9e5e-34a181f0835c" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-158529/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "090a3b2c-56ef-5d6e-abdf-4480eb5b50ad" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-158529/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "73a23f19-3f7c-584d-ba30-6f780b41678a" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-158529/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "2a29ebf1-af39-5367-a49d-bd82553153d4" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-158529/selection" :answer-field/id #uuid "5a383cf3-bb93-59ee-a8e3-508831b9676f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-158529/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer-field/choices ["q-158529/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-158529/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-158529/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" "q-158529/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-158529/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-158529" :question/id #uuid "cc65d907-e952-54f8-94c3-91f4719ec6d9" :question/math-academy-id "q-158529" :question/problem "Find the minimum value of $Q(x)=-4{x}_{1}^{2}-3{x}_{2}^{2}$ given that $‖x‖=1.$" :question/worked-solution "First, notice that ${x}_{2}^{2}\\ge 0.$ So, we have that\n\n$$\n-3{x}_{2}^{2}\\ge -4{x}_{2}^{2}.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}Q(x) & =-4{x}_{1}^{2}-3{x}_{2}^{2} \\\\  & \\ge -4{x}_{1}^{2}-4{x}_{2}^{2} \\\\  & =-4({x}_{1}^{2}+{x}_{2}^{2}).\\end{aligned}\n$$\n\nNow, recall that $‖x‖=1$ is equivalent to ${x}_{1}^{2}+{x}_{2}^{2}=1.$ So,  \n\n$$\n\\begin{aligned}-4({x}_{1}^{2}+{x}_{2}^{2})=-4(1)=-4.\\end{aligned}\n$$\n\nand, in turn, $Q(x)\\ge -4.$\n\nSo, the value of $Q(x)$ can be no smaller than $-4.$ But before we conclude that $-4$ is the minimum, we need to find a vector such that $Q(x)=-4.$\n\nNotice that when $x={[\\begin{aligned}1 & 0\\end{aligned}]}^{T},$ we get\n\n$$\n\\begin{aligned}Q(x) & =-4{x}_{1}^{2}-3{x}_{2}^{2} \\\\  & =-4(1)^{2}-3(0)^{2} \\\\  & =-4.\\end{aligned}\n$$\n\nTherefore, given that $‖x‖=1,$ the minimum value of $Q(x)$ is equal to $-4.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-158529/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "33f7fa4d-9ac0-552a-9f3e-9e09c2ed0286"] :knowledge-point/questions ["q-158529"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-138019"] :question/problem "Find the minimum value of $Q(x)=5{x}_{1}^{2}+3{x}_{2}^{2}$ given that $‖x‖=1.$" :question/worked-solution "First, notice that ${x}_{1}^{2}\\ge 0.$ So, we have that\n\n$$\n5{x}_{1}^{2}\\ge 3{x}_{1}^{2}.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}Q(x) & =5{x}_{1}^{2}+3{x}_{2}^{2} \\\\  & \\ge 3{x}_{1}^{2}+3{x}_{2}^{2} \\\\  & =3({x}_{1}^{2}+{x}_{2}^{2}).\\end{aligned}\n$$\n\nNow, recall that $‖x‖=1$ is equivalent to ${x}_{1}^{2}+{x}_{2}^{2}=1.$ So, \n\n$$\n\\begin{aligned}3({x}_{1}^{2}+{x}_{2}^{2})=3(1)=3.\\end{aligned}\n$$\n\nand, in turn, $Q(x)\\ge 3.$ \n\nSo, the value of $Q(x)$ can be no smaller than $3.$ But before we conclude that $3$ is the minimum, we need to find a vector such that $Q(x)=3.$\n\nNotice that when  $x={[\\begin{aligned}0 & 1\\end{aligned}]}^{T},$ we get\n\n$$\n\\begin{aligned}Q(x) & =5{x}_{1}^{2}+3{x}_{2}^{2} \\\\  & =5(0)+3(1)^{2} \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, given that $‖x‖=1,$ the minimum value of $Q(x)$ is equal to $3.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-138066/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "bc89b0fc-5ab5-507a-95be-a4bf9f9f1390" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-138066/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "72a125f3-b1d4-50cb-9c69-63e62dd88adf" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-138066/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "b3ca2593-0378-5c60-a8ac-15b9840baca5" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-138066/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "a0c1eff4-4d09-5e63-9cc7-93ac36c0fda1" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-138066/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "c9866f0e-a387-5bad-9ada-e4632702336c" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-138066/selection" :answer-field/id #uuid "ed53c7b7-1529-5f0d-8cda-6c16d362dc54" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-138066/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-138066/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-138066/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-138066/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-138066/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-138066/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-138066" :question/id #uuid "3655d4ba-053a-5c00-a9f4-82a3ece073b9" :question/math-academy-id "q-138066" :question/problem "Find the maximum value of $Q(x)={x}_{1}^{2}+8{x}_{1}{x}_{2}+{x}_{2}^{2}$ given that $‖x‖=1.$" :question/worked-solution "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\nmax{Q(x)\\,|\\,‖x‖=1}={\\lambda }_{\\text{max}}\n$$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\nmin{Q(x)\\,|\\,‖x‖=1}={\\lambda }_{\\text{min}}\n$$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=[\\begin{aligned}1 & 4 \\\\ 4 & 1\\end{aligned}]\n$$\n\nNow, we need to calculate the eigenvalues of the matrix $A:$\n\n$$\n\\begin{aligned}|A-\\lambda I| & =0 \\\\ |\\begin{aligned}1-\\lambda  & 4 \\\\ 4 & 1-\\lambda \\end{aligned}| & =0 \\\\ (1-\\lambda )(1-\\lambda )-16 & =0 \\\\ {\\lambda }^{2}-2\\lambda -15 & =0 \\\\ (\\lambda +3)(\\lambda -5) & =0 \\\\ \\lambda  & =-3,\\,5\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nmax{Q(x)\\,|\\,‖x‖=1}=5.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-138066/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3b2e9ac0-590b-587c-b16d-309f899c21e6"] :knowledge-point/questions ["q-138066"] :db/ensure [:knowledge-point/validate]} {:db/id "q-138068/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "ad4ce460-4506-5946-a8ab-04c4709d615d" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-138068/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "a8d4865a-8a57-57e9-a7ff-7cbbe7eed620" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-138068/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "066cd44d-0ef6-5af3-ba5e-1462b4b7f939" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-138068/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "ed74a3dd-5690-5488-b52d-4d9e6e9c1eb2" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-138068/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "c0bce4b2-1c5c-52e3-b58b-756020408fa4" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-138068/selection" :answer-field/id #uuid "1fb62a26-e526-5907-81fb-7294f7d3759f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-138068/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer-field/choices ["q-138068/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-138068/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-138068/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" "q-138068/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" "q-138068/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-138068" :question/id #uuid "469bd1b0-4e94-52f9-a547-6512114b725e" :question/math-academy-id "q-138068" :question/problem "Find the maximum value of $Q(x)=5{x}_{1}^{2}+4{x}_{1}{x}_{2}+5{x}_{2}^{2}$ given that $‖x‖=1.$" :question/worked-solution "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\nmax{Q(x)\\,|\\,‖x‖=1}={\\lambda }_{\\text{max}}\n$$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\nmin{Q(x)\\,|\\,‖x‖=1}={\\lambda }_{\\text{min}}\n$$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=[\\begin{aligned}5 & 2 \\\\ 2 & 5\\end{aligned}]\n$$\n\nNow, we need to calculate the eigenvalues of the matrix $A:$\n\n$$\n\\begin{aligned}|A-\\lambda I| & =0 \\\\ |\\begin{aligned}5-\\lambda  & 2 \\\\ 2 & 5-\\lambda \\end{aligned}| & =0 \\\\ (5-\\lambda )(5-\\lambda )-4 & =0 \\\\ {\\lambda }^{2}-10\\lambda +21 & =0 \\\\ (\\lambda -3)(\\lambda -7) & =0 \\\\ \\lambda  & =3,\\,7\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nmax{Q(x)\\,|\\,‖x‖=1}=7.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-138068/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3b2e9ac0-590b-587c-b16d-309f899c21e6"] :knowledge-point/questions ["q-138068"] :db/ensure [:knowledge-point/validate]} {:db/id "q-138070/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "f46f76ae-6bdd-57d1-b1f6-2cde819e1711" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-138070/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "73308c35-5633-5880-9a28-c40549a14bc4" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-138070/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "dfbec8fd-5d7c-5fee-8786-ff730668bae9" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-138070/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "0a67c3d0-0bc5-5fdb-a7a7-2718058ca368" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-138070/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "888a766c-2798-534a-a658-964299963501" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-138070/selection" :answer-field/id #uuid "e109208c-16e5-518b-bc9b-8f254dfedede" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-138070/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-138070/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-138070/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-138070/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-138070/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-138070/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-138070" :question/id #uuid "4846f1d2-4ccf-5b3b-802d-646a9deabd39" :question/math-academy-id "q-138070" :question/problem "Find the minimum value of $Q(x)=3{x}_{1}^{2}-2{x}_{1}{x}_{2}+3{x}_{2}^{2}$ given that $‖x‖=1.$" :question/worked-solution "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\nmax{Q(x)\\,|\\,‖x‖=1}={\\lambda }_{\\text{max}}\n$$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\nmin{Q(x)\\,|\\,‖x‖=1}={\\lambda }_{\\text{min}}\n$$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=[\\begin{aligned}3 & -1 \\\\ -1 & 3\\end{aligned}]\n$$\n\nNow, we need to calculate the eigenvalues of the matrix $A:$\n\n$$\n\\begin{aligned}|A-\\lambda I| & =0 \\\\ |\\begin{aligned}3-\\lambda  & -1 \\\\ -1 & 3-\\lambda \\end{aligned}| & =0 \\\\ (3-\\lambda )(3-\\lambda )-1 & =0 \\\\ {\\lambda }^{2}-6\\lambda +8 & =0 \\\\ (\\lambda -2)(\\lambda -4) & =0 \\\\ \\lambda  & =2,\\,4\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nmin{Q(x)\\,|\\,‖x‖=1}=2.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-138070/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3b2e9ac0-590b-587c-b16d-309f899c21e6"] :knowledge-point/questions ["q-138070"] :db/ensure [:knowledge-point/validate]} {:db/id "q-138067/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "62c0a855-d71d-50cf-a956-2f94e9bd4886" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-138067/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer/id #uuid "51e6f462-0a65-51ff-94e3-e7ba60e72746" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "q-138067/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "d9b854e0-0950-51a5-8e8c-8da0c1c7b103" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-138067/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "bb6492cd-b48c-55e9-a487-02e991dce708" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-138067/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "778e9be3-d2fe-58ad-b5f6-1e9c821fdf6f" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-138067/selection" :answer-field/id #uuid "cb76961c-25fe-5784-817c-45d36c71bb72" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-138067/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer-field/choices ["q-138067/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" "q-138067/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" "q-138067/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-138067/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-138067/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-138067" :question/id #uuid "e071b0c8-e066-5846-8bcb-b339254a2972" :question/math-academy-id "q-138067" :question/problem "Find the minimum value of $Q(x)={x}_{1}^{2}-8{x}_{1}{x}_{2}-5{x}_{2}^{2}$ given that $‖x‖=1.$" :question/worked-solution "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\nmax{Q(x)\\,|\\,‖x‖=1}={\\lambda }_{\\text{max}}\n$$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\nmin{Q(x)\\,|\\,‖x‖=1}={\\lambda }_{\\text{min}}\n$$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=[\\begin{aligned}1 & -4 \\\\ -4 & -5\\end{aligned}]\n$$\n\nNow, we need to calculate the eigenvalues of the matrix $A:$\n\n$$\n\\begin{aligned}|A-\\lambda I| & =0 \\\\ |\\begin{aligned}1-\\lambda  & -4 \\\\ -4 & -5-\\lambda \\end{aligned}| & =0 \\\\ (1-\\lambda )(-5-\\lambda )-16 & =0 \\\\ {\\lambda }^{2}+4\\lambda -21 & =0 \\\\ (\\lambda -3)(\\lambda +7) & =0 \\\\ \\lambda  & =3,\\,-7\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nmin{Q(x)\\,|\\,‖x‖=1}=-7.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-138067/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3b2e9ac0-590b-587c-b16d-309f899c21e6"] :knowledge-point/questions ["q-138067"] :db/ensure [:knowledge-point/validate]} {:db/id "q-138074/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "d6d01c79-9e93-5ebc-9a15-16d49ff3c2c3" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-138074/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "5453e701-bc1b-54d1-8e0d-14d98c394a89" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-138074/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "118e4b71-542f-594f-9291-e6ce6c19212a" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-138074/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "8e19bbca-8283-5e80-9cd8-32b44eb81680" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-138074/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "a7e9d7ba-b763-528d-8faf-415aa2a81d2d" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-138074/selection" :answer-field/id #uuid "a7b97668-97d4-51da-9f38-49ef169cc54d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-138074/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-138074/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-138074/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-138074/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-138074/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-138074/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-138074" :question/id #uuid "2cf5ef63-0b32-59cb-896f-6647575d6bb9" :question/math-academy-id "q-138074" :question/problem "Find the maximum value of $Q(x)=3{x}_{1}^{2}+{x}_{2}^{2}+3{x}_{3}^{2}-2{x}_{1}{x}_{3}$ given that $‖x‖=1.$" :question/worked-solution "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\nmax{Q(x)\\,|\\,‖x‖=1}={\\lambda }_{\\text{max}}\n$$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\nmin{Q(x)\\,|\\,‖x‖=1}={\\lambda }_{\\text{min}}\n$$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=[\\begin{aligned}3 & 0 & -1 \\\\ 0 & 1 & 0 \\\\ -1 & 0 & 3\\end{aligned}]\n$$\n\nNow, we need to calculate the eigenvalues of the matrix $A:$\n\n$$\n\\begin{aligned}|A-\\lambda I| & =0 \\\\ |\\begin{aligned}3-\\lambda  & 0 & -1 \\\\ 0 & 1-\\lambda  & 0 \\\\ -1 & 0 & 3-\\lambda \\end{aligned}| & =0 \\\\ (1-\\lambda )|\\begin{aligned}3-\\lambda  & -1 \\\\ -1 & 3-\\lambda \\end{aligned}| & =0 \\\\ (1-\\lambda )((3-\\lambda )(3-\\lambda )-1) & =0 \\\\ (1-\\lambda )({\\lambda }^{2}-6\\lambda +8) & =0 \\\\ (1-\\lambda )(\\lambda -4)(\\lambda -2) & =0 \\\\ \\lambda  & =4,\\,2,\\,1\\end{aligned}\n$$\n\n \n\nTherefore, we have\n\n$$\nmax{Q(x)\\,|\\,‖x‖=1}=4.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-138074/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3b2e9ac0-590b-587c-b16d-309f899c21e6"] :knowledge-point/questions ["q-138074"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-12659"] :question/problem "Find the maximum value of $Q(\\mathbf{x})=2x_1^2 - 5x_2^2 +3x_3^2$ given that $\\| \\mathbf{x} \\| =1.$" :question/worked-solution "First, notice that $x_1^2 \\geq 0$ and $x_2^2 \\geq 0.$ So, we have that \n\n$$\n2x_1^2 \\leq 3x_1^2, \\qquad -5x_2^2 \\leq 3x_2^2.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}Q(x) & =2{x}_{1}^{2}-5{x}_{2}^{2}+3{x}_{3}^{2} \\\\  & \\le 3{x}_{1}^{2}+3{x}_{2}^{2}+3{x}_{3}^{2} \\\\  & =3({x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}).\\end{aligned}\n$$\n\nNow, recall that $\\| \\mathbf{x} \\| = 1$ is equivalent to $x_1^2 + x_2^2 + x_3^2 =1.$ So, \n\n$$\n\\begin{aligned}3({x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2})=3(1)=3,\\end{aligned}\n$$\n\nand, in turn, $Q(\\mathbf{x}) \\leq 3.$\n\nSo, the value of $Q(\\mathbf{x})$ can be no greater than $3.$ But before we conclude that $3$ is the maximum, we need to find a vector such that $Q(\\mathbf{x}) = 3.$\n\nNotice that when ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/assets/1986d7b40e318db91ac16ba9540ec704fd6221ac295dec66540c190a090a1463.png) we get\n\n$$\n\\begin{aligned}Q(x) & =2{x}_{1}^{2}-5{x}_{2}^{2}+3{x}_{3}^{2} \\\\  & =2(0)^{2}-5(0)^{2}+3(1)^{2} \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, given that $\\| \\mathbf{x} \\| =1,$ the maximum value of $Q(\\mathbf{x})$ is equal to $3.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-12660"] :question/problem "Find the minimum value of $Q(\\mathbf{x})=5x_1^2 - 4x_2^2 - 6x_3^2$ given that $\\| \\mathbf{x} \\| =1.$" :question/worked-solution "First, notice that $x_1^2 \\geq 0$ and $x_2^2 \\geq 0.$ So, we have that\n\n$$\n5x_1^2 \\geq -6x_1^2, \\qquad -4x_2^2 \\geq -6x_2^2.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}Q(x) & =5{x}_{1}^{2}-4{x}_{2}^{2}-6{x}_{3}^{2} \\\\  & \\ge -6{x}_{1}^{2}-6{x}_{2}^{2}-6{x}_{3}^{2} \\\\  & =-6({x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}).\\end{aligned}\n$$\n\nNow, recall that $\\| \\mathbf{x} \\| = 1$ is equivalent to $x_1^2 + x_2^2 + x_3^2 =1.$ So, \n\n$$\n\\begin{aligned}-6({x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2})=-6(1)=-6.\\end{aligned}\n$$\n\nand, in turn, $Q(\\mathbf{x}) \\geq -6.$\n\nSo, the value of $Q(\\mathbf{x})$ can be no smaller than $-6.$ But before we conclude that $-6$ is the minimum, we need to find a vector such that $Q(\\mathbf{x}) = -6.$\n\nNotice that when ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/assets/d509eb79bc8d9a96b60922166e49d0225eac7a99d2614859c31af15199d4d47c.png) we get\n\n$$\n\\begin{aligned}Q(x) & =5{x}_{1}^{2}-4{x}_{2}^{2}-6{x}_{3}^{2} \\\\  & =5(0)^{2}-4(0)^{2}-6(1)^{2} \\\\  & =-6.\\end{aligned}\n$$\n\nTherefore, given that $\\| \\mathbf{x} \\| =1,$ the minimum value of $Q(\\mathbf{x})$ is equal to $-6.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-12661"] :question/problem "Find the minimum value of $Q(\\mathbf{x})=x_1^2-2x_2^2-2x_3^2+2x_2x_3$  given that $\\| \\mathbf{x} \\| = 1.$" :question/worked-solution "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(\\mathbf{x}),$ when $\\| \\mathbf{x} \\|=1,$ is equal to the largest eigenvalue of $A{:}$\n\n$$\n\\max \\{ Q(\\mathbf{x}) \\: | \\:  \\| \\mathbf{x} \\| = 1 \\} = \\lambda_{\\textrm{max}}\n$$\n\n- The minimum value of $Q(\\mathbf{x}),$ when $\\| \\mathbf{x} \\|=1,$ is equal to the smallest eigenvalue of $A{:}$\n\n$$\n\\min \\{ Q(\\mathbf{x}) \\: | \\:  \\| \\mathbf{x} \\| = 1 \\} = \\lambda_{\\textrm{min}}\n$$\n\nFirst, we write down the matrix of our quadratic form:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/assets/d7716e2c2924212e880275dd674d4a951daf66ac41e5a888a57acb6be686118f.png)\n\nNow, we need to calculate the eigenvalues of the matrix $A\\mathbin{:}$\n\n$$\n\\begin{aligned}|A-\\lambda I| & =0 \\\\ |\\begin{aligned}1-\\lambda  & 0 & 0 \\\\ 0 & -2-\\lambda  & 1 \\\\ 0 & 1 & -2-\\lambda \\end{aligned}| & =0 \\\\ (1-\\lambda )|\\begin{aligned}-2-\\lambda  & 1 \\\\ 1 & -2-\\lambda \\end{aligned}| & =0 \\\\ (1-\\lambda )((-2-\\lambda )(-2-\\lambda )-1) & =0 \\\\ (1-\\lambda )({\\lambda }^{2}+4\\lambda +3) & =0 \\\\ (1-\\lambda )(\\lambda +3)(\\lambda +1) & =0 \\\\ \\lambda  & =1,\\,-1,\\,-3\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\min \\{ Q(\\mathbf{x}) \\: | \\:  \\| \\mathbf{x} \\| = 1 \\} = -3.\n$$" :db/ensure [:question/validate]}]
