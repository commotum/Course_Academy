2}^{2})=8(1)=8.\\end{aligned}\n$$\n\nand, in turn, $Q(x)\\le 8.$\n\nSo, the value of $Q(x)$ can be no greater than $8.$ But before we conclude that $8$ is the maximum, we need to find a vector such that $Q(x)=8.$\n\nNotice that when  $x={[\\begin{aligned}0 & 1\\end{aligned}]}^{T},$ we get\n\n$$\n\\begin{aligned}Q(x) & =5{x}_{1}^{2}+8{x}_{2}^{2} \\\\  & =5(0)^{2}+8(1)^{2} \\\\  & =8.\\end{aligned}\n$$\n\nTherefore, given that $‖x‖=1,$ the maximum value of $Q(x)$ is equal to $8.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-158468" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/activity-metadata.json" "file_sha256" "4c0e7e08f72cdae407343963a3ab5ff66cf8ffcdc5c30fe4db1f955ab6c1248d"} {"question" "q-158468" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-158468" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "1"] ["math" "13"] ["math" "3"] ["math" "5"] ["math" "8"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-158468" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "8"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-work