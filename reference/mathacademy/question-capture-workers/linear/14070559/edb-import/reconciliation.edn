{1}^{2}+2{x}_{2}^{2}+2{x}_{3}^{2} \\\\  & =2({x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}).\\end{aligned}\n$$\n\nNow, recall that $‖x‖=1$ is equivalent to ${x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}=1.$ So, \n\n$$\n\\begin{aligned}2({x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2})=2(1)=2.\\end{aligned}\n$$\n\nand, in turn, $Q(x)\\ge 2.$\n\nSo, the value of $Q(x)$ can be no smaller than $2.$ But before we conclude that $2$ is the minimum, we need to find a vector such that $Q(x)=2.$\n\nNotice that when  $x={[\\begin{aligned}0 & 0 & 1\\end{aligned}]}^{T},$ we get\n\n$$\n\\begin{aligned}Q(x) & =4{x}_{1}^{2}+3{x}_{2}^{2}+2{x}_{3}^{2} \\\\  & =4(0)^{2}+3(0)^{2}+2(1)^{2} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, given that $‖x‖=1,$ the minimum value of $Q(x)$ is equal to $2.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-138029" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/activity-metadata.json" "file_sha256" "4c0e7e08f72cdae407343963a3ab5ff66cf8ffcdc5c30fe4db1f955ab6c1248d"} {"question" "q-138029" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-138029" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "1"] ["math" "2"] ["math" "5"] ["math" "6"] ["math" "9"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-138029" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-138065" "field" nil "attribute" "question/problem" "value" "Find the minimum value of $Q(x)=-3{x}_{1}^{2}-4{x}_{2}^{2}+5{x}_{3}^{2}$ given that $‖x‖=1.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-138065" "field" nil "attribute" "question/worked-solution" "value" "First, notice that ${x}_{1}^{2}\\ge 0$ and ${x}_{3}^{2}\\ge 0.$ So, we have that\n\n$$\n-3{x}_{1}^{2}\\ge -4{x}_{1}^{2},\\,5{x}_{3}^{2}\\ge -4{x}_{3}^{2}.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}Q(x) & =-3{x}_{1}^{2}-4{x}_{2}^{2}+5{x}_{3}^{2} \\\\  & \\ge -4{x}_{1}^{2}-4{x}_{2}^{2}-4{x}_{3}^{2} \\\\  & =-4({x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}).\\end{aligned}\n$$\n\nNow, recall that $‖x‖=1$ is equivalent to ${x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}=1.$ So, \n\n$$\n\\begin{aligned}-4({x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2})=-4(1)=-4.\\end{aligned}\n$$\n\nand, in turn, $Q(x)\\ge -4.$   \n\nSo, the value of $Q(x)$ can be no smaller than $-4.$ But before we conclude that $-4$ is the minimum, we need to find a vector such that $Q(x)=-4.$\n\nNotice that when $x={[\\begin{aligned}0 & 1 & 0\\end{aligned}]}^{T},$ we get\n\n$$\n\\begin{aligned}Q(x) & =-3{x}_{1}^{2}-4{x}_{2}^{2}+5{x}_{3}^{2} \\\\  & =-3(0)^{2}-4(1)^{2}+5(0)^{2} \\\\  & =-4.\\end{aligned}\n$$\n\nTherefore, given that $‖x‖=1,$ the minimum value of $Q(x)$ is equal to $-4.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-138065" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/activity-metadata.json" "file_sha256" "4c0e7e08f72cdae407343963a3ab5ff66cf8ffcdc5c30fe4db1f955ab6c1248d"} {"question" "q-138065" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-138065" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-2"] ["math" "-3"] ["math" "-4"] ["math" "-5"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-138065" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-4"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-138064" "field" nil "attribute" "question/problem" "value" "Find the minimum value of $Q(x)=4{x}_{1}^{2}-{x}_{2}^{2}-2{x}_{3}^{2}$ given that $‖x‖=1.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-138064" "field" nil "attribute" "question/worked-solution" "value" "First, notice that ${x}_{1}^{2}\\ge 0$ and ${x}_{2}^{2}\\ge 0.$ So, we have that\n\n$$\n4{x}_{1}^{2}\\ge -2{x}_{1}^{2},\\,-{x}_{2}^{2}\\ge -2{x}_{2}^{2}.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}Q(x) & =4{x}_{1}^{2}-{x}_{2}^{2}-2{x}_{3}^{2} \\\\  & \\ge -2{x}_{1}^{2}-2{x}_{2}^{2}-2{x}_{3}^{2} \\\\  & =-2({x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}).\\end{aligned}\n$$\n\nNow, recall that $‖x‖=1$ is equivalent to ${x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}=1.$ So, \n\n$$\n\\begin{aligned}-2({x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2})=-2(1)=-2.\\end{aligned}\n$$\n\nand, in turn, $Q(x)\\ge -2.$ \n\nSo, the value of $Q(x)$ can be no smaller than $-2.$ But before we conclude that $-2$ is the minimum, we need to find a vector such that $Q(x)=-2.$\n\nNotice that when $x={[\\begin{aligned}0 & 0 & 1\\end{aligned}]}^{T},$ we get\n\n$$\n\\begin{aligned}Q(x) & =4{x}_{1}^{2}-{x}_{2}^{2}-2{x}_{3}^{2} \\\\  & =4(0)^{2}-(0)^{2}-2(1)^{2} \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, given that $‖x‖=1,$ the minimum value of $Q(x)$ is equal to $-2.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-138064" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/activity-metadata.json" "file_sha256" "4c0e7e08f72cdae407343963a3ab5ff66cf8ffcdc5c30fe4db1f955ab6c1248d"} {"question" "q-138064" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-138064" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-2"] ["math" "-4"] ["math" "0"] ["math" "4"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-138064" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-158529" "field" nil "attribute" "question/problem" "value" "Find the minimum value of $Q(x)=-4{x}_{1}^{2}-3{x}_{2}^{2}$ given that $‖x‖=1.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-158529" "field" nil "attribute" "question/worked-solution" "value" "First, notice that ${x}_{2}^{2}\\ge 0.$ So, we have that\n\n$$\n-3{x}_{2}^{2}\\ge -4{x}_{2}^{2}.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}Q(x) & =-4{x}_{1}^{2}-3{x}_{2}^{2} \\\\  & \\ge -4{x}_{1}^{2}-4{x}_{2}^{2} \\\\  & =-4({x}_{1}^{2}+{x}_{2}^{2}).\\end{aligned}\n$$\n\nNow, recall that $‖x‖=1$ is equivalent to ${x}_{1}^{2}+{x}_{2}^{2}=1.$ So,  \n\n$$\n\\begin{aligned}-4({x}_{1}^{2}+{x}_{2}^{2})=-4(1)=-4.\\end{aligned}\n$$\n\nand, in turn, $Q(x)\\ge -4.$\n\nSo, the value of $Q(x)$ can be no smaller than $-4.$ But before we conclude that $-4$ is the minimum, we need to find a vector such that $Q(x)=-4.$\n\nNotice that when $x={[\\begin{aligned}1 & 0\\end{aligned}]}^{T},$ we get\n\n$$\n\\begin{aligned}Q(x) & =-4{x}_{1}^{2}-3{x}_{2}^{2} \\\\  & =-4(1)^{2}-3(0)^{2} \\\\  & =-4.\\end{aligned}\n$$\n\nTherefore, given that $‖x‖=1,$ the minimum value of $Q(x)$ is equal to $-4.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-158529" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/activity-metadata.json" "file_sha256" "4c0e7e08f72cdae407343963a3ab5ff66cf8ffcdc5c30fe4db1f955ab6c1248d"} {"question" "q-158529" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-158529" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-3"] ["math" "-4"] ["math" "0"] ["math" "1"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-158529" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-4"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-138019" "field" nil "attribute" "question/problem" "value" "Find the minimum value of $Q(x)=5{x}_{1}^{2}+3{x}_{2}^{2}$ given that $‖x‖=1.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-138019" "field" nil "attribute" "question/worked-solution" "value" "First, notice that ${x}_{1}^{2}\\ge 0.$ So, we have that\n\n$$\n5{x}_{1}^{2}\\ge 3{x}_{1}^{2}.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}Q(x) & =5{x}_{1}^{2}+3{x}_{2}^{2} \\\\  & \\ge 3{x}_{1}^{2}+3{x}_{2}^{2} \\\\  & =3({x}_{1}^{2}+{x}_{2}^{2}).\\end{aligned}\n$$\n\nNow, recall that $‖x‖=1$ is equivalent to ${x}_{1}^{2}+{x}_{2}^{2}=1.$ So, \n\n$$\n\\begin{aligned}3({x}_{1}^{2}+{x}_{2}^{2})=3(1)=3.\\end{aligned}\n$$\n\nand, in turn, $Q(x)\\ge 3.$ \n\nSo, the value of $Q(x)$ can be no smaller than $3.$ But before we conclude that $3$ is the minimum, we need to find a vector such that $Q(x)=3.$\n\nNotice that when  $x={[\\begin{aligned}0 & 1\\end{aligned}]}^{T},$ we get\n\n$$\n\\begin{aligned}Q(x) & =5{x}_{1}^{2}+3{x}_{2}^{2} \\\\  & =5(0)+3(1)^{2} \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, given that $‖x‖=1,$ the minimum value of $Q(x)$ is equal to $3.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-138019" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/activity-metadata.json" "file_sha256" "4c0e7e08f72cdae407343963a3ab5ff66cf8ffcdc5c30fe4db1f955ab6c1248d"} {"question" "q-138019" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-138019" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2"] ["math" "3"] ["math" "4"] ["math" "5"] ["math" "6"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-138019" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "3"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-138066" "field" nil "attribute" "question/problem" "value" "Find the maximum value of $Q(x)={x}_{1}^{2}+8{x}_{1}{x}_{2}+{x}_{2}^{2}$ given that $‖x‖=1.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-138066" "field" nil "attribute" "question/worked-solution" "value" "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\nmax{Q(x)\\,|\\,‖x‖=1}={\\lambda }_{\\text{max}}\n$$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\nmin{Q(x)\\,|\\,‖x‖=1}={\\lambda }_{\\text{min}}\n$$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=[\\begin{aligned}1 & 4 \\\\ 4 & 1\\end{aligned}]\n$$\n\nNow, we need to calculate the eigenvalues of the matrix $A:$\n\n$$\n\\begin{aligned}|A-\\lambda I| & =0 \\\\ |\\begin{aligned}1-\\lambda  & 4 \\\\ 4 & 1-\\lambda \\end{aligned}| & =0 \\\\ (1-\\lambda )(1-\\lambda )-16 & =0 \\\\ {\\lambda }^{2}-2\\lambda -15 & =0 \\\\ (\\lambda +3)(\\lambda -5) & =0 \\\\ \\lambda  & =-3,\\,5\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nmax{Q(x)\\,|\\,‖x‖=1}=5.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-138066" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/activity-metadata.json" "file_sha256" "4c0e7e08f72cdae407343963a3ab5ff66cf8ffcdc5c30fe4db1f955ab6c1248d"} {"question" "q-138066" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-138066" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2"] ["math" "3"] ["math" "4"] ["math" "5"] ["math" "6"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-138066" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "5"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-138068" "field" nil "attribute" "question/problem" "value" "Find the maximum value of $Q(x)=5{x}_{1}^{2}+4{x}_{1}{x}_{2}+5{x}_{2}^{2}$ given that $‖x‖=1.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-138068" "field" nil "attribute" "question/worked-solution" "value" "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\nmax{Q(x)\\,|\\,‖x‖=1}={\\lambda }_{\\text{max}}\n$$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\nmin{Q(x)\\,|\\,‖x‖=1}={\\lambda }_{\\text{min}}\n$$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=[\\begin{aligned}5 & 2 \\\\ 2 & 5\\end{aligned}]\n$$\n\nNow, we need to calculate the eigenvalues of the matrix $A:$\n\n$$\n\\begin{aligned}|A-\\lambda I| & =0 \\\\ |\\begin{aligned}5-\\lambda  & 2 \\\\ 2 & 5-\\lambda \\end{aligned}| & =0 \\\\ (5-\\lambda )(5-\\lambda )-4 & =0 \\\\ {\\lambda }^{2}-10\\lambda +21 & =0 \\\\ (\\lambda -3)(\\lambda -7) & =0 \\\\ \\lambda  & =3,\\,7\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nmax{Q(x)\\,|\\,‖x‖=1}=7.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-138068" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/activity-metadata.json" "file_sha256" "4c0e7e08f72cdae407343963a3ab5ff66cf8ffcdc5c30fe4db1f955ab6c1248d"} {"question" "q-138068" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070559/state.json" "file_sha256" "c68fa87c4ac68aad1563f499ac85dfd254842abcef2884ede275189eab9b9e07"} {"question" "q-138068" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "3"] ["math" "