6" "72a4f4389fa4f7d9bc02cd66c0bff65dfb2b3294a95e880f7f48fe02286dbca5" "basis" 1760 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/edb-import/verification.json"} {"question" "q-104865" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "5(3{t}^{2}-1)"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/state.json" "file_sha256" "72a4f4389fa4f7d9bc02cd66c0bff65dfb2b3294a95e880f7f48fe02286dbca5" "basis" 1760 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/edb-import/verification.json"} {"question" "q-104865" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "9(3{t}^{2}-1)"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/state.json" "file_sha256" "72a4f4389fa4f7d9bc02cd66c0bff65dfb2b3294a95e880f7f48fe02286dbca5" "basis" 1760 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/edb-import/verification.json"} {"question" "q-104865" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "{t}^{2}-1"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/state.json" "file_sha256" "72a4f4389fa4f7d9bc02cd66c0bff65dfb2b3294a95e880f7f48fe02286dbca5" "basis" 1760 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/edb-import/verification.json"} {"question" "q-104865" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "5(3{t}^{2}-1)"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/state.json" "file_sha256" "72a4f4389fa4f7d9bc02cd66c0bff65dfb2b3294a95e880f7f48fe02286dbca5" "basis" 1760 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/edb-import/verification.json"} {"question" "q-105173" "field" nil "attribute" "question/problem" "value" "Let $V={R}_{1}[t],$ the vector space of real polynomials of degree at most $1,$ and let the inner product on $V$ be defined as\n\n$$\n⟨p(t),q(t)⟩=p(0)q(0)+p(1)q(1).\n$$\n\nNow consider the following elements of $V:$\n\n$$\n{p}_{1}(t)=5t,\\,{p}_{2}(t)=-2t+2,\\,q(t)=-t-4\n$$\n\nFind the orthogonal projection of $q(t)$ onto $S=\\text{Span}{{p}_{1}(t),{p}_{2}(t)}$ given that ${p}_{1}(t)⊥{p}_{2}(t)$ with respect to the inner product, and that the orthogonal projection of $q(t)$ onto $\\text{Span}{{p}_{1}(t)}$ equals $-5t.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/state.json" "file_sha256" "72a4f4389fa4f7d9bc02cd66c0bff65dfb2b3294a95e880f7f48fe02286dbca5" "basis" 1760 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/edb-import/verification.json"} {"question" "q-105173" "field" nil "attribute" "question/worked-solution" "value" "Since the set ${{p}_{1}(t),{p}_{2}(t)}$ is orthogonal, the orthogonal projection of $q(t)$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,q(t)={\\text{proj}}_{{p}_{1}(t)}\\,q(t)+{\\text{proj}}_{{p}_{2}(t)}\\,q(t).\n$$\n\nWe are given that ${\\text{proj}}_{{p}_{1}(t)}\\,q(t)=-5t,$ so let's now find the orthogonal projection of $q(t)$ onto $\\text{Span}{{p}_{2}(t)}.$ This can be computed as\n\n$$\n{\\text{proj}}_{{p}_{2}(t)}\\,q(t)=\\frac{⟨q(t),{p}_{2}(t)⟩}{⟨{p}_{2}(t),{p}_{2}(t)⟩}\\,{p}_{2}(t).\n$$\n\n \n\nIn our case, we have\n\n$$\n\\begin{aligned}⟨q(t),{p}_{2}(t)⟩ & =q(0){p}_{2}(0)+q(1){p}_{2}(1) \\\\  & =(-t-4){|}_{0}\\cdot (-2t+2){|}_{0}+(-t-4){|}_{1}\\cdot (-2t+2){|}_{1} \\\\  & =(-4)\\cdot 2+(-5)\\cdot 0 \\\\  & =-8,\\end{aligned}\n$$\n\n  \n\nand\n\n$$\n\\begin{aligned}⟨{p}_{2}(t),{p}_{2}(t)⟩ & ={p}_{2}(0){p}_{2}(0)+{p}_{2}(1){p}_{2}(1) \\\\  & =(-2t+2)^{2}{|}_{0}+(-2t+2)^{2}{|}_{1} \\\\  & ={2}^{2}+{0}^{2} \\\\  & =4.\\end{aligned}\n$$\n\n  \n\nTherefore, \n\n$$\n\\begin{aligned}{\\text{proj}}_{{p}_{2}(t)}\\,q(t) & =\\frac{-8}{4}\\cdot (-2t+2)=4t-4.\\end{aligned}\n$$\n\n  \n\nFinally,\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,q(t) & ={\\text{proj}}_{{p}_{1}(t)}\\,q(t)+{\\text{proj}}_{{p}_{2}(t)}\\,q(t) \\\\  & =-5t+(4t-4) \\\\  & =-t-4.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/state.json" "file_sha256" "72a4f4389fa4f7d9bc02cd66c0bff65dfb2b3294a95e880f7f48fe02286dbca5" "basis" 1760 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/edb-import/verification.json"} {"question" "q-105173" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/activity-metadata.json" "file_sha256" "d32d544f64288869856656ab96e293f08c8ae63ea6e9ba333a3d0621c986a343" "basis" 1760 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/edb-import/verification.json"} {"question" "q-105173" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/state.json" "file_sha256" "72a4f4389fa4f7d9bc02cd66c0bff65dfb2b3294a95e880f7f48fe02286dbca5" "basis" 1760 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/edb-import/verification.json"} {"question" "q-105173" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "-4t+1"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/state.json" "file_sha256" "72a4f4389fa4f7d9bc02cd66c0bff65dfb2b3294a95e880f7f48fe02286dbca5" "basis" 1760 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/edb-import/verification.json"} {"question" "q-105173" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "-t-4"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/state.json" "file_sha256" "72a4f4389fa4f7d9bc02cd66c0bff65dfb2b3294a95e880f7f48fe02286dbca5" "basis" 1760 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/edb-import/verification.json"} {"question" "q-105173" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "4t-1"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/state.json" "file_sha256" "72a4f4389fa4f7d9bc02cd66c0bff65dfb2b3294a95e880f7f48fe02286dbca5" "basis" 1760 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/edb-import/verification.json"} {"question" "q-105173" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "t+4"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/state.json" "file_sha256" "72a4f4389fa4f7d9bc02cd66c0bff65dfb2b3294a95e880f7f48fe02286dbca5" "basis" 1760 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/edb-import/verification.json"} {"question" "q-105173" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "t-4"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/state.json" "file_sha256" "72a4f4389fa4f7d9bc02cd66c0bff65dfb2b3294a95e880f7f48fe02286dbca5" "basis" 1760 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/edb-import/verification.json"} {"question" "q-105162" "field" nil "attribute" "question/problem" "value" "Let $V=C[-1,1],$ the vector space of continuous functions over $[-1,1]$, and let the inner product on $V$ be defined as\n\n$$\n⟨x(t),y(t)⟩={\\int }_{-1}^{1}x(t)y(t)\\,\\text{d}t.\n$$\n\nNow consider the following elements of $V:$\n\n$$\n{f}_{1}(t)=t,\\,{f}_{2}(t)={t}^{2},\\,g(t)=\\pi \\operatorname{sin}⁡(\\pi t)\n$$\n\nFind the orthogonal projection of $g(t)$ onto $S=\\text{Span}{{f}_{1}(t),{f}_{2}(t)}$ given that ${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the inner product, and that the orthogonal projection of $g(t)$ onto $\\text{Span}{{f}_{1}(t)}$ equals $3t.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/state.json" "file_sha256" "72a4f4389fa4f7d9bc02cd66c0bff65dfb2b3294a95e880f7f48fe02286dbca5" "basis" 1760 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/edb-import/verification.json"} {"question" "q-105162" "field" nil "attribute" "question/worked-solution" "value" "Since the set ${{f}_{1}(t),{f}_{2}(t)}$ is orthogonal, the orthogonal projection of $g(t)$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,g(t)={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t).\n$$\n\nWe are given that ${\\text{proj}}_{{f}_{1}(t)}\\,g(t)=3t,$ so let's now find the orthogonal projection of $g(t)$ onto $\\text{Span}{{f}_{2}(t)}.$ This can be computed as\n\n$$\n{\\text{proj}}_{{f}_{2}(t)}\\,g(t)=\\frac{⟨g(t),{f}_{2}(t)⟩}{⟨{f}_{2}(t),{f}_{2}(t)⟩}\\,{f}_{2}(t).\n$$\n\n \n\nIn our case, we have\n\n$$\n\\begin{aligned}⟨g(t),{f}_{2}(t)⟩ & ={\\int }_{-1}^{1}g(t){f}_{2}(t)\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}(\\pi \\operatorname{sin}⁡(\\pi t))\\cdot {t}^{2}\\,\\text{d}t \\\\  & =\\pi {\\int }_{-1}^{1}{t}^{2}\\operatorname{sin}⁡(\\pi t)\\,\\text{d}t\\end{aligned}\n$$\n\nNotice that $\\operatorname{sin}⁡(\\pi t)$ is an odd function, while ${t}^{2}$ is even. Hence, their product ${t}^{2}\\operatorname{sin}⁡(\\pi t)$ must be an odd function. Now, since we have an integral over the interval $[-1,1],$ which is symmetric about the origin, we can conclude that\n\n$$\n\\pi {\\int }_{-1}^{1}{t}^{2}\\operatorname{sin}⁡(\\pi t)\\,\\text{d}t=0.\n$$\n\n  \n\nTherefore,\n\n$$\n{\\text{proj}}_{{f}_{2}(t)}\\,g(t)=\\frac{0}{⟨{f}_{2}(t),{f}_{2}(t)⟩}\\cdot {t}^{2}=0.\n$$\n\nFinally,\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,g(t) & ={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t) \\\\  & =3t+0 \\\\  & =3t.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/state.json" "file_sha256" "72a4f4389fa4f7d9bc02cd66c0bff65dfb2b3294a95e880f7f48fe02286dbca5" "basis" 1760 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/edb-import/verification.json"} {"question" "q-105162" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050792/activity-metadata.json" "file_sha256" "d32d544f64288869856656ab96e293f08c8ae63ea6e9ba333a3d0621c986a343" "basis" 1760 "verification" "/home/jake/Developer/Course_Academy/refe