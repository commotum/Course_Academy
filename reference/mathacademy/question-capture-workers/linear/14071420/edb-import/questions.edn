#{[{:db/id #edb/ref 17592186309352 :knowledge-point/_questions [{:knowledge-point/id #uuid "1cae73a3-842e-5a1a-8774-35bba342845c" :knowledge-point/title "Finding the Orthogonal Projection of a Vector Onto a Subspace Spanned by Orthogonal Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7fabdb13-e63a-5fac-8f0e-2adcc3b7c99b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 \\\\ 1 \\\\ 0 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186309354} {:answer/id #uuid "1882b753-ce87-5e1f-8c49-7f1045517fd6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 \\\\ 3 \\\\ -1 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186309355} {:answer/id #uuid "2a7904f4-5641-5eb7-b15f-974967f3dae0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 \\\\ -1 \\\\ 3 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186309356} {:answer/id #uuid "2d736ac1-be96-5ff9-bd70-b9b2ec0445a2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 \\\\ -1 \\\\ 2 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186309357}] :answer-field/correct {:answer/id #uuid "1882b753-ce87-5e1f-8c49-7f1045517fd6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 \\\\ 3 \\\\ -1 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186309355} :answer-field/id #uuid "3111bcd7-e673-5843-b524-72001f890ad2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186309353}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5d784c99-ccfa-5cf1-aee8-af8e0a39bd18" :question/math-academy-id "q-140120" :question/problem "Consider the vector $x$ and the subspace $S=\\text{Span}{{a}_{1},{a}_{2},{a}_{3}},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ -1 \\\\ 1 \\\\ 0\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}1 \\\\ 1 \\\\ 0 \\\\ 2\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}-3 \\\\ -1 \\\\ 2 \\\\ 2\\end{aligned}],\\,\\,x=[\\begin{aligned}7 \\\\ 3 \\\\ -1 \\\\ 4\\end{aligned}].\n$$\n\nFind the orthogonal projection of $x$ onto the subspace $S$ given that the set ${{a}_{1},{a}_{2},{a}_{3}}$ is orthogonal." :question/worked-solution "Since the set ${{a}_{1},{a}_{2},{a}_{3}}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+{\\text{proj}}_{{a}_{3}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}},$ $\\text{Span}{{a}_{2}},$ and $\\text{Span}{{a}_{3}}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{7\\cdot 1+3\\cdot (-1)+(-1)\\cdot 1+4\\cdot 0}{{1}^{2}+(-1)^{2}+{1}^{2}+{0}^{2}}{a}_{1}=[\\begin{aligned}1 \\\\ -1 \\\\ 1 \\\\ 0\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{7\\cdot 1+3\\cdot 1+(-1)\\cdot 0+4\\cdot 2}{{1}^{2}+{1}^{2}+{0}^{2}+{2}^{2}}{a}_{2}=3[\\begin{aligned}1 \\\\ 1 \\\\ 0 \\\\ 2\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{3}}x & =\\frac{x\\cdot {a}_{3}}{{a}_{3}\\cdot {a}_{3}}{a}_{3}=\\frac{7\\cdot (-3)+3\\cdot (-1)+(-1)\\cdot 2+4\\cdot 2}{(-3)^{2}+(-1)^{2}+{2}^{2}+{2}^{2}}{a}_{2}=-[\\begin{aligned}-3 \\\\ -1 \\\\ 2 \\\\ 2\\end{aligned}]\\end{aligned}\n$$\n\n  \n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+{\\text{proj}}_{{a}_{3}}x \\\\  & =[\\begin{aligned}1 \\\\ -1 \\\\ 1 \\\\ 0\\end{aligned}]+3[\\begin{aligned}1 \\\\ 1 \\\\ 0 \\\\ 2\\end{aligned}]+(-1)[\\begin{aligned}-3 \\\\ -1 \\\\ 2 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ -1 \\\\ 1 \\\\ 0\\end{aligned}]+[\\begin{aligned}3 \\\\ 3 \\\\ 0 \\\\ 6\\end{aligned}]+[\\begin{aligned}3 \\\\ 1 \\\\ -2 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}7 \\\\ 3 \\\\ -1 \\\\ 4\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338646 :knowledge-point/_questions [{:knowledge-point/id #uuid "acb4bd03-9b89-5775-a700-e1f3ea9fa62e" :knowledge-point/title "Finding the Orthogonal Projection of a Vector Onto a Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c6af211d-3e87-53dd-b488-022c6dffb945" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{1}{2} \\\\ \\frac{3}{2} \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186338648} {:answer/id #uuid "58fe3b20-37cc-5459-8e68-e0f8bada6c7a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{3}{2} \\\\ \\frac{1}{2} \\\\ \\frac{1}{2}\\end{aligned}]" :db/id #edb/ref 17592186338649} {:answer/id #uuid "a0df0db0-5196-5162-affa-2a7891657598" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 \\\\ \\frac{1}{2} \\\\ \\frac{3}{2}\\end{aligned}]" :db/id #edb/ref 17592186338650} {:answer/id #uuid "91332da9-8eb3-52d6-b0ba-d483aef5752b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{3}{2} \\\\ 1 \\\\ \\frac{1}{2}\\end{aligned}]" :db/id #edb/ref 17592186338651} {:answer/id #uuid "055f97e4-6816-5c37-bc46-83691b86f1aa" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{1}{2} \\\\ \\frac{1}{2} \\\\ \\frac{3}{2}\\end{aligned}]" :db/id #edb/ref 17592186338652}] :answer-field/correct {:answer/id #uuid "c6af211d-3e87-53dd-b488-022c6dffb945" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{1}{2} \\\\ \\frac{3}{2} \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186338648} :answer-field/id #uuid "7ad82d57-2701-59ec-99a6-bdd8f6f370e1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338647}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "2862936f-332b-550b-8128-3ebb5c231f35" :question/math-academy-id "q-140363" :question/problem "Consider the vector $x$ and the plane $r=sv+tw,$ where $s,t\\in R,$ and\n\n$$\nv=[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}],\\,w=[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}],\\,\\,x=[\\begin{aligned}0 \\\\ 1 \\\\ 2\\end{aligned}].\n$$\n\nFind the orthogonal projection of $x$ onto the plane given that $v⊥w.$" :question/worked-solution "Since our plane passes through the origin, it defines the subspace $S=\\text{Span}{v,w}$ in ${R}^{3}.$ \nAnd, since the set ${v,w}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}}$ and $\\text{Span}{{a}_{2}}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{v}\\,x & =\\frac{x\\cdot v}{v\\cdot v}v=\\frac{0\\cdot 1+1\\cdot 1+2\\cdot 0}{{1}^{2}+{1}^{2}+{0}^{2}}v=\\frac{1}{2}[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}] \\\\ {\\text{proj}}_{w}\\,x & =\\frac{x\\cdot w}{w\\cdot w}w=\\frac{0\\cdot (-1)+1\\cdot 1+2\\cdot 1}{(-1)^{2}+{1}^{2}+{1}^{2}}w=[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x \\\\  & =\\frac{1}{2}[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]+[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}] \\\\  & =\\frac{1}{2}([\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]+2[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}]) \\\\  & =[\\begin{aligned}-\\frac{1}{2} \\\\ \\frac{3}{2} \\\\ 1\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186309435 :knowledge-point/_questions [{:knowledge-point/id #uuid "8eb07a32-45bd-5975-9f61-de6294d4895d" :knowledge-point/title "Calculating the Distance Between a Vector and a Subspace Spanned by Orthogonal Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6183140a-d0a3-5b16-8b62-1a715d7809d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{19}}{2}" :db/id #edb/ref 17592186309437} {:answer/id #uuid "b84767b2-7d1c-5acc-93ff-e375f0d23667" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{19}" :db/id #edb/ref 17592186309438} {:answer/id #uuid "d46e783b-a683-56c1-9d65-90f734b8ff25" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{19}}{4}" :db/id #edb/ref 17592186309439} {:answer/id #uuid "fc9cb25b-354c-5882-8cd0-e89b0639dcf0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{38}}{2}" :db/id #edb/ref 17592186309440} {:answer/id #uuid "cebb530e-4393-5181-a745-65b4bff1d4c1" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{38}" :db/id #edb/ref 17592186309441}] :answer-field/correct {:answer/id #uuid "6183140a-d0a3-5b16-8b62-1a715d7809d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{19}}{2}" :db/id #edb/ref 17592186309437} :answer-field/id #uuid "66ecc4bc-3bae-5db7-844a-545d6b3b3505" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186309436}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "4d063e51-f567-59de-8718-4d9cf3ca1740" :question/math-academy-id "q-82914" :question/problem "Consider the vector $x$ and the subspace $S=\\text{Span}{{a}_{1},{a}_{2}}$ where\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}2 \\\\ -1 \\\\ -2 \\\\ 1\\end{aligned}],\\,\\,x=[\\begin{aligned}2 \\\\ 1 \\\\ -3 \\\\ 1\\end{aligned}].\n$$\n\nFind the distance between $x$ and the subspace $S$ given that the set ${{a}_{1},{a}_{2}}$ is orthogonal." :question/worked-solution "Since the set ${{a}_{1},{a}_{2}}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}}$ and $\\text{Span}{{a}_{2}}:$ \n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{2\\cdot 1+1\\cdot 1+(-3)\\cdot 1+1\\cdot 1}{{1}^{2}+{1}^{2}+{1}^{2}+{1}^{2}}{a}_{1}=\\frac{1}{4}[\\begin{aligned}1 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{2\\cdot 2+1\\cdot (-1)+(-3)\\cdot (-2)+1\\cdot 1}{{2}^{2}+(-1)^{2}+(-2)^{2}+{1}^{2}}{a}_{2}=[\\begin{aligned}2 \\\\ -1 \\\\ -2 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x \\\\  & =\\frac{1}{4}[\\begin{aligned}1 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}]+[\\begin{aligned}2 \\\\ -1 \\\\ -2 \\\\ 1\\end{aligned}] \\\\  & =\\frac{1}{4}([\\begin{aligned}1 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}]+[\\begin{aligned}8 \\\\ -4 \\\\ -8 \\\\ 4\\end{aligned}]) \\\\  & =\\frac{1}{4}[\\begin{aligned}9 \\\\ -3 \\\\ -7 \\\\ 5\\end{aligned}]=\\overset{^}{x}.\\end{aligned}\n$$\n\nFinally, the distance between $x$ and the subspace $S$ is given by\n\n$$\n\\begin{aligned}d(x,\\overset{^}{x}) & =‖x-\\overset{^}{x}‖ \\\\  & =\\sqrt{({x}_{1}-{\\overset{^}{x}}_{1})^{2}+({x}_{2}-{\\overset{^}{x}}_{2})^{2}+({x}_{3}-{\\overset{^}{x}}_{3})^{2}+({x}_{4}-{\\overset{^}{x}}_{4})^{2}} \\\\  & =\\sqrt{{(2-\\frac{9}{4})}^{2}+{(1-(-\\frac{3}{4}))}^{2}+{(-3-(-\\frac{7}{4}))}^{2}+{(1-\\frac{5}{4})}^{2}} \\\\  & =\\sqrt{\\frac{1}{16}+\\frac{49}{16}+\\frac{25}{16}+\\frac{1}{16}} \\\\  & =\\sqrt{\\frac{76}{16}} \\\\  & =\\frac{\\sqrt{19}}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338667 :knowledge-point/_questions [{:knowledge-point/id #uuid "c93bf305-85ff-5455-91ba-ae60f3c1989d" :knowledge-point/title "Calculating the Acute Angle Between a Vector and a Subspace Spanned by Orthogonal Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8675bade-c9b3-540c-8993-c449bab62fe0" :answer/type {:db/ident :answer.type/math} :answer/value "{56.22}^{∘}" :db/id #edb/ref 17592186338669} {:answer/id #uuid "d3a97856-161b-5d66-a844-2612a84fb2a2" :answer/type {:db/ident :answer.type/math} :answer/value "{40.20}^{∘}" :db/id #edb/ref 17592186338670} {:answer/id #uuid "f12df48f-8f42-5a91-8986-8bfed328c137" :answer/type {:db/ident :answer.type/math} :answer/value "{49.11}^{∘}" :db/id #edb/ref 17592186338671} {:answer/id #uuid "0850cc70-58a2-5c21-9a64-de3ae376772d" :answer/type {:db/ident :answer.type/math} :answer/value "{23.58}^{∘}" :db/id #edb/ref 17592186338672} {:answer/id #uuid "56ebd5e9-809f-51c9-aa09-071080265ca8" :answer/type {:db/ident :answer.type/math} :answer/value "{37.33}^{∘}" :db/id #edb/ref 17592186338673}] :answer-field/correct {:answer/id #uuid "f12df48f-8f42-5a91-8986-8bfed328c137" :answer/type {:db/ident :answer.type/math} :answer/value "{49.11}^{∘}" :db/id #edb/ref 17592186338671} :answer-field/id #uuid "39a0d3e0-d366-5154-9582-ba12b2b89791" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338668}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "8b05316e-d9ed-54ce-819d-249152d92fa4" :question/math-academy-id "q-82952" :question/problem "Consider the vector $x$ and the subspace $S=\\text{Span}{{a}_{1},{a}_{2}}$ where\n\n$$\n{a}_{1}=[\\begin{aligned}3 \\\\ 0 \\\\ -2 \\\\ 1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}2 \\\\ 1 \\\\ 2 \\\\ -2\\end{aligned}],\\,\\,x=[\\begin{aligned}5 \\\\ 5 \\\\ 2 \\\\ 3\\end{aligned}].\n$$\n\nFind the acute angle between $x$ and the subspace $S$ given that the set ${{a}_{1},{a}_{2}}$ is orthogonal." :question/worked-solution "Since the set ${{a}_{1},{a}_{2}}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}}$ and $\\text{Span}{{a}_{2}}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{5\\cdot 3+5\\cdot 0+2\\cdot (-2)+3\\cdot 1}{{3}^{2}+{0}^{2}+(-2)^{2}+{1}^{2}}{a}_{1}=[\\begin{aligned}3 \\\\ 0 \\\\ -2 \\\\ 1\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{5\\cdot 2+5\\cdot 1+2\\cdot 2+3\\cdot (-2)}{{2}^{2}+{1}^{2}+{2}^{2}+(-2)^{2}}{a}_{2}=[\\begin{aligned}2 \\\\ 1 \\\\ 2 \\\\ -2\\end{aligned}]\\end{aligned}\n$$\n\n \n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x \\\\  & =[\\begin{aligned}3 \\\\ 0 \\\\ -2 \\\\ 1\\end{aligned}]+[\\begin{aligned}2 \\\\ 1 \\\\ 2 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}5 \\\\ 1 \\\\ 0 \\\\ -1\\end{aligned}].\\end{aligned}\n$$\n\n \n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x$ or any other non-zero vector that is parallel to ${\\text{proj}}_{S}x.$ \n\nComputing the cosine using the dot product, we obtain \n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{x\\cdot {\\text{proj}}_{S}\\,x}{‖x‖\\,‖{\\text{proj}}_{S}\\,x‖} \\\\  & =\\frac{5\\cdot 5+5\\cdot 1+2\\cdot 0+3\\cdot (-1)}{\\sqrt{{5}^{2}+{5}^{2}+{2}^{2}+{3}^{2}}\\sqrt{{5}^{2}+{1}^{2}+{0}^{2}+(-1)^{2}}} \\\\  & =\\frac{27}{\\sqrt{63}\\sqrt{27}} \\\\  & =\\frac{27}{3\\sqrt{7}\\cdot 3\\sqrt{3}} \\\\  & =\\frac{\\sqrt{21}}{7}.\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{\\sqrt{21}}{7})≈{49.11}^{∘},\n$$\n\nwhich is already an acute angle."}]}
