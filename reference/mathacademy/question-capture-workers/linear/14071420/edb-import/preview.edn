] \\\\  & =[\\begin{aligned}5 \\\\ 10 \\\\ -7\\end{aligned}].\\end{aligned}\n$$" 13194139535863 true] [17592186371122 1000 #edb/ref 17592186371123 13194139535863 true] [17592186371122 1000 #edb/ref 17592186371124 13194139535863 true] [17592186371122 1000 #edb/ref 17592186371125 13194139535863 true] [17592186371122 1000 #edb/ref 17592186371126 13194139535863 true] [17592186371122 1000 #edb/ref 17592186371127 13194139535863 true] [17592186371122 1040 #edb/ref 17592186045450 13194139535863 true] [17592186371122 1041 "selection" 13194139535863 true] [17592186371122 1104 #edb/ref 17592186371126 13194139535863 true] [17592186371122 1110 #uuid "535f9c27-081c-51bc-b3a7-d639bdb5e1e5" 13194139535863 true] [17592186371123 1034 "[\\begin{aligned}5 \\\\ 3 \\\\ -2\\end{aligned}]" 13194139535863 true] [17592186371123 1103 #edb/ref 17592186045453 13194139535863 true] [17592186371123 1111 #uuid "639dd7db-a874-54db-8b28-e018d8685f19" 13194139535863 true] [17592186371124 1034 "[\\begin{aligned}3 \\\\ 9 \\\\ -7\\end{aligned}]" 13194139535863 true] [17592186371124 1103 #edb/ref 17592186045453 13194139535863 true] [17592186371124 1111 #uuid "8e5426be-02ed-5894-8c79-a550bcc36071" 13194139535863 true] [17592186371125 1034 "[\\begin{aligned}5 \\\\ 6 \\\\ -2\\end{aligned}]" 13194139535863 true] [17592186371125 1103 #edb/ref 17592186045453 13194139535863 true] [17592186371125 1111 #uuid "51e99ae2-e627-546c-a495-5289906e5285" 13194139535863 true] [17592186371126 1034 "[\\begin{aligned}5 \\\\ 10 \\\\ -7\\end{aligned}]" 13194139535863 true] [17592186371126 1103 #edb/ref 17592186045453 13194139535863 true] [17592186371126 1111 #uuid "415186a7-3a45-516c-9286-ff516885451a" 13194139535863 true] [17592186371127 1034 "[\\begin{aligned}4 \\\\ 10 \\\\ -5\\end{aligned}]" 13194139535863 true] [17592186371127 1103 #edb/ref 17592186045453 13194139535863 true] [17592186371127 1111 #uuid "00f989ad-59c6-50b2-bbb9-91f3995639cb" 13194139535863 true]] :edb/tempids {"q-140359" 17592186371121 "q-140359/selection" 1