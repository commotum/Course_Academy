#{[{:db/id #edb/ref 17592186338646 :knowledge-point/_questions [{:knowledge-point/id #uuid "acb4bd03-9b89-5775-a700-e1f3ea9fa62e" :knowledge-point/title "Finding the Orthogonal Projection of a Vector Onto a Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c6af211d-3e87-53dd-b488-022c6dffb945" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{1}{2} \\\\ \\frac{3}{2} \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186338648} {:answer/id #uuid "58fe3b20-37cc-5459-8e68-e0f8bada6c7a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{3}{2} \\\\ \\frac{1}{2} \\\\ \\frac{1}{2}\\end{aligned}]" :db/id #edb/ref 17592186338649} {:answer/id #uuid "a0df0db0-5196-5162-affa-2a7891657598" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 \\\\ \\frac{1}{2} \\\\ \\frac{3}{2}\\end{aligned}]" :db/id #edb/ref 17592186338650} {:answer/id #uuid "91332da9-8eb3-52d6-b0ba-d483aef5752b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{3}{2} \\\\ 1 \\\\ \\frac{1}{2}\\end{aligned}]" :db/id #edb/ref 17592186338651} {:answer/id #uuid "055f97e4-6816-5c37-bc46-83691b86f1aa" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{1}{2} \\\\ \\frac{1}{2} \\\\ \\frac{3}{2}\\end{aligned}]" :db/id #edb/ref 17592186338652}] :answer-field/correct {:answer/id #uuid "c6af211d-3e87-53dd-b488-022c6dffb945" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{1}{2} \\\\ \\frac{3}{2} \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186338648} :answer-field/id #uuid "7ad82d57-2701-59ec-99a6-bdd8f6f370e1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338647}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "2862936f-332b-550b-8128-3ebb5c231f35" :question/math-academy-id "q-140363" :question/problem "Consider the vector $x$ and the plane $r=sv+tw,$ where $s,t\\in R,$ and\n\n$$\nv=[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}],\\,w=[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}],\\,\\,x=[\\begin{aligned}0 \\\\ 1 \\\\ 2\\end{aligned}].\n$$\n\nFind the orthogonal projection of $x$ onto the plane given that $v⊥w.$" :question/worked-solution "Since our plane passes through the origin, it defines the subspace $S=\\text{Span}{v,w}$ in ${R}^{3}.$ \nAnd, since the set ${v,w}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}}$ and $\\text{Span}{{a}_{2}}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{v}\\,x & =\\frac{x\\cdot v}{v\\cdot v}v=\\frac{0\\cdot 1+1\\cdot 1+2\\cdot 0}{{1}^{2}+{1}^{2}+{0}^{2}}v=\\frac{1}{2}[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}] \\\\ {\\text{proj}}_{w}\\,x & =\\frac{x\\cdot w}{w\\cdot w}w=\\frac{0\\cdot (-1)+1\\cdot 1+2\\cdot 1}{(-1)^{2}+{1}^{2}+{1}^{2}}w=[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x \\\\  & =\\frac{1}{2}[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]+[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}] \\\\  & =\\frac{1}{2}([\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]+2[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}]) \\\\  & =[\\begin{aligned}-\\frac{1}{2} \\\\ \\frac{3}{2} \\\\ 1\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338667 :knowledge-point/_questions [{:knowledge-point/id #uuid "c93bf305-85ff-5455-91ba-ae60f3c1989d" :knowledge-point/title "Calculating the Acute Angle Between a Vector and a Subspace Spanned by Orthogonal Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8675bade-c9b3-540c-8993-c449bab62fe0" :answer/type {:db/ident :answer.type/math} :answer/value "{56.22}^{∘}" :db/id #edb/ref 17592186338669} {:answer/id #uuid "d3a97856-161b-5d66-a844-2612a84fb2a2" :answer/type {:db/ident :answer.type/math} :answer/value "{40.20}^{∘}" :db/id #edb/ref 17592186338670} {:answer/id #uuid "f12df48f-8f42-5a91-8986-8bfed328c137" :answer/type {:db/ident :answer.type/math} :answer/value "{49.11}^{∘}" :db/id #edb/ref 17592186338671} {:answer/id #uuid "0850cc70-58a2-5c21-9a64-de3ae376772d" :answer/type {:db/ident :answer.type/math} :answer/value "{23.58}^{∘}" :db/id #edb/ref 17592186338672} {:answer/id #uuid "56ebd5e9-809f-51c9-aa09-071080265ca8" :answer/type {:db/ident :answer.type/math} :answer/value "{37.33}^{∘}" :db/id #edb/ref 17592186338673}] :answer-field/correct {:answer/id #uuid "f12df48f-8f42-5a91-8986-8bfed328c137" :answer/type {:db/ident :answer.type/math} :answer/value "{49.11}^{∘}" :db/id #edb/ref 17592186338671} :answer-field/id #uuid "39a0d3e0-d366-5154-9582-ba12b2b89791" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338668}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "8b05316e-d9ed-54ce-819d-249152d92fa4" :question/math-academy-id "q-82952" :question/problem "Consider the vector $x$ and the subspace $S=\\text{Span}{{a}_{1},{a}_{2}}$ where\n\n$$\n{a}_{1}=[\\begin{aligned}3 \\\\ 0 \\\\ -2 \\\\ 1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}2 \\\\ 1 \\\\ 2 \\\\ -2\\end{aligned}],\\,\\,x=[\\begin{aligned}5 \\\\ 5 \\\\ 2 \\\\ 3\\end{aligned}].\n$$\n\nFind the acute angle between $x$ and the subspace $S$ given that the set ${{a}_{1},{a}_{2}}$ is orthogonal." :question/worked-solution "Since the set ${{a}_{1},{a}_{2}}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}}$ and $\\text{Span}{{a}_{2}}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{5\\cdot 3+5\\cdot 0+2\\cdot (-2)+3\\cdot 1}{{3}^{2}+{0}^{2}+(-2)^{2}+{1}^{2}}{a}_{1}=[\\begin{aligned}3 \\\\ 0 \\\\ -2 \\\\ 1\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{5\\cdot 2+5\\cdot 1+2\\cdot 2+3\\cdot (-2)}{{2}^{2}+{1}^{2}+{2}^{2}+(-2)^{2}}{a}_{2}=[\\begin{aligned}2 \\\\ 1 \\\\ 2 \\\\ -2\\end{aligned}]\\end{aligned}\n$$\n\n \n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x \\\\  & =[\\begin{aligned}3 \\\\ 0 \\\\ -2 \\\\ 1\\end{aligned}]+[\\begin{aligned}2 \\\\ 1 \\\\ 2 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}5 \\\\ 1 \\\\ 0 \\\\ -1\\end{aligned}].\\end{aligned}\n$$\n\n \n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x$ or any other non-zero vector that is parallel to ${\\text{proj}}_{S}x.$ \n\nComputing the cosine using the dot product, we obtain \n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{x\\cdot {\\text{proj}}_{S}\\,x}{‖x‖\\,‖{\\text{proj}}_{S}\\,x‖} \\\\  & =\\frac{5\\cdot 5+5\\cdot 1+2\\cdot 0+3\\cdot (-1)}{\\sqrt{{5}^{2}+{5}^{2}+{2}^{2}+{3}^{2}}\\sqrt{{5}^{2}+{1}^{2}+{0}^{2}+(-1)^{2}}} \\\\  & =\\frac{27}{\\sqrt{63}\\sqrt{27}} \\\\  & =\\frac{27}{3\\sqrt{7}\\cdot 3\\sqrt{3}} \\\\  & =\\frac{\\sqrt{21}}{7}.\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{\\sqrt{21}}{7})≈{49.11}^{∘},\n$$\n\nwhich is already an acute angle."}]}
