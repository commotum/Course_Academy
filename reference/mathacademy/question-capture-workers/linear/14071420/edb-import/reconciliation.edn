aligned}]"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059805/state.json" "file_sha256" "84fde27b1a00a1294e05039b91d97dabd7d2c4c9c595263f4404be9a9a9ee789" "basis" 1915 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059805/edb-import/verification.json"} {"question" "q-140363" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}-\\frac{3}{2} \\\\ 1 \\\\ \\frac{1}{2}\\end{aligned}]"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059805/state.json" "file_sha256" "84fde27b1a00a1294e05039b91d97dabd7d2c4c9c595263f4404be9a9a9ee789" "basis" 1915 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059805/edb-import/verification.json"} {"question" "q-140363" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}-\\frac{3}{2} \\\\ \\frac{1}{2} \\\\ \\frac{1}{2}\\end{aligned}]"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059805/state.json" "file_sha256" "84fde27b1a00a1294e05039b91d97dabd7d2c4c9c595263f4404be9a9a9ee789" "basis" 1915 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059805/edb-import/verification.json"} {"question" "q-140363" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}-\\frac{1}{2} \\\\ \\frac{3}{2} \\\\ 1\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059805/state.json" "file_sha256" "84fde27b1a00a1294e05039b91d97dabd7d2c4c9c595263f4404be9a9a9ee789" "basis" 1915 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059805/edb-import/verification.json"}] "sources" [{"question" "q-82914" "field" nil "attribute" "question/problem" "value" "Consider the vector $x$ and the subspace $S=\\text{Span}{{a}_{1},{a}_{2}}$ where\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}2 \\\\ -1 \\\\ -2 \\\\ 1\\end{aligned}],\\,\\,x=[\\begin{aligned}2 \\\\ 1 \\\\ -3 \\\\ 1\\end{aligned}].\n$$\n\nFind the distance between $x$ and the subspace $S$ given that the set ${{a}_{1},{a}_{2}}$ is orthogonal." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071420/state.json" "file_sha256" "5710e57af2fb0a2c2ec90ccf64318176bec2702ee0ec021dfe83614b0f657446"} {"question" "q-82914" "field" nil "attribute" "question/worked-solution" "value" "Since the set ${{a}_{1},{a}_{2}}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}}$ and $\\text{Span}{{a}_{2}}:$ \n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{2\\cdot 1+1\\cdot 1+(-3)\\cdot 1+1\\cdot 1}{{1}^{2}+{1}^{2}+{1}^{2}+{1}^{2}}{a}_{1}=\\frac{1}{4}[\\begin{aligned}1 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{2\\cdot 2+1\\cdot (-1)+(-3)\\cdot (-2)+1\\cdot 1}{{2}^{2}+(-1)^{2}+(-2)^{2}+{1}^{2}}{a}_{2}=[\\begin{aligned}2 \\\\ -1 \\\\ -2 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x \\\\  & =\\frac{1}{4}[\\begin{aligned}1 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}]+[\\begin{aligned}2 \\\\ -1 \\\\ -2 \\\\ 1\\end{aligned}] \\\\  & =\\frac{1}{4}([\\begin{aligned}1 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}]+[\\begin{aligned}8 \\\\ -4 \\\\ -8 \\\\ 4\\end{aligned}]) \\\\  & =\\frac{1}{4}[\\begin{aligned}9 \\\\ -3 \\\\ -7 \\\\ 5\\end{aligned}]=\\overset{^}{x}.\\end{aligned}\n$$\n\nFinally, the distance between $x$ and the subspace $S$ is given by\n\n$$\n\\begin{aligned}d(x,\\overset{^}{x}) & =‖x-\\overset{^}{x}‖ \\\\  & =\\sqrt{({x}_{1}-{\\overset{^}{x}}_{1})^{2}+({x}_{2}-{\\overset{^}{x}}_{2})^{2}+({x}_{3}-{\\overset{^}{x}}_{3})^{2}+({x}_{4}-{\\overset{^}{x}}_{4})^{2}} \\\\  & =\\sqrt{{(2-\\frac{9}{4})}^{2}+{(1-(-\\frac{3}{4}))}^{2}+{(-3-(-\\frac{7}{4}))}^{2}+{(1-\\frac{5}{4})}^{2}} \\\\  & =\\sqrt{\\frac{1}{16}+\\frac{49}{16}+\\frac{25}{16}+\\frac{1}{16}} \\\\  & =\\sqrt{\\frac{76}{16}} \\\\  & =\\frac{\\sqrt{19}}{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071420/state.json" "file_sha256" "5710e57af2fb0a2c2ec90ccf64318176bec2702ee0ec021dfe83614b0f657446"} {"question" "q-82914" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071420/activity-metadata.json" "file_sha256" "04f2dfb6996b584fe7bc927f8676ec50dbafb65e4b1d80058a34ba8a7ec07dec"} {"question" "q-82914" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071420/state.json" "file_sha256" "5710e57af2fb0a2c2ec90ccf64318176bec2702ee0ec021dfe83614b0f657446"} {"question" "q-82914" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2\\sqrt{19}"] ["math" "\\frac{\\sqrt{19}}{2}"] ["math" "\\frac{\\sqrt{19}}{4}"] ["math" "\\frac{\\sqrt{38}}{2}"] ["math" "\\sqrt{38}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071420/state.json" "file_sha256" "5710e57af2fb0a2c2ec90ccf64318176bec2702ee0ec021dfe83614b0f657446"} {"question" "q-82914" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{\\sqrt{19}}{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071420/state.json" "file_sha256" "5710e57af2fb0a2c2ec90ccf64318176bec2702ee0ec021dfe83614b0f657446"} {"question" "q-82952" "field" nil "attribute" "question/problem" "value" "Consider the vector $x$ and the subspace $S=\\text{Span}{{a}_{1},{a}_{2}}$ where\n\n$$\n{a}_{1}=[\\begin{aligned}3 \\\\ 0 \\\\ -2 \\\\ 1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}2 \\\\ 1 \\\\ 2 \\\\ -2\\end{aligned}],\\,\\,x=[\\begin{aligned}5 \\\\ 5 \\\\ 2 \\\\ 3\\end{aligned}].\n$$\n\nFind the acute angle between $x$ and the subspace $S$ given that the set ${{a}_{1},{a}_{2}}$ is orthogonal." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071420/state.json" "file_sha256" "5710e57af2fb0a2c2ec90ccf64318176bec2702ee0ec021dfe83614b0f657446"} {"question" "q-82952" "field" nil "attribute" "question/worked-solution" "value" "Since the set ${{a}_{1},{a}_{2}}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}}$ and $\\text{Span}{{a}_{2}}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{5\\cdot 3+5\\cdot 0+2\\cdot (-2)+3\\cdot 1}{{3}^{2}+{0}^{2}+(-2)^{2}+{1}^{2}}{a}_{1}=[\\begin{aligned}3 \\\\ 0 \\\\ -2 \\\\ 1\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{5\\cdot 2+5\\cdot 1+2\\cdot 2+3\\cdot (-2)}{{2}^{2}+{1}^{2}+{2}^{2}+(-2)^{2}}{a}_{2}=[\\begin{aligned}2 \\\\ 1 \\\\ 2 \\\\ -2\\end{aligned}]\\end{aligned}\n$$\n\n \n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x \\\\  & =[\\begin{aligned}3 \\\\ 0 \\\\ -2 \\\\ 1\\end{aligned}]+[\\begin{aligned}2 \\\\ 1 \\\\ 2 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}5 \\\\ 1 \\\\ 0 \\\\ -1\\end{aligned}].\\end{aligned}\n$$\n\n \n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x$ or any other non-zero vector that is parallel to ${\\text{proj}}_{S}x.$ \n\nComputing the cosine using the dot product, we obtain \n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{x\\cdot {\\text{proj}}_{S}\\,x}{‖x‖\\,‖{\\text{proj}}_{S}\\,x‖} \\\\  & =\\frac{5\\cdot 5+5\\cdot 1+2\\cdot 0+3\\cdot (-1)}{\\sqrt{{5}^{2}+{5}^{2}+{2}^{2}+{3}^{2}}\\sqrt{{5}^{2}+{1}^{2}+{0}^{2}+(-1)^{2}}} \\\\  & =\\frac{27}{\\sqrt{63}\\sqrt{27}} \\\\  & =\\frac{27}{3\\sqrt{7}\\cdot 3\\sqrt{3}} \\\\  & =\\frac{\\sqrt{21}}{7}.\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{\\sqrt{21}}{7})≈{49.11}^{∘},\n$$\n\nwhich is already an acute angle." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071420/state.json" "file_sha256" "5710e57af2fb0a2c2ec90ccf64318176bec2702ee0ec021dfe83614b0f657446"} {"question" "q-82952" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071420/activity-metadata.json" "file_sha256" "04f2dfb6996b584fe7bc927f8676ec50dbafb65e4b1d80058a34ba8a7ec07dec"} {"question" "q-82952" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071420/state.json" "file_sha256" "5710e57af2fb0a2c2ec90ccf64318176bec2702ee0ec021dfe83614b0f657446"} {"question" "q-82952" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{23.58}^{∘}"] ["math" "{37.33}^{∘}"] ["math" "{40.20}^{∘}"] ["math" "{49.11}^{∘}"] ["math" "{56.22}^{∘}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071420/state.json" "file_sha256" "5710e57af2fb0a2c2ec90ccf64318176bec2702ee0ec021dfe83614b0f657446"} {"question" "q-82952" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{49.11}^{∘}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071420/state.json" "file_sha256" "5710e57af2fb0a2c2ec90ccf64318176bec2702ee0ec021dfe83614b0f657446"} {"question" "q-140120" "field" nil "attribute" "question/problem" "value" "Consider the vector $x$ and the subspace $S=\\text{Span}{{a}_{1},{a}_{2},{a}_{3}},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ -1 \\\\ 1 \\\\ 0\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}1 \\\\ 1 \\\\ 0 \\\\ 2\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}-3 \\\\ -1 \\\\ 2 \\\\ 2\\end{aligned}],\\,\\,x=[\\begin{aligned}7 \\\\ 3 \\\\ -1 \\\\ 4\\end{aligned}].\n$$\n\nFind the orthogonal projection of $x$ onto the subspace $S$ given that the set ${{a}_{1},{a}_{2},{a}_{3}}$ is orthogonal." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071420/state.json" "file_sha256" "5710e57af2fb0a2c2ec90ccf64318176bec2702ee0ec021dfe83614b0f657446"} {"question" "q-140120" "field" nil "attribute" "question/worked-solution" "value" "Since the set ${{a}_{1},{a}_{2},{a}_{3}}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+{\\text{proj}}_{{a}_{3}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}},$ $\\text{Span}{{a}_{2}},$ and $\\text{Span}{{a}_{3}}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{7\\cdot 1+3\\cdot (-1)+(-1)\\cdot 1+4\\cdot 0}{{1}^{2}+(-1)^{2}+{1}^{2}+{0}^{2}}{a}_{1}=[\\begin{aligned}1 \\\\ -1 \\\\ 1 \\\\ 0\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{7\\cdot 1+3\\cdot 1+(-1)\\cdot 0+4\\cdot 2}{{1}^{2}+{1}^{2}+{0}^{2}+{2}^{2}}{a}_{2}=3[\\begin{aligned}1 \\\\ 1 \\\\ 0 \\\\ 2\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{3}}x & =\\frac{x\\cdot {a}_{3}}{{a}_{3}\\cdot {a}_{3}}{a}_{3}=\\frac{7\\cdot (-3)+3\\cdot (-1)+(-1)\\cdot 2+4\\cdot 2}{(-3)^{2}+(-1)^{2}+{2}^{2}+{2}^{2}}{a}_{2}=-[\\begin{aligned}-3 \\\\ -1 \\\\ 2 \\\\ 2\\end{aligned}]\\end{aligned}\n$$\n\n  \n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+{\\text{proj}}_{{a}_{3}}x \\\\  & =[\\begin{aligned}1 \\\\ -1 \\\\ 1 \\\\ 0\\end{aligned}]+3[\\begin{aligned}1 \\\\ 1 \\\\ 0 \\\\ 2\\end{aligned}]+(-1)[\\begin{aligned}-3 \\\\ -1 \\\\ 2 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ -1 \\\\ 1 \\\\ 0\\end{aligned}]+[\\begin{aligned}3 \\\\ 3 \\\\ 0 \\\\ 6\\end{aligned}]+[\\begin{aligned}3 \\\\ 1 \\\\ -2 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}7 \\\\ 3 \\\\ -1 \\\\ 4\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071420/state.json" "file_sha256" "5710e57af2fb0a2c2ec90ccf64318176bec2702ee0ec021dfe83614b0f657446"} {"question" "q-140120" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071420/activity-metadata.json" "file_sha256" "04f2dfb6996b584fe7bc927f8676ec50dbafb65e4b1d80058a34ba8a7ec07dec"} {"question" "q-140120" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071420/state.json" "file_sha256" "5710e57af2fb0a2c2ec90ccf64318176bec2702ee0ec021dfe83614b0f657446"} {"question" "q-140120" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-1 \\\\ -1 \\\\ 3 \\\\ 2\\end{aligned}]"] ["math" "[\\begin{aligned}-1 \\\\ 1 \\\\ 0 \\\\ 2\\end{aligned}]"] ["math" "[\\begin{aligned}-3 \\\\ -1 \\\\ 2 \\\\ 2\\end{aligned}]"] ["math" "[\\begin{aligned}-3 \\\\ -1 \\\\ 2 \\\\ 2\\end{aligned}]"] ["math" "[\\begin{aligned}7 \\\\ 3 \\\\ -1 \\\\ 4\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071420/state.json" "file_sha256" "5710e57af2fb0a2c2ec90ccf64318176bec2702ee0ec021dfe83614b0f657446"} {"question" "q-140120" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}7 \\\\ 3 \\\\ -1 \\\\ 4\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071420/state.json" "file_sha256" "5710e57af2fb0a2c2ec90ccf64318176bec2702ee0ec021dfe83614b0f657446"} {"question" "q-140359" "field" nil "attribute" "question/problem" "value" "Consider the vector $x$ and the plane $r=sv+tw,$ where $s,t\\in R,$ and\n\n$$\nv=[\\begin{aligned}3 \\\\ 2 \\\\ -1\\end{aligned}],\\,w=[\\begin{aligned}-2 \\\\ 2 \\\\ -2\\end{aligned}],\\,\\,x=[\\begin{aligned}4 \\\\ 14 \\\\ -2\\end{aligned}].\n$$\n\nFind the orthogonal projection of $x$ onto the plane given that $v⊥w.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071420/state.json" "file_sha256" "5710e57af2fb0a2c2ec90ccf64318176bec2702ee0ec021dfe83614b0f657446"} {"question" "q-140359" "field" nil "attribute" "question/worked-solution" "value" "Since our plane passes through the origin, it defines the subspace $S=\\text{Span}{v,w}$ in ${R}^{3}.$ \nAnd, since the set ${v,w}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by \n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}}$ and $\\text{Span}{{a}_{2}}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{v}\\,x & =\\frac{x\\cdot v}{v\\cdot v}v=\\frac{4\\cdot 3+14\\cdot 2+(-2)\\cdot (-1)}{{3}^{2}+{2}^{2}+(-1)^{2}}v=3[\\begin{aligned}3 \\\\ 2 \\\\ -1\\end{aligned}]=[\\begin{aligned}9 \\\\ 6 \\\\ -3\\end{aligned}] \\\\ {\\text{proj}}_{w}\\,x & =\\frac{x\\cdot w}{w\\cdot w}w=\\frac{4\\cdot (-2)+14\\cdot 2+(-2)\\cdot (-2)}{(-2)^{2}+{2}^{2}+(-2)^{2}}w=2[\\begin{aligned}-2 \\\\ 2 \\\\ -2\\end{aligned}]=[\\begin{aligned}-4 \\\\ 4 \\\\ -4\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x \\\\  & =[\\begin{aligned}9 \\\\ 6 \\\\ -3\\end{aligned}]+[\\begin{aligned}-4 \\\\ 4 \\\\ -4\\end{aligned}] \\\\  & =[\\begin{aligned}5 \\\\ 10 \\\\ -7\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071420/state.json" "file_sha256" "5710e57af2fb0a2c2ec90ccf64318176bec2702ee0ec021dfe83614b0f657446"} {"question" "q-140359" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071420/activity-metadata.json" "file_sha256" "04f2dfb6996b584fe7bc927f8676ec50dbafb65e4b1d80058a34ba8a7ec07dec"} {"question" "q-140359" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071420/state.json" "file_sha256" "5710e57af2fb0a2c2ec90ccf64318176bec2702ee0ec021dfe83614b0f657446"} {"question" "q-140359" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}3 \\\\ 9 \\\\ -7\\end{aligned}]"] ["math" "[\\begin{aligned}4 \\\\ 10 \\\\ -5\\end{aligned}]"] ["math" "[\\begin{aligned}5 \\\\ 10 \\\\ -7\\end{aligned}]"] ["math" "[\\begin{aligned}5 \\\\ 3 \\\\ -2\\end{aligned}]"] ["math" "[\\begin{aligned}5 \\\\ 6 \\\\ -2\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071420/state.json" "file_sha256" "5710e57af2fb0a2c2ec90ccf64318176bec2702ee0ec021dfe83614b0f657446"} {"question" "q-140359" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}5 \\\\ 10 \\\\ -7\\end{aligned}]"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071420/state.json" "file_sha256" "5710e57af2fb0a2c2ec90ccf64318176bec2702ee0ec021dfe83614b0f657446"} {"question" "q-140363" "field" nil "attribute" "question/problem" "value" "Consider the vector $x$ and the plane $r=sv+tw,$ where $s,t\\in R,$ and\n\n$$\nv=[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}],\\,w=[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}],\\,\\,x=[\\begin{aligned}0 \\\\ 1 \\\\ 2\\end{aligned}].\n$$\n\nFind the orthogonal projection of $x$ onto the plane given that $v⊥w.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071420/state.json" "file_sha256" "5710e57af2fb0a2c2ec90ccf64318176bec2702ee0ec021dfe83614b0f657446"} {"question" "q-140363" "field" nil "attribute" "question/worked-solution" "value" "Since our plane passes through the origin, it defines the subspace $S=\\text{Span}{v,w}$ in ${R}^{3}.$ \nAnd, since the set ${v,w}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}}$ and $\\text{Span}{{a}_{2}}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{v}\\,x & =\\frac{x\\cdot v}{v\\cdot v}v=\\frac{0\\cdot 1+1\\cdot 1+2\\cdot 0}{{1}^{2}+{1}^{2}+{0}^{2}}v=\\frac{1}{2}[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}] \\\\ {\\text{proj}}_{w}\\,x & =\\frac{x\\cdot w}{w\\cdot w}w=\\frac{0\\cdot (-1)+1\\cdot 1+2\\cdot 1}{(-1)^{2}+{1}^{2}+{1}^{2}}w=[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x \\\\  & =\\frac{1}{2}[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]+[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}] \\\\  & =\\frac{1}{2}([\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]+2[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}]) \\\\  & =[\\begin{aligned}-\\frac{1}{2} \\\\ \\frac{3}{2} \\\\ 1\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071420/state.json" "file_sha256" "5710e57af2fb0a2c2ec90ccf64318176bec2702ee0ec021dfe83614b0f657446"} {"question" "q-140363" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071420/activity-metadata.json" "file_sha256" "04f2dfb6996b584fe7bc927f8676ec50dbafb65e4b1d80058a34ba8a7ec07dec"} {"question" "q-140363" "field" "selection" "attribute" "answer-field/typ