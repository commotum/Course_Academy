d{aligned}]"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/state.json" "file_sha256" "7453e424f23cae5d25e530c9ae80bde4210e35b478fd0499fcbb38ecda6b3475" "basis" 1463 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/edb-import/verification.json"} {"question" "q-140120" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}7 \\\\ 3 \\\\ -1 \\\\ 4\\end{aligned}]"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/state.json" "file_sha256" "7453e424f23cae5d25e530c9ae80bde4210e35b478fd0499fcbb38ecda6b3475" "basis" 1463 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/edb-import/verification.json"} {"question" "q-82914" "field" nil "attribute" "question/problem" "value" "Consider the vector $x$ and the subspace $S=\\text{Span}{{a}_{1},{a}_{2}}$ where\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}2 \\\\ -1 \\\\ -2 \\\\ 1\\end{aligned}],\\,\\,x=[\\begin{aligned}2 \\\\ 1 \\\\ -3 \\\\ 1\\end{aligned}].\n$$\n\nFind the distance between $x$ and the subspace $S$ given that the set ${{a}_{1},{a}_{2}}$ is orthogonal." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/state.json" "file_sha256" "7453e424f23cae5d25e530c9ae80bde4210e35b478fd0499fcbb38ecda6b3475" "basis" 1463 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/edb-import/verification.json"} {"question" "q-82914" "field" nil "attribute" "question/worked-solution" "value" "Since the set ${{a}_{1},{a}_{2}}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}}$ and $\\text{Span}{{a}_{2}}:$ \n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{2\\cdot 1+1\\cdot 1+(-3)\\cdot 1+1\\cdot 1}{{1}^{2}+{1}^{2}+{1}^{2}+{1}^{2}}{a}_{1}=\\frac{1}{4}[\\begin{aligned}1 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{2\\cdot 2+1\\cdot (-1)+(-3)\\cdot (-2)+1\\cdot 1}{{2}^{2}+(-1)^{2}+(-2)^{2}+{1}^{2}}{a}_{2}=[\\begin{aligned}2 \\\\ -1 \\\\ -2 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x \\\\  & =\\frac{1}{4}[\\begin{aligned}1 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}]+[\\begin{aligned}2 \\\\ -1 \\\\ -2 \\\\ 1\\end{aligned}] \\\\  & =\\frac{1}{4}([\\begin{aligned}1 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}]+[\\begin{aligned}8 \\\\ -4 \\\\ -8 \\\\ 4\\end{aligned}]) \\\\  & =\\frac{1}{4}[\\begin{aligned}9 \\\\ -3 \\\\ -7 \\\\ 5\\end{aligned}]=\\overset{^}{x}.\\end{aligned}\n$$\n\nFinally, the distance between $x$ and the subspace $S$ is given by\n\n$$\n\\begin{aligned}d(x,\\overset{^}{x}) & =‖x-\\overset{^}{x}‖ \\\\  & =\\sqrt{({x}_{1}-{\\overset{^}{x}}_{1})^{2}+({x}_{2}-{\\overset{^}{x}}_{2})^{2}+({x}_{3}-{\\overset{^}{x}}_{3})^{2}+({x}_{4}-{\\overset{^}{x}}_{4})^{2}} \\\\  & =\\sqrt{{(2-\\frac{9}{4})}^{2}+{(1-(-\\frac{3}{4}))}^{2}+{(-3-(-\\frac{7}{4}))}^{2}+{(1-\\frac{5}{4})}^{2}} \\\\  & =\\sqrt{\\frac{1}{16}+\\frac{49}{16}+\\frac{25}{16}+\\frac{1}{16}} \\\\  & =\\sqrt{\\frac{76}{16}} \\\\  & =\\frac{\\sqrt{19}}{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/state.json" "file_sha256" "7453e424f23cae5d25e530c9ae80bde4210e35b478fd0499fcbb38ecda6b3475" "basis" 1463 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/edb-import/verification.json"} {"question" "q-82914" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/activity-metadata.json" "file_sha256" "3944de6a3727f3f405b7dd162373a24dc2a6fe43affdd3ae40a780ce8bceb465" "basis" 1463 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/edb-import/verification.json"} {"question" "q-82914" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/state.json" "file_sha256" "7453e424f23cae5d25e530c9ae80bde4210e35b478fd0499fcbb38ecda6b3475" "basis" 1463 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/edb-import/verification.json"} {"question" "q-82914" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "2\\sqrt{19}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/state.json" "file_sha256" "7453e424f23cae5d25e530c9ae80bde4210e35b478fd0499fcbb38ecda6b3475" "basis" 1463 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/edb-import/verification.json"} {"question" "q-82914" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{\\sqrt{19}}{2}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/state.json" "file_sha256" "7453e424f23cae5d25e530c9ae80bde4210e35b478fd0499fcbb38ecda6b3475" "basis" 1463 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/edb-import/verification.json"} {"question" "q-82914" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{\\sqrt{19}}{4}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/state.json" "file_sha256" "7453e424f23cae5d25e530c9ae80bde4210e35b478fd0499fcbb38ecda6b3475" "basis" 1463 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/edb-import/verification.json"} {"question" "q-82914" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{\\sqrt{38}}{2}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/state.json" "file_sha256" "7453e424f23cae5d25e530c9ae80bde4210e35b478fd0499fcbb38ecda6b3475" "basis" 1463 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/edb-import/verification.json"} {"question" "q-82914" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\sqrt{38}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/state.json" "file_sha256" "7453e424f23cae5d25e530c9ae80bde4210e35b478fd0499fcbb38ecda6b3475" "basis" 1463 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040677/edb-import/verification.json"} {"question" "q-82952" "field" nil "attribute" "question/problem" "value" "Consider the vector $x$ and the subspace $S=\\text{Span}{{a}_{1},{a}_{2}}$ where\n\n$$\n{a}_{1}=[\\begin{aligned}3 \\\\ 0 \\\\ -2 \\\\ 1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}2 \\\\ 1 \\\\ 2 \\\\ -2\\end{aligned}],\\,\\,x=[\\begin{aligned}5 \\\\ 5 \\\\ 2 \\\\ 3\\end{aligned}].\n$$\n\nFind the acute angle between $x$ and the subspace $S$ given that the set ${{a}_{1},{a}_{2}}$ is orthogonal." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059805/state.json" "file_sha256" "84fde27b1a00a1294e05039b91d97dabd7d2c4c9c595263f4404be9a9a9ee789" "basis" 1915 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059805/edb-import/verification.json"} {"question" "q-82952" "field" nil "attribute" "question/worked-solution" "value" "Since the set ${{a}_{1},{a}_{2}}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}}$ and $\\text{Span}{{a}_{2}}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{5\\cdot 3+5\\cdot 0+2\\cdot (-2)+3\\cdot 1}{{3}^{2}+{0}^{2}+(-2)^{2}+{1}^{2}}{a}_{1}=[\\begin{aligned}3 \\\\ 0 \\\\ -2 \\\\ 1\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{5\\cdot 2+5\\cdot 1+2\\cdot 2+3\\cdot (-2)}{{2}^{2}+{1}^{2}+{2}^{2}+(-2)^{2}}{a}_{2}=[\\begin{aligned}2 \\\\ 1 \\\\ 2 \\\\ -2\\end{aligned}]\\end{aligned}\n$$\n\n \n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x \\\\  & =[\\begin{aligned}3 \\\\ 0 \\\\ -2 \\\\ 1\\end{aligned}]+[\\begin{aligned}2 \\\\ 1 \\\\ 2 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}5 \\\\ 1 \\\\ 0 \\\\ -1\\end{aligned}].\\end{aligned}\n$$\n\n \n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x$ or any other non-zero vector that is parallel to ${\\text{proj}}_{S}x.$ \n\nComputing the cosine using the dot product, we obtain \n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{x\\cdot {\\text{proj}}_{S}\\,x}{‖x‖\\,‖{\\text{proj}}_{S}\\,x‖} \\\\  & =\\frac{5\\cdot 5+5\\cdot 1+2\\cdot 0+3\\cdot (-1)}{\\sqrt{{5}^{2}+{5}^{2}+{2}^{2}+{3}^{2}}\\sqrt{{5}^{2}+{1}^{2}+{0}^{2}+(-1)^{2}}} \\\\  & =\\frac{27}{\\sqrt{63}\\sqrt{27}} \\\\  & =\\frac{27}{3\\sqrt{7}\\cdot 3\\sqrt{3}} \\\\  & =\\frac{\\sqrt{21}}{7}.\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{\\sqrt{21}}{7})≈{49.11}^{∘},\n$$\n\nwhich is already an acute angle." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059805/state.json" "file_sha256" "84fde27b1a00a1294e05039b91d97dabd7d2c4c9c595263f4404be9a9a9ee789" "basis" 1915 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059805/edb-import/verification.json"} {"question" "q-82952" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059805/activity-metadata.json" "file_sha256" "97b5954bff8b5541ae3978022ac0c3d32b2258d67c2a190b4d128a4cfbbe4760" "basis" 1915 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059805/edb-import/verification.json"} {"question" "q-82952" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059805/state.json" "file_sha256" "84fde27b1a00a1294e05039b91d97dabd7d2c4c9c595263f4404be9a9a9ee789" "basis" 1915 "verification" "/home/jake/Developer/Course_Academy/refere