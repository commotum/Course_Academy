d1d5052e3336babf7e9c082d47c41a7e7e54570" "q-39005/selection/bc7d943c069170f8a3f2e24fa67679079ca040686b8079f217a2e61837473428" "q-39005/selection/dc7aaa863e1b11b09272a64d89b1c0509ae45fdcb8185ac2b75f0d8dd72cc7c4"] :db/ensure [:answer-field/validate]} {:db/id "q-39005" :question/id #uuid "ea3a8a38-8a00-5f57-b578-5a4b0637d9c7" :question/math-academy-id "q-39005" :question/problem "Given the matrix $A=[\\begin{aligned}1+\\text{i} & 1-\\text{i} \\\\ -2\\text{i} & \\text{i}\\end{aligned}]$, find the result of applying to $A$ the following elementary row operation:\n\n$$\n{R}_{2}:={R}_{2}+\\frac{2\\text{i}}{1+\\text{i}}{R}_{1}\n$$" :question/worked-solution "Let's apply the row operations to $A:$\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1+\\text{i} & 1-\\text{i} \\\\ -2\\text{i} & \\text{i}\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{2\\text{i}}{1+\\text{i}}{R}_{1} \\\\  & ∼[\\begin{aligned}1+\\text{i} & 1-\\text{i} \\\\ -2\\text{i}+\\frac{2\\text{i}(1+\\text{i})}{1+\\text{i}} & \\text{i}+\\frac{2\\text{i}(1-\\text{i})}{1+\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}1+\\text{i} & 1-\\text{i} \\\\ -2\\text{i}+2\\text{i} & \\text{i}+\\frac{2(\\text{i}+1)}{1+\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}1+\\text{i} & 1-\\text{i} \\\\ 0 & \\text{i}+2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the result  is \n\n$$\n[\\begin{aligned}1+\\text{i} & 1-\\text{i} \\\\ 0 & \\text{i}+2\\end{aligned}].\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-39005/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ef2e7753-83f4-5826-a04f-89616d34c578"] :knowledge-point/questions ["q-39005"] :db/ensure [:knowledge-point/validate]} {:db/id "q-76254/selection/d248c6244f14e5e733fa29f7f801ac6bc93b3892330bff8e644fe19a1db37e7e" :answer/id #uuid "918629ca-edf5-51ba-bfda-fad453d89be7" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 0 & 10-2\\text{i}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-76254/selection/fd1ad69e7608e39bc05cd66602b566a81113570809f8119a4f3ebfcb3844bc7f" :answer/id #uuid "492edb81-3eaa-5ed6-b7ea-2379504dcb2b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\text{i} & \\text{i} \\\\ 1 & 8\\text{i}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-76254/selection/3798a88005bc9ce8a29b03e40c4260fac4af8030ee9cc7216986908878f54d76" :answer/id #uuid "cbd1088d-529f-5544-a6de-61ad24e0b157" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 & 1 \\\\ 0 & 8\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-76254/selection/305bdc9a02f5c3a96958397ad71f6c09a1fab63e13e23c9f40e8b974ca150f63" :answer/id #uuid "8d4331b5-4e68-59f1-9000-d9e0988f964a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 1 & 10-2\\text{i}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-76254/selection/0848c8c1a43079b9491b8d33a14cce50bd5528d3b7853ceee76d2ed1bf9178a1" :answer/id #uuid "31aa0cff-1ddd-5ced-9f90-646f5db2454b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 0 & 8\\text{i}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-76254/selection" :answer-field/id #uuid "9765b53a-c71b-5934-b951-a33b74246774" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-76254/selection/d248c6244f14e5e733fa29f7f801ac6bc93b3892330bff8e644fe19a1db37e7e" :answer-field/choices ["q-76254/selection/d248c6244f14e5e733fa29f7f801ac6bc93b3892330bff8e644fe19a1db37e7e" "q-76254/selection/fd1ad69e7608e39bc05cd66602b566a81113570809f8119a4f3ebfcb3844bc7f" "q-76254/selection/3798a88005bc9ce8a29b03e40c4260fac4af8030ee9cc7216986908878f54d76" "q-76254/selection/305bdc9a02f5c3a96958397ad71f6c09a1fab63e13e23c9f40e8b974ca150f63" "q-76254/selection/0848c8c1a43079b9491b8d33a14cce50bd5528d3b7853ceee76d2ed1bf9178a1"] :db/ensure [:answer-field/validate]} {:db/id "q-76254" :question/id #uuid "92e367a3-8aab-5062-bdae-482777fab633" :question/math-academy-id "q-76254" :question/problem "Given the matrix $A=[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 7 & 3-2\\text{i}\\end{aligned}]$, find the result of applying to $A$ the following elementary row operations: \n\n$$\n{R}_{2}:={R}_{2}+\\frac{7}{\\text{i}}{R}_{1}\n$$" :question/worked-solution "Let's apply the row operations to $A:$\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 7 & 3-2\\text{i}\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{7}{\\text{i}}{R}_{1} \\\\  & ∼[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 7+(-\\text{i})\\cdot \\frac{7}{\\text{i}} & \\text{(}3-2\\text{i})+i\\cdot \\frac{7}{\\text{i}}\\end{aligned}] \\\\  & ∼[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 0 & 10-2\\text{i}\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the result  is \n\n$$\n[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 0 & 10-2\\text{i}\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-76254/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ef2e7753-83f4-5826-a04f-89616d34c578"] :knowledge-point/questions ["q-76254"] :db/ensure [:knowledge-point/validate]} {:db/id "q-76256/selection/6bef7113bacf452076ea5ce3cb899d1cfa2c19ce4d6ce4836a3503817fd74311" :answer/id #uuid "bb79c029-3045-5993-8891-9e28987867cb" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1+2\\text{i} & 1+\\text{i} \\\\ 1 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-76256/selection/100703f8046ff75a42f6f47569f6535918ab41b187201e34798bb5b98d4e0322" :answer/id #uuid "4e80150d-14bf-5790-91ed-71534094caef" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1+2\\text{i} & 1+\\text{i} \\\\ 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-76256/selection/f5eaddba68df789347f99edb4199168d3d4e333d4a06b70ee59b4e545a005342" :answer/id #uuid "0ddcc229-69e1-5a65-8b3c-f630b7f354d2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1-2\\text{i} & 1+\\text{i} \\\\ \\text{i} & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-76256/selection/e99b383e59e099f20319d71f74804ac413df8c4b28e74436de0b9b71d3e5c753" :answer/id #uuid "f6f1e063-c4b8-55fb-a2ad-ccd769e415d4" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1+2\\text{i} & 1+\\text{i} \\\\ \\text{i} & \\text{i}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-76256/selection/40568ac1bb83b3f66b57500788c2ee328e9aae08cb684ce5720fd10c604ce362" :answer/id #uuid "ae53ef35-45ad-5c76-819f-59eb14082dac" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1+2\\text{i} & 1+\\text{i} \\\\ 0 & \\text{i}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-76256/selection" :answer-field/id #uuid "2b615a81-067b-54e0-b1e9-8f604e402f57" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-76256/selection/100703f8046ff75a42f6f47569f6535918ab41b187201e34798bb5b98d4e0322" :answer-field/choices ["q-76256/selection/6bef7113bacf452076ea5ce3cb899d1cfa2c19ce4d6ce4836a3503817fd74311" "q-76256/selection/100703f8046ff75a42f6f47569f6535918ab41b187201e34798bb5b98d4e0322" "q-76256/selection/f5eaddba68df789347f99edb4199168d3d4e333d4a06b70ee59b4e545a005342" "q-76256/selection/e99b383e59e099f20319d71f74804ac413df8c4b28e74436de0b9b71d3e5c753" "q-76256/selection/40568ac1bb83b3f66b57500788c2ee328e9aae08cb684ce5720fd10c604ce362"] :db/ensure [:answer-field/validate]} {:db/id "q-76256" :question/id #uuid "8dacc1d4-24b7-57a9-9014-dfb4a179d2b2" :question/math-academy-id "q-76256" :question/problem "Given the matrix $A=[\\begin{aligned}1+2\\text{i} & 1+\\text{i} \\\\ -2+\\text{i} & \\text{i}\\end{aligned}]$, find the result of applying to $A$ the following elementary row operation:\n\n$$\n{R}_{2}:={R}_{2}+\\frac{2-\\text{i}}{1+2\\text{i}}{R}_{1}\n$$" :question/worked-solution "Let's apply the row operations to $A:$\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1+2\\text{i} & 1+\\text{i} \\\\ -2+\\text{i} & \\text{i}\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{2-\\text{i}}{1+2\\text{i}}{R}_{1} \\\\  & ∼[\\begin{aligned}1+2\\text{i} & 1+\\text{i} \\\\ -2+\\text{i}+\\frac{(2-\\text{i})(1+2\\text{i})}{1+2\\text{i}} & \\text{i}+\\frac{(2-\\text{i})(1+\\text{i})}{1+2\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}1+2\\text{i} & 1+\\text{i} \\\\ 0 & \\frac{(\\text{i}-2)+(3+\\text{i})}{1+2\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}1+2\\text{i} & 1+\\text{i} \\\\ 0 & 1\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the result  is \n\n$$\n[\\begin{aligned}1+2\\text{i} & 1+\\text{i} \\\\ 0 & 1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-76256/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ef2e7753-83f4-5826-a04f-89616d34c578"] :knowledge-point/questions ["q-76256"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-5903"] :question/problem "Find $B=\\overline{A},$ where ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/assets/25ce0cd375da320d1615cf49f659ec33e4646cf6bc66455198bec5fd591b3dd3.png) What is the value of $b_{11} + b_{23}?$" :question/worked-solution "Taking the complex conjugate of each entry, we get\n\n$$\n\\begin{aligned}\\overset{―}{A} & =\\overset{―}{[\\begin{aligned}4\\text{i} & 3-\\text{i} & 1+\\text{i} \\\\ 2-2\\text{i} & 2-\\text{i} & 1+2\\text{i} \\\\ \\text{i} & 3\\text{i} & 2\\text{i}\\end{aligned}]} \\\\  & =[\\begin{aligned}\\overset{―}{4\\text{i}} & \\overset{―}{3-\\text{i}} & \\overset{―}{1+\\text{i}} \\\\ \\overset{―}{2-2\\text{i}} & \\overset{―}{2-\\text{i}} & \\overset{―}{1+2\\text{i}} \\\\ \\overset{―}{\\text{i}} & \\overset{―}{3\\text{i}} & \\overset{―}{2\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}-4\\text{i} & 3+\\text{i} & 1-\\text{i} \\\\ 2+2\\text{i} & 2+\\text{i} & 1-2\\text{i} \\\\ -\\text{i} & -3\\text{i} & -2\\text{i}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, $b_{11} + b_{23} = (-4\\textrm{i}) + (1-2\\textrm{i}) = 1-6\\textrm{i}.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5525"] :question/problem "If ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/assets/3e677aa7f2db1cc637e0566a60813ebae1e2bccf80325106317c1d2b7717c2a5.png) and ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/assets/67a421166c674275ae14da43962c8e5c8ea37b6a9c8a0548d5b09428b703d831.png) are the real and imaginary parts of the matrix ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/assets/fde83769f627e95f5dfe3285bf275ebfe1678710a36c264b6662248063470bb0.png) then what is the value of $ad+eh?$" :question/worked-solution "For the given matrix $A,$ we have that\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2-3\\text{i} & -5-7\\text{i} \\\\ 1-6\\text{i} & 5-9\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}2 & -5 \\\\ 1 & 5\\end{aligned}]}_{⏟}}_{\\text{Re}(A)}+\\text{i}{{[\\begin{aligned}-3 & -7 \\\\ -6 & -9\\end{aligned}]}_{⏟}}_{\\text{Im}(A)}.\\end{aligned}\n$$\n\nSo we have $a=2,d=5,e=-3$ and $h=-9.$ Therefore,\n\n$$\nad+eh=2 \\cdot 5 + (-3) \\cdot (-9) = 37.\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5902"] :question/problem "If ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/assets/b696bb055794a4ff94c86abc39ef3929113f82683b548a933fc1103245eff3fc.png) and ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/assets/e6a5f5644ae4bcdfca4ca26bb258f33378381737ee036142c1e1c24f568ad2ed.png), then what is $AB?$" :question/worked-solution "Multiplying the matrices using the usual method, we get\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 1 & 2\\text{i}\\end{aligned}]\\cdot [\\begin{aligned}1+2\\text{i} & 1-\\text{i} \\\\ \\text{i} & 2\\end{aligned}] \\\\  & =[\\begin{aligned}(-\\text{i})\\cdot (1+2\\text{i})+\\text{i}\\cdot \\text{i} & (-\\text{i})\\cdot (1-\\text{i})+\\text{i}\\cdot 2 \\\\ 1\\cdot (1+2\\text{i})+2\\text{i}\\cdot \\text{i} & 1\\cdot (1-\\text{i})+2\\text{i}\\cdot 2\\end{aligned}] \\\\  & =[\\begin{aligned}(2-\\text{i})+(-1) & (-1-\\text{i})+2\\text{i} \\\\ (1+2\\text{i})+(-2) & (1-\\text{i})+4\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}1-\\text{i} & -1+\\text{i} \\\\ -1+2\\text{i} & 1+3\\text{i}\\end{aligned}].\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5526"] :question/problem "Given the matrix ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/assets/766ddf98a05c69ef0791858a7f32457425cf1a9650d2205227ffc7d9d173d2e7.png) find the result of applying to $A$ the following elementary row operations:\n\n$$\nR_1 := \\dfrac{1}{\\textrm{i}}R_1, \\qquad R_2 := R_2 - 2\\textrm{i}R_1\n$$" :question/worked-solution "Let's apply the row operations to $A\\mathbin{:}$\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}\\text{i} & -\\text{i} \\\\ 2+2\\text{i} & 1\\end{aligned}]\\, &  & {R}_{1}:=\\frac{1}{\\text{i}}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 \\\\ 2+2\\text{i} & 1\\end{aligned}]\\, &  & {R}_{2}:={R}_{2}-2\\text{i}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 \\\\ 2 & 1+2\\text{i}\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the result is\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/assets/9fef320d53c15c2820719bb1d0dfabb00afa6200b43279e3137fbb25c4e67e2d.png)" :db/ensure [:question/validate]}]
