}} & \\overset{―}{4-4\\text{i}} & \\overset{―}{4\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}-3\\text{i} & -2-2\\text{i} & 5+5\\text{i} \\\\ -\\text{i} & -1-5\\text{i} & -3-4\\text{i} \\\\ -5+3\\text{i} & 4+4\\text{i} & -4\\text{i}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, ${b}_{12}+{b}_{23}=(-2-2\\text{i})+(-3-4\\text{i})=-5-6\\text{i}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-132715/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c7c1b7ad-e4bf-55b2-8665-2cf35e402946"] :knowledge-point/questions ["q-132715"] :db/ensure [:knowledge-point/validate]} {:db/id "q-76055/selection/1b2bd90713c0331a96feb46d59185f8121fc9670ba5016e2d9c9d7eb2dda9a65" :answer/id #uuid "d09af70f-46d6-5ee3-82b7-f25cb59f8d1a" :answer/type :answer.type/math :answer/value "-3-3\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-76055/selection/ff0f2a688295bfb73c5b59fe812460e33bbc81c47106bd14ce04f1a3243aec16" :answer/id #uuid "a65bd6d9-764a-53cd-8f73-ec82f69e173a" :answer/type :answer.type/math :answer/value "3+3\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-76055/selection/7eb3ba16664dfd3bb92bec75f6352b6fe3350e81482db440f500f13382b333af" :answer/id #uuid "d2dbe44b-248f-5bde-91c6-3ff9244cb56b" :answer/type :answer.type/math :answer/value "-3+3\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-76055/selection/7205cb230b5fb3d2a31d422eb6126305074cb7029825ca23962a5eae727f07ed" :answer/id #uuid "d42d0f90-35a2-5ab3-acb8-ebc49c6cc72f" :answer/type :answer.type/math :answer/value "3-3\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-76055/selection/d0a25a5ffd46ca3d3da60ca4de3ef7a2e208ea13eada529c7dd4444c31402c16" :answer/id #uuid "24783072-6c28-578a-8d50-e157bf0ac679" :answer/type :answer.type/math :answer/value "3+\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-76055/selection" :answer-field/id #uuid "ca5d2b99-306b-54d5-8ccf-e10cbd555876" :answer-field/key "selection" :answer-field/type :answer-field.type/radi