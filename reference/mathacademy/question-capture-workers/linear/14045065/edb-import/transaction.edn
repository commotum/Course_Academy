:db/id [:knowledge-point/id #uuid "3c28b8ae-71ef-5d26-895a-5d949fc5b164"] :knowledge-point/questions ["q-76207"] :db/ensure [:knowledge-point/validate]} {:db/id "q-76223/selection/1bc1741164657f1d1c26c02abcd8c4aea91df272f9e1f59ddd5dc8e43eed9071" :answer/id #uuid "29cb5c79-d63b-59bb-b68b-45ad61d4c9e0" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1+13\\text{i} & 7+5\\text{i} \\\\ 8+6\\text{i} & 4+6\\text{i}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-76223/selection/47b4f174c639e812fd64c93a954eefecff5ad99a69d9209dbd0edfeeb66a5973" :answer/id #uuid "9ccc9e15-75bb-5c9c-bd71-373a223c949f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1-13\\text{i} & 7-5\\text{i} \\\\ 8+6\\text{i} & 4+6\\text{i}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-76223/selection/410e8a7dd9cdc72b07175db907bec12a1f976984e9969ceb6cce7a3b0a849375" :answer/id #uuid "b5d2e190-17b2-51b3-8319-9ba4fed94cd9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4+6\\text{i} & 8+6\\text{i} \\\\ 7-5\\text{i} & -1-13\\text{i}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-76223/selection/1793d20e58450e854a47b20cc0cfe3f398c307863b4d812d147169d52df1aeb7" :answer/id #uuid "e5445583-7cae-5d34-a67f-70614754b2b9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4+6\\text{i} & 7-5\\text{i} \\\\ 8+6\\text{i} & -1-13\\text{i}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-76223/selection/82f713342aee9ee5b24952f6a14d984a7b7af2fa6caf1e8bb007ac82e5b342ef" :answer/id #uuid "bdf260e0-032f-5d9c-9b90-01c4a971c948" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1-13\\text{i} & 8+6\\text{i} \\\\ 7-5\\text{i} & 4+6\\text{i}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-76223/selection" :answer-field/id #uuid "08dc7d36-4aab-51b3-b8c0-45d260b89c34" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-76223/selection/47b4f174c639e812fd64c93a954eefecff5ad99a69d9209dbd0edfeeb66a5973" :answer-field/choices ["q-76223/selection/1bc1741164657f1d1c26c02abcd8c4aea91df272f9e1f59ddd5dc8e43eed9071" "q-76223/selection/47b4f174c639e812fd64c93a954eefecff5ad99a69d9209dbd0edfeeb66a5973" "q-76223/selection/410e8a7dd9cdc72b07175db907bec12a1f976984e9969ceb6cce7a3b0a849375" "q-76223/selection/1793d20e58450e854a47b20cc0cfe3f398c307863b4d812d147169d52df1aeb7" "q-76223/selection/82f713342aee9ee5b24952f6a14d984a7b7af2fa6caf1e8bb007ac82e5b342ef"] :db/ensure [:answer-field/validate]} {:db/id "q-76223" :question/id #uuid "e93d1f28-d0c0-5126-b248-ca6895657c64" :question/math-academy-id "q-76223" :question/problem "If $\\,A=[\\begin{aligned}1-3\\text{i} & -1+2\\text{i} \\\\ 2+2\\text{i} & 1-\\text{i}\\end{aligned}]\\,$ and $\\,B=[\\begin{aligned}3-\\text{i} & 3+\\text{i} \\\\ -1+\\text{i} & 1-\\text{i}\\end{aligned}]\\,$, then $AB=$" :question/worked-solution "Multiplying the matrices using the usual method, we get\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}1-3\\text{i} & -1+2\\text{i} \\\\ 2+2\\text{i} & 1-\\text{i}\\end{aligned}]\\cdot [\\begin{aligned}3-\\text{i} & 3+\\text{i} \\\\ -1+\\text{i} & 1-\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}(1-3\\text{i})(3-\\text{i})+(-1+2\\text{i})(-1+\\text{i}) & (1-3\\text{i})(3+\\text{i})+(-1+2\\text{i})(1-\\text{i}) \\\\ (2+2\\text{i})(3-\\text{i})+(1-\\text{i})(-1+\\text{i}) & (2+2\\text{i})(3+\\text{i})+(1-\\text{i})(1-\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}-10\\text{i}+(-1-3\\text{i}) & (6-8\\text{i})+(1+3\\text{i}) \\\\ (8+4\\text{i})+2\\text{i} & (4+8\\text{i})+(-2\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}-1-13\\text{i} & 7-5\\text{i} \\\\ 8+6\\text{i} & 4+6\\text{i}\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-76223/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "83fad21d-6b36-5198-a13f-362d34342475"] :knowledge-point/questions ["q-76223"] :db/ensure [:knowledge-point/validate]} {:db/id "q-76220/selection/99170c7a73e9cf345bd93da11d91e5c9dac260eb3a647ce3ad40cec055842d44" :answer/id #uuid "cdb7110b-1c7a-5073-8e69-31482be6d032" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1+2\\text{i} & -3-3\\text{i} \\\\ 12+\\text{i} & -12-3\\text{i}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-76220/selection/863a7a0211e7bda0a691dc7bdfe645544dfbf3a7be0fe6a34f4fdb70f77e8e34" :answer/id #uuid "5b48de7f-6121-545c-8720-e801c4dccee6" :answer/type :answer.type/math :answer/value "[\\begin{aligned}12+\\text{i} & -3-3\\text{i} \\\\ -1+2\\text{i} & -12-3\\text{i}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-76220/selection/99bbf9dd9940ba19e49127845e63624cb0e5428736cf1fcaa45eb560c4244c7d" :answer/id #uuid "b881c37a-be92-5ac5-8f96-9bdda7aaaa77" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3-12\\text{i} & -3-3\\text{i} \\\\ 12+\\text{i} & 2-\\text{i}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-76220/selection/3c9c93a5a5b80b2f11bd15057ad5fa04ebe9f77e9f8eb873b1b5036a4700dd7c" :answer/id #uuid "a5192b11-0c65-5589-b16b-691a12644347" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1+2\\text{i} & -12-3\\text{i} \\\\ 12+\\text{i} & -3-3\\text{i}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-76220/selection/6af5343a8a070dd03cd588039218dbee228115b6f3f73703e8041c01e90c7643" :answer/id #uuid "7c7e32f9-f7f8-59a1-8f82-10be3bc5e0f5" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1+2\\text{i} & 12+\\text{i} \\\\ -3-3\\text{i} & -12-3\\text{i}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-76220/selection" :answer-field/id #uuid "f4ed1c7a-72c3-5509-b58a-fa3e74019766" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-76220/selection/99170c7a73e9cf345bd93da11d91e5c9dac260eb3a647ce3ad40cec055842d44" :answer-field/choices ["q-76220/selection/99170c7a73e9cf345bd93da11d91e5c9dac260eb3a647ce3ad40cec055842d44" "q-76220/selection/863a7a0211e7bda0a691dc7bdfe645544dfbf3a7be0fe6a34f4fdb70f77e8e34" "q-76220/selection/99bbf9dd9940ba19e49127845e63624cb0e5428736cf1fcaa45eb560c4244c7d" "q-76220/selection/3c9c93a5a5b80b2f11bd15057ad5fa04ebe9f77e9f8eb873b1b5036a4700dd7c" "q-76220/selection/6af5343a8a070dd03cd588039218dbee228115b6f3f73703e8041c01e90c7643"] :db/ensure [:answer-field/validate]} {:db/id "q-76220" :question/id #uuid "7f5bcf1a-c003-5127-bfd3-0fe4d13aef40" :question/math-academy-id "q-76220" :question/problem "If $\\,A=[\\begin{aligned}-1-\\text{i} & -\\text{i} \\\\ 3 & -2+\\text{i}\\end{aligned}]\\,$ and $\\,B=[\\begin{aligned}1+\\text{i} & -3\\text{i} \\\\ -4-\\text{i} & 6\\end{aligned}]\\,$, then $AB=$" :question/worked-solution "Multiplying the matrices using the usual method, we get\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}-1-\\text{i} & -\\text{i} \\\\ 3 & -2+\\text{i}\\end{aligned}]\\cdot [\\begin{aligned}1+\\text{i} & -3\\text{i} \\\\ -4-\\text{i} & 6\\end{aligned}] \\\\  & =[\\begin{aligned}(-1-\\text{i})(1+\\text{i})+(-\\text{i})(-4-\\text{i}) & (-1-\\text{i})(-3\\text{i})+(-\\text{i})\\cdot 6 \\\\ 3\\cdot (1+\\text{i})+(-2+\\text{i})(-4-\\text{i}) & 3\\cdot (-3\\text{i})+(-2+\\text{i})\\cdot 6\\end{aligned}] \\\\  & =[\\begin{aligned}-2\\text{i}+(4\\text{i}-1) & (3\\text{i}-3)+(-6\\text{i}) \\\\ (3+3\\text{i})+(9-2\\text{i}) & (-9\\text{i})+(-12+6\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}-1+2\\text{i} & -3-3\\text{i} \\\\ 12+\\text{i} & -12-3\\text{i}\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-76220/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "83fad21d-6b36-5198-a13f-362d34342475"] :knowledge-point/questions ["q-76220"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-38391"] :question/problem "If $\\,A=[\\begin{aligned}1-\\text{i} & 2-2\\text{i} \\\\ 3-6\\text{i} & 3-3\\text{i}\\end{aligned}]\\,$ and $\\,x=[\\begin{aligned}5-2\\text{i} \\\\ 2+\\text{i}\\end{aligned}]\\,$, then $\\,Ax=$" :question/worked-solution "Multiplying the matrix by the vector using the usual method, we get\n\n$$\n\\begin{aligned}Ax & =[\\begin{aligned}1-\\text{i} & 2-2\\text{i} \\\\ 3-6\\text{i} & 3-3\\text{i}\\end{aligned}]\\cdot [\\begin{aligned}5-2\\text{i} \\\\ 2+\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}(1-\\text{i})(5-2\\text{i})+(2-2\\text{i})(2+\\text{i}) \\\\ (3-6\\text{i})(5-2\\text{i})+(3-3\\text{i})(2+\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}(3-7\\text{i})+(6-2\\text{i}) \\\\ (3-36\\text{i})+(9-3\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}9-9\\text{i} \\\\ 12-39\\text{i}\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-38392"] :question/problem "If $\\,A=[\\begin{aligned}2+3\\text{i} & 1+2\\text{i} \\\\ 2+\\text{i} & 4+4\\text{i}\\end{aligned}]\\,$ and $\\,B=[\\begin{aligned}3+2\\text{i} & 2+\\text{i} \\\\ 1+2\\text{i} & 2+2\\text{i}\\end{aligned}]\\,$, then $AB=$" :question/worked-solution "Multiplying the matrices using the usual method, we get\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}2+3\\text{i} & 1+2\\text{i} \\\\ 2+\\text{i} & 4+4\\text{i}\\end{aligned}]\\cdot [\\begin{aligned}3+2\\text{i} & 2+\\text{i} \\\\ 1+2\\text{i} & 2+2\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}(2+3\\text{i})(3+2\\text{i})+(1+2\\text{i})(1+2\\text{i}) & (2+3\\text{i})(2+\\text{i})+(1+2\\text{i})(2+2\\text{i}) \\\\ (2+\\text{i})(3+2\\text{i})+(4+4\\text{i})(1+2\\text{i}) & (2+\\text{i})(2+\\text{i})+(4+4\\text{i})(2+2\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}13\\text{i}+(-3+4\\text{i}) & (1+8\\text{i})+(-2+6\\text{i}) \\\\ (4+7\\text{i})+(-4+12\\text{i}) & (3+4\\text{i})+16\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}-3+17\\text{i} & -1+14\\text{i} \\\\ 19\\text{i} & 3+20\\text{i}\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-140328/selection/d033399f0d4718f782601c303ed8f8726fc13fa2c1a8a8c03795ea4016a93454" :answer/id #uuid "515320af-da9e-5c86-9c3e-b1a76f31af2f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4+\\text{i} \\\\ -1+4\\text{i}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-140328/selection/a2f7869cd9f7a2f0c42383c7ccb8a13723e47323e1675fd35718f7f8664cc450" :answer/id #uuid "b1bcc2ec-3f0a-543a-aae2-e70fba163efe" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1+4\\text{i} \\\\ -1+4\\text{i}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-140328/selection/0217fe6609cb5737b1ff14e4447b40d6fcd1c10cf8c5e38ce1b8e5be7e728655" :answer/id #uuid "66657ccc-05cb-5c0b-b007-1daf83a962dc" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1+4\\text{i} \\\\ 4+\\text{i}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-140328/selection/26642961702a573fbc0fae09235d6c4be910f14f22effcf244abf526c0ea058c" :answer/id #uuid "3a6d7ffa-507f-5ab0-b467-7e3c651276df" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1-4\\text{i} \\\\ 4+\\text{i}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-140328/selection/07b28fb9af6f1a3a59b74cf0151c2329c27a2c18a5086afb44da8fbd9f1617a1" :answer/id #uuid "df751b5b-1409-5397-8049-9e4f2958f6c2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1+4\\text{i} \\\\ 4-\\text{i}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-140328/selection" :answer-field/id #uuid "f590a31e-f5c5-5f40-b354-7534b9143fa6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-140328/selection/d033399f0d4718f782601c303ed8f8726fc13fa2c1a8a8c03795ea4016a93454" :answer-field/choices ["q-140328/selection/d033399f0d4718f782601c303ed8f8726fc13fa2c1a8a8c03795ea4016a93454" "q-140328/selection/a2f7869cd9f7a2f0c42383c7ccb8a13723e47323e1675fd35718f7f8664cc450" "q-140328/selec