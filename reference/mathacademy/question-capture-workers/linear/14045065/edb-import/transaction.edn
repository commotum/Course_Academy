gned}] \\\\  & =[\\begin{aligned}-4+2\\text{i} & 7-5\\text{i} & 6-6\\text{i} \\\\ -4-5\\text{i} & 2+\\text{i} & 3 \\\\ -2+\\text{i} & 2+\\text{i} & 3\\text{i}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, ${b}_{23}+{b}_{33}=3+3\\text{i}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-131184/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c7c1b7ad-e4bf-55b2-8665-2cf35e402946"] :knowledge-point/questions ["q-131184"] :db/ensure [:knowledge-point/validate]} {:db/id "q-140325/selection/56c57502ed9362f3f416b4398e79545a0252f6594946b2d60ff940ea8bef1e7b" :answer/id #uuid "da2a18c1-0bc7-5c9c-b1cd-5e6a25374f60" :answer/type :answer.type/math :answer/value "44" :db/ensure [:answer/validate]} {:db/id "q-140325/selection/10a16995d4400019fd6fb7657f0b596091365fdcd33291b0e6219ab7c3a2ea00" :answer/id #uuid "673b6dfb-5083-5a4f-89ea-12b63fa859e4" :answer/type :answer.type/math :answer/value "46" :db/ensure [:answer/validate]} {:db/id "q-140325/selection/2671fdc3a44bd3421ded09be4e881743067a96eb4e584e442a30f737593eae71" :answer/id #uuid "60fed398-d7bf-519c-b3e7-8fda40137e90" :answer/type :answer.type/math :answer/value "38" :db/ensure [:answer/validate]} {:db/id "q-140325/selection/e645b0f714e0f14adf4a4392c1fd41e203b4d4c946a42f546b48043b8700d60e" :answer/id #uuid "a5d04671-591b-5177-8af9-cea1325f77f7" :answer/type :answer.type/math :answer/value "31" :db/ensure [:answer/validate]} {:db/id "q-140325/selection/2fa5baf88b61736a3022c72e24e172fda2b4270fffff6efaa1fc03fef23fccc2" :answer/id #uuid "a39d5286-93e3-5b05-8c15-15960aadda48" :answer/type :answer.type/math :answer/value "26" :db/ensure [:answer/validate]} {:db/id "q-140325/selection" :answer-field/id #uuid "12b9602e-bc40-5da4-9be1-5e4fdf17ca2e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-140325/selection/56c57502ed9362f3f416b4398e79545a0252f6594946b2d60ff940ea8bef1e7b" :answer-field/choices ["q-140325/selection/56c57