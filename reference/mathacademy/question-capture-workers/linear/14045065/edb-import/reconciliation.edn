{―}{4\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}-3\\text{i} & -2-2\\text{i} & 5+5\\text{i} \\\\ -\\text{i} & -1-5\\text{i} & -3-4\\text{i} \\\\ -5+3\\text{i} & 4+4\\text{i} & -4\\text{i}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, ${b}_{12}+{b}_{23}=(-2-2\\text{i})+(-3-4\\text{i})=-5-6\\text{i}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "31710d2c7ffd1f9d9081e048833f4c1b154f9f477e209030e29e66492e86d933"} {"question" "q-132715" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/activity-metadata.json" "file_sha256" "37ba5df55475007f46a653df2e9ada705233f87b3c21410d3cbcfaa3ff4acf79"} {"question" "q-132715" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "31710d2c7ffd1f9d9081e048833f4c1b154f9f477e209030e29e66492e86d933"} {"question" "q-132715" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-4-9\\text{i}"] ["math" "-5-6\\text{i}"] ["math" "-8-\\text{i}"] ["math" "4+3\\text{i}"] ["math" "8\\text{i}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "31710d2c7ffd1f9d9081e048833f4c1b154f9f477e209030e29e66492e86d933"} {"question" "q-132715" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-5-6\\text{i}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "31710d2c7ffd1f9d9081e048833f4c1b154f9f477e209030e29e66492e86