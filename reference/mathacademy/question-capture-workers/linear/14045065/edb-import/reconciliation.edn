{aligned}-9 & 1 \\\\ -2 & -4\\end{aligned}]}_{⏟}}_{\\text{Im}(A)}.\\end{aligned}\n$$\n\nSo we have $b=-7,c=-5,e=-9$ and $f=1.$ Therefore,\n\n$$\nbc-ef=(-7)\\cdot (-5)-(-9)\\cdot 1=44.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "31710d2c7ffd1f9d9081e048833f4c1b154f9f477e209030e29e66492e86d933"} {"question" "q-140325" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/activity-metadata.json" "file_sha256" "37ba5df55475007f46a653df2e9ada705233f87b3c21410d3cbcfaa3ff4acf79"} {"question" "q-140325" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "31710d2c7ffd1f9d9081e048833f4c1b154f9f477e209030e29e66492e86d933"} {"question" "q-140325" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "26"] ["math" "31"] ["math" "38"] ["math" "44"] ["math" "46"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "31710d2c7ffd1f9d9081e048833f4c1b154f9f477e209030e29e66492e86d933"} {"question" "q-140325" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "44"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "31710d2c7ffd1f9d9081e048833f4c1b154f9f477e209030e29e66492e86d933"} {"question" "q-76204" "field" nil "attribute" "question/problem" "value" "Find the real part of the matrix $A=[\\begin{aligned}1+2\\text{i} & 7-6\\text{i} \\\\ -\\text{i} & 4\\e