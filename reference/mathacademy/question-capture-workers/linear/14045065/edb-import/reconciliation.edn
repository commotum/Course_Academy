ed}].\\end{aligned}\n$$\n\nTherefore, ${b}_{12}+{b}_{22}=(2-7\\text{i})+(9+5\\text{i})=11-2\\text{i}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "31710d2c7ffd1f9d9081e048833f4c1b154f9f477e209030e29e66492e86d933"} {"question" "q-76063" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/activity-metadata.json" "file_sha256" "37ba5df55475007f46a653df2e9ada705233f87b3c21410d3cbcfaa3ff4acf79"} {"question" "q-76063" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "31710d2c7ffd1f9d9081e048833f4c1b154f9f477e209030e29e66492e86d933"} {"question" "q-76063" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-7-2\\text{i}"] ["math" "11+12\\text{i}"] ["math" "11-2\\text{i}"] ["math" "7+12\\text{i}"] ["math" "7+2\\text{i}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "31710d2c7ffd1f9d9081e048833f4c1b154f9f477e209030e29e66492e86d933"} {"question" "q-76063" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "11-2\\text{i}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "31710d2c7ffd1f9d9081e048833f4c1b154f9f477e209030e29e66492e86d933"} {"question" "q-131184" "field" nil "attribute" "question/problem" "value" "Find $B=\\overset{―}{A}$, where\n$A=[\\begin{aligned}-4-2\\text{i} & 7+5\\text{i} & 6+6\\text{i} \\\\ -4+5\\text{i} & 2-\\text{i} & 3 \\\\ -2-\\text{i} & 2-\\text{i} & -3\\text{i}\\end{aligned}].$\nWhat is the value of ${b}_{23}+{b}_{33}?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "31710d2c7ffd1f9d9081e048833f4c1b154f9f477e209030e29e66492e86d933"} {"question" "q-131184" "field" nil "attribute" "question/worked-solution" "value" "Taking the complex conjugate of each entry, we get\n\n$$\n\\begin{aligned}\\overset{―}{A} & =\\overset{―}{[\\begin{aligned}-4-2\\text{i} & 7+5\\text{i} & 6+6\\text{i} \\\\ -4+5\\text{i} & 2-\\text{i} & 3 \\\\ -2-\\text{i} & 2-\\text{i} & -3\\text{i}\\end{aligned}]} \\\\  & =[\\begin{aligned}\\overset{―}{-4-2\\text{i}} & \\overset{―}{7+5\\text{i}} & \\overset{―}{6+6\\text{i}} \\\\ \\overset{―}{-4+5\\text{i}} & \\overset{―}{2-\\text{i}} & \\overset{―}{3} \\\\ \\overset{―}{-2-\\text{i}} & \\overset{―}{2-\\text{i}} & \\overset{―}{-3\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}-4+2\\text{i} & 7-5\\text{i} & 6-6\\text{i} \\\\ -4-5\\text{i} & 2+\\text{i} & 3 \\\\ -2+\\text{i} & 2+\\text{i} & 3\\text{i}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, ${b}_{23}+{b}_{33}=3+3\\text{i}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "31710d2c7ffd1f9d9081e048833f4c1b154f9f477e209030e29e66492e86d933"} {"question" "q-131184" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/activity-metadata.json" "file_sha256" "37ba5df55475007f46a653df2e9ada705233f87b3c21410d3cbcfaa3ff4acf79"} {"question" "q-131184" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-wo