ned}1+4\\text{i} \\\\ 4-\\text{i}\\end{aligned}]"] ["math" "[\\begin{aligned}1-4\\text{i} \\\\ 4+\\text{i}\\end{aligned}]"] ["math" "[\\begin{aligned}4+\\text{i} \\\\ -1+4\\text{i}\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "31710d2c7ffd1f9d9081e048833f4c1b154f9f477e209030e29e66492e86d933"} {"question" "q-140328" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}4+\\text{i} \\\\ -1+4\\text{i}\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "31710d2c7ffd1f9d9081e048833f4c1b154f9f477e209030e29e66492e86d933"} {"question" "q-76252" "field" nil "attribute" "question/problem" "value" "Given the matrix $A=[\\begin{aligned}1+\\text{i} & 0 \\\\ -3 & \\text{i}\\end{aligned}]$, find the result of applying to $A$ the following elementary row operations: \n\n$$\n{R}_{2}:={R}_{2}+\\frac{3}{1+\\text{i}}{R}_{1}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "31710d2c7ffd1f9d9081e048833f4c1b154f9f477e209030e29e66492e86d933"} {"question" "q-76252" "field" nil "attribute" "question/worked-solution" "value" "Let's apply the row operations to $A:$\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1+\\text{i} & 0 \\\\ -3 & \\text{i}\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{3}{1+\\text{i}}{R}_{1} \\\\  & ∼[\\begin{aligned}1+\\text{i} & 0 \\\\ -3+\\frac{3}{1+\\text{i}}\\cdot (1+\\text{i}) & \\text{i}\\end{aligned}] \\\\  & ∼[\\begin{aligned}1+\\text{i} & 0 \\\\ 0 & \\text{i}\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the result  is \n\n$$\n[\\begin{aligned}1+\\text{i} & 0 \\\\ 0 & \\text{i}\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/D