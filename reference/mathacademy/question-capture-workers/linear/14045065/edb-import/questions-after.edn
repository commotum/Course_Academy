ligned}-3-6\\text{i} & 2-7\\text{i} \\\\ 9 & 9+5\\text{i}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, ${b}_{12}+{b}_{22}=(2-7\\text{i})+(9+5\\text{i})=11-2\\text{i}.$"}] [{:db/id #edb/ref 17592186324412 :knowledge-point/_questions [{:knowledge-point/id #uuid "3c28b8ae-71ef-5d26-895a-5d949fc5b164" :knowledge-point/title "Computing Components of the Real and Imaginary Parts of a Complex Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f9c59ca-2a18-5b16-96e9-8efec5745ba1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 7 \\\\ -1 & 4\\end{aligned}]" :db/id #edb/ref 17592186324414} {:answer/id #uuid "7cb196bb-7dc6-554e-9e65-cc90a276eab2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 6 \\\\ -1 & 4\\end{aligned}]" :db/id #edb/ref 17592186324415} {:answer/id #uuid "4c291387-b63d-50cd-b8eb-edc5fa774e84" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 7 \\\\ 0 & 4\\end{aligned}]" :db/id #edb/ref 17592186324416} {:answer/id #uuid "b7635561-dac0-5029-a31d-38a4af5a0e6f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -6 \\\\ 0 & 4\\end{aligned}]" :db/id #edb/ref 17592186324417} {:answer/id #uuid "a09c222d-a05d-5683-b929-deea4abf6c53" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 7 \\\\ 1 & 4\\end{aligned}]" :db/id #edb/ref 17592186324418}] :answer-field/correct {:answer/id #uuid "4c291387-b63d-50cd-b8eb-edc5fa774e84" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 7 \\\\ 0 & 4\\end{aligned}]" :db/id #edb/ref 17592186324416} :answer-field/id #uuid "2cfc46d9-0938-5c5f-b702-2595aa055b0e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324413}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "58793c96-ddf8-519d-986f-39d6955284e1" :question/math-academy-id "q-76204" :question/problem "Find the real part of the matrix $A=[\\begin{aligned}1+2\\text{i} & 7-6\\text{i} \\\\ -\\text{i} & 4\\end{aligned}].$" :question/worked-solution "For the given matrix $A,$ we have that\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1+2\\text{i} & 7-6\\text{i} \\\\ -\\text{i} & 4\\end{aligned}] \\\\  & =[\\begin{aligned}1+2\\text{i} & 7-6\\text{i} \\\\ 0-\\text{i} & 4+0\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}1 & 7 \\\\ 0 & 4\\end{aligned}]}_{⏟}}_{\\text{Re}(A)}+\\text{i}{{[\\begin{aligned}2 & -6 \\\\ -1 & 0\\end{aligned}]}_{⏟}}_{\\text{Im}(A)}.\\end{aligned}\n$$\n\nTherefore, $\\text{Re}(A)=[\\begin{aligned}1 & 7 \\\\ 0 & 4\\end{aligned}].$"}] [{:db/id #edb/ref 17592186324419 :knowledge-point/_questions [{:knowledge-point/id #uuid "3c28b8ae-71ef-5d26-895a-5d949fc5b164" :knowledge-point/title "Computing Components of the Real and Imaginary Parts of a Complex Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53caa0c5-9596-5559-8a74-1e745fc7e6d5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 2 \\\\ 7 & -9\\end{aligned}]" :db/id #edb/ref 17592186324421} {:answer/id #uuid "4e453cea-4b6a-56cc-bdd3-10436338a851" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 0 \\\\ 7 & 9\\end{aligned}]" :db/id #edb/ref 17592186324422} {:answer/id #uuid "03624bc2-2701-54f7-8a7f-9dc832f4c2c7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 1 \\\\ 7 & 9\\end{aligned}]" :db/id #edb/ref 17592186324423} {:answer/id #uuid "f556ecba-cb01-5104-bf7d-294c1febfcd2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 0 \\\\ 7 & -9\\end{aligned}]" :db/id #edb/ref 17592186324424} {:answer/id #uuid "0996a2c1-0baa-590f-88d1-672ee46efa6c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 1 \\\\ 7 & -9\\end{aligned}]" :db/id #edb/ref 17592186324425}] :answer-field/correct {:answer/id #uuid "f556ecba-cb01-5104-bf7d-294c1febfcd2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 0 \\\\ 7 & -9\\end{aligned}]" :db/id #edb/ref 17592186324424} :answer-field/id #uuid "d96df35c-1ad9-5e88-af68-89b487e93f92" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324420}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a77c2c81-cff7-529c-9b2c-c83e582864a2" :question/math-academy-id "q-76205" :question/problem "Find the real part of the matrix $A=[\\begin{aligned}2-3\\text{i} & 2\\text{i} \\\\ 7 & -9+4\\text{i}\\end{aligned}].$" :question/worked-solution "For the given matrix $A,$ we have that\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2-3\\text{i} & 2\\text{i} \\\\ 7 & -9+4\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}2-3\\text{i} & 0+2\\text{i} \\\\ 7+0\\text{i} & -9+4\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}2 & 0 \\\\ 7 & -9\\end{aligned}]}_{⏟}}_{\\text{Re}(A)}+\\text{i}{{[\\begin{aligned}-3 & 2 \\\\ 0 & 4\\end{aligned}]}_{⏟}}_{\\text{Im}(A)}.\\end{aligned}\n$$\n\nTherefore, $\\text{Re}(A)=[\\begin{aligned}2 & 0 \\\\ 7 & -9\\end{aligned}].$"}] [{:db/id #edb/ref 17592186324426 :knowledge-point/_questions [{:knowledge-point/id #uuid "3c28b8ae-71ef-5d26-895a-5d949fc5b164" :knowledge-point/title "Computing Components of the Real and Imaginary Parts of a Complex Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31dacb7f-ffee-56ef-a296-f6d068c75df1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 4 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186324428} {:answer/id #uuid "2216500d-4e8b-5c0a-9096-bcd89fd13e53" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -4 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186324429} {:answer/id #uuid "42c0ca74-952f-5a3f-a415-9a7bd9153d6d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -4 \\\\ 9 & 1\\end{aligned}]" :db/id #edb/ref 17592186324430} {:answer/id #uuid "cc0c2339-52d1-5a56-9357-072bf7d64c3f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -4 \\\\ 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186324431} {:answer/id #uuid "355f7c6c-9f02-572c-b80c-7dc98f8bf53f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 4 \\\\ 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186324432}] :answer-field/correct {:answer/id #uuid "2216500d-4e8b-5c0a-9096-bcd89fd13e53" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -4 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186324429} :answer-field/id #uuid "89d5fdb2-d1be-532a-8e4c-e0ce5331f3cf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324427}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "388876f4-588c-5459-bbff-2e2430839d08" :question/math-academy-id "q-76207" :question/problem "Find the imaginary part of the matrix $A=[\\begin{aligned}8+\\text{i} & 3-4\\text{i} \\\\ 9 & \\text{i}\\end{aligned}].$" :question/worked-solution "For the given matrix $A,$ we have that\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}8+\\text{i} & 3-4\\text{i} \\\\ 9 & \\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}8+\\text{i} & 3-4\\text{i} \\\\ 9+0\\text{i} & 0+\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}8 & 3 \\\\ 9 & 0\\end{aligned}]}_{⏟}}_{\\text{Re}(A)}+\\text{i}{{[\\begin{aligned}1 & -4 \\\\ 0 & 1\\end{aligned}]}_{⏟}}_{\\text{Im}(A)}.\\end{aligned}\n$$\n\nTherefore, $\\text{Im}(A)=[\\begin{aligned}1 & -4 \\\\ 0 & 1\\end{aligned}].$"}] [{:db/id #edb/ref 17592186324433 :knowledge-point/_questions [{:knowledge-point/id #uuid "83fad21d-6b36-5198-a13f-362d34342475" :knowledge-point/title "Multiplying Complex Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a5192b11-0c65-5589-b16b-691a12644347" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1+2\\text{i} & -12-3\\text{i} \\\\ 12+\\text{i} & -3-3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324435} {:answer/id #uuid "7c7e32f9-f7f8-59a1-8f82-10be3bc5e0f5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1+2\\text{i} & 12+\\text{i} \\\\ -3-3\\text{i} & -12-3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324436} {:answer/id #uuid "5b48de7f-6121-545c-8720-e801c4dccee6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}12+\\text{i} & -3-3\\text{i} \\\\ -1+2\\text{i} & -12-3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324437} {:answer/id #uuid "cdb7110b-1c7a-5073-8e69-31482be6d032" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1+2\\text{i} & -3-3\\text{i} \\\\ 12+\\text{i} & -12-3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324438} {:answer/id #uuid "b881c37a-be92-5ac5-8f96-9bdda7aaaa77" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3-12\\text{i} & -3-3\\text{i} \\\\ 12+\\text{i} & 2-\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324439}] :answer-field/correct {:answer/id #uuid "cdb7110b-1c7a-5073-8e69-31482be6d032" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1+2\\text{i} & -3-3\\text{i} \\\\ 12+\\text{i} & -12-3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324438} :answer-field/id #uuid "f4ed1c7a-72c3-5509-b58a-fa3e74019766" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324434}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "7f5bcf1a-c003-5127-bfd3-0fe4d13aef40" :question/math-academy-id "q-76220" :question/problem "If $\\,A=[\\begin{aligned}-1-\\text{i} & -\\text{i} \\\\ 3 & -2+\\text{i}\\end{aligned}]\\,$ and $\\,B=[\\begin{aligned}1+\\text{i} & -3\\text{i} \\\\ -4-\\text{i} & 6\\end{aligned}]\\,$, then $AB=$" :question/worked-solution "Multiplying the matrices using the usual method, we get\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}-1-\\text{i} & -\\text{i} \\\\ 3 & -2+\\text{i}\\end{aligned}]\\cdot [\\begin{aligned}1+\\text{i} & -3\\text{i} \\\\ -4-\\text{i} & 6\\end{aligned}] \\\\  & =[\\begin{aligned}(-1-\\text{i})(1+\\text{i})+(-\\text{i})(-4-\\text{i}) & (-1-\\text{i})(-3\\text{i})+(-\\text{i})\\cdot 6 \\\\ 3\\cdot (1+\\text{i})+(-2+\\text{i})(-4-\\text{i}) & 3\\cdot (-3\\text{i})+(-2+\\text{i})\\cdot 6\\end{aligned}] \\\\  & =[\\begin{aligned}-2\\text{i}+(4\\text{i}-1) & (3\\text{i}-3)+(-6\\text{i}) \\\\ (3+3\\text{i})+(9-2\\text{i}) & (-9\\text{i})+(-12+6\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}-1+2\\text{i} & -3-3\\text{i} \\\\ 12+\\text{i} & -12-3\\text{i}\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186324440 :knowledge-point/_questions [{:knowledge-point/id #uuid "83fad21d-6b36-5198-a13f-362d34342475" :knowledge-point/title "Multiplying Complex Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5445583-7cae-5d34-a67f-70614754b2b9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4+6\\text{i} & 7-5\\text{i} \\\\ 8+6\\text{i} & -1-13\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324442} {:answer/id #uuid "29cb5c79-d63b-59bb-b68b-45ad61d4c9e0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1+13\\text{i} & 7+5\\text{i} \\\\ 8+6\\text{i} & 4+6\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324443} {:answer/id #uuid "b5d2e190-17b2-51b3-8319-9ba4fed94cd9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4+6\\text{i} & 8+6\\text{i} \\\\ 7-5\\text{i} & -1-13\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324444} {:answer/id #uuid "9ccc9e15-75bb-5c9c-bd71-373a223c949f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1-13\\text{i} & 7-5\\text{i} \\\\ 8+6\\text{i} & 4+6\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324445} {:answer/id #uuid "bdf260e0-032f-5d9c-9b90-01c4a971c948" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1-13\\text{i} & 8+6\\text{i} \\\\ 7-5\\text{i} & 4+6\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324446}] :answer-field/correct {:answer/id #uuid "9ccc9e15-75bb-5c9c-bd71-373a223c949f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1-13\\text{i} & 7-5\\text{i} \\\\ 8+6\\text{i} & 4+6\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324445} :answer-field/id #uuid "08dc7d36-4aab-51b3-b8c0-45d260b89c34" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324441}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "e93d1f28-d0c0-5126-b248-ca6895657c64" :question/math-academy-id "q-76223" :question/problem "If $\\,A=[\\begin{aligned}1-3\\text{i} & -1+2\\text{i} \\\\ 2+2\\text{i} & 1-\\text{i}\\end{aligned}]\\,$ and $\\,B=[\\begin{aligned}3-\\text{i} & 3+\\text{i} \\\\ -1+\\text{i} & 1-\\text{i}\\end{aligned}]\\,$, then $AB=$" :question/worked-solution "Multiplying the matrices using the usual method, we get\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}1-3\\text{i} & -1+2\\text{i} \\\\ 2+2\\text{i} & 1-\\text{i}\\end{aligned}]\\cdot [\\begin{aligned}3-\\text{i} & 3+\\text{i} \\\\ -1+\\text{i} & 1-\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}(1-3\\text{i})(3-\\text{i})+(-1+2\\text{i})(-1+\\text{i}) & (1-3\\text{i})(3+\\text{i})+(-1+2\\text{i})(1-\\text{i}) \\\\ (2+2\\text{i})(3-\\text{i})+(1-\\text{i})(-1+\\text{i}) & (2+2\\text{i})(3+\\text{i})+(1-\\text{i})(1-\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}-10\\text{i}+(-1-3\\text{i}) & (6-8\\text{i})+(1+3\\text{i}) \\\\ (8+4\\text{i})+2\\text{i} & (4+8\\text{i})+(-2\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}-1-13\\text{i} & 7-5\\text{i} \\\\ 8+6\\text{i} & 4+6\\text{i}\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186324447 :knowledge-point/_questions [{:knowledge-point/id #uuid "ef2e7753-83f4-5826-a04f-89616d34c578" :knowledge-point/title "Applying Row Operations to a Complex Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88467948-7c2f-5183-a55b-6a11764ec90c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186324449} {:answer/id #uuid "3221ed64-5409-52bc-9591-d74209d70c98" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1+\\text{i} & 0 \\\\ 0 & \\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324450} {:answer/id #uuid "c931d64d-6af8-544b-8df9-3b976ea8c2ee" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1+\\text{i} & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186324451} {:answer/id #uuid "70ac948a-9451-501c-af4c-8e9122449559" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 0 \\\\ 0 & \\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324452} {:answer/id #uuid "a007df91-53d7-5825-be0f-7622672a4954" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\text{i} & 0 \\\\ 0 & \\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324453}] :answer-field/correct {:answer/id #uuid "3221ed64-5409-52bc-9591-d74209d70c98" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1+\\text{i} & 0 \\\\ 0 & \\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324450} :answer-field/id #uuid "77ab877a-ecbd-5dc3-828b-75998939f215" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324448}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d863dac0-16be-50b8-a3a9-ff28a7c7d6d0" :question/math-academy-id "q-76252" :question/problem "Given the matrix $A=[\\begin{aligned}1+\\text{i} & 0 \\\\ -3 & \\text{i}\\end{aligned}]$, find the result of applying to $A$ the following elementary row operations: \n\n$$\n{R}_{2}:={R}_{2}+\\frac{3}{1+\\text{i}}{R}_{1}\n$$" :question/worked-solution "Let's apply the row operations to $A:$\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1+\\text{i} & 0 \\\\ -3 & \\text{i}\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{3}{1+\\text{i}}{R}_{1} \\\\  & ∼[\\begin{aligned}1+\\text{i} & 0 \\\\ -3+\\frac{3}{1+\\text{i}}\\cdot (1+\\text{i}) & \\text{i}\\end{aligned}] \\\\  & ∼[\\begin{aligned}1+\\text{i} & 0 \\\\ 0 & \\text{i}\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the result  is \n\n$$\n[\\begin{aligned}1+\\text{i} & 0 \\\\ 0 & \\text{i}\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186324454 :knowledge-point/_questions [{:knowledge-point/id #uuid "ef2e7753-83f4-5826-a04f-89616d34c578" :knowledge-point/title "Applying Row Operations to a Complex Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31aa0cff-1ddd-5ced-9f90-646f5db2454b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 0 & 8\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324456} {:answer/id #uuid "8d4331b5-4e68-59f1-9000-d9e0988f964a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 1 & 10-2\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324457} {:answer/id #uuid "cbd1088d-529f-5544-a6de-61ad24e0b157" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 1 \\\\ 0 & 8\\end{aligned}]" :db/id #edb/ref 17592186324458} {:answer/id #uuid "918629ca-edf5-51ba-bfda-fad453d89be7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 0 & 10-2\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324459} {:answer/id #uuid "492edb81-3eaa-5ed6-b7ea-2379504dcb2b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\text{i} & \\text{i} \\\\ 1 & 8\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324460}] :answer-field/correct {:answer/id #uuid "918629ca-edf5-51ba-bfda-fad453d89be7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 0 & 10-2\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324459} :answer-field/id #uuid "9765b53a-c71b-5934-b951-a33b74246774" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324455}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "92e367a3-8aab-5062-bdae-482777fab633" :question/math-academy-id "q-76254" :question/problem "Given the matrix $A=[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 7 & 3-2\\text{i}\\end{aligned}]$, find the result of applying to $A$ the following elementary row operations: \n\n$$\n{R}_{2}:={R}_{2}+\\frac{7}{\\text{i}}{R}_{1}\n$$" :question/worked-solution "Let's apply the row operations to $A:$\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 7 & 3-2\\text{i}\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{7}{\\text{i}}{R}_{1} \\\\  & ∼[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 7+(-\\text{i})\\cdot \\frac{7}{\\text{i}} & \\text{(}3-2\\text{i})+i\\cdot \\frac{7}{\\text{i}}\\end{aligned}] \\\\  & ∼[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 0 & 10-2\\text{i}\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the result  is \n\n$$\n[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 0 & 10-2\\text{i}\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186324461 :knowledge-point/_questions [{:knowledge-point/id #uuid "ef2e7753-83f4-5826-a04f-89616d34c578" :knowledge-point/title "Applying Row Operations to a Complex Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e80150d-14bf-5790-91ed-71534094caef" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1+2\\text{i} & 1+\\text{i} \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186324463} {:answer/id #uuid "ae53ef35-45ad-5c76-819f-59eb14082dac" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1+2\\text{i} & 1+\\text{i} \\\\ 0 & \\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324464} {:answer/id #uuid "bb79c029-3045-5993-8891-9e28987867cb" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1+2\\text{i} & 1+\\text{i} \\\\ 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186324465} {:answer/id #uuid "f6f1e063-c4b8-55fb-a2ad-ccd769e415d4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1+2\\text{i} & 1+\\text{i} \\\\ \\text{i} & \\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324466} {:answer/id #uuid "0ddcc229-69e1-5a65-8b3c-f630b7f354d2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1-2\\text{i} & 1+\\text{i} \\\\ \\text{i} & 1\\end{aligned}]" :db/id #edb/ref 17592186324467}] :answer-field/correct {:answer/id #uuid "4e80150d-14bf-5790-91ed-71534094caef" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1+2\\text{i} & 1+\\text{i} \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186324463} :answer-field/id #uuid "2b615a81-067b-54e0-b1e9-8f604e402f57" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324462}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "8dacc1d4-24b7-57a9-9014-dfb4a179d2b2" :question/math-academy-id "q-76256" :question/problem "Given the matrix $A=[\\begin{aligned}1+2\\text{i} & 1+\\text{i} \\\\ -2+\\text{i} & \\text{i}\\end{aligned}]$, find the result of applying to $A$ the following elementary row operation:\n\n$$\n{R}_{2}:={R}_{2}+\\frac{2-\\text{i}}{1+2\\text{i}}{R}_{1}\n$$" :question/worked-solution "Let's apply the row operations to $A:$\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1+2\\text{i} & 1+\\text{i} \\\\ -2+\\text{i} & \\text{i}\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{2-\\text{i}}{1+2\\text{i}}{R}_{1} \\\\  & ∼[\\begin{aligned}1+2\\text{i} & 1+\\text{i} \\\\ -2+\\text{i}+\\frac{(2-\\text{i})(1+2\\text{i})}{1+2\\text{i}} & \\text{i}+\\frac{(2-\\text{i})(1+\\text{i})}{1+2\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}1+2\\text{i} & 1+\\text{i} \\\\ 0 & \\frac{(\\text{i}-2)+(3+\\text{i})}{1+2\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}1+2\\text{i} & 1+\\text{i} \\\\ 0 & 1\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the result  is \n\n$$\n[\\begin{aligned}1+2\\text{i} & 1+\\text{i} \\\\ 0 & 1\\end{aligned}].\n$$"}]}
