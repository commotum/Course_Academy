04778"] :db/ensure [:knowledge-point/validate]} {:db/id "q-96741/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "d4cfa53f-bc23-534f-9f3b-33e7aff0d589" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-96741/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "c7e177de-562f-5ddb-bf33-dbe15f1c995c" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-96741/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "736ddfbe-1ed5-5d1e-a718-2a9e13a5996a" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-96741/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "7817d247-fcf1-50c7-9b63-9eb716a5c516" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-96741/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "cf76de5f-1260-5e97-8e2c-8de2abb911cd" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-96741/selection" :answer-field/id #uuid "0cf9cb95-400a-5a38-abc6-a84b7fca1368" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-96741/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer-field/choices ["q-96741/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-96741/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-96741/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-96741/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-96741/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c"] :db/ensure [:answer-field/validate]} {:db/id "q-96741" :question/id #uuid "5e0de236-3312-5e3d-962b-5a388a311795" :question/math-academy-id "q-96741" :question/problem "Which of the following functions has the codomain ${-1,1}?$\n\n- $p:{-1,1}\\to R$\n- $q:R\\to [-1,1)$\n- $r:[-1,1)\\to {-1,1}$" :question/worked-solution "The notation $f:X\\to Y$ means that the function $f$ maps the set $X$ to the set $Y.$ In this case,\n\n- the domain of $f$ is $X,$\n\n- the codomain of $f$ is $Y.$\n\nWith that in mind, let's examine our functions.\n\n- The codomain of $p$ is $R,$ the set of real numbers.\n\n- The codomain of $q$ is $[-1,1),$ the interval from $-1$ to $1$ (including $-1$ but not including $1$).\n\n- The codomain of $r$ is ${-1,1},$ the set containing the two numbers $-1$ and $1$ only.\n\nTherefore, the correct answer is \"III only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-96741/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bbac348b-629f-52a1-9bb3-0d3f8483ff44"] :knowledge-point/questions ["q-96741"] :db/ensure [:knowledge-point/validate]} {:db/id "q-96760/selection/7895acf5293405bf1efff2437038c4b20e7b3a7232572aa20030f9c7e9c8be0f" :answer/id #uuid "1cfb8db6-c2af-52a5-a041-8c3487d9d723" :answer/type :answer.type/math :answer/value "f:{0,1}\\to R" :db/ensure [:answer/validate]} {:db/id "q-96760/selection/ea8aa082a2f2d66a5fd845f32f11e0cb3700063567ba0e8c5a5bb43c7d9a2c26" :answer/id #uuid "506a9025-5248-5c26-a114-ef6aff6891d5" :answer/type :answer.type/math :answer/value "f:R\\to [0,1]" :db/ensure [:answer/validate]} {:db/id "q-96760/selection/c0e33dd8d98961bbbd9ecbf9c525b0164999055b1ddf13811d6f71a57ca29e39" :answer/id #uuid "84472d08-8400-5c0c-b2f9-860f8326e0f9" :answer/type :answer.type/math :answer/value "f:R\\to (0,1)" :db/ensure [:answer/validate]} {:db/id "q-96760/selection/aa15b4d55c9387d17d3bc9a93715cd4cb1275e677f0c6a4b980d19b7ff3efaa6" :answer/id #uuid "ca81f5c9-f737-50a4-8624-cfbf53b05880" :answer/type :answer.type/math :answer/value