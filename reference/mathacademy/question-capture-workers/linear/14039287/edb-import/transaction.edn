015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-104945/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6"] :db/ensure [:answer-field/validate]} {:db/id "q-104945" :question/id #uuid "7782f49b-6c7d-5cc6-8bc2-01016218b1c7" :question/math-academy-id "q-104945" :question/problem "Which of the following is the correct interpretation of $g:{0,1}\\to Z?$\n\n- The domain of $g$ is ${0,1}$\n- The codomain of $g$ is $Z$\n- The range of $g$ is ${0,1}$" :question/worked-solution "The notation \n\n$$\ng:{0,1}\\to Z\n$$\n\nmeans that the function $g$ maps the set ${0,1}$ to the set $Z.$ In this case,\n\n- the domain of $g$ is ${0,1},$ and\n\n- the codomain of $g$ is $Z.$ Note that ${0,1}⊆Z$ is *not* necessarily the range.\n\nAs a result, statements I and II are true, while statement III is false.\n\nTherefore, the correct answer is \"I and II only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-104945/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1240e42a-92a5-51cc-a80e-3fe1ef0b16f7"] :knowledge-point/questions ["q-104945"] :db/ensure [:knowledge-point/validate]} {:db/id "q-96826/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "f0ab4f89-f408-5968-b91d-76ceeee573fa" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-96826/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "59aff3bd-4d7e-52d8-9684-11b12ede5892" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-96826/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "e4b26e1b-e89f-596c-a84b-5948596b7658" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-96826/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "f18200a4-8b75-5967-8e15-99a45c49adae" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-96826/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "6e8f7939-f58e-5229-9e1e-36a37281a319" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-96826/selection" :answer-field/id #uuid "5ca6bae2-94ea-589e-b40b-d3c9ef07553c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-96826/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer-field/choices ["q-96826/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-96826/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-96826/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-96826/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-96826/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6"] :db/ensure [:answer-field/validate]} {:db/id "q-96826" :question/id #uuid "4dc1b813-bafc-58ed-ba25-aa80143f8224" :question/math-academy-id "q-96826" :question/problem "Which of the following is the correct interpretation of $g:R\\to R?$\n\n- The domain of $g$ is $R$\n- The codomain of $g$ is $R$\n- The range of $g$ is $R$" :question/worked-solution "The notation \n\n$$\ng:R\\to R\n$$\n\nmeans that the function $g$ maps the set $R$ to the set $R.$ In this case,\n\n- the domain of $g$ is $R,$ and\n\n- the codomain of $g$ is $R.$ Note that this is *not* necessarily the range.\n\nAs a result, statements I and II are true, while statement III is false.\n\nTherefore, the correct answer is \"I and II only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-96826/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1240e42a-92a5-51cc-a80e-3fe1ef0b16f7"] :knowledge-point/questions ["q-96826"] :db/ensure [:knowledge-point/validate]} {:db/id "q-104954/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "c9e18915-94d8-59b8-89e4-e2d79544abdd" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-104954/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "727cb258-0e75-5854-a03b-a05f2a7ebcc9" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-104954/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "595728f8-d9c7-54c9-8ee3-394724a9d9e3" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-104954/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "d9377612-74f1-536a-918e-4f4b46a21318" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-104954/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "671b81a7-4920-5158-8701-ed322c54c773" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-104954/selection" :answer-field/id #uuid "0db130e5-b590-5d33-b222-c1521597c1f4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-104954/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer-field/choices ["q-104954/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-104954/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-104954/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-104954/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-104954/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981"] :db/ensure [:answer-field/validate]} {:db/id "q-104954" :question/id #uuid "44c659b0-02a0-5558-84be-8148a9610549" :question/math-academy-id "q-104954" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039287/assets/8ff01afa1993f8e301edb69e3e7a13ee71ab01b1a3da416aa53ee94d021184e1.png)\n\nConsider the function $g:X\\to Y$ given by the mapping diagram shown above. Which of the following statements are true?\n\n- The domain of $g$ is ${0,1,2}$\n- The codomain of $g$ is ${-1,0,1,2}$\n- The range of $g$ is ${0,1,2}$" :question/worked-solution "The notation $g:X\\to Y$ means that the function $g$ maps the set $X$ to the set $Y.$ In this case,\n\n- the domain of $g$ is $X,$\n\n- the codomain of $g$ is $Y.$\n\nThe range of $g$ is the subset of the codomain that contains all values $y\\in Y$ that are mapped to by at least one element $x\\in X.$\n\nWith that in mind, let's inspect our diagram:\n\n- the domain of $g$ is $X={-1,0,1,2},$\n\n- the codomain of $g$ is $Y={0,1,2},$\n\n- the range of $g$ is ${0,1,2},$ the subset of elements of $Y$ that have at least one incoming arrow.\n\nAs a result, statements I and II are false, while statement III is true.\n\nTherefore, the correct answer \"III only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-104954/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1240e42a-92a5-51cc-a80e-3fe1ef0b16f7"] :knowledge-point/questions ["q-104954"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-8474"] :question/problem "Which of the following functions has the codomain $[0,1]?$\n\n- $p: \\{ 0, 1 \\} \\to \\mathbb{R}$\n\n- $q: \\mathbb{R} \\to [ 0, 1 ]$\n\n- $r: [0,1] \\to [ 0, 1 )$" :question/worked-solution "The notation $f: X \\to Y$ means that the function $f$ maps the set $X$ to the set $Y.$ In this case,\n\n- the domain of $f$ is $X,$\n\n- the codomain of $f$ is $Y.$\n\nWith that in mind, let's examine our functions.\n\n- The codomain of $p$ is $\\mathbb{R},$ the set of real numbers.\n\n- The codomain of $q$ is $[ 0, 1 ],$ the interval from $0$ and $1$ (including $0$ and $1$).\n\n- The codomain of $r$ is $[ 0, 1),$ the interval from $0$ to $1$ (including $0$ but not including $1$).\n\nTherefore, the correct answer is \"II only.\"" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8475"] :question/problem "Which of the following is the correct symbolic notation for the sentence given below?\n\n$\\qquad$ *\"The function $g$ maps the set of rational numbers to the set $Y$.\"*\n\n- $g:\\mathbb{Q} \\to Y$\n\n- $g: Y \\to \\mathbb{Q}$\n\n- $g:\\mathbb{R} \\to Y$" :question/worked-solution "The sentence *\"The function $g$ maps the set of rational numbers to the set $Y$\"* is equivalent to the following symbolic notation:\n\n$\\qquad$ $g:\\mathbb{Q} \\to Y$\n\nHere, the domain of $g$ is $\\mathbb Q,$ and the codomain of $g$ is $Y.$\n\nTherefore, the correct answer is \"I only\"." :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8476"] :question/problem "Which of the following is equivalent to $g(x)=x-x^3?$\n\n- $g:x \\mapsto x-x^3$\n\n- $g:x \\mapsto -x^3$\n\n- $g:-x \\mapsto x^3$" :question/worked-solution "The notation $g(x)=x-x^3$ means that the function $g$ maps the element $x$ in the domain to $x-x^3$ in the codomain. This can also be written as\n\n$$\ng:x \\mapsto x-x^3.\n$$\n\nTherefore, the correct answer is \"I only.\"" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8487"] :question/problem "Which of the following is the correct interpretation of $g: \\{ -1,0,1 \\} \\to \\mathbb{R}?$\n\n- The domain of $g$ is $\\{ -1,0,1 \\}$\n\n- The codomain of $g$ is $\\mathbb{R}$\n\n- The range of $g$ is $\\mathbb{R}$" :question/worked-solution "The notation \n\n$$\ng: \\{ -1,0,1 \\} \\to \\mathbb{R}\n$$\n\nmeans that the function $g$ maps the set $\\{ -1,0,1 \\}$ to the set $\\mathbb{R}.$ In this case,\n\n- the domain of $g$ is $\\{ -1,0,1 \\},$ and\n\n- the codomain of $g$ is $\\mathbb{R}.$ Note that this is *not* necessarily the range.\n\nAs a result, statements I and II are true, while statement III is false.\n\nTherefore, the correct answer is \"I and II only.\"" :db/ensure [:question/validate]}]
