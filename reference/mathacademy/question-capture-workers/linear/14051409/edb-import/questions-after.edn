uid "e9946520-29e9-5637-b8a5-a14293faf506" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186195920}] :answer-field/correct {:answer/id #uuid "e9946520-29e9-5637-b8a5-a14293faf506" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186195920} :answer-field/id #uuid "83cbc463-f8c8-557e-a9f7-06e07ab2de6f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186195915} {:answer-field/choices [{:answer/id #uuid "a722b505-37c7-5340-b441-d511a4028142" :answer/type {:db/ident :answer.type/math} :answer/value "C" :db/id #edb/ref 17592186195922} {:answer/id #uuid "c5306057-b00b-5e31-9775-2805c557a2ce" :answer/type {:db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186195923} {:answer/id #uuid "d3c7c7c5-5753-5d9d-bb28-dc7d4ebf3dd2" :answer/type {:db/ident :answer.type/math} :answer/value "Q" :db/id #edb/ref 17592186195924} {:answer/id #uuid "49e20331-598e-59b8-bc11-7bf36d298b05" :answer/type {:db/ident :answer.type/math} :answer/value "N" :db/id #edb/ref 17592186195925}] :answer-field/correct {:answer/id #uuid "49e20331-598e-59b8-bc11-7bf36d298b05" :answer/type {:db/ident :answer.type/math} :answer/value "N" :db/id #edb/ref 17592186195925} :answer-field/id #uuid "0ccba4c8-34cd-5504-8a4b-4b078be93eb5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186195921}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "55adfa30-bde9-5dd7-8854-b990477f8d63" :question/math-academy-id "q-183325" :question/problem "Describe the set $S={5,6,7,...,50}$ using a conditional definition.\n\n$$\nS={x\\in {{field-1}}\\,:\\,{{field-2}}\\le x\\le {{field-3}}}\n$$" :question/worked-solution "The set $S$ contains all natural numbers between $5$ and $50$ (including $5$ and $50$).\n\nTherefore, the set can be written as\n\n$$\nS={x\\in N\\,:\\,5\\le x\\le 50}.\n$$\n\n**Note**: This definition is not unique. For example:\n\n- We can write $x\\in Z.$ This gives\n\n$$\nS={x\\in Z\\,:\\,5\\le x\\le 50}.\n$$\n\n- We can write $4<x<51.$ This gives\n\n$$\nS={x\\in N\\,:\\,4<x<51},\n$$\n\nor, writing $x\\in Z$ as before, we have\n\n$$\nS={x\\in Z\\,:\\,4<x<51}.\n$$"}] [{:db/id #edb/ref 17592186198770 :knowledge-point/_questions [{:knowledge-point/id #uuid "1c5b3eb6-187f-5f16-a32e-66b0842adfe9" :knowledge-point/title "Expressing a Given Set Using an Arithmetic Sequence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9cf456da-1fd7-5daf-b0c9-40ae1e929a2e" :answer/type {:db/ident :answer.type/math} :answer/value "n" :db/id #edb/ref 17592186195927} {:answer/id #uuid "e3397619-e582-520b-a0cc-e863374832ad" :answer/type {:db/ident :answer.type/math} :answer/value "2n − 1" :db/id #edb/ref 17592186195928} {:answer/id #uuid "fc7a6f6b-79f5-5e85-9294-7d079a2db424" :answer/type {:db/ident :answer.type/math} :answer/value "2n + 1" :db/id #edb/ref 17592186195929} {:answer/id #uuid "08fd2a26-b0c0-568d-bd19-2ae00e30f43e" :answer/type {:db/ident :answer.type/math} :answer/value "2n" :db/id #edb/ref 17592186195930} {:answer/id #uuid "429e57fc-b163-5b85-b626-e6846e24e1a7" :answer/type {:db/ident :answer.type/math} :answer/value "2n + 3" :db/id #edb/ref 17592186195931}] :answer-field/correct {:answer/id #uuid "fc7a6f6b-79f5-5e85-9294-7d079a2db424" :answer/type {:db/ident :answer.type/math} :answer/value "2n + 1" :db/id #edb/ref 17592186195929} :answer-field/id #uuid "2dcad5ab-c2bd-5b9e-bce4-22f23e50cff4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186195926} {:answer-field/choices [{:answer/id #uuid "699bf6eb-29ba-5b54-a3c9-7ec84dcf1d91" :answer/type {:db/ident :answer.type/math} :answer/value "\\in R" :db/id #edb/ref 17592186336057} {:answer/id #uuid "48979afb-5d74-5496-a277-2c845ad0d277" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{is even}" :db/id #edb/ref 17592186336058} {:answer/id #uuid "9872363f-9fe5-5649-a551-2d2cfa7563bc" :answer/type {:db/ident :answer.type/math} :answer/value "\\in N" :db/id #edb/ref 17592186336059} {:answer/id #uuid "9ec1448f-91b7-58b9-8b0e-94b4f5f0b536" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{is odd}" :db/id #edb/ref 17592186336060} {:answer/id #uuid "4885f03e-bc75-5736-a212-aa5e911535d9" :answer/type {:db/ident :answer.type/math} :answer/value "\\in Z" :db/id #edb/ref 17592186336061}] :answer-field/correct {:answer/id #uuid "9872363f-9fe5-5649-a551-2d2cfa7563bc" :answer/type {:db/ident :answer.type/math} :answer/value "\\in N" :db/id #edb/ref 17592186336059} :answer-field/id #uuid "60f657ba-ef18-5ccd-a35d-d8b347b7116c" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186336056}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ebac24bb-90f7-58ac-a1b2-eb2724156186" :question/math-academy-id "q-183327" :question/problem "Describe the set $S={3,5,7,9,11,...}$ using a constructive definition.\n\n$$\nS={{{field-1}}\\,:\\,n\\,{{field-2}}}\n$$" :question/worked-solution "Notice that the elements of our set\n\n$$\n3,\\,5,\\,7,\\,11,\\,…\n$$\n\nform an arithmetic sequence with common difference $d=2:$\n\n$$\n\\begin{aligned}d & =2 \\\\  & =5-3 \\\\  & =7-5 \\\\  & =⋯\\end{aligned}\n$$\n\nTherefore, the $n$th term ${a}_{n}$ of our sequence for $n\\in N,n\\ge 1$ is given by\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)\\cdot d \\\\  & =3+(n-1)\\cdot 2 \\\\  & =3+2n-2 \\\\  & =2n+1.\\end{aligned}\n$$\n\nTherefore, we can define our set using a constructive definition as follows:\n\n$$\nS={2n+1\\,:\\,n\\in N}\n$$"}] [{:db/id #edb/ref 17592186336062 :knowledge-point/_questions [{:knowledge-point/id #uuid "ad21350b-2e3b-57ee-a28c-32a7bd1b2513" :knowledge-point/title "Defining a Set Conditionally Using the Roots of a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d6621c4-a07c-571d-8823-fe693d8e0a02" :answer/type {:db/ident :answer.type/math} :answer/value "3+3\\sqrt{2}" :db/id #edb/ref 17592186336064} {:answer/id #uuid "824fad63-0ebf-5007-91c0-2a7d48c090a0" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186336065}] :answer-field/correct {:answer/id #uuid "4d6621c4-a07c-571d-8823-fe693d8e0a02" :answer/type {:db/ident :answer.type/math} :answer/value "3+3\\sqrt{2}" :db/id #edb/ref 17592186336064} :answer-field/id #uuid "e07b471d-78a8-5913-9810-a3bf1ddb77c0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186336063} {:answer-field/choices [{:answer/id #uuid "014ec205-d1c7-569d-991e-378843824737" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186336067}] :answer-field/correct {:answer/id #uuid "014ec205-d1c7-569d-991e-378843824737" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186336067} :answer-field/id #uuid "e643250c-67dc-5eba-96cc-e35bb05f062c" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186336066}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b6ca7f56-21b3-5216-a2b0-306b24a6b696" :question/math-academy-id "q-183728" :question/problem "Find the missing coefficients in the conditional definition of the set ${1,\\sqrt{2}}$ given below.\n\n${1,\\sqrt{2}}={x\\in R\\,:\\,3{x}^{2}\\,-$\n{{field-1}}\n$x\\,+$\n{{field-2}}\n$=0}$" :question/worked-solution "The given set contains the roots $x\\in R$ of some quadratic polynomial $p(x).$\n\nSince the polynomial has roots ${x}_{1}=1$ and ${x}_{2}=\\sqrt{2},$ and the coefficient of the quadratic term is $a=3,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}p(x) & =a(x-{x}_{1})(x-{x}_{2}) \\\\  & =3(x-1)(x-\\sqrt{2}) \\\\  & =3({x}^{2}-(\\sqrt{2}+1)x+\\sqrt{2}) \\\\  & =3{x}^{2}-3(\\sqrt{2}+1)x+3\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, we can express the given set as follows:\n\n$$\n{1,\\sqrt{2}}={x\\in R\\,:\\,3{x}^{2}-3(\\sqrt{2}+1)x+3\\sqrt{2}=0}\n$$"}] [{:db/id #edb/ref 17592186336068 :knowledge-point/_questions [{:knowledge-point/id #uuid "ad21350b-2e3b-57ee-a28c-32a7bd1b2513" :knowledge-point/title "Defining a Set Conditionally Using the Roots of a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "476194df-0b1a-5976-8cbe-4dc5fc868140" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186336070}] :answer-field/correct {:answer/id #uuid "476194df-0b1a-5976-8cbe-4dc5fc868140" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186336070} :answer-field/id #uuid "b72edfe8-46d4-5502-8d98-484e0ba36565" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186336069} {:answer-field/choices [{:answer/id #uuid "035d0891-ae01-544d-aae8-24dd4104ef0f" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186336072}] :answer-field/correct {:answer/id #uuid "035d0891-ae01-544d-aae8-24dd4104ef0f" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186336072} :answer-field/id #uuid "736ab067-9adf-54b4-a07f-0396ff269b17" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186336071}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b30719fb-e464-5870-9e0a-b27486e0ebd9" :question/math-academy-id "q-183729" :question/problem "Find the missing coefficients in the conditional definition of the set ${-\\sqrt{3},\\sqrt{3}}$ given below.\n\n${-\\sqrt{3},\\sqrt{3}}={x\\in R\\,:\\,2{x}^{2}\\,+$\n{{field-1}}\n$x\\,-$\n{{field-2}}\n$=0}$" :question/worked-solution "The given set contains the roots $x\\in R$ of some quadratic polynomial $p(x).$\n\nSince the polynomial has roots ${x}_{1}=-\\sqrt{3}$ and ${x}_{2}=\\sqrt{3},$ and the coefficient of the quadratic term is $a=2,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}p(x) & =a(x-{x}_{1})(x-{x}_{2}) \\\\  & =2(x-(-\\sqrt{3}))(x-\\sqrt{3}) \\\\  & =2(x+\\sqrt{3})(x-\\sqrt{3}) \\\\  & =2({x}^{2}-\\sqrt{3}x+\\sqrt{3}x-(\\sqrt{3})^{2}) \\\\  & =2({x}^{2}+0x-3) \\\\  & =2{x}^{2}+0x-6\\end{aligned}\n$$\n\nTherefore, we can express the given set as follows:\n\n$$\n{-\\sqrt{3},\\sqrt{3}}={x\\in R\\,:\\,2{x}^{2}+0x-6=0}\n$$"}] [{:db/id #edb/ref 17592186336073 :knowledge-point/_questions [{:knowledge-point/id #uuid "9df722a8-2db6-5bb8-a69c-b81b33037ab2" :knowledge-point/title "Expressing a Given Set Using a Geometric Sequence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b8a2176-6f37-5bd2-b468-b232ff66f4c7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\cdot {2}^{n}" :db/id #edb/ref 17592186336075} {:answer/id #uuid "c29092af-c3a8-59ed-841e-9398c3d777b5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\cdot {4}^{n}" :db/id #edb/ref 17592186336076} {:answer/id #uuid "49cc6f5a-fd37-5042-bedb-987180f36620" :answer/type {:db/ident :answer.type/math} :answer/value "4\\cdot {2}^{n}" :db/id #edb/ref 17592186336077} {:answer/id #uuid "18757baa-72bd-5947-aecb-1ed04c9032a9" :answer/type {:db/ident :answer.type/math} :answer/value "4\\cdot {(\\frac{1}{2})}^{n}" :db/id #edb/ref 17592186336078}] :answer-field/correct {:answer/id #uuid "18757baa-72bd-5947-aecb-1ed04c9032a9" :answer/type {:db/ident :answer.type/math} :answer/value "4\\cdot {(\\frac{1}{2})}^{n}" :db/id #edb/ref 17592186336078} :answer-field/id #uuid "25c44860-4495-5018-926b-91c176bb4aec" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186336074} {:answer-field/choices [{:answer/id #uuid "47fe78dc-0b22-5f03-a3b8-34b48f8321d4" :answer/type {:db/ident :answer.type/math} :answer/value "N" :db/id #edb/ref 17592186336080} {:answer/id #uuid "af8d7ffb-484d-5039-8a43-7172385ee56e" :answer/type {:db/ident :answer.type/math} :answer/value "Q" :db/id #edb/ref 17592186336081} {:answer/id #uuid "2e25ef17-f244-562e-b128-5b72672f2467" :answer/type {:db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186336082}] :answer-field/correct {:answer/id #uuid "47fe78dc-0b22-5f03-a3b8-34b48f8321d4" :answer/type {:db/ident :answer.type/math} :answer/value "N" :db/id #edb/ref 17592186336080} :answer-field/id #uuid "db3d13d5-1db6-5d71-9635-7aa3e7ec7648" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186336079}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f8edf910-c411-534b-97f2-739a78146702" :question/math-academy-id "q-183792" :question/problem "Describe the set $S={2,1,\\frac{1}{2},\\frac{1}{4},...}$ using a constructive definition.\n\n$$\nS={{{field-1}}\\,:\\,n\\in {{field-2}}}\n$$" :question/worked-solution "Notice that the elements of our set\n\n$$\n2,\\,1,\\,\\frac{1}{2},\\,\\frac{1}{4},\\,…\n$$\n\nform an infinite geometric sequence with a common ratio $r=\\frac{1}{2}:$\n\n$$\n\\begin{aligned}r & =\\frac{1}{2} \\\\  & =\\frac{\\frac{1}{2}}{1} \\\\  & =\\frac{\\frac{1}{4}}{\\frac{1}{2}} \\\\  & =⋯\\end{aligned}\n$$\n\nTherefore, the $n$th term ${a}_{n}$ of our sequence for $n\\in N,$ is given by\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}\\cdot {r}^{n-1} \\\\  & =2\\cdot {(\\frac{1}{2})}^{n-1} \\\\  & =2\\cdot {(\\frac{1}{2})}^{n}\\cdot {(\\frac{1}{2})}^{-1} \\\\  & =4\\cdot {(\\frac{1}{2})}^{n}.\\end{aligned}\n$$\n\nTherefore, we can define our set using a constructive definition as follows:\n\n$$\nS={4\\cdot {(\\frac{1}{2})}^{n}\\,:\\,n\\in N}\n$$"}]}
