 & -7 & 11 & 1\\end{aligned}],\\,U=[\\begin{aligned}-5 & 6 & -5 & 6 \\\\ 0 & 2 & -7 & 1 \\\\ 0 & 0 & -5 & 2 \\\\ 0 & 0 & 0 & -10\\end{aligned}].\n$$\n\nFinally, since ${l}_{42}=-7$ and ${u}_{22}=2,$ we get\n\n$$\n{l}_{42}\\cdot {u}_{22}=(-7)\\cdot 2=-14.\n$$" 13194139535795 true] [17592186366643 1000 #edb/ref 17592186366644 13194139535795 true] [17592186366643 1000 #edb/ref 17592186366645 13194139535795 true] [17592186366643 1000 #edb/ref 17592186366646 13194139535795 true] [17592186366643 1000 #edb/ref 17592186366647 13194139535795 true] [17592186366643 1000 #edb/ref 17592186366648 13194139535795 true] [17592186366643 1040 #edb/ref 17592186045450 13194139535795 true] [17592186366643 1041 "selection" 13194139535795 true] [17592186366643 1104 #edb/ref 17592186366645 13194139535795 true] [17592186366643 1110 #uuid "1c6aa21c-8702-56f1-a917-8e0127b63aef" 13194139535795 true] [17592186366644 1034 "20" 13194139535795 true] [17592186366644 1103 #edb/ref 17592186045453 13194139535795 true] [17592186366644 1111 #uuid "d712261b-34a8-5846-ae63-7c1b218c7943" 13194139535795 true] [17592186366645 1034 "-14" 13194139535795 true] [17592186366645 1103 #edb/ref 17592186045453 13194139535795 true] [17592186366645 1111 #uuid "4ce6b89c-3516-55d5-b0d9-74c5349645e5" 13194139535795 true] [17592186366646 1034 "7" 13194139535795 true] [17592186366646 1103 #edb/ref 17592186045453 13194139535795 true] [17592186366646 1111 #uuid "292fc26e-afc3-5225-a525-81ca780ab67a" 13194139535795 true] [17592186366647 1034 "35" 13194139535795 true] [17592186366647 1103 #edb/ref 17592186045453 13194139535795 true] [17592186366647 1111 #uuid "5f5f48c6-482d-5723-b2be-234c7eacde02" 13194139535795 true] [17592186366648 1034 "0" 13194139535795 true] [17592186366648 1103 #edb/ref 17592186045453 13194139535795 true] [17592186366648 1111 #uuid "3cb87fc2-b747-5221-b9bc-0099f4540086" 13194139535795 true] [17592186366649 1017 #edb/ref 17592186366650 13194139535795 true] [17592186366649 1089 "q-32742" 13194139535795 true]