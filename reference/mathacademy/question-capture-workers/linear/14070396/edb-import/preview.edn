 & -7 \\\\ -1 & -2 & -2 & 2 \\\\ 0 & -4 & -8 & 11 \\\\ 0 & -2 & -2 & -1\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}4 & 5 & -5 & -7 \\\\ -1 & -2 & -2 & 2 \\\\ 0 & \\,2\\, & -4 & 7 \\\\ 0 & -2 & -2 & -1\\end{aligned}] & {R}_{4} & :={R}_{4}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}4 & 5 & -5 & -7 \\\\ -1 & -2 & -2 & 2 \\\\ 0 & \\,2\\, & -4 & 7 \\\\ 0 & \\,1\\, & 0 & -3\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\nL=[\\begin{aligned}1 & 0 & 0 & 0 \\\\ -1 & 1 & 0 & 0 \\\\ 0 & 2 & 1 & 0 \\\\ 0 & 1 & 0 & 1\\end{aligned}],\\,U=[\\begin{aligned}4 & 5 & -5 & -7 \\\\ 0 & -2 & -2 & 2 \\\\ 0 & 0 & -4 & 7 \\\\ 0 & 0 & 0 & -3\\end{aligned}].\n$$\n\nFinally, since ${l}_{32}=2$ and ${u}_{33}=-4,$ we get\n\n$$\n{l}_{32}\\cdot {u}_{33}=2\\cdot (-4)=-8.\n$$" 13194139535795 true] [17592186366636 1000 #edb/ref 17592186366637 13194139535795 true] [17592186366636 1000 #edb/ref 17592186366638 13194139535795 true] [17592186366636 1000 #edb/ref 17592186366639 13194139535795 true] [17592186366636 1000 #edb/ref 17592186366640 13194139535795 true] [17592186366636 1000 #edb/ref 17592186366641 13194139535795 true] [17592186366636 1040 #edb/ref 17592186045450 13194139535795 true] [17592186366636 1041 "selection" 13194139535795 true] [17592186366636 1104 #edb/ref 17592186366637 13194139535795 true] [17592186366636 1110 #uuid "8b20228f-bbfb-5aa8-921a-6b2206c3c741" 13194139535795 true] [17592186366637 1034 "-8" 13194139535795 true] [17592186366637 1103 #edb/ref 17592186045453 13194139535795 true] [17592186366637 1111 #uuid "3c6dd661-0948-58aa-890c-ff68b1d2e364" 13194139535795 true] [17592186366638 1034 "7" 13194139535795 true] [17592186366638 1103 #edb/ref 17592186045453 13194139535795 true] [17592186366638 1111 #uuid "65d99ccd-7946-53d9-b14c-8b0dea92af34" 13194139535795 true] [17592186366639 1034 "14" 13194139535795 true] [17592186366639 1103 #edb/ref 17592186045453 13194139535795 true] [17592186366639 1111 #uuid "af3474e1-7e35-5313-9630-1d800c2752e1" 