496a" 13194139534645 true] [17592186301028 1034 "$R$ and $C$ only" 13194139534645 true] [17592186301028 1103 #edb/ref 17592186045454 13194139534645 true] [17592186301028 1111 #uuid "8f9235de-2197-5ae9-bd27-c0d6a14174c8" 13194139534645 true] [17592186301029 1034 "$N$ and $C$ only" 13194139534645 true] [17592186301029 1103 #edb/ref 17592186045454 13194139534645 true] [17592186301029 1111 #uuid "a1c9bf12-b239-5054-97da-4d2b72922407" 13194139534645 true] [17592186301030 1034 "$R$ only" 13194139534645 true] [17592186301030 1103 #edb/ref 17592186045454 13194139534645 true] [17592186301030 1111 #uuid "a2edc4de-f475-51c6-a33c-52ef8777e773" 13194139534645 true] [17592186301031 1034 "$N,Z,$ and $C$ only" 13194139534645 true] [17592186301031 1103 #edb/ref 17592186045454 13194139534645 true] [17592186301031 1111 #uuid "5e96ae23-b394-57a8-89f1-d49d944c0d79" 13194139534645 true] [17592186301032 1034 "$C$ only" 13194139534645 true] [17592186301032 1103 #edb/ref 17592186045454 13194139534645 true] [17592186301032 1111 #uuid "40e64332-dea5-52e6-847a-49caff9ff04e" 13194139534645 true] [17592186301033 1017 #edb/ref 17592186301034 13194139534645 true] [17592186301033 1089 "q-181522" 13194139534645 true] [17592186301033 1091 #edb/ref 17592186045463 13194139534645 true] [17592186301033 1100 "Consider the following sets:\n\n$$\nN,\\,Z,\\,Q,\\,R,\\,C\n$$\n\nTo which of these sets does the number $\\sqrt{-4}$ belong?" 13194139534645 true] [17592186301033 1113 #uuid "ac7a530d-d333-5d45-b920-2143ec7f7b31" 13194139534645 true] [17592186301033 1145 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035971/assets/67ef97be4b21a74feaae15f3ff30d5077fc1316874df8de79155316a621e4487.png)\n\nRecall the following:\n\n- $N$ represents the set of **natural numbers**.\n\n- $Z$ represents the set of **integers**.\n\n- $Q$ represents the set of **rational numbers**.\n\n- $R$ represents the set of **real numbers**.\n\n- $C$ represents the set of **complex numbers**\n\nWith that in mind, we note the following:\n\n- First, we note that $\\sqrt{-4}=2\\text{i}$ is a complex number. Therefore, we can write\n\n$$\n\\sqrt{-4}\\in C.\n$$\n\n- Since the imaginary part of $\\sqrt{-4}$ is nonzero, it does *not* belong to $N,Z,Q,$ or $R.$ We can write\n\n$$\n\\sqrt{-4}\\notin N,\\,\\sqrt{-4}\\notin Z,\\,\\sqrt{-4}\\notin Q,\\,\\sqrt{-4}\\notin R.\n$$\n\nTherefore, the correct answer is \"$C$ only.\"" 13194139534645 true] [17592186301034 1000 #edb/ref 17592186301035 13194139534645 true] [17592186301034 1000 #edb/ref 17592186301036 13194139534645 true] [17592186301034 1000 #edb/ref 17592186301037 13194139534645 true] [17592186301034 1000 #edb/ref 17592186301038 13194139534645 true] [17592186301034 1000 #edb/ref 17592186301039 13194139534645 true] [17592186301034 1040 #edb/ref 17592186045450 13194139534645 true] [17592186301034 1041 "selection" 13194139534645 true] [17592186301034 1104 #edb/ref 17592186301039 13194139534645 true] [17592186301034 1110 #uuid "3c690567-4cf0-5647-bd41-63550a2c951f" 13194139534645 true] [17592186301035 1034 "$N,Z,Q$ and $R$ only" 13194139534645 true] [17592186301035 1103 #edb/ref 17592186045454 13194139534645 true] [17592186301035 1111 #uuid "2f25ca92-8214-57c6-b53f-1b185bd1705b" 13194139534645 true] [17592186301036 1034 "$Q$ and $R$ only" 13194139534645 true] [17592186301036 1103 #edb/ref 17592186045454 13194139534645 true] [17592186301036 1111 #uuid "31416064-8add-5531-9eb6-e4a192b706e9" 13194139534645 true] [17592186301037 1034 "$R$ and $C$ only" 13194139534645 true] [17592186301037 1103 #edb/ref 17592186045454 13194139534645 true] [17592186301037 1111 #uuid "9388e54c-899b-543f-9481-9f310341890d" 13194139534645 true] [17592186301038 1034 "$R$ only" 13194139534645 true] [17592186301038 1103 #edb/ref 17592186045454 13194139534645 true] [17592186301038 1111 #uuid "e4f0f9b5-21ee-53b5-acdf-50ec5aed16ba" 13194139534645 true] [17592186301039 1034 "$C$ only" 13194139534645 true] [17592186301039 1103 #edb/ref 17592186045454 13194139534645 true] [17592186301039 1111 #uuid "eb4195a6-44c1-5fef-bbd0-46c52a39fe98" 13194139534645 true] [17592186301040 1017 #edb/ref 17592186301041 13194139534645 true] [17592186301040 1089 "q-181544" 13194139534645 true] [17592186301040 1091 #edb/ref 17592186045463 13194139534645 true] [17592186301040 1100 "To which of the following sets does the number $-\\pi $ belong?\n\n- ${Q}^{-}$\n- $R$\n- $Q$\n- $C$" 13194139534645 true] [17592186301040 1113 #uuid "4f0ed03a-d67b-5694-a70d-e3b447bf54f5" 13194139534645 true] [17592186301040 1145 "The number $-\\pi $ is not a rational number. Consequently, $-\\pi $ does not belong to any of the sets  ${Q}^{-}$ nor $Q.$\n\nHowever, $-\\pi $ is a real number, so it belongs to $R.$\n\nFinally, since every real number is also a complex number, $-\\pi $ also belongs to $C.$\n\nTherefore, the correct answer is \"II and IV only.\"" 13194139534645 true] [17592186301041 1000 #edb/ref 17592186301042 13194139534645 true] [17592186301041 1000 #edb/ref 17592186301043 13194139534645 true] [17592186301041 1000 #edb/ref 17592186301044 13194139534645 true] [17592186301041 1000 #edb/ref 17592186301045 13194139534645 true] [17592186301041 1000 #edb/ref 17592186301046 13194139534645 true] [17592186301041 1040 #edb/ref 17592186045450 13194139534645 true] [17592186301041 1041 "selection" 13194139534645 true] [17592186301041 1104 #edb/ref 17592186301044 13194139534645 true] [17592186301041 1110 #uuid "a17abd26-d972-536f-8201-f19d5ec1b77e" 13194139534645 true] [17592186301042 1034 "I and IV only" 13194139534645 true] [17592186301042 1103 #edb/ref 17592186045454 13194139534645 true] [17592186301042 1111 #uuid "e0e799c7-61bc-505b-9a77-cb51ab3a241d" 13194139534645 true] [17592186301043 1034 "I and III only" 13194139534645 true] [17592186301043 1103 #edb/ref 17592186045454 13194139534645 true] [17592186301043 1111 #uuid "f59a58e2-6060-507c-aecc-d54c5b4c2c0b" 13194139534645 true] [17592186301044 1034 "II and IV only" 13194139534645 true] [17592