75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-42489" :question/id #uuid "979568ea-3277-5856-8a42-405d54cf6fd4" :question/math-academy-id "q-42489" :question/problem "Consider the matrices $A$ and $C$ given below. Find $det({A}^{T})-det({C}^{T}).$\n\n$$\nA=[\\begin{aligned}7 & 0 & 0 & 0 \\\\ 0 & 2 & 0 & 0 \\\\ 0 & 18 & -1 & 0 \\\\ 1 & 6 & 7 & -2\\end{aligned}],\\,C=[\\begin{aligned}3 & 0 & 5 & 4 \\\\ 0 & -1 & 0 & -7 \\\\ 0 & 0 & 3 & 0 \\\\ 0 & 0 & 0 & -3\\end{aligned}].\n$$" :question/worked-solution "The determinant of a triangular matrix is equal to the product of the entries on the main diagonal. Therefore, we have the following:   \n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}7 & 0 & 0 & 0 \\\\ 0 & 2 & 0 & 0 \\\\ 0 & 18 & -1 & 0 \\\\ 1 & 6 & 7 & -2\\end{aligned}|=7\\cdot 2\\cdot (-1)\\cdot (-2)=28 \\\\ det(C) & =|\\begin{aligned}3 & 0 & 5 & 4 \\\\ 0 & -1 & 0 & -7 \\\\ 0 & 0 & 3 & 0 \\\\ 0 & 0 & 0 & -3\\end{aligned}|=3\\cdot (-1)\\cdot 3\\cdot (-3)=27\\end{aligned}\n$$\n\nAlso, \n\n$$\n\\begin{aligned}det({A}^{T}) & =det(A)=28 \\\\ det({C}^{T}) & =det(C)=27.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\ndet({A}^{T})-det({C}^{T})=28-27=1.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-42489/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e84e45ca-c250-5e65-a04e-4714a485f38e"] :knowledge-point/questions ["q-42489"] :db/ensure [:knowledge-point/validate]} {:db/id "q-42879/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "ef3c6dfe-78ce-5fef-b39c-2d0be17c4e8b" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-42879/selection/f674c0b7a5d045bac2ae1fef5cd5c4174801c3eff31f15a7b80ecb4f53eead58" :answer/id #uuid "b3bd3d10-2486-5ca6-b89e-8c6d47ab5551" :answer/type :answer.type/math :answer/value "480\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-42879/selection/d971375f57c56d8a55a09f2b892e10878