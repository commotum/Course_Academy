ed}5 & 0 & 0 \\\\ 8 & -4 & 0 \\\\ 7 & 5 & 3\\end{aligned}| \\\\  & =-|\\begin{aligned}5 & 0 & 0 \\\\ 8 & -4 & 0 \\\\ 7 & 5 & 3\\end{aligned}|\\end{aligned}\n$$\n\nThe determinant of a triangular matrix is equal to the product of the entries on the main diagonal. Therefore, we have\n\n$$\n\\begin{aligned}-|\\begin{aligned}5 & 0 & 0 \\\\ 8 & -4 & 0 \\\\ 7 & 5 & 3\\end{aligned}| & =-1\\cdot (5\\cdot (-4)\\cdot 3)=60.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\ndet(C)=60.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-42486/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "02e65c73-8c02-5403-8c5c-b1e81f81a7b6"] :knowledge-point/questions ["q-42486"] :db/ensure [:knowledge-point/validate]} {:db/id "q-69980/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "273accda-20d5-5526-9c99-51a16c35b8ad" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-69980/selection/f4f7e304b38327904d9fdebbac3479cccadb547b1c29d7b8e5938e7012f9d65b" :answer/id #uuid "ca898e8c-6aa5-5ae8-b0db-5a629183a3c2" :answer/type :answer.type/math :answer/value "-21" :db/ensure [:answer/validate]} {:db/id "q-69980/selection/10293ac0295e0e79554137a949f5c5c46b9812dcc0a3ecb6349c4cb5e6acdff3" :answer/id #uuid "086ca458-de63-5135-b3a3-14ae7a4a42b9" :answer/type :answer.type/math :answer/value "-9" :db/ensure [:answer/validate]} {:db/id "q-69980/selection/6d8a7c7e73b503e82ee3fdeaeeda8131c0106d9ecb6a16ba218483b62acd0090" :answer/id #uuid "8889a8cc-b498-5a71-a1dd-169cf666d3c7" :answer/type :answer.type/math :answer/value "-18" :db/ensure [:answer/validate]} {:db/id "q-69980/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "2d88c963-ebd7-5607-b3e9-9d661f92aacf" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-69980/selection" :answer-field/id #uuid "c86fecf0-a7f2-5185-a452-9cf8c3ddaf8d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-69980/selection/6d8a7c7e73b503e82ee3fdeaeeda8131c0106d9ecb6a16ba218483b62acd0090" :answer-field/choices ["q-69980/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" "q-69980/selection/f4f7e304b38327904d9fdebbac3479cccadb547b1c29d7b8e5938e7012f9d65b" "q-69980/selection/10293ac0295e0e79554137a949f5c5c46b9812dcc0a3ecb6349c4cb5e6acdff3" "q-69980/selection/6d8a7c7e73b503e82ee3fdeaeeda8131c0106d9ecb6a16ba218483b62acd0090" "q-69980/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af"] :db/ensure [:answer-field/validate]} {:db/id "q-69980" :question/id #uuid "cb83c8b1-6559-5c7a-816c-48131b9b34c0" :question/math-academy-id "q-69980" :question/problem "Find the determinant of the matrix \n$H=[\\begin{aligned}3 & 0 & 4 & 0 \\\\ 7 & \\,\\,\\,-3 & 8 & 8 \\\\ 0 & 0 & 1 & 0 \\\\ 10 & 0 & 0 & 2\\end{aligned}].$" :question/worked-solution "Notice that the $3$rd row contains three zeros. So, using Laplace expansion along the $3$rd row, we have\n\n$$\n\\begin{aligned}\\text{det}(H) & =|\\begin{aligned}3 & 0 & 4 & 0 \\\\ 7 & \\,\\,\\,-3 & 8 & 8 \\\\ 0 & 0 & 1 & 0 \\\\ 10 & 0 & 0 & 2\\end{aligned}| \\\\  & =1\\cdot (-1)^{3+3}|\\begin{aligned}3 & 0 & 0 \\\\ 7 & \\,\\,\\,-3 & 8 \\\\ 10 & 0 & 2\\end{aligned}| \\\\  & =|\\begin{aligned}3 & 0 & 0 \\\\ 7 & \\,\\,\\,-3 & 8 \\\\ 10 & 0 & 2\\end{aligned}|\\end{aligned}\n$$\n\nNow, notice that the $1$st row of the $3\\times 3$ determinant contains two zeros. So, using Laplace expansion along the $1$st row, we have\n\n$$\n\\begin{aligned}det(H) & =|\\begin{aligned}3 & 0 & 0 \\\\ 7 & -3 & 8 \\\\ 10 & 0 & 2\\end{aligned}| \\\\  & =3\\cdot (-1)^{1+1}|\\begin{aligned}-3 & 8 \\\\ 0 & 2\\end{aligned}| \\\\  & =3\\cdot |\\begin{aligned}-3 & 8 \\\\ 0 & 2\\end{aligned}| \\\\  & =3(-6-0) \\\\  & =3\\cdot (-6) \\\\  & =-18.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-69980/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "02e65c73-8c02-5403-8c5c-b1e81f81a7b6"] :knowledge-point/questions ["q-69980"] :db/ensure [:knowledge-point/validate]} {:db/id "q-158368/selection/a59e10e9ca0b8a69d2b8425f1c9930ee0733ea061a1d6430398562813d750649" :answer/id #uuid "c54c497c-4d3e-5628-acba-05a2a823f834" :answer/type :answer.type/math :answer/value "120" :db/ensure [:answer/validate]} {:db/id "q-158368/selection/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc" :answer/id #uuid "977f19bc-2912-5bd3-936d-670f4014845c" :answer/type :answer.type/math :answer/value "60" :db/ensure [:answer/validate]} {:db/id "q-158368/selection/23191a7abb2085fa58cfcf0bd067eedb8c4feb2e427bc3ee2024594244bb9b18" :answer/id #uuid "3dc1cc13-f03e-58dc-bef6-87969413fb7f" :answer/type :answer.type/math :answer/value "180" :db/ensure [:answer/validate]} {:db/id "q-158368/selection/695792c47319cb1ed098a6d83038b7ad6d032838f9103d693bf346f1dc234ff8" :answer/id #uuid "c3fc1cd5-263d-531c-a38a-bb95052bffe5" :answer/type :answer.type/math :answer/value "40" :db/ensure [:answer/validate]} {:db/id "q-158368/selection/cd2c691ab81e402742a9cbfcf84eae9c0333da43cb9c250de23e4aff9fbca764" :answer/id #uuid "e01895aa-814e-5d0f-8478-ea94df61049f" :answer/type :answer.type/math :answer/value "480" :db/ensure [:answer/validate]} {:db/id "q-158368/selection" :answer-field/id #uuid "d906e97b-c674-59f8-b0d3-d8197aa9991b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-158368/selection/a59e10e9ca0b8a69d2b8425f1c9930ee0733ea061a1d6430398562813d750649" :answer-field/choices ["q-158368/selection/a59e10e9ca0b8a69d2b8425f1c9930ee0733ea061a1d6430398562813d750649" "q-158368/selection/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc" "q-158368/selection/23191a7abb2085fa58cfcf0bd067eedb8c4feb2e427bc3ee2024594244bb9b18" "q-158368/selection/695792c47319cb1ed098a6d83038b7ad6d032838f9103d693bf346f1dc234ff8" "q-158368/selection/cd2c691ab81e402742a9cbfcf84eae9c0333da43cb9c250de23e4aff9fbca764"] :db/ensure [:answer-field/validate]} {:db/id "q-158368" :question/id #uuid "ee3c663a-dc25-5ecb-a96b-3812935ba5d0" :question/math-academy-id "q-158368" :question/problem "Calculate the volume of the $4$-dimensional parallelepiped spanned by the vectors\n\n$$\na=[\\begin{aligned}-2 \\\\ 0 \\\\ 1 \\\\ 0\\end{aligned}],\\,b=[\\begin{aligned}5 \\\\ 4 \\\\ 4 \\\\ 0\\end{aligned}],\\,c=[\\begin{aligned}0 \\\\ 0 \\\\ 3 \\\\ 0\\end{aligned}],\\,d=[\\begin{aligned}7 \\\\ 1 \\\\ 6 \\\\ 5\\end{aligned}].\n$$" :question/worked-solution "First, let's construct the matrix $M,$ whose columns are the coordinates of our vectors $a,$ $b,$ $c,$ and  $d:$\n\n$$\nM=[\\begin{aligned}-2 & 5 & 0 & 7 \\\\ 0 & 4 & 0 & 1 \\\\ 1 & 4 & 3 & 6 \\\\ 0 & 0 & 0 & 5\\end{aligned}]\n$$\n\nThe volume of the parallelepiped spanned by these vectors equals the absolute value of the determinant of $M:$\n\n$$\nV=|det(M)|\n$$\n\nNotice that the $3$rd column of the determinant contains three zeros. So, using Laplace expansion along the $3$rd column, we have\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}-2 & 5 & 0 & 7 \\\\ 0 & 4 & 0 & 1 \\\\ 1 & 4 & 3 & 6 \\\\ 0 & 0 & 0 & 5\\end{aligned}| \\\\  & =3\\cdot (-1)^{3+3}|\\begin{aligned}-2 & 5 & 7 \\\\ 0 & 4 & 1 \\\\ 0 & 0 & 5\\end{aligned}| \\\\  & =3|\\begin{aligned}-2 & 5 & 7 \\\\ 0 & 4 & 1 \\\\ 0 & 0 & 5\\end{aligned}|.\\end{aligned}\n$$\n\nThe determinant of a triangular matrix is equal to the product of the entries on the main diagonal. Therefore, we have\n\n$$\n\\begin{aligned}det(M) & =3|\\begin{aligned}-2 & 5 & 7 \\\\ 0 & 4 & 1 \\\\ 0 & 0 & 5\\end{aligned}| \\\\  & =3\\cdot (-2)\\cdot 4\\cdot 5 \\\\  & =-120\\end{aligned}\n$$\n\nTherefore, the volume is\n\n$$\nV=|det(M)|=|-120|=120.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-158368/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3118d2af-771f-54c9-b18e-5196b87b6dca"] :knowledge-point/questions ["q-158368"] :db/ensure [:knowledge-point/validate]} {:db/id "q-158369/selection/a4c8bdda186d0d425e9963bf17967cd5e356d934f319fa58135b8f8cf8a589f8" :answer/id #uuid "57a0db3e-f6a9-57bb-b10b-96fee6efedce" :answer/type :answer.type/math :answer/value "30" :db/ensure [:answer/validate]} {:db/id "q-158369/selection/de4adedcb4f94c847122905ee3a7a3f16eecda2d4ce5fbbb83bc1b08e3c95a70" :answer/id #uuid "5b13bdea-187a-5755-a90b-288c06546a44" :answer/type :answer.type/math :answer/value "63" :db/ensure [:answer/validate]} {:db/id "q-158369/selection/286fb92e9ba180b012d241bb7e762701483c9c864420d9df6597147f2e2fb458" :answer/id #uuid "5e846014-e34d-56ef-a2b9-d4d1fb1796c6" :answer/type :answer.type/math :answer/value "28" :db/ensure [:answer/validate]} {:db/id "q-158369/selection/f9ce6d2531e925e028befc33f5bb5202bf5c98dc29df5818c58d5bd59c914412" :answer/id #uuid "4af2f65a-a23e-5ee2-b1ef-ccefe8ecaa67" :answer/type :answer.type/math :answer/value "90" :db/ensure [:answer/validate]} {:db/id "q-158369/selection/ca566c3861ad95266b92d3d8e36c85c39daf1d1780cc1bf826ae0ac7accce583" :answer/id #uuid "8f42359e-6815-57ca-8b41-e70c85b06eb8" :answer/type :answer.type/math :answer/value "45" :db/ensure [:answer/validate]} {:db/id "q-158369/selection" :answer-field/id #uuid "2cae0617-356f-5507-bd9a-2b735e61b3ed" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-158369/selection/ca566c3861ad95266b92d3d8e36c85c39daf1d1780cc1bf826ae0ac7accce583" :answer-field/choices ["q-158369/selection/a4c8bdda186d0d425e9963bf17967cd5e356d934f319fa58135b8f8cf8a589f8" "q-158369/selection/de4adedcb4f94c847122905ee3a7a3f16eecda2d4ce5fbbb83bc1b08e3c95a70" "q-158369/selection/286fb92e9ba180b012d241bb7e762701483c9c864420d9df6597147f2e2fb458" "q-158369/selection/f9ce6d2531e925e028befc33f5bb5202bf5c98dc29df5818c58d5bd59c914412" "q-158369/selection/ca566c3861ad95266b92d3d8e36c85c39daf1d1780cc1bf826ae0ac7accce583"] :db/ensure [:answer-field/validate]} {:db/id "q-158369" :question/id #uuid "b5e5342a-6eb5-5b68-a368-3bc650674e8d" :question/math-academy-id "q-158369" :question/problem "Calculate the volume of the $4$-dimensional parallelepiped spanned by the vectors\n\n$$\na=[\\begin{aligned}3 \\\\ 6 \\\\ 7 \\\\ 0\\end{aligned}],\\,b=[\\begin{aligned}0 \\\\ 5 \\\\ 1 \\\\ 7\\end{aligned}],\\,c=[\\begin{aligned}0 \\\\ 0 \\\\ -1 \\\\ 4\\end{aligned}],\\,d=[\\begin{aligned}0 \\\\ 0 \\\\ 0 \\\\ 3\\end{aligned}].\n$$" :question/worked-solution "First, let's construct the matrix $M,$ whose columns are the coordinates of our vectors $a,$ $b,$ $c,$ and  $d:$\n\n$$\nM=[\\begin{aligned}3 & 0 & 0 & 0 \\\\ 6 & 5 & 0 & 0 \\\\ 7 & 1 & -1 & 0 \\\\ 0 & 7 & 4 & 3\\end{aligned}]\n$$\n\nThe volume of the parallelepiped spanned by these vectors equals the absolute value of the determinant of $M:$\n\n$$\nV=|det(M)|\n$$\n\nThe determinant of a triangular matrix is equal to the product of the entries on the main diagonal. So, we have\n\n$$\ndet(M)=[\\begin{aligned}3 & 0 & 0 & 0 \\\\ 6 & 5 & 0 & 0 \\\\ 7 & 1 & -1 & 0 \\\\ 0 & 7 & 4 & 3\\end{aligned}]=3\\cdot 5\\cdot (-1)\\cdot 3=-45.\n$$\n\nTherefore, the volume is\n\n$$\nV=|det(M)|=|-45|=45.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-158369/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3118d2af-771f-54c9-b18e-5196b87b6dca"] :knowledge-point/questions ["q-158369"] :db/ensure [:knowledge-point/validate]} {:db/id "q-158108/selection/e8fca892866a06a1ab302627b9de911942e4dfff7666b327843df0729f3939b1" :answer/id #uuid "2b5dc6e5-7a99-5be8-a45d-96919f9d88e0" :answer/type :answer.type/math :answer/value "105" :db/ensure [:answer/validate]} {:db/id "q-158108/selection/ad7a3824e2b90d316aedd9968e2fdff13c67ee5110546b7a43eeb384aa267fd0" :answer/id #uuid "5f9159db-ef1b-5abb-8793-2add85297585" :answer/type :answer.type/math :answer/value "112" :db/ensure [:answer/validate]} {:db/id "q-158108/selecti