 [:answer/validate]} {:db/id "q-181292/selection" :answer-field/id #uuid "4a082a05-5984-5565-b276-a4f14b75c94e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-181292/selection/acfb3bfd22250362b54288deaaa8668915711b909770faa7c32b27018a539084" :answer-field/choices ["q-181292/selection/18cb2d01a2848e86dba36741d5a6f832d6fcde344d17473419652c0927271448" "q-181292/selection/acfb3bfd22250362b54288deaaa8668915711b909770faa7c32b27018a539084" "q-181292/selection/d28e6f728d7c00a7cec7f080711e4095adb32f5c259d6bc17540c11b5ca9e563" "q-181292/selection/90f91ed69771e57de74d25b8c8dfff0b5d11491f99c9986207d2825f2f661bab" "q-181292/selection/909508b3e1db1e78c8769dc0f447421af70e2b979b74e344f2f625ecb6219e1e"] :db/ensure [:answer-field/validate]} {:db/id "q-181292" :question/id #uuid "ec8ef756-041e-555c-849b-fbabb15783b3" :question/math-academy-id "q-181292" :question/problem "Which of the following is a schematic of the set ${A}^{2}$ for $A={x,y,z}?$" :question/worked-solution "The set ${A}^{2}$ is equivalent to the Cartesian product ${A}^{2}=A\\times A.$\n\nThe Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nTo create a schematic of the Cartesian product $A\\times A$, we create a table and list the elements of the first set $A$ in a row across the top and the elements of the second set $A$ in a column down the left side.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040355/assets/adaba1cfa0f8aaba7638c2b581bf90ce1146f3c6ce91fa79654652bf98a2c011.png)\n\nThen, at each intersection, we write an ordered pair whose first coordinate is the corresponding element of the first set and the second coordinate is the corresponding element of the second set.\n\nOur completed $A\\times A$ schematic is shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040355/assets/9150fac674c8ff0608996224022243ed1a218ce077e7ccd12e7e9c8b12b732c7.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-181292/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b304527c-5cdc-57df-b118-e555f6f8fa5c"] :knowledge-point/questions ["q-181292"] :db/ensure [:knowledge-point/validate]} {:db/id "q-181963/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "b8255dae-9506-5229-829b-b36f76b3e4e6" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-181963/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "6519ab84-a21e-5fcd-a8e6-ab23a33f8df0" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-181963/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "710c12de-5d01-5b08-bbc9-ef2f623d067e" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-181963/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "788ab1c9-a77b-5ebe-9ea8-c085ff8a685f" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-181963/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "97963324-1fd9-5c84-9ade-883794dce552" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-181963/selection" :answer-field/id #uuid "f33d4708-7849-502c-b078-0d0aa6a56353" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-181963/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer-field/choices ["q-181963/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-181963/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-181963/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-181963/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-181963/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981"] :db/ensure [:answer-field/validate]} {:db/id "q-181963" :question/id #uuid "5132636e-fc5c-596d-8624-67ad2af0f5ce" :question/math-academy-id "q-181963" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040355/assets/cb3e6ef6a832f2adbbc5e096bddf2c4f6a0445fbd77a71df5617298f8dad2e51.png)\n\nBy finding the missing entries in the schematic shown above for $A\\times B,$ where $A={a,b,c}$ and $B={2,4,6},$ determine which of the following statements are true.\n\n- $(4,b)\\in A\\times B$\n- $(c,6)\\in A\\times B$\n- $(a,2)\\in A\\times B$" :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nTo complete our schematic of $A\\times B,$ we write an ordered pair whose first coordinate is the corresponding element of $A$ and the second coordinate is the corresponding element of $B$ at each intersection.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040355/assets/57d053cca53046f02201540e655030a37ba8f7a2811e7dc724cf30ca9fd3c072.png)\n\nAccording to our diagram:\n\n- $(4,b)\\notin A\\times B\\,\\times $\n\n- $(c,6)\\in A\\times B\\,✓$\n\n- $(a,2)\\in A\\times B\\,✓$\n\nTherefore, the correct answer is \"II and III only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-181963/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b304527c-5cdc-57df-b118-e555f6f8fa5c"] :knowledge-point/questions ["q-181963"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-181287"] :question/problem "Which of the following is a schematic of the Cartesian product $A\\times B$ for $A={1,10,100}$ and $B={a,b}?$" :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nTo create a schematic of the Cartesian product, we create a table and list the elements of the first set $A$ in a row across the top and the elements of the second set $B$ in a column down the left side.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040355/assets/aac2b461bef7d5e1a7ae6e4c7b8b50ebeff86f14b45fc3f929a56ebc870e63c3.png)\n\nThen, at each intersection, we write an ordered pair whose first coordinate is the corresponding element of $A$ and the second coordinate is the corresponding element of $B.$\n\nOur completed $A\\times B$ schematic is shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040355/assets/dd425d5211861a8c1b7944bd787bba5272a4640a61eb39ff63a477741c16fc93.png)" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-181279/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "2f22b5af-ed33-505e-85dc-04a76acd457f" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-181279/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "5f45f3b9-6026-5f0c-8d53-6c97363e23df" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-181279/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "de4c3cf5-5f40-52a7-9a1a-787d8faebb10" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-181279/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f