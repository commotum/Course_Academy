693bf346f1dc234ff8" "q-80896/selection/cee37ae0a2921bd3973a5cb0592c822dbbfafcfefba8d7007910ead797b9112f" "q-80896/selection/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" "q-80896/selection/713bb3b087b31554fba8b48520fba2f9d4d353e9b2d87f3d41c293daf48e1776"] :db/ensure [:answer-field/validate]} {:db/id "q-80896" :question/id #uuid "388a46c3-a211-5754-ba5c-bd7e7769886d" :question/math-academy-id "q-80896" :question/problem "What is the cardinality of $C\\times D$ for $C={0,1,2,...,11}$ and $D={s,t,u,v}?$" :question/worked-solution "For any two finite sets $C$ and $D,$ the cardinality of $C\\times D$ is\n\n$$\n|C\\times D|=|C|\\cdot |D|.\n$$\n\nIn this case, we have\n\n$$\n\\begin{aligned}|C\\times D| & =|C|\\cdot |D| \\\\  & =12\\cdot 4 \\\\  & =48.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-80896/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "88fb08f1-03f1-5b04-8b48-4b153e522040"] :knowledge-point/questions ["q-80896"] :db/ensure [:knowledge-point/validate]} {:db/id "q-105865/selection/0674b229b15216f6ea870ccaaf87984357f5d6af66421aad0753c15d921d419a" :answer/id #uuid "33d1df38-4810-5894-a6c5-9f9e54cd68bc" :answer/type :answer.type/math :answer/value "64" :db/ensure [:answer/validate]} {:db/id "q-105865/selection/772faee3af740960f7d296ca245df4da797a9e413368076cbaa828915d92739d" :answer/id #uuid "df41894f-3e5d-5fa2-98fc-f1ec6f18aa5d" :answer/type :answer.type/math :answer/value "128" :db/ensure [:answer/validate]} {:db/id "q-105865/selection/a38ef12f135c1e6010d68ed21f81bc27372a73a756455b7066f6182c46018cc8" :answer/id #uuid "334b5ae6-acd0-58fe-ac76-c7a1e338dc98" :answer/type :answer.type/math :answer/value "32" :db/ensure [:answer/validate]} {:db/id "q-105865/selection/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c" :answer/id #uuid "65f9e005-b711-5e34-b006-18fe6cba8242" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} 