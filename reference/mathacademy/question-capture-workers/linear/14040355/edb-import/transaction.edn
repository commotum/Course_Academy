te]} {:db/id "q-1261/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "0d9a53b4-f1b5-5d43-a1e2-215aea8438a1" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-1261/selection" :answer-field/id #uuid "b6d181f6-10e5-595f-bc2d-7ee82d906f1d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-1261/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer-field/choices ["q-1261/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-1261/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-1261/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-1261/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-1261/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6"] :db/ensure [:answer-field/validate]} {:db/id "q-1261" :question/id #uuid "61b61c9d-7c11-5ceb-9276-f403a6310963" :question/math-academy-id "q-1261" :question/problem "For the sets $X={x,y,z},$ $Y={v,w},$ and $Z=X\\times Y,$ determine which of the following statements are true.\n\n- $(x,v)\\in Z$\n- $(y,w)\\in Z$\n- $(w,z)\\in Z$" :question/worked-solution "The Cartesian product $X\\times Y$ consists of all ordered pairs whose first coordinate belongs to $X$ and whose second coordinate belongs to $Y.$\n\nIn this case, the schematic for $X\\times Y$ is shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040355/assets/316a12102e4be81291f06403815cfb63749b1fd3f463c465294e031543123484.png)\n\nHence, the set $Z=X\\times Y$ is given by\n\n$$\nZ={(x,v),(x,w),(y,v),(y,w),(z,v),(z,w)}.\n$$\n\nTherefore, the correct answer is \"I and II only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-1261/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a6128eca-7f76-5386-9d67-d81db2943eeb"] :knowledge-point/questions ["q-1261"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-1257"] :question/problem "For the sets $A={2,4,6},$ $B={x,y},$ and $C=A\\times B,$ determine which of the following statements are true.\n\n- $(2,4)\\in C$\n- $(2,x)\\in C$\n- $(3,y)\\in C$" :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nIn this case, the schematic for $A\\times B$ is shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040355/assets/df4277feac4c4e838538f941aa0a07d087beb9005d8f7a8347dadc1da7fe975e.png)\n\nHence, the set $C=A\\times B$ is given by\n\n$$\nC={(2,x),(2,y),(4,x),(4,y),(6,x),(6,y)}.\n$$\n\nTherefore, the correct answer is \"II only.\"" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-182018/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "d977a360-4135-592f-8690-55291e78e071" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-182018/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "0ae0b1c1-a021-56d6-b313-346e8d0cb38b" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-182018/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "cb6ddf35-4b3e-58cf-8a3b-9552489e6d70" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-182018/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "61352dc0-8a99-542f-972c-39acfed44229" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-18201