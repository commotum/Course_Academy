ts"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cfea42e3-6937-5f27-bade-4da516d3026f" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186051834} {:answer/id #uuid "fb752239-abfd-5869-81ef-a126b7b80c8f" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186051835} {:answer/id #uuid "0202ec4a-d1fe-56c2-9780-1a6ed209364b" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186051836} {:answer/id #uuid "0c964175-10c4-57d2-9c42-dde9a9c2736e" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186051837} {:answer/id #uuid "58a32f4e-971c-526b-a7de-6ce91581dc71" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186051838}] :answer-field/correct {:answer/id #uuid "fb752239-abfd-5869-81ef-a126b7b80c8f" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186051835} :answer-field/id #uuid "d151bfaf-5293-5de2-bb7f-d9f14b99da44" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186051833}] :question/id #uuid "9eac2d72-9d93-50cd-8b4e-008064a9d365" :question/math-academy-id "q-181295" :question/problem "If $A = {-1, 1}$ and $B = {u, v}$, which of the following elements belong to $B \\cdot B \\cdot A$?\n\n1. $(v, v, 1)$\n2. $((v, v), 1)$\n3. $(1, v, u)$"}]}
