\\end{aligned}]" :db/id #edb/ref 17592186284350} {:answer/id #uuid "158cb1d4-a4f8-5487-99e1-767acc3a676f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-18 & 0 & 9 \\\\ 42 & 0 & -21 \\\\ 8 & 0 & -4\\end{aligned}]" :db/id #edb/ref 17592186284351} {:answer/id #uuid "761fb85b-7392-51f2-a63e-085c9a729140" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-18 \\\\ 42 \\\\ 9\\end{aligned}]" :db/id #edb/ref 17592186284352} {:answer/id #uuid "881f57bb-479b-5b8e-8d7f-0c549e81b862" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}21 & 0 & 0 \\\\ 18 & 9 & -42 \\\\ 4 & 0 & -8\\end{aligned}]" :db/id #edb/ref 17592186284353} {:answer/id #uuid "087bc156-bdfb-592d-896a-4cca3f807665" :answer/type {:db/ident :answer.type/math} :answer/value "-144" :db/id #edb/ref 17592186284354}] :answer-field/correct {:answer/id #uuid "158cb1d4-a4f8-5487-99e1-767acc3a676f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-18 & 0 & 9 \\\\ 42 & 0 & -21 \\\\ 8 & 0 & -4\\end{aligned}]" :db/id #edb/ref 17592186284351} :answer-field/id #uuid "e140af37-5d21-52b2-9992-47ed85fb2f2e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284349}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "638edf80-8d70-51f1-a06b-07cfe064f004" :question/math-academy-id "q-42001" :question/problem "Calculate $ABC$, where\n\n$$\nA=[\\begin{aligned}1 & -2 \\\\ -1 & 5 \\\\ 0 & 1\\end{aligned}],\\,B=[\\begin{aligned}1 \\\\ -4\\end{aligned}],\\,C=[\\begin{aligned}-2 & 0 & 1\\end{aligned}].\n$$" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $3\\times 2$ matrix, $B$ is a $2\\times 1$ matrix, and $C$ is a $1\\times 3$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $3\\times 1$ matrix, which will require finding $3$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 3$ matrix, which will require finding $6$ entries.\n\nSo, we find the product $AB$ first:\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}1 & -2 \\\\ -1 & 5 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ -4\\end{aligned}] \\\\  & =[\\begin{aligned}9 \\\\ -21 \\\\ -4\\end{aligned}]\\end{aligned}\n$$\n\nNow, we multiply $AB$ by $C:$\n\n$$\n\\begin{aligned}ABC & =(AB)C \\\\  & =[\\begin{aligned}9 \\\\ -21 \\\\ -4\\end{aligned}]\\cdot [\\begin{aligned}-2 & 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-18 & 0 & 9 \\\\ 42 & 0 & -21 \\\\ 8 & 0 & -4\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115749 :knowledge-point/_questions [{:knowledge-point/id #uuid "5a870c4a-daa5-5df2-8968-d8bf9ac0bd75" :knowledge-point/title "Identifying True Statements Regarding Matrix Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a11f9e2a-ed97-5892-b658-f32e3c6b3291" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186113866} {:answer/id #uuid "dd6d062e-bc5c-536f-95e3-3119d32f14f4" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186113867} {:answer/id #uuid "020544b6-6ee9-557b-9286-6492929bdd13" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186113868} {:answer/id #uuid "3d590048-cce3-5884-bde5-8be926e7dd54" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186113869} {:answer/id #uuid "7b35efad-7299-53b3-b06f-d3b8164ad052" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186113870}] :answer-field/correct {:answer/id #uuid "dd6d062e-bc5c-536f-95e3-3119d32f14f4" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186113867} :answer-field/id #uuid "35146e5c-364f-5229-9c30-59d0b677108a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113865}] :question/id #uuid "174631dd-f119-50e8-bf7b-ac669b330d64" :question/math-academy-id "q-42266" :question/problem "Given that $A, B$, and $C$ are $6 \\cdot 6$ matrices, which of the following statements are always true?\n\n1. $(A + B)C = AC + BC$\n2. $AB = BA$\n3. $A(BC) = (BA)C$"}]}
