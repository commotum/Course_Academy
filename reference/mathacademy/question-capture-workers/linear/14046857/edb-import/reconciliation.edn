f2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-130259" "field" nil "attribute" "question/worked-solution" "value" "We can apply the distributive law\n\n$$\nAC+BC=(A+B)C.\n$$\n\nSo, we calculate $A+B$ first:\n\n$$\n\\begin{aligned}A+B & =[\\begin{aligned}1 & 2 & 3 \\\\ 3 & 2 & -3 \\\\ -3 & -4 & 2\\end{aligned}]+[\\begin{aligned}-1 & -2 & -3 \\\\ -2 & -2 & 3 \\\\ 3 & 4 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}AC+BC & =(A+B)C \\\\  & =[\\begin{aligned}0 & 0 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}].[\\begin{aligned}-2 & \\sqrt{2} & 1 \\\\ 1 & -\\sqrt{2} & 2 \\\\ -2 & 0 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 & 0 \\\\ -2 & \\sqrt{2} & 1 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-130259" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/activity-metadata.json" "file_sha256" "fb5349ae9919165525b4db45d27a8cd44987883d9e001077013a00e07ab7905b"} {"question" "q-130259" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-130259" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}0 & 0 & 0 \\\\ -2 & \\sqrt{2} & 1 \\\\ 0 & 0 & 0\\end{aligned}]"] ["math" "[\\begin{aligned}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}]"] ["math" "[\\begin{aligned}0 & 0 & 0 \\\\ 1 & -\\sqrt{2} & 2 \\\\ 0 & 0 & 0\\end{aligned}]"] ["math" "[\\begin{aligned}0 & 0 & 0 \\\\ \\sqrt{2} & -\\sqrt{2} & 0 \\\\ 0 & 0 & 0\\end{aligned}]"] ["math" "[\\begin{aligned}0 & \\sqrt{2} & 0 \\\\ 0 & -\\sqrt{2} & 0 \\\\ 0 & 0 & 0\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-130259" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}0 & 0 & 0 \\\\ -2 & \\sqrt{2} & 1 \\\\ 0 & 0 & 0\\end{aligned}]"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-319890" "field" nil "attribute" "question/problem" "value" "Calculate $AB+AC$, where\n\n$$\nA=[\\begin{aligned}0 & 0 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}],\\,B=[\\begin{aligned}-1 & 1 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}],\\,C=[\\begin{aligned}-2 & \\sqrt{3}-1 & 2 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}].\n$$\n\n|  |  | $0$ | $0$ | {{field-1}} |  |\n| --- | --- | --- | --- | --- | --- |\n| $AB+AC=\\,\\,$ |  | {{field-2}} | $\\sqrt{3}$ | $2$ |  |\n|  |  | $0$ | {{field-3}} | $0$ |  |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-319890" "field" nil "attribute" "question/worked-solution" "value" "We can apply the distributive law\n\n$$\nAB+AC=A(B+C).\n$$\n\nSo, we calculate $B+C$ first:\n\n$$\n\\begin{aligned}B+C & =[\\begin{aligned}-1 & 1 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}]+[\\begin{aligned}-2 & \\sqrt{3}-1 & 2 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & \\sqrt{3} & 2 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}AB+AC & =A(B+C) \\\\  & =[\\begin{aligned}0 & 0 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}][\\begin{aligned}-3 & \\sqrt{3} & 2 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 & 0 \\\\ -3 & \\sqrt{3} & 2 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-319890" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/activity-metadata.json" "file_sha256" "fb5349ae9919165525b4db45d27a8cd44987883d9e001077013a00e07ab7905b"} {"question" "q-319890" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-319890" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-319890" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/sta