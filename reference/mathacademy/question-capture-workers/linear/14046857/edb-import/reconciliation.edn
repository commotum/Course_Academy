$ by $C$, we will obtain a $3\\times 2$ matrix, which will require finding $6$ entries.\n\nSo, we find the product $AB$ first:\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}1 & 4 & -2 \\\\ -3 & -4 & -1\\end{aligned}]\\cdot [\\begin{aligned}5 \\\\ -2 \\\\ -4\\end{aligned}] \\\\  & =[\\begin{aligned}5 \\\\ -3\\end{aligned}]\\end{aligned}\n$$\n\nNow, we multiply $AB$ by $C:$\n\n$$\n\\begin{aligned}ABC & =(AB)C \\\\  & =[\\begin{aligned}5 \\\\ -3\\end{aligned}]\\cdot [\\begin{aligned}-1 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}-5 & 15 \\\\ 3 & -9\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-41785" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/activity-metadata.json" "file_sha256" "fb5349ae9919165525b4db45d27a8cd44987883d9e001077013a00e07ab7905b"} {"question" "q-41785" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-41785" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-5 & 15 \\\\ 3 & -9\\end{aligned}]"] ["math" "[\\begin{aligned}-5 & 7 \\\\ 3 & -6\\end{aligned}]"] ["math" "[\\begin{aligned}-5 \\\\ -9\\end{aligned}]"] ["math" "[\\begin{aligned}15 & 3 \\\\ 3 & -6\\end{aligned}]"] ["math" "[\\begin{aligned}9 \\\\ -15\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-41785" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}-5 & 15 \\\\ 3 & -9\\end{aligned}]"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-130313" "field" nil "attribute" "question/problem" "value" "Calculate $ABC$, where\n\n$$\nA=[\\begin{aligned}3 & 6 \\\\ 4 & 2 \\\\ -1 & 2\\end{aligned}],\\,B=[\\begin{aligned}3 \\\\ -2\\end{aligned}],\\,C=[\\begin{aligned}-1 & 1 & 3\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-130313" "field" nil "attribute" "question/worked-solution" "value" "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $3\\times 2$ matrix, $B$ is a $2\\times 1$ matrix, and $C$ is a $1\\times 3$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $3\\times 1$ matrix, which will require finding $3$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 3$ matrix, which will require finding $6$ entries.\n\nSo, we find the product $AB$ first:\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}3 & 6 \\\\ 4 & 2 \\\\ -1 & 2\\end{aligned}]\\cdot [\\begin{aligned}3 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}-3 \\\\ 8 \\\\ -7\\end{aligned}]\\end{aligned}\n$$\n\nNow, we multiply $AB$ by $C:$\n\n$$\n\\begin{aligned}ABC & =(AB)C \\\\  & =[\\begin{aligned}-3 \\\\ 8 \\\\ -7\\end{aligned}]\\cdot [\\begin{aligned}-1 & 1 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}3 & -3 & -9 \\\\ -8 & 8 & 24 \\\\ 7 & -7 & -21\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-130313" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/activity-metadata.json" "file_sha256" "fb5349ae9919165525b4db45d27a8cd44987883d9e001077013a00e07ab7905b"} {"question" "q-130313" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-130313" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-8 & 8 & 24 \\\\ 3 & -3 & -9 \\\\ 7 & -7 & -21\\end{aligned}]"] ["math" "[\\begin{aligned}3 & -3 & -9 \\\\ -8 & 8 & 24 \\\\ 7 & -7 & -21\\end{aligned}]"] ["math" "[\\begin{aligned}3 & -8 & 7 \\\\ -3 & 8 & -7 \\\\ -9 & 24 & -21\\end{aligned}]"] ["math" "[\\begin{aligned}3 & 6 & -1 \\\\ 4 & 2 & 1 \\\\ -1 & 2 & 3\\end{aligned}]"] ["math" "[\\begin{aligned}7 & -7 & -21 \\\\ 3 & -3 & -9 \\\\ -8 & 8 & 24\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-130313" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}3 & -3 & -9 \\\\ -8 & 8 & 24 \\\\ 7 & -7 & -21\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-42001" "field" nil "attribute" "question/problem" "value" "Calculate $ABC$, where\n\n$$\nA=[\\begin{aligned}1 & -2 \\\\ -1 & 5 \\\\ 0 & 1\\end{aligned}],\\,B=[\\begin{aligned}1 \\\\ -4\\end{aligned}],\\,C=[\\begin{aligned}-2 & 0 & 1\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-42001" "field" nil "attribute" "question/worked-solution" "value" "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $3\\times 2$ matrix, $B$ is a $2\\times 1$ matrix, and $C$ is a $1\\times 3$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $3\\times 1$ matrix, which will require finding $3$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 3$ matrix, which will require finding $6$ entries.\n\nSo, we find the product $AB$ first:\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}1 & -2 \\\\ -1 & 5 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ -4\\end{aligned}] \\\\  & =[\\begin{aligned}9 \\\\ -21 \\\\ -4\\end{aligned}]\\end{aligned}\n$$\n\nNow, we multiply $AB$ by $C:$\n\n$$\n\\begin{aligned}ABC & =(AB)C \\\\  & =[\\begin{aligned}9 \\\\ -21 \\\\ -4\\end{aligned}]\\cdot [\\begin{aligned}-2 & 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-18 & 0 & 9 \\\\ 42 & 0 & -21 \\\\ 8 & 0 & -4\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-42001" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/activity-metadata.json" "file_sha256" "fb5349ae9919165525b4db45d27a8cd44987883d9e001077013a00e07ab7905b"} {"question" "q-42001" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-42001" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-144"] ["math" "[\\begin{aligned}-18 & 0 & 9 \\\\ 42 & 0 & -21 \\\\ 8 & 0 & -4\\end{aligned}]"] ["math" "[\\begin{aligned}-18 \\\\ 42 \\\\ 9\\end{aligned}]"] ["math" "[\\begin{aligned}-9 & 18 & 9 \\\\ 21 & 7 & -42 \\\\ 8 & 2 & -6\\end{aligned}]"] ["math" "[\\begin{aligned}21 & 0 & 0 \\\\ 18 & 9 & -42 \\\\ 4 & 0 & -8\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-42001" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}-18 & 0 & 9 \\\\ 42 & 0 & -21 \\\\ 8 & 0 & -4\\end{aligned}]"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-320026" "field" nil "attribute" "question/problem" "value" "Calculate $ABC$, where\n\n$$\nA=[\\begin{aligned}-4 & 6\\end{aligned}],\\,B=[\\begin{aligned}2 & -1 \\\\ 3 & 5\\end{aligned}],\\,C=[\\begin{aligned}1 & 0 \\\\ -2 & 4\\end{aligned}].\n$$\n\n| $ABC=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-320026" "field" nil "attribute" "question/worked-solution" "value" "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $1\\times 2$ matrix, $B$ is a $2\\times 2$ matrix, and $C$ is a $2\\times 2$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $1\\times 2$ matrix, which will require finding $2$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 2$ matrix, which will require finding $4$ entries.\n\nSo, we find the product $AB$ first: \n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}-4 & 6\\end{aligned}]\\cdot [\\begin{aligned}2 & -1 \\\\ 3 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}10 & 34\\end{aligned}]\\end{aligned}\n$$\n\nNow, we multiply $AB$ by $C:$\n\n$$\n\\begin{aligned}ABC & =(AB)C \\\\  & =[\\begin{aligned}10 & 34\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 \\\\ -2 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}-58 & 136\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-320026" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/activity-metadata.json" "file_sha256" "fb5349ae9919165525b4db45d27a8cd44987883d9e001077013a00e07ab7905b"} {"question" "q-320026" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-320026" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-58"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-320026" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-320026" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "136"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-319938" "field" nil "attribute" "question/problem" "value" "Calculate $ABC$, where\n\n$$\nA=[\\begin{aligned}5 \\\\ -1 \\\\ 3\\end{aligned}],\\,B=[\\begin{aligned}-4 & 1\\end{aligned}],\\,C=[\\begin{aligned}2 \\\\ -5\\end{aligned}].\n$$\n\n|  |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n| $ABC=\\,\\,$ |  | {{field-2}} |  |\n|  |  | {{field-3}} |  |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-319938" "field" nil "attribute" "question/worked-solution" "value" "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $3\\times 1$ matrix, $B$ is a $1\\times 2$ matrix, and $C$ is a $2\\times 1$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $3\\times 2$ matrix, which will require finding $6$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $1\\times 1$ matrix, which will require finding only $1$ entry.\n\nSo, we find the product $BC$ first: \n\n$$\n\\begin{aligned}BC & =[\\begin{aligned}-4 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ -5\\end{aligned}] \\\\  & =[\\begin{aligned}-13\\end{aligned}]\\end{aligned}\n$$\n\nNow, we multiply $A$ by $BC:$\n\n$$\n\\begin{aligned}ABC & =A(BC) \\\\  & =[\\begin{aligned}5 \\\\ -1 \\\\ 3\\end{aligned}]\\cdot [\\begin{aligned}-13\\end{aligned}] \\\\  & =[\\begin{aligned}-65 \\\\ 13 \\\\ -39\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-319938" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/activity-metadata.json" "file_sha256" "fb5349ae9919165525b4db45d27a8cd44987883d9e001077013a00e07ab7905b"} {"question" "q-319938" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-319938" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-65"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-319938" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-319938" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "13"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-319938" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-319938" "field" "field-3" "attribute" "answer-field/correct" "value" [:answer.type/math "-39"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-130463" "field" nil "attribute" "question/problem" "value" "Given that $A$ and $B$  are $8\\times 8$ matrices,  and ${I}_{8}$ is the $8\\times 8$ identity matrix,  which of the following statements are always true?\n\n- $A{I}_{8}={I}_{8}A$\n- $AB=BA$\n- $A\\cdot 2{I}_{8}=2A$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-130463" "field" nil "attribute" "question/worked-solution" "value" "Let's consider the statements one by one.\n\n- Statement I is true. Matrix multiplication is not commutative in general, however, multiplication by the identity matrix is always commutative. In this case, we have  $A{I}_{8}={I}_{8}A=A.$\n\n- Statement II is false. Matrix multiplication is not commutative, so $AB\\ne BA$ in general.\n\n- Statement III is true. Matrix multiplication is distributive, so \n\n$$\n\\begin{aligned}A\\cdot 2{I}_{8} & =A({I}_{8}+{I}_{8}) \\\\  & =A{I}_{8}+A{I}_{8} \\\\  & =A+A \\\\  & =2A.\\end{aligned}\n$$\n\nTherefore, only statements I  and III are true." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-130463" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/activity-metadata.json" "file_sha256" "fb5349ae9919165525b4db45d27a8cd44987883d9e001077013a00e07ab7905b"} {"question" "q-130463" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-130463" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and III only"] ["text" "I only"] ["text" "II and III only"] ["text" "II only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-130463" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "I and III only"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-42267" "field" nil "attribute" "question/problem" "value" "Given that $A,B,$ and $C$ are $5\\times 5$ matrices, and  ${I}_{5}$ is the $5\\times 5$ identity matrix, which of the following statements are always true?\n\n- $AB=BA$\n- $A(B+C)=AB+AC$\n- $B{I}_{5}={I}_{5}B$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-42267" "field" nil "attribute" "question/worked-solution" "value" "Let's consider the statements one by one.\n\n- Statement I is false. Matrix multiplication is not commutative, so $AB\\ne BA$ in general.\n\n- Statement II is true. Matrix multiplication is distributive, so $(A+B)C=AC+BC,$ and $A(B+C)=AB+AC$ in general.\n\n- Statement III is true. Matrix multiplication is not commutative in general, however, multiplication by the identity matrix is always commutative. In this case, we have  $B{I}_{5}={I}_{5}B=B.$\n\nTherefore, only statements II and III are true." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-42267" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/activity-metadata.json" "file_sha256" "fb5349ae9919165525b4db45d27a8cd44987883d9e001077013a00e07ab7905b"} {"question" "q-42267" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-42267" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I only"] ["text" "II and III only"] ["text" "II only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-42267" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "II and III only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-42266" "field" nil "attribute" "question/problem" "value" "Given that $A,B,$ and $C$ are $6\\times 6$ matrices, which of the following statements are always true?\n\n- $(A+B)C=AC+BC$\n- $AB=BA$\n- $A(BC)=(BA)C$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-42266" "field" nil "attribute" "question/worked-solution" "value" "Let's consider the statements one by one.\n\n- Statement I is true. Matrix multiplication is distributive, so $(A+B)C=AC+BC,$ and $A(B+C)=AB+AC$ in general.\n\n- Statement II is false. Matrix multiplication is not commutative, so $AB\\ne BA$ in general.\n\n- Statement III is false. Matrix multiplication is associative, so $(AB)C=A(BC)$ in general. However, since matrix multiplication is not commutative, we have\n\n$$\n\\begin{aligned}A(BC)=(AB)C\\ne (BA)C.\\end{aligned}\n$$\n\nTherefore, only statement I is true." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-42266" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/activity-metadata.json" "file_sha256" "fb5349ae9919165525b4db45d27a8cd44987883d9e001077013a00e07ab7905b"} {"question" "q-42266" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-42266" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I only"] ["text" "I, II, and III"] ["text" "II only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-42266" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "I only"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-130449" "field" nil "attribute" "question/problem" "value" "Given that $A,B,$ and $C$ are $3\\times 3$ matrices, and  ${I}_{3}$ is the $3\\times 3$ identity matrix, which of the following statements are always true?\n\n- $AB=A{I}_{3}B$\n- $A(B+{I}_{3})=AB$\n- ${I}_{3}A=A{I}_{3}$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-130449" "field" nil "attribute" "question/worked-solution" "value" "Let's consider the statements one by one.\n\n- Statement I is true. Matrix multiplication is associative, so $A{I}_{3}B=(A{I}_{3})B=AB.$\n\n- Statement II is false. Matrix multiplication is distributive, so $A(B+{I}_{3})=AB+A{I}_{3}=AB+A.$ However,  $AB+A\\ne AB,$ in general.\n\n- Statement III is true. Matrix multiplication is not commutative in general, however, multiplication by the identity matrix is always commutative. In this case, we have  ${I}_{3}A=A{I}_{3}.$\n\nTherefore, only statements I and III are true." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-130449" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/activity-metadata.json" "file_sha256" "fb5349ae9919165525b4db45d27a8cd44987883d9e001077013a00e07ab7905b"} {"question" "q-130449" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-130449" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I and III only"] ["text" "I only"] ["text" "II only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-130449" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "I and III only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-75662" "field" nil "attribute" "question/problem" "value" "Given that $A,B,$ and $C$ are $7\\times 7$ matrices, which of the following statements are always true?\n\n- $A(B+C)=AC+AB$\n- $A(BC)=(BA)C$\n- $AB=BA$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-75662" "field" nil "attribute" "question/worked-solution" "value" "Let's consider the statements one by one.\n\n- Statement I is true. Matrix multiplication is distributive, so \n\n$$\nA(B+C)=AB+AC=AC+AB\n$$\n\n since matrix addition is commutative.\n\n- Statement II is false. Matrix multiplication is associative, so $(AB)C=A(BC)$ in general. However, since matrix multiplication is not commutative, we have\n\n$$\n\\begin{aligned}A(BC)=(AB)C\\ne (BA)C.\\end{aligned}\n$$\n\n- Statement III is false. Matrix multiplication is not commutative, so $AB\\ne BA$ in general.\n\nTherefore, only statement I is true." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-75662" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/activity-metadata.json" "file_sha256" "fb5349ae9919165525b4db45d27a8cd44987883d9e001077013a00e07ab7905b"} {"question" "q-75662" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-75662" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I only"] ["text" "II and III only"] ["text" "II only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-75662" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "I only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "e-4411" "field" nil "attribute" "question/problem" "value" "Find $AB-CB,$ where\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/assets/90f675ec2a211b6157f040735d551d083c770ac33b5dbfcd74b3678b16d5df53.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/example-4411.json" "file_sha256" "362567899f74b31fe83c21d5085a7e37c6139c1264530b8a1baa875675d361ca"} {"question" "e-4411" "field" nil "attribute" "question/worked-solution" "value" "We can apply the distributive law\n\n$$\nAB-CB=(A-C)B.\n$$\n\nSo, we calculate $A-C$ first:\n\n$$\n\\begin{aligned}A-C & =[\\begin{aligned}2 & 4 & -3 \\\\ -1 & -5 & 3 \\\\ -2 & 0 & 7\\end{aligned}]-[\\begin{aligned}3 & 4 & -3 \\\\ -1 & -4 & 3 \\\\ -2 & 0 & 8\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & -1\\end{aligned}] \\\\  & =-{I}_{3}\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}AB-CB & =(A-C)B \\\\  & =-{I}_{3}B \\\\  & =-B \\\\  & =[\\begin{aligned}-\\sqrt{2} & -\\sqrt{3} & 45 \\\\ -81 & \\sqrt{5} & 2 \\\\ -2 & -1 & -\\sqrt{3}\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/example-4411.json" "file_sha256" "362567899f74b31fe83c21d5085a7e37c6139c1264530b8a1baa875675d361ca"} {"question" "e-4412" "field" nil "attribute" "question/problem" "value" "Calculate $ABC,$ where\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/assets/de98e19bed31050fd07f9979f0428ed4eb90ce05eaff7ba4d19ea81bbd664422.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/example-4412.json" "file_sha256" "cced60577d000143db636eba32fcd7ed928bcc2f7d10e84de14a127007e0ec12"} {"question" "e-4412" "field" nil "attribute" "question/worked-solution" "value" "First, recall the associative law\n\n$$\nABC = (AB)C = A(BC).\n$$\n\nNotice that $A$ is a $3 \\times 3$ matrix, $B$ is a $3 \\times 3$ matrix, and $C$ is a $3 \\times 1$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $3 \\times 3$ matrix that will require finding $9$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $3 \\times 1$ matrix that will require finding only $3$ entries.\n\nSo, we find the product $BC$ first:\n\n$$\n\\begin{aligned}BC & =[\\begin{aligned}-2 & 5 & -4 \\\\ 2 & 1 & 1 \\\\ -4 & 3 & -1\\end{aligned}]\\cdot [\\begin{aligned}-2 \\\\ 1 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}-3 \\\\ 0 \\\\ 8\\end{aligned}]\\end{aligned}\n$$\n\nNow, we multiply $A$ by $BC\\mathbin{:}$\n\n$$\n\\begin{aligned}ABC & =A(BC) \\\\  & =[\\begin{aligned}1 & -1 & 0 \\\\ 4 & 3 & 1 \\\\ 1 & 2 & 1\\end{aligned}]\\cdot [\\begin{aligned}-3 \\\\ 0 \\\\ 8\\end{aligned}] \\\\  & =[\\begin{aligned}-3 \\\\ -4 \\\\ 5\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/example-4412.json" "file_sha256" "cced60577d000143db636eba32fcd7ed928bcc2f7d10e84de14a127007e0ec12"} {"question" "e-4413" "field" nil "attribute" "question/problem" "value" "Given that $A, B,$ and $C$ are $6 \\times 6$ matrices, which of the following statements are always true?\n\n- $A(BC) = (AB)C$\n\n- $A(B+C) = BA+CA$\n\n- $A(B+C) = AB+AC$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/example-4413.json" "file_sha256" "0b920ba59dce9bcf436f4f1b943246f27a3709596a256a4ff2706065f968f597"} {"question" "e-4413" "field" nil "attribute" "question/worked-solution" "value" "Let's consider the statements one by one.\n\n- Statement I is true. Matrix multiplication is associative, so $(AB)C = A(BC)$ in general.\n\n- Statement II is false. Matrix multiplication is distributive, so $A(B+C) = AB + AC$ in general. However, since matrix multiplication is not commutative, we have\n\n$$\nAB + AC  \\neq BA + CA.\n$$\n\n- Statement III is true. Matrix multiplication is distributive, so $(A+B)C = AC+BC,$ and $A(B+C) = AB+AC$ in general.\n\nTherefore, only statements I and III are true." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/example-4413.json" "file_sha256" "0b920ba59dce9bcf436f4f1b943246f27a3709596a256a4ff2706065f968f597"}] "usage" {"q-130313" [] "q-319938" [] "e-4411" [] "e-4413" [] "q-319886" [] "q-42001" [] "q-41785" [] "q-42266" [] "e-4412" [] "q-130449" []} "basis" 1692 "retractions" [[17592186115739 :question/problem "Calculate $ABC$, where\n\n$A = \\begin{bmatrix}1 & 4 & -2 \\\\ -3 & -4 & -1\\end{bmatrix}, B = \\begin{bmatrix}5 \\\\ -2 \\\\ -4\\end{bmatrix}, C = \\begin{bmatrix}-1 & 3\\end{bmatrix}$."] [17592186115749 :question/problem "Given that $A, B$, and $C$ are $6 \\cdot 6$ matrices, which of the following statements are always true?\n\n1. $(A + B)C = AC + BC$\n2. $AB = BA$\n3. $A(BC) = (BA)C$"] [17592186114973 :question/problem "Find $AB-CB,$ where\n\n$$\n[\\begin{aligned}2 & 4 & -3 \\\\ -1 & -5 & 3 \\\\ -2 & 0 & 7\\end{aligned}]\n$$"] [17592186114974 :question/problem "Calculate $ABC,$ where\n\n$$\n[\\begin{aligned}1 & -1 & 0 \\\\ 4 & 3 & 1 \\\\ 1 & 2 & 1\\end{aligned}]\n$$"]] "immutable_answers" [17592186113806 17592186113807 17592186113808 17592186113809 17592186113810 17592186113866 17592186113867 17592186113868 17592186113869 17592186113870 17592186284290 17592186284291 17592186284292 17592186284293 17592186284294 17592186284319 17592186284321 17592186284323 17592186284350 17592186284351 17592186284352 17592186284353 17592186284354 17592186293647 17592186293648 17592186293649 17592186293650 17592186293651 17592186293661 17592186293663 17592186293665] "immutable_fields" [[17592186113805 :answer-field/correct] [17592186113805 :answer-field/id] [17592186113805 :answer-field/key] [17592186113805 :answer-field/type] [17592186113865 :answer-field/correct] [17592186113865 :answer-field/id] [17592186113865 :answer-field/key] [17592186113865 :answer-field/type] [17592186284289 :answer-field/correct] [17592186284289 :answer-field/id] [17592186284289 :answer-field/key] [17592186284289 :answer-field/type] [17592186284318 :answer-field/correct] [17592186284318 :answer-field/id] [17592186284318 :answer-field/key] [17592186284318 :answer-field/type] [17592186284320 :answer-field/correct] [17592186284320 :answer-field/id] [17592186284320 :answer-field/key] [17592186284320 :answer-field/type] [17592186284322 :answer-field/correct] [17592186284322 :answer-field/id] [17592186284322 :answer-field/key] [17592186284322 :answer-field/type] [17592186284349 :answer-field/corr