gned}0 & 3 & 0 \\\\ -6 & 0 & -3 \\\\ 0 & -3 & 0\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-319917" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/activity-metadata.json" "file_sha256" "fb5349ae9919165525b4db45d27a8cd44987883d9e001077013a00e07ab7905b"} {"question" "q-319917" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-319917" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "3"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-319917" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"question" "q-319917" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "-6"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046857/state.json" "file_sha256" "3b9e3c714dc718cadf2d780525cfd72b7fadefd2bff717611b4c333be8ac08a9"} {"q