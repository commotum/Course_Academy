^{(5)}(-1)}{5!} & =-\\frac{1}{2} \\\\ \\frac{{f}^{(5)}(-1)}{120} & =-\\frac{1}{2} \\\\ {f}^{(5)}(-1) & =-60.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-83677/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a832b1a2-e80e-53d0-bb64-03df0f1a209c"] :knowledge-point/questions ["q-83677"] :db/ensure [:knowledge-point/validate]}]
