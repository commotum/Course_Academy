q-8168/selection/85264ac5fdf1ebaef3f1fe35d6b0c47f6e76a173b8109ad8f45a65f98d3c1517" "q-8168/selection/55e0998e749cb2ef2d1214291185c715af47265bb0edfdd22d7cae11b99d0152" "q-8168/selection/2ee6cf7ede711f43fdb9609dc235444bba22db72b642d10d88878e9975a84f6f"] :db/ensure [:answer-field/validate]} {:db/id "q-8168" :question/id #uuid "7bec7711-8c59-5171-958c-cc487f9b5e02" :question/math-academy-id "q-8168" :question/problem "Find the fourth-degree Taylor polynomial of $-\\operatorname{sin}⁡x$ about $x=\\frac{\\pi }{2}.$" :question/worked-solution "The fourth-degree Taylor polynomial of $f(x)$ about $x=a$ is given by\n\n$$\n\\begin{aligned}{P}_{4}(x) & =f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+\\frac{{f}^{‴}(a)}{3!}(x-a)^{3}+\\frac{{f}^{⁗}(a)}{4!}(x-a)^{4}.\\end{aligned}\n$$\n\nHere, we have $a=\\frac{\\pi }{2},$ so\n\n$$\n{P}_{4}(x)=f(\\frac{\\pi }{2})+{f}^{′}(\\frac{\\pi }{2})(x-\\frac{\\pi }{2})+\\frac{{f}^{″}(\\frac{\\pi }{2})}{2!}{(x-\\frac{\\pi }{2})}^{2}+\\frac{{f}^{‴}(\\frac{\\pi }{2})}{3!}{(x-\\frac{\\pi }{2})}^{3}+\\frac{{f}^{(4)}(\\frac{\\pi }{2})}{4!}{(x-\\frac{\\pi }{2})}^{4}.\n$$\n\nSo we need to work out $f(\\frac{\\pi }{2}),$ ${f}^{′}(\\frac{\\pi }{2}),$ ${f}^{″}(\\frac{\\pi }{2}),$ ${f}^{‴}(\\frac{\\pi }{2})$ and ${f}^{(4)}(\\frac{\\pi }{2}),$ as follows:\n\n$$\n\\begin{aligned}f(x) & =-\\operatorname{sin}⁡(x) & ⟹ &  & f(\\frac{\\pi }{2}) & =-\\operatorname{sin}⁡(\\frac{\\pi }{2})=-1 \\\\ {f}^{′}(x) & =-\\operatorname{cos}⁡(x) & ⟹ &  & {f}^{′}(\\frac{\\pi }{2}) & =-\\operatorname{cos}⁡(\\frac{\\pi }{2})=0 \\\\ {f}^{′}(x) & =\\operatorname{sin}⁡(x) & ⟹ &  & {f}^{″}(\\frac{\\pi }{2}) & =\\operatorname{sin}⁡(\\frac{\\pi }{2})=1 \\\\ {f}^{‴}(x) & =\\operatorname{cos}⁡(x) & ⟹ &  & {f}^{‴}(\\frac{\\pi }{2}) & =\\operatorname{cos}⁡(\\frac{\\pi }{2})=0 \\\\ {f}^{(4)}(x) & =-\\operatorname{sin}⁡(x) & ⟹ &  & {f}^{(4)}(\\frac{\\pi }{2}) & =-\\operatorname{sin}⁡(\\frac{\\pi }{2})=-1\\end{aligned}\n$$\n\nTherefore, ${P}_{4}(x)$ is given by\n\n$$\n\\begin{aligned}{P}_{4}(x) & =-1+0(x-\\frac{\\pi }{2})+\\frac{1}{2!}{(x-\\frac{\\pi }{2})}^{2}+\\frac{0}{3!}{(x-\\frac{\\pi }{2})}^{3}+(-\\frac{1}{4!}){(x-\\frac{\\pi }{2})}^{4} \\\\  & =-1+\\frac{1}{2}{(x-\\frac{\\pi }{2})}^{2}-\\frac{1}{24}{(x-\\frac{\\pi }{2})}^{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-8168/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "22d992a1-2ea8-5226-9971-188447f98ab6"] :knowledge-point/questions ["q-8168"] :db/ensure [:knowledge-point/validate]} {:db/id "q-126387/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "69918ed9-80b5-5726-b55b-f9f27eb57e51" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-126387/selection/3a619fab2616dab0463f9c76cb72cd9f101e45e62111356a5b0b111e062a8dcf" :answer/id #uuid "2c93c3b9-3f21-5592-9920-0f45a266b147" :answer/type :answer.type/math :answer/value "-\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-126387/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "40ac82e0-40ee-5d73-847f-364b755975fa" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-126387/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "9c235a08-56c1-507e-88f5-9e90de5227cb" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-126387/selection/5ab3573096b30d3c5d3c378e667364cbb062f921e9b1002441e594f0774a669d" :answer/id #uuid "4a35b99e-d88c-5ff5-b786-946231a7532b" :answer/type :answer.type/math :answer/value "-\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-126387/selection" :answer-field/id #uuid "3de53aee-6ff1-5a3b-87f6-6369f24364ca" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-126387/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18