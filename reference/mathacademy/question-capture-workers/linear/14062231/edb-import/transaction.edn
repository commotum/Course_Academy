sure [:answer-field/validate]} {:db/id "q-81161" :question/id #uuid "180fd49e-dfe0-5df1-8371-861e5122e0fc" :question/math-academy-id "q-81161" :question/problem "The fourth-degree Taylor polynomial of $f(x)$ about $x=2$ is given by\n\n$$\n{P}_{4}(x)=-4-12(x-2)-5(x-2)^{2}-2(x-2)^{3}+(x-2)^{4}.\n$$\n\nWhat is ${f}^{(4)}(2)?$" :question/worked-solution "The coefficient of $(x-2)^{4}$ is given by $\\frac{{f}^{(4)}(2)}{4!}.$ Therefore,\n\n$$\n\\begin{aligned}\\frac{{f}^{(4)}(2)}{4!} & =1 \\\\ \\frac{{f}^{(4)}(2)}{24} & =1 \\\\ {f}^{(4)}(2) & =24.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-81161/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a832b1a2-e80e-53d0-bb64-03df0f1a209c"] :knowledge-point/questions ["q-81161"] :db/ensure [:knowledge-point/validate]} {:db/id "q-126391/selection/728ecd05f971a253a3c26dbe75d9e0a7cfee71804ca75ebb83455b35d611b45b" :answer/id #uuid "84fd5d5b-5e8e-5099-b93f-06c7909f3bb2" :answer/type :answer.type/math :answer/value "66" :db/ensure [:answer/validate]} {:db/id "q-126391/selection/a2ce0d7121680ad5ca64b109a32cd456c311ade4af21eb0a0dd652e8319117f1" :answer/id #uuid "bbfb6869-5daf-5e5e-9b6b-e75a0d0cba16" :answer/type :answer.type/math :answer/value "80" :db/ensure [:answer/validate]} {:db/id "q-126391/selection/60d8696f019bd6901d4028773e8b64c56a3047a6bc6b4ed12b314cf6b1ae175a" :answer/id #uuid "9ead1d99-2673-5c0c-9fd6-ee76007245be" :answer/type :answer.type/math :answer/value "-35" :db/ensure [:answer/validate]} {:db/id "q-126391/selection/14fdd9c68b8f5cd541a0350dfd956e125452e735121bf2c13030d9ba47197cf0" :answer/id #uuid "5f0ba451-7cb4-513f-b88f-f66587d4585d" :answer/type :answer.type/math :answer/value "-66" :db/ensure [:answer/validate]} {:db/id "q-126391/selection/594f4371237f716a4e7b771cfac6a2ca8b8eb3c8dcb7752f2b3291728275476a" :answer/id #uuid "da62d945-c8e6-5b8f-a6c7-456036bc7e9c" :answer/type :answer.type/math :answer/value "-24" :db/ensure [:answer/va