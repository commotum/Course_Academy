)=7\\cdot (-1)-0\\cdot 0=-7.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Area}(T(D)) & =|det(T)|\\cdot \\text{Area}(D) \\\\  & =|-7|\\cdot 1 \\\\  & =7.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14074295/state.json" "file_sha256" "0230c5cd9a09b8904f1b2c15dee2388f14093a615d338b631e46f56699184913"} {"question" "q-9297" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14074295/activity-metadata.json" "file_sha256" "2542092add11252b01c06274e86f35d2768e6a54f7881faf3f8c8a02ea500d9d"} {"question" "q-9297" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14074295/state.json" "file_sha256" "0230c5cd9a09b8904f1b2c15dee2388f14093a615d338b631e46f56699184913"} {"question" "q-9297" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "1"] ["math" "2"] ["math" "3"] ["math" "5"] ["math" "7"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14074295/state.json" "file_sha256" "0230c5cd9a09b8904f1b2c15dee2388f14093a615d338b631e46f56699184913"} {"question" "q-9297" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "7"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14074295/state.json" "file_sha256" "0230c5cd9a09b8904f1b2c15dee2388f14093a615d338b631e46f56699184913"} {"question" "q-9309" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14074295/assets/bd50e99a129b1d6a2