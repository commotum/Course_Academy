1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-38907/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6"] :db/ensure [:answer-field/validate]} {:db/id "q-38907" :question/id #uuid "a256295e-1638-51d8-b1c8-ce671e7522e8" :question/math-academy-id "q-38907" :question/problem "Which of the following statements are true given that $T:{R}^{5}\\to {R}^{5}$ is a linear transformation whose standard matrix is $T,$ and ${{v}_{1},{v}_{2},{v}_{3}}$ is a basis of $\\text{Col}(T)?$\n\n- $\\text{rank}(T)=3$\n- $T$ is invertible\n- $\\text{nullity}(T)>0$" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{5}$ into ${R}^{5},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{5} \\\\  & \\text{rank}(T)=5 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since ${{v}_{1},{v}_{2},{v}_{3}}$ is a basis of $\\text{Col}(T)$ we must have that $\\text{rank}(T)=3.$\n\n- Statement II is false. According to the invertible matrix theorem, since $\\text{rank}(T)\\ne 5,$ the transformation $T$ and the matrix $T$ are not invertible.\n\n- Statement III is true. Since $T$ is not invertible, the invertible matrix theorem implies that $\\text{nullity}(T)\\ne 0.$ In turn, this means that $\\text{nullity}(T)>0.$\n\nTherefore, the correct answer is \"I and III only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-38907/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e9d77214-796e-558f-a364-00ae3e25cc13"] :knowledge-point/questions ["q-38907"] :db/ensure [:knowledge-point/validate]} {:db/id "q-141495/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "49efbb4c-1655-5e26-a2ce-f2e988f00a9f" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-141495/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "148e53fd-a596-553b-ac3e-f4ab467d3a30" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-141495/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "8aa6c946-ca92-51e5-9b62-fc6e1fb1f794" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-141495/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "4c8ac925-9461-590a-97c7-65ff7a26cfde" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-141495/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "b3fb2d58-8c68-567a-b31a-d9f5631dc9f2" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-141495/selection" :answer-field/id #uuid "39736f7e-2d2b-5b1a-9767-25f624c6cef1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-141495/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer-field/choices ["q-141495/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-141495/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-141495/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-141495/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-141495/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9"] :db/ensure [:answer-field/validate]} {:db/id "q-141495" :question/id #uuid "daea3b8e-c165-5730-8762-171e1c8211d7" :question/math-academy-id "q-141495" :question/problem "Let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation whose standard matrix is $T,$ and ${v}_{1},{v}_{2}\\in {R}^{3}.$  Consider the following statement:\n\n*If $2T({v}_{1})-3T({v}_{2})=0$ and ${v}_{1}\\ne k{v}_{2}$ for all $k\\in R$ then $\\text{__________}.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n\n- $\\text{Ker}(T)\\ne {0}$\n- $\\text{Im}(T)={R}^{3}$\n- $T$ is invertible" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since $2T({v}_{1})-3T({v}_{2})=0$ and $T$ is a linear transformation, we have $T(2{v}_{1}-3{v}_{2})=0$ which means $2{v}_{1}-3{v}_{2}\\in \\text{Ker}(T).$   Since ${v}_{1}\\ne k{v}_{2}$,  we must have $\\text{Ker}(T)\\ne {0}.$\n\n- Statement II is false. Since $\\text{Ker}(T)\\ne {0}$, then according to the invertible matrix theorem, the transformation $T$ is not a bijection. Since $T$ is not a bijection, then by the invertible matrix theorem, $\\text{Im}(T)\\ne {R}^{3}.$\n\n- Statement III is false. According to the invertible matrix theorem, since $\\text{Im}(T)\\ne {R}^{3},$ the corresponding matrix $T$ can't be invertible.\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-141495/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "113a601e-220a-54a3-a64b-1e554bc3d79f"] :knowledge-point/questions ["q-141495"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-38977"] :question/problem "Let $T:{R}^{4}\\to {R}^{4}$ be a linear transformation whose standard matrix is $T.$ Consider the following statement:\n\n*If $T$ is invertible, then $\\text{__________}.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n\n- $\\text{Ker}(T)={0}$\n- $\\text{rank}(T)\\ne 4$\n- $\\text{nullity}(T)\\ne 0$" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{4}$ into ${R}^{4},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{4} \\\\  & \\text{rank}(T)=4 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since $T$ is invertible, the invertible matrix theorem implies that $\\text{Ker}(T)={0}.$\n\n- Statement II is false. Since $T$ is invertible, the invertible matrix theorem implies that $\\text{rank}(T)=4.$\n\n- Statement III is false. Since $T$ is invertible, the invertible matrix theorem implies that $\\text{nullity}(T)=0.$\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-141569/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "a1788616-224c-52f3-a1f8-6b7216b5c3ff" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-141569/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "48f9b536-be70-57d1-befd-cc0d82c930d1" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-141569/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "f92f98e6-531d-57e4-9d5b-7e47eed6a947" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-141569/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "6afb3470-2bba-53e7-b44b-c91c9a0f0265" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-14