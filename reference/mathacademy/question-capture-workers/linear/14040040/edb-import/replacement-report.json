      "source": [
        {
          "question": "e-13185",
          "field": null,
          "attribute": "question/problem",
          "value": "Find the missing coefficients $p$ and $q$ in the conditional definition of the set given below.\n\n$$\n\\{\\pm 3\\textrm{i}\\} = \\Big\\{z \\in \\mathbb{C} \\: : \\: 4z^2+pz+q = 0 \\Big\\}\n$$",
