      "source": [
        {
          "question": "e-13184",
          "field": null,
          "attribute": "question/problem",
          "value": "Describe the set $S=\\left\\{\\ldots, -36, -6, -1, -\\dfrac1{6}, -\\dfrac1{36}, ...\\right\\}$ using a constructive definition.\n\n*Hint: Take $a_1 = -\\dfrac16$ in the sequence that generates the elements of $S.$*",
          "category": "ma_capture",
          "file": "reference/mathacademy/question-capture-workers/linear/14040040/example-13184.json",
          "file_sha256": "72d30fe7f318869c172c91967ff9aa4f36e03b275e755780e3f82939c96f026c"
        }
      ],
      "basis": 1407,
