      "source": [
        {
          "question": "e-13186",
          "field": null,
          "attribute": "question/problem",
          "value": "Describe the set $S=\\{... , -5, -3, -1, 1, 3, ...\\}$ using a constructive definition.\n\n*Hint: Take $a_1 = 1$ in the sequence that generates the elements of $S.$*",
          "category": "ma_capture",
