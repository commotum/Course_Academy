      "old_sha256": "edf5f7acd08c6ddc3fece8506a2539094d1d51dc5c2ece6341c2947309c9cbcb",
      "new_sha256": "f6bd2d4515c42db4f2c77bc36032579c999db5a7a0e7d884ee9e7abe111466e4",
      "category": "ma_capture",
