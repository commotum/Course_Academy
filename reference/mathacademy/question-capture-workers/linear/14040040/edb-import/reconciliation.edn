 \\\\  & =12+(n-1)\\cdot (-3) \\\\  & =12-3n+3 \\\\  & =15-3n.\\end{aligned}\n$$\n\nTherefore, we can define our set using a constructive definition as follows:\n\n$$\nS={15-3n\\,:\\,n\\in N}\n$$" "category" "ma_capture" "file" "reference/mathacademy/question-capture-workers/linear/14040040/state.json" "file_sha256" "792966511c878b86a039ac7de776761cc4b5ff959d6c68585ce77cf462836283"} {"question" "q-183757" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "reference/mathacademy/question-capture-workers/linear/14040040/activity-metadata.json" "file_sha256" "fc2548584afdb3016c6caf43bf436c68ea1ae5b5f9e2fdb262895e441a976cbc"} {"question" "q-183757" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "file" "reference/mathacademy/question-capture-workers/linear/14040040/state.json" "file_sha256" "792966511c878b86a039ac7de776761cc4b5ff959d6c68585ce77cf462836283"} {"question" "q-183757" "field" "field-1" "attribute" "answer-field/choices" "value" [["math" "-3n"] ["math" "15+3n"] ["math" "15-3n"] ["math" "15n"] ["math" "3n-5"]] "category" "ma_complete_choices" "file" "reference/mathacademy/question-capture-workers/linear/14040040/state.json" "file_sha256" "792966511c878b86a039ac7de776761cc4b5ff959d6c68585ce77cf462836283"} {"question" "q-183757" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "15-3n"] "category" "ma_successful_grade" "file" "reference/mathacademy/question-capture-workers/linear/14040040/state.json" "file_sha256" "792966511c878b86a039ac7de776761cc4b5ff959d6c68585ce77cf462836283"} {"question" "q-183757" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "file" "reference/mathacademy/question-capture-workers/linear/14040040/state.json" "file_sha256" "792966511c878b86a039ac7de776761cc4b5ff959d6c68585ce77cf462836283"} {"question" "q-183757" "field" "field-2" "attr