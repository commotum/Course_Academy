sing a constructive definition as follows:\n\n$$\nS={\\frac{2}{3}\\cdot {3}^{n}\\,:\\,n\\in N}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-183789/field-1" "q-183789/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9df722a8-2db6-5bb8-a69c-b81b33037ab2"] :knowledge-point/questions ["q-183789"] :db/ensure [:knowledge-point/validate]} {:db/id "q-183771/field-1/c96efb1797cf9881776946044b4b7b3704db7ca5d6e094c26c51a103dc6f643f" :answer/id #uuid "3ff0f08a-c7e1-5c28-824d-ac48965905bd" :answer/type :answer.type/math :answer/value "(-2)^{n}" :db/ensure [:answer/validate]} {:db/id "q-183771/field-1/b13fc4f593da59d7c9e30d20ffdcc832c6275279d834330d42708c3a88b8c1c9" :answer/id #uuid "d4a8b25f-f2ab-511a-b84e-9c93275ede1b" :answer/type :answer.type/math :answer/value "{(\\frac{1}{2})}^{n}" :db/ensure [:answer/validate]} {:db/id "q-183771/field-1/271a59677fb6ef5397de7bbc832169d0f8f571ac2e82b97053c9379e1c21e68a" :answer/id #uuid "9c76a7d9-3873-5084-bc25-ffbfe9d8eb4c" :answer/type :answer.type/math :answer/value "-1\\cdot {2}^{n}" :db/ensure [:answer/validate]} {:db/id "q-183771/field-1/ec9f783b4818056c67fa5d6f74c04a1e69e9d9fb781222ab12e733926dfa64fb" :answer/id #uuid "2d560527-25e8-567a-a092-f8f31cc58150" :answer/type :answer.type/math :answer/value "{2}^{n}" :db/ensure [:answer/validate]} {:db/id "q-183771/field-1" :answer-field/id #uuid "8b046f80-bcde-5929-a913-b519f3ada372" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-183771/field-1/c96efb1797cf9881776946044b4b7b3704db7ca5d6e094c26c51a103dc6f643f" :answer-field/choices ["q-183771/field-1/c96efb1797cf9881776946044b4b7b3704db7ca5d6e094c26c51a103dc6f643f" "q-183771/field-1/b13fc4f593da59d7c9e30d20ffdcc832c6275279d834330d42708c3a88b8c1c9" "q-183771/field-1/271a59677fb6ef5397de7bbc832169d0f8f571ac2e82b97053c9379e1c21e68a" "q-183771/field-1/ec9f783b4818056c67fa5d6f74c04a1e69e9d9fb781222ab12e733926dfa64fb"] :db/ensure [:a