nt/title "Expressing a Set Using a Conditional Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98496122-8639-5b9c-8a9c-a44770c609e5" :answer/type {:db/ident :answer.type/math} :answer/value "Q" :db/id #edb/ref 17592186305441} {:answer/id #uuid "d1c3655b-0c38-51d8-ae62-869aed1a56bf" :answer/type {:db/ident :answer.type/math} :answer/value "C" :db/id #edb/ref 17592186305442} {:answer/id #uuid "39fc2ba0-1f32-5908-9bb9-e506c57e0abb" :answer/type {:db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186305443} {:answer/id #uuid "cfb843af-d724-58d5-86bf-984e28b0cdab" :answer/type {:db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186305444}] :answer-field/correct {:answer/id #uuid "39fc2ba0-1f32-5908-9bb9-e506c57e0abb" :answer/type {:db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186305443} :answer-field/id #uuid "37c9ec78-b1e2-5ab4-ba7e-0ca2282751ce" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186305440} {:answer-field/choices [{:answer/id #uuid "d00099a8-951c-5796-9d42-2fec6837b5ce" :answer/type {:db/ident :answer.type/math} :answer/value "-26" :db/id #edb/ref 17592186305446} {:answer/id #uuid "11baa3b7-0cbd-5b64-ac74-73e8e8b8037a" :answer/type {:db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186305447} {:answer/id #uuid "d0e4cc8a-3145-5604-a833-a226d1620ad8" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186305448}] :answer-field/correct {:answer/id #uuid "11baa3b7-0cbd-5b64-ac74-73e8e8b8037a" :answer/type {:db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186305447} :answer-field/id #uuid "af3e0c06-c957-507a-b3da-7b98d93a67a1" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186305445}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f7d216bb-dfa7-5628-bdfc-1e83e087d571" :question/math-academy-id "q-183691" :question/problem "Describe the set $S={-25,-24,-23,…}$ using a conditional definition.\n\n$$\nQ\n$$" :question/worked-solution "The set $S$ contains all integers greater than or equal to $-25.$\n\nTherefore, the set can be written as\n\n$$\nS={x\\in Z\\,:\\,x\\ge -25}.\n$$\n\n**Note**: This definition is not unique. For example:\n\n- We can write $x>-26.$ This gives\n\n$$\nS={x\\in Z\\,:\\,x>-26}.\n$$"}] [{:db/id #edb/ref 17592186305449 :knowledge-point/_questions [{:knowledge-point/id #uuid "ad21350b-2e3b-57ee-a28c-32a7bd1b2513" :knowledge-point/title "Defining a Set Conditionally Using the Roots of a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "521fefb2-0b14-507f-bb44-d0083a076b8f" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186305451} {:answer/id #uuid "835b298a-3512-5bf9-bdf9-5f402900fb3c" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186305452}] :answer-field/correct {:answer/id #uuid "521fefb2-0b14-507f-bb44-d0083a076b8f" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186305451} :answer-field/id #uuid "6e38b024-f927-5fbe-a23f-6225a80f284a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186305450} {:answer-field/choices [{:answer/id #uuid "2d80faef-435b-5122-a991-6b1142c7458c" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186305454}] :answer-field/correct {:answer/id #uuid "2d80faef-435b-5122-a991-6b1142c7458c" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186305454} :answer-field/id #uuid "e10e2075-12cc-5836-b34f-8b2952f49b6d" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186305453}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "4509be27-d21f-5125-bc76-908cea6d3a7b" :question/math-academy-id "q-183704" :question/problem "Find the missing coefficients in the conditional definition of the set ${-\\frac{1}{2},3}$ given below.\n\n${-\\frac{1}{2},3}={q\\in Q\\,:\\,4{q}^{2}\\,-$\n{{field-1}}\n$q\\,-$\n{{field-2}}\n$=0}$" :question/worked-solution "The given set contains the roots $q\\in Q$ of some quadratic polynomial $p(q).$\n\nSince the quadratic polynomial has roots ${q}_{1}=-\\frac{1}{2}$ and ${q}_{2}=3,$ and the coefficient of the quadratic term is $a=4,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}p(q) & =a(q-{q}_{1})(q-{q}_{2}) \\\\  & =4\\cdot (q-(-\\frac{1}{2}))(q-3) \\\\  & =4(q+\\frac{1}{2})(q-3) \\\\  & =4({q}^{2}-\\frac{5q}{2}-\\frac{3}{2}) \\\\  & =4{q}^{2}-10q-6\\end{aligned}\n$$\n\nTherefore, we can express the given set as follows:\n\n$$\n{-\\frac{1}{2},3}={q\\in Q\\,:\\,4{q}^{2}-10q-6=0}\n$$"}] [{:db/id #edb/ref 17592186305455 :knowledge-point/_questions [{:knowledge-point/id #uuid "ad21350b-2e3b-57ee-a28c-32a7bd1b2513" :knowledge-point/title "Defining a Set Conditionally Using the Roots of a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "001ff48a-3989-5c87-97ae-60eac749efe8" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186305457} {:answer/id #uuid "d2e9e17d-2d3a-5e15-ab95-284b1328122e" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186305458}] :answer-field/correct {:answer/id #uuid "d2e9e17d-2d3a-5e15-ab95-284b1328122e" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186305458} :answer-field/id #uuid "48d3fdb6-e1f0-53ac-a3c4-40e619bb91ba" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186305456} {:answer-field/choices [{:answer/id #uuid "67816c09-8f15-5905-9f04-0e8b8ec17417" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186305460}] :answer-field/correct {:answer/id #uuid "67816c09-8f15-5905-9f04-0e8b8ec17417" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186305460} :answer-field/id #uuid "e39e029e-f164-5184-b659-77ae1ea78ea8" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186305459}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e664c297-43fd-52bd-9883-9fa0a5d813f5" :question/math-academy-id "q-183730" :question/problem "Find the missing coefficients in the conditional definition of the set ${1\\pm \\text{i}}$ given below.\n\n${1\\pm \\text{i}}={z\\in C\\,:\\,2{z}^{2}\\,-$\n{{field-1}}\n$z\\,+$\n{{field-2}}\n$=0}$" :question/worked-solution "The given set contains the roots $z\\in C$ of some quadratic polynomial $p(z).$\n\nSince the quadratic polynomial has roots ${z}_{1}=1-\\text{i}$ and ${z}_{2}=1+\\text{i},$ and the coefficient of the quadratic term is $a=2,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}f(z) & =a(z-{z}_{1})(z-{z}_{2}) \\\\  & =2\\cdot (z-(1-\\text{i}))(z-(1+\\text{i})) \\\\  & =2\\cdot ({z}^{2}-(1-\\text{i})z-(1+\\text{i})z+(1-\\text{i})(1+\\text{i})) \\\\  & =2\\cdot ({z}^{2}-(1-\\text{i}+1+\\text{i})z+((1)^{2}-(\\text{i})^{2})) \\\\  & =2\\cdot ({z}^{2}-(2)z+(1+1)) \\\\  & =2{z}^{2}-4z+4\\end{aligned}\n$$\n\nTherefore, we can express the given set as follows:\n\n$$\n{1\\pm \\text{i}}={z\\in C\\,:\\,2{z}^{2}-4z+4=0}\n$$"}] [{:db/id #edb/ref 17592186305461 :knowledge-point/_questions [{:knowledge-point/id #uuid "ad21350b-2e3b-57ee-a28c-32a7bd1b2513" :knowledge-point/title "Defining a Set Conditionally Using the Roots of a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b465afd-9d4a-5e66-bb82-2ab082b159be" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186305463}] :answer-field/correct {:answer/id #uuid "1b465afd-9d4a-5e66-bb82-2ab082b159be" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186305463} :answer-field/id #uuid "b8b9e96d-1083-532a-afdf-22ed86ecce03" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186305462} {:answer-field/choices [{:answer/id #uuid "68658b8a-0a26-55bc-a28c-e3c182323984" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186305465}] :answer-field/correct {:answer/id #uuid "68658b8a-0a26-55bc-a28c-e3c182323984" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186305465} :answer-field/id #uuid "4ee87d01-388c-5549-80bf-d62eea91f7ff" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186305464} {:answer-field/choices [{:answer/id #uuid "ca877350-4c2b-561c-b85f-13a52bdafb19" :answer/type {:db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186305467}] :answer-field/correct {:answer/id #uuid "ca877350-4c2b-561c-b85f-13a52bdafb19" :answer/type {:db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186305467} :answer-field/id #uuid "e7bca4b8-6e9d-530c-a2b9-634db1070508" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186305466}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ca280f24-6a7e-58fd-a272-82826d53c06a" :question/math-academy-id "q-183751" :question/problem "Find the missing coefficients in the conditional definition of the set ${-3,-\\sqrt{5},\\sqrt{5}}$ given below.\n\n${-3,-\\sqrt{5},\\sqrt{5}}={x\\in R\\,:\\,3{x}^{3}\\,+$\n{{field-1}}\n${x}^{2}\\,-$\n{{field-2}}\n$x\\,-$\n{{field-3}}\n$=0}$" :question/worked-solution "The given set contains the roots $x\\in R$ of some cubic polynomial $p(x).$\n\nSince the cubic polynomial has roots ${x}_{1}=-3,$ ${x}_{2}=-\\sqrt{5},$ and ${x}_{3}=\\sqrt{5},$ and the coefficient of the cubic term is $a=3,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}p(x) & =a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) \\\\  & =(3)(x-(-3))(x-(-\\sqrt{5}))(x-\\sqrt{5}) \\\\  & =3(x+3)(x+\\sqrt{5})(x-\\sqrt{5}) \\\\  & =3(x+3)({x}^{2}-\\sqrt{5}x+\\sqrt{5}x-(\\sqrt{5})^{2}) \\\\  & =3(x+3)({x}^{2}-5) \\\\  & =3({x}^{3}-5x+3{x}^{2}-15) \\\\  & =3{x}^{3}+9{x}^{2}-15x-45\\end{aligned}\n$$\n\nTherefore, we can express the given set as\n\n$$\n{-3,-\\sqrt{5},\\sqrt{5}}={x\\in R\\,:\\,3{x}^{3}+9{x}^{2}-15x-45=0}.\n$$"}] [{:db/id #edb/ref 17592186305468 :knowledge-point/_questions [{:knowledge-point/id #uuid "1c5b3eb6-187f-5f16-a32e-66b0842adfe9" :knowledge-point/title "Expressing a Given Set Using an Arithmetic Sequence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c18f428-ce92-5add-8528-5987002c49e1" :answer/type {:db/ident :answer.type/math} :answer/value "15-3n" :db/id #edb/ref 17592186305470} {:answer/id #uuid "224896f7-9c6f-5b18-bd82-69d6f7f476b9" :answer/type {:db/ident :answer.type/math} :answer/value "3n-5" :db/id #edb/ref 17592186305471} {:answer/id #uuid "232729b8-3106-5c55-a56c-0ce8ec695111" :answer/type {:db/ident :answer.type/math} :answer/value "15n" :db/id #edb/ref 17592186305472} {:answer/id #uuid "aa3a141c-355e-5d7e-a527-be65022c3d6f" :answer/type {:db/ident :answer.type/math} :answer/value "-3n" :db/id #edb/ref 17592186305473} {:answer/id #uuid "66cd3892-f3f0-5705-bcb9-f2fbaf6ab7cc" :answer/type {:db/ident :answer.type/math} :answer/value "15+3n" :db/id #edb/ref 17592186305474}] :answer-field/correct {:answer/id #uuid "5c18f428-ce92-5add-8528-5987002c49e1" :answer/type {:db/ident :answer.type/math} :answer/value "15-3n" :db/id #edb/ref 17592186305470} :answer-field/id #uuid "627aa8ee-5582-561b-abe8-c0d42636ba0a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186305469} {:answer-field/choices [{:answer/id #uuid "7c81c42a-7837-593c-91b1-a4ef9a1e581d" :answer/type {:db/ident :answer.type/math} :answer/value "\\in R" :db/id #edb/ref 17592186305476} {:answer/id #uuid "a9d2976a-afc2-54fc-9755-7055d8f16900" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{is even}" :db/id #edb/ref 17592186305477} {:answer/id #uuid "1d2660e5-56e0-5cbd-a08b-d168d7cb376b" :answer/type {:db/ident :answer.type/math} :answer/value "\\in N" :db/id #edb/ref 17592186305478} {:answer/id #uuid "8206c141-ddcd-5577-b9e2-3b99ae6f25a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{is odd}" :db/id #edb/ref 17592186305479} {:answer/id #uuid "90d4fd54-3e21-51b6-a6c0-febf8724f033" :answer/type {:db/ident :answer.type/math} :answer/value "\\in Z" :db/id #edb/ref 17592186305480}] :answer-field/correct {:answer/id #uuid "1d2660e5-56e0-5cbd-a08b-d168d7cb376b" :answer/type {:db/ident :answer.type/math} :answer/value "\\in N" :db/id #edb/ref 17592186305478} :answer-field/id #uuid "85c5fd90-8754-5ae9-9c5d-12bf84522aab" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186305475}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "315715e5-6681-5416-8d23-7c28e78f023e" :question/math-academy-id "q-183757" :question/problem "Describe the set $S={12,9,6,3,...}$ using a constructive definition.\n\n$$\n15+3n\n$$" :question/worked-solution "Notice that the elements of our set\n\n$$\n12,\\,9,\\,6,\\,3,\\,…\n$$\n\nform an arithmetic sequence with common difference $d=-3:$\n\n$$\n\\begin{aligned}d & =-3 \\\\  & =9-12 \\\\  & =6-9 \\\\  & =⋯\\end{aligned}\n$$\n\nTherefore, the $n$th term ${a}_{n}$ of our sequence for $n\\in N$ is given by\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)\\cdot d \\\\  & =12+(n-1)\\cdot (-3) \\\\  & =12-3n+3 \\\\  & =15-3n.\\end{aligned}\n$$\n\nTherefore, we can define our set using a constructive definition as follows:\n\n$$\nS={15-3n\\,:\\,n\\in N}\n$$"}] [{:db/id #edb/ref 17592186198799 :knowledge-point/_questions [{:knowledge-point/id #uuid "1c5b3eb6-187f-5f16-a32e-66b0842adfe9" :knowledge-point/title "Expressing a Given Set Using an Arithmetic Sequence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83b7f204-b76a-5011-80df-0ef738d52df5" :answer/type {:db/ident :answer.type/math} :answer/value "2n" :db/id #edb/ref 17592186196319} {:answer/id #uuid "39267901-ead7-535b-a1b4-118ce458df1e" :answer/type {:db/ident :answer.type/math} :answer/value "n" :db/id #edb/ref 17592186196320} {:answer/id #uuid "55414efd-cbc6-58f4-a67e-ed2154f8565f" :answer/type {:db/ident :answer.type/math} :answer/value "2n + 3" :db/id #edb/ref 17592186196321} {:answer/id #uuid "791b55ad-2642-597b-902b-6c7d58488cf5" :answer/type {:db/ident :answer.type/math} :answer/value "2n + 1" :db/id #edb/ref 17592186196322}] :answer-field/correct {:answer/id #uuid "83b7f204-b76a-5011-80df-0ef738d52df5" :answer/type {:db/ident :answer.type/math} :answer/value "2n" :db/id #edb/ref 17592186196319} :answer-field/id #uuid "0a08c691-e074-5bef-ab8c-6e4b5b3bc776" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186196318} {:answer-field/choices [{:answer/id #uuid "123b24b8-7620-59bc-ac39-6ec0bb2ab51a" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{is even}" :db/id #edb/ref 17592186305482} {:answer/id #uuid "353635c3-8f3a-5c5d-879b-4da9f0a0c726" :answer/type {:db/ident :answer.type/math} :answer/value "\\in N" :db/id #edb/ref 17592186305483} {:answer/id #uuid "1407e735-3aa6-5223-b35e-7f7e0e831c19" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{is odd}" :db/id #edb/ref 17592186305484} {:answer/id #uuid "c99c45bc-b112-540b-816a-e3ec2afbf050" :answer/type {:db/ident :answer.type/math} :answer/value "\\in Z" :db/id #edb/ref 17592186305485} {:answer/id #uuid "e49adbe1-9132-538e-80e8-f3df786f6ca0" :answer/type {:db/ident :answer.type/math} :answer/value "\\in Q" :db/id #edb/ref 17592186305486}] :answer-field/correct {:answer/id #uuid "c99c45bc-b112-540b-816a-e3ec2afbf050" :answer/type {:db/ident :answer.type/math} :answer/value "\\in Z" :db/id #edb/ref 17592186305485} :answer-field/id #uuid "dfa3f6f9-c2df-55a3-8c43-b809c6735539" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186305481}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1160b89b-a1bd-57ab-af47-94edb968dd50" :question/math-academy-id "q-183764" :question/problem "Describe the set $S={...,-4,-2,0,2,4,...}$ using a constructive definition.\n\n*Hint: Take ${a}_{1}=2$ in the sequence that generates the elements of $S.$*\n\n$$\n2n+1\n$$" :question/worked-solution "Notice that the elements of our set\n\n$$\n…,\\,-4,\\,-2,\\,0,\\,2,\\,4,\\,…\n$$\n\nform a two-way infinite arithmetic sequence with common difference $d=2:$\n\n$$\n\\begin{aligned}d & =2 \\\\  & =-2-(-4) \\\\  & =0-(-2) \\\\  & =2-0 \\\\  & =⋯\\end{aligned}\n$$\n\nTherefore, setting  ${a}_{1}=2,$ the $n$th term ${a}_{n}$ of our sequence for $n\\in Z$ is given by\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)\\cdot d \\\\  & =2+(n-1)\\cdot 2 \\\\  & =2+2n-2 \\\\  & =2n.\\end{aligned}\n$$\n\nTherefore, we can define our set using a constructive definition as follows:\n\n$$\nS={2n\\,:\\,n\\in Z}\n$$"}] [{:db/id #edb/ref 17592186305487 :knowledge-point/_questions [{:knowledge-point/id #uuid "1c5b3eb6-187f-5f16-a32e-66b0842adfe9" :knowledge-point/title "Expressing a Given Set Using an Arithmetic Sequence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08c8a46e-f206-51c3-8c95-1cd92126b8b2" :answer/type {:db/ident :answer.type/math} :answer/value "2n-1" :db/id #edb/ref 17592186305489} {:answer/id #uuid "a9e8979f-b5b1-5c0f-9423-63c15157dc01" :answer/type {:db/ident :answer.type/math} :answer/value "3n-1" :db/id #edb/ref 17592186305490} {:answer/