\cdot 4 \\\\  & =-5+4n-4 \\\\  & =4n-9.\\end{aligned}\n$$\n\nTherefore, we can define our set using a constructive definition as follows:\n\n$$\nS={4n-9\\,:\\,n\\in Z}\n$$"}] [{:db/id #edb/ref 17592186305526 :knowledge-point/_questions [{:knowledge-point/id #uuid "9df722a8-2db6-5bb8-a69c-b81b33037ab2" :knowledge-point/title "Expressing a Given Set Using a Geometric Sequence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c76a7d9-3873-5084-bc25-ffbfe9d8eb4c" :answer/type {:db/ident :answer.type/math} :answer/value "-1\\cdot {2}^{n}" :db/id #edb/ref 17592186305528} {:answer/id #uuid "d4a8b25f-f2ab-511a-b84e-9c93275ede1b" :answer/type {:db/ident :answer.type/math} :answer/value "{(\\frac{1}{2})}^{n}" :db/id #edb/ref 17592186305529} {:answer/id #uuid "3ff0f08a-c7e1-5c28-824d-ac48965905bd" :answer/type {:db/ident :answer.type/math} :answer/value "(-2)^{n}" :db/id #edb/ref 17592186305530} {:answer/id #uuid "2d560527-25e8-567a-a092-f8f31cc58150" :answer/type {:db/ident :answer.type/math} :answer/value "{2}^{n}" :db/id #edb/ref 17592186305531}] :answer-field/correct {:answer/id #uuid "3ff0f08a-c7e1-5c28-824d-ac48965905bd" :answer/type {:db/ident :answer.type/math} :answer/value "(-2)^{n}" :db/id #edb/ref 17592186305530} :answer-field/id #uuid "8b046f80-bcde-5929-a913-b519f3ada372" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186305527} {:answer-field/choices [{:answer/id #uuid "bef0b18a-c0f7-5421-a112-850c2257f4dd" :answer/type {:db/ident :answer.type/math} :answer/value "N" :db/id #edb/ref 17592186305533} {:answer/id #uuid "2832a67d-81d5-5d70-89ed-11d33910738d" :answer/type {:db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186305534} {:answer/id #uuid "4bdd7ad5-676d-5730-af7f-51adb2c55825" :answer/type {:db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186305535}] :answer-field/correct {:answer/id #uuid "2832a67d-81d5-5d70-89ed-11d33910738d" :answer/type {:db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186305534} :answer-field/id #uuid "d926cc80-aa2e-525b-aac9-22d9b2b9c93b" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186305532}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "40643ae6-fe96-508d-ba25-a4e8d94924cc" :question/math-academy-id "q-183771" :question/problem "Describe the set $S={…,-2,4,-8,16,-32,...}$ using a constructive definition.\n\n*Hint: Take ${a}_{1}=-2$ in the sequence that generates the elements of $S.$*\n\n$$\n(-2)^{n}\n$$" :question/worked-solution "Notice that the elements of our set\n\n$$\n…,\\,-2,\\,4,\\,-8,\\,16,\\,-32,\\,…\n$$\n\nform a two-way infinite geometric sequence with a common ratio $r=-2:$\n\n$$\n\\begin{aligned}r & =-2 \\\\  & =(\\frac{4}{-2}) \\\\  & =(\\frac{-8}{4}) \\\\  & =(\\frac{16}{-8}) \\\\  & =⋯\\end{aligned}\n$$\n\nTherefore, setting  ${a}_{1}=-2,$ the $n$th term ${a}_{n}$ of our sequence for $n\\in Z$ is given by\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}\\cdot {r}^{n-1} \\\\  & =-2\\cdot (-2)^{n-1} \\\\  & =-2\\cdot (-2)^{n}\\cdot (-2)^{-1} \\\\  & =\\frac{-2}{-2}\\cdot (-2)^{n} \\\\  & =(-2)^{n}.\\end{aligned}\n$$\n\nTherefore, we can define our set using a constructive definition as follows:\n\n$$\nS={(-2)^{n}\\,:\\,n\\in Z}\n$$"}] [{:db/id #edb/ref 17592186305536 :knowledge-point/_questions [{:knowledge-point/id #uuid "9df722a8-2db6-5bb8-a69c-b81b33037ab2" :knowledge-point/title "Expressing a Given Set Using a Geometric Sequence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b0d8a86a-268d-5bbf-85f1-834df7308400" :answer/type {:db/ident :answer.type/math} :answer/value "{4}^{n}" :db/id #edb/ref 17592186305538} {:answer/id #uuid "5da8de41-218e-5d13-a4b1-43f4c93113a9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\cdot {2}^{n}" :db/id #edb/ref 17592186305539} {:answer/id #u