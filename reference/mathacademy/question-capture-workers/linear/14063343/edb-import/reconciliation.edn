veloper/Course_Academy/reference/mathacademy/question-capture/13977621/state.json" "file_sha256" "4f8632640fc29664d687e17528e49f8515219b333415e77652836487813d906a" "basis" 815 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13977621/edb-import/verification.json"} {"question" "q-126507" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "⟨\\sqrt{2},\\frac{\\sqrt{2}}{2},1⟩"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13977621/state.json" "file_sha256" "4f8632640fc29664d687e17528e49f8515219b333415e77652836487813d906a" "basis" 815 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13977621/edb-import/verification.json"}] "sources" [{"question" "q-18376" "field" nil "attribute" "question/problem" "value" "Let $a=⟨2,-2,9⟩$ and $b=⟨1,-1,1⟩.$ Find the vector projection of $a$ onto $b.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063343/state.json" "file_sha256" "6c3533dc1fe5ce4399a8ddd28fb7cba35342a951dc65044daffb1cd48f76df5d"} {"question" "q-18376" "field" nil "attribute" "question/worked-solution" "value" "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{2\\cdot 1+(-2)\\cdot (-1)+9\\cdot 1}{{1}^{2}+(-1)^{2}+{1}^{2}}b \\\\  & =\\frac{13}{3}⟨1,-1,1⟩ \\\\  & =⟨\\frac{13}{3},-\\frac{13}{3},\\frac{13}{3}⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063343/state.json" "file_sha256" "6c3533dc1fe5ce4399a8ddd28fb7cba35342a951dc65044daffb1cd48f76df5d"} {"question" "q-18376" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063343/activity-metadata.json" "file_sha256" "1bd5c3970c999512670945cd4ca41a45c2292ae9162e186ac172a238c0f2b441"} {"question" "q-18376" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063343/state.json" "file_sha256" "6c3533dc1fe5ce4399a8ddd28fb7cba35342a951dc65044daffb1cd48f76df5d"} {"question" "q-18376" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "0"] ["math" "\\frac{5}{\\sqrt{3}}"] ["math" "⟨5,-5,5⟩"] ["math" "⟨\\frac{13}{3},-\\frac{13}{3},\\frac{13}{3}⟩"] ["math" "⟨\\frac{\\sqrt{3}}{3},-\\frac{\\sqrt{3}}{3},\\frac{\\sqrt{3}}{3}⟩"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063343/state.json" "file_sha256" "6c3533dc1fe5ce4399a8ddd28fb7cba35342a951dc65044daffb1cd48f76df5d"} {"question" "q-18376" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "⟨\\frac{13}{3},-\\frac{13}{3},\\frac{13}{3}⟩"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063343/state.json" "file_sha256" "6c3533dc1fe5ce4399a8ddd28fb7cba35342a951dc65044daffb1cd48f76df5d"} {"question" "q-126507" "field" nil "attribute" "question/problem" "value" "Let $a=[\\begin{aligned}6 \\\\ 3 \\\\ 3\\sqrt{2}\\end{aligned}]$ and $b=[\\begin{aligned}3 \\\\ 1 \\\\ 0\\end{aligned}].$ Find the vector projection of $b$ onto $a.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063343/state.json" "file_sha256" "6c3533dc1fe5ce4399a8ddd28fb7cba35342a951dc65044daffb1cd48f76df5d"} {"question" "q-126507" "field" nil "attribute" "question/worked-solution" "value" "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{a}\\,b & =\\frac{a\\cdot b}{a\\cdot a}a \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}a \\\\  & =\\frac{6\\cdot 3+3\\cdot 1+3\\sqrt{2}\\cdot 0}{{6}^{2}+{3}^{2}+(3\\sqrt{2})^{2}}a \\\\  & =\\frac{21}{63}⟨6,3,3\\sqrt{2}⟩ \\\\  & =\\frac{1}{3}⟨6,3,3\\sqrt{2}⟩ \\\\  & =⟨2,1,\\sqrt{2}⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063343/state.json" "file_sha256" "6c3533dc1fe5ce4399a8ddd28fb7cba35342a951dc65044daffb1cd48f76df5d"} {"question" "q-126507" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063343/activity-metadata.json" "file_sha256" "1bd5c3970c999512670945cd4ca41a45c2292ae9162e186ac172a238c0f2b441"} {"question" "q-126507" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063343/state.json" "file_sha256" "6c3533dc1fe5ce4399a8ddd28fb7cba35342a951dc65044daffb1cd48f76df5d"} {"question" "q-126507" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "⟨0,0,0⟩"] ["math" "⟨2,1,\\sqrt{2}⟩"] ["math" "⟨3\\sqrt{2},\\frac{3\\sqrt{2}}{2},3⟩"] ["math" "⟨6,3,3\\sqrt{2}⟩"] ["math" "⟨\\sqrt{2},\\frac{\\sqrt{2}}{2},1⟩"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063343/state.json" "file_sha256" "6c3533dc1fe5ce4399a8ddd28fb7cba35342a951dc65044daffb1cd48f76df5d"} {"question" "q-126507" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "⟨2,1,\\sqrt{2}⟩"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063343/state.json" "file_sha256" "6c3533dc1fe5ce4399a8ddd28fb7cba35342a951dc65044daffb1cd48f76df5d"} {"question" "q-316777" "field" nil "attribute" "question/problem" "value" "Let $u=[\\begin{aligned}4 \\\\ 2 \\\\ -3\\end{aligned}]$ and $v=[\\begin{aligned}k \\\\ -1 \\\\ 5\\end{aligned}].$ Given that the projection of $u$ onto $v$ is the zero vector, find the value of $k.$\n\n$k=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063343/state.json" "file_sha256" "6c3533dc1fe5ce4399a8ddd28fb7cba35342a951dc65044daffb1cd48f76df5d"} {"question" "q-316777" "field" nil "attribute" "question/worked-solution" "value" "Since $u$ is a nonzero vector, its projection onto another nonzero vector $v$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\nu⊥v\\,⟹\\,u\\cdot v=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}u\\cdot v & ={u}_{x}\\cdot {v}_{x}+{u}_{y}\\cdot {v}_{y}+{u}_{z}\\cdot {v}_{z} \\\\  & =4\\cdot k+2\\cdot (-1)+(-3)\\cdot 5 \\\\  & =4k-2-15 \\\\  & =4k-17.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}u\\cdot v & =0 \\\\ 4k-17 & =0 \\\\ 4k & =17 \\\\ k & =\\frac{17}{4}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063343/state.json" "file_sha256" "6c3533dc1fe5ce4399a8ddd28fb7cba35342a951dc65044daffb1cd48f76df5d"} {"question" "q-316777" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063343/activity-metadata.json" "file_sha256" "1bd5c3970c999512670945cd4ca41a45c2292ae9162e186ac172a238c0f2b441"} {"question" "q-316777" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063343/state.json" "file_sha256" "6c3533dc1fe5ce4399a8ddd28fb7cba35342a951dc65044daffb1cd48f76df5d"} {"question" "q-316777" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{17}{4}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063343/state.json" "file_sha256" "6c3533dc1fe5ce4399a8ddd28fb7cba35342a951dc65044daffb1cd48f76df5d"} {"question" "q-317938" "field" nil "attribute" "question/problem" "value" "Let $r=\\,i+3j+4k$ and $s=3i-j.$ Find the vector projection of $r$ onto $s.$\n\n${\\text{proj}}_{s}\\,r=⟨$\n{{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}\n$⟩$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063343/state.json" "file_sha256" "6c3533dc1fe5ce4399a8ddd28fb7cba35342a951dc65044daffb1cd48f76df5d"} {"question" "q-317938" "field" nil "attribute" "question/worked-solution" "value" "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{s}\\,r & =\\frac{r\\cdot s}{s\\cdot s}s \\\\  & =\\frac{{r}_{x}{s}_{x}+{r}_{y}{s}_{y}+{r}_{z}{s}_{z}}{{s}_{x}^{2}+{s}_{y}^{2}+{s}_{z}^{2}}s \\\\  & =\\frac{(1)\\cdot 3+(3)\\cdot (-1)+(4)\\cdot 0}{{3}^{2}+(-1)^{2}+{0}^{2}}s \\\\  & =\\frac{0}{{3}^{2}+(-1)^{2}+{0}^{2}}s \\\\  & =⟨0,0,0⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063343/state.json" "file_sha256" "6c3533dc1fe5ce4399a8ddd28fb7cba35342a951dc65044daffb1cd48f76df5d"} {"question" "q-317938" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063343/activity-metadata.json" "file_sha256" "1bd5c3970c999512670945cd4ca41a45c2292ae9162e186ac172a238c0f2b441"} {"question" "q-317938" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063343/state.json" "file_sha256" "6c3533dc1fe5ce4399a8ddd28fb7cba35342a951dc65044daffb1cd48f76df5d"} {"question" "q-317938" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063343/state.json" "file_sha256" "6c3533dc1fe5ce4399a8ddd28fb7cba35342a951dc65044daffb1cd48f76df5d"} {"question" "q-317938" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063343/state.json" "file_sha256" "6c3533dc1fe5ce4399a8ddd28fb7cba35342a951dc65044daffb1cd48f76df5d"} {"question" "q-317938" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063343/state.json" "file_sha256" "6c3533dc1fe5ce4399a8ddd28fb7cba35342a951dc65044daffb1cd48f76df5d"} {"question" "q-317938" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063343/state.json" "file_sha256" "6c3533dc1fe5ce4399a8ddd28fb7cba35342a951dc65044daffb1cd48f76df5d"} {"question" "q-317938" "field" "field-3" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063343/state.json" "file_sha256" "6c3533dc1fe5ce4399a8ddd28fb7cba35342a951dc65044daffb1cd48f76df5d"} {"question" "q-317944" "field" nil "attribute" "question/problem" "value" "Let $a=t\\,i-4j+k$ and $b=4i+j.$ Given that the projection of $a$ onto $b$ is the zero vector, find the value of $t.$\n\n$t=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063343/state.json" "file_sha256" "6c3533dc1fe5ce4399a8ddd28fb7cba35342a951dc65044daffb1cd48f76df5d"} {"question" "q-317944" "field" nil "attribute" "question/worked-solution" "value" "Since $a$ is a nonzero vector, its projection onto another nonzero vector $b$ equals the zero vector only when the vectors are perpendicular.\n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =t\\cdot 4+(-4)\\cdot 1+1\\cdot 0 \\\\  & =4t-4+0 \\\\  & =4t-4.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 4t-4 & =0 \\\\ 4t & =4 \\\\ t & =1 \\\\ t & =1.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063343/state.json" "file_sha256" "6c3533dc1fe5ce4399a8ddd28fb7cba35342a951dc65044daffb1cd48f76df5d"} {"question" "q-317944" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063343/activity-metadata.json" "file_sha256" "1bd5c3970c999512670945cd4ca41a45c2292ae9162e186ac172a238c0f2b441"} {"question" "q-317944" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063343/state.json" "file_sha256" "6c3533dc1fe5ce4399a8ddd28fb7cba35342a951dc65044daffb1cd48f76df5d"} {"question" "q-317944" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "1"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063343/state.json" "file_sha256" "6c3533dc1fe5ce4399a8ddd28fb7cba35342a951dc65044daffb1cd48f76df5d"}] "usage" {"q-126507" []} "basis" 2041 "retractions" [] "immutable_answers" [17592186278133 17592186278134 17592186278135 17592186278136 17592186278137] "immutable_fields" [[17592186278132 :answer-field/correct] [17592186278132 :answer-field/id] [17592186278132 :answer-field/key] [17592186278132 :answer-field/type]] "no_history" []}
