#{[{:db/id #edb/ref 17592186278131 :knowledge-point/_questions [{:knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f" :knowledge-point/title "Calculating a Vector Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ac89813-eaca-5387-a2b6-0d02fd8454ba" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\sqrt{2},\\frac{\\sqrt{2}}{2},1⟩" :db/id #edb/ref 17592186278133} {:answer/id #uuid "0e59a8e3-387e-5f83-bec5-0d38f4ae21f8" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,0,0⟩" :db/id #edb/ref 17592186278134} {:answer/id #uuid "4ef1b113-fe6c-519b-8127-c191b645f492" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3\\sqrt{2},\\frac{3\\sqrt{2}}{2},3⟩" :db/id #edb/ref 17592186278135} {:answer/id #uuid "4aed13cc-9ab2-52d0-8d21-3832ca7e15de" :answer/type {:db/ident :answer.type/math} :answer/value "⟨6,3,3\\sqrt{2}⟩" :db/id #edb/ref 17592186278136} {:answer/id #uuid "9bde2a5f-5a7c-55ac-8713-2718f5108164" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,1,\\sqrt{2}⟩" :db/id #edb/ref 17592186278137}] :answer-field/correct {:answer/id #uuid "9bde2a5f-5a7c-55ac-8713-2718f5108164" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,1,\\sqrt{2}⟩" :db/id #edb/ref 17592186278137} :answer-field/id #uuid "e2aef5f8-4e90-57ed-878d-b61826033a23" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278132}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "07d400bc-8e75-529a-86cf-3fbedf09676f" :question/math-academy-id "q-126507" :question/problem "Let $a=[\\begin{aligned}6 \\\\ 3 \\\\ 3\\sqrt{2}\\end{aligned}]$ and $b=[\\begin{aligned}3 \\\\ 1 \\\\ 0\\end{aligned}].$ Find the vector projection of $b$ onto $a.$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{a}\\,b & =\\frac{a\\cdot b}{a\\cdot a}a \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}a \\\\  & =\\frac{6\\cdot 3+3\\cdot 1+3\\sqrt{2}\\cdot 0}{{6}^{2}+{3}^{2}+(3\\sqrt{2})^{2}}a \\\\  & =\\frac{21}{63}⟨6,3,3\\sqrt{2}⟩ \\\\  & =\\frac{1}{3}⟨6,3,3\\sqrt{2}⟩ \\\\  & =⟨2,1,\\sqrt{2}⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186345387 :knowledge-point/_questions [{:knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f" :knowledge-point/title "Calculating a Vector Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d71574d1-d531-5e0a-aa26-0f8261a9e94e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{\\sqrt{3}}" :db/id #edb/ref 17592186345389} {:answer/id #uuid "dc322aa1-3aa4-56f2-be26-cc5720a52b95" :answer/type {:db/ident :answer.type/math} :answer/value "⟨5,-5,5⟩" :db/id #edb/ref 17592186345390} {:answer/id #uuid "12f61725-3383-550e-9970-e34e97be7656" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{13}{3},-\\frac{13}{3},\\frac{13}{3}⟩" :db/id #edb/ref 17592186345391} {:answer/id #uuid "c227628e-1c88-5de9-8bed-f831fee63b3e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{\\sqrt{3}}{3},-\\frac{\\sqrt{3}}{3},\\frac{\\sqrt{3}}{3}⟩" :db/id #edb/ref 17592186345392} {:answer/id #uuid "7ec83d1c-74a8-58e2-b7e0-a8bc7b21cf8a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186345393}] :answer-field/correct {:answer/id #uuid "12f61725-3383-550e-9970-e34e97be7656" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{13}{3},-\\frac{13}{3},\\frac{13}{3}⟩" :db/id #edb/ref 17592186345391} :answer-field/id #uuid "9d8b9471-1400-5a37-9972-1dd8c28eb4f1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186345388}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "21e9a6b9-a3ae-5b82-9a9a-b18f50a95876" :question/math-academy-id "q-18376" :question/problem "Let $a=⟨2,-2,9⟩$ and $b=⟨1,-1,1⟩.$ Find the vector projection of $a$ onto $b.$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{2\\cdot 1+(-2)\\cdot (-1)+9\\cdot 1}{{1}^{2}+(-1)^{2}+{1}^{2}}b \\\\  & =\\frac{13}{3}⟨1,-1,1⟩ \\\\  & =⟨\\frac{13}{3},-\\frac{13}{3},\\frac{13}{3}⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186345394 :knowledge-point/_questions [{:knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf" :knowledge-point/title "Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c3975b7f-4ac4-5a42-9849-e38851b9fd3d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17}{4}" :db/id #edb/ref 17592186345396}] :answer-field/correct {:answer/id #uuid "c3975b7f-4ac4-5a42-9849-e38851b9fd3d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17}{4}" :db/id #edb/ref 17592186345396} :answer-field/id #uuid "d422744c-b6c7-5a0f-883c-de9437655336" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186345395}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "7dc3250d-986f-5fff-8d73-68876258719b" :question/math-academy-id "q-316777" :question/problem "Let $u=[\\begin{aligned}4 \\\\ 2 \\\\ -3\\end{aligned}]$ and $v=[\\begin{aligned}k \\\\ -1 \\\\ 5\\end{aligned}].$ Given that the projection of $u$ onto $v$ is the zero vector, find the value of $k.$\n\n$k=$\n{{field-1}}" :question/worked-solution "Since $u$ is a nonzero vector, its projection onto another nonzero vector $v$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\nu⊥v\\,⟹\\,u\\cdot v=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}u\\cdot v & ={u}_{x}\\cdot {v}_{x}+{u}_{y}\\cdot {v}_{y}+{u}_{z}\\cdot {v}_{z} \\\\  & =4\\cdot k+2\\cdot (-1)+(-3)\\cdot 5 \\\\  & =4k-2-15 \\\\  & =4k-17.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}u\\cdot v & =0 \\\\ 4k-17 & =0 \\\\ 4k & =17 \\\\ k & =\\frac{17}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186345397 :knowledge-point/_questions [{:knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf" :knowledge-point/title "Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a890930-576d-5420-9fc2-a7d2e131d53a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186345399} {:answer/id #uuid "c56c7993-0d93-5ecb-8b79-7ffc719c8c6a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186345400}] :answer-field/correct {:answer/id #uuid "c56c7993-0d93-5ecb-8b79-7ffc719c8c6a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186345400} :answer-field/id #uuid "4387704b-f2ab-5c04-80c4-18c944f133ec" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186345398} {:answer-field/choices [{:answer/id #uuid "9da9da5d-5453-5529-9bfa-6c76b443c818" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186345402}] :answer-field/correct {:answer/id #uuid "9da9da5d-5453-5529-9bfa-6c76b443c818" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186345402} :answer-field/id #uuid "8bca399c-03fa-525e-b7ea-c71e2d826179" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186345401} {:answer-field/choices [{:answer/id #uuid "9d82beba-7c9d-5daf-8175-d4a579abc265" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186345404}] :answer-field/correct {:answer/id #uuid "9d82beba-7c9d-5daf-8175-d4a579abc265" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186345404} :answer-field/id #uuid "a5986a37-d327-52df-ac52-cc04aa6a5e7c" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186345403}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "48d07d0b-422b-5ddd-b71c-fe311b2ae9fc" :question/math-academy-id "q-317938" :question/problem "Let $r=\\,i+3j+4k$ and $s=3i-j.$ Find the vector projection of $r$ onto $s.$\n\n${\\text{proj}}_{s}\\,r=⟨$\n{{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}\n$⟩$" :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{s}\\,r & =\\frac{r\\cdot s}{s\\cdot s}s \\\\  & =\\frac{{r}_{x}{s}_{x}+{r}_{y}{s}_{y}+{r}_{z}{s}_{z}}{{s}_{x}^{2}+{s}_{y}^{2}+{s}_{z}^{2}}s \\\\  & =\\frac{(1)\\cdot 3+(3)\\cdot (-1)+(4)\\cdot 0}{{3}^{2}+(-1)^{2}+{0}^{2}}s \\\\  & =\\frac{0}{{3}^{2}+(-1)^{2}+{0}^{2}}s \\\\  & =⟨0,0,0⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186345405 :knowledge-point/_questions [{:knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf" :knowledge-point/title "Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a63a8722-e4a2-5162-a38c-09be4aff3e37" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186345407}] :answer-field/correct {:answer/id #uuid "a63a8722-e4a2-5162-a38c-09be4aff3e37" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186345407} :answer-field/id #uuid "5f368d53-3e65-5c17-bc02-d648314fb238" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186345406}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1d842dee-8ce6-5f41-949c-60d7e61fbfe4" :question/math-academy-id "q-317944" :question/problem "Let $a=t\\,i-4j+k$ and $b=4i+j.$ Given that the projection of $a$ onto $b$ is the zero vector, find the value of $t.$\n\n$t=$\n{{field-1}}" :question/worked-solution "Since $a$ is a nonzero vector, its projection onto another nonzero vector $b$ equals the zero vector only when the vectors are perpendicular.\n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =t\\cdot 4+(-4)\\cdot 1+1\\cdot 0 \\\\  & =4t-4+0 \\\\  & =4t-4.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 4t-4 & =0 \\\\ 4t & =4 \\\\ t & =1 \\\\ t & =1.\\end{aligned}\n$$"}]}
