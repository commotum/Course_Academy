#{[{:db/id #edb/ref 17592186278131 :knowledge-point/_questions [{:knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f" :knowledge-point/title "Calculating a Vector Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ac89813-eaca-5387-a2b6-0d02fd8454ba" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\sqrt{2},\\frac{\\sqrt{2}}{2},1⟩" :db/id #edb/ref 17592186278133} {:answer/id #uuid "0e59a8e3-387e-5f83-bec5-0d38f4ae21f8" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,0,0⟩" :db/id #edb/ref 17592186278134} {:answer/id #uuid "4ef1b113-fe6c-519b-8127-c191b645f492" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3\\sqrt{2},\\frac{3\\sqrt{2}}{2},3⟩" :db/id #edb/ref 17592186278135} {:answer/id #uuid "4aed13cc-9ab2-52d0-8d21-3832ca7e15de" :answer/type {:db/ident :answer.type/math} :answer/value "⟨6,3,3\\sqrt{2}⟩" :db/id #edb/ref 17592186278136} {:answer/id #uuid "9bde2a5f-5a7c-55ac-8713-2718f5108164" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,1,\\sqrt{2}⟩" :db/id #edb/ref 17592186278137}] :answer-field/correct {:answer/id #uuid "9bde2a5f-5a7c-55ac-8713-2718f5108164" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,1,\\sqrt{2}⟩" :db/id #edb/ref 17592186278137} :answer-field/id #uuid "e2aef5f8-4e90-57ed-878d-b61826033a23" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278132}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "07d400bc-8e75-529a-86cf-3fbedf09676f" :question/math-academy-id "q-126507" :question/problem "Let $a=[\\begin{aligned}6 \\\\ 3 \\\\ 3\\sqrt{2}\\end{aligned}]$ and $b=[\\begin{aligned}3 \\\\ 1 \\\\ 0\\end{aligned}].$ Find the vector projection of $b$ onto $a.$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{a}\\,b & =\\frac{a\\cdot b}{a\\cdot a}a \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}a \\\\  & =\\frac{6\\cdot 3+3\\cdot 1+3\\sqrt{2}\\cdot 0}{{6}^{2}+{3}^{2}+(3\\sqrt{2})^{2}}a \\\\  & =\\frac{21}{63}⟨6,3,3\\sqrt{2}⟩ \\\\  & =\\frac{1}{3}⟨6,3,3\\sqrt{2}⟩ \\\\  & =⟨2,1,\\sqrt{2}⟩.\\end{aligned}\n$$"}]}
