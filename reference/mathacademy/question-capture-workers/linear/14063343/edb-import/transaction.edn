[{:db/id "q-18376/selection/8dc8d3f5b3a605b9a5d22c056c04f2fc4e28b7a4ea6a7fc19f1104861b98bf5d" :answer/id #uuid "d71574d1-d531-5e0a-aa26-0f8261a9e94e" :answer/type :answer.type/math :answer/value "\\frac{5}{\\sqrt{3}}" :db/ensure [:answer/validate]} {:db/id "q-18376/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "7ec83d1c-74a8-58e2-b7e0-a8bc7b21cf8a" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-18376/selection/bd2795e7b506e4fd48bd45dd3c0660ee2f7267d4f8945afee1347b74ce2457f8" :answer/id #uuid "12f61725-3383-550e-9970-e34e97be7656" :answer/type :answer.type/math :answer/value "⟨\\frac{13}{3},-\\frac{13}{3},\\frac{13}{3}⟩" :db/ensure [:answer/validate]} {:db/id "q-18376/selection/c6aa4cf9f88ac9c649f30df7885edb684b94c73627795381b9dff62b96f06a07" :answer/id #uuid "c227628e-1c88-5de9-8bed-f831fee63b3e" :answer/type :answer.type/math :answer/value "⟨\\frac{\\sqrt{3}}{3},-\\frac{\\sqrt{3}}{3},\\frac{\\sqrt{3}}{3}⟩" :db/ensure [:answer/validate]} {:db/id "q-18376/selection/9314e580ab5f7bfebdbb84635e37d5cbfc477e1ca5e76fddc53b3c5f91350b63" :answer/id #uuid "dc322aa1-3aa4-56f2-be26-cc5720a52b95" :answer/type :answer.type/math :answer/value "⟨5,-5,5⟩" :db/ensure [:answer/validate]} {:db/id "q-18376/selection" :answer-field/id #uuid "9d8b9471-1400-5a37-9972-1dd8c28eb4f1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-18376/selection/bd2795e7b506e4fd48bd45dd3c0660ee2f7267d4f8945afee1347b74ce2457f8" :answer-field/choices ["q-18376/selection/8dc8d3f5b3a605b9a5d22c056c04f2fc4e28b7a4ea6a7fc19f1104861b98bf5d" "q-18376/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-18376/selection/bd2795e7b506e4fd48bd45dd3c0660ee2f7267d4f8945afee1347b74ce2457f8" "q-18376/selection/c6aa4cf9f88ac9c649f30df7885edb684b94c73627795381b9dff62b96f06a07" "q-18376/selection/9314e580ab5f7bfebdbb84635e37d5cbfc477e1ca5e76fddc53b3c5f91350b63"] :db/ensure [:answer-field/validate]} {:db/id "q-18376" :question/id #uuid "21e9a6b9-a3ae-5b82-9a9a-b18f50a95876" :question/math-academy-id "q-18376" :question/problem "Let $a=⟨2,-2,9⟩$ and $b=⟨1,-1,1⟩.$ Find the vector projection of $a$ onto $b.$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{2\\cdot 1+(-2)\\cdot (-1)+9\\cdot 1}{{1}^{2}+(-1)^{2}+{1}^{2}}b \\\\  & =\\frac{13}{3}⟨1,-1,1⟩ \\\\  & =⟨\\frac{13}{3},-\\frac{13}{3},\\frac{13}{3}⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-18376/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f"] :knowledge-point/questions ["q-18376"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316777/field-1/c0c9fe5b5e67591ea1a9a278e613c7db3f4b1066f6b217a6dd18b8063d756111" :answer/id #uuid "c3975b7f-4ac4-5a42-9849-e38851b9fd3d" :answer/type :answer.type/math :answer/value "\\frac{17}{4}" :db/ensure [:answer/validate]} {:db/id "q-316777/field-1" :answer-field/id #uuid "d422744c-b6c7-5a0f-883c-de9437655336" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316777/field-1/c0c9fe5b5e67591ea1a9a278e613c7db3f4b1066f6b217a6dd18b8063d756111" :answer-field/choices ["q-316777/field-1/c0c9fe5b5e67591ea1a9a278e613c7db3f4b1066f6b217a6dd18b8063d756111"] :db/ensure [:answer-field/validate]} {:db/id "q-316777" :question/id #uuid "7dc3250d-986f-5fff-8d73-68876258719b" :question/math-academy-id "q-316777" :question/problem "Let $u=[\\begin{aligned}4 \\\\ 2 \\\\ -3\\end{aligned}]$ and $v=[\\begin{aligned}k \\\\ -1 \\\\ 5\\end{aligned}].$ Given that the projection of $u$ onto $v$ is the zero vector, find the value of $k.$\n\n$k=$\n{{field-1}}" :question/worked-solution "Since $u$ is a nonzero vector, its projection onto another nonzero vector $v$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\nu⊥v\\,⟹\\,u\\cdot v=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}u\\cdot v & ={u}_{x}\\cdot {v}_{x}+{u}_{y}\\cdot {v}_{y}+{u}_{z}\\cdot {v}_{z} \\\\  & =4\\cdot k+2\\cdot (-1)+(-3)\\cdot 5 \\\\  & =4k-2-15 \\\\  & =4k-17.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}u\\cdot v & =0 \\\\ 4k-17 & =0 \\\\ 4k & =17 \\\\ k & =\\frac{17}{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-316777/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf"] :knowledge-point/questions ["q-316777"] :db/ensure [:knowledge-point/validate]} {:db/id "q-317938/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "c56c7993-0d93-5ecb-8b79-7ffc719c8c6a" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-317938/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "6a890930-576d-5420-9fc2-a7d2e131d53a" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-317938/field-1" :answer-field/id #uuid "4387704b-f2ab-5c04-80c4-18c944f133ec" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317938/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-317938/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-317938/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-317938/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "9da9da5d-5453-5529-9bfa-6c76b443c818" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-317938/field-2" :answer-field/id #uuid "8bca399c-03fa-525e-b7ea-c71e2d826179" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317938/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-317938/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-317938/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "9d82beba-7c9d-5daf-8175-d4a579abc265" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-317938/field-3" :answer-field/id #uuid "a5986a37-d327-52df-ac52-cc04aa6a5e7c" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317938/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-317938/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-317938" :question/id #uuid "48d07d0b-422b-5ddd-b71c-fe311b2ae9fc" :question/math-academy-id "q-317938" :question/problem "Let $r=\\,i+3j+4k$ and $s=3i-j.$ Find the vector projection of $r$ onto $s.$\n\n${\\text{proj}}_{s}\\,r=⟨$\n{{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}\n$⟩$" :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{s}\\,r & =\\frac{r\\cdot s}{s\\cdot s}s \\\\  & =\\frac{{r}_{x}{s}_{x}+{r}_{y}{s}_{y}+{r}_{z}{s}_{z}}{{s}_{x}^{2}+{s}_{y}^{2}+{s}_{z}^{2}}s \\\\  & =\\frac{(1)\\cdot 3+(3)\\cdot (-1)+(4)\\cdot 0}{{3}^{2}+(-1)^{2}+{0}^{2}}s \\\\  & =\\frac{0}{{3}^{2}+(-1)^{2}+{0}^{2}}s \\\\  & =⟨0,0,0⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-317938/field-1" "q-317938/field-2" "q-317938/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf"] :knowledge-point/questions ["q-317938"] :db/ensure [:knowledge-point/validate]} {:db/id "q-317944/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "a63a8722-e4a2-5162-a38c-09be4aff3e37" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-317944/field-1" :answer-field/id #uuid "5f368d53-3e65-5c17-bc02-d648314fb238" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317944/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-317944/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-317944" :question/id #uuid "1d842dee-8ce6-5f41-949c-60d7e61fbfe4" :question/math-academy-id "q-317944" :question/problem "Let $a=t\\,i-4j+k$ and $b=4i+j.$ Given that the projection of $a$ onto $b$ is the zero vector, find the value of $t.$\n\n$t=$\n{{field-1}}" :question/worked-solution "Since $a$ is a nonzero vector, its projection onto another nonzero vector $b$ equals the zero vector only when the vectors are perpendicular.\n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =t\\cdot 4+(-4)\\cdot 1+1\\cdot 0 \\\\  & =4t-4+0 \\\\  & =4t-4.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 4t-4 & =0 \\\\ 4t & =4 \\\\ t & =1 \\\\ t & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-317944/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf"] :knowledge-point/questions ["q-317944"] :db/ensure [:knowledge-point/validate]}]
