)| \\\\  & =|(\\pm 1)\\cdot \\text{det}(Q)| \\\\  & =|\\pm 1|\\cdot |\\text{det}(Q)| \\\\  & =|\\text{det}(Q)| \\\\  & =|10\\cdot (-1)-\\sqrt{6}\\cdot (-2\\sqrt{6})| \\\\  & =2\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-84253/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ee00be0e-f6a2-5269-a36d-1eeaf1b32344"] :knowledge-point/questions ["q-84253"] :db/ensure [:knowledge-point/validate]} {:db/id "q-84242/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer/id #uuid "86b85a3c-3ef6-51ff-a448-7f6ee8073477" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "q-84242/selection/9b838c83a9748783f7eb9953a9cbffd2e03bcbe7eedaa06140cd79812661f455" :answer/id #uuid "c6e08f5a-558a-541d-a731-a1c76fcf2fd5" :answer/type :answer.type/math :answer/value "25-\\sqrt{33}" :db/ensure [:answer/validate]} {:db/id "q-84242/selection/af5580a233ee3709064249d6732fc822dfb93f38caf90c025deb51b127e90b2c" :answer/id #uuid "08783865-4f80-58aa-a1d5-c20710221297" :answer/type :answer.type/math :answer/value "2\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-84242/selection/ac46d580a95a8fc03d1a7cb07de70e107b73fba6bf1bc1d13103b84eff3df012" :answer/id #uuid "2d2db637-24c5-5802-9260-455f8a32ef52" :answer/type :answer.type/math :answer/value "17" :db/ensure [:answer/validate]} {:db/id "q-84242/selection/e326a281f601aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666" :answer/id #uuid "874beb8b-4a1d-5e11-8ca5-55c24e49e479" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "q-84242/selection" :answer-field/id #uuid "41db1663-b0d5-5891-b291-1bea9e785b8d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-84242/selection/ac46d580a95a8fc03d1a7cb07de70e107b73fba6bf1bc1d13103b84eff3df012" :answer-field/choices ["q-84242/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" "q-84242/selection/9b838c83a9748783f7eb9953a9cbffd2e03bcbe7eedaa06140cd79812661f455" "q-84242/selection/af5580a233ee3709064249d6732fc822dfb93f38caf90c025deb51b127e90b2c" "q-84242/selection/ac46d580a95a8fc03d1a7cb07de70e107b73fba6bf1bc1d13103b84eff3df012" "q-84242/selection/e326a281f601aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666"] :db/ensure [:answer-field/validate]} {:db/id "q-84242" :question/id #uuid "cbc26144-c9fc-5479-810a-e853c852a36f" :question/math-academy-id "q-84242" :question/problem "$$\nP=[\\begin{aligned}\\frac{1}{\\sqrt{17}} & \\frac{4}{\\sqrt{17}} \\\\ -\\frac{4}{\\sqrt{17}} & \\frac{1}{\\sqrt{17}}\\end{aligned}],\\,Q=[\\begin{aligned}5 & \\sqrt{2} \\\\ 4\\sqrt{2} & 5\\end{aligned}]\n$$\n\nFind $|\\text{det}(PQ)|$ given that $P$ is an orthogonal matrix." :question/worked-solution "We use the following facts: \n\n- The determinant of a product is equal to the product of the determinants.\n\n- The determinant of an orthogonal matrix $P$ is equal to $\\pm 1.$\n\nApplying these ideas, we get the following:\n\n$$\n\\begin{aligned}|\\text{det}(PQ)| & =|\\text{det}(P)\\cdot \\text{det}(Q)| \\\\  & =|(\\pm 1)\\cdot \\text{det}(Q)| \\\\  & =|\\pm 1|\\cdot |\\text{det}(Q)| \\\\  & =|\\text{det}(Q)| \\\\  & =|5\\cdot 5-\\sqrt{2}\\cdot 4\\sqrt{2}| \\\\  & =17\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-84242/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ee00be0e-f6a2-5269-a36d-1eeaf1b32344"] :knowledge-point/questions ["q-84242"] :db/ensure [:knowledge-point/validate]} {:db/id "q-84779/selection/e6207d10c355c92a0e749364571706bb94c008bff2ad689e5eea30d34c7a2cf8" :answer/id #uuid "97e16bd7-c15a-5685-8ebe-b53627b5aeb8" :answer/type :answer.type/math :answer/value "\\sqrt{5}-3" :db/ensure [:answer/validate]} {:db/id "q-84779/selection/b5d40a4bb63abe7b291f3a38c2b346b3194c89b5ae27d5bb72031f1f4f900d25" :answer/id #uuid "10043d4b-df6c-5be4-8a36-4308a7086c9