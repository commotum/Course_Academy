ensure [:answer-field/validate]} {:db/id "q-84257" :question/id #uuid "5d295ce9-f8cd-5701-932f-c89dd90a82fd" :question/math-academy-id "q-84257" :question/problem "Solve for $x$ in $Ax=b$ given that the matrix $A$ is orthogonal, and \n\n$$\nA=[\\begin{aligned}\\frac{1}{\\sqrt{5}} & -\\frac{2}{\\sqrt{5}} & 0 \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}} & 0 \\\\ 0 & 0 & 1\\end{aligned}],\\,b=[\\begin{aligned}\\sqrt{5} \\\\ 0 \\\\ 3\\end{aligned}].\n$$" :question/worked-solution "The inverse of an orthogonal matrix is equal to its transpose.\n\nHence, since $A$ is orthogonal, we have ${A}^{-1}={A}^{T}.$ Therefore,\n\n$$\n\\begin{aligned}Ax & =b \\\\ {A}^{-1}Ax & ={A}^{-1}b \\\\ x & ={A}^{-1}b \\\\ x & ={A}^{T}b \\\\ x & =[\\begin{aligned}\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} & 0 \\\\ -\\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}} & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}\\sqrt{5} \\\\ 0 \\\\ 3\\end{aligned}] \\\\ x & =[\\begin{aligned}1 \\\\ -2 \\\\ 3\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-84257/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f2a22cfc-9a78-57ab-93a4-3c3255c34bf7"] :knowledge-point/questions ["q-84257"] :db/ensure [:knowledge-point/validate]} {:db/id "q-140563/selection/c0566eb693a45a2f7b5d4694f939275fd48fff54d6b5ed8f3381c7871a815ce6" :answer/id #uuid "9e8b40f6-14d3-5353-a75a-61819fb4a0af" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{7}{3} \\\\ -\\frac{1}{3} \\\\ \\frac{2}{3}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-140563/selection/5c4168de4278252cb90f3b8c8c6dc480a1bb3fcbad0cc6fb7d2202a15f1b4da4" :answer/id #uuid "0e9fbaa6-d3fa-5b03-a34e-3ba117b9469e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{4}{3} \\\\ \\frac{2}{3} \\\\ \\frac{1}{3}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-140563/selection/3d0e155b7182df7471a20d1b49f4ae7529924db7171f79a68f61e9