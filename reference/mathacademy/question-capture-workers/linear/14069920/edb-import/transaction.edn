9127977f20fbab89a940b170bac777f18f881b9b"] :db/ensure [:answer-field/validate]} {:db/id "q-84778" :question/id #uuid "ddf41264-5352-572e-abd0-a14a7c94b416" :question/math-academy-id "q-84778" :question/problem "$$\nP=[\\begin{aligned}\\frac{4}{\\sqrt{17}} & -\\frac{1}{\\sqrt{17}} \\\\ \\frac{1}{\\sqrt{17}} & \\frac{4}{\\sqrt{17}}\\end{aligned}],\\,Q=[\\begin{aligned}2\\sqrt{7} & \\sqrt{5} \\\\ 4\\sqrt{5} & 5\\sqrt{7}\\end{aligned}]\n$$\n\nFind $|\\text{det}(PQ)|$ given that $P$ is an orthogonal matrix." :question/worked-solution "We use the following facts: \n\n- The determinant of a product is equal to the product of the determinants.\n\n- The determinant of an orthogonal matrix $P$ is equal to $\\pm 1.$\n\nApplying these ideas, we get the following:\n\n$$\n\\begin{aligned}|\\text{det}(PQ)| & =|\\text{det}(P)\\cdot \\text{det}(Q)| \\\\  & =|(\\pm 1)\\cdot \\text{det}(Q)| \\\\  & =|\\pm 1|\\cdot |\\text{det}(Q)| \\\\  & =|\\text{det}(Q)| \\\\  & =|2\\sqrt{7}\\cdot 5\\sqrt{7}-\\sqrt{5}\\cdot 4\\sqrt{5}| \\\\  & =50\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-84778/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ee00be0e-f6a2-5269-a36d-1eeaf1b32344"] :knowledge-point/questions ["q-84778"] :db/ensure [:knowledge-point/validate]} {:db/id "q-84253/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "3af870e6-d376-5e41-8e28-cd2cb43f0944" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-84253/selection/b862be62d89d328571f5ce6883b23f85565a71c62aabd66911e9e5f7d34666db" :answer/id #uuid "9324868b-6a9f-58b1-89d4-b07ec41237d2" :answer/type :answer.type/math :answer/value "10-\\sqrt{6}" :db/ensure [:answer/validate]} {:db/id "q-84253/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "3f0e389c-a540-523c-87d4-f9902722e369" :answer/type :answer.type/math :answer/value "10" :db