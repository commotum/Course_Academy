-solution "The inverse of an orthogonal matrix is equal to its transpose.\n\nTherefore, since $D$ is orthogonal, we have \n\n$$\n\\begin{aligned}{D}^{-1} & ={D}^{T}=[\\begin{aligned}-\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & -\\frac{2}{\\sqrt{5}}\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-84255/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f2a22cfc-9a78-57ab-93a4-3c3255c34bf7"] :knowledge-point/questions ["q-84255"] :db/ensure [:knowledge-point/validate]} {:db/id "q-84780/selection/9649d09b605a5c8795705cdd42fc25988adb872617c855d51b4c64a39462d748" :answer/id #uuid "1128f533-4273-5091-b104-00d850fb8cb3" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-\\sqrt{10} & \\sqrt{10} \\\\ -\\sqrt{10} & -\\sqrt{10}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-84780/selection/04bb91ece73bc92c94262ecbde4dd25b9a454734eeb0b140f17822a7a4e23930" :answer/id #uuid "52e97ffd-f524-5450-90bc-a5454aa9d766" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-\\frac{3}{\\sqrt{10}} & -\\frac{1}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-84780/selection/aafb2de22ab795117f6518b54c6becd00c4be880293deb2012c0be4bf2c6204f" :answer/id #uuid "585f4031-ae79-5fb4-a9a9-77c5845015e7" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-\\sqrt{10} & -\\sqrt{10} \\\\ \\sqrt{10} & -\\sqrt{10}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-84780/selection/8c49cce45f0ca9e5a1f833b81475e8d77aca83fea7863248a6cfb3036d0e0dab" :answer/id #uuid "c25d4770-9bee-5ed4-a2af-3d709faf8e88" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-\\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}} \\\\ -\\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-84780/selection/92eca8c7cbd6237da4d99b1cd6ebd96c