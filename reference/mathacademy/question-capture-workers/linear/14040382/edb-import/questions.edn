nswer.type/math} :answer/value "\\begin{bmatrix}x \\\\ y\\end{bmatrix} = \\begin{bmatrix}-3 + 2y \\\\ y\\end{bmatrix}, y ∈ (- ∞, ∞)" :db/id #edb/ref 17592186103982} {:answer/id #uuid "53067f6a-4d7b-5e7c-8d87-f471325bbfd7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}x \\\\ y\\end{bmatrix} = \\begin{bmatrix}-3 - 2y \\\\ y\\end{bmatrix}, y ∈ (- ∞, ∞)" :db/id #edb/ref 17592186103983} {:answer/id #uuid "74e6c3a5-07f0-50dd-9d6b-c04b849ebff5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}x \\\\ y\\end{bmatrix} = \\begin{bmatrix}3 - 2y \\\\ y\\end{bmatrix}, y ∈ (- ∞, ∞)" :db/id #edb/ref 17592186103984}] :answer-field/correct {:answer/id #uuid "74e6c3a5-07f0-50dd-9d6b-c04b849ebff5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}x \\\\ y\\end{bmatrix} = \\begin{bmatrix}3 - 2y \\\\ y\\end{bmatrix}, y ∈ (- ∞, ∞)" :db/id #edb/ref 17592186103984} :answer-field/id #uuid "c883284d-7546-5af1-ac9b-7383912f56c1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186103979}] :question/id #uuid "b8d44a54-5566-5151-9860-c8651da54abd" :question/math-academy-id "q-42167" :question/problem "Consider the system of linear equations\n\n${7x + 14y = 21; 3x + 6y = 9$.\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then find the general solution of the linear system."}]}
