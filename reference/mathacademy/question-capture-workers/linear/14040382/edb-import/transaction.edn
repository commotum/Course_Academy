tion/7c6392fbe300df8e3c01a141c020309ce048dba05eaf5b9dd2b8261339657e9b" "q-73742/selection/373c549cf3b13c9427090e25fbd231e0570448e21980fbc5bd814f2fa0e4b5ce"] :db/ensure [:answer-field/validate]} {:db/id "q-73742" :question/id #uuid "d9692e24-b7a8-50f1-8112-715c2c164437" :question/math-academy-id "q-73742" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=[\\begin{aligned}3 & -9 & 6 \\\\ 4 & -12 & 8\\end{aligned}].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form." :question/worked-solution "Reducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}3 & -9 & 6 \\\\ 4 & -12 & 8\\end{aligned}] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 \\\\ 4 & -12 & 8\\end{aligned}] & {R}_{2} & :={R}_{2}-4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-73742/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "97cd9132-458b-5234-a3d2-22b633acb74c"] :knowledge-point/questions ["q-73742"] :db/ensure [:knowledge-point/validate]} {:db/id "q-42160/selection/cad2b618894174cc3072b3f30e5f7002a7d9b1a323a05a515566cdcfb513cec1" :answer/id #uuid "3d159cbd-15f5-5c4e-819c-6250ef961989" :answer/type :answer.type/math :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-6+4y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-42160/selection/fcab1e67fe0370a84dc3c997ffd8d69aa72546471d29385e1692a89a5ee54251" :answer/id #uuid "760403b1-cfa8-57ea-8148-9cd91ea95a58" :answer/type :answer.type/math :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}4+4y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-42160/selection/ec6225b3beadaea1468f1945575161c2c683673f4661710a0dca0e4c3a1c915b" :answer/id #uuid "78b2dbe2-7bc6-5919-8f35-4ddd0f7101b9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}6-4y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-42160/selection/6f56db1fdad44b849d5aef3d2fd1d6e98016695476b51c7b7270920b420d1337" :answer/id #uuid "8995b104-5491-54e2-8b4f-92294ea8fca1" :answer/type :answer.type/math :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}2+4y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-42160/selection/efbffdee914290ce1bb709ed882a58e1257ada49d3ac76f0463dac7799fd2a44" :answer/id #uuid "cfaf4711-0d8d-5a85-a03e-58c5ce5b11ee" :answer/type :answer.type/math :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}6+4y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-42160/selection" :answer-field/id #uuid "a37ad367-dbc8-5fb4-92d3-75a3b4a31a1a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-42160/selection/efbffdee914290ce1bb709ed882a58e1257ada49d3ac76f0463dac7799fd2a44" :answer-field/choices ["q-42160/selection/cad2b618894174cc3072b3f30e5f7002a7d9b1a323a05a515566cdcfb513cec1" "q-42160/selection/fcab1e67fe0370a84dc3c997ffd8d69aa72546471d29385e1692a89a5ee54251" "q-42160/selection/ec6225b3beadaea1468f1945575161c2c683673f4661710a0dca0e4c3a1c915b" "q-42160/selection/6f56db1fdad44b849d5aef3d2fd1d6e98016695476b51c7b7270920b420d1337" "q-42160/selection/efbffdee914290ce1bb709ed882a58e1257ada49d3ac76f0463dac7799fd2a44"] :db/ensure [:answer-field/validate]} {:db/id "q-42160" :question/id #uuid "d49a7f92-7486-5a6e-9890-b6f6940d9011" :question/math-academy-id "q-42160" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=[\\begin{aligned}1 & -4 & 6 \\\\ -2 & 8 & -12\\end{aligned}].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then find the general solution of the linear system represented by the matrix." :question/worked-solution "Reducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -4 & 6 \\\\ -2 & 8 & -12\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -4 & 6 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n{\\begin{aligned}x-4y=6 \\\\ 0x+0y=0.\\end{aligned}\n$$\n\nSince any pair of numbers $x,y$ is a solution of the final equation $0x+0y=0,$ we can remove this equation from the system. So, our system now consists of a single equation\n\n$$\nx-4y=6.\n$$\n\nThe first variable $(x)$ is the basic variable, and the second variable $(y)$ is the free variable. Solving for the basic variable $(x)$ in terms of the free variable $(y),$ we get $x=6+4y,$ and the general solution is\n\n$$\n{\\begin{aligned}x=6+4y \\\\ y=y\\end{aligned}\n$$\n\nwhere $y$ is an arbitrary number. \n\nIn vector form, the general solution can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}6+4y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-42160/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "97cd9132-458b-5234-a3d2-22b633acb74c"] :knowledge-point/questions ["q-42160"] :db/ensure [:knowledge-point/validate]} {:db/id "q-20782/selection/ad5159bff20e89400e8ca546efff79d156a2d1ff8cbb94c62fc22a8979b23417" :answer/id #uuid "46d31aac-6805-5142-a724-3ab3c7d77cd3" :answer/type :answer.type/math :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-2+3y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-20782/selection/97884c1bb509803cd3b24e0d97b0415247bbc44095276bb813581ae95ef3d8dd" :answer/id #uuid "0ef3fb7a-5973-50ad-b9f7-22b8f6264b8c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-3-2y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-20782/selection/a9c61c6f10b1e577ed71468d22767159a20a9fe7856dd5dabfb69789eba772d1" :answer/id #uuid "d367f885-a88e-529f-9977-18b9101a8721" :answer/type :answer.type/math :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}3-2y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-20782/selection/2c5660bbbb7cbe9946e069a0adb79c061166392e374c5e44a50eaa6df930f243" :answer/id #uuid "a2c8b603-da2c-547e-b192-9b2d550f9286" :answer/type :answer.type/math :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-3+2y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-20782/selection/c82b71fc7af4cf63f8e2138a8871603dd49bc817c6c95f12d6fba911a36576b1" :answer/id #uuid "fd571244-d6e2-5875-a8df-355eceaf23cd" :answer/type :answer.type/math :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}3+2y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-20782/selection" :answer-field/id #uuid "6bb0dbaf-c46c-5ba7-8849-0019323bebec" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-20782/selection/2c5660bbbb7cbe9946e069a0adb79c061166392e374c5e44a50eaa6df930f243" :answer-field/choices ["q-20782/selection/ad5159bff20e89400e8ca546efff79d156a2d1ff8cbb94c62fc22a8979b23417" "q-20782/selection/97884c1bb509803cd3b24e0d97b0415247bbc44095276bb813581ae95ef3d8dd" "q-20782/selection/a9c61c6f10b1e577ed71468d22767159a20a9fe7856dd5dabfb69789eba772d1" "q-20782/selection/2c5660bbbb7cbe9946e069a0adb79c061166392e374c5e44a50eaa6df930f243" "q-20782/selection/c82b71fc7af4cf63f8e2138a8871603dd49bc817c6c95f12d6fba911a36576b1"] :db/ensure [:answer-field/validate]} {:db/id "q-20782" :question/id #uuid "8ab34347-482c-500f-9bf4-3eb466e5cadc" :question/math-academy-id "q-20782" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=[\\begin{aligned}1 & -2 & -3 \\\\ -7 & 14 & 21\\end{aligned}].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then find the general solution of the linear system represented by the matrix." :question/worked-solution "Reducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & -2 & -3 \\\\ -7 & 14 & 21\\end{aligned}] & {R}_{2} & :={R}_{2}+7{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & -3 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n{\\begin{aligned}x-2y=-3 \\\\ 0x+0y=0.\\end{aligned}\n$$\n\nSince any pair of numbers $x,y$ is a solution of the final equation $0x+0y=0,$ we can remove this equation from the system. So, our system now consists of a single equation\n\n$$\nx-2y=-3.\n$$\n\nThe first variable $(x)$ is the basic variable, and the second variable $(y)$ is the free variable. Solving for the basic variable $(x)$ in terms of the free variable $(y),$ we get $x=-3+2y,$ and the general solution is\n\n$$\n{\\begin{aligned}x=-3+2y \\\\ y=y\\end{aligned}\n$$\n\nwhere $y$ is an arbitrary number. \n\nIn vector form, the general solution can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-3+2y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-20782/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "97cd9132-458b-5234-a3d2-22b633acb74c"] :knowledge-point/questions ["q-20782"] :db/ensure [:knowledge-point/validate]} {:db/id "q-42158/selection/2e4ad49e2acec25ef99c299306933babdbb6331634cc6b050f5c0606c300f3ea" :answer/id #uuid "5fc0dd0c-8155-52f7-85c1-67460f560506" :answer/type :answer.type/math :answer/value "⟨3-2y,\\,y⟩,\\,y\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-42158/selection/d00a85e8a6c7be1e0829ffe7aad6069c8e18ce9ce0eabc2be6d0adca2623834f" :answer/id #uuid "72b4bd0c-3e11-52c6-ae20-49d2acd4f43d" :answer/type :answer.type/math :answer/value "⟨-3-2y,\\,y⟩,\\,y\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-42158/selection/fd59f89540248630020a7acf3836e11bb3ce1ae59607d64f5de566caf58ae679" :answer/id #uuid "7b1c40c4-f4b7-55ef-a27d-ab98965c0257" :answer/type :answer.type/math :answer/value "⟨2-3y,\\,y⟩,\\,y\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-42158/selection/4927185a8fec80b5146c1847f67c0a5720876dc1a143cfde6b9c1665941d8190" :answer/id #uuid "cf532962-0b61-56c6-abe5-2f439d1bcee7" :answer/type :answer.type/math :answer/value "⟨-3+2y,\\,y⟩,\\,y\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-42158/selection/ca8bb4f4fda2399fbcef7fe3ef1dd8d30e4d42bb6915e9e461ddc81418be1b2f" :answer/id #uuid "2891b2a9-fde6-5a25-acf1-6a39a579d955" :answer/type :answer.type/math :answer/value "⟨3+2y,\\,y⟩,\\,y\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-42158/selection" :answer-field/id #uuid "0373ab5f-2241-5ea2-b2fd-45fda6decc19" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-42158/selection/2e4ad49e2acec25ef99c299306933babdbb6331634cc6b050f5c0606c300f3ea" :answer-field/choices ["q-42158/selection/2e4ad49e2acec25ef99c299306933babdbb6331634cc6b050f5c0606c300f3ea" "q-42158/selection/d00a85e8a6c7be1e0829ffe7aad6069c8e18ce9ce0eabc2be6d0adca2623834f" "q-42158/selection/fd59f89540248630020a7acf3836e11bb3ce1ae59607d64f5de566caf58ae679" "q-42158/selection/4927185a8fec80b5146c1847f67c0a5720876dc1a143cfde6b9c1665941d8190" "q-42158/selection/ca8bb4f4fda2399fbcef7fe3ef1dd8d30e4d42bb6915e9e461ddc81418be1b2f"] :db/ensure [:answer-field/validate]} {:db/id "q-42158" :question/id #uuid "41fb9598-c5d7-5a4e-b94b-50dacda69952" :question/math-academy-id "q-42158" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=[\\begin{aligned}1 & 2 & 3 \\\\ 0 & 0 & 0\\end{aligned}].\n$$\n\nFind the general solution of the linear system represented by the matrix." :question/worked-solution "The system corresponding to $M$ is \n\n$$\n{\\begin{aligned}x+2y=3 \\\\ 0x+0y=0.\\end{aligned}\n$$\n\nSince any pair of numbers $x,y$ is a solution of the final equation $0x+0y=0,$ we can remove this equation from the system. So, our system now consists of a single equation\n\n$$\nx+2y=3.\n$$\n\nThe first variable $(x)$ is the basic variable, and the second variable $(y)$ is the free variable. Solving for the basic variable $(x)$ in terms of the free variable $(y),$ we get $x=3-2y,$ and the general solution is\n\n$$\n{\\begin{aligned}x=3-2y \\\\ y=y\\end{aligned}\n$$\n\nwhere $y$ is an arbitrary number. \n\nIn vector form, the general solution can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}3-2y \\\\ y\\end{aligned}]=⟨3-2y,\\,y⟩,\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-42158/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "97cd9132-458b-5234-a3d2-22b633acb74c"] :knowledge-point/questions ["q-42158"] :db/ensure [:knowledge-point/validate]} {:db/id "q-20958/selection/3cc3a1389897f3a44bba8ad77c4a0042d0d2e928252b837ac76a50f6ea049682" :answer/id #uuid "11e0bdb8-5060-5a62-b0c3-b72cf64e61f3" :answer/type :answer.type/math :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}7-3y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-20958/selection/dc76bc89c213cdc06ecaa0ded1ba0305f4d1c857b946fc18b64ca5455798217e" :answer/id #uuid "68a0b1ac-f8ae-5c11-be74-a0dfa9cbf015" :answer/type :answer.type/math :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}7+3y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id