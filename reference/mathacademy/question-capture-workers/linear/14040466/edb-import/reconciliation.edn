igned}B & =[\\begin{aligned}1 & 0 & 0 & -1 & 0 \\\\ 3 & 0 & 2 & -1 & 1 \\\\ 0 & 0 & -4 & 0 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & -1 & 0 \\\\ 0 & 0 & 2 & 2 & 1 \\\\ 0 & 0 & -4 & 0 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & -1 & 0 \\\\ 0 & 0 & 2 & 2 & 1 \\\\ 0 & 0 & 0 & 4 & 2\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $A$ has $3$ pivots, and therefore the number of pivot columns is $3.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040466/state.json" "file_sha256" "188a90c8d285115c8f9782c0822a031f73e5b982e9d16da506e3298b12c81776"} {"question" "q-130957" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040466/activity-metadata.json" "file_sha256" "2c680fda06fa2f83e46075e6ebe9b567cd34ab2f0257707276276bc6230ca565"} {"question" "q-130957" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040466/state.json" "file_sha256" "188a90c8d285115c8f9782c0822a031f73e5b982e9d16da506e3298b12c81776"} {"question" "q-130957" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "1"] ["math" "2"] ["math" "3"] ["math" "4"] ["math" "5"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040466/state.json" "file_sha256" "188a90c8d285115c8f9782c0822a031f73e5b982e9d16da506e3298b12c81776"} {"question" "q-130957" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "3"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/