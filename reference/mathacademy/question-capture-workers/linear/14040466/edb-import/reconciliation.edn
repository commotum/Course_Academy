 0 & 0 & 0 & 0\\end{aligned}]\n$$\n\nTherefore, the only non-pivot columns are the $2$nd and $5$th columns." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040466/state.json" "file_sha256" "188a90c8d285115c8f9782c0822a031f73e5b982e9d16da506e3298b12c81776"} {"question" "q-130953" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040466/activity-metadata.json" "file_sha256" "2c680fda06fa2f83e46075e6ebe9b567cd34ab2f0257707276276bc6230ca565"} {"question" "q-130953" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040466/state.json" "file_sha256" "188a90c8d285115c8f9782c0822a031f73e5b982e9d16da506e3298b12c81776"} {"question" "q-130953" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "$1$st, $3$rd, and $4$th only"] ["text" "$2$nd and $4$th only"] ["text" "$2$nd and $5$th only"] ["text" "$2$nd only"] ["text" "$5$th only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040466/state.json" "file_sha256" "188a90c8d285115c8f9782c0822a031f73e5b982e9d16da506e3298b12c81776"} {"question" "q-130953" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "$2$nd and $5$th only"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040466/state.json" "file_sha256" "188a90c8d285115c8f9782c0822a031f73e5b982e9d16da506e3298b12c81776"} {"question" "q-130949" "field" nil "attribute" "question/problem" "value" "The row echelon form matrix $P$ is given below. What are its **non**-pivot columns?\n\n$$\nP=[\\begin{aligned}5 & -7 & 9 & 5 \\\\ 0 & 0 & -2 & 4 \\\\ 0 & 0 & 0 & -1\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040466/state.json" "file_sha256" "188a90c8d285115c8f9782c0822a031f73e5b982e9d16da506e3298b12c81776"} {"question" "q-130949" "field" nil "attribute" "question/worked-solution" "value" "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $P$ has $3$ pivots in the $1$st, $3$rd, and $4$th columns:\n\n$$\nP=[\\begin{aligned}5 & -7 & 9 & 5 \\\\ 0 & 0 & -2 & 4 \\\\ 0 & 0 & 0 & -1\\end{aligned}]\n$$\n\nTherefore, the only non-pivot column is the $2$nd column." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040466/state.json" "file_sha256" "188a90c8d285115c8f9782c0822a031f73e5b982e9d16da506e3298b12c81776"} {"question" "q-130949" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040466/activity-metadata.json" "file_sha256" "2c680fda06fa2f83e46075e6ebe9b567cd34ab2f0257707276276bc6230ca565"} {"question" "q-130949" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040466/state.json" "file_sha256" "188a90c8d285115c8f9782c0822a031f73e5b982e9d16da506e3298b12c81776"} {"question" "q-130949" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "$1$st and $2$nd only"] ["text" "$1$st only"] ["text" "$2$nd and $3$rd only"] ["text" "$2$nd only"] ["text" "$3$rd and $4$th only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040466/state.json" "file_sha256" "188a90c8d285115c8f9782c0822a031f73e5b982e9d16da506e3298b12c81776"} {"question" "q-130949" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "$2$nd only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040466/state.json" "file_sha256" "188a90c8d285115c8f9782c0822a031f73e5b982e9d16da506e3298b12c81776"} {"question" "q-35453" "field" nil "attribute" "question/problem" "value" "Determine the number of pivot columns of the matrix $B,$ given by\n\n$$\nB=[\\begin{aligned}-2 & 0 & 0 & 0 & 0 \\\\ 0 & 1 & 4 & -2 & 0 \\\\ 0 & -3 & -6 & 4 & 2 \\\\ 0 & 0 & -3 & 1 & -1\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040466/state.json" "file_sha256" "188a90c8d285115c8f9782c0822a031f73e5b982e9d16da506e3298b12c81776"} {"question" "q-35453" "field" nil "attribute" "question/worked-solution" "value" "First, we need to convert $B$ to row echelon form:\n\n$$\n\\begin{aligned}B & =[\\begin{aligned}-2 & 0 & 0 & 0 & 0 \\\\ 0 & 1 & 4 & -2 & 0 \\\\ 0 & -3 & -6 & 4 & 2 \\\\ 0 & 0 & -3 & 1 & -1\\end{aligned}] & {R}_{3} & :={R}_{3}+3{R}_{2} \\\\  & ∼[\\begin{aligned}-2 & 0 & 0 & 0 & 0 \\\\ 0 & 1 & 4 & -2 & 0 \\\\ 0 & 0 & 6 & -2 & 2 \\\\ 0 & 0 & -3 & 1 & -1\\end{aligned}] & {R}_{4} & :={R}_{4}+\\frac{1}{2}{R}_{3} \\\\  & ∼[\\begin{aligned}-2 & 0 & 0 & 0 & 0 \\\\ 0 & 1 & 4 & -2 & 0 \\\\ 0 & 0 & 6 & -2 & 2 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $B$ has $3$ pivots, and therefore the number of pivot columns is $3.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040466/state.json" "file_sha256" "188a90c8d285115c8f9782c0822a031f73e5b982e9d16da506e3298b12c81776"} {"question" "q-35453" "field" nil "