56a3b" "q-130957/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-130957/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-130957/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-130957" :question/id #uuid "d95bf93e-1450-553f-9ef8-b9be3aa5bf3e" :question/math-academy-id "q-130957" :question/problem "Determine the number of pivot columns of the matrix $B,$ given by\n\n$$\nB=[\\begin{aligned}1 & 0 & 0 & -1 & 0 \\\\ 3 & 0 & 2 & -1 & 1 \\\\ 0 & 0 & -4 & 0 & 0\\end{aligned}].\n$$" :question/worked-solution "First, we need to convert $B$ to row echelon form:\n\n$$\n\\begin{aligned}B & =[\\begin{aligned}1 & 0 & 0 & -1 & 0 \\\\ 3 & 0 & 2 & -1 & 1 \\\\ 0 & 0 & -4 & 0 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & -1 & 0 \\\\ 0 & 0 & 2 & 2 & 1 \\\\ 0 & 0 & -4 & 0 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & -1 & 0 \\\\ 0 & 0 & 2 & 2 & 1 \\\\ 0 & 0 & 0 & 4 & 2\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $A$ has $3$ pivots, and therefore the number of pivot columns is $3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-130957/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1073953e-7e0a-5237-8533-8882b7772741"] :knowledge-point/questions ["q-130957"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73633/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "2a2ba2ff-f470-5a86-aa91-3179ad5f92eb" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-73633/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "a6bf3f5b-a97c-53a9-8760-caafc2b1de58" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-73633/sel