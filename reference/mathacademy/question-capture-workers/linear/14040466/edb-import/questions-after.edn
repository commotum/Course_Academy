er/id #uuid "a6bf3f5b-a97c-53a9-8760-caafc2b1de58" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186308441} {:answer/id #uuid "1f26d271-3e68-5d25-86f7-b5c266e2866e" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186308442} {:answer/id #uuid "2a2ba2ff-f470-5a86-aa91-3179ad5f92eb" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186308443}] :answer-field/correct {:answer/id #uuid "e73b3234-7e65-5e85-b867-90964e4a8c58" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186308439} :answer-field/id #uuid "9e339137-bb03-530d-aac5-f8c722aa34ae" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186308438}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b99c3465-f707-5e73-a0e6-910372a6c00a" :question/math-academy-id "q-73633" :question/problem "Determine the number of pivot columns of the matrix $P,$ given by\n\n$$\nP=[\\begin{aligned}0 & 3 & 2 & -1 & 0 \\\\ 0 & 0 & 6 & 1 & 3 \\\\ 0 & -6 & -4 & 9 & 1 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}].\n$$" :question/worked-solution "First, we need to convert $P$ to row echelon form:\n\n$$\n\\begin{aligned}P & =[\\begin{aligned}0 & 3 & 2 & -1 & 0 \\\\ 0 & 0 & 6 & 1 & 3 \\\\ 0 & -6 & -4 & 9 & 1 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼[\\begin{aligned}0 & 3 & 2 & -1 & 0 \\\\ 0 & 0 & 6 & 1 & 3 \\\\ 0 & 0 & 0 & 7 & 1 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $P$ has $3$ pivots, and therefore the number of pivot columns is $3.$"}] [{:db/id #edb/ref 17592186308444 :knowledge-point/_questions [{:knowledge-point/id #uuid "b1a557d6-52f3-5df3-8088-5b875296e72e" :knowledge-point/title "Finding the Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8994bccd-6d52-57c1-92b8-07767033862a" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st, $2$nd, $3$rd, $5$th, and $6$th only" :db/id #edb/ref 17592186308446} {:answer/id #uuid "2aaac75f-1f8e-5164-af40-e26c891ddf01" :answer/type {:db/ident :answer.type/text} :answer/value "$2$nd, $3$rd, $5$th, and $6$th only" :db/id #edb/ref 17592186308447} {:answer/id #uuid "9a6854e2-1d02-5f7c-8a64-a4d6a08626c3" :answer/type {:db/ident :answer.type/text} :answer/value "$2$nd, $3$rd, and $6$th only" :db/id #edb/ref 17592186308448} {:answer/id #uuid "adfdbd7d-dc98-5b98-947c-8fa72fd49648" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st and $6$th only" :db/id #edb/ref 17592186308449} {:answer/id #uuid "4e370edd-bf0a-5c8c-bfa7-174eccfbf0d0" :answer/type {:db/ident :answer.type/text} :answer/value "$2$nd only" :db/id #edb/ref 17592186308450}] :answer-field/correct {:answer/id #uuid "2aaac75f-1f8e-5164-af40-e26c891ddf01" :answer/type {:db/ident :answer.type/text} :answer/value "$2$nd, $3$rd, $5$th, and $6$th only" :db/id #edb/ref 17592186308447} :answer-field/id #uuid "2b9f91e3-60cd-5372-a09a-1178154a4263" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186308445}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "f2052ae3-18ce-5501-8a06-ca8f9c529ebd" :question/math-academy-id "q-73639" :question/problem "What are the pivot columns of the matrix $P,$ given by\n\n$$\nP=[\\begin{aligned}0 & 1 & 0 & 2 & 0 & 3 \\\\ 0 & 0 & 3 & 0 & 6 & 0 \\\\ 0 & 0 & -6 & 0 & -4 & -1 \\\\ 0 & 0 & 0 & 0 & -8 & 0\\end{aligned}]?\n$$" :question/worked-solution "First, we need to convert $P$ to row echelon form:\n\n$$\n\\begin{aligned}P & =[\\begin{aligned}0 & 1 & 0 & 2 & 0 & 3 \\\\ 0 & 0 & 3 & 0 & 6 & 0 \\\\ 0 & 0 & -6 & 0 & -4 & -1 \\\\ 0 & 0 & 0 & 0 & -8 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\  & ∼[\\begin{aligned}0 & 1 & 0 & 2 & 0 & 3 \\\\ 0 & 0 & 3 & 0 & 6 & 0 \\\\ 0 & 0 & 0 & 0 & 8 & -1 \\\\ 0 & 0 & 0 & 0 & -8 & 0\\end{aligned}] & {R}_{4} & :={R}_{4}+{R}_{3} \\\\  & ∼[\\begin{aligned}0 & 1 & 0 & 2 & 0 & 3 \\\\ 0 & 0 & 3 & 0 & 6 & 0 \\\\ 0 & 0 & 0 & 0 & 8 & -1 \\\\ 0 & 0 & 0 & 0 & 0 & -1\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $P$ has $4$ pivots. In particular, the pivot columns are the $2$nd, $3$rd, $5$th and $6$th columns."}]}
