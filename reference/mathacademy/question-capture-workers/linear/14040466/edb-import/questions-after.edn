-point/title "Finding the Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "edf31528-154d-5036-a970-e4ca91cb017f" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st and $3$rd only" :db/id #edb/ref 17592186121949} {:answer/id #uuid "f4bff001-041e-5115-9b97-148bb00b96ff" :answer/type {:db/ident :answer.type/text} :answer/value "$4$th only" :db/id #edb/ref 17592186121950} {:answer/id #uuid "fbf6f178-c842-59d9-8c1b-5ab20341815e" :answer/type {:db/ident :answer.type/text} :answer/value "$3$rd and $4$th only" :db/id #edb/ref 17592186121951} {:answer/id #uuid "16e1a635-5c19-5397-afa3-0e47de57ad39" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st, $2$nd, and $4$th only" :db/id #edb/ref 17592186121952} {:answer/id #uuid "4bbdc26f-36ff-5592-8fb6-fa05dd41633b" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st, $2$nd, $3$rd, and $4$th" :db/id #edb/ref 17592186121953}] :answer-field/correct {:answer/id #uuid "16e1a635-5c19-5397-afa3-0e47de57ad39" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st, $2$nd, and $4$th only" :db/id #edb/ref 17592186121952} :answer-field/id #uuid "2007f835-e416-5901-a4d8-dcb889a38634" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121948}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "c93d2ae4-7e7b-5500-9b27-fd939892ffa9" :question/math-academy-id "q-35732" :question/problem "What are the pivot columns of the matrix $A,$ given by\n\n$$\nA=[\\begin{aligned}0 & 0 & 0 & 0 \\\\ 0 & 4 & 8 & -6 \\\\ 0 & -2 & -4 & 1 \\\\ 1 & 4 & 0 & 2\\end{aligned}]?\n$$" :question/worked-solution "First, we need to convert $A$ to row echelon form:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}0 & 0 & 0 & 0 \\\\ 0 & 4 & 8 & -6 \\\\ 0 & -2 & -4 & 1 \\\\ 1 & 4 & 0 & 2\\end{aligned}] & {R}_{1} & ↔{R}_{4} \\\\  & ∼[\\begin{aligned}1 & 4 & 0 & 2 \\\\ 0 & 4 & 8 & -6 \\\\ 0 & -2 & -4 & 1 \\\\ 0 & 0 & 0 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+\\frac{1}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 4 & 0 & 2 \\\\ 0 & 4 & 8 & -6 \\\\ 0 & 0 & 0 & -2 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $A$ has $3$ pivots. In particular, the pivot columns are the $1$st, $2$nd, and $4$th columns."}] [{:db/id #edb/ref 17592186124822 :knowledge-point/_questions [{:knowledge-point/id #uuid "b1a557d6-52f3-5df3-8088-5b875296e72e" :knowledge-point/title "Finding the Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0bf2bc9-1f22-50e0-bad3-8c88e0d6c5c3" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st and $2$nd only" :db/id #edb/ref 17592186121955} {:answer/id #uuid "f35fb03b-66a2-5529-b446-1860ebeb3dd4" :answer/type {:db/ident :answer.type/text} :answer/value "$4$th only" :db/id #edb/ref 17592186121956} {:answer/id #uuid "30d05f80-d0f3-5198-a48f-1697b461fcd9" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st, $2$nd, and $3$rd only" :db/id #edb/ref 17592186121957} {:answer/id #uuid "3f71f17c-bdfe-5b20-89c1-399b16b4b8b3" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st and $3$rd only" :db/id #edb/ref 17592186121958} {:answer/id #uuid "5d993d5f-8afb-5fdc-bd10-e730b38fe806" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st, $2$nd, $3$rd, and $4$th" :db/id #edb/ref 17592186121959}] :answer-field/correct {:answer/id #uuid "30d05f80-d0f3-5198-a48f-1697b461fcd9" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st, $2$nd, and $3$rd only" :db/id #edb/ref 17592186121957} :answer-field/id #uuid "f08a9924-6ff7-54f3-a8a1-492257bdc75e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121954}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "bdb5ab47-cea8-5da9-89b4-45a9046d7661" :question/math-academy-id "q-35734" :question/problem "What are the pivot columns of the matrix $P,$ given by\n\n$$\nP=[\\begin{aligned}1 & 4 & 0 & 2 \\\\ 0 & -2 & -4 & 2 \\\\ 0 & 4 & 9 & -6 \\\\ 0 & 0 & 2 & -4\\end{aligned}]?\n$$" :question/worked-solution "First, we need to convert $P$ to row echelon form:\n\n$$\n\\begin{aligned}P & =[\\begin{aligned}1 & 4 & 0 & 2 \\\\ 0 & -2 & -4 & 2 \\\\ 0 & 4 & 9 & -6 \\\\ 0 & 0 & 2 & -4\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 4 & 0 & 2 \\\\ 0 & -2 & -4 & 2 \\\\ 0 & 0 & 1 & -2 \\\\ 0 & 0 & 2 & -4\\end{aligned}] & {R}_{4} & :={R}_{4}+(-2){R}_{3} \\\\  & ∼[\\begin{aligned}1 & 4 & 0 & 2 \\\\ 0 & -2 & -4 & 2 \\\\ 0 & 0 & 1 & -2 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $B$ has $3$ pivots. In particular, the pivot columns are the $1$st, $2$nd, and $3$rd columns."}] [{:db/id #edb/ref 17592186124825 :knowledge-point/_questions [{:knowledge-point/id #uuid "488c9762-554b-5ea6-b414-ce6cbde9bbd1" :knowledge-point/title "Finding the Pivot Columns of a Matrix in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "887ec085-34cb-52aa-aacc-c0ddf185c6f9" :answer/type {:db/ident :answer.type/text} :answer/value "$2$nd and $3$rd only" :db/id #edb/ref 17592186121973} {:answer/id #uuid "e01ebc24-fbc4-56ad-8f18-4e5dd120f3cf" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st and $2$nd only" :db/id #edb/ref 17592186121974} {:answer/id #uuid "06ceb37d-5c1b-5992-a611-c197eb20c483" :answer/type {:db/ident :answer.type/text} :answer/value "$3$rd only" :db/id #edb/ref 17592186121975} {:answer/id #uuid "6c4e9d6d-2654-50b7-a49f-99421d6bfa91" :answer/type {:db/ident :answer.type/text} :answer/value "$2$nd only" :db/id #edb/ref 17592186121976} {:answer/id #uuid "7a3bbcb6-bb51-5ebd-898c-a43083d2372a" :answer/type {:db/ident :answer.type/text} :answer/value "All the columns are pivot" :db/id #edb/ref 175921861219