#{[{:db/id #edb/ref 17592186359376 :knowledge-point/_questions [{:knowledge-point/id #uuid "b1a557d6-52f3-5df3-8088-5b875296e72e" :knowledge-point/title "Finding the Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2614b676-1411-5349-b67c-ad2e418d8c1c" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st and $3$rd only" :db/id #edb/ref 17592186359378} {:answer/id #uuid "481396e7-cd30-53f6-b71a-f4e77ee3baee" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st and $4$th only" :db/id #edb/ref 17592186359379} {:answer/id #uuid "ebb06ab6-2663-58fa-b830-5bce35cfc996" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st, $2$nd, and $5$th only" :db/id #edb/ref 17592186359380} {:answer/id #uuid "967c13fa-fb2f-5f90-ac52-c0d96c0341b6" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st, $3$rd, and $5$th only" :db/id #edb/ref 17592186359381} {:answer/id #uuid "7c0bd7e9-20bf-5e91-bb5c-b798ded199a1" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st, $2$nd, and $3$rd only" :db/id #edb/ref 17592186359382}] :answer-field/correct {:answer/id #uuid "967c13fa-fb2f-5f90-ac52-c0d96c0341b6" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st, $3$rd, and $5$th only" :db/id #edb/ref 17592186359381} :answer-field/id #uuid "b6d371bc-af36-599d-a4f3-efc3a264424d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186359377}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "bda4e9f8-a309-57e6-9102-6eee50022912" :question/math-academy-id "q-131305" :question/problem "What are the pivot columns of the matrix $P,$ given by\n\n$$\nP=[\\begin{aligned}-2 & 0 & 1 & 0 & -1 \\\\ 2 & 0 & 1 & 1 & 1 \\\\ 0 & 0 & 0 & 0 & 4 \\\\ 4 & 0 & -2 & 0 & 2\\end{aligned}]?\n$$" :question/worked-solution "First, we need to convert $P$ to row echelon form:\n\n$$\n\\begin{aligned}P & =[\\begin{aligned}-2 & 0 & 1 & 0 & -1 \\\\ 2 & 0 & 1 & 1 & 1 \\\\ 0 & 0 & 0 & 0 & 4 \\\\ 4 & 0 & -2 & 0 & 2\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}-2 & 0 & 1 & 0 & -1 \\\\ 0 & 0 & 2 & 1 & 0 \\\\ 0 & 0 & 0 & 0 & 4 \\\\ 4 & 0 & -2 & 0 & 2\\end{aligned}] & {R}_{4} & :={R}_{4}+2{R}_{1} \\\\  & ∼[\\begin{aligned}-2 & 0 & 1 & 0 & -1 \\\\ 0 & 0 & 2 & 1 & 0 \\\\ 0 & 0 & 0 & 0 & 4 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $P$ has $3$ pivots. In particular, the pivot columns are the $1$st, $3$rd, and $5$th columns."}] [{:db/id #edb/ref 17592186359383 :knowledge-point/_questions [{:knowledge-point/id #uuid "a5f0d2e9-1cf6-5fe4-85cc-f401382f39b2" :knowledge-point/title "Finding the Non-Pivot Columns of a Matrix in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4c8ef2e-e119-5e2d-8522-85bd9f0ba9ac" :answer/type {:db/ident :answer.type/text} :answer/value "$3$rd only" :db/id #edb/ref 17592186359385} {:answer/id #uuid "d431ca1a-937a-57c0-a2eb-db0138b305ed" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st and $3$rd only" :db/id #edb/ref 17592186359386} {:answer/id #uuid "4551a6ba-efa2-54e6-ba97-251df1ce4001" :answer/type {:db/ident :answer.type/text} :answer/value "$2$nd and $3$rd only" :db/id #edb/ref 17592186359387} {:answer/id #uuid "8b57fe95-51a5-52a0-aa57-a155f291074c" :answer/type {:db/ident :answer.type/text} :answer/value "All the columns are non-pivot" :db/id #edb/ref 17592186359388} {:answer/id #uuid "0da7b023-f6ef-5f2c-a539-2960a477d8ea" :answer/type {:db/ident :answer.type/text} :answer/value "$2$nd only" :db/id #edb/ref 17592186359389}] :answer-field/correct {:answer/id #uuid "d4c8ef2e-e119-5e2d-8522-85bd9f0ba9ac" :answer/type {:db/ident :answer.type/text} :answer/value "$3$rd only" :db/id #edb/ref 17592186359385} :answer-field/id #uuid "a9bf6c1d-5bd4-5b63-9816-11116ed4df42" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186359384}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "882ebb4d-35c9-5b5b-8139-3566e490f853" :question/math-academy-id "q-73616" :question/problem "The row echelon form matrix $P$ is given below. What are its **non**-pivot columns?\n\n$$\nP=[\\begin{aligned}-3 & 1 & -1 \\\\ 0 & 1 & 6 \\\\ 0 & 0 & 0\\end{aligned}]\n$$" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $P$ has $2$ pivots in the $1$st and $2$nd columns:\n\n$$\nP=[\\begin{aligned}-3 & 1 & -1 \\\\ 0 & 1 & 6 \\\\ 0 & 0 & 0\\end{aligned}]\n$$\n\nTherefore, the only non-pivot column is the $3$rd column."}] [{:db/id #edb/ref 17592186359390 :knowledge-point/_questions [{:knowledge-point/id #uuid "a5f0d2e9-1cf6-5fe4-85cc-f401382f39b2" :knowledge-point/title "Finding the Non-Pivot Columns of a Matrix in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a3b6a13-89fc-5246-ad52-91689caef6ae" :answer/type {:db/ident :answer.type/text} :answer/value "$3$rd only" :db/id #edb/ref 17592186359392} {:answer/id #uuid "cbd3379c-627c-5fe8-a9bc-64681edca56d" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st and $3$rd only" :db/id #edb/ref 17592186359393} {:answer/id #uuid "db61865c-e5a6-55d8-abb3-da6cc826ff80" :answer/type {:db/ident :answer.type/text} :answer/value "All the columns are non-pivot" :db/id #edb/ref 17592186359394} {:answer/id #uuid "971b5041-bf81-5d8b-82e5-cd01e6095b84" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st, $2$nd, and $3$rd only" :db/id #edb/ref 17592186359395} {:answer/id #uuid "ee3377af-2db8-57d2-9950-417933a91523" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st only" :db/id #edb/ref 17592186359396}] :answer-field/correct {:answer/id #uuid "cbd3379c-627c-5fe8-a9bc-64681edca56d" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st and $3$rd only" :db/id #edb/ref 17592186359393} :answer-field/id #uuid "098f00ec-d913-5277-ab4d-a19e9311dd4a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186359391}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f3d5d0a1-2ec7-52b7-9b8a-9175a7a56b24" :question/math-academy-id "q-73618" :question/problem "The row echelon form matrix $P$ is given below. What are its **non**-pivot columns?\n\n$$\nP=[\\begin{aligned}0 & 6 & -1 & 1 & 8 \\\\ 0 & 0 & 0 & 2 & 4 \\\\ 0 & 0 & 0 & 0 & -3 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}]\n$$" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $P$ has $3$ pivots in the $2$nd, $4$th and $5$th columns:\n\n$$\nP=[\\begin{aligned}0 & 6 & -1 & 1 & 8 \\\\ 0 & 0 & 0 & 2 & 4 \\\\ 0 & 0 & 0 & 0 & -3 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}]\n$$\n\nTherefore, the only non-pivot columns are the $1$st and $3$rd column."}] [{:db/id #edb/ref 17592186359397 :knowledge-point/_questions [{:knowledge-point/id #uuid "1073953e-7e0a-5237-8533-8882b7772741" :knowledge-point/title "Finding the Number of Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "227aeb01-7576-5988-8365-f40a9304ba68" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186359399} {:answer/id #uuid "a3e7f9eb-3b53-588f-8c88-be7f42c2bc45" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186359400} {:answer/id #uuid "fcb837c3-046b-517d-98c3-0865ba4bc9ba" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186359401} {:answer/id #uuid "ad6d9c7d-d204-52a1-8e2c-5cf2b3463418" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186359402} {:answer/id #uuid "457f0cec-973c-5319-8592-45ab386e6d6c" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186359403}] :answer-field/correct {:answer/id #uuid "ad6d9c7d-d204-52a1-8e2c-5cf2b3463418" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186359402} :answer-field/id #uuid "1fa9e96b-e9e7-5cbf-8061-340be902e16c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186359398}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5379ff5b-aa7b-5101-b00c-57cefefb7a11" :question/math-academy-id "q-73630" :question/problem "Determine the number of pivot columns of the matrix $C,$ given by\n\n$$\nC=[\\begin{aligned}1 & 2 & -1 & 1 & 4 \\\\ 0 & 0 & 8 & 0 & -2 \\\\ 0 & 0 & -4 & 1 & 0 \\\\ 0 & 0 & 0 & 0 & -1\\end{aligned}].\n$$" :question/worked-solution "First, we need to convert $C$ to row echelon form:\n\n$$\n\\begin{aligned}C & =[\\begin{aligned}1 & 2 & -1 & 1 & 4 \\\\ 0 & 0 & 8 & 0 & -2 \\\\ 0 & 0 & -4 & 1 & 0 \\\\ 0 & 0 & 0 & 0 & -1\\end{aligned}] & {R}_{3} & :={R}_{3}+\\frac{1}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 2 & -1 & 1 & 4 \\\\ 0 & 0 & 8 & 0 & -2 \\\\ 0 & 0 & 0 & 1 & -1 \\\\ 0 & 0 & 0 & 0 & -1\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $C$ has $4$ pivots, and therefore the number of pivot columns is $4.$"}] [{:db/id #edb/ref 17592186359404 :knowledge-point/_questions [{:knowledge-point/id #uuid "1073953e-7e0a-5237-8533-8882b7772741" :knowledge-point/title "Finding the Number of Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2148c76e-dd32-59ae-8964-b30ccbd38962" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186359406} {:answer/id #uuid "1c8fcb72-0ebe-55e4-a052-890aaf989dd5" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186359407} {:answer/id #uuid "a7e8bdc1-bdd4-52ed-a9a9-0c4f928618d6" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186359408} {:answer/id #uuid "56893b66-b5f7-5db9-bdca-964d54ea2e44" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186359409} {:answer/id #uuid "f7a3ae14-2385-52e5-8383-5227c81d74a2" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186359410}] :answer-field/correct {:answer/id #uuid "56893b66-b5f7-5db9-bdca-964d54ea2e44" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186359409} :answer-field/id #uuid "e690f891-3bc2-5164-9484-63a3aafe6680" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186359405}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "15ecd7d2-4790-561d-9b1e-e7cfe93f4e98" :question/math-academy-id "q-73635" :question/problem "Determine the number of pivot columns of the matrix $Q,$ given by\n\n$$\nQ=[\\begin{aligned}-2 & 1 & 1 & 0 & 3 \\\\ 0 & 2 & -1 & 1 & 4 \\\\ 0 & 0 & 0 & 8 & -12 \\\\ 0 & 0 & 0 & -2 & 1 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}].\n$$" :question/worked-solution "First, we need to convert $Q$ to row echelon form:\n\n$$\n\\begin{aligned}Q & =[\\begin{aligned}-2 & 1 & 1 & 0 & 3 \\\\ 0 & 2 & -1 & 1 & 4 \\\\ 0 & 0 & 0 & 8 & -12 \\\\ 0 & 0 & 0 & -2 & 1 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}] & {R}_{4} & :={R}_{4}+\\frac{1}{4}{R}_{3} \\\\  & ∼[\\begin{aligned}-2 & 1 & 1 & 0 & 3 \\\\ 0 & 2 & -1 & 1 & 4 \\\\ 0 & 0 & 0 & 8 & -12 \\\\ 0 & 0 & 0 & 0 & -2 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $Q$ has $4$ pivots, and therefore the number of pivot columns is $4.$"}]}
