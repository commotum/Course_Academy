d}\n$$\n\nLooking at the row echelon form, we see that $P$ has $3$ pivots. In particular, the pivot columns are the $1$st, $3$rd, and $5$th columns." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069124/state.json" "file_sha256" "ab8e0dc41d40895a19b76b2ff951816aedebfc36a321b4805203642cc3613170"} {"question" "q-131305" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069124/activity-metadata.json" "file_sha256" "4e0e1999bca372ed2125e853746557d3d12e0b2b1ff1de845e59ea5266418531"} {"question" "q-131305" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069124/state.json" "file_sha256" "ab8e0dc41d40895a19b76b2ff951816aedebfc36a321b4805203642cc3613170"} {"question" "q-131305" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "$1$st and $3$rd only"] ["text" "$1$st and $4$th only"] ["text" "$1$st, $2$nd, and $3$rd only"] ["text" "$1$st, $2$nd, and $5$th only"] ["text" "$1$st, $3$rd, and $5$th only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069124/state.json" "file_sha256" "ab8e0dc41d40895a19b76b2ff951816aedebfc36a321b4805203642cc3613170"} {"question" "q-131305" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "$1$st, $3$rd, and $5$th only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069124/state.json" "file_sha256" "ab8e0dc41d40895a19b76b2ff951816aedebfc36a321b4805203642cc3613170"}] "usage" {} "basis" 2342 "retractions" [] "immutable_answers" [] "immutable_