/multivariable/14037313/state.json" "file_sha256" "5018c91201e1bff8d42af9bd410b499f0a7ab693d9aeb8d3c0c9f2d1dbc19bf6" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"} {"question" "q-114309" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "-\\frac{3(x+4)\\operatorname{cos}⁡(2x)}{2}+\\frac{\\operatorname{sin}⁡(2x)}{6}+C"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "5018c91201e1bff8d42af9bd410b499f0a7ab693d9aeb8d3c0c9f2d1dbc19bf6" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"}] "sources" [{"question" "q-12564" "field" nil "attribute" "question/problem" "value" "$\\int (x+3)\\operatorname{cos}⁡(3x)\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066164/state.json" "file_sha256" "2d4619dd198dfb831904095335f6aa2323d9b1602d82c2fe7312d8145fa02723"} {"question" "q-12564" "field" nil "attribute" "question/worked-solution" "value" "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int (x+3)\\operatorname{cos}⁡(3x)\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=x+3\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′}=\\operatorname{cos}⁡(3x)\\, & ⟹\\,v=\\frac{\\operatorname{sin}⁡(3x)}{3}.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int (x+3)\\cdot \\operatorname{cos}⁡(3x)\\,\\text{d}x & =(x+3)\\cdot \\frac{\\operatorname{sin}⁡(3x)}{3}-\\int \\frac{\\operatorname{sin}⁡(3x)}{3}\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int (x+3)\\operatorname{cos}⁡(3x)\\text{d}x & =\\frac{(x+3)\\operatorname{sin}⁡(3x)}{3}-\\frac{1}{3}\\int \\operatorname{sin}⁡(3x)\\,\\text{d}x \\\\  & =\\frac{(x+3)\\operatorname{sin}⁡(3x)}{3}+\\frac{\\operatorname{cos}⁡(3x)}{9}+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066164/state.json" "file_sha256" "2d4619dd198dfb831904095335f6aa2323d9b1602d82c2fe7312d8145fa02723"} {"question" "q-12564" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066164/activity-metadata.json" "file_sha256" "ad8c3061cbd59a5d8bf04123ae3dd3db769a79cff020848cd2414db419d1aef5"} {"question" "q-12564" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066164/state.json" "file_sha256" "2d4619dd198dfb831904095335f6aa2323d9b1602d82c2fe7312d8145fa02723"} {"question" "q-12564" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{\\operatorname{sin}⁡(3x)}{3}+\\frac{x\\operatorname{cos}⁡(3x)}{9}+C"] ["math" "\\frac{(x+3)\\operatorname{sin}⁡(3x)}{3}+\\frac{\\operatorname{cos}⁡(3x)}{9}+C"] ["math" "\\frac{(x+3)\\operatorname{sin}⁡(3x)}{3}-\\frac{x\\operatorname{cos}⁡(3x)}{3}+C"] ["math" "\\frac{(x+3)\\operatorname{sin}⁡(3x)}{9}+\\frac{\\operatorname{cos}⁡(3x)}{3}+C"] ["math" "\\frac{x\\operatorname{sin}⁡(3x)}{9}+\\frac{\\operatorname{cos}⁡(3x)}{3}+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066164/state.json" "file_sha256" "2d4619dd198dfb831904095335f6aa2323d9b1602d82c2fe7312d8145fa02723"} {"question" "q-12564" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{(x+3)\\operatorname{sin}⁡(3x)}{3}+\\frac{\\operatorname{cos}⁡(3x)}{9}+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066164/state.json" "file_sha256" "2d4619dd198dfb831904095335f6aa2323d9b1602d82c2fe7312d8145fa02723"} {"question" "q-14453" "field" nil "attribute" "question/problem" "value" "$\\int 6x\\operatorname{cos}⁡(x)\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066164/state.json" "file_sha256" "2d4619dd198dfb831904095335f6aa2323d9b1602d82c2fe7312d8145fa02723"} {"question" "q-14453" "field" nil "attribute" "question/worked-solution" "value" "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int 6x\\operatorname{cos}⁡(x)\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=6x\\, & ⟹\\,{u}^{′}=6 \\\\ {v}^{′}=\\operatorname{cos}⁡(x)\\, & ⟹\\,v=\\operatorname{sin}⁡(x).\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 6x\\cdot \\operatorname{cos}⁡(x)\\,\\text{d}x & =6x\\cdot \\operatorname{sin}⁡(x)-\\int \\operatorname{sin}⁡(x)\\cdot 6\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int 6x\\operatorname{cos}⁡(x)\\,\\text{d}x & =6x\\operatorname{sin}⁡(x)-6\\int \\operatorname{sin}⁡(x)\\,\\text{d}x \\\\  & =6x\\operatorname{sin}⁡(x)-6(-\\operatorname{cos}⁡(x))+C \\\\  & =6x\\operatorname{sin}⁡(x)+6\\operatorname{cos}⁡(x)+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066164/state.json" "file_sha256" "2d4619dd198dfb831904095335f6aa2323d9b1602d82c2fe7312d8145fa02723"} {"question" "q-14453" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066164/activity-metadata.json" "file_sha256" "ad8c3061cbd59a5d8bf04123ae3dd3db769a79cff020848cd2414db419d1aef5"} {"question" "q-14453" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066164/state.json" "file_sha256" "2d4619dd198dfb831904095335f6aa2323d9b1602d82c2fe7312d8145fa02723"} {"question" "q-14453" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-6x\\operatorname{cos}⁡x-\\operatorname{cos}⁡x+C"] ["math" "-6x\\operatorname{sin}⁡x+6\\operatorname{cos}⁡x+C"] ["math" "6x\\operatorname{sin}⁡x+6\\operatorname{cos}⁡x+C"] ["math" "x\\operatorname{cos}⁡6x+x\\operatorname{sin}⁡6x+C"] ["math" "x\\operatorname{cos}⁡6x-x\\operatorname{sin}⁡6x+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066164/state.json" "file_sha256" "2d4619dd198dfb831904095335f6aa2323d9b1602d82c2fe7312d8145fa02723"} {"question" "q-14453" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "6x\\operatorname{sin}⁡x+6\\operatorname{cos}⁡x+C"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066164/state.json" "file_sha256" "2d4619dd198dfb831904095335f6aa2323d9b1602d82c2fe7312d8145fa02723"} {"question" "q-49660" "field" nil "attribute" "question/problem" "value" "Evaluate ${\\int }_{-2}^{0}x{e}^{-x}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066164/state.json" "file_sha256" "2d4619dd198dfb831904095335f6aa2323d9b1602d82c2fe7312d8145fa02723"} {"question" "q-49660" "field" nil "attribute" "question/worked-solution" "value" "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=x & ⇒ & {u}^{′}=1 \\\\ {v}^{′}={e}^{-x} & ⇒ & v=-{e}^{-x}.\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot {e}^{-x}\\,\\text{d}x & =x\\cdot (-{e}^{-x})-\\int (-{e}^{-x})\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{-2}^{0}x{e}^{-x}\\,\\text{d}x & =-x{e}^{-x}{|}_{-2}^{0}+{\\int }_{-2}^{0}{e}^{-x}\\,\\text{d}x \\\\  & =-x{e}^{-x}{|}_{-2}^{0}-{e}^{-x}{|}_{-2}^{0} \\\\  & =[-0{e}^{-0}-2{e}^{2}]-[{e}^{0}-{e}^{2}] \\\\  & =-2{e}^{2}-1+{e}^{2} \\\\  & =-1-{e}^{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066164/state.json" "file_sha256" "2d4619dd198dfb831904095335f6aa2323d9b1602d82c2fe7312d8145fa02723"} {"question" "q-49660" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066164/activity-metadata.json" "file_sha256" "ad8c3061cbd59a5d8bf04123ae3dd3db769a79cff020848cd2414db419d1aef5"} {"question" "q-49660" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066164/state.json" "file_sha256" "2d4619dd198dfb831904095335f6aa2323d9b1602d82c2fe7312d8145fa02723"} {"question" "q-49660" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1+{e}^{2}"] ["math" "-1-{e}^{2}"] ["math" "-2-{e}^{2}"] ["math" "1+{e}^{2}"] ["math" "1-3{e}^{2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066164/state.json" "file_sha256" "2d4619dd198dfb831904095335f6aa2323d9b1602d82c2fe7312d8145fa02723"} {"question" "q-49660" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-1-{e}^{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066164/state.json" "file_sha256" "2d4619dd198dfb831904095335f6aa2323d9b1602d82c2fe7312d8145fa02723"} {"question" "q-114309" "field" nil "attribute" "question/problem" "value" "$\\int (x+4)\\operatorname{sin}⁡(2x)\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066164/state.json" "file_sha256" "2d4619dd198dfb831904095335f6aa2323d9b1602d82c2fe7312d8145fa02723"} {"question" "q-114309" "field" nil "attribute" "question/worked-solution" "value" "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int (x+4)\\operatorname{sin}⁡(2x)\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=x+4\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′}=\\operatorname{sin}⁡(2x)\\, & ⟹\\,v=-\\frac{\\operatorname{cos}⁡(2x)}{2}.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int (x+4)\\cdot \\operatorname{sin}⁡(2x)\\,\\text{d}x & =(x+4)\\cdot (-\\frac{\\operatorname{cos}⁡(2x)}{2})-\\int (-\\frac{\\operatorname{cos}⁡(2x)}{2})\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int (x+4)\\operatorname{sin}⁡(2x)\\text{d}x & =-\\frac{(x+4)\\operatorname{cos}⁡(2x)}{2}+\\frac{1}{2}\\int \\operatorname{cos}⁡(2x)\\,\\text{d}x \\\\  & =-\\frac{(x+4)\\operatorname{cos}⁡(2x)}{2}+\\frac{\\operatorname{sin}⁡(2x)}{4}+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066164/state.json" "file_sha256" "2d4619dd198dfb831904095335f6aa2323d9b1602d82c2fe7312d8145fa02723"} {"question" "q-114309" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066164/activity-metadata.json" "file_sha256" "ad8c3061cbd59a5d8bf04123ae3dd3db769a79cff020848cd2414db419d1aef5"} {"question" "q-114309" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066164/state.json" "file_sha256" "2d4619dd198dfb831904095335f6aa2323d9b1602d82c2fe7312d8145fa02723"} {"question" "q-114309" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{(x+4)\\operatorname{cos}⁡(2x)}{2}+\\frac{\\operatorname{sin}⁡(2x)}{4}+C"] ["math" "-\\frac{(x+4)\\operatorname{cos}⁡(2x)}{4}+\\frac{\\operatorname{sin}⁡(2x)}{8}+C"] ["math" "-\\frac{(x+4)\\operatorname{cos}⁡(2x)}{4}-\\frac{\\operatorname{sin}⁡(2x)}{2}+C"] ["math" "-\\frac{(x+4)\\operatorname{cos}⁡(2x)}{6}-\\frac{\\operatorname{sin}⁡(2x)}{2}+C"] ["math" "-\\frac{3(x+4)\\operatorname{cos}⁡(2x)}{2}+\\frac{\\operatorname{sin}⁡(2x)}{6}+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066164/state.json" "file_sha256" "2d4619dd198dfb831904095335f6aa2323d9b1602d82c2fe7312d8145fa02723"} {"question" "q-114309" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{(x+4)\\operatorname{cos}⁡(2x)}{2}+\\frac{\\operatorname{sin}⁡(2x)}{4}+C"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066164/state.json" "file_sha256" "2d4619dd198dfb831904095335f6aa2323d9b1602d82c2fe7312d8145fa02723"} {"question" "q-349217" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{2}3x{e}^{2x}\\,\\text{d}x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066164/state.json" "file_sha256" "2d4619dd198dfb831904095335f6aa2323d9b1602d82c2fe7312d8145fa02723"} {"question" "q-349217" "field" nil "attribute" "question/worked-solution" "value" "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=3x & ⇒ & {u}^{′}=3 \\\\ {v}^{′}={e}^{2x} & ⇒ & v=\\frac{1}{2}{e}^{2x}.\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 3x\\cdot {e}^{2x}\\,\\text{d}x & =3x\\cdot \\frac{1}{2}{e}^{2x}-\\int \\frac{1}{2}{e}^{2x}\\cdot 3\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}3x{e}^{2x}\\,\\text{d}x & =\\frac{3}{2}x{e}^{2x}\\,{|}_{0}^{2}-\\frac{3}{2}{\\int }_{0}^{2}{e}^{2x}\\,\\text{d}x \\\\  & =\\frac{3}{2}x{e}^{2x}\\,{|}_{0}^{2}-\\frac{3}{4}{e}^{2x}\\,{|}_{0}^{2} \\\\  & =\\frac{3}{2}(2\\cdot {e}^{4}-0\\cdot {e}^{0})-\\frac{3}{4}({e}^{4}-{e}^{0}) \\\\  & =3{e}^{4}-\\frac{3}{4}({e}^{4}-1) \\\\  & =\\frac{9{e}^{4}+3}{4}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066164/state.json" "file_sha256" "2d4619dd198dfb831904095335f6aa2323d9b1602d82c2fe7312d8145fa02723"} {"question" "q-349217" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066164/activity-metadata.json" "file_sha256" "ad8c3061cbd59a5d8bf04123ae3dd3db769a79cff020848cd2414db419d1aef5"} {"question" "q-349217" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066164/state.json" "file_sha256" "2d4619dd198dfb831904095335f6aa2323d9b1602d82c2fe7312d8145fa02723"} {"question" "q-349217" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{9}{4}e^4+\\frac{3}{4}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066164/state.json" "file_sha256" "2d4619dd198dfb831904095335f6aa2323d9b1602d82c2fe7312d8145fa02723"}] "usage" {"q-114309" [] "q-12564" [] "q-49660" [] "q-14453" []} "basis" 2180 "retractions" [[17592186064399 :question/problem "What is $\\displaystyle \\int(x + 3)\\cos (3x)dx$?"] [17592186064399 :question/worked-solution "Take $u=x+3$ and $dv=\\cos(3x)\\,dx$. Then $du=dx$ and $v=\\sin(3x)/3$. Thus\n$$\\int(x+3)\\cos(3x)\\,dx=\\frac{(x+3)\\sin(3x)}3-\\frac13\\int\\sin(3x)\\,dx\n=\\frac{(x+3)\\sin(3x)}3+\\frac{\\cos(3x)}9+C.$$"]] "immutable_answers" [17592186061079 17592186061080 17592186061081 17592186061082 17592186061083 17592186289163 17592186289164 17592186289165 17592186289166 17592186289167 17592186289180 17592186289181 17592186289182 17592186289183 17592186289184 17592186296536 17592186296537 17592186296538 17592186296539 17592186296540] "immutable_fields" [[17592186061078 :answer-field/correct] [17592186061078 :answer-field/id] [17592186061078 :answer-field/key] [17592186061078 :answer-field/type] [17592186289162 