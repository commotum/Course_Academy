f1b0dc34ab10b0a2629954a3f45af33" "q-135394/selection/43c57c70bbc7d32e49727440cc408402f539a2aad268325f2791560c12bfde7f" "q-135394/selection/496e43c2438330ccaff5001365d0ed35deab4cb04cdd390c02d51043d8b39305" "q-135394/selection/89076fdd8f253739776c1c528a673ddb20fbcd0464cdbb1dd0e2100d353ba100"] :db/ensure [:answer-field/validate]} {:db/id "q-135394" :question/id #uuid "d16d4609-6b42-5a5b-a115-183074533c0d" :question/math-academy-id "q-135394" :question/problem "Find the inverse of the following matrix:\n\n$$\nA=[\\begin{aligned}1 & 0 & 0 & 0 \\\\ \\frac{2}{3} & 1 & 0 & 0 \\\\ 0 & 0 & 1 & 0 \\\\ -6 & 0 & 0 & 1\\end{aligned}]\n$$" :question/worked-solution "Notice that we're given a Frobenius matrix:\n\n- all entries on the main diagonal are ones\n\n- the matrix has only one column (the $1$st column) where some entries below the main diagonal are not zeros\n\n- all the other entries outside the main diagonal are zeros\n\nTo find the inverse of a Frobenius matrix, we simply take the non-zero entries outside the main diagonal with opposite signs. \n\nIn our case, we obtain\n\n$$\n\\begin{aligned}{A}^{-1}={[\\begin{aligned}1 & 0 & 0 & 0 \\\\ \\frac{2}{3} & 1 & 0 & 0 \\\\ 0 & 0 & 1 & 0 \\\\ -6 & 0 & 0 & 1\\end{aligned}]}^{-1}=[\\begin{aligned}1 & 0 & 0 & 0 \\\\ -\\frac{2}{3} & 1 & 0 & 0 \\\\ 0 & 0 & 1 & 0 \\\\ 6 & 0 & 0 & 1\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-135394/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "77673d0c-9f03-5915-b2ab-4a5d6cb2d94d"] :knowledge-point/questions ["q-135394"] :db/ensure [:knowledge-point/validate]}]
