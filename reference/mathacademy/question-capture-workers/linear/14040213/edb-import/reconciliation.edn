\\ 0 & 1 & 2\\end{aligned}]"] ["math" "M∼[\\begin{aligned}1 & \\frac{7}{2} & \\frac{3}{2} \\\\ 0 & 1 & 1\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/state.json" "file_sha256" "44e2ac4aacf233f7f2832d58c9693faa75f215fbfd742d362808537a18d78975"} {"question" "q-10329" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "M∼[\\begin{aligned}1 & \\frac{3}{2} & \\frac{7}{2} \\\\ 0 & 1 & 1\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/state.json" "file_sha256" "44e2ac4aacf233f7f2832d58c9693faa75f215fbfd742d362808537a18d78975"} {"question" "q-130912" "field" nil "attribute" "question/problem" "value" "Consider the system of linear equations\n\n$$\n{\\begin{aligned} & 3x+5y=-6 \\\\  & -6x-6y=10.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/state.json" "file_sha256" "44e2ac4aacf233f7f2832d58c9693faa75f215fbfd742d362808537a18d78975"} {"question" "q-130912" "field" nil "attribute" "question/worked-solution" "value" "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}3 & 5 & -6 \\\\ -6 & -6 & 10\\end{aligned}].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}3 & 5 & -6 \\\\ -6 & -6 & 10\\end{aligned}] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & \\frac{5}{3} & -2 \\\\ -6 & -6 & 10\\end{aligned}] & {R}_{2} & :={R}_{2}+6{R}_{1} \\\\  & ∼[\\begin{aligned}1 & \\frac{5}{3} & -2 \\\\ 0 & 4 & -2\\end{aligned}] & {R}_{2} & :=\\frac{1}{4}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & \\frac{5}{3} & -2 \\\\ 0 & 1 & -\\frac{1}{2}\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/state.json" "file_sha256" "44e2ac4aacf233f7f2832d58c9693faa75f215fbfd742d362808537a18d78975"} {"question" "q-130912" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/activity-metadata.json" "file_sha256" "dd27bde0e4244fdaa6cbf12d593d53d628b335d439e5ac5f092446d750ee8dfd"} {"question" "q-130912" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/state.json" "file_sha256" "44e2ac4aacf233f7f2832d58c9693faa75f215fbfd742d362808537a18d78975"} {"question" "q-130912" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "M∼[\\begin{aligned}1 & 3 & -2 \\\\ 0 & 1 & -2\\end{aligned}]"] ["math" "M∼[\\begin{aligned}1 & 5 & -2 \\\\ 0 & 1 & -1\\end{aligned}]"] ["math" "M∼[\\begin{aligned}1 & \\frac{5}{3} & -1 \\\\ 0 & 1 & \\frac{1}{2}\\end{aligned}]"] ["math" "M∼[\\begin{aligned}1 & \\frac{5}{3} & -2 \\\\ 0 & 1 & -\\frac{1}{2}\\end{aligned}]"] ["math" "M∼[\\begin{aligned}1 & \\frac{5}{3} & 2 \\\\ 0 & 1 & \\frac{1}{2}\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/state.json" "file_sha256" "44e2ac4aacf233f7f2832d58c9693faa75f215fbfd742d362808537a18d78975"} {"question" "q-130912" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "M∼[\\begin{aligned}1 & \\frac{5}{3} & -2 \\\\ 0 & 1 & -\\frac{1}{2}\\end{aligned}]"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/state.json" "file_sha256" "44e2ac4aacf233f7f2832d58c9693faa75f215fbfd742d362808537a18d78975"} {"question" "q-10522" "field" nil "attribute" "question/problem" "value" "Consider the system of linear equations\n\n$$\n{\\begin{aligned} & x-3y=-8 \\\\  & 2x+4y=4.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then solve the linear system." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/state.json" "file_sha256" "44e2ac4aacf233f7f2832d58c9693faa75f215fbfd742d362808537a18d78975"} {"question" "q-10522" "field" nil "attribute" "question/worked-solution" "value" "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}1 & -3 & -8 \\\\ 2 & 4 & 4\\end{aligned}].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & -3 & -8 \\\\ 2 & 4 & 4\\end{aligned}] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & -8 \\\\ 0 & 10 & 20\\end{aligned}] & {R}_{2} & :=\\frac{1}{10}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -3 & -8 \\\\ 0 & 1 & 2\\end{aligned}].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n{\\begin{aligned} & x-3y=-8 \\\\  & y=2,\\end{aligned}\n$$\n\nand we can apply back substitution. The final equation $y=2$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx-3(2)=-8\\,⇒\\,x=-2.\n$$\n\nTherefore, the solution is $x=-2$ and $y=2.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/state.json" "file_sha256" "44e2ac4aacf233f7f2832d58c9693faa75f215fbfd742d362808537a18d78975"} {"question" "q-10522" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/activity-metadata.json" "file_sha256" "dd27bde0e4244fdaa6cbf12d593d53d628b335d439e5ac5f092446d750ee8dfd"} {"question" "q-10522" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/state.json" "file_sha256" "44e2ac4aacf233f7f2832d58c9693faa75f215fbfd742d362808537a18d78975"} {"question" "q-10522" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "$M∼[\\begin{aligned}1 & -3 & -8 \\\\ 0 & 1 & -2\\end{aligned}],$\n$\\,x=-4$ and $y=1$"] ["text" "$M∼[\\begin{aligned}1 & -3 & -8 \\\\ 0 & 1 & 1\\end{aligned}],$\n$\\,x=-4$ and $y=1$"] ["text" "$M∼[\\begin{aligned}1 & -3 & -8 \\\\ 0 & 1 & 2\\end{aligned}],$\n$\\,x=-2$ and $y=2$"] ["text" "$M∼[\\begin{aligned}1 & -3 & -8 \\\\ 0 & 1 & 5\\end{aligned}],$\n$\\,x=-2$ and $y=2$"] ["text" "$M∼[\\begin{aligned}1 & 0 & -8 \\\\ 0 & 1 & 2\\end{aligned}],$\n$\\,x=-8$ and $y=2$"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/state.json" "file_sha256" "44e2ac4aacf233f7f2832d58c9693faa75f215fbfd742d362808537a18d78975"} {"question" "q-10522" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "$M∼[\\begin{aligned}1 & -3 & -8 \\\\ 0 & 1 & 2\\end{aligned}],$\n$\\,x=-2$ and $y=2$"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/state.json" "file_sha256" "44e2ac4aacf233f7f2832d58c9693faa75f215fbfd742d362808537a18d78975"} {"question" "q-73538" "field" nil "attribute" "question/problem" "value" "Consider the system of linear equations\n\n$$\n{\\begin{aligned} & 3x-2y=4 \\\\  & 2x-y=2.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/state.json" "file_sha256" "44e2ac4aacf233f7f2832d58c9693faa75f215fbfd742d362808537a18d78975"} {"question" "q-73538" "field" nil "attribute" "question/worked-solution" "value" "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}3 & -2 & 4 \\\\ 2 & -1 & 2\\end{aligned}].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}3 & -2 & 4 \\\\ 2 & -1 & 2\\end{aligned}] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 2 & -1 & 2\\end{aligned}] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & \\frac{1}{3} & -\\frac{2}{3}\\end{aligned}] & {R}_{2} & :=3{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -2\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/state.json" "file_sha256" "44e2ac4aacf233f7f2832d58c9693faa75f215fbfd742d362808537a18d78975"} {"question" "q-73538" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/activity-metadata.json" "file_sha256" "dd27bde0e4244fdaa6cbf12d593d53d628b335d439e5ac5f092446d750ee8dfd"} {"question" "q-73538" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/state.json" "file_sha256" "44e2ac4aacf233f7f2832d58c9693faa75f215fbfd742d362808537a18d78975"} {"question" "q-73538" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "M∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -2\\end{aligned}]"] ["math" "M∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -3\\end{aligned}]"] ["math" "M∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -\\frac{3}{2}\\end{aligned}]"] ["math" "M∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & 2\\end{aligned}]"] ["math" "M∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & \\frac{3}{2}\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/state.json" "file_sha256" "44e2ac4aacf233f7f2832d58c9693faa75f215fbfd742d362808537a18d78975"} {"question" "q-73538" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "M∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -2\\end{aligned}]"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/state.json" "file_sha256" "44e2ac4aacf233f7f2832d58c9693faa75f215fbfd742d362808537a18d78975"} {"question" "q-20496" "field" nil "attribute" "question/problem" "value" "Consider the system of linear equations\n\n$$\n{\\begin{aligned} & 2x+7y=-5 \\\\  & 7x+11y=-4.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/state.json" "file_sha256" "44e2ac4aacf233f7f2832d58c9693faa75f215fbfd742d362808537a18d78975"} {"question" "q-20496" "field" nil "attribute" "question/worked-solution" "value" "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}2 & 7 & -5 \\\\ 7 & 11 & -4\\end{aligned}].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}2 & 7 & -5 \\\\ 7 & 11 & -4\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & \\frac{7}{2} & -\\frac{5}{2} \\\\ 7 & 11 & -4\\end{aligned}] & {R}_{2} & :={R}_{2}-7{R}_{1} \\\\  & ∼[\\begin{aligned}1 & \\frac{7}{2} & -\\frac{5}{2} \\\\ 0 & -\\frac{27}{2} & \\frac{27}{2}\\end{aligned}] & {R}_{2} & :=-\\frac{2}{27}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & \\frac{7}{2} & -\\frac{5}{2} \\\\ 0 & 1 & -1\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/state.json" "file_sha256" "44e2ac4aacf233f7f2832d58c9693faa75f215fbfd742d362808537a18d78975"} {"question" "q-20496" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/activity-metadata.json" "file_sha256" "dd27bde0e4244fdaa6cbf12d593d53d628b335d439e5ac5f092446d750ee8dfd"} {"question" "q-20496" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/state.json" "file_sha256" "44e2ac4aacf233f7f2832d58c9693faa75f215fbfd742d362808537a18d78975"} {"question" "q-20496" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "M∼[\\begin{aligned}1 & 7 & -5 \\\\ 0 & 1 & -2\\end{aligned}]"] ["math" "M∼[\\begin{aligned}1 & 7 & -5 \\\\ 0 & 1 & 0\\end{aligned}]"] ["math" "M∼[\\begin{aligned}1 & \\frac{7}{2} & -\\frac{5}{2} \\\\ 0 & 1 & -1\\end{aligned}]"] ["math" "M∼[\\begin{aligned}1 & \\frac{7}{2} & -\\frac{5}{2} \\\\ 0 & 1 & -3\\end{aligned}]"] ["math" "M∼[\\begin{aligned}1 & \\frac{7}{2} & -\\frac{5}{2} \\\\ 0 & 1 & 1\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/state.json" "file_sha256" "44e2ac4aacf233f7f2832d58c9693faa75f215fbfd742d362808537a18d78975"} {"question" "q-20496" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "M∼[\\begin{aligned}1 & \\frac{7}{2} & -\\frac{5}{2} \\\\ 0 & 1 & -1\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/state.json" "file_sha256" "44e2ac4aacf233f7f2832d58c9693faa75f215fbfd742d362808537a18d78975"} {"question" "q-73555" "field" nil "attribute" "question/problem" "value" "Consider the system of linear equations\n\n$$\n{\\begin{aligned} & 4x+12y=-4 \\\\  & 5x+11y=3.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/state.json" "file_sha256" "44e2ac4aacf233f7f2832d58c9693faa75f215fbfd742d362808537a18d78975"} {"question" "q-73555" "field" nil "attribute" "question/worked-solution" "value" "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}4 & 12 & -4 \\\\ 5 & 11 & 3\\end{aligned}].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}4 & 12 & -4 \\\\ 5 & 11 & 3\\end{aligned}] & {R}_{1} & :=\\frac{1}{4}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & -1 \\\\ 5 & 11 & 3\\end{aligned}] & {R}_{2} & :={R}_{2}-5{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & -1 \\\\ 0 & -4 & 8\\end{aligned}] & {R}_{2} & :=-\\frac{1}{4}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 3 & -1 \\\\ 0 & 1 & -2\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/state.json" "file_sha256" "44e2ac4aacf233f7f2832d58c9693faa75f215fbfd742d362808537a18d78975"} {"question" "q-73555" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/activity-metadata.json" "file_sha256" "dd27bde0e4244fdaa6cbf12d593d53d628b335d439e5ac5f092446d750ee8dfd"} {"question" "q-73555" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/state.json" "file_sha256" "44e2ac4aacf233f7f2832d58c9693faa75f215fbfd742d362808537a18d78975"} {"question" "q-73555" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "M∼[\\begin{aligned}1 & 3 & -1 \\\\ 0 & 1 & -1\\end{aligned}]"] ["math" "M∼[\\begin{aligned}1 & 3 & -1 \\\\ 0 & 1 & -2\\end{aligned}]"] ["math" "M∼[\\begin{aligned}1 & 3 & -1 \\\\ 0 & 1 & -4\\end{aligned}]"] ["math" "M∼[\\begin{aligned}1 & 3 & -1 \\\\ 0 & 1 & 1\\end{aligned}]"] ["math" "M∼[\\begin{aligned}1 & 3 & -1 \\\\ 0 & 1 & 2\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/state.json" "file_sha256" "44e2ac4aacf233f7f2832d58c9693faa75f215fbfd742d362808537a18d78975"} {"question" "q-73555" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "M∼[\\begin{aligned}1 & 3 & -1 \\\\ 0 & 1 & -2\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/state.json" "file_sha256" "44e2ac4aacf233f7f2832d58c9693faa75f215fbfd742d362808537a18d78975"} {"question" "e-4697" "field" nil "attribute" "question/problem" "value" "Consider the augmented matrix $M$ given by \n\n$$\n\\begin{aligned}1 & 2 & 0 \\\\ 3 & -2 & -8\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then solve the linear system represented by the matrix." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/example-4697.json" "file_sha256" "e0d5a1f73737319b54db36b2547533ed708af22c366448ceda6e5b0cdfb1c811"} {"question" "e-4697" "field" nil "attribute" "question/worked-solution" "value" "Reducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 2 & 0 \\\\ 3 & -2 & -8\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & 0 \\\\ 0 & -8 & -8\\end{aligned}] & {R}_{2} & :=-\\frac{1}{8}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 2 & 0 \\\\ 0 & 1 & 1\\end{aligned}].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\begin{aligned}x+2y=0 \\\\ y=1,\\end{aligned}\n$$\n\nand we can apply back substitution. The final equation $y=1$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx+2(1)=0 \n\t\\quad\\Rightarrow\\quad\n\tx=-2.\n$$\n\nTherefore, the solution is $x=-2$ and $y=1.$ Or, in vector form, $\\left<  -2,1 \\right>.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/example-4697.json" "file_sha256" "e0d5a1f73737319b54db36b2547533ed708af22c366448ceda6e5b0cdfb1c811"} {"question" "e-4698" "field" nil "attribute" "question/problem" "value" "Consider the system of linear equations\n\n$$\n\\begin{aligned}-x+5y=5 \\\\ x-6y=5.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then solve the linear system." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/example-4698.json" "file_sha256" "afc139329376e0a05d6ed72282b22003fff2a5214a1d13566f15ba6b0c3f7125"} {"question" "e-4698" "field" nil "attribute" "question/worked-solution" "value" "The augmented matrix for this system is\n\n$$\n\\begin{aligned}-1 & 5 & 5 \\\\ 1 & -6 & 5\\end{aligned}\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}-1 & 5 & 5 \\\\ 1 & -6 & 5\\end{aligned}] & {R}_{1} & :=-{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -5 & -5 \\\\ 1 & -6 & 5\\end{aligned}] & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -5 & -5 \\\\ 0 & -1 & 10\\end{aligned}] & {R}_{2} & :=-{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -5 & -5 \\\\ 0 & 1 & -10\\end{aligned}].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\begin{aligned}x-5y=-5 \\\\ y=-10,\\end{aligned}\n$$\n\nand we can apply back substitution. The final equation $y=-10$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx-5(-10)=-5 \n\t\\quad\\Rightarrow\\quad\n\tx=-55.\n$$\n\nTherefore, the solution is $x=-55$ and $y=-10.$ Or, in vector form, $\\langle -55,-10 \\rangle.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/example-4698.json" "file_sha256" "afc139329376e0a05d6ed72282b22003fff2a5214a1d13566f15ba6b0c3f7125"} {"question" "q-10522" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "$M∼[\\begin{aligned}1 & -3 & -8 \\\\ 0 & 1 & 2\\end{aligned}],$\n$\\,x=-2$ and $y=2$"] "category" "reviewed_ma_solution" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040213/answer-source-reviews.json" "file_sha256" "62be2d9ad2a4716e7d82d90bf6acc0e7f58e570be8def3edeb91ba144c5e261d" "reviewer_session" "01a118cc-89a0-7c90-9221-d6599ae13bca" "rationale" "Applying R2:=R2-2R1 gives [0,10,20]; dividing that row by 10 gives [0,1,2]. Back substitution yields y=2 and x=-2. Original option 2 contains both the correct echelon matrix and solution. Stored bmatrix notation expresses exactly the same entries and solution. This is a source-backed derived judgment, corroborated by the original screenshot, worked solution, and successful grading." "bindings" {"problem" "f23e952c0dd6f60ba030167cb73e16b650046325256c4c9dcc1329d1d2c89bc7" "worked_solution" "bafce0ecfb3f027ca7c62f1