34733 true] [17592186306356 1145 "Reducing $M$ to row echelon form using the standard algorithm for Gaussian elimination, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}3 & -2 & 4 \\\\ 6 & 4 & -8\\end{aligned}] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 6 & 4 & -8\\end{aligned}] & {R}_{2} & :={R}_{2}-6{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 8 & -16\\end{aligned}] & {R}_{2} & :=\\frac{1}{8}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -2\\end{aligned}].\\end{aligned}\n$$" 13194139534733 true] [17592186306357 1000 #edb/ref 17592186306358 13194139534733 true] [17592186306357 1000 #edb/ref 17592186306359 13194139534733 true] [17592186306357 1000 #edb/ref 17592186306360 13194139534733 true] [17592186306357 1000 #edb/ref 17592186306361 13194139534733 true] [17592186306357 1000 #edb/ref 17592186306362 13194139534733 true] [17592186306357 1040 #edb/ref 17592186045450 13194139534733 true] [17592186306357 1041 "selection" 13194139534733 true] [17592186306357 1104 #edb/ref 17592186306358 13194139534733 true] [17592186306357 1110 #uuid "1fd1a169-1768-5417-bb6a-344d7d5250e0" 13194139534733 true] [17592186306358 1034 "M∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -2\\end{aligned}]" 13194139534733 true] [17592186306358 1103 #edb/ref 17592186045453 13194139534733 true] [17592186306358 1111 #uuid "f23c79e2-292d-5233-9668-2a422c6e8542" 13194139534733 true] [17592186306359 1034 "M∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & 2\\end{aligned}]" 13194139534733 true] [17592186306359 1103 #edb/ref 17592186045453 13194139534733 true] [17592186306359 1111 #uuid "02dd7a79-c6ee-5060-a60f-89efcf0ae0ee" 13194139534733 true] [17592186306360 1034 "M∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & -2\\end{aligned}]" 13194139534733 true] [17592186306360 1103 #edb/ref 17592186045453 13194139534733 true] [17592186306360 1111 #uuid "ecd0482f-9a1