ers/linear/14038440/state.json" "file_sha256" "f2f78a8fb14e395d2afc1c8d2c339c9242720a47e6a8cee171e52d54122fb638"} {"question" "q-181773" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038440/activity-metadata.json" "file_sha256" "cfaa5b9d30900903e28e1bba97790ae61bb22126fc0e2fa27da8250a38beaca9"} {"question" "q-181773" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038440/state.json" "file_sha256" "f2f78a8fb14e395d2afc1c8d2c339c9242720a47e6a8cee171e52d54122fb638"} {"question" "q-181773" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[-7,-5]"] ["math" "{-7,-5}"] ["math" "{5,6,7}"] ["math" "{5,7}"] ["math" "∅"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038440/state.json" "file_sha256" "f2f78a8fb14e395d2afc1c8d2c339c9242720a47e6a8cee171e52d54122fb638"} {"question" "q-181773" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "∅"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038440/state.json" "file_sha256" "f2f78a8fb14e395d2afc1c8d2c339c9242720a47e6a8cee171e52d54122fb638"} {"question" "q-181761" "field" nil "attribute" "question/problem" "value" "Which set is equivalent to $A={x\\in R:|x-3|=4}?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038440/state.json" "file_sha256" "f2f78a8fb14e395d2afc1c8d2c339c9242720a47e6a8cee171e52d54122fb638"} {"question" "q-181761" "field" nil "attribute" "question/worked-solution" "value" "The elements of the given set are the real numbers that satisfy the equation $|x-3|=4.$ So, we first need to solve for $x:$\n\n$$\n\\begin{aligned}|x-3| & =4 \\\\ x-3 & =\\pm 4 \\\\ x & =3\\pm 4 \\\\ x & =-1,7\\end{aligned}\n$$\n\nThe solutions are $x=-1$ and $x=7,$ and both of these solutions are real numbers.\n\nTherefore, we can write the given set as\n\n$$\nA={-1,7}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038440/state.json" "file_sha256" "f2f78a8fb14e395d2afc1c8d2c339c9242720a47e6a8cee171e52d54122fb638"} {"question" "q-181761" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038440/activity-metadata.json" "file_sha256" "cfaa5b9d30900903e28e1bba97790ae61bb22126fc0e2fa27da8250a38beaca9"} {"question" "q-181761" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038440/state.json" "file_sha256" "f2f78a8fb14e395d2afc1c8d2c339c9242720a47e6a8cee171e52d54122fb638"} {"question" "q-181761" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[-1,7]"] ["math" "{-1,7}"] ["math" "{7}"] ["math" "{\\pm 1,\\pm 2,\\pm 3,\\pm 4,\\pm 5,\\pm 6,\\pm 7}"] ["math" "{\\pm 1}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038440/state.json" "file_sha256" "f2f78a8fb14e395d2afc1c8d2c339c9242720a47e6a8cee171e52d54122fb638"} {"question" "q-181761" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{-1,7}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038440/state.json" "file_sha256" "f2f78a8fb