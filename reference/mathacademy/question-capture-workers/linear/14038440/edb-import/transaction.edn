ons are $q=-3$ and $q=3,$ and both of these solutions are rational numbers.\n\nTherefore, we can write the given set as\n\n$$\nA={-3,3}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-181764/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7c2ae57a-fde8-5d07-bbff-e66fbd4428b0"] :knowledge-point/questions ["q-181764"] :db/ensure [:knowledge-point/validate]} {:db/id "q-181795/selection/2531b01062963bf17cb1953367062769d91dcfc4519f4f6b120c5de4951d40dd" :answer/id #uuid "59ef3ceb-aa68-55bb-b893-456717b5ac0b" :answer/type :answer.type/math :answer/value "∅" :db/ensure [:answer/validate]} {:db/id "q-181795/selection/7d512723ec7933fc53d818fe067378407b0cca1985b020babe9fcffa79cfd32b" :answer/id #uuid "af3aeb11-a995-57eb-afe5-e7633bbcabd4" :answer/type :answer.type/math :answer/value "Z" :db/ensure [:answer/validate]} {:db/id "q-181795/selection/fb921dace98cc4a48b51b564f5a0d88f9f8d40f301c579480f838bbfa2fd9c40" :answer/id #uuid "2d092794-2b6e-5027-a993-00545c50504c" :answer/type :answer.type/math :answer/value "{0,\\,\\pm \\frac{\\pi }{4},\\,\\pm \\frac{3\\pi }{4},\\,\\pm \\frac{5\\pi }{4},\\,…}" :db/ensure [:answer/validate]} {:db/id "q-181795/selection/1b335f51e58cd3dd49e533f0072be4176e2d095476a020311b69afe89de63bd1" :answer/id #uuid "26ff209a-ad93-5267-85a6-a5b0c754cd41" :answer/type :answer.type/math :answer/value "{0,\\,\\pm \\frac{\\pi }{4},\\,\\pm \\frac{\\pi }{2},\\,\\pm \\frac{3\\pi }{4},\\,\\pm \\pi ,\\,…}" :db/ensure [:answer/validate]} {:db/id "q-181795/selection/2a3a646bd7794fc7bf80c7346261c1817b4305dafec5b08d301eb4cebccbecce" :answer/id #uuid "41d84eb7-6cb4-599f-837e-a09056628cbb" :answer/type :answer.type/math :answer/value "{0,\\,\\frac{\\pi }{4},\\,\\frac{\\pi }{2},\\,\\frac{3\\pi }{4},\\,\\pi ,\\,…}" :db/ensure [:answer/validate]} {:db/id "q-181795/selection" :answer-field/id #uuid "76f36de7-0143-5ca9-a77e-fe5d8e8a1d67" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :an