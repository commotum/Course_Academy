orrect "q-316689/field-3/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c" :answer-field/choices ["q-316689/field-3/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c"] :db/ensure [:answer-field/validate]} {:db/id "q-316689/field-4/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc" :answer/id #uuid "a1d50193-c05c-5c45-9de0-43cdbeb19830" :answer/type :answer.type/math :answer/value "60" :db/ensure [:answer/validate]} {:db/id "q-316689/field-4" :answer-field/id #uuid "36ef6687-5c3e-515d-a33a-d86d7a4a65de" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316689/field-4/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc" :answer-field/choices ["q-316689/field-4/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc"] :db/ensure [:answer-field/validate]} {:db/id "q-316689" :question/id #uuid "5f5cc839-e6a4-52c2-9f56-171a4dee9b16" :question/math-academy-id "q-316689" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039932/assets/b2dbc407d70f4e6d3cf35dd24e1a6fb7d463207631a0498595ed40550ac86433.png)\n\nThe Argand diagram above shows the roots of a cubic polynomial $f(x).$\nFind $f(x)$ given that the coefficient of the cubic term is $-5.$\n\n$f(x)=$\n{{field-1}}${x}^{3}\\,+$\n{{field-2}}${x}^{2}\\,-$\n{{field-3}}$x\\,+$\n{{field-4}}" :question/worked-solution "From the diagram, we see that $f(x)$ has roots ${x}_{1}=3$ and ${x}_{2,3}=\\pm 2\\text{i}.$ Additionally, we're given that the coefficient of the cubic term is $a=-5.$ Therefore, we can write the polynomial as follows:\n\n$$\n\\begin{aligned}f(x) & =a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) \\\\  & =-5(x-3)(x-2\\text{i})(x-(-2\\text{i})) \\\\  & =-5(x-3)(x-2\\text{i})(x+2\\text{i})\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}-5(x-3)(x-2\\text{i})(x+2\\text{i}) & = \\\\ -5(x-3)({x}^{2}+x(2\\text{i})-x(2\\text{i})-(2\\text{i})^{2}) & = \\\\ -5(x-3)({x}^{2}+4) & = \\\\ -5({x}^{3}+4x-3{x}^{2}-12) & = \\\\ -5{x}^{3}+15{x}^{2}-20x+60.\\end{aligned}\n$$\n\nTherefore, $f(x)=-5{x}^{3}+15{x}^{2}-20x+60.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-316689/field-1" "q-316689/field-2" "q-316689/field-3" "q-316689/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e4bb90c5-2794-5657-8f0b-45eb64873e03"] :knowledge-point/questions ["q-316689"] :db/ensure [:knowledge-point/validate]} {:db/id "q-17408/selection/48ac6e4dca827303dca7b655d3eed85fb2f02327b7d0ba1c02347e6656956b60" :answer/id #uuid "6dbc2343-c979-5b18-acec-fd84e1825aa4" :answer/type :answer.type/math :answer/value "{x}^{3}-7{x}^{2}-36" :db/ensure [:answer/validate]} {:db/id "q-17408/selection/a15edf12920143b52f8bc31d04eaab158bea972d5e01a28b867e366a8e11f637" :answer/id #uuid "c1c38465-c21c-58c9-acd5-a25476701397" :answer/type :answer.type/math :answer/value "{x}^{3}-9{x}^{2}+24x-14" :db/ensure [:answer/validate]} {:db/id "q-17408/selection/252f88d317be6c02909cd12f62fecdaaf6f5ecfead51957eac693ac3f6348e89" :answer/id #uuid "3b56a55e-d4af-5687-91dc-04572d49c2b5" :answer/type :answer.type/math :answer/value "{x}^{3}+4{x}^{2}-13" :db/ensure [:answer/validate]} {:db/id "q-17408/selection/b549629f63f589ba89b43b007cc96b1e7177004544d97a595428e2288f378e1e" :answer/id #uuid "317ba80a-9e77-5435-b0f1-96272cbd372b" :answer/type :answer.type/math :answer/value "{x}^{3}-2{x}^{2}+3x-18" :db/ensure [:answer/validate]} {:db/id "q-17408/selection/ac52066322adb290b593a7d47f89fdd7aa0e5edf1e59e9ffbd9f70212d9e1d24" :answer/id #uuid "2e7eaece-6d5d-5c70-82e6-cea9c43ee928" :answer/type :answer.type/math :answer/value "{x}^{3}-7{x}^{2}+25x-39" :db/ensure [:answer/validate]} {:db/id "q-17408/selection" :answer-field/id #uuid "a0b69fc7-7644-53a8-9834-af1d6c37a7db" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-17408/selection/ac52066322adb290b593a7