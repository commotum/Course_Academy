#{[{:db/id #edb/ref 17592186281846 :knowledge-point/_questions [{:knowledge-point/id #uuid "517f2054-008e-54eb-89dd-5f0a09e1f881" :knowledge-point/title "Finding a Cubic Polynomial Given Three Real Roots and a Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e4c645a7-6e88-5972-b95f-905dac795ff5" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186281848}] :answer-field/correct {:answer/id #uuid "e4c645a7-6e88-5972-b95f-905dac795ff5" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186281848} :answer-field/id #uuid "91791d0a-1066-5c42-b09c-9cb09d183694" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186281847} {:answer-field/choices [{:answer/id #uuid "10c26c3e-2747-5197-ad23-a2ed18872e4d" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186281850}] :answer-field/correct {:answer/id #uuid "10c26c3e-2747-5197-ad23-a2ed18872e4d" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186281850} :answer-field/id #uuid "6bac3080-51d6-5bbf-b341-0d56be3ea619" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186281849} {:answer-field/choices [{:answer/id #uuid "760a6ca5-e3eb-547b-b1ce-767c2123969f" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186281852}] :answer-field/correct {:answer/id #uuid "760a6ca5-e3eb-547b-b1ce-767c2123969f" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186281852} :answer-field/id #uuid "20b89ba4-b596-516d-8f05-c3c0e495998e" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186281851} {:answer-field/choices [{:answer/id #uuid "2933e7f1-ebb8-52f6-b1b0-a983d26a9cc0" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186281854}] :answer-field/correct {:answer/id #uuid "2933e7f1-ebb8-52f6-b1b0-a983d26a9cc0" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186281854} :answer-field/id #uuid "40817d4a-1275-5ff8-aef6-04cef1d3a688" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186281853}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b79b1845-4a56-5456-a000-eb06d5845200" :question/math-academy-id "q-316621" :question/problem "The cubic polynomial $P(x)$ has roots ${x}_{1}={x}_{2}=-4,{x}_{3}=1,$ and the coefficient of the cubic term is $2.$ Find $P(x).$\n\n$P(x)=$\n{{field-1}}${x}^{3}\\,+$\n{{field-2}}${x}^{2}\\,+$\n{{field-3}}$x\\,-$\n{{field-4}}" :question/worked-solution "Since our cubic polynomial has roots ${x}_{1}=-4,$ ${x}_{2}=-4,$ and ${x}_{3}=1,$ and the coefficient of the cubic term is $a=2,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) & =2(x-(-4))(x-(-4))(x-1) \\\\  & =2(x+4)(x+4)(x-1)\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}2(x+4)(x+4)(x-1) & =2({x}^{2}+8x+16)(x-1) \\\\  & =2({x}^{3}-{x}^{2}+8{x}^{2}-8x+16x-16) \\\\  & =2({x}^{3}+7{x}^{2}+8x-16) \\\\  & =2{x}^{3}+14{x}^{2}+16x-32.\\end{aligned}\n$$\n\nTherefore, $P(x)=2{x}^{3}+14{x}^{2}+16x-32.$"}]}
