#{[{:db/id #edb/ref 17592186275269 :knowledge-point/_questions [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70d63407-5b24-5bff-bf3d-428021ab33ba" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186275271} {:answer/id #uuid "86201421-b548-5870-b969-06be9059c378" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186275272} {:answer/id #uuid "f0716f83-4677-5e0b-b604-171130b5d1fc" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186275273} {:answer/id #uuid "3e2cdaa0-c317-5d32-8856-34a29c004430" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186275274} {:answer/id #uuid "b8f54c30-d3e7-5317-9414-179a256e3799" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186275275}] :answer-field/correct {:answer/id #uuid "70d63407-5b24-5bff-bf3d-428021ab33ba" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186275271} :answer-field/id #uuid "66eef582-270a-5ded-aa58-fed12c53b9aa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275270}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b926c009-9ad2-534d-a324-b16391c53f68" :question/math-academy-id "q-237018" :question/problem "Let $a=5i-4j+3k$ and $b=-7i+xj+k.$ Given that the scalar projection of $a$ onto $b$ is zero, find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =5\\cdot (-7)+(-4)\\cdot x+3\\cdot 1 \\\\  & =-4x-32.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ -4x-32 & =0 \\\\ 4x & =-32 \\\\ x & =-8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186384533 :knowledge-point/_questions [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33c2445b-d731-51d5-ab46-000244081230" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186384535} {:answer/id #uuid "61730d46-da7a-5a0a-802b-86ada0d1bd94" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186384536} {:answer/id #uuid "720cc7b3-4965-50ab-8088-f0012a8dbd30" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186384537} {:answer/id #uuid "c91cb73a-b718-55dd-8f75-e5da81b7d1c4" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186384538} {:answer/id #uuid "84a4ad85-dad5-587d-9f7f-f999a6d11788" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186384539}] :answer-field/correct {:answer/id #uuid "c91cb73a-b718-55dd-8f75-e5da81b7d1c4" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186384538} :answer-field/id #uuid "47e4f7da-32ac-5957-bd4a-b840c4b8aae8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186384534}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d266b497-f24d-5e83-b16d-82c7d0bda0f4" :question/math-academy-id "q-237021" :question/problem "Let $c=⟨-3,\\sqrt{3},1⟩$ and $d=⟨x,0,-12⟩.$ Given that the scalar projection of $c$ onto $d$ is zero, find the value of $x.$" :question/worked-solution "Since $c$ is a nonzero vector, its scalar projection onto another nonzero vector $d$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\nc⊥d\\,⟹\\,c\\cdot d=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}c\\cdot d & ={c}_{x}\\cdot {d}_{x}+{c}_{y}\\cdot {d}_{y}+{c}_{z}\\cdot {d}_{z} \\\\  & =(-3)\\cdot x+\\sqrt{3}\\cdot 0+1\\cdot (-12) \\\\  & =-3x-12.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}c\\cdot d & =0 \\\\ -3x-12 & =0 \\\\ 3x & =-12 \\\\ x & =-4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186384540 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f9851f89-5e9d-513d-9368-95fd4360bd6c" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186384542} {:answer/id #uuid "0ed73de5-a5a8-545e-afd0-15dc790f5862" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186384543}] :answer-field/correct {:answer/id #uuid "0ed73de5-a5a8-545e-afd0-15dc790f5862" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186384543} :answer-field/id #uuid "8528824e-b9e0-5132-873e-783fe728400c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186384541}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3ce822af-94cc-52ef-a9f7-5da5b1ed7557" :question/math-academy-id "q-318981" :question/problem "Let $r=⟨-1,2,3⟩$ and $s=⟨2,0,0⟩.$ Find the scalar projection of $r$ onto $s.$\n\n${\\text{comp}}_{s}\\,r=$\n{{field-1}}" :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{s}\\,r & =\\frac{r\\cdot s}{|\\,s\\,|} \\\\  & =\\frac{{r}_{x}{s}_{x}+{r}_{y}{s}_{y}+{r}_{z}{s}_{z}}{\\sqrt{{s}_{x}^{2}+{s}_{y}^{2}+{s}_{z}^{2}}} \\\\  & =\\frac{(-1)(2)+(2)(0)+(3)(0)}{\\sqrt{{2}^{2}+{0}^{2}+{0}^{2}}} \\\\  & =\\frac{-2}{\\sqrt{4}} \\\\  & =-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275303 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "554cdaaa-237e-5411-8dff-06df05dcd025" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{24}{5}" :db/id #edb/ref 17592186275305}] :answer-field/correct {:answer/id #uuid "554cdaaa-237e-5411-8dff-06df05dcd025" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{24}{5}" :db/id #edb/ref 17592186275305} :answer-field/id #uuid "91aabf1b-4343-5d3c-bb56-75125e11f3c0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275304}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e0409876-8b86-5c5a-9497-7f01e774d52d" :question/math-academy-id "q-318988" :question/problem "Let $p=⟨9,12,0⟩$ and $q=⟨0,3,4⟩.$ Find ${\\text{comp}}_{q}\\,p-{\\text{comp}}_{p}\\,q.$\n\n${\\text{comp}}_{q}\\,p-{\\text{comp}}_{p}\\,q=$\n{{field-1}}" :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{(9)(0)+(12)(3)+(0)(4)}{\\sqrt{{0}^{2}+{3}^{2}+{4}^{2}}} \\\\  & =\\frac{36}{\\sqrt{25}} \\\\  & =\\frac{36}{5}.\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{p}\\,q & =\\frac{p\\cdot q}{|\\,p\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{p}_{x}^{2}+{p}_{y}^{2}+{p}_{z}^{2}}} \\\\  & =\\frac{36}{\\sqrt{{9}^{2}+{12}^{2}+{0}^{2}}} \\\\  & =\\frac{36}{\\sqrt{225}} \\\\  & =\\frac{12}{5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p-{\\text{comp}}_{p}\\,q & =\\frac{36}{5}-\\frac{12}{5} \\\\  & =\\frac{24}{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186384544 :knowledge-point/_questions [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71d29705-2346-55b4-8fc0-c4d3f6aa8ae8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186384546}] :answer-field/correct {:answer/id #uuid "71d29705-2346-55b4-8fc0-c4d3f6aa8ae8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186384546} :answer-field/id #uuid "54676cc8-2bd5-55d1-8dd6-b1ebac444a4a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186384545}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ef00ed14-3eea-52f8-8f98-16b6f55b0077" :question/math-academy-id "q-319150" :question/problem "Let $p=⟨3,-1,2⟩$ and $q=⟨x,1,1⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =3\\cdot x+(-1)\\cdot 1+2\\cdot 1 \\\\  & =3x+1.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 3x+1 & =0 \\\\ 3x & =-1 \\\\ x & =-\\frac{1}{3}.\\end{aligned}\n$$"}]}
