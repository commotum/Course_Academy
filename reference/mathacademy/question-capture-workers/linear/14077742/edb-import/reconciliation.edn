e/13965088/edb-import/verification.json"}] "sources" [{"question" "q-237018" "field" nil "attribute" "question/problem" "value" "Let $a=5i-4j+3k$ and $b=-7i+xj+k.$ Given that the scalar projection of $a$ onto $b$ is zero, find the value of $x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077742/state.json" "file_sha256" "27de923943d17983eeeb637b439191a849af7f77dce5506f9c928004d3487039"} {"question" "q-237018" "field" nil "attribute" "question/worked-solution" "value" "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =5\\cdot (-7)+(-4)\\cdot x+3\\cdot 1 \\\\  & =-4x-32.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ -4x-32 & =0 \\\\ 4x & =-32 \\\\ x & =-8.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077742/state.json" "file_sha256" "27de923943d17983eeeb637b439191a849af7f77dce5506f9c928004d3487039"} {"question" "q-237018" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077742/activity-metadata.json" "file_sha256" "170fb37bda687144b049ef5593f159ddffa6a0eeeee29888ff2f68de6de60b61"} {"question" "q-237018" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077742/state.json" "file_sha256" "27de923943d17983eeeb637b439191a849af7f77dce5506f9c928004d3487039"} {"question" "q-237018" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-4"] ["math" "-6"] ["math" "-8"] ["math" "2"] ["math" "4"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077742/state.json" "file_sha256" "27de923943d17983eeeb637b439191a849af7f77dce5506f9c928004d3487039"} {"question" "q-237018" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-8"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077742/state.json" "file_sha256" "27de923943d17983eeeb637b439191a849af7f77dce5506f9c928004d3487039"} {"question" "q-237021" "field" nil "attribute" "question/problem" "value" "Let $c=⟨-3,\\sqrt{3},1⟩$ and $d=⟨x,0,-12⟩.$ Given that the scalar projection of $c$ onto $d$ is zero, find the value of $x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077742/state.json" "file_sha256" "27de923943d17983eeeb637b439191a849af7f77dce5506f9c928004d3487039"} {"question" "q-237021" "field" nil "attribute" "question/worked-solution" "value" "Since $c$ is a nonzero vector, its scalar projection onto another nonzero vector $d$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\nc⊥d\\,⟹\\,c\\cdot d=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}c\\cdot d & ={c}_{x}\\cdot {d}_{x}+{c}_{y}\\cdot {d}_{y}+{c}_{z}\\cdot {d}_{z} \\\\  & =(-3)\\cdot x+\\sqrt{3}\\cdot 0+1\\cdot (-12) \\\\  & =-3x-12.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}c\\cdot d & =0 \\\\ -3x-12 & =0 \\\\ 3x & =-12 \\\\ x & =-4.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077742/state.json" "file_sha256" "27de923943d17983eeeb637b439191a849af7f77dce5506f9c928004d3487039"} {"question" "q-237021" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077742/activity-metadata.json" "file_sha256" "170fb37bda687144b049ef5593f159ddffa6a0eeeee29888ff2f68de6de60b61"} {"question" "q-237021" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077742/state.json" "file_sha256" "27de923943d17983eeeb637b439191a849af7f77dce5506f9c928004d3487039"} {"question" "q-237021" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2"] ["math" "-4"] ["math" "1"] ["math" "2"] ["math" "6"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077742/state.json" "file_sha256" "27de923943d17983eeeb637b439191a849af7f77dce5506f9c928004d3487039"} {"question" "q-237021" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-4"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077742/state.json" "file_sha256" "27de923943d17983eeeb637b439191a849af7f77dce5506f9c928004d3487039"} {"question" "q-318981" "field" nil "attribute" "question/problem" "value" "Let $r=⟨-1,2,3⟩$ and $s=⟨2,0,0⟩.$ Find the scalar projection of $r$ onto $s.$\n\n${\\text{comp}}_{s}\\,r=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077742/state.json" "file_sha256" "27de923943d17983eeeb637b439191a849af7f77dce5506f9c928004d3487039"} {"question" "q-318981" "field" nil "attribute" "question/worked-solution" "value" "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{s}\\,r & =\\frac{r\\cdot s}{|\\,s\\,|} \\\\  & =\\frac{{r}_{x}{s}_{x}+{r}_{y}{s}_{y}+{r}_{z}{s}_{z}}{\\sqrt{{s}_{x}^{2}+{s}_{y}^{2}+{s}_{z}^{2}}} \\\\  & =\\frac{(-1)(2)+(2)(0)+(3)(0)}{\\sqrt{{2}^{2}+{0}^{2}+{0}^{2}}} \\\\  & =\\frac{-2}{\\sqrt{4}} \\\\  & =-1.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077742/state.json" "file_sha256" "27de923943d17983eeeb637b439191a849af7f77dce5506f9c928004d3487039"} {"question" "q-318981" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077742/activity-metadata.json" "file_sha256" "170fb37bda687144b049ef5593f159ddffa6a0eeeee29888ff2f68de6de60b61"} {"question" "q-318981" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077742/state.json" "file_sha256" "27de923943d17983eeeb637b439191a849af7f77dce5506f9c928004d3487039"} {"question" "q-318981" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-1"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077742/state.json" "file_sha256" "27de923943d17983eeeb637b439191a849af7f77dce5506f9c928004d3487039"} {"question" "q-318988" "field" nil "attribute" "question/problem" "value" "Let $p=⟨9,12,0⟩$ and $q=⟨0,3,4⟩.$ Find ${\\text{comp}}_{q}\\,p-{\\text{comp}}_{p}\\,q.$\n\n${\\text{comp}}_{q}\\,p-{\\text{comp}}_{p}\\,q=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077742/state.json" "file_sha256" "27de923943d17983eeeb637b439191a849af7f77dce5506f9c928004d3487039"} {"question" "q-318988" "field" nil "attribute" "question/worked-solution" "value" "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{(9)(0)+(12)(3)+(0)(4)}{\\sqrt{{0}^{2}+{3}^{2}+{4}^{2}}} \\\\  & =\\frac{36}{\\sqrt{25}} \\\\  & =\\frac{36}{5}.\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{p}\\,q & =\\frac{p\\cdot q}{|\\,p\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{p}_{x}^{2}+{p}_{y}^{2}+{p}_{z}^{2}}} \\\\  & =\\frac{36}{\\sqrt{{9}^{2}+{12}^{2}+{0}^{2}}} \\\\  & =\\frac{36}{\\sqrt{225}} \\\\  & =\\frac{12}{5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p-{\\text{comp}}_{p}\\,q & =\\frac{36}{5}-\\frac{12}{5} \\\\  & =\\frac{24}{5}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077742/state.json" "file_sha256" "27de923943d17983eeeb637b439191a849af7f77dce5506f9c928004d3487039"} {"question" "q-318988" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077742/activity-metadata.json" "file_sha256" "170fb37bda687144b049ef5593f159ddffa6a0eeeee29888ff2f68de6de60b61"} {"question" "q-318988" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077742/state.json" "file_sha256" "27de923943d17983eeeb637b439191a849af7f77dce5506f9c928004d3487039"} {"question" "q-318988" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{24}{5}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077742/state.json" "file_sha256" "27de923943d17983eeeb637b439191a849af7f77dce5506f9c928004d3487039"} {"question" "q-319150" "field" nil "attribute" "question/problem" "value" "Let $p=⟨3,-1,2⟩$ and $q=⟨x,1,1⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077742/state.json" "file_sha256" "27de923943d17983eeeb637b439191a849af7f77dce5506f9c928004d3487039"} {"question" "q-319150" "field" nil "attribute" "question/worked-solution" "value" "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =3\\cdot x+(-1)\\cdot 1+2\\cdot 1 \\\\  & =3x+1.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 3x+1 & =0 \\\\ 3x & =-1 \\\\ x & =-\\frac{1}{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077742/state.json" "file_sha256" "27de923943d17983eeeb637b439191a849af7f77dce5506f9c928004d3487039"} {"question" "q-319150" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077742/activity-metadata.json" "file_sha256" "170fb37bda687144b049ef5593f159ddffa6a0eeeee29888ff2f68de6de60b61"} {"question" "q-319150" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077742/state.json" "file_sha256" "27de923943d17983eeeb637b439191a849af7f77dce5506f9c928004d3487039"} {"question" "q-319150" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{1}{3}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077742/state.json" "file_sha256" "27de923943d17983eeeb637b439191a849af7f77dce5506f9c928004d3487039"}] "usage" {"q-318988" [] "q-237018" []} "basis" 2807 "retractions" [] "immutable_answers" [17592186275271 17592186275272 17592186275273 17592186275274 17592186275275 17592186275305] "immutable_fields" [[17592186275270 :answer-field/correct] [17592186275270 :answer-field/id] [17592186275270 :answer-field/key] [17592186275270 :answer-field/type] [17592186275304 :answer-field/correct] [17592186275304 :answer-field/id] [17592186275304 :answer-field/key] [17592186275304 :answer-field/type]] "no_history" []}
