#{[{:db/id #edb/ref 17592186331904 :knowledge-point/_questions [{:knowledge-point/id #uuid "4b507561-8134-50ff-8c23-c4ecc546450d" :knowledge-point/title "Finding the Determinant of a Block Diagonal or Block Triangular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b33e3787-3d5a-5fd1-b986-efd147ed08a3" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186331906} {:answer/id #uuid "afd404f7-5f14-545a-b803-72cf14122126" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186331907} {:answer/id #uuid "3d11bde5-fe9f-577e-8c54-8d57e32a660e" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186331908} {:answer/id #uuid "ce5f9fc6-cfab-5ce7-b569-d1d9f524555d" :answer/type {:db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186331909} {:answer/id #uuid "1c9fdb20-278b-5216-b32a-31ea6fe16609" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186331910}] :answer-field/correct {:answer/id #uuid "1c9fdb20-278b-5216-b32a-31ea6fe16609" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186331910} :answer-field/id #uuid "c5c6bff2-4683-5cc4-935b-380fe598f2dd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186331905}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "c840c792-caa3-5fbb-9c2f-31fb5bceb31b" :question/math-academy-id "q-109270" :question/problem "Find $\\,|\\begin{aligned}x & 1 & 10 & 0 \\\\ 2 & y & 0 & 0 \\\\ 5 & 0 & z & 0 \\\\ 0 & 0 & 0 & 3\\end{aligned}|$ given that $\\,|\\begin{aligned}x & 1 & 10 \\\\ 2 & y & 0 \\\\ 5 & 0 & z\\end{aligned}|=8.$" :question/worked-solution "Notice that we have a block diagonal matrix. Therefore, its determinant is equal to the product of the diagonal blocks' determinants:\n\n$$\n\\begin{aligned}|\\begin{aligned}x & 1 & 10 & 0 \\\\ 2 & y & 0 & 0 \\\\ 5 & 0 & z & 0 \\\\ 0 & 0 & 0 & 3\\end{aligned}| & =|\\begin{aligned}x & 1 & 10 & 0 \\\\ 2 & y & 0 & 0 \\\\ 5 & 0 & z & 0 \\\\ 0 & 0 & 0 & 3\\end{aligned}| \\\\  & =|\\begin{aligned}x & 1 & 10 \\\\ 2 & y & 0 \\\\ 5 & 0 & z\\end{aligned}|\\cdot 3 \\\\  & =8\\cdot 3 \\\\  & =24.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186331911 :knowledge-point/_questions [{:knowledge-point/id #uuid "4b507561-8134-50ff-8c23-c4ecc546450d" :knowledge-point/title "Finding the Determinant of a Block Diagonal or Block Triangular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "201e41b8-c958-58d4-9100-53464d277dfe" :answer/type {:db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186331913} {:answer/id #uuid "1aea0905-4d4b-576f-a9dc-d46a6a3c1f15" :answer/type {:db/ident :answer.type/math} :answer/value "-42" :db/id #edb/ref 17592186331914} {:answer/id #uuid "8b8c9222-476e-5562-8fea-1caddedc3112" :answer/type {:db/ident :answer.type/math} :answer/value "-50" :db/id #edb/ref 17592186331915} {:answer/id #uuid "1e35da17-772c-5470-a18f-ff07fae8ec69" :answer/type {:db/ident :answer.type/math} :answer/value "-72" :db/id #edb/ref 17592186331916} {:answer/id #uuid "16d1622e-eea5-5deb-8850-d012c848e27b" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186331917}] :answer-field/correct {:answer/id #uuid "1e35da17-772c-5470-a18f-ff07fae8ec69" :answer/type {:db/ident :answer.type/math} :answer/value "-72" :db/id #edb/ref 17592186331916} :answer-field/id #uuid "7eecb776-cb5c-57a5-9f43-8be4a43a1e93" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186331912}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "2c2a382e-f503-574b-a549-bf0e90a5f0ac" :question/math-academy-id "q-109271" :question/problem "Find $\\,|\\begin{aligned}4 & 0 & 0 & 0 \\\\ 3 & m & b & 0 \\\\ 5 & 0 & n & 0 \\\\ 8 & 0 & 0 & 3\\end{aligned}|$ given that $\\,|\\begin{aligned}m & b \\\\ 0 & n\\end{aligned}|=-6.$" :question/worked-solution "Notice that we have a block lower triangular matrix. Therefore, its determinant is equal to the product of the diagonal blocks' determinants:\n\n$$\n\\begin{aligned}|\\begin{aligned}4 & 0 & 0 & 0 \\\\ 3 & m & b & 0 \\\\ 5 & 0 & n & 0 \\\\ 8 & 0 & 0 & 3\\end{aligned}| & =|\\begin{aligned}4 & 0 & 0 & 0 \\\\ 3 & m & b & 0 \\\\ 5 & 0 & n & 0 \\\\ 8 & 0 & 0 & 3\\end{aligned}| \\\\  & =4\\cdot |\\begin{aligned}m & b \\\\ 0 & n\\end{aligned}|\\cdot 3 \\\\  & =4\\cdot (-6)\\cdot 3 \\\\  & =-72.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186331918 :knowledge-point/_questions [{:knowledge-point/id #uuid "bf19e2ee-7c42-58b0-9254-5a44f315288a" :knowledge-point/title "Identifying Block Diagonal and Block Triangular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11052cdc-ecb7-5fd0-b746-5f952fb4b76d" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186331920} {:answer/id #uuid "7ab36eb7-bc9a-58cd-ace4-ff06b16f4baf" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186331921} {:answer/id #uuid "022f4fc6-9cc5-5f93-baff-0935b0b878eb" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186331922} {:answer/id #uuid "807821dc-9d86-501a-b253-7e405f5b04d3" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186331923} {:answer/id #uuid "96bfab35-6cde-5302-892a-fabb58e99d5a" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186331924}] :answer-field/correct {:answer/id #uuid "022f4fc6-9cc5-5f93-baff-0935b0b878eb" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186331922} :answer-field/id #uuid "c6d0419d-dc10-5a22-b531-cdca2e544ae5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186331919}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "eec165af-6568-52ac-9a03-f75c0a48187a" :question/math-academy-id "q-131460" :question/problem "Which of the following matrices are block diagonal?\n\n$$\nA=[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}],\\,B=[\\begin{aligned}3 & 0 \\\\ 2 & 0\\end{aligned}],\\,C=[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 5 & 0 \\\\ 4 & 5 & 3\\end{aligned}].\n$$" :question/worked-solution "A block diagonal matrix can be partitioned so that it has only square blocks on the main diagonal, and all the other blocks contain only zeros.\n\nWith that in mind, let's examine our matrices.\n\n- $A$ is *not* a block diagonal matrix since it can't be partitioned in the way described above: \n\n$$\n\\begin{aligned}A=[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}],\\,A=[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}],\\,A=[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\n- $B$ is *not* a block diagonal matrix since it can't be partitioned in the way described above:\n\n$$\nB=[\\begin{aligned}2 & 0 \\\\ 3 & 0\\end{aligned}]\n$$\n\n- $C$ is *not* a block diagonal matrix since it can't be partitioned in the way described above: \n\n$$\n\\begin{aligned}C=[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 5 & 0 \\\\ 4 & 5 & 3\\end{aligned}],\\,C=[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 5 & 0 \\\\ 4 & 5 & 3\\end{aligned}],\\,C=[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 5 & 0 \\\\ 4 & 5 & 3\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the correct answer is \"None.\""}] [{:db/id #edb/ref 17592186331925 :knowledge-point/_questions [{:knowledge-point/id #uuid "4b507561-8134-50ff-8c23-c4ecc546450d" :knowledge-point/title "Finding the Determinant of a Block Diagonal or Block Triangular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a62235d0-847e-5c1a-8e18-61b9865ebd5c" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186331927} {:answer/id #uuid "5e9d7fb8-0bfc-5af0-bc8f-7d2384bb6780" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186331928} {:answer/id #uuid "38e94d08-1452-54f2-8eb4-b30799269ce7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{14}{5}" :db/id #edb/ref 17592186331929} {:answer/id #uuid "0cbe6836-8312-5a24-80ac-985f9391eb14" :answer/type {:db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186331930} {:answer/id #uuid "262d2d9e-82b8-5b62-8c8c-24c5c92ccbd5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{25}" :db/id #edb/ref 17592186331931}] :answer-field/correct {:answer/id #uuid "5e9d7fb8-0bfc-5af0-bc8f-7d2384bb6780" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186331928} :answer-field/id #uuid "25fe0424-a371-5e1e-9304-e8cca5dd4cdb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186331926}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "76c9c658-2fd6-5ec3-a58a-e92ba5af1b8b" :question/math-academy-id "q-131654" :question/problem "Find \n$|\\begin{aligned}r & 1 & 0 \\\\ 5 & 3t & 0 \\\\ 0 & 0 & -25\\end{aligned}|$\ngiven that \n$|\\begin{aligned}r & 1 \\\\ 5 & 3t\\end{aligned}|=\\frac{3}{5}.$" :question/worked-solution "Notice that we have a block diagonal matrix. Therefore, its determinant is equal to the product of the diagonal blocks' determinants:\n\n$$\n\\begin{aligned}|\\begin{aligned}r & 1 & 0 \\\\ 5 & 3t & 0 \\\\ 0 & 0 & -25\\end{aligned}| & =|\\begin{aligned}r & 1 & 0 \\\\ 5 & 3t & 0 \\\\ 0 & 0 & -25\\end{aligned}| \\\\  & =|\\begin{aligned}r & 1 \\\\ 5 & 3t\\end{aligned}|\\cdot (-25) \\\\  & =\\frac{3}{5}\\cdot (-25) \\\\  & =-15.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186331932 :knowledge-point/_questions [{:knowledge-point/id #uuid "bf19e2ee-7c42-58b0-9254-5a44f315288a" :knowledge-point/title "Identifying Block Diagonal and Block Triangular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e3a8353-609e-57ad-aabd-e25d8c8559f6" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186331934} {:answer/id #uuid "85c3e857-9898-5a34-aa84-158ca8c0bc54" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186331935} {:answer/id #uuid "66af4ccd-933d-575a-8792-1039a57c8f22" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186331936} {:answer/id #uuid "d4be25d2-f7e4-5be8-8d05-02b66249f8ff" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186331937} {:answer/id #uuid "2406451b-bad8-5164-b2a6-b333d7a0b745" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186331938}] :answer-field/correct {:answer/id #uuid "85c3e857-9898-5a34-aa84-158ca8c0bc54" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186331935} :answer-field/id #uuid "2e356a5c-3085-5b49-9e2c-9e64b09f86e8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186331933}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "574f07f5-afbd-57ae-9eaa-5173f67351a9" :question/math-academy-id "q-42138" :question/problem "Which of the following matrices are block upper triangular?\n\n$$\nA=[\\begin{aligned}2 & 4 & 0 \\\\ 0 & -6 & 5 \\\\ 4 & 0 & 8\\end{aligned}],\\,B=[\\begin{aligned}3 & 0 & 6 \\\\ 2 & 3 & 0 \\\\ 5 & 0 & 9\\end{aligned}],\\,C=[\\begin{aligned}-2 & 0 \\\\ 1 & 1\\end{aligned}].\n$$" :question/worked-solution "A block upper triangular matrix can be partitioned so that it has only square blocks on the main diagonal, and the blocks below the main diagonal contain only zeros.\n\nWith that in mind, let's examine our matrices.\n\n- $A$ is *not* a block upper triangular matrix since it can't be partitioned in the way described above:\n\n$$\n\\begin{aligned}A=[\\begin{aligned}2 & 4 & 0 \\\\ 0 & -6 & 5 \\\\ 4 & 0 & 8\\end{aligned}],\\,A=[\\begin{aligned}2 & 4 & 0 \\\\ 0 & -6 & 5 \\\\ 4 & 0 & 8\\end{aligned}],\\,A=[\\begin{aligned}2 & 4 & 0 \\\\ 0 & -6 & 5 \\\\ 4 & 0 & 8\\end{aligned}]\\end{aligned}\n$$\n\n- $B$ is *not* a block upper triangular matrix since it can't be partitioned in a way described above:\n\n$$\nB=[\\begin{aligned}3 & 0 & 6 \\\\ 2 & 3 & 0 \\\\ 5 & 0 & 9\\end{aligned}],\\,B=[\\begin{aligned}3 & 0 & 6 \\\\ 2 & 3 & 0 \\\\ 5 & 0 & 9\\end{aligned}],\\,B=[\\begin{aligned}3 & 0 & 6 \\\\ 2 & 3 & 0 \\\\ 5 & 0 & 9\\end{aligned}]\n$$\n\n- $C$ is *not* a block upper triangular matrix since it can't be partitioned in a way described above:\n\n$$\nC=[\\begin{aligned}-2 & 0 \\\\ 1 & 1\\end{aligned}]\n$$\n\nTherefore, the correct answer is \"None.\""}]}
