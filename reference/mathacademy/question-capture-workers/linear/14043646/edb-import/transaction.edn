0cd05d-e4af-5bf1-8827-cab48da934f1"] :knowledge-point/questions ["q-94047"] :db/ensure [:knowledge-point/validate]} {:db/id "q-94048/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "82c31d94-bdcd-5548-8149-c15f401c86ff" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-94048/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "d7bdcac7-c9dc-5269-9c78-0058cde749d6" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-94048/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "fb064cde-b7fd-5dcc-8ae0-bdbd6733f840" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-94048/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "592ef240-52b7-536b-9f6b-9818d636310e" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-94048/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "0dcc0127-c77c-5e74-91d2-ba5b9de0d91f" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-94048/selection" :answer-field/id #uuid "6447974d-5a3f-5ab5-a340-30e065d52d26" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-94048/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-94048/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-94048/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-94048/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-94048/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-94048/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answ