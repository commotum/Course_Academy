0a3ac4fe95f021c8f8aece7092270d36ad30c356733db1e628dc4f0b1d434"] :db/ensure [:answer-field/validate]} {:db/id "q-93981" :question/id #uuid "89f0af3e-6ee2-57cd-b64e-9c8bc1644265" :question/math-academy-id "q-93981" :question/problem "Consider the bilinear form $B(x,y),$ given by \n\n$$\nB(x,y)=2{x}_{1}{y}_{2}-4{x}_{2}{y}_{3}+{x}_{3}{y}_{1}-3{x}_{3}{y}_{2}.\n$$\n\n \n\nEvaluate $B(x,y)$ when $x=[\\begin{aligned}-2 \\\\ 2 \\\\ -1\\end{aligned}]$ and $y=[\\begin{aligned}1 \\\\ 0 \\\\ 3\\end{aligned}].$" :question/worked-solution "We are given that \n\n$\\,$ $x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]=[\\begin{aligned}-2 \\\\ 2 \\\\ -1\\end{aligned}]\\,$ and $\\,y=[\\begin{aligned}{y}_{1} \\\\ {y}_{2} \\\\ {y}_{3}\\end{aligned}]=[\\begin{aligned}1 \\\\ 0 \\\\ 3\\end{aligned}].$ \n\nSubstituting these into the bilinear expression, we obtain\n\n$$\n\\begin{aligned}B(x,y) & =2{x}_{1}{y}_{2}-4{x}_{2}{y}_{3}+{x}_{3}{y}_{1}-3{x}_{3}{y}_{2} \\\\  & =2\\cdot (-2)\\cdot 0-4\\cdot 2\\cdot 3+(-1)\\cdot 1-3\\cdot (-1)\\cdot 0 \\\\  & =0-24-1-0 \\\\  & =-25.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-93981/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7083d465-9871-59ca-97fa-583e740e961f"] :knowledge-point/questions ["q-93981"] :db/ensure [:knowledge-point/validate]} {:db/id "q-93976/selection/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd" :answer/id #uuid "dfbe5adf-1b2d-5915-8658-56a1f0c08017" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "q-93976/selection/6d8a7c7e73b503e82ee3fdeaeeda8131c0106d9ecb6a16ba218483b62acd0090" :answer/id #uuid "cd46268c-0b90-5f24-903d-860708d76edd" :answer/type :answer.type/math :answer/value "-18" :db/ensure [:answer/validate]} {:db/id "q-93976/selection/25b335c1798b7b6a4cb13a35c15bf802d740cecd154b47b5e805a756e83b1528" :answer/id #uuid "8ad2c848-10b7-57d6-b841-b844960b8452" :answer/ty