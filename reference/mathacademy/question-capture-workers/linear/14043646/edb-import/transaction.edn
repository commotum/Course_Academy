igned}][\\begin{aligned}1 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}-8 & 9\\end{aligned}][\\begin{aligned}1 \\\\ 4\\end{aligned}] \\\\  & =28.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-93977/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7083d465-9871-59ca-97fa-583e740e961f"] :knowledge-point/questions ["q-93977"] :db/ensure [:knowledge-point/validate]} {:db/id "q-93916/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "99e92b1e-96ab-5e53-b6ed-187d3af47196" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-93916/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "8f649494-8251-5504-9382-0284291bdb57" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-93916/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "a4486117-a0b3-5ca3-83bf-9cc5af3e4c15" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-93916/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "25611bbb-85c8-5465-83a4-c98126065f55" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-93916/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "385ed354-6954-5c24-9628-9dcf52e408d3" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-93916/selection" :answer-field/id #uuid "19c0c8c0-09bf-5a27-9537-224d4ba1845c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-93916/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-93916/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-93916/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-93916/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-93916/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" "q-93916/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-93916" :question/id #uuid "b1017db8-9e30-5331-81ba-2a235c100c98" :question/math-academy-id "q-93916" :question/problem "Consider the bilinear form $B(x,y),$ given by \n\n$$\nB(x,y)={x}_{1}{y}_{1}+{x}_{2}{y}_{1}+2{x}_{1}{y}_{2}+{x}_{2}{y}_{2}.\n$$\n\n \n\nEvaluate $B(x,y)$ when $x=[\\begin{aligned}1 \\\\ 1\\end{aligned}]$ and $y=[\\begin{aligned}3 \\\\ -1\\end{aligned}].$" :question/worked-solution "We are given that \n\n$\\,$ $x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}1 \\\\ 1\\end{aligned}]\\,$ and $\\,y=[\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]=[\\begin{aligned}3 \\\\ -1\\end{aligned}].$\n\nSubstituting these into the bilinear expression, we obtain\n\n$$\n\\begin{aligned}B(x,y) & ={x}_{1}{y}_{1}+{x}_{2}{y}_{1}+2{x}_{1}{y}_{2}+{x}_{2}{y}_{2} \\\\  & =1\\cdot 3+1\\cdot 3+2\\cdot 1\\cdot (-1)+1\\cdot (-1) \\\\  & =3+3-2-1 \\\\  & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-93916/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7083d465-9871-59ca-97fa-583e740e961f"] :knowledge-point/questions ["q-93916"] :db/ensure [:knowledge-point/validate]} {:db/id "q-140863/selection/f89309914f39312811254ea55c1c0920d5845694ccdeaa16d115c7ac90adc10a" :answer/id #uuid "69c06591-8c13-5abb-a691-7d1577382dd8" :answer/type :answer.type/math :answer/value "{x}_{1}{y}_{1}+3{x}_{1}{y}_{2}+3{x}_{2}{y}_{1}+{x}_{2}{y}_{2}" :db/ensure [:answer/validate]} {:db/id "q-140863/selection/466496cc478295f41214debd2baae8b494cb2137106d31473128b999c34154c3" :answer/id #uuid "e6272424-adf3-5b71-b1c2-56d575e0324a" :answer/type :answer.type/math :answer/value "2{x}_{1}{y}_{1}+3{x}_{1}{y}_{2}-3{x}_{2}{y}_{1}+{x}_{2}{y}_{2}" :db/ensure [:answer/validate]} {:db/id "q-140863/selection/683a23a83eefaf1244178cbc000b5d502e45f59fc4bd5983d40a36df1a8cfa41" :answer/id #uuid "7dfc8ed5-fc56-5168-8fa5-6b057bf79db8" :answer/type :answer.type/math :answer/value "{x}_{1}{y}_{1}+3{x}_{1}{y}_{2}-3{x}_{2}{y}_{1}+2{x}_{2}{y}_{2}" :db/ensure [:answer/validate]} {:db/id "q-140863/selection/5ad11b8001798b1c22bdfec52394fb1ff484c6b850cdbd70b6af0cf1454aae85" :answer/id #uuid "e27e2605-5c20-5fc6-87e2-8c0418e0ad74" :answer/type :answer.type/math :answer/value "2{x}_{1}{y}_{1}-3{x}_{1}{y}_{2}+3{x}_{2}{y}_{1}+{x}_{2}{y}_{2}" :db/ensure [:answer/validate]} {:db/id "q-140863/selection/3000d72268b00d2c3b3593c23f698496ce3f734c17da31280c76bbcb1a67a3d4" :answer/id #uuid "cb5104cb-d1ad-52df-a6f8-7deaa56b6653" :answer/type :answer.type/math :answer/value "{x}_{1}{y}_{1}-3{x}_{1}{y}_{2}+3{x}_{2}{y}_{1}+2{x}_{2}{y}_{2}" :db/ensure [:answer/validate]} {:db/id "q-140863/selection" :answer-field/id #uuid "5036ef38-8726-5fc8-9453-2753ce2dc7ff" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-140863/selection/5ad11b8001798b1c22bdfec52394fb1ff484c6b850cdbd70b6af0cf1454aae85" :answer-field/choices ["q-140863/selection/f89309914f39312811254ea55c1c0920d5845694ccdeaa16d115c7ac90adc10a" "q-140863/selection/466496cc478295f41214debd2baae8b494cb2137106d31473128b999c34154c3" "q-140863/selection/683a23a83eefaf1244178cbc000b5d502e45f59fc4bd5983d40a36df1a8cfa41" "q-140863/selection/5ad11b8001798b1c22bdfec52394fb1ff484c6b850cdbd70b6af0cf1454aae85" "q-140863/selection/3000d72268b00d2c3b3593c23f698496ce3f734c17da31280c76bbcb1a67a3d4"] :db/ensure [:answer-field/validate]} {:db/id "q-140863" :question/id #uuid "a9f93327-9194-5e9f-a2c9-bc612bf1c0ad" :question/math-academy-id "q-140863" :question/problem "$$\nA=[\\begin{aligned}2 & \\,\\,-3 \\\\ \\,\\,3 & 1\\end{aligned}]\n$$\n\nConsider the matrix $A$ above. Which of the following represents the corresponding bilinear form ${x}^{T}\\,Ay$ in terms of the components of $x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ and $y=[\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]?$" :question/worked-solution "**Method 1**\n\nEach entry ${a}_{ij}$ of $A$ corresponds to the term ${a}_{ij}{x}_{i}{y}_{j}$ in the expression of the bilinear form:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ay & =2{x}_{1}{y}_{1}+(-3){x}_{1}{y}_{2}+3{x}_{2}{y}_{1}+1{x}_{2}{y}_{2} \\\\  & =2{x}_{1}{y}_{1}-3{x}_{1}{y}_{2}+3{x}_{2}{y}_{1}+{x}_{2}{y}_{2}\\end{aligned}\n$$\n\n**Method 2**\n\nTo write down a bilinear form in terms of vector components, we compute the following expression:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ay & =[\\begin{aligned}{x}_{1} & {x}_{2}\\end{aligned}][\\begin{aligned}2 & \\,\\,-3 \\\\ \\,\\,3 & 1\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{1} & {x}_{2}\\end{aligned}][\\begin{aligned}2{y}_{1}-3{y}_{2} \\\\ 3{y}_{1}+{y}_{2}\\end{aligned}] \\\\  & ={x}_{1}(2{y}_{1}-3{y}_{2})+{x}_{2}(3{y}_{1}+{y}_{2}) \\\\  & =2{x}_{1}{y}_{1}-3{x}_{1}{y}_{2}+3{x}_{2}{y}_{1}+{x}_{2}{y}_{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-140863/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "55277d69-eedc-5c5c-883a-083746e00947"] :knowledge-point/questions ["q-140863"] :db/ensure [:knowledge-point/validate]} {:db/id "q-93984/selection/afb90096b358d8407878f06ffbd6c27af83367c84d903c87e48f2a40de8cd252" :answer/id #uuid "adade753-5dca-5a04-8b86-89d719cd22cc" :answer/type :answer.type/math :answer/value "{x}_{1}{y}_{1}+{x}_{1}{y}_{2}-2{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}" :db/ensure [:answer/validate]} {:db/id "q-93984/selection/f47900beba79b62816a8ad8582df5f0d88531a36dc3bda7c4375f1f44e947971" :answer/id #uuid "f885d499-29c6-5569-a75c-7665c1b88424" :answer/type :answer.type/math :answer/value "-2{x}_{1}{y}_{1}+{x}_{1}{y}_{2}-{x}_{2}