near/14043646/state.json" "file_sha256" "3bb1af243bcecbe13d9c5c8e1e68728963196bf144c2474bc3b9639d91f20687"} {"question" "q-93995" "field" nil "attribute" "question/worked-solution" "value" "**Method 1**\n\nEach entry ${a}_{ij}$ of $A$ corresponds to the term ${a}_{ij}{x}_{i}{y}_{j}$ in the expression of the bilinear form:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ay & =1{x}_{1}{y}_{1}+(-2){x}_{1}{y}_{2}+(-1){x}_{2}{y}_{1}+3{x}_{2}{y}_{2} \\\\  & ={x}_{1}{y}_{1}-2{x}_{1}{y}_{2}-{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}\\end{aligned}\n$$\n\n**Method 2**\n\nTo write down a bilinear form in terms of vector components, we compute the following expression:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ay & =[\\begin{aligned}{x}_{1} & {x}_{2}\\end{aligned}][\\begin{aligned}1 & \\,\\,-2 \\\\ \\,\\,-1 & 3\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{1} & {x}_{2}\\end{aligned}][\\begin{aligned}{y}_{1}-2{y}_{2} \\\\ -{y}_{1}+3{y}_{2}\\end{aligned}] \\\\  & ={x}_{1}({y}_{1}-2{y}_{2})+{x}_{2}(-{y}_{1}+3{y}_{2}) \\\\  & ={x}_{1}{y}_{1}-2{x}_{1}{y}_{2}-{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043646/state.json" "file_sha256" "3bb1af243bcecbe13d9c5c8e1e68728963196bf144c2474bc3b9639d91f20687"} {"question" "q-93995" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043646/activity-metadata.json" "file_sha256" "63ae5446cd981c304159deb63b4bd4953b6eca97263bf349f940f91d83211791"} {"question" "q-93995" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043646/state.json" "file_sha256" "3bb1af243bcecbe13d9c5c8e1e68728963196bf144c2474b