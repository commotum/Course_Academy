245060af"] :db/ensure [:answer-field/validate]} {:db/id "q-282147" :question/id #uuid "559fdfc9-944f-5db4-9235-36c1fd68b65f" :question/math-academy-id "q-282147" :question/problem "Let $a=-4i+3k$ and $b=i+2j-2k.$ Find $a\\times b.$\n\n$a\\times b=$\n\n{{field-1}}$\\,i\\,-\\,$\n{{field-2}}$\\,j\\,-\\,$\n{{field-3}}$\\,k$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ -4 & 0 & 3 \\\\ 1 & 2 & -2\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 3 \\\\ 2 & -2\\end{aligned}|i-|\\begin{aligned}-4 & 3 \\\\ 1 & -2\\end{aligned}|j+|\\begin{aligned}-4 & 0 \\\\ 1 & 2\\end{aligned}|k \\\\  & =(0)(-2)-(3)(2)i-(-4)(-2)-(3)(1)j+(-4)(2)-(0)(1)k \\\\  & =(0-6)i-(8-3)j+(-8-0)k \\\\  & =-6\\,i-5\\,j-8\\,k\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-282147/field-1" "q-282147/field-2" "q-282147/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "733eab11-2a26-5402-8df5-bba50c9beaf9"] :knowledge-point/questions ["q-282147"] :db/ensure [:knowledge-point/validate]} {:db/id "q-77427/selection/b357ffc385038b38af3ee2809685f18bf47871148de3a4819365162b451833ab" :answer/id #uuid "e51be6ff-88ca-52a1-b0ad-255306fa8a2a" :answer/type :answer.type/math :answer/value "x=\\pm \\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-77427/selection/7f44eea92af5c9acdec8919ce008f32aaa724d76d416ab5243173911577f9642" :answer/id #uuid "69682917-4196-5bce-8932-d2047ba4f27f" :answer/type :answer.type/math :answer/value "x=\\pm 3" :db/ensure [:answer/validate]} {:db/id "q-77427/selection/0be40a41fff2075dcd7ae30d0e6284ddf7b2ec7e519882e4636a79e6edbe7cee" :answer/id #uuid "75b4e25f-1030-5b07-89ea-2c0a3d618edc" :answer/type :answer.type/math :answer/value "x=\\pm 2" :db/ensure [:answer/validate]} {:db/id "q-77427/selection/95fc9b70f54ebfab14bd403d9171fa4347035d03ec9ea352c993fd4b3bce585c" :answer/id #uuid "2cb2ab75-866a-5bcb-b308-7f16325a231f" :answer/type :answer.type/math :answer/value "x=\\pm \\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-77427/selection/2d72fb9577d14e692ee0c494e42dfc349f511e1def3de9a4ad7e2ebebd23a09a" :answer/id #uuid "67d14441-a0c9-5061-a93c-e5acee68411f" :answer/type :answer.type/math :answer/value "x=\\pm 4" :db/ensure [:answer/validate]} {:db/id "q-77427/selection" :answer-field/id #uuid "87a9aae2-c040-564a-9d2d-e42640d1113c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-77427/selection/95fc9b70f54ebfab14bd403d9171fa4347035d03ec9ea352c993fd4b3bce585c" :answer-field/choices ["q-77427/selection/b357ffc385038b38af3ee2809685f18bf47871148de3a4819365162b451833ab" "q-77427/selection/7f44eea92af5c9acdec8919ce008f32aaa724d76d416ab5243173911577f9642" "q-77427/selection/0be40a41fff2075dcd7ae30d0e6284ddf7b2ec7e519882e4636a79e6edbe7cee" "q-77427/selection/95fc9b70f54ebfab14bd403d9171fa4347035d03ec9ea352c993fd4b3bce585c" "q-77427/selection/2d72fb9577d14e692ee0c494e42dfc349f511e1def3de9a4ad7e2ebebd23a09a"] :db/ensure [:answer-field/validate]} {:db/id "q-77427" :question/id #uuid "54ac0cd9-756f-56ec-a02b-bc51faafb7b6" :question/math-academy-id "q-77427" :question/problem "Let $a=⟨2,x,1⟩,$ $b=⟨1,-x,3⟩$ and $|\\,a\\times b\\,|=10.$ Find $x.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 2 & x & 1 \\\\ 1 & -x & 3\\end{aligned}| \\\\  & =|\\begin{aligned}x & 1 \\\\ -x & 3\\end{aligned}|i-|\\begin{aligned}2 & 1 \\\\ 1 & 3\\end{aligned}|j+|\\begin{aligned}2 & x \\\\ 1 & -x\\end{aligned}|k \\\\  & =(3x+x)i-(6-1)j+(-2x-x)k \\\\  & =⟨4x,-5,-3x⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{(4x)^{2}+(-5)^{2}+(-3x)^{2}} \\\\  & =\\sqrt{16{x}^{2}+25+9{x}^{2}} \\\\  & =\\sqrt{25({x}^{2}+1)}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =10 \\\\ \\sqrt{25({x}^{2}+1)} & =10 \\\\ 25({x}^{2}+1) & =100 \\\\ {x}^{2}+1 & =4 \\\\ {x}^{2} & =3.\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\pm \\sqrt{3}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-77427/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "21cef8c9-92ff-5527-a837-2236a0c1f9eb"] :knowledge-point/questions ["q-77427"] :db/ensure [:knowledge-point/validate]} {:db/id "q-282270/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "4eb9364a-9cb1-566b-8666-0684d16efb9a" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-282270/field-1" :answer-field/id #uuid "20e34428-29f0-542f-9d60-9a0a2f1e0f43" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-282270/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-282270/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-282270" :question/id #uuid "b0420859-e854-5686-a566-28a8ac19b277" :question/math-academy-id "q-282270" :question/problem "Let $a=⟨x,1,2⟩,$ $b=⟨1,0,2⟩$ and $|\\,a\\times b\\,|=\\sqrt{5}.$ Find $x.$\n\n$\\,x=$\n{{field-1}}" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ x & 1 & 2 \\\\ 1 & 0 & 2\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 2 \\\\ 0 & 2\\end{aligned}|i-|\\begin{aligned}x & 2 \\\\ 1 & 2\\end{aligned}|j+|\\begin{aligned}x & 1 \\\\ 1 & 0\\end{aligned}|k \\\\  & =(2-0)i-(2x-2)j+(0-1)k \\\\  & =⟨2,2-2x,-1⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{{2}^{2}+(2-2x)^{2}+(-1)^{2}} \\\\  & =\\sqrt{4+(4{x}^{2}-8x+4)+1} \\\\  & =\\sqrt{4{x}^{2}-8x+9}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{5} \\\\ \\sqrt{4{x}^{2}-8x+9} & =\\sqrt{5} \\\\ 4{x}^{2}-8x+9 & =5 \\\\ 4{x}^{2}-8x+4 & =0 \\\\ (2x-2)^{2} & =0 \\\\ 2x-2 & =0 \\\\ x & =1\\end{aligned}\n$$\n\nTherefore, the solution is $x=1.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-282270/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "21cef8c9-92ff-5527-a837-2236a0c1f9eb"] :knowledge-point/questions ["q-282270"] :db/ensure [:knowledge-point/validate]} {:db/id "q-282278/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "7dcb1cbd-94dd-5ec7-a370-51627c867ef2" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-282278/field-1" :answer-field/id #uuid "bcb4ef77-6cb3-5d3f-b4c1-653cc0729217" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-282278/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-282278/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-282278/field-2/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "4dee8668-d5bd-5bbb-8e15-abc9e8c4f1ee" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-282278/field-2" :answer-field/id #uuid "0b2f2c49-3c37-5b34-953e-85c4bdac5471" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-282278/field-2/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-282278/field-2/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-282278" :question/id #uuid "077d8348-aacc-5cfe-9c4f-83cd2cce459b" :question/math-academy-id "q-282278" :question/problem "Let $a=⟨2x,1,4⟩,$ $b=⟨3,0,2⟩$ and $|\\,a\\times b\\,|=\\sqrt{157}.$ Then, in **ascending order**, the possible values of $x$ are\n\n$\\,x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 2x & 1 & 4 \\\\ 3 & 0 & 2\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 4 \\\\ 0 & 2\\end{aligned}|i-|\\begin{aligned}2x & 4 \\\\ 3 & 2\\end{aligned}|j+|\\begin{aligned}2x & 1 \\\\ 3 & 0\\end{aligned}|k \\\\  & =(2-0)i-(4x-12)j+(0-3)k \\\\  & =⟨2,12-4x,-3⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{{2}^{2}+(12-4x)^{2}+(-3)^{2}} \\\\  & =\\sqrt{4+(144-96x+16{x}^{2})+9} \\\\  & =\\sqrt{16{x}^{2}-96x+157}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{157} \\\\ \\sqrt{16{x}^{2}-96x+157} & =\\sqrt{157} \\\\ 16{x}^{2}-96x+157 & =157 \\\\ 16{x}^{2}-96x & =0 \\\\ 16x(x-6) & =0 \\\\ x & =0,\\,x=6\\end{aligned}\n$$\n\nTherefore, in ascending order, the solutions are $x=0,$ $x=6.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-282278/field-1" "q-282278/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "21cef8c9-92ff-5527-a837-2236a0c1f9eb"] :knowledge-point/questions ["q-282278"] :db/ensure [:knowledge-point/validate]}]
