/correct "q-282144/field-3/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer-field/choices ["q-282144/field-3/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc"] :db/ensure [:answer-field/validate]} {:db/id "q-282144" :question/id #uuid "d3d339cf-a2da-5b23-8253-57bcf9590e44" :question/math-academy-id "q-282144" :question/problem "Let $a=i+2j-5k$ and $b=-3i+4j+k.$ Find $a\\times b.$\n\n$a\\times b=$\n\n{{field-1}}$\\,i\\,+\\,$\n{{field-2}}$\\,j\\,+\\,$\n{{field-3}}$\\,k$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 1 & 2 & -5 \\\\ -3 & 4 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}2 & -5 \\\\ 4 & 1\\end{aligned}|i-|\\begin{aligned}1 & -5 \\\\ -3 & 1\\end{aligned}|j+|\\begin{aligned}1 & 2 \\\\ -3 & 4\\end{aligned}|k \\\\  & =(2\\cdot 1-(-5)(4))i-(1\\cdot 1-(-5)(-3))j+(1\\cdot 4-2\\cdot (-3))k \\\\  & =(2+20)i-(1-15)j+(4+6)k \\\\  & =22\\,i+14\\,j+10\\,k\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-282144/field-1" "q-282144/field-2" "q-282144/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "733eab11-2a26-5402-8df5-bba50c9beaf9"] :knowledge-point/questions ["q-282144"] :db/ensure [:knowledge-point/validate]} {:db/id "q-1396/selection/c70cbb7824dbaab0f4a5652f3d48aa7ce86785c6cbce87453dc5c5e4a455feac" :answer/id #uuid "0cef887d-ea75-5f48-ba74-3864a6efb0ca" :answer/type :answer.type/math :answer/value "2j+4k" :db/ensure [:answer/validate]} {:db/id "q-1396/selection/1d472aa944e15624e04563574fb8a79c1d51db6b9b1c7cca90e46adc8048adc3" :answer/id #uuid "2a4212f4-d006-5297-af36-1a524a7e0e1a" :answer/type :answer.type/math :answer/value "-2j+3k" :db/ensure [:answer/validate]} {:db/id "q-1396/selection/e1dccbd8368ab2d7dc50d5bfaa900bcc993f4bdd2819d460ec0b4616fe1540c1" :answer/id #uuid "0e02933d-8cdf-58b3-af7a-0425474c7883" :answer/type :answer.type/math :answer/value "3i+2j-4k" 