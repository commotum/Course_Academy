452cc8e27" "basis" 1376 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039715/edb-import/verification.json"} {"question" "q-103540" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "x=\\pm 4"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039715/state.json" "file_sha256" "bf2af88b78c0f972594e3b8650f252763c7c3809d8ad4c0c602d226452cc8e27" "basis" 1376 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039715/edb-import/verification.json"} {"question" "e-4341" "field" nil "attribute" "question/problem" "value" "Let $\\mathbf{a}=\\langle 3,-4,1 \\rangle$ and $\\mathbf{b}=\\langle -7,0,2 \\rangle.$ Find $\\mathbf{a} \\times \\mathbf{b}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039715/example-4341.json" "file_sha256" "5b668d7430ddd4c028760aa614195673a81303fedb7034b9cb195a85b17410e3" "basis" 1376 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039715/edb-import/verification.json"} {"question" "e-4341" "field" nil "attribute" "question/worked-solution" "value" "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 3 & -4 & 1 \\\\ -7 & 0 & 2\\end{aligned}| \\\\  & =|\\begin{aligned}-4 & 1 \\\\ 0 & 2\\end{aligned}|i-|\\begin{aligned}3 & 1 \\\\ -7 & 2\\end{aligned}|j+|\\begin{aligned}3 & -4 \\\\ -7 & 0\\end{aligned}|k \\\\  & =((-4)\\cdot 2-1\\cdot 0)i-(3\\cdot 2-1\\cdot (-7))j+(3\\cdot 0-(-4)\\cdot (-7))k \\\\  & =-8i-13j-28k \\\\  & =⟨-8,-13,-28⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039715/example-4341.json" "file_sha256" "5b668d7430ddd4c028760aa614195673a81303fedb7034b9cb195a85b17410e3" "basis" 1376 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039715/edb-import/verification.json"} {"question" "e-4343" "field" nil "attribute" "question/problem" "value" "Let $\\mathbf{a}=\\langle 3, 1, 2x \\rangle,$ $\\mathbf{b}=\\langle 0,1,x \\rangle,$ and $|\\,\\mathbf{a} \\times \\mathbf{b}\\,| = \\sqrt{19}.$ Find $x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039715/example-4343.json" "file_sha256" "5b1ad67bf4163862d73eb7ca033ee82505799922d4112761bee1e65679443669" "basis" 1376 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039715/edb-import/verification.json"} {"question" "e-4343" "field" nil "attribute" "question/worked-solution" "value" "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 3 & 1 & 2x \\\\ 0 & 1 & x\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 2x \\\\ 1 & x\\end{aligned}|i-|\\begin{aligned}3 & 2x \\\\ 0 & x\\end{aligned}|j+|\\begin{aligned}3 & 1 \\\\ 0 & 1\\end{aligned}|k \\\\  & =-xi-3xj+3k \\\\  & =⟨-x,-3x,3⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{(-x)^{2}+(-3x)^{2}+{3}^{2}} \\\\  & =\\sqrt{10{x}^{2}+9}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned} & |\\,a\\times b\\,|=\\sqrt{19} \\\\  & \\sqrt{10{x}^{2}+9}=\\sqrt{19} \\\\  & 10{x}^{2}+9=19 \\\\  & 10{x}^{2}=10 \\\\  & {x}^{2}=1\\end{aligned}\n$$\n\nTherefore, the solutions are $x= \\pm 1.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039715/example-4343.json" "file_sha256" "5b1ad67bf4163862d73eb7ca033ee82505799922d4112761bee1e65679443669" "basis" 1376 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039715/edb-import/verification.json"}] "sources" [{"question" "q-282144" "field" nil "attribute" "question/problem" "value" "Let $a=i+2j-5k$ and $b=-3i+4j+k.$ Find $a\\times b.$\n\n$a\\times b=$\n\n{{field-1}}$\\,i\\,+\\,$\n{{field-2}}$\\,j\\,+\\,$\n{{field-3}}$\\,k$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039806/state.json" "file_sha256" "d10a27fa6c765bdbd17de87aa5782ab7f7ad7c81a6a74734775fb7382088e395"} {"question" "q-282144" "field" nil "attribute" "question/worked-solution" "value" "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 1 & 2 & -5 \\\\ -3 & 4 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}2 & -5 \\\\ 4 & 1\\end{aligned}|i-|\\begin{aligned}1 & -5 \\\\ -3 & 1\\end{aligned}|j+|\\begin{aligned}1 & 2 \\\\ -3 & 4\\end{aligned}|k \\\\  & =(2\\cdot 1-(-5)(4))i-(1\\cdot 1-(-5)(-3))j+(1\\cdot 4-2\\cdot (-3))k \\\\  & =(2+20)i-(1-15)j+(4+6)k \\\\  & =22\\,i+14\\,j+10\\,k\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039806/state.json" "file_sha256" "d10a27fa6c765bdbd17de87aa5782ab7f7ad7c81a6a74734775fb7382088e395"} {"question" "q-282144" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039806/activity-metadata.json" "file_sha256" "2b0550090cc26f93266a7b0f166dd854d1a1cbe6f6ecc0508c6c1b68bfd5def3"} {"question" "q-282144" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039806/state.json" "file_sha256" "d10a27fa6c765bdbd17de87aa5782ab7f7ad7c81a6a74734775fb7382088e395"} {"question" "q-282144" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "22"] "category" "model_interpretation" "file" "/home/jake/Developer/