field-3}}$\\,k$" 13194139534698 true] [17592186304169 1113 #uuid "559fdfc9-944f-5db4-9235-36c1fd68b65f" 13194139534698 true] [17592186304169 1145 "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ -4 & 0 & 3 \\\\ 1 & 2 & -2\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 3 \\\\ 2 & -2\\end{aligned}|i-|\\begin{aligned}-4 & 3 \\\\ 1 & -2\\end{aligned}|j+|\\begin{aligned}-4 & 0 \\\\ 1 & 2\\end{aligned}|k \\\\  & =(0)(-2)-(3)(2)i-(-4)(-2)-(3)(1)j+(-4)(2)-(0)(1)k \\\\  & =(0-6)i-(8-3)j+(-8-0)k \\\\  & =-6\\,i-5\\,j-8\\,k\\end{aligned}\n$$" 13194139534698 true] [17592186304170 1000 #edb/ref 17592186304171 13194139534698 true] [17592186304170 1040 #edb/ref 17592186045449 13194139534698 true] [17592186304170 1041 "field-1" 13194139534698 true] [17592186304170 1104 #edb/ref 17592186304171 13194139534698 true] [17592186304170 1110 #uuid "8dff6861-99c2-56b4-94af-885cf23fcb7d" 13194139534698 true] [17592186304171 1034 "-6" 13194139534698 true] [17592186304171 1103 #edb/ref 17592186045453 13194139534698 true] [17592186304171 1111 #uuid "2f1cd693-fca6-54e3-974c-371441de532f" 13194139534698 true] [17592186304172 1000 #edb/ref 17592186304173 13194139534698 true] [17592186304172 1040 #edb/ref 17592186045449 13194139534698 true] [17592186304172 1041 "field-2" 13194139534698 true] [17592186304172 1104 #edb/ref 17592186304173 13194139534698 true] [17592186304172 1110 #uuid "1fd7069e-5621-5dd1-a4f7-e1d72aaf77ab" 13194139534698 true] [17592186304173 1034 "5" 13194139534698 true] [17592186304173 1103 #edb/ref 17592186045453 13194139534698 true] [17592186304173 1111 #uuid "68bd3100-7410-5a36-825a-6fee38785970" 13194139534698 true] [17592186304174 1000 #edb/ref 17592186304175 13194139534698 true] [17592186304174 1040 #edb/ref 17592186045449 13194139534698 true] [17592186304174 1041 "field-3" 13194139534698 true] [17592186304174 1104 #edb/ref 17592186304175 13194139534698 true] [17592186304174 1110 #uuid "035c933d-742f-5388-803f-c7a7c2cb7