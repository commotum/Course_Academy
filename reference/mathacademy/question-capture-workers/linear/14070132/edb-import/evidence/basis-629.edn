#{[{:db/id #edb/ref 17592186267477 :knowledge-point/_questions [{:knowledge-point/id #uuid "f88c1deb-cd11-5b68-b90b-2d8edfae2469" :knowledge-point/title "Determining the Equation of a Wide Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22d5c9d1-3c82-5af9-aae2-bff5ea543677" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{1}=1" :db/id #edb/ref 17592186267479} {:answer/id #uuid "1ac19654-e9cf-5cbc-ad79-5e17c5cf6676" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{3}+\\frac{{y}^{2}}{1}=1" :db/id #edb/ref 17592186267480} {:answer/id #uuid "0e30b6dc-9b27-56f4-bac6-239acae40580" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{1}=1" :db/id #edb/ref 17592186267481} {:answer/id #uuid "384e03ef-b31d-57fa-a817-8e57e5fc9381" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{1}+\\frac{{y}^{2}}{3}=1" :db/id #edb/ref 17592186267482} {:answer/id #uuid "1e277316-bfd8-578b-903a-06f63e69e1a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{1}+\\frac{{y}^{2}}{9}=1" :db/id #edb/ref 17592186267483}] :answer-field/correct {:answer/id #uuid "22d5c9d1-3c82-5af9-aae2-bff5ea543677" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{1}=1" :db/id #edb/ref 17592186267479} :answer-field/id #uuid "8980ee0c-1a37-52e1-82df-a8bf77fa947e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186267478}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b66b9a52-af69-562e-9a8f-594e2cdd513a" :question/math-academy-id "q-69891" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13957964/assets/9eb144bd4109846f3e1af4fb7d8ed70d2d8a29c3804547b89238d6437c4258d8.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=3$ and the vertical radius has length $b=1.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{3}^{2}}+\\frac{{y}^{2}}{{1}^{2}} & =1 \\\\ \\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{1} & =1.\\end{aligned}\n$$"}]}
