[{:db/id [:question/math-academy-id "q-69891"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070132/assets/9eb144bd4109846f3e1af4fb7d8ed70d2d8a29c3804547b89238d6437c4258d8.png)\n\nWhat is the equation of the ellipse given above?" :db/ensure [:question/validate]} {:db/id "q-115123/selection/ab288c8a5e845bfb1d1eacff333b4ce62c2bff8fbd185918ecf131dd5fcf72a1" :answer/id #uuid "dea83d81-e948-57e3-a0f8-1e1f9ac687c2" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{9}=1" :db/ensure [:answer/validate]} {:db/id "q-115123/selection/24f3dbe0eca24efe024dbbccb7e4d709fa4263d1ba3dab136fe8272b18a6a786" :answer/id #uuid "1512ece0-a9c1-5bae-b1f2-afef6e9f4cf7" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{6}=1" :db/ensure [:answer/validate]} {:db/id "q-115123/selection/ad8dbf8892a37334c0019e2062d2abd041ebc72bea23d06f73e6d7b9f66ccd68" :answer/id #uuid "72da50c1-7502-5351-86b8-5cbbb4537590" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{12}+\\frac{{y}^{2}}{18}=1" :db/ensure [:answer/validate]} {:db/id "q-115123/selection/e053ce1c3049b6dcf6c2fe5fc181e1191c163bd661ae8585b1d1ae37eaf6e19d" :answer/id #uuid "1457c0d2-1c2e-50a1-ad13-2880e39582b3" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{36}+\\frac{{y}^{2}}{81}=1" :db/ensure [:answer/validate]} {:db/id "q-115123/selection/3e1b9bbb008493e1acc01324701cac4a2fc94f100f50443482e7556322783d63" :answer/id #uuid "3293eccf-5cd3-5b27-86c2-226988291e89" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{81}+\\frac{{y}^{2}}{36}=1" :db/ensure [:answer/validate]} {:db/id "q-115123/selection" :answer-field/id #uuid "fd2aa91b-4df7-5628-9c65-62379e3f06f7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-115123/selection/e053ce1c3049b6dcf6c2fe5fc181e1191c163bd661ae8585b1d1ae37eaf6e19d" :answer-field/choices ["q-115123/selection/ab288c8a5e845bfb1d1eacff333b4ce62c2bff8fbd185918ecf131dd5fcf72a1" "q-115123/selection/24f3dbe0eca24efe024dbbccb7e4d709fa4263d1ba3dab136fe8272b18a6a786" "q-115123/selection/ad8dbf8892a37334c0019e2062d2abd041ebc72bea23d06f73e6d7b9f66ccd68" "q-115123/selection/e053ce1c3049b6dcf6c2fe5fc181e1191c163bd661ae8585b1d1ae37eaf6e19d" "q-115123/selection/3e1b9bbb008493e1acc01324701cac4a2fc94f100f50443482e7556322783d63"] :db/ensure [:answer-field/validate]} {:db/id "q-115123" :question/id #uuid "c69dff1c-a5ba-53c2-989b-006201408b4d" :question/math-academy-id "q-115123" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070132/assets/cf20c8dba07a1c6c2e6e6a95fbe45675301e734c976b8073d67ff4bd2cb21ad6.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=6$ and the vertical radius has length $b=9.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{6}^{2}}+\\frac{{y}^{2}}{{9}^{2}} & =1 \\\\ \\frac{{x}^{2}}{36}+\\frac{{y}^{2}}{81} & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-115123/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "de557d1d-5f27-50e3-bcba-22b21f83267f"] :knowledge-point/questions ["q-115123"] :db/ensure [:knowledge-point/validate]} {:db/id "q-115126/selection/f0d1b8e2d94d42893876df346780be6d9300a55183a5aa212346af1931a128d9" :answer/id #uuid "1782cb89-49ac-5893-b826-4e3938195508" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{16}=1" :db/ensure [:answer/validate]} {:db/id "q-115126/selection/4e9c5c1d1bddddadf47f214cc68ac8f59cc4037bca14c304e61ca2ad12557ffb" :answer/id #uuid "34f7a8b8-7445-5d61-a632-1dedf774f1ac" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{8}+\\frac{{y}^{2}}{3}=1" :db/ensure [:answer/validate]} {:db/id "q-115126/selection/72cd6e0e31761524f043f96c9ca2398f6384aa63e6530423e748410ad5ae76b1" :answer/id #uuid "3a673213-c561-522a-9ea5-702a6e8cbaf9" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{64}=1" :db/ensure [:answer/validate]} {:db/id "q-115126/selection/46e020e4aa422ce47c2f0bd1b722c927899b7d530828c3438966d3dd6b4c7f3c" :answer/id #uuid "85682cd0-5e6c-5199-9c57-cb3f21c259ee" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{64}+\\frac{{y}^{2}}{9}=1" :db/ensure [:answer/validate]} {:db/id "q-115126/selection/e102bca2fd1caaac3da9afac7037f2561c6087bceb9e73669eec3d80c6bab18d" :answer/id #uuid "36ba98cd-3a06-59be-900d-e64e25128b00" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{3}+\\frac{{y}^{2}}{8}=1" :db/ensure [:answer/validate]} {:db/id "q-115126/selection" :answer-field/id #uuid "52848333-0b51-503d-8868-b4dd505f9a57" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-115126/selection/72cd6e0e31761524f043f96c9ca2398f6384aa63e6530423e748410ad5ae76b1" :answer-field/choices ["q-115126/selection/f0d1b8e2d94d42893876df346780be6d9300a55183a5aa212346af1931a128d9" "q-115126/selection/4e9c5c1d1bddddadf47f214cc68ac8f59cc4037bca14c304e61ca2ad12557ffb" "q-115126/selection/72cd6e0e31761524f043f96c9ca2398f6384aa63e6530423e748410ad5ae76b1" "q-115126/selection/46e020e4aa422ce47c2f0bd1b722c927899b7d530828c3438966d3dd6b4c7f3c" "q-115126/selection/e102bca2fd1caaac3da9afac7037f2561c6087bceb9e73669eec3d80c6bab18d"] :db/ensure [:answer-field/validate]} {:db/id "q-115126" :question/id #uuid "62d2842f-7917-53d8-97ff-d96695ace99c" :question/math-academy-id "q-115126" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070132/assets/62b62eb01c13ad4eef0367999445402d5a39710b7cfb2df11813b2bfcddb4b9c.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=3$ and the vertical radius has length $b=8.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{3}^{2}}+\\frac{{y}^{2}}{{8}^{2}} & =1 \\\\ \\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{64} & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-115126/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "de557d1d-5f27-50e3-bcba-22b21f83267f"] :knowledge-point/questions ["q-115126"] :db/ensure [:knowledge-point/validate]} {:db/id "q-277923/field-1/e326a281f601aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666" :answer/id #uuid "173d5454-ac84-5d48-afe0-50162151c129" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "q-277923/field-1" :answer-field/id #uuid "07ae303a-1806-59e4-862b-f4d90cb6dee5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-277923/field-1/e326a281f601aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666" :answer-field/choices ["q-277923/field-1/e326a281f601aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666"] :db/ensure [:answer-field/validate]} {:db/id "q-277923/field-2/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c" :answer/id #uuid "a3270874-4ab8-5eaf-b598-df9759447931" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "q-277923/field-2" :answer-field/id #uuid "afb398b0-621b-5f27-85ba-fcb70b84b070" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-277923/field-2/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c" :answer-field/choices ["q-277923/field-2/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c"] :db/ensure [:answer-field/validate]} {:db/id "q-277923" :question/id #uuid "58419e3c-9645-543f-9c76-e916568be027" :question/math-academy-id "q-277923" :question/problem "For the ellipse \n$\\frac{{x}^{2}}{64}+\\frac{{y}^{2}}{81}=1,$ find the lengths of its major and minor axes.\n\n$\\,$ The length of the major axis is \n{{field-1}}.\n\n$\\,$ The length of the minor axis is \n{{field-2}}." :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have ${a}^{2}=64$ and ${b}^{2}=81.$\n\n- Since ${a}^{2}=64,$ the length of the horizontal radius must be $a=\\sqrt{64}=8.$\n\n- Since ${b}^{2}=81,$ the length of the vertical radius must be $b=\\sqrt{81}=9.$\n\nThus, the semi-major axis has length $b=9,$ and the semi-minor axis has length $a=8.$\n\nTherefore, the major axis has length $2b=2\\cdot 9=18,$ and the minor axis has length $2a=2\\cdot 8=16.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-277923/field-1" "q-277923/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4e43e393-8752-58bc-b87c-b72f679cbfd9"] :knowledge-point/questions ["q-277923"] :db/ensure [:knowledge-point/validate]} {:db/id "q-279197/field-1/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" :answer/id #uuid "eb91877a-ccf5-5658-b78b-406e5f542824" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "q-279197/field-1" :answer-field/id #uuid "547840e5-e2c6-55cc-a546-f0b5a4fef4b8" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-279197/field-1/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" :answer-field/choices ["q-279197/field-1/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a"] :db/ensure [:answer-field/validate]} {:db/id "q-279197/field-2/d79808b1304c1856f3712e6e226ade34c7caf51f0407b91d3e2447e1f8a47743" :answer/id #uuid "41ed2d11-31c8-546a-8a9b-52397f12bb38" :answer/type :answer.type/math :answer/value "4\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-279197/field-2" :answer-field/id #uuid "c2fa5e92-fa08-5fa9-a344-01e05204d764" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-279197/field-2/d79808b1304c1856f3712e6e226ade34c7caf51f0407b91d3e2447e1f8a47743" :answer-field/choices ["q-279197/field-2/d79808b1304c1856f3712e6e226ade34c7caf51f0407b91d3e2447e1f8a47743"] :db/ensure [:answer-field/validate]} {:db/id "q-279197" :question/id #uuid "f61c15c3-c5e4-51d0-92b3-8d15a9693b10" :question/math-academy-id "q-279197" :question/problem "For the ellipse $\\frac{{x}^{2}}{12}+\\frac{{y}^{2}}{49}=1,$ find the lengths of its major and minor axes.\n\n$\\,$ The length of the major axis is \n{{field-1}}.\n\n$\\,$ The length of the minor axis is \n{{field-2}}." :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have ${a}^{2}=12$ and ${b}^{2}=49.$\n\n- Since ${a}^{2}=12,$ the length of the horizontal radius must be $a=\\sqrt{12}=2\\sqrt{3}.$\n\n- Since ${b}^{2}=49,$ the length of the vertical radius must be $b=\\sqrt{49}=7.$\n\nThus, the semi-major axis has length $b=7,$ and the semi-minor axis has length $a=2\\sqrt{3}.$\n\nTherefore, the major axis has length $2b=2\\cdot 7=14,$ and the minor axis has length $2a=2\\cdot 2\\sqrt{3}=4\\sqrt{3}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-279197/field-1" "q-279197/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4e43e393-8752-58bc-b87c-b72f679cbfd9"] :knowledge-point/questions ["q-279197"] :db/ensure [:knowledge-point/validate]}]
