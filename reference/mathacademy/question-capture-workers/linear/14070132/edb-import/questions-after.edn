#{[{:db/id #edb/ref 17592186364897 :knowledge-point/_questions [{:knowledge-point/id #uuid "de557d1d-5f27-50e3-bcba-22b21f83267f" :knowledge-point/title "Determining the Equation of a Tall Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1512ece0-a9c1-5bae-b1f2-afef6e9f4cf7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{6}=1" :db/id #edb/ref 17592186364899} {:answer/id #uuid "3293eccf-5cd3-5b27-86c2-226988291e89" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{81}+\\frac{{y}^{2}}{36}=1" :db/id #edb/ref 17592186364900} {:answer/id #uuid "dea83d81-e948-57e3-a0f8-1e1f9ac687c2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{9}=1" :db/id #edb/ref 17592186364901} {:answer/id #uuid "72da50c1-7502-5351-86b8-5cbbb4537590" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{12}+\\frac{{y}^{2}}{18}=1" :db/id #edb/ref 17592186364902} {:answer/id #uuid "1457c0d2-1c2e-50a1-ad13-2880e39582b3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{36}+\\frac{{y}^{2}}{81}=1" :db/id #edb/ref 17592186364903}] :answer-field/correct {:answer/id #uuid "1457c0d2-1c2e-50a1-ad13-2880e39582b3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{36}+\\frac{{y}^{2}}{81}=1" :db/id #edb/ref 17592186364903} :answer-field/id #uuid "fd2aa91b-4df7-5628-9c65-62379e3f06f7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364898}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c69dff1c-a5ba-53c2-989b-006201408b4d" :question/math-academy-id "q-115123" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070132/assets/cf20c8dba07a1c6c2e6e6a95fbe45675301e734c976b8073d67ff4bd2cb21ad6.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=6$ and the vertical radius has length $b=9.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{6}^{2}}+\\frac{{y}^{2}}{{9}^{2}} & =1 \\\\ \\frac{{x}^{2}}{36}+\\frac{{y}^{2}}{81} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186364904 :knowledge-point/_questions [{:knowledge-point/id #uuid "de557d1d-5f27-50e3-bcba-22b21f83267f" :knowledge-point/title "Determining the Equation of a Tall Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85682cd0-5e6c-5199-9c57-cb3f21c259ee" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{64}+\\frac{{y}^{2}}{9}=1" :db/id #edb/ref 17592186364906} {:answer/id #uuid "34f7a8b8-7445-5d61-a632-1dedf774f1ac" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{8}+\\frac{{y}^{2}}{3}=1" :db/id #edb/ref 17592186364907} {:answer/id #uuid "3a673213-c561-522a-9ea5-702a6e8cbaf9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{64}=1" :db/id #edb/ref 17592186364908} {:answer/id #uuid "36ba98cd-3a06-59be-900d-e64e25128b00" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{3}+\\frac{{y}^{2}}{8}=1" :db/id #edb/ref 17592186364909} {:answer/id #uuid "1782cb89-49ac-5893-b826-4e3938195508" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{16}=1" :db/id #edb/ref 17592186364910}] :answer-field/correct {:answer/id #uuid "3a673213-c561-522a-9ea5-702a6e8cbaf9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{64}=1" :db/id #edb/ref 17592186364908} :answer-field/id #uuid "52848333-0b51-503d-8868-b4dd505f9a57" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364905}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "62d2842f-7917-53d8-97ff-d96695ace99c" :question/math-academy-id "q-115126" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070132/assets/62b62eb01c13ad4eef0367999445402d5a39710b7cfb2df11813b2bfcddb4b9c.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=3$ and the vertical radius has length $b=8.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{3}^{2}}+\\frac{{y}^{2}}{{8}^{2}} & =1 \\\\ \\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{64} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186364911 :knowledge-point/_questions [{:knowledge-point/id #uuid "4e43e393-8752-58bc-b87c-b72f679cbfd9" :knowledge-point/title "Determining the Lengths of the Major and Minor Axes Given the Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "173d5454-ac84-5d48-afe0-50162151c129" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186364913}] :answer-field/correct {:answer/id #uuid "173d5454-ac84-5d48-afe0-50162151c129" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186364913} :answer-field/id #uuid "07ae303a-1806-59e4-862b-f4d90cb6dee5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186364912} {:answer-field/choices [{:answer/id #uuid "a3270874-4ab8-5eaf-b598-df9759447931" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186364915}] :answer-field/correct {:answer/id #uuid "a3270874-4ab8-5eaf-b598-df9759447931" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186364915} :answer-field/id #uuid "afb398b0-621b-5f27-85ba-fcb70b84b070" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186364914}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "58419e3c-9645-543f-9c76-e916568be027" :question/math-academy-id "q-277923" :question/problem "For the ellipse \n$\\frac{{x}^{2}}{64}+\\frac{{y}^{2}}{81}=1,$ find the lengths of its major and minor axes.\n\n$\\,$ The length of the major axis is \n{{field-1}}.\n\n$\\,$ The length of the minor axis is \n{{field-2}}." :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have ${a}^{2}=64$ and ${b}^{2}=81.$\n\n- Since ${a}^{2}=64,$ the length of the horizontal radius must be $a=\\sqrt{64}=8.$\n\n- Since ${b}^{2}=81,$ the length of the vertical radius must be $b=\\sqrt{81}=9.$\n\nThus, the semi-major axis has length $b=9,$ and the semi-minor axis has length $a=8.$\n\nTherefore, the major axis has length $2b=2\\cdot 9=18,$ and the minor axis has length $2a=2\\cdot 8=16.$"}] [{:db/id #edb/ref 17592186364916 :knowledge-point/_questions [{:knowledge-point/id #uuid "4e43e393-8752-58bc-b87c-b72f679cbfd9" :knowledge-point/title "Determining the Lengths of the Major and Minor Axes Given the Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb91877a-ccf5-5658-b78b-406e5f542824" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186364918}] :answer-field/correct {:answer/id #uuid "eb91877a-ccf5-5658-b78b-406e5f542824" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186364918} :answer-field/id #uuid "547840e5-e2c6-55cc-a546-f0b5a4fef4b8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186364917} {:answer-field/choices [{:answer/id #uuid "41ed2d11-31c8-546a-8a9b-52397f12bb38" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{3}" :db/id #edb/ref 17592186364920}] :answer-field/correct {:answer/id #uuid "41ed2d11-31c8-546a-8a9b-52397f12bb38" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{3}" :db/id #edb/ref 17592186364920} :answer-field/id #uuid "c2fa5e92-fa08-5fa9-a344-01e05204d764" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186364919}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f61c15c3-c5e4-51d0-92b3-8d15a9693b10" :question/math-academy-id "q-279197" :question/problem "For the ellipse $\\frac{{x}^{2}}{12}+\\frac{{y}^{2}}{49}=1,$ find the lengths of its major and minor axes.\n\n$\\,$ The length of the major axis is \n{{field-1}}.\n\n$\\,$ The length of the minor axis is \n{{field-2}}." :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have ${a}^{2}=12$ and ${b}^{2}=49.$\n\n- Since ${a}^{2}=12,$ the length of the horizontal radius must be $a=\\sqrt{12}=2\\sqrt{3}.$\n\n- Since ${b}^{2}=49,$ the length of the vertical radius must be $b=\\sqrt{49}=7.$\n\nThus, the semi-major axis has length $b=7,$ and the semi-minor axis has length $a=2\\sqrt{3}.$\n\nTherefore, the major axis has length $2b=2\\cdot 7=14,$ and the minor axis has length $2a=2\\cdot 2\\sqrt{3}=4\\sqrt{3}.$"}] [{:db/id #edb/ref 17592186267477 :knowledge-point/_questions [{:knowledge-point/id #uuid "f88c1deb-cd11-5b68-b90b-2d8edfae2469" :knowledge-point/title "Determining the Equation of a Wide Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22d5c9d1-3c82-5af9-aae2-bff5ea543677" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{1}=1" :db/id #edb/ref 17592186267479} {:answer/id #uuid "1ac19654-e9cf-5cbc-ad79-5e17c5cf6676" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{3}+\\frac{{y}^{2}}{1}=1" :db/id #edb/ref 17592186267480} {:answer/id #uuid "0e30b6dc-9b27-56f4-bac6-239acae40580" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{1}=1" :db/id #edb/ref 17592186267481} {:answer/id #uuid "384e03ef-b31d-57fa-a817-8e57e5fc9381" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{1}+\\frac{{y}^{2}}{3}=1" :db/id #edb/ref 17592186267482} {:answer/id #uuid "1e277316-bfd8-578b-903a-06f63e69e1a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{1}+\\frac{{y}^{2}}{9}=1" :db/id #edb/ref 17592186267483}] :answer-field/correct {:answer/id #uuid "22d5c9d1-3c82-5af9-aae2-bff5ea543677" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{1}=1" :db/id #edb/ref 17592186267479} :answer-field/id #uuid "8980ee0c-1a37-52e1-82df-a8bf77fa947e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186267478}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b66b9a52-af69-562e-9a8f-594e2cdd513a" :question/math-academy-id "q-69891" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070132/assets/9eb144bd4109846f3e1af4fb7d8ed70d2d8a29c3804547b89238d6437c4258d8.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=3$ and the vertical radius has length $b=1.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{3}^{2}}+\\frac{{y}^{2}}{{1}^{2}} & =1 \\\\ \\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{1} & =1.\\end{aligned}\n$$"}]}
