9535909 true] [17592186373990 1145 "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2},\\,{q}_{3}.$ \n\nSince $B$ is an orthonormal basis, we have that $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]$, where ${x}_{i}=x\\cdot {q}_{i}.$ Computing ${x}_{1},$ we obtain\n\n$$\n\\begin{aligned}{x}_{1} & =x\\cdot {q}_{1} \\\\  & =[\\begin{aligned}2\\sqrt{10} \\\\ \\frac{\\sqrt{10}}{2} \\\\ -\\frac{\\sqrt{10}}{2}\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ -\\frac{1}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}}\\end{aligned}] \\\\  & =-\\frac{1}{2}-\\frac{3}{2} \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\frac{1}{2}{x}_{1}=\\frac{1}{2}\\cdot (-2)=-1.\n$$" 13194139535909 true] [17592186373991 1000 #edb/ref 17592186373992 13194139535909 true] [17592186373991 1000 #edb/ref 17592186373993 13194139535909 true] [17592186373991 1000 #edb/ref 17592186373994 13194139535909 true] [17592186373991 1000 #edb/ref 17592186373995 13194139535909 true] [17592186373991 1000 #edb/ref 17592186373996 13194139535909 true] [17592186373991 1040 #edb/ref 17592186045450 13194139535909 true] [17592186373991 1041 "selection" 13194139535909 true] [17592186373991 1104 #edb/ref 17592186373995 13194139535909 true] [17592186373991 1110 #uuid "bc5b1465-11dd-5e44-b855-e0ca6e43892b" 13194139535909 true] [17592186373992 1034 "-\\frac{1}{2}" 13194139535909 true] [17592186373992 1103 #edb/ref 17592186045453 13194139535909 true] [17592186373992 1111 #uuid "3bcf4d31-6408-582e-b8c3-21a1b2e0df2b" 13194139535909 true] [17592186373993 1034 "\\frac{1}{2}" 13194139535909 true] [17592186373993 1103 #edb/ref 17592186045453 13194139535909 true] [17592186373993 1111 #uuid "762055fc-438e-5f70-ae0f-22ffe3258e9f" 13194139535909 true] [17592186373994 1034 "1" 13194139535909 true] [17592186373994 1103 #edb/ref 17592186045453 13194139535909 true] [17592186373994 1111 #uuid "5ac362d8-bd18-5d68-9f2a-92f7f4048578" 13194139535909 true] [17592186373995 1034 "-1" 13194139535909 true] [17592186373995 1