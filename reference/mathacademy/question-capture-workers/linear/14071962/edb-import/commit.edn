535909 true] [17592186373976 1113 #uuid "6131bff9-6164-5597-92ad-816d41332955" 13194139535909 true] [17592186373976 1145 "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2}.$ \n\nSince $B$ is an orthogonal basis, we have that $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$, where ${x}_{i}=\\frac{x\\cdot {q}_{i}}{{q}_{i}\\cdot {q}_{i}}.$ Computing ${x}_{1},$ we obtain \n\n$$\n\\begin{aligned}{x}_{1} & =\\frac{x\\cdot {q}_{1}}{{q}_{1}\\cdot {q}_{1}} \\\\  & =\\frac{(-9)\\cdot 4+8\\cdot 2}{{4}^{2}+{2}^{2}} \\\\  & =\\frac{-36+16}{16+4} \\\\  & =\\frac{-20}{20} \\\\  & =-1.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n6{x}_{1}=6\\cdot (-1)=-6.\n$$" 13194139535909 true] [17592186373977 1000 #edb/ref 17592186373978 13194139535909 true] [17592186373977 1000 #edb/ref 17592186373979 13194139535909 true] [17592186373977 1000 #edb/ref 17592186373980 13194139535909 true] [17592186373977 1000 #edb/ref 17592186373981 13194139535909 true] [17592186373977 1000 #edb/ref 17592186373982 13194139535909 true] [17592186373977 1040 #edb/ref 17592186045450 13194139535909 true] [17592186373977 1041 "selection" 13194139535909 true] [17592186373977 1104 #edb/ref 17592186373982 13194139535909 true] [17592186373977 1110 #uuid "f414bdee-ec8f-5e43-be41-e29fb714b1b5" 13194139535909 true] [17592186373978 1034 "12" 13194139535909 true] [17592186373978 1103 #edb/ref 17592186045453 13194139535909 true] [17592186373978 1111 #uuid "597b62cc-0411-5d21-9e4a-c7aa35afe536" 13194139535909 true] [17592186373979 1034 "-18" 13194139535909 true] [17592186373979 1103 #edb/ref 17592186045453 13194139535909 true] [17592186373979 1111 #uuid "8c4e9d7e-9a9c-5ab0-ba07-f9a6ee7cd7ba" 13194139535909 true] [17592186373980 1034 "-4" 13194139535909 true] [17592186373980 1103 #edb/ref 17592186045453 13194139535909 true] [17592186373980 1111 #uuid "3defc4b7-25d0-55bb-a000-0668706acf2a" 13194139535909 true] [17592186373981 1034 "4" 13194139535909 true] [17592186373981 1103 #edb/ref 17592186045453 13194139535909 true] [17592186373981 1111 #uuid "71d4c007-dd7c-540e-9267-a01530115175" 13194139535909 true] [17592186373982 1034 "-6" 13194139535909 true] [17592186373982 1103 #edb/ref 17592186045453 13194139535909 true] [17592186373982 1111 #uuid "15eecdc9-81b8-5fa4-991b-46cac7d3ce91" 13194139535909 true] [17592186373983 1017 #edb/ref 17592186373984 13194139535909 true] [17592186373983 1089 "q-81104" 13194139535909 true] [17592186373983 1091 #edb/ref 17592186045463 13194139535909 true] [17592186373983 1100 "Given the orthogonal basis $B$ of ${R}^{2}$ and the vector $x$ below, find the value of $20{x}_{2},$ where ${x}_{2}$ is the second component of $[x]_{B}.$\n\n$$\nB={[\\begin{aligned}4 \\\\ -8\\end{aligned}],[\\begin{aligned}-2 \\\\ -1\\end{aligned}]},\\,x=[\\begin{aligned}-1 \\\\ 1\\end{aligned}]\n$$" 13194139535909 true] [17592186373983 1113 #uuid "9fbd1e5c-f59b-5839-83e8-2af28c44549a" 13194139535909 true] [17592186373983 1145 "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2}.$ \n\nSince $B$ is an orthogonal basis, we have that $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$, where ${x}_{i}=\\frac{x\\cdot {q}_{i}}{{q}_{i}\\cdot {q}_{i}}.$ Computing ${x}_{2},$ we obtain \n\n$$\n\\begin{aligned}{x}_{2} & =\\frac{x\\cdot {q}_{2}}{{q}_{2}\\cdot {q}_{2}} \\\\  & =\\frac{(-1)\\cdot (-2)+1\\cdot (-1)}{(-2)^{2}+(-1)^{2}} \\\\  & =\\frac{2-1}{4+1} \\\\  & =\\frac{1}{5}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n20{x}_{2}=20\\cdot \\frac{1}{5}=4.\n$$" 13194139535909 true] [17592186373984 1000 #edb/ref 17592186373985 13194139535909 true] [17592186373984 1000 #edb/ref 17592186373986 13194139535909 true] [17592186373984 1000 #edb/ref 17592186373987 13194139535909 true] [17592186373984 1000 #edb/ref 17592186373988 13194139535909 true] [17592186373984 1000 #edb/ref 17592186373989 13194139535909 true] [17592186373984 1040 #edb/ref 17592186045450 13194139535909 true] [17592186373984 1041 "selection" 13194139535909 true] [17592186373984 1104 #edb/ref 17592186373988 13194139535