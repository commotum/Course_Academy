end{aligned}] \\\\  & =\\frac{1}{9}[\\begin{aligned}-1 & 0 \\\\ 0 & 1 \\\\ 2 & 2\\end{aligned}][\\begin{aligned}5 & -4 \\\\ -4 & 5\\end{aligned}][\\begin{aligned}-1 & 0 & 2 \\\\ 0 & 1 & 2\\end{aligned}] \\\\  & =\\frac{1}{9}[\\begin{aligned}-1 & 0 \\\\ 0 & 1 \\\\ 2 & 2\\end{aligned}][\\begin{aligned}-5 & -4 & 2 \\\\ 4 & 5 & 2\\end{aligned}] \\\\  & =\\frac{1}{9}[\\begin{aligned}5 & 4 & -2 \\\\ 4 & 5 & 2 \\\\ -2 & 2 & 8\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186373706 :knowledge-point/_questions [{:knowledge-point/id #uuid "9e81030a-0151-5dea-b9bc-74aae2499482" :knowledge-point/title "Identifying an Orthogonal Projection Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "913db71a-5ad6-5b21-9978-f060a1d178d1" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186373708} {:answer/id #uuid "64cd64c9-ff0e-5d98-954c-21b0951b789a" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186373709} {:answer/id #uuid "6ce0e102-87e1-5484-84d0-bfda1ffb2a9b" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186373710} {:answer/id #uuid "650424f5-f2b8-5453-be18-02ab921c6f04" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186373711} {:answer/id #uuid "911a1344-bd42-5c27-abe6-6a5501541bc4" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186373712}] :answer-field/correct {:answer/id #uuid "64cd64c9-ff0e-5d98-954c-21b0951b789a" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186373709} :answer-field/id #uuid "0fffff30-81bb-56dd-bbd6-95d945ecd1f2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373707}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "70fa4221-0309-5c70-8de7-951195472473" :question/math-academy-id "q-95346" :question/problem "Which of the following are orthogonal projection matrices?\n\n$$\nA=[\\begin{aligned}\\frac{1}{5} & -\\frac{2}{5} \\\\ -\\frac{2}{5} & \\frac{4}{5}\\end{aligned}],\\,B=[\\begin{aligned}\\frac{2}{5} & -\\frac{3}{5} \\\\ \\frac{3}{5} & \\frac{1}{5}\\end{aligned}],\\,C=[\\begin{aligned}\\frac{1}{2} & \\frac{2}{3} \\\\ \\frac{3}{4} & \\frac{1}{2}\\end{aligned}].\n$$" :question/worked-solution "Recall that $Q$ is an orthogonal projection matrix if and only if ${Q}^{2}=Q$ and ${Q}^{T}=Q.$ \n\nWith that in mind, let's examine our matrices.\n\n- $A$ is an orthogonal projection matrix. Indeed,\n${A}^{T}=A$\nand\n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =[\\begin{aligned}\\frac{1}{5} & -\\frac{2}{5} \\\\ -\\frac{2}{5} & \\frac{4}{5}\\end{aligned}][\\begin{aligned}\\frac{1}{5} & -\\frac{2}{5} \\\\ -\\frac{2}{5} & \\frac{4}{5}\\end{aligned}] \\\\  & =\\frac{1}{5}[\\begin{aligned}1 & -2 \\\\ -2 & 4\\end{aligned}]\\cdot \\frac{1}{5}[\\begin{aligned}1 & -2 \\\\ -2 & 4\\end{aligned}] \\\\  & =\\frac{1}{25}[\\begin{aligned}1 & -2 \\\\ -2 & 4\\end{aligned}][\\begin{aligned}1 & -2 \\\\ -2 & 4\\end{aligned}] \\\\  & =\\frac{1}{25}[\\begin{aligned}5 & -10 \\\\ -10 & 20\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{5} & -\\frac{2}{5} \\\\ -\\frac{2}{5} & \\frac{4}{5}\\end{aligned}] \\\\  & =A.\\end{aligned}\n$$\n\n- $B$ is *not* an orthogonal projection matrix. We have\n\n$$\n\\begin{aligned}{B}^{T}\\ne B.\\end{aligned}\n$$\n\n- $C$ is *not* an orthogonal projection matrix. We have\n\n$$\n\\begin{aligned}{C}^{T}\\ne C.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"$A$ only.\""}] [{:db/id #edb/ref 17592186373713 :knowledge-point/_questions [{:knowledge-point/id #uuid "9e81030a-0151-5dea-b9bc-74aae2499482" :knowledge-point/title "Identifying an Orthogonal Projection Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ed11c3b-4177-5582-a120-ee774e00f3ea" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186373715} {:answer/id #uuid "479e0e57-cbcc-5c0d-8d86-07b03be484c4" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186373716} {:answer/id #uuid "0d553bbf-8f19-5722-be56-004c94f88994" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$  only" :db/id #edb/ref 17592186373717} {:answer/id #uuid "97ff53b4-70ea-59f7-8c35-d45dac08ad07" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186373718} {:answer/id #uuid "3f25999d-fd3c-5900-940a-101d86ab61e3" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186373719}] :answer-field/correct {:answer/id #uuid "3f25999d-fd3c-5900-940a-101d86ab61e3" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186373719} :answer-field/id #uuid "6d02c784-8c90-5046-8797-41768c233688" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373714}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "091c7b52-e53f-5cf4-a30e-ad08881c7b78" :question/math-academy-id "q-95351" :question/problem "Which of the following are orthogonal projection matrices?\n\n$$\nA=[\\begin{aligned}2 & -1 \\\\ -1 & 3\\end{aligned}],\\,B=[\\begin{aligned}\\frac{9}{10} & -\\frac{3}{10} \\\\ -\\frac{3}{10} & \\frac{1}{10}\\end{aligned}],\\,C=[\\begin{aligned}3 & 2 \\\\ 2 & -1\\end{aligned}].\n$$" :question/worked-solution "Recall that $Q$ is an orthogonal projection matrix if and only if ${Q}^{2}=Q$ and ${Q}^{T}=Q.$ \n\nWith that in mind, let's examine our matrices.\n\n- $A$ is *not* an orthogonal projection matrix. We have\n${A}^{T}=A$\nbut \n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =[\\begin{aligned}2 & -1 \\\\ -1 & 3\\end{aligned}][\\begin{aligned}2 & -1 \\\\ -1 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}5 & -5 \\\\ -5 & 10\\end{aligned}] \\\\  & \\ne A.\\end{aligned}\n$$\n\n- $B$ is an orthogonal projection matrix. Indeed,\n${B}^{T}=B$\nand\n\n$$\n\\begin{aligned}{B}^{2} & =B\\cdot B \\\\  & =[\\begin{aligned}\\frac{9}{10} & -\\frac{3}{10} \\\\ -\\frac{3}{10} & \\frac{1}{10}\\end{aligned}][\\begin{aligned}\\frac{9}{10} & -\\frac{3}{10} \\\\ -\\frac{3}{10} & \\frac{1}{10}\\end{aligned}] \\\\  & =\\frac{1}{10}[\\begin{aligned}9 & -3 \\\\ -3 & 1\\end{aligned}]\\cdot \\frac{1}{10}[\\begin{aligned}9 & -3 \\\\ -3 & 1\\end{aligned}] \\\\  & =\\frac{1}{100}[\\begin{aligned}9 & -3 \\\\ -3 & 1\\end{aligned}][\\begin{aligned}9 & -3 \\\\ -3 & 1\\end{aligned}] \\\\  & =\\frac{1}{100}[\\begin{aligned}90 & -30 \\\\ -30 & 10\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{9}{10} & -\\frac{3}{10} \\\\ -\\frac{3}{10} & \\frac{1}{10}\\end{aligned}] \\\\  & =B.\\end{aligned}\n$$\n\n- $C$ is *not* an orthogonal projection matrix. We have\n${C}^{T}=C$\nbut \n\n$$\n\\begin{aligned}{C}^{2} & =C\\cdot C \\\\  & =[\\begin{aligned}3 & 2 \\\\ 2 & -1\\end{aligned}][\\begin{aligned}3 & 2 \\\\ 2 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}13 & 4 \\\\ 4 & 5\\end{aligned}] \\\\  & \\ne C.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only.\""}] [{:db/id #edb/ref 17592186373720 :knowledge-point/_questions [{:knowledge-point/id #uuid "9e81030a-0151-5dea-b9bc-74aae2499482" :knowledge-point/title "Identifying an Orthogonal Projection Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24e018f2-7be3-5fe7-bf01-67409cfa171d" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186373722} {:answer/id #uuid "29edfeb4-032f-59da-bee7-5b7a9bbb31ed" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186373723} {:answer/id #uuid "c1ffef19-03bc-5c8c-862d-db4887c5d8f9" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186373724} {:answer/id #uuid "51972f70-f3c3-5650-8fca-41188ce67d32" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186373725} {:answer/id #uuid "d0e97ec8-6341-5b69-a6a4-8857934884f0" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186373726}] :answer-field/correct {:answer/id #uuid "d0e97ec8-6341-5b69-a6a4-8857934884f0" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186373726} :answer-field/id #uuid "1fbe3176-581e-5f1e-84bf-556b4edc5a56" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373721}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "386c3ea1-7ed9-5adf-8e0d-b5dbc53aed84" :question/math-academy-id "q-95353" :question/problem "Which of the following are orthogonal projection matrices?\n\n$$\nA=[\\begin{aligned}\\frac{4}{13} & \\frac{6}{13} \\\\ -\\frac{6}{13} & \\frac{4}{13}\\end{aligned}],\\,B=[\\begin{aligned}\\frac{1}{26} & \\frac{5}{26} \\\\ \\frac{5}{26} & \\frac{25}{26}\\end{aligned}],\\,C=[\\begin{aligned}\\frac{3}{4} & \\frac{1}{2} \\\\ \\frac{1}{3} & \\frac{3}{4}\\end{aligned}].\n$$" :question/worked-solution "Recall that $Q$ is an orthogonal projection matrix if and only if ${Q}^{2}=Q$ and ${Q}^{T}=Q.$ \n\nWith that in mind, let's examine our matrices.\n\n- $A$ is *not* an orthogonal projection matrix. We have\n\n$$\n\\begin{aligned}{A}^{T}\\ne A.\\end{aligned}\n$$\n\n- $B$ is an orthogonal projection matrix. We have\n${B}^{T}=B$\nand \n\n$$\n\\begin{aligned}{B}^{2} & =B\\cdot B \\\\  & =[\\begin{aligned}\\frac{1}{26} & \\frac{5}{26} \\\\ \\frac{5}{26} & \\frac{25}{26}\\end{aligned}][\\begin{aligned}\\frac{1}{26} & \\frac{5}{26} \\\\ \\frac{5}{26} & \\frac{25}{26}\\end{aligned}] \\\\  & =\\frac{1}{26}[\\begin{aligned}1 & 5 \\\\ 5 & 25\\end{aligned}]\\cdot \\frac{1}{26}[\\begin{aligned}1 & 5 \\\\ 5 & 25\\end{aligned}] \\\\  & =\\frac{1}{676}[\\begin{aligned}1 & 5 \\\\ 5 & 25\\end{aligned}][\\begin{aligned}1 & 5 \\\\ 5 & 25\\end{aligned}] \\\\  & =\\frac{1}{676}[\\begin{aligned}26 & 130 \\\\ 130 & 650\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{26} & \\frac{5}{26} \\\\ \\frac{5}{26} & \\frac{25}{26}\\end{aligned}] \\\\  & =B.\\end{aligned}\n$$\n\n- $C$ is *not* an orthogonal projection matrix. We have\n\n$$\n\\begin{aligned}{C}^{T}\\ne C.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only.\""}] [{:db/id #edb/ref 17592186373727 :knowledge-point/_questions [{:knowledge-point/id #uuid "0741fad6-3e88-53a4-bb5d-f80e445f8778" :knowledge-point/title "Finding an Orthogonal Projection Matrix Given Vectors That Span the Orthogonal Complement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d51b63cc-c60e-5d9a-858a-afab015ed696" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186373729} {:answer/id #uuid "74ebb756-4201-5abf-b8eb-93dba92c41a4" :answer/type {:db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186373730} {:answer/id #uuid "87e2832f-a464-5d20-83c2-2b21fc842cfa" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186373731} {:answer/id #uuid "ab52b865-60d6-5b60-a27d-e82148be7e02" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186373732} {:answer/id #uuid "88e8d4de-d512-550e-8277-6eabf3dbdd91" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186373733}] :answer-field/correct {:answer/id #uuid "d51b63cc-c60e-5d9a-858a-afab015ed696" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186373729} :answer-field/id #uuid "61734b12-3530-50bb-a419-51ab8d076282" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373728}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "da7f2140-2639-53fe-a483-ef03e5e863ba" :question/math-academy-id "q-95365" :question/problem "$$\na=[\\begin{aligned}-3 \\\\ 2 \\\\ -2\\end{aligned}],\\,P=\\frac{1}{17}[\\begin{aligned}{p}_{11} & {p}_{12} & {p}_{13} \\\\ {p}_{21} & {p}_{22} & {p}_{23} \\\\ {p}_{31} & {p}_{32} & {p}_{33}\\end{aligned}]\n$$\n\nGiven that the vector $a$ above spans ${S}^{⊥},$ and that $P$ is the orthogonal projection matrix of ${R}^{3}$ onto the subspace $S$, what is the value of ${p}_{11}+{p}_{23}?$" :question/worked-solution "First, we find the orthogonal projection matrix onto ${S}^{⊥}=\\text{Span}{a}.$\n\nUsing the formula for the orthogonal projection matrix\n\n$$\n{P}_{{S}^{⊥}}=a({a}^{T}\\,a)^{-1}{a}^{T},\n$$\n\nwe obtain the following:\n\n$$\n\\begin{aligned}{P}_{{S}^{⊥}} & =[\\begin{aligned}-3 \\\\ 2 \\\\ -2\\end{aligned}]{([\\begin{aligned}-3 & 2 & -2\\end{aligned}][\\begin{aligned}-3 \\\\ 2 \\\\ -2\\end{aligned}])}^{-1}[\\begin{aligned}-3 & 2 & -2\\end{aligned}] \\\\  & ={17}^{-1}[\\begin{aligned}-3 \\\\ 2 \\\\ -2\\end{aligned}][\\begin{aligned}-3 & 2 & -2\\end{aligned}] \\\\  & =\\frac{1}{17}[\\begin{aligned}9 & -6 & 6 \\\\ -6 & 4 & -4 \\\\ 6 & -4 & 4\\end{aligned}]\\end{aligned}\n$$\n\nRecall that ${P}_{S}+{P}_{{S}^{⊥}}=I.$ Therefore, \n\n$$\n\\begin{aligned}{P}_{S} & =I-{P}_{{S}^{⊥}} \\\\  & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]-\\frac{1}{17}[\\begin{aligned}9 & -6 & 6 \\\\ -6 & 4 & -4 \\\\ 6 & -4 & 4\\end{aligned}] \\\\  & =\\frac{1}{17}[\\begin{aligned}8 & 6 & -6 \\\\ 6 & 13 & 4 \\\\ -6 & 4 & 13\\end{aligned}].\\end{aligned}\n$$\n\nFinally, ${p}_{11}+{p}_{23}=8+4=12.$"}]}
