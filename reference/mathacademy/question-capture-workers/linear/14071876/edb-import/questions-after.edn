begin{aligned}5 \\\\ -2 \\\\ 1\\end{aligned}].$ Therefore,\n\n$$\n\\begin{aligned}{P}_{S} & =A({A}^{T}\\,A)^{-1}\\,{A}^{T} \\\\  & =[\\begin{aligned}5 \\\\ -2 \\\\ 1\\end{aligned}]{([\\begin{aligned}5 & -2 & 1\\end{aligned}][\\begin{aligned}5 \\\\ -2 \\\\ 1\\end{aligned}])}^{-1}[\\begin{aligned}5 & -2 & 1\\end{aligned}] \\\\  & ={30}^{-1}[\\begin{aligned}5 \\\\ -2 \\\\ 1\\end{aligned}][\\begin{aligned}5 & -2 & 1\\end{aligned}] \\\\  & =\\frac{1}{30}[\\begin{aligned}25 & -10 & 5 \\\\ -10 & 4 & -2 \\\\ 5 & -2 & 1\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186373671 :knowledge-point/_questions [{:knowledge-point/id #uuid "9316ee08-13ad-57cf-87cf-2c7a86645aca" :knowledge-point/title "Finding a Matrix that Defines an Orthogonal Projection Onto the Subspace Spanned by a Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b455fe6-e727-5162-b573-78cae5d5bc4a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{20}[\\begin{aligned}4 & 1 & 2 \\\\ 1 & 2 & 4 \\\\ 2 & 4 & 8\\end{aligned}]" :db/id #edb/ref 17592186373673} {:answer/id #uuid "baeb6277-b9d1-576d-a117-547bbbec081b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{21}[\\begin{aligned}4 & 1 & 2 \\\\ 1 & 2 & 4 \\\\ 2 & 4 & 4\\end{aligned}]" :db/id #edb/ref 17592186373674} {:answer/id #uuid "ee77eb10-c1e5-5658-bb31-a4e399b95ca6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{7}[\\begin{aligned}8 & 2 & 4 \\\\ 2 & 1 & 2 \\\\ 4 & 2 & 4\\end{aligned}]" :db/id #edb/ref 17592186373675} {:answer/id #uuid "0c2a6cb2-666e-5e92-abaa-ccc2446c94cf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{21}[\\begin{aligned}16 & 4 & 8 \\\\ 4 & 1 & 2 \\\\ 8 & 2 & 4\\end{aligned}]" :db/id #edb/ref 17592186373676} {:answer/id #uuid "4f7575fe-7a89-573a-a42c-09435b6ca538" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{7}[\\begin{aligned}4 & 1 & 2 \\\\ 8 & 2 & 4 \\\\ 4 & 2 & 8\\end{aligned}]" :db/id #edb/ref 1