        {
          "question": "e-5577",
          "field": null,
          "attribute": "question/problem",
          "value": "Find a matrix that defines the orthogonal projection of $\\mathbb{R}^3$ onto the subspace spanned by ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071876/assets/16f06043e1f8bcab11a7e43fc76800c33e2560bb00e425c9c88f8cfeb8c12ee3.png)",
