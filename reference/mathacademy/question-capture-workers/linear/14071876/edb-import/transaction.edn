ge-point/id #uuid "d9fd0121-5ce9-5a7b-a706-59ba73a71f7a"] :knowledge-point/questions ["q-95334"] :db/ensure [:knowledge-point/validate]} {:db/id "q-95200/selection/212a886eae0536e4b5bf65f259273d45d9f48ed607dfe590056bd8e4ec88975b" :answer/id #uuid "c54c2c1b-a825-5b76-a0f4-2f74880182b0" :answer/type :answer.type/math :answer/value "\\frac{1}{35}[\\begin{aligned}13 & 11 & -3 \\\\ 11 & 2 & -1 \\\\ -3 & -1 & -8\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-95200/selection/77c7973b5d85b91d5c617d5ff1ac4023bcbb1cbffdb892ea9ad7602480a987c5" :answer/id #uuid "843a73be-1aaf-5c75-9604-0e5541ac7ee9" :answer/type :answer.type/math :answer/value "\\frac{1}{35}[\\begin{aligned}26 & 15 & 3 \\\\ 15 & 10 & -5 \\\\ 3 & -5 & 34\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-95200/selection/d90aadf4b4dd60f3fd9ef832aac7d149d794c6c1e74ce1e332d831345cda1f3c" :answer/id #uuid "ae81af60-064e-550e-b442-186db0b896f3" :answer/type :answer.type/math :answer/value "\\frac{1}{13}[\\begin{aligned}6 & 15 & -1 \\\\ 15 & 1 & -5 \\\\ -1 & -5 & 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-95200/selection/a9fdee63d000502ed582dc54a1981b316f4ec014770967274d98173d7f05d968" :answer/id #uuid "de91d0a8-d54c-573c-9159-4bc65dd8c1b2" :answer/type :answer.type/math :answer/value "\\frac{1}{7}[\\begin{aligned}6 & 15 & 3 \\\\ 15 & 6 & -1 \\\\ 3 & -1 & -6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-95200/selection/c925f123ca36b2c681b4d4e18284419589798b52a2a5cfb71b9fea700306fbbb" :answer/id #uuid "cea416f7-b05c-5452-9a84-e4fcbe0253c9" :answer/type :answer.type/math :answer/value "\\frac{1}{7}[\\begin{aligned}13 & 5 & -3 \\\\ 5 & 10 & 5 \\\\ -3 & 5 & 34\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-95200/selection" :answer-field/id #uuid "d96b5f2e-0591-5318-9766-280e9af35475" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-95200/selection/77c7973b5d85b91d5c617d5ff1ac4023bcbb1cbffdb892ea9ad7602480a987c5" :answer-field/choices ["q-95200/selection/212a886eae0536e4b5bf65f259273d45d9f48ed607dfe590056bd8e4ec88975b" "q-95200/selection/77c7973b5d85b91d5c617d5ff1ac4023bcbb1cbffdb892ea9ad7602480a987c5" "q-95200/selection/d90aadf4b4dd60f3fd9ef832aac7d149d794c6c1e74ce1e332d831345cda1f3c" "q-95200/selection/a9fdee63d000502ed582dc54a1981b316f4ec014770967274d98173d7f05d968" "q-95200/selection/c925f123ca36b2c681b4d4e18284419589798b52a2a5cfb71b9fea700306fbbb"] :db/ensure [:answer-field/validate]} {:db/id "q-95200" :question/id #uuid "671a46bf-f602-5b82-88d9-c8ce78be538d" :question/math-academy-id "q-95200" :question/problem "Find a matrix that defines the orthogonal projection of ${R}^{3}$ onto the plane whose parametric equation is $r=sv+tw$, where\n\n$$\nv=[\\begin{aligned}2 \\\\ 1 \\\\ 1\\end{aligned}],\\,w=[\\begin{aligned}1 \\\\ 1 \\\\ -2\\end{aligned}].\n$$" :question/worked-solution "Recall that the matrix ${P}_{S}=A({A}^{T}\\,A)^{-1}\\,{A}^{T}$ maps any vector $x\\in {R}^{n}$ onto its orthogonal projection in the subspace $S$ spanned by the columns of the matrix $A.$ \n\nNotice that the plane $r=sv+tw$ is actually the subspace $\\text{Span}{v,w}.$ \nHence, we have \n\n$$\nA=[\\begin{aligned}2 & 1 \\\\ 1 & 1 \\\\ 1 & -2\\end{aligned}].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{P}_{S} & =A({A}^{T}\\,A)^{-1}\\,{A}^{T} \\\\  & =[\\begin{aligned}2 & 1 \\\\ 1 & 1 \\\\ 1 & -2\\end{aligned}]{([\\begin{aligned}2 & 1 & 1 \\\\ 1 & 1 & -2\\end{aligned}][\\begin{aligned}2 & 1 \\\\ 1 & 1 \\\\ 1 & -2\\end{aligned}])}^{-1}[\\begin{aligned}2 & 1 & 1 \\\\ 1 & 1 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 1 \\\\ 1 & 1 \\\\ 1 & -2\\end{aligned}]{[\\begin{aligned}6 & 1 \\\\ 1 & 6\\end{aligned}]}^{-1}[\\begin{aligned}2 & 1 & 1 \\\\ 1 & 1 & -2\\end{aligned}] \\\\  & =\\frac{1}{35}[\\begin{aligned}2 & 1 \\\\ 1 & 1 \\\\ 1 & -2\\end{aligned}][\\begin{aligned}6 & -1 \\\\ -1 & 6\\end{aligned}][\\begin{aligned}2 & 1 & 1 \\\\ 1 & 1 & -2\\end{aligned}] \\\\  & =\\frac{1}{35}[\\begin{aligned}2 & 1 \\\\ 1 & 1 \\\\ 1 & -2\\end{aligned}][\\begin{aligned}11 & 5 & 8 \\\\ 4 & 5 & -13\\end{aligned}] \\\\  & =\\frac{1}{35}[\\begin{aligned}26 & 15 & 3 \\\\ 15 & 10 & -5 \\\\ 3 & -5 & 34\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-95200/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d9fd0121-5ce9-5a7b-a706-59ba73a71f7a"] :knowledge-point/questions ["q-95200"] :db/ensure [:knowledge-point/validate]} {:db/id "q-95332/selection/dc686abf4cea368752f412f797b78c19d36f6efbeff89cf7b20b05c0a3adf437" :answer/id #uuid "54516598-930c-5f61-af3f-689bbff1495a" :answer/type :answer.type/math :answer/value "\\frac{1}{3}[\\begin{aligned}5 & 2 & -5 \\\\ 2 & 2 & 2 \\\\ -5 & 2 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-95332/selection/c914e39c443c23ecd54db187c8c23357fc10932f9d5db25314b44b60965dd0e1" :answer/id #uuid "e6d467ee-8883-5570-9a97-93ccd491a406" :answer/type :answer.type/math :answer/value "\\frac{1}{2}[\\begin{aligned}1 & 2 & -5 \\\\ 2 & 1 & 1 \\\\ -5 & 1 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-95332/selection/08423127aec0969f1eb3a760939f5529b76a9189c3f62fe92fa4a30dac591488" :answer/id #uuid "e9f708ef-72cb-5756-9c56-b108b55c993f" :answer/type :answer.type/math :answer/value "\\frac{1}{6}[\\begin{aligned}5 & 2 & -1 \\\\ 2 & 2 & 2 \\\\ -1 & 2 & 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-95332/selection/f7d6300ed4c991a0b8432c7c710232ded63c839de9741238a9b6200a8d0f0635" :answer/id #uuid "35f82e83-d30f-55d7-9830-78e42c143466" :answer/type :answer.type/math :answer/value "\\frac{1}{3}[\\begin{aligned}2 & 2 & 0 \\\\ 2 & 2 & 2 \\\\ 0 & 2 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-95332/selection/efccc67e69da9cf850019a535b234e9166b0acce82ac97445a1d94e64c2341e8" :answer/id #uuid "6c28dafd-c76d-57cf-861d-0b91c656c4d2" :answer/type :answer.type/math :answer/value "\\frac{1}{6}[\\begin{aligned}1 & 2 & -5 \\\\ 2 & 1 & 1 \\\\ -5 & 1 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-95332/selection" :answer-field/id #uuid "0bcbb337-55ab-56f1-b33e-02a10aebd32d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-95332/selection/08423127aec0969f1eb3a760939f5529b76a9189c3f62fe92fa4a30dac591488" :answer-field/choices ["q-95332/selection/dc686abf4cea368752f412f797b78c19d36f6efbeff89cf7b20b05c0a3adf437" "q-95332/selection/c914e39c443c23ecd54db187c8c23357fc10932f9d5db25314b44b60965dd0e1" "q-95332/selection/08423127aec0969f1eb3a760939f5529b76a9189c3f62fe92fa4a30dac591488" "q-95332/selection/f7d6300ed4c991a0b8432c7c710232ded63c839de9741238a9b6200a8d0f0635" "q-95332/selection/efccc67e69da9cf850019a535b234e9166b0acce82ac97445a1d94e64c2341e8"] :db/ensure [:answer-field/validate]} {:db/id "q-95332" :question/id #uuid "fd1cc634-558f-596b-a3a9-dbf430b73c03" :question/math-academy-id "q-95332" :question/problem "Find a matrix that defines the orthogonal projection of ${R}^{3}$ onto the plane whose parametric equation is $r=sv+tw$, where\n\n$$\nv=[\\begin{aligned}-1 \\\\ 0 \\\\ 1\\end{aligned}],\\,w=[\\begin{aligned}1 \\\\ 1 \\\\ 1\\end{aligned}].\n$$" :question/worked-solution "Recall that the matrix ${P}_{S}=A({A}^{T}\\,A)^{-1}\\,{A}^{T}$ maps any vector $x\\in {R}^{n}$ onto its orthogonal projection in the subspace $S$ spanned by the columns of the matrix $A.$ \n\nNotice that the plane $r=sv+tw$ is actually the subspace $\\text{Span}{v,w}.$ \nHence, we have \n\n$$\nA=[\\begin{aligned}-1 & 1 \\\\ 0 & 1 \\\\ 1 & 1\\end{aligned}].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{P}_{S} & =A({A}^{T}\\,A)^{-1}\\,{A}^{T} \\\\  & =[\\begin{aligned}-1 & 1 \\\\ 0 & 1 \\\\ 1 & 1\\end{aligned}]{([\\begin{aligned}-1 & 0 & 1 \\\\ 1 & 1 & 1\\end{aligned}][\\begin{aligned}-1 & 1 \\\\ 0 & 1 \\\\ 1 & 1\\end{aligned}])}^{-1}[\\begin{aligned}-1 & 0 & 1 \\\\ 1 & 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 1 \\\\ 0 & 1 \\\\ 1 & 1\\end{aligned}]{[\\begin{aligned}2 & 0 \\\\ 0 & 3\\end{aligned}]}^{-1}[\\begin{aligned}-1 & 0 & 1 \\\\ 1 & 1 & 1\\end{aligned}] \\\\  & =\\frac{1}{6}[\\begin{aligned}-1 & 1 \\\\ 0 & 1 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}3 & 0 \\\\ 0 & 2\\end{aligned}][\\begin{aligned}-1 & 0 & 1 \\\\ 1 & 1 & 1\\end{aligned}] \\\\  & =\\frac{1}{6}[\\begin{aligned}-1 & 1 \\\\ 0 & 1 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}-3 & 0 & 3 \\\\ 2 & 2 & 2\\end{aligned}] \\\\  & =\\frac{1}{6}[\\begin{aligned}5 & 2 & -1 \\\\ 2 & 2 & 2 \\\\ -1 & 2 & 5\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-95332/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d9fd0121-5ce9-5a7b-a706-59ba73a71f7a"] :knowledge-point/questions ["q-95332"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-40662"] :question/problem "$$\nA=[\\begin{aligned}\\frac{4}{5} & \\frac{2}{5} \\\\ \\frac{2}{5} & \\frac{1}{5}\\end{aligned}]\n$$\n\nConsider the matrix $A$ given above. Which of the following statements are true?\n\n- ${A}^{T}=A$\n- ${A}^{2}=A$\n- $A$ is an orthogonal projection matrix" :question/worked-solution "Recall that $Q$ is an orthogonal projection matrix if and only if ${Q}^{2}=Q$ and ${Q}^{T}=Q.$ \n\nWith that in mind, let's examine each of the statements in turn.\n\n- Statement I is true. Indeed, ${A}^{T}=A.$\n\n- Statement II is true. Indeed, \n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =[\\begin{aligned}\\frac{4}{5} & \\frac{2}{5} \\\\ \\frac{2}{5} & \\frac{1}{5}\\end{aligned}][\\begin{aligned}\\frac{4}{5} & \\frac{2}{5} \\\\ \\frac{2}{5} & \\frac{1}{5}\\end{aligned}] \\\\  & =\\frac{1}{5}[\\begin{aligned}4 & 2 \\\\ 2 & 1\\end{aligned}]\\cdot \\frac{1}{5}[\\begin{aligned}4 & 2 \\\\ 2 & 1\\end{aligned}] \\\\  & =\\frac{1}{25}[\\begin{aligned}4 & 2 \\\\ 2 & 1\\end{aligned}][\\begin{aligned}4 & 2 \\\\ 2 & 1\\end{aligned}] \\\\  & =\\frac{1}{25}[\\begin{aligned}20 & 10 \\\\ 10 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{4}{5} & \\frac{2}{5} \\\\ \\frac{2}{5} & \\frac{1}{5}\\end{aligned}] \\\\  & =A.\\end{aligned}\n$$\n\n- Statement III is true since both statements I and II are true.\n\nTherefore, the correct answer is \"I, II, and III.\"" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-140516/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "a39177ee-bd8b-527c-9b24-ca84aa48707c" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-140516/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "b0f66c9f-9bc4-5679-8863-c741765fa507" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-140516/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "1994b42b-44b0-55aa-8321-1af2328d42bd" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-140516/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "d0104faa-35ea-580b-8181-be35ba396053" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-140516/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "016d36cf-8de7-503b-8ddc-0ad89bff271f" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-140516/selection" :answer-field/id #uuid "8792cfa9-4a27-5047-a817-ec712e930331" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-140516/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer-field/choices ["q-140516/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-140516/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-140516/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-140516/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-140516/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c"] :db/ensure [:answer-field/validate]} {:db/id "q-140516" :question/id #uuid "625cbad6-f363-5bfa-9060-19958eec2bc6" :question/math-academy-id "q-140516" :question/problem "$$\nA=[\\begin{aligned}2 & -2 \\\\ 1 & -1\\end{aligned}]\n$$\n\nConsider the matrix $A$ given above. Which of the following statements are true?\n\n- ${A}^{T}=A$\n- ${A}^{2}=A$\n- $A$ is an orthogonal projection matrix" :question/worked-solution "Recall that $Q$ is an orthogonal projection matrix if and only if ${Q}^{2}=Q$ and ${Q}^{T}=Q.$ \n\nWith that in mind, let's examine each of the statements in turn.\n\n- Statement I is false since ${A}^{T}\\ne A.$\n\n- Statement II is true. Indeed, \n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =[\\begin{aligned}2 & -2 \\\\ 1 & -1\\end{aligned}][\\begin{aligned}2 & -2 \\\\ 1 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -2 \\\\ 1 & -1\\end{aligned}] \\\\  & =A.\\end{aligned}\n$$\n\n- Statement III is false since not both statements I and II are true.\n\nTherefore, the correct answer is \" II only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-140516/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9e81030a-0151-5dea-b9bc-74aae2499482"] :knowledge-point/questions ["q-140516"] :db/ensure [:knowledge-point/validate]} {:db/id "q-95346/selection/2377e3ffc3b5cd65e1036103e0b988e5af6634b2438c63c3b7cc0592571401ab" :answer/id #uuid "913db71a-5ad6-5b21-9978-f060a1d178d1" :answer/type :answer.type/text :answer/value "$A$ and $C$ only" :db/ensure [:answer/validate]} {:db/id "q-95346/selection/685c02320dbe687345f93d820499dea4c0c82808b910e8a0e5841f77aa82209d" :answer/id #uuid "64cd64c9-ff0e-5d98-954c-21b0951b789a" :answer/type :answer.type/text :answer/value "$A$ only" :db/ensure [:answer/validate]} {:db/id "q-95346/selection/e956c3af673c94782038951d8de50bf89c9a53bf4daf2ca6725a4bea4229074c" :answer/id #uuid "911a1344-bd42-5c27-abe6-6a5501541bc4" :answer/type :answer.type/text :answer/value "$B$ only" :db/ensure [:answer/validate]} {:db/id "q-95346/selection/e432f1020975ada4c83798ae75bfd6c0ae4dfe63215763f08b8be8ccabf8a5d3" :answer/id #uuid "650424f5-f2b8-5453-be18-02ab921c6f04" :answer/type :answer.type/text :answer/value "$C$ only" :db/ensure [:answer/validate]} {:db/id "q-95346/selection/9ed3305a02906a861616af6ff886306c4a2a74885d99f506419451b33c7c9d2d" :answer/id #uuid "6ce0e102-87e1-5484-84d0-bfda1ffb2a9b" :answer/type :answer.type/text :answer/value "$B$ and $C$ only" :db/ensure [:answer/validate]} {:db/id "q-95346/selection" :answer-field/id #uuid "0fffff30-81bb-56dd-bbd6-95d945ecd1f2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-95346/selection/685c02320dbe687345f93d820499dea4c0c82808b910e8a0e5841f77aa82209d" :answer-field/choices ["q-95346/selection/2377e3ffc3b5cd65e1036103e0b988e5af6634b2438c63c3b7cc0592571401ab" "q-95346/selection/685c02320dbe687345f93d820499dea4c0c82808b910e8a0e5841f77aa82209d" "q-95346/selection/e956c3af673c94782038951d8de50bf89c9a53bf4daf2ca6725a4bea4229074c" "q-95346/selection/e432f1020975ada4c83798ae75bfd6c0ae4dfe63215763f08b8be8ccabf8a5d3" "q-95346/selection/9ed3305a02906a861616af6ff886306c4a2a74885d99f506419451b33c7c9d2d"] :db/ensure [:answer-field/validate]} {:db/id "q-95346" :question/id #uuid "70fa4221-0309-5c70-8de7-951195472473" :question/math-academy-id "q-95346" :question/problem "Which of the following are orthogonal projection matrices?\n\n$$\nA=[\\begin{aligned}\\frac{1}{5} & -\\frac{2}{5} \\\\ -\\frac{2}{5} & \\frac{4}{5}\\end{aligned}],\\,B=[\\begin{aligned}\\frac{2}{5} & -\\frac{3}{5} \\\\ \\frac{3}{5} & \\frac{1}{5}\\end{aligned}],\\,C=[\\begin{aligned}\\frac{1}{2} & \\frac{2}{3} \\\\ \\frac{3}{4} & \\frac{1}{2}\\end{aligned}].\n$$" :question/worked-solution "Recall that $Q$ is an orthogonal projection matrix if and only if ${Q}^{2}=Q$ and ${Q}^{T}=Q.$ \n\nWith that in mind, let's examine our matrices.\n\n- $A$ is an orthogonal projection matrix. Indeed,\n${A}^{T}=A$\nand\n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =[\\begin{aligned}\\frac{1}{5} & -\\frac{2}{5} \\\\ -\\frac{2}{5} & \\frac{4}{5}\\end{aligned}][\\begin{aligned}\\frac{1}{5} & -\\frac{2}{5} \\\\ -\\frac{2}{5} & \\frac{4}{5}\\end{aligned}] \\\\  & =\\frac{1}{5}[\\begin{aligned}1 & -2 \\\\ -2 & 4\\end{aligned}]\\cdot \\frac{1}{5}[\\begin{aligned}1 & -2 \\\\ -2 & 4\\end{aligned}] \\\\  & =\\frac{1}{25}[\\begin{aligned}1 & -2 \\\\ -2 & 4\\end{aligned}][\\begin{aligned}1 & -2 \\\\ -2 & 4\\end{aligned}] \\\\  & =\\frac{1}{25}[\\begin{aligned}5 & -10 \\\\ -10 & 20\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{5} & -\\frac{2}{5} \\\\ -\\frac{2}{5} & \\frac{4}{5}\\end{aligned}] \\\\  & =A.\\end{aligned}\n$$\n\n- $B$ is *not* an orthogonal projection matrix. We have\n\n$$\n\\begin{aligned}{B}^{T}\\ne B.\\end{aligned}\n$$\n\n- $C$ is *not* an orthogonal projection matrix. We have\n\n$$\n\\begin{aligned}{C}^{T}\\ne C.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"$A$ only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-95346/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9e81030a-0151-5dea-b9bc-74aae2499482"] :knowledge-point/questions ["q-95346"] :db/ensure [:knowledge-point/validate]} {:db/id "q-95353/selection/e432f1020975ada4c83798ae75bfd6c0ae4dfe63215763f08b8be8ccabf8a5d3" :answer/id #uuid "51972f70-f3c3-5650-8fca-41188ce67d32" :answer/type :answer.type/text :answer/value "$C$ only" :db/ensure [:answer/validate]} {:db/id "q-95353/selection/685c02320dbe687345f93d820499dea4c0c82808b910e8a0e5841f77aa82209d" :answer/id #uuid "29edfeb4-032f-59da-bee7-5b7a9bbb31ed" :answer/type :answer.type/text :answer/value "$A$ only" :db/ensure [:answer/validate]} {:db/id "q-95353/selection/2377e3ffc3b5cd65e1036103e0b988e5af6634b2438c63c3b7cc0592571401ab" :answer/id #uuid "24e018f2-7be3-5fe7-bf01-67409cfa171d" :answer/type :answer.type/text :answer/value "$A$ and $C$ only" :db/ensure [:answer/validate]} {:db/id "q-95353/selection/e956c3af673c94782038951d8de50bf89c9a53bf4daf2ca6725a4bea4229074c" :answer/id #uuid "d0e97ec8-6341-5b69-a6a4-8857934884f0" :answer/type :answer.type/text :answer/value "$B$ only" :db/ensure [:answer/validate]} {:db/id "q-95353/selection/9ed3305a02906a861616af6ff886306c4a2a74885d99f506419451b33c7c9d2d" :answer/id #uuid "c1ffef19-03bc-5c8c-862d-db4887c5d8f9" :answer/type :answer.type/text :answer/value "$B$ and $C$ only" :db/ensure [:answer/validate]} {:db/id "q-95353/selection" :answer-field/id #uuid "1fbe3176-581e-5f1e-84bf-556b4edc5a56" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-95353/selection/e956c3af673c94782038951d8de50bf89c9a53bf4daf2ca6725a4bea4229074c" :answer-field/choices ["q-95353/selection/e432f1020975ada4c83798ae75bfd6c0ae4dfe63215763f08b8be8ccabf8a5d3" "q-95353/selection/685c02320dbe687345f93d820499dea4c0c82808b910e8a0e5841f77aa82209d" "q-95353/selection/2377e3ffc3b5cd65e1036103e0b988e5af6634b2438c63c3b7cc0592571401ab" "q-95353/selection/e956c3af673c94782038951d8de50bf89c9a53bf4daf2ca6725a4bea4229074c" "q-95353/selection/9ed3305a02906a861616af6ff886306c4a2a74885d99f506419451b33c7c9d2d"] :db/ensure [:answer-field/validate]} {:db/id "q-95353" :question/id #uuid "386c3ea1-7ed9-5adf-8e0d-b5dbc53aed84" :question/math-academy-id "q-95353" :question/problem "Which of the following are orthogonal projection matrices?\n\n$$\nA=[\\begin{aligned}\\frac{4}{13} & \\frac{6}{13} \\\\ -\\frac{6}{13} & \\frac{4}{13}\\end{aligned}],\\,B=[\\begin{aligned}\\frac{1}{26} & \\frac{5}{26} \\\\ \\frac{5}{26} & \\frac{25}{26}\\end{aligned}],\\,C=[\\begin{aligned}\\frac{3}{4} & \\frac{1}{2} \\\\ \\frac{1}{3} & \\frac{3}{4}\\end{aligned}].\n$$" :question/worked-solution "Recall that $Q$ is an orthogonal projection matrix if and only if ${Q}^{2}=Q$ and ${Q}^{T}=Q.$ \n\nWith that in mind, let's examine our matrices.\n\n- $A$ is *not* an orthogonal projection matrix. We have\n\n$$\n\\begin{aligned}{A}^{T}\\ne A.\\end{aligned}\n$$\n\n- $B$ is an orthogonal projection matrix. We have\n${B}^{T}=B$\nand \n\n$$\n\\begin{aligned}{B}^{2} & =B\\cdot B \\\\  & =[\\begin{aligned}\\frac{1}{26} & \\frac{5}{26} \\\\ \\frac{5}{26} & \\frac{25}{26}\\end{aligned}][\\begin{aligned}\\frac{1}{26} & \\frac{5}{26} \\\\ \\frac{5}{26} & \\frac{25}{26}\\end{aligned}] \\\\  & =\\frac{1}{26}[\\begin{aligned}1 & 5 \\\\ 5 & 25\\end{aligned}]\\cdot \\frac{1}{26}[\\begin{aligned}1 & 5 \\\\ 5 & 25\\end{aligned}] \\\\  & =\\frac{1}{676}[\\begin{aligned}1 & 5 \\\\ 5 & 25\\end{aligned}][\\begin{aligned}1 & 5 \\\\ 5 & 25\\end{aligned}] \\\\  & =\\frac{1}{676}[\\begin{aligned}26 & 130 \\\\ 130 & 650\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{26} & \\frac{5}{26} \\\\ \\frac{5}{26} & \\frac{25}{26}\\end{aligned}] \\\\  & =B.\\end{aligned}\n$$\n\n- $C$ is *not* an orthogonal projection matrix. We have\n\n$$\n\\begin{aligned}{C}^{T}\\ne C.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-95353/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9e81030a-0151-5dea-b9bc-74aae2499482"] :knowledge-point/questions ["q-95353"] :db/ensure [:knowledge-point/validate]} {:db/id "q-95351/selection/cdf913127b34ab5ca859a89e09303f9c25d10326178d90e7da7f32a0b7eb1592" :answer/id #uuid "0d553bbf-8f19-5722-be56-004c94f88994" :answer/type :answer.type/text :answer/value "$A$ and $B$  only" :db/ensure [:answer/validate]} {:db/id "q-95351/selection/2377e3ffc3b5cd65e1036103e0b988e5af6634b2438c63c3b7cc0592571401ab" :answer/id #uuid "7ed11c3b-4177-5582-a120-ee774e00f3ea" :answer/type :answer.type/text :answer/value "$A$ and $C$ only" :db/ensure [:answer/validate]} {:db/id "q-95351/selection/685c02320dbe687345f93d820499dea4c0c82808b910e8a0e5841f77aa82209d" :answer/id #uuid "479e0e57-cbcc-5c0d-8d86-07b03be484c4" :answer/type :answer.type/text :answer/value "$A$ only" :db/ensure [:answer/validate]} {:db/id "q-95351/selection/e432f1020975ada4c83798ae75bfd6c0ae4dfe63215763f08b8be8ccabf8a5d3" :answer/id #uuid "97ff53b4-70ea-59f7-8c35-d45dac08ad07" :answer/type :answer.type/text :answer/value "$C$ only" :db/ensure [:answer/validate]} {:db/id "q-95351/selection/e956c3af673c94782038951d8de50bf89c9a53bf4daf2ca6725a4bea4229074c" :answer/id #uuid "3f25999d-fd3c-5900-940a-101d86ab61e3" :answer/type :answer.type/text :answer/value "$B$ only" :db/ensure [:answer/validate]} {:db/id "q-95351/selection" :answer-field/id #uuid "6d02c784-8c90-5046-8797-41768c233688" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-95351/selection/e956c3af673c94782038951d8de50bf89c9a53bf4daf2ca6725a4bea4229074c" :answer-field/choices ["q-95351/selection/cdf913127b34ab5ca859a89e09303f9c25d10326178d90e7da7f32a0b7eb1592" "q-95351/selection/2377e3ffc3b5cd65e1036103e0b988e5af6634b2438c63c3b7cc0592571401ab" "q-95351/selection/685c02320dbe687345f93d820499dea4c0c82808b910e8a0e5841f77aa82209d" "q-95351/selection/e432f1020975ada4c83798ae75bfd6c0ae4dfe63215763f08b8be8ccabf8a5d3" "q-95351/selection/e956c3af673c94782038951d8de50bf89c9a53bf4daf2ca6725a4bea4229074c"] :db/ensure [:answer-field/validate]} {:db/id "q-95351" :question/id #uuid "091c7b52-e53f-5cf4-a30e-ad08881c7b78" :question/math-academy-id "q-95351" :question/problem "Which of the following are orthogonal projection matrices?\n\n$$\nA=[\\begin{aligned}2 & -1 \\\\ -1 & 3\\end{aligned}],\\,B=[\\begin{aligned}\\frac{9}{10} & -\\frac{3}{10} \\\\ -\\frac{3}{10} & \\frac{1}{10}\\end{aligned}],\\,C=[\\begin{aligned}3 & 2 \\\\ 2 & -1\\end{aligned}].\n$$" :question/worked-solution "Recall that $Q$ is an orthogonal projection matrix if and only if ${Q}^{2}=Q$ and ${Q}^{T}=Q.$ \n\nWith that in mind, let's examine our matrices.\n\n- $A$ is *not* an orthogonal projection matrix. We have\n${A}^{T}=A$\nbut \n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =[\\begin{aligned}2 & -1 \\\\ -1 & 3\\end{aligned}][\\begin{aligned}2 & -1 \\\\ -1 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}5 & -5 \\\\ -5 & 10\\end{aligned}] \\\\  & \\ne A.\\end{aligned}\n$$\n\n- $B$ is an orthogonal projection matrix. Indeed,\n${B}^{T}=B$\nand\n\n$$\n\\begin{aligned}{B}^{2} & =B\\cdot B \\\\  & =[\\begin{aligned}\\frac{9}{10} & -\\frac{3}{10} \\\\ -\\frac{3}{10} & \\frac{1}{10}\\end{aligned}][\\begin{aligned}\\frac{9}{10} & -\\frac{3}{10} \\\\ -\\frac{3}{10} & \\frac{1}{10}\\end{aligned}] \\\\  & =\\frac{1}{10}[\\begin{aligned}9 & -3 \\\\ -3 & 1\\end{aligned}]\\cdot \\frac{1}{10}[\\begin{aligned}9 & -3 \\\\ -3 & 1\\end{aligned}] \\\\  & =\\frac{1}{100}[\\begin{aligned}9 & -3 \\\\ -3 & 1\\end{aligned}][\\begin{aligned}9 & -3 \\\\ -3 & 1\\end{aligned}] \\\\  & =\\frac{1}{100}[\\begin{aligned}90 & -30 \\\\ -30 & 10\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{9}{10} & -\\frac{3}{10} \\\\ -\\frac{3}{10} & \\frac{1}{10}\\end{aligned}] \\\\  & =B.\\end{aligned}\n$$\n\n- $C$ is *not* an orthogonal projection matrix. We have\n${C}^{T}=C$\nbut \n\n$$\n\\begin{aligned}{C}^{2} & =C\\cdot C \\\\  & =[\\begin{aligned}3 & 2 \\\\ 2 & -1\\end{aligned}][\\begin{aligned}3 & 2 \\\\ 2 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}13 & 4 \\\\ 4 & 5\\end{aligned}] \\\\  & \\ne C.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-95351/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9e81030a-0151-5dea-b9bc-74aae2499482"] :knowledge-point/questions ["q-95351"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-40164"] :question/problem "$$\na=[\\begin{aligned}2 \\\\ -1 \\\\ -2\\end{aligned}],\\,P=\\frac{1}{9}[\\begin{aligned}{p}_{11} & {p}_{12} & {p}_{13} \\\\ {p}_{21} & {p}_{22} & {p}_{23} \\\\ {p}_{31} & {p}_{32} & {p}_{33}\\end{aligned}]\n$$\n\nGiven that the vector $a$ above spans ${S}^{⊥},$ and that $P$ is the orthogonal projection matrix of ${R}^{3}$ onto the subspace $S$, what is the value of ${p}_{22}+{p}_{31}?$" :question/worked-solution "First, we find the orthogonal projection matrix onto ${S}^{⊥}=\\text{Span}{a}.$\n\nUsing the formula for the orthogonal projection matrix\n\n$$\n{P}_{{S}^{⊥}}=a({a}^{T}\\,a)^{-1}{a}^{T},\n$$\n\nwe obtain the following:\n\n$$\n\\begin{aligned}{P}_{{S}^{⊥}} & =[\\begin{aligned}2 \\\\ -1 \\\\ -2\\end{aligned}]{([\\begin{aligned}2 & -1 & -2\\end{aligned}][\\begin{aligned}2 \\\\ -1 \\\\ -2\\end{aligned}])}^{-1}[\\begin{aligned}2 & -1 & -2\\end{aligned}] \\\\  & ={9}^{-1}[\\begin{aligned}2 \\\\ -1 \\\\ -2\\end{aligned}][\\begin{aligned}2 & -1 & -2\\end{aligned}] \\\\  & =\\frac{1}{9}[\\begin{aligned}4 & -2 & -4 \\\\ -2 & 1 & 2 \\\\ -4 & 2 & 4\\end{aligned}]\\end{aligned}\n$$\n\nRecall that ${P}_{S}+{P}_{{S}^{⊥}}=I.$ Therefore, \n\n$$\n\\begin{aligned}{P}_{S} & =I-{P}_{{S}^{⊥}} \\\\  & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]-\\frac{1}{9}[\\begin{aligned}4 & -2 & -4 \\\\ -2 & 1 & 2 \\\\ -4 & 2 & 4\\end{aligned}] \\\\  & =\\frac{1}{9}[\\begin{aligned}5 & 2 & 4 \\\\ 2 & 8 & -2 \\\\ 4 & -2 & 5\\end{aligned}].\\end{aligned}\n$$\n\nFinally, ${p}_{22}+{p}_{31}=8+4=12.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-40166/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "52d086cf-0a9c-5baf-9f38-4df5b11d72aa" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-40166/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer/id #uuid "2a9048ab-39ca-5990-aca4-86aa7adf2abb" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "q-40166/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "b8a87826-b5da-5a2d-9055-62594b7a60f7" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-40166/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "57ed0fa2-3778-5385-8d0f-b4ee9c91264b" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-40166/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "0cc5347d-d4a7-57f2-91dd-cd3daa94604e" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-40166/selection" :answer-field/id #uuid "6f0355ab-11fa-537c-a33e-229315a8b087" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-40166/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer-field/choices ["q-40166/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" "q-40166/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" "q-40166/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" "q-40166/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-40166/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-40166" :question/id #uuid "f4a58a21-4451-5e6d-a0d7-be1301771e29" :question/math-academy-id "q-40166" :question/problem "$$\na=[\\begin{aligned}-3 \\\\ -2 \\\\ -1\\end{aligned}],\\,P=\\frac{1}{14}[\\begin{aligned}{p}_{11} & {p}_{12} & {p}_{13} \\\\ {p}_{21} & {p}_{22} & {p}_{23} \\\\ {p}_{31} & {p}_{32} & {p}_{33}\\end{aligned}]\n$$\n\nGiven that the vector $a$ above spans ${S}^{⊥},$ and that $P$ is the orthogonal projection matrix of ${R}^{3}$ onto the subspace $S$, what is the value of ${p}_{22}+{p}_{31}?$" :question/worked-solution "First, we find the orthogonal projection matrix onto ${S}^{⊥}=\\text{Span}{a}.$\n\nUsing the formula for the orthogonal projection matrix\n\n$$\n{P}_{{S}^{⊥}}=a({a}^{T}\\,a)^{-1}{a}^{T},\n$$\n\nwe obtain the following:\n\n$$\n\\begin{aligned}{P}_{{S}^{⊥}} & =[\\begin{aligned}-3 \\\\ -2 \\\\ -1\\end{aligned}]{([\\begin{aligned}-3 & -2 & -1\\end{aligned}][\\begin{aligned}-3 \\\\ -2 \\\\ -1\\end{aligned}])}^{-1}[\\begin{aligned}-3 & -2 & -1\\end{aligned}] \\\\  & =(14)^{-1}[\\begin{aligned}-3 \\\\ -2 \\\\ -1\\end{aligned}][\\begin{aligned}-3 & -2 & -1\\end{aligned}] \\\\  & =\\frac{1}{14}[\\begin{aligned}9 & 6 & 3 \\\\ 6 & 4 & 2 \\\\ 3 & 2 & 1\\end{aligned}]\\end{aligned}\n$$\n\nRecall that ${P}_{S}+{P}_{{S}^{⊥}}=I.$ Therefore, \n\n$$\n\\begin{aligned}{P}_{S} & =I-{P}_{{S}^{⊥}} \\\\  & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]-\\frac{1}{14}[\\begin{aligned}9 & 6 & 3 \\\\ 6 & 4 & 2 \\\\ 3 & 2 & 1\\end{aligned}] \\\\  & =\\frac{1}{14}[\\begin{aligned}5 & -6 & -3 \\\\ -6 & 10 & -2 \\\\ -3 & -2 & 13\\end{aligned}].\\end{aligned}\n$$\n\nFinally, ${p}_{22}+{p}_{31}=10+(-3)=7.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-40166/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0741fad6-3e88-53a4-bb5d-f80e445f8778"] :knowledge-point/questions ["q-40166"] :db/ensure [:knowledge-point/validate]} {:db/id "q-95365/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "d51b63cc-c60e-5d9a-858a-afab015ed696" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-95365/selection/59cabed12271767d3647412725d382bc72464274dc4ac46b4e7903c969156a02" :answer/id #uuid "74ebb756-4201-5abf-b8eb-93dba92c41a4" :answer/type :answer.type/math :answer/value "19" :db/ensure [:answer/validate]} {:db/id "q-95365/selection/801bcdd9cb6a10cec998162e05f71050c8aaf0c6974f095bdcaef715a09f4aee" :answer/id #uuid "87e2832f-a464-5d20-83c2-2b21fc84