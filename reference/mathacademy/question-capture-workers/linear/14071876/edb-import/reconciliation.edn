ademy/reference/mathacademy/question-capture-workers/linear/14071876/state.json" "file_sha256" "108b1a9ca25123f1278ca81da88a7f6facc0968a6f4d38514449d4ecd01b580b"} {"question" "q-40128" "field" nil "attribute" "question/worked-solution" "value" "Recall that the matrix ${P}_{S}=A({A}^{T}\\,A)^{-1}\\,{A}^{T}$ maps any vector $x\\in {R}^{n}$ onto its orthogonal projection in the subspace $S$ spanned by the columns of the matrix $A.$ \n\nIn our case, $A=[\\begin{aligned}3 \\\\ -2 \\\\ 1\\end{aligned}].$ Therefore,\n\n$$\n\\begin{aligned}{P}_{S} & =A({A}^{T}\\,A)^{-1}\\,{A}^{T} \\\\  & =[\\begin{aligned}3 \\\\ -2 \\\\ 1\\end{aligned}]{([\\begin{aligned}3 & -2 & 1\\end{aligned}][\\begin{aligned}3 \\\\ -2 \\\\ 1\\end{aligned}])}^{-1}[\\begin{aligned}3 & -2 & 1\\end{aligned}] \\\\  & =(14)^{-1}[\\begin{aligned}3 \\\\ -2 \\\\ 1\\end{aligned}][\\begin{aligned}3 & -2 & 1\\end{aligned}] \\\\  & =\\frac{1}{14}[\\begin{aligned}9 & -6 & 3 \\\\ -6 & 4 & -2 \\\\ 3 & -2 & 1\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071876/state.json" "file_sha256" "108b1a9ca25123f1278ca81da88a7f6facc0968a6f4d38514449d4ecd01b580b"} {"question" "q-40128" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071876/activity-metadata.json" "file_sha256" "b7c5f82bb3d73c9bbdb55aaeefc59d06b9e7acab459dff5b850a4571c1656032"} {"question" "q-40128" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071876/state.json" "file_sha256" "108b1a9ca25123f1278ca81da88a7f6facc0968a6f4d38514449d4ecd01b580b"} {"question" "q-40128" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\fra