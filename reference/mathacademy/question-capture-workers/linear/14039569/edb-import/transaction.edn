caaf87984357f5d6af66421aad0753c15d921d419a" :answer/id #uuid "08ccffa7-0e8b-5570-b754-d53696a9cabf" :answer/type :answer.type/math :answer/value "64" :db/ensure [:answer/validate]} {:db/id "q-275585/field-1" :answer-field/id #uuid "7bc89ee6-7b05-53be-a8d5-23856f8b47c3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-275585/field-1/0674b229b15216f6ea870ccaaf87984357f5d6af66421aad0753c15d921d419a" :answer-field/choices ["q-275585/field-1/0674b229b15216f6ea870ccaaf87984357f5d6af66421aad0753c15d921d419a"] :db/ensure [:answer-field/validate]} {:db/id "q-275585" :question/id #uuid "14ff8d5f-11fc-5853-ae2e-523aaa9718fa" :question/math-academy-id "q-275585" :question/problem "If $A=[\\begin{aligned}-5 & 3 & 0 \\\\ 1 & 7 & 5 \\\\ 0 & -2 & -3\\end{aligned}],$ then $det(A)=${{field-1}}." :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}-5 & 3 & 0 \\\\ 1 & 7 & 5 \\\\ 0 & -2 & -3\\end{aligned}| & =-5|\\begin{aligned}7 & 5 \\\\ -2 & -3\\end{aligned}|-3|\\begin{aligned}1 & 5 \\\\ 0 & -3\\end{aligned}|+0|\\begin{aligned}1 & 7 \\\\ 0 & -2\\end{aligned}| \\\\  & =-5(-21-(-10))-3(-3-0)+0 \\\\  & =-5\\cdot (-11)-3\\cdot (-3) \\\\  & =55+9 \\\\  & =64\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-275585/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "979859e4-b60c-548d-8da6-b180400e1b07"] :knowledge-point/questions ["q-275585"] :db/ensure [:knowledge-point/validate]} {:db/id "q-280387/field-1/8dacc1c0f941322120ca7c71db0678429f81e185265efeda82b30602107d75bb" :answer/id #uuid "c22de81e-b56f-5bb2-89dd-beb6da000fae" :answer/type :answer.type/math :answer/value "146" :db/ensure [:answer/validate]} {:db/id 17592186277617 :answer-field/choices ["q-280387/field-1/8dacc1c0f941322120ca7c71db0678429f81e185265efeda