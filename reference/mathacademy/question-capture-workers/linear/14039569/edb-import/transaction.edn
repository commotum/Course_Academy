 "4620a567-cdc4-53d7-9a4f-ea734b82495f" :question/math-academy-id "q-38100" :question/problem "Find the value of $|\\begin{aligned}1 & -1 & 2 \\\\ 0 & 4 & 1 \\\\ 0 & 0 & 8\\end{aligned}|.$" :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & -1 & 2 \\\\ 0 & 4 & 1 \\\\ 0 & 0 & 8\\end{aligned}| & =1|\\begin{aligned}4 & 1 \\\\ 0 & 8\\end{aligned}|-(-1)|\\begin{aligned}0 & 1 \\\\ 0 & 8\\end{aligned}|+2|\\begin{aligned}0 & 4 \\\\ 0 & 0\\end{aligned}| \\\\  & =1(32-0)+1(0-0)+2(0-0) \\\\  & =1\\cdot 32 \\\\  & =32\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-38100/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "979859e4-b60c-548d-8da6-b180400e1b07"] :knowledge-point/questions ["q-38100"] :db/ensure [:knowledge-point/validate]} {:db/id "q-77477/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "ea8d1bfd-dd9d-5df0-bb07-aecfb19ecda9" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-77477/selection/35ffc558ac75968b6d9a8a0179c93d2c14c604859f50a146485ab0309ffdde65" :answer/id #uuid "e3c5ada5-b582-58a4-9b16-63c359d07add" :answer/type :answer.type/text :answer/value "I and III  only" :db/ensure [:answer/validate]} {:db/id "q-77477/selection/18f1ea50d5b97ea6ddf4ed047cc851740c3854be5650eb9e76df7f5a3d1456f8" :answer/id #uuid "9def4b4a-1dd6-546f-a05a-5cec780136ac" :answer/type :answer.type/text :answer/value "I  only" :db/ensure [:answer/validate]} {:db/id "q-77477/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "7e56084e-c049-5d03-8053-7d8f8a131ad4" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-77477/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "19695a11-6184-50a6-b7e4-a8ce98068372" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-77477/selection" :answer-field/id #uuid "e5ffcb6e-0917-5f6f-a0aa-f5850879ca37" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-77477/selection/18f1ea50d5b97ea6ddf4ed047cc851740c3854be5650eb9e76df7f5a3d1456f8" :answer-field/choices ["q-77477/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-77477/selection/35ffc558ac75968b6d9a8a0179c93d2c14c604859f50a146485ab0309ffdde65" "q-77477/selection/18f1ea50d5b97ea6ddf4ed047cc851740c3854be5650eb9e76df7f5a3d1456f8" "q-77477/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-77477/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c"] :db/ensure [:answer-field/validate]} {:db/id "q-77477" :question/id #uuid "f488e99f-6a91-5199-9a3f-4686ca4250e2" :question/math-academy-id "q-77477" :question/problem "Which of the following statements are true regarding the matrix $S$ given below?\n\n- $S$ is **not** a singular matrix\n- $S$ is a singular matrix\n- $det(S)=\\sqrt{3}$\n\n$$\nS=[\\begin{aligned}1 & 2 & \\,0 \\\\ 2 & \\sqrt{3} & \\,\\,-1 \\\\ \\sqrt{3} & 4 & \\,\\,-\\sqrt{3}\\end{aligned}]\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(S) & =|\\begin{aligned}1 & 2 & \\,0 \\\\ 2 & \\sqrt{3} & \\,\\,-1 \\\\ \\sqrt{3} & 4 & \\,\\,-\\sqrt{3}\\end{aligned}| \\\\  & =1|\\begin{aligned}\\sqrt{3} & \\,\\,-1 \\\\ 4 & \\,\\,-\\sqrt{3}\\end{aligned}|-2|\\begin{aligned}2 & \\,-1 \\\\ \\sqrt{3} & \\,-\\sqrt{3}\\end{aligned}|+0|\\begin{aligned}2 & \\sqrt{3} \\\\ \\sqrt{3} & 4\\end{aligned}| \\\\  & =1(-{(\\sqrt{3})}^{2}+4)-2(-2\\sqrt{3}+\\sqrt{3})+0 \\\\  & =(-3+4)-2\\cdot (-\\sqrt{3}) \\\\  & =1+2\\sqrt{3}\\end{aligned}\n$$\n\nSince $det(S)=1+2\\sqrt{3}\\ne 0$, the matrix is **not ** singular. \n\nTherefore, only statement I is true." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-77477/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93"] :knowledge-point/questions ["q-77477"] :db/ensure [:knowledge-point/validate]} {:db/id "q-128476/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "8a191dba-16dd-5b91-b92c-74456c9286df" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-128476/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "e0e1a3d4-3256-56a2-8579-d0cb7725057f" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-128476/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "d91db950-9a7f-5572-9414-c66c3ae0f4a5" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-128476/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "b5b00579-93ef-5741-b329-98cc98e20e8c" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-128476/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "8dac9c91-67ef-5130-939b-a0b625916607" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-128476/selection" :answer-field/id #uuid "9d5536c7-7d93-5b6f-bcb0-08074eb5662e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-128476/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer-field/choices ["q-128476/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-128476/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-128476/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-128476/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-128476/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981"] :db/ensure [:answer-field/validate]} {:db/id "q-128476" :question/id #uuid "1de7b7b6-d74a-53dc-9249-a5265a42e232" :question/math-academy-id "q-128476" :question/problem "Which of the following statements are true regarding the matrix $T$ given below?\n\n- $T$ is a singular matrix\n- $T$ is **not** a singular matrix\n- $det(T)=-30$\n\n \n\n$$\nT=[\\begin{aligned}1 & 3 & -5 \\\\ 2 & 1 & 1 \\\\ 1 & 3 & 1\\end{aligned}]\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:  \n\n$$\n\\begin{aligned}det(T) & =|\\begin{aligned}1 & 3 & -5 \\\\ 2 & 1 & 1 \\\\ 1 & 3 & 1\\end{aligned}| \\\\  & =1|\\begin{aligned}1 & 1 \\\\ 3 & 1\\end{aligned}|-3|\\begin{aligned}2 & 1 \\\\ 1 & 1\\end{aligned}|-5|\\begin{aligned}2 & 1 \\\\ 1 & 3\\end{aligned}| \\\\  & =1(1-3)-3(2-1)-5(6-1) \\\\  & =1\\cdot (-2)-3\\cdot 1-5\\cdot 5 \\\\  & =-2-3-25 \\\\  & =-30\\end{aligned}\n$$\n\n \n\nSince $det(T)=-30\\ne 0$, the matrix is **not** singular. \n\nTherefore, only statements II and III are true." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-128476/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93"] :knowledge-point/questions ["q-128476"] :db/ensure [:knowledge-point/validate]} {:db/id "q-77478/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "b9405d7f-2eab-599d-9ba5-e87cacabdf95" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-77478/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "8e92102a-d2be-58f6-bc96-f9d23e118a46" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-77478/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "341dcfd3-2a7a-54a5-a51a-2cd79256e8e3" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-77478/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "8b70e71f-f769-57db-b7fb-a5767752d8e1" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-77478/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "916c7451-7165-5939-b18f-f24a87f57db6" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-77478/selection" :answer-field/id #uuid "92720cbe-efa5-5123-a597-8ee071c3b10d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-77478/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer-field/choices ["q-77478/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-77478/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-77478/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-77478/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-77478/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b"] :db/ensure [:answer-field/validate]} {:db/id "q-77478" :question/id #uuid "24cc52a8-4124-5277-acdf-def6004941a2" :question/math-academy-id "q-77478" :question/problem "Which of the following statements are true regarding the matrix $R$ given below?\n\n- $R$ is a singular matrix\n- $det(R)=0$\n- $det(R)=1$\n\n \n\n$$\nR=[\\begin{aligned}\\frac{3}{5} & \\frac{2}{5} & \\frac{1}{5} \\\\ 1 & 2 & 3 \\\\ 0 & \\frac{1}{2} & 1\\end{aligned}]\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(R) & =|\\begin{aligned}\\frac{3}{5} & \\frac{2}{5} & \\frac{1}{5} \\\\ 1 & 2 & 3 \\\\ 0 & \\frac{1}{2} & 1\\end{aligned}| \\\\  & =\\frac{3}{5}|\\begin{aligned}2 & 3 \\\\ \\frac{1}{2} & 1\\end{aligned}|-\\frac{2}{5}|\\begin{aligned}1 & 3 \\\\ 0 & 1\\end{aligned}|+\\frac{1}{5}|\\begin{aligned}1 & 2 \\\\ 0 & \\frac{1}{2}\\end{aligned}| \\\\  & =\\frac{3}{5}(2-\\frac{3}{2})-\\frac{2}{5}(1-0)+\\frac{1}{5}(\\frac{1}{2}-0) \\\\  & =\\frac{3}{5}\\cdot \\frac{1}{2}-\\frac{2}{5}\\cdot 1+\\frac{1}{5}\\cdot \\frac{1}{2} \\\\  & =\\frac{3}{10}-\\frac{2}{5}+\\frac{1}{10} \\\\  & =0\\end{aligned}\n$$\n\n \n\nSince $det(R)=0$, the matrix is singular. \n\nTherefore, only statements I and II are true." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-77478/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93"] :knowledge-point/questions ["q-77478"] :db/ensure [:knowledge-point/validate]} {:db/id "q-18252/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "8e5485a5-a0ae-50cc-8dbe-9aab77f55a9b" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-18252/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "e68058e1-4682-5ab8-b703-62cc2f118682" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-18252/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "45831162-173d-54b1-b3e2-550e320a21bf" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-18252/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "d6bee06f-bbf2-5d38-83f4-80d000dc236e" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-18252/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "c19ee59f-4480-595d-be78-0612dc30906d" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-18252/selection" :answer-field/id #uuid "abfe5887-0d05-5018-9ee0-2ab1a972fca7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-18252/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-18252/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-18252/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-18252/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-18252/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-18252/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133"] :db/ensure [:answer-field/validate]} {:db/id "q-18252" :question/id #uuid "799ed291-cfbc-56bf-891a-7ba1b277d3e5" :question/math-academy-id "q-18252" :question/problem "Find the possible values of the constant $p$ given that the matrix $[\\begin{aligned}1 & 0 & 1 \\\\ 2 & 1 & 2 \\\\ 6 & -5 & 2p-4\\end{aligned}]$ is singular." :question/worked-solution "First, let's use our formula to find an expression for the determinant in terms of $p:$\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 0 & 1 \\\\ 2 & 1 & 2 \\\\ 6 & -5 & 2p-4\\end{aligned}| & =1|\\begin{aligned}1 & 2 \\\\ -5 & 2p-4\\end{aligned}|-0|\\begin{aligned}2 & 2 \\\\ 6 & 2p-4\\end{aligned}|+1|\\begin{aligned}2 & 1 \\\\ 6 & -5\\end{aligned}| \\\\  & =(2p-4+10)-0+(-10-6) \\\\  & =2p-4+10-10-6 \\\\  & =2p-10\\end{aligned}\n$$\n\nSince the matrix is singular, the determinant is $0.$ So,  we have:\n\n \n\n$$\n\\begin{aligned}2p-10 & =0 \\\\ 2p & =10 \\\\ p & =\\frac{10}{2} \\\\  & =5\\end{aligned}\n$$\n\nTherefore, the solution is $p=5.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-18252/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ab642ad6-d9e0-5734-83b4-81627b9132eb"] :knowledge-point/questions ["q-18252"] :db/ensure [:knowledge-point/validate]} {:db/id "q-9911/selection/543ce47590e071f5bdf2a2c86bfc500b659f19e80bd5469d3d7133e7682583ea" :answer/id #uuid "bf3791e4-4ff9-5228-b34d-8c28ddd53705" :answer/type :answer.type/text :answer/value "$0$ and $-3$ only" :db/ensure [:answer/validate]} {:db/id "q-9911/selection/bd9c337e44dece63cb4044160620307b54b07f189c1fb1d9a3806b169f9014f4" :answer/id #uuid "1e2b4530-3acf-5293-ad27-be2c0e8f23dc" :answer/type :answer.type/text :answer/value "$3$ only" :db/ensure [:answer/validate]} {:db/id "q-9911/selection/11f3ac18494484f8b3500d7ab98b2ef765a9fba113415c5e058be57093fc0c7d" :answer/id #uuid "2be20272-a5bf-59ff-9941-778dee46a8a4" :answer/type :answer.type/text :answer/value "$0$ only" :db/ensure [:answer/validate]} {:db/id "q-9911/selection/dc34a260f42357d60af4c0450afcbd21506f1be9f4bcd385d1d3eb896eda5ee7" :answer/id #uuid "541648f0-0186-5eeb-a1cc-3f78dbdc070b" :answer/type :answer.type/text :answer/value "$0$ and $3$ only" :db/ensure [:answer/validate]} {:db/id "q-9911/selection/04b6ec37da6c899f32dae53427e50e827daa3c5b7b5a84b30d5282329f8e5351" :answer/id #uuid "a9f6f207-5255-5a28-a04e-80e38de92f2d" :answer/type :answer.type/text :answer/value "$-3$ only" :db/ensure [:answer/validate]} {:db/id "q-9911/selection" :answer-field/id #uuid "39ec0585-2cae-5922-9587-17c41dd6003c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-9911/selection/dc34a260f42357d60af4c0450afcbd21506f1be9f4bcd385d1d3eb896eda5ee7" :answer-field/choices ["q-9911/selection/543ce47590e071f5bdf2a2c86bfc500b659f19e80bd5469d3d7133e7682583ea" "q-9911/selection/bd9c337e44dece63cb4044160620307b54b07f189c1fb1d9a3806b169f9014f4" "q-9911/selection/11f3ac18494484f8b3500d7ab98b2ef765a9fba113415c5e058be57093fc0c7d" "q-9911/selection/dc34a260f42357d60af4c0450afcbd21506f1be9f4bcd385d1d3eb896eda5ee7" "q-9911/selection/04b6ec37da6c899f32dae53427e50e827daa3c5b7b5a84b30d5282329f8e5351"] :db/ensure [:answer-field/validate]} {:db/id "q-9911" :question/id #uuid "b27fea7a-77af-5ede-b5e2-28d0928e1d9b" :question/math-academy-id "q-9911" :question/problem "Find the possible values of the constant $k$ given that the matrix\n$[\\begin{aligned}1 & -1 & k \\\\ 1 & k & -k \\\\ 5 & k & k\\end{aligned}]$ is singular." :question/worked-solution "First, let's use our formula to find an expression for the determinant in terms of $k:$\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & -1 & k \\\\ 1 & k & -k \\\\ 5 & k & k\\end{aligned}| & =1|\\begin{aligned}k & -k \\\\ k & k\\end{aligned}|-(-1)|\\begin{aligned}1 & -k \\\\ 5 & k\\end{aligned}|+k|\\begin{aligned}1 & k \\\\ 5 & k\\end{aligned}| \\\\  & =({k}^{2}+{k}^{2})+(k+5k)+k(k-5k) \\\\  & =2{k}^{2}+6k+k\\cdot (-4k) \\\\  & =2{k}^{2}+6k-4{k}^{2} \\\\  & =-2{k}^{2}+6k\\end{aligned}\n$$\n\nSince the matrix is singular, the determinant is $0,$ and we have:\n\n$$\n\\begin{aligned}-2{k}^{2}+6k & =0 \\\\ k(-2k+6) & =0\\end{aligned}\n$$\n\nTherefore, the solutions are $k=0$ and $k=3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-9911/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ab642ad6-d9e0-5734-83b4-81627b9132eb"] :knowledge-point/questions ["q-9911"] :db/ensure [:knowledge-point/validate]} {:db/id "q-18256/selection/8df015974cc00a3a01bea8aa95b5f9255b5fff5f87b5fd591b2ab2b046e6ba32" :answer/id #uuid "b476adf8-40ae-54da-ac98-df291a8dd1ff" :answer/type :answer.type/text :answer/value "$-\\frac{5}{3}$ and $1$ only" :db/ensure [:answer/validate]} {:db/id "q-18256/selection/05255b415c7ae98b6078a276316f780b3e0432939dbd08bc67c4ab6ef8159f4c" :answer/id #uuid "20471aec-848e-513e-968a-d6aec97caa96" :answer/type :answer.type/text :answer/value "$-\\frac{25}{9}$ and $1$ only" :db/ensure [:answer/validate]} {:db/id "q-18256/selection/eb21c295776988920a82e759763aade7d2dbfa4b019de00e4c9266202abefa55" :answer/id #uuid "f5001a26-00b9-5b68-b868-a2749147bd0f" :answer/type :answer.type/text :answer/value "$-\\frac{5}{3}$ and $-1$ only" :db/ensure [:answer/validate]} {:db/id "q-18256/selection/f9958053a1c60bc7f7376be2e79916ac63d39427bfdb2f7dfbc9d2bf4f38648f" :answer/id #uuid "e19af8f1-f3a5-5db5-ac86-072cb48385c8" :answer/type :answer.type/text :answer/value "$-\\frac{25}{9}$ and $-1$ only" :db/ensure [:answer/validate]} {:db/id "q-18256/selection/c0cdde82342237d57eece7e4773614ba7ad9a9111644679a3f13791e099f52e7" :answer/id #uuid "09c5767d-a3b0-5d1a-860a-026fafd6510c" :answer/type :answer.type/text :answer/value "$-1$ only" :db/ensure [:answer/validate]} {:db/id "q-18256/selection" :answer-field/id #uuid "59e39d2d-4575-5e43-a400-caa5668def86" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-18256/selection/f9958053a1c60bc7f7376be2e79916ac63d39427bfdb2f7dfbc9d2bf4f38648f" :answer-field/choices ["q-18256/selection/8df015974cc00a3a01bea8aa95b5f9255b5fff5f87b5fd591b2ab2b046e6ba32" "q-18256/selection/05255b415c7ae98b6078a276316f780b3e0432939dbd08bc67c4ab6ef8159f4c" "q-18256/selection/eb21c295776988920a82e759763aade7d2dbfa4b019de00e4c9266202abefa55" "q-18256/selection/f9958053a1c60bc7f7376be2e79916ac63d39427bfdb2f7dfbc9d2bf4f38648f" "q-18256/selection/c0cdde82342237d57eece7e4773614ba7ad9a9111644679a3f13791e099f52e7"] :db/ensure [:answer-field/validate]} {:db/id "q-18256" :question/id #uuid "01aa8d57-113b-5436-b1ef-e962e4723b9f" :question/math-academy-id "q-18256" :question/problem "Given that the determinant of \n$[\\begin{aligned}4 & 2 & 3 \\\\ -3y & -2 & 1 \\\\ 2 & y & -5\\end{aligned}]$\n is $81,$ find all the possible values of $y.$" :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $y:$\n\n$$\n\\begin{aligned}|\\begin{aligned}4 & 2 & 3 \\\\ -3y & -2 & 1 \\\\ 2 & y & -5\\end{aligned}| & =4|\\begin{aligned}-2 & 1 \\\\ y & -5\\end{aligned}|-2|\\begin{aligned}-3y & 1 \\\\ 2 & -5\\end{aligned}|+3|\\begin{aligned}-3y & -2 \\\\ 2 & y\\end{aligned}| \\\\  & =4\\cdot (10-y)-2\\cdot (15y-2)+3\\cdot (-3{y}^{2}+4) \\\\  & =40-4y-30y+4-9{y}^{2}+12 \\\\  & =-9{y}^{2}-34y+56\\end{aligned}\n$$\n\nSince the determinant of the matrix is $81,$ we have:\n\n$$\n\\begin{aligned}-9{y}^{2}-34y+56 & =81 \\\\ -9{y}^{2}-34y-25 & =0 \\\\ 9{y}^{2}+34y+25 & =0 \\\\ y & =\\frac{-34\\pm \\sqrt{{34}^{2}-4\\cdot 9\\cdot 25}}{2\\cdot 9} \\\\  & =\\frac{-34\\pm \\sqrt{256}}{18} \\\\  & =\\frac{-34\\pm 16}{18} \\\\  & =\\frac{-17\\pm 8}{9}\\end{aligned}\n$$\n\nTherefore, the solutions are $y=-\\frac{25}{9}$ and $y=-1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-18256/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ab642ad6-d9e0-5734-83b4-81627b9132eb"] :knowledge-point/questions ["q-18256"] :db/ensure [:knowledge-point/validate]} {:db/id "q-18272/selection/20da195a063838357fb1f41444fcd9c5f9c0f60f914e5562cee11ed55ea23f0e" :answer/id #uuid "b3d28b60-d649-5c6d-8573-0304c956c863" :answer/type :answer.type/text :answer/value "$4$ only" :db/ensure [:answer/validate]} {:db/id "q-18272/selection/a52663e8a1d61a7b7262e7fc82c53f8902bd512c8771866cadfc2c5696b0894b" :answer/id #uuid "6cf0f426-12d6-5ead-9702-991f8e82b826" :answer/type :answer.type/text :answer/value "$5$ only" :db/ensure [:answer/validate]} {:db/id "q-18272/selection/76932d8d844b1838096a047696ec4dc7f031cfffa56c7d01cdc3226eb3b47c94" :answer/id #uuid "9caf0e2d-0e52-528d-9644-e1afdc7bc6e8" :answer/type :answer.type/text :answer/value "$-2$ and $5$ only" :db/ensure [:answer/validate]} {:db/id "q-18272/selection/390c833ad16c22f2126a406fa4e039ee226a6c3445b3371d829bfc3d07ffd2a1" :answer/id #uuid "9fcad194-d0fc-5eab-847b-e2ee02f0d1dc" :answer/type :answer.type/text :answer/value "$2$ and $4$ only" :db/ensure [:answer/validate]} {:db/id "q-18272/selection/e92488b3fbf0bacb6ff33fe7f9b1e122de5379ee9e4cb740b5b6a4e421747607" :answer/id #uuid "6aeafd29-6f04-5efa-b049-57d00d3068b5" :answer/type :answer.type/text :answer/value "$4$ and $5$ only" :db/ensure [:answer/validate]} {:db/id "q-18272/selection" :answer-field/id #uuid "47ef13ae-3048-55d4-a544-a1da4c5bbca1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-18272/selection/76932d8d844b1838096a047696ec4dc7f031cfffa56c7d01cdc3226eb3b47c94" :answer-field/choices ["q-18272/selection/20da195a063838357fb1f41444fcd9c5f9c0f60f914e5562cee11ed55ea23f0e" "q-18272/selection/a52663e8a1d61a7b7262e7fc82c53f8902bd512c8771866cadfc2c5696b0894b" "q-18272/selection/76932d8d844b1838096a047696ec4dc7f031cfffa56c7d01cdc3226eb3b47c94" "q-18272/selection/390c833ad16c22f2126a406fa4e039ee226a6c3445b3371d829bfc3d07ffd2a1" "q-18272/selection/e92488b3fbf0bacb6ff33fe7f9b1e122de5379ee9e4cb740b5b6a4e421747607"] :db/ensure [:answer-field/validate]} {:db/id "q-18272" :question/id #uuid "408197de-567d-5d88-85f3-7d29be5c6d83" :question/math-academy-id "q-18272" :question/problem "Given that $M=[\\begin{aligned}0 & -3 & 2 \\\\ 1 & p & 0 \\\\ p-3 & 0 & -1\\end{aligned}]$ and $det(M)=-23,$ find all the possible values of $p.$" :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $p:$\n\n$$\n\\begin{aligned}\\text{det}(M) & =|\\begin{aligned}0 & -3 & 2 \\\\ 1 & p & 0 \\\\ p-3 & 0 & -1\\end{aligned}| \\\\  & =0|\\begin{aligned}p & 0 \\\\ 0 & -1\\end{aligned}|-(-3)|\\begin{aligned}1 & 0 \\\\ p-3 & -1\\end{aligned}|+2|\\begin{aligned}1 & p \\\\ p-3 & 0\\end{aligned}| \\\\  & =0+3\\cdot (-1)+2\\cdot (3p-{p}^{2}) \\\\  & =-3-2{p}^{2}+6p \\\\  & =-2{p}^{2}+6p-3\\end{aligned}\n$$\n\nSince the determinant of the matrix is $-23,$ we have:\n\n$$\n\\begin{aligned}-2{p}^{2}+6p-3 & =-23 \\\\ 2{p}^{2}-6p-20 & =0 \\\\ {p}^{2}-3p-10 & =0 \\\\ p & =\\frac{-(-3)\\pm \\sqrt{(-3)^{2}-4\\cdot 1\\cdot (-10)}}{2\\cdot 1} \\\\  & =\\frac{3\\pm \\sqrt{49}}{2} \\\\  & =\\frac{3\\pm 7}{2}\\end{aligned}\n$$\n\nTherefore,  the solutions are $p=-2$ and $p=5.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-18272/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ab642ad6-d9e0-5734-83b4-81627b9132eb"] :knowledge-point/questions ["q-18272"] :db/ensure [:knowledge-point/validate]}]
