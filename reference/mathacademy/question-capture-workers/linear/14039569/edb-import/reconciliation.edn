5e94747cc6"} {"question" "q-38100" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-38100" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-24"] ["math" "15"] ["math" "18"] ["math" "24"] ["math" "32"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-38100" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "32"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-77477" "field" nil "attribute" "question/problem" "value" "Which of the following statements are true regarding the matrix $S$ given below?\n\n- $S$ is **not** a singular matrix\n- $S$ is a singular matrix\n- $det(S)=\\sqrt{3}$\n\n$$\nS=[\\begin{aligned}1 & 2 & \\,0 \\\\ 2 & \\sqrt{3} & \\,\\,-1 \\\\ \\sqrt{3} & 4 & \\,\\,-\\sqrt{3}\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-77477" "field" nil "attribute" "question/worked-solution" "value" "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(S) & =|\\begin{aligned}1 & 2 & \\,0 \\\\ 2 & \\sqrt{3} & \\,\\,-1 \\\\ \\sqrt{3} & 4 & \\,\\,-\\sqrt{3}\\end{aligned}| \\\\  & =1|\\begin{aligned}\\sqrt{3} & \\,\\,-1 \\\\ 4 & \\,\\,-\\sqrt{3}\\end{aligned}|-2|\\begin{aligned}2 & \\,-1 \\\\ \\sqrt{3} & \\,-\\sqrt{3}\\end{aligned}|+0|\\begin{aligned}2 & \\sqrt{3} \\\\ \\sqrt{3} & 4\\end{aligned}| \\\\  & =1(-{(\\sqrt{3})}^{2}+4)-2(-2\\sqrt{3}+\\sqrt{3})+0 \\\\  & =(-3+4)-2\\cdot (-\\sqrt{3}) \\\\  & =1+2\\sqrt{3}\\end{aligned}\n$$\n\nSince $det(S)=1+2\\sqrt{3}\\ne 0$, the matrix is **not ** singular. \n\nTherefore, only statement I is true." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-77477" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/activity-metadata.json" "file_sha256" "9baffd44875b5a849fdb95dc21f8df6622eeea1f939b9623a8eeea5e94747cc6"} {"question" "q-77477" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-77477" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I  only"] ["text" "I and III  only"] ["text" "II and III only"] ["text" "II only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-77477" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "I  only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-38182" "field" nil "attribute" "question/problem" "value" "Which of the following statements are true regarding the matrix $Q$ given below?\n\n- $Q$ is **not** a singular matrix\n- $Q$ is a singular matrix\n- $det(Q)=-5$\n\n$$\nQ=[\\begin{aligned}0 & 3 & 6 \\\\ 1 & 4 & 7 \\\\ 2 & 5 & 8\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-38182" "field" nil "attribute" "question/worked-solution" "value" "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(Q) & =|\\begin{aligned}0 & 3 & 6 \\\\ 1 & 4 & 7 \\\\ 2 & 5 & 8\\end{aligned}| \\\\  & =0|\\begin{aligned}4 & 7 \\\\ 5 & 8\\end{aligned}|-3|\\begin{aligned}1 & 7 \\\\ 2 & 8\\end{aligned}|+6|\\begin{aligned}1 & 4 \\\\ 2 & 5\\end{aligned}| \\\\  & =0-3(8-14)+6(5-8) \\\\  & =0-3\\cdot (-6)+6\\cdot (-3) \\\\  & =18-18 \\\\  & =0\\end{aligned}\n$$\n\nSince $det(Q)=0$, the matrix is singular. \n\nTherefore, only statement II is true." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-38182" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/activity-metadata.json" "file_sha256" "9baffd44875b5a849fdb95dc21f8df6622eeea1f939b9623a8eeea5e94747cc6"} {"question" "q-38182" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-38182" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and III only"] ["text" "I only"] ["text" "II and III only"] ["text" "II only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-38182" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "II only"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-128484" "field" nil "attribute" "question/problem" "value" "Which of the following statements are true regarding the matrix $R$ given below?\n\n- $R$ is a singular matrix\n- $det(R)=0$\n- $det(R)=1$\n\n \n\n$$\nR=[\\begin{aligned}2 & \\sqrt{2} & 2 \\\\ \\frac{1}{2} & 0 & -1 \\\\ 1 & \\sqrt{2} & 4\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-128484" "field" nil "attribute" "question/worked-solution" "value" "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(R) & =|\\begin{aligned}2 & \\sqrt{2} & 2 \\\\ \\frac{1}{2} & 0 & -1 \\\\ 1 & \\sqrt{2} & 4\\end{aligned}| \\\\  & =2|\\begin{aligned}0 & -1 \\\\ \\sqrt{2} & 4\\end{aligned}|-\\sqrt{2}|\\begin{aligned}\\frac{1}{2} & -1 \\\\ 1 & 4\\end{aligned}|+2|\\begin{aligned}\\frac{1}{2} & 0 \\\\ 1 & \\sqrt{2}\\end{aligned}| \\\\  & =2(0+\\sqrt{2})-\\sqrt{2}(2+1)+2(\\frac{\\sqrt{2}}{2}-0) \\\\  & =2\\cdot \\sqrt{2}-\\sqrt{2}\\cdot 3+2\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =2\\sqrt{2}-3\\sqrt{2}+\\sqrt{2} \\\\  & =0\\end{aligned}\n$$\n\n \n\nSince $det(R)=0$, the matrix is singular. \n\nTherefore, only statements I and II are true." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-128484" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/activity-metadata.json" "file_sha256" "9baffd44875b5a849fdb95dc21f8df6622eeea1f939b9623a8eeea5e94747cc6"} {"question" "q-128484" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-128484" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I and III only"] ["text" "I only"] ["text" "II only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-128484" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "I and II only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-128476" "field" nil "attribute" "question/problem" "value" "Which of the following statements are true regarding the matrix $T$ given below?\n\n- $T$ is a singular matrix\n- $T$ is **not** a singular matrix\n- $det(T)=-30$\n\n \n\n$$\nT=[\\begin{aligned}1 & 3 & -5 \\\\ 2 & 1 & 1 \\\\ 1 & 3 & 1\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-128476" "field" nil "attribute" "question/worked-solution" "value" "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:  \n\n$$\n\\begin{aligned}det(T) & =|\\begin{aligned}1 & 3 & -5 \\\\ 2 & 1 & 1 \\\\ 1 & 3 & 1\\end{aligned}| \\\\  & =1|\\begin{aligned}1 & 1 \\\\ 3 & 1\\end{aligned}|-3|\\begin{aligned}2 & 1 \\\\ 1 & 1\\end{aligned}|-5|\\begin{aligned}2 & 1 \\\\ 1 & 3\\end{aligned}| \\\\  & =1(1-3)-3(2-1)-5(6-1) \\\\  & =1\\cdot (-2)-3\\cdot 1-5\\cdot 5 \\\\  & =-2-3-25 \\\\  & =-30\\end{aligned}\n$$\n\n \n\nSince $det(T)=-30\\ne 0$, the matrix is **not** singular. \n\nTherefore, only statements II and III are true." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-128476" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/activity-metadata.json" "file_sha256" "9baffd44875b5a849fdb95dc21f8df6622eeea1f939b9623a8eeea5e94747cc6"} {"question" "q-128476" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-128476" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and III only"] ["text" "I only"] ["text" "II and III only"] ["text" "II only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-128476" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "II and III only"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-77478" "field" nil "attribute" "question/problem" "value" "Which of the following statements are true regarding the matrix $R$ given below?\n\n- $R$ is a singular matrix\n- $det(R)=0$\n- $det(R)=1$\n\n \n\n$$\nR=[\\begin{aligned}\\frac{3}{5} & \\frac{2}{5} & \\frac{1}{5} \\\\ 1 & 2 & 3 \\\\ 0 & \\frac{1}{2} & 1\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-77478" "field" nil "attribute" "question/worked-solution" "value" "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(R) & =|\\begin{aligned}\\frac{3}{5} & \\frac{2}{5} & \\frac{1}{5} \\\\ 1 & 2 & 3 \\\\ 0 & \\frac{1}{2} & 1\\end{aligned}| \\\\  & =\\frac{3}{5}|\\begin{aligned}2 & 3 \\\\ \\frac{1}{2} & 1\\end{aligned}|-\\frac{2}{5}|\\begin{aligned}1 & 3 \\\\ 0 & 1\\end{aligned}|+\\frac{1}{5}|\\begin{aligned}1 & 2 \\\\ 0 & \\frac{1}{2}\\end{aligned}| \\\\  & =\\frac{3}{5}(2-\\frac{3}{2})-\\frac{2}{5}(1-0)+\\frac{1}{5}(\\frac{1}{2}-0) \\\\  & =\\frac{3}{5}\\cdot \\frac{1}{2}-\\frac{2}{5}\\cdot 1+\\frac{1}{5}\\cdot \\frac{1}{2} \\\\  & =\\frac{3}{10}-\\frac{2}{5}+\\frac{1}{10} \\\\  & =0\\end{aligned}\n$$\n\n \n\nSince $det(R)=0$, the matrix is singular. \n\nTherefore, only statements I and II are true." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-77478" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/activity-metadata.json" "file_sha256" "9baffd44875b5a849fdb95dc21f8df6622eeea1f939b9623a8eeea5e94747cc6"} {"question" "q-77478" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-77478" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I and III only"] ["text" "I only"] ["text" "II and III only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-77478" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "I and II only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-18252" "field" nil "attribute" "question/problem" "value" "Find the possible values of the constant $p$ given that the matrix $[\\begin{aligned}1 & 0 & 1 \\\\ 2 & 1 & 2 \\\\ 6 & -5 & 2p-4\\end{aligned}]$ is singular." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-18252" "field" nil "attribute" "question/worked-solution" "value" "First, let's use our formula to find an expression for the determinant in terms of $p:$\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 0 & 1 \\\\ 2 & 1 & 2 \\\\ 6 & -5 & 2p-4\\end{aligned}| & =1|\\begin{aligned}1 & 2 \\\\ -5 & 2p-4\\end{aligned}|-0|\\begin{aligned}2 & 2 \\\\ 6 & 2p-4\\end{aligned}|+1|\\begin{aligned}2 & 1 \\\\ 6 & -5\\end{aligned}| \\\\  & =(2p-4+10)-0+(-10-6) \\\\  & =2p-4+10-10-6 \\\\  & =2p-10\\end{aligned}\n$$\n\nSince the matrix is singular, the determinant is $0.$ So,  we have:\n\n \n\n$$\n\\begin{aligned}2p-10 & =0 \\\\ 2p & =10 \\\\ p & =\\frac{10}{2} \\\\  & =5\\end{aligned}\n$$\n\nTherefore, the solution is $p=5.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-18252" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/activity-metadata.json" "file_sha256" "9baffd44875b5a849fdb95dc21f8df6622eeea1f939b9623a8eeea5e94747cc6"} {"question" "q-18252" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-18252" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-3"] ["math" "-5"] ["math" "2"] ["math" "3"] ["math" "5"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-18252" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "5"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-9911" "field" nil "attribute" "question/problem" "value" "Find the possible values of the constant $k$ given that the matrix\n$[\\begin{aligned}1 & -1 & k \\\\ 1 & k & -k \\\\ 5 & k & k\\end{aligned}]$ is singular." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-9911" "field" nil "attribute" "question/worked-solution" "value" "First, let's use our formula to find an expression for the determinant in terms of $k:$\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & -1 & k \\\\ 1 & k & -k \\\\ 5 & k & k\\end{aligned}| & =1|\\begin{aligned}k & -k \\\\ k & k\\end{aligned}|-(-1)|\\begin{aligned}1 & -k \\\\ 5 & k\\end{aligned}|+k|\\begin{aligned}1 & k \\\\ 5 & k\\end{aligned}| \\\\  & =({k}^{2}+{k}^{2})+(k+5k)+k(k-5k) \\\\  & =2{k}^{2}+6k+k\\cdot (-4k) \\\\  & =2{k}^{2}+6k-4{k}^{2} \\\\  & =-2{k}^{2}+6k\\end{aligned}\n$$\n\nSince the matrix is singular, the determinant is $0,$ and we have:\n\n$$\n\\begin{aligned}-2{k}^{2}+6k & =0 \\\\ k(-2k+6) & =0\\end{aligned}\n$$\n\nTherefore, the solutions are $k=0$ and $k=3.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-9911" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/activity-metadata.json" "file_sha256" "9baffd44875b5a849fdb95dc21f8df6622eeea1f939b9623a8eeea5e94747cc6"} {"question" "q-9911" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-9911" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "$-3$ only"] ["text" "$0$ and $-3$ only"] ["text" "$0$ and $3$ only"] ["text" "$0$ only"] ["text" "$3$ only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-9911" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "$0$ and $3$ only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-130575" "field" nil "attribute" "question/problem" "value" "Given that the determinant of\n$[\\begin{aligned}2 & 1 & 5 \\\\ 2 & 3 & z \\\\ z & -1 & 1\\end{aligned}]$\nis $-48$, find all the possible values of $z.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-130575" "field" nil "attribute" "question/worked-solution" "value" "Let's use our formula to find an expression for the determinant in terms of $z:$\n\n$$\n\\begin{aligned}|\\begin{aligned}2 & 1 & 5 \\\\ 2 & 3 & z \\\\ z & -1 & 1\\end{aligned}| & =2|\\begin{aligned}3 & z \\\\ -1 & 1\\end{aligned}|-1|\\begin{aligned}2 & z \\\\ z & 1\\end{aligned}|+5|\\begin{aligned}2 & 3 \\\\ z & -1\\end{aligned}| \\\\  & =2(3+z)-(2-{z}^{2})+5(-2-3z) \\\\  & =6+2z-2+{z}^{2}-10-15z \\\\  & ={z}^{2}-13z-6\\end{aligned}\n$$\n\nSince the determinant of the matrix is $-48,$ we have:\n\n$$\n\\begin{aligned}{z}^{2}-13z-6 & =-48 \\\\ {z}^{2}-13z+42 & =0 \\\\ z & =\\frac{-(-13)\\pm \\sqrt{{13}^{2}-4\\cdot 1\\cdot 42}}{2\\cdot 1} \\\\  & =\\frac{13\\pm \\sqrt{1}}{2} \\\\  & =\\frac{13\\pm 1}{2} \\\\  & =6,7\\end{aligned}\n$$\n\nTherefore, the solutions are $z=6$ and $z=7.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-130575" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/activity-metadata.json" "file_sha256" "9baffd44875b5a849fdb95dc21f8df6622eeea1f939b9623a8eeea5e94747cc6"} {"question" "q-130575" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-130575" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "$-2$ and $3$ only"] ["text" "$3$  only"] ["text" "$5$ and $-5$ only"] ["text" "$5$ and $6$ only"] ["text" "$6$ and $7$ only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-130575" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "$6$ and $7$ only"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-18256" "field" nil "attribute" "question/problem" "value" "Given that the determinant of \n$[\\begin{aligned}4 & 2 & 3 \\\\ -3y & -2 & 1 \\\\ 2 & y & -5\\end{aligned}]$\n is $81,$ find all the possible values of $y.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-18256" "field" nil "attribute" "question/worked-solution" "value" "Let's use our formula to find an expression for the determinant in terms of $y:$\n\n$$\n\\begin{aligned}|\\begin{aligned}4 & 2 & 3 \\\\ -3y & -2 & 1 \\\\ 2 & y & -5\\end{aligned}| & =4|\\begin{aligned}-2 & 1 \\\\ y & -5\\end{aligned}|-2|\\begin{aligned}-3y & 1 \\\\ 2 & -5\\end{aligned}|+3|\\begin{aligned}-3y & -2 \\\\ 2 & y\\end{aligned}| \\\\  & =4\\cdot (10-y)-2\\cdot (15y-2)+3\\cdot (-3{y}^{2}+4) \\\\  & =40-4y-30y+4-9{y}^{2}+12 \\\\  & =-9{y}^{2}-34y+56\\end{aligned}\n$$\n\nSince the determinant of the matrix is $81,$ we have:\n\n$$\n\\begin{aligned}-9{y}^{2}-34y+56 & =81 \\\\ -9{y}^{2}-34y-25 & =0 \\\\ 9{y}^{2}+34y+25 & =0 \\\\ y & =\\frac{-34\\pm \\sqrt{{34}^{2}-4\\cdot 9\\cdot 25}}{2\\cdot 9} \\\\  & =\\frac{-34\\pm \\sqrt{256}}{18} \\\\  & =\\frac{-34\\pm 16}{18} \\\\  & =\\frac{-17\\pm 8}{9}\\end{aligned}\n$$\n\nTherefore, the solutions are $y=-\\frac{25}{9}$ and $y=-1.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-18256" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/activity-metadata.json" "file_sha256" "9baffd44875b5a849fdb95dc21f8df6622eeea1f939b9623a8eeea5e94747cc6"} {"question" "q-18256" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-18256" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "$-1$ only"] ["text" "$-\\frac{25}{9}$ and $-1$ only"] ["text" "$-\\frac{25}{9}$ and $1$ only"] ["text" "$-\\frac{5}{3}$ and $-1$ only"] ["text" "$-\\frac{5}{3}$ and $1$ only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-18256" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "$-\\frac{25}{9}$ and $-1$ only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-18272" "field" nil "attribute" "question/problem" "value" "Given that $M=[\\begin{aligned}0 & -3 & 2 \\\\ 1 & p & 0 \\\\ p-3 & 0 & -1\\end{aligned}]$ and $det(M)=-23,$ find all the possible values of $p.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-18272" "field" nil "attribute" "question/worked-solution" "value" "Let's use our formula to find an expression for the determinant in terms of $p:$\n\n$$\n\\begin{aligned}\\text{det}(M) & =|\\begin{aligned}0 & -3 & 2 \\\\ 1 & p & 0 \\\\ p-3 & 0 & -1\\end{aligned}| \\\\  & =0|\\begin{aligned}p & 0 \\\\ 0 & -1\\end{aligned}|-(-3)|\\begin{aligned}1 & 0 \\\\ p-3 & -1\\end{aligned}|+2|\\begin{aligned}1 & p \\\\ p-3 & 0\\end{aligned}| \\\\  & =0+3\\cdot (-1)+2\\cdot (3p-{p}^{2}) \\\\  & =-3-2{p}^{2}+6p \\\\  & =-2{p}^{2}+6p-3\\end{aligned}\n$$\n\nSince the determinant of the matrix is $-23,$ we have:\n\n$$\n\\begin{aligned}-2{p}^{2}+6p-3 & =-23 \\\\ 2{p}^{2}-6p-20 & =0 \\\\ {p}^{2}-3p-10 & =0 \\\\ p & =\\frac{-(-3)\\pm \\sqrt{(-3)^{2}-4\\cdot 1\\cdot (-10)}}{2\\cdot 1} \\\\  & =\\frac{3\\pm \\sqrt{49}}{2} \\\\  & =\\frac{3\\pm 7}{2}\\end{aligned}\n$$\n\nTherefore,  the solutions are $p=-2$ and $p=5.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-18272" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/activity-metadata.json" "file_sha256" "9baffd44875b5a849fdb95dc21f8df6622eeea1f939b9623a8eeea5e94747cc6"} {"question" "q-18272" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-18272" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "$-2$ and $5$ only"] ["text" "$2$ and $4$ only"] ["text" "$4$ and $5$ only"] ["text" "$4$ only"] ["text" "$5$ only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "q-18272" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "$-2$ and $5$ only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/state.json" "file_sha256" "633ec702744d2bd730aaa9f0b095dbbad880853847cd2b1d5c4850ecf052df51"} {"question" "e-14762" "field" nil "attribute" "question/problem" "value" "Find the value of $\\begin{aligned}0 & -3 & 6 \\\\ 8 & 8 & 8 \\\\ -6 & -12 & 1\\end{aligned}$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/example-14762.json" "file_sha256" "98134812a30d155c701221a65f5480f7b75f9d6425c5ce2d002b9c4852e14599"} {"question" "e-14762" "field" nil "attribute" "question/worked-solution" "value" "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}0 & -3 & 6 \\\\ 8 & 8 & 8 \\\\ -6 & -12 & 1\\end{aligned}| & =0|\\begin{aligned}8 & 8 \\\\ -12 & 1\\end{aligned}|-(-3)|\\begin{aligned}8 & 8 \\\\ -6 & 1\\end{aligned}|+6|\\begin{aligned}8 & 8 \\\\ -6 & -12\\end{aligned}| \\\\  & =0(8+96)+3(8+48)+6(-96+48) \\\\  & =0+3\\cdot 56+6\\cdot (-48) \\\\  & =168-288 \\\\  & =-120\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/example-14762.json" "file_sha256" "98134812a30d155c701221a65f5480f7b75f9d6425c5ce2d002b9c4852e14599"} {"question" "e-14763" "field" nil "attribute" "question/problem" "value" "Which of the following statements are true regarding the matrix $A$ given below?\n\n- $\\det(A) = 0$\n\n- $A$ is **not** a singular matrix\n\n- $A$ is a singular matrix\n\n$$\n[\\begin{aligned}1 & 2 & 3 \\\\ 1 & 0 & 1 \\\\ 3 & 4 & 7\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/example-14763.json" "file_sha256" "769f9c3e23fde5efa65243b816f9924113c584fc25b7d3d03ba7cbe9e8104510"} {"question" "e-14763" "field" nil "attribute" "question/worked-solution" "value" "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}1 & 2 & 3 \\\\ 1 & 0 & 1 \\\\ 3 & 4 & 7\\end{aligned}| \\\\  & =1|\\begin{aligned}0 & 1 \\\\ 4 & 7\\end{aligned}|-2|\\begin{aligned}1 & 1 \\\\ 3 & 7\\end{aligned}|+3|\\begin{aligned}1 & 0 \\\\ 3 & 4\\end{aligned}| \\\\  & =1(0-4)-2(7-3)+3(4-0) \\\\  & =-4-2\\cdot 4+3\\cdot 4 \\\\  & =-4-8+12 \\\\  & =0\\end{aligned}\n$$\n\nSince $\\det(A)=0$, the matrix is singular. \n\nTherefore, only statements I and III are true." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/example-14763.json" "file_sha256" "769f9c3e23fde5efa65243b816f9924113c584fc25b7d3d03ba7cbe9e8104510"} {"question" "e-14764" "field" nil "attribute" "question/problem" "value" "Given that the determinant of  $[\\begin{aligned}3 & 1 & 2 \\\\ k & 4 & 5 \\\\ 0 & 2 & 3\\end{aligned}]$ is $2,$ find the value of the constant $k.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/example-14764.json" "file_sha256" "05e9abb1d54b649d715a2304054673723b731aabb1c8f492f1bfab4f9b2c9b85"} {"question" "e-14764" "field" nil "attribute" "question/worked-solution" "value" "Let's use our formula to find an expression for the determinant in terms of $k\\mathbin{:}$\n\n$$\n\\begin{aligned}|\\begin{aligned}3 & 1 & 2 \\\\ k & 4 & 5 \\\\ 0 & 2 & 3\\end{aligned}| & =3|\\begin{aligned}4 & 5 \\\\ 2 & 3\\end{aligned}|-1|\\begin{aligned}k & 5 \\\\ 0 & 3\\end{aligned}|+2|\\begin{aligned}k & 4 \\\\ 0 & 2\\end{aligned}| \\\\  & =3(12-10)-1(3k-0)+2(2k-0) \\\\  & =3\\cdot 2-1\\cdot 3k+2\\cdot 2k \\\\  & =6-3k+4k \\\\  & =k+6\\end{aligned}\n$$\n\nSince the determinant of the matrix is $2,$ we have:\n\n$$\n\\begin{aligned}k+6 & =2 \\\\ k & =-4\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039569/example-14764.json" "file_sha256" "05e9abb1d54b