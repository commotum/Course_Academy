#{[{:db/id #edb/ref 17592186291607 :knowledge-point/_questions [{:knowledge-point/id #uuid "ab642ad6-d9e0-5734-83b4-81627b9132eb" :knowledge-point/title "Solving for an Unknown Given the Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d0cb28e-4fc8-5013-94cf-ff5147e66641" :answer/type {:db/ident :answer.type/text} :answer/value "$-2$ and $3$ only" :db/id #edb/ref 17592186291609} {:answer/id #uuid "31ed3d39-28ce-5447-8827-dde43b2a8108" :answer/type {:db/ident :answer.type/text} :answer/value "$5$ and $6$ only" :db/id #edb/ref 17592186291610} {:answer/id #uuid "d58f196e-d677-589c-a2c1-6f3365a23a8d" :answer/type {:db/ident :answer.type/text} :answer/value "$6$ and $7$ only" :db/id #edb/ref 17592186291611} {:answer/id #uuid "81cfc9c1-3416-5a42-8690-032d7c913f56" :answer/type {:db/ident :answer.type/text} :answer/value "$3$  only" :db/id #edb/ref 17592186291612} {:answer/id #uuid "5b771a52-6452-59ae-8bf1-004cc6984d54" :answer/type {:db/ident :answer.type/text} :answer/value "$5$ and $-5$ only" :db/id #edb/ref 17592186291613}] :answer-field/correct {:answer/id #uuid "d58f196e-d677-589c-a2c1-6f3365a23a8d" :answer/type {:db/ident :answer.type/text} :answer/value "$6$ and $7$ only" :db/id #edb/ref 17592186291611} :answer-field/id #uuid "0e5f0f38-246f-5927-9460-4b2aff199937" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291608}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d07c9ad8-9277-516a-802b-f65168b9d077" :question/math-academy-id "q-130575" :question/problem "Given that the determinant of\n$[\\begin{aligned}2 & 1 & 5 \\\\ 2 & 3 & z \\\\ z & -1 & 1\\end{aligned}]$\nis $-48$, find all the possible values of $z.$" :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $z:$\n\n$$\n\\begin{aligned}|\\begin{aligned}2 & 1 & 5 \\\\ 2 & 3 & z \\\\ z & -1 & 1\\end{aligned}| & =2|\\begin{aligned}3 & z \\\\ -1 & 1\\end{aligned}|-1|\\begin{aligned}2 & z \\\\ z & 1\\end{aligned}|+5|\\begin{aligned}2 & 3 \\\\ z & -1\\end{aligned}| \\\\  & =2(3+z)-(2-{z}^{2})+5(-2-3z) \\\\  & =6+2z-2+{z}^{2}-10-15z \\\\  & ={z}^{2}-13z-6\\end{aligned}\n$$\n\nSince the determinant of the matrix is $-48,$ we have:\n\n$$\n\\begin{aligned}{z}^{2}-13z-6 & =-48 \\\\ {z}^{2}-13z+42 & =0 \\\\ z & =\\frac{-(-13)\\pm \\sqrt{{13}^{2}-4\\cdot 1\\cdot 42}}{2\\cdot 1} \\\\  & =\\frac{13\\pm \\sqrt{1}}{2} \\\\  & =\\frac{13\\pm 1}{2} \\\\  & =6,7\\end{aligned}\n$$\n\nTherefore, the solutions are $z=6$ and $z=7.$"}]}
