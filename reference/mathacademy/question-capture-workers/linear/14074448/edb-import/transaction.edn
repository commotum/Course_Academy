}_{4}}$ is a basis of $\\text{Col}(A)$, find $\\text{dim(Null}(A)).$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=7,$ and since $B$ is formed by $4$ vectors, $\\text{rank}(A)=4.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 4+\\text{nullity}(A) & =7 \\\\ \\text{nullity}(A) & =7-4 \\\\ \\text{dim(Null}(A)) & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-141230/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d562ea0c-94f3-5fe6-ba82-c651a51d0bbe"] :knowledge-point/questions ["q-141230"] :db/ensure [:knowledge-point/validate]} {:db/id "q-35305/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "98b6b0e9-8192-5082-9e63-4f9a0927f8db" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-35305/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "0499ea4a-49ab-5b76-9e44-f469aef7a64f" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-35305/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "5dbca8ca-b281-54fd-995f-d541ee84fdfe" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-35305/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "921c7c05-e1e9-59ff-a7af-aaa257e9ca88" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-35305/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "321f7c25-d9fb-5897-9ead-f605e953ca9d" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-35305/selection" :answer-field/id #uuid "7d55df8c-9022-5b6d-8229-28d1f821bca2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-35305/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-35305/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-35305/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-35305/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-35305/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-35305/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-35305" :question/id #uuid "a46765c0-748f-5736-84db-b7439678cd32" :question/math-academy-id "q-35305" :question/problem "Let $A$ be a $3\\times 5$ matrix. If $B={{b}_{1},{b}_{2},{b}_{3}}$ is a basis of $\\text{Col}(A)$, find $\\text{dim(Null}(A)).$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=5,$ and since $B$ is formed by $3$ vectors, $\\text{rank}(A)=3.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 3+\\text{nullity}(A) & =5 \\\\ \\text{nullity}(A) & =5-3 \\\\ \\text{dim(Null}(A)) & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-35305/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d562ea0c-94f3-5fe6-ba82-c651a51d0bbe"] :knowledge-point/questions ["q-35305"] :db/ensure [:knowledge-point/validate]} {:db/id "q-142486/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "a834cae2-6d81-5fb7-9d76-2f3a8d84382c" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-142486/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd4