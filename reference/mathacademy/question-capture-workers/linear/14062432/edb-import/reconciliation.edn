 -3 & 0 & -5\\end{aligned}] & {R}_{2} & :={R}_{2}+(-4){R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ -4 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}1 & -2 & 2 \\\\ 0 & 3 & 1 \\\\ -3 & 0 & -5\\end{aligned}] & {R}_{3} & :={R}_{3}+3{R}_{1} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}]}}\\cdot {E}_{1}\\cdot A \\\\  & ∼[\\begin{aligned}1 & -2 & 2 \\\\ 0 & 3 & 1 \\\\ 0 & -6 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{2} & ⟺ & \\,\\overset{{E}_{3}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 2 & 1\\end{aligned}]}}\\cdot {E}_{2}\\cdot {E}_{1}\\cdot A \\\\  & ∼[\\begin{aligned}1 & -2 & 2 \\\\ 0 & 3 & 1 \\\\ 0 & 0 & 3\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{3}{E}_{2}{E}_{1}A=U,$ we can invert ${E}_{3},$ ${E}_{2},$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{3}{E}_{2}{E}_{1}A & =U \\\\ {E}_{2}{E}_{1}A & ={E}_{3}^{-1}U \\\\ {E}_{1}A & ={E}_{2}^{-1}{E}_{3}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}{E}_{3}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 & 0 \\\\ -4 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 2 & 1\\end{aligned}]}^{-1}U \\\\ A & =([\\begin{aligned}1 & 0 & 0 \\\\ 4 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -2 & 1\\end{aligned}])U \\\\ A & ={{[\\begin{aligned}1 & 0 & 0 \\\\ 4 & 1 & 0 \\\\ -3 & -2 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}1 & -2 & 2 \\\\ 0 & 3 & 1 \\\\ 0 & 0 & 3\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{32}=-2,$ ${u}_{33}=3,$ and ${l}_{32}\\cdot {u}_{33}=-6.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062432/state.json" "file_sha256" "7df46a56da5e0fd9c01dcfd69f0747cdcdc3f87807f4bcec874eaa1e11b8d00c"} {"question" "q-106856" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062432/activity-metadata.json" "file_sha256" "5a1b58ae05387bd3d0ec12ff43a1ecb313b907f716f951dee5fe224c7fc0d71c"} {"question" "q-106856" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062432/state.json" "file_sha256" "7df46a56da5e0fd9c01dcfd69f0747cdcdc3f87807f4bcec874eaa1e11b8d00c"} {"question" "q-106856" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-4"] ["math" "-6"] ["math" "-9"] ["math" "4"] ["math" "6"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062432/state.json" "file_sha256" "7df46a56da5e0fd9c01dcfd69f0747cdcdc3f87807f4bcec874eaa1e11b8d00c"} {"question" "q-106856" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-6"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062432/state.json" "file_sha256" "7df46a56da5e0fd9c01dcfd69f0747cdcdc3f87807f4bcec874eaa1e11b8d00c"} {"question" "q-32532" "field" nil "attribute" "question/problem" "value" "Given that \n$A=[\\begin{aligned}1 & 2 & -1 \\\\ 2 & 5 & 0 \\\\ -1 & -2 & 3\\end{aligned}]$ has the LU decomposition $A=LU,$ then $L=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062432/state.json" "file_sha256" "7df46a56da5e0fd9c01dcfd69f0747cdcdc3f87807f4bcec874eaa1e11b8d00c"} {"question" "q-32532" "field" nil "attribute" "question/worked-solution" "value" "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 2 & -1 \\\\ 2 & 5 & 0 \\\\ -1 & -2 & 3\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}1 & 2 & -1 \\\\ 0 & 1 & 2 \\\\ -1 & -2 & 3\\end{aligned}] & {R}_{3} & :={R}_{3}+{R}_{1} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 1\\end{aligned}]}}\\cdot {E}_{1}\\cdot A \\\\  & ∼[\\begin{aligned}1 & 2 & -1 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 2\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}A=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}A & =U \\\\ {E}_{1}A & ={E}_{2}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 1\\end{aligned}]}^{-1}U \\\\ A & =([\\begin{aligned}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -1 & 0 & 1\\end{aligned}])U \\\\ A & ={{[\\begin{aligned}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ -1 & 0 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}1 & 2 & -1 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 2\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062432/state.json" "file_sha256" "7df46a56da5e0fd9c01dcfd69f0747cdcdc3f87807f4bcec874eaa1e11b8d00c"} {"question" "q-32532" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062432/activity-metadata.json" "file_sha256" "5a1b58ae05387bd3d0ec12ff43a1ecb313b907f716f951dee5fe224c7fc0d71c"} {"question" "q-32532" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062432/state.json" "file_sha256" "7df46a56da5e0fd9c01dcfd69f0747cdcdc3f87807f4bcec874eaa1e11b8d00c"} {"question" "q-32532" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ -1 & 0 & 1\\end{aligned}]"] ["math" "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -1 & 3 & 1\\end{aligned}]"] ["math" "[\\begin{aligned}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ -1 & 0 & 1\\end{aligned}]"] ["math" "[\\begin{aligned}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 1 & 0 & 1\\end{aligned}]"] ["math" "[\\begin{aligned}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ -2 & 4 & 1\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062432/state.json" "file_sha256" "7df46a56da5e0fd9c01dcfd69f0747cdcdc3f87807f4bcec874eaa1e11b8d00c"} {"question" "q-32532" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ -1 & 0 & 1\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062432/state.json" "file_sha256" "7df46a56da5e0fd9c01dcfd69f0747cdcdc3f87807f4bcec874eaa1e11b8d00c"} {"question" "e-4768" "field" nil "attribute" "question/problem" "value" "Given that\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062432/assets/d4fa85cab74f4bda57059d1c6abc9dacea665531ce84ba9d2f1598a13c49ef60.png) \nhas the LU decomposition $A=LU,$ then $L=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062432/example-4768.json" "file_sha256" "fe83cfe482262234a9acad31fad5d2da7cfd240713a4834eaec2c9031a549a52"} {"question" "e-4768" "field" nil "attribute" "question/worked-solution" "value" "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}4 & 1 & -6 \\\\ 0 & 3 & 1 \\\\ 0 & 6 & -2\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{2} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -2 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}4 & 1 & -6 \\\\ 0 & 3 & 1 \\\\ 0 & 0 & -4\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since $E_1A=U,$ we can invert $E_1$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -2 & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 2 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}4 & 1 & -6 \\\\ 0 & 3 & 1 \\\\ 0 & 0 & -4\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062432/example-4768.json" "file_sha256" "fe83cfe482262234a9acad31fad5d2da7cfd240713a4834eaec2c9031a549a52"} {"question" "e-4769" "field" nil "attribute" "question/problem" "value" "Suppose that a $3 \\times 3$ matrix $F$ is reduced to row echelon form using the following elementary row operations, applied in the order in which they appear:\n\n$$\nR_2:=R_2+R_1, \\qquad\n\tR_3:=R_3+2R_1\n$$\n\nGiven that $F$ has the LU factorization $F=LU,$ then $L=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062432/example-4769.json" "file_sha256" "f661b9a879c85d37ef97d8e4198f087b17f5c9c4d091db5266e9e255ce30e252"} {"question" "e-4769" "field" nil "attribute" "question/worked-solution" "value" "Applying $R_2:=R_2 + {\\color{red}1} \\cdot R_1$ and then $R_3:=R_3+ {\\color{red}2} \\cdot R_1$ is equivalent to multiplying $F$ from the left by the following elementary matrices:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062432/assets/5eb696ca679a0079e8460d472b6f172df4f2e29f5dfef6cbdee388c55dcb1db5.png)\n\nNow, since $E_2E_1F=U,$ we can invert $E_2$ and $E_1$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}F & =U \\\\ {E}_{1}F & ={E}_{2}^{-1}U \\\\ F & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ F & ={[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 2 & 0 & 1\\end{aligned}]}^{-1}U \\\\ F & =([\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & 1\\end{aligned}])U \\\\ F & ={{[\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ -2 & 0 & 1\\end{aligned}]}_{⏟}}_{L}\\cdot U\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062432/example-4769.json" "file_sha256" "f661b9a879c85d37ef97d8e4198f087b17f5c9c4d091db5266e9e255ce30e252"} {"question" "e-4770" "field" nil "attribute" "question/problem" "value" "Given that\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062432/assets/e85dac75798b6cb463403f54ab2a675206d7eeea0a8958081aac9c696047b345.png)\nhas the LU decomposition $A=LU,$ then $L=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062432/example-4770.json" "file_sha256" "a09a6bdf1b5ee71ea3632005d48903154e7dba84f68ac4a83d750a4e919286fa"} {"question" "e-4770" "field" nil "attribute" "question/worked-solution" "value" "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}4 & 8 & 0 \\\\ 5 & 11 & -6 \\\\ 0 & -4 & 16\\end{aligned}] & {R}_{2} & :={R}_{2}+(-\\frac{5}{4}){R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{5}{4} & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}4 & 8 & 0 \\\\ 0 & 1 & -6 \\\\ 0 & -4 & 16\\end{aligned}] & {R}_{3} & :={R}_{3}+4{R}_{2} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 4 & 1\\end{aligned}]}}\\cdot {E}_{1}\\cdot A \\\\  & ∼[\\begin{aligned}4 & 8 & 0 \\\\ 0 & 1 & -6 \\\\ 0 & 0 & -8\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since $E_2E_1A=U,$ we can invert $E_2$ and $E_1$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}A & =U \\\\ {E}_{1}A & ={E}_{2}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{5}{4} & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 4 & 1\\end{aligned}]}^{-1}U \\\\ A & =([\\begin{aligned}1 & 0 & 0 \\\\ \\frac{5}{4} & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -4 & 1\\end{aligned}])U \\\\ A & ={{[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{5}{4} & 1 & 0 \\\\ 0 & -4 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}4 & 8 & 0 \\\\ 0 & 1 & -6 \\\\ 0 & 0 & -8\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062432/example-4770.json" "file_sha256" "a09a6bdf1b5ee71ea3632005d48903154e7dba84f68ac4a83d750a4e919286fa"}] "usage" {"e-4770" [] "q-32532" [] "q-32569" [] "e-4769" [] "e-4768" [] "q-32684" []} "basis" 2003 "retractions" [[17592186120121 :question/problem "Given that\n\n$A = \\begin{bmatrix}2 & 3 & -4 \\\\ 0 & 5 & 1 \\\\ 6 & 9 & -8\\end{bmatrix}$\nhas the LU decomposition $A = LU$, then $L =$"] [17592186120131 :question/problem "Suppose that a $3 \\cdot 3$ matrix $C$ is reduced to row echelon form using the following elementary row operations, applied in the order in which they appear:\n\n$R_{2}:=R_{2} - R_{1}, R_{3}:=R_{3} + 4R_{1}$\nGiven that $C$ has the LU factorization $C = LU$, then $L =$"] [17592186120114 :question/problem "Given that\n\n$A = \\begin{bmatrix}1 & 2 & -1 \\\\ 2 & 5 & 0 \\\\ -1 & -2 & 3\\end{bmatrix}$ has the LU decomposition $A = LU$, then $L =$"] [17592186119532 :question/problem "Given that\n$\\begin{bmatrix}4 & 1 & -6 \\\\ 0 & 3 & 1 \\\\ 0 & 6 & -2\\end{bmatrix}$\nhas the LU decomposition $A=LU$, then $L=$"] [17592186119532 :question/worked-solution "To find the matrices $L$ and $U$, we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}\nA &= \\begin{bmatrix}4 & 1 & -6 \\\\ 0 & 3 & 1 \\\\ 0 & 6 & -2\\end{bmatrix}\\begin{vmatrix}R_{3} &:=R_{3} + (-2)R_{2} & ⟺\\end{vmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -2 & 1\\end{bmatrix}^(⏞)^(E_{1}) \\cdot A \\\\\n&= ∼\\begin{bmatrix}4 & 1 & -6 \\\\ 0 & 3 & 1 \\\\ 0 & 0 & -4\\end{bmatrix} \\\\\n&= U\n\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U$. Now, since $E_1A=U$, we can invert $E_1$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}\nE_{1}A &= U \\\\\nA &= E_{1}^{-1}U \\\\\nA &= \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -2 & 1\\end{bmatrix}^{-1}U \\\\\nA &= \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 2 & 1\\end{bmatrix}_(⏟)_(L)\\begin{bmatrix}4 & 1 & -6 \\\\ 0 & 3 & 1 \\\\ 0 & 0 & -4\\end{bmatrix}_(⏟)_(U)\n\\end{aligned}\n$$"] [17592186119533 :question/problem "Suppose that a $3 \\times 3$ matrix $F$ is reduced to row echelon form using the following elementary row operations, applied in the order in which they appear:\n$R_2:=R_2+R_1, \\qquad R_3:=R_3+2R_1$\nGiven that $F$ has the LU factorization $F=LU$, then $L=$"] [17592186119533 :question/worked-solution "Applying\n\n$$\nR_2:=R_2 + {\\color{red}1} \\cdot R_1\n$$\n\nand then\n\n$$\nR_3:=R_3+ {\\color{red}2} \\cdot R_1\n$$\n\nis equivalent to multiplying $F$ from the left by the following elementary matrices:\n\n$$\n\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 2 & 0 & 1\\end{bmatrix}\n$$\n\nNow, since $E_2E_1F=U$, we can invert $E_2$ and $E_1$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}\nE_{2}E_{1}F &= U \\\\\nE_{1}F &= E_{2}^{-1}U \\\\\nF &= E_{1}^{-1}E_{2}^{-1}U \\\\\nF &= \\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}^{-1}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 2 & 0 & 1\\end{bmatrix}^{-1}U \\\\\nF &= (\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & 1\\end{bmatrix})U \\\\\nF &= \\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ -2 & 0 & 1\\end{bmatrix}_(⏟)_(L) \\cdot U\n\\end{aligned}\n$$"] [17592186119534 :question/problem "Given that\n$\\begin{bmatrix}4 & 8 & 0 \\\\ 5 & 11 & -6 \\\\ 0 & -4 & 16\\end{bmatrix}$\nhas the LU decomposition $A=LU$, then $L=$"] [17592186119534 :question/worked-solution "To find the matrices $L$ and $U$, we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}\nA &= \\begin{bmatrix}4 & 8 & 0 \\\\ 5 & 11 & -6 \\\\ 0 & -4 & 16\\end{bmatrix}\\begin{vmatrix}R_{2} &:=R_{2} + (-\\frac{5}{4})R_{1} & ⟺ & \\begin{bmatrix}1 & 0 & 0 \\\\ -\\frac{5}{4} & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}^(⏞)^(E_{1}) \\cdot A \\\\ ∼\\begin{bmatrix}4 & 8 & 0 \\\\ 0 & 1 & -6 \\\\ 0 & -4 & 16\\end{bmatrix} & R_{3} &:=R_{3} + 4R_{2} & ⟺\\end{vmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 4 & 1\\end{bmatrix}^(⏞)^(E_{2}) \\cdot E_{1} \\cdot A \\\\\n&= ∼\\begin{bmatrix}4 & 8 & 0 \\\\ 0 & 1 & -6 \\\\ 0 & 0 & -8\\end{bmatrix} \\\\\n&= U\n\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U$. Now, since $E_2E_1A=U$, we can invert $E_2$ and $E_1$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}\nE_{2}E_{1}A &= U \\\\\nE_{1}A &= E_{2}^{-1}U \\\\\nA &= E_{1}^{-1}E_{2}^{-1}U \\\\\nA &= \\begin{bmatrix}1 & 0 & 0 \\\\ -\\frac{5}{4} & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}^{-1}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 4 & 1\\end{bmatrix}^{-1}U \\\\\nA &= (\\begin{bmatrix}1 & 0 & 0 \\\\ \\frac{5}{4} & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -4 & 1\\end{bmatrix})U \\\\\nA &= \\begin{bmatrix}1 & 0 & 0 \\\\ \\frac{5}{4} & 1 & 0 \\\\ 0 & -4 & 1\\end{bmatrix}_(⏟)_(L)\\begin{bmatrix}4 & 8 & 0 \\\\ 0 & 1 & -6 \\\\ 0 & 0 & -8\\end{bmatrix}_(⏟)_(U)\n\\end{aligned}\n$$"]] "immutable_answers" [17592186117205 17592186117206 17592186117207 17592186117208 17592186117209 17592186117247 17592186117248 17592186117249 17592186117250 17592186117251 17592186117307 17592186117308 17592186117309 17592186117310 17592186117311] "immutable_fields" [[17592186117204 :answer-field/correct] [17592186117204 :answer-field/id] [17592186117204 :answer-field/key] [17592186117204 :answer-field/type] [17592186117246 :answer-field/correct] [17592186117246 :answer-field/id] [17592186117246 :answer-field/key] [17592186117246 :answer-field/type] [17592186117306 :answer-fi