& 1 & 0 \\\\ -4 & 0 & 1\\end{aligned}]}_{⏟}}_{{E}_{2}}\\cdot {{[\\begin{aligned}1 & 0 & 0 \\\\ 4 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}_{⏟}}_{{E}_{1}}\\cdot H=U\n$$\n\nNow, since ${E}_{2}{E}_{1}H=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}H & =U \\\\ {E}_{1}H & ={E}_{2}^{-1}U \\\\ H & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ H & ={[\\begin{aligned}1 & 0 & 0 \\\\ 4 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{aligned}]}^{-1}U \\\\ H & =([\\begin{aligned}1 & 0 & 0 \\\\ -4 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & 0 & 1\\end{aligned}])U \\\\ H & ={{[\\begin{aligned}1 & 0 & 0 \\\\ -4 & 1 & 0 \\\\ 4 & 0 & 1\\end{aligned}]}_{⏟}}_{L}\\cdot U\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-75100/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5c91fb2b-5607-555d-b897-f0e76765dfa6"] :knowledge-point/questions ["q-75100"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-32684"] :question/problem "Suppose that a $3\\times 3$ matrix $C$ is reduced to row echelon form using the following elementary row operations, applied in the order in which they appear:\n\n$$\n{R}_{2}:={R}_{2}-{R}_{1},\\,{R}_{3}:={R}_{3}+4{R}_{1}\n$$\n\nGiven that $C$ has the LU factorization $C=LU,$ then $L=$" :question/worked-solution "Applying ${R}_{2}:={R}_{2}+(-1)\\cdot {R}_{1}$ and then ${R}_{3}:={R}_{3}+4\\cdot {R}_{1}$ is equivalent to multiplying $C$ from the left by the following elementary matrices:\n\n$$\n{{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & 0 & 1\\end{aligned}]}_{⏟}}_{{E}_{2}}\\cdot {{[\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}_{⏟}}_{{E}_{1}}\\cdot C=U\n$$\n\nNow, since ${E}_{2}{E}_{1}C=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}C & =U \\\\ {E}_{1}C & ={E}_{2}^{-1}U \\\\ C & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ C & ={[\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & 0 & 1\\end{aligned}]}^{-1}U \\\\ C & =([\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{aligned}])U \\\\ C & ={{[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ -4 & 0 & 1\\end{aligned}]}_{⏟}}_{L}\\cdot U\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-106847/selection/c15f012334f6bbf20d09dd38f5e591fa610a0ee25f45ff6df7784050b9595374" :answer/id #uuid "4fabfc60-af43-5dfe-b22c-58b77d4fe0e5" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 1 & 3 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-106847/selection/291d145e164a6b23efd62b8c3355585777d5e3d8b30eb7392534bfdabe2ecb19" :answer/id #uuid "e0852b36-4ef0-5569-881e-d39b60374b08" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 1 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-106847/selection/ff9afd01dc32a2158959391b84a8a187d1d0e851cbab4d841499c7e58a946570" :answer/id #uuid "f18b9b49-23d2-5987-b705-4972e38aecc2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 1 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-106847/selection/27b74109d96ef412a7272d2fe07e14f1a65afc073e42f9b1d31e59d3fb6af2e3" :answer/id #uuid "3cb72c1d-1ec2-5e52-8fdc-2e0ed3c7bb77" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-106847/selection/52077ecae39f1b6f5cbc19a9164801d9777f1e82a2ae06d8398ee981c928d260" :answer/id #uuid "fc5ab7bc-5e36-5982-b680-498fbb793b69" :answer/type