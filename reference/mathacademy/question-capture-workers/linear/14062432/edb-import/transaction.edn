 0 \\\\ -3 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -1 & 0 & 1\\end{aligned}]}^{-1}U \\\\ H & =([\\begin{aligned}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 1\\end{aligned}])U \\\\ H & ={{[\\begin{aligned}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 1 & 0 & 1\\end{aligned}]}_{⏟}}_{L}\\cdot U\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-106847/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5c91fb2b-5607-555d-b897-f0e76765dfa6"] :knowledge-point/questions ["q-106847"] :db/ensure [:knowledge-point/validate]} {:db/id "q-106843/selection/35906868c1f1a9f384a4c1213f301c468879b895cd017a001c3f18c5218d6e82" :answer/id #uuid "e3edbf67-788c-5d4c-b0f1-d647aadd3d76" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 9 & -1 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-106843/selection/529ef9e2e973f4db5efd9e94fb76cd91f1d5e846d15e4a1f6a8be4344cae0153" :answer/id #uuid "9ba69622-7726-50fe-9e54-8b0bb00668bd" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 9 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-106843/selection/d61bdb4cbe6659deab566ad1ad60cf0d39790b58b052b848e0d7ddff60c5a097" :answer/id #uuid "765a7a55-0f1a-5c94-b0d3-a3a228374c8a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ -9 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-106843/selection/25eea618d7fceb6e6afd2f38286abaf9e89235a0a740d0ea0750ab39eda62721" :answer/id #uuid "07f3bf2d-2972-50a0-b87d-a0486788898d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -9 & 1 & 0 \\\\ -1 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-106843/selection/6fe4031e6310626bf109fbda1461adb58dccab7f66f30114dc0c3ca46ec40650" :answer/id #uuid "2a79c620-eab7-5558-98a8-6e25801e6b73" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 1 \\\\ 9 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-106843/selection" :answer-field/id #uuid "b145703d-d381-58b8-ac10-a60c3c9d106e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-106843/selection/d61bdb4cbe6659deab566ad1ad60cf0d39790b58b052b848e0d7ddff60c5a097" :answer-field/choices ["q-106843/selection/35906868c1f1a9f384a4c1213f301c468879b895cd017a001c3f18c5218d6e82" "q-106843/selection/529ef9e2e973f4db5efd9e94fb76cd91f1d5e846d15e4a1f6a8be4344cae0153" "q-106843/selection/d61bdb4cbe6659deab566ad1ad60cf0d39790b58b052b848e0d7ddff60c5a097" "q-106843/selection/25eea618d7fceb6e6afd2f38286abaf9e89235a0a740d0ea0750ab39eda62721" "q-106843/selection/6fe4031e6310626bf109fbda1461adb58dccab7f66f30114dc0c3ca46ec40650"] :db/ensure [:answer-field/validate]} {:db/id "q-106843" :question/id #uuid "032565e5-8acf-5267-a8b8-76412210c134" :question/math-academy-id "q-106843" :question/problem "Suppose that a $3\\times 3$ matrix $C$ is reduced to row echelon form using the following elementary row operations, applied in the order in which they appear:\n\n$$\n{R}_{2}:={R}_{2}+{R}_{1},\\,{R}_{3}:={R}_{3}+9{R}_{1}\n$$\n\nGiven that $C$ has the LU factorization $C=LU,$ then $L=$" :question/worked-solution "Applying ${R}_{2}:={R}_{2}+1\\cdot {R}_{1}$ and then ${R}_{3}:={R}_{3}+9\\cdot {R}_{1}$ is equivalent to multiplying $C$ from the left by the following elementary matrices:\n\n$$\n{{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 9 & 0 & 1\\end{aligned}]}_{⏟}}_{{E}_{2}}\\cdot {{[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}_{⏟}}_{{E}_{1}}\\cdot C=U\n$$\n\nNow, since ${E}_{2}{E}_{1}C=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}C & =U \\\\ {E}_{1}C & ={E}_{2}^{-1}U \\\\ C & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ C & ={[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 9 & 0 & 1\\end{aligned}]}^{-1}U \\\\ C & =([\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -9 & 0 & 1\\end{aligned}])U \\\\ C & ={{[\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ -9 & 0 & 1\\end{aligned}]}_{⏟}}_{L}\\cdot U\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-106843/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5c91fb2b-5607-555d-b897-f0e76765dfa6"] :knowledge-point/questions ["q-106843"] :db/ensure [:knowledge-point/validate]} {:db/id "q-75102/selection/3321647a5a93ae06ae94a5f2b23ad4eb1758914beccc4a87170c90a69e9683b7" :answer/id #uuid "5ef5e943-5d7f-5897-b024-f87d45a30881" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 2 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-75102/selection/2ed5691f9cfc32f564bab1153c4963beb2d10b4737c8310e9ace881b24ceb98c" :answer/id #uuid "51c52066-4f7b-5eb6-b428-2aeb5320de49" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ -2 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-75102/selection/c77cdb9b9f3c0b789ca63f88d9b023ea663556b89e1b7005778dc4fdfcd9ef45" :answer/id #uuid "55afd077-ebe0-55c9-9683-e0cf84463140" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -2 & -1 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-75102/selection/4a9d8d3dfd3831c9d0ad7443809242b1613272911c3a4c16f6e12ea85f032df2" :answer/id #uuid "d59fdb4d-852c-5a4f-a308-71a73d971b6d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 2 & 1 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-75102/selection/426133a47f73889b1f13321de9051d654b8548037c7f3acdf001b5937d81b3be" :answer/id #uuid "a8ed2870-d7db-57ee-bc30-a30aece65864" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -2 & 1 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-75102/selection" :answer-field/id #uuid "e3bab859-0d7e-514e-b9c5-1eb8a5a1ee29" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-75102/selection/4a9d8d3dfd3831c9d0ad7443809242b1613272911c3a4c16f6e12ea85f032df2" :answer-field/choices ["q-75102/selection/3321647a5a93ae06ae94a5f2b23ad4eb1758914beccc4a87170c90a69e9683b7" "q-75102/selection/2ed5691f9cfc32f564bab1153c4963beb2d10b4737c8310e9ace881b24ceb98c" "q-75102/selection/c77cdb9b9f3c0b789ca63f88d9b023ea663556b89e1b7005778dc4fdfcd9ef45" "q-75102/selection/4a9d8d3dfd3831c9d0ad7443809242b1613272911c3a4c16f6e12ea85f032df2" "q-75102/selection/426133a47f73889b1f13321de9051d654b8548037c7f3acdf001b5937d81b3be"] :db/ensure [:answer-field/validate]} {:db/id "q-75102" :question/id #uuid "884fc6a3-6df8-5fa0-a711-f28bd28480fb" :question/math-academy-id "q-75102" :question/problem "Given that \n$A=[\\begin{aligned}1 & -2 & 1 \\\\ 0 & 3 & 0 \\\\ 2 & -1 & 1\\end{aligned}]$ has the LU decomposition $A=LU,$ then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & -2 & 1 \\\\ 0 & 3 & 0 \\\\ 2 & -1 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}1 & -2 & 1 \\\\ 0 & 3 & 0 \\\\ 0 & 3 & -1\\end{aligned}] & {R}_{3} & :={R}_{3}+(-1){R}_{2} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -1 & 1\\end{aligned}]}}\\cdot {E}_{1}\\cdot A \\\\  & ∼[\\begin{aligned}1 & -2 & 1 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & -1\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}A=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}A & =U \\\\ {E}_{1}A & ={E}_{2}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -1 & 1\\end{aligned}]}^{-1}U \\\\ A & =([\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 2 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 1\\end{aligned}])U \\\\ A & ={{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 2 & 1 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}1 & -2 & 1 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & -1\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-75102/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6e460dcd-59cf-54d2-80e6-c0d72b6bafdd"] :knowledge-point/questions ["q-75102"] :db/ensure [:knowledge-point/validate]} {:db/id "q-106855/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "521dc4b8-d1ed-5502-857b-32eeefac84b8" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-106855/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "ce039fa1-5192-5298-9f9e-ec2a91d29a90" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-106855/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "d6b5b10c-bdf4-5fac-bfa2-16db04c6e00d" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-106855/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "8f3f02ca-4742-537a-bd53-246824b9ca65" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-106855/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "258b76d7-50f4-541c-a0eb-9fb8d16d80c4" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-106855/selection" :answer-field/id #uuid "f6046647-42d6-54bd-af8a-b8735dae4cd9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-106855/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer-field/choices ["q-106855/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" "q-106855/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-106855/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-106855/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" "q-106855/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-106855" :question/id #uuid "8b19ad2e-f600-587b-82e8-94b6f5ec8a03" :question/math-academy-id "q-106855" :question/problem "Given that \n$A=[\\begin{aligned}-1 & 0 & 2 \\\\ 5 & 1 & -8 \\\\ -4 & 0 & 3\\end{aligned}]$ has the LU decomposition $A=LU,$ then ${l}_{31}\\cdot {u}_{23}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}-1 & 0 & 2 \\\\ 5 & 1 & -8 \\\\ -4 & 0 & 3\\end{aligned}] & {R}_{2} & :={R}_{2}+5{R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 5 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}-1 & 0 & 2 \\\\ 0 & 1 & 2 \\\\ -4 & 0 & 3\\end{aligned}] & {R}_{3} & :={R}_{3}+(-4){R}_{1} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{aligned}]}}\\cdot {E}_{1}\\cdot A \\\\  & ∼[\\begin{aligned}-1 & 0 & 2 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & -5\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}A=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}A & =U \\\\ {E}_{1}A & ={E}_{2}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 & 0 \\\\ 5 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{aligned}]}^{-1}U \\\\ A & =([\\begin{aligned}1 & 0 & 0 \\\\ -5 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & 0 & 1\\end{aligned}])U \\\\ A & ={{[\\begin{aligned}1 & 0 & 0 \\\\ -5 & 1 & 0 \\\\ 4 & 0 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}-1 & 0 & 2 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & -5\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{31}=4,{u}_{23}=2,$ and ${l}_{31}\\cdot {u}_{23}=8.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-106855/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6e460dcd-59cf-54d2-80e6-c0d72b6bafdd"] :knowledge-point/questions ["q-106855"] :db/ensure [:knowledge-point/validate]} {:db/id "q-32720/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer/id #uuid "37d19e49-5da7-573f-88f3-734c7b738b6d" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "q-32720/selection/68d660245faa6640cb843d3998464f4b779fab9f99ac71d5091750d84d3b0b6d" :answer/id #uuid "9bf885c6-c7d1-5d54-9902-80a891e8dcf5" :answer/type :answer.type/math :answer/value "-0.25" :db/ensure [:answer/validate]} {:db/id "q-32720/selection/dcf9d025957f9a7e398ee27e3278a08d5ef306eee551ee9aaf74621913e2c3e7" :answer/id #uuid "538b180c-22d1-5690-9294-337460b2b382" :answer/type :answer.type/math :answer/value "-0.75" :db/ensure [:answer/validate]} {:db/id "q-32720/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "6596e6f3-1bc8-5992-bd21-b66038fd8e1d" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-32720/selection/bc99aa5f3ee62c40cb834b274ce88683dbffd8fee8404db2b536df0189aa9cdc" :answer/id #uuid "570db48f-f495-5225-b696-7baad51b3aad" :answer/type :answer.type/math :answer/value "0.75" :db/ensure [:answer/validate]} {:db/id "q-32720/selection" :answer-field/id #uuid "b283a94f-64d7-590c-ac59-4b00ec75090f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-32720/selection/dcf9d025957f9a7e398ee27e3278a08d5ef306eee551ee9aaf74621913e2c3e7" :answer-field/choices ["q-32720/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" "q-32720/selection/68d660245faa6640cb843d3998464f4b779fab9f99ac71d5091750d84d3b0b6d" "q-32720/selection/dcf9d025957f9a7e398ee27e3278a08d5ef306eee551ee9aaf74621913e2c3e7" "q-32720/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-32720/selection/bc99aa5f3ee62c40cb834b274ce88683dbffd8fee8404db2b536df0189aa9cdc"] :db/ensure [:answer-field/validate]} {:db/id "q-32720" :question/id #uuid "af54f755-4ec3-59c6-98a0-97707481b5cc" :question/math-academy-id "q-32720" :question/problem "Given that\n$B=[\\begin{aligned}1 & 1 & 1 \\\\ 1 & 5 & 1 \\\\ 0 & 1 & -3\\end{aligned}]$\nhas the LU decomposition $B=LU,$ then ${l}_{32}\\cdot {u}_{33}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $B$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $B$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}B & =[\\begin{aligned}1 & 1 & 1 \\\\ 1 & 5 & 1 \\\\ 0 & 1 & -3\\end{aligned}] & {R}_{2} & :={R}_{2}-{R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}}\\cdot B \\\\  & ∼[\\begin{aligned}1 & 1 & 1 \\\\ 0 & 4 & 0 \\\\ 0 & 1 & -3\\end{aligned}] & {R}_{3} & :={R}_{3}+(-0.25){R}_{2} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -0.25 & 1\\end{aligned}]}}\\cdot {E}_{1}\\cdot B \\\\  & ∼[\\begin{aligned}1 & 1 & 1 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & -3\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}B=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}B & =U \\\\ {E}_{1}B & ={E}_{2}^{-1}U \\\\ B & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ B & ={[\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -0.25 & 1\\end{aligned}]}^{-1}U \\\\ B & =([\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0.25 & 1\\end{aligned}])U \\\\ B & ={{[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0.25 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}1 & 1 & 1 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & -3\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{32}=0.25,{u}_{33}=-3,$ and ${l}_{32}\\cdot {u}_{33}=-0.75.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-32720/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6e460dcd-59cf-54d2-80e6-c0d72b6bafdd"] :knowledge-point/questions ["q-32720"] :db/ensure [:knowledge-point/validate]} {:db/id "q-106856/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "6f30b0e3-10d5-54b5-a457-e4c15ceac2a7" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-106856/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "0a5a7310-a166-5c9b-aa30-f75910cfd486" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-106856/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "421be741-e9ce-5f30-af88-8a73de96b91b" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-106856/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "3e8272f3-61f1-5f10-a44a-ac71f0e9e29f" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-106856/selection/10293ac0295e0e79554137a949f5c5c46b9812dcc0a3ecb6349c4cb5e6acdff3" :answer/id #uuid "8cf03183-ae4f-53df-b93e-424cdfcb08e7" :answer/type :answer.type/math :answer/value "-9" :db/ensure [:answer/validate]} {:db/id "q-106856/selection" :answer-field/id #uuid "3102dd81-817c-5c07-abda-1ff5d5a19e74" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-106856/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer-field/choices ["q-106856/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-106856/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-106856/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" "q-106856/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" "q-106856/selection/10293ac0295e0e79554137a949f5c5c46b9812dcc0a3ecb6349c4cb5e6acdff3"] :db/ensure [:answer-field/validate]} {:db/id "q-106856" :question/id #uuid "8f435648-2d36-5e4d-b72c-5ba9f10c97f3" :question/math-academy-id "q-106856" :question/problem "Given that \n$A=[\\begin{aligned}1 & -2 & 2 \\\\ 4 & -5 & 9 \\\\ -3 & 0 & -5\\end{aligned}]$ has the LU decomposition $A=LU,$ then ${l}_{32}\\cdot {u}_{33}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & -2 & 2 \\\\ 4 & -5 & 9 \\\\ -3 & 0 & -5\\end{aligned}] & {R}_{2} & :={R}_{2}+(-4){R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ -4 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}1 & -2 & 2 \\\\ 0 & 3 & 1 \\\\ -3 & 0 & -5\\end{aligned}] & {R}_{3} & :={R}_{3}+3{R}_{1} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}]}}\\cdot {E}_{1}\\cdot A \\\\  & ∼[\\begin{aligned}1 & -2 & 2 \\\\ 0 & 3 & 1 \\\\ 0 & -6 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{2} & ⟺ & \\,\\overset{{E}_{3}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 2 & 1\\end{aligned}]}}\\cdot {E}_{2}\\cdot {E}_{1}\\cdot A \\\\  & ∼[\\begin{aligned}1 & -2 & 2 \\\\ 0 & 3 & 1 \\\\ 0 & 0 & 3\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{3}{E}_{2}{E}_{1}A=U,$ we can invert ${E}_{3},$ ${E}_{2},$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{3}{E}_{2}{E}_{1}A & =U \\\\ {E}_{2}{E}_{1}A & ={E}_{3}^{-1}U \\\\ {E}_{1}A & ={E}_{2}^{-1}{E}_{3}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}{E}_{3}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 & 0 \\\\ -4 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 2 & 1\\end{aligned}]}^{-1}U \\\\ A & =([\\begin{aligned}1 & 0 & 0 \\\\ 4 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -2 & 1\\end{aligned}])U \\\\ A & ={{[\\begin{aligned}1 & 0 & 0 \\\\ 4 & 1 & 0 \\\\ -3 & -2 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}1 & -2 & 2 \\\\ 0 & 3 & 1 \\\\ 0 & 0 & 3\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{32}=-2,$ ${u}_{33}=3,$ and ${l}_{32}\\cdot {u}_{33}=-6.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-106856/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6e460dcd-59cf-54d2-80e6-c0d72b6bafdd"] :knowledge-point/questions ["q-106856"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-32532"] :question/problem "Given that \n$A=[\\begin{aligned}1 & 2 & -1 \\\\ 2 & 5 & 0 \\\\ -1 & -2 & 3\\end{aligned}]$ has the LU decomposition $A=LU,$ then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 2 & -1 \\\\ 2 & 5 & 0 \\\\ -1 & -2 & 3\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}1 & 2 & -1 \\\\ 0 & 1 & 2 \\\\ -1 & -2 & 3\\end{aligned}] & {R}_{3} & :={R}_{3}+{R}_{1} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 1\\end{aligned}]}}\\cdot {E}_{1}\\cdot A \\\\  & ∼[\\begin{aligned}1 & 2 & -1 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 2\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}A=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}A & =U \\\\ {E}_{1}A & ={E}_{2}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 1\\end{aligned}]}^{-1}U \\\\ A & =([\\begin{aligned}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -1 & 0 & 1\\end{aligned}])U \\\\ A & ={{[\\begin{aligned}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ -1 & 0 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}1 & 2 & -1 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 2\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4768"] :question/problem "Given that\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062432/assets/d4fa85cab74f4bda57059d1c6abc9dacea665531ce84ba9d2f1598a13c49ef60.png) \nhas the LU decomposition $A=LU,$ then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}4 & 1 & -6 \\\\ 0 & 3 & 1 \\\\ 0 & 6 & -2\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{2} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -2 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}4 & 1 & -6 \\\\ 0 & 3 & 1 \\\\ 0 & 0 & -4\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since $E_1A=U,$ we can invert $E_1$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -2 & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 2 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}4 & 1 & -6 \\\\ 0 & 3 & 1 \\\\ 0 & 0 & -4\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4769"] :question/problem "Suppose that a $3 \\times 3$ matrix $F$ is reduced to row echelon form using the following elementary row operations, applied in the order in which they appear:\n\n$$\nR_2:=R_2+R_1, \\qquad\n\tR_3:=R_3+2R_1\n$$\n\nGiven that $F$ has the LU factorization $F=LU,$ then $L=$" :question/worked-solution "Applying $R_2:=R_2 + {\\color{red}1} \\cdot R_1$ and then $R_3:=R_3+ {\\color{red}2} \\cdot R_1$ is equivalent to multiplying $F$ from the left by the following elementary matrices:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062432/assets/5eb696ca679a0079e8460d472b6f172df4f2e29f5dfef6cbdee388c55dcb1db5.png)\n\nNow, since $E_2E_1F=U,$ we can invert $E_2$ and $E_1$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}F & =U \\\\ {E}_{1}F & ={E}_{2}^{-1}U \\\\ F & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ F & ={[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 2 & 0 & 1\\end{aligned}]}^{-1}U \\\\ F & =([\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & 1\\end{aligned}])U \\\\ F & ={{[\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ -2 & 0 & 1\\end{aligned}]}_{⏟}}_{L}\\cdot U\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4770"] :question/problem "Given that\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062432/assets/e85dac75798b6cb463403f54ab2a675206d7eeea0a8958081aac9c696047b345.png)\nhas the LU decomposition $A=LU,$ then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}4 & 8 & 0 \\\\ 5 & 11 & -6 \\\\ 0 & -4 & 16\\end{aligned}] & {R}_{2} & :={R}_{2}+(-\\frac{5}{4}){R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{5}{4} & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}4 & 8 & 0 \\\\ 0 & 1 & -6 \\\\ 0 & -4 & 16\\end{aligned}] & {R}_{3} & :={R}_{3}+4{R}_{2} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 4 & 1\\end{aligned}]}}\\cdot {E}_{1}\\cdot A \\\\  & ∼[\\begin{aligned}4 & 8 & 0 \\\\ 0 & 1 & -6 \\\\ 0 & 0 & -8\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since $E_2E_1A=U,$ we can invert $E_2$ and $E_1$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}A & =U \\\\ {E}_{1}A & ={E}_{2}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{5}{4} & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 4 & 1\\end{aligned}]}^{-1}U \\\\ A & =([\\begin{aligned}1 & 0 & 0 \\\\ \\frac{5}{4} & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -4 & 1\\end{aligned}])U \\\\ A & ={{[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{5}{4} & 1 & 0 \\\\ 0 & -4 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}4 & 8 & 0 \\\\ 0 & 1 & -6 \\\\ 0 & 0 & -8\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$" :db/ensure [:question/validate]}]
