ligned}]}^{-1}U \\\\ C & =([\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{aligned}])U \\\\ C & ={{[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ -4 & 0 & 1\\end{aligned}]}_{⏟}}_{L}\\cdot U\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186343466 :knowledge-point/_questions [{:knowledge-point/id #uuid "5c91fb2b-5607-555d-b897-f0e76765dfa6" :knowledge-point/title "Finding the Lower Triangular Matrix Given the Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1626c63-8aaa-5bbb-8f30-c6dfcdb97792" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186343468} {:answer/id #uuid "13597c39-7c68-51a7-8766-3e059d7fe2f8" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 3 & 1\\end{aligned}]" :db/id #edb/ref 17592186343469} {:answer/id #uuid "2562e266-e539-5ef3-aca8-4dd093c371c7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & -3 & 1\\end{aligned}]" :db/id #edb/ref 17592186343470} {:answer/id #uuid "c6cc764f-4a95-5b3f-bbae-b2c13f6066a5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186343471} {:answer/id #uuid "4bfc9c8c-a567-5caf-ac86-6c880db1c4d6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186343472}] :answer-field/correct {:answer/id #uuid "b1626c63-8aaa-5bbb-8f30-c6dfcdb97792" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186343468} :answer-field/id #uuid "28d20fc7-51bd-50cf-b6b9-85c39fa2461d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186343467}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b83ddbaa-c847-5b1e-8fcb-fa749e23c108" :question/math-academy-id "q-32685" :question/problem "Suppose that a $3\\times 3$ matrix $C$ is reduced to row echelon form using the following elementary row operations, applied in the order in which they appear:\n\n$$\n{R}_{2}:={R}_{2}-3{R}_{1},\\,{R}_{3}:={R}_{3}+3{R}_{1}\n$$\n\nGiven that $C$ has the LU factorization $C=LU,$ then $L=$" :question/worked-solution "Applying ${R}_{2}:={R}_{2}+(-3)\\cdot {R}_{1}$ and then ${R}_{3}:={R}_{3}+3\\cdot {R}_{1}$ is equivalent to multiplying $C$ from the left by the following elementary matrices:\n\n$$\n{{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}]}_{⏟}}_{{E}_{2}}\\cdot {{[\\begin{aligned}1 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}_{⏟}}_{{E}_{1}}\\cdot C=U\n$$\n\nNow, since ${E}_{2}{E}_{1}C=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}C & =U \\\\ {E}_{1}C & ={E}_{2}^{-1}U \\\\ C & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ C & ={[\\begin{aligned}1 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}]}^{-1}U \\\\ C & =([\\begin{aligned}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}])U \\\\ C & ={{[\\begin{aligned}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]}_{⏟}}_{L}\\cdot U\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186343473 :knowledge-point/_questions [{:knowledge-point/id #uuid "6e460dcd-59cf-54d2-80e6-c0d72b6bafdd" :knowledge-point/title "Finding the LU Factorization Using Two or More Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37d19e49-5da7-573f-88f3-734c7b738b6d" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186343475} {:answer/id #uuid "9bf885c6-c7d1-5d54-9902-80a891e8dcf5" :answer/type {:db/ident :answer.type/math} :answer/value "-0.25" :db/id #edb/ref 17592186343476} {:answer/id #uuid "570db48f-f495-5225-b696-7baad51b3aad" :answer/type {:db/ident :answer.type/math} :answer/value "0.75" :db/id #edb/ref 17592186343477} {:answer/id #uuid "6596e6f3-1bc8-5992-bd21-b66038fd8e1d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186343478} {:answer/id #uuid "538b180c-22d1-5690-9294-337460b2b382" :answer/type {:db/ident :answer.type/math} :answer/value "-0.75" :db/id #edb/ref 17592186343479}] :answer-field/correct {:answer/id #uuid "538b180c-22d1-5690-9294-337460b2b382" :answer/type {:db/ident :answer.type/math} :answer/value "-0.75" :db/id #edb/ref 17592186343479} :answer-field/id #uuid "b283a94f-64d7-590c-ac59-4b00ec75090f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186343474}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "af54f755-4ec3-59c6-98a0-97707481b5cc" :question/math-academy-id "q-32720" :question/problem "Given that\n$B=[\\begin{aligned}1 & 1 & 1 \\\\ 1 & 5 & 1 \\\\ 0 & 1 & -3\\end{aligned}]$\nhas the LU decomposition $B=LU,$ then ${l}_{32}\\cdot {u}_{33}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $B$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $B$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}B & =[\\begin{aligned}1 & 1 & 1 \\\\ 1 & 5 & 1 \\\\ 0 & 1 & -3\\end{aligned}] & {R}_{2} & :={R}_{2}-{R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}}\\cdot B \\\\  & ∼[\\begin{aligned}1 & 1 & 1 \\\\ 0 & 4 & 0 \\\\ 0 & 1 & -3\\end{aligned}] & {R}_{3} & :={R}_{3}+(-0.25){R}_{2} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -0.25 & 1\\end{aligned}]}}\\cdot {E}_{1}\\cdot B \\\\  & ∼[\\begin{aligned}1 & 1 & 1 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & -3\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}B=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}B & =U \\\\ {E}_{1}B & ={E}_{2}^{-1}U \\\\ B & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ B & ={[\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -0.25 & 1\\end{aligned}]}^{-1}U \\\\ B & =([\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0.25 & 1\\end{aligned}])U \\\\ B & ={{[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0.25 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}1 & 1 & 1 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & -3\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{32}=0.25,{u}_{33}=-3,$ and ${l}_{32}\\cdot {u}_{33}=-0.75.$"}] [{:db/id #edb/ref 17592186343480 :knowledge-point/_questions [{:knowledge-point/id #uuid "a4d10f94-98d4-53d8-a35c-e65a06dd2c55" :knowledge-point/title "Finding the LU Factorization Using a Single Elementary Row Operation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86246cee-28ab-5eb6-84bf-b2ee1b0b7456" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186343482} {:answer/id #uuid "f739fae0-7682-5b46-9c7e-7cebd203bed1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186343483} {:answer/id #uuid "d5bb3222-a3a8-534c-8d18-8262eb5ef6f4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186343484} {:answer/id #uuid "4314a9a2-18d6-5135-b52f-f669d5e8ca45" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186343485} {:answer/id #uuid "b4440c05-eb53-5ba4-a6b9-3ef96029cea0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186343486}] :answer-field/correct {:answer/id #uuid "d5bb3222-a3a8-534c-8d18-8262eb5ef6f4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186343484} :answer-field/id #uuid "b6df1d8e-1523-5a0c-b598-780e058adb9d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186343481}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "5389cdd5-577a-5ad9-b29c-11a69f6cb769" :question/math-academy-id "q-75093" :question/problem "Given that\n$A=[\\begin{aligned}3 & 1 & 0 \\\\ 0 & 2 & 4 \\\\ 0 & -1 & 1\\end{aligned}]$\nhas the LU decomposition $A=LU,$ then ${l}_{32}\\cdot {u}_{33}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}3 & 1 & 0 \\\\ 0 & 2 & 4 \\\\ 0 & -1 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}+\\frac{1}{2}{R}_{2} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & \\frac{1}{2} & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}3 & 1 & 0 \\\\ 0 & 2 & 4 \\\\ 0 & 0 & 3\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & \\frac{1}{2} & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -\\frac{1}{2} & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}3 & 1 & 0 \\\\ 0 & 2 & 4 \\\\ 0 & 0 & 3\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{32}=-\\frac{1}{2},{u}_{33}=3,$ and ${l}_{32}\\cdot {u}_{33}=-\\frac{3}{2}.$"}] [{:db/id #edb/ref 17592186343487 :knowledge-point/_questions [{:knowledge-point/id #uuid "5c91fb2b-5607-555d-b897-f0e76765dfa6" :knowledge-point/title "Finding the Lower Triangular Matrix Given the Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "984521fd-475b-5fa1-b8c6-e07d9f042abf" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 4 & 1\\end{aligned}]" :db/id #edb/ref 17592186343489} {:answer/id #uuid "00b2d0e2-a028-5463-96dc-8302e7606d10" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 4 & 1 & 0 \\\\ 4 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186343490} {:answer/id #uuid "2aa40de8-da7a-58de-9bca-2214d4d0553d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -4 & 1 & 0 \\\\ 4 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186343491} {:answer/id #uuid "fea13e17-6687-5e21-88aa-bf29ca8fea25" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 4 & 1 & 0 \\\\ -4 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186343492} {:answer/id #uuid "ad4a0f4a-8911-512d-9472-4b106f13dcba" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & -4 & 1\\end{aligned}]" :db/id #edb/ref 17592186343493}] :answer-field/correct {:answer/id #uuid "2aa40de8-da7a-58de-9bca-2214d4d0553d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -4 & 1 & 0 \\\\ 4 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186343491} :answer-field/id #uuid "314af3a9-60f5-55f4-ba7f-671008a9f8ed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186343488}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3ec22232-a046-59e8-a23e-1122c9545c1c" :question/math-academy-id "q-75100" :question/problem "Suppose that a $3\\times 3$ matrix $H$ is reduced to row echelon form using the following elementary row operations, applied in the order in which they appear:\n\n$$\n{R}_{2}:={R}_{2}+4{R}_{1},\\,{R}_{3}:={R}_{3}-4{R}_{1}.\n$$\n\nGiven that $H$ has the LU factorization $H=LU,$ then $L=$" :question/worked-solution "Applying ${R}_{2}:={R}_{2}+4\\cdot {R}_{1}$ and then ${R}_{3}:={R}_{3}+(-4)\\cdot {R}_{1}$ is equivalent to multiplying $H$ from the left by the following elementary matrices:\n\n$$\n{{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{aligned}]}_{⏟}}_{{E}_{2}}\\cdot {{[\\begin{aligned}1 & 0 & 0 \\\\ 4 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}_{⏟}}_{{E}_{1}}\\cdot H=U\n$$\n\nNow, since ${E}_{2}{E}_{1}H=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}H & =U \\\\ {E}_{1}H & ={E}_{2}^{-1}U \\\\ H & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ H & ={[\\begin{aligned}1 & 0 & 0 \\\\ 4 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{aligned}]}^{-1}U \\\\ H & =([\\begin{aligned}1 & 0 & 0 \\\\ -4 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & 0 & 1\\end{aligned}])U \\\\ H & ={{[\\begin{aligned}1 & 0 & 0 \\\\ -4 & 1 & 0 \\\\ 4 & 0 & 1\\end{aligned}]}_{⏟}}_{L}\\cdot U\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186343494 :knowledge-point/_questions [{:knowledge-point/id #uuid "6e460dcd-59cf-54d2-80e6-c0d72b6bafdd" :knowledge-point/title "Finding the LU Factorization Using Two or More Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51c52066-4f7b-5eb6-b428-2aeb5320de49" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ -2 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186343496} {:answer/id #uuid "5ef5e943-5d7f-5897-b024-f87d45a30881" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 2 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186343497} {:answer/id #uuid "a8ed2870-d7db-57ee-bc30-a30aece65864" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -2 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186343498} {:answer/id #uuid "d59fdb4d-852c-5a4f-a308-71a73d971b6d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 2 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186343499} {:answer/id #uuid "55afd077-ebe0-55c9-9683-e0cf84463140" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -2 & -1 & 1\\end{aligned}]" :db/id #edb/ref 17592186343500}] :answer-field/correct {:answer/id #uuid "d59fdb4d-852c-5a4f-a308-71a73d971b6d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 2 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186343499} :answer-field/id #uuid "e3bab859-0d7e-514e-b9c5-1eb8a5a1ee29" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186343495}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "884fc6a3-6df8-5fa0-a711-f28bd28480fb" :question/math-academy-id "q-75102" :question/problem "Given that \n$A=[\\begin{aligned}1 & -2 & 1 \\\\ 0 & 3 & 0 \\\\ 2 & -1 & 1\\end{aligned}]$ has the LU decomposition $A=LU,$ then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & -2 & 1 \\\\ 0 & 3 & 0 \\\\ 2 & -1 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}1 & -2 & 1 \\\\ 0 & 3 & 0 \\\\ 0 & 3 & -1\\end{aligned}] & {R}_{3} & :={R}_{3}+(-1){R}_{2} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -1 & 1\\end{aligned}]}}\\cdot {E}_{1}\\cdot A \\\\  & ∼[\\begin{aligned}1 & -2 & 1 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & -1\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}A=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}A & =U \\\\ {E}_{1}A & ={E}_{2}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -1 & 1\\end{aligned}]}^{-1}U \\\\ A & =([\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 2 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 1\\end{aligned}])U \\\\ A & ={{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 2 & 1 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}1 & -2 & 1 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & -1\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$"}]}
