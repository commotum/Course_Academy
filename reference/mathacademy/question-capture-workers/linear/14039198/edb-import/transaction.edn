b77d71aea015a795ef3a94322293f8892"] :db/ensure [:answer-field/validate]} {:db/id "q-7469" :question/id #uuid "0c86d0c2-70d5-57fc-875d-6cf845fb24e1" :question/math-academy-id "q-7469" :question/problem "Express $\\sqrt{5}-2\\sqrt{5}{sin}^{2}⁡{42}^{∘}$ as a single trigonometric ratio." :question/worked-solution "Our expression can be factored as follows:\n\n$$\n\\sqrt{5}(1-2{sin}^{2}⁡{42}^{∘})\n$$\n\nNow, let's recall the double-angle formula for cosine:\n\n$$\n1-2{sin}^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x={42}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}1-2{sin}^{2}⁡{42}^{∘} & =\\operatorname{cos}⁡(2\\cdot {42}^{∘})=\\operatorname{cos}⁡{84}^{∘}.\\end{aligned}\n$$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}\\sqrt{5}(1-2{sin}^{2}⁡{42}^{∘}) & =\\sqrt{5}\\operatorname{cos}⁡{84}^{∘}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-7469/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "12ff17ae-9319-5498-a5e0-1d49ddbef50a"] :knowledge-point/questions ["q-7469"] :db/ensure [:knowledge-point/validate]} {:db/id "q-120367/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "7c5219c4-ac69-561c-be75-6488f1932617" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-120367/selection/e014eef6d5b5b99f76a63badf4d7e4589d1524a951e6f15c41809dcf478e3da9" :answer/id #uuid "e8bec08c-ae86-5d48-a777-72701b68b370" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-120367/selection/ac9362c9c743a0d4cd03c825418c9d77629147a5815c12295606faadbe8a8744" :answer/id #uuid "524cd620-996e-5b42-9d29-339fe60b226c" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "q-120367/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "40e13ddb-347e-500b-b008-bf4d0c424