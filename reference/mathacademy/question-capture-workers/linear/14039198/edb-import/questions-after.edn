12})-{sin}^{2}⁡(\\frac{\\pi }{12}) & =\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{12}) \\\\  & =\\operatorname{cos}⁡(\\frac{\\pi }{6}).\\end{aligned}\n$$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}3({cos}^{2}⁡(\\frac{\\pi }{12})-{sin}^{2}⁡(\\frac{\\pi }{12})) & =3\\operatorname{cos}⁡(\\frac{\\pi }{6}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186266308 :knowledge-point/_questions [{:knowledge-point/id #uuid "12ff17ae-9319-5498-a5e0-1d49ddbef50a" :knowledge-point/title "Using Alternative Forms of Double-Angle Formula to Simplify Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71e998d5-b71a-5b7a-83f9-c951b357c51a" :answer/type {:db/ident :answer.type/math} :answer/value "{cos}^{2}⁡{44}^{∘}" :db/id #edb/ref 17592186266310} {:answer/id #uuid "cb7355d7-d4ac-596c-b658-aa7ab1696b00" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡{44}^{∘}" :db/id #edb/ref 17592186266311} {:answer/id #uuid "a77c5fd7-c7a8-5284-b81b-43b64e7dba57" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡{44}^{∘}" :db/id #edb/ref 17592186266312} {:answer/id #uuid "50788728-3e22-5641-a6d8-e147c1cebff2" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡{22}^{∘}\\operatorname{cos}⁡{22}^{∘}" :db/id #edb/ref 17592186266313} {:answer/id #uuid "7637427d-5809-525a-991c-8dd31755c894" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡{25}^{∘}\\operatorname{cos}⁡{25}^{∘}" :db/id #edb/ref 17592186266314}] :answer-field/correct {:answer/id #uuid "cb7355d7-d4ac-596c-b658-aa7ab1696b00" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡{44}^{∘}" :db/id #edb/ref 17592186266311} :answer-field/id #uuid "cc446ca9-dc6d-520f-97f6-9657373b913d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186266309}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "69a7ca9e-fd71-55ad-91ce-07744b83a69e" :question/math-academy-id "q-7692" :question/problem "Express $2{cos}^{2}⁡{22}^{∘}-1$ as a single trigonometric ratio." :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n2{cos}^{2}⁡x-1=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x={22}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}2{cos}^{2}⁡{22}^{∘}-1 & =\\operatorname{cos}⁡2\\cdot {22}^{∘} \\\\  & =\\operatorname{cos}⁡{44}^{∘}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186302095 :knowledge-point/_questions [{:knowledge-point/id #uuid "12ff17ae-9319-5498-a5e0-1d49ddbef50a" :knowledge-point/title "Using Alternative Forms of Double-Angle Formula to Simplify Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04773666-8e4f-54de-91b2-332067749494" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡{36}^{∘}\\operatorname{cos}⁡{36}^{∘}" :db/id #edb/ref 17592186302097} {:answer/id #uuid "9e8a073c-7e33-515e-9de2-1bf142b0389a" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{cos}⁡{72}^{∘}" :db/id #edb/ref 17592186302098} {:answer/id #uuid "750c5e1e-2586-5ff1-9760-4f54efcdde5c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sin}⁡{36}^{∘}\\operatorname{cos}⁡{36}^{∘}" :db/id #edb/ref 17592186302099} {:answer/id #uuid "7afa6be2-cdd6-5e39-af22-7d1dbf0338d8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{cos}⁡{72}^{∘}" :db/id #edb/ref 17592186302100} {:answer/id #uuid "4824b862-5d92-5ff6-a51d-c06a69a63900" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{cos}⁡{72}^{∘}" :db/id #edb/ref 17592186302101}] :answer-field/correct {:answer/id #uuid "4824b862-5d92-5ff6-a51d-c06a69a63900" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{cos}⁡{72}^{∘}" :db/id #edb/ref 17592186302101} :answer-field/id #uuid "9f991d7c-3b31-5b1e-924d-a45774587aed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186302096}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "bfca1f7e-6c01-544c-9e9f-ee31b005c2cf" :question/math-academy-id "q-7693" :question/problem "Express $\\frac{1}{4}-\\frac{1}{2}{sin}^{2}⁡{36}^{∘}$ as a single trigonometric ratio." :question/worked-solution "Our expression can be factored as follows:\n\n$$\n\\frac{1}{4}(1-2{sin}^{2}⁡{36}^{∘})\n$$\n\nNow, let's recall the double-angle formula for cosine:\n\n$$\n1-2{sin}^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x={36}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}1-2{sin}^{2}⁡{36}^{∘} & =\\operatorname{cos}⁡(2\\cdot {36}^{∘})=\\operatorname{cos}⁡{72}^{∘}.\\end{aligned}\n$$\n\nFinally, we obtain \n\n$$\n\\frac{1}{4}(1-2{sin}^{2}⁡{36}^{∘})=\\frac{1}{4}\\operatorname{cos}⁡{72}^{∘}.\n$$"}] [{:db/id #edb/ref 17592186088283 :knowledge-point/_questions [{:knowledge-point/id #uuid "12ff17ae-9319-5498-a5e0-1d49ddbef50a" :knowledge-point/title "Using Alternative Forms of Double-Angle Formula to Simplify Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b388a129-be9f-59a8-aa62-56092d880d19" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cos^{2} 40^{∘}" :db/id #edb/ref 17592186086630} {:answer/id #uuid "bf5edfab-7fe2-5720-9256-4fbe6a721e9f" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin 20^{∘}\\cos 20^{∘}" :db/id #edb/ref 17592186086631} {:answer/id #uuid "cfae1a0f-283c-5324-9b27-eacc1048da6d" :answer/type {:db/ident :answer.type/math} :answer/value "5\\cos 40^{∘}" :db/id #edb/ref 17592186086632} {:answer/id #uuid "1e5987d3-7bf9-5c07-b5ca-76df4ac6b2ed" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sin 20^{∘}\\cos 20^{∘}" :db/id #edb/ref 17592186086633} {:answer/id #uuid "34b6fd5d-0633-5cb7-b0e2-1c594186c2fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos 40^{∘}" :db/id #edb/ref 17592186086634}] :answer-field/correct {:answer/id #uuid "cfae1a0f-283c-5324-9b27-eacc1048da6d" :answer/type {:db/ident :answer.type/math} :answer/value "5\\cos 40^{∘}" :db/id #edb/ref 17592186086632} :answer-field/id #uuid "8393dfab-9f1b-5096-8134-b15c3fcf7ee2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086629}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "9c84ae1b-25c3-565d-8730-075bec8eef99" :question/math-academy-id "q-7698" :question/problem "Express $5-10{sin}^{2}⁡{20}^{∘}$ as a single trigonometric ratio." :question/worked-solution "Our expression can be factored as follows:\n\n$$\n5(1-2{sin}^{2}⁡{20}^{∘})\n$$\n\nNow, let's recall the double-angle formula for cosine:\n\n$$\n1-2{sin}^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x={20}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}1-2{sin}^{2}⁡{20}^{∘} & =\\operatorname{cos}⁡(2\\cdot {20}^{∘})=\\operatorname{cos}⁡{40}^{∘}.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n5(1-2{sin}^{2}⁡{20}^{∘})=5\\operatorname{cos}⁡{40}^{∘}.\n$$"}]}
