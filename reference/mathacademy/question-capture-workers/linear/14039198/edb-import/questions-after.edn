eratorname{cos}⁡2x\n$$\n\nSubstituting $x=\\frac{3\\pi }{8}$ into the above, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡(\\frac{3\\pi }{8})-{sin}^{2}⁡(\\frac{3\\pi }{8}) & =\\operatorname{cos}⁡(2\\cdot \\frac{3\\pi }{8}) \\\\  & =\\operatorname{cos}⁡(\\frac{3\\pi }{4}) \\\\  & =-\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186302070 :knowledge-point/_questions [{:knowledge-point/id #uuid "2902b205-4508-55c6-9a68-f57d3afc9eab" :knowledge-point/title "Finding Exact Values of Trigonometric Expressions Using the Double-Angle Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "174a7923-257b-5ad2-ac2b-1ba97410d7f4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186302072} {:answer/id #uuid "2dc0b2e5-a987-5f9f-8445-7d3eabafac8e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186302073} {:answer/id #uuid "41cf8136-8583-5c85-923c-013100a22878" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186302074} {:answer/id #uuid "09246832-74f9-58c4-9d86-17557d4d52c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186302075} {:answer/id #uuid "c332b390-19af-59d0-9331-1327e944654b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186302076}] :answer-field/correct {:answer/id #uuid "09246832-74f9-58c4-9d86-17557d4d52c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186302075} :answer-field/id #uuid "a307b299-5428-5e41-bdfc-b161fbbb5a32" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186302071}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "bf6ceb46-c6fb-5788-bf6d-5e6b00180228" :question/math-academy-id "q-1