5" "q-39001/selection/570db0f9fe408e64db67fe3e88a2aa6e7fc460b1bd5ca52afd516914ec125cd6" "q-39001/selection/f8e36228239b19a50f190eaae60de8c6e1709d66ab8bbc0e4a0b763db2bcb475"] :db/ensure [:answer-field/validate]} {:db/id "q-39001" :question/id #uuid "d41c0c57-016c-54f5-82a5-fdc06b1403e1" :question/math-academy-id "q-39001" :question/problem "Given the matrix $A=[\\begin{aligned}1-\\text{i} & -2 \\\\ -\\text{i} & 5+\\text{i}\\end{aligned}]$, find the result of applying to $A$ the following elementary row operation:\n\n$$\n{R}_{2}:={R}_{2}+\\frac{\\text{i}}{1-\\text{i}}{R}_{1}\n$$" :question/worked-solution "Let's apply the row operations to $A:$\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1-\\text{i} & -2 \\\\ -\\text{i} & 5+\\text{i}\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{\\text{i}}{1-\\text{i}}{R}_{1} \\\\  & ∼[\\begin{aligned}1-\\text{i} & -2 \\\\ -\\text{i}+\\frac{\\text{i}(1-\\text{i})}{1-\\text{i}} & 5+\\text{i}-\\frac{2\\text{i}}{1-\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}1-\\text{i} & -2 \\\\ -\\text{i}+\\text{i} & \\frac{(5+\\text{i})\\cdot (1-\\text{i})-2\\text{i}}{1-\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}1-\\text{i} & -2 \\\\ 0 & 6\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the result  is \n\n$$\n[\\begin{aligned}1-\\text{i} & -2 \\\\ 0 & 6\\end{aligned}].\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-39001/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ef2e7753-83f4-5826-a04f-89616d34c578"] :knowledge-point/questions ["q-39001"] :db/ensure [:knowledge-point/validate]} {:db/id "q-76201/selection/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" :answer/id #uuid "d524159b-162e-5249-bfbe-4249a0a08b3f" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "q-76201/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "249b4a76-6452-50b5-a25c-3a0834cee96c" :answer/type :an