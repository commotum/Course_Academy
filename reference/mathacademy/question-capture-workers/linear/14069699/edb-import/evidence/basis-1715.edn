#{[{:db/id #edb/ref 17592186327581 :knowledge-point/_questions [{:knowledge-point/id #uuid "064d3c62-5cfc-502b-aba4-48e40042593f" :knowledge-point/title "Integrating Expressions Using the Double-Angle Formula for Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "297647da-3ab3-5dcc-9a0f-48a9dc1e495f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186327583} {:answer/id #uuid "ae3104d2-922a-56ba-ad75-57e2cb7a3a3c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186327584} {:answer/id #uuid "d2af47ef-76c7-5f0b-8538-94f85021dbeb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186327585} {:answer/id #uuid "d65d5927-bfb8-5799-9a36-4be823721147" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186327586} {:answer/id #uuid "5984ac9f-2835-5f33-a158-60355d52e40e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186327587}] :answer-field/correct {:answer/id #uuid "297647da-3ab3-5dcc-9a0f-48a9dc1e495f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186327583} :answer-field/id #uuid "20bf7902-d8bf-522c-b9ef-2ee403332062" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186327582}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "d3c3918e-b0d8-54bc-84f9-50f26c7e5758" :question/math-academy-id "q-51126" :question/problem "${\\int }_{0}^{\\pi /24}({cos}^{2}⁡2x-{sin}^{2}⁡2x)\\text{d}x=$" :question/worked-solution "Here, we use the double-angle formula for cosine:\n\n$$\n\\operatorname{cos}⁡2\\theta ={cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta .\n$$\n\nLetting $\\theta =2x,$ we get\n\n$$\n\\operatorname{cos}⁡4x={cos}^{2}⁡2x-{sin}^{2}⁡2x.\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /24}({cos}^{2}⁡2x-{sin}^{2}⁡2x)\\text{d}x & ={\\int }_{0}^{\\pi /24}\\operatorname{cos}⁡4x\\,\\text{d}x \\\\  & =\\frac{\\operatorname{sin}⁡4x}{4}{|}_{0}^{\\pi /24} \\\\  & =\\frac{1}{4}[\\operatorname{sin}⁡(4\\cdot \\frac{\\pi }{24})-\\operatorname{sin}⁡(4\\cdot 0)] \\\\  & =\\frac{1}{4}[\\operatorname{sin}⁡(\\frac{\\pi }{6})-\\operatorname{sin}⁡0] \\\\  & =\\frac{1}{4}(\\frac{1}{2}-0) \\\\  & =\\frac{1}{8}.\\end{aligned}\n$$"}]}
