#{[{:db/id #edb/ref 17592186361736 :knowledge-point/_questions [{:knowledge-point/id #uuid "b466bd78-724b-51b2-8fee-7991bf7b60d2" :knowledge-point/title "Integrating Using the Squared Cosine Variant of the Cosine Double-Angle Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88eef018-64bb-5b92-9c2f-1ec72b23190b" :answer/type {:db/ident :answer.type/math} :answer/value "5x-4\\operatorname{sin}⁡4x+C" :db/id #edb/ref 17592186361738} {:answer/id #uuid "0c9fa166-eeae-5071-b0a1-4bd3d34b9996" :answer/type {:db/ident :answer.type/math} :answer/value "5x+\\operatorname{sin}⁡4x+C" :db/id #edb/ref 17592186361739} {:answer/id #uuid "b5e0e150-4f95-50ed-81b8-24f3f0d94910" :answer/type {:db/ident :answer.type/math} :answer/value "x-\\operatorname{sin}⁡4x+C" :db/id #edb/ref 17592186361740} {:answer/id #uuid "3c91618c-4258-5a14-8cd8-01e1586709c1" :answer/type {:db/ident :answer.type/math} :answer/value "x+\\operatorname{sin}⁡4x+C" :db/id #edb/ref 17592186361741} {:answer/id #uuid "46b5ef69-26de-5cc2-a63e-ea09ebba0936" :answer/type {:db/ident :answer.type/math} :answer/value "5x-\\operatorname{sin}⁡4x+C" :db/id #edb/ref 17592186361742}] :answer-field/correct {:answer/id #uuid "b5e0e150-4f95-50ed-81b8-24f3f0d94910" :answer/type {:db/ident :answer.type/math} :answer/value "x-\\operatorname{sin}⁡4x+C" :db/id #edb/ref 17592186361740} :answer-field/id #uuid "16d79c9f-2069-5cd9-b62f-5a63f18b029f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186361737}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ff8c9059-4ccd-5c34-b361-0250f8da7c82" :question/math-academy-id "q-74408" :question/problem "Calculate \n$\\int (5-8{cos}^{2}⁡2x)\\text{d}x.$" :question/worked-solution "Here, we use the double-angle formula for cosine that involves the ${cos}^{2}⁡\\theta $ term, given by\n\n$$\n\\operatorname{cos}⁡2\\theta =2{cos}^{2}⁡\\theta -1.\n$$\n\n \n\nRearranging, we have\n\n$$\n{cos}^{2}⁡\\theta =\\frac{1}{2}(\\operatorname{cos}⁡2\\theta +1).\n$$\n\nLetting $\\theta =2x$, we have\n\n$$\n{cos}^{2}⁡2x=\\frac{1}{2}(\\operatorname{cos}⁡4x+1).\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}\\int (5-8{cos}^{2}⁡2x)\\text{d}x & =\\int [5-8\\cdot \\frac{1}{2}(\\operatorname{cos}⁡4x+1)]\\text{d}x \\\\  & =\\int [5-4(\\operatorname{cos}⁡4x+1)]\\text{d}x \\\\  & =\\int (1-4\\operatorname{cos}⁡4x)\\text{d}x \\\\  & =x-4(\\frac{1}{4}\\operatorname{sin}⁡4x)+C \\\\  & =x-\\operatorname{sin}⁡4x+C.\\end{aligned}\n$$"}]}
