/14069587/state.json" "file_sha256" "5efee3b433b1f9c9ed2c9a846412c153cccb5159d00616f305a9fdbebceee41d" "basis" 2383 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069587/edb-import/verification.json"} {"question" "q-74408" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "x+\\operatorname{sin}⁡4x+C"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069587/state.json" "file_sha256" "5efee3b433b1f9c9ed2c9a846412c153cccb5159d00616f305a9fdbebceee41d" "basis" 2383 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069587/edb-import/verification.json"} {"question" "q-74408" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "x-\\operatorname{sin}⁡4x+C"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069587/state.json" "file_sha256" "5efee3b433b1f9c9ed2c9a846412c153cccb5159d00616f305a9fdbebceee41d" "basis" 2383 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069587/edb-import/verification.json"}] "sources" [{"question" "q-51126" "field" nil "attribute" "question/problem" "value" "${\\int }_{0}^{\\pi /24}({cos}^{2}⁡2x-{sin}^{2}⁡2x)\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069699/state.json" "file_sha256" "dd4809f3b843dcdf0a3ce63b9ef914bd2aa5b129fdea2577080f660a9b4ea0a9"} {"question" "q-51126" "field" nil "attribute" "question/worked-solution" "value" "Here, we use the double-angle formula for cosine:\n\n$$\n\\operatorname{cos}⁡2\\theta ={cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta .\n$$\n\nLetting $\\theta =2x,$ we get\n\n$$\n\\operatorname{cos}⁡4x={cos}^{2}⁡2x-{sin}^{2}⁡2x.\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /24}({cos}^{2}⁡2x-{sin}^{2}⁡2x)\\text{d}x & ={\\int }_{0}^{\\pi /24}\\operatorname{cos}⁡4x\\,\\text{d}x \\\\  & =\\frac{\\operatorname{sin}⁡4x}{4}{|}_{0}^{\\pi /24} \\\\  & =\\frac{1}{4}[\\operatorname{sin}⁡(4\\cdot \\frac{\\pi }{24})-\\operatorname{sin}⁡(4\\cdot 0)] \\\\  & =\\frac{1}{4}[\\operatorname{sin}⁡(\\frac{\\pi }{6})-\\operatorname{sin}⁡0] \\\\  & =\\frac{1}{4}(\\frac{1}{2}-0) \\\\  & =\\frac{1}{8}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069699/state.json" "file_sha256" "dd4809f3b843dcdf0a3ce63b9ef914bd2aa5b129fdea2577080f660a9b4ea0a9"} {"question" "q-51126" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069699/activity-metadata.json" "file_sha256" "be2ec1c2c020562b69dde749a023e9ec962997facf5dad09fa674e7955a85558"} {"question" "q-51126" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069699/state.json" "file_sha256" "dd4809f3b843dcdf0a3ce63b9ef914bd2aa5b129fdea2577080f660a9b4ea0a9"} {"question" "q-51126" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{1}{2}"] ["math" "\\frac{1}{4}"] ["math" "\\frac{1}{8}"] ["math" "\\frac{2}{3}"] ["math" "\\frac{3}{8}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069699/state.json" "file_sha256" "dd4809f3b843dcdf0a3ce63b9ef914bd2aa5b129fdea2577080f660a9b4ea0a9"} {"question" "q-51126" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{8}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069699/state.json" "file_sha256" "dd4809f3b843dcdf0a3ce63b9ef914bd2aa5b129fdea2577080f660a9b4ea0a9"} {"question" "q-74408" "field" nil "attribute" "question/problem" "value" "Calculate \n$\\int (5-8{cos}^{2}⁡2x)\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069699/state.json" "file_sha256" "dd4809f3b843dcdf0a3ce63b9ef914bd2aa5b129fdea2577080f660a9b4ea0a9"} {"question" "q-74408" "field" nil "attribute" "question/worked-solution" "value" "Here, we use the double-angle formula for cosine that involves the ${cos}^{2}⁡\\theta $ term, given by\n\n$$\n\\operatorname{cos}⁡2\\theta =2{cos}^{2}⁡\\theta -1.\n$$\n\n \n\nRearranging, we have\n\n$$\n{cos}^{2}⁡\\theta =\\frac{1}{2}(\\operatorname{cos}⁡2\\theta +1).\n$$\n\nLetting $\\theta =2x$, we have\n\n$$\n{cos}^{2}⁡2x=\\frac{1}{2}(\\operatorname{cos}⁡4x+1).\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}\\int (5-8{cos}^{2}⁡2x)\\text{d}x & =\\int [5-8\\cdot \\frac{1}{2}(\\operatorname{cos}⁡4x+1)]\\text{d}x \\\\  & =\\int [5-4(\\operatorname{cos}⁡4x+1)]\\text{d}x \\\\  & =\\int (1-4\\operatorname{cos}⁡4x)\\text{d}x \\\\  & =x-4(\\frac{1}{4}\\operatorname{sin}⁡4x)+C \\\\  & =x-\\operatorname{sin}⁡4x+C.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069699/state.json" "file_sha256" "dd4809f3b843dcdf0a3ce63b9ef914bd2aa5b129fdea2577080f660a9b4ea0a9"} {"question" "q-74408" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069699/activity-metadata.json" "file_sha256" "be2ec1c2c020562b69dde749a023e9ec962997facf5dad09fa674e7955a85558"} {"question" "q-74408" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069699/state.json" "file_sha256" "dd4809f3b843dcdf0a3ce63b9ef914bd2aa5b129fdea2577080f660a9b4ea0a9"} {"question" "q-74408" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "5x+\\operatorname{sin}⁡4x+C"] ["math" "5x-4\\operatorname{sin}⁡4x+C"] ["math" "5x-\\operatorname{sin}⁡4x+C"] ["math" "x+\\operatorname{sin}⁡4x+C"] ["math" "x-\\operatorname{sin}⁡4x+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069699/state.json" "file_sha256" "dd4809f3b843dcdf0a3ce63b9ef914bd2aa5b129fdea2577080f660a9b4ea0a9"} {"question" "q-74408" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "x-\\operatorname{sin}⁡4x+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069699/state.json" "file_sha256" "dd4809f3b843dcdf0a3ce63b9ef914bd2aa5b129fdea2577080f660a9b4ea0a9"} {"question" "q-74410" "field" nil "attribute" "question/problem" "value" "Calculate $\\int (1-2{sin}^{2}⁡x)\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069699/state.json" "file_sha256" "dd4809f3b843dcdf0a3ce63b9ef914bd2aa5b129fdea2577080f660a9b4ea0a9"} {"question" "q-74410" "field" nil "attribute" "question/worked-solution" "value" "Let's recall the double-angle formula for cosine that involves the ${sin}^{2}$ term: \n\n$$\n\\operatorname{cos}⁡2x=1-2{sin}^{2}⁡x\n$$\n\nWe can now integrate as follows:\n\n$$\n\\begin{aligned}\\int (1-2{sin}^{2}⁡x)\\text{d}x & =\\int \\operatorname{cos}⁡2x\\,\\text{d}x \\\\  & =\\frac{1}{2}\\operatorname{sin}⁡2x+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069699/state.json" "file_sha256" "dd4809f3b843dcdf0a3ce63b9ef914bd2aa5b129fdea2577080f660a9b4ea0a9"} {"question" "q-74410" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069699/activity-metadata.json" "file_sha256" "be2ec1c2c020562b69dde749a023e9ec962997facf5dad09fa674e7955a85558"} {"question" "q-74410" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069699/state.json" "file_sha256" "dd4809f3b843dcdf0a3ce63b9ef914bd2aa5b129fdea2577080f660a9b4ea0a9"} {"question" "q-74410" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{1}{2}\\operatorname{sin}⁡2x+C"] ["math" "-\\operatorname{sin}⁡2x+C"] ["math" "2\\operatorname{sin}⁡2x+C"] ["math" "\\frac{1}{2}\\operatorname{sin}⁡2x+C"] ["math" "\\operatorname{sin}⁡2x+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069699/state.json" "file_sha256" "dd4809f3b843dcdf0a3ce63b9ef914bd2aa5b129fdea2577080f660a9b4ea0a9"} {"question" "q-74410" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{2}\\operatorname{sin}⁡2x+C"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069699/state.json" "file_sha256" "dd4809f3b843dcdf0a3ce63b9ef914bd2aa5b129fdea2577080f660a9b4ea0a9"} {"question" "q-348756" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069699/assets/77004c9040818fbc254b9564b9c5821536ef65fcc77f6765b56d2e8524c24ed4.png)\n\nFind the area $A$ of the region in the $xy$-plane that is bounded by the curve $y=6{cos}^{2}\\,(\\frac{x}{3})+2{sin}^{2}\\,(\\frac{x}{3})+1,$ the $x$-axis and the lines $x=-\\frac{3\\pi }{2}$ and $x=0,$ as shown above. Do not round the answer\n\n$A=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069699/state.json" "file_sha256" "dd4809f3b843dcdf0a3ce63b9ef914bd2aa5b129fdea2577080f660a9b4ea0a9"} {"question" "q-348756" "field" nil "attribute" "question/worked-solution" "value" "The area of the region is given by\n\n$$\nA={\\int }_{-3\\pi /2}^{0}(6{cos}^{2}\\,(\\frac{x}{3})+2{sin}^{2}\\,(\\frac{x}{3})+1)\\,\\text{d}x.\n$$\n\nRecall  ${cos}^{2}⁡x+{sin}^{2}⁡x=1,$ so we have \n\n$$\n\\begin{aligned}6{cos}^{2}\\,(\\frac{x}{3})+2{sin}^{2}\\,(\\frac{x}{3})+1 & =4{cos}^{2}\\,(\\frac{x}{3})+2({sin}^{2}\\,(\\frac{x}{3})+{cos}^{2}\\,(\\frac{x}{3}))+1 \\\\  & =4{cos}^{2}\\,(\\frac{x}{3})+3.\\end{aligned}\n$$\n\nHere, we use the double-angle formula for cosine that involves the ${cos}^{2}⁡x$ term, given by\n\n$$\n\\operatorname{cos}⁡2x=2{cos}^{2}⁡x-1.\n$$\n\n \n\nRearranging, we have\n\n$$\n2{cos}^{2}⁡x=\\operatorname{cos}⁡2x+1.\n$$\n\nHence, the area of the region is\n\n$$\n\\begin{aligned}A & ={\\int }_{-3\\pi /2}^{0}(4{cos}^{2}\\,(\\frac{x}{3})+3)\\,\\text{d}x \\\\  & ={\\int }_{-3\\pi /2}^{0}(2(cos\\,(\\frac{2x}{3})+1)+3)\\,\\text{d}x \\\\  & ={\\int }_{-3\\pi /2}^{0}(2cos\\,(\\frac{2x}{3})+5)\\,\\text{d}x \\\\  & ={(3sin\\,(\\frac{2x}{3})+5x)\\,|}_{-3\\pi /2}^{0} \\\\  & =(3\\operatorname{sin}⁡0+5\\cdot 0)-(3sin\\,(\\frac{2}{3}\\cdot (-\\frac{3\\pi }{2}))+5(-\\frac{3\\pi }{2})) \\\\  & =(0+0)-(3\\operatorname{sin}⁡(-\\pi )-\\frac{15\\pi }{2}) \\\\  & =(0)-(0-\\frac{15\\pi }{2}) \\\\  & =\\frac{15\\pi }{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069699/state.json" "file_sha256" "dd4809f3b843dcdf0a3ce63b9ef914bd2aa5b129fdea2577080f660a9b4ea0a9"} {"question" "q-348756" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069699/activity-metadata.json" "file_sha256" "be2ec1c2c020562b69dde749a023e9ec962997facf5dad09fa674e7955a85558"} {"question" "q-348756" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069699/state.json" "file_sha256" "dd4809f3b843dcdf0a3ce63b9ef914bd2aa5b129fdea2577080f660a9b4ea0a9"} {"question" "q-348756" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{15\\pi}{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069699/state.json" "file_sha256" "dd4809f3b843dcdf0a3ce63b9ef914bd2aa5b129fdea2577080f660a9b4ea0a9"} {"question" "q-348844" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{3\\pi }^{6\\pi }6{sin}^{2}⁡(\\frac{x}{6})\\,\\text{d}x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069699/state.json" "file_sha256" "dd4809f3b843dcdf0a3ce63b9ef914bd2aa5b129fdea2577080f660a9b4ea0a9"} {"question" "q-348844" "field" nil "attribute" "question/worked-solution" "value" "Let's recall the double-angle formula for cosine that involves the ${sin}^{2}$ term: \n\n$$\n\\operatorname{cos}⁡2\\theta =1-2{sin}^{2}⁡\\theta .\n$$\n\nWe can rearrange the above formula as\n\n$$\n1-\\operatorname{cos}⁡2\\theta =2{sin}^{2}⁡\\theta .\n$$\n\nLetting $\\theta =\\frac{x}{6},$ we have\n\n$$\n1-\\operatorname{cos}⁡(\\frac{x}{3})=2{sin}^{2}⁡(\\frac{x}{6}).\n$$\n\nWe can now integrate as follows:\n\n$$\n\\begin{aligned}{\\int }_{3\\pi }^{6\\pi }6{sin}^{2}⁡(\\frac{x}{6})\\,\\text{d}x & =3{\\int }_{3\\pi }^{6\\pi }2{sin}^{2}⁡(\\frac{x}{6})\\,\\text{d}x \\\\  & =3{\\int }_{3\\pi }^{6\\pi }[1-\\operatorname{cos}⁡(\\frac{x}{3})]\\text{d}x \\\\  & =3{[x-3\\operatorname{sin}⁡(\\frac{x}{3})]}_{3\\pi }^{6\\pi } \\\\  & =3[6\\pi -3\\operatorname{sin}⁡(\\frac{6\\pi }{3})-(3\\pi -3\\operatorname{sin}⁡(\\frac{3\\pi }{3}))] \\\\  & =3[6\\pi -3\\operatorname{sin}⁡(2\\pi )-(3\\pi -3\\operatorname{sin}⁡(\\pi ))] \\\\  & =3(6\\pi -3\\pi ) \\\\  & =9\\pi .\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069699/state.json" "file_sha256" "dd4809f3b843dcdf0a3ce63b9ef914bd2aa5b129fdea2577080f660a9b4ea0a9"} {"question" "q-348844" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069699/activity-metadata.json" "file_sha256" "be2ec1c2c020562b69dde749a023e9ec962997facf5dad09fa674e7955a85558"} {"question" "q-348844" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069699/state.json" "file_sha256" "dd4809f3b843dcdf0a3ce63b9ef914bd2aa5b129fdea2577080f660a9b4ea0a9"} {"question" "q-348844" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "9\\pi"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069699/state.json" "file_sha256" "dd4809f3b843dcdf0a3ce63b9ef914bd2aa5b129fdea2577080f660a9b4ea0a9"}] "usage" {"q-51126" [] "q-74410" [] "q-74408" []} "basis" 2404 "retractions" [] "immutable_answers" [17592186288727 17592186288728 17592186288729 1759218