#{[{:db/id #edb/ref 17592186327581 :knowledge-point/_questions [{:knowledge-point/id #uuid "064d3c62-5cfc-502b-aba4-48e40042593f" :knowledge-point/title "Integrating Expressions Using the Double-Angle Formula for Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "297647da-3ab3-5dcc-9a0f-48a9dc1e495f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186327583} {:answer/id #uuid "ae3104d2-922a-56ba-ad75-57e2cb7a3a3c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186327584} {:answer/id #uuid "d2af47ef-76c7-5f0b-8538-94f85021dbeb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186327585} {:answer/id #uuid "d65d5927-bfb8-5799-9a36-4be823721147" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186327586} {:answer/id #uuid "5984ac9f-2835-5f33-a158-60355d52e40e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186327587}] :answer-field/correct {:answer/id #uuid "297647da-3ab3-5dcc-9a0f-48a9dc1e495f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186327583} :answer-field/id #uuid "20bf7902-d8bf-522c-b9ef-2ee403332062" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186327582}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "d3c3918e-b0d8-54bc-84f9-50f26c7e5758" :question/math-academy-id "q-51126" :question/problem "${\\int }_{0}^{\\pi /24}({cos}^{2}⁡2x-{sin}^{2}⁡2x)\\text{d}x=$" :question/worked-solution "Here, we use the double-angle formula for cosine:\n\n$$\n\\operatorname{cos}⁡2\\theta ={cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta .\n$$\n\nLetting $\\theta =2x,$ we get\n\n$$\n\\operatorname{cos}⁡4x={cos}^{2}⁡2x-{sin}^{2}⁡2x.\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /24}({cos}^{2}⁡2x-{sin}^{2}⁡2x)\\text{d}x & ={\\int }_{0}^{\\pi /24}\\operatorname{cos}⁡4x\\,\\text{d}x \\\\  & =\\frac{\\operatorname{sin}⁡4x}{4}{|}_{0}^{\\pi /24} \\\\  & =\\frac{1}{4}[\\operatorname{sin}⁡(4\\cdot \\frac{\\pi }{24})-\\operatorname{sin}⁡(4\\cdot 0)] \\\\  & =\\frac{1}{4}[\\operatorname{sin}⁡(\\frac{\\pi }{6})-\\operatorname{sin}⁡0] \\\\  & =\\frac{1}{4}(\\frac{1}{2}-0) \\\\  & =\\frac{1}{8}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186361736 :knowledge-point/_questions [{:knowledge-point/id #uuid "b466bd78-724b-51b2-8fee-7991bf7b60d2" :knowledge-point/title "Integrating Using the Squared Cosine Variant of the Cosine Double-Angle Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88eef018-64bb-5b92-9c2f-1ec72b23190b" :answer/type {:db/ident :answer.type/math} :answer/value "5x-4\\operatorname{sin}⁡4x+C" :db/id #edb/ref 17592186361738} {:answer/id #uuid "0c9fa166-eeae-5071-b0a1-4bd3d34b9996" :answer/type {:db/ident :answer.type/math} :answer/value "5x+\\operatorname{sin}⁡4x+C" :db/id #edb/ref 17592186361739} {:answer/id #uuid "b5e0e150-4f95-50ed-81b8-24f3f0d94910" :answer/type {:db/ident :answer.type/math} :answer/value "x-\\operatorname{sin}⁡4x+C" :db/id #edb/ref 17592186361740} {:answer/id #uuid "3c91618c-4258-5a14-8cd8-01e1586709c1" :answer/type {:db/ident :answer.type/math} :answer/value "x+\\operatorname{sin}⁡4x+C" :db/id #edb/ref 17592186361741} {:answer/id #uuid "46b5ef69-26de-5cc2-a63e-ea09ebba0936" :answer/type {:db/ident :answer.type/math} :answer/value "5x-\\operatorname{sin}⁡4x+C" :db/id #edb/ref 17592186361742}] :answer-field/correct {:answer/id #uuid "b5e0e150-4f95-50ed-81b8-24f3f0d94910" :answer/type {:db/ident :answer.type/math} :answer/value "x-\\operatorname{sin}⁡4x+C" :db/id #edb/ref 17592186361740} :answer-field/id #uuid "16d79c9f-2069-5cd9-b62f-5a63f18b029f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186361737}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ff8c9059-4ccd-5c34-b361-0250f8da7c82" :question/math-academy-id "q-74408" :question/problem "Calculate \n$\\int (5-8{cos}^{2}⁡2x)\\text{d}x.$" :question/worked-solution "Here, we use the double-angle formula for cosine that involves the ${cos}^{2}⁡\\theta $ term, given by\n\n$$\n\\operatorname{cos}⁡2\\theta =2{cos}^{2}⁡\\theta -1.\n$$\n\n \n\nRearranging, we have\n\n$$\n{cos}^{2}⁡\\theta =\\frac{1}{2}(\\operatorname{cos}⁡2\\theta +1).\n$$\n\nLetting $\\theta =2x$, we have\n\n$$\n{cos}^{2}⁡2x=\\frac{1}{2}(\\operatorname{cos}⁡4x+1).\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}\\int (5-8{cos}^{2}⁡2x)\\text{d}x & =\\int [5-8\\cdot \\frac{1}{2}(\\operatorname{cos}⁡4x+1)]\\text{d}x \\\\  & =\\int [5-4(\\operatorname{cos}⁡4x+1)]\\text{d}x \\\\  & =\\int (1-4\\operatorname{cos}⁡4x)\\text{d}x \\\\  & =x-4(\\frac{1}{4}\\operatorname{sin}⁡4x)+C \\\\  & =x-\\operatorname{sin}⁡4x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288725 :knowledge-point/_questions [{:knowledge-point/id #uuid "31f3ead1-2549-5b61-baf9-0437ba28f09d" :knowledge-point/title "Integrating Using the Squared Sine Variant of the Cosine Double-Angle Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30d0b2b8-6037-5e30-8c7e-dc875e31d807" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sin}⁡2x+C" :db/id #edb/ref 17592186288727} {:answer/id #uuid "6bd8c527-f2cf-5bcd-b204-b5e9811dfd6a" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡2x+C" :db/id #edb/ref 17592186288728} {:answer/id #uuid "cdc46874-f687-57e2-aaba-12c246abf376" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡2x+C" :db/id #edb/ref 17592186288729} {:answer/id #uuid "67419508-3f81-53e7-9110-63ca99506a49" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{sin}⁡2x+C" :db/id #edb/ref 17592186288730} {:answer/id #uuid "848fb85e-72a1-5896-93c7-89c1071885f2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡2x+C" :db/id #edb/ref 17592186288731}] :answer-field/correct {:answer/id #uuid "30d0b2b8-6037-5e30-8c7e-dc875e31d807" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sin}⁡2x+C" :db/id #edb/ref 17592186288727} :answer-field/id #uuid "65c462af-9369-5e19-acfc-b87c6a056b59" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288726}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9b373498-84db-5708-b542-71c40a8177eb" :question/math-academy-id "q-74410" :question/problem "Calculate $\\int (1-2{sin}^{2}⁡x)\\text{d}x.$" :question/worked-solution "Let's recall the double-angle formula for cosine that involves the ${sin}^{2}$ term: \n\n$$\n\\operatorname{cos}⁡2x=1-2{sin}^{2}⁡x\n$$\n\nWe can now integrate as follows:\n\n$$\n\\begin{aligned}\\int (1-2{sin}^{2}⁡x)\\text{d}x & =\\int \\operatorname{cos}⁡2x\\,\\text{d}x \\\\  & =\\frac{1}{2}\\operatorname{sin}⁡2x+C\\end{aligned}\n$$"}]}
