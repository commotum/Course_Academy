s/differential/14040374/edb-import/verification.json"} {"question" "q-103537" "field" nil "attribute" "question/worked-solution" "value" "Since ${\\lambda }_{1}=-5+4\\text{i}$ is a complex eigenvalue of $A,$ the second eigenvalue of $A$ must be the complex conjugate of ${\\lambda }_{1}.$\nTherefore, \n\n$$\n{\\lambda }_{2}={\\overset{―}{\\lambda }}_{1}=-5-4\\text{i}.\n$$\n\nFinally, we have\n\n$$\n\\begin{aligned}\\frac{2}{5}({\\lambda }_{1}+{\\lambda }_{2}) & =\\frac{2}{5}((-5+4\\text{i})+(-5-4\\text{i})) \\\\  & =\\frac{2}{5}(-10) \\\\  & =-4.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040374/state.json" "file_sha256" "16a0ebc5e06e1189ea7fe5612c5a4a2fd3b0947108223d014dd9157cbea4d864" "basis" 1439 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040374/edb-import/verification.json"} {"question" "q-103537" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040374/activity-metadata.json" "file_sha256" "3fbdccf92f21a7349d5f8d53750e5de002224031c4ed05ea7ba15dd8ed17a4ed" "basis" 1439 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040374/edb-import/verification.json"} {"question" "q-103537" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040374/state.json" "file_sha256" "16a0ebc5e06e1189ea7fe5612c5a4a2fd3b0947108223d014dd9157cbea4d864" "basis" 1439 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040374/edb-import/verification.json"} {"question" "q-103537"