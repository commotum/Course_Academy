#{[{:db/id #edb/ref 17592186128911 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "7a453400-6363-5782-b346-aae37570c9bc" :knowledge-point/title "Computing the Complex Eigenvalues of a Matrix"}] :question/id #uuid "3958f8c6-0808-510b-81f5-bb82de6a203f" :question/math-academy-id "e-5904" :question/problem "Compute the eigenvalues of the matrix $[\\begin{aligned}1 & -2 \\\\ 2 & 1\\end{aligned}]$" :question/worked-solution "First, we find the matrix $\\, A-\\lambda I \\mathbin{:}$\n\n﻿﻿﻿\n\n$$\n[\\begin{aligned}1-\\lambda  & -2 \\\\ 2 & 1-\\lambda \\end{aligned}]\n$$\n\nThen, we compute the characteristic equation, as follows:\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ |\\begin{aligned}1-\\lambda  & -2 \\\\ 2 & 1-\\lambda \\end{aligned}| & =0 \\\\ (1-\\lambda )(1-\\lambda )-2(-2) & =0 \\\\ 1-2\\lambda +{\\lambda }^{2}+4 & =0 \\\\ {\\lambda }^{2}-2\\lambda +5 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we get\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{-b\\pm \\sqrt{{b}^{2}-4ac}}{2a} \\\\  & =\\frac{-(-2)\\pm \\sqrt{(-2)^{2}-4(1)(5)}}{2(1)} \\\\  & =\\frac{2\\pm \\sqrt{-16}}{2} \\\\  & =\\frac{2\\pm 4\\text{i}}{2} \\\\  & =1\\pm 2\\text{i}.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda=1\\pm 2\\textrm{i}.$"}] [{:db/id #edb/ref 17592186128912 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "2eae4328-dd7c-5f77-8958-840cadb6f7f1" :knowledge-point/title "Finding a Complex Eigenvalue of a 2x2 Matrix Given Another Eigenvalue"}] :question/id #uuid "2c47a76d-1b5d-5a10-a3c8-aff9647ca068" :question/math-academy-id "e-5905" :question/problem "Given that $\\lambda_1=-2+3\\textrm{i}$ and $\\lambda_2$ are eigenvalues of a real $2 \\times 2$ matrix $A,$ find $2(\\lambda_1+\\lambda_2).$" :question/worked-solution "Since $\\lambda_1=-2+3\\textrm{i}$ is a complex eigenvalue of $A,$ the second eigenvalue of $A$ must be the complex conjugate of $\\lambda_1.$\nTherefore, \n\n$$\n\\lambda_2=\\overline{\\lambda}_1=-2-3\\textrm{i}.\n$$\n\nFinally, we have\n\n$$\n\\begin{aligned}2({\\lambda }_{1}+{\\lambda }_{2}) & =2(-2+3\\text{i}+(-2-3\\text{i})) \\\\  & =2(-4) \\\\  & =-8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186307627 :knowledge-point/_questions [{:knowledge-point/id #uuid "2eae4328-dd7c-5f77-8958-840cadb6f7f1" :knowledge-point/title "Finding a Complex Eigenvalue of a 2x2 Matrix Given Another Eigenvalue"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25fae2e6-14c0-516b-8444-68f750cb6527" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\text{i}" :db/id #edb/ref 17592186307629} {:answer/id #uuid "a88bfe7d-995e-567a-8e50-3ff8c9545133" :answer/type {:db/ident :answer.type/math} :answer/value "2\\text{i}" :db/id #edb/ref 17592186307630} {:answer/id #uuid "cc971f74-2251-53ae-b45f-03a1bf10e715" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186307631} {:answer/id #uuid "73607b48-c462-53de-86b6-5fa72660e878" :answer/type {:db/ident :answer.type/math} :answer/value "4\\text{i}" :db/id #edb/ref 17592186307632} {:answer/id #uuid "1fde457c-cb7f-5542-997b-89d29ab7765c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{3}" :db/id #edb/ref 17592186307633}] :answer-field/correct {:answer/id #uuid "73607b48-c462-53de-86b6-5fa72660e878" :answer/type {:db/ident :answer.type/math} :answer/value "4\\text{i}" :db/id #edb/ref 17592186307632} :answer-field/id #uuid "a2448746-ac4d-529f-a34e-70f6afb968f3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307628}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9f1195eb-a99c-59d9-bfbf-e214bc1dc200" :question/math-academy-id "q-102775" :question/problem "Given that ${\\lambda }_{1}=5+3\\text{i}$ and ${\\lambda }_{2}$ are eigenvalues of a real $2\\times 2$ matrix $A$, find $\\frac{2}{3}({\\lambda }_{1}-{\\lambda }_{2}).$" :question/worked-solution "Since ${\\lambda }_{1}=5+3\\text{i}$ is a complex eigenvalue of $A,$ the second eigenvalue of $A$ must be the complex conjugate of ${\\lambda }_{1}.$\nTherefore, \n\n$$\n{\\lambda }_{2}={\\overset{―}{\\lambda }}_{1}=5-3\\text{i}.\n$$\n\nFinally, we have\n\n$$\n\\begin{aligned}\\frac{2}{3}({\\lambda }_{1}-{\\lambda }_{2}) & =\\frac{2}{3}(5+3\\text{i}-(5-3\\text{i})) \\\\  & =\\frac{2}{3}(6\\text{i}) \\\\  & =4\\text{i}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186307641 :knowledge-point/_questions [{:knowledge-point/id #uuid "2eae4328-dd7c-5f77-8958-840cadb6f7f1" :knowledge-point/title "Finding a Complex Eigenvalue of a 2x2 Matrix Given Another Eigenvalue"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c59f0377-8de5-5b8b-9162-cc404ff2f704" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16}{5}\\text{i}" :db/id #edb/ref 17592186307643} {:answer/id #uuid "2c3a4384-aa8a-54db-b0fe-5561d2114183" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186307644} {:answer/id #uuid "4efa1b61-edef-557f-a411-5c5950bc73ad" :answer/type {:db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186307645} {:answer/id #uuid "be566864-3458-5716-9b03-416806a6cdcf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{5}\\text{i}" :db/id #edb/ref 17592186307646} {:answer/id #uuid "c14984d3-bcd9-510a-a753-d613ee51de3c" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186307647}] :answer-field/correct {:answer/id #uuid "2c3a4384-aa8a-54db-b0fe-5561d2114183" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186307644} :answer-field/id #uuid "80de7772-e5eb-5079-8d4a-41cea2ce9af7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307642}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "16e5813a-69f6-5b0b-900d-faf261fbea66" :question/math-academy-id "q-103537" :question/problem "Given that ${\\lambda }_{1}=-5+4\\text{i}$ and ${\\lambda }_{2}$ are eigenvalues of a real $2\\times 2$ matrix $A$, find $\\frac{2}{5}({\\lambda }_{1}+{\\lambda }_{2}).$" :question/worked-solution "Since ${\\lambda }_{1}=-5+4\\text{i}$ is a complex eigenvalue of $A,$ the second eigenvalue of $A$ must be the complex conjugate of ${\\lambda }_{1}.$\nTherefore, \n\n$$\n{\\lambda }_{2}={\\overset{―}{\\lambda }}_{1}=-5-4\\text{i}.\n$$\n\nFinally, we have\n\n$$\n\\begin{aligned}\\frac{2}{5}({\\lambda }_{1}+{\\lambda }_{2}) & =\\frac{2}{5}((-5+4\\text{i})+(-5-4\\text{i})) \\\\  & =\\frac{2}{5}(-10) \\\\  & =-4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186129659 :knowledge-point/_questions [{:knowledge-point/id #uuid "2eae4328-dd7c-5f77-8958-840cadb6f7f1" :knowledge-point/title "Finding a Complex Eigenvalue of a 2x2 Matrix Given Another Eigenvalue"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b724793b-8a5d-5b36-8d6c-63f65c67dcd6" :answer/type {:db/ident :answer.type/math} :answer/value "8\\textrm{i}" :db/id #edb/ref 17592186127749} {:answer/id #uuid "d3bb46f8-b32a-54e0-a3b9-f62319a2dfc0" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186127750} {:answer/id #uuid "0e7145de-de31-54c4-a5af-6534079b0902" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186127751} {:answer/id #uuid "284dc96d-d948-569c-b28f-e5dbfa969c86" :answer/type {:db/ident :answer.type/math} :answer/value "16 - 8\\textrm{i}" :db/id #edb/ref 17592186127752} {:answer/id #uuid "2b200246-2d91-5508-95df-0082cfc22863" :answer/type {:db/ident :answer.type/math} :answer/value "-8\\textrm{i}" :db/id #edb/ref 17592186127753}] :answer-field/correct {:answer/id #uuid "2b200246-2d91-5508-95df-0082cfc22863" :answer/type {:db/ident :answer.type/math} :answer/value "-8\\textrm{i}" :db/id #edb/ref 17592186127753} :answer-field/id #uuid "0c0ec769-b2ea-57c9-9691-bcc49c607b67" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186127748}] :question/id #uuid "6f56ec3d-740e-50b1-8973-afd1a436543e" :question/math-academy-id "q-39184" :question/problem "Given that $λ_{1} = 4 + 2\\textrm{i}$ and $λ_{2}$ are eigenvalues of a real $2 \\cdot 2$ matrix $A$, find $2(λ_{2} - λ_{1})$."}] [{:db/id #edb/ref 17592186307648 :knowledge-point/_questions [{:knowledge-point/id #uuid "7a453400-6363-5782-b346-aae37570c9bc" :knowledge-point/title "Computing the Complex Eigenvalues of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9dae8719-5c1a-58d0-b9f9-856895db45d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =-3\\pm 2\\text{i}" :db/id #edb/ref 17592186307650} {:answer/id #uuid "3ef135ac-74a8-5f63-8327-6ae3ef6a7a68" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =3\\pm 2\\text{i}" :db/id #edb/ref 17592186307651} {:answer/id #uuid "fef5b820-7cea-5ee5-957a-943d909978b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =-3\\pm 3\\text{i}" :db/id #edb/ref 17592186307652} {:answer/id #uuid "6615ca1a-e75a-53d7-a29b-e1e4ca4b8f73" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =-2\\pm 3\\text{i}" :db/id #edb/ref 17592186307653} {:answer/id #uuid "4dcb1b71-9c3b-5013-a849-d2a05bf7c928" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =3\\pm 3\\text{i}" :db/id #edb/ref 17592186307654}] :answer-field/correct {:answer/id #uuid "3ef135ac-74a8-5f63-8327-6ae3ef6a7a68" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =3\\pm 2\\text{i}" :db/id #edb/ref 17592186307651} :answer-field/id #uuid "f1c3607d-3f0e-5436-a6b9-f05776129344" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307649}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "252141a6-142d-5ad2-94ac-bb05b0444744" :question/math-academy-id "q-39186" :question/problem "Compute the eigenvalues of the matrix $A=[\\begin{aligned}1 & -2 \\\\ 4 & 5\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=[\\begin{aligned}1-\\lambda  & -2 \\\\ 4 & 5-\\lambda \\end{aligned}]\n$$\n\nThen, we compute the characteristic equation, as follows:\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ |\\begin{aligned}1-\\lambda  & -2 \\\\ 4 & 5-\\lambda \\end{aligned}| & =0 \\\\ (1-\\lambda )(5-\\lambda )-4(-2) & =0 \\\\ 5-\\lambda -5\\lambda +{\\lambda }^{2}+8 & =0 \\\\ {\\lambda }^{2}-6\\lambda +13 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we get\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{-b\\pm \\sqrt{{b}^{2}-4ac}}{2a} \\\\  & =\\frac{6\\pm \\sqrt{(-6)^{2}-4(1)(13)}}{2(1)} \\\\  & =\\frac{6\\pm \\sqrt{-16}}{2} \\\\  & =\\frac{6\\pm 4\\text{i}}{2} \\\\  & =3\\pm 2\\text{i}.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =3\\pm 2\\text{i}.$"}] [{:db/id #edb/ref 17592186307676 :knowledge-point/_questions [{:knowledge-point/id #uuid "2eae4328-dd7c-5f77-8958-840cadb6f7f1" :knowledge-point/title "Finding a Complex Eigenvalue of a 2x2 Matrix Given Another Eigenvalue"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c850429a-90ff-5070-81d7-06b7be6e124a" :answer/type {:db/ident :answer.type/math} :answer/value "6\\text{i}" :db/id #edb/ref 17592186307678} {:answer/id #uuid "7fc4fe00-99b4-5493-96c3-68a19e9f74fd" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186307679} {:answer/id #uuid "0726d242-9b99-5d4c-b22b-856999accb9d" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186307680} {:answer/id #uuid "cd6e1cd2-a0b9-5732-912b-ced1074b3c0a" :answer/type {:db/ident :answer.type/math} :answer/value "3\\text{i}" :db/id #edb/ref 17592186307681} {:answer/id #uuid "65cc1fc3-2e0a-58c8-a15a-dd36929fc97f" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186307682}] :answer-field/correct {:answer/id #uuid "7fc4fe00-99b4-5493-96c3-68a19e9f74fd" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186307679} :answer-field/id #uuid "11322505-a9ce-5bfc-b450-1a4b2ed2fcb1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307677}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6bdddd65-2107-5d29-9a4d-0f6ba2861d68" :question/math-academy-id "q-81036" :question/problem "Given that ${\\lambda }_{1}=6-\\text{i}$ and ${\\lambda }_{2}$ are eigenvalues of a real $2\\times 2$ matrix $A$, find $3({\\lambda }_{1}+{\\lambda }_{2}).$" :question/worked-solution "Since ${\\lambda }_{1}=6-\\text{i}$ is a complex eigenvalue of $A,$ the second eigenvalue of $A$ must be the complex conjugate of ${\\lambda }_{1}.$\nTherefore, \n\n$$\n{\\lambda }_{2}={\\overset{―}{\\lambda }}_{1}=6+\\text{i}.\n$$\n\nFinally, we have\n\n$$\n\\begin{aligned}3({\\lambda }_{1}+{\\lambda }_{2}) & =3(6-\\text{i}+(6+\\text{i})) \\\\  & =3(12) \\\\  & =36.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186307683 :knowledge-point/_questions [{:knowledge-point/id #uuid "7a453400-6363-5782-b346-aae37570c9bc" :knowledge-point/title "Computing the Complex Eigenvalues of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e785c53-41a1-5158-a588-9b6cc59df58b" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =\\pm 4\\text{i}" :db/id #edb/ref 17592186307685} {:answer/id #uuid "8f7b84d5-923b-5c05-9a58-8b2c92dc9349" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =4\\pm \\text{i}" :db/id #edb/ref 17592186307686} {:answer/id #uuid "876fa660-73b1-5e64-bb2b-f0ce00314154" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =2\\pm 4\\text{i}" :db/id #edb/ref 17592186307687} {:answer/id #uuid "75519b4d-771f-559b-af5d-68d0a0fdbd45" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =\\pm 8\\text{i}" :db/id #edb/ref 17592186307688} {:answer/id #uuid "336ea47e-2d02-5896-91be-8aa3012ae451" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =\\pm 2\\text{i}" :db/id #edb/ref 17592186307689}] :answer-field/correct {:answer/id #uuid "3e785c53-41a1-5158-a588-9b6cc59df58b" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =\\pm 4\\text{i}" :db/id #edb/ref 17592186307685} :answer-field/id #uuid "3d940503-c5ad-5030-97f5-026ae2937fba" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307684}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "023400e2-b200-55f2-b07e-675b3e7d655f" :question/math-academy-id "q-81144" :question/problem "Compute the eigenvalues of the matrix $A=[\\begin{aligned}1 & 1 \\\\ -17 & -1\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=[\\begin{aligned}1-\\lambda  & 1 \\\\ -17 & -1-\\lambda \\end{aligned}]\n$$\n\nThen, we compute the characteristic equation, as follows:\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ |\\begin{aligned}1-\\lambda  & 1 \\\\ -17 & -1-\\lambda \\end{aligned}| & =0 \\\\ (1-\\lambda )(-1-\\lambda )-1(-17) & =0 \\\\ -1-\\lambda +\\lambda +{\\lambda }^{2}+17 & =0 \\\\ {\\lambda }^{2}+16 & =0 \\\\ {\\lambda }^{2} & =-16 \\\\ \\lambda  & =\\pm 4\\text{i}\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =\\pm 4\\text{i}.$"}]}
