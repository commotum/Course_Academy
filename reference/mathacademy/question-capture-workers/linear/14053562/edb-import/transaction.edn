b6"] :db/ensure [:answer-field/validate]} {:db/id "q-104462" :question/id #uuid "2f245d15-61bb-55e5-8528-9e0a762de9e0" :question/math-academy-id "q-104462" :question/problem "The cubic polynomial $P(x)$ has roots ${x}_{1}=2,{x}_{2}={x}_{3}=4,$ and the coefficient of the cubic term is $-5.$ Find $P(x).$" :question/worked-solution "Since our cubic polynomial has roots ${x}_{1}=2$ and ${x}_{2}={x}_{3}=4,$ and the coefficient of the cubic term is $a=-5,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) & =-5(x-2)(x-4)(x-4) \\\\  & =-5(x-2)(x-4)(x-4)\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}-5(x-2)(x-4)(x-4) & =-5({x}^{2}-6x+8)(x-4) \\\\  & =-5({x}^{3}-4{x}^{2}-6{x}^{2}+24x+8x-32) \\\\  & =-5({x}^{3}-10{x}^{2}+32x-32) \\\\  & =-5{x}^{3}+50{x}^{2}-160x+160.\\end{aligned}\n$$\n\nTherefore, $P(x)=-5{x}^{3}+50{x}^{2}-160x+160.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-104462/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "517f2054-008e-54eb-89dd-5f0a09e1f881"] :knowledge-point/questions ["q-104462"] :db/ensure [:knowledge-point/validate]} {:db/id "q-107539/selection/607b44a750cb874df3c717918a1809251098a010112e2aae033c1c8a0ad73e40" :answer/id #uuid "ad448141-2f9c-5ab6-bfcf-d881d41f2395" :answer/type :answer.type/math :answer/value "{x}^{3}-8{x}^{2}+21x-9" :db/ensure [:answer/validate]} {:db/id "q-107539/selection/f2c3ac5943ab469d549d2614f896c4c62af04e7ab5364412a07e97ebe102ca1f" :answer/id #uuid "64a6683d-6c4f-5d36-ba30-c6bce9320788" :answer/type :answer.type/math :answer/value "-{x}^{3}+8{x}^{2}-12x+22" :db/ensure [:answer/validate]} {:db/id "q-107539/selection/17235145f3ba06e3df17b04694e2224a33df8035be328ad7d6ae347e21378cc4" :answer/id #uuid "6417af2b-0a47-592f-a594-dd629a924010" :answer/type :answer.type/math :answer/value "-{x}^{3}+6{x}^{2}-21x+16" :db/ensure [:answer/validate]} {:db/id "q-107539/selection/ce491d08828484608b5ffdecd3aa69343667d59ccfb794c3cf867002495f733e" :answer/id #uuid "99cd8e08-829a-5197-b288-8b76545856b5" :answer/type :answer.type/math :answer/value "-{x}^{3}+8{x}^{2}-21x+18" :db/ensure [:answer/validate]} {:db/id "q-107539/selection/699d88779f0b0044156a0ca69e9da294ca38bc1e6f4285ee032506194479e962" :answer/id #uuid "75f361eb-8acf-59c0-b177-33e0828f1cf9" :answer/type :answer.type/math :answer/value "{x}^{3}+8{x}^{2}+12x+18" :db/ensure [:answer/validate]} {:db/id "q-107539/selection" :answer-field/id #uuid "252b2089-ffb7-5a9c-bacf-6a303fe970cf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-107539/selection/ce491d08828484608b5ffdecd3aa69343667d59ccfb794c3cf867002495f733e" :answer-field/choices ["q-107539/selection/607b44a750cb874df3c717918a1809251098a010112e2aae033c1c8a0ad73e40" "q-107539/selection/f2c3ac5943ab469d549d2614f896c4c62af04e7ab5364412a07e97ebe102ca1f" "q-107539/selection/17235145f3ba06e3df17b04694e2224a33df8035be328ad7d6ae347e21378cc4" "q-107539/selection/ce491d08828484608b5ffdecd3aa69343667d59ccfb794c3cf867002495f733e" "q-107539/selection/699d88779f0b0044156a0ca69e9da294ca38bc1e6f4285ee032506194479e962"] :db/ensure [:answer-field/validate]} {:db/id "q-107539" :question/id #uuid "128d5b26-43e1-5fcd-92bd-6969aedf5743" :question/math-academy-id "q-107539" :question/problem "The cubic polynomial $P(x)$ has roots ${x}_{1}=2,{x}_{2}={x}_{3}=3,$ and the coefficient of the cubic term is $-1.$ Find $P(x).$" :question/worked-solution "Since our cubic polynomial has roots ${x}_{1}=2$ and ${x}_{2}={x}_{3}=3,$ and the coefficient of the cubic term is $a=-1,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) & =-1(x-2)(x-3)(x-3) \\\\  & =-(x-2)(x-3)(x-3)\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}-(x-2)(x-3)(x-3) & =-({x}^{2}-6x+9)(x-2) \\\\  & =-({x}^{3}-6{x}^{2}-2{x}^{2}+9x+12x-18) \\\\  & =-({x}^{3}-8{x}^{2}+21x-18) \\\\  & =-{x}^{3}+8{x}^{2}-21x+18.\\end{aligned}\n$$\n\nTherefore, $P(x)=-{x}^{3}+8{x}^{2}-21x+18.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-107539/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "517f2054-008e-54eb-89dd-5f0a09e1f881"] :knowledge-point/questions ["q-107539"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316632/field-1/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "d4d8838d-b303-5796-9a99-a76dd2698893" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-316632/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "2a68f4a4-80cb-51c1-86d6-67601fd46675" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-316632/field-1" :answer-field/id #uuid "fe6bfdc1-e945-530e-86e5-2e1128d2ea21" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316632/field-1/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer-field/choices ["q-316632/field-1/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" "q-316632/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-316632/field-2/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd" :answer/id #uuid "2129c94b-c58d-5cb6-885f-9f1f8cebfdbd" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "q-316632/field-2" :answer-field/id #uuid "e00f29dd-42ae-516d-8b06-3c645742bdc3" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316632/field-2/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd" :answer-field/choices ["q-316632/field-2/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd"] :db/ensure [:answer-field/validate]} {:db/id "q-316632/field-3/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "01ab7159-89db-5d91-a441-ddc926de3abe" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-316632/field-3" :answer-field/id #uuid "98e1ec42-e406-56f4-b364-333be84357ba" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316632/field-3/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer-field/choices ["q-316632/field-3/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97"] :db/ensure [:answer-field/validate]} {:db/id "q-316632/field-4/695792c47319cb1ed098a6d83038b7ad6d032838f9103d693bf346f1dc234ff8" :answer/id #uuid "0323eed4-f2e8-5509-8919-1e77050931dc" :answer/type :answer.type/math :answer/value "40" :db/ensure [:answer/validate]} {:db/id "q-316632/field-4" :answer-field/id #uuid "dc46fa2e-79d0-562b-9cc8-adad5925d1d2" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316632/field-4/695792c47319cb1ed098a6d83038b7ad6d032838f9103d693bf346f1dc234ff8" :answer-field/choices ["q-316632/field-4/695792c47319cb1ed098a6d83038b7ad6d032838f9103d693bf346f1dc234ff8"] :db/ensure [:answer-field/validate]} {:db/id "q-316632" :question/id #uuid "74c9a8e5-90b4-5268-8e9c-fc75ce69b404" :question/math-academy-id "q-316632" :question/problem "The cubic polynomial $P(x)$ has roots ${x}_{1}=1,$ ${x}_{2}=-5,$ and ${x}_{3}=-2,$ and the coefficient of the cubic term is $-4.$ Find $P(x).$\n\n$P(x)=$\n{{field-1}}${x}^{3}\\,-$\n{{field-2}}${x}^{2}\\,-$\n{{field-3}}$x\\,+$\n{{field-4}}" :question/worked-solution "Since our cubic polynomial has roots ${x}_{1}=1,$ ${x}_{2}=-5,$ and ${x}_{3}=-2,$ and the coefficient of the cubic term is $a=-4,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) & =-4(x-1)(x-(-5))(x-(-2)) \\\\  & =-4(x-1)(x+5)(x+2)\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}-4(x-1)(x+5)(x+2) & =-4({x}^{2}+4x-5)(x+2) \\\\  & =-4({x}^{3}+2{x}^{2}+4{x}^{2}+8x-5x-10) \\\\  & =-4({x}^{3}+6{x}^{2}+3x-10) \\\\  & =-4{x}^{3}-24{x}^{2}-12x+40.\\end{aligned}\n$$\n\nTherefore, $P(x)=-4{x}^{3}-24{x}^{2}-12x+40.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-316632/field-1" "q-316632/field-2" "q-316632/field-3" "q-316632/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "517f2054-008e-54eb-89dd-5f0a09e1f881"] :knowledge-point/questions ["q-316632"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316725/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "5d3d8e8c-7015-514a-83d5-689d89928164" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-316725/field-1" :answer-field/id #uuid "71eec172-b52c-5418-b4c8-f8193b53a4fa" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316725/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-316725/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-316725/field-2/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "1907cff1-d30a-5b75-824e-0f4eeed40d3c" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-316725/field-2" :answer-field/id #uuid "93924ffb-a290-5db3-a9aa-c4a3471f00b8" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316725/field-2/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer-field/choices ["q-316725/field-2/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97"] :db/ensure [:answer-field/validate]} {:db/id "q-316725/field-3/695792c47319cb1ed098a6d83038b7ad6d032838f9103d693bf346f1dc234ff8" :answer/id #uuid "4be33203-eb3d-5b59-b741-3172d9bd920c" :answer/type :answer.type/math :answer/value "40" :db/ensure [:answer/validate]} {:db/id "q-316725/field-3" :answer-field/id #uuid "f2d8b4fb-dea8-5833-96e3-217d302463fc" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316725/field-3/695792c47319cb1ed098a6d83038b7ad6d032838f9103d693bf346f1dc234ff8" :answer-field/choices ["q-316725/field-3/695792c47319cb1ed098a6d83038b7ad6d032838f9103d693bf346f1dc234ff8"] :db/ensure [:answer-field/validate]} {:db/id "q-316725" :question/id #uuid "d1df841d-233d-5571-b2fe-b548c0a2b431" :question/math-academy-id "q-316725" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14053562/assets/dd92f4b41c95c436027cce015b688df1a982f46913b0ea262f2d30e1e49259d5.png)\n\nThe Argand diagram above shows the roots of the cubic polynomial $f(x).$ Find $f(x)$ given that the coefficient of the cubic term is $-2.$\n\n$f(x)=$\n{{field-1}}${x}^{3}\\,-$\n{{field-2}}$x\\,+$\n{{field-3}}" :question/worked-solution "From the diagram, we see that $f(x)$ has roots ${x}_{1}=2$ and ${x}_{2,3}=-1\\pm 3\\text{i}.$ Additionally, we're given that the coefficient of the cubic term is $a=-2.$ Therefore, we can write the polynomial as follows:\n\n$$\n\\begin{aligned}f(x) & =a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) \\\\  & =-2(x-2)(x-(-1+3\\text{i}))(x-(-1-3\\text{i}))\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}-2(x-2)(x-(-1+3\\text{i}))(x-(-1-3\\text{i})) & = \\\\ -2(x-2)({x}^{2}-x(-1-3\\text{i})-x(-1+3\\text{i})+(-1+3\\text{i})(-1-3\\text{i})) & = \\\\ -2(x-2)({x}^{2}+2x+10) & = \\\\ -2({x}^{3}+2{x}^{2}+10x-2{x}^{2}-4x-20) & = \\\\ -2({x}^{3}+6x-20) & = \\\\ -2{x}^{3}-12x+40 & .\\end{aligned}\n$$\n\nTherefore, $f(x)=-2{x}^{3}-12x+40.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-316725/field-1" "q-316725/field-2" "q-316725/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e4bb90c5-2794-5657-8f0b-45eb64873e03"] :knowledge-point/questions ["q-316725"] :db/ensure [:knowledge-point/validate]}]
