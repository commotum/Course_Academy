e83618e4e82d145e8bbb7f217612b58e5edbb3536ca"} {"question" "q-37630" "field" nil "attribute" "question/problem" "value" "Find ${N}^{18}$ where\n\n$$\nN=[\\begin{aligned}8 & 5 \\\\ 4 & 3\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 0 & \\sqrt[9]{2}\\end{aligned}]{[\\begin{aligned}8 & 5 \\\\ 4 & 3\\end{aligned}]}^{-1}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14075976/state.json" "file_sha256" "3122387245bdfcd7fb4e4e83618e4e82d145e8bbb7f217612b58e5edbb3536ca"} {"question" "q-37630" "field" nil "attribute" "question/worked-solution" "value" "We have been given the following diagonalization of $N.$\n\n$$\nN={{[\\begin{aligned}8 & 5 \\\\ 4 & 3\\end{aligned}]}_{⏟}}_{P}{{[\\begin{aligned}1 & 0 \\\\ 0 & \\sqrt[9]{2}\\end{aligned}]}_{⏟}}_{D}{{{[\\begin{aligned}8 & 5 \\\\ 4 & 3\\end{aligned}]}^{-1}}_{⏟}}_{{P}^{-1}}\n$$\n\nSo, since $N=PD{P}^{-1}$, we can compute ${N}^{k}$ by using the formula \n\n$$\n{N}^{k}=P{D}^{k}{P}^{-1}.\n$$\n\nFirst, we find the inverse of the matrix $P.$ We get\n\n$$\n{[\\begin{aligned}8 & 5 \\\\ 4 & 3\\end{aligned}]}^{-1}=\\frac{1}{4}[\\begin{aligned}3 & -5 \\\\ -4 & 8\\end{aligned}].\n$$\n\nCarrying out the necessary multiplication, we obtain the following:\n\n \n\n$$\n\\begin{aligned}{N}^{18} & =P{D}^{18}{P}^{-1} \\\\  & =[\\begin{aligned}8 & 5 \\\\ 4 & 3\\end{aligned}]{[\\begin{aligned}1 & 0 \\\\ 0 & \\sqrt[9]{2}\\end{aligned}]}^{18}[\\begin{aligned}\\frac{3}{4} & -\\frac{5}{4} \\\\ -1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}8 & 5 \\\\ 4 & 3\\end{aligned}][\\begin{aligned}{1}^{18} & 0 \\\\ 0 & (\\sqrt[9]{2})^{18}\\end{aligned}](\\frac{1}{4}[\\begin{aligned}3 & -5 \\\\ -4 & 8\\end{aligned}]) \\\\  & =\\frac{1}{4}[\\begin{aligned}8 & 5 \\\\ 4 & 3\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 0 & {2}^{2}\\end{aligned}][\\begin{aligned}3 & -5 \\\\ -4 & 8\\end{aligned}] \\\\  & =\\frac{1}{4}[\\begin{aligned}8 & 5 \\\\ 4 & 3\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 0 & 4\\end{aligned}][\\begin{aligned}3 & -5 \\\\ -4 & 8\\end{aligned}] \\\\  & =\\frac{1}{4}[\\begin{aligned}8 & 20 \\\\ 4 & 12\\end{aligned}][\\begin{aligned}3 & -5 \\\\ -4 & 8\\end{aligned}] \\\\  & =[\\begin{aligned}-14 & 30 \\\\ -9 & 19\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14075976/state.json" "file_sha256" "3122387245bdfcd7fb4e4e83618e4e82d145e8bbb7f217612b58e5edbb3536ca"} {"question" "q-37630" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14075976/activity-metadata.json" "file_sha256" "1b472652f6dcfcea926ca811d937c5f6603cb344b5981fce3a4088b99cbbdf10"} {"question" "q-37630" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14075976/state.json" "file_sha256" "3122387245bdfcd7fb4e4e83618e4e82d145e8bbb7f217612b58e5edbb3536ca"} {"question" "q-37630" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-14 & 30 \\\\ -9 & 19\\end{aligned}]"] ["math" "[\\begin{aligned}1 & 0 \\\\ 0 & 16\\end{aligned}]"] ["math" "[\\begin{aligned}6 & -12 \\\\ -4 & 24\\end{aligned}]"] ["math" "[\\begin{aligned}70 & -13 \\\\ 17 & -29\\end{aligned}]"] ["math" "[\\begin{aligned}70 & 32 \\\\ 32 & -52\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14075976/state.json" "file_sha256" "3122387245bdfcd7fb4e4e83618e4e82d145e8bbb7f217612b58e5edbb3536ca"} {"question" "q-37630" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}-14 & 30 \\\\ -9 & 19\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14075976/state.json" "file_sha256" "3122387245bdfcd7fb4e4e83618e4e82d145e8bbb7f217612b58e5edbb3536ca"} {"question" "q-86686" "field" nil "attribute" "question/problem" "value" "Find ${A}^{85},$ where\n\n$$\nA=[\\begin{aligned}-2 & 0 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}]{[\\begin{aligned}-2 & 0 \\\\ -1 & 1\\end{aligned}]}^{-1}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14075976/state.json" "file_sha256" "3122387245bdfcd7fb4e4e83618e4e82d145e8bbb7f217612b58e5edbb3536ca"} {"question" "q-86686" "field" nil "attribute" "question/worked-solution" "value" "We have been given the following diagonalization of $A.$\n\n$$\nA={{[\\begin{aligned}-2 & 0 \\\\ -1 & 1\\end{aligned}]}_{⏟}}_{P}{{[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}]}_{⏟}}_{D}{{{[\\begin{aligned}-2 & 0 \\\\ -1 & 1\\end{aligned}]}^{-1}}_{⏟}}_{{P}^{-1}}\n$$\n\nSo, since $A=PD{P}^{-1}$, we can compute ${A}^{k}$ by using the formula \n\n$$\n{A}^{k}=P{D}^{k}{P}^{-1}.\n$$\n\nFirst, we find the inverse of the matrix $P.$ We get\n\n$$\n{[\\begin{aligned}-2 & 0 \\\\ -1 & 1\\end{aligned}]}^{-1}=\\frac{1}{-2}[\\begin{aligned}1 & 0 \\\\ 1 & -2\\end{aligned}]=-\\frac{1}{2}[\\begin{aligned}1 & 0 \\\\ 1 & -2\\end{aligned}].\n$$\n\nCarrying out the necessary multiplication, we obtain the following:\n\n$$\n\\begin{aligned}{A}^{85} & =P{D}^{85}{P}^{-1} \\\\  & =[\\begin{aligned}-2 & 0 \\\\ -1 & 1\\end{aligned}]{[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}]}^{85}{[\\begin{aligned}-2 & 0 \\\\ -1 & 1\\end{aligned}]}^{-1} \\\\  & =[\\begin{aligned}-2 & 0 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}{1}^{85} & 0 \\\\ 0 & (-1)^{85}\\end{aligned}](-\\frac{1}{2}[\\begin{aligned}1 & 0 \\\\ 1 & -2\\end{aligned}]) \\\\  & =-\\frac{1}{2}[\\begin{aligned}-2 & 0 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 1 & -2\\end{aligned}] \\\\  & =-\\frac{1}{2}[\\begin{aligned}-2 & 0 \\\\ -1 & -1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 1 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 1 & -1\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14075976/state.json" "file_sha256" "3122387245bdfcd7fb4e4e83618e4e82d145e8bbb7f217612b58e5edbb3536ca"} {"question" "q-86686" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14075976/activity-metadata.json" "file_sha256" "1b472652f6dcfcea926ca811d937c5f6603cb344b5981fce3a4088b99cbbdf10"} {"question" "q-86686" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14075976/state.json" "file_sha256" "3122387245bdfcd7fb4e4e83618e4e82d145e8bbb7f217612b58e5edbb3536ca"} {"question" "q-86686" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-1 & 0 \\\\ -1 & 2\\end{aligned}]"] ["math" "[\\begin{aligned}-2 & 0 \\\\ -2 & 1\\end{aligned}]"] ["math" "[\\begin{aligned}-2 & 0 \\\\ 2 & 1\\end{aligned}]"] ["math" "[\\begin{aligned}-2 & 1 \\\\ 0 & -1\\end{aligned}]"] ["math" "[\\begin{aligned}1 & 0 \\\\ 1 & -1\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14075976/state.json" "file_sha256" "3122387245bdfcd7fb4e4e83618e4e82d145e8bbb7f217612b58e5edbb3536ca"} {"question" "q-86686" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}1 & 0 \\\\ 1 & -1\\end{aligned}]"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14075976/state.json" "file_sha256" "3122387245bdfcd7fb4e4e83618e4e82d145e8bbb7f217612b58e5edbb3536ca"} {"question" "q-86689" "field" nil "attribute" "question/problem" "value" "Find ${M}^{24},$ where\n\n$$\nM=[\\begin{aligned}3 & 5 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}\\sqrt[12]{2} & 0 \\\\ 0 & \\sqrt[8]{2}\\end{aligned}]{[\\begin{aligned}3 & 5 \\\\ 1 & 2\\end{aligned}]}^{-1}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14075976/state.json" "file_sha256" "3122387245bdfcd7fb4e4e83618e4e82d145e8bbb7f217612b58e5edbb3536ca"} {"question" "q-86689" "field" nil "attribute" "question/worked-solution" "value" "We have been given the following diagonalization of $M.$\n\n$$\nM={{[\\begin{aligned}3 & 5 \\\\ 1 & 2\\end{aligned}]}_{⏟}}_{P}{{[\\begin{aligned}\\sqrt[12]{2} & 0 \\\\ 0 & \\sqrt[8]{2}\\end{aligned}]}_{⏟}}_{D}{{{[\\begin{aligned}3 & 5 \\\\ 1 & 2\\end{aligned}]}^{-1}}_{⏟}}_{{P}^{-1}}\n$$\n\nSo, since $M=PD{P}^{-1}$, we can compute ${M}^{k}$ by using the formula \n\n$$\n{M}^{k}=P{D}^{k}{P}^{-1}.\n$$\n\nFirst, we find the inverse of the matrix $P.$ We get\n\n$$\n{[\\begin{aligned}3 & 5 \\\\ 1 & 2\\end{aligned}]}^{-1}=\\frac{1}{1}[\\begin{aligned}2 & -5 \\\\ -1 & 3\\end{aligned}]=[\\begin{aligned}2 & -5 \\\\ -1 & 3\\end{aligned}].\n$$\n\n \n\nCarrying out the necessary multiplication, we obtain the following:\n\n \n\n$$\n\\begin{aligned}{M}^{24} & =P{D}^{24}{P}^{-1} \\\\  & =[\\begin{aligned}3 & 5 \\\\ 1 & 2\\end{aligned}]{[\\begin{aligned}\\sqrt[12]{2} & 0 \\\\ 0 & \\sqrt[8]{2}\\end{aligned}]}^{24}[\\begin{aligned}2 & -5 \\\\ -1 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 5 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}(\\sqrt[12]{2})^{24} & 0 \\\\ 0 & (\\sqrt[8]{2})^{24}\\end{aligned}][\\begin{aligned}2 & -5 \\\\ -1 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 5 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}{2}^{2} & 0 \\\\ 0 & {2}^{3}\\end{aligned}][\\begin{aligned}2 & -5 \\\\ -1 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 5 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}4 & 0 \\\\ 0 & 8\\end{aligned}][\\begin{aligned}2 & -5 \\\\ -1 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}12 & 40 \\\\ 4 & 16\\end{aligned}][\\begin{aligned}2 & -5 \\\\ -1 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}-16 & 60 \\\\ -8 & 28\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14075976/state.json" "file_sha256" "3122387245bdfcd7fb4e4e83618e4e82d145e8bbb7f217612b58e5edbb3536ca"} {"question" "q-86689" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14075976/activity-metadata.json" "file_sha256" "1b472652f6dcfcea926ca811d937c5f6603cb344b5981fce3a4088b99cbbdf10"} {"question" "q-86689" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14075976/state.json" "file_sha256" "3122387245bdfcd7fb4e4e83618e4e82d145e8bbb7f217612b58e5edbb3536ca"} {"question" "q-86689" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-16 & 6 \\\\ -8 & 8\\end{aligned}]"] ["math" "[\\begin{aligned}-16 & 60 \\\\ -28 & 8\\end{aligned}]"] ["math" "[\\begin{aligned}-16 & 60 \\\\ -8 & 28\\end{aligned}]"] ["math" "[\\begin{aligned}-6 & 60 \\\\ -18 & 28\\end{aligned}]"] ["math" "[\\begin{aligned}-60 & 16 \\\\ -8 & 28\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14075976/state.json" "file_sha256" "3122387245bdfcd7fb4e4e83618e4e82d145e8bbb7f217612b58e5edbb3536ca"} {"question" "q-86689" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}-16 & 60 \\\\ -8 & 28\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14075976/state.json" "file_sha256" "3122387245bdfcd7fb4e4e83618e4e82d145e8bbb7f217612b58e5edbb3536ca"} {"question" "q-140133" "field" nil "attribute" "question/problem" "value" "Find the eigenvectors of the $2\\times 2$ matrix $C$ given that \n\n$$\n[\\begin{aligned}1 & -2 \\\\ -2 & 5\\end{aligned}]C=[\\begin{aligned}-4 & 0 \\\\ 0 & 6\\end{aligned}][\\begin{aligned}1 & -2 \\\\ -2 & 5\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14075976/state.json" "file_sha256" "3122387245bdfcd7fb4e4e83618e4e82d145e8bbb7f217612b58e5edbb3536ca"} {"question" "q-140133" "field" nil "attribute" "question/worked-solution" "value" "Notice that the matrix $[\\begin{aligned}1 & -2 \\\\ -2 & 5\\end{aligned}]$ appears on both sides of the equation. Since this matrix is invertible (its determinant is not zero), left-multiplying the equation by the inverse gives the following expression for $C:$ \n\n$$\nC={{{[\\begin{aligned}1 & -2 \\\\ -2 & 5\\end{aligned}]}^{-1}}_{⏟}}_{P}{{[\\begin{aligned}-4 & 0 \\\\ 0 & 6\\end{aligned}]}_{⏟}}_{D}{{[\\begin{aligned}1 & -2 \\\\ -2 & 5\\end{aligned}]}_{⏟}}_{{P}^{-1}}\n$$\n\nTherefore, $C$ is diagonalizable. The eigenvalues of $C$ are ${\\lambda }_{1}=-4$ and ${\\lambda }_{2}=6$ and the corresponding eigenvectors are the columns of the matrix $P.$ Computing $P,$ we obtain\n\n$$\n\\begin{aligned}P={[\\begin{aligned}1 & -2 \\\\ -2 & 5\\end{aligned}]}^{-1}=\\frac{1}{1}[\\begin{aligned}5 & 2 \\\\ 2 & 1\\end{aligned}]=[\\begin{aligned}5 & 2 \\\\ 2 & 1\\end{aligned}].\\end{aligned}\n$$\n\nIn conclusion, the corresponding eigenvectors are: \n\n$\\,$ ${v}_{1}=[\\begin{aligned}5 \\\\ 2\\end{aligned}]\\,$ and $\\,{v}_{2}=[\\begin{aligned}2 \\\\ 1\\end{aligned}]$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14075976/state.json" "file_sha256" "3122387245bdfcd7fb4e4e83618e4e82d145e8bbb7f217612b58e5edbb3536ca"} {"question" "q-140133" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14075976/activity-metadata.json" "file_sha256" "1b472652f6dcfcea926ca811d937c5f6603cb344b5981fce3a4088b99cbbdf10"} {"question" "q-140133" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14075976/state.json" "file_sha256" "3122387245bdfcd7fb4e4e83618e4e82d145e8bbb7f217612b58e5edbb3536ca"} {"question" "q-140133" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "$[\\begin{aligned}-4 \\\\ 2\\end{aligned}]$ and $[\\begin{aligned}6 \\\\ 5\\end{aligned}]$"] ["text" "$[\\begin{aligned}1 \\\\ -2\\end{aligned}]$ and $[\\begin{aligned}-2 \\\\ 5\\end{aligned}]$"] ["text" "$[\\begin{aligned}1 \\\\ 2\\end{aligned}]$ and $[\\begin{aligned}2 \\\\ 5\\end{aligned}]$"] ["text" "$[\\begin{aligned}4 \\\\ 0\\end{aligned}]$ and $[\\begin{aligned}0 \\\\ 6\\end{aligned}]$"] ["text" "$[\\begin{aligned}5 \\\\ 2\\end{aligned}]$ and $[\\begin{aligned}2 \\\\ 1\\end{aligned}]$"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14075976/state.json" "file_sha256" "3122387245bdfcd7fb4e4e83618e4e82d145e8bbb7f217612b58e5edbb3536ca"} {"question" "q-140133" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "$[\\begin{aligned}5 \\\\ 2\\end{aligned}]$ and $[\\begin{aligned}2 \\\\ 1\\end{aligned}]$"] "category" 