:question/validate]} {:db/id [:knowledge-point/id #uuid "8aef330a-81b3-56c4-9559-67df673e8687"] :knowledge-point/questions ["q-140047"] :db/ensure [:knowledge-point/validate]} {:db/id "q-43058/selection/f710292965833407c392cd64d43882cf3fc6c030eafd896396600d5acf92f9d9" :answer/id #uuid "68aecdf5-b4a7-5df9-b9ee-7716bc508f3b" :answer/type :answer.type/text :answer/value "$|C|$ only" :db/ensure [:answer/validate]} {:db/id "q-43058/selection/ffe2658b61fb7d0dab3ff632e5bb0010b15c994dbe221a53ea11b11f42a36f3b" :answer/id #uuid "fa9dfcf1-eea8-5858-adfc-f9339602f9ae" :answer/type :answer.type/text :answer/value "$|A|$ and $|B|$ only" :db/ensure [:answer/validate]} {:db/id "q-43058/selection/fa9e12c8b42568dd093650e15eee81422847cff71e4354f3171a249ad225e30d" :answer/id #uuid "8125dda9-ce0b-5b57-b56a-98e842c849a9" :answer/type :answer.type/text :answer/value "$|A|$ only" :db/ensure [:answer/validate]} {:db/id "q-43058/selection/9a706cca3397926462882659e466a6cfa02e6978e78d1951ccab85cbb33685e2" :answer/id #uuid "5ed38d93-c8dc-559a-ba67-30b614dc45e0" :answer/type :answer.type/text :answer/value "$|B|$ and $|C|$ only" :db/ensure [:answer/validate]} {:db/id "q-43058/selection/ab6b597263aa9f92843e257a063d9ad7381cacca91a0e0b2b283d45a9e811611" :answer/id #uuid "df723665-7ea2-59e0-b1d8-027118a04750" :answer/type :answer.type/text :answer/value "$|A|$ and $|C|$ only" :db/ensure [:answer/validate]} {:db/id "q-43058/selection" :answer-field/id #uuid "8c754a6f-eb1c-5b9c-8014-198c5051bf2a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-43058/selection/ab6b597263aa9f92843e257a063d9ad7381cacca91a0e0b2b283d45a9e811611" :answer-field/choices ["q-43058/selection/f710292965833407c392cd64d43882cf3fc6c030eafd896396600d5acf92f9d9" "q-43058/selection/ffe2658b61fb7d0dab3ff632e5bb0010b15c994dbe221a53ea11b11f42a36f3b" "q-43058/selection/fa9e12c8b42568dd093650e15eee81422847cff71e4354f3171a249ad225e30d" "q-43058/selection/9a706cca3397926462882659e466a6cfa02e6978e78d1951ccab85cbb33685e2" "q-43058/selection/ab6b597263aa9f92843e257a063d9ad7381cacca91a0e0b2b283d45a9e811611"] :db/ensure [:answer-field/validate]} {:db/id "q-43058" :question/id #uuid "56c75f73-8006-5c39-8150-6ad119a3d555" :question/math-academy-id "q-43058" :question/problem "Which of the following determinants are equal to $0?$\n\n$$\n|A|=|\\begin{aligned}\\sqrt{3} & 5 & -1 \\\\ 4 & -3 & 8 \\\\ 0 & 0 & 0\\end{aligned}|,\\,|B|=|\\begin{aligned}2 & 0 & 0 \\\\ 2 & -5 & 0 \\\\ 1 & -\\sqrt{3} & 4\\end{aligned}|,\\,|C|=|\\begin{aligned}-2 & 4 & -1 \\\\ 6 & \\sqrt{3} & 3 \\\\ -4 & \\sqrt{7} & -2\\end{aligned}|.\n$$" :question/worked-solution "Let's examine each of the given determinants in turn.\n\n- The matrix $A$ has a zero row: \n\n$$\nA=[\\begin{aligned}\\sqrt{3} & 5 & -1 \\\\ 4 & -3 & 8 \\\\ 0 & 0 & 0\\end{aligned}]\n$$\n\nAs a result, $|A|=0.$\n\n- The matrix $B$ is a triangular matrix, hence \n\n$$\n|B|=2\\cdot (-5)\\cdot 4=-40\\ne 0.\n$$\n\n- The matrix $C$ has proportional columns: \n\n$$\nC=[\\begin{aligned}-2 & 4 & -1 \\\\ 6 & \\sqrt{3} & 3 \\\\ -4 & \\sqrt{7} & -2\\end{aligned}]\n$$\n\nAs a result, $|C|=0.$\n\nTherefore, only $|A|$ and $|C|$ are equal to $0.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-43058/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8aef330a-81b3-56c4-9559-67df673e8687"] :knowledge-point/questions ["q-43058"] :db/ensure [:knowledge-point/validate]} {:db/id "q-42467/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "9dd816ac-33d2-5069-a1f9-0960ca12a3d3" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-42467/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "4ee2c952-978d-5b70-a4f6-603d965be149" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-42467/selection/283bc09f1a097ae8400558511ca45f1013e17c797fdb7407be52694190fd744b" :answer/id #uuid "b891d8e8-a530-544b-b247-5e90aa738fc2" :answer/type :answer.type/math :answer/value "-15" :db/ensure [:answer/validate]} {:db/id "q-42467/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "f2416e95-bcbc-5e55-bc32-a423525d319f" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-42467/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer/id #uuid "4ee6dc97-8d73-5771-8f8a-f3b3f5b84fec" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "q-42467/selection" :answer-field/id #uuid "8b612b23-49c1-5a81-b79c-40b3303d76ca" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-42467/selection/283bc09f1a097ae8400558511ca45f1013e17c797fdb7407be52694190fd744b" :answer-field/choices ["q-42467/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-42467/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" "q-42467/selection/283bc09f1a097ae8400558511ca45f1013e17c797fdb7407be52694190fd744b" "q-42467/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-42467/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96"] :db/ensure [:answer-field/validate]} {:db/id "q-42467" :question/id #uuid "897aeeb1-201c-52b5-9197-9d618dd66f55" :question/math-academy-id "q-42467" :question/problem "Find $3det(A)-4det(B)$, where \n\n$$\nA=[\\begin{aligned}7 & 3 \\\\ 4 & 1\\end{aligned}],\\,B=[\\begin{aligned}2 & 3\\sqrt{2} & 5 \\\\ 2 & 1 & 4 \\\\ 4 & 6\\sqrt{2} & 10\\end{aligned}].\n$$" :question/worked-solution "Let's examine each matrix in turn.\n\n- For the matrix $A,$ we have\n\n$$\ndet(A)=7\\cdot 1-3\\cdot 4=-5.\n$$\n\n- Since $B$ has proportional rows, we obtain\n\n$$\nB=[\\begin{aligned}2 & 3\\sqrt{2} & 5 \\\\ 2 & 1 & 4 \\\\ 4 & 6\\sqrt{2} & 10\\end{aligned}]\\,⟹\\,det(B)=0.\n$$\n\nTherefore, $3det(A)-4det(B)=3\\cdot (-5)-4\\cdot 0=-15.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-42467/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8aef330a-81b3-56c4-9559-67df673e8687"] :knowledge-point/questions ["q-42467"] :db/ensure [:knowledge-point/validate]} {:db/id "q-42460/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "8bafc66d-163d-5265-a549-91820f45f4b7" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-42460/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "830250a7-3bcd-5602-8bcb-ea7012dc6c5a" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-42460/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "188ce4df-3781-5bf8-ad3a-09b7c8bf4444" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-42460/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "8e14d12a-0925-52d6-adc9-63674b9f1c81" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-42460/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "1a902147-4cea-5a97-a996-d07c96c4ce1d" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-42460/selection" :answer-field/id #uuid "a55f4391-a596-51b4-bee4-606c5d3cf1b3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-42460/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer-field/choices ["q-42460/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-42460/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-42460/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-42460/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-42460/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981"] :db/ensure [:answer-field/validate]} {:db/id "q-42460" :question/id #uuid "ee8acf29-78be-5a6d-9c80-499fc4006ff1" :question/math-academy-id "q-42460" :question/problem "$$\nA=[\\begin{aligned}\\sqrt{5} & 1 & 5 & 2 \\\\ 2 & 2 & 2 & 4 \\\\ \\sqrt{5} & 1 & 5 & 2 \\\\ -1 & 4 & -1 & 8\\end{aligned}]\n$$\n\n \nConsider the matrix given above. Identify **all** of the reasons why one can conclude that $|A|=0?$\n\n- $A$ has a zero row\n- $A$ has two proportional columns\n- $A$ has two identical rows" :question/worked-solution "Let's examine each of the statements in turn.\n\n- $A$ does *not* have a zero row.\n\n- $A$ has two proportional columns:\n\n$$\nA=[\\begin{aligned}\\sqrt{5} & 1 & 5 & 2 \\\\ 2 & 2 & 2 & 4 \\\\ \\sqrt{5} & 1 & 5 & 2 \\\\ -1 & 4 & -1 & 8\\end{aligned}]\\,✓\n$$\n\n- $A$ has two identical rows: \n\n$$\nA=[\\begin{aligned}\\sqrt{5} & 1 & 5 & 2 \\\\ 2 & 2 & 2 & 4 \\\\ \\sqrt{5} & 1 & 5 & 2 \\\\ -1 & 4 & -1 & 8\\end{aligned}]\\,✓\n$$\n\nTherefore, the correct answer is \"II and III only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-42460/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "abaeea03-6a2a-5d37-a2af-a9ea109175ad"] :knowledge-point/questions ["q-42460"] :db/ensure [:knowledge-point/validate]} {:db/id "q-140050/selection/03b99debc8e9534f2364927a2cf1eba83bddd906503dea5d13395ce906a45ab9" :answer/id #uuid "2a6f6e38-02ff-5c35-99e9-10ca7952deb3" :answer/type :answer.type/text :answer/value "None of the statements are true" :db/ensure [:answer/validate]} {:db/id "q-140050/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "9188e2e9-f036-54a2-a37a-442f2c3fa6e0" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-140050/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "1ba93eee-ec44-51a7-905e-580af07dc8dc" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-140050/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "0a40f298-309b-5c16-8c06-9283de5d2733" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-140050/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "1b27140f-dfbe-531c-af7d-b66eeb3e8c1f" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-140050/selection" :answer-field/id #uuid "efe043a2-2621-5064-bbf7-b5e6f8a18ad6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-140050/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer-field/choices ["q-140050/selection/03b99debc8e9534f2364927a2cf1eba83bddd906503dea5d13395ce906a45ab9" "q-140050/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-140050/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-140050/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-140050/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6"] :db/ensure [:answer-field/validate]} {:db/id "q-140050" :question/id #uuid "036c5e8d-bd6c-583c-b82d-de6f4ceb79aa" :question/math-academy-id "q-140050" :question/problem "$$\nA=[\\begin{aligned}1 & -2 & 3 \\\\ 2 & -4 & 5 \\\\ -1 & 2 & 7\\end{aligned}]\n$$\n\nConsider the matrix given above. Identify **all** of the reasons why one can conclude that $|A|=0?$\n\n- $A$ has proportional columns\n- $A$ has identical columns\n- $A$ has identical rows" :question/worked-solution "Let's examine each of the statements in turn.\n\n- $A$ has proportional columns: \n\n$$\nA=[\\begin{aligned}1 & -2 & 3 \\\\ 2 & -4 & 5 \\\\ -1 & 2 & 7\\end{aligned}]\\,✓\n$$\n\n- $A$ does *not* have identical columns.\n\n- $A$ does *not* have identical rows.\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-140050/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "abaeea03-6a2a-5d37-a2af-a9ea109175ad"] :knowledge-point/questions ["q-140050"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-43306"] :question/problem "Let $A$ be a $2\\times 2$ matrix such that $|A|=0.$ Which of the following statements must be true?\n\n- $A$ has two identical rows\n- One of the rows/columns of $A$ is proportional to another row/column of $A$\n- $A$ has two identical columns" :question/worked-solution "Let's consider our statements in turn.\n\n- Statements I and III are false. For example, consider the matrix \n\n$$\nA=[\\begin{aligned}1 & 4 \\\\ 2 & 8\\end{aligned}].\n$$\n\nWe have that \n\n$$\n|A|=1\\cdot 8-4\\cdot 2=0\n$$\n\nbut $A$ has neither two identical rows nor two identical columns.\n\n- Statement II is true. Indeed, we can make use of the following fact:\n\n$|A|=0$ *if and only if one of the rows/columns of $A$ is a linear combination of other rows/columns of $A.$*\n\nIn the case of a $2\\times 2$ matrix, this means that one of the rows/columns must be proportional to another row/column.\n\nTherefore, the correct answer is \"II only\"." :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-82290/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "c61092d4-96c7-5cb1-9e17-128c4a8ecd51" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-82290/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "48e42694-037c-5360-a9c8-f92825c314fd" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-82290/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "a23ca2dd-156f-5e7a-9a0f-fa4b24abe37d" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-82290/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "4126f471-03bf-5979-92be-6bbc1eea3888" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-82290/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "01ed4f45-2049-585e-9daf-fc49b1ae6a89" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-82290/selection" :answer-field/id #uuid "98302e94-fd83-5f8d-a92c-a2a9c9834d4d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-82290/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer-field/choices ["q-82290/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-82290/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-82290/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-82290/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-82290/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6"] :db/ensure [:answer-field/validate]} {:db/id "q-82290" :question/id #uuid "3127bd8b-ed40-56ad-8355-fdaea133207c" :question/math-academy-id "q-82290" :question/problem "Let $A$ be a $2\\times 2$ matrix such that $|A|=0.$ Which of the following statements must be true?\n\n- One of the rows/columns of $A$ is proportional to another row/column of $A$\n- $A$ has two identical rows\n- $A$ has a zero row" :question/worked-solution "Let's consider our statements in turn.\n\n- Statement I is true. Indeed, we can make use of the following fact:\n\n$|A|=0$ *if and only if one of the rows/columns of $A$ is a linear combination of other rows/columns of $A.$*\n\nIn the case of a $2\\times 2$ matrix, this means that one of the rows/columns must be proportional to another row/column.\n\n- Statements II and III are false. For example, consider the matrix \n\n$$\nA=[\\begin{aligned}4 & 2 \\\\ 6 & 3\\end{aligned}].\n$$\n\nWe have that \n\n$$\n|A|=4\\cdot 3-6\\cdot 2=0\n$$\n\nbut $A$ has neither two identical rows nor a zero row.\n\nTherefore, the correct answer is \"I only\"." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-82290/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "abaeea03-6a2a-5d37-a2af-a9ea109175ad"] :knowledge-point/questions ["q-82290"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-42458"] :question/problem "$$\nA=[\\begin{aligned}2 & 0 & 4 \\\\ 1 & 0 & 3 \\\\ 2 & 0 & 4\\end{aligned}]\n$$\n\nConsider the matrix given above. Identify **all** of the reasons why one can conclude that $|A|=0?$\n\n- $A$ has a zero column\n- $A$ has identical columns\n- $A$ has identical rows" :question/worked-solution "Let's examine each of the statements in turn.\n\n- $A$ has a zero column: \n\n$$\nA=[\\begin{aligned}2 & 0 & 4 \\\\ 1 & 0 & 3 \\\\ 2 & 0 & 4\\end{aligned}]\\,✓\n$$\n\n- $A$ does *not* have identical columns.\n\n- $A$ has identical rows: \n\n$$\nA=[\\begin{aligned}2 & 0 & 4 \\\\ 1 & 0 & 3 \\\\ 2 & 0 & 4\\end{aligned}].\\,✓\n$$\n\nTherefore, the correct answer is \"I and III only.\"" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-10994"] :question/problem "Find $5\\det(A)-\\det(B),$ where \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14047809/assets/65df227e4fff9e934cec11be0a0262a1093a82270f3c9b0b7970fa2c700151aa.png)" :question/worked-solution "Let's examine each matrix in turn.\n\n- Since $A$ has two identical columns, we obtain\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14047809/assets/23865048a3c2ad60dd3b51fe78c44ee368692172300814c3fb061f447266e233.png)\n\n- Since $B$ is a diagonal matrix, its determinant is given by the product of the elements of the main diagonal: \n\n$$\n\\det(B) = 3 \\cdot (-4) \\cdot (-2) = 24\n$$\n\nTherefore, $5\\det(A)-\\det(B) = 5 \\cdot 0 - 24 = -24.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-10995"] :question/problem "Which of the following determinants are equal to $0?$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14047809/assets/d95e60cbfa50178878e719166ace3dbff90c3cc5531acfc046d8354320cd4b00.png)" :question/worked-solution "Let's examine each of the given determinants in turn.\n\n- The matrix $A$ has proportional rows: \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14047809/assets/3f434912c97c20d04f703253fe41c169497cae82657cfbd0d8b548985549fe64.png)\nAs a result, $|A| = 0.$\n\n- The matrix $B$ is a triangular matrix, so \n\n$$\n|B| = (-1) \\cdot 4 \\cdot (-3) = 12 \\neq 0.\n$$\n\n- The matrix $C$ has a zero row: \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14047809/assets/5f41ff4f7fe5aeae5865bef9ab16d5d97a3513277f70b797c4167882093ed079.png)\nAs a result, $|C| = 0.$\n\nTherefore, only $|A|$ and $|C|$ are equal to $0.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-10996"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14047809/assets/ccc50eec6218625f22e8372d6f0b1dbf0da0aa921dff237e4e1b8ea3761bdfc7.png)\n\nConsider the matrix given above. Identify **all** of the reasons why one can conclude that $|A|=0.$\n\n- $A$ has a zero column\n\n- $A$ has proportional rows\n\n- $A$ has identical columns" :question/worked-solution "Let's examine each of the statements in turn.\n\n- $A$ has a zero column: \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14047809/assets/2a155f75e1e9c099540eeac555cb20fde5037837d9e5fc9f976bbca15369b51e.png)\n\n- $A$ has proportional rows: \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14047809/assets/1447045fa5b7875defffdf52d2ae8cf876ee0c5da6ac07cc37bc1c5525fec9c6.png)\n\n- $A$ does *not* have identical columns.\n\nTherefore, the correct answer is \"I and II only.\"" :db/ensure [:question/validate]}]
