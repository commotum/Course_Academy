#{[{:db/id #edb/ref 17592186115067 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "a69f2883-64f8-51a6-9771-d5a885809ef6" :knowledge-point/title "Identifying Dimensions of Blocks in Partitioned Matrices"}] :question/id #uuid "e4bfb0c6-dff9-501b-9507-6b5c2299fb55" :question/math-academy-id "e-9093" :question/problem "A partitioned matrix $M$ contains the following blocks:\n\n- $M_{11}$, which is a $1 \\times 2$ block\n- $M_{12}$, which is a $1 \\times 3$ block\n- $M_{21}$, which is a $2 \\times 2$ block\n\nFind the dimensions of the block $M_{22}$." :question/worked-solution "We have a matrix of the form\n$\\begin{bmatrix}M_{11} & M_{12} \\\\ M_{21} & M_{22}\\end{bmatrix}$\n\nTherefore, $M_{22}$ must be a $2 \\times 3$ block."}] [{:db/id #edb/ref 17592186115068 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "bf19e2ee-7c42-58b0-9254-5a44f315288a" :knowledge-point/title "Identifying Block Diagonal and Block Triangular Matrices"}] :question/id #uuid "6fe1d3e1-27a7-5e9d-9776-d66c19dae753" :question/math-academy-id "e-9094" :question/problem "Which of the following matrices are block diagonal?\n\n$\\begin{bmatrix}9 & 7 & 0 \\\\ 10 & 5 & 0 \\\\ 0 & 0 & 12\\end{bmatrix}$" :question/worked-solution "A block diagonal matrix can be partitioned so that it has only square blocks on the main diagonal, and all the other blocks contain only zeros.\n\nWith that in mind, let's examine our matrices.\n\n- $A$ is a block diagonal matrix. Indeed, we can partition it as follows:\n$\\begin{bmatrix}9 & 7 & 0 \\\\ 10 & 5 & 0 \\\\ 0 & 0 & 12\\end{bmatrix}$\n- $B$ is *not* a block diagonal matrix since it can't be partitioned in the way described above:\n$\\begin{bmatrix}-2 & 5 \\\\ 0 & 1\\end{bmatrix}$\n- $C$ is *not* a block diagonal matrix since it can't be partitioned in the way described above:\n$C = \\begin{bmatrix}5 & 0 & 8 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}, C = \\begin{bmatrix}5 & 0 & 8 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}, C = \\begin{bmatrix}5 & 0 & 8 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}$\n\nTherefore, the correct answer is \"$A$ only.\""}] [{:db/id #edb/ref 17592186115069 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "4b507561-8134-50ff-8c23-c4ecc546450d" :knowledge-point/title "Finding the Determinant of a Block Diagonal or Block Triangular Matrix"}] :question/id #uuid "e0360a5e-97c7-5a9b-9d13-ba05360e4d78" :question/math-academy-id "e-9096" :question/problem "Find\n$\\begin{bmatrix}7 & 0 & -5 \\\\ 0 & e & 4 \\\\ 0 & h & 8\\end{bmatrix}$\ngiven that\n$\\begin{bmatrix}e & 4 \\\\ h & 8\\end{bmatrix}$" :question/worked-solution "Notice that we have a block upper triangular matrix. Therefore, its determinant is equal to the product of the determinants of the diagonal blocks:\n\n$$\n\\begin{aligned}\n\\begin{vmatrix}7 & 0 & -5 \\\\ 0 & e & 4 \\\\ 0 & h & 8\\end{vmatrix} &= \\begin{vmatrix}7 & 0 & -5 \\\\ 0 & e & 4 \\\\ 0 & h & 8\\end{vmatrix} \\\\\n&= 7 \\cdot\\begin{vmatrix}e & 4 \\\\ h & 8\\end{vmatrix} \\\\\n&= 7 \\cdot 6 \\\\\n&= 42\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115666 :knowledge-point/_questions [{:knowledge-point/id #uuid "a69f2883-64f8-51a6-9771-d5a885809ef6" :knowledge-point/title "Identifying Dimensions of Blocks in Partitioned Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "968330f0-b843-5ce8-bcd8-292f698a0802" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\cdot 2" :db/id #edb/ref 17592186113397} {:answer/id #uuid "ead7537d-7c4d-588d-88bd-6805eb2b9e0f" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\cdot 3" :db/id #edb/ref 17592186113398} {:answer/id #uuid "0f058a3b-e0a6-599e-8c74-17f3e74bc792" :answer/type {:db/ident :answer.type/math} :answer/value "3 \\cdot 2" :db/id #edb/ref 17592186113399} {:answer/id #uuid "39f79719-72a3-5bdc-b2ac-8702985d3be5" :answer/type {:db/ident :answer.type/math} :answer/value "1 \\cdot 2" :db/id #edb/ref 17592186113400} {:answer/id #uuid "46c8de5d-bc5e-5595-a5c4-d45a9bda7e84" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\cdot 1" :db/id #edb/ref 17592186113401}] :answer-field/correct {:answer/id #uuid "968330f0-b843-5ce8-bcd8-292f698a0802" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\cdot 2" :db/id #edb/ref 17592186113397} :answer-field/id #uuid "427a7799-6387-5f3e-8de6-b86de04c2685" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113396}] :question/id #uuid "adbfea45-b5a1-50e3-b354-7bc863f46572" :question/math-academy-id "q-32130" :question/problem "A partitioned matrix $M$ contains the following blocks:\n\n- $M_{11}$, which is a $3 \\cdot 2$ block\n- $M_{12}$, which is a $3 \\cdot 1$ block\n- $M_{22}$, which is a $2 \\cdot 1$ block\n\nWhat are the dimensions of the block $M_{21}$?"}] [{:db/id #edb/ref 17592186115745 :knowledge-point/_questions [{:knowledge-point/id #uuid "bf19e2ee-7c42-58b0-9254-5a44f315288a" :knowledge-point/title "Identifying Block Diagonal and Block Triangular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd27e216-162c-578f-87ff-3cce7e67e664" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186113842} {:answer/id #uuid "cc9790f8-b8f7-579c-8884-a0125867243d" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186113843} {:answer/id #uuid "d06c4efd-23ef-598e-94ae-476684f44f1b" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186113844} {:answer/id #uuid "156463c3-0c71-5456-b9f3-abf4ea70753e" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186113845} {:answer/id #uuid "36ab72f9-cab4-53ba-bb85-2b86f38f98e8" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186113846}] :answer-field/correct {:answer/id #uuid "bd27e216-162c-578f-87ff-3cce7e67e664" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186113842} :answer-field/id #uuid "fa414c2c-aacd-5ebe-834d-8246aa02d217" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113841}] :question/id #uuid "12fdac9a-07ca-546f-8c67-8327e7b0318b" :question/math-academy-id "q-42134" :question/problem "Which of the following matrices are block diagonal?\n\n$A = \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 1 & 0 & 2\\end{bmatrix}, B = \\begin{bmatrix}1 & 2 \\\\ 0 & 3\\end{bmatrix}, C = \\begin{bmatrix}4 & 0 & 0 \\\\ 2 & 3 & 0 \\\\ 0 & 0 & 5\\end{bmatrix}$."}]}
