 & 0 & 3 & -1 \\\\ 0 & 0 & -8 & 5\\end{aligned}| & =|\\begin{aligned}v & 5{w}^{2} & 0 & 0 \\\\ 3v & 2 & 0 & 0 \\\\ 0 & 0 & 3 & -1 \\\\ 0 & 0 & -8 & 5\\end{aligned}| \\\\  & =|\\begin{aligned}v & 5{w}^{2} \\\\ 3v & 2\\end{aligned}|\\cdot |\\begin{aligned}3 & -1 \\\\ -8 & 5\\end{aligned}| \\\\  & =\\frac{1}{7}\\cdot 7 \\\\  & =1.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041065/state.json" "file_sha256" "1a1b86265beb6c8430c7d4f28fef542e7feadfce5e025ad03fe9f1e9cb69e8aa"} {"question" "q-131675" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041065/activity-metadata.json" "file_sha256" "73338c461ad8c65ac6623d7dce9979873dd5ee77ce505d942f8270d9eb203288"} {"question" "q-131675" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041065/state.json" "file_sha256" "1a1b86265beb6c8430c7d4f28fef542e7feadfce5e025ad03fe9f1e9cb69e8aa"} {"question" "q-131675" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-10"] ["math" "1"] ["math" "49"] ["math" "\\frac{24}{7}"] ["math" "\\frac{2}{7}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041065/state.json" "file_sha256" "1a1b86265beb6c8430c7d4f28fef542e7feadfce5e025ad03fe9f1e9cb69e8aa"} {"question" "q-131675" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "1"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041065/state.json" "file_sha256" "1a1b86265beb6c8430c7d4f28fef542e7feadfce5e025ad03fe9f1e9cb69e8aa"} {"question" "q-109266" "field" nil "attribute" "question/problem" "value" "Find $\\,|\\begin{aligned}6 & 0 & 2 & 3 \\\\ 0 & x & -1 & 4 \\\\ 0 & 5 & y & 0 \\\\ 0 & 0 & 0 & 5\\end{aligned}|$ given that $\\,|\\begin{aligned}x & -1 \\\\ 5 & y\\end{aligned}|=-3.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041065/state.json" "file_sha256" "1a1b86265beb6c8430c7d4f28fef542e7feadfce5e025ad03fe9f1e9cb69e8aa"} {"question" "q-109266" "field" nil "attribute" "question/worked-solution" "value" "Notice that we have a block upper triangular matrix. Therefore, its determinant is equal to the product of the diagonal blocks' determinants:\n\n$$\n\\begin{aligned}|\\begin{aligned}6 & 0 & 2 & 3 \\\\ 0 & x & -1 & 4 \\\\ 0 & 5 & y & 0 \\\\ 0 & 0 & 0 & 5\\end{aligned}| & =|\\begin{aligned}6 & 0 & 2 & 3 \\\\ 0 & x & -1 & 4 \\\\ 0 & 5 & y & 0 \\\\ 0 & 0 & 0 & 5\\end{aligned}| \\\\  & =6\\cdot |\\begin{aligned}x & -1 \\\\ 5 & y\\end{aligned}|\\cdot 5 \\\\  & =6\\cdot (-3)\\cdot 5 \\\\  & =-90.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041065/state.json" "file_sha256" "1a1b86265beb6c8430c7d4f28fef542e7feadfce5e025ad03fe9f1e9cb69e8aa"} {"question" "q-109266" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041065/activity-metadata.json" "file_sha256" "73338c461ad8c65ac6623d7dce9979873dd5ee77ce505d942f8270d9eb203288"} {"question" "q-109266" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041065/state.json" "file_sha256" "1a1b86265beb6c8430c7d4f28fef542e7feadfce5e025ad03fe9f1e9cb69e8aa"} {"question" "q-10