      "attribute": "question/problem",
      "old_sha256": "6e9c82306d6f49fa186b473a913a99328df83bfedce7e691ba9ce4d48f6c045a",
      "new_sha256": "64b58eb5557f5eaeb48dda9e3a62c654ddb7301243fc62e3cee88a41184469fa",
      "category": "ma_capture",
      "authoring": [],
      "source": [
        {
          "question": "e-9094",
          "field": null,
          "attribute": "question/problem",
          "value": "Which of the following matrices are block diagonal?\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041065/assets/a610512000d95e3ed80559431e25501a9d498d342e7c180864720bbeb2ee10d4.png)",
