    {
      "question": "e-9096",
      "field": null,
      "attribute": "question/worked-solution",
      "old_sha256": "85b87448cc734feb26de213aaab591419b02c74163202dfc472aa50a7af9f73e",
      "new_sha256": "eb8a90b4944cf45087846b1917329bcedbdb7fb36d7d954ba95959b4674f3033",
      "category": "ma_capture",
      "authoring": [],
      "source": [
        {
          "question": "e-9096",
          "field": null,
          "attribute": "question/worked-solution",
          "value": "Notice that we have  a block upper triangular matrix. Therefore, its determinant is equal to the product of the determinants of the diagonal blocks:\n\n$$\n\\begin{aligned}|\\begin{aligned}7 & 0 & -5 \\\\ 0 & e & 4 \\\\ 0 & h & 8\\end{aligned}| & =|\\begin{aligned}7 & 0 & -5 \\\\ 0 & e & 4 \\\\ 0 & h & 8\\end{aligned}| \\\\  & =7\\cdot |\\begin{aligned}e & 4 \\\\ h & 8\\end{aligned}| \\\\  & =7\\cdot 6 \\\\  & =42\\end{aligned}\n$$",
          "category": "ma_capture",
          "file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041065/example-9096.json",
          "file_sha256": "25959306f66a705214251c40e37264e87add4e4ad5c5dcdb09daca02280d188b"
        }
      ],
