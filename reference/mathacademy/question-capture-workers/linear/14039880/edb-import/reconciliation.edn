 6 \\\\ 0 & 0 & 1 & 3\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039880/state.json" "file_sha256" "5a42625f966b46ce68b9d3ef91530c2180d258fc6528e6c5df0f2380867f7778"} {"question" "q-42008" "field" nil "attribute" "question/worked-solution" "value" "Notice that by replacing ${a}_{21}$ and ${a}_{43}$ with $0$, we get a matrix in row echelon form:\n\n$$\nA=[\\begin{aligned}1 & 1 & 4 & 7 \\\\ 2 & 4 & 2 & 1 \\\\ 0 & 0 & 5 & 6 \\\\ 0 & 0 & 1 & 3\\end{aligned}]\\,⟶\\,[\\begin{aligned}1 & 1 & 4 & 7 \\\\ 0 & 4 & 2 & 1 \\\\ 0 & 0 & 5 & 6 \\\\ 0 & 0 & 0 & 3\\end{aligned}].\n$$\n\nThe other options will not give us a matrix in row echelon form." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039880/state.json" "file_sha256" "5a42625f966b46ce68b9d3ef91530c2180d258fc6528e6c5df0f2380867f7778"} {"question" "q-42008" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039880/activity-metadata.json" "file_sha256" "5359324fa248b36458bcfecab86ea4df13f93164aa03f4664aac764d91e33922"} {"question" "q-42008" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039880/state.json" "file_sha256" "5a42625f966b46ce68b9d3ef91530c2180d258fc6528e6c5df0f2380867f7778"} {"question" "q-42008" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "${a}_{21}$ and ${a}_{43}$ only"] ["text" "${a}_{21}$ only"] ["text" "${a}_{21}$,  ${a}_{33}$, and ${a}_{44}$ only"] ["text" "${a}_{22}$ and ${a}_{33}$ only"] ["text" "${a}_{43}$ only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/r