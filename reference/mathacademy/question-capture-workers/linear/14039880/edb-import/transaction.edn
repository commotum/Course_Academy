:answer/validate]} {:db/id "q-129423/selection/79cafe5fe6448d603a24768f5cec2572e33b99a8fc13fcd481ec55f84231770e" :answer/id #uuid "471c5e6e-d253-59a7-b2f7-337a94ee5052" :answer/type :answer.type/text :answer/value "${a}_{22}$ and ${a}_{33}$ only" :db/ensure [:answer/validate]} {:db/id "q-129423/selection/6fb9789dc177c0111c9fef14729191a46a6cee03448b92d421329f33ba825fa8" :answer/id #uuid "28f8fc8d-5b03-5a78-b6fb-d6201e6a8be0" :answer/type :answer.type/text :answer/value "${a}_{22}$, ${a}_{23}$ and ${a}_{33}$ only" :db/ensure [:answer/validate]} {:db/id "q-129423/selection/1cfbe7e32cbff9ea77e6b06681f0c0116b210cf020d9127839b3794ed7ac557c" :answer/id #uuid "599d420f-68dc-548f-8100-ee350545b9c2" :answer/type :answer.type/text :answer/value "${a}_{12}$ and ${a}_{14}$ only" :db/ensure [:answer/validate]} {:db/id "q-129423/selection/aa4183b730644e82ebbb615af9cfb3539bc0a0057ec85e2549c3f2678157c44b" :answer/id #uuid "2e84fb75-1e79-5759-b113-883e5275cc6f" :answer/type :answer.type/text :answer/value "${a}_{33}$ and ${a}_{44}$ only" :db/ensure [:answer/validate]} {:db/id "q-129423/selection" :answer-field/id #uuid "9d744ac4-6acc-5396-9500-e1067d26db08" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129423/selection/a00e1d2ddd2d84ea5f6c3431c717e8dc2971e9e5f52e7fd4f01061ceb29fe7e9" :answer-field/choices ["q-129423/selection/a00e1d2ddd2d84ea5f6c3431c717e8dc2971e9e5f52e7fd4f01061ceb29fe7e9" "q-129423/selection/79cafe5fe6448d603a24768f5cec2572e33b99a8fc13fcd481ec55f84231770e" "q-129423/selection/6fb9789dc177c0111c9fef14729191a46a6cee03448b92d421329f33ba825fa8" "q-129423/selection/1cfbe7e32cbff9ea77e6b06681f0c0116b210cf020d9127839b3794ed7ac557c" "q-129423/selection/aa4183b730644e82ebbb615af9cfb3539bc0a0057ec85e2549c3f2678157c44b"] :db/ensure [:answer-field/validate]} {:db/id "q-129423" :question/id #uuid "18c5c4bf-9773-53a5-af29-8e4d5e1f1556" :question/math-academy-id "q-129423" :question/problem "Consider the matrix $A$ given below.\nWhich entries of $A$ could be replaced by $0$ in order to get a matrix in row echelon form?\n\n$$\nA=[\\begin{aligned}0 & 4 & 0 & 9 \\\\ 0 & 3 & 8 & -1 \\\\ 0 & 0 & -7 & 0 \\\\ 0 & 0 & 0 & 9\\end{aligned}]\n$$" :question/worked-solution "Notice that by replacing ${a}_{22}$, ${a}_{33}$ and ${a}_{44}$ with $0$, we get a matrix in row echelon form:\n\n$$\nA=[\\begin{aligned}0 & 4 & 0 & 9 \\\\ 0 & 3 & 8 & -1 \\\\ 0 & 0 & -7 & 0 \\\\ 0 & 0 & 0 & 9\\end{aligned}]\\,⟶\\,[\\begin{aligned}0 & 4 & 0 & 9 \\\\ 0 & 0 & 8 & -1 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}].\n$$\n\nThe other options will not give us a matrix in row echelon form." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-129423/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fe0050b2-b5bc-54a6-aeaf-94cd5d7e5dfb"] :knowledge-point/questions ["q-129423"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-6166"] :question/problem "What is the sum of the leading entries of the $1$st, $3$rd and $4$th rows in the matrix $A,$ given below?\n\n$$\n[\\begin{aligned}-1 & 1 & 0 & 1 \\\\ 0 & 0 & 7 & 8 \\\\ 0 & -4 & 2 & 4 \\\\ 0 & 0 & 8 & 4\\end{aligned}]\n$$" :question/worked-solution "The first non-zero entry of each row (from left to right) is the leading entry. \n\nTherefore, the leading entries of the $1$st, $3$rd and $4$th rows of $A$ are $-1$, $-4$ and $8$, respectively.\n\n$$\n[\\begin{aligned}-1 & 1 & 0 & 1 \\\\ 0 & 0 & 7 & 8 \\\\ 0 & -4 & 2 & 4 \\\\ 0 & 0 & 8 & 4\\end{aligned}]\n$$\n\nSo, the answer is $-1+(-4)+8=3.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4688"] :question/problem "Which of the following matrices are in row echelon form?\n\n$$\n\\begin{aligned}2 & 1 \\\\ 0 & 0 \\\\ 0 & 3\\end{aligned}\n$$" :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since the second row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\n\\begin{aligned}2 & 1 \\\\ 0 & 0 \\\\ 0 & 3\\end{aligned}\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\n\\begin{aligned}0 & 2 & 7 & 10 \\\\ 0 & 0 & 0 & 0\\end{aligned}\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\n\\begin{aligned}2 & 0 & 0 & 0 & 4 & 6 \\\\ 0 & 0 & 3 & 3 & 6 & 0 \\\\ 0 & 0 & 0 & 0 & 4 & 8\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4687"] :question/problem "Which of the following augmented matrices are in row echelon form?\n\n$$\n\\begin{aligned}1 & 2 & -1 & 0 \\\\ 0 & 1 & 0 & 1 \\\\ 0 & 1 & 1 & 1\\end{aligned}\n$$" :question/worked-solution "Remember that an augmented matrix is in row echelon form if its coefficient matrix satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The first matrix is not in row echelon form since $a_{32} \\neq 0$ (condition II is violated).\n\n$$\n\\begin{aligned}1 & 2 & -1 & 0 \\\\ 0 & 1 & 0 & 1 \\\\ 0 & 1 & 1 & 1\\end{aligned}\n$$\n\n- The second matrix is in row echelon form (both conditions are satisfied).\n\n$$\n\\begin{aligned}1 & 2 & -1 & 5 \\\\ 0 & 2 & 0 & -2 \\\\ 0 & 0 & 1 & 7\\end{aligned}\n$$\n\n- The third matrix is in row echelon form (both conditions are satisfied).\n\n$$\n\\begin{aligned}1 & 0 & -1 & 4 \\\\ 0 & 1 & 0 & 1 \\\\ 0 & 0 & 0 & 0\\end{aligned}\n$$\n\n- The fourth matrix is not in row echelon form since, for example, the leading entry $a_{22}$ lies to the left of the leading entry $a_{13}$ (condition II is violated).\n\n$$\n\\begin{aligned}0 & 0 & 1 & 1 \\\\ 0 & 1 & 0 & 1 \\\\ 1 & 1 & 1 & 1\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4689"] :question/problem "Consider the matrix $A$ given below.\nWhich entries of $A$ could be replaced by $0$ in order to get a matrix in row echelon form?\n\n$$\n[\\begin{aligned}3 & 11 & 10 & 9 \\\\ 0 & 4 & 7 & 8 \\\\ 0 & -1 & 6 & 5 \\\\ 0 & 1 & 2 & 4\\end{aligned}]\n$$" :question/worked-solution "Notice that by replacing $a_{32}$, $a_{42}$, and $a_{43}$ with $0$, we get a matrix in row echelon form:\n\n$$\n[\\begin{aligned}3 & 11 & 10 & 9 \\\\ 0 & 4 & 7 & 8 \\\\ 0 & -1 & 6 & 5 \\\\ 0 & 1 & 2 & 4\\end{aligned}]\n$$" :db/ensure [:question/validate]}]
