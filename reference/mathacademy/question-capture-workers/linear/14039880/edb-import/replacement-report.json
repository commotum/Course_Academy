      "attribute": "question/problem",
      "old_sha256": "b68e646085ecd007affec667addd4928cd016e64e6bbb9e624d7c80114b6975b",
      "new_sha256": "f0cb5c247bcb7bcf821d00af8b3e851ce0b2d428ccb669c59bfa0c7819497b67",
      "category": "ma_capture",
      "authoring": [],
      "source": [
        {
          "question": "e-6166",
          "field": null,
          "attribute": "question/problem",
          "value": "What is the sum of the leading entries of the $1$st, $3$rd and $4$th rows in the matrix $A,$ given below?\n\n$$\n[\\begin{aligned}-1 & 1 & 0 & 1 \\\\ 0 & 0 & 7 & 8 \\\\ 0 & -4 & 2 & 4 \\\\ 0 & 0 & 8 & 4\\end{aligned}]\n$$",
          "category": "ma_capture",
          "file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039880/example-6166.json",
          "file_sha256": "ecc46975b9672648074bca266624acd2504115680e994b7e87e5e2a1e5e7835b"
        }
      ],
      "basis": 1391,
      "reason": "Observed MA content supersedes the stored value",
      "action": "replace",
      "transaction_receipt": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039880/edb-import/commit.edn",
      "basis_after": 1392
