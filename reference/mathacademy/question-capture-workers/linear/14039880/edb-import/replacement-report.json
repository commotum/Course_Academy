    {
      "question": "e-6166",
      "field": null,
      "attribute": "question/worked-solution",
      "old_sha256": "3804549d96b9dde9a4f9a133dc35c6f0d3e560c723c334f5d4406a5b30c95ac7",
      "new_sha256": "3568f46de203bc0b59a0ec2e0985e4580edf1ef2f7a6ef38c78bdf9ce74fdafd",
      "category": "ma_capture",
      "authoring": [],
      "source": [
        {
          "question": "e-6166",
          "field": null,
          "attribute": "question/worked-solution",
          "value": "The first non-zero entry of each row (from left to right) is the leading entry. \n\nTherefore, the leading entries of the $1$st, $3$rd and $4$th rows of $A$ are $-1$, $-4$ and $8$, respectively.\n\n$$\n[\\begin{aligned}-1 & 1 & 0 & 1 \\\\ 0 & 0 & 7 & 8 \\\\ 0 & -4 & 2 & 4 \\\\ 0 & 0 & 8 & 4\\end{aligned}]\n$$\n\nSo, the answer is $-1+(-4)+8=3.$",
          "category": "ma_capture",
          "file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039880/example-6166.json",
          "file_sha256": "ecc46975b9672648074bca266624acd2504115680e994b7e87e5e2a1e5e7835b"
        }
      ],
