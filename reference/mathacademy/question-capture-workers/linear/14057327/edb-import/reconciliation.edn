s/differential/14040608/state.json" "file_sha256" "b5dc5188d8fdf6aafffa23f9aa3023e6b5623ad9e1db3086f8368ea1909ef020" "basis" 1451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/edb-import/verification.json"} {"question" "q-43908" "field" nil "attribute" "question/worked-solution" "value" "The norm of a vector $v$ with respect to an inner product $⟨\\cdot ,\\cdot ⟩$ is defined as\n\n$$\n\\begin{aligned}‖v‖=\\sqrt{⟨v,v⟩}.\\end{aligned}\n$$\n\nComputing $‖v‖$ using our definition, we get\n\n$$\n\\begin{aligned}‖v‖ & =\\sqrt{⟨v,v⟩} \\\\  & =\\sqrt{3\\cdot 3+4\\cdot ((-2)\\cdot (-2))+7\\cdot (0\\cdot 0)} \\\\  & =\\sqrt{9+16} \\\\  & =\\sqrt{25} \\\\  & =5.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/state.json" "file_sha256" "b5dc5188d8fdf6aafffa23f9aa3023e6b5623ad9e1db3086f8368ea1909ef020" "basis" 1451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/edb-import/verification.json"} {"question" "q-43908" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/activity-metadata.json" "file_sha256" "6b3dde96a478b61d719fd518dcbfe870937305ab4a3d5e1e2ed43ec4aebbdce6" "basis" 1451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/edb-import/verification.json"} {"question" "q-43908" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/state.json" "file_sha256" "b5dc5188d8fdf6aafffa23f9aa3023e6b5623ad9e1db3086f8368ea1909ef020" "basis