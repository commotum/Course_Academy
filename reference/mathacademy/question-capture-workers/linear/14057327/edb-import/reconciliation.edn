ecba6ad905c"} {"question" "q-97413" "field" nil "attribute" "question/worked-solution" "value" "The norm of a vector $v$ with respect to an inner product $⟨\\cdot ,\\cdot ⟩$ is defined as\n\n$$\n\\begin{aligned}‖v‖=\\sqrt{⟨v,v⟩}.\\end{aligned}\n$$\n\nComputing $‖v‖$ using our definition, we get\n\n$$\n\\begin{aligned}‖v‖ & =\\sqrt{⟨v,v⟩} \\\\  & =\\sqrt{2\\cdot (3\\cdot 3)+2\\cdot (2\\cdot 2)+(-3)\\cdot (-3)} \\\\  & =\\sqrt{18+8+9} \\\\  & =\\sqrt{35}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14057327/state.json" "file_sha256" "cd4a90ae5f6ab36a3b374df6981c2a45ef51e563e038cbe0be0faecba6ad905c"} {"question" "q-97413" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14057327/activity-metadata.json" "file_sha256" "80fec36a7cafbb2fd5ad8479fee505def4c237401c1797d0842fb782d46a9cee"} {"question" "q-97413" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14057327/state.json" "file_sha256" "cd4a90ae5f6ab36a3b374df6981c2a45ef51e563e038cbe0be0faecba6ad905c"} {"question" "q-97413" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "3\\sqrt{3}"] ["math" "5"] ["math" "6"] ["math" "\\sqrt{22}"] ["math" "\\sqrt{35}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14057327/state.json" "file_sha256" "cd4a90ae5f6ab36a3b374df6981c2a45ef51e563e038cbe0be0faecba6ad905c"} {"question" "q-97413" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\sqrt{35}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14057327/state.json" "file_sha256" "cd4a90ae5f6ab36a3b374df6981c2a45ef51e563e038cbe0be0faecba6ad905c"} {"question" "q-141169" "field" nil "attribute" "question/problem" "value" "Let $V={R}_{2}[t]$ be the vector space of all polynomials of degree at most $2,$ equipped with the inner product\n\n$$\n⟨x(t),y(t)⟩=x(1)y(1)+x(0)y(0)+x(-1)y(-1).\n$$\n\nCalculate the norm of the vector $p(t)=2-3t+{t}^{2}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14057327/state.json" "file_sha256" "cd4a90ae5f6ab36a3b374df6981c2a45ef51e563e038cbe0be0faecba6ad905c"} {"question" "q-141169" "field" nil "attribute" "question/worked-solution" "value" "The norm of a vector $p(t)$ with respect to an inner product $⟨\\cdot ,\\cdot ⟩$ is defined as\n\n$$\n\\begin{aligned}‖p(t)‖=\\sqrt{⟨p(t),p(t)⟩}.\\end{aligned}\n$$\n\nSince $p(t)=2-3t+{t}^{2},$ we obtain\n\n$$\np(1)=0,\\,p(0)=2,\\,p(-1)=6.\n$$\n\nComputing $‖p(t)‖$ using our definition, we get\n\n$$\n\\begin{aligned}‖p(t)‖ & =\\sqrt{⟨p(t),p(t)⟩} \\\\  & =\\sqrt{p(1)p(1)+p(0)p(0)+p(-1)p(-1)} \\\\  & =\\sqrt{[p(1)]^{2}+[p(0)]^{2}+[p(-1)]^{2}} \\\\  & =\\sqrt{{0}^{2}+{2}^{2}+{6}^{2}} \\\\  & =\\sqrt{0+4+36} \\\\  & =\\sqrt{40} \\\\  & =2\\sqrt{10}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14057327/state.json" "file_sha256" "cd4a90ae5f6ab36a3b374df6981c2a45ef51e563e038cbe0be0faecba6ad905c"} {"question" "q-141169" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14057327/activity-metadata.json" "file_sha256" "80fec36a7cafbb2fd5ad8479fee505def4c237401c1797d0842fb782d46a9cee"} {"question" "q-141169" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "