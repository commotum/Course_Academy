/14040608/edb-import/verification.json"} {"question" "q-97726" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{\\sqrt{7}}{7}[\\begin{aligned}3 \\\\ 2 \\\\ -3\\end{aligned}]"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/state.json" "file_sha256" "b5dc5188d8fdf6aafffa23f9aa3023e6b5623ad9e1db3086f8368ea1909ef020" "basis" 1451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/edb-import/verification.json"} {"question" "q-97726" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{\\sqrt{35}}{35}[\\begin{aligned}3 \\\\ 2 \\\\ -3\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/state.json" "file_sha256" "b5dc5188d8fdf6aafffa23f9aa3023e6b5623ad9e1db3086f8368ea1909ef020" "basis" 1451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/edb-import/verification.json"} {"question" "q-97725" "field" nil "attribute" "question/problem" "value" "An inner product on $V={R}^{3}$ is defined as $⟨x,y⟩=3{x}_{1}{y}_{1}+{x}_{2}{y}_{2}+3{x}_{3}{y}_{3}.$ \n\nNormalize the  vector $v=[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}]$ under this inner product." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/state.json" "file_sha256" "b5dc5188d8fdf6aafffa23f9aa3023e6b5623ad9e1db3086f8368ea1909ef020" "basis" 1451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/edb-import/verification.json"} {"question" "q-97725" "field" nil "attribute" "question/worked-solution" "value" "The norm of a vector $v$ with respect to an inner product $⟨\\cdot ,\\cdot ⟩$ is defined as\n\n$$\n\\begin{aligned}‖v‖=\\sqrt{⟨v,v⟩}.\\end{aligned}\n$$\n\nComputing the inner product using our definition, we get\n\n$$\n\\begin{aligned}⟨v,v⟩ & =3\\cdot (2\\cdot 2)+(-1)\\cdot (-1)+3\\cdot (1\\cdot 1) \\\\  & =12+1+3 \\\\  & =16.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}‖v‖ & =\\sqrt{16}=4.\\end{aligned}\n$$\n\nTo normalize the vector $v$, we divide $v$ by its norm $‖v‖:$\n\n$$\n\\begin{aligned}u & =\\frac{v}{‖v‖} \\\\  & =\\frac{1}{4}[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/state.json" "file_sha256" "b5dc5188d8fdf6aafffa23f9aa3023e6b5623ad9e1db3086f8368ea1909ef020" "basis" 1451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/edb-import/verification.json"} {"question" "q-97725" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/activity-metadata.json" "file_sha256" "6b3dde96a478b61d719fd518dcbfe870937305ab4a3d5e1e2ed43ec4aebbdce6" "basis" 1451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/edb-import/verification.json"} {"question" "q-97725" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/state.json" "file_sha256" "b5dc5188d8fdf6aafffa23f9aa3023e6b5623ad9e1db3086f8368ea1909ef020" "basis" 1451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/edb-import/verification.json"} {"question" "q-97725" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{1}{4}[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}]"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/state.json" "file_sha256" "b5dc5188d8fdf6aafffa23f9aa3023e6b5623ad9e1db3086f8368ea1909ef020" "basis" 1451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/edb-import/verification.json"} {"question" "q-97725" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{\\sqrt{11}}{11}[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}]"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/state.json" "file_sha256" "b5dc5188d8fdf6aafffa23f9aa3023e6b5623ad9e1db3086f8368ea1909ef020" "basis" 1451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/edb-import/verification.json"} {"question" "q-97725" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{\\sqrt{2}}{2}[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}]"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/state.json" "file_sha256" "b5dc5188d8fdf6aafffa23f9aa3023e6b5623ad9e1db3086f8368ea1909ef020" "basis" 1451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/edb-import/verification.json"} {"question" "q-97725" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{\\sqrt{2}}{4}[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}]"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/state.json" "file_sha256" "b5dc5188d8fdf6aafffa23f9aa3023e6b5623ad9e1db3086f8368ea1909ef020" "basis" 1451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/edb-import/verification.json"} {"question" "q-97725" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{\\sqrt{6}}{6}[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}]"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/state.json" "file_sha256" "b5dc5188d8fdf6aafffa23f9aa3023e6b5623ad9e1db3086f8368ea1909ef020" "basis" 1451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/edb-import/verification.json"} {"question" "q-42741" "field" nil "attribute" "question/problem" "value" "Let $V={R}_{1}[t]$ be the vector space of all polynomials of degree at most $1,$ equipped with the inner product\n\n$$\n⟨x(t),y(t)⟩=x(1)y(1)+x(2)y(2).\n$$\n\nNormalize the  vector  $p(t)=2+t.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/state.json" "file_sha256" "b5dc5188d8fdf6aafffa23f9aa3023e6b5623ad9e1db3086f8368ea1909ef020" "basis" 1451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/edb-import/verification.json"} {"question" "q-42741" "field" nil "attribute" "question/worked-solution" "value" "The norm of a vector $f(t)$ with respect to an inner product $⟨\\cdot ,\\cdot ⟩$ is defined as\n\n$$\n‖p(t)‖=\\sqrt{⟨p(t),p(t)⟩}.\n$$\n\nSince $p(t)=2+t,$ we obtain\n\n$$\np(1)=3,\\,p(2)=4.\n$$\n\nComputing the inner product using our definition, we get\n\n$$\n\\begin{aligned}⟨p(t),p(t)⟩ & =[p(1)]^{2}+[p(2)]^{2} \\\\  & ={3}^{2}+{4}^{2} \\\\  & =9+16 \\\\  & =25.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}‖p(t)‖ & =\\sqrt{25}=5.\\end{aligned}\n$$\n\nTo normalize the vector $p(t)$, we divide $p(t)$ by its norm $‖p(t)‖:$\n\n$$\n\\begin{aligned}u(t) & =\\frac{p(t)}{‖p(t)‖} \\\\  & =\\frac{2+t}{5} \\\\  & =\\frac{1}{5}(2+t)\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/state.json" "file_sha256" "b5dc5188d8fdf6aafffa23f9aa3023e6b5623ad9e1db3086f8368ea1909ef020" "basis" 1451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/edb-import/verification.json"} {"question" "q-42741" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/activity-metadata.json" "file_sha256" "6b3dde96a478b61d719fd518dcbfe870937305ab4a3d5e1e2ed43ec4aebbdce6" "basis" 1451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/edb-import/verification.json"} {"question" "q-42741" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/state.json" "file_sha256" "b5dc5188d8fdf6aafffa23f9aa3023e6b5623ad9e1db3086f8368ea1909ef020" "basis" 1451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/edb-import/verification.json"} {"question" "e-5908" "field" nil "attribute" "question/problem" "value" "An inner product on $V = \\mathbb{R}^3$ is defined as $\\langle \\mathbf{x}, \\mathbf{y} \\rangle =  2x_1 y_1 + x_2 y_2 + 3x_3 y_3.$ \nCalculate the norm of the vector $[\\begin{aligned}3 \\\\ 2 \\\\ 1\\end{aligned}]$ under this inner product." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/example-5908.json" "file_sha256" "57d24c849b65e5b8ac34183544542d28f9521221420b2bda7d0c1382d4314a97" "basis" 1451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/edb-import/verification.json"} {"question" "e-5908" "field" nil "attribute" "question/worked-solution" "value" "The norm of a vector $\\mathbf v$ with respect to an inner product $\\langle \\cdot, \\cdot \\rangle$ is defined as\n\n$$\n\\begin{aligned}‖v‖=\\sqrt{⟨v,v⟩}.\\end{aligned}\n$$\n\nComputing $\\|\\mathbf{v}\\|$ using our definition, we get\n\n$$\n\\begin{aligned}‖v‖ & =\\sqrt{⟨v,v⟩} \\\\  & =\\sqrt{2\\cdot (3\\cdot 3)+2\\cdot 2+3\\cdot (1\\cdot 1)} \\\\  & =\\sqrt{18+4+3} \\\\  & =\\sqrt{25} \\\\  & =5.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/example-5908.json" "file_sha256" "57d24c849b65e5b8ac34183544542d28f9521221420b2bda7d0c1382d4314a97" "basis" 1451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/edb-import/verification.json"} {"question" "e-5548" "field" nil "attribute" "question/problem" "value" "Let $V=\\mathbb{R}_2[t]$ be the vector space of all polynomials of degree at most $2,$ equipped with the inner product\n\n$$\n\\langle {x}(t), {y}(t) \\rangle = x(1)y(1) + x(2)y(2) + x(3)y(3).\n$$\n\nCalculate the norm of the vector  $p(t) = 1 - t^2.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/example-5548.json" "file_sha256" "d3bf8037c9d3835033d7d12487ecd7375ecce85e92b94e1596511c259c249f20" "basis" 1451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/edb-import/verification.json"} {"question" "e-5548" "field" nil "attribute" "question/worked-solution" "value" "The norm of a vector $p(t)$ with respect to an inner product $\\langle \\cdot, \\cdot \\rangle$ is defined as\n\n$$\n\\begin{aligned}‖p(t)‖=\\sqrt{⟨p(t),p(t)⟩}.\\end{aligned}\n$$\n\nSince ${p}(t) = 1-t^2,$ we obtain\n\n$$\np(1)=0,\\qquad \np(2)= -3,\\qquad \np(3)=-8.\n$$\n\nComputing $\\|p(t)\\|$ using our definition, we get\n\n$$\n\\begin{aligned}‖p(t)‖ & =\\sqrt{⟨p(t),p(t)⟩} \\\\  & =\\sqrt{p(1)p(1)+p(2)p(2)+p(3)p(3)} \\\\  & =\\sqrt{[p(1)]^{2}+[p(2)]^{2}+[p(3)]^{2}} \\\\  & =\\sqrt{(0)^{2}+(-3)^{2}+(-8)^{2}} \\\\  & =\\sqrt{0+9+64} \\\\  & =\\sqrt{73}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/example-5548.json" "file_sha256" "d3bf8037c9d3835033d7d12487ecd7375ecce85e92b94e1596511c259c249f20" "basis" 1451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/edb-import/verification.json"} {"question" "e-5549" "field" nil "attribute" "question/problem" "value" "Let $V=\\mathcal{C}\\left[0,1\\right]$ be the vector space of all functions that are continuous on $\\left[0,1\\right],$ equipped with the inner product \n\n$$\n\\langle x(t),y(t) \\rangle = \\displaystyle\\int_{0}^{1} x(t) y(t) \\, \\textrm{d}t.\n$$\n\nCalculate the norm of the vector $f(t)= 2t-1.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/example-5549.json" "file_sha256" "f6b4d361bcba77e4ddcff95327e65692e07239e28bbac8257a53c88388fdae68" "basis" 1451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/edb-import/verification.json"} {"question" "e-5549" "field" nil "attribute" "question/worked-solution" "value" "The norm of a vector $f(t)$ with respect to an inner product $\\langle \\cdot, \\cdot \\rangle$ is defined as\n\n$$\n\\| f(t)\\| = \\sqrt{\\langle  f(t),  f(t) \\rangle}.\n$$\n\nComputing the inner product using our definition, we get\n\n$$\n\\begin{aligned}⟨f(t),f(t)⟩ & ={\\int }_{0}^{1}(f(t))^{2}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(2t-1)^{2}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(4{t}^{2}-4t+1)\\,\\text{d}t \\\\  & ={(\\frac{4{t}^{3}}{3}-2{t}^{2}+t)|}_{0}^{1} \\\\  & =\\frac{4}{3}-2+1 \\\\  & =\\frac{1}{3}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\| f(t)\\| = \\sqrt{\\dfrac{1}{3}} = \\dfrac{\\sqrt 3}{3}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/example-5549.json" "file_sha256" "f6b4d361bcba77e4ddcff95327e65692e07239e28bbac8257a53c88388fdae68" "basis" 1451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/edb-import/verification.json"} {"question" "e-5550" "field" nil "attribute" "question/problem" "value" "Let $V=\\mathcal{C}\\left[0,\\pi\\right]$ be the vector space of all functions that are continuous on $\\left[0,\\pi\\right],$ equipped with the inner product \n\n$$\n\\langle x(t),y(t) \\rangle = \\displaystyle\\int_{0}^{\\pi} x(t) y(t) \\, \\textrm{d}t.\n$$\n\nNormalize the vector $f(t)= 3t.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/example-5550.json" "file_sha256" "a336f55ef818104f3608c1e61c0dc7eaef28dade692fcebd45d10c080389f2e1" "basis" 1451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/edb-import/verification.json"} {"question" "e-5550" "field" nil "attribute" "question/worked-solution" "value" "The norm of a vector $f(t)$ with respect to an inner product $\\langle \\cdot, \\cdot \\rangle$ is defined as\n\n$$\n\\| f(t)\\| = \\sqrt{\\langle  f(t),  f(t) \\rangle}.\n$$\n\nComputing the inner product using our definition, we get\n\n$$\n\\begin{aligned}⟨f(t),f(t)⟩ & ={\\int }_{0}^{\\pi }{(3t)}^{2}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }9{t}^{2}\\,\\text{d}t \\\\  & =3{t}^{3}\\,{|}_{0}^{\\pi } \\\\  & =3{\\pi }^{3}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\| f(t) \\|  = \\sqrt{3\\pi^3} = \\pi \\sqrt{3\\pi}.\n$$\n\nTo normalize the vector $f(t),$ we divide $f(t)$ by its norm $\\| f(t) \\| \\mathbin{:}$\n\n$$\n\\begin{aligned}u(t) & =\\frac{f(t)}{‖f(t)‖} \\\\  & =\\frac{1}{\\pi \\sqrt{3\\pi }}\\cdot 3t \\\\  & =\\frac{t\\sqrt{3}}{\\pi \\sqrt{\\pi }}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/example-5550.json" "file_sha256" "a336f55ef818104f3608c1e61c0dc7eaef28dade692fcebd45d10c080389f2e1" "basis" 1451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040608/edb-import/verification.json"}] "sources" [{"question" "q-43908" "field" nil "attribute" "question/problem" "value" "An inner product on $V={R}^{3}$ is defined as $⟨x,y⟩={x}_{1}{y}_{1}+4{x}_{2}{y}_{2}+7{x}_{3}{y}_{3}.$ \nCalculate the norm of the vector $v=[\\begin{aligned}3 \\\\ -2 \\\\ 0\\end{aligned}]$ under this inner product." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14057327/state.json" "file_sha256" "cd4a90ae5f6ab36a3b374df6981c2a45ef51e563e038cbe0be0faecba6ad905c"} {"question" "q-43908" "field" nil "attribute" "question/worked-solution" "value" "The norm of a vector $v$ with respect to an inner product $⟨\\cdot ,\\cdot ⟩$ is defined as\n\n$$\n\\begin{aligned}‖v‖=\\sqrt{⟨v,v⟩}.\\end{aligned}\n$$\n\nComputing $‖v‖$ using our definition, we get\n\n$$\n\\begin{aligned}‖v‖ & =\\sqrt{⟨v,v⟩} \\\\  & =\\sqrt{3\\cdot 3+4\\cdot ((-2)\\cdot (-2))+7\\cdot (0\\cdot 0)} \\\\  & =\\sqrt{9+16} \\\\  & =\\sqrt{25} \\\\  & =5.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14057327/state.json" "file_sha256" "cd4a90ae5f6ab36a3b374df6981c2a45ef51e563e038cbe0be0faecba6ad905c"} {"question" "q-43908" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14057327/activity-metadata.json" "file_sha256" "80fec36a7cafbb2fd5ad8479fee505def4c237401c1797d0842fb782d46a9cee"} {"question" "q-43908" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14057327/state.json" "file_sha256" "cd4a90ae5f6ab36a3b374df6981c2a45ef51e563e038cbe0be0faecba6ad905c"} {"question" "q-43908" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "4"] ["math" "5"] ["math" "6"] ["math" "\\sqrt{13}"] ["math" "\\sqrt{37}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14057327/state.json" "file_sha256" "cd4a90ae5f6ab36a3b374df6981c2a45ef51e563e038cbe0be0faecba6ad905c"} {"question" "q-43908" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "5"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14057327/state.json" "file_sha256" "cd4a90ae5f6ab36a3b374df6981c2a45ef51e563e038cbe0be0faecba6ad905c"} {"question" "q-42733" "field" nil "attribute" "question/problem" "value" "An inner product on $V={R}^{3}$ is defined as $⟨x,y⟩={x}_{1}{y}_{1}+3{x}_{2}{y}_{2}+2{x}_{3}{y}_{3}.$ \nCalculate the norm of the vector $v=[\\begin{aligned}-1 \\\\ -2 \\\\ 0\\end{aligned}]$ under this inner product." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14057327/sta