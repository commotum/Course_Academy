#{[{:db/id #edb/ref 17592186259552 :knowledge-point/_questions [{:knowledge-point/id #uuid "79c85169-b2cd-5195-a225-395f470200b5" :knowledge-point/title "Identifying a Complex Number With No Real or No Imaginary Part Represented by an Argand Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95c00f40-1fa1-5066-bc6d-a527f0363ea4" :answer/type {:db/ident :answer.type/math} :answer/value "-6i" :db/id #edb/ref 17592186259554}] :answer-field/correct {:answer/id #uuid "95c00f40-1fa1-5066-bc6d-a527f0363ea4" :answer/type {:db/ident :answer.type/math} :answer/value "-6i" :db/id #edb/ref 17592186259554} :answer-field/id #uuid "4df4fbd9-c930-5449-b653-e838fec21002" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259553}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "09b04830-3363-5cf1-8509-ae768a428aac" :question/math-academy-id "q-320077" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/07386bb0e42ae051fadc55f3949150582f31df36b28acee666c1e9583c5cbbf1.png)\n\nWhat complex number is represented in the Argand diagram above? Use $i$ to denote the imaginary unit.\n\n$z=$\n{{field-1}}" :question/worked-solution "The coordinates of the point are $(0,-6).$\n\n- The real part of this complex number is $x=0,$ and\n\n- the imaginary part is $y=-6.$\n\nTherefore, the number depicted is $z=0-6i,$ which can be simplified to $z=-6i.$"}]}
