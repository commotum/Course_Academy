#{[{:db/id #edb/ref 17592186059510 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "208b226a-cdb5-575d-bc37-45b1ea33e40b" :knowledge-point/title "Identifying a Complex Number Represented by an Argand Diagram"}] :question/id #uuid "8973aa57-e496-575e-9352-5e466750f124" :question/math-academy-id "e-5034" :question/problem "What complex number is represented in the Argand diagram below?\n\n![](/home/jake/Developer/MA/DATA/Lessons/157/Source/Images/a398e70774f8baf4d12c200edfc8d28c.png)" :question/worked-solution "The coordinates of the point are $(-2,3)$.\n\n- The real part of this complex number is $x=-2$, and\n- the imaginary part is $y=3$.\n\nTherefore, the number depicted is\n\n$$\nz=-2+3\\textrm{i}\n$$"}] [{:db/id #edb/ref 17592186059511 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "79c85169-b2cd-5195-a225-395f470200b5" :knowledge-point/title "Identifying a Complex Number With No Real or No Imaginary Part Represented by an Argand Diagram"}] :question/id #uuid "4a1ada31-73ba-553d-962b-201cc1dc2f62" :question/math-academy-id "e-5035" :question/problem "What complex number is represented in the Argand diagram below?\n\n![](/home/jake/Developer/MA/DATA/Lessons/157/Source/Images/96b2302a93c679607a0ea501bc4f3a7f.png)" :question/worked-solution "The coordinates of the point are $(-4,0)$.\n\n- The real part of this complex number is $x=-4$, and\n- the imaginary part is $y=0$.\n\nTherefore, the number depicted is\n\n$$\nz=-4+0\\textrm{i}\n$$\n\nwhich can be simplified to $z= -4$."}] [{:db/id #edb/ref 17592186059512 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "f4b612ef-ce7f-5783-848d-d8ef210c9f47" :knowledge-point/title "Identifying an Argand Diagram Corresponding to a Complex Number"}] :question/id #uuid "dc1c05bc-a361-5ce6-a277-41dd30de2a45" :question/math-academy-id "e-5036" :question/problem "Draw an Argand diagram representing the complex number $z=4+\\textrm{i}$." :question/worked-solution "We are given the complex number\n\n$$\nz=4+\\textrm{i}\n$$\n\n.\n\n- The real part of this complex number is $x=4$, and\n- the imaginary part is $y=1$.\n\nTherefore, the coordinates of the point are $(4,1)$, as shown in the Argand diagram below.\n\n![](/home/jake/Developer/MA/DATA/Lessons/157/Source/Images/31f777ba83b6d4d999116f1920ec0308.png)"}] [{:db/id #edb/ref 17592186259552 :knowledge-point/_questions [{:knowledge-point/id #uuid "79c85169-b2cd-5195-a225-395f470200b5" :knowledge-point/title "Identifying a Complex Number With No Real or No Imaginary Part Represented by an Argand Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95c00f40-1fa1-5066-bc6d-a527f0363ea4" :answer/type {:db/ident :answer.type/math} :answer/value "-6i" :db/id #edb/ref 17592186259554}] :answer-field/correct {:answer/id #uuid "95c00f40-1fa1-5066-bc6d-a527f0363ea4" :answer/type {:db/ident :answer.type/math} :answer/value "-6i" :db/id #edb/ref 17592186259554} :answer-field/id #uuid "4df4fbd9-c930-5449-b653-e838fec21002" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259553}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "09b04830-3363-5cf1-8509-ae768a428aac" :question/math-academy-id "q-320077" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/07386bb0e42ae051fadc55f3949150582f31df36b28acee666c1e9583c5cbbf1.png)\n\nWhat complex number is represented in the Argand diagram above? Use $i$ to denote the imaginary unit.\n\n$z=$\n{{field-1}}" :question/worked-solution "The coordinates of the point are $(0,-6).$\n\n- The real part of this complex number is $x=0,$ and\n\n- the imaginary part is $y=-6.$\n\nTherefore, the number depicted is $z=0-6i,$ which can be simplified to $z=-6i.$"}] [{:db/id #edb/ref 17592186060313 :knowledge-point/_questions [{:knowledge-point/id #uuid "79c85169-b2cd-5195-a225-395f470200b5" :knowledge-point/title "Identifying a Complex Number With No Real or No Imaginary Part Represented by an Argand Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81d61478-cb99-59d7-b8e3-440f768af1eb" :answer/type {:db/ident :answer.type/math} :answer/value "z = 2" :db/id #edb/ref 17592186058862} {:answer/id #uuid "a0c74234-883d-55b7-91b1-880b3ed7e934" :answer/type {:db/ident :answer.type/math} :answer/value "z = 2\\textrm{i}" :db/id #edb/ref 17592186058863} {:answer/id #uuid "c837d15c-a188-5101-a986-21318e57ceff" :answer/type {:db/ident :answer.type/math} :answer/value "z =-2" :db/id #edb/ref 17592186058864} {:answer/id #uuid "1a89f244-fb14-5391-91e3-ee6e8f5309ca" :answer/type {:db/ident :answer.type/math} :answer/value "z =-2\\textrm{i}" :db/id #edb/ref 17592186058865} {:answer/id #uuid "629b1547-2da4-507f-ac7d-03ad9e5af44b" :answer/type {:db/ident :answer.type/math} :answer/value "z = 0" :db/id #edb/ref 17592186058866}] :answer-field/correct {:answer/id #uuid "1a89f244-fb14-5391-91e3-ee6e8f5309ca" :answer/type {:db/ident :answer.type/math} :answer/value "z =-2\\textrm{i}" :db/id #edb/ref 17592186058865} :answer-field/id #uuid "5582e440-b87c-53e1-9393-8bdfe610da74" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186058861}] :question/id #uuid "aba305a7-4fcc-5a97-9e41-40a6cfb6c6b5" :question/math-academy-id "q-69768" :question/problem "![](/home/jake/Developer/MA/DATA/Lessons/157/Source/Images/q-69768.png)\n\nWhat complex number is represented in the Argand diagram above?"}]}
