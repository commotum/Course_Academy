#{[{:db/id #edb/ref 17592186059510 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "208b226a-cdb5-575d-bc37-45b1ea33e40b" :knowledge-point/title "Identifying a Complex Number Represented by an Argand Diagram"}] :question/id #uuid "8973aa57-e496-575e-9352-5e466750f124" :question/math-academy-id "e-5034" :question/problem "What complex number is represented in the Argand diagram below?\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035975/assets/79285ea5c9dc4b535b972f40fb16c9deaf57d895b2081eb789d74663525e12d2.png)" :question/worked-solution "The coordinates of the point are $(-2,3)$.\n\n- The real part of this complex number is $x=-2,$ and\n\n- the imaginary part is $y=3.$\n\nTherefore, the number depicted is $z=-2+3\\textrm{i}.$"}] [{:db/id #edb/ref 17592186059511 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "79c85169-b2cd-5195-a225-395f470200b5" :knowledge-point/title "Identifying a Complex Number With No Real or No Imaginary Part Represented by an Argand Diagram"}] :question/id #uuid "4a1ada31-73ba-553d-962b-201cc1dc2f62" :question/math-academy-id "e-5035" :question/problem "What complex number is represented in the Argand diagram below?\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035975/assets/7bcf26c8df340bc61e1863043ba2126dea07661c2e288fa5321ddd5ae9e67b46.png)" :question/worked-solution "The coordinates of the point are $(-4,0).$\n\n- The real part of this complex number is $x=-4,$ and\n\n- the imaginary part is $y=0.$\n\nTherefore, the number depicted is $z=-4+0\\textrm{i},$ which can be simplified to $z= -4.$"}] [{:db/id #edb/ref 17592186059512 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "f4b612ef-ce7f-5783-848d-d8ef210c9f47" :knowledge-point/title "Identifying an Argand Diagram Corresponding to a Complex Number"}] :question/id #uuid "dc1c05bc-a361-5ce6-a277-41dd30de2a45" :question/math-academy-id "e-5036" :question/problem "Draw an Argand diagram representing the complex number $z=4+\\textrm{i}$." :question/worked-solution "We are given the complex number $z=4+\\textrm{i}$.\n\n- The real part of this complex number is $x=4,$ and\n\n- the imaginary part is $y=1.$\n\nTherefore, the coordinates of the point are $(4,1)$, as shown in the Argand diagram below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035975/assets/3ec41e707260b15e36da91542b98a66abcaa7950a3d4b06a95f919a204aec797.png)"}] [{:db/id #edb/ref 17592186297112 :knowledge-point/_questions [{:knowledge-point/id #uuid "f4b612ef-ce7f-5783-848d-d8ef210c9f47" :knowledge-point/title "Identifying an Argand Diagram Corresponding to a Complex Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "254ff75c-b89c-5931-b07c-83fa1d24b13f" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035975/assets/8cc2fd5679027092ca053f2dd5a6c911ff10852dbf06ca23362c5d7252b21f1e.png" :db/id #edb/ref 17592186297114} {:answer/id #uuid "3859d9ab-970b-5c21-bdaa-b34f3d976587" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035975/assets/556993791d4f77a087930583b910b06c92248b9a883d1c1358cfd6b081c572fb.png" :db/id #edb/ref 17592186297115} {:answer/id #uuid "88959e3a-bf5f-52d6-a318-5fcd978643b1" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035975/assets/3649cbb0b9d9a30480ea1566cd4aaf207e584b578345466c26088c9e53324eee.png" :db/id #edb/ref 17592186297116} {:answer/id #uuid "eb411b4c-484b-58ce-bbce-a5e4cfb01eb0" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035975/assets/46440f271640189ac02d0b671d6f787c516fbb8d02ef2f40d990211e5e277181.png" :db/id #edb/ref 17592186297117} {:answer/id #uuid "0895a7e1-2a7f-5959-993e-0999118a693d" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035975/assets/4af2479d181f4a439378c9ca542505f672f8819a45dd64ff64e524926ccd40b4.png" :db/id #edb/ref 17592186297118}] :answer-field/correct {:answer/id #uuid "3859d9ab-970b-5c21-bdaa-b34f3d976587" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035975/assets/556993791d4f77a087930583b910b06c92248b9a883d1c1358cfd6b081c572fb.png" :db/id #edb/ref 17592186297115} :answer-field/id #uuid "e9a1288a-d672-512f-a742-74bc8f057137" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297113}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "44f49169-d817-53bb-851f-c88b4a24cf3b" :question/math-academy-id "q-160396" :question/problem "Which of the following is an Argand diagram representing the complex number $z=-2?$" :question/worked-solution "We are given the complex number $z=-2.$\n\n- The real part of this complex number is $x=-2,$ and\n\n- the imaginary part is $y=0.$\n\nTherefore, the coordinates of the point are $(-2,0)$, as shown in the Argand diagram below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035975/assets/556993791d4f77a087930583b910b06c92248b9a883d1c1358cfd6b081c572fb.png)"}] [{:db/id #edb/ref 17592186297119 :knowledge-point/_questions [{:knowledge-point/id #uuid "f4b612ef-ce7f-5783-848d-d8ef210c9f47" :knowledge-point/title "Identifying an Argand Diagram Corresponding to a Complex Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6988b6fa-30b6-5734-9011-872eaceef080" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186297121} {:answer/id #uuid "9a4a5d51-c33d-54df-b604-548448d40c67" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186297122} {:answer/id #uuid "9bb5a03c-5865-523d-93a6-5ca9d9534364" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186297123} {:answer/id #uuid "cd25ee1a-4de3-51a5-ae19-759683c82d37" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186297124} {:answer/id #uuid "97838d96-cc00-54b7-96c6-1601c88aae12" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186297125}] :answer-field/correct {:answer/id #uuid "cd25ee1a-4de3-51a5-ae19-759683c82d37" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186297124} :answer-field/id #uuid "6adbe4a6-b25c-5c7e-b1d2-bd314ec552de" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297120}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "81d9e35d-d4b7-5ad1-acb2-c94e2a926fda" :question/math-academy-id "q-160399" :question/problem "Which of the following numbers lie in the fourth quadrant in an Argand diagram?\n\n- $3+4\\text{i}$\n- $-2+3\\text{i}$\n- $1-2\\text{i}$" :question/worked-solution "- The complex number $3+4\\text{i}$ has the real part $x=3$ and the imaginary part $y=4.$ So, it corresponds to the point $(3,4)$, which lies in the first quadrant.\n\n- The complex number $-2+3\\text{i}$ has the real part $x=-2$ and the imaginary part $y=3.$ So, it corresponds to the point $(-2,3)$, which lies in the second quadrant.\n\n- The complex number $1-2\\text{i}$ has the real part $x=1$ and the imaginary part $y=-2.$ So, it corresponds to the point $(1,-2)$, which lies in the fourth quadrant.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035975/assets/a4f87e680d46b099b9543b552191c776ac7145fba4e1b51b10c44a3685907d46.png)\n\nTherefore, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186297126 :knowledge-point/_questions [{:knowledge-point/id #uuid "208b226a-cdb5-575d-bc37-45b1ea33e40b" :knowledge-point/title "Identifying a Complex Number Represented by an Argand Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35215f44-91f5-51a1-94e2-f9a7e981d751" :answer/type {:db/ident :answer.type/math} :answer/value "z=-5\\text{i}-3" :db/id #edb/ref 17592186297128} {:answer/id #uuid "b3781f45-77a5-5ccd-b5e8-2a499a0acf7b" :answer/type {:db/ident :answer.type/math} :answer/value "z=-8\\text{i}-3" :db/id #edb/ref 17592186297129} {:answer/id #uuid "232c2edd-cc00-5f2c-b407-67c255964481" :answer/type {:db/ident :answer.type/math} :answer/value "z=-6\\text{i}-2" :db/id #edb/ref 17592186297130} {:answer/id #uuid "6759dc18-2b73-5604-a106-cacda43a303a" :answer/type {:db/ident :answer.type/math} :answer/value "z=-4\\text{i}-1" :db/id #edb/ref 17592186297131} {:answer/id #uuid "b1e3f30c-0374-573c-9be8-be03e5a24617" :answer/type {:db/ident :answer.type/math} :answer/value "z=-4\\text{i}-2" :db/id #edb/ref 17592186297132}] :answer-field/correct {:answer/id #uuid "b1e3f30c-0374-573c-9be8-be03e5a24617" :answer/type {:db/ident :answer.type/math} :answer/value "z=-4\\text{i}-2" :db/id #edb/ref 17592186297132} :answer-field/id #uuid "8511d9e4-c378-5d5e-aac7-f74f2677e6a9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297127}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "3dd38886-c0fe-53b0-98ef-a6e571575332" :question/math-academy-id "q-16303" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035975/assets/6f4759c4401158802661e282a44a0a84e2207ae71d28f38295fe8c6d132d7d46.png)\n\nWhat complex number is represented in the Argand diagram above?" :question/worked-solution "The coordinates of the point are $(-2,-4).$\n\n- The real part of this complex number is $x=-2,$ and\n\n- the imaginary part is $y=-4.$\n\nTherefore, the number depicted is $z=-2-4\\text{i}.$ Finally, notice that \n\n$$\n\\begin{aligned}z & =-2-4\\text{i} \\\\  & =-4\\text{i}-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297133 :knowledge-point/_questions [{:knowledge-point/id #uuid "208b226a-cdb5-575d-bc37-45b1ea33e40b" :knowledge-point/title "Identifying a Complex Number Represented by an Argand Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15a9ffbc-64df-50fe-851f-a39f3f4d3f14" :answer/type {:db/ident :answer.type/math} :answer/value "z=8\\text{i}+3" :db/id #edb/ref 17592186297135} {:answer/id #uuid "2e9aac6f-0dbe-59a3-91c5-46e036b255ea" :answer/type {:db/ident :answer.type/math} :answer/value "z=6\\text{i}+4" :db/id #edb/ref 17592186297136} {:answer/id #uuid "c1b263ed-c48b-5d45-a31b-740df16323b3" :answer/type {:db/ident :answer.type/math} :answer/value "z=9\\text{i}+6" :db/id #edb/ref 17592186297137} {:answer/id #uuid "474d5895-1355-5be1-8fa8-05b0a3bc2bd0" :answer/type {:db/ident :answer.type/math} :answer/value "z=5\\text{i}+3" :db/id #edb/ref 17592186297138} {:answer/id #uuid "160d81e9-758e-5a59-9aec-99502ba4b6ca" :answer/type {:db/ident :answer.type/math} :answer/value "z=7\\text{i}+5" :db/id #edb/ref 17592186297139}] :answer-field/correct {:answer/id #uuid "160d81e9-758e-5a59-9aec-99502ba4b6ca" :answer/type {:db/ident :answer.type/math} :answer/value "z=7\\text{i}+5" :db/id #edb/ref 17592186297139} :answer-field/id #uuid "f4b1b79c-8a18-5888-94c4-229003771014" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297134}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "05823928-5b8e-517f-bb11-6fa705b64bd6" :question/math-academy-id "q-16399" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035975/assets/9e0782271a6fa3565b200e824f0dfca5645d4a197cf2703c7730e9345567befa.png)\n\nWhat complex number is represented in the Argand diagram above?" :question/worked-solution "The coordinates of the point are $(5,7).$\n\n- The real part of this complex number is $x=5,$ and\n\n- the imaginary part is $y=7.$\n\nTherefore, the number depicted is $z=5+7\\text{i}.$ Finally, notice that \n\n$$\n\\begin{aligned}z & =5+7\\text{i} \\\\  & =7\\text{i}+5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297140 :knowledge-point/_questions [{:knowledge-point/id #uuid "208b226a-cdb5-575d-bc37-45b1ea33e40b" :knowledge-point/title "Identifying a Complex Number Represented by an Argand Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61f9ab3a-9393-592d-978c-c0048838099a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186297142} {:answer/id #uuid "47f79b62-b784-5d02-9ebf-dee7e24a77bf" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186297143}] :answer-field/correct {:answer/id #uuid "61f9ab3a-9393-592d-978c-c0048838099a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186297142} :answer-field/id #uuid "abbac32a-60cd-5a0e-91ca-abc571bb3d27" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186297141} {:answer-field/choices [{:answer/id #uuid "d17e69c8-ac0c-5944-b1cb-045c2f5388bd" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186297145}] :answer-field/correct {:answer/id #uuid "d17e69c8-ac0c-5944-b1cb-045c2f5388bd" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186297145} :answer-field/id #uuid "dbd402c6-f5de-5d17