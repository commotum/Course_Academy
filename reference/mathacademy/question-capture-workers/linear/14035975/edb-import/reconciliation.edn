6" "e89302b6817cdd4fb162eab4472ed27252c0b6d7e0776ec2db54ef56d227fd46"} {"question" "q-320085" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "6"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035975/state.json" "file_sha256" "e89302b6817cdd4fb162eab4472ed27252c0b6d7e0776ec2db54ef56d227fd46"} {"question" "q-160399" "field" nil "attribute" "question/problem" "value" "Which of the following numbers lie in the fourth quadrant in an Argand diagram?\n\n- $3+4\\text{i}$\n- $-2+3\\text{i}$\n- $1-2\\text{i}$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035975/state.json" "file_sha256" "e89302b6817cdd4fb162eab4472ed27252c0b6d7e0776ec2db54ef56d227fd46"} {"question" "q-160399" "field" nil "attribute" "question/worked-solution" "value" "- The complex number $3+4\\text{i}$ has the real part $x=3$ and the imaginary part $y=4.$ So, it corresponds to the point $(3,4)$, which lies in the first quadrant.\n\n- The complex number $-2+3\\text{i}$ has the real part $x=-2$ and the imaginary part $y=3.$ So, it corresponds to the point $(-2,3)$, which lies in the second quadrant.\n\n- The complex number $1-2\\text{i}$ has the real part $x=1$ and the imaginary part $y=-2.$ So, it corresponds to the point $(1,-2)$, which lies in the fourth quadrant.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035975/assets/a4f87e680d46b099b9543b552191c776ac7145fba4e1b51b10c44a3685907d46.png)\n\nTherefore, the correct answer is \"III only\"." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035975/state.json" "file_sha256" "e89302b6817cdd4fb162eab4472ed27252c0b6d7e0776ec2db54ef56d227fd46"} {"question" "q-160399" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035975/activity-metadata.json" "file_sha256" "b865ba79fbf8169508af077e38f520d8db966debb01dd90baeaf19c28d2d60d9"} {"question" "q-160399" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035975/state.json" "file_sha256" "e89302b6817cdd4fb162eab4472ed27252c0b6d7e0776ec2db54ef56d227fd46"} {"question" "q-160399" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and III only"] ["text" "I only"] ["text" "II and III only"] ["text" "II only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035975/state.json" "file_sha256" "e89302b6817cdd4fb162eab4472ed27252c0b6d7e0776ec2db54ef56d227fd46"} {"question" "q-160399" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "III only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035975/state.json" "file_sha256" "e89302b6817cdd4fb162eab4472ed27252c0b6d7e0776ec2db54ef56d227fd46"} {"question" "q-79457" "field" nil "attribute" "question/problem" "value" "Which of the following numbers lie in the second quadrant in the corresponding Argand diagram?\n\n- $-2-2\\text{i}$\n- $-2+\\text{i}$\n- $-1+2\\text{i}$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035975/state.json" "file_sha256" "e89302b6817cdd4fb162eab4472ed27252c0b6d7e0776ec2db54ef56d227fd46"} {"question" "q-79457" "field" nil "attribute" "question/worked-solution" "value" "- The complex number $-2-2\\text{i}$ has the real part $x=-2$ and the imaginary part $y=-2.$ So, it corresponds to the point $(-2,-2)$, which lies in the third quadrant.\n\n- The complex number $-2+\\text{i}$ has the real part $x=-2$ and the imaginary part $y=1.$ So, it corresponds to the point $(-2,1)$, which lies in the second quadrant.\n\n- The complex number $-1+2\\text{i}$ has the real part $x=-1$ and the imaginary part $y=2.$ So, it corresponds to the point $(-1,2)$, which lies in the second quadrant.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035975/assets/9f2e7234ba52d14098e0ecfc9695181b425764c110995b76b4b0efddf206252c.png)\n\nTherefore, the correct answer is \"II and III only\"." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035975/state.json" "file_sha256" "e89302b6817cdd4fb162eab4472ed27252c0b6d7e0776ec2db54ef56d227fd46"} {"question" "q-79457" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035975/activity-metadata.json" "file_sha256" "b865ba79fbf8169508af077e38f520d8db966debb01dd90baeaf19c28d2d60d9"} {"question" "q-79457" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035975/state.json" "file_sha256" "e89302b6817cdd4fb162eab4472ed27252c0b6d7e0776ec2db54ef56d227fd46"} {"question" "q-79457" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and III only"] ["text" "I only"] ["text" "II and III only"] ["text" "II only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035975/state.json" "file_sha256" "e89302b6817cdd4fb162eab4472ed27252c0b6d7e0776ec2db54ef56d227fd46"} {"question" "q-79457" "field"