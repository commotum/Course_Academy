ot 6)+0) \\\\  & =-48\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-131096/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "055b3809-f9aa-5dcc-8c1a-b0eb71020d7e"] :knowledge-point/questions ["q-131096"] :db/ensure [:knowledge-point/validate]} {:db/id "q-131122/selection/ac46d580a95a8fc03d1a7cb07de70e107b73fba6bf1bc1d13103b84eff3df012" :answer/id #uuid "229c0744-2b88-54bc-8c5b-16b3057791ca" :answer/type :answer.type/math :answer/value "17" :db/ensure [:answer/validate]} {:db/id "q-131122/selection/ca566c3861ad95266b92d3d8e36c85c39daf1d1780cc1bf826ae0ac7accce583" :answer/id #uuid "5d05842f-a2d3-5f25-a8e2-3512a43365ab" :answer/type :answer.type/math :answer/value "45" :db/ensure [:answer/validate]} {:db/id "q-131122/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "6fb3cbdf-86da-5237-8328-ee7c2953f9a3" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-131122/selection/abf617104680fb192056e1c9f657e38a6884fc6ae8997b265db9226e7ed0dccf" :answer/id #uuid "ffff666e-4368-53b4-9afa-01950b62b029" :answer/type :answer.type/math :answer/value "99" :db/ensure [:answer/validate]} {:db/id "q-131122/selection/0c91aee12841e83df8a63bea4f335135e4f592b0fef26da9fddc6b9cb7ae4e6d" :answer/id #uuid "3a6fd92a-8efb-5876-b2c7-4d352ecd275b" :answer/type :answer.type/math :answer/value "61" :db/ensure [:answer/validate]} {:db/id "q-131122/selection" :answer-field/id #uuid "c87fd27d-9975-594f-b2d8-21b6d673d1e1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-131122/selection/abf617104680fb192056e1c9f657e38a6884fc6ae8997b265db9226e7ed0dccf" :answer-field/choices ["q-131122/selection/ac46d580a95a8fc03d1a7cb07de70e107b73fba6bf1bc1d13103b84eff3df012" "q-131122/selection/ca566c3861ad95266b92d3d8e36c85c39daf1d1780cc1bf826ae0ac7accce583" "q-131122/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-131122/selection/abf617104680fb192056e1c9f657e38a6884fc6ae8997b265db9226e7ed0dccf" "q-131122/selection/0c91aee12841e83df8a63bea4f335135e4f592b0fef26da9fddc6b9cb7ae4e6d"] :db/ensure [:answer-field/validate]} {:db/id "q-131122" :question/id #uuid "6e564434-332d-52ba-bd09-86c87b44da06" :question/math-academy-id "q-131122" :question/problem "Calculate the determinant of the matrix\n$W=[\\begin{aligned}0 & -1 & 0 & 2 \\\\ 0 & 5 & 0 & 1 \\\\ 3 & 2 & 1 & 0 \\\\ 0 & 4 & 3 & 6\\end{aligned}].$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(W) & ={w}_{11}{C}_{11}+{w}_{12}{C}_{12}+{w}_{13}{C}_{13}+{w}_{14}{C}_{14} \\\\  & =0\\cdot {C}_{11}+(-1)\\cdot {C}_{12}+0\\cdot {C}_{13}+2\\cdot {C}_{14} \\\\  & =-{C}_{12}+2{C}_{14} \\\\  & =-1\\cdot |\\begin{aligned}∗ & -1 & ∗ & ∗ \\\\ 0 & ∗ & 0 & 1 \\\\ 3 & ∗ & 1 & 0 \\\\ 0 & ∗ & 3 & 6\\end{aligned}|+2\\cdot |\\begin{aligned}∗ & ∗ & ∗ & 2 \\\\ 0 & 5 & 0 & ∗ \\\\ 3 & 2 & 1 & ∗ \\\\ 0 & 4 & 3 & ∗\\end{aligned}| \\\\  & =-1\\cdot (-1)^{1+2}|\\begin{aligned}0 & 0 & 1 \\\\ 3 & 1 & 0 \\\\ 0 & 3 & 6\\end{aligned}|+2\\cdot (-1)^{4+1}|\\begin{aligned}0 & 5 & 0 \\\\ 3 & 2 & 1 \\\\ 0 & 4 & 3\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 0 & 1 \\\\ 3 & 1 & 0 \\\\ 0 & 3 & 6\\end{aligned}|-2|\\begin{aligned}0 & 5 & 0 \\\\ 3 & 2 & 1 \\\\ 0 & 4 & 3\\end{aligned}| \\\\  & =0\\cdot |\\begin{aligned}1 & 0 \\\\ 3 & 6\\end{aligned}|-0\\cdot |\\begin{aligned}3 & 0 \\\\ 0 & 6\\end{aligned}|+1\\cdot |\\begin{aligned}3 & 1 \\\\ 0 & 3\\end{aligned}|-2(0\\cdot |\\begin{aligned}2 & 1 \\\\ 4 & 3\\end{aligned}|-5\\cdot |\\begin{aligned}3 & 1 \\\\ 0 & 3\\end{aligned}|+0\\cdot |\\begin{aligned}3 & 2 \\\\ 0 & 4\\end{aligned}|) \\\\  & =9-2\\cdot (-5)\\cdot 9 \\\\  & =9+90 \\\\  & =99\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-131122/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "055b3809-f9a