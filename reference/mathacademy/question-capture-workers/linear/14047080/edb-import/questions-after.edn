ident :answer-field.type/radio} :db/id #edb/ref 17592186326403}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "2ead9650-2d18-5f36-b35f-cc2f4e8392b4" :question/math-academy-id "q-130905" :question/problem "Find the cofactor of ${g}_{42}$ in \n$G=[\\begin{aligned}8 & 0 & 2 & \\sqrt{3} & -2 \\\\ 3 & 5 & 0 & \\sqrt{7} & 1 \\\\ 0 & -8 & -5 & 6 & -4 \\\\ 4 & \\sqrt{5} & 3 & 8 & 3 \\\\ 11 & 3 & 0 & -9 & 11\\end{aligned}].$" :question/worked-solution "First, to get the minor of ${g}_{42}$, we remove the $4$th row and $2$nd column: \n\n$$\nG=[\\begin{aligned}8 & ∗ & 2 & \\sqrt{3} & -2 \\\\ 3 & ∗ & 0 & \\sqrt{7} & 1 \\\\ 0 & ∗ & -5 & 6 & -4 \\\\ ∗ & \\sqrt{5} & ∗ & ∗ & ∗ \\\\ 11 & ∗ & 0 & -9 & 11\\end{aligned}]\n$$\n\nSo, the minor is \n\n$$\n{M}_{42}=|\\begin{aligned}8 & 2 & \\sqrt{3} & -2 \\\\ 3 & 0 & \\sqrt{7} & 1 \\\\ 0 & -5 & 6 & -4 \\\\ 11 & 0 & -9 & 11\\end{aligned}|.\n$$\n\nNow, the cofactor of ${g}_{42}$ is\n\n$$\n\\begin{aligned}{C}_{42} & =(-1)^{4+2}{M}_{42} \\\\  & ={M}_{42} \\\\  & =|\\begin{aligned}8 & 2 & \\sqrt{3} & -2 \\\\ 3 & 0 & \\sqrt{7} & 1 \\\\ 0 & -5 & 6 & -4 \\\\ 11 & 0 & -9 & 11\\end{aligned}|.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186326409 :knowledge-point/_questions [{:knowledge-point/id #uuid "58148550-e41f-5df0-80dc-e783619cf87d" :knowledge-point/title "Calculating a Cofactor in a NxN Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a91d6eb-3d5f-5867-a558-d0d1fe74f0aa" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}5 & \\sqrt{13} & 0 & 1 \\\\ -1 & -5 & 6 & -4 \\\\ 8 & 3 & 8 & 3 \\\\ 3 & \\sqrt{2} & -9 & 7\\end{aligned}|" :db/id #edb/ref 17592186326411} {:answer/id #uuid "c1340d9e-e515-5b8b-9ed6-09e189ea2e16" :answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}3 & -8 & 1 & 0 \\\\ 3 & 5 & 0 & 1 \\\\ -25 & -1 & 6 & -4 \\\\ 4 & 8 & 8 & 3\\end{aligned}|" :db/id #edb/ref 17592186326412} {:answer/id #uuid "289769b5-4fdf-5119-a212-0b00e6b91f5f" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}3 & -8 & 2 & 1 \\\\ 3 & 5 & \\sqrt{13} & 0 \\\\ 4 & 8 & 3 & 8 \\\\ 11 & 3 & \\sqrt{2} & -9\\end{aligned}|" :db/id #edb/ref 17592186326413} {:answer/id #uuid "47a0eddd-02fb-5641-8764-d23d98730241" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}3 & -8 & 1 & 0 \\\\ 3 & 5 & 0 & 1 \\\\ -25 & -1 & 6 & -4 \\\\ 4 & 8 & 8 & 3\\end{aligned}|" :db/id #edb/ref 17592186326414} {:answer/id #uuid "f49a95ba-aec0-579b-9ca5-895efd2838d0" :answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}3 & -8 & 2 & 1 \\\\ 3 & 5 & \\sqrt{13} & 0 \\\\ 4 & 8 & 3 & 8 \\\\ 11 & 3 & \\sqrt{2} & -9\\end{aligned}|" :db/id #edb/ref 17592186326415}] :answer-field/correct {:answer/id #uuid "289769b5-4fdf-5119-a212-0b00e6b91f5f" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}3 & -8 & 2 & 1 \\\\ 3 & 5 & \\sqrt{13} & 0 \\\\ 4 & 8 & 3 & 8 \\\\ 11 & 3 & \\sqrt{2} & -9\\end{aligned}|" :db/id #edb/ref 17592186326413} :answer-field/id #uuid "6d1df66d-c242-5cb0-bc18-b1f54d867149" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326410}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "2c6270f5-9580-5374-b84c-bc9ef3e5f78f" :question/math-academy-id "q-130907" :question/problem "Find the cofactor of ${p}_{35}$ in \n$P=[\\begin{aligned}3 & -8 & 2 & 1 & 0 \\\\ 3 & 5 & \\sqrt{13} & 0 & 1 \\\\ -25 & -1 & -5 & 6 & -4 \\\\ 4 & 8 & 3 & 8 & 3 \\\\ 11 & 3 & \\sqrt{2} & -9 & 7\\end{aligned}].$" :question/worked-solution "First, to get the minor of ${p}_{35}$, we remove the $3$rd row and $5$th column: \n\n$$\nP=[\\begin{aligned}3 & -8 & 2 & 1 & ∗ \\\\ 3 & 5 & \\sqrt{13} & 0 & ∗ \\\\ ∗ & ∗ & ∗ & ∗ & -4 \\\\ 4 & 8 & 3 & 8 & ∗ \\\\ 11 & 3 & \\sqrt{2} & -9 & ∗\\end{aligned}]\n$$\n\nSo, the minor is \n\n$$\n{M}_{35}=|\\begin{aligned}3 & -8 & 2 & 1 \\\\ 3 & 5 & \\sqrt{13} & 0 \\\\ 4 & 8 & 3 & 8 \\\\ 11 & 3 & \\sqrt{2} & -9\\end{aligned}|.\n$$\n\nNow, the cofactor of ${p}_{35}$ is\n\n$$\n\\begin{aligned}{C}_{35} & =(-1)^{3+5}{M}_{35} \\\\  & ={M}_{35} \\\\  & =|\\begin{aligned}3 & -8 & 2 & 1 \\\\ 3 & 5 & \\sqrt{13} & 0 \\\\ 4 & 8 & 3 & 8 \\\\ 11 & 3 & \\sqrt{2} & -9\\end{aligned}|.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186326416 :knowledge-point/_questions [{:knowledge-point/id #uuid "055b3809-f9aa-5dcc-8c1a-b0eb71020d7e" :knowledge-point/title "Calculating the Determinant of a NxN Matrix Using Cofactor Expansion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "baac03c2-5594-5d6d-afe6-d11f2e4af0af" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186326418} {:answer/id #uuid "8f481d6f-8d90-54b7-a5fa-650497b3a7ba" :answer/type {:db/ident :answer.type/math} :answer/value "-125" :db/id #edb/ref 17592186326419} {:answer/id #uuid "82837abc-9914-5634-a56e-cbcaa750236a" :answer/type {:db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186326420} {:answer/id #uuid "249f7f9c-87a9-52ce-aef3-ae224f992091" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186326421} {:answer/id #uuid "d3d5e303-e169-53f1-af41-e7d2822ac03b" :answer/type {:db/ident :answer.type/math} :answer/value "-48" :db/id #edb/ref 17592186326422}] :answer-field/correct {:answer/id #uuid "d3d5e303-e169-53f1-af41-e7d2822ac03b" :answer/type {:db/ident :answer.type/math} :answer/value "-48" :db/id #edb/ref 17592186326422} :answer-field/id #uuid "232cbb19-7070-5995-9c13-5f120cbc0d60" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326417}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "179f7f4a-7495-5cce-8a55-25ec8c046a62" :question/math-academy-id "q-131096" :question/problem "Calculate the determinant of the matrix\n$D=[\\begin{aligned}0 & 0 & 0 & 1 \\\\ 0 & 4 & 0 & 4 \\\\ 0 & 1 & 2 & 3 \\\\ 6 & 5 & 3 & 0\\end{aligned}].$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(D) & ={d}_{11}{C}_{11}+{d}_{12}{C}_{12}+{d}_{13}{C}_{13}+{d}_{14}{C}_{14} \\\\  & =0\\cdot {C}_{11}+0\\cdot {C}_{12}+0\\cdot {C}_{13}+1\\cdot {C}_{14} \\\\  & =1{C}_{14} \\\\  & =1\\cdot |\\begin{aligned}∗ & ∗ & ∗ & 1 \\\\ 0 & 4 & 0 & ∗ \\\\ 0 & 1 & 2 & ∗ \\\\ 6 & 5 & 3 & ∗\\end{aligned}| \\\\  & =1(-1)^{1+4}|\\begin{aligned}0 & 4 & 0 \\\\ 0 & 1 & 2 \\\\ 6 & 5 & 3\\end{aligned}| \\\\  & =-1(0\\cdot |\\begin{aligned}1 & 2 \\\\ 5 & 3\\end{aligned}|-4\\cdot |\\begin{aligned}0 & 2 \\\\ 6 & 3\\end{aligned}|+0\\cdot |\\begin{aligned}0 & 1 \\\\ 6 & 5\\end{aligned}|) \\\\  & =-(0-4(3\\cdot 0-2\\cdot 6)+0) \\\\  & =-48\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186326423 :knowledge-point/_questions [{:knowledge-point/id #uuid "055b3809-f9aa-5dcc-8c1a-b0eb71020d7e" :knowledge-point/title "Calculating the Determinant of a NxN Matrix Using Cofactor Expansion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a6fd92a-8efb-5876-b2c7-4d352ecd275b" :answer/type {:db/ident :answer.type/math} :answer/value "61" :db/id #edb/ref 17592186326425} {:answer/id #uuid "6fb3cbdf-86da-5237-8328-ee7c2953f9a3" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186326426} {:answer/id #uuid "ffff666e-4368-53b4-9afa-01950b62b029" :answer/type {:db/ident :answer.type/math} :answer/value "99" :db/id #edb/ref 17592186326427} {:answer/id #uuid "229c0744-2b88-54bc-8c5b-16b3057791ca" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186326428} {:answer/id #uuid "5d05842f-a2d3-5f25-a8e2-3512a43365ab" :answer/type {:db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186326429}] :answer-field/correct {:answer/id #uuid "ffff666e-4368-53b4-9afa-01950b62b029" :answer/type {:db/ident :answer.type/math} :answer/value "99" :db/id #edb/ref 17592186326427} :answer-field/id #uuid "c87fd27d-9975-594f-b2d8-21b6d673d1e1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326424}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "6e564434-332d-52ba-bd09-86c87b44da06" :question/math-academy-id "q-131122" :question/problem "Calculate the determinant of the matrix\n$W=[\\begin{aligned}0 & -1 & 0 & 2 \\\\ 0 & 5 & 0 & 1 \\\\ 3 & 2 & 1 & 0 \\\\ 0 & 4 & 3 & 6\\end{aligned}].$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(W) & ={w}_{11}{C}_{11}+{w}_{12}{C}_{12}+{w}_{13}{C}_{13}+{w}_{14}{C}_{14} \\\\  & =0\\cdot {C}_{11}+(-1)\\cdot {C}_{12}+0\\cdot {C}_{13}+2\\cdot {C}_{14} \\\\  & =-{C}_{12}+2{C}_{14} \\\\  & =-1\\cdot |\\begin{aligned}∗ & -1 & ∗ & ∗ \\\\ 0 & ∗ & 0 & 1 \\\\ 3 & ∗ & 1 & 0 \\\\ 0 & ∗ & 3 & 6\\end{aligned}|+2\\cdot |\\begin{aligned}∗ & ∗ & ∗ & 2 \\\\ 0 & 5 & 0 & ∗ \\\\ 3 & 2 & 1 & ∗ \\\\ 0 & 4 & 3 & ∗\\end{aligned}| \\\\  & =-1\\cdot (-1)^{1+2}|\\begin{aligned}0 & 0 & 1 \\\\ 3 & 1 & 0 \\\\ 0 & 3 & 6\\end{aligned}|+2\\cdot (-1)^{4+1}|\\begin{aligned}0 & 5 & 0 \\\\ 3 & 2 & 1 \\\\ 0 & 4 & 3\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 0 & 1 \\\\ 3 & 1 & 0 \\\\ 0 & 3 & 6\\end{aligned}|-2|\\begin{aligned}0 & 5 & 0 \\\\ 3 & 2 & 1 \\\\ 0 & 4 & 3\\end{aligned}| \\\\  & =0\\cdot |\\begin{aligned}1 & 0 \\\\ 3 & 6\\end{aligned}|-0\\cdot |\\begin{aligned}3 & 0 \\\\ 0 & 6\\end{aligned}|+1\\cdot |\\begin{aligned}3 & 1 \\\\ 0 & 3\\end{aligned}|-2(0\\cdot |\\begin{aligned}2 & 1 \\\\ 4 & 3\\end{aligned}|-5\\cdot |\\begin{aligned}3 & 1 \\\\ 0 & 3\\end{aligned}|+0\\cdot |\\begin{aligned}3 & 2 \\\\ 0 & 4\\end{aligned}|) \\\\  & =9-2\\cdot (-5)\\cdot 9 \\\\  & =9+90 \\\\  & =99\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186326430 :knowledge-point/_questions [{:knowledge-point/id 