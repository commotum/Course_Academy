2904/state.json" "file_sha256" "76111f53c72140f59c241c3f717c2a7d4fe7e3279c7037bd23160a68ed3ffea3"} {"question" "q-253372" "field" "field-4" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/state.json" "file_sha256" "76111f53c72140f59c241c3f717c2a7d4fe7e3279c7037bd23160a68ed3ffea3"} {"question" "q-253372" "field" "field-4" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{\\sqrt{2}}{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/state.json" "file_sha256" "76111f53c72140f59c241c3f717c2a7d4fe7e3279c7037bd23160a68ed3ffea3"} {"question" "q-253261" "field" nil "attribute" "question/problem" "value" "Let ${J}_{n}(\\lambda )$ denote an $n\\times n$ Jordan block with $\\lambda $ on the main diagonal. Fill in the missing entries in the matrix below.\n\n| ${3}^{{J}_{2}(1)}=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/state.json" "file_sha256" "76111f53c72140f59c241c3f717c2a7d4fe7e3279c7037bd23160a68ed3ffea3"} {"question" "q-253261" "field" nil "attribute" "question/worked-solution" "value" "Given a function $f$ and a Jordan block ${J}_{n}(\\lambda ),$ we have\n\n$$\nf({J}_{n}(\\lambda ))=[\\begin{aligned}f(\\lambda ) & {f}^{′}(\\lambda ) & \\frac{{f}^{″}(\\lambda )}{2!} & ⋯ & \\frac{{f}^{(n-1)}(\\lambda )}{(n-1)!} \\\\ 0 & f(\\lambda ) & {f}^{′}(\\lambda ) & ⋯ & \\frac{{f}^{(n-2)}(\\lambda )}{(n-2)!} \\\\ ⋮ & ⋱ & ⋱ & ⋱ & ⋮ \\\\ 0 & ⋯ & 0 & f(\\lambda ) & {f}^{′}(\\lambda ) \\\\ 0 & ⋯ & ⋯ & 0 & f(\\lambda )\\end{aligned}].\n$$\n\nIn this case, we have $f(x)={3}^{x},$ $n=2,$ and $\\lambda =1.$\n\nSince $n=2,$ we need to compute the first $2-1=1$ derivatives of $f:$\n\n$$\n\\begin{aligned}f(x) & ={3}^{x} \\\\ {f}^{′}(x) & ={3}^{x}\\operatorname{ln}⁡3\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f({J}_{2}(1)) & =[\\begin{aligned}f(1) & {f}^{′}(1) \\\\ 0 & f(1)\\end{aligned}] \\\\  & =[\\begin{aligned}{3}^{1} & {3}^{1}\\cdot \\operatorname{ln}⁡3 \\\\ 0 & {3}^{1}\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 3\\operatorname{ln}⁡3 \\\\ 0 & 3\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/state.json" "file_sha256" "76111f53c72140f59c241c3f717c2a7d4fe7e3279c7037bd23160a68ed3ffea3"} {"question" "q-253261" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/activity-metadata.json" "file_sha256" "4ea4643011baa08ce614f164a25cebc94985e23735a38af1c21837f9d01af7d1"} {"question" "q-253261" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/state.json" "file_sha256" "76111f53c72140f59c241c3f717c2a7d4fe7e3279c7037bd23160a68ed3ffea3"} {"question" "q-253261" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "3"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/state.json" "file_sha256" "76111f53c72140f59c241c3f717c2a7d4fe7e3279c7037bd23160a68ed3ffea3"} {"question" "q-253261" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/state.json" "file_sha256" "76111f53c72140f59c241c3