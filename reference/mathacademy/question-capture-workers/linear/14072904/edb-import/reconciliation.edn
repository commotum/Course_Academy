.json" "file_sha256" "76111f53c72140f59c241c3f717c2a7d4fe7e3279c7037bd23160a68ed3ffea3"} {"question" "q-253311" "field" "field-5" "attribute" "answer-field/correct" "value" [:answer.type/math "-1"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/state.json" "file_sha256" "76111f53c72140f59c241c3f717c2a7d4fe7e3279c7037bd23160a68ed3ffea3"} {"question" "q-253311" "field" "field-6" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/state.json" "file_sha256" "76111f53c72140f59c241c3f717c2a7d4fe7e3279c7037bd23160a68ed3ffea3"} {"question" "q-253311" "field" "field-6" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/state.json" "file_sha256" "76111f53c72140f59c241c3f717c2a7d4fe7e3279c7037bd23160a68ed3ffea3"} {"question" "q-252925" "field" nil "attribute" "question/problem" "value" "Let ${J}_{n}(\\lambda )$ denote an $n\\times n$ Jordan block with $\\lambda $ on the main diagonal. Fill in the missing entries in the matrix below.\n\n|  |  | $6$ | {{field-1}} | $-3$ | {{field-2}} |  |\n| --- | --- | --- | --- | --- | --- | --- |\n| $\\operatorname{sin}⁡({J}_{4}(\\frac{\\pi }{6}))=\\frac{1}{12}\\,\\,$ |  | $0$ | $6$ | {{field-3}} | $-3$ |  |\n|  | $0$ | $0$ | $6$ | {{field-4}} |  |  |\n|  |  | $0$ | $0$ | $0$ | $6$ |  |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/state.json" "file_sha256" "76111f53c72140f59c241c3f717c2a7d4fe7e3279c7037bd23160a68ed3ffea3"} {"question" "q-252925" "field" nil "attribute" "question/worked-solution" "value" "Given a function $f$ and a Jordan block ${J}_{n}(\\lambda ),$ we have\n\n$$\nf({J}_{n}(\\lambda ))=[\\begin{aligned}f(\\lambda ) & {f}^{′}(\\lambda ) & \\frac{{f}^{″}(\\lambda )}{2!} & ⋯ & \\frac{{f}^{(n-1)}(\\lambda )}{(n-1)!} \\\\ 0 & f(\\lambda ) & {f}^{′}(\\lambda ) & ⋯ & \\frac{{f}^{(n-2)}(\\lambda )}{(n-2)!} \\\\ ⋮ & ⋱ & ⋱ & ⋱ & ⋮ \\\\ 0 & ⋯ & 0 & f(\\lambda ) & {f}^{′}(\\lambda ) \\\\ 0 & ⋯ & ⋯ & 0 & f(\\lambda )\\end{aligned}].\n$$\n\nIn this case, we have $f(x)=\\operatorname{sin}⁡x,$ $n=4,$ and $\\lambda =\\frac{\\pi }{6}.$\n\nSince $n=4,$ we need to compute the first $4-1=3$ derivatives of $f:$\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{sin}⁡x \\\\ {f}^{′}(x) & =\\operatorname{cos}⁡x \\\\ {f}^{″}(x) & =-\\operatorname{sin}⁡x \\\\ {f}^{‴}(x) & =-\\operatorname{cos}⁡x\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f({J}_{4}(\\frac{\\pi }{6})) & =[\\begin{aligned}f(\\frac{\\pi }{6}) & {f}^{′}(\\frac{\\pi }{6}) & \\frac{1}{2!}{f}^{″}(\\frac{\\pi }{6}) & \\frac{1}{3!}{f}^{‴}(\\frac{\\pi }{6}) \\\\ 0 & f(\\frac{\\pi }{6}) & {f}^{′}(\\frac{\\pi }{6}) & \\frac{1}{2!}{f}^{″}(\\frac{\\pi }{6}) \\\\ 0 & 0 & f(\\frac{\\pi }{6}) & {f}^{′}(\\frac{\\pi }{6}) \\\\ 0 & 0 & 0 & f(\\frac{\\pi }{6})\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{sin}⁡(\\frac{\\pi }{6}) & \\operatorname{cos}⁡(\\frac{\\pi }{6}) & -\\frac{1}{2}\\operatorname{sin}⁡(\\frac{\\pi }{6}) & -\\frac{1}{6}\\operatorname{cos}⁡(\\frac{\\pi }{6}) \\\\ 0 & \\operatorname{sin}⁡(\\frac{\\pi }{6}) & \\operatorname{cos}⁡(\\frac{\\pi }{6}) & -\\frac{1}{2}\\operatorname{sin}⁡(\\frac{\\pi }{6}) \\\\ 0 & 0 & \\operatorname{sin}⁡(\\frac{\\pi }{6}) & \\operatorname{cos}⁡(\\frac{\\pi }{6}) \\\\ 0 & 0 & 0 & \\operatorname{sin}⁡(\\frac{\\pi }{6})\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{2} & \\frac{\\sqrt{3}}{2} & -\\frac{1}{4} & -\\frac{\\sqrt{3}}{12} \\\\ 0 & \\frac{1}{2} & \\frac{\\sqrt{3}}{2} & -\\frac{1}{4} \\\\ 0 & 0 & \\frac{1}{2} & \\frac{\\sqrt{3}}{2} \\\\ 0 & 0 & 0 & \\frac{1}{2}\\end{aligned}] \\\\  & =\\frac{1}{12}[\\begin{aligned}6 & 6\\sqrt{3} & -3 & -\\sqrt{3} \\\\ 0 & 6 & 6\\sqrt{3} & -3 \\\\ 0 & 0 & 6 & 6\\sqrt{3} \\\\ 0 & 0 & 0 & 6\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/state.json" "file_sha256" "76111f53c72140f59c241c3f717c2a7d4fe7e3279c7037bd23160a68ed3ffea3"} {"question" "q-252925" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/activity-metadata.json" "file_sha256" "4ea4643011baa08ce614f164a25cebc94985e23735a38af1c21837f9d01af7d1"} {"question" "q-252925" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/state.json" "file_sha256" "76111f53c72140f59c241c3f717c2a7d4fe7e3279c7037bd23160a68ed3ffea3"} {"question" "q-252925" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "6\\sqrt{3}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/state.json" "file_sha256" "76111f53c72140f59c241c3f717c2a7d4fe7e3279c7037bd23160a68ed3ffea3"} {"question" "q-252925" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/state.json" "file_sha256" "76111f53c72140f59c241c3f717c2a7d4fe7e3279c7037bd23160a68ed3ffea3"} {"question" "q-252925" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\sqrt{3}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/state.json" "file_sha256" "76111f53c72140f59c241c3f717c2a7d4fe7e3279c7037bd23160a68ed3ffea3"} {"question" "q-252925" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/state.json" "file_sha256" "76111f53c72140f59c241c3f717c2a7d4fe7e3279c7037bd23160a68ed3ffea3"} {"question" "q-252925" "field" "field-3" "attribute" "answer-field/correct" "value" [:answer.type/math "6\\sqrt{3}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/state.json" "file_sha256" "76111f53c72140f59c241c3f717c2a7d4fe7e3279c7037bd23160a68ed3ffea3"} {"question" "q-252925" "field" "field-4" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/state.json" "file_sha256" "76111f53c72140f59c241c3f717c2a7d4fe7e3279c7037bd23160a68ed3ffea3"} {"question" "q-252925" "field" "field-4" "attribute" "answer-field/correct" "value" [:answer.type/math "6\\sqrt{3}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/state.json" "file_sha256" "76111f53c72140f59c241c3f717c2a7d4fe7e3279c7037bd23160a68ed3ffea3"} {"question" "q-253877" "field" nil "attribute" "question/problem" "value" "Let ${J}_{n}(\\lambda )$ denote an $n\\times n$ Jordan block with $\\lambda $ on the main diagonal. Fill in the missing entries in the matrix below.\n\n|  |  | {{field-1}} | {{field-2}} | {{field-3}} | $0$ |  |\n| --- | --- | --- | --- | --- | --- | --- |\n| ${({J}_{3}(2)\\,⊕\\,{J}_{1}(3))}^{4}=\\,\\,$ |  | $0$ | $16$ | {{field-4}} | $0$ |  |\n|  | $0$ | $0$ | $16$ | $0$ |  |  |\n|  |  | $0$ | $0$ | $0$ | {{field-5}} |  |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/state.json" "file_sha256" "76111f53c72140f59c241c3f717c2a7d4fe7e3279c7037bd23160a68ed3ffea3"} {"question" "q-253877" "field" nil "attribute" "question/worked-solution" "value" "Given a function $f$ and a Jordan block ${J}_{n}(\\lambda ),$ we have\n\n$$\nf({J}_{n}(\\lambda ))=[\\begin{aligned}f(\\lambda ) & {f}^{′}(\\lambda ) & \\frac{{f}^{″}(\\lambda )}{2!} & ⋯ & \\frac{{f}^{(n-1)}(\\lambda )}{(n-1)!} \\\\ 0 & f(\\lambda ) & {f}^{′}(\\lambda ) & ⋯ & \\frac{{f}^{(n-2)}(\\lambda )}{(n-2)!} \\\\ ⋮ & ⋱ & ⋱ & ⋱ & ⋮ \\\\ 0 & ⋯ & 0 & f(\\lambda ) & {f}^{′}(\\lambda ) \\\\ 0 & ⋯ & ⋯ & 0 & f(\\lambda )\\end{aligned}].\n$$\n\nFirst, note that\n\n$$\n\\begin{aligned}{({J}_{3}(2)\\,⊕\\,{J}_{1}(3))}^{4} & ={([\\begin{aligned}{J}_{3}(2) & 0 \\\\ 0 & {J}_{1}(3)\\end{aligned}])}^{4} \\\\  & =[\\begin{aligned}{({J}_{3}(2))}^{4} & 0 \\\\ 0 & {({J}_{1}(3))}^{4}\\end{aligned}] \\\\  & ={({J}_{3}(2))}^{4}\\,⊕\\,{({J}_{1}(3))}^{4}.\\end{aligned}\n$$\n\nSo, we compute the function of each Jordan block separately.\n\n- For ${J}_{3}(2),$ we have $n=3$ and $\\lambda =2.$ \\since $n=3,$ we need to compute the first and second derivatives of $f$ only:\n\n$$\n\\begin{aligned}f(x) & ={x}^{4} \\\\ {f}^{′}(x) & =4{x}^{3} \\\\ {f}^{″}(x) & =12{x}^{2}\\end{aligned}\n$$\n\nSo, we get\n\n$$\n\\begin{aligned}f({J}_{3}(2)) & =[\\begin{aligned}f(2) & {f}^{′}(2) & \\frac{{f}^{″}(2)}{2} \\\\ 0 & f(2) & {f}^{′}(2) \\\\ 0 & 0 & f(2)\\end{aligned}] \\\\  & =[\\begin{aligned}{2}^{4} & 4\\cdot {2}^{3} & \\frac{12\\cdot {2}^{2}}{2} \\\\ 0 & {2}^{4} & 4\\cdot {2}^{3} \\\\ 0 & 0 & {2}^{4}\\end{aligned}] \\\\  & =[\\begin{aligned}16 & 32 & 24 \\\\ 0 & 16 & 32 \\\\ 0 & 0 & 16\\end{aligned}].\\end{aligned}\n$$\n\n- For ${J}_{1}(3),$ we have $n=1$ and $\\lambda =1.$ since $n=1,$ we don't need any derivatives. So, we get\n\n$$\n\\begin{aligned}f({J}_{1}(3)) & =[\\begin{aligned}f(3)\\end{aligned}] \\\\  & =[\\begin{aligned}{3}^{4}\\end{aligned}] \\\\  & =[\\begin{aligned}81\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}{({J}_{3}(2)\\,⊕\\,{J}_{1}(3))}^{4} & ={({J}_{3}(2))}^{4}\\,⊕\\,{({J}_{1}(3))}^{4} \\\\  & =[\\begin{aligned}16 & 32 & 24 & 0 \\\\ 0 & 16 & 32 & 0 \\\\ 0 & 0 & 16 & 0 \\\\ 0 & 0 & 0 & 81\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/state.json" "file_sha256" "76111f53c72140f59c241c3f717c2a7d4fe7e3279c7037bd23160a68ed3ffea3"} {"question" "q-253877" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/activity-metadata.json" "file_sha256" "4ea4643011baa08ce614f164a25cebc94985e23735a38af1c21837f9d01af7d1"} {"question" "q-253877" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/state.json" "file_sha256" "76111f53c72140f59c241c3f717c2a7d4fe7e3279c7037bd23160a68ed3ffea3"} {"question" "q-253877" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "16"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/state.json" "file_sha256" "76111f53c72140f59c241c3f717c2a7d4fe7e3279c7037bd23160a68ed3ffea3"} {"question" "q-253877" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/state.json" "file_sha256" "76111f53c72140f59c241c3f717c2a7d4fe7e3279c7037bd23160a68ed3ffea3"} {"question" "q-253877" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "32"