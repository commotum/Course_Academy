3c72140f59c241c3f717c2a7d4fe7e3279c7037bd23160a68ed3ffea3"} {"question" "q-253421" "field" "field-6" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/state.json" "file_sha256" "76111f53c72140f59c241c3f717c2a7d4fe7e3279c7037bd23160a68ed3ffea3"} {"question" "q-253400" "field" nil "attribute" "question/problem" "value" "Let ${J}_{n}(\\lambda )$ denote an $n\\times n$ Jordan block with $\\lambda $ on the main diagonal. Fill in the missing entries in the matrix below.\n\n|  |  | {{field-1}} | $-3$ | $0$ | {{field-2}} |  |\n| --- | --- | --- | --- | --- | --- | --- |\n| $\\operatorname{cos}⁡(3{J}_{4}(\\frac{\\pi }{6}))=\\,\\,$ |  | $0$ | $0$ | {{field-3}} | $0$ |  |\n|  | $0$ | $0$ | $0$ | $-3$ |  |  |\n|  |  | $0$ | $0$ | $0$ | {{field-4}} |  |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/state.json" "file_sha256" "76111f53c72140f59c241c3f717c2a7d4fe7e3279c7037bd23160a68ed3ffea3"} {"question" "q-253400" "field" nil "attribute" "question/worked-solution" "value" "Given a function $f$ and a Jordan block ${J}_{n}(\\lambda ),$ we have\n\n$$\nf({J}_{n}(\\lambda ))=[\\begin{aligned}f(\\lambda ) & {f}^{′}(\\lambda ) & \\frac{{f}^{″}(\\lambda )}{2!} & ⋯ & \\frac{{f}^{(n-1)}(\\lambda )}{(n-1)!} \\\\ 0 & f(\\lambda ) & {f}^{′}(\\lambda ) & ⋯ & \\frac{{f}^{(n-2)}(\\lambda )}{(n-2)!} \\\\ ⋮ & ⋱ & ⋱ & ⋱ & ⋮ \\\\ 0 & ⋯ & 0 & f(\\lambda ) & {f}^{′}(\\lambda ) \\\\ 0 & ⋯ & ⋯ & 0 & f(\\lambda )\\end{aligned}].\n$$\n\nIn this case, we have $f(x)=\\operatorname{cos}⁡3x,$ $n=4,$ and $\\lambda =\\frac{\\pi }{6}.$\n\nSince $n=4,$ we need to compute the first $4-1=3$ derivatives of $f:$\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{cos}⁡(3x) \\\\ {f}^{′}(x) & =-3\\operatorname{sin}⁡(3x) \\\\ {f}^{″}(x) & =-9\\operatorname{cos}⁡(3x) \\\\ {f}^{‴}(x) & =27\\operatorname{sin}⁡(3x)\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f({J}_{4}(\\frac{\\pi }{6})) & =[\\begin{aligned}f(\\frac{\\pi }{6}) & {f}^{′}(\\frac{\\pi }{6}) & \\frac{1}{2!}{f}^{″}(\\frac{\\pi }{6}) & \\frac{1}{3!}{f}^{‴}(\\frac{\\pi }{6}) \\\\ 0 & f(\\frac{\\pi }{6}) & {f}^{′}(\\frac{\\pi }{6}) & \\frac{1}{2!}{f}^{″}(\\frac{\\pi }{6}) \\\\ 0 & 0 & f(\\frac{\\pi }{6}) & {f}^{′}(\\frac{\\pi }{6}) \\\\ 0 & 0 & 0 & f(\\frac{\\pi }{6})\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{cos}⁡(\\frac{\\pi }{2}) & -3\\operatorname{sin}⁡(\\frac{\\pi }{2}) & -\\frac{9}{2}\\operatorname{cos}⁡(\\frac{\\pi }{2}) & \\frac{9}{2}\\operatorname{sin}⁡(\\frac{\\pi }{2})\\text{ } \\\\ 0 & \\operatorname{cos}⁡(\\frac{\\pi }{2}) & -3\\operatorname{sin}⁡(\\frac{\\pi }{2}) & -\\frac{9}{2}\\operatorname{cos}⁡(\\frac{\\pi }{2}) \\\\ 0 & 0 & \\operatorname{cos}⁡(\\frac{\\pi }{2}) & -3\\operatorname{sin}⁡(\\frac{\\pi }{2}) \\\\ 0 & 0 & 0 & \\operatorname{cos}⁡(\\frac{\\pi }{2})\\end{aligned}] \\\\  & =[\\begin{aligned}0 & -3 & 0 & \\frac{9}{2} \\\\ 0 & 0 & -3 & 0 \\\\ 0 & 0 & 0 & -3 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/state.json" "file_sha256" "76111f53c72140f59c241c3f717c2a7d4fe7e3279c7037bd23160a68ed3ffea3"} {"question" "q-253400" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/activity-metadata.json" "file_sha256" "4ea4643011baa08ce614f164a25cebc94985e23735a38af1c21837f9d01af7d1"} {"question" "q-253400" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072904/state.json" "file_sha256" "76111f53c7214