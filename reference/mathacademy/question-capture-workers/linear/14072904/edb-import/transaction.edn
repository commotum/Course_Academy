b6baa512eab" :answer/id #uuid "acb0b110-c093-5a90-9966-a022078e05ed" :answer/type :answer.type/math :answer/value "27" :db/ensure [:answer/validate]} {:db/id "q-253712/field-4" :answer-field/id #uuid "896b99b6-5207-56d1-8b56-e545ed8107a1" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-253712/field-4/c9ec5d6cdf4e67c7f8bce68475bed400e56bf403f3d09b5928f78b6baa512eab" :answer-field/choices ["q-253712/field-4/c9ec5d6cdf4e67c7f8bce68475bed400e56bf403f3d09b5928f78b6baa512eab"] :db/ensure [:answer-field/validate]} {:db/id "q-253712" :question/id #uuid "050598da-85d2-5e2a-a713-ba0c50acc8ec" :question/math-academy-id "q-253712" :question/problem "Let ${J}_{n}(\\lambda )$ denotes the $n\\times n$ Jordan block matrix with $\\lambda $ on the main diagonal. Fill in the missing entries in the matrix below.\n\n|  |  | $8$ | {{field-1}} | $0$ | {{field-2}} |  |\n| --- | --- | --- | --- | --- | --- | --- |\n| ${({J}_{2}(2)\\,⊕\\,{J}_{2}(3))}^{3}=\\,\\,$ |  | $0$ | $8$ | {{field-3}} | $0$ |  |\n|  | $0$ | $0$ | $27$ | {{field-4}} |  |  |\n|  |  | $0$ | $0$ | $0$ | $27$ |  |" :question/worked-solution "Given a function $f$ and a Jordan block ${J}_{n}(\\lambda ),$ we have\n\n$$\nf({J}_{n}(\\lambda ))=[\\begin{aligned}f(\\lambda ) & {f}^{′}(\\lambda ) & \\frac{{f}^{″}(\\lambda )}{2!} & ⋯ & \\frac{{f}^{(n-1)}(\\lambda )}{(n-1)!} \\\\ 0 & f(\\lambda ) & {f}^{′}(\\lambda ) & ⋯ & \\frac{{f}^{(n-2)}(\\lambda )}{(n-2)!} \\\\ ⋮ & ⋱ & ⋱ & ⋱ & ⋮ \\\\ 0 & ⋯ & 0 & f(\\lambda ) & {f}^{′}(\\lambda ) \\\\ 0 & ⋯ & ⋯ & 0 & f(\\lambda )\\end{aligned}].\n$$\n\nFirst, note that\n\n$$\n\\begin{aligned}({J}_{2}(2)\\,⊕\\,{J}_{2}(3))^{3} & ={([\\begin{aligned}{J}_{2}(2) & 0 \\\\ 0 & {J}_{2}(3)\\end{aligned}])}^{3} \\\\  & =[\\begin{aligned}({J}_{2}(2))^{3} & 0 \\\\ 0 & ({J}_{2}(3))^{3}\\end{aligned}] \\\\  & =({J}_{2}(2))^{3}\\,⊕\\,({J}_{2}(3))^{3}.\\end{aligned}\n$$\n\nSo, we compute the function of each Jordan block separately.\n\n- For ${J}_{2}(2),$ we have $n=2$ and $\\lambda =2.$ Since $n=2,$ we need to compute the first derivative of $f$ only:\n\n$$\n\\begin{aligned}f(x) & ={x}^{3} \\\\ {f}^{′}(x) & =3{x}^{2}\\end{aligned}\n$$\n\nSo, we get\n\n$$\n\\begin{aligned}f({J}_{2}(2)) & =[\\begin{aligned}f(2) & {f}^{′}(2) \\\\ 0 & f(2)\\end{aligned}] \\\\  & =[\\begin{aligned}{2}^{3} & 3\\cdot {2}^{2} \\\\ 0 & {2}^{3}\\end{aligned}] \\\\  & =[\\begin{aligned}8 & 12 \\\\ 0 & 8\\end{aligned}].\\end{aligned}\n$$\n\n- For ${J}_{2}(3),$ we have $n=2$ and $\\lambda =3.$ Since $n=2,$ we need the first derivative of $f$ only, which we have already computed. So, we get\n\n$$\n\\begin{aligned}f({J}_{2}(3)) & =[\\begin{aligned}f(3) & {f}^{′}(3) \\\\ 0 & f(3)\\end{aligned}] \\\\  & =[\\begin{aligned}{3}^{3} & 3\\cdot {3}^{2} \\\\ 0 & {3}^{3}\\end{aligned}] \\\\  & =[\\begin{aligned}27 & 27 \\\\ 0 & 27\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n({J}_{2}(2)\\,⊕\\,{J}_{2}(3))^{3}=({J}_{2}(2))^{3}\\,⊕\\,({J}_{2}(3))^{3}=[\\begin{aligned}8 & 12 & 0 & 0 \\\\ 0 & 8 & 0 & 0 \\\\ 0 & 0 & 27 & 27 \\\\ 0 & 0 & 0 & 27\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-253712/field-1" "q-253712/field-2" "q-253712/field-3" "q-253712/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "87883002-67eb-5111-b15a-c5941bb33f9b"] :knowledge-point/questions ["q-253712"] :db/ensure [:knowledge-point/validate]} {:db/id "q-252926/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "aea7e64c-97b2-5e93-a380-b2c3fd7746b9" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id 17592186154663 :answer-field/correct "q-252926/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-252926/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-252926/field-2/d971375f57c56d8a55a09f2b892e