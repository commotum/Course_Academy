53229/field-4/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer-field/choices ["q-253229/field-4/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e"] :db/ensure [:answer-field/validate]} {:db/id "q-253229" :question/id #uuid "84b20485-57d6-58b7-a0fc-1d29fa1f584f" :question/math-academy-id "q-253229" :question/problem "Given that\n$D=[\\begin{aligned}3 & 0 \\\\ 0 & -2\\end{aligned}],$\nfind ${2}^{D}.$\n\n| ${2}^{D}=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |" :question/worked-solution "Given a function $f$ and a diagonal matrix $D$ with diagonal entries ${\\lambda }_{1},…,{\\lambda }_{n},$ we have\n\n$$\nf(D)=[\\begin{aligned}f({\\lambda }_{1}) & ⋯ & 0 \\\\ ⋮ & ⋱ & ⋮ \\\\ 0 & ⋯ & f({\\lambda }_{n})\\end{aligned}].\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{2}^{D} & =[\\begin{aligned}{2}^{3} & 0 \\\\ 0 & {2}^{-2}\\end{aligned}]=[\\begin{aligned}8 & 0 \\\\ 0 & \\frac{1}{4}\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-253229/field-1" "q-253229/field-2" "q-253229/field-3" "q-253229/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "343f8efc-fdef-51dc-ad3f-fad1ab37bc88"] :knowledge-point/questions ["q-253229"] :db/ensure [:knowledge-point/validate]} {:db/id "q-253372/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "c8bac48d-6ed3-5bd3-abe3-f830ffec9db9" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-253372/field-1" :answer-field/id #uuid "32e47597-120b-517a-8165-983c4e836f3a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-253372/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-253372/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-fie