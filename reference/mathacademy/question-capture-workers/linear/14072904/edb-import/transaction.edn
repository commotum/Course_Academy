a-caac-5803-a7ac-b37bc6f943e1" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-253400/field-4" :answer-field/id #uuid "41efa50a-860f-5487-8761-c4524c9b3c96" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-253400/field-4/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-253400/field-4/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-253400" :question/id #uuid "5c95d823-6d07-5f58-aea5-f1021bae6636" :question/math-academy-id "q-253400" :question/problem "Let ${J}_{n}(\\lambda )$ denote an $n\\times n$ Jordan block with $\\lambda $ on the main diagonal. Fill in the missing entries in the matrix below.\n\n|  |  | {{field-1}} | $-3$ | $0$ | {{field-2}} |  |\n| --- | --- | --- | --- | --- | --- | --- |\n| $\\operatorname{cos}⁡(3{J}_{4}(\\frac{\\pi }{6}))=\\,\\,$ |  | $0$ | $0$ | {{field-3}} | $0$ |  |\n|  | $0$ | $0$ | $0$ | $-3$ |  |  |\n|  |  | $0$ | $0$ | $0$ | {{field-4}} |  |" :question/worked-solution "Given a function $f$ and a Jordan block ${J}_{n}(\\lambda ),$ we have\n\n$$\nf({J}_{n}(\\lambda ))=[\\begin{aligned}f(\\lambda ) & {f}^{′}(\\lambda ) & \\frac{{f}^{″}(\\lambda )}{2!} & ⋯ & \\frac{{f}^{(n-1)}(\\lambda )}{(n-1)!} \\\\ 0 & f(\\lambda ) & {f}^{′}(\\lambda ) & ⋯ & \\frac{{f}^{(n-2)}(\\lambda )}{(n-2)!} \\\\ ⋮ & ⋱ & ⋱ & ⋱ & ⋮ \\\\ 0 & ⋯ & 0 & f(\\lambda ) & {f}^{′}(\\lambda ) \\\\ 0 & ⋯ & ⋯ & 0 & f(\\lambda )\\end{aligned}].\n$$\n\nIn this case, we have $f(x)=\\operatorname{cos}⁡3x,$ $n=4,$ and $\\lambda =\\frac{\\pi }{6}.$\n\nSince $n=4,$ we need to compute the first $4-1=3$ derivatives of $f:$\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{cos}⁡(3x) \\\\ {f}^{′}(x) & =-3\\operatorname{sin}⁡(3x) \\\\ {f}^{″}(x) & =-9\\operatorname{cos}⁡(3x) \\\\ {f}^{‴}(x) & =27\\operatorname{sin}⁡(3x)\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f({J}_{4}(\\frac{\\pi }{6})) & =[\\begin{aligned}f(\\frac{\\pi }{6}) & {f}^{′}(\\frac{\\pi }{6}) & \\frac{1}{2!}{f}^{″}(\\frac{\\pi }{6}) & \\frac{1}{3!}{f}^{‴}(\\frac{\\pi }{6}) \\\\ 0 & f(\\frac{\\pi }{6}) & {f}^{′}(\\frac{\\pi }{6}) & \\frac{1}{2!}{f}^{″}(\\frac{\\pi }{6}) \\\\ 0 & 0 & f(\\frac{\\pi }{6}) & {f}^{′}(\\frac{\\pi }{6}) \\\\ 0 & 0 & 0 & f(\\frac{\\pi }{6})\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{cos}⁡(\\frac{\\pi }{2}) & -3\\operatorname{sin}⁡(\\frac{\\pi }{2}) & -\\frac{9}{2}\\operatorname{cos}⁡(\\frac{\\pi }{2}) & \\frac{9}{2}\\operatorname{sin}⁡(\\frac{\\pi }{2})\\text{ } \\\\ 0 & \\operatorname{cos}⁡(\\frac{\\pi }{2}) & -3\\operatorname{sin}⁡(\\frac{\\pi }{2}) & -\\frac{9}{2}\\operatorname{cos}⁡(\\frac{\\pi }{2}) \\\\ 0 & 0 & \\operatorname{cos}⁡(\\frac{\\pi }{2}) & -3\\operatorname{sin}⁡(\\frac{\\pi }{2}) \\\\ 0 & 0 & 0 & \\operatorname{cos}⁡(\\frac{\\pi }{2})\\end{aligned}] \\\\  & =[\\begin{aligned}0 & -3 & 0 & \\frac{9}{2} \\\\ 0 & 0 & -3 & 0 \\\\ 0 & 0 & 0 & -3 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-253400/field-1" "q-253400/field-2" "q-253400/field-3" "q-253400/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8ce12d6f-8d1c-52f3-992f-534b9d91dda9"] :knowledge-point/questions ["q-253400"] :db/ensure [:knowledge-point/validate]} {:db/id "q-253311/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "9f120c36-e79b-57a4-8a7e-0acfc80abc66" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-253311/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "e871d283-bbcc-5c65-8fd2-eac291bc4598" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id 17592186154677 :answer-field/correct "q-253311/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices 