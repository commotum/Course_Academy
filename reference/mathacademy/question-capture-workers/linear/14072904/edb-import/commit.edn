n}⁡x \\\\ {f}^{‴}(x) & =-\\operatorname{cos}⁡x\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f({J}_{4}(\\frac{\\pi }{6})) & =[\\begin{aligned}f(\\frac{\\pi }{6}) & {f}^{′}(\\frac{\\pi }{6}) & \\frac{1}{2!}{f}^{″}(\\frac{\\pi }{6}) & \\frac{1}{3!}{f}^{‴}(\\frac{\\pi }{6}) \\\\ 0 & f(\\frac{\\pi }{6}) & {f}^{′}(\\frac{\\pi }{6}) & \\frac{1}{2!}{f}^{″}(\\frac{\\pi }{6}) \\\\ 0 & 0 & f(\\frac{\\pi }{6}) & {f}^{′}(\\frac{\\pi }{6}) \\\\ 0 & 0 & 0 & f(\\frac{\\pi }{6})\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{sin}⁡(\\frac{\\pi }{6}) & \\operatorname{cos}⁡(\\frac{\\pi }{6}) & -\\frac{1}{2}\\operatorname{sin}⁡(\\frac{\\pi }{6}) & -\\frac{1}{6}\\operatorname{cos}⁡(\\frac{\\pi }{6}) \\\\ 0 & \\operatorname{sin}⁡(\\frac{\\pi }{6}) & \\operatorname{cos}⁡(\\frac{\\pi }{6}) & -\\frac{1}{2}\\operatorname{sin}⁡(\\frac{\\pi }{6}) \\\\ 0 & 0 & \\operatorname{sin}⁡(\\frac{\\pi }{6}) & \\operatorname{cos}⁡(\\frac{\\pi }{6}) \\\\ 0 & 0 & 0 & \\operatorname{sin}⁡(\\frac{\\pi }{6})\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{2} & \\frac{\\sqrt{3}}{2} & -\\frac{1}{4} & -\\frac{\\sqrt{3}}{12} \\\\ 0 & \\frac{1}{2} & \\frac{\\sqrt{3}}{2} & -\\frac{1}{4} \\\\ 0 & 0 & \\frac{1}{2} & \\frac{\\sqrt{3}}{2} \\\\ 0 & 0 & 0 & \\frac{1}{2}\\end{aligned}] \\\\  & =\\frac{1}{12}[\\begin{aligned}6 & 6\\sqrt{3} & -3 & -\\sqrt{3} \\\\ 0 & 6 & 6\\sqrt{3} & -3 \\\\ 0 & 0 & 6 & 6\\sqrt{3} \\\\ 0 & 0 & 0 & 6\\end{aligned}].\\end{aligned}\n$$" 13194139535978 true] [17592186157636 1091 #edb/ref 17592186045465 13194139535978 true] [17592186157636 1100 "Let $J_{n}(λ)$ denotes the $n \\cdot n$ Jordan block matrix with $λ$ on the main diagonal. Fill in the missing entries in the matrix below.\n\n|  |  | $0$ | {{field-1}} | $0$ | {{field-2}} |  |\n| --- | ---: | ---: | ---: | ---: | ---: | ---: |\n| $\\ln (J_{2}(1)⊕J_{2}(e)) =$ |  | $0$ | $0$ | {{field-3}} | $0$ |  |\n|  | $0$ | $0$ | $1$ | {{field-4}} |  |  |\n|  |  | $0$ | $0$ | $0$ | $1$ |  |\n\n---\n\n<a id=\"function-of-a-