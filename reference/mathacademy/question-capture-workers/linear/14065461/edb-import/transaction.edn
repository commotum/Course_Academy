iculty/easy :question/answer-fields ["q-113115/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6b973d79-8fe4-5033-8202-9693004855dc"] :knowledge-point/questions ["q-113115"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113415/selection/5a043bdc7db08816b1c448db0440fd826f9a633570da88ac86775117a8526f9e" :answer/id #uuid "3e6483c3-e0e8-592f-a34e-191d53848575" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 & -3 \\\\ 4 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-113415/selection/51c6eb71e5b4f4cba31f2c2ba8ae0afd0ab34aa658d04beea15b46d05eabe375" :answer/id #uuid "cce9b22f-175a-57f1-8af8-ee78aaf3aa90" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 & -2 \\\\ 4 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-113415/selection/fad2e1bea558813f45d003583d5fbe09c671873fd4e140e746d005de6bd8843d" :answer/id #uuid "fe73a328-ba75-50af-bfc7-d2a1c316554b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & 2 \\\\ 4 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-113415/selection/ceb0aed3605288ea1c2ac475eab75833075a7d8daf9e9515b92387c0d2691d5b" :answer/id #uuid "e8cb5716-4a78-51d2-beb3-8bb19d997f5c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-4 & -2 \\\\ 2 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-113415/selection/f9f87d5b74fe29138dc6a6fca830008615e22cec8e246e0b05ec8e18552b8970" :answer/id #uuid "c6c17bfa-436b-5b8b-8793-fa177772d04b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-4 & -3 \\\\ 2 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-113415/selection" :answer-field/id #uuid "8ec966db-c745-58d3-8168-70967cb0a812" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113415/selection/51c6eb71e5b4f4cba31f2c2ba8ae0afd0ab34aa658d04beea15b46d05eabe375" :answer-field/choices ["q-113415/selection/5a043bdc7db08816b1c448db0440fd826f9a633570da88ac86775117a8526f9e" "q-113415/selection/51c6eb71e5b4f4cba31f2c2ba8ae0afd0ab34aa658d04beea15b46d05eabe375" "q-113415/selection/fad2e1bea558813f45d003583d5fbe09c671873fd4e140e746d005de6bd8843d" "q-113415/selection/ceb0aed3605288ea1c2ac475eab75833075a7d8daf9e9515b92387c0d2691d5b" "q-113415/selection/f9f87d5b74fe29138dc6a6fca830008615e22cec8e246e0b05ec8e18552b8970"] :db/ensure [:answer-field/validate]} {:db/id "q-113415" :question/id #uuid "0e492abb-150e-5b29-ab40-6db339f73d6b" :question/math-academy-id "q-113415" :question/problem "The change-of-coordinates matrix from the basis $B$ to the basis $C$ is given by \n${P}_{B\\to C}=[\\begin{aligned}\\frac{3}{2} & 1 \\\\ -2 & -1\\end{aligned}].$\nFind the change-of-coordinates matrix from $C$ to $B$  ." :question/worked-solution "The change-of-coordinates matrix from $C$ to $B$ is the inverse of the change-of-coordinates matrix from $B$ to $C.$ Therefore, we simply need to find the inverse of the given matrix.\n\nComputing the inverse of ${P}_{B\\to C}$, we get\n\n$$\n\\begin{aligned}{P}_{C\\to B} & ={P}_{B\\to C}^{-1} \\\\  & ={[\\begin{aligned}\\frac{3}{2} & 1 \\\\ -2 & -1\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{\\frac{3}{2}\\cdot (-1)-1\\cdot (-2)}[\\begin{aligned}-1 & -1 \\\\ 2 & \\frac{3}{2}\\end{aligned}] \\\\  & =2\\cdot [\\begin{aligned}-1 & -1 \\\\ 2 & \\frac{3}{2}\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -2 \\\\ 4 & 3\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-113415/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "23b6a85e-e1de-590c-84d2-379052b1b9f3"] :knowledge-point/questions ["q-113415"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-35799"] :question/problem "The change-of-coordinates matrix from the basis $C$ to the basis $B$ is given by\n${P}_{C\\to B}=[\\begin{aligned}5 & 7 \\\\ -3 & -4\\end{aligned}].$ Find the change-of-coordinates matrix from $B$ to $C$  ." :question/worked-solution "The change-of-coordinates matrix from $B$ to $C$ is the inverse of the change-of-coordinates matrix from $C$ to $B.$ Therefore, we simply need to find the inverse of the given matrix.\n\nComputing the inverse of ${P}_{C\\to B}$, we get\n\n$$\n\\begin{aligned}{P}_{B\\to C} & ={P}_{C\\to B}^{-1} \\\\  & ={[\\begin{aligned}5 & 7 \\\\ -3 & -4\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{5\\cdot (-4)-7\\cdot (-3)}[\\begin{aligned}-4 & -7 \\\\ 3 & 5\\end{aligned}] \\\\  & =1\\cdot [\\begin{aligned}-4 & -7 \\\\ 3 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}-4 & -7 \\\\ 3 & 5\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-81859/selection/4c66b9ebf0e0c7a93d2f2e312b1fb9c5b70f0529716ce30c2ac091b85ed0ffc5" :answer/id #uuid "606c4c35-7a79-5725-a5b9-4c3b21af8d0f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{5}{3} & -\\frac{2}{3} \\\\ 3 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81859/selection/21b19a5caf817b3be03991ec1d738a1b3503d10e3cd478bbe4012dad99241964" :answer/id #uuid "6784958c-6ac6-560a-823f-0ee0dbea6d96" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{5}{3} & \\frac{2}{3} \\\\ -3 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81859/selection/120cb735edb3a928927970b6626614099c06580b4a2cbf5de71a3e063bf86344" :answer/id #uuid "821a47fe-2241-5663-abdf-44737bb0b741" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 \\\\ -\\frac{2}{3} & -\\frac{5}{3}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81859/selection/d18e1df593a9473b0fd6f87305de4b356d6ee91720ec1af2e87adb6104371120" :answer/id #uuid "e10afd59-ca25-51d6-9643-40fa5e0969e6" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 & -\\frac{2}{3} \\\\ 3 & \\frac{5}{3}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81859/selection/0789f628d0b8a7631e17515dec69556a6bea727bf54d048ce3e4c025a8a6787b" :answer/id #uuid "8dc626ae-1bb3-5139-9bd2-751e53c31c90" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 & \\frac{2}{3} \\\\ -3 & \\frac{5}{3}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81859/selection" :answer-field/id #uuid "6605da92-18e2-5173-abef-1b3a400a78f8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81859/selection/d18e1df593a9473b0fd6f87305de4b356d6ee91720ec1af2e87adb6104371120" :answer-field/choices ["q-81859/selection/4c66b9ebf0e0c7a93d2f2e312b1fb9c5b70f0529716ce30c2ac091b85ed0ffc5" "q-81859/selection/21b19a5caf817b3be03991ec1d738a1b3503d10e3cd478bbe4012dad99241964" "q-81859/selection/120cb735edb3a928927970b6626614099c06580b4a2cbf5de71a3e063bf86344" "q-81859/selection/d18e1df593a9473b0fd6f87305de4b356d6ee91720ec1af2e87adb6104371120" "q-81859/selection/0789f628d0b8a7631e17515dec69556a6bea727bf54d048ce3e4c025a8a6787b"] :db/ensure [:answer-field/validate]} {:db/id "q-81859" :question/id #uuid "a27a3c1e-ad3c-56e4-aa1a-d2aedbc7058d" :question/math-academy-id "q-81859" :question/problem "The change-of-coordinates matrix from the basis $C$ to the basis $B$ is given by\n${P}_{C\\to B}=[\\begin{aligned}5 & 2 \\\\ -9 & -3\\end{aligned}].$ Find the change-of-coordinates matrix from $B$ to $C$  ." :question/worked-solution "The change-of-coordinates matrix from $B$ to $C$ is the inverse of the change-of-coordinates matrix from $C$ to $B.$ Therefore, we simply need to find the inverse of the given matrix.\n\nComputing the inverse of ${P}_{C\\to B}$, we get\n\n$$\n\\begin{aligned}{P}_{B\\to C} & ={P}_{C\\to B}^{-1} \\\\  & ={[\\begin{aligned}5 & 2 \\\\ -9 & -3\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{5\\cdot (-3)-2\\cdot (-9)}[\\begin{aligned}-3 & -2 \\\\ 9 & 5\\end{aligned}] \\\\  & =\\frac{1}{3}\\cdot [\\begin{aligned}-3 & -2 \\\\ 9 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & -\\frac{2}{3} \\\\ 3 & \\frac{5}{3}\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-81859/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "23b6a85e-e1de-590c-84d2-379052b1b9f3"] :knowledge-point/questions ["q-81859"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81856/selection/fc4d005fc8e5c4c968bfe8f309fc3eab4a8b141180df9ba3751c187a530f298c" :answer/id #uuid "98f47a94-3132-59b4-a324-02655d9b23cf" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-7 & 3 \\\\ 5 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81856/selection/77f71a7ac14cc530c5be470667e54a3fa09eebcab664ebc4153aaa4b8d441361" :answer/id #uuid "132af5d6-6d6d-5cf4-9bf9-b85df2ddfb14" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-7 & 5 \\\\ 3 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81856/selection/3c9f82e9df6d3eafc7e4e9877bd217eeeaacd9f8fe6cde854c1f75645bcaab49" :answer/id #uuid "81b9ab77-0001-5089-aec4-a85f211cf78c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}7 & -3 \\\\ -5 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81856/selection/e8e6905582523d7538c9a25e30719483567c77df5d6a2dd27c57b4bfc8f0d809" :answer/id #uuid "6413f290-5947-5976-8302-4d1e7f480cab" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 & 3 \\\\ 5 & -7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81856/selection/84429febc7f3a4f8a6106e2f88787e523cb2335045b9d62de34c96c794ec77b2" :answer/id #uuid "fb847658-a4a1-57ff-b9b1-05e4283c0304" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 & 5 \\\\ 3 & -7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81856/selection" :answer-field/id #uuid "d74aef95-23c7-561a-91b7-d26a9642e6aa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81856/selection/fc4d005fc8e5c4c968bfe8f309fc3eab4a8b141180df9ba3751c187a530f298c" :answer-field/choices ["q-81856/selection/fc4d005fc8e5c4c968bfe8f309fc3eab4a8b141180df9ba3751c