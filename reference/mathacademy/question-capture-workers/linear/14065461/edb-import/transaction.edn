ction" :answer-field/type :answer-field.type/radio :answer-field/correct "q-36400/selection/ma-v1/a3efde93e323d116458fb0df1f081f9e2a0b20a87df89cf473b51ee6d0aeeb3e/045cec72ae63d5d216c089186620936843a1106b061b920f02781b8d23043d5f" :answer-field/choices ["q-36400/selection/ma-v1/a3efde93e323d116458fb0df1f081f9e2a0b20a87df89cf473b51ee6d0aeeb3e/67335a9b2baa5f4021b209acf40ab41df6d017a45dbd3f767f716ec0a2d69637" "q-36400/selection/ma-v1/a3efde93e323d116458fb0df1f081f9e2a0b20a87df89cf473b51ee6d0aeeb3e/2593d102e6a6e6d08566b8c00911542778c3bb9ee601cac4cb876d7bfa96d5a2" "q-36400/selection/ma-v1/a3efde93e323d116458fb0df1f081f9e2a0b20a87df89cf473b51ee6d0aeeb3e/af2adc722ac5419a55a0c9a6772fab125226d16c7840b635f21b380f9eb122bf" "q-36400/selection/ma-v1/a3efde93e323d116458fb0df1f081f9e2a0b20a87df89cf473b51ee6d0aeeb3e/e7378c1e71ad61ca19077f884d9d8bda0d9e5aff001a56ee9e155069db846c43" "q-36400/selection/ma-v1/a3efde93e323d116458fb0df1f081f9e2a0b20a87df89cf473b51ee6d0aeeb3e/045cec72ae63d5d216c089186620936843a1106b061b920f02781b8d23043d5f"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-36400"] :question/problem "Let $B={{b}_{1},{b}_{2},{b}_{3}}$ be a basis of ${R}^{3}$ and let $S$ be the standard basis of ${R}^{3}.$ What are the values of $a,b,$ and $c$ if \n\n$$\n{b}_{1}=[\\begin{aligned}-3 \\\\ 4 \\\\ 0\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}-5 \\\\ -1 \\\\ 0\\end{aligned}],\\,{b}_{3}=[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}],\n$$\n\nand the change-of-coordinates matrix from $B$ to $S$ is \n\n$$\n{P}_{B\\to S}=[\\begin{aligned}a & -5 & 0 \\\\ 4 & b & 0 \\\\ 0 & 0 & c\\end{aligned}].\n$$" :question/worked-solution "Recall  that the standard basis of ${R}^{3}$ consists of the vectors ${e}_{1},{e}_{2},$ and ${e}_{3},$ given by\n\n$$\n{e}_{1}=[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}],\\,{e}_{2}=[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}],\\,{e}_{3}=[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}].\n$$\n\nThe components of the vectors in $B$ are just the coordinates relative to the standard basis:\n\n$$\n[{b}_{1}]_{S}=[\\begin{aligned}-3 \\\\ 4 \\\\ 0\\end{aligned}],\\,[{b}_{2}]_{S}=[\\begin{aligned}-5 \\\\ -1 \\\\ 0\\end{aligned}],\\,[{b}_{3}]_{S}=[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]\n$$\n\nThe change-of-coordinates matrix from $B$ to $S$ is a matrix whose respective columns are the coordinates of the vectors of $B$ relative to the basis $S.$ \n\nTherefore, we obtain\n\n$$\n{P}_{B\\to S}=[\\begin{aligned}-3 & -5 & 0 \\\\ 4 & -1 & 0 \\\\ 0 & 0 & 1\\end{aligned}].\n$$\n\nFinally, $a=-3,$ $b=-1,$ and $c=1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-36400/selection/ma-v1/a3efde93e323d116458fb0df1f081f9e2a0b20a87df89cf473b51ee6d0aeeb3e"] :db/ensure [:question/validate]} {:db/id "q-81848/selection/0a522e9e0b37a75b331a938ff548f4c67c0c575d9b5d8bfa3ef8262169fe773e" :answer/id #uuid "6cdee27f-9ce7-5f65-9310-00235c8fcbfd" :answer/type :answer.type/text :answer/value "$a=7,$ $b=0,$ and $c=0$" :db/ensure [:answer/validate]} {:db/id "q-81848/selection/318973c54e704faa759030582698eedf827205788bc17431d75da9cf3a3884b6" :answer/id #uuid "f20bc0fc-dae5-5839-aa1f-0095d12ea376" :answer/type :answer.type/text :answer/value "$a=0,$ $b=7,$ and $c=0$" :db/ensure [:answer/validate]} {:db/id "q-81848/selection/56b8672f64fce304c606ac89662d67a9a4da4e2dec0a8a5dfaf01eb02b2e6548" :answer/id #uuid "0a50abd6-68bc-5a72-ae10-d9c84f5e9dfa" :answer/type :answer.type/text :answer/value "$a=1,$ $b=-2,$ and $c=0$" :db/ensure [:answer/validate]} {:db/id "q-81848/selection/5bcae99892fc99050208cd3e5271a3b5fcea4b299ab70ef8e25dfdfa4dd5d34d" :answer/id #uuid "de6422b9-fb6e-50a4-962f-67a0961cfc43" :answer/type :answer.type/text :answer/value "$a=0,$ $b=3,$ and $c=-3$" :db/ensure [:answer/validate]} {:db/id "q-81848/selection/5a1272d64ec10e8e7f4124d62098993a9cf008e4c0a907b4ba7dd7f1c2b6a2a1" :answer/id #uuid "1eec352b-5f82-5d59-9239-abfc9b93e0bc" :answer/type :answer.type/text :answer/value "$a=7,$ $b=0,$ 