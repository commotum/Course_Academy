#{[{:db/id #edb/ref 17592186087928 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a48fa181-4b87-58a5-8982-f7bd1543ffbb" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186084580} {:answer/id #uuid "b2bfd71d-be6a-5213-b584-494fc8d57128" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186084581} {:answer/id #uuid "dff8ce25-a4b5-5ebd-8746-1198b79cbdc6" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186084582} {:answer/id #uuid "fb605f8d-af27-5ebe-a9dc-17cebc5bec9b" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186084583} {:answer/id #uuid "359451d1-a627-5152-b123-4515b7d7b5af" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186084584}] :answer-field/correct {:answer/id #uuid "b2bfd71d-be6a-5213-b584-494fc8d57128" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186084581} :answer-field/id #uuid "f021e344-b1e5-51fb-adc9-8fe7c497cc1c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186084579}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "dd3fba16-5fcc-50bc-8866-44ee67a3b9b6" :question/math-academy-id "q-11718" :question/problem "Which of the matrices below are singular?\n\n$$\nA=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}],\\,B=[\\begin{aligned}1 \\\\ 1 \\\\ -2\\end{aligned}],\\,C=[\\begin{aligned}1 & 0 \\\\ 0 & 0\\end{aligned}].\n$$" :question/worked-solution "- For the matrix $A$, we have\n\n$$\ndet(A)=0\\cdot 0-1\\cdot 1=-1.\n$$\n\nBecause $det(A)\\ne 0,$ we conclude that $A$ is invertible.\n\n- The matrix $B$ is a $3\\times 1$ matrix. So, it is not invertible. Since the matrix is not square, we can't say that it's singular.\n\n- For the matrix $C$, we have\n\n$$\ndet(C)=1\\cdot 0-0\\cdot 1=0.\n$$\n\nBecause $det(C)=0,$ we conclude that $C$ is not invertible. Since $C$ is a square matrix that is not invertible, we also say that $C$ is singular.\n\nTherefore, only $C$ is singular."}] [{:db/id #edb/ref 17592186293818 :knowledge-point/_questions [{:knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01" :knowledge-point/title "Solving for a Variable in a Singular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b143ed6d-3f8a-5a5f-9b22-6a3acb7a18ab" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186293820} {:answer/id #uuid "b0d1eee9-040f-510d-b5a6-b707a05db1ec" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186293821}] :answer-field/correct {:answer/id #uuid "b0d1eee9-040f-510d-b5a6-b707a05db1ec" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186293821} :answer-field/id #uuid "88f236f3-feef-563d-a98b-ee60e0ff782a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186293819}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "0047a425-3434-51cf-8bea-b68dedd67cd7" :question/math-academy-id "q-316782" :question/problem "If $B=[\\begin{aligned}1 & 2 \\\\ 3x+2 & 2x-4\\end{aligned}]$\nis a singular matrix, calculate the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "The matrix $B$ is singular if and only if $det(B)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(B) & =1\\cdot (2x-4)-2\\cdot (3x+2) \\\\  & =2x-4-6x-4 \\\\  & =-4x-8.\\end{aligned}\n$$\n\nFinally, we set the determinant equal to $0$ and solve for $x:$\n\n$$\n\\begin{aligned}-4x-8 & =0 \\\\ -4x & =8 \\\\ x & =-2\\end{aligned}\n$$"}]}
