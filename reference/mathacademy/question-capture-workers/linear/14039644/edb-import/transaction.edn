[{:db/id "q-7945/selection/935aa158fd2c399ea2cda88ceb19dd30c987a40c650abf8e1a4e9380b623f35e" :answer/id #uuid "87726960-08eb-5e22-8d68-4164a69dd4ae" :answer/type :answer.type/math :answer/value "\\frac{1}{4}[\\begin{aligned}2 & 1 \\\\ 5 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-7945/selection/f4b0bde7e622028251a6c2ea276463a2b42cd9d9046540957de2b709a4c74920" :answer/id #uuid "60253841-cd5b-56d2-8a5e-e36b387ae31c" :answer/type :answer.type/math :answer/value "\\frac{1}{2}[\\begin{aligned}-2 & -1 \\\\ -5 & -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-7945/selection/6ad07af0457fe965772f75854675049c88ddf4f0d74046124b969a43c76b0fa9" :answer/id #uuid "389d33f3-75b5-554d-92be-f3684248830a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 & -1 \\\\ -5 & -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-7945/selection/3760ca40e03299ea9a0636e2b997169f0c9cd80c67acea57b5a54f16344e8bf4" :answer/id #uuid "3e5ae171-e8a9-56d9-a99a-92230b32232c" :answer/type :answer.type/math :answer/value "\\frac{1}{3}[\\begin{aligned}-2 & -1 \\\\ -5 & -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-7945/selection/62d16cbc11fc3f331992e0fa2dcd4fc77397b11a7322a01369670623a145c604" :answer/id #uuid "c99fb2ac-cd22-5185-a429-77e6d954c5bd" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & 1 \\\\ 5 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-7945/selection" :answer-field/id #uuid "dbc603e3-b802-563f-b582-3c52fbdf5764" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-7945/selection/6ad07af0457fe965772f75854675049c88ddf4f0d74046124b969a43c76b0fa9" :answer-field/choices ["q-7945/selection/935aa158fd2c399ea2cda88ceb19dd30c987a40c650abf8e1a4e9380b623f35e" "q-7945/selection/f4b0bde7e622028251a6c2ea276463a2b42cd9d9046540957de2b709a4c74920" "q-7945/selection/6ad07af0457fe965772f75854675049c88ddf4f0d74046124b969a43c76b0fa9" "q-7945/selection/3760ca40e03299ea9a0636e2b997169f0c9cd80c67acea57b5a54f16344e8bf4" "q-7945/selection/62d16cbc11fc3f331992e0fa2dcd4fc77397b11a7322a01369670623a145c604"] :db/ensure [:answer-field/validate]} {:db/id "q-7945" :question/id #uuid "e922303e-f1e5-5b8d-b2da-04cdac58e3ea" :question/math-academy-id "q-7945" :question/problem "Calculate ${Q}^{-1}$, where\n$Q=[\\begin{aligned}-3 & 1 \\\\ 5 & -2\\end{aligned}].$" :question/worked-solution "Given a $2\\times 2$ matrix\n\n$$\nQ=[\\begin{aligned}a & b \\\\ c & d\\end{aligned}],\n$$\n\nthe inverse of $Q$ can be found using the following formula:\n\n$$\n\\begin{aligned}{Q}^{-1} & =\\frac{1}{det(Q)}[\\begin{aligned}d & -b \\\\ -c & a\\end{aligned}].\\end{aligned}\n$$\n\nFirst, we compute the determinant:\n\n$$\ndet(Q)=(-3)\\cdot (-2)-5\\cdot 1=1\n$$\n\nUsing the formula, then, the inverse is given by\n\n$$\n\\begin{aligned}{Q}^{-1} & =\\frac{1}{det(Q)}[\\begin{aligned}d & -b \\\\ -c & a\\end{aligned}] \\\\  & =\\frac{1}{1}[\\begin{aligned}-2 & -1 \\\\ -5 & -3\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -1 \\\\ -5 & -3\\end{aligned}].\\end{aligned}\n$$\n\nWe can verify the result as follows:\n\n$$\n\\begin{aligned}Q{Q}^{-1} & =[\\begin{aligned}-3 & 1 \\\\ 5 & -2\\end{aligned}][\\begin{aligned}-2 & -1 \\\\ -5 & -3\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & ={I}_{2}\\,✓ \\\\ {Q}^{-1}Q & =[\\begin{aligned}-2 & -1 \\\\ -5 & -3\\end{aligned}][\\begin{aligned}-3 & 1 \\\\ 5 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & ={I}_{2}\\,✓\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-7945/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bea23649-e835-540a-b238-7b89ed330cd3"] :knowledge-point/questions ["q-7945"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316768/field-1/c7e2c99672184a6ffc5fe21255ac37862a4c27e4b225c7b645ba47d8f3c76eda" :answer/id #uuid "1358471d-c759-5287-a536-bdd080a221d4" :answer/type :answer.type/math :answer/value "\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "q-316768/field-1" :answer-field/id #uuid "4fb11755-d938-5d97-835a-f02b7c3d9428" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316768/field-1/c7e2c99672184a6ffc5fe21255ac37862a4c27e4b225c7b645ba47d8f3c76eda" :answer-field/choices ["q-316768/field-1/c7e2c99672184a6ffc5fe21255ac37862a4c27e4b225c7b645ba47d8f3c76eda"] :db/ensure [:answer-field/validate]} {:db/id "q-316768/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "a0c2388a-d6d7-5d5d-a4af-e901c5acbe23" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-316768/field-2" :answer-field/id #uuid "1e6a21f5-5a60-5523-a38a-6b9a134383c3" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316768/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-316768/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-316768/field-3/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "9cfd6101-e3d1-5b4e-9788-ecbf3618d170" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-316768/field-3" :answer-field/id #uuid "692ea9bf-704e-5dc4-b205-f3525dab8498" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316768/field-3/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer-field/choices ["q-316768/field-3/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873"] :db/ensure [:answer-field/validate]} {:db/id "q-316768" :question/id #uuid "6835b4df-301d-5b0d-b2b8-2bb025d353e1" :question/math-academy-id "q-316768" :question/problem "Calculate ${A}^{-1},$ where\n$A=[\\begin{aligned}5 & 0 \\\\ 0 & -2\\end{aligned}].$\n\n|  |  | {{field-1}} | $0$ |  |\n| --- | --- | --- | --- | --- |\n| ${A}^{-1}=\\,\\,$ |  |  |  |  |\n|  |  | {{field-2}} | {{field-3}} |  |" :question/worked-solution "Given a $2\\times 2$ matrix\n\n$$\nA=[\\begin{aligned}a & b \\\\ c & d\\end{aligned}],\n$$\n\nthe inverse of $A$ can be found using the following formula:\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{det(A)}[\\begin{aligned}d & -b \\\\ -c & a\\end{aligned}].\\end{aligned}\n$$\n\nFirst, we compute the determinant:\n\n$$\ndet(A)=5\\cdot (-2)-0\\cdot 0=-10\n$$\n\nUsing the formula, then, the inverse is given by\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{det(A)}[\\begin{aligned}d & -b \\\\ -c & a\\end{aligned}] \\\\  & =\\frac{1}{-10}[\\begin{aligned}-2 & 0 \\\\ 0 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}1/5 & 0 \\\\ 0 & -1/2\\end{aligned}].\\end{aligned}\n$$\n\nWe can verify the result as follows:\n\n$$\n\\begin{aligned}A{A}^{-1} & =[\\begin{aligned}5 & 0 \\\\ 0 & -2\\end{aligned}][\\begin{aligned}1/5 & 0 \\\\ 0 & -1/2\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & ={I}_{2}\\,✓ \\\\ {A}^{-1}A & =[\\begin{aligned}1/5 & 0 \\\\ 0 & -1/2\\end{aligned}][\\begin{aligned}5 & 0 \\\\ 0 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & ={I}_{2}\\,✓\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-316768/field-1" "q-316768/field-2" "q-316768/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bea23649-e835-540a-b238-7b89ed330cd3"] :knowledge-point/questions ["q-316768"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316753/field-1/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" :answer/id #uuid "aeb2f2a6-b6e4-51c5-bd57-9a38c7fd1c53" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-316753/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "6b2d1a12-5