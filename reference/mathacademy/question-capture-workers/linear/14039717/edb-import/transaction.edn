\\ 2 & ∗ & 0 & 7 \\\\ ∗ & 3 & ∗ & ∗ \\\\ -4 & ∗ & 0 & 1\\end{aligned}]\n$$\n\nSo, the minor is \n\n$$\n{M}_{32}=|\\begin{aligned}-1 & 4 & 0 \\\\ 2 & 0 & 7 \\\\ -4 & 0 & 1\\end{aligned}|.\n$$\n\nTherefore, the cofactor of ${b}_{32}$ is\n\n$$\n\\begin{aligned}{C}_{32} & =(-1)^{3+2}{M}_{32} \\\\  & =-{M}_{32} \\\\  & =-|\\begin{aligned}-1 & 4 & 0 \\\\ 2 & 0 & 7 \\\\ -4 & 0 & 1\\end{aligned}|.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-42092/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "58148550-e41f-5df0-80dc-e783619cf87d"] :knowledge-point/questions ["q-42092"] :db/ensure [:knowledge-point/validate]} {:db/id "q-32793/selection/d4777829b1bfc69e73242c2936302a27b9bacea703cc9521de46be548dbeb7cb" :answer/id #uuid "eead6dd2-b700-55b4-8478-2f6b793cdbfc" :answer/type :answer.type/math :answer/value "-|\\begin{aligned}0 & 8 & -2 & 0 \\\\ 6 & 2 & -9 & 4 \\\\ 1 & 5 & 2 & 1 \\\\ -1 & 4 & 3 & 10\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-32793/selection/497a5c21a435bbd98da8ae93e908e44e18adf10937c30a1db399d245c10ede5c" :answer/id #uuid "280e95c5-3f84-5fb6-bb3d-ccccb96fea5c" :answer/type :answer.type/math :answer/value "-|\\begin{aligned}0 & 8 & -2 & 1 \\\\ 6 & 2 & -9 & -1 \\\\ 1 & 5 & 2 & 0 \\\\ -1 & 4 & 3 & 2\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-32793/selection/681054612befd47e4bca1ece4b7d97c204cbeaff82dc31cbb53137be43eff270" :answer/id #uuid "0717789c-241d-52d3-9cf8-4b53b1661a2f" :answer/type :answer.type/math :answer/value "|\\begin{aligned}0 & 8 & -2 & 1 \\\\ 6 & 2 & -9 & -1 \\\\ 1 & 5 & 2 & 0 \\\\ -1 & 4 & 3 & 2\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-32793/selection/8f33c87dc7f2cbaac25ad75901483a998b880962a3d4f05b17672300e5b09f54" :answer/id #uuid "dcbe8a3d-3be0-5e78-9588-5d6ca969406f" :answer/type :answer.type/math :answer/value "|\\begin{aligned}0 & 8 & -2 & 0 \\\\ 6 & 2 & -9 & 4 \\\\ 1 & 5 & 2 & 1 \\\\ -1 & 4 & 3 & 10\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-32793/selection/6c01c121bedb480efb766f6e8e4ec3e8d942b683ba15e2c1c68e66121e250902" :answer/id #uuid "a8fb6d5c-d554-5afb-b696-df5aa51b6a71" :answer/type :answer.type/math :answer/value "|\\begin{aligned}7 & -3 & 4 & 2 \\\\ 8 & -2 & 0 & 1 \\\\ 2 & -9 & 4 & -1 \\\\ 5 & 2 & 1 & 0\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-32793/selection" :answer-field/id #uuid "9585fb38-1f53-5bf9-92dc-ed8e675bb8d9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-32793/selection/8f33c87dc7f2cbaac25ad75901483a998b880962a3d4f05b17672300e5b09f54" :answer-field/choices ["q-32793/selection/d4777829b1bfc69e73242c2936302a27b9bacea703cc9521de46be548dbeb7cb" "q-32793/selection/497a5c21a435bbd98da8ae93e908e44e18adf10937c30a1db399d245c10ede5c" "q-32793/selection/681054612befd47e4bca1ece4b7d97c204cbeaff82dc31cbb53137be43eff270" "q-32793/selection/8f33c87dc7f2cbaac25ad75901483a998b880962a3d4f05b17672300e5b09f54" "q-32793/selection/6c01c121bedb480efb766f6e8e4ec3e8d942b683ba15e2c1c68e66121e250902"] :db/ensure [:answer-field/validate]} {:db/id "q-32793" :question/id #uuid "f1bc6daa-53f0-51ba-94e5-aef13e4c2d91" :question/math-academy-id "q-32793" :question/problem "Find the cofactor of ${d}_{15}$ in \n$D=[\\begin{aligned}1 & 7 & -3 & 4 & 2 \\\\ 0 & 8 & -2 & 0 & 1 \\\\ 6 & 2 & -9 & 4 & -1 \\\\ 1 & 5 & 2 & 1 & 0 \\\\ -1 & 4 & 3 & 10 & 2\\end{aligned}].$" :question/worked-solution "First, to get the minor of ${d}_{15}$, we remove the $1$st row and $5$th column: \n\n$$\nD=[\\begin{aligned}∗ & ∗ & ∗ & ∗ & 2 \\\\ 0 & 8 & -2 & 0 & ∗ \\\\ 6 & 2 & -9 & 4 & ∗ \\\\ 1 & 5 & 2 & 1 & ∗ \\\\ -1 & 4 & 3 & 10 & ∗\\end{aligned}]\n$$\n\n \nSo, the minor is \n\n$$\n{M}_{15}=|\\begin{aligned}0 & 8 & -2 & 0 \\\\ 6 & 2 & -9 & 4 \\\\ 1 & 5 & 2 & 1 \\\\ -1 & 4 & 3 & 10\\end{aligned}|.\n$$\n\nTherefore, the cofactor of ${d}_{15}$ is\n\n$$\n\\begin{aligned}{C}_{15} & =(-1)^{1+5}{M}_{15} \\\\  & ={M}_{15} \\\\  & =|\\begin{aligned}0 & 8 & -2 & 0 \\\\ 6 & 2 & -9 & 4 \\\\ 1 & 5 & 2 & 1 \\\\ -1 & 4 & 3 & 10\\end{aligned}|.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-32793/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "58148550-e41f-5df0-80dc-e783619cf87d"] :knowledge-point/questions ["q-32793"] :db/ensure [:knowledge-point/validate]} {:db/id "q-131114/selection/713bb3b087b31554fba8b48520fba2f9d4d353e9b2d87f3d41c293daf48e1776" :answer/id #uuid "7a1e569a-4f10-5925-bc3d-bea1bf0d312d" :answer/type :answer.type/math :answer/value "36" :db/ensure [:answer/validate]} {:db/id "q-131114/selection/968b78a1da72ee3df196b4b60a1cb9afd2082e522352c24e5babcf63ab6a5c7b" :answer/id #uuid "f93a37ec-01d5-567c-86b1-7ed7ef02271e" :answer/type :answer.type/math :answer/value "\\frac{11}{2}" :db/ensure [:answer/validate]} {:db/id "q-131114/selection/4c5459ddddb0b5f836e95489b0bf3d70068737e797bee44d6e1000c93ec96641" :answer/id #uuid "f6cab142-d80e-5de6-b1b8-dc6237a1f8a1" :answer/type :answer.type/math :answer/value "115" :db/ensure [:answer/validate]} {:db/id "q-131114/selection/a46f9eccfac402dc3478e05f80ab0279176d7fd6b452aae2691bf08ec6435cd6" :answer/id #uuid "a76a4aa1-6fad-59cf-84d5-8ccf0eaec784" :answer/type :answer.type/math :answer/value "-\\frac{31}{2}" :db/ensure [:answer/validate]} {:db/id "q-131114/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45" :answer/id #uuid "77f2a06d-112c-5b9b-bdf1-f358b4400985" :answer/type :answer.type/math :answer/value "-12" :db/ensure [:answer/validate]} {:db/id "q-131114/selection" :answer-field/id #uuid "e6eb7013-e08a-57d0-95ff-edc2c642f053" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-131114/selection/713bb3b087b31554fba8b48520fba2f9d4d353e9b2d87f3d41c293daf48e1776" :answer-field/choices ["q-131114/selection/713bb3b087b31554fba8b48520fba2f9d4d353e9b2d87f3d41c293daf48e1776" "q-131114/selection/968b78a1da72ee3df196b4b60a1cb9afd2082e522352c24e5babcf63ab6a5c7b" "q-131114/selection/4c5459ddddb0b5f836e95489b0bf3d70068737e797bee44d6e1000c93ec96641" "q-131114/selection/a46f9eccfac402dc3478e05f80ab0279176d7fd6b452aae2691bf08ec6435cd6" "q-131114/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45"] :db/ensure [:answer-field/validate]} {:db/id "q-131114" :question/id #uuid "53b7a785-0378-50bc-93de-51db7267c0f1" :question/math-academy-id "q-131114" :question/problem "Calculate the determinant of the matrix\n$Z=[\\begin{aligned}\\frac{1}{2} & 0 & 0 & 0 \\\\ 5 & 0 & -2 & 0 \\\\ 1 & 5 & 3 & 2 \\\\ 1 & 2 & 3 & 8\\end{aligned}]$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(Z) & ={z}_{11}{C}_{11}+{z}_{12}{C}_{12}+{z}_{13}{C}_{13}+{z}_{14}{C}_{14} \\\\  & =\\frac{1}{2}\\cdot {C}_{11}+0\\cdot {C}_{12}+0\\cdot {C}_{13}+0\\cdot {C}_{14} \\\\  & =\\frac{1}{2}{C}_{11} \\\\  & =\\frac{1}{2}\\cdot |\\begin{aligned}\\frac{1}{2} & ∗ & ∗ & ∗ \\\\ ∗ & 0 & -2 & 0 \\\\ ∗ & 5 & 3 & 2 \\\\ ∗ & 2 & 3 & 8\\end{aligned}| \\\\  & =\\frac{1}{2}(-1)^{1+1}|\\begin{aligned}0 & -2 & 0 \\\\ 5 & 3 & 2 \\\\ 2 & 3 & 8\\end{aligned}| \\\\  & =\\frac{1}{2}(0\\cdot |\\begin{aligned}3 & 2 \\\\ 3 & 8\\end{aligned}|-(-2)\\cdot |\\begin{aligned}5 & 2 \\\\ 2 & 8\\end{aligned}|+0\\cdot |\\begin{aligned}5 & 3 \\\\ 2 & 3\\end{aligned}|) \\\\  & =\\frac{1}{2}(0+2(5\\cdot 8-2\\cdot 2)+0) \\\\  & =\\frac{1}{2}\\cdot 72 \\\\  & =36\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-131114/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "055b3809-f9aa-5dcc-8c1a-b0eb71020d7e"] :knowledge-point/questions ["q-131114"] :db/ensure [:knowledge-point/validate]} {:db/id "q-32727/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "ef027b49-c589-591f-b3c5-b11082f1b1a4" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/valid