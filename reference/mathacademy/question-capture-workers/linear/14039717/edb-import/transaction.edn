ned}|-0\\cdot |\\begin{aligned}6 & 2 \\\\ 0 & -2\\end{aligned}|+0\\cdot |\\begin{aligned}6 & 0 \\\\ 0 & 3\\end{aligned}|)+4(9\\cdot |\\begin{aligned}6 & 2 \\\\ 0 & -2\\end{aligned}|-0\\cdot |\\begin{aligned}-1 & 2 \\\\ 1 & -2\\end{aligned}|+0\\cdot |\\begin{aligned}-1 & 6 \\\\ 1 & 0\\end{aligned}|) \\\\  & =-0+4\\cdot 9(6\\cdot (-2)-2\\cdot 0) \\\\  & =36\\cdot (-12) \\\\  & =-432\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-32791/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "055b3809-f9aa-5dcc-8c1a-b0eb71020d7e"] :knowledge-point/questions ["q-32791"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-36055"] :question/problem "Calculate the determinant of the matrix\n$A=[\\begin{aligned}-3 & 0 & 0 & 5 \\\\ 0 & 0 & 3 & -2 \\\\ 4 & -1 & 2 & -3 \\\\ -1 & 6 & 0 & 0\\end{aligned}].$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(A) & ={a}_{11}{C}_{11}+{a}_{12}{C}_{12}+{a}_{13}{C}_{13}+{a}_{14}{C}_{14} \\\\  & =(-3)\\cdot {C}_{11}+0\\cdot {C}_{12}+0\\cdot {C}_{13}+5\\cdot {C}_{14} \\\\  & =-3{C}_{11}+5{C}_{14} \\\\  & =(-3)\\cdot |\\begin{aligned}-3 & ∗ & ∗ & ∗ \\\\ ∗ & 0 & 3 & -2 \\\\ ∗ & -1 & 2 & -3 \\\\ ∗ & 6 & 0 & 0\\end{aligned}|+5\\cdot |\\begin{aligned}∗ & ∗ & ∗ & 5 \\\\ 0 & 0 & 3 & ∗ \\\\ 4 & -1 & 2 & ∗ \\\\ -1 & 6 & 0 & ∗\\end{aligned}| \\\\  & =(-3)(-1)^{1+1}|\\begin{aligned}0 & 3 & -2 \\\\ -1 & 2 & -3 \\\\ 6 & 0 & 0\\end{aligned}|+5(-1)^{1+4}|\\begin{aligned}0 & 0 & 3 \\\\ 4 & -1 & 2 \\\\ -1 & 6 & 0\\end{aligned}| \\\\  & =-3|\\begin{aligned}0 & 3 & -2 \\\\ -1 & 2 & -3 \\\\ 6 & 0 & 0\\end{aligned}|-5|\\begin{aligned}0 & 0 & 3 \\\\ 4 & -1 & 2 \\\\ -1 & 6 & 0\\end{aligned}| \\\\  & =-3(0\\cdot |\\begin{aligned}2 & -3 \\\\ 0 & 0\\end{aligned}|-3\\cdot |\\begin{aligned}-1 & -3 \\\\ 6 & 0\\end{aligned}|-2\\cdot |\\begin{aligned}-1 & 2 \\\\ 6 & 0\\end{aligned}|) \\\\  & -5(0\\cdot |\\begin{aligned}-1 & 2 \\\\ 6 & 0\\end{aligned}|-0\\cdot |\\begin{aligned}4 & 2 \\\\ -1 & 0\\end{aligned}|+3\\cdot |\\begin{aligned}4 & -1 \\\\ -1 & 6\\end{aligned}|) \\\\  & =-3\\cdot (-3\\cdot (0+18)+(-2)\\cdot (0-12))-5\\cdot (3\\cdot (24-1)) \\\\  & =90-345 \\\\  & =-255\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-36045/selection/595968c9c77f47025fc7d67454c0aedd72cbf36dc2aa59ca3f488e1ff8cdc038" :answer/id #uuid "6017ae45-a08f-543c-b5d0-52dff35ae102" :answer/type :answer.type/math :answer/value "-62" :db/ensure [:answer/validate]} {:db/id "q-36045/selection/8cd557fa143c2616f01a8df1d19e854fea26be776628dc106639661d1b774491" :answer/id #uuid "931dc1f4-35c6-5465-bde2-cbd7472cd65e" :answer/type :answer.type/math :answer/value "65" :db/ensure [:answer/validate]} {:db/id "q-36045/selection/837d09f3c5a1e75c2c10e59c453d43a9909a650414dc5ddd0a7e209d07dabf14" :answer/id #uuid "5b78316c-dd1e-5257-9c2a-e1ea54ad016d" :answer/type :answer.type/math :answer/value "-51" :db/ensure [:answer/validate]} {:db/id "q-36045/selection/d472470bf61b62667bf520b42074414f07d1266def1002f8f8325fe27d872b2d" :answer/id #uuid "c8050bf2-c812-508f-8b32-bec260e615c2" :answer/type :answer.type/math :answer/value "39" :db/ensure [:answer/validate]} {:db/id "q-36045/selection/286fb92e9ba180b012d241bb7e762701483c9c864420d9df6597147f2e2fb458" :answer/id #uuid "347ef0fd-a81d-53f9-92c4-f8d67ad6ec95" :answer/type :answer.type/math :answer/value "28" :db/ensure [:answer/validate]} {:db/id "q-36045/selection" :answer-field/id #uuid "66c3b9ce-36b7-5ca9-a937-b9ad6a3024e3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-36045/selection/595968c9c77f47025fc7d67454c0aedd72cbf36dc2aa59ca3f488e1ff8cdc038" :answer-field/choices ["q-36045/selection/595968c9c77f47025fc7d67454c0aedd72cbf36dc2aa59ca3f488e1ff8cdc038" "q-36045/selection/8cd557fa143c2616f01a8df1d19e854fea26be776628dc106639661d1b774491" "q-36045/selection/837d09f3c5a1e75c2c10e59c453d43a9909a650414dc5ddd0a7e209d07dabf14" "q-36045/selection/d472470bf61b62667bf520b42074414f07d1266def1002f8f8325fe27d872b2d" "q-36045/selection/286fb92e9ba180b012d241bb7e762701483c9c864420d9df6597147f2e2fb458"] :db/ensure [:answer-field/validate]} {:db/id "q-36045" :question/id #uuid "847eae56-3846-5fab-8026-233085fa9f12" :question/math-academy-id "q-36045" :question/problem "Calculate the determinant of the matrix\n$Z=[\\begin{aligned}1 & 0 & -1 & 0 \\\\ 0 & 0 & -2 & 0 \\\\ 0 & -3 & 5 & 4 \\\\ 0 & 4 & 3 & 5\\end{aligned}].$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(Z) & ={z}_{11}{C}_{11}+{z}_{12}{C}_{12}+{z}_{13}{C}_{13}+{z}_{14}{C}_{14} \\\\  & =1\\cdot {C}_{11}+0\\cdot {C}_{12}+(-1)\\cdot {C}_{13}+0\\cdot {C}_{14} \\\\  & ={C}_{11}-{C}_{13} \\\\  & =1\\cdot |\\begin{aligned}1 & ∗ & ∗ & ∗ \\\\ ∗ & 0 & -2 & 0 \\\\ ∗ & -3 & 5 & 4 \\\\ ∗ & 4 & 3 & 5\\end{aligned}|+(-1)\\cdot |\\begin{aligned}∗ & ∗ & -1 & ∗ \\\\ 0 & 0 & ∗ & 0 \\\\ 0 & -3 & ∗ & 4 \\\\ 0 & 4 & ∗ & 5\\end{aligned}| \\\\  & =1\\cdot (-1)^{1+1}|\\begin{aligned}0 & -2 & 0 \\\\ -3 & 5 & 4 \\\\ 4 & 3 & 5\\end{aligned}|+(-1)\\cdot (-1)^{1+3}|\\begin{aligned}0 & 0 & 0 \\\\ 0 & -3 & 4 \\\\ 0 & 4 & 5\\end{aligned}| \\\\  & =|\\begin{aligned}0 & -2 & 0 \\\\ -3 & 5 & 4 \\\\ 4 & 3 & 5\\end{aligned}|-|\\begin{aligned}0 & 0 & 0 \\\\ 0 & -3 & 4 \\\\ 0 & 4 & 5\\end{aligned}| \\\\  & =(0\\cdot |\\begin{aligned}5 & 4 \\\\ 3 & 5\\end{aligned}|-(-2)\\cdot |\\begin{aligned}-3 & 4 \\\\ 4 & 5\\end{aligned}|+0\\cdot |\\begin{aligned}-3 & 5 \\\\ 4 & 3\\end{aligned}|)-(0\\cdot |\\begin{aligned}-3 & 4 \\\\ 4 & 5\\end{aligned}|-0\\cdot |\\begin{aligned}0 & 4 \\\\ 0 & 5\\end{aligned}|+0\\cdot |\\begin{aligned}0 & -3 \\\\ 0 & 4\\end{aligned}|) \\\\  & =0+2\\cdot |\\begin{aligned}-3 & 4 \\\\ 4 & 5\\end{aligned}|+0-(0-0+0) \\\\  & =2\\cdot |\\begin{aligned}-3 & 4 \\\\ 4 & 5\\end{aligned}| \\\\  & =2((-3)\\cdot 5-4\\cdot 4) \\\\  & =2\\cdot (-31) \\\\  & =-62\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-36045/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "055b3809-f9aa-5dcc-8c1a-b0eb71020d7e"] :knowledge-point/questions ["q-36045"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-4447"] :question/problem "What is the minor of $a_{13}$ in \n$[\\begin{aligned}0 & 0 & 2 & 3 \\\\ 5 & 1 & 2 & 0 \\\\ 1 & 6 & 0 & -1 \\\\ -6 & 3 & 1 & 0\\end{aligned}]$" :question/worked-solution "To get the minor of $a_{13}$, we remove the $1$st row and $3$rd column:\n\n$$\n[\\begin{aligned}∗ & ∗ & 2 & ∗ \\\\ 5 & 1 & ∗ & 0 \\\\ 1 & 6 & ∗ & -1 \\\\ -6 & 3 & ∗ & 0\\end{aligned}]\n$$\n\nSo, the minor is \n\n$$\n|\\begin{aligned}5 & 1 & 0 \\\\ 1 & 6 & -1 \\\\ -6 & 3 & 0\\end{aligned}|\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4448"] :question/problem "Find the cofactor of $d_{23}$ in \n$[\\begin{aligned}0 & 2 & 3 & -6 \\\\ 7 & -3 & -2 & -1 \\\\ 6 & 0 & 8 & 9 \\\\ 5 & 4 & 0 & 0\\end{aligned}]$" :question/worked-solution "First, to get the minor of $d_{23}$, we remove the $2$nd row and $3$rd column:\n\n$$\n[\\begin{aligned}0 & 2 & ∗ & -6 \\\\ ∗ & ∗ & -2 & ∗ \\\\ 6 & 0 & ∗ & 9 \\\\ 5 & 4 & ∗ & 0\\end{aligned}]\n$$\n\nSo, the minor is \n\n$$\n\\begin{aligned}0 & 2 & -6 \\\\ 6 & 0 & 9 \\\\ 5 & 4 & 0\\end{aligned}\n$$\n\nNow, the cofactor of $d_{23}$ is\n\n$$\n\\begin{aligned}{C}_{23} & =(-1)^{2+3}{M}_{23} \\\\  & =-{M}_{23} \\\\  & =-|\\begin{aligned}0 & 2 & -6 \\\\ 6 & 0 & 9 \\\\ 5 & 4 & 0\\end{aligned}|.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4449"] :question/problem "Calculate the determinant of the matrix\n$\\begin{aligned}0 & 0 & 2 & 0 \\\\ 5 & 1 & 2 & 0 \\\\ 1 & 6 & 0 & -1 \\\\ -6 & 3 & 1 & 0\\end{aligned}$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(A) & ={a}_{11}{C}_{11}+{a}_{12}{C}_{12}+{a}_{13}{C}_{13}+{a}_{14}{C}_{14} \\\\  & =0\\cdot {C}_{11}+0\\cdot {C}_{12}+2\\cdot {C}_{13}+0\\cdot {C}_{14} \\\\  & =2{C}_{13} \\\\  & =2\\cdot |\\begin{aligned}∗ & ∗ & 2 & ∗ \\\\ 5 & 1 & ∗ & 0 \\\\ 1 & 6 & ∗ & -1 \\\\ -6 & 3 & ∗ & 0\\end{aligned}| \\\\  & =2(-1)^{1+3}|\\begin{aligned}5 & 1 & 0 \\\\ 1 & 6 & -1 \\\\ -6 & 3 & 0\\end{aligned}| \\\\  & =2(5|\\begin{aligned}6 & -1 \\\\ 3 & 0\\end{aligned}|-1|\\begin{aligned}1 & -1 \\\\ -6 & 0\\end{aligned}|+0|\\begin{aligned}1 & 6 \\\\ -6 & 3\\end{aligned}|) \\\\  & =2(5(6\\cdot 0+1\\cdot 3)-(1\\cdot 0-(-1)\\cdot (-6))+0(1\\cdot 3-6\\cdot (-6))) \\\\  & =2(15+6+0) \\\\  & =2\\cdot 21 \\\\  & =42\\end{aligned}\n$$" :db/ensure [:question/validate]}]
