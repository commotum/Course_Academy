 & 3 & -9 \\\\ -4 & 0 & 1\\end{aligned}|" :db/id #edb/ref 17592186309337} {:answer/id #uuid "c036fc50-f14d-5ef1-9d21-9d448ee2c337" :answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}-1 & 6 & 0 \\\\ 2 & 5 & 7 \\\\ -4 & 0 & 1\\end{aligned}|" :db/id #edb/ref 17592186309338} {:answer/id #uuid "a5d437ee-8237-53e5-a777-7f07d52daad6" :answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}6 & 4 & 0 \\\\ 5 & 0 & 7 \\\\ 0 & 0 & 1\\end{aligned}|" :db/id #edb/ref 17592186309339}] :answer-field/correct {:answer/id #uuid "ebe3b9e3-b105-5110-8ba2-ab4b6181f108" :answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}-1 & 4 & 0 \\\\ 2 & 0 & 7 \\\\ -4 & 0 & 1\\end{aligned}|" :db/id #edb/ref 17592186309336} :answer-field/id #uuid "ad9e42a8-bb2c-5e36-8b87-c0b7e742ddb4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186309334}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "368c9476-6b26-5a56-b85b-a41230a98028" :question/math-academy-id "q-42092" :question/problem "Find the cofactor of ${b}_{32}$ in $B=[\\begin{aligned}-1 & 6 & 4 & 0 \\\\ 2 & 5 & 0 & 7 \\\\ 0 & 3 & 5 & -9 \\\\ -4 & 0 & 0 & 1\\end{aligned}].$" :question/worked-solution "First, to get the minor of ${b}_{32}$, we remove the $3$rd  row and $2$nd column: \n\n$$\nB=[\\begin{aligned}-1 & ∗ & 4 & 0 \\\\ 2 & ∗ & 0 & 7 \\\\ ∗ & 3 & ∗ & ∗ \\\\ -4 & ∗ & 0 & 1\\end{aligned}]\n$$\n\nSo, the minor is \n\n$$\n{M}_{32}=|\\begin{aligned}-1 & 4 & 0 \\\\ 2 & 0 & 7 \\\\ -4 & 0 & 1\\end{aligned}|.\n$$\n\nTherefore, the cofactor of ${b}_{32}$ is\n\n$$\n\\begin{aligned}{C}_{32} & =(-1)^{3+2}{M}_{32} \\\\  & =-{M}_{32} \\\\  & =-|\\begin{aligned}-1 & 4 & 0 \\\\ 2 & 0 & 7 \\\\ -4 & 0 & 1\\end{aligned}|.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120436 :knowledge-point/_questions [{:knowledge-point/id #uuid "ecdc6a5a-5aba-5547-97aa-db3cd2e90ae6" :knowledge