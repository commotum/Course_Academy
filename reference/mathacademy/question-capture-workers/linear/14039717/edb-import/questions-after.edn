 & 0\\end{aligned}| \\\\  & =-3|\\begin{aligned}0 & 3 & -2 \\\\ -1 & 2 & -3 \\\\ 6 & 0 & 0\\end{aligned}|-5|\\begin{aligned}0 & 0 & 3 \\\\ 4 & -1 & 2 \\\\ -1 & 6 & 0\\end{aligned}| \\\\  & =-3(0\\cdot |\\begin{aligned}2 & -3 \\\\ 0 & 0\\end{aligned}|-3\\cdot |\\begin{aligned}-1 & -3 \\\\ 6 & 0\\end{aligned}|-2\\cdot |\\begin{aligned}-1 & 2 \\\\ 6 & 0\\end{aligned}|) \\\\  & -5(0\\cdot |\\begin{aligned}-1 & 2 \\\\ 6 & 0\\end{aligned}|-0\\cdot |\\begin{aligned}4 & 2 \\\\ -1 & 0\\end{aligned}|+3\\cdot |\\begin{aligned}4 & -1 \\\\ -1 & 6\\end{aligned}|) \\\\  & =-3\\cdot (-3\\cdot (0+18)+(-2)\\cdot (0-12))-5\\cdot (3\\cdot (24-1)) \\\\  & =90-345 \\\\  & =-255\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186309326 :knowledge-point/_questions [{:knowledge-point/id #uuid "ecdc6a5a-5aba-5547-97aa-db3cd2e90ae6" :knowledge-point/title "Calculating a Minor in a NxN Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3384fa90-251a-5963-bd83-087ecf0d9221" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}3 & -4 & 5 \\\\ 0 & 7 & 1 \\\\ 8 & -9 & -2\\end{aligned}|" :db/id #edb/ref 17592186309328} {:answer/id #uuid "97bb9acc-df7f-5ba6-af83-1bd39f83b983" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}7 & 0 & 1 \\\\ 13 & 5 & 5 \\\\ -9 & 2 & -2\\end{aligned}|" :db/id #edb/ref 17592186309329} {:answer/id #uuid "a934e22d-c13b-5355-94cb-af641fd61a87" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}0 & 7 & 0 \\\\ 17 & 13 & 5 \\\\ 8 & -9 & 2\\end{aligned}|" :db/id #edb/ref 17592186309330} {:answer/id #uuid "876e75cf-d568-524d-822f-4236671d3a87" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-4 & 0 & 5 \\\\ 13 & 5 & 5 \\\\ -9 & 2 & -2\\end{aligned}|" :db/id #edb/ref 17592186309331} {:answer/id #uuid "67305b2e-21b7-553f-8959-916cf23ab072" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}3 & -4 & 0 \\\\ 0 & 7 & 0 \\\\ 17 & 13 & 5\\end{a