#{[{:db/id #edb/ref 17592186157013 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "15b92bed-c97f-5b87-9811-fbfc5c03314d" :knowledge-point/title "Finding a Component of a Vector With Respect to a Given Orthogonal Basis"}] :question/id #uuid "5f10a215-83bb-545a-a0e1-ce702f773e6d" :question/math-academy-id "e-7112" :question/problem "Given the orthogonal basis $\\mathcal{B}$ of $\\mathbb{R}^3$ and the vector $\\mathbf{x}$ below, find the value of $x_2$, the second component of $[\\mathbf{x}]_{\\mathcal{B}}$.\n$\\begin{bmatrix}2 \\\\ 2 \\\\ 1\\end{bmatrix}$" :question/worked-solution "Let's denote the vectors of $\\mathcal{B}$ as $\\mathbf{q}_1,\\, \\mathbf{q}_2,\\,\\mathbf{q}_3$.\n\nSince $\\mathcal{B}$ is an orthogonal basis, we have that $\\begin{bmatrix}x_{1} \\\\ x_{2} \\\\ x_{3}\\end{bmatrix}$ where\n\n$$\nx_i = \\dfrac{\\mathbf{x} \\cdot \\mathbf{q}_i}{\\mathbf{q}_i \\cdot \\mathbf{q}_i}\n$$\n\nComputing $x_2$, we obtain\n\n$$\n\\begin{aligned}\nx_{2} &= \\frac{x \\cdot q_{2}}{q_{2} \\cdot q_{2}} \\\\\n&= (4 \\cdot 1 + 6 \\cdot 1 + (-2) \\cdot (-4))/(1^{2} + 1^{2} + (-4)^{2}) \\\\\n&= \\frac{4 + 6 + 8}{1 + 1 + 16} \\\\\n&= 1\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186157014 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "39b12711-22c8-5cb7-bd61-e128734e7e6f" :knowledge-point/title "Calculating the Components of a Vector With Respect to a Given Orthonormal Basis"}] :question/id #uuid "d7df79a9-2489-5fed-9e00-29890bd01f82" :question/math-academy-id "e-7113" :question/problem "Given the **orthonormal** basis $\\begin{bmatrix}\\frac{1}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}}\\end{bmatrix}$ of $\\mathbb R^2$, find $[\\mathbf{x}]_{\\mathcal{B}}$ if $\\begin{bmatrix}-2\\sqrt{5} \\\\ 3\\sqrt{5}\\end{bmatrix}$" :question/worked-solution "Let's denote the vectors of $\\mathcal{B}$ as $\\mathbf{q}_1,\\, \\mathbf{q}_2$.\n\nSince $\\mathcal{B}$ is an orthonormal basis, we have that $\\begin{bmatrix}x_{1} \\\\ x_{2}\\end{bmatrix}$ where\n\n$$\nx_i = \\mathbf{x} \\cdot \\mathbf{q}_i\n$$\n\nComputing the components of $\\mathbf{x}$, we get the following:\n\n$$\n\\begin{aligned}\nx_{1} &= \\begin{bmatrix}-2\\sqrt{5} \\\\ 3\\sqrt{5}\\end{bmatrix} \\cdot \\begin{bmatrix}\\frac{1}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}}\\end{bmatrix} =-2 - 6 =-8 \\\\\nx_{2} &= \\begin{bmatrix}-2\\sqrt{5} \\\\ 3\\sqrt{5}\\end{bmatrix} \\cdot \\begin{bmatrix}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{bmatrix} =-4 + 3 =-1\n\\end{aligned}\n$$\n\nTherefore, we have $\\begin{bmatrix}-8 \\\\ -1\\end{bmatrix}$"}] [{:db/id #edb/ref 17592186157710 :knowledge-point/_questions [{:knowledge-point/id #uuid "15b92bed-c97f-5b87-9811-fbfc5c03314d" :knowledge-point/title "Finding a Component of a Vector With Respect to a Given Orthogonal Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9254ea79-8223-5408-88d8-673a1a9426d1" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186155513} {:answer/id #uuid "9a11f5fe-02c8-5034-8236-308db1adc6aa" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186155514} {:answer/id #uuid "eafb40be-422e-5447-b360-9b42915dc668" :answer/type {:db/ident :answer.type/math} :answer/value "-13" :db/id #edb/ref 17592186155515} {:answer/id #uuid "3152041d-ad44-53c3-90db-fd6824834ebc" :answer/type {:db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186155516} {:answer/id #uuid "66b89f6d-b041-51bb-9e8a-5ac5cff8e506" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186155517}] :answer-field/correct {:answer/id #uuid "9254ea79-8223-5408-88d8-673a1a9426d1" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186155513} :answer-field/id #uuid "beea1ca6-15e0-5f29-aa27-ccc29bcf3761" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186155512}] :question/id #uuid "1c2da7ca-24a0-572d-977f-07408d1bbebe" :question/math-academy-id "q-40291" :question/problem "Given the orthogonal basis $B$ of $R^{2}$ and the vector $x$ below, find the value of $26x_{1}$, where $x_{1}$ is the first component of $[x]_{B}$.\n\n$B = {\\begin{bmatrix}3 \\\\ 2\\end{bmatrix}, \\begin{bmatrix}-18 \\\\ 27\\end{bmatrix}}, x = \\begin{bmatrix}3 \\\\ -1\\end{bmatrix}$"}] [{:db/id #edb/ref 17592186294807 :knowledge-point/_questions [{:knowledge-point/id #uuid "39b12711-22c8-5cb7-bd61-e128734e7e6f" :knowledge-point/title "Calculating the Components of a Vector With Respect to a Given Orthonormal Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "65a1ba53-d9ca-5ff1-9f3d-9c4fc0989396" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{1}{\\sqrt{5}} \\\\ -\\frac{11}{\\sqrt{5}}\\end{aligned}]" :db/id #edb/ref 17592186294809} {:answer/id #uuid "dfbe921f-67d0-5706-a5c6-36b025c7070d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{10}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}}\\end{aligned}]" :db/id #edb/ref 17592186294810} {:answer/id #uuid "35cf3d11-b2c5-5e9f-acba-db3eb0fbcd21" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{11}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{aligned}]" :db/id #edb/ref 17592186294811} {:answer/id #uuid "0c319097-9c82-5855-844a-1c3b6a816381" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{\\sqrt{5}} \\\\ \\frac{11}{\\sqrt{5}}\\end{aligned}]" :db/id #edb/ref 17592186294812} {:answer/id #uuid "93dc7b26-4f82-599a-a051-8216bdcf5712" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{11}{\\sqrt{5}} \\\\ \\frac{7}{\\sqrt{5}}\\end{aligned}]" :db/id #edb/ref 17592186294813}] :answer-field/correct {:answer/id #uuid "93dc7b26-4f82-599a-a051-8216bdcf5712" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{11}{\\sqrt{5}} \\\\ \\frac{7}{\\sqrt{5}}\\end{aligned}]" :db/id #edb/ref 17592186294813} :answer-field/id #uuid "3b1e9640-f0e5-54fd-a3ed-9808ca7fd7ec" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294808}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "694ae25e-76dc-5254-b28a-52858f45659d" :question/math-academy-id "q-81106" :question/problem "Given the **orthonormal** basis $B={[\\begin{aligned}\\frac{2}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}}\\end{aligned}],[\\begin{aligned}\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{aligned}]}$ of ${R}^{2},$ find $[x]_{B}$ if $x=[\\begin{aligned}-3 \\\\ 5\\end{aligned}].$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2}.$ \n\nSince $B$ is an orthonormal basis, we have that $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$, where ${x}_{i}=x\\cdot {q}_{i}.$ Computing the components of $x,$ we get the following: \n\n$$\n\\begin{aligned}{x}_{1} & =[\\begin{aligned}-3 \\\\ 5\\end{aligned}]\\cdot [\\begin{aligned}\\frac{2}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}}\\end{aligned}]=-\\frac{6}{\\sqrt{10}}-\\frac{5}{\\sqrt{5}}=-\\frac{11}{\\sqrt{5}} \\\\ {x}_{2} & =[\\begin{aligned}-3 \\\\ 5\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{aligned}]=-\\frac{3}{\\sqrt{5}}+\\frac{10}{\\sqrt{10}}=\\frac{7}{\\sqrt{5}}\\end{aligned}\n$$\n\nTherefore, we have \n\n$$\n[x]_{B}=[\\begin{aligned}-\\frac{11}{\\sqrt{5}} \\\\ \\frac{7}{\\sqrt{5}}\\end{aligned}].\n$$"}]}
