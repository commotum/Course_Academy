{3}}{2}\\end{aligned}]}$ of ${R}^{2},$ find $[x]_{B}$ if $x=[\\begin{aligned}2 \\\\ -2\\end{aligned}].$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2}.$ \n\nSince $B$ is an orthonormal basis, we have that $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$, where ${x}_{i}=x\\cdot {q}_{i}.$ Computing the components of $x,$ we get the following: \n\n$$\n\\begin{aligned}{x}_{1} & =[\\begin{aligned}2 \\\\ -2\\end{aligned}]\\cdot [\\begin{aligned}\\frac{\\sqrt{3}}{2} \\\\ \\frac{1}{2}\\end{aligned}]=\\sqrt{3}-1 \\\\ {x}_{2} & =[\\begin{aligned}2 \\\\ -2\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{2} \\\\ -\\frac{\\sqrt{3}}{2}\\end{aligned}]=1+\\sqrt{3}\\end{aligned}\n$$\n\nTherefore, we have \n\n$$\n[x]_{B}=[\\begin{aligned}\\sqrt{3}-1 \\\\ 1+\\sqrt{3}\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-102322/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "39b12711-22c8-5cb7-bd61-e128734e7e6f"] :knowledge-point/questions ["q-102322"] :db/ensure [:knowledge-point/validate]} {:db/id "q-102333/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "5b51cbc9-465b-573d-b720-d2a65d0aaf0c" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-102333/selection/c59421689e9802bbe55dc885ef3b88a565922fc724e5a7225b403918fe48989b" :answer/id #uuid "29984e99-1ee9-541c-9957-a233bb839e81" :answer/type :answer.type/math :answer/value "35" :db/ensure [:answer/validate]} {:db/id "q-102333/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "95fd1f0b-65ed-5594-9788-2a8a333217f9" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-102333/selection/a84d639d380e10cb74c92005685f9f65779377dfb51342c280c63c645679bbea" :answer/id #uuid "deb0d8de-131c-5913-b72c-eb6375f07c62" :answer/type :answer.type/math :answer/value "25" :db/ensure [:answer/validate]} {:db/id "q-102333/selection/60d8696f019bd6901d4028773e8b64c56a3047a6bc6b4ed12b314cf6b1ae175a" :answer/id #uuid "23ee76ce-f0bd-5ccf-aad9-749a8eaeff14" :answer/type :answer.type/math :answer/value "-35" :db/ensure [:answer/validate]} {:db/id "q-102333/selection" :answer-field/id #uuid "47ecbea9-2776-511f-b96a-68a144c5aa6a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-102333/selection/c59421689e9802bbe55dc885ef3b88a565922fc724e5a7225b403918fe48989b" :answer-field/choices ["q-102333/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" "q-102333/selection/c59421689e9802bbe55dc885ef3b88a565922fc724e5a7225b403918fe48989b" "q-102333/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-102333/selection/a84d639d380e10cb74c92005685f9f65779377dfb51342c280c63c645679bbea" "q-102333/selection/60d8696f019bd6901d4028773e8b64c56a3047a6bc6b4ed12b314cf6b1ae175a"] :db/ensure [:answer-field/validate]} {:db/id "q-102333" :question/id #uuid "8a10a6f4-6466-5b27-9f8e-862bce8849e2" :question/math-academy-id "q-102333" :question/problem "Given the **orthonormal** basis $B$ of ${R}^{3}$ and the vector $x$ below, find the value of $5{x}_{2}$, where ${x}_{2}$ is the second component of $[x]_{B}.$\n\n$$\nB={[\\begin{aligned}\\frac{3}{5} \\\\ 0 \\\\ \\frac{4}{5}\\end{aligned}],[\\begin{aligned}-\\frac{4}{5} \\\\ 0 \\\\ \\frac{3}{5}\\end{aligned}],[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]},\\,x=[\\begin{aligned}-5 \\\\ -1 \\\\ 5\\end{aligned}]\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2},\\,{q}_{3}.$ \n\nSince $B$ is an orthonormal basis, we have that $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]$, where ${x}_{i}=x\\cdot {q}_{i}.$ Computing ${x}_{2},$ we obtain\n\n$$\n\\begin{aligned}{x}_{2} & =x\\cdot {q}_{2} \\\\  & =[\\begin{aligned}-5 \\\\ -1 \\\\ 5\\end{aligned}]\\cdot [\\begin{aligned}-\\frac{4}{5} \\\\ 0 \\\\ \\frac{3}{5}\\end{aligned}] \\\\  & =4+0+3 \\\\  & =7.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n5{x}_{2}=5\\cdot 7=35.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-102333/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "39b12711-22c8-5cb7-bd61-e128734e7e6f"] :knowledge-point/questions ["q-102333"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-7112"] :question/problem "Given the orthogonal basis $\\mathcal{B}$ of $\\mathbb{R}^3$ and the vector $\\mathbf{x}$ below, find the value of $x_2,$ the second component of $[\\mathbf{x}]_{\\mathcal{B}}.$\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066805/assets/4f788e589f34c94ac03e11f7cee87f9af695af2a86d57a2e4630f07c30babb1e.png)" :question/worked-solution "Let's denote the vectors of $\\mathcal{B}$ as $\\mathbf{q}_1,\\, \\mathbf{q}_2,\\,\\mathbf{q}_3.$ \n\nSince $\\mathcal{B}$ is an orthogonal basis, we have that ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066805/assets/cfa33ba159e0627ec7a7288e44249acd88e0037e285fa786888dfcc13e5d538c.png) where $x_i = \\dfrac{\\mathbf{x} \\cdot \\mathbf{q}_i}{\\mathbf{q}_i \\cdot \\mathbf{q}_i}.$ \n\nComputing $x_2,$ we obtain \n\n$$\n\\begin{aligned}{x}_{2} & =\\frac{x\\cdot {q}_{2}}{{q}_{2}\\cdot {q}_{2}} \\\\  & =\\frac{4\\cdot 1+6\\cdot 1+(-2)\\cdot (-4)}{{1}^{2}+{1}^{2}+(-4)^{2}} \\\\  & =\\frac{4+6+8}{1+1+16} \\\\  & =1.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7113"] :question/problem "Given the **orthonormal** basis ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066805/assets/5a56202f818d8b8d10dd06d5e4bd02ee0aabc2f16758ca64cb6dc416fb71075c.png) of $\\mathbb R^2,$ find $[\\mathbf{x}]_{\\mathcal{B}}$ if ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066805/assets/d97e5bc94afc05532528354b82231eab87ca49ec72bd42879759c64c4165837d.png)" :question/worked-solution "Let's denote the vectors of $\\mathcal{B}$ as $\\mathbf{q}_1,\\, \\mathbf{q}_2.$ \n\nSince $\\mathcal{B}$ is an orthonormal basis, we have that ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066805/assets/1ba0b151abea3c5b1a050c6ff924f3718fcb045b063b1b47df7a73f9d15316c9.png) where $x_i = \\mathbf{x} \\cdot \\mathbf{q}_i.$ Computing the components of $\\mathbf{x},$ we get the following: \n\n$$\n\\begin{aligned}{x}_{1} & =[\\begin{aligned}-2\\sqrt{5} \\\\ 3\\sqrt{5}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}}\\end{aligned}]=-2-6=-8 \\\\ {x}_{2} & =[\\begin{aligned}-2\\sqrt{5} \\\\ 3\\sqrt{5}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{aligned}]=-4+3=-1\\end{aligned}\n$$\n\nTherefore, we have ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066805/assets/51184680e9ec8b56a437334ca2a9281b1b364da2c35922839be13e545d92cec4.png)" :db/ensure [:question/validate]}]
