}\n$$\n\nTherefore,\n\n$$\n\\frac{{x}_{1}}{2}=\\frac{8}{2}=4.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-40401/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "15b92bed-c97f-5b87-9811-fbfc5c03314d"] :knowledge-point/questions ["q-40401"] :db/ensure [:knowledge-point/validate]} {:db/id "q-102352/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "7081d8cc-9480-51ee-a2dc-0f47af20caf0" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-102352/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "0796a34e-8f6e-5da2-a996-c174f9c1b19f" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-102352/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "0021cee8-75b7-55dc-83ea-7d5433490442" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-102352/selection/12b7d840a997b0af25896f37c76d366155c72a970c1525c62ec119b69786f393" :answer/id #uuid "dc6633d5-634a-5de8-9383-c71df457af53" :answer/type :answer.type/math :answer/value "13" :db/ensure [:answer/validate]} {:db/id "q-102352/selection/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" :answer/id #uuid "5da04c4b-0d45-5643-b283-9d1b31340cc2" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "q-102352/selection" :answer-field/id #uuid "d4d19498-a07a-5b68-a9ff-a896f581e9a7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-102352/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-102352/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-102352/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-102352/selection/be9eb51cc