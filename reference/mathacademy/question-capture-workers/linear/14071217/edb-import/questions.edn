th} :answer/value "-1" :db/id #edb/ref 17592186132241}] :answer-field/correct {:answer/id #uuid "b3e1e31d-d467-51f5-96ef-503eca2d166a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186132238} :answer-field/id #uuid "fa322946-7e0d-5934-95b4-40e6e80fc536" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186132236}] :question/id #uuid "00e4806c-b4ce-579d-8d0e-03b84320da38" :question/math-academy-id "q-41919" :question/problem "${x_{1} - x_{2} = 1; 5x_{1} - 5x_{2} = 0; 2x_{1} - 2x_{2} = 0$\n\nConsider the system of linear equations shown above. If the general least-squares solution of the system is given by\n\n$\\begin{bmatrix}a \\\\ 0\\end{bmatrix} + x_{2}\\begin{bmatrix}b \\\\ c\\end{bmatrix}, x_{2} ∈ R$\n\nwhat is the value of $30a + \\frac{b}{c}$?"}]}
