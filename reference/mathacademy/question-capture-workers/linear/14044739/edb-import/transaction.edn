\\\  & =-2(v\\cdot w)+u\\cdot v \\\\  & =-2(2\\cdot (-2)+0\\cdot 1+(-2)\\cdot 0+(-1)\\cdot 1) \\\\  & +(2\\cdot 2+(-1)\\cdot 0+3\\cdot (-2)+5\\cdot (-1)) \\\\  & =-2(-4+0+0-1)+(4+0-6-5) \\\\  & =10-7 \\\\  & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-74180/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bc757fa2-12ce-5a1c-a524-8eb256842079"] :knowledge-point/questions ["q-74180"] :db/ensure [:knowledge-point/validate]} {:db/id "q-140125/selection/286fb92e9ba180b012d241bb7e762701483c9c864420d9df6597147f2e2fb458" :answer/id #uuid "c1918eb1-b3e1-5368-8cff-16767769ca9c" :answer/type :answer.type/math :answer/value "28" :db/ensure [:answer/validate]} {:db/id "q-140125/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45" :answer/id #uuid "998d878f-2bf9-5e14-9237-a1d64e50ccf7" :answer/type :answer.type/math :answer/value "-12" :db/ensure [:answer/validate]} {:db/id "q-140125/selection/d96a96abdc1e9cb11d0a0d71be06b4ce2d227c2ce942166397cebefc847136b5" :answer/id #uuid "cdcf8754-1699-5f06-aa53-be265f9827b4" :answer/type :answer.type/math :answer/value "-58" :db/ensure [:answer/validate]} {:db/id "q-140125/selection/595968c9c77f47025fc7d67454c0aedd72cbf36dc2aa59ca3f488e1ff8cdc038" :answer/id #uuid "842ecc25-9557-5c66-a5da-ae25e705113a" :answer/type :answer.type/math :answer/value "-62" :db/ensure [:answer/validate]} {:db/id "q-140125/selection/12b7d840a997b0af25896f37c76d366155c72a970c1525c62ec119b69786f393" :answer/id #uuid "e2805279-538c-5444-9ce2-5b78dfd01067" :answer/type :answer.type/math :answer/value "13" :db/ensure [:answer/validate]} {:db/id "q-140125/selection" :answer-field/id #uuid "39c93119-93b3-5f19-a158-d5f3170fc867" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-140125/selection/286fb92e9ba180b012d241bb7e762701483c9c864420d9df6597147f2e2fb458" :answer-field/choices ["q-140125/selection/286fb92e9ba180b012d241bb7e762701483c9c864420d9df6597147f2e2fb458" "q-140125/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45" "q-140125/selection/d96a96abdc1e9cb11d0a0d71be06b4ce2d227c2ce942166397cebefc847136b5" "q-140125/selection/595968c9c77f47025fc7d67454c0aedd72cbf36dc2aa59ca3f488e1ff8cdc038" "q-140125/selection/12b7d840a997b0af25896f37c76d366155c72a970c1525c62ec119b69786f393"] :db/ensure [:answer-field/validate]} {:db/id "q-140125" :question/id #uuid "24f523eb-fc00-5d09-a560-8d4fb04957ea" :question/math-academy-id "q-140125" :question/problem "Let $u=[\\begin{aligned}5 \\\\ 1 \\\\ -3 \\\\ 3\\end{aligned}],v=[\\begin{aligned}-4 \\\\ -2 \\\\ 2 \\\\ -4\\end{aligned}]$ and $w=[\\begin{aligned}1 \\\\ -5 \\\\ 2 \\\\ 2\\end{aligned}]$ be vectors such that $u\\,⊥\\,w.$ Find $(w+v)\\cdot (2u+3w).$" :question/worked-solution "Since $u$ and $w$ are orthogonal vectors, we have that $u\\cdot w=0.$ Therefore, using linearity of the dot product to expand the parentheses, we have\n\n$$\n\\begin{aligned}(w+v)\\cdot (2u+3w) & =2(w\\cdot u)+2(v\\cdot u)+3(w\\cdot w)+3(v\\cdot w) \\\\  & =0+2(v\\cdot u)+3(w\\cdot w)+3(v\\cdot w) \\\\  & =2(v\\cdot u)+3(w\\cdot w)+3(v\\cdot w) \\\\  & =2(-4\\cdot 5+(-2)\\cdot 1+2\\cdot (-3)+(-4)\\cdot 3) \\\\  & +3(1\\cdot 1+(-5)\\cdot (-5)+2\\cdot 2+2\\cdot 2) \\\\  & +3(-4\\cdot 1+(-2)\\cdot (-5)+2\\cdot 2+(-4)\\cdot 2) \\\\  & =2(-40)+3(34)+3(2) \\\\  & =-80+102+6 \\\\  & =28.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-140125/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bc757fa2-12ce-5a1c-a524-8eb256842079"] :knowledge-point/questions ["q-140125"] :db/ensure [:knowledge-point/validate]} {:db/id "q-39292/selection/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" :answer/id #uuid "19127bdd-b733-5880-878a-596769b4461f" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "q-39292/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer/id #uuid "cc48d389-92f8-591e-98fd-bb73d96edce0" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "q-39292/selection/ca566c3861ad95266b92d3d8e36c85c39daf1d1780cc1bf826ae0ac7accce583" :answer/id #uuid "2e12668a-0cec-5437-a009-1f649f37fd7a" :answer/type :answer.type/math :answer/value "45" :db/ensure [:answer/validate]} {:db/id "q-39292/selection/94b1e608a1bece13c117321c62644f2051416b0003719c2dd4b9ea44af9d6b64" :answer/id #uuid "5e8d3ad1-372c-5d77-8513-db5f09812807" :answer/type :answer.type/math :answer/value "-28" :db/ensure [:answer/validate]} {:db/id "q-39292/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "f200254a-7c0a-57f0-84e2-5eb2a7be5224" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-39292/selection" :answer-field/id #uuid "50c11be6-72c9-5458-8f76-18c1f15c36ce" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-39292/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-39292/selection/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" "q-39292/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" "q-39292/selection/ca566c3861ad95266b92d3d8e36c85c39daf1d1780cc1bf826ae0ac7accce583" "q-39292/selection/94b1e608a1bece13c117321c62644f2051416b0003719c2dd4b9ea44af9d6b64" "q-39292/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-39292" :question/id #uuid "ec29a877-905c-572a-b48b-a0c1a6d38c5b" :question/math-academy-id "q-39292" :question/problem "Let $u=[\\begin{aligned}1 \\\\ -3 \\\\ 2 \\\\ 4\\end{aligned}],v=[\\begin{aligned}3 \\\\ -1 \\\\ 5 \\\\ -2\\end{aligned}]$ and $w=[\\begin{aligned}2 \\\\ 4 \\\\ -1 \\\\ 3\\end{aligned}]$ be vectors such that $u\\,⊥\\,w.$ Find $(u+v)\\cdot w+u\\cdot (v+w).$" :question/worked-solution "Since $u$ and $w$ are orthogonal vectors, we have that $u\\cdot w=0.$ Therefore, using linearity of the dot product to expand the parentheses, we have\n\n$$\n\\begin{aligned}(u+v)\\cdot w+u\\cdot (v+w) & =u\\cdot w+v\\cdot w+u\\cdot v+u\\cdot w \\\\  & =0+v\\cdot w+u\\cdot v+0 \\\\  & =v\\cdot w+u\\cdot v \\\\  & =(3\\cdot 2+(-1)\\cdot 4+5\\cdot (-1)+(-2)\\cdot 3) \\\\  & +(1\\cdot 3+(-3)\\cdot (-1)+2\\cdot 5+4\\cdot (-2)) \\\\  & =(6-4-5-6)+(3+3+10-8) \\\\  & =-9+8 \\\\  & =-1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-39292/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bc757fa2-12ce-5a1c-a524-8eb256842079"] :knowledge-point/questions ["q-39292"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74195/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "2a51c2f8-f406-52ce-894a-c35794dd12a3" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-74195/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "8cdecc2f-5846-5705-9b1f-72ced2be3fbd" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-74195/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "27852ccd-8631-5f16-b4ac-1dbbd4b18b7c" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-74195/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "b2d6032f-9bb5-5975-9d47-64bb15098761" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-74195/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "dee88e56-7735-5124-bbec-e71d1e575f0a" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-74195/selection" :answer-field/id #uuid "fdf62017-d86b-5fdb-b047-cf784dcab5d5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74195/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-74195/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-74195/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-74195/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-74195/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-74195/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-74195" :question/id #uuid "4d69dffe-6275-5f8b-9994-a10185340e9a" :question/math-academy-id "q-74195" :question/problem "Let $u=[\\begin{aligned}a \\\\ 0 \\\\ b \\\\ 1\\end{aligned}],v=[\\begin{aligned}1 \\\\ 3 \\\\ 1 \\\\ -2\\end{aligned}],$ and $w=[\\begin{aligned}-1 \\\\ 1 \\\\ 2 \\\\ 5\\end{aligned}]$ be vectors such that $u$ is orthogonal to $v$ and $w.$ What is the value of $a-b?$" :question/worked-solution "Given that $u$ is orthogonal to $v$ and $w$, we have\n\n$$\n{\\begin{aligned}u\\cdot v=0 \\\\ u\\cdot w=0.\\end{aligned}\n$$\n\nLet's consider the first equation $u\\cdot v=0.$ Calculating the dot product in terms of $a$ and $b$, we get\n\n$$\n\\begin{aligned}u\\cdot v & =0 \\\\ a\\cdot 1+0\\cdot 3+b\\cdot 1+1\\cdot (-2) & =0 \\\\ a+0+b-2 & =0 \\\\ a+b & =2.\\end{aligned}\n$$\n\nSimilarly, for the second equation $u\\cdot w=0$, we obtain\n\n$$\n\\begin{aligned}u\\cdot w & =0 \\\\ a\\cdot (-1)+0\\cdot 1+b\\cdot 2+1\\cdot 5 & =0 \\\\ -a+0+2b+5 & =0 \\\\ -a+2b & =-5.\\end{aligned}\n$$\n\nSo, to find the values of $a$ and $b$, we need to solve the system\n\n$$\n{\\begin{aligned}a+b=2 \\\\ -a+2b=-5.\\end{aligned}\n$$\n\nAdding the first equation to the second equation, we obtain\n\n$$\n3b=-3\\,⟹\\,b=-1.\n$$\n\nSubstituting $b=-1$ into the first equation, we get\n\n$$\n\\begin{aligned}a+(-1) & =2 \\\\ a & =3.\\end{aligned}\n$$\n\nFinally, we have that\n\n$$\na-b=3-(-1)=4.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-74195/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8e02a242-6ef9-574a-be2a-2b68b35d761c"] :knowledge-point/questions ["q-74195"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74192/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "58757990-c15e-5143-ab90-7247e4d172f8" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-74192/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "66457cb8-ec90-594b-80be-b083595d301e" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-74192/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "950e9dda-a450-5588-b8ba-d65031016ccb" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-74192/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "309d4fda-f423-5c7c-acdd-e8ceab96267c" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-74192/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "9c2ac2da-706c-53ee-981a-d4ec4aedcbae" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-74192/selection" :answer-field/id #uuid "2fc43d54-3467-56e3-b1b8-e84e8a0ebb97" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74192/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer-field/choices ["q-74192/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-74192/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-74192/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-74192/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-74192/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473"] :db/ensure [:answer-field/validate]} {:db/id "q-74192" :question/id #uuid "47e230b4-36cd-5480-a2a4-06667e6b2955" :question/math-academy-id "q-74192" :question/problem "Let $u=[\\begin{aligned}2 \\\\ a \\\\ b \\\\ 5\\end{aligned}],v=[\\begin{aligned}-2 \\\\ 1 \\\\ 5 \\\\ -2\\end{aligned}],$ and $w=[\\begin{aligned}1 \\\\ 4 \\\\ -1 \\\\ 1\\end{aligned}]$ be vectors such that $u⊥v$ and $u⊥w.$ What is the value of $a-b?$" :question/worked-solution "Given that $u⊥v$ and $u⊥w$, we have\n\n$$\n{\\begin{aligned}u\\cdot v=0 \\\\ u\\cdot w=0.\\end{aligned}\n$$\n\nLet's consider the first equation $u\\cdot v=0.$ Calculating the dot product in terms of $a$ and $b$, we get\n\n$$\n\\begin{aligned}u\\cdot v & =0 \\\\ 2\\cdot (-2)+a\\cdot 1+b\\cdot 5+5\\cdot (-2) & =0 \\\\ -4+a+5b-10 & =0 \\\\ a+5b & =14.\\end{aligned}\n$$\n\nSimilarly, for the second equation $u\\cdot w=0$, we obtain\n\n$$\n\\begin{aligned}u\\cdot w & =0 \\\\ 2\\cdot 1+a\\cdot 4+b\\cdot (-1)+5\\cdot 1 & =0 \\\\ 2+4a-b+5 & =0 \\\\ 4a-b & =-7.\\end{aligned}\n$$\n\nSo, to find the values of $a$ and $b$, we need to solve the system\n\n$$\n\\begin{aligned}{\\begin{aligned}a+5b=14 \\\\ 4a-b=-7\\end{aligned}\\end{aligned}\n$$\n\nMultiplying the first equation by $-4$ and adding the result to the second equation, we obtain\n\n$$\n\\begin{aligned}-21b=-63\\,⟹\\,b=3.\\end{aligned}\n$$\n\nSubstituting $b=3$ into the first equation, we get\n\n$$\n\\begin{aligned}a+5(3) & =14 \\\\ a+15 & =14 \\\\ a & =-1.\\end{aligned}\n$$\n\nFinally, we have that\n\n$$\na-b=-1-3=-4.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-74192/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8e02a242-6ef9-574a-be2a-2b68b35d761c"] :knowledge-point/questions ["q-74192"] :db/ensure [:knowledge-point/validate]} {:db/id "q-40026/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "b85facc2-1922-5508-8ad9-a71fe8a54107" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-40026/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "3285e49c-ebb7-5dec-88de-8f9b57bf04e1" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-40026/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "addcba50-8d8f-5f9b-bf3e-e3a3d230929e" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-40026/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "da55f710-773e-5ec4-95f1-35e5b2bd9307" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-40026/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "f18315c4-cc7c-5c58-8bb9-b91c029f2181" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-40026/selection" :answer-field/id #uuid "1316463f-463c-58ac-bba9-501f4734a098" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-40026/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-40026/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-40026/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-40026/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-40026/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-40026/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff"] :db/ensure [:answer-field/validate]} {:db/id "q-40026" :question/id #uuid "bba5886f-2418-59b8-9a3e-79459f4614a4" :question/math-academy-id "q-40026" :question/problem "Let $u=[\\begin{aligned}1 \\\\ a \\\\ 3 \\\\ 2\\end{aligned}],v=[\\begin{aligned}b \\\\ -3 \\\\ -2 \\\\ -4\\end{aligned}],$ and $w=[\\begin{aligned}5 \\\\ 6 \\\\ b+1 \\\\ 5\\end{aligned}]$ be vectors such that $u⊥v$ and $u⊥w.$ What is the value of $a+b?$" :question/worked-solution "Given that $u⊥v$ and $u⊥w$, we have\n\n$$\n{\\begin{aligned}u\\cdot v=0 \\\\ u\\cdot w=0.\\end{aligned}\n$$\n\nLet's consider the first equation $u\\cdot v=0.$ Calculating the dot product in terms of $a$ and $b$, we get\n\n$$\n\\begin{aligned}u\\cdot v & =0 \\\\ 1\\cdot b+a\\cdot (-3)+3\\cdot (-2)+2\\cdot (-4) & =0 \\\\ b-3a-6-8 & =0 \\\\ b-3a & =14.\\end{aligned}\n$$\n\nSimilarly, for the second equation $u\\cdot w=0$, we obtain\n\n$$\n\\begin{aligned}u\\cdot w & =0 \\\\ 1\\cdot 5+a\\cdot 6+3\\cdot (b+1)+2\\cdot 5 & =0 \\\\ 5+6a+3b+3+10 & =0 \\\\ 6a+3b & =-18 \\\\ 2a+b & =-6.\\end{aligned}\n$$\n\nSo, to find the values of $a$ and $b$, we need to solve the system\n\n$$\n{\\begin{aligned}-3a+b=14 \\\\ 2a+b=-6.\\end{aligned}\n$$\n\nMultiplying the first equation by $-1$ and adding the result to the second equation, we obtain\n\n$$\n5a=-20\\,⟹\\,a=-4.\n$$\n\nSubstituting $a=-4$ into the first equation, we get\n\n$$\n\\begin{aligned}-3(-4)+b & =14 \\\\ 12+b & =14 \\\\ b & =14-12 \\\\ b & =2.\\end{aligned}\n$$\n\nFinally, we have that\n\n$$\na+b=-4+2=-2.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-40026/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8e02a242-6ef9-574a-be2a-2b68b35d761c"] :knowledge-point/questions ["q-40026"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-39337"] :question/problem "Let $u=[\\begin{aligned}a \\\\ 3 \\\\ b \\\\ -5\\end{aligned}],v=[\\begin{aligned}2 \\\\ -5 \\\\ 3 \\\\ -4\\end{aligned}],$ and $w=[\\begin{aligned}-4 \\\\ -2 \\\\ 5 \\\\ 3\\end{aligned}]$ be vectors such that $u$ is orthogonal to $v$ and $w.$ What is the value of $a+b?$" :question/worked-solution "Given that $u$ is orthogonal to $v$ and $w$, we have\n\n$$\n{\\begin{aligned}u\\cdot v=0 \\\\ u\\cdot w=0.\\end{aligned}\n$$\n\nLet's consider the first equation $u\\cdot v=0.$ Calculating the dot product in terms of $a$ and $b$, we get\n\n$$\n\\begin{aligned}u\\cdot v & =0 \\\\ a\\cdot 2+3\\cdot (-5)+b\\cdot 3+(-5)\\cdot (-4) & =0 \\\\ 2a-15+3b+20 & =0 \\\\ 2a+3b & =-5.\\end{aligned}\n$$\n\nSimilarly, for the second equation $u\\cdot w=0$, we obtain\n\n$$\n\\begin{aligned}u\\cdot w & =0 \\\\ a\\cdot (-4)+3\\cdot (-2)+b\\cdot 5+(-5)\\cdot 3 & =0 \\\\ -4a-6+5b-15 & =0 \\\\ -4a+5b & =21.\\end{aligned}\n$$\n\nSo, to find the values of $a$ and $b$, we need to solve the system\n\n$$\n{\\begin{aligned}2a+3b=-5 \\\\ -4a+5b=21.\\end{aligned}\n$$\n\nMultiplying the first equation by $2$ and adding the result to the second equation, we obtain\n\n$$\n11b=11\\,⟹\\,b=1.\n$$\n\nSubstituting $b=1$ into the first equation, we get\n\n$$\n\\begin{aligned}2a+3(1) & =-5 \\\\ 2a+3 & =-5 \\\\ 2a & =-8 \\\\ a & =-4.\\end{aligned}\n$$\n\nFinally, we have that\n\n$$\na+b=-4+1=-3.\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-40024"] :question/problem "Let $u=[\\begin{aligned}-3 \\\\ a \\\\ b \\\\ -4\\end{aligned}],v=[\\begin{aligned}3 \\\\ 4 \\\\ 1 \\\\ 1\\end{aligned}],$ and $w=[\\begin{aligned}1 \\\\ 1 \\\\ -3 \\\\ -4\\end{aligned}]$ be vectors such that $u⊥v$ and $u⊥w.$ What is the value of $a+b?$" :question/worked-solution "Given that $u⊥v$ and $u⊥w$, we have\n\n$$\n{\\begin{aligned}u\\cdot v=0 \\\\ u\\cdot w=0.\\end{aligned}\n$$\n\nLet's consider the first equation $u\\cdot v=0.$ Calculating the dot product in terms of $a$ and $b$, we get\n\n$$\n\\begin{aligned}u\\cdot v & =0 \\\\ -3\\cdot 3+a\\cdot 4+b\\cdot 1-4\\cdot 1 & =0 \\\\ -9+4a+b-4 & =0 \\\\ 4a+b & =13.\\end{aligned}\n$$\n\nSimilarly, for the second equation $u\\cdot w=0$, we obtain\n\n$$\n\\begin{aligned}u\\cdot w & =0 \\\\ -3\\cdot 1+a\\cdot 1+b\\cdot (-3)-4\\cdot (-4) & =0 \\\\ -3+a-3b+16 & =0 \\\\ a-3b & =-13.\\end{aligned}\n$$\n\nSo, to find the values of $a$ and $b$, we need to solve the system\n\n$$\n\\begin{aligned}{\\begin{aligned}4a+b=13 \\\\ a-3b=-13\\end{aligned}\\end{aligned}\n$$\n\nMultiplying the first equation by $3$ and adding the result to the second equation, we obtain\n\n$$\n\\begin{aligned}13a=26\\,⟹\\,a=2.\\end{aligned}\n$$\n\nSubstituting $a=2$ into the first equation, we get\n\n$$\n\\begin{aligned}4(2)+b & =13 \\\\ 8+b & =13 \\\\ b & =5.\\end{aligned}\n$$\n\nFinally, we have that\n\n$$\na+b=2+5=7.\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5909"] :question/problem "Given the vector ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044739/assets/b8e1e42d3c85f7b3783a0c46d5075e0c588f22a030f3d6a84da9ad3444ad35d0.png), which of the following vectors are orthogonal to $\\mathbf{u}$?\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044739/assets/6e69c8002a518487ce4821efe1faae85ba7ec365b1bedf23d7bfcd30e10e42b5.png)" :question/worked-solution "We compute the dot product between $\\mathbf{u}$ and each of the listed vectors:\n\n$$\n\\begin{aligned}u\\cdot v & ={u}_{1}\\cdot {v}_{1}+{u}_{2}\\cdot {v}_{2}+{u}_{3}\\cdot {v}_{3}+{u}_{4}\\cdot {v}_{4} \\\\  & =(-5)\\cdot 1+(-3)\\cdot (-3)+2\\cdot (-4)+0\\cdot 9 \\\\  & =-5+9-8+0 \\\\  & =-4.\\,\\times \\end{aligned}\n$$\n\n$$\n\\begin{aligned}u\\cdot w & ={u}_{1}\\cdot {w}_{1}+{u}_{2}\\cdot {w}_{2}+{u}_{3}\\cdot {w}_{3}+{u}_{4}\\cdot {w}_{4} \\\\  & =(-5)\\cdot 2+(-3)\\cdot 2+2\\cdot 8+0\\cdot 3 \\\\  & =-10-6+16+0 \\\\  & =0.\\,✓\\end{aligned}\n$$\n\n$$\n\\begin{aligned}u\\cdot x & ={u}_{1}\\cdot {x}_{1}+{u}_{2}\\cdot {x}_{2}+{u}_{3}\\cdot {x}_{3}+{u}_{4}\\cdot {x}_{4} \\\\  & =(-5)\\cdot 2+(-3)\\cdot (-4)+2\\cdot (-8)+0\\cdot 6 \\\\  & =-10+12-16+0 \\\\  & =-14.\\,\\times \\end{aligned}\n$$\n\nConsequently, the correct answer is $\\mathbf{w}$ only." :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5551"] :question/problem "If ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044739/assets/16e82b08842bdec1de657e14110b08037cca4452d1f0e8c64a8fd783037adeb6.png) and ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044739/assets/559785dc3071ba5018f9b97d45e18e9f7bf937f702f9eeaf0a9c5ae087d5b43f.png) are orthogonal vectors, find the value of $k.$" :question/worked-solution "Since $\\mathbf{u}$ and $\\mathbf{v}$ are orthogonal vectors, we have that their dot product is equal to zero.\nFirst, let's calculate the dot product in terms of $k$:\n\n$$\n\\begin{aligned}u\\cdot v & ={u}_{1}\\cdot {v}_{1}+{u}_{2}\\cdot {v}_{2}+{u}_{3}\\cdot {v}_{3}+{u}_{4}\\cdot {v}_{4} \\\\  & =5\\cdot (-4)+(-3)\\cdot 6+k\\cdot (-6)+(-2)\\cdot 8 \\\\  & =-20-18-6k-16 \\\\  & =-6k-54.\\end{aligned}\n$$\n\nEquating the last line to zero, we have\n\n$$\n\\begin{aligned}-6k-54 & =0 \\\\ -6k & =54 \\\\ k & =-9.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5552"] :question/problem "Let ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044739/assets/61cb89adc9a0cce6a434c41be5d2d1799e01e94bebe1b4f44d48bc011c1a349b.png) and ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044739/assets/00af13e5017635a0b333ecd5fc2bfc761c9612427b8a3986ba48fa904ff2eed0.png) be vectors such that $\\mathbf{u} \\!\\perp\\! \\mathbf{w}$. Find $(\\mathbf{u}+\\mathbf{v})\\cdot \\mathbf{w} + \\mathbf{u}\\cdot(\\mathbf{v}+ \\mathbf{w}).$" :question/worked-solution "Since $\\mathbf{u}$ and $\\mathbf{w}$ are orthogonal vectors, we have that $\\mathbf{u}\\cdot\\mathbf{w}=0$. Therefore, using linearity of the dot product to expand the parentheses, we have\n\n$$\n\\begin{aligned}(u+v)\\cdot w+u\\cdot (v+w) & =u\\cdot w+v\\cdot w+u\\cdot v+u\\cdot w \\\\  & =0+v\\cdot w+u\\cdot v+0 \\\\  & =v\\cdot w+u\\cdot v \\\\  & =(2\\cdot (-1)+(-3)\\cdot 3+4\\cdot 1) \\\\  & +((-1)\\cdot 2+(-2)\\cdot (-3)+5\\cdot 4)\\, \\\\  & =(-2-9+4)+(-2+6+20) \\\\  & =-7+24 \\\\  & =17.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5553"] :question/problem "Let ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044739/assets/618da6573504088a90064c503b3603f9c1cbedaee493473db435765ca635bdb9.png) and ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044739/assets/a71f47b53dab435e794fa5c4c889141b8ce32c93715abd56e0dc48d6535865b8.png) be vectors such that $\\mathbf{u}$ is orthogonal to $\\mathbf{v}$ and $\\mathbf{w}$. What is the value of $a+b?$" :question/worked-solution "Given that $\\mathbf{u}$ is orthogonal to $\\mathbf{v}$ and $\\mathbf{w}$, we have\n\n$$\n{\\begin{aligned}u\\cdot v=0 \\\\ u\\cdot w=0.\\end{aligned}\n$$\n\nLet's consider the first equation $\\mathbf{u}\\cdot\\mathbf{v}=0$. Calculating the dot product in terms of $a$ and $b$, we get\n\n$$\n\\begin{aligned}u\\cdot v & =0 \\\\ -8\\cdot 6+a\\cdot (-15)+b\\cdot 9+(-10)\\cdot (-12) & =0 \\\\ -48-15a+9b+120 & =0 \\\\ -15a+9b & =-72 \\\\ -5a+3b & =-24.\\end{aligned}\n$$\n\nSimilarly, for the second equation $\\mathbf{u}\\cdot\\mathbf{w}=0$, we obtain\n\n$$\n\\begin{aligned}u\\cdot w & =0 \\\\ -8\\cdot 4+a\\cdot 2+b\\cdot (-5)+(-10)\\cdot (-3) & =0 \\\\ -32+2a-5b+30 & =0 \\\\ 2a-5b & =2.\\end{aligned}\n$$\n\nSo, to find the values of $a$ and $b$, we need to solve the system\n\n$$\n\\begin{aligned}{\\begin{aligned}-5a+3b=-24 \\\\ 2a-5b=2.\\end{aligned}\\end{aligned}\n$$\n\nMultiplying the first equation by $2$ and the second equation by $5$, we get\n\n$$\n{\\begin{aligned}-10a+6b=-48 \\\\ 10a-25b=10.\\end{aligned}\n$$\n\nNow, adding the above equations, we obtain\n\n$$\n-19b = -38 \\qquad\\Longrightarrow\\qquad b = 2.\n$$\n\nSubstituting $b = 2$ into the second equation, we obtain\n\n$$\n\\begin{aligned}2a-5(2) & =2 \\\\ 2a-10 & =2 \\\\ 2a & =12 \\\\ a & =6.\\end{aligned}\n$$\n\nFinally, we have that\n\n$$\na+b = 6 + 2 = 8.\n$$" :db/ensure [:question/validate]}]
