cdot (-1)+(-1)\\cdot 2+3\\cdot 0+2\\cdot 1 \\\\  & =0-2+0+2 \\\\  & =0.\\,✓\\end{aligned}\n$$\n\n$$\n\\begin{aligned}u\\cdot x & ={u}_{1}\\cdot {x}_{1}+{u}_{2}\\cdot {x}_{2}+{u}_{3}\\cdot {x}_{3}+{u}_{4}\\cdot {x}_{4} \\\\  & =0\\cdot 0+(-1)\\cdot 1+3\\cdot (-3)+2\\cdot (-2) \\\\  & =0-1-9-4 \\\\  & =-14.\\,\\times \\end{aligned}\n$$\n\nConsequently, the correct option is $v$ and $w$ only." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-74077/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ce8958e6-c578-572f-8b34-5513b6f64a51"] :knowledge-point/questions ["q-74077"] :db/ensure [:knowledge-point/validate]} {:db/id "q-39914/selection/a3222ba97b3db4534f8736c7852f280d2d0dcf9680ab5a55e7024ddb5ca4adb8" :answer/id #uuid "b2b050f2-162e-5426-ae50-cfcfa4ed67e5" :answer/type :answer.type/text :answer/value "$v$  only" :db/ensure [:answer/validate]} {:db/id "q-39914/selection/bfbf91f109f6c4c7b8242ca2b1bf4bae476945344d0e5e07bf789ea29825342a" :answer/id #uuid "52cc3309-fcbd-5f55-9ebc-f0fdf1defd55" :answer/type :answer.type/text :answer/value "$v$ and $w$ only" :db/ensure [:answer/validate]} {:db/id "q-39914/selection/c697a5dc7422c431e6e3043f66b73fae4a68a519aa87f9d288564a9d244fdfef" :answer/id #uuid "35319915-d299-5648-a2d7-606689197a68" :answer/type :answer.type/text :answer/value "$v$ and $x$ only" :db/ensure [:answer/validate]} {:db/id "q-39914/selection/b9681a1e95ee1598798bd94959bf7e8676d0f47ee698beab3489da892a7193c3" :answer/id #uuid "bd5146ae-08d9-5498-b8f7-150056b0d92e" :answer/type :answer.type/text :answer/value "All of the listed" :db/ensure [:answer/validate]} {:db/id "q-39914/selection/c0e37a968afadd62cb3b5a7e7eddf06985ecdb34d9b1cddcb49cf57ae95de8d8" :answer/id #uuid "07d35ab7-3902-5cca-a90a-47a11a44e824" :answer/type :answer.type/text :answer/value "$w$ and $x$ only" :db/ensure [:answer/validate]} {:db/id "q-39914/selection" :answer-field/id #uuid "c2625d1a-d4dc-5270-9f4e-bb30b28f6167" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-39914/selection/c0e37a968afadd62cb3b5a7e7eddf06985ecdb34d9b1cddcb49cf57ae95de8d8" :answer-field/choices ["q-39914/selection/a3222ba97b3db4534f8736c7852f280d2d0dcf9680ab5a55e7024ddb5ca4adb8" "q-39914/selection/bfbf91f109f6c4c7b8242ca2b1bf4bae476945344d0e5e07bf789ea29825342a" "q-39914/selection/c697a5dc7422c431e6e3043f66b73fae4a68a519aa87f9d288564a9d244fdfef" "q-39914/selection/b9681a1e95ee1598798bd94959bf7e8676d0f47ee698beab3489da892a7193c3" "q-39914/selection/c0e37a968afadd62cb3b5a7e7eddf06985ecdb34d9b1cddcb49cf57ae95de8d8"] :db/ensure [:answer-field/validate]} {:db/id "q-39914" :question/id #uuid "c3b5ee57-42d6-5ec3-a568-2cbc9d550a16" :question/math-academy-id "q-39914" :question/problem "Given the vector $u=[\\begin{aligned}1 \\\\ -1 \\\\ 4 \\\\ 3\\end{aligned}]$, which of the following vectors are orthogonal to $u?$\n\n$$\nv=[\\begin{aligned}2 \\\\ -3 \\\\ -1 \\\\ -1\\end{aligned}],\\,w=[\\begin{aligned}5 \\\\ 0 \\\\ -2 \\\\ 1\\end{aligned}],\\,x=[\\begin{aligned}1 \\\\ -2 \\\\ 3 \\\\ -5\\end{aligned}].\n$$" :question/worked-solution "We compute the dot product between $u$ and each of the listed vectors:\n\n$$\n\\begin{aligned}u\\cdot v & ={u}_{1}\\cdot {v}_{1}+{u}_{2}\\cdot {v}_{2}+{u}_{3}\\cdot {v}_{3}+{u}_{4}\\cdot {v}_{4} \\\\  & =1\\cdot 2+(-1)\\cdot (-3)+4\\cdot (-1)+3\\cdot (-1) \\\\  & =2+3-4-3 \\\\  & =-2.\\,\\times \\end{aligned}\n$$\n\n$$\n\\begin{aligned}u\\cdot w & ={u}_{1}\\cdot {w}_{1}+{u}_{2}\\cdot {w}_{2}+{u}_{3}\\cdot {w}_{3}+{u}_{4}\\cdot {w}_{4} \\\\  & =1\\cdot 5+(-1)\\cdot 0+4\\cdot (-2)+3\\cdot 1 \\\\  & =5-8+3 \\\\  & =0.\\,✓\\end{aligned}\n$$\n\n$$\n\\begin{aligned}u\\cdot x & ={u}_{1}\\cdot {x}_{1}+{u}_{2}\\cdot {x}_{2}+{u}_{3}\\cdot {x}_{3}+{u}_{4}\\cdot {x}_{4} \\\\  & =1\\cdot 1+(-1)\\cdot (-2)+4\\cdot 3+3\\cdot (-5) \\\\  & =1+2+12-15 \\\\  & =0.\\,✓\\end{aligned}\n$$\n\nConsequently, the correct option is $w$ and $x$ only." :question/difficulty :question.di