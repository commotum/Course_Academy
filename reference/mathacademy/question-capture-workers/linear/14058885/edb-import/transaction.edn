pe :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -2 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-110302/selection/4a4d5dc689c52862121db8a687182393f3c8b16948fa1548cfaec65ac38675a9" :answer/id #uuid "da6f6324-08a2-581a-aa4f-7d9e81304b27" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-110302/selection/3dcd4fcb94fed378a4f5e04ab5390b616ec8c4723719e766023aa0e5214ed7a0" :answer/id #uuid "4086a6b5-6f6b-52ca-b0df-ab43d96b191e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-110302/selection" :answer-field/id #uuid "ffc6e154-85e9-5b7d-8281-e536fb767bb6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-110302/selection/4a4d5dc689c52862121db8a687182393f3c8b16948fa1548cfaec65ac38675a9" :answer-field/choices ["q-110302/selection/ea4b19594652b92ae236cad9164e7369b353ff01575a3e86fa0a21a6b64ed234" "q-110302/selection/81c38e3a366e2369b53706ce6a996b76d7a8e5444730fbbfc52f10dfc376a84e" "q-110302/selection/7b0bb64936f9793b6f6d14de19a851581927a1ec76543ef26e75a16a490b3884" "q-110302/selection/4a4d5dc689c52862121db8a687182393f3c8b16948fa1548cfaec65ac38675a9" "q-110302/selection/3dcd4fcb94fed378a4f5e04ab5390b616ec8c4723719e766023aa0e5214ed7a0"] :db/ensure [:answer-field/validate]} {:db/id "q-110302" :question/id #uuid "ec2784a1-1617-5b5d-94b7-afb2c0159673" :question/math-academy-id "q-110302" :question/problem "Find the inverse of the elementary matrix \n$E=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & -2 \\\\ 0 & 0 & 1\\end{aligned}].$" :question/worked-solution "We write down $E$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}[E\\,|\\,I\\,] & =[\\begin{aligned}1 & 0 & 0 & 1 & 0 & 0 \\\\ 0 & 1 & -2 & 0 & 1 & 0 \\\\ 0 & 0 & 1 & 0 & 0 & 1\\end{aligned}] &  & {R}_{2}:={R}_{2}+2{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 1 & 0 & 0 \\\\ 0 & 1 & 0 & 0 & 1 & 2 \\\\ 0 & 0 & 1 & 0 & 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nThe inverse is obtained on the right-hand side of our big matrix after the transformation. Therefore, \n\n$$\n{E}^{-1}=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-110302/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "dd71abb1-455e-50d0-aae4-082b41821ef1"] :knowledge-point/questions ["q-110302"] :db/ensure [:knowledge-point/validate]} {:db/id "q-75192/selection/c7306525dfdfa1494cc5fd5e3bf5659ed0c5efe7b58e9078475c55e2dfe40ac6" :answer/id #uuid "a48e4bb0-5067-5785-be1a-2943004b8d16" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-75192/selection/f05e4dc7e8096fe212aa56fa961156357e14e9cec8f7a5ac0071b169fd6ef3d4" :answer/id #uuid "2b12a96d-ab17-5525-a265-9d165b0fba7f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-75192/selection/88899c27c161c90e0dbc1a0fadb0d46008957bc5c28f0f27ff7ac1f226d41498" :answer/id #uuid "6a1c45d5-4afa-5c3d-92bd-9181e6f83d4e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-75192/selection/4d7b9f11a30136dc45b63c6bf8e6211abaa7fec4b9d1a9a71ea6c15b2e517e6e" :answer/id #uuid "3b60f7a0-a85d-58f9-90ef-0c0cb020a871" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & -3 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-75192/selection/0e62d08b3101f