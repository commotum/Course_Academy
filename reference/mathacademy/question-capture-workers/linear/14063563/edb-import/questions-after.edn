#{[{:db/id #edb/ref 17592186346420 :knowledge-point/_questions [{:knowledge-point/id #uuid "ff317cd2-0896-5134-b3a3-4e9f84e22b68" :knowledge-point/title "Calculating the Scalar Triple Product Using a Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b522ef7-3f8b-5c59-b0c8-7c5aadf12179" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186346422} {:answer/id #uuid "61bfc71c-73df-54c6-a87e-f8bec59e4a33" :answer/type {:db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186346423} {:answer/id #uuid "978d879a-c752-50ed-ae4a-87922ffd9fde" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186346424} {:answer/id #uuid "56bd9b55-2d4f-5f8e-a965-b29486106bfd" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186346425} {:answer/id #uuid "2fe82d2f-f231-5e9b-8afb-65150b4fbe9a" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186346426}] :answer-field/correct {:answer/id #uuid "61bfc71c-73df-54c6-a87e-f8bec59e4a33" :answer/type {:db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186346423} :answer-field/id #uuid "aec8f281-5560-5453-9cf9-fb253deb9bc5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186346421}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ecba9148-cd7e-592d-a086-629bf7bd2038" :question/math-academy-id "q-18657" :question/problem "Let $a=⟨-2,0,1⟩$, $b=⟨5,2,-4⟩$ and $c=⟨1,0,3⟩.$ Find $a\\cdot (b\\times c).$" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}-2 & 0 & 1 \\\\ 5 & 2 & -4 \\\\ 1 & 0 & 3\\end{aligned}| \\\\  & =(-2)\\cdot |\\begin{aligned}2 & -4 \\\\ 0 & 3\\end{aligned}|-0\\cdot |\\begin{aligned}5 & -4 \\\\ 1 & 3\\end{aligned}|+1\\cdot |\\begin{aligned}5 & 2 \\\\ 1 & 0\\end{aligned}| \\\\  & =-2(2\\cdot 3-(-4)\\cdot 0)-0+(5\\cdot 0-2\\cdot 1) \\\\  & =-12-0-2 \\\\  & =-14.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106053 :knowledge-point/_questions [{:knowledge-point/id #uuid "3e0b4d33-7699-5068-90f1-663534cd662d" :knowledge-point/title "Calculating Scalar Triple Products Using Its Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96683fd1-3b80-5d4d-8e64-f7d06f8b234b" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186102556} {:answer/id #uuid "9b183dae-b896-5671-a310-3f0a5ae6a800" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186102557} {:answer/id #uuid "9f9637a6-963d-52f1-b2d1-ab95420fa883" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186102558} {:answer/id #uuid "3ce506b1-0d7d-512f-80eb-4a9fdefc9dfd" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186102559} {:answer/id #uuid "5d577453-dcf4-5331-8f9c-f661ba608de3" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186102560}] :answer-field/correct {:answer/id #uuid "9f9637a6-963d-52f1-b2d1-ab95420fa883" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186102558} :answer-field/id #uuid "16102d72-5bbe-5a12-a18f-e980d6f49fbd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186102555}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "9a17a201-87cf-5140-b1f0-a5cb2ce3aff3" :question/math-academy-id "q-20058" :question/problem "Find $b\\cdot (c\\times a)$, if $-a\\cdot (3b\\times (-2c))=24.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}-a\\cdot (3b\\times (-2c)) & =24 \\\\ (-1)\\cdot 3\\cdot (-2)\\cdot [a\\cdot (b\\times c)] & =24 \\\\ a\\cdot (b\\times c) & =4.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}b\\cdot (a\\times c) & =-4,\\end{aligned}\n$$\n\nand again we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}b\\cdot (c\\times a) & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186320511 :knowledge-point/_questions [{:knowledge-point/id #uuid "3e0b4d33-7699-5068-90f1-663534cd662d" :knowledge-point/title "Calculating Scalar Triple Products Using Its Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ea4db494-b535-5332-8dfd-e1a6cb84bad2" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186320513} {:answer/id #uuid "4cd60e94-4471-59aa-8d5a-341d24767cff" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186320514} {:answer/id #uuid "17a880b1-cef0-5350-bd2f-7c6f3007fa1a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186320515} {:answer/id #uuid "066f2ffa-be6f-5705-9855-970c47b1d62b" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186320516} {:answer/id #uuid "5ee5a234-5a67-5cfa-8eb0-bb6b13a781ba" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186320517}] :answer-field/correct {:answer/id #uuid "ea4db494-b535-5332-8dfd-e1a6cb84bad2" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186320513} :answer-field/id #uuid "56d5d249-0116-5ce7-94b8-2a085e5665ab" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186320512}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1d8600d4-a4c5-5015-8326-e85683e967e7" :question/math-academy-id "q-20061" :question/problem "Find $c\\cdot (b\\times a)$, if $3a\\cdot (6b\\times c)=90.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}3a\\cdot (6b\\times c) & =90 \\\\ 3\\cdot 6\\cdot [a\\cdot (b\\times c)] & =90 \\\\ a\\cdot (b\\times c) & =5.\\end{aligned}\n$$\n\nThen, we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a) & =-5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186346427 :knowledge-point/_questions [{:knowledge-point/id #uuid "ff317cd2-0896-5134-b3a3-4e9f84e22b68" :knowledge-point/title "Calculating the Scalar Triple Product Using a Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c5ecfdb-e402-5398-a023-358139ea8488" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186346429}] :answer-field/correct {:answer/id #uuid "8c5ecfdb-e402-5398-a023-358139ea8488" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186346429} :answer-field/id #uuid "9632f951-4e44-5089-ae7f-a3d6c4779422" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186346428}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c0fb786c-c205-5d9a-a424-74286effcd4e" :question/math-academy-id "q-317325" :question/problem "Let $a=⟨-1,-2,3⟩$, $b=⟨4,-1,-2⟩$ and $c=⟨1,2,-3⟩.$ Find $a\\cdot (b\\times c)$ using a determinant.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}-1 & -2 & 3 \\\\ 4 & -1 & -2 \\\\ 1 & 2 & -3\\end{aligned}| \\\\  & =(-1)\\cdot |\\begin{aligned}-1 & -2 \\\\ 2 & -3\\end{aligned}|\\,-\\,(-2)\\cdot |\\begin{aligned}4 & -2 \\\\ 1 & -3\\end{aligned}|\\,+\\,3\\cdot |\\begin{aligned}4 & -1 \\\\ 1 & 2\\end{aligned}| \\\\  & =(-1)\\,((-1)(-3)-(-2)\\cdot 2)\\,-\\,(-2)\\,(4\\cdot (-3)-(-2)\\cdot 1)\\,+\\,3\\,(4\\cdot 2-(-1)\\cdot 1) \\\\  & =(-1)\\,(7)\\,-\\,(-2)\\,(-10)\\,+\\,3\\,(9) \\\\  & =-7-20+27 \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186346430 :knowledge-point/_questions [{:knowledge-point/id #uuid "ff317cd2-0896-5134-b3a3-4e9f84e22b68" :knowledge-point/title "Calculating the Scalar Triple Product Using a Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "329b48ae-1b91-5f67-b48d-81b66a8f8251" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186346432} {:answer/id #uuid "7c9f7e62-cf90-54ea-8ab1-bfe3c6653003" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186346433} {:answer/id #uuid "17db9901-26aa-50c9-a1e7-fcd35135796c" :answer/type {:db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186346434} {:answer/id #uuid "97944679-dcd7-5028-901c-7394f82b1f2e" :answer/type {:db/ident :answer.type/math} :answer/value "-23" :db/id #edb/ref 17592186346435} {:answer/id #uuid "423f504d-0758-59f1-ad52-82baf54fd012" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186346436}] :answer-field/correct {:answer/id #uuid "423f504d-0758-59f1-ad52-82baf54fd012" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186346436} :answer-field/id #uuid "79f78a99-f8c8-533d-8b12-55005d72a784" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186346431}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "03a4c208-a34c-5a3e-b51f-f4be25787fd5" :question/math-academy-id "q-73461" :question/problem "Let $p=⟨3,-2,1⟩$, $q=⟨2,-1,0⟩$ and $r=⟨1,-2,4⟩.$ Find $q\\cdot (r\\times p).$" :question/worked-solution "Remember that the scalar triple product $q\\cdot (r\\times p)$ is just the determinant of the matrix whose rows are given by $q,$ $r,$ and $p.$\n\nSo, we have\n\n$$\n\\begin{aligned}q\\cdot (r\\times p) & =|\\begin{aligned}2 & -1 & 0 \\\\ 1 & -2 & 4 \\\\ 3 & -2 & 1\\end{aligned}| \\\\  & =2\\cdot |\\begin{aligned}-2 & 4 \\\\ -2 & 1\\end{aligned}|-(-1)\\cdot |\\begin{aligned}1 & 4 \\\\ 3 & 1\\end{aligned}|+0\\cdot |\\begin{aligned}1 & -2 \\\\ 3 & -2\\end{aligned}| \\\\  & =2((-2)\\cdot 1-4\\cdot (-2))+(1\\cdot 1-4\\cdot 3) \\\\  & =12-11 \\\\  & =1.\\end{aligned}\n$$"}]}
