-20061" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "6"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043174/state.json" "file_sha256" "2c740817138252b31db0face977eca67daef6bbe4c4d996a8bd6d165ee9afa8a" "basis" 1617 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043174/edb-import/verification.json"}] "sources" [{"question" "q-18657" "field" nil "attribute" "question/problem" "value" "Let $a=⟨-2,0,1⟩$, $b=⟨5,2,-4⟩$ and $c=⟨1,0,3⟩.$ Find $a\\cdot (b\\times c).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063563/state.json" "file_sha256" "a066e8b9c5217c2e4d6d6ad74db52b80b8bb1d57a7398e7db6653ae63a6a3951"} {"question" "q-18657" "field" nil "attribute" "question/worked-solution" "value" "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}-2 & 0 & 1 \\\\ 5 & 2 & -4 \\\\ 1 & 0 & 3\\end{aligned}| \\\\  & =(-2)\\cdot |\\begin{aligned}2 & -4 \\\\ 0 & 3\\end{aligned}|-0\\cdot |\\begin{aligned}5 & -4 \\\\ 1 & 3\\end{aligned}|+1\\cdot |\\begin{aligned}5 & 2 \\\\ 1 & 0\\end{aligned}| \\\\  & =-2(2\\cdot 3-(-4)\\cdot 0)-0+(5\\cdot 0-2\\cdot 1) \\\\  & =-12-0-2 \\\\  & =-14.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063563/state.json" "file_sha256" "a066e8b9c5217c2e4d6d6ad74db52b80b8bb1d57a7398e7db6653ae63a6a3951"} {"question" "q-18657" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063563/activity-metadata.json" "file_sha256" "af35383cc1a74dd005ae77c16be10f81b3262271c9ac4868029b69d42bcb551f"} {"question" "q-18657" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063563/state.json" "file_sha256" "a066e8b9c5217c2e4d6d6ad74db52b80b8bb1d57a7398e7db6653ae63a6a3951"} {"question" "q-18657" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-14"] ["math" "-2"] ["math" "0"] ["math" "12"] ["math" "2"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063563/state.json" "file_sha256" "a066e8b9c5217c2e4d6d6ad74db52b80b8bb1d57a7398e7db6653ae63a6a3951"} {"question" "q-18657" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-14"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063563/state.json" "file_sha256" "a066e8b9c5217c2e4d6d6ad74db52b80b8bb1d57a7398e7db6653ae63a6a3951"} {"question" "q-20058" "field" nil "attribute" "question/problem" "value" "Find $b\\cdot (c\\times a)$, if $-a\\cdot (3b\\times (-2c))=24.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063563/state.json" "file_sha256" "a066e8b9c5217c2e4d6d6ad74db52b80b8bb1d57a7398e7db6653ae63a6a3951"} {"question" "q-20058" "field" nil "attribute" "question/worked-solution" "value" "First, we factor out the constants and get\n\n$$\n\\begin{aligned}-a\\cdot (3b\\times (-2c)) & =24 \\\\ (-1)\\cdot 3\\cdot (-2)\\cdot [a\\cdot (b\\times c)] & =24 \\\\ a\\cdot (b\\times c) & =4.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}b\\cdot (a\\times c) & =-4,\\end{aligned}\n$$\n\nand again we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}b\\cdot (c\\times a) & =4.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063563/state.json" "file_sha256" "a066e8b9c5217c2e4d6d6ad74db52b80b8bb1d57a7398e7db6653ae63a6a3951"} {"question" "q-20058" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063563/activity-metadata.json" "file_sha256" "af35383cc1a74dd005ae77c16be10f81b3262271c9ac4868029b69d42bcb551f"} {"question" "q-20058" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063563/state.json" "file_sha256" "a066e8b9c5217c2e4d6d6ad74db52b80b8bb1d57a7398e7db6653ae63a6a3951"} {"question" "q-20058" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-4"] ["math" "-6"] ["math" "4"] ["math" "6"] ["math" "8"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063563/state.json" "file_sha256" "a066e8b9c5217c2e4d6d6ad74db52b80b8bb1d57a7398e7db6653ae63a6a3951"} {"question" "q-20058" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "4"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063563/state.json" "file_sha256" "a066e8b9c5217c2e4d6d6ad74db52b80b8bb1d57a7398e7db6653ae63a6a3951"} {"question" "q-20061" "field" nil "attribute" "question/problem" "value" "Find $c\\cdot (b\\times a)$, if $3a\\cdot (6b\\times c)=90.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063563/state.json" "file_sha256" "a066e8b9c5217c2e4d6d6ad74db52b80b8bb1d57a7398e7db6653ae63a6a3951"} {"question" "q-20061" "field" nil "attribute" "question/worked-solution" "value" "First, we factor out the constants and get\n\n$$\n\\begin{aligned}3a\\cdot (6b\\times c) & =90 \\\\ 3\\cdot 6\\cdot [a\\cdot (b\\times c)] & =90 \\\\ a\\cdot (b\\times c) & =5.\\end{aligned}\n$$\n\nThen, we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a) & =-5.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063563/state.json" "file_sha256" "a066e8b9c5217c2e4d6d6ad74db52b80b8bb1d57a7398e7db6653ae63a6a3951"} {"question" "q-20061" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063563/activity-metadata.json" "file_sha256" "af35383cc1a74dd005ae77c16be10f81b3262271c9ac4868029b69d42bcb551f"} {"question" "q-20061" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063563/state.json" "file_sha256" "a066e8b9c5217c2e4d6d6ad74db52b80b8bb1d57a7398e7db6653ae63a6a3951"} {"question" "q-20061" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-5"] ["math" "18"] ["math" "4"] ["math" "5"] ["math" "6"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063563/state.json" "file_sha256" "a066e8b9c5217c2e4d6d6ad74db52b80b8bb1d57a7398e7db6653ae63a6a3951"} {"question" "q-20061" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-5"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063563/state.json" "file_sha256" "a066e8b9c5217c2e4d6d6ad74db52b80b8bb1d57a7398e7db6653ae63a6a3951"} {"question" "q-73461" "field" nil "attribute" "question/problem" "value" "Let $p=⟨3,-2,1⟩$, $q=⟨2,-1,0⟩$ and $r=⟨1,-2,4⟩.$ Find $q\\cdot (r\\times p).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063563/state.json" "file_sha256" "a066e8b9c5217c2e4d6d6ad74db52b80b8bb1d57a7398e7db6653ae63a6a3951"} {"question" "q-73461" "field" nil "attribute" "question/worked-solution" "value" "Remember that the scalar triple product $q\\cdot (r\\times p)$ is just the determinant of the matrix whose rows are given by $q,$ $r,$ and $p.$\n\nSo, we have\n\n$$\n\\begin{aligned}q\\cdot (r\\times p) & =|\\begin{aligned}2 & -1 & 0 \\\\ 1 & -2 & 4 \\\\ 3 & -2 & 1\\end{aligned}| \\\\  & =2\\cdot |\\begin{aligned}-2 & 4 \\\\ -2 & 1\\end{aligned}|-(-1)\\cdot |\\begin{aligned}1 & 4 \\\\ 3 & 1\\end{aligned}|+0\\cdot |\\begin{aligned}1 & -2 \\\\ 3 & -2\\end{aligned}| \\\\  & =2((-2)\\cdot 1-4\\cdot (-2))+(1\\cdot 1-4\\cdot 3) \\\\  & =12-11 \\\\  & =1.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063563/state.json" "file_sha256" "a066e8b9c5217c2e4d6d6ad74db52b80b8bb1d57a7398e7db6653ae63a6a3951"} {"question" "q-73461" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063563/activity-metadata.json" "file_sha256" "af35383cc1a74dd005ae77c16be10f81b3262271c9ac4868029b69d42bcb551f"} {"question" "q-73461" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063563/state.json" "file_sha256" "a066e8b9c5217c2e4d6d6ad74db52b80b8bb1d57a7398e7db6653ae63a6a3951"} {"question" "q-73461" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-11"] ["math" "-23"] ["math" "1"] ["math" "12"] ["math" "23"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063563/state.json" "file_sha256" "a066e8b9c5217c2e4d6d6ad74db52b80b8bb1d57a7398e7db6653ae63a6a3951"} {"question" "q-73461" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "1"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063563/state.json" "file_sha256" "a066e8b9c5217c2e4d6d6ad74db52b80b8bb1d57a7398e7db6653ae63a6a3951"} {"question" "q-317325" "field" nil "attribute" "question/problem" "value" "Let $a=⟨-1,-2,3⟩$, $b=⟨4,-1,-2⟩$ and $c=⟨1,2,-3⟩.$ Find $a\\cdot (b\\times c)$ using a determinant.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063563/state.json" "file_sha256" "a066e8b9c5217c2e4d6d6ad74db52b80b8bb1d57a7398e7db6653ae63a6a3951"} {"question" "q-317325" "field" nil "attribute" "question/worked-solution" "value" "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}-1 & -2 & 3 \\\\ 4 & -1 & -2 \\\\ 1 & 2 & -3\\end{aligned}| \\\\  & =(-1)\\cdot |\\begin{aligned}-1 & -2 \\\\ 2 & -3\\end{aligned}|\\,-\\,(-2)\\cdot |\\begin{aligned}4 & -2 \\\\ 1 & -3\\end{aligned}|\\,+\\,3\\cdot |\\begin{aligned}4 & -1 \\\\ 1 & 2\\end{aligned}| \\\\  & =(-1)\\,((-1)(-3)-(-2)\\cdot 2)\\,-\\,(-2)\\,(4\\cdot (-3)-(-2)\\cdot 1)\\,+\\,3\\,(4\\cdot 2-(-1)\\cdot 1) \\\\  & =(-1)\\,(7)\\,-\\,(-2)\\,(-10)\\,+\\,3\\,(9) \\\\  & =-7-20+27 \\\\  & =0.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063563/state.json" "file_sha256" "a066e8b9c5217c2e4d6d6ad74db52b80b8bb1d57a7398e7db6653ae63a6a3951"} {"question" "q-317325" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063563/activity-metadata.json" "file_sha256" "af35383cc1a74dd005ae77c16be10f81b3262271c9ac4868029b69d42bcb551f"} {"question" "q-317325" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063563/state.json" "file_sha256" "a066e8b9c5217c2e4d6d6ad74db52b80b8bb1d57a7398e7db6653ae63a6a3951"} {"question" "q-317325" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063563/state.json" "file_sha256" "a066e8b9c5217c2e4d6d6ad74db52b80b8bb1d57a7398e7db6653ae63a6a3951"}] "usage" {"q-20058" [] "q-20061" []} "basis" 2059 "retractions" [[17592186106053 :question/problem "Find $\\mathbf{b} \\cdot  ( \\mathbf{c} \\times  \\mathbf{a} )$, if $- \\mathbf{a} \\cdot  ( 3 \\mathbf{b} \\times  ( - 2 \\mathbf{c} ) ) = 24.$."]] "immutable_answers" [17592186102556 17592186102557 17592186102558 17592186102559 17592186102560 17592186320513 17592186320514 17592186320515 17592186320516 17592186320517] "immutable_fields" [[17592186102555 :answer-field/correct] [17592186102555 :answer-field/id] [17592186102555 :answer-field/key] [17592186102555 :answer-field/type] [17592186320512 :answer-field/correct] [17592186320512 :answer-field/id] [17592186320512 :answer-field/key] [17592186320512 :answer-field/type]] "no_history" []}
