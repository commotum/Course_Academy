19eb1c0a57dfbc875f756a8e8c805bed670c022683339cf9861f8ac4b0"] :db/ensure [:answer-field/validate]} {:db/id "q-33026" :question/id #uuid "a8d650e6-dfa8-594c-8c20-f63e265d1d5b" :question/math-academy-id "q-33026" :question/problem "Find an equation of the plane that contains the point  $Q(3,2,0)$ and is  perpendicular to the vector $n=⟨1,-2,5⟩.$" :question/worked-solution "First, we note that the position vector of $Q$ is $q=⟨3,2,0⟩,$ and $n=⟨1,-2,5⟩$ is normal to the plane.\n\nThe equation of the plane that passes though the point $Q({x}_{0},{y}_{0},{z}_{0})$ and is perpendicular to the vector $n$ can be given as\n\n$$\n(r-q)\\cdot n=0,\n$$\n\nwhere $r$ is the position vector of any point on the plane, and $q$ is the position vector of $Q.$\n\nSo, we have\n\n$$\n\\begin{aligned}(r-q)\\cdot n & =0 \\\\ r\\cdot n-q\\cdot n & =0 \\\\ r\\cdot n & =q\\cdot n \\\\ r\\cdot ⟨1,-2,5⟩ & =⟨3,2,0⟩\\cdot ⟨1,-2,5⟩ \\\\ r\\cdot ⟨1,-2,5⟩ & =-1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-33026/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3f5c9c30-1745-5986-b116-e9e70a7c6161"] :knowledge-point/questions ["q-33026"] :db/ensure [:knowledge-point/validate]} {:db/id "q-33322/selection/6bfd84cb56bf0883adef6d43dc25c03f7eabc65a131218b14a92be075879fc11" :answer/id #uuid "6024122d-f1c6-5b4c-80f3-5d0fc03976b1" :answer/type :answer.type/math :answer/value "r\\cdot (5i+2j+3k)=25" :db/ensure [:answer/validate]} {:db/id "q-33322/selection/2118e9d4dd5abbbf06f3ca0487aff850f37ecae69bd9e7ed441c20a0d79f4aba" :answer/id #uuid "6bdf2793-33e5-54d3-97af-3a4169fa10bf" :answer/type :answer.type/math :answer/value "r\\cdot (6i+5j+4k)=0" :db/ensure [:answer/validate]} {:db/id "q-33322/selection/38ed232a2c14c4bde73405b1f18429e933e46a26346f32ff0c43cfe7094ffcc1" :answer/id #uuid "7dd05887-56ef-5433-8f15-02181089229c" :answer/type :answer.type/math :answer/value "r\\cdot (6i+5j+4k)=5i" :db/ensure [:answer/validate]} {:db/id "q-33322/selection/26f04e6c0d0bb57fdcfdf2f084017476ccc640121c055fc5320f9ba6f53c5424" :answer/id #uuid "a305a2b0-31a6-5914-8d1e-75a647e69670" :answer/type :answer.type/math :answer/value "r\\cdot (6i+5j+4k)=52" :db/ensure [:answer/validate]} {:db/id "q-33322/selection/3ca920e19b66a62586acf801413c9b74a3f813391855bc5a91304f0d075d492a" :answer/id #uuid "b9e614bd-555a-5877-8017-c9580c67ae75" :answer/type :answer.type/math :answer/value "r\\cdot (5i+2j+3k)=52" :db/ensure [:answer/validate]} {:db/id "q-33322/selection" :answer-field/id #uuid "be8fe33a-fe3e-5bbf-b05f-981cf643ed07" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-33322/selection/26f04e6c0d0bb57fdcfdf2f084017476ccc640121c055fc5320f9ba6f53c5424" :answer-field/choices ["q-33322/selection/6bfd84cb56bf0883adef6d43dc25c03f7eabc65a131218b14a92be075879fc11" "q-33322/selection/2118e9d4dd5abbbf06f3ca0487aff850f37ecae69bd9e7ed441c20a0d79f4aba" "q-33322/selection/38ed232a2c14c4bde73405b1f18429e933e46a26346f32ff0c43cfe7094ffcc1" "q-33322/selection/26f04e6c0d0bb57fdcfdf2f084017476ccc640121c055fc5320f9ba6f53c5424" "q-33322/selection/3ca920e19b66a62586acf801413c9b74a3f813391855bc5a91304f0d075d492a"] :db/ensure [:answer-field/validate]} {:db/id "q-33322" :question/id #uuid "de06b04b-9864-5c8f-bac6-c6b5019acb9c" :question/math-academy-id "q-33322" :question/problem "Find an equation of the plane that contains the point  $Q(5,2,3)$ and is perpendicular to the vector $n=6i+5j+4k.$" :question/worked-solution "First, notice that the position vector of $Q$ is $q=5i+2j+3k$ and $n=6i+5j+4k$ is normal to the plane. \n\nThe equation of the plane that passes though the point $Q({x}_{0},{y}_{0},{z}_{0})$ and is perpendicular to the vector $n$ can be given as\n\n$$\n(r-q)\\cdot n=0,\n$$\n\nwhere $r$ is the position vector of any point on the plane, and $q$ is the position vector of $Q.$\n\nSo, we have\n\n$$\n\\begin{aligned}(r-q)\\cdot n & =0 \\\\ r\\cdot n-q\\cdot n & =0 \\\\ r\\cdot n & =q\\cdot n \\\\ r\\cdot (6i+5j+4k) & =(5i+2j+3k)\\cdot (6i+5j+4k) \\\\ r\\cdot (6i+5j+4k) & =52.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-33322/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3f5c9c30-1745-5986-b116-e9e70a7c6161"] :knowledge-point/questions ["q-33322"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70814/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "ea2399af-b73f-5d9f-8b0f-85f631dbd8dc" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-70814/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "2b36ef70-047d-5703-a20b-55f3873f45dd" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-70814/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "21c08ac4-f18c-5cca-8cce-4078edd46041" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-70814/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "981dfb58-67c7-5fc1-857c-5130a1025a19" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-70814/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "07df3a7c-58ae-5914-a86a-2766b6e91cf0" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-70814/selection" :answer-field/id #uuid "4520247f-7e44-5a2e-ad85-a0b3a504acb6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-70814/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer-field/choices ["q-70814/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-70814/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-70814/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-70814/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" "q-70814/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-70814" :question/id #uuid "50a00e03-bb56-54e1-be3b-f6563f49a100" :question/math-academy-id "q-70814" :question/problem "A nonzero vector $⟨0,\\,b,\\,c⟩$ is parallel to the plane $r\\cdot ⟨1,-2,1⟩=10.$ What is the value of $\\frac{b}{c}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨1,-2,1⟩=10$ of the plane, we get the normal vector $n=⟨1,-2,1⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨1,-2,1⟩ & =0 \\\\ {t}_{1}-2{t}_{2}+{t}_{3} & =0 \\\\ {t}_{3} & =2{t}_{2}-{t}_{1}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=[\\begin{aligned}{t}_{1} \\\\ {t}_{2} \\\\ 2{t}_{2}-{t}_{1}\\end{aligned}],\n$$\n\nwhere ${t}_{1},{t}_{2}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the first component of $v$ equals $0.$ So, we must set ${t}_{1}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{2}\\ne 0.$ For example, setting ${t}_{2}=1$, we get\n\n$$\nv=⟨0,\\,1,\\,2⟩.\n$$\n\nTherefore, $\\frac{b}{c}=\\frac{1}{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-70814/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b0d93156-f9be-5e6e-976a-bef30dc892ee"] :knowledge-point/questions ["q-70814"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-70821"] :question/problem "A nonzero vector $⟨a,\\,0,\\,c⟩$ is parallel to the plane $r\\cdot ⟨3,-3,1⟩=-12.$ What is the value of $\\frac{a}{c}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation of the plane, $r\\cdot ⟨3,-3,1⟩=-12,$  we get the normal vector $n=⟨3,-3,1⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨3,-3,1⟩ & =0 \\\\ 3{t}_{1}-3{t}_{2}+{t}_{3} & =0 \\\\ {t}_{3} & =3{t}_{2}-3{t}_{1}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=⟨{t}_{1},{t}_{2},3{t}_{2}-3{t}_{1}⟩,\n$$\n\nwhere ${t}_{1},{t}_{2}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the second component of $v$ eqauls $0.$ So, we must set ${t}_{2}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{1}\\ne 0.$ For example, setting ${t}_{1}=1$, we get\n\n$$\nv=⟨1,\\,0,-3⟩.\n$$\n\nTherefore, $\\frac{a}{c}=\\frac{1}{-3}=-\\frac{1}{3}.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-70817/selection/9e11fa4df3725c69efaf2fb0a82d90e47a4519d002f721e23606c3d6290fb02c" :answer/id #uuid "5a7b8fc7-7935-57c1-8d9f-149e95f64ed8" :answer/type :answer.type/math :answer/value "\\frac{1}{6}" :db/ensure [:answer/validate]} {:db/id "q-70817/selection/71b1db0b2a675655ec27a2d2ceef2e86712a68eb78548232215378e0a354fb4c" :answer/id #uuid "34c0f37b-6301-592d-b699-1b34db6040bf" :answer/type :answer.type/math :answer/value "-\\frac{1}{6}" :db/ensure [:answer/validate]} {:db/id "q-70817/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer/id #uuid "fb3e2ce9-819c-5cc5-b515-6e8521c2b38c" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-70817/selection/5ab3573096b30d3c5d3c378e667364cbb062f921e9b1002441e594f0774a669d" :answer/id #uuid "55b65f9f-ec53-5046-a8f8-5a2b9d8d7b23" :answer/type :answer.type/math :answer/value "-\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-70817/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "495da882-e478-58fc-8eb5-34716a1ede65" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-70817/selection" :answer-field/id #uuid "a52a55d1-00eb-509c-b5d3-bd83b058ea7f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-70817/selection/5ab3573096b30d3c5d3c378e667364cbb062f921e9b1002441e594f0774a669d" :answer-field/choices ["q-70817/selection/9e11fa4df3725c69efaf2fb0a82d90e47a4519d002f721e23606c3d6290fb02c" "q-70817/selection/71b1db0b2a675655ec27a2d2ceef2e86712a68eb78548232215378e0a354fb4c" "q-70817/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" "q-70817/selection/5ab3573096b30d3c5d3c378e667364cbb062f921e9b1002441e594f0774a669d" "q-70817/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-70817" :question/id #uuid "ffbac4ff-c800-546e-a3b3-644d72310aa4" :question/math-academy-id "q-70817" :question/problem "A nonzero vector $⟨a,\\,0,\\,c⟩$ is parallel to the plane $r\\cdot ⟨3,0,1⟩=5.$ What is the value of $\\frac{a}{c}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨3,0,1⟩=5$ of the plane, we get the normal vector $n=⟨3,0,1⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨3,0,1⟩ & =0 \\\\ 3{t}_{1}+{t}_{3} & =0 \\\\ {t}_{3} & =-3{t}_{1}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=⟨{t}_{1},{t}_{2},-3{t}_{1}⟩\n$$\n\nwhere ${t}_{1},{t}_{2}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the second component of $v$ equals $0.$ So, we must set ${t}_{2}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{1}\\ne 0.$ For example, setting ${t}_{1}=1$, we get\n\n$$\nv=⟨1,\\,0,\\,-3⟩.\n$$\n\nTherefore, $\\frac{a}{c}=-\\frac{1}{3}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-70817/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b0d93156-f9be-5e6e-976a-bef30dc892ee"] :knowledge-point/questions ["q