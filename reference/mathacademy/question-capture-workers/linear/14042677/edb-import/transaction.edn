[{:db/id "q-33035/selection/8dd55c0823c91edee8cab653b84ab6b8fe8aa5a781745b4699db2ae628bd9b42" :answer/id #uuid "a3eaf8f8-7097-5813-aa5e-e25608cae2b9" :answer/type :answer.type/math :answer/value "r\\cdot (8i+\\sqrt{27}j)=-1" :db/ensure [:answer/validate]} {:db/id "q-33035/selection/9389cf3b52997a65ffabed1b3018b6c680ba3bd2c3847193dd03afb9b3c1b2fc" :answer/id #uuid "c9cc72c3-2094-5b60-8da4-0c265a053104" :answer/type :answer.type/math :answer/value "r\\cdot (8i+\\sqrt{27}j)=8-\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-33035/selection/c3a0be4499982de606a9547b3b5410e5e6b37e8ed29649e87900cacab46227ae" :answer/id #uuid "a019abae-b534-5000-925a-c53619cadbb3" :answer/type :answer.type/math :answer/value "r\\cdot (8i+\\sqrt{27}j)=i-\\sqrt{3}j+4k" :db/ensure [:answer/validate]} {:db/id "q-33035/selection/bfc76676df2d61f93ac4870db04e4a54c001b1abf156387398a82a52d2034d3e" :answer/id #uuid "4c4dc8ac-265b-5859-bd26-1f14645e1b92" :answer/type :answer.type/math :answer/value "r\\cdot (i-\\sqrt{3}j+4k)=1" :db/ensure [:answer/validate]} {:db/id "q-33035/selection/c935ccbc0ae9942eac64a3d1d4712d1be07293934aded7851cede2e4b42a1798" :answer/id #uuid "34b081fc-d6d8-560a-aec4-1d8e18d448b7" :answer/type :answer.type/math :answer/value "r\\cdot (i-\\sqrt{3}j+4k)=8i+\\sqrt{27}j" :db/ensure [:answer/validate]} {:db/id "q-33035/selection" :answer-field/id #uuid "e831398f-b760-5aca-b42c-a530021e9259" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-33035/selection/8dd55c0823c91edee8cab653b84ab6b8fe8aa5a781745b4699db2ae628bd9b42" :answer-field/choices ["q-33035/selection/8dd55c0823c91edee8cab653b84ab6b8fe8aa5a781745b4699db2ae628bd9b42" "q-33035/selection/9389cf3b52997a65ffabed1b3018b6c680ba3bd2c3847193dd03afb9b3c1b2fc" "q-33035/selection/c3a0be4499982de606a9547b3b5410e5e6b37e8ed29649e87900cacab46227ae" "q-33035/selection/bfc76676df2d61f93ac4870db04e4a54c001b1abf156387398a82a52d2034d3e" "q-33035/selection/c935ccbc0ae9942eac64a3d1d4712d1be07293934aded7851cede2e4b42a1798"] :db/ensure [:answer-field/validate]} {:db/id "q-33035" :question/id #uuid "00fbf737-6bbe-5465-9125-1b11baeb7ec1" :question/math-academy-id "q-33035" :question/problem "Find an equation of the plane that contains the point  $P(1,-\\sqrt{3},4)$ and is perpendicular to the vector $n=8i+\\sqrt{27}j.$" :question/worked-solution "First, we note that the position vector of $P$ is $p=i-\\sqrt{3}j+4k$ and $n=8i+\\sqrt{27}j$ is normal to the plane.\n\nThe equation of the plane that passes through the point $P({x}_{0},{y}_{0},{z}_{0})$ and is perpendicular to the vector $n$ can be given as \n\n$$\n(r-p)\\cdot n=0,\n$$\n\nwhere $r$ is the position vector of any point on the plane, and $p$ is the position vector of $P.$\n\nSo, we have\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n-p\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot (8i+\\sqrt{27}j) & =(i-\\sqrt{3}j+4k)\\cdot (8i+\\sqrt{27}j) \\\\ r\\cdot (8i+\\sqrt{27}j) & =-1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-33035/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3f5c9c30-1745-5986-b116-e9e70a7c6161"] :knowledge-point/questions ["q-33035"] :db/ensure [:knowledge-point/validate]} {:db/id "q-33312/selection/43d505ff8c2e0c7c74dd0b9b2a39c9a3788f56d5b7f2970b5998af224b6006b3" :answer/id #uuid "732176b2-44ae-5a70-b2eb-af7b8907e33d" :answer/type :answer.type/math :answer/value "r\\cdot ⟨3,3,2⟩=4" :db/ensure [:answer/validate]} {:db/id "q-33312/selection/0a0acb984273f8b0a0cba65a22cb46a0b25e828ba8e849c641701bdb7321a322" :answer/id #uuid "72a19bb8-0aca-580c-afa4-03b4ac9e35f3" :answer/type :answer.type/math :answer/value "r\\cdot ⟨3,2,2⟩=16" :db/ensure [:answer/validate]} {:db/id "q-33312/selection/84199103130a421b4374d8dd77a0c8d2a36659842b55a5a12055ab557fb09f5f" :answer/id #uuid "17400030-8ff4-574f-b581-15a6623c0e17" :answer/type :answer.type/math :answer/value "r\\cdot ⟨2,3,3⟩=4" :db/ensure [:answer/va