cdot n & =q\\cdot n \\\\ r\\cdot ⟨2,2,3⟩ & =⟨3,2,2⟩\\cdot ⟨2,2,3⟩ \\\\ r\\cdot ⟨2,2,3⟩ & =16.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-33312/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3f5c9c30-1745-5986-b116-e9e70a7c6161"] :knowledge-point/questions ["q-33312"] :db/ensure [:knowledge-point/validate]} {:db/id "q-33027/selection/4ddd2c56f7961e39cab28e21bdff07e7b4574b848eb0d065322e4b80ddc4970e" :answer/id #uuid "43c7d742-9499-5f29-91d2-b9920fb9a36c" :answer/type :answer.type/math :answer/value "r\\cdot [\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}]=-9" :db/ensure [:answer/validate]} {:db/id "q-33027/selection/949ca3f21dc5f4e3ecac4b23f57002b88dfd166edea82d7e5668d418b888a037" :answer/id #uuid "83cfbb99-4e21-5151-9ce0-5c9a0b8bd96a" :answer/type :answer.type/math :answer/value "r\\cdot [\\begin{aligned}2 \\\\ -4 \\\\ 3\\end{aligned}]=[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-33027/selection/59187575c3154faf44e1798708d91c711932e1dd562d3492af27b46df7230b2d" :answer/id #uuid "e76958a4-f0a9-564b-b572-e6bb6c971a20" :answer/type :answer.type/math :answer/value "r\\cdot [\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}]=-5" :db/ensure [:answer/validate]} {:db/id "q-33027/selection/4e04993413174d4112df33d9f8d9531dfe32d394c9dca70c4af074871176d0c9" :answer/id #uuid "d65e7cbe-fab5-5020-ae76-91046be0e73a" :answer/type :answer.type/math :answer/value "r\\cdot [\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}]=[\\begin{aligned}2 \\\\ 4 \\\\ -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-33027/selection/b68587ac7626530659c084d27fcf3f2c2b44da39cc4f3c8d24d546a89c7fb279" :answer/id #uuid "a7902d5d-7344-529d-a001-8ae963229f7d" :answer/type :answer.type/math :answer/value "r\\cdot [\\begin{aligned}2 \\\\ -4 \\\\ 3\\end{aligned}]=-9" :db/ensure [:answer/validate]} {:db/id "q-33027/selection" :answer-field/id #uuid "35db1012-2955-55e0-8997-945a