2 & -7 \\\\ 1 & 0 & 0 \\\\ 0 & 4 & 7\\end{aligned}]\n$$\n\nBy applying elementary column operations of the form ${C}_{i}:={C}_{i}+k{C}_{1},$ the matrix $A$ can be transformed into the matrix $B.$ What are the elementary column operations?" :question/worked-solution "To transform $A$ into $B,$ we need to make entries to the right of ${a}_{21}=1$ equal to $0.$\n\nTo do this, we can apply the following elementary column operations:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 3 & 2 \\\\ 1 & 1 & 9 \\\\ 0 & 4 & 7\\end{aligned}] &  & \\,\\begin{aligned}{C}_{2}:={C}_{2}-{C}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 2 & 2 \\\\ 1 & 0 & 9 \\\\ 0 & 4 & 7\\end{aligned}] &  & \\,\\begin{aligned}{C}_{3}:={C}_{3}-9{C}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 2 & -7 \\\\ 1 & 0 & 0 \\\\ 0 & 4 & 7\\end{aligned}] \\\\  & =B\\end{aligned}\n$$\n\nTherefore, the elementary column operations are\n\n$\\,$ ${C}_{1}:={C}_{1}-{C}_{2}\\,$ and $\\,{C}_{3}:={C}_{3}-9{C}_{1}.$"}] [{:db/id #edb/ref 17592186162498 :knowledge-point/_questions [{:knowledge-point/id #uuid "85e1fe3f-e85e-5ab4-a594-c55b84bb789a" :knowledge-point/title "Using Column Operations to Create a Row of Zeros in a 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ca3f431-ff5f-5b9f-b1d6-216e788ec8b0" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1} - 2C_{2}$ and $C_{3}:=C_{3} - C_{2}$" :db/id #edb/ref 17592186160621} {:answer/id #uuid "d9d2d880-c243-5c71-a98d-a828bd2df88e" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1} + 2C_{2}$ and $C_{3}:=C_{3} + C_{2}$" :db/id #edb/ref 17592186160622} {:answer/id #uuid "ea628825-c2e2-507b-b077-975c5e52bcd7" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1} - C_{2}$ and $C_{3}:=C_{3} + 2C_{2}$" :db/id #edb/ref 17592186160623} {:answer/id #uuid "0eba1ced-7848-5d98-a2e9-14225785d7bd" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1} - 2C_{2}$ and $C_{3}:=C_