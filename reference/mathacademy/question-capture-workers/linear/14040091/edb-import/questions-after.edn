15\\end{aligned}] \\\\  & =B.\\end{aligned}\n$$\n\nTherefore, the corresponding elementary column operations are\n\n$\\,$ ${C}_{1}:={C}_{1}-2{C}_{3}\\,$ and $\\,{C}_{4}:={C}_{4}+4{C}_{3}.$"}] [{:db/id #edb/ref 17592186305768 :knowledge-point/_questions [{:knowledge-point/id #uuid "958cdcf3-aaba-5275-85f8-9531f10b3d0e" :knowledge-point/title "Using Column Operations to Create a Row of Zeros in a 4x4 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d3a24492-8e5c-5673-a78e-ab18677554e4" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}+2{C}_{3}\\,$ and $\\,{C}_{4}:={C}_{4}-3{C}_{3}$" :db/id #edb/ref 17592186305770} {:answer/id #uuid "638242c4-bc9d-5bb3-8d8f-055eac56e95d" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}-2{C}_{3}\\,$ and $\\,{C}_{4}:={C}_{4}+3{C}_{3}$" :db/id #edb/ref 17592186305771} {:answer/id #uuid "d31dd2ce-7d19-57a6-89f3-4a0b1b3034b1" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}-3{C}_{3}\\,$ and $\\,{C}_{4}:={C}_{4}+2{C}_{3}$" :db/id #edb/ref 17592186305772} {:answer/id #uuid "4490f307-941d-5b05-9069-614664426bee" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}-2{C}_{3}\\,$ and $\\,{C}_{4}:={C}_{4}-3{C}_{3}$" :db/id #edb/ref 17592186305773} {:answer/id #uuid "cb06ae42-5ed0-525e-8469-974d38b04d2f" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}+2{C}_{3}\\,$ and $\\,{C}_{4}:={C}_{4}+3{C}_{3}$" :db/id #edb/ref 17592186305774}] :answer-field/correct {:answer/id #uuid "638242c4-bc9d-5bb3-8d8f-055eac56e95d" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}-2{C}_{3}\\,$ and $\\,{C}_{4}:={C}_{4}+3{C}_{3}$" :db/id #edb/ref 17592186305771} :answer-field/id #uuid "40b77709-4d7e-5e6e-8286-18f8814580ca" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186305769}] :question/difficulty {:db/id #edb/ref 1759218604546