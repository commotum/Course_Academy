 & 8 \\\\ 11 & -1 & 2 & 8\\end{aligned}] &  & \\,\\begin{aligned}{R}_{3}:={R}_{3}-5{R}_{4}\\end{aligned} \\\\  & ∼[\\begin{aligned}-26 & 0 & -10 & -10 \\\\ 30 & 0 & 0 & 22 \\\\ -52 & 0 & -12 & -32 \\\\ 11 & -1 & 2 & 8\\end{aligned}] \\\\  & =B\\end{aligned}\n$$\n\nTherefore, the missing elementary row operations are\n\n$\\,$ ${R}_{1}:={R}_{1}-3{R}_{4}\\,$ and $\\,{R}_{3}:={R}_{3}-5{R}_{4}.$"}] [{:db/id #edb/ref 17592186305810 :knowledge-point/_questions [{:knowledge-point/id #uuid "21f1ec99-e166-5986-a07d-f07be0dfeb31" :knowledge-point/title "Using Row Operations to Create a Column of Zeros in a 4x4 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e9f6f0cc-ba08-5ad2-b085-1dfc598f5d8f" :answer/type {:db/ident :answer.type/text} :answer/value "${R}_{3}:={R}_{3}+3{R}_{1}\\,$ and $\\,{R}_{4}:={R}_{4}-2{R}_{1}$" :db/id #edb/ref 17592186305812} {:answer/id #uuid "f536193e-711b-5260-9642-55d49418e053" :answer/type {:db/ident :answer.type/text} :answer/value "${R}_{3}:={R}_{3}-2{R}_{1}\\,$ and $\\,{R}_{4}:={R}_{4}-3{R}_{1}$" :db/id #edb/ref 17592186305813} {:answer/id #uuid "8e6b20b4-f109-5f00-83f7-8812c34ece0b" :answer/type {:db/ident :answer.type/text} :answer/value "${R}_{3}:={R}_{3}+3{R}_{1}\\,$ and $\\,{R}_{4}:={R}_{4}+2{R}_{1}$" :db/id #edb/ref 17592186305814} {:answer/id #uuid "e2215c7f-e8e3-5438-92ba-db1a4cd77164" :answer/type {:db/ident :answer.type/text} :answer/value "${R}_{3}:={R}_{3}-3{R}_{1}\\,$ and $\\,{R}_{4}:={R}_{4}-2{R}_{1}$" :db/id #edb/ref 17592186305815} {:answer/id #uuid "0398c846-0126-5894-b6b3-569981cc9d1a" :answer/type {:db/ident :answer.type/text} :answer/value "${R}_{3}:={R}_{3}-3{R}_{1}\\,$ and $\\,{R}_{4}:={R}_{4}+2{R}_{1}$" :db/id #edb/ref 17592186305816}] :answer-field/correct {:answer/id #uuid "e2215c7f-e8e3-5438-92ba-db1a4cd77164" :answer/type {:db/ident :answer.type/text} :answer/value "${R}_{3}:={R}_{3}-3{R}_{1}\\,$ and $\\,{R}_{4}:={R}_{4}-2{R}_{1}$" :db/id #edb/ref 17592186305815} :answer-field/id #uuid "d2d