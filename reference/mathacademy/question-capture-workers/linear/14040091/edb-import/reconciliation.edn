 & 1 & 0 & 0 \\\\ -19 & 5 & -14 & -2\\end{aligned}] \\\\  & =B.\\end{aligned}\n$$\n\nTherefore, the corresponding elementary column operations are\n\n$\\,$ ${C}_{1}:={C}_{1}-4{C}_{2}\\,$ and $\\,{C}_{4}:={C}_{4}-2{C}_{2}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040091/state.json" "file_sha256" "4c099b8a5af4bbe1931dab27ba587dfa4139b4f6d569435d89c682c6fc59f037"} {"question" "q-91210" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040091/activity-metadata.json" "file_sha256" "9621d434515595164b9a7b82a0b62acb60abf05f431523c0f0f85bd07935f033"} {"question" "q-91210" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040091/state.json" "file_sha256" "4c099b8a5af4bbe1931dab27ba587dfa4139b4f6d569435d89c682c6fc59f037"} {"question" "q-91210" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "${C}_{1}:={C}_{1}+2{C}_{2}\\,$ and $\\,{C}_{4}:={C}_{4}+4{C}_{2}$"] ["text" "${C}_{1}:={C}_{1}+4{C}_{2}\\,$ and $\\,{C}_{4}:={C}_{4}+2{C}_{2}$"] ["text" "${C}_{1}:={C}_{1}-2{C}_{2}\\,$ and $\\,{C}_{4}:={C}_{4}-4{C}_{2}$"] ["text" "${C}_{1}:={C}_{1}-4{C}_{2}\\,$ and $\\,{C}_{4}:={C}_{4}+2{C}_{2}$"] ["text" "${C}_{1}:={C}_{1}-4{C}_{2}\\,$ and $\\,{C}_{4}:={C}_{4}-2{C}_{2}$"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040091/state.json" "file_sha256" "4c099b8a5af4bbe1931dab27ba587dfa4139b4f6d569435d89c682c6fc59f037"} {"question" "q-91210" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "${C}_{1}:={C}_{1}-4{C}_{2}\\,$ and $\\,{C}_{4}:={C}_{4}-2{C}_{2}$"