& 1 \\\\ 0 & -2 & 1 & 5\\end{aligned}]\n$$\n\nConsider the matrices $A$ and $B$ above. By applying three matrix elementary row operations \n\n- $R_1 := \\ldots$\n\n- $R_3:=R_3-3R_2$\n\n- $R_4:= \\ldots$\n\neach of the form $R_i:=R_i+kR_2,$ the matrix $A$ can be transformed into the matrix $B.$ What are the missing elementary row operations?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040091/example-8048.json" "file_sha256" "3d06a1f7123d23ae1e8c213fb6ed49406529987e39bbdeb0b7afedbc75f9f8aa"} {"question" "e-8048" "field" nil "attribute" "question/worked-solution" "value" "To transform $A$ into $B,$ we need to make entries above and below $a_{22}={\\color{blue}\\bbox[lightgray,2pt]{1}}$ equal to ${\\color{red}0}.$\n\nTo do this, we can apply the following elementary row operations:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}-1 & 2 & 1 & 5 \\\\ 1 & 1 & 2 & -1 \\\\ -1 & 3 & 1 & 1 \\\\ 0 & -2 & 1 & 5\\end{aligned}] &  & \\,\\begin{aligned}{R}_{1}:={R}_{1}-2{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}-3 & 0 & -3 & 7 \\\\ 1 & 1 & 2 & -1 \\\\ -1 & 3 & 1 & 1 \\\\ 0 & -2 & 1 & 5\\end{aligned}] &  & \\,\\begin{aligned}{R}_{3}:={R}_{3}-3{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}-3 & 0 & -3 & 7 \\\\ 1 & 1 & 2 & -1 \\\\ -4 & 0 & -5 & 4 \\\\ 0 & -2 & 1 & 5\\end{aligned}] &  & \\,\\begin{aligned}{R}_{4}:={R}_{4}+2{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}-3 & 0 & -3 & 7 \\\\ 1 & 1 & 2 & -1 \\\\ -4 & 0 & -5 & 4 \\\\ 2 & 0 & 5 & 3\\end{aligned}] \\\\  & =B\\end{aligned}\n$$\n\nTherefore, the missing elementary row operations are\n\n$\\qquad$ $R_1 := R_1 - 2R_2\\quad$ and $\\quad R_4:=R_4+2R_2.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040091/example-8048.json" "file_sha256" "3d06a1f7123d23ae1e8c213fb6ed49406529987e39bbdeb0b7afedbc75f9f8aa"} {"question" "e-8051" "field" nil "attribute" "question/problem" "value" "$$\n[\\begin{aligned}-6 & -5 & 1 \\\\ 8 & 3 & -4 \\\\ 9 & 7 & -2\\end{aligned}]\n$$\n\nBy applying elementary column operations of the form $C_i:=C_i+kC_3,$ the matrix $A$ can be transformed into the matrix $B.$ What are the elementary column operations?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040091/example-8051.json" "file_sha256" "b98fe5652b8d5deb7aac1fb0b91514ba8e467efd28b6b2a57154d62d802a1937"} {"question" "e-8051" "field" nil "attribute" "question/worked-solution" "value" "To transform $A$ into $B,$ we need to make entries to the left of $a_{13}={\\color{blue}\\bbox[lightgray,2pt]{1}}$ equal to ${\\color{red}0}.$\n\nTo do this, we can apply the following elementary column operations:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}-6 & -5 & 1 \\\\ 8 & 3 & -4 \\\\ 9 & 7 & -2\\end{aligned}] &  & \\,\\begin{aligned}{C}_{1}:={C}_{1}+6{C}_{3}\\end{aligned} \\\\  & ∼[\\begin{aligned}0 & -5 & 1 \\\\ -16 & 3 & -4 \\\\ -3 & 7 & -2\\end{aligned}] &  & \\,\\begin{aligned}{C}_{2}:={C}_{2}+5{C}_{3}\\end{aligned} \\\\  & ∼[\\begin{aligned}0 & 0 & 1 \\\\ -16 & -17 & -4 \\\\ -3 & -3 & -2\\end{aligned}] \\\\  & =B\\end{aligned}\n$$\n\nTherefore, the elementary column operations are\n\n$\\qquad$ $C_1:=C_1+6C_3\\quad$ and $\\quad C_2:=C_2+5C_3.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040091/example-8051.json" "file_sha256" "b98fe5652b8d5deb7aac1fb0b91514ba8e467efd28b6b2a57154d62d802a1937"} {"question" "e-8049" "field" nil "attribute" "question/problem" "value" "$$\n[\\begin{aligned}7 & -3 & -1 & -6 \\\\ 7 & -2 & -2 & -4 \\\\ -5 & 1 & 4 & 2 \\\\ -8 & -3 & -6 & -4\\end{aligned}]\n$$\n\nConsider the matrices $A$ and $B$ above. By applying three matrix elementary column operations \n\n- $C_1:=\\ldots$\n\n- $C_3:= C_3 - 4C_2$\n\n- $C_4:= \\ldots$\n\neach of the form $C_i:=C_i+kC_2,$ the matrix $A$ can be transformed into the matrix $B.$ What are the missing elementary column operations?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040091/example-8049.json" "file_sha256" "514e03e9fd86289952c702a8d0bc7bb0549142370c2736e2297bccb40ba4839f"} {"question" "e-8049" "field" nil "attribute" "question/worked-solution" "value" "To transform $A$ into $B,$ we need to make entries to the left and to the right of $a_{32}={\\color{blue}\\bbox[lightgray,2pt]{1}}$ equal to ${\\color{red}0}.$\n\nTo do this, we can apply the following elementary column operations:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}7 & -3 & -1 & -6 \\\\ 7 & -2 & -2 & -4 \\\\ -5 & 1 & 4 & 2 \\\\ -8 & -3 & -6 & -4\\end{aligned}] &  & \\,\\begin{aligned}{C}_{1}:={C}_{1}+5{C}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}-8 & -3 & -1 & -6 \\\\ -3 & -2 & -2 & -4 \\\\ 0 & 1 & 4 & 2 \\\\ -23 & -3 & -6 & -4\\end{aligned}] &  & \\,\\begin{aligned}{C}_{3}:={C}_{3}-4{C}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}-8 & -3 & 11 & -6 \\\\ -3 & -2 & 6 & -4 \\\\ 0 & 1 & 0 & 2 \\\\ -23 & -3 & 6 & -4\\end{aligned}] &  & \\,\\begin{aligned}{C}_{4}:={C}_{4}-2{C}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}-8 & -3 & 11 & 0 \\\\ -3 & -2 & 6 & 0 \\\\ 0 & 1 & 0 & 0 \\\\ -23 & -3 & 6 & 2\\end{aligned}] \\\\  & =B\\end{aligned}\n$$\n\nTherefore, the corresponding elementary column operations are\n\n$\\qquad$ $C_1:=C_1+5C_2\\quad$ and $\\quad C_4:=C_4-2C_2.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040091/example-8049.json" "file_sha256" "514e03e9fd86289952c702a8d0bc7bb0549142370c2736e2297bccb40ba4839f"}] "usage" {"q-91163" [] "q-91189" [] "q-42563" [] "e-8051" [] "e-8049" [] "q-42917" [] "q-42561" [] "q-42531" [] "e-8050" [] "e-8048" []} "basis" 1411 "retractions" [[17592186162496 :question/problem "$A = \\begin{bmatrix}-1 & 1 & 6 \\\\ 2 & -5 & -3 \\\\ -3 & -6 & -9\\end{bmatrix}, B = \\begin{bmatrix}3 & -9 & 0 \\\\ 2 & -5 & -3 \\\\ -9 & 9 & 0\\end{bmatrix}$\n\nBy applying elementary row operations of the form $R_{i}:=R_{i} + kR_{2}$, the matrix $A$ can be transformed into the matrix $B$. What are the elementary row operations?"] [17592186162479 :question/problem "$A = \\begin{bmatrix}-3 & 2 & -1 \\\\ 1 & 2 & 1 \\\\ 0 & 1 & 2\\end{bmatrix}, B = \\begin{bmatrix}-3 & 0 & -5 \\\\ 1 & 0 & -3 \\\\ 0 & 1 & 2\\end{bmatrix}$\n\nBy applying elementary row operations of the form $R_{i}:=R_{i} + kR_{3}$, the matrix $A$ can be transformed into the matrix $B$. What are the elementary row operations?"] [17592186162480 :question/problem "$A = \\begin{bmatrix}-2 & 3 & -4 & 5 \\\\ 5 & -1 & 3 & 0 \\\\ 0 & 4 & 7 & 2 \\\\ 0 & 5 & 4 & -3\\end{bmatrix}, B = \\begin{bmatrix}13 & 0 & 5 & 5 \\\\ 5 & -1 & 3 & 0 \\\\ 20 & 0 & 19 & 2 \\\\ 25 & 0 & 19 & -3\\end{bmatrix}$\n\nConsider the matrices $A$ and $B$ above. By applying three matrix elementary row operations\n\n1. $R_{1}:=…$\n2. $R_{3}:=R_{3} + 4R_{2}$\n3. $R_{4}:=…$\n\neach of the form $R_{i}:=R_{i} + kR_{2}$, the matrix $A$ can be transformed into the matrix $B$. What are the missing elementary row operations?"] [17592186162498 :question/problem "$A = \\begin{bmatrix}10 & 5 & -5 \\\\ -1 & 3 & -4 \\\\ 8 & 8 & 0\\end{bmatrix}, B = \\begin{bmatrix}0 & 5 & 0 \\\\ -7 & 3 & -1 \\\\ -8 & 8 & 8\\end{bmatrix}$\n\nBy applying elementary column operations of the form $C_{i}:=C_{i} + kC_{2}$, the matrix $A$ can be transformed into the matrix $B$. What are the elementary column operations?"] [17592186162482 :question/problem "$A = \\begin{bmatrix}-1 & 2 & 2 \\\\ 1 & 3 & 1 \\\\ 3 & 4 & 1\\end{bmatrix}, B = \\begin{bmatrix}-7 & -6 & 2 \\\\ -2 & -1 & 1 \\\\ 0 & 0 & 1\\end{bmatrix}$\n\nBy applying elementary column operations of the form $C_{i}:=C_{i} + kC_{3}$, the matrix $A$ can be transformed into the matrix $B$. What are the elementary column operations?"] [17592186162481 :question/problem "$A = \\begin{bmatrix}5 & 0 & 2 & 7 \\\\ 1 & -7 & -4 & -6 \\\\ -1 & 3 & 1 & 2 \\\\ 2 & 7 & 2 & 3\\end{bmatrix}, B = \\begin{bmatrix}7 & -6 & 2 & 3 \\\\ -3 & 5 & -4 & 2 \\\\ 0 & 0 & 1 & 0 \\\\ 4 & 1 & 2 & -1\\end{bmatrix}$\n\nConsider the matrices $A$ and $B$ above. By applying three matrix elementary column operations\n\n1. $C_{1}:=C_{1} + C_{3}$\n2. $C_{2}:=…$\n3. $C_{4}:=…$\n\neach of the form $C_{i}:=C_{i} + kC_{3}$, the matrix $A$ can be transformed into the matrix $B$. What are the missing elementary column operations?"] [17592186161691 :question/problem "$\\begin{bmatrix}1 & 4 & -7 \\\\ 2 & 2 & -8 \\\\ -3 & -2 & 1\\end{bmatrix}$\n\nBy applying elementary row operations of the form $R_i:=R_i+kR_1$, the matrix $A$ can be transformed into the matrix $B$. What are the elementary row operations?"] [17592186161691 :question/worked-solution "To transform $A$ into $B$, we need to make the entries below\n\n$$\na_{11}={\\color{blue}\\bbox[lightgray,2pt]{1}}\n$$\n\nequal to ${\\color{red}0}$.\n\nTo do this, we can apply the following elementary row operations:\n\n$$\n\\begin{aligned}\nA &= \\begin{bmatrix}1 & 4 & -7 \\\\ 2 & 2 & -8 \\\\ -3 & -2 & 1\\end{bmatrix}\\begin{vmatrix}R_{2}:=R_{2} - 2R_{1} \\\\ ∼\\begin{bmatrix}1 & 4 & -7 \\\\ 0 & -6 & 6 \\\\ -3 & -2 & 1\\end{bmatrix}\\end{vmatrix}R_{3}:=R_{3} + 3R_{1} \\\\\n&= ∼\\begin{bmatrix}1 & 4 & -7 \\\\ 0 & -6 & 6 \\\\ 0 & 10 & -20\\end{bmatrix} \\\\\n&= B\n\\end{aligned}\n$$\n\nTherefore, the elementary row operations are\n\n$\\qquad$\n\n$$\nR_2:=R_2-2R_1\\quad\n$$\n\nand\n\n$$\n\\quad R_3:=R_3+3R_1\n$$"] [17592186161689 :question/problem "$\\begin{bmatrix}-1 & 2 & 1 & 5 \\\\ 1 & 1 & 2 & -1 \\\\ -1 & 3 & 1 & 1 \\\\ 0 & -2 & 1 & 5\\end{bmatrix}$\n\nConsider the matrices $A$ and $B$ above. By applying three matrix elementary row operations\n\n1. $R_1:= \\ldots$\n2. $R_3:=R_3-3R_2$\n3. $R_4:= \\ldots$\n\neach of the form $R_i:=R_i+kR_2$, the matrix $A$ can be transformed into the matrix $B$. What are the missing elementary row operations?"] [17592186161689 :question/worked-solution "To transform $A$ into $B$, we need to make entries above and below\n\n$$\na_{22}={\\color{blue}\\bbox[lightgray,2pt]{1}}\n$$\n\nequal to ${\\color{red}0}$.\n\nTo do this, we can apply the following elementary row operations:\n\n$$\n\\begin{aligned}\nA &= \\begin{bmatrix}-1 & 2 & 1 & 5 \\\\ 1 & 1 & 2 & -1 \\\\ -1 & 3 & 1 & 1 \\\\ 0 & -2 & 1 & 5\\end{bmatrix}\\begin{vmatrix}R_{1}:=R_{1} - 2R_{2} \\\\ ∼\\begin{bmatrix}-3 & 0 & -3 & 7 \\\\ 1 & 1 & 2 & -1 \\\\ -1 & 3 & 1 & 1 \\\\ 0 & -2 & 1 & 5\\end{bmatrix}\\end{vmatrix}R_{3}:=R_{3} - 3R_{2} \\\\\n&= ∼\\begin{bmatrix}-3 & 0 & -3 & 7 \\\\ 1 & 1 & 2 & -1 \\\\ -4 & 0 & -5 & 4 \\\\ 0 & -2 & 1 & 5\\end{bmatrix} \\mid R_{4}:=R_{4} + 2R_{2} \\\\\n&= ∼\\begin{bmatrix}-3 & 0 & -3 & 7 \\\\ 1 & 1 & 2 & -1 \\\\ -4 & 0 & -5 & 4 \\\\ 2 & 0 & 5 & 3\\end{bmatrix} \\\\\n&= B\n\\end{aligned}\n$$\n\nTherefore, the missing elementary row operations are\n\n$\\qquad$\n\n$$\nR_1:= R_1 - 2R_2\\quad\n$$\n\nand\n\n$$\n\\quad R_4:=R_4+2R_2\n$$"] [17592186161692 :question/problem "$\\begin{bmatrix}-6 & -5 & 1 \\\\ 8 & 3 & -4 \\\\ 9 & 7 & -2\\end{bmatrix}$\n\nBy applying elementary column operations of the form $C_i:=C_i+kC_3$, the matrix $A$ can be transformed into the matrix $B$. What are the elementary column operations?"] [17592186161692 :question/worked-solution "To transform $A$ into $B$, we need to make entries to the left of\n\n$$\na_{13}={\\color{blue}\\bbox[lightgray,2pt]{1}}\n$$\n\nequal to ${\\color{red}0}$.\n\nTo do this, we can apply the following elementary column operations:\n\n$$\n\\begin{aligned}\nA &= \\begin{bmatrix}-6 & -5 & 1 \\\\ 8 & 3 & -4 \\\\ 9 & 7 & -2\\end{bmatrix}\\begin{vmatrix}C_{1}:=C_{1} + 6C_{3} \\\\ ∼\\begin{bmatrix}0 & -5 & 1 \\\\ -16 & 3 & -4 \\\\ -3 & 7 & -2\\end{bmatrix}\\end{vmatrix}C_{2}:=C_{2} + 5C_{3} \\\\\n&= ∼\\begin{bmatrix}0 & 0 & 1 \\\\ -16 & -17 & -4 \\\\ -3 & -3 & -2\\end{bmatrix} \\\\\n&= B\n\\end{aligned}\n$$\n\nTherefore, the elementary column operations are\n\n$\\qquad$\n\n$$\nC_1:=C_1+6C_3\\quad\n$$\n\nand\n\n$$\n\\quad C_2:=C_2+5C_3\n$$"] [17592186161690 :question/problem "$\\begin{bmatrix}7 & -3 & -1 & -6 \\\\ 7 & -2 & -2 & -4 \\\\ -5 & 1 & 4 & 2 \\\\ -8 & -3 & -6 & -4\\end{bmatrix}$\n\nConsider the matrices $A$ and $B$ above. By applying three matrix elementary column operations\n\n1. $C_1:=\\ldots$\n2. $C_3:= C_3 - 4C_2$\n3. $C_4:= \\ldots$\n\neach of the form $C_i:=C_i+kC_2$, the matrix $A$ can be transformed into the matrix $B$. What are the missing elementary column operations?"] [17592186161690 :question/worked-solution "To transform $A$ into $B$, we need to make entries to the left and to the right of\n\n$$\na_{32}={\\color{blue}\\bbox[lightgray,2pt]{1}}\n$$\n\nequal to ${\\color{red}0}$.\n\nTo do this, we can apply the following elementary column operations:\n\n$$\n\\begin{aligned}\nA &= \\begin{bmatrix}7 & -3 & -1 & -6 \\\\ 7 & -2 & -2 & -4 \\\\ -5 & 1 & 4 & 2 \\\\ -8 & -3 & -6 & -4\\end{bmatrix}\\begin{vmatrix}C_{1}:=C_{1} + 5C_{2} \\\\ ∼\\begin{bmatrix}-8 & -3 & -1 & -6 \\\\ -3 & -2 & -2 & -4 \\\\ 0 & 1 & 4 & 2 \\\\ -23 & -3 & -6 & -4\\end{bmatrix}\\end{vmatrix}C_{3}:=C_{3} - 4C_{2} \\\\\n&= ∼\\begin{bmatrix}-8 & -3 & 11 & -6 \\\\ -3 & -2 & 6 & -4 \\\\ 0 & 1 & 0 & 2 \\\\ -23 & -3 & 6 & -4\\end{bmatrix} \\mid C_{4}:=C_{4} - 2C_{2} \\\\\n&= ∼\\begin{bmatrix}-8 & -3 & 11 & 0 \\\\ -3 & -2 & 6 & 0 \\\\ 0 & 1 & 0 & 0 \\\\ -23 & -3 & 6 & 2\\end{bmatrix} \\\\\n&= B\n\\end{aligned}\n$$\n\nTherefore, the corresponding elementary column operations are\n\n$\\qquad$\n\n$$\nC_1:=C_1+5C_2\\quad\n$$\n\nand\n\n$$\n\\quad C_4:=C_4-2C_2\n$$"]] "immutable_answers" [17592186160507 17592186160508 17592186160509 17592186160510 17592186160511 17592186160513 17592186160514 17592186160515 17592186160516 17592186160517 17592186160519 17592186160520 17592186160521 17592186160522 17592186160523 17592186160525 17592186160526 17592186160527 17592186160528 17592186160529 17592186160609 17592186160610 17592186160611 17592186160612 17592186160613 1759218