#{[{:db/id #edb/ref 17592186184007 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "cc8dc1a1-9606-5b67-942e-219ab2ddfc1c" :knowledge-point/title "Finding a Power of a Nilpotent Matrix"}] :question/id #uuid "61a0b8a7-332d-5ae1-ad46-a65369bc87d1" :question/math-academy-id "e-4415" :question/problem "Find $B^2$ given that ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14051076/assets/4563fac713c404455cc9787f4cd30255e79c4f4c93368f004097ee92265b6842.png)" :question/worked-solution "Computing $B^2,$ we have\n\n$$\n\\begin{aligned}{B}^{2} & =B\\cdot B \\\\  & =[\\begin{aligned}3 & 9 \\\\ -1 & -3\\end{aligned}]\\cdot [\\begin{aligned}3 & 9 \\\\ -1 & -3\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}] \\\\  & =O.\\end{aligned}\n$$\n\nNotice that, since $B^2=O,$ the matrix $B$ is a nilpotent matrix of index $2.$"}] [{:db/id #edb/ref 17592186184008 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "b51e8ff1-247b-5efd-a684-8fca6c064e1e" :knowledge-point/title "Finding a Power of an Idempotent Matrix"}] :question/id #uuid "906ff9b7-c304-5b9a-b152-cef3bf343de1" :question/math-academy-id "e-4416" :question/problem "Find $C^5$ given that\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14051076/assets/c757e46b9d91c0f57e72fd05d2b5d83558332b6e20fcefdf75d9f0388796da05.png)" :question/worked-solution "First, we compute $C^2$ as follows:\n\n$$\n\\begin{aligned}{C}^{2} & =C\\cdot C \\\\  & =[\\begin{aligned}\\frac{1}{2} & 0 & \\frac{1}{2} \\\\ 0 & 1 & 0 \\\\ \\frac{1}{2} & 0 & \\frac{1}{2}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{2} & 0 & \\frac{1}{2} \\\\ 0 & 1 & 0 \\\\ \\frac{1}{2} & 0 & \\frac{1}{2}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{2} & 0 & \\frac{1}{2} \\\\ 0 & 1 & 0 \\\\ \\frac{1}{2} & 0 & \\frac{1}{2}\\end{aligned}] \\\\  & =C\\end{aligned}\n$$\n\nNotice that $C^2=C,$ so $C$ is an idempotent matrix. \n\nWe can use this fact to compute $C^5$ quickly, as follows:\n\n$$\n\\begin{aligned}{C}^{5} & ={C}^{2}\\cdot {C}^{2}\\cdot C \\\\  & =C\\cdot C\\cdot C \\\\  & ={C}^{2}\\cdot C \\\\  & =C\\cdot C \\\\  & ={C}^{2} \\\\  & =C\\end{aligned}\n$$\n\nTherefore,\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14051076/assets/213331b37f44266f8bec1e00252499c88b2dc89114f93243a18dd2d1caaaddc9.png)"}] [{:db/id #edb/ref 17592186328992 :knowledge-point/_questions [{:knowledge-point/id #uuid "cc8dc1a1-9606-5b67-942e-219ab2ddfc1c" :knowledge-point/title "Finding a Power of a Nilpotent Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bbb082f-0ebc-57fb-9f53-5f00307a9cc2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186328994} {:answer/id #uuid "94290f4b-306e-51e9-896d-c497feaee26e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186328995} {:answer/id #uuid "2aabaab2-ed95-5ccb-a9dc-5fbf865dab89" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & -12 \\\\ 3 & -6\\end{aligned}]" :db/id #edb/ref 17592186328996} {:answer/id #uuid "9a103cc8-5b1e-5b80-9a91-72115d433dff" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}8 & -64 \\\\ 1 & -8\\end{aligned}]" :db/id #edb/ref 17592186328997} {:answer/id #uuid "213ef954-98e2-5275-8f2d-aa5270db8d54" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 4 \\\\ 1 & 2\\end{aligned}]" :db/id #edb/ref 17592186328998}] :answer-field/correct {:answer/id #uuid "94290f4b-306e-51e9-896d-c497feaee26e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186328995} :answer-field/id #uuid "a1fc2822-01ed-5131-9a3c-88457d604615" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186328993}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d89d4cfc-04ae-58b4-94a3-0a7fbe7e0bc9" :question/math-academy-id "q-130591" :question/problem "If $B=[\\begin{aligned}2 & -4 \\\\ 1 & -2\\end{aligned}]$, then ${B}^{3}=$" :question/worked-solution "Computing ${B}^{2},$ we have\n\n$$\n\\begin{aligned}{B}^{2} & =B\\cdot B \\\\  & =[\\begin{aligned}2 & -4 \\\\ 1 & -2\\end{aligned}]\\cdot [\\begin{aligned}2 & -4 \\\\ 1 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}] \\\\  & =O.\\end{aligned}\n$$\n\nNotice that, since ${B}^{2}=O,$ the matrix $B$ is a nilpotent matrix of index $2.$ \n\nWe can use this fact to compute ${B}^{3}$ quickly, as follows: \n\n$$\n\\begin{aligned}{B}^{3} & ={B}^{2}\\cdot B \\\\  & =O\\cdot B \\\\  & =O\\end{aligned}\n$$\n\nTherefore,  \n\n$$\n{B}^{3}=[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186328999 :knowledge-point/_questions [{:knowledge-point/id #uuid "cc8dc1a1-9606-5b67-942e-219ab2ddfc1c" :knowledge-point/title "Finding a Power of a Nilpotent Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c01d5e3-f5b3-5e4f-b378-1a3195e40652" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186329001} {:answer/id #uuid "7c5893f4-64bd-5271-a4a1-e53ce889aab6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 36 \\\\ -144 & 0\\end{aligned}]" :db/id #edb/ref 17592186329002} {:answer/id #uuid "fb7d0699-3408-531f-bd41-d25f599a476a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}45 & 36 \\\\ 36 & 45\\end{aligned}]" :db/id #edb/ref 17592186329003} {:answer/id #uuid "06583529-ccb6-5dfb-9837-159e38614e62" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}45 & 0 \\\\ 0 & 45\\end{aligned}]" :d