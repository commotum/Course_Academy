igned}\n$$\n\nTherefore, \n\n$$\n{B}^{6}=[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186329041 :knowledge-point/_questions [{:knowledge-point/id #uuid "cc8dc1a1-9606-5b67-942e-219ab2ddfc1c" :knowledge-point/title "Finding a Power of a Nilpotent Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45cb91cd-351b-5907-8de5-b0660f283dbf" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186329043} {:answer/id #uuid "82729668-131d-550e-94cb-080b4bc15382" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186329044} {:answer/id #uuid "32524cc7-884b-554b-8421-5891e5b8dd16" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 \\\\ 3 & 0\\end{aligned}]" :db/id #edb/ref 17592186329045} {:answer/id #uuid "49a31fb7-344a-52f9-a82f-e44678f299fd" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 4 \\\\ 0 & 4\\end{aligned}]" :db/id #edb/ref 17592186329046} {:answer/id #uuid "17a7059a-795c-50b7-9454-a0dc894c95e3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 & 2 \\\\ -8 & 4\\end{aligned}]" :db/id #edb/ref 17592186329047}] :answer-field/correct {:answer/id #uuid "45cb91cd-351b-5907-8de5-b0660f283dbf" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186329043} :answer-field/id #uuid "a28bd4a3-750a-5565-a936-440c21f43eda" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329042}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c72f6c4f-9b59-585b-b38d-8495f054560d" :question/math-academy-id "q-78533" :question/problem "If $R=[\\begin{aligned}-4 & 2 \\\\ -8 & 4\\end{aligned}]$, then ${R}^{5}=$" :question/worked-solution "Computing ${R}^{2},$ we have\n\n$$\n\\begin{aligned}{R}^{2} & =R\\cdot R \\\\  & =[\\begin{aligned}-4 & 2 \\\\ -8 & 4\\end{aligned}]\\cdot [\\begin{aligned}-4 & 2 \\\\ -8 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}] \\\\  & =O.\\end{aligned}\n$$\n\nNotice that, since ${R}^{2}=O,$ the matrix $R$ is a nilpotent matrix of index $2.$ \n\nWe can use this fact to compute ${R}^{5}$ quickly, as follows:\n\n$$\n\\begin{aligned}{R}^{5} & ={R}^{2}\\cdot {R}^{3} \\\\  & =O\\cdot {R}^{3} \\\\  & =O\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{R}^{3}=[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186329048 :knowledge-point/_questions [{:knowledge-point/id #uuid "b51e8ff1-247b-5efd-a684-8fca6c064e1e" :knowledge-point/title "Finding a Power of an Idempotent Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6dbab2cd-b249-53f9-90e4-a98eb2417c4b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 1 & -1 \\\\ -1 & 0 & 0 \\\\ 0 & -1 & 0\\end{aligned}]" :db/id #edb/ref 17592186329050} {:answer/id #uuid "f125cf3d-eef1-5013-9a40-3babbaf3cb53" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & -1 & -1 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186329051} {:answer/id #uuid "0ab7176e-2fd4-532f-9e53-c5f5fc56b805" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186329052} {:answer/id #uuid "5554bce6-b2d6-5500-be48-1916b466966b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 1 & 1 \\\\ 0 & -1 & 1 \\\\ 0 & 1 & 0\\end{aligned}]" :db/id #edb/ref 17592186329053} {:answer/id #uuid "bf1c5ab6-4032-5b68-9d9b-00a521f71b10" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 1 & -1 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 0\\end{aligned}]" :db/id #edb/ref 17592186329054}] :answer-field/correct {:answer/id #uuid "bf1c5ab6-4032-5b68-9d9b-00a521f71b10" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 1 & -1 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 0\\end{aligned}]" :db/id #edb/ref 17592186329054} :answer-field/id #uuid "086ea9cb-46eb-54f7-90cf-e5debdbe1b8d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329049}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b730feb7-9d34-5e20-ac56-3caa8c36c3c6" :question/math-academy-id "q-78578" :question/problem "If $W=[\\begin{aligned}1 & 1 & -1 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 0\\end{aligned}]$, then ${W}^{4}=$" :question/worked-solution "First, we compute ${W}^{2}$ as follows:\n\n$$\n\\begin{aligned}{W}^{2} & =W\\cdot W \\\\  & =[\\begin{aligned}1 & 1 & -1 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 0\\end{aligned}]\\cdot [\\begin{aligned}1 & 1 & -1 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 & -1 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 0\\end{aligned}] \\\\  & =W\\end{aligned}\n$$\n\nNotice that ${W}^{2}=W,$ so $W$ is an idempotent matrix. \n\nWe can use this fact to compute ${W}^{4}$ quickly, as follows:\n\n$$\n\\begin{aligned}{W}^{4} & ={W}^{2}\\cdot {W}^{2} \\\\  & =W\\cdot W \\\\  & ={W}^{2} \\\\  & =W\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{W}^{4}=[\\begin{aligned}1 & 1 & -1 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 0\\end{aligned}].\n$$"}]}
