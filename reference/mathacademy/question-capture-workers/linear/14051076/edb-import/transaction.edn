7050f2e2429eeef77c4d6b074bbe0ac6930b936050" "q-36302/selection/438626748017a3654da8dbf423e81909d322df52791d13088f022ab7ef726485" "q-36302/selection/2c62ed5867d9fc16b469e57c1c7c9eb78bacd7ed8ffcd6d45f0fc18b5ba908e7"] :db/ensure [:answer-field/validate]} {:db/id "q-36302" :question/id #uuid "2594c879-7fd1-5b85-9df5-7ae761ff92cb" :question/math-academy-id "q-36302" :question/problem "If $C=[\\begin{aligned}0 & 0 & 2 \\\\ 3 & 1 & -6 \\\\ 0 & 0 & 1\\end{aligned}]$, then ${C}^{3}=$" :question/worked-solution "First, we compute ${C}^{2}$ as follows:\n\n$$\n\\begin{aligned}{C}^{2} & =C\\cdot C \\\\  & =[\\begin{aligned}0 & 0 & 2 \\\\ 3 & 1 & -6 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}0 & 0 & 2 \\\\ 3 & 1 & -6 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 & 2 \\\\ 3 & 1 & -6 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =C\\end{aligned}\n$$\n\nNotice that ${C}^{2}=C,$ so $C$ is an idempotent matrix.\n\nWe can use this fact to compute ${C}^{3}$ quickly, as follows:\n\n$$\n\\begin{aligned}{C}^{3} & ={C}^{2}\\cdot C \\\\  & =C\\cdot C \\\\  & ={C}^{2} \\\\  & =C\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{C}^{3}=[\\begin{aligned}0 & 0 & 2 \\\\ 3 & 1 & -6 \\\\ 0 & 0 & 1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-36302/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b51e8ff1-247b-5efd-a684-8fca6c064e1e"] :knowledge-point/questions ["q-36302"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-36315"] :question/problem "If $E=[\\begin{aligned}1 & 9 & 3 \\\\ 0 & 1 & 0 \\\\ 0 & -3 & 0\\end{aligned}]$, then ${E}^{4}=$" :question/worked-solution "First, we compute ${E}^{2}$ as follows:\n\n$$\n\\begin{aligned}{E}^{2} & =E\\cdot E \\\\  & =[\\begin{aligned}1 & 9 & 3 \\\\ 0 & 1 & 0 \\\\ 0 & -3 & 0\\end{aligned}]\\cdot [\\begin{aligned}1 & 9 & 3 \\\\ 0 & 1 & 0 \\\\ 0 & -3 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 9 & 3 \\\\ 0 & 1 & 0 \\\\ 0 & -3 & 0\\end{aligned}] \\\\  & =E\\end{aligned}\n$$\n\nNotice that ${E}^{2}=E,$ so $E$ is an idempotent matrix. \n\nWe can use this fact to compute ${E}^{4}$ quickly, as follows:\n\n$$\n\\begin{aligned}{E}^{4} & ={E}^{2}\\cdot {E}^{2} \\\\  & =E\\cdot E \\\\  & ={E}^{2} \\\\  & =E\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{E}^{4}=[\\begin{aligned}1 & 9 & 3 \\\\ 0 & 1 & 0 \\\\ 0 & -3 & 0\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-32436/selection/9a1191b8db8275322d052b98212cfcb2e79af676d45b969b6e6d5f72eb6fe997" :answer/id #uuid "49004166-d47a-5eaf-8127-fe82cf434c4b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{1}{2} & \\frac{1}{8} \\\\ 1 & \\frac{1}{4}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-32436/selection/fbb777b7fa17c4944697ed43d83d0bf353b48df7215d46d2e8c8016f39524369" :answer/id #uuid "e809ee71-be18-50c4-a14b-cce4ae75df0c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{1}{2} & \\frac{1}{8} \\\\ 1 & \\frac{1}{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-32436/selection/c24211e958d3c31d7d8443a3b614145f68a73e9350fc06cf7f40a13c191836f4" :answer/id #uuid "d959607a-4d16-50c2-9005-c2d696ff7eec" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{1}{2} & \\frac{1}{8} \\\\ \\frac{1}{4} & \\frac{1}{4}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-32436/selection/ef452855147c7d5168c8b595d81f0153e1f39e6564bd7bc261a8a4646437303d" :answer/id #uuid "f66f9ece-7b66-5026-9eb7-6e1b39331316" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{1}{2} & \\frac{1}{4} \\\\ 1 & \\frac{1}{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-32436/selection/5effbd91d970b143feccf2f3825d54316112a5a8ada74c99ab458bd38da3e202" :answer/id #uuid "ce2acb8a-f100-5a93-9ce3-3f78a93129a9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{1}{2} & \\frac{1}{4} \\\\ \\frac{1}{2} & \\frac{1}{