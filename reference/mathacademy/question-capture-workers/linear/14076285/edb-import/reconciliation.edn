qrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]$"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076285/state.json" "file_sha256" "5347c8dfb77d642652a9030e47ca43feb15acf1c8431d4fb734df5990d220acd"} {"question" "q-95092" "field" nil "attribute" "question/problem" "value" "Given the quadratic form $Q(x)=14{x}_{1}^{2}-6{x}_{1}{x}_{2}+6{x}_{2}^{2},$ find its canonical (diagonal) form ${y}^{T}\\,Dy$ and an orthogonal matrix $P$ such that $x=Py$ defines the corresponding change of variables." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076285/state.json" "file_sha256" "5347c8dfb77d642652a9030e47ca43feb15acf1c8431d4fb734df5990d220acd"} {"question" "q-95092" "field" nil "attribute" "question/worked-solution" "value" "First, we write down the matrix of our quadratic form:\n\n$$\nA=[\\begin{aligned}14 & -3 \\\\ -3 & -6\\end{aligned}]\n$$\n\nEvery quadratic form can be reduced to its canonical (diagonal) form using orthogonal transformations.\n\nTo find the coefficients of the canonical form, we need to calculate the eigenvalues of $A:$\n\n$$\n\\begin{aligned}|A-\\lambda I| & =0 \\\\ |\\begin{aligned}14-\\lambda  & -3 \\\\ -3 & 6-\\lambda \\end{aligned}| & =0 \\\\ {\\lambda }^{2}-20\\lambda +75 & =0 \\\\ \\lambda  & =15,\\,5\\end{aligned}\n$$\n\n \n\nNow, we need to find an eigenvector basis of $A.$ \n\n- For ${\\lambda }_{1}=15,$ we have\n\n$$\n\\begin{aligned}A-15I & =[\\begin{aligned}14 & -3 \\\\ -3 & 6\\end{aligned}]-15[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}-1 & -3 \\\\ -3 & -9\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-15I)x=0$ gives the eigenvector ${v}_{1}=[\\begin{aligned}-3 \\\\ 1\\end{aligned}].$ Dividing ${v}_{1}$ by its norm $‖{v}_{1}‖=\\sqrt{10},$ we get \n\n$$\n\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{10}}[\\begin{aligned}-3 \\\\ 1\\end{aligned}].\n$$\n\n- For ${\\lambda }_{2}=5,$ we have\n\n$$\n\\begin{aligned}A-5I & =[\\begin{aligned}14 & -3 \\\\ -3 & 6\\end{aligned}]-5[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}9 & -3 \\\\ -3 & 1\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-5I)x=0$ gives the eigenvector ${v}_{2}=[\\begin{aligned}1 \\\\ 3\\end{aligned}].$ Dividing ${v}_{2}$ by its norm $‖{v}_{2}‖=\\sqrt{10},$ we get \n\n$$\n\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{10}}[\\begin{aligned}1 \\\\ 3\\end{aligned}].\n$$\n\nFinally, we construct the diagonal matrix $D$ (writing the eigenvalues in descending order) and the orthogonal matrix $P$ in the usual way, and this gives us the following:\n\n$$\nD=[\\begin{aligned}15 & 0 \\\\ 0 & 5\\end{aligned}],\\,P=[\\begin{aligned}-\\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}} & \\frac{3}{\\sqrt{10}}\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076285/state.json" "file_sha256" "5347c8dfb77d642652a9030e47ca43feb15acf1c8431d4fb734df5990d220acd"} {"question" "q-95092" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076285/activity-metadata.json" "file_sha256" "ead9c6cf66c48ca0ffe8dde9b6f7a28f21db0354bb25d99f03ee33b6185ac8ed"} {"question" "q-95092" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076285/state.json" "file_sha256" "5347c8dfb77d642652a9030e47ca43feb15acf1c8431d4fb734df5990d220acd"} {"question" "q-95092" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "$D=[\\begin{aligned}15 & 0 \\\\ 0 & -5\\end{aligned}]$ and $P=[\\begin{aligned}-\\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{aligned}]$"] ["text" "$D=[\\begin{aligned}15 & 0 \\\\ 0 & 5\\end{aligned}]$ and $P=[\\begin{aligned}-\\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}} & \\frac{3}{\\sqrt{10}}\\end{aligned}]$"] ["text" "$D=[\\begin{aligned}15 & 0 \\\\ 0 & 5\\end{aligned}]$ and $P=[\\begin{aligned}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{aligned}]$"] ["text" "$D=[\\begin{aligned}5 & 0 \\\\ 0 & -15\\end{aligned}]$ and $P=[\\begin{aligned}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]$"] ["text" "$D=[\\begin{aligned}5 & 0 \\\\ 0 & -15\\end{aligned}]$ and $P=[\\begin{aligned}\\frac{3}{\\sqrt{10}} & -\\frac{1}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}} & \\frac{3}{\\sqrt{10}}\\end{aligned}]$"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076285/state.json" "file_sha256" "5347c8dfb77d642652a9030e47ca43feb15acf1c8431d4fb734df5990d220acd"} {"question" "q-95092" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "$D=[\\begin{aligned}15 & 0 \\\\ 0 & 5\\end{aligned}]$ and $P=[\\begin{aligned}-\\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}} & \\frac{3}{\\sqrt{10}}\\end{aligned}]$"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076285/state.json" "file_sha256" "5347c8dfb77d642652a9030e47ca43feb15acf1c8431d4fb734df5990d220acd"} {"question" "q-140998" "field" nil "attribute" "question/problem" "value" "Given the quadratic form $Q(x)={x}_{1}^{2}-6{x}_{1}{x}_{2}+9{x}_{2}^{2},$ find its canonical (diagonal) form ${y}^{T}\\,Dy$ and an orthogonal matrix $P$ such that $x=Py$ defines the corresponding change of variables." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076285/state.json" "file_sha256" "5347c8dfb77d642652a9030e47ca43feb15acf1c8431d4fb734df5990d220acd"} {"question" "q-140998" "field" nil "attribute" "question/worked-solution" "value" "First, we write down the matrix of our quadratic form:\n\n$$\nA=[\\begin{aligned}1 & -3 \\\\ -3 & 9\\end{aligned}]\n$$\n\nEvery quadratic form can be reduced to its canonical (diagonal) form using orthogonal transformations.\n\nTo find the coefficients of the canonical form, we need to calculate the eigenvalues of $A:$\n\n$$\n\\begin{aligned}|A-\\lambda I| & =0 \\\\ |\\begin{aligned}1-\\lambda  & -3 \\\\ -3 & 9-\\lambda \\end{aligned}| & =0 \\\\ {\\lambda }^{2}-10\\lambda  & =0 \\\\ \\lambda  & =10,\\,0\\end{aligned}\n$$\n\n \n\nNow, we need to find an eigenvector basis of $A.$ \n\n- For ${\\lambda }_{1}=10,$ we have\n\n$$\n\\begin{aligned}A-10I & =[\\begin{aligned}1 & -3 \\\\ -3 & 9\\end{aligned}]-10[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}-9 & -3 \\\\ -3 & -1\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-10I)x=0$ gives the eigenvector ${v}_{1}=[\\begin{aligned}-1 \\\\ 3\\end{aligned}].$ Dividing ${v}_{1}$ by its norm $‖{v}_{1}‖=\\sqrt{10},$ we get \n\n$$\n\\frac{{v}_{1}}{‖{v}_{1}‖}=-\\frac{1}{\\sqrt{10}}[\\begin{aligned}-1 \\\\ 3\\end{aligned}]=[\\begin{aligned}-\\frac{1}{\\sqrt{\\sqrt{1}0}} \\\\ \\frac{3}{\\sqrt{10}}\\end{aligned}].\n$$\n\n- For ${\\lambda }_{2}=0,$ we have\n\n$$\n\\begin{aligned}A-0I & =[\\begin{aligned}1 & -3 \\\\ -3 & 9\\end{aligned}]-0[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}1 & -3 \\\\ -3 & 9\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-0I)x=0$ gives the eigenvector ${v}_{2}=[\\begin{aligned}3 \\\\ 1\\end{aligned}].$ Dividing ${v}_{2}$ by its norm $‖{v}_{2}‖=\\sqrt{10},$ we get \n\n$$\n\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{10}}[\\begin{aligned}3 \\\\ 1\\end{aligned}]=[\\begin{aligned}\\frac{3}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}}\\end{aligned}].\n$$\n\nFinally, we construct the diagonal matrix $D$ (writing the eigenvalues in descending order) and the orthogonal matrix $P$ in the usual way, and this gives us the following:\n\n$$\nD=[\\begin{aligned}10 & 0 \\\\ 0 & 0\\end{aligned}],\\,P=[\\begin{aligned}-\\frac{1}{\\sqrt{10}} & \\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076285/state.json" "file_sha256" "5347c8dfb77d642652a9030e47ca43feb15acf1c8431d4fb734df5990d220acd"} {"question" "q-140998" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076285/activity-metadata.json" "file_sha256" "ead9c6cf66c48ca0ffe8dde9b6f7a28f21db0354bb25d99f03ee33b6185ac8ed"} {"question" "q-140998" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076285/state.json" "file_sha256" "5347c8dfb77d642652a9030e47ca43feb15acf1c8431d4fb734df5990d220acd"} {"question" "q-140998" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "$D=[\\begin{aligned}10 & 0 \\\\ 0 & 0\\end{aligned}]$ and $P=[\\begin{aligned}-\\frac{1}{\\sqrt{10}} & \\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{aligned}]$"] ["text" "$D=[\\begin{aligned}3 & 0 \\\\ 0 & -3\\end{aligned}]$ and $P=[\\begin{aligned}-\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{aligned}]$"] ["text" "$D=[\\begin{aligned}5 & 0 \\\\ 0 & 0\\end{aligned}]$ and $P=[\\begin{aligned}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]$"] ["text" "$D=[\\begin{aligned}5 & 0 \\\\ 0 & 5\\end{aligned}]$ and $P=[\\begin{aligned}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]$"] ["text" "$D=[\\begin{aligned}9 & 0 \\\\ 0 & 3\\end{aligned}]$ and $P=[\\begin{aligned}-\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{aligned}]$"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076285/state.json" "file_sha256" "5347c8dfb77d642652a9030e47ca43feb15acf1c8431d4fb734df5990d220acd"} {"question" "q-140998" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "$D=[\\begin{aligned}10 & 0 \\\\ 0 & 0\\end{aligned}]$ and $P=[\\begin{aligned}-\\frac{1}{\\sqrt{10}} & \\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{aligned}]$"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076285/state.json" "file_sha256" "5347c8dfb77d642652a9030e47ca43feb15acf1c8431d4fb734df5990d220acd"} {"question" "q-95103" "field" nil "attribute" "question/problem" "value" "$$\nA=[\\begin{aligned}2 & 4 & 0 \\\\ 4 & 8 & 0 \\\\ 0 & 0 & 1\\end{aligned}],\\,D=[\\begin{aligned}10 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\n$$\n\nConsider the matrices given above.\nFind an orthogonal matrix $P$ such that $x=Py$ defines the corresponding change of variables that reduces the quadratic form $Q(x)={x}^{T}\\,Ax$ to the canonical (diagonal) form ${y}^{T}\\,Dy.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076285/state.json" "file_sha256" "5347c8dfb77d642652a9030e47ca43feb15acf1c8431d4fb734df5990d220acd"} {"question" "q-95103" "field" nil "attribute" "question/worked-solution" "value" "Every quadratic form can be reduced to its canonical (diagonal) form using orthogonal transformations.\n\nFrom the diagonal matrix $D,$ we deduce that the eigenvalues of the matrix $A$ are \n\n$\\,$ ${\\lambda }_{1}=10,\\,$ ${\\lambda }_{2}=1,\\,$ and $\\,{\\lambda }_{3}=0.$\n\nNow, we need to find an eigenvector basis of $A.$ \n\n- For ${\\lambda }_{1}=10,$ we have\n\n$$\n\\begin{aligned}A-10I & =[\\begin{aligned}2 & 4 & 0 \\\\ 4 & 8 & 0 \\\\ 0 & 0 & 1\\end{aligned}]-10[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}-8 & 4 & 0 \\\\ 4 & -2 & 0 \\\\ 0 & 0 & -9\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-10I)x=0$ gives the eigenvector ${v}_{1}=[\\begin{aligned}1 \\\\ 2 \\\\ 0\\end{aligned}].$ Dividing ${v}_{1}$ by its norm $‖{v}_{1}‖=\\sqrt{5},$ we get \n\n$$\n\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{5}}[\\begin{aligned}1 \\\\ 2 \\\\ 0\\end{aligned}].\n$$\n\n- For ${\\lambda }_{2}=1,$ we have\n\n$$\n\\begin{aligned}A-I & =[\\begin{aligned}2 & 4 & 0 \\\\ 4 & 8 & 0 \\\\ 0 & 0 & 1\\end{aligned}]-[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}1 & 4 & 0 \\\\ 4 & 7 & 0 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-I)x=0$ gives the eigenvector ${v}_{2}=[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}].$ Dividing ${v}_{2}$ by its norm $‖{v}_{2}‖=1,$ we get \n\n$$\n\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{1}[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]=[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}].\n$$\n\n- For ${\\lambda }_{3}=0,$ we have\n\n$$\n\\begin{aligned}A-0I & =[\\begin{aligned}2 & 4 & 0 \\\\ 4 & 8 & 0 \\\\ 0 & 0 & 1\\end{aligned}]-0[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}2 & 4 & 0 \\\\ 4 & 8 & 0 \\\\ 0 & 0 & 1\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-0I)x=0$ gives the eigenvector ${v}_{3}=[\\begin{aligned}-2 \\\\ 1 \\\\ 0\\end{aligned}].$ Dividing ${v}_{3}$ by its norm $‖{v}_{3}‖=\\sqrt{5},$ we get \n\n$$\n\\frac{{v}_{3}}{‖{v}_{3}‖}=\\frac{1}{\\sqrt{5}}[\\begin{aligned}-2 \\\\ 1 \\\\ 0\\end{aligned}].\n$$\n\nFinally, we construct the orthogonal matrix $P$ in the usual way, and this gives us the following:\n\n$$\nP=[\\begin{aligned}\\frac{1}{\\sqrt{5}} & 0 & -\\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & 0 & \\frac{1}{\\sqrt{5}} \\\\ 0 & 1 & 0\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076285/state.json" "file_sha256" "5347c8dfb77d642652a9030e47ca43feb15acf1c8431d4fb734df5990d220acd"} {"question" "q-95103" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076285/activity-metadata.json" "file_sha256" "ead9c6cf66c48ca0ffe8dde9b6f7a28f21db0354bb25d99f03ee33b6185ac8ed"} {"question" "q-95103" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076285/state.json" "file_sha256" "5347c8dfb77d642652a9030e47ca43feb15acf1c8431d4fb734df5990d220acd"} {"question" "q-95103" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}0 & -\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ 0 & \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ 1 & 0 & 0\\end{aligned}]"] ["math" "[\\begin{aligned}0 & -\\frac{1}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}} \\\\ 0 & \\frac{1}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}} \\\\ 1 & 0 & 0\\end{aligned}]"] ["math" "[\\begin{aligned}\\frac{1}{\\sqrt{2}} & 0 & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}} \\\\ 0 & 1 & 0\\end{aligned}]"] ["math" "[\\begin{aligned}\\frac{1}{\\sqrt{5}} & 0 & -\\frac{2}{\\sqrt{5}} \\\\ 0 & 1 & 0 \\\\ \\frac{2}{\\sqrt{5}} & 0 & \\frac{1}{\\sqrt{5}}\\end{aligned}]"] ["math" "[\\begin{aligned}\\frac{1}{\\sqrt{5}} & 0 & -\\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & 0 & \\frac{1}{\\sqrt{5}} \\\\ 0 & 1 & 0\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076285/state.json" "file_sha256" "5347c8dfb77d642652a9030e47ca43feb15acf1c8431d4fb734df5990d220acd"} {"question" "q-95103" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}\\frac{1}{\\sqrt{5}} & 0 & -\\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & 0 & \\frac{1}{\\sqrt{5}} \\\\ 0 & 1 & 0\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076285/state.json" "file_sha256" "5347c8dfb77d642652a9030e47ca43feb15acf1c8431d4fb734df5990d220acd"} {"question" "q-95100" "field" nil "attribute" "question/problem" "value" "$$\nA=[\\begin{aligned}-1 & 1 & 0 \\\\ 1 & -1 & 0 \\\\ 0 & 0 & 2\\end{aligned}],\\,D=[\\begin{aligned}2 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & -2\\end{aligned}]\n$$\n\nConsider the matrices given above.\nFind an orthogonal matrix $P$ such that $x=Py$ defines the corresponding change of variables that reduces the quadratic form $Q(x)={x}^{T}\\,Ax$ to the canonical (diagonal) form ${y}^{T}\\,Dy.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076285/state.json" "file_sha256" "5347c8dfb77d642652a9030e47ca43feb15acf1c8431d4fb734df5990d220acd"} {"question" "q-95100" "field" nil "attribute" "question/worked-solution" "value" "Every quadratic form can be reduced to its canonical (diagonal) form using orthogonal transformations.\n\nFrom the diagonal matrix $D,$ we deduce that the eigenvalues of the matrix $A$ are \n\n$\\,$ ${\\lambda }_{1}=2,\\,$ ${\\lambda }_{2}=0,\\,$ and $\\,{\\lambda }_{3}=-2.$\n\nNow, we need to find an eigenvector basis of $A.$ \n\n- For ${\\lambda }_{1}=2,$ we have\n\n$$\n\\begin{aligned}A-2I & =[\\begin{aligned}-1 & 1 & 0 \\\\ 1 & -1 & 0 \\\\ 0 & 0 & 2\\end{aligned}]-2[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}-3 & 1 & 0 \\\\ 1 & -3 & 0 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-2I)x=0$ gives the eigenvector ${v}_{1}=[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}].$ Dividing ${v}_{1}$ by its norm $‖{v}_{1}‖=1,$ we get \n\n$$\n\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{1}[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]=[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}].\n$$\n\n- For ${\\lambda }_{2}=0,$ we have\n\n$$\n\\begin{aligned}A-0I & =[\\begin{aligned}-1 & 1 & 0 \\\\ 1 & -1 & 0 \\\\ 0 & 0 & 2\\end{aligned}]-0[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}-1 & 1 & 0 \\\\ 1 & -1 & 0 \\\\ 0 & 0 & 2\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-0I)x=0$ gives the eigenvector ${v}_{2}=[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}].$ Dividing ${v}_{2}$ by its norm $‖{v}_{2}‖=\\sqrt{2},$ we get \n\n$$\n\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}].\n$$\n\n- For ${\\lambda }_{3}=-2,$ we have\n\n$$\n\\begin{aligned}A-(-2)I & =[\\begin{aligned}-1 & 1 & 0 \\\\ 1 & -1 & 0 \\\\ 0 & 0 & 2\\end{aligned}]-(-2)[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}1 & 1 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 4\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-(-2)I)x=0$ gives the eigenvector ${v}_{3}=[\\begin{aligned}-1 \\\\ 1 \\\\ 0\\end{aligned}].$ Dividing ${v}_{3}$ by its norm $‖{v}_{3}‖=\\sqrt{2},$ we get \n\n$$\n\\frac{{v}_{3}}{‖{v}_{3}‖}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 \\\\ 1 \\\\ 0\\end{aligned}].\n$$\n\nFinally, we construct the orthogonal matrix $P$ in the usual way, and this gives us the following:\n\n$$\nP=[\\begin{aligned}0 & \\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ 0 & \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ 1 & 0 & 0\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076285/state.json" "file_sha256" "5347c8dfb77d642652a9030e47ca43feb15acf1c8431d4fb734df5990d220acd"} {"question" "q-95100" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076285/activity-metadata.json" "file_sha256" "ead9c6cf66c48ca0ffe8dde9b6f7a28f21db0354bb25d99f03ee33b6185ac8ed"} {"question" "q-95100" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076285/state.json" "file_sha256" "5347c8dfb77d642652a9030e47ca43feb15acf1c8431d4fb734df5990d220acd"} {"question" "q-95100" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-\\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}} \\\\ 0 & 1 & 0 \\\\ \\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}}\\end{aligned}]"] ["math" "[\\begin{aligned}0 & \\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ 0 & \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ 1 & 0 & 0\\end{aligned}]"] ["math" "[\\begin{aligned}0 & \\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ 1 & 0 & 0 \\\\ 0 & \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]"] ["math" "[\\begin{aligned}0 & \\frac{1}{\\sqrt{2}} & -\\frac{2}{\\sqrt{5}} \\\\ 0 & \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{5}} \\\\ 1 & 0 & 0\\end{aligned}]"] ["math" "[\\begin{aligned}\\frac{1}{\\sqrt{2}} & 0 & -\\frac{1}{\\sqrt{2}} \\\\ 0 & 1 & 0 \\\\ \\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}}\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Develope