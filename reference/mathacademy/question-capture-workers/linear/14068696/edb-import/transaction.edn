[{:db/id "q-4636/selection/f7031104f14fe004994e4fe4b8af3fbe4e65cfa2bff3c7eab1748f5f2092c758" :answer/id #uuid "722bff88-a67b-57b1-9c05-91136b424675" :answer/type :answer.type/math :answer/value "y=1" :db/ensure [:answer/validate]} {:db/id "q-4636/selection/96efe327aa5df1953454aa8a0acb24299d8e2e2f538b2a5f40d98e7332b886b7" :answer/id #uuid "1a6efa0d-ca66-5d3f-a810-292a58fcf623" :answer/type :answer.type/math :answer/value "y=0" :db/ensure [:answer/validate]} {:db/id "q-4636/selection/dbaf85835946aefb97564ba0d1ea287b684a4c8821f4256502e349376df74d28" :answer/id #uuid "464da4c9-214a-5940-ab57-8174ac122774" :answer/type :answer.type/math :answer/value "y=2" :db/ensure [:answer/validate]} {:db/id "q-4636/selection/3e622b14fb9e8408568d99d85f4dbc69d704ea59c7efa30ae415e06682e77843" :answer/id #uuid "14574f5d-9fef-5e0a-84d3-03e5ad3b5644" :answer/type :answer.type/text :answer/value "No horizontal asymptotes" :db/ensure [:answer/validate]} {:db/id "q-4636/selection/f5d98a631ee48ed70accf24f8b6cebcd32363395da4e87feeaf883d85b9bc131" :answer/id #uuid "ade529c8-7f3a-57e1-8368-45d8f6ac77de" :answer/type :answer.type/math :answer/value "y=-2" :db/ensure [:answer/validate]} {:db/id "q-4636/selection" :answer-field/id #uuid "c29a19c0-97cf-5dd4-8b8c-375d038c2334" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-4636/selection/3e622b14fb9e8408568d99d85f4dbc69d704ea59c7efa30ae415e06682e77843" :answer-field/choices ["q-4636/selection/f7031104f14fe004994e4fe4b8af3fbe4e65cfa2bff3c7eab1748f5f2092c758" "q-4636/selection/96efe327aa5df1953454aa8a0acb24299d8e2e2f538b2a5f40d98e7332b886b7" "q-4636/selection/dbaf85835946aefb97564ba0d1ea287b684a4c8821f4256502e349376df74d28" "q-4636/selection/3e622b14fb9e8408568d99d85f4dbc69d704ea59c7efa30ae415e06682e77843" "q-4636/selection/f5d98a631ee48ed70accf24f8b6cebcd32363395da4e87feeaf883d85b9bc131"] :db/ensure [:answer-field/validate]} {:db/id "q-4636" :question/id #uuid "625f75a2-b61e-5217-82ce-3d541a7f692b" :question/math-academy-id "q-4636" :question/problem "Determine the horizontal asymptote of $f(x)=\\frac{2{x}^{2}+x+6}{x-1}.$" :question/worked-solution "To find the horizontal asymptote of a rational function, we divide every term in the numerator and denominator by the dominant term in the denominator, and then we let $x\\to \\infty .$\n\nIgnoring the coefficient, the dominant term in the denominator is $x.$ So, we divide every term in the numerator and denominator by $x,$ as follows:\n\n$$\n\\begin{aligned}f(x) & =\\frac{2{x}^{2}+x+6}{x-1} \\\\  & =\\frac{(\\frac{2{x}^{2}}{x}+\\frac{x}{x}+\\frac{6}{x})}{(\\frac{x}{x}-\\frac{1}{x})} \\\\  & =\\frac{(2x+1+\\frac{6}{x})}{(1-\\frac{1}{x})}\\end{aligned}\n$$\n\nNow, when $x$ is very large, the terms $\\frac{6}{x}$ and $\\frac{1}{x}$ become very small. Therefore, as $x\\to \\infty ,$ we have\n\n$$\n\\begin{aligned}f(x) & =\\frac{(2x+1+\\frac{6}{x})}{(1-\\frac{1}{x})} \\\\  & ≈\\frac{2x+1+0}{1-0} \\\\  & =\\frac{2x+1}{1} \\\\  & =2x+1.\\end{aligned}\n$$\n\nThis is not a constant, which means that $y=f(x)$ does not have a horizontal asymptote." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-4636/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "653503b2-4631-561e-af5e-847bcbdfe8e2"] :knowledge-point/questions ["q-4636"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113169/selection/b26e894d2fd0ebe4d4ef7ab1da3fb9999e873039fa04418de269237f3fd74950" :answer/id #uuid "0bd5eed7-c3f9-5fe2-b8c3-ec5c993a60cc" :answer/type :answer.type/math :answer/value "y=-\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-113169/selection/25eb914fe9ac4d670cc8b64d7e8deee9c4123c32ede90f0fd11dc435564dd91d" :answer/id #uuid "20170f73-5100-5208-ac5f-751243af6d72" :answer/type :answer.type/math :answer/value "y=3" :db/ensure [:answer/validate]} {:db/id "q-113169/selection/feb2c353acce484cb267fc95bae1ab6db185f770de87fe9eb4e168b5aa1d3a8e" :answer/id #uuid "52746fa9-7504-5798-bf0a-0bbde