}{{y}_{3}}+{x}_{4}\\overset{―}{{y}_{4}} \\\\  & =i\\cdot (\\overset{―}{\\,i})+(-i)\\cdot \\overset{―}{2}+i\\cdot (\\overset{―}{-\\text{i}})+(-1)\\cdot (\\overset{―}{-1}) \\\\  & =i\\cdot (-i)-i\\cdot 2+i\\cdot \\text{i}+(-1)\\cdot (-1) \\\\  & =1-2i+(-1)+1 \\\\  & =1-2i.\\end{aligned}\n$$" 13194139535155 true] [17592186334302 1000 #edb/ref 17592186334303 13194139535155 true] [17592186334302 1000 #edb/ref 17592186334304 13194139535155 true] [17592186334302 1000 #edb/ref 17592186334305 13194139535155 true] [17592186334302 1000 #edb/ref 17592186334306 13194139535155 true] [17592186334302 1000 #edb/ref 17592186334307 13194139535155 true] [17592186334302 1040 #edb/ref 17592186045450 13194139535155 true] [17592186334302 1041 "selection" 13194139535155 true] [17592186334302 1104 #edb/ref 17592186334303 13194139535155 true] [17592186334302 1110 #uuid "46e0626f-f2c0-5dee-9e46-638685c6c00c" 13194139535155 true] [17592186334303 1034 "1-2i" 13194139535155 true] [17592186334303 1103 #edb/ref 17592186045453 13194139535155 true] [17592186334303 1111 #uuid "9a5803e9-db74-5982-b6f2-4b4d7e0862c1" 13194139535155 true] [17592186334304 1034 "1+i" 13194139535155 true] [17592186334304 1103 #edb/ref 17592186045453 13194139535155 true] [17592186334304 1111 #uuid "87cd1794-cf65-5d0c-98d6-18da584a818b" 13194139535155 true] [17592186334305 1034 "3+2i" 13194139535155 true] [17592186334305 1103 #edb/ref 17592186045453 13194139535155 true] [17592186334305 1111 #uuid "3431ee9a-01f9-5aa4-ab6e-6b0eae3c6f23" 13194139535155 true] [17592186334306 1034 "4-4i" 13194139535155 true] [17592186334306 1103 #edb/ref 17592186045453 13194139535155 true] [17592186334306 1111 #uuid "5a63d12c-ffba-5fb0-92d6-f582d6a52f93" 13194139535155 true] [17592186334307 1034 "2-i" 13194139535155 true] [17592186334307 1103 #edb/ref 17592186045453 13194139535155 true] [17592186334307 1111 #uuid "43ca74d0-2637-5af4-8127-0c03d8f4fa2c" 13194139535155 true] [17592186334308 1017 #edb/ref 17592186334309 13194139535155 true] [17592186334308 1089 "q-97167" 13194139535155 true] [17592186334308 1091 #edb/ref 17592186045465 13194139535155 true] [17592186334308 1100 "Given that $⟨\\,\\cdot \\,,\\,\\cdot \\,⟩$ is the standard Hermitian inner product over $C,$ find $⟨2a-b,\\,c⟩$ if \n\n$\\,$ $⟨a,c⟩=8+\\text{i}\\,$ and $\\,⟨c,b⟩=4-5\\text{i}.$" 13194139535155 true] [17592186334308 1113 #uuid "6140addf-ac61-581c-af38-58b12a2e258d" 13194139535155 true] [17592186334308 1145 "Recall that the inner product over $C$ satisfies the following properties. \n\n- It is linear in the first argument. For any $a,b,c\\in {C}^{n}$ and any $\\alpha \\in C,$ we have\n\n$\\,$ $⟨a+b,c⟩=⟨a,c⟩+⟨b,c⟩\\,$ and $\\,⟨\\alpha a,b⟩=\\alpha ⟨a,b⟩.$\n\n- It is antilinear in the second argument. For any $a,b,c\\in {C}^{n}$ and any $\\alpha \\in C,$ we have\n\n$\\,$ $⟨a,b+c⟩=⟨a,b⟩+⟨a,c⟩\\,$ and $\\,⟨a,\\alpha b⟩=\\overset{―}{\\alpha }⟨a,b⟩.$\n\n- It has conjugate symmetry. For any $a,b\\in {C}^{n},$ we have\n\n$\\,$ $⟨a,b⟩=\\overset{―}{⟨b,a⟩}.$\n\n- It is positive-definite. For any $a\\in {C}^{n},$ we have\n\n$\\,$ $⟨a,a⟩$ is a non-negative real number, and $⟨a,a⟩=0$ if and only if $a=0.$\n\nFirst, we use the fact that the inner product over $C$ is linear in the first argument: \n\n$$\n\\begin{aligned}⟨2a-b,\\,c⟩ & =⟨2a,c⟩-⟨b,c⟩ \\\\  & =2⟨a,c⟩-⟨b,c⟩\\end{aligned}\n$$\n\n \n\nNext, we use the fact that the inner product over $C$ has conjugate symmetry: \n\n$$\n\\begin{aligned}2⟨a,c⟩-⟨b,c⟩ & =2⟨a,c⟩-\\overset{―}{⟨c,b}⟩\\end{aligned}\n$$\n\nFinally, we substitute the values for $⟨a,c⟩$ and $⟨c,b⟩:$    \n\n$$\n\\begin{aligned}2⟨a,c⟩-\\overset{―}{⟨c,b}⟩ & =2(8+\\text{i})-(\\overset{―}{4-5\\text{i}}) \\\\  & =2(8+\\text{i})-(4+5\\text{i}) \\\\  & =16+2\\text{i}-4-5\\text{i} \\\\  & =12-3\\text{i}\\end{aligned}\n$$" 13194139535155 true] [17592186334309 1000 #edb/ref 17592186334310 13194139535155 true] [17592186334309 1000 #edb/ref 17592186334311 13194139535155 true] [17592186334309 1000 #edb/ref 17592186334312 13194139535155 true] [17592186334309 1000 #edb/ref 17592186334313 13194139535155 true] [17592186334309 1000 #edb/ref 17592186334314 13194139535155 true] [17592186334309 1040 #edb/ref 17592186045450 13194139535155 true] [17592186334309 1041 "selection" 13194139535155 true] [17592186334309 1104 #edb/ref 17592186334311 13194139535155 true] [17592186334309 1110 #uuid "952730dc-add8-574d-835c-407db745d23a" 13194139535155 true] [17592186334310 1034 "10+8\\text{i}" 13194139535155 true] [17592186334310 1103 #edb/ref 17592186045453 13194139535155 true] [17592186334310 1111 #uuid "a4509992-50c1-5828-ab5b-07250578b3a2" 13194139535155 true] [17592186334311 1034 "12-3\\text{i}" 13194139535155 true] [17592186334311 1103 #edb/ref 17592186045453 13194139535155 true] [17592186334311 1111 #uuid "31b5d283-2a55-541e-ae49-bd7e65c9d3e0" 13194139535155 true] [17592186334312 1034 "6+8\\text{i}" 13194139535155 true] [17592186334312 1103 #edb/ref 17592186045453 13194139535155 true] [17592186334312 1111 #uuid "75364442-42c3-561f-b9ac-c519065bafd3" 13194139535155 true] [17592186334313 1034 "-5+6\\text{i}" 13194139535155 true] [17592186334313 1103 #edb/ref 17592186045453 13194139535155 true] [17592186334313 1111 #uuid "3e95a633-20e9-5d84-8b07-c79f45acfa9d" 13194139535155 true] [17592186334314 1034 "4-\\text{i}" 13194139535155 true] [17592186334314 1103 #edb/ref 17592186045453 13194139535155 true] [17592186334314 1111 #uuid "76940e5b-58bc-5dbd-8b37-71eeea87b239" 13194139535155 true] [17592186334315 1017 #edb/ref 17592186334316 13194139535155 true] [17592186334315 1089 "q-97303" 13194139535155 true] [17592186334315 1091 #edb/ref 17592186045465 13194139535155 true] [17592186334315 1100 "Consider the standard Hermitian inner product $⟨\\,\\cdot \\,,\\,\\cdot \\,⟩$ over $C.$ \nWhich of the following statements are true? \n\n- $⟨b,a⟩=\\overset{―}{⟨a,b⟩}$ for any $a,b\\in {C}^{n}$\n- $i⟨a,b⟩=⟨-ia,b⟩$ for any  $a,b\\in {C}^{n}$\n- $⟨a,a⟩\\in R$ for any $a\\in {C}^{n}$" 13194139535155 true] [17592186334315 1113 #uuid "ceaeef65-5cc5-5bd2-865b-0a244110fe3c" 13194139535155 true] [17592186334315 1145 "Recall that the standard Hermitian inner product over $C$ satisfies the following properties:\n\n- It is linear in the first argument. For any $a,b,c\\in {C}^{n}$ and any $\\alpha \\in C,$ we have\n\n$\\,$ $⟨a+b,c⟩=⟨a,c⟩+⟨b,c⟩\\,$ and $\\,⟨\\alpha a,b⟩=\\alpha ⟨a,b⟩.$\n\n- It is antilinear in the second argument. For any $a,b,c\\in {C}^{n}$ and any $\\alpha \\in C,$ we have\n\n$\\,$ $⟨a,b+c⟩=⟨a,b⟩+⟨a,c⟩\\,$ and $\\,⟨a,\\alpha b⟩=\\overset{―}{\\alpha }⟨a,b⟩.$\n\n- It has conjugate symmetry. For any $a,b\\in {C}^{n},$ we have\n\n$\\,$ $⟨a,b⟩=\\overset{―}{⟨b,a⟩}.$\n\n- It is positive-definite. For any $a\\in {C}^{n},$ we have\n\n$\\,$ $⟨a,a⟩$ is a non-negative real number, and $⟨a,a⟩=0$ if and only if $a=0.$\n\nWith that in mind, let's examine our statements. \n\n- Statement I is true. The inner product over $C$ has conjugate symmetry.\n\n- Statement II is false. A complex  inner product is linear  in the first argument,  so we have \n\n$$\n⟨-ia,b⟩=-i⟨a,b⟩\\ne i⟨a,b⟩,\n$$\n\nin general.\n\n- Statement III is true. For any $a\\in {C}^{n},$  $⟨a,a⟩$ is a non-negative real number.\n\nTherefore, the correct answer is \"I and III only.\"" 13194139535155 true] [17592186334316 1000 #edb/ref 17592186334317 13194139535155 true] [17592186334316 1000 #edb/ref 17592186334318 13194139535155 true] [17592186334316 1000 #edb/ref 17592186334319 13194139535155 true] [17592186334316 1000 #edb/ref 17592186334320 13194139535155 true] [17592186334316 1000 #edb/ref 17592186334321 13194139535155 true] [17592186334316 1040 #edb/ref 17592186045450 13194139535155 true] [17592186334316 1041 "selection" 13194139535155 true] [17592186334316 1104 #edb/ref 17592186334318 13194139535155 true] [17592186334316 1110 #uuid "16991709-53aa-52e3-b461-bee5e6b8d6bd" 13194139535155 true] [17592186334317 1034 "II and III only" 13194139535155 true] [17592186334317 1103 #edb/ref 17592186045454 13194139535155 true] [17592186334317 1111 #uuid "f4aa4667-1