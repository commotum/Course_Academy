mo stretchy=\"false\">(</mo><mo>\u2212</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">i</mi></mrow><mo stretchy=\"false\">)</mo></mrow><mo accent=\"true\">\u2015</mo></mover><mo fence=\"false\" stretchy=\"false\">\u27e8</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">a</mi></mrow><mo>,</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">a</mi></mrow><mo fence=\"false\" stretchy=\"false\">\u27e9</mo><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">i</mi></mrow><mo fence=\"false\" stretchy=\"false\">\u27e8</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">a</mi></mrow><mo>,</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">a</mi></mrow><mo fence=\"false\" stretchy=\"false\">\u27e9</mo><mo>\u2260</mo><mo>\u2212</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">i</mi></mrow><mo fence=\"false\" stretchy=\"false\">\u27e8</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">a</mi></mrow><mo>,</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">a</mi></mrow><mo fence=\"false\" stretchy=\"false\">\u27e9</mo></math></mjx-assistive-mml></mjx-container> \nfor any nonzero vector  <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"116\" style=\"font-size: 113.1%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D41A TEX-B\"></mjx-c></mjx-mi></mjx-texatom><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2208\"></mjx-c></mjx-mo><mjx-msup space=\"4\"><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-ds mjx-b\"><mjx-c class=\"mjx-c2102 TEX-A\"></mjx-c></mjx-mi></mjx-texatom><mjx-script style=\"vertical-align: 0.363em;\"><mjx-mi class=\"mjx-i\" size=\"s\"><mjx-c class=\"mjx-c1D45B TEX-I\"></mjx-c></mjx-mi></mjx-script></mjx-msup><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml un