3fc53d818fe067378407b0cca1985b020babe9fcffa79cfd32b" "q-182016/field-1/203f88d94a38bb859e78e84aea518cf34952815758cf391887040455367d62ef"] :db/ensure [:answer-field/validate]} {:db/id "q-182016/field-2/22814de28a0b1b4f20d5edd62707d192b78050d457a70349795d30d86dfcd7fa" :answer/id #uuid "7e1c3090-2fec-5d29-984d-0bf9fb667137" :answer/type :answer.type/math :answer/value ">" :db/ensure [:answer/validate]} {:db/id "q-182016/field-2/55f4eef1ef55065220056c9644bf18d21761bc8db2d8f5c41f767a2fc9186b70" :answer/id #uuid "ee56cfac-6fcb-5c2d-a62e-18363d679b32" :answer/type :answer.type/math :answer/value "\\ne " :db/ensure [:answer/validate]} {:db/id "q-182016/field-2/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e" :answer/id #uuid "9e8b35eb-c6e0-5077-b16b-7822d67bdc59" :answer/type :answer.type/math :answer/value "<" :db/ensure [:answer/validate]} {:db/id "q-182016/field-2/cc57b3a2811193b1201e1d8d139011f0b8b63f9cad9aaf57f40ab2b8d40ee2eb" :answer/id #uuid "414a2074-48e8-5e5c-89a1-eb2f7b356a1d" :answer/type :answer.type/math :answer/value "\\ge " :db/ensure [:answer/validate]} {:db/id "q-182016/field-2/7d149b60a8e2a3be02476cb4e4d26616193c2006082edf79693d6816cf527c19" :answer/id #uuid "9b3e7c67-83c4-5478-a1b7-907eae2356d7" :answer/type :answer.type/math :answer/value "\\le " :db/ensure [:answer/validate]} {:db/id "q-182016/field-2" :answer-field/id #uuid "a634d752-80a2-53bf-b41d-83d6262fc1f0" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-182016/field-2/cc57b3a2811193b1201e1d8d139011f0b8b63f9cad9aaf57f40ab2b8d40ee2eb" :answer-field/choices ["q-182016/field-2/22814de28a0b1b4f20d5edd62707d192b78050d457a70349795d30d86dfcd7fa" "q-182016/field-2/55f4eef1ef55065220056c9644bf18d21761bc8db2d8f5c41f767a2fc9186b70" "q-182016/field-2/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e" "q-182016/field-2/cc57b3a2811193b1201e1d8d139011f0b8b63f9cad9aaf57f40ab2b8d40ee2eb" "q-182016/field-2/7d149b60a8e2a3be02476cb4e4d26616193c2006082edf79693d6816cf527c19"] :db/ensure [:answer-field/validate]} {:db/id "q-182016" :question/id #uuid "c3a75647-b6f0-514a-9eb0-d39182f0d5fe" :question/math-academy-id "q-182016" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044982/assets/f54c771d1b7045bbaa301c9d595a45dc64fbdfc6b1c83c152fb6fc892373ea06.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n{(x,y)\\in {{field-1}}\\,:\\,y\\,{{field-2}}\\,-1}\n$$" :question/worked-solution "Since all points $P(x,y)$ in our set lie at integer values of $x$ and $y,$ we have $x\\in Z,y\\in Z,$ and therefore \n\n$$\n(x,y)\\in Z\\times Z={Z}^{2}.\n$$\n\nThe points in our set include all those that lie *above* the line $y=-1.$ For those points, the following condition is satisfied:\n\n$$\ny>-1\n$$\n\nAlso, notice that some points in our set lie *on* the line. We include these points by changing the inequality symbol above as follows:\n\n$$\ny\\ge -1\n$$\n\nTherefore, we can write the set as follows:\n\n$$\n{(x,y)\\in {Z}^{2}\\,:\\,y\\ge -1}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-182016/field-1" "q-182016/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e694b201-5ec6-5cc3-a608-2447d1cc1ed3"] :knowledge-point/questions ["q-182016"] :db/ensure [:knowledge-point/validate]}]
