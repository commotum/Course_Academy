d}9 \\\\ -15\\end{aligned}]\n$$\n\nis the column vector of constants, and\n\n$$\nx=[\\begin{aligned}x \\\\ y\\end{aligned}]\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n[\\begin{aligned}-2 & 1 \\\\ 0 & -5\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}9 \\\\ -15\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186329840 :knowledge-point/_questions [{:knowledge-point/id #uuid "f4f746a1-ea9e-5136-90d6-d4dee1306c17" :knowledge-point/title "Representing a 2x2 System of Equations Using a Matrix Product by Reorganizing"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "809b4ede-4f3f-5d6f-8518-28db8dd342f4" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186329842} {:answer/id #uuid "617b0a48-dace-5e01-ba95-68a70ddb0009" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186329843}] :answer-field/correct {:answer/id #uuid "617b0a48-dace-5e01-ba95-68a70ddb0009" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186329843} :answer-field/id #uuid "c5f552f1-a861-5f61-808b-08f551948fd7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186329841} {:answer-field/choices [{:answer/id #uuid "3cf9b64f-169d-5647-af00-eecc0a224162" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186329845}] :answer-field/correct {:answer/id #uuid "3cf9b64f-169d-5647-af00-eecc0a224162" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186329845} :answer-field/id #uuid "37cee8be-318d-5624-944c-246ae2784a04" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186329844} {:answer-field/choices [{:answer/id #uuid "e9f26fc2-f2ad-50a4-aeec-23bb88f70f02" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186329847}] :answer-field/c