nswer.type/math} :answer/value "-7" :db/id #edb/ref 17592186285606} :answer-field/id #uuid "21b222cb-0f2d-588b-b05d-c5289a4f997b" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186285605}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "bfa79505-f094-536b-8de1-28d863aaf777" :question/math-academy-id "q-317500" :question/problem "For the following system of equations\n\n$$\n\\begin{aligned}{\\begin{aligned}-6y=4 \\\\ 3x+5y\\,=-7\\end{aligned}\\end{aligned}\n$$\n\nits representation using matrices is\n\n| |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- |\n|  | {{field-3}} | $5$ |  | |  |  |  | |  | $x$ |  |\n| --- | --- | --- |\n|  | $y$ |  | | $=$ | |  | $4$ |  |\n| --- | --- | --- |\n|  | {{field-4}} |  | |\n| --- | --- | --- | --- | --- | --- | --- |\n|  | {{field-1}} | {{field-2}} |  |  |  |  |\n|  | {{field-3}} | $5$ |  |  |  |  |\n|  | $x$ |  |  |  |  |  |\n|  | $y$ |  |  |  |  |  |\n|  | $4$ |  |  |  |  |  |\n|  | {{field-4}} |  |  |  |  |  |\n\n." :question/worked-solution "First, let's write the system so that both $x$ and $y$ appear in each equation. \nThe variable $x$ does not appear in the first equation, but this just means its coefficient is $0.$ So, we get\n\n$$\n\\begin{aligned}{\\begin{aligned}0x-6y=4 \\\\ 3x+5y\\,=-7\\end{aligned}\\end{aligned}\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=[\\begin{aligned}0 & -6 \\\\ 3 & 5\\end{aligned}]\n$$\n\nis the coefficient matrix,\n\n$$\nb=[\\begin{aligned}4 \\\\ -7\\end{aligned}]\n$$\n\nis the column vector of constants, and\n\n$$\nx=[\\begin{aligned}x \\\\ y\\end{aligned}]\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n[\\begin{aligned}0 & -6 \\\\ 3 & 5\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}4 \\\\ -7\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186285607 :knowledge-point/_questions [{:knowledge-point/id #uuid "ce2e21aa-f89d-5d10-b815-c66a2b46ef5c" :knowledge-point/title "Representing a 2x2 System of Equations Using a Matrix Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "65eb3fcd-89b6-50d1-8030-8e0e856b8493" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186285609} {:answer/id #uuid "7eb2804d-566e-5894-9673-8e2e5f70f0d8" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186285610}] :answer-field/correct {:answer/id #uuid "65eb3fcd-89b6-50d1-8030-8e0e856b8493" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186285609} :answer-field/id #uuid "9b657339-550d-5381-ae3f-5e005e506ec4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186285608} {:answer-field/choices [{:answer/id #uuid "98c12c81-cbcd-5d39-ac3d-a523d98124ea" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186285612}] :answer-field/correct {:answer/id #uuid "98c12c81-cbcd-5d39-ac3d-a523d98124ea" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186285612} :answer-field/id #uuid "8b9df299-3855-56ba-9143-e274a7d7fb31" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186285611} {:answer-field/choices [{:answer/id #uuid "2dd4d4fa-c097-55f2-9bb3-97cf9ef0b37b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186285614}] :answer-field/correct {:answer/id #uuid "2dd4d4fa-c097-55f2-9bb3-97cf9ef0b37b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186285614} :answer-field/id #uuid "4c1c2edf-0660-5cef-90b2-8f6f60c0eb7f" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186285613} {:answer-field/choices [{:answer/id #uuid "5cbf5118-38a1-5913-9c1f-50e22b2d244c" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186285616}] :answer-field/correct {:answer/id #uuid "5cbf5118-38a1-5913-9c1f-50e22b2d244c" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186285616} :answer-field/id #uuid "f19887aa-a43c-5431-8dde-6e40e1cb03ed" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186285615}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "af3e197c-8649-56f3-9c21-c51a5293b5c1" :question/math-academy-id "q-317506" :question/problem "For the following system of equations\n\n$$\n\\begin{aligned}{\\begin{aligned}-5x=10 \\\\ 4y=-12\\end{aligned}\\end{aligned}\n$$\n\nits representation using matrices is\n\n| |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- |\n|  | {{field-3}} | $4$ |  | |  |  |  | |  | $x$ |  |\n| --- | --- | --- |\n|  | $y$ |  | | $=$ | |  | $10$ |  |\n| --- | --- | --- |\n|  | {{field-4}} |  | |\n| --- | --- | --- | --- | --- | --- | --- |\n|  | {{field-1}} | {{field-2}} |  |  |  |  |\n|  | {{field-3}} | $4$ |  |  |  |  |\n|  | $x$ |  |  |  |  |  |\n|  | $y$ |  |  |  |  |  |\n|  | $10$ |  |  |  |  |  |\n|  | {{field-4}} |  |  |  |  |  |\n\n." :question/worked-solution "First, let's write the system so that both $x$ and $y$ appear in each equation. The variable $y$ does not appear in the first equation, but this just means its coefficient is $0.$ Similarly, the variable $x$ does not appear in the second equation, which means that its coefficient is $0$ too. \n\nSo, we get\n\n$$\n{\\begin{aligned}-5x+0y=10 \\\\ 0x+4y=-12\\end{aligned}\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=[\\begin{aligned}-5 & 0 \\\\ 0 & 4\\end{aligned}]\n$$\n\nis the coefficient matrix,\n\n$$\nb=[\\begin{aligned}10 \\\\ -12\\end{aligned}]\n$$\n\nis the column vector of constants, and\n\n$$\nx=[\\begin{aligned}x \\\\ y\\end{aligned}]\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n[\\begin{aligned}-5 & 0 \\\\ 0 & 4\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}10 \\\\ -12\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186285636 :knowledge-point/_questions [{:knowledge-point/id #uuid "f4f746a1-ea9e-5136-90d6-d4dee1306c17" :knowledge-point/title "Representing a 2x2 System of Equations Using a Matrix Product by Reorganizing"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f9c343a1-d172-5942-8b4a-e0759aa92444" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186285638} {:answer/id #uuid "d4414b12-cf25-570e-a14b-91929451f83b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186329839}] :answer-field/correct {:answer/id #uuid "f9c343a1-d172-5942-8b4a-e0759aa92444" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186285638} :answer-field/id #uuid "e7e45197-bbc4-522c-9bbf-eabdba33f705" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186285637} {:answer-field/choices [{:answer/id #uuid "0e3d4d50-f411-58ef-9647-6592215b18f3" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186285640}] :answer-field/correct {:answer/id #uuid "0e3d4d50-f411-58ef-9647-6592215b18f3" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186285640} :answer-field/id #uuid "31d3dddc-5cdf-5458-b65d-64ce63b5e305" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186285639} {:answer-field/choices [{:answer/id #uuid "25fce9dd-4418-571a-8006-fb53dba401f7" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186285642}] :answer-field/correct {:answer/id #uuid "25fce9dd-4418-571a-8006-fb53dba401f7" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id