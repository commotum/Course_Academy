dabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-317540/field-4/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-317540" :question/id #uuid "37090c7a-4776-5826-957a-cbe6e7e03bab" :question/math-academy-id "q-317540" :question/problem "For the following system of equations\n\n$$\n\\begin{aligned}{\\begin{aligned}4=x \\\\ -7=3+y\\end{aligned}\\end{aligned}\n$$\n\nits representation using matrices is\n\n| |  | $1$ | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} | {{field-3}} |  | |  |  |  | |  | $x$ |  |\n| --- | --- | --- |\n|  | $y$ |  | | $=$ | |  | {{field-4}} |  |\n| --- | --- | --- |\n|  | $-10$ |  | |\n| --- | --- | --- | --- | --- | --- | --- |\n|  | $1$ | {{field-1}} |  |  |  |  |\n|  | {{field-2}} | {{field-3}} |  |  |  |  |\n|  | $x$ |  |  |  |  |  |\n|  | $y$ |  |  |  |  |  |\n|  | {{field-4}} |  |  |  |  |  |\n|  | $-10$ |  |  |  |  |  |\n\n." :question/worked-solution "First, we organize the system so that it’s in the correct order and both $x$ and $y$ appear in each equation:\n\n$$\n\\begin{aligned}{\\begin{aligned}x+0y=4 \\\\ 0x+y=-10\\end{aligned}\\end{aligned}\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]\n$$\n\nis the coefficient matrix,\n\n$$\nb=[\\begin{aligned}4 \\\\ -10\\end{aligned}]\n$$\n\nis the column vector of constants, and\n\n$$\nx=[\\begin{aligned}x \\\\ y\\end{aligned}]\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}4 \\\\ -10\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-317540/field-1" "q-317540/field-2" "q-317540/field-3" "q-317540/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f4f746a1-ea9e-5136-90d6-d4dee1306c17"] :knowledge-point/questions ["q-317540"] :db/ensure [:knowledge-point/validate]} {:db/id "q-317563/field-1/ae5d5851ae23d6baff63037226bccd05263bac385687e95ea64d9a590f3f9a29" :answer/id #uuid "35ed4af9-f1ad-551e-8ca5-9226fc685adf" :answer/type :answer.type/math :answer/value "2x-y" :db/ensure [:answer/validate]} {:db/id "q-317563/field-1" :answer-field/id #uuid "445dd686-95d4-521f-9f83-4d44948006fc" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317563/field-1/ae5d5851ae23d6baff63037226bccd05263bac385687e95ea64d9a590f3f9a29" :answer-field/choices ["q-317563/field-1/ae5d5851ae23d6baff63037226bccd05263bac385687e95ea64d9a590f3f9a29"] :db/ensure [:answer-field/validate]} {:db/id "q-317563/field-2/f02822b53b5f80541b098aee7a5b3cb801293e8687385a424b287ada50425dba" :answer/id #uuid "cd1d4367-60c8-5504-b0cf-505cf1453fe0" :answer/type :answer.type/math :answer/value "x-2y" :db/ensure [:answer/validate]} {:db/id "q-317563/field-2" :answer-field/id #uuid "6cc097c3-0457-5183-97a8-f2f2ccb8ab80" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317563/field-2/f02822b53b5f80541b098aee7a5b3cb801293e8687385a424b287ada50425dba" :answer-field/choices ["q-317563/field-2/f02822b53b5f80541b098aee7a5b3cb801293e8687385a424b287ada50425dba"] :db/ensure [:answer-field/validate]} {:db/id "q-317563" :question/id #uuid "d3f153ac-5333-502d-8f7a-6d527498b0b2" :question/math-academy-id "q-317563" :question/problem "What is the system of equations represented by\n\n$$\n[\\begin{aligned}8 & -4 \\\\ -6 & 12\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}16 \\\\ -18\\end{aligned}]?\n$$\n\nThe corresponding system of equations is\n\n| { | {{field-1}} | $=$ | $\\,4$ |\n| --- | --- | --- | --- |\n| {{field-2}} | $=$ | $\\,\\,3.$ |  |" :question/worked-solution "The $2\\times 2$ matrix encodes the coefficients of $x$ and $y$, and the $2\\times 1$ vector on the right gives the constants, so the system is\n\n$$\n{\\begin{aligned}8x-4y=16 \\\\ -6x+12y=-18\\end{aligned}\n$$\n\nDividing the first equation by $4$ and the second by $-6$ gives the simplified system\n\n$$\n{\\begin{aligned}2x-y=4 \\\\ x-2y=3\\end{aligned}\n$$\n\nwhich matches the entries shown above." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-317563/field-1" "q-317563/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fe2300a1-f31e-5a24-889a-6f45e1e8647b"] :knowledge-point/questions ["q-317563"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71854/selection/1b7fa7161140ce789369bba02850ef292aefd8a231833ade8f15f3b164121aa6" :answer/id #uuid "9c9bbbef-46ca-574d-b4c6-0a2912ac6aba" :answer/type :answer.type/math :answer/value "\\begin{aligned}{\\begin{aligned}y=0 \\\\ -4x+y=5\\end{aligned}\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-71854/selection/352a556990d8150f848481b8fcb3f903cd76d347341c58e31ea9c129b1a89f2d" :answer/id #uuid "b5c4b04d-cd8c-59ce-81d6-4bca3f3dcacd" :answer/type :answer.type/math :answer/value "\\begin{aligned}{\\begin{aligned}y=5 \\\\ x-4y=0\\end{aligned}\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-71854/selection/192ca82343fe1de80b86b8c7708526a15717afed82cbc83a01dd4d07a85e83bd" :answer/id #uuid "f72e51d0-3003-5eb2-bad4-691761ef852e" :answer/type :answer.type/math :answer/value "\\begin{aligned}{\\begin{aligned}y=0 \\\\ x-4y=5\\end{aligned}\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-71854/selection/33b68a76e5c6f2d60c33e2396d88febcc4c9afff81a8dd4d7b3ae3682f4226c4" :answer/id #uuid "6a6d2f86-9a9a-5d92-80c7-152d8d20dab5" :answer/type :answer.type/math :answer/value "\\begin{aligned}{\\begin{aligned}x=0 \\\\ x-4y=5\\end{aligned}\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-71854/selection/ced27208c7d95dff651b55161ad1f994fafefb74809ab2a09cd978ae3df6d1cf" :answer/id #uuid "d0a6a7b2-71e1-5b75-8ace-303392b410b0" :answer/type :answer.type/math :answer/value "\\begin{aligned}{\\begin{aligned}x=0 \\\\ x-3y=5\\end{aligned}\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-71854/selection" :answer-field/id #uuid "9a539e03-7dd8-5ed0-882b-b1111dc9cfab" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71854/selection/192ca82343fe1de80b86b8c7708526a15717afed82cbc83a01dd4d07a85e83bd" :answer-field/choices ["q-71854/selection/1b7fa7161140ce789369bba02850ef292aefd8a231833ade8f15f3b164121aa6" "q-71854/selection/352a556990d8150f848481b8fcb3f903cd76d347341c58e31ea9c129b1a89f2d" "q-71854/selection/192ca82343fe1de80b86b8c7708526a15717afed82cbc83a01dd4d07a85e83bd" "q-71854/selection/33b68a76e5c6f2d60c33e2396d88febcc4c9afff81a8dd4d7b3ae3682f4226c4" "q-71854/selection/ced27208c7d95dff651b55161ad1f994fafefb74809ab2a09cd978ae3df6d1cf"] :db/ensure [:answer-field/validate]} {:db/id "q-71854" :question/id #uuid "7f74fa12-0053-502d-b17f-669ab25e05d2" :question/math-academy-id "q-71854" :question/problem "What is the system of equations represented by\n\n$$\n[\\begin{aligned}0 & -1 \\\\ -3 & 12\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}0 \\\\ -15\\end{aligned}]?\n$$" :question/worked-solution "The  $2\\times 2$ matrix represents the coefficients of $x$ and $y,$ while the $2\\times 1$ column vector on the right-hand side represents the constants of the equations. So, we get the following system of equations:\n\n$$\n\\begin{aligned}{\\begin{aligned}0x-y=0 \\\\ -3x+12y=-15.\\end{aligned}\\end{aligned}\n$$\n\nSimplifying both equations in the system, we get\n\n$$\n\\begin{aligned}{\\begin{aligned}y=0 \\\\ x-4y=5.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-71854/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fe2300a1-f31e-5a24-889a-6f45e1e8647b"] :knowledge-point/questions ["q-71854"] :db/ensure [:knowledge-point/validate]} {:db/id "q-317570/field-1/9990aee4b9ab1ebc688bc860b5f0b838552af83626d1ceb1129