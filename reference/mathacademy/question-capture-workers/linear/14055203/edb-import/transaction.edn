[{:db/id "q-18393/selection/c8095e3f7c6acef33abac598e36ac2546c3bd1f73b2c842bc04be2a864ace785" :answer/id #uuid "d1161222-e7eb-5cf5-974c-fe20e9c2c471" :answer/type :answer.type/math :answer/value "3x-5+\\frac{x+4}{{x}^{2}+x+1}" :db/ensure [:answer/validate]} {:db/id "q-18393/selection/488090d62888bc5d864aeb9bcb1b8e0050374a7e95b4bb8f6b67f10768b6fae0" :answer/id #uuid "d2d8d3c4-d066-5356-a766-5a80e48ee754" :answer/type :answer.type/math :answer/value "3x-5-\\frac{x+4}{{x}^{2}+x+1}" :db/ensure [:answer/validate]} {:db/id "q-18393/selection/cb525f814ded9233c4cab96c7420ca2201a50b55dc41c510b167762d8124a2c4" :answer/id #uuid "679a06e0-dcd2-532c-8d98-d03dbe48ed5e" :answer/type :answer.type/math :answer/value "3x-5+\\frac{{x}^{2}+x+1}{x+4}" :db/ensure [:answer/validate]} {:db/id "q-18393/selection/486ffdca8d1dff73a95bb9decbb3885b73d9f8587f0a050932bc78b19b5b9046" :answer/id #uuid "5646c960-e73a-5ec5-8214-1c3d75d44623" :answer/type :answer.type/math :answer/value "3x-5+\\frac{4}{{x}^{2}+x+1}" :db/ensure [:answer/validate]} {:db/id "q-18393/selection/7cc6c7e5cb6a5aac32618d74464afa320f9a1e5d8ad9cce26cd28fba2da80f0c" :answer/id #uuid "3cf8e602-9a52-598c-a340-97f4494768ca" :answer/type :answer.type/math :answer/value "x+4+\\frac{3x-5}{{x}^{2}+x+1}" :db/ensure [:answer/validate]} {:db/id "q-18393/selection" :answer-field/id #uuid "186bc0be-1b0d-5c04-9003-1869784aa6bb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-18393/selection/c8095e3f7c6acef33abac598e36ac2546c3bd1f73b2c842bc04be2a864ace785" :answer-field/choices ["q-18393/selection/c8095e3f7c6acef33abac598e36ac2546c3bd1f73b2c842bc04be2a864ace785" "q-18393/selection/488090d62888bc5d864aeb9bcb1b8e0050374a7e95b4bb8f6b67f10768b6fae0" "q-18393/selection/cb525f814ded9233c4cab96c7420ca2201a50b55dc41c510b167762d8124a2c4" "q-18393/selection/486ffdca8d1dff73a95bb9decbb3885b73d9f8587f0a050932bc78b19b5b9046" "q-18393/selection/7cc6c7e5cb6a5aac32618d74464afa320f9a1e5d8ad9cce26cd28fba2da80f0c"] :db/ensure [:answer-field/validate]} {:db/id "q-18393" :question/id #uuid "5598d902-472f-55f0-b023-51252e70de60" :question/math-academy-id "q-18393" :question/problem "$\\frac{3{x}^{3}-2{x}^{2}-x-1}{{x}^{2}+x+1}=$" :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,3x-5 \\\\  & {x}^{2}+x+1\\,\\enclose{longdiv}{\\,\\,3{x}^{3}-2{x}^{2}-x-1\\,\\,} \\\\  & \\,\\,\\,\\,\\,{3{x}^{3}+3{x}^{2}+3x}_{―} \\\\  & \\,\\,\\,\\,\\,-5{x}^{2}-4x-1 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,5{x}^{2}-5x-5}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,x+4\\end{aligned}\n$$\n\nAs a result, \n\n- the quotient is $3x-5,$ and\n\n- the remainder is $x+4.$\n\nTherefore,\n\n$$\n\\frac{3{x}^{3}-2{x}^{2}-x-1}{{x}^{2}+x+1}=3x-5+\\frac{x+4}{{x}^{2}+x+1}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-18393/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "da0ca17e-50f3-5f67-bb1c-27868f7b4f45"] :knowledge-point/questions ["q-18393"] :db/ensure [:knowledge-point/validate]} {:db/id "q-321926/field-1/03e1ab37a042dfdad205bf8f2006f84f8fb6ff6ec1ab28c036efe1ea2ffff1e2" :answer/id #uuid "ca823c52-4f3b-5654-a8ed-31d614c68eb3" :answer/type :answer.type/math :answer/value "5x+2" :db/ensure [:answer/validate]} {:db/id "q-321926/field-1/cbd48791e561975472980d68d80b2e58c0c7e36a8a001c41f52c23eaa002f07c" :answer/id #uuid "015be16e-c775-5a1e-999a-91d0e96d5f54" :answer/type :answer.type/math :answer/value "5x-2" :db/ensure [:answer/validate]} {:db/id "q-321926/field-1" :answer-field/id #uuid "76542916-e168-59c9-bf1d-92337d5236c7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-321926/field-1/03e1ab37a042dfdad205bf8f2006f84f8fb6ff6ec1ab28c036efe1ea2ffff1e2" :answer-field/choices ["q-321926/field-1/03e1ab37a042dfdad205bf8f2006f84f8fb6ff6ec1ab28c036efe1ea2ffff1e2" "q-321926/field-1/cbd48791e561975472980d68d80b2e58c0c7e36a8a001c41f52c23eaa002f07c"] :db/ensure [:answer-field/validate]} {:db/id "q-321926" :question/id #uuid "a642d69b-6d5f-57d5-81a7-e7710c89994d" :question/math-academy-id "q-321926" :question/problem "What is the quotient of $15{x}^{3}+{x}^{2}-15x-11$ divided by $3{x}^{2}-x-4?$\n\nThe quotient is\n{{field-1}}." :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,5x+2 \\\\  & 3{x}^{2}-x-4\\,\\enclose{longdiv}{\\,\\,15{x}^{3}+{x}^{2}-15x-11\\,\\,} \\\\  & \\,\\,\\,\\,\\,{15{x}^{3}-5{x}^{2}-20x}_{―} \\\\  & \\,\\,\\,\\,\\,6{x}^{2}+5x-11 \\\\  & \\,\\,\\,\\,\\,{6{x}^{2}-2x-8}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,7x-3\\end{aligned}\n$$\n\nTherefore,\n\n- the quotient is $5x+2,$ and\n\n- the remainder is $7x-3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-321926/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "da0ca17e-50f3-5f67-bb1c-27868f7b4f45"] :knowledge-point/questions ["q-321926"] :db/ensure [:knowledge-point/validate]} {:db/id "q-37991/selection/ebfc0e0786b9e08f32fe2539ae50e791a60b7c4613bb2a0820cefbd3ea742454" :answer/id #uuid "c7a39a6a-de04-5be1-965f-568e187e9c7a" :answer/type :answer.type/math :answer/value "-60" :db/ensure [:answer/validate]} {:db/id "q-37991/selection/dda179d45ca7e4a0613a402c0534e8afa19f93dae661acf79d186d317009e033" :answer/id #uuid "b6ac04bc-59eb-5c21-b1ff-8ab1dc4c9d89" :answer/type :answer.type/math :answer/value "-84" :db/ensure [:answer/validate]} {:db/id "q-37991/selection/842947b00d8ffc5745884eed061ea57d57affe318d15d13be5c3612b41e13326" :answer/id #uuid "d3292cc5-9da9-51f3-8e54-5ddb28513dac" :answer/type :answer.type/math :answer/value "84" :db/ensure [:answer/validate]} {:db/id "q-37991/selection/bdda2450817a39aa33f63c44268d508ac25aa607d31de284a7a3098288a61525" :answer/id #uuid "5b8d9c34-648d-597c-bae5-66a3d878c90e" :answer/type :answer.type/math :answer/value "72" :db/ensure [:answer/validate]} {:db/id "q-37991/selection/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc" :answer/id #uuid "145ef83e-3363-5f65-b49a-bfafe729b54c" :answer/type :answer.type/math :answer/value "60" :db/ensure [:answer/validate]} {:db/id "q-37991/selection" :answer-field/id #uuid "5655b52d-c074-587e-9744-ece4fafd3eee" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-37991/selection/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc" :answer-field/choices ["q-37991/selection/ebfc0e0786b9e08f32fe2539ae50e791a60b7c4613bb2a0820cefbd3ea742454" "q-37991/selection/dda179d45ca7e4a0613a402c0534e8afa19f93dae661acf79d186d317009e033" "q-37991/selection/842947b00d8ffc5745884eed061ea57d57affe318d15d13be5c3612b41e13326" "q-37991/selection/bdda2450817a39aa33f63c44268d508ac25aa607d31de284a7a3098288a61525" "q-37991/selection/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc"] :db/ensure [:answer-field/validate]} {:db/id "q-37991" :question/id #uuid "9907a11a-affc-5dfc-b00d-3eb9c7f514bd" :question/math-academy-id "q-37991" :question/problem "What is the remainder when $3{x}^{3}-12{x}^{2}-87x-12$ is divided by ${x}^{2}-5x-24?$" :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,3x+3 \\\\  & {x}^{2}-5x-24\\,\\enclose{longdiv}{\\,\\,3{x}^{3}-12{x}^{2}-87x-12\\,\\,} \\\\  & \\,\\,\\,\\,\\,{3{x}^{3}-15{x}^{2}-72x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,3{x}^{2}-15x-12 \\\\  & \\,\\,\\,\\,\\,\\,\\,{3{x}^{2}-15x-72}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,60\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is $3x+3,$ and\n\n- the remainder is $60.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-37991/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "da0ca17e-50f3-5f67-bb1c-27868f7b4f45"] :knowledge-point/questions ["q-37991"] :db/ensure [:knowledge-point/validate]} {:db/id "q-322774/field-1/3844ec3bfe459919f0b59d207fdc58674c2c31f8780167bb912cd4342d921d79" :answer/id #uuid "e8604eba-c9e7-5cd2-8ab0-529621f705e7" :answer/type :answer.type/math :answer/value "6x+9" :db/ensure [:answer/validate]} {:db/id "q-322774/field-1/9c923e9fa48625cd512b2199c8dc41d9dd355531b2ac6c29a34fc03a55ee6c13" :answer/id #uuid "94e09203-9d53-5398-b773-9b155580bd53" :answer/type :answer.type/math :answer/value "6x-9" :db/ensure [:answer/validate]} {:db/id "q-322774/field-1" :answer-field/id #uuid "3de2f2fb-4ca4-5b83-b4ae-1b924d5f9434" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-322774/field-1/3844ec3bfe459919f0b59d207fdc58674c2c31f8780167bb912cd4342d921d79" :answer-field/choices ["q-322774/field-1/3844ec3bfe459919f0b59d207fdc58674c2c31f8780167bb912cd4342d921d79" "q-322774/field-1/9c923e9fa48625cd512b2199c8dc41d9dd355531b2ac6c29a34fc03a55ee6c13"] :db/ensure [:answer-field/validate]} {:db/id "q-322774/field-2/6510c6b59f91791cbe4865575e2a85923899c3d50542fd2ce220f656870724ee" :answer/id #uuid "ca0cc602-5387-53ff-99ef-722928f3c23b" :answer/type :answer.type/math :answer/value "-23x+51" :db/ensure [:answer/validate]} {:db/id "q-322774/field-2" :answer-field/id #uuid "5736db50-737b-54c9-bb0f-d6a0565c3dbe" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-322774/field-2/6510c6b59f91791cbe4865575e2a85923899c3d50542fd2ce220f656870724ee" :answer-field/choices ["q-322774/field-2/6510c6b59f91791cbe4865575e2a85923899c3d50542fd2ce220f656870724ee"] :db/ensure [:answer-field/validate]} {:db/id "q-322774" :question/id #uuid "6639b2e5-2f9c-5f64-b3b7-e42552880417" :question/math-academy-id "q-322774" :question/problem "Express $\\frac{12{x}^{3}-20x+96}{2{x}^{2}-3x+5}$ in the form $q(x)+\\frac{r(x)}{2{x}^{2}-3x+5},$ where $q(x)$ is the quotient and $r(x)$ is the reminder of the division.$$\n\n| $12{x}^{3}-20x+96$ | __ | {{field-1}} | $+$ | {{field-2}} |\n| --- | --- | --- | --- | --- |\n| $2{x}^{2}-3x+5$ | __ |  |  | $2{x}^{2}-3x+5$ |" :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,6x+9 \\\\  & 2{x}^{2}-3x+5\\,\\enclose{longdiv}{\\,\\,12{x}^{3}+0{x}^{2}-20x+96\\,\\,} \\\\  & \\,\\,\\,\\,\\,{12{x}^{3}-18{x}^{2}+30x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,18{x}^{2}-50x+96 \\\\  & \\,\\,\\,\\,\\,\\,{\\,\\,18{x}^{2}-27x+45}_{―} \\\\  & \\,\\,\\,\\,\\,\\,-23x+51\\end{aligned}\n$$\n\nAs a result, \n\n- the quotient is $6x+9,$ and\n\n- the remainder is $-23x+51.$\n\nTherefore,\n\n$$\n\\frac{12{x}^{3}-20x+96}{2{x}^{2}-3x+5}=6x+9+\\frac{(-23x+51)}{2{x}^{2}-3x+5}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-322774/field-1" "q-322774/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "da0ca17e-50f3-5f67-bb1c-27868f7b4f45"] :knowledge-point/questions ["q-322774"] :db/ensure [:knowledge-point/validate]} {:db/id "q-321924/field-1/e57606d2765b2e784e334dbc019d70998cbe638de383ce0e5319b1c814113070" :answer/id #uuid "d7e4dae9-357c-5a7a-8c07-4e4d728b24fc" :answer/type :answer.type/math :answer/value "-7x+4" :db/ensure [:answer/validate]} {:db/id "q-321924/field-1" :answer-field/id #uuid "ff24ea83-b142-50bd-ab30-2259c2d1f1d9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-321924/field-1/e57606d2765b2e784e334dbc019d70998cbe638de383ce0e5319b1c814113070" :answer-field/choices ["q-321924/field-1/e57606d2765b2e784e334dbc019d70998cbe638de383ce0e5319b1c814113070"] :db/ensure [:answer-field/validate]} {:db/id "q-321924" :question/id #uuid "8bd5aba9-6feb-5002-9830-cda611964051" :question/math-academy-id "q-321924" :question/problem "What is the quotient of $-14{x}^{3}+43{x}^{2}-50x+17$ divided by $2{x}^{2}-5x+3?$\n\nThe quotient is\n{{field-1}}." :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,-7x+4 \\\\  & 2{x}^{2}-5x+3\\,\\enclose{longdiv}{\\,\\,-14{x}^{3}+43{x}^{2}-50x+17\\,\\,} \\\\  & \\,\\,\\,\\,\\,{\\,\\,-14{x}^{3}+35{x}^{2}-21x}_{―} \\\\  & \\,\\,\\,\\,\\,8{x}^{2}-29x+17 \\\\  & \\,\\,\\,\\,\\,{8{x}^{2}-20x+12}_{―} \\\\  & \\,\\,\\,\\,\\,-9x+5\\end{aligned}\n$$\n\nTherefore,\n\n- the quotient is $-7x+4,$ and\n\n- the remainder is $-9x+5.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-321924/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "da0ca17e-50f3-5f67-bb1c-27868f7b4f45"] :knowledge-point/questions ["q-321924"] :db/ensure [:knowledge-point/validate]} {:db/id "q-325110/field-1/81ee2dde04c1e2728ed7062b2184ab7308c57d5fd103fa1302193616471b20b1" :answer/id #uuid "260ca86e-d6ee-5166-b532-30ab7b337cd3" :answer/type :answer.type/math :answer/value "4x^2-7x+6" :db/ensure [:answer/validate]} {:db/id "q-325110/field-1" :answer-field/id #uuid "23f3b96d-654d-58ae-a4a1-dce5afa851c0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-325110/field-1/81ee2dde04c1e2728ed7062b2184ab7308c57d5fd103fa1302193616471b20b1" :answer-field/choices ["q-325110/field-1/81ee2dde04c1e2728ed7062b2184ab7308c57d5fd103fa1302193616471b20b1"] :db/ensure [:answer-field/validate]} {:db/id "q-325110" :question/id #uuid "bd7f13cd-47bc-5dec-a7a3-614c42102370" :question/math-academy-id "q-325110" :question/problem "What is the remainder of $-6{x}^{4}+7{x}^{3}-8{x}^{2}+6x+2$ divided by $3{x}^{3}-2{x}^{2}+5x-4?$\n\nThe remainder is\n{{field-1}}." :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,-2x+1 \\\\  & 3{x}^{3}-2{x}^{2}+5x-4\\,\\enclose{longdiv}{\\,\\,-6{x}^{4}+7{x}^{3}-8{x}^{2}+6x+2\\,\\,} \\\\  & \\,\\,\\,\\,{\\,\\,-\\,6{x}^{4}+4{x}^{3}-10{x}^{2}+8x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,3{x}^{3}+2{x}^{2}-\\,2x+2 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,{3{x}^{3}-2{x}^{2}+5x-4}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,4{x}^{2}-7x+6\\end{aligned}\n$$\n\nTherefore,\n\n- the quotient is $-2x+1,$ and\n\n- the remainder is $4{x}^{2}-7x+6.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-325110/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "76a7314b-4ebf-52eb-b464-97865ea9a81e"] :knowledge-point/questions ["q-325110"] :db/ensure [:knowledge-point/validate]} {:db/id "q-322923/field-1/de8aa49a4ae36a3cc981dc04e2a700692af392f8d4290e714a057189efe1b0d3" :answer/id #uuid "6100a870-73bf-525a-959d-652a870cc2ea" :answer/type :answer.type/math :answer/value "4x^2-5x+2" :db/ensure [:answer/validate]} {:db/id "q-322923/field-1/997613562538959724a9e5e91a12b47f986f5b770316a96e11d2e755e7ab8a33" :answer/id #uuid "c18b56c9-296e-5546-b56f-4bfa97bf0049" :answer/type :answer.type/math :answer/value "4x^2-5x-2" :db/ensure [:answer/validate]} {:db/id "q-322923/field-1" :answer-field/id #uuid "ea4a5890-829e-53f0-b0c5-5e787e761837" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-322923/field-1/de8aa49a4ae36a3cc981dc04e2a700692af392f8d4290e714a057189efe1b0d3" :answer-field/choices ["q-322923/field-1/de8aa49a4ae36a3cc981dc04e2a700692af392f8d4290e714a057189efe1b0d3" "q-322923/field-1/997613562538959724a9e5e91a12b47f986f5b770316a96e11d2e755e7ab8a33"] :db/ensure [:answer-field/validate]} {:db/id "q-322923" :question/id #uuid "603bbcf2-00d2-57ce-a208-a04a96f6fb13" :question/math-academy-id "q-322923" :question/problem "What is the quotient of $-4{x}^{4}+21{x}^{3}-10{x}^{2}+7$ divided by $-{x}^{2}+4x+3?$\n\nThe quotient is\n{{field-1}}." :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,4{x}^{2}-5x+2 \\\\  & -{x}^{2}+4x+3\\,\\enclose{longdiv}{\\,\\,-4{x}^{4}+21{x}^{3}-10{x}^{2}+0x+7\\,\\,} \\\\  & \\,\\,\\,\\,{\\,\\,-\\,4{x}^{4}+16{x}^{3}+12{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,5{x}^{3}-22{x}^{2}+0x+7 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,{5{x}^{3}-20{x}^{2}-15x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,-2{x}^{2}+15x+7 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,{-2{x}^{2}+8x+6}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,7x+1\\end{aligned}\n$$\n\nTherefore,\n\n- the quotient is $4{x}^{2}-5x+2,$ and\n\n- the remainder is $7x+1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-322923/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "76a7314b-4ebf-52eb-b464-97865ea9a81e"] :knowledge-point/questions ["q-322923"] :db/ensure [:knowledge-point/validate]} {:db/id "q-325105/field-1/08f746154b01ac6615b1f26b0001522682d8ba1c5875ecf75a8ea3e2db20790e" :answer/id #uuid "a323dcc2-c3ec-5196-8a68-e4e0e40ddae5" :answer/type :answer.type/math :answer/value "-3x+4" :db/ensure [:answer/validate]} {:db/id "q-325105/field-1" :answer-field/id #uuid "68243a8b-708c-54d7-89e8-3ece8a75a497" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-325105/field-1/08f746154b01ac6615b1f26b0001522682d8ba1c5875ecf75a8ea3e2db20790e" :answer-field/choices ["q-325105/field-1/08f746154b01ac6615b1f26b0001522682d8ba1c5875ecf75a8ea3e2db20790e"] :db/ensure [:answer-field/validate]} {:db/id "q-325105" :question/id #uuid "3db9780f-57d6-50f1-9000-5ef74dd794d3" :question/math-academy-id "q-325105" :question/problem "What is the quotient of $-6{x}^{4}+11{x}^{3}-8{x}^{2}+20x-18$ divided by $2{x}^{3}-{x}^{2}+3x-5?$\n\nThe quotient is\n{{field-1}}." :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,-3x+4 \\\\  & 2{x}^{3}-{x}^{2}+3x-5\\,\\enclose{longdiv}{\\,\\,-6{x}^{4}+11{x}^{3}-8{x}^{2}+20x-18\\,\\,} \\\\  & \\,\\,\\,\\,{\\,\\,-\\,6{x}^{4}+3{x}^{3}-9{x}^{2}+15x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,8{x}^{3}+{x}^{2}+5x-18 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,{8{x}^{3}-4{x}^{2}+12x-20}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,5{x}^{2}-7x+2\\end{aligned}\n$$\n\nTherefore,\n\n- the quotient is $-3x+4,$ and\n\n- the remainder is $5{x}^{2}-7x+2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-325105/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "76a7314b-4ebf-52eb-b464-97865ea9a81e"] :knowledge-point/questions ["q-325105"] :db/ensure [:knowledge-point/validate]} {:db/id "q-105622/selection/1e39845fbadf9f18e7505d3ad06336078facc776fb0405f94db064e537e07b2e" :answer/id #uuid "38ba2d25-8228-52af-80a2-a9bcf07df3ff" :answer/type :answer.type/math :answer/value "{x}^{2}+x-2+\\frac{2}{{x}^{2}+2x-1}" :db/ensure [:answer/validate]} {:db/id "q-105622/selection/73086c72e2ca292bba9c4c4ef6cac122e1ffeaac3131048235a9f512d83f374c" :answer/id #uuid "a7405a4d-5361-55f2-a9aa-d7c0e851a45d" :answer/type :answer.type/math :answer/value "{x}^{2}+x-1+\\frac{6}{{x}^{2}+2x-1}" :db/ensure [:answer/validate]} {:db/id "q-105622/selection/4892bd8f02fc1ba9d7a1e5fa96947ccd6b43bf362c232eb7ca430d82ecf61007" :answer/id #uuid "1add4e1f-b959-5a70-b23a-aef9835c4a85" :answer/type :answer.type/math :answer/value "{x}^{2}-2+\\frac{x+2}{{x}^{2}+2x-1}" :db/ensure [:answer/validate]} {:db/id "q-105622/selection/24fe7056674c2bb5908ed8064322c0ab0181a093b0bf0d924e3d5d39a8666ce1" :answer/id #uuid "e893dfd1-71fd-55cd-87c3-78bf1fe1359e" :answer/type :answer.type/math :answer/value "{x}^{2}+2x-1+\\frac{4}{{x}^{2}+2x-1}" :db/ensure [:answer/validate]} {:db/id "q-105622/selection/011028afde74d2f231757f84adb54866cbfacc83b28b8171fa40cea5e38dcb05" :answer/id #uuid "fddc2450-9a62-5050-90cb-ef492b8bb913" :answer/type :answer.type/math :answer/value "{x}^{2}+x+1+\\frac{5}{{x}^{2}+2x-1}" :db/ensure [:answer/validate]} {:db/id "q-105622/selection" :answer-field/id #uuid "4f658c14-23c6-5a76-ba10-b5d102290b97" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-105622/selection/1e39845fbadf9f18e7505d3ad06336078facc776fb0405f94db064e537e07b2e" :answer-field/choices ["q-105622/selection/1e39845fbadf9f18e7505d3ad06336078facc776fb0405f94db064e537e07b2e" "q-105622/selection/73086c72e2ca292bba9c4c4ef6cac122e1ffeaac3131048235a9f512d83f374c" "q-105622/selection/4892bd8f02fc1ba9d7a1e5fa96947ccd6b43bf362c232eb7ca430d82ecf61007" "q-105622/selection/24fe7056674c2bb5908ed8064322c0ab0181a093b0bf0d924e3d5d39a8666ce1" "q-105622/selection/011028afde74d2f231757f84adb54866cbfacc83b28b8171fa40cea5e38dcb05"] :db/ensure [:answer-field/validate]} {:db/id "q-105622" :question/id #uuid "ec17f389-fe0a-5d1c-9e7c-be90d254ed08" :question/math-academy-id "q-105622" :question/problem "$\\frac{{x}^{4}+3{x}^{3}-{x}^{2}-5x+4}{{x}^{2}+2x-1}=$" :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,{x}^{2}+x-2 \\\\  & {x}^{2}+2x-1\\,\\enclose{longdiv}{\\,\\,{x}^{4}+3{x}^{3}-{x}^{2}-5x+4\\,\\,} \\\\  & \\,\\,\\,\\,\\,{{x}^{4}+2{x}^{3}-{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,{x}^{3}+0{x}^{2}-5x+4 \\\\  & \\,\\,\\,\\,\\,\\,\\,{{x}^{3}+2{x}^{2}-x}_{―} \\\\  & \\,\\,\\,\\,\\,-2{x}^{2}-4x+4 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,2{x}^{2}-4x+2}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,2\\end{aligned}\n$$\n\nAs a result,\n\n- the quotient is ${x}^{2}+x-2,$ and\n\n- the remainder is $2.$\n\nTherefore, \n\n$$\n\\frac{{x}^{4}+3{x}^{3}-{x}^{2}-5x+4}{{x}^{2}+2x-1}={x}^{2}+x-2+\\frac{2}{{x}^{2}+2x-1}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-105622/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "76a7314b-4ebf-52eb-b464-97865ea9a81e"] :knowledge-point/questions ["q-105622"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-104257"] :question/problem "$\\frac{8{x}^{4}-4{x}^{3}+6{x}^{2}+4x-3}{2{x}^{2}-x+2}=$" :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,4{x}^{2}-1 \\\\  & 2{x}^{2}-x+2\\,\\enclose{longdiv}{\\,\\,8{x}^{4}-4{x}^{3}+6{x}^{2}+4x-3\\,\\,} \\\\  & \\,\\,\\,\\,\\,{8{x}^{4}-4{x}^{3}+8{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,-2{x}^{2}+4x-3 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,2{x}^{2}+x-2}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,3x-1\\end{aligned}\n$$\n\nAs a result,\n\n- the quotient is $4{x}^{2}-1,$ and\n\n- the remainder is $3x-1.$\n\nTherefore, \n\n$$\n\\frac{8{x}^{4}-4{x}^{3}+6{x}^{2}+4x-3}{2{x}^{2}-x+2}=4{x}^{2}-1+\\frac{3x-1}{2{x}^{2}-x+2}.\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-38003/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer/id #uuid "5a3b4c42-1cfd-5e3d-bab7-5b447d8f5354" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "q-38003/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "1ad92541-af3a-5c64-8c6a-69fe5adbc8df" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-38003/selection/b306ad6a3af7dc043f4c3e03da26a15440a9e9b19389783b2e1203bad6e37573" :answer/id #uuid "a7239516-ef5a-58d6-bc7e-f6fb934d556d" :answer/type :answer.type/math :answer/value "x" :db/ensure [:answer/validate]} {:db/id "q-38003/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "56fdb2e3-9634-5563-ae77-5d5ff843abb7" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-38003/selection/3209ee05377c5d99394373ec27feb9f6b35a34c68590478cf5887964aa5b403c" :answer/id #uuid "90ddf537-7a5c-5d1d-b515-24960ed15c57" :answer/type :answer.type/math :answer/value "x-2" :db/ensure [:answer/validate]} {:db/id "q-38003/selection" :answer-field/id #uuid "2bcac19f-404e-5a68-be97-0d90b08226a1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-38003/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-38003/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" "q-38003/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-38003/selection/b306ad6a3af7dc043f4c3e03da26a15440a9e9b19389783b2e1203bad6e37573" "q-38003/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-38003/selection/3209ee05377c5d99394373ec27feb9f6b35a34c68590478cf5887964aa5b403c"] :db/ensure [:answer-field/validate]} {:db/id "q-38003" :question/id #uuid "973cec65-f671-5ca7-8673-e8f86cf60cef" :question/math-academy-id "q-38003" :question/problem "What is the remainder when  $27{x}^{3}+8$ is divided by $9{x}^{2}-6x+4?$" :question/worked-solution "Notice that the dividend is missing the ${x}^{2}$ and $x$ terms. So, we first rewrite it by including the missing terms with zero coefficients, as follows:\n\n$$\n27{x}^{3}+8=27{x}^{3}+0{x}^{2}+0x+8\n$$\n\nNow, using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,3x+2 \\\\  & 9{x}^{2}-6x+4\\,\\enclose{longdiv}{\\,\\,27{x}^{3}+0{x}^{2}+0x+8\\,\\,} \\\\  & \\,\\,\\,\\,\\,{27{x}^{3}-18{x}^{2}+12x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,18{x}^{2}-12x+8 \\\\  & \\,\\,\\,\\,\\,\\,\\,{18{x}^{2}-12x+8}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,0\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is $3x+2,$ and\n\n- the remainder is $0.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-38003/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "525be9c7-af11-506b-be69-444dfc640add"] :knowledge-point/questions ["q-38003"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114512/selection/2ab1b1fa4742e93494e9e627ed3015a60d0bf278c79a693639f4ffe9523586e9" :answer/id #uuid "ec912811-c290-50ff-bb92-3d56aee8f564" :answer/type :answer.type/math :answer/value "{x}^{2}-1" :db/ensure [:answer/validate]} {:db/id "q-114512/selection/d532a50f4c57fb6d117bff6111ef35d5aa5defc2916ef9202a1f5f2d5b783232" :answer/id #uuid "55d214f5-8fa1-592e-bbea-127adc75323a" :answer/type :answer.type/math :answer/value "{x}^{2}+1" :db/ensure [:answer/validate]} {:db/id "q-114512/selection/7285ba1537fc9731227094af0325a8f441749e53139fbec738d9fc8c3f4d46e2" :answer/id #uuid "a5fa8784-6b38-56a8-a34e-5e6834948b4d" :answer/type :answer.type/math :answer/value "{x}^{2}-x-2" :db/ensure [:answer/validate]} {:db/id "q-114512/selection/adc4af53d25a0173d3b8438f642a80465a7413e931bac2f4b934de230ed6eafd" :answer/id #uuid "e0de7a64-b320-5e13-a52f-1d198e9bc04b" :answer/type :answer.type/math :answer/value "{x}^{2}-3x+2" :db/ensure [:answer/validate]} {:db/id "q-114512/selection/908537192d1578232cf62f4604c7da927dc713b4f3aa1e857cabf58a35366f8d" :answer/id #uuid "f66959d4-9e6b-52a8-b0d4-cf1db76299fe" :answer/type :answer.type/math :answer/value "{x}^{2}-2x+1" :db/ensure [:answer/validate]} {:db/id "q-114512/selection" :answer-field/id #uuid "98b9dfc4-17af-5db0-a6d4-6e21bc8bc6b7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114512/selection/2ab1b1fa4742e93494e9e627ed3015a60d0bf278c79a693639f4ffe9523586e9" :answer-field/choices ["q-114512/selection/2ab1b1fa4742e93494e9e627ed3015a60d0bf278c79a693639f4ffe9523586e9" "q-114512/selection/d532a50f4c57fb6d117bff6111ef35d5aa5defc2916ef9202a1f5f2d5b783232" "q-114512/selection/7285ba1537fc9731227094af0325a8f441749e53139fbec738d9fc8c3f4d46e2" "q-114512/selection/adc4af53d25a0173d3b8438f642a80465a7413e931bac2f4b934de230ed6eafd" "q-114512/selection/908537192d1578232cf62f4604c7da927dc713b4f3aa1e857cabf58a35366f8d"] :db/ensure [:answer-field/validate]} {:db/id "q-114512" :question/id #uuid "b35b2265-3e78-513b-9a0a-cb0d61ba91a0" :question/math-academy-id "q-114512" :question/problem "What is the quotient of $2{x}^{4}-{x}^{2}-1$ divided by $2{x}^{2}+1?$" :question/worked-solution "Notice that the dividend is missing the ${x}^{3}$ and $x$ terms. So, we first rewrite it by including the missing terms with zero coefficients, as follows:\n\n$$\n2{x}^{4}-{x}^{2}-1=2{x}^{4}+0{x}^{3}-{x}^{2}+0x-1\n$$\n\nNow, using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,{x}^{2}-1 \\\\  & 2{x}^{2}+1\\,\\enclose{longdiv}{\\,\\,2{x}^{4}+0{x}^{3}-{x}^{2}+0x-1\\,\\,} \\\\  & \\,\\,\\,\\,\\,{2{x}^{4}+0{x}^{3}+{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,-\\,2{x}^{2}+0x-1 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,\\,2{x}^{2}+0x-1}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,0\\end{aligned}\n$$\n\n \n\nTherefore, \n\n- the quotient is ${x}^{2}-1,$ and\n\n- the remainder is $0.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-114512/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "525be9c7-af11-506b-be69-444dfc640add"] :knowledge-point/questions ["q-114512"] :db/ensure [:knowledge-point/validate]} {:db/id "q-3824/selection/a5cfc473b620ae5c123c09dcaa728fbaaee259b3e4e1b09c71a03b9f84e7aa11" :answer/id #uuid "a406be51-bc25-5877-aa21-4a75ac2429e1" :answer/type :answer.type/math :answer/value "x-1" :db/ensure [:answer/validate]} {:db/id "q-3824/selection/c9f06eb93c12462eeb0661b4b4c23f10543fb29430e2756765918cfea2be9a53" :answer/id #uuid "999217be-4a56-5e1a-9f2e-ff65ee21c06c" :answer/type :answer.type/math :answer/value "2x+1" :db/ensure [:answer/validate]} {:db/id "q-3824/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "c3c2068f-becf-559b-93be-bbf555fcb6bc" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-3824/selection/f6bb8b03f5ac2b19dd8d23f3cce5d7b820c7b39bf4a0f1a3677016d0804b1bf3" :answer/id #uuid "b84ed13f-9c8f-5b05-b8fb-6301a95467cd" :answer/type :answer.type/math :answer/value "{x}^{2}-x" :db/ensure [:answer/validate]} {:db/id "q-3824/selection/2520708bdf0e9bba062c343966483d6497c1caa71ee45720bd2dabebb42b4a86" :answer/id #uuid "867d9c7b-8ec6-5a46-a9d5-126820556a2f" :answer/type :answer.type/math :answer/value "-x+3" :db/ensure [:answer/validate]} {:db/id "q-3824/selection" :answer-field/id #uuid "10a5bfbf-75ee-5817-a38b-7a47a7ca813d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-3824/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-3824/selection/a5cfc473b620ae5c123c09dcaa728fbaaee259b3e4e1b09c71a03b9f84e7aa11" "q-3824/selection/c9f06eb93c12462eeb0661b4b4c23f10543fb29430e2756765918cfea2be9a53" "q-3824/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-3824/selection/f6bb8b03f5ac2b19dd8d23f3cce5d7b820c7b39bf4a0f1a3677016d0804b1bf3" "q-3824/selection/2520708bdf0e9bba062c343966483d6497c1caa71ee45720bd2dabebb42b4a86"] :db/ensure [:answer-field/validate]} {:db/id "q-3824" :question/id #uuid "1bd48b4c-2d27-52a8-b035-0f7f4c3730a1" :question/math-academy-id "q-3824" :question/problem "What is the remainder when ${x}^{4}+{x}^{2}+2$ is divided by ${x}^{2}+x+1?$" :question/worked-solution "Notice that the dividend is missing the ${x}^{3}$ and $x$ terms. So, we first rewrite it by including the missing terms with zero coefficients, as follows:\n\n$$\n{x}^{4}+{x}^{2}+2={x}^{4}+0{x}^{3}+{x}^{2}+0x+2\n$$\n\nNow, using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,{x}^{2}-x+1 \\\\  & {x}^{2}+x+1\\,\\enclose{longdiv}{\\,\\,{x}^{4}+0{x}^{3}+{x}^{2}+0x+2\\,\\,} \\\\  & \\,\\,\\,\\,\\,{{x}^{4}+{x}^{3}+{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,-{x}^{3}+0{x}^{2}+0x+2 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,{x}^{3}-{x}^{2}-x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,{x}^{2}+x+2 \\\\  & \\,\\,\\,\\,\\,\\,\\,{{x}^{2}+x+1}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,1\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is ${x}^{2}-x+1,$ and\n\n- the remainder is $1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-3824/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "525be9c7-af11-506b-be69-444dfc640add"] :knowledge-point/questions ["q-3824"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114522/selection/384d4e5a0fdb95d1fc5b15156d9c7fc1f16cc20c35aac0d4d52422ce28900e57" :answer/id #uuid "43d3a55f-463a-50e5-b71e-5a8561a53554" :answer/type :answer.type/math :answer/value "-3x+2" :db/ensure [:answer/validate]} {:db/id "q-114522/selection/c9f06eb93c12462eeb0661b4b4c23f10543fb29430e2756765918cfea2be9a53" :answer/id #uuid "5151de13-cb36-572e-b53c-6b3e0396b7a5" :answer/type :answer.type/math :answer/value "2x+1" :db/ensure [:answer/validate]} {:db/id "q-114522/selection/412793739940b973be2b527fb17aec02d6ca6345201ec8cd477bb75bb5283b50" :answer/id #uuid "95632635-98a1-5241-ad5b-47271bbbc064" :answer/type :answer.type/math :answer/value "-2x" :db/ensure [:answer/validate]} {:db/id "q-114522/selection/1d8e4d4ca05809b4ff03e4ab5c8a87e8ac0dbc724f449ca6244d0db5e7d4cddb" :answer/id #uuid "ab54d812-f362-545b-9c0d-4c9d6ea8c230" :answer/type :answer.type/math :answer/value "5x" :db/ensure [:answer/validate]} {:db/id "q-114522/selection/bac17e0c58ed4227750c9a6b47f887030df94384933725b71cefcb0fc9ed6fe3" :answer/id #uuid "31073140-1dbd-5c6b-a70d-d422984ebb4e" :answer/type :answer.type/math :answer/value "-4x-1" :db/ensure [:answer/validate]} {:db/id "q-114522/selection" :answer-field/id #uuid "10e05e8c-1a40-566f-89e2-6c3ed14375e4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114522/selection/412793739940b973be2b527fb17aec02d6ca6345201ec8cd477bb75bb5283b50" :answer-field/choices ["q-114522/selection/384d4e5a0fdb95d1fc5b15156d9c7fc1f16cc20c35aac0d4d52422ce28900e57" "q-114522/selection/c9f06eb93c12462eeb0661b4b4c23f10543fb29430e2756765918cfea2be9a53" "q-114522/selection/412793739940b973be2b527fb17aec02d6ca6345201ec8cd477bb75bb5283b50" "q-114522/selection/1d8e4d4ca05809b4ff03e4ab5c8a87e8ac0dbc724f449ca6244d0db5e7d4cddb" "q-114522/selection/bac17e0c58ed4227750c9a6b47f887030df94384933725b71cefcb0fc9ed6fe3"] :db/ensure [:answer-field/validate]} {:db/id "q-114522" :question/id #uuid "527cf6c2-7424-50b4-a68b-208230d426df" :question/math-academy-id "q-114522" :question/problem "What is the remainder when ${x}^{4}+2{x}^{3}-1$ is divided by ${x}^{2}+1?$" :question/worked-solution "Notice that the dividend is missing the ${x}^{2}$ and $x$ terms. So, we first rewrite it by including the missing terms with a coefficient of zero, as follows:\n\n$$\n{x}^{4}+2{x}^{3}-1={x}^{4}+2{x}^{3}+0{x}^{2}+0x-1\n$$\n\nNow, using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,{x}^{2}+2x-1 \\\\  & {x}^{2}+1\\,\\enclose{longdiv}{\\,\\,{x}^{4}+2{x}^{3}+0{x}^{2}+0x-1\\,\\,\\,\\,} \\\\  & \\,\\,\\,\\,\\,{{x}^{4}+0{x}^{3}+{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,2{x}^{3}-{x}^{2}+0x-1 \\\\  & \\,\\,\\,\\,\\,\\,\\,{2{x}^{3}+0{x}^{2}+2x}_{―} \\\\  & \\,\\,\\,\\,-{x}^{2}-2x-1 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,{-{x}^{2}+0x-1}_{―} \\\\  & \\,\\,\\,-2x\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is ${x}^{2}+2x-1,$ and\n\n- the remainder is $-2x.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-114522/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "525be9c7-af11-506b-be69-444dfc640add"] :knowledge-point/questions ["q-114522"] :db/ensure [:knowledge-point/validate]} {:db/id "q-325149/field-1/1e397f1d2e5be4a474fc36ceb34d517a2d65ad520dc4f63b7638ac3c6c820608" :answer/id #uuid "d3bcdafc-b838-5679-9a40-814cda19cdaf" :answer/type :answer.type/math :answer/value "4x^2+4x-1" :db/ensure [:answer/validate]} {:db/id "q-325149/field-1" :answer-field/id #uuid "d952cb6a-939e-5275-a055-86c35c4e40b1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-325149/field-1/1e397f1d2e5be4a474fc36ceb34d517a2d65ad520dc4f63b7638ac3c6c820608" :answer-field/choices ["q-325149/field-1/1e397f1d2e5be4a474fc36ceb34d517a2d65ad520dc4f63b7638ac3c6c820608"] :db/ensure [:answer-field/validate]} {:db/id "q-325149/field-2/106c84a5049875ff5042decf79bd347ffcb2a705a21558449176984acb5c411f" :answer/id #uuid "b2418049-00f0-5ffc-aa7f-d0c68aab0a46" :answer/type :answer.type/math :answer/value "-9x+5" :db/ensure [:answer/validate]} {:db/id "q-325149/field-2" :answer-field/id #uuid "4c5c2f84-8562-5883-b69b-f44f19a39ad8" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-325149/field-2/106c84a5049875ff5042decf79bd347ffcb2a705a21558449176984acb5c411f" :answer-field/choices ["q-325149/field-2/106c84a5049875ff5042decf79bd347ffcb2a705a21558449176984acb5c411f"] :db/ensure [:answer-field/validate]} {:db/id "q-325149" :question/id #uuid "28c5deff-2f33-56f1-a844-dfb7bfe0bd0e" :question/math-academy-id "q-325149" :question/problem "Express $\\frac{4{x}^{4}+3{x}^{2}+3}{\\,{x}^{2}-x+2\\,}$ in the form $q(x)+\\frac{r(x)}{\\,{x}^{2}-x+2\\,},$ where $q(x)$ is the quotient and $r(x)$ is the reminder of the division.$$\n\n| $4{x}^{4}+3{x}^{2}+3$ | __ | {{field-1}} | $+$ | {{field-2}} |\n| --- | --- | --- | --- | --- |\n| ${x}^{2}-x+2$ | __ |  |  | ${x}^{2}-x+2$ |" :question/worked-solution "Notice that the dividend is missing the ${x}^{3}$ and $x$ terms. So, we first rewrite it by including the missing terms with zero coefficients, as follows:\n\n$$\n4{x}^{4}+3{x}^{2}+3\\,=\\,4{x}^{4}+0{x}^{3}+3{x}^{2}+0x+3\n$$\n\nNow, using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,4{x}^{2}+4x-1 \\\\  & {x}^{2}-x+2\\,\\enclose{longdiv}{\\,\\,4{x}^{4}+0{x}^{3}+3{x}^{2}+0x+3\\,\\,} \\\\  & \\,\\,\\,\\,\\,{4{x}^{4}-4{x}^{3}+8{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,4{x}^{3}-5{x}^{2}+0x+3 \\\\  & \\,\\,\\,\\,\\,\\,\\,{4{x}^{3}-4{x}^{2}+8x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,-\\,{x}^{2}-8x+3 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,{x}^{2}+x-2}_{―} \\\\  & \\,\\,\\,\\,\\,\\,-\\,9x+5\\end{aligned}\n$$\n\nAs a result, \n\n- the quotient is $4{x}^{2}+4x-1,$ and\n\n- the remainder is $-9x+5.$\n\nTherefore,\n\n$$\n\\frac{4{x}^{4}+3{x}^{2}+3}{\\,{x}^{2}-x+2\\,}=\\,4{x}^{2}+4x-1\\,+\\frac{\\,(-9x+5)\\,}{\\,{x}^{2}-x+2\\,}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-325149/field-1" "q-325149/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "525be9c7-af11-506b-be69-444dfc640add"] :knowledge-point/questions ["q-325149"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-5143"] :question/problem "Determine the quotient and remainder of $6x^3-x^2+3x+1$ divided by $3x^2+x+2.$" :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,2x-1 \\\\  & 3{x}^{2}+x+2\\,\\enclose{longdiv}{\\,\\,6{x}^{3}-{x}^{2}+3x+1\\,\\,} \\\\  & \\,\\,\\,\\,\\,{6{x}^{3}+2{x}^{2}+4x}_{―} \\\\  & \\,\\,\\,\\,\\,-3{x}^{2}-x+1 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,3{x}^{2}-x-2}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,3\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is ${\\color{blue}2x-1},$ and\n\n- the remainder is ${\\color{red}3}.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8932"] :question/problem "Find the quotient and remainder of the following division problem:\n\n$$\n\\dfrac {5x^4- 2x^3 - 18x^2 + 11x - 13} {5x^2-2x+2}\n$$" :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,{x}^{2}-4 \\\\  & 5{x}^{2}-2x+2\\,\\enclose{longdiv}{\\,\\,5{x}^{4}-2{x}^{3}-18{x}^{2}+11x-13\\,\\,} \\\\  & \\,\\,\\,\\,\\,{5{x}^{4}-2{x}^{3}+2{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,-20{x}^{2}+11x-13 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,20{x}^{2}+8x-8}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,3x-5\\end{aligned}\n$$\n\nAs a result,\n\n- the quotient is $x^2-4,$ and\n\n- the remainder is $3x-5.$\n\nTherefore, \n\n$$\n\\dfrac{5x^4-2x^3-18x^2+11x-13}{5x^2-2x+2}=x^2-4 + \\dfrac{3x-5}{5x^2-2x+2}.\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5144"] :question/problem "Find the quotient and remainder of the following division problem:\n\n$$\n\\dfrac{2x^4 - 7x^2 - x + 8}{x^2 - 1}\n$$" :question/worked-solution "Notice that the dividend is missing the $x^3$ term. So, we first rewrite it by including the missing term with a coefficient of zero, as follows:\n\n$$\n2x^4-7x^2-x+8 = 2x^4+{\\color{red}0}x^3-7x^2-x+8\n$$\n\nNow, using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,2{x}^{2}-5 \\\\  & {x}^{2}-1\\,\\enclose{longdiv}{\\,\\,2{x}^{4}+0{x}^{3}-7{x}^{2}-x+8\\,\\,} \\\\  & \\,\\,\\,\\,\\,{2{x}^{4}+0{x}^{3}-2{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,-5{x}^{2}-x+8 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,5{x}^{2}+0x+5}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,-x+3\\end{aligned}\n$$\n\nAs a result, \n\n- the quotient is ${2x^2 - 5},$ and\n\n- the remainder is ${-x+3}.$\n\nTherefore,\n\n$$\n\\dfrac{2x^4 - 7x^2 - x +8}{x^2 - 1} \n= \n2x^2-5 + \\dfrac{-x+3}{x^2-1}.\n$$\n\nWe can rewrite this result as follows:\n\n$$\n\\dfrac{2x^4 - 7x^2 - x +8}{x^2 - 1} \n= \n2x^2-5 - \\dfrac{x-3}{x^2-1}\n$$" :db/ensure [:question/validate]}]
