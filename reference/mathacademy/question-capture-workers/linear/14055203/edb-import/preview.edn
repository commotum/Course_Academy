2}-x-1\\,\\,} \\\\  & \\,\\,\\,\\,\\,{3{x}^{3}+3{x}^{2}+3x}_{―} \\\\  & \\,\\,\\,\\,\\,-5{x}^{2}-4x-1 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,5{x}^{2}-5x-5}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,x+4\\end{aligned}\n$$\n\nAs a result, \n\n- the quotient is $3x-5,$ and\n\n- the remainder is $x+4.$\n\nTherefore,\n\n$$\n\\frac{3{x}^{3}-2{x}^{2}-x-1}{{x}^{2}+x+1}=3x-5+\\frac{x+4}{{x}^{2}+x+1}\n$$" 13194139535124 true] [17592186332384 1000 #edb/ref 17592186332385 13194139535124 true] [17592186332384 1000 #edb/ref 17592186332386 13194139535124 true] [17592186332384 1000 #edb/ref 17592186332387 13194139535124 true] [17592186332384 1000 #edb/ref 17592186332388 13194139535124 true] [17592186332384 1000 #edb/ref 17592186332389 13194139535124 true] [17592186332384 1040 #edb/ref 17592186045450 13194139535124 true] [17592186332384 1041 "selection" 13194139535124 true] [17592186332384 1104 #edb/ref 17592186332388 13194139535124 true] [17592186332384 1110 #uuid "186bc0be-1b0d-5c04-9003-1869784aa6bb" 13194139535124 true] [17592186332385 1034 "3x-5+\\frac{4}{{x}^{2}+x+1}" 13194139535124 true] [17592186332385 1103 #edb/ref 17592186045453 13194139535124 true] [17592186332385 1111 #uuid "5646c960-e73a-5ec5-8214-1c3d75d44623" 13194139535124 true] [17592186332386 1034 "3x-5-\\frac{x+4}{{x}^{2}+x+1}" 13194139535124 true] [17592186332386 1103 #edb/ref 17592186045453 13194139535124 true] [17592186332386 1111 #uuid "d2d8d3c4-d066-5356-a766-5a80e48ee754" 13194139535124 true] [17592186332387 1034 "x+4+\\frac{3x-5}{{x}^{2}+x+1}" 13194139535124 true] [17592186332387 1103 #edb/ref 17592186045453 13194139535124 true] [17592186332387 1111 #uuid "3cf8e602-9a52-598c-a340-97f4494768ca" 13194139535124 true] [17592186332388 1034 "3x-5+\\frac{x+4}{{x}^{2}+x+1}" 13194139535124 true] [17592186332388 1103 #edb/ref 17592186045453 13194139535124 true] [17592186332388 1111 #uuid "d1161222-e7eb-5cf5-974c-fe20e9c2c471" 13194139535124 true] [17592186332389 1034 "3x-5+\\frac{{x}^{2}+x+1}{x+4}" 13194139535124 true] [17592186332389