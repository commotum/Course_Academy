35124 true] [17592186332410 1145 "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,-2x+1 \\\\  & 3{x}^{3}-2{x}^{2}+5x-4\\,\\enclose{longdiv}{\\,\\,-6{x}^{4}+7{x}^{3}-8{x}^{2}+6x+2\\,\\,} \\\\  & \\,\\,\\,\\,{\\,\\,-\\,6{x}^{4}+4{x}^{3}-10{x}^{2}+8x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,3{x}^{3}+2{x}^{2}-\\,2x+2 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,{3{x}^{3}-2{x}^{2}+5x-4}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,4{x}^{2}-7x+6\\end{aligned}\n$$\n\nTherefore,\n\n- the quotient is $-2x+1,$ and\n\n- the remainder is $4{x}^{2}-7x+6.$" 13194139535124 true] [17592186332411 1000 #edb/ref 17592186332412 13194139535124 true] [17592186332411 1040 #edb/ref 17592186045449 13194139535124 true] [17592186332411 1041 "field-1" 13194139535124 true] [17592186332411 1104 #edb/ref 17592186332412 13194139535124 true] [17592186332411 1110 #uuid "23f3b96d-654d-58ae-a4a1-dce5afa851c0" 13194139535124 true] [17592186332412 1034 "4x^2-7x+6" 13194139535124 true] [17592186332412 1103 #edb/ref 17592186045453 13194139535124 true] [17592186332412 1111 #uuid "260ca86e-d6ee-5166-b532-30ab7b337cd3" 13194139535124 true] [17592186332413 1017 #edb/ref 17592186332414 13194139535124 true] [17592186332413 1017 #edb/ref 17592186332416 13194139535124 true] [17592186332413 1089 "q-325149" 13194139535124 true] [17592186332413 1091 #edb/ref 17592186045464 13194139535124 true] [17592186332413 1100 "Express $\\frac{4{x}^{4}+3{x}^{2}+3}{\\,{x}^{2}-x+2\\,}$ in the form $q(x)+\\frac{r(x)}{\\,{x}^{2}-x+2\\,},$ where $q(x)$ is the quotient and $r(x)$ is the reminder of the division.$$\n\n| $4{x}^{4}+3{x}^{2}+3$ | __ | {{field-1}} | $+$ | {{field-2}} |\n| --- | --- | --- | --- | --- |\n| ${x}^{2}-x+2$ | __ |  |  | ${x}^{2}-x+2$ |" 13194139535124 true] [17592186332413 1113 #uuid "28c5deff-2f33-56f1-a844-dfb7bfe0bd0e" 13194139535124 true] [17592186332413 1145 "Notice that the dividend is missing the ${x}^{3}$ and $x$ terms. So, we first rewrite it by including the missing terms with zero coefficients, as follows:\n\n$$\n4{x}^{4}+3{x}^{2}+3\\,=\\,4{x}^{4}+0{x}^{3}+3{x}^{2}+0x+3\n$$\n\nNow, using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,4{x}^{2}+4x-1 \\\\  & {x}^{2}-x+2\\,\\enclose{longdiv}{\\,\\,4{x}^{4}+0{x}^{3}+3{x}^{2}+0x+3\\,\\,} \\\\  & \\,\\,\\,\\,\\,{4{x}^{4}-4{x}^{3}+8{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,4{x}^{3}-5{x}^{2}+0x+3 \\\\  & \\,\\,\\,\\,\\,\\,\\,{4{x}^{3}-4{x}^{2}+8x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,-\\,{x}^{2}-8x+3 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,{x}^{2}+x-2}_{―} \\\\  & \\,\\,\\,\\,\\,\\,-\\,9x+5\\end{aligned}\n$$\n\nAs a result, \n\n- the quotient is $4{x}^{2}+4x-1,$ and\n\n- the remainder is $-9x+5.$\n\nTherefore,\n\n$$\n\\frac{4{x}^{4}+3{x}^{2}+3}{\\,{x}^{2}-x+2\\,}=\\,4{x}^{2}+4x-1\\,+\\frac{\\,(-9x+5)\\,}{\\,{x}^{2}-x+2\\,}.\n$$" 13194139535124 true] [17592186332414 1000 #edb/ref 17592186332415 13194139535124 true] [17592186332414 1040 #edb/ref 17592186045449 13194139535124 true] [17592186332414 1041 "field-1" 13194139535124 true] [17592186332414 1104 #edb/ref 17592186332415 13194139535124 true] [17592186332414 1110 #uuid "d952cb6a-939e-5275-a055-86c35c4e40b1" 13194139535124 true] [17592186332415 1034 "4x^2+4x-1" 13194139535124 true] [17592186332415 1103 #edb/ref 17592186045453 13194139535124 true] [17592186332415 1111 #uuid "d3bcdafc-b838-5679-9a40-814cda19cdaf" 13194139535124 true] [17592186332416 1000 #edb/ref 17592186332417 13194139535124 true] [17592186332416 1040 #edb/ref 17592186045449 13194139535124 true] [17592186332416 1041 "field-2" 13194139535124 true] [17592186332416 1104 #edb/ref 17592186332417 13194139535124 true] [17592186332416 1110 #uuid "4c5c2f84-8562-5883-b69b-f44f19a39ad8" 13194139535124 true] [17592186332417 1034 "-9x+5" 13194139535124 true] [17592186332417 1103 #edb/ref 17592186045453 13194139535124 true] [17592186332417 1111 #uuid "b2418049-00f0-5ffc-aa7f-d0c68aab0a46" 13194139535124 true] [17592186332418 1017 #edb/ref 