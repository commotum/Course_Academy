#{[{:db/id #edb/ref 17592186096867 :knowledge-point/_questions [{:knowledge-point/id #uuid "96967f25-565a-5338-878e-00fd30055772" :knowledge-point/title "Calculating the Area Bounded Below a Curve and Above the X-Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df635a58-77bf-5e95-a399-dd1baea9994d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186093610} {:answer/id #uuid "f08997c9-ba52-53b9-9c33-46805da068a1" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186093611} {:answer/id #uuid "ff97270f-a011-5d06-99d9-c118d5dc4185" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{13}" :db/id #edb/ref 17592186093612} {:answer/id #uuid "1994dce0-f633-5f83-8dbe-b6ffdebda18e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186093613} {:answer/id #uuid "752de6cd-f161-5e20-ae88-73328e04a0c8" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186093614}] :answer-field/correct {:answer/id #uuid "df635a58-77bf-5e95-a399-dd1baea9994d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186093610} :answer-field/id #uuid "ff9da75d-bbb7-5a3d-9a49-484c7a329b2f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186093609}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "fee589a4-db91-599f-87c6-08f88cf08d01" :question/math-academy-id "q-11005" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038613/assets/e1b6599646532be14e417731c4a8b2f7c4dffcc475e2b99cda0279e7dbf08bc6.png)\n\nFind the area between the curve $y=-3{x}^{2}+5x$, the $x$-axis and the line $x=1$, shown above." :question/worked-solution "To find the area, we just need to compute the corresponding definite integral:\n\n$$\n\\begin{aligned}A & ={\\int }_{a}^{b}y(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}(-3{x}^{2}+5x)\\,\\text{d}x \\\\  & =-3\\cdot {\\int }_{0}^{1}{x}^{2}\\,\\text{d}x+5\\cdot {\\int }_{0}^{1}x\\,\\text{d}x \\\\  & =-3\\cdot {\\frac{{x}^{3}}{3}|}_{0}^{1}+5\\cdot {\\frac{{x}^{2}}{2}|}_{0}^{1} \\\\  & =-3(\\frac{1}{3}-0)+5(\\frac{1}{2}-0) \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$"}]}
