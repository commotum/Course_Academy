3808/selection/1a17e1438e77bfcf59807cdbe6cc5e10b494eea27cb5ae7912a8aa1218355591" "q-13808/selection/de725214b6f281f8c187abdd536a28cf225a9e9e792f7a51d9b84efd32004c58"] :db/ensure [:answer-field/validate]} {:db/id "q-13808" :question/id #uuid "7095d0e3-f94b-57ed-bb1d-1a0c31d209b6" :question/math-academy-id "q-13808" :question/problem "Calculate the integral $\\int \\frac{5}{x\\operatorname{ln}⁡({x}^{2})}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡({x}^{2}).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{{x}^{2}}\\cdot 2x=\\frac{2}{x}\\,⟹\\,\\frac{1}{2}\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{5}{x\\operatorname{ln}⁡({x}^{2})}\\,\\text{d}x & =5\\int \\frac{1}{\\operatorname{ln}⁡({x}^{2})}\\cdot \\frac{\\text{d}x}{x} \\\\  & =5\\int \\frac{1}{u}\\cdot (\\frac{1}{2}\\text{d}u) \\\\  & =\\frac{5}{2}\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =\\frac{5}{2}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{5}{2}\\operatorname{ln}⁡|\\operatorname{ln}⁡({x}^{2})|+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-13808/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "41b7d83f-3b9b-556c-9e49-13df9c3b597e"] :knowledge-point/questions ["q-13808"] :db/ensure [:knowledge-point/validate]} {:db/id "q-2380/selection/45d3363eb1c69ea35d807f7ce827a9e66504b5782c76960316e22c5db7e585a7" :answer/id #uuid "d2a72e29-8f50-5d0d-83b2-3322ade7ee10" :answer/type :answer.type/math :answer/value "\\frac{1}{\\operatorname{ln}⁡(\\operatorname{ln}⁡x)}+C" :db/ensure [:answer/validate]} {:db/id "q-2380/selection/281bd737bb008a5e8170e574e9e6176ce5c6f9870cfc4dfa5f642a685c0b0e63" :answer/id #uuid "03f48953-f2f7-5f8d-8f8f-1a67b5d2524d" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡x}{x}+C" :db/ensure [:answer/validate]} {:db/id "q-2380/selection/cfd64aa6814bcd4cc34ab0ff4a1d9e47997706c4278460079c9a89a0a60962a2" :answer/id #uuid "6fe125c4-ccae-54bf-89e3-b2e2937a717a" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-2380/selection/e6652b5da454e13aa878b914540e5e8b668aa8c0b7cd5d37cd126fa127501d6f" :answer/id #uuid "d294cfa1-d1f9-5f18-aa18-8c7c6f0ab21c" :answer/type :answer.type/math :answer/value "2\\sqrt{\\operatorname{ln}⁡x}+C" :db/ensure [:answer/validate]} {:db/id "q-2380/selection/29567d402f40edb4bc0cf85c94e387700c854d2c913ea1fceb9cacfb65403878" :answer/id #uuid "28adc6c8-aa2f-50db-9fb5-d12735aaf371" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{\\operatorname{ln}⁡(\\operatorname{ln}⁡x)}}{x}+C" :db/ensure [:answer/validate]} {:db/id "q-2380/selection" :answer-field/id #uuid "3003d995-ec63-5573-a343-1b41701124da" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-2380/selection/e6652b5da454e13aa878b914540e5e8b668aa8c0b7cd5d37cd126fa127501d6f" :answer-field/choices ["q-2380/selection/45d3363eb1c69ea35d807f7ce827a9e66504b5782c76960316e22c5db7e585a7" "q-2380/selection/281bd737bb008a5e8170e574e9e6176ce5c6f9870cfc4dfa5f642a685c0b0e63" "q-2380/selection/cfd64aa6814bcd4cc34ab0ff4a1d9e47997706c4278460079c9a89a0a60962a2" "q-2380/selection/e6652b5da454e13aa878b914540e5e8b668aa8c0b7cd5d37cd126fa127501d6f" "q-2380/selection/29567d402f40edb4bc0cf85c94e387700c854d2c913ea1fceb9cacfb65403878"] :db/ensure [:answer-field/validate]} {:db/id "q-2380" :question/id #uuid "14d64831-00ec-512c-8691-072b09db6f00" :question/math-academy-id "q-2380" :question/problem "Calculate the integral $\\int \\frac{1}{x\\sqrt{\\operatorname{ln}⁡x}}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{x\\sqrt{\\operatorname{ln}⁡x}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{\\operatorname{ln}⁡x}}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int \\frac{1}{\\sqrt{u}}\\cdot \\text{d}u \\\\  & =\\int {u}^{-1/2}\\,\\text{d}u \\\\  & =2{u}^{1/2}+C \\\\  & =2\\sqrt{\\operatorname{ln}⁡x}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-2380/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "41b7d83f-3b9b-556c-9e49-13df9c3b597e"] :knowledge-point/questions ["q-2380"] :db/ensure [:knowledge-point/validate]} {:db/id "q-31394/selection/f1fe6fa4251124a0e4599e1b8e2f9880ce512d01d27dd54d2dc83691a2d45921" :answer/id #uuid "4a10f0e7-0386-5ec1-953d-48db2b73f569" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡x\\cdot \\frac{{log}_{5}^{2}⁡x}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-31394/selection/7cbdb729fe6fb245abbf034cc8f352eb3113138f1d53ced6e86d521b07dd922a" :answer/id #uuid "079369c5-5eb2-59b2-9d81-e29b505cd774" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡5\\cdot \\frac{{log}_{5}^{2}⁡x}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-31394/selection/31a61faf09cef45c827c8f9fb9e87453eac75f81a386275774b56d49e3c20c8b" :answer/id #uuid "84ca7593-d513-5f3b-846f-5f5bb10b6d00" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡x\\cdot \\frac{{log}_{5}^{2}⁡x}{x}+C" :db/ensure [:answer/validate]} {:db/id "q-31394/selection/8222558f964d0c99983f2e132453155cd41b6858bcd852b1089d94c272eaaf8a" :answer/id #uuid "6d8c2a10-f81e-563d-ab01-15d6bffaca93" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡5\\cdot \\frac{{log}_{3}⁡x}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-31394/selection/9fa12b4dbc784c8f5972943ffc4406bb9822fe4d043c21703d227fd5b2dc3fd4" :answer/id #uuid "a0dc4a35-b561-5ee0-9b1d-f35c15e76217" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡5\\cdot \\frac{{log}_{5}⁡x}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-31394/selection" :answer-field/id #uuid "46fbfcae-2bda-53d1-9a6a-fe3bb08a20d4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-31394/selection/7cbdb729fe6fb245abbf034cc8f352eb3113138f1d53ced6e86d521b07dd922a" :answer-field/choices ["q-31394/selection/f1fe6fa4251124a0e4599e1b8e2f9880ce512d01d27dd54d2dc83691a2d45921" "q-31394/selection/7cbdb729fe6fb245abbf034cc8f352eb3113138f1d53ced6e86d521b07dd922a" "q-31394/selection/31a61faf09cef45c827c8f9fb9e87453eac75f81a386275774b56d49e3c20c8b" "q-31394/selection/8222558f964d0c99983f2e132453155cd41b6858bcd852b1089d94c272eaaf8a" "q-31394/selection/9fa12b4dbc784c8f5972943ffc4406bb9822fe4d043c21703d227fd5b2dc3fd4"] :db/ensure [:answer-field/validate]} {:db/id "q-31394" :question/id #uuid "1f7ae597-b00e-50ac-b1f2-5ef223c32ff4" :question/math-academy-id "q-31394" :question/problem "$\\int \\frac{{log}_{5}⁡x}{x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{5}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡5}\\,⟹\\,\\operatorname{ln}⁡5\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{5}⁡x}{x}\\,\\text{d}x & =\\int {log}_{5}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int u\\cdot \\operatorname{ln}⁡5\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡5\\int u\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡5\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\operatorname{ln}⁡5\\cdot \\frac{{log}_{5}^{2}⁡x}{2}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-31394/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6"] :knowledge-point/questions ["q-31394"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49606/selection/82957f104ffcb5d0e1a3dab16befbe8ab1874ae5fe0dcaf00605ee7586fd454e" :answer/id #uuid "57cb3af6-ccea-5f2a-8da0-fc3e91eb93cc" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}\\operatorname{ln}⁡3}{2}" :db/ensure [:answer/validate]} {:db/id "q-49606/selection/2042aa05f5c5d1d497886a56447e4f70405a58a7e47577262239010d351cf5c7" :answer/id #uuid "96e46287-732b-573b-8d75-f314704c260a" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}\\operatorname{ln}⁡3}{3}" :db/ensure [:answer/validate]} {:db/id "q-49606/selection/694e8577edff65fe8ce10005fa799d58f608f1ffc72a17a2bde29c8e2bd5c6ea" :answer/id #uuid "d0b7053e-e628-5ffd-acda-3e32ea174868" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}\\operatorname{ln}⁡2}{3}" :db/ensure [:answer/validate]} {:db/id "q-49606/selection/168bc00309937330eb6bfdbe5f5b8521eab74780236b300822754bce0e0ded37" :answer/id #uuid "899119db-d562-5a6d-8ac9-b571343f0e01" :answer/type :answer.type/math :answer/value "\\frac{2\\operatorname{ln}⁡3}{3}" :db/ensure [:answer/validate]} {:db/id "q-49606/selection/471c8efd124505483ab2c3a26112d21fac9b8840cf02dc255f91a326a3853033" :answer/id #uuid "8d55be4e-3140-5784-a41b-e679b2711a87" :answer/type :answer.type/math :answer/value "\\frac{3\\operatorname{ln}⁡3}{2}" :db/ensure [:answer/validate]} {:db/id "q-49606/selection" :answer-field/id #uuid "186b9995-d88d-5390-82d5-32bb3ce4e8e7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49606/selection/82957f104ffcb5d0e1a3dab16befbe8ab1874ae5fe0dcaf00605ee7586fd454e" :answer-field/choices ["q-49606/selection/82957f104ffcb5d0e1a3dab16befbe8ab1874ae5fe0dcaf00605ee7586fd454e" "q-49606/selection/2042aa05f5c5d1d497886a56447e4f70405a58a7e47577262239010d351cf5c7" "q-49606/selection/694e8577edff65fe8ce10005fa799d58f608f1ffc72a17a2bde29c8e2bd5c6ea" "q-49606/selection/168bc00309937330eb6bfdbe5f5b8521eab74780236b300822754bce0e0ded37" "q-49606/selection/471c8efd124505483ab2c3a26112d21fac9b8840cf02dc255f91a326a3853033"] :db/ensure [:answer-field/validate]} {:db/id "q-49606" :question/id #uuid "37924b10-5b5a-502d-94ce-fce472a24f69" :question/math-academy-id "q-49606" :question/problem "What is the value of ${\\int }_{e}^{{e}^{3}}\\frac{\\sqrt{3}}{2x\\operatorname{ln}⁡x}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e$ | ${e}^{3}$ |\n| --- | --- | --- |\n| $u$ | $1$ | $3$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{e}^{{e}^{3}}\\frac{\\sqrt{3}}{2x\\operatorname{ln}⁡x}\\,\\text{d}x & =\\frac{\\sqrt{3}}{2}{\\int }_{e}^{{e}^{3}}\\frac{1}{\\operatorname{ln}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{\\sqrt{3}}{2}{\\int }_{1}^{3}\\frac{1}{u}\\cdot \\text{d}u \\\\  & =\\frac{\\sqrt{3}}{2}(\\operatorname{ln}⁡|u|){|}_{1}^{3} \\\\  & =\\frac{\\sqrt{3}}{2}(\\operatorname{ln}⁡3-\\operatorname{ln}⁡1) \\\\  & =\\frac{\\sqrt{3}\\operatorname{ln}⁡3}{2}\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-49606/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05"] :knowledge-point/questions ["q-49606"] :db/ensure [:knowledge-point/validate]} {:db/id "q-31619/selection/a84d639d380e10cb74c92005685f9f65779377dfb51342c280c63c645679bbea" :answer/id #uuid "01316d6c-20a8-5be7-8fa6-41aa577fa261" :answer/type :answer.type/math :answer/value "25" :db/ensure [:answer/validate]} {:db/id "q-31619/selection/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" :answer/id #uuid "4b28e28e-f8ab-5f19-b0e5-3e780c25483a" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "q-31619/selection/cc9a76203916dfde1bd98379ac07b142c6a34b616ea58a5c94fd7caac7be05d4" :answer/id #uuid "0dba5aae-57d1-5614-9ed0-590a10b56f63" :answer/type :answer.type/math :answer/value "\\frac{19}{3}" :db/ensure [:answer/validate]} {:db/id "q-31619/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "4747d8c6-ee0f-58be-adda-898a35029ab2" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-31619/selection/db3babdc233009c9211f7b76bc366670e92fb1a2f2a8c5ccfb158ca3e98ca8b2" :answer/id #uuid "50d329ff-9997-5121-901c-9b8b27845afb" :answer/type :answer.type/math :answer/value "\\frac{15}{2}" :db/ensure [:answer/validate]} {:db/id "q-31619/selection" :answer-field/id #uuid "d2ea4cf5-31e1-5d64-b460-6026ca1902f6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-31619/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-31619/selection/a84d639d380e10cb74c92005685f9f65779377dfb51342c280c63c645679bbea" "q-31619/selection/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" "q-31619/selection/cc9a76203916dfde1bd98379ac07b142c6a34b616ea58a5c94fd7caac7be05d4" "q-31619/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-31619/selection/db3babdc233009c9211f7b76bc366670e92fb1a2f2a8c5ccfb158ca3e98ca8b2"] :db/ensure [:answer-field/validate]} {:db/id "q-31619" :question/id #uuid "326c93e9-0142-5efb-8dc3-f10f0ad77fba" :question/math-academy-id "q-31619" :question/problem "What is the value of ${\\int }_{e/5}^{{e}^{4}/5}\\frac{3}{x\\sqrt{\\operatorname{ln}⁡(5x)}}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(5x).$ Then  we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{5x}\\cdot 5=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e/5$ | ${e}^{4}/5$ |\n| --- | --- | --- |\n| $u$ | $1$ | $4$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{e/5}^{{e}^{4}/5}\\frac{3}{x\\sqrt{\\operatorname{ln}⁡(5x)}}\\,\\text{d}x & =3{\\int }_{e/5}^{{e}^{4}/5}\\frac{1}{\\sqrt{\\operatorname{ln}⁡(5x)}}\\cdot \\frac{\\text{d}x}{x} \\\\  & =3{\\int }_{1}^{4}\\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =3{\\int }_{1}^{4}{u}^{-1/2}\\,\\text{d}u \\\\  & =3\\cdot {\\frac{{u}^{1/2}}{1/2}|}_{1}^{4} \\\\  & =6\\cdot {\\sqrt{u}|}_{1}^{4} \\\\  & =6(\\sqrt{4}-\\sqrt{1}) \\\\  & =6\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-31619/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05"] :knowledge-point/questions ["q-31619"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351281/field-1/0f49a4dbd5c742935484b6812e6555790b20d2c8dcba12576f1906584b309432" :answer/id #uuid "7271e71d-2629-5a11-aa82-4f5b8f2b8fed" :answer/type :answer.type/math :answer/value "\\ln(4)" :db/ensure [:answer/validate]} {:db/id "q-351281/field-1/ddf6ad81d93e0b025a0b8018fe9feefc21eff45d6233911d46b16c0235c073d6" :answer/id #uuid "66c22726-e46d-59f5-8fec-795ce289f6e5" :answer/type :answer.type/math :answer/value "\\ln(3)" :db/ensure [:answer/validate]} {:db/id "q-351281/field-1" :answer-field/id #uuid "9153a0ca-7252-51c7-b4aa-13bf30f42249" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351281/field-1/0f49a4dbd5c742935484b6812e6555790b20d2c8dcba12576f1906584b309432" :answer-field/choices ["q-351281/field-1/0f49a4dbd5c742935484b6812e6555790b20d2c8dcba12576f1906584b309432" "q-351281/field-1/ddf6ad81d93e0b025a0b8018fe9feefc21eff45d6233911d46b16c0235c073d6"] :db/ensure [:answer-field/validate]} {:db/id "q-351281" :question/id #uuid "220a21c5-edc9-50d7-beb8-7176d9aeea2c" :question/math-academy-id "q-351281" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{e/5}^{{e}^{4}/5}\\frac{1}{x\\operatorname{ln}⁡(5x)}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(5x).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{5x}\\cdot 5=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e/5$ | ${e}^{4}/5$ |\n| --- | --- | --- |\n| $u$ | $1$ | $4$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{e/5}^{{e}^{4}/5}\\frac{1}{x\\operatorname{ln}⁡(5x)}\\,\\text{d}x & ={\\int }_{e/5}^{{e}^{4}/5}\\frac{1}{\\operatorname{ln}⁡(5x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{1}^{4}\\frac{1}{u}\\,\\text{d}u \\\\  & =(\\operatorname{ln}⁡|u|){|}_{1}^{4} \\\\  & =\\operatorname{ln}⁡4-\\operatorname{ln}⁡1 \\\\  & =\\operatorname{ln}⁡4\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-351281/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05"] :knowledge-point/questions ["q-351281"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73656/selection/a86848a82799617ba6475623f8928bbe92f92175972cb561629ba3c3be377e31" :answer/id #uuid "d85fc40f-17fd-58e5-94d0-c242a5e5cdb3" :answer/type :answer.type/math :answer/value "2(\\sqrt{2}-1)\\operatorname{ln}⁡8" :db/ensure [:answer/validate]} {:db/id "q-73656/selection/52b96968d851a68c1b44b5c23b6bd9856db27c3e095f66f5f49b3900af3ca71f" :answer/id #uuid "94ee1560-69d8-5b8b-9ca1-dc01b4d639d2" :answer/type :answer.type/math :answer/value "\\sqrt{2}\\,\\operatorname{ln}⁡8" :db/ensure [:answer/validate]} {:db/id "q-73656/selection/2e8c4773afc0ea9f1c42b57b0d90a8d93c7f73275929b32288ce7f2b5c411709" :answer/id #uuid "35e12ae1-2e5c-5d2e-9a37-db73c13daa7f" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡8" :db/ensure [:answer/validate]} {:db/id "q-73656/selection/49085ed46ed512ceebfc99f880a0deab2ad784ec473b3e33908b9b29741bb01e" :answer/id #uuid "637b761f-22f2-52e9-baed-bd5e0c990cdd" :answer/type :answer.type/math :answer/value "(1-\\sqrt{2})\\operatorname{ln}⁡8" :db/ensure [:answer/validate]} {:db/id "q-73656/selection/8b5a9b94774e78e456226d56c582c3591a480dcd25dbda1f313f16b27bb43770" :answer/id #uuid "8fb3312d-89b5-54c6-a68b-89c09328c9d9" :answer/type :answer.type/math :answer/value "2\\sqrt{\\operatorname{ln}⁡8}" :db/ensure [:answer/validate]} {:db/id "q-73656/selection" :answer-field/id #uuid "95dcee1d-6462-5c06-a38c-3a7faf7e8cf5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73656/selection/a86848a82799617ba6475623f8928bbe92f92175972cb561629ba3c3be377e31" :answer-field/choices ["q-73656/selection/a86848a82799617ba6475623f8928bbe92f92175972cb561629ba3c3be377e31" "q-73656/selection/52b96968d851a68c1b44b5c23b6bd9856db27c3e095f66f5f49b3900af3ca71f" "q-73656/selection/2e8c4773afc0ea9f1c42b57b0d90a8d93c7f73275929b32288ce7f2b5c411709" "q-73656/selection/49085ed46ed512ceebfc99f880a0deab2ad784ec473b3e33908b9b29741bb01e" "q-73656/selection/8b5a9b94774e78e456226d56c582c3591a480dcd25dbda1f313f16b27bb43770"] :db/ensure [:answer-field/validate]} {:db/id "q-73656" :question/id #uuid "59278fd6-52f5-5feb-8c48-613225fb6969" :question/math-academy-id "q-73656" :question/problem "What is the value of ${\\int }_{8}^{64}\\frac{1}{x\\sqrt{{log}_{8}⁡x}}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{8}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡8}\\,⟹\\,\\operatorname{ln}⁡8\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $8$ | $64$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{8}^{64}\\frac{1}{x\\sqrt{{log}_{8}⁡x}}\\,\\text{d}x & ={\\int }_{8}^{64}\\frac{1}{\\sqrt{{log}_{8}⁡x}}\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{1}^{2}\\frac{1}{\\sqrt{u}}\\cdot \\operatorname{ln}⁡8\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡8{\\int }_{1}^{2}\\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡8(2\\sqrt{u}){|}_{1}^{2} \\\\  & =2\\operatorname{ln}⁡8(\\sqrt{2}-\\sqrt{1}) \\\\  & =2(\\sqrt{2}-1)\\operatorname{ln}⁡8\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-73656/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05"] :knowledge-point/questions ["q-73656"] :db/ensure [:knowledge-point/validate]}]
