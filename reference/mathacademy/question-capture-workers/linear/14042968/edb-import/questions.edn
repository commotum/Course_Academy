#{[{:db/id #edb/ref 17592186100521 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "41b7d83f-3b9b-556c-9e49-13df9c3b597e" :knowledge-point/title "Integrating Functions Containing the Natural Logarithm"}] :question/id #uuid "8ea17e06-1248-510c-9e71-c57da0cb0d02" :question/math-academy-id "e-14405" :question/problem "Calculate $\\displaystyle{\\int \\dfrac{3}{x \\sqrt{\\ln x}} \\, \\textrm{d}x }.$" :question/worked-solution "Let's set $u = \\ln x.$ Then, we have\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= \\dfrac 1 x\\quad\\Longrightarrow\\quad \\textrm{d}u=\\dfrac 1 x\\,{\\textrm{d}x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{3}{x\\sqrt{\\operatorname{ln}⁡x}}\\,\\text{d}x & =3\\int \\frac{1}{\\sqrt{\\operatorname{ln}⁡x}}\\cdot \\frac{1}{x}\\,\\text{d}x \\\\  & =3\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =3\\int {u}^{-1/2}\\,\\text{d}u \\\\  & =3\\cdot 2{u}^{1/2}+C \\\\  & =6\\sqrt{u}+C \\\\  & =6\\sqrt{\\operatorname{ln}⁡x}+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186100522 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/id #uuid "1579f932-6e7f-5daa-b001-54a9f6c236ad" :question/math-academy-id "e-14406" :question/problem "Calculate the integral $\\displaystyle \\int \\dfrac{\\log^2_3 x }{x} \\,\\textrm d x.$" :question/worked-solution "Let's rewrite our integral as\n\n$$\n\\int \\dfrac{(\\log_3 x)^2 }{x} \\,\\textrm d x.\n$$\n\nLet $u=\\log_3 x.$ Differentiating, we get\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = \\dfrac{1}{x\\ln 3}\\quad\\Longrightarrow\\quad\\ln 3\\,\\textrm d u = \\dfrac 1 x \\textrm d x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{({log}_{3}⁡x)^{2}}{x}\\,\\text{d}x & =\\int ({log}_{3}⁡x)^{2}\\cdot \\frac{1}{x}\\,\\text{d}x \\\\  & =\\int {u}^{2}\\cdot \\operatorname{ln}⁡3\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡3\\int {u}^{2}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡3\\cdot \\frac{1}{3}{u}^{3}+C \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡3({log}_{3}⁡x)^{3}+C \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡3{log}_{3}^{3}⁡x+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186100523 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05" :knowledge-point/title "Evaluating Definite Integrals"}] :question/id #uuid "d2f49acf-ed91-510d-a0f1-41c50eeef9e7" :question/math-academy-id "e-14422" :question/problem "Evaluate $\\displaystyle{\\int_{e}^{e^2} \\dfrac{\\ln^2 x}{x}\\,\\textrm{d}x}.$" :question/worked-solution "Let's set $u = \\ln x.$ Then, we have\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= \\dfrac 1 x\\quad\\Longrightarrow\\quad \\textrm{d}u=\\dfrac 1 x\\,{\\textrm{d}x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e$ | $e^2$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\eqalign{\n\t\\int_{e}^{e^2} \\dfrac{\\ln^2 x}{x}\\,\\textrm{d}x\n&= \\int_{e}^{e^2} (\\ln x)^2\\cdot \\dfrac{\\textrm{d}x}{x}\\[5pt]\n&=\\int_{1}^{2} u^2\\,\\textrm{d}u\\[5pt]\n&=\\left.\\dfrac13u^{3}\\right|_{1}^{2}\\[5pt] \n&=\\dfrac{1}{3}\\left(2^3-1^3 \\right)\\[5pt]\n&=\\dfrac{1}{3}\\left(8-1 \\right)\\[5pt]\n&=\\dfrac{7}{3}\t\t\n\n\t}\n$$"}] [{:db/id #edb/ref 17592186302152 :knowledge-point/_questions [{:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10c430ce-b4c9-5ad6-92d3-a2313924c0a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡6}{3}\\cdot {log}_{6}^{3}⁡x+C" :db/id #edb/ref 17592186302154} {:answer/id #uuid "0f3984ae-c6b2-5233-9ae5-32d45bf4dadb" :answer/type {:db/ident :answer.type/math} :answer/value "{log}_{6}^{3}⁡x+C" :db/id #edb/ref 17592186302155} {:answer/id #uuid "e33122d2-74e0-56a2-8a6b-f7eaa2f44046" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡6\\cdot {log}_{6}^{3}⁡x+C" :db/id #edb/ref 17592186302156} {:answer/id #uuid "895c6afb-61b9-5702-8402-056efbb6b7e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡6\\cdot {log}_{6}^{3}⁡x+C" :db/id #edb/ref 17592186302157} {:answer/id #uuid "3b971759-66f9-5d4a-83c2-d33e420c3e05" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡6\\cdot {log}_{6}⁡x+C" :db/id #edb/ref 17592186302158}] :answer-field/correct {:answer/id #uuid "895c6afb-61b9-5702-8402-056efbb6b7e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡6\\cdot {log}_{6}^{3}⁡x+C" :db/id #edb/ref 17592186302157} :answer-field/id #uuid "0e9fde92-799f-54cb-a163-c8b63400aebb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186302153}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "06296c2e-56ff-57f8-948e-fc4b28498e50" :question/math-academy-id "q-114020" :question/problem "$\\int \\frac{3{log}_{6}^{2}⁡x}{x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{6}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡6}\\,⟹\\,\\operatorname{ln}⁡6\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{3{log}_{6}^{2}⁡x}{x}\\,\\text{d}x & =3\\int ({log}_{6}⁡x)^{2}\\cdot \\frac{\\text{d}x}{x} \\\\  & =3\\int {u}^{2}\\cdot \\operatorname{ln}⁡6\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡6\\int {u}^{2}\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡6\\cdot \\frac{{u}^{3}}{3}+C \\\\  & =\\operatorname{ln}⁡6\\cdot {log}_{6}^{3}⁡x+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288889 :knowledge-point/_questions [{:knowledge-point/id #uuid "41b7d83f-3b9b-556c-9e49-13df9c3b597e" :knowledge-point/title "Integrating Functions Containing the Natural Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a56840dc-5e00-5f49-b590-1f3863c348f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{ln}^{2}⁡x+C" :db/id #edb/ref 17592186288891} {:answer/id #uuid "a0dedd3f-bd40-52de-9650-d627896afc09" :answer/type {:db/ident :answer.type/math} :answer/value "{ln}^{2}⁡x+C" :db/id #edb/ref 17592186288892} {:answer/id #uuid "889ad441-d1c4-56a6-b705-7aa5a5f2f558" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}{ln}^{2}⁡x+C" :db/id #edb/ref 17592186288893} {:answer/id #uuid "6a605c5d-653a-5ed3-ad3c-426e45c63748" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡x+C" :db/id #edb/ref 17592186288894} {:answer/id #uuid "cc76caca-bc0f-52ed-8254-97e818f1b12a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡x+C" :db/id #edb/ref 17592186288895}] :answer-field/correct {:answer/id #uuid "889ad441-d1c4-56a6-b705-7aa5a5f2f558" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}{ln}^{2}⁡x+C" :db/id #edb/ref 17592186288893} :answer-field/id #uuid "291f4bbb-6be7-5dcb-b262-66285993d76d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288890}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a2a8959c-6b04-5ef7-8052-da57da0ea3d3" :question/math-academy-id "q-13803" :question/problem "Calculate the integral $\\int \\frac{\\operatorname{ln}⁡x}{2x}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{ln}⁡x}{2x}\\,\\text{d}x & =\\frac{1}{2}\\int \\operatorname{ln}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{2}\\int u\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\frac{1}{4}{u}^{2}+C \\\\  & =\\frac{1}{4}{ln}^{2}⁡x+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288896 :knowledge-point/_questions [{:knowledge-point/id #uuid "41b7d83f-3b9b-556c-9e49-13df9c3b597e" :knowledge-point/title "Integrating Functions Containing the Natural Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "190c27db-dd0f-559a-902b-5dbc83d859ee" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}{ln}^{2}⁡({x}^{2})+C" :db/id #edb/ref 17592186288898} {:answer/id #uuid "e1ac7ac3-d198-554a-9743-ea0f4f9b7c34" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{ln}^{2}⁡({x}^{2})+C" :db/id #edb/ref 17592186288899} {:answer/id #uuid "c9f8db47-fddc-5cd3-b5b6-2928fd2958fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}\\operatorname{ln}⁡({x}^{2})+C" :db/id #edb/ref 17592186288900} {:answer/id #uuid "473cdab0-4256-5c6c-a43c-0f4779694bf7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}{ln}^{2}⁡|x|+C" :db/id #edb/ref 17592186288901} {:answer/id #uuid "fd704b15-f081-5cf0-858c-24b42eb59cc8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}{ln}^{2}⁡({x}^{2})+C" :db/id #edb/ref 17592186288902}] :answer-field/correct {:answer/id #uuid "190c27db-dd0f-559a-902b-5dbc83d859ee" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}{ln}^{2}⁡({x}^{2})+C" :db/id #edb/ref 17592186288898} :answer-field/id #uuid "84906a4b-b873-5500-8bf5-b8c633338e14" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288897}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "4234ecef-6101-5408-8e19-a789f906baa2" :question/math-academy-id "q-13807" :question/problem "Calculate the integral $\\int \\frac{\\operatorname{ln}⁡({x}^{2})}{3x}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡({x}^{2}).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{{x}^{2}}\\cdot 2x=\\frac{2}{x}\\,⟹\\,\\frac{1}{2}\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{ln}⁡({x}^{2})}{3x}\\,\\text{d}x & =\\frac{1}{3}\\int \\operatorname{ln}⁡({x}^{2})\\cdot \\frac{\\text{d}x}{x}\\cdot  \\\\  & =\\frac{1}{3}\\int u\\cdot (\\frac{1}{2}\\text{d}u) \\\\  & =\\frac{1}{6}\\int u\\,\\text{d}u \\\\  & =\\frac{1}{6}\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\frac{1}{12}{u}^{2}+C \\\\  & =\\frac{1}{12}{ln}^{2}⁡({x}^{2})+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186302173 :knowledge-point/_questions [{:knowledge-point/id #uuid "41b7d83f-3b9b-556c-9e49-13df9c3b597e" :knowledge-point/title "Integrating Functions Containing the Natural Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d2b2e3d-82cd-5211-9fd1-82df01b15fb8" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|\\operatorname{ln}⁡(2x)|+C" :db/id #edb/ref 17592186302175} {:answer/id #uuid "c4ed3294-f23b-5a37-812b-3200429d67a0" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡|\\operatorname{ln}⁡(4x)|+C" :db/id #edb/ref 17592186302176} {:answer/id #uuid "a4ea221c-eb86-54f2-975b-1fe1e977f711" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡|\\operatorname{ln}⁡x|+C" :db/id #edb/ref 17592186302177} {:answer/id #uuid "8cea49ee-13f7-504a-a8de-361c53d4a306" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡|\\operatorname{ln}⁡(2x)|+C" :db/id #edb/ref 17592186302178} {:answer/id #uuid "b190b52b-d15a-56a3-8ef9-330d4f32c85f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡|\\operatorname{ln}⁡(4x)|+C" :db/id #edb/ref 17592186302179}] :answer-field/correct {:answer/id #uuid "c4ed3294-f23b-5a37-812b-3200429d67a0" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡|\\operatorname{ln}⁡(4x)|+C" :db/id #edb/ref 17592186302176} :answer-field/id #uuid "723f76f6-078b-5048-9166-e625436b5904" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186302174}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "640d756b-d216-53d7-813b-ffeca4e75575" :question/math-academy-id "q-210746" :question/problem "Calculate the integral $\\int \\frac{2}{x\\operatorname{ln}⁡(4x)}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(4x).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{4x}\\cdot 4\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{2}{x\\operatorname{ln}⁡(4x)}\\,\\text{d}x & =2\\int \\frac{1}{\\operatorname{ln}⁡(4x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =2\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =2\\operatorname{ln}⁡|u|+C \\\\  & =2\\operatorname{ln}⁡|\\operatorname{ln}⁡(4x)|+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186101287 :knowledge-point/_questions [{:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81c36c65-35ca-5d52-a03d-92482fb6b1cb" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 2 \\cdot \\frac{\\log_{2} x}{2} + C" :db/id #edb/ref 17592186099339} {:answer/id #uuid "ef822792-3cf4-5a17-86ee-bb3dbb4f35a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln x \\cdot \\frac{\\log_{2}^{2} x}{2} + C" :db/id #edb/ref 17592186099340} {:answer/id #uuid "f225c7a5-c416-5406-a430-71fcc48bcc5a" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 2 \\cdot \\frac{\\log_{2}^{2} x}{2} + C" :db/id #edb/ref 17592186099341} {:answer/id #uuid "127c18f7-2532-52ea-bf09-7ea32a936b5e" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln x \\cdot \\frac{\\log_{2}^{2} x}{x} + C" :db/id #edb/ref 17592186099342} {:answer/id #uuid "399c3e46-e63f-548b-ad88-0cb54e0a6e39" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 3 \\cdot \\frac{\\log_{2} x}{2} + C" :db/id #edb/ref 17592186099343}] :answer-field/correct {:answer/id #uuid "f225c7a5-c416-5406-a430-71fcc48bcc5a" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 2 \\cdot \\frac{\\log_{2}^{2} x}{2} + C" :db/id #edb/ref 17592186099341} :answer-field/id #uuid "4456b3bc-a2cb-5663-9041-ec22b84552ac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186099338}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "bc1950d7-cc9c-5e9a-8f86-5dcc05de2e91" :question/math-academy-id "q-31329" :question/problem "$\\int \\frac{{log}_{2}⁡x}{x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{2}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡2}\\,⟹\\,\\operatorname{ln}⁡2\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{2}⁡x}{x}\\,\\text{d}x & =\\int {log}_{2}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int u\\cdot \\operatorname{ln}⁡2\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2\\int u\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\operatorname{ln}⁡2\\cdot \\frac{{log}_{2}^{2}⁡x}{2}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292394 :knowledge-point/_questions [{:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd965fb2-1789-5964-8ef8-b488cf979b3c" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3\\operatorname{ln}⁡|{log}_{5}⁡x|+C" :db/id #edb/ref 17592186292396} {:answer/id #uuid "11533f68-307b-5bc7-8f46-6fd6b5af0afb" :answer/type {:db/ident :answer.type/math} :answer/value "x\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡({x}^{3})|+C" :db/id #edb/ref 17592186292397} {:answer/id #uuid "ca647ce4-4cc7-5a3d-8e6e-97a2835d48b6" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186292398} {:answer/id #uuid "bb7c9319-18ca-5599-ad32-86a9e0eccd17" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡5}{5}\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186292399} {:answer/id #uuid "739228e8-510e-564d-8a7a-85f36da92739" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡({x}^{5})\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186292400}] :answer-field/correct {:answer/id #uuid "ca647ce4-4cc7-5a3d-8e6e-97a2835d48b6" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186292398} :answer-field/id #uuid "570a9286-b9a9-5ea2-b5a1-4a1b26015b22" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292395}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "de056453-dea5-5366-891a-53b77baba193" :question/math-academy-id "q-31402" :question/problem "$\\int \\frac{2}{x{log}_{5}⁡(3x)}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{5}⁡(3x).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡5}\\,⟹\\,\\operatorname{ln}⁡5\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{2}{x{log}_{5}⁡(3x)}\\,\\text{d}x & =2\\int \\frac{1}{{log}_{5}⁡(3x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =2\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡5\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡5\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =2\\operatorname{ln}⁡5\\operatorname{ln}⁡|u|+C \\\\  & =2\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186310024 :knowledge-point/_questions [{:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "493c9322-c0bc-5363-b2ea-5b184a5fbf41" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2" :db/id #edb/ref 17592186310026} {:answer/id #uuid "f72a3c11-24c3-561b-a129-b0e453f71d8d" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186310027} {:answer/id #uuid "b4327b80-2c9f-55f1-9ac9-dd122c8a022b" :answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186310028} {:answer/id #uuid "53d2ca6d-854a-537c-947f-a62b810b5184" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡2" :db/id #edb/ref 17592186310029} {:answer/id #uuid "611dd5b8-7339-5783-8214-a4a1ad37cc20" :answer/type {:db/ident :answer.type/math} :answer/value "{ln}^{2}⁡2" :db/id #edb/ref 17592186310030}] :answer-field/correct {:answer/id #uuid "53d2ca6d-854a-537c-947f-a62b810b5184" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡2" :db/id #edb/ref 17592186310029} :answer-field/id #uuid "299d34e5-7bc9-51d4-a66a-e7b23b846253" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186310025}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "84759818-b43c-5fd3-88c3-53455a0a478f" :question/math-academy-id "q-73653" :question/problem "What is the value of ${\\int }_{1}^{4}\\frac{4{log}_{4}⁡x}{x}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{4}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡4}\\,⟹\\,\\operatorname{ln}⁡4\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $4$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}\\frac{4{log}_{4}⁡x}{x}\\,\\text{d}x & =4{\\int }_{1}^{4}{log}_{4}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =4{\\int }_{0}^{1}u\\cdot \\operatorname{ln}⁡4\\,\\text{d}u \\\\  & =4\\operatorname{ln}⁡4{\\int }_{0}^{1}u\\,\\text{d}u \\\\  & =4\\operatorname{ln}⁡4\\cdot \\frac{{u}^{2}}{2}{|}_{0}^{1} \\\\  & =2\\operatorname{ln}⁡4\\cdot (1-0) \\\\  & =2\\operatorname{ln}⁡4 \\\\  & =4\\operatorname{ln}⁡2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186101444 :knowledge-point/_questions [{:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cfd5401-f59b-5d26-9381-903e7a100fe7" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 7\\ln \\mid \\log_{7} (4x) \\mid + C" :db/id #edb/ref 17592186100261} {:answer/id #uuid "d26d1f8b-e0aa-5d92-9ab9-24d9e216087f" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln x^{7}\\ln \\mid \\log_{7} (4x) \\mid + C" :db/id #edb/ref 17592186100262} {:answer/id #uuid "fcdc0d7c-75d9-5a6a-8e71-b2ed1b6d870f" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 4\\ln \\mid \\log_{7} x \\mid + C" :db/id #edb/ref 17592186100263} {:answer/id #uuid "561a7dca-9374-553b-824c-74d78cf70c81" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\ln 7}{7}\\ln \\mid \\log_{7} (4x) \\mid + C" :db/id #edb/ref 17592186100264} {:answer/id #uuid "62e4e20e-edf2-5d23-8879-c22c3dd0d4a3" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ln 7\\ln \\mid \\log_{7} (x^{4}) \\mid + C" :db/id #edb/ref 17592186100265}] :answer-field/correct {:answer/id #uuid "8cfd5401-f59b-5d26-9381-903e7a100fe7" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 7\\ln \\mid \\log_{7} (4x) \\mid + C" :db/id #edb/ref 17592186100261} :answer-field/id #uuid "10d45f02-34c8-55d7-aaa6-ca2883b6ab73" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186100260}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "15940cb6-48bb-51bb-99eb-a693e64f76c1" :question/math-academy-id "q-73659" :question/problem "$\\int \\frac{1}{x{log}_{7}⁡(4x)}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{7}⁡(4x).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡7}\\,⟹\\,\\operatorname{ln}⁡7\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{x{log}_{7}⁡(4x)}\\,\\text{d}x & =\\int \\frac{1}{{log}_{7}⁡(4x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡7\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡7\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =\\operatorname{ln}⁡7\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡7\\operatorname{ln}⁡|{log}_{7}⁡(4x)|+C\\end{aligned}\n$$"}]}
