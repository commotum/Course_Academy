wer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3\\operatorname{ln}⁡|{log}_{5}⁡x|+C" :db/id #edb/ref 17592186292396} {:answer/id #uuid "11533f68-307b-5bc7-8f46-6fd6b5af0afb" :answer/type {:db/ident :answer.type/math} :answer/value "x\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡({x}^{3})|+C" :db/id #edb/ref 17592186292397} {:answer/id #uuid "ca647ce4-4cc7-5a3d-8e6e-97a2835d48b6" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186292398} {:answer/id #uuid "bb7c9319-18ca-5599-ad32-86a9e0eccd17" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡5}{5}\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186292399} {:answer/id #uuid "739228e8-510e-564d-8a7a-85f36da92739" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡({x}^{5})\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186292400}] :answer-field/correct {:answer/id #uuid "ca647ce4-4cc7-5a3d-8e6e-97a2835d48b6" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186292398} :answer-field/id #uuid "570a9286-b9a9-5ea2-b5a1-4a1b26015b22" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292395}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "de056453-dea5-5366-891a-53b77baba193" :question/math-academy-id "q-31402" :question/problem "$\\int \\frac{2}{x{log}_{5}⁡(3x)}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{5}⁡(3x).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡5}\\,⟹\\,\\operatorname{ln}⁡5\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{2}{x{log}_{5}⁡(3x)}\\,\\text{d}x & =2\\int \\frac{1}{{log}_{5}⁡(3x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =2\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡5\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡5\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =2\\operatorname{ln}⁡5\\operatorname{ln}⁡|u|+C \\\\  & =2\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186318317 :knowledge-point/_questions [{:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b28e28e-f8ab-5f19-b0e5-3e780c25483a" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186318319} {:answer/id #uuid "4747d8c6-ee0f-58be-adda-898a35029ab2" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186318320} {:answer/id #uuid "01316d6c-20a8-5be7-8fa6-41aa577fa261" :answer/type {:db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186318321} {:answer/id #uuid "0dba5aae-57d1-5614-9ed0-590a10b56f63" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19}{3}" :db/id #edb/ref 17592186318322} {:answer/id #uuid "50d329ff-9997-5121-901c-9b8b27845afb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{15}{2}" :db/id #edb/ref 17592186318323}] :answer-field/correct {:answer/id #uuid "4747d8c6-ee0f-58be-adda-898a35029ab2" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186318320} :answer-field/id #uuid "d2ea4cf5-31e1-5d64-b460-6026ca1902f6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318318}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "326c93e9-0142-5efb-8dc3-f10f0ad77fba" :question/math-academy-id "q-31619" :question/problem "What is the value of ${\\int }_{e/5}^{{e}^{4}/5}\\frac{3}{x\\sqrt{\\operatorname{ln}⁡(5x)}}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(5x).$ Then  we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{5x}\\cdot 5=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e/5$ | ${e}^{4}/5$ |\n| --- | --- | --- |\n| $u$ | $1$ | $4$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{e/5}^{{e}^{4}/5}\\frac{3}{x\\sqrt{\\operatorname{ln}⁡(5x)}}\\,\\text{d}x & =3{\\int }_{e/5}^{{e}^{4}/5}\\frac{1}{\\sqrt{\\operatorname{ln}⁡(5x)}}\\cdot \\frac{\\text{d}x}{x} \\\\  & =3{\\int }_{1}^{4}\\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =3{\\int }_{1}^{4}{u}^{-1/2}\\,\\text{d}u \\\\  & =3\\cdot {\\frac{{u}^{1/2}}{1/2}|}_{1}^{4} \\\\  & =6\\cdot {\\sqrt{u}|}_{1}^{4} \\\\  & =6(\\sqrt{4}-\\sqrt{1}) \\\\  & =6\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186318324 :knowledge-point/_questions [{:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7271e71d-2629-5a11-aa82-4f5b8f2b8fed" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln(4)" :db/id #edb/ref 17592186318326} {:answer/id #uuid "66c22726-e46d-59f5-8fec-795ce289f6e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln(3)" :db/id #edb/ref 17592186318327}] :answer-field/correct {:answer/id #uuid "7271e71d-2629-5a11-aa82-4f5b8f2b8fed" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln(4)" :db/id #edb/ref 17592186318326} :answer-field/id #uuid "9153a0ca-7252-51c7-b4aa-13bf30f42249" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318325}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "220a21c5-edc9-50d7-beb8-7176d9aeea2c" :question/math-academy-id "q-351281" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{e/5}^{{e}^{4}/5}\\frac{1}{x\\operatorname{ln}⁡(5x)}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(5x).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{5x}\\cdot 5=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e/5$ | ${e}^{4}/5$ |\n| --- | --- | --- |\n| $u$ | $1$ | $4$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{e/5}^{{e}^{4}/5}\\frac{1}{x\\operatorname{ln}⁡(5x)}\\,\\text{d}x & ={\\int }_{e/5}^{{e}^{4}/5}\\frac{1}{\\operatorname{ln}⁡(5x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{1}^{4}\\frac{1}{u}\\,\\text{d}u \\\\  & =(\\operatorname{ln}⁡|u|){|}_{1}^{4} \\\\  & =\\operatorname{ln}⁡4-\\operatorname{ln}⁡1 \\\\  & =\\operatorname{ln}⁡4\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186318328 :knowledge-point/_questions [{:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "899119db-d562-5a6d-8ac9-b571343f0e01" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{ln}⁡3}{3}" :db/id #edb/ref 17592186318330} {:answer/id #uuid "96e46287-732b-573b-8d75-f314704c260a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}\\operatorname{ln}⁡3}{3}" :db/id #edb/ref 17592186318331} {:answer/id #uuid "8d55be4e-3140-5784-a41b-e679b2711a87" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\operatorname{ln}⁡3}{2}" :db/id #edb/ref 17592186318332} {:answer/id #uuid "d0b7053e-e628-5ffd-acda-3e32ea174868" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{ln}⁡2}{3}" :db/id #edb/ref 17592186318333} {:answer/id #uuid "57cb3af6-ccea-5f2a-8da0-fc3e91eb93cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{ln}⁡3}{2}" :db/id #edb/ref 17592186318334}] :answer-field/correct {:answer/id #uuid "57cb3af6-ccea-5f2a-8da0-fc3e91eb93cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{ln}⁡3}{2}" :db/id #edb/ref 17592186318334} :answer-field/id #uuid "186b9995-d88d-5390-82d5-32bb3ce4e8e7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318329}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "37924b10-5b5a-502d-94ce-fce472a24f69" :question/math-academy-id "q-49606" :question/problem "What is the value of ${\\int }_{e}^{{e}^{3}}\\frac{\\sqrt{3}}{2x\\operatorname{ln}⁡x}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e$ | ${e}^{3}$ |\n| --- | --- | --- |\n| $u$ | $1$ | $3$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{e}^{{e}^{3}}\\frac{\\sqrt{3}}{2x\\operatorname{ln}⁡x}\\,\\text{d}x & =\\frac{\\sqrt{3}}{2}{\\int }_{e}^{{e}^{3}}\\frac{1}{\\operatorname{ln}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{\\sqrt{3}}{2}{\\int }_{1}^{3}\\frac{1}{u}\\cdot \\text{d}u \\\\  & =\\frac{\\sqrt{3}}{2}(\\operatorname{ln}⁡|u|){|}_{1}^{3} \\\\  & =\\frac{\\sqrt{3}}{2}(\\operatorname{ln}⁡3-\\operatorname{ln}⁡1) \\\\  & =\\frac{\\sqrt{3}\\operatorname{ln}⁡3}{2}\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186310024 :knowledge-point/_questions [{:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "493c9322-c0bc-5363-b2ea-5b184a5fbf41" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2" :db/id #edb/ref 17592186310026} {:answer/id #uuid "f72a3c11-24c3-561b-a129-b0e453f71d8d" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186310027} {:answer/id #uuid "b4327b80-2c9f-55f1-9ac9-dd122c8a022b" :answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186310028} {:answer/id #uuid "53d2ca6d-854a-537c-947f-a62b810b5184" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡2" :db/id #edb/ref 17592186310029} {:answer/id #uuid "611dd5b8-7339-5783-8214-a4a1ad37cc20" :answer/type {:db/ident :answer.type/math} :answer/value "{ln}^{2}⁡2" :db/id #edb/ref 17592186310030}] :answer-field/correct {:answer/id #uuid "53d2ca6d-854a-537c-947f-a62b810b5184" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡2" :db/id #edb/ref 17592186310029} :answer-field/id #uuid "299d34e5-7bc9-51d4-a66a-e7b23b846253" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186310025}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "84759818-b43c-5fd3-88c3-53455a0a478f" :question/math-academy-id "q-73653" :question/problem "What is the value of ${\\int }_{1}^{4}\\frac{4{log}_{4}⁡x}{x}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{4}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡4}\\,⟹\\,\\operatorname{ln}⁡4\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $4$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}\\frac{4{log}_{4}⁡x}{x}\\,\\text{d}x & =4{\\int }_{1}^{4}{log}_{4}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =4{\\int }_{0}^{1}u\\cdot \\operatorname{ln}⁡4\\,\\text{d}u \\\\  & =4\\operatorname{ln}⁡4{\\int }_{0}^{1}u\\,\\text{d}u \\\\  & =4\\operatorname{ln}⁡4\\cdot \\frac{{u}^{2}}{2}{|}_{0}^{1} \\\\  & =2\\operatorname{ln}⁡4\\cdot (1-0) \\\\  & =2\\operatorname{ln}⁡4 \\\\  & =4\\operatorname{ln}⁡2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186318335 :knowledge-point/_questions [{:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35e12ae1-2e5c-5d2e-9a37-db73c13daa7f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡8" :db/id #edb/ref 17592186318337} {:answer/id #uuid "637b761f-22f2-52e9-baed-bd5e0c990cdd" :answer/type {:db/ident :answer.type/math} :answer/value "(1-\\sqrt{2})\\operatorname{ln}⁡8" :db/id #edb/ref 17592186318338} {:answer/id #uuid "94ee1560-69d8-5b8b-9ca1-dc01b4d639d2" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}\\,\\operatorname{ln}⁡8" :db/id #edb/ref 17592186318339} {:answer/id #uuid "8fb3312d-89b5-54c6-a68b-89c09328c9d9" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{\\operatorname{ln}⁡8}" :db/id #edb/ref 17592186318340} {:answer/id #uuid "d85fc40f-17fd-58e5-94d0-c242a5e5cdb3" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\sqrt{2}-1)\\operatorname{ln}⁡8" :db/id #edb/ref 17592186318341}] :answer-field/correct {:answer/id #uuid "d85fc40f-17fd-58e5-94d0-c242a5e5cdb3" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\sqrt{2}-1)\\operatorname{ln}⁡8" :db/id #edb/ref 17592186318341} :answer-field/id #uuid "95dcee1d-6462-5c06-a38c-3a7faf7e8cf5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318336}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "59278fd6-52f5-5feb-8c48-613225fb6969" :question/math-academy-id "q-73656" :question/problem "What is the value of ${\\int }_{8}^{64}\\frac{1}{x\\sqrt{{log}_{8}⁡x}}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{8}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡8}\\,⟹\\,\\operatorname{ln}⁡8\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $8$ | $64$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{8}^{64}\\frac{1}{x\\sqrt{{log}_{8}⁡x}}\\,\\text{d}x & ={\\int }_{8}^{64}\\frac{1}{\\sqrt{{log}_{8}⁡x}}\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{1}^{2}\\frac{1}{\\sqrt{u}}\\cdot \\operatorname{ln}⁡8\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡8{\\int }_{1}^{2}\\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡8(2\\sqrt{u}){|}_{1}^{2} \\\\  & =2\\operatorname{ln}⁡8(\\sqrt{2}-\\sqrt{1}) \\\\  & =2(\\sqrt{2}-1)\\operatorname{ln}⁡8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186101444 :knowledge-point/_questions [{:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cfd5401-f59b-5d26-9381-903e7a100fe7" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 7\\ln \\mid \\log_{7} (4x) \\mid + C" :db/id #edb/ref 17592186100261} {:answer/id #uuid "d26d1f8b-e0aa-5d92-9ab9-24d9e216087f" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln x^{7}\\ln \\mid \\log_{7} (4x) \\mid + C" :db/id #edb/ref 17592186100262} {:answer/id #uuid "fcdc0d7c-75d9-5a6a-8e71-b2ed1b6d870f" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 4\\ln \\mid \\log_{7} x \\mid + C" :db/id #edb/ref 17592186100263} {:answer/id #uuid "561a7dca-9374-553b-824c-74d78cf70c81" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\ln 7}{7}\\ln \\mid \\log_{7} (4x) \\mid + C" :db/id #edb/ref 17592186100264} {:answer/id #uuid "62e4e20e-edf2-5d23-8879-c22c3dd0d4a3" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ln 7\\ln \\mid \\log_{7} (x^{4}) \\mid + C" :db/id #edb/ref 17592186100265}] :answer-field/correct {:answer/id #uuid "8cfd5401-f59b-5d26-9381-903e7a100fe7" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 7\\ln \\mid \\log_{7} (4x) \\mid + C" :db/id #edb/ref 17592186100261} :answer-field/id #uuid "10d45f02-34c8-55d7-aaa6-ca2883b6ab73" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186100260}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "15940cb6-48bb-51bb-99eb-a693e64f76c1" :question/math-academy-id "q-73659" :question/problem "$\\int \\frac{1}{x{log}_{7}⁡(4x)}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{7}⁡(4x).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡7}\\,⟹\\,\\operatorname{ln}⁡7\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{x{log}_{7}⁡(4x)}\\,\\text{d}x & =\\int \\frac{1}{{log}_{7}⁡(4x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡7\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡7\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =\\operatorname{ln}⁡7\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡7\\operatorname{ln}⁡|{log}_{7}⁡(4x)|+C\\end{aligned}\n$$"}]}
