9028/edb-import/verification.json"} {"question" "q-13807" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{1}{2}{ln}^{2}⁡({x}^{2})+C"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009028/state.json" "file_sha256" "e0fe9e8494485603aa2f1a0d0e2a29d59ad83a7b6f14b22479a6b3e533506f8e" "basis" 1138 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009028/edb-import/verification.json"} {"question" "q-13807" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{1}{6}{ln}^{2}⁡({x}^{2})+C"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009028/state.json" "file_sha256" "e0fe9e8494485603aa2f1a0d0e2a29d59ad83a7b6f14b22479a6b3e533506f8e" "basis" 1138 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009028/edb-import/verification.json"} {"question" "q-13807" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{12}{ln}^{2}⁡({x}^{2})+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009028/state.json" "file_sha256" "e0fe9e8494485603aa2f1a0d0e2a29d59ad83a7b6f14b22479a6b3e533506f8e" "basis" 1138 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009028/edb-import/verification.json"} {"question" "q-13803" "field" nil "attribute" "question/problem" "value" "Calculate the integral $\\int \\frac{\\operatorname{ln}⁡x}{2x}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009028/state.json" "file_sha256" "e0fe9e8494485603aa2f1a0d0e2a29d59ad83a7b6f14b22479a6b3e533506f8e" "basis" 1138 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009028/edb-import/verification.json"} {"question" "q-13803" "field" nil "attribute" "question/worked-solution" "value" "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{ln}⁡x}{2x}\\,\\text{d}x & =\\frac{1}{2}\\int \\operatorname{ln}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{2}\\int u\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\frac{1}{4}{u}^{2}+C \\\\  & =\\frac{1}{4}{ln}^{2}⁡x+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009028/state.json" "file_sha256" "e0fe9e8494485603aa2f1a0d0e2a29d59ad83a7b6f14b22479a6b3e533506f8e" "basis" 1138 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009028/edb-import/verification.json"} {"question" "q-13803" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009028/activity-metadata.json" "file_sha256" "222fe31908a93b53786ab4aa511ab10b01045386db1a176ffaba2a0d129ce6d5" "basis" 1138 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009028/edb-import/verification.json"} {"question" "q-13803" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009028/state.json" "file_sha256" "e0fe9e8494485603aa2f1a0d0e2a29d59ad83a7b6f14b22479a6b3e533506f8e" "basis" 1138 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009028/edb-import/verification.json"} {"question" "q-13803" "field" "selection" "attribute" "answer/value" "value" [: