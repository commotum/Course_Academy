#{[{:db/id #edb/ref 17592186100521 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "41b7d83f-3b9b-556c-9e49-13df9c3b597e" :knowledge-point/title "Integrating Functions Containing the Natural Logarithm"}] :question/id #uuid "8ea17e06-1248-510c-9e71-c57da0cb0d02" :question/math-academy-id "e-14405" :question/problem "Calculate $\\displaystyle{\\int \\dfrac{3}{x \\sqrt{\\ln x}} \\, \\textrm{d}x }.$" :question/worked-solution "Let's set $u = \\ln x.$ Then, we have\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= \\dfrac 1 x\\quad\\Longrightarrow\\quad \\textrm{d}u=\\dfrac 1 x\\,{\\textrm{d}x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{3}{x\\sqrt{\\operatorname{ln}⁡x}}\\,\\text{d}x & =3\\int \\frac{1}{\\sqrt{\\operatorname{ln}⁡x}}\\cdot \\frac{1}{x}\\,\\text{d}x \\\\  & =3\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =3\\int {u}^{-1/2}\\,\\text{d}u \\\\  & =3\\cdot 2{u}^{1/2}+C \\\\  & =6\\sqrt{u}+C \\\\  & =6\\sqrt{\\operatorname{ln}⁡x}+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186100522 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/id #uuid "1579f932-6e7f-5daa-b001-54a9f6c236ad" :question/math-academy-id "e-14406" :question/problem "Calculate the integral $\\displaystyle \\int \\dfrac{\\log^2_3 x }{x} \\,\\textrm d x.$" :question/worked-solution "Let's rewrite our integral as\n\n$$\n\\int \\dfrac{(\\log_3 x)^2 }{x} \\,\\textrm d x.\n$$\n\nLet $u=\\log_3 x.$ Differentiating, we get\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = \\dfrac{1}{x\\ln 3}\\quad\\Longrightarrow\\quad\\ln 3\\,\\textrm d u = \\dfrac 1 x \\textrm d x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{({log}_{3}⁡x)^{2}}{x}\\,\\text{d}x & =\\int ({log}_{3}⁡x)^{2}\\cdot \\frac{1}{x}\\,\\text{d}x \\\\  & =\\int {u}^{2}\\cdot \\operatorname{ln}⁡3\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡3\\int {u}^{2}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡3\\cdot \\frac{1}{3}{u}^{3}+C \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡3({log}_{3}⁡x)^{3}+C \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡3{log}_{3}^{3}⁡x+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186100523 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05" :knowledge-point/title "Evaluating Definite Integrals"}] :question/id #uuid "d2f49acf-ed91-510d-a0f1-41c50eeef9e7" :question/math-academy-id "e-14422" :question/problem "Evaluate $\\displaystyle{\\int_{e}^{e^2} \\dfrac{\\ln^2 x}{x}\\,\\textrm{d}x}.$" :question/worked-solution "Let's set $u = \\ln x.$ Then, we have\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= \\dfrac 1 x\\quad\\Longrightarrow\\quad \\textrm{d}u=\\dfrac 1 x\\,{\\textrm{d}x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e$ | $e^2$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\eqalign{\n\t\\int_{e}^{e^2} \\dfrac{\\ln^2 x}{x}\\,\\textrm{d}x\n&= \\int_{e}^{e^2} (\\ln x)^2\\cdot \\dfrac{\\textrm{d}x}{x}\\[5pt]\n&=\\int_{1}^{2} u^2\\,\\textrm{d}u\\[5pt]\n&=\\left.\\dfrac13u^{3}\\right|_{1}^{2}\\[5pt] \n&=\\dfrac{1}{3}\\left(2^3-1^3 \\right)\\[5pt]\n&=\\dfrac{1}{3}\\left(8-1 \\right)\\[5pt]\n&=\\dfrac{7}{3}\t\t\n\n\t}\n$$"}] [{:db/id #edb/ref 17592186302152 :knowledge-point/_questions [{:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10c430ce-b4c9-5ad6-92d3-a2313924c0a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡6}{3}\\cdot {log}_{6}^{3}⁡x+C" :db/id #edb/ref 17592186302154} {:answer/id #uuid "0f3984ae-c6b2-5233-9ae5-32d45bf4dadb" :answer/type {:db/ident :answer.type/math} :answer/value "{log}_{6}^{3}⁡x+C" :db/id #edb/ref 17592186302155} {:answer/id #uuid "e33122d2-74e0-56a2-8a6b-f7eaa2f44046" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡6\\cdot {log}_{6}^{3}⁡x+C" :db/id #edb/ref 17592186302156} {:answer/id #uuid "895c6afb-61b9-5702-8402-056efbb6b7e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡6\\cdot {log}_{6}^{3}⁡x+C" :db/id #edb/ref 17592186302157} {:answer/id #uuid "3b971759-66f9-5d4a-83c2-d33e420c3e05" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡6\\cdot {log}_{6}⁡x+C" :db/id #edb/ref 17592186302158}] :answer-field/correct {:answer/id #uuid "895c6afb-61b9-5702-8402-056efbb6b7e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡6\\cdot {log}_{6}^{3}⁡x+C" :db/id #edb/ref 17592186302157} :answer-field/id #uuid "0e9fde92-799f-54cb-a163-c8b63400aebb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186302153}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "06296c2e-56ff-57f8-948e-fc4b28498e50" :question/math-academy-id "q-114020" :question/problem "$\\int \\frac{3{log}_{6}^{2}⁡x}{x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{6}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡6}\\,⟹\\,\\operatorname{ln}⁡6\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{3{log}_{6}^{2}⁡x}{x}\\,\\text{d}x & =3\\int ({log}_{6}⁡x)^{2}\\cdot \\frac{\\text{d}x}{x} \\\\  & =3\\int {u}^{2}\\cdot \\operatorname{ln}⁡6\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡6\\int {u}^{2}\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡6\\cdot \\frac{{u}^{3}}{3}+C \\\\  & =\\operatorname{ln}⁡6\\cdot {log}_{6}^{3}⁡x+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186302173 :knowledge-point/_questions [{:knowledge-point/id #uuid "41b7d83f-3b9b-556c-9e49-13df9c3b597e" :knowledge-point/title "Integrating Functions Containing the Natural Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d2b2e3d-82cd-5211-9fd1-82df01b15fb8" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|\\operatorname{ln}⁡(2x)|+C" :db/id #edb/ref 17592186302175} {:answer/id #uuid "c4ed3294-f23b-5a37-812b-3200429d67a0" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡|\\operatorname{ln}⁡(4x)|+C" :db/id #edb/ref 17592186302176} {:answer/id #uuid "a4ea221c-eb86-54f2-975b-1fe1e977f711" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡|\\operatorname{ln}⁡x|+C" :db/id #edb/ref 17592186302177} {:answer/id #uuid "8cea49ee-13f7-504a-a8de-361c53d4a306" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡|\\operatorname{ln}⁡(2x)|+C" :db/id #edb/ref 17592186302178} {:answer/id #uuid "b190b52b-d15a-56a3-8ef9-330d4f32c85f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡|\\operatorname{ln}⁡(4x)|+C" :db/id #edb/ref 17592186302179}] :answer-field/correct {:answer/id #uuid "c4ed3294-f23b-5a37-812b-3200429d67a0" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡|\\operatorname{ln}⁡(4x)|+C" :db/id #edb/ref 17592186302176} :answer-field/id #uuid "723f76f6-078b-5048-9166-e625436b5904" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186302174}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "640d756b-d216-53d7-813b-ffeca4e75575" :question/math-academy-id "q-210746" :question/problem "Calculate the integral $\\int \\frac{2}{x\\operatorname{ln}⁡(4x)}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(4x).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{4x}\\cdot 4\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{2}{x\\operatorname{ln}⁡(4x)}\\,\\text{d}x & =2\\int \\frac{1}{\\operatorname{ln}⁡(4x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =2\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =2\\operatorname{ln}⁡|u|+C \\\\  & =2\\operatorname{ln}⁡|\\operatorname{ln}⁡(4x)|+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292394 :knowledge-point/_questions [{:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd965fb2-1789-5964-8ef8-b488cf979b3c" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3\\operatorname{ln}⁡|{log}_{5}⁡x|+C" :db/id #edb/ref 17592186292396} {:answer/id #uuid "11533f68-307b-5bc7-8f46-6fd6b5af0afb" :answer/type {:db/ident :answer.type/math} :answer/value "x\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡({x}^{3})|+C" :db/id #edb/ref 17592186292397} {:answer/id #uuid "ca647ce4-4cc7-5a3d-8e6e-97a2835d48b6" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186292398} {:answer/id #uuid "bb7c9319-18ca-5599-ad32-86a9e0eccd17" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡5}{5}\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186292399} {:answer/id #uuid "739228e8-510e-564d-8a7a-85f36da92739" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡({x}^{5})\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186292400}] :answer-field/correct {:answer/id #uuid "ca647ce4-4cc7-5a3d-8e6e-97a2835d48b6" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186292398} :answer-field/id #uuid "570a9286-b9a9-5ea2-b5a1-4a1b26015b22" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292395}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "de056453-dea5-5366-891a-53b77baba193" :question/math-academy-id "q-31402" :question/problem "$\\int \\frac{2}{x{log}_{5}⁡(3x)}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{5}⁡(3x).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡5}\\,⟹\\,\\operatorname{ln}⁡5\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{2}{x{log}_{5}⁡(3x)}\\,\\text{d}x & =2\\int \\frac{1}{{log}_{5}⁡(3x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =2\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡5\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡5\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =2\\operatorname{ln}⁡5\\operatorname{ln}⁡|u|+C \\\\  & =2\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186101444 :knowledge-point/_questions [{:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cfd5401-f59b-5d26-9381-903e7a100fe7" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 7\\ln \\mid \\log_{7} (4x) \\mid + C" :db/id #edb/ref 17592186100261} {:answer/id #uuid "d26d1f8b-e0aa-5d92-9ab9-24d9e216087f" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln x^{7}\\ln \\mid \\log_{7} (4x) \\mid + C" :db/id #edb/ref 17592186100262} {:answer/id #uuid "fcdc0d7c-75d9-5a6a-8e71-b2ed1b6d870f" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 4\\ln \\mid \\log_{7} x \\mid + C" :db/id #edb/ref 17592186100263} {:answer/id #uuid "561a7dca-9374-553b-824c-74d78cf70c81" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\ln 7}{7}\\ln \\mid \\log_{7} (4x) \\mid + C" :db/id #edb/ref 17592186100264} {:answer/id #uuid "62e4e20e-edf2-5d23-8879-c22c3dd0d4a3" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ln 7\\ln \\mid \\log_{7} (x^{4}) \\mid + C" :db/id #edb/ref 17592186100265}] :answer-field/correct {:answer/id #uuid "8cfd5401-f59b-5d26-9381-903e7a100fe7" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 7\\ln \\mid \\log_{7} (4x) \\mid + C" :db/id #edb/ref 17592186100261} :answer-field/id #uuid "10d45f02-34c8-55d7-aaa6-ca2883b6ab73" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186100260}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "15940cb6-48bb-51bb-99eb-a693e64f76c1" :question/math-academy-id "q-73659" :question/problem "$\\int \\frac{1}{x{log}_{7}⁡(4x)}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{7}⁡(4x).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡7}\\,⟹\\,\\operatorname{ln}⁡7\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{x{log}_{7}⁡(4x)}\\,\\text{d}x & =\\int \\frac{1}{{log}_{7}⁡(4x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡7\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡7\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =\\operatorname{ln}⁡7\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡7\\operatorname{ln}⁡|{log}_{7}⁡(4x)|+C\\end{aligned}\n$$"}]}
