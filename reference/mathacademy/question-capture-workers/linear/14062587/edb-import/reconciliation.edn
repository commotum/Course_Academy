93312b68153ed88582d196e9a43e9bc68dac7e9916cc5e5587c696eb" "basis" 1144 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009909/edb-import/verification.json"} {"question" "q-162208" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "The origin $O$ of the coordinate system"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009909/state.json" "file_sha256" "7e9f67c493312b68153ed88582d196e9a43e9bc68dac7e9916cc5e5587c696eb" "basis" 1144 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009909/edb-import/verification.json"} {"question" "q-162208" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "A quadrilateral"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009909/state.json" "file_sha256" "7e9f67c493312b68153ed88582d196e9a43e9bc68dac7e9916cc5e5587c696eb" "basis" 1144 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009909/edb-import/verification.json"} {"question" "q-96856" "field" nil "attribute" "question/problem" "value" "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}-1 & 2 \\\\ 2 & -4\\end{aligned}].\n$$\n\nA triangle $S$ has vertices at $(0,-1),(1,1),$ and $(3,2).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the action of $T?$\n\n- $(-1,4)$\n- $(-2,4)$\n- $(1,-3)$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/state.json" "file_sha256" "827e2d0c67871315f13e9696a969ecd768ed6615275885cde1daeb05656b49d3" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-96856" "field" nil "attribute" "question/worked-solution" "value" "To find the image of $S$ under the action of $T$, we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\nX=[\\begin{aligned}0 & 1 & 3 \\\\ -1 & 1 & 2\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}-1 & 2 \\\\ 2 & -4\\end{aligned}][\\begin{aligned}0 & 1 & 3 \\\\ -1 & 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 1 & 1 \\\\ 4 & -2 & -2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are  $(-2,4)$, and $(1,-2).$ \n\nSo, the correct answer is \" II only.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/state.json" "file_sha256" "827e2d0c67871315f13e9696a969ecd768ed6615275885cde1daeb05656b49d3" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-96856" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/activity-metadata.json" "file_sha256" "06739ce6498263f9c042f447fdb5e02ed1b51689c86067f26597e2e4e241dcd8" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-96856" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/state.json" "file_sha256" "827e2d0c67871315f13e9696a969ecd768ed6615275885cde1daeb05656b49d3" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-96856" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "I and III only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/state.json" "file_sha256" "827e2d0c67871315f13e9696a969ecd768ed6615275885cde1daeb05656b49d3" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-96856" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "I only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/state.json" "file_sha256" "827e2d0c67871315f13e9696a969ecd768ed6615275885cde1daeb05656b49d3" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-96856" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "II and III only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/state.json" "file_sha256" "827e2d0c67871315f13e9696a969ecd768ed6615275885cde1daeb05656b49d3" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-96856" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "II only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/state.json" "file_sha256" "827e2d0c67871315f13e9696a969ecd768ed6615275885cde1daeb