y/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-21061" "field" nil "attribute" "question/worked-solution" "value" "To find the image of the triangle under the action of $T$, we first create a matrix $X$ containing all of the vertices of the triangle:\n\n$$\nX=[\\begin{aligned}0 & 2 & 1 \\\\ 1 & 1 & 2\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}1 & -1 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}0 & 2 & 1 \\\\ 1 & 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 1 & -1 \\\\ 1 & -1 & 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the image's vertices are $(-1,1)$, $(1,-1),$ $(-1,1).$ Notice that all three points lie on the same line.\n\nSo, the image of our triangle under the action of $T$ is as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/assets/2f8d6ec6c9a71e61180ad04c25d623c40dadfdd623e1e2eaa8458915bcaca2f8.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/state.json" "file_sha256" "827e2d0c67871315f13e9696a969ecd768ed6615275885cde1daeb05656b49d3" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-21061" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/activity-metadata.json" "file_sha256" "06739ce6498263f9c042f447fdb5e02ed1b51689c86067f26597e2e4e241dcd8" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-21061" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/state.json" "file_sha256" "827e2d0c67871315f13e9696a969ecd768ed6615275885cde1daeb05656b49d3" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-21063" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/assets/6501b1a7e9429c786905c11835410111c32ac0337f1ba63bff130d327350316c.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}2 & 4 \\\\ 1 & 2\\end{aligned}]\n$$\n\nWhich of the following is the image of the triangle shown above under the action of $T?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/state.json" "file_sha256" "827e2d0c67871315f13e9696a969ecd768ed6615275885cde1daeb05656b49d3" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-21063" "field" nil "attribute" "question/worked-solution" "value" "To find the image of the triangle under the action of $T$, we first create a matrix $X$ containing all of the vertices of the triangle:\n\n$$\nX=[\\begin{aligned}1 & 2 & 1 \\\\ 1 & 1 & 2\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}2 & 4 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}1 & 2 & 1 \\\\ 1 & 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}6 & 8 & 10 \\\\ 3 & 4 & 5\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the image's vertices are $(6,3)$, $(8,4)$ and $(10,5).$ Notice that all three points lie on the same line.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/assets/a91af151d3dc0e48aef0eef58012f6c9f72aaff02aafae2d55fe0714c29c96e3.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/state.json" "file_sha256" "827e2d0c67871315f13e9696a969ecd768ed6615275885cde1daeb05656b49d3" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-21063" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/activity-metadata.json" "file_sha256" "06739ce6498263f9c042f447fdb5e02ed1b51689c86067f26597e2e4e241dcd8" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-21063" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/state.json" "file_sha256" "827e2d0c67871315f13e9696a969ecd768ed6615275885cde1daeb05656b49d3" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-162202" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/assets/8978d3bb02b4032b6e3a8b4a85878db647eb8323ac5b0423b5a9a6fab121c7e7.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}1 & 4 \\\\ -2 & -8\\end{aligned}].\n$$\n\nWhat would be the image of the triangle shown above under the action of $T?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/state.json" "file_sha256" "827e2d0c67871315f13e9696a969ecd768ed6615275885cde1daeb05656b49d3" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-162202" "field" nil "attribute" "question/worked-solution" "value" "Recall that for any linear transformation $T$ with associated $2\\times 2$ matrix $T,$ we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., $det(T)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., $det(T)=0,$ we have two additional subcases:\n\n- If $T$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $T$ is the zero matrix, then the image of a two-dimensional object is the point $(0,0),$ the origin of the coordinate system.\n\nWith that in mind, let's examine our transformation.\n\nComputing the determinant of $T,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =|\\begin{aligned}1 & 4 \\\\ -2 & -8\\end{aligned}| \\\\  & =1\\cdot (-8)-4\\cdot (-2) \\\\  & =0.\\end{aligned}\n$$\n\nSo, we have a singular nonzero matrix. Therefore, the image of the triangle under the action of $T$ is a line segment." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/state.json" "file_sha256" "827e2d0c67871315f13e9696a969ecd768ed6615275885cde1daeb05656b49d3" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-162202" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/activity-metadata.json" "file_sha256" "06739ce6498263f9c042f447fdb5e02ed1b51689c86067f26597e2e4e241dcd8" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-162202" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/state.json" "file_sha256" "827e2d0c67871315f13e9696a969ecd768ed6615275885cde1daeb05656b49d3" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-162202" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "A line segment"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/state.json" "file_sha256" "827e2d0c67871315f13e9696a969ecd768ed6615275885cde1daeb05656b49d3" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-162202" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "A point, different from the origin"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/state.json" "file_sha256" "827e2d0c67871315f13e9696a969ecd768ed6615275885cde1daeb05656b49d3" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-162202" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "A rectangle"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/state.json" "file_sha256" "827e2d0c67871315f13e9696a969ecd768ed6615275885cde1daeb05656b49d3" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-162202" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "A triangle"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/state.json" "file_sha256" "827e2d0c67871315f13e9696a969ecd768ed6615275885cde1daeb05656b49d3" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-162202" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "The origin $O$ of the coordinate system"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/state.json" "file_sha256" "827e2d0c67871315f13e9696a969ecd768ed6615275885cde1daeb05656b49d3" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-162202" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "A line segment"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/state.json" "file_sha256" "827e2d0c67871315f13e9696a969ecd768ed6615275885cde1daeb05656b49d3" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-162207" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/assets/57948af956c9b83ed944fafc26e81a5c003401f753bc520e088ffdbd71915c3a.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}2 & -1 \\\\ 3 & -2\\end{aligned}].\n$$\n\nWhat would be the image of the triangle shown above under the action of $T?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/state.json" "file_sha256" "827e2d0c67871315f13e9696a969ecd768ed6615275885cde1daeb05656b49d3" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-162207" "field" nil "attribute" "question/worked-solution" "value" "Recall that for any linear transformation $T$ with associated $2\\times 2$ matrix $T,$ we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., $det(T)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., $det(T)=0,$ we have two additional subcases:\n\n- If $T$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $T$ is the zero matrix, then the image of a two-dimensional object is the point $(0,0),$ the origin of the coordinate system.\n\nWith that in mind, let's examine our transformation.\n\nComputing the determinant of $T,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =|\\begin{aligned}2 & -1 \\\\ 3 & -2\\end{aligned}| \\\\  & =2\\cdot (-2)-(-1)\\cdot 3 \\\\  & =-1.\\end{aligned}\n$$\n\nSo, we have a nonsingular matrix. Therefore, the image of our object under the action of  $T$ is a triangle." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/state.json" "file_sha256" "827e2d0c67871315f13e9696a969ecd768ed6615275885cde1daeb05656b49d3" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-162207" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/activity-metadata.json" "file_sha256" "06739ce6498263f9c042f447fdb5e02ed1b51689c86067f26597e2e4e241dcd8" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-162207" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/state.json" "file_sha256" "827e2d0c67871315f13e9696a969ecd768ed6615275885cde1daeb05656b49d3" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-162207" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "A line segment"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/state.json" "file_sha256" "827e2d0c67871315f13e9696a969ecd768ed6615275885cde1daeb05656b49d3" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-162207" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "A point, different from the origin"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/state.json" "file_sha256" "827e2d0c67871315f13e9696a969ecd768ed6615275885cde1daeb05656b49d3" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-162207" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "A rectangle"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/state.json" "file_sha256" "827e2d0c67871315f13e9696a969ecd768ed6615275885cde1daeb05656b49d3" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-162207" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "A triangle"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/state.json" "file_sha256" "827e2d0c67871315f13e9696a969ecd768ed6615275885cde1daeb05656b49d3" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "q-162207" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "The origin $O$ of the coordinate system"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/state.json" "file_sha256" "827e2d0c67871315f13e9696a969ecd768ed6615275885cde1daeb05656b49d3" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "e-12423" "field" nil "attribute" "question/problem" "value" "Consider the linear transformation $\\mathbf T$ with matrix representation $T,$ given by\n\n$$\n[\\begin{aligned}2 & 0 \\\\ 0 & 0\\end{aligned}]\n$$\n\nA triangle $S$ has vertices at $(-1,2), (0,1)$ and $(1,1).$ Which of the following are coordinates of the vertices of $S',$ the image of $S$ under the action of $\\mathbf T?$\n\n- $(-2,0)$\n\n- $(0,0)$\n\n- $(2,0)$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/example-12423.json" "file_sha256" "b47ae757f74c19467edaf19071d8ea9d8df05f6c4559a55bdf0ceb86ccfadf8c" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "e-12423" "field" nil "attribute" "question/worked-solution" "value" "To find the image of $S$ under the action of $\\mathbf T$, we first create a matrix $X$ containing all of the vertices of $S\\mathbin{:}$\n\n$$\n[\\begin{aligned}-1 & 0 & 1 \\\\ 2 & 1 & 1\\end{aligned}]\n$$\n\nNow, we compute the image of $X$ under $\\mathbf T$ by calculating the matrix product $TX\\mathbin{:}$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}2 & 0 \\\\ 0 & 0\\end{aligned}][\\begin{aligned}-1 & 0 & 1 \\\\ 2 & 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 0 & 2 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of $S'$ are $(-2,0),$ $(0,0),$ and $(2,0).$\n\nSo, the correct answer is \"I, II,  and III.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/example-12423.json" "file_sha256" "b47ae757f74c19467edaf19071d8ea9d8df05f6c4559a55bdf0ceb86ccfadf8c" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "e-12424" "field" nil "attribute" "question/problem" "value" "Consider the linear transformation $\\mathbf T$ with matrix representation $T,$ given by\n\n$$\n[\\begin{aligned}3 & -2 \\\\ -6 & 4\\end{aligned}]\n$$\n\n  Find the image of the triangle shown below under the action of $\\mathbf T.$ \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/assets/853fd7d5c09944a5bacd0c2b3453504f3fa1eea9d8d3b2c3bdd4f0f44889dc16.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/example-12424.json" "file_sha256" "505242ceb132a6166f805055058c2caff5fcc241cedbcecafa6c846e969f3c02" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "e-12424" "field" nil "attribute" "question/worked-solution" "value" "To find the image of the triangle under the action of $\\mathbf T$, we first create a matrix $X$ containing all of the vertices of the triangle:\n\n$$\n[\\begin{aligned}1 & 1 & 0 \\\\ 0 & 1 & 1\\end{aligned}]\n$$\n\nNow, we compute the image of $X$ under the action of $\\mathbf T$ by calculating the matrix product $TX\\mathbin{:}$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}3 & -2 \\\\ -6 & 4\\end{aligned}][\\begin{aligned}1 & 1 & 0 \\\\ 0 & 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 1 & -2 \\\\ -6 & -2 & 4\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the image's vertices are $(3,-6), (1,-2),$ and $(-2,4).$  Notice that all three points lie on the same line.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/assets/3fd1073b2eaa5aa9c21e537fcc4dc6cf538ab2992c0732f64da50dbcb63d8fd4.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/example-12424.json" "file_sha256" "505242ceb132a6166f805055058c2caff5fcc241cedbcecafa6c846e969f3c02" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "e-12438" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/assets/89efcd0ecb51dac08a1102c5a347eea3459f7209de7cbac0a88b192259ca3b7e.png)\n\nConsider the linear transformation $\\mathbf T$ with matrix representation $T,$ given by\n\n$$\n[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]\n$$\n\nWhat would be the image of the triangle shown above under the action of $\\mathbf{T}?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/example-12438.json" "file_sha256" "fc663d938c18de66d793a86f74fb5b9448b2498229a14e33967742899646b66b" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"} {"question" "e-12438" "field" nil "attribute" "question/worked-solution" "value" "Recall that for any linear transformation $\\mathbf{T}$ with associated $2 \\times 2$ matrix $T,$ we have one of the following three possibilities:\n\n- If $\\mathbf{T}$ is non-singular, i.e., $\\det(T) \\neq 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $\\mathbf{T}$ is singular, i.e., $\\det(T) = 0,$ we have two additional subcases:\n\n- If $T$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $T$ is the zero matrix, then the image of a two-dimensional object is the point $(0,0),$ the origin of the coordinate system.\n\nSince $T$ is the zero matrix, the image of our object under the action of $\\mathbf{T}$ is the origin." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/example-12438.json" "file_sha256" "fc663d938c18de66d793a86f74fb5b9448b2498229a14e33967742899646b66b" "basis" 1435 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/edb-import/verification.json"}] "sources" [{"question" "q-96856" "field" nil "attribute" "question/problem" "value" "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}-1 & 2 \\\\ 2 & -4\\end{aligned}].\n$$\n\nA triangle $S$ has vertices at $(0,-1),(1,1),$ and $(3,2).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the action of $T?$\n\n- $(-1,4)$\n- $(-2,4)$\n- $(1,-3)$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/state.json" "file_sha256" "588232c7f218147607b9501dd3f799f9943de144ca370b3952c8a5b0ca2399bc"} {"question" "q-96856" "field" nil "attribute" "question/worked-solution" "value" "To find the image of $S$ under the action of $T$, we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\nX=[\\begin{aligned}0 & 1 & 3 \\\\ -1 & 1 & 2\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}-1 & 2 \\\\ 2 & -4\\end{aligned}][\\begin{aligned}0 & 1 & 3 \\\\ -1 & 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 1 & 1 \\\\ 4 & -2 & -2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are  $(-2,4)$, and $(1,-2).$ \n\nSo, the correct answer is \" II only.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/state.json" "file_sha256" "588232c7f218147607b9501dd3f799f9943de144ca370b3952c8a5b0ca2399bc"} {"question" "q-96856" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/activity-metadata.json" "file_sha256" "41bb6ac81580a35044f519df3893ae599125755be510d24cfbe36d3329447b5e"} {"question" "q-96856" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/state.json" "file_sha256" "588232c7f218147607b9501dd3f799f9943de144ca370b3952c8a5b0ca2399bc"} {"question" "q-96856" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and III only"] ["text" "I only"] ["text" "II and III only"] ["text" "II only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/state.json" "file_sha256" "588232c7f218147607b9501dd3f799f9943de144ca370b3952c8a5b0ca2399bc"} {"question" "q-96856" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "II only"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/state.json" "file_sha256" "588232c7f218147607b9501dd3f799f9943de144ca370b3952c8a5b0ca2399bc"} {"question" "q-96858" "field" nil "attribute" "question/problem" "value" "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}-2 & -8 \\\\ 1 & 4\\end{aligned}].\n$$\n\nA triangle $S$ has vertices at $(0,1)$, $(2,1)$ and $(1,0).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the action of $T?$\n\n- $(-2,1)$\n- $(-8,4)$\n- $(3,6)$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/state.json" "file_sha256" "588232c7f218147607b9501dd3f799f9943de144ca370b3952c8a5b0ca2399bc"} {"question" "q-96858" "field" nil "attribute" "question/worked-solution" "value" "To find the image of $S$ under the action of $T$, we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\nX=[\\begin{aligned}0 & 2 & 1 \\\\ 1 & 1 & 0\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}-2 & -8 \\\\ 1 & 4\\end{aligned}][\\begin{aligned}0 & 2 & 1 \\\\ 1 & 1 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}-8 & -12 & -2 \\\\ 4 & 6 & 1\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(-8,4)$, $(-12,6)$ and $(-2,1).$ \n\nSo, the correct answer is \"I and II only.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/state.json" "file_sha256" "588232c7f218147607b9501dd3f799f9943de144ca370b3952c8a5b0ca2399bc"} {"question" "q-96858" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/activity-metadata.json" "file_sha256" "41bb6ac81580a35044f519df3893ae599125755be510d24cfbe36d3329447b5e"} {"question" "q-96858" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/state.json" "file_sha256" "588232c7f218147607b9501dd3f799f9943de144ca370b3952c8a5b0ca2399bc"} {"question" "q-96858" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I and III only"] ["text" "I only"] ["text" "II and III only"] ["text" "II only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/state.json" "file_sha256" "588232c7f218147607b9501dd3f799f9943de144ca370b3952c8a5b0ca2399bc"} {"question" "q-96858" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "I and II only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/state.json" "file_sha256" "588232c7f218147607b9501dd3f799f9943de144ca370b3952c8a5b0ca2399bc"} {"question" "q-96855" "field" nil "attribute" "question/problem" "value" "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}-4 & 2 \\\\ -8 & 4\\end{aligned}].\n$$\n\nA triangle $S$ has vertices at $(1,-1)$, $(1,0)$ and $(-2,1).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the action of $T?$ \n\n- $(10,20)$\n- $(4,-8)$\n- $(-6,6)$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/state.json" "file_sha256" "588232c7f218147607b9501dd3f799f9943de144ca370b3952c8a5b0ca2399bc"} {"question" "q-96855" "field" nil "attribute" "question/worked-solution" "value" "To find the image of $S$ under the action of $T$, we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\nX=[\\begin{aligned}1 & 1 & -2 \\\\ -1 & 0 & 1\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}-4 & 2 \\\\ -8 & 4\\end{aligned}][\\begin{aligned}1 & 1 & -2 \\\\ -1 & 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-6 & -4 & 10 \\\\ -12 & -8 & 20\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(-6,-12)$, $(-4,-8)$ and $(10,20).$ \n\nSo, the correct answer is \"I  only.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/state.json" "file_sha256" "588232c7f218147607b9501dd3f799f9943de144ca370b3952c8a5b0ca2399bc"} {"question" "q-96855" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/activity-metadata.json" "file_sha256" "41bb6ac81580a35044f519df3893ae599125755be510d24cfbe36d3329447b5e"} {"question" "q-96855" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/state.json" "file_sha256" "588232c7f218147607b9501dd3f799f9943de144ca370b3952c8a5b0ca2399bc"} {"question" "q-96855" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I and III only"] ["text" "I only"] ["text" "II and III only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/state.json" "file_sha256" "588232c7f218147607b9501dd3f799f9943de144ca370b3952c8a5b0ca2399bc"} {"question" "q-96855" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "I only"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/state.json" "file_sha256" "588232c7f218147607b9501dd3f799f9943de144ca370b3952c8a5b0ca2399bc"} {"question" "q-147666" "field" nil "attribute" "question/problem" "value" "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}3 & -2 \\\\ -6 & 4\\end{aligned}].\n$$\n\nA triangle $S$ has vertices at $(1,3)$, $(-2,0)$ and $(2,-1).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the action of $T?$\n\n- $(8,-16)$\n- $(-6,12)$\n- $(8,16)$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/state.json" "file_sha256" "588232c7f218147607b9501dd3f799f9943de144ca370b3952c8a5b0ca2399bc"} {"question" "q-147666" "field" nil "attribute" "question/worked-solution" "value" "To find the image of $S$ under the action of $T$, we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\nX=[\\begin{aligned}1 & -2 & 2 \\\\ 3 & 0 & -1\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}3 & -2 \\\\ -6 & 4\\end{aligned}][\\begin{aligned}1 & -2 & 2 \\\\ 3 & 0 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & -6 & 8 \\\\ 6 & 12 & -16\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(-3,6)$, $(-6,12)$ and $(8,-16).$ \n\nSo, the correct answer is \"I and II only.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/state.json" "file_sha256" "588232c7f218147607b9501dd3f799f9943de144ca370b3952c8a5b0ca2399bc"} {"question" "q-147666" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/activity-metadata.json" "file_sha256" "41bb6ac81580a35044f519df3893ae599125755be510d24cfbe36d3329447b5e"} {"question" "q-147666" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/state.json" "file_sha256" "588232c7f218147607b9501dd3f799f9943de144ca370b3952c8a5b0ca2399bc"} {"question" "q-147666" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I and III only"] ["text" "I only"] ["text" "II and III only"] ["text" "II only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/state.json" "file_sha256" "588232c7f218147607b9501dd3f799f9943de144ca370b3952c8a5b0ca2399bc"} {"question" "q-147666" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "I and II only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/state.json" "file_sha256" "588232c7f218147607b9501dd3f799f9943de144ca370b3952c8a5b0ca2399bc"} {"question" "q-21067" "field" nil "attribute" "question/problem" "value" "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}3 & 1 \\\\ 6 & 2\\end{aligned}].\n$$\n\nA triangle $S$ has vertices at $(-1,-1),(0,-1),$ and $(0,0).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the action of $T?$\n\n- $(4,-1)$\n- $(0,0)$\n- $(-4,-8)$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/state.json" "file_sha256" "588232c7f218147607b9501dd3f799f9943de144ca370b3952c8a5b0ca2399bc"} {"question" "q-21067" "field" nil "attribute" "question/worked-solution" "value" "To find the image of $S$ under the action of $T$, we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\nX=[\\begin{aligned}-1 & 0 & 0 \\\\ -1 & -1 & 0\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}3 & 1 \\\\ 6 & 2\\end{aligned}][\\begin{aligned}-1 & 0 & 0 \\\\ -1 & -1 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}-4 & -1 & 0 \\\\ -8 & -2 & 0\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(-4,-8),$ $(-1,-2)$, and $(0,0).$\n\nSo, the correct answer is \"II and III only.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/state.json" "file_sha256" "588232c7f218147607b9501dd3f799f9943de144ca370b3952c8a5b0ca2399bc"} {"question" "q-21067" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/activity-metadata.json" "file_sha256" "41bb6ac81580a35044f519df3893ae599125755be510d24cfbe36d3329447b5e"} {"question" "q-21067" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/state.json" "file_sha256" "588232c7f218147607b9501dd3f799f9943de144ca370b3952c8a5b0ca2399bc"} {"question" "q-21067" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and III only"] ["text" "I only"] ["text" "II and III only"] ["text" "II only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/state.json" "file_sha256" "588232c7f218147607b9501dd3f799f9943de144ca370b3952c8a5b0ca2399bc"} {"question" "q-21067" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "II and III only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/state.json" "file_sha256" "588232c7f218147607b9501dd3f799f9943de144ca370b3952c8a5b0ca2399bc"} {"question" "q-147611" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/assets/27c1ad7d429eb8da46b0bb3baec048b3564ce206b4523416cb4cb56b0a33767f.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}0 & 3 \\\\ 0 & -6\\end{aligned}].\n$$\n\nWhich of the following is the image of the triangle shown above under the action of $T?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/state.json" "file_sha256" "588232c7f218147607b9501dd3f799f9943de144ca370b3952c8a5b0ca2399bc"} {"question" "q-147611" "field" nil "attribute" "question/worked-solution" "value" "To find the image of the triangle under the action of $T$, we first create a matrix $X$ containing all of the vertices of the triangle:\n\n$$\nX=[\\begin{aligned}0 & 2 & 1 \\\\ 1 & 0 & 2\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}0 & 3 \\\\ 0 & -6\\end{aligned}][\\begin{aligned}0 & 2 & 1 \\\\ 1 & 0 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 0 & 6 \\\\ -6 & 0 & -12\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the image's vertices are $(3,-6)$, $(0,0),$ $(6,-12).$ Notice that all three points lie on the same line.\n\nSo, the image of our triangle under the action of $T$ is as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/assets/9c045d6467a91676cd