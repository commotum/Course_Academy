lon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}4 & -1 \\\\ 12 & -3\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ -3 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}4 & -1 \\\\ 0 & 0\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 \\\\ -3 & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}4 & -1 \\\\ 0 & 0\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=3,$ ${u}_{22}=0,$ and ${l}_{21}+{u}_{22}=3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-106769/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6093e24d-14bb-5e3b-a0b4-7a562a12f6a2"] :knowledge-point/questions ["q-106769"] :db/ensure [:knowledge-point/validate]} {:db/id "q-75177/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "97c8e28e-66f8-5cd5-802d-219004cf1ebf" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-75177/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "f5128586-1f2d-54e9-bb20-7373cd179c9f" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-75177/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "d8a8649f-56c2-54c3-8b4f-e06121be3547" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-75177/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "0ca07ef7-7b8f-5afd-977d-4df7f91da757" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-75177/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "585a4450-146d-5b54-820d-d75ae56b1c37" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-75177/selection" :answer-field/id #uuid "4bf43b55-d1ec-5774-8477-5293ad2ed2be" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-75177/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer-field/choices ["q-75177/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-75177/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-75177/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" "q-75177/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-75177/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-75177" :question/id #uuid "30a5731c-2a02-53f9-9c62-2c24fdfa7142" :question/math-academy-id "q-75177" :question/problem "Given that\n$A=[\\begin{aligned}-2 & 3 \\\\ 1 & \\,\\,\\,-\\frac{3}{2}\\end{aligned}]$\nhas the LU decomposition $A=LU$, then ${l}_{21}+{u}_{22}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}-2 & 3 \\\\ 1 & \\,\\,\\,-\\frac{3}{2}\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{1}{2}{R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ \\frac{1}{2} & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}-2 & 3 \\\\ 0 & 0\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 \\\\ \\frac{1}{2} & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 \\\\ -\\frac{1}{2} & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}-2 & 3 \\\\ 0 & 0\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=-\\frac{1}{2},$ ${u}_{22}=0,$ and ${l}_{21}+{u}_{22}=-\\frac{1}{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-75177/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6093e24d-14bb-5e3b-a0b4-7a562a12f6a2"] :knowledge-point/questions ["q-75177"] :db/ensure [:knowledge-point/validate]} {:db/id "q-106767/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "15ec6b14-7dd6-5a03-aa58-afcb3c7cf5c8" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-106767/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "361797cd-137d-5e42-87d2-b023ea8ea21e" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-106767/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "f07c2d41-adc6-56db-a067-36b9c88cec3b" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-106767/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "2a2b1421-af9c-5bec-a630-9164350b2be1" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-106767/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "d96ca6f3-b8c8-5533-83be-a723c1b960cc" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-106767/selection" :answer-field/id #uuid "78971209-7605-5746-ae21-522e9b2b96f2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-106767/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-106767/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-106767/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-106767/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-106767/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-106767/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-106767" :question/id #uuid "880eeca1-bf28-5a19-9291-63e2792d3636" :question/math-academy-id "q-106767" :question/problem "Given that\n$A=[\\begin{aligned}2 & 9 \\\\ -4 & -18\\end{aligned}]$\nhas the LU decomposition $A=LU$, then ${l}_{21}+{u}_{22}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2 & 9 \\\\ -4 & -18\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}2 & 9 \\\\ 0 & 0\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}2 & 9 \\\\ 0 & 0\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=-2,$ ${u}_{22}=0,$ and ${l}_{21}+{u}_{22}=-2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-106767/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6093e24d-14bb-5e3b-a0b4-7a562a12f6a2"] :knowledge-point/questions ["q-106767"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-6184"] :question/problem "Which of the following products is the LU factorization of a matrix $A?$\n\n- ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058701/assets/f07498a45503a02fa9fb4d3ecfd9bdae54a363b632152016f2f4e5c3f6170656.png)\n\n- ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058701/assets/300278e3edb64ab9dcb945668b923f385b9873be5bd33264a7ed10f6072262b7.png)\n\n- ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058701/assets/e26513d3753cd1437a42a9f57f160fb25e2fb9b84e1df1db07579429749eea2c.png)" :question/worked-solution "Remember that in the LU factorization of a matrix $A,$ we write $A=LU$ where the matrix $L$ is a unit lower triangular matrix (a lower triangular matrix that has only $1$'s on the main diagonal) and the matrix $U$ is an upper triangular matrix:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058701/assets/98d64291b8e0d4effe6bb1f3006c3d88d2687697355a83c1b092cdfb54ba4188.png)\n\nWith that in mind, let's inspect each product in turn.\n\n- The first product is in $LU$ form because the left matrix is a unit lower triangular matrix, and the right matrix is an upper triangular matrix.\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058701/assets/10a251d4445a3b190e92fa179badfb5e989b577f3c88812334e921522e7a20e5.png)\n\n- The second product is *not* in $LU$ form. Although the left matrix is a lower triangular matrix, it is not a *unit* lower triangular matrix because it does not have $1$'s on the diagonal.\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058701/assets/515f139b62a15ee4b38066e6225066b527e277e904ea97473d2a9f50f0f595cb.png)\n\n- The third product is *not* in $LU$ form because the matrix on the right is not an upper triangular matrix, as it has a non-zero entry below the diagonal.\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058701/assets/e377b0ff63ac6d7b3938187e47a3b5bca0087ddb6eee1d2c086835f394cdf6b9.png)\n\nTherefore, the correct answer is \"I only.\"" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4765"] :question/problem "Given ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058701/assets/98496fe489edc905b587f42825bd0ef76dffa68bece7e204abae6de259501835.png) find its LU decomposition." :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}7 & 9 \\\\ -7 & -6\\end{aligned}] & {R}_{2} & :={R}_{2}+1\\cdot {R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ 1 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}7 & 9 \\\\ 0 & 3\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since $E_1A=U,$ we can invert $E_1$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 \\\\ 1 & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 \\\\ -1 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}7 & 9 \\\\ 0 & 3\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4767"] :question/problem "Given \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058701/assets/4a8b4b988e2f4c93881f577ce12f2aa59a4dbcc00bf4122e23873255c27c2d72.png), find its LU decomposition." :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}4 & 3 \\\\ 12 & 9\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ -3 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}4 & 3 \\\\ 0 & 0\\end{aligned}] \\\\  & =U.\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since $E_1A=U,$ we can invert $E_1$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 \\\\ -3 & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}4 & 3 \\\\ 0 & 0\\end{aligned}]}_{⏟}}_{U}.\\end{aligned}\n$$" :db/ensure [:question/validate]}]
