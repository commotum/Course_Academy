b/id #edb/ref 17592186338219} {:answer/id #uuid "213c952c-44d7-5eca-8f4f-1f848cf9b963" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 18 & 1\\end{aligned}]" :db/id #edb/ref 17592186338220} {:answer/id #uuid "87c60979-d26f-5a7b-924d-c6e68eacd359" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 5 & 32\\end{aligned}]" :db/id #edb/ref 17592186338221} {:answer/id #uuid "13b1e281-e1af-55ea-901c-e90422b42030" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ -5 & 1\\end{aligned}]" :db/id #edb/ref 17592186338222}] :answer-field/correct {:answer/id #uuid "13b1e281-e1af-55ea-901c-e90422b42030" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ -5 & 1\\end{aligned}]" :db/id #edb/ref 17592186338222} :answer-field/id #uuid "ac0d22ae-134f-5080-bdab-c296dde7a0a8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338217}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c7e3bf80-d71d-502c-8977-ed540b710cc2" :question/math-academy-id "q-32608" :question/problem "Given that  $A=[\\begin{aligned}1 & 5 \\\\ -5 & -7\\end{aligned}]$ has the LU decomposition $A=LU,$ then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 5 \\\\ -5 & -7\\end{aligned}] & {R}_{2} & :={R}_{2}+5{R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ 5 & 1\\end{aligned}]}}\\cdot D \\\\  & ∼[\\begin{aligned}1 & 5 \\\\ 0 & 18\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 \\\\ 5 & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 \\\\ -5 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}1 & 5 \\\\ 0 & 18\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338223 :knowledge-point/_questions [{:knowledge-point/id #uuid "9279d979-74ba-5504-b98a-63692db3af72" :knowledge-point/title "Finding the LU Factorization of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c1bf5da-8879-51cc-942a-094dd8d265c1" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186338225} {:answer/id #uuid "73890e14-2350-59c1-a86a-564da3b320aa" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186338226} {:answer/id #uuid "06582e7d-cfd5-522f-aea1-d9cc483e2f52" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{3}" :db/id #edb/ref 17592186338227} {:answer/id #uuid "2925f4c9-1e7d-5dcb-b08c-6d113ce1b5ee" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186338228} {:answer/id #uuid "64da7025-a39c-5a3a-8cad-aa6f01d6e49f" :answer/type {:db/ident :answer.type/math} :answer/value "63" :db/id #edb/ref 17592186338229}] :answer-field/correct {:answer/id #uuid "73890e14-2350-59c1-a86a-564da3b320aa" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186338226} :answer-field/id #uuid "23f378f9-0d9c-5f17-8d43-c7d9faf7fb51" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338224}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b49c26b1-11bf-5006-a31c-56e1faf163c8" :question/math-academy-id "q-32617" :question/problem "Given that \n$B=[\\begin{aligned}3 & 9 \\\\ 7 & 20\\end{aligned}]$ \nhas the LU decomposition $B=LU$, then ${l}_{21}\\cdot {u}_{12}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $B$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $B$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}B & =[\\begin{aligned}3 & 9 \\\\ 7 & 20\\end{aligned}] & {R}_{2} & :={R}_{2}+(-\\frac{7}{3}){R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ -\\frac{7}{3} & 1\\end{aligned}]}}\\cdot B \\\\  & ∼[\\begin{aligned}3 & 9 \\\\ 0 & -1\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}B=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}B & =U \\\\ B & ={E}_{1}^{-1}U \\\\ B & ={[\\begin{aligned}1 & 0 \\\\ -\\frac{7}{3} & 1\\end{aligned}]}^{-1}U \\\\ B & ={{[\\begin{aligned}1 & 0 \\\\ \\frac{7}{3} & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}3 & 9 \\\\ 0 & -1\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=\\frac{7}{3},{u}_{12}=9,$ and ${l}_{21}\\cdot {u}_{12}=21.$"}] [{:db/id #edb/ref 17592186338230 :knowledge-point/_questions [{:knowledge-point/id #uuid "c2c1a562-1b3d-5180-9fef-e20ea916b17a" :knowledge-point/title "Identifying LU Factorizations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e12f20f8-e01a-5810-9222-23f9c6740052" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186338232} {:answer/id #uuid "2179555b-e5be-5253-a034-f72262a95e85" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186338233} {:answer/id #uuid "aed94dd4-e9fc-5fa2-82d1-bcead7840944" :answer/type {:db/ident :answer.type/text} :answer/value "II  and III only" :db/id #edb/ref 17592186338234} {:answer/id #uuid "4a94bb33-cead-5d93-b766-fef1bb914340" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186338235} {:answer/id #uuid "f34205b5-7d1b-58eb-81b3-5ca44907c5bc" :answer/type {:db/ident :answer.type/text} :answer/value "II  only" :db/id #edb/ref 17592186338236}] :answer-field/correct {:answer/id #uuid "2179555b-e5be-5253-a034-f72262a95e85" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186338233} :answer-field/id #uuid "a6e46ab9-108a-591e-ab6f-d82f0a8875e5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338231}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "0df2a893-643b-575a-a7ea-beeb0878eb97" :question/math-academy-id "q-75116" :question/problem "Which of the following products is the LU factorization of a matrix $C?$\n\n- $C=[\\begin{aligned}0 & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 0 & 1\\end{aligned}]$\n- $C=[\\begin{aligned}3 & 2 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}]$\n- $C=[\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}1 & 2 \\\\ 0 & 4\\end{aligned}]$" :question/worked-solution "Remember that in the LU factorization of a matrix $C,$ we write $C=LU$ where the matrix $L$ is a unit lower triangular matrix (a lower triangular matrix that has only $1$'s on the main diagonal) and the matrix $U$ is an upper triangular matrix:\n\n$$\nC=\\overset{L}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ ∗ & 1\\end{aligned}]}}\\cdot \\overset{U}{\\overset{⏞}{[\\begin{aligned}∗ & ∗ \\\\ 0 & ∗\\end{aligned}]}}\n$$\n\nWith that in mind, let's inspect each product in turn.\n\n- The first product is *not* in $LU$ form  because  the matrix on the left is not a unit lower triangular matrix, as its main diagonal contains a number not equal to $1.$\n\n$$\nC=[\\begin{aligned}0 & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 0 & 1\\end{aligned}]\\,\\times \n$$\n\n- The second product is *not* in $LU$ form. Although we have a product of an upper triangular matrix on the left and a unit lower triangular matrix on the right, the order of multiplication is not correct (instead, we need a unit lower triangular matrix on the left and an upper triangular matrix on the right).\n\n$$\nC=[\\begin{aligned}3 & 2 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}]\\,\\times \n$$\n\n- The third product is in $LU$ form because the left matrix is a unit lower triangular matrix, and the right matrix is an upper triangular matrix. \n\n$$\nC=[\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}1 & 2 \\\\ 0 & 4\\end{aligned}]\\,✓\n$$\n\nTherefore, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186338237 :knowledge-point/_questions [{:knowledge-point/id #uuid "c2c1a562-1b3d-5180-9fef-e20ea916b17a" :knowledge-point/title "Identifying LU Factorizations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b8c1e1b-38f4-5c0f-8b1b-6e01129f225f" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186338239} {:answer/id #uuid "18b5e184-d34f-54fa-88ae-c0c81bc02f31" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186338240} {:answer/id #uuid "84f6c03e-03bb-55c2-981d-bc0c46ac5a49" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186338241} {:answer/id #uuid "0f2cd858-ef76-53c5-88c7-0d73bb2dc5d4" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186338242} {:answer/id #uuid "e0cea277-e795-5628-810b-154b8f8f03dd" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186338243}] :answer-field/correct {:answer/id #uuid "84f6c03e-03bb-55c2-981d-bc0c46ac5a49" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186338241} :answer-field/id #uuid "fff4cd8a-ccdb-552a-9396-f0c67531ad2b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338238}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ad548fbf-72e6-5c5c-8b8c-7946f3fae039" :question/math-academy-id "q-75117" :question/problem "Which of the following products is the LU factorization of a matrix $A?$\n\n- $A=[\\begin{aligned}-1 & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}4 & 2 \\\\ 0 & 1\\end{aligned}]$\n- $A=[\\begin{aligned}1 & 0 \\\\ -4 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ -1 & 2\\end{aligned}]$\n- $A=[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}][\\begin{aligned}3 & -1 \\\\ 0 & 2\\end{aligned}]$" :question/worked-solution "Remember that in the LU factorization of a matrix $A,$ we write $A=LU$ where the matrix $L$ is a unit lower triangular matrix (a lower triangular matrix that has only $1$'s on the main diagonal) and the matrix $U$ is an upper triangular matrix:  \n\n$$\nA=\\overset{L}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ ∗ & 1\\end{aligned}]}}\\cdot \\overset{U}{\\overset{⏞}{[\\begin{aligned}∗ & ∗ \\\\ 0 & ∗\\end{aligned}]}}\n$$\n\nWith that in mind, let's inspect each product in turn.\n\n- The first product is *not* in $LU$ form because the matrix on the left is not a unit lower triangular matrix, as it has an entry not equal to $1$  on the main diagonal.\n\n$$\nA=[\\begin{aligned}-1 & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}4 & 2 \\\\ 0 & 1\\end{aligned}]\\,\\times \n$$\n\n- The second product is *not* in $LU$ form because the matrix on the right is not an upper triangular matrix, as it has a non-zero entry below the diagonal. \n\n$$\nA=[\\begin{aligned}1 & 0 \\\\ -4 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ -1 & 2\\end{aligned}]\\,\\times \n$$\n\n- The third product is in $LU$ form because the left matrix is a unit lower triangular matrix, and the right matrix is an upper triangular matrix.\n\n$$\nA=[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}][\\begin{aligned}3 & -1 \\\\ 0 & 2\\end{aligned}]\\,✓\n$$\n\nTherefore, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186338244 :knowledge-point/_questions [{:knowledge-point/id #uuid "c2c1a562-1b3d-5180-9fef-e20ea916b17a" :knowledge-point/title "Identifying LU Factorizations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b821af6a-6134-5ff9-9237-3970d0900a0c" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186338246} {:answer/id #uuid "a0ad22ea-7408-5ec0-93ac-c2d6dfea1dc5" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186338247} {:answer/id #uuid "ea6ac2ab-b8da-5e37-b874-2f692d2758d3" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186338248} {:answer/id #uuid "87280531-bbac-56ff-b1c6-2101d3d81d0e" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186338249} {:answer/id #uuid "5112bbbd-5832-5bf9-bce6-11bc50588e06" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186338250}] :answer-field/correct {:answer/id #uuid "ea6ac2ab-b8da-5e37-b874-2f692d2758d3" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186338248} :answer-field/id #uuid "89e59694-d8e4-5c45-af4d-cd6a323b3873" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338245}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "cf39dfe9-67f5-5e6d-9cc0-9139a83a257b" :question/math-academy-id "q-75123" :question/problem "Which of the following products is the LU factorization of a matrix $C?$\n\n- $C=[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}]$\n- $C=[\\begin{aligned}1 & 1 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 & 1 \\\\ 0 & 0\\end{aligned}]$\n- $C=[\\begin{aligned}0 & 0 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 0 & 1\\end{aligned}]$" :question/worked-solution "Remember that in the LU factorization of a matrix $C,$ we write $C=LU$ where the matrix $L$ is a unit lower triangular matrix (a lower triangular matrix that has only $1$'s on the main diagonal) and the matrix $U$ is an upper triangular matrix:\n\n$$\nC=\\overset{L}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ ∗ & 1\\end{aligned}]}}\\cdot \\overset{U}{\\overset{⏞}{[\\begin{aligned}∗ & ∗ \\\\ 0 & ∗\\end{aligned}]}}\n$$\n\nWith that in mind, let's inspect each product in turn.\n\n- The first product is in $LU$ form because the left matrix is a unit lower triangular matrix, and the right matrix is an upper triangular matrix. \n\n$$\nC=[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}]\\,✓\n$$\n\n- The second product is *not* in $LU$ form because the matrix on the left is not a unit lower triangular matrix, as it has a non-zero entry above the main diagonal. \n\n$$\nC=[\\begin{aligned}1 & 1 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 & 1 \\\\ 0 & 0\\end{aligned}]\\,\\times \n$$\n\n- The third product is *not* in $LU$ form because the matrix on the left is not a unit lower triangular matrix, as it has an entry not equal to $1$ on the main diagonal.\n\n$$\nC=[\\begin{aligned}0 & 0 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 0 & 1\\end{aligned}]\\,\\times \n$$\n\nTherefore, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186338251 :knowledge-point/_questions [{:knowledge-point/id #uuid "6093e24d-14bb-5e3b-a0b4-7a562a12f6a2" :knowledge-point/title "Finding the LU Factorization of a Singular 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8a8649f-56c2-54c3-8b4f-e06121be3547" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186338253} {:answer/id #uuid "97c8e28e-66f8-5cd5-802d-219004cf1ebf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186338254} {:answer/id #uuid "f5128586-1f2d-54e9-bb20-7373cd179c9f" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186338255} {:answer/id #uuid "0ca07ef7-7b8f-5afd-977d-4df7f91da757" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186338256} {:answer/id #uuid "585a4450-146d-5b54-820d-d75ae56b1c37" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186338257}] :answer-field/correct {:answer/id #uuid "d8a8649f-56c2-54c3-8b4f-e06121be3547" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186338253} :answer-field/id #uuid "4bf43b55-d1ec-5774-8477-5293ad2ed2be" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338252}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "30a5731c-2a02-53f9-9c62-2c24fdfa7142" :question/math-academy-id "q-75177" :question/problem "Given that\n$A=[\\begin{aligned}-2 & 3 \\\\ 1 & \\,\\,\\,-\\frac{3}{2}\\end{aligned}]$\nhas the LU decomposition $A=LU$, then ${l}_{21}+{u}_{22}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}-2 & 3 \\\\ 1 & \\,\\,\\,-\\frac{3}{2}\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{1}{2}{R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ \\frac{1}{2} & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}-2 & 3 \\\\ 0 & 0\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 \\\\ \\frac{1}{2} & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 \\\\ -\\frac{1}{2} & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}-2 & 3 \\\\ 0 & 0\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=-\\frac{1}{2},$ ${u}_{22}=0,$ and ${l}_{21}+{u}_{22}=-\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186338258 :knowledge-point/_questions [{:knowledge-point/id #uuid "6093e24d-14bb-5e3b-a0b4-7a562a12f6a2" :knowledge-point/title "Finding the LU Factorization of a Singular 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c7725e3e-6b97-5dd8-b331-77e07efa99d9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186338260} {:answer/id #uuid "cb61aac3-ebe2-5b51-92ff-52f0034aa90b" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186338261} {:answer/id #uuid "12248bfe-024d-5188-91d3-2e76dbd7139a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186338262} {:answer/id #uuid "8574771b-ec5d-58ad-91f2-d9175c46f9e1" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186338263} {:answer/id #uuid "c2ae1e63-6532-5cd7-95d0-34f9d9b2a01f" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186338264}] :answer-field/correct {:answer/id #uuid "8574771b-ec5d-58ad-91f2-d9175c46f9e1" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186338263} :answer-field/id #uuid "ca109d03-214e-5215-8f83-ec30f91aa2a6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338259}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "06fb245c-4807-5fda-a8aa-18ed96f226df" :question/math-academy-id "q-75179" :question/problem "Given that $A=[\\begin{aligned}-3 & -2 \\\\ 9 & 6\\end{aligned}]$\nhas the LU decomposition $A=LU$, then ${l}_{21}+{u}_{22}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}-3 & -2 \\\\ 9 & 6\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}-3 & -2 \\\\ 0 & 0\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 \\\\ -3 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}-3 & -2 \\\\ 0 & 0\\end{aligned}]}_{⏟}}_{U}.\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=-3,{u}_{22}=0,$ and ${l}_{21}+{u}_{22}=-3.$"}]}
