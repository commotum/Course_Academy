5}{6\\sqrt{5}} \\\\  & =\\frac{\\sqrt{5}}{6}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{\\sqrt{5}}{6})≈{68.12}^{∘}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-40561/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6bde92b0-4e98-5c2e-848e-7a5febc848ae"] :knowledge-point/questions ["q-40561"] :db/ensure [:knowledge-point/validate]} {:db/id "q-40565/selection/0d5992d02c1905a82fa220440f0717073f75c655db9f6a7ffea52e16fd1a5505" :answer/id #uuid "3bc29b77-914c-5a98-aa37-c5cc7af410ef" :answer/type :answer.type/math :answer/value "\\frac{2\\pi }{7}" :db/ensure [:answer/validate]} {:db/id "q-40565/selection/e0bd991ac2e2f2a23ec920e03c6d5103be6b20c12a25d724ab290d4ba5292c3e" :answer/id #uuid "27c9c57e-764c-537c-b3de-f8dc8050a9a7" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{6}" :db/ensure [:answer/validate]} {:db/id "q-40565/selection/adbad78d33491a071139fe589fefda7e9ba65cf97ebbcae14d252ac90459e198" :answer/id #uuid "800068e3-a506-52e0-9c5f-7a9689996022" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "q-40565/selection/82f0679237d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5" :answer/id #uuid "53fc6357-c900-5f23-84a3-727d206fda35" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-40565/selection/d62732e72e17b0393290bd9e548ef368f6b7424bded817d038b07db5bf5fcb98" :answer/id #uuid "2b0a35ea-d51e-5d9b-8149-11810edb781a" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{5}" :db/ensure [:answer/validate]} {:db/id "q-40565/selection" :answer-field/id #uuid "63fa1624-fae5-548f-ad5c-1f00646ed694" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-40565/selection/adbad78d33491a071139fe589fefda7e9ba65cf97ebbcae14d252ac90459e198" :answer-field/choices ["q-40565/selection/0d5992d02c1905a82fa220440f0717073f75c655db9f6a7ffea52e16fd1a5505" "q-40565/selection/e0bd991ac2e2f2a23ec920e03c6d5103be6b20c12a25d724ab290d4ba5292c3e" "q-40565/selection/adbad78d33491a071139fe589fefda7e9ba65cf97ebbcae14d252ac90459e198" "q-40565/selection/82f0679237d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5" "q-40565/selection/d62732e72e17b0393290bd9e548ef368f6b7424bded817d038b07db5bf5fcb98"] :db/ensure [:answer-field/validate]} {:db/id "q-40565" :question/id #uuid "c2402d3b-f008-57e6-b8f8-fa7abe5b8f00" :question/math-academy-id "q-40565" :question/problem "Find the acute angle between the vectors\n $v=[\\begin{aligned}\\sqrt{7} \\\\ 7 \\\\ 2 \\\\ 2\\end{aligned}]$ and $w=[\\begin{aligned}-\\sqrt{7} \\\\ 3 \\\\ 7 \\\\ \\text{ }4\\end{aligned}].$" :question/worked-solution "Using the formula\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{v\\cdot w}{‖v‖\\,‖w‖},\n$$\n\nwe have the following:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{{v}_{1}{w}_{1}+{v}_{2}{w}_{2}+{v}_{3}{w}_{3}+{v}_{4}{w}_{4}}{\\sqrt{{v}_{1}^{2}+{v}_{2}^{2}+{v}_{3}^{2}+{v}_{4}^{2}}\\,\\sqrt{{w}_{1}^{2}+{w}_{2}^{2}+{w}_{3}^{2}+{w}_{4}^{2}}} \\\\  & =\\frac{\\sqrt{7}\\cdot (-\\sqrt{7})+7\\cdot 3+2\\cdot 7+2\\cdot 4}{\\sqrt{(\\sqrt{7})^{2}+{7}^{2}+{2}^{2}+{2}^{2}}\\sqrt{(-\\sqrt{7})^{2}+{3}^{2}+{7}^{2}+{4}^{2}}} \\\\  & =\\frac{36}{\\sqrt{64}\\sqrt{81}} \\\\  & =\\frac{36}{72} \\\\  & =\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{1}{2})=\\frac{\\pi }{3}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-40565/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6bde92b0-4e98-5c2e-848e-7a5febc848ae"] :knowledge-point/questions ["q-40565"] :db/ensure [:knowledge-point/validate]} {:db/id "q-40564/selection/a054e31cea9592e8d71473d3eead51c6872e72181bc818112644bea36edc609a" :answer/id #uuid "45fab55d-faba-592e-ac78-f13946e8899e" :answer/type :answer.type/math :answer/value "{75.28}^{∘}" :db/ensure [:answer/val