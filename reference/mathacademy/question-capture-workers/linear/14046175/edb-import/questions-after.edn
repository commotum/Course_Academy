answer/type {:db/ident :answer.type/math} :answer/value "{82.34}^{∘}" :db/id #edb/ref 17592186326853} {:answer/id #uuid "cec6eaf3-72ee-5a46-a542-7c32b3c2ad35" :answer/type {:db/ident :answer.type/math} :answer/value "{72.25}^{∘}" :db/id #edb/ref 17592186326854} {:answer/id #uuid "20f97160-8000-5a7f-9849-7df9ee3d0f15" :answer/type {:db/ident :answer.type/math} :answer/value "{89.76}^{∘}" :db/id #edb/ref 17592186326855} {:answer/id #uuid "cd155694-37f8-5b35-b69c-21c31fdb06af" :answer/type {:db/ident :answer.type/math} :answer/value "{75.5}^{∘}" :db/id #edb/ref 17592186326856}] :answer-field/correct {:answer/id #uuid "03a177b7-fe3f-59eb-8755-0b71633739db" :answer/type {:db/ident :answer.type/math} :answer/value "{70.76}^{∘}" :db/id #edb/ref 17592186326852} :answer-field/id #uuid "cb716df0-c0ac-5805-80b2-66451d4dad0f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326851}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1189bfdd-553b-5a47-a40b-2ac3c101817d" :question/math-academy-id "q-40566" :question/problem "Rounded to two decimal places, what is the acute angle between the vectors  $v=[\\begin{aligned}1 \\\\ -4 \\\\ 5 \\\\ -5\\end{aligned}]$ and $w=[\\begin{aligned}-5 \\\\ -5 \\\\ 2 \\\\ \\text{ }1\\end{aligned}]?$" :question/worked-solution "Using the formula\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{v\\cdot w}{‖v‖\\,‖w‖},\n$$\n\nwe have the following:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{{v}_{1}{w}_{1}+{v}_{2}{w}_{2}+{v}_{3}{w}_{3}+{v}_{4}{w}_{4}}{\\sqrt{{v}_{1}^{2}+{v}_{2}^{2}+{v}_{3}^{2}+{v}_{4}^{2}}\\sqrt{{w}_{1}^{2}+{w}_{2}^{2}+{w}_{3}^{2}+{w}_{4}^{2}}} \\\\  & =\\frac{1\\cdot (-5)+(-4)\\cdot (-5)+5\\cdot 2+(-5)\\cdot 1}{\\sqrt{{1}^{2}+(-4)^{2}+{5}^{2}+(-5)^{2}}\\sqrt{(-5)^{2}+(-5)^{2}+{2}^{2}+{1}^{2}}} \\\\  & =\\frac{20}{\\sqrt{67}\\sqrt{55}} \\\\  & =\\frac{20}{\\sqrt{3685}}\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{20}{\\sqrt{3685}})≈{70.76}^{∘}.\n$$"}] [{:db/id #edb/ref 17592186326857 :knowledge-point/_questions [{:knowledge-point/id #uuid "7ec34a19-988a-5421-8c05-6bb4c5a9e366" :knowledge-point/title "Determining a Minimum Possible Value Using the Cauchy-Schwarz Inequality"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "816a079c-9686-5a9c-a728-889064c7198e" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186326859} {:answer/id #uuid "df97b5a8-daea-5322-872f-ed27447a7139" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186326860} {:answer/id #uuid "7ace4d40-b438-5836-a3fa-30621248f7a1" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186326861} {:answer/id #uuid "59af396a-8d64-561e-bd9b-bb24738620fc" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186326862} {:answer/id #uuid "b2151733-9cb0-53b6-b86f-f7d52c661415" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186326863}] :answer-field/correct {:answer/id #uuid "59af396a-8d64-561e-bd9b-bb24738620fc" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186326862} :answer-field/id #uuid "a6621f1c-57ba-582c-9038-33076bfec89d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326858}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "9a5ff2b8-3d47-5da8-bda1-afca22be1c66" :question/math-academy-id "q-40882" :question/problem "Consider the vector $u=[\\begin{aligned}1 \\\\ -3 \\\\ \\sqrt{k} \\\\ 2\\end{aligned}].$ Given that $u\\cdot v=-20$ and $‖v‖=5$,  what is the smallest possible value of $k?$" :question/worked-solution "We will use the Cauchy-Schwarz inequality,\n\n$$\n|u\\cdot v|\\le ‖u‖\\cdot ‖v‖.\n$$\n\nWe are given all the quantities in the inequality above, except for $‖u‖.$ So first, we compute $‖u‖$ as follows:\n\n$$\n\\begin{aligned}‖u‖ & =\\sqrt{{1}^{2}+(-3)^{2}+(\\sqrt{k})^{2}+{2}^{2}} \\\\  & =\\sqrt{14+k}\\end{aligned}\n$$\n\nNow, using the Cauchy-Schwarz inequality, we have\n\n$$\n\\begin{aligned}|u\\cdot v| & \\le ‖u‖\\cdot ‖v‖ \\\\ |-20| & \\le \\sqrt{14+k}\\cdot (5) \\\\ 4 & \\le \\sqrt{14+k} \\\\ {4}^{2} & \\le {(\\sqrt{14+k})}^{2} \\\\ 16 & \\le 14+k \\\\ 2 & \\le k.\\end{aligned}\n$$\n\nTherefore, the smallest possible value of $k$ is $2.$"}] [{:db/id #edb/ref 17592186134253 :knowledge-point/_questions [{:knowledge-point/id #uuid "7b56b45b-94dd-5ba1-aae6-6b17cffaf532" :knowledge-point/title "Calculating the Cosine of an Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a28e766a-4cc3-591c-af5a-71a777bd0e09" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{27}{\\sqrt{87}}" :db/id #edb/ref 17592186131961} {:answer/id #uuid "f07f1acf-f7d7-5a6d-abd4-29e764d8d70e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186131962} {:answer/id #uuid "09f33c11-1c86-5731-8948-1bb667f33c58" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{7}" :db/id #edb/ref 17592186131963} {:answer/id #uuid "114a1086-c7f3-5699-a954-d212b56ac03b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{41}" :db/id #edb/ref 17592186131964} {:answer/id #uuid "2041c01c-aabd-5ef0-8ff8-172b1c788019" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17}{\\sqrt{7}}" :db/id #edb/ref 17592186131965}] :answer-field/correct {:answer/id #uuid "f07f1acf-f7d7-5a6d-abd4-29e764d8d70e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186131962} :answer-field/id #uuid "074057dc-406e-5fd5-9af9-7d2e22238244" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186131960}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "f556bfd7-df7c-5f35-9d10-55d46797ea31" :question/math-academy-id "q-40886" :question/problem "Let $A(1,-1,2,0)$, $B(1,0,0,-1)$, and $C(0,1,1,0).$ Find the cosine of the angle $∠BAC.$" :question/worked-solution "Let $v=\\overset{\\to }{AB}$ and $w=\\overset{\\to }{AC}.$ Then we have\n\n$$\n\\begin{aligned}v & =b-a \\\\  & =[\\begin{aligned}1 \\\\ 0 \\\\ 0 \\\\ -1\\end{aligned}]-[\\begin{aligned}1 \\\\ -1 \\\\ 2 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 1 \\\\ -2 \\\\ -1\\end{aligned}]\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}w & =c-a \\\\  & =[\\begin{aligned}0 \\\\ 1 \\\\ 1 \\\\ 0\\end{aligned}]-[\\begin{aligned}1 \\\\ -1 \\\\ 2 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ 2 \\\\ -1 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nLet $\\theta =m∠BAC$ be the angle between the vectors $v$ and $w.$ Then, we can find $\\operatorname{cos}⁡\\theta $ using the following formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{v\\cdot w}{‖v‖\\,‖w‖} \\\\  & =\\frac{{v}_{1}{w}_{1}+{v}_{2}{w}_{2}+{v}_{3}{w}_{3}+{v}_{4}{w}_{4}}{\\sqrt{{v}_{1}^{2}+{v}_{2}^{2}+{v}_{3}^{2}+{v}_{4}^{2}}\\,\\sqrt{{w}_{1}^{2}+{w}_{2}^{2}+{w}_{3}^{2}+{w}_{4}^{2}}} \\\\  & =\\frac{0\\cdot (-1)+1\\cdot 2+(-2)\\cdot (-1)+(-1)\\cdot 0}{\\sqrt{{0}^{2}+{1}^{2}+(-2)^{2}+(-1)^{2}}\\,\\sqrt{(-1)^{2}+{2}^{2}+(-1)^{2}+{0}^{2}}} \\\\  & =\\frac{4}{\\sqrt{6}\\cdot \\sqrt{6}} \\\\  & =\\frac{4}{6} \\\\  & =\\frac{2}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186326864 :knowledge-point/_questions [{:knowledge-point/id #uuid "7ec34a19-988a-5421-8c05-6bb4c5a9e366" :knowledge-point/title "Determining a Minimum Possible Value Using the Cauchy-Schwarz Inequality"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ac3d210-e60a-53d9-a1f9-2e2bbb456001" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186326866} {:answer/id #uuid "713fee89-2407-5881-be4a-7a79721169b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186326867} {:answer/id #uuid "48a59471-4397-51ce-a449-f385d9966cb5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186326868} {:answer/id #uuid "f0e6434a-30f4-5e80-8ed6-4fd9e21dc225" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186326869} {:answer/id #uuid "8add8945-6778-5b78-882b-3f6c7b06ac09" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186326870}] :answer-field/correct {:answer/id #uuid "f0e6434a-30f4-5e80-8ed6-4fd9e21dc225" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186326869} :answer-field/id #uuid "ea28f0ac-8aec-5f5d-b205-937de4185e41" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326865}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "034d2ed6-5ef6-5208-8e39-a3c440d5d032" :question/math-academy-id "q-74094" :question/problem "Given that $‖v‖=6$ and $u\\cdot v=-9$, find the smallest possible value of $‖u‖.$" :question/worked-solution "Using the Cauchy-Schwarz inequality, we have   \n\n$$\n\\begin{aligned}|u\\cdot v| & \\le ‖u‖\\cdot ‖v‖ \\\\ |-9| & \\le ‖u‖\\cdot 6 \\\\ 9 & \\le 6\\cdot ‖u‖ \\\\ 3 & \\le 2\\cdot ‖u‖.\\end{aligned}\n$$\n\nNow, we multiply both sides of the inequality by $\\frac{1}{2}:$\n\n$$\n\\begin{aligned}\\frac{1}{2}\\cdot 3 & \\le \\frac{1}{2}\\cdot 2\\cdot ‖u‖ \\\\ \\frac{3}{2} & \\le ‖u‖\\end{aligned}\n$$\n\nTherefore, the smallest possible value of $‖u‖$\nis  $\\frac{3}{2}.$"}] [{:db/id #edb/ref 17592186326871 :knowledge-point/_questions [{:knowledge-point/id #uuid "7b56b45b-94dd-5ba1-aae6-6b17cffaf532" :knowledge-point/title "Calculating the Cosine of an Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f95114cb-bd98-5724-8197-61a54eb833f3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186326873} {:answer/id #uuid "ba1afbb6-da0f-5a21-9e5f-a3528ce59a45" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186326874} {:answer/id #uuid "3af8684e-74bd-55cd-bae3-3c9ffdcf6002" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186326875} {:answer/id #uuid "80cc14f2-f4c0-5c9e-8022-b0dea30544d8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{15}" :db/id #edb/ref 17592186326876} {:answer/id #uuid "e9b3e6ed-94a6-585d-b2af-97fbb973d4b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186326877}] :answer-field/correct {:answer/id #uuid "ba1afbb6-da0f-5a21-9e5f-a3528ce59a45" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186326874} :answer-field/id #uuid "7bc80040-c640-59c4-b2be-d78308936881" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326872}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "97251e19-2588-52aa-ba2e-6f2b81a48ba1" :question/math-academy-id "q-74105" :question/problem "Let $A(1,-3,2,-1)$ and $B(1,1,3,-2).$ Find the cosine of the angle $∠AOB$, where $O(0,0,0,0)$ is the origin." :question/worked-solution "First, let\n\n$$\n\\begin{aligned}a=\\overset{\\to }{OA}=[\\begin{aligned}1 \\\\ -3 \\\\ 2 \\\\ -1\\end{aligned}],\\,b=\\overset{\\to }{OB}=[\\begin{aligned}1 \\\\ 1 \\\\ 3 \\\\ -2\\end{aligned}].\\end{aligned}\n$$\n\nAlso, let $\\theta =m∠AOB$ be the angle between the vectors $a$ and $b.$ Then, we can find $\\operatorname{cos}⁡\\theta $ using the following formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{a\\cdot b}{‖a‖\\,‖b‖} \\\\  & =\\frac{{a}_{1}{b}_{1}+{a}_{2}{b}_{2}+{a}_{3}{b}_{3}+{a}_{4}{b}_{4}}{\\sqrt{{a}_{1}^{2}+{a}_{2}^{2}+{a}_{3}^{2}+{a}_{4}^{2}}\\,\\sqrt{{b}_{1}^{2}+{b}_{2}^{2}+{b}_{3}^{2}+{b}_{4}^{2}}} \\\\  & =\\frac{1\\cdot 1+(-3)\\cdot 1+2\\cdot 3+(-1)\\cdot (-2)}{\\sqrt{{1}^{2}+(-3)^{2}+{2}^{2}+(-1)^{2}}\\,\\sqrt{{1}^{2}+{1}^{2}+{3}^{2}+(-2)^{2}}} \\\\  & =\\frac{6}{\\sqrt{15}\\cdot \\sqrt{15}} \\\\  & =\\frac{6}{15} \\\\  & =\\frac{6÷3}{15÷3} \\\\  & =\\frac{2}{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186326878 :knowledge-point/_questions [{:knowledge-point/id #uuid "7b56b45b-94dd-5ba1-aae6-6b17cffaf532" :knowledge-point/title "Calculating the Cosine of an Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84ee6a9f-71e6-596e-a48b-1715ddc127c1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{23}{30}" :db/id #edb/ref 17592186326880} {:answer/id #uuid "a005dabc-8c9e-5ce5-bef1-52cc88152338" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{15}" :db/id #edb/ref 17592186326881} {:answer/id #uuid "ef6d5d0c-0dc1-542d-842d-b2ca3374ae1e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186326882} {:answer/id #uuid "e663d1dd-6442-560d-b0dc-cfd9be4290df" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{23}{30}" :db/id #edb/ref 17592186326883} {:answer/id #uuid "144a34ba-5eda-59f1-9877-014e1af19dcd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{15}" :db/id #edb/ref 17592186326884}] :answer-field/correct {:answer/id #uuid "e663d1dd-6442-560d-b0dc-cfd9be4290df" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{23}{30}" :db/id #edb/ref 17592186326883} :answer-field/id #uuid "7d44d428-2a6c-5ae2-b39d-fbccca778fc7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326879}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "b80ce80c-769f-5a27-bb3a-0f2b90a90e8d" :question/math-academy-id "q-74121" :question/problem "Let $A(-1,3,2,-4)$, $B(1,0,1,-2)$, and $C(0,1,-1,2).$ Find the cosine of the angle $∠BAC.$" :question/worked-solution "Let $v=\\overset{\\to }{AB}$ and $w=\\overset{\\to }{AC}.$ Then we have\n\n$$\n\\begin{aligned}v & =b-a \\\\  & =[\\begin{aligned}1 \\\\ 0 \\\\ 1 \\\\ -2\\end{aligned}]-[\\begin{aligned}-1 \\\\ 3 \\\\ 2 \\\\ -4\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ -3 \\\\ -1 \\\\ 2\\end{aligned}]\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}w & =c-a \\\\  & =[\\begin{aligned}0 \\\\ 1 \\\\ -1 \\\\ 2\\end{aligned}]-[\\begin{aligned}-1 \\\\ 3 \\\\ 2 \\\\ -4\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ -2 \\\\ -3 \\\\ 6\\end{aligned}].\\end{aligned}\n$$\n\n \n\nLet $\\theta =m∠BAC$ be the angle between the vectors $v$ and $w.$ Then, we can find $\\operatorname{cos}⁡\\theta $ using the following formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{v\\cdot w}{‖v‖\\,‖w‖} \\\\  & =\\frac{{v}_{1}{w}_{1}+{v}_{2}{w}_{2}+{v}_{3}{w}_{3}+{v}_{4}{w}_{4}}{\\sqrt{{v}_{1}^{2}+{v}_{2}^{2}+{v}_{3}^{2}+{v}_{4}^{2}}\\,\\sqrt{{w}_{1}^{2}+{w}_{2}^{2}+{w}_{3}^{2}+{w}_{4}^{2}}} \\\\  & =\\frac{2\\cdot 1+(-3)\\cdot (-2)+(-1)\\cdot (-3)+2\\cdot 6}{\\sqrt{{2}^{2}+(-3)^{2}+(-1)^{2}+{2}^{2}}\\,\\sqrt{{1}^{2}+(-2)^{2}+(-3)^{2}+{6}^{2}}} \\\\  & =\\frac{23}{\\sqrt{18}\\cdot \\sqrt{50}} \\\\  & =\\frac{23}{30}\\end{aligned}\n$$"}]}
