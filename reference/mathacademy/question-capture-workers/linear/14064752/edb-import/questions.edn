#{[{:db/id #edb/ref 17592186286186 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c699610-261c-5695-b196-3999bf781137" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{\\sqrt{26}}" :db/id #edb/ref 17592186286188} {:answer/id #uuid "3f11c720-e046-523b-8dc7-c52f825eba0a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19}{\\sqrt{26}}" :db/id #edb/ref 17592186286189} {:answer/id #uuid "5cd6b170-da5f-508f-a233-6372ca4cf73d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18}{\\sqrt{26}}" :db/id #edb/ref 17592186286190} {:answer/id #uuid "ba533aff-71f4-54f1-a488-8e6bd6e66a13" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18}{\\sqrt{14}}" :db/id #edb/ref 17592186286191} {:answer/id #uuid "08f2859a-5d24-534f-82e7-b3fbf2ac9ede" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19}{\\sqrt{14}}" :db/id #edb/ref 17592186286192}] :answer-field/correct {:answer/id #uuid "5cd6b170-da5f-508f-a233-6372ca4cf73d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18}{\\sqrt{26}}" :db/id #edb/ref 17592186286190} :answer-field/id #uuid "c23d68cf-4f67-573a-91f0-15f4e696233a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286187}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "26907092-d115-5133-80f7-1ed5a1bdc6ed" :question/math-academy-id "q-19139" :question/problem "Let $a=⟨3,2,1⟩$ and $b=⟨3,4,1⟩.$ Find the scalar projection of $a$ onto $b.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{3\\cdot 3+2\\cdot 4+1\\cdot 1}{\\sqrt{{3}^{2}+{4}^{2}+{1}^{2}}} \\\\  & =\\frac{18}{\\sqrt{26}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186306546 :knowledge-point/_questions [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20a08fcb-8d67-587b-908d-8bfaa6dc506a" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186306548} {:answer/id #uuid "e3181933-1d04-52b3-ab3e-236ee829e388" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186306549}] :answer-field/correct {:answer/id #uuid "20a08fcb-8d67-587b-908d-8bfaa6dc506a" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186306548} :answer-field/id #uuid "77860c74-b969-57ea-ad6c-3e724a7c142e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186306547}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "166b44a5-699d-55cc-b286-b547b1216d16" :question/math-academy-id "q-319253" :question/problem "Let $p=-4i+2j-3k$ and $q=5i+xj.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-4)\\cdot 5+2\\cdot x+(-3)\\cdot 0 \\\\  & =-20+2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ -20+2x & =0 \\\\ 2x & =20 \\\\ x & =10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286193 :knowledge-point/_questions [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9598539e-b54f-5c35-85a9-860683f593e1" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186286195}] :answer-field/correct {:answer/id #uuid "9598539e-b54f-5c35-85a9-860683f593e1" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186286195} :answer-field/id #uuid "7c5e5c8a-f0ab-52e4-a5aa-56854d500dd5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286194}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1b038fbb-5dcb-597f-a35d-5322f573b512" :question/math-academy-id "q-319254" :question/problem "Let $p=3i+2j-k$ and $q=-2i+xj.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =3\\cdot (-2)+2\\cdot x+(-1)\\cdot 0 \\\\  & =-6+2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ -6+2x & =0 \\\\ 2x & =6 \\\\ x & =3.\\end{aligned}\n$$"}]}
