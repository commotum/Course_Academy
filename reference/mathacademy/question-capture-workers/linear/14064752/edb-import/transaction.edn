/validate]} {:db/id "q-101527" :question/id #uuid "4969f416-9478-5eb9-beb3-c0a04af2dabd" :question/math-academy-id "q-101527" :question/problem "Let $p=⟨3,2,1⟩$ and $q=⟨1,-1,1⟩.$ Find the scalar projection of $p$ onto $q.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{3\\cdot 1+2\\cdot (-1)+1\\cdot 1}{\\sqrt{{1}^{2}+(-1)^{2}+{1}^{2}}} \\\\  & =\\frac{2}{\\sqrt{3}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-101527/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036"] :knowledge-point/questions ["q-101527"] :db/ensure [:knowledge-point/validate]} {:db/id "q-126502/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "71df191f-66b2-5180-b970-c49dd4b701db" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-126502/selection/8551f4ab982fcde1f823c1977548aa17e8676df39a3695767fd216f31d51658b" :answer/id #uuid "9d082b29-4986-5b63-9dae-e06c40b27c98" :answer/type :answer.type/math :answer/value "\\frac{2\\sqrt{2}}{3}" :db/ensure [:answer/validate]} {:db/id "q-126502/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" :answer/id #uuid "9161b7c5-c24b-5486-9ceb-89e072165672" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-126502/selection/af5580a233ee3709064249d6732fc822dfb93f38caf90c025deb51b127e90b2c" :answer/id #uuid "7decf380-56a1-579a-bfa2-8338a409e01b" :answer/type :answer.type/math :answer/value "2\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-126502/selection/8a135ace4937b1ffa2c52fbce040999428005f5395e9d793e225144a0384a1ba" :answer/id #uuid "342e58e4-d929-5790-ac