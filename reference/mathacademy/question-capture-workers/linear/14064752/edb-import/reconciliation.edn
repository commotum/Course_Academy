c{2}{\\sqrt{3}}"] ["math" "\\frac{3}{\\sqrt{3}}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14064752/state.json" "file_sha256" "39d1cdab13f8faa7c149d5dbef9031343535aee9c5c7979260d546846638d941"} {"question" "q-101527" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{2}{\\sqrt{3}}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14064752/state.json" "file_sha256" "39d1cdab13f8faa7c149d5dbef9031343535aee9c5c7979260d546846638d941"} {"question" "q-126502" "field" nil "attribute" "question/problem" "value" "Let $p=⟨6,-4,1⟩$ and $q=⟨2\\sqrt{2},\\sqrt{2},-2\\sqrt{2}⟩.$ Find the scalar projection of $p$ onto $q.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14064752/state.json" "file_sha256" "39d1cdab13f8faa7c149d5dbef9031343535aee9c5c7979260d546846638d941"} {"question" "q-126502" "field" nil "attribute" "question/worked-solution" "value" "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{6\\cdot 2\\sqrt{2}+(-4)\\cdot \\sqrt{2}+1\\cdot (-2\\sqrt{2})}{\\sqrt{(2\\sqrt{2})^{2}+(\\sqrt{2})^{2}+(-2\\sqrt{2})^{2}}} \\\\  & =\\frac{6\\sqrt{2}}{\\sqrt{18}} \\\\  & =\\frac{6\\sqrt{2}}{3\\sqrt{2}} \\\\  & =2.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14064752/state.json" "file_sha256" "39d1cdab13f8faa7c149d5dbef9031343535aee9c5c7979260d546846638d941"} {"question" "q-126502" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14064752/activity-metadata.json" "file_sha256" "8769ca3505eff33a71aeb1311971d1e441581fde228ecf0d46499691b1e5410b"} {"question" "q-126502" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14064752/state.json" "file_sha256" "39d1cdab13f8faa7c149d5dbef9031343535aee9c5c7979260d546846638d941"} {"question" "q-126502" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2"] ["math" "2\\sqrt{2}"] ["math" "\\frac{2\\sqrt{2}}{3}"] ["math" "\\frac{2}{3}"] ["math" "\\frac{\\sqrt{2}}{3}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14064752/state.json" "file_sha256" "39d1cdab13f8faa7c149d5dbef9031343535aee9c5c7979260d546846638d941"} {"question" "q-126502" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14064752/state.json" "file_sha256" "39d1cdab13f8faa7c149d5dbef9031343535aee9c5c7979260d546846638d941"} {"question" "q-319253" "field" nil "attribute" "question/problem" "value" "Let $p=-4i+2j-3k$ and $q=5i+xj.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14064752/state.json" "file_sha256" "39d1cdab13f8faa7c149d5dbef9031343535aee9c5c7979260d546846638d941"} {"question" "q-319253" "field" nil "attribute" "question/worked-solution" "value" "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-4)\\cdot 5+2\\cdot x+(-3)\\cdot 0 \\\\  & =-20+2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ -20+2x & =0 \\\\ 2x & =20 \\\\ x & =10.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14064752/state.json" "file_sha256" "39d1cdab13f8faa7c149d5dbef9031343535aee9c5c7979260d546846638d941"} {"question" "q-319253" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14064752/activity-metadata.json" "file_sha256" "8769ca3505eff33a71aeb1311971d1e441581fde228ecf0d46499691b1e5410b"} {"question" "q-319253" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14064752/state.json" "file_sha256" "39d1cdab13f8faa7c149d5dbef9031343535aee9c5c7979260d546846638d941"} {"question" "q-319253" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "10"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14064752/state.json" "file_sha256" "39d1cdab13f8faa7c149d5dbef9031343535aee9c5c7979260d546846638d941"} {"question" "q-319254" "field" nil "attribute" "question/problem" "value" "Let $p=3i+2j-k$ and $q=-2i+xj.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14064752/state.json" "file_