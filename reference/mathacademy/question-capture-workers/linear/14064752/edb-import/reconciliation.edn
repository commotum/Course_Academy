variable/14040236/edb-import/verification.json"} {"question" "q-19139" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{19}{\\sqrt{14}}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040236/state.json" "file_sha256" "6abcfc503947c7e93a39d0fa8c2989d2424e31f5e4625b225423804228437b4e" "basis" 1423 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040236/edb-import/verification.json"} {"question" "q-19139" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{19}{\\sqrt{26}}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040236/state.json" "file_sha256" "6abcfc503947c7e93a39d0fa8c2989d2424e31f5e4625b225423804228437b4e" "basis" 1423 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040236/edb-import/verification.json"} {"question" "q-19139" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{18}{\\sqrt{26}}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040236/state.json" "file_sha256" "6abcfc503947c7e93a39d0fa8c2989d2424e31f5e4625b225423804228437b4e" "basis" 1423 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040236/edb-import/verification.json"} {"question" "q-319253" "field" nil "attribute" "question/problem" "value" "Let $p=-4i+2j-3k$ and $q=5i+xj.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040236/state.json" "file_sha256" "6abcfc503947c7e93a39d0fa8c2989d2424e31f5e4625b225423804228437b4e" "basis" 1423 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040236/edb-import/verification.json"} {"question" "q-319253" "field" nil "attribute" "question/worked-solution" "value" "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-4)\\cdot 5+2\\cdot x+(-3)\\cdot 0 \\\\  & =-20+2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ -20+2x & =0 \\\\ 2x & =20 \\\\ x & =10.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040236/state.json" "file_sha256" "6abcfc503947c7e93a39d0fa8c2989d2424e31f5e4625b225423804228437b4e" "basis" 1423 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040236/edb-import/verification.json"} {"question" "q-319253" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040236/activity-metadata.json" "file_sha256" "1fcb7ef625b594b317187e59a3360275bf90c09e83972bf61a90c30f6b704e2d" "basis" 1423 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040236/edb-import/verification.json"} {"question" "q-319253" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040236/state.json" "file_sha256" "6abcfc503947c7e93a39d0fa8c2989d2424e31f5e4625b225423804228437b4e" "basis" 1423 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040236/edb-import/verification.json"} {"question" "q-319254" "field" nil "attribute" "question/problem" "value" "Let $p=3i+2j-k$ and $q=-2i+xj.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061012/state.json" "file_sha256" "08c1f82778c0c83cedfb981e1dd52349b5351ddcdc0b6dd4ba5cda5a95ec4606" "basis" 1964 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061012/edb-import/verification.json"} {"question" "q-319254" "field" nil "attribute" "question/worked-solution" "value" "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =3\\cdot (-2)+2\\cdot x+(-1)\\cdot 0 \\\\  & =-6+2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ -6+2x & =0 \\\\ 2x & =6 \\\\ x & =3.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061012/state.json" "file_sha256" "08c1f82778c0c83cedfb981e1dd52349b5351ddcdc0b6dd4ba5cda5a95ec4606" "basis" 1964 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061012/edb-import/verification.json"} {"question" "q-319254" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061012/activity-metadata.json" "file_sha256" "d0615a346086edb0e1956bf5c50ff0d4cf1f6e1f77d01d718f95136c1c710a8b" "basis" 1964 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061012/edb-import/verification.json"} {"question" "q-319254" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061012/state.json" "file_sha256" "08c1f82778c0c83cedfb981e1dd52349b5351ddcdc0b6dd4ba5cda5a95ec4606" "basis" 1964 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061012/edb-import/verification.json"} {"question" "q-319254" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "3"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061012/state.json" "file_sha256" "08c1f82778c0c83cedfb981e1dd52349b5351ddcdc0b6dd4ba5cda5a95ec4606" "basis" 1964 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061012/edb-import/verification.json"}] "sources" [{"question" "q-19139" "field" nil "attribute" "question/problem" "value" "Let $a=⟨3,2,1⟩$ and $b=⟨3,4,1⟩.$ Find the scalar projection of $a$ onto $b.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14064752/state.json" "file_sha256" "39d1cdab13f8faa7c149d5dbef9031343535aee9c5c7979260d546846638d941"} {"question" "q-19139" "field" nil "attribute" "question/worked-solution" "value" "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{3\\cdot 3+2\\cdot 4+1\\cdot 1}{\\sqrt{{3}^{2}+{4}^{2}+{1}^{2}}} \\\\  & =\\frac{18}{\\sqrt{26}}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14064752/state.json" "file_sha256" "39d1cdab13f8faa7c149d5dbef9031343535aee9c5c7979260d546846638d941"} {"question" "q-19139" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14064752/activity-metadata.json" "file_sha256" "8769ca3505eff33a71aeb1311971d1e441581fde228ecf0d46499691b1e5410b"} {"question" "q-19139" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14064752/state.json" "file_sha256" "39d1cdab13f8faa7c149d5dbef9031343535aee9c5c7979260d546846638d941"} {"question" "q-19139" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{10}{\\sqrt{26}}"] ["math" "\\frac{18}{\\sqrt{14}}"] ["math" "\\frac{18}{\\sqrt{26}}"] ["math" "\\frac{19}{\\sqrt{14}}"] ["math" "\\frac{19}{\\sqrt{26}}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14064752/state.json" "file_sha256" "39d1cdab13f8faa7c149d5dbef9031343535aee9c5c7979260d546846638d941"} {"question" "q-19139" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{18}{\\sqrt{26}}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14064752/state.json" "file_sha256" 