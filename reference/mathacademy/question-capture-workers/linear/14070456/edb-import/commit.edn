b48d7cc0-deda-54c4-a5a3-ddc79936f9e8" 13194139535797 true] [17592186366679 1034 "{r},{t}" 13194139535797 true] [17592186366679 1103 #edb/ref 17592186045453 13194139535797 true] [17592186366679 1111 #uuid "afcd0c4a-83d2-5752-ae51-e865413f5934" 13194139535797 true] [17592186366680 1034 "∅,{r,t}" 13194139535797 true] [17592186366680 1103 #edb/ref 17592186045453 13194139535797 true] [17592186366680 1111 #uuid "cec42cfe-6eae-589b-a99f-3ef70776533b" 13194139535797 true] [17592186366681 1034 "{r},{t},{r,t}" 13194139535797 true] [17592186366681 1103 #edb/ref 17592186045453 13194139535797 true] [17592186366681 1111 #uuid "376440eb-7d5f-5251-a663-e5d5a4ce50cc" 13194139535797 true] [17592186366682 1034 "∅,{r},{t},{r,t}" 13194139535797 true] [17592186366682 1103 #edb/ref 17592186045453 13194139535797 true] [17592186366682 1111 #uuid "94674723-4ab3-52de-85dc-511572ad4dde" 13194139535797 true] [17592186366683 1034 "{r,t}" 13194139535797 true] [17592186366683 1103 #edb/ref 17592186045453 13194139535797 true] [17592186366683 1111 #uuid "03112bdb-2e89-56ab-beef-902da9572cb6" 13194139535797 true] [17592186366684 1017 #edb/ref 17592186366685 13194139535797 true] [17592186366684 1089 "q-105065" 13194139535797 true] [17592186366684 1091 #edb/ref 17592186045465 13194139535797 true] [17592186366684 1100 "Which of the following statements are true for the sets $A={x\\in Z∣x\\le 5}$ and $B={x\\in Z∣-7\\le x<3}?$\n\n- $A⊆B$\n- $B⊆A$\n- $B⊈A$\n- $A⊇B$" 13194139535797 true] [17592186366684 1113 #uuid "6d87f299-b49e-50b2-9b8e-197c261ee00f" 13194139535797 true] [17592186366684 1145 "First, we must find the elements of the sets $A$ and $B.$\n\n- The elements of the set $A$ are all the integer numbers that satisfy the inequality $x\\le 5.$ So, we have\n\n$$\nA={…,-2,-1,0,1,2,3,4,5}.\n$$\n\n- On the other hand, the elements of the set $B$ are all integers that satisfy the inequality $-7\\le x<3.$ So, we have\n\n$$\nB={-7,-6,-5,-4,-3,-2,-1,0,1,2}.\n$$\n\nNow, let's inspect the given statements.\n\n- $A⊆B$ is false.  For example, $5\\in A$ but $5\\notin B.$\n\n- $B⊆A$ is true, while $B⊈A$ is false. Every element in the set $B$ is an element of the set $A.$\n\n- $A⊇B$ is equivalent to $B⊆A,$ which is true.\n\nTherefore, the correct answer is \"II and IV only\"." 13194139535797 true] [17592186366685 1000 #edb/ref 17592186366686 13194139535797 true] [17592186366685 1000 #edb/ref 17592186366687 13194139535797 true] [17592186366685 1000 #edb/ref 17592186366688 13194139535797 true] [17592186366685 1000 #edb/ref 17592186366689 13194139535797 true] [17592186366685 1000 #edb/ref 17592186366690 13194139535797 true] [17592186366685 1040 #edb/ref 17592186045450 13194139535797 true] [17592186366685 1041 "selection" 13194139535797 true] [17592186366685 1104 #edb/ref 17592186366687 13194139535797 true] [17592186366685 1110 #uuid "03816318-2156-51fb-a9d6-f71971bcf414" 13194139535797 true] [17592186366686 1034 "I and III only" 13194139535797 true] [17592186366686 1103 #edb/ref 17592186045454 13194139535797 true] [17592186366686 1111 #uuid "d2e22a02-b744-5948-8be1-8718ed9ade7d" 13194139535797 true] [17592186366687 1034 "II and IV only" 13194139535797 true] [17592186366687 1103 #edb/ref 17592186045454 13194139535797 true] [17592186366687 1111 #uuid "58576262-6947-542b-ae10-b68d549cff64" 13194139535797 true] [17592186366688 1034 "III and IV only" 13194139535797 true] [17592186366688 1103 #edb/ref 17592186045454 13194139535797 true] [17592186366688 1111 #uuid "5f21bb08-5a57-58bd-954b-dd9682883434" 13194139535797 true] [17592186366689 1034 "III only" 13194139535797 true] [17592186366689 1103 #edb/ref 17592186045454 13194139535797 true] [17592186366689 1111 #uuid "172622cd-f422-5c25-9ce1-1c3c4507c66c" 13194139535797 true] [17592186366690 1034 "II only" 13194139535797 true] [17592186366690 1103 #edb/ref 17592186045454 13194139535797 true] [17592186366690 1111 #uuid "36c89114-7b26-5ecd-825e-c7d06dd1d63b" 13194139535797 true] [17592186366691 1017 #edb/ref 17592186366692 13194139535797 true] [17592186366691 1089 "q-1209" 13194139535797 true] [17592186366691 1091 #edb/ref 17592186045463 13194139535797 true] [17592186366691 1100 "Which statement is **not** true?" 13194139535797 true] [17592186366691 1113 #uuid "274e241e-a0c2-5612-a090-edf98e09aacd" 13194139535797 true] [17592186366691 1145 "If $A⊆B,$ then $A$ is a subset of $B,$ meaning that every element of $A$ is an element of $B.$\n\nAmong the given choices, only $Z⊆{Z}^{+}$ is not true. This statement is not true because not every integer is a positive integer. For example, we have $-1\\in Z$ but $-1\\notin {Z}^{+}.$" 13194139535797 true] [17592186366692 1000 #edb/ref 17592186366693 13194139535797 true] [17592186366692 1000 #edb/ref 17592186366694 13194139535797 true] [17592186366692 1000 #edb/ref 17592186366695 13194139535797 true] [17592186366692 1000 #edb/ref 17592186366696 13194139535797 true] [17592186366692 1000 #edb/ref 17592186366697 13194139535797 true] [17592186366692 1040 #edb/ref 17592186045450 13194139535797 true] [17592186366692 1041 "selection" 13194139535797 true] [17592186366692 1104 #edb/ref 17592186366697 13194139535797 true] [17592186366692 1110 #uuid "ebdd904d-b3f1-598e-b1b2-5fd708840195" 13194139535797 true] [17592186366693 1034 "Z⊆Z" 13194139535797 true] [17592186366693 1103 #edb/ref 17592186045453 13194139535797 true] [17592186366693 1111 #uuid "b4bea7f3-823b-5a2e-b495-47442814f85c" 13194139535797 true] [17592186366694 1034 "{Z}^{+}⊆Z" 13194139535797 true] [17592186366694 1103 #edb/ref 17592186045453 13194139535797 true] [17592186366694 1111 #uuid "d9920768-e99e-5c22-8b0c-0bfd7108317e" 13194139535797 true] [17592186366695 1034 "{Z}^{-}⊆Z" 13194139535797 true] [17592186366695 1103 #edb/ref 17592186045453 13194139535797 true] [17592186366695 1111 #uuid "0478eeb5-74b2-5ac3-977d-4d9b667a50dd" 13194139535797 true] [17592186366696 1034 "N⊆Z" 13194139535797 true] [17592186366696 1103 #edb/ref 17592186045453 13194139535797 true] [17592186366696 1111 #uuid "1db94549-6799-5eaa-927f-