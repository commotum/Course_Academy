14 \\\\ 5 & 13\\end{aligned}|.\\end{aligned}\n$$\n\nFinally, according to Cramer's rule, we have\n\n$$\n\\begin{aligned}y & =\\frac{{D}_{y}}{D}=\\frac{|\\begin{aligned}2 & -14 \\\\ 5 & 13\\end{aligned}|}{|\\begin{aligned}2 & 8 \\\\ 5 & 4\\end{aligned}|}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059292/state.json" "file_sha256" "6f28d8663707bdac34d79d0b5fb77fa58ac5ad9a2913fbca7f98996d05e737da"} {"question" "q-139960" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059292/activity-metadata.json" "file_sha256" "7a247b7a09436cd5392e601aa57c65530d21395458140efd75cbf85db83b830f"} {"question" "q-139960" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059292/state.json" "file_sha256" "6f28d8663707bdac34d79d0b5fb77fa58ac5ad9a2913fbca7f98996d05e737da"} {"question" "q-139960" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{|\\begin{aligned}-14 & 2 \\\\ 13 & 5\\end{aligned}|}{|\\begin{aligned}2 & 8 \\\\ 5 & 4\\end{aligned}|}"] ["math" "\\frac{|\\begin{aligned}-14 & 2 \\\\ 13 & 5\\end{aligned}|}{|\\begin{aligned}8 & 2 \\\\ 4 & 5\\end{aligned}|}"] ["math" "\\frac{|\\begin{aligned}2 & -14 \\\\ 5 & 13\\end{aligned}|}{|\\begin{aligned}2 & 8 \\\\ 5 & 4\\end{aligned}|}"] ["math" "\\frac{|\\begin{aligned}2 & -14 \\\\ 5 & 13\\end{aligned}|}{|\\begin{aligned}8 & 2 \\\\ 4 & 5\\end{aligned}|}"] ["math" "\\frac{|\\begin{aligned}2 & -6 \\\\ 5 & 17\\end{aligned}|}{|\\begin{aligned}2 & 8 \\\\ 5 & 4\\end{aligned}|}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14