on" :answer-field/type :answer-field.type/radio :answer-field/correct "q-42607/selection/539ea5bd8e2a40535e641608d1306539fcdeb5188dbc5353f29ce1419467db0c" :answer-field/choices ["q-42607/selection/debe9c1ee098ee19e29ec7780fc7f3c75e2dfae24c373e1aaf7291bc1469e4b9" "q-42607/selection/bfa6d5611593cac214def2eaa2475584f0f93579fdbe95d40a8f1be9d0b12cbc" "q-42607/selection/539ea5bd8e2a40535e641608d1306539fcdeb5188dbc5353f29ce1419467db0c" "q-42607/selection/e95813506824d542f134b2cbbdb58ba3d04fad933935ac9ba072913144fbfbbc" "q-42607/selection/4e7685f3f1740f2e0ef212ddf7f114bfd6d4bdf29c4a48e764bc95c22bf40959"] :db/ensure [:answer-field/validate]} {:db/id "q-42607" :question/id #uuid "6dfded1e-a7d9-55f5-89b7-27037faf3f8d" :question/math-academy-id "q-42607" :question/problem "Consider the system of equations\n\n$$\n{\\begin{aligned}4x+6y=32 \\\\ 3x+5y=26.\\end{aligned}\n$$\n\nAccording to Cramer's rule, $x=$" :question/worked-solution "We are given the system\n\n$$\n{\\begin{aligned}4x+6y=32 \\\\ 3x+5y=26.\\end{aligned}\n$$\n\nThe determinant of the coefficient matrix is\n\n$$\n\\begin{aligned}D & =|\\begin{aligned}4 & 6 \\\\ 3 & 5\\end{aligned}|.\\end{aligned}\n$$\n\nNow, we construct ${D}_{x}$, we replace the first column of the coefficient matrix by the right-hand side column of the given system:\n\n$$\n\\begin{aligned}{D}_{x} & =|\\begin{aligned}32 & 6 \\\\ 26 & 5\\end{aligned}|.\\end{aligned}\n$$\n\nFinally, according to Cramer's rule, we have\n\n$$\n\\begin{aligned}x & =\\frac{{D}_{x}}{D}=\\frac{|\\begin{aligned}32 & 6 \\\\ 26 & 5\\end{aligned}|}{|\\begin{aligned}4 & 6 \\\\ 3 & 5\\end{aligned}|}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-42607/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4fcf3704-4856-5095-a6f4-7ec20d81f3c4"] :knowledge-point/questions ["q-42607"] :db/ensure [:knowledge-point/validate]} {:db/id "q-77398/selection/6244f7825d23dd69bac77f78280640814ab32cb3ba1586dfd8e81ada4e2937df" :answer/id #uuid "2b1b4cca-6a1c-52b9-a70a-092c79f76feb" :answer/type :answer.type/math :answer/value "\\frac{|\\begin{aligned}5 & 2 \\\\ 2 & -3\\end{aligned}|}{|\\begin{aligned}4 & 2 \\\\ 1 & -3\\end{aligned}|}" :db/ensure [:answer/validate]} {:db/id "q-77398/selection/7b2e659f81d6362df91b24ae9604a1842bb23d66c1654c61812d0b5b99723dd6" :answer/id #uuid "d66fcc06-0477-5fa1-b879-13e3adf7640a" :answer/type :answer.type/math :answer/value "\\frac{|\\begin{aligned}4 & 5 \\\\ 1 & 2\\end{aligned}|}{|\\begin{aligned}4 & 2 \\\\ 1 & -3\\end{aligned}|}" :db/ensure [:answer/validate]} {:db/id "q-77398/selection/f790f51e3a5c7a3987817bb39dc7ee248cd9eccf66a467397fca4696776a7575" :answer/id #uuid "bdc4c6fa-c7c1-579d-b242-0136f36a56a7" :answer/type :answer.type/math :answer/value "\\frac{|\\begin{aligned}4 & 2 \\\\ 1 & -3\\end{aligned}|}{|\\begin{aligned}5 & 2 \\\\ 2 & -3\\end{aligned}|}" :db/ensure [:answer/validate]} {:db/id "q-77398/selection/4c4ad4b8ac02be40629cf15f2b6950e63481be949c8bfe8f46692a5789856357" :answer/id #uuid "d6804615-a03f-5769-89d6-0139222dac77" :answer/type :answer.type/math :answer/value "\\frac{|\\begin{aligned}4 & 1 \\\\ 2 & 3\\end{aligned}|}{|\\begin{aligned}4 & 2 \\\\ 1 & -3\\end{aligned}|}" :db/ensure [:answer/validate]} {:db/id "q-77398/selection/a352a6a076334e3b692cba8e5b6bf72ff52ce14743a231a07d8e804e25b20b8f" :answer/id #uuid "5382a98c-bffb-5d5f-832c-c7819b38eafe" :answer/type :answer.type/math :answer/value "\\frac{|\\begin{aligned}4 & 2 \\\\ 1 & -3\\end{aligned}|}{|\\begin{aligned}4 & 5 \\\\ 1 & 2\\end{aligned}|}" :db/ensure [:answer/validate]} {:db/id "q-77398/selection" :answer-field/id #uuid "259ff49f-f819-556d-8fce-1ebefe1e16d7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-77398/selection/7b2e659f81d6362df91b24ae9604a1842bb23d66c1654c61812d0b5b99723dd6" :answer-field/choices ["q-77398/selection/6244f7825d23dd69bac77f78280640814ab32cb3ba1586dfd8e81ada4e2937df" "q-77398/selection/7b2e659f81d6362df91b24ae9604a1842bb23d66c1654c61812d0b5b99723dd6" "q-77398/selection/f790f51e3a5c7a3987817bb39dc7ee248cd9eccf66a467397fca4696776a7575" "q-77398/selection/4c4ad4b8ac02be40629cf15f2b6950e63481be949c8bfe8f46692a5789856357" "q-77398/selection/a352a6a076334e3b692cba8e5b6bf72ff52ce14743a231a07d8e804e25b20b8f"] :db/ensure [:answer-field/validate]} {:db/id "q-77398" :question/id #uuid "94153e84-a333-5aec-b75c-49c1a118f48c" :question/math-academy-id "q-77398" :question/problem "Consider the system of equations \n\n$$\n{\\begin{aligned}4x+2y=5 \\\\ x-3y=2.\\end{aligned}\n$$\n\nAccording to Cramer's rule, $y=$" :question/worked-solution "We are given the system\n\n$$\n{\\begin{aligned}4x+2y=5 \\\\ x-3y=2.\\end{aligned}\n$$\n\nThe determinant of the coefficient matrix is\n\n$$\n\\begin{aligned}D & =|\\begin{aligned}4 & 2 \\\\ 1 & -3\\end{aligned}|.\\end{aligned}\n$$\n\nNow, to construct ${D}_{y}$ we replace the second column of the coefficient matrix by the right-hand side column of the given system:\n\n$$\n\\begin{aligned}{D}_{y} & =|\\begin{aligned}4 & 5 \\\\ 1 & 2\\end{aligned}|.\\end{aligned}\n$$\n\nFinally, according to Cramer's rule, we have\n\n$$\n\\begin{aligned}y & =\\frac{{D}_{y}}{D}=\\frac{|\\begin{aligned}4 & 5 \\\\ 1 & 2\\end{aligned}|}{|\\begin{aligned}4 & 2 \\\\ 1 & -3\\end{aligned}|}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-77398/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4fcf3704-4856-5095-a6f4-7ec20d81f3c4"] :knowledge-point/questions ["q-77398"] :db/ensure [:knowledge-point/validate]} {:db/id "q-77400/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "6a849391-049e-5155-927a-b2988a5b6646" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-77400/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "7203f23b-8a1a-565d-8148-3c42049259b0" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-77400/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "42681e5b-6888-52c8-9ed4-7dbbebbafab8" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-77400/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "dbcd1748-b376-5df1-8db0-b1ae41e5df24" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-77400/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "45a679bd-d562-5041-aabe-d65749d03bdb" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-77400/selection" :answer-field/id #uuid "0e53c100-1fca-5ca9-9f15-0b515cdfbd84" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-77400/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer-field/choices ["q-77400/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-77400/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-77400/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-77400/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-77400/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6"] :db/ensure [:answer-field/validate]} {:db/id "q-77400" :question/id #uuid "756e58e6-b552-5d33-821c-20311fcd965f" :question/math-academy-id "q-77400" :question/problem "Let $⟨x,-2⟩$ be the solution of the system of equations below. \n\n$$\n{\\begin{aligned}x-y=2 \\\\ 2x+y=k\\end{aligned}\n$$\n\nWhich of the following equations could be solved to find the value of $k?$\n\n- $|\\begin{aligned}1 & 2 \\\\ 2 & k\\end{aligned}|=-6$\n- $|\\begin{aligned}1 & 2 \\\\ 2 & k\\end{aligned}|=-12$\n- $|\\begin{aligned}1 & 2 \\\\ 2 & k\\end{aligned}|=3$" :question/worked-solution "The determinant of the coefficient matrix is\n\n$$\n\\begin{aligned}D & =|\\begin{aligned}1 & -1 \\\\ 2 & 1\\end{aligned}| \\\\  & =1+2 \\\\  & =3.\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $y$ is given by $y=\\frac{{D}_{y}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{y} & =|\\begin{aligned}1 & 2 \\\\ 2 & k\\end{aligned}|.\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}y & =\\frac{{D}_{y}}{D} \\\\ -2 & =\\frac{|\\begin{aligned}1 & 2 \\\\ 2 & k\\end{aligned}|}{3} \\\\ |\\begin{aligned}1 & 2 \\\\ 2 & k\\end{aligned}| & =-6\\end{aligned}\n$$\n\nSo, the correct answer is \"I only\"." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-77400/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bd9b0f65-d8a3-57c4-88c5-2738b0938c0d"] :knowledge-point/questions ["q-77400"] :db/ensure [:knowledge-point/validate]} {:db/id "q-42984/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "faa1a6ab-a8a3-5cf4-b804-f7a54df193c9" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-42984/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "51af9672-5581-53c7-87e0-9cc6c3346f64" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-42984/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "49349261-72ae-578a-9fed-d2b0ad8464b2" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-42984/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "db4c549a-520d-5bec-ab5b-0cde986a55e9" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-42984/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "c706bdd6-e086-5e4e-9b5c-093007ca1468" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-42984/selection" :answer-field/id #uuid "4cea0d5a-09a5-54a4-9b3c-c55cc44107a8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-42984/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer-field/choices ["q-42984/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-42984/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-42984/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-42984/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-42984/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981"] :db/ensure [:answer-field/validate]} {:db/id "q-42984" :question/id #uuid "953305f0-133b-50fe-9ae2-f34d2c4d063f" :question/math-academy-id "q-42984" :question/problem "Let $⟨-1,y⟩$ be the solution of the system of equations below. \n\n$$\n{\\begin{aligned}3x+5y=k \\\\ 2x-y=-4.\\end{aligned}\n$$\n\nWhich of the following equations could be solved to find the value of $k?$\n\n- $|\\begin{aligned}k & 5 \\\\ -4 & -1\\end{aligned}|=-13$\n- $|\\begin{aligned}k & 5 \\\\ -4 & -1\\end{aligned}|=-1$\n- $|\\begin{aligned}k & 5 \\\\ -4 & -1\\end{aligned}|=13$" :question/worked-solution "The determinant of the coefficient matrix is\n\n$$\n\\begin{aligned}D & =|\\begin{aligned}3 & 5 \\\\ 2 & -1\\end{aligned}| \\\\  & =-3-10 \\\\  & -13.\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $x$ is given by $x=\\frac{{D}_{x}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{x} & =|\\begin{aligned}k & 5 \\\\ -4 & -1\\end{aligned}|.\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}x & =\\frac{{D}_{x}}{D} \\\\ -1 & =\\frac{|\\begin{aligned}k & 5 \\\\ -4 & -1\\end{aligned}|}{-13} \\\\ |\\begin{aligned}k & 5 \\\\ -4 & -1\\end{aligned}| & =(-1)(-13) \\\\ |\\begin{aligned}k & 5 \\\\ -4 & -1\\end{aligned}| & =13\\end{aligned}\n$$\n\nSo, the correct answer is \"III only\"." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-42984/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bd9b0f65-d8a3-57c4-88c5-2738b0938c0d"] :knowledge-point/questions ["q-42984"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-42612"] :question/problem "Let $⟨x,-3⟩$ be the solution of the system of equations below. \n\n$$\n{\\begin{aligned}5x-y=k \\\\ -2x+4y=-12\\end{aligned}\n$$\n\nWhich of the following equations could be solved to find the value of $k?$\n\n- $|\\begin{aligned}5 & k \\\\ -2 & -12\\end{aligned}|=-6$\n- $|\\begin{aligned}5 & k \\\\ -2 & -12\\end{aligned}|=-54$\n- $|\\begin{aligned}5 & k \\\\ -2 & -12\\end{aligned}|=18$" :question/worked-solution "The determinant of the coefficient matrix is\n\n$$\n\\begin{aligned}D & =|\\begin{aligned}5 & -1 \\\\ -2 & 4\\end{aligned}| \\\\  & =20-2 \\\\  & =18.\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $y$ is given by $y=\\frac{{D}_{y}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{y} & =|\\begin{aligned}5 & k \\\\ -2 & -12\\end{aligned}|.\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}y & =\\frac{{D}_{y}}{D} \\\\ -3 & =\\frac{|\\begin{aligned}5 & k \\\\ -2 & -12\\end{aligned}|}{18} \\\\ |\\begin{aligned}5 & k \\\\ -2 & -12\\end{aligned}| & =-54\\end{aligned}\n$$\n\nSo, the correct answer is \"II only\"." :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5230"] :question/problem "Consider the system of linear equations\n\n$$\n{\\begin{aligned}x-y=2 \\\\ 2x+y=1.\\end{aligned}\n$$\n\n \nAccording to Cramer's rule, the unknown $x$ can be written as\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059292/assets/2d3571405367c6d4ce15927a1dbdb50a30af7d13580c7b9cd3c73bada0583c98.png)\nExpress $D_x$ in terms of a $2 \\times 2$ determinant." :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4578"] :question/problem "Let $\\langle x,3 \\rangle$ be the solution of the system of equations below. \n\n$$\n{\\begin{aligned}5x-2y=4 \\\\ x+ky=8\\end{aligned}\n$$\n\nWhich of the following equations could be solved to find the value of $k?$\n\n- ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059292/assets/a404c14afc5aeda319edcad04d7ea6f7f9ee0631f3a86c567a48f448dc21de8e.png)\n\n- ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059292/assets/648ce0c1b8b77c1230c6c634c676624f9c79c12ffc3942abc09d24d0fdc424d3.png)\n\n- ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059292/assets/f23784cb494ee42a65b07597b9f287b107b81502fba3a51b22344d804ee937a8.png)" :db/ensure [:question/validate]}]
