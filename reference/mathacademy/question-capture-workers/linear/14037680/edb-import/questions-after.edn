#{[{:db/id #edb/ref 17592186128808 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "2eb8c35b-b52f-544e-be33-798406a23ade" :knowledge-point/title "Identifying Equivalent Sets"}] :question/id #uuid "3bd3df25-3a96-518d-9c34-4a17b06dd78c" :question/math-academy-id "e-13146" :question/problem "Which of the following sets is equivalent to $S = \\{2, 4, 8, 2, 4, 2\\}?$ \n\n- $\\{\\{2\\},4,8\\}$\n\n- $\\{2,4,8\\}$\n\n- $\\{2,8\\}$" :question/worked-solution "Two sets are equivalent if they contain the same elements. It doesn't matter if the elements are listed differently or if one set has duplicates and the other does not.\n\nTo determine which of the given sets is equivalent to $S,$ we start by listing the elements of $S,$ ignoring any duplicates:\n\n$$\n2, \\qquad 4, \\qquad 8\n$$\n\nTherefore, the only set equivalent to $S$ is $\\{2,4,8\\}$ since it contains the same elements as $S.$\n\nThe other sets are not equivalent to $S{:}$\n\n- $\\{\\{2\\},4,8\\}$ has the element $\\{2\\}$ that is not in $S.$  Note that $\\{2\\}\\neq 2$.\n\n- $\\{2,8\\}$ is missing the element $4.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186128809 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "e1e872ac-ef9b-50d5-b74f-3f861cdda8f6" :knowledge-point/title "Identifying Equivalent Special Sets"}] :question/id #uuid "ab3bd4ba-9fe3-58f2-88b5-f8ae71e1f038" :question/math-academy-id "e-13286" :question/problem "Which of the following sets are equivalent to $A = \\{0, 1, 2, 3, \\ldots\\} ?$\n\n- $\\mathbb{N}$\n\n- $\\mathbb{N}_{0}$\n\n- $\\mathbb{Z}$\n\n- $\\mathbb{Z}^{+}$" :question/worked-solution "The set $A$ is the set of positive integers and zero. It is denoted by $\\mathbb{N}_{0}$.\n\nTherefore, the correct answer is $\\mathbb{N}_{0}.$\n\nThe other options are *not* equivalent to $A{:}$\n\n- The set $\\mathbb{N}$ does not include the element zero, and $0\\in A.$\n\n- The set $\\mathbb{Z}$ includes the elements $-1,-2,-3,\\ldots,$ and $-1 \\not \\in A, -2\\notin A, -3\\notin A, \\ldots\\,.$\n\n- The set $\\mathbb{Z}^{+}$ does not include the element zero, and $0\\in A.$"}] [{:db/id #edb/ref 17592186128810 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "1d478c5a-3a9e-5219-8111-2cfc828a609a" :knowledge-point/title "Equivalent Sets Containing Sets"}] :question/id #uuid "bf364612-7182-5bf5-85c0-999062a07faa" :question/math-academy-id "e-13287" :question/problem "Which of the following sets are equivalent to $S = \\{ a, \\{ b \\}, c, \\{ b \\}, a \\}?$\n\n- $\\{ a, \\{b\\}, c \\}$\n\n- $\\{ a, c, b, \\{b\\} \\}$\n\n- $\\{ a, \\{b\\}, c, d \\}$" :question/worked-solution "Two sets are equivalent if they contain the same elements. It doesn't matter if the elements are listed differently or if one set has duplicates and the other does not.\n\nTo determine which of the given sets is equivalent to $S,$ we start by listing the elements of $S,$ ignoring any duplicates:\n\n$$\na, \\qquad \\{b\\}, \\qquad c\n$$\n\nTherefore, the only set equivalent to $S$ is $\\{ a, \\{b\\}, c \\}$ since it contains the same elements as $S.$\n\nThe other sets are not equivalent to $S{:}$\n\n- Set II *not* equivalent to $S.$ It has an element $b$ that is not in $S.$ Note that $\\{b\\} \\neq b.$\n\n- Set III is *not* equivalent to $S.$ It has an element $d$ that is not in $S.$\n\nTherefore, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186297732 :knowledge-point/_questions [{:knowledge-point/id #uuid "1d478c5a-3a9e-5219-8111-2cfc828a609a" :knowledge-point/title "Equivalent Sets Containing Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5077221-34db-5974-b966-4fe82a633df1" :answer/type {:db/ident :answer.type/math} :answer/value "{0,1,{1},2,{0}}" :db/id #edb/ref 17592186297734} {:answer/id #uuid "19845da1-3a20-500e-a250-ee19d92a74ce" :answer/type {:db/ident :answer.type/math} :answer/value "{0,1,{0,1},{0},{1}}" :db/id #edb/ref 17592186297735} {:answer/id #uuid "b022c4e6-1d12-59f3-99d3-3bfe4921b1c9" :answer/type {:db/ident :answer.type/math} :answer/value "{0,1,{0},{1}}" :db/id #edb/ref 17592186297736} {:answer/id #uuid "fd10b6dd-275a-5eca-b95a-771de1143e34" :answer/type {:db/ident :answer.type/math} :answer/value "{{0},0,1}" :db/id #edb/ref 17592186297737} {:answer/id #uuid "0ea9e045-faa1-5c5a-aea8-b397fce7dd35" :answer/type {:db/ident :answer.type/math} :answer/value "{0,1,{1}}" :db/id #edb/ref 17592186297738}] :answer-field/correct {:answer/id #uuid "b022c4e6-1d12-59f3-99d3-3bfe4921b1c9" :answer/type {:db/ident :answer.type/math} :answer/value "{0,1,{0},{1}}" :db/id #edb/ref 17592186297736} :answer-field/id #uuid "078835d0-f253-5599-8106-01cebf808753" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297733}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "26d0ae9a-cd8a-5695-b354-4253c50dee18" :question/math-academy-id "q-180821" :question/problem "Which set is equivalent to $S={0,{1},{0},1,0,{0}}?$" :question/worked-solution "Two sets are equivalent if they contain the same elements. It doesn't matter if the elements are listed differently or if one set has duplicates and the other does not.\n\nTo determine which of the given sets is equivalent to $S,$ we start by listing the elements of $S,$ ignoring any duplicates:\n\n$$\n0,\\,{1},\\,{0},\\,1\n$$\n\nTherefore, the only set equivalent to $S$ is ${0,1,{0},{1}}$ since it contains the same elements as $S.$\n\nThe other sets are not equivalent to $S:$\n\n- ${0,1,{1}}$ is missing the element ${0}$ (note that ${0}\\ne 0$).\n\n- ${{0},0,1}$ is missing the element ${1}$ (note that ${1}\\ne 1$).\n\n- ${0,1,{0,1},{0},{1}}$ has the element ${0,1}$ that is not in $S.$\n\n- ${0,1,{1},2,{0}}$ has the element $2$ that is not in $S.$"}] [{:db/id #edb/ref 17592186297739 :knowledge-point/_questions [{:knowledge-point/id #uuid "1d478c5a-3a9e-5219-8111-2cfc828a609a" :knowledge-point/title "Equivalent Sets Containing Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c19f3eb-6f75-5421-945e-2af4ffd8120e" :answer/type {:db/ident :answer.type/math} :answer/value "{{y},z}" :db/id #edb/ref 17592186297741} {:answer/id #uuid "f3b9461c-9e16-518f-8748-6c32c9708b13" :answer/type {:db/ident :answer.type/math} :answer/value "{x,{y},z}" :db/id #edb/ref 17592186297742} {:answer/id #uuid "0088216c-eef7-5484-9dca-078769849320" :answer/type {:db/ident :answer.type/math} :answer/value "{x,{y},{x,z}}" :db/id #edb/ref 17592186297743} {:answer/id #uuid "b52d7c32-ab75-585d-b2a5-e8e223af8e15" :answer/type {:db/ident :answer.type/math} :answer/value "{{x},{y},{x,z}}" :db/id #edb/ref 17592186297744} {:answer/id #uuid "21144741-baf6-5f09-a181-3230b1fdedf6" :answer/type {:db/ident :answer.type/math} :answer/value "{x,y,{x,z}}" :db/id #edb/ref 17592186297745}] :answer-field/correct {:answer/id #uuid "0088216c-eef7-5484-9dca-078769849320" :answer/type {:db/ident :answer.type/math} :answer/value "{x,{y},{x,z}}" :db/id #edb/ref 17592186297743} :answer-field/id #uuid "27803171-3b21-5d8a-87ce-046b8d341bee" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297740}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a15ebe02-5641-5cee-8a96-d7127c15c7ea" :question/math-academy-id "q-180827" :question/problem "Which set is equivalent to $R={x,{y},{x,z},{y}}?$" :question/worked-solution "Two sets are equivalent if they contain the same elements. It doesn't matter if the elements are listed differently or if one set has duplicates and the other does not.\n\nTo determine which of the given sets is equivalent to $R,$ we start by listing the elements of $R,$ ignoring any duplicates:\n\n$$\nx,\\,{y},\\,{x,z}\n$$\n\nTherefore, the only set equivalent to $R$ is ${x,{y},{x,z}}$ since it contains the same elements as $R.$\n\nThe other sets are not equivalent to $R:$\n\n- ${x,{y},z}$ has the element $z$ that is not in $R.$\n\n- ${{x},{y},{x,z}}$ is missing the element $x$ $($note that ${x}\\ne x).$\n\n- ${{y},z}$ has the element $z$ that is not in $R.$\n\n- ${x,y,{x,z}}$ is missing the element ${y}$ $($note that $y\\ne {y}).$"}] [{:db/id #edb/ref 17592186297746 :knowledge-point/_questions [{:knowledge-point/id #uuid "2eb8c35b-b52f-544e-be33-798406a23ade" :knowledge-point/title "Identifying Equivalent Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85a7015f-d302-5f91-91f5-584a01ffb093" :answer/type {:db/ident :answer.type/math} :answer/value "{{a},{b},{c},d}" :db/id #edb/ref 17592186297748} {:answer/id #uuid "b772a6f6-8abe-57ef-b3b8-0049861c8078" :answer/type {:db/ident :answer.type/math} :answer/value "{a,b,c,d}" :db/id #edb/ref 17592186297749} {:answer/id #uuid "9eb885af-1898-5483-92e7-0aa7184796b7" :answer/type {:db/ident :answer.type/math} :answer/value "{a,b,c}" :db/id #edb/ref 17592186297750} {:answer/id #uuid "8e65cd28-6839-515f-87f7-3204e4736328" :answer/type {:db/ident :answer.type/math} :answer/value "{b,c,d}" :db/id #edb/ref 17592186297751} {:answer/id #uuid "8b893584-a0b6-5234-a2b9-8b62b8f39a56" :answer/type {:db/ident :answer.type/math} :answer/value "{{a},b,c,d}" :db/id #edb/ref 17592186297752}] :answer-field/correct {:answer/id #uuid "b772a6f6-8abe-57ef-b3b8-0049861c8078" :answer/type {:db/ident :answer.type/math} :answer/value "{a,b,c,d}" :db/id #edb/ref 17592186297749} :answer-field/id #uuid "949a4933-8585-5a38-b542-afed4ce26394" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297747}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "97912352-2548-543e-bc3c-d12e911318aa" :question/math-academy-id "q-181611" :question/problem "Which set is equivalent to $R={a,b,a,c,a,d}?$" :question/worked-solution "Two sets are equivalent if they contain the same elements. It doesn't matter if the elements are listed differently or if one set has duplicates and the other does not.\n\nTo determine which of the given sets is equivalent to $R,$ we start by listing the elements of $R,$ ignoring any duplicates:\n\n$$\na,\\,b,\\,c,\\,d\n$$\n\nTherefore, the only set equivalent to $R$ is ${a,b,c,d}$ since it contains the same elements as $R.$\n\nThe other sets are not equivalent to $R:$\n\n- ${{a},b,c,d}$ is missing the element $a.$ Note that ${a}\\ne a.$\n\n- ${a,b,c}$ is missing the element $d.$\n\n- ${b,c,d}$ is missing the element $a.$\n\n- ${{a},{b},{c},d}$ is missing the elements $a,b$ and $c.$ Note that ${a}\\ne a,{b}\\ne b,$ and ${c}\\ne c.$"}] [{:db/id #edb/ref 17592186297753 :knowledge-point/_questions [{:knowledge-point/id #uuid "2eb8c35b-b52f-544e-be33-798406a23ade" :knowledge-point/title "Identifying Equivalent Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad80f17b-6404-5075-8f58-3efa3db1065d" :answer/type {:db/ident :answer.type/math} :answer/value "{{p},q,r,s,t}" :db/id #edb/ref 17592186297755} {:answer/id #uuid "eceb6742-c1bb-5891-b772-8a63f2295947" :answer/type {:db/ident :answer.type/math} :answer/value "{p,q,r}" :db/id #edb/ref 17592186297756} {:answer/id #uuid "02501329-2b83-5b37-9230-e84f9abe5b53" :answer/type {:db/ident :answer.type/math} :answer/value "{{p},{q},{r},s,t}" :db/id #edb/ref 17592186297757} {:answer/id #uuid "1abea8c9-7e57-5703-8782-c8849f0d8ce1" :answer/type {:db/ident :answer.type/math} :answer/value "{p,{q},r,s}" :db/id #edb/ref 17592186297758} {:answer/id #uuid "040a03e4-9e2e-5bc7-a8ed-32c490113f7e" :answer/type {:db/ident :answer.type/math} :answer/value "{r,s,t,p,q}" :db/id #edb/ref 17592186297759}] :answer-field/correct {:answer/id #uuid "040a03e4-9e2e-5bc7-a8ed-32c490113f7e" :answer/type {:db/ident :answer.type/math} :answer/value "{r,s,t,p,q}" :db/id #edb/ref 17592186297759} :answer-field/id #uuid "4236f78c-e9be-5214-8ac0-5f7fc94ddd45" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297754}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "cb088985-7b32-5dbf-8f78-6e770407e9dc" :question/math-academy-id "q-181612" :question/problem "Which set is equivalent to $S={p,q,r,p,s,t}?$" :question/worked-solution "Two sets are equivalent if they contain the same elements. It doesn't matter if the elements are listed differently or if one set has duplicates and the other does not.\n\nTo determine which of the given sets is equivalent to $S,$ we start by listing the elements of $S,$ ignoring any duplicates:\n\n$$\np,\\,q,\\,r,\\,s,\\,t\n$$\n\nTherefore, the only set equivalent to $S$ is ${r,s,t,p,q}$ since it contains the same elements as $S.$\n\nThe other sets are not equivalent to $S:$\n\n- ${p,q,r}$ is missing the elements $s$ and $t.$\n\n- ${{p},q,r,s,t}$ is missing the element $p.$ Note that ${p}\\ne p.$\n\n- ${p,{q},r,s}$ is missing the elements $q$ and $t.$ Note that ${q}\\ne q.$\n\n- ${{p},{q},{r},s,t}$ is missing the elements $p,q$ and $r.$ Note that ${p}\\ne p,{q}\\ne q,$ and ${r}\\ne r.$"}] [{:db/id #edb/ref 17592186297760 :knowledge-point/_questions [{:knowledge-point/id #uuid "2eb8c35b-b52f-544e-be33-798406a23ade" :knowledge-point/title "Identifying Equivalent Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "409761b5-020c-5990-b65f-e410a01fbeec" :answer/type {:db/ident :answer.type/math} :answer/value "{6,12,9,3}" :db/id #edb/ref 17592186297762} {:answer/id #uuid "34f2935d-2586-5bf0-96ed-35617e26492a" :answer/type {:db/ident :answer.type/math} :answer/value "{3,6,{12}}" :db/id #edb/ref 17592186297763} {:answer/id #uuid "79fc7376-27e7-555b-a317-c1ecae44d08a" :answer/type {:db/ident :answer.type/math} :answer/value "{{3,6,9},12}" :db/id #edb/ref 17592186297764} {:answer/id #uuid "ded600e0-f7a3-53db-bd01-c79d065eb3f2" :answer/type {:db/ident :answer.type/math} :answer/value "{3,6,9}" :db/id #edb/ref 17592186297765} {:answer/id #uuid "9c4a5957-beed-5f26-ab4b-ce8391208032" :answer/type {:db/ident :answer.type/math} :answer/value "{1,3,6,9,12}" :db/id #edb/ref 17592186297766}] :answer-field/correct {:answer/id #uuid "409761b5-020c-5990-b65f-e410a01fbeec" :answer/type {:db/ident :answer.type/math} :answer/value "{6,12,9,3}" :db/id #edb/ref 17592186297762} :answer-field/id #uuid "f9687e60-cb29-53d4-a62c-4df44c32ff61" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297761}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "05f9b24b-6110-5a26-9145-2ab603fcf34d" :question/math-academy-id "q-181613" :question/problem "Which set is equivalent to $S={3,3,6,9,12,6,9}?$" :question/worked-solution "Two sets are equivalent if they contain the same elements. It doesn't matter if the elements are listed differently or if one set has duplicates and the other does not.\n\nTo determine which of the given sets is equivalent to $S,$ we start by listing the elements of $S,$ ignoring any duplicates:\n\n$$\n3,\\,6,\\,9,\\,12\n$$\n\nTherefore, the only set equivalent to $S$ is ${6,12,9,3}$ since it contains the same elements as $S.$\n\nThe other sets are not equivalent to $S:$\n\n- ${{3,6,9},12}$ is missing the elements $3,6,$ and $9.$\n\n- ${3,6,9}$ is missing the element $12.$\n\n- ${3,6,{12}}$ is missing the elements $9$ and $12.$ Note that ${12}\\ne 12.$\n\n- ${1,3,6,9,12}$ has the element $1,$ which is not in $S.$"}] [{:db/id #edb/ref 17592186297767 :knowledge-point/_questions [{:knowledge-point/id #uuid "2eb8c35b-b52f-544e-be33-798406a23ade" :knowledge-point/title "Identifying Equivalent Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bad78f1f-19a9-5629-a79c-418e41b0054a" :answer/type {:db/ident :answer.type/math} :answer/value "{{4},1,5}" :db/id #edb/ref 17592186297769} {:answer/id #uuid "610bf195-4ce3-522b-9646-15b6689aba89" :answer/type {:db/ident :answer.type/math} :answer/value "{{5},{1},4}" :db/id #edb/ref 17592186297770} {:answer/id #uuid "e2bbdd09-c6dc-5aaa-82ac-b6065fa9c897" :answer/type {:db/ident :answer.type/math} :answer/value "{1,5}" :db/id #edb/ref 17592186297771} {:answer/id #uuid "b841909a-d993-5074-9d73-f0e65bd2208b" :answer/type {:db/ident :answer.type/math} :answer/value "{1,4,5}" :db/id #edb/ref 17592186297772} {:answer/id #uuid "0178b5e1-8fca-583c-8da1-6dc261a3e489" :answer/type {:db/ident :answer.type/math} :answer/value "{1,…,5}" :db/id #edb/ref 17592186297773}] :answer-field/correct {:answer/id #uuid "b841909a-d993-5074-9d73-f0e65bd2208b" :answer/type {:db/ident :answer.type/math} :answer/value "{1,4,5}" :db/id #edb/ref 17592186297772} :answer-field/id #uuid "b0dc5151-f0df-5e1f-bd73-2e1c536e0cc0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297768}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "07d71c33-0306-5ce3-88f1-c7c0184f3839" :question/math-academy-id "q-181615" :question/problem "Which set is equivalent to $S={5,1,1,4,1,5}?$" :question/worked-solution "Two sets are equivalent if they contain the same elements. It doesn't matter if the elements are listed differently or if one set has duplicates and the other does not.\n\nTo determine which of the given sets is equivalent to $S,$ we start by listing the elements of $S,$ ignoring any duplicates:\n\n$$\n5,\\,1,\\,4\n$$\n\nTherefore, the only set equivalent to $S$ is ${1,4,5}$ since it contains the same elements as $S.$\n\nThe other sets are not equivalent to $S:$\n\n- ${1,5}$ is missing the element $4.$\n\n- ${{5},{1},4}$ is missing the elements $5$ and $1.$ Note that ${5}\\ne 5$ and ${1}\\ne 1.$\n\n- ${1,…,5}$ means ${1,2,3,4,5}$ has the elements $2$ and $3,$ which are not in $S.$\n\n- ${{4},1,5}$ is missing the element $4.$ Note that ${4}\\ne 4.$"}] [{:db/id #edb/ref 17592186297774 :knowledge-point/_questions [{:knowledge-point/id #uuid "2eb8c35b-b52f-544e-be33-798406a23ade" :knowledge-point/title "Identifying Equivalent Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e4fd86ec-81cc-5961-958c-169353194c32" :answer/type {:db/ident :answer.type/math} :answer/value "{{u},w,x}" :db/id #edb/ref 17592186297776} {:answer/id #uuid "5f3859a7-d676-595b-ba75-08ccc53b9394" :answer/type {:db/ident :answer.type/math} :answer/value "{{u},{w},{v},x}" :db/id #edb/ref 17592186297777} {:answer/id #uuid "c4c46ddd-862b-5903-a331-6e88b2acad7e" :answer/type {:db/ident :answer.type/math} :answer/value "{u,w,x}" :db/id #edb/ref 17592186297778} {:answer/id #uuid "b8a3fa92-4b99-52f0-b030-73abfad3d98f" :answer/type {:db/ident :answer.type/math} :answer/value "{u,v,w}" :db/id #edb/ref 17592186297779} {:answer/id #uuid "7b995549-93bd-54f8-99b2-c59113141419" :answer/type {:db/ident :answer.type/math} :answer/value "{x,u,v,w}" :db/id #edb/ref 17592186297780}] :answer-field/correct {:answer/id #uuid "7b995549-93bd-54f8-99b2-c59113141419" :answer/type {:db/ident :answer.type/math} :answer/value "{x,u,v,w}" :db/id #edb/ref 17592186297780} :answer-field/id #uuid "b86638ab-1590-59d7-938b-b95aaa584d73" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297775}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9f3ae0d9-8ae4-5f96-ade9-f6e740d43fa2" :question/math-academy-id "q-181619" :question/problem "Which set is equivalent to $S={u,v,u,w,x,w}?$" :question/worked-solution "Two sets are equivalent if they contain the same elements. It doesn't matter if the elements are listed differently or if one set has duplicates and the other does not.\n\nTo determine which of the given sets is equivalent to $S,$ we start by listing the elements of $S,$ ignoring any duplicates:\n\n$$\nu,\\,v,\\,w,\\,x\n$$\n\nTherefore, the only set equivalent to $S$ is ${x,u,v,w}$ since it contains the same elements as $S.$\n\nThe other sets are not equivalent to $S:$\n\n- ${u,v,w}$ is missing the element $x.$\n\n- ${u,w,x}$ is missing the element $v.$\n\n- ${{u},w,x}$ is missing the elements $u$ and $v.$ Note that ${u}\\ne u.$\n\n- ${{u},{w},{v},x}$ is missing the elements $u,w$ and $v.$ Note that ${u}\\ne u,{w}\\ne w,$ and ${v}\\ne v.$"}] [{:db/id #edb/ref 17592186297781 :knowledge-point/_questions [{:knowledge-point/id #uuid "1d478c5a-3a9e-5219-8111-2cfc828a609a" :knowledge-point/title "Equivalent Sets Containing Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a9be15a8-178c-57c3-b7c1-d48e1378c454" :answer/type {:db/ident :answer.type/math} :answer/value "{2,{2},4,{2,4}}" :db/id #edb/ref 17592186297783} {:answer/id #uuid "a66528b1-2292-5185-b45f-2490273168c8" :answer/type {:db/ident :answer.type/math} :answer/value "{2,4}" :db/id #edb/ref 17592186297784} {:answer/id #uuid "a8ab0e57-d1ac-5be3-a71a-5da55f2d94f5" :answer/type {:db/ident :answer.type/math} :answer/value "{{2},{2,4}}" :db/id #edb/ref 17592186297785} {:answer/id #uuid "a37cd99a-ef4b-57c4-8c47-d2efb207c6dc" :answer/type {:db/ident :answer.type/math} :answer/value "{2,4,{2,4}}" :db/id #edb/ref 17592186297786} {:answer/id #uuid "d694b8f5-767b-5ccc-bed3-38b3125aaef1" :answer/type {:db/ident :answer.type/math} :answer/value "{2,{2},{4},{2,4}}" :db/id #edb/ref 17592186297787}] :answer-field/correct {:answer/id #uuid "a9be15a8-178c-57c3-b7c1-d48e1378c454" :answer/type {:db/ident :answer.type/math} :answer/value "{2,{2},4,{2,4}}" :db/id #edb/ref 17592186297783} :answer-field/id #uuid "fd158d9a-e332-529a-9c06-db07fee98b1f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297782}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "999b2586-fcdd-5ed0-85a5-01e4b7a4e6e1" :question/math-academy-id "q-181636" :question/problem "Which set is equivalent to $S={4,{2,4},4,2,2,{2}}?$" :question/worked-solution "Two sets are equivalent if they contain the same elements. It doesn't matter if the elements are listed differently or if one set has duplicates and the other does not.\n\nTo determine which of the given sets is equivalent to $S,$ we start by listing the elements of $S,$ ignoring any duplicates:\n\n$$\n4,\\,{2,4},\\,2,\\,{2}\n$$\n\nTherefore, the only set equivalent to $S$ is ${2,{2},4,{2,4}}$ since it contains the same elements as $S.$\n\nThe other sets are not equivalent to $S:$\n\n- ${2,4}$ is missing the elements ${2}$ and ${2,4}.$ Note that ${2}\\ne 2.$\n\n- ${2,{2},{4},{2,4}}$ is missing the element $4.$ Note that $4\\ne {4}.$\n\n- ${{2},{2,4}}$ is missing the elements $2$ and $4.$\n\n- ${2,4,{2,4}}$ is missing the element ${2}.$ Note that ${2}\\ne 2.$"}] [{:db/id #edb/ref 17592186297788 :knowledge-point/_questions [{:knowledge-point/id #uuid "1d478c5a-3a9e-5219-8111-2cfc828a609a" :knowledge-point/title "Equivalent Sets Containing Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a0ac19f-8fe5-573b-a649-2968f8e9cfa5" :answer/type {:db/ident :answer.type/math} :answer/value "{{m,n},o,{p},q}" :db/id #edb/ref 17592186297790} {:answer/id #uuid "ddfaa362-60cd-5c89-a114-6cc66f6415b3" :answer/type {:db/ident :answer.type/math} :answer/value "{m,n,o,{p}}" :db/id #edb/ref 17592186297791} {:answer/id #uuid "653fbb7b-f364-5a49-8669-ae8836a3609e" :answer/type {:db/ident :answer.type/math} :answer/value "{{m,n},o,{p}}" :db/id #edb/ref 17592186297792} {:answer/id #uuid "20a19231-eac9-5de4-adea-64ae08febdd7" :answer/type {:db/ident :answer.type/math} :answer/value "{m,n,o,p}" :db/id #edb/ref 17592186297793} {:answer/id #uuid "22e25929-79e5-5001-bc27-ab9d3815d070" :answer/type {:db/ident :answer.type/math} :answer/value "{{m,n},p,o}" :db/id #edb/ref 17592186297794}] :answer-field/correct {:answer/id #uuid "653fbb7b-f364-5a49-8669-ae8836a3609e" :answer/type {:db/ident :answer.type/math} :answer/value "{{m,n},o,{p}}" :db/id #edb/ref 17592186297792} :answer-field/id #uuid "83d9e157-e94a-5cb9-98c8-9c14f1dfc427" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297789}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7558bd58-1185-5116-9bea-76477db408ae" :question/math-academy-id "q-181640" :question/problem "Which set is equivalent to $S={{m,n},{p},o,{p},o}?$" :question/worked-solution "Two sets are equivalent if they contain the same elements. It doesn't matter if the elements are listed differently or if one set has duplicates and the other does not.\n\nTo determine which of the given sets is equivalent to $S,$ we start by listing the elements of $S,$ ignoring any duplicates:\n\n$$\n{m,n},\\,{p},\\,o\n$$\n\nTherefore, the only set equivalent to $S$ is ${{m,n},o,{p}}$ since it contains the same elements as $S.$\n\nThe other sets are not equivalent to $S:$\n\n- ${m,n,o,p}$ is missing the elements ${m,n}$ and ${p}.$ Note that ${p}\\ne p.$\n\n- ${{m,n},p,o}$ is missing the element ${p}.$ Note that $p\\ne {p}.$\n\n- ${{m,n},o,{p},q}$ has the element $q$ that is not in $S.$\n\n- ${m,n,o,{p}}$ is missing the element ${m,n}.$"}] [{:db/id #edb/ref 17592186297795 :knowledge-point/_questions [{:knowledge-point/id #uuid "1d478c5a-3a9e-5219-8111-2cfc828a609a" :knowledge-point/title "Equivalent Sets Containing Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fdae35ec-5325-5528-89c9-5dec7136fcac" :answer/type {:db/ident :answer.type/math} :answer/value "{{-1},{0},{1}}" :db/id #edb/ref 17592186297797} {:answer/id #uuid "a568d1be-5867-5b41-809b-705250ef6872" :answer/type {:db/ident :answer.type/math} :answer/value "{0,\\pm 1}" :db/id #edb/ref 17592186297798} {:answer/id #uuid "27fe05c1-a544-5e9e-946b-ac746537a5f1" :answer/type {:db/ident :answer.type/math} :answer/value "{{-1},{0},2}" :db/id #edb/ref 17592186297799} {:answer/id #uuid "7f677983-8bcf-5482-bb30-11b741679caf" :answer/type {:db/ident :answer.type/math} :answer/value "{0,1}" :db/id #edb/ref 17592186297800} {:answer/id #uuid "8fa2847c-be33-5062-b5db-6db92a724faa" :answer/type {:db/ident :answer.type/math} :answer/value "{{-1},{0},1}" :db/id #edb/ref 17592186297801}] :answer-field/correct {:answer/id #uuid "8fa2847c-be33-5062-b5db-6db92a724faa" :answer/type {:db/ident :answer.type/math} :answer/value "{{-1},{0},1}" :db/id #edb/ref 17592186297801} :answer-field/id #uuid "d01045c8-e8b8-56ad-ad69-69242b8cd85a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297796}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "805e4e6d-f9cc-5f6a-b4df-aea45b48f967" :question/math-academy-id "q-181642" :question/problem "Which set is equivalent to $S={{-1},1,{0},1,{-1}}?$" :question/worked-solution "Two sets are equivalent if they contain the same elements. It doesn't matter if the elements are listed differently or if one set has duplicates and the other does not.\n\nTo determine which of the given sets is equivalent to $S,$ we start by listing the elements of $S,$ ignoring any duplicates:\n\n$$\n{-1},\\,1,\\,{0}\n$$\n\nTherefore, the only set equivalent to $S$ is ${{-1},{0},1}$ since it contains the same elements as $S.$\n\nThe other sets are not equivalent to $S:$\n\n- ${0,\\pm 1}$ is missing the elements ${-1}$ and ${0}.$ Note that $-1\\ne {-1}$  and $0\\ne {0}.$\n\n- ${{-1},{0},{1}}$ is missing the element $1.$ Note that ${1}\\ne 1.$\n\n- ${0,1}$  is missing the elements ${-1}$ and ${0}.$ Note that $0\\ne {0}.$\n\n- ${{-1},{0},2}$ has the element $2$ that is not in $S.$"}] [{:db/id #edb/ref 17592186297802 :knowledge-point/_questions [{:knowledge-point/id #uuid "e1e872ac-ef9b-50d5-b74f-3f861cdda8f6" :knowledge-point/title "Identifying Equivalent Special Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54ac1a54-452a-5d9f-ac32-7bdd74f702a8" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{0}^{+}" :db/id #edb/ref 17592186297804} {:answer/id #uuid "4f000f63-d41b-553a-a327-14e3fc1a2f87" :answer/type {:db/ident :answer.type/math} :answer/value "{R}^{+}" :db/id #edb/ref 17592186297805} {:answer/id #uuid "f78c1a1b-81a2-57e2-9dbb-94f6914be2cf" :answer/type {:db/ident :answer.type/math} :answer/value "{R}^{-}" :db/id #edb/ref 17592186297806} {:answer/id #uuid "8ae9fe8f-4bc1-5ddc-9b75-e0f332994474" :answer/type {:db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186297807} {:answer/id #uuid "e8df910e-3196-5b31-81e5-359fb529b30e" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{0}^{-}" :db/id #edb/ref 17592186297808}] :answer-field/correct {:answer/id #uuid "4f000f63-d41b-553a-a327-14e3fc1a2f87" :answer/type {:db/ident :answer.type/math} :answer/value "{R}^{+}" :db/id #edb/ref 17592186297805} :answer-field/id #uuid "8c499db4-6570-5665-9cae-949f65811ce2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297803}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "4b1ab6e4-3436-59f4-ab77-c858f8a30205" :question/math-academy-id "q-183578" :question/problem "Which of the following sets is equivalent to the interval $(0,\\infty )?$" :question/worked-solution "The interval $(0,\\infty )$ consists of all positive real numbers. It is, therefore, equivalent to ${R}^{+}.$\n\nThe other options are *not* equivalent to the interval $(0,\\infty ):$\n\n- The set $R$ includes the negative real numbers.\n\n- The set ${R}_{0}^{+}$ includes the zero.\n\n- The set ${R}^{-}$ does not include the positive real numbers.\n\n- The set ${R}_{0}^{-}$ does not include the positive real numbers."}] [{:db/id #edb/ref 17592186297809 :knowledge-point/_questions [{:knowledge-point/id #uuid "e1