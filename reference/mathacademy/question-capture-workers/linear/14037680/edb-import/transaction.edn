).\n\n- ${{0},0,1}$ is missing the element ${1}$ (note that ${1}\\ne 1$).\n\n- ${0,1,{0,1},{0},{1}}$ has the element ${0,1}$ that is not in $S.$\n\n- ${0,1,{1},2,{0}}$ has the element $2$ that is not in $S.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-180821/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1d478c5a-3a9e-5219-8111-2cfc828a609a"] :knowledge-point/questions ["q-180821"] :db/ensure [:knowledge-point/validate]} {:db/id "q-181640/selection/89e8d83d70018dfa2f7b9701519187991379e853e2b844205ad15f9bab737734" :answer/id #uuid "653fbb7b-f364-5a49-8669-ae8836a3609e" :answer/type :answer.type/math :answer/value "{{m,n},o,{p}}" :db/ensure [:answer/validate]} {:db/id "q-181640/selection/32775a8847bdfcd92388cb1d3019387db4e689f083c33ba41848161bd2e527ea" :answer/id #uuid "7a0ac19f-8fe5-573b-a649-2968f8e9cfa5" :answer/type :answer.type/math :answer/value "{{m,n},o,{p},q}" :db/ensure [:answer/validate]} {:db/id "q-181640/selection/c5e78ac48b3e8192114b82f9ef7c2fe2dece603091b93680e52a19f943e1feff" :answer/id #uuid "22e25929-79e5-5001-bc27-ab9d3815d070" :answer/type :answer.type/math :answer/value "{{m,n},p,o}" :db/ensure [:answer/validate]} {:db/id "q-181640/selection/a2945c43495416ded7c6336cbe04d192627959fefd78503287972f6c19781ae7" :answer/id #uuid "20a19231-eac9-5de4-adea-64ae08febdd7" :answer/type :answer.type/math :answer/value "{m,n,o,p}" :db/ensure [:answer/validate]} {:db/id "q-181640/selection/5e86d1554319a6b31bd94e799736aea5ae440faf879b5d6e6105ed45adf01d20" :answer/id #uuid "ddfaa362-60cd-5c89-a114-6cc66f6415b3" :answer/type :answer.type/math :answer/value "{m,n,o,{p}}" :db/ensure [:answer/validate]} {:db/id "q-181640/selection" :answer-field/id #uuid "83d9e157-e94a-5cb9-98c8-9c14f1dfc427" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-181640/selection/89e8d83d70018dfa2f7b9701519187991379e853e2b844205ad15f9bab737734" :answer-field/choices ["q-181640