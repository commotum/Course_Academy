re-workers/linear/14068585/state.json" "file_sha256" "0d4a4bd88a37721b77d2c6989ffec506d7feab9df18521003fa8e3fbee91ce7a"} {"question" "q-160627" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068585/activity-metadata.json" "file_sha256" "c1821d28d44cb3de5d913ff6962ac57fabae36b0a04bf946154936bfd5f774e5"} {"question" "q-160627" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068585/state.json" "file_sha256" "0d4a4bd88a37721b77d2c6989ffec506d7feab9df18521003fa8e3fbee91ce7a"} {"question" "q-160627" "field" "selection" "attribute" "answer-field/choices" "value" [["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068585/assets/09b2ae9333118de0621a5f29610b6a83689fadaeb9c05e7a30b2799b12a1bd58.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068585/assets/23f63717c8d356c698137359824112511b0bbd5ec04c59e47d22500d842d03b6.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068585/assets/5a1923eec2b66ef4eb861ec42b00ea48a3285aaaf3255c42d12c001c9cde32f8.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068585/assets/70dfc0c8412bfae3bdbb7128fc021199f11d63d6f4ee264bea20da70dd18316c.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068585/assets/ead70b80d9256e1211addc404613f2dfe4a19baf822cbd77f429572ffc9a3a6d.png"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068585/state.json" "file_sha256" "0d4a4bd88a37721b77d2c6989ffec506d7feab9df18521003fa8e3fbee91ce7a"} {"question" "q-160627" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/image "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068585/assets/70dfc0c8412bfae3bdbb7128fc021199f11d63d6f4ee264bea20da70dd18316c.png"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068585/state.json" "file_sha256" "0d4a4bd88a37721b77d2c6989ffec506d7feab9df18521003fa8e3fbee91ce7a"} {"question" "q-160648" "field" nil "attribute" "question/problem" "value" "A triangle $S$ has vertices at  $(1,-1),(-2,3),(-1,0).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the **clockwise** rotation ${R}_{-{270}^{∘}}$ by an angle of ${270}^{∘}$ about the origin?\n\n- $(1,1)$\n- $(-3,-2)$\n- $(0,2)$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068585/state.json" "file_sha256" "0d4a4bd88a37721b77d2c6989ffec506d7feab9df18521003fa8e3fbee91ce7a"} {"question" "q-160648" "field" nil "attribute" "question/worked-solution" "value" "The clockwise rotation ${R}_{-{270}^{∘}}$ by an angle of ${270}^{∘}$ is the same as counterclockwise rotation by an angle of ${90}^{∘}.$ It's given by the matrix\n\n$$\nR[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}].\n$$\n\nTo find the image of $S$ under the action of ${R}_{-{270}^{∘}},$ we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}1 & -2 & -1 \\\\ -1 & 3 & 0\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under ${R}_{-{270}^{∘}}$ by calculating the matrix product $RX:$\n\n$$\n\\begin{aligned}RX & =[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}1 & -2 & -1 \\\\ -1 & 3 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -3 & 0 \\\\ 1 & -2 & -1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(1,1),(-3,-2),(0,-1).$\n\nSo, the correct answer is \"I and II only.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068585/state.json" "file_sha256" "0d4a4bd88a37721b77d2c6989ffec506d7feab9df18521003fa8e3fbee91ce7a"} {"question" "q-160648" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068585/activity-metadata.json" "file_sha256" "c1821d28d44cb3de5d913ff6962ac57fabae36b0a04bf946154936bfd5f774e5"} {"question" "q-160648" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068585/state.json" "file_sha256" "0d4a4bd88a37721b77d2c6989ffec506d7feab9df18521003fa8e3fbee91ce7a"} {"question" "q-160648" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I only"] ["text" "II and III only"] ["text" "II only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068585/state.json" "file_sha256" "0d4a4bd88a37721b77d2c6989ffec506d7feab9df18521003fa8e3fbee91ce7a"} {"question" "q-160648" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "I and II only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068585/state.json" "file_sha256" "0d4a4bd88a37721b77d2c6989ffec506d7feab9df18521003fa8e3fbee91ce7a"}] "usage" {"q-8394" [] "q-81450" [] "q-81829" [] "q-160648" [] "q-160627" []} "basis" 2306 "retractions" [[17592186092773 :question/problem "![]