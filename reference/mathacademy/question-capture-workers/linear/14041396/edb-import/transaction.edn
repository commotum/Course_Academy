380326e64790e65bba01" "q-33819/selection/8e28ffeaab4e71e44b7897dde6f03e972d7aad685c68218e1c71fbbff52ad0e7" "q-33819/selection/fc8da0ae135d2835c5eefcc681f3de6d4ab611c775873663e4ee03951a00ea5e"] :db/ensure [:answer-field/validate]} {:db/id "q-33819" :question/id #uuid "3f234c8a-5296-59f1-9978-57c05cbc1be8" :question/math-academy-id "q-33819" :question/problem "Find a normal vector to the plane\n\n$$\nr=[\\begin{aligned}-2 \\\\ 23 \\\\ 14\\end{aligned}]+t[\\begin{aligned}-3 \\\\ 5 \\\\ 4\\end{aligned}]+s[\\begin{aligned}4 \\\\ 7 \\\\ -1\\end{aligned}],\\,t,\\,s\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "From the parametric equation, we have that $v=⟨-3,5,4⟩$ and $w=⟨4,7,-1⟩$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $v$ and $w$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =[\\begin{aligned}-3 \\\\ 5 \\\\ 4\\end{aligned}]\\times [\\begin{aligned}4 \\\\ 7 \\\\ -1\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ -3 & 5 & 4 \\\\ 4 & 7 & -1\\end{aligned}\\right| \\\\  & =-33i+13j-41k \\\\  & =⟨-33,13,-41⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨-33,13,-41⟩.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-33819/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "62196ae9-df2e-5a3a-bc0a-1c0f4c40af3e"] :knowledge-point/questions ["q-33819"] :db/ensure [:knowledge-point/validate]} {:db/id "q-33823/selection/84552d286001ab6c418d6f7bcdcc51a0024ba62ece779dadbe4707d1e17f86cd" :answer/id #uuid "a7605fbb-6731-5555-87d6-2ea6fb92a2a3" :answer/type :answer.type/math :answer/value "⟨0,-2,-2⟩" :db/ensure [:answer/validate]} {:db/id "q-33823/selection/5ec5da2059e271c106ee54ff53f708a83080b97e8ba6f1de84d9744970cfa73b" :answer/id #uuid "67496e60-a754-5fd9-a354-f51e71f49dc7" :answer/type :answer.type/math :answer/value "⟨1,1,0⟩" :db/ensure [:answer/validate]} {:db/id "q-33823/selection/33d