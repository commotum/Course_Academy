 1\\end{aligned}]\\times [\\begin{aligned}0 \\\\ 2 \\\\ 2\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ -1 & 1 & 1 \\\\ 0 & 2 & 2\\end{aligned}\\right| \\\\  & =2j-2k \\\\  & =⟨0,2,-2⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨0,2,-2⟩.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-33823/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "62196ae9-df2e-5a3a-bc0a-1c0f4c40af3e"] :knowledge-point/questions ["q-33823"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70972/selection/640db89197bce254ce164ea40a8090bb1a519abbfe55acd0bca09a89c7fc36ae" :answer/id #uuid "d4f4b402-6e07-59fd-be95-cd005d2a69f6" :answer/type :answer.type/math :answer/value "⟨-5,3,1⟩" :db/ensure [:answer/validate]} {:db/id "q-70972/selection/f542b21a4bc37fdf3997cd7864ae992e37e4f169c6e3965e59858fb79d3f17b4" :answer/id #uuid "bdc6bd90-10d7-55f9-a911-c93b97815b4a" :answer/type :answer.type/math :answer/value "⟨7,-3,1⟩" :db/ensure [:answer/validate]} {:db/id "q-70972/selection/1276d6440fbe9d01c35a4072fc566e77ff7d93aa99ac13fbb2f91f0ccfeb85de" :answer/id #uuid "d16ac501-66f8-52cd-8aa9-032b3a35da71" :answer/type :answer.type/math :answer/value "⟨1,2,-1⟩" :db/ensure [:answer/validate]} {:db/id "q-70972/selection/aa7730e658687445930ea226dfb3c3c3ae156475ddf6d863d11f32c50d44e80e" :answer/id #uuid "659cd2e2-7cd4-53fd-9d6b-1f0d37e3db5a" :answer/type :answer.type/math :answer/value "⟨-5,3,0⟩" :db/ensure [:answer/validate]} {:db/id "q-70972/selection/e2d12e34d0bc98752e517fb70bf2b0c7c716578fc85c38077b66b61042330ce6" :answer/id #uuid "5e631b40-1ef7-5a95-9e42-dad35f111830" :answer/type :answer.type/math :answer/value "⟨0,-1,3⟩" :db/ensure [:answer/validate]} {:db/id "q-70972/selection" :answer-field/id #uuid "89d420fe-daef-5abc-8dbf-88f7a32c4916" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-70972/selection/640db89197bce254ce164ea40a8090bb1a519abbfe55acd0bca09a89c7fc36ae" :answer-field/choices ["q-70972/selection/640db89197bce254ce164ea40a8090bb1a519abbfe55acd0bca09a89c7fc36ae" "q-70972/selection/f542b21a4bc37fdf3997cd7864ae992e37e4f169c6e3965e59858fb79d3f17b4" "q-70972/selection/1276d6440fbe9d01c35a4072fc566e77ff7d93aa99ac13fbb2f91f0ccfeb85de" "q-70972/selection/aa7730e658687445930ea226dfb3c3c3ae156475ddf6d863d11f32c50d44e80e" "q-70972/selection/e2d12e34d0bc98752e517fb70bf2b0c7c716578fc85c38077b66b61042330ce6"] :db/ensure [:answer-field/validate]} {:db/id "q-70972" :question/id #uuid "a89b1eb9-5618-5992-98db-513e5d1c24f7" :question/math-academy-id "q-70972" :question/problem "Find a normal vector to the plane\n\n$$\nr=[\\begin{aligned}\\frac{1}{2} \\\\ -1 \\\\ 13\\end{aligned}]+t[\\begin{aligned}0 \\\\ -1 \\\\ 3\\end{aligned}]+s[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}],\\,t,\\,s\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "From the parametric equation, we have that $v=⟨0,-1,3⟩$ and $w=⟨1,2,-1⟩$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $v$ and $w$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =[\\begin{aligned}0 \\\\ -1 \\\\ 3\\end{aligned}]\\times [\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 0 & -1 & 3 \\\\ 1 & 2 & -1\\end{aligned}\\right| \\\\  & =-5i+3j+k \\\\  & =⟨-5,3,1⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨-5,3,1⟩.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-70972/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "62196ae9-df2e-5a3a-bc0a-1c0f4c40af3e"] :knowledge-point/questions ["q-70972"] :db/ensure [:knowledge-point/validate]} {:db/id "q-33820/selection/7d8d3f4e85b071359292fad885862ae7d2efbf551dd9a1d6b1c4ef4cc421210b" :answer/id #uuid "12faaef9-b04e-517b-8ed9-1dbc83b3daec" :answer/type :answer.type/math :answer/value "⟨3,1,5⟩" :db/ensure [:answer/validate]} {