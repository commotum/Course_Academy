d #uuid "4fcbeb51-48f6-527f-a855-46d086ce1575" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186312154}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f59c6b43-5c8b-510d-819f-baf976f5d91c" :question/math-academy-id "q-70969" :question/problem "Find a parametric equation of the plane that passes through the point $T(7,0,-3)$ and is parallel to the vectors ${v}_{1}=[\\begin{aligned}-2 \\\\ \\sqrt{2} \\\\ 3\\end{aligned}]$  and ${v}_{2}=[\\begin{aligned}-2 \\\\ -1 \\\\ 0.25\\end{aligned}].$" :question/worked-solution "A parametric equation of a plane is given by \n\n$$\nr=p+sb+tc,\n$$\n\nwhere $p$ is the position vector of a point on the plane and the vectors $b$ and $c$ are parallel to the plane but not to each other.\n\nHere, the position vector of the given point $T$ is $p=[\\begin{aligned}7 \\\\ 0 \\\\ -3\\end{aligned}]$, and the two vectors that are parallel to the plane (but not to each other) are ${v}_{1}=[\\begin{aligned}-2 \\\\ \\sqrt{2} \\\\ 3\\end{aligned}]$  and ${v}_{2}=[\\begin{aligned}-2 \\\\ -1 \\\\ 0.25\\end{aligned}].$\n\nSo, a parametric equation of the plane is given by\n\n$$\nr=[\\begin{aligned}7 \\\\ 0 \\\\ -3\\end{aligned}]+s[\\begin{aligned}-2 \\\\ \\sqrt{2} \\\\ 3\\end{aligned}]+t[\\begin{aligned}-2 \\\\ -1 \\\\ 0.25\\end{aligned}],\\,s,t\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186312160 :knowledge-point/_questions [{:knowledge-point/id #uuid "b02f02f1-f270-55e0-a7a9-0b729c4d82c0" :knowledge-point/title "Finding the Parametric Equation of the Plane Parallel To Two Given Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff5db1dd-fdd5-5245-b90d-c38fc8d3c30f" :answer/type {:db/ident :answer.type/math} :answer/value "r=s[\\begin{aligned}5 \\\\ -1 \\\\ 1\\end{aligned}]+t[\\begin{aligned}0 \\\\ \\sqrt{5} \\\\ 0\\end{aligned}],\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186312162} {:answer/id #uuid "29f6c0a7-9fd4-526d-9511-9a8f9549b1b9" :answer/type {:db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186312163} {:answer/id #uuid "e4f97ec4-ecb9-503e-82ac-7ec37621b661" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}-14 \\\\ 1 \\\\ 2\\end{aligned}]+s[\\begin{aligned}5 \\\\ -1 \\\\ 1\\end{aligned}]+t[\\begin{aligned}0 \\\\ \\sqrt{5} \\\\ 0\\end{aligned}],\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186312164} {:answer/id #uuid "a42573e6-ba8b-5af0-99c2-56a84ee64165" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}5 \\\\ -1 \\\\ 1\\end{aligned}]+s[\\begin{aligned}-14 \\\\ 1 \\\\ 2\\end{aligned}]+t[\\begin{aligned}0 \\\\ \\sqrt{5} \\\\ 0\\end{aligned}],\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186312165} {:answer/id #uuid "7c363d6b-8f0d-5561-a7da-ed2870757a79" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}0 \\\\ \\sqrt{5} \\\\ 0\\end{aligned}]+s[\\begin{aligned}5 \\\\ -1 \\\\ 1\\end{aligned}]+t[\\begin{aligned}-14 \\\\ 1 \\\\ 2\\end{aligned}],\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186312166}] :answer-field/correct {:answer/id #uuid "e4f97ec4-ecb9-503e-82ac-7ec37621b661" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}-14 \\\\ 1 \\\\ 2\\end{aligned}]+s[\\begin{aligned}5 \\\\ -1 \\\\ 1\\end{aligned}]+t[\\begin{aligned}0 \\\\ \\sqrt{5} \\\\ 0\\end{aligned}],\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186312164} :answer-field/id #uuid "7e0933c8-bd75-58cf-ad35-8230aec28118" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186312161}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8b987f5e-2522-5959-b4cd-892b900155ac" :question/math-academy-id "q-70970" :question/problem "Find a parametric equation of the plane that passes through the point $M(-14,1,2)$ and is parallel to the vectors ${v}_{1}=[\\begin{aligned}5 \\\\ -1 \\\\ 1\\end{aligned}]$  and ${v}_{2}=[\\begin{aligned}0 \\\\ \\sqrt{5} \\\\ 0\\end{aligned}].$" :question/worked-solution "A parametric equation of a plane is given by \n\n$$\nr=p+sb+tc,\n$$\n\nwhere $p$ is the position vector of a point on the plane and the vectors $b$ and $c$ are parallel to the plane but not to each other.\n\nHere, the position vector of the given point $M$ is $p=[\\begin{aligned}-14 \\\\ 1 \\\\ 2\\end{aligned}]$, and the two vectors that are parallel to the plane (but not to each other) are ${v}_{1}=[\\begin{aligned}5 \\\\ -1 \\\\ 1\\end{aligned}]$  and ${v}_{2}=[\\begin{aligned}0 \\\\ \\sqrt{5} \\\\ 0\\end{aligned}].$\n\nSo, a parametric equation of the plane is given by\n\n$$\nr=[\\begin{aligned}-14 \\\\ 1 \\\\ 2\\end{aligned}]+s[\\begin{aligned}5 \\\\ -1 \\\\ 1\\end{aligned}]+t[\\begin{aligned}0 \\\\ \\sqrt{5} \\\\ 0\\end{aligned}],\\,s,t\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186312167 :knowledge-point/_questions [{:knowledge-point/id #uuid "62196ae9-df2e-5a3a-bc0a-1c0f4c40af3e" :knowledge-point/title "Finding a Normal Vector To a Plane Given by Parametric Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d16ac501-66f8-52cd-8aa9-032b3a35da71" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,2,-1⟩" :db/id #edb/ref 17592186312169} {:answer/id #uuid "d4f4b402-6e07-59fd-be95-cd005d2a69f6" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-5,3,1⟩" :db/id #edb/ref 17592186312170} {:answer/id #uuid "659cd2e2-7cd4-53fd-9d6b-1f0d37e3db5a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-5,3,0⟩" :db/id #edb/ref 17592186312171} {:answer/id #uuid "5e631b40-1ef7-5a95-9e42-dad35f111830" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,-1,3⟩" :db/id #edb/ref 17592186312172} {:answer/id #uuid "bdc6bd90-10d7-55f9-a911-c93b97815b4a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨7,-3,1⟩" :db/id #edb/ref 17592186312173}] :answer-field/correct {:answer/id #uuid "d4f4b402-6e07-59fd-be95-cd005d2a69f6" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-5,3,1⟩" :db/id #edb/ref 17592186312170} :answer-field/id #uuid "89d420fe-daef-5abc-8dbf-88f7a32c4916" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186312168}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a89b1eb9-5618-5992-98db-513e5d1c24f7" :question/math-academy-id "q-70972" :question/problem "Find a normal vector to the plane\n\n$$\nr=[\\begin{aligned}\\frac{1}{2} \\\\ -1 \\\\ 13\\end{aligned}]+t[\\begin{aligned}0 \\\\ -1 \\\\ 3\\end{aligned}]+s[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}],\\,t,\\,s\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "From the parametric equation, we have that $v=⟨0,-1,3⟩$ and $w=⟨1,2,-1⟩$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $v$ and $w$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =[\\begin{aligned}0 \\\\ -1 \\\\ 3\\end{aligned}]\\times [\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 0 & -1 & 3 \\\\ 1 & 2 & -1\\end{aligned}\\right| \\\\  & =-5i+3j+k \\\\  & =⟨-5,3,1⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨-5,3,1⟩.$"}] [{:db/id #edb/ref 17592186312174 :knowledge-point/_questions [{:knowledge-point/id #uuid "3061cb06-f57f-57c8-8821-dbd962b1e78e" :knowledge-point/title "Finding the Parametric Equation of the Plane Parallel To Two Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fd2f1286-8e8e-54e9-83e0-00ae587589db" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨4,-1,5⟩+s⟨6,2,1⟩+t⟨0,2,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186312176} {:answer/id #uuid "f8986253-0a1d-5570-ad10-8b2250320ed4" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨6,2,1⟩+s⟨\\frac{1}{2},1,9⟩+t⟨3,10,-1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186312177} {:answer/id #uuid "1d709c32-18fd-5afe-8eef-0f79d43cba24" :answer/type {:db/ident :answer.type/text} :answer/value "The plane is undefined" :db/id #edb/ref 17592186312178} {:answer/id #uuid "19829ab3-e516-56af-9883-d98a9cfdab64" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨0,2,3⟩+s⟨4,-1,5⟩+t⟨6,2,1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186312179} {:answer/id #uuid "90b41b64-0ae8-532a-be29-f3e35a9fb2a2" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨6,2,1⟩+s⟨4,-1,5⟩+t⟨0,2,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186312180}] :answer-field/correct {:answer/id #uuid "90b41b64-0ae8-532a-be29-f3e35a9fb2a2" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨6,2,1⟩+s⟨4,-1,5⟩+t⟨0,2,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186312180} :answer-field/id #uuid "84c173b7-cac3-5dc1-a3c3-d4149e9c3ce4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186312175}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "2a5755e5-26be-56e3-9545-37d117c1f96a" :question/math-academy-id "q-70977" :question/problem "Find a parametric equation of the plane that passes through the point $D(6,2,1)$ and is parallel to the lines $r=⟨\\frac{1}{2},1,9⟩+s⟨4,-1,5⟩$ and $r=⟨\\sqrt{3},10,-1⟩+t⟨0,2,3⟩.$" :question/worked-solution "The direction vectors of the lines are ${v}_{1}=⟨4,-1,5⟩$ and ${v}_{2}=⟨0,2,3⟩$, respectively. These vectors are parallel to the plane but not to each other.\n\nWe also know that the point $D(6,2,1)$ lies on the plane and its position vector is $d=⟨6,2,1⟩.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =d+s{v}_{1}+t{v}_{2} \\\\ r & =⟨6,2,1⟩+s⟨4,-1,5⟩+t⟨0,2,3⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186312181 :knowledge-point/_questions [{:knowledge-point/id #uuid "3061cb06-f57f-57c8-8821-dbd962b1e78e" :knowledge-point/title "Finding the Parametric Equation of the Plane Parallel To Two Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a9bcaf6c-22b5-5a20-aba0-16f35d322295" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨5,1,-2⟩+s⟨16,-1,3⟩+t⟨1,11,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186312183} {:answer/id #uuid "d11e3e9a-7b9a-540e-a540-76c8379fcc9c" :answer/type {:db/ident :answer.type/text} :answer/value "The plane is undefined" :db/id #edb/ref 17592186312184} {:answer/id #uuid "40b0d2e2-d535-5a49-9062-ad4abf81c091" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨16,-1,3⟩+s⟨5,1,-2⟩+t⟨1,11,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186312185} {:answer/id #uuid "1066ae23-c95d-5779-8139-35445e112b50" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨16,-1,3⟩+s⟨9,-7,2⟩+t⟨15,2,-3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186312186} {:answer/id #uuid "c5670c2e-d06a-524b-8c54-2a3d5e717368" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨1,11,3⟩+s⟨5,1,-2⟩+t⟨16,-1,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186312187}] :answer-field/correct {:answer/id #uuid "40b0d2e2-d535-5a49-9062-ad4abf81c091" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨16,-1,3⟩+s⟨5,1,-2⟩+t⟨1,11,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186312185} :answer-field/id #uuid "f9d7f215-88a8-5742-98dd-d45731dfaeab" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186312182}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1380b7ab-2f50-57d6-bb5c-11a707fc3968" :question/math-academy-id "q-70978" :question/problem "Find a parametric equation of the plane that passes through the point $E(16,-1,3)$ and is parallel to the lines $r=⟨9,-7,2⟩+s⟨5,1,-2⟩$ and $r=⟨15,2,-3⟩+t⟨1,11,3⟩.$" :question/worked-solution "The direction vectors of the lines are ${v}_{1}=⟨5,1,-2⟩$ and ${v}_{2}=⟨1,11,3⟩$, respectively. These vectors are parallel to the plane but not to each other.\n\nWe also know that the point $E(16,-1,3)$ lies on the plane and its position vector is $e=⟨16,-1,3⟩.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =e+s{v}_{1}+t{v}_{2} \\\\ r & =⟨16,-1,3⟩+s⟨5,1,-2⟩+t⟨1,11,3⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}]}
