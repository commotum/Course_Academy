er/id #uuid "fd46fa5e-f228-5b17-ab87-937c2c49b057" :answer/type {:db/ident :answer.type/math} :answer/value "r = ⟨3, 1, 5⟩ + s⟨6,-8, 0⟩ + t⟨ - 2, 1, 3⟩, s, t ∈ (- ∞, ∞)" :db/id #edb/ref 17592186117430} {:answer/id #uuid "164382bd-289b-5666-97e1-536a448ecc74" :answer/type {:db/ident :answer.type/math} :answer/value "r = ⟨3, 1, 5⟩ + s⟨6,-8, 0⟩ + t⟨ - 5, 0,-2⟩, s, t ∈ (- ∞, ∞)" :db/id #edb/ref 17592186117431}] :answer-field/correct {:answer/id #uuid "d9d68798-b39f-5fd9-ad83-ef58d2f0912b" :answer/type {:db/ident :answer.type/math} :answer/value "r = ⟨3, 1, 5⟩ + s⟨3,-9,-5⟩ + t⟨ - 5, 0,-2⟩, s, t ∈ (- ∞, ∞)" :db/id #edb/ref 17592186117429} :answer-field/id #uuid "b6cca1ea-c183-5baf-841b-897aa164800b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117426}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "26d7019c-08c2-5f92-a7e5-2893b8366abc" :question/math-academy-id "q-32988" :question/problem "Find a parametric equation of the plane that passes through the points $A(3,1,5),\\,B(6,-8,0)$, and $C(-2,1,3).$" :question/worked-solution "First, we need to find two vectors that are parallel to the plane (but not to each other). Let's use the displacement vectors $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC},$ as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =⟨6,-8,0⟩-⟨3,1,5⟩ \\\\  & =⟨3,-9,-5⟩ \\\\ \\overset{\\to }{AC} & =⟨-2,1,3⟩-⟨3,1,5⟩ \\\\  & =⟨-5,0,-2⟩\\end{aligned}\n$$\n\nNow, if we consider the position vector $a=⟨3,1,5⟩$ of the point $A,$ then the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =a+s\\overset{\\to }{AB}+t\\overset{\\to }{AC} \\\\ r & =⟨3,1,5⟩+s⟨3,-9,-5⟩+t⟨-5,0,-2⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120158 :knowledge-point/_questions [{:knowledge-point/id #uuid "3061cb06-f57f-57c8-8821-dbd962b1e78e" :knowledge-point/title "Finding the Parametric Equation of the Plane Parallel To Two Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "920d7a89-d415-5ce2-a0d3-17d793d3f007" :answer/type {:db/ident :answer.type/math} :answer/value "r = ⟨5,-3, 1⟩ + s⟨8, 1, 0⟩ + t⟨6,-5, 10⟩, s, t ∈ (- ∞, ∞)" :db/id #edb/ref 17592186117469} {:answer/id #uuid "9d025087-ed38-5860-9d5b-12fdd5aeca94" :answer/type {:db/ident :answer.type/math} :answer/value "r = ⟨5,-3, 1⟩ + s⟨8, 1, 0⟩ + t⟨0, 6, 2⟩, s, t ∈ (- ∞, ∞)" :db/id #edb/ref 17592186117470} {:answer/id #uuid "ad2848ac-1eb1-524e-9615-60c02e459e4e" :answer/type {:db/ident :answer.type/math} :answer/value "r = ⟨0, 6, 2⟩ + s⟨3, 2, 5⟩ + t⟨6,-5, 10⟩, s, t ∈ (- ∞, ∞)" :db/id #edb/ref 17592186117471} {:answer/id #uuid "e3e3f9cd-741f-5df2-a239-c73e64c3ba01" :answer/type {:db/ident :answer.type/math} :answer/value "r = ⟨5,-3, 1⟩ + s⟨3, 2, 5⟩ + t⟨0, 6, 2⟩, s, t ∈ (- ∞, ∞)" :db/id #edb/ref 17592186117472} {:answer/id #uuid "2be73169-f258-53b3-9916-a129970654bd" :answer/type {:db/ident :answer.type/text} :answer/value "The plane is undefined" :db/id #edb/ref 17592186117473}] :answer-field/correct {:answer/id #uuid "e3e3f9cd-741f-5df2-a239-c73e64c3ba01" :answer/type {:db/ident :answer.type/math} :answer/value "r = ⟨5,-3, 1⟩ + s⟨3, 2, 5⟩ + t⟨0, 6, 2⟩, s, t ∈ (- ∞, ∞)" :db/id #edb/ref 17592186117472} :answer-field/id #uuid "7f8804c8-db8f-5c49-ade9-f1cf2706cd77" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117468}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0602f3f6-acc2-53ef-a72e-b71caa5d5289" :question/math-academy-id "q-33066" :question/problem "Find a parametric equation of the plane that passes through the point $A(5,-3,1)$ and is parallel to the lines $r=⟨8,1,0⟩+s⟨3,2,5⟩$ and $r=⟨6,-5,10⟩+t⟨0,6,2⟩.$" :question/worked-solution "The direction vectors of the lines are ${v}_{1}=⟨3,2,5⟩$ and ${v}_{2}=⟨0,6,2⟩$, respectively. These vectors are parallel to the plane but not to each other.\n\nWe also know that the point $A(5,-3,1)$ lies on the plane and its position vector is $a=⟨5,-3,1⟩.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =a+s{v}_{1}+t{v}_{2} \\\\ r & =⟨5,-3,1⟩+s⟨3,2,5⟩+t⟨0,6,2⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186312111 :knowledge-point/_questions [{:knowledge-point/id #uuid "b02f02f1-f270-55e0-a7a9-0b729c4d82c0" :knowledge-point/title "Finding the Parametric Equation of the Plane Parallel To Two Given Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b1ae397-d629-5422-9520-e1f4f50f78da" :answer/type {:db/ident :answer.type/math} :answer/value "r=s⟨4,2,-1⟩+t⟨4,-3,2⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186312113} {:answer/id #uuid "7f6feb2b-cc0e-5901-a54b-d28891d37071" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨4,-3,2⟩+s⟨-6,3,2⟩+t⟨4,2,-1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186312114} {:answer/id #uuid "7c94a387-a500-5c40-abc0-015910991958" :answer/type {:db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186312115} {:answer/id #uuid "33c8301e-03c0-50b8-ab59-4b94444d00d2" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨-6,3,2⟩+s⟨4,2,-1⟩+t⟨4,-3,2⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186312116} {:answer/id #uuid "a9ca41a2-b114-5756-989e-59b711ce95b8" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨4,2,-1⟩+s⟨-6,3,2⟩+t⟨4,-3,2⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186312117}] :answer-field/correct {:answer/id #uuid "33c8301e-03c0-50b8-ab59-4b94444d00d2" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨-6,3,2⟩+s⟨4,2,-1⟩+t⟨4,-3,2⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186312116} :answer-field/id #uuid "bfdf4739-8dff-584f-a3e2-74c51e856b95" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186312112}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "0b919fcb-656d-589d-bfae-4a18da03e080" :question/math-academy-id "q-33133" :question/problem "Find a parametric equation of the plane that passes through the point $D(-6,3,2)$ and is parallel to the vectors ${v}_{1}=⟨4,2,-1⟩$  and ${v}_{2}=⟨4,-3,2⟩.$" :question/worked-solution "A parametric equation of a plane is given by \n\n$$\nr=p+sb+tc,\n$$\n\nwhere $p$ is the position vector of a point on the plane and the vectors $b$ and $c$ are parallel to the plane but not to each other.\n\nHere, the position vector of the given point $D$ is $p=⟨-6,3,2⟩$ and the two vectors that are parallel to the plane (but not to each other) are ${v}_{1}=⟨4,2,-1⟩$  and ${v}_{2}=⟨4,-3,2⟩.$\n\nSo, a parametric equation of the plane is given by\n\n$$\nr=⟨-6,3,2⟩+s⟨4,2,-1⟩+t⟨4,-3,2⟩,\\,s,t\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186312118 :knowledge-point/_questions [{:knowledge-point/id #uuid "d11f13f0-1cfa-59ec-a04a-9483d942b1aa" :knowledge-point/title "Finding the Parametric Equation of the Plane Passing Through Three Given Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ea2ac09-96b1-5b6b-af83-440a89eab687" :answer/type {:db/ident :answer.type/text} :answer/value "The plane is undefined" :db/id #edb/ref 17592186312120} {:answer/id #uuid "f60f0621-8524-5cad-9a65-120927012eeb" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨1,4,-14⟩+s⟨1,1,1⟩+t⟨1,-2,-26⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186312121} {:answer/id #uuid "341ec3a4-5e5a-5e0d-9ff2-69ada5bfa505" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨1,4,-14⟩+s⟨-2,-2,-2⟩+t⟨1,1,1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186312122} {:answer/id #uuid "47584619-4f06-5a98-9a74-9df914ff338a" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨0,3,-19⟩+s⟨-2,-2,-2⟩+t⟨1,2,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186312123} {:answer/id #uuid "c0d705d7-e3f3-592d-9715-3759af845b45" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨-2,-2,-2⟩+s⟨1,4,-14⟩+t⟨1,1,1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186312124}] :answer-field/correct {:answer/id #uuid "f60f0621-8524-5cad-9a65-120927012eeb" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨1,4,-14⟩+s⟨1,1,1⟩+t⟨1,-2,-26⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186312121} :answer-field/id #uuid "c443ab42-5f80-5b3e-b39f-f166702fbf8e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186312119}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "4253076c-f9b0-59ce-9a1b-d5e4c0bbca87" :question/math-academy-id "q-33160" :question/problem "Find a parametric equation of the plane that passes through the point $C(1,4,-14)$ and is parallel to the two distinct lines $r=⟨-1,5,7⟩+s⟨1,1,1⟩$ and $r=⟨0,3,-19⟩+t⟨-2,-2,-2⟩.$" :question/worked-solution "The direction vectors of the lines are ${v}_{1}=⟨-2,-2,-2⟩$ and ${v}_{2}=⟨1,1,1⟩,$ respectively.\nBut ${v}_{2}=-2{v}_{1}.$ So, our lines are parallel. \n\nDespite this fact, two distinct parallel lines still determine a plane. Now: \n\n- from the equation of the first line, we get the point $P$ with the position vector $p=⟨-1,5,7⟩$ that lies on it, and\n\n- from the equation of the second line, we get the point $Q$ with the position vector $q=⟨0,3,-19⟩$ that lies on it.\n\nThe vector $u=q-p$ will be parallel to the required plane. \n\nComputing the coordinates of $u,$  we obtain\n\n$$\n\\begin{aligned}u & =q-p \\\\  & =⟨0,3,-19⟩-⟨-1,5,7⟩ \\\\  & =⟨1,-2,-26⟩\\end{aligned}\n$$\n\nFinally, since $\\overset{\\to }{PQ}∦{v}_{1},$ we can find the equation of our plane.\n\nWe know that the point $C(1,4,-14)$ lies on the plane and its position vector is $c=⟨1,4,-14⟩.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =c+s{v}_{1}+tu \\\\ r & =⟨1,4,-14⟩+s⟨1,1,1⟩+t⟨1,-2,-26⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186312125 :knowledge-point/_questions [{:knowledge-point/id #uuid "62196ae9-df2e-5a3a-bc0a-1c0f4c40af3e" :knowledge-point/title "Finding a Normal Vector To a Plane Given by Parametric Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c9cbea4-9456-56c2-b99f-093694fae63e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-12,21,-4⟩" :db/id #edb/ref 17592186312127} {:answer/id #uuid "c475d69a-3f07-5211-9dac-db46fe94d0a6" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-33,13,-41⟩" :db/id #edb/ref 17592186312128} {:answer/id #uuid "1de7290d-b180-5d55-93d9-cfc4291629df" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-3,5,4⟩" :db/id #edb/ref 17592186312129} {:answer/id #uuid "a98f57c0-5b3e-55af-9829-975a2097c417" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-13,33,-14⟩" :db/id #edb/ref 17592186312130} {:answer/id #uuid "5afea236-e140-5820-9ef5-b834153781bb" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4,7,-1⟩" :db/id #edb/ref 17592186312131}] :answer-field/correct {:answer/id #uuid "c475d69a-3f07-5211-9dac-db46fe94d0a6" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-33,13,-41⟩" :db/id #edb/ref 17592186312128} :answer-field/id #uuid "f6a4a236-d7ae-5a15-9d18-d073626bb864" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186312126}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3f234c8a-5296-59f1-9978-57c05cbc1be8" :question/math-academy-id "q-33819" :question/problem "Find a normal vector to the plane\n\n$$\nr=[\\begin{aligned}-2 \\\\ 23 \\\\ 14\\end{aligned}]+t[\\begin{aligned}-3 \\\\ 5 \\\\ 4\\end{aligned}]+s[\\begin{aligned}4 \\\\ 7 \\\\ -1\\end{aligned}],\\,t,\\,s\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "From the parametric equation, we have that $v=⟨-3,5,4⟩$ and $w=⟨4,7,-1⟩$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $v$ and $w$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =[\\begin{aligned}-3 \\\\ 5 \\\\ 4\\end{aligned}]\\times [\\begin{aligned}4 \\\\ 7 \\\\ -1\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ -3 & 5 & 4 \\\\ 4 & 7 & -1\\end{aligned}\\right| \\\\  & =-33i+13j-41k \\\\  & =⟨-33,13,-41⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨-33,13,-41⟩.$"}] [{:db/id #edb/ref 17592186312132 :knowledge-point/_questions [{:knowledge-point/id #uuid "62196ae9-df2e-5a3a-bc0a-1c0f4c40af3e" :knowledge-point/title "Finding a Normal Vector To a Plane Given by Parametric Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e4ab359-2c35-5814-b7ca-fc3e5de0cf99" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-45,13,18⟩" :db/id #edb/ref 17592186312134} {:answer/id #uuid "bc0e95dc-6e97-5730-8187-436ceb19961d" :answer/type {:db/ident :answer.type/math} :answer/value "⟨18,31,-45⟩" :db/id #edb/ref 17592186312135} {:answer/id #uuid "12faaef9-b04e-517b-8ed9-1dbc83b3daec" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,1,5⟩" :db/id #edb/ref 17592186312136} {:answer/id #uuid "a266b59b-b426-5ece-9d40-1550c36a7ac2" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,-9,-5⟩" :db/id #edb/ref 17592186312137} {:answer/id #uuid "ec187a2a-69a1-571f-b1a9-11adf094640f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨81,31,-54⟩" :db/id #edb/ref 17592186312138}] :answer-field/correct {:answer/id #uuid "bc0e95dc-6e97-5730-8187-436ceb19961d" :answer/type {:db/ident :answer.type/math} :answer/value "⟨18,31,-45⟩" :db/id #edb/ref 17592186312135} :answer-field/id #uuid "78f67ab4-abb1-58c3-8364-ba2f0e525976" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186312133}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8f43eeef-9b92-5b3a-8f64-9fc981d6ed6a" :question/math-academy-id "q-33820" :question/problem "Find a normal vector to the plane\n\n$$\nr=⟨3,1,5⟩+t⟨3,-9,-5⟩+s⟨-8,9,3⟩,\\,t,\\,s\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "From the parametric equation, we have that $v=⟨3,-9,-5⟩$ and $w=⟨-8,9,3⟩$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $v$ and $w$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =[\\begin{aligned}3 \\\\ -9 \\\\ -5\\end{aligned}]\\times [\\begin{aligned}-8 \\\\ 9 \\\\ 3\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 3 & -9 & -5 \\\\ -8 & 9 & 3\\end{aligned}\\right| \\\\  & =18i+31j-45k \\\\  & =⟨18,31,-45⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨18,31,-45⟩.$"}] [{:db/id #edb/ref 17592186312139 :knowledge-point/_questions [{:knowledge-point/id #uuid "62196ae9-df2e-5a3a-bc0a-1c0f4c40af3e" :knowledge-point/title "Finding a Normal Vector To a Plane Given by Parametric Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0543e47d-e3ac-5ccd-9244-70eaf00bbafd" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-3,13,-8⟩" :db/id #edb/ref 17592186312141} {:answer/id #uuid "5277c0f7-53ef-5846-b406-7ea29a3181e5" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-5,1,1⟩" :db/id #edb/ref 17592186312142} {:answer/id #uuid "c26420c2-ef3b-5769-94eb-32335cd21d9e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨13,3,-2⟩" :db/id #edb/ref 17592186312143} {:answer/id #uuid "905c9369-6ad8-5fe8-9315-75957dd90738" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,1,-2⟩" :db/id #edb/ref 17592186312144} {:answer/id #uuid "af529e89-f16d-560a-bbc1-27393a0b40f3" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-3,-7,-8⟩" :db/id #edb/ref 17592186312145}] :answer-field/correct {:answer/id #uuid "af529e89-f16d-560a-bbc1-27393a0b40f3" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-3,-7,-8⟩" :db/id #edb/ref 17592186312145} :answer-field/id #uuid "90137fc2-dc53-5b09-9971-16682329f8d8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186312140}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "51de2ebd-845c-5a52-9ff3-452c3613ef46" :question/math-academy-id "q-33822" :question/problem "Find a normal vector to the plane\n\n$$\nr=[\\begin{aligned}6 \\\\ 0 \\\\ 2\\end{aligned}]+t[\\begin{aligned}-5 \\\\ 1 \\\\ 1\\end{aligned}]+s[\\begin{aligned}3 \\\\ 1 \\\\ -2\\end{aligned}],\\,t,\\,s\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "From the parametric equation, we have that $v=⟨-5,1,1⟩$ and $w=⟨3,1,-2⟩$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $v$ and $w$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =[\\begin{aligned}-5 \\\\ 1 \\\\ 1\\end{aligned}]\\times [\\begin{aligned}3 \\\\ 1 \\\\ -2\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ -5 & 1 & 1 \\\\ 3 & 1 & -2\\end{aligned}\\right| \\\\  & =-3i-7j-8k \\\\  & =⟨-3,-7,-8⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨-3,-7,-8⟩.$"}] [{:db/id #edb/ref 17592186312146 :knowledge-point/_questions [{:knowledge-point/id #uuid "62196ae9-df2e-5a3a-bc0a-1c0f4c40af3e" :knowledge-point/title "Finding a Normal Vector To a Plane Given by Parametric Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6aaaf1d4-e1ca-5eb9-896c-c6e04398f46f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,2,-2⟩" :db/id #edb/ref 17592186312148} {:answer/id #uuid "67496e60-a754-5fd9-a354-f51e71f4