3,-4,-4⟩\\end{aligned}\n$$\n\nNow, if we consider the position vector $u=⟨5,3,1⟩$ of the point $U,$ then the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =u+sv+t\\overset{\\to }{UV} \\\\ r & =⟨5,3,1⟩+s⟨-4,2,6⟩+t⟨-3,-4,-4⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186312104 :knowledge-point/_questions [{:knowledge-point/id #uuid "d11f13f0-1cfa-59ec-a04a-9483d942b1aa" :knowledge-point/title "Finding the Parametric Equation of the Plane Passing Through Three Given Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "230f41a3-cb20-5c14-bcf0-a4340ef0c77e" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨7,-3,4⟩+s⟨-3,\\sqrt{5},2⟩+t⟨-4,2,5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186312106} {:answer/id #uuid "df3f3250-175c-5ecf-a7c1-be8bb5c22e53" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨7,-3,4⟩+s⟨\\sqrt{5},-3,2⟩+t⟨-4,2,-5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186312107} {:answer/id #uuid "2c4ad019-fdba-579c-a342-c95728f303e7" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨7,-3,4⟩+s⟨2,\\sqrt{5},-3⟩+t⟨4,-2,5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186312108} {:answer/id #uuid "78c7335c-4ef2-58db-a5b3-16c9383e696e" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨7,-3,4⟩+s⟨\\sqrt{5},-3,2⟩+t⟨-5,4,-2⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186312109} {:answer/id #uuid "e56a2215-2acd-5880-87f1-f68dbae04c88" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨7,-3,4⟩+s⟨\\sqrt{5},-3,2⟩+t⟨-2,4,-5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186312110}] :answer-field/correct {:answer/id #uuid "e56a2215-2acd-5880-87f1-f68dbae04c88" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨7,-3,4⟩+s⟨\\sqrt{5},-3,2⟩+t⟨-2,4,-5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186312110} :answer-field/id #uuid "d2f11961-4564-5563-8db1-45242ab040