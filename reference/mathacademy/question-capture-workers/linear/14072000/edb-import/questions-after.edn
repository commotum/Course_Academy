#{[{:db/id #edb/ref 17592186373997 :knowledge-point/_questions [{:knowledge-point/id #uuid "595fd527-e8fd-5360-87f1-acbeab511566" :knowledge-point/title "Finding the Change-of-Coordinates Matrix Given a Linear Connection Between Two Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17037c0e-e866-5a2a-b8ff-8e7743ace700" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & 1 \\\\ 1 & -2\\end{aligned}]" :db/id #edb/ref 17592186373999} {:answer/id #uuid "f5d1db51-2145-58ed-85a4-173887701275" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & 2 \\\\ 2 & -1\\end{aligned}]" :db/id #edb/ref 17592186374000} {:answer/id #uuid "eeb4989f-f167-5a83-a9f6-4ed633ca2702" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & 1 \\\\ 2 & -1\\end{aligned}]" :db/id #edb/ref 17592186374001} {:answer/id #uuid "72b1e845-1654-5ea4-8441-657059cffc72" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & 1 \\\\ 2 & -2\\end{aligned}]" :db/id #edb/ref 17592186374002} {:answer/id #uuid "15afda04-9654-5db6-afb9-7f6583ac1787" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -1 \\\\ -2 & 2\\end{aligned}]" :db/id #edb/ref 17592186374003}] :answer-field/correct {:answer/id #uuid "72b1e845-1654-5ea4-8441-657059cffc72" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & 1 \\\\ 2 & -2\\end{aligned}]" :db/id #edb/ref 17592186374002} :answer-field/id #uuid "4e9f715c-289d-55b3-b407-cf469e639694" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373998}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8bcd060e-67aa-5a69-a9d1-f310cdace57a" :question/math-academy-id "q-113105" :question/problem "Let $B={{b}_{1},{b}_{2}}$ and $C={{c}_{1},{c}_{2}}$ be bases of ${R}^{2}.$ If ${b}_{1}=2{c}_{2}-2{c}_{1}$ and ${b}_{2}={c}_{1}-2{c}_{2},$ find the change-of-coordinates matrix ${P}_{B\\to C}$ from $B$ to $C.$" :question/worked-solution "The coordinates of the vectors in $B$ relative to the basis $C$ are\n\n$$\n[{b}_{1}]_{C}=[\\begin{aligned}-2 \\\\ 2\\end{aligned}]\\,[{b}_{2}]_{C}=[\\begin{aligned}1 \\\\ -2\\end{aligned}].\n$$\n\nThe change-of-coordinates matrix from $B$ to $C$ is a matrix whose respective columns are the coordinates of the vectors of $B$ relative to the basis $C.$ \n\nTherefore, we obtain\n\n$$\n{P}_{B\\to C}=[\\begin{aligned}-2 & 1 \\\\ 2 & -2\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186374004 :knowledge-point/_questions [{:knowledge-point/id #uuid "23b6a85e-e1de-590c-84d2-379052b1b9f3" :knowledge-point/title "Using the Invertibility Property of the Change-of-Coordinates Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb569263-df53-582c-947a-0456dce3ea40" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & -\\frac{1}{2} \\\\ -2 & -1\\end{aligned}]" :db/id #edb/ref 17592186374006} {:answer/id #uuid "1f1df4b9-9903-53c2-8781-f1911fd9b550" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{2} & -1 \\\\ \\frac{1}{2} & -2\\end{aligned}]" :db/id #edb/ref 17592186374007} {:answer/id #uuid "801a8750-078f-5d46-aec2-63c847d08218" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -\\frac{1}{2} \\\\ \\frac{1}{2} & -2\\end{aligned}]" :db/id #edb/ref 17592186374008} {:answer/id #uuid "fe308c27-fbc3-5982-8d48-8b313bcd2a3b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & -\\frac{1}{2} \\\\ \\frac{1}{2} & -2\\end{aligned}]" :db/id #edb/ref 17592186374009} {:answer/id #uuid "38a19ca9-b831-5bb7-83cc-f56bc01bb904" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -1 \\\\ \\frac{1}{2} & -2\\end{aligned}]" :db/id #edb/ref 17592186374010}] :answer-field/correct {:answer/id #uuid "1f1df4b9-9903-53c2-8781-f1911fd9b550" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{2} & -1 \\\\ \\frac{1}{2} & -2\\end{aligned}]" :db/id #edb/ref 17592186374007} :answer-field/id #uuid "0bb1ea54-9a3d-51c5-9e85-a16a7bd07ce3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374005}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ad575676-d5ef-5eb2-bc7e-597e663d8c9b" :question/math-academy-id "q-113411" :question/problem "The change-of-coordinates matrix from the basis $C$ to the basis $B$ is given by\n${P}_{C\\to B}=[\\begin{aligned}4 & -2 \\\\ 1 & -1\\end{aligned}].$ Find the change-of-coordinates matrix from $B$ to $C.$" :question/worked-solution "The change-of-coordinates matrix from $B$ to $C$ is the inverse of the change-of-coordinates matrix from $C$ to $B.$ Therefore, we simply need to find the inverse of the given matrix.\n\nComputing the inverse of ${P}_{C\\to B}$, we get\n\n$$\n\\begin{aligned}{P}_{B\\to C} & ={P}_{C\\to B}^{-1} \\\\  & ={[\\begin{aligned}4 & -2 \\\\ 1 & -1\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{4\\cdot (-1)-(-2)\\cdot 1}[\\begin{aligned}-1 & 2 \\\\ -1 & 4\\end{aligned}] \\\\  & =(-\\frac{1}{2})\\cdot [\\begin{aligned}-1 & 2 \\\\ -1 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{2} & -1 \\\\ \\frac{1}{2} & -2\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186374011 :knowledge-point/_questions [{:knowledge-point/id #uuid "f989cbaf-2d99-5267-8864-48a48db2d535" :knowledge-point/title "Finding the Change-of-Coordinates Matrix Between Two Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed058997-8ad5-54c2-8557-0e8e16b8f9ce" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-7 & 1 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186374013} {:answer/id #uuid "2b5dc9ea-bafd-54dc-bdc2-68a8171405b6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & -9 \\\\ 0 & 6\\end{aligned}]" :db/id #edb/ref 17592186374014} {:answer/id #uuid "30a9b801-aeb8-5ab8-a393-2cde0442b1b7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 1 \\\\ 0 & -9\\end{aligned}]" :db/id #edb/ref 17592186374015} {:answer/id #uuid "7a4974c8-d520-508d-ae18-8ef5622aab4e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 3 \\\\ 2 & 0\\end{aligned}]" :db/id #edb/ref 17592186374016} {:answer/id #uuid "1216c78b-ab54-5b03-a07f-676894944c33" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 \\\\ -2 & -3\\end{aligned}]" :db/id #edb/ref 17592186374017}] :answer-field/correct {:answer/id #uuid "2b5dc9ea-bafd-54dc-bdc2-68a8171405b6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & -9 \\\\ 0 & 6\\end{aligned}]" :db/id #edb/ref 17592186374014} :answer-field/id #uuid "8c0766a9-a4b4-5927-8a5a-32dc01fe7659" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374012}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "8f8f7997-5431-5c08-819e-4fce158922f7" :question/math-academy-id "q-35689" :question/problem "Let $B={[\\begin{aligned}1 \\\\ -2\\end{aligned}],[\\begin{aligned}2 \\\\ -3\\end{aligned}]}$ and $C={[\\begin{aligned}-1 \\\\ 2\\end{aligned}],[\\begin{aligned}3 \\\\ 0\\end{aligned}]}$ be bases of ${R}^{2}.$ Find the change-of-coordinates matrix from $C$ to $B.$" :question/worked-solution "Let's denote the vectors of $B$ and $C$ as ${{b}_{1},{b}_{2}}$ and ${{c}_{1},{c}_{2}}$, respectively.\n\nThe change-of-coordinates matrix from $C$ to $B$ is a matrix whose columns are the coordinates of the vectors of $C$ relative to the basis $B.$\n\nHence, we need to find the coordinates of ${c}_{1}$ and ${c}_{2}$ relative to the basis $B.$ We can do this simultaneously by considering the matrix\n\n$$\nM=[\\begin{aligned}| & | & | & | \\\\ {b}_{1} & {b}_{2} & {c}_{1} & {c}_{2} \\\\ | & | & | & |\\end{aligned}].\n$$\n\nNow, we simply reduce the left-hand side to reduced row-echelon form using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 2 & -1 & 3 \\\\ -2 & -3 & 2 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & -1 & 3 \\\\ 0 & 1 & 0 & 6\\end{aligned}] & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & -1 & -9 \\\\ 0 & 1 & 0 & 6\\end{aligned}]\\end{aligned}\n$$\n\nOn the right-hand side, we obtain the change-of-coordinates matrix from $C$ to $B.$ Therefore, we have\n\n$$\n{P}_{C\\to B}=[\\begin{aligned}-1 & -9 \\\\ 0 & 6\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186374018 :knowledge-point/_questions [{:knowledge-point/id #uuid "6b973d79-8fe4-5033-8202-9693004855dc" :knowledge-point/title "Finding the Change-of-Coordinates Matrix When One of the Bases is the Standard Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f24d9346-27c8-5644-9a0a-f274f5c3c214" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & 3 \\\\ 11 & 5\\end{aligned}]" :db/id #edb/ref 17592186374020} {:answer/id #uuid "09e0741e-a563-5229-85c7-c3c06e32b79c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 11 \\\\ -2 & 3\\end{aligned}]" :db/id #edb/ref 17592186374021} {:answer/id #uuid "36fd555b-2b28-5474-8d65-ea0936e4d935" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & 3 \\\\ 5 & 11\\end{aligned}]" :db/id #edb/ref 17592186374022} {:answer/id #uuid "6631ad0d-0998-5dd9-a2d5-a99bcab64b27" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & 5 \\\\ 3 & 11\\end{aligned}]" :db/id #edb/ref 17592186374023} {:answer/id #uuid "d174798c-8d6e-567f-bd6d-4919452d844e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & -2 \\\\ 11 & 3\\end{aligned}]" :db/id #edb/ref 17592186374024}] :answer-field/correct {:answer/id #uuid "36fd555b-2b28-5474-8d65-ea0936e4d935" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & 3 \\\\ 5 & 11\\end{aligned}]" :db/id #edb/ref 17592186374022} :answer-field/id #uuid "e39f4256-42ce-57b6-94f7-20b3ce428065" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374019}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "62dadad6-bc72-59c3-b335-faab5922669e" :question/math-academy-id "q-81847" :question/problem "Let $B={{b}_{1},{b}_{2}}$ be a basis of ${R}^{2}$ and let $S$ be the standard basis of ${R}^{2}.$ \nFind the change-of-coordinates matrix ${P}_{B\\to S}$ from $B$ to $S$ if \n\n$$\n{b}_{1}=[\\begin{aligned}-2 \\\\ 5\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}3 \\\\ 11\\end{aligned}].\n$$" :question/worked-solution "Recall  that the standard basis of ${R}^{2}$ consists of the vectors ${e}_{1}$ and ${e}_{2},$ given by\n\n$$\n{e}_{1}=[\\begin{aligned}1 \\\\ 0\\end{aligned}],\\,{e}_{2}=[\\begin{aligned}0 \\\\ 1\\end{aligned}].\n$$\n\nThe components of the vectors of $B$ are just the coordinates relative to the standard basis:\n\n$$\n[{b}_{1}]_{S}=[\\begin{aligned}-2 \\\\ 5\\end{aligned}],\\,[{b}_{2}]_{S}=[\\begin{aligned}3 \\\\ 11\\end{aligned}]\n$$\n\nThe change-of-coordinates matrix from $B$ to $S$ is a matrix whose respective columns are the coordinates of the vectors of $B$ relative to the basis $S.$ \n\nTherefore, we obtain\n\n$$\n{P}_{B\\to S}=[\\begin{aligned}-2 & 3 \\\\ 5 & 11\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186374025 :knowledge-point/_questions [{:knowledge-point/id #uuid "23b6a85e-e1de-590c-84d2-379052b1b9f3" :knowledge-point/title "Using the Invertibility Property of the Change-of-Coordinates Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f37e5184-51e0-5f07-a094-22228931b99c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 & -7 \\\\ 3 & 4\\end{aligned}]" :db/id #edb/ref 17592186374027} {:answer/id #uuid "0c27da77-eda0-5edc-a157-ef5b5c0ba20d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 & -3 \\\\ -7 & 4\\end{aligned}]" :db/id #edb/ref 17592186374028} {:answer/id #uuid "e1e33884-ffab-5dd2-b550-6a7cd370dc39" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & 7 \\\\ -3 & -5\\end{aligned}]" :db/id #edb/ref 17592186374029} {:answer/id #uuid "5db1036b-8a0c-550e-9a99-91478cedaa5b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & -3 \\\\ 7 & -5\\end{aligned}]" :db/id #edb/ref 17592186374030} {:answer/id #uuid "4821dc14-4b67-5838-9261-f50a7911fc6c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 & 7 \\\\ -3 & 4\\end{aligned}]" :db/id #edb/ref 17592186374031}] :answer-field/correct {:answer/id #uuid "4821dc14-4b67-5838-9261-f50a7911fc6c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 & 7 \\\\ -3 & 4\\end{aligned}]" :db/id #edb/ref 17592186374031} :answer-field/id #uuid "4294d352-a4d3-5ccb-8bad-7147b8ed84fa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374026}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3e562f59-572b-52a9-8296-807890374941" :question/math-academy-id "q-81855" :question/problem "The change-of-coordinates matrix from the basis $B$ to the basis $C$ is given by \n${P}_{B\\to C}=[\\begin{aligned}4 & -7 \\\\ 3 & -5\\end{aligned}].$\nFind the change-of-coordinates matrix from $C$ to $B$  ." :question/worked-solution "The change-of-coordinates matrix from $C$ to $B$ is the inverse of the change-of-coordinates matrix from $B$ to $C.$ Therefore, we simply need to find the inverse of the given matrix.\n\nComputing the inverse of ${P}_{B\\to C}$, we get\n\n$$\n\\begin{aligned}{P}_{C\\to B} & ={P}_{B\\to C}^{-1} \\\\  & ={[\\begin{aligned}4 & -7 \\\\ 3 & -5\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{4\\cdot (-5)-(-7)\\cdot 3}[\\begin{aligned}-5 & 7 \\\\ -3 & 4\\end{aligned}] \\\\  & =1\\cdot [\\begin{aligned}-5 & 7 \\\\ -3 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}-5 & 7 \\\\ -3 & 4\\end{aligned}].\\end{aligned}\n$$"}]}
