uestion/answer-fields ["q-113105/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "595fd527-e8fd-5360-87f1-acbeab511566"] :knowledge-point/questions ["q-113105"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113411/selection/846146e8b06607b580260751ef4955f6b20b09728254cdf8b7856494427973aa" :answer/id #uuid "1f1df4b9-9903-53c2-8781-f1911fd9b550" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{1}{2} & -1 \\\\ \\frac{1}{2} & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-113411/selection/8ac4ea94b3270951a5c1ce5918c93e07e24a9f616de9e889bb509ef37815bdb6" :answer/id #uuid "801a8750-078f-5d46-aec2-63c847d08218" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & -\\frac{1}{2} \\\\ \\frac{1}{2} & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-113411/selection/94a4f3525952e6abf436092bce1174d8337cf4efee907a757b6b78349a868d56" :answer/id #uuid "fe308c27-fbc3-5982-8d48-8b313bcd2a3b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 & -\\frac{1}{2} \\\\ \\frac{1}{2} & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-113411/selection/99dfa4606610df9475a29df99b8b1b7e318627594852ef1053bb2165c4a62548" :answer/id #uuid "38a19ca9-b831-5bb7-83cc-f56bc01bb904" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & -1 \\\\ \\frac{1}{2} & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-113411/selection/73ca4b6a77c45cc18d3bd723074f7d9a0fcd7ee8cee6711cddff7115c050bef2" :answer/id #uuid "eb569263-df53-582c-947a-0456dce3ea40" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 & -\\frac{1}{2} \\\\ -2 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-113411/selection" :answer-field/id #uuid "0bb1ea54-9a3d-51c5-9e85-a16a7bd07ce3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113411/selection/846146e8b06607b580260751ef4955f6b20b09728254cdf8b7856494427973aa" :answer-field/choices ["q-113411/selection/846146e8b06607b580260751ef4955f6b20b09728254cdf8b7856494427973aa" "q-113411/selection/8ac4ea94b3270951a5c1ce5918c93e07e24a9f616de9e889bb509ef37815bdb6" "q-113411/selection/94a4f3525952e6abf436092bce1174d8337cf4efee907a757b6b78349a868d56" "q-113411/selection/99dfa4606610df9475a29df99b8b1b7e318627594852ef1053bb2165c4a62548" "q-113411/selection/73ca4b6a77c45cc18d3bd723074f7d9a0fcd7ee8cee6711cddff7115c050bef2"] :db/ensure [:answer-field/validate]} {:db/id "q-113411" :question/id #uuid "ad575676-d5ef-5eb2-bc7e-597e663d8c9b" :question/math-academy-id "q-113411" :question/problem "The change-of-coordinates matrix from the basis $C$ to the basis $B$ is given by\n${P}_{C\\to B}=[\\begin{aligned}4 & -2 \\\\ 1 & -1\\end{aligned}].$ Find the change-of-coordinates matrix from $B$ to $C.$" :question/worked-solution "The change-of-coordinates matrix from $B$ to $C$ is the inverse of the change-of-coordinates matrix from $C$ to $B.$ Therefore, we simply need to find the inverse of the given matrix.\n\nComputing the inverse of ${P}_{C\\to B}$, we get\n\n$$\n\\begin{aligned}{P}_{B\\to C} & ={P}_{C\\to B}^{-1} \\\\  & ={[\\begin{aligned}4 & -2 \\\\ 1 & -1\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{4\\cdot (-1)-(-2)\\cdot 1}[\\begin{aligned}-1 & 2 \\\\ -1 & 4\\end{aligned}] \\\\  & =(-\\frac{1}{2})\\cdot [\\begin{aligned}-1 & 2 \\\\ -1 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{2} & -1 \\\\ \\frac{1}{2} & -2\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-113411/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "23b6a85e-e1de-590c-84d2-379052b1b9f3"] :knowledge-point/questions ["q-113411"] :db/ensure [:knowledge-point/validate]}]
