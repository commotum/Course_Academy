#{[{:db/id #edb/ref 17592186262775 :knowledge-point/_questions [{:knowledge-point/id #uuid "a75b47ec-8d5a-545e-b915-daca92320322" :knowledge-point/title "Identifying Non-Roots of a Polynomial Using the Rational Roots Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bdf7a7e2-c83d-5d7f-a3be-d03c4fd46a56" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186262777} {:answer/id #uuid "d8542cc2-cb0a-5cf8-84ad-40437a5be95e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{21}" :db/id #edb/ref 17592186262778} {:answer/id #uuid "5100696c-1323-5af2-94ba-f71d4f2e601b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186262779} {:answer/id #uuid "45e3514d-7e1e-5a50-aec2-37cd36d7b91c" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186262780} {:answer/id #uuid "af67276e-0858-58f6-8d90-ce34dfe7c0ca" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186262781}] :answer-field/correct {:answer/id #uuid "d8542cc2-cb0a-5cf8-84ad-40437a5be95e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{21}" :db/id #edb/ref 17592186262778} :answer-field/id #uuid "1f68bd25-2d3e-5bc1-b52a-7f474271c701" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262776}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6029834b-7153-5587-95c0-5adfbb9eff9b" :question/math-academy-id "q-112876" :question/problem "According to the rational roots theorem, which of the following **cannot** be a root of the polynomial $f(x)=14{x}^{4}+3{x}^{2}-x-7?$" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial $f(x),$ the constant term is $-7$ and the leading coefficient is $14.$ So, any rational roots of $f(x)$ must take the form\n\n$$\n\\pm \\frac{\\text{factor of }-7}{\\text{factor of }14}.\n$$\n\nOf the given answer choices, only $\\frac{1}{21}$ does not take the above form. The denominator $(21)$ is not a factor of $14.$"}]}
