written in one way. Equating the coefficients, we get:\n\n- $\\lambda =-2$ and $\\mu =-\\frac{1}{2}$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072133/state.json" "file_sha256" "bd56d06731bf3a892817106cbdb95ceb9c384088c6beda0f637b80eae6fe7989"} {"question" "q-326014" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072133/activity-metadata.json" "file_sha256" "11c191ae8e2641d8e32dc83a684af92f102dca348edd2c027c4163fe1ba2fdfb"} {"question" "q-326014" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072133/state.json" "file_sha256" "bd56d06731bf3a892817106cbdb95ceb9c384088c6beda0f637b80eae6fe7989"} {"question" "q-326014" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072133/state.json" "file_sha256" "bd56d06731bf3a892817106cbdb95ceb9c384088c6beda0f637b80eae6fe7989"} {"question" "q-326014" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072133/state.json" "file_sha256" "bd56d06731bf3a892817106cbdb95ceb9c384088c6beda0f637b80eae6fe7989"} {"question" "q-326014" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{1}{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14072133/state.json" "file_sha256" "bd56d06731bf3a892817106cbdb95ceb9c38408