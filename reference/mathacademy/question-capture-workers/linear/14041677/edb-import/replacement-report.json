    {
      "question": "e-4707",
      "field": null,
      "attribute": "question/problem",
      "old_sha256": "b927b755e475fff3796218c3b662d8fdbc5528fc21b4ec5808fbd985e56f1fd9",
      "new_sha256": "37a145c79f08d43e15454bfe2ba68ef13c9e9e79133ba087dfc1017a15981680",
      "category": "ma_capture",
      "authoring": [],
      "source": [
        {
          "question": "e-4707",
          "field": null,
          "attribute": "question/problem",
          "value": "Consider the augmented matrix $M$ given by \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041677/assets/d471d04342460227e2aea9f1afe0f8149c648f5fd40c1d0ea45fe369bb9dff14.png)\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then find the general solution of the linear system represented by the matrix.",
          "category": "ma_capture",
          "file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041677/example-4707.json",
          "file_sha256": "ad2968f4ff74a5f939390c669d1a27f5bbf0debf4096e9e326411836a4703e54"
        }
      ],
