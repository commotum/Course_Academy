em has no solution." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041677/state.json" "file_sha256" "020b8a67639f987b020273f05845ac1ef3068df103fba9f2e8702277c9a22275"} {"question" "q-73955" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041677/activity-metadata.json" "file_sha256" "b3e78a9c84e0212da886c5543cbe7115ae579a917b76e508cf22103c3595052f"} {"question" "q-73955" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041677/state.json" "file_sha256" "020b8a67639f987b020273f05845ac1ef3068df103fba9f2e8702277c9a22275"} {"question" "q-73955" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-1 \\\\ 0 \\\\ 0\\end{aligned}]+y[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]+z[\\begin{aligned}-4 \\\\ 0 \\\\ 1\\end{aligned}],\\,y,z\\in (-\\infty ,\\infty )"] ["math" "[\\begin{aligned}-1 \\\\ 0 \\\\ 0\\end{aligned}]+y[\\begin{aligned}0 \\\\ 1 \\\\ -1\\end{aligned}]+z[\\begin{aligned}4 \\\\ 0 \\\\ 1\\end{aligned}],\\,y,z\\in (-\\infty ,\\infty )"] ["math" "[\\begin{aligned}-1 \\\\ 0 \\\\ 0\\end{aligned}]+y[\\begin{aligned}1 \\\\ 0 \\\\ -1\\end{aligned}]+z[\\begin{aligned}4 \\\\ 0 \\\\ 1\\end{aligned}],\\,y,z\\in (-\\infty ,\\infty )"] ["math" "[\\begin{aligned}-1 \\\\ 0 \\\\ 0\\end{aligned}]+y[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]+z[\\begin{aligned}-4 \\\\ 0 \\\\ 1\\end{aligned}],\\,y,z\\in (-\\infty ,\\infty )"] ["text" "No solution"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041677/state.json" "file_sha256" "020b8a67639f987b020273f05845ac1ef3068df103f