#{[{:db/id #edb/ref 17592186257401 :knowledge-point/_questions [{:knowledge-point/id #uuid "d820aa9f-7c02-53b5-9b09-c25ee59dbdaf" :knowledge-point/title "Using the Double-Angle Formula Multiple Times"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ecfd948-ebcb-56b9-8393-d73b7b5edf38" :answer/type {:db/ident :answer.type/math} :answer/value "2(5)" :db/id #edb/ref 17592186270442} {:answer/id #uuid "e88aabae-de3a-56f7-970d-942816d9d158" :answer/type {:db/ident :answer.type/math} :answer/value "(3)/(2)" :db/id #edb/ref 17592186270443} {:answer/id #uuid "ee141aa1-9b0f-5121-bbb4-ca3e629d2447" :answer/type {:db/ident :answer.type/math} :answer/value "-(5)" :db/id #edb/ref 17592186270444} {:answer/id #uuid "5669b4ae-d738-5b7f-945b-508dddefea1c" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(2)" :db/id #edb/ref 17592186270445} {:answer/id #uuid "df61159e-1675-59bb-9637-8070393a178f" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186270446}] :answer-field/correct {:answer/id #uuid "df61159e-1675-59bb-9637-8070393a178f" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186270446} :answer-field/id #uuid "252e3e40-9b54-5a12-85ce-a632bc29687a" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274364}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "72bde4a1-d04b-50b4-bd0e-183a00744709" :question/math-academy-id "q-120087" :question/problem "$10\\operatorname{sin}({75}^{∘})\\operatorname{cos}({75}^{∘})\\operatorname{csc}({150}^{∘})=$" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}x\\operatorname{cos}x=\\operatorname{sin}2x\n$$\n\nSubstituting $x={75}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}2\\operatorname{sin}({75}^{∘})\\operatorname{cos}({75}^{∘}) & =\\operatorname{sin}(2\\cdot {75}^{∘})=\\operatorname{sin}({150}^{∘})\\end{aligned}\n$$\n\nNow, we can rewrite the given expression using the above, as follows:\n\n$$\n\\begin{aligned}10\\operatorname{sin}({75}^{∘})\\operatorname{cos}({75}^{∘})\\operatorname{csc}({150}^{∘}) & =5\\cdot [2\\operatorname{sin}({75}^{∘})\\operatorname{cos}({75}^{∘})]\\operatorname{csc}({150}^{∘}) \\\\  & =5\\operatorname{sin}({150}^{∘})\\cdot \\frac{1}{\\operatorname{sin}({150}^{∘})} \\\\  & =5.\\end{aligned}\n$$"}]}
