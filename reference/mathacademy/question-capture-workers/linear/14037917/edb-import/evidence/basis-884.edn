#{[{:db/id #edb/ref 17592186281682 :knowledge-point/_questions [{:knowledge-point/id #uuid "5f9683d9-05b9-5a42-9f81-0170a15dfac1" :knowledge-point/title "Using the Double-Angle Formula to Simplify Ratios"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "299a4036-7401-5ec0-be7f-2022c81d1096" :answer/type {:db/ident :answer.type/math} :answer/value "1+{cos}^{2}⁡{50}^{∘}" :db/id #edb/ref 17592186281684} {:answer/id #uuid "5e74f45f-6145-5c80-9cfe-c0ed118e55bf" :answer/type {:db/ident :answer.type/math} :answer/value "1+\\operatorname{cos}⁡{50}^{∘}" :db/id #edb/ref 17592186281685} {:answer/id #uuid "9d36f77e-f34f-5865-a379-4b6195857bef" :answer/type {:db/ident :answer.type/math} :answer/value "{cos}^{2}⁡{50}^{∘}" :db/id #edb/ref 17592186281686} {:answer/id #uuid "023f9a63-2f22-5145-94fb-5736a13bae5a" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡{50}^{∘}-1" :db/id #edb/ref 17592186281687} {:answer/id #uuid "a1cb1f7d-bc36-5ff9-a3ee-57d48f84ac6b" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\operatorname{cos}⁡{50}^{∘}" :db/id #edb/ref 17592186281688}] :answer-field/correct {:answer/id #uuid "5e74f45f-6145-5c80-9cfe-c0ed118e55bf" :answer/type {:db/ident :answer.type/math} :answer/value "1+\\operatorname{cos}⁡{50}^{∘}" :db/id #edb/ref 17592186281685} :answer-field/id #uuid "ac5edacb-bfbd-58aa-8234-65a8e4b4cad7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281683}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "178fb81d-b009-5067-9e70-c3ccaf69f0be" :question/math-academy-id "q-120029" :question/problem "$\\frac{\\operatorname{sin}⁡{100}^{∘}\\operatorname{tan}⁡{50}^{∘}}{2-2\\operatorname{cos}⁡{50}^{∘}}=$" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n\\operatorname{sin}⁡2x=2\\operatorname{sin}⁡x\\operatorname{cos}⁡x\n$$\n\nSubstituting $x={50}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(2\\cdot {50}^{∘}) & =2\\operatorname{sin}⁡{50}^{∘}\\operatorname{cos}⁡{50}^{∘} \\\\ \\operatorname{sin}⁡({100}^{∘}) & =2\\operatorname{sin}⁡{50}^{∘}\\operatorname{cos}⁡{50}^{∘}.\\end{aligned}\n$$\n\nNow, we can rewrite the given expression using the above, as follows:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡{100}^{∘}\\operatorname{tan}⁡{50}^{∘}}{2-2\\operatorname{cos}⁡{50}^{∘}} & =\\frac{2\\operatorname{sin}⁡{50}^{∘}\\operatorname{cos}⁡{50}^{∘}\\cdot \\frac{\\operatorname{sin}⁡{50}^{∘}}{\\operatorname{cos}⁡{50}^{∘}}}{2-2\\operatorname{cos}⁡{50}^{∘}} \\\\  & =\\frac{2{sin}^{2}⁡{50}^{∘}}{2(1-\\operatorname{cos}⁡{50}^{∘})} \\\\  & =\\frac{{sin}^{2}⁡{50}^{∘}}{1-\\operatorname{cos}⁡{50}^{∘}}\\end{aligned}\n$$\n\nUsing  the Pythagorean identity ${sin}^{2}⁡{50}^{∘}=1-{cos}^{2}⁡{50}^{∘},$ we get\n\n$$\n\\begin{aligned}\\frac{{sin}^{2}⁡{50}^{∘}}{1-\\operatorname{cos}⁡{50}^{∘}} & =\\frac{1-{cos}^{2}⁡{50}^{∘}}{1-\\operatorname{cos}⁡{50}^{∘}} \\\\  & =\\frac{(1-\\operatorname{cos}⁡{50}^{∘})(1+\\operatorname{cos}⁡{50}^{∘})}{1-\\operatorname{cos}⁡{50}^{∘}} \\\\  & =\\frac{\\cancel{(1-\\operatorname{cos}⁡{50}^{∘})}(1+\\operatorname{cos}⁡{50}^{∘})}{\\cancel{1-\\operatorname{cos}⁡{50}^{∘}}} \\\\  & =1+\\operatorname{cos}⁡{50}^{∘}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281689 :knowledge-point/_questions [{:knowledge-point/id #uuid "d820aa9f-7c02-53b5-9b09-c25ee59dbdaf" :knowledge-point/title "Using the Double-Angle Formula Multiple Times"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed202dc5-ee81-586d-86e5-9ab11f560c38" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{csc}⁡({70}^{∘})" :db/id #edb/ref 17592186281691} {:answer/id #uuid "28acbdae-db5d-555e-9992-ecf841025666" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡({70}^{∘})" :db/id #edb/ref 17592186281692} {:answer/id #uuid "397beb83-55b4-5c02-b7ad-41cdd0598e99" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186281693} {:answer/id #uuid "66ebe9bc-0c6a-5192-a142-6bafb0f428aa" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186281694} {:answer/id #uuid "c14d2ba0-9102-545b-b898-0f3bfdac943f" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡({140}^{∘})" :db/id #edb/ref 17592186281695}] :answer-field/correct {:answer/id #uuid "397beb83-55b4-5c02-b7ad-41cdd0598e99" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186281693} :answer-field/id #uuid "fe430471-858f-5d77-bff2-394ae8b417ee" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281690}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "4169dfb7-ab66-5202-bba3-44ee807d3294" :question/math-academy-id "q-120088" :question/problem "$4\\operatorname{sin}⁡({70}^{∘})\\operatorname{cos}⁡({70}^{∘})\\operatorname{csc}⁡({140}^{∘})=$" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x={70}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡({70}^{∘})\\operatorname{cos}⁡({70}^{∘}) & =\\operatorname{sin}⁡(2\\cdot {70}^{∘})=\\operatorname{sin}⁡({140}^{∘})\\end{aligned}\n$$\n\nNow, we can rewrite the given expression using the above, as follows:\n\n$$\n\\begin{aligned}4\\operatorname{sin}⁡({70}^{∘})\\operatorname{cos}⁡({70}^{∘})\\operatorname{csc}⁡({140}^{∘}) & =2\\cdot [2\\operatorname{sin}⁡({70}^{∘})\\operatorname{cos}⁡({70}^{∘})]\\operatorname{csc}⁡({140}^{∘}) \\\\  & =2\\operatorname{sin}⁡({140}^{∘})\\cdot \\frac{1}{\\operatorname{sin}⁡({140}^{∘})} \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281710 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c898bbf-004c-5905-a0a0-761adefc8bd8" :knowledge-point/title "Finding Exact Value of a Trigonometric Expression Using the Double-Angle Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a45e51d-f70a-5874-b11a-869458395675" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186281712} {:answer/id #uuid "66d5ed59-acae-5814-88a2-c001856f340b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186281713} {:answer/id #uuid "9a468535-3fdd-5b63-96c6-d15132632f9a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186281714} {:answer/id #uuid "2b8bba33-5efc-5664-abb1-64164441b219" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186281715} {:answer/id #uuid "e5275784-6a42-5d5e-8e9a-769842fb3714" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186281716}] :answer-field/correct {:answer/id #uuid "66d5ed59-acae-5814-88a2-c001856f340b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186281713} :answer-field/id #uuid "325ac987-ef40-57a3-8dc9-7b94c22d1867" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281711}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d2efd2da-aa38-501e-9ec7-9a761ff9a60d" :question/math-academy-id "q-76641" :question/problem "Find the exact value of $2\\operatorname{sin}⁡({75}^{∘})\\operatorname{cos}⁡({75}^{∘}).$" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x={75}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡({75}^{∘})\\operatorname{cos}⁡({75}^{∘}) & =\\operatorname{sin}⁡(2\\cdot {75}^{∘}) \\\\  & =\\operatorname{sin}⁡{150}^{∘} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n2\\operatorname{sin}⁡({75}^{∘})\\operatorname{cos}⁡({75}^{∘})=\\frac{1}{2}.\n$$"}]}
