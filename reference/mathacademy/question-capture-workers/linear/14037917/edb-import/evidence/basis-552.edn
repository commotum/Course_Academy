#{[{:db/id #edb/ref 17592186257401 :knowledge-point/_questions [{:knowledge-point/id #uuid "d820aa9f-7c02-53b5-9b09-c25ee59dbdaf" :knowledge-point/title "Using the Double-Angle Formula Multiple Times"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88ed0792-cb18-51e5-a9a3-54d22711fc17" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186257403}] :answer-field/correct {:answer/id #uuid "88ed0792-cb18-51e5-a9a3-54d22711fc17" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186257403} :answer-field/id #uuid "127575f2-8f92-59b9-afdf-8307dff9b6e4" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257402}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "72bde4a1-d04b-50b4-bd0e-183a00744709" :question/math-academy-id "q-120087" :question/problem "$10\\operatorname{sin}({75}^{∘})\\operatorname{cos}({75}^{∘})\\operatorname{csc}({150}^{∘})=$\n\nAnswer: {{answer}}" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}x\\operatorname{cos}x=\\operatorname{sin}2x\n$$\n\nSubstituting $x={75}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}2\\operatorname{sin}({75}^{∘})\\operatorname{cos}({75}^{∘}) & =\\operatorname{sin}(2\\cdot {75}^{∘})=\\operatorname{sin}({150}^{∘})\\end{aligned}\n$$\n\nNow, we can rewrite the given expression using the above, as follows:\n\n$$\n\\begin{aligned}10\\operatorname{sin}({75}^{∘})\\operatorname{cos}({75}^{∘})\\operatorname{csc}({150}^{∘}) & =5\\cdot [2\\operatorname{sin}({75}^{∘})\\operatorname{cos}({75}^{∘})]\\operatorname{csc}({150}^{∘}) \\\\  & =5\\operatorname{sin}({150}^{∘})\\cdot \\frac{1}{\\operatorname{sin}({150}^{∘})} \\\\  & =5.\\end{aligned}\n$$"}]}
