peratorname{sin}⁡{150}^{∘} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n2\\operatorname{sin}⁡({75}^{∘})\\operatorname{cos}⁡({75}^{∘})=\\frac{1}{2}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981249/state.json" "file_sha256" "aabaa3971ab09c99ebf065fdd4173e7fe235b0f15d5ccee8e707b7d7b9e3445c" "basis" 884 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981249/edb-import/verification.json"} {"question" "q-76641" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981249/activity-metadata.json" "file_sha256" "71603e0344de9c030e720c67ee6b94d1321d7bc80f343f0194ae56b9506b558f" "basis" 884 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981249/edb-import/verification.json"} {"question" "q-76641" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981249/state.json" "file_sha256" "aabaa3971ab09c99ebf065fdd4173e7fe235b0f15d5ccee8e707b7d7b9e3445c" "basis" 884 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981249/edb-import/verification.json"} {"question" "q-76641" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "-\\frac{\\sqrt{3}}{2}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981249/state.json" "file_sha256" "aabaa3971ab09c99ebf065fdd4173e7fe235b0f15d5ccee8e707b7d7b9e3445c" "basis" 884 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981249/edb-import/verification.json"} {"question" "q-76641" "field" "selection" "attribute" "answer/va