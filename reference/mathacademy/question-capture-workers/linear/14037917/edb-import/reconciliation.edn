y/reference/mathacademy/question-capture/13981249/state.json" "file_sha256" "aabaa3971ab09c99ebf065fdd4173e7fe235b0f15d5ccee8e707b7d7b9e3445c" "basis" 884 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981249/edb-import/verification.json"} {"question" "q-120029" "field" nil "attribute" "question/problem" "value" "$\\frac{\\operatorname{sin}⁡{100}^{∘}\\operatorname{tan}⁡{50}^{∘}}{2-2\\operatorname{cos}⁡{50}^{∘}}=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981249/state.json" "file_sha256" "aabaa3971ab09c99ebf065fdd4173e7fe235b0f15d5ccee8e707b7d7b9e3445c" "basis" 884 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981249/edb-import/verification.json"} {"question" "q-120029" "field" nil "attribute" "question/worked-solution" "value" "First, let's recall the double-angle formula for sine: \n\n$$\n\\operatorname{sin}⁡2x=2\\operatorname{sin}⁡x\\operatorname{cos}⁡x\n$$\n\nSubstituting $x={50}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(2\\cdot {50}^{∘}) & =2\\operatorname{sin}⁡{50}^{∘}\\operatorname{cos}⁡{50}^{∘} \\\\ \\operatorname{sin}⁡({100}^{∘}) & =2\\operatorname{sin}⁡{50}^{∘}\\operatorname{cos}⁡{50}^{∘}.\\end{aligned}\n$$\n\nNow, we can rewrite the given expression using the above, as follows:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡{100}^{∘}\\operatorname{tan}⁡{50}^{∘}}{2-2\\operatorname{cos}⁡{50}^{∘}} & =\\frac{2\\operatorname{sin}⁡{50}^{∘}\\operatorname{cos}⁡{50}^{∘}\\cdot \\frac{\\operatorname{sin}⁡{50}^{∘}}{\\operatorname{cos}⁡{50}^{∘}}}{2-2\\operatorname{cos}⁡{50}^{∘}} \\\\  & =\\frac{2{sin}^{2}⁡{50}^{∘}}{2(1-\\operatorname{cos}⁡{50}^{∘})} \\\\  & =\\frac{{sin}^{2}⁡{50}^{∘}}{1-\\operatorname{cos}⁡{50}^{∘}}\\end{aligned}\n$$\n\nUsing  the Pythagorean identity ${sin}^{2}⁡{50}^{∘}=1-{cos}^{2}⁡{50}^{∘},$ we get\n\n$$\n\\begin{aligned}\\frac{{sin}^{2}⁡{50}^{∘}}{1-\\operatorname{cos}⁡{50}^{∘}} & =\\frac{1-{cos}^{2}⁡{50}^{∘}}{1-\\operatorname{cos}⁡{50}^{∘}} \\\\  & =\\frac{(1-\\operatorname{cos}⁡{50}^{∘})(1+\\operatorname{cos}⁡{50}^{∘})}{1-\\operatorname{cos}⁡{50}^{∘}} \\\\  & =\\frac{\\cancel{(1-\\operatorname{cos}⁡{50}^{∘})}(1+\\operatorname{cos}⁡{50}^{∘})}{\\cancel{1-\\operatorname{cos}⁡{50}^{∘}}} \\\\  & =1+\\operatorname{cos}⁡{50}^{∘}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981249/state.json" "file_sha256" "aabaa3971ab09c99ebf065fdd4173e7fe235b0f15d5ccee8e707b7d7b9e3445c" "basis" 884 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981249/edb-import/verification.json"} {"question" "q-120029" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981249/activity-metadata.json" "file_sha256" "71603e0344de9c030e720c67ee6b94d1321d7bc80f343f0194ae56b9506b558f" "basis" 884 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981249/edb-import/verification.json"} {"question" "q-120029" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981249/state.json" "file_sha256" "aabaa3971ab09c99ebf065fdd4173e7fe235b0f15d5ccee8e707b7d7b9e3445c" "basis" 884 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981249/edb-import/verification.json"} {"question" "q-120029" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "1+\\operatorname{cos}⁡{50}^{∘}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981249/state.json" "file_sha256" "aabaa3971ab09c99ebf065fdd4173e7fe235b0f15d5ccee8e707b7d7