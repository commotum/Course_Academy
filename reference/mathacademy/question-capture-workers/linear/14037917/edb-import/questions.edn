efc8bd8" :knowledge-point/title "Finding Exact Value of a Trigonometric Expression Using the Double-Angle Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d272422f-c611-50b9-9fa7-b922724373dc" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186058019} {:answer/id #uuid "4d587fd7-f6e3-56e2-972b-fe458491c52c" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186058020} {:answer/id #uuid "51a38727-e193-5683-b295-c5726aadbee7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186058021} {:answer/id #uuid "5792f565-5923-5b00-89c8-34edc6cf5dee" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186058022} {:answer/id #uuid "6910ae72-ad52-56f9-9a28-a78eb163a5bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186058023}] :answer-field/correct {:answer/id #uuid "6910ae72-ad52-56f9-9a28-a78eb163a5bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186058023} :answer-field/id #uuid "c97ec4fe-dd15-55b5-b784-78de356f1b48" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186058018}] :question/id #uuid "9f5ad5b9-cf75-5c20-a9c5-6e5d15578fe2" :question/math-academy-id "q-24788" :question/problem "Find the exact value of $(\\sin (\\frac{π}{12}) - \\cos (\\frac{π}{12}))^{2}$."}] [{:db/id #edb/ref 17592186256273 :knowledge-point/_questions [{:knowledge-point/id #uuid "d820aa9f-7c02-53b5-9b09-c25ee59dbdaf" :knowledge-point/title "Using the Double-Angle Formula Multiple Times"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41c89a54-fb37-5e7f-b93d-ebbdffe60694" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186256275} {:answer/id #uuid "75fef84a-4659-5182-9dc8-65882bb13b73" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186256276}] :answer-field/correct {:answer/id #uuid "41c89a54-fb37-5e7f-b93d-ebbdffe60694" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186256275} :answer-field/id #uuid "e0b960d8-b823-521f-ba0a-f080d7d65c62" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256274}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "62770764-8176-56e9-8c60-1a1dcb94a9d1" :question/math-academy-id "q-327716" :question/problem "Find the exact value of $\\frac{\\operatorname{sin}⁡(\\frac{\\pi }{24})\\operatorname{cos}⁡(\\frac{\\pi }{24})}{\\operatorname{sec}⁡(\\frac{\\pi }{12})}.$\n\n$\\frac{\\operatorname{sin}⁡(\\frac{\\pi }{24})\\operatorname{cos}⁡(\\frac{\\pi }{24})}{\\operatorname{sec}⁡(\\frac{\\pi }{12})}=$\n{{field-1}}" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{24}$ into the above, we get\n\n$$\n2\\operatorname{sin}⁡(\\frac{\\pi }{24})\\operatorname{cos}⁡(\\frac{\\pi }{24})=\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{24})\n$$\n\nwhich simplifies as\n\n$$\n2\\operatorname{sin}⁡(\\frac{\\pi }{24})\\operatorname{cos}⁡(\\frac{\\pi }{24})=\\operatorname{sin}⁡(\\frac{\\pi }{12})\n$$\n\nNow, we can rewrite the given expression using the above, as follows:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡(\\frac{\\pi }{24})\\operatorname{cos}⁡(\\frac{\\pi }{24})}{\\operatorname{sec}⁡(\\frac{\\pi }{12})} & =\\frac{\\frac{1}{2}\\operatorname{sin}⁡(\\frac{\\pi }{12})}{\\operatorname{sec}⁡(\\frac{\\pi }{12})} \\\\  & =\\frac{1}{2}\\operatorname{sin}⁡(\\frac{\\pi }{12})\\operatorname{cos}⁡(\\frac{\\pi }{12})\\end{aligned}\n$$\n\nFinally, using the double-angle formula once more with $x=\\frac{\\pi }{12}$, we can further simplify the above expression: \n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡(\\frac{\\pi }{24})\\operatorname{cos}⁡(\\frac{\\pi }{24})}{\\operatorname{sec}⁡(\\frac{\\pi }{12})} & =\\frac{1}{2}\\operatorname{sin}⁡(\\frac{\\pi }{12})\\operatorname{cos}⁡(\\frac{\\pi }{12}) \\\\  & =\\frac{1}{4}\\cdot 2\\operatorname{sin}⁡(\\frac{\\pi }{12})\\operatorname{cos}⁡(\\frac{\\pi }{12}) \\\\  & =\\frac{1}{4}\\cdot \\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{12}) \\\\  & =\\frac{1}{4}\\operatorname{sin}⁡(\\frac{\\pi }{6}) \\\\  & =\\frac{1}{4}\\cdot \\frac{1}{2} \\\\  & =\\frac{1}{8}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256277 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c898bbf-004c-5905-a0a0-761adefc8bd8" :knowledge-point/title "Finding Exact Value of a Trigonometric Expression Using the Double-Angle Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21a4ec08-4df2-504b-8bb2-165aa83be092" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7\\sqrt{2}}{2}" :db/id #edb/ref 17592186256279}] :answer-field/correct {:answer/id #uuid "21a4ec08-4df2-504b-8bb2-165aa83be092" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7\\sqrt{2}}{2}" :db/id #edb/ref 17592186256279} :answer-field/id #uuid "341f39aa-6a81-5083-8264-e503b649bf89" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256278}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "8c3ab403-d373-50aa-ab7d-cad9629d8aab" :question/math-academy-id "q-327763" :question/problem "Find the exact value of $14\\operatorname{sin}⁡(\\frac{7\\pi }{8})\\operatorname{cos}⁡(\\frac{7\\pi }{8}).$\n\n$14\\operatorname{sin}⁡(\\frac{7\\pi }{8})\\operatorname{cos}⁡(\\frac{7\\pi }{8})=$\n{{field-1}}" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x=\\frac{7\\pi }{8}$ into the above, we get\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡(\\frac{7\\pi }{8})\\operatorname{cos}⁡(\\frac{7\\pi }{8}) & =\\operatorname{sin}⁡(2\\cdot \\frac{7\\pi }{8}) \\\\  & =\\operatorname{sin}⁡(\\frac{7\\pi }{4}) \\\\  & =-\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}14\\operatorname{sin}⁡(\\frac{7\\pi }{8})\\operatorname{cos}⁡(\\frac{7\\pi }{8}) & =7\\cdot (2\\operatorname{sin}⁡(\\frac{7\\pi }{8})\\operatorname{cos}⁡(\\frac{7\\pi }{8})) \\\\  & =7\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =-\\frac{7\\sqrt{2}}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256300 :knowledge-point/_questions [{:knowledge-point/id #uuid "143766e0-0ef5-5caf-b699-d394d4a707e9" :knowledge-point/title "Using the Double-Angle Formula to Simplify Products"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6c2ebd8-fdbf-5b5b-8ba1-8fc5fd77a0e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{6\\pi }{7})" :db/id #edb/ref 17592186256302} {:answer/id #uuid "bf1196b0-4c7c-5880-9caf-53995ca6623b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡(\\frac{3\\pi }{7})" :db/id #edb/ref 17592186256303} {:answer/id #uuid "62346b99-48f0-5873-bfe4-a384b2655b88" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{6\\pi }{7})" :db/id #edb/ref 17592186256304} {:answer/id #uuid "30b3b57a-350b-57aa-9671-d921d8ac88f6" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{3\\pi }{14})" :db/id #edb/ref 17592186256305} {:answer/id #uuid "5eb68c40-7670-55f8-9bb2-511ad8765fcb" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡(\\frac{3\\pi }{7})" :db/id #edb/ref 17592186256306}] :answer-field/correct {:answer/id #uuid "62346b99-48f0-5873-bfe4-a384b2655b88" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{6\\pi }{7})" :db/id #edb/ref 17592186256304} :answer-field/id #uuid "3322114a-016d-5a3a-81f3-c9d23de58d6c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256301}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "dffc7ff8-f6d1-5483-ae2f-efbd6a7d92e6" :question/math-academy-id "q-7305" :question/problem "Express $2\\operatorname{sin}⁡(\\frac{3\\pi }{7})\\operatorname{cos}⁡(\\frac{3\\pi }{7})$ as a single trigonometric ratio." :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x=\\frac{3\\pi }{7}$ into the above, we get\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡(\\frac{3\\pi }{7})\\operatorname{cos}⁡(\\frac{3\\pi }{7}) & =\\operatorname{sin}⁡(2\\cdot \\frac{3\\pi }{7})=\\operatorname{sin}⁡(\\frac{6\\pi }{7}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281710 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c898bbf-004c-5905-a0a0-761adefc8bd8" :knowledge-point/title "Finding Exact Value of a Trigonometric Expression Using the Double-Angle Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a45e51d-f70a-5874-b11a-869458395675" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186281712} {:answer/id #uuid "66d5ed59-acae-5814-88a2-c001856f340b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186281713} {:answer/id #uuid "9a468535-3fdd-5b63-96c6-d15132632f9a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186281714} {:answer/id #uuid "2b8bba33-5efc-5664-abb1-64164441b219" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186281715} {:answer/id #uuid "e5