ection/aca948e073e404f81c131d043db8ca9beff297fe22cb633cf8d902d71c47939a" :answer-field/choices ["q-71728/selection/81562e3cee416e1fb384cbb474adda6c268f5d47f8b208b147c9dfea6b7ff1e0" "q-71728/selection/79d605cd188692a841d0bb0ae3027b77150d9c1e6d4e39ab1021358a8da2e973" "q-71728/selection/8c73314cab094060422b3f46b4dc45c32ed20c2ba9b286aa11387a68a79992fe" "q-71728/selection/d4f1657f1e1e09a2f9227632d814b4b8c5f543969c123142204876024e9ae274" "q-71728/selection/aca948e073e404f81c131d043db8ca9beff297fe22cb633cf8d902d71c47939a"] :db/ensure [:answer-field/validate]} {:db/id "q-71728" :question/id #uuid "fccffcb6-cabb-5be9-bcba-30754f9d0e4e" :question/math-academy-id "q-71728" :question/problem "What would be the system of equations for the following augmented matrix?\n\n$$\n[\\begin{aligned}1 & -5 & 10 \\\\ -2 & -3 & -15\\end{aligned}]\n$$" :question/worked-solution "The augmented matrix consists of two parts: the coefficient matrix and the column of constants.\n\nThe coefficient matrix represents the coefficients in the linear system, while the column of constants represents the constants on the right-hand sides of the equations.\n\nUsing the variables $x$ and  $y$,  the corresponding system of equations is\n\n$$\n{\\begin{aligned}x-5y=10 \\\\ -2x-3y=-15\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-71728/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d7c8f4da-c782-51e0-ac51-87a89f31860d"] :knowledge-point/questions ["q-71728"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129146/selection/eebb5da478d4e1b9976fa43bc7da8fb9c0e02201c6be7e278bc48abe6a29471a" :answer/id #uuid "46626434-d94e-5d04-997b-8c9f87f89602" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{1}{3} & 5 & 11 \\\\ 0 & 4 & -8 \\\\ 1 & -6 & \\frac{2}{5}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-129146/selection/36b497a8e9c25b4d316ea407725b30a91d3c67f4f642aa840af8d6939f6e3d56" :answer/id #uuid "31