ion/5f6c142a82c4a0bf971b412708f6830f8e50a71860d9c4cebbd361a473710cf0" "q-174416/selection/9de803f77b12d317ad8b9f75a1e04c192a107b3aa0f7b1d82cf7b15385d4efa1" "q-174416/selection/f6ed8c3e8ac11c4c476e856e67261d9addd41c460d2f0404e6d3f3a72ad0633a" "q-174416/selection/820282211c30a20e021a66f68b7464203ed7fe571ec86a81ae83e0d42d754f2c"] :db/ensure [:answer-field/validate]} {:db/id "q-174416" :question/id #uuid "28999f73-4e7c-54fe-a133-a9cd91a53853" :question/math-academy-id "q-174416" :question/problem "Which of the following are mathematical statements?\n\n- $P:{1,2}\\cup {2,3}={1,2,3}$\n\n- $Q:\\frac{1}{2}=0.5$\n\n- $R:\\sqrt{2}-1$" :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false. \n\nWith that in mind, let's examine the given options:\n\n- $P$ is a statement. This statement is *true* because every element in  ${1,2,3}$ is either in ${1,2}$ or in ${2,3},$ or in both.\n\n- $Q$ is a statement. This statement is *true* because $\\frac{1}{2}$ and $0.5$ are equivalent forms of the same rational number.\n\n- $R$  is *not* a statement because it is neither true nor false.\n\nTherefore, the correct answer is \"$P$ and $Q$ only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-174416/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4eda1965-d655-5550-9bb5-13e7a9c1b406"] :knowledge-point/questions ["q-174416"] :db/ensure [:knowledge-point/validate]} {:db/id "q-174415/selection/5f6c142a82c4a0bf971b412708f6830f8e50a71860d9c4cebbd361a473710cf0" :answer/id #uuid "6af0dc85-88c1-524b-b9f7-d0a62171889c" :answer/type :answer.type/text :answer/value "$Q$ and $R$ only" :db/ensure [:answer/validate]} {:db/id "q-174415/selection/f6ed8c3e8ac11c4c476e856e67261d9addd41c460d2f0404e6d3f3a72ad0633a" :answer/id #uuid "f9cd0ae9-a896-58e8-8996-703d15aa4c24" :answer/type :answer.type/text :answer/value "$P$ and $Q$ only" :db/ensure [:answer/validate]} {:db/id "q-174415