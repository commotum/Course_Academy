ement. This statement is *false* because $0.2$ is not an integer.\n\n- $R$ is *not* a statement because it is neither true nor false.\n\nTherefore, the correct answer is \"$P$ and $Q$ only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-174415/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4eda1965-d655-5550-9bb5-13e7a9c1b406"] :knowledge-point/questions ["q-174415"] :db/ensure [:knowledge-point/validate]} {:db/id "q-174414/selection/820282211c30a20e021a66f68b7464203ed7fe571ec86a81ae83e0d42d754f2c" :answer/id #uuid "d0e01cd6-9fe7-5fae-b880-c4682feed1b4" :answer/type :answer.type/text :answer/value "$R$ only" :db/ensure [:answer/validate]} {:db/id "q-174414/selection/5f6c142a82c4a0bf971b412708f6830f8e50a71860d9c4cebbd361a473710cf0" :answer/id #uuid "8dceb0df-0d90-5ea6-909c-50c1f65b8eba" :answer/type :answer.type/text :answer/value "$Q$ and $R$ only" :db/ensure [:answer/validate]} {:db/id "q-174414/selection/be5beffd9a95134974e6bda496907ef99198947107984fe7477f4a7dcf5134a9" :answer/id #uuid "cff051aa-8d31-5f35-a6be-3c8932bc5ccc" :answer/type :answer.type/text :answer/value "$P$ only" :db/ensure [:answer/validate]} {:db/id "q-174414/selection/afe4b97c823938f24ee0f462e6dae1ce1a6e74074abfb6f3f9af3b253499f0cc" :answer/id #uuid "d8975ef5-5804-5339-bbcb-95b2f0cf2092" :answer/type :answer.type/text :answer/value "$Q$ only" :db/ensure [:answer/validate]} {:db/id "q-174414/selection/2e147b9bf74fe5a9fe1cc06d49c56b8c05578bddb93b65358c386cfaa2e4aa36" :answer/id #uuid "68258f71-ddcb-508b-b589-9176ff2a6918" :answer/type :answer.type/text :answer/value "$P$ and $R$ only" :db/ensure [:answer/validate]} {:db/id "q-174414/selection" :answer-field/id #uuid "77b2dc5a-2af6-540c-8260-11d25ec6f312" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-174414/selection/2e147b9bf74fe5a9fe1cc06d49c56b8c05578bddb93b65358c386cfaa2e4aa36" :answer-field/choices ["q-174414/selection/8202