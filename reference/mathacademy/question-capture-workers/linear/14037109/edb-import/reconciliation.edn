/14037109/state.json" "file_sha256" "a65dbce5e7e0b23fef8a43f98ad6c022978b5a6b30d0a2caaa09b5da88719f6c"} {"question" "q-174329" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037109/activity-metadata.json" "file_sha256" "cff4cd2d766f3e285a9368f04975338b56b95ae8f582e2a307cb688aab19364d"} {"question" "q-174329" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037109/state.json" "file_sha256" "a65dbce5e7e0b23fef8a43f98ad6c022978b5a6b30d0a2caaa09b5da88719f6c"} {"question" "q-174329" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "$P$ and $Q$ only"] ["text" "$P,Q,$ and $R$"] ["text" "$Q$ and $R$ only"] ["text" "$Q$ only"] ["text" "$R$ only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037109/state.json" "file_sha256" "a65dbce5e7e0b23fef8a43f98ad6c022978b5a6b30d0a2caaa09b5da88719f6c"} {"question" "q-174329" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "$R$ only"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037109/state.json" "file_sha256" "a65dbce5e7e0b23fef8a43f98ad6c022978b5a6b30d0a2caaa09b5da88719f6c"} {"question" "q-86477" "field" nil "attribute" "question/problem" "value" "What is the truth value of the following mathematical statement?\n\n$\\,$ The cube root of $-8$ is a positive number." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037109/state.json" "file_sha256" "a65dbce5e7e0b23fef8a43f98ad6c022978b5a6b30d0a2caaa09b5da88719f6c"} {"ques