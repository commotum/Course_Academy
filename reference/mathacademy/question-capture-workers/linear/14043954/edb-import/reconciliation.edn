 \\\\ 12\\end{aligned}] & =[\\begin{aligned}3 \\\\ -6 \\\\ k\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}{x}_{1}-4{x}_{2}=3 \\\\ 3{x}_{2}=-6 \\\\ -3{x}_{1}+12{x}_{2}=k\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}1 & -4 & 3 \\\\ 0 & 3 & -6 \\\\ -3 & 12 & k\\end{aligned}] & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -4 & 3 \\\\ 0 & 3 & -6 \\\\ 0 & 0 & k+9\\end{aligned}] & {R}_{2} & :=\\frac{1}{3}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -4 & 3 \\\\ 0 & 1 & -2 \\\\ 0 & 0 & k+9\\end{aligned}]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k+9.$ Therefore, the system has a solution only if\n\n$$\n0=k+9\\,⇒\\,k=-9.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-105237" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/activity-metadata.json" "file_sha256" "3c35d84f998953d540a017972af24b5f6997aadabed4c51265d82f0b6cbcbbfc"} {"question" "q-105237" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-105237" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-3"] ["math" "-9"] ["math" "3"] ["math" "6"] ["math" "9"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-105237" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-9"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-105232" "field" nil "attribute" "question/problem" "value" "Find the values of $k$ such that the vector $b$ lies in $\\text{Span}{{a}_{1},{a}_{2}},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}2 \\\\ -3 \\\\ -2\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-4 \\\\ 7 \\\\ 4\\end{aligned}],\\,b=[\\begin{aligned}8 \\\\ -7 \\\\ k\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-105232" "field" nil "attribute" "question/worked-solution" "value" "We know that $b\\in \\text{Span}{{a}_{1},{a}_{2}}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}[\\begin{aligned}2 \\\\ -3 \\\\ -2\\end{aligned}]+{x}_{2}[\\begin{aligned}-4 \\\\ 7 \\\\ 4\\end{aligned}] & =[\\begin{aligned}8 \\\\ -7 \\\\ k\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}2{x}_{1}-4{x}_{2}=8 \\\\ -3{x}_{1}+7{x}_{2}=-7 \\\\ -2{x}_{1}+4{x}_{2}=k\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}2 & -4 & 8 \\\\ -3 & 7 & -7 \\\\ -2 & 4 & k\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 4 \\\\ -3 & 7 & -7 \\\\ -2 & 4 & k\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 4 \\\\ 0 & 1 & 5 \\\\ -2 & 4 & k\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 4 \\\\ 0 & 1 & 5 \\\\ 0 & 0 & k+8\\end{aligned}]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k+8.$ Therefore, the system has a solution only if\n\n$$\n0=k+8\\,⇒\\,k=-8.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-105232" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/activity-metadata.json" "file_sha256" "3c35d84f998953d540a017972af24b5f6997aadabed4c51265d82f0b6cbcbbfc"} {"question" "q-105232" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-105232" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-6"] ["math" "-8"] ["math" "12"] ["math" "2"] ["math" "4"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-105232" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-8"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-74556" "field" nil "attribute" "question/problem" "value" "Find the values of $k$ such that the vector $b$ lies in $\\text{Span}{{a}_{1},{a}_{2}},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 2 \\\\ 3\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-1 \\\\ -1 \\\\ 6\\end{aligned}],\\,b=[\\begin{aligned}2 \\\\ 5 \\\\ k\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-74556" "field" nil "attribute" "question/worked-solution" "value" "We know that $b\\in \\text{Span}{{a}_{1},{a}_{2}}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}[\\begin{aligned}1 \\\\ 2 \\\\ 3\\end{aligned}]+{x}_{2}[\\begin{aligned}-1 \\\\ -1 \\\\ 6\\end{aligned}] & =[\\begin{aligned}2 \\\\ 5 \\\\ k\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}{x}_{1}-{x}_{2}=2 \\\\ 2{x}_{1}-{x}_{2}=5 \\\\ 3{x}_{1}+6{x}_{2}=k\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}1 & -1 & 2 \\\\ 2 & -1 & 5 \\\\ 3 & 6 & k\\end{aligned}] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 \\\\ 0 & 1 & 1 \\\\ 3 & 6 & k\\end{aligned}] & {R}_{3} & :={R}_{3}-3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 \\\\ 0 & 1 & 1 \\\\ 0 & 9 & k-6\\end{aligned}] & {R}_{3} & :={R}_{3}-9{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 \\\\ 0 & 1 & 1 \\\\ 0 & 0 & k-15\\end{aligned}]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k-15.$ Therefore, the system has a solution only if\n\n$$\n0=k-15\\,⇒\\,k=15.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-74556" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/activity-metadata.json" "file_sha256" "3c35d84f998953d540a017972af24b5f6997aadabed4c51265d82f0b6cbcbbfc"} {"question" "q-74556" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-74556" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-4"] ["math" "-6"] ["math" "15"] ["math" "5"] ["math" "8"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-74556" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "15"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-34211" "field" nil "attribute" "question/problem" "value" "Determine if the vector $u$ lies on the plane $Π:r=sb+tc$, $t,s\\in R$, where  $b=⟨-1,3,5⟩$, $c=⟨1,-5,-7⟩$, and  $u=⟨1,-8,-10⟩.$ In the affirmative case, find the value of $s\\cdot t$ from the decomposition $u=sb+tc.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-34211" "field" nil "attribute" "question/worked-solution" "value" "By definition, $u\\in Π$ if there exist $t$ and $s$ such that\n\n$$\n\\begin{aligned}sb+tc & =u \\\\ s[\\begin{aligned}-1 \\\\ 3 \\\\ 5\\end{aligned}]+t[\\begin{aligned}1 \\\\ -5 \\\\ -7\\end{aligned}] & =[\\begin{aligned}1 \\\\ -8 \\\\ -10\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}-s+t=1 \\\\ 3s-5t=-8 \\\\ 5s-7t=-10\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}-1 & 1 & 1 \\\\ 3 & -5 & -8 \\\\ 5 & -7 & -10\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}-1 & 1 & 1 \\\\ 0 & -2 & -5 \\\\ 5 & -7 & -10\\end{aligned}] & {R}_{3} & :={R}_{3}+5{R}_{1} \\\\  & ∼[\\begin{aligned}-1 & 1 & 1 \\\\ 0 & -2 & -5 \\\\ 0 & -2 & -5\\end{aligned}] & {R}_{3} & :={R}_{3}-{R}_{2} \\\\  & ∼[\\begin{aligned}-1 & 1 & 1 \\\\ 0 & -2 & -5 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n{\\begin{aligned}-s+t=1 \\\\ -2t=-5 \\\\ 0=0.\\end{aligned}\n$$\n\nFrom the second equation, we get\n\n$$\n-2t=-5\\,⟹\\,t=\\frac{5}{2}.\n$$\n\nSubstituting into the first equation, we get\n\n$$\n\\begin{aligned}-s+t & =1 \\\\ -s+\\frac{5}{2} & =1 \\\\ -s & =-\\frac{3}{2} \\\\ s & =\\frac{3}{2}.\\end{aligned}\n$$\n\nSince we found a solution $s=\\frac{3}{2},\\,t=\\frac{5}{2},$ we conclude that $u$ does indeed lie on the plane $Π.$ In fact, we have\n\n$$\nu=\\frac{3}{2}b+\\frac{5}{2}c.\n$$\n\nFinally, $s\\cdot t=\\frac{3}{2}\\cdot \\frac{5}{2}=\\frac{15}{4}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-34211" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/activity-metadata.json" "file_sha256" "3c35d84f998953d540a017972af24b5f6997aadabed4c51265d82f0b6cbcbbfc"} {"question" "q-34211" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-34211" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2"] ["math" "\\frac{15}{4}"] ["math" "\\frac{3}{5}"] ["math" "\\frac{9}{4}"] ["text" "$u$ does not lie on $Π$"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-34211" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{15}{4}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-74599" "field" nil "attribute" "question/problem" "value" "Determine if the vector $u$ lies on the plane $Π:r=sb+tc$, $t,s\\in R$, where  $b=⟨-1,4,3⟩$, $c=⟨1,-6,-7⟩$, and  $u=⟨1,-10,-15⟩.$ In the affirmative case, find the value of $s\\cdot t$ from the decomposition $u=sb+tc.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-74599" "field" nil "attribute" "question/worked-solution" "value" "By definition, $u\\in Π$ if there exist $t$ and $s$ such that\n\n$$\n\\begin{aligned}sb+tc & =u \\\\ s[\\begin{aligned}-1 \\\\ 4 \\\\ 3\\end{aligned}]+t[\\begin{aligned}1 \\\\ -6 \\\\ -7\\end{aligned}] & =[\\begin{aligned}1 \\\\ -10 \\\\ -15\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}-s+t=1 \\\\ 4s-6t=-10 \\\\ 3s-7t=-15\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}-1 & 1 & 1 \\\\ 4 & -6 & -10 \\\\ 3 & -7 & -15\\end{aligned}] & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼[\\begin{aligned}-1 & 1 & 1 \\\\ 0 & -2 & -6 \\\\ 3 & -7 & -15\\end{aligned}] & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼[\\begin{aligned}-1 & 1 & 1 \\\\ 0 & -2 & -6 \\\\ 0 & -4 & -12\\end{aligned}] & {R}_{3} & :={R}_{3}-2{R}_{2} \\\\  & ∼[\\begin{aligned}-1 & 1 & 1 \\\\ 0 & -2 & -6 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n{\\begin{aligned}-s+t=1 \\\\ -2t=-6 \\\\ 0=0.\\end{aligned}\n$$\n\nFrom the second equation, we get\n\n$$\n-2t=-6\\,⟹\\,t=3.\n$$\n\nSubstituting into the first equation, we get\n\n$$\n\\begin{aligned}-s+t & =1 \\\\ -s+3 & =1 \\\\ -s & =-2 \\\\ s & =2.\\end{aligned}\n$$\n\nSince we found a solution $s=2,\\,t=3,$ we conclude that $u$ does indeed lie on the plane $Π.$ In fact, we have\n\n$$\nu=2b+3c.\n$$\n\nFinally, $s\\cdot t=2\\cdot 3=6.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-74599" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/activity-metadata.json" "file_sha256" "3c35d84f998953d540a017972af24b5f6997aadabed4c51265d82f0b6cbcbbfc"} {"question" "q-74599" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-74599" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "1"] ["math" "5"] ["math" "6"] ["text" "$u$ does not lie on $Π$"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-74599" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "6"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-105265" "field" nil "attribute" "question/problem" "value" "Determine if the vector $u$ lies on the plane $Π:r=sb+tc,$ $t,s\\in R$, where  $b=⟨-1,-1,4⟩$, $c=⟨-3,-8,14⟩$, and  $u=⟨5,-10,-14⟩.$ In the affirmative case, find the value of $s\\cdot t$ from the decomposition $u=sb+tc.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-105265" "field" nil "attribute" "question/worked-solution" "value" "By definition, $u\\in Π$ if there exist $t$ and $s$ such that\n\n$$\n\\begin{aligned}sb+tc & =u \\\\ s[\\begin{aligned}-1 \\\\ -1 \\\\ 4\\end{aligned}]+t[\\begin{aligned}-3 \\\\ -8 \\\\ 14\\end{aligned}] & =[\\begin{aligned}5 \\\\ -10 \\\\ -14\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}-s-3t=5 \\\\ -s-8t=-10 \\\\ 4s+14t=-14\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}-1 & -3 & 5 \\\\ -1 & -8 & -10 \\\\ 4 & 14 & -14\\end{aligned}] & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼[\\begin{aligned}-1 & -3 & 5 \\\\ 0 & -5 & -15 \\\\ 4 & 14 & -14\\end{aligned}] & {R}_{3} & :={R}_{3}+4{R}_{1} \\\\  & ∼[\\begin{aligned}-1 & -3 & 5 \\\\ 0 & -5 & -15 \\\\ 0 & 2 & 6\\end{aligned}] & {R}_{2} & :=-\\frac{1}{5}{R}_{2} \\\\  & ∼[\\begin{aligned}-1 & -3 & 5 \\\\ 0 & 1 & 3 \\\\ 0 & 2 & 6\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}-1 & -3 & 5 \\\\ 0 & 1 & 3 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n{\\begin{aligned}-s-3t=5 \\\\ t=3 \\\\ 0=0.\\end{aligned}\n$$\n\nFrom the second equation, we get\n\n$$\nt=3.\n$$\n\nSubstituting into the first equation, we get\n\n$$\n\\begin{aligned}-s-3t & =5 \\\\ -s-3(3) & =5 \\\\ -s-9 & =5 \\\\ s & =-14.\\end{aligned}\n$$\n\nSince we found a solution $s=-14,\\,t=3,$ we conclude that $u$ does indeed lie on the plane $Π.$ In fact, we have\n\n$$\nu=-14b+3c.\n$$\n\nFinally, $s\\cdot t=(-14)\\cdot 3=-42.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-105265" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/activity-metadata.json" "file_sha256" "3c35d84f998953d540a017972af24b5f6997aadabed4c51265d82f0b6cbcbbfc"} {"question" "q-105265" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-105265" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-39"] ["math" "-42"] ["math" "-56"] ["math" "36"] ["math" "60"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-105265" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-42"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-105257" "field" nil "attribute" "question/problem" "value" "Determine if the vector $u$ lies on the plane $Π:r=sb+tc,$ $t,s\\in R$, where  $b=⟨1,-2,-1⟩$, $c=⟨-4,5,-1⟩$, and  $u=⟨1,1,4⟩.$ In the affirmative case, find the value of $s\\cdot t$ from the decomposition $u=sb+tc.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-105257" "field" nil "attribute" "question/worked-solution" "value" "By definition, $u\\in Π$ if there exist $t$ and $s$ such that\n\n$$\n\\begin{aligned}sb+tc & =u \\\\ s[\\begin{aligned}1 \\\\ -2 \\\\ -1\\end{aligned}]+t[\\begin{aligned}-4 \\\\ 5 \\\\ -1\\end{aligned}] & =[\\begin{aligned}1 \\\\ 1 \\\\ 4\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}s-4t=1 \\\\ -2s+5t=1 \\\\ -s-t=4\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}1 & -4 & 1 \\\\ -2 & 5 & 1 \\\\ -1 & -1 & 4\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -4 & 1 \\\\ 0 & -3 & 3 \\\\ -1 & -1 & 4\\end{aligned}] & {R}_{3} & :={R}_{3}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -4 & 1 \\\\ 0 & -3 & 3 \\\\ 0 & -5 & 5\\end{aligned}] & {R}_{2} & :=-\\frac{1}{3}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -4 & 1 \\\\ 0 & 1 & -1 \\\\ 0 & -5 & 5\\end{aligned}] & {R}_{3} & :={R}_{3}+5{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -4 & 1 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n{\\begin{aligned}s-4t=1 \\\\ t=-1 \\\\ 0=0.\\end{aligned}\n$$\n\nFrom the second equation, we get\n\n$$\nt=-1.\n$$\n\nSubstituting into the first equation, we get\n\n$$\n\\begin{aligned}s-4t & =1 \\\\ s-4(-1) & =1 \\\\ s+4 & =1 \\\\ s & =-3.\\end{aligned}\n$$\n\nSince we found a solution $s=-3,\\,t=-1,$ we conclude that $u$ does indeed lie on the plane $Π.$ In fact, we have\n\n$$\nu=-3b-c.\n$$\n\nFinally, $s\\cdot t=(-3)\\cdot (-1)=3.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-105257" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/activity-metadata.json" "file_sha256" "3c35d84f998953d540a017972af24b5f6997aadabed4c51265d82f0b6cbcbbfc"} {"question" "q-105257" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-105257" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-3"] ["math" "1"] ["math" "2"] ["math" "3"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-105257" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "3"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-74605" "field" nil "attribute" "question/problem" "value" "Determine if the vector $u$ lies on the plane $Π:r=sb+tc,$ $t,s\\in R$, where  $b=⟨1,3,6⟩$, $c=⟨1,-2,4⟩$, and  $u=⟨3,19,-10⟩.$ In the affirmative case, find the value of $s\\cdot t$ from the decomposition $u=sb+tc.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-74605" "field" nil "attribute" "question/worked-solution" "value" "By definition, $u\\in Π$ if there exist $t$ and $s$ such that\n\n$$\n\\begin{aligned}sb+tc & =u \\\\ s[\\begin{aligned}1 \\\\ 3 \\\\ 6\\end{aligned}]+t[\\begin{aligned}1 \\\\ -2 \\\\ 4\\end{aligned}] & =[\\begin{aligned}3 \\\\ 19 \\\\ -10\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}s+t=3 \\\\ 3s-2t=19 \\\\ 6s+4t=-10\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}1 & 1 & 3 \\\\ 3 & -2 & 19 \\\\ 6 & 4 & -10\\end{aligned}] & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 3 \\\\ 0 & -5 & 10 \\\\ 6 & 4 & -10\\end{aligned}] & {R}_{3} & :={R}_{3}-6{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 3 \\\\ 0 & -5 & 10 \\\\ 0 & -2 & -28\\end{aligned}] & {R}_{2} & :=-\\frac{1}{5}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 1 & 3 \\\\ 0 & 1 & -2 \\\\ 0 & -2 & -28\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 1 & 3 \\\\ 0 & 1 & -2 \\\\ 0 & 0 & -32\\end{aligned}]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=-32,$ which has no solution.\n\nSo, there are no values of $s$ and $t$ such that \n\n$$\n\\begin{aligned}sb+tc=u.\\end{aligned}\n$$\n\nTherefore, we conclude that $u$ does *not* lie on the plane $Π.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-74605" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/activity-metadata.json" "file_sha256" "3c35d84f998953d540a017972af24b5f6997aadabed4c51265d82f0b6cbcbbfc"} {"question" "q-74605" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-74605" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-4"] ["math" "-6"] ["math" "2"] ["math" "24"] ["text" "$u$ does not lie on $Π$"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "q-74605" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "$u$ does not lie on $Π$"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/state.json" "file_sha256" "9bdf41e8e9144ddd04c2ad1e96dc2c028c03e5ad379c4bab21fd3236cf24292f"} {"question" "e-4795" "field" nil "attribute" "question/problem" "value" "Determine if $\\mathbf{b}$ lies in $\\textrm{Span}\\{ \\mathbf{a_1}, \\mathbf{a_2} \\},$ where\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/assets/df4f126da2ab3a0661bcb7dc18bb1e5eae8cd48d5c5a1464ea580ccc439195d6.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/example-4795.json" "file_sha256" "3e19b0f0c7dc67e6b567ea672789a621d45843a2244810c763d7c81cb79caef7"} {"question" "e-4795" "field" nil "attribute" "question/worked-solution" "value" "We know that $\\mathbf{b} \\in \\textrm{Span}\\{ \\mathbf{a_1}, \\mathbf{a_2} \\}$ if there exist $x_1$ and $x_2$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}[\\begin{aligned}1 \\\\ 1 \\\\ 2\\end{aligned}]+{x}_{2}[\\begin{aligned}5 \\\\ 3 \\\\ 2\\end{aligned}] & =[\\begin{aligned}8 \\\\ 2 \\\\ -5\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}{x}_{1}+5{x}_{2}=8 \\\\ {x}_{1}+3{x}_{2}=2 \\\\ 2{x}_{1}+2{x}_{2}=-5\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}1 & 5 & 8 \\\\ 1 & 3 & 2 \\\\ 2 & 2 & -5\\end{aligned}] & {R}_{2} & :={R}_{2}-{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 5 & 8 \\\\ 0 & -2 & -6 \\\\ 2 & 2 & -5\\end{aligned}] & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 5 & 8 \\\\ 0 & -2 & -6 \\\\ 0 & -8 & -21\\end{aligned}] & {R}_{2} & :=-\\frac{1}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 5 & 8 \\\\ 0 & 1 & 3 \\\\ 0 & -8 & -21\\end{aligned}] & {R}_{3} & :={R}_{3}+8{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 5 & 8 \\\\ 0 & 1 & 3 \\\\ 0 & 0 & 3\\end{aligned}] & {R}_{2} & ↔{R}_{3}\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0x_1 + 0x_2 = 3,$ which has no solution.\n\nSo, there are no values of $x_1$ and $x_2$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}[\\begin{aligned}1 \\\\ 2 \\\\ 1\\end{aligned}]+{x}_{2}[\\begin{aligned}5 \\\\ 2 \\\\ 3\\end{aligned}] & =[\\begin{aligned}8 \\\\ -5 \\\\ 2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we conclude that $\\mathbf{b}$ does *not* lie in $\\textrm{Span}\\{ \\mathbf{a_1}, \\mathbf{a_2} \\}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/example-4795.json" "file_sha256" "3e19b0f0c7dc67e6b567ea672789a621d45843a2244810c763d7c81cb79caef7"} {"question" "e-6218" "field" nil "attribute" "question/problem" "value" "Find the values of $k$ such that the vector $\\mathbf{b}$ lies in $\\textrm{Span}\\{ \\mathbf{a}_1, \\mathbf{a}_2 \\},$ where\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/assets/966d2d7cd1cd0ef04a1d9b2adc04511dea86cbbf254166988a7072e952879fe0.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/example-6218.json" "file_sha256" "7f551d979a6417be2f07b40766826c373801e6d87004c1d9f5c5a727577d813c"} {"question" "e-6218" "field" nil "attribute" "question/worked-solution" "value" "We know that $\\mathbf{b} \\in \\textrm{Span}\\{ \\mathbf{a_1}, \\mathbf{a_2} \\}$ if there exist $x_1$ and $x_2$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}[\\begin{aligned}1 \\\\ 5 \\\\ 7\\end{aligned}]+{x}_{2}[\\begin{aligned}-2 \\\\ 4 \\\\ 2\\end{aligned}] & =[\\begin{aligned}13 \\\\ -5 \\\\ k\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}{x}_{1}-2{x}_{2}=13 \\\\ 5{x}_{1}+4{x}_{2}=-5 \\\\ 7{x}_{1}+2{x}_{2}=k\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}1 & -2 & 13 \\\\ 5 & 4 & -5 \\\\ 7 & 2 & k\\end{aligned}] & {R}_{2} & :={R}_{2}-5{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 13 \\\\ 0 & 14 & -70 \\\\ 7 & 2 & k\\end{aligned}] & {R}_{3} & :={R}_{3}-7{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 13 \\\\ 0 & 14 & -70 \\\\ 0 & 16 & k-91\\end{aligned}] & {R}_{2} & :=\\frac{1}{14}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -2 & 13 \\\\ 0 & 1 & -5 \\\\ 0 & 16 & k-91\\end{aligned}] & {R}_{3} & :={R}_{3}-16{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -2 & 13 \\\\ 0 & 1 & -5 \\\\ 0 & 0 & k-11\\end{aligned}]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0x_1 + 0x_2 = k-11$. Therefore, the system has a solution only if\n\n$$\n0 = k-11 \\quad \\Rightarrow \\quad k=11.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/example-6218.json" "file_sha256" "7f551d979a6417be2f07b40766826c373801e6d87004c1d9f5c5a727577d813c"} {"question" "e-4799" "field" nil "attribute" "question/problem" "value" "Determine if the vector $\\mathbf{u}$ lies on the plane $\\;\\Pi \\,:\\, \\mathbf{r}=s \\mathbf{b} + t \\mathbf{c}, \\, t,s \\in \\mathbb{R},$ where  $\\mathbf{b}=\\langle 1, 4, 5 \\rangle, \\mathbf{c} = \\langle 2, 4, 6 \\rangle$ and  $\\mathbf{u}= \\langle 2, 10, 12 \\rangle.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/example-4799.json" "file_sha256" "e140477fcf0adf115d2f2c51e9814055491c3372f88f6c15241dc186e5220262"} {"question" "e-4799" "field" nil "attribute" "question/worked-solution" "value" "By definition, $\\mathbf{u} \\in \\Pi$ if there exist $t$ and $s$ such that\n\n$$\n\\begin{aligned}sb+tc & =u \\\\ s[\\begin{aligned}1 \\\\ 4 \\\\ 5\\end{aligned}]+t[\\begin{aligned}2 \\\\ 4 \\\\ 6\\end{aligned}] & =[\\begin{aligned}2 \\\\ 10 \\\\ 12\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}s+2t=2 \\\\ 4s+4t=10 \\\\ 5s+6t=12\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}1 & 2 & 2 \\\\ 4 & 4 & 10 \\\\ 5 & 6 & 12\\end{aligned}] & {R}_{2} & :={R}_{2}-4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & 2 \\\\ 0 & -4 & 2 \\\\ 5 & 6 & 12\\end{aligned}] & {R}_{3} & :={R}_{3}-5{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & 2 \\\\ 0 & -4 & 2 \\\\ 0 & -4 & 2\\end{aligned}] & {R}_{3} & :={R}_{3}-{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 2 & 2 \\\\ 0 & -4 & 2 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n{\\begin{aligned}s+2t=2 \\\\ -4t=2 \\\\ 0=0.\\end{aligned}\n$$\n\nFrom the second equation, we get\n\n$$\n-4t = 2 \\qquad \\Longrightarrow \\qquad t = -\\dfrac{1}{2}.\n$$\n\nSubstituting into the first equation, we get\n\n$$\n\\begin{aligned}s+2t & =2 \\\\ s+2(-\\frac{1}{2}) & =2 \\\\ s-1 & =2 \\\\ s & =3.\\end{aligned}\n$$\n\nSince we found a solution $s=3, \\, t=-\\dfrac{1}{2},$ we conclude that $\\mathbf{u}$ does indeed lie on the plane $\\Pi.$ In fact, we have\n\n$$\n\\mathbf{u}=3\\mathbf{b} - \\dfrac{1}{2}\\mathbf{c}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/example-4799.json" "file_sha256" "e140477fcf0adf115d2f2c51e9814055491c3372f88f6c15241dc186e5220262"} {"question" "q-34635" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "b\\notin \\text{Span}{{a}_{1},{a}_{2}}"] "category" "reviewed_ma_solution" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043954/answer-source-reviews.json" "file_sha256" "910d7102e5287661a1f3346aad910dbb032c87