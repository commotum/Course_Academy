#{[{:db/id #edb/ref 17592186125013 :knowledge-point/_questions [{:knowledge-point/id #uuid "152243fa-e0a5-551d-92d9-b470789087c7" :knowledge-point/title "Expressing the Inverse of a Matrix as a Linear Combination of Its Powers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "db022e60-b4a3-5fed-a684-66f4384b0da1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{9}" :db/id #edb/ref 17592186123101} {:answer/id #uuid "0fd446df-b6d7-5613-be91-a05c4299f3a9" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186123102} {:answer/id #uuid "4a97d7f1-0d82-5c27-a742-610ee8832586" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{7}" :db/id #edb/ref 17592186123103} {:answer/id #uuid "68aa5ebf-5e46-560a-9bcb-e8c435dcc742" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186123104} {:answer/id #uuid "70868969-3b44-542c-836c-06a1bc12bd70" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{9}" :db/id #edb/ref 17592186123105}] :answer-field/correct {:answer/id #uuid "70868969-3b44-542c-836c-06a1bc12bd70" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{9}" :db/id #edb/ref 17592186123105} :answer-field/id #uuid "2fc50ce1-88c5-57fe-b2fa-149c8b0f42fa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123100}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "4acccd18-c797-5d41-ab58-67f98662f9b8" :question/math-academy-id "q-37779" :question/problem "Given that $A=[\\begin{aligned}1 & -2 \\\\ 1 & 7\\end{aligned}]$ and ${A}^{-1}=pI+qA$, find the value of $p+q.$" :question/worked-solution "Let's find the characteristic equation $\\text{det}(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\text{det}(A-\\lambda I) & =0 \\\\ |\\begin{aligned}1-\\lambda  & -2 \\\\ 1 & 7-\\lambda \\end{aligned}| & =0 \\\\ (1-\\lambda )(7-\\lambda )+2 & =0 \\\\ {\\lambda }^{2}-8\\lambda +9 & =0\\end{aligned}\n$$\n\nUsing the Cayley-Hamilton theorem, we have that\n\n$$\n\\begin{aligned}{A}^{2}-8A+9I & =O.\\end{aligned}\n$$\n\nSince $A$ is invertible, we can multiply this equation by ${A}^{-1}:$\n\n$$\n\\begin{aligned}{A}^{-1}({A}^{2}-8A+9I) & =O \\\\ A-8I+9{A}^{-1} & =O \\\\ {A}^{-1} & =\\frac{8}{9}I-\\frac{1}{9}A\\end{aligned}\n$$\n\nTherefore, $p=\\frac{8}{9},$ $q=-\\frac{1}{9},$ and \n\n$$\np+q=\\frac{8}{9}+(-\\frac{1}{9})=\\frac{7}{9}.\n$$"}] [{:db/id #edb/ref 17592186125053 :knowledge-point/_questions [{:knowledge-point/id #uuid "b2867571-c1ae-5ea0-b784-22f444c8db38" :knowledge-point/title "Expressing a Power of a Matrix as a Linear Combination of Smaller Powers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d0aa05fe-e633-5268-94ca-d6ed28f32669" :answer/type {:db/ident :answer.type/math} :answer/value "-8A + 12I" :db/id #edb/ref 17592186123341} {:answer/id #uuid "09fc1310-2a18-5009-8450-b2a15d81ebcd" :answer/type {:db/ident :answer.type/math} :answer/value "-8A - 12I" :db/id #edb/ref 17592186123342} {:answer/id #uuid "3facd8a8-b951-5a58-95b9-7c15ace20c66" :answer/type {:db/ident :answer.type/math} :answer/value "12A + 8I" :db/id #edb/ref 17592186123343} {:answer/id #uuid "5f4df954-e8ed-5eb2-a365-b64f95cce780" :answer/type {:db/ident :answer.type/math} :answer/value "12A - 8I" :db/id #edb/ref 17592186123344} {:answer/id #uuid "790ddac2-5527-5d08-b035-615e08df5fd3" :answer/type {:db/ident :answer.type/math} :answer/value "8A - 12I" :db/id #edb/ref 17592186123345}] :answer-field/correct {:answer/id #uuid "d0aa05fe-e633-5268-94ca-d6ed28f32669" :answer/type {:db/ident :answer.type/math} :answer/value "-8A + 12I" :db/id #edb/ref 17592186123341} :answer-field/id #uuid "292649d5-428b-5a5d-896e-4b81525ec2ad" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123340}] :question/id #uuid "56a1bd4c-16fb-5242-9ca4-9449cd0cb6e6" :q