/ma-v1/e694cf07bf6f603d431aaddd99304eb29cc7ab8f382275b4a724bd2333b2389a/2c5ac22834f85eae883386e469cbc72e243c86d87802b86d508d92284ff766b3" "q-38702/selection/ma-v1/e694cf07bf6f603d431aaddd99304eb29cc7ab8f382275b4a724bd2333b2389a/20ef971e5d150cc62c8ee64e7ddec46f7e6279ff5c6f30c1987bbe52147dd35c"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-38702"] :question/problem "Let $A$ be a $2\\times 2$ matrix such that $\\text{tr}(A)=-8$ and $\\text{det}(A)=12.$ Then, ${A}^{2}=$" :question/worked-solution "The characteristic polynomial of $A$ is given by \n\n$$\np(\\lambda )={\\lambda }^{2}-\\text{tr}(A)\\lambda +\\text{det}(A).\n$$\n\nTherefore, using the Cayley-Hamilton theorem, we obtain\n\n$$\n\\begin{aligned}p(A) & =O \\\\ {A}^{2}-\\text{tr}(A)A+\\text{det}(A)I & =O \\\\ {A}^{2} & =\\text{tr}(A)A-\\text{det}(A)I \\\\ {A}^{2} & =-8A-12I.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-38702/selection/ma-v1/e694cf07bf6f603d431aaddd99304eb29cc7ab8f382275b4a724bd2333b2389a"] :db/ensure [:question/validate]} {:db/id "q-83395/selection/ad09bd126342834809bbfad792d0902e867fa5b6d40bf7b884c5039336b02106" :answer/id #uuid "6de6df6f-d679-51d2-bdc5-38a2b1edd62a" :answer/type :answer.type/math :answer/value "-5A+12I" :db/ensure [:answer/validate]} {:db/id "q-83395/selection/fa59e284e0cf9678b8906b308abb9d9ba7783ac569ded0139d42c46c9d5b0a2c" :answer/id #uuid "82cd723b-1bc2-5810-8d8c-f4db27f6e8ba" :answer/type :answer.type/math :answer/value "7{A}^{2}-5I" :db/ensure [:answer/validate]} {:db/id "q-83395/selection/cd76e90d72545406590deb7d7a1853d80da928184d666ba3c210761c7af29f03" :answer/id #uuid "c2297b32-05a8-5700-bf00-da8f58e92f05" :answer/type :answer.type/math :answer/value "12{A}^{2}-5I" :db/ensure [:answer/validate]} {:db/id "q-83395/selection/d3368c6de706e11dc1f4503a274d09f042f1c4a09e1c077dfacc10b404a9c904" :answer/id #uuid "912aaca2-7e3e-54fa-a3f1-d8aa79d30936" :answer/type :answer.type/math :answer/value "-5A-