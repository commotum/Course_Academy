#{[{:db/id #edb/ref 17592186377124 :knowledge-point/_questions [{:knowledge-point/id #uuid "152243fa-e0a5-551d-92d9-b470789087c7" :knowledge-point/title "Expressing the Inverse of a Matrix as a Linear Combination of Its Powers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be5d68ff-5a62-5dff-87bd-3f8d07976020" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186377126} {:answer/id #uuid "5b191a5e-4e66-5b6c-97fa-c9f6f41f7fe7" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186377127} {:answer/id #uuid "187c4fed-3a95-5a17-bbf9-edfe06c0c00a" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186377128} {:answer/id #uuid "11d765a8-49a7-586e-bf26-cb4258bf6426" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186377129} {:answer/id #uuid "7f2e5de8-8541-5289-9b1f-2a42c7bdfad0" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186377130}] :answer-field/correct {:answer/id #uuid "be5d68ff-5a62-5dff-87bd-3f8d07976020" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186377126} :answer-field/id #uuid "f10012ac-3daa-5e5c-a450-09ea1565025f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377125}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d3dc3dd7-99d0-56d1-a9a1-9893c6a8f904" :question/math-academy-id "q-37778" :question/problem "Given that $\\,A=[\\begin{aligned}2 & 3 \\\\ 1 & 2\\end{aligned}]\\,$ and $\\,{A}^{-1}=pI+qA$, find the value $p+q.$" :question/worked-solution "Let's find the characteristic equation $\\text{det}(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\text{det}(A-\\lambda I) & =0 \\\\ |\\begin{aligned}2-\\lambda  & 3 \\\\ 1 & 2-\\lambda \\end{aligned}| & =0 \\\\ (2-\\lambda )(2-\\lambda )-3 & =0 \\\\ {\\lambda }^{2}-4\\lambda +1 & =0\\end{aligned}\n$$\n\nUsing the Cayley-Hamilton theorem, we have that\n\n$$\n\\begin{aligned}{A}^{2}-4A+I & =O.\\end{aligned}\n$$\n\nSince $A$ is invertible, we can multiply this equation by ${A}^{-1}:$\n\n$$\n\\begin{aligned}{A}^{-1}({A}^{2}-4A+I) & =O \\\\ A-4I+{A}^{-1} & =O \\\\ {A}^{-1} & =4I-A\\end{aligned}\n$$\n\nTherefore, $p=4,$ $q=-1$ and\n\n$$\np+q=4+(-1)=3.\n$$"}] [{:db/id #edb/ref 17592186125013 :knowledge-point/_questions [{:knowledge-point/id #uuid "152243fa-e0a5-551d-92d9-b470789087c7" :knowledge-point/title "Expressing the Inverse of a Matrix as a Linear Combination of Its Powers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "db022e60-b4a3-5fed-a684-66f4384b0da1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{9}" :db/id #edb/ref 17592186123101} {:answer/id #uuid "0fd446df-b6d7-5613-be91-a05c4299f3a9" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186123102} {:answer/id #uuid "4a97d7f1-0d82-5c27-a742-610ee8832586" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{7}" :db/id #edb/ref 17592186123103} {:answer/id #uuid "68aa5ebf-5e46-560a-9bcb-e8c435dcc742" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186123104} {:answer/id #uuid "70868969-3b44-542c-836c-06a1bc12bd70" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{9}" :db/id #edb/ref 17592186123105}] :answer-field/correct {:answer/id #uuid "70868969-3b44-542c-836c-06a1bc12bd70" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{9}" :db/id #edb/ref 17592186123105} :answer-field/id #uuid "2fc50ce1-88c5-57fe-b2fa-149c8b0f42fa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123100}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "4acccd18-c797-5d41-ab58-67f98662f9b8" :question/math-academy-id "q-37779" :question/problem "Given that $A=[\\begin{aligned}1 & -2 \\\\ 1 & 7\\end{aligned}]$ and ${A}^{-1}=pI+qA$, find the value of $p+q.$" :question/worked-solution "Let's find the characteristic equation $\\text{det}(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\text{det}(A-\\lambda I) & =0 \\\\ |\\begin{aligned}1-\\lambda  & -2 \\\\ 1 & 7-\\lambda \\end{aligned}| & =0 \\\\ (1-\\lambda )(7-\\lambda )+2 & =0 \\\\ {\\lambda }^{2}-8\\lambda +9 & =0\\end{aligned}\n$$\n\nUsing the Cayley-Hamilton theorem, we have that\n\n$$\n\\begin{aligned}{A}^{2}-8A+9I & =O.\\end{aligned}\n$$\n\nSince $A$ is invertible, we can multiply this equation by ${A}^{-1}:$\n\n$$\n\\begin{aligned}{A}^{-1}({A}^{2}-8A+9I) & =O \\\\ A-8I+9{A}^{-1} & =O \\\\ {A}^{-1} & =\\frac{8}{9}I-\\frac{1}{9}A\\end{aligned}\n$$\n\nTherefore, $p=\\frac{8}{9},$ $q=-\\frac{1}{9},$ and \n\n$$\np+q=\\frac{8}{9}+(-\\frac{1}{9})=\\frac{7}{9}.\n$$"}] [{:db/id #edb/ref 17592186377131 :knowledge-point/_questions [{:knowledge-point/id #uuid "787173e1-f957-5ff0-9d14-a6ccb11de1d8" :knowledge-point/title "Evaluating a Matrix Polynomial Using the Cayley-Hamilton Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "162bd55a-e089-5985-93cd-731277d307ee" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}11 & 8 \\\\ -24 & -16\\end{aligned}]" :db/id #edb/ref 17592186377133} {:answer/id #uuid "9b899ec5-e738-51b1-b357-d164f8adac01" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}11 & -24 \\\\ 8 & -16\\end{aligned}]" :db/id #edb/ref 17592186377134} {:answer/id #uuid "bcdbba2a-4104-51db-8f18-902512052921" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}25 & 16 \\\\ -48 & -31\\end{aligned}]" :db/id #edb/ref 17592186377135} {:answer/id #uuid "fbcab531-5c2e-5929-a23e-29a91fa14572" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}16 & -25 \\\\ 18 & -42\\end{aligned}]" :db/id #edb/ref 17592186377136} {:answer/id #uuid "60e1ab85-315f-5f4b-bf3d-d65e6efe54fa" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}40 & 24 \\\\ -70 & -44\\end{aligned}]" :db/id #edb/ref 17592186377137}] :answer-field/correct {:answer/id #uuid "bcdbba2a-4104-51db-8f18-902512052921" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}25 & 16 \\\\ -48 & -31\\end{aligned}]" :db/id #edb/ref 17592186377135} :answer-field/id #uuid "d5246b3e-19b7-5392-bdbb-9be88550808f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377132}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "df379c8f-bbed-5154-8e34-f7aedf45ba74" :question/math-academy-id "q-37844" :question/problem "Given the matrix\n$\\,A=[\\begin{aligned}14 & 8 \\\\ -24 & -14\\end{aligned}]$\nand $f(x)={x}^{12}-4{x}^{10}+{x}^{3}-2x-3$, find $f(A).$" :question/worked-solution "Let's start by finding the characteristic polynomial $p(\\lambda )$:\n\n$$\n\\begin{aligned}p(\\lambda ) & =det(A-\\lambda I) \\\\  & =|\\begin{aligned}14-\\lambda  & 8 \\\\ -24 & -14-\\lambda \\end{aligned}| \\\\  & =(14-\\lambda )(-14-\\lambda )+192 \\\\  & ={\\lambda }^{2}-4\\end{aligned}\n$$\n\nNow, let's divide $f(x)$ by $p(x)$ using long division:\n\n|  | $\\,\\,{x}^{10}$ | $+$ | $x$ |  |  |  |  |  |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| ${x}^{2}-4\\,$ | $\\,\\enclose{longdiv}{{x}^{12}-4{x}^{10}+{x}^{3}-2x-3}$ |  |  |  |  |  |  |  |\n|  | ${x}^{12}$ | $\\,\\,\\,\\,-$ | $\\,\\,\\,\\,4{x}^{10}$ |  |  |  |  |  |\n|  |  |  |  | ${x}^{3}\\,\\,\\,\\,\\,\\,$ | $-\\,\\,$ | $\\,\\,2x$ | $\\,\\,\\,\\,\\,-$ | $\\,\\,\\,\\,\\,\\,\\,\\,3$ |\n|  |  |  |  | ${x}^{3}\\,\\,\\,\\,\\,\\,$ | $-\\,\\,$ | $\\,\\,4x$ |  |  |\n|  |  |  |  |  |  | $\\,\\,2x$ | $\\,\\,\\,\\,\\,-$ | $\\,\\,\\,\\,\\,\\,\\,\\,3$ |\n\nTherefore, we can write $f(x)$ as \n\n$$\n\\begin{aligned}f(x) & =q(x)p(x)+r(x) \\\\  & =q(x)p(x)+(2x-3)\\end{aligned}\n$$\n\nwhere $q(x)={x}^{10}+x.$ Replacing $x$ with $A,$ we have\n\n$$\nf(A)=q(A)p(A)+(2A-3I).\n$$\n\nAccording to the Cayley-Hamilton theorem, we have $p(A)=O.$ Therefore,\n\n$$\n\\begin{aligned}f(A) & =q(A)p(A)+(2A-3I) \\\\  & =q(A)\\cdot O+(2A-3I) \\\\  & =2A-3I \\\\  & =2[\\begin{aligned}14 & 8 \\\\ -24 & -14\\end{aligned}]-3[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}28 & 16 \\\\ -48 & -28\\end{aligned}]-[\\begin{aligned}3 & 0 \\\\ 0 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}25 & 16 \\\\ -48 & -31\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186125053 :knowledge-point/_questions [{:knowledge-point/id #uuid "b2867571-c1ae-5ea0-b784-22f444c8db38" :knowledge-point/title "Expressing a Power of a Matrix as a Linear Combination of Smaller Powers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a23bac3c-54f6-5261-88dc-6152ff1cd2be" :answer/type {:db/ident :answer.type/math} :answer/value "-8A+12I" :db/id #edb/ref 17592186377139} {:answer/id #uuid "b7b98222-46e2-51bc-b1df-80876b789613" :answer/type {:db/ident :answer.type/math} :answer/value "12A+8I" :db/id #edb/ref 17592186377140} {:answer/id #uuid "c88e541c-f02c-57bd-bb33-c4b83240a4a7" :answer/type {:db/ident :answer.type/math} :answer/value "12A-8I" :db/id #edb/ref 17592186377141} {:answer/id #uuid "695db959-36b3-562f-bc46-a97b55740392" :answer/type {:db/ident :answer.type/math} :answer/value "8A-12I" :db/id #edb/ref 17592186377142} {:answer/id #uuid "396bac27-bba0-5815-babc-5c84ebfeb033" :answer/type {:db/ident :answer.type/math} :answer/value "-8A-12I" :db/id #edb/ref 17592186377143}] :answer-field/correct {:answer/id #uuid "396bac27-bba0-5815-babc-5c84ebfeb033" :answer/type {:db/ident :answer.type/math} :answer/value "-8A-12I" :db/id #edb/ref 17592186377143} :answer-field/id #uuid "5fd91108-76b6-5b24-b85b-277f72400961" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377138}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "56a1bd4c-16fb-5242-9ca4-9449cd0cb6e6" :question/math-academy-id "q-38702" :question/problem "Let $A$ be a $2\\times 2$ matrix such that $\\text{tr}(A)=-8$ and $\\text{det}(A)=12.$ Then, ${A}^{2}=$" :question/worked-solution "The characteristic polynomial of $A$ is given by \n\n$$\np(\\lambda )={\\lambda }^{2}-\\text{tr}(A)\\lambda +\\text{det}(A).\n$$\n\nTherefore, using the Cayley-Hamilton theorem, we obtain\n\n$$\n\\begin{aligned}p(A) & =O \\\\ {A}^{2}-\\text{tr}(A)A+\\text{det}(A)I & =O \\\\ {A}^{2} & =\\text{tr}(A)A-\\text{det}(A)I \\\\ {A}^{2} & =-8A-12I.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186377144 :knowledge-point/_questions [{:knowledge-point/id #uuid "b2867571-c1ae-5ea0-b784-22f444c8db38" :knowledge-point/title "Expressing a Power of a Matrix as a Linear Combination of Smaller Powers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4c7c599-380c-5164-836f-e13d42d7c422" :answer/type {:db/ident :answer.type/math} :answer/value "5A-12I" :db/id #edb/ref 17592186377146} {:answer/id #uuid "6de6df6f-d679-51d2-bdc5-38a2b1edd62a" :answer/type {:db/ident :answer.type/math} :answer/value "-5A+12I" :db/id #edb/ref 17592186377147} {:answer/id #uuid "c2297b32-05a8-5700-bf00-da8f58e92f05" :answer/type {:db/ident :answer.type/math} :answer/value "12{A}^{2}-5I" :db/id #edb/ref 17592186377148} {:answer/id #uuid "912aaca2-7e3e-54fa-a3f1-d8aa79d30936" :answer/type {:db/ident :answer.type/math} :answer/value "-5A-12I" :db/id #edb/ref 17592186377149} {:answer/id #uuid "82cd723b-1bc2-5810-8d8c-f4db27f6e8ba" :answer/type {:db/ident :answer.type/math} :answer/value "7{A}^{2}-5I" :db/id #edb/ref 17592186377150}] :answer-field/correct {:answer/id #uuid "d4c7c599-380c-5164-836f-e13d42d7c422" :answer/type {:db/ident :answer.type/math} :answer/value "5A-12I" :db/id #edb/ref 17592186377146} :answer-field/id #uuid "829a1f89-055c-5358-9ff5-2f3b8e74b570" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377145}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "17dac710-4b47-5044-a824-341d21693c1e" :question/math-academy-id "q-83395" :question/problem "Let $A$ be a $3\\times 3$ matrix with the characteristic polynomial $p(\\lambda )=-{\\lambda }^{3}+5\\lambda -12.$ Then, ${A}^{3}=$" :question/worked-solution "Using the Cayley-Hamilton theorem, we obtain\n\n$$\n\\begin{aligned}p(A) & =O \\\\ -{A}^{3}+5A-12I & =O \\\\ {A}^{3} & =5A-12I.\\end{aligned}\n$$"}]}
