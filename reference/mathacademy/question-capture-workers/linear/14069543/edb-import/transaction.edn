ac{1}{2}I-\\frac{1}{2}A-\\frac{3}{2}{A}^{2}" :db/ensure [:answer/validate]} {:db/id "q-40168/selection/4a8fe6322b02f2f9246d2fb0bd9c5915edd7df2e426f55ceea07832377b1c3b5" :answer/id #uuid "222aa5b5-eb2f-5362-bffe-6ddf95ce05f7" :answer/type :answer.type/math :answer/value "\\frac{7}{2}I-\\frac{1}{2}A-\\frac{1}{2}{A}^{2}" :db/ensure [:answer/validate]} {:db/id "q-40168/selection/ee2a142e25c19599e081c33c414fcfbba32a06e459ca5d2154c9b846293df3e5" :answer/id #uuid "241ae2fa-cdf3-5aad-81c7-7048c5a0658a" :answer/type :answer.type/math :answer/value "9I-A-{A}^{2}" :db/ensure [:answer/validate]} {:db/id "q-40168/selection/571f039863039be786055d0f41f6a12f697c5f67426546c48c1a049c99a4df61" :answer/id #uuid "7bd1e470-e2e8-51f8-bac3-5bae9ed53e92" :answer/type :answer.type/math :answer/value "2I-A-2{A}^{2}" :db/ensure [:answer/validate]} {:db/id "q-40168/selection" :answer-field/id #uuid "09ff4040-4ecd-5896-9de2-3cf9ce932e58" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-40168/selection/4a8fe6322b02f2f9246d2fb0bd9c5915edd7df2e426f55ceea07832377b1c3b5" :answer-field/choices ["q-40168/selection/b454949261cc6e79dff35ec81031d584bd71828d35749a01329c671558a7c894" "q-40168/selection/41f70b2b9f38abee08e8a1b6943dae4a7c7ed5a232598516e9e6012a7b2bcdde" "q-40168/selection/4a8fe6322b02f2f9246d2fb0bd9c5915edd7df2e426f55ceea07832377b1c3b5" "q-40168/selection/ee2a142e25c19599e081c33c414fcfbba32a06e459ca5d2154c9b846293df3e5" "q-40168/selection/571f039863039be786055d0f41f6a12f697c5f67426546c48c1a049c99a4df61"] :db/ensure [:answer-field/validate]} {:db/id "q-40168" :question/id #uuid "3ef480b2-61d6-5846-831c-c9cbf5e226fb" :question/math-academy-id "q-40168" :question/problem "If $A=[\\begin{aligned}2 & 1 & 1 \\\\ 0 & -4 & -3 \\\\ 0 & 1 & 1\\end{aligned}],$ then ${A}^{-1}=$" :question/worked-solution "Let's find the characteristic equation $\\text{det}(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\text{det}(A-\\lambda I) & =0 \\\\ |\\begin{aligned}2-\\lambda  & 1 & 1 \\\\ 0 & -4-\\lambda  & -3 \\\\ 0 & 1 & 1-\\lambda \\end{aligned}| & =0 \\\\ (2-\\lambda )|\\begin{aligned}-4-\\lambda  & -3 \\\\ 1 & 1-\\lambda \\end{aligned}| & =0 \\\\ (2-\\lambda )((-4-\\lambda )(1-\\lambda )+3) & =0 \\\\ (2-\\lambda )({\\lambda }^{2}+3\\lambda -1) & =0 \\\\ {\\lambda }^{3}+{\\lambda }^{2}-7\\lambda +2 & =0\\end{aligned}\n$$\n\nUsing the Cayley-Hamilton theorem, we have that\n\n$$\n\\begin{aligned}{A}^{3}+{A}^{2}-7A+2I & =O.\\end{aligned}\n$$\n\nSince $A$ is invertible, we can multiply this equation by ${A}^{-1}:$\n\n$$\n\\begin{aligned}{A}^{-1}({A}^{3}+{A}^{2}-7A+2I) & =O \\\\ {A}^{2}+A-7I+2{A}^{-1} & =O \\\\ 2{A}^{-1} & =7I-A-{A}^{2} \\\\ {A}^{-1} & =\\frac{7}{2}I-\\frac{1}{2}A-\\frac{1}{2}{A}^{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-40168/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "152243fa-e0a5-551d-92d9-b470789087c7"] :knowledge-point/questions ["q-40168"] :db/ensure [:knowledge-point/validate]} {:db/id "q-140531/selection/e997cdc33a5d6dd8b2574f0918102d8c6080cd9ead6c2f72670177a05c86a21a" :answer/id #uuid "64c0d39d-9c35-5ced-96c0-3594d2ccc28b" :answer/type :answer.type/math :answer/value "\\frac{11}{12}I+\\frac{1}{3}A-\\frac{1}{24}{A}^{2}" :db/ensure [:answer/validate]} {:db/id "q-140531/selection/16a68919bbec94b1d14141bfe0baa1990a7a859f4c672b55b886c98f9ccb721f" :answer/id #uuid "e7e22241-9ebb-5abe-926d-904c3d94a437" :answer/type :answer.type/math :answer/value "\\frac{11}{24}I-\\frac{1}{6}A+\\frac{1}{24}{A}^{2}" :db/ensure [:answer/validate]} {:db/id "q-140531/selection/14f0f2a63af9b952be7f35211da62381f09dd2572209cb07d5b3fb04016af81c" :answer/id #uuid "9c7b08d2-6aa3-571d-bce0-f9f5b6834e5d" :answer/type :answer.type/math :answer/value "\\frac{11}{24}I+\\frac{1}{12}A-\\frac{1}{24}{A}^{2}" :db/ensure [:answer/validate]} {:db/id "q-140531/selection/4e12d6ddd339ff5be8a2f9ff8ef89ac63fa80eac375f1f75663c4bec46c67bed" :answer/id #uuid "16023665-e33b-5d9a-afa5-f419d0d7b5de" :answer/type :answer.type/math :answer/value "24I+\\frac{1}{12}A+\\frac{1}{6}{A}^{2}" :db/ensure [:answer/validate]} {:db/id "q-140531/selection/aaef5503e6cd3beb2cfe308d5966604c8f07fccd1a6998bf7d654e11a686883a" :answer/id #uuid "8b85c38f-37a1-53a0-b59f-11216cdc771e" :answer/type :answer.type/math :answer/value "\\frac{11}{24}I+\\frac{1}{12}A+\\frac{1}{12}{A}^{2}" :db/ensure [:answer/validate]} {:db/id "q-140531/selection" :answer-field/id #uuid "846946f0-267b-5b49-9625-b464e537521c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-140531/selection/14f0f2a63af9b952be7f35211da62381f09dd2572209cb07d5b3fb04016af81c" :answer-field/choices ["q-140531/selection/e997cdc33a5d6dd8b2574f0918102d8c6080cd9ead6c2f72670177a05c86a21a" "q-140531/selection/16a68919bbec94b1d14141bfe0baa1990a7a859f4c672b55b886c98f9ccb721f" "q-140531/selection/14f0f2a63af9b952be7f35211da62381f09dd2572209cb07d5b3fb04016af81c" "q-140531/selection/4e12d6ddd339ff5be8a2f9ff8ef89ac63fa80eac375f1f75663c4bec46c67bed" "q-140531/selection/aaef5503e6cd3beb2cfe308d5966604c8f07fccd1a6998bf7d654e11a686883a"] :db/ensure [:answer-field/validate]} {:db/id "q-140531" :question/id #uuid "b7a4964c-4a39-54df-8b48-fb778fd1712f" :question/math-academy-id "q-140531" :question/problem "If $A=[\\begin{aligned}3 & -2 & -2 \\\\ 0 & 2 & 1 \\\\ 0 & 2 & -3\\end{aligned}],$ then ${A}^{-1}=$" :question/worked-solution "Let's find the characteristic equation $\\text{det}(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\text{det}(A-\\lambda I) & =0 \\\\ |\\begin{aligned}3-\\lambda  & -2 & -2 \\\\ 0 & 2-\\lambda  & 1 \\\\ 0 & 2 & -3-\\lambda \\end{aligned}| & =0 \\\\ (3-\\lambda )|\\begin{aligned}2-\\lambda  & 1 \\\\ 2 & -3-\\lambda \\end{aligned}| & =0 \\\\ (3-\\lambda )((2-\\lambda )(-3-\\lambda )-2) & =0 \\\\ (3-\\lambda )({\\lambda }^{2}+\\lambda -8) & =0 \\\\ {\\lambda }^{3}-2{\\lambda }^{2}-11\\lambda +24 & =0\\end{aligned}\n$$\n\nUsing the Cayley-Hamilton theorem, we have that\n\n$$\n\\begin{aligned}{A}^{3}-2{A}^{2}-11A+24I & =O.\\end{aligned}\n$$\n\nSince $A$ is invertible, we can multiply this equation by ${A}^{-1}:$\n\n$$\n\\begin{aligned}{A}^{-1}({A}^{3}-2{A}^{2}-11A+24I) & =O \\\\ {A}^{2}-2A-11I+24{A}^{-1} & =O \\\\ 24{A}^{-1} & =11I+2A-{A}^{2} \\\\ {A}^{-1} & =\\frac{11}{24}I+\\frac{1}{12}A-\\frac{1}{24}{A}^{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-140531/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "152243fa-e0a5-551d-92d9-b470789087c7"] :knowledge-point/questions ["q-140531"] :db/ensure [:knowledge-point/validate]} {:db/id "q-85928/selection/fea7f6b22e69e29a9716f674d580a63eca4b26e1b4ae5c4f38b3026c28b2b97d" :answer/id #uuid "224c1a90-11da-5f02-b188-5b8d454a671b" :answer/type :answer.type/math :answer/value "\\frac{9}{8}" :db/ensure [:answer/validate]} {:db/id "q-85928/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "13d833b8-1477-5e0e-9cd0-b25f67d71b7b" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-85928/selection/2b998a440c758092569557828849b9a2d05282247ea8a11a5727b6cadcbcb080" :answer/id #uuid "5e45d8af-8226-5488-8c4c-c39cdadce2c3" :answer/type :answer.type/math :answer/value "\\frac{7}{4}" :db/ensure [:answer/validate]} {:db/id "q-85928/selection/b05ae51c7e0f9ce8edef362b0e3bfd104c905bad9c2676254ee36131cb916baa" :answer/id #uuid "6ca63e1b-057e-5a96-9861-c642575b2509" :answer/type :answer.type/math :answer/value "\\frac{5}{8}" :db/ensure [:answer/validate]} {:db/id "q-85928/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer/id #uuid "584e9688-ffae-5ccb-b0f5-7d4aeaa32511" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "q-85928/selection" :answer-field/id #uuid "f27fb89b-69aa-5ff6-9025-e85e709dc769" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-85928/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer-field/choices ["q-85928/selection/fea7f6b22e69e29a9716f674d580a63eca4b26e1b4ae5c4f38b3026c28b2b97d" "q-85928/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" "q-85928/selection/2b998a440c758092569557828849b9a2d05282247ea8a11a5727b6cadcbcb080" "q-85928/selection/b05ae51c7e0f9ce8edef362b0e3bfd104c905bad9c2676254ee36131cb916baa" "q-85928/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393"] :db/ensure [:answer-field/validate]} {:db/id "q-85928" :question/id #uuid "d5e8f2dd-a84f-5402-86f8-0ba47efb3ed5" :question/math-academy-id "q-85928" :question/problem "Given that $\\,A=[\\begin{aligned}3 & 2 \\\\ 2 & 4\\end{aligned}]\\,$ and $\\,{A}^{-1}=pI+qA$, find the value $p+q.$" :question/worked-solution "Let's find the characteristic equation $\\text{det}(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\text{det}(A-\\lambda I) & =0 \\\\ |\\begin{aligned}3-\\lambda  & 2 \\\\ 2 & 4-\\lambda \\end{aligned}| & =0 \\\\ (3-\\lambda )(4-\\lambda )-4 & =0 \\\\ {\\lambda }^{2}-7\\lambda +8 & =0\\end{aligned}\n$$\n\nUsing the Cayley-Hamilton theorem, we have that\n\n$$\n\\begin{aligned}{A}^{2}-7A+8I & =O.\\end{aligned}\n$$\n\nSince $A$ is invertible, we can multiply this equation by ${A}^{-1}:$\n\n$$\n\\begin{aligned}{A}^{-1}({A}^{2}-7A+8I) & =O \\\\ A-7I+8{A}^{-1} & =O \\\\ {A}^{-1} & =\\frac{7}{8}I-\\frac{1}{8}A\\end{aligned}\n$$\n\nTherefore, $p=\\frac{7}{8},$ $q=-\\frac{1}{8}$ and\n\n$$\np+q=\\frac{7}{8}+(-\\frac{1}{8})=\\frac{3}{4}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-85928/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "152243fa-e0a5-551d-92d9-b470789087c7"] :knowledge-point/questions ["q-85928"] :db/ensure [:knowledge-point/validate]} {:db/id "q-140606/selection/b7dfd792854c05c7f95703cc0bcf80f641387d616c11a21