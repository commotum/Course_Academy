lank :answer-field/correct "q-279515/field-3/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-279515/field-3/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-279515/field-4/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "a6555129-5396-5624-915d-11043f560a67" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-279515/field-4" :answer-field/id #uuid "948820d8-6dd6-5ad4-828e-4a28b6cb2c51" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-279515/field-4/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer-field/choices ["q-279515/field-4/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc"] :db/ensure [:answer-field/validate]} {:db/id "q-279515" :question/id #uuid "9bf45e9a-39d0-5665-9b47-d092d88f20e1" :question/math-academy-id "q-279515" :question/problem "Consider the matrix $A=[\\begin{aligned}3 & 5 \\\\ 1 & -2\\end{aligned}].$ If $f(X)={X}^{2}+2X+5$, find $f(A).$\n\n| $f(A)=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}+2X+5 \\\\  & ={X}^{2}+2X+5I\\end{aligned}\n$$\n\nSo, we want to find $f(A)={A}^{2}+2A+5I.$\n\nLet's calculate ${A}^{2}$ as follows:\n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =[\\begin{aligned}3 & 5 \\\\ 1 & -2\\end{aligned}]\\cdot [\\begin{aligned}3 & 5 \\\\ 1 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}14 & 5 \\\\ 1 & 9\\end{aligned}]\\end{aligned}\n$$\n\nNow, we can evaluate $f(A):$\n\n$$\n\\begin{aligned}f(A) & ={A}^{2}+2A+5I \\\\  & =[\\begin{aligned}14 & 5 \\\\ 1 & 9\\end{aligned}]+2[\\begin{aligned}3 & 5 \\\\ 1 & -2\\end{aligned}]+5[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}14 & 5 \\\\ 1 & 9\\end{aligned}]+[\\begin{aligned}6 & 10 \\\\ 2 & -4\\end{aligned}]+[\\begin{aligned}5 & 0 \\\\ 0 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}14+6+5 & 5+10+0 \\\\ 1+2+0 & 9+(-4)+5\\end{aligned}] \\\\  & =[\\begin{aligned}25 & 15 \\\\ 3 & 10\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-279515/field-1" "q-279515/field-2" "q-279515/field-3" "q-279515/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "61443225-bc08-5d36-a603-3a1d7e392a98"] :knowledge-point/questions ["q-279515"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-4414"] :question/problem "Find $A^4$ given that ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14048771/assets/45b13bcb5bbd8dc54e605acf6d378f582dcb7a4f2ecfff35a7a5343ee30f0515.png)" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4417"] :question/problem "Consider the matrix\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14048771/assets/a58c9caa0812b56d74f38a457c3f39e72a3fd365a881d4128cfd55c1773e05f6.png)\nFind $f(D)$ if $f(X)=-X^2+3X+2.$" :db/ensure [:question/validate]}]
