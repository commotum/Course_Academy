begin{aligned}9-3-2 & -8-(-2)-0 \\\\ 0-0-0 & 1-1-2\\end{aligned}] \\\\  & =[\\begin{aligned}4 & -6 \\\\ 0 & -2\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-279485/field-1" "q-279485/field-2" "q-279485/field-3" "q-279485/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "61443225-bc08-5d36-a603-3a1d7e392a98"] :knowledge-point/questions ["q-279485"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130681/selection/ed2833591cf770702ad5e20827a03f274842197ba3d2143b5d8d6f8b12479d93" :answer/id #uuid "1a8491b8-14f4-5acb-ae14-3ec063a29605" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3 & 6 \\\\ -6 & 9\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130681/selection/e9f4e82d8bd40c9edd605863f0c2c368f9f87e3b2dc60a4a762f43d932b968c0" :answer/id #uuid "f7cc9b06-d6ce-5717-a320-8068c52527c6" :answer/type :answer.type/math :answer/value "[\\begin{aligned}6 & -3 \\\\ 9 & 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130681/selection/140d0234c33dec8d2f0bfa7cc9c27b27d79e6c0c650106bb923fc96e54dc2b0b" :answer/id #uuid "b30030d6-4a7e-52b5-8f22-62bff57a8a46" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 & 6 \\\\ 6 & 9\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130681/selection/18d72df6e00a1f9fea2ed2740d9fe18c93f44dec188a129fe69973055c382332" :answer/id #uuid "3cde916e-cb38-5751-b32a-59d15c2dc718" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3 & 6 \\\\ 9 & 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130681/selection/b38565700ca93e2d3edd06b16c94dd3ac5d63977f68610be09bcd321fcd3d570" :answer/id #uuid "a6f70fc7-31da-5034-a08c-6d9ac63c7188" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 & -6 \\\\ 9 & -6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130681/selection" :answer-field/id #uuid "fddd4b10-5e82-5304-ab24-74050750dc74" :answer-field/key "selection" :a