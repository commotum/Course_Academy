\begin{aligned}f(A) & ={A}^{2}+2A+5I \\\\  & =[\\begin{aligned}14 & 5 \\\\ 1 & 9\\end{aligned}]+2[\\begin{aligned}3 & 5 \\\\ 1 & -2\\end{aligned}]+5[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}14 & 5 \\\\ 1 & 9\\end{aligned}]+[\\begin{aligned}6 & 10 \\\\ 2 & -4\\end{aligned}]+[\\begin{aligned}5 & 0 \\\\ 0 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}14+6+5 & 5+10+0 \\\\ 1+2+0 & 9+(-4)+5\\end{aligned}] \\\\  & =[\\begin{aligned}25 & 15 \\\\ 3 & 10\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14048771/state.json" "file_sha256" "956a4ee55117be96f2b7c9a3adc1946f5bf410ebb8a0e9f110abdb4dcf39f02a"} {"question" "q-279515" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14048771/activity-metadata.json" "file_sha256" "9923620213817c738d757baf104b046cf604309ccbf8aea300403b45fb514e30"} {"question" "q-279515" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14048771/state.json" "file_sha256" "956a4ee55117be96f2b7c9a3adc1946f5bf410ebb8a0e9f110abdb4dcf39f02a"} {"question" "q-279515" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "25"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14048771/state.json" "file_sha256" "956a4ee55117be96f2b7c9a3adc1946f5bf410ebb8a0e9f110abdb4dcf39f02a"} {"question" "q-279515" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14048771/state.