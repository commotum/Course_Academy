  & ={X}^{2}-3X+4I\\end{aligned}\n$$\n\nSo, we want to find $f(B)={B}^{2}-3B+4I.$\n\nLet's calculate ${B}^{2}$ as follows:\n\n$$\n\\begin{aligned}{B}^{2} & =B\\cdot B \\\\  & =[\\begin{aligned}1 & -1 \\\\ -3 & 2\\end{aligned}]\\cdot [\\begin{aligned}1 & -1 \\\\ -3 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}4 & -3 \\\\ -9 & 7\\end{aligned}]\\end{aligned}\n$$\n\nNow, we can evaluate $f(B):$\n\n$$\n\\begin{aligned}f(B) & ={B}^{2}-3B+4I \\\\  & =[\\begin{aligned}4 & -3 \\\\ -9 & 7\\end{aligned}]-3[\\begin{aligned}1 & -1 \\\\ -3 & 2\\end{aligned}]+4[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}4 & -3 \\\\ -9 & 7\\end{aligned}]-[\\begin{aligned}3 & -3 \\\\ -9 & 6\\end{aligned}]+[\\begin{aligned}4 & 0 \\\\ 0 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}4-3+4 & -3-(-3)+0 \\\\ -9-(-9)+0 & 7-6+4\\end{aligned}] \\\\  & =[\\begin{aligned}5 & 0 \\\\ 0 & 5\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14048771/state.json" "file_sha256" "956a4ee55117be96f2b7c9a3adc1946f5bf410ebb8a0e9f110abdb4dcf39f02a"} {"question" "q-78579" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14048771/activity-metadata.json" "file_sha256" "9923620213817c738d757baf104b046cf604309ccbf8aea300403b45fb514e30"} {"question" "q-78579" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14048771/state.json" "file_sha256" "956a4ee55117be96f2b7c9a3adc1946f5bf410ebb8a0e9f110abdb4dcf39f02a"} {"question" "q-78579" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]"] ["math" "[\\begin{aligned}5 & 0 \\\