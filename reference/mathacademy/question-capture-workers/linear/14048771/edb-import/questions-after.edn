aluate $f(A):$\n\n$$\n\\begin{aligned}f(A) & ={A}^{2}+2A+5I \\\\  & =[\\begin{aligned}14 & 5 \\\\ 1 & 9\\end{aligned}]+2[\\begin{aligned}3 & 5 \\\\ 1 & -2\\end{aligned}]+5[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}14 & 5 \\\\ 1 & 9\\end{aligned}]+[\\begin{aligned}6 & 10 \\\\ 2 & -4\\end{aligned}]+[\\begin{aligned}5 & 0 \\\\ 0 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}14+6+5 & 5+10+0 \\\\ 1+2+0 & 9+(-4)+5\\end{aligned}] \\\\  & =[\\begin{aligned}25 & 15 \\\\ 3 & 10\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186284445 :knowledge-point/_questions [{:knowledge-point/id #uuid "82e970fe-cff8-50e3-9b94-67ad97b03da7" :knowledge-point/title "Finding a Power of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f946525-3e2d-5abf-8f4f-ade88c6a78e6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 12 \\\\ 14 & 9\\end{aligned}]" :db/id #edb/ref 17592186284447} {:answer/id #uuid "983c14d0-0db6-5203-bfe1-99c5b48dca63" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 2 \\\\ 4 & 9\\end{aligned}]" :db/id #edb/ref 17592186284448} {:answer/id #uuid "698b32d9-6289-5b45-bcdc-a2c9e01f4e22" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 12 \\\\ 4 & 19\\end{aligned}]" :db/id #edb/ref 17592186284449} {:answer/id #uuid "d9055baf-fb78-52f6-87c5-7fa9a4f63ffc" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}8 & 12 \\\\ 1 & 9\\end{aligned}]" :db/id #edb/ref 17592186284450} {:answer/id #uuid "3596a79d-183e-540f-9d7a-11e50b3beb07" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 12 \\\\ 4 & 19\\end{aligned}]" :db/id #edb/ref 17592186284451}] :answer-field/correct {:answer/id #uuid "3596a79d-183e-540f-9d7a-11e50b3beb07" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 12 \\\\ 4 & 19\\end{aligned}]" :db/id #edb/ref 17592186284451} :answer-field/