3 & 4\\end{aligned}]" :db/id #edb/ref 17592186327578} {:answer/id #uuid "e8385453-4da4-5e5c-8157-b962240c2827" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 2 \\\\ 2 & 5\\end{aligned}]" :db/id #edb/ref 17592186327579} {:answer/id #uuid "deebe8ba-4cbd-5213-acbf-2f6166511716" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 0 \\\\ 0 & 5\\end{aligned}]" :db/id #edb/ref 17592186327580}] :answer-field/correct {:answer/id #uuid "deebe8ba-4cbd-5213-acbf-2f6166511716" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 0 \\\\ 0 & 5\\end{aligned}]" :db/id #edb/ref 17592186327580} :answer-field/id #uuid "b173a634-e44e-52c6-b251-390f6fc71092" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186327575}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e05cccc7-ce0d-54fd-bb7a-4d21b6ea5fbb" :question/math-academy-id "q-78579" :question/problem "Consider the matrix $B=[\\begin{aligned}1 & -1 \\\\ -3 & 2\\end{aligned}].$ Find $f(B)$ if $f(X)={X}^{2}-3X+4.$" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}-3X+4 \\\\  & ={X}^{2}-3X+4I\\end{aligned}\n$$\n\nSo, we want to find $f(B)={B}^{2}-3B+4I.$\n\nLet's calculate ${B}^{2}$ as follows:\n\n$$\n\\begin{aligned}{B}^{2} & =B\\cdot B \\\\  & =[\\begin{aligned}1 & -1 \\\\ -3 & 2\\end{aligned}]\\cdot [\\begin{aligned}1 & -1 \\\\ -3 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}4 & -3 \\\\ -9 & 7\\end{aligned}]\\end{aligned}\n$$\n\nNow, we can evaluate $f(B):$\n\n$$\n\\begin{aligned}f(B) & ={B}^{2}-3B+4I \\\\  & =[\\begin{aligned}4 & -3 \\\\ -9 & 7\\end{aligned}]-3[\\begin{aligned}1 & -1 \\\\ -3 & 2\\end{aligned}]+4[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}4 & -3 \\\\ -9 & 7\\end{aligned}]-[\\begin{aligned}3 & -3 \\\\ -9 & 6\\end{aligned}]+[\\begin{aligned}4 & 0 \\\\ 0 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}4-3+4 & -3-(-3)+0 \\\\ -9-(-9)+0 & 7-6+4\\end{aligned}] \\\\  & =[\\begin{aligned}5 & 0 \\\\ 0 & 5\\end{aligned}]\\end{aligned}\n$$"}]}
