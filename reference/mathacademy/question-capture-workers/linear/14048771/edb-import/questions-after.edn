36} {:answer/id #uuid "fa514ec3-d265-52ca-b943-cb77d805bbef" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -4 \\\\ 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186327537}] :answer-field/correct {:answer/id #uuid "89a43e17-adea-5e63-b546-86d0f217f5d2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -4 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186327535} :answer-field/id #uuid "5140cb22-e531-5aa0-adfd-7a24c2986f37" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186327532}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "681ab6a0-d33b-5c78-a959-eab0b25248ec" :question/math-academy-id "q-130577" :question/problem "If $A=[\\begin{aligned}1 & -2 \\\\ 0 & 1\\end{aligned}]$, then ${A}^{2}=$" :question/worked-solution "To find ${A}^{2},$ we multiply $A$ by itself:\n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =[\\begin{aligned}1 & -2 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & -2 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -4 \\\\ 0 & 1\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186327538 :knowledge-point/_questions [{:knowledge-point/id #uuid "61443225-bc08-5d36-a603-3a1d7e392a98" :knowledge-point/title "Evaluating a Matrix Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b30030d6-4a7e-52b5-8f22-62bff57a8a46" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 6 \\\\ 6 & 9\\end{aligned}]" :db/id #edb/ref 17592186327540} {:answer/id #uuid "3cde916e-cb38-5751-b32a-59d15c2dc718" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 & 6 \\\\ 9 & 6\\end{aligned}]" :db/id #edb/ref 17592186327541} {:answer/id #uuid "a6f70fc7-31da-5034-a08c-6d9ac63c7188" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & -6 \\\\ 9 & -6\\end{aligned}]" :db/id #edb/ref 17592186327542} {:answer/id #uuid "f7cc9b06-d6ce-5717-a320-8068c52527c6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & -3 \\\\ 9 & 6\\end{aligned}]" :db/id #edb/ref 17592186327543} {:answer/id #uuid "1a8491b8-14f4-5acb-ae14-3ec063a29605" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 & 6 \\\\ -6 & 9\\end{aligned}]" :db/id #edb/ref 17592186327544}] :answer-field/correct {:answer/id #uuid "3cde916e-cb38-5751-b32a-59d15c2dc718" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 & 6 \\\\ 9 & 6\\end{aligned}]" :db/id #edb/ref 17592186327541} :answer-field/id #uuid "fddd4b10-5e82-5304-ab24-74050750dc74" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186327539}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "01490c7d-4c84-5d6b-914b-a1fab67bc26a" :question/math-academy-id "q-130681" :question/problem "Consider the matrix $A=[\\begin{aligned}1 & 2 \\\\ 3 & 4\\end{aligned}].$  Find $f(A)$ if $f(X)={X}^{2}-2X-8.$" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}-2X-8 \\\\  & ={X}^{2}-2X-8I\\end{aligned}\n$$\n\nSo, we want to find $f(A)={A}^{2}-2A-8I.$\n\nLet's calculate ${A}^{2}$ as follows:\n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =[\\begin{aligned}1 & 2 \\\\ 3 & 4\\end{aligned}]\\cdot [\\begin{aligned}1 & 2 \\\\ 3 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}7 & 10 \\\\ 15 & 22\\end{aligned}]\\end{aligned}\n$$\n\nNow, we can evaluate $f(A):$\n\n$$\n\\begin{aligned}f(A) & ={A}^{2}-2A-8I \\\\  & =[\\begin{aligned}7 & 10 \\\\ 15 & 22\\end{aligned}]-2[\\begin{aligned}1 & 2 \\\\ 3 & 4\\end{aligned}]-8[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}7 & 10 \\\\ 15 & 22\\end{aligned}]+[\\begin{aligned}-2 & -4 \\\\ -6 & -8\\end{aligned}]+[\\begin{aligned}-8 & 0 \\\\ 0 & -8\\end{aligned}] \\\\  & =[\\begin{aligned}7-2-8 & 10-4+0 \\\\ 15-6+0 & 22-8-8\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 6 \\\\ 9 & 6\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186310914 :knowledge-point/_questions [{:knowledge-point/id #uuid "61443225-bc08-5d36-a603-3a1d7e392a98" :knowledge-point/title "Evaluating a Matrix Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2fda9c8-7ae1-583d-b5b0-3f8105d5c35a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & 2 \\\\ -6 & -4\\end{aligned}]" :db/id #edb/ref 17592186310916} {:answer/id #uuid "bc48d304-5608-59c0-bf0f-212e59aadf15" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186310917} {:answer/id #uuid "c83e22f8-b3de-5a66-95b9-bd18ffb596c3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186310918} {:answer/id #uuid "56453ca0-b56d-5a07-8753-b14af48c034c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -3 \\\\ 1 & -2\\end{aligned}]" :db/id #edb/ref 17592186310919} {:answer/id #uuid "2e646f1d-ceb6-5b3c-b5f0-781f2f09a1e2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 1 \\\\ -3 & -2\\end{aligned}]" :db/id #edb/ref 17592186310920}] :answer-field/correct {:answer/id #uuid "c83e22f8-b3de-5a66-95b9-bd18ffb596c3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186310918} :answer-field/id #uuid "55b49f2f-315e-50d2-ab17-0103385b9d24" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186310915}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c5573f21-e824-5c9e-8e76-3403856afb46" :question/math-academy-id "q-130684" :question/problem "Consider the matrix $D=[\\begin{aligned}4 & 2 \\\\ -6 & -4\\end{aligned}].$  Find $f(D)$ if $f(X)={X}^{2}-4.$" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}-4 \\\\  & ={X}^{2}-4I\\end{aligned}\n$$\n\nSo, we want to find $f(D)={D}^{2}-4I.$ \n\nLet's calculate ${D}^{2}$ as follows:\n\n$$\n\\begin{aligned}{D}^{2} & =D\\cdot D \\\\  & =[\\begin{aligned}4 & 2 \\\\ -6 & -4\\end{aligned}]\\cdot [\\begin{aligned}4 & 2 \\\\ -6 & -4\\end{aligned}] \\\\  & =[\\begin{aligned}4 & 0 \\\\ 0 & 4\\end{aligned}]\\end{aligned}\n$$\n\nNow, we can evaluate $f(D):$\n\n$$\n\\begin{aligned}f(D) & ={D}^{2}-4I \\\\  & =[\\begin{aligned}4 & 0 \\\\ 0 & 4\\end{aligned}]-4[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}4 & 0 \\\\ 0 & 4\\end{aligned}]+[\\begin{aligned}-4 & 0 \\\\ 0 & -4\\end{aligned}] \\\\  & =[\\begin{aligned}4-4 & 0+0 \\\\ 0+0 & 4-4\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186327545 :knowledge-point/_questions [{:knowledge-point/id #uuid "82e970fe-cff8-50e3-9b94-67ad97b03da7" :knowledge-point/title "Finding a Power of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af12c62b-206c-57ba-8a28-1b19ce87d6c0" :answer/type {:db/ident :answer.type/math} :answer/value "147" :db/id #edb/ref 17592186327547} {:answer/id #uuid "39a89893-5183-59ae-945a-e98da6fda662" :answer/type {:db/ident :answer.type/math} :answer/value "146" :db/id #edb/ref 17592186327548}] :answer-field/correct {:answer/id #uuid "39a89893-5183-59ae-945a-e98da6fda662" :answer/type {:db/ident :answer.type/math} :answer/value "146" :db/id #edb/ref 17592186327548} :answer-field/id #uuid "01dddff5-dc94-51b5-88bf-d6eb2ad997f2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :