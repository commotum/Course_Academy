x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{3}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{24{x}^{3}-1}{2c{x}^{3}-15{x}^{2}} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{24{x}^{3}}{{x}^{3}}-\\frac{1}{{x}^{3}})}{(\\frac{2c{x}^{3}}{{x}^{3}}-\\frac{15{x}^{2}}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(24-\\frac{1}{{x}^{3}})}{(2c-\\frac{15}{x})} \\\\  & =\\frac{24-0}{2c-0} \\\\  & =\\frac{12}{c}.\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{12}{c} & =-\\frac{1}{3} \\\\ c & =-36.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-35836/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ee15db10-b92c-5f48-8983-e602068c7e08"] :knowledge-point/questions ["q-35836"] :db/ensure [:knowledge-point/validate]} {:db/id "q-101319/selection/b26e894d2fd0ebe4d4ef7ab1da3fb9999e873039fa04418de269237f3fd74950" :answer/id #uuid "57c1e2df-8bcc-5011-9db9-11fe9a6c4695" :answer/type :answer.type/math :answer/value "y=-\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-101319/selection/c3deb073f152a478e46392e1f56479f2987a022223419d7f9c369a815039d205" :answer/id #uuid "9881eff1-19d5-5d12-bf10-b8cf9d59edb6" :answer/type :answer.type/math :answer/value "y=\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-101319/selection/b4433cc3a1cf5e75fc9a785442bb7c0d16a914e01f6e6fe624ef0ea36d614fe6" :answer/id #uuid "5ec15b0d-5160-5486-9468-9ac72d0d9094" :answer/type :answer.type/text :answer/value "No horizontal asymptote" :db/ensure [:answer/validate]} {:db/id "q-101319/selection/e3e05ab554d3ffbd5807d014df5eb4e5fbf0a4dfa1317a442d9714000086cccc" :answer/id #uuid "9c15ce9b-efe1-5ee8-8f34-4f3b2207e155" :answer/type :answer.type/math :answer/value "y=\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-101319/selection/bb4e1be02a1ceee34989c85bcc52e58356b4559f2810da5da714fef2710d4eca" :answer/id #uuid "0ec79a22-6eef-524b-a114-f45466b6c116" :answer/type :answer.type/math :answer/value "y=-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-101319/selection" :answer-field/id #uuid "03860e69-abc0-52cb-82c9-f3068c82c0b4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-101319/selection/b4433cc3a1cf5e75fc9a785442bb7c0d16a914e01f6e6fe624ef0ea36d614fe6" :answer-field/choices ["q-101319/selection/b26e894d2fd0ebe4d4ef7ab1da3fb9999e873039fa04418de269237f3fd74950" "q-101319/selection/c3deb073f152a478e46392e1f56479f2987a022223419d7f9c369a815039d205" "q-101319/selection/b4433cc3a1cf5e75fc9a785442bb7c0d16a914e01f6e6fe624ef0ea36d614fe6" "q-101319/selection/e3e05ab554d3ffbd5807d014df5eb4e5fbf0a4dfa1317a442d9714000086cccc" "q-101319/selection/bb4e1be02a1ceee34989c85bcc52e58356b4559f2810da5da714fef2710d4eca"] :db/ensure [:answer-field/validate]} {:db/id "q-101319" :question/id #uuid "7e63b016-2ed8-5744-85e3-ba7a5b9b598c" :question/math-academy-id "q-101319" :question/problem "Find the horizontal asymptote of $y=f(x)$ where $f(x)=\\frac{2{x}^{2}+x-1}{3x+2}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is $x.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{2{x}^{2}+x-1}{3x+2} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{2{x}^{2}}{x}+\\frac{x}{x}-\\frac{1}{x})}{(\\frac{3x}{x}+\\frac{2}{x})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(2x+1-\\frac{1}{x})}{(3+\\frac{2}{x})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(2x+1-0)}{(3+0)} \\\\  & =\\frac{1}{3}{lim}_{x\\to \\infty }(2x+1) \\\\  & =\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-101319/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bde258b7-1654-5e73-8703-0e42371db8f4"] :knowledge-point/questions ["q-101319"] :db/ensure [:knowledge-point/validate]} {:db/id "q-106698/selection/bb4e1be02a1ceee34989c85bcc52e58356b4559f2810da5da714fef2710d4eca" :answer/id #uuid "d3db3c90-e72d-5b7b-ac9c-d2cac507767b" :answer/type :answer.type/math :answer/value "y=-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-106698/selection/b4433cc3a1cf5e75fc9a785442bb7c0d16a914e01f6e6fe624ef0ea36d614fe6" :answer/id #uuid "2d44cd0e-f0c7-5440-bc72-34ea3857082a" :answer/type :answer.type/text :answer/value "No horizontal asymptote" :db/ensure [:answer/validate]} {:db/id "q-106698/selection/763a7c0b26f15df25c2db2d8ac42125e806c2e4b56e4f070b4566eba7e05dfff" :answer/id #uuid "825fabcc-dc77-50c1-a74d-517d6520c732" :answer/type :answer.type/math :answer/value "y=-3" :db/ensure [:answer/validate]} {:db/id "q-106698/selection/feb2c353acce484cb267fc95bae1ab6db185f770de87fe9eb4e168b5aa1d3a8e" :answer/id #uuid "cc483799-152e-5118-9756-a2d30022137e" :answer/type :answer.type/math :answer/value "y=\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-106698/selection/dbaf85835946aefb97564ba0d1ea287b684a4c8821f4256502e349376df74d28" :answer/id #uuid "400914b4-c673-58c8-95b6-7a1a476bb1b5" :answer/type :answer.type/math :answer/value "y=2" :db/ensure [:answer/validate]} {:db/id "q-106698/selection" :answer-field/id #uuid "d33fcbe4-277c-5357-8945-5308d3b4c70e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-106698/selection/b4433cc3a1cf5e75fc9a785442bb7c0d16a914e01f6e6fe624ef0ea36d614fe6" :answer-field/choices ["q-106698/selection/bb4e1be02a1ceee34989c85bcc52e58356b4559f2810da5da714fef2710d4eca" "q-106698/selection/b4433cc3a1cf5e75fc9a785442bb7c0d16a914e01f6e6fe624ef0ea36d614fe6" "q-106698/selection/763a7c0b26f15df25c2db2d8ac42125e806c2e4b56e4f070b4566eba7e05dfff" "q-106698/selection/feb2c353acce484cb267fc95bae1ab6db185f770de87fe9eb4e168b5aa1d3a8e" "q-106698/selection/dbaf85835946aefb97564ba0d1ea287b684a4c8821f4256502e349376df74d28"] :db/ensure [:answer-field/validate]} {:db/id "q-106698" :question/id #uuid "c1e689ad-107f-573d-b38b-7f1ffbb249ba" :question/math-academy-id "q-106698" :question/problem "Find the horizontal asymptote of $y=f(x)$ where $f(x)=\\frac{7{x}^{5}-3{x}^{2}}{6-2x}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is $x.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{7{x}^{5}-3{x}^{2}}{6-2x} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{7{x}^{5}}{x}-\\frac{3{x}^{2}}{x})}{(\\frac{6}{x}-\\frac{2x}{x})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(7{x}^{4}-3x)}{(\\frac{6}{x}-2)} \\\\  & ={lim}_{x\\to \\infty }\\frac{(7{x}^{4}-3x)}{0-2} \\\\  & =-\\frac{1}{2}{lim}_{x\\to \\infty }(7{x}^{4}-3x) \\\\  & =-\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-106698/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bde258b7-1654-5e73-8703-0e42371db8f4"] :knowledge-point/questions ["q-106698"] :db/ensure [:knowledge-point/validate]} {:db/id "q-78016/selection/b4433cc3a1cf5e75fc9a785442bb7c0d16a914e01f6e6fe624ef0ea36d614fe6" :answer/id #uuid "c3cc426c-94e3-5801-9744-cb5ec7ebe015" :answer/type :answer.type/text :answer/value "No horizontal asymptote" :db/ensure [:answer/validate]} {:db/id "q-78016/selection/f7031104f14fe004994e4fe4b8af3fbe4e65cfa2bff3c7eab1748f5f2092c758" :answer/id #uuid "09127d37-417e-5fcb-8b16-05b0a5aa305c" :answer/type :answer.type/math :answer/value "y=1" :db/ensure [:answer/validate]} {:db/id "q-78016/selection/f3a21472c171e3b06321798ca059116fe98b02f999bc55deea0f55f5ad20ba03" :answer/id #uuid "cebb0cfe-c1f9-5153-a6ec-6a11f3ea4665" :answer/type :answer.type/math :answer/value "y=\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "q-78016/selection/96efe327aa5df1953454aa8a0acb24299d8e2e2f538b2a5f40d98e7332b886b7" :answer/id #uuid "2cffbdb4-8a22-5e2b-be5a-e5feba6ad7fc" :answer/type :answer.type/math :answer/value "y=0" :db/ensure [:answer/validate]} {:db/id "q-78016/selection/4feedb526b42a6330326ae286db118832dd2fb8a6461fa34068de015b5ade8cd" :answer/id #uuid "9166d501-5363-5134-b4ae-cfa72506f7cd" :answer/type :answer.type/math :answer/value "y=\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-78016/selection" :answer-field/id #uuid "921027f6-007e-5682-b582-67652c527968" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-78016/selection/b4433cc3a1cf5e75fc9a785442bb7c0d16a914e01f6e6fe624ef0ea36d614fe6" :answer-field/choices ["q-78016/selection/b4433cc3a1cf5e75fc9a785442bb7c0d16a914e01f6e6fe624ef0ea36d614fe6" "q-78016/selection/f7031104f14fe004994e4fe4b8af3fbe4e65cfa2bff3c7eab1748f5f2092c758" "q-78016/selection/f3a21472c171e3b06321798ca059116fe98b02f999bc55deea0f55f5ad20ba03" "q-78016/selection/96efe327aa5df1953454aa8a0acb24299d8e2e2f538b2a5f40d98e7332b886b7" "q-78016/selection/4feedb526b42a6330326ae286db118832dd2fb8a6461fa34068de015b5ade8cd"] :db/ensure [:answer-field/validate]} {:db/id "q-78016" :question/id #uuid "677d5738-cb69-509e-8934-2dc2fbf03ad1" :question/math-academy-id "q-78016" :question/problem "Find the horizontal asymptote of the function $f(x)=\\frac{{x}^{5}+1}{4{x}^{3}-x+1}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{3}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{{x}^{5}+1}{4{x}^{3}-x+1} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{{x}^{5}}{{x}^{3}}+\\frac{1}{{x}^{3}})}{(\\frac{4{x}^{3}}{{x}^{3}}-\\frac{x}{{x}^{3}}+\\frac{1}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{({x}^{2}+\\frac{1}{{x}^{3}})}{(4-\\frac{1}{{x}^{2}}+\\frac{1}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{({x}^{2}+0)}{(4-0+0)} \\\\  & =\\frac{1}{4}{lim}_{x\\to \\infty }{x}^{2} \\\\  & =\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-78016/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bde258b7-1654-5e73-8703-0e42371db8f4"] :knowledge-point/questions ["q-78016"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-80"] :question/problem "Evaluate $\\lim_\\limits{x\\rightarrow \\infty} \\dfrac{3x^4+9x}{6x^4-x^3}.$" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is $x^4.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{3{x}^{4}+9x}{6{x}^{4}-{x}^{3}} & ={lim}_{x\\to \\infty }\\frac{(\\frac{3{x}^{4}}{{x}^{4}}+\\frac{9x}{{x}^{4}})}{(\\frac{6{x}^{4}}{{x}^{4}}-\\frac{{x}^{3}}{{x}^{4}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(3+\\frac{9}{{x}^{3}})}{(6-\\frac{1}{x})} \\\\  & =\\frac{3+0}{6-0} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-81"] :question/problem "Calculate $\\lim_\\limits{x\\rightarrow -\\infty} \\dfrac{4-5x-2x^3}{x^2+3}.$" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is $x^2.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\frac{4-5x-2{x}^{3}}{{x}^{2}+3} & ={lim}_{x\\to -\\infty }\\frac{(\\frac{-2{x}^{3}}{{x}^{2}}-\\frac{5x}{{x}^{2}}+\\frac{4}{{x}^{2}})}{(\\frac{{x}^{2}}{{x}^{2}}+\\frac{3}{{x}^{2}})} \\\\  & ={lim}_{x\\to -\\infty }\\frac{(-2x-\\frac{5}{x}+\\frac{4}{{x}^{2}})}{(1+\\frac{3}{{x}^{2}})} \\\\  & ={lim}_{x\\to -\\infty }(\\frac{-2x+0+0}{1+0}) \\\\  & ={lim}_{x\\to -\\infty }(-2x) \\\\  & =\\infty .\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-82"] :question/problem "What is the horizontal asymptote of $y=f(x)$ with $f(x)=\\dfrac{2x^3+1}{x^3-15x}?$" :question/worked-solution "The horizontal asymptote is $y=\\lim_\\limits{x \\rightarrow \\infty} f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is $x^3.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{2{x}^{3}+1}{{x}^{3}-15x} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{2{x}^{3}}{{x}^{3}}+\\frac{1}{{x}^{3}})}{(\\frac{{x}^{3}}{{x}^{3}}-\\frac{15x}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(2+\\frac{1}{{x}^{3}})}{(1-\\frac{15}{{x}^{2}})} \\\\  & =\\frac{2+0}{1-0} \\\\  & =2\\end{aligned}\n$$\n\nTherefore, the horizontal asymptote is $y=2.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-83"] :question/problem "Find the horizontal asymptote of $y=f(x)$ where $f(x)=\\dfrac{x^5-10}{x^3-8x^2}.$" :question/worked-solution "The horizontal asymptote is $y=\\lim_\\limits{x \\rightarrow \\infty} f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is $x^3.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{{x}^{5}-10}{{x}^{3}-8{x}^{2}} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{{x}^{5}}{{x}^{3}}-\\frac{10}{{x}^{3}})}{(\\frac{{x}^{3}}{{x}^{3}}-\\frac{8{x}^{2}}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{({x}^{2}-\\frac{10}{{x}^{3}})}{(1-\\frac{8}{x})} \\\\  & ={lim}_{x\\to \\infty }(\\frac{{x}^{2}-0}{1-0}) \\\\  & ={lim}_{x\\to \\infty }{x}^{2} \\\\  & =\\infty .\\end{aligned}\n$$\n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote." :db/ensure [:question/validate]}]
