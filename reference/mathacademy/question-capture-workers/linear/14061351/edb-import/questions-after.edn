\infty }\\,\\,\\frac{({x}^{2}-0)}{(1-0+0)} \\\\  & ={lim}_{x\\to \\infty }\\,\\,{x}^{2} \\\\  & =\\infty .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275199 :knowledge-point/_questions [{:knowledge-point/id #uuid "32cbf366-20bd-5a52-a14f-83add698bf07" :knowledge-point/title "Evaluating a Limit at Infinity: Rational Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "646cf329-dca1-5645-a017-462ba94808b9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186275201} {:answer/id #uuid "03f2e178-1832-5c45-8c83-767c50ff3816" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186275202} {:answer/id #uuid "9b96f6db-9254-5076-a152-328b8b181782" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186275203} {:answer/id #uuid "e668ad1c-25b1-5e4c-b042-4529e8390d74" :answer/type {:db/ident :answer.type/text} :answer/value "Does not exist." :db/id #edb/ref 17592186275204} {:answer/id #uuid "543b94e1-01fe-5629-8725-915cbdb02bcb" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186275205}] :answer-field/correct {:answer/id #uuid "646cf329-dca1-5645-a017-462ba94808b9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186275201} :answer-field/id #uuid "edf75a5a-69cd-5b59-a1a1-e773f892ab7a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275200}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6dd55ea7-75b6-5df0-93a0-7e4cd72a8e5c" :question/math-academy-id "q-3762" :question/problem "${lim}_{x\\to -\\infty }\\,\\,\\frac{-2{x}^{3}+{x}^{2}}{6{x}^{3}-9}=$" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{3}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\,\\,\\frac{-2{x}^{3}+{x}^{2}}{6{x}^{3}-9} & ={lim}_{x\\to -\\infty }\\,\\,\\frac{(\\frac{-2{x}^{3}}{{x}^{3}}+\\frac{{x}^{2}}{{x}^{3}})}{(\\frac{6{x}^{3}}{{x}^{3}}-\\frac{9}{{x}^{3}})} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{(-2+\\frac{1}{x})}{(6-\\frac{9}{{x}^{3}})} \\\\  & =\\frac{-2+0}{6-0} \\\\  & =-\\frac{1}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341033 :knowledge-point/_questions [{:knowledge-point/id #uuid "ee15db10-b92c-5f48-8983-e602068c7e08" :knowledge-point/title "Identifying the Horizontal Asymptote of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57058574-7d70-5dd5-830b-c0559e3c6613" :answer/type {:db/ident :answer.type/math} :answer/value "y=3" :db/id #edb/ref 17592186341035} {:answer/id #uuid "891c10cf-3975-5d88-9192-f7f0de580a68" :answer/type {:db/ident :answer.type/math} :answer/value "y=-3" :db/id #edb/ref 17592186341036} {:answer/id #uuid "ed7e50b5-8e45-5f22-b8dd-647021d2934a" :answer/type {:db/ident :answer.type/math} :answer/value "y=-6" :db/id #edb/ref 17592186341037} {:answer/id #uuid "aaefbbb6-6fac-5fcc-bfd0-280001bcfcc1" :answer/type {:db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186341038} {:answer/id #uuid "1a9dd1d9-7ab5-5a9f-90f5-c307b35841d9" :answer/type {:db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186341039}] :answer-field/correct {:answer/id #uuid "891c10cf-3975-5d88-9192-f7f0de580a68" :answer/type {:db/ident :answer.type/math} :answer/value "y=-3" :db/id #edb/ref 17592186341036} :answer-field/id #uuid "b52d0826-ee50-53c5-ab1c-fa899c70ab44" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341034}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "83afe3ca-ce48-5376-ba62-ad4d799e50bc" :question/math-academy-id "q-48717" :question/problem "What is the horizontal asymptote of $y=f(x)$ for $x<0$ with $f(x)=\\frac{|3x+6|}{x-4}?$" :question/worked-solution "For large negative values of $x,$ we have $|3x+6|=-(3x+6).$ Consequently, for $x\\to -\\infty ,$ we get\n\n$$\n{lim}_{x\\to -\\infty }\\frac{|3x+6|}{x-4}={lim}_{x\\to -\\infty }\\frac{-(3x+6)}{x-4}.\n$$\n\nThe horizontal asymptote for $x<0$ is $y={lim}_{x\\to -\\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is $x.$\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }f(x) & ={lim}_{x\\to -\\infty }\\frac{-(3x+6)}{x-4} \\\\  & ={lim}_{x\\to -\\infty }\\frac{-(\\frac{3x}{x}+\\frac{6}{x})}{(\\frac{x}{x}-\\frac{4}{x})} \\\\  & ={lim}_{x\\to -\\infty }\\frac{-(3+\\frac{6}{x})}{(1-\\frac{4}{x})} \\\\  & =\\frac{-(3+0)}{1-0} \\\\  & =-3.\\end{aligned}\n$$\n\n \n\nTherefore, the horizontal asymptote is $y=-3.$"}] [{:db/id #edb/ref 17592186341040 :knowledge-point/_questions [{:knowledge-point/id #uuid "32cbf366-20bd-5a52-a14f-83add698bf07" :knowledge-point/title "Evaluating a Limit at Infinity: Rational Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "496df943-5038-5541-9890-1d107235d50f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{5}" :db/id #edb/ref 17592186341042} {:answer/id #uuid "ce9f4d3a-fc28-52b6-9eb0-2377767a8822" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{4}" :db/id #edb/ref 17592186341043} {:answer/id #uuid "22f83812-718c-5f5c-8964-b18c0f8ef05c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186341044} {:answer/id #uuid "09724855-4426-53b4-be0d-7b66abcd56a9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186341045} {:answer/id #uuid "e489e715-a582-5444-b867-8dd9214e0e23" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186341046}] :answer-field/correct {:answer/id #uuid "09724855-4426-53b4-be0d-7b66abcd56a9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186341045} :answer-field/id #uuid "fec2c85a-902a-580e-9eed-6a94b46d3c10" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341041}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d2725764-090f-55c8-a8ae-6f44078e0955" :question/math-academy-id "q-48842" :question/problem "${lim}_{x\\to \\infty }\\frac{|6x-2|}{8x+5}=$" :question/worked-solution "For large positive values of $x,$ we have $|6x-2|=6x-2.$ Consequently, for $x\\to \\infty ,$ we get\n\n$$\n{lim}_{x\\to \\infty }\\frac{|6x-2|}{8x+5}={lim}_{x\\to \\infty }\\frac{6x-2}{8x+5}.\n$$\n\nFirst, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{1}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{6x-2}{8x+5} & ={lim}_{x\\to \\infty }\\frac{(\\frac{6x}{x}-\\frac{2}{x})}{(\\frac{8x}{x}+\\frac{5}{x})} \\\\  & {lim}_{x\\to \\infty }\\frac{(6-\\frac{2}{x})}{(8+\\frac{5}{x})} \\\\  & =\\frac{6-0}{8-0} \\\\  & =\\frac{3}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341047 :knowledge-point/_questions [{:knowledge-point/id #uuid "32cbf366-20bd-5a52-a14f-83add698bf07" :knowledge-point/title "Evaluating a Limit at Infinity: Rational Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "479a2a09-ead0-50a2-88fc-21fd69c8e0bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186341049} {:answer/id #uuid "8b55da42-edc2-55e9-9343-47e333ab7a61" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186341050} {:answer/id #uuid "704850d2-0fbc-5184-b3c6-fe80b265cb9b" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186341051} {:answer/id #uuid "9cb04b9c-2524-5e62-b7f5-ab0e13d833d0" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186341052} {:answer/id #uuid "bc16775b-1497-5f0a-8ca2-eaa618ad5ce6" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186341053}] :answer-field/correct {:answer/id #uuid "bc16775b-1497-5f0a-8ca2-eaa618ad5ce6" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186341053} :answer-field/id #uuid "516df46c-09dc-5d34-8e5a-8b9599be575e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341048}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "4f93a1ed-2aa9-5cc1-bfdc-ea1e85777518" :question/math-academy-id "q-48872" :question/problem "Evaluate ${lim}_{x\\to \\infty }\\frac{4}{{x}^{2}+1}.$" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{2}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{4}{{x}^{2}+1} & ={lim}_{x\\to \\infty }\\frac{\\frac{4}{{x}^{2}}}{\\frac{{x}^{2}}{{x}^{2}}+\\frac{1}{{x}^{2}}} \\\\  & ={lim}_{x\\to \\infty }\\frac{\\frac{4}{{x}^{2}}}{1+\\frac{1}{{x}^{2}}} \\\\  & =\\frac{0}{1+0} \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341054 :knowledge-point/_questions [{:knowledge-point/id #uuid "32cbf366-20bd-5a52-a14f-83add698bf07" :knowledge-point/title "Evaluating a Limit at Infinity: Rational Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da171a55-46a5-570f-9b47-35c45d5ed257" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186341056} {:answer/id #uuid "78e64852-3529-5914-973b-88cafa206ae4" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186341057} {:answer/id #uuid "531f5633-6876-59d5-938f-09bb300f3186" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186341058} {:answer/id #uuid "04a341e6-9e92-5d36-83bf-00989e140002" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{5}" :db/id #edb/ref 17592186341059} {:answer/id #uuid "97bff7cd-f222-5465-a362-a5f28d34a44f" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186341060}] :answer-field/correct {:answer/id #uuid "97bff7cd-f222-5465-a362-a5f28d34a44f" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186341060} :answer-field/id #uuid "e5de6d13-5667-5cd8-a33e-a624a9d21207" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341055}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e48eb8c6-5d80-5eaa-9e9b-a82784e79ed8" :question/math-academy-id "q-48878" :question/problem "Evaluate ${lim}_{x\\to \\infty }\\frac{|10x+3|}{6-5x}.$" :question/worked-solution "For large positive values of $x,$ we have $|10x+3|=10x+3.$ Consequently, for $x\\to \\infty ,$ we get\n\n$$\n\\frac{|10x+3|}{6-5x}=\\frac{10x+3}{6-5x}.\n$$\n\nFirst, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{1}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{10x+3}{6-5x} & ={lim}_{x\\to \\infty }\\frac{(\\frac{10x}{x}+\\frac{3}{x})}{(\\frac{6}{x}-\\frac{5x}{x})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(10+\\frac{3}{x})}{(\\frac{6}{x}-5)} \\\\  & =\\frac{10+0}{0-5} \\\\  & =-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299327 :knowledge-point/_questions [{:knowledge-point/id #uuid "020c3de3-bcaf-5ade-ba50-2f15e344157d" :knowledge-point/title "Evaluating a Limit at Infinity: Infinite Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "577631be-9bc9-5c48-a744-9596a9a68f21" :answer/type {:db/ident :answer.type/math} :answer/value "1/4" :db/id #edb/ref 17592186299329} {:answer/id #uuid "73c32971-8e3a-528a-b8a4-d473f0bb5a5c" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186299330} {:answer/id #uuid "25a46913-ad20-5514-a0ba-bb33b0535080" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186299331} {:answer/id #uuid "29241699-b88c-58cf-a92e-ed8003c661f7" :answer/type {:db/ident :answer.type/text} :answer/value "Does not exist." :db/id #edb/ref 17592186299332} {:answer/id #uuid "61591f85-79f0-5ffe-acb3-a95e2357c468" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186299333}] :answer-field/correct {:answer/id #uuid "73c32971-8e3a-528a-b8a4-d473f0bb5a5c" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186299330} :answer-field/id #uuid "78df1bcd-0def-5c97-9099-6d7e2f08aac1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186299328}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "34021da9-66a6-59ae-b29e-95714c2bc04c" :question/math-academy-id "q-68048" :question/problem "Calculate ${lim}_{x\\to -\\infty }\\,\\,\\frac{4{x}^{5}-9}{{x}^{3}+8x}.$" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{3}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\,\\,\\frac{4{x}^{5}-9}{{x}^{3}+8x} & ={lim}_{x\\to -\\infty }\\,\\,\\frac{(\\frac{4{x}^{5}}{{x}^{3}}-\\frac{9}{{x}^{3}})}{(\\frac{{x}^{3}}{{x}^{3}}+\\frac{8x}{{x}^{3}})} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{(4{x}^{2}-\\frac{9}{{x}^{3}})}{(1+\\frac{8}{{x}^{2}})} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{4{x}^{2}-0}{1+0} \\\\  & ={lim}_{x\\to -\\infty }4{x}^{2} \\\\  & =\\infty .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275227 :knowledge-point/_questions [{:knowledge-point/id #uuid "bde258b7-1654-5e73-8703-0e42371db8f4" :knowledge-point/title "Identifying When a Rational Function has No Horizontal Asymptote"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f9f8a9f0-2934-5bb2-acc1-705b289fcf96" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186275229} {:answer/id #uuid "aabbba00-c010-5552-8c1b-3bbd78777d5e" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186275230} {:answer/id #uuid "a314f518-cb1f-515f-bc4c-dcc6af849905" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186275231} {:answer/id #uuid "36b5fef7-f91a-53f1-be44-a8476d359d4a" :answer/type {:db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186275232} {:answer/id #uuid "d9df4097-1963-5b33-aadd-b4e266535f86" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{2}" :db/id #edb/ref 17592186275233}] :answer-field/correct {:answer/id #uuid "36b5fef7-f91a-53f1-be44-a8476d359d4a" :answer/type {:db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186275232} :answer-field/id #uuid "9aa861b8-d4c7-5b09-b7dd-c98a15b62ed1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275228}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "10717fa0-edd5-574c-b927-2b9585138eba" :question/math-academy-id "q-68072" :question/problem "Find the horizontal asymptote of $y=f(x)$ where $f(x)=\\frac{-7{x}^{4}+3}{2{x}^{2}-4}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{2}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{-7{x}^{4}+3}{2{x}^{2}-4} \\\\  & {lim}_{x\\to \\infty }\\frac{(\\frac{-7{x}^{4}}{{x}^{2}}+\\frac{3}{{x}^{2}})}{(\\frac{2{x}^{2}}{{x}^{2}}-\\frac{4}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(-7{x}^{2}+\\frac{3}{{x}^{2}})}{(2-\\frac{4}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{-7{x}^{2}+0}{2-0} \\\\  & =\\frac{7}{2}{lim}_{x\\to \\infty }(-{x}^{2}) \\\\  & =-\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote."}] [{:db/id #edb/ref 17592186280126 :knowledge-point/_questions [{:knowledge-point/id #uuid "020c3de3-bcaf-5ade-ba50-2f15e344157d" :knowledge-point/title "Evaluating a Limit at Infinity: Infinite Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5bc57e8d-0be9-5b7f-86fe-36bb9122143d" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186280128} {:answer/id #uuid "e6b71e4a-024d-5309-a7c5-50eda1f1800b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186280129} {:answer/id #uuid "faddf15f-87b1-534f-9527-19e330a8ce06" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186280130} {:answer/id #uuid "1f0087ba-9d84-549b-84ed-f58e95c4364b" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186280131} {:answer/id #uuid "89e37013-c1e8-5507-a0f5-d2d0c0a3a256" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186280132}] :answer-field/correct {:answer/id #uuid "faddf15f-87b1-534f-9527-19e330a8ce06" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186280130} :answer-field/id #uuid "4b24b360-5353-5ebf-8afe-d3f9dac3298b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280127}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b690b281-73b5-5090-a017-0742982f5d27" :question/math-academy-id "q-78008" :question/problem "Calculate ${lim}_{x\\to -\\infty }\\,\\,\\frac{{x}^{3}+1}{2{x}^{2}+x}.$" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{2}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\,\\,\\frac{{x}^{3}+1}{2{x}^{2}+x} & ={lim}_{x\\to \\infty }\\,\\,\\frac{(\\frac{{x}^{3}}{{x}^{2}}+\\frac{1}{{x}^{2}})}{(\\frac{2{x}^{2}}{{x}^{2}}+\\frac{x}{{x}^{2}})} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{(x+\\frac{1}{{x}^{2}})}{(2+\\frac{1}{x})} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{(x+0)}{(2+0)} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{x}{2} \\\\  & =-\\infty .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341061 :knowledge-point/_questions [{:knowledge-point/id #uuid "bde258b7-1654-5e73-8703-0e42371db8f4" :knowledge-point/title "Identifying When a Rational Function has No Horizontal Asymptote"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9166d501-5363-5134-b4ae-cfa72506f7cd" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{4}" :db/id #edb/ref 17592186341063} {:answer/id #uuid "2cffbdb4-8a22-5e2b-be5a-e5feba6ad7fc" :answer/type {:db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186341064} {:answer/id #uuid "c3cc426c-94e3-5801-9744-cb5ec7ebe015" :answer/type {:db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186341065} {:answer/id #uuid "cebb0cfe-c1f9-5153-a6ec-6a11f3ea4665" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{5}" :db/id #edb/ref 17592186341066} {:answer/id #uuid "09127d37-417e-5fcb-8b16-05b0a5aa305c" :answer/type {:db/ident :answer.type/math} :answer/value "y=1" :db/id #edb/ref 17592186341067}] :answer-field/correct {:answer/id #uuid "c3cc426c-94e3-5801-9744-cb5ec7ebe015" :answer/type {:db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186341065} :answer-field/id #uuid "921027f6-007e-5682-b582-67652c527968" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341062}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "677d5738-cb69-509e-8934-2dc2fbf03ad1" :question/math-academy-id "q-78016" :question/problem "Find the horizontal asymptote of the function $f(x)=\\frac{{x}^{5}+1}{4{x}^{3}-x+1}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{3}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{{x}^{5}+1}{4{x}^{3}-x+1} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{{x}^{5}}{{x}^{3}}+\\frac{1}{{x}^{3}})}{(\\frac{4{x}^{3}}{{x}^{3}}-\\frac{x}{{x}^{3}}+\\frac{1}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{({x}^{2}+\\frac{1}{{x}^{3}})}{(4-\\frac{1}{{x}^{2}}+\\frac{1}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{({x}^{2}+0)}{(4-0+0)} \\\\  & =\\frac{1}{4}{lim}_{x\\to \\infty }{x}^{2} \\\\  & =\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote."}]}
