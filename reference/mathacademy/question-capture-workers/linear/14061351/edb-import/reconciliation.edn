nfty }\\,\\,\\frac{4{x}^{2}-0}{1+0} \\\\  & ={lim}_{x\\to -\\infty }4{x}^{2} \\\\  & =\\infty .\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038578/state.json" "file_sha256" "49ecffa1886b5da67f0f1b74ec7f122196a14d2d6bf78e3811f73c8ad0762649" "basis" 1309 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038578/edb-import/verification.json"} {"question" "q-68048" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038578/activity-metadata.json" "file_sha256" "b0536130743b41b6ce862829ee1e55c1ddca652ab6528f6a3c939f10cb01d69c" "basis" 1309 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038578/edb-import/verification.json"} {"question" "q-68048" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038578/state.json" "file_sha256" "49ecffa1886b5da67f0f1b74ec7f122196a14d2d6bf78e3811f73c8ad0762649" "basis" 1309 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038578/edb-import/verification.json"} {"question" "q-68048" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "-\\infty "] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038578/state.json" "file_sha256" "49ecffa1886b5da67f0f1b74ec7f122196a14d2d6bf78e3811f73c8ad0762649" "basis" 1309 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038578/edb-import/verification.json"} {"question" "q-68048" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "0"] "category" "ma_capture" "file" "/home/jake/