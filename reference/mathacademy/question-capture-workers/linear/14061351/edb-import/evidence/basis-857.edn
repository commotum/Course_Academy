#{[{:db/id #edb/ref 17592186280126 :knowledge-point/_questions [{:knowledge-point/id #uuid "020c3de3-bcaf-5ade-ba50-2f15e344157d" :knowledge-point/title "Evaluating a Limit at Infinity: Infinite Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5bc57e8d-0be9-5b7f-86fe-36bb9122143d" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186280128} {:answer/id #uuid "e6b71e4a-024d-5309-a7c5-50eda1f1800b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186280129} {:answer/id #uuid "faddf15f-87b1-534f-9527-19e330a8ce06" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186280130} {:answer/id #uuid "1f0087ba-9d84-549b-84ed-f58e95c4364b" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186280131} {:answer/id #uuid "89e37013-c1e8-5507-a0f5-d2d0c0a3a256" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186280132}] :answer-field/correct {:answer/id #uuid "faddf15f-87b1-534f-9527-19e330a8ce06" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186280130} :answer-field/id #uuid "4b24b360-5353-5ebf-8afe-d3f9dac3298b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280127}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b690b281-73b5-5090-a017-0742982f5d27" :question/math-academy-id "q-78008" :question/problem "Calculate ${lim}_{x\\to -\\infty }\\,\\,\\frac{{x}^{3}+1}{2{x}^{2}+x}.$" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{2}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\,\\,\\frac{{x}^{3}+1}{2{x}^{2}+x} & ={lim}_{x\\to \\infty }\\,\\,\\frac{(\\frac{{x}^{3}}{{x}^{2}}+\\frac{1}{{x}^{2}})}{(\\frac{2{x}^{2}}{{x}^{2}}+\\frac{x}{{x}^{2}})} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{(x+\\frac{1}{{x}^{2}})}{(2+\\frac{1}{x})} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{(x+0)}{(2+0)} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{x}{2} \\\\  & =-\\infty .\\end{aligned}\n$$"}]}
