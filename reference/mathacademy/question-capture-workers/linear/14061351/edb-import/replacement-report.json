          "question": "e-82",
          "field": null,
          "attribute": "question/problem",
          "value": "What is the horizontal asymptote of $y=f(x)$ with $f(x)=\\dfrac{2x^3+1}{x^3-15x}?$",
          "category": "ma_capture",
          "file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14061351/example-82.json",
