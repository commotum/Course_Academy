 & -7-\\lambda \\end{aligned}| & =0 \\\\ (7-\\lambda )(-7-\\lambda )-4\\cdot (-12) & =0 \\\\ {\\lambda }^{2}-1 & =0 \\\\ (\\lambda +1)(\\lambda -1) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues are ${\\lambda }_{1}=1$ and ${\\lambda }_{2}=-1.$ Since we get two distinct eigenvalues, the matrix $A$ is diagonalizable.\n\nNow, we construct the diagonal matrix $D,$ as follows:\n\n$$\nD=[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}]\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-80455/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d3d7cb0b-7d81-55a5-9781-dda7e9cc9fb9"] :knowledge-point/questions ["q-80455"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186125002 :question/answer-fields 17592186123034] {:db/id "q-37599/selection/ma-v1/ce2debd9ff9eb68db87fba5b36cdf22f4870544358d9c83bcc8437f3f3eec249/bff652faf672375040820a3f68624738a6e985d951196a27786d69cc53e2b6e2" :answer/id #uuid "3d1bf944-0611-5f56-8eee-824bd856ab81" :answer/type :answer.type/math :answer/value "D=[\\begin{aligned}2 & 0 \\\\ 0 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-37599/selection/ma-v1/ce2debd9ff9eb68db87fba5b36cdf22f4870544358d9c83bcc8437f3f3eec249/f672e45fbea4aa04a2636fa70f16790e00cdb7c16d9976c51e8a2004a64cce58" :answer/id #uuid "47808e53-8f52-5805-acb4-05bc1bab9458" :answer/type :answer.type/math :answer/value "D=[\\begin{aligned}2 & 0 \\\\ 0 & 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-37599/selection/ma-v1/ce2debd9ff9eb68db87fba5b36cdf22f4870544358d9c83bcc8437f3f3eec249/71d1d83f50e6ac639b6a8baa739c64f540133ff8e2420be36d354fe6482ae6d5" :answer/id #uuid "013ffa88-ff96-50ad-ad81-99ede22ff982" :answer/type :answer.type/math :answer/value "D=[\\begin{aligned}-3 & 0 \\\\ 0 & 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-37599/selection/ma-v1/ce2debd9ff9eb68db87fba5b36cdf22f4870544358d9c83bcc8437f3f3eec249/377d333a57989e5591c94f8beb314de8a39ac57a7b8f407c44d1884e7c3b755d" :answer/id #uuid "4ee1c191-9965-57fa-b29c-defa3d0754d1" :answer/type :answer.type/math :answer/value "D=[\\begin{aligned}3 & 0 \\\\ 0 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-37599/selection/ma-v1/ce2debd9ff9eb68db87fba5b36cdf22f4870544358d9c83bcc8437f3f3eec249/fde7c7e8c5c0e1280c4619c1897573fc8396a25055092e595f0052889d677717" :answer/id #uuid "af4703df-10f5-532a-a6da-a9d839ab31f3" :answer/type :answer.type/text :answer/value "$A$ is not diagonalizable" :db/ensure [:answer/validate]} {:db/id "q-37599/selection/ma-v1/ce2debd9ff9eb68db87fba5b36cdf22f4870544358d9c83bcc8437f3f3eec249" :answer-field/id #uuid "8d7376df-56b8-587d-bf29-1b3845502a9b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-37599/selection/ma-v1/ce2debd9ff9eb68db87fba5b36cdf22f4870544358d9c83bcc8437f3f3eec249/bff652faf672375040820a3f68624738a6e985d951196a27786d69cc53e2b6e2" :answer-field/choices ["q-37599/selection/ma-v1/ce2debd9ff9eb68db87fba5b36cdf22f4870544358d9c83bcc8437f3f3eec249/bff652faf672375040820a3f68624738a6e985d951196a27786d69cc53e2b6e2" "q-37599/selection/ma-v1/ce2debd9ff9eb68db87fba5b36cdf22f4870544358d9c83bcc8437f3f3eec249/f672e45fbea4aa04a2636fa70f16790e00cdb7c16d9976c51e8a2004a64cce58" "q-37599/selection/ma-v1/ce2debd9ff9eb68db87fba5b36cdf22f4870544358d9c83bcc8437f3f3eec249/71d1d83f50e6ac639b6a8baa739c64f540133ff8e2420be36d354fe6482ae6d5" "q-37599/selection/ma-v1/ce2debd9ff9eb68db87fba5b36cdf22f4870544358d9c83bcc8437f3f3eec249/377d333a57989e5591c94f8beb314de8a39ac57a7b8f407c44d1884e7c3b755d" "q-37599/selection/ma-v1/ce2debd9ff9eb68db87fba5b36cdf22f4870544358d9c83bcc8437f3f3eec249/fde7c7e8c5c0e1280c4619c1897573fc8396a25055092e595f0052889d677717"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-37599"] :question/problem "Determine if the matrix \n$A=[\\begin{aligned}10 & -4 \\\\ 24 & -10\\end{aligned}]$ \nis diagonalizable or not, and if it is diagonalizable, find a corresponding diagonal matrix $D.$" :question/worked-solution "First, we find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0$:\n\n$$\n\\begin{aligned}|\\begin{aligned}10-\\lambda  & -4 \\\\ 24 & -10-\\lambda \\end{aligned}| & =0 \\\\ (10-\\lambda )(-10-\\lambda )-24\\cdot (-4) & =0 \\\\ {\\lambda }^{2}-4 & =0 \\\\ (\\lambda +2)(\\lambda -2) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues are ${\\lambda }_{1}=2$ and ${\\lambda }_{2}=-2.$ Since we get two distinct eigenvalues, the matrix $A$ is diagonalizable.\n\nNow, we construct the diagonal matrix $D,$ as follows:\n\n$$\nD=[\\begin{aligned}2 & 0 \\\\ 0 & -2\\end{aligned}]\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-37599/selection/ma-v1/ce2debd9ff9eb68db87fba5b36cdf22f4870544358d9c83bcc8437f3f3eec249"] :db/ensure [:question/validate]} {:db/id "q-140053/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "05ea0d80-d8ed-5742-b580-acd17e924317" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-140053/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer/id #uuid "4ed6a480-f8b8-55c5-8817-b1751fbb6d89" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-140053/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "8c75cfe3-9149-5a88-becc-c45ae44dee53" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-140053/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "2d0d929e-1535-5edd-adea-6402afa67fbf" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-140053/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "46e1bdb9-47a0-58f8-83a8-1ef8d065d844" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-140053/selection" :answer-field/id #uuid "49cc2694-4ab7-58b9-8c75-08236df282a4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-140053/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-140053/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" "q-140053/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" "q-140053/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-140053/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-140053/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-140053" :question/id #uuid "7c21ab48-f38e-5c23-b250-b441e717ec06" :question/math-academy-id "q-140053" :question/problem "Consider the following matrices:\n\n$$\nA=[\\begin{aligned}-7 & 15 \\\\ -3 & 7\\end{aligned}],\\,D=[\\begin{aligned}-2 & 0 \\\\ 0 & 2\\end{aligned}],\\,P=[\\begin{aligned}a & 5 \\\\ b & 3\\end{aligned}]\n$$\n\nGiven that $D={P}^{-1}AP,$ find the value of  $\\frac{a}{b}.$" :question/worked-solution "From the diagonal matrix $D=[\\begin{aligned}-2 & 0 \\\\ 0 & 2\\end{aligned}]$, we deduce that the eigenvalues of $A$ are ${\\lambda }_{1}=-2$ and ${\\lambda }_{2}=2.$\n\nSo, the first column of $P$ corresponds to the eigenvalue ${\\lambda }_{1}=-2.$ \n\nNow, we simply need to find an eigenvector that corresponds to ${\\lambda }_{1}=-2.$ Computing $A-(-2)I,$ we get \n\n$$\n\\begin{aligned}A-(-2)I & =[\\begin{aligned}-7 & 15 \\\\ -3 & 7\\end{aligned}]-(-2)[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-5 & 15 \\\\ -3 & 9\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-5 & 15 & 0 \\\\ -3 & 9 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+(-\\frac{3}{5}){R}_{1} \\\\  & ∼[\\begin{aligned}-5 & 15 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\n \n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=3{x}_{2}.$ Hence, the general solution is\n\n$$\n[\\begin{aligned}3{x}_{2} \\\\ {x}_{2}\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nTherefore, setting ${x}_{2}=1,$ we get the eigenvector \n\n$$\n{v}_{2}=[\\begin{aligned}a \\\\ b\\end{aligned}]=[\\begin{aligned}3 \\\\ 1\\end{aligned}].\n$$\n\nFinally, $\\frac{a}{b}=\\frac{3}{1}=3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-140053/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ca18fa52-5494-53ad-bd02-208aba4ff9e1"] :knowledge-point/questions ["q-140053"] :db/ensure [:knowledge-point/validate]} {:db/id "q-80465/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "d496693c-28af-50ba-a40c-8eb67fe4289f" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-80465/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer/id #uuid "55920a21-c36c-57b3-9503-54449e9836b1" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-80465/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "949bd0f6-6537-5193-ace3-8e4cf8d255d6" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-80465/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "4c1af90a-feb6-5e02-9b38-3a0cc348db27" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-80465/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "f596c0f3-dcdb-53f1-b64b-558e865b132a" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-80465/selection" :answer-field/id #uuid "cf0b8cd4-ed48-55ab-afcd-0b50da5216b0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-80465/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-80465/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-80465/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" "q-80465/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" "q-80465/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-80465/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473"] :db/ensure [:answer-field/validate]} {:db/id "q-80465" :question/id #uuid "9ea7ba76-e07f-528a-8aef-3679ad990b53" :question/math-academy-id "q-80465" :question/problem "Consider the following matrices:\n\n$$\nA=[\\begin{aligned}-5 & 2 \\\\ -12 & 5\\end{aligned}],\\,D=[\\begin{aligned}-1 & 0 \\\\ 0 & 1\\end{aligned}],\\,P=[\\begin{aligned}-1 & a \\\\ -2 & b\\end{aligned}]\n$$\n\nGiven that $D={P}^{-1}AP,$ find the value of $\\frac{b}{a}.$" :question/worked-solution "From the diagonal matrix $D=[\\begin{aligned}-1 & 0 \\\\ 0 & 1\\end{aligned}]$, we deduce that the eigenvalues of $A$ are ${\\lambda }_{1}=-1$ and ${\\lambda }_{2}=1.$\n\nSo, the second column of $P$ corresponds to the eigenvalue ${\\lambda }_{2}=1.$ \n\nNow, we simply need to find an eigenvector that corresponds to ${\\lambda }_{2}=1.$ Computing $A-I,$ we get \n\n$$\n\\begin{aligned}A-I & =[\\begin{aligned}-5 & 2 \\\\ -12 & 5\\end{aligned}]-[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-6 & 2 \\\\ -12 & 4\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-6 & 2 & 0 \\\\ -12 & 4 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}-6 & 2 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=\\frac{1}{3}{x}_{2}.$  Hence, the general solution is\n\n$$\n[\\begin{aligned}\\frac{1}{3}{x}_{2} \\\\ {x}_{2}\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nTherefore, setting ${x}_{2}=3,$ we get the eigenvector \n\n$$\n{v}_{2}=[\\begin{aligned}a \\\\ b\\end{aligned}]=[\\begin{aligned}1 \\\\ 3\\end{aligned}].\n$$\n\nFinally, $\\frac{b}{a}=\\frac{3}{1}=3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-80465/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ca18fa52-5494-53ad-bd02-208aba4ff9e1"] :knowledge-point/questions ["q-80465"] :db/ensure [:knowledge-point/validate]} {:db/id "q-80496/selection/a355e3c0dfab0ef37ad17b2b76567b8939ecb537de3710525c1952699a9836af" :answer/id #uuid "a2591bc2-7df2-54e8-87f5-b008dc5fca98" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}1 & 0 \\\\ 0 & -2\\end{aligned}]$ and\n$P=[\\begin{aligned}1 & 1 \\\\ 2 & 1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-80496/selection/40427b9cbd0565dc5f2edc1baba0772e73f40d14ec72853aac37aaf6d29f3f98" :answer/id #uuid "bbdef6ec-05a8-57ba-81ff-830c6a88263f" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}1 & 0 \\\\ 0 & -2\\end{aligned}]$ and\n$P=[\\begin{aligned}1 & -1 \\\\ -2 & -1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-80496/selection/2caf8873a0b6230d1da4479e09489513e971f6209e4cc0bf9afd97773ef077b2" :answer/id #uuid "3ada6dbf-a2b9-5543-82df-a56263a6aaea" :answer/type :answer.type/text :answer/value "$B$ is not diagonalizable" :db/ensure [:answer/validate]} {:db/id "q-80496/selection/7cdc8035c8b1df75a1409828e52096ae672f4cc77076bd8624b23e5333467812" :answer/id #uuid "c319b9ce-e32b-5902-945a-3dfa8b69ea91" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}]$ and\n$P=[\\begin{aligned}1 & -1 \\\\ 2 & -1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-80496/selection/19f4178242e734b359d0168f8d1238bc50b3bb545c4425ea335eeffff0d1cf39" :answer/id #uuid "431ff7b5-a8c3-56f7-aeb1-45757dfd0e21" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}]$ and\n$P=[\\begin{aligned}1 & 1 \\\\ -2 & 1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-80496/selection" :answer-field/id #uuid "be544818-7fcc-5b3a-9023-20e1d3926929" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-80496/selection/a355e3c0dfab0ef37ad17b2b76567b8939ecb537de3710525c1952699a9836af" :answer-field/choices ["q-80496/selection/a355e3c0dfab0ef37ad17b2b76567b8939ecb537de3710525c1952699a9836af" "q-80496/selection/40427b9cbd0565dc5f2edc1baba0772e73f40d14ec72853aac37aaf6d29f3f98" "q-80496/selection/2caf8873a0b6230d1da4479e09489513e971f6209e4cc0bf9afd97773ef077b2" "q-80496/selection/7cdc8035c8b1df75a1409828e52096ae672f4cc77076bd8624b23e5333467812" "q-80496/selection/19f4178242e734b359d0168f8d1238bc50b3bb545c4425ea335eeffff0d1cf39"] :db/ensure [:answer-field/validate]} {:db/id "q-80496" :question/id #uuid "f53e1d4c-a53d-5c3e-8ae8-0e080a8e331f" :question/math-academy-id "q-80496" :question/problem "Find matrices $P$ and $D$ such that $PD{P}^{-1}=B,$ where $D$ is a diagonal matrix and $B=[\\begin{aligned}-5 & 3 \\\\ -6 & 4\\end{aligned}].$" :question/worked-solution "We apply the diagonalization algorithm.\n\n**Step 1.** We need to find the eigenvalues of the matrix $B$ using its characteristic equation $det(B-\\lambda I)=0:$\n\n$$\n\\begin{aligned}|\\begin{aligned}-5-\\lambda  & 3 \\\\ -6 & 4-\\lambda \\end{aligned}| & =0 \\\\ (-5-\\lambda )(4-\\lambda )-3\\cdot (-6) & =0 \\\\ {\\lambda }^{2}+\\lambda -2 & =0 \\\\ (\\lambda -1)(\\lambda +2) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues of $B$ are ${\\lambda }_{1}=1$ and ${\\lambda }_{2}=-2.$ \n\n**Step 2.** Now, we need to find an eigenvector basis of $B.$\n\n- For ${\\lambda }_{1}=1,$ we have\n\n$$\n\\begin{aligned}B-I & =[\\begin{aligned}-5 & 3 \\\\ -6 & 4\\end{aligned}]-[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-6 & 3 \\\\ -6 & 3\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-6 & 3 & 0 \\\\ -6 & 3 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼[\\begin{aligned}-6 & 3 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=\\frac{1}{2}{x}_{2}.$  Hence, the general solution is\n\n$$\n[\\begin{aligned}\\frac{1}{2}{x}_{2} \\\\ {x}_{2}\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nSetting ${x}_{2}=2,$ we get the eigenvector ${v}_{1}=[\\begin{aligned}1 \\\\ 2\\end{aligned}].$\n\n- For ${\\lambda }_{2}=-2,$ we have\n\n$$\n\\begin{aligned}B-(-2)I & =[\\begin{aligned}-5 & 3 \\\\ -6 & 4\\end{aligned}]-(-2)[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 3 \\\\ -6 & 6\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-3 & 3 & 0 \\\\ -6 & 6 & 0\\end{aligned}] & {R}_{2} & ={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}-3 & 3 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}={x}_{2}.$ Hence, the general solution is\n\n$$\n[\\begin{aligned}{x}_{2} \\\\ {x}_{2}\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nSetting ${x}_{2}=1,$ we get the eigenvector ${v}_{2}=[\\begin{aligned}1 \\\\ 1\\end{aligned}].$\n\n**Step 3.** We construct the diagonal matrix $D$ and the invertible matrix $P$ as follows:\n\n$$\nD=[\\begin{aligned}1 & 0 \\\\ 0 & -2\\end{aligned}],\\,P=[\\begin{aligned}1 & 1 \\\\ 2 & 1\\end{aligned}]\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-80496/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0ff6446e-7913-5d55-adfd-124649f3f1c0"] :knowledge-point/questions ["q-80496"] :db/ensure [:knowledge-point/validate]} {:db/id "q-80493/selection/d93c8934a0d7b12253aa0fca9552f9541403472c6629c9f59391c19532ddf021" :answer/id #uuid "259e4ebc-b9cb-5c55-be35-4c02a1a58142" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}2 & 0 \\\\ 0 & -2\\end{aligned}]$ and $P=[\\begin{aligned}1 & -2 \\\\ 0 & -1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-80493/selection/45d6dd55af3df7a287933f6ca3ae2b0380ceefa509b04963b5286bf3e0152377" :answer/id #uuid "1aa3f5e6-34ca-5527-bf94-15d4078be3c8" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}3 & 0 \\\\ 0 & 2\\end{aligned}]$ and $P=[\\begin{aligned}-1 & -2 \\\\ 0 & 1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-80493/selection/3cdd1e6c6e7bd3af08f38ad98d35efd2c56746d21fe0d53f59051ff0fcbb27b3" :answer/id #uuid "9655b0d7-ff30-5b71-8896-d548cc1640c9" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}2 & 0 \\\\ 0 & 3\\end{aligned}]$ and $P=[\\begin{aligned}1 & 2 \\\\ 0 & 1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-80493/selection/c509ec9414fdcf1a804ea20ada67bce75456d847c579d2630e5f20c4608b50f6" :answer/id #uuid "3acc888d-701f-54d6-8ee4-df0d0249b48c" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}-3 & 0 \\\\ 0 & -2\\end{aligned}]$ and $P=[\\begin{aligned}1 & -2 \\\\ 0 & 1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-80493/selection/bfac9699d7575303366d481e8da33c3cc9efbf4277cc9f15509df9ec060ca3c2" :answer/id #uuid "e33a854f-8165-5bd7-a7a9-f146d4dee9ad" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}-2 & 0 \\\\ 0 & -3\\end{aligned}]$ and $P=[\\begin{aligned}-1 & -3 \\\\ 0 & 1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-80493/selection" :answer-field/id #uuid "1fee65d7-f331-5c0a-a85c-18a138015b6e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-80493/selection/c509ec9414fdcf1a804ea20ada67bce75456d847c579d2630e5f20c4608b50f6" :answer-field/choices ["q-80493/selection/d93c8934a0d7b12253aa0fca9552f9541403472c6629c9f59391c19532ddf021" "q-80493/selection/45d6dd55af3df7a287933f6ca3ae2b0380ceefa509b04963b5286bf3e0152377" "q-80493/selection/3cdd1e6c6e7bd3af08f38ad98d35efd2c56746d21fe0d53f59051ff0fcbb27b3" "q-80493/selection/c509ec9414fdcf1a804ea20ada67bce75456d847c579d2630e5f20c4608b50f6" "q-80493/selection/bfac9699d7575303366d481e8da33c3cc9efbf4277cc9f15509df9ec060ca3c2"] :db/ensure [:answer-field/validate]} {:db/id "q-80493" :question/id #uuid "7be4462e-3d0b-5745-b83e-db8e5d74f57e" :question/math-academy-id "q-80493" :question/problem "Given the matrix \n$A=[\\begin{aligned}-3 & -2 \\\\ 0 & -2\\end{aligned}]$, \nfind a diagonal matrix $D$ and an invertible matrix $P$ such that $D={P}^{-1}AP.$" :question/worked-solution "We apply the diagonalization algorithm.\n\n**Step 1.**  We need to find the eigenvalues of the matrix. Since matrix $A$ is triangular, its eigenvalues are the entries on the main diagonal: \n\n$\\,$ ${\\lambda }_{1}=-3\\,$ and $\\,{\\lambda }_{2}=-2$\n\n**Step 2.** Now, we need to find an eigenvector basis of $A.$\n\n- For ${\\lambda }_{1}=-3,$ we have\n\n$$\n\\begin{aligned}A-(-3)I & =[\\begin{aligned}-3 & -2 \\\\ 0 & -2\\end{aligned}]+3[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}0 & -2 \\\\ 0 & 1\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}0 & -2 & 0 \\\\ 0 & 1 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}0 & -2 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $2$nd one). Thus, ${x}_{1}$ is a free variable. From the first equation, we obtain ${x}_{2}=0.$ Hence, the general solution is\n\n$$\n[\\begin{aligned}{x}_{1} \\\\ 0\\end{aligned}],\\,{x}_{1}\\in R.\n$$\n\nSetting ${x}_{1}=1,$ we get the eigenvector ${v}_{1}=[\\begin{aligned}1 \\\\ 0\\end{aligned}].$\n\n- For ${\\lambda }_{2}=-2,$ we have\n\n$$\n\\begin{aligned}A-(-2)I & =[\\begin{aligned}-3 & -2 \\\\ 0 & -2\\end{aligned}]+2[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & -2 \\\\ 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have a homogeneous system of linear equations with the matrix as above. Note, the matrix is already in row echelon form. There is one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=-2{x}_{2}.$ Hence, the general solution is\n\n$$\n[\\begin{aligned}-2{x}_{2} \\\\ {x}_{2}\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nSetting ${x}_{2}=1,$ we get the eigenvector ${v}_{2}=[\\begin{aligned}-2 \\\\ 1\\end{aligned}].$\n\n**Step 3.** We construct the diagonal matrix $D$ and the invertible matrix $P$ as follows:\n\n$$\nD=[\\begin{aligned}-3 & 0 \\\\ 0 & -2\\end{aligned}],\\,P=[\\begin{aligned}1 & -2 \\\\ 0 & 1\\end{aligned}]\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-80493/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0ff6446e-7913-5d55-adfd-124649f3f1c0"] :knowledge-point/questions ["q-80493"] :db/ensure [:knowledge-point/validate]} {:db/id "q-80481/selection/7ccbe675eff4bb7584d771b02759dd8a0dae309fbc513d6322b50980fd44af68" :answer/id #uuid "b264a505-02ff-523c-a125-855f270feafb" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}0 & 0 \\\\ 0 & 1\\end{aligned}]$ and\n$P=[\\begin{aligned}-2 & 3 \\\\ -1 & -1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-80481/selection/566d82cd1269e57b77dd5db9c9ab763104cf0a5865df5bb3db19e723479686ee" :answer/id #uuid "42d504c7-a3ac-5dd0-bb2a-d8aab7beac8c" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}]$ and\n$P=[\\begin{aligned}2 & 1 \\\\ -1 & -1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-80481/selection/e9d9e2ec96defdbde5580292edaf54e8818a21dbb4d7a4d66e02595c54423039" :answer/id #uuid "cd833863-bf04-5bb6-badc-a92eeab74d8b" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}2 & 0 \\\\ 0 & -1\\end{aligned}]$ and\n$P=[\\begin{aligned}2 & 1 \\\\ -1 & 1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-80481/selection/9184218f6069c8086ac3e2b9a0e505b950b66f5155325032758fd7649bfb5cd0" :answer/id #uuid "05ede404-6c42-5201-a435-2e2625c0c828" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}0 & 0 \\\\ 0 & -1\\end{aligned}]$ and\n$P=[\\begin{aligned}2 & 1 \\\\ -1 & -1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-80481/selection/904d4458006da53fd846ce2d05a074642baca060525e1385038ebe240127205b" :answer/id #uuid "4cf7b029-197f-5c22-8027-c23d4ab52527" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}0 & 0 \\\\ 0 & -1\\end{aligned}]$ and\n$P=[\\begin{aligned}2 & 0 \\\\ -1 & -1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-80481/selection" :answer-field/id #uuid "a42908e5-bbad-56ec-8b40-f5c48c9fa003" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-80481/selection/9184218f6069c8086ac3e2b9a0e505b950b66f5155325032758fd7649bfb5cd0" :answer-field/choices ["q-80481/selection/7ccbe675eff4bb7584d771b02759dd8a0dae309fbc513d6322b50980fd44af68" "q-80481/selection/566d82cd1269e57b77dd5db9c9ab763104cf0a5865df5bb3db19e723479686ee" "q-80481/selection/e9d9e2ec96defdbde5580292edaf54e8818a21dbb4d7a4d66e02595c54423039" "q-80481/selection/9184218f6069c8086ac3e2b9a0e505b950b66f5155325032758fd7649bfb5cd0" "q-80481/selection/904d4458006da53fd846ce2d05a074642baca060525e1385038ebe240127205b"] :db/ensure [:answer-field/validate]} {:db/id "q-80481" :question/id #uuid "8c2274ed-dabb-593f-8fb6-7485c1ae4322" :question/math-academy-id "q-80481" :question/problem "Find matrices $P$ and $D$ such that $PD{P}^{-1}=B,$ where $D$ is a diagonal matrix and $B=[\\begin{aligned}1 & 2 \\\\ -1 & -2\\end{aligned}].$" :question/worked-solution "We apply the diagonalization algorithm.\n\n**Step 1.** We need to find the eigenvalues of the matrix $B$ using its characteristic equation $det(B-\\lambda I)=0:$\n\n$$\n\\begin{aligned}|\\begin{aligned}1-\\lambda  & 2 \\\\ -1 & -2-\\lambda \\end{aligned}| & =0 \\\\ (1-\\lambda )(-2-\\lambda )-2\\cdot (-1) & =0 \\\\ {\\lambda }^{2}+\\lambda  & =0 \\\\ \\lambda (\\lambda +1) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues of $B$ are ${\\lambda }_{1}=0$ and ${\\lambda }_{2}=-1.$ \n\n**Step 2.** Now, we need to find an eigenvector basis of $B.$\n\n- For ${\\lambda }_{1}=0,$ we have\n\n$$\n\\begin{aligned}B-0I & =[\\begin{aligned}1 & 2 \\\\ -1 & -2\\end{aligned}]-0[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 \\\\ -1 & -2\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 2 & 0 \\\\ -1 & -2 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=-2{x}_{2}.$ Hence, the general solution is\n\n$$\n[\\begin{aligned}-2{x}_{2} \\\\ {x}_{2}\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nSetting ${x}_{2}=-1,$ we get the eigenvector ${v}_{1}=[\\begin{aligned}2 \\\\ -1\\end{aligned}].$\n\n- For ${\\lambda }_{2}=-1,$ we have\n\n$$\n\\begin{aligned}B-(-1)I & =[\\begin{aligned}1 & 2 \\\\ -1 & -2\\end{aligned}]-(-1)[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 2 \\\\ -1 & -1\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}2 & 2 & 0 \\\\ -1 & -1 & 0\\end{aligned}] & {R}_{2} & ={R}_{2}+(\\frac{1}{2}){R}_{1} \\\\  & ∼[\\begin{aligned}2 & 2 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=-{x}_{2}.$ Hence, the general solution is\n\n$$\n[\\begin{aligned}-{x}_{2} \\\\ {x}_{2}\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nSetting ${x}_{2}=-1,$ we get the eigenvector ${v}_{2}=[\\begin{aligned}1 \\\\ -1\\end{aligned}].$\n\n**Step 3.** We construct the diagonal matrix $D$ and the invertible matrix $P$ as follows:\n\n$$\nD=[\\begin{aligned}0 & 0 \\\\ 0 & -1\\end{aligned}],\\,P=[\\begin{aligned}2 & 1 \\\\ -1 & -1\\end{aligned}]\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-80481/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0ff6446e-7913-5d55-adfd-124649f3f1c0"] :knowledge-point/questions ["q-80481"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-8575"] :question/problem "Consider the matrix ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069391/assets/513e5adf220f2bce1441beb318dd9a731f83a292f45d51f0f8c333dbb89a9b93.png) You're given that $\\lambda_1=4$ and $\\lambda_2=3$ are the eigenvalues of $A,$ and\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069391/assets/6478455f2e5fcd99530dea4dae13f5df9a50208ccd53166a99249d4d5b722530.png) ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069391/assets/a4c0d2bb4a988598d60a45f605261c8b4d5bb30922251d821990f3464c2d56b4.png) are the respective eigenvectors. Find the matrices $P$ and $D$ such that $PDP^{-1} = A,$ where $D$ is a diagonal matrix." :question/worked-solution "Since the eigenvalues of the matrix are $\\lambda_1={\\color{blue}4}$ and $\\lambda_2={\\color{red}3},$ we construct the diagonal matrix $D$ by writing the eigenvalues in the main diagonal:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069391/assets/2dd66c70838ad6604661616c9bdbe3ce2e6293131084e4330b8e65dd39749f45.png)\n\nNow, to construct the matrix $P,$ we simply write the respective eigenvectors as columns: \n\n- the $1$st column is the eigenvector corresponding to $\\lambda_1={\\color{blue}4},$ and\n\n- the $2$nd column is the eigenvector corresponding to $\\lambda_2={\\color{red}3}.$\n\nTherefore, we get\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069391/assets/f811ea4fc7419e4afd395f1832dddc98e6b4829c6a24a34d5fd51c402767a51b.png)" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8572"] :question/problem "Determine if the matrix\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069391/assets/dfc9ee546f72ad68cf116b8f67d165ba9b6ff6e77dce88f145dda93f13091441.png)\nis diagonalizable or not, and if it is diagonalizable, find a corresponding diagonal matrix $D.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8573"] :question/problem "Consider the following matrices:\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069391/assets/7126688b8500e60258d29ab4b1b323ac956ad41b530c5723bcc71d60b11e73a0.png)\nGiven that $D=P^{-1}AP,$ find the value of $\\dfrac{a}{b}.$" :question/worked-solution "From the diagonal matrix ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069391/assets/f3460b47901f79529216c1440403e2115ff9047cb997070893b241cd938728de.png) we deduce that the eigenvalues of $A$ are $\\lambda_1=5$ and $\\lambda_2=-1.$\n\nSo, the second column of $P$ corresponds to the eigenvalue $\\lambda_2=-1.$ \n\nNow, we simply need to find an eigenvector that corresponds to $\\lambda_2=-1.$ Computing $A-(-1)I,$ we get  \n\n$$\n\\begin{aligned}A-(-1)I & =[\\begin{aligned}1 & 4 \\\\ 2 & 3\\end{aligned}]+[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 4 \\\\ 2 & 4\\end{aligned}].\\end{aligned}\n$$\n\nTo solve the corresponding system of linear equations, we construct the augmented matrix $M$ and reduce it to its row echelon form using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}2 & 4 & 0 \\\\ 2 & 4 & 0\\end{aligned}] & {R}_{2}={R}_{2}+(-1){R}_{1} \\\\  & ∼[\\begin{aligned}2 & 4 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). So, $x_2$ is a free variable. From the first equation, we obtain $x_1= -{2}x_2.$ Therefore, the general solution is\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069391/assets/95d1bcb284138711bcf5afddb3f09c702e664fbdc7b256b0eaf81044f87403cf.png)\n\nBy setting $x_2=1,$ we get the eigenvector \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069391/assets/898d72a1a0cc123d1ff7ecb4c8d02f6951739a9498e36ff14ee44cb322952fb6.png)\n\nFinally, $\\dfrac{a}{b}=\\dfrac{-2}{1} = -2.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8574"] :question/problem "Given the matrix \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069391/assets/8921e351c90855b6bf113a057eaa7e3ab97fbba8f22254463d894e7c4f89a4ed.png) \nfind a diagonal matrix $D$ and an invertible matrix $P$ such that $D=P^{-1}AP.$" :question/worked-solution "We apply the diagonalization algorithm. \n\n**Step 1.**  We need to find the eigenvalues of the matrix. Since matrix $A$ is triangular, its eigenvalues are the entries on the main diagonal: \n\n$$\n\\lambda_1=3, \\quad\\quad\\lambda_2=-2.\n$$\n\n**Step 2.** Now, we need to find an eigenvector basis of $A.$\n\n- For $\\lambda_1=3,$ we have\n\n$$\n\\begin{aligned}A-3I & =[\\begin{aligned}3 & -8 \\\\ 0 & -2\\end{aligned}]-3[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}0 & -8 \\\\ 0 & -5\\end{aligned}].\\end{aligned}\n$$\n\nTo solve the corresponding system of linear equations, we construct the augmented matrix $M$ and reduce it to its row echelon form using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}0 & -8 & 0 \\\\ 0 & -5 & 0\\end{aligned}] & {R}_{2}={R}_{2}+(-\\frac{5}{8}){R}_{1} \\\\  & ∼[\\begin{aligned}0 & -8 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $2$nd one). So, $x_1$ is a free variable. From the first equation, we obtain $x_2=0.$ Therefore, the general solution is\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069391/assets/ff2073ee3866cfd3b40084ed4e676cc57554d9cd02b9d6e26cb7808f127fc56c.png)\nSetting $x_1=1,$ we get the eigenvector ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069391/assets/55c840d71fa907a9b372801123fdc7f19be810f2f489a2b167b0860c84d1c2cc.png)\n\n- For $\\lambda_2=-2,$ we have\n\n$$\n\\begin{aligned}A-(-2)I & =[\\begin{aligned}3 & -8 \\\\ 0 & -2\\end{aligned}]+2[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}5 & -8 \\\\ 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nThe above matrix corresponds to a homogeneous system of linear equations. Note, the matrix is already in row echelon form. There is one pivot column (the $1$st one). So, $x_2$ is a free variable. From the first equation, we obtain $x_1=\\dfrac{8}{5}x_2.$ Therefore, the general solution is\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069391/assets/3d52ed0fc48e2e20d268b6a49b099f8e3165f25707fa36aaf93c0e8b0a2c3b16.png)\nSetting  $x_2=5,$ we get the eigenvector  ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069391/assets/ebb90bd7e57a148040b69a9fd6fd7d4f1b253e63734617e4e57b5177d7f9cda9.png)\n\n**Step 3.** We construct the diagonal matrix $D$ and the invertible matrix $P$ as follows:\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069391/assets/4e04b534ec76c446059ca5119822b7aa299e0ea24c0e842de64a976954a733f8.png)" :db/ensure [:question/validate]}]
