 17592186360869} {:answer/id #uuid "d5bc75c8-98e1-5886-996e-8432e451273b" :answer/type {:db/ident :answer.type/text} :answer/value "$a=-2,$ $b=1,$ and $c=7$" :db/id #edb/ref 17592186360870} {:answer/id #uuid "eabc05e8-0f13-52f3-a20d-33e299d0383a" :answer/type {:db/ident :answer.type/text} :answer/value "$a=1,$ $b=-2,$ and $c=7$" :db/id #edb/ref 17592186360871} {:answer/id #uuid "1cb1a970-d006-57f7-a4ec-c974fb122438" :answer/type {:db/ident :answer.type/text} :answer/value "$a=-2,$ $b=7,$ and $c=1$" :db/id #edb/ref 17592186360872}] :answer-field/correct {:answer/id #uuid "1cb1a970-d006-57f7-a4ec-c974fb122438" :answer/type {:db/ident :answer.type/text} :answer/value "$a=-2,$ $b=7,$ and $c=1$" :db/id #edb/ref 17592186360872} :answer-field/id #uuid "db5efeeb-a4d9-554b-bbb5-3c05882a4a3c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360867}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "5e995591-79aa-5800-bd07-e99e51f5d9cb" :question/math-academy-id "q-80373" :question/problem "Consider the matrix $H$ for which ${\\lambda }_{1}=4$ and ${\\lambda }_{2}=-2$ are eigenvalues, and\n\n$$\n{v}_{1}=[\\begin{aligned}5 \\\\ 7\\end{aligned}],\\,{v}_{2}=[\\begin{aligned}-3 \\\\ 1\\end{aligned}]\n$$\n\nare the respective eigenvectors. What are the values of $a,b,c$ given that\n\n$$\nH=[\\begin{aligned}5 & -3 \\\\ b & c\\end{aligned}][\\begin{aligned}4 & 0 \\\\ 0 & a\\end{aligned}]{[\\begin{aligned}5 & -3 \\\\ b & c\\end{aligned}]}^{-1}?\n$$" :question/worked-solution "Since the eigenvalues of the matrix are ${\\lambda }_{1}=4$ and ${\\lambda }_{2}=-2,$ we construct the diagonal matrix $D$ by writing the eigenvalues in the main diagonal:\n\n$$\nD=[\\begin{aligned}4 & 0 \\\\ 0 & -2\\end{aligned}].\n$$\n\nNow, to construct the matrix $P,$ we simply write the respective eigenvectors as columns: \n\n- the $1$st column is the eigenvector corresponding to ${\\lambda }_{1}=4,$ and\n\n- the $2$nd column is the eigenvector corresponding to ${\\lambda }_{2}=-2.$\n\nTherefore, we get\n\n$$\nP=[\\begin{aligned}5 & -3 \\\\ 7 & 1\\end{aligned}].\n$$\n\nFinally, we obtain\n\n$$\nH=[\\begin{aligned}5 & -3 \\\\ 7 & 1\\end{aligned}][\\begin{aligned}4 & 0 \\\\ 0 & -2\\end{aligned}]{[\\begin{aligned}5 & -3 \\\\ 7 & 1\\end{aligned}]}^{-1}.\n$$\n\n \n\nIn conclusion, we get  $a=-2,$ $b=7,$ and $c=1.$"}] [{:db/id #edb/ref 17592186306300 :knowledge-point/_questions [{:knowledge-point/id #uuid "5164c6cb-aef0-554b-b361-77245991c0ea" :knowledge-point/title "Diagonalizing a 2x2 Matrix Given Its Eigenvalues"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "629a0baa-dc7e-5342-9844-6a3d285087a6" :answer/type {:db/ident :answer.type/text} :answer/value "$D=[\\begin{aligned}3 & 0 \\\\ 0 & -6\\end{aligned}]$ and \n$P=[\\begin{aligned}1 & 2 \\\\ 1 & 1\\end{aligned}]$" :db/id #edb/ref 17592186306302} {:answer/id #uuid "8b868259-d51e-56a7-b9e4-714a37a2a3dd" :answer/type {:db/ident :answer.type/text} :answer/value "$D=[\\begin{aligned}-6 & 0 \\\\ 0 & -3\\end{aligned}]$ and \n$P=[\\begin{aligned}1 & 1 \\\\ 1 & -2\\end{aligned}]$" :db/id #edb/ref 17592186306303} {:answer/id #uuid "7645a980-b29d-5fe8-bd7c-485982bee7c9" :answer/type {:db/ident :answer.type/text} :answer/value "$D=[\\begin{aligned}-3 & 0 \\\\ 0 & -6\\end{aligned}]$ and \n$P=[\\begin{aligned}1 & 2 \\\\ 1 & 1\\end{aligned}]$" :db/id #edb/ref 17592186306304} {:answer/id #uuid "f94b1b57-4526-5515-963d-1874737b1f2d" :answer/type {:db/ident :answer.type/text} :answer/value "$D=[\\begin{aligned}3 & 0 \\\\ 0 & 6\\end{aligned}]$ and \n$P=[\\begin{aligned}1 & 2 \\\\ 1 & -1\\end{aligned}]$" :db/id #edb/ref 17592186306305} {:answer/id #uuid "d0ab0081-9309-5329-9339-c7eef19c7ead" :answer/type {:db/ident :answer.type/text} :answer/value "$D=[\\begin{aligned}6 & 0 \\\\ 0 & 3\\end{aligned}]$ and \n$P=[\\begin{aligned}2 & 1 \\\\ 1 & -1\\end{aligned}]$" :db/id #edb/ref 17592186306306}] :answe