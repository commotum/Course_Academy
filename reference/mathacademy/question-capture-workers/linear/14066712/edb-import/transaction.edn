d{aligned}\n$$\n\nNow, we substitute these into our quadratic form expression:\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}+{x}_{1}{x}_{2}-2{x}_{2}^{2} \\\\  & =(5{y}_{1}+{y}_{2})^{2}+(5{y}_{1}+{y}_{2})(-2{y}_{2})-2(-2{y}_{2})^{2} \\\\  & =25{y}_{1}^{2}+10{y}_{1}{y}_{2}+{y}_{2}^{2}-10{y}_{1}{y}_{2}-2{y}_{2}^{2}-8{y}_{2}^{2} \\\\  & =25{y}_{1}^{2}-9{y}_{2}^{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-94134/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f203c9bf-7d12-56db-aafe-6639162eae93"] :knowledge-point/questions ["q-94134"] :db/ensure [:knowledge-point/validate]} {:db/id "q-94153/selection/20419ba8a92ce1161f224bfc16240e550ab8b80a1f9b689dd5b1faa0dbfd0fae" :answer/id #uuid "6c906761-c331-57e9-8ef9-f459f00d1306" :answer/type :answer.type/math :answer/value "2{y}_{1}^{2}+4{y}_{2}{y}_{1}-{y}_{2}^{2}" :db/ensure [:answer/validate]} {:db/id "q-94153/selection/e4d3ddab74a27f8a3feba9fd9987a96e28ca1c34ccd73790dd069fa6297507b8" :answer/id #uuid "dfb6fe60-22e6-5b12-a6c8-8a86773ceac8" :answer/type :answer.type/math :answer/value "{y}_{1}^{2}-4{y}_{2}{y}_{1}+{y}_{2}^{2}" :db/ensure [:answer/validate]} {:db/id "q-94153/selection/05fc2ce8ebe01e6ead0a3166d88a81c7d118527d17c8a7fe4e9f17a1d5f76f3f" :answer/id #uuid "749e15c2-5092-53b6-8ff0-ec292e42fe73" :answer/type :answer.type/math :answer/value "{y}_{1}^{2}-{y}_{2}^{2}" :db/ensure [:answer/validate]} {:db/id "q-94153/selection/2eafa49e0f3f7da91bad6a816323246a384178e2e22a4c203bfa7d057d3f59a4" :answer/id #uuid "12b838b2-0a00-569f-84a5-4737fed8fb5a" :answer/type :answer.type/math :answer/value "2{y}_{1}^{2}+2{y}_{2}^{2}" :db/ensure [:answer/validate]} {:db/id "q-94153/selection/be2a743bd920c5c1850a1efb436bc98a294a5d0e42723a5734ea08d0a18f62b9" :answer/id #uuid "47600653-3633-5ccd-9323-07e29bba608c" :answer/type :answer.type/math :answer/value "{y}_{1}^{2}+4{y}_{2}{y}_{1}" :db/ensure [:answer/validate]} {:db/id "q-94153/selection" :answer-field/id #u