{x}_{1}-{x}_{2}\\end{aligned}\n$$\n\nBy solving the first equation for ${x}_{1}$ and substituting it into the second equation, we obtain the following expressions for ${x}_{1}$ and ${x}_{2}:$\n\n$$\n\\begin{aligned}{x}_{1} & ={y}_{1} \\\\ {x}_{2} & =-{y}_{1}-{y}_{2}\\end{aligned}\n$$\n\nNow, we substitute these into our quadratic form expression:\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}+5{x}_{1}{x}_{2}-{x}_{2}^{2} \\\\  & ={y}_{1}^{2}+5{y}_{1}(-{y}_{1}-{y}_{2})-(-{y}_{1}-{y}_{2})^{2} \\\\  & ={y}_{1}^{2}-5{y}_{1}^{2}-5{y}_{1}{y}_{2}-{y}_{1}^{2}-2{y}_{1}{y}_{2}-{y}_{2}^{2} \\\\  & =-5{y}_{1}^{2}-7{y}_{1}{y}_{2}-{y}_{2}^{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-94166/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9f2a5391-d8bb-5084-941a-bb787e8729f3"] :knowledge-point/questions ["q-94166"] :db/ensure [:knowledge-point/validate]} {:db/id "q-140939/selection/a6b7d2bcb564affe7794043067f1ea408a6112913d4004d116bc92dff4c4e2dd" :answer/id #uuid "1133b61b-1568-5b15-912b-d15af9380b12" :answer/type :answer.type/math :answer/value "{y}_{1}^{2}-4{y}_{1}{y}_{2}+4{y}_{2}^{2}" :db/ensure [:answer/validate]} {:db/id "q-140939/selection/e29ebd1b3265389be000e84724fc073a84ea24aa9226c0500736788125d0195c" :answer/id #uuid "09c53798-4722-56f6-b361-8f516d66bc82" :answer/type :answer.type/math :answer/value "-{y}_{1}^{2}+3{y}_{1}{y}_{2}" :db/ensure [:answer/validate]} {:db/id "q-140939/selection/cc150c46e933191b9a2b9434e466b5f66d638932b7f5649096f20a0390611d6a" :answer/id #uuid "94b2f8c9-6f0b-556f-a20e-34be1f8da17d" :answer/type :answer.type/math :answer/value "{y}_{1}^{2}+5{y}_{1}{y}_{2}" :db/ensure [:answer/validate]} {:db/id "q-140939/selection/dfb220671f38bd2feea20d8bbcf71c14bb90054e0040d6c4c765f6a2694f86b5" :answer/id #uuid "8e607860-ecb5-5d41-a52a-3f848791f3be" :answer/type :answer.type/math :answer/value "-{y}_{1}^{2}+3{y}_{1}{y}_{2}+8{y}_{2}^{2}" :db/ensure [:answer/validate]} {:db/id "q-140939/selection/dc43ab8b7dec10d730b058586fe9307fd81a910eafddbdc30755f0462cf3f141" :answer/id #uuid "8bffbd28-1314-5e4d-adcb-b5d715ec772b" :answer/type :answer.type/math :answer/value "{y}_{1}^{2}+4{y}_{1}{y}_{2}-8{y}_{2}^{2}" :db/ensure [:answer/validate]} {:db/id "q-140939/selection" :answer-field/id #uuid "4ff5100a-99ce-54e0-9d96-e7d247c2c4f2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-140939/selection/e29ebd1b3265389be000e84724fc073a84ea24aa9226c0500736788125d0195c" :answer-field/choices ["q-140939/selection/a6b7d2bcb564affe7794043067f1ea408a6112913d4004d116bc92dff4c4e2dd" "q-140939/selection/e29ebd1b3265389be000e84724fc073a84ea24aa9226c0500736788125d0195c" "q-140939/selection/cc150c46e933191b9a2b9434e466b5f66d638932b7f5649096f20a0390611d6a" "q-140939/selection/dfb220671f38bd2feea20d8bbcf71c14bb90054e0040d6c4c765f6a2694f86b5" "q-140939/selection/dc43ab8b7dec10d730b058586fe9307fd81a910eafddbdc30755f0462cf3f141"] :db/ensure [:answer-field/validate]} {:db/id "q-140939" :question/id #uuid "43caec47-3f60-556e-94f0-5da8ae1b32dc" :question/math-academy-id "q-140939" :question/problem "Given that \n\n$$\n[\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]=[\\begin{aligned}-2 & 1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],\n$$\n\n express the quadratic form $Q(x)=2{x}_{1}^{2}+{x}_{1}{x}_{2}-{x}_{2}^{2}$ in terms of the components of $y.$" :question/worked-solution "First, notice that \n\n$$\n[\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]=[\\begin{aligned}-2 & 1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]\n$$\n\ngives the following expressions for ${y}_{1}$ and ${y}_{2}:$\n\n$$\n\\begin{aligned}{y}_{1} & =-2{x}_{1}+{x}_{2} \\\\ {y}_{2} & =-{x}_{1}\\end{aligned}\n$$\n\nBy solving the second equation for ${x}_{1}$ and substituting it into the first equation, we obtain the following expressions for ${x}_{1}$ and ${x}_{2}:$\n\n$$\n\\begin{aligned}{x}_{1} & =-{y}_{2} \\\\ {x}_{2} & ={y}_{1}-2{y}_{2}\\end{aligned}\n$$\n\nNow, we substitute these into our quadratic form expression:\n\n$$\n\\begin{aligned}Q(x) & =2{x}_{1}^{2}+{x}_{1}{x}_{2}-{x}_{2}^{2} \\\\  & =2(-{y}_{2})^{2}+(-{y}_{2})({y}_{1}-2{y}_{2})-({y}_{1}-2{y}_{2})^{2} \\\\  & =2{y}_{2}^{2}-{y}_{2}{y}_{1}+2{y}_{2}^{2}-{y}_{1}^{2}+4{y}_{1}{y}_{2}-4{y}_{2}^{2} \\\\  & =-{y}_{1}^{2}+3{y}_{1}{y}_{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-140939/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9f2a5391-d8bb-5084-941a-bb787e8729f3"] :knowledge-point/questions ["q-140939"] :db/ensure [:knowledge-point/validate]} {:db/id "q-94176/selection/168a3fc325c1a5e4f2a53efb15741cba2c69792172b6de41ef6b4284e5fd98a2" :answer/id #uuid "114971c4-fbc5-5a43-a26c-51c4288728f8" :answer/type :answer.type/math :answer/value "{y}_{1}^{2}-2{y}_{1}{y}_{2}-{y}_{2}^{2}" :db/ensure [:answer/validate]} {:db/id "q-94176/selection/24ab8b276241041b90381be1687cbb6858ebeaebba5f559a08f7e66abab338db" :answer/id #uuid "954a926c-0d12-5798-948f-9435092f1aac" :answer/type :answer.type/math :answer/value "2{y}_{1}^{2}-4{y}_{1}{y}_{2}+{y}_{2}^{2}" :db/ensure [:answer/validate]} {:db/id "q-94176/selection/a020c2a3aba27df2188597b6ff2e92b0704a5da0d644ea867e9ededd59cd635b" :answer/id #uuid "87cb4652-34cc-5da3-9756-3ee658a54da3" :answer/type :answer.type/math :answer/value "{y}_{1}^{2}+4{y}_{1}{y}_{2}+2{y}_{2}^{2}" :db/ensure [:answer/validate]} {:db/id "q-94176/selection/5c029b6fc348003359a5c7aa69b8a58a5d818230d652361b34de10db3b12fdb5" :answer/id #uuid "7384b10f-968a-59db-9974-54fd92e9a51e" :answer/type :answer.type/math :answer/value "-2{y}_{1}{y}_{2}-6{y}_{2}^{2}" :db/ensure [:answer/validate]} {:db/id "q-94176/selection/0bf4151ca9ccb27889d06194b75f004efb9ab9f729f76dd1756270dc40961357" :answer/id #uuid "f2497136-6d0a-590f-afac-afd2914e450d" :answer/type :answer.type/math :answer/value "{y}_{1}^{2}-4{y}_{1}{y}_{2}-{y}_{2}^{2}" :db/ensure [:answer/validate]} {:db/id "q-94176/selection" :answer-field/id #uuid "f30638e4-2085-52ec-9011-26aea6db2e9d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-94176/selection/0bf4151ca9ccb27889d06194b75f004efb9ab9f729f76dd1756270dc40961357" :answer-field/choices ["q-94176/selection/168a3fc325c1a5e4f2a53efb15741cba2c69792172b6de41ef6b4284e5fd98a2" "q-94176/selection/24ab8b276241041b90381be1687cbb6858ebeaebba5f559a08f7e66abab338db" "q-94176/selection/a020c2a3aba27df2188597b6ff2e92b0704a5da0d644ea867e9ededd59cd635b" "q-94176/selection/5c029b6fc348003359a5c7aa69b8a58a5d818230d652361b34de10db3b12fdb5" "q-94176/selection/0bf4151ca9ccb27889d06194b75f004efb9ab9f729f76dd1756270dc40961357"] :db/ensure [:answer-field/validate]} {:db/id "q-94176" :question/id #uuid "925562cf-2357-52e7-ac4c-39ebef5b8eb5" :question/math-academy-id "q-94176" :question/problem "Given that \n\n$$\n[\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]=[\\begin{aligned}-1 & -1 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],\n$$\n\n express the quadratic form $Q(x)={x}_{1}^{2}-2{x}_{1}{x}_{2}-4{x}_{2}^{2}$ in terms of the components of $y.$" :question/worked-solution "First, notice that \n\n$$\n[\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]=[\\begin{aligned}-1 & -1 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]\n$$\n\n \n\ngives the following expressions for ${y}_{1}$ and ${y}_{2}:$\n\n$$\n\\begin{aligned}{y}_{1} & =-{x}_{1}-{x}_{2} \\\\ {y}_{2} & =-{x}_{2}\\end{aligned}\n$$\n\nBy solving the second equation for ${x}_{2}$ and substituting it into the first equation, we obtain the following expressions for ${x}_{1}$ and ${x}_{2}:$\n\n$$\n\\begin{aligned}{x}_{1} & =-{y}_{1}+{y}_{2} \\\\ {x}_{2} & =-{y}_{2}\\end{aligned}\n$$\n\n \n\nNow, we substitute these into our quadratic form expression:\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}-2{x}_{1}{x}_{2}-4{x}_{2}^{2} \\\\  & =({y}_{2}-{y}_{1})^{2}-2({y}_{2}-{y}_{1})(-{y}_{2})-4(-{y}_{2})^{2} \\\\  & ={y}_{2}^{2}-2{y}_{1}{y}_{2}+{y}_{1}^{2}+2{y}_{2}^{2}-2{y}_{1}{y}_{2}-4{y}_{2}^{2} \\\\  & ={y}_{1}^{2}-4{y}_{1}{y}_{2}-{y}_{2}^{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-94176/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9f2a5391-d8bb-5084-941a-bb787e8729f3"] :knowledge-point/questions ["q-94176"] :db/ensure [:knowledge-point/validate]} {:db/id "q-94185/selection/fd026269d040102ace984caf4ca4b406d249bf6f0892a145ebc7908bfd0f92c3" :answer/id #uuid "7cddd2cc-0ab9-57e2-9cee-c59b6a09d13e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}5 & 2 \\\\ 2 & -4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-94185/selection/bdcaa02f6140bd46d1f79c107fb1470541c06649ddb961aba7a0e982a86e63e6" :answer/id #uuid "2fbe74cb-b016-5109-90ca-1ab08b67d765" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & 1 \\\\ 1 & -4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-94185/selection/95a648f312686657e86af84cbed714c14ed6fd1ecb5be4cc9379facbfc44eaf3" :answer/id #uuid "13e5ded9-42f1-518a-bd35-c45b7df27517" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3 & 2 \\\\ 2 & 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-94185/selection/1924c18bb2180ae23e5c94f3f8add631ea4c90ae135ed20621a627e0d1c730d6" :answer/id #uuid "af56e18e-308e-51f6-8101-1888d97a9162" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3 & -1 \\\\ -1 & 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-94185/selection/1159a9e435855f4f436c6ac7a9de20bfa196ef5d90630566e79e429b2a0201c4" :answer/id #uuid "54b2b41f-6c50-543e-9994-9c4c13032751" :answer/type :answer.type/math :answer/value "[\\begin{aligned}7 & 1 \\\\ 1 & -14\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-94185/selection" :answer-field/id #uuid "4c5bd55b-903b-5e34-b091-ba5a6444576b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-94185/selection/1159a9e435855f4f436c6ac7a9de20bfa196ef5d90630566e79e429b2a0201c4" :answer-field/choices ["q-94185/selection/fd026269d040102ace984caf4ca4b406d249bf6f0892a145ebc7908bfd0f92c3" "q-94185/selection/bdcaa02f6140bd46d1f79c107fb1470541c06649ddb961aba7a0e982a86e63e6" "q-94185/selection/95a648f312686657e86af84cbed714c14ed6fd1ecb5be4cc9379facbfc44eaf3" "q-94185/selection/1924c18bb2180ae23e5c94f3f8add631ea4c90ae135ed20621a627e0d1c730d6" "q-94185/selection/1159a9e435855f4f436c6ac7a9de20bfa196ef5d90630566e79e429b2a0201c4"] :db/ensure [:answer-field/validate]} {:db/id "q-94185" :question/id #uuid "7eaafd55-fbaa-57ab-9457-6d5fe1c337c3" :question/math-academy-id "q-94185" :question/problem "$$\nA=[\\begin{aligned}-1 & 3 \\\\ 3 & 2\\end{aligned}],\\,P=[\\begin{aligned}1 & -2 \\\\ 1 & 1\\end{aligned}]\n$$\n\nConsider the matrices $A$ and $P$ above. Find the matrix of the quadratic form ${x}^{T}\\,Ax$ in the basis that consists of the columns of $P.$" :question/worked-solution "Recall that if $x=[{x}_{1},{x}_{2}]^{T}$ is a vector given by its coordinates in the standard basis and $y=[{y}_{1},{y}_{2}]^{T}$ is the same vector but given in the coordinates relative to the basis that consists of the columns of $P,$ then \n\n$$\nx=Py.\n$$\n\nAs a result, we have \n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =(Py)^{T}\\,A\\,(Py) \\\\  & =({y}^{T}{P}^{T})\\,A\\,(Py) \\\\  & ={y}^{T}({P}^{T}\\,AP)\\,y,\\end{aligned}\n$$\n\nwhich means that the matrix of our form in the new basis is\n\n$$\n\\begin{aligned}{P}^{T}\\,AP & ={[\\begin{aligned}1 & -2 \\\\ 1 & 1\\end{aligned}]}^{T}[\\begin{aligned}-1 & 3 \\\\ 3 & 2\\end{aligned}][\\begin{aligned}1 & -2 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}-1 & 3 \\\\ 3 & 2\\end{aligned}][\\begin{aligned}1 & -2 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 5 \\\\ 5 & -4\\end{aligned}][\\begin{aligned}1 & -2 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}7 & 1 \\\\ 1 & -14\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-94185/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "331cb610-6168-5161-b821-237c713dedaa"] :knowledge-point/questions ["q-94185"] :db/ensure [:knowledge-point/validate]} {:db/id "q-94189/selection/9f06a822281d6e17cecca0360f93fc21199071992b32709bcafaa1077ff71cb1" :answer/id #uuid "523884de-d4fc-5a41-87cd-3b4f0b8a2dac" :answer/type :answer.type/math :answer/value "[\\begin{aligned}19 & 9 \\\\ 9 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-94189/selection/701e20153171ac71817b090ec4e68dee671704601749d46cc714613147f7cbea" :answer/id #uuid "c85d660e-c8a4-57f0-ae4d-76aabc4ed523" :answer/type :answer.type/math :answer/value "[\\begin{aligned}20 & 8 \\\\ 8 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-94189/selection/3e444aeae55d998e5b0bce2bb435b8605e84c7240f41a46939aea9c85a0842ca" :answer/id #uuid "136af7f9-ab1c-5e9f-affd-63f17b0c0b40" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 & 6 \\\\ 6 & 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-94189/selection/61ef8a6961f96d8d98f62eec0afb3a284e426a69ba1e036fe5e32ccbe733564e" :answer/id #uuid "13009bba-61a2-59ec-91a4-6197db58745a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}10 & 5 \\\\ 5 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-94189/selection/e4dd3f8961884be60e9dd5e6ce742e7fdd85f551a55c1d65629c0eb8014075ec" :answer/id #uuid "4f9ad094-5364-5eed-aed5-4ab1c63f884f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}11 & 2 \\\\ 2 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-94189/selection" :answer-field/id #uuid "fdcd6a11-441c-56c9-bc03-78f2d5a9d36f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-94189/selection/9f0