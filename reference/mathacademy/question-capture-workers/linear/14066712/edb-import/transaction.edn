36355da7036ada"] :db/ensure [:answer-field/validate]} {:db/id "q-94123" :question/id #uuid "821f2c29-f0cd-5aa3-b326-580cae792957" :question/math-academy-id "q-94123" :question/problem "Given that \n\n$$\n[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}2 & 0 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}],\n$$\n\n express the quadratic form $Q(x)=-{x}_{1}^{2}+3{x}_{1}{x}_{2}-2{x}_{2}^{2}\\,$ in terms of the components of $y.$" :question/worked-solution "First, notice that\n\n$$\n[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}2 & 0 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]\n$$\n\n  \n\ngives the following expressions for ${x}_{1}$ and ${x}_{2}:$\n\n$$\n\\begin{aligned}{x}_{1} & =2{y}_{1} \\\\ {x}_{2} & ={y}_{1}+2{y}_{2}\\end{aligned}\n$$\n\nNow, we substitute these into our quadratic form expression:\n\n$$\n\\begin{aligned}Q(x) & =-{x}_{1}^{2}+3{x}_{1}{x}_{2}-2{x}_{2}^{2} \\\\  & =-(2{y}_{1})^{2}+3(2{y}_{1})({y}_{1}+2{y}_{2})-2({y}_{1}+2{y}_{2})^{2} \\\\  & =-4{y}_{1}^{2}+6{y}_{1}^{2}+12{y}_{1}{y}_{2}-2{y}_{1}^{2}-8{y}_{1}{y}_{2}-8{y}_{2}^{2} \\\\  & =4{y}_{1}{y}_{2}-8{y}_{2}^{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-94123/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f203c9bf-7d12-56db-aafe-6639162eae93"] :knowledge-point/questions ["q-94123"] :db/ensure [:knowledge-point/validate]} {:db/id "q-140936/selection/fc28f6d443dd69731bb2cc1a8ab3451ae101c6d331a2b64954670527f370bb03" :answer/id #uuid "d3bddca0-f01e-53e5-9675-62da47ff1737" :answer/type :answer.type/math :answer/value "4{y}_{1}^{2}-{y}_{1}{y}_{2}-6{y}_{2}^{2}" :db/ensure [:answer/validate]} {:db/id "q-140936/selection/b5fa78ed0e73234849debcc8fb76086fe2120d01eb752d2f26fc8f89f03c0a8a" :answer/id #uuid "21cdaee9-e992-5da6-a079-eb43f72bc68a" :answer/type :answer.type/math :answer/value "3{y}_{1}^{2}-13{y}_{1}{y}_{2}-