\\\ {y}_{2} & =-{x}_{1}-{x}_{2}\\end{aligned}\n$$\n\nBy solving the first equation for ${x}_{1}$ and substituting it into the second equation, we obtain the following expressions for ${x}_{1}$ and ${x}_{2}:$\n\n$$\n\\begin{aligned}{x}_{1} & ={y}_{1} \\\\ {x}_{2} & =-{y}_{1}-{y}_{2}\\end{aligned}\n$$\n\nNow, we substitute these into our quadratic form expression:\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}+5{x}_{1}{x}_{2}-{x}_{2}^{2} \\\\  & ={y}_{1}^{2}+5{y}_{1}(-{y}_{1}-{y}_{2})-(-{y}_{1}-{y}_{2})^{2} \\\\  & ={y}_{1}^{2}-5{y}_{1}^{2}-5{y}_{1}{y}_{2}-{y}_{1}^{2}-2{y}_{1}{y}_{2}-{y}_{2}^{2} \\\\  & =-5{y}_{1}^{2}-7{y}_{1}{y}_{2}-{y}_{2}^{2}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066712/state.json" "file_sha256" "1a58bdf4310a132c712eaafc313f29c50f97c6ca5c7e4934f0f05f948cf5f825"} {"question" "q-94166" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066712/activity-metadata.json" "file_sha256" "cd4afffd6d08f8c6a1c33a4fcbb5d3b4ed311a04ddb22e906a1ce299eba2fb26"} {"question" "q-94166" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066712/state.json" "file_sha256" "1a58bdf4310a132c712eaafc313f29c50f97c6ca5c7e4934f0f05f948cf5f825"} {"question" "q-94166" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2{y}_{1}^{2}+4{y}_{1}{y}_{+}{y}_{2}^{2}"] ["math" "-3{y}_{1}^{2}-9{y}_{1}{y}_{2}-{y}_{2}^{2}"] ["math" "-5{y}_{1}^{2}-7{y}_{1}{y}_{2}-{y}_{2}^{2}"] ["math" "2{y}_{1}^{2}-5{y}_{1}{y}_{2}-{y}_{2}^{2}"] ["math" "5{y}_{1}^{2}-6{y}_{1}{y}_{2}+{y}_{2}^{2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/referenc