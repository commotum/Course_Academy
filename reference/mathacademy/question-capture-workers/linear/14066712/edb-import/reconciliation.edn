_{1}-2{y}_{2})^{2} \\\\  & =2{y}_{2}^{2}-{y}_{2}{y}_{1}+2{y}_{2}^{2}-{y}_{1}^{2}+4{y}_{1}{y}_{2}-4{y}_{2}^{2} \\\\  & =-{y}_{1}^{2}+3{y}_{1}{y}_{2}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066712/state.json" "file_sha256" "1a58bdf4310a132c712eaafc313f29c50f97c6ca5c7e4934f0f05f948cf5f825"} {"question" "q-140939" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066712/activity-metadata.json" "file_sha256" "cd4afffd6d08f8c6a1c33a4fcbb5d3b4ed311a04ddb22e906a1ce299eba2fb26"} {"question" "q-140939" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066712/state.json" "file_sha256" "1a58bdf4310a132c712eaafc313f29c50f97c6ca5c7e4934f0f05f948cf5f825"} {"question" "q-140939" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-{y}_{1}^{2}+3{y}_{1}{y}_{2}"] ["math" "-{y}_{1}^{2}+3{y}_{1}{y}_{2}+8{y}_{2}^{2}"] ["math" "{y}_{1}^{2}+4{y}_{1}{y}_{2}-8{y}_{2}^{2}"] ["math" "{y}_{1}^{2}+5{y}_{1}{y}_{2}"] ["math" "{y}_{1}^{2}-4{y}_{1}{y}_{2}+4{y}_{2}^{2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066712/state.json" "file_sha256" "1a58bdf4310a132c712eaafc313f29c50f97c6ca5c7e4934f0f05f948cf5f825"} {"question" "q-140939" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-{y}_{1}^{2}+3{y}_{1}{y}_{2}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066712/state.json" "file_sha256" "1a58bdf4310a132c712eaafc313f29c50f97c6ca5c7e4934f0f05f948cf5f825"} {"question" "q-94176" "field" nil "attribute" "question/problem" "value" "Given that \n\n$$\n[\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]=[\\begin{aligned}-1 & -1 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],\n$$\n\n express the quadratic form $Q(x)={x}_{1}^{2}-2{x}_{1}{x}_{2}-4{x}_{2}^{2}$ in terms of the components of $y.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066712/state.json" "file_sha256" "1a58bdf4310a132c712eaafc313f29c50f97c6ca5c7e4934f0f05f948cf5f825"} {"question" "q-94176" "field" nil "attribute" "question/worked-solution" "value" "First, notice that \n\n$$\n[\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]=[\\begin{aligned}-1 & -1 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]\n$$\n\n \n\ngives the following expressions for ${y}_{1}$ and ${y}_{2}:$\n\n$$\n\\begin{aligned}{y}_{1} & =-{x}_{1}-{x}_{2} \\\\ {y}_{2} & =-{x}_{2}\\end{aligned}\n$$\n\nBy solving the second equation for ${x}_{2}$ and substituting it into the first equation, we obtain the following expressions for ${x}_{1}$ and ${x}_{2}:$\n\n$$\n\\begin{aligned}{x}_{1} & =-{y}_{1}+{y}_{2} \\\\ {x}_{2} & =-{y}_{2}\\end{aligned}\n$$\n\n \n\nNow, we substitute these into our quadratic form expression:\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}-2{x}_{1}{x}_{2}-4{x}_{2}^{2} \\\\  & =({y}_{2}-{y}_{1})^{2}-2({y}_{2}-{y}_{1})(-{y}_{2})-4(-{y}_{2})^{2} \\\\  & ={y}_{2}^{2}-2{y}_{1}{y}_{2}+{y}_{1}^{2}+2{y}_{2}^{2}-2{y}_{1}{y}_{2}-4{y}_{2}^{2} \\\\  & ={y}_{1}^{2}-4{y}_{1}{y}_{2}-{y}_{2}^{2}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066712/state.json" "file_sha256" "1a58bdf4310a132c712eaafc313f29c50f97c6ca5c7e4934f0f05f948cf5f825"} {"question" "q-94176" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066712/activity-metadata.json" "file_sha256" "cd4afffd6d08f8c6a1c33a4fcbb5d3b4ed311a04ddb22e906a1ce299eba2fb26"} {"question" "q-94176" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066712/state.json" "file_sha256" "1a58bdf4310a132c712eaafc313f29c50f97c6ca5c7e4934f0f05f948cf5f825"} {"question" "q-94176" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2{y}_{1}{y}_{2}-6{y}_{2}^{2}"] ["math" "2{y}_{1}^{2}-4{y}_{1}{y}_{2}+{y}_{2}^{2}"] ["math" "{y}_{1}^{2}+4{y}_{1}{y}_{2}+2{y}_{2}^{2}"] ["math" "{y}_{1}^{2}-2{y}_{1}{y}_{2}-{y}_{2}^{2}"] ["math" "{y}_{1}^{2}-4{y}_{1}{y}_{2}-{y}_{2}^{2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066712/state.json" "file_sha256" "1a58bdf4310a132c712eaafc313f29c50f97c6ca5c7e4934f0f05f948cf5f825"} {"question" "q-94176" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{y}_{1}^{2}-4{y}_{1}{y}_{2}-{y}_{2}^{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066712/state.json" "file_sha256" "1a58bdf4310a132c712eaafc313f29c50f97c6ca5c7e4934f0f05f948cf5f825"} {"question" "q-94185" "field" nil "attribute" "question/problem" "value" "$$\nA=[\\begin{aligned}-1 & 3 \\\\ 3 & 2\\end{aligned}],\\,P=[\\begin{aligned}1 & -2 \\\\ 1 & 1\\end{aligned}]\n$$\n\nConsider the matrices $A$ and $P$ above. Find the matrix of the quadratic form ${x}^{T}\\,Ax$ in the basis that consists of the columns of $P.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066712/state.json" "file_sha256" "1a58bdf4310a132c712eaafc313f29c50f97c6ca5c7e4934f0f05f948cf5f825"} {"question" "q-94185" "field" nil "attribute" "question/worked-solution" "value" "Recall that if $x=[{x}_{1},{x}_{2}]^{T}$ is a vector given by its coordinates in the standard basis and $y=[{y}_{1},{y}_{2}]^{T}$ is the same vector but given in the coordinates relative to the basis that consists of the columns of $P,$ then \n\n$$\nx=Py.\n$$\n\nAs a result, we have \n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =(Py)^{T}\\,A\\,(Py) \\\\  & =({y}^{T}{P}^{T})\\,A\\,(Py) \\\\  & ={y}^{T}({P}^{T}\\,AP)\\,y,\\end{aligned}\n$$\n\nwhich means that the matrix of our form in the new basis is\n\n$$\n\\begin{aligned}{P}^{T}\\,AP & ={[\\begin{aligned}1 & -2 \\\\ 1 & 1\\end{aligned}]}^{T}[\\begin{aligned}-1 & 3 \\\\ 3 & 2\\end{aligned}][\\begin{aligned}1 & -2 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}-1 & 3 \\\\ 3 & 2\\end{aligned}][\\begin{aligned}1 & -2 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 5 \\\\ 5 & -4\\end{aligned}][\\begin{aligned}1 & -2 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}7 & 1 \\\\ 1 & -14\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066712/state.json" "file_sha256" "1a58bdf4310a132c712eaafc313f29c50f97c6ca5c7e4934f0f05f948cf5f825"} {"question" "q-94185" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066712/activity-metadata.json" "file_sha256" "cd4afffd6d08f8c6a1c33a4fcbb5d3b4ed311a04ddb22e906a1ce299eba2fb26"} {"question" "q-94185" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066712/state.json" "f