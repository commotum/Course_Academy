gned}Q(x) & ={x}_{1}^{2}-4{x}_{1}{x}_{2}+3{x}_{2}^{2} \\\\  & =({y}_{1})^{2}-4({y}_{1})(-{y}_{1}+3{y}_{2})+3(-{y}_{1}+3{y}_{2})^{2} \\\\  & ={y}_{1}^{2}+4{y}_{1}^{2}-12{y}_{1}{y}_{2}+3{y}_{1}^{2}-18{y}_{1}{y}_{2}+27{y}_{2}^{2} \\\\  & =8{y}_{1}^{2}-30{y}_{1}{y}_{2}+27{y}_{2}^{2}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066712/state.json" "file_sha256" "1a58bdf4310a132c712eaafc313f29c50f97c6ca5c7e4934f0f05f948cf5f825"} {"question" "q-140937" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066712/activity-metadata.json" "file_sha256" "cd4afffd6d08f8c6a1c33a4fcbb5d3b4ed311a04ddb22e906a1ce299eba2fb26"} {"question" "q-140937" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066712/state.json" "file_sha256" "1a58bdf4310a132c712eaafc313f29c50f97c6ca5c7e4934f0f05f948cf5f825"} {"question" "q-140937" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "4{y}_{1}^{2}-3{y}_{1}{y}_{2}+9{y}_{2}^{2}"] ["math" "8{y}_{1}^{2}-15{y}_{1}{y}_{2}-27{y}_{2}^{2}"] ["math" "8{y}_{1}^{2}-30{y}_{1}{y}_{2}+27{y}_{2}^{2}"] ["math" "{y}_{1}^{2}+12{y}_{1}{y}_{2}-9{y}_{2}^{2}"] ["math" "{y}_{1}^{2}-4{y}_{1}{y}_{2}+3{y}_{2}^{2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066712/state.json" "file_sha256" "1a58bdf4310a132c712eaafc313f29c50f97c6ca5c7e4934f0f05f948cf5f825"} {"question" "q-140937" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "8{y}_{1}^{2}-30{y}_{1}{y}_{2}+27{y}_{2}^{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/