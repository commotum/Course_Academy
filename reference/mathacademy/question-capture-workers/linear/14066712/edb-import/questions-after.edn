& 2\\end{aligned}] \\\\  & =[\\begin{aligned}5 & 13 \\\\ 13 & 14\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186358273 :knowledge-point/_questions [{:knowledge-point/id #uuid "f203c9bf-7d12-56db-aafe-6639162eae93" :knowledge-point/title "Changing Variables in a Quadratic Form Given Old Variables Through New Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d0ac0d92-85e2-5109-9975-1fc7c1bc59ce" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}^{2}-{y}_{2}^{2}" :db/id #edb/ref 17592186358275} {:answer/id #uuid "774976c4-e557-58dc-b253-39e5a5afafdb" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}^{2}+4{y}_{1}{y}_{2}-{y}_{2}^{2}" :db/id #edb/ref 17592186358276} {:answer/id #uuid "847605f2-b0ff-5446-bab5-6c344cf13854" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}{y}_{2}-{y}_{1}^{2}" :db/id #edb/ref 17592186358277} {:answer/id #uuid "e415a261-9214-50d7-9d2d-985698619990" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}^{2}-2{y}_{1}{y}_{2}-3{y}_{2}^{2}" :db/id #edb/ref 17592186358278} {:answer/id #uuid "0db8c1ea-4205-5282-bd53-731002b41cc7" :answer/type {:db/ident :answer.type/math} :answer/value "4{y}_{1}{y}_{2}-8{y}_{2}^{2}" :db/id #edb/ref 17592186358279}] :answer-field/correct {:answer/id #uuid "0db8c1ea-4205-5282-bd53-731002b41cc7" :answer/type {:db/ident :answer.type/math} :answer/value "4{y}_{1}{y}_{2}-8{y}_{2}^{2}" :db/id #edb/ref 17592186358279} :answer-field/id #uuid "f51ffdf5-d584-5959-b3b3-e15bb9705e51" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186358274}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "821f2c29-f0cd-5aa3-b326-580cae792957" :question/math-academy-id "q-94123" :question/problem "Given that \n\n$$\n[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}2 & 0 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}],\n$$\n\n express the quadratic form $Q(x)=-{x}_{1}^{2}+3{x}_{1}{x}_{2}-2{x}_{2}^{2}\\,$ in terms of the components of $y.$" :question/worked-solution "First, notice that\n\n$$\n[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}2 & 0 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]\n$$\n\n  \n\ngives the following expressions for ${x}_{1}$ and ${x}_{2}:$\n\n$$\n\\begin{aligned}{x}_{1} & =2{y}_{1} \\\\ {x}_{2} & ={y}_{1}+2{y}_{2}\\end{aligned}\n$$\n\nNow, we substitute these into our quadratic form expression:\n\n$$\n\\begin{aligned}Q(x) & =-{x}_{1}^{2}+3{x}_{1}{x}_{2}-2{x}_{2}^{2} \\\\  & =-(2{y}_{1})^{2}+3(2{y}_{1})({y}_{1}+2{y}_{2})-2({y}_{1}+2{y}_{2})^{2} \\\\  & =-4{y}_{1}^{2}+6{y}_{1}^{2}+12{y}_{1}{y}_{2}-2{y}_{1}^{2}-8{y}_{1}{y}_{2}-8{y}_{2}^{2} \\\\  & =4{y}_{1}{y}_{2}-8{y}_{2}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186358280 :knowledge-point/_questions [{:knowledge-point/id #uuid "f203c9bf-7d12-56db-aafe-6639162eae93" :knowledge-point/title "Changing Variables in a Quadratic Form Given Old Variables Through New Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "558b75d6-596e-5347-864b-f9484d1972e0" :answer/type {:db/ident :answer.type/math} :answer/value "25{y}_{1}^{2}+10{y}_{1}{y}_{2}+{y}_{2}^{2}" :db/id #edb/ref 17592186358282} {:answer/id #uuid "ef62b86a-d0e0-5900-b2e0-25a6662a40f8" :answer/type {:db/ident :answer.type/math} :answer/value "-{y}_{1}^{2}+12{y}_{1}{y}_{2}+3{y}_{2}^{2}" :db/id #edb/ref 17592186358283} {:answer/id #uuid "9cfde215-d137-535a-a327-aa06cb6d906f" :answer/type {:db/ident :answer.type/math} :answer/value "5{y}_{1}^{2}-10{y}_{1}{y}_{2}" :db/id #edb/ref 17592186358284} {:answer/id #uuid "bbac7e41-2e39-52cf-ad00-ffce71756bca" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}{y}_{2}+{y}_{2}^{2}" :db/id #edb/ref 17592186358285} {:answer/id #uuid "977886e5-dfca-516b-b6c0-d35a1127605e" :answer/type {:db/ident :answer.type/math} :answer/value "25{y}_{1}^{2}-9{y}_{2}^{2}" :db/id #edb/ref 17592186358286}] :answer-field/correct {:answer/id #uuid "977886e5-dfca-516b-b6c0-d35a1127605e" :answer/type {:db/ident :answer.type/math} :answer/value "25{y}_{1}^{2}-9{y}_{2}^{2}" :db/id #edb/ref 17592186358286} :answer-field/id #uuid "a98c0c09-a16a-5104-b30c-d391d0919069" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186358281}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "257cdc22-a665-5431-88ce-f38417922fe8" :question/math-academy-id "q-94134" :question/problem "Given that \n\n$$\n[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}5 & 1 \\\\ 0 & -2\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}],\n$$\n\n express the quadratic form $Q(x)={x}_{1}^{2}+{x}_{1}{x}_{2}-2{x}_{2}^{2}\\,$ in terms of the components of $y.$" :question/worked-solution "First, notice that\n\n$$\n[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}5 & 1 \\\\ 0 & -2\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]\n$$\n\n  \n\ngives the following expressions for ${x}_{1}$ and ${x}_{2}:$\n\n$$\n\\begin{aligned}{x}_{1} & =5{y}_{1}+{y}_{2} \\\\ {x}_{2} & =-2{y}_{2}\\end{aligned}\n$$\n\nNow, we substitute these into our quadratic form expression:\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}+{x}_{1}{x}_{2}-2{x}_{2}^{2} \\\\  & =(5{y}_{1}+{y}_{2})^{2}+(5{y}_{1}+{y}_{2})(-2{y}_{2})-2(-2{y}_{2})^{2} \\\\  & =25{y}_{1}^{2}+10{y}_{1}{y}_{2}+{y}_{2}^{2}-10{y}_{1}{y}_{2}-2{y}_{2}^{2}-8{y}_{2}^{2} \\\\  & =25{y}_{1}^{2}-9{y}_{2}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186358287 :knowledge-point/_questions [{:knowledge-point/id #uuid "f203c9bf-7d12-56db-aafe-6639162eae93" :knowledge-point/title "Changing Variables in a Quadratic Form Given Old Variables Through New Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "749e15c2-5092-53b6-8ff0-ec292e42fe73" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}^{2}-{y}_{2}^{2}" :db/id #edb/ref 17592186358289} {:answer/id #uuid "6c906761-c331-57e9-8ef9-f459f00d1306" :answer/type {:db/ident :answer.type/math} :answer/value "2{y}_{1}^{2}+4{y}_{2}{y}_{1}-{y}_{2}^{2}" :db/id #edb/ref 17592186358290} {:answer/id #uuid "12b838b2-0a00-569f-84a5-4737fed8fb5a" :answer/type {:db/ident :answer.type/math} :answer/value "2{y}_{1}^{2}+2{y}_{2}^{2}" :db/id #edb/ref 17592186358291} {:answer/id #uuid "47600653-3633-5ccd-9323-07e29bba608c" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}^{2}+4{y}_{2}{y}_{1}" :db/id #edb/ref 17592186358292} {:answer/id #uuid "dfb6fe60-22e6-5b12-a6c8-8a86773ceac8" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}^{2}-4{y}_{2}{y}_{1}+{y}_{2}^{2}" :db/id #edb/ref 17592186358293}] :answer-field/correct {:answer/id #uuid "12b838b2-0a00-569f-84a5-4737fed8fb5a" :answer/type {:db/ident :answer.type/math} :answer/value "2{y}_{1}^{2}+2{y}_{2}^{2}" :db/id #edb/ref 17592186358291} :answer-field/id #uuid "9b962667-56b1-5726-b14e-56ab203c5d88" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186358288}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f4d30279-b02c-5c08-93c8-f681aac88b1c" :question/math-academy-id "q-94153" :question/problem "Given that \n\n$$\n[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}1 & 1 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}],\n$$\n\n express the quadratic form $Q(x)={x}_{1}^{2}+{x}_{2}^{2}\\,$ in terms of the components of $y.$" :question/worked-solution "First, notice that\n\n$$\n[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}1 & 1 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]\n$$\n\ngives the following expressions for ${x}_{1}$ and ${x}_{2}:$\n\n$$\n\\begin{aligned}{x}_{1} & ={y}_{1}+{y}_{2} \\\\ {x}_{2} & =-{y}_{1}+{y}_{2}\\end{aligned}\n$$\n\nNow, we substitute these into our quadratic form expression:\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}+{x}_{2}^{2} \\\\  & =({y}_{1}+{y}_{2})^{2}+(-{y}_{1}+{y}_{2})^{2} \\\\  & ={y}_{1}^{2}+2{y}_{1}{y}_{2}+{y}_{2}^{2}+{y}_{1}^{2}-2{y}_{1}{y}_{2}+{y}_{2}^{2} \\\\  & =2{y}_{1}^{2}+2{y}_{2}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186358294 :knowledge-point/_questions [{:knowledge-point/id #uuid "9f2a5391-d8bb-5084-941a-bb787e8729f3" :knowledge-point/title "Changing Variables in a Quadratic Form Given New Variables Through Old Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f1fc5d2-0957-53fb-8c7b-d37c2b935bf6" :answer/type {:db/ident :answer.type/math} :answer/value "-3{y}_{1}^{2}-9{y}_{1}{y}_{2}-{y}_{2}^{2}" :db/id #edb/ref 17592186358296} {:answer/id #uuid "c0e965d3-ad1a-5ee7-8ce3-283ce1577747" :answer/type {:db/ident :answer.type/math} :answer/value "-2{y}_{1}^{2}+4{y}_{1}{y}_{+}{y}_{2}^{2}" :db/id #edb/ref 17592186358297} {:answer/id #uuid "d33efac1-0237-595f-96ff-3dc27ec77957" :answer/type {:db/ident :answer.type/math} :answer/value "5{y}_{1}^{2}-6{y}_{1}{y}_{2}+{y}_{2}^{2}" :db/id #edb/ref 17592186358298} {:answer/id #uuid "f81d7b1f-15dd-53e0-b2f4-91e437e941b5" :answer/type {:db/ident :answer.type/math} :answer/value "-5{y}_{1}^{2}-7{y}_{1}{y}_{2}-{y}_{2}^{2}" :db/id #edb/ref 17592186358299} {:answer/id #uuid "7f9c0829-f94e-5523-8207-09fd8af703e2" :answer/type {:db/ident :answer.type/math} :answer/value "2{y}_{1}^{2}-5{y}_{1}{y}_{2}-{y}_{2}^{2}" :db/id #edb/ref 17592186358300}] :answer-field/correct {:answer/id #uuid "f81d7b1f-15dd-53e0-b2f4-91e437e941b5" :answer/type {:db/ident :answer.type/math} :answer/value "-5{y}_{1}^{2}-7{y}_{1}{y}_{2}-{y}_{2}^{2}" :db/id #edb/ref 17592186358299} :answer-field/id #uuid "3b59630c-7de7-593d-b3c6-6048b7667b12" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186358295}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "53e967d9-4a22-5f89-8fc6-d13a8ef6d838" :question/math-academy-id "q-94166" :question/problem "Given that \n\n$$\n[\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]=[\\begin{aligned}1 & 0 \\\\ -1 & -1\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],\n$$\n\n express the quadratic form $Q(x)={x}_{1}^{2}+5{x}_{1}{x}_{2}-{x}_{2}^{2}$ in terms of the components of $y.$" :question/worked-solution "First, notice that \n\n$$\n[\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]=[\\begin{aligned}1 & 0 \\\\ -1 & -1\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]\n$$\n\ngives the following expressions for ${y}_{1}$ and ${y}_{2}:$\n\n$$\n\\begin{aligned}{y}_{1} & ={x}_{1} \\\\ {y}_{2} & =-{x}_{1}-{x}_{2}\\end{aligned}\n$$\n\nBy solving the first equation for ${x}_{1}$ and substituting it into the second equation, we obtain the following expressions for ${x}_{1}$ and ${x}_{2}:$\n\n$$\n\\begin{aligned}{x}_{1} & ={y}_{1} \\\\ {x}_{2} & =-{y}_{1}-{y}_{2}\\end{aligned}\n$$\n\nNow, we substitute these into our quadratic form expression:\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}+5{x}_{1}{x}_{2}-{x}_{2}^{2} \\\\  & ={y}_{1}^{2}+5{y}_{1}(-{y}_{1}-{y}_{2})-(-{y}_{1}-{y}_{2})^{2} \\\\  & ={y}_{1}^{2}-5{y}_{1}^{2}-5{y}_{1}{y}_{2}-{y}_{1}^{2}-2{y}_{1}{y}_{2}-{y}_{2}^{2} \\\\  & =-5{y}_{1}^{2}-7{y}_{1}{y}_{2}-{y}_{2}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186358301 :knowledge-point/_questions [{:knowledge-point/id #uuid "9f2a5391-d8bb-5084-941a-bb787e8729f3" :knowledge-point/title "Changing Variables in a Quadratic Form Given New Variables Through Old Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33926f6b-38cb-5d4e-8a75-0ad6c5a0aa6d" :answer/type {:db/ident :answer.type/math} :answer/value "-11{y}_{2}^{2}-4{y}_{1}{y}_{2}" :db/id #edb/ref 17592186358303} {:answer/id #uuid "68c14520-a854-5c3d-987b-ed2e93c18812" :answer/type {:db/ident :answer.type/math} :answer/value "-12{y}_{1}^{2}-4{y}_{1}{y}_{2}" :db/id #edb/ref 17592186358304} {:answer/id #uuid "ffcaa377-6220-5ca0-af7d-f61e6cc437b0" :answer/type {:db/ident :answer.type/math} :answer/value "-9{y}_{1}^{2}-4{y}_{1}{y}_{2}" :db/id #edb/ref 17592186358305} {:answer/id #uuid "a3d52dc0-01d2-50f0-a6f6-4a08deacdbab" :answer/type {:db/ident :answer.type/math} :answer/value "8{y}_{2}^{2}-8{y}_{1}{y}_{2}" :db/id #edb/ref 17592186358306} {:answer/id #uuid "817b8ac8-8752-5260-84c7-3461e7c3b65f" :answer/type {:db/ident :answer.type/math} :answer/value "-12{y}_{2}^{2}-2{y}_{1}{y}_{2}" :db/id #edb/ref 17592186358307}] :answer-field/correct {:answer/id #uuid "33926f6b-38cb-5d4e-8a75-0ad6c5a0aa6d" :answer/type {:db/ident :answer.type/math} :answer/value "-11{y}_{2}^{2}-4{y}_{1}{y}_{2}" :db/id #edb/ref 17592186358303} :answer-field/id #uuid "39646818-a0a6-55a6-8f3e-7a8a0ff57142" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186358302}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "219fd870-8eb3-528f-a551-5d5ef16ce799" :question/math-academy-id "q-94171" :question/problem "Given that \n\n$$\n[\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]=[\\begin{aligned}3 & 1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],\n$$\n\n express the quadratic form $Q(x)={x}_{1}^{2}+4{x}_{1}{x}_{2}$ in terms of the components of $y.$" :question/worked-solution "First, notice that \n\n$$\n[\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]=[\\begin{aligned}3 & 1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]\n$$\n\ngives the following expressions for ${y}_{1}$ and ${y}_{2}:$\n\n$$\n\\begin{aligned}{y}_{1} & =3{x}_{1}+{x}_{2} \\\\ {y}_{2} & =-{x}_{1}\\end{aligned}\n$$\n\nBy solving the second equation for ${x}_{1}$ and substituting it into the first equation, we obtain the following expressions for ${x}_{1}$ and ${x}_{2}:$\n\n$$\n\\begin{aligned}{x}_{1} & =-{y}_{2} \\\\ {x}_{2} & ={y}_{1}+3{y}_{2}\\end{aligned}\n$$\n\nNow, we substitute these into our quadratic form expression:\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}+4{x}_{1}{x}_{2} \\\\  & =(-{y}_{2})^{2}+4(-{y}_{2})({y}_{1}+3{y}_{2}) \\\\  & ={y}_{2}^{2}-4{y}_{1}{y}_{2}-12{y}_{2}^{2} \\\\  & =-11{y}_{2}^{2}-4{y}_{1}{y}_{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186358308 :knowledge-point/_questions [{:knowledge-point/id #uuid "9f2a5391-d8bb-5084-941a-bb787e8729f3" :knowledge-point/title "Changing Variables in a Quadratic Form Given New Variables Through Old Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f2497136-6d0a-590f-afac-afd2914e450d" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}^{2}-4{y}_{1}{y}_{2}-{y}_{2}^{2}" :db/id #edb/ref 17592186358310} {:answer/id #uuid "114971c4-fbc5-5a43-a26c-51c4288728f8" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}^{2}-2{y}_{1}{y}_{2}-{y}_{2}^{2}" :db/id #edb/ref 17592186358311} {:answer/id #uuid "954a926c-0d12-5798-948f-9435092f1aac" :answer/type {:db/ident :answer.type/math} :answer/value "2{y}_{1}^{2}-4{y}_{1}{y}_{2}+{y}_{2}^{2}" :db/id #edb/ref 17592186358312} {:answer/id #uuid "7384b10f-968a-59db-9974-54fd92e9a51e" :answer/type {:db/ident :answer.type/math} :answer/value "-2{y}_{1}{y}_{2}-6{y}_{2}^{2}" :db/id #edb/ref 17592186358313} {:answer/id #uuid "87cb4652-34cc-5da3-9756-3ee658a54da3" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}^{2}+4{y}_{1}{y}_{2}+2{y}_{2}^{2}" :db/id #edb/ref 17592186358314}] :answer-field/correct {:answer/id #uuid "f2497136-6d0a-590f-afac-afd2914e450d" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}^{2}-4{y}_{1}{y}_{2}-{y}_{2}^{2}" :db/id #edb/ref 17592186358310} :answer-field/id #uuid "f30638e4-2085-52ec-9011-26aea6db2e9d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186358309}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "925562cf-2357-52e7-ac4c-39ebef5b8eb5" :question/math-academy-id "q-94176" :question/problem "Given that \n\n$$\n[\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]=[\\begin{aligned}-1 & -1 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],\n$$\n\n express the quadratic form $Q(x)={x}_{1}^{2}-2{x}_{1}{x}_{2}-4{x}_{2}^{2}$ in terms of the components of $y.$" :question/worked-solution "First, notice that \n\n$$\n[\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]=[\\begin{aligned}-1 & -1 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]\n$$\n\n \n\ngives the following expressions for ${y}_{1}$ and ${y}_{2}:$\n\n$$\n\\begin{aligned}{y}_{1} & =-{x}_{1}-{x}_{2} \\\\ {y}_{2} & =-{x}_{2}\\end{aligned}\n$$\n\nBy solving the second equation for ${x}_{2}$ and substituting it into the first equation, we obtain the following expressions for ${x}_{1}$ and ${x}_{2}:$\n\n$$\n\\begin{aligned}{x}_{1} & =-{y}_{1}+{y}_{2} \\\\ {x}_{2} & =-{y}_{2}\\end{aligned}\n$$\n\n \n\nNow, we substitute these into our quadratic form expression:\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}-2{x}_{1}{x}_{2}-4{x}_{2}^{2} \\\\  & =({y}_{2}-{y}_{1})^{2}-2({y}_{2}-{y}_{1})(-{y}_{2})-4(-{y}_{2})^{2} \\\\  & ={y}_{2}^{2}-2{y}_{1}{y}_{2}+{y}_{1}^{2}+2{y}_{2}^{2}-2{y}_{1}{y}_{2}-4{y}_{2}^{2} \\\\  & ={y}_{1}^{2}-4{y}_{1}{y}_{2}-{y}_{2}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186358315 :knowledge-point/_questions [{:knowledge-point/id #uuid "9f2a5391-d8bb-5084-941a-bb787e8729f3" :knowledge-point/title "Changing Variables in a Quadratic Form Given New Variables Through Old Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8bcf00d8-5c48-5e84-8be4-f95ac01127eb" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}^{2}+2{y}_{1}{y}_{2}+{y}_{2}^{2}" :db/id #edb/ref 17592186358317} {:answer/id #uuid "c30bcbc8-2b60-5287-a5f7-2e227fd3315c" :answer/type {:db/ident :answer.type/math} :answer/value "5{y}_{1}^{2}+2{y}_{1}{y}_{2}-{y}_{2}^{2}" :db/id #edb/ref 17592186358318} {:answer/id #uuid "dabc9aa4-a867-54fd-8120-6a6df990e9f5" :answer/type {:db/ident :answer.type/math} :answer/value "7{y}_{1}^{2}-2{y}_{1}{y}_{2}-{y}_{2}^{2}" :db/id #edb/ref 17592186358319} {:answer/id #uuid "2210f297-dac2-5381-8765-9b5e5e04bae4" :answer/type {:db/ident :answer.type/math} :answer/value "-7{y}_{1}^{2}+2{y}_{1}{y}_{2}+{y}_{2}^{2}" :db/id #edb/ref 17592186358320} {:answer/id #uuid "33adcb4b-c2e1-5983-bd70-e542d191420d" :answer/type {:db/ident :answer.type/math} :answer/value "-6{y}_{1}^{2}-2{y}_{1}{y}_{2}+{y}_{2}^{2}" :db/id #edb/ref 17592186358321}] :answer-field/correct {:answer/id #uuid "2210f297-dac2-5381-8765-9b5e5e04bae4" :answer/type {:db/ident :answer.type/math} :answer/value "-7{y}_{1}^{2}+2{y}_{1}{y}_{2}+{y}_{2}^{2}" :db/id #edb/ref 17592186358320} :answer-field/id #uuid "f9363701-abc9-50dc-bc54-dac8b1b101b2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186358316}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "02ae32d4-e79e-5a68-a522-757e7aea45b2" :question/math-academy-id "q-94178" :question/problem "Given that \n\n$$\n[\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]=[\\begin{aligned}-1 & 0 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],\n$$\n\n express the quadratic form $Q(x)={x}_{1}^{2}-6{x}_{1}{x}_{2}+{x}_{2}^{2}$ in terms of the components of $y.$" :question/worked-solution "First, notice that \n\n$$\n[\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]=[\\begin{aligned}-1 & 0 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]\n$$\n\ngives the following expressions for ${y}_{1}$ and ${y}_{2}:$\n\n$$\n\\begin{aligned}{y}_{1} & =-{x}_{1} \\\\ {y}_{2} & =-2{x}_{1}+{x}_{2}\\end{aligned}\n$$\n\nBy solving the first equation for ${x}_{1}$ and substituting it into the second equation, we obtain the following expressions for ${x}_{1}$ and ${x}_{2}:$\n\n$$\n\\begin{aligned}{x}_{1} & =-{y}_{1} \\\\ {x}_{2} & =-2{y}_{1}+{y}_{2}\\end{aligned}\n$$\n\nNow, we substitute these into our quadratic form expression:\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}-6{x}_{1}{x}_{2}+{x}_{2}^{2} \\\\  & =(-{y}_{1})^{2}-6(-{y}_{1})(-2{y}_{1}+{y}_{2})+(-2{y}_{1}+{y}_{2})^{2} \\\\  & ={y}_{1}^{2}-12{y}_{1}^{2}+6{y}_{1}{y}_{2}+4{y}_{1}^{2}-4{y}_{1}{y}_{2}+{y}_{2}^{2} \\\\  & =-7{y}_{1}^{2}+2{y}_{1}{y}_{2}+{y}_{2}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186358322 :knowledge-point/_questions [{:knowledge-point/id #uuid "331cb610-6168-5161-b821-237c713dedaa" :knowledge-point/title "Finding the Matrix of a Quadratic Form Given a Change-of-Coordinates Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54b2b41f-6c50-543e-9994-9c4c13032751" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & 1 \\\\ 1 & -14\\end{aligned}]" :db/id #edb/ref 17592186358324} {:answer/id #uuid "af56e18e-308e-51f6-8101-1888d97a9162" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 & -1 \\\\ -1 & 4\\end{aligned}]" :db/id #edb/ref 17592186358325} {:answer/id #uuid "13e5ded9-42f1-518a-bd35-c45b7df27517" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 & 2 \\\\ 2 & 4\\end{aligned}]" :db/id #edb/ref 17592186358326} {:answer/id #uuid "2fbe74cb-b016-5109-90ca-1ab08b67d765" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 1 \\\\ 1 & -4\\end{aligned}]" :db/id #edb/ref 17592186358327} {:answer/id #uuid "7cddd2cc-0ab9-57e2-9cee-c59b6a09d13e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 2 \\\\ 2 & -4\\end{aligned}]" :db/id #edb/ref 17592186358328}] :answer-field/correct {:answer/id #uuid "54b2b41f-6c50-543e-9994-9c4c13032751" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & 1 \\\\ 1 & -14\\end{aligned}]" :db/id #edb/ref 17592186358324} :answer-field/id #uuid "4c5bd55b-903b-5e34-b091-ba5a6444576b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186358323}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "7eaafd55-fbaa-57ab-9457-6d5fe1c337c3" :question/math-academy-id "q-94185" :question/problem "$$\nA=[\\begin{aligned}-1 & 3 \\\\ 3 & 2\\end{aligned}],\\,P=[\\begin{aligned}1 & -2 \\\\ 1 & 1\\end{aligned}]\n$$\n\nConsider the matrices $A$ and $P$ above. Find the matrix of the quadratic form ${x}^{T}\\,Ax$ in the basis that consists of the columns of $P.$" :question/worked-solution "Recall that if $x=[{x}_{1},{x}_{2}]^{T}$ is a vector given by its coordinates in the standard basis and $y=[{y}_{1},{y}_{2}]^{T}$ is the same vector but given in the coordinates relative to the basis that consists of the columns of $P,$ then \n\n$$\nx=Py.\n$$\n\nAs a result, we have \n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =(Py)^{T}\\,A\\,(Py) \\\\  & =({y}^{T}{P}^{T})\\,A\\,(Py) \\\\  & ={y}^{T}({P}^{T}\\,AP)\\,y,\\end{aligned}\n$$\n\nwhich means that the matrix of our form in the new basis is\n\n$$\n\\begin{aligned}{P}^{T}\\,AP & ={[\\begin{aligned}1 & -2 \\\\ 1 & 1\\end{aligned}]}^{T}[\\begin{aligned}-1 & 3 \\\\ 3 & 2\\end{aligned}][\\begin{aligned}1 & -2 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}-1 & 3 \\\\ 3 & 2\\end{aligned}][\\begin{aligned}1 & -2 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 5 \\\\ 5 & -4\\end{aligned}][\\begin{aligned}1 & -2 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}7 & 1 \\\\ 1 & -14\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186358329 :knowledge-point/_questions [{:knowledge-point/id #uuid "331cb610-6168-5161-b821-237c713dedaa" :knowledge-point/title "Finding the Matrix of a Quadratic Form Given a Change-of-Coordinates Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "136af7f9-ab1c-5e9f-affd-63f17b0c0b40" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 6 \\\\ 6 & 5\\end{aligned}]" :db/id #edb/ref 17592186358331} {:answer/id #uuid "13009bba-61a2-59ec-91a4-6197db58745a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}10 & 5 \\\\ 5 & -1\\end{aligned}]" :db/id #edb/ref 17592186358332} {:answer/id #uuid "c85d660e-c8a4-57f0-ae4d-76aabc4ed523" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}20 & 8 \\\\ 8 & -2\\end{aligned}]" :db/id #edb/ref 17592186358333} {:answer/id #uuid "523884de-d4fc-5a41-87cd-3b4f0b8a2dac" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}19 & 9 \\\\ 9 & -1\\end{aligned}]" :db/id #edb/ref 17592186358334} {:answer/id #uuid "4f9ad094-5364-5eed-aed5-4ab1c63f884f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}11 & 2 \\\\ 2 & -1\\end{aligned}]" :db/id #edb/ref 17592186358335}] :answer-field/correct {:answer/id #uuid "523884de-d4fc-5a41-87cd-3b4f0b8a2dac" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}19 & 9 \\\\ 9 & -1\\end{aligned}]" :db/id #edb/ref 17592186358334} :answer-field/id #uuid "fdcd6a11-441c-56c9-bc03-78f2d5a9d36f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186358330}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "40c684b5-94c1-5b6d-81fc-7b03ac291b23" :question/math-academy-id "q-94189" :question/problem "$$\nA=[\\begin{aligned}0 & 5 \\\\ 5 & -1\\end{aligned}],\\,P=[\\begin{aligned}2 & 0 \\\\ 1 & 1\\end{aligned}]\n