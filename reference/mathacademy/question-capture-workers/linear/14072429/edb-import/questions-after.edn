#{[{:db/id #edb/ref 17592186376072 :knowledge-point/_questions [{:knowledge-point/id #uuid "9171c6fb-ad0b-538f-b982-a2502a20e253" :knowledge-point/title "Solve a Variable in a Vector Lying in the Null Space of a Given Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e392ea66-d551-53c2-8554-546fc1493d3f" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186376074} {:answer/id #uuid "75200a1e-d207-5ae2-9f24-8c47c97e8e94" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186376075} {:answer/id #uuid "8b30c8ac-4195-50b5-b985-d2e4def14266" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186376076} {:answer/id #uuid "782c524b-2ab8-5985-8f00-b4a6fa44a2fa" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186376077} {:answer/id #uuid "bb36cfbd-19d9-5e98-a472-2a11c4bdad4f" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186376078}] :answer-field/correct {:answer/id #uuid "bb36cfbd-19d9-5e98-a472-2a11c4bdad4f" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186376078} :answer-field/id #uuid "63eaf7f6-df07-59d8-9337-9e43bee78e3f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186376073}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "682f5aef-34ba-599c-b950-fe01a998ba88" :question/math-academy-id "q-111106" :question/problem "Consider the matrix $A=[\\begin{aligned}3 & -1 & -2 \\\\ -12 & 4 & 8\\end{aligned}]$ and the vector $b=[\\begin{aligned}2 \\\\ 2k \\\\ 5\\end{aligned}].$ Find the value of $k$ such that $b\\in \\text{Null}(A).$" :question/worked-solution "If $b\\in \\text{Null}(A),$ then we must have $Ab=0.$ Substituting the given information, we get\n\n$$\n\\begin{aligned}Ab & =0 \\\\ [\\begin{aligned}3 & -1 & -2 \\\\ -12 & 4 & 8\\end{aligned}][\\begin{aligned}2 \\\\ 2k \\\\ 5\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}-2k-4 \\\\ 8k+16\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nThis corresponds to the system\n\n$$\n{\\begin{aligned}-2k-4=0 \\\\ 8k+16=0\\end{aligned}\n$$\n\nand for each of these equations, we obtain $k=-2.$"}] [{:db/id #edb/ref 17592186376079 :knowledge-point/_questions [{:knowledge-point/id #uuid "465ce2b7-352e-5050-a5e4-0753fbacebf5" :knowledge-point/title "Finding the Null Space of a Given Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9d83a51b-b017-58dc-bcff-4726e89413e2" :answer/type {:db/ident :answer.type/math} :answer/value "{0}" :db/id #edb/ref 17592186376081} {:answer/id #uuid "f717ecbd-3985-556f-a30a-26c564d92ed9" :answer/type {:db/ident :answer.type/math} :answer/value "{[\\begin{aligned}5{x}_{2} \\\\ {x}_{2}\\end{aligned}]\\,:\\,{x}_{2}\\in R}" :db/id #edb/ref 17592186376082} {:answer/id #uuid "01d62089-4a3c-562a-b997-534bdd36ad40" :answer/type {:db/ident :answer.type/math} :answer/value "{[\\begin{aligned}-3{x}_{2} \\\\ {x}_{2}\\end{aligned}]\\,:\\,{x}_{2}\\in R}" :db/id #edb/ref 17592186376083} {:answer/id #uuid "07867084-4b8b-5c26-a16a-01b6128a74b8" :answer/type {:db/ident :answer.type/math} :answer/value "{[\\begin{aligned}{x}_{1} \\\\ 5{x}_{1}\\end{aligned}]\\,:\\,{x}_{1}\\in R}" :db/id #edb/ref 17592186376084} {:answer/id #uuid "c3c8f96e-25ee-51db-aa90-e92d68b925de" :answer/type {:db/ident :answer.type/math} :answer/value "{[\\begin{aligned}{x}_{1} \\\\ 2{x}_{1}\\end{aligned}]\\,:\\,{x}_{1}\\in R}" :db/id #edb/ref 17592186376085}] :answer-field/correct {:answer/id #uuid "9d83a51b-b017-58dc-bcff-4726e89413e2" :answer/type {:db/ident :answer.type/math} :answer/value "{0}" :db/id #edb/ref 17592186376081} :answer-field/id #uuid "12727051-93f7-536e-8af8-fb8bdd7c3d1b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186376080}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "739127e7-df86-5c25-bc72-b894358ebd1e" :question/math-academy-id "q-111220" :question/problem "Consider the matrix $A=[\\begin{aligned}5 & 15 \\\\ 2 & 3\\end{aligned}].$ Find $\\text{Null}(A).$" :question/worked-solution "We need to solve the equation $Ax=0.$ First, we find the row echelon form of $A$ as follows:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}5 & 15 \\\\ 2 & 3\\end{aligned}] & {R}_{1} & :=\\frac{1}{5}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 \\\\ 2 & 3\\end{aligned}] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 \\\\ 0 & -3\\end{aligned}]\\end{aligned}\n$$\n\nThis corresponds to the following system:\n\n$$\n{\\begin{aligned}{x}_{1}+3{x}_{2}=0 \\\\ -3{x}_{2}=0\\end{aligned}\n$$\n\nThe second equation tells us that ${x}_{2}=0.$ Substituting this into the first equation, we get \n\n$$\n{x}_{1}+3(0)=0\\,⟹\\,{x}_{1}=0.\n$$\n\nSo, we conclude that $x=[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ is the only solution to this system.\n\nTherefore, $\\text{Null}(A)={0}.$"}] [{:db/id #edb/ref 17592186376086 :knowledge-point/_questions [{:knowledge-point/id #uuid "9171c6fb-ad0b-538f-b982-a2502a20e253" :knowledge-point/title "Solve a Variable in a Vector Lying in the Null Space of a Given Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e619774-0508-5439-96ed-36e489aa12d2" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186376088} {:answer/id #uuid "0dee2fa9-6652-551a-9c57-0e5004cf72a7" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186376089} {:answer/id #uuid "1ec80941-a6c5-5e0a-be18-5e53461a129e" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186376090} {:answer/id #uuid "a7ce773a-3c85-5cd9-8e85-422ee01700a6" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186376091} {:answer/id #uuid "6d1c59f6-1320-5d6e-bb1e-cc98e95a26c2" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186376092}] :answer-field/correct {:answer/id #uuid "7e619774-0508-5439-96ed-36e489aa12d2" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186376088} :answer-field/id #uuid "404b4cdd-596a-5f2f-bb05-caa3602d81f8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186376087}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9ab0300e-177d-5524-8d6c-5b7a22cef171" :question/math-academy-id "q-34332" :question/problem "Consider the matrix $A=[\\begin{aligned}1 & 3 \\\\ 2 & 6\\end{aligned}]$ and the vector $b=[\\begin{aligned}k \\\\ 3\\end{aligned}].$ Find the value of $k$ such that $b\\in \\text{Null}(A).$" :question/worked-solution "If $b\\in \\text{Null}(A),$ then we must have $Ab=0.$ Substituting the given information, we get\n\n$$\n\\begin{aligned}Ab & =0 \\\\ [\\begin{aligned}1 & 3 \\\\ 2 & 6\\end{aligned}][\\begin{aligned}k \\\\ 3\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}k+9 \\\\ 2k+18\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nThis corresponds to the system\n\n$$\n{\\begin{aligned}k+9=0 \\\\ 2k+18=0\\end{aligned}\n$$\n\nand for each of these equations, we obtain $k=-9.$"}] [{:db/id #edb/ref 17592186120266 :knowledge-point/_questions [{:knowledge-point/id #uuid "9171c6fb-ad0b-538f-b982-a2502a20e253" :knowledge-point/title "Solve a Variable in a Vector Lying in the Null Space of a Given Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "983ce8c9-da22-51c2-8230-d69ba7732c75" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186118087} {:answer/id #uuid "e2d85b2d-ca22-5aa6-aa48-ce6a76f2afb6" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186118088} {:answer/id #uuid "ee4c185b-ee78-595b-a6f2-6c59a4fb0f49" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186118089} {:answer/id #uuid "26d7eac0-024d-5854-842e-f0f27b217df3" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186118090} {:answer/id #uuid "386c0302-b29c-5a55-8b3b-91bc0a5f2d1b" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186118091}] :answer-field/correct {:answer/id #uuid "e2d85b2d-ca22-5aa6-aa48-ce6a76f2afb6" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186118088} :answer-field/id #uuid "f0f45b2d-b524-516c-a80e-dde65a2ff08c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186118086}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a6c6f7d8-9823-545e-9337-58f3a1ee9d18" :question/math-academy-id "q-34386" :question/problem "Consider the matrix $A=[\\begin{aligned}3 & -1 \\\\ -12 & 4 \\\\ 9 & -3\\end{aligned}]$ and the vector $b=[\\begin{aligned}k \\\\ -6\\end{aligned}].$ Find the value of $k$ such that $b\\in \\text{Null}(A).$" :question/worked-solution "If $b\\in \\text{Null}(A),$ then we must have $Ab=0.$ Substituting the given information, we get\n\n$$\n\\begin{aligned}Ab & =0 \\\\ [\\begin{aligned}3 & -1 \\\\ -12 & 4 \\\\ 9 & -3\\end{aligned}][\\begin{aligned}k \\\\ -6\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}3k+6 \\\\ -12k-24 \\\\ 9k+18\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nThis corresponds to the system\n\n$$\n{\\begin{aligned}3k+6=0 \\\\ -12k-24=0 \\\\ 9k+18=0\\end{aligned}\n$$\n\nand for each of these equations, we obtain $k=-2.$"}] [{:db/id #edb/ref 17592186376093 :knowledge-point/_questions [{:knowledge-point/id #uuid "465ce2b7-352e-5050-a5e4-0753fbacebf5" :knowledge-point/title "Finding the Null Space of a Given Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d6a9547-2a4f-5490-9c08-65ac44f4d86c" :answer/type {:db/ident :answer.type/math} :answer/value "{[\\begin{aligned}{x}_{2} \\\\ 2{x}_{2}\\end{aligned}]\\,:\\,{x}_{2}\\in R}" :db/id #edb/ref 17592186376095} {:answer/id #uuid "f059266a-a7f3-5344-8c6c-42db47c7888f" :answer/type {:db/ident :answer.type/math} :answer/value "{0}" :db/id #edb/ref 17592186376096} {:answer/id #uuid "290b4165-aa66-5e51-ad4f-86fee87f212e" :answer/type {:db/ident :answer.type/math} :answer/value "{[\\begin{aligned}{x}_{1} \\\\ -3{x}_{1}\\end{aligned}]\\,:\\,{x}_{1}\\in R}" :db/id #edb/ref 17592186376097} {:answer/id #uuid "b5f60cb2-453b-5c85-904c-116215276d9f" :answer/type {:db/ident :answer.type/math} :answer/value "{[\\begin{aligned}{x}_{1} \\\\ -2{x}_{1}\\end{aligned}]\\,:\\,{x}_{1}\\in R}" :db/id #edb/ref 17592186376098} {:answer/id #uuid "08918d39-44aa-5f39-833a-6c9dbb32bef5" :answer/type {:db/ident :answer.type/math} :answer/value "{[\\begin{aligned}2{x}_{2} \\\\ {x}_{2}\\end{aligned}]\\,:\\,{x}_{2}\\in R}" :db/id #edb/ref 17592186376099}] :answer-field/correct {:answer/id #uuid "f059266a-a7f3-5344-8c6c-42db47c7888f" :answer/type {:db/ident :answer.type/math} :answer/value "{0}" :db/id #edb/ref 17592186376096} :answer-field/id #uuid "7a419f81-b96c-51b9-8652-2aa6345ae4cb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186376094}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "57a059f0-c824-55bd-a26c-4a4da9804f71" :question/math-academy-id "q-34392" :question/problem "Consider the matrix $A=[\\begin{aligned}2 & 4 \\\\ 2 & 5\\end{aligned}].$ Find $\\text{Null}(A).$" :question/worked-solution "We need to solve the equation $Ax=0.$ First, we find the row echelon form of $A$ as follows:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2 & 4 \\\\ 2 & 5\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 \\\\ 2 & 5\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 \\\\ 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nThis corresponds to the following system:\n\n$$\n{\\begin{aligned}{x}_{1}+2{x}_{2}=0 \\\\ {x}_{2}=0\\end{aligned}\n$$\n\nThe second equation tells us that ${x}_{2}=0.$ Substituting this into the first equation, we get \n\n$$\n{x}_{1}+2(0)=0\\,⟹\\,{x}_{1}=0.\n$$\n\nSo, we conclude that $x=[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ is the only solution to this system.\n\nTherefore, $\\text{Null}(A)={0}.$"}]}
