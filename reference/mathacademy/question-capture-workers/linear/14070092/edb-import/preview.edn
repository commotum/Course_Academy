 \\\\ 1 & -1\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{2\\cdot (-1)-1\\cdot (-1)}[\\begin{aligned}-1 & 1 \\\\ -1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -1 \\\\ 1 & -2\\end{aligned}]\\end{aligned}\n$$\n\nNow, we can compute the matrix of $T$ relative to the basis $C:$\n\n$$\n\\begin{aligned}[T]_{C} & ={P}_{B\\to C}\\cdot [T]_{B}\\cdot {P}_{B\\to C}^{-1} \\\\  & =[\\begin{aligned}2 & -1 \\\\ 1 & -1\\end{aligned}][\\begin{aligned}1 & -5 \\\\ 2 & -8\\end{aligned}][\\begin{aligned}1 & -1 \\\\ 1 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}0 & -2 \\\\ -1 & 3\\end{aligned}][\\begin{aligned}1 & -1 \\\\ 1 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 4 \\\\ 2 & -5\\end{aligned}]\\end{aligned}\n$$" 13194139535754 true] [17592186364841 1017 #edb/ref 17592186364842 13194139535754 true] [17592186364841 1089 "q-140482" 13194139535754 true] [17592186364841 1091 #edb/ref 17592186045465 13194139535754 true] [17592186364841 1100 "$$\nB={[\\begin{aligned}4 \\\\ -1\\end{aligned}],[\\begin{aligned}5 \\\\ -1\\end{aligned}]},\\,[T]_{B}=[\\begin{aligned}-2 & 1 \\\\ 3 & -1\\end{aligned}]\n$$\n\nConsider the basis $B$ of ${R}^{2}$ and the matrix $[T]_{B}$ of a linear transformation $T$ with respect to this basis. Find the matrix of $T$ relative to the standard basis $S.$" 13194139535754 true] [17592186364841 1113 #uuid "81e8f58d-3db1-5493-9653-beb052e8ad62" 13194139535754 true] [17592186364841 1145 "The connection between the matrices of our linear transformation $T$ relative to the basis $B$ and standard basis $S$ is given by the following diagram:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070092/assets/dbd020362f950fe8bfb4c592652b9e78a73610fa01a247b0b7ead6f201bf9ea5.png)\n\nHere, moving along an arrow means pre-multiplying by the corresponding matrix. Algebraically, we can write this as\n\n$$\n[T]_{S}={P}_{B\\to S}\\cdot [T]_{B}\\cdot {P}_{B\\to S}^{-1},\n$$\n\nand the change-of-coordinates matrix from $B$ to $S$ is\n\n$$\n{P}_{B\\to S}=[\\begin{aligned}4 & 5 \\\\ -1 & -1\\end{aligned}].\n$$\n\nFirst, we compute the inverse of ${P}_{B\\to S}:$\n\n$$\n\\begin{aligned}{P}_{B\\to S}^{-1} & ={[\\begin{aligned}4 & 5 \\\\ -1 & -1\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{4\\cdot (-1)-(-1)\\cdot 5}[\\begin{aligned}-1 & -5 \\\\ 1 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & -5 \\\\ 1 & 4\\end{aligned}].\\end{aligned}\n$$\n\nNow, we can compute the matrix of $T$ relative to the standard basis $S:$\n\n$$\n\\begin{aligned}[T]_{S} & ={P}_{B\\to S}\\cdot [T]_{B}\\cdot {P}_{B\\to S}^{-1} \\\\  & =[\\begin{aligned}4 & 5 \\\\ -1 & -1\\end{aligned}][\\begin{aligned}-2 & 1 \\\\ 3 & -1\\end{aligned}][\\begin{aligned}-1 & -5 \\\\ 1 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}7 & -1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}-1 & -5 \\\\ 1 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}-8 & -39 \\\\ 1 & 5\\end{aligned}]\\end{aligned}\n$$" 13194139535754 true] [17592186364842 1000 #edb/ref 17592186364843 13194139535754 true] [17592186364842 1000 #edb/ref 17592186364844 13194139535754 true] [17592186364842 1000 #edb/ref 17592186364845 13194139535754 true] [17592186364842 1000 #edb/ref 17592186364846 13194139535754 true] [17592186364842 1000 #edb/ref 17592186364847 13194139535754 true] [17592186364842 1040 #edb/ref 17592186045450 13194139535754 true] [17592186364842 1041 "selection" 13194139535754 true] [17592186364842 1104 #edb/ref 17592186364845 13194139535754 true] [17592186364842 1110 #uuid "21999da2-cdb2-5afa-a867-f7b96c23e2f1" 13194139535754 true] [17592186364843 1034 "[\\begin{aligned}-8 & 5 \\\\ 39 & 5\\end{aligned}]" 13194139535754 true] [17592186364843 1103 #edb/ref 17592186045453 13194139535754 true] [17592186364843 1111 #uuid "51d599af-36d8-560c-940b-0d2c5e18e818" 13194139535754 true] [17592186364844 1034 "[\\begin{aligned}-39 & 8 \\\\ 5 & 1\\end{aligned}]" 13194139535754 true] [17592186364844 1103 #edb/ref 17592186045453 13194139535754 true] [17592186364844 1111 #uuid "baee1d1b-d00c-5acb-9