[{:db/id "q-316575/field-1/ac46d580a95a8fc03d1a7cb07de70e107b73fba6bf1bc1d13103b84eff3df012" :answer/id #uuid "3d1f3828-f31c-570e-948a-c5a959bb229f" :answer/type :answer.type/math :answer/value "17" :db/ensure [:answer/validate]} {:db/id "q-316575/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "5e81e5d6-b197-50e5-a23f-d13afa3d0cd5" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-316575/field-1" :answer-field/id #uuid "5abbb853-ab0b-5c4f-97bb-159a62a91d68" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316575/field-1/ac46d580a95a8fc03d1a7cb07de70e107b73fba6bf1bc1d13103b84eff3df012" :answer-field/choices ["q-316575/field-1/ac46d580a95a8fc03d1a7cb07de70e107b73fba6bf1bc1d13103b84eff3df012" "q-316575/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-316575" :question/id #uuid "fcf34534-2c61-54db-b1c3-099052444c8a" :question/math-academy-id "q-316575" :question/problem "What is the area scale factor of the linear transformation $T$ that is given by its standard matrix \n\n$$\nT=[\\begin{aligned}9 & -4 \\\\ 2 & 1\\end{aligned}]?\n$$\n\nThe area scale factor is\n{{field-1}} ." :question/worked-solution "The area scale factor of a linear transformation $T$ with standard matrix $T$ is equal to $|det(T)|.$ Therefore,\n\n$$\n\\begin{aligned}|det(T)| & =|9\\cdot 1-(-4)\\cdot 2| \\\\  & =|9-(-8)| \\\\  & =17.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-316575/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "80a4eee7-a763-5c28-ae3c-5bce78222c87"] :knowledge-point/questions ["q-316575"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316571/field-1/cc5dbf87f4dbee91d1c29e8013069443539b3fd684157fee71e97221215a4d5e" :answer/id #uuid "ab5753c5-998a-5dec-bab6-50b8ad460865" :answer/type :answer.type/