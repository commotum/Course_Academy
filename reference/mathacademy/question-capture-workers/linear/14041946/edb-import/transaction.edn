7c639f1bef83a5c0d4317dbeb85d0221d56cacba4b" :answer-field/choices ["q-20594/selection/ma-v1/c30aecdb094c4923479a028bbc40e1fb5dfb7a96a216b033e67cdfab869c460b/40298cc9be3ca03144bdbd27dc06026f9232e645e13eb7db421090e9ad8eb742" "q-20594/selection/ma-v1/c30aecdb094c4923479a028bbc40e1fb5dfb7a96a216b033e67cdfab869c460b/b7eb2766c1a960035afc3a883fd1d32f155b5217e312dffee52e1c12d1ff8eec" "q-20594/selection/ma-v1/c30aecdb094c4923479a028bbc40e1fb5dfb7a96a216b033e67cdfab869c460b/9df73fe02b89ccd74228fa7c639f1bef83a5c0d4317dbeb85d0221d56cacba4b" "q-20594/selection/ma-v1/c30aecdb094c4923479a028bbc40e1fb5dfb7a96a216b033e67cdfab869c460b/a1f82d7b97a2b1edf5886e37b62be499ee0e0453172880db30948136a866084d" "q-20594/selection/ma-v1/c30aecdb094c4923479a028bbc40e1fb5dfb7a96a216b033e67cdfab869c460b/4f2be2f065b2c98e61a1959b257d5529c79fd6623b4e8fb1d708ca82d90390c1"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-20594"] :question/problem "Consider the following system of linear equations:\n\n$$\n{\\begin{aligned} & x+2y+z=14 \\\\  & y+z=8 \\\\  & z=4\\end{aligned}\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}1 & 2 & 1 & 14 \\\\ 0 & 1 & 1 & 8 \\\\ 0 & 0 & 1 & 4\\end{aligned}].\n$$\n\nNotice that the matrix $M$ is already in row echelon form.\n\nTransforming $M$ to reduced row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 2 & 1 & 14 \\\\ 0 & 1 & 1 & 8 \\\\ 0 & 0 & 1 & 4\\end{aligned}] & {R}_{2} & :={R}_{2}+(-1){R}_{3} \\\\  & ∼[\\begin{aligned}1 & 2 & 1 & 14 \\\\ 0 & 1 & 0 & 4 \\\\ 0 & 0 & 1 & 4\\end{aligned}] & {R}_{1} & :={R}_{1}+(-1){R}_{3} \\\\  & ∼[\\begin{aligned}1 & 2 & 0 & 10 \\\\ 0 & 1 & 0 & 4 \\\\ 0 & 0 & 1 & 4\\end{aligned}] & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 2 \\\\ 0 & 1 & 0 & 4 \\\\ 0 & 0 & 1 & 4\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-20594/selection/ma-v1/c30aecdb094c4923479a028bbc40e1fb5dfb7a96a216b033e67cdfab869c460b"] :db/ensure [:question/validate]} {:db/id "q-20600/selection/05db9d3fbb4b6272e7537f839979953b4110e57acf584185ac57af8ae556409e" :answer/id #uuid "f15d7d86-0a78-59ba-9953-c1b9808e9c42" :answer/type :answer.type/math :answer/value "M∼[\\begin{aligned}1 & 0 & 0 & -76 \\\\ 0 & 1 & 0 & -19 \\\\ 0 & 0 & 1 & 19\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-20600/selection/222270cfb1efe1f5ae0463bba1ce6940beca40173170ee49335f4f4859fabd71" :answer/id #uuid "907f6065-c5e7-56c8-ad69-ed0dc14b3f01" :answer/type :answer.type/math :answer/value "M∼[\\begin{aligned}1 & 0 & 0 & 76 \\\\ 0 & 1 & 0 & -19 \\\\ 0 & 0 & 1 & -19\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-20600/selection/8a77238fe9926ec8e39628762cdab9adecb65e46a888a0b18603d46984f648e7" :answer/id #uuid "5add4e2f-0beb-5862-9aca-c82939eb47e2" :answer/type :answer.type/math :answer/value "M∼[\\begin{aligned}1 & 0 & 0 & 76 \\\\ 0 & 1 & 0 & 19 \\\\ 0 & 0 & 1 & -19\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-20600/selection/594f41369939c6ed6e771b49e7e643c3a9d8a92cc8c1f1bbe36c0c83b0a08f76" :answer/id #uuid "fcf6f3b4-c328-5264-82cc-1305fc832da6" :answer/type :answer.type/math :answer/value "M∼[\\begin{aligned}1 & 0 & 0 & 76 \\\\ 0 & 1 & 0 & 19 \\\\ 0 & 0 & 1 & 19\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-20600/selection/9ad4d9ed1c146256e2cb9bd70c4904f1733bd1786e10220e15921760e6f097f2" :answer/id #uuid "c1ff9c71-c2cc-5014-9f35-ceb2c4db926d" :answer/type :answer.type/math :answer/value "M∼[\\begin{aligned}1 & 0 & 0 & -76 \\\\ 0 & 1 & 0 & 19 \\\\ 0 & 0 & 1 & -19\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-20600/selection" :answer-field/id #uuid "42028ccf-2a1a-5e37-b15d-5099fcc992b0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-20600/selection/594f41369