[{:db/id "q-20593/selection/f38e0b197c8a11f96647278aecb1e197051b642385047765676946fd4dccd418" :answer/id #uuid "70276a26-fb3c-5353-b556-5d4b73a44c27" :answer/type :answer.type/math :answer/value "⟨18,-2,-1⟩" :db/ensure [:answer/validate]} {:db/id "q-20593/selection/c2aa64ab1c1f884d93bfa587ac4872d045f7c013697aa5e077664d935bcd590d" :answer/id #uuid "c91e6593-6f33-521f-8ef2-eeb5f9c8de78" :answer/type :answer.type/math :answer/value "⟨18,3,1⟩" :db/ensure [:answer/validate]} {:db/id "q-20593/selection/d6502c2926a4653849fc853b9430cba3f43acffb72ca43277d33057253c6fe52" :answer/id #uuid "12bb729b-7f21-52e0-a38f-3c914c1391a3" :answer/type :answer.type/math :answer/value "⟨18,-3,1⟩" :db/ensure [:answer/validate]} {:db/id "q-20593/selection/4fe0eab8de5b22ed1fbb130106a466b0e00385ed9fbb3d85fd3c57a04c93666c" :answer/id #uuid "f416160d-b75d-5719-883b-2010769a2a8b" :answer/type :answer.type/math :answer/value "⟨11,-3,2⟩" :db/ensure [:answer/validate]} {:db/id "q-20593/selection/77219580e38bc4f5898dfe4dbaf2f74b2a91dc58d12a0e30684b0ffd875b43e4" :answer/id #uuid "ef86fce3-24cb-55cb-b8b6-ec1b07171737" :answer/type :answer.type/math :answer/value "⟨11,-3,-1⟩" :db/ensure [:answer/validate]} {:db/id "q-20593/selection" :answer-field/id #uuid "511cb7bf-5a78-56b1-95af-cd2abc317bdf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-20593/selection/d6502c2926a4653849fc853b9430cba3f43acffb72ca43277d33057253c6fe52" :answer-field/choices ["q-20593/selection/f38e0b197c8a11f96647278aecb1e197051b642385047765676946fd4dccd418" "q-20593/selection/c2aa64ab1c1f884d93bfa587ac4872d045f7c013697aa5e077664d935bcd590d" "q-20593/selection/d6502c2926a4653849fc853b9430cba3f43acffb72ca43277d33057253c6fe52" "q-20593/selection/4fe0eab8de5b22ed1fbb130106a466b0e00385ed9fbb3d85fd3c57a04c93666c" "q-20593/selection/77219580e38bc4f5898dfe4dbaf2f74b2a91dc58d12a0e30684b0ffd875b43e4"] :db/ensure [:answer-field/validate]} {:db/id "q-20593" :question/id #uuid "9d332a99-8bbc-56fb-8ba7-600e6e7b5c79" :question/math-academy-id "q-20593" :question/problem "Consider the following system of linear equations:\n\n$$\n{\\begin{aligned} & x+5y-2z=1 \\\\  & y+3z=0 \\\\  & z=1\\end{aligned}\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}1 & 5 & -2 & 1 \\\\ 0 & 1 & 3 & 0 \\\\ 0 & 0 & 1 & 1\\end{aligned}].\n$$\n\nNotice that the matrix $M$ is already in row echelon form.\n\nTransforming $M$ to reduced row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 5 & -2 & 1 \\\\ 0 & 1 & 3 & 0 \\\\ 0 & 0 & 1 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{3} \\\\  & ∼[\\begin{aligned}1 & 5 & -2 & 1 \\\\ 0 & 1 & 0 & -3 \\\\ 0 & 0 & 1 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+2{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 5 & 0 & 3 \\\\ 0 & 1 & 0 & -3 \\\\ 0 & 0 & 1 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+(-5){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 18 \\\\ 0 & 1 & 0 & -3 \\\\ 0 & 0 & 1 & 1\\end{aligned}].\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n{\\begin{aligned} & x=18 \\\\  & y=-3 \\\\  & z=1.\\end{aligned}\n$$\n\nSo, we have the solution $x=18$, $y=-3$, and $z=1.$ Or, in vector form $⟨18,-3,1⟩.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-20593/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7294399b-b139-5ee6-824c-5e28e4fc49ff"] :knowledge-point/questions ["q-20593"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186097103 :question/answer-fields 17592186095024] {:db/id "q-20594/selection/ma-v1/c30aecdb094c4923479a028bbc40e1fb5dfb7a96a216b033e67cdfab869c460b/40298cc9be3ca03144bdbd27dc06026f9232e645e13eb7db421090e9ad8eb742" :answer/id #uuid "5080adc4-860c-53fd-ae12-9eb3c597c02c" :answer/type :answer.type/math :answer/value "M∼[\\begin{aligned}1 & 0 &