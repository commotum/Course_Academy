}3 \\\\ -2\\end{aligned}]\n$$" :question/worked-solution "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{C\\to B}[\\,x\\,]_{C}.\n$$\n\nFirst, we need to find the change-of-coordinates matrix ${P}_{C\\to B}$ from $C$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to C}:$\n\n$$\n\\begin{aligned}{P}_{C\\to B} & ={P}_{B\\to C}^{-1} \\\\  & ={[\\begin{aligned}-2 & 3 \\\\ 3 & -4\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{(-2)\\cdot (-4)-3\\cdot 3}[\\begin{aligned}-4 & -3 \\\\ -3 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}4 & 3 \\\\ 3 & 2\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{C\\to B}[\\,x\\,]_{C} \\\\  & =[\\begin{aligned}4 & 3 \\\\ 3 & 2\\end{aligned}][\\begin{aligned}3 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}6 \\\\ 5\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-36485/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5ee52fd3-6c79-5016-ade5-46e7bfbb557a"] :knowledge-point/questions ["q-36485"] :db/ensure [:knowledge-point/validate]} {:db/id "q-82606/selection/60eadf18022e36714cee17e0479ab6af66a6361ceef7571ec8305b4e57ee6d8f" :answer/id #uuid "93797343-f39b-5253-a57c-259d8af8990a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-82606/selection/b70163afa80242b6e07599db9e6649592c88c8df8d6892329736a0a5f2ef7d0f" :answer/id #uuid "97d19949-449d-5a4f-b324-4c44d4904e05" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-82606/selection/89a7b50043145b047ec0b49f3140fd1e1b3e4de0bc9d81a9f50ac0b4c1e9f136" :answer/id #uuid "75af1432-bcb0-5e00-9e3a-abbc3bf0e07f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-82606/selection/89509341da3fc059d3fae3c08ea87f7c7273dd2cfed4f405dd9f061ed448811c" :answer/id #uuid "f36ed0a2-0729-5cdc-8262-db354881bb59" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-82606/selection/ad362d7ed109b6a7fddafec2294f88d02e0a983775d131c6b2ec5ca62befc3b7" :answer/id #uuid "1a5fbb3c-7ca9-58bb-a1b7-9a9e452ab373" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-82606/selection" :answer-field/id #uuid "c3e1d407-5828-550a-869c-a3bedef1b8ca" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-82606/selection/89509341da3fc059d3fae3c08ea87f7c7273dd2cfed4f405dd9f061ed448811c" :answer-field/choices ["q-82606/selection/60eadf18022e36714cee17e0479ab6af66a6361ceef7571ec8305b4e57ee6d8f" "q-82606/selection/b70163afa80242b6e07599db9e6649592c88c8df8d6892329736a0a5f2ef7d0f" "q-82606/selection/89a7b50043145b047ec0b49f3140fd1e1b3e4de0bc9d81a9f50ac0b4c1e9f136" "q-82606/selection/89509341da3fc059d3fae3c08ea87f7c7273dd2cfed4f405dd9f061ed448811c" "q-82606/selection/ad362d7ed109b6a7fddafec2294f88d02e0a983775d131c6b2ec5ca62befc3b7"] :db/ensure [:answer-field/validate]} {:db/id "q-82606" :question/id #uuid "5c7d63da-59ab-5308-9b89-bf650fb9db9b" :question/math-academy-id "q-82606" :question/problem "$$\nB={[\\begin{aligned}5 \\\\ 1\\end{aligned}],[\\begin{aligned}9 \\\\ 2\\end{aligned}]},\\,[x]_{S}=[\\begin{aligned}4 \\\\ 1\\end{aligned}]\n$$\n\nThe basis $B$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the standard basis $S$ are given above. Find $[x]_{B}.$" :question/worked-solution "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{S\\to B}[\\,x\\,]_{S}.\n$$\n\nFirst, recall that the change-of-coordinates matrix from $B$ to $S$ is the matrix whose columns are the vectors of $B$ relative to the standard basis $S.$ As a result, we have\n\n$$\n{P}_{B\\to S}=[\\begin{aligned}5 & 9 \\\\ 1 & 2\\end{aligned}].\n$$\n\nNow, we need to find the change-of-coordinates matrix ${P}_{S\\to B}$ from $S$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to S}:$\n\n$$\n\\begin{aligned}{P}_{S\\to B} & ={P}_{B\\to S}^{-1} \\\\  & ={[\\begin{aligned}5 & 9 \\\\ 1 & 2\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{5\\cdot 2-1\\cdot 9}[\\begin{aligned}2 & -9 \\\\ -1 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -9 \\\\ -1 & 5\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{S\\to B}[\\,x\\,]_{S} \\\\  & =[\\begin{aligned}2 & -9 \\\\ -1 & 5\\end{aligned}][\\begin{aligned}4 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ 1\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-82606/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7f58bd46-07f7-54a5-8499-5e4e3515b610"] :knowledge-point/questions ["q-82606"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113600/selection/7189317aedfc40b23dc0b9a05c8c02efb7fa79006a69b9827915e8b612a5108a" :answer/id #uuid "3df5c619-45ff-5560-8d34-b9c04c34658b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}5 \\\\ -5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-113600/selection/8ac02d42466f861ccee911e7657dead06f1054031678b6630f1908febe452f2a" :answer/id #uuid "3d96d5cb-02b4-57d5-832d-87245c082ef4" :answer/type :answer.type/math :answer/value "[\\begin{aligned}5 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-113600/selection/2093990367ba7b97949c977999ea8a195105038043cc7441027e3bfa232d9581" :answer/id #uuid "21cd7bd8-853e-5079-a2b2-721d3f3f62eb" :answer/type :answer.type/math :answer/value "[\\begin{aligned}15 \\\\ -5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-113600/selection/1798577a5fd9e7d5e87ac0b4a0c282029c832cc07998196cf6713927ba4a88f3" :answer/id #uuid "06a9c4b2-ebfc-5072-9f30-9c6531214443" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ -4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-113600/selection/51a095e0b68bf5e4f23f4ce05cd97d0463c784481999fd29715f89caae21911b" :answer/id #uuid "d17e0ee8-6ce9-562e-ab26-3e7a77e0bed5" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-113600/selection" :answer-field/id #uuid "f9693b81-a126-53c8-b953-7e75595ff4e3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113600/selection/7189317aedfc40b23dc0b9a05c8c02efb7fa79006a69b9827915e8b612a5108a" :answer-field/choices ["q-113600/selection/7189317aedfc40b23dc0b9a05c8c02efb7fa79006a69b9827915e8b612a5108a" "q-113600/selection/8ac02d42466f861ccee911e7657dead06f1054031678b6630f1908febe452f2a" "q-113600/selection/2093990367ba7b97949c977999ea8a195105038043cc7441027e3bfa232d9581" "q-113600/selection/1798577a5fd9e7d5e87ac0b4a0c282029c832cc07998196cf6713927ba4a88f3" "q-113600/selection/51a095e0b68bf5e4f23f4ce05cd97d0463c784481999fd29715f89caae21911b"] :db/ensure [:answer-field/validate]} {:db/id "q-113600" :question/id #uuid "23f9d4a3-d1ff-5ea8-befa-ca07b6f0d60b" :question/math-academy-id "q-113600" :question/problem "$$\nB={[\\begin{aligned}6 \\\\ 5\\end{aligned}],[\\begin{aligned}3 \\\\ 3\\end{aligned}]},\\,[x]_{S}=[\\begin{aligned}15 \\\\ 10\\end{aligned}]\n$$\n\nThe basis $B$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the standard basis $S$ are given above. Find $[x]_{B}.$" :question/worked-solution "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{S\\to B}[\\,x\\,]_{S}.\n$$\n\nFirst, recall that the change-of-coordinates matrix from $B$ to $S$ is the matrix whose columns are the vectors of $B$ relative to the standard basis $S.$ As a result, we have\n\n$$\n{P}_{B\\to S}=[\\begin{aligned}6 & 3 \\\\ 5 & 3\\end{aligned}].\n$$\n\nNow, we need to find the change-of-coordinates matrix ${P}_{S\\to B}$ from $S$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to S}:$\n\n$$\n\\begin{aligned}{P}_{S\\to B} & ={P}_{B\\to S}^{-1} \\\\  & ={[\\begin{aligned}6 & 3 \\\\ 5 & 3\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{6\\cdot 3-3\\cdot 5}[\\begin{aligned}3 & -3 \\\\ -5 & 6\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -1 \\\\ -\\frac{5}{3} & 2\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{S\\to B}[\\,x\\,]_{S} \\\\  & =[\\begin{aligned}1 & -1 \\\\ -\\frac{5}{3} & 2\\end{aligned}][\\begin{aligned}15 \\\\ 10\\end{aligned}] \\\\  & =[\\begin{aligned}5 \\\\ -5\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-113600/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7f58bd46-07f7-54a5-8499-5e4e3515b610"] :knowledge-point/questions ["q-113600"] :db/ensure [:knowledge-point/validate]} {:db/id "q-82609/selection/5ed8af327ac25676f1b345435985b2a3c1ed53e5ae6a9bf019e4c1a0baad6f50" :answer/id #uuid "d64c21b9-ed97-576b-90e8-1b69dcb5e9a3" :answer/type :answer.type/math :answer/value "[\\begin{aligned}12 \\\\ -17\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-82609/selection/1798577a5fd9e7d5e87ac0b4a0c282029c832cc07998196cf6713927ba4a88f3" :answer/id #uuid "5722a19c-9c8a-5b3d-acb8-7d8aa432b1c3" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ -4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-82609/selection/a86bedf157b2f776b388d945ba4c86ac9d9c6639b123b029f803c24222082bc3" :answer/id #uuid "33d71ede-cada-5028-91b4-2bcd9dc57b24" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-10 \\\\ -18\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-82609/selection/1c5bec42b88e137164891c2f679bb1f4cb4e84d9ad07ef230df2535f2e499601" :answer/id #uuid "4b862f5b-4e5d-5dc9-b495-3748172dc716" :answer/type :answer.type/math :answer/value "[\\begin{aligned}8 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-82609/selection/c0bb241511534a82ed83bf9f68ac61e0b32368db71a28bd7cf3b67bde4af7283" :answer/id #uuid "1d56caab-fee8-5bcb-a88f-a1fb3ee19e06" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-82609/selection" :answer-field/id #uuid "601d36a9-7427-50eb-bf75-b9775ab51a77" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-82609/selection/a86bedf157b2f776b388d945ba4c86ac9d9c6639b123b029f803c24222082bc3" :answer-field/choices ["q-82609/selection/5ed8af327ac25676f1b345435985b2a3c1ed53e5ae6a9bf019e4c1a0baad6f50" "q-82609/selection/1798577a5fd9e7d5e87ac0b4a0c282029c832cc07998196cf6713927ba4a88f3" "q-82609/selection/a86bedf157b2f776b388d945ba4c86ac9d9c6639b123b029f803c24222082bc3" "q-82609/selection/1c5bec42b88e137164891c2f679bb1f4cb4e84d9ad07ef230df2535f2e499601" "q-82609/selection/c0bb241511534a82ed83bf9f68ac61e0b32368db71a28bd7cf3b67bde4af7283"] :db/ensure [:answer-field/validate]} {:db/id "q-82609" :question/id #uuid "13aef9df-8682-5fe0-a906-e0817933e236" :question/math-academy-id "q-82609" :question/problem "$$\nB={[\\begin{aligned}7 \\\\ -2\\end{aligned}],[\\begin{aligned}-4 \\\\ 1\\end{aligned}]},\\,[x]_{S}=[\\begin{aligned}2 \\\\ 2\\end{aligned}]\n$$\n\nThe basis $B$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the standard basis $S$ are given above. Find $[x]_{B}.$" :question/worked-solution "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{S\\to B}[\\,x\\,]_{S}.\n$$\n\nFirst, recall that the change-of-coordinates matrix from $B$ to $S$ is the matrix whose columns are the vectors of $B$ relative to the standard basis $S.$ As a result, we have\n\n$$\n{P}_{B\\to S}=[\\begin{aligned}7 & -4 \\\\ -2 & 1\\end{aligned}].\n$$\n\nNow, we need to find the change-of-coordinates matrix ${P}_{S\\to B}$ from $S$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to S}:$\n\n$$\n\\begin{aligned}{P}_{S\\to B} & ={P}_{B\\to S}^{-1} \\\\  & ={[\\begin{aligned}7 & -4 \\\\ -2 & 1\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{7\\cdot 1-(-2)\\cdot (-4)}[\\begin{aligned}1 & 4 \\\\ 2 & 7\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & -4 \\\\ -2 & -7\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{S\\to B}[\\,x\\,]_{S} \\\\  & =[\\begin{aligned}-1 & -4 \\\\ -2 & -7\\end{aligned}][\\begin{aligned}2 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}-10 \\\\ -18\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-82609/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7f58bd46-07f7-54a5-8499-5e4e3515b610"] :knowledge-point/questions ["q-82609"] :db/ensure [:knowledge-point/validate]} {:db/id "q-82710/selection/c25b4c5a34c9f50ba5cab12d26d91674670de71293237dd889d3975aa50ccc8f" :answer/id #uuid "aa892a16-484c-5d8e-ae0c-eff3da5f831e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-82710/selection/24f78033319177443dd5769d55ae21d6c6a8ed86bc7ec708320832265a389541" :answer/id #uuid "eec5fb2a-19da-564a-8d6a-ccae7569cce9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-7 \\\\ 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-82710/selection/6e7d450d841cb7ba0bc7a13d7eb348aadaa42c7e5755c9e05e221a8418b45108" :answer/id #uuid "c9d71378-186c-536b-94c2-50483d91220e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ -5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-82710/selection/64016bee11c110718ed4fa5affa1338833add0794a386797f22b2a6d8512dc99" :answer/id #uuid "15c57bb7-f026-53c6-847e-baf6a41324b6" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-82710/selection/2abc78f7808485d66e1af0c4afa164d186ae9695fc4e445022e90dab89030120" :answer/id #uuid "01766fdb-471a-5d95-97db-f827c967d37a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-82710/selection" :answer-field/id #uuid "99eac267-fe36-52c0-99c7-2da0925288e9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-82710/selection/2abc78f7808485d66e1af0c4afa164d186ae9695fc4e445022e90dab89030120" :answer-field/choices ["q-82710/selection/c25b4c5a34c9f50ba5cab12d26d91674670de71293237dd889d3975aa50ccc8f" "q-82710/selection/24f78033319177443dd5769d55ae21d6c6a8ed86bc7ec708320832265a389541" "q-82710/selection/6e7d450d841cb7ba0bc7a13d7eb348aadaa42c7e5755c9e05e221a8418b45108" "q-82710/selection/64016bee11c110718ed4fa5affa1338833add0794a386797f22b2a6d8512dc99" "q-82710/selection/2abc78f7808485d66e1af0c4afa164d186ae9695fc4e445022e90dab89030120"] :db/ensure [:answer-field/validate]} {:db/id "q-82710" :question/id #uuid "6bfae3e3-2776-5559-98d8-7fc88a34d766" :question/math-academy-id "q-82710" :question/problem "$$\nB={[\\begin{aligned}4 \\\\ 11\\end{aligned}],[\\begin{aligned}1 \\\\ 3\\end{aligned}]},\\,[x]_{S}=[\\begin{aligned}2 \\\\ 5\\end{aligned}]\n$$\n\nThe basis $B$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the standard basis $S$ are given above. Find $[x]_{B}.$" :question/worked-solution "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{S\\to B}[\\,x\\,]_{S}.\n$$\n\nFirst, recall that the change-of-coordinates matrix from $B$ to $S$ is the matrix whose columns are the vectors of $B$ relative to the standard basis $S.$ As a result, we have\n\n$$\n{P}_{B\\to S}=[\\begin{aligned}4 & 1 \\\\ 11 & 3\\end{aligned}].\n$$\n\nNow, we need to find the change-of-coordinates matrix ${P}_{S\\to B}$ from $S$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to S}:$\n\n$$\n\\begin{aligned}{P}_{S\\to B} & ={P}_{B\\to S}^{-1} \\\\  & ={[\\begin{aligned}4 & 1 \\\\ 11 & 3\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{4\\cdot 3-11\\cdot 1}[\\begin{aligned}3 & -1 \\\\ -11 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}3 & -1 \\\\ -11 & 4\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{S\\to B}[\\,x\\,]_{S} \\\\  & =[\\begin{aligned}3 & -1 \\\\ -11 & 4\\end{aligned}][\\begin{aligned}2 \\\\ 5\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ -2\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-82710/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7f58bd46-07f7-54a5-8499-5e4e3515b610"] :knowledge-point/questions ["q-82710"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113689/selection/fc4e2cf106841016abafd2875d67ff73af65a59d2ae61b8b12fe8b80bbbe07ac" :answer/id #uuid "67592d84-9886-5622-b298-c8037aa2b414" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-113689/selection/bcf965bd290e223b17dfdadc7b50fe8a18cfb34e6cd446742ad483581bda7281" :answer/id #uuid "bf7e9078-7c45-534a-b620-1ee7051832eb" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-9 \\\\ 8\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-113689/selection/6f6b16e92e6c7c05c85225345bff463fdc97cce4342305c9c746402e13a0b200" :answer/id #uuid "cd1977de-45ab-5e22-b735-0ca3cccc02a2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-11 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-113689/selection/8492608054a267cc425c8eb3b5946844a2a80022f7b456ab2d9eae49c53be7f5" :answer/id #uuid "70d1b2a9-f8d1-5378-aebc-b18be0f2d28c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-113689/selection/fe7f6e0825a913db7c4be47c6202b1fdcc29fb6e7487964fcc587ed4e4e83fdf" :answer/id #uuid "63b2da16-d106-5149-a66e-33a56a72527a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}13 \\\\ 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-113689/selection" :answer-field/id #uuid "afd79649-6f53-5262-8b5e-773cc171363f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113689/selection/bcf965bd290e223b17dfdadc7b50fe8a18cfb34e6cd446742ad483581bda7281" :answer-field/choices ["q-113689/selection/fc4e2cf106841016abafd2875d67ff73af65a59d2ae61b8b12fe8b80bbbe07ac" "q-113689/selection/bcf965bd290e223b17dfdadc7b50fe8a18cfb34e6cd446742ad483581bda7281" "q-113689/selection/6f6b16e92e6c7c05c85225345bff463fdc97cce4342305c9c746402e13a0b200" "q-113689/selection/8492608054a267cc425c8eb3b5946844a2a80022f7b456ab2d9eae49c53be7f5" "q-113689/selection/fe7f6e0825a913db7c4be47c6202b1fdcc29fb6e7487964fcc587ed4e4e83fdf"] :db/ensure [:answer-field/validate]} {:db/id "q-113689" :question/id #uuid "0151fa01-e373-5136-9f5d-f3422f4a30ea" :question/math-academy-id "q-113689" :question/problem "$$\nB={[\\begin{aligned}1 \\\\ 4\\end{aligned}],[\\begin{aligned}1 \\\\ 5\\end{aligned}]},\\,C={[\\begin{aligned}2 \\\\ -3\\end{aligned}],[\\begin{aligned}1 \\\\ -2\\end{aligned}]},\\,[x]_{C}=[\\begin{aligned}2 \\\\ -5\\end{aligned}]\n$$\n\nThe bases $B$ and $C$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the basis $C$ are given above. Find $[x]_{B}.$" :question/worked-solution "Let's denote the vectors of $B$ and $C$ as ${{b}_{1},{b}_{2}}$ and ${{c}_{1},{c}_{2}}$, respectively.\n\nThe change-of-coordinates matrix from $C$ to $B$ is a matrix whose columns are the vectors of $C$ relative to the basis $B.$\n\nHence, we need to find the coordinates of ${c}_{1}$ and ${c}_{2}$ relative to the basis $B.$ We can do this simultaneously by considering the matrix\n\n$$\nM=[\\begin{aligned}| & | & | & | \\\\ {b}_{1} & {b}_{2} & {c}_{1} & {c}_{2} \\\\ | & | & | & |\\end{aligned}].\n$$\n\nNow, we simply reduce the left-hand side to reduced row-echelon form using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 1 & 2 & 1 \\\\ 4 & 5 & -3 & -2\\end{aligned}] & {R}_{2} & :={R}_{2}+(-4){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 2 & 1 \\\\ 0 & 1 & -11 & -6\\end{aligned}] & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 13 & 7 \\\\ 0 & 1 & -11 & -6\\end{aligned}]\\end{aligned}\n$$\n\n \n\nTherefore, the change-of-coordinates matrix ${P}_{C\\to B}$ is\n\n$$\n{P}_{C\\to B}=[\\begin{aligned}13 & 7 \\\\ -11 & -6\\end{aligned}].\n$$\n\nFinally, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{C\\to B}[\\,x\\,]_{C} \\\\  & =[\\begin{aligned}13 & 7 \\\\ -11 & -6\\end{aligned}][\\begin{aligned}2 \\\\ -5\\end{aligned}] \\\\  & =[\\begin{aligned}-9 \\\\ 8\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-113689/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "36f8f02f-acbd-5930-bd0c-8675ac868577"] :knowledge-point/questions ["q-113689"] :db/ensure [:knowledge-point/validate]} {:db/id "q-82716/selection/1c5bec42b88e137164891c2f679bb1f4cb4e84d9ad07ef230df2535f2e499601" :answer/id #uuid "89ac7b0b-d19b-54f6-8432-fe81b25a3cc9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}8 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-82716/selection/b5769779f2b4f29d3d14d27656943653a7e1e4ede28a7dbf62197202e1b47fac" :answer/id #uuid "cc4357cd-5209-5837-a62b-373c2af25a7d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 \\\\ -5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-82716/selection/f3f56761ca6cf754d4a762dfa05fa3702d26f0d9f508e2c94bf31cd441ac8e44" :answer/id #uuid "74b58b99-5ca2-50e3-942e-e019eea2bc64" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-82716/selection/25181