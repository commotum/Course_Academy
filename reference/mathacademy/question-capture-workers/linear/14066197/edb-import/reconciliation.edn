egin{aligned}22 \\\\ 35\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-36503" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/activity-metadata.json" "file_sha256" "9e37c1aea9388cdbe89841a8e10d9954c6526a32ace1084811f786b588da9146"} {"question" "q-36503" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-36503" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}12 \\\\ 27\\end{aligned}]"] ["math" "[\\begin{aligned}2 \\\\ 7\\end{aligned}]"] ["math" "[\\begin{aligned}22 \\\\ 35\\end{aligned}]"] ["math" "[\\begin{aligned}24 \\\\ 30\\end{aligned}]"] ["math" "[\\begin{aligned}7 \\\\ 22\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-36503" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}22 \\\\ 35\\end{aligned}]"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-36485" "field" nil "attribute" "question/problem" "value" "The change-of-coordinates matrix from $B$ to $C$ and the coordinates of the vector $x$ relative to the basis $C$ are given below. What is $[x]_{B}?$ \n\n$$\n{P}_{B\\to C}=[\\begin{aligned}-2 & 3 \\\\ 3 & -4\\end{aligned}],\\,[x]_{C}=[\\begin{aligned}3 \\\\ -2\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-36485" "field" nil "attribute" "question/worked-solution" "value" "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{C\\to B}[\\,x\\,]_{C}.\n$$\n\nFirst, we need to find the change-of-coordinates matrix ${P}_{C\\to B}$ from $C$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to C}:$\n\n$$\n\\begin{aligned}{P}_{C\\to B} & ={P}_{B\\to C}^{-1} \\\\  & ={[\\begin{aligned}-2 & 3 \\\\ 3 & -4\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{(-2)\\cdot (-4)-3\\cdot 3}[\\begin{aligned}-4 & -3 \\\\ -3 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}4 & 3 \\\\ 3 & 2\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{C\\to B}[\\,x\\,]_{C} \\\\  & =[\\begin{aligned}4 & 3 \\\\ 3 & 2\\end{aligned}][\\begin{aligned}3 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}6 \\\\ 5\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-36485" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/activity-metadata.json" "file_sha256" "9e37c1aea9388cdbe89841a8e10d9954c6526a32ace1084811f786b588da9146"} {"question" "q-36485" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-36485" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-2 \\\\ 5\\end{aligned}]"] ["math" "[\\begin{aligned}-5 \\\\ 6\\end{aligned}]"] ["math" "[\\begin{aligned}5 \\\\ -6\\end{aligned}]"] ["math" "[\\begin{aligned}6 \\\\ -4\\end{aligned}]"] ["math" "[\\begin{aligned}6 \\\\ 5\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-36485" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}6 \\\\ 5\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-82606" "field" nil "attribute" "question/problem" "value" "$$\nB={[\\begin{aligned}5 \\\\ 1\\end{aligned}],[\\begin{aligned}9 \\\\ 2\\end{aligned}]},\\,[x]_{S}=[\\begin{aligned}4 \\\\ 1\\end{aligned}]\n$$\n\nThe basis $B$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the standard basis $S$ are given above. Find $[x]_{B}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-82606" "field" nil "attribute" "question/worked-solution" "value" "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{S\\to B}[\\,x\\,]_{S}.\n$$\n\nFirst, recall that the change-of-coordinates matrix from $B$ to $S$ is the matrix whose columns are the vectors of $B$ relative to the standard basis $S.$ As a result, we have\n\n$$\n{P}_{B\\to S}=[\\begin{aligned}5 & 9 \\\\ 1 & 2\\end{aligned}].\n$$\n\nNow, we need to find the change-of-coordinates matrix ${P}_{S\\to B}$ from $S$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to S}:$\n\n$$\n\\begin{aligned}{P}_{S\\to B} & ={P}_{B\\to S}^{-1} \\\\  & ={[\\begin{aligned}5 & 9 \\\\ 1 & 2\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{5\\cdot 2-1\\cdot 9}[\\begin{aligned}2 & -9 \\\\ -1 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -9 \\\\ -1 & 5\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{S\\to B}[\\,x\\,]_{S} \\\\  & =[\\begin{aligned}2 & -9 \\\\ -1 & 5\\end{aligned}][\\begin{aligned}4 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ 1\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-82606" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/activity-metadata.json" "file_sha256" "9e37c1aea9388cdbe89841a8e10d9954c6526a32ace1084811f786b588da9146"} {"question" "q-82606" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-82606" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-1 \\\\ 1\\end{aligned}]"] ["math" "[\\begin{aligned}-1 \\\\ 2\\end{aligned}]"] ["math" "[\\begin{aligned}-2 \\\\ 1\\end{aligned}]"] ["math" "[\\begin{aligned}-3 \\\\ 2\\end{aligned}]"] ["math" "[\\begin{aligned}1 \\\\ -1\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-82606" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}-1 \\\\ 1\\end{aligned}]"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-113600" "field" nil "attribute" "question/problem" "value" "$$\nB={[\\begin{aligned}6 \\\\ 5\\end{aligned}],[\\begin{aligned}3 \\\\ 3\\end{aligned}]},\\,[x]_{S}=[\\begin{aligned}15 \\\\ 10\\end{aligned}]\n$$\n\nThe basis $B$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the standard basis $S$ are given above. Find $[x]_{B}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-113600" "field" nil "attribute" "question/worked-solution" "value" "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{S\\to B}[\\,x\\,]_{S}.\n$$\n\nFirst, recall that the change-of-coordinates matrix from $B$ to $S$ is the matrix whose columns are the vectors of $B$ relative to the standard basis $S.$ As a result, we have\n\n$$\n{P}_{B\\to S}=[\\begin{aligned}6 & 3 \\\\ 5 & 3\\end{aligned}].\n$$\n\nNow, we need to find the change-of-coordinates matrix ${P}_{S\\to B}$ from $S$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to S}:$\n\n$$\n\\begin{aligned}{P}_{S\\to B} & ={P}_{B\\to S}^{-1} \\\\  & ={[\\begin{aligned}6 & 3 \\\\ 5 & 3\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{6\\cdot 3-3\\cdot 5}[\\begin{aligned}3 & -3 \\\\ -5 & 6\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -1 \\\\ -\\frac{5}{3} & 2\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{S\\to B}[\\,x\\,]_{S} \\\\  & =[\\begin{aligned}1 & -1 \\\\ -\\frac{5}{3} & 2\\end{aligned}][\\begin{aligned}15 \\\\ 10\\end{aligned}] \\\\  & =[\\begin{aligned}5 \\\\ -5\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-113600" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/activity-metadata.json" "file_sha256" "9e37c1aea9388cdbe89841a8e10d9954c6526a32ace1084811f786b588da9146"} {"question" "q-113600" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-113600" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}15 \\\\ -5\\end{aligned}]"] ["math" "[\\begin{aligned}3 \\\\ -4\\end{aligned}]"] ["math" "[\\begin{aligned}3 \\\\ 1\\end{aligned}]"] ["math" "[\\begin{aligned}5 \\\\ -5\\end{aligned}]"] ["math" "[\\begin{aligned}5 \\\\ 3\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-113600" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}5 \\\\ -5\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-82609" "field" nil "attribute" "question/problem" "value" "$$\nB={[\\begin{aligned}7 \\\\ -2\\end{aligned}],[\\begin{aligned}-4 \\\\ 1\\end{aligned}]},\\,[x]_{S}=[\\begin{aligned}2 \\\\ 2\\end{aligned}]\n$$\n\nThe basis $B$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the standard basis $S$ are given above. Find $[x]_{B}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-82609" "field" nil "attribute" "question/worked-solution" "value" "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{S\\to B}[\\,x\\,]_{S}.\n$$\n\nFirst, recall that the change-of-coordinates matrix from $B$ to $S$ is the matrix whose columns are the vectors of $B$ relative to the standard basis $S.$ As a result, we have\n\n$$\n{P}_{B\\to S}=[\\begin{aligned}7 & -4 \\\\ -2 & 1\\end{aligned}].\n$$\n\nNow, we need to find the change-of-coordinates matrix ${P}_{S\\to B}$ from $S$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to S}:$\n\n$$\n\\begin{aligned}{P}_{S\\to B} & ={P}_{B\\to S}^{-1} \\\\  & ={[\\begin{aligned}7 & -4 \\\\ -2 & 1\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{7\\cdot 1-(-2)\\cdot (-4)}[\\begin{aligned}1 & 4 \\\\ 2 & 7\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & -4 \\\\ -2 & -7\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{S\\to B}[\\,x\\,]_{S} \\\\  & =[\\begin{aligned}-1 & -4 \\\\ -2 & -7\\end{aligned}][\\begin{aligned}2 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}-10 \\\\ -18\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-82609" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/activity-metadata.json" "file_sha256" "9e37c1aea9388cdbe89841a8e10d9954c6526a32ace1084811f786b588da9146"} {"question" "q-82609" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-82609" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-10 \\\\ -18\\end{aligned}]"] ["math" "[\\begin{aligned}12 \\\\ -17\\end{aligned}]"] ["math" "[\\begin{aligned}3 \\\\ -1\\end{aligned}]"] ["math" "[\\begin{aligned}3 \\\\ -4\\end{aligned}]"] ["math" "[\\begin{aligned}8 \\\\ 2\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-82609" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}-10 \\\\ -18\\end{aligned}]"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-82710" "field" nil "attribute" "question/problem" "value" "$$\nB={[\\begin{aligned}4 \\\\ 11\\end{aligned}],[\\begin{aligned}1 \\\\ 3\\end{aligned}]},\\,[x]_{S}=[\\begin{aligned}2 \\\\ 5\\end{aligned}]\n$$\n\nThe basis $B$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the standard basis $S$ are given above. Find $[x]_{B}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-82710" "field" nil "attribute" "question/worked-solution" "value" "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{S\\to B}[\\,x\\,]_{S}.\n$$\n\nFirst, recall that the change-of-coordinates matrix from $B$ to $S$ is the matrix whose columns are the vectors of $B$ relative to the standard basis $S.$ As a result, we have\n\n$$\n{P}_{B\\to S}=[\\begin{aligned}4 & 1 \\\\ 11 & 3\\end{aligned}].\n$$\n\nNow, we need to find the change-of-coordinates matrix ${P}_{S\\to B}$ from $S$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to S}:$\n\n$$\n\\begin{aligned}{P}_{S\\to B} & ={P}_{B\\to S}^{-1} \\\\  & ={[\\begin{aligned}4 & 1 \\\\ 11 & 3\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{4\\cdot 3-11\\cdot 1}[\\begin{aligned}3 & -1 \\\\ -11 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}3 & -1 \\\\ -11 & 4\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{S\\to B}[\\,x\\,]_{S} \\\\  & =[\\begin{aligned}3 & -1 \\\\ -11 & 4\\end{aligned}][\\begin{aligned}2 \\\\ 5\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ -2\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-82710" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/activity-metadata.json" "file_sha256" "9e37c1aea9388cdbe89841a8e10d9954c6526a32ace1084811f786b588da9146"} {"question" "q-82710" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-82710" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-7 \\\\ 4\\end{aligned}]"] ["math" "[\\begin{aligned}1 \\\\ -2\\end{aligned}]"] ["math" "[\\begin{aligned}2 \\\\ -3\\end{aligned}]"] ["math" "[\\begin{aligned}2 \\\\ -5\\end{aligned}]"] ["math" "[\\begin{aligned}3 \\\\ -2\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-82710" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}1 \\\\ -2\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-113606" "field" nil "attribute" "question/problem" "value" "$$\nB={[\\begin{aligned}5 \\\\ -3\\end{aligned}],[\\begin{aligned}-7 \\\\ 6\\end{aligned}]},\\,[x]_{S}=[\\begin{aligned}18 \\\\ -9\\end{aligned}]\n$$\n\nThe basis $B$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the standard basis $S$ are given above. Find $[x]_{B}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-113606" "field" nil "attribute" "question/worked-solution" "value" "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{S\\to B}[\\,x\\,]_{S}.\n$$\n\nFirst, recall that the change-of-coordinates matrix from $B$ to $S$ is the matrix whose columns are the vectors of $B$ relative to the standard basis $S.$ As a result, we have\n\n$$\n{P}_{B\\to S}=[\\begin{aligned}5 & -7 \\\\ -3 & 6\\end{aligned}].\n$$\n\nNow, we need to find the change-of-coordinates matrix ${P}_{S\\to B}$ from $S$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to S}:$\n\n$$\n\\begin{aligned}{P}_{S\\to B} & ={P}_{B\\to S}^{-1} \\\\  & ={[\\begin{aligned}5 & -7 \\\\ -3 & 6\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{5\\cdot 6-(-7)\\cdot (-3)}[\\begin{aligned}6 & 7 \\\\ 3 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{2}{3} & \\frac{7}{9} \\\\ \\frac{1}{3} & \\frac{5}{9}\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{S\\to B}[\\,x\\,]_{S} \\\\  & =[\\begin{aligned}\\frac{2}{3} & \\frac{7}{9} \\\\ \\frac{1}{3} & \\frac{5}{9}\\end{aligned}][\\begin{aligned}18 \\\\ -9\\end{aligned}] \\\\  & =[\\begin{aligned}5 \\\\ 1\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-113606" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/activity-metadata.json" "file_sha256" "9e37c1aea9388cdbe89841a8e10d9954c6526a32ace1084811f786b588da9146"} {"question" "q-113606" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-113606" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-6 \\\\ -11\\end{aligned}]"] ["math" "[\\begin{aligned}16 \\\\ 21\\end{aligned}]"] ["math" "[\\begin{aligned}19 \\\\ 3\\end{aligned}]"] ["math" "[\\begin{aligned}25 \\\\ 6\\end{aligned}]"] ["math" "[\\begin{aligned}5 \\\\ 1\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-113606" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}5 \\\\ 1\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-113689" "field" nil "attribute" "question/problem" "value" "$$\nB={[\\begin{aligned}1 \\\\ 4\\end{aligned}],[\\begin{aligned}1 \\\\ 5\\end{aligned}]},\\,C={[\\begin{aligned}2 \\\\ -3\\end{aligned}],[\\begin{aligned}1 \\\\ -2\\end{aligned}]},\\,[x]_{C}=[\\begin{aligned}2 \\\\ -5\\end{aligned}]\n$$\n\nThe bases $B$ and $C$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the basis $C$ are given above. Find $[x]_{B}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-113689" "field" nil "attribute" "question/worked-solution" "value" "Let's denote the vectors of $B$ and $C$ as ${{b}_{1},{b}_{2}}$ and ${{c}_{1},{c}_{2}}$, respectively.\n\nThe change-of-coordinates matrix from $C$ to $B$ is a matrix whose columns are the vectors of $C$ relative to the basis $B.$\n\nHence, we need to find the coordinates of ${c}_{1}$ and ${c}_{2}$ relative to the basis $B.$ We can do this simultaneously by considering the matrix\n\n$$\nM=[\\begin{aligned}| & | & | & | \\\\ {b}_{1} & {b}_{2} & {c}_{1} & {c}_{2} \\\\ | & | & | & |\\end{aligned}].\n$$\n\nNow, we simply reduce the left-hand side to reduced row-echelon form using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 1 & 2 & 1 \\\\ 4 & 5 & -3 & -2\\end{aligned}] & {R}_{2} & :={R}_{2}+(-4){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 2 & 1 \\\\ 0 & 1 & -11 & -6\\end{aligned}] & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 13 & 7 \\\\ 0 & 1 & -11 & -6\\end{aligned}]\\end{aligned}\n$$\n\n \n\nTherefore, the change-of-coordinates matrix ${P}_{C\\to B}$ is\n\n$$\n{P}_{C\\to B}=[\\begin{aligned}13 & 7 \\\\ -11 & -6\\end{aligned}].\n$$\n\nFinally, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{C\\to B}[\\,x\\,]_{C} \\\\  & =[\\begin{aligned}13 & 7 \\\\ -11 & -6\\end{aligned}][\\begin{aligned}2 \\\\ -5\\end{aligned}] \\\\  & =[\\begin{aligned}-9 \\\\ 8\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066197/state.json" "file_sha256" "8b0efdf32801874ff6ad6af337dfd37977788fadde3dd9557fc2c8bd8766293e"} {"question" "q-113689" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/hom