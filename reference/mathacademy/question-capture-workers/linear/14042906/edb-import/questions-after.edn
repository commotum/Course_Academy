igned}\\sqrt{3} & 0 & 0 & 0 \\\\ 0 & 5 & 1 & 0 \\\\ 0 & 0 & 5 & 1 \\\\ 0 & 0 & 0 & 5\\end{aligned}]" :db/id #edb/ref 17592186324780} :answer-field/id #uuid "c0009fbd-c295-5126-865a-f965e2cb039d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324776}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "145dafc1-ed2d-5254-b9ea-a00ec5d077cb" :question/math-academy-id "q-108982" :question/problem "${J}_{1}(\\sqrt{3})\\,⊕\\,{J}_{3}(5)=$" :question/worked-solution "First, recall the following:\n\n- ${J}_{1}(\\sqrt{3})$ represents a $1\\times 1$ Jordan block with $\\sqrt{3}$'s on the leading diagonal.\n\n- ${J}_{3}(5)$ represents a $3\\times 3$ Jordan block with $5$'s on the leading diagonal,\n\nTherefore, our Jordan blocks are given by\n\n$$\n{J}_{1}(\\sqrt{3})=[\\begin{aligned}\\sqrt{3}\\end{aligned}],\\,{J}_{3}(5)=[\\begin{aligned}5 & 1 & 0 \\\\ 0 & 5 & 1 \\\\ 0 & 0 & 5\\end{aligned}].\n$$\n\nThe composition of our Jordan blocks gives the following block diagonal matrix:\n\n$$\n{J}_{1}(\\sqrt{3})\\,⊕\\,{J}_{3}(5)=[\\begin{aligned}\\sqrt{3} & 0 & 0 & 0 \\\\ 0 & 5 & 1 & 0 \\\\ 0 & 0 & 5 & 1 \\\\ 0 & 0 & 0 & 5\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186324782 :knowledge-point/_questions [{:knowledge-point/id #uuid "4f7ad55b-efda-5622-8bdf-e660be24d0c4" :knowledge-point/title "Identifying Matrices Corresponding to a Composition of Jordan Blocks"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a328df5-185d-531c-bd3f-466e641ef560" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186324784} {:answer/id #uuid "c4c44419-65d0-5b91-a5c3-d4f9878ad677" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 1 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186324785} {:answer/id #uuid "ac70ce02-11f9-500f-84dd-4ac5ee78f6cc" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 1 & 0 \\\\ 0 & 1 & 1 \\\\ 0 & 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186324786} {:answer/id #uuid "a6445cf8-b6dc-51d0-8132-ce7263aa61a1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & -1 & 1 \\\\ 0 & 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186324787} {:answer/id #uuid "926a531c-b960-59b4-b45e-3ff350205097" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 1 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186324788}] :answer-field/correct {:answer/id #uuid "c4c44419-65d0-5b91-a5c3-d4f9878ad677" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 1 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186324785} :answer-field/id #uuid "80bcb6d5-3627-5991-86f7-d1515fddce5d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324783}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "35018116-aa4b-50cf-a4a9-67e443c6df65" :question/math-academy-id "q-108983" :question/problem "${J}_{2}(1)\\,⊕\\,{J}_{1}(-1)=$" :question/worked-solution "First, recall the following:\n\n- ${J}_{2}(1)$ represents a $2\\times 2$ Jordan block with $1$'s on the leading diagonal.\n\n- ${J}_{1}(-1)$ represents a $1\\times 1$ Jordan block with $-1$'s on the leading diagonal,\n\nTherefore, our Jordan blocks are given by\n\n$$\n{J}_{2}(1)=[\\begin{aligned}1 & 1 \\\\ 0 & 1\\end{aligned}],\\,{J}_{1}(-1)=[\\begin{aligned}-1\\end{aligned}].\n$$\n\nThe composition of our Jordan blocks gives the following block diagonal matrix:\n\n$$\n{J}_{2}(1)\\,⊕\\,{J}_{1}(-1)=[\\begin{aligned}1 & 1 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -1\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186324789 :knowledge-point/_questions [{:knowledge-point/id #uuid "4f7ad55b-efda-5622-8bdf-e660be24d0c4" :knowledge-point/title "Identifying Matrices Corresponding to a Composition of Jordan Blocks"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a56e0fd-1603-5d06-8ad6-092d68f198fd" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & 0 \\\\ 0 & 7\\end{aligned}]" :db/id #edb/ref 17592186324791} {:answer/id #uuid "0adbf01e-ff9f-5b93-b41b-ce337c44b417" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & 0 \\\\ 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186324792} {:answer/id #uuid "a9477149-0a42-5bad-8c8f-f9e47521ac43" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & 1 \\\\ 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186324793} {:answer/id #uuid "7149316e-b3a8-5538-b59d-d42db01ec6a6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 0 \\\\ 0 & 7\\end{aligned}]" :db/id #edb/ref 17592186324794} {:answer/id #uuid "f67a1fd1-1af4-5f24-b6f5-8bd17ce51dd0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186324795}] :answer-field/correct {:answer/id #uuid "0adbf01e-ff9f-5b93-b41b-ce337c44b417" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & 0 \\\\ 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186324792} :answer-field/id #uuid "4ddaddeb-5ce8-57b2-b51f-068bec28745c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324790}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "90d77503-0508-58ca-9f96-9ade71955fc1" :question/math-academy-id "q-108984" :question/problem "${J}_{1}(7)\\,⊕\\,{J}_{1}(-1)=$" :question/worked-solution "First, recall the following:\n\n- ${J}_{1}(7)$ represents a $1\\times 1$ Jordan block with $7$'s on the leading diagonal,\n\n- ${J}_{1}(-1)$ represents a $1\\times 1$ Jordan block with $-1$'s on the leading diagonal.\n\nTherefore, our Jordan blocks are given by\n\n$$\n{J}_{1}(7)=[\\begin{aligned}7\\end{aligned}],\\,{J}_{1}(-1)=[\\begin{aligned}-1\\end{aligned}].\n$$\n\nThe composition of our Jordan blocks gives the following block diagonal matrix:\n\n$$\n{J}_{1}(7)\\,⊕\\,{J}_{1}(-1)=[\\begin{aligned}7 & 0 \\\\ 0 & -1\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186324796 :knowledge-point/_questions [{:knowledge-point/id #uuid "4f7ad55b-efda-5622-8bdf-e660be24d0c4" :knowledge-point/title "Identifying Matrices Corresponding to a Composition of Jordan Blocks"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "665355ff-4803-5c02-8ebf-d1e393d3f76d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-7 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & -2\\end{aligned}]" :db/id #edb/ref 17592186324798} {:answer/id #uuid "84c44058-0ad8-5904-a711-3885c585537b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-7 & 1 & 0 \\\\ 0 & -2 & 1 \\\\ 0 & 0 & -2\\end{aligned}]" :db/id #edb/ref 17592186324799} {:answer/id #uuid "b9635958-cdfe-5fe5-9d84-7244b9b8c1f9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-7 & 0 & 0 \\\\ 0 & -7 & 0 \\\\ 0 & 0 & -2\\end{aligned}]" :db/id #edb/ref 17592186324800} {:answer/id #uuid "ac69548c-f50c-5587-ba49-e6333613bba9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-7 & 0 & 0 \\\\ 0 & -2 & 1 \\\\ 0 & 0 & -2\\end{aligned}]" :db/id #edb/ref 17592186324801} {:answer/id #uuid "24f9f02b-eb15-54ff-b001-95908f9fcea6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-7 & 1 & 0 \\\\ 0 & -7 & 1 \\\\ 0 & 0 & -2\\end{aligned}]" :db/id #edb/ref 17592186324802}] :answer-field/correct {:answer/id #uuid "ac69548c-f50c-5587-ba49-e6333613bba9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-7 & 0 & 0 \\\\ 0 & -2 & 1 \\\\ 0 & 0 & -2\\end{aligned}]" :db/id #edb/ref 17592186324801} :answer-field/id #uuid "2949519a-27a2-5095-88b0-bc93136af8a5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324797}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a78d8929-d495-58f1-b762-a4fd01a12a9b" :question/math-academy-id "q-109058" :question/problem "${J}_{1}(-7)\\,⊕\\,{J}_{2}(-2)=$" :question/worked-solution "First, recall the following:\n\n- ${J}_{1}(-7)$ represents a $1\\times 1$ Jordan block with $-7$'s on the leading diagonal,\n\n- ${J}_{2}(-2)$ represents a $2\\times 2$ Jordan block with $-2$'s on the leading diagonal.\n\nTherefore, our Jordan blocks are given by\n\n$$\n{J}_{1}(-7)=[\\begin{aligned}-7\\end{aligned}],\\,{J}_{2}(-2)=[\\begin{aligned}-2 & 1 \\\\ 0 & -2\\end{aligned}].\n$$\n\nThe composition of our Jordan blocks gives the following block diagonal matrix:\n\n$$\n{J}_{1}(-7)\\,⊕\\,{J}_{2}(-2)=[\\begin{aligned}-7 & 0 & 0 \\\\ 0 & -2 & 1 \\\\ 0 & 0 & -2\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186324803 :knowledge-point/_questions [{:knowledge-point/id #uuid "4f7ad55b-efda-5622-8bdf-e660be24d0c4" :knowledge-point/title "Identifying Matrices Corresponding to a Composition of Jordan Blocks"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "afc7d822-51cf-5918-974c-3a9869b53ffd" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 & 1 & 0 \\\\ 0 & 6 & 1 \\\\ 0 & 0 & 6\\end{aligned}]" :db/id #edb/ref 17592186324805} {:answer/id #uuid "76d7afbe-8ada-532f-8188-ba68d48351b3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 & 1 & 0 \\\\ 0 & -4 & 1 \\\\ 0 & 0 & 6\\end{aligned}]" :db/id #edb/ref 17592186324806} {:answer/id #uuid "508f6186-ca1e-56b9-9d8a-96104315314a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 & 0 & 0 \\\\ 0 & -4 & 0 \\\\ 0 & 0 & 6\\end{aligned}]" :db/id #edb/ref 17592