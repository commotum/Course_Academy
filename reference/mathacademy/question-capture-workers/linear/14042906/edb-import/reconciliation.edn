ocks." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042906/state.json" "file_sha256" "48bfef7befabfc9c9cacfc9d2662c7cbec3e66f638e94885a73085d2f88fe8a7"} {"question" "q-109075" "field" nil "attribute" "question/worked-solution" "value" "Our matrix can be represented as the composition of two Jordan blocks (one $1\\times 1$ block and one $2\\times 2$ block), as follows:\n\n$$\n[\\begin{aligned}3 & 0 & 0 \\\\ 0 & 9 & 1 \\\\ 0 & 0 & 9\\end{aligned}]={J}_{1}(3)\\,⊕\\,{J}_{2}(9)\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042906/state.json" "file_sha256" "48bfef7befabfc9c9cacfc9d2662c7cbec3e66f638e94885a73085d2f88fe8a7"} {"question" "q-109075" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042906/activity-metadata.json" "file_sha256" "757599166a78f600441b2c2c913d513934d16bd5d273d71c9400117b39d3316c"} {"question" "q-109075" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042906/state.json" "file_sha256" "48bfef7befabfc9c9cacfc9d2662c7cbec3e66f638e94885a73085d2f88fe8a7"} {"question" "q-109075" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{J}_{1}(3)\\,⊕\\,{J}_{1}(9)"] ["math" "{J}_{1}(3)\\,⊕\\,{J}_{1}(9)\\,⊕\\,{J}_{1}(9)"] ["math" "{J}_{1}(3)\\,⊕\\,{J}_{2}(9)"] ["math" "{J}_{1}(3)\\,⊕\\,{J}_{2}(9)\\,⊕\\,{J}_{1}(1)"] ["math" "{J}_{2}(9)"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042906/state.json" "file_sha256" "48bfef7befabfc9c9cacfc9d2662c7cbec3e66f638e94885a73085d2f88fe8a7"} {"q