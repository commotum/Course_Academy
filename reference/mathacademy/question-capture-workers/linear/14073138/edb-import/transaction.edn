[{:db/id [:question/math-academy-id "q-93705"] :question/problem "$$\nA=[\\begin{aligned}1 & -2 \\\\ -2 & 1\\end{aligned}]\n$$\n\nConsider the matrix $A$ above. Which of the following represents the corresponding quadratic form ${x}^{T}\\,Ax$ in terms of the components of $x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]?$" :question/worked-solution "**Method 1**\n\nEach entry ${a}_{ij}$ of $A$ corresponds to the term ${a}_{ij}{x}_{i}{x}_{j}$ in the expression of the quadratic form:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =1{x}_{1}{x}_{1}+(-2){x}_{1}{x}_{2}+(-2){x}_{2}{x}_{1}+1{x}_{2}{x}_{2} \\\\  & ={x}_{1}^{2}-2{x}_{1}{x}_{2}-2{x}_{2}{x}_{1}+{x}_{2}^{2} \\\\  & ={x}_{1}^{2}-4{x}_{1}{x}_{2}+{x}_{2}^{2}\\end{aligned}\n$$\n\n**Method 2**\n\nTo write down a quadratic form in terms of vector components, we compute the following expression:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =[\\begin{aligned}{x}_{1} & {x}_{2}\\end{aligned}][\\begin{aligned}1 & -2 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{1} & {x}_{2}\\end{aligned}][\\begin{aligned}{x}_{1}-2{x}_{2} \\\\ -2{x}_{1}+{x}_{2}\\end{aligned}] \\\\  & ={x}_{1}({x}_{1}-2{x}_{2})+{x}_{2}(-2{x}_{1}+{x}_{2}) \\\\  & ={x}_{1}^{2}-2{x}_{1}{x}_{2}-2{x}_{2}{x}_{1}+{x}_{2}^{2} \\\\  & ={x}_{1}^{2}-4{x}_{1}{x}_{2}+{x}_{2}^{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-94090/selection/8cd557fa143c2616f01a8df1d19e854fea26be776628dc106639661d1b774491" :answer/id #uuid "54c150ad-9df0-55d5-be8a-dd93fd961bec" :answer/type :answer.type/math :answer/value "65" :db/ensure [:answer/validate]} {:db/id "q-94090/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer/id #uuid "22254c91-b3ba-5755-a78d-71e88989c6b1" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "q-94090/selection/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c" :answer/id #uuid "0cb6d23d-ef1e-5f7c-a5bd-7c747a9f2e31" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "q-94090/selection/33ad5bb85ef2860b8848dac07e73b48f485bff167e79bb938240370691781b46" :answer/id #uuid "e273490a-1760-5dfe-a9f1-eadcc89bc2ec" :answer/type :answer.type/math :answer/value "34" :db/ensure [:answer/validate]} {:db/id "q-94090/selection/0c91aee12841e83df8a63bea4f335135e4f592b0fef26da9fddc6b9cb7ae4e6d" :answer/id #uuid "b66c7480-6af6-57e1-9894-4688c663c78f" :answer/type :answer.type/math :answer/value "61" :db/ensure [:answer/validate]} {:db/id "q-94090/selection" :answer-field/id #uuid "cf5a56d9-0917-5ae4-b233-e17f7d1976f1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-94090/selection/0c91aee12841e83df8a63bea4f335135e4f592b0fef26da9fddc6b9cb7ae4e6d" :answer-field/choices ["q-94090/selection/8cd557fa143c2616f01a8df1d19e854fea26be776628dc106639661d1b774491" "q-94090/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" "q-94090/selection/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c" "q-94090/selection/33ad5bb85ef2860b8848dac07e73b48f485bff167e79bb938240370691781b46" "q-94090/selection/0c91aee12841e83df8a63bea4f335135e4f592b0fef26da9fddc6b9cb7ae4e6d"] :db/ensure [:answer-field/validate]} {:db/id "q-94090" :question/id #uuid "cb1eb5d1-5489-56bb-acbb-4bcc51a36ed7" :question/math-academy-id "q-94090" :question/problem "$$\nA=[\\begin{aligned}4 & -3 \\\\ -3 & 1\\end{aligned}]\n$$\n\nGiven the matrix $A$ above, evaluate the quadratic form $Q(x)={x}^{T}\\,Ax$ when $x=[\\begin{aligned}2 \\\\ -3\\end{aligned}].$" :question/worked-solution "Substituting $x=[\\begin{aligned}2 \\\\ -3\\end{aligned}]$ into the expression for $Q(x),$ we obtain\n\n$$\n\\begin{aligned}Q(x) & ={x}^{T}\\,Ax \\\\  & =[\\begin{aligned}2 & -3\\end{aligned}][\\begin{aligned}4 & -3 \\\\ -3 & 1\\end{aligned}][\\begin{aligned}2 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}17 & -9\\end{aligned}][\\begin{aligned}2 \\\\ -3\\end{aligned}] \\\\  & =61.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-94090/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "90f62dc8-396d-5f7f-8295-2e7b5d62bd78"] :knowledge-point/questions ["q-94090"] :db/ensure [:knowledge-point/validate]} {:db/id "q-94099/selection/2ffad55c4d106156da43ed49bdeda5be576883e297bbbf9eb874ab0359133f22" :answer/id #uuid "81306264-a231-5fb1-8e6e-5600200ac2eb" :answer/type :answer.type/math :answer/value "2{x}_{1}^{2}+2{x}_{1}{x}_{2}-2{x}_{2}^{2}+2{x}_{3}^{2}" :db/ensure [:answer/validate]} {:db/id "q-94099/selection/e20a6e0cf45692612ae1af0ce99f795f2f6ed39e13e6e06c99df2b86fca2ca46" :answer/id #uuid "3f58ae66-2a2a-5e0a-88d7-a5cda53451a7" :answer/type :answer.type/math :answer/value "{x}_{1}^{2}+2{x}_{1}{x}_{3}+2{x}_{2}^{2}-2{x}_{3}^{2}" :db/ensure [:answer/validate]} {:db/id "q-94099/selection/d97296d173675a6fe7f50c9a29c3b9c95aca08d10abbea31e7ac484b0b4955ae" :answer/id #uuid "89be66ea-03c0-5114-9143-f891e4a143e7" :answer/type :answer.type/math :answer/value "2{x}_{1}^{2}+2{x}_{1}{x}_{2}-2{x}_{2}^{2}" :db/ensure [:answer/validate]} {:db/id "q-94099/selection/08471e7669bee24a755f745e9febcb8d19d06331d153675de68cdece69216913" :answer/id #uuid "1b8f1235-5983-5e6b-b148-6360b2fcc54c" :answer/type :answer.type/math :answer/value "2{x}_{2}^{2}+2{x}_{1}{x}_{2}-2{x}_{3}^{2}" :db/ensure [:answer/validate]} {:db/id "q-94099/selection/308191babb71626fd1dbc94f4bf3ab406cce97d428da6b74d2cf58fa2aa94d52" :answer/id #uuid "f0da357d-1e07-5173-aaec-d0d762ab1b72" :answer/type :answer.type/math :answer/value "2{x}_{1}^{2}+2{x}_{1}{x}_{2}+2{x}_{3}^{2}" :db/ensure [:answer/validate]} {:db/id "q-94099/selection" :answer-field/id #uuid "31f4de6a-117b-5bff-975f-36877d5896e7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-94099/selection/2ffad55c4d106156da43ed49bdeda5be576883e297bbbf9eb874ab0359133f22" :answer-field/choices ["q-94099/selection/2ffad55c4d106156da43ed49bdeda5be576883e297bbbf9eb874ab0359133f22" "q-94099/selection/e20a6e0cf45692612ae1af0ce99f795f2f6ed39e13e6e06c99df2b86fca2ca46" "q-94099/selection/d97296d173675a6fe7f50c9a29c3b9c95aca08d10abbea31e7ac484b0b4955ae" "q-94099/selection/08471e7669bee24a755f745e9febcb8d19d06331d153675de68cdece69216913" "q-94099/selection/308191babb71626fd1dbc94f4bf3ab406cce97d428da6b74d2cf58fa2aa94d52"] :db/ensure [:answer-field/validate]} {:db/id "q-94099" :question/id #uuid "5519f16f-d5a3-5692-bd72-04e0717d8b5d" :question/math-academy-id "q-94099" :question/problem "$$\nA=[\\begin{aligned}2 & 1 & 0 \\\\ 1 & -2 & 0 \\\\ 0 & 0 & 2\\end{aligned}]\n$$\n\nConsider the matrix $A$ above. Which of the following represents the corresponding quadratic form ${x}^{T}\\,Ax$ in terms of the components of $x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]?$" :question/worked-solution "**Method 1**\n\nEach entry ${a}_{ij}$ of $A$ corresponds to the term ${a}_{ij}{x}_{i}{x}_{j}$ in the expression of the quadratic form:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =2{x}_{1}{x}_{1}+1{x}_{1}{x}_{2}+0{x}_{1}{x}_{3}+1{x}_{2}{x}_{1}+(-2){x}_{2}{x}_{2}+0{x}_{2}{x}_{3}+0{x}_{3}{x}_{1}+0{x}_{3}{x}_{2}+2{x}_{3}{x}_{3} \\\\  & =2{x}_{1}^{2}+{x}_{1}{x}_{2}+{x}_{2}{x}_{1}-2{x}_{2}^{2}+2{x}_{3}^{2} \\\\  & =2{x}_{1}^{2}+2{x}_{1}{x}_{2}-2{x}_{2}^{2}+2{x}_{3}^{2}\\end{aligned}\n$$\n\n**Method 2**\n\nTo write down a quadratic form in terms of vector components, we compute the following expression:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =[\\begin{aligned}{x}_{1} & {x}_{2} & {x}_{3}\\end{aligned}][\\begin{aligned}2 & 1 & 0 \\\\ 1 & -2 & 0 \\\\ 0 & 0 & 2\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{1} & {x}_{2} & {x}_{3}\\end{aligned}][\\begin{aligned}2{x}_{1}+{x}_{2} \\\\ {x}_{1}-2{x}_{2} \\\\ 2{x}_{3}\\end{aligned}] \\\\  & ={x}_{1}(2{x}_{1}+{x}_{2})+{x}_{2}({x}_{1}-2{x}_{2})+{x}_{3}(2{x}_{3}) \\\\  & =2{x}_{1}^{2}+{x}_{1}{x}_{2}+{x}_{2}{x}_{1}-2{x}_{x}^{2}+2{x}_{3}^{2} \\\\  & =2{x}_{1}^{2}+2{x}_{1}{x}_{2}-2{x}_{2}^{2}+2{x}_{3}^{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-94099/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "328b0b77-f789-581e-a119-9823297666ae"] :knowledge-point/questions ["q-94099"] :db/ensure [:knowledge-point/validate]} {:db/id "q-94116/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "891ce537-9085-56b7-ae6f-e9125d0971ad" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-94116/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "f534f31e-28eb-5ff1-abda-293ab86a0306" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-94116/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer/id #uuid "90e86eec-31b7-5bd9-a6fc-90890ae830e9" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "q-94116/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "a29c1ca5-4e9c-582c-ba01-bc743b01e2c4" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-94116/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "cac3577f-897f-5a07-a3d7-f0175f21c115" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-94116/selection" :answer-field/id #uuid "efb2f6a8-6a6c-58c9-b5eb-d20e4ea07ca7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-94116/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer-field/choices ["q-94116/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-94116/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-94116/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" "q-94116/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" "q-94116/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff"] :db/ensure [:answer-field/validate]} {:db/id "q-94116" :question/id #uuid "17223c22-baa8-51fd-870b-c084f2c85b4f" :question/math-academy-id "q-94116" :question/problem "$$\n[\\begin{aligned}a & b \\\\ b & -3\\end{aligned}]\n$$\n\nThe matrix of the quadratic form $Q(x)=-2{x}_{1}^{2}-10{x}_{1}{x}_{2}-3{x}_{2}^{2}\\,$ is given above. What is the value of $a+b?$" :question/worked-solution "Since the matrix of the quadratic form must be symmetric, we rewrite our expression as follows:\n\n$$\n\\begin{aligned}Q(x) & =-2{x}_{1}^{2}-10{x}_{1}{x}_{2}-3{x}_{2}^{2} \\\\  & =(-2){x}_{1}^{2}+(-5){x}_{1}{x}_{2} \\\\  & +\\,(-5){x}_{2}{x}_{1}+(-3){x}_{2}^{2}\\end{aligned}\n$$\n\nNotice that to get a symmetric matrix, we must split the coefficient of $-10{x}_{1}{x}_{2}$ between the entries \n\n$$\n{a}_{12}={a}_{21}=\\frac{-10}{2}=-5\n$$\n\nof our matrix. So, the matrix corresponding to our quadratic form is\n\n$$\n[\\begin{aligned}-2 & -5 \\\\ -5 & -3\\end{aligned}].\n$$\n\nTherefore, $a=-2$ and $b=-5.$ Finally, \n\n$$\na+b=-2+(-5)=-7.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-94116/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "eb93c0ea-26d9-5190-9677-b8c7eb6f7ef1"] :knowledge-point/questions ["q-94116"] :db/ensure [:knowledge-point/validate]} {:db/id "q-140929/selection/801bcdd9cb6a10cec998162e05f71050c8aaf0c6974f095bdcaef715a09f4aee" :answer/id #uuid "cdd64b22-569f-5869-b1a9-37782b5c26a7" :answer/type :answer.type/math :answer/value "21" :db/ensure [:answer/validate]} {:db/id "q-140929/selection/c9ec5d6cdf4e67c7f8bce68475bed400e56bf403f3d09b5928f78b6baa512eab" :answer/id #uuid "436aacfa-59cc-5f22-a855-dd76785d68d2" :answer/type :answer.type/math :answer/value "27" :db/ensure [:answer/validate]} {:db/id "q-140929/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "0fdcd381-a095-51f4-aa44-fbe20ea382e6" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-140929/selection/a4c8bdda186d0d425e9963bf17967cd5e356d934f319fa58135b8f8cf8a589f8" :answer/id #uuid "0a113299-c7c5-561f-a0c1-57f15c9ec7c6" :answer/type :answer.type/math :answer/value "30" :db/ensure [:answer/validate]} {:db/id "q-140929/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "5286293e-69d4-5e7c-80a9-6376ed4fb3d2" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-140929/selection" :answer-field/id #uuid "42760393-cb74-5f87-ad41-3056044a586b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-140929/selection/801bcdd9cb6a10cec998162e05f71050c8aaf0c6974f095bdcaef715a09f4aee" :answer-field/choices ["q-140929/selection/801bcdd9cb6a10cec998162e05f71050c8aaf0c6974f095bdcaef715a09f4aee" "q-140929/selection/c9ec5d6cdf4e67c7f8bce68475bed400e56bf403f3d09b5928f78b6baa512eab" "q-140929/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-140929/selection/a4c8bdda186d0d425e9963bf17967cd5e356d934f319fa58135b8f8cf8a589f8" "q-140929/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff"] :db/ensure [:answer-field/validate]} {:db/id "q-140929" :question/id #uuid "455cf0d5-7cc5-56d5-abef-02f0bf8e16a5" :question/math-academy-id "q-140929" :question/problem "Consider the quadratic form \n$Q(x)={x}_{1}^{2}-4{x}_{1}{x}_{2}+2{x}_{1}{x}_{3}-3{x}_{2}{x}_{3}.$ \nEvaluate $Q(x)$ when $x=[\\begin{aligned}3 \\\\ -1 \\\\ 0\\end{aligned}].$" :question/worked-solution "We are given that \n\n$$\nx=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]=[\\begin{aligned}3 \\\\ -1 \\\\ 0\\end{aligned}].\n$$\n\nSubstituting this into the expression for $Q(x)$, we obtain\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}-4{x}_{1}{x}_{2}+2{x}_{1}{x}_{3}-3{x}_{2}{x}_{3} \\\\  & ={3}^{2}-4\\cdot 3\\cdot (-1)+2\\cdot 3\\cdot 0-3\\cdot (-1)\\cdot 0 \\\\  & =9+12+0+0 \\\\  & =21.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-140929/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "90f62dc8-396d-5f7f-8295-2e7b5d62bd78"] :knowledge-point/questions ["q-140929"] :db/ensure [:knowledge-point/validate]}]
