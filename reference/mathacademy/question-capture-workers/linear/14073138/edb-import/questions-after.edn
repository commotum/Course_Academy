#{[{:db/id #edb/ref 17592186378340 :knowledge-point/_questions [{:knowledge-point/id #uuid "90f62dc8-396d-5f7f-8295-2e7b5d62bd78" :knowledge-point/title "Evaluating a Quadratic Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cdd64b22-569f-5869-b1a9-37782b5c26a7" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186378342} {:answer/id #uuid "0fdcd381-a095-51f4-aa44-fbe20ea382e6" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186378343} {:answer/id #uuid "0a113299-c7c5-561f-a0c1-57f15c9ec7c6" :answer/type {:db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186378344} {:answer/id #uuid "5286293e-69d4-5e7c-80a9-6376ed4fb3d2" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186378345} {:answer/id #uuid "436aacfa-59cc-5f22-a855-dd76785d68d2" :answer/type {:db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186378346}] :answer-field/correct {:answer/id #uuid "cdd64b22-569f-5869-b1a9-37782b5c26a7" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186378342} :answer-field/id #uuid "42760393-cb74-5f87-ad41-3056044a586b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378341}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "455cf0d5-7cc5-56d5-abef-02f0bf8e16a5" :question/math-academy-id "q-140929" :question/problem "Consider the quadratic form \n$Q(x)={x}_{1}^{2}-4{x}_{1}{x}_{2}+2{x}_{1}{x}_{3}-3{x}_{2}{x}_{3}.$ \nEvaluate $Q(x)$ when $x=[\\begin{aligned}3 \\\\ -1 \\\\ 0\\end{aligned}].$" :question/worked-solution "We are given that \n\n$$\nx=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]=[\\begin{aligned}3 \\\\ -1 \\\\ 0\\end{aligned}].\n$$\n\nSubstituting this into the expression for $Q(x)$, we obtain\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}-4{x}_{1}{x}_{2}+2{x}_{1}{x}_{3}-3{x}_{2}{x}_{3} \\\\  & ={3}^{2}-4\\cdot 3\\cdot (-1)+2\\cdot 3\\cdot 0-3\\cdot (-1)\\cdot 0 \\\\  & =9+12+0+0 \\\\  & =21.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186162521 :knowledge-point/_questions [{:knowledge-point/id #uuid "328b0b77-f789-581e-a119-9823297666ae" :knowledge-point/title "Writing Down a Quadratic Form Given Its Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c7200b7c-7eab-5a8e-aea2-4d7c831a194e" :answer/type {:db/ident :answer.type/math} :answer/value "x_{1}^{2} - 4x_{1}x_{2} + x_{2}^{2}" :db/id #edb/ref 17592186160759} {:answer/id #uuid "ddac1586-6063-5eb6-99fe-a82fdf609c61" :answer/type {:db/ident :answer.type/math} :answer/value "x_{1}^{2} + 2x_{1}x_{2} + x_{2}^{2}" :db/id #edb/ref 17592186160760} {:answer/id #uuid "de6f8167-c694-593d-aa2a-3e84098cc56f" :answer/type {:db/ident :answer.type/math} :answer/value "-x_{1}^{2} + 2x_{1}x_{2} - x_{2}^{2}" :db/id #edb/ref 17592186160761} {:answer/id #uuid "42cbf7a0-0111-588e-b1e8-fdeda1e31927" :answer/type {:db/ident :answer.type/math} :answer/value "x_{1}^{2} - 2x_{1}x_{2} + x_{2}^{2}" :db/id #edb/ref 17592186160762} {:answer/id #uuid "7d9e3ec9-6e03-519f-a81a-93169ef1bb95" :answer/type {:db/ident :answer.type/math} :answer/value "-x_{1}^{2} - x_{2}^{2}" :db/id #edb/ref 17592186160763}] :answer-field/correct {:answer/id #uuid "c7200b7c-7eab-5a8e-aea2-4d7c831a194e" :answer/type {:db/ident :answer.type/math} :answer/value "x_{1}^{2} - 4x_{1}x_{2} + x_{2}^{2}" :db/id #edb/ref 17592186160759} :answer-field/id #uuid "3ea574f1-cef5-5dd3-99e4-842f16aee072" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186160758}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ef8e1919-faae-510c-bb46-8c3989805365" :question/math-academy-id "q-93705" :question/problem "$$\nA=[\\begin{aligned}1 & -2 \\\\ -2 & 1\\end{aligned}]\n$$\n\nConsider the matrix $A$ above. Which of the following represents the corresponding quadratic form ${x}^{T}\\,Ax$ in terms of the components of $x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]?$" :question/worked-solution "**Method 1**\n\nEach entry ${a}_{ij}$ of $A$ corresponds to the term ${a}_{ij}{x}_{i}{x}_{j}$ in the expression of the quadratic form:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =1{x}_{1}{x}_{1}+(-2){x}_{1}{x}_{2}+(-2){x}_{2}{x}_{1}+1{x}_{2}{x}_{2} \\\\  & ={x}_{1}^{2}-2{x}_{1}{x}_{2}-2{x}_{2}{x}_{1}+{x}_{2}^{2} \\\\  & ={x}_{1}^{2}-4{x}_{1}{x}_{2}+{x}_{2}^{2}\\end{aligned}\n$$\n\n**Method 2**\n\nTo write down a quadratic form in terms of vector components, we compute the following expression:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =[\\begin{aligned}{x}_{1} & {x}_{2}\\end{aligned}][\\begin{aligned}1 & -2 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{1} & {x}_{2}\\end{aligned}][\\begin{aligned}{x}_{1}-2{x}_{2} \\\\ -2{x}_{1}+{x}_{2}\\end{aligned}] \\\\  & ={x}_{1}({x}_{1}-2{x}_{2})+{x}_{2}(-2{x}_{1}+{x}_{2}) \\\\  & ={x}_{1}^{2}-2{x}_{1}{x}_{2}-2{x}_{2}{x}_{1}+{x}_{2}^{2} \\\\  & ={x}_{1}^{2}-4{x}_{1}{x}_{2}+{x}_{2}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186378347 :knowledge-point/_questions [{:knowledge-point/id #uuid "90f62dc8-396d-5f7f-8295-2e7b5d62bd78" :knowledge-point/title "Evaluating a Quadratic Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b66c7480-6af6-57e1-9894-4688c663c78f" :answer/type {:db/ident :answer.type/math} :answer/value "61" :db/id #edb/ref 17592186378349} {:answer/id #uuid "22254c91-b3ba-5755-a78d-71e88989c6b1" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186378350} {:answer/id #uuid "e273490a-1760-5dfe-a9f1-eadcc89bc2ec" :answer/type {:db/ident :answer.type/math} :answer/value "34" :db/id #edb/ref 17592186378351} {:answer/id #uuid "0cb6d23d-ef1e-5f7c-a5bd-7c747a9f2e31" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186378352} {:answer/id #uuid "54c150ad-9df0-55d5-be8a-dd93fd961bec" :answer/type {:db/ident :answer.type/math} :answer/value "65" :db/id #edb/ref 17592186378353}] :answer-field/correct {:answer/id #uuid "b66c7480-6af6-57e1-9894-4688c663c78f" :answer/type {:db/ident :answer.type/math} :answer/value "61" :db/id #edb/ref 17592186378349} :answer-field/id #uuid "cf5a56d9-0917-5ae4-b233-e17f7d1976f1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378348}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "cb1eb5d1-5489-56bb-acbb-4bcc51a36ed7" :question/math-academy-id "q-94090" :question/problem "$$\nA=[\\begin{aligned}4 & -3 \\\\ -3 & 1\\end{aligned}]\n$$\n\nGiven the matrix $A$ above, evaluate the quadratic form $Q(x)={x}^{T}\\,Ax$ when $x=[\\begin{aligned}2 \\\\ -3\\end{aligned}].$" :question/worked-solution "Substituting $x=[\\begin{aligned}2 \\\\ -3\\end{aligned}]$ into the expression for $Q(x),$ we obtain\n\n$$\n\\begin{aligned}Q(x) & ={x}^{T}\\,Ax \\\\  & =[\\begin{aligned}2 & -3\\end{aligned}][\\begin{aligned}4 & -3 \\\\ -3 & 1\\end{aligned}][\\begin{aligned}2 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}17 & -9\\end{aligned}][\\begin{aligned}2 \\\\ -3\\end{aligned}] \\\\  & =61.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186378354 :knowledge-point/_questions [{:knowledge-point/id #uuid "328b0b77-f789-581e-a119-9823297666ae" :knowledge-point/title "Writing Down a Quadratic Form Given Its Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b8f1235-5983-5e6b-b148-6360b2fcc54c" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}_{2}^{2}+2{x}_{1}{x}_{2}-2{x}_{3}^{2}" :db/id #edb/ref 17592186378356} {:answer/id #uuid "81306264-a231-5fb1-8e6e-5600200ac2eb" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}_{1}^{2}+2{x}_{1}{x}_{2}-2{x}_{2}^{2}+2{x}_{3}^{2}" :db/id #edb/ref 17592186378357} {:answer/id #uuid "f0da357d-1e07-5173-aaec-d0d762ab1b72" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}_{1}^{2}+2{x}_{1}{x}_{2}+2{x}_{3}^{2}" :db/id #edb/ref 17592186378358} {:answer/id #uuid "89be66ea-03c0-5114-9143-f891e4a143e7" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}_{1}^{2}+2{x}_{1}{x}_{2}-2{x}_{2}^{2}" :db/id #edb/ref 17592186378359} {:answer/id #uuid "3f58ae66-2a2a-5e0a-88d7-a5cda53451a7" :answer/type {:db/ident :answer.type/math} :answer/value "{x}_{1}^{2}+2{x}_{1}{x}_{3}+2{x}_{2}^{2}-2{x}_{3}^{2}" :db/id #edb/ref 17592186378360}] :answer-field/correct {:answer/id #uuid "81306264-a231-5fb1-8e6e-5600200ac2eb" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}_{1}^{2}+2{x}_{1}{x}_{2}-2{x}_{2}^{2}+2{x}_{3}^{2}" :db/id #edb/ref 17592186378357} :answer-field/id #uuid "31f4de6a-117b-5bff-975f-36877d5896e7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378355}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5519f16f-d5a3-5692-bd72-04e0717d8b5d" :question/math-academy-id "q-94099" :question/problem "$$\nA=[\\begin{aligned}2 & 1 & 0 \\\\ 1 & -2 & 0 \\\\ 0 & 0 & 2\\end{aligned}]\n$$\n\nConsider the matrix $A$ above. Which of the following represents the corresponding quadratic form ${x}^{T}\\,Ax$ in terms of the components of $x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]?$" :question/worked-solution "**Method 1**\n\nEach entry ${a}_{ij}$ of $A$ corresponds to the term ${a}_{ij}{x}_{i}{x}_{j}$ in the expression of the quadratic form:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =2{x}_{1}{x}_{1}+1{x}_{1}{x}_{2}+0{x}_{1}{x}_{3}+1{x}_{2}{x}_{1}+(-2){x}_{2}{x}_{2}+0{x}_{2}{x}_{3}+0{x}_{3}{x}_{1}+0{x}_{3}{x}_{2}+2{x}_{3}{x}_{3} \\\\  & =2{x}_{1}^{2}+{x}_{1}{x}_{2}+{x}_{2}{x}_{1}-2{x}_{2}^{2}+2{x}_{3}^{2} \\\\  & =2{x}_{1}^{2}+2{x}_{1}{x}_{2}-2{x}_{2}^{2}+2{x}_{3}^{2}\\end{aligned}\n$$\n\n**Method 2**\n\nTo write down a quadratic form in terms of vector components, we compute the following expression:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =[\\begin{aligned}{x}_{1} & {x}_{2} & {x}_{3}\\end{aligned}][\\begin{aligned}2 & 1 & 0 \\\\ 1 & -2 & 0 \\\\ 0 & 0 & 2\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{1} & {x}_{2} & {x}_{3}\\end{aligned}][\\begin{aligned}2{x}_{1}+{x}_{2} \\\\ {x}_{1}-2{x}_{2} \\\\ 2{x}_{3}\\end{aligned}] \\\\  & ={x}_{1}(2{x}_{1}+{x}_{2})+{x}_{2}({x}_{1}-2{x}_{2})+{x}_{3}(2{x}_{3}) \\\\  & =2{x}_{1}^{2}+{x}_{1}{x}_{2}+{x}_{2}{x}_{1}-2{x}_{x}^{2}+2{x}_{3}^{2} \\\\  & =2{x}_{1}^{2}+2{x}_{1}{x}_{2}-2{x}_{2}^{2}+2{x}_{3}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186378361 :knowledge-point/_questions [{:knowledge-point/id #uuid "eb93c0ea-26d9-5190-9677-b8c7eb6f7ef1" :knowledge-point/title "Finding the Matrix of a Quadratic Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90e86eec-31b7-5bd9-a6fc-90890ae830e9" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186378363} {:answer/id #uuid "a29c1ca5-4e9c-582c-ba01-bc743b01e2c4" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186378364} {:answer/id #uuid "f534f31e-28eb-5ff1-abda-293ab86a0306" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186378365} {:answer/id #uuid "cac3577f-897f-5a07-a3d7-f0175f21c115" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186378366} {:answer/id #uuid "891ce537-9085-56b7-ae6f-e9125d0971ad" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186378367}] :answer-field/correct {:answer/id #uuid "90e86eec-31b7-5bd9-a6fc-90890ae830e9" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186378363} :answer-field/id #uuid "efb2f6a8-6a6c-58c9-b5eb-d20e4ea07ca7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378362}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "17223c22-baa8-51fd-870b-c084f2c85b4f" :question/math-academy-id "q-94116" :question/problem "$$\n[\\begin{aligned}a & b \\\\ b & -3\\end{aligned}]\n$$\n\nThe matrix of the quadratic form $Q(x)=-2{x}_{1}^{2}-10{x}_{1}{x}_{2}-3{x}_{2}^{2}\\,$ is given above. What is the value of $a+b?$" :question/worked-solution "Since the matrix of the quadratic form must be symmetric, we rewrite our expression as follows:\n\n$$\n\\begin{aligned}Q(x) & =-2{x}_{1}^{2}-10{x}_{1}{x}_{2}-3{x}_{2}^{2} \\\\  & =(-2){x}_{1}^{2}+(-5){x}_{1}{x}_{2} \\\\  & +\\,(-5){x}_{2}{x}_{1}+(-3){x}_{2}^{2}\\end{aligned}\n$$\n\nNotice that to get a symmetric matrix, we must split the coefficient of $-10{x}_{1}{x}_{2}$ between the entries \n\n$$\n{a}_{12}={a}_{21}=\\frac{-10}{2}=-5\n$$\n\nof our matrix. So, the matrix corresponding to our quadratic form is\n\n$$\n[\\begin{aligned}-2 & -5 \\\\ -5 & -3\\end{aligned}].\n$$\n\nTherefore, $a=-2$ and $b=-5.$ Finally, \n\n$$\na+b=-2+(-5)=-7.\n$$"}]}
