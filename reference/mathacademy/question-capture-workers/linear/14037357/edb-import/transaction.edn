n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-105234/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "67e90c94-5018-582f-8692-a1155f41f7c7"] :knowledge-point/questions ["q-105234"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81766/selection/edf0ea1c987ddf1364ed2e9de7e06cd178121b0a78eedad982e0d143a34fae81" :answer/id #uuid "0db51cb2-8bf8-5b33-a63b-bc763b47289f" :answer/type :answer.type/math :answer/value "{0,3,6,9,15,18,21,…}" :db/ensure [:answer/validate]} {:db/id "q-81766/selection/77d861beab4b167aac4145bb2723ab1eb426bfcbc99e7cd427088956286cd087" :answer/id #uuid "d4685bed-f4c4-5ce4-b803-08ec3f7b9daa" :answer/type :answer.type/math :answer/value "{3,6,9,15,18,21,…}" :db/ensure [:answer/validate]} {:db/id "q-81766/selection/2412b7f28c0361264a5b22b9d913bf2fa4dec94190a93a15de32d529a4ed6452" :answer/id #uuid "fb5b5b4e-290f-541c-ba2f-6ba2982c59cd" :answer/type :answer.type/math :answer/value "{12,24…}" :db/ensure [:answer/validate]} {:db/id "q-81766/selection/d1a0297bfe7c3c0ca4401535bd2f829cf3b7fd34cfb179c21422a68bf7d18aae" :answer/id #uuid "4a3343f8-3a82-58af-bc78-065391a8604e" :answer/type :answer.type/math :answer/value "{3,4,6,8,9,15,16,…}" :db/ensure [:answer/validate]} {:db/id "q-81766/selection/0d0fac73c254732ad4aee72ed8d237aca06c030795d1535e65325a5d3ce0a4a6" :answer/id #uuid "4a9bf1c3-c25e-546d-bf50-f506b6cb2bee" :answer/type :answer.type/math :answer/value "{4,8,16,20,…}" :db/ensure [:answer/validate]} {:db/id "q-81766/selection" :answer-field/id #uuid "af625279-b9b8-5e8b-9297-c5d5fbef4f97" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81766/selection/0d0fac73c254732ad4aee72ed8d237aca06c030795d1535e65325a5d3ce0a4a6" :answer-field/choices ["q-81766/selection/edf0ea1c987ddf1364ed2e9de7e06cd178121b0a78eedad982e0d143a34fae81" "q-81766/selection/77d861beab4b167aac4145bb2723ab1eb426bfcbc99e7cd427088956286cd087" "q-81766/selection/2412b7f28c0361264a5b22b9d913bf2fa4dec94190a93a15de32d529a4ed6452" "q-81766/selection/d1a0297bfe7c3c0ca4401535bd2f829cf3b7fd34cfb179c21422a68bf7d18aae" "q-81766/selection/0d0fac73c254732ad4aee72ed8d237aca06c030795d1535e65325a5d3ce0a4a6"] :db/ensure [:answer-field/validate]} {:db/id "q-81766" :question/id #uuid "c4c54f56-ff83-5c5e-b062-1e1004f84f48" :question/math-academy-id "q-81766" :question/problem "Let $A$  be the set of all multiples of $3$ greater than $0$ and let $B$  be the set of all multiples of $4$ greater than $0.$ What is $B-A?$" :question/worked-solution "The multiples of $3$ that are greater than $0$ are\n\n$$\nA={3,6,9,12,15,18,21,24,…}.\n$$\n\nLikewise, multiples of $4$ that are greater than $0$ are\n\n$$\nB={4,8,12,16,20,24,…}.\n$$\n\nNow, $B-A$ is the *difference* of $B$ and $A,$ which means that we want to find the elements that are in $B$ but *not* in $A.$\n\nThe elements of $B$ that are also in $A$ are $12,24,$ and so on (i.e. multiples of $12$). So, we must remove these elements from $B.$ Therefore, we have\n\n$$\n\\begin{aligned}B-A & ={4,8,12,16,20,24,…}-{3,6,9,12,15,18,21,24,…} \\\\  & ={4,8,16,20,…}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-81766/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "67e90c94-5018-582f-8692-a1155f41f7c7"] :knowledge-point/questions ["q-81766"] :db/ensure [:knowledge-point/validate]} {:db/id "q-86704/selection/2531b01062963bf17cb1953367062769d91dcfc4519f4f6b120c5de4951d40dd" :answer/id #uuid "d570f2dc-feb9-5b76-8a34-e27c0daa2db7" :answer/type :answer.type/math :answer/value "∅" :db/ensure [:answer/validate]} {:db/id "q-86704/selection/538875f3ddfaf6d10c15e46cf3e674474502851006cbdbfb11ef2c45dd7416fc" :answer/id #uuid "cd0e9672-9b63-5d8a-89f7-7848589f0b62" :answer/type :answer.type/math :answer/value "{2,4,8,16,32,…}" :db/ensure [:answer/validate]} {:db/id "q-86704/selection/b6bd6746f786c7573c547754d346d226902b035874b00c58981d5d2d8a3233f1" :answer/id #uuid "43368a1c-ade4-511d-afc7-94d932fc4510" :answer/type :answer.type/math :answer/value "{1,2,4,8,16,32,…}" :db/ensure [:answer/validate]} {:db/id "q-86704/selection/199bf851613ea946edb4e75e8324794a50da9033dd50c48435253896891f6573" :answer/id #uuid "7ecf4f13-46a7-5a48-8781-3e8aa487b4f1" :answer/type :answer.type/math :answer/value "{1}" :db/ensure [:answer/validate]} {:db/id "q-86704/selection/a851dd9aad90d1622fc271934bebead7b0ea3e7a6886ed17492aa11ab950a857" :answer/id #uuid "5af50fb6-4ecf-5b53-b877-067f72197875" :answer/type :answer.type/math :answer/value "{3,9,27,81,…}" :db/ensure [:answer/validate]} {:db/id "q-86704/selection" :answer-field/id #uuid "64e0a480-4f13-59b7-a55d-6b4ac38114fe" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-86704/selection/538875f3ddfaf6d10c15e46cf3e674474502851006cbdbfb11ef2c45dd7416fc" :answer-field/choices ["q-86704/selection/2531b01062963bf17cb1953367062769d91dcfc4519f4f6b120c5de4951d40dd" "q-86704/selection/538875f3ddfaf6d10c15e46cf3e674474502851006cbdbfb11ef2c45dd7416fc" "q-86704/selection/b6bd6746f786c7573c547754d346d226902b035874b00c58981d5d2d8a3233f1" "q-86704/selection/199bf851613ea946edb4e75e8324794a50da9033dd50c48435253896891f6573" "q-86704/selection/a851dd9aad90d1622fc271934bebead7b0ea3e7a6886ed17492aa11ab950a857"] :db/ensure [:answer-field/validate]} {:db/id "q-86704" :question/id #uuid "75546b77-28ba-5102-9034-ab09a7671149" :question/math-academy-id "q-86704" :question/problem "Let $X$  be the set of all non-negative integer powers of $2$ and let $Y$  be the set of all non-negative integer powers of $3.$  What is $X-Y?$" :question/worked-solution "The powers of $2$ that are greater or equal to $1$ are\n\n$$\nX={1,2,4,8,16,32,…}.\n$$\n\nLikewise, the powers of $3$ that are greater or equal to $1$ are\n\n$$\nY={1,3,9,27,81,…}.\n$$\n\nNow, $X-Y$ is the *difference* of $X$ and $Y,$ which means that we want to find the elements that are in $X$ but *not* in $Y.$\n\nThe only element of $X$ that are also in $Y$ is $1.$ So, we must remove this element from $X.$ Therefore, we have\n\n$$\n\\begin{aligned}X-Y & ={1,2,4,8,16,32,…}-{1,3,9,27,81,…} \\\\  & ={2,4,8,16,32,…}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-86704/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "67e90c94-5018-582f-8692-a1155f41f7c7"] :knowledge-point/questions ["q-86704"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-7167"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037357/assets/96cd980d105fe04d2169f9252aa2e7e08bf57ba18cf7d7808d0c4c98c83f7767.png)\n\nGiven the sets $X = \\{ 1, 2, 3, 5, 8 \\}$ and $Y = \\{ 1, 2, 4, 8 \\}$ shown above, find $Y \\setminus X.$" :question/worked-solution "The difference $Y \\setminus X$ consists of all the elements that are in $Y$ but not $X.$ To represent $Y \\setminus X,$ we will shade in all the area that is contained in $Y$ but not $X.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037357/assets/5461edca3823f1cafd9f7b51528cd6eb1035e38f7f94c60177e369e2cdd5f350.png)\n\nThe only element in $Y$ that is not in $X$ is $4.$\n\nTherefore, the difference is\n\n$$\nY \\setminus X = \\{ 4 \\}.\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7159"] :question/problem "Given the sets $X = \\{ 2, 5, 7, 8 \\},$ $Y = \\{ 1, 3, 5 \\},$ and $Z = \\{ 2, 4, 6, 8 \\},$ find $X \\setminus Y,$ $Y \\setminus Z,$ and $Z \\setminus X.$" :question/worked-solution "The set $X \\setminus Y$ is the set of all elements belonging to $X$ but *not* $Y.$ Note that the element $5 \\in Y$ is also in $X,$ so we must remove it. Hence, we have\n\n$$\n\\begin{aligned}X∖Y & =X-Y \\\\  & ={2,5,7,8}-{1,3,5} \\\\  & ={2,7,8}.\\end{aligned}\n$$\n\nThe set $Y \\setminus Z$ is the set of all elements belonging to $Y$ but *not* $Z.$ Note that none of the elements of $Y$ are in $Z.$ So, we have\n\n$$\n\\begin{aligned}Y∖Z & =Y-Z \\\\  & ={1,3,5}-{2,4,6,8} \\\\  & ={1,3,5}.\\end{aligned}\n$$\n\nThe set $Z \\setminus X$ is the set of all elements belonging to $Z$ but *not* $X.$ Note that the elements $2,8 \\in Z$ are also in $X,$ so we must remove them. Therefore, we have\n\n$$\n\\begin{aligned}Z∖X & =Z-X \\\\  & ={2,4,6,8}-{2,5,7,8} \\\\  & ={4,6}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7160"] :question/problem "Let $A$ be the set of all multiples of $4$ that are greater than $0$ and let $B$ be the set of all multiples of $6$ that are greater than $0.$ What is $A \\setminus B?$" :question/worked-solution "The multiples of $4$ that are greater than $0$ are\n\n$$\nA = \\{ 4,8,12,16,20,24,28,32, 36 \\ldots \\}.\n$$\n\nLikewise, multiples of $6$ that are greater than $0$ are\n\n$$\nB = \\{ 6,12,18,24,30,36,\\ldots \\}.\n$$\n\nNow, $A \\setminus B$ is the *difference* of $A$ and $B,$ which means that we want to find the elements that are in $A$ but *not* in $B.$\n\nThe elements of $A$ that are also in $B$ are $12, 24, 36$ and so on (i.e. multiples of $12$). So, we must remove these elements from $A.$ Therefore, we have\n\n$$\n\\begin{aligned}A∖B & =A-B \\\\  & ={4,8,12,16,20,24,28,32,36,…}-{6,12,18,24,30,36,…} \\\\  & ={4,8,16,20,28,32,…}.\\end{aligned}\n$$" :db/ensure [:question/validate]}]
