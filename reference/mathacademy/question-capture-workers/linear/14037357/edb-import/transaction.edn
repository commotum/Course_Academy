5810" :question/problem "Given the sets $X={♠,◻,♡,♢,△}$ and $Y={♠,◻,♣,♡},$ find $X∖Y.$" :question/worked-solution "The set  $X∖Y$ is the set of all elements belonging to $X$ but *not* $Y.$ Note that the elements $♠,◻,♡\\in X$ are also in $Y,$ so we must remove them. Therefore, we have\n\n$$\n\\begin{aligned}X∖Y & =X-Y \\\\  & ={♠,◻,♡,♢,△}-{♠,◻,♣,♡} \\\\  & ={△,♢}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-105810/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d9a9b6de-b0dd-5b38-a32b-378d2b1d86a2"] :knowledge-point/questions ["q-105810"] :db/ensure [:knowledge-point/validate]} {:db/id "q-105217/selection/e630beebbaeb3105aed01b469e34eb8d3f3ae6ce22cc3830e6d323ed12ab29ec" :answer/id #uuid "b2015b1d-39d3-509f-9667-39d9d1f844e2" :answer/type :answer.type/math :answer/value "{6,10,12,14}" :db/ensure [:answer/validate]} {:db/id "q-105217/selection/199bf851613ea946edb4e75e8324794a50da9033dd50c48435253896891f6573" :answer/id #uuid "857aadd1-6381-5c2f-869b-9c0b0669b72b" :answer/type :answer.type/math :answer/value "{1}" :db/ensure [:answer/validate]} {:db/id "q-105217/selection/7ab1fda9fe24c3366a242000f97a0ef0166baff7f8656ff96b54d52dc366cb5f" :answer/id #uuid "0e919cad-5f2f-5805-ae9f-9d243ae31d2a" :answer/type :answer.type/math :answer/value "{6,12}" :db/ensure [:answer/validate]} {:db/id "q-105217/selection/6af8d9d2cd6b51aa8c51836c7c58de98d6c1636cab16a1683045954e1d5a70fa" :answer/id #uuid "c214dc9d-286b-578d-aadd-364b2695e258" :answer/type :answer.type/math :answer/value "{2,4,8,16}" :db/ensure [:answer/validate]} {:db/id "q-105217/selection/3013d1a639cc2b5f1862665875abf2ae5931a7ddf018132f32a9e7d015c07e42" :answer/id #uuid "95cfe00c-eebf-5477-a2cd-2b99da35d314" :answer/type :answer.type/math :answer/value "{1,16}" :db/ensure [:answer/validate]} {:db/id "q-105217/selection" :answer-field/id #uuid "643fdc46-1f73-52bb-8d36-e1c075253322" :answer-field/key "selection" :answer-field/type :answer-fi