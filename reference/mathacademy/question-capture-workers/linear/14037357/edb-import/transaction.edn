 not $B.$\n\nTherefore, the difference is\n\n$$\nA-B={1,3,12}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-81652/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4687dcd7-a5ab-5dc6-be6d-89d806a61a02"] :knowledge-point/questions ["q-81652"] :db/ensure [:knowledge-point/validate]} {:db/id "q-105200/selection/746aa2ab51e925e42e657949361daedb580e35270dbfc76266195f7ce0ee0575" :answer/id #uuid "3bbbe227-245b-50c1-b20d-ddb6bfe70b54" :answer/type :answer.type/math :answer/value "{♠,◻,♣,♡}" :db/ensure [:answer/validate]} {:db/id "q-105200/selection/214035fa2a5842052f1f0d7eebaee2dc02a140e0d1eaaebf08ed528c4cd7edc8" :answer/id #uuid "cf1b1061-5741-59d8-a418-ceda12486338" :answer/type :answer.type/math :answer/value "{♠,♢}" :db/ensure [:answer/validate]} {:db/id "q-105200/selection/a4d078b3e3ab11b083e0ffee52dfad5cdbbd4583812f4551cf80eba1f11854ee" :answer/id #uuid "fd5d56bc-47e6-5789-bd05-4f2c1efb6494" :answer/type :answer.type/math :answer/value "{△,◻,♠}" :db/ensure [:answer/validate]} {:db/id "q-105200/selection/7762b028c5454e3da2b978b021475d76b85275885bac29edfd765fb807304e57" :answer/id #uuid "942a9098-88e6-5763-89c4-6b4c5ddf6534" :answer/type :answer.type/math :answer/value "{♣}" :db/ensure [:answer/validate]} {:db/id "q-105200/selection/b840e16884db314a1bbeb48c19cdf00f47bec6b6148fec9d79295e2fea7b986a" :answer/id #uuid "4abc2d44-192f-57ff-b76b-98726c327864" :answer/type :answer.type/math :answer/value "{♠,♢,♣}" :db/ensure [:answer/validate]} {:db/id "q-105200/selection" :answer-field/id #uuid "551fbd58-5433-5802-8da1-414f635af75f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-105200/selection/214035fa2a5842052f1f0d7eebaee2dc02a140e0d1eaaebf08ed528c4cd7edc8" :answer-field/choices ["q-105200/selection/746aa2ab51e925e42e657949361daedb580e35270dbfc76266195f7ce0ee0575" "q-105200/selection/214035fa2a5842052f1f0d7eebaee2dc02a140e0d1eaaebf08ed528c4cd7edc8" "q-105200/selection/a4d078b3e3ab11b083e0ffee52dfad5cdbbd4583812f4551cf80eba1f11854ee" "q-105200/selection/7762b028c5454e3da2b978b021475d76b85275885bac29edfd765fb807304e57" "q-105200/selection/b840e16884db314a1bbeb48c19cdf00f47bec6b6148fec9d79295e2fea7b986a"] :db/ensure [:answer-field/validate]} {:db/id "q-105200" :question/id #uuid "faa23ac8-04a3-5479-a9d4-ad113271640a" :question/math-academy-id "q-105200" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037357/assets/a50acd7e54d52f6284962cb81a5f662321b045a5d533470186719ad2a91ab18b.png)\n\nGiven the sets $Y={△,◻,♣,♡}$ and  $Z={△,◻,♡,♢,♠}$ shown above, find $Z∖Y.$" :question/worked-solution "The difference $Z∖Y$ consists of all the elements that are in $Z$ but not $Y.$ To represent $Z∖Y,$ we will shade in all the area that is contained in $Z$ but not $Y.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037357/assets/45a15beb8833e2974706a04b0cdfd81dcdda4b92323f0c092683b9882e53b0ea.png)\n\nThe elements $♠$ and $♢$ are in $Z$  but not $Y.$\n\nTherefore, the difference is\n\n$$\nZ∖Y={♠,♢}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-105200/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4687dcd7-a5ab-5dc6-be6d-89d806a61a02"] :knowledge-point/questions ["q-105200"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-36189"] :question/problem "If $A={3,4,5,6,9,10,15}$ and $B={3,4,5,7},$ then $A∖B=$" :question/worked-solution "The set $A∖B$ is the set of all elements belonging to $A$ but *not* $B.$ Note that the elements $3,4,5\\in B$ are also in $A,$ so we must remove them. Therefore, we have\n\n$$\n\\begin{aligned}A∖B & =A-B \\\\  & ={3,4,5,6,9,10,15}-{3,4,5,7} \\\\  & ={6,9,10,15}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-105810/selection/ff0fb231981473