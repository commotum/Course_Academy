question.difficulty/easy :question/answer-fields ["q-110458/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b0341b26-9c91-5b8a-a917-20129155e336"] :knowledge-point/questions ["q-110458"] :db/ensure [:knowledge-point/validate]} {:db/id "q-75109/selection/725ef01e1bcdf2ea508e95ce5f789e03332ff0c1557337953f220c79dc17b540" :answer/id #uuid "53f8860d-7902-5ac1-bc50-ebbda2fd4a42" :answer/type :answer.type/math :answer/value "{R}_{1}:={R}_{1}+{R}_{3}" :db/ensure [:answer/validate]} {:db/id "q-75109/selection/7464d375c262472e34d6ff04aacc0efb30a3f3f9c727673965683a6629bfb102" :answer/id #uuid "bc2b987a-d35c-5eb3-ab8e-91e3b90ff178" :answer/type :answer.type/math :answer/value "{R}_{3}:={R}_{3}+2{R}_{1}" :db/ensure [:answer/validate]} {:db/id "q-75109/selection/e44e3159806aca9868b5d0246414293b36271b64abe99435d412d7cb9caa8859" :answer/id #uuid "f947e638-8d7d-5ffc-8299-92c09a37d539" :answer/type :answer.type/math :answer/value "{R}_{1}:={R}_{1}+2{R}_{3}" :db/ensure [:answer/validate]} {:db/id "q-75109/selection/9e4d97ed0a8fe56e27a5ede38885d0aa54cdfaefa5ae2408973b0c1465e7d8e7" :answer/id #uuid "87f51757-ba6f-5e4a-8b71-8a3253188b29" :answer/type :answer.type/math :answer/value "{R}_{1}:=2{R}_{1}" :db/ensure [:answer/validate]} {:db/id "q-75109/selection/425fbff485ccb8732d13fb8a84fd099bcb91ece8f3d002566e6e35228634720f" :answer/id #uuid "eb1b2f50-28b1-5573-9621-f2935c11038f" :answer/type :answer.type/math :answer/value "{R}_{1}:={R}_{1}+2{R}_{2}" :db/ensure [:answer/validate]} {:db/id "q-75109/selection" :answer-field/id #uuid "3c07cf12-f254-5aac-a4ee-1ec10fc6350a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-75109/selection/e44e3159806aca9868b5d0246414293b36271b64abe99435d412d7cb9caa8859" :answer-field/choices ["q-75109/selection/725ef01e1bcdf2ea508e95ce5f789e03332ff0c1557337953f220c79dc17b540" "q-75109/selection/7464d375c262472e34d6ff04aacc0efb30a3f3f9c727673965683a6629bfb102" "q-75109/selection/e44e3159806aca9868b5d0246414293b36271b64abe99435d412d7cb9caa8859" "q-75109/selection/9e4d97ed0a8fe56e27a5ede38885d0aa54cdfaefa5ae2408973b0c1465e7d8e7" "q-75109/selection/425fbff485ccb8732d13fb8a84fd099bcb91ece8f3d002566e6e35228634720f"] :db/ensure [:answer-field/validate]} {:db/id "q-75109" :question/id #uuid "f1976cb5-7f64-58e8-89f5-a7e4a9f9c0c4" :question/math-academy-id "q-75109" :question/problem "Consider $E=[\\begin{aligned}1 & 0 & 2 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]$ and a $3\\times 3$ matrix $A.$ Find the row operation that, when applied to $A,$ is equivalent to multiplying $A$ by the given elementary matrix $E$ from the left." :question/worked-solution "The given matrix $E$ is obtained by taking the first row of ${I}_{3}$ and adding $2$ times the third row:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+2{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 2 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =E\\end{aligned}\n$$\n\nTherefore, $EA$ is equivalent to applying the elementary row operation ${R}_{1}:={R}_{1}+2{R}_{3}$ to $A.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-75109/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b0341b26-9c91-5b8a-a917-20129155e336"] :knowledge-point/questions ["q-75109"] :db/ensure [:knowledge-point/validate]} {:db/id "q-110464/selection/6b85ef96993267f31986aa383e26874c85c65d1163a655c5c19a19f3451aff64" :answer/id #uuid "83224c01-3bab-53a3-aee6-e81a7ab4ec41" :answer/type :answer.type/math :answer/value "{R}_{3}:={R}_{3}+\\frac{1}{9}{R}_{1}" :db/ensure [:answer/validate]} {:db/id "q-110464/selection/3546c3f80d63f33788ff78c640923f0584a6ea56d235ff629e5c145903710d5b" :answer/id #uuid "b24c6681-76dc-5361-9295-766ab13053ef" :answer/type :answer.type/math :answer/value "{R}_{3}:=9{R}_{3}" :db/ensure [:answer/validate]} {:db/id "q-110464/selection/118feea7778ee27cd0d431ed8f733a571b5b4c6cd3