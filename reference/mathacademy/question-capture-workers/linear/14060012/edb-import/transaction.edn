1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{3} & :=9{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 9\\end{aligned}] \\\\  & =E\\end{aligned}\n$$\n\nTherefore, $EA$ is equivalent to applying the elementary \nrow operation ${R}_{3}:=9{R}_{3}$ to $A.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-110464/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b0341b26-9c91-5b8a-a917-20129155e336"] :knowledge-point/questions ["q-110464"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-32147"] :question/problem "Consider $E=[\\begin{aligned}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}]$ and a $3\\times 3$ matrix $A.$\nFind the row operation that, when applied to $A,$ is equivalent to multiplying $A$ by the given elementary matrix $E$ from the left." :question/worked-solution "The given matrix $E$ is obtained by swapping the first and the second rows of ${I}_{3}:$\n\n$$\n\\begin{aligned}{I}_{3} & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =E\\end{aligned}\n$$\n\nTherefore, $EA$ is equivalent to applying the elementary \nrow operation ${R}_{1}↔{R}_{2}$ to $A.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-32146/selection/5e97c039b57fcf947bce11441ed02231ac89c4bc40cc8ab5d19a0d460907421d" :answer/id #uuid "c4997d6c-f575-5d54-9cf5-73a8f7f5b705" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "q-32146/selection/99b9562280a8a8c3ee7cfdbde0db6cdae07585bd094b0994ae1c6a6067b6f4d1" :answer/id #uuid "723b2e10-9f37-53bd-93f5-49cc1194e37c" :answer/type :answer.type/math :answer/value "A\\cdot [\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{a