        {
          "question": "e-4734",
          "field": null,
          "attribute": "question/problem",
          "value": "Suppose we are applying these two elementary row operations, in the given order, to a $3\\times 3$ matrix $A\\mathbin{:}$\n\n$$\nR_2\\leftrightarrow R_3, \\qquad\n\tR_1:=6R_1\n$$\n\nFind the equivalent notation in terms of matrix multiplication.",
          "category": "ma_capture",
          "file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060012/example-4734.json",
