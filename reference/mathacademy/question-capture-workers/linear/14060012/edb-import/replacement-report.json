          "question": "q-32128",
          "field": null,
          "attribute": "question/problem",
          "value": "Suppose that the elementary row operation ${R}_{2}:={R}_{2}-3{R}_{3}$ is applied to a $3\\times 3$ matrix $A.$ What is the equivalent notation in terms of matrix multiplication?",
          "category": "ma_capture",
          "file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060012/state.json",
