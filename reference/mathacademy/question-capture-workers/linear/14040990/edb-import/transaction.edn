c9b4f9bd0ab22acd21c63e756f873"] :db/ensure [:answer-field/validate]} {:db/id "q-141480" :question/id #uuid "aba9a00f-cb4d-5b06-bebd-53c73877d87c" :question/math-academy-id "q-141480" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040990/assets/0c681289ee631de241f876091878b84cd9497c5d8e71d27512f9a832c242329b.png)\n\nConsider the diagram shown above, where $\\overset{\\to }{QP}=a,$ $\\overset{\\to }{RS}=b,$ $\\overset{\\to }{RT}=c,$ and $\\overset{\\to }{RP}=d.$ Find $\\overset{\\to }{QS}$ in terms of $a,b,c,$ and $d.$" :question/worked-solution "We want to find a \"path\" from $Q$ to $S$ consisting only of the vectors $a,b,c,$ and $d.$ \n\nAccording to the triangle law of addition,\n\n$$\n\\overset{\\to }{QS}=\\overset{\\to }{QP}+\\overset{\\to }{PR}+\\overset{\\to }{RS}\n$$\n\nas shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040990/assets/317d78cec35bc3721ebbd64ac1ed53aa5b36c89101a170b93805d17c670f2673.png)\n\n  \n\nNow, from the original diagram, we have that\n\n$$\n\\overset{\\to }{QP}=a,\\,\\overset{\\to }{PR}=-d,\\,\\overset{\\to }{RT}=b.\n$$\n\nLet's add these to our diagram.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040990/assets/ff4b4292bb8a15551cb22da1f621684e9fdf24d35ae873b408dc612e5b3255e8.png)\n\n   \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\overset{\\to }{QS} & =\\overset{\\to }{QP}+\\overset{\\to }{PR}+\\overset{\\to }{RS} \\\\  & =a-d+b.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-141480/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "33f0ec6b-9cb4-5246-9ac6-23b35e3b224e"] :knowledge-point/questions ["q-141480"] :db/ensure [:knowledge-point/validate]} {:db/id "q-335826/field-1/6534707bba1f87cc35e34b0147e323d1b2482259aa3dc1136e21c3b61033f053" :answer/id #uuid "b72b5961-3ab4-5ad8-9ea7-fc582874d0bb" :answer/type :answer.type/math :answer/value "c-a-b+d" :db/ensure [:answer/validate]} {:db/id "q-335826/field-1" :answer-field/id #uuid "be832db7-8c94-5e8f-9f67-0a036205dc86" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-335826/field-1/6534707bba1f87cc35e34b0147e323d1b2482259aa3dc1136e21c3b61033f053" :answer-field/choices ["q-335826/field-1/6534707bba1f87cc35e34b0147e323d1b2482259aa3dc1136e21c3b61033f053"] :db/ensure [:answer-field/validate]} {:db/id "q-335826" :question/id #uuid "649372db-d035-5c8c-959e-85806024367f" :question/math-academy-id "q-335826" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040990/assets/4ad1c49955142936f8b6fef257af8021e4eb9aa576cd37ebed149e5a31fbedc8.png)\n\nConsider the diagram shown above, where $\\overset{\\to }{EF}=a,$ $\\overset{\\to }{GE}=b,$ $\\overset{\\to }{AF}=c,$ and $\\overset{\\to }{GC}=d.$ Find $\\overset{\\to }{AC}$ in terms of  $a,b,c,$ and $d.$ To denote the corresponding vectors, use $a$, $b,$ $c,$ and $d.$\n\n$\\overset{\\to }{AC}=$   \n {{field-1}}" :question/worked-solution "We want to find a \"path\" from $A$ to $C$ consisting only of the vectors $a,b,c,$ and $d.$\n\nAccording to the triangle law of addition,\n\n$$\n\\overset{\\to }{AC}=\\overset{\\to }{AF}+\\overset{\\to }{FE}+\\overset{\\to }{EG}+\\overset{\\to }{GC}\n$$\n\nas shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040990/assets/e24ac0b6cf4f039cd1e8b2e1aa5dd921ea637fb2fe46666a0091372dfce87d44.png)\n\n \n\nNow, from the original diagram, we have that\n\n$$\n\\overset{\\to }{AF}=c,\\,\\overset{\\to }{FE}=-a,\\,\\overset{\\to }{EG}=-b\\,\\overset{\\to }{GC}=d.\n$$\n\nLet's add these to our diagram.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040990/assets/37c3758dc7a4c8a5b79c3e687e77f62090282410e3bf45bfade3494cd3b8055b.png)\n\n \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\overset{\\to }{AC} & =\\overset{\\to }{AF}+\\overset{\\to }{FE}+\\overset{\\to }{EG}+\\overset{\\to }{GC} \\\\  & =c+(-a)+(-b)+d \\\\  & =c-a-b+d.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-335826/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "33f0ec6b-9cb4-5246-9ac6-23b35e3b224e"] :knowledge-point/questions ["q-335826"] :db/ensure [:knowledge-point/validate]} {:db/id "q-277042/field-1/47d2cdaad2e2f1eac34036876322fd99050efb3f845acbb1ec81b545cad48248" :answer/id #uuid "19db4f5d-20fc-546c-904c-098bc61a1d6a" :answer/type :answer.type/math :answer/value "d-c+b" :db/ensure [:answer/validate]} {:db/id "q-277042/field-1" :answer-field/id #uuid "2fdd2975-c974-5620-9f1a-2a88cf52b4b3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-277042/field-1/47d2cdaad2e2f1eac34036876322fd99050efb3f845acbb1ec81b545cad48248" :answer-field/choices ["q-277042/field-1/47d2cdaad2e2f1eac34036876322fd99050efb3f845acbb1ec81b545cad48248"] :db/ensure [:answer-field/validate]} {:db/id "q-277042" :question/id #uuid "0ca4b3b4-20e7-5510-9496-d5c7e648e922" :question/math-academy-id "q-277042" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040990/assets/241d4b1d29efddc5a9feb13b835d0caab6af354d3f62387dc92d14ff81942a6d.png)\n\nConsider the diagram shown above, where $\\overset{\\to }{QP}=a,$ $\\overset{\\to }{UP}=b,$ $\\overset{\\to }{UT}=c,$ and $\\overset{\\to }{RT}=d.$ Find $\\overset{\\to }{RP}$ in terms of the vectors $a,b,c,$ and $d.$ To denote the corresponding vectors, use $a$, $b,$ $c,$ and $d.$\n\n$\\overset{\\to }{RP}=$   \n {{field-1}}" :question/worked-solution "We want to find a \"path\" from $R$ to $P$ consisting only of the vectors $a,b,c,$ and $d.$\n\nAccording to the triangle law of addition,\n\n$$\n\\overset{\\to }{RP}=\\overset{\\to }{RT}+\\overset{\\to }{TU}+\\overset{\\to }{UP}\n$$\n\nas shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040990/assets/b4ebdca78235f8f82564db1821320c7bb886447cb012813173e9c50558dbc9bb.png)\n\n \n\nNow, from the original diagram, we have that\n\n$$\n\\overset{\\to }{RT}=d,\\,\\overset{\\to }{TU}=-c,\\,\\overset{\\to }{TU}=b.\n$$\n\nLet's add these to our diagram.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040990/assets/540f94306cc497d87dc1f15d61ea929e042944f7c6f711a2bcf6b1f944c48228.png)\n\n \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\overset{\\to }{RP} & =\\overset{\\to }{RT}+\\overset{\\to }{TU}+\\overset{\\to }{UP} \\\\  & =d-c+b.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-277042/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "33f0ec6b-9cb4-5246-9ac6-23b35e3b224e"] :knowledge-point/questions ["q-277042"] :db/ensure [:knowledge-point/validate]} {:db/id "q-69539/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "fe6ef57c-9154-5384-bedf-38b38637a027" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-69539/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "95007e16-efe4-5ab3-81b2-5183c45f5eac" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-69539/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "8439cc2a-f4be-5d0b-9a73-21560f74171e" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-69539/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "5c9c11c8-0feb-5cce-95c0-b09f7947e32a" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-69539/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "0db09e0d-65e4-5d31-b355-ef0ea2526827" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-69539/selection" :answer-field/id #uuid "6e437920-4dba-5cd2-81e5-92329f33c30a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-69539/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer-field/choices ["q-69539/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-69539/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-69539/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-69539/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-69539/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981"] :db/ensure [:answer-field/validate]} {:db/id "q-69539" :question/id #uuid "9fba8117-2a8c-5edb-aca0-764fe3cd4be5" :question/math-academy-id "q-69539" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040990/assets/86aac25c634d29639329ae53209141ce81a3a82a70d42a4c2dfc6d356ee378b8.png)\n\nIn figure $ABCD$ shown above, which of the following are equal to the vector $\\overset{\\to }{DB}?$\n\n- $\\overset{\\to }{DA}+\\overset{\\to }{AC}+\\overset{\\to }{CB}$\n- $\\overset{\\to }{DA}+\\overset{\\to }{AB}$\n- $\\overset{\\to }{BA}-\\overset{\\to }{CA}+\\overset{\\to }{CD}$" :question/worked-solution "- For the $1$st expression, we have:\n\n$$\n\\begin{aligned}\\overset{\\to }{DA}+\\overset{\\to }{AC}+\\overset{\\to }{CB} & =(\\overset{\\to }{DA}+\\overset{\\to }{AC})+\\overset{\\to }{CB} \\\\  & =\\overset{\\to }{DC}+\\overset{\\to }{CB} \\\\  & =\\overset{\\to }{DB}\\,✓\\end{aligned}\n$$\n\n- For the $2$nd expression, we have:\n\n$$\n\\begin{aligned}\\overset{\\to }{DA}+\\overset{\\to }{AB} & =\\overset{\\to }{DB}\\,✓\\end{aligned}\n$$\n\n- For the $3$rd expression, we have:\n\n$$\n\\begin{aligned}\\overset{\\to }{BA}-\\overset{\\to }{CA}+\\overset{\\to }{CD} & =(\\overset{\\to }{BA}-\\overset{\\to }{CA})+\\overset{\\to }{CD} \\\\  & =(\\overset{\\to }{BA}+\\overset{\\to }{AC})+\\overset{\\to }{CD} \\\\  & =\\overset{\\to }{BC}+\\overset{\\to }{CD} \\\\  & =\\overset{\\to }{BD} \\\\  & \\ne \\overset{\\to }{DB}\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and II only\"." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-69539/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c015dcaa-2155-5d80-985b-21924de92b28"] :knowledge-point/questions ["q-69539"] :db/ensure [:knowledge-point/validate]} {:db/id "q-143006/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "8c37c2e7-b1dc-5e1f-b29e-7d7d21b8d4f5" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-143006/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "90a591af-968f-5bf0-8335-16828df05dc8" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-143006/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "6ce8a804-6496-5bb9-a268-0eaa67aca621" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-143006/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "87be4317-b9b7-5031-ad29-f9c6cb78bfa4" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-143006/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "fb20b5a3-56e4-50c3-ae66-1d5477a6c0df" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-143006/selection" :answer-field/id #uuid "110a6969-1c4c-5663-bc1e-1e533eb59026" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-143006/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer-field/choices ["q-143006/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-143006/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-143006/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-143006/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-143006/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981"] :db/ensure [:answer-field/validate]} {:db/id "q-143006" :question/id #uuid "72a6419d-1699-5afc-b525-4d434382a0f6" :question/math-academy-id "q-143006" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040990/assets/15f4bd7f8ecf8f61ce84858e33cdfa468b0de360fac19b0713b6b2dbc4af8d2e.png)\n\nIn figure $ABCDEF$ shown above, which of the following equalities are true?\n\n- $\\overset{\\to }{AB}-\\overset{\\to }{AF}=\\overset{\\to }{BF}$\n- $\\overset{\\to }{DE}+\\overset{\\to }{EA}-\\overset{\\to }{BA}=\\overset{\\to }{DB}$\n- $\\overset{\\to }{BE}-\\overset{\\to }{DE}-\\overset{\\to }{CD}=\\overset{\\to }{CB}$" :question/worked-solution "- Equality I is false. Indeed, \n\n$$\n\\begin{aligned}\\overset{\\to }{AB}-\\overset{\\to }{AF} & =\\overset{\\to }{AB}+\\overset{\\to }{FA} \\\\  & =\\overset{\\to }{FB} \\\\  & \\ne \\overset{\\to }{BF}.\\end{aligned}\n$$\n\n- Equality II is true. Indeed, \n\n$$\n\\begin{aligned}\\overset{\\to }{DE}+\\overset{\\to }{EA}-\\overset{\\to }{BA} & =\\overset{\\to }{DE}+(\\overset{\\to }{EA}+\\overset{\\to }{AB}) \\\\  & =\\overset{\\to }{DE}+\\overset{\\to }{EB} \\\\  & =\\overset{\\to }{DB}.\\end{aligned}\n$$\n\n- Equality III is false. Indeed,\n\n$$\n\\begin{aligned}\\overset{\\to }{BE}-\\overset{\\to }{DE}-\\overset{\\to }{CD} & =(\\overset{\\to }{BE}+\\overset{\\to }{ED})+\\overset{\\to }{DC} \\\\  & =\\overset{\\to }{BD}+\\overset{\\to }{DC} \\\\  & =\\overset{\\to }{BC} \\\\  & \\ne \\overset{\\to }{CB}.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"II only\"." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-143006/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c015dcaa-2155-5d80-985b-21924de92b28"] :knowledge-point/questions ["q-143006"] :db/ensure [:knowledge-point/validate]} {:db/id "q-77389/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "d6eb5c9c-3776-52e4-a780-e90b1f997c68" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-77389/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "9e12094c-afb0-5486-a21c-a9a083956bec" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-77389/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "ef54e2e4-dc52-5619-94c4-caa686b8b145" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-77389/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "146a87b4-434d-5630-a3aa-9e5a5d1f39da" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-77389/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "40648d0b-2983-5172-807f-84497531b6f7" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-77389/selection" :answer-field/id #uuid "16c76cba-0957-593a-9204-b41e1ddd42a3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-77389/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer-field/choices ["q-77389/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-77389/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-77389/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-77389/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-77389/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9"] :db/ensure [:answer-field/validate]} {:db/id "q-77389" :question/id #uuid "9cd0ffdc-db96-54d0-a5a8-0ff0a6ddcfc8" :question/math-academy-id "q-77389" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040990/assets/e17584d96cb8d83ccb1abfbd16c4117f58639b7cd3462ee50ad3f31e4eabe279.png)\n\nIn figure $ABCDEF$ shown above, which of the following equalities are true?\n\n- $\\overset{\\to }{BC}-\\overset{\\to }{DC}=\\overset{\\to }{BD}$\n- $\\overset{\\to }{BA}+\\overset{\\to }{AE}-\\overset{\\to }{FE}=\\overset{\\to }{BF}$\n- $\\overset{\\to }{CD}-\\overset{\\to }{ED}-\\overset{\\to }{FE}=\\overset{\\to }{FC}$" :question/worked-solution "- Equality I is true. Indeed, \n\n$$\n\\begin{aligned}\\overset{\\to }{BC}-\\overset{\\to }{DC} & =\\overset{\\to }{BC}+\\overset{\\to }{CD} \\\\  & =\\overset{\\to }{BD}.\\end{aligned}\n$$\n\n- Equality II is true. Indeed, \n\n$$\n\\begin{aligned}\\overset{\\to }{BA}+\\overset{\\to }{AE}-\\overset{\\to }{FE} & =\\overset{\\to }{BA}+(\\overset{\\to }{AE}+\\overset{\\to }{EF}) \\\\  & =\\overset{\\to }{BA}+\\overset{\\to }{AF} \\\\  & =\\overset{\\to }{BF}.\\end{aligned}\n$$\n\n- Equality III is false. Indeed,\n\n$$\n\\begin{aligned}\\overset{\\to }{CD}-\\overset{\\to }{ED}-\\overset{\\to }{FE} & =(\\overset{\\to }{CD}+\\overset{\\to }{DE})+\\overset{\\to }{EF} \\\\  & =\\overset{\\to }{CE}+\\overset{\\to }{EF} \\\\  & =\\overset{\\to }{CF} \\\\  & \\ne \\overset{\\to }{FC}.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and II only\"." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-77389/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c015dcaa-2155-5d80-985b-21924de92b28"] :knowledge-point/questions ["q-77389"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-69538"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040990/assets/f25561a25abf75f301cbd29c6d6c0e2a0b61a389b757c06cd883819642f30545.png)\n\nIn figure $ABCEF$ shown above, which of the following are equal to the vector $\\overset{\\to }{BF}?$\n\n- $\\overset{\\to }{BC}+\\overset{\\to }{CE}+\\overset{\\to }{EF}$\n- $\\overset{\\to }{FA}-\\overset{\\to }{BA}$\n- $\\overset{\\to }{BC}+\\overset{\\to }{CF}$" :question/worked-solution "- For the $1$st expression, we have:\n\n$$\n\\begin{aligned}\\overset{\\to }{BC}+\\overset{\\to }{CE}+\\overset{\\to }{EF} & =(\\overset{\\to }{BC}+\\overset{\\to }{CE})+\\overset{\\to }{EF} \\\\  & =\\overset{\\to }{BE}+\\overset{\\to }{EF} \\\\  & =\\overset{\\to }{BF}\\,✓\\end{aligned}\n$$\n\n- For the $2$nd expression, we have:\n\n$$\n\\begin{aligned}\\overset{\\to }{FA}-\\overset{\\to }{BA} & =\\overset{\\to }{FA}+\\overset{\\to }{AB} \\\\  & =\\overset{\\to }{FB} \\\\  & \\ne \\overset{\\to }{BF}\\,\\times \\end{aligned}\n$$\n\n- For the $3$rd expression, we have:\n\n$$\n\\begin{aligned}\\overset{\\to }{BC}+\\overset{\\to }{CF} & =\\overset{\\to }{BF}\\,✓\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and III only\"." :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-143001/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "b4c676e5-264a-5371-b404-76ce0d09db27" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-143001/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "204feacf-4351-5efa-9843-c88c75572919" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-143001/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "ab87e7b6-42c0-50cc-a2ff-35fac8a9b477" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-143001/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "0d8d2b0d-f7ce-55d9-bad3-8d39140d968f" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-143001/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "3b932b3c-c1c4-5f2e-b221-42811afb8ac9" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-143001/selection" :answer-field/id #uuid "8952f018-a146-5362-bace-0ef081b69d07" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-143001/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer-field/choices ["q-143001/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-143001/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-143001/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-143001/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-143001/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6"] :db/ensure [:answer-field/validate]} {:db/id "q-143001" :question/id #uuid "7320ef7f-a03e-518d-a18e-7611299ef563" :question/math-academy-id "q-143001" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040990/assets/67706db50684aef52269d20065caa21e4301834835e10e1fd3e456646ae2b32e.png)\n\nIn figure $ABCDEF$ shown above, which of the following are equal to the vector $\\overset{\\to }{DF}?$\n\n- $\\overset{\\to }{DC}+\\overset{\\to }{CB}+\\overset{\\to }{BF}$\n- $\\overset{\\to }{FB}-\\overset{\\to }{DB}$\n- $\\overset{\\to }{DE}+\\overset{\\to }{EF}$" :question/worked-solution "- For the $1$st expression, we have:\n\n$$\n\\begin{aligned}\\overset{\\to }{DC}+\\overset{\\to }{CB}+\\overset{\\to }{BF} & =(\\overset{\\to }{DC}+\\overset{\\to }{CB})+\\overset{\\to }{BF} \\\\  & =\\overset{\\to }{DB}+\\overset{\\to }{BF} \\\\  & =\\overset{\\to }{DF}\\,✓\\end{aligned}\n$$\n\n- For the $2$nd expression, we have:\n\n$$\n\\begin{aligned}\\overset{\\to }{FB}-\\overset{\\to }{DB} & =\\overset{\\to }{FB}+\\overset{\\to }{BD} \\\\  & =\\overset{\\to }{FD} \\\\  & \\ne \\overset{\\to }{DF}\\,\\times \\end{aligned}\n$$\n\n- For the $3$rd expression, we have:\n\n$$\n\\begin{aligned}\\overset{\\to }{DE}+\\overset{\\to }{EF} & =\\overset{\\to }{DF}\\,✓\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and III only\"." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-143001/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c015dcaa-2155-5d80-985b-21924de92b28"] :knowledge-point/questions ["q-143001"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-9934"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040990/assets/7431bd3281e4e49f4caaa5b701885fb64c58196b2256af9d8744decd9a0d0793.png)\n\n  \n\nConsider the diagram above, where $\\overrightarrow{PS}=\\mathbf{a},$ $\\overrightarrow{QS}=\\mathbf{b},$ $\\overrightarrow{PT}=\\mathbf{c},$ and $\\overrightarrow{TS}=\\mathbf{d}.$ Find $\\overrightarrow{TQ}$ in terms of $\\mathbf{a},\\mathbf{b}, \\mathbf{c},$ and $\\mathbf{d}.$" :question/worked-solution "We want to find a \"path\" from $T$ to $Q$ consisting only of the vectors $\\mathbf a, \\mathbf b, \\mathbf c,$ and $\\mathbf d.$\n\nAccording to the triangle law of addition, \n\n$$\n{\\color{red}{\\overrightarrow{TQ}}} = {\\color{blue}{\\overrightarrow{TS}}} + {\\color{blue}{\\overrightarrow{SQ}}},\n$$\n\nas shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040990/assets/4902397acd28e2e5f85063ba55c576d3768360225a705f31a66bd460405dd5a6.png)\n\n \n\nNow, from the original diagram, we have that\n\n$$\n{\\color{blue}\\overrightarrow{TS}} = \\mathbf{d}, \\qquad {\\color{blue}{\\overrightarrow{SQ}}} = -\\mathbf{b}.\n$$\n\nLet's add these to our diagram.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040990/assets/08086f7e09568f908aa4919a1156d52e465216221be8908e72a1fd90ec8843dd.png)\n\n  \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\overset{\\to }{TQ} & =\\overset{\\to }{TS}+\\overset{\\to }{SQ} \\\\  & =d+(-b) \\\\  & =d-b.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4277"] :question/problem "Consider the diagram shown below, where $\\overrightarrow{PQ}=\\mathbf{a},$ $\\overrightarrow{PT}=\\mathbf{b},$ and $\\overrightarrow{QS}=\\mathbf{c}.$ Find $\\overrightarrow{TS}$ in terms of $\\mathbf{a},\\mathbf{b},$ and $\\mathbf{c}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040990/assets/04ce04bf7c7f88d6578c74db0d7398a6d299d11bd9f60f4fc4b6e1bfb0129f3b.png)" :question/worked-solution "We want to find a \"path\" from $T$ to $S$ consisting only of the vectors $\\mathbf a, \\mathbf b,$ or $\\mathbf c.$\n\nAccording to the triangle law of addition,\n\n$$\n{\\color{red}{\\overrightarrow{TS}}} = {\\color{blue}{\\overrightarrow{TP}}} + {\\color{blue}{\\overrightarrow{PQ}}} + {\\color{blue}{\\overrightarrow{QS}}}\n$$\n\nas shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040990/assets/53940607b5cbf0220008e6e31ec60f2fd7fd2e4f70c5a8e95e7fcfd64064b095.png)\n\nNow, from the original diagram, we have that\n\n$$\n{\\color{blue}\\overrightarrow{TP}} = -\\mathbf{b}, \\qquad {\\color{blue}\\overrightarrow{PQ}} = \\mathbf{a}, \\qquad {\\color{blue}\\overrightarrow{QS}} = \\mathbf{c}.\n$$\n\nLet's add these to our diagram.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040990/assets/810cce10eb330b1767a101d9107a9534c437daa123f13056a486a9fc96dbab89.png)\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\overset{\\to }{TS} & =\\overset{\\to }{TP}+\\overset{\\to }{PQ}+\\overset{\\to }{QS} \\\\  & =-b+a+c \\\\  & =a-b+c.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5015"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040990/assets/2420154d44b786c6aad54212760e9a37ce67dbdce94a7043039f0e824c5ef9bc.png)\n\nIn parallelogram $ABCD$ shown above, which of the following equalities are true?\n\n- $\\overrightarrow{CB}+\\overrightarrow{BA}=\\overrightarrow{CA}$\n\n- $\\overrightarrow{CB}-\\overrightarrow{AB}=\\overrightarrow{AC}$\n\n- $\\overrightarrow{DC}=\\overrightarrow{BA}$" :question/worked-solution "- Equality I is true. Indeed, $\\overrightarrow{CB}+\\overrightarrow{BA}=\\overrightarrow{CA}.$\n\n- Equality II is false. Indeed, \n\n$$\n\\begin{aligned}\\overset{\\to }{CB}-\\overset{\\to }{AB} & =\\overset{\\to }{CB}+\\overset{\\to }{BA} \\\\  & =\\overset{\\to }{CA} \\\\  & \\ne \\overset{\\to }{AC}\\end{aligned}\n$$\n\nsince $\\overrightarrow{CA}$ and $\\overrightarrow{AC}$ have opposite directions.\n\n- Equality III is false. Indeed, $\\overrightarrow{DC}\\neq\\overrightarrow{BA}$ since they have opposite directions.\n\nTherefore, the correct answer is \"I only.\"" :db/ensure [:question/validate]}]
