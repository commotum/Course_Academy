#{[{:db/id #edb/ref 17592186310780 :knowledge-point/_questions [{:knowledge-point/id #uuid "17099881-d7b9-54d9-a29a-4f5f28561cd3" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola with Vertex at the Origin Given Another Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "222fe8d9-adb9-5edd-9390-b3f17d688162" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=4x" :db/id #edb/ref 17592186310782} {:answer/id #uuid "4fb7c43c-4396-5b6d-93e9-c2fec148eaa8" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}=2y" :db/id #edb/ref 17592186310783} {:answer/id #uuid "d27b95c3-9e3e-5631-9fc6-c218385ff2ea" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=-\\frac{1}{2}x" :db/id #edb/ref 17592186310784} {:answer/id #uuid "77218e5c-a3c9-5d7e-bd57-a4edc28c8df4" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=-2x" :db/id #edb/ref 17592186310785} {:answer/id #uuid "8f6380dc-ec5b-526c-b610-b79baf1aca19" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}=-\\frac{1}{2}y" :db/id #edb/ref 17592186310786}] :answer-field/correct {:answer/id #uuid "77218e5c-a3c9-5d7e-bd57-a4edc28c8df4" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=-2x" :db/id #edb/ref 17592186310785} :answer-field/id #uuid "3f30297e-01ec-5ead-8058-5f9754035dfa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186310781}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b24732f9-7b75-59b2-a18e-ce5ccd87f7dd" :question/math-academy-id "q-115633" :question/problem "Find the equation of the left-opening parabola that has its vertex at $(0,0)$ and passes through the point $(-2,-2).$" :question/worked-solution "The general standard equation of a parabola whose vertex is $(0,0)$ and whose arms open right or left is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSince we know the given parabola passes through the point $(-2,-2),$ we can substitute $x=-2$ and $y=-2$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ (-2)^{2} & =4p(-2) \\\\ 4 & =-8p \\\\ p & =-\\frac{1}{2}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {y}^{2} & =4(-\\frac{1}{2})x \\\\ {y}^{2} & =-2x.\\end{aligned}\n$$"}]}
