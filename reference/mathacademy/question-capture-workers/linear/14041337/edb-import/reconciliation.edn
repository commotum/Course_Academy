} & =-\\frac{16}{3}(x-4).\\end{aligned}\n$$\n\nNotice that the arms of the parabola open to the left since $p=-\\frac{4}{3}$ is negative." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/state.json" "file_sha256" "610aa6b2bb4ffb9544fff25cbc0cb9921548e03c007431fe4f7a0356ca138ec9"} {"question" "q-11807" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/activity-metadata.json" "file_sha256" "2b88b47ffba4f1cca609405a7a46f39d9237523db60eb50068f0e025412a3aa0"} {"question" "q-11807" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/state.json" "file_sha256" "610aa6b2bb4ffb9544fff25cbc0cb9921548e03c007431fe4f7a0356ca138ec9"} {"question" "q-11807" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(y-2)^{2}=-\\frac{16}{3}(x-4)"] ["math" "(y-2)^{2}=-\\frac{8}{3}(x-4)"] ["math" "(y-2)^{2}=\\frac{16}{3}(x-4)"] ["math" "(y-2)^{2}=\\frac{8}{3}(x-4)"] ["math" "(y-4)^{2}=-\\frac{16}{3}(x-2)"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/state.json" "file_sha256" "610aa6b2bb4ffb9544fff25cbc0cb9921548e03c007431fe4f7a0356ca138ec9"} {"question" "q-11807" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(y-2)^{2}=-\\frac{16}{3}(x-4)"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/state.json" "file_sha256" "610aa6b2bb4ffb9544fff25cbc0cb9921548e03c007431fe4f7a0356ca138ec9"} {"question" "q-11803" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/assets/814515b0294849e2689214faa1ac97a4f0bb5134f3209a9fb0b2fdbda5c2a484.png)\n\nWhat is the equation of the parabola shown above?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/state.json" "file_sha256" "610aa6b2bb4ffb9544fff25cbc0cb9921548e03c007431fe4f7a0356ca138ec9"} {"question" "q-11803" "field" nil "attribute" "question/worked-solution" "value" "From the diagram we see that the arms of the parabola open to the left. The parabola has its vertex at $(2,2)$ and passes through the point $(-4,8).$\n\nThe general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(2,2),$ we substitute $h=2$ and $k=2$ into the equation above and get\n\n$$\n\\begin{aligned}(y-2)^{2} & =4p(x-2).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(-4,8),$ so we can substitute $x=-4$ and $y=8$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}(y-2)^{2} & =4p(x-2) \\\\ (8-2)^{2} & =4p(-4-2) \\\\ 36 & =-24p \\\\ p & =-\\frac{3}{2}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}(y-2)^{2} & =4p(x-2) \\\\ (y-2)^{2} & =4(-\\frac{3}{2})(x-2) \\\\ (y-2)^{2} & =-6(x-2).\\end{aligned}\n$$\n\nNotice that the arms of the parabola open to the left since $p=-\\frac{3}{2}$ is negative." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/state.json" "file_sha256" "610aa6b2bb4ffb9544fff25cbc0cb9921548e03c007431fe4f7a0356ca138ec9"} {"question" "q-11803" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/De