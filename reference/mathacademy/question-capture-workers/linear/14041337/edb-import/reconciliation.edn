\n$$\n\\begin{aligned}(y-4)^{2} & =4p(x-1) \\\\ (y-4)^{2} & =4(-2)(x-1) \\\\ (y-4)^{2} & =-8(x-1).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13954664/state.json" "file_sha256" "cbb323e2e80fffcb5b3d5b27ed767c90db63e4d5a7e12621e7c9826cf4a83901" "basis" 619 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13954664/edb-import/verification.json"} {"question" "q-11794" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13954664/activity-metadata.json" "file_sha256" "4db46a9d62f9a21d8f80a9f94b90e4fb4fe87c5b80b813f4fc9c8610a9418521" "basis" 619 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13954664/edb-import/verification.json"} {"question" "q-11794" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13954664/state.json" "file_sha256" "cbb323e2e80fffcb5b3d5b27ed767c90db63e4d5a7e12621e7c9826cf4a83901" "basis" 619 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13954664/edb-import/verification.json"} {"question" "q-11794" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "(y-1)^{2}=-8(x-4)"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13954664/state.json" "file_sha256" "cbb323e2e80fffcb5b3d5b27ed767c90db63e4d5a7e12621e7c9826cf4a83901" "basis" 619 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13954664/edb-import/verification.json"} {"question" "q-11794" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "(y-4)^{2}=-4(x-1)"] "category" "ma_c