} & =4(1)(x+1) \\\\ (y-1)^{2} & =4(x+1).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/state.json" "file_sha256" "610aa6b2bb4ffb9544fff25cbc0cb9921548e03c007431fe4f7a0356ca138ec9"} {"question" "q-11796" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/activity-metadata.json" "file_sha256" "2b88b47ffba4f1cca609405a7a46f39d9237523db60eb50068f0e025412a3aa0"} {"question" "q-11796" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/state.json" "file_sha256" "610aa6b2bb4ffb9544fff25cbc0cb9921548e03c007431fe4f7a0356ca138ec9"} {"question" "q-11796" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(y+1)^{2}=4(x-1)"] ["math" "(y-1)^{2}=-2(x+1)"] ["math" "(y-1)^{2}=-4(x+1)"] ["math" "(y-1)^{2}=2(x+1)"] ["math" "(y-1)^{2}=4(x+1)"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/state.json" "file_sha256" "610aa6b2bb4ffb9544fff25cbc0cb9921548e03c007431fe4f7a0356ca138ec9"} {"question" "q-11796" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(y-1)^{2}=4(x+1)"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/state.json" "file_sha256" "610aa6b2bb4ffb9544fff25cbc0cb9921548e03c007431fe4f7a0356ca138ec9"} {"question" "q-11794" "field" nil "attribute" "question/problem" "value" "Find the equation of the left-opening parabola that has its vertex at $(1,4)$ and passes through the point $(-1,8).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/state.json" "file_sha256" "610aa6b2bb4ffb9544fff25cbc0cb9921548e03c007431fe4f7a0356ca138ec9"} {"question" "q-11794" "field" nil "attribute" "question/worked-solution" "value" "The general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(1,4),$ we substitute $h=1$ and $k=4$ into the equation above and get\n\n$$\n\\begin{aligned}(y-4)^{2} & =4p(x-1).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(-1,8),$ so we can substitute $x=-1$ and $y=8$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}(y-4)^{2} & =4p(x-1) \\\\ (8-4)^{2} & =4p(-1-1) \\\\ 16 & =-8p \\\\ p & =-2\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}(y-4)^{2} & =4p(x-1) \\\\ (y-4)^{2} & =4(-2)(x-1) \\\\ (y-4)^{2} & =-8(x-1).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/state.json" "file_sha256" "610aa6b2bb4ffb9544fff25cbc0cb9921548e03c007431fe4f7a0356ca138ec9"} {"question" "q-11794" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/activity-metadata.json" "file_sha256" "2b88b47ffba4f1cca609405a7a46f39d9237523db60eb50068f0e025412a3aa0"} {"question" "q-11794" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/state.json" "file_sha256" "610aa6b2bb4ffb9544fff25cbc0cb9921548e03c007431fe4f7a0356ca138ec9"} {"question" "q-11794" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(y-1)^{2}=-8(x-4)"] ["math" "(y-4)^{2}=-4(x-1)"] ["math" "(y-4)^{2}=-8(x-1)"] ["math" "(y-4)^{2}=4(x-1)"] ["math" "(y-4)^{2}=8(x-1)"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/state.json" "file_sha256" "610aa6b2bb4ffb9544fff25cbc0cb9921548e03c007431fe4f7a0356ca138ec9"} {"question" "q-11794" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(y-4)^{2}=-8(x-1)"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/state.json" "file_sha256" "610aa6b2bb4ffb9544fff25cbc0cb9921548e03c007431fe4f7a0356ca138ec9"} {"question" "q-11802" "field" nil "attribute" "question/problem" "value" "Find the equation of the left-opening parabola that has its vertex at $(5,1)$ and passes through the point $(-1,5).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/state.json" "file_sha256" "610aa6b2bb4ffb9544fff25cbc0cb9921548e03c007431fe4f7a0356ca138ec9"} {"question" "q-11802" "field" nil "attribute" "question/worked-solution" "value" "The general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(5,1),$ we substitute $h=5$ and $k=1$ into the equation above and get\n\n$$\n\\begin{aligned}(y-1)^{2} & =4p(x-5).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(-1,5),$ so we can substitute $x=-1$ and $y=5$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}(y-1)^{2} & =4p(x-5) \\\\ (5-1)^{2} & =4p(-1-5) \\\\ 16 & =-24p \\\\ p & =-\\frac{2}{3}\\end{aligned}\n$$\n\nSo, the equation of the parabola is\n\n$$\n\\begin{aligned}(y-1)^{2} & =4p(x-5) \\\\ (y-1)^{2} & =4(-\\frac{2}{3})(x-5) \\\\ (y-1)^{2} & =-\\frac{8}{3}(x-5).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/state.json" "file_sha256" "610aa6b2bb4ffb9544fff25cbc0cb9921548e03c007431fe4f7a0356ca138ec9"} {"question" "q-11802" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/activity-metadata.json" "file_sha256" "2b88b47ffba4f1cca609405a7a46f39d9237523db60eb50068f0e025412a3aa0"} {"question" "q-11802" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/state.json" "file_sha256" "610aa6b2bb4ffb9544fff25cbc0cb9921548e03c007431fe4f7a0356ca138ec9"} {"question" "q-11802" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(y-1)^{2}=-\\frac{4}{3}(x-5)"] ["math" "(y-1)^{2}=-\\frac{8}{3}(x-5)"] ["math" "(y-1)^{2}=\\frac{4}{3}(x-5)"] ["math" "(y-1)^{2}=\\frac{8}{3}(x-5)"] ["math" "(y-5)^{2}=-\\frac{8}{3}(x-1)"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/state.json" "file_sha256" "610aa6b2bb4ffb9544fff25cbc0cb9921548e03c007431fe4f7a0356ca138ec9"} {"question" "q-11802" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(y-1)^{2}=-\\frac{8}{3}(x-5)"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/state.json" "file_sha256" "610aa6b2bb4ffb9544fff25cbc0cb9921548e03c007431fe4f7a0356ca138ec9"} {"question" "q-115648" "field" nil "attribute" "question/problem" "value" "Find the equation of the right-opening parabola that has its vertex at $(0,2)$ and passes through the point $(5,5).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/state.json" "file_sha256" "610aa6b2bb4ffb9544fff25cbc0cb9921548e03c007431fe4f7a0356ca138ec9"} {"question" "q-115648" "field" nil "attribute" "question/worked-solution" "value" "The general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(0,2),$ we substitute $h=0$ and $k=2$ into the equation above and get\n\n$$\n\\begin{aligned}(y-2)^{2} & =4px.\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(5,5),$ so we can substitute $x=5$ and $y=5$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}(y-2)^{2} & =4px \\\\ (5-2)^{2} & =4p(5) \\\\ 9 & =20p \\\\ p & =\\frac{9}{20}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}(y-2)^{2} & =4px \\\\ (y-2)^{2} & =4(\\frac{9}{20})x \\\\ (y-2)^{2} & =\\frac{9}{5}x.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/state.json" "file_sha256" "610aa6b2bb4ffb9544fff25cbc0cb9921548e03c007431fe4f7a0356ca138ec9"} {"question" "q-115648" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/activity-metadata.json" "file_sha256" "2b88b47ffba4f1cca609405a7a46f39d9237523db60eb50068f0e025412a3aa0"} {"question" "q-115648" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/re