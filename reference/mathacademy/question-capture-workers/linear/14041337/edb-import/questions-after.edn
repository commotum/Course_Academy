4-7c2c-551a-910d-0e6e936bbaf6" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=2x" :db/id #edb/ref 17592186311509} {:answer/id #uuid "125c3fff-2785-596b-a01a-897e89c7ba49" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=6x" :db/id #edb/ref 17592186311510} {:answer/id #uuid "9e116112-fc0a-5b35-a911-c4776f11c6a5" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=-4x" :db/id #edb/ref 17592186311511} {:answer/id #uuid "adf500d5-2e8f-5c16-802d-888b11c81073" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=-2x" :db/id #edb/ref 17592186311512}] :answer-field/correct {:answer/id #uuid "65466d94-7c2c-551a-910d-0e6e936bbaf6" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=2x" :db/id #edb/ref 17592186311509} :answer-field/id #uuid "f7025a21-86cb-5a6d-b7e9-4de911044a5a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311507}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ddce684b-4aee-55f2-8f41-df9cf7650767" :question/math-academy-id "q-11753" :question/problem "Find the equation of the right-opening parabola that has its vertex at  $(0,0)$ and passes through the point $(8,4).$" :question/worked-solution "The general standard equation of a parabola whose vertex is $(0,0)$ and whose arms open right or left is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSince we know the given parabola passes through the point $(8,4),$ we can substitute $x=8$ and $y=4$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {4}^{2} & =4p(8) \\\\ 16 & =32p \\\\ p & =\\frac{1}{2}.\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {y}^{2} & =4(\\frac{1}{2})x \\\\ {y}^{2} & =2x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186096915 :knowledge-point/_questions [{:knowledge-point/id #uuid "17099881-d7b9-54d9-a29a-4f5f28561cd3" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola with Vertex at the Origin Given Another Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22d72dcc-4fab-5236-8d30-fa532d523fb6" :answer/type {:db/ident :answer.type/math} :answer/value "y^{2} =-\\frac{8}{3}x" :db/id #edb/ref 17592186093897} {:answer/id #uuid "5546df30-1703-56e3-b18d-973ee858fb65" :answer/type {:db/ident :answer.type/math} :answer/value "y^{2} =-2x" :db/id #edb/ref 17592186093898} {:answer/id #uuid "55961f9c-5ee3-5c97-b110-9107e7fb7ac5" :answer/type {:db/ident :answer.type/math} :answer/value "y^{2} =-\\frac{2}{3}x" :db/id #edb/ref 17592186093899} {:answer/id #uuid "57464172-97d3-545a-8373-7ff2339d6817" :answer/type {:db/ident :answer.type/math} :answer/value "y^{2} =-4x" :db/id #edb/ref 17592186093900} {:answer/id #uuid "6bae0126-d4de-520b-bdb6-f3ce4438be07" :answer/type {:db/ident :answer.type/math} :answer/value "y^{2} =-\\frac{4}{3}x" :db/id #edb/ref 17592186093901}] :answer-field/correct {:answer/id #uuid "6bae0126-d4de-520b-bdb6-f3ce4438be07" :answer/type {:db/ident :answer.type/math} :answer/value "y^{2} =-\\frac{4}{3}x" :db/id #edb/ref 17592186093901} :answer-field/id #uuid "3fd5fdd6-b767-5101-9cff-56edc2bd1ed7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186093896}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d4b9e77d-fb5d-5da7-b8bf-29a4b56e201c" :question/math-academy-id "q-11755" :question/problem "Find the equation of the left-opening parabola that has its vertex at $(0,0)$ and passes through the point $(-12,-4).$" :question/worked-solution "The general standard equation of a parabola whose vertex is $(0,0)$ and whose arms open right or left is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSince we know the given parabola passes through the point $(-12,-4),$ we can substitute $x=-12$ and $y=-4$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ (-4)^{2} & =4p(-12) \\\\ 16 & =-48p \\\\ p & =-\\frac{1}{3}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {y}^{2} & =4(-\\frac{1}{3})x \\\\ {y}^{2} & =-\\frac{4}{3}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311513 :knowledge-point/_questions [{:knowledge-point/id #uuid "75fd35db-6b4e-5820-b6ac-925d24a0f117" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola with Vertex at the Origin Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5caf1559-eb72-5ea3-b290-ae00f47abf07" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=4x" :db/id #edb/ref 17592186311515} {:answer/id #uuid "34789850-bb68-590a-b76d-e3be9095b691" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=-3x" :db/id #edb/ref 17592186311516} {:answer/id #uuid "c7154e5b-7947-57ca-9b13-d5808022fb91" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=5x" :db/id #edb/ref 17592186311517} {:answer/id #uuid "92ade8a5-6a78-55a7-a78b-53a888a10bed" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=-4x" :db/id #edb/ref 17592186311518} {:answer/id #uuid "836474c3-7627-55a8-b6b0-4935a119fbfc" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=3x" :db/id #edb/ref 17592186311519}] :answer-field/correct {:answer/id #uuid "836474c3-7627-55a8-b6b0-4935a119fbfc" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=3x" :db/id #edb/ref 17592186311519} :answer-field/id #uuid "8c31a56b-ee2b-53a2-a29d-45fb5b079895" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311514}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "065fc101-a0e2-56a3-9672-33a997991742" :question/math-academy-id "q-11764" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/assets/83439b98fff25c021a2713448779167f25a0b9f04dd0d14b115a55f915e3501d.png)\n\nWhat is the equation of the parabola shown above?" :question/worked-solution "From the diagram we see that the arms of the parabola open to the right. The parabola has its vertex at $(0,0)$ and passes through the point $(12,6).$\n\nThe general standard equation of a parabola whose vertex is $(0,0)$ and whose arms open right or left is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSince we know the given parabola passes through the point $(12,6),$ we can substitute $x=12$ and $y=6$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {6}^{2} & =4p(12) \\\\ 36 & =48p \\\\ p & =\\frac{3}{4}.\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {y}^{2} & =4(\\frac{3}{4})x \\\\ {y}^{2} & =3x.\\end{aligned}\n$$\n\nNotice that the arms of the parabola open to the right since $p=\\frac{3}{4}$ is positive."}] [{:db/id #edb/ref 17592186266750 :knowledge-point/_questions [{:knowledge-point/id #uuid "783ca59b-0242-584c-ae47-004a0eb03817" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola Given the Vertex and Another Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "295f8b08-db31-5d74-8c49-7680c33eb4e3" :answer/type {:db/ident :answer.type/math} :answer/value "(y-4)^{2}=8(x-1)" :db/id #edb/ref 17592186266752} {:answer/id #uuid "316676c5-b207-5ca0-8eb7-7e127d6a4655" :answer/type {:db/ident :answer.type/math} :answer/value "(y-4)^{2}=-8(x-1)" :db/id #edb/ref 17592186266753} {:answer/id #uuid "7839009f-cb3b-561b-87c2-05a125ad1ada" :answer/type {:db/ident :answer.type/math} :answer/value "(y-4)^{2}=-4(x-1)" :db/id #edb/ref 17592186266754} {:answer/id #uuid "1da2cb8f-f928-529d-a370-2dbf505caaa9" :answer/type {:db/ident :answer.type/math} :answer/value "(y-4)^{2}=4(x-1)" :db/id #edb/ref 17592186266755} {:answer/id #uuid "fc491c15-266a-58c7-a2f3-b2b562f21758" :answer/type {:db/ident :answer.type/math} :answer/value "(y-1)^{2}=-8(x-4)" :db/id #edb/ref 17592186266756}] :answer-field/correct {:answer/id #uuid "316676c5-b207-5ca0-8eb7-7e127d6a4655" :answer/type {:db/ident :answer.type/math} :answer/value "(y-4)^{2}=-8(x-1)" :db/id #edb/ref 17592186266753} :answer-field/id #uuid "9eb26fbb-2bef-540d-bb2c-0db2167556de" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186266751}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d3122981-1a91-5414-84c6-5eaaa9c218b7" :question/math-academy-id "q-11794" :question/problem "Find the equation of the left-opening parabola that has its vertex at $(1,4)$ and passes through the point $(-1,8).$" :question/worked-solution "The general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(1,4),$ we substitute $h=1$ and $k=4$ into the equation above and get\n\n$$\n\\begin{aligned}(y-4)^{2} & =4p(x-1).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(-1,8),$ so we can substitute $x=-1$ and $y=8$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}(y-4)^{2} & =4p(x-1) \\\\ (8-4)^{2} & =4p(-1-1) \\\\ 16 & =-8p \\\\ p & =-2\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}(y-4)^{2} & =4p(x-1) \\\\ (y-4)^{2} & =4(-2)(x-1) \\\\ (y-4)^{2} & =-8(x-1).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186096925 :knowledge-point/_questions [{:knowledge-point/id #uuid "783ca59b-0242-584c-ae47-004a0eb03817" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola Given the Vertex and Another Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c633dcd6-101e-5d10-9123-956b496cda9b" :answer/type {:db/ident :answer.type/math} :answer/value "(y - 1)^{2} = 4(x + 1)" :db/id #edb/ref 17592186093957} {:answer/id #uuid "007df690-de68-5bf1-984b-058b1014804a" :answer/type {:db/ident :answer.type/math} :answer/value "(y - 1)^{2} = 2(x + 1)" :db/id #edb/ref 17592186093958} {:answer/id #uuid "0c2879e2-1ffa-5c82-b14d-f40e9624445d" :answer/type {:db/ident :answer.type/math} :answer/value "(y - 1)^{2} =-2(x + 1)" :db/id #edb/ref 17592186093959} {:answer/id #uuid "4bedbbab-8e3a-50d0-a9f1-fe3b43f190f5" :answer/type {:db/ident :answer.type/math} :answer/value "(y + 1)^{2} = 4(x - 1)" :db/id #edb/ref 17592186093960} {:answer/id #uuid "7af05939-1ccb-5dcc-aa4a-4ddbdef8fcf0" :answer/type {:db/ident :answer.type/math} :answer/value "(y - 1)^{2} =-4(x + 1)" :db/id #edb/ref 17592186093961}] :answer-field/correct {:answer/id #uuid "c633dcd6-101e-5d10-9123-956b496cda9b" :answer/type {:db/ident :answer.type/math} :answer/value "(y - 1)^{2} = 4(x + 1)" :db/id #edb/ref 17592186093957} :answer-field/id #uuid "8748bb20-cfdd-541c-ac12-e1684e80cfaa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186093956}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6320edd2-e1c5-5b53-9a6b-92829daed3b4" :question/math-academy-id "q-11796" :question/problem "Find the equation of the right-opening parabola that has its vertex at $(-1,1)$ and passes through the point $(8,7).$" :question/worked-solution "The general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(-1,1),$ we substitute $h=-1$ and $k=1$ into the equation above and get\n\n$$\n\\begin{aligned}(y-1)^{2} & =4p(x+1).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(8,7),$ so we can substitute $x=8$ and $y=7$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}(y-1)^{2} & =4p(x+1) \\\\ (7-1)^{2} & =4p(8+1) \\\\ 36 & =36p \\\\ p & =1\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}(y-1)^{2} & =4p(x+1) \\\\ (y-1)^{2} & =4(1)(x+1) \\\\ (y-1)^{2} & =4(x+1).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311520 :knowledge-point/_questions [{:knowledge-point/id #uuid "dc86c375-c2c4-56b7-a207-0abfc9709f6a" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "867f9508-85f8-53c3-8602-3ff66b9654ca" :answer/type {:db/ident :answer.type/math} :answer/value "(y+4)^{2}=2(x-4)" :db/id #edb/ref 17592186311522} {:answer/id #uuid "916f06c8-6b21-5e89-96cf-d49aafb604ee" :answer/type {:db/ident :answer.type/math} :answer/value "(y+4)^{2}=(x-4)" :db/id #edb/ref 17592186311523} {:answer/id #uuid "0fbaf54c-3768-5f72-9b2f-3bd068d3f867" :answer/type {:db/ident :answer.type/math} :answer/value "(y+4)^{2}=-2(x-4)" :db/id #edb/ref 17592186311524} {:answer/id #uuid "b6e3edf6-247c-5ad0-944d-2113669874b9" :answer/type {:db/ident :answer.type/math} :answer/value "(y+4)^{2}=-(x-4)" :db/id #edb/ref 17592186311525} {:answer/id #uuid "bb7ea5e5-0396-55e0-847f-322d6d7b31fe" :answer/type {:db/ident :answer.type/math} :answer/value "(y-4)^{2}=-(x+4)" :db/id #edb/ref 17592186311526}] :answer-field/correct {:answer/id #uuid "b6e3edf6-247c-5ad0-944d-2113669874b9" :answer/type {:db/ident :answer.type/math} :answer/value "(y+4)^{2}=-(x-4)" :db/id #edb/ref 17592186311525} :answer-field/id #uuid "70af8dfc-cbcc-5664-a7ec-456b2f89d652" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311521}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ae27821d-0ab5-56dd-86d2-1c08394a25d4" :question/math-academy-id "q-11799" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/assets/872c4385f2f7075ac4f9690f5adabaa8cb6b4ad3ffe738b47f2b22e477aab621.png)\n\nWhat is the equation of the parabola shown above?" :question/worked-solution "From the diagram we see that the arms of the parabola open to the left. The parabola has its vertex at $(4,-4)$ and passes through the point $(0,-6).$\n\nThe general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(4,-4),$ we substitute $h=4$ and $k=-4$ into the equation above and get\n\n$$\n\\begin{aligned}(y+4)^{2} & =4p(x-4).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(0,-6),$ so we can substitute $x=0$ and $y=-6$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}(y+4)^{2} & =4p(x-4) \\\\ (-6+4)^{2} & =4p(0-4) \\\\ 4 & =-16p \\\\ p & =-\\frac{1}{4}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}(y+4)^{2} & =4p(x-4) \\\\ (y+4)^{2} & =4(-\\frac{1}{4})(x-4) \\\\ (y+4)^{2} & =-(x-4).\\end{aligned}\n$$\n\nNotice that the arms of the parabola open to the left since $p=-\\frac{1}{4}$ is negative."}] [{:db/id #edb/ref 17592186311527 :knowledge-point/_questions [{:knowledge-point/id #uuid "783ca59b-0242-584c-ae47-004a0eb03817" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola Given the Vertex and Another Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68772979-cfd4-56e8-aa50-0a73282be9f1" :answer/type {:db/ident :answer.type/math} :answer/value "(y-1)^{2}=\\frac{4}{3}(x-5)" :db/id #edb/ref 17592186311529} {:answer/id #uuid "4a40c676-cc13-587b-a046-2be557ce51d1" :answer/type {:db/ident :answer.type/math} :answer/value "(y-1)^{2}=-\\frac{8}{3}(x-5)" :db/id #edb/ref 17592186311530} {:answer/id #uuid "1b86afe4-c17d-5595-b4ba-b3a1a292227d" :answer/type {:db/ident :answer.type/math} :answer/value "(y-5)^{2}=-\\frac{8}{3}(x-1)" :db/id #edb/ref 17592186311531} {:answer/id #uuid "c9093ec0-2056-5f09-86a8-b82e6aea7486" :answer/type {:db/ident :answer.type/math} :answer/value "(y-1)^{2}=\\frac{8}{3}(x-5)" :db/id #edb/ref 17592186311532} {:answer/id #uuid "1cc21b2b-9aa9-5713-8a64-935acb5ccd08" :answer/type {:db/ident :answer.type/math} :answer/value "(y-1)^{2}=-\\frac{4}{3}(x-5)" :db/id #edb/ref 17592186311533}] :answer-field/correct {:answer/id #uuid "4a40c676-cc13-587b-a046-2be557ce51d1" :answer/type {:db/ident :answer.type/math} :answer/value "(y-1)^{2}=-\\frac{8}{3}(x-5)" :db/id #edb/ref 17592186311530} :answer-field/id #uuid "03e1b577-4090-53d3-83b8-be0f8ae6c08f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311528}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "eca8fc36-230f-507e-b2dc-9fc7682f36b3" :question/math-academy-id "q-11802" :question/problem "Find the equation of the left-opening parabola that has its vertex at $(5,1)$ and passes through the point $(-1,5).$" :question/worked-solution "The general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(5,1),$ we substitute $h=5$ and $k=1$ into the equation above and get\n\n$$\n\\begin{aligned}(y-1)^{2} & =4p(x-5).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(-1,5),$ so we can substitute $x=-1$ and $y=5$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}(y-1)^{2} & =4p(x-5) \\\\ (5-1)^{2} & =4p(-1-5) \\\\ 16 & =-24p \\\\ p & =-\\frac{2}{3}\\end{aligned}\n$$\n\nSo, the equation of the parabola is\n\n$$\n\\begin{aligned}(y-1)^{2} & =4p(x-5) \\\\ (y-1)^{2} & =4(-\\frac{2}{3})(x-5) \\\\ (y-1)^{2} & =-\\frac{8}{3}(x-5).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311534 :knowledge-point/_questions [{:knowledge-point/id #uuid "dc86c375-c2c4-56b7-a207-0abfc9709f6a" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11bd0983-2bce-59a1-9270-c538c84dc453" :answer/type {:db/ident :answer.type/math} :answer/value "(y-2)^{2}=6(x-2)" :db/id #edb/ref 17592186311536} {:answer/id #uuid "a1f2796e-58be-5a9b-96f8-870b9a333ab0" :answer/type {:db/ident :answer.type/math} :answer/value "(y-2)^{2}=-6(x-2)" :db/id #edb/ref 17592186311537} {:answer/id #uuid "1f2f213e-c066-5328-ad5d-a8fb164f7b85" :answer/type {:db/ident :answer.type/math} :answer/value "(y+2)^{2}=-6(x+2)" :db/id #edb/ref 17592186311538} {:answer/id #uuid "46ee4426-8b1d-5151-98d6-689fe9d9ede1" :answer/type {:db/ident :answer.type/math} :answer/value "(y-2)^{2}=4(x-2)" :db/id #edb/ref 17592186311539} {:answer/id #uuid "30328629-2e13-58c6-b050-dc64685ae511" :answer/type {:db/ident :answer.type/math} :answer/value "(y-2)^{2}=-4(x-2)" :db/id #edb/ref 17592186311540}] :answer-field/correct {:answer/id #uuid "a1f2796e-58be-5a9b-96f8-870b9a333ab0" :answer/type {:db/ident :answer.type/math} :answer/value "(y-2)^{2}=-6(x-2)" :db/id #edb/ref 17592186311537} :answer-field/id #uuid "3ae327a2-5e21-5cce-a8ae-dd3c52c53403" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311535}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "eba2b56d-84e3-51b1-8610-87cab958ffe0" :question/math-academy-id "q-11803" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/assets/814515b0294849e2689214faa1ac97a4f0bb5134f3209a9fb0b2fdbda5c2a484.png)\n\nWhat is the equation of the parabola shown above?" :question/worked-solution "From the diagram we see that the arms of the parabola open to the left. The parabola has its vertex at $(2,2)$ and passes through the point $(-4,8).$\n\nThe general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(2,2),$ we substitute $h=2$ and $k=2$ into the equation above and get\n\n$$\n\\begin{aligned}(y-2)^{2} & =4p(x-2).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(-4,8),$ so we can substitute $x=-4$ and $y=8$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}(y-2)^{2} & =4p(x-2) \\\\ (8-2)^{2} & =4p(-4-2) \\\\ 36 & =-24p \\\\ p & =-\\frac{3}{2}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}(y-2)^{2} & =4p(x-2) \\\\ (y-2)^{2} & =4(-\\frac{3}{2})(x-2) \\\\ (y-2)^{2} & =-6(x-2).\\end{aligned}\n$$\n\nNotice that the arms of the parabola open to the left since $p=-\\frac{3}{2}$ is negative."}] [{:db/id #edb/ref 17592186275614 :knowledge-point/_questions [{:knowledge-point/id #uuid "dc86c375-c2c4-56b7-a207-0abfc9709f6a" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b922c2d3-d768-5e43-8ba7-8372b7d2df11" :answer/type {:db/ident :answer.type/math} :answer/value "(y-4)^{2}=-\\frac{16}{3}(x-2)" :db/id #edb/ref 17592186275616} {:answer/id #uuid "ec9f01bf-aa36-51b4-9cdf-ffecaf5162b4" :answer/type {:db/ident :answer.type/math} :answer/value "(y-2)^{2}=-\\frac{16}{3}(x-4)" :db/id #edb/ref 17592186275617} {:answer/id #uuid "e0e8ff05-b7ec-5e45-a2d1-669cc182b0e1" :answer/type {:db/ident :answer.type/math} :answer/value "(y-2)^{2}=\\frac{16}{3}(x-4)" :db/id #edb/ref 17592186275618} {:answer/id #uuid "29ea01b8-0aa6-5d35-a52d-9bcb70fa3273" :answer/type {:db/ident :answer.type/math} :answer/value "(y-2)^{2}=-\\frac{8}{3}(x-4)" :db/id #edb/ref 17592186275619} {:answer/id #uuid "535a72ef-50fb-52d3-ab41-bd3c2fc45b39" :answer/type {:db/ident :answer.type/math} :answer/value "(y-2)^{2}=\\frac{8}{3}(x-4)" :db/id #edb/ref 17592186275620}] :answer-field/correct {:answer/id #uuid "ec9f01bf-aa36-51b4-9cdf-ffecaf5162b4" :answer/type {:db/ident :answer.type/math} :answer/value "(y-2)^{2}=-\\frac{16}{3}(x-4)" :db/id #edb/ref 17592186275617} :answer-field/id #uuid "bca9c68d-9188-5543-b70a-8309a1436c55" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275615}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "414e12b5-a489-588c-a563-174560530b26" :question/math-academy-id "q-11807" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/assets/e4b681e9bdf5fa8021ca359e0bf93c27b53a18f0d5e906765a911a72ecfc0159.png)\n\nWhat is the equation of the parabola shown above?" :question/worked-solution "From the diagram we see that the arms of the parabola open to the left. The parabola has its vertex at $(4,2)$ and passes through the point $(-8,10).$\n\nThe general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(4,2),$ we substitute $h=4$ and $k=2$ into the equation above and get\n\n$$\n\\begin{aligned}(y-2)^{2} & =4p(x-4).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(-8,10),$ so we can substitute $x=-8$ and $y=10$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}(y-2)^{2} & =4p(x-4) \\\\ (10-2)^{2} & =4p(-8-4) \\\\ 64 & =-48p \\\\ p & =-\\frac{4}{3}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}(y-2)^{2} & =4p(x-4) \\\\ (y-2)^{2} & =4(-\\frac{4}{3})(x-4) \\\\ (y-2)^{2} & =-\\frac{16}{3}(x-4).\\end{aligned}\n$$\n\nNotice that the arms of the parabola open to the left since $p=-\\frac{4}{3}$ is negative."}] [{:db/id #edb/ref 17592186311541 :knowledge-point/_questions [{:knowledge-point/id #uuid "dc86c375-c2c4-56b7-a207-0abfc9709f6a" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09d6edf5-02f9-5dd8-8c22-42d02acde45d" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=-9(x+6)" :db/id #edb/ref 17592186311543} {:answer/id #uuid "9b73ddac-f0dd-5a07-8952-bc8df276d9f5" :answer/type {:db/ident :answer.type/math} :answer/value "(y+6)^{2}=9x" :db/id #edb/ref 17592186311544} {:answer/id #uuid "14ec2148-504f-51d9-bbe2-f2e8b8c8f1a9" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=-6(x+6)" :db/id #edb/ref 17592186311545} {:answer/id #uuid "736f2b13-f95f-54b4-a35a-3b4ade2bf066" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=6(x+6)" :db/id #edb/ref 17592186311546} {:answer/id #uuid "e0a11b81-08cb-549a-aa0d-ae3e0d3bb564" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=9(x+6)" :db/id #edb/ref 17592186311547}] :answer-field/correct {:answer/id #uuid "e0a11b81-08cb-549a-aa0d-ae3e0d3bb564" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=9(x+6)" :db/id #edb/ref 17592186311547} :answer-field/id #uuid "aca9e253-d0f4-5fd2-8168-4ff04958883f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311542}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "4f9e3ec6-bada-5b20-a030-4179303dbd69" :question/math-academy-id "q-11809" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041337/assets/8a48fcacc437d1dca41df82e24984507a92d686f80f4517c6682e8b14b694f0e.png)\n\nWhat is the equation of the parabola shown above?" :question/worked-solution "From the diagram we see that the arms of the parabola open to the right. The parabola has its vertex at $(-6,0)$ and passes through the point $(-2,6).$\n\nThe general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(-6,0),$ we substitute $h=-6$ and $k=0$ into the equation above and get\n\n$$\n\\begin{aligned}{y}^{2} & =4p(x+6).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(-2,6),$ so we can substitute $x=-2$ and $y=6$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}{y}^{2} & =4p(x+6) \\\\ {6}^{2} & =4p(-2+6) \\\\ 36 & =16p \\\\ p & =\\frac{9}{4}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}{y}^{2} & =4p(x+6) \\\\ {y}^{2} & =4(\\frac{9}{4})(x+6) \\\\ {y}^{2} & =9(x+6).\\end{aligned}\n$$\n\nNotice that the arms of the parabola open to the right since $p=\\frac{9}{4}$ is positive."}] [{:db/id #edb/ref 17592186311548 :knowledge-point/_questions [{:knowledge-point/id #uuid "783ca59b-0242-584c-ae47-004a0eb03817" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola Given the Vertex and Another Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d26db3da-3c62-5054-8e8e-e5a6a99300e5" :answer/type {:db/ident :answer.type/math} :answer/value "(y+3)^{2}=5(x+4)" :db/id #edb/ref 17592186311550} {:answer/id #uuid "d93a2c22-0665-5154-9291-21aea4d1aa04" :answer/type {:db/ident :answer.type/math} :answer/value "(y+3)^{2}=-5(x+4)" :db/id #edb/ref 17592186311551} {:answer/id #uuid "9ea89fb8-18ff-5c75-b6e9-250f1413743e" :answer/type {:db/ident :answer.type/math} :answer/value "(y+3)^{2}=2(x+4)" :db/id #edb/ref 17592186311552} {:answer/id #uuid "d3d0bc6c-1fbd-553a-9172-f9a2feca6e07" :answer/type {:db/ident :answer.type/math} :answer/value "(y+4)^{2}=5(x+3)" :db/id #edb/ref 17592186311553} {:answer/id #uuid "1c47fd6d-6cdf-56a6-a81d-acf0ea7c9d63" :answer/type {:db/ident :answer.type/math} :answer/value "(y+3)^{2}=-2(x+4)" :db/id #edb/ref 17592186311554}] :answer-field/correct {:answer/id #uuid "d26db3da-3c62-5054-8e8e-e5a6a99300e5" :answer/type {:db/ident :answer.type/math} :answer/value "(y+3)^{2}=5(x+4)" :db/id #edb/ref 17592186311550} :answer-field/id #uuid "4916f60e-9b36-5255-b31f-77287070bcbd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311549}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0644416e-9146-5c0c-b6e4-b37a6a1d8844" :question/math-academy-id "q-11812" :question/problem "Find the equation of the right-opening parabola that has its vertex at $(-4,-3)$ and passes through the point $(1,2).$" :question/worked-solution "The general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(-4,-3),$ we substitute $h=-4$ and $k=-3$ into the equation above and get\n\n$$\n\\begin{aligned}(y+3)^{2} & =4p(x+4).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(1,2),$ so we can substitute $x=1$ and $y=2$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}(y+3)^{2} & =4p(x+4) \\\\ (2+3)^{2} & =4p(1+4) \\\\ 25 & =20p \\\\ p & =\\frac{5}{4}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}(y+3)^{2} & =4p(x+4) \\\\ (y+3)^{2} & =4(\\frac{5}{4})(x+4) \\\\ (y+3)^{2} & =5(x+4).\\end{aligned}\n$$"}]}
