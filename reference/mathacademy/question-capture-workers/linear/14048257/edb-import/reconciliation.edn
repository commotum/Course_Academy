+4‖v{‖}^{2} \\\\ (6\\sqrt{6})^{2} & =(6\\sqrt{2})^{2}+4‖v{‖}^{2} \\\\ 216 & =72+4‖v{‖}^{2} \\\\ 144 & =4‖v{‖}^{2} \\\\ ‖v{‖}^{2} & =36\\end{aligned}\n$$\n\nTherefore, $‖v‖=6.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040753/state.json" "file_sha256" "5c8d5431f2416a11a2ffd140598219391744997246558f294f0abd839312a40a" "basis" 1467 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040753/edb-import/verification.json"} {"question" "q-40263" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040753/activity-metadata.json" "file_sha256" "6297f9e56cb57b1d79f5f50f4f410d895cc53b635661ae753c51f260a8a7e2bc" "basis" 1467 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040753/edb-import/verification.json"} {"question" "q-40263" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040753/state.json" "file_sha256" "5c8d5431f2416a11a2ffd140598219391744997246558f294f0abd839312a40a" "basis" 1467 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040753/edb-import/verification.json"} {"question" "q-40263" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "2\\sqrt{6}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040753/state.json" "file_sha256" "5c8d5431f2416a11a2ffd140598219391744997246558f294f0abd839312a40a" "basis" 1467 "verification" "/home/jake/Developer/Course_Academy/reference/mat