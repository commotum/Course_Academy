n}⁡(-x) \\\\  & =(-x)(-\\operatorname{sin}⁡x) \\\\  & =x\\operatorname{sin}⁡x \\\\  & =f(x).\\end{aligned}\n$$\n\nSo, because $f(x)=x\\operatorname{sin}⁡x$ is an even function, we have\n\n$$\n{\\int }_{-\\pi }^{\\pi }x\\operatorname{sin}⁡x\\,\\text{d}x=2{\\int }_{0}^{\\pi }x\\operatorname{sin}⁡x\\,\\text{d}x.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056630/state.json" "file_sha256" "eb33222b7d9f2af2a0fa7d1341aa77d218d68a9b4d5ea34b91bf6ebc6f5cc27b"} {"question" "q-115258" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056630/activity-metadata.json" "file_sha256" "695c9a2f231761c8f243abfac54df5a4553eb3b4e729f309ec9a167d9fef3aec"} {"question" "q-115258" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056630/state.json" "file_sha256" "eb33222b7d9f2af2a0fa7d1341aa77d218d68a9b4d5ea34b91bf6ebc6f5cc27b"} {"question" "q-115258" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "0"] ["math" "2{\\int }_{0}^{\\pi /2}x\\operatorname{sin}⁡x\\,\\text{d}x"] ["math" "2{\\int }_{0}^{\\pi }x\\operatorname{sin}⁡x\\,\\text{d}x"] ["math" "{\\int }_{0}^{2\\pi }x\\operatorname{sin}⁡x\\,\\text{d}x"] ["math" "{\\int }_{0}^{\\pi }x\\operatorname{sin}⁡2x\\,\\text{d}x"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056630/state.json" "file_sha256" "eb33222b7d9f2af2a0fa7d1341aa77d218d68a9b4d5ea34b91bf6ebc6f5cc27b"} {"question" "q-115258" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2{\\int }_{0}^{\\pi }x\\operatorname{sin}⁡x\\,\\text{d}x"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056630/state.json" "file_sha256" "eb33222b7d9f2af2a0fa7d1341aa77d218d68a9b4d5ea34b91bf6ebc6f5cc27b"} {"question" "q-115257" "field" nil "attribute" "question/problem" "value" "${\\int }_{-\\sqrt{3}}^{\\sqrt{3}}\\sqrt{{x}^{2}+1}\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056630/state.json" "file_sha256" "eb33222b7d9f2af2a0fa7d1341aa77d218d68a9b4d5ea34b91bf6ebc6f5cc27b"} {"question" "q-115257" "field" nil "attribute" "question/worked-solution" "value" "Recall the following:\n\n- a function $f(x)$ is *even* if $f(-x)=f(x)$\n\n- a function $f(x)$ is *odd* if $f(-x)=-f(x)$\n\nMoreover, for any even function $f(x),$ the graph of $y=f(x)$ is symmetric across the $y$-axis, so we have\n\n$$\n{\\int }_{-a}^{a}f(x)\\,\\text{d}x=2{\\int }_{0}^{a}f(x)\\,\\text{d}x.\n$$\n\nNotice that $f(x)=\\sqrt{{x}^{2}+1}$ is an even function. Indeed, we have\n\n$$\n\\begin{aligned}f(-x) & =\\sqrt{(-x)^{2}+1} \\\\  & =\\sqrt{{x}^{2}+1} \\\\  & =f(x).\\end{aligned}\n$$\n\nSo, because $f(x)=\\sqrt{{x}^{2}+1}$ is an even function, we have\n\n$$\n{\\int }_{-\\sqrt{3}}^{\\sqrt{3}}\\sqrt{{x}^{2}+1}\\,\\text{d}x=2{\\int }_{0}^{\\sqrt{3}}\\sqrt{{x}^{2}+1}\\,\\text{d}x.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056630/state.json" "file_sha256" "eb33222b7d9f2af2a0fa7d1341aa77d218d68a9b4d5ea34b91bf6ebc6f5cc27b"} {"question" "q-115257" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056630/activity-metadata.json" "file_sha256" "695c9a2f231761c8f243abfac54df5a4553eb3b4e729f309ec9a167d9fef3aec"} {"question" "q-115257" "field" "selection" "attribute" "a