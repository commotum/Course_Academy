frac{1}{2})}^{x}-\\frac{1}{(1/2)^{x}}) \\\\  & =(\\frac{1}{{2}^{x}}-{2}^{x}) \\\\  & =-({2}^{x}-\\frac{1}{{2}^{x}}) \\\\  & =-f(x).\\end{aligned}\n$$\n\nSo, because $f(x)=({2}^{x}-\\frac{1}{{2}^{x}})$ is an odd function, we have\n\n$$\n{\\int }_{-2}^{2}({2}^{x}-\\frac{1}{{2}^{x}})\\,\\text{d}x=0.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-156183/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ebbaf66e-6155-510f-b4d8-e38dd4c4f05c"] :knowledge-point/questions ["q-156183"] :db/ensure [:knowledge-point/validate]} {:db/id "q-156182/selection/ad1c2dcbf7ae2d03a81dab7db798722940018b519f5409154789b7d464171b37" :answer/id #uuid "b2107981-70bb-5b68-9161-64fd41deef1a" :answer/type :answer.type/math :answer/value "4{\\int }_{0}^{1}x{e}^{{x}^{4}}\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-156182/selection/c9056ab114c9d934c72e70fc2eb33b32391d973d3e2ff8c399867f131e3c6773" :answer/id #uuid "98ca66fa-13d2-5cfb-a7dc-745f97c1bb22" :answer/type :answer.type/math :answer/value "-{\\int }_{0}^{1}x{e}^{{x}^{4}}\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-156182/selection/5e96c4244537f9e16cffbd2c634b6b8ca71e9878ed7ded4479647b64da16eb85" :answer/id #uuid "a55302ac-1828-5914-9048-101364834b51" :answer/type :answer.type/math :answer/value "-4{\\int }_{0}^{1}x{e}^{{x}^{4}}\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-156182/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "4aa7bbde-545f-59fe-a046-164063e56074" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-156182/selection/36cbc005fafda19df0ba87adb5ca3b2f5411c456c48f7779737dd4aaeaf51f7b" :answer/id #uuid "86baff91-0829-5b81-9da3-f645cfba8a3f" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{0}^{1}x{e}^{{x}^{4}}\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-156182/selection" :answer-field/id #uuid "8ca7d0ce-68bd-5fe8-9eda-cf66