[{:db/id "q-115258/selection/17cb400ba94b2371b4f310b8ba420a46871f03f6528539c6f5c307926063516f" :answer/id #uuid "18c1d19b-cbe2-5ba6-b37c-dfedbf222a1c" :answer/type :answer.type/math :answer/value "2{\\int }_{0}^{\\pi }x\\operatorname{sin}⁡x\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-115258/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "7d1d7c62-025c-5f1c-a4b0-cdb46842ead9" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-115258/selection/f069983a033aabc4e46b50918bec0f1107e6b4dd26d56faaa0216147b3589875" :answer/id #uuid "c6487141-70c8-58fa-8173-96fc74b6af5f" :answer/type :answer.type/math :answer/value "2{\\int }_{0}^{\\pi /2}x\\operatorname{sin}⁡x\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-115258/selection/5a456420526e785fa1ae8a12c873dcd7c91f4ae657e5842a11cc8e9894d1f74e" :answer/id #uuid "5c2a5664-cbb7-55c6-9099-920b4fea1931" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }x\\operatorname{sin}⁡2x\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-115258/selection/a664c14c9416625134e0b9452f644de6f90d05242414b84fc4c2ce783cbe058e" :answer/id #uuid "70c9a7f9-e80c-53dd-aa4a-54f72b17aeb3" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2\\pi }x\\operatorname{sin}⁡x\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-115258/selection" :answer-field/id #uuid "e9e5e04e-52f0-529f-9e1a-b6c5ff702171" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-115258/selection/17cb400ba94b2371b4f310b8ba420a46871f03f6528539c6f5c307926063516f" :answer-field/choices ["q-115258/selection/17cb400ba94b2371b4f310b8ba420a46871f03f6528539c6f5c307926063516f" "q-115258/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-115258/selection/f069983a033aabc4e46b50918bec0f1107e6b4dd26d56faaa0216147b3589875" "q-115258/selection/5a456420526e785fa1ae8a12c873dcd7c91f4ae657e5842a11cc8e9894d1f74e" "q-115258/selection/a664c14c9416625134e0b9452f644de6f90d05242414b84fc4c2ce783cbe058e"] :db/ensure [:answer-field/validate]} {:db/id "q-115258" :question/id #uuid "af5ae306-817e-54f1-b440-54325164bd65" :question/math-academy-id "q-115258" :question/problem "${\\int }_{-\\pi }^{\\pi }x\\operatorname{sin}⁡x\\,\\text{d}x=$" :question/worked-solution "Recall the following:\n\n- a function $f(x)$ is *even* if $f(-x)=f(x)$\n\n- a function $f(x)$ is *odd* if $f(-x)=-f(x)$\n\nMoreover, for any even function $f(x),$ the graph of $y=f(x)$ is symmetric across the $y$-axis, so we have\n\n$$\n{\\int }_{-a}^{a}f(x)\\,\\text{d}x=2{\\int }_{0}^{a}f(x)\\,\\text{d}x.\n$$\n\nNotice that $f(x)=x\\operatorname{sin}⁡x$ is an even function. Indeed, we have\n\n$$\n\\begin{aligned}f(-x) & =(-x)\\operatorname{sin}⁡(-x) \\\\  & =(-x)(-\\operatorname{sin}⁡x) \\\\  & =x\\operatorname{sin}⁡x \\\\  & =f(x).\\end{aligned}\n$$\n\nSo, because $f(x)=x\\operatorname{sin}⁡x$ is an even function, we have\n\n$$\n{\\int }_{-\\pi }^{\\pi }x\\operatorname{sin}⁡x\\,\\text{d}x=2{\\int }_{0}^{\\pi }x\\operatorname{sin}⁡x\\,\\text{d}x.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-115258/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2688742c-1655-557a-888d-af7e2179a89c"] :knowledge-point/questions ["q-115258"] :db/ensure [:knowledge-point/validate]} {:db/id "q-115257/selection/49f27b98ccc64e36fac42ef8a716ad0f04af27c44b4ec396768773147576f34f" :answer/id #uuid "ce2f5b56-f3fd-5e21-8668-b7f342b616b2" :answer/type :answer.type/math :answer/value "2{\\int }_{0}^{\\sqrt{3}}\\sqrt{{x}^{2}+1}\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-115257/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "3cb80c03-d58e-5bd8-a7be-aabdd38406be" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-115257/selection/6d1fda80d70451acf76a9d8f73d14469ff5710f9ab400c3