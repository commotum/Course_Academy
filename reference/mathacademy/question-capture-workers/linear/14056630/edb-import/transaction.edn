4bba68305459e56d37dca6dd88fd546bde81c1e0ca99b2a1ab8693bef66c2f3b"] :db/ensure [:answer-field/validate]} {:db/id "q-115255" :question/id #uuid "ca4fb77c-9cab-5ab0-85be-a324f501e20a" :question/math-academy-id "q-115255" :question/problem "Simplify the integral ${\\int }_{-1/2}^{1/2}\\frac{{x}^{2}}{1+{x}^{4}}\\,\\text{d}x$ using symmetry." :question/worked-solution "Recall the following:\n\n- a function $f(x)$ is *even* if $f(-x)=f(x)$\n\n- a function $f(x)$ is *odd* if $f(-x)=-f(x)$\n\nMoreover, for any even function $f(x),$ the graph of $y=f(x)$ is symmetric across the $y$-axis, so we have\n\n$$\n{\\int }_{-a}^{a}f(x)\\,\\text{d}x=2{\\int }_{0}^{a}f(x)\\,\\text{d}x.\n$$\n\nNotice that $f(x)=\\frac{{x}^{2}}{1+{x}^{4}}$ is an even function. Indeed, we have\n\n$$\n\\begin{aligned}f(-x) & =\\frac{(-x)^{2}}{1+(-x)^{4}} \\\\  & =\\frac{{x}^{2}}{1+{x}^{4}} \\\\  & =f(x).\\end{aligned}\n$$\n\nSo, because $f(x)=\\frac{{x}^{2}}{1+{x}^{4}}$ is an even function, we have\n\n$$\n{\\int }_{-1/2}^{1/2}\\frac{{x}^{2}}{1+{x}^{4}}\\,\\text{d}x=2{\\int }_{0}^{1/2}\\frac{{x}^{2}}{1+{x}^{4}}\\,\\text{d}x.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-115255/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2688742c-1655-557a-888d-af7e2179a89c"] :knowledge-point/questions ["q-115255"] :db/ensure [:knowledge-point/validate]} {:db/id "q-88695/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "4b93a51b-2cc2-5c07-9384-3ac0d398cfad" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-88695/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "94bd8d9b-df94-5954-9d8a-8afd3b9d8d25" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-88695/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "8f3c067b-4e2b-5ab8-bcf3-f8