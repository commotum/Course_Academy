4\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & -4 \\\\ 0 & 0 & 12\\end{aligned}] & {R}_{2} & :=\\frac{1}{12}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -3 & -4 \\\\ 0 & 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nFrom the matrix above, we see that the pivot columns are the $1$st and $3$rd columns. So, a basis of $\\text{Col}(T)$ is ${{t}_{1},{t}_{3}}.$\n\nTherefore, we conclude that $\\text{{}{t}_{1},{t}_{2}\\text{}}$ is not a basis of $\\text{Col}(T).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-111508/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "db27967e-f80c-587b-9b10-28f1a5518f57"] :knowledge-point/questions ["q-111508"] :db/ensure [:knowledge-point/validate]} {:db/id "q-111502/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "db7e8d16-ec7d-57f0-b372-d8eeff521503" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-111502/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "696fc294-4b1b-531a-a551-ac04fcd3ae3a" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-111502/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "06e73276-761a-5e5f-b088-f585c7d47a43" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-111502/selection/fe181dcbae0b8d386329d4879f2be581227c0752e0dd0ae17c83b6106a54d21e" :answer/id #uuid "0463d39e-3ec9-5e3b-b1d4-85102a2c5fd6" :answer/type :answer.type/text :answer/value "$\\text{{}{t}_{1},{t}_{2}\\text{}}$ is not a basis of $\\text{Col}(T)$" :db/ensure [:answer/validate]} {:db/id "q-111502/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "1fdbb3e5-6a71-5a1d-a94e-7069d9840987" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-111502/selection" :answer-field/id #uuid "0415b574-34b0-5df5-9b9d-7660b9439a7b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-111502/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-111502/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-111502/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-111502/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-111502/selection/fe181dcbae0b8d386329d4879f2be581227c0752e0dd0ae17c83b6106a54d21e" "q-111502/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-111502" :question/id #uuid "f6e51b91-7ab2-5c25-87d8-4387cfc043b0" :question/math-academy-id "q-111502" :question/problem "The matrix $T$ is given below. Let ${t}_{1}$, ${t}_{2}$, and ${t}_{3}$ be the respective columns of $T.$ Determine if $B=\\text{{}{t}_{1},{t}_{2}\\text{}}$ is a basis of $\\text{Col}(T).$ If that is the case, find ${x}_{1}\\cdot {x}_{2}$, where ${t}_{3}={x}_{1}{t}_{1}+{x}_{2}{t}_{2}.$\n\n$$\nT=[\\begin{aligned}1 & 2 & 8 \\\\ 3 & 8 & 30\\end{aligned}]\n$$" :question/worked-solution "First, we reduce the matrix $T$ to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned}T & =[\\begin{aligned}1 & 2 & 8 \\\\ 3 & 8 & 30\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & 8 \\\\ 0 & 2 & 6\\end{aligned}] & {R}_{2} & :=\\frac{1}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 2 & 8 \\\\ 0 & 1 & 3\\end{aligned}] & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 2 \\\\ 0 & 1 & 3\\end{aligned}]\\end{aligned}\n$$\n\nFrom the matrix above, we see that the pivot columns are the $1$st and $2$nd columns. So, a basis of $\\text{Col}(T)$ is ${{t}_{1},{t}_{2}},$ that is to say,\n\n$$\nB={[\\begin{aligned}1 \\\\ 3\\end{aligned}],[\\begin{aligned}2 \\\\ 8\\end{aligned}]}.\n$$\n\nNow, since the $3$rd column of the reduced matrix is a non-pivot column, then the entries in that column tell us the coefficients needed to express ${t}_{3}$ as a linear combination of all the other columns in the original matrix. So, we have\n\n$$\n{{[\\begin{aligned}8 \\\\ 30\\end{aligned}]}_{⏟}}_{{t}_{3}}={{(2)}_{⏟}}_{{x}_{1}}\\cdot {{[\\begin{aligned}1 \\\\ 3\\end{aligned}]}_{⏟}}_{{t}_{1}}+{{(3)}_{⏟}}_{{x}_{2}}\\cdot {{[\\begin{aligned}2 \\\\ 8\\end{aligned}]}_{⏟}}_{{t}_{2}}.\n$$\n\nThis gives us ${x}_{1}\\cdot {x}_{2}=2\\cdot 3=6.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-111502/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "db27967e-f80c-587b-9b10-28f1a5518f57"] :knowledge-point/questions ["q-111502"] :db/ensure [:knowledge-point/validate]} {:db/id "q-75083/selection/fcff19540e2149a95c3c193c7b4b9fa269a77e27b2d2d6243ed131a322c30d13" :answer/id #uuid "1d90a513-4359-5815-828b-3a6db4a78932" :answer/type :answer.type/text :answer/value "$\\text{{}{u}_{1},{u}_{3}\\text{}}$ is not a basis of $\\text{Col}(U)$" :db/ensure [:answer/validate]} {:db/id "q-75083/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "dc1be78d-028a-5bd1-88f9-295f391cd194" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-75083/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "94685e18-4566-5fde-9504-58f3a5d56c05" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-75083/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "f842517e-82f9-5029-9c58-9f3f640486b1" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-75083/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "aa01ad2d-cdce-54b5-8f37-5bf1a171b4bf" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-75083/selection" :answer-field/id #uuid "7b15822b-560f-5e1b-ba16-0abf6016651d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-75083/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-75083/selection/fcff19540e2149a95c3c193c7b4b9fa269a77e27b2d2d6243ed131a322c30d13" "q-75083/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-75083/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" "q-75083/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" "q-75083/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-75083" :question/id #uuid "934aa386-839a-593c-8c36-c2b60c761724" :question/math-academy-id "q-75083" :question/problem "The matrix $U$ is given below. Let ${u}_{1}$, ${u}_{2}$, and ${u}_{3}$ be the respective columns of $U.$\nDetermine if $B=\\text{{}{u}_{1},{u}_{3}\\text{}}$ is a basis of $\\text{Col}(U).$ \nIf that is the case, find ${x}_{1}\\cdot {x}_{3}$, where ${u}_{2}={x}_{1}{u}_{1}+{x}_{3}{u}_{3}.$\n\n$$\nU=[\\begin{aligned}1 & -2 & -3 \\\\ -4 & 8 & 8\\end{aligned}]\n$$" :question/worked-solution "First, we reduce the matrix $U$ to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned}U & =[\\begin{aligned}1 & -2 & -3 \\\\ -4 & 8 & 8\\end{aligned}] & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & -3 \\\\ 0 & 0 & -4\\end{aligned}] & {R}_{2} & :=(-\\frac{1}{4}){R}_{2} \\\\  & ∼[\\begin{aligned}1 & -2 & -3 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+3{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -2 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nFrom the matrix above, we see that the pivot columns are the $1$st and $3$rd columns. So, a basis of $\\text{Col}(U)$ is ${{u}_{1},{u}_{3}},$ that is to say,\n\n$$\nB={[\\begin{aligned}1 \\\\ -4\\end{aligned}],[\\begin{aligned}-3 \\\\ 8\\end{aligned}]}.\n$$\n\nNow, since the $2$nd column of the reduced matrix is a non-pivot column, then the entries in that column tell us the coefficients needed to express ${u}_{2}$ as a linear combination of all the other columns in the original matrix. So, we have\n\n$$\n{{[\\begin{aligned}-2 \\\\ 8\\end{aligned}]}_{⏟}}_{{u}_{2}}={{(-2)}_{⏟}}_{{x}_{1}}\\cdot {{[\\begin{aligned}1 \\\\ -4\\end{aligned}]}_{⏟}}_{{u}_{1}}+{{(0)}_{⏟}}_{{x}_{3}}\\cdot {{[\\begin{aligned}-3 \\\\ 8\\end{aligned}]}_{⏟}}_{{u}_{3}}.\n$$\n\nThis gives us ${x}_{1}\\cdot {x}_{3}=(-2)\\cdot 0=0.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-75083/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "db27967e-f80c-587b-9b10-28f1a5518f57"] :knowledge-point/questions ["q-75083"] :db/ensure [:knowledge-point/validate]} {:db/id "q-111503/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "8eaf8dbf-bacc-5706-97e1-1aeebda1bac8" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-111503/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "810ddb07-cc53-554b-9f44-f6718bf301aa" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-111503/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "fea9d976-bd07-5210-b91d-748efabee3b2" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-111503/selection/8fac1c59a8f2e904d35daae5a92fa742431ce172640f37a34a7a2cbcefb4bc4a" :answer/id #uuid "c4922d2d-3eca-57ed-8417-d2e14fedd050" :answer/type :answer.type/text :answer/value "$\\text{{}{t}_{1},{t}_{3}\\text{}}$ is not a basis of $\\text{Col}(T)$" :db/ensure [:answer/validate]} {:db/id "q-111503/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1a