[:question/validate]} {:db/id [:knowledge-point/id #uuid "7c9317eb-d1ce-5f42-b69b-a37e643b865b"] :knowledge-point/questions ["q-71839"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316469/field-1/054df71bf62ea89913f9c2980b7f6d6def00d66a858833ee465c5a750ceea842" :answer/id #uuid "9608e208-cc08-5c25-8d14-7d6e9268f051" :answer/type :answer.type/math :answer/value "-\\frac{33}{14}" :db/ensure [:answer/validate]} {:db/id "q-316469/field-1" :answer-field/id #uuid "dd2dbf9c-17c0-5475-a059-4faac3b1d390" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316469/field-1/054df71bf62ea89913f9c2980b7f6d6def00d66a858833ee465c5a750ceea842" :answer-field/choices ["q-316469/field-1/054df71bf62ea89913f9c2980b7f6d6def00d66a858833ee465c5a750ceea842"] :db/ensure [:answer-field/validate]} {:db/id "q-316469/field-2/a4cb9b2f1ae94b8c8b41aba09cbf802ecb8a545f79e39373859b25c30a62542e" :answer/id #uuid "0011cd6d-710f-52fe-9d83-21d7865fb4a9" :answer/type :answer.type/math :answer/value "\\frac{11}{7}" :db/ensure [:answer/validate]} {:db/id "q-316469/field-2" :answer-field/id #uuid "a5f16061-71ff-5c16-a2dd-21a4d12382f5" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316469/field-2/a4cb9b2f1ae94b8c8b41aba09cbf802ecb8a545f79e39373859b25c30a62542e" :answer-field/choices ["q-316469/field-2/a4cb9b2f1ae94b8c8b41aba09cbf802ecb8a545f79e39373859b25c30a62542e"] :db/ensure [:answer-field/validate]} {:db/id "q-316469/field-3/29a87d950dd65ba344fcbb8e74cd8feb726734fe7e6623a651b824bbb78e9774" :answer/id #uuid "9829534a-4f1d-5319-abba-0c9b1c096a26" :answer/type :answer.type/math :answer/value "-\\frac{11}{14}" :db/ensure [:answer/validate]} {:db/id "q-316469/field-3" :answer-field/id #uuid "2f2f934a-0c8d-52b8-976e-e453560dfaeb" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316469/field-3/29a87d950dd65ba344fcbb8e74cd8feb726734fe7e6623a651b824bbb78e9774" :answer-field/choices ["q-316469/field-3/29a87d950dd65ba344fcbb8e74cd8feb726734fe7e6623a651b824bbb78e9774"] :db/ensure [:answer-field/validate]} {:db/id "q-316469" :question/id #uuid "cd0cbfc6-b126-54ce-bf9b-c834946584f4" :question/math-academy-id "q-316469" :question/problem "Let $c=[\\begin{aligned}3 \\\\ -2 \\\\ 1\\end{aligned}]$ and $d=[\\begin{aligned}0 \\\\ 5 \\\\ -1\\end{aligned}].$ Find the vector projection of $d$ onto $c.$\n\n${\\text{proj}}_{c}\\,d=⟨$  \n\n{{field-1}},\n\n{{field-2}},\n\n{{field-3}}\n\n$⟩$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{c}\\,d & =\\frac{c\\cdot d}{c\\cdot c}c \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{{c}_{x}^{2}+{c}_{y}^{2}+{c}_{z}^{2}}c \\\\  & =\\frac{(3)(0)+(-2)(5)+(1)(-1)}{{3}^{2}+(-2)^{2}+{1}^{2}}c \\\\  & =\\frac{0-10-1}{9+4+1}\\,⟨3,-2,1⟩ \\\\  & =-\\frac{11}{14}\\,⟨3,-2,1⟩ \\\\  & =⟨-\\frac{33}{14},\\frac{11}{7},-\\frac{11}{14}⟩.\\end{aligned}\n$$\n\n`" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-316469/field-1" "q-316469/field-2" "q-316469/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f"] :knowledge-point/questions ["q-316469"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71834/selection/2cd7e128ba6730aa610b0a1325a00c9dd9db0543f3c0c90e42b3b33a6334f797" :answer/id #uuid "7bac7e28-9988-5e7f-b9d7-ed23463d9212" :answer/type :answer.type/math :answer/value "⟨-1,-2,3⟩" :db/ensure [:answer/validate]} {:db/id "q-71834/selection/e2e48e7da4fde54b18fd8844d656fb259a89d18de62ac6dfd812d2d330574153" :answer/id #uuid "97458e17-fc00-5e60-9314-1d629e85b448" :answer/type :answer.type/math :answer/value "⟨-6,-2,4⟩" :db/ensure [:answer/validate]} {:db/id "q-71834/selection/e21f6c1be126d0b41d684867cab0144f7bc019a223de76a62bf3a2c6655340e5" :answer/id #uuid "a3a24283-48ef-5cb5-933a-bd38287e7999" :answer/type :answer.type/math :answer/value "⟨-2,-1,3⟩" :db/ensure [:answer/validate]} {:db/id "q-71834/selection/85576403c7f97860d1fd9acd05f6c6913bee2a4adffc91d9c8449848a15a8d94" :answer/id #uuid "dcf18d83-3a17-55ba-b80d-3b6fc9123d1c" :answer/type :answer.type/math :answer/value "⟨-3,-1,2⟩" :db/ensure [:answer/validate]} {:db/id "q-71834/selection/9321a55ddd94cfb0953ea16c3eb99c835c1b87e2c75b33d030fa2792634d63d8" :answer/id #uuid "9bf49c87-908c-5b8e-ba91-3f7e507ae54d" :answer/type :answer.type/math :answer/value "⟨-4,-2,6⟩" :db/ensure [:answer/validate]} {:db/id "q-71834/selection" :answer-field/id #uuid "3d9c70cb-2a4e-5dbb-a309-4c6cf958beea" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71834/selection/e21f6c1be126d0b41d684867cab0144f7bc019a223de76a62bf3a2c6655340e5" :answer-field/choices ["q-71834/selection/2cd7e128ba6730aa610b0a1325a00c9dd9db0543f3c0c90e42b3b33a6334f797" "q-71834/selection/e2e48e7da4fde54b18fd8844d656fb259a89d18de62ac6dfd812d2d330574153" "q-71834/selection/e21f6c1be126d0b41d684867cab0144f7bc019a223de76a62bf3a2c6655340e5" "q-71834/selection/85576403c7f97860d1fd9acd05f6c6913bee2a4adffc91d9c8449848a15a8d94" "q-71834/selection/9321a55ddd94cfb0953ea16c3eb99c835c1b87e2c75b33d030fa2792634d63d8"] :db/ensure [:answer-field/validate]} {:db/id "q-71834" :question/id #uuid "06286d73-225f-5331-8e6a-d04051a18b14" :question/math-academy-id "q-71834" :question/problem "Let $c=[\\begin{aligned}2 \\\\ 1 \\\\ -3\\end{aligned}]$ and $d=[\\begin{aligned}2 \\\\ -3 \\\\ 5\\end{aligned}].$ Find the vector projection of $d$ onto $c.$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{c}\\,d & =\\frac{c\\cdot d}{c\\cdot c}c \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{{c}_{x}^{2}+{c}_{y}^{2}+{c}_{z}^{2}}c \\\\  & =\\frac{2\\cdot 2+1\\cdot (-3)+(-3)\\cdot 5}{{2}^{2}+{1}^{2}+(-3)^{2}}c \\\\  & =-\\frac{14}{14}⟨2,1,-3⟩ \\\\  & =⟨-2,-1,3⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-71834/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f"] :knowledge-point/questions ["q-71834"] :db/ensure [:knowledge-point/validate]} {:db/id "q-212462/selection/8e918182341451051ce2dca07cfe2b17fa3abe4a925a8df02308f239a4dd798f" :answer/id #uuid "0b205f21-bc89-5ac8-ab11-acc61b483f46" :answer/type :answer.type/math :answer/value "-\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-212462/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "df58f5f2-0605-56c6-a541-4df174d012cf" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-212462/selection/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" :answer/id #uuid "c5e703e0-9ecb-5690-943b-c7c510abf491" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "q-212462/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "eee9127f-b4c5-5605-8394-d8aee8ba5a13" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-212462/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer/id #uuid "8520b09f-4c02-5433-84c4-2067d3793c08" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-212462/selection" :answer-field/id #uuid "dd34f353-c15f-53df-b1eb-1e4a2cbbfee9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-212462/selection/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" :answer-field/choices ["q-212462/selection/8e918182341451051ce2dca07cfe2b17fa3abe4a925a8df02308f239a4dd798f" "q-212462/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-212462/selection/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" "q-212462/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-212462/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833"] :db/ensure [:answer-field/validate]} {:db/id "q-212462" :question/id #uuid "28160526-4d46-5bbc-86fb-79ce8277111a" :question/math-academy-id "q-212462" :question/problem "Let $a=[\\begin{aligned}1 \\\\ 3 \\\\ 2\\end{aligned}]$ and $b=[\\begin{aligned}1 \\\\ -2 \\\\ x\\end{aligned}].$ Given that the projection of $a$ onto $b$ is the zero vector, find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its projection onto another nonzero vector $b$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =1\\cdot 1+3\\cdot (-2)+2\\cdot x \\\\  & =2x-5.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 2x-5 & =0 \\\\ 2x & =5 \\\\ x & =\\frac{5}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-212462/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf"] :knowledge-point/questions ["q-212462"] :db/ensure [:knowledge-point/validate]} {:db/id "q-212206/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "5f08c71b-e3ae-5e32-9780-1d0a1289f475" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-212206/selection/3089f9a34f7a805d8b2b2d5d51b10dc7aea027e8ec8fd8d06ad11cecf2ba9740" :answer/id #uuid "b4403445-67b9-5876-9621-ce0068b1361b" :answer/type :answer.type/math :answer/value "\\frac{4}{5}" :db/ensure [:answer/validate]} {:db/id "q-212206/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" :answer/id #uuid "0d164dc5-be40-53e4-a218-e773477db450" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-212206/selection/9ab64b945e95c1c3798cea70f4ae7ad55133b01b9b894848e70b56c91ffbae97" :answer/id #uuid "1f724f5d-1017-5aef-a991-2e192949147c" :answer/type :answer.type/math :answer/value "\\frac{4}{3}" :db/ensure [:answer/validate]} {:db/id "q-212206/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "ed41853b-dbb8-5c31-a285-e39712881dca" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-212206/selection" :answer-field/id #uuid "9b194a7c-3083-53f0-aefe-7c4fa914ccff" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-212206/selection/9ab64b945e95c1c3798cea70f4ae7ad55133b01b9b894848e70b56c91ffbae97" :answer-field/choices ["q-212206/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-212206/selection/3089f9a34f7a805d8b2b2d5d51b10dc7aea027e8ec8fd8d06ad11cecf2ba9740" "q-212206/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" "q-212206/selection/9ab64b945e95c1c3798cea70f4ae7ad55133b01b9b894848e70b56c91ffbae97" "q-212206/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-212206" :question/id #uuid "6c4a1fe8-f923-59d1-9b70-b2a00cdbb8f6" :question/math-academy-id "q-212206" :question/problem "Let $a=⟨1,2,3⟩$ and $b=⟨2,-3,x⟩.$ Given that the projection of $a$ onto $b$ is the zero vector, find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its projection onto another nonzero vector $b$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =1\\cdot 2+2\\cdot (-3)+3\\cdot x \\\\  & =3x-4.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 3x-4 & =0 \\\\ 3x & =4 \\\\ x & =\\frac{4}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-212206/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf"] :knowledge-point/questions ["q-212206"] :db/ensure [:knowledge-point/validate]} {:db/id "q-212456/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "43fcfd16-71ee-58fc-b316-7659097da4b9" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-212456/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "29b28e6d-d280-5ea3-90b5-387423d3de2a" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-212456/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "d1859c9b-d292-5956-94ba-f9dda7386eab" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-212456/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "81cfbe15-9ef7-5c75-b32f-308be5763311" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-212456/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "6baa0b47-46fe-5dfa-b7bf-c59e3a2817fe" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-212456/selection" :answer-field/id #uuid "68a3c741-9a0b-5a47-9302-8c9bdf985cc2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-212456/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-212456/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-212456/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-212456/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-212456/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-212456/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-212456" :question/id #uuid "9f6200bc-fe43-56c7-ac3d-8a648cdf9316" :question/math-academy-id "q-212456" :question/problem "Let $a=⟨-2,3,1⟩$ and $b=⟨-1,-2,x⟩.$ Given that the projection of $a$ onto $b$ is the zero vector, find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its projection onto another nonzero vector $b$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =-2\\cdot (-1)+3\\cdot (-2)+1\\cdot x \\\\  & =x-4.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ x-4 & =0 \\\\ x & =4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-212456/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf"] :knowledge-point/questions ["q-212456"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-14619"] :question/problem "Let ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/assets/e199e48633dbaeeb817da846163a9c8a9bf1ae3355c69b56461b25a13ef73406.png) and ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/assets/4ce6e454ff96976ddeb735d1ab42562fe3b7eb16f16e7c0402d8040f9586907b.png). Find the vector projection of $\\mathbf{a}$ onto $\\mathbf{b}$." :db/ensure [:question/validate]}]
