#{[{:db/id #edb/ref 17592186285221 :knowledge-point/_questions [{:knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f" :knowledge-point/title "Calculating a Vector Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c11326f-5909-58ab-8ac9-a2e6eac5d144" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\frac{7}{9},\\frac{2}{9},-\\frac{1}{9}⟩" :db/id #edb/ref 17592186285223} {:answer/id #uuid "012048d7-8f85-51ed-a130-8530ce2575cc" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,0,0⟩" :db/id #edb/ref 17592186285224} {:answer/id #uuid "2183e8b9-c1ec-59aa-86ca-a75255ee33c8" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\frac{7}{54},\\frac{2}{54},-\\frac{1}{54}⟩" :db/id #edb/ref 17592186285225} {:answer/id #uuid "e9782f45-163f-53f2-b62b-0bb67425f1b0" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\frac{7}{54},\\frac{2}{9},-\\frac{1}{54}⟩" :db/id #edb/ref 17592186285226} {:answer/id #uuid "7e664081-7f20-570b-8217-9fab34b88008" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{2}{9},-\\frac{7}{9},\\frac{1}{9}⟩" :db/id #edb/ref 17592186285227}] :answer-field/correct {:answer/id #uuid "2c11326f-5909-58ab-8ac9-a2e6eac5d144" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\frac{7}{9},\\frac{2}{9},-\\frac{1}{9}⟩" :db/id #edb/ref 17592186285223} :answer-field/id #uuid "e63f8760-8604-5eea-a72f-ab9fa16b5226" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186285222}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "06e573d1-988c-580b-8411-4633e9b41f74" :question/math-academy-id "q-19211" :question/problem "Let $a=[\\begin{aligned}1 \\\\ 8 \\\\ 3\\end{aligned}]$ and $b=[\\begin{aligned}7 \\\\ -2 \\\\ 1\\end{aligned}].$ Find the vector projection of $a$ onto $b.$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{1\\cdot 7+8\\cdot (-2)+3\\cdot 1}{{7}^{2}+(-2)^{2}+{1}^{2}}b \\\\  & =-\\frac{6}{54}⟨7,-2,1⟩ \\\\  & =-\\frac{1}{9}⟨7,-2,1⟩ \\\\  & =⟨-\\frac{7}{9},\\frac{2}{9},-\\frac{1}{9}⟩.\\end{aligned}\n$$"}]}
