#{[{:db/id #edb/ref 17592186106408 :knowledge-point/_questions [{:knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf" :knowledge-point/title "Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0b5d2f2-111b-5f36-9574-2bddbaa91b43" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{3}{\\sqrt{30}},-\\frac{1}{\\sqrt{30}},-\\frac{1}{\\sqrt{30}}⟩" :db/id #edb/ref 17592186104958} {:answer/id #uuid "f4f58996-7c81-5e9f-ba8e-db6242aefc7d" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{1}{\\sqrt{5}},-\\frac{2}{\\sqrt{5}}, \\sqrt{5}⟩" :db/id #edb/ref 17592186104959} {:answer/id #uuid "35a3fa91-2877-5f05-a29d-c67415825e7c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0, 0, 0⟩" :db/id #edb/ref 17592186104960} {:answer/id #uuid "46105738-53e5-5544-b410-1c5c6a0dca2a" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186104961} {:answer/id #uuid "4e7f5cbb-14b3-506f-adb0-22b07a0eede9" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{3}{\\sqrt{5}},-\\frac{1}{\\sqrt{5}},-\\frac{1}{\\sqrt{5}}⟩" :db/id #edb/ref 17592186104962}] :answer-field/correct {:answer/id #uuid "35a3fa91-2877-5f05-a29d-c67415825e7c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0, 0, 0⟩" :db/id #edb/ref 17592186104960} :answer-field/id #uuid "c2b6ad5b-aaf4-500d-b96a-7b1a0906a3f4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186104957}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ab29d467-5294-537a-b48f-a1d1aefe0cab" :question/math-academy-id "q-71668" :question/problem "Let $a=⟨1,-2,5⟩$ and $b=⟨3,-1,-1⟩.$ Find the vector projection of $a$ onto $b.$" :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{1\\cdot 3+(-2)\\cdot (-1)+5\\cdot (-1)}{{3}^{2}+(-1)^{2}+(-1)^{2}}b \\\\  & =\\frac{0}{{3}^{2}+(-1)^{2}+(-1)^{2}}b \\\\  & =⟨0,0,0⟩.\\end{aligned}\n$$"}]}
