.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-316469" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/activity-metadata.json" "file_sha256" "e6fe8f0b00258bee9b2b21577475e5a48381bafc9b7690de1fb8c376e61486fc"} {"question" "q-316469" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-316469" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{33}{14}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-316469" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-316469" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{11}{7}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-316469" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-316469" "field" "field-3" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{11}{14}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-71834" "field" nil "attribute" "question/problem" "value" "Let $c=[\\begin{aligned}2 \\\\ 1 \\\\ -3\\end{aligned}]$ and $d=[\\begin{aligned}2 \\\\ -3 \\\\ 5\\end{aligned}].$ Find the vector projection of $d$ onto $c.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-71834" "field" nil "attribute" "question/worked-solution" "value" "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{c}\\,d & =\\frac{c\\cdot d}{c\\cdot c}c \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{{c}_{x}^{2}+{c}_{y}^{2}+{c}_{z}^{2}}c \\\\  & =\\frac{2\\cdot 2+1\\cdot (-3)+(-3)\\cdot 5}{{2}^{2}+{1}^{2}+(-3)^{2}}c \\\\  & =-\\frac{14}{14}⟨2,1,-3⟩ \\\\  & =⟨-2,-1,3⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-71834" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/activity-metadata.json" "file_sha256" "e6fe8f0b00258bee9b2b21577475e5a48381bafc9b7690de1fb8c376e61486fc"} {"question" "q-71834" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-71834" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "⟨-1,-2,3⟩"] ["math" "⟨-2,-1,3⟩"] ["math" "⟨-3,-1,2⟩"] ["math" "⟨-4,-2,6⟩"] ["math" "⟨-6,-2,4⟩"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-71834" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "⟨-2,-1,3⟩"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-275237" "field" nil "attribute" "question/problem" "value" "Let $a=[\\begin{aligned}-2 \\\\ 1 \\\\ 2\\end{aligned}]$ and $b=[\\begin{aligned}x \\\\ 3 \\\\ 1\\end{aligned}].$ Given that the projection of $a$ onto $b$ is the zero vector, find the value of $x.$\n\n$x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-275237" "field" nil "attribute" "question/worked-solution" "value" "Since $a$ is a nonzero vector, its projection onto another nonzero vector $b$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =-2\\cdot x+1\\cdot 3+2\\cdot 1 \\\\  & =-2x+5.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ -2x+5 & =0 \\\\ 2x & =5 \\\\ x & =\\frac{5}{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-275237" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/activity-metadata.json" "file_sha256" "e6fe8f0b00258bee9b2b21577475e5a48381bafc9b7690de1fb8c376e61486fc"} {"question" "q-275237" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-275237" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{5}{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-212462" "field" nil "attribute" "question/problem" "value" "Let $a=[\\begin{aligned}1 \\\\ 3 \\\\ 2\\end{aligned}]$ and $b=[\\begin{aligned}1 \\\\ -2 \\\\ x\\end{aligned}].$ Given that the projection of $a$ onto $b$ is the zero vector, find the value of $x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-212462" "field" nil "attribute" "question/worked-solution" "value" "Since $a$ is a nonzero vector, its projection onto another nonzero vector $b$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =1\\cdot 1+3\\cdot (-2)+2\\cdot x \\\\  & =2x-5.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 2x-5 & =0 \\\\ 2x & =5 \\\\ x & =\\frac{5}{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-212462" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/activity-metadata.json" "file_sha256" "e6fe8f0b00258bee9b2b21577475e5a48381bafc9b7690de1fb8c376e61486fc"} {"question" "q-212462" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-212462" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2"] ["math" "-3"] ["math" "-\\frac{3}{2}"] ["math" "\\frac{1}{3}"] ["math" "\\frac{5}{2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-212462" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{5}{2}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-71668" "field" nil "attribute" "question/problem" "value" "Let $a=⟨1,-2,5⟩$ and $b=⟨3,-1,-1⟩.$ Find the vector projection of $a$ onto $b.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-71668" "field" nil "attribute" "question/worked-solution" "value" "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{1\\cdot 3+(-2)\\cdot (-1)+5\\cdot (-1)}{{3}^{2}+(-1)^{2}+(-1)^{2}}b \\\\  & =\\frac{0}{{3}^{2}+(-1)^{2}+(-1)^{2}}b \\\\  & =⟨0,0,0⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-71668" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/activity-metadata.json" "file_sha256" "e6fe8f0b00258bee9b2b21577475e5a48381bafc9b7690de1fb8c376e61486fc"} {"question" "q-71668" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-71668" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "5"] ["math" "⟨0,0,0⟩"] ["math" "⟨\\frac{1}{\\sqrt{5}},-\\frac{2}{\\sqrt{5}},\\sqrt{5}⟩"] ["math" "⟨\\frac{3}{\\sqrt{30}},-\\frac{1}{\\sqrt{30}},-\\frac{1}{\\sqrt{30}}⟩"] ["math" "⟨\\frac{3}{\\sqrt{5}},-\\frac{1}{\\sqrt{5}},-\\frac{1}{\\sqrt{5}}⟩"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-71668" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "⟨0,0,0⟩"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-212206" "field" nil "attribute" "question/problem" "value" "Let $a=⟨1,2,3⟩$ and $b=⟨2,-3,x⟩.$ Given that the projection of $a$ onto $b$ is the zero vector, find the value of $x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-212206" "field" nil "attribute" "question/worked-solution" "value" "Since $a$ is a nonzero vector, its projection onto another nonzero vector $b$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =1\\cdot 2+2\\cdot (-3)+3\\cdot x \\\\  & =3x-4.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 3x-4 & =0 \\\\ 3x & =4 \\\\ x & =\\frac{4}{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-212206" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/activity-metadata.json" "file_sha256" "e6fe8f0b00258bee9b2b21577475e5a48381bafc9b7690de1fb8c376e61486fc"} {"question" "q-212206" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-212206" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2"] ["math" "1"] ["math" "\\frac{2}{3}"] ["math" "\\frac{4}{3}"] ["math" "\\frac{4}{5}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-212206" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{4}{3}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-212456" "field" nil "attribute" "question/problem" "value" "Let $a=⟨-2,3,1⟩$ and $b=⟨-1,-2,x⟩.$ Given that the projection of $a$ onto $b$ is the zero vector, find the value of $x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-212456" "field" nil "attribute" "question/worked-solution" "value" "Since $a$ is a nonzero vector, its projection onto another nonzero vector $b$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =-2\\cdot (-1)+3\\cdot (-2)+1\\cdot x \\\\  & =x-4.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ x-4 & =0 \\\\ x & =4.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-212456" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/activity-metadata.json" "file_sha256" "e6fe8f0b00258bee9b2b21577475e5a48381bafc9b7690de1fb8c376e61486fc"} {"question" "q-212456" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-212456" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-3"] ["math" "0"] ["math" "2"] ["math" "4"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "q-212456" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "4"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/state.json" "file_sha256" "019c2b25f329e6c9df6ac453626d05fd762f0bbe3a38ed201401092e46827f55"} {"question" "e-14617" "field" nil "attribute" "question/problem" "value" "Suppose that $|\\,\\mathbf{a}\\,|=8,|\\,\\mathbf{b}\\,|=4$ and that the angle between the vectors is $\\theta = \\dfrac{5\\pi}{6}.$ Find the vector projection of $\\mathbf{a}$ onto $\\mathbf{b}$ in terms of the vector $\\mathbf{b}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/example-14617.json" "file_sha256" "30be1ea4742c2a9b56d69f4e9d1202b4243133b27f2aada4eecff2604d180e11"} {"question" "e-14617" "field" nil "attribute" "question/worked-solution" "value" "First, we find the scalar projection as follows:\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =|\\,a\\,|\\operatorname{cos}⁡\\theta  \\\\  & =8\\operatorname{cos}⁡(\\frac{5\\pi }{6}) \\\\  & =8\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-4\\sqrt{3}\\end{aligned}\n$$\n\nNow, we find the unit vector that is parallel to $\\mathbf{b}\\mathbin{:}$\n\n$$\n\\mathbf{u} = \\dfrac{\\mathbf{b}}{|\\,\\mathbf{b}\\,|} = \\dfrac{\\mathbf{b}}{4} = \\dfrac{1}{4} \\mathbf{b}\n$$\n\nFinally, we compute the vector projection as follows:\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & ={\\text{comp}}_{b}\\,a\\cdot u \\\\  & =-4\\sqrt{3}\\cdot \\frac{1}{4}b \\\\  & =-\\sqrt{3}b\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/example-14617.json" "file_sha256" "30be1ea4742c2a9b56d69f4e9d1202b4243133b27f2aada4eecff2604d180e11"} {"question" "e-14618" "field" nil "attribute" "question/problem" "value" "Let $\\mathbf{a}=\\langle 1,-3,5 \\rangle$ and $\\mathbf{b}=\\langle 5,-4,0 \\rangle$. Find the vector projection of $\\mathbf{a}$ onto $\\mathbf{b}$." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/example-14618.json" "file_sha256" "5f5032ef211ceda58bbeb79457b0d1d9e318912efa965314806c0a296e91068f"} {"question" "e-14618" "field" nil "attribute" "question/worked-solution" "value" "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{1\\cdot 5+(-3)\\cdot (-4)+5\\cdot 0}{{5}^{2}+(-4)^{2}+{0}^{2}}b \\\\  & =\\frac{17}{41}⟨5,-4,0⟩ \\\\  & =⟨\\frac{85}{41},-\\frac{68}{41},0⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/example-14618.json" "file_sha256" "5f5032ef211ceda58bbeb79457b0d1d9e318912efa965314806c0a296e91068f"} {"question" "e-14619" "field" nil "attribute" "question/problem" "value" "Let ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/assets/e199e48633dbaeeb817da846163a9c8a9bf1ae3355c69b56461b25a13ef73406.png) and ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/assets/4ce6e454ff96976ddeb735d1ab42562fe3b7eb16f16e7c0402d8040f9586907b.png). Find the vector projection of $\\mathbf{a}$ onto $\\mathbf{b}$." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/example-14619.json" "file_sha256" "b8679ce99c698623faf362e31cb811ad3e8caa95c9dbac047a1822592dfcfde7"} {"question" "e-14619" "field" nil "attribute" "question/worked-solution" "value" "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{1\\cdot 1+0\\cdot 5+1\\cdot (-1)}{{1}^{2}+{5}^{2}+(-1)^{2}}b \\\\  & =\\frac{0}{{1}^{2}+{5}^{2}+(-1)^{2}}b \\\\  & =⟨0,0,0⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046753/example-14619.json" "file_sha256" "b8679ce99c698623faf362e31cb811ad3e8caa95c9dbac047a1822592dfcfde7"}] "usage" {"q-19211" [] "q-275237" [] "e-14618" [] "q-71668" [] "q-275230" [] "q-18377" [] "e-14619" [] "q-71838" [] "e-14617" []} "basis" 1688 "retractions" [[17592186105403 :question/problem "Let $[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}]$ and $[\\begin{aligned}1 \\\\ 5 \\\\ -1\\end{aligned}]$. Find the vector projection of $\\mathbf{a}$ onto $\\mathbf{b}$."]] "immutable_answers" [17592186104958 17592186104959 17592186104960 17592186104961 17592186104962 17592186278140 17592186278141 17592186278142 17592186278143 17592186278144 17592186278172 17592186278173 17592186278175 17592186278177 17592186278194 17592186278195 17592186278219 17592186278220 17592186278221 17592186278222 17592186278223 17592186285223 17592186285224 17592186285225 17592186285226 17592186285227] "immutable_fields" [[17592186104957 :answer-field/correct] [17592186104957 :answer-field/id] [17592186104957 :answer-field/key] [17592186104957 :answer-field/type] [17592186278139 :answer-field/correct] [17592186278139 :answer-field/id] [17592186278139 :answer-field/key] [17592186278139 :answer-field/type] [17592186278171 :answer-field/correct] [17592186278171 :answer-field/id] [17592186278171 :answer-field/key] [17592186278171 :answer-field/type] [17592186278174 :answer-field/correct] [17592186278174 :answer-field/id] [17592186278174 :answer-field/key] [1759