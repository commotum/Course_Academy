& 4 & 0 \\\\ 0 & 0 & 9\\end{aligned}][\\begin{aligned}1 & 2 \\\\ 0 & 1 \\\\ -2 & -1\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}1 & 0 & -2 \\\\ 2 & 1 & -1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 9\\end{aligned}][\\begin{aligned}1 \\\\ 0 \\\\ -3\\end{aligned}] \\\\ [\\begin{aligned}1 & 0 & -2 \\\\ 2 & 1 & -1\\end{aligned}][\\begin{aligned}1 & 2 \\\\ 0 & 4 \\\\ -18 & -9\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}1 & 0 & -2 \\\\ 2 & 1 & -1\\end{aligned}][\\begin{aligned}1 \\\\ 0 \\\\ -27\\end{aligned}] \\\\ [\\begin{aligned}37 & 20 \\\\ 20 & 17\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}55 \\\\ 29\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=37+17+55=109.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-137878/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "af51b0b6-4ae7-5b6a-b151-7f8cb88fa186"] :knowledge-point/questions ["q-137878"] :db/ensure [:knowledge-point/validate]} {:db/id "q-137881/selection/cc5dbf87f4dbee91d1c29e8013069443539b3fd684157fee71e97221215a4d5e" :answer/id #uuid "19b1482d-fd12-5aec-bf57-e707e766ec10" :answer/type :answer.type/math :answer/value "83" :db/ensure [:answer/validate]} {:db/id "q-137881/selection/ae88b0e4e39efaf2d30ebd55cc98cb3ed5733c3f224b932ff48a4224b22ca5a1" :answer/id #uuid "4bc73d21-8069-5e85-8cec-38866ad18749" :answer/type :answer.type/math :answer/value "125" :db/ensure [:answer/validate]} {:db/id "q-137881/selection/a4c8bdda186d0d425e9963bf17967cd5e356d934f319fa58135b8f8cf8a589f8" :answer/id #uuid "17e1673a-d441-56d4-8ea4-b52019e1daae" :answer/type :answer.type/math :answer/value "30" :db/ensure [:answer/validate]} {:db/id "q-137881/selection/f24a396ca9fce46c29b2cad889652b874f88f6dd420d6dcea0e48da0d3e8f82d" :answer/id #uuid "42b790ee-14f1-53d9-bbfb-1e84e59a5936" :answer/type :answer.type