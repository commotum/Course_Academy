 & 0\\end{aligned}][\\begin{aligned}4 & 0 \\\\ 1 & 1 \\\\ -4 & 0\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}1 & 1 & -1 \\\\ 0 & 1 & 0\\end{aligned}][\\begin{aligned}4 \\\\ 4 \\\\ 20\\end{aligned}] \\\\ [\\begin{aligned}9 & 1 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}-12 \\\\ 4\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=9+1-12=-2.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-137880/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "af51b0b6-4ae7-5b6a-b151-7f8cb88fa186"] :knowledge-point/questions ["q-137880"] :db/ensure [:knowledge-point/validate]} {:db/id "q-137878/selection/4a03be6ca5a931097242157323e96fac707848be6f9e14b789a4470740e06647" :answer/id #uuid "576d42f3-091c-56b2-8162-f429a39dd494" :answer/type :answer.type/math :answer/value "121" :db/ensure [:answer/validate]} {:db/id "q-137878/selection/39a5ce6df648355b801d1b8ecb4c5f4f609af8f07bae4fac68affda9cbedd111" :answer/id #uuid "56f63858-c6b9-5771-a8c3-69e759edb911" :answer/type :answer.type/math :answer/value "145" :db/ensure [:answer/validate]} {:db/id "q-137878/selection/687ba219d8c9b2fa04add76a6cff5858a48aea851ffa07746ca60b9a04b7f2d1" :answer/id #uuid "233e255b-0fb1-5394-a919-ae4be7a2f3f7" :answer/type :answer.type/math :answer/value "109" :db/ensure [:answer/validate]} {:db/id "q-137878/selection/71ec7720d7077a8c88c1c4a9c53a3f81078793450c23aec02efcc43f1fc689b6" :answer/id #uuid "284234ec-324a-5ea2-963a-bdf420bfbfec" :answer/type :answer.type/math :answer/value "82" :db/ensure [:answer/validate]} {:db/id "q-137878/selection/913c59b7a35c2e4d81c174e7557b24de384ebd0f1742751d1a44f680a9e9c682" :answer/id #uuid "883ba6a5-abb9-5c1b-a38a-6cb25cc2eff6" :answer/type :answer.type/math :answer/value "73" :db/ensure [:answer/validate]} {:db/id "q-137878/selection" :answer-field/id #uuid "dc064fcd-25f0-5407-8337-f9dccff7fdb0" :answer