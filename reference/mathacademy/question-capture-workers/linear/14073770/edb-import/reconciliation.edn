\\end{aligned}] \\\\ [\\begin{aligned}1 & -1 & -1 \\\\ 3 & 1 & 0\\end{aligned}][\\begin{aligned}9 & 27 \\\\ -4 & 4 \\\\ -4 & 0\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}1 & -1 & -1 \\\\ 3 & 1 & 0\\end{aligned}][\\begin{aligned}9 \\\\ -4 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}17 & 23 \\\\ 23 & 85\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}13 \\\\ 23\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=17+85+13=115.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14073770/state.json" "file_sha256" "0100180f1c8e9bf86ca27d2d8d13f44acb386c03cf1b9cf000429bcefd5e370c"} {"question" "q-137881" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14073770/activity-metadata.json" "file_sha256" "557c85c44ab4f4a5c9e6fd9aff7bd7ea4eb3fa6b21ed701e6ca8762b6b287ce2"} {"question" "q-137881" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14073770/state.json" "file_sha256" "0100180f1c8e9bf86ca27d2d8d13f44acb386c03cf1b9cf000429bcefd5e370c"} {"question" "q-137881" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "115"] ["math" "125"] ["math" "155"] ["math" "30"] ["math" "83"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14073770/state.json" "file_sha256" "0100180f1c8e9bf86ca27d2d8d13f44acb386c03cf1b9cf000429bcefd5e370c"} {"question" "q-137881" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "115"] "category" "model_interpretation" "file" "/home/jake/Developer/C