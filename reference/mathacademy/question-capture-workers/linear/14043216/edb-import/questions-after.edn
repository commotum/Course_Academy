#{[{:db/id #edb/ref 17592186100601 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "ff414112-3be2-5b9c-9ded-5025ea05c2b4" :knowledge-point/title "Multiplying a 2x2 Matrix by a Column Vector"}] :question/id #uuid "f31d614e-a00c-5502-8b23-e9214bc2ae5c" :question/math-academy-id "e-4397" :question/problem "Find $A\\mathbf{x}$ if \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043216/assets/cd3816d9938d4bd65d0eaa5abcb3db329aed3827219a8cea0186ced2d5759880.png)\nand\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043216/assets/b9c909115c604eb1a96463bdd31a71e77caa0a11d0098a8144afd798b50ae236.png)" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product. Multiplying the first row, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}1 & 3 \\\\ 7 & -2\\end{aligned}][\\begin{aligned}2 \\\\ 5\\end{aligned}] & =[\\begin{aligned}1\\cdot 2+3\\cdot 5 \\\\ ∗\\end{aligned}]=[\\begin{aligned}17 \\\\ ∗\\end{aligned}].\\end{aligned}\n$$\n\nMultiplying the second row, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}1 & 3 \\\\ 7 & -2\\end{aligned}][\\begin{aligned}2 \\\\ 5\\end{aligned}] & =[\\begin{aligned}17 \\\\ 7\\cdot 2+(-2)\\cdot 5\\end{aligned}]=[\\begin{aligned}17 \\\\ 4\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043216/assets/6d470181fba760868835a72c5d5cfec3c90f9bf7bf7a9d86860dc8d981517652.png)"}] [{:db/id #edb/ref 17592186100602 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "3beceaa9-f8b5-5b98-a4a3-2ececba067e0" :knowledge-point/title "Multiplying a 3x3 Matrix by a Column Vector"}] :question/id #uuid "63f6d2d5-0654-569f-bd71-437c835a49d3" :question/math-academy-id "e-4398" :question/problem "Find $A\\mathbf{x}$ if \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043216/assets/1c38a037a66a5f86fd38a2b9ea6226420e455d5ef66fe776af7548fb6724841f.png)\nand\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043216/assets/ffec9e0757e75cad35bbec65fb15d07eb580274c8beb4a9b3337d31cf964ec1c.png)" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product:\n\n$$\n\\begin{aligned}Ax & =[\\begin{aligned}-3 & 1 & 1 \\\\ 2 & 0 & 0 \\\\ -1 & -2 & 5\\end{aligned}][\\begin{aligned}1 \\\\ -2 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}(-3)\\cdot 1+1\\cdot (-2)+1\\cdot 0 \\\\ 2\\cdot 1+0\\cdot (-2)+0\\cdot 0 \\\\ (-1)\\cdot 1+(-2)\\cdot (-2)+5\\cdot 0\\end{aligned}] \\\\  & =[\\begin{aligned}-3-2+0 \\\\ 2+0+0 \\\\ -1+4+0\\end{aligned}] \\\\  & =[\\begin{aligned}-5 \\\\ 2 \\\\ 3\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186100603 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "8451e22a-247e-51dd-8fb1-9ce9b212dc65" :knowledge-point/title "Multiplying a Matrix With Variable Entries by a Column Vector"}] :question/id #uuid "c154ead3-0974-5e0d-9653-38c20756921e" :question/math-academy-id "e-4399" :question/problem "Find $A\\mathbf{x}$ if \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043216/assets/528d30567626c47a051ea97c39cfe64a6bb4538d54b8a355d004457eca98d106.png)\nand\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043216/assets/e7fe9e8a74f76dfec4fd92313fe84650f6006e3c54795fb06e3a255e4dbe8296.png)" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product:\n\n$$\n\\begin{aligned}Ax & =[\\begin{aligned}a & c \\\\ b & d\\end{aligned}][\\begin{aligned}3 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}a\\cdot 3+c\\cdot 2 \\\\ b\\cdot 3+d\\cdot 2\\end{aligned}] \\\\  & =[\\begin{aligned}3a+2c \\\\ 3b+2d\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186319195 :knowledge-point/_questions [{:knowledge-point/id #uuid "3beceaa9-f8b5-5b98-a4a3-2ececba067e0" :knowledge-point/title "Multiplying a 3x3 Matrix by a Column Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a3d6f64-7cea-5e21-8935-94f46049d14e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ 5 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186319197} {:answer/id #uuid "5864436b-455b-5352-8640-5acf5ad002d0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ 5 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186319198} {:answer/id #uuid "8a85df0c-20b4-5c12-be6e-a7a06de99ad0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ -5 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186319199} {:answer/id #uuid "38aab1de-797b-5ff2-b014-9fd17513f6de" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ -5 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186319200} {:answer/id #uuid "54076779-1ab7-54e5-86e7-1e47b068db05" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ 4 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186319201}] :answer-field/correct {:answer/id #uuid "38aab1de-797b-5ff2-b014-9fd17513f6de" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ -5 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186319200} :answer-field/id #uuid "68636e60-48b0-54a9-95af-e7b3c46baf19" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186319196}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f88b2b26-7dc0-54fe-bbbe-4d27600aa674" :question/math-academy-id "q-127267" :question/problem "$[\\begin{aligned}6 & -4 & -6 \\\\ -2 & 5 & 2 \\\\ -1 & -4 & 1\\end{aligned}][\\begin{aligned}2 \\\\ -1 \\\\ 2\\end{aligned}]=$" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product:\n\n$$\n\\begin{aligned}[\\begin{aligned}6 & -4 & -6 \\\\ -2 & 5 & 2 \\\\ -1 & -4 & 1\\end{aligned}][\\begin{aligned}2 \\\\ -1 \\\\ 2\\end{aligned}] & =[\\begin{aligned}6\\cdot 2+(-4)\\cdot (-1)+(-6)\\cdot 2 \\\\ (-2)\\cdot 2+5\\cdot (-1)+2\\cdot 2 \\\\ (-1)\\cdot 2+(-4)\\cdot (-1)+1\\cdot 2\\end{aligned}] \\\\  & =[\\begin{aligned}12+4-12 \\\\ -4-5+4 \\\\ -2+4+2\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ -5 \\\\ 4\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186319202 :knowledge-point/_questions [{:knowledge-point/id #uuid "8451e22a-247e-51dd-8fb1-9ce9b212dc65" :knowledge-point/title "Multiplying a Matrix With Variable Entries by a Column Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd986420-8abe-59de-99f7-4f1d00444cf8" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}{s}^{2}+{t}^{2} \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186319204} {:answer/id #uuid "56a2338f-4551-5dd3-b0cd-69b50a47cc77" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}(s+t)^{2} \\\\ -2st\\end{aligned}]" :db/id #edb/ref 17592186319205} {:answer/id #uuid "e4ac6d40-5d8d-5e88-a5b5-6ce4438e4ae2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}{s}^{2}+{t}^{2} \\\\ -2st\\end{aligned}]" :db/id #edb/ref 17592186319206} {:answer/id #uuid "534f69f7-ad36-5ad6-a01d-763a317e5922" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}(s-t)^{2} \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186319207} {:answer/id #uuid "66fb90d9-06a4-5a8c-ab42-24d2a6f91d25" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}(s+t)^{2} \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186319208}] :answer-field/correct {:answer/id #uuid "cd986420-8abe-59de-99f7-4f1d00444cf8" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}{s}^{2}+{t}^{2} \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186319204} :answer