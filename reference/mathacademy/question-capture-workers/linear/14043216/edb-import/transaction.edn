p \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}\\begin{aligned}m\\cdot 1 & + & \\,\\,\\,\\,\\,\\,\\,n\\cdot p & + & (-m)\\cdot 1 \\\\ m\\cdot 1 & + & (-n)\\cdot p & + & (-m)\\cdot 1 \\\\ 0\\cdot 1 & + & \\,\\,\\,\\,\\,\\,\\,2\\cdot p & + & \\,\\,\\,\\,\\,\\,\\,\\,\\,0\\cdot 1\\end{aligned}\\end{aligned}] \\\\  & =[\\begin{aligned}\\begin{aligned}m & + & \\,\\,\\,\\,\\,np & + & (-m) \\\\ m & + & (-np) & + & (-m) \\\\ 0 & + & \\,\\,\\,\\,\\,2p & + & 0\\end{aligned}\\end{aligned}] \\\\  & =[\\begin{aligned}np \\\\ -np \\\\ 2p\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-318591/field-1" "q-318591/field-2" "q-318591/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8451e22a-247e-51dd-8fb1-9ce9b212dc65"] :knowledge-point/questions ["q-318591"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127276/selection/174abc3fc98c3c82385e21be90b10a30ce229e31619765d650c5d784b5a245ff" :answer/id #uuid "cd986420-8abe-59de-99f7-4f1d00444cf8" :answer/type :answer.type/math :answer/value "[\\begin{aligned}{s}^{2}+{t}^{2} \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-127276/selection/8b34f88de6150219c001e48e8c7d2a9ef3a754a80b1ab9dc8b4137c465cc8ae6" :answer/id #uuid "e4ac6d40-5d8d-5e88-a5b5-6ce4438e4ae2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}{s}^{2}+{t}^{2} \\\\ -2st\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-127276/selection/73097cd37e36cb7fe0c5c01ca6c9f9068cde0ad94539d6edcf4ff521bafa5b73" :answer/id #uuid "56a2338f-4551-5dd3-b0cd-69b50a47cc77" :answer/type :answer.type/math :answer/value "[\\begin{aligned}(s+t)^{2} \\\\ -2st\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-127276/selection/b035d18d0622d7767c4ed0d4e9234814d2737094247b3a077c35cbaf89eb04ad" :answer/id #uuid "534f69f7-ad36-5ad6-a01d-763a317e5922" :answer/type :answer.type/math :answer/value "[\\begin{aligned}(s-t)^{2} \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-127276/selection/fd651082827e5371edb1840773ad635154279f48f73731243dd11c647c164e25" :answer/id #uuid "66fb90d9-06a4-5a8c-ab42-24d2a6f91d25" :answer/type :answer.type/math :answer/value "[\\begin{aligned}(s+t)^{2} \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-127276/selection" :answer-field/id #uuid "faf81404-da0c-515b-ab1e-fbcea83ed9b5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127276/selection/174abc3fc98c3c82385e21be90b10a30ce229e31619765d650c5d784b5a245ff" :answer-field/choices ["q-127276/selection/174abc3fc98c3c82385e21be90b10a30ce229e31619765d650c5d784b5a245ff" "q-127276/selection/8b34f88de6150219c001e48e8c7d2a9ef3a754a80b1ab9dc8b4137c465cc8ae6" "q-127276/selection/73097cd37e36cb7fe0c5c01ca6c9f9068cde0ad94539d6edcf4ff521bafa5b73" "q-127276/selection/b035d18d0622d7767c4ed0d4e9234814d2737094247b3a077c35cbaf89eb04ad" "q-127276/selection/fd651082827e5371edb1840773ad635154279f48f73731243dd11c647c164e25"] :db/ensure [:answer-field/validate]} {:db/id "q-127276" :question/id #uuid "ccbe8fc3-4928-550d-9920-5510d909134a" :question/math-academy-id "q-127276" :question/problem "Find $Mz$ if \n$M=[\\begin{aligned}s & t \\\\ -t & s\\end{aligned}]$\nand\n$z=[\\begin{aligned}s \\\\ t\\end{aligned}].$" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product:\n\n$$\n\\begin{aligned}Mz & =[\\begin{aligned}s & t \\\\ -t & s\\end{aligned}][\\begin{aligned}s \\\\ t\\end{aligned}] \\\\  & =[\\begin{aligned}s\\cdot s+t\\cdot t \\\\ (-t)\\cdot s+s\\cdot t\\end{aligned}] \\\\  & =[\\begin{aligned}{s}^{2}+{t}^{2} \\\\ -st+st\\end{aligned}] \\\\  & =[\\begin{aligned}{s}^{2}+{t}^{2} \\\\ 0\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-127276/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8451e22a-247e-51dd-8fb1-9ce9b212dc65"] :knowledge-point/ques