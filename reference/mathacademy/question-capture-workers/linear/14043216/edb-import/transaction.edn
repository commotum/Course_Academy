gned}].\\end{aligned}\n$$\n\nTherefore, \n\n$$\n[\\begin{aligned}-7 & 3 \\\\ 5 & 8\\end{aligned}][\\begin{aligned}4 \\\\ -2\\end{aligned}]=[\\begin{aligned}-34 \\\\ 4\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-318644/field-1" "q-318644/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ff414112-3be2-5b9c-9ded-5025ea05c2b4"] :knowledge-point/questions ["q-318644"] :db/ensure [:knowledge-point/validate]} {:db/id "q-318640/field-1/23c0b4da815e7ba954fedc5e75955047cfe471feec4d2029849a63511c000fa3" :answer/id #uuid "de3d2a62-6e83-5ff2-87aa-5e623fbe9e5e" :answer/type :answer.type/math :answer/value "-11" :db/ensure [:answer/validate]} {:db/id "q-318640/field-1" :answer-field/id #uuid "38b7e313-79b7-53e9-b7e2-fd4ab711f6e1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-318640/field-1/23c0b4da815e7ba954fedc5e75955047cfe471feec4d2029849a63511c000fa3" :answer-field/choices ["q-318640/field-1/23c0b4da815e7ba954fedc5e75955047cfe471feec4d2029849a63511c000fa3"] :db/ensure [:answer-field/validate]} {:db/id "q-318640/field-2/c5b1c452fbbf695d51774e4fdb54a1ea7a83bfb5edb76e399d7d1b89ecc5113e" :answer/id #uuid "df72e57f-bf5d-5f76-8b52-6dfa5518161f" :answer/type :answer.type/math :answer/value "-17" :db/ensure [:answer/validate]} {:db/id "q-318640/field-2" :answer-field/id #uuid "4f3b38d0-d710-59f7-a114-18daa1818de0" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-318640/field-2/c5b1c452fbbf695d51774e4fdb54a1ea7a83bfb5edb76e399d7d1b89ecc5113e" :answer-field/choices ["q-318640/field-2/c5b1c452fbbf695d51774e4fdb54a1ea7a83bfb5edb76e399d7d1b89ecc5113e"] :db/ensure [:answer-field/validate]} {:db/id "q-318640" :question/id #uuid "dec0f35c-825a-5669-beb7-93e7a8c7fcf9" :question/math-academy-id "q-318640" :question/problem "Compute the following:\n\n| $[\\begin{aligned}0 & 11 \\\\ -3 & 2\\end{aligned}][\\begin{aligned}