question/id #uuid "d70010f2-06ac-5b1d-b481-c54b60a5a0f3" :question/math-academy-id "q-70188" :question/problem "Find $By$ if \n$B=[\\begin{aligned}2 & 1 & 1 \\\\ -3 & 2 & -1 \\\\ 4 & 0 & -3\\end{aligned}]$\nand\n$y=[\\begin{aligned}6 \\\\ -3 \\\\ 1\\end{aligned}].$" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product:\n\n$$\n\\begin{aligned}By & =[\\begin{aligned}2 & 1 & 1 \\\\ -3 & 2 & -1 \\\\ 4 & 0 & -3\\end{aligned}][\\begin{aligned}6 \\\\ -3 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}2\\cdot 6+1\\cdot (-3)+1\\cdot 1 \\\\ (-3)\\cdot 6+2\\cdot (-3)+(-1)\\cdot 1 \\\\ 4\\cdot 6+0\\cdot (-3)+(-3)\\cdot 1\\end{aligned}] \\\\  & =[\\begin{aligned}12-3+1 \\\\ -18-6-1 \\\\ 24-0-3\\end{aligned}] \\\\  & =[\\begin{aligned}10 \\\\ -25 \\\\ 21\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-70188/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3beceaa9-f8b5-5b98-a4a3-2ececba067e0"] :knowledge-point/questions ["q-70188"] :db/ensure [:knowledge-point/validate]} {:db/id "q-318591/field-1/273a67e3ab432efda8643c1406f78c6dcee373eb062241e95464326169369bdc" :answer/id #uuid "3955d2a9-6b4e-5d7e-acbc-993642990f79" :answer/type :answer.type/math :answer/value "np" :db/ensure [:answer/validate]} {:db/id "q-318591/field-1/7f496e8b724a92b4763104ef0fd40819fddeb7c4700de11ed67a217617af8dd5" :answer/id #uuid "98c21fb1-4e4a-5afb-829f-84aeb26b8244" :answer/type :answer.type/math :answer/value "np+1" :db/ensure [:answer/validate]} {:db/id "q-318591/field-1" :answer-field/id #uuid "ee107b94-8d17-56a6-97a5-4cb8c9c88934" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-318591/field-1/273a67e3ab432efda8643c1406f78c6dcee373eb062241e95464326169369bdc" :answer-field/choices ["q-318591/field-1/273a67e3ab432efda8643c1406f78c6dcee373eb062241e95464326169369bdc" "q-318591/field-1/7f496e8b724a92b4763104ef0fd