answer-field/type :answer-field.type/blank :answer-field/correct "q-275597/field-3/cd51e080132e97dda2ee90111bf8a5225e14a649b597f69e5ae01ec2f25ba5cd" :answer-field/choices ["q-275597/field-3/cd51e080132e97dda2ee90111bf8a5225e14a649b597f69e5ae01ec2f25ba5cd"] :db/ensure [:answer-field/validate]} {:db/id "q-275597" :question/id #uuid "cb122a6a-89e7-5af1-b07b-6155840977eb" :question/math-academy-id "q-275597" :question/problem "If \n$Q=[\\begin{aligned}a & b & a \\\\ a & -b & a \\\\ 0 & 0 & a\\end{aligned}]$\nand\n$r=[\\begin{aligned}a \\\\ 0 \\\\ -a\\end{aligned}],$\nfind $Qr.$\n\n|  |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n| $Qr=\\,\\,$ |  | {{field-2}} |  |\n|  |  | {{field-3}} |  |" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product:\n\n$$\n\\begin{aligned}Qr & =[\\begin{aligned}a & b & a \\\\ a & -b & a \\\\ 0 & 0 & a\\end{aligned}][\\begin{aligned}a \\\\ 0 \\\\ -a\\end{aligned}] \\\\  & =[\\begin{aligned}\\begin{aligned}a\\cdot a & + & \\,\\,\\,\\,\\,\\,\\,b\\cdot 0 & + & a\\cdot (-a) \\\\ a\\cdot a & + & (-b)\\cdot 0 & + & a\\cdot (-a) \\\\ 0\\cdot a & + & \\,\\,\\,\\,\\,\\,\\,0\\cdot 0 & + & a\\cdot (-a)\\end{aligned}\\end{aligned}] \\\\  & =[\\begin{aligned}\\begin{aligned}{a}^{2} & + & 0 & + & (-{a}^{2}) \\\\ {a}^{2} & + & 0 & + & (-{a}^{2}) \\\\ 0 & + & 0 & + & (-{a}^{2})\\end{aligned}\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 0 \\\\ -{a}^{2}\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-275597/field-1" "q-275597/field-2" "q-275597/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8451e22a-247e-51dd-8fb1-9ce9b212dc65"] :knowledge-point/questions ["q-275597"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70226/selection/d48068dbd41b316f7a3ac562e81f24ee1630fbba54d1862014c16b8039275504" :answer/id #uuid "cdc7e834-2609-526a-ae49-1f8fcd096391" :answer/type :answer.type/math :answer/value "[\\begin{aligned}{x}^{3}y \\\\ 0 \\\\ -{x}^{3}y\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-70226/selection/052a5abc4a82410a933a7c7e83e8836550992cf98962d2dc0f70594ddd5e78ac" :answer/id #uuid "26d539a7-b4d5-5439-97ce-c5420216c09b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}{x}^{2} \\\\ -{x}^{2} \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-70226/selection/8b1ccc8ecb7e4b99c9bb64513ae1df977d87bad7c044931562752050352591c5" :answer/id #uuid "0bbd04a4-daa1-53f3-8596-0ce70e270249" :answer/type :answer.type/math :answer/value "[\\begin{aligned}{x}^{2} \\\\ 0 \\\\ -{x}^{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-70226/selection/21c88174a5d6324c3bcf6728321766bdbc9d306a2199dde06925f72305a57b69" :answer/id #uuid "034759ff-8034-534b-93e5-3362a92bb16e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}{x}^{2}y \\\\ 0 \\\\ -{x}^{2}y\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-70226/selection/6befce09e0e11b708510b6710298f64a84bb6c545fcd396ecd134ddff5016ae4" :answer/id #uuid "fa0080e4-f9da-5dcf-915b-24930da85c4c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 \\\\ 0 \\\\ -2{x}^{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-70226/selection" :answer-field/id #uuid "35aad51f-e16b-560a-99e3-0d174a9e401d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-70226/selection/6befce09e0e11b708510b6710298f64a84bb6c545fcd396ecd134ddff5016ae4" :answer-field/choices ["q-70226/selection/d48068dbd41b316f7a3ac562e81f24ee1630fbba54d1862014c16b8039275504" "q-70226/selection/052a5abc4a82410a933a7c7e83e8836550992cf98962d2dc0f70594ddd5e78ac" "q-70226/selection/8b1ccc8ecb7e4b99c9bb64513ae1df977d87bad7c044931562752050352591c5" "q-70226/selection/21c88174a5d6324c3bcf6728321766bdbc9d306a2199dde06925f72305a57b69" "q-70226/selection/6befce09e0e11b708510b6710298f64a84bb6c545fcd396ecd134ddff5016ae4"] :db/ensure [:answer-field/validate]} {:db/id "q-70226" :question/id #uuid "554061dc-4e19-5b4c-8f98-8b4ce4730da9" :question/math-academy-id "q-70226" :question/problem "Find $Tu$ if \n$T=[\\begin{aligned}x & y & x \\\\ x & -y & x \\\\ -x & -y & x\\end{aligned}]$\nand\n$u=[\\begin{aligned}x \\\\ 0 \\\\ -x\\end{aligned}].$" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product:\n\n$$\n\\begin{aligned}Tu & =[\\begin{aligned}x & y & x \\\\ x & -y & x \\\\ -x & -y & x\\end{aligned}][\\begin{aligned}x \\\\ 0 \\\\ -x\\end{aligned}] \\\\  & =[\\begin{aligned}x\\cdot x+y\\cdot 0+x\\cdot (-x) \\\\ x\\cdot x+(-y)\\cdot 0+x\\cdot (-x) \\\\ (-x)\\cdot x+(-y)\\cdot 0+x\\cdot (-x)\\end{aligned}] \\\\  & =[\\begin{aligned}{x}^{2}+0-{x}^{2} \\\\ {x}^{2}+0-{x}^{2} \\\\ -{x}^{2}+0-{x}^{2}\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 0 \\\\ -2{x}^{2}\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-70226/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8451e22a-247e-51dd-8fb1-9ce9b212dc65"] :knowledge-point/questions ["q-70226"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-4397"] :question/problem "Find $A\\mathbf{x}$ if \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043216/assets/cd3816d9938d4bd65d0eaa5abcb3db329aed3827219a8cea0186ced2d5759880.png)\nand\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043216/assets/b9c909115c604eb1a96463bdd31a71e77caa0a11d0098a8144afd798b50ae236.png)" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product. Multiplying the first row, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}1 & 3 \\\\ 7 & -2\\end{aligned}][\\begin{aligned}2 \\\\ 5\\end{aligned}] & =[\\begin{aligned}1\\cdot 2+3\\cdot 5 \\\\ ∗\\end{aligned}]=[\\begin{aligned}17 \\\\ ∗\\end{aligned}].\\end{aligned}\n$$\n\nMultiplying the second row, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}1 & 3 \\\\ 7 & -2\\end{aligned}][\\begin{aligned}2 \\\\ 5\\end{aligned}] & =[\\begin{aligned}17 \\\\ 7\\cdot 2+(-2)\\cdot 5\\end{aligned}]=[\\begin{aligned}17 \\\\ 4\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043216/assets/6d470181fba760868835a72c5d5cfec3c90f9bf7bf7a9d86860dc8d981517652.png)" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4398"] :question/problem "Find $A\\mathbf{x}$ if \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043216/assets/1c38a037a66a5f86fd38a2b9ea6226420e455d5ef66fe776af7548fb6724841f.png)\nand\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043216/assets/ffec9e0757e75cad35bbec65fb15d07eb580274c8beb4a9b3337d31cf964ec1c.png)" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4399"] :question/problem "Find $A\\mathbf{x}$ if \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043216/assets/528d30567626c47a051ea97c39cfe64a6bb4538d54b8a355d004457eca98d106.png)\nand\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043216/assets/e7fe9e8a74f76dfec4fd92313fe84650f6006e3c54795fb06e3a255e4dbe8296.png)" :db/ensure [:question/validate]}]
