#{[{:db/id #edb/ref 17592186348670 :knowledge-point/_questions [{:knowledge-point/id #uuid "733eab11-2a26-5402-8df5-bba50c9beaf9" :knowledge-point/title "Calculating the Cross Product Using Determinants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc1295d6-b73a-54af-993e-65d79d4f7be8" :answer/type {:db/ident :answer.type/math} :answer/value "2i-11k" :db/id #edb/ref 17592186348672} {:answer/id #uuid "f45aa475-1f0d-5466-a280-d5f4515a6c07" :answer/type {:db/ident :answer.type/math} :answer/value "2i-11j+3k" :db/id #edb/ref 17592186348673} {:answer/id #uuid "87f4a9da-d670-5548-8de3-3731a8f934a0" :answer/type {:db/ident :answer.type/math} :answer/value "2i+3k" :db/id #edb/ref 17592186348674} {:answer/id #uuid "4c280daa-d711-5a22-be18-23769f14a9ae" :answer/type {:db/ident :answer.type/math} :answer/value "7i-11j+3k" :db/id #edb/ref 17592186348675} {:answer/id #uuid "81f3ea0f-8e86-5379-a4ff-f7c27d44191e" :answer/type {:db/ident :answer.type/math} :answer/value "2i+11j-5k" :db/id #edb/ref 17592186348676}] :answer-field/correct {:answer/id #uuid "f45aa475-1f0d-5466-a280-d5f4515a6c07" :answer/type {:db/ident :answer.type/math} :answer/value "2i-11j+3k" :db/id #edb/ref 17592186348673} :answer-field/id #uuid "0fc2bd0f-4423-520e-978d-b504a808bdde" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186348671}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "427de437-0817-5025-a19d-93d24fc75213" :question/math-academy-id "q-1406" :question/problem "Let $u=3i-2k$ and $v=-2i+j+5k.$ Determine $u\\times v.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =|\\begin{aligned}i & j & k \\\\ 3 & 0 & -2 \\\\ -2 & 1 & 5\\end{aligned}| \\\\  & =|\\begin{aligned}0 & -2 \\\\ 1 & 5\\end{aligned}|i-|\\begin{aligned}3 & -2 \\\\ -2 & 5\\end{aligned}|j+|\\begin{aligned}3 & 0 \\\\ -2 & 1\\end{aligned}|k \\\\  & =(0\\cdot 5-(-2)\\cdot 1)i-(3\\cdot 5-(-2)\\cdot (-2))j+(3\\cdot 1-0\\cdot (-2))k \\\\  & =(0+2)i-(15-4)j+(3-0)k \\\\  & =2i-11j+3k.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186303460 :knowledge-point/_questions [{:knowledge-point/id #uuid "733eab11-2a26-5402-8df5-bba50c9beaf9" :knowledge-point/title "Calculating the Cross Product Using Determinants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c084ff9-c7b2-5468-96fa-62c7fc1ff782" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-6,-78,13⟩" :db/id #edb/ref 17592186303462} {:answer/id #uuid "813c003b-ef4c-5693-9b5f-7a04ada2b1bb" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-6,78,-13⟩" :db/id #edb/ref 17592186303463} {:answer/id #uuid "2020b3ba-da42-5e2b-afa8-ba14436030e6" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,78,-13⟩" :db/id #edb/ref 17592186303464} {:answer/id #uuid "fd7908e0-f75a-5388-a30b-8a5006b8643f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-6,0,-13⟩" :db/id #edb/ref 17592186303465} {:answer/id #uuid "5703efa3-065b-5370-8e96-92e7b4faf301" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,78,13⟩" :db/id #edb/ref 17592186303466}] :answer-field/correct {:answer/id #uuid "2020b3ba-da42-5e2b-afa8-ba14436030e6" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,78,-13⟩" :db/id #edb/ref 17592186303464} :answer-field/id #uuid "3f95e987-f817-53b2-9aea-39e647ca85ca" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186303461}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "0862516a-638f-50dc-ae6f-b2e60f0dfa5a" :question/math-academy-id "q-1407" :question/problem "Let $a=⟨0,1,6⟩$ and $b=⟨13,0,0⟩.$ Find $a\\times b.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 0 & 1 & 6 \\\\ 13 & 0 & 0\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 6 \\\\ 0 & 0\\end{aligned}|i-|\\begin{aligned}0 & 6 \\\\ 13 & 0\\end{aligned}|j+|\\begin{aligned}0 & 1 \\\\ 13 & 0\\end{aligned}|k \\\\  & =(1\\cdot 0-6\\cdot 0)i-(0\\cdot 0-6\\cdot 13)j+(0\\cdot 0-1\\cdot 13)k \\\\  & =(0-0)i-(0-78)j+(0-13)k \\\\  & =78j-13k.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186060115 :knowledge-point/_questions [{:knowledge-point/id #uuid "21cef8c9-92ff-5527-a837-2236a0c1f9eb" :knowledge-point/title "Solving for an Unknown in an Equation Involving the Cross Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f01b26e-108c-56e7-b70d-4fa7a7c0c164" :answer/type {:db/ident :answer.type/math} :answer/value "x =-\\frac{4}{3}" :db/id #edb/ref 17592186057512} {:answer/id #uuid "41535d87-c55f-590b-8f9c-f9e1c8f92305" :answer/type {:db/ident :answer.type/math} :answer/value "x = \\pm  \\frac{4}{3}" :db/id #edb/ref 17592186057513} {:answer/id #uuid "537a5000-1bee-5860-b209-311ab5e4499a" :answer/type {:db/ident :answer.type/math} :answer/value "x = \\frac{4}{3}" :db/id #edb/ref 17592186057514} {:answer/id #uuid "72733327-2767-5fe5-8392-5ad2a4937514" :answer/type {:db/ident :answer.type/math} :answer/value "x = \\frac{3}{4}" :db/id #edb/ref 17592186057515} {:answer/id #uuid "7b7ec6bd-9cc4-5377-bad8-87df3e765ddb" :answer/type {:db/ident :answer.type/math} :answer/value "x = \\pm  \\frac{3}{4}" :db/id #edb/ref 17592186057516}] :answer-field/correct {:answer/id #uuid "537a5000-1bee-5860-b209-311ab5e4499a" :answer/type {:db/ident :answer.type/math} :answer/value "x = \\frac{4}{3}" :db/id #edb/ref 17592186057514} :answer-field/id #uuid "ef582bc2-d643-55d9-9375-e78a12c56def" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057511}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "418b906a-1baf-59eb-8935-edc0e9f8b503" :question/math-academy-id "q-19786" :question/problem "Let $a=⟨2x,1,4⟩,$ $b=⟨2,0,3⟩$ and $|\\,a\\times b\\,|=\\sqrt{13}.$ Find $x.$" :question/requires-calculator true :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 2x & 1 & 4 \\\\ 2 & 0 & 3\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 4 \\\\ 0 & 3\\end{aligned}|i-|\\begin{aligned}2x & 4 \\\\ 2 & 3\\end{aligned}|j+|\\begin{aligned}2x & 1 \\\\ 2 & 0\\end{aligned}|k \\\\  & =(3-0)i-(6x-8)j+(0-2)k \\\\  & =⟨3,-(6x-8),-2⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{{3}^{2}+(-(6x-8))^{2}+(-2)^{2}} \\\\  & =\\sqrt{9+36{x}^{2}-96x+64+4} \\\\  & =\\sqrt{36{x}^{2}-96x+77}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{13} \\\\ \\sqrt{36{x}^{2}-96x+77} & =\\sqrt{13} \\\\ 36{x}^{2}-96x+77 & =13 \\\\ 36{x}^{2}-96x+64 & =0 \\\\ 9{x}^{2}-24x+16 & =0 \\\\ (3x-4)^{2} & =0 \\\\ 3x-4 & =0 \\\\ x & =\\frac{4}{3}.\\end{aligned}\n$$\n\nTherefore, the solution is $x=\\frac{4}{3}.$"}] [{:db/id #edb/ref 17592186303494 :knowledge-point/_questions [{:knowledge-point/id #uuid "21cef8c9-92ff-5527-a837-2236a0c1f9eb" :knowledge-point/title "Solving for an Unknown in an Equation Involving the Cross Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c5155a28-22dd-54d9-904d-52eb3db422cf" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186303496} {:answer/id #uuid "d08227f9-7fb9-57e1-b24b-04d7717315df" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186348677}] :answer-field/correct {:answer/id #uuid "c5155a28-22dd-54d9-904d-52eb3db422cf" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186303496} :answer-field/id #uuid "50096657-96ad-5bc8-923d-da3a399564ce" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186303495} {:answer-field/choices [{:answer/id #uuid "8c56013b-cca9-556f-bfe4-7260efbe46bc" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186303498}] :answer-field/correct {:answer/id #uuid "8c56013b-cca9-556f-bfe4-7260efbe46bc" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186303498} :answer-field/id #uuid "4e24a0b4-61de-584c-94ac-928507f054ff" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186303497}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a06a34cd-d85e-589e-9964-4d0cd1f43e22" :question/math-academy-id "q-282262" :question/problem "Let $a=⟨x,3,0⟩,$ $b=⟨-x,0,1⟩$ and $|\\,a\\times b\\,|=\\sqrt{49}.$ Then, in **ascending order**, the possible values of $x$ are\n\n$\\,x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ x & 3 & 0 \\\\ -x & 0 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}3 & 0 \\\\ 0 & 1\\end{aligned}|i-|\\begin{aligned}x & 0 \\\\ -x & 1\\end{aligned}|j+|\\begin{aligned}x & 3 \\\\ -x & 0\\end{aligned}|k \\\\  & =(3-0)i-(x+0)j+(0+3x)k \\\\  & =⟨3,-x,3x⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{{3}^{2}+(-x)^{2}+(3x)^{2}} \\\\  & =\\sqrt{9+{x}^{2}+9{x}^{2}} \\\\  & =\\sqrt{10{x}^{2}+9}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{49} \\\\ \\sqrt{10{x}^{2}+9} & =\\sqrt{49} \\\\ 10{x}^{2}+9 & =49 \\\\ 10{x}^{2} & =40 \\\\ {x}^{2} & =4\\end{aligned}\n$$\n\nTherefore, in ascending order, the solutions are $x=-2,$ $x=2.$"}] [{:db/id #edb/ref 17592186348678 :knowledge-point/_questions [{:knowledge-point/id #uuid "21cef8c9-92ff-5527-a837-2236a0c1f9eb" :knowledge-point/title "Solving for an Unknown in an Equation Involving the Cross Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "175571ef-5a37-57f7-8fef-095de8fcfbaa" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186348680}] :answer-field/correct {:answer/id #uuid "175571ef-5a37-57f7-8fef-095de8fcfbaa" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186348680} :answer-field/id #uuid "e6c65aa6-e71f-5d1a-9f30-d21c749bb924" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186348679} {:answer-field/choices [{:answer/id #uuid "294c6f86-d2d4-5dfb-ad67-518e235aa1d5" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186348682}] :answer-field/correct {:answer/id #uuid "294c6f86-d2d4-5dfb-ad67-518e235aa1d5" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186348682} :answer-field/id #uuid "0aa99fc5-7859-59c5-a94a-5a4598cca902" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186348681}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "8782e145-18ba-5261-8ddf-00ef3416804e" :question/math-academy-id "q-282276" :question/problem "Let $a=⟨x,4,5⟩,$ $b=⟨1,0,1⟩$ and $|\\,a\\times b\\,|=\\sqrt{33}.$ Then, in **ascending order**, the possible values of $x$ are\n\n$\\,x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ x & 4 & 5 \\\\ 1 & 0 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}4 & 5 \\\\ 0 & 1\\end{aligned}|i-|\\begin{aligned}x & 5 \\\\ 1 & 1\\end{aligned}|j+|\\begin{aligned}x & 4 \\\\ 1 & 0\\end{aligned}|k \\\\  & =(4-0)i-(x-5)j+(0-4)k \\\\  & =⟨4,5-x,-4⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{{4}^{2}+(5-x)^{2}+(-4)^{2}} \\\\  & =\\sqrt{16+(25-10x+{x}^{2})+16} \\\\  & =\\sqrt{{x}^{2}-10x+57}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{33} \\\\ \\sqrt{{x}^{2}-10x+57} & =\\sqrt{33} \\\\ {x}^{2}-10x+57 & =33 \\\\ {x}^{2}-10x+24 & =0 \\\\ (x-4)(x-6) & =0 \\\\ x & =4,\\,x=6\\end{aligned}\n$$\n\nTherefore, in ascending order, the solutions are $x=4,$ $x=6.$"}]}
