0ffb02406608213e2"] :db/ensure [:answer-field/validate]} {:db/id "q-125899" :question/id #uuid "bcf4e431-a952-5630-8441-62a79c4f1460" :question/math-academy-id "q-125899" :question/problem "Let $f(x)$ be a function with $f(7)=4,{f}^{′}(7)=2,{f}^{″}(7)=-6$ and ${f}^{‴}(7)=-24.$ Which of the following is the third-degree Taylor polynomial for $f(x)$ about $x=7?$" :question/worked-solution "The third-degree Taylor polynomial of $f(x)$ about $x=7$ is\n\n$$\n\\begin{aligned}{P}_{3}(x) & =f(7)+{f}^{′}(7)(x-7)+\\frac{{f}^{″}(7)}{2!}(x-7)^{2}+\\frac{{f}^{‴}(7)}{3!}(x-7)^{3} \\\\  & =f(7)+{f}^{′}(7)(x-7)+\\frac{{f}^{″}(7)}{2}(x-7)^{2}+\\frac{{f}^{‴}(7)}{6}(x-7)^{3}.\\end{aligned}\n$$\n\nWe have been given the following set of values: \n\n$$\n\\begin{aligned}f(7) & =4 \\\\ {f}^{′}(7) & =2 \\\\ {f}^{″}(7) & =-6 \\\\ {f}^{‴}(7) & =-24.\\end{aligned}\n$$\n\nSubstituting the given values into our Taylor polynomial, we get\n\n$$\n\\begin{aligned}{P}_{3}(x) & =4+2(x-7)+\\frac{(-6)}{2}(x-7)^{2}+\\frac{(-24)}{6}(x-7)^{3} \\\\  & =4+2(x-7)-3(x-7)^{2}-4(x-7)^{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-125899/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "20824866-0419-512a-b241-e3eb66b30194"] :knowledge-point/questions ["q-125899"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351832/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "4c1088db-22d5-54b6-a598-f210b1474a68" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id 17592186299141 :answer-field/choices ["q-351832/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-51237/selection/b3c5236ff833e00651665c1db413260ad2a2851ee69968815709f3da54f6f891" :answer/id #uuid "af97abf0-0855-5889-9608-6c7b091961d9" :answer/type :answer.type/math :answer/value "3+5(x-2)-(x-2)^{2}" :db/ensure [:answer/validate]} {:db/id "q-51237/selection/a91697930def412504d183056220c8717f00fa2623424a842d6fe80ab5354f16" :answer/id #uuid "5670c9ff-0f62-58e2-a98c-89f91fa83663" :answer/type :answer.type/math :answer/value "3+5(x+2)-4(x+2)^{2}" :db/ensure [:answer/validate]} {:db/id "q-51237/selection/7ce5cf7f60c0fec11767269ee321ffae9b8958932d834250fa6e5bb4a59baddb" :answer/id #uuid "7dd47933-e029-596c-8e31-b5e501eff97a" :answer/type :answer.type/math :answer/value "3+5(x-2)-8(x-2)^{2}" :db/ensure [:answer/validate]} {:db/id "q-51237/selection/81c18154d8c0b4cde0115c11469f7526acab1457f72757b1143a0d7fcb0de9d2" :answer/id #uuid "cdedd75a-3353-55da-9ea9-8dc15556a102" :answer/type :answer.type/math :answer/value "3+5(x+2)-(x+2)^{2}" :db/ensure [:answer/validate]} {:db/id "q-51237/selection/5fa0ce40a8c8e592f3eb75654c13650c7f4e6d2074bc380439e30449092420ad" :answer/id #uuid "52ba7736-d88d-59ad-b210-ee6a42195079" :answer/type :answer.type/math :answer/value "3+5(x+2)-8(x+2)^{2}" :db/ensure [:answer/validate]} {:db/id "q-51237/selection" :answer-field/id #uuid "f0fe6001-0c14-5d20-9880-f98f67d3f814" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-51237/selection/a91697930def412504d183056220c8717f00fa2623424a842d6fe80ab5354f16" :answer-field/choices ["q-51237/selection/b3c5236ff833e00651665c1db413260ad2a2851ee69968815709f3da54f6f891" "q-51237/selection/a91697930def412504d183056220c8717f00fa2623424a842d6fe80ab5354f16" "q-51237/selection/7ce5cf7f60c0fec11767269ee321ffae9b8958932d834250fa6e5bb4a59baddb" "q-51237/selection/81c18154d8c0b4cde0115c11469f7526acab1457f72757b1143a0d7fcb0de9d2" "q-51237/selection/5fa0ce40a8c8e592f3eb75654c13650c7f4e6d2074bc380439e30449092420ad"] :db/ensure [:answer-field/validate]} {:db/id "q-51237" :question/id #uuid "35ff3098-4ddf-599c-bbdc-f3a31be635b8" :question/math-academy-id "q-51237" :question/problem "Let $f$ be a function with $f(-2)=3,{f}^{′}(-2)=5,{f}^{″}(-2)=-8$ and ${f}^{‴}(-2)=0.$ Which of the following is the third-degree Taylor polynomial for $f$ about $x=-2?$" :question/worked-solution "The third-degree Taylor polynomial of $f(x)$ about $x=-2$ is\n\n$$\n\\begin{aligned}{P}_{3}(x) & =f(-2)+{f}^{′}(-2)(x+2)+\\frac{{f}^{″}(-2)}{2!}(x+2)^{2}+\\frac{{f}^{‴}(-2)}{3!}(x+2)^{3} \\\\  & =f(-2)+{f}^{′}(-2)(x+2)+\\frac{{f}^{″}(2)}{2}(x+2)^{2}+\\frac{{f}^{‴}(-2)}{6}(x+2)^{3}.\\end{aligned}\n$$\n\nWe have been given the following set of values: \n\n$$\n\\begin{aligned}f(-2) & =3 \\\\ {f}^{′}(-2) & =5 \\\\ {f}^{″}(-2) & =-8 \\\\ {f}^{‴}(-2) & =0\\end{aligned}\n$$\n\nSubstituting the given values into our Taylor polynomial, we get\n\n$$\n\\begin{aligned}{P}_{3}(x) & =3+5(x+2)+\\frac{-8}{2}(x+2)^{2}+\\frac{0}{6}(x+2)^{3} \\\\  & =3+5(x+2)-4(x+2)^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-51237/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "20824866-0419-512a-b241-e3eb66b30194"] :knowledge-point/questions ["q-51237"] :db/ensure [:knowledge-point/validate]} {:db/id "q-12380/selection/996c1f4b02c6dcd1b0bf02880ceaa16888fbf27ba0c6f3bb4f24b606240c1f94" :answer/id #uuid "46b04293-c25f-59e0-ab1f-a7bedcc3b909" :answer/type :answer.type/math :answer/value "1-x+\\frac{{x}^{3}}{3}" :db/ensure [:answer/validate]} {:db/id "q-12380/selection/cbaa4babc91781ddcfdaafc05bf62a20264ee518c3c317cfca5e48430aecfece" :answer/id #uuid "0cf1e140-3a61-5f1f-8474-573dd7ff2134" :answer/type :answer.type/math :answer/value "x+\\frac{{x}^{2}}{2}+\\frac{{x}^{3}}{3}" :db/ensure [:answer/validate]} {:db/id "q-12380/selection/38056ce120a24a82cd1a78b5f0c67806e80362117ac5f40f1fae73046512b55b" :answer/id #uuid "4d5f2a9c-51b9-539f-8c6e-ea1a085f1ceb" :answer/type :answer.type/math :answer/value "x+\\frac{{x}^{3}}{2}-\\frac{{x}^{5}}{6}" :db/ensure [:answer/validate]} {:db/id "q-12380/selection/f0a7cae605a7dfa76d35fd08781703e393046304dd202dd159f0777bfa0ec482" :answer/id #uuid "b74a8e50-2478-5ef1-85ba-f9354727c79a" :answer/type :answer.type/math :answer/value "1-x+\\frac{{x}^{3}}{6}" :db/ensure [:answer/validate]} {:db/id "q-12380/selection/fd7b72f892814a6a0e917b1a4218e228dc040b9b32d711c40af595f7494a544f" :answer/id #uuid "f6b6fcfa-66e0-54c2-bbdc-5c5072eac42c" :answer/type :answer.type/math :answer/value "1+\\frac{{x}^{2}}{2}+\\frac{{x}^{3}}{6}" :db/ensure [:answer/validate]} {:db/id "q-12380/selection" :answer-field/id #uuid "d8bc7550-2675-595b-b9dc-de2d38777602" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-12380/selection/996c1f4b02c6dcd1b0bf02880ceaa16888fbf27ba0c6f3bb4f24b606240c1f94" :answer-field/choices ["q-12380/selection/996c1f4b02c6dcd1b0bf02880ceaa16888fbf27ba0c6f3bb4f24b606240c1f94" "q-12380/selection/cbaa4babc91781ddcfdaafc05bf62a20264ee518c3c317cfca5e48430aecfece" "q-12380/selection/38056ce120a24a82cd1a78b5f0c67806e80362117ac5f40f1fae73046512b55b" "q-12380/selection/f0a7cae605a7dfa76d35fd08781703e393046304dd202dd159f0777bfa0ec482" "q-12380/selection/fd7b72f892814a6a0e917b1a4218e228dc040b9b32d711c40af595f7494a544f"] :db/ensure [:answer-field/validate]} {:db/id "q-12380" :question/id #uuid "0115977e-e552-5c81-a528-e4c41764a6e8" :question/math-academy-id "q-12380" :question/problem "The third-degree Taylor polynomial of $f(x)={e}^{-x}\\operatorname{cos}⁡x$ about $x=0$ is" :question/worked-solution "To find the third-degree Taylor polynomial about $x=0,$ we plug $a=0$ into the general formula to give\n\n$$\n\\begin{aligned}{P}_{3}(x) & =f(0)+{f}^{′}(0)x+{f}^{″}(0)\\frac{{x}^{2}}{2!}+{f}^{‴}(0)\\frac{{x}^{3}}{3!} \\\\  & =f(0)+{f}^{′}(0)x+{f}^{″}(0)\\frac{{x}^{2}}{2}+{f}^{‴}(0)\\frac{{x}^{3}}{6}.\\end{aligned}\n$$\n\nWe need to compute $f(0),$ ${f}^{′}(0),$ ${f}^{″}(0),$ and ${f}^{‴}(0),$ as follows:\n\n$$\n\\begin{aligned}f(x) & ={e}^{-x}\\operatorname{cos}⁡x & ⟹ &  & f(0) & ={e}^{-0}\\operatorname{cos}⁡0=1 \\\\ {f}^{′}(x) & =-{e}^{-x}\\operatorname{cos}⁡x-{e}^{-x}\\operatorname{sin}⁡x & ⟹ &  & {f}^{′}(0) & =-{e}^{-0}\\operatorname{cos}⁡0-{e}^{0}\\operatorname{sin}⁡0=-1 \\\\ {f}^{″}(x) & =2{e}^{-x}\\operatorname{sin}⁡x & ⟹ &  & {f}^{″}(0) & =2{e}^{-0}\\operatorname{sin}⁡0=0 \\\\ {f}^{‴}(x) & =-2{e}^{-x}\\operatorname{sin}⁡x+2{e}^{-x}\\operatorname{cos}⁡x & ⟹ &  & {f}^{‴}(0) & =-2{e}^{-0}\\operatorname{sin}⁡0+2{e}^{-0}\\operatorname{cos}⁡0=2\\end{aligned}\n$$\n\nFinally, we plug the results for $f(0),$ ${f}^{′}(0),$ ${f}^{″}(0),$ and ${f}^{‴}(0)$ into our third-degree Taylor polynomial. This gives\n\n$$\n\\begin{aligned}{P}_{3}(x) & =1+(-1)\\cdot x+0\\cdot \\frac{{x}^{2}}{2}+(2)\\cdot \\frac{{x}^{3}}{6} \\\\  & =1-x+\\frac{{x}^{3}}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-12380/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f9ea3dac-cf0a-5d05-8d77-7280ce9b5a94"] :knowledge-point/questions ["q-12380"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351999/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "89e4e2d3-bb9f-5cb0-9912-cb22108c54cb" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-351999/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "6235f995-c6c0-5765-9ecb-88f0d8f6085c" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-351999/field-1" :answer-field/id #uuid "eb3d9fdb-6377-5367-b531-9d53d7688c03" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351999/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-351999/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-351999/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-351999/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "43ec6938-737c-5a65-a523-a1c5bdbad0be" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-351999/field-2" :answer-field/id #uuid "9a9a0e41-73e9-5db4-878c-0999e46ae436" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351999/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-351999/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-351999/field-3/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "9281c7e1-0281-556b-987b-54a366fc4e3a" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-351999/field-3" :answer-field/id #uuid "2848f22c-fc19-56af-985a-1ab54c1d6592" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351999/field-3/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-351999/field-3/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-351999" :question/id #uuid "d447ff59-5163-5274-8987-8699bd1198dd" :question/math-academy-id "q-351999" :question/problem "Find the third-degree Taylor polynomial ${P}_{3}(x)$ of $f(x)=\\frac{1}{{x}^{2}}$ about $x=1.$ Do not round the answer.\n\n${P}_{3}(x)=1\\,-$\n{{field-1}}\n$(x-1)\\,+$\n{{field-2}}\n$(x-1)^{2}\\,-$\n{{field-3}}\n$(x-1)^{3}$" :question/worked-solution "To find the third-degree Taylor polynomial about $x=1,$ we plug $a=1$ into the general formula to give \n\n$$\n\\begin{aligned}{P}_{3}(x)=f(1)+{f}^{′}(1)(x-1)+\\frac{{f}^{″}(1)}{2!}(x-1)^{2}+\\frac{{f}^{‴}(1)}{3!}(x-1)^{3} \\\\ {P}_{3}(x)=f(1)+{f}^{′}(1)(x-1)+\\frac{{f}^{″}(1)}{2}(x-1)^{2}+\\frac{{f}^{‴}(1)}{6}(x-1)^{3}.\\end{aligned}\n$$\n\nWe need to compute $f(1),$ ${f}^{′}(1),$ ${f}^{″}(1),$ and ${f}^{‴}(1),$ as follows:\n\n$$\n\\begin{aligned}f(x) & =\\frac{1}{{x}^{2}} & ⟹ &  & f(1) & =\\frac{1}{{1}^{2}}=1 \\\\ {f}^{′}(x) & =-\\frac{2}{{x}^{3}} & ⟹ &  & {f}^{′}(1) & =-\\frac{2}{{1}^{3}}=-2 \\\\ {f}^{″}(x) & =\\frac{6}{{x}^{4}} & ⟹ &  & {f}^{″}(1) & =\\frac{6}{{1}^{4}}=6 \\\\ {f}^{‴}(x) & =-\\frac{24}{{x}^{5}} & ⟹ &  & {f}^{‴}(1) & =-\\frac{24}{{1}^{5}}=-24\\end{aligned}\n$$\n\nFinally, we plug the results for $f(1),$ ${f}^{′}(1),$ ${f}^{″}(1),$ and ${f}^{‴}(1)$ into our third-degree Taylor polynomial. This gives\n\n$$\n\\begin{aligned}{P}_{3}(x) & =(1)+(-2)\\cdot (x-1)+\\frac{(6)}{2}\\cdot (x-1)^{2}+\\frac{(-24)}{6}\\cdot (x-1)^{3} \\\\  & =1-2(x-1)+3(x-1)^{2}-4(x-1)^{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-351999/field-1" "q-351999/field-2" "q-351999/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f9ea3dac-cf0a-5d05-8d77-7280ce9b5a94"] :knowledge-point/questions ["q-351999"] :db/ensure [:knowledge-point/validate]} {:db/id "q-126357/selection/71b1db0b2a675655ec27a2d2ceef2e86712a68eb78548232215378e0a354fb4c" :answer/id #uuid "381e07d1-b15c-503d-ab39-f4bcedecd81d" :answer/type :answer.type/math :answer/value "-\\frac{1}{6}" :db/ensure [:answer/validate]} {:db/id "q-126357/selection/f130bed8d6b969dc9fba227edf269de52d0a72731cb4fb925914e1521739f418" :answer/id #uuid "3c948602-d09f-5030-8b6f-b470b8936046" :answer/type :answer.type/math :answer/value "-\\frac{1}{24}" :db/ensure [:answer/validate]} {:db/id "q-126357/selection/ad2b7bc16ed48250b030899ddabf37c2f67524a10a191b79d4e766aafa92ea7f" :answer/id #uuid "a426abc4-a409-5441-8307-9894921ac337" :answer/type :answer.type/math :answer/value "\\frac{1}{48}" :db/ensure [:answer/validate]} {:db/id "q-126357/selection/5ab3573096b30d3c5d3c378e667364cbb062f921e9b1002441e594f0774a669d" :answer/id #uuid "34d30c09-f20e-5c1c-a5af-232ba2e16174" :answer/type :answer.type/math :answer/value "-\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-126357/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" :answer/id #uuid "4a53711d-af4e-5cce-9fac-361accefdd42" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-126357/selection" :answer-field/id #uuid "aebd5143-a59e-53a2-af4e-cac6cbdb03da" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-126357/selection/f130bed8d6b969dc9fba227edf269de52d0a72731cb4fb925914e1521739f418" :answer-field/choices ["q-126357/selection/71b1db0b2a675655ec27a2d2ceef2e86712a68eb78548232215378e0a354fb4c" "q-126357/selection/f130bed8d6b969dc9fba227edf269de52d0a72731cb4fb925914e1521739f418" "q-126357/selection/ad2b7bc16ed48250b030899ddabf37c2f67524a10a191b79d4e766aafa92ea7f" "q-126357/selection/5ab3573096b30d3c5d3c378e667364cbb062f921e9b1002441e594f0774a669d" "q-126357/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277"] :db/ensure [:answer-field/validate]} {:db/id "q-126357" :question/id #uuid "47beb5c7-b9f8-5cdc-a46a-e7eedfb53a9c" :question/math-academy-id "q-126357" :question/problem "What is the coefficient of ${x}^{3}$ in the third-degree Taylor polynomial of $f(x)=\\operatorname{ln}⁡(2-x)$ about $x=0?$" :question/worked-solution "The coefficient of ${x}^{3}$ is $\\frac{1}{3!}{f}^{(3)}(0).$ Let's compute the necessary derivatives:\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{ln}⁡(2-x) \\\\ {f}^{′}(x) & =-\\frac{1}{2-x} \\\\ {f}^{″}(x) & =-\\frac{1}{(2-x)^{2}} \\\\ {f}^{‴}(x) & =-\\frac{2}{(2-x)^{3}}\\end{aligned}\n$$\n\nNext, we evaluate ${f}^{‴}(0),$ which gives\n\n$$\n{f}^{‴}(0)=-\\frac{2}{(2-0)^{3}}=-\\frac{1}{4}.\n$$\n\nTherefore,\n\n$$\n\\frac{1}{3!}{f}^{‴}(0)=\\frac{1}{6}\\cdot (-\\frac{1}{4})=-\\frac{1}{24}.\n$$\n\nSo the coefficient of ${x}^{3}$ is $-\\frac{1}{24}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-126357/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5dc0250e-2aa9-5439-b567-93a59fa1c364"] :knowledge-point/questions ["q-126357"] :db/ensure [:knowledge-point/validate]} {:db/id "q-348019/field-1/393522ee4ded7288062e6072c329c38ecb06c9de712f11faf938346737b8d6d5" :answer/id #uuid "1e24fd73-3730-544b-b72d-0d2cec8818fc" :answer/type :answer.type/math :answer/value "\\frac{1}{24}" :db/ensure [:answer/validate]} {:db/id "q-348019/field-1" :answer-field/id #uuid "1714e555-7ad7-52f7-aa9d-1acbe22fde82" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-348019/field-1/393522ee4ded7288062e6072c329c38ecb06c9de712f11faf938346737b8d6d5" :answer-field/choices ["q-348019/field-1/393522ee4ded7288062e6072c329c38ecb06c9de712f11faf938346737b8d6d5"] :db/ensure [:answer-field/validate]} {:db/id "q-348019" :question/id #uuid "56837e97-06d8-5989-94c8-2e9269703dbe" :question/math-academy-id "q-348019" :question/problem "Find the coefficient of ${x}^{3}$ in the third-degree Taylor polynomial of $f(x)=\\operatorname{ln}⁡(2+x)$ about $x=0.$ Do not round the answer.\n\nThe coefficient of ${x}^{3}$ is\n{{field-1}}." :question/worked-solution "The coefficient of ${x}^{3}$ is $\\frac{1}{3!}{f}^{(3)}(0).$ Let's compute the necessary derivatives:\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{ln}⁡(2+x) \\\\ {f}^{′}(x) & =\\frac{1}{2+x} \\\\ {f}^{″}(x) & =-\\frac{1}{(2+x)^{2}} \\\\ {f}^{‴}(x) & =\\frac{2}{(2+x)^{3}}\\end{aligned}\n$$\n\nNext, we evaluate ${f}^{‴}(0),$ which gives\n\n$$\n{f}^{‴}(0)=\\frac{2}{(2+0)^{3}}=\\frac{2}{8}=\\frac{1}{4}.\n$$\n\nTherefore,\n\n$$\n\\frac{1}{3!}{f}^{‴}(0)=\\frac{1}{3!}\\cdot \\frac{1}{4}=\\frac{1}{24}.\n$$\n\nSo, the coefficient of ${x}^{3}$ is $\\frac{1}{24}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-348019/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5dc0250e-2aa9-5439-b567-93a59fa1c364"] :knowledge-point/questions ["q-348019"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351869/field-1/d87e5ba8d313a3aa19bcecefebd2c42a21635ebf0d8c3a6fa40fc07734adc23d" :answer/id #uuid "038d5daa-95f1-5dbb-971a-a26686b08e71" :answer/type :answer.type/math :answer/value "-\\frac{1}{81}" :db/ensure [:answer/validate]} {:db/id "q-351869/field-1/f22f32a843d143bb4c44bcfa07d056ce3340f6bd19eeb5c9fac562ce194ff2e1" :answer/id #uuid "de62eb2c-63f6-5372-a9ca-53858179ecf4" :answer/type :answer.type/math :answer/value "\\frac{1}{81}" :db/ensure [:answer/validate]} {:db/id "q-351869/field-1" :answer-field/id #uuid "e027e265-2e46-5698-a52e-62df8c16cb38" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351869/field-1/d87e5ba8d313a3aa19bcecefebd2c42a21635ebf0d8c3a6fa40fc07734adc23d" :answer-field/choices ["q-351869/field-1/d87e5ba8d313a3aa19bcecefebd2c42a21635ebf0d8c3a6fa40fc07734adc23d" "q-351869/field-1/f22f32a843d143bb4c44bcfa07d056ce3340f6bd19eeb5c9fac562ce194ff2e1"] :db/ensure [:answer-field/validate]} {:db/id "q-351869" :question/id #uuid "962c443b-40cc-5a79-88ee-071a8061f1eb" :question/math-academy-id "q-351869" :question/problem "Find the coefficient of $(x-3)^{3}$ in the third-degree Taylor polynomial of $f(x)=\\frac{1}{x}$ about $x=3.$ Do not round the answer.\n\nThe coefficient of $(x-3)^{3}$ is\n{{field-1}}." :question/worked-solution "The coefficient of $(x-3)^{3}$ is $\\frac{1}{3!}{f}^{‴}(3).$ Let's compute the necessary derivatives:\n\n$$\n\\begin{aligned}f(x) & =\\frac{1}{x} \\\\ {f}^{′}(x) & =-\\frac{1}{{x}^{2}} \\\\ {f}^{″}(x) & =\\frac{2}{{x}^{3}} \\\\ {f}^{‴}(x) & =-\\frac{6}{{x}^{4}}\\end{aligned}\n$$\n\nNext, we evaluate ${f}^{‴}(3),$ which gives\n\n$$\n{f}^{‴}(3)=-\\frac{6}{{3}^{4}}=-\\frac{6}{81}=-\\frac{2}{27}.\n$$\n\nTherefore,\n\n$$\n\\frac{1}{3!}{f}^{‴}(3)=\\frac{1}{3!}\\cdot (-\\frac{2}{27})=-\\frac{2}{6\\cdot 27}=-\\frac{1}{81}.\n$$\n\nSo, the coefficient of $(x-3)^{3}$ is $-\\frac{1}{81}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-351869/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5dc0250e-2aa9-5439-b567-93a59fa1c364"] :knowledge-point/questions ["q-351869"] :db/ensure [:knowledge-point/validate]}]
