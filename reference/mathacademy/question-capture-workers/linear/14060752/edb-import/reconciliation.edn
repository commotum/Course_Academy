488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-351832" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-351832" "field" "field-3" "attribute" "answer-field/correct" "value" [:answer.type/math "1"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-51238" "field" nil "attribute" "question/problem" "value" "Let $f$ be a function with $f(3)=1,{f}^{′}(3)=1,{f}^{″}(3)=2$ and ${f}^{‴}(3)=3.$ Which of the following is the third-degree Taylor polynomial for $f$ about $x=3?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-51238" "field" nil "attribute" "question/worked-solution" "value" "The third-degree Taylor polynomial of $f(x)$ about $x=3$ is\n\n$$\n\\begin{aligned}{P}_{3}(x) & =f(3)+{f}^{′}(3)(x-3)+\\frac{{f}^{″}(3)}{2!}(x-3)^{2}+\\frac{{f}^{‴}(3)}{3!}(x-3)^{3} \\\\  & =f(3)+{f}^{′}(3)(x-3)+\\frac{{f}^{″}(3)}{2}(x-3)^{2}+\\frac{{f}^{‴}(3)}{6}(x-3)^{3}.\\end{aligned}\n$$\n\nWe have been given the following set of values: \n\n$$\n\\begin{aligned}f(3) & =1 \\\\ {f}^{′}(3) & =1 \\\\ {f}^{″}(3) & =2 \\\\ {f}^{‴}(3) & =3\\end{aligned}\n$$\n\nSubstituting the given values into our Taylor polynomial, we get\n\n$$\n\\begin{aligned}{P}_{3}(x) & =1+1(x-3)+\\frac{2}{2}(x-3)^{2}+\\frac{3}{6}(x-3)^{3} \\\\  & =1+(x-3)+(x-3)^{2}+\\frac{1}{2}(x-3)^{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-51238" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/activity-metadata.json" "file_sha256" "a963d74ef73dcee608e6f282405dde1471a8fbdbf8fa7937a404f9d0a849ad9b" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-51238" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-51238" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "1+(x-3)+(x-3)^{2}+3(x-3)^{3}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-51238" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "1+(x-3)+(x-3)^{2}+\\frac{1}{2}(x-3)^{3}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-51238" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "1+(x-3)+(x-3)^{2}+\\frac{1}{3}(x-3)^{3}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-51238" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "1+(x-3)+2(x-3)^{2}+3(x-3)^{3}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-51238" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "1+(x-3)+2(x-3)^{2}+\\frac{1}{2}(x-3)^{3}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-51235" "field" nil "attribute" "question/problem" "value" "Let $f(x)$ be a function with $f(4)=1,{f}^{′}(4)=-1,{f}^{″}(4)=-2$ and ${f}^{‴}(4)=12.$ Which of the following is the third-degree Taylor polynomial for $f(x)$ about $x=4?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-51235" "field" nil "attribute" "question/worked-solution" "value" "The third-degree Taylor polynomial of $f(x)$ about $x=4$ is\n\n$$\n\\begin{aligned}{P}_{3}(x) & =f(4)+{f}^{′}(4)(x-4)+\\frac{{f}^{″}(4)}{2!}(x-4)^{2}+\\frac{{f}^{‴}(4)}{3!}(x-4)^{3} \\\\  & =f(4)+{f}^{′}(4)(x-4)+\\frac{{f}^{″}(4)}{2}(x-4)^{2}+\\frac{{f}^{‴}(4)}{6}(x-4)^{3}.\\end{aligned}\n$$\n\nWe have been given the following set of values: \n\n$$\n\\begin{aligned}f(4) & =1 \\\\ {f}^{′}(4) & =-1 \\\\ {f}^{″}(4) & =-2 \\\\ {f}^{‴}(4) & =12.\\end{aligned}\n$$\n\nSubstituting the given values into our Taylor polynomial, we get\n\n$$\n\\begin{aligned}{P}_{3}(x) & =1-1(x-4)+\\frac{(-2)}{2}(x-4)^{2}+\\frac{12}{6}(x-4)^{3} \\\\  & =1-(x-4)-(x-4)^{2}+2(x-4)^{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-51235" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/activity-metadata.json" "file_sha256" "a963d74ef73dcee608e6f282405dde1471a8fbdbf8fa7937a404f9d0a849ad9b" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-51235" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-348351" "field" nil "attribute" "question/problem" "value" "Find the third-degree Taylor polynomial ${P}_{3}(x)$ of $f(x)={e}^{x}$ about $x=0.$\n\n${P}_{3}(x)=1+x\\,+$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-348351" "field" nil "attribute" "question/worked-solution" "value" "To find the third-degree Taylor polynomial about $x=0,$ we plug $a=0$ into the general formula to give\n\n$$\n\\begin{aligned}{P}_{3}(x) & =f(0)+{f}^{′}(0)x+{f}^{″}(0)\\frac{{x}^{2}}{2!}+{f}^{‴}(0)\\frac{{x}^{3}}{3!} \\\\  & =f(0)+{f}^{′}(0)x+{f}^{″}(0)\\frac{{x}^{2}}{2}+{f}^{‴}(0)\\frac{{x}^{3}}{6}.\\end{aligned}\n$$\n\nWe need to compute $f(0),$ ${f}^{′}(0),$ ${f}^{″}(0),$ and ${f}^{‴}(0),$ as follows:\n\n$$\n\\begin{aligned}f(x) & ={e}^{x} & ⟹ &  & f(0) & ={e}^{0}=1 \\\\ {f}^{′}(x) & ={e}^{x} & ⟹ &  & {f}^{′}(0) & ={e}^{0}=1 \\\\ {f}^{″}(x) & ={e}^{x} & ⟹ &  & {f}^{″}(0) & ={e}^{0}=1 \\\\ {f}^{‴}(x) & ={e}^{x} & ⟹ &  & {f}^{‴}(0) & ={e}^{0}=1\\end{aligned}\n$$\n\nFinally, we plug the results for $f(0),$ ${f}^{′}(0),$ ${f}^{″}(0),$ and ${f}^{‴}(0)$ into our third-degree Taylor polynomial. This gives\n\n$$\n\\begin{aligned}{P}_{3}(x) & =1+1\\cdot x+1\\cdot \\frac{{x}^{2}}{2}+1\\cdot \\frac{{x}^{3}}{6} \\\\  & =1+x+\\frac{1}{2}{x}^{2}+\\frac{1}{6}{x}^{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-348351" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/activity-metadata.json" "file_sha256" "a963d74ef73dcee608e6f282405dde1471a8fbdbf8fa7937a404f9d0a849ad9b" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-348351" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-351997" "field" nil "attribute" "question/problem" "value" "Find the third-degree Taylor polynomial ${P}_{3}(x)$ of $f(x)={e}^{2x}$ about $x=1.$ Do not round the answer.\n\n${P}_{3}(x)={e}^{2}\\,+$\n{{field-1}}\n$(x-1)\\,+$\n{{field-2}}\n$(x-1)^{2}\\,+$\n{{field-3}}\n$(x-1)^{3}$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-351997" "field" nil "attribute" "question/worked-solution" "value" "To find the third-degree Taylor polynomial about $x=1,$ we plug $a=1$ into the general formula to give \n\n$$\n\\begin{aligned}{P}_{3}(x)=f(1)+{f}^{′}(1)(x-1)+\\frac{{f}^{″}(1)}{2!}(x-1)^{2}+\\frac{{f}^{‴}(1)}{3!}(x-1)^{3} \\\\ {P}_{3}(x)=f(1)+{f}^{′}(1)(x-1)+\\frac{{f}^{″}(1)}{2}(x-1)^{2}+\\frac{{f}^{‴}(1)}{6}(x-1)^{3}.\\end{aligned}\n$$\n\nWe need to compute $f(1),$ ${f}^{′}(1),$ ${f}^{″}(1),$ and ${f}^{‴}(1),$ as follows:\n\n$$\n\\begin{aligned}f(x) & ={e}^{2x} & ⟹ &  & f(1) & ={e}^{2\\cdot 1}={e}^{2} \\\\ {f}^{′}(x) & =2{e}^{2x} & ⟹ &  & {f}^{′}(1) & =2{e}^{2\\cdot 1}=2{e}^{2} \\\\ {f}^{″}(x) & =4{e}^{2x} & ⟹ &  & {f}^{″}(1) & =4{e}^{2\\cdot 1}=4{e}^{2} \\\\ {f}^{‴}(x) & =8{e}^{2x} & ⟹ &  & {f}^{‴}(1) & =8{e}^{2\\cdot 1}=8{e}^{2}\\end{aligned}\n$$\n\nFinally, we plug the results for $f(1),$ ${f}^{′}(1),$ ${f}^{″}(1),$ and ${f}^{‴}(1)$ into our third-degree Taylor polynomial. This gives\n\n$$\n\\begin{aligned}{P}_{3}(x)={e}^{2}+2{e}^{2}(x-1)+2{e}^{2}(x-1)^{2}+\\frac{4{e}^{2}}{3}(x-1)^{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-351997" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/activity-metadata.json" "file_sha256" "a963d74ef73dcee608e6f282405dde1471a8fbdbf8fa7937a404f9d0a849ad9b" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-351997" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-351997" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "2e^2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-351997" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-351997" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "2e^2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-351997" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-351997" "field" "field-3" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{4e^2}{3}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-125925" "field" nil "attribute" "question/problem" "value" "What is the coefficient of ${(x+\\frac{1}{3})}^{3}$ in the third-degree Taylor polynomial of $f(x)={e}^{-3x}$ about $x=-\\frac{1}{3}?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-125925" "field" nil "attribute" "question/worked-solution" "value" "The coefficient of ${(x+\\frac{1}{3})}^{3}$ is $\\frac{1}{3!}{f}^{(3)}(-\\frac{1}{3}).$ Let's compute the necessary derivatives:\n\n$$\n\\begin{aligned}f(x) & ={e}^{-3x} \\\\ {f}^{′}(x) & =-3{e}^{-3x} \\\\ {f}^{″}(x) & =9{e}^{-3x} \\\\ {f}^{‴}(x) & =-27{e}^{-3x}\\end{aligned}\n$$\n\nNext, we evaluate ${f}^{‴}(-\\frac{1}{3}),$ which gives\n\n$$\n{f}^{‴}(-\\frac{1}{3})=-27\\cdot {e}^{-3\\cdot (-1/3)}=-27e.\n$$\n\nTherefore,\n\n$$\n\\frac{1}{3!}{f}^{‴}(-\\frac{1}{3})=\\frac{1}{6}\\cdot (-27e)=-\\frac{9e}{2}.\n$$\n\nSo the coefficient of ${(x+\\frac{1}{3})}^{3}$ is $-\\frac{9e}{2}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-125925" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/activity-metadata.json" "file_sha256" "a963d74ef73dcee608e6f282405dde1471a8fbdbf8fa7937a404f9d0a849ad9b" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-125925" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-125925" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "-\\frac{3e}{2}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-125925" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "-\\frac{3}{2e}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-125925" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "-\\frac{9e}{2}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-125925" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{9}{2e}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-125925" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{e}{3}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-125925" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{9e}{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/state.json" "file_sha256" "4780fb59f98b666bfc992f36488f94cbd2c11d9e6dc9df3662a452e10101ef69" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "e-7115" "field" nil "attribute" "question/problem" "value" "Let $f(x)$ be a function with $f(-1)=-1, f'(-1)=3, f''(-1)=-6$ and $f'''(-1)=6.$ What is the third-degree Taylor polynomial for $f(x)$ about $x=-1?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/example-7115.json" "file_sha256" "c2114e2b684c903a1c6f570c7987973a47ccdcd9d354323e1bcb56a947e84015" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "e-7115" "field" nil "attribute" "question/worked-solution" "value" "The third-degree Taylor polynomial of $f(x)$ about $x=-1$ is\n\n$$\n\\begin{aligned}{P}_{3}(x) & =f(-1)+{f}^{′}(-1)(x+1)+\\frac{{f}^{″}(-1)}{2!}(x+1)^{2}+\\frac{{f}^{‴}(-1)}{3!}(x+1)^{3} \\\\  & =f(-1)+{f}^{′}(-1)(x+1)+\\frac{{f}^{″}(-1)}{2}(x+1)^{2}+\\frac{{f}^{‴}(-1)}{6}(x+1)^{3}.\\end{aligned}\n$$\n\nWe have been given the following set of values: \n\n$$\n\\begin{aligned}f(-1) & =-1 \\\\ {f}^{′}(-1) & =3 \\\\ {f}^{″}(-1) & =-6 \\\\ {f}^{‴}(-1) & =6.\\end{aligned}\n$$\n\nSubstituting the given values into our Taylor polynomial, we get\n\n$$\n\\begin{aligned}{P}_{3}(x) & =-1+3(x+1)+\\frac{(-6)}{2}(x+1)^{2}+\\frac{6}{6}(x+1)^{3} \\\\  & =-1+3(x+1)-3(x+1)^{2}+(x+1)^{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/example-7115.json" "file_sha256" "c2114e2b684c903a1c6f570c7987973a47ccdcd9d354323e1bcb56a947e84015" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "e-741" "field" nil "attribute" "question/problem" "value" "Find the third-degree Taylor polynomial of $f(x) = \\ln(1+x)$ about $x=0.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/example-741.json" "file_sha256" "e6161aad25e927abf4c2ab55467d7e8504715854e10357c8ba16f038fd32823a" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "e-741" "field" nil "attribute" "question/worked-solution" "value" "To find the third-degree Taylor polynomial about $x=0,$ we plug $a=0$ into the general formula to give\n\n$$\nP_3(x) = f(0) + f'(0)(x-0) + \\dfrac{1}{2!}f''(0)(x-0)^2 + \\dfrac{1}{3!}f'''(0)(x-0)^3.\n$$\n\nWe need to compute $f(0),$ $f'(0),$ $f''(0),$ and $f'''(0),$ as follows:\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{ln}⁡(1+x) & ⟹ &  & f(0) & =\\operatorname{ln}⁡(1+0)=0 \\\\ {f}^{′}(x) & =(1+x)^{-1} & ⟹ &  & {f}^{′}(0) & =(1+0)^{-1}=1 \\\\ {f}^{″}(x) & =-(1+x)^{-2} & ⟹ &  & {f}^{″}(0) & =-(1+0)^{-2}=-1 \\\\ {f}^{(3)}(x) & =2(1+x)^{-3} & ⟹ &  & {f}^{‴}(0) & =2(1+0)^{-3}=2.\\end{aligned}\n$$\n\nFinally, we plug the results for $f(0),$ $f'(0),$ $f''(0),$ and $f'''(0)$ into our third-degree Taylor polynomial. This gives\n\n$$\n\\begin{aligned}{P}_{3}(x) & =0+(1)(x-0)+\\frac{1}{2!}(-1)(x-0)^{2}+\\frac{1}{3!}(2)(x-0)^{3} \\\\  & =x-\\frac{{x}^{2}}{2}+\\frac{{x}^{3}}{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/example-741.json" "file_sha256" "e6161aad25e927abf4c2ab55467d7e8504715854e10357c8ba16f038fd32823a" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "e-742" "field" nil "attribute" "question/problem" "value" "What is the coefficient of $(x-1)^3$ in the third-degree Taylor polynomial of $f(x) = e^{-2x}?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/example-742.json" "file_sha256" "5e8f9ba2791c1fa9088b8ac201eb7c49e6986a3c082f5adead76b341d0581e7b" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "e-742" "field" nil "attribute" "question/worked-solution" "value" "The coefficient of $(x-1)^3$ is $\\dfrac{1}{3!}f^{(3)}(1).$ Let's compute the necessary derivatives:\n\n$$\n\\begin{aligned}f(x) & ={e}^{-2x} \\\\ {f}^{′}(x) & =-2{e}^{-2x} \\\\ {f}^{″}(x) & =4{e}^{-2x} \\\\ {f}^{(3)}(x) & =-8{e}^{-2x}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\dfrac{1}{3!}f^{(3)}(1) =\\dfrac{1}{6} \\left( -8e^{-2} \\right) = -\\dfrac{4}{3e^2}.\n$$\n\nSo the coefficient of $(x-1)^3$ is $-\\dfrac{4}{3e^2}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/example-742.json" "file_sha256" "5e8f9ba2791c1fa9088b8ac201eb7c49e6986a3c082f5adead76b341d0581e7b" "basis" 1305 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038458/edb-import/verification.json"} {"question" "q-126359" "field" nil "attribute" "question/problem" "value" "What is the coefficient of ${x}^{3}$ in the third-degree Taylor polynomial of $f(x)=\\frac{1}{1-x}$ about $x=0?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054465/state.json" "file_sha256" "77d9993d6c12a2dbe46909dc26d7306ac157dc65e4e0661643724f471a5846ef" "basis" 1803 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054465/edb-import/verification.json"} {"question" "q-126359" "field" nil "attribute" "question/worked-solution" "value" "The coefficient of ${x}^{3}$ is $\\frac{1}{3!}{f}^{(3)}(0).$ Let's compute the necessary derivatives:\n\n$$\n\\begin{aligned}f(x) & =\\frac{1}{1-x} \\\\ {f}^{′}(x) & =\\frac{1}{(1-x)^{2}} \\\\ {f}^{″}(x) & =\\frac{2}{(1-x)^{3}} \\\\ {f}^{‴}(x) & =\\frac{6}{(1-x)^{4}}\\end{aligned}\n$$\n\nNext, we evaluate ${f}^{‴}(0),$ which gives\n\n$$\n{f}^{‴}(0)=\\frac{6}{(1-0)^{4}}=6.\n$$\n\nTherefore,\n\n$$\n\\frac{1}{3!}{f}^{‴}(0)=\\frac{1}{6}\\cdot 6=1.\n$$\n\nSo the coefficient of ${x}^{3}$ is $1.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054465/state.json" "file_sha256" "77d9993d6c12a2dbe46909dc26d7306ac157dc65e4e0661643724f471a5846ef" "basis" 1803 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054465/edb-import/verification.json"} {"question" "q-126359" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054465/activity-metadata.json" "file_sha256" "d187f4c6935d1871677f80f2da5e85b2423abe9481ef47b4727c362f7ea4b2fd" "basis" 1803 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054465/edb-import/verification.json"} {"question" "q-126359" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054465/state.json" "file_sha256" "77d9993d6c12a2dbe46909dc26d7306ac157dc65e4e0661643724f471a5846ef" "basis" 1803 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054465/edb-import/verification.json"} {"question" "q-126359" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "-1"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054465/state.json" "file_sha256" "77d9993d6c12a2dbe46909dc26d7306ac157dc65e4e0661643724f471a5846ef" "basis" 1803 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054465/edb-import/verification.json"} {"question" "q-126359" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "-6"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054465/state.json" "file_sha256" "77d9993d6c12a2dbe46909dc26d7306ac157dc65e4e0661643724f471a5846ef" "basis" 1803 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054465/edb-import/verification.json"} {"question" "q-126359" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "1"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054465/state.json" "file_sha256" "77d9993d6c12a2dbe46909dc26d7306ac157dc65e4e0661643724f471a5846ef" "basis" 1803 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054465/edb-import/verification.json"} {"question" "q-126359" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "3"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054465/state.json" "file_sha256" "77d9993d6c12a2dbe46909dc26d7306ac157dc65e4e0661643724f471a5846ef" "basis" 1803 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054465/edb-import/verification.json"} {"question" "q-126359" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "6"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054465/state.json" "file_sha256" "77d9993d6c12a2dbe46909dc26d7306ac157dc65e4e0661643724f471a5846ef" "basis" 1803 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054465/edb-import/verification.json"} {"question" "q-351859" "field" nil "attribute" "question/problem" "value" "Find the third-degree Taylor polynomial ${P}_{3}(x)$ of $f(x)={e}^{-2x}$ about $x=0.$\n\n${P}_{3}(x)=1-2x\\,+$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054465/state.json" "file_sha256" "77d9993d6c12a2dbe46909dc26d7306ac157dc65e4e0661643724f471a5846ef" "basis" 1803 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054465/edb-import/verification.json"} {"question" "q-351859" "field" nil "attribute" "question/worked-solution" "value" "To find the third-degree Taylor polynomial about $x=0,$ we plug $a=0$ into the general formula to give\n\n$$\n\\begin{aligned}{P}_{3}(x) & =f(0)+{f}^{′}(0)x+{f}^{″}(0)\\frac{{x}^{2}}{2!}+{f}^{‴}(0)\\frac{{x}^{3}}{3!} \\\\  & =f(0)+{f}^{′}(0)x+{f}^{″}(0)\\frac{{x}^{2}}{2}+{f}^{‴}(0)\\frac{{x}^{3}}{6}.\\end{aligned}\n$$\n\nWe need to compute $f(0),$ ${f}^{′}(0),$ ${f}^{″}(0),$ and ${f}^{‴}(0),$ as follows:\n\n$$\n\\begin{aligned}f(x) & ={e}^{-2x} & ⟹ &  & f(0) & ={e}^{-0}=1 \\\\ {f}^{′}(x) & =-2{e}^{-2x} & ⟹ &  & {f}^{′}(0) & =-2{e}^{-0}=-2 \\\\ {f}^{″}(x) & =4{e}^{-2x} & ⟹ &  & {f}^{″}(0) & =4{e}^{-0}=4 \\\\ {f}^{‴}(x) & =-8{e}^{-2x} & ⟹ &  & {f}^{‴}(0) & =-8{e}^{-0}=-8\\end{aligned}\n$$\n\nFinally, we plug the results for $f(0),$ ${f}^{′}(0),$ ${f}^{″}(0),$ and ${f}^{‴}(0)$ into our third-degree Taylor polynomial. This gives\n\n$$\n\\begin{aligned}{P}_{3}(x) & =1-2\\cdot x+4\\cdot \\frac{{x}^{2}}{2}-8\\cdot \\frac{{x}^{3}}{6} \\\\  & =1-2x+2{x}^{2}-\\frac{4}{3}{x}^{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054465/state.json" "file_sha256" "77d9993d6c12a2dbe46909dc26d7306ac157dc65e4e0661643724f471a5846ef" "basis" 1803 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054465/edb-import/verification.json"} {"question" "q-351859" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054465/activity-metadata.json" "file_sha256" "d187f4c6935d1871677f80f2da5e85b2423abe9481ef47b4727c362f7ea4b2fd" "basis" 1803 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054465/edb-import/verification.json"} {"question" "q-351859" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054465/state.json" "file_sha256" "77d9993d6c12a2dbe46909dc26d7306ac157dc65e4e0661643724f471a5846ef" "basis" 1803 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054465/edb-import/verification.json"} {"question" "q-351859" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "2x^2-\\frac{4}{3}x^3"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054465/state.json" "file_sha256" "77d9993d6c12a2dbe46909dc26d7306ac157dc65e4e0661643724f471a5846ef" "basis" 1803 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054465/edb-import/verification.json"}] "sources" [{"question" "q-51235" "field" nil "attribute" "question/problem" "value" "Let $f(x)$ be a function with $f(4)=1,{f}^{′}(4)=-1,{f}^{″}(4)=-2$ and ${f}^{‴}(4)=12.$ Which of the following is the third-degree Taylor polynomial for $f(x)$ about $x=4?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-51235" "field" nil "attribute" "question/worked-solution" "value" "The third-degree Taylor polynomial of $f(x)$ about $x=4$ is\n\n$$\n\\begin{aligned}{P}_{3}(x) & =f(4)+{f}^{′}(4)(x-4)+\\frac{{f}^{″}(4)}{2!}(x-4)^{2}+\\frac{{f}^{‴}(4)}{3!}(x-4)^{3} \\\\  & =f(4)+{f}^{′}(4)(x-4)+\\frac{{f}^{″}(4)}{2}(x-4)^{2}+\\frac{{f}^{‴}(4)}{6}(x-4)^{3}.\\end{aligned}\n$$\n\nWe have been given the following set of values: \n\n$$\n\\begin{aligned}f(4) & =1 \\\\ {f}^{′}(4) & =-1 \\\\ {f}^{″}(4) & =-2 \\\\ {f}^{‴}(4) & =12.\\end{aligned}\n$$\n\nSubstituting the given values into our Taylor polynomial, we get\n\n$$\n\\begin{aligned}{P}_{3}(x) & =1-1(x-4)+\\frac{(-2)}{2}(x-4)^{2}+\\frac{12}{6}(x-4)^{3} \\\\  & =1-(x-4)-(x-4)^{2}+2(x-4)^{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-51235" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/activity-metadata.json" "file_sha256" "ed88576c46d9d1ab1d0cdf5705e87aa87c709db3ce41fab7faff65f4a7c004da"} {"question" "q-51235" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-51235" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "1-(x+4)-2(x+4)^{2}+12(x+4)^{3}"] ["math" "1-(x+4)-2(x+4)^{2}+2(x+4)^{3}"] ["math" "1-(x-4)-(x-4)^{2}+(x-4)^{3}"] ["math" "1-(x-4)-(x-4)^{2}+2(x-4)^{3}"] ["math" "1-(x-4)-2(x-4)^{2}+12(x-4)^{3}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-51235" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "1-(x-4)-(x-4)^{2}+2(x-4)^{3}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-125899" "field" nil "attribute" "question/problem" "value" "Let $f(x)$ be a function with $f(7)=4,{f}^{′}(7)=2,{f}^{″}(7)=-6$ and ${f}^{‴}(7)=-24.$ Which of the following is the third-degree Taylor polynomial for $f(x)$ about $x=7?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-125899" "field" nil "attribute" "question/worked-solution" "value" "The third-degree Taylor polynomial of $f(x)$ about $x=7$ is\n\n$$\n\\begin{aligned}{P}_{3}(x) & =f(7)+{f}^{′}(7)(x-7)+\\frac{{f}^{″}(7)}{2!}(x-7)^{2}+\\frac{{f}^{‴}(7)}{3!}(x-7)^{3} \\\\  & =f(7)+{f}^{′}(7)(x-7)+\\frac{{f}^{″}(7)}{2}(x-7)^{2}+\\frac{{f}^{‴}(7)}{6}(x-7)^{3}.\\end{aligned}\n$$\n\nWe have been given the following set of values: \n\n$$\n\\begin{aligned}f(7) & =4 \\\\ {f}^{′}(7) & =2 \\\\ {f}^{″}(7) & =-6 \\\\ {f}^{‴}(7) & =-24.\\end{aligned}\n$$\n\nSubstituting the given values into our Taylor polynomial, we get\n\n$$\n\\begin{aligned}{P}_{3}(x) & =4+2(x-7)+\\frac{(-6)}{2}(x-7)^{2}+\\frac{(-24)}{6}(x-7)^{3} \\\\  & =4+2(x-7)-3(x-7)^{2}-4(x-7)^{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-125899" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/activity-metadata.json" "file_sha256" "ed88576c46d9d1ab1d0cdf5705e87aa87c709db3ce41fab7faff65f4a7c004da"} {"question" "q-125899" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-125899" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "4+(x-7)-(x-7)^{2}-4(x-7)^{3}"] ["math" "4+2(x-7)-(x-7)^{2}-6(x-7)^{3}"] ["math" "4+2(x-7)-2(x-7)^{2}-8(x-7)^{3}"] ["math" "4+2(x-7)-3(x-7)^{2}-4(x-7)^{3}"] ["math" "4+2(x-7)-3(x-7)^{2}-6(x-7)^{3}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-125899" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "4+2(x-7)-3(x-7)^{2}-4(x-7)^{3}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-51238" "field" nil "attribute" "question/problem" "value" "Let $f$ be a function with $f(3)=1,{f}^{′}(3)=1,{f}^{″}(3)=2$ and ${f}^{‴}(3)=3.$ Which of the following is the third-degree Taylor polynomial for $f$ about $x=3?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-51238" "field" nil "attribute" "question/worked-solution" "value" "The third-degree Taylor polynomial of $f(x)$ about $x=3$ is\n\n$$\n\\begin{aligned}{P}_{3}(x) & =f(3)+{f}^{′}(3)(x-3)+\\frac{{f}^{″}(3)}{2!}(x-3)^{2}+\\frac{{f}^{‴}(3)}{3!}(x-3)^{3} \\\\  & =f(3)+{f}^{′}(3)(x-3)+\\frac{{f}^{″}(3)}{2}(x-3)^{2}+\\frac{{f}^{‴}(3)}{6}(x-3)^{3}.\\end{aligned}\n$$\n\nWe have been given the following set of values: \n\n$$\n\\begin{aligned}f(3) & =1 \\\\ {f}^{′}(3) & =1 \\\\ {f}^{″}(3) & =2 \\\\ {f}^{‴}(3) & =3\\end{aligned}\n$$\n\nSubstituting the given values into our Taylor polynomial, we get\n\n$$\n\\begin{aligned}{P}_{3}(x) & =1+1(x-3)+\\frac{2}{2}(x-3)^{2}+\\frac{3}{6}(x-3)^{3} \\\\  & =1+(x-3)+(x-3)^{2}+\\frac{1}{2}(x-3)^{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-51238" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/activity-metadata.json" "file_sha256" "ed88576c46d9d1ab1d0cdf5705e87aa87c709db3ce41fab7faff65f4a7c004da"} {"question" "q-51238" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-51238" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "1+(x-3)+(x-3)^{2}+3(x-3)^{3}"] ["math" "1+(x-3)+(x-3)^{2}+\\frac{1}{2}(x-3)^{3}"] ["math" "1+(x-3)+(x-3)^{2}+\\frac{1}{3}(x-3)^{3}"] ["math" "1+(x-3)+2(x-3)^{2}+3(x-3)^{3}"] ["math" "1+(x-3)+2(x-3)^{2}+\\frac{1}{2}(x-3)^{3}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-51238" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "1+(x-3)+(x-3)^{2}+\\frac{1}{2}(x-3)^{3}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351832" "field" nil "attribute" "question/problem" "value" "Let $f(x)$ be a function with $f(2)=5,{f}^{′}(2)=3,{f}^{″}(2)=4,$ and ${f}^{‴}(2)=-6.$ What is the third-degree Taylor polynomial ${P}_{3}(x)$ for $f(x)$ about $x=2?$\n\n${P}_{3}(x)=5\\,+$\n{{field-1}}\n$(x-2)\\,+$\n{{field-2}}\n$(x-2)^{2}\\,-$\n{{field-3}}\n$(x-2)^{3}$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351832" "field" nil "attribute" "question/worked-solution" "value" "The third-degree Taylor polynomial of $f(x)$ about $x=2$ is\n\n$$\n\\begin{aligned}{P}_{3}(x) & =f(2)+{f}^{′}(2)(x-2)+\\frac{{f}^{″}(2)}{2!}(x-2)^{2}+\\frac{{f}^{‴}(2)}{3!}(x-2)^{3} \\\\  & =f(2)+{f}^{′}(2)(x-2)+\\frac{{f}^{″}(2)}{2}(x-2)^{2}+\\frac{{f}^{‴}(2)}{6}(x-2)^{3}.\\end{aligned}\n$$\n\nWe have been given the following set of values: \n\n$$\n\\begin{aligned}f(2) & =5 \\\\ {f}^{′}(2) & =3 \\\\ {f}^{″}(2) & =4 \\\\ {f}^{‴}(2) & =-6\\end{aligned}\n$$\n\nSubstituting the given values into our Taylor polynomial, we get\n\n$$\n\\begin{aligned}{P}_{3}(x) & =5+(3)\\cdot (x-2)+\\frac{4}{2}\\cdot (x-2)^{2}+\\frac{(-6)}{6}\\cdot (x-2)^{3} \\\\  & =5+3\\,(x-2)+2\\,(x-2)^{2}-1\\,(x-2)^{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351832" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/activity-metadata.json" "file_sha256" "ed88576c46d9d1ab1d0cdf5705e87aa87c709db3ce41fab7faff65f4a7c004da"} {"question" "q-351832" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351832" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "3"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351832" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351832" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351832" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351832" "field" "field-3" "attribute" "answer-field/correct" "value" [:answer.type/math "1"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-51237" "field" nil "attribute" "question/problem" "value" "Let $f$ be a function with $f(-2)=3,{f}^{′}(-2)=5,{f}^{″}(-2)=-8$ and ${f}^{‴}(-2)=0.$ Which of the following is the third-degree Taylor polynomial for $f$ about $x=-2?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-51237" "field" nil "attribute" "question/worked-solution" "value" "The third-degree Taylor polynomial of $f(x)$ about $x=-2$ is\n\n$$\n\\begin{aligned}{P}_{3}(x) & =f(-2)+{f}^{′}(-2)(x+2)+\\frac{{f}^{″}(-2)}{2!}(x+2)^{2}+\\frac{{f}^{‴}(-2)}{3!}(x+2)^{3} \\\\  & =f(-2)+{f}^{′}(-2)(x+2)+\\frac{{f}^{″}(2)}{2}(x+2)^{2}+\\frac{{f}^{‴}(-2)}{6}(x+2)^{3}.\\end{aligned}\n$$\n\nWe have been given the following set of values: \n\n$$\n\\begin{aligned}f(-2) & =3 \\\\ {f}^{′}(-2) & =5 \\\\ {f}^{″}(-2) & =-8 \\\\ {f}^{‴}(-2) & =0\\end{aligned}\n$$\n\nSubstituting the given values into our Taylor polynomial, we get\n\n$$\n\\begin{aligned}{P}_{3}(x) & =3+5(x+2)+\\frac{-8}{2}(x+2)^{2}+\\frac{0}{6}(x+2)^{3} \\\\  & =3+5(x+2)-4(x+2)^{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-51237" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/activity-metadata.json" "file_sha256" "ed88576c46d9d1ab1d0cdf5705e87aa87c709db3ce41fab7faff65f4a7c004da"} {"question" "q-51237" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-51237" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "3+5(x+2)-(x+2)^{2}"] ["math" "3+5(x+2)-4(x+2)^{2}"] ["math" "3+5(x+2)-8(x+2)^{2}"] ["math" "3+5(x-2)-(x-2)^{2}"] ["math" "3+5(x-2)-8(x-2)^{2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-51237" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "3+5(x+2)-4(x+2)^{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351859" "field" nil "attribute" "question/problem" "value" "Find the third-degree Taylor polynomial ${P}_{3}(x)$ of $f(x)={e}^{-2x}$ about $x=0.$\n\n${P}_{3}(x)=1-2x\\,+$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351859" "field" nil "attribute" "question/worked-solution" "value" "To find the third-degree Taylor polynomial about $x=0,$ we plug $a=0$ into the general formula to give\n\n$$\n\\begin{aligned}{P}_{3}(x) & =f(0)+{f}^{′}(0)x+{f}^{″}(0)\\frac{{x}^{2}}{2!}+{f}^{‴}(0)\\frac{{x}^{3}}{3!} \\\\  & =f(0)+{f}^{′}(0)x+{f}^{″}(0)\\frac{{x}^{2}}{2}+{f}^{‴}(0)\\frac{{x}^{3}}{6}.\\end{aligned}\n$$\n\nWe need to compute $f(0),$ ${f}^{′}(0),$ ${f}^{″}(0),$ and ${f}^{‴}(0),$ as follows:\n\n$$\n\\begin{aligned}f(x) & ={e}^{-2x} & ⟹ &  & f(0) & ={e}^{-0}=1 \\\\ {f}^{′}(x) & =-2{e}^{-2x} & ⟹ &  & {f}^{′}(0) & =-2{e}^{-0}=-2 \\\\ {f}^{″}(x) & =4{e}^{-2x} & ⟹ &  & {f}^{″}(0) & =4{e}^{-0}=4 \\\\ {f}^{‴}(x) & =-8{e}^{-2x} & ⟹ &  & {f}^{‴}(0) & =-8{e}^{-0}=-8\\end{aligned}\n$$\n\nFinally, we plug the results for $f(0),$ ${f}^{′}(0),$ ${f}^{″}(0),$ and ${f}^{‴}(0)$ into our third-degree Taylor polynomial. This gives\n\n$$\n\\begin{aligned}{P}_{3}(x) & =1-2\\cdot x+4\\cdot \\frac{{x}^{2}}{2}-8\\cdot \\frac{{x}^{3}}{6} \\\\  & =1-2x+2{x}^{2}-\\frac{4}{3}{x}^{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351859" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/activity-metadata.json" "file_sha256" "ed88576c46d9d1ab1d0cdf5705e87aa87c709db3ce41fab7faff65f4a7c004da"} {"question" "q-351859" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351859" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "2x^2-\\frac{4}{3}x^3"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-12380" "field" nil "attribute" "question/problem" "value" "The third-degree Taylor polynomial of $f(x)={e}^{-x}\\operatorname{cos}⁡x$ about $x=0$ is" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-12380" "field" nil "attribute" "question/worked-solution" "value" "To find the third-degree Taylor polynomial about $x=0,$ we plug $a=0$ into the general formula to give\n\n$$\n\\begin{aligned}{P}_{3}(x) & =f(0)+{f}^{′}(0)x+{f}^{″}(0)\\frac{{x}^{2}}{2!}+{f}^{‴}(0)\\frac{{x}^{3}}{3!} \\\\  & =f(0)+{f}^{′}(0)x+{f}^{″}(0)\\frac{{x}^{2}}{2}+{f}^{‴}(0)\\frac{{x}^{3}}{6}.\\end{aligned}\n$$\n\nWe need to compute $f(0),$ ${f}^{′}(0),$ ${f}^{″}(0),$ and ${f}^{‴}(0),$ as follows:\n\n$$\n\\begin{aligned}f(x) & ={e}^{-x}\\operatorname{cos}⁡x & ⟹ &  & f(0) & ={e}^{-0}\\operatorname{cos}⁡0=1 \\\\ {f}^{′}(x) & =-{e}^{-x}\\operatorname{cos}⁡x-{e}^{-x}\\operatorname{sin}⁡x & ⟹ &  & {f}^{′}(0) & =-{e}^{-0}\\operatorname{cos}⁡0-{e}^{0}\\operatorname{sin}⁡0=-1 \\\\ {f}^{″}(x) & =2{e}^{-x}\\operatorname{sin}⁡x & ⟹ &  & {f}^{″}(0) & =2{e}^{-0}\\operatorname{sin}⁡0=0 \\\\ {f}^{‴}(x) & =-2{e}^{-x}\\operatorname{sin}⁡x+2{e}^{-x}\\operatorname{cos}⁡x & ⟹ &  & {f}^{‴}(0) & =-2{e}^{-0}\\operatorname{sin}⁡0+2{e}^{-0}\\operatorname{cos}⁡0=2\\end{aligned}\n$$\n\nFinally, we plug the results for $f(0),$ ${f}^{′}(0),$ ${f}^{″}(0),$ and ${f}^{‴}(0)$ into our third-degree Taylor polynomial. This gives\n\n$$\n\\begin{aligned}{P}_{3}(x) & =1+(-1)\\cdot x+0\\cdot \\frac{{x}^{2}}{2}+(2)\\cdot \\frac{{x}^{3}}{6} \\\\  & =1-x+\\frac{{x}^{3}}{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-12380" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/activity-metadata.json" "file_sha256" "ed88576c46d9d1ab1d0cdf5705e87aa87c709db3ce41fab7faff65f4a7c004da"} {"question" "q-12380" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-12380" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "1+\\frac{{x}^{2}}{2}+\\frac{{x}^{3}}{6}"] ["math" "1-x+\\frac{{x}^{3}}{3}"] ["math" "1-x+\\frac{{x}^{3}}{6}"] ["math" "x+\\frac{{x}^{2}}{2}+\\frac{{x}^{3}}{3}"] ["math" "x+\\frac{{x}^{3}}{2}-\\frac{{x}^{5}}{6}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-12380" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "1-x+\\frac{{x}^{3}}{3}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-348351" "field" nil "attribute" "question/problem" "value" "Find the third-degree Taylor polynomial ${P}_{3}(x)$ of $f(x)={e}^{x}$ about $x=0.$\n\n${P}_{3}(x)=1+x\\,+$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-348351" "field" nil "attribute" "question/worked-solution" "value" "To find the third-degree Taylor polynomial about $x=0,$ we plug $a=0$ into the general formula to give\n\n$$\n\\begin{aligned}{P}_{3}(x) & =f(0)+{f}^{′}(0)x+{f}^{″}(0)\\frac{{x}^{2}}{2!}+{f}^{‴}(0)\\frac{{x}^{3}}{3!} \\\\  & =f(0)+{f}^{′}(0)x+{f}^{″}(0)\\frac{{x}^{2}}{2}+{f}^{‴}(0)\\frac{{x}^{3}}{6}.\\end{aligned}\n$$\n\nWe need to compute $f(0),$ ${f}^{′}(0),$ ${f}^{″}(0),$ and ${f}^{‴}(0),$ as follows:\n\n$$\n\\begin{aligned}f(x) & ={e}^{x} & ⟹ &  & f(0) & ={e}^{0}=1 \\\\ {f}^{′}(x) & ={e}^{x} & ⟹ &  & {f}^{′}(0) & ={e}^{0}=1 \\\\ {f}^{″}(x) & ={e}^{x} & ⟹ &  & {f}^{″}(0) & ={e}^{0}=1 \\\\ {f}^{‴}(x) & ={e}^{x} & ⟹ &  & {f}^{‴}(0) & ={e}^{0}=1\\end{aligned}\n$$\n\nFinally, we plug the results for $f(0),$ ${f}^{′}(0),$ ${f}^{″}(0),$ and ${f}^{‴}(0)$ into our third-degree Taylor polynomial. This gives\n\n$$\n\\begin{aligned}{P}_{3}(x) & =1+1\\cdot x+1\\cdot \\frac{{x}^{2}}{2}+1\\cdot \\frac{{x}^{3}}{6} \\\\  & =1+x+\\frac{1}{2}{x}^{2}+\\frac{1}{6}{x}^{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-348351" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/activity-metadata.json" "file_sha256" "ed88576c46d9d1ab1d0cdf5705e87aa87c709db3ce41fab7faff65f4a7c004da"} {"question" "q-348351" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-348351" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{x^2}{2}+\\frac{x^3}{6}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351999" "field" nil "attribute" "question/problem" "value" "Find the third-degree Taylor polynomial ${P}_{3}(x)$ of $f(x)=\\frac{1}{{x}^{2}}$ about $x=1.$ Do not round the answer.\n\n${P}_{3}(x)=1\\,-$\n{{field-1}}\n$(x-1)\\,+$\n{{field-2}}\n$(x-1)^{2}\\,-$\n{{field-3}}\n$(x-1)^{3}$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351999" "field" nil "attribute" "question/worked-solution" "value" "To find the third-degree Taylor polynomial about $x=1,$ we plug $a=1$ into the general formula to give \n\n$$\n\\begin{aligned}{P}_{3}(x)=f(1)+{f}^{′}(1)(x-1)+\\frac{{f}^{″}(1)}{2!}(x-1)^{2}+\\frac{{f}^{‴}(1)}{3!}(x-1)^{3} \\\\ {P}_{3}(x)=f(1)+{f}^{′}(1)(x-1)+\\frac{{f}^{″}(1)}{2}(x-1)^{2}+\\frac{{f}^{‴}(1)}{6}(x-1)^{3}.\\end{aligned}\n$$\n\nWe need to compute $f(1),$ ${f}^{′}(1),$ ${f}^{″}(1),$ and ${f}^{‴}(1),$ as follows:\n\n$$\n\\begin{aligned}f(x) & =\\frac{1}{{x}^{2}} & ⟹ &  & f(1) & =\\frac{1}{{1}^{2}}=1 \\\\ {f}^{′}(x) & =-\\frac{2}{{x}^{3}} & ⟹ &  & {f}^{′}(1) & =-\\frac{2}{{1}^{3}}=-2 \\\\ {f}^{″}(x) & =\\frac{6}{{x}^{4}} & ⟹ &  & {f}^{″}(1) & =\\frac{6}{{1}^{4}}=6 \\\\ {f}^{‴}(x) & =-\\frac{24}{{x}^{5}} & ⟹ &  & {f}^{‴}(1) & =-\\frac{24}{{1}^{5}}=-24\\end{aligned}\n$$\n\nFinally, we plug the results for $f(1),$ ${f}^{′}(1),$ ${f}^{″}(1),$ and ${f}^{‴}(1)$ into our third-degree Taylor polynomial. This gives\n\n$$\n\\begin{aligned}{P}_{3}(x) & =(1)+(-2)\\cdot (x-1)+\\frac{(6)}{2}\\cdot (x-1)^{2}+\\frac{(-24)}{6}\\cdot (x-1)^{3} \\\\  & =1-2(x-1)+3(x-1)^{2}-4(x-1)^{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351999" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/activity-metadata.json" "file_sha256" "ed88576c46d9d1ab1d0cdf5705e87aa87c709db3ce41fab7faff65f4a7c004da"} {"question" "q-351999" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351999" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351999" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351999" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "3"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351999" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351999" "field" "field-3" "attribute" "answer-field/correct" "value" [:answer.type/math "4"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351997" "field" nil "attribute" "question/problem" "value" "Find the third-degree Taylor polynomial ${P}_{3}(x)$ of $f(x)={e}^{2x}$ about $x=1.$ Do not round the answer.\n\n${P}_{3}(x)={e}^{2}\\,+$\n{{field-1}}\n$(x-1)\\,+$\n{{field-2}}\n$(x-1)^{2}\\,+$\n{{field-3}}\n$(x-1)^{3}$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351997" "field" nil "attribute" "question/worked-solution" "value" "To find the third-degree Taylor polynomial about $x=1,$ we plug $a=1$ into the general formula to give \n\n$$\n\\begin{aligned}{P}_{3}(x)=f(1)+{f}^{′}(1)(x-1)+\\frac{{f}^{″}(1)}{2!}(x-1)^{2}+\\frac{{f}^{‴}(1)}{3!}(x-1)^{3} \\\\ {P}_{3}(x)=f(1)+{f}^{′}(1)(x-1)+\\frac{{f}^{″}(1)}{2}(x-1)^{2}+\\frac{{f}^{‴}(1)}{6}(x-1)^{3}.\\end{aligned}\n$$\n\nWe need to compute $f(1),$ ${f}^{′}(1),$ ${f}^{″}(1),$ and ${f}^{‴}(1),$ as follows:\n\n$$\n\\begin{aligned}f(x) & ={e}^{2x} & ⟹ &  & f(1) & ={e}^{2\\cdot 1}={e}^{2} \\\\ {f}^{′}(x) & =2{e}^{2x} & ⟹ &  & {f}^{′}(1) & =2{e}^{2\\cdot 1}=2{e}^{2} \\\\ {f}^{″}(x) & =4{e}^{2x} & ⟹ &  & {f}^{″}(1) & =4{e}^{2\\cdot 1}=4{e}^{2} \\\\ {f}^{‴}(x) & =8{e}^{2x} & ⟹ &  & {f}^{‴}(1) & =8{e}^{2\\cdot 1}=8{e}^{2}\\end{aligned}\n$$\n\nFinally, we plug the results for $f(1),$ ${f}^{′}(1),$ ${f}^{″}(1),$ and ${f}^{‴}(1)$ into our third-degree Taylor polynomial. This gives\n\n$$\n\\begin{aligned}{P}_{3}(x)={e}^{2}+2{e}^{2}(x-1)+2{e}^{2}(x-1)^{2}+\\frac{4{e}^{2}}{3}(x-1)^{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351997" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/activity-metadata.json" "file_sha256" "ed88576c46d9d1ab1d0cdf5705e87aa87c709db3ce41fab7faff65f4a7c004da"} {"question" "q-351997" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351997" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "2e^2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351997" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351997" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "2e^2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351997" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351997" "field" "field-3" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{4}{3}e^2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-126359" "field" nil "attribute" "question/problem" "value" "What is the coefficient of ${x}^{3}$ in the third-degree Taylor polynomial of $f(x)=\\frac{1}{1-x}$ about $x=0?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-126359" "field" nil "attribute" "question/worked-solution" "value" "The coefficient of ${x}^{3}$ is $\\frac{1}{3!}{f}^{(3)}(0).$ Let's compute the necessary derivatives:\n\n$$\n\\begin{aligned}f(x) & =\\frac{1}{1-x} \\\\ {f}^{′}(x) & =\\frac{1}{(1-x)^{2}} \\\\ {f}^{″}(x) & =\\frac{2}{(1-x)^{3}} \\\\ {f}^{‴}(x) & =\\frac{6}{(1-x)^{4}}\\end{aligned}\n$$\n\nNext, we evaluate ${f}^{‴}(0),$ which gives\n\n$$\n{f}^{‴}(0)=\\frac{6}{(1-0)^{4}}=6.\n$$\n\nTherefore,\n\n$$\n\\frac{1}{3!}{f}^{‴}(0)=\\frac{1}{6}\\cdot 6=1.\n$$\n\nSo the coefficient of ${x}^{3}$ is $1.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-126359" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/activity-metadata.json" "file_sha256" "ed88576c46d9d1ab1d0cdf5705e87aa87c709db3ce41fab7faff65f4a7c004da"} {"question" "q-126359" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-126359" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-6"] ["math" "1"] ["math" "3"] ["math" "6"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-126359" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "1"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-126357" "field" nil "attribute" "question/problem" "value" "What is the coefficient of ${x}^{3}$ in the third-degree Taylor polynomial of $f(x)=\\operatorname{ln}⁡(2-x)$ about $x=0?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-126357" "field" nil "attribute" "question/worked-solution" "value" "The coefficient of ${x}^{3}$ is $\\frac{1}{3!}{f}^{(3)}(0).$ Let's compute the necessary derivatives:\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{ln}⁡(2-x) \\\\ {f}^{′}(x) & =-\\frac{1}{2-x} \\\\ {f}^{″}(x) & =-\\frac{1}{(2-x)^{2}} \\\\ {f}^{‴}(x) & =-\\frac{2}{(2-x)^{3}}\\end{aligned}\n$$\n\nNext, we evaluate ${f}^{‴}(0),$ which gives\n\n$$\n{f}^{‴}(0)=-\\frac{2}{(2-0)^{3}}=-\\frac{1}{4}.\n$$\n\nTherefore,\n\n$$\n\\frac{1}{3!}{f}^{‴}(0)=\\frac{1}{6}\\cdot (-\\frac{1}{4})=-\\frac{1}{24}.\n$$\n\nSo the coefficient of ${x}^{3}$ is $-\\frac{1}{24}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-126357" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/activity-metadata.json" "file_sha256" "ed88576c46d9d1ab1d0cdf5705e87aa87c709db3ce41fab7faff65f4a7c004da"} {"question" "q-126357" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-126357" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{1}{24}"] ["math" "-\\frac{1}{3}"] ["math" "-\\frac{1}{6}"] ["math" "\\frac{1}{48}"] ["math" "\\frac{2}{3}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-126357" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{1}{24}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-348019" "field" nil "attribute" "question/problem" "value" "Find the coefficient of ${x}^{3}$ in the third-degree Taylor polynomial of $f(x)=\\operatorname{ln}⁡(2+x)$ about $x=0.$ Do not round the answer.\n\nThe coefficient of ${x}^{3}$ is\n{{field-1}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-348019" "field" nil "attribute" "question/worked-solution" "value" "The coefficient of ${x}^{3}$ is $\\frac{1}{3!}{f}^{(3)}(0).$ Let's compute the necessary derivatives:\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{ln}⁡(2+x) \\\\ {f}^{′}(x) & =\\frac{1}{2+x} \\\\ {f}^{″}(x) & =-\\frac{1}{(2+x)^{2}} \\\\ {f}^{‴}(x) & =\\frac{2}{(2+x)^{3}}\\end{aligned}\n$$\n\nNext, we evaluate ${f}^{‴}(0),$ which gives\n\n$$\n{f}^{‴}(0)=\\frac{2}{(2+0)^{3}}=\\frac{2}{8}=\\frac{1}{4}.\n$$\n\nTherefore,\n\n$$\n\\frac{1}{3!}{f}^{‴}(0)=\\frac{1}{3!}\\cdot \\frac{1}{4}=\\frac{1}{24}.\n$$\n\nSo, the coefficient of ${x}^{3}$ is $\\frac{1}{24}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-348019" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/activity-metadata.json" "file_sha256" "ed88576c46d9d1ab1d0cdf5705e87aa87c709db3ce41fab7faff65f4a7c004da"} {"question" "q-348019" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-348019" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{24}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351869" "field" nil "attribute" "question/problem" "value" "Find the coefficient of $(x-3)^{3}$ in the third-degree Taylor polynomial of $f(x)=\\frac{1}{x}$ about $x=3.$ Do not round the answer.\n\nThe coefficient of $(x-3)^{3}$ is\n{{field-1}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351869" "field" nil "attribute" "question/worked-solution" "value" "The coefficient of $(x-3)^{3}$ is $\\frac{1}{3!}{f}^{‴}(3).$ Let's compute the necessary derivatives:\n\n$$\n\\begin{aligned}f(x) & =\\frac{1}{x} \\\\ {f}^{′}(x) & =-\\frac{1}{{x}^{2}} \\\\ {f}^{″}(x) & =\\frac{2}{{x}^{3}} \\\\ {f}^{‴}(x) & =-\\frac{6}{{x}^{4}}\\end{aligned}\n$$\n\nNext, we evaluate ${f}^{‴}(3),$ which gives\n\n$$\n{f}^{‴}(3)=-\\frac{6}{{3}^{4}}=-\\frac{6}{81}=-\\frac{2}{27}.\n$$\n\nTherefore,\n\n$$\n\\frac{1}{3!}{f}^{‴}(3)=\\frac{1}{3!}\\cdot (-\\frac{2}{27})=-\\frac{2}{6\\cdot 27}=-\\frac{1}{81}.\n$$\n\nSo, the coefficient of $(x-3)^{3}$ is $-\\frac{1}{81}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351869" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/activity-metadata.json" "file_sha256" "ed88576c46d9d1ab1d0cdf5705e87aa87c709db3ce41fab7faff65f4a7c004da"} {"question" "q-351869" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-351869" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{1}{81}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-125925" "field" nil "attribute" "question/problem" "value" "What is the coefficient of ${(x+\\frac{1}{3})}^{3}$ in the third-degree Taylor polynomial of $f(x)={e}^{-3x}$ about $x=-\\frac{1}{3}?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-125925" "field" nil "attribute" "question/worked-solution" "value" "The coefficient of ${(x+\\frac{1}{3})}^{3}$ is $\\frac{1}{3!}{f}^{(3)}(-\\frac{1}{3}).$ Let's compute the necessary derivatives:\n\n$$\n\\begin{aligned}f(x) & ={e}^{-3x} \\\\ {f}^{′}(x) & =-3{e}^{-3x} \\\\ {f}^{″}(x) & =9{e}^{-3x} \\\\ {f}^{‴}(x) & =-27{e}^{-3x}\\end{aligned}\n$$\n\nNext, we evaluate ${f}^{‴}(-\\frac{1}{3}),$ which gives\n\n$$\n{f}^{‴}(-\\frac{1}{3})=-27\\cdot {e}^{-3\\cdot (-1/3)}=-27e.\n$$\n\nTherefore,\n\n$$\n\\frac{1}{3!}{f}^{‴}(-\\frac{1}{3})=\\frac{1}{6}\\cdot (-27e)=-\\frac{9e}{2}.\n$$\n\nSo the coefficient of ${(x+\\frac{1}{3})}^{3}$ is $-\\frac{9e}{2}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-125925" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/activity-metadata.json" "file_sha256" "ed88576c46d9d1ab1d0cdf5705e87aa87c709db3ce41fab7faff65f4a7c004da"} {"question" "q-125925" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-125925" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{3e}{2}"] ["math" "-\\frac{3}{2e}"] ["math" "-\\frac{9e}{2}"] ["math" "\\frac{9}{2e}"] ["math" "\\frac{e}{3}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "q-125925" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{9e}{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/state.json" "file_sha256" "48984138d58b7109f089730a9e87c0e17496a2feb4c9ebe33157bed3f0288222"} {"question" "e-7115" "field" nil "attribute" "question/problem" "value" "Let $f(x)$ be a function with $f(-1)=-1, f'(-1)=3, f''(-1)=-6$ and $f'''(-1)=6.$ What is the third-degree Taylor polynomial for $f(x)$ about $x=-1?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/example-7115.json" "file_sha256" "640925b8bdd9c99effb36fdbb1851d8b342431ed4ca366573f8c76d83e5808ae"} {"question" "e-7115" "field" nil "attribute" "question/worked-solution" "value" "The third-degree Taylor polynomial of $f(x)$ about $x=-1$ is\n\n$$\n\\begin{aligned}{P}_{3}(x) & =f(-1)+{f}^{′}(-1)(x+1)+\\frac{{f}^{″}(-1)}{2!}(x+1)^{2}+\\frac{{f}^{‴}(-1)}{3!}(x+1)^{3} \\\\  & =f(-1)+{f}^{′}(-1)(x+1)+\\frac{{f}^{″}(-1)}{2}(x+1)^{2}+\\frac{{f}^{‴}(-1)}{6}(x+1)^{3}.\\end{aligned}\n$$\n\nWe have been given the following set of values: \n\n$$\n\\begin{aligned}f(-1) & =-1 \\\\ {f}^{′}(-1) & =3 \\\\ {f}^{″}(-1) & =-6 \\\\ {f}^{‴}(-1) & =6.\\end{aligned}\n$$\n\nSubstituting the given values into our Taylor polynomial, we get\n\n$$\n\\begin{aligned}{P}_{3}(x) & =-1+3(x+1)+\\frac{(-6)}{2}(x+1)^{2}+\\frac{6}{6}(x+1)^{3} \\\\  & =-1+3(x+1)-3(x+1)^{2}+(x+1)^{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/example-7115.json" "file_sha256" "640925b8bdd9c99effb36fdbb1851d8b342431ed4ca366573f8c76d83e5808ae"} {"question" "e-741" "field" nil "attribute" "question/problem" "value" "Find the third-degree Taylor polynomial of $f(x) = \\ln(1+x)$ about $x=0.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/example-741.json" "file_sha256" "414bfc035b1b8becbbf4a98c6851c1629b2b492a2fa539284cc819246a500b40"} {"question" "e-741" "field" nil "attribute" "question/worked-solution" "value" "To find the third-degree Taylor polynomial about $x=0,$ we plug $a=0$ into the general formula to give\n\n$$\nP_3(x) = f(0) + f'(0)(x-0) + \\dfrac{1}{2!}f''(0)(x-0)^2 + \\dfrac{1}{3!}f'''(0)(x-0)^3.\n$$\n\nWe need to compute $f(0),$ $f'(0),$ $f''(0),$ and $f'''(0),$ as follows:\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{ln}⁡(1+x) & ⟹ &  & f(0) & =\\operatorname{ln}⁡(1+0)=0 \\\\ {f}^{′}(x) & =(1+x)^{-1} & ⟹ &  & {f}^{′}(0) & =(1+0)^{-1}=1 \\\\ {f}^{″}(x) & =-(1+x)^{-2} & ⟹ &  & {f}^{″}(0) & =-(1+0)^{-2}=-1 \\\\ {f}^{(3)}(x) & =2(1+x)^{-3} & ⟹ &  & {f}^{‴}(0) & =2(1+0)^{-3}=2.\\end{aligned}\n$$\n\nFinally, we plug the results for $f(0),$ $f'(0),$ $f''(0),$ and $f'''(0)$ into our third-degree Taylor polynomial. This gives\n\n$$\n\\begin{aligned}{P}_{3}(x) & =0+(1)(x-0)+\\frac{1}{2!}(-1)(x-0)^{2}+\\frac{1}{3!}(2)(x-0)^{3} \\\\  & =x-\\frac{{x}^{2}}{2}+\\frac{{x}^{3}}{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/example-741.json" "file_sha256" "414bfc035b1b8becbbf4a98c6851c1629b2b492a2fa539284cc819246a500b40"} {"question" "e-742" "field" nil "attribute" "question/problem" "value" "What is the coefficient of $(x-1)^3$ in the third-degree Taylor polynomial of $f(x) = e^{-2x}?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/example-742.json" "file_sha256" "13e6cad25de80a63024c0f2b4905652cca01f7106ec23a86025ad57de4e39d1b"} {"question" "e-742" "field" nil "attribute" "question/worked-solution" "value" "The coefficient of $(x-1)^3$ is $\\dfrac{1}{3!}f^{(3)}(1).$ Let's compute the necessary derivatives:\n\n$$\n\\begin{aligned}f(x) & ={e}^{-2x} \\\\ {f}^{′}(x) & =-2{e}^{-2x} \\\\ {f}^{″}(x) & =4{e}^{-2x} \\\\ {f}^{(3)}(x) & =-8{e}^{-2x}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\dfrac{1}{3!}f^{(3)}(1) =\\dfrac{1}{6} \\left( -8e^{-2} \\right) = -\\dfrac{4}{3e^2}.\n$$\n\nSo the coefficient of $(x-1)^3$ is $-\\dfrac{4}{3e^2}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060752/example-742.json" "file_sha256" "13e6cad25de80a63024c0f2b4905652cca01f7106ec23a86025ad57de4e39d1b"}] "usage" {"e-742" [] "q-125925" [] "q-348351" [] "q-351859" [] "e-7115" [] "q-351832" [] "q-126359" [] "q-351997" [] "e-741" [] "q-51235" [] "q-51238" []} "basis" 1947 "retractions" [] "immutable_answers" [17592186099901 17592186099902 17592186099903 17592186099904 17592186099905 17592186299112 17592186299113 17592186299114 17592186299115 17592186299116 17592186299134 17592186299135 17592186299142 17592186299144 17592186299146 17592186299159 17592186299161 17592186299163 17592186299166 17592186299167 17592186299168 17592186299169 17592186299170 17592186331941 17592186331942 17592186331943 17592186331944 17592186331945 17592186331955] "immutable_fields" [[17592186099900 :answer-field/correct] [17592186099900 :answer-field/id] [17592186099900 :answer-field/key] [17592186099900 :answer-field/type] [17592186299111 :answer-field/correct] [17592186299111 :answer-field/id] [17592186299111 :answer-field/key] [17592186299111 :answer-field/type] [17592186299133 :answer-field/correct] [17592186299133 :answer-field/id] [17592186299133 :answer-field/key] [17592186299133 :answer-field/type] [17592186299141 :answer-field/correct] [17592186299141 :answer-field/id] [17592186299141 :answer-field/key] [17592186299141 :answer-field/type] [17592186299143 :answer-field/correct] [17592186299143 :answer-field/id] [17592186299143 :answer-field/key] [17592186299143 :answer-field/type] [17592186299145 :answer-field/correct] [17592186299145 :answer-field/id] [17592186299145 :answer-field/key] [17592186299145 :answer-field/type] [17592186299158 :answer-field/correct] [17592186299158 :answer-field/id] [175