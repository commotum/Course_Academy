      "source": [
        {
          "question": "e-12664",
          "field": null,
          "attribute": "question/problem",
          "value": "Find the minimum value of $Q(\\mathbf{x})=16x_1^2+16x_1x_2+x_2^2$ given that $16x_1^2 + x_2^2=16,$ and find the vector $\\mathbf{x}$ at which the minimum is obtained.",
          "category": "ma_capture",
          "file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14077353/example-12664.json",
          "file_sha256": "7277b35500f4a90e9c975692a8cbfcd687f468d94cc9f57e1b143c625102ce26"
