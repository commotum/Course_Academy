138086/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6115493b-482c-5360-8d19-52582228e21d"] :knowledge-point/questions ["q-138086"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186198488 :question/answer-fields 17592186193829] {:db/id "q-138085/selection/ma-v1/fe6fcce74bce2462aa2549bff473afee1f5a893df81005ba6185742d8a70b875/c605d8ed6c512d31b6710247b3a66630b338702cf519f73f94fbf24ff675be3c" :answer/id #uuid "b0014d82-15b6-5aa9-b35e-3577849ed40f" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-138085/selection/ma-v1/fe6fcce74bce2462aa2549bff473afee1f5a893df81005ba6185742d8a70b875/c85c5d1b8b3d0e72ca00b622951c8d5357021615c5b1ff7fc8c778e8ef12a8ce" :answer/id #uuid "cfdcc545-3da3-5dc1-a602-b674b68212e8" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-138085/selection/ma-v1/fe6fcce74bce2462aa2549bff473afee1f5a893df81005ba6185742d8a70b875/83f85bbd7b43091064ec7ec5777c710121feceb7846900a2c67e38824b02f7f6" :answer/id #uuid "37fc2840-883a-57d5-9bca-fc87837c41ab" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{5}}[\\begin{aligned}-2 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-138085/selection/ma-v1/fe6fcce74bce2462aa2549bff473afee1f5a893df81005ba6185742d8a70b875/57ccfa5e19bbc9dfcbcffafe40dca6e201deeb133889d79885922e7d578cb51a" :answer/id #uuid "5820b6c6-b5b5-53f7-9b37-d988f36aa7ba" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-138085/selection/ma-v1/fe6fcce74bce2462aa2549bff473afee1f5a893df81005ba6185742d8a70b875/a198a7b3bc8fad9fd44f348f8312126571b13148b33fca5b53ce8959974599a8" :answer/id #uuid "d5ac8221-8c56-55b0-b652-060e0c883e57" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-138085/selection/ma-v1/fe6fcce74bce2462aa2549bff473afee1f5a893df81005ba6185742d8a70b875" :answer-field/id #uuid "b7a788b8-d662-52d5-9037-639bc3acc2d0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-138085/selection/ma-v1/fe6fcce74bce2462aa2549bff473afee1f5a893df81005ba6185742d8a70b875/c605d8ed6c512d31b6710247b3a66630b338702cf519f73f94fbf24ff675be3c" :answer-field/choices ["q-138085/selection/ma-v1/fe6fcce74bce2462aa2549bff473afee1f5a893df81005ba6185742d8a70b875/c605d8ed6c512d31b6710247b3a66630b338702cf519f73f94fbf24ff675be3c" "q-138085/selection/ma-v1/fe6fcce74bce2462aa2549bff473afee1f5a893df81005ba6185742d8a70b875/c85c5d1b8b3d0e72ca00b622951c8d5357021615c5b1ff7fc8c778e8ef12a8ce" "q-138085/selection/ma-v1/fe6fcce74bce2462aa2549bff473afee1f5a893df81005ba6185742d8a70b875/83f85bbd7b43091064ec7ec5777c710121feceb7846900a2c67e38824b02f7f6" "q-138085/selection/ma-v1/fe6fcce74bce2462aa2549bff473afee1f5a893df81005ba6185742d8a70b875/57ccfa5e19bbc9dfcbcffafe40dca6e201deeb133889d79885922e7d578cb51a" "q-138085/selection/ma-v1/fe6fcce74bce2462aa2549bff473afee1f5a893df81005ba6185742d8a70b875/a198a7b3bc8fad9fd44f348f8312126571b13148b33fca5b53ce8959974599a8"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-138085"] :question/problem "The minimum value of the quadratic form $Q(x)=3{x}_{1}^{2}-2{x}_{1}{x}_{2}+3{x}_{2}^{2},$ when $‖x‖=1,$ is equal to $2.$ Which of the following is a vector $x$ at which the minimum is attained?" :question/worked-solution "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\nmax{Q(x)\\,|\\,‖x‖=1}={\\lambda }_{\\text{max}}\n$$\n\n \nThe maximum is attained on the corresponding unit eigenvector ${u}_{\\text{max}}.$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\nmin{Q(x)\\,|\\,‖x‖=1}={\\lambda }_{\\text{min}}\n$$\n\n \nThe minimum is attained on the corresponding unit eigenvector ${u}_{\\text{min}}.$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=[\\begin{aligned}3 & -1 \\\\ -1 & 3\\end{aligned}]\n$$\n\nNow, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{\\text{min}}=2:$\n\n$$\n\\begin{aligned}A-2I & =[\\begin{aligned}3 & -1 \\\\ -1 & 3\\end{aligned}]-2[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}1 & -1 \\\\ -1 & 1\\end{aligned}]\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-2I)x=0$ gives the eigenvector $v=[\\begin{aligned}1 \\\\ 1\\end{aligned}].$  \n\nFinally, dividing $v$ by its norm $‖v‖=\\sqrt{2},$ we get \n\n$$\n{u}_{\\text{min}}=\\frac{v}{‖v‖}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ 1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-138085/selection/ma-v1/fe6fcce74bce2462aa2549bff473afee1f5a893df81005ba6185742d8a70b875"] :db/ensure [:question/validate]} [:db/retract 17592186198486 :question/answer-fields 17592186193817] {:db/id "q-136827/selection/ma-v1/ec31949420c59b30ed8871d69e838b865af3a644b53820e9800cb63f6f7c033e/23ce5badce1b5381c3e058188f6d01b1a57540d1a68cc36db54b523b7f76d1f2" :answer/id #uuid "c0850aa5-8084-5fde-88e0-5e61b5ded1ba" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{5}}[\\begin{aligned}-1 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-136827/selection/ma-v1/ec31949420c59b30ed8871d69e838b865af3a644b53820e9800cb63f6f7c033e/80f7643749639dc6ac3cb6ea590a80572731108334d6c4e6c17a301b44d6338a" :answer/id #uuid "999d3cf8-45d7-58d4-88a5-b94135834e61" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-136827/selection/ma-v1/ec31949420c59b30ed8871d69e838b865af3a644b53820e9800cb63f6f7c033e/c85c5d1b8b3d0e72ca00b622951c8d5357021615c5b1ff7fc8c778e8ef12