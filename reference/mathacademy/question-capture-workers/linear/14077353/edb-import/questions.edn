nswer/id #uuid "a4cb1427-7d08-5ff4-b2b7-188d638774b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{5}}\\begin{bmatrix}-2 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186194568} {:answer/id #uuid "fcd92263-f17f-56b4-ad42-8305e1f2b0e2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186194569} {:answer/id #uuid "1d548a45-e984-542b-ba5c-b38f1f96b8f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{10}}\\begin{bmatrix}-1 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186194570} {:answer/id #uuid "645dfab2-6af2-5ca0-ab81-fd3454d63510" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{5}}\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186194571} {:answer/id #uuid "650043f8-8fcf-510f-98f3-aa2dacefe7bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{10}}\\begin{bmatrix}-2 \\\\ 9\\end{bmatrix}" :db/id #edb/ref 17592186194572}] :answer-field/correct {:answer/id #uuid "650043f8-8fcf-510f-98f3-aa2dacefe7bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{10}}\\begin{bmatrix}-2 \\\\ 9\\end{bmatrix}" :db/id #edb/ref 17592186194572} :answer-field/id #uuid "93cf70f3-ba98-56b7-a677-47eefb35a3c0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186194567}] :question/id #uuid "38171cb4-52a5-5ebe-b692-159c5b30da34" :question/math-academy-id "q-170138" :question/problem "The maximum value of $Q(x) = x_{1}^{2} - 4x_{1}x_{2} + 4x_{2}^{2}$, when $9x_{1}^{2} + 4x_{2}^{2} = 36$, is $40$. Which of the following is a vector $x$ at which the maximum is attained?"}]}
