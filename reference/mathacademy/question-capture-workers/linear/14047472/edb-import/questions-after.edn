#{[{:db/id #edb/ref 17592186277040 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dd25a02-4e2e-592b-b869-2889bf56d0f5" :answer/type {:db/ident :answer.type/text} :answer/value "$H$ and $K$ only" :db/id #edb/ref 17592186277042} {:answer/id #uuid "a7780f8d-92ee-5bee-acda-ac38b221ba98" :answer/type {:db/ident :answer.type/text} :answer/value "$J$ and $K$ only" :db/id #edb/ref 17592186277043} {:answer/id #uuid "d0033e22-6e20-53c9-b6ad-5502fdbe9286" :answer/type {:db/ident :answer.type/text} :answer/value "$H$ and $J$ only" :db/id #edb/ref 17592186277044} {:answer/id #uuid "66eb4339-b5c8-5b6f-a9c6-736fc2c5a548" :answer/type {:db/ident :answer.type/text} :answer/value "$H$ only" :db/id #edb/ref 17592186277045} {:answer/id #uuid "bc62ee22-7c25-5746-b95d-31e50a024745" :answer/type {:db/ident :answer.type/text} :answer/value "$J$ only" :db/id #edb/ref 17592186277046}] :answer-field/correct {:answer/id #uuid "d0033e22-6e20-53c9-b6ad-5502fdbe9286" :answer/type {:db/ident :answer.type/text} :answer/value "$H$ and $J$ only" :db/id #edb/ref 17592186277044} :answer-field/id #uuid "5e00ec5e-d2cb-5618-b9fc-572db656a6be" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277041}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1b4d40e2-069c-5e10-923d-ef1e82d45a9d" :question/math-academy-id "q-11717" :question/problem "Which of the matrices below are singular?\n\n$$\nH=[\\begin{aligned}5 & 0 \\\\ 3 & 0\\end{aligned}],\\,J=[\\begin{aligned}2 & 4 \\\\ 3 & 6\\end{aligned}],\\,K=[\\begin{aligned}1 & 4 \\\\ 0 & 5 \\\\ -3 & 0\\end{aligned}].\n$$" :question/worked-solution "- For the matrix $H$, we have\n\n$$\ndet(H)=5\\cdot 0-3\\cdot 0=0.\n$$\n\nBecause $det(H)=0,$ we conclude that $H$ is not invertible. Since $H$ is a square matrix that is not invertible, we also say that $H$ is singular.\n\n- For the matrix $J$, we have\n\n$$\ndet(J)=2\\cdot 6-3\\cdot 4=0.\n$$\n\nBecause $det(J)=0,$ we conclude that $J$ is not invertible. Since $J$ is a square matrix that is not invertible, we also say that $J$ is singular.\n\n- The matrix $K$ is a $3\\times 2$ matrix. So, it is not invertible. Since the matrix is not square, we can't say that it's singular.\n\nTherefore, only $H$ and $J$ is singular."}] [{:db/id #edb/ref 17592186327124 :knowledge-point/_questions [{:knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01" :knowledge-point/title "Solving for a Variable in a Singular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3609191a-ea7f-5f46-b68d-43403d91dce0" :answer/type {:db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186327126} {:answer/id #uuid "9700e50f-207f-55a4-a30f-f6a8efcec49d" :answer/type {:db/ident :answer.type/math} :answer/value "k=1" :db/id #edb/ref 17592186327127} {:answer/id #uuid "af128e03-0ee3-5c65-99b8-cbfef7638f2f" :answer/type {:db/ident :answer.type/math} :answer/value "k=-1" :db/id #edb/ref 17592186327128} {:answer/id #uuid "3958ce1b-3d24-568a-b924-8eb19137860a" :answer/type {:db/ident :answer.type/math} :answer/value "k=-3" :db/id #edb/ref 17592186327129} {:answer/id #uuid "d1701e43-66a4-5a3a-85e6-055d5c7fe17a" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186327130}] :answer-field/correct {:answer/id #uuid "9700e50f-207f-55a4-a30f-f6a8efcec49d" :answer/type {:db/ident :answer.type/math} :answer/value "k=1" :db/id #edb/ref 17592186327127} :answer-field/id #uuid "e9fc1327-c2a1-56a5-9234-41287bcce160" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186327125}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d7637210-9ef1-5fcb-8a52-1b1182a7f30d" :question/math-academy-id "q-127899" :question/problem "If $A=[\\begin{aligned}k-1 & k-1 \\\\ 3 & -1\\end{aligned}]$ is a singular matrix, calculate the value of $k.$" :question/worked-solution "The matrix $A$ is singular if and only if $det(A)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(A) & =(k-1)\\cdot (-1)-(k-1)\\cdot 3 \\\\  & =-k+1-3k+3 \\\\  & =-4k+4\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $k:$\n\n$$\n\\begin{aligned}-4k+4 & =0 \\\\ k & =1\\end{aligned}\n$$\n\nTherefore, the value of $k$ is $k=1.$"}] [{:db/id #edb/ref 17592186327131 :knowledge-point/_questions [{:knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01" :knowledge-point/title "Solving for a Variable in a Singular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b43c0b66-c9ab-5504-b608-bf20041e7163" :answer/type {:db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186327133} {:answer/id #uuid "6c2fdb88-f3bd-58dc-8b12-f81fd77e7682" :answer/type {:db/ident :answer.type/math} :answer/value "t=5" :db/id #edb/ref 17592186327134} {:answer/id #uuid "a581bb9e-7427-50b4-96af-004a7ff31eab" :answer/type {:db/ident :answer.type/math} :answer/value "t=\\frac{1}{5}" :db/id #edb/ref 17592186327135} {:answer/id #uuid "7d18b266-5628-524a-9a64-e368223f98b1" :answer/type {:db/ident :answer.type/math} :answer/value "t=4" :db/id #edb/ref 17592186327136} {:answer/id #uuid "ab9992b3-48f7-53e4-8050-7a875c2e2d6a" :answer/type {:db/ident :answer.type/math} :answer/value "t=\\frac{1}{2}" :db/id #edb/ref 17592186327137}] :answer-field/correct {:answer/id #uuid "b43c0b66-c9ab-5504-b608-bf20041e7163" :answer/type {:db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186327133} :answer-field/id #uuid "6e7fac3f-7978-5eae-83e0-2e9fefcc1c72" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186327132}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "946cfcad-5219-5323-b969-2d09055140bf" :question/math-academy-id "q-127906" :question/problem "If $M=[\\begin{aligned}t & 2 \\\\ t & -8\\end{aligned}]$ is a singular matrix, calculate the value of $t.$" :question/worked-solution "The matrix $M$ is singular if and only if $det(M)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(M) & =t\\cdot (-8)-t\\cdot 2 \\\\  & =-8t-2t \\\\  & =-10t\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $t:$\n\n$$\n\\begin{aligned}-10t & =0 \\\\ t & =0\\end{aligned}\n$$\n\nTherefore, the value of $t$ is $t=0.$"}] [{:db/id #edb/ref 17592186327138 :knowledge-point/_questions [{:knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01" :knowledge-point/title "Solving for a Variable in a Singular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26246cc3-18d3-5d50-afc8-70956d030040" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186327140}] :answer-field/correct {:answer/id #uuid "26246cc3-18d3-5d50-afc8-70956d030040" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186327140} :answer-field/id #uuid "e63e0873-13fe-5e06-958b-e0422accea72" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186327139} {:answer-field/choices [{:answer/id #uuid "a51dd8d7-65c0-5bcb-bdd5-3a9418a9ed03" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186327142}] :answer-field/correct {:answer/id #uuid "a51dd8d7-65c0-5bcb-bdd5-3a9418a9ed03" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186327142} :answer-field/id #uuid "48de27c9-df19-5c9b-bf11-5c1264f961db" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186327141}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c2b70825-9a5f-55c4-a501-35637f350b70" :question/math-academy-id "q-313957" :question/problem "Let $B=[\\begin{aligned}x-4 & 1 \\\\ 7 & x+2\\end{aligned}]$\nbe a singular matrix. **In ascending order**, the values of $x$ are\n\n$x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "The matrix $B$ is singular if and only if $det(B)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(B) & =(x-4)\\cdot (x+2)-7\\cdot 1 \\\\  & ={x}^{2}-2x-8-7 \\\\  & ={x}^{2}-2x-15.\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $x:$\n\n$$\n\\begin{aligned}{x}^{2}-2x-15 & =0 \\\\ (x+3)(x-5) & =0 \\\\ x & =-3,5\\end{aligned}\n$$\n\nTherefore, in ascending order, the values of $x$ are\n\n$$\nx=-3\\,\\text{and}\\,x=5.\n$$"}] [{:db/id #edb/ref 17592186283827 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7d03e0d-dd0b-5bf2-8b23-b76ba4a52cb8" :answer/type {:db/ident :answer.type/text} :answer/value "$D$ and $F$ only" :db/id #edb/ref 17592186283829} {:answer/id #uuid "31e64cc4-7607-5320-b4ee-b148069f834c" :answer/type {:db/ident :answer.type/text} :answer/value "$F$ only" :db/id #edb/ref 17592186283830} {:answer/id #uuid "11647ab9-20e9-5f5d-8ca6-1654dff9013b" :answer/type {:db/ident :answer.type/text} :answer/value "$F$ and $G$ only" :db/id #edb/ref 17592186283831} {:answer/id #uuid "2bf5d5bd-33dd-5816-ab8e-7ced732d2e0a" :answer/type {:db/ident :answer.type/text} :answer/value "$D$ and $G$ only" :db/id #edb/ref 17592186283832} {:answer/id #uuid "4cbb613e-6c3c-5efa-9a2f-3fff1a8a7bf8" :answer/type {:db/ident :answer.type/text} :answer/value "$G$ only" :db/id #edb/ref 17592186283833}] :answer-field/correct {:answer/id #uuid "31e64cc4-7607-5320-b4ee-b148069f834c" :answer/type {:db/ident :answer.type/text} :answer/value "$F$ only" :db/id #edb/ref 17592186283830} :answer-field/id #uuid "5f0956b5-0f62-5fe0-afd9-ac75f12da804" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283828}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e1200f5c-4446-5343-a392-4a0d1b7415e1" :question/math-academy-id "q-7923" :question/problem "Which of the matrices below does **not** have an inverse?\n\n$$\nD=[\\begin{aligned}3 & 2 \\\\ 6 & 6\\end{aligned}],\\,F=[\\begin{aligned}6 & 6 \\\\ 6 & 6\\end{aligned}],\\,G=[\\begin{aligned}-2 & 2 \\\\ 4 & 4\\end{aligned}].\n$$" :question/worked-solution "- For the matrix $D$, we have\n\n$$\ndet(D)=3\\cdot 6-6\\cdot 2=6.\n$$\n\nBecause $det(D)\\ne 0,$ we conclude that $D$ is invertible.\n\n- For the matrix $F$, we have\n\n$$\ndet(F)=6\\cdot 6-6\\cdot 6=0.\n$$\n\nBecause $det(F)=0,$ we conclude that $F$ is not invertible.\n\n- For the matrix $G$, we have\n\n$$\ndet(G)=(-2)\\cdot 4-4\\cdot 2=-16.\n$$\n\nBecause $det(G)\\ne 0,$ we conclude that $G$ is invertible.\n\nTherefore, only $F$ does not have an inverse."}]}
