pture/13975082/edb-import/verification.json"} {"question" "q-11717" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "$J$ and $K$ only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975082/state.json" "file_sha256" "6eec2d798dc7f5a72f06bc5a6741714b2bc2facc2c86f711dc7387c957724ae9" "basis" 766 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975082/edb-import/verification.json"} {"question" "q-11717" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "$J$ only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975082/state.json" "file_sha256" "6eec2d798dc7f5a72f06bc5a6741714b2bc2facc2c86f711dc7387c957724ae9" "basis" 766 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975082/edb-import/verification.json"} {"question" "q-11717" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "$H$ and $J$ only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975082/state.json" "file_sha256" "6eec2d798dc7f5a72f06bc5a6741714b2bc2facc2c86f711dc7387c957724ae9" "basis" 766 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975082/edb-import/verification.json"} {"question" "q-7923" "field" nil "attribute" "question/problem" "value" "Which of the matrices below does **not** have an inverse?\n\n$$\nD=[\\begin{aligned}3 & 2 \\\\ 6 & 6\\end{aligned}],\\,F=[\\begin{aligned}6 & 6 \\\\ 6 & 6\\end{aligned}],\\,G=[\\begin{aligned}-2 & 2 \\\\ 4 & 4\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991694/state.json" "file_sha256" "58ff567c65138cf3abcd2c1b02bc455e98c0d2c0285f34e374c23da418e6f72e" "basis" 1033 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991694/edb-import/verification.json"} {"question" "q-7923" "field" nil "attribute" "question/worked-solution" "value" "- For the matrix $D$, we have\n\n$$\ndet(D)=3\\cdot 6-6\\cdot 2=6.\n$$\n\nBecause $det(D)\\ne 0,$ we conclude that $D$ is invertible.\n\n- For the matrix $F$, we have\n\n$$\ndet(F)=6\\cdot 6-6\\cdot 6=0.\n$$\n\nBecause $det(F)=0,$ we conclude that $F$ is not invertible.\n\n- For the matrix $G$, we have\n\n$$\ndet(G)=(-2)\\cdot 4-4\\cdot 2=-16.\n$$\n\nBecause $det(G)\\ne 0,$ we conclude that $G$ is invertible.\n\nTherefore, only $F$ does not have an inverse." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991694/state.json" "file_sha256" "58ff567c65138cf3abcd2c1b02bc455e98c0d2c0285f34e374c23da418e6f72e" "basis" 1033 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991694/edb-import/verification.json"} {"question" "q-7923" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991694/activity-metadata.json" "file_sha256" "b8a338119d773f18183b964e1d0ec6c948d1b5ea5ebaaac0f518e848bed090ec" "basis" 1033 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991694/edb-import/verification.json"} {"question" "q-7923" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991694/state.json" "file_sha256" "58ff567c65138cf3abcd2c1b02bc455e98c0d2c0285f34e374c23da418e6f72e" "basis" 1033 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991694/edb-import/verification.json"} {"question" "q-7923" "field" "selection" "attribute" "answer/va