#{[{:db/id #edb/ref 17592186277040 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dd25a02-4e2e-592b-b869-2889bf56d0f5" :answer/type {:db/ident :answer.type/text} :answer/value "$H$ and $K$ only" :db/id #edb/ref 17592186277042} {:answer/id #uuid "a7780f8d-92ee-5bee-acda-ac38b221ba98" :answer/type {:db/ident :answer.type/text} :answer/value "$J$ and $K$ only" :db/id #edb/ref 17592186277043} {:answer/id #uuid "d0033e22-6e20-53c9-b6ad-5502fdbe9286" :answer/type {:db/ident :answer.type/text} :answer/value "$H$ and $J$ only" :db/id #edb/ref 17592186277044} {:answer/id #uuid "66eb4339-b5c8-5b6f-a9c6-736fc2c5a548" :answer/type {:db/ident :answer.type/text} :answer/value "$H$ only" :db/id #edb/ref 17592186277045} {:answer/id #uuid "bc62ee22-7c25-5746-b95d-31e50a024745" :answer/type {:db/ident :answer.type/text} :answer/value "$J$ only" :db/id #edb/ref 17592186277046}] :answer-field/correct {:answer/id #uuid "d0033e22-6e20-53c9-b6ad-5502fdbe9286" :answer/type {:db/ident :answer.type/text} :answer/value "$H$ and $J$ only" :db/id #edb/ref 17592186277044} :answer-field/id #uuid "5e00ec5e-d2cb-5618-b9fc-572db656a6be" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277041}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1b4d40e2-069c-5e10-923d-ef1e82d45a9d" :question/math-academy-id "q-11717" :question/problem "Which of the matrices below are singular?\n\n$$\nH=[\\begin{aligned}5 & 0 \\\\ 3 & 0\\end{aligned}],\\,J=[\\begin{aligned}2 & 4 \\\\ 3 & 6\\end{aligned}],\\,K=[\\begin{aligned}1 & 4 \\\\ 0 & 5 \\\\ -3 & 0\\end{aligned}].\n$$" :question/worked-solution "- For the matrix $H$, we have\n\n$$\ndet(H)=5\\cdot 0-3\\cdot 0=0.\n$$\n\nBecause $det(H)=0,$ we conclude that $H$ is not invertible. Since $H$ is a square matrix that is not invertible, we also say that $H$ is singular.\n\n- For the matrix $J$, we have\n\n$$\ndet(J)=2\\cdot 6-3\\cdot 4=0.\n$$\n\nBecause $det(J)=0,$ we conclude that $J$ is not invertible. Since $J$ is a square matrix that is not invertible, we also say that $J$ is singular.\n\n- The matrix $K$ is a $3\\times 2$ matrix. So, it is not invertible. Since the matrix is not square, we can't say that it's singular.\n\nTherefore, only $H$ and $J$ is singular."}] [{:db/id #edb/ref 17592186283827 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7d03e0d-dd0b-5bf2-8b23-b76ba4a52cb8" :answer/type {:db/ident :answer.type/text} :answer/value "$D$ and $F$ only" :db/id #edb/ref 17592186283829} {:answer/id #uuid "31e64cc4-7607-5320-b4ee-b148069f834c" :answer/type {:db/ident :answer.type/text} :answer/value "$F$ only" :db/id #edb/ref 17592186283830} {:answer/id #uuid "11647ab9-20e9-5f5d-8ca6-1654dff9013b" :answer/type {:db/ident :answer.type/text} :answer/value "$F$ and $G$ only" :db/id #edb/ref 17592186283831} {:answer/id #uuid "2bf5d5bd-33dd-5816-ab8e-7ced732d2e0a" :answer/type {:db/ident :answer.type/text} :answer/value "$D$ and $G$ only" :db/id #edb/ref 17592186283832} {:answer/id #uuid "4cbb613e-6c3c-5efa-9a2f-3fff1a8a7bf8" :answer/type {:db/ident :answer.type/text} :answer/value "$G$ only" :db/id #edb/ref 17592186283833}] :answer-field/correct {:answer/id #uuid "31e64cc4-7607-5320-b4ee-b148069f834c" :answer/type {:db/ident :answer.type/text} :answer/value "$F$ only" :db/id #edb/ref 17592186283830} :answer-field/id #uuid "5f0956b5-0f62-5fe0-afd9-ac75f12da804" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283828}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e1200f5c-4446-5343-a392-4a0d1b7415e1" :question/math-academy-id "q-7923" :question/problem "Which of the matrices below does **not** have an inverse?\n\n$$\nD=[\\begin{aligned}3 & 2 \\\\ 6 & 6\\end{aligned}],\\,F=[\\begin{aligned}6 & 6 \\\\ 6 & 6\\end{aligned}],\\,G=[\\begin{aligned}-2 & 2 \\\\ 4 & 4\\end{aligned}].\n$$" :question/worked-solution "- For the matrix $D$, we have\n\n$$\ndet(D)=3\\cdot 6-6\\cdot 2=6.\n$$\n\nBecause $det(D)\\ne 0,$ we conclude that $D$ is invertible.\n\n- For the matrix $F$, we have\n\n$$\ndet(F)=6\\cdot 6-6\\cdot 6=0.\n$$\n\nBecause $det(F)=0,$ we conclude that $F$ is not invertible.\n\n- For the matrix $G$, we have\n\n$$\ndet(G)=(-2)\\cdot 4-4\\cdot 2=-16.\n$$\n\nBecause $det(G)\\ne 0,$ we conclude that $G$ is invertible.\n\nTherefore, only $F$ does not have an inverse."}]}
