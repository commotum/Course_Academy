#{[{:db/id #edb/ref 17592186346960 :knowledge-point/_questions [{:knowledge-point/id #uuid "6bde92b0-4e98-5c2e-848e-7a5febc848ae" :knowledge-point/title "Finding the Acute Angle Between Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f8eb951-a2a7-528c-8bea-a600bf7d2c80" :answer/type {:db/ident :answer.type/math} :answer/value "{86.22}^{∘}" :db/id #edb/ref 17592186346962} {:answer/id #uuid "7df12db8-d3f4-5bda-a07b-bfab982ab955" :answer/type {:db/ident :answer.type/math} :answer/value "{65.86}^{∘}" :db/id #edb/ref 17592186346963} {:answer/id #uuid "3db2a0b8-865c-53ac-adf9-ccf04d06f9d7" :answer/type {:db/ident :answer.type/math} :answer/value "{75.28}^{∘}" :db/id #edb/ref 17592186346964} {:answer/id #uuid "5742c222-5888-56a0-8cdd-4627358e0f68" :answer/type {:db/ident :answer.type/math} :answer/value "{83.01}^{∘}" :db/id #edb/ref 17592186346965} {:answer/id #uuid "22e724d0-fed6-5280-8185-6a6e29c1890c" :answer/type {:db/ident :answer.type/math} :answer/value "{72.45}^{∘}" :db/id #edb/ref 17592186346966}] :answer-field/correct {:answer/id #uuid "5742c222-5888-56a0-8cdd-4627358e0f68" :answer/type {:db/ident :answer.type/math} :answer/value "{83.01}^{∘}" :db/id #edb/ref 17592186346965} :answer-field/id #uuid "0a421f54-54f8-5aac-bd07-b1be735644fa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186346961}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c7c3de82-a6ca-5d73-b4dc-f392cbdf19fd" :question/math-academy-id "q-140444" :question/problem "Rounded to two decimal places, what is the acute angle between the vectors $v=[\\begin{aligned}-1 \\\\ 2 \\\\ 0 \\\\ 5\\end{aligned}]$ and $w=[\\begin{aligned}4 \\\\ 4 \\\\ -2 \\\\ 0\\end{aligned}]?$" :question/worked-solution "Using the formula\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{v\\cdot w}{‖v‖\\,‖w‖},\n$$\n\nwe have the following:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{{v}_{1}{w}_{1}+{v}_{2}{w}_{2}+{v}_{3}{w}_{3}+{v}_{4}{w}_{4}}{\\sqrt{{v}_{1}^{2}+{v}_{2}^{2}+{v}_{3}^{2}+{v}_{4}^{2}}\\,\\sqrt{{w}_{1}^{2}+{w}_{2}^{2}+{w}_{3}^{2}+{w}_{4}^{2}}} \\\\  & =\\frac{(-1)\\cdot 4+2\\cdot 4+0\\cdot (-2)+5\\cdot 0}{\\sqrt{{1}^{2}+(-2)^{2}+{0}^{2}+{5}^{2}}\\,\\sqrt{{4}^{2}+{4}^{2}+(-2)^{2}+{0}^{2}}} \\\\  & =\\frac{4}{\\sqrt{30}\\cdot \\sqrt{36}} \\\\  & =\\frac{4}{6\\sqrt{30}} \\\\  & =\\frac{2}{3\\sqrt{30}}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{2}{3\\sqrt{30}})≈{83.01}^{∘}.\n$$"}] [{:db/id #edb/ref 17592186346967 :knowledge-point/_questions [{:knowledge-point/id #uuid "6bde92b0-4e98-5c2e-848e-7a5febc848ae" :knowledge-point/title "Finding the Acute Angle Between Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5bd6d1d9-4033-565d-bfd4-dd88d8fc374a" :answer/type {:db/ident :answer.type/math} :answer/value "{85.35}^{∘}" :db/id #edb/ref 17592186346969} {:answer/id #uuid "ffa16123-27f9-586a-9fd6-3625d3e089d5" :answer/type {:db/ident :answer.type/math} :answer/value "{83.24}^{∘}" :db/id #edb/ref 17592186346970} {:answer/id #uuid "04125489-1990-5d2f-9ffb-220f537473c7" :answer/type {:db/ident :answer.type/math} :answer/value "{87.24}^{∘}" :db/id #edb/ref 17592186346971} {:answer/id #uuid "33e171a2-90b3-5a96-92a8-29e289e3b761" :answer/type {:db/ident :answer.type/math} :answer/value "{87.27}^{∘}" :db/id #edb/ref 17592186346972} {:answer/id #uuid "a48ab294-7d62-501d-8d5f-e52ed8c03ad5" :answer/type {:db/ident :answer.type/math} :answer/value "{84.32}^{∘}" :db/id #edb/ref 17592186346973}] :answer-field/correct {:answer/id #uuid "33e171a2-90b3-5a96-92a8-29e289e3b761" :answer/type {:db/ident :answer.type/math} :answer/value "{87.27}^{∘}" :db/id #edb/ref 17592186346972} :answer-field/id #uuid "2ce3ff68-f28d-53d7-be80-ceed147ec00b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186346968}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "fa0bf0c6-24c7-54d1-ab89-ef5d33b156f4" :question/math-academy-id "q-40562" :question/problem "Rounded to two decimal places, what is the acute angle between the vectors $v=[\\begin{aligned}1 \\\\ \\sqrt{8} \\\\ -2 \\\\ -3\\end{aligned}]$ and $w=[\\begin{aligned}4 \\\\ 1 \\\\ \\sqrt{2} \\\\ 1\\end{aligned}]?$" :question/worked-solution "Using the formula\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{v\\cdot w}{‖v‖\\,‖w‖},\n$$\n\nwe have the following:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{{v}_{1}{w}_{1}+{v}_{2}{w}_{2}+{v}_{3}{w}_{3}+{v}_{4}{w}_{4}}{\\sqrt{{v}_{1}^{2}+{v}_{2}^{2}+{v}_{3}^{2}+{v}_{4}^{2}}\\sqrt{{w}_{1}^{2}+{w}_{2}^{2}+{w}_{3}^{2}+{w}_{4}^{2}}} \\\\  & =\\frac{(1)(4)+(\\sqrt{8})(1)+(-2)(\\sqrt{2})+(-3)(1)}{\\sqrt{{1}^{2}+(\\sqrt{8})^{2}+(-2)^{2}+(-3)^{2}}\\sqrt{(4)^{2}+{1}^{2}+(\\sqrt{2})^{2}+{1}^{2}}} \\\\  & =\\frac{1}{\\sqrt{22}\\sqrt{20}} \\\\  & =\\frac{1}{2\\sqrt{110}} \\\\  & =\\frac{\\sqrt{110}}{220}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{\\sqrt{110}}{220})≈{87.27}^{∘}.\n$$"}] [{:db/id #edb/ref 17592186346974 :knowledge-point/_questions [{:knowledge-point/id #uuid "6bde92b0-4e98-5c2e-848e-7a5febc848ae" :knowledge-point/title "Finding the Acute Angle Between Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bee271d-9115-5bb2-8473-330b5eb12436" :answer/type {:db/ident :answer.type/math} :answer/value "{33.56}^{∘}" :db/id #edb/ref 17592186346976} {:answer/id #uuid "dcd4eaf9-b54b-5dcf-8d12-63e161ec446b" :answer/type {:db/ident :answer.type/math} :answer/value "{35.36}^{∘}" :db/id #edb/ref 17592186346977} {:answer/id #uuid "f7532ad1-4815-5aa8-a3a4-0aca207c7975" :answer/type {:db/ident :answer.type/math} :answer/value "{63.53}^{∘}" :db/id #edb/ref 17592186346978} {:answer/id #uuid "1ea09ca3-de92-580d-a9fc-494e90de0530" :answer/type {:db/ident :answer.type/math} :answer/value "{53.36}^{∘}" :db/id #edb/ref 17592186346979} {:answer/id #uuid "13d829ee-e6da-5ede-ab37-4434ac2bf508" :answer/type {:db/ident :answer.type/math} :answer/value "{56.33}^{∘}" :db/id #edb/ref 17592186346980}] :answer-field/correct {:answer/id #uuid "1bee271d-9115-5bb2-8473-330b5eb12436" :answer/type {:db/ident :answer.type/math} :answer/value "{33.56}^{∘}" :db/id #edb/ref 17592186346976} :answer-field/id #uuid "e54e2e4b-f29e-5907-847d-5845b0dfeea3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186346975}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3124e407-d603-5b39-b281-0193c9fd82eb" :question/math-academy-id "q-40884" :question/problem "Rounded to two decimal places, what is the acute angle between the vectors $v=[\\begin{aligned}2 \\\\ 0 \\\\ 1 \\\\ 2\\end{aligned}]$ and $w=[\\begin{aligned}1 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}]?$" :question/worked-solution "Using the formula\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{v\\cdot w}{‖v‖\\,‖w‖},\n$$\n\nwe have the following:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{{v}_{1}{w}_{1}+{v}_{2}{w}_{2}+{v}_{3}{w}_{3}+{v}_{4}{w}_{4}}{\\sqrt{{v}_{1}^{2}+{v}_{2}^{2}+{v}_{3}^{2}+{v}_{4}^{2}}\\sqrt{{w}_{1}^{2}+{w}_{2}^{2}+{w}_{3}^{2}+{w}_{4}^{2}}} \\\\  & =\\frac{(2)(1)+(0)(1)+(1)(1)+(2)(1)}{\\sqrt{{2}^{2}+{0}^{2}+{1}^{2}+{2}^{2}}\\sqrt{{1}^{2}+{1}^{2}+{1}^{2}+{1}^{2}}} \\\\  & =\\frac{5}{\\sqrt{9}\\cdot \\sqrt{4}} \\\\  & =\\frac{5}{6}\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{5}{6})≈{33.56}^{∘}.\n$$"}] [{:db/id #edb/ref 17592186346981 :knowledge-point/_questions [{:knowledge-point/id #uuid "7b56b45b-94dd-5ba1-aae6-6b17cffaf532" :knowledge-point/title "Calculating the Cosine of an Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "78f59ed3-7dcf-531b-ac19-e61eee91e15d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{7}}{6}" :db/id #edb/ref 17592186346983} {:answer/id #uuid "e2676ba6-5fca-5e3f-baba-b7c3698b2bd6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{7}}{7}" :db/id #edb/ref 17592186346984} {:answer/id #uuid "9d3c5e98-0e51-5845-a673-594fffbf2d5f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{14}" :db/id #edb/ref 17592186346985} {:answer/id #uuid "8017e2c1-3aee-5861-855d-3ec9b6d00f1d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{7}" :db/id #edb/ref 17592186346986} {:answer/id #uuid "391c5a9a-0670-5bd2-b0d6-959bc8c3146f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{14}" :db/id #edb/ref 17592186346987}] :answer-field/correct {:answer/id #uuid "78f59ed3-7dcf-531b-ac19-e61eee91e15d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{7}}{6}" :db/id #edb/ref 17592186346983} :answer-field/id #uuid "fbe7c084-5396-5af5-9fe0-f80301be3f5d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186346982}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6c57d4f3-adc5-58a1-95a8-67f7775a8a92" :question/math-academy-id "q-74110" :question/problem "Let $A(0,-2,1,-3)$ and $B(-1,2,2,-3).$ Find the cosine of the angle $∠AOB$, where $O(0,0,0,0)$ is the origin." :question/worked-solution "First, let\n\n$$\n\\begin{aligned}a=\\overset{\\to }{OA}=[\\begin{aligned}0 \\\\ -2 \\\\ 1 \\\\ -3\\end{aligned}],\\,b=\\overset{\\to }{OB}=[\\begin{aligned}-1 \\\\ 2 \\\\ 2 \\\\ -3\\end{aligned}].\\end{aligned}\n$$\n\n \n\nAlso, let $\\theta =m∠AOB$ be the angle between the vectors $a$ and $b.$ Then, we can find $\\operatorname{cos}⁡\\theta $ using the following formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{a\\cdot b}{‖a‖\\,‖b‖} \\\\  & =\\frac{{a}_{1}{b}_{1}+{a}_{2}{b}_{2}+{a}_{3}{b}_{3}+{a}_{4}{b}_{4}}{\\sqrt{{a}_{1}^{2}+{a}_{2}^{2}+{a}_{3}^{2}+{a}_{4}^{2}}\\,\\sqrt{{b}_{1}^{2}+{b}_{2}^{2}+{b}_{3}^{2}+{b}_{4}^{2}}} \\\\  & =\\frac{0\\cdot (-1)+(-2)\\cdot 2+1\\cdot 2+(-3)\\cdot (-3)}{\\sqrt{{0}^{2}+(-2)^{2}+{1}^{2}+(-3)^{2}}\\,\\sqrt{(-1)^{2}+{2}^{2}+{2}^{2}+(-3)^{2}}} \\\\  & =\\frac{7}{\\sqrt{14}\\cdot \\sqrt{18}} \\\\  & =\\frac{7}{\\sqrt{2}\\cdot \\sqrt{7}\\cdot 3\\sqrt{2}} \\\\  & =\\frac{\\sqrt{7}}{6}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186346988 :knowledge-point/_questions [{:knowledge-point/id #uuid "7b56b45b-94dd-5ba1-aae6-6b17cffaf532" :knowledge-point/title "Calculating the Cosine of an Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e824e7b-f166-5bb4-9f70-bc0a5b572874" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{\\sqrt{5}}" :db/id #edb/ref 17592186346990} {:answer/id #uuid "28d668ae-390f-5f01-b696-7a2176b7b761" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{5}}" :db/id #edb/ref 17592186346991} {:answer/id #uuid "96ead4bd-e694-5ec1-a3af-ad89468592fc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{5}}" :db/id #edb/ref 17592186346992} {:answer/id #uuid "6aee30a5-166a-55f6-963d-aa0eb7738928" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{5}}" :db/id #edb/ref 17592186346993} {:answer/id #uuid "cace2705-4c66-5c4c-a62b-cbea848e1d14" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{5}}" :db/id #edb/ref 17592186346994}] :answer-field/correct {:answer/id #uuid "28d668ae-390f-5f01-b696-7a2176b7b761" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{5}}" :db/id #edb/ref 17592186346991} :answer-field/id #uuid "8ec392f9-b5b6-52e2-85cd-c56b0ea94043" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186346989}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "acc9365e-d688-56b3-ba2f-5b2690862e89" :question/math-academy-id "q-74141" :question/problem "Let $A(-2,-1,1,-1)$, $B(0,-2,0,1)$, and $C(-1,0,1,-1).$ Find the cosine of the angle $∠BAC.$" :question/worked-solution "Let $v=\\overset{\\to }{AB}$ and $w=\\overset{\\to }{AC}.$ Then we have\n\n$$\n\\begin{aligned}v & =b-a \\\\  & =[\\begin{aligned}0 \\\\ -2 \\\\ 0 \\\\ 1\\end{aligned}]-[\\begin{aligned}-2 \\\\ -1 \\\\ 1 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ -1 \\\\ -1 \\\\ 2\\end{aligned}]\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}w & =c-a \\\\  & =[\\begin{aligned}-1 \\\\ 0 \\\\ 1 \\\\ -1\\end{aligned}]-[\\begin{aligned}-2 \\\\ -1 \\\\ 1 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 1 \\\\ 0 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nLet $\\theta =m∠BAC$ be the angle between the vectors $v$ and $w.$ Then, we can find $\\operatorname{cos}⁡\\theta $ using the following formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{v\\cdot w}{‖v‖\\,‖w‖} \\\\  & =\\frac{{v}_{1}{w}_{1}+{v}_{2}{w}_{2}+{v}_{3}{w}_{3}+{v}_{4}{w}_{4}}{\\sqrt{{v}_{1}^{2}+{v}_{2}^{2}+{v}_{3}^{2}+{v}_{4}^{2}}\\,\\sqrt{{w}_{1}^{2}+{w}_{2}^{2}+{w}_{3}^{2}+{w}_{4}^{2}}} \\\\  & =\\frac{2\\cdot 1+(-1)\\cdot 1+(-1)\\cdot 0+2\\cdot 0}{\\sqrt{{2}^{2}+(-1)^{2}+(-1)^{2}+{2}^{2}}\\,\\sqrt{{1}^{2}+{1}^{2}+{0}^{2}+{0}^{2}}} \\\\  & =\\frac{1}{\\sqrt{10}\\cdot \\sqrt{2}} \\\\  & =\\frac{1}{\\sqrt{20}} \\\\  & =\\frac{1}{2\\sqrt{5}}\\end{aligned}\n$$"}]}
