1)+(1)(1)+(2)(1)}{\\sqrt{{2}^{2}+{0}^{2}+{1}^{2}+{2}^{2}}\\sqrt{{1}^{2}+{1}^{2}+{1}^{2}+{1}^{2}}} \\\\  & =\\frac{5}{\\sqrt{9}\\cdot \\sqrt{4}} \\\\  & =\\frac{5}{6}\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{5}{6})≈{33.56}^{∘}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063783/state.json" "file_sha256" "4458209e4a389d6c770550f4bac37c5a801128aad908801ef95ec87361ee35b5"} {"question" "q-40884" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063783/activity-metadata.json" "file_sha256" "897f5584ea67ca24d20e1e027c055090cd995cc68654d11962ffc41130fab1a3"} {"question" "q-40884" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063783/state.json" "file_sha256" "4458209e4a389d6c770550f4bac37c5a801128aad908801ef95ec87361ee35b5"} {"question" "q-40884" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{33.56}^{∘}"] ["math" "{35.36}^{∘}"] ["math" "{53.36}^{∘}"] ["math" "{56.33}^{∘}"] ["math" "{63.53}^{∘}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063783/state.json" "file_sha256" "4458209e4a389d6c770550f4bac37c5a801128aad908801ef95ec87361ee35b5"} {"question" "q-40884" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{33.56}^{∘}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063783/state.json" "file_sha256" "4458209e4a389d6c770550f4bac37c5a801128aad908801ef95ec87361ee35b5"} {"question" "q-74110" "field" nil "attribute" "question/problem" "value" "Let $A(0,-2,1,-3)$ and $B(-1,2,2,-3).$ Find the cosine of the angle $∠AOB$, where $O(0,0,0,0)$ is the origin." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063783/state.json" "file_sha256" "4458209e4a389d6c770550f4bac37c5a801128aad908801ef95ec87361ee35b5"} {"question" "q-74110" "field" nil "attribute" "question/worked-solution" "value" "First, let\n\n$$\n\\begin{aligned}a=\\overset{\\to }{OA}=[\\begin{aligned}0 \\\\ -2 \\\\ 1 \\\\ -3\\end{aligned}],\\,b=\\overset{\\to }{OB}=[\\begin{aligned}-1 \\\\ 2 \\\\ 2 \\\\ -3\\end{aligned}].\\end{aligned}\n$$\n\n \n\nAlso, let $\\theta =m∠AOB$ be the angle between the vectors $a$ and $b.$ Then, we can find $\\operatorname{cos}⁡\\theta $ using the following formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{a\\cdot b}{‖a‖\\,‖b‖} \\\\  & =\\frac{{a}_{1}{b}_{1}+{a}_{2}{b}_{2}+{a}_{3}{b}_{3}+{a}_{4}{b}_{4}}{\\sqrt{{a}_{1}^{2}+{a}_{2}^{2}+{a}_{3}^{2}+{a}_{4}^{2}}\\,\\sqrt{{b}_{1}^{2}+{b}_{2}^{2}+{b}_{3}^{2}+{b}_{4}^{2}}} \\\\  & =\\frac{0\\cdot (-1)+(-2)\\cdot 2+1\\cdot 2+(-3)\\cdot (-3)}{\\sqrt{{0}^{2}+(-2)^{2}+{1}^{2}+(-3)^{2}}\\,\\sqrt{(-1)^{2}+{2}^{2}+{2}^{2}+(-3)^{2}}} \\\\  & =\\frac{7}{\\sqrt{14}\\cdot \\sqrt{18}} \\\\  & =\\frac{7}{\\sqrt{2}\\cdot \\sqrt{7}\\cdot 3\\sqrt{2}} \\\\  & =\\frac{\\sqrt{7}}{6}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063783/state.json" "file_sha256" "4458209e4a389d6c770550f4bac37c5a801128aad908801ef95ec87361ee35b5"} {"question" "q-74110" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063783/activity-metadata.json" "file_sha256" "897f5584ea67ca24d20e1e027c055090cd995cc68654d11962ffc41130fab1a3"} {"question" "q-74110" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063783/state.json" "file_sha256" "4458209e4a389d6c770550f4bac37c5a801128aad908801ef95ec87361ee35b5"} {"question" "q-74110" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{1}{14}"] ["math" "\\frac{1}{7}"] ["math" "\\frac{2\\sqrt{7}}{7}"] ["math" "\\frac{3}{14}"] ["math" "\\frac{\\sqrt{7}}{6}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063783/state.json" "file_sha256" "4458209e4a389d6c770550f4bac37c5a801128aad908801ef95ec87361ee35b5"} {"question" "q-74110" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{\\sqrt{7}}{6}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063783/state.json" "file_sha256" "4458209e4a389d6c770550f4bac37c5a801128aad908801ef95ec87361ee35b5"} {"question" "q-74141" "field" nil "attribute" "question/problem" "value" "Let $A(-2,-1,1,-1)$, $B(0,-2,0,1)$, and $C(-1,0,1,-1).$ Find the cosine of the angle $∠BAC.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063783/state.json" "file_sha256" "4458209e4a389d6c770550f4bac37c5a801128aad908801ef95ec87361ee35b5"} {"question" "q-74141" "field" nil "attribute" "question/worked-solution" "value" "Let $v=\\overset{\\to }{AB}$ and $w=\\overset{\\to }{AC}.$ Then we have\n\n$$\n\\begin{aligned}v & =b-a \\\\  & =[\\begin{aligned}0 \\\\ -2 \\\\ 0 \\\\ 1\\end{aligned}]-[\\begin{aligned}-2 \\\\ -1 \\\\ 1 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ -1 \\\\ -1 \\\\ 2\\end{aligned}]\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}w & =c-a \\\\  & =[\\begin{aligned}-1 \\\\ 0 \\\\ 1 \\\\ -1\\end{aligned}]-[\\begin{aligned}-2 \\\\ -1 \\\\ 1 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 1 \\\\ 0 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nLet $\\theta =m∠BAC$ be the angle between the vectors $v$ and $w.$ Then, we can find $\\operatorname{cos}⁡\\theta $ using the following formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{v\\cdot w}{‖v‖\\,‖w‖} \\\\  & =\\frac{{v}_{1}{w}_{1}+{v}_{2}{w}_{2}+{v}_{3}{w}_{3}+{v}_{4}{w}_{4}}{\\sqrt{{v}_{1}^{2}+{v}_{2}^{2}+{v}_{3}^{2}+{v}_{4}^{2}}\\,\\sqrt{{w}_{1}^{2}+{w}_{2}^{2}+{w}_{3}^{2}+{w}_{4}^{2}}} \\\\  & =\\frac{2\\cdot 1+(-1)\\cdot 1+(-1)\\cdot 0+2\\cdot 0}{\\sqrt{{2}^{2}+(-1)^{2}+(-1)^{2}+{2}^{2}}\\,\\sqrt{{1}^{2}+{1}^{2}+{0}^{2}+{0}^{2}}} \\\\  & =\\frac{1}{\\sqrt{10}\\cdot \\sqrt{2}} \\\\  & =\\frac{1}{\\sqrt{20}} \\\\  & =\\frac{1}{2\\sqrt{5}}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063783/state.json" "file_sha256" "4458209e4a389d6c770550f4bac37c5a801128aad908801ef95ec87361ee35b5"} {"question" "q-74141" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063783/activity-metadata.json" "file_sha256" "897f5584ea67ca24d20e1e027c055090cd995cc68654d11962ffc41130fab1a3"} {"question" "q-74141" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063783/state.json" "file_sha256" "4458209e4a389d6c770550f4bac37c5a801128aad908801ef95ec87361ee35b5"} {"question" "q-74141" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{1}{\\sqrt{5}}"] ["math" "-\\frac{2}{\\sqrt{5}}"] ["math" "\\frac{1}{2\\sqrt{5}}"] ["math" "\\frac{1}{\\sqrt{5}}"] ["math" "\\frac{2}{\\sqrt{5}}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063783/state.json" "file_sha256" "4458209e4a389d6c770550f4bac37c5a801128aad908801ef95ec87361ee35b5"} {"question" "q-74141" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{2\\sqrt{5}}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063783/state.json" "file_sha256" "4458209e4a389d6c770550f4bac37c5a801128aad908801ef95ec87361ee35b5"} {"question" "q-140444" "field" nil "attribute" "question/problem" "value" "Rounded to two decimal places, what is the acute angle between the vectors $v=[\\begin{aligned}-1 \\\\ 2 \\\\ 0 \\\\ 5\\end{aligned}]$ and $w=[\\begin{aligned}4 \\\\ 4 \\\\ -2 \\\\ 0\\end{aligned}]?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063783/state.json" "file_sha256" "4458209e4a389d6c770550f4bac37c5a801128aad908801ef95ec87361ee35b5"} {"question" "q-140444" "field" nil "attribute" "question/worked-solution" "value" "Using the formula\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{v\\cdot w}{‖v‖\\,‖w‖},\n$$\n\nwe have the following:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{{v}_{1}{w}_{1}+{v}_{2}{w}_{2}+{v}_{3}{w}_{3}+{v}_{4}{w}_{4}}{\\sqrt{{v}_{1}^{2}+{v}_{2}^{2}+{v}_{3}^{2}+{v}_{4}^{2}}\\,\\sqrt{{w}_{1}^{2}+{w}_{2}^{2}+{w}_{3}^{2}+{w}_{4}^{2}}} \\\\  & =\\frac{(-1)\\cdot 4+2\\cdot 4+0\\cdot (-2)+5\\cdot 0}{\\sqrt{{1}^{2}+(-2)^{2}+{0}^{2}+{5}^{2}}\\,\\sqrt{{4}^{2}+{4}^{2}+(-2)^{2}+{0}^{2}}} \\\\  & =\\frac{4}{\\sqrt{30}\\cdot \\sqrt{36}} \\\\  & =\\frac{4}{6\\sqrt{30}} \\\\  & =\\frac{2}{3\\sqrt{30}}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{2}{3\\sqrt{30}})≈{83.01}^{∘}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/refere