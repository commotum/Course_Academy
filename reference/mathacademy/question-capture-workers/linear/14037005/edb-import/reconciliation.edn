ned}1 & 3 & 6 \\\\ -1 & 0 & 2 \\\\ 0 & 1 & -2\\end{aligned}][\\begin{aligned}1 & -4 & -5 \\\\ -2 & 1 & 4 \\\\ 1 & 0 & -3\\end{aligned}] \\\\  & =[\\begin{aligned}1-6+6 & -4+3+0 & -5+12-18 \\\\ -1+0+2 & 4+0+0 & 5+0-6 \\\\ 0-2-2 & 0+1+0 & 0+4+6\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -1 & -11 \\\\ 1 & 4 & -1 \\\\ -4 & 1 & 10\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037005/state.json" "file_sha256" "eb1ae29da1ccabc89080ac4a43bd6a3b48cb896ce438b7d7d02a5dba71ed4350"} {"question" "q-129425" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037005/activity-metadata.json" "file_sha256" "9822d0449371e8e3e874cc01ad31e88dbd9021e6d40897afe3312783f3ba2d4d"} {"question" "q-129425" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037005/state.json" "file_sha256" "eb1ae29da1ccabc89080ac4a43bd6a3b48cb896ce438b7d7d02a5dba71ed4350"} {"question" "q-129425" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}1 & -1 & -10 \\\\ 1 & 4 & -1 \\\\ -4 & 1 & 1\\end{aligned}]"] ["math" "[\\begin{aligned}1 & -1 & -11 \\\\ 1 & 4 & -1 \\\\ -4 & 1 & 10\\end{aligned}]"] ["math" "[\\begin{aligned}1 & -1 & -5 \\\\ 1 & 4 & -1 \\\\ -4 & -1 & 9\\end{aligned}]"] ["math" "[\\begin{aligned}1 & -2 & -10 \\\\ 1 & 0 & -1 \\\\ 4 & 1 & 9\\end{aligned}]"] ["math" "[\\begin{aligned}1 & -2 & -11 \\\\ 1 & 4 & -1 \\\\ -2 & 1 & 1\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037005/state.json" "file_sha256" "eb1ae29da1ccabc89080ac4a43bd6a3b48cb896ce438b7d7d02a5dba71ed4350"} {"question" "q-129425" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}1 & -1 & -11 \\\\ 1 & 4 & -1 \\\\ -4 & 1 & 10\\end{aligned}]"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037005/state.json" "file_sha256" "eb1ae29da1ccabc89080ac4a43bd6a3b48cb896ce438b7d7d02a5dba71ed4350"} {"question" "q-11568" "field" nil "attribute" "question/problem" "value" "Find $ST$,  if  $S=[\\begin{aligned}1 & 0 & 4 \\\\ 0 & -5 & 2 \\\\ 2 & 0 & 2\\end{aligned}]$ and $T=[\\begin{aligned}3 & 2 & 3 \\\\ 1 & -1 & 0 \\\\ 2 & -1 & 1\\end{aligned}].$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037005/state.json" "file_sha256" "eb1ae29da1ccabc89080ac4a43bd6a3b48cb896ce438b7d7d02a5dba71ed4350"} {"question" "q-11568" "field" nil "attribute" "question/worked-solution" "value" "Multiplying each row in the first matrix by each column in the second, we get\n\n$$\n\\begin{aligned}ST & =[\\begin{aligned}1 & 0 & 4 \\\\ 0 & -5 & 2 \\\\ 2 & 0 & 2\\end{aligned}][\\begin{aligned}3 & 2 & 3 \\\\ 1 & -1 & 0 \\\\ 2 & -1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}3+0+8 & 2+0-4 & 3+0+4 \\\\ 0-5+4 & 0+5-2 & 0-0+2 \\\\ 6+0+4 & 4-0-2 & 6+0+2\\end{aligned}] \\\\  & =[\\begin{aligned}11 & -2 & 7 \\\\ -1 & 3 & 2 \\\\ 10 & 2 & 8\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037005/state.json" "file_sha256" "eb1ae29da1ccabc89080ac4a43bd6a3b48cb896ce438b7d7d02a5dba71ed4350"} {"question" "q-11568" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037005/activity-metadata.json" "file_sha256" "9822d0449371e8e3e874cc01ad31e88dbd9021e6d40897afe3312783f3ba2d4d"} {"question" "q-11568" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037005/state.json" "file_sha256" "eb1ae29da1ccabc89080ac4a43bd6a3b48cb896ce438b7d7d02a5dba71ed4350"} {"question" "q-11568" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}10 & -2 & 7 \\\\ -1 & 3 & 2 \\\\ 10 & 2 & 8\\end{aligned}]"] ["math" "[\\begin{aligned}11 & -2 & 7 \\\\ -1 & 3 & 2 \\\\ 10 & -2 & 8\\end{aligned}]"] ["math" "[\\begin{aligned}11 & -2 & 7 \\\\ -1 & 3 & 2 \\\\ 10 & 2 & -8\\end{aligned}]"] ["math" "[\\begin{aligned}11 & -2 & 7 \\\\ -1 & 3 & 2 \\\\ 10 & 2 & 8\\end{aligned}]"] ["math" "[\\begin{aligned}11 & -2 & 7 \\\\ 1 & 3 & 2 \\\\ 10 & 2 & 8\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037005/state.json" "file_sha256" "eb1ae29da1ccabc89080ac4a43bd6a3b48cb896ce438b7d7d02a5dba71ed4350"} {"question" "q-11568" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}11 & -2 & 7 \\\\ -1 & 3 & 2 \\\\ 10 & 2 & 8\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037005/state.json" "file_sha256" "eb1ae29da1ccabc89080ac4a43bd6a3b48cb896ce438b7d7d02a5dba71ed4350"} {"question" "e-4401" "field" nil "attribute" "question/problem" "value" "Find $AB$ and $BA,$ if \n$[\\begin{aligned}1 & 0 \\\\ -5 & 1\\end{aligned}]$\nand\n$[\\begin{aligned}0 & 1 \\\\ -1 & 2\\end{aligned}]$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037005/example-4401.json" "file_sha256" "130a347366d6cc521a98a2525ae45705a5425abe282fba7ea5ced39e91e8c62c"} {"question" "e-4401" "field" nil "attribute" "question/worked-solution" "value" "Multiplying each row in the first matrix by each column in the second, we get\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}1 & 0 \\\\ -5 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ -1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}1\\cdot 0+0\\cdot (-1) & 1\\cdot 1+0\\cdot 2 \\\\ -5\\cdot 0+1\\cdot (-1) & -5\\cdot 1+1\\cdot 2\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 1 \\\\ -1 & -3\\end{aligned}]\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}BA & =[\\begin{aligned}0 & 1 \\\\ -1 & 2\\end{aligned}][\\begin{aligned}1 & 0 \\\\ -5 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}0\\cdot 1+1\\cdot (-5) & 0\\cdot 0+1\\cdot 1 \\\\ -1\\cdot 1+2\\cdot (-5) & -1\\cdot 0+2\\cdot 1\\end{aligned}] \\\\  & =[\\begin{aligned}-5 & 1 \\\\ -11 & 2\\end{aligned}].\\end{aligned}\n$$\n\n**Watch out!** Notice that \n\n$$\nAB \\neq BA.\n$$\n\nMatrix multiplication is not **commutative**, meaning that when we switch the order of multiplication, we often get a different result (like we did in this example)." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037005/example-4401.json" "file_sha256" "130a347366d6cc521a98a2525ae45705a5425abe282fba7ea5ced39e91e8c62c"} {"question" "e-5255" "field" nil "attribute" "question/problem" "value" "Let $Z=XY.$ What is the value of $z_{32}$, if\n\n$$\n[\\begin{aligned}1 & 2 & 0 \\\\ -2 & 0 & -1 \\\\ 1 & 2 & 3\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037005/example-5255.json" "file_sha256" "f9fdf6f4e7ee28b503083867424e562abff332d2f4d00fae68a62694cb970849"} {"question" "e-5255" "field" nil "attribute" "question/worked-solution" "value" "Multiplying the $3$rd row in $X$ by the $2$nd column in $Y$, we get\n\n$$\n\\begin{aligned}{z}_{32} & =[\\begin{aligned}1 & 2 & 3\\end{aligned}][\\begin{aligned}-1 \\\\ 4 \\\\ -2\\end{aligned}] \\\\  & =1\\cdot (-1)+2\\cdot 4+3\\cdot (-2) \\\\  & =-1+8-6 \\\\  & =1.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037005/example-5255.json" "file_sha256" "f9fdf6f4e7ee28b503083867424e562abff332d2f4d00fae68a62694cb970849"} {"question" "e-4402" "field" nil "attribute" "question/problem" "value" "Find $AB$, if \n$[\\begin{aligned}-2 & 0 & 3 \\\\ 3 & -1 & -2 \\\\ -2 & 0 & -1\\end{aligned}]$\nand\n$[\\begin{aligned}0 & 3 & -2 \\\\ 1 & -2 & 4 \\\\ -3 & -1 & 2\\end{aligned}]$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037005/example-4402.json" "file_sha256" "ddcefab4accf9604577626e3f787ba05bcc6fb0b27771bf772dbfcd52866f4e0"} {"question" "e-4402" "field" nil "attribute" "question/worked-solution" "value" "Multiplying each row in the first matrix by each column in the second, we get\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}-2 & 0 & 3 \\\\ 3 & -1 & -2 \\\\ -2 & 0 & -1\\end{aligned}][\\begin{aligned}0 & 3 & -2 \\\\ 1 & -2 & 4 \\\\ -3 & -1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}0+0-9 & -6+0-3 & 4+0+6 \\\\ 0-1+6 & 9+2+2 & -6-4-4 \\\\ 0+0+3 & -6+0+1 & 4+0-2\\end{aligned}] \\\\  & =[\\begin{aligned}-9 & -9 & 10 \\\\ 5 & 13 & -14 \\\\ 3 & -5 & 2\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14037005/example-4402.json" "file_sha256" "ddcefab4accf9604577626e3f787ba05bcc6fb0b27771bf772dbfcd52866f4e0"}] "usage" {"q-11568" [] "q-11571" [] "e-4401" [] "e-4402" [] "e-5255" []} "basis" 1251 "retractions" [[17592186059921 :question/problem "What is $\\begin{bmatrix}1 & 0 & 2 \\\\ 0 & -2 & 2 \\\\ 1 & 0 & 2\\end{bmatrix}\\begin{bmatrix}3 & 2 & 3 \\\\ 0 & 1 & 0 \\\\ 2 & 1 & 1\\end{bmatrix}$?"]] "immutable_answers" [17592186056246 17592186056247 17592186056248 17592186056249 17592186056250 17592186276881 17592186276882 17592186276883 17592186276884 17592186276885] "immutable_fields" [[17592186056245 :answer-field/correct] [17592186056245 :answer-field/id] [17592186056245 :answer-field/key] [17592186056245 :answer-field/type] [17592186276880 :answer-field/correct] [17592186276880 :answer-field/id] [17592186276880 :answer-field/key] [17592186276880 :answer-field/type]] "no_history" []}
