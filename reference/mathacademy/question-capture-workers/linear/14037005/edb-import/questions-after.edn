-academy-id "q-129352" :question/problem "Let $T=UV.$ What is the value of ${t}_{21}$, if\n\n$$\nU=[\\begin{aligned}3 & 4 \\\\ -5 & 3\\end{aligned}],\\,V=[\\begin{aligned}-2 & 2 \\\\ 4 & 3\\end{aligned}]?\n$$" :question/worked-solution "Multiplying the $2$nd row in $U$ by the $1$st column in $V$, we get\n\n$$\n\\begin{aligned}{t}_{21} & =[\\begin{aligned}-5 & 3\\end{aligned}][\\begin{aligned}-2 \\\\ 4\\end{aligned}] \\\\  & =(-5)\\cdot (-2)+3\\cdot 4 \\\\  & =10+12 \\\\  & =22.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295710 :knowledge-point/_questions [{:knowledge-point/id #uuid "9c7a77cf-163a-542a-b4a3-4274344b9cf8" :knowledge-point/title "Multiplying 3x3 Square Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5fc0438f-2f73-534d-9039-8efe67a4accf" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -1 & -11 \\\\ 1 & 4 & -1 \\\\ -4 & 1 & 10\\end{aligned}]" :db/id #edb/ref 17592186295712} {:answer/id #uuid "8458a401-9a7c-5fe7-bfe3-4f18a14c76e2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -2 & -10 \\\\ 1 & 0 & -1 \\\\ 4 & 1 & 9\\end{aligned}]" :db/id #edb/ref 17592186295713} {:answer/id #uuid "fc906686-9cff-560f-a8a8-88e670f9c8e0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -1 & -5 \\\\ 1 & 4 & -1 \\\\ -4 & -1 & 9\\end{aligned}]" :db/id #edb/ref 17592186295714} {:answer/id #uuid "a1a426be-4bfe-598a-b428-82476ff8e343" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -1 & -10 \\\\ 1 & 4 & -1 \\\\ -4 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186295715} {:answer/id #uuid "60a2c2f7-05b4-58c5-88d3-c4a0d121f259" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -2 & -11 \\\\ 1 & 4 & -1 \\\\ -2 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186295716}] :answer-field/correct {:answer/id #uuid "5fc0438f-2f73-534d-9039-8efe67a4accf" :answer/type {:db/ident :answer.type/math} :answer/valu