wer/value "7" :db/id #edb/ref 17592186295754}] :answer-field/correct {:answer/id #uuid "e209914d-439c-55ae-b429-ef71b983f92a" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186295754} :answer-field/id #uuid "39275ab8-8379-5913-b368-990ac836e91e" :answer-field/key "field-5" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186295753}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1fdd2eb6-bedf-5e6e-9a26-4eceeb850858" :question/math-academy-id "q-318338" :question/problem "Evaluate the following matrix product:\n\n|  | $3$ | $1$ | $2$ |  |  |  | $1$ | $2$ | $1$ |  |  |  | $10$ | {{field-1}} | $5$ |  |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  | $4$ | $-1$ | $5$ |  |  |  | $3$ | $-1$ | $2$ |  | $=$ |  | {{field-2}} | $14$ | {{field-3}} |  |\n|  | $2$ | $0$ | $3$ |  |  |  | $2$ | $1$ | $0$ |  |  |  | {{field-4}} | {{field-5}} | $2$ |  |" :question/worked-solution "Multiplying each row in the first matrix by each column in the second, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}3 & 1 & 2 \\\\ 4 & -1 & 5 \\\\ 2 & 0 & 3\\end{aligned}][\\begin{aligned}1 & 2 & 1 \\\\ 3 & -1 & 2 \\\\ 2 & 1 & 0\\end{aligned}] & =[\\begin{aligned}3+3+4 & 6-1+2 & 3+2+0 \\\\ 4-3+10 & 8+1+5 & 4-2+0 \\\\ 2+0+6 & 4+0+3 & 2+0+0\\end{aligned}] \\\\  & =[\\begin{aligned}10 & 7 & 5 \\\\ 11 & 14 & 2 \\\\ 8 & 7 & 2\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295755 :knowledge-point/_questions [{:knowledge-point/id #uuid "a827b0d0-faa2-521f-b166-e13873b1da00" :knowledge-point/title "Finding an Entry of the Product of Two Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19561f53-c0ce-5f0b-a28e-051551d6e11e" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186295757} {:answer/id #uuid "53942f94-aad2-509b-99df-ddeed996c1b4" :answer