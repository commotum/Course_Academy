 & 0 & 0 \\\\ -1 & 2 & 4 \\\\ 0 & 5 & -2\\end{aligned}][\\begin{aligned}0 & 1 & 2 \\\\ 3 & -2 & 0 \\\\ 1 & 0 & 3\\end{aligned}] & =[\\begin{aligned}0+0+0 & 3+0+0 & 6+0+0 \\\\ 0+6+4 & -1-4+0 & -2+0+12 \\\\ 0+15-2 & 0-10+0 & 0+0-6\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 3 & 6 \\\\ 10 & -5 & 10 \\\\ 13 & -10 & -6\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-318332/field-1" "q-318332/field-2" "q-318332/field-3" "q-318332/field-4" "q-318332/field-5"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9c7a77cf-163a-542a-b4a3-4274344b9cf8"] :knowledge-point/questions ["q-318332"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129425/selection/2c6ba0e72bee1d06d9206970fb4b6d4deae062d7022d94cd19d5a785538740e1" :answer/id #uuid "8458a401-9a7c-5fe7-bfe3-4f18a14c76e2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & -2 & -10 \\\\ 1 & 0 & -1 \\\\ 4 & 1 & 9\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-129425/selection/098426dfc8ef848d148ecfcab4bcbc1f75f3310aaaecfbbb0822de3258d650d9" :answer/id #uuid "5fc0438f-2f73-534d-9039-8efe67a4accf" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & -1 & -11 \\\\ 1 & 4 & -1 \\\\ -4 & 1 & 10\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-129425/selection/6c9d45f831e076d6a16904d695974bd9f0b7c38abaf69fc290f40389991ca6e4" :answer/id #uuid "fc906686-9cff-560f-a8a8-88e670f9c8e0" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & -1 & -5 \\\\ 1 & 4 & -1 \\\\ -4 & -1 & 9\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-129425/selection/d9e917b6a792c96dc65177dbafc9769a8e1192a3cd13441ee01d1bbf4797b502" :answer/id #uuid "60a2c2f7-05b4-58c5-88d3-c4a0d121f259" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & -2 & -11 \\\\ 1 & 4 & -1 \\\\ -2 & 1 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-129425/selection/8fc323dd14b3d4712f9bff68eb0808d397a918c6