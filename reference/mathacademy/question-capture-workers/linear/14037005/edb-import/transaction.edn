 \\\\  & =(-5)\\cdot (-2)+3\\cdot 4 \\\\  & =10+12 \\\\  & =22.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-129352/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a827b0d0-faa2-521f-b166-e13873b1da00"] :knowledge-point/questions ["q-129352"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-11571"] :question/problem "$[\\begin{aligned}1 & 0 & 2 \\\\ 0 & -2 & 2 \\\\ 1 & 0 & 2\\end{aligned}][\\begin{aligned}3 & 2 & 3 \\\\ 0 & 1 & 0 \\\\ 2 & 1 & 1\\end{aligned}]=$" :question/worked-solution "Multiplying each row in the first matrix by each column in the second, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}1 & 0 & 2 \\\\ 0 & -2 & 2 \\\\ 1 & 0 & 2\\end{aligned}][\\begin{aligned}3 & 2 & 3 \\\\ 0 & 1 & 0 \\\\ 2 & 1 & 1\\end{aligned}] & =[\\begin{aligned}3+0+4 & 2+0+2 & 3+0+2 \\\\ 0-0+4 & 0-2+2 & 0-0+2 \\\\ 3+0+4 & 2+0+2 & 3+0+2\\end{aligned}] \\\\  & =[\\begin{aligned}7 & 4 & 5 \\\\ 4 & 0 & 2 \\\\ 7 & 4 & 5\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-318338/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "6c6c357a-fdbd-589e-a6cf-67b1b05d3b28" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-318338/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "7e116208-d155-5b93-9a13-17001e129ea7" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-318338/field-1" :answer-field/id #uuid "9a53f63f-4be0-5161-affd-75f99342c0dd" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-318338/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer-field/choices ["q-318338/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" "q-318338/field-1/a0e0e6