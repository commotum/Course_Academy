ademy/question-capture-workers/differential/14040289/state.json" "file_sha256" "6bf283bc2cfddc5d9a25b353c7ac44319704195febc4ff79f0c64c7bb355b8ba" "basis" 1427 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040289/edb-import/verification.json"} {"question" "q-37363" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "$[\\begin{aligned}3 \\\\ -2\\end{aligned}]$ and $[\\begin{aligned}2 \\\\ 3\\end{aligned}]$"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040289/state.json" "file_sha256" "6bf283bc2cfddc5d9a25b353c7ac44319704195febc4ff79f0c64c7bb355b8ba" "basis" 1427 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040289/edb-import/verification.json"} {"question" "q-37363" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "$[\\begin{aligned}3 \\\\ 2\\end{aligned}]$ and $[\\begin{aligned}2 \\\\ -3\\end{aligned}]$"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040289/state.json" "file_sha256" "6bf283bc2cfddc5d9a25b353c7ac44319704195febc4ff79f0c64c7bb355b8ba" "basis" 1427 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040289/edb-import/verification.json"} {"question" "q-37363" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "$[\\begin{aligned}3 \\\\ 2\\end{aligned}]$ and $[\\begin{aligned}2 \\\\ -3\\end{aligned}]$"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040289/state.json" "file_sha256" "6bf283bc2cfddc5d9a25b353c7ac44319704195febc4ff79f0c64c7bb355b8ba" "basis" 1427 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040289/edb-import/verification.json"} {"question" "e-7133" "field" nil "attribute" "question/problem" "value" "Find a $2 \\times 2$ matrix $C$ that has eigenvalues $\\lambda_1=1$ and $\\lambda_2=-4,$ and corresponding eigenvectors\n\n$$\n[\\begin{aligned}2 \\\\ -2\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040289/example-7133.json" "file_sha256" "06b1a0ce5745a9f1f1c9d994bbb13e3f941f50895c08a1257132a468aa79eaac" "basis" 1427 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040289/edb-import/verification.json"} {"question" "e-7133" "field" nil "attribute" "question/worked-solution" "value" "Since $\\mathcal{B}= \\{ \\mathbf{v}_1,\\mathbf{v}_2\\}$ is a basis of $\\mathbb{R}^2$ consisting of the eigenvectors of $C,$ then $C$ must be diagonalizable.\n\nSo, we can write $C=PDP^{-1},$ where $P$ is a matrix whose columns are the eigenvectors of $C,$ and $D$ is a diagonal matrix whose entries are the eigenvalues in the corresponding order: \n\n$$\n[\\begin{aligned}| & | \\\\ {v}_{1} & {v}_{2} \\\\ | & |\\end{aligned}]\n$$\n\nLet $[\\begin{aligned}2 & 1 \\\\ -2 & 1\\end{aligned}]$ Then\n\n$$\n\\begin{aligned}{P}^{-1} & ={[\\begin{aligned}2 & 1 \\\\ -2 & 1\\end{aligned}]}^{-1}=\\frac{1}{4}[\\begin{aligned}1 & -1 \\\\ 2 & 2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, carrying out the necessary matrix multiplication, we obtain\n\n$$\n\\begin{aligned}C & =\\frac{1}{4}[\\begin{aligned}2 & 1 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 0 & -4\\end{aligned}][\\begin{aligned}1 & -1 \\\\ 2 & 2\\end{aligned}] \\\\  & =\\frac{1}{4}[\\begin{aligned}2 & -4 \\\\ -2 & -4\\end{aligned}][\\begin{aligned}1 & -1 \\\\ 2 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{3}{2} & -\\frac{5}{2} \\\\ -\\frac{5}{2} & -\\frac{3}{2}\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040289/example-7133.json" "file_sha256" "06b1a0ce5745a9f1f1c9d994bbb13e3f941f50895c08a1257132a468aa79eaac" "basis" 1427 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040289/edb-import/verification.json"} {"question" "e-5502" "field" nil "attribute" "question/problem" "value" "Find $A^{100},$ where \n\n$$\n[\\begin{aligned}2 & -1 \\\\ -1 & 1\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040289/example-5502.json" "file_sha256" "9e07fd1a875c4c58235f1620fd84e73155b746477ded7244ead0c2d6a56dd614" "basis" 1427 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040289/edb-import/verification.json"} {"question" "e-5502" "field" nil "attribute" "question/worked-solution" "value" "First,  notice that\n\n$$\n[\\begin{aligned}2 & -1 \\\\ -1 & 1\\end{aligned}]\n$$\n\nSo, we have been given the following diagonalization of $A\\mathbin{:}$\n\n$$\n[\\begin{aligned}2 & -1 \\\\ -1 & 1\\end{aligned}]\n$$\n\nSince $A=PDP^{-1},$ we can compute $A^k$ by using the formula \n\n$$\nA^{k} = PD^{k}P^{-1}.\n$$\n\nCarrying out the necessary multiplication, we obtain the following:\n\n$$\n\\begin{aligned}{A}^{100} & =P{D}^{100}{P}^{-1} \\\\  & =[\\begin{aligned}2 & -1 \\\\ -1 & 1\\end{aligned}]{[\\begin{aligned}1 & 0 \\\\ 0 & 0\\end{aligned}]}^{100}[\\begin{aligned}1 & 1 \\\\ 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -1 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}{1}^{100} & 0 \\\\ 0 & {0}^{100}\\end{aligned}][\\begin{aligned}1 & 1 \\\\ 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -1 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 0 & 0\\end{aligned}][\\begin{aligned}1 & 1 \\\\ 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 0 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}1 & 1 \\\\ 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 2 \\\\ -1 & -1\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040289/example-5502.json" "file_sha256" "9e07fd1a875c4c58235f1620fd84e73155b746477ded7244ead0c2d6a56dd614" "basis" 1427 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040289/edb-import/verification.json"} {"question" "e-5503" "field" nil "attribute" "question/problem" "value" "Find the eigenvectors of the $2 \\times 2$ matrix $E,$ given that \n\n$$\n[\\begin{aligned}3 & 6 \\\\ 1 & 1\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040289/example-5503.json" "file_sha256" "1c7f6a63d100e7c54caec9423f34b236edf868114e566f7d01b3770406660d7a" "basis" 1427 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040289/edb-import/verification.json"} {"question" "e-5503" "field" nil "attribute" "question/worked-solution" "value" "Notice that the matrix $[\\begin{aligned}3 & 6 \\\\ 1 & 1\\end{aligned}]$ appears on both sides of the equation. Since this matrix is invertible (its determinant is not zero), left-multiplying the equation by the inverse gives the following expression for $E\\mathbin{:}$ \n\n$$\n[\\begin{aligned}3 & 6 \\\\ 1 & 1\\end{aligned}]\n$$\n\nTherefore, $E$ is diagonalizable. The eigenvalues of $E$ are $\\lambda_1=3$ and $\\lambda_2=6$ and the corresponding eigenvectors are the columns of the matrix $P.$ Computing $P,$ we obtain\n\n$$\n\\begin{aligned}P={[\\begin{aligned}3 & 6 \\\\ 1 & 1\\end{aligned}]}^{-1}=\\frac{1}{-3}[\\begin{aligned}1 & -6 \\\\ -1 & 3\\end{aligned}]=[\\begin{aligned}-\\frac{1}{3} & 2 \\\\ \\frac{1}{3} & -1\\end{aligned}].\\end{aligned}\n$$\n\nIn conclusion, the corresponding eigenvectors are\n\n$$\n[\\begin{aligned}-\\frac{1}{3} \\\\ \\frac{1}{3}\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040289/example-5503.json" "file_sha256" "1c7f6a63d100e7c54caec9423f34b236edf868114e566f7d01b3770406660d7a" "basis" 1427 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040289/edb-import/verification.json"} {"question" "q-37270" "field" nil "attribute" "question/problem" "value" "Find the eigenvectors of the $2\\times 2$ matrix $B$ given that \n\n$$\nB[\\begin{aligned}1 & 2 \\\\ 2 & -1\\end{aligned}]=[\\begin{aligned}1 & 2 \\\\ 2 & -1\\end{aligned}][\\begin{aligned}2 & 0 \\\\ 0 & 3\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14066049/state.json" "file_sha256" "8b6b1e2869c8a5a533d4315378ad268984e3e4cffbcb0ab057ab0891ff882023" "basis" 2174 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14066049/edb-import/verification.json"} {"question" "q-37270" "field" nil "attribute" "question/worked-solution" "value" "Notice that the matrix $[\\begin{aligned}1 & 2 \\\\ 2 & -1\\end{aligned}]$ appears on both sides of the equation. Since this matrix is invertible (its determinant is not zero), right-multiplying the equation by the inverse gives the following expression for $B:$\n\n$$\nB={{[\\begin{aligned}1 & 2 \\\\ 2 & -1\\end{aligned}]}_{⏟}}_{P}{{[\\begin{aligned}2 & 0 \\\\ 0 & 3\\end{aligned}]}_{⏟}}_{D}{{{[\\begin{aligned}1 & 2 \\\\ 2 & -1\\end{aligned}]}^{-1}}_{⏟}}_{{P}^{-1}}\n$$\n\nTherefore, $B$ is diagonalizable. The eigenvalues of $B$ are ${\\lambda }_{1}=2$ and ${\\lambda }_{2}=3$ and the corresponding eigenvectors are the columns of the matrix $P:$\n\n$\\,$ ${v}_{1}=[\\begin{aligned}1 \\\\ 2\\end{aligned}]\\,$ and $\\,{v}_{2}=[\\begin{aligned}2 \\\\ -1\\end{aligned}]$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14066049/state.json" "file_sha256" "8b6b1e2869c8a5a533d4315378ad268984e3e4cffbcb0ab057ab0891ff882023" "basis" 2174 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14066049/edb-import/verification.json"} {"question" "q-37270" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14066049/activity-metadata.json" "file_sha256" "ae6990cd4e9a522228d2d882f29c3f128d059f74d476cbccc3616545ef941417" "basis" 2174 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14066049/edb-import/verification.json"} {"question" "q-37270" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14066049/state.json" "file_sha256" "8b6b1e2869c8a5a533d4315378ad268984e3e4cffbcb0ab057ab0891ff882023" "basis" 2174 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14066049/edb-import/verification.json"} {"question" "q-37625" "field" nil "attribute" "question/problem" "value" "Find ${A}^{69}$ where\n\n$$\nA=[\\begin{aligned}-2 & 2 \\\\ 0 & -6\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}]{[\\begin{aligned}-2 & 2 \\\\ 0 & -6\\end{aligned}]}^{-1}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14066049/state.json" "file_sha256" "8b6b1e2869c8a5a533d4315378ad268984e3e4cffbcb0ab057ab0891ff882023" "basis" 2174 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14066049/edb-import/verification.json"} {"question" "q-37625" "field" nil "attribute" "question/worked-solution" "value" "We have been given the following diagonalization of $A.$\n\n$$\nA={{[\\begin{aligned}-2 & 2 \\\\ 0 & -6\\end{aligned}]}_{⏟}}_{P}{{[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}]}_{⏟}}_{D}{{{[\\begin{aligned}-2 & 2 \\\\ 0 & -6\\end{aligned}]}^{-1}}_{⏟}}_{{P}^{-1}}\n$$\n\nSo, since $A=PD{P}^{-1}$, we can compute ${A}^{k}$ by using the formula \n\n$$\n{A}^{k}=P{D}^{k}{P}^{-1}.\n$$\n\nFirst, we find the inverse of the matrix $P.$ We get\n\n$$\n{[\\begin{aligned}-2 & 2 \\\\ 0 & -6\\end{aligned}]}^{-1}=\\frac{1}{12}[\\begin{aligned}-6 & -2 \\\\ 0 & -2\\end{aligned}].\n$$\n\nCarrying out the necessary multiplication, we obtain the following:\n\n \n\n$$\n\\begin{aligned}{A}^{69} & =P{D}^{69}{P}^{-1} \\\\  & =[\\begin{aligned}-2 & 2 \\\\ 0 & -6\\end{aligned}]{[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}]}^{69}{[\\begin{aligned}-2 & 2 \\\\ 0 & -6\\end{aligned}]}^{-1} \\\\  & =[\\begin{aligned}-2 & 2 \\\\ 0 & -6\\end{aligned}][\\begin{aligned}{1}^{69} & 0 \\\\ 0 & (-1)^{69}\\end{aligned}](\\frac{1}{12}[\\begin{aligned}-6 & -2 \\\\ 0 & -2\\end{aligned}]) \\\\  & =\\frac{1}{12}[\\begin{aligned}-2 & 2 \\\\ 0 & -6\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}-6 & -2 \\\\ 0 & -2\\end{aligned}] \\\\  & =\\frac{1}{12}[\\begin{aligned}-2 & -2 \\\\ 0 & 6\\end{aligned}][\\begin{aligned}-6 & -2 \\\\ 0 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}1 & \\frac{2}{3} \\\\ 0 & -1\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14066049/state.json" "file_sha256" "8b6b1e2869c8a5a533d4315378ad268984e3e4cffbcb0ab057ab0891ff882023" "basis" 2174 "verification" "/home/jake/Developer/Course_Academy/referenc