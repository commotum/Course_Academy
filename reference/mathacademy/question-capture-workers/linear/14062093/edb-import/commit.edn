 1\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}-2 & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}-1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}2 & -2 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -1 & 0 \\\\ 0 & 0 & \\frac{1}{2}\\end{aligned}].\\end{aligned}\n$$\n\nAs a result, the coordinates of the vertices of the original triangle are $(1,0),(-1,0),(0,\\frac{1}{2}).$\n\nTherefore, the correct answer is \"I and II only.\"" 13194139535297 true] [17592186342405 1000 #edb/ref 17592186342406 13194139535297 true] [17592186342405 1000 #edb/ref 17592186342407 13194139535297 true] [17592186342405 1000 #edb/ref 17592186342408 13194139535297 true] [17592186342405 1000 #edb/ref 17592186342409 13194139535297 true] [17592186342405 1000 #edb/ref 17592186342410 13194139535297 true] [17592186342405 1040 #edb/ref 17592186045450 13194139535297 true] [17592186342405 1041 "selection" 13194139535297 true] [17592186342405 1104 #edb/ref 17592186342409 13194139535297 true] [17592186342405 1110 #uuid "a154e459-ecf9-5d97-be47-1d6d77cb2c87" 13194139535297 true] [17592186342406 1034 "II and III only" 13194139535297 true] [17592186342406 1103 #edb/ref 17592186045454 13194139535297 true] [17592186342406 1111 #uuid "cbb496a6-bdd6-5c5d-acc9-7c29122660b1" 13194139535297 true] [17592186342407 1034 "I and III only" 13194139535297 true] [17592186342407 1103 #edb/ref 17592186045454 13194139535297 true] [17592186342407 1111 #uuid "a589d169-a1ee-5150-ac2c-095f321aba93" 13194139535297 true] [17592186342408 1034 "I only" 13194139535297 true] [17592186342408 1103 #edb/ref 17592186045454 13194139535297 true] [17592186342408 1111 #uuid "771e051c-6b45-5bc6-b7d2-e86074f82c75" 13194139535297 true] [17592186342409 1034 "I and II only" 13194139535297 true] [17592186342409 1103 #edb/ref 17592186045454 13194139535297 true] [17592186342409 1111 #uuid "d0579c9e-54e5-5b1e-af23-52ef4a525a94" 13194139535297 true] [17592186342410 1034 "II only" 13194139535297 tr