2-a504-bcbf443ead94" :answer/type {:db/ident :answer.type/math} :answer/value "\\ne " :db/id #edb/ref 17592186345148} {:answer/id #uuid "f37dce00-3d6c-5e21-a142-07c4c3216fd5" :answer/type {:db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186345149} {:answer/id #uuid "22b34b0e-b1c6-5c1d-9e73-06a6b9e948a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\ge " :db/id #edb/ref 17592186345150} {:answer/id #uuid "e7f442cd-330a-56fd-bc4a-4b5e031d8908" :answer/type {:db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186345151}] :answer-field/correct {:answer/id #uuid "e7f442cd-330a-56fd-bc4a-4b5e031d8908" :answer/type {:db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186345151} :answer-field/id #uuid "18dcb56a-7fec-5145-b5e5-d8a3247ecc4c" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186345146}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "7d52a962-ab63-5613-b11d-d4a89dabe43b" :question/math-academy-id "q-181689" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063256/assets/32168a2cb1fe14dbc88725347611ae5951198e81dfaa0b41e780106750bbb741.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n{(x,y)\\in {{field-1}}\\,:\\,3x\\,{{field-2}}\\,y\\,{{field-3}}\\,\\frac{x}{4}}\n$$" :question/worked-solution "The points in our set include all those that lie *above* the line $y=3x$ and *below* the line $y=\\frac{x}{4}.$\n\nA point $P(x,y)$ lies *inside* the shaded region if the following conditions are satisfied:\n\n$$\ny>3x,\\,y<\\frac{x}{4}.\n$$\n\nCombining this into a single condition, we have\n\n$$\n3x<y<\\frac{x}{4}.\n$$\n\nWe must also include the line $y=3x$ since the boundary is included in the set (the curve is solid). So, we change the corresponding inequality symbol above as follows:\n\n$$\n3x\\le y<\\frac{x}{4}\n$$\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,3x\\le y<\\frac{x}{4}}.\n$$"}] [{:db/id #edb/ref 17592186345152 :knowledge-point/_questions [{:knowledge-point/id #uuid "e694b201-5ec6-5cc3-a608-2447d1cc1ed3" :knowledge-point/title "Linear Boundaries, One Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ea44f6d-1c2f-5747-9d0b-9191fbd7c26a" :answer/type {:db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186345154} {:answer/id #uuid "5119a61b-4d48-51c6-b91f-7e1d6c114c3c" :answer/type {:db/ident :answer.type/math} :answer/value "C" :db/id #edb/ref 17592186345155} {:answer/id #uuid "c592b6ab-4b76-544f-8b35-3a9e61b10209" :answer/type {:db/ident :answer.type/math} :answer/value "{C}^{2}" :db/id #edb/ref 17592186345156} {:answer/id #uuid "14132d5c-0f1f-5785-bfda-ba8432592f3b" :answer/type {:db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186345157}] :answer-field/correct {:answer/id #uuid "6ea44f6d-1c2f-5747-9d0b-9191fbd7c26a" :answer/type {:db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186345154} :answer-field/id #uuid "c2e273a9-2135-5aa8-a51c-738cab0c46c2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186345153} {:answer-field/choices [{:answer/id #uuid "c12775b6-95bc-531b-b30a-2476ea7536b7" :answer/type {:db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186345159} {:answer/id #uuid "3a797111-045a-5ed3-8c88-7b197c6e7f52" :answer/type {:db/ident :answer.type/math} :answer/value "\\ne " :db/id #edb/ref 17592186345160} {:answer/id #uuid "a00d25a0-936e-5f06-afa9-e061baf18f48" :answer/type {:db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186345161} {:answer/id #uuid "3f64f7b1-88a0-5f17-a3de-acfb5510e9f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\ge " :db/id #edb/ref 17592186345162} {:answer/id #uuid "16ed3a2c-ec1c-5720-956a-d18579441885" :answer/type {:db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186345163}] :answer-field/correct {:answer/id #uuid "3f64f7b1-88a0-5f17-a3de-acfb5510e9f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\ge " :db/id #edb/ref 17592186345162} :answer-field/id #uuid "87ac60d6-2648-5c11-9887-452587b99dcf" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186345158}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "0ffa407b-8974-5c7d-bae0-120b5fa4ce86" :question/math-academy-id "q-182013" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063256/assets/7703b8c621b268a9fcbb412cd3a0617045145d475024dc91cecfa09a18fc8712.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n{(x,y)\\in {{field-1}}\\,:\\,x\\,{{field-2}}\\,-2}\n$$" :question/worked-solution "The points in our set include all those that lie *right* the line $x=-2.$\n\nTherefore, a point $P(x,y)$ lies *inside* the shaded region if the following condition is satisfied:\n\n$$\nx>-2\n$$\n\nWe must also include the line $x=-2$ since the boundary is included in the set (the curve is solid). So, we change the inequality symbol above as follows:\n\n$$\nx\\ge -2\n$$\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,x\\ge -2}.\n$$"}]}
