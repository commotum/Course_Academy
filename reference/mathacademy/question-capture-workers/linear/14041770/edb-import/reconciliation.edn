ligned}]\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}6 \\\\ 2 \\\\ 1\\end{aligned}]+t[\\begin{aligned}-2 \\\\ 8 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}6 \\\\ 2 \\\\ 1\\end{aligned}]+[\\begin{aligned}-2t \\\\ 8t \\\\ t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}6-2t \\\\ 2+8t \\\\ 1+t\\end{aligned}]\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ \n\nTo get the equations for the line segment, we take only $t\\in [0,1].$ Notice that substitution of $t=0$ in the above equation gives the coordinates of $P$ and substitution of $t=1$ gives the coordinates of $Q.$\n\nTherefore, the parametric equations of the line segment $\\overset{―}{PQ}$ are the following:\n\n$$\n{\\begin{aligned}x=6-2t \\\\ y=2+8t \\\\ z=1+t\\end{aligned}\\,\\,t\\in [0,1]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041770/state.json" "file_sha256" "e048badaccffad5ba170e935b3eace70791838121dcb1f10e4ccf8d19136dfc1"} {"question" "q-236988" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041770/activity-metadata.json" "file_sha256" "04193a0fd5e3f8f0e92397cd0d61924f8c1f3a77c107660b594317d63d54a1a8"} {"question" "q-236988" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041770/state.json" "file_sha256" "e048badaccffad5ba170e935b3eace70791838121dcb1f10e4ccf8d19136dfc1"} {"question" "q-236988" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "1"] "category" "model_interpretation" "file" "/home/jake/Develop