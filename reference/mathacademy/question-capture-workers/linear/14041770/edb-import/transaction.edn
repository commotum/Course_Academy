/validate]} {:db/id "q-236988/field-1" :answer-field/id #uuid "08c0fe54-ddc5-55fb-a957-7a4c0f6885f8" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-236988/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-236988/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-236988/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-236988/field-2/50378f911ffc442eebcfd4dd06d9b6fb13e4be79b61fef963e2b327f77f546f0" :answer/id #uuid "6488fa5e-3f35-5dec-9323-5a92facd38b0" :answer/type :answer.type/math :answer/value "2+8t" :db/ensure [:answer/validate]} {:db/id "q-236988/field-2" :answer-field/id #uuid "3ce2553b-7bbe-5811-9554-53be6bba350c" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-236988/field-2/50378f911ffc442eebcfd4dd06d9b6fb13e4be79b61fef963e2b327f77f546f0" :answer-field/choices ["q-236988/field-2/50378f911ffc442eebcfd4dd06d9b6fb13e4be79b61fef963e2b327f77f546f0"] :db/ensure [:answer-field/validate]} {:db/id "q-236988" :question/id #uuid "39c8ef12-cb12-5036-895e-7cf2a1c19b74" :question/math-academy-id "q-236988" :question/problem "Fill in the missing parts in the parametric equations below that describe all the points on the line segment $\\overset{―}{PQ},$ where $P(6,2,1)$ and $Q(4,10,2).$\n\n| $x=$ | $6-2t$ | $t\\in [0,$ {{field-1}} $]$ |\n| --- | --- | --- |\n| $y=$ | {{field-2}} |  |\n| $z=$ | $1+t$ |  |" :question/worked-solution "First, we need to find a direction vector that is parallel to the line passing through the given points. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =[\\begin{aligned}4 \\\\ 10 \\\\ 2\\end{aligned}]-[\\begin{aligned}6 \\\\ 2 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}-2 \\\\ 8 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}6 \\\\ 2 \\\\ 1\\end{aligned}]+t[\\begin{aligned}-2 \\\\ 8 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}6 \\\\ 2 \\\\ 1\\end{aligned}]+[\\begin{aligned}-2t \\\\ 8t \\\\ t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}6-2t \\\\ 2+8t \\\\ 1+t\\end{aligned}]\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ \n\nTo get the equations for the line segment, we take only $t\\in [0,1].$ Notice that substitution of $t=0$ in the above equation gives the coordinates of $P$ and substitution of $t=1$ gives the coordinates of $Q.$\n\nTherefore, the parametric equations of the line segment $\\overset{―}{PQ}$ are the following:\n\n$$\n{\\begin{aligned}x=6-2t \\\\ y=2+8t \\\\ z=1+t\\end{aligned}\\,\\,t\\in [0,1]\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-236988/field-1" "q-236988/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d275a218-aa12-54bd-a4ff-4be892226f4f"] :knowledge-point/questions ["q-236988"] :db/ensure [:knowledge-point/validate]} {:db/id "q-236981/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "32e6d160-f530-53bb-9c9c-c8bce063acb6" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-236981/field-1" :answer-field/id #uuid "7a2eb105-e5a7-5017-aab2-cf0e53e6234f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-236981/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-236981/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-236981/field-2/0106cdcb5096326a4695abc1925c645ee1755e622f51e4df16aa74d92ab5d7b4" :answer/id #uuid "b1ad08a5-1270-51d0-b30c-d8016fd45867" :answer/type :answer.type/math :answer/value "1+5t" :db/ensure [:answer/validate]} {:db/id "q-236981/field-2" :answer-field/id #uuid "1bb620d7-b9ac-5170-8f82-c3cda5c51d31" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-236981/field-2/0106cdcb5096326a4695abc1925c645ee1755e622f51e4df16aa74d92ab5d7b4" :answer-field/choices ["q-236981/field-2/0106cdcb5096326a4695abc1925c645ee1755e622f51e4df16aa74d92ab5d7b4"] :db/ensure [:answer-field/validate]} {:db/id "q-236981/field-3/656b89c4b84b4888e51aa34ab4d22f5e3b005ca59276c270e37816b95196f89b" :answer/id #uuid "095900bc-1e03-577e-9d10-a20b8b686f05" :answer/type :answer.type/math :answer/value "-3-2t" :db/ensure [:answer/validate]} {:db/id "q-236981/field-3" :answer-field/id #uuid "4c65518d-fb00-5eda-a423-862601454e09" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-236981/field-3/656b89c4b84b4888e51aa34ab4d22f5e3b005ca59276c270e37816b95196f89b" :answer-field/choices ["q-236981/field-3/656b89c4b84b4888e51aa34ab4d22f5e3b005ca59276c270e37816b95196f89b"] :db/ensure [:answer-field/validate]} {:db/id "q-236981" :question/id #uuid "103d0b53-fba7-5574-8859-030cd8526a07" :question/math-academy-id "q-236981" :question/problem "Fill in the missing parts in the parametric equations below that describe all the points on the line segment $\\overset{―}{PQ},$ where $P(2,1,-3)$ and $Q(3,6,-5).$\n\n| $x=$ | $2+t$ | $t\\in [0,$ {{field-1}} $]$ |\n| --- | --- | --- |\n| $y=$ | {{field-2}} |  |\n| $z=$ | {{field-3}} |  |" :question/worked-solution "First, we need to find a direction vector that is parallel to the line passing through the given points. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =[\\begin{aligned}3 \\\\ 6 \\\\ -5\\end{aligned}]-[\\begin{aligned}2 \\\\ 1 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 5 \\\\ -2\\end{aligned}]\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}2 \\\\ 1 \\\\ -3\\end{aligned}]+t[\\begin{aligned}1 \\\\ 5 \\\\ -2\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}2 \\\\ 1 \\\\ -3\\end{aligned}]+[\\begin{aligned}t \\\\ 5t \\\\ -2t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}2+t \\\\ 1+5t \\\\ -3-2t\\end{aligned}]\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ \n\nTo get the equations for the line segment, we take only $t\\in [0,1].$ Notice that substitution of $t=0$ in the above equation gives the coordinates of $P$ and substitution of $t=1$ gives the coordinates of $Q.$\n\nTherefore, the parametric equations of the line segment $\\overset{―}{PQ}$ are the following:\n\n$$\n{\\begin{aligned}x=2+t \\\\ y=1+5t \\\\ z=-3-2t\\end{aligned}\\,\\,t\\in [0,1]\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-236981/field-1" "q-236981/field-2" "q-236981/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d275a218-aa12-54bd-a4ff-4be892226f4f"] :knowledge-point/questions ["q-236981"] :db/ensure [:knowledge-point/validate]} {:db/id "q-236991/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "62a025e7-22f9-55a7-bbec-9097a8473a91" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-236991/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "1aace4d2-f6bb-5a1c-932a-7999444d7f8c" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-236991/field-1" :answer-field/id #uuid "ac00e134-fb5e-53b9-991c-6c847a1416c5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-236991/field-1/d971375f57c56d8a55a09f2b892e108787b0