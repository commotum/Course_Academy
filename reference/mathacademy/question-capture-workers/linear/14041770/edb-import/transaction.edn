ed}]+t[\\begin{aligned}-4 \\\\ 3 \\\\ -1\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ \n\nThis implies that the line passes through the point $(5,-7,9)$ and is parallel to the vector $v=[\\begin{aligned}-4 \\\\ 3 \\\\ -1\\end{aligned}].$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-127003/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b3699391-68e8-5c59-8ca2-83fded9f22de"] :knowledge-point/questions ["q-127003"] :db/ensure [:knowledge-point/validate]} {:db/id "q-22301/selection/51c87b6720f696ed489fd344585e3d3fd755d242c9802f4af112671d7d748419" :answer/id #uuid "156453ff-6483-5567-8cba-b2845dd6a48d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ -4 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-22301/selection/759c9678500e91b2ecffe41b5313b269dfb591dd88993ed0efa989e3fa53efdf" :answer/id #uuid "e29dbda6-f364-588c-9e00-f11da1bf3f40" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ -4 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-22301/selection/2a2dfa122b83e1fbc6b70be6ef717447914d5f79f3dfea05d917ce624c516d65" :answer/id #uuid "329c241f-0d93-5f7f-8960-fd8b6d634cf1" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 2 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-22301/selection/7ad95523b3a296579054c3fd959c063535b524676c797502615f0f533808e4d6" :answer/id #uuid "5b12767e-c18b-54c4-a4ba-cb0bacd89255" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ -4 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-22301/selection/80b70cbc61dccd2e57e6ea25179c5ed153ad9d29e784c51c8fe629635b68d2d8" :answer/id #uuid "8b2472f9-1cff-5da2-877c-22cf92446010" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ 2 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-22301/selection" :answer-field/id #uuid "d429ff55-de2b-5d12-a6