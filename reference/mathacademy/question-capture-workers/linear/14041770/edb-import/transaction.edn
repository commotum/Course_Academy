ue "{\\begin{aligned}x=7-3t \\\\ y=-11-2t \\\\ z=4+7t\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-127065/selection/d0f3c387625c5da85a420c89bd1768e802cbda5eca60a150fcec8ccc16034185" :answer/id #uuid "d5bdabce-6dcf-5334-a2f9-c1909f66c74a" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x=7+3t \\\\ y=11-2t \\\\ z=3+7t\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-127065/selection/84eb260765c79443f22625d0f51a562be6717b41d8e99ac4095ae63cd08e8b1a" :answer/id #uuid "6753ca76-c745-5e12-977d-db60884dea68" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x=7+3t \\\\ y=-11+2t \\\\ z=3-7t\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-127065/selection/64d1ec8677d523c7bb42ffa8575aa51c83cc350941ebd15e79613d370b90a00c" :answer/id #uuid "87c2d36b-627d-5f64-8a6c-a09f1ad9c528" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x=7-3t \\\\ y=-11+2t \\\\ z=3+7t\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-127065/selection" :answer-field/id #uuid "65f4f4c5-0296-597d-bba7-0781ac08f9b8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127065/selection/64d1ec8677d523c7bb42ffa8575aa51c83cc350941ebd15e79613d370b90a00c" :answer-field/choices ["q-127065/selection/a1455cd9c5e4f622ac4c2d42fad49120e6d8b5704e10d046282fa1f976276b3e" "q-127065/selection/92a5387a2a2b61016180b3713a726fc8c5eb01e68630c568489f44206e0de455" "q-127065/selection/d0f3c387625c5da85a420c89bd1768e802cbda5eca60a150fcec8ccc16034185" "q-127065/selection/84eb260765c79443f22625d0f51a562be6717b41d8e99ac4095ae63cd08e8b1a" "q-127065/selection/64d1ec8677d523c7bb42ffa8575aa51c83cc350941ebd15e79613d370b90a00c"] :db/ensure [:answer-field/validate]} {:db/id "q-127065" :question/id #uuid "d58634d7-9f45-5d26-80b4-6e2ac3418e11" :question/math-academy-id "q-127065" :question/problem "Find the parametric equations of the straight line that passes through $P(7,-11,3)$ and is parallel to $v=⟨-3,2,7⟩.$" :question/worked-solution "First, the vector equation of the line is \n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}7 \\\\ -11 \\\\ 3\\end{aligned}]+t[\\begin{aligned}-3 \\\\ 2 \\\\ 7\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}7 \\\\ -11 \\\\ 3\\end{aligned}]+[\\begin{aligned}-3t \\\\ 2t \\\\ 7t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}7-3t \\\\ -11+2t \\\\ 3+7t\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ Therefore, the parametric equations are:\n\n$$\n{\\begin{aligned}x=7-3t \\\\ y=-11+2t \\\\ z=3+7t\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-127065/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "debd4ccc-de40-55a6-9236-9bf9fff0bdb1"] :knowledge-point/questions ["q-127065"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127048/selection/353c5753ba5977d1f952b383114c909ea5a859be6805e0ab57e85f1454ed6bcb" :answer/id #uuid "6f1f35b6-19f9-5c49-ae31-4ed228f68e63" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x=3+2t \\\\ y=-2+4t \\\\ z=4-3t\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-127048/selection/6dc480e00f15f2a692b0665f17f2e35acedeb9cf2bdbd46685942dd736d4797f" :answer/id #uuid "fb69b7ca-2dd9-5764-89f4-0d200d2050e5" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x=3+4t \\\\ y=3+5t \\\\ z=-5+2t\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-127048/selection/5cf5d1c182ecbb06bd9718cfe0b9f19613e5f1cbfedc5b62cc5358d796d1597b" :answer/id #uuid "914dcda8-de3f-5054-ba61-40cde7ea08e2" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x=3+5t \\\\ y=-3+4t \\\\ z=5+4t\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-127048/selection/0ddbe330a2cf37f836720244c98d7aed67d9021f330aa7c38b7162e2522b627f" :answer/id #uuid "0cf93689-5f93-5363-9de5-5c15ef512ac4" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x=5+4t \\\\ y=-3-5t \\\\ z=5-4t\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-127048/selection/0275db6591fd4f96b61527606103a40eebc568827c34daa3df14804c982596f0" :answer/id #uuid "b0367c22-7c6b-5f67-970f-eecd09519738" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x=3+4t \\\\ y=-3+5t \\\\ z=5-4t\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-127048/selection" :answer-field/id #uuid "7b8f9f8e-b6ae-538f-a6ff-1582630b12c2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127048/selection/0275db6591fd4f96b61527606103a40eebc568827c34daa3df14804c982596f0" :answer-field/choices ["q-127048/selection/353c5753ba5977d1f952b383114c909ea5a859be6805e0ab57e85f1454ed6bcb" "q-127048/selection/6dc480e00f15f2a692b0665f17f2e35acedeb9cf2bdbd46685942dd736d4797f" "q-127048/selection/5cf5d1c182ecbb06bd9718cfe0b9f19613e5f1cbfedc5b62cc5358d796d1597b" "q-127048/selection/0ddbe330a2cf37f836720244c98d7aed67d9021f330aa7c38b7162e2522b627f" "q-127048/selection/0275db6591fd4f96b61527606103a40eebc568827c34daa3df14804c982596f0"] :db/ensure [:answer-field/validate]} {:db/id "q-127048" :question/id #uuid "5d12ca50-9b75-5c35-aef5-b35bedbaf057" :question/math-academy-id "q-127048" :question/problem "Find the parametric equations of the line that passes through the points $P(3,-3,5)$ and $Q(7,2,1).$" :question/worked-solution "We need to find a direction vector that is parallel to the given line. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =[\\begin{aligned}7 \\\\ 2 \\\\ 1\\end{aligned}]-[\\begin{aligned}3 \\\\ -3 \\\\ 5\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ 5 \\\\ -4\\end{aligned}]\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}3 \\\\ -3 \\\\ 5\\end{aligned}]+t[\\begin{aligned}4 \\\\ 5 \\\\ -4\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}3 \\\\ -3 \\\\ 5\\end{aligned}]+[\\begin{aligned}4t \\\\ 5t \\\\ -4t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}3+4t \\\\ -3+5t \\\\ 5-4t\\end{aligned}]\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ And finally, the parametric equations:\n\n$$\n{\\begin{aligned}x=3+4t \\\\ y=-3+5t \\\\ z=5-4t\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-127048/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "debd4ccc-de40-55a6-9236-9bf9fff0bdb1"] :knowledge-point/questions ["q-127048"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127064/selection/6c081efdffc3c272c3bdf9fac8f5a765d9251c5d59271710882a1927e160041b" :answer/id #uuid "356e6918-9b4e-5518-89a8-ff14240781e0" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x=3+t \\\\ y=2-5t \\\\ z=6+5t\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-127064/selection/38f6007a1d13a48d36d75029c6f53d9dda4d211f0b50d64a5c64963d31394f6e" :answer/id #uuid "5446e494-df1b-5059-b76f-2e1bea17772a" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x=2-t \\\\ y=5-5t \\\\ z=5-6t\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-127064/selection/4a963ee8579bebd3b6fcbe11214b23ca3690015197ef4b5d7050d8e49ede2ae7" :answer/id #uuid "e9514bdd-a24b-5796-a738-52ca00927084" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x=2+t \\\\ y=3-5t \\\\ z=5+6t\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-127064/selection/3f89f897871583f1a1e7d79ed659f2c8e97e49e7f668bae4925a61c29b1a2f0d" :answer/id #uuid "734625c0-e2d9-51ea-9c8d-8c66e6b3a4f4" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x=2-t \\\\ y=3+5t \\\\ z=5+6t\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-127064/selection/c35e40cf73cdb57fa971fbcfefbbc295e8f3eb7eaf7c98008879aeeebaadc87e" :answer/id #uu