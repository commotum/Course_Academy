 \\\\ z\\end{aligned}] & =[\\begin{aligned}2 \\\\ 1 \\\\ 0\\end{aligned}]+[\\begin{aligned}t \\\\ t \\\\ -t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}2+t \\\\ 1+t \\\\ -t\\end{aligned}]\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ \n\nTo get the equations for the line segment, we take only $t\\in [0,1].$ Notice that substitution of $t=0$ in the above equation gives the coordinates of $P$ and substitution of $t=1$ gives the coordinates of $Q.$\n\nTherefore, the parametric equations of the line segment $\\overset{―}{PQ}$ are the following:\n\n$$\n{\\begin{aligned}x=2+t \\\\ y=1+t \\\\ z=-t\\end{aligned}\\,\\,t\\in [0,1]\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-236991/field-1" "q-236991/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d275a218-aa12-54bd-a4ff-4be892226f4f"] :knowledge-point/questions ["q-236991"] :db/ensure [:knowledge-point/validate]} {:db/id "q-236982/field-1/bfba8870996a0e1226b34d4185a972ba25d218e8b51f9ff36c71f38c6cb54f09" :answer/id #uuid "0987641c-7f73-5003-941d-7fe503310468" :answer/type :answer.type/math :answer/value "-4+4t" :db/ensure [:answer/validate]} {:db/id "q-236982/field-1" :answer-field/id #uuid "a18e49a9-1921-5eab-b6c4-24acf04b56ee" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-236982/field-1/bfba8870996a0e1226b34d4185a972ba25d218e8b51f9ff36c71f38c6cb54f09" :answer-field/choices ["q-236982/field-1/bfba8870996a0e1226b34d4185a972ba25d218e8b51f9ff36c71f38c6cb54f09"] :db/ensure [:answer-field/validate]} {:db/id "q-236982/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "816b6bec-0b6a-5b61-9553-99760ba5cd46" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-236982/field-2" :answer-field/id #uuid "2280d646-8b5f-5bb4-a129-7d8436245450" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-236982/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-236982/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-236982/field-3/403149ca7b39b05714a23a45f64c3aab92333834f065430cababa5dc0e0479e7" :answer/id #uuid "0b0ad7a4-e070-58df-b6bb-ed9592dd31cb" :answer/type :answer.type/math :answer/value "4-t" :db/ensure [:answer/validate]} {:db/id "q-236982/field-3" :answer-field/id #uuid "7481a238-1235-5bf9-ba0f-01c8cc89f42e" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-236982/field-3/403149ca7b39b05714a23a45f64c3aab92333834f065430cababa5dc0e0479e7" :answer-field/choices ["q-236982/field-3/403149ca7b39b05714a23a45f64c3aab92333834f065430cababa5dc0e0479e7"] :db/ensure [:answer-field/validate]} {:db/id "q-236982" :question/id #uuid "c29e7b23-e914-5d7e-8ead-87a0c88d3626" :question/math-academy-id "q-236982" :question/problem "Fill in the missing parts in the parametric equations below that describe all the points on the line segment $\\overset{―}{PQ},$ where $P(-4,-2,4)$ and $Q(0,8,3).$\n\n| $x=$ | {{field-1}} | $t\\in [$ {{field-2}} $,1]$ |\n| --- | --- | --- |\n| $y=$ | $-2+10t$ |  |\n| $z=$ | {{field-3}} |  |" :question/worked-solution "First, we need to find a direction vector that is parallel to the line passing through the given points. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =[\\begin{aligned}0 \\\\ 8 \\\\ 3\\end{aligned}]-[\\begin{aligned}-4 \\\\ -2 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ 10 \\\\ -1\\end{aligned}]\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}-4 \\\\ -2 \\\\ 4\\end{aligned}]+t[\\begin{aligned}4 \\\\ 10 \\\\ -1\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-4 \\\\ -2 \\\\ 4\\end{aligned}]+[\\begin{aligned}4t \\\\ 10t \\\\ -t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-4+4t \\\\ -2+10t \\\\ 4-t\\end{aligned}]\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ \n\nTo get the equations for the line segment, we take only $t\\in [0,1].$ Notice that substitution of $t=0$ in the above equation gives the coordinates of $P$ and substitution of $t=1$ gives the coordinates of $Q.$\n\nTherefore, the parametric equations of the line segment $\\overset{―}{PQ}$ are the following:\n\n$$\n{\\begin{aligned}x=-4+4t \\\\ y=-2+10t \\\\ z=4-t\\end{aligned}\\,\\,t\\in [0,1]\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-236982/field-1" "q-236982/field-2" "q-236982/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d275a218-aa12-54bd-a4ff-4be892226f4f"] :knowledge-point/questions ["q-236982"] :db/ensure [:knowledge-point/validate]} {:db/id "q-236980/field-1/e0dee7706dfa9f6d998287f2a2e197788cef4832eb1dee0869a86f87ddbca1f1" :answer/id #uuid "eb3e20c2-1760-5bf4-a849-2a83c17f20fa" :answer/type :answer.type/math :answer/value "5+2t" :db/ensure [:answer/validate]} {:db/id "q-236980/field-1" :answer-field/id #uuid "1b1c7016-0010-52d8-a7c5-635d4f41b316" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-236980/field-1/e0dee7706dfa9f6d998287f2a2e197788cef4832eb1dee0869a86f87ddbca1f1" :answer-field/choices ["q-236980/field-1/e0dee7706dfa9f6d998287f2a2e197788cef4832eb1dee0869a86f87ddbca1f1"] :db/ensure [:answer-field/validate]} {:db/id "q-236980/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "4d994d0d-5c0a-5e5f-b13b-d3bf1012193f" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-236980/field-2" :answer-field/id #uuid "5d84398c-07d8-5ede-801e-2264768f79c2" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-236980/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-236980/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-236980/field-3/4153e51d0dadbc77137e2cf780b94e4ff3a779978668f53d711546d3bdd6f260" :answer/id #uuid "67315ed0-fe74-5eb7-95fc-902c6a8dd4e5" :answer/type :answer.type/math :answer/value "2t" :db/ensure [:answer/validate]} {:db/id "q-236980/field-3" :answer-field/id #uuid "196cc9b8-295a-530a-a4cb-b41dd3b1c9d6" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-236980/field-3/4153e51d0dadbc77137e2cf780b94e4ff3a779978668f53d711546d3bdd6f260" :answer-field/choices ["q-236980/field-3/4153e51d0dadbc77137e2cf780b94e4ff3a779978668f53d711546d3bdd6f260"] :db/ensure [:answer-field/validate]} {:db/id "q-236980" :question/id #uuid "936b9911-415c-545b-90e9-c64633cbe906" :question/math-academy-id "q-236980" :question/problem "Fill in the missing parts in the parametric equations below that describe all the points on the line segment $\\overset{―}{PQ},$ where $P(5,0,-1)$ and $Q(7,2,2).$\n\n| $x=$ | {{field-1}} | $t\\in [$ {{field-2}} $,1]$ |\n| --- | --- | --- |\n| $y=$ | {{field-3}} |  |\n| $z=$ | $-1+3t$ |  |" :question/worked-solution "First, we need to find a direction vector that is parallel to the line passing through the given points. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =[\\begin{aligned}7 \\\\ 2 \\\\ 2\\end{aligned}]-[\\begin{aligned}5 \\\\ 0 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ 2 \\\\ 3\\end{aligned}]\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}5 \\\\ 0 \\\\ -1\\end{aligned}]+t[\\begin{aligned}2 \\\\ 2 \\\\ 3\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}5 \\\\ 0 \\\\ -1\\end{aligned}]+[\\begin{aligned}2t \\\\ 2t \\\\ 3t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}5+2t \\\\ 2t \\\\ -1+3t\\end{aligned}]\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ \n\nTo get the equations for the line segment, we take only $t\\in [0,1].$ Notice that substitution of $t=0$ in the above equation gives the coordinates of $P$ and substitution of $t=1$ gives the coordinates of $Q.$\n\nTherefore, the parametric equations of the line segment $\\overset{―}{PQ}$ are the following:\n\n$$\n{\\begin{aligned}x=5+2t \\\\ y=2t \\\\ z=-1+3t\\end{aligned}\\,\\,t\\in [0,1]\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-236980/field-1" "q-236980/field-2" "q-236980/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d275a218-aa12-54bd-a4ff-4be892226f4f"] :knowledge-point/questions ["q-236980"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-15602"] :question/problem "Consider the straight line given by the following parametric equations: \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041770/assets/a664a3af1ba466491d209dadd32a3be026a5179ac2d0281b55f30917f9ab016b.png)\nWhat would be the vector equation of the line?" :question/worked-solution "These parametric equations are equivalent to\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}2+2t \\\\ 5t \\\\ 1-t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}2 \\\\ 0 \\\\ 1\\end{aligned}]+[\\begin{aligned}2t \\\\ 5t \\\\ -t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}2 \\\\ 0 \\\\ 1\\end{aligned}]+t[\\begin{aligned}2 \\\\ 5 \\\\ -1\\end{aligned}] \\\\ r & =[\\begin{aligned}2 \\\\ 0 \\\\ 1\\end{aligned}]+t[\\begin{aligned}2 \\\\ 5 \\\\ -1\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t \\in (-\\infty,\\infty).$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-15603"] :question/problem "Consider the straight line given by the following parametric equations:\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041770/assets/a4c6f7b2422f1515e1708bf1641dcbec57eeb2d85e4ac03bd98668db34088afc.png)\nFind a vector that is parallel to the line." :question/worked-solution "First, let's find the corresponding vector equation:\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}5-t \\\\ 3 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}5 \\\\ 3 \\\\ 1\\end{aligned}]+[\\begin{aligned}-t \\\\ 0 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}5 \\\\ 3 \\\\ 1\\end{aligned}]+t[\\begin{aligned}-1 \\\\ 0 \\\\ 0\\end{aligned}] \\\\ r & =[\\begin{aligned}5 \\\\ 3 \\\\ 1\\end{aligned}]+t[\\begin{aligned}-1 \\\\ 0 \\\\ 0\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t \\in (-\\infty,\\infty).$\n\nThis implies that the line passes through the point $(5,3,1)$ and is parallel to the vector ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041770/assets/11701a2d63851a3f241d8bd905693abaaa6eda6fe4ba0c5710c92d8189595ffd.png)" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-15604"] :question/problem "Find the parametric equations of the line shown in the figure below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041770/assets/53386f04f4025fda6ab579113a8ecb53a19f4dc0a77903adc05bac3a71429717.png)" :question/worked-solution "We know that the line passes through the points $P(3,3,-5)$ and $Q(1,0,-1)$. Now, we need to find a direction vector that is parallel to the given line. We can use the vector $\\overrightarrow{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =[\\begin{aligned}1 \\\\ 0 \\\\ -1\\end{aligned}]-[\\begin{aligned}3 \\\\ 3 \\\\ -5\\end{aligned}] \\\\  & =[\\begin{aligned}-2 \\\\ -3 \\\\ 4\\end{aligned}].\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}3 \\\\ 3 \\\\ -5\\end{aligned}]+t[\\begin{aligned}-2 \\\\ -3 \\\\ 4\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}3 \\\\ 3 \\\\ -5\\end{aligned}]+[\\begin{aligned}-2t \\\\ -3t \\\\ 4t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}3-2t \\\\ 3-3t \\\\ -5+4t\\end{aligned}]\\end{aligned}\n$$\n\nwhere $t \\in (-\\infty,\\infty).$ And finally, the parametric equations:\n\n$$\n{\\begin{aligned}x=3-2t \\\\ y=3-3t \\\\ z=-5+4t\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-15605"] :question/problem "Find the parametric equations that describe all the points on the line segment $\\overline{PQ},$ where $P(1,-5,3)$ and $Q(0, 4, -4).$" :question/worked-solution "First, we need to find a direction vector that is parallel to the line passing through the given points. We can use the vector $\\overrightarrow{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =[\\begin{aligned}0 \\\\ 4 \\\\ -4\\end{aligned}]-[\\begin{aligned}1 \\\\ -5 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ 9 \\\\ -7\\end{aligned}]\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}1 \\\\ -5 \\\\ 3\\end{aligned}]+t[\\begin{aligned}-1 \\\\ 9 \\\\ -7\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}1 \\\\ -5 \\\\ 3\\end{aligned}]+[\\begin{aligned}-t \\\\ 9t \\\\ -7t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}1-t \\\\ -5+9t \\\\ 3-7t\\end{aligned}]\\end{aligned}\n$$\n\nwhere $t \\in (-\\infty,\\infty).$ \n\nTo get the equations for the line segment, we take only $t \\in [0,1].$ Notice that substitution of $t=0$ in the above equation gives the coordinates of $P$ and substitution of $t=1$ gives the coordinates of $Q.$\n\nTherefore, the parametric equations of the line segment $\\overline{PQ}$ are the following:\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041770/assets/63d8bf337e8d7fa2323eb049b51d40349564336a12d53ffd3259b1e7211ef7dd.png)" :db/ensure [:question/validate]}]
