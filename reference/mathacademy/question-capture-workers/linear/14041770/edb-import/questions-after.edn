 \\\\ 5\\end{aligned}]+[\\begin{aligned}t \\\\ -5t \\\\ 6t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}2+t \\\\ 3-5t \\\\ 5+6t\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ Therefore, the parametric equations are: \n\n$$\n{\\begin{aligned}x=2+t \\\\ y=3-5t \\\\ z=5+6t\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186314787 :knowledge-point/_questions [{:knowledge-point/id #uuid "debd4ccc-de40-55a6-9236-9bf9fff0bdb1" :knowledge-point/title "Finding the Parametric Equations of a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87c2d36b-627d-5f64-8a6c-a09f1ad9c528" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=7-3t \\\\ y=-11+2t \\\\ z=3+7t\\end{aligned}" :db/id #edb/ref 17592186314789} {:answer/id #uuid "6753ca76-c745-5e12-977d-db60884dea68" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=7+3t \\\\ y=-11+2t \\\\ z=3-7t\\end{aligned}" :db/id #edb/ref 17592186314790} {:answer/id #uuid "b42ef42e-1337-5b35-ba54-883e7d684a97" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=7-3t \\\\ y=-11-2t \\\\ z=4+7t\\end{aligned}" :db/id #edb/ref 17592186314791} {:answer/id #uuid "00448bb0-44e2-58c8-92b1-aeda5e4b0a22" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=7+3t \\\\ y=11+2t \\\\ z=3-7t\\end{aligned}" :db/id #edb/ref 17592186314792} {:answer/id #uuid "d5bdabce-6dcf-5334-a2f9-c1909f66c74a" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=7+3t \\\\ y=11-2t \\\\ z=3+7t\\end{aligned}" :db/id #edb/ref 17592186314793}] :answer-field/correct {:answer/id #uuid "87c2d36b-627d-5f64-8a6c-a09f1ad9c528" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=7-3t \\\\ y=-11+2t \\\\ z=3+7t\\end{aligned}" :db/id #edb/ref 17592186314789} :answer-field/id #uuid "65f4f4c5-0296-597d-bba7-0781ac08f9b8" :answer-field/key "selection" :answer