t \\\\ 5t \\\\ -2t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}2+t \\\\ 1+5t \\\\ -3-2t\\end{aligned}]\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ \n\nTo get the equations for the line segment, we take only $t\\in [0,1].$ Notice that substitution of $t=0$ in the above equation gives the coordinates of $P$ and substitution of $t=1$ gives the coordinates of $Q.$\n\nTherefore, the parametric equations of the line segment $\\overset{―}{PQ}$ are the following:\n\n$$\n{\\begin{aligned}x=2+t \\\\ y=1+5t \\\\ z=-3-2t\\end{aligned}\\,\\,t\\in [0,1]\n$$"}] [{:db/id #edb/ref 17592186314828 :knowledge-point/_questions [{:knowledge-point/id #uuid "d275a218-aa12-54bd-a4ff-4be892226f4f" :knowledge-point/title "Finding the Parametric Equations of a Segment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0987641c-7f73-5003-941d-7fe503310468" :answer/type {:db/ident :answer.type/math} :answer/value "-4+4t" :db/id #edb/ref 17592186314830}] :answer-field/correct {:answer/id #uuid "0987641c-7f73-5003-941d-7fe503310468" :answer/type {:db/ident :answer.type/math} :answer/value "-4+4t" :db/id #edb/ref 17592186314830} :answer-field/id #uuid "a18e49a9-1921-5eab-b6c4-24acf04b56ee" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314829} {:answer-field/choices [{:answer/id #uuid "816b6bec-0b6a-5b61-9553-99760ba5cd46" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186314832}] :answer-field/correct {:answer/id #uuid "816b6bec-0b6a-5b61-9553-99760ba5cd46" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186314832} :answer-field/id #uuid "2280d646-8b5f-5bb4-a129-7d8436245450" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314831} {:answer-field/choices [{:answer/id #uuid "0b0ad7a4-e070-58df-b6bb-ed9592dd31cb" :answer/type {:db/ident :