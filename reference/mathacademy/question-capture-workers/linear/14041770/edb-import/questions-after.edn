\\\\ \\frac{1}{4}t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-7 \\\\ -1 \\\\ \\frac{3}{5}\\end{aligned}]+t[\\begin{aligned}5 \\\\ -10 \\\\ \\frac{1}{4}\\end{aligned}] \\\\ r & =[\\begin{aligned}-7 \\\\ -1 \\\\ \\frac{3}{5}\\end{aligned}]+t[\\begin{aligned}5 \\\\ -10 \\\\ \\frac{1}{4}\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ \n\nThis implies that the straight line passes through the point $(-7,-1,\\frac{3}{5})$ and is parallel to the vector $v=[\\begin{aligned}5 \\\\ -10 \\\\ \\frac{1}{4}\\end{aligned}].$"}] [{:db/id #edb/ref 17592186314773 :knowledge-point/_questions [{:knowledge-point/id #uuid "debd4ccc-de40-55a6-9236-9bf9fff0bdb1" :knowledge-point/title "Finding the Parametric Equations of a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b0367c22-7c6b-5f67-970f-eecd09519738" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=3+4t \\\\ y=-3+5t \\\\ z=5-4t\\end{aligned}" :db/id #edb/ref 17592186314775} {:answer/id #uuid "0cf93689-5f93-5363-9de5-5c15ef512ac4" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=5+4t \\\\ y=-3-5t \\\\ z=5-4t\\end{aligned}" :db/id #edb/ref 17592186314776} {:answer/id #uuid "6f1f35b6-19f9-5c49-ae31-4ed228f68e63" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=3+2t \\\\ y=-2+4t \\\\ z=4-3t\\end{aligned}" :db/id #edb/ref 17592186314777} {:answer/id #uuid "914dcda8-de3f-5054-ba61-40cde7ea08e2" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=3+5t \\\\ y=-3+4t \\\\ z=5+4t\\end{aligned}" :db/id #edb/ref 17592186314778} {:answer/id #uuid "fb69b7ca-2dd9-5764-89f4-0d200d2050e5" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=3+4t \\\\ y=3+5t \\\\ z=-5+2t\\end{aligned}" :db/id #edb/ref 17592186314779}] :answer-field/correct {:answer/id #uuid "b0367c22-7c6b-5f67-970f-eecd09519738" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=3+4t \\\\ y=-3+5t \\\\ z=5-4t\\end{aligned}" :db/id #edb/ref 17592186314775} :answer-field/id #uuid "7b8f9f8e-b6ae-538f-a6ff-1582630b12c2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314774}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5d12ca50-9b75-5c35-aef5-b35bedbaf057" :question/math-academy-id "q-127048" :question/problem "Find the parametric equations of the line that passes through the points $P(3,-3,5)$ and $Q(7,2,1).$" :question/worked-solution "We need to find a direction vector that is parallel to the given line. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =[\\begin{aligned}7 \\\\ 2 \\\\ 1\\end{aligned}]-[\\begin{aligned}3 \\\\ -3 \\\\ 5\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ 5 \\\\ -4\\end{aligned}]\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}3 \\\\ -3 \\\\ 5\\end{aligned}]+t[\\begin{aligned}4 \\\\ 5 \\\\ -4\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}3 \\\\ -3 \\\\ 5\\end{aligned}]+[\\begin{aligned}4t \\\\ 5t \\\\ -4t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}3+4t \\\\ -3+5t \\\\ 5-4t\\end{aligned}]\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ And finally, the parametric equations:\n\n$$\n{\\begin{aligned}x=3+4t \\\\ y=-3+5t \\\\ z=5-4t\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186314780 :knowledge-point/_questions [{:knowledge-point/id #uuid "debd4ccc-de40-55a6-9236-9bf9fff0bdb1" :knowledge-point/title "Finding the Parametric Equations of a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5446e494-df1b-5059-b76f-2e1bea17772a" :answer/type 