begin{aligned}3t \\\\ 2t \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}2+3t \\\\ 3+2t \\\\ 0\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ Therefore, the parametric equations are:\n\n$$\n{\\begin{aligned}x=2+3t \\\\ y=3+2t \\\\ z=0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186314807 :knowledge-point/_questions [{:knowledge-point/id #uuid "b3699391-68e8-5c59-8ca2-83fded9f22de" :knowledge-point/title "Finding a Vector Parallel To a Straight Line Given Parametrically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "329c241f-0d93-5f7f-8960-fd8b6d634cf1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 2 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186314809} {:answer/id #uuid "156453ff-6483-5567-8cba-b2845dd6a48d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ -4 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186314810} {:answer/id #uuid "e29dbda6-f364-588c-9e00-f11da1bf3f40" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ -4 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186314811} {:answer/id #uuid "5b12767e-c18b-54c4-a4ba-cb0bacd89255" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ -4 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186314812} {:answer/id #uuid "8b2472f9-1cff-5da2-877c-22cf92446010" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ 2 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186314813}] :answer-field/correct {:answer/id #uuid "e29dbda6-f364-588c-9e00-f11da1bf3f40" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ -4 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186314811} :answer-field/id #uuid "d429ff55-de2b-5d12-a616-8527bdc051ff" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314808}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ff24dde6-0a9a-5793-9f5c-5477e633ad31" :question/math-academy-id "q-22301" :question/problem "Consider the straight line given by the following parametric equations:\n\n$$\n{\\begin{aligned}x=1+3t \\\\ y=2-4t \\\\ z=2+t\\end{aligned}\n$$\n\nFind a vector that is parallel to the line." :question/worked-solution "First, let's find the corresponding vector equation:\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}1+3t \\\\ 2-4t \\\\ 2+t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}1 \\\\ 2 \\\\ 2\\end{aligned}]+[\\begin{aligned}3t \\\\ -4t \\\\ t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}1 \\\\ 2 \\\\ 2\\end{aligned}]+t[\\begin{aligned}3 \\\\ -4 \\\\ 1\\end{aligned}] \\\\ r & =[\\begin{aligned}1 \\\\ 2 \\\\ 2\\end{aligned}]+t[\\begin{aligned}3 \\\\ -4 \\\\ 1\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ \n\nThis implies that the line passes through the point $(1,2,2)$ and is parallel to the vector $v=[\\begin{aligned}3 \\\\ -4 \\\\ 1\\end{aligned}].$"}] [{:db/id #edb/ref 17592186314814 :knowledge-point/_questions [{:knowledge-point/id #uuid "d275a218-aa12-54bd-a4ff-4be892226f4f" :knowledge-point/title "Finding the Parametric Equations of a Segment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb3e20c2-1760-5bf4-a849-2a83c17f20fa" :answer/type {:db/ident :answer.type/math} :answer/value "5+2t" :db/id #edb/ref 17592186314816}] :answer-field/correct {:answer/id #uuid "eb3e20c2-1760-5bf4-a849-2a83c17f20fa" :answer/type {:db/ident :answer.type/math} :answer/value "5+2t" :db/id #edb/ref 17592186314816} :answer-field/id #uuid "1b1c7016-0010-52d8-a7c5-635d4f41b316" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314815} {:answer-field/choices [{:answer/id #uuid "4d994d0d-5c0a-5e5f-b13b-d3bf1012193f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186314818}] :answer-field/correct {:answer/id #uuid "4d994d0d-5c0a-5e5f-b13b-d3bf1012193f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186314818} :answer-field/id #uuid "5d84398c-07d8-5ede-801e-2264768f79c2" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314817} {:answer-field/choices [{:answer/id #uuid "67315ed0-fe74-5eb7-95fc-902c6a8dd4e5" :answer/type {:db/ident :answer.type/math} :answer/value "2t" :db/id #edb/ref 17592186314820}] :answer-field/correct {:answer/id #uuid "67315ed0-fe74-5eb7-95fc-902c6a8dd4e5" :answer/type {:db/ident :answer.type/math} :answer/value "2t" :db/id #edb/ref 17592186314820} :answer-field/id #uuid "196cc9b8-295a-530a-a4cb-b41dd3b1c9d6" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314819}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "936b9911-415c-545b-90e9-c64633cbe906" :question/math-academy-id "q-236980" :question/problem "Fill in the missing parts in the parametric equations below that describe all the points on the line segment $\\overset{―}{PQ},$ where $P(5,0,-1)$ and $Q(7,2,2).$\n\n| $x=$ | {{field-1}} | $t\\in [$ {{field-2}} $,1]$ |\n| --- | --- | --- |\n| $y=$ | {{field-3}} |  |\n| $z=$ | $-1+3t$ |  |" :question/worked-solution "First, we need to find a direction vector that is parallel to the line passing through the given points. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =[\\begin{aligned}7 \\\\ 2 \\\\ 2\\end{aligned}]-[\\begin{aligned}5 \\\\ 0 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ 2 \\\\ 3\\end{aligned}]\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}5 \\\\ 0 \\\\ -1\\end{aligned}]+t[\\begin{aligned}2 \\\\ 2 \\\\ 3\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}5 \\\\ 0 \\\\ -1\\end{aligned}]+[\\begin{aligned}2t \\\\ 2t \\\\ 3t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}5+2t \\\\ 2t \\\\ -1+3t\\end{aligned}]\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ \n\nTo get the equations for the line segment, we take only $t\\in [0,1].$ Notice that substitution of $t=0$ in the above equation gives the coordinates of $P$ and substitution of $t=1$ gives the coordinates of $Q.$\n\nTherefore, the parametric equations of the line segment $\\overset{―}{PQ}$ are the following:\n\n$$\n{\\begin{aligned}x=5+2t \\\\ y=2t \\\\ z=-1+3t\\end{aligned}\\,\\,t\\in [0,1]\n$$"}] [{:db/id #edb/ref 17592186314821 :knowledge-point/_questions [{:knowledge-point/id #uuid "d275a218-aa12-54bd-a4ff-4be892226f4f" :knowledge-point/title "Finding the Parametric Equations of a Segment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32e6d160-f530-53bb-9c9c-c8bce063acb6" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186314823}] :answer-field/correct {:answer/id #uuid "32e6d160-f530-53bb-9c9c-c8bce063acb6" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186314823} :answer-field/id #uuid "7a2eb105-e5a7-5017-aab2-cf0e53e6234f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314822} {:answer-field/choices [{:answer/id #uuid "b1ad08a5-1270-51d0-b30c-d8016fd45867" :answer/type {:db/ident :answer.type/math} :answer/value "1+5t" :db/id #edb/ref 17592186314825}] :answer-field/correct {:answer/id #uuid "b1ad08a5-1270-51d0-b30c-d8016fd45867" :answer/type {:db/ident :answer.type/math} :answer/value "1+5t" :db/id #edb/ref 1759