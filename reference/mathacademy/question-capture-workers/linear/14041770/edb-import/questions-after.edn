wer.type/math} :answer/value "r=[\\begin{aligned}11 \\\\ 3 \\\\ 0\\end{aligned}]+t[\\begin{aligned}0 \\\\ 7 \\\\ -5\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186314750} :answer-field/id #uuid "d79954a5-4001-55db-8545-3e183e479a22" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314746}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ae8f9c06-9117-5db0-9c16-a36ee3388ffd" :question/math-academy-id "q-127001" :question/problem "Consider the straight line given by the following parametric equations:\n\n$$\n{\\begin{aligned}x=11 \\\\ y=3+7t \\\\ z=-5t\\end{aligned}\n$$\n\nWhat would be the vector equation of the line?" :question/worked-solution "These parametric equations are equivalent to\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}11 \\\\ 3+7t \\\\ -5t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}11 \\\\ 3 \\\\ 0\\end{aligned}]+[\\begin{aligned}0 \\\\ 7t \\\\ -5t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}11 \\\\ 3 \\\\ 0\\end{aligned}]+t[\\begin{aligned}0 \\\\ 7 \\\\ -5\\end{aligned}] \\\\ r & =[\\begin{aligned}11 \\\\ 3 \\\\ 0\\end{aligned}]+t[\\begin{aligned}0 \\\\ 7 \\\\ -5\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$"}] [{:db/id #edb/ref 17592186314752 :knowledge-point/_questions [{:knowledge-point/id #uuid "b3699391-68e8-5c59-8ca2-83fded9f22de" :knowledge-point/title "Finding a Vector Parallel To a Straight Line Given Parametrically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d53d708-42af-582e-83a5-205963018587" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ 3 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186314754} {:answer/id #uuid "081d0174-76d1-5c68-bf9c-647dab3ff24d" :answer/type {:db/iden