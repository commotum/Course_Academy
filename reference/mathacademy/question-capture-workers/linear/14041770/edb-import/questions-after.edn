y} :question/id #uuid "03e48718-a507-50c0-9f68-fdaf8c11d38f" :question/math-academy-id "q-126998" :question/problem "Consider the straight line given by the following parametric equations:\n\n$$\n{\\begin{aligned}x=4t \\\\ y=-2t \\\\ z=-3\\end{aligned}\n$$\n\nWhat would be the vector equation of the line?" :question/worked-solution "These parametric equations are equivalent to\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}4t \\\\ -2t \\\\ -3\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0 \\\\ -3\\end{aligned}]+[\\begin{aligned}4t \\\\ -2t \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0 \\\\ -3\\end{aligned}]+t[\\begin{aligned}4 \\\\ -2 \\\\ 0\\end{aligned}] \\\\ r & =[\\begin{aligned}0 \\\\ 0 \\\\ -3\\end{aligned}]+t[\\begin{aligned}4 \\\\ -2 \\\\ 0\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$"}] [{:db/id #edb/ref 17592186314738 :knowledge-point/_questions [{:knowledge-point/id #uuid "f232aed9-1584-5e57-a881-226a6876384a" :knowledge-point/title "Finding the Vector Equation of a Straight Line Given Parametrically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bbfc43b-88a8-5387-84df-e95186e11e03" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}5 \\\\ -2 \\\\ 0\\end{aligned}]+t[\\begin{aligned}9 \\\\ 7 \\\\ 8\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186314740} {:answer/id #uuid "bcbb360d-de7f-5af5-bab9-f92739b6fba4" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}5 \\\\ 2 \\\\ 0\\end{aligned}]+t[\\begin{aligned}9 \\\\ 7 \\\\ 8\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186314741} {:answer/id #uuid "c69f30d0-e70a-5c4a-8861-be90c8e7c00c" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}5 \\\\ 2 \\\\ 0\\end{aligned}]+t[\\begin{aligned}9 \