#{[{:db/id #edb/ref 17592186322404 :knowledge-point/_questions [{:knowledge-point/id #uuid "1073953e-7e0a-5237-8533-8882b7772741" :knowledge-point/title "Finding the Number of Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4cf0c341-bb64-53ac-b1b5-fbd0f2861558" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186322406} {:answer/id #uuid "b5e001fa-5cce-5139-b479-b668b154bec9" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186322407} {:answer/id #uuid "f163575b-0b5f-515a-abcd-7193bfaecbf6" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186322408} {:answer/id #uuid "c8fb0641-3a3d-5afa-9248-bb58e8e3ac51" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186322409} {:answer/id #uuid "34a1fbec-7497-5269-9261-b82398df7161" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186322410}] :answer-field/correct {:answer/id #uuid "4cf0c341-bb64-53ac-b1b5-fbd0f2861558" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186322406} :answer-field/id #uuid "eeed0805-e25a-5df2-a5ba-04f91d32ca10" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186322405}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "2cb7299f-8b80-5020-a0a1-407df3d0dba1" :question/math-academy-id "q-130958" :question/problem "Determine the number of pivot columns of the matrix $D,$ given by\n\n$$\nD=[\\begin{aligned}0 & 1 & 0 & 0 & 1 & 2 \\\\ 0 & 0 & -3 & 7 & 0 & 1 \\\\ 0 & 2 & 0 & 0 & -2 & 0\\end{aligned}].\n$$" :question/worked-solution "First, we need to convert $D$ to row echelon form:\n\n$$\n\\begin{aligned}D & =[\\begin{aligned}0 & 1 & 0 & 0 & 1 & 2 \\\\ 0 & 0 & -3 & 7 & 0 & 1 \\\\ 0 & 2 & 0 & 0 & -2 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}0 & 1 & 0 & 0 & 1 & 2 \\\\ 0 & 0 & -3 & 7 & 0 & 1 \\\\ 0 & 0 & 0 & 0 & -4 & -4\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $D$ has $3$ pivots, and therefore the number of pivot columns is $3.$"}] [{:db/id #edb/ref 17592186322411 :knowledge-point/_questions [{:knowledge-point/id #uuid "b1a557d6-52f3-5df3-8088-5b875296e72e" :knowledge-point/title "Finding the Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de3e9c10-b38f-54ad-a596-d6ad322ddcc6" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st and $2$nd only" :db/id #edb/ref 17592186322413} {:answer/id #uuid "6d7f6896-75b1-5adc-bd6b-0169f4983e46" :answer/type {:db/ident :answer.type/text} :answer/value "$3$rd only" :db/id #edb/ref 17592186322414} {:answer/id #uuid "0e586b01-f37c-54cd-b7b2-c1664f1b092f" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st only" :db/id #edb/ref 17592186322415} {:answer/id #uuid "279a5dfc-a00c-5892-8e7a-eff376593c4f" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st, $2$nd, and $3$rd" :db/id #edb/ref 17592186322416} {:answer/id #uuid "00121e22-b6de-5071-b3b2-6d0d345a1dda" :answer/type {:db/ident :answer.type/text} :answer/value "$2$nd only" :db/id #edb/ref 17592186322417}] :answer-field/correct {:answer/id #uuid "de3e9c10-b38f-54ad-a596-d6ad322ddcc6" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st and $2$nd only" :db/id #edb/ref 17592186322413} :answer-field/id #uuid "e14eaf20-399c-53e1-b338-ba5f598d2e1b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186322412}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "af69649b-ba41-5eae-bb14-bde36a03c4ab" :question/math-academy-id "q-35754" :question/problem "What are the pivot columns of the matrix $A,$ given by\n\n$$\nA=[\\begin{aligned}1 & 2 & 5 \\\\ 0 & 0 & 0 \\\\ 0 & 4 & 3\\end{aligned}]?\n$$" :question/worked-solution "First, we need to convert $A$ to row echelon form:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 2 & 5 \\\\ 0 & 0 & 0 \\\\ 0 & 4 & 3\\end{aligned}] & {R}_{2} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 2 & 5 \\\\ 0 & 4 & 3 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $A$ has $2$ pivots. In particular, the pivot columns are the $1$st and $2$nd columns."}] [{:db/id #edb/ref 17592186322418 :knowledge-point/_questions [{:knowledge-point/id #uuid "b1a557d6-52f3-5df3-8088-5b875296e72e" :knowledge-point/title "Finding the Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d393fac0-eac0-5c1b-a3b0-a43744f37b23" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st and $2$nd only" :db/id #edb/ref 17592186322420} {:answer/id #uuid "5f00ed0a-e660-5565-a95f-c21755c309d8" :answer/type {:db/ident :answer.type/text} :answer/value "$3$rd only" :db/id #edb/ref 17592186322421} {:answer/id #uuid "ad6c6d06-3649-50f8-a0d5-16e78217bf3c" :answer/type {:db/ident :answer.type/text} :answer/value "$2$nd and $3$rd only" :db/id #edb/ref 17592186322422} {:answer/id #uuid "12d7424f-ba1b-5d15-8ee8-951e2d7a014b" :answer/type {:db/ident :answer.type/text} :answer/value "$3$rd and $4$th only" :db/id #edb/ref 17592186322423} {:answer/id #uuid "11d23bb6-76e7-513c-9c6c-11c276a62fbe" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st, $2$nd, and $4$th only" :db/id #edb/ref 17592186322424}] :answer-field/correct {:answer/id #uuid "11d23bb6-76e7-513c-9c6c-11c276a62fbe" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st, $2$nd, and $4$th only" :db/id #edb/ref 17592186322424} :answer-field/id #uuid "d2df0fcf-fd0b-57e2-ae26-8f30335cead7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186322419}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "7d0368b2-c48d-55b9-a038-5636deca9c98" :question/math-academy-id "q-35757" :question/problem "What are the pivot columns of the matrix $A,$ given by\n\n$$\nA=[\\begin{aligned}1 & 2 & 5 & 7 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & 2 & 4 & 6 \\\\ 0 & 0 & 0 & 0\\end{aligned}]?\n$$" :question/worked-solution "First, we need to convert $A$ to row echelon form:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 2 & 5 & 7 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & 2 & 4 & 6 \\\\ 0 & 0 & 0 & 0\\end{aligned}] & {R}_{2} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 2 & 5 & 7 \\\\ 0 & 2 & 4 & 6 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $A$ has $3$ pivots. In particular, the pivot columns are the $1$st, $2$nd, and $4$th columns."}] [{:db/id #edb/ref 17592186322425 :knowledge-point/_questions [{:knowledge-point/id #uuid "a5f0d2e9-1cf6-5fe4-85cc-f401382f39b2" :knowledge-point/title "Finding the Non-Pivot Columns of a Matrix in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "132a235f-13c0-504d-bad1-9b2909cce7f7" :answer/type {:db/ident :answer.type/text} :answer/value "$3$rd only" :db/id #edb/ref 17592186322427} {:answer/id #uuid "87fd7682-ece8-5a43-bba4-4d062c1cbbad" :answer/type {:db/ident :answer.type/text} :answer/value "$2$nd, $3$rd, and $5$th only" :db/id #edb/ref 17592186322428} {:answer/id #uuid "919a724d-ddc8-5dff-8dec-b8efa924874d" :answer/type {:db/ident :answer.type/text} :answer/value "$3$rd and $5$th only" :db/id #edb/ref 17592186322429} {:answer/id #uuid "9b697cd5-fc51-5252-afd6-c02659b8a2b3" :answer/type {:db/ident :answer.type/text} :answer/value "$5$th only" :db/id #edb/ref 17592186322430} {:answer/id #uuid "029734f4-650f-50ee-bf1c-62a8b61fdb63" :answer/type {:db/ident :answer.type/text} :answer/value "$3$rd, $4$th, and $5$th only" :db/id #edb/ref 17592186322431}] :answer-field/correct {:answer/id #uuid "919a724d-ddc8-5dff-8dec-b8efa924874d" :answer/type {:db/ident :answer.type/text} :answer/value "$3$rd and $5$th only" :db/id #edb/ref 17592186322429} :answer-field/id #uuid "fa67b964-21e7-51ef-9502-6cf701b3f74c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186322426}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e65644f1-643f-5cec-a338-633970614cd1" :question/math-academy-id "q-73620" :question/problem "The row echelon form matrix $A$ is given below. What are its **non**-pivot columns?\n\n$$\nA=[\\begin{aligned}1 & 0 & 3 & 0 & 5 \\\\ 0 & -3 & 0 & 1 & 0 \\\\ 0 & 0 & 0 & -1 & -8 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}]\n$$" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $A$ has $3$ pivots in the $1$st, $2$nd and $4$th columns:\n\n$$\nA=[\\begin{aligned}1 & 0 & 3 & 0 & 5 \\\\ 0 & -3 & 0 & 1 & 0 \\\\ 0 & 0 & 0 & -1 & -8 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}]\n$$\n\nTherefore, the only non-pivot columns are the $3$rd and $5$th columns."}] [{:db/id #edb/ref 17592186322432 :knowledge-point/_questions [{:knowledge-point/id #uuid "1073953e-7e0a-5237-8533-8882b7772741" :knowledge-point/title "Finding the Number of Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30bbef2e-2fd0-5828-b2a6-2e906ab10ac5" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186322434} {:answer/id #uuid "e5d0c73d-931d-5007-9f09-b7ee492d651a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186322435} {:answer/id #uuid "86cb7ce6-8c81-5c20-82c1-a6530f21a4bd" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186322436} {:answer/id #uuid "72a9936c-eec4-5e9c-9cdc-336f9478db9a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186322437} {:answer/id #uuid "ab144959-f7fb-526e-affe-55b12674c413" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186322438}] :answer-field/correct {:answer/id #uuid "72a9936c-eec4-5e9c-9cdc-336f9478db9a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186322437} :answer-field/id #uuid "a2a17f5c-678c-5ef4-84c5-4304085c2b85" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186322433}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "cf960eda-9693-592c-b954-8f4bbda8185d" :question/math-academy-id "q-73628" :question/problem "Determine the number of pivot columns of the matrix $B,$ given by\n\n$$\nB=[\\begin{aligned}-2 & 0 & 1 & -1 & -2 \\\\ 0 & 1 & 1 & 4 & -5 \\\\ 4 & 0 & 3 & -6 & 1 \\\\ 0 & 0 & 0 & 7 & 0\\end{aligned}].\n$$" :question/worked-solution "First, we need to convert $B$ to row echelon form:\n\n$$\n\\begin{aligned}B & =[\\begin{aligned}-2 & 0 & 1 & -1 & -2 \\\\ 0 & 1 & 1 & 4 & -5 \\\\ 4 & 0 & 3 & -6 & 1 \\\\ 0 & 0 & 0 & 7 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼[\\begin{aligned}-2 & 0 & 1 & -1 & -2 \\\\ 0 & 1 & 1 & 4 & -5 \\\\ 0 & 0 & 5 & -8 & -3 \\\\ 0 & 0 & 0 & 7 & 0\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $B$ has $4$ pivots, and therefore the number of pivot columns is $4.$"}]}
