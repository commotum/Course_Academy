50361c8787d74f7981"] :db/ensure [:answer-field/validate]} {:db/id "q-74049" :question/id #uuid "03e34d98-2bed-5c40-b736-989a8742687c" :question/math-academy-id "q-74049" :question/problem "Suppose $(a+b)\\cdot a=0$, where $a\\ne 0.$ Which of the following statements are true? \n\n- $a\\cdot a<0$\n- $b\\cdot a=a\\cdot a$\n- $b\\cdot a<0$" :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is false. Since $a\\ne 0$, we must have $a\\cdot a>0.$\n\n- Statement II is false while statement III is true. Simplifying the expression $(a+b)\\cdot a=0$, we have\n\n$$\n\\begin{aligned}(a+b)\\cdot a & =0 \\\\ a\\cdot a+b\\cdot a & =0 \\\\ b\\cdot a & =-a\\cdot a\\end{aligned}\n$$\n\n \nSince $a\\ne 0$ implies that $a\\cdot a>0$, we obtain that $-a\\cdot a<0.$\n\nTherefore, we conclude that the correct answer is \"III only\"." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-74049/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "41c2d289-8df5-551b-9501-3a762c67386f"] :knowledge-point/questions ["q-74049"] :db/ensure [:knowledge-point/validate]} {:db/id "q-139957/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "a4073eff-a13a-5181-936d-7d8711b3fd00" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-139957/selection/03b99debc8e9534f2364927a2cf1eba83bddd906503dea5d13395ce906a45ab9" :answer/id #uuid "98af5ec6-aa41-5b14-97b5-d2bd6125cd35" :answer/type :answer.type/text :answer/value "None of the statements are true" :db/ensure [:answer/validate]} {:db/id "q-139957/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "a760c7ea-d979-5c1e-a9ff-edaf88c632af" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-139957/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "184ffb72-e7cb-538c-8cbd-582aa4d40188" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-139957/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "c0398650-8ad4-59f4-8870-33385031b8f2" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-139957/selection" :answer-field/id #uuid "3b41db8b-1baa-5df8-9618-5b209121fe17" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-139957/selection/03b99debc8e9534f2364927a2cf1eba83bddd906503dea5d13395ce906a45ab9" :answer-field/choices ["q-139957/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-139957/selection/03b99debc8e9534f2364927a2cf1eba83bddd906503dea5d13395ce906a45ab9" "q-139957/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-139957/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-139957/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c"] :db/ensure [:answer-field/validate]} {:db/id "q-139957" :question/id #uuid "6c7267a9-814c-5af4-b1fd-9515f0fed3e3" :question/math-academy-id "q-139957" :question/problem "Suppose $a\\cdot (a+b)=0$, where $a\\ne 0.$ Which of the following statements are true? \n\n- $a\\cdot a<0$\n- $b\\cdot a>0$\n- $b\\cdot a=5$" :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is false. Indeed, $a\\ne 0$ implies that $a\\cdot a>0.$\n\n- Statement II and III are false. Simplifying the expression $a\\cdot (a+b)=0$, we have\n\n$$\n\\begin{aligned}a\\cdot (a+b) & =0 \\\\ a\\cdot a+a\\cdot b & =0 \\\\ a\\cdot a+b\\cdot a & =0 \\\\ b\\cdot a & =-a\\cdot a\\end{aligned}\n$$\n\n \nSince $a\\ne 0$ implies that $a\\cdot a>0$, we obtain that $b\\cdot a<0.$\n\nTherefore, we conclude that the correct answer is \"None of the statements are true\"." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-139957/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "41c2d289-8df5-551b-9501-3a762c67386f"] :knowledge-point/questions ["q-139957"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-5907"] :question/problem "If ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044469/assets/8d9347b89864ea011c9dd3fbd17b94f05c479ff7a96343aae7928b241491c3ba.png) ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044469/assets/b5521921f5997e3cb748c518a9823574fcdfb82cd4bb1d1f7bbbf17d2f9ac06a.png) and $\\mathbf{v} \\cdot \\mathbf{v} = 34,$ then what is $\\dfrac{\\mathbf{u}\\cdot 2\\mathbf{v}}{3\\mathbf{v}\\cdot \\mathbf{v}}?$" :question/worked-solution "We will use the fact that the dot product is linear.\n\nTo quickly compute the numerator $\\mathbf{u} \\cdot 2\\mathbf{v},$ we compute $\\mathbf{u} \\cdot \\mathbf{v}$ first and then multiply the result by $2.$ Doing this, we get\n\n$$\n\\begin{aligned}u\\cdot 2v & =2(u\\cdot v) \\\\  & =2({u}_{1}\\cdot {v}_{1}+{u}_{2}\\cdot {v}_{2}+{u}_{3}\\cdot {v}_{3}+{u}_{4}\\cdot {v}_{4}) \\\\  & =2(7\\cdot 1+5\\cdot 2+(-9)\\cdot (-5)+3\\cdot (-2)) \\\\  & =2(7+10+45-6) \\\\  & =2\\cdot 56 \\\\  & =112.\\end{aligned}\n$$\n\nTo quickly compute the denominator $3\\mathbf{v} \\cdot \\mathbf{v},$ we multiply $\\mathbf{v} \\cdot \\mathbf{v}$ by $3.$ Doing this, we get\n\n$$\n\\begin{aligned}3v\\cdot v & =3(v\\cdot v) \\\\  & =3\\cdot 34 \\\\  & =102.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\dfrac{\\mathbf{u}\\cdot 2\\mathbf{v}}{3\\mathbf{v}\\cdot\\mathbf{v}} =\\dfrac{112}{102}=\\dfrac{56}{51}.\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5536"] :question/problem "Find $(5\\mathbf{a}+3\\mathbf{b}) \\cdot \\mathbf{c}+(4\\mathbf{b}+2\\mathbf{c}) \\cdot \\mathbf{d},$ if $\\mathbf{c} \\cdot \\mathbf{a} = 2,$ $\\mathbf{b} \\cdot \\mathbf{c} = -1,$ $\\mathbf{b} \\cdot \\mathbf{d} = 2,$ and $\\mathbf{d} \\cdot \\mathbf{c}=3.$" :question/worked-solution "Using the fact that the dot product is linear in the first variable, we have \n\n$$\n\\begin{aligned}(5a+3b)\\cdot c+(4b+2c)\\cdot d & =(5a)\\cdot c+(3b)\\cdot c+(4b)\\cdot d+(2c)\\cdot d \\\\  & =5(a\\cdot c)+3(b\\cdot c)+4(b\\cdot d)+2(c\\cdot d).\\end{aligned}\n$$\n\nNext, we can substitute the values for $\\mathbf{b} \\cdot \\mathbf{c}$ and $\\mathbf{b} \\cdot \\mathbf{d},$ and use the fact that the dot product is symmetric to get \n\n$$\n\\begin{aligned}5(a\\cdot c)+3(b\\cdot c)+4(b\\cdot d)+2(c\\cdot d) & =5(c\\cdot a)+3(-1)+4(2)+2(d\\cdot c) \\\\  & =5(c\\cdot a)-3+8+2(d\\cdot c) \\\\  & =5(c\\cdot a)+5+2(d\\cdot c).\\end{aligned}\n$$\n\nFinally, substituting the values for $\\mathbf{c} \\cdot \\mathbf{a}$ and $\\mathbf{d} \\cdot \\mathbf{c},$ we find\n\n$$\n\\begin{aligned}5(c\\cdot a)+5+2(d\\cdot c) & =5(2)+5+2(3) \\\\  & =10+5+6 \\\\  & =21.\\end{aligned}\n$$\n\nTherefore, $(5\\mathbf{a}+3\\mathbf{b}) \\cdot \\mathbf{c}+(4\\mathbf{b}+2\\mathbf{c}) \\cdot \\mathbf{d} = 21.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5537"] :question/problem "Suppose $(4\\mathbf{a} + 2\\mathbf{b}) \\cdot \\mathbf{a} = {0},$ where $\\mathbf{a} \\neq \\mathbf{0}.$ Which of the following statements are true? \n\n- $\\mathbf{b} \\cdot \\mathbf{a} = -2(\\mathbf{a} \\cdot \\mathbf{a})$\n\n- $\\mathbf{a} \\cdot \\mathbf{a} =  0$\n\n- $\\mathbf{b} \\cdot \\mathbf{a} = 1$" :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is true. Simplifying, we have\n\n$$\n\\begin{aligned}(4a+2b)\\cdot a & =0 \\\\ (4a)\\cdot a+(2b)\\cdot a & =0 \\\\ 4(a\\cdot a)+2(b\\cdot a) & =0 \\\\ 2(b\\cdot a) & =-4(a\\cdot a) \\\\ b\\cdot a & =-2(a\\cdot a).\\end{aligned}\n$$\n\n- Statement II is false. Since $\\mathbf{a} \\neq \\mathbf{0},$ we must have $\\mathbf{a} \\cdot \\mathbf{a} > 0.$\n\n- Statement III is false since it leads to a contradiction. Simplifying $(4\\mathbf{a} + 2\\mathbf{b}) \\cdot \\mathbf{a} = {0}$ and substituting in $\\mathbf{b} \\cdot \\mathbf{a} = 1,$ we get\n\n$$\n\\begin{aligned}(4a+2b)\\cdot a & =0 \\\\ 4a\\cdot a+2b\\cdot a & =0 \\\\ 4a\\cdot a+2(1) & =0 \\\\ a\\cdot a & =-\\frac{1}{2},\\end{aligned}\n$$\n\nbut this is a contradiction since $\\mathbf{a} \\neq \\mathbf{0}$ implies that $\\mathbf{a} \\cdot \\mathbf{a} > 0.$\n\nTherefore, we conclude that the correct answer is \"I only\"." :db/ensure [:question/validate]}]
