nd{aligned}]\\end{aligned}\n$$" 13194139535516 true] [17592186353209 1000 #edb/ref 17592186353210 13194139535516 true] [17592186353209 1000 #edb/ref 17592186353211 13194139535516 true] [17592186353209 1000 #edb/ref 17592186353212 13194139535516 true] [17592186353209 1000 #edb/ref 17592186353213 13194139535516 true] [17592186353209 1000 #edb/ref 17592186353214 13194139535516 true] [17592186353209 1040 #edb/ref 17592186045450 13194139535516 true] [17592186353209 1041 "selection" 13194139535516 true] [17592186353209 1104 #edb/ref 17592186353210 13194139535516 true] [17592186353209 1110 #uuid "184ce97b-ec25-52e6-a5f4-d63b5ebd5d94" 13194139535516 true] [17592186353210 1034 "[\\begin{aligned}-4 \\\\ 4 \\\\ 4\\end{aligned}]" 13194139535516 true] [17592186353210 1103 #edb/ref 17592186045453 13194139535516 true] [17592186353210 1111 #uuid "60fd872f-404f-5562-99ef-a64931cd8557" 13194139535516 true] [17592186353211 1034 "[\\begin{aligned}-2 \\\\ 1 \\\\ 4\\end{aligned}]" 13194139535516 true] [17592186353211 1103 #edb/ref 17592186045453 13194139535516 true] [17592186353211 1111 #uuid "cb87f663-5ccd-54db-80bf-2809b22507ab" 13194139535516 true] [17592186353212 1034 "[\\begin{aligned}-2 \\\\ 2 \\\\ 2\\end{aligned}]" 13194139535516 true] [17592186353212 1103 #edb/ref 17592186045453 13194139535516 true] [17592186353212 1111 #uuid "c8e03b9b-61aa-57c8-9e2f-578844db2c87" 13194139535516 true] [17592186353213 1034 "[\\begin{aligned}1 \\\\ -2 \\\\ 4\\end{aligned}]" 13194139535516 true] [17592186353213 1103 #edb/ref 17592186045453 13194139535516 true] [17592186353213 1111 #uuid "3eed2c63-6931-54c5-92fb-c4f19935d8b3" 13194139535516 true] [17592186353214 1034 "[\\begin{aligned}-\\frac{1}{2} \\\\ 1 \\\\ \\frac{1}{2}\\end{aligned}]" 13194139535516 true] [17592186353214 1103 #edb/ref 17592186045453 13194139535516 true] [17592186353214 1111 #uuid "11a6c226-cdcc-542a-99b4-23a96264a863" 13194139535516 true] [17592186353215 1017 #edb/ref 17592186353216 13194139535516 true] [17592186353215 1089 "q-81199" 13194139535516 true] [17592186353215 1091 #edb/ref 17592186045465 13194139535516 true] [17592186353215 1100 "Given the vector $x$ and the system of linear equations below, find the projection of $x$ onto the solution space of the system.\n\n$$\nx=[\\begin{aligned}4 \\\\ 3\\end{aligned}],\\,{\\begin{aligned}2{x}_{1}-{x}_{2}=0 \\\\ -{x}_{1}+\\frac{1}{2}{x}_{2}=0\\end{aligned}\n$$" 13194139535516 true] [17592186353215 1113 #uuid "bcc8ff8e-bf46-5901-8fed-da7d7df3ad36" 13194139535516 true] [17592186353215 1145 "First, we need to find a basis of the solution space of the system. \n\nConsider the augmented matrix $M$ of the system, which we reduce to row echelon form, as follows:  \n\n$$\n\\begin{aligned}M & =[\\begin{aligned}2 & -1 & 0 \\\\ -1 & \\frac{1}{2} & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}2 & -1 & 0 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nIn the reduced matrix above, there is $1$ pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we get ${x}_{1}=\\frac{1}{2}{x}_{2}.$ So, the general solution is\n\n$$\n[\\begin{aligned}\\frac{1}{2}{x}_{2} \\\\ {x}_{2}\\end{aligned}]={x}_{2}[\\begin{aligned}\\frac{1}{2} \\\\ 1\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nConsequently, $B={[\\begin{aligned}\\frac{1}{2} \\\\ 1\\end{aligned}]}$ is a basis of the solution space of the system.\n\nFinally, we find the projection of $x$ onto the solution space of the system:\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,x & =\\frac{x\\cdot b}{b\\cdot b}b \\\\  & =\\frac{4\\cdot \\frac{1}{2}+3\\cdot 1}{{(\\frac{1}{2})}^{2}+{1}^{2}}b \\\\  & =\\frac{5}{\\frac{1}{4}+1}b \\\\  & =4b \\\\  & =4[\\begin{aligned}\\frac{1}{2} \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ 4\\end{aligned}]\\end{aligned}\n$$" 13194139535516 true] [17592186353216 1000 #edb/ref 17592186353217 13194139535516 true] [17592186353216 1000 #edb/ref 17592186353218 13194139535516 true] [17592186353216 1000 #edb/ref 175921