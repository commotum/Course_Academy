857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-40409/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-40409/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-40409/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-40409/selection/05402db46107d70ece210f0bd5e24b332ae4f43bd474d592035c3e3c92625629" "q-40409/selection/0c8b08d4b198d89c5fe756f861bd5b37e398d2a5b3237908210d9646370a666f"] :db/ensure [:answer-field/validate]} {:db/id "q-40409" :question/id #uuid "3862e17b-0289-5fb6-b72e-c3913eaf442a" :question/math-academy-id "q-40409" :question/problem "Let $x=[\\begin{aligned}2 \\\\ -4 \\\\ -2 \\\\ 3\\end{aligned}]$ and $b=[\\begin{aligned}3 \\\\ 0 \\\\ -3 \\\\ 0\\end{aligned}].$ Find the distance between $x$ and $\\text{Span}{b}.$" :question/worked-solution "The distance between the vector $x$ and the vector space $\\text{Span}{b}$ is given by $‖x-\\overset{^}{x}‖$, where $\\overset{^}{x}$ in the orthogonal projection of $x$ onto $\\text{span}{b}.$\n\nFirst, we find the orthogonal projection of $x$ onto $\\text{Span}{b}.$ \n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,x & =\\frac{b\\cdot x}{b\\cdot b}b \\\\  & =\\frac{3\\cdot 2+0\\cdot (-4)+(-3)\\cdot (-2)+0\\cdot 3}{{3}^{2}+{0}^{2}+(-3)^{2}+{0}^{2}}\\text{ }\\,b \\\\  & =\\frac{6+0+6+0}{9+0+9+0}\\text{ }\\,b \\\\  & =\\frac{2}{3}\\text{ }\\,b \\\\  & =\\frac{2}{3}[\\begin{aligned}3 \\\\ 0 \\\\ -3 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ 0 \\\\ -2 \\\\ 0\\end{aligned}]=\\overset{^}{x}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}‖x-\\overset{^}{x}‖ & =\\sqrt{({x}_{1}-{\\overset{^}{x}}_{1})^{2}+({x}_{2}-{\\overset{^}{x}}_{2})^{2}+({x}_{3}-{\\overset{^}{x}}_{3})^{2}+({x}_{4}-{\\overset{^}{x}}_{4})^{2}} \\\\  & =\\sqrt{(2-2)^{2}+((-4)-0)^{2}+((-2)-(-2))^{2}+(3-0)^{2}} \\\\  & =\\sqrt{0+16+0+9} \\\\  & =\\sqrt{25} \\\\  & =5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-40409/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "144d1258-f8d5-55e9-be38-ec25b6f84bd3"] :knowledge-point/questions ["q-40409"] :db/ensure [:knowledge-point/validate]} {:db/id "q-39729/selection/4049d80a859c22fc11599c7722a99cc1148c2eec89f459fc0e3511a5c3fac1ca" :answer/id #uuid "7ad20cec-f18a-5b07-a179-8b6979ac4d84" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{9}{2} \\\\ -\\frac{3}{2} \\\\ \\frac{3}{2} \\\\ \\frac{9}{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-39729/selection/b5b666c7238d70db84a15377856d94058967ec6caf047603302751d093328dd0" :answer/id #uuid "dc552ee6-6e68-504f-991a-55699c81f4b8" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ -2 \\\\ 2 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-39729/selection/4310a20f01c588cc6e98a3c35585659ec661e67c0df983365aa90db8e8f2187c" :answer/id #uuid "571d9150-15f4-5dca-9d0d-0c1b1b82063e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ -9 \\\\ 9 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-39729/selection/c86346cf84f5f64a993423a163d5379f0f28b5282029fe0589a9de4ecb244961" :answer/id #uuid "c338bda0-8400-5332-a7d1-1e2b1d701cde" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{2}{9} \\\\ -\\frac{2}{3} \\\\ \\frac{2}{3} \\\\ \\frac{2}{9}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-39729/selection/eae135be24f40b0bfb4d01c1d7fa838583f7b7d06a012abec0efb2b7f4a66a50" :answer/id #uuid "62edd632-6d64-5ece-944c-93df2076b37c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}9 \\\\ -3 \\\\ 3 \\\\ 9\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-39729/selection" :answer-field/id #uuid "fe94e0e4-f6d2-5fba-b941-3226323aa6b9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-39729/selection/4049d80a859c22fc11599c7722a99cc1148c2eec89f459fc0e3