 -\\frac{3}{2} \\\\ \\frac{3}{2} \\\\ \\frac{9}{2}\\end{aligned}]\\end{aligned}\n$$\n\n \n\nNotice that $y\\in \\text{Span}{a}$ and $z⊥\\text{Span}{a},$ as shown in the picture above.\n\nIn conclusion, $z=[\\begin{aligned}\\frac{9}{2} \\\\ -\\frac{3}{2} \\\\ \\frac{3}{2} \\\\ \\frac{9}{2}\\end{aligned}].$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-39729/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "144d1258-f8d5-55e9-be38-ec25b6f84bd3"] :knowledge-point/questions ["q-39729"] :db/ensure [:knowledge-point/validate]} {:db/id "q-140117/selection/de10d9c21f2abd99bbc7ec87649eb80885fbb611fd99a530f20ab6b963895aeb" :answer/id #uuid "860e3b86-1117-53fc-b6bf-f4784c0a9903" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-9 \\\\ 1 \\\\ -2 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-140117/selection/5e56c231163065200378f879837f84bd4f17a016abb79c1aea27e5def4688984" :answer/id #uuid "b210a479-f250-5920-9d04-48eb1b721688" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 1 \\\\ 2 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-140117/selection/69110279b97442a4f79d77aa23e4ceb6d2729b686fed66030ab82dbc259a7b71" :answer/id #uuid "37a23596-8ad5-5769-a981-db209e2eda1d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3 \\\\ 1 \\\\ -2 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-140117/selection/1091a26a6bb7c58e5ddcc949bf49b622e5d748db3973c68cb89d6460831de0a7" :answer/id #uuid "60ba02e7-9700-57e0-b0e8-a1f409d7d096" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-6 \\\\ 2 \\\\ -2 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-140117/selection/b5af170cb1a071e9e1186efb567bab86ed0f83ee17fe770cfa72a6acd38547b4" :answer/id #uuid "66d840c3-9a32-538e-8441-912f2cecfc8a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 \\\\ 1 \\\\ 4 \\\\ 3\\end{aligned}]" :db/ensure [:answe