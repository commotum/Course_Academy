 3\\end{aligned}]=[\\begin{aligned}9 \\\\ -3 \\\\ 3 \\\\ 9\\end{aligned}]\\end{aligned}\n$$\n\nNotice that $y\\in \\text{Span}{a}$ and $z⊥\\text{Span}{a},$ as shown in the picture above.\n\nIn conclusion, $z=[\\begin{aligned}9 \\\\ -3 \\\\ 3 \\\\ 9\\end{aligned}].$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-39712" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/activity-metadata.json" "file_sha256" "a95be3446c0d70fbf5cfa28e597ddbf736d073a3a03cb0ceca806c5e99c31fcb"} {"question" "q-39712" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-39712" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}0 \\\\ 0 \\\\ 0 \\\\ 0\\end{aligned}]"] ["math" "[\\begin{aligned}12 \\\\ 6 \\\\ -6 \\\\ 12\\end{aligned}]"] ["math" "[\\begin{aligned}3 \\\\ 9 \\\\ -9 \\\\ 3\\end{aligned}]"] ["math" "[\\begin{aligned}6 \\\\ -9 \\\\ 3 \\\\ -3\\end{aligned}]"] ["math" "[\\begin{aligned}9 \\\\ -3 \\\\ 3 \\\\ 9\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-39712" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}9 \\\\ -3 \\\\ 3 \\\\ 9\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-86733" "field" nil "attribute" "question/problem" "value" "Let $x=[\\begin{aligned}3 \\\\ 1 \\\\ 2 \\\\ 4\\end{aligned}]$ and $a=[\\begin{aligned}1 \\\\ 2 \\\\ -1 \\\\ 3\\end{aligned}].$ If $x=y+z,$ where $y\\in \\text{Span}{a}$ and $z⊥\\text{Span}{a},$ then $z=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-86733" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/assets/d887852fe51f08cb7296437e69b6a9632721cfd155558e6abf9a99b4f59f7ad6.png)\n\nFirst, we find the orthogonal projection of $x$ onto $\\text{Span}{a}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{a}\\,x & =\\frac{a\\cdot x}{a\\cdot a}a \\\\  & =\\frac{1\\cdot 3+2\\cdot 1+(-1)\\cdot 2+3\\cdot 4}{{1}^{2}+{2}^{2}+(-1)^{2}+{3}^{2}}a \\\\  & =\\frac{3+2+(-2)+12}{1+4+1+9}a \\\\  & =\\frac{15}{15}a \\\\  & =a \\\\  & =[\\begin{aligned}1 \\\\ 2 \\\\ -1 \\\\ 3\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we get the following: \n\n$$\n\\begin{aligned}y & ={\\text{proj}}_{a}\\,x=[\\begin{aligned}1 \\\\ 2 \\\\ -1 \\\\ 3\\end{aligned}] \\\\ z & =x-{\\text{proj}}_{a}\\,x=[\\begin{aligned}3 \\\\ 1 \\\\ 2 \\\\ 4\\end{aligned}]-[\\begin{aligned}1 \\\\ 2 \\\\ -1 \\\\ 3\\end{aligned}]=[\\begin{aligned}2 \\\\ -1 \\\\ 3 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nNotice that $y\\in \\text{Span}{a}$ and $z⊥\\text{Span}{a},$ as shown in the picture above.\n\nIn conclusion, $z=[\\begin{aligned}2 \\\\ -1 \\\\ 3 \\\\ 1\\end{aligned}].$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-86733" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/activity-metadata.json" "file_sha256" "a95be3446c0d70fbf5cfa28e597ddbf736d073a3a03cb0ceca806c5e99c31fcb"} {"question" "q-86733" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-86733" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}0 \\\\ -1 \\\\ 1 \\\\ 1\\end{aligned}]"] ["math" "[\\begin{aligned}0 \\\\ 0 \\\\ 6 \\\\ 2\\end{aligned}]"] ["math" "[\\begin{aligned}1 \\\\ 1 \\\\ 0 \\\\ -1\\end{aligned}]"] ["math" "[\\begin{aligned}2 \\\\ -1 \\\\ 3 \\\\ 1\\end{aligned}]"] ["math" "[\\begin{aligned}3 \\\\ 1 \\\\ 2 \\\\ -1\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-86733" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}2 \\\\ -1 \\\\ 3 \\\\ 1\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-81196" "field" nil "attribute" "question/problem" "value" "Given the vector $x$ and the system of linear equations below, find the projection of $x$ onto the solution space of the system.\n\n$$\nx=[\\begin{aligned}-2 \\\\ 3 \\\\ 7\\end{aligned}],\\,{\\begin{aligned}{x}_{1}+{x}_{2}=0 \\\\ 2{x}_{1}+{x}_{2}+{x}_{3}=0\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-81196" "field" nil "attribute" "question/worked-solution" "value" "First, we need to find a basis of the solution space of the system. \n\nConsider the augmented matrix $M$ of the system, which we reduce to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 1 & 0 & 0 \\\\ 2 & 1 & 1 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 0 & 0 \\\\ 0 & -1 & 1 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, there are $2$ pivot columns ($1$st and $2$nd). Thus, ${x}_{3}$ is a free variable. Now, from the second equation, we get ${x}_{2}={x}_{3}.$ Substituting this into the first equation, we obtain \n\n$$\n{x}_{1}+{x}_{3}=0\\,⟹\\,{x}_{1}=-{x}_{3}.\n$$\n\nSo, the general solution is\n\n$$\n[\\begin{aligned}-{x}_{3} \\\\ {x}_{3} \\\\ {x}_{3}\\end{aligned}]={x}_{3}[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}],\\,{x}_{3}\\in R.\n$$\n\nConsequently, $B={[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}]}$ is a basis of the solution space of the system.\n\nFinally, we find the projection of $x$ onto the solution space of the system:\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,x & =\\frac{x\\cdot b}{b\\cdot b}b \\\\  & =\\frac{(-2)\\cdot (-1)+3\\cdot 1+7\\cdot 1}{(-1)^{2}+{1}^{2}+{1}^{2}}b \\\\  & =\\frac{12}{3}b \\\\  & =4b \\\\  & =4[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}-4 \\\\ 4 \\\\ 4\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-81196" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/activity-metadata.json" "file_sha256" "a95be3446c0d70fbf5cfa28e597ddbf736d073a3a03cb0ceca806c5e99c31fcb"} {"question" "q-81196" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-81196" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-2 \\\\ 1 \\\\ 4\\end{aligned}]"] ["math" "[\\begin{aligned}-2 \\\\ 2 \\\\ 2\\end{aligned}]"] ["math" "[\\begin{aligned}-4 \\\\ 4 \\\\ 4\\end{aligned}]"] ["math" "[\\begin{aligned}-\\frac{1}{2} \\\\ 1 \\\\ \\frac{1}{2}\\end{aligned}]"] ["math" "[\\begin{aligned}1 \\\\ -2 \\\\ 4\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-81196" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}-4 \\\\ 4 \\\\ 4\\end{aligned}]"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-81199" "field" nil "attribute" "question/problem" "value" "Given the vector $x$ and the system of linear equations below, find the projection of $x$ onto the solution space of the system.\n\n$$\nx=[\\begin{aligned}4 \\\\ 3\\end{aligned}],\\,{\\begin{aligned}2{x}_{1}-{x}_{2}=0 \\\\ -{x}_{1}+\\frac{1}{2}{x}_{2}=0\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-81199" "field" nil "attribute" "question/worked-solution" "value" "First, we need to find a basis of the solution space of the system. \n\nConsider the augmented matrix $M$ of the system, which we reduce to row echelon form, as follows:  \n\n$$\n\\begin{aligned}M & =[\\begin{aligned}2 & -1 & 0 \\\\ -1 & \\frac{1}{2} & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}2 & -1 & 0 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nIn the reduced matrix above, there is $1$ pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we get ${x}_{1}=\\frac{1}{2}{x}_{2}.$ So, the general solution is\n\n$$\n[\\begin{aligned}\\frac{1}{2}{x}_{2} \\\\ {x}_{2}\\end{aligned}]={x}_{2}[\\begin{aligned}\\frac{1}{2} \\\\ 1\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nConsequently, $B={[\\begin{aligned}\\frac{1}{2} \\\\ 1\\end{aligned}]}$ is a basis of the solution space of the system.\n\nFinally, we find the projection of $x$ onto the solution space of the system:\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,x & =\\frac{x\\cdot b}{b\\cdot b}b \\\\  & =\\frac{4\\cdot \\frac{1}{2}+3\\cdot 1}{{(\\frac{1}{2})}^{2}+{1}^{2}}b \\\\  & =\\frac{5}{\\frac{1}{4}+1}b \\\\  & =4b \\\\  & =4[\\begin{aligned}\\frac{1}{2} \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ 4\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-81199" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/activity-metadata.json" "file_sha256" "a95be3446c0d70fbf5cfa28e597ddbf736d073a3a03cb0ceca806c5e99c31fcb"} {"question" "q-81199" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-81199" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-2 \\\\ 1\\end{aligned}]"] ["math" "[\\begin{aligned}-4 \\\\ 4\\end{aligned}]"] ["math" "[\\begin{aligned}2 \\\\ 4\\end{aligned}]"] ["math" "[\\begin{aligned}4 \\\\ 2\\end{aligned}]"] ["math" "[\\begin{aligned}\\frac{1}{2} \\\\ 4\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-81199" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}2 \\\\ 4\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-81200" "field" nil "attribute" "question/problem" "value" "Given the vector $x$ and the system of linear equations below, find the projection of $x$ onto the solution space of the system.\n\n$$\nx=[\\begin{aligned}12 \\\\ 5 \\\\ 0\\end{aligned}],\\,{\\begin{aligned}{x}_{1}-3{x}_{2}=0 \\\\ 3{x}_{1}-5{x}_{2}-8{x}_{3}=0\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-81200" "field" nil "attribute" "question/worked-solution" "value" "First, we need to find a basis of the solution space of the system. \n\nConsider the augmented matrix $M$ of the system, which we reduce to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -3 & 0 & 0 \\\\ 3 & -5 & -8 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 0 & 0 \\\\ 0 & 4 & -8 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, there are $2$ pivot columns ($1$st and $2$nd). Thus, ${x}_{3}$ is a free variable. Now, from the second equation, we get ${x}_{2}=2{x}_{3}.$ Substituting this into the first equation, we obtain \n\n$$\n{x}_{1}-3\\cdot (2{x}_{3})=0\\,⟹\\,{x}_{1}=6{x}_{3}.\n$$\n\nSo, the general solution is\n\n$$\n[\\begin{aligned}6{x}_{3} \\\\ 2{x}_{3} \\\\ {x}_{3}\\end{aligned}]={x}_{3}[\\begin{aligned}6 \\\\ 2 \\\\ 1\\end{aligned}],\\,{x}_{3}\\in R.\n$$\n\nConsequently, $B={[\\begin{aligned}6 \\\\ 2 \\\\ 1\\end{aligned}]}$ is a basis of the solution space of the system.\n\nFinally, we find the projection of $x$ onto the solution space of the system:\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,x & =\\frac{x\\cdot b}{b\\cdot b}b \\\\  & =\\frac{12\\cdot 6+5\\cdot 2+0\\cdot 1}{{6}^{2}+{2}^{2}+{1}^{2}}b \\\\  & =\\frac{82}{41}b \\\\  & =2b \\\\  & =2[\\begin{aligned}6 \\\\ 2 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}12 \\\\ 4 \\\\ 2\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-81200" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/activity-metadata.json" "file_sha256" "a95be3446c0d70fbf5cfa28e597ddbf736d073a3a03cb0ceca806c5e99c31fcb"} {"question" "q-81200" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-81200" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-12 \\\\ 0 \\\\ 5\\end{aligned}]"] ["math" "[\\begin{aligned}12 \\\\ 0 \\\\ 5\\end{aligned}]"] ["math" "[\\begin{aligned}12 \\\\ 4 \\\\ 2\\end{aligned}]"] ["math" "[\\begin{aligned}12 \\\\ 5 \\\\ 0\\end{aligned}]"] ["math" "[\\begin{aligned}6 \\\\ 4 \\\\ 0\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-81200" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}12 \\\\ 4 \\\\ 2\\end{aligned}]"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-40425" "field" nil "attribute" "question/problem" "value" "Given the vector $x$ and the system of linear equations below, find the projection of $x$ onto the solution space of the system.\n\n$$\nx=[\\begin{aligned}11 \\\\ 3\\end{aligned}],\\,{\\begin{aligned}{x}_{1}+{x}_{2}=0 \\\\ 2{x}_{1}+2{x}_{2}=0\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-40425" "field" nil "attribute" "question/worked-solution" "value" "First, we need to find a basis of the solution space of the system. \n\nConsider the augmented matrix $M$ of the system, which we reduce to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 1 & 0 \\\\ 2 & 2 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 0 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nIn the reduced matrix above, there is $1$ pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we get ${x}_{1}=-{x}_{2}.$ So, the general solution is\n\n$$\n[\\begin{aligned}-{x}_{2} \\\\ {x}_{2}\\end{aligned}]={x}_{2}[\\begin{aligned}-1 \\\\ 1\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nConsequently, $B={[\\begin{aligned}-1 \\\\ 1\\end{aligned}]}$ is a basis of the solution space of the system.\n\nFinally, we find the projection of $x$ onto the solution space of the system:\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,x & =\\frac{x\\cdot b}{b\\cdot b}b \\\\  & =\\frac{11\\cdot (-1)+3\\cdot 1}{{(-1)}^{2}+{1}^{2}}b \\\\  & =\\frac{-8}{2}b \\\\  & =-4b \\\\  & =-4[\\begin{aligned}-1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ -4\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-40425" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/activity-metadata.json" "file_sha256" "a95be3446c0d70fbf5cfa28e597ddbf736d073a3a03cb0ceca806c5e99c31fcb"} {"question" "q-40425" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-40425" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-4 \\\\ -4\\end{aligned}]"] ["math" "[\\begin{aligned}-5 \\\\ -5\\end{aligned}]"] ["math" "[\\begin{aligned}4 \\\\ -4\\end{aligned}]"] ["math" "[\\begin{aligned}4 \\\\ 5\\end{aligned}]"] ["math" "[\\begin{aligned}5 \\\\ -5\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-40425" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}4 \\\\ -4\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-140119" "field" nil "attribute" "question/problem" "value" "Given the vector $x$ and the system of linear equations below, find the projection of $x$ onto the solution space of the system.\n\n$$\nx=[\\begin{aligned}3 \\\\ -5 \\\\ 4\\end{aligned}],\\,{\\begin{aligned}{x}_{1}-{x}_{3}=0 \\\\ 2{x}_{1}+{x}_{2}+{x}_{3}=0\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-140119" "field" nil "attribute" "question/worked-solution" "value" "First, we need to find a basis for the solution space of the system. \n\nConsider the augmented matrix $M$ of the system, which we reduce to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 0 & -1 & 0 \\\\ 2 & 1 & 1 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & -1 & 0 \\\\ 0 & 1 & 3 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, there are $2$ pivot columns ($1$st and $2$nd). Thus, ${x}_{3}$ is a free variable. Now, from the first equation, we get ${x}_{1}={x}_{3}$ and from the second equation ${x}_{2}=-3{x}_{3}.$  \n\nSo, the general solution is\n\n$$\n[\\begin{aligned}{x}_{3} \\\\ -3{x}_{3} \\\\ {x}_{3}\\end{aligned}]={x}_{3}[\\begin{aligned}1 \\\\ -3 \\\\ 1\\end{aligned}],\\,{x}_{3}\\in R.\n$$\n\nConsequently, $B={[\\begin{aligned}1 \\\\ -3 \\\\ 1\\end{aligned}]}$ is a basis of the solution space of the system.\n\nFinally, we find the projection of $x$ onto the solution space of the system:\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,x & =\\frac{x\\cdot b}{b\\cdot b}b \\\\  & =\\frac{3\\cdot 1+(-5)\\cdot (-3)+4\\cdot 1}{{1}^{2}+(-3)^{2}+{1}^{2}}b \\\\  & =\\frac{22}{11}b \\\\  & =2b \\\\  & =2[\\begin{aligned}1 \\\\ -3 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ -6 \\\\ 2\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-140119" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/activity-metadata.json" "file_sha256" "a95be3446c0d70fbf5cfa28e597ddbf736d073a3a03cb0ceca806c5e99c31fcb"} {"question" "q-140119" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-140119" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}1 \\\\ -6 \\\\ 2\\end{aligned}]"] ["math" "[\\begin{aligned}2 \\\\ -3 \\\\ 2\\end{aligned}]"] ["math" "[\\begin{aligned}2 \\\\ -6 \\\\ 1\\end{aligned}]"] ["math" "[\\begin{aligned}2 \\\\ -6 \\\\ 2\\end{aligned}]"] ["math" "[\\begin{aligned}2 \\\\ 2 \\\\ 4\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-140119" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}2 \\\\ -6 \\\\ 2\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "e-5570" "field" nil "attribute" "question/problem" "value" "Let ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/assets/8a460dfb89b0d2e9c1e197aa212f494971df1c36822117fb4b1271f5608d1d1a.png) and ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/assets/a172f54b0dc879c2363cfd2818fc79614d68662def6dd56b0ac9aec8fdbca1a5.png) Find the orthogonal projection of $\\mathbf{a}$ onto $\\text{Span}\\{\\mathbf{b}\\}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/example-5570.json" "file_sha256" "b6a6d2205c5e97c0d760e37f7b241c92bf4d4e8b619b7e9309fbaad5d758f3d4"} {"question" "e-5570" "field" nil "attribute" "question/worked-solution" "value" "The orthogonal projection of $\\mathbf{a}$ onto $\\textrm{Span}\\{\\mathbf{b}\\}$ is given by\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{b\\cdot a}{b\\cdot b}b \\\\  & =\\frac{2\\cdot 2+1\\cdot 9+0\\cdot (-1)+1\\cdot (-1)}{{2}^{2}+{1}^{2}+{0}^{2}+{1}^{2}}b \\\\  & =\\frac{4+9+0-1}{4+1+0+1}b \\\\  & =\\frac{12}{6}b \\\\  & =2b \\\\  & =2[\\begin{aligned}2 \\\\ 1 \\\\ 0 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ 2 \\\\ 0 \\\\ 2\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/example-5570.json" "file_sha256" "b6a6d2205c5e97c0d760e37f7b241c92bf4d4e8b619b7e9309fbaad5d758f3d4"} {"question" "e-5571" "field" nil "attribute" "question/problem" "value" "Let ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/assets/fb060fbc7ac20ff3b739a7c8958b4977e72abd31679c098973395db99fb6f78e.png) and ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/assets/7a20f39cb1c7c36a01e9d7d4dcd8cbe619c8cffacb57bc2bf42b8d46ce53bb5b.png) If $\\mathbf{x} = \\mathbf{y} + \\mathbf{z},$ where $\\mathbf{y} \\in \\text{Span}\\{\\mathbf{a}\\}$ and $\\mathbf{z} \\perp \\text{Span}\\{\\mathbf{a}\\},$ then find $\\mathbf{z}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/example-5571.json" "file_sha256" "dc62552b8296c4f39d1ff793d882c31651d56f495dd07a8929a5eb3e0278e1a0"} {"question" "e-5571" "field" nil "attribute" "question/worked-solution" "value" "A diagram of the situation is provided below:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/assets/d887852fe51f08cb7296437e69b6a9632721cfd155558e6abf9a99b4f59f7ad6.png)\n\nFirst, we find the orthogonal projection of $\\mathbf{x}$ onto $\\textrm{Span}\\{\\mathbf{a}\\}\\mathbin{:}$ \n\n$$\n\\begin{aligned}{\\text{proj}}_{a}\\,x & =\\frac{a\\cdot x}{a\\cdot a}a \\\\  & =\\frac{1\\cdot 4+(-1)\\cdot (-4)+0\\cdot 2+(-1)\\cdot 2}{{1}^{2}+(-1)^{2}+{0}^{2}+(-1)^{2}}a \\\\  & =\\frac{4+4+0-2}{1+1+0+1}a \\\\  & =\\frac{6}{3}a \\\\  & =2a \\\\  & =2[\\begin{aligned}1 \\\\ -1 \\\\ 0 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ -2 \\\\ 0 \\\\ -2\\end{aligned}]\\end{aligned}\n$$\n\n \n\nTherefore, we get the following:  \n\n$$\n\\begin{aligned}y & ={\\text{proj}}_{a}\\,x=[\\begin{aligned}2 \\\\ -2 \\\\ 0 \\\\ -2\\end{aligned}] \\\\ z & =x-{\\text{proj}}_{a}\\,x=[\\begin{aligned}4 \\\\ -4 \\\\ 2 \\\\ 2\\end{aligned}]-[\\begin{aligned}2 \\\\ -2 \\\\ 0 \\\\ -2\\end{aligned}]=[\\begin{aligned}2 \\\\ -2 \\\\ 2 \\\\ 4\\end{aligned}]\\end{aligned}\n$$\n\nNotice that $\\mathbf{y} \\in \\text{Span}\\{\\mathbf{a}\\}$ and $\\mathbf{z} \\perp \\text{Span}\\{\\mathbf{a}\\},$ as shown in the picture above." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/example-5571.json" "file_sha256" "dc62552b8296c4f39d1ff793d882c31651d56f495dd07a8929a5eb3e0278e1a0"} {"question" "e-5572" "field" nil "attribute" "question/problem" "value" "Given the vector $\\mathbf{x}$ and the system of linear equations below, find the projection of $\\mathbf{x}$ onto the solution space of the system.\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/assets/37beee87c5b5bd6350bd2c0f6353b61b1cfd321449a96b8b66aac99584d459bb.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/example-5572.json" "file_sha256" "0ae4268ba8aef76cc94d8a78751a4f7c859566402b27fe108e2683f3f061db77"} {"question" "e-5572" "field" nil "attribute" "question/worked-solution" "value" "First, we need to find the basis of the solution space of the system. \n\nConsider the augmented matrix $M$ of the system, which we reduce to row echelon form, as follows:    \n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 1 & 4 & 0 \\\\ 1 & 2 & 0 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}-{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 4 & 0 \\\\ 0 & 1 & -4 & 0\\end{aligned}].\\end{aligned}\n$$\n\nIn the reduced matrix above, there are $2$ pivot columns ($1$st and $2$nd). Thus, $x_3$ is a free variable. Now, from the second equation, we get $x_2=4x_3.$ \nSubstituting this into the first equation, we obtain  \n\n$$\nx_1+4x_3+4x_3= 0\n\\qquad\\Longrightarrow\\qquad\nx_1=-8x_3.\n$$\n\nSo, the general solution is\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/assets/4995b9959cbb8a412fe0ed6198bfa9a82bcda40cd388c4759589e060ec16de1e.png)\nConsequently, ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/assets/232c58060c7ba67f66564e8f8667fe67a84f6ef886a1c56e2d042224ace9b4db.png) is a basis of the solution space of the system.\n\nFinally, we find the projection of $\\mathbf{x}$ onto the solution space of the system:\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,x & =\\frac{x\\cdot b}{b\\cdot b}b \\\\  & =\\frac{(-10)\\cdot (-8)+20\\cdot 4+2\\cdot 1}{{(-8)}^{2}+{4}^{2}+{1}^{2}}b \\\\  & =\\frac{80+80+2}{64+16+1}b \\\\  & =\\frac{162}{81}b \\\\  & =2b \\\\  & =2[\\begin{aligned}-8 \\\\ 4 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}-16 \\\\ 8 \\\\ 2\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/example-5572.json" "file_sha256" "0ae4268ba8aef76cc94d8a78751a4f7c859566402b27fe108e2683f3f061db77"}] "usage" {"q-39712" [] "e-5571" [] "q-40425" [] "e-5572" [] "e-5570" []} "basis" 2203 "retractions" [[17592186134158 :question/problem "Let $x = \\begin{bmatrix}12 \\\\ 6 \\\\ -6 \\\\ 12\\end{bmatrix}$ and $a = \\begin{bmatrix}2 \\\\ 6 \\\\ -6 \\\\ 2\\end{bmatrix}$. If $x = y + z$, where $y ∈ Span{a}$ and $z⊥Span{a}$, then $z =$"] [17592186134213 :question/problem "Given the vector $x$ and the system of linear equations below, find the projection of $x$ onto the solution space of the system.\n\n$x = \\begin{bmatrix}11 \\\\ 3\\end{bmatrix}, {x_{1} + x_{2} = 0; 2x_{1} + 2x_{2} = 0$"] [17592186133513 :question/problem "Let $\\begin{bmatrix}2 \\\\ 9 \\\\ -1 \\\\ -1\\end{bmatrix}$ and $\\begin{bmatrix}2 \\\\ 1 \\\\ 0 \\\\ 1\\end{bmatrix}$ Find the orthogonal projection of $\\mathbf{a}$ onto $\\text{Span}\\{\\mathbf{b}\\}$."] [17592186133513 :question/worked-solution "The orthogonal projection of $\\mathbf{a}$ onto $\\textrm{Span}\\{\\mathbf{b}\\}$ is given by\n\n$$\n\\begin{aligned}\nproj_{b}a &= \\frac{b \\cdot a}{b \\cdot b}b \\\\\n&= (2 \\cdot 2 + 1 \\cdot 9 + 0 \\cdot (-1) + 1 \\cdot (-1))/(2^{2} + 1^{2} + 0^{2} + 1^{2})b \\\\\n&= \\frac{4 + 9 + 0 - 1}{4 + 1 + 0 + 1}b \\\\\n&= \\frac{12}{6}b \\\\\n&= 2b \\\\\n&= 2\\begin{bmatrix}2 \\\\ 1 \\\\ 0 \\\\ 1\\end{bmatrix} \\\\\n&= \\begin{bmatrix}4 \\\\ 2 \\\\ 0 \\\\ 2\\end{bmatrix}\n\\end{aligned}\n$$"] [17592186133514 :question/problem "Let $\\begin{bmatrix}4 \\\\ -4 \\\\ 2 \\\\ 2\\end{bmatrix}$ and $\\begin{bmatrix}1 \\\\ -1 \\\\ 0 \\\\ -1\\end{bmatrix}$ If $\\mathbf{x} = \\mathbf{y} + \\mathbf{z}$, where $\\mathbf{y} \\in \\text{Span}\\{\\mathbf{a}\\}$ and $\\mathbf{z} \\perp \\text{Span}\\{\\mathbf{a}\\}$, then find $\\mathbf{z}$."] [17592186133514 :question/worked-solution "A diagram of the situation is provided below:\n\n![](/home/jake/Developer/MA/DATA/Lessons/2122/Source/Images/1a8d9c2a40956965eaef1293fc216d15.png)\n\nFirst, we find the orthogonal projection of $\\mathbf{x}$ onto $\\textrm{Span}\\{\\mathbf{a}\\}$:\n\n$$\n\\begin{aligned}\nproj_{a}x &= \\frac{a \\cdot x}{a \\cdot a}a \\\\\n&= (1 \\cdot 4 + (-1) \\cdot (-4) + 0 \\cdot 2 + (-1) \\cdot 2)/(1^{2} + (-1)^{2} + 0^{2} + (-1)^{2})a \\\\\n&= \\frac{4 + 4 + 0 - 2}{1 + 1 + 0 + 1}a \\\\\n&= \\frac{6}{3}a \\\\\n&= 2a \\\\\n&= 2\\begin{bmatrix}1 \\\\ -1 \\\\ 0 \\\\ -1\\end{bmatrix} \\\\\n&= \\begin{bmatrix}2 \\\\ -2 \\\\ 0 \\\\ -2\\end{bmatrix}\n\\end{aligned}\n$$\n\nTherefore, we get the following:\n\n$$\n\\begin{aligned}\ny &= proj_{a}x = \\begin{bmatrix}2 \\\\ -2 \\\\ 0 \\\\ -2\\end{bmatrix} \\\\\nz &= x - proj_{a}x = \\begin{bmatrix}4 \\\\ -4 \\\\ 2 \\\\ 2\\end{bmatrix} - \\begin{bmatrix}2 \\\\ -2 \\\\ 0 \\\\ -2\\end{bmatrix} = \\begin{bmatrix}2 \\\\ -2 \\\\ 2 \\\\ 4\\end{bmatrix}\n\\end{aligned}\n$$\n\nNotice that $\\mathbf{y} \\in \\text{Span}\\{\\mathbf{a}\\}$ and $\\mathbf{z} \\perp \\text{Span}\\{\\mathbf{a}\\}$, as shown in the picture above."] [17592186133515 :question/problem "Given the vector $\\mathbf{x}$ and the system of linear equations below, find the projection of $\\mathbf{x}$ onto the solution space of the system.\n$\\begin{bmatrix}-10 \\\\ 20 \\\\ 2\\end{bmatrix}$"] [17592186133515 :question/worked-solution "First, we need to find the basis of the solution space of the system.\n\nConsider the augmented matrix $M$ of the system, which we reduce to row echelon form, as follows:\n\n$$\n\\begin{aligned}\nM &= \\begin{bmatrix}1 & 1 & 4 & 0 \\\\ 1 & 2 & 0 & 0\\end{bmatrix} \\mid R_{2} \\mid:=R_{2} - R_{1} \\\\\n&= ∼\\begin{bmatrix}1 & 1 & 4 & 0 \\\\ 0 & 1 & -4 & 0\\end{bmatrix}\n\\end{aligned}\n$$\n\nIn the reduced matrix above, there are $2$ pivot columns ($1$st and $2$nd). Thus, $x_3$ is a free variable. Now, from the second equation, we get $x_2=4x_3$.\nSubstituting this into the first equation, we obtain\n\n$$\nx_1+4x_3+4x_3= 0 \\qquad\\Longrightarrow\\qquad x_1=-8x_3\n$$\n\nSo, the general solution is\n$\\begin{bmatrix}-8x_{3} \\\\ 4x_{3} \\\\ x_{3}\\end{bmatrix}$\nConsequently, $\\begin{bmatrix}-8 \\\\ 4 \\\\ 1\\end{bmatrix}$ is a basis of the solution space of the system.\n\nFinally, we find the projection of $\\mathbf{x}$ onto the solution space of the system:\n\n$$\n\\begin{aligned}\nproj_{b}x &= \\frac{x \\cdot b}{b \\cdot b}b \\\\\n&= ((-10) \\cdot (-8) + 20 \\cdot 4 + 2 \\cdot 1)/((-8)^{2} + 4^{2} + 1^{2})b \\\\\n&= \\frac{80 + 80 + 2}{64 + 16 + 1}b \\\\\n&= \\frac{162}{81}b \\\\\n&= 2b \\\\\n&= 2\\begin{bmatrix}-8 \\\\ 4 \\\\ 1\\end{bmatrix} \\\\\n&= \\begin{bmatrix}-16 \\\\ 8 \\\\ 2\\end{bmatrix}\n\\end{aligned}\n$$"]] "immutable_answers" [17592186131391 17592186131392 17592186131393 17592186131394 17592186131395 17592186131721 17592186131722 17592186131723 17592186131724 17592186131725] "immutable_fields" [[17592186131390 :answer-field/correct] [17592186131390 :answer-field/id] [17592186131390 :answer-field/key] [17592186131390 :answer-field/type] [17592186131720 :answer-field/correct] [17592186131720 :answer-field/id] [17592186131720 :answer-field/key] [17592186131720 :answer-field/type]] "no_history" []}
