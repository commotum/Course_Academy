 \\\\ -\\frac{9}{2} \\\\ \\frac{3}{2}\\end{aligned}] \\\\ z & =x-{\\text{proj}}_{a}\\,x=[\\begin{aligned}6 \\\\ 3 \\\\ -3 \\\\ 6\\end{aligned}]-[\\begin{aligned}\\frac{3}{2} \\\\ \\frac{9}{2} \\\\ -\\frac{9}{2} \\\\ \\frac{3}{2}\\end{aligned}]=[\\begin{aligned}\\frac{9}{2} \\\\ -\\frac{3}{2} \\\\ \\frac{3}{2} \\\\ \\frac{9}{2}\\end{aligned}]\\end{aligned}\n$$\n\n \n\nNotice that $y\\in \\text{Span}{a}$ and $z⊥\\text{Span}{a},$ as shown in the picture above.\n\nIn conclusion, $z=[\\begin{aligned}\\frac{9}{2} \\\\ -\\frac{3}{2} \\\\ \\frac{3}{2} \\\\ \\frac{9}{2}\\end{aligned}].$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-39729" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/activity-metadata.json" "file_sha256" "a95be3446c0d70fbf5cfa28e597ddbf736d073a3a03cb0ceca806c5e99c31fcb"} {"question" "q-39729" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-39729" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}2 \\\\ -2 \\\\ 2 \\\\ 2\\end{aligned}]"] ["math" "[\\begin{aligned}3 \\\\ -9 \\\\ 9 \\\\ 3\\end{aligned}]"] ["math" "[\\begin{aligned}9 \\\\ -3 \\\\ 3 \\\\ 9\\end{aligned}]"] ["math" "[\\begin{aligned}\\frac{2}{9} \\\\ -\\frac{2}{3} \\\\ \\frac{2}{3} \\\\ \\frac{2}{9}\\end{aligned}]"] ["math" "[\\begin{aligned}\\frac{9}{2} \\\\ -\\frac{3}{2} \\\\ \\frac{3}{2} \\\\ \\frac{9}{2}\\end{aligned}]"]] "category