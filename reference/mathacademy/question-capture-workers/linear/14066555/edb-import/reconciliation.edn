}{10} \\\\ \\frac{7}{10}\\end{aligned}]"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-140114" "field" nil "attribute" "question/problem" "value" "Let $a=[\\begin{aligned}8 \\\\ 4 \\\\ 10 \\\\ 6\\end{aligned}]$ and $b=[\\begin{aligned}1 \\\\ 1 \\\\ -1 \\\\ 2\\end{aligned}].$ Find the orthogonal projection of $a$ onto $\\text{Span}{b}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-140114" "field" nil "attribute" "question/worked-solution" "value" "The orthogonal projection of $a$ onto $\\text{Span}{b}$ is given by\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{b\\cdot a}{b\\cdot b}b \\\\  & =\\frac{1\\cdot 8+1\\cdot 4+(-1)\\cdot 10+2\\cdot 6}{{1}^{2}+{1}^{2}+(-1)^{2}+{2}^{2}}b \\\\  & =\\frac{8+4-10+12}{1+1+1+4}b \\\\  & =\\frac{14}{7}b \\\\  & =2b \\\\  & =2[\\begin{aligned}1 \\\\ 1 \\\\ -1 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ 2 \\\\ -2 \\\\ 4\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-140114" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/activity-metadata.json" "file_sha256" "a95be3446c0d70fbf5cfa28e597ddbf736d073a3a03cb0ceca806c5e99c31fcb"} {"question" "q-140114" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-140114" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-1 \\\\ -1 \\\\ 1 \\\\ 2\\end{aligned}]"] ["math" "[\\begin{aligned}-3 \\\\ -3 \\\\ 3 \\\\ 6\\end{aligned}]"] ["math" "[\\begin{aligned}0 \\\\ 0 \\\\ 0 \\\\ 0\\end{aligned}]"] ["math" "[\\begin{aligned}2 \\\\ 2 \\\\ -2 \\\\ 4\\end{aligned}]"] ["math" "[\\begin{aligned}4 \\\\ 4 \\\\ -4 \\\\ 8\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-140114" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}2 \\\\ 2 \\\\ -2 \\\\ 4\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-40409" "field" nil "attribute" "question/problem" "value" "Let $x=[\\begin{aligned}2 \\\\ -4 \\\\ -2 \\\\ 3\\end{aligned}]$ and $b=[\\begin{aligned}3 \\\\ 0 \\\\ -3 \\\\ 0\\end{aligned}].$ Find the distance between $x$ and $\\text{Span}{b}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-40409" "field" nil "attribute" "question/worked-solution" "value" "The distance between the vector $x$ and the vector space $\\text{Span}{b}$ is given by $‖x-\\overset{^}{x}‖$, where $\\overset{^}{x}$ in the orthogonal projection of $x$ onto $\\text{span}{b}.$\n\nFirst, we find the orthogonal projection of $x$ onto $\\text{Span}{b}.$ \n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,x & =\\frac{b\\cdot x}{b\\cdot b}b \\\\  & =\\frac{3\\cdot 2+0\\cdot (-4)+(-3)\\cdot (-2)+0\\cdot 3}{{3}^{2}+{0}^{2}+(-3)^{2}+{0}^{2}}\\text{ }\\,b \\\\  & =\\frac{6+0+6+0}{9+0+9+0}\\text{ }\\,b \\\\  & =\\frac{2}{3}\\text{ }\\,b \\\\  & =\\frac{2}{3}[\\begin{aligned}3 \\\\ 0 \\\\ -3 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ 0 \\\\ -2 \\\\ 0\\end{aligned}]=\\overset{^}{x}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}‖x-\\overset{^}{x}‖ & =\\sqrt{({x}_{1}-{\\overset{^}{x}}_{1})^{2}+({x}_{2}-{\\overset{^}{x}}_{2})^{2}+({x}_{3}-{\\overset{^}{x}}_{3})^{2}+({x}_{4}-{\\overset{^}{x}}_{4})^{2}} \\\\  & =\\sqrt{(2-2)^{2}+((-4)-0)^{2}+((-2)-(-2))^{2}+(3-0)^{2}} \\\\  & =\\sqrt{0+16+0+9} \\\\  & =\\sqrt{25} \\\\  & =5.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-40409" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/activity-metadata.json" "file_sha256" "a95be3446c0d70fbf5cfa28e597ddbf736d073a3a03cb0ceca806c5e99c31fcb"} {"question" "q-40409" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14066555/state.json" "file_sha256" "1412d7f0caff2f0c5582b699c01d6b53a2f9d3cbec26f241bb67b5677248503a"} {"question" "q-40409" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2\\sqrt{3}"] ["math" "2\\sqrt{5}"] ["math" "3"] ["math" "4"] ["math" "5"]] "category" "ma_complet