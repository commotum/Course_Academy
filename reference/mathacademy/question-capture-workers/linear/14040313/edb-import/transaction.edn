0 & -11 \\\\ 0 & 0 & -11 & -11\\end{aligned}] & {R}_{3} & :=-\\frac{1}{11}{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 2 & 6 & 5 \\\\ 0 & 1 & -10 & -11 \\\\ 0 & 0 & 1 & 1\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-20505/selection/ma-v1/b0c6ddf6cb45cea2c1920e24d2ff72e6709d72c40ad059231608c1f599a11353"] :db/ensure [:question/validate]} {:db/id "q-20515/selection/0730bcf8c3ea73af683d19e21fe4482cd7a58b6b052a1d8ae61577e1f3b1b155" :answer/id #uuid "67156b7a-a78f-53b1-a101-f2287c7a442e" :answer/type :answer.type/math :answer/value "M∼[\\begin{aligned}1 & 2 & 1 & -4 \\\\ 0 & 1 & 1 & -2 \\\\ 0 & 0 & 1 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-20515/selection/ba66374c9011d2af874adafe2568082710019ab745312fb2a914172f798151a6" :answer/id #uuid "1ef3e629-fc44-55e3-992c-f498f578ba99" :answer/type :answer.type/math :answer/value "M∼[\\begin{aligned}1 & 2 & 1 & -4 \\\\ 0 & 1 & 1 & -2 \\\\ 0 & 0 & 1 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-20515/selection/0ced169228007e8c7bebdf2437ba630accb3840fd690f16b35c1b8fba1424e6c" :answer/id #uuid "f9b46550-522a-528e-91c7-71b123f79d81" :answer/type :answer.type/math :answer/value "M∼[\\begin{aligned}1 & 2 & 1 & -4 \\\\ 0 & 1 & 1 & -2 \\\\ 0 & 0 & 1 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-20515/selection/b15ee9c4fa5ef20277f73b411735e22718d3db6a18913901b8e987971c974e59" :answer/id #uuid "9489c7df-6e8e-5d3e-9ff2-de5744cf28a4" :answer/type :answer.type/math :answer/value "M∼[\\begin{aligned}1 & 2 & 1 & -4 \\\\ 0 & 1 & 1 & -1 \\\\ 0 & 0 & 1 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-20515/selection/e0184ab7b011a4cbeeaadbba344497e0ea4a06b17386bbaa702d369b3f9e64ed" :answer/id #uuid "6bf873a6-f0e8-5756-a6f9-86a730d1f3ed" :answer/type :answer.type/math :answer/value "M∼[\\begin{aligned}1 & 2 & 1 & -4 \\\\ 0 & 1 & 1 & -2 \\\\ 0 & 0 & 1 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-20515/selection"