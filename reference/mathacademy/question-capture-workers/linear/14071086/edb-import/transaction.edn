1 & 0 \\\\ -1 & -1\\end{aligned}]}}\\overset{x}{\\overset{⏞}{[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]}} & =\\overset{b}{\\overset{⏞}{[\\begin{aligned}2 \\\\ 1 \\\\ 1 \\\\ 3\\end{aligned}]}} \\\\ Ax & =b\\end{aligned}\n$$\n\nWe can find the least-squares solution $\\overset{^}{x}$ of the equation above by solving the corresponding normal equation, which we obtain by left-multiplying our original equation by ${A}^{T}:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A\\overset{^}{x} & ={A}^{T}b\\end{aligned}\n$$\n\nSince the columns of $A$ are linearly independent, the matrix ${A}^{T}\\,A$ is invertible. Therefore, multiplying by $({A}^{T}\\,A)^{-1}$ on the left, we obtain\n\n$$\n\\begin{aligned}\\overset{^}{x} & =({A}^{T}\\,A)^{-1}{A}^{T}b \\\\  & ={([\\begin{aligned}-1 & 0 & -1 & -1 \\\\ -2 & 1 & 0 & -1\\end{aligned}][\\begin{aligned}-1 & -2 \\\\ 0 & 1 \\\\ -1 & 0 \\\\ -1 & -1\\end{aligned}])}^{-1}[\\begin{aligned}-1 & 0 & -1 & -1 \\\\ -2 & 1 & 0 & -1\\end{aligned}][\\begin{aligned}2 \\\\ 1 \\\\ 1 \\\\ 3\\end{aligned}] \\\\  & ={[\\begin{aligned}3 & 3 \\\\ 3 & 6\\end{aligned}]}^{-1}[\\begin{aligned}-6 \\\\ -6\\end{aligned}] \\\\  & =\\frac{1}{3}[\\begin{aligned}2 & -1 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}-6 \\\\ -6\\end{aligned}] \\\\  & =[\\begin{aligned}-2 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nThe minimum value of $‖Ax-b‖$ is attained when $x=\\overset{^}{x},$ which is the least-squares solution of the system $Ax=b.$ In this case, $A\\overset{^}{x}$ represents the orthogonal projection of $b$ onto the column space of $A,$ and $‖A\\overset{^}{x}-b‖$ is the distance between the vector $b$ and the column space. Therefore,\n\n$$\n\\begin{aligned}A\\overset{^}{x}-b & =[\\begin{aligned}-1 & -2 \\\\ 0 & 1 \\\\ -1 & 0 \\\\ -1 & -1\\end{aligned}][\\begin{aligned}-2 \\\\ 0\\end{aligned}]-[\\begin{aligned}2 \\\\ 1 \\\\ 1 \\\\ 3\\end{aligned}]=[\\begin{aligned}0 \\\\ -1 \\\\ 1 \\\\ -1\\end{aligned}].\\end{aligned}\n$$\n\nFinally, \n\n$$\n‖A\\overset{^}{x}-b‖=\\sqrt{{0}^{2}+(-1)^{2}+{1}^{2}+(-1)^{2}}=\\sqrt{3}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-85909/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5924037a-ddc3-5f50-b4b0-1bd813cef255"] :knowledge-point/questions ["q-85909"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-5589"] :question/problem "Given that the columns of $A$ are linearly independent, find the least-squares solution of $A\\mathbf{x}=\\mathbf{b}$, where \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071086/assets/8b006c23e83405be4cd93396e5bde38c0dbcb5f8bb735b125d0b05f439e5b0d9.png)" :question/worked-solution "First of all, we write the given system in the form $A \\mathbf{x} = \\mathbf{b}\\mathbin{:}$\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071086/assets/6fed2ac5452cf11059550a0c6328914c0e897714ca14a68f71df8eeb6d93471d.png)\n\nWe can find the least-squares solution ${\\hat{\\mathbf{x}}}$ of the equation above by solving the corresponding normal equation, which we obtain by left-multiplying our original equation by $A^T\\mathbin{:}$\n\n$$\n\\begin{aligned}{A}^{T}\\,A\\overset{^}{x} & ={A}^{T}b\\end{aligned}\n$$\n\nSince the columns of $A$ are linearly independent, the matrix $A^T \\! A$ is invertible. Therefore, multiplying by $(A^T \\! A)^{-1}$ on the left, we obtain\n\n$$\n\\begin{aligned}\\overset{^}{x} & =({A}^{T}\\,A)^{-1}{A}^{T}b \\\\  & ={([\\begin{aligned}1 & 1 & 2 & 0 \\\\ -1 & 0 & -1 & 1\\end{aligned}][\\begin{aligned}1 & -1 \\\\ 1 & 0 \\\\ 2 & -1 \\\\ 0 & 1\\end{aligned}])}^{-1}\\,\\,\\,[\\begin{aligned}1 & 1 & 2 & 0 \\\\ -1 & 0 & -1 & 1\\end{aligned}][\\begin{aligned}1 \\\\ 0 \\\\ 1 \\\\ 0\\end{aligned}] \\\\  & ={[\\begin{aligned}6 & -3 \\\\ -3 & 3\\end{aligned}]}^{-1}[\\begin{aligned}3 \\\\ -2\\end{aligned}] \\\\  & =\\frac{1}{3}[\\begin{aligned}1 & 1 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}3 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{3} \\\\ -\\frac{1}{3}\\end{aligned}].\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5588"] :question/problem "Find the least-squares solution to the system of linear equations given below. You're given that the columns of the corresponding coefficient matrix are linearly independent.\n\n$$\n{\\begin{aligned}-2{x}_{1}-{x}_{2}=12 \\\\ {x}_{1}-2{x}_{2}+{x}_{3}=0 \\\\ -{x}_{2}-2{x}_{3}=-12 \\\\ {x}_{1}-{x}_{3}=0\\end{aligned}\n$$" :question/worked-solution "First of all, we write the given system in the form $A \\mathbf{x} = \\mathbf{b}\\mathbin{:}$\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071086/assets/fa49e62c4e6fce14470e1641ef5e9a8c986778d74812e1bac82d3ba9df94aef8.png)\n\nWe can find the least-squares solution ${\\hat{\\mathbf{x}}}$ of the equation above by solving the corresponding normal equation, which we obtain by left-multiplying our original equation by $A^T\\mathbin{:}$\n\n$$\n\\begin{aligned}{A}^{T}\\,A\\overset{^}{x} & ={A}^{T}b\\end{aligned}\n$$\n\nSince the columns of $A$ are linearly independent, the matrix $A^T \\! A$ is invertible. Therefore, multiplying by $(A^T \\! A)^{-1}$ on the left, we obtain\n\n$$\n\\begin{aligned}\\overset{^}{x} & =({A}^{T}\\,A)^{-1}{A}^{T}b \\\\  & ={([\\begin{aligned}-2 & 1 & 0 & 1 \\\\ -1 & -2 & -1 & 0 \\\\ 0 & 1 & -2 & -1\\end{aligned}][\\begin{aligned}-2 & -1 & 0 \\\\ 1 & -2 & 1 \\\\ 0 & -1 & -2 \\\\ 1 & 0 & -1\\end{aligned}])}^{-1}\\,\\,\\,\\,[\\begin{aligned}-2 & 1 & 0 & 1 \\\\ -1 & -2 & -1 & 0 \\\\ 0 & 1 & -2 & -1\\end{aligned}][\\begin{aligned}12 \\\\ 0 \\\\ -12 \\\\ 0\\end{aligned}] \\\\  & ={[\\begin{aligned}6 & 0 & 0 \\\\ 0 & 6 & 0 \\\\ 0 & 0 & 6\\end{aligned}]}^{-1}[\\begin{aligned}-24 \\\\ 0 \\\\ 24\\end{aligned}] \\\\  & =\\frac{1}{6}[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}-24 \\\\ 0 \\\\ 24\\end{aligned}] \\\\  & =[\\begin{aligned}-4 \\\\ 0 \\\\ 4\\end{aligned}].\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7429"] :question/problem "Consider the system $A\\mathbf{x}=\\mathbf{b}$, where the matrix $A$ and the vector $\\mathbf{b}$ are given below. Given that the columns of $A$ are linearly independent, find the minimum value of $\\Vert A\\mathbf{x} - \\mathbf{b} \\Vert.$\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071086/assets/8200befaaea3a0cdec7e423999839c72d48fc67110fa577c8707e182c4524aff.png)" :question/worked-solution "First of all, we write the given system in the form $A \\mathbf{x} = \\mathbf{b}\\mathbin{:}$\n\n$$\n\\begin{aligned}\\overset{A}{\\overset{⏞}{[\\begin{aligned}1 & 1 \\\\ 1 & 0 \\\\ -1 & 0 \\\\ -1 & -1\\end{aligned}]}}\\overset{x}{\\overset{⏞}{[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]}} & =\\overset{b}{\\overset{⏞}{[\\begin{aligned}22 \\\\ 0 \\\\ 0 \\\\ 2\\end{aligned}]}} \\\\ Ax & =b\\end{aligned}\n$$\n\nWe can find the least-squares solution ${\\hat{\\mathbf{x}}}$ of the equation above by solving the corresponding normal equation, which we obtain by left-multiplying our original equation by $A^T\\mathbin{:}$\n\n$$\n\\begin{aligned}{A}^{T}\\,A\\overset{^}{x} & ={A}^{T}b\\end{aligned}\n$$\n\nSince the columns of $A$ are linearly independent, the matrix $A^T \\! A$ is invertible. Therefore, multiplying by $(A^T \\! A)^{-1}$ on the left, we obtain\n\n$$\n\\begin{aligned}\\overset{^}{x} & =({A}^{T}\\,A)^{-1}{A}^{T}b \\\\  & ={([\\begin{aligned}1 & 1 & -1 & -1 \\\\ 1 & 0 & 0 & -1\\end{aligned}][\\begin{aligned}1 & 1 \\\\ 1 & 0 \\\\ -1 & 0 \\\\ -1 & -1\\end{aligned}])}^{-1}\\,\\,\\,\\,[\\begin{aligned}1 & 1 & -1 & -1 \\\\ 1 & 0 & 0 & -1\\end{aligned}][\\begin{aligned}22 \\\\ 0 \\\\ 0 \\\\ 2\\end{aligned}] \\\\  & ={[\\begin{aligned}4 & 2 \\\\ 2 & 2\\end{aligned}]}^{-1}[\\begin{aligned}20 \\\\ 20\\end{aligned}] \\\\  & =\\frac{1}{4}[\\begin{aligned}2 & -2 \\\\ -2 & 4\\end{aligned}][\\begin{aligned}20 \\\\ 20\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}1 & -1 \\\\ -1 & 2\\end{aligned}][\\begin{aligned}20 \\\\ 20\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 10\\end{aligned}].\\end{aligned}\n$$\n\nThe minimum value of $\\Vert A\\mathbf{x} - \\mathbf{b} \\Vert$ is attained when $\\mathbf{x}={\\hat{\\mathbf{x}}},$ which is the least-squares solution of the system $A\\mathbf{x}=\\mathbf{b}.$\n\nIn this case, $A{\\hat{\\mathbf{x}}}$ represents the orthogonal projection of $\\mathbf{b}$ onto the column space of $A,$ and $\\Vert A{\\hat{\\mathbf{x}}} - \\mathbf{b} \\Vert$ is the distance between the vector $\\mathbf{b}$ and the column space.\n\nTherefore,\n\n$$\n\\begin{aligned}A\\overset{^}{x}-b & =[\\begin{aligned}1 & 1 \\\\ 1 & 0 \\\\ -1 & 0 \\\\ -1 & -1\\end{aligned}][\\begin{aligned}0 \\\\ 10\\end{aligned}]-[\\begin{aligned}22 \\\\ 0 \\\\ 0 \\\\ 2\\end{aligned}]=[\\begin{aligned}-12 \\\\ 0 \\\\ 0 \\\\ -12\\end{aligned}].\\end{aligned}\n$$\n\nFinally, \n\n$$\n\\Vert A{\\hat{\\mathbf{x}}}-\\mathbf{b}\\Vert =\\sqrt{(-12)^2+0^2+(-12)^2+0^2}=12\\sqrt{2}.\n$$" :db/ensure [:question/validate]}]
