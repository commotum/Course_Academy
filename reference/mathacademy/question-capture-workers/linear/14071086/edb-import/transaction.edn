}\\overset{^}{x} & =({A}^{T}\\,A)^{-1}{A}^{T}b \\\\  & ={([\\begin{aligned}1 & 1 & 1 & 1 \\\\ 0 & -1 & 0 & 1 \\\\ 2 & -1 & 0 & -1\\end{aligned}][\\begin{aligned}1 & 0 & 2 \\\\ 1 & -1 & -1 \\\\ 1 & 0 & 0 \\\\ 1 & 1 & -1\\end{aligned}])}^{-1}[\\begin{aligned}1 & 1 & 1 & 1 \\\\ 0 & -1 & 0 & 1 \\\\ 2 & -1 & 0 & -1\\end{aligned}][\\begin{aligned}6 \\\\ 0 \\\\ 6 \\\\ 0\\end{aligned}] \\\\  & ={[\\begin{aligned}4 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 6\\end{aligned}]}^{-1}[\\begin{aligned}12 \\\\ 0 \\\\ 12\\end{aligned}] \\\\  & =\\frac{1}{12}[\\begin{aligned}3 & 0 & 0 \\\\ 0 & 6 & 0 \\\\ 0 & 0 & 2\\end{aligned}][\\begin{aligned}12 \\\\ 0 \\\\ 12\\end{aligned}] \\\\  & =[\\begin{aligned}3 \\\\ 0 \\\\ 2\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-85895/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d23c4292-6fdd-5cba-a2e7-0f4d770b2309"] :knowledge-point/questions ["q-85895"] :db/ensure [:knowledge-point/validate]} {:db/id "q-85899/selection/d7c0999cfe7bac7d9475f10c8bfd6fbddbd462a91c2e51f70ea0c0b73553b311" :answer/id #uuid "6e9b3d95-8c09-5f87-b94e-1fcaf4dc858c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ 1 \\\\ \\frac{3}{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-85899/selection/472f7c486d48437a0b048112ee0b981047c57155cb48b414e0f60483575f36a3" :answer/id #uuid "f704dede-11e0-54e8-a2a1-6760d961f308" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ \\frac{3}{2} \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-85899/selection/52f983c1e261e63eba86b7942f4547a0839137300af95672e2f7c0c445edd5a9" :answer/id #uuid "2a7ecf04-867c-54cd-8a51-3091dab2f353" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ 2 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-85899/selection/29b387069ed4f40f387d4e414d463da73e971752f0d743f630d2cc578a80819a" :answer/id #uuid "dac0bf64-cdf7-5fbd-a