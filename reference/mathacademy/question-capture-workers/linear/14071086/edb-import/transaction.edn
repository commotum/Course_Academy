 3 & 6\\end{aligned}][\\begin{aligned}6 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 0\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-85892/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d23c4292-6fdd-5cba-a2e7-0f4d770b2309"] :knowledge-point/questions ["q-85892"] :db/ensure [:knowledge-point/validate]} {:db/id "q-41776/selection/6ca9a3a9c7aa913f810201d44a6b7d7e75f79cf382d9db2da44301dc12ff5891" :answer/id #uuid "0da6ac7e-d253-5250-8300-54797ad5c7a6" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-\\frac{3}{20} \\\\ -\\frac{1}{20}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-41776/selection/a8289d3401dba1d4ad1fa730aa7b8dad7ebd2f0bc04590b6df44c79cc244fb62" :answer/id #uuid "cd40a754-5b74-5bae-a24a-67e89a2fd24b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-\\frac{13}{20} \\\\ \\frac{1}{20}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-41776/selection/ca3fe638757aa6071a531f0f7b4fef82d30de01a25b7a619b13bb0c7b7f96b8c" :answer/id #uuid "7ba4c5ea-bf12-5243-bc71-20d573ed84fc" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{17}{20} \\\\ \\frac{3}{20}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-41776/selection/6992c7eff3fab4f1b6e82c41fca3580bcb0c8043cf28737ead1c315f698782f3" :answer/id #uuid "04cb03e0-c3b5-5219-a135-2ee9b755ce8a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{11}{20} \\\\ -\\frac{7}{20}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-41776/selection/1bafe822041d1d45e07e1f33fccdecfbdcba91512b4967243739f6173c49870d" :answer/id #uuid "8883179a-1a66-5e7b-883e-35e07309e2e6" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-\\frac{3}{20} \\\\ \\frac{1}{3}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-41776/selection" :answer-field/id #uuid "21176373-f903-59e5-a882-155719427294" :answer-field/key "selection" 