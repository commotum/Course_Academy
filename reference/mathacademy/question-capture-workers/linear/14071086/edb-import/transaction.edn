12\\end{aligned}]}}\\end{aligned}\n$$\n\nWe can find the least-squares solution $\\overset{^}{x}$ of the equation above by solving the corresponding normal equation, which we obtain by left-multiplying our original equation by ${A}^{T}:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A\\overset{^}{x} & ={A}^{T}b\\end{aligned}\n$$\n\nSince the columns of $A$ are linearly independent, the matrix ${A}^{T}\\,A$ is invertible. Therefore, multiplying by $({A}^{T}\\,A)^{-1}$ on the left, we obtain\n\n$$\n\\begin{aligned}\\overset{^}{x} & =({A}^{T}\\,A)^{-1}{A}^{T}b \\\\  & ={([\\begin{aligned}2 & 2 & 2 & 2 \\\\ 0 & -4 & 0 & 4 \\\\ 4 & -2 & 0 & -2\\end{aligned}][\\begin{aligned}2 & 0 & 4 \\\\ 2 & -4 & -2 \\\\ 2 & 0 & 0 \\\\ 2 & 4 & -2\\end{aligned}])}^{-1}[\\begin{aligned}2 & 2 & 2 & 2 \\\\ 0 & -4 & 0 & 4 \\\\ 4 & -2 & 0 & -2\\end{aligned}][\\begin{aligned}12 \\\\ 0 \\\\ 0 \\\\ 12\\end{aligned}] \\\\  & ={[\\begin{aligned}16 & 0 & 0 \\\\ 0 & 32 & 0 \\\\ 0 & 0 & 24\\end{aligned}]}^{-1}[\\begin{aligned}48 \\\\ 48 \\\\ 24\\end{aligned}] \\\\  & =\\frac{1}{96}[\\begin{aligned}6 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 4\\end{aligned}][\\begin{aligned}48 \\\\ 48 \\\\ 24\\end{aligned}] \\\\  & =[\\begin{aligned}3 \\\\ \\frac{3}{2} \\\\ 1\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-85899/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d23c4292-6fdd-5cba-a2e7-0f4d770b2309"] :knowledge-point/questions ["q-85899"] :db/ensure [:knowledge-point/validate]} {:db/id "q-40889/selection/0c510566c122522370cc37d8738c86aad597b9d3b9bb3c1529cad7ad8f0c8acd" :answer/id #uuid "97f3056b-45d1-59d8-9a7a-c18312268181" :answer/type :answer.type/math :answer/value "[\\begin{aligned}8 \\\\ -\\frac{1}{15}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-40889/selection/9f4f4e52d53f1bd54e6041971b7578348d6bf213b3127eb16f2625348bad9e69" :answer/id #uuid "bfd6caad-3536-5b06-8e20-f4abcc84702d" :answer/type :answer.type/