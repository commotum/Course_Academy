 1 \\\\ 2 & 2 \\\\ -1 & 3\\end{aligned}])}^{-1}[\\begin{aligned}1 & 2 & -1 \\\\ 1 & 2 & 3\\end{aligned}][\\begin{aligned}1 \\\\ -1 \\\\ 0\\end{aligned}] \\\\  & ={[\\begin{aligned}6 & 2 \\\\ 2 & 14\\end{aligned}]}^{-1}[\\begin{aligned}-1 \\\\ -1\\end{aligned}] \\\\  & =\\frac{1}{40}[\\begin{aligned}7 & -1 \\\\ -1 & 3\\end{aligned}][\\begin{aligned}-1 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{3}{20} \\\\ -\\frac{1}{20}\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-41776/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "74efec6b-6e5f-5761-a116-5c94e3fb4326"] :knowledge-point/questions ["q-41776"] :db/ensure [:knowledge-point/validate]} {:db/id "q-41779/selection/60eadf18022e36714cee17e0479ab6af66a6361ceef7571ec8305b4e57ee6d8f" :answer/id #uuid "73f4ab31-f0b7-5497-80e3-fb24304cf316" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-41779/selection/f643d3fc7fa58d757583cd1d85f5015595170c7478b201e4410986ba7c42f9ba" :answer/id #uuid "85e18d47-135c-5cb7-84d8-fed8918df6a0" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ \\frac{4}{7}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-41779/selection/89a7b50043145b047ec0b49f3140fd1e1b3e4de0bc9d81a9f50ac0b4c1e9f136" :answer/id #uuid "9789b522-415e-5fe7-b7ca-0e66b652e811" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-41779/selection/a5fcfbe227471cec8f386711185996d0f9e451e57e25bf89dd58b1124d8ecfcd" :answer/id #uuid "6ebd4fe1-e496-5b7f-afe2-cf485d818dbd" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{1}{7} \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-41779/selection/8b9b503815853df6e97c124707c58c796a108f90141791bd12b7b751790302d3" :answer/id #uuid "6c75c309-0340-5b7e-bf38-a751a4f2eead" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-\\frac{1}{14} \\\\ \\frac{1}{7}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-41779/selection" :answer-field/id #uuid "81358ba8-e7e1-5402-90a5-a43f3f6d6dfc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-41779/selection/89a7b50043145b047ec0b49f3140fd1e1b3e4de0bc9d81a9f50ac0b4c1e9f136" :answer-field/choices ["q-41779/selection/60eadf18022e36714cee17e0479ab6af66a6361ceef7571ec8305b4e57ee6d8f" "q-41779/selection/f643d3fc7fa58d757583cd1d85f5015595170c7478b201e4410986ba7c42f9ba" "q-41779/selection/89a7b50043145b047ec0b49f3140fd1e1b3e4de0bc9d81a9f50ac0b4c1e9f136" "q-41779/selection/a5fcfbe227471cec8f386711185996d0f9e451e57e25bf89dd58b1124d8ecfcd" "q-41779/selection/8b9b503815853df6e97c124707c58c796a108f90141791bd12b7b751790302d3"] :db/ensure [:answer-field/validate]} {:db/id "q-41779" :question/id #uuid "e0174f23-e3c1-53ee-8e26-06192fa2ac03" :question/math-academy-id "q-41779" :question/problem "Find the least-squares solution to the system of linear equations given below. You're given that the columns of the corresponding coefficient matrix are linearly independent.\n\n$$\n{\\begin{aligned}{x}_{1}+4{x}_{2}=-2 \\\\ 3{x}_{1}-2{x}_{2}=6 \\\\ -2{x}_{1}-{x}_{2}=1\\end{aligned}\n$$" :question/worked-solution "First of all, we write the given system in the form $Ax=b:$\n\n$$\n\\overset{A}{\\overset{⏞}{[\\begin{aligned}1 & 4 \\\\ 3 & -2 \\\\ -2 & -1\\end{aligned}]}}\\overset{x}{\\overset{⏞}{[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]}}=\\overset{b}{\\overset{⏞}{[\\begin{aligned}-2 \\\\ 6 \\\\ 1\\end{aligned}]}}.\n$$\n\nWe can find the least-squares solution $\\overset{^}{x}$ of the equation above by solving the corresponding normal equation, which we obtain by left-multiplying our original equation by ${A}^{T}:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A\\overset{^}{x} & ={A}^{T}b\\end{aligned}\n$$\n\nSince the columns of $A$ are linearly independent, the matrix ${A}^{T}\\,A$ is invertible. Therefore, multiplying by $({A}^{T}\\,A)^{-1}$ on the left, we obtain\n\n$$\n\\begin{aligned}\\overset{^}{x} & =({A}^{T}\\,A)^{-1}{A}^{T}b \\\\  & ={([\\begin{aligned}1 & 3 & -2 \\\\ 4 & -2 & -1\\end{aligned}][\\begin{aligned}1 & 4 \\\\ 3 & -2 \\\\ -2 & -1\\end{aligned}])}^{-1}[\\begin{aligned}1 & 3 & -2 \\\\ 4 & -2 & -1\\end{aligned}][\\begin{aligned}-2 \\\\ 6 \\\\ 1\\end{aligned}] \\\\  & ={[\\begin{aligned}14 & 0 \\\\ 0 & 21\\end{aligned}]}^{-1}[\\begin{aligned}14 \\\\ -21\\end{aligned}] \\\\  & =\\frac{1}{42}[\\begin{aligned}3 & 0 \\\\ 0 & 2\\end{aligned}][\\begin{aligned}14 \\\\ -21\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ -1\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-41779/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "74efec6b-6e5f-5761-a116-5c94e3fb4326"] :knowledge-point/questions ["q-41779"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-41775"] :question/problem "Find the least-squares solution to the system of linear equations given below. You're given that the columns of the corresponding coefficient matrix are linearly independent.\n\n$$\n{\\begin{aligned}{x}_{1}+2{x}_{2}+{x}_{3}=18 \\\\ {x}_{1}-3{x}_{2}=0 \\\\ {x}_{1}+2{x}_{2}-{x}_{3}=18 \\\\ {x}_{1}-{x}_{2}=0\\end{aligned}\n$$" :question/worked-solution "First of all, we write the given system in the form $Ax=b:$\n\n$$\n\\begin{aligned}\\overset{A}{\\overset{⏞}{[\\begin{aligned}1 & 2 & 1 \\\\ 1 & -3 & 0 \\\\ 1 & 2 & -1 \\\\ 1 & -1 & 0\\end{aligned}]}}\\overset{x}{\\overset{⏞}{[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]}} & =\\overset{b}{\\overset{⏞}{[\\begin{aligned}18 \\\\ 0 \\\\ 18 \\\\ 0\\end{aligned}]}}\\end{aligned}\n$$\n\nWe can find the least-squares solution $\\overset{^}{x}$ of the equation above by solving the corresponding normal equation, which we obtain by left-multiplying our original equation by ${A}^{T}:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A\\overset{^}{x} & ={A}^{T}b\\end{aligned}\n$$\n\nSince the columns of $A$ are linearly independent, the matrix ${A}^{T}\\,A$ is invertible. Therefore, multiplying by $({A}^{T}\\,A)^{-1}$ on the left, we obtain\n\n$$\n\\begin{aligned}\\overset{^}{x} & =({A}^{T}\\,A)^{-1}{A}^{T}b \\\\  & ={([\\begin{aligned}1 & 1 & 1 & 1 \\\\ 2 & -3 & 2 & -1 \\\\ 1 & 0 & -1 & 0\\end{aligned}][\\begin{aligned}1 & 2 & 1 \\\\ 1 & -3 & 0 \\\\ 1 & 2 & -1 \\\\ 1 & -1 & 0\\end{aligned}])}^{-1}\\,\\,[\\begin{aligned}1 & 1 & 1 & 1 \\\\ 2 & -3 & 2 & -1 \\\\ 1 & 0 & -1 & 0\\end{aligned}][\\begin{aligned}18 \\\\ 0 \\\\ 18 \\\\ 0\\end{aligned}] \\\\  & ={[\\begin{aligned}4 & 0 & 0 \\\\ 0 & 18 & 0 \\\\ 0 & 0 & 2\\end{aligned}]}^{-1}[\\begin{aligned}36 \\\\ 72 \\\\ 0\\end{aligned}] \\\\  & =\\frac{1}{36}[\\begin{aligned}9 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 18\\end{aligned}][\\begin{aligned}36 \\\\ 72 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}9 \\\\ 4 \\\\ 0\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-85275/selection/49269ef3829cba5b9520e56bd8d2fcc690e8a57db5f164e24081ba0796e0176c" :answer/id #uuid "2e906fbf-055f-5f38-afa0-d40aca125646" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 \\\\ 6 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-85275/selection/762f13adef758613b13fb428c2fa681851093f9565107f04fb8ed6e62c1edc43" :answer/id #uuid "bbdb84f1-a0b6-5780-8f42-135565377390" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 \\\\ 0 \\\\ 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-85275/selection/339ed9f929b6226854ca1517c7dba9f99d5655dc07cf7c1f46d0711163a86475" :answer/id #uuid "b6832d82-3ea3-579f-a7d0-a8b259a11801" :answer/type :answer.type/math :answer/value "[\\begin{aligned}6 \\\\ 0 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-85275/selection/ca0a533f5210ef23acd609f3fb2e73d7a901f05a2c7661aa760af3d2ec69f01b" :answer/id #uuid "881cc747-084f-5678-9b8f-e1d269cf79f1" :answer/type :answer.type/math :answer/value "[\\begin{aligned}6 \\\\ 0 \\\\ 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-85275/selection/d3e09d7af4fdced22d8be826dfa8c324ad4d3b3930bdb2e73bd5fe7ad7d2d933" :answer/id #uuid "ecf01513-998a-56e1-a4f4-dbb966df7b3c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}9 \\\\ 0 \\\\ 9\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-85275/selection" :answer-field/id #uuid "efb53557-7307-5768-8cf5-2834b240c866" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-85275/selection/339ed9f929b6226854ca1517c7dba9f99d5655dc07cf7c1f46d0711163a86475" :answer-field/choices ["q-85275/selection/49269ef3829cba5b9520e56bd8d2fcc690e8a57db5f164e24081ba0796e0176c" "q-85275/selection/762f13adef758613b13fb428c2fa681851093f9565107f04fb8ed6e62c1edc43" "q-85275/selection/339ed9f929b6226854ca1517c7dba9f99d5655dc07cf7c1f46d0711163a86475" "q-85275/selection/ca0a533f5210ef23acd609f3fb2e73d7a901f05a2c7661aa760af3d2ec69f01b" "q-85275/selection/d3e09d7af4fdced22d8be826dfa8c324ad4d3b3930bdb2e73bd5fe7ad7d2d933"] :db/ensure [:answer-field/validate]} {:db/id "q-85275" :question/id #uuid "1a38eea7-13c5-59fe-a820-3f0859b3b4fd" :question/math-academy-id "q-85275" :question/problem "Find the least-squares solution to the system of linear equations given below. You're given that the columns of the corresponding coefficient matrix are linearly independent.\n\n$$\n{\\begin{aligned}{x}_{1}-2{x}_{2}=6 \\\\ 2{x}_{1}+{x}_{2}+2{x}_{3}=12 \\\\ -2{x}_{2}+{x}_{3}=0 \\\\ 2{x}_{1}-2{x}_{3}=12\\end{aligned}\n$$" :question/worked-solution "First of all, we write the given system in the form $Ax=b:$\n\n$$\n\\overset{A}{\\overset{⏞}{[\\begin{aligned}1 & -2 & 0 \\\\ 2 & 1 & 2 \\\\ 0 & -2 & 1 \\\\ 2 & 0 & -2\\end{aligned}]}}\\overset{x}{\\overset{⏞}{[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]}}=\\overset{b}{\\overset{⏞}{[\\begin{aligned}6 \\\\ 12 \\\\ 0 \\\\ 12\\end{aligned}]}}\n$$\n\nWe can find the least-squares solution $\\overset{^}{x}$ of the equation above by solving the corresponding normal equation, which we obtain by left-multiplying our original equation by ${A}^{T}:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A\\overset{^}{x} & ={A}^{T}b\\end{aligned}\n$$\n\nSince the columns of $A$ are linearly independent, the matrix ${A}^{T}\\,A$ is invertible. Therefore, multiplying by $({A}^{T}\\,A)^{-1}$ on the left, we obtain\n\n$$\n\\begin{aligned}\\overset{^}{x} & =({A}^{T}\\,A)^{-1}{A}^{T}b \\\\  & ={([\\begin{aligned}1 & 2 & 0 & 2 \\\\ -2 & 1 & -2 & 0 \\\\ 0 & 2 & 1 & -2\\end{aligned}][\\begin{aligned}1 & -2 & 0 \\\\ 2 & 1 & 2 \\\\ 0 & -2 & 1 \\\\ 2 & 0 & -2\\end{aligned}])}^{-1}[\\begin{aligned}1 & 2 & 0 & 2 \\\\ -2 & 1 & -2 & 0 \\\\ 0 & 2 & 1 & -2\\end{aligned}][\\begin{aligned}6 \\\\ 12 \\\\ 0 \\\\ 12\\end{aligned}] \\\\  & ={[\\begin{aligned}9 & 0 & 0 \\\\ 0 & 9 & 0 \\\\ 0 & 0 & 9\\end{aligned}]}^{-1}[\\begin{aligned}54 \\\\ 0 \\\\ 0\\end{aligned}] \\\\  & =\\frac{1}{9}[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}54 \\\\ 0 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}6 \\\\ 0 \\\\ 0\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-85275/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "74efec6b-6e5f-5761-a116-5c94e3fb4326"] :knowledge-point/questions ["q-85275"] :db/ensure [:knowledge-point/validate]} {:db/id "q-41780/selection/c27fc82e5d9a29700fb73da180f597981b00dab59b75a6870b8af68ecf843094" :answer/id #uuid "7282aeda-0aca-5e3a-b4cb-876511f05810" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ -5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-41780/selection/400633bad14630a17e8d6b5d56b5c82a119b3993ab14b4985f5c4009933473c6" :answer/id #uuid "b6510e3a-24cc-5179-9565-c289e535cbd5" :