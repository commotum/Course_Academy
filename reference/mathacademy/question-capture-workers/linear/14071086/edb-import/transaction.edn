8a466622fc712301fab5390a6ea078" "q-40887/selection/ee2859f41df9695deb34b9c5500fc036178dfabaad7fd8784c8d4256fababc5f"] :db/ensure [:answer-field/validate]} {:db/id "q-40887" :question/id #uuid "7eac623d-3625-5eef-86a3-1e868caeb2f0" :question/math-academy-id "q-40887" :question/problem "Given that the columns of $A$ are linearly independent, find the least-squares solution of $Ax=b$, where \n\n$\\,$ $A=[\\begin{aligned}1 & -1 \\\\ 1 & -2 \\\\ 0 & -1 \\\\ 1 & 3\\end{aligned}]\\,$ and $\\,b=[\\begin{aligned}1 \\\\ 0 \\\\ -1 \\\\ 0\\end{aligned}].$" :question/worked-solution "First of all, we write the given system in the form $Ax=b:$\n\n$$\n\\overset{A}{\\overset{⏞}{[\\begin{aligned}1 & -1 \\\\ 1 & -2 \\\\ 0 & -1 \\\\ 1 & 3\\end{aligned}]}}\\overset{x}{\\overset{⏞}{[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]}}=\\overset{b}{\\overset{⏞}{[\\begin{aligned}1 \\\\ 0 \\\\ -1 \\\\ 0\\end{aligned}]}}\n$$\n\nWe can find the least-squares solution $\\overset{^}{x}$ of the equation above by solving the corresponding normal equation, which we obtain by left-multiplying our original equation by ${A}^{T}:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A\\overset{^}{x} & ={A}^{T}b\\end{aligned}\n$$\n\nSince the columns of $A$ are linearly independent, the matrix ${A}^{T}\\,A$ is invertible. Therefore, multiplying by $({A}^{T}\\,A)^{-1}$ on the left, we obtain\n\n$$\n\\begin{aligned}\\overset{^}{x} & =({A}^{T}\\,A)^{-1}{A}^{T}b \\\\  & ={([\\begin{aligned}1 & 1 & 0 & 1 \\\\ -1 & -2 & -1 & 3\\end{aligned}][\\begin{aligned}1 & -1 \\\\ 1 & -2 \\\\ 0 & -1 \\\\ 1 & 3\\end{aligned}])}^{-1}[\\begin{aligned}1 & 1 & 0 & 1 \\\\ -1 & -2 & -1 & 3\\end{aligned}][\\begin{aligned}1 \\\\ 0 \\\\ -1 \\\\ 0\\end{aligned}] \\\\  & ={[\\begin{aligned}3 & 0 \\\\ 0 & 15\\end{aligned}]}^{-1}[\\begin{aligned}1 & 1 & 0 & 1 \\\\ -1 & -2 & -1 & 3\\end{aligned}][\\begin{aligned}1 \\\\ 0 \\\\ -1 \\\\ 0\\end{aligned}] \\\\  & =\\frac{1}{45}[\\begin{aligned}15 & 0 \\\\ 0 & 3\\end{aligned}][\\begin{aligned}1 & 1 & 0 & 1 \\\\ -1 & -2 & -1 & 3\\end{aligned}][\\begin{aligned}1 \\\\ 0 \\\\ -1 \\\\ 0\\end{aligned}] \\\\  & =\\frac{1}{45}[\\begin{aligned}15 & 0 \\\\ 0 & 3\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{3} \\\\ 0\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-40887/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d23c4292-6fdd-5cba-a2e7-0f4d770b2309"] :knowledge-point/questions ["q-40887"] :db/ensure [:knowledge-point/validate]} {:db/id "q-85895/selection/6541d1d1fc8aaf93774f8148fdb45d662adae09e05a545abb6507d87b4df2daf" :answer/id #uuid "3bf32517-d0bc-5d98-a1b2-96fa0692da82" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 \\\\ 3 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-85895/selection/545fafa2a6764ed8f784554329ba2a8473e3451559e73a49d20e8ff56c7c9aab" :answer/id #uuid "a7543d53-10f1-5e13-9891-41f3e4abaf90" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ 2 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-85895/selection/def7c6281a0e80866fee0bf77c61c9b78bdbfb9c70b5303985ec5479695a24e7" :answer/id #uuid "1991fce0-4909-56bb-a60f-4624a1da7b37" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ 0 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-85895/selection/8ab2d564718dda90a10031af7cc039c9281d3c7edf3b84ecc8eb617f56dcc1e4" :answer/id #uuid "6322981b-006b-585f-8b0a-f890bad9a0fe" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ 0 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-85895/selection/d57ccc4eae5aeb057756a6fe4cc701b518afa2f44abaf635d3a31f45686d41b2" :answer/id #uuid "3cf05e3b-ea0c-538c-b1e8-d64b712dfada" :answer/type :answer.type/math :answer/value "[\\begin{aligned}12 \\\\ 0 \\\\ 12\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-85895/selection" :answer-field/id #uuid "ca91f94