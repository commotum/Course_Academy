ned}\\overset{^}{x} & =({A}^{T}\\,A)^{-1}{A}^{T}b \\\\  & ={([\\begin{aligned}2 & 2 & 2 & 2 \\\\ 0 & -4 & 0 & 4 \\\\ 4 & -2 & 0 & -2\\end{aligned}][\\begin{aligned}2 & 0 & 4 \\\\ 2 & -4 & -2 \\\\ 2 & 0 & 0 \\\\ 2 & 4 & -2\\end{aligned}])}^{-1}[\\begin{aligned}2 & 2 & 2 & 2 \\\\ 0 & -4 & 0 & 4 \\\\ 4 & -2 & 0 & -2\\end{aligned}][\\begin{aligned}12 \\\\ 0 \\\\ 0 \\\\ 12\\end{aligned}] \\\\  & ={[\\begin{aligned}16 & 0 & 0 \\\\ 0 & 32 & 0 \\\\ 0 & 0 & 24\\end{aligned}]}^{-1}[\\begin{aligned}48 \\\\ 48 \\\\ 24\\end{aligned}] \\\\  & =\\frac{1}{96}[\\begin{aligned}6 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 4\\end{aligned}][\\begin{aligned}48 \\\\ 48 \\\\ 24\\end{aligned}] \\\\  & =[\\begin{aligned}3 \\\\ \\frac{3}{2} \\\\ 1\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071086/state.json" "file_sha256" "8ccc60d69dd08c311625f4ceecf789c57e1c1ebd348a9f21dac24f4d63379501"} {"question" "q-85899" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071086/activity-metadata.json" "file_sha256" "edda5ea9539e588e535263dd2e2cb91d7e2ef42baf775b9d0202da49fd9a4f30"} {"question" "q-85899" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071086/state.json" "file_sha256" "8ccc60d69dd08c311625f4ceecf789c57e1c1ebd348a9f21dac24f4d63379501"} {"question" "q-85899" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}1 \\\\ \\frac{3}{2} \\\\ 3\\end{aligned}]"] ["math" "[\\begin{aligned}3 \\\\ 1 \\\\ \\frac{3}{2}\\end{aligned}]"] ["math" "[\\begin{aligned}3 \\\\ 2 \\\\ 1\\end{aligned}]"] ["math" "[\\begin{aligned}3 \\\\ \\frac{3}{2} \\\\ 1\\end