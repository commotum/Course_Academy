\\\\ 1 & -1 & -1 \\\\ 1 & 0 & 0 \\\\ 1 & 1 & -1\\end{aligned}])}^{-1}[\\begin{aligned}1 & 1 & 1 & 1 \\\\ 0 & -1 & 0 & 1 \\\\ 2 & -1 & 0 & -1\\end{aligned}][\\begin{aligned}6 \\\\ 0 \\\\ 6 \\\\ 0\\end{aligned}] \\\\  & ={[\\begin{aligned}4 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 6\\end{aligned}]}^{-1}[\\begin{aligned}12 \\\\ 0 \\\\ 12\\end{aligned}] \\\\  & =\\frac{1}{12}[\\begin{aligned}3 & 0 & 0 \\\\ 0 & 6 & 0 \\\\ 0 & 0 & 2\\end{aligned}][\\begin{aligned}12 \\\\ 0 \\\\ 12\\end{aligned}] \\\\  & =[\\begin{aligned}3 \\\\ 0 \\\\ 2\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071086/state.json" "file_sha256" "8ccc60d69dd08c311625f4ceecf789c57e1c1ebd348a9f21dac24f4d63379501"} {"question" "q-85895" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071086/activity-metadata.json" "file_sha256" "edda5ea9539e588e535263dd2e2cb91d7e2ef42baf775b9d0202da49fd9a4f30"} {"question" "q-85895" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071086/state.json" "file_sha256" "8ccc60d69dd08c311625f4ceecf789c57e1c1ebd348a9f21dac24f4d63379501"} {"question" "q-85895" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}0 \\\\ 3 \\\\ 2\\end{aligned}]"] ["math" "[\\begin{aligned}12 \\\\ 0 \\\\ 12\\end{aligned}]"] ["math" "[\\begin{aligned}2 \\\\ 0 \\\\ 3\\end{aligned}]"] ["math" "[\\begin{aligned}3 \\\\ 0 \\\\ 2\\end{aligned}]"] ["math" "[\\begin{aligned}3 \\\\ 2 \\\\ 0\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071086/state.json