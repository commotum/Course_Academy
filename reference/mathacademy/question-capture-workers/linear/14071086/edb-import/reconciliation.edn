} \\\\ {x}_{3}\\end{aligned}]}} & =\\overset{b}{\\overset{⏞}{[\\begin{aligned}18 \\\\ 0 \\\\ 18 \\\\ 0\\end{aligned}]}}\\end{aligned}\n$$\n\nWe can find the least-squares solution $\\overset{^}{x}$ of the equation above by solving the corresponding normal equation, which we obtain by left-multiplying our original equation by ${A}^{T}:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A\\overset{^}{x} & ={A}^{T}b\\end{aligned}\n$$\n\nSince the columns of $A$ are linearly independent, the matrix ${A}^{T}\\,A$ is invertible. Therefore, multiplying by $({A}^{T}\\,A)^{-1}$ on the left, we obtain\n\n$$\n\\begin{aligned}\\overset{^}{x} & =({A}^{T}\\,A)^{-1}{A}^{T}b \\\\  & ={([\\begin{aligned}1 & 1 & 1 & 1 \\\\ 2 & -3 & 2 & -1 \\\\ 1 & 0 & -1 & 0\\end{aligned}][\\begin{aligned}1 & 2 & 1 \\\\ 1 & -3 & 0 \\\\ 1 & 2 & -1 \\\\ 1 & -1 & 0\\end{aligned}])}^{-1}\\,\\,[\\begin{aligned}1 & 1 & 1 & 1 \\\\ 2 & -3 & 2 & -1 \\\\ 1 & 0 & -1 & 0\\end{aligned}][\\begin{aligned}18 \\\\ 0 \\\\ 18 \\\\ 0\\end{aligned}] \\\\  & ={[\\begin{aligned}4 & 0 & 0 \\\\ 0 & 18 & 0 \\\\ 0 & 0 & 2\\end{aligned}]}^{-1}[\\begin{aligned}36 \\\\ 72 \\\\ 0\\end{aligned}] \\\\  & =\\frac{1}{36}[\\begin{aligned}9 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 18\\end{aligned}][\\begin{aligned}36 \\\\ 72 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}9 \\\\ 4 \\\\ 0\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071086/state.json" "file_sha256" "8ccc60d69dd08c311625f4ceecf789c57e1c1ebd348a9f21dac24f4d63379501"} {"question" "q-41775" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071086/activity-metadata.json" "file_sha256" "edda5ea9539e588e535263dd2e2cb91d7e2ef42baf775b9d0202da49fd9a4f30"} {"question" "q-41775" "field" "selection" "attribute" "answer-field/type" "value