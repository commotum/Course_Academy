1/6b9b7ce9df843cb9f4c36d46291d40e6a7f33e2555dffd7986cc2abb51a4e2e1/be5beffd9a95134974e6bda496907ef99198947107984fe7477f4a7dcf5134a9"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-93700"] :question/problem "Which of the following could be matrices of quadratic forms defined on ${R}^{2}?$\n\n$$\nP=[\\begin{aligned}-5 & 3 \\\\ 3 & 0\\end{aligned}],\\,Q=[\\begin{aligned}1 & -2 & 7 \\\\ -2 & 1 & -1 \\\\ 7 & -1 & 9\\end{aligned}],\\,R=[\\begin{aligned}0 & 3 \\\\ 0 & 0\\end{aligned}]\n$$" :question/worked-solution "Recall that every quadratic form defined on ${R}^{2}$ has an associated $2\\times 2$ symmetric matrix.\n\nWith that in mind, let's examine each matrix in turn.\n\n- $P$ could be a matrix of a quadratic form defined on ${R}^{2}$ since it is a $2\\times 2$ symmetric matrix.\n\n- $Q$ *cannot* be a matrix of a quadratic form defined on ${R}^{2}$ since it's a $3\\times 3$ matrix (not $2\\times 2$).\n\n- $R$ *cannot* be a matrix of a quadratic form defined on ${R}^{2}.$ Although it's a $2\\times 2$ matrix, $R$ is not symmetric since ${r}_{12}\\ne {r}_{21}.$\n\nTherefore, the correct answer is \"$P$ only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-93700/selection/ma-v1/6b9b7ce9df843cb9f4c36d46291d40e6a7f33e2555dffd7986cc2abb51a4e2e1"] :db/ensure [:question/validate]} {:db/id "q-94063/selection/7dac0ad80ece25ffc25e933add4a53b1577f76de4cc80d106d927934a5c71ea3" :answer/id #uuid "587071b7-73b8-5ff7-b25a-1803557bbf24" :answer/type :answer.type/text :answer/value "$E$ only" :db/ensure [:answer/validate]} {:db/id "q-94063/selection/5eaaedc1920d4a83ef5a62370e247bd8c483a4fa6f40a6c2bc1289a9fe8f4aed" :answer/id #uuid "c557f540-6a99-56b2-93fc-ef96b910ee2a" :answer/type :answer.type/text :answer/value "$F$ only" :db/ensure [:answer/validate]} {:db/id "q-94063/selection/88555631188e6ed26911b748b6c62c4fd93b36ae2fff3b61e6ec18f6420f88ed" :answer/id #uuid "be82801d-6d79-5b21-bd7f-c66c8e2ea35a" :answer/type :answer.type/tex