 :db/id #edb/ref 17592186160750} :answer-field/id #uuid "1b5ed7ae-7ac7-5043-814d-c93fd8266116" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186160746}] :question/id #uuid "2b88a995-140a-54a3-a483-210a7791965f" :question/math-academy-id "q-93703" :question/problem "Consider the quadratic form\n\n$Q(x) = x_{1}^{2} - 3x_{1}x_{3} - x_{2}x_{3} + x_{3}^{2}$.\nEvaluate $Q(x)$ when $x = \\begin{bmatrix}1 \\\\ 0 \\\\ -4\\end{bmatrix}$."}]}
