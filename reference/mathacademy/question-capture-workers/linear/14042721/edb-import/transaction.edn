5b8ca6b5e00bed2400fcef699"] :db/ensure [:answer-field/validate]} {:db/id "q-70818" :question/id #uuid "73c1d5d9-6a23-5438-8d9f-6779511254e9" :question/math-academy-id "q-70818" :question/problem "Given the Cartesian equation $2x+y-2z-4=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨2,1,-2⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $z$:\n\n$$\n\\begin{aligned}2x+y-2z-4 & =0 \\\\ -2z & =-2x-y+4 \\\\ z & =x+\\frac{1}{2}y-2.\\end{aligned}\n$$\n\nIf we put, say, $x=0$ and $y=0$, we get $z=-2.$ Hence, the point $P(0,0,-2)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,0,-2⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,0,-2⟩)\\cdot ⟨2,1,-2⟩ & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-70818/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "80c443e5-a0b2-5aae-ac8d-27449a8049a3"] :knowledge-point/questions ["q-70818"] :db/ensure [:knowledge-point/validate]} {:db/id "q-336229/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "044a9694-62fb-5f03-8007-970f514bf767" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-336229/field-1" :answer-field/id #uuid "04a6c207-05a6-5228-b400-733381a15420" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336229/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-336229/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-336229/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "f62607d4-1442-5ef9-8b7a-3bd2c7ec9f04" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-336229/field-2" :answer-field/id #uuid "9961ae62-52ea-5336-adfe-57d9aa50bc17" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336229/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-336229/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-336229/field-3/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "5670ab7c-e406-5031-bf38-072fdd15f96d" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-336229/field-3" :answer-field/id #uuid "a54b7b95-0b84-533f-8468-da8c58bb569c" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336229/field-3/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-336229/field-3/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-336229" :question/id #uuid "c44c8817-42e9-5666-a2ac-7eba0ad11be5" :question/math-academy-id "q-336229" :question/problem "Given the Cartesian equation $5x+2z-8=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$\n\n$(r-⟨0,0,$\n{{field-1}}\n$⟩)\\cdot ⟨5,$\n{{field-2}}\n,\n{{field-3}}\n$⟩=0$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨5,0,2⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $z$:\n\n$$\n\\begin{aligned}5x+2z-8 & =0 \\\\ z & =-\\frac{5}{2}x+4\\end{aligned}\n$$\n\nIf we put, say, $x=0,$ we get $z=4.$ Hence, the point $P(0,0,4)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,0,4⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,0,4⟩)\\cdot ⟨5,0,2⟩ & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-336229/field-1" "q-336229/field-2" "q-336229/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "80c443e5-a0b2-5aae-ac8d-27449a8049a3"] :knowledge-point/questions ["q-336229"] :db/ensure [:knowledge-point/validate]} {:db/id "q-336241/field-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "a7e21967-6d1b-5c5c-8d31-3e14d78c0047" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-336241/field-1" :answer-field/id #uuid "e03294cd-3a6c-57c1-aca2-77be95811ea9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336241/field-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer-field/choices ["q-336241/field-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133"] :db/ensure [:answer-field/validate]} {:db/id "q-336241/field-2/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "8b0a80e6-a672-5e23-b77e-27278611a956" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-336241/field-2" :answer-field/id #uuid "364f4454-90b1-58d8-a274-8823b7080b0d" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336241/field-2/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer-field/choices ["q-336241/field-2/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97"] :db/ensure [:answer-field/validate]} {:db/id "q-336241/field-3/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "437a35b5-91c8-514a-a1c3-04b4cc566eaa" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-336241/field-3" :answer-field/id #uuid "7570e8b2-5387-5f5f-96df-c85bb817b2eb" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336241/field-3/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer-field/choices ["q-336241/field-3/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c"] :db/ensure [:answer-field/validate]} {:db/id "q-336241" :question/id #uuid "65948fec-f588-54c4-b605-f521e0f23300" :question/math-academy-id "q-336241" :question/problem "Given the Cartesian equation $12y-6z-30=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$\n\n$(r-⟨0,0,$\n{{field-1}}\n$⟩)\\cdot ⟨0,$\n{{field-2}}\n,\n{{field-3}}\n$⟩=0$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨0,12,-6⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $z$:\n\n$$\n\\begin{aligned}12y-6z-30 & =0 \\\\ -6z & =-12y+30 \\\\ z & =2y-5\\end{aligned}\n$$\n\nIf we put, say, $y=0$, we get $z=-5.$ Hence, the point $P(0,0,-5)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,0,-5⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,0,-5⟩)\\cdot ⟨0,12,-6⟩ & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-336241/field-1" "q-336241/field-2" "q-336241/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "80c443e5-a0b2-5aae-ac8d-27449a8049a3"] :knowledge-point/questions ["q-336241"] :db/ensure [:knowledge-point/validate]} {:db/id "q-33913/selection/45d4f7bc70bf52a14b7b59a0d9eff5bb8278a5b642c6103b9d8e56f9ee273961" :answer/id #uuid "8e65e2a5-4979-5ab2-9acf-68f15e9f61d9" :answer/type :answer.type/math :answer/value "5x-y-2z-4=0" :db/ensure [:answer/validate]} {:db/id "q-33913/selection/b90495ebeef201c114afc91bfedf21b3581448e14a599c349e226a56f386a413" :answer/id #uuid "8b1ba502-ab3e-5eae-8458-38a8e266b715" :answer/type :answer.type/math :answer/value "x-y-4=0" :db/ensure [:answer/validate]} {:db/id "q-33913/selection/4ee6fd13e069577f69e09a4ce966920588b71116f25384fa1d6c3d12e371dc91" :answer/id #uuid "38dffdf1-e644-5aaa-b63e-e6af6c9fd7f4" :answer/type :answer.type/math :answer/value "2x+3z-4=0" :db/ensure [:answer/validate]} {:db/id "q-33913/selection/5823df5f4b524c61a33af228d4a946ed78215e4824850bf8b5901ca26de8fd03" :answer/id #uuid "41f418f9-fa65-521c-86aa-8bdf00e2e80a" :answer/type :answer.type/math :answer/value "5x-y-2z=0" :db/ensure [:answer/validate]} {:db/id "q-33913/selection/f88601ec12ad2e2f508f14babd6aefc2bfb79481463acc337c7d3fd71c3e170b" :answer/id #uuid "43158893-8356-5c63-8f19-44104e38a3c1" :answer/type :answer.type/math :answer/value "x-y+z+4=0" :db/ensure [:answer/validate]} {:db/id "q-33913/selection" :answer-field/id #uuid "62c73c61-084f-598f-9a26-388093e5eff2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-33913/selection/45d4f7bc70bf52a14b7b59a0d9eff5bb8278a5b642c6103b9d8e56f9ee273961" :answer-field/choices ["q-33913/selection/45d4f7bc70bf52a14b7b59a0d9eff5bb8278a5b642c6103b9d8e56f9ee273961" "q-33913/selection/b90495ebeef201c114afc91bfedf21b3581448e14a599c349e226a56f386a413" "q-33913/selection/4ee6fd13e069577f69e09a4ce966920588b71116f25384fa1d6c3d12e371dc91" "q-33913/selection/5823df5f4b524c61a33af228d4a946ed78215e4824850bf8b5901ca26de8fd03" "q-33913/selection/f88601ec12ad2e2f508f14babd6aefc2bfb79481463acc337c7d3fd71c3e170b"] :db/ensure [:answer-field/validate]} {:db/id "q-33913" :question/id #uuid "08692043-b7cd-55e2-b86c-6bc1b3ef2402" :question/math-academy-id "q-33913" :question/problem "Find a Cartesian equation of the plane that passes through the points $A(1,-1,1)$, $P(2,0,3)$ and $Q(1,1,0).$" :question/worked-solution "Note that the position vectors of the points $A,P$ and $Q$ are $a=⟨1,-1,1⟩,\\,p=⟨2,0,3⟩,$ and $q=⟨1,1,0⟩.$\n\nFirst, using the $3$ points we build $2$ vectors parallel to the plane:\n\n$$\n\\begin{aligned}{v}_{1} & =\\overset{\\to }{AP} \\\\  & =⟨2,0,3⟩-⟨1,-1,1⟩ \\\\  & =⟨1,1,2⟩ \\\\ {v}_{2} & =\\overset{\\to }{AQ} \\\\  & =⟨1,1,0⟩-⟨1,-1,1⟩ \\\\  & =⟨0,2,-1⟩\\end{aligned}\n$$\n\n \n\nNow, we need to find the normal vector of the plane. To do that, we use the cross product of ${v}_{1}$ and ${v}_{2}$ as follows:\n\n$$\n\\begin{aligned}n & ={v}_{1}\\times {v}_{2} \\\\  & =[\\begin{aligned}1 \\\\ 1 \\\\ 2\\end{aligned}]\\times [\\begin{aligned}0 \\\\ 2 \\\\ -1\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 1 & 1 & 2 \\\\ 0 & 2 & -1\\end{aligned}\\right| \\\\  & =-5i+j+2k \\\\  & =⟨-5,1,2⟩\\end{aligned}\n$$\n\nThen, using the dot product, we can find the equation of the plane:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-5,1,2⟩ & =⟨2,0,3⟩\\cdot ⟨-5,1,2⟩ \\\\ r\\cdot ⟨-5,1,2⟩ & =-4\\end{aligned}\n$$\n\nFinally, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-5,1,2⟩ & =-4 \\\\ -5x+y+2z & =-4 \\\\ -5x+y+2z+4 & =0 \\\\ 5x-y-2z-4 & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-33913/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0efe5b11-2c87-58e9-bf7c-e1eecb07adf2"] :knowledge-point/questions ["q-33913"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-33912"] :question/problem "Find a Cartesian equation of the plane that passes through the point $P(1,0,3)$ and is parallel to the vectors ${v}_{1}=⟨5,2,1⟩$ and ${v}_{2}=⟨0,3,3⟩.$" :question/worked-solution "First, we note that the position vector of the point $P$ is $p=⟨1,0,3⟩.$\n\nNow, we need to find the normal vector of the plane. To do that, we use the cross product of ${v}_{1}$ and ${v}_{2}$ as follows:\n\n$$\n\\begin{aligned}n & ={v}_{1}\\times {v}_{2} \\\\  & =[\\begin{aligned}5 \\\\ 2 \\\\ 1\\end{aligned}]\\times [\\begin{aligned}0 \\\\ 3 \\\\ 3\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 5 & 2 & 1 \\\\ 0 & 3 & 3\\end{aligned}\\right| \\\\  & =3i-15j+15k \\\\  & =⟨3,-15,15⟩\\end{aligned}\n$$\n\nThen, using the dot product, we can find the equation of the plane:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨3,-15,15⟩ & =⟨1,0,3⟩\\cdot ⟨3,-15,15⟩ \\\\ r\\cdot ⟨3,-15,15⟩ & =48\\end{aligned}\n$$\n\nFinally, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨3,-15,15⟩ & =48 \\\\ 3x-15y+15z & =48 \\\\ 3x-15y+15z-48 & =0 \\\\ x-5y+5z-16 & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-336384/field-1/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "0f761c95-9f32-5612-9e67-fa0df18faa72" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-336384/field-1" :answer-field/id #uuid "ab4131f0-8a86-5a6d-9a7a-9c289d4385df" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336384/field-1/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer-field/choices ["q-336384/field-1/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc"] :db/ensure [:answer-field/validate]} {:db/id "q-336384/field-2/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "3b52ffa4-2203-571f-bd8f-3a50604af33a" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-336384/field-2" :answer-field/id #uuid "4a0c38fd-9fd4-586f-8f30-60515009bbae" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336384/field-2/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-336384/field-2/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-336384/field-3/ac46d580a95a8fc03d1a7cb07de70e107b73fba6bf1bc1d13103b84eff3df012" :answer/id #uuid "e8280fec-4a53-5c0b-bb76-2e7f9a245174" :answer/type :answer.type/math :answer/value "17" :db/ensure [:answer/validate]} {:db/id "q-336384/field-3" :answer-field/id #uuid "7741f7f0-ea69-5bb6-a42d-31ee48de0e0b" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336384/field-3/ac46d580a95a8fc03d1a7cb07de70e107b73fba6bf1bc1d13103b84eff3df012" :answer-field/choices ["q-336384/field-3/ac46d580a95a8fc03d1a7cb07de70e107b73fba6bf1bc1d13103b84eff3df012"] :db/ensure [:answer-field/validate]} {:db/id "q-336384" :question/id #uuid "ab26089b-6055-52a7-add7-60a0d368cfd0" :question/math-academy-id "q-336384" :question/problem "Find a Cartesian equation of the plane that passes through the points $A(2,-2,1)$, $P(5,0,3)$ and $Q(1,1,-1).$\n\n{{field-1}}\n$x\\,-$\n{{field-2}}\n$y\\,-\\,11z\\,-$\n{{field-3}}\n$=0$" :question/worked-solution "Note that the position vectors of the points $A,P$ and $Q$ are $a=⟨2,-2,1⟩,\\,p=⟨5,0,3⟩,$ and $q=⟨1,1,-1⟩.$\n\nFirst, using the $3$ points we build $2$ vectors parallel to the plane:\n\n$$\n\\begin{aligned}{v}_{1} & =\\overset{\\to }{AP} \\\\  & =⟨5,0,3⟩-⟨2,-2,1⟩ \\\\  & =⟨3,2,2⟩ \\\\ {v}_{2} & =\\overset{\\to }{AQ} \\\\  & =⟨1,1,-1⟩-⟨2,-2,1⟩ \\\\  & =⟨-1,3,-2⟩\\end{aligned}\n$$\n\n \n\nNow,  we need to find the normal vector of the plane. To do that, we use the cross product of ${v}_{1}$ and ${v}_{2}$ as follows:\n\n$$\n\\begin{aligned}n & ={v}_{1}\\times {v}_{2} \\\\  & =[\\begin{aligned}3 \\\\ 2 \\\\ 2\\end{aligned}]\\times [\\begin{aligned}-1 \\\\ 3 \\\\ -2\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 3 & 2 & 2 \\\\ -1 & 3 & -2\\end{aligned}\\right| \\\\  & =-10i+4j+11k \\\\  & =⟨-10,4,11⟩\\end{aligned}\n$$\n\nThen, using the dot product, we can find the equation of the plane:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-10,4,11⟩ & =⟨5,0,3⟩\\cdot ⟨-10,4,11⟩ \\\\ r\\cdot ⟨-10,4,11⟩ & =-17\\end{aligned}\n$$\n\nFinally, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-10,4,11⟩ & =-17 \\\\ -10x+4y+11z & =-17 \\\\ 10x-4y-11z & =17 \\\\ 10x-4y-11z-17 & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-336384/field-1" "q-336384/field-2" "q-336384/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0efe5b11-2c87-58e9-bf7c-e1eecb07adf2"] :knowledge-point/questions ["q-336384"] :db/ensure [:knowledge-point/validate]} {:db/id "q-128462/selection/28fa385e1ac8435e111992163429941ad6bba044747291fa1f992be20b9741e9" :answer/id #uuid "e7578732-1ace-5b8a-8787-a9fafc50a085" :answer/type :answer.type/math :answer/value "4x-2y+6z+21=0" :db/ensure [:answer/validate]} {:db/id "q-128462/selection/e246cb374951f24f684f32a3aef62cd0bebe01f939a12be1967adaa7e5c63d5e" :answer/id #uuid "743c7d2e-4f2c-54de-98d2-fde03125c7eb" :answer/type :answer.type/math :answer/value "4x-6y-2z+17=0" :db/ensure [:answer/validate]} {:db/id "q-128462/selection/2529a43b6ee340861271266277c725f9f6eccb546fa64ca1937fa669380867c5" :answer/id #uuid "cb6deb97-f107-513f-bf32-dc40eb368827" :answer/type :answer.type/math :answer/value "2x-4y-6z+13=0" :db/ensure [:answer/validate]} {:db/id "q-128462/selection/55df48881baeee4e5f8e93071f049f23f67929fc01cb57d4fe399b802db3867d" :answer/id #uuid "022a6212-0f64-54db-b3d3-2da1d509da81" :answer/type :answer.type/math :answer/value "4x-6y-2z+7=0" :db/ensure [:answer/validate]} {:db/id "q-128462/selection/4c73f3d04b60822e53279c270fcd0514ba1756d29af275e424154296701a2bab" :answer/id #uuid "3760cdfe-ae3b-5f58-9fd1-75cc52efa930" :answer/type :answer.type/math :answer/value "4x-2y-6z+10=0" :db/ensure [:answer/validate]} {:db/id "q-128462/selection" :answer-field/id #uuid "bb782205-3c0e-5252-aaed-f4e705886e25" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-128462/selection/4c73f3d04b60822e53279c270fcd0514ba1756d29af275e424154296701a2bab" :answer-field/choices ["q-128462/selection/28fa385e1ac8435e111992163429941ad6bba044747291fa1f992be20b9741e9" "q-128462/selection/e246cb374951f24f684f32a3aef62cd0bebe01f939a12be1967adaa7e5c63d5e" "q-128462/selection/2529a43b6ee340861271266277c725f9f6eccb546fa64ca1937fa669380867c5" "q-128462/selection/55df48881baeee4e5f8e93071f049f23f67929fc01cb57d4fe399b802db3867d" "q-128462/selection/4c73f3d04b60822e53279c270fcd0514ba1756d29af275e424154296701a2bab"] :db/ensure [:answer-field/validate]} {:db/id "q-128462" :question/id #uuid "47e868ac-1a14-516c-8ec1-ee1245087be0" :question/math-academy-id "q-128462" :question/problem "Find a Cartesian equation of the plane that passes through the points $A(1,-2,3)$, $P(3,-1,4)$ and $Q(-1,0,1).$" :question/worked-solution "Note that the position vectors of the points $A,P$ and $Q$ are $a=⟨1,-2,3⟩,\\,p=⟨3,-1,4⟩,$ and $q=⟨-1,0,1⟩.$\n\nFirst, using the $3$ points we build $2$ vectors parallel to the plane:\n\n$$\n\\begin{aligned}{v}_{1} & =\\overset{\\to }{AP} \\\\  & =⟨3,-1,4⟩-⟨1,-2,3⟩ \\\\  & =⟨2,1,1⟩ \\\\ {v}_{2} & =\\overset{\\to }{AQ} \\\\  & =⟨-1,0,1⟩-⟨1,-2,3⟩ \\\\  & =⟨-2,2,-2⟩\\end{aligned}\n$$\n\n \n\nNow,  we need to find the normal vector of the plane. To do that, we use the cross product of ${v}_{1}$ and ${v}_{2}$ as follows:\n\n$$\n\\begin{aligned}n & ={v}_{1}\\times {v}_{2} \\\\  & =[\\begin{aligned}2 \\\\ 1 \\\\ 1\\end{aligned}]\\times [\\begin{aligned}-2 \\\\ 2 \\\\ -2\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 2 & 1 & 1 \\\\ -2 & 2 & -2\\end{aligned}\\right| \\\\  & =-4i+2j+6k \\\\  & =⟨-4,2,6⟩\\end{aligned}\n$$\n\nThen, using the dot product, we can find the equation of the plane:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-4,2,6⟩ & =⟨3,-1,4⟩\\cdot ⟨-4,2,6⟩ \\\\ r\\cdot ⟨-4,2,6⟩ & =10\\end{aligned}\n$$\n\nFinally, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-4,2,6⟩ & =10 \\\\ -4x+2y+6z & =10 \\\\ -4x+2y+6z-10 & =0 \\\\ 4x-2y-6z+10 & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-128462/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0efe5b11-2c87-58e9-bf7c-e1eecb07adf2"] :knowledge-point/questions ["q-128462"] :db/ensure [:knowledge-point/validate]} {:db/id "q-336381/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "9ad3710d-d21c-504c-9c3a-237bbcf5f839" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-336381/field-1" :answer-field/id #uuid "730de4bb-eef3-50b3-bc8f-e7c6ffcb28be" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336381/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-336381/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-336381" :question/id #uuid "3f2ff546-7761-5f3a-872c-3eb0b39a7e47" :question/math-academy-id "q-336381" :question/problem "Find a Cartesian equation of the plane that passes through the points $A(1,1,-1)$, $P(3,4,2)$ and $Q(-1,2,0).$\n\n$\\,y\\,-\\,z\\,-$\n{{field-1}}\n$=0$" :question/worked-solution "Note that the position vectors of the points $A,P$ and $Q$ are $a=⟨1,1,-1⟩,\\,p=⟨3,4,2⟩,$ and $q=⟨-1,2,0⟩.$\n\nFirst, using the $3$ points we build $2$ vectors parallel to the plane:\n\n$$\n\\begin{aligned}{v}_{1} & =\\overset{\\to }{AP} \\\\  & =⟨3,4,2⟩-⟨1,1,-1⟩ \\\\  & =⟨2,3,3⟩ \\\\ {v}_{2} & =\\overset{\\to }{AQ} \\\\  & =⟨-1,2,0⟩-⟨1,1,-1⟩ \\\\  & =⟨-2,1,1⟩\\end{aligned}\n$$\n\n \n\nNow,  we need to find the normal vector of the plane. To do that, we use the cross product of ${v}_{1}$ and ${v}_{2}$ as follows:\n\n$$\n\\begin{aligned}n & ={v}_{1}\\times {v}_{2} \\\\  & =[\\begin{aligned}2 \\\\ 3 \\\\ 3\\end{aligned}]\\times [\\begin{aligned}-2 \\\\ 1 \\\\ 1\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 2 & 3 & 3 \\\\ -2 & 1 & 1\\end{aligned}\\right| \\\\  & =0i-8j+8k \\\\  & =⟨0,-8,8⟩\\end{aligned}\n$$\n\nThen, using the dot product, we can find the equation of the plane:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨0,-8,8⟩ & =⟨3,4,2⟩\\cdot ⟨0,-8,8⟩ \\\\ r\\cdot ⟨0,-8,8⟩ & =-16\\end{aligned}\n$$\n\nFinally, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨0,-8,8⟩ & =-16 \\\\ -8y+8z & =-16 \\\\ -8y+8z+16 & =0 \\\\ y-z-2 & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-336381/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0efe5b11-2c87-58e9-bf7c-e1eecb07adf2"] :knowledge-point/questions ["q-336381"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-4936"] :question/problem "Find a Cartesian equation of the plane that passes through the point $P(9,-2,3)$ and is perpendicular to the vector $\\mathbf{n}=3\\mathbf{i}-4\\mathbf{j}+7\\mathbf{k}.$" :question/worked-solution "First, we note that the position vector of the point $P$ is $\\mathbf{p}=\\langle 9,-2,3 \\rangle$ and the normal vector of the plane is $\\mathbf{n}=\\langle 3,-4,7 \\rangle.$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨3,-4,7⟩ & =⟨9,-2,3⟩\\cdot ⟨3,-4,7⟩ \\\\ r\\cdot ⟨3,-4,7⟩ & =56.\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $\\mathbf{r}=\\langle x,y,z \\rangle$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨3,-4,7⟩ & =56 \\\\ 3x-4y+7z & =56 \\\\ 3x-4y+7z-56 & =0.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4937"] :question/problem "Find a Cartesian equation of the plane that passes through the point $P(-1,4,8)$ and is perpendicular to the line \n$\\dfrac{x+3}{-5}=\\dfrac{y-1}{3}=\\dfrac{z+2}{2}.$" :question/worked-solution "First, we note that the position vector of $P$ is $\\mathbf{p}=\\langle -1,4,8 \\rangle.$ From the canonical equation, we find that the line is parallel to the vector $\\langle -5,3,2 \\rangle.$ So, the normal vector of the plane is \n\n$$\n\\mathbf{n}=\\langle -5,3,2 \\rangle.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-5,3,2⟩ & =⟨-1,4,8⟩\\cdot ⟨-5,3,2⟩ \\\\ r\\cdot ⟨-5,3,2⟩ & =33\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $\\mathbf{r}=\\langle x,y,z \\rangle$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-5,3,2⟩ & =33 \\\\ -5x+3y+2z & =33 \\\\ -5x+3y+2z-33 & =0.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4938"] :question/problem "Given the Cartesian equation $2x-y+z+13=0$ of the plane $\\Pi,$ find an equation of $\\Pi$ in the form $(\\mathbf{r}-\\mathbf{p})\\cdot\\mathbf{n}=0.$" :question/worked-solution "First, from the coefficients in equation of the plane, we get that the normal vector of $\\Pi$ is $\\mathbf{n}=\\langle 2,-1,1 \\rangle.$\n\nNow, we solve the Cartesian equation of $\\Pi$ for $z\\mathbin{:}$\n\n$$\n\\begin{aligned}2x-y+z+13 & =0 \\\\ z & =-2x+y-13\\end{aligned}\n$$\n\nIf we put, say, $x=0$ and $y=0,$ we get $z=-13.$ So, the point $P(0,0,-13)$ lies on $\\Pi.$ Note that the position vector of $P$ is $\\mathbf{p}=\\langle 0,0,-13 \\rangle.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,0,-13⟩)\\cdot ⟨2,-1,1⟩ & =0.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4939"] :question/problem "Find a Cartesian equation of the plane that passes through the point $P(-3,2,-6)$ and is parallel to the vectors $\\mathbf{v_1}=\\langle -3, 5, 2 \\rangle$ and $\\mathbf{v_2}=\\langle 1, 3, -2 \\rangle.$" :question/worked-solution "First, we note that the position vector of the point $P$ is $\\mathbf{p}=\\langle -3,2,-6 \\rangle.$\n\nNow, we need to find the normal vector of the plane. To do that, we use the cross product of $\\mathbf{v_1}$ and $\\mathbf{v_2}$ as follows:\n\n$$\n\\begin{aligned}n & ={v}_{1}\\times {v}_{2} \\\\  & =[\\begin{aligned}-3 \\\\ 5 \\\\ 2\\end{aligned}]\\times [\\begin{aligned}1 \\\\ 3 \\\\ -2\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ -3 & 5 & 2 \\\\ 1 & 3 & -2\\end{aligned}\\right| \\\\  & =-16i-4j-14k \\\\  & =⟨-16,-4,-14⟩\\end{aligned}\n$$\n\nThen, using the dot product, we can find the equation of the plane:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-16,-4,-14⟩ & =⟨-3,2,-6⟩\\cdot ⟨-16,-4,-14⟩ \\\\ r\\cdot ⟨-16,-4,-14⟩ & =124\\end{aligned}\n$$\n\nFinally, to obtain the Cartesian equation of the plane, we substitute $\\mathbf{r}=\\langle x,y,z \\rangle$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-16,-4,-14⟩ & =124 \\\\ -16x-4y-14z & =124 \\\\ -16x-4y-14z-124 & =0 \\\\ 8x+2y+7z+62 & =0.\\end{aligned}\n$$" :db/ensure [:question/validate]}]
