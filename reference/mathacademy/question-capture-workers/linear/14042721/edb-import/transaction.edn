1⟩ & =7.\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨3,4,-1⟩ & =7 \\\\ 3x+4y-z & =7 \\\\ 3x+4y-z-7 & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-127967/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b34272b7-a7ad-5a58-974e-54cca957d06e"] :knowledge-point/questions ["q-127967"] :db/ensure [:knowledge-point/validate]} {:db/id "q-33164/selection/4d79a17b742794a399bc411ab670774d495be038662034514087aee2728adaf6" :answer/id #uuid "a9b75b5f-06ee-5229-8e16-27c73bbdf60b" :answer/type :answer.type/math :answer/value "2x+5y-8z-7=0" :db/ensure [:answer/validate]} {:db/id "q-33164/selection/84aeea45d4f76098516228abc1fe45bf26aa81d522f75ae20113cfabef79f6b5" :answer/id #uuid "5c8b9fc7-a2d6-502a-8201-e30feb601861" :answer/type :answer.type/math :answer/value "2x+5y-8z-1=0" :db/ensure [:answer/validate]} {:db/id "q-33164/selection/8d3d781d85aacb1ced9c8a1ed54bb82abd057ffa7157dcc227e2190a0fca233c" :answer/id #uuid "753bf9d6-d048-51d8-87d2-f52594ed23a9" :answer/type :answer.type/math :answer/value "-4x+3y+z+7=0" :db/ensure [:answer/validate]} {:db/id "q-33164/selection/fa13fb1fe585ee5cfba7e1e9bb89dfc3966e9c32740256ddbf8c8580fd9779a3" :answer/id #uuid "c73653b0-5c36-5497-8312-db686249b3ec" :answer/type :answer.type/math :answer/value "-4x+3y-7=0" :db/ensure [:answer/validate]} {:db/id "q-33164/selection/d056be9d8899ebb297133bb234e4731251e66d38c958605199d1b78032263e6b" :answer/id #uuid "484e48bc-60cc-51d2-9492-301c5ddf8787" :answer/type :answer.type/math :answer/value "2x+5y-8z-17=0" :db/ensure [:answer/validate]} {:db/id "q-33164/selection" :answer-field/id #uuid "094797d8-27a1-513d-842a-71a70b6bd1ed" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-33164/selection/4d79a17b742794a399bc411ab670774d495be038662034514087aee2728adaf6" :answer-field/choices ["q-33164/selection/4d79a17b742794a399bc411ab670774d495be038662034514087aee2728adaf6" "q-33164/selection/84aeea45d4f76098516228abc1fe45bf26aa81d522f75ae20113cfabef79f6b5" "q-33164/selection/8d3d781d85aacb1ced9c8a1ed54bb82abd057ffa7157dcc227e2190a0fca233c" "q-33164/selection/fa13fb1fe585ee5cfba7e1e9bb89dfc3966e9c32740256ddbf8c8580fd9779a3" "q-33164/selection/d056be9d8899ebb297133bb234e4731251e66d38c958605199d1b78032263e6b"] :db/ensure [:answer-field/validate]} {:db/id "q-33164" :question/id #uuid "f2d89667-fd21-5f9c-8885-bbfc06a5277b" :question/math-academy-id "q-33164" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(-4,3,0)$ and is perpendicular to the vector $n=2i+5j-8k.$" :question/worked-solution "First, we note that the position vector of the point $P$ is $p=⟨-4,3,0⟩$ and the normal vector of the plane is $n=⟨2,5,-8⟩.$\n\nUsing the dot product we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨2,5,-8⟩ & =⟨-4,3,0⟩\\cdot ⟨2,5,-8⟩ \\\\ r\\cdot ⟨2,5,-8⟩ & =7.\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨2,5,-8⟩ & =7 \\\\ 2x+5y-8z & =7 \\\\ 2x+5y-8z-7 & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-33164/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b34272b7-a7ad-5a58-974e-54cca957d06e"] :knowledge-point/questions ["q-33164"] :db/ensure [:knowledge-point/validate]} {:db/id "q-336540/selection/12b65e3ef61061d0e1ffa677eae710d0aeb5756a73adef2d8962481cb2dce31d" :answer/id #uuid "8a2f592a-f2ae-5741-8d47-7969dbee99b8" :answer/type :answer.type/math :answer/value "x+4y-2z+13=0" :db/ensure [:answer/validate]} {:db/id "q-336540/selection/78005428e94a396e6da924c6bd959d88a2a0ad94815972f517c1f85a1e8fe4d3" :answer/id #uuid "be4bd53d-fa87-5296-9a6e-87f6fbc468e0" :answer/type :answer.type/math :answer/value "x-4y+z+14=0" :db/ensure [:answer/validate]} {:db/id "q-336540/selection/97cb1785faa48d1a5e1a6fec600151d7ab612300429108afc62bc6995fe97602" :answer/id #uuid "725e3432-c3d0-5d91-a7ce-4c07a9ca263d" :answer/type :answer.type/math :answer/value "x+4y+14=0" :db/ensure [:answer/validate]} {:db/id "q-336540/selection/5268f396a93a558e37d058bc7a8153af2d7b1158dd3dcbc32447321a7d913304" :answer/id #uuid "4699547e-7d88-5c79-a05c-aa4be50457b4" :answer/type :answer.type/math :answer/value "x+4y+z+10=0" :db/ensure [:answer/validate]} {:db/id "q-336540/selection/6a7c85fa58d08c9402cab0c580494472cb450d17aad035e0f38a5f8394f84e1e" :answer/id #uuid "9763fa43-49a8-54ac-8327-c39ace4eca59" :answer/type :answer.type/math :answer/value "2x+5y+14=0" :db/ensure [:answer/validate]} {:db/id "q-336540/selection" :answer-field/id #uuid "cf0c30f9-503f-5f2d-a8e9-ee837e0cad11" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-336540/selection/97cb1785faa48d1a5e1a6fec600151d7ab612300429108afc62bc6995fe97602" :answer-field/choices ["q-336540/selection/12b65e3ef61061d0e1ffa677eae710d0aeb5756a73adef2d8962481cb2dce31d" "q-336540/selection/78005428e94a396e6da924c6bd959d88a2a0ad94815972f517c1f85a1e8fe4d3" "q-336540/selection/97cb1785faa48d1a5e1a6fec600151d7ab612300429108afc62bc6995fe97602" "q-336540/selection/5268f396a93a558e37d058bc7a8153af2d7b1158dd3dcbc32447321a7d913304" "q-336540/selection/6a7c85fa58d08c9402cab0c580494472cb450d17aad035e0f38a5f8394f84e1e"] :db/ensure [:answer-field/validate]} {:db/id "q-336540" :question/id #uuid "8487193a-71df-5209-912c-39653fe410a3" :question/math-academy-id "q-336540" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(2,-4,1)$ and is perpendicular to the line \n${\\begin{aligned}x=-2+t \\\\ y=1+4t \\\\ z=5\\end{aligned}.$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨2,-4,1⟩.$  From the parametrical equation, we find that the line is parallel to the vector $⟨1,4,0⟩.$  So, the normal vector of the plane is \n\n$$\nn=⟨1,4,0⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨1,4,0⟩ & =⟨2,-4,1⟩\\cdot ⟨1,4,0⟩ \\\\ r\\cdot ⟨1,4,0⟩ & =-14\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨1,4,0⟩ & =-14 \\\\ x+4y & =-14 \\\\ x+4y+14 & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-336540/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2173739c-cd59-58ed-a265-8ee88c982ae0"] :knowledge-point/questions ["q-336540"] :db/ensure [:knowledge-point/validate]} {:db/id "q-336112/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "66c7b0e9-84e8-5c9c-ba0f-06626ea8fc1f" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-336112/field-1" :answer-field/id #uuid "f11793dc-6a93-59ef-8ce8-cbd1fa85f5f1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336112/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-336112/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-336112/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "f5a9a64d-1ad8-5fd9-a7ff-e1842bd77ed0" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-336112/field-2" :answer-field/id #uuid "7a2f3885-c732-5ca3-999a-26db1ceab88e" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336112/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-336112/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-336112/field-3/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "ca6ba3ad-28aa-5386-aca3-2fe84afb3130" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-336112/field-3" :answer-field/id #uuid "d8480187-671e-5702-b732-d23eb9de328e" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336112/field-3/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer-field/choices ["q-336112/field-3/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97"] :db/ensure [:answer-field/validate]} {:db/id "q-336112" :question/id #uuid "bf13035e-4955-5aba-9932-4690b97ac996" :question/math-academy-id "q-336112" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(2,-1,3)$ and is perpendicular to the line \n$r=[\\begin{aligned}0 \\\\ 2 \\\\ 1\\end{aligned}]+t[\\begin{aligned}1 \\\\ -4 \\\\ 2\\end{aligned}].$\n\n$x\\,-\\,$\n{{field-1}}\n$y\\,+$\n{{field-2}}\n$z\\,-\\,$\n{{field-3}}\n$=0$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨2,-1,3⟩.$ From the vectorial equation, we find that the line is parallel to the vector $⟨1,-4,2⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨1,-4,2⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨1,-4,2⟩ & =⟨2,-1,3⟩\\cdot ⟨1,-4,2⟩ \\\\ r\\cdot ⟨1,-4,2⟩ & =12\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨1,-4,2⟩ & =12 \\\\ x-4y+2z & =12 \\\\ x-4y+2z-12 & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-336112/field-1" "q-336112/field-2" "q-336112/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2173739c-cd59-58ed-a265-8ee88c982ae0"] :knowledge-point/questions ["q-336112"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70809/selection/2f78357f6fd5bafb351f10f56bf2a4cd545055221b95251efbb9d966e1b522b5" :answer/id #uuid "99b50b55-44c9-5578-806b-352c17204190" :answer/type :answer.type/math :answer/value "-2x+y+z-2=0" :db/ensure [:answer/validate]} {:db/id "q-70809/selection/8d1d5da459716f021e985639a96aa0bef7484bf052bbf7daff4873c0bcfa9930" :answer/id #uuid "64cba4dd-9dc5-53ef-acae-98028b7c263b" :answer/type :answer.type/math :answer/value "3x+2y-2z-14=0" :db/ensure [:answer/validate]} {:db/id "q-70809/selection/f70354e50f5e5c157a5e2c7e2a2498097b2beeeaa34c7396d12549c779cad812" :answer/id #uuid "1ed7e429-d015-5de3-9015-5a55d26ad276" :answer/type :answer.type/math :answer/value "2x-z-14=0" :db/ensure [:answer/validate]} {:db/id "q-70809/selection/8e90bc9fe1517bab59301bc637682c3fcc5cd43b1f82a95f2a36ab9f553a5d08" :answer/id #uuid "6e65ef75-b03c-52a9-aa96-50477a3fa84f" :answer/type :answer.type/math :answer/value "2x+3y-z-14=0" :db/ensure [:answer/validate]} {:db/id "q-70809/selection/2d4e13d265f56de9d3dc07add8a1108830d6b6ee03b106a3a98e24c031a708e7" :answer/id #uuid "7d089bd5-bc73-50b4-9789-cefe8e13dd73" :answer/type :answer.type/math :answer/value "3x+2y-2z-2=0" :db/ensure [:answer/validate]} {:db/id "q-70809/selection" :answer-field/id #uuid "11e75fd7-4368-5648-a1cc-04738d2cfcc2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-70809/selection/8d1d5da459716f021e985639a96aa0bef7484bf052bbf7daff4873c0bcfa9930" :answer-field/choices ["q-70809/selection/2f78357f6fd5bafb351f10f56bf2a4cd545055221b95251efbb9d966e1b522b5" "q-70809/selection/8d1d5da459716f021e985639a96aa0bef7484bf052bbf7daff4873c0bcfa9930" "q-70809/selection/f70354e50f5e5c157a5e2c7e2a2498097b2beeeaa34c7396d12549c779cad812" "q-70809/selection/8e90bc9fe1517bab59301bc637682c3fcc5cd43b1f82a95f2a36ab9f553a5d08" "q-70809/selection/2d4e13d265f56de9d3dc07add8a1108830d6b6ee03b106a3a98e24c031a708e7"] :db/ensure [:answer-field/validate]} {:db/id "q-70809" :question/id #uuid "a01c8d0c-708e-5a28-b9ae-1414f36e9dc9" :question/math-academy-id "q-70809" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(2,3,-1)$ and is perpendicular to the line \n$r=[\\begin{aligned}-2 \\\\ 0 \\\\ 1\\end{aligned}]+t[\\begin{aligned}3 \\\\ 2 \\\\ -2\\end{aligned}].$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨2,3,-1⟩.$ From the vectorial equation, we find that the line is parallel to the vector $⟨3,2,-2⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨3,2,-2⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨3,2,-2⟩ & =⟨2,3,-1⟩\\cdot ⟨3,2,-2⟩ \\\\ r\\cdot ⟨3,2,-2⟩ & =14.\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨3,2,-2⟩ & =14 \\\\ 3x+2y-2z & =14 \\\\ 3x+2y-2z-14 & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-70809/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2173739c-cd59-58ed-a265-8ee88c982ae0"] :knowledge-point/questions ["q-70809"] :db/ensure [:knowledge-point/validate]} {:db/id "q-336538/selection/db4882a54dbe93d8df999335b9063da44226ab71f258894329bf0984ecfb7d20" :answer/id #uuid "d684d6a2-d32b-5d86-ab15-8939c7ea5771" :answer/type :answer.type/math :answer/value "x-3z-12=0" :db/ensure [:answer/validate]} {:db/id "q-336538/selection/15c47a45038b7e188c831f6ddf7b3d31678c3542d6f1f50d9a45cf8a38a16f0a" :answer/id #uuid "d98e1129-6a50-5a34-9723-8863b00d0cbf" :answer/type :answer.type/