#{[{:db/id #edb/ref 17592186329787 :knowledge-point/_questions [{:knowledge-point/id #uuid "39692b40-7d68-5ae5-9fe1-0f8b0b2e0d77" :knowledge-point/title "Finding the Orthogonal Projection of a Vector Onto a Subspace Spanned by Orthogonal Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37718ee6-2568-5e32-a39d-06e5f81e0af9" :answer/type {:db/ident :answer.type/math} :answer/value "5t+3{t}^{2}" :db/id #edb/ref 17592186329789} {:answer/id #uuid "b23676f1-ab7b-5ff8-9d13-ad4d66a02b5b" :answer/type {:db/ident :answer.type/math} :answer/value "3t+5{t}^{2}" :db/id #edb/ref 17592186329790} {:answer/id #uuid "fdbb785a-a466-5e6c-9b05-5110763a77f1" :answer/type {:db/ident :answer.type/math} :answer/value "3{t}^{2}" :db/id #edb/ref 17592186329791} {:answer/id #uuid "ea40bac0-c077-5558-a30c-0bda680da0d3" :answer/type {:db/ident :answer.type/math} :answer/value "15t+5{t}^{2}" :db/id #edb/ref 17592186329792} {:answer/id #uuid "366a3e6c-1179-52c4-bff7-37fbedd7f96c" :answer/type {:db/ident :answer.type/math} :answer/value "15t+3{t}^{2}" :db/id #edb/ref 17592186329793}] :answer-field/correct {:answer/id #uuid "ea40bac0-c077-5558-a30c-0bda680da0d3" :answer/type {:db/ident :answer.type/math} :answer/value "15t+5{t}^{2}" :db/id #edb/ref 17592186329792} :answer-field/id #uuid "68038974-e290-5ade-8392-b88488e2078f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329788}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "e6c5f2f2-7e44-530a-acb6-a43ee50efa44" :question/math-academy-id "q-105400" :question/problem "Let $V=C[-1,1],$ the vector space of continuous functions over $[-1,1]$, and let the inner product on $V$ be defined as\n\n$$\n⟨x(t),y(t)⟩={\\int }_{-1}^{1}x(t)y(t)\\,\\text{d}t.\n$$\n\nNow consider the following elements of $V:$ \n\n$$\n{f}_{1}(t)=t,\\,{f}_{2}(t)={t}^{2},\\,g(t)=15t+3\n$$\n\nFind the orthogonal projection of $g(t)$ onto $S=\\text{Span}{{f}_{1}(t),{f}_{2}(t)}$ given that ${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the inner product, and that the orthogonal projection of $g(t)$ onto $\\text{Span}{{f}_{1}(t)}$ equals $15t.$" :question/worked-solution "Since the set ${{f}_{1}(t),{f}_{2}(t)}$ is orthogonal, the orthogonal projection of $g(t)$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,g(t)={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t).\n$$\n\nWe are given that ${\\text{proj}}_{{f}_{1}(t)}\\,g(t)=15t,$ so let's now find the orthogonal projection of $g(t)$ onto $\\text{Span}{{f}_{2}(t)}.$ This can be computed as\n\n$$\n{\\text{proj}}_{{f}_{2}(t)}\\,g(t)=\\frac{⟨g(t),{f}_{2}(t)⟩}{⟨{f}_{2}(t),{f}_{2}(t)⟩}\\,{f}_{2}(t).\n$$\n\n \n\nIn our case, we have\n\n$$\n\\begin{aligned}⟨g(t),{f}_{2}(t)⟩ & ={\\int }_{-1}^{1}g(t){f}_{2}(t)\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}(15t+3)\\cdot {t}^{2}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}15{t}^{3}+3{t}^{2}\\,\\text{d}t \\\\  & ={[\\frac{15}{4}{t}^{4}+{t}^{3}]}_{-1}^{1} \\\\  & =(\\frac{15}{4}+1)-(\\frac{15}{4}-1) \\\\  & =2,\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}⟨{f}_{2}(t),{f}_{2}(t)⟩ & ={\\int }_{-1}^{1}{f}_{2}(t){f}_{2}(t)\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}{t}^{2}\\cdot {t}^{2}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}{t}^{4}\\,\\text{d}t \\\\  & ={\\frac{1}{5}{t}^{5}|}_{-1}^{1} \\\\  & =\\frac{1}{5}-(-\\frac{1}{5}) \\\\  & =\\frac{2}{5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{\\text{proj}}_{{f}_{2}(t)}\\,g(t)=\\frac{2}{(\\frac{2}{5})}\\cdot {t}^{2}=5{t}^{2}.\n$$\n\nFinally,\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,g(t) & ={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t) \\\\  & =15t+5{t}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186134482 :knowledge-point/_questions [{:knowledge-point/id #uuid "39692b40-7d68-5ae5-9fe1-0f8b0b2e0d77" :knowledge-point/title "Finding the Orthogonal Projection of a Vector Onto a Subspace Spanned by Orthogonal Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83200f90-8cb7-5681-8bc8-44408065b578" :answer/type {:db/ident :answer.type/math} :answer/value "-t^{2} + t" :db/id #edb/ref 17592186133335} {:answer/id #uuid "b144942f-812d-5aea-90cd-3c3cbe37a452" :answer/type {:db/ident :answer.type/math} :answer/value "t^{2} - 3t" :db/id #edb/ref 17592186133336} {:answer/id #uuid "c11add5e-20ba-558e-bf62-4eff66fa9bc4" :answer/type {:db/ident :answer.type/math} :answer/value "t^{2} - 2t" :db/id #edb/ref 17592186133337} {:answer/id #uuid "ea1d5f99-82cf-5891-8581-0c5e0624b238" :answer/type {:db/ident :answer.type/math} :answer/value "3t^{2} - t" :db/id #edb/ref 17592186133338} {:answer/id #uuid "f8dc2340-4fa0-545c-a61f-b922c4739875" :answer/type {:db/ident :answer.type/math} :answer/value "t^{2} + 2t" :db/id #edb/ref 17592186133339}] :answer-field/correct {:answer/id #uuid "ea1d5f99-82cf-5891-8581-0c5e0624b238" :answer/type {:db/ident :answer.type/math} :answer/value "3t^{2} - t" :db/id #edb/ref 17592186133338} :answer-field/id #uuid "e0510bfb-d8c6-50e3-ad4e-9c649271e73c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186133334}] :question/id #uuid "2b04e926-3f28-54fc-a52b-7c1f046fb290" :question/math-academy-id "q-98689" :question/problem "Let $V = R_{2}[t]$, the vector space of real polynomials of degree at most $2$, and let the inner product on $V$ be defined as\n$⟨p(t), q(t)⟩ = p(-1)q(-1) + p(0)q(0) + p(1)q(1)$.\n\nNow consider the following elements of $V$:\n\n$p_{1}(t) = t^{2} - t, p_{2}(t) = t^{2} + t, q(t) = 4t^{2} - t - 1$\n\nFind the orthogonal projection of $q(t)$ onto $S = Span{p_{1}(t), p_{2}(t)}$ given that $p_{1}(t)⊥p_{2}(t)$ with respect to the inner product, and that the orthogonal projection of $q(t)$ onto $Span{p_{1}(t)}$ equals $2t^{2} - 2t$."}]}
