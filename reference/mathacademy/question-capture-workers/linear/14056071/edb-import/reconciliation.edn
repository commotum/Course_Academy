 "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13990291/state.json" "file_sha256" "13a1dc8b64deb7ca6765d314afb77313665a825c4e3c70c62b2258bca128e50d" "basis" 1013 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13990291/edb-import/verification.json"} {"question" "q-159801" "field" "selection" "attribute" "answer/value" "value" [:answer.type/image "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13990291/assets/98150e2e7b7cb55643f588b885c3f57a34da186834dcbebd2cb7b35151317519.png"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13990291/state.json" "file_sha256" "13a1dc8b64deb7ca6765d314afb77313665a825c4e3c70c62b2258bca128e50d" "basis" 1013 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13990291/edb-import/verification.json"} {"question" "e-6682" "field" nil "attribute" "question/problem" "value" "Consider the linear transformation $\\mathbf T$ with matrix representation $T,$ given by\n\n$$\n[\\begin{aligned}2 & 3 \\\\ 1 & -1\\end{aligned}]\n$$\n\nThe line segment $\\overline{AB}$ is shown below. Find $\\overline{A'B'},$ the image of $\\overline{AB}$ under the action of $\\mathbf T.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13990291/assets/2e22400d15abc81150d6d18de591549e81a46bd16ab9e95f10f86bae2125b490.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13990291/example-6682.json" "file_sha256" "577cacda82d277c462d6ca9e496f23300a9854fecd91cc2217fb95198c6402fd" "basis" 1013 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13990291/edb-import/verification.json"} {"question" "e-6682" "field" nil "attribute" "question/worked-solution" "value" "To find the image of $\\overline{AB}$ under the action of $\\mathbf T$, we first create a matrix $X$ containing the coordinates of the endpoints of $\\overline{AB}\\mathbin{:}$\n\n$$\n[\\begin{aligned}2 & -1 \\\\ -1 & 1\\end{aligned}]\n$$\n\nNow, we compute the image of $X$ under the action of $\\mathbf T$ by calculating the matrix product $TX\\mathbin{:}$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}2 & 3 \\\\ 1 & -1\\end{aligned}][\\begin{aligned}2 & -1 \\\\ -1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 \\\\ 3 & -2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective endpoints of the image are $A'(1,3)$ and $B'(1,-2),$ as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13990291/assets/472f8e712f7d695d5ab3593dafbcc0309feb1a6ac80e9e29c4893dc651d20cf7.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13990291/example-6682.json" "file_sha256" "577cacda82d277c462d6ca9e496f23300a9854fecd91cc2217fb95198c6402fd" "basis" 1013 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13990291/edb-import/verification.json"} {"question" "e-5447" "field" nil "attribute" "question/problem" "value" "Consider the linear transformation $\\mathbf T$ with matrix representation $T,$ given by\n\n$$\n[\\begin{aligned}1 & -1 \\\\ 0 & -2\\end{aligned}]\n$$\n\nThe triangle $\\triangle ABC$ is shown below. Find $\\triangle A'B'C',$ the image of $\\triangle ABC$ under the action of $\\mathbf T.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13990291/assets/4986bd2dab6b455c0d5e41909377c433d761bf7270364d3e2596e6db7f23981b.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13990291/example-5447.json" "file_sha256" "9dac8791ae857a52385be17ac4edcb03de05e1d473e475f4a54c5fc256c549a9" "basis" 1013 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13990291/edb-import/verification.json"} {"question" "e-5447" "field" nil "attribute" "question/worked-solution" "value" "To find the image of $T$ under the action of $\\mathbf T,$ we first create a matrix $X$ containing all of the vertices of $\\triangle ABC\\mathbin{:}$\n\n$$\n[\\begin{aligned}-1 & 0 & 2 \\\\ 2 & 0 & 1\\end{aligned}]\n$$\n\nNow, we compute the image of $X$ under the action of $\\mathbf T$ by calculating the matrix product $TX\\mathbin{:}$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}1 & -1 \\\\ 0 & -2\\end{aligned}][\\begin{aligned}-1 & 0 & 2 \\\\ 2 & 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 0 & 1 \\\\ -4 & 0 & -2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of $\\triangle A'B'C'$ are $(-3,-4), (0,0), (1,-2),$ as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13990291/assets/e8a14ffbaab4597a2a4a7c9a6bad61dabbc4970fc22c3ed2eb28b2594a670938.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13990291/example-5447.json" "file_sha256" "9dac8791ae857a52385be17ac4edcb03de05e1d473e475f4a54c5fc256c549a9" "basis" 1013 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13990291/edb-import/verification.json"}] "sources" [{"question" "q-77700" "field" nil "attribute" "question/problem" "value" "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}1 & 1 \\\\ 2 & 3\\end{aligned}].\n$$\n\nA line segment $\\overset{―}{AB}$ has endpoints at $A(1,-2)$ and $B(-2,1).$ What are the coordinates of the corresponding endpoints of $\\overset{―}{{A}^{′}{B}^{′}}$, the image of $\\overset{―}{AB}$ under the action of $T?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056071/state.json" "file_sha256" "9248904f1840495dab3fe2b10b0995e87ff2189a34c288482791aa6d582f1092"} {"question" "q-77700" "field" nil "attribute" "question/worked-solution" "value" "To find the image of $\\overset{―}{AB}$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the endpoints of $\\overset{―}{AB}:$\n\n$$\nX=[\\begin{aligned}1 & -2 \\\\ -2 & 1\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}1 & 1 \\\\ 2 & 3\\end{aligned}][\\begin{aligned}1 & -2 \\\\ -2 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & -1 \\\\ -4 & -1\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective endpoints of the image are ${A}^{′}(-1,-4)$ and ${B}^{′}(-1,-1).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056071/state.json" "file_sha256" "9248904f1840495dab3fe2b10b0995e87ff2189a34c288482791aa6d582f1092"} {"question" "q-77700" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056071/activity-metadata.json" "file_sha256" "1e06934bfab72d672f84bb3eaf4fa074d8173d62241a1d7d47788ab5c7c79745"} {"question" "q-77700" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056071/state.json" "file_sha256" "9248904f1840495dab3fe2b10b0995e87ff2189a34c288482791aa6d582f1092"} {"question" "q-77700" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "$(-1,-1)$ and $(-4,-1)$"] ["text" "$(-1,-4)$ and $(-1,-1)$"] ["text" "$(-2,1)$ and $(-1,1)$"] ["text" "$(-4,-4)$ and $(-1,-1)$"] ["text" "$(1,-4)$ and $(1,-1)$"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-ca