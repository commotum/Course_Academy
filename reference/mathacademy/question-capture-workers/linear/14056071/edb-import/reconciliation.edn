ff2189a34c288482791aa6d582f1092"} {"question" "q-77699" "field" nil "attribute" "question/problem" "value" "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}1 & 0 \\\\ -1 & 1\\end{aligned}].\n$$\n\nA line segment $\\overset{―}{AB}$ has endpoints at $A(2,3)$ and $B(1,-2).$ What are the coordinates of the corresponding endpoints of $\\overset{―}{{A}^{′}{B}^{′}}$, the image of $\\overset{―}{AB}$ under the action of $T?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056071/state.json" "file_sha256" "9248904f1840495dab3fe2b10b0995e87ff2189a34c288482791aa6d582f1092"} {"question" "q-77699" "field" nil "attribute" "question/worked-solution" "value" "To find the image of $\\overset{―}{AB}$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the endpoints of $\\overset{―}{AB}:$\n\n$$\nX=[\\begin{aligned}2 & 1 \\\\ 3 & -2\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}1 & 0 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}2 & 1 \\\\ 3 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 1 \\\\ 1 & -3\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective endpoints of the image are ${A}^{′}(2,1)$ and ${B}^{′}(1,-3).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056071/state.json" "file_sha256" "9248904f1840495dab3fe2b10b0995e87ff2189a34c288482791aa6d582f1092"} {"question" "q-77699" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056071/activity-metadata.json" "file_sha256" "1e06934bfab72d672f84bb3eaf4fa074d8173d62241a1d7d47788ab5c7c79745"} {"question" "q-77699" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056071/state.json" "file_sha256" "9248904f1840495dab3fe2b10b0995e87ff2189a34c288482791aa6d582f1092"} {"question" "q-77699" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "$(-3,1)$ and $(1,2)$"] ["text" "$(1,1)$ and $(2,-3)$"] ["text" "$(2,-1)$ and $(1,-3)$"] ["text" "$(2,1)$ and $(1,-3)$"] ["text" "$(2,1)$ and $(1,3)$"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056071/state.json" "file_sha256" "9248904f1840495dab3fe2b10b0995e87ff2189a34c288482791aa6d582f1092"} {"question" "q-77699" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "$(2,1)$ and $(1,-3)$"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056071/state.json" "file_sha256" "9248904f1840495dab3fe2b10b0995e87ff2189a34c288482791aa6d582f1092"} {"question" "q-282616" "field" nil "attribute" "question/problem" "value" "Let $T$ be the linear transformation with matrix representation $T$ given by\n\n$$\nT=[\\begin{aligned}2 & -1 \\\\ 3 & 1\\end{aligned}].\n$$\n\nA line segment $\\overset{―}{KL}$ has endpoints at $K(1,0)$ and $L(0,2).$ What are the coordinates of the corresponding endpoints $\\overset{―}{{K}^{′}{L}^{′}}$, the image of $\\overset{―}{KL}$ under the action of $T?$\n\n${K}^{′}($ \n{{field-1}}, \n{{field-2}}\n$)\\,$ and $\\,{L}^{′}($ \n{{field-3}}, \n{{field-4}}\n$)$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056071/state.json" "file_sha256" "9248904f1840495dab3fe2b10b0995e87ff2189a34c288482791aa6d582f1092"} {"question" "q-282616" "field" nil "attribute" "question/worked-solution" "value" "To find the image of $\\overset{―}{KL}$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the endpoints of $\\overset{―}{KL}:$\n\n$$\nX=[\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}2 & -1 \\\\ 3 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2\\cdot 1+(-1)\\cdot 0 & 2\\cdot 0+(-1)\\cdot 2 \\\\ 3\\cdot 1+1\\cdot 0 & 3\\cdot 0+1\\cdot 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -2 \\\\ 3 & 2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective endpoints of the image are ${K}^{′}(2,3)$ and ${L}^{′}(-2,2).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056071/state.json" "file_sha256" "9248904f1840495dab3fe2b10b0995e87ff2189a34c288482791aa6d582f1092"} {"question" "q-282616" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056071/activity-metadata.json" "file_sha256" "1e06934bfab72d672f84bb3eaf4fa074d8173d62241a1d7d47788ab5c7c79745"} {"question" "q-282616" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056071/state.json" "file_sha256" "9248904f1840495dab3fe2b10b0995e87ff2189a34c288482791aa6d582f1092"} {"question" "q-282616" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056071/state.json" "file_sha256" "9248904f1840495dab3fe2b10b0995e87ff