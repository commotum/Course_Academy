b38-eef9-5392-90cc-85da06850177" :answer-field/key "field-5" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186333246} {:answer-field/choices [{:answer/id #uuid "ad730d90-7c36-51d0-9c1d-9ce507c9d10f" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186333249}] :answer-field/correct {:answer/id #uuid "ad730d90-7c36-51d0-9c1d-9ce507c9d10f" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186333249} :answer-field/id #uuid "c388e346-f3be-5734-b6a8-82f3cab0d981" :answer-field/key "field-6" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186333248}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "39092da6-a6f3-5ce1-9ece-f9716d31fa11" :question/math-academy-id "q-281567" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}1 & -4 \\\\ 2 & 3\\end{aligned}].\n$$\n\nA triangle $GHI$ has vertices at $G(5,5),\\,H(-1,-4),$ and $I(3,5).$ What are the coordinates of the corresponding vertices of  $△{G}^{′}{H}^{′}{I}^{′}$, the image of $△GHI$ under the action of $T?$\n\n${G}^{′}($ \n{{field-1}}, \n{{field-2}}\n$),\\,$  $\\,{H}^{′}($ \n{{field-3}}, \n{{field-4}}\n$),\\,$ $\\,{I}^{′}($ \n{{field-5}}, \n{{field-6}}\n$)$" :question/worked-solution "To find the image of $△GHI$ under the action of $T$, we first create a matrix $X$ containing all of the vertices of $GHI:$\n\n$$\nX=[\\begin{aligned}5 & -1 & 3 \\\\ 5 & -4 & 5\\end{aligned}]\n$$\n\nNow, we compute the image of $X$ under $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}1 & -4 \\\\ 2 & 3\\end{aligned}]\\cdot [\\begin{aligned}5 & -1 & 3 \\\\ 5 & -4 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}-15 & 15 & -17 \\\\ 25 & -14 & 21\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of $△{G}^{′}{H}^{′}{I}^{′}$ are ${G}^{′}(-15,25),$\n${H}^{′}(15,-14),$ ${I}^{′}(-17,21).$"}] [{:db/id #edb/ref 17592186333250 :knowledge-point/_questions [{:knowledge-point/id #uuid "85936915-4c9c-572c-af99-025fec0f7570" :knowledge-point/title "Computing the Image of a Line Segment Under the Action of a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ee165f41-3318-5eb2-9b32-30d70fedf227" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186333252}] :answer-field/correct {:answer/id #uuid "ee165f41-3318-5eb2-9b32-30d70fedf227" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186333252} :answer-field/id #uuid "a073c1e2-2d34-5b05-9eab-2ffef82578a2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186333251} {:answer-field/choices [{:answer/id #uuid "469c2c4c-a888-5319-b595-5ee7f6915ed8" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186333254}] :answer-field/correct {:answer/id #uuid "469c2c4c-a888-5319-b595-5ee7f6915ed8" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186333254} :answer-field/id #uuid "2e09fdc2-7793-5e8c-bf11-714c959430a8" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186333253} {:answer-field/choices [{:answer/id #uuid "ad62406d-08a9-5677-aade-bc04d0d423e9" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186333256}] :answer-field/correct {:answer/id #uuid "ad62406d-08a9-5677-aade-bc04d0d423e9" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186333256} :answer-field/id #uuid "337e0163-3110-58dc-b2ce-54b5317607b2" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186333255} {:answer-field/choices [{:answer/id #uuid "dd69d7c1-453a-52df-97f4-90b3efd306d4" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186333258}] :answer-field/correct {:answer/id #uuid "dd69d7c1-453a-52df-97f4-90b3efd306d4" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186333258} :answer-field/id #uuid "bccb93ec-75df-5390-a0cd-e7166be33187" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186333257}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c031c61b-058d-579f-bdc3-016065e27d83" :question/math-academy-id "q-282616" :question/problem "Let $T$ be the linear transformation with matrix representation $T$ given by\n\n$$\nT=[\\begin{aligned}2 & -1 \\\\ 3 & 1\\end{aligned}].\n$$\n\nA line segment $\\overset{―}{KL}$ has endpoints at $K(1,0)$ and $L(0,2).$ What are the coordinates of the corresponding endpoints $\\overset{―}{{K}^{′}{L}^{′}}$, the image of $\\overset{―}{KL}$ under the action of $T?$\n\n${K}^{′}($ \n{{field-1}}, \n{{field-2}}\n$)\\,$ and $\\,{L}^{′}($ \n{{field-3}}, \n{{field-4}}\n$)$" :question/worked-solution "To find the image of $\\overset{―}{KL}$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the endpoints of $\\overset{―}{KL}:$\n\n$$\nX=[\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}2 & -1 \\\\ 3 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2\\cdot 1+(-1)\\cdot 0 & 2\\cdot 0+(-1)\\cdot 2 \\\\ 3\\cdot 1+1\\cdot 0 & 3\\cdot 0+1\\cdot 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -2 \\\\ 3 & 2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective endpoints of the image are ${K}^{′}(2,3)$ and ${L}^{′}(-2,2).$"}] [{:db/id #edb/ref 17592186333259 :knowledge-point/_questions [{:knowledge-point/id #uuid "85936915-4c9c-572c-af99-025fec0f7570" :knowledge-point/title "Computing the Image of a Line Segment Under the Action of a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2971cfd8-8236-504b-8914-d6c0ad4c36db" :answer/type {:db/ident :answer.type/text} :answer/value "$(2,1)$ and $(1,-3)$" :db/id #edb/ref 17592186333261} {:answer/id #uuid "c526bf96-1a73-5b6f-a2af-31f3ad44b37c" :answer/type {:db/ident :answer.type/text} :answer/value "$(2,-1)$ and $(1,-3)$" :db/id #edb/ref 17592186333262} {:answer/id #uuid "879b2f49-c73b-532f-8e10-1e264f80f623" :answer/type {:db/ident :answer.type/text} :answer/value "$(-3,1)$ and $(1,2)$" :db/id #edb/ref 17592186333263} {:answer/id #uuid "fde7f563-d6f3-558b-a9ec-9923b59bc4d2" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,1)$ and $(2,-3)$" :db/id #edb/ref 17592186333264} {:answer/id #uuid "86aa7f09-d514-5b65-a57d-f7bed8ea8137" :answer/type {:db/ident :answer.type/text} :answer/value "$(2,1)$ and $(1,3)$" :db/id #edb/ref 17592186333265}] :answer-field/correct {:answer/id #uuid "2971cfd8-8236-504b-8914-d6c0ad4c36db" :answer/type {:db/ident :answer.type/text} :answer/value "$(2,1)$ and $(1,-3)$" :db/id #edb/ref 17592186333261} :answer-field/id #uuid "f0c7987b-9a97-5476-976b-3d88ffc5c95d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186333260}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "19042bce-c915-5186-a2d2-3f28f8435edc" :question/math-academy-id "q-77699" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}1 & 0 \\\\ -1 & 1\\end{aligned}].\n$$\n\nA line segment $\\overset{―}{AB}$ has endpoints at $A(2,3)$ and $B(1,-2).$ What are the coordinates of the corresponding endpoints of $\\overset{―}{{A}^{′}{B}^{′}}$, the image of $\\overset{―}{AB}$ under the action of $T?$" :question/worked-solution "To find the image of $\\overset{―}{AB}$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the endpoints of $\\overset{―}{AB}:$\n\n$$\nX=[\\begin{aligned}2 & 1 \\\\ 3 & -2\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}1 & 0 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}2 & 1 \\\\ 3 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 1 \\\\ 1 & -3\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective endpoints of the image are ${A}^{′}(2,1)$ and ${B}^{′}(1,-3).$"}] [{:db/id #edb/ref 17592186333266 :knowledge-point/_questions [{:knowledge-point/id #uuid "85936915-4c9c-572c-af99-025fec0f7570" :knowledge-point/title "Computing the Image of a Line Segment Under the Action of a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d5eb54e6-be83-5c32-b8bc-3b1ab084f408" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,-1)$ and $(-4,-1)$" :db/id #edb/ref 17592186333268} {:answer/id #uuid "9a0a05e4-7d79-5323-b057-5e1da49ea247" :answer/type {:db/ident :answer.type/text} :answer/value "$(-2,1)$ and $(-1,1)$" :db/id #edb/ref 17592186333269} {:answer/id #uuid "bdef5cc2-a09d-5ec9-ae9c-139ce21a4a34" :answer/type {:db/ident :answer.type/text} :answer/value "$(-4,-4)$ and $(-1,-1)$" :db/id #edb/ref 17592186333270} {:answer/id #uuid "e684ee83-47ad-52ab-ae30-e374e4534b86" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,-4)$ and $(1,-1)$" :db/id #edb/ref 17592186333271} {:answer/id #uuid "9e2f7ef9-905c-5341-b469-937257256f43" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,-4)$ and $(-1,-1)$" :db/id #edb/ref 17592186333272}] :answer-field/correct {:answer/id #uuid "9e2f7ef9-905c-5341-b469-937257256f43" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,-4)$ and $(-1,-1)$" :db/id #edb/ref 17592186333272} :answer-field/id #uuid "44dc5d8e-bcdd-565a-be2c-f9f206ef5d6f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186333267}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "72fe20a1-1ed3-519d-83f2-97697628b8cc" :question/math-academy-id "q-77700" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}1 & 1 \\\\ 2 & 3\\end{aligned}].\n$$\n\nA line segment $\\overset{―}{AB}$ has endpoints at $A(1,-2)$ and $B(-2,1).$ What are the coordinates of the corresponding endpoints of $\\overset{―}{{A}^{′}{B}^{′}}$, the image of $\\overset{―}{AB}$ under the action of $T?$" :question/worked-solution "To find the image of $\\overset{―}{AB}$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the endpoints of $\\overset{―}{AB}:$\n\n$$\nX=[\\begin{aligned}1 & -2 \\\\ -2 & 1\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}1 & 1 \\\\ 2 & 3\\end{aligned}][\\begin{aligned}1 & -2 \\\\ -2 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & -1 \\\\ -4 & -1\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective endpoints of the image are ${A}^{′}(-1,-4)$ and ${B}^{′}(-1,-1).$"}] [{:db/id #edb/ref 17592186283518 :knowledge-point/_questions [{:knowledge-point/id #uuid "85936915-4c9c-572c-af99-025fec0f7570" :knowledge-point/title "Computing the Image of a Line Segment Under the Action of a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d92617cf-f17a-583c-bfc8-1a5d816e5889" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13990291/assets/dbb1063de834b81ffc00839234d5f8e782daa5f14d78b0a5f2d06265d48be07f.png" :db/id #edb/ref 17592186283520} {:answer/id #uuid "4fd02342-a287-52d7-98b1-5763069b10c2" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13990291/assets/0f67bd4698105bd6fc756db032dcb02160a1fed4afb1408d35a16b3f89d75b4f.png" :db/id #edb/ref 17592186283521} {:answer/id #uuid "e324a1bd-e355-589a-88c9-8f6b97050565" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13990291/assets/012ce15386906930741f9f369ccebf557b89001856738f0b646bfc6b083f6e57.png" :db/id #edb/ref 17592186283522} {:answer/id #uuid "5cec5545-919b-5b4d-ab6d-8af13dd70b8d" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13990291/assets/be396df84a798da087bb7656433378c9ef6b4b6927482b24029a656ae6a85340.png" :db/id #edb/ref 17592186283523} {:answer/id #uuid "4ce09fef-e69d-5f31-bbe3-cf0c90799be4" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13990291/assets/26d4f8e966818e27a0858da0aa8757cf71ebbd1ef0e0544a2b8a126810252def.png" :db/id #edb/ref 17592186283524}] :answer-field/correct {:answer/id #uuid "4ce09fef-e69d-5f31-bbe3-cf0c90799be4" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13990291/assets/26d4f8e966818e27a0858da0aa8757cf71ebbd1ef0e0544a2b8a126810252def.png" :db/id #edb/ref 17592186283524} :answer-field/id #uuid "93655f00-920b-521a-a23b-29ce5f50700d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283519}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b1742b07-44a3-5a74-8a7a-20d14975ace1" :question/math-academy-id "q-77709" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056071/assets/fa8ce497e80e941730cebb8528b09725930fcb31c839ac0020ce7cf9f0a39b58.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}-1 & -2 \\\\ 0 & 3\\end{aligned}].\n$$\n\nThe line segment $\\overset{―}{AB}$ is shown above. Which of the following is $\\overset{―}{{A}^{′}{B}^{′}},$ the image of $\\overset{―}{AB}$ under the action of $T?$" :question/worked-solution "To find the image of $\\overset{―}{AB}$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the endpoints of $\\overset{―}{AB}:$\n\n$$\nX=[\\begin{aligned}-1 & -3 \\\\ 2 & -1\\end{aligned}]\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}-1 & -2 \\\\ 0 & 3\\end{aligned}][\\begin{aligned}-1 & -3 \\\\ 2 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 5 \\\\ 6 & -3\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective endpoints of the image are ${A}^{′}(-3,6)$ and ${B}^{′}(5,-3),$ as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056071/assets/26d4f8e966818e27a0858da0aa8757cf71ebbd1ef0e0544a2b8a126810252def.png)"}] [{:db/id #edb/ref 17592186088332 :knowledge-point/_questions [{:knowledge-point/id #uuid "7c9849b9-397b-5fb9-bb4b-01f3d013c5c2" :knowledge-point/title "Computing the Image of a Polygon Under the Action of a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32c20574-2aa6-5332-8273-dc35ae3a6403" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186086923} {:answer/id #uuid "36f1fced-52fd-5ba7-9ad4-40f973e48683" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186086924} {:answer/id #uuid "42f62621-01d2-5e89-8681-3ab5e99b7b36" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186086925} {:answer/id #uuid "5d239c74-4935-5447-ab9c-6e35b62d6385" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186086926} {:answer/id #uuid "5de3c365-2f20-5236-b2bd-6c4efb28b936" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186086927}] :answer-field/correct {:answer/id #uuid "5d239c74-4935-5447-ab9c-6e35b62d6385" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186086926} :answer-field/id #uuid "9963ac80-ffe4-5008-8b3d-0abef2e9a920" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086922}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b6fad3c0-c00d-5c0b-969d-acffe4832767" :question/math-academy-id "q-8097" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}1 & 5 \\\\ 0 & -1\\end{aligned}].\n$$\n\nA triangle $S$ has vertices at $(-1,1),(2,3),$ and $(5,1).$ Which of the following are coordinates of a vertex of ${S}^{′}$, the image of $S$ under the action of $T?$\n\n- $(4,-1)$\n- $(17,-3)$\n- $(10,-1)$" :question/worked-solution "To find the image of $S$ under the action of $T$, we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\nX=[\\begin{aligned}-1 & 2 & 5 \\\\ 1 & 3 & 1\\end{aligned}]\n$$\n\nNow, we compute the image of $X$ under $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}1 & 5 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}-1 & 2 & 5 \\\\ 1 & 3 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}4 & 17 & 10 \\\\ -1 & -3 & -1\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(4,-1),(17,-3),(10,-1).$ \n\nSo, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186333273 :knowledge-point/_questions [{:knowledge-point/id #uuid "7c9849b9-397b-5fb9-bb4b-01f3d013c5c2" :knowledge-point/title "Computing the Image of a Polygon Under the Action of a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "860351fd-7c98-547d-af55-54ce581a13ab" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186333275} {:answer/id #uuid "a8c0b201-00ef-5c8d-8c2c-43129921e0ab" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186333276} {:answer/id #uuid "b2e55b47-b975-5c49-ab3b-e08da78de8dd" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186333277} {:answer/id #uuid "5e379d27-0003-5685-98b5-f1dd37cd058f" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186333278} {:answer/id #uuid "cbc35c5f-3d8d-58b0-85f3-a92064e9e3ae" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186333279}] :answer-field/correct {:answer/id #uuid "b2e55b47-b975-5c49-ab3b-e08da78de8dd" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186333277} :answer-field/id #uuid "479ba3aa-a8ec-575e-8b63-d8b9a8188ce5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186333274}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e2444a5c-7bef-56b8-ad82-b35e0384de25" :question/math-academy-id "q-8125" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}7 & 0 \\\\ 0 & -1\\end{aligned}].\n$$\n\nA triangle $S$ has vertices at $(-3,0),(3,0),$ and $(0,-3).$ Which of the following are coordinates of a vertex of ${S}^{′}$, the image of $S$ under the action of $T?$\n\n- $(21,0)$\n- $(3,0)$\n- $(-21,0)$" :question/worked-solution "To find the image of $S$ under the action of $T$, we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\nX=[\\begin{aligned}-3 & 3 & 0 \\\\ 0 & 0 & -3\\end{aligned}]\n$$\n\nNow, we compute the image of $X$ under $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}7 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}-3 & 3 & 0 \\\\ 0 & 0 & -3\\end{aligned}] \\\\  & =[\\begin{aligned}-21 & 21 & 0 \\\\ 0 & 0 & 3\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(-21,0),(21,0),(0,3).$ \n\nSo, the correct answer is \"I and III only.\""}]}
