idate]} {:db/id "q-282616/field-4" :answer-field/id #uuid "bccb93ec-75df-5390-a0cd-e7166be33187" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-282616/field-4/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-282616/field-4/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-282616" :question/id #uuid "c031c61b-058d-579f-bdc3-016065e27d83" :question/math-academy-id "q-282616" :question/problem "Let $T$ be the linear transformation with matrix representation $T$ given by\n\n$$\nT=[\\begin{aligned}2 & -1 \\\\ 3 & 1\\end{aligned}].\n$$\n\nA line segment $\\overset{―}{KL}$ has endpoints at $K(1,0)$ and $L(0,2).$ What are the coordinates of the corresponding endpoints $\\overset{―}{{K}^{′}{L}^{′}}$, the image of $\\overset{―}{KL}$ under the action of $T?$\n\n${K}^{′}($ \n{{field-1}}, \n{{field-2}}\n$)\\,$ and $\\,{L}^{′}($ \n{{field-3}}, \n{{field-4}}\n$)$" :question/worked-solution "To find the image of $\\overset{―}{KL}$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the endpoints of $\\overset{―}{KL}:$\n\n$$\nX=[\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}2 & -1 \\\\ 3 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2\\cdot 1+(-1)\\cdot 0 & 2\\cdot 0+(-1)\\cdot 2 \\\\ 3\\cdot 1+1\\cdot 0 & 3\\cdot 0+1\\cdot 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -2 \\\\ 3 & 2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective endpoints of the image are ${K}^{′}(2,3)$ and ${L}^{′}(-2,2).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-282616/field-1" "q-282616/field-2" "q-282616/field-3" "q-282616/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "85936915-4c9c-572c-af99-025fec0f7570"] :knowledge-point/questions ["q-282616"] :db/ensure [:knowledge-point/validate]} {:db/id "q-281567/field-1/283bc09f1a097ae8400558511ca45f1013e17c797fdb7407be52694190fd744b" :answer/id #uuid "042d6be9-8a88-5faa-9445-209423362a70" :answer/type :answer.type/math :answer/value "-15" :db/ensure [:answer/validate]} {:db/id "q-281567/field-1" :answer-field/id #uuid "8b6df545-8b64-59e0-b787-0eff1694b197" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-281567/field-1/283bc09f1a097ae8400558511ca45f1013e17c797fdb7407be52694190fd744b" :answer-field/choices ["q-281567/field-1/283bc09f1a097ae8400558511ca45f1013e17c797fdb7407be52694190fd744b"] :db/ensure [:answer-field/validate]} {:db/id "q-281567/field-2/a84d639d380e10cb74c92005685f9f65779377dfb51342c280c63c645679bbea" :answer/id #uuid "7b0b372e-8144-5d28-8d64-09f0eef787a8" :answer/type :answer.type/math :answer/value "25" :db/ensure [:answer/validate]} {:db/id "q-281567/field-2" :answer-field/id #uuid "1d230872-b4e5-5806-aa81-2ef67c26cab0" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-281567/field-2/a84d639d380e10cb74c92005685f9f65779377dfb51342c280c63c645679bbea" :answer-field/choices ["q-281567/field-2/a84d639d380e10cb74c92005685f9f65779377dfb51342c280c63c645679bbea"] :db/ensure [:answer-field/validate]} {:db/id "q-281567/field-3/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" :answer/id #uuid "efd927cf-5fc3-5b47-949d-feda02828961" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "q-281567/field-3" :answer-field/id #uuid "5784cf2c-89fc-565f-84ca-f791ac62adab" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-281567/field-3/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" :answer-field/choices ["q-281567/field-3/66dedd51c696580d351