lidate]} {:db/id "q-77700" :question/id #uuid "72fe20a1-1ed3-519d-83f2-97697628b8cc" :question/math-academy-id "q-77700" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}1 & 1 \\\\ 2 & 3\\end{aligned}].\n$$\n\nA line segment $\\overset{―}{AB}$ has endpoints at $A(1,-2)$ and $B(-2,1).$ What are the coordinates of the corresponding endpoints of $\\overset{―}{{A}^{′}{B}^{′}}$, the image of $\\overset{―}{AB}$ under the action of $T?$" :question/worked-solution "To find the image of $\\overset{―}{AB}$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the endpoints of $\\overset{―}{AB}:$\n\n$$\nX=[\\begin{aligned}1 & -2 \\\\ -2 & 1\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}1 & 1 \\\\ 2 & 3\\end{aligned}][\\begin{aligned}1 & -2 \\\\ -2 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & -1 \\\\ -4 & -1\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective endpoints of the image are ${A}^{′}(-1,-4)$ and ${B}^{′}(-1,-1).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-77700/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "85936915-4c9c-572c-af99-025fec0f7570"] :knowledge-point/questions ["q-77700"] :db/ensure [:knowledge-point/validate]} {:db/id "q-159797/selection/0c66f30f1db4151238706df27b3ad1756a1ee8fae73cef2aaf18837b3f3d1e13" :answer/id #uuid "43c5aaed-d5e6-5d0c-8c04-201104fbaa52" :answer/type :answer.type/text :answer/value "$(2,-2)$ and $(5,-7)$" :db/ensure [:answer/validate]} {:db/id "q-159797/selection/e1b3e985575c82f51ca21f4502ae6e525c4944e44c41ed714c5d230b9cbd1c34" :answer/id #uuid "ef2cea96-ddb1-529a-a4bc-db2ff2cc83c4" :answer/type :answer.type/text :answer/value "$(2,2)$ and $(-5,5)$" :db/ensure [:answer/validate]} {:db/id "q-159797/selection/02e97