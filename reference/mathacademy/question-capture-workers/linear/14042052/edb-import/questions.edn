bmatrix}9 \\\\ -2 \\\\ 0 \\\\ 7\\end{bmatrix}, a_{2} = \\begin{bmatrix}0 \\\\ 5 \\\\ -2 \\\\ 8\\end{bmatrix}, b = \\begin{bmatrix}45 \\\\ -20 \\\\ 4 \\\\ 19\\end{bmatrix}$."}] [{:db/id #edb/ref 17592186120282 :knowledge-point/_questions [{:knowledge-point/id #uuid "13a44dc8-4699-519f-8cb1-87ad77471ebe" :knowledge-point/title "Solving for Three Coefficients in a Linear Combination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ba411921-937a-5ff2-b95c-2c2ab52d7f9a" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186118168} {:answer/id #uuid "fd01c1f2-324b-5abd-ac30-bfef1b81b856" :answer/type {:db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186118169} {:answer/id #uuid "06aeaafe-6358-5847-a39a-65e26880c857" :answer/type {:db/ident :answer.type/math} :answer/value "-36" :db/id #edb/ref 17592186118170} {:answer/id #uuid "1887f5de-3296-5ad9-a0a7-651a3e2e8117" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186118171} {:answer/id #uuid "6218bbff-56c9-57cd-b302-1a6ec05e497b" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186118172}] :answer-field/correct {:answer/id #uuid "6218bbff-56c9-57cd-b302-1a6ec05e497b" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186118172} :answer-field/id #uuid "dab07291-9c12-5e5c-b621-1a50ea481200" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186118167}] :question/id #uuid "04e10334-4152-5cfe-aad7-249b23effb61" :question/math-academy-id "q-34566" :question/problem "Consider the vectors\n\n$a_{1} = \\begin{bmatrix}1 \\\\ 2 \\\\ 3\\end{bmatrix}, a_{2} = \\begin{bmatrix}2 \\\\ 5 \\\\ 6\\end{bmatrix}, a_{3} = \\begin{bmatrix}3 \\\\ 2 \\\\ 9\\end{bmatrix}, b = \\begin{bmatrix}-2 \\\\ -6 \\\\ 7\\end{bmatrix}$.\n\nIf $x_{1}a_{1} + x_{2}a_{2} + x_{3}a_{3} = b$, then what is $x_{1} + x_{2} + x_{3}$?"}]}
