t+4)\\,i+2t\\,j-(2t+3)\\,k,\\,t\\in [0,1].\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=(2t+4)+(2t+3)+1=4t+8.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-162184/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f78fe749-e37e-53f2-879f-4c36931c1d6f"] :knowledge-point/questions ["q-162184"] :db/ensure [:knowledge-point/validate]} {:db/id "q-162173/selection/974bc6c6ffdff1bc4c785cd4822714ac2914d8d859e05488e943778a848e11e7" :answer/id #uuid "5bba45e5-faf5-5659-93d3-53ec7bf78a45" :answer/type :answer.type/math :answer/value "t+5" :db/ensure [:answer/validate]} {:db/id "q-162173/selection/e64ed06f41ebee4dc554f931a1f31dc3e011359e9b9395022b1a685743955768" :answer/id #uuid "711bc41e-b8e6-5954-ab38-2933d27f8321" :answer/type :answer.type/math :answer/value "2t-1" :db/ensure [:answer/validate]} {:db/id "q-162173/selection/fd9ca1cffa6c209ad15d1b41275c6e3e6bad8553b556d2cb6c937eaaac748dec" :answer/id #uuid "a315c075-de13-5d23-9919-27d8cb3fba4a" :answer/type :answer.type/math :answer/value "3t" :db/ensure [:answer/validate]} {:db/id "q-162173/selection/2c66aaec9de6b66592d8fe90aadabce5792146b30f30d9d7f039ae87397b9544" :answer/id #uuid "c629dade-033a-586a-86cb-9a3a28ab2c08" :answer/type :answer.type/math :answer/value "6-4t" :db/ensure [:answer/validate]} {:db/id "q-162173/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "9a730777-44f1-53e9-a66a-0de5f90d7a21" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-162173/selection" :answer-field/id #uuid "b6a4c70d-05f1-57b6-b794-8282742733bd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-162173/selection/2c66aaec9de6b66592d8fe90aadabce5792146b30f30d9d7f039ae87397b9544" :answer-field/choices ["q-162173/selection/974bc6c6ffdff1bc4c785cd4822714ac2914d8d859e05488e943778a848e11e7" "q-162173/selection/e64ed06f41ebee4dc554f931a1f31dc3e011359e9b9395022b1a685743955768" "q-162173/selection/fd9ca1cffa6c209ad15d1b41275c6e3e6bad8553b556d2cb6c937eaaac748dec" "q-162173/selection/2c66aaec9de6b66592d8fe90aadabce5792146b30f30d9d7f039ae87397b9544" "q-162173/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-162173" :question/id #uuid "c7a17e80-b445-5fbb-9914-628d51dd5f0b" :question/math-academy-id "q-162173" :question/problem "The equation below gives a parametrization of the line segment $\\overset{―}{PQ},$ where $P(3,2,-1)$ and $Q(0,1,-3).$\n\n$$\nr(t)=a\\,i+b\\,j-(2t+1)\\,k,\\,t\\in [0,c]\n$$\n\nWhat is $a+b+c?$" :question/worked-solution "We need to find a direction vector that is parallel to the given line. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =(j-3\\,k)-(3\\,i+2\\,j-k) \\\\  & =-3\\,i-j-2\\,k\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\nr=p+tv\\,⟹\\,r=(3\\,i+2\\,j-k)+t(-3\\,i-j-2\\,k)\n$$\n\nand the parametrization of the line segment $\\overset{―}{PQ}$ is\n\n$$\n\\begin{aligned}r(t) & =(3\\,i+2\\,j-k)+t(-3\\,i-j-2\\,k) \\\\  & =(3-3t)\\,i+(2-t)\\,j-(2t+1)\\,k,\\,t\\in [0,1].\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=(3-3t)+(2-t)+1=6-4t.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-162173/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f78fe749-e37e-53f2-879f-4c36931c1d6f"] :knowledge-point/questions ["q-162173"] :db/ensure [:knowledge-point/validate]} {:db/id "q-162169/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "85617a24-64b7-5da1-9338-83bce6bbcd63" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-162169/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "bf3e2f1d-c