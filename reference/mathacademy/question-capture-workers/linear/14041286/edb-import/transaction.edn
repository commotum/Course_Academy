q-126458/selection/4b05f7b8b9fe18bfab9bc4663bf1680a39f4529b8faf00b8dd11b461443d2044" :answer/id #uuid "edb95343-d14b-5c9d-a0f9-c4b57323a384" :answer/type :answer.type/math :answer/value "r=[\\begin{aligned}4 \\\\ 0 \\\\ -1\\end{aligned}]+t[\\begin{aligned}-6 \\\\ 2 \\\\ 7\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-126458/selection/5b0d2647dcc946f8c505b67547fadead1efab94192d27b6ff18638e04f935b5a" :answer/id #uuid "1ed5d913-6b6c-5367-8541-030232b01964" :answer/type :answer.type/math :answer/value "r=[\\begin{aligned}-1 \\\\ 0 \\\\ 4\\end{aligned}]+t[\\begin{aligned}-6 \\\\ 2 \\\\ 7\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-126458/selection/f19247867cb0b57910a9f3306c5df1d4f34a47f618b3dc0498003e5efe7295a5" :answer/id #uuid "1871cc37-f619-5953-91eb-dcfa6e561709" :answer/type :answer.type/math :answer/value "r=[\\begin{aligned}-1 \\\\ 0 \\\\ 4\\end{aligned}]+t[\\begin{aligned}2 \\\\ -6 \\\\ 7\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-126458/selection/d331127275177977c5f8c1aea5c2d88deb13fe2fa047b9aa55f9ca79ea2fe7df" :answer/id #uuid "1e8758bc-6709-57c9-9a62-d574605c3516" :answer/type :answer.type/math :answer/value "r=[\\begin{aligned}1 \\\\ 0 \\\\ -4\\end{aligned}]+t[\\begin{aligned}-6 \\\\ 2 \\\\ 7\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-126458/selection" :answer-field/id #uuid "f7d8119a-200e-536b-a008-1a1710b3a4d4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-126458/selection/5b0d2647dcc946f8c505b67547fadead1efab94192d27b6ff18638e04f935b5a" :answer-field/choices ["q-126458/selection/cb2fff8292217efcb0ebb11a095bf26d178ea716759d5502753d2d71392748ca" "q-126458/selection/4b05f7b8b9fe18bfab9bc4663bf1680a39f4529b8faf00b8dd11b461443d2044" "q-126458/selection/5b0d2647dcc946f8c505b67547fadead1efab94192d27b6ff18638e04f935b5a" "q-126458/selection/f19247867cb0b57910a9f3306c5df1d4f34a47f618b3dc0498003e5efe7295a5" "q-126458/selection/d331127275177977c5f8c1aea5c2d88deb13fe2fa047b9aa55f9ca79ea2fe7df"] :db/ensure [:answer-field/validate]} {:db/id "q-126458" :question/id #uuid "aaf48b17-9dee-583c-9e29-c168f66ed80b" :question/math-academy-id "q-126458" :question/problem "Find a vector equation of the line that passes through the points $C(-1,0,4)$ and $D(-7,2,11).$" :question/worked-solution "The vector equation of the straight line passing through $C$ and parallel to $v$ is given by\n\n$$\nr=c+tv,\n$$\n\nwhere $t\\in (-\\infty ,\\infty )$ and $c$ is the position vector of $C.$ \n\nWe can find a direction vector by computing the displacement vector between the given points $C(-1,0,4)$ and $D(-7,2,11)$, as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{CD} \\\\  & =⟨-7,2,11⟩-⟨-1,0,4⟩ \\\\  & =⟨-6,2,7⟩\\end{aligned}\n$$\n\nTherefore, the vector equation of the line is given by\n\n$$\n\\begin{aligned}r & =[\\begin{aligned}-1 \\\\ 0 \\\\ 4\\end{aligned}]+t[\\begin{aligned}-6 \\\\ 2 \\\\ 7\\end{aligned}],\\,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-126458/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a6dee200-f517-5645-87ec-ccf36012e55e"] :knowledge-point/questions ["q-126458"] :db/ensure [:knowledge-point/validate]} {:db/id "q-77442/selection/4903cd2d29a9c6c302a8b3771aa7e97bd82dc99e7ac7d359c7db2ca5ead0fc62" :answer/id #uuid "9b81aa93-84f4-569d-9611-f982ef89af8b" :answer/type :answer.type/text :answer/value "${A}_{1}(10,2,2)$ and ${A}_{2}(2,6,-4)$" :db/ensure [:answer/validate]} {:db/id "q-77442/selection/43aa0771ac00e5e9a800d8787d0041dafc0236fa66b46cbf341c8206307e9a57" :answer/id #uuid "f299e4ee-0d87-5b20-b9c2-616a468cd553" :answer/type :answer.type/text :answer/value "${A}_{1}(6,-6,2)$ and ${A}_{2}(10,18,8)$" :db/ensure [:answer/validate]} {:db/id "q-77442/selection/53729237f3af4303892f958b8c5bc6e8076a0ebe0241679b9aadd827fd6f5991" :answer/id #uuid "bf60c65e-1a30-55f7-9f35-bf29135bc1bf" :answer/type :answer.type/text :answer/value "${A}_{1}(10,2,2)$ and ${A}_{2}(7,6,-3)$" :db/ensure [:answer/validate]} {:db/id "q-77442/selection/4a768fc092adad8f4ec36e7b7033561254592046e8668be253ff5e142e964119" :answer/id #uuid "fc89ac3c-5852-5b09-80a0-e4ce2ddea766" :answer/type :answer.type/text :answer/value "${A}_{1}(8,-12,5)$ and ${A}_{2}(7,6,-3)$" :db/ensure [:answer/validate]} {:db/id "q-77442/selection/4e04342b36e33f684f0c4dfb2b2f6a5ab5226566882916fe50e24572d52be13b" :answer/id #uuid "a147f309-f3f8-50d0-bd0a-e3cf9539e610" :answer/type :answer.type/text :answer/value "${A}_{1}(6,-6,2)$ and ${A}_{2}(2,6,-4)$" :db/ensure [:answer/validate]} {:db/id "q-77442/selection" :answer-field/id #uuid "1ee7d575-a0c4-5892-a256-694602bc0503" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-77442/selection/4e04342b36e33f684f0c4dfb2b2f6a5ab5226566882916fe50e24572d52be13b" :answer-field/choices ["q-77442/selection/4903cd2d29a9c6c302a8b3771aa7e97bd82dc99e7ac7d359c7db2ca5ead0fc62" "q-77442/selection/43aa0771ac00e5e9a800d8787d0041dafc0236fa66b46cbf341c8206307e9a57" "q-77442/selection/53729237f3af4303892f958b8c5bc6e8076a0ebe0241679b9aadd827fd6f5991" "q-77442/selection/4a768fc092adad8f4ec36e7b7033561254592046e8668be253ff5e142e964119" "q-77442/selection/4e04342b36e33f684f0c4dfb2b2f6a5ab5226566882916fe50e24572d52be13b"] :db/ensure [:answer-field/validate]} {:db/id "q-77442" :question/id #uuid "f8ced46a-f7bf-550c-ae94-d64f15be9c59" :question/math-academy-id "q-77442" :question/problem "Consider the straight line that passes through $P(4,0,-1)$ and is parallel to $v=⟨2,-6,3⟩.$ Find all the possible points $A$ on that line such that $PA=7.$" :question/worked-solution "First, we find the vector equation of the line, as follows:\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =⟨4,0,-1⟩+t⟨2,-6,3⟩\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nSince $A$ lies on the line, we know that there must be a real number $t$ such that\n\n$$\n\\begin{aligned}\\overset{\\to }{OA} & =⟨4,0,-1⟩+t⟨2,-6,3⟩\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}\\overset{\\to }{PA} & =\\overset{\\to }{OA}-\\overset{\\to }{OP} \\\\  & =(⟨4,0,-1⟩+t⟨2,-6,3⟩)-⟨4,0,-1⟩ \\\\  & =t\\,⟨2,-6,3⟩ \\\\  & =⟨2t,\\,-6t,\\,3t⟩.\\end{aligned}\n$$\n\nUsing the fact that $PA=7,$ we get:\n\n$$\n\\begin{aligned}PA & =7 \\\\ |\\overset{\\to }{PA}| & =7 \\\\ |⟨2t,\\,-6t,\\,3t⟩| & =7 \\\\ \\sqrt{(2t)^{2}+(-6t)^{2}+(3t)^{2}} & =7 \\\\ \\sqrt{49{t}^{2}} & =7 \\\\ \\pm 7t & =7 \\\\ t & =\\pm 1\\end{aligned}\n$$\n\nFinally, putting the values $t=\\pm 1$ into the equation for the line, we obtain\n\n$$\n\\begin{aligned} & \\overset{\\to }{O{A}_{1}}=⟨4,0,-1⟩+⟨2,-6,3⟩=⟨6,-6,2⟩, \\\\  & \\overset{\\to }{O{A}_{2}}=⟨4,0,-1⟩-⟨2,-6,3⟩=⟨2,6,-4⟩.\\end{aligned}\n$$\n\nTherefore, the points are ${A}_{1}(6,-6,2)$ and ${A}_{2}(2,6,-4).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-77442/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c338d1eb-7e13-5089-8dd3-d5ca6eefd4ba"] :knowledge-point/questions ["q-77442"] :db/ensure [:knowledge-point/validate]} {:db/id "q-77443/selection/ff22c9dde4b41b02be67abb6937b29726c26332c4ef1728f7c033ae2fb6f2cec" :answer/id #uuid "0cc8c193-62df-53c3-8f7c-bc7b22d80f1b" :answer/type :answer.type/text :answer/value "${Q}_{1}(3,-1,11)$ and ${Q}_{2}(0,2,-4)$" :db/ensure [:answer/validate]} {:db/id "q-77443/selection/a1d09c4fa7ae43921e4c20b71ddda680d95648140afc793270c96ecf638f196b" :answer/id #uuid "2aaa7882-74d1-5f0e-a190-932cda76b670" :answer/type :answer.type/text :answer/value "${Q}_{1}(2,0,6)$ and ${Q}_{2}(0,2,-4)$" :db/ensure [:answer/validate]} {:db/id "q-77443/selection/2f06f2b7abcfd86173567f1c57b8b5e4122185dde4d02bdc0090500a8882ad23" :answer/id #uuid "00372776-9900-5873-b2d8-8af723760951" :answer/type :answer.type/text :answer/value "${Q}_{1}(6,2,2)$ and ${Q}_{2}(1,0,-2)$" :db/ensure [:answer/validate]} {:db/id "q-77443/selection/97952643c9dda1b8e37b677387e504d04e646ae56f0e7105c2e04b166a3f52ce" :answer/id #uuid "e54b1804-49df-5963-bd11-66814707531f" :answer/type :answer.type/text :answer/value "${Q}_{1}(4,2,6)$ and ${Q}_{2}(1,0,2)$" :db/ensure [:answer/validate]} {:db/id "q-77443/selection/e84a75f0291e2dd40aa3e06345355f8579284b6ad3d36a855c04b32217a9cfc4" :answer/id #uuid "f00c74ee-9fcf-54b1-97e8-a6bac73a5b5e" :answer/type :answer.type/text :answer/value "${Q}_{1}(2,0,6)$ and ${Q}_{2}(-1,3,-9)$" :db/ensure [:answer/validate]} {:db/id "q-77443/selection" :answer-field/id #uuid "13bc0196-3911-5c03-a822-6873c92903a5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-77443/selection/a1d09c4fa7ae43921e4c20b71ddda680d95648140afc793270c96ecf638f196b" :answer-field/choices ["q-77443/selection/ff22c9dde4b41b02be67abb6937b29726c26332c4ef1728f7c033ae2fb6f2cec" "q-77443/selection/a1d09c4fa7ae43921e4c20b71ddda680d95648140afc793270c96ecf638f196b" "q-77443/selection/2f06f2b7abcfd86173567f1c57b8b5e4122185dde4d02bdc0090500a8882ad23" "q-77443/selection/97952643c9dda1b8e37b677387e504d04e646ae56f0e7105c2e04b166a3f52ce" "q-77443/selection/e84a75f0291e2dd40aa3e06345355f8579284b6ad3d36a855c04b32217a9cfc4"] :db/ensure [:answer-field/validate]} {:db/id "q-77443" :question/id #uuid "ca1265ac-23c6-5e5b-be9c-b56a47160343" :question/math-academy-id "q-77443" :question/problem "Consider the straight line that passes through $P(1,1,1)$ and is parallel to $v=⟨1,-1,5⟩.$ Find all the possible points $Q$ on that line such that $PQ=3\\sqrt{3}.$" :question/worked-solution "First, we find the vector equation of the line, as follows:\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =⟨1,1,1⟩+t⟨1,-1,5⟩\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nSince $Q$ lies on the line, we know that there must be a real number $t$ such that\n\n$$\n\\begin{aligned}\\overset{\\to }{OQ} & =⟨1,1,1⟩+t⟨1,-1,5⟩\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =(⟨1,1,1⟩+t⟨1,-1,5⟩)-⟨1,1,1⟩ \\\\  & =t\\,⟨1,-1,5⟩ \\\\  & =⟨t,\\,-t,\\,5t⟩.\\end{aligned}\n$$\n\nUsing the fact that $PQ=3\\sqrt{3},$ we get:\n\n$$\n\\begin{aligned}PQ & =3\\sqrt{3} \\\\ |\\overset{\\to }{PQ}| & =3\\sqrt{3} \\\\ |⟨t,\\,-t,\\,5t⟩| & =3\\sqrt{3} \\\\ \\sqrt{{t}^{2}+(-t)^{2}+(5t)^{2}} & =3\\sqrt{3} \\\\ \\sqrt{27{t}^{2}} & =3\\sqrt{3} \\\\ \\pm 3\\sqrt{3}t & =3\\sqrt{3} \\\\ t & =\\pm 1\\end{aligned}\n$$\n\nFinally, putting the values $t=\\pm 1$ into the equation for the line, we obtain\n\n$$\n\\begin{aligned} & \\overset{\\to }{O{Q}_{1}}=⟨1,1,1⟩+⟨1,-1,5⟩=⟨2,0,6⟩, \\\\  & \\overset{\\to }{O{Q}_{2}}=⟨1,1,1⟩-⟨1,-1,5⟩=⟨0,2,-4⟩.\\end{aligned}\n$$\n\nTherefore, the points are ${Q}_{1}(2,0,6)$ and ${Q}_{2}(0,2,-4).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-77443/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c338d1eb-7e13-5089-8dd3-d5ca6eefd4ba"] :knowledge-point/questions ["q-77443"] :db/ensure [:knowledge-point/validate]} {:db/id "q-126992/selection/a31279b05bf8f25e58afca21f5fd2e843f4cdae909d370f3df7c5dd0013d2eac" :answer/id #uuid "2c9c966a-5aed-50c4-b30e-c9cc186fe8a9" :answer/type :answer.type/text :answer/value "${A}_{1}(1,-1,5)$ and ${A}_{2}(5,-3,1)$" :db/ensure [:answer/validate]} {:db/id "q-126992/selection/147a2272b0f47107fdb96ae523781f1cd2e470b31a136fba81491b5259a84aa6" :answer/id #uuid "bb34a150-e343-5f14-b288-386875381a71" :answer/type :answer.type/text :answer/value "${A}_{1}(1,2,5)$ and ${A}_{2}(-5,3,1)$" :db/ensure [:answer/validate]} {:db/id "q-126992/selection/8b27dd4c9546f5bfab723d46a5b18b437ba31e64881e1e7561f1fe3b974ea113" :answer/id #uuid "a406d08d-e6bb-5c61-8aad-1593b1da44c0" :answer/type :answer.type/text :answer/value "${A}_{1}(1,1,-5)$ and ${A}_{2}(5,3,2)$" :db/ensure [:answer/validate]} {:db/id "q-126992/selection/721bd87739962de13859100e31286b14fc2bfa29df7e9e130064749babe8c83b" :answer/id #uuid "c8456756-54ca-592c-a289-99edc3aa3d7b" :answer/type :answer.type/text :answer/value "${A}_{1}(1,-1,-5)$ and ${A}_{2}(5,3,2)$" :db/ensure [:answer/validate]} {:db/id "q-126992/selection/f6eb6f5252d814e5df7efac0d832c505159c73e3ad790316e3acd63418f1a83d" :answer/id #uuid "641b04fa-ffe5-5154-b59c-31c024713831" :answer/type :answer.type/text :answer/value "${A}_{1}(-1,-1,5)$ and ${A}_{2}(4,-3,-1)$" :db/ensure [:answer/validate]} {:db/id "q-126992/selection" :answer-field/id #uuid "34a23037-a100-5f54-85a7-3c0b9303e5a7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-126992/selection/a31279b05bf8f25e58afca21f5fd2e843f4cdae909d370f3df7c5dd0013d2eac" :answer-field/choices ["q-126992/selection/a31279b05bf8f25e58afca21f5fd2e843f4cdae909d370f3df7c5dd0013d2eac" "q-126992/selection/147a2272b0f47107fdb96ae523781f1cd2e470b31a136fba81491b5259a84aa6" "q-126992/selection/8b27dd4c9546f5bfab723d46a5b18b437ba31e64881e1e7561f1fe3b974ea113" "q-126992/selection/721bd87739962de13859100e31286b14fc2bfa29df7e9e130064749babe8c83b" "q-126992/selection/f6eb6f5252d814e5df7efac0d832c505159c73e3ad790316e3acd63418f1a83d"] :db/ensure [:answer-field/validate]} {:db/id "q-126992" :question/id #uuid "cbeb3212-31dc-5cc0-971a-bf4846f229e5" :question/math-academy-id "q-126992" :question/problem "Consider the straight line that passes through $P(3,-2,3)$ and is parallel to $v=⟨-2,1,2⟩.$ Find all the possible points $A$ on that line such that $AP=3.$" :question/worked-solution "First, we find the vector equation of the line, as follows:\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =⟨3,-2,3⟩+t⟨-2,1,2⟩\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nSince $A$ lies on the line, we know that there must be a real number $t$ such that\n\n$$\n\\begin{aligned}\\overset{\\to }{OA} & =⟨3,-2,3⟩+t⟨-2,1,2⟩\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}\\overset{\\to }{PA} & =\\overset{\\to }{OA}-\\overset{\\to }{OP} \\\\  & =(⟨3,-2,3⟩+t⟨-2,1,2⟩)-⟨3,-2,3⟩ \\\\  & =t\\,⟨-2,1,2⟩ \\\\  & =⟨-2t,\\,t,\\,2t⟩.\\end{aligned}\n$$\n\nUsing the fact that $PA=3,$ we get:\n\n$$\n\\begin{aligned}AP & =3 \\\\ |\\overset{\\to }{PA}| & =3 \\\\ |⟨-2t,\\,t,\\,2t⟩| & =3 \\\\ \\sqrt{(-2t)^{2}+{t}^{2}+(2t)^{2}} & =3 \\\\ \\sqrt{4{t}^{2}+{t}^{2}+4{t}^{2}} & =3 \\\\ \\sqrt{9{t}^{2}} & =3 \\\\ \\pm 3t & =3 \\\\ t & =\\pm 1\\end{aligned}\n$$\n\nFinally, putting the values $t=\\pm 1$ into the equation for the line, we obtain\n\n$$\n\\begin{aligned} & \\overset{\\to }{O{A}_{1}}=⟨3,-2,3⟩+⟨-2,1,2⟩=⟨1,-1,5⟩, \\\\  & \\overset{\\to }{O{A}_{2}}=⟨3,-2,3⟩-⟨-2,1,2⟩=⟨5,-3,1⟩.\\end{aligned}\n$$\n\nTherefore, the points are ${A}_{1}(1,-1,5)$ and ${A}_{2}(5,-3,1).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-126992/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c338d1eb-7e13-5089-8dd3-d5ca6eefd4ba"] :knowledge-point/questions ["q-126992"] :db/ensure [:knowledge-point/validate]} {:db/id "q-126995/selection/f9b7c664d8e6042a6a136d323f7da24330a3d9cd06199d2ad7b91e9bbf347649" :answer/id #uuid "6eb5cfbc-22c3-528a-a30a-5c064ab2aa50" :answer/type :answer.type/text :answer/value "${A}_{1}(-1,1,-7)$ and ${A}_{2}(5,5,5)$" :db/ensure [:answer/validate]} {:db/id "q-126995/selection/c1245ce3d81b9ed4437277d5cf2c33bf77804bcbc8253da9e540c1c5d092ce6c" :answer/id #uuid "52dede04-bba1-5c39-a410-2592c55d3b76" :answer/type :answer.type/text :answer/value "${A}_{1}(-1,1,7)$ and ${A}_{2}(5,5,5)$" :db/ensure [:answer/validate]} {:db/id "q-126995/selection/409913b08ece61047662658e057e26de9bbce5d8d4fe9018a9075c8b5ba6e90e" :answer/id #uuid "f9a26130-b9ff-57cc-bb11-c79826a6b802" :answer/type :answer.type/text :answer/value "${A}_{1}(1,-1,-7)$ and ${A}_{2}(5,5,5)$" :db/ensure [:answer/validate]} {:db/id "q-126995/selection/c85d85e6b7492a7e5a762a33700272f9147340799f7f64f90b01b52131fbeba4" :answer/id #uuid "e4e62b70-6be7-5357-9bca-77c48e37e961" :answer/type :answer.type/text :answer/value "${A}_{1}(-1,-1,7)$ and ${A}_{2}(5,-5,5)$" :db/ensure [:answer/validate]} {:db/id "q-126995/selection/dd5cb089d763cfe2215e2e3518c369d9032564787f1ca22103ca990c66070eba" :answer/id #uuid "f3804c30-94da-5f7a-b59b-deffb0ce5f3f" :answer/type :answer.type/text :answer/value "${A}_{1}(1,1,7)$ and ${A}_{2}(5,-5,5)$" :db/ensure [:answer/validate]} {:db/id "q-126995/selection" :answer-field/id #uuid "767e4e2d-0457-5fea-a1d0-540a9ba8e186" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-126995/selection/c1245ce3d81b9ed4437277d5cf2c33bf77804bcbc8253da9e540c1c5d092ce6c" :answer-field/choices ["q-126995/selection/f9b7c664d8e6042a6a136d323f7da24330a3d9cd06199d2ad7b91e9bbf347649" "q-126995/selection/c1245ce3d81b9ed4437277d5cf2c33bf77804bcbc8253da9e540c1c5d092ce6c" "q-126995/selection/409913b08ece61047662658e057e26de9bbce5d8d4fe9018a9075c8b5ba6e90e" "q-126995/selection/c85d85e6b7492a7e5a762a33700272f9147340799f7f64f90b01b52131fbeba4" "q-126995/selection/dd5cb089d763cfe2215e2e3518c369d9032564787f1ca22103ca990c66070eba"] :db/ensure [:answer-field/validate]} {:db/id "q-126995" :question/id #uuid "59a52ddc-339d-53d5-a5c4-8b8787ceb738" :question/math-academy-id "q-126995" :question/problem "Consider the straight line that passes through $P(2,3,6)$ and is parallel to $v=⟨-3,-2,1⟩.$ Find all the possible points $A$ on that line such that $AP=\\sqrt{14}.$" :question/worked-solution "First, we find the vector equation of the line, as follows:\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =⟨2,3,6⟩+t⟨-3,-2,1⟩\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nSince $A$ lies on the line, we know that there must be a real number $t$ such that\n\n$$\n\\begin{aligned}\\overset{\\to }{OA} & =⟨2,3,6⟩+t⟨-3,-2,1⟩\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}\\overset{\\to }{PA} & =\\overset{\\to }{OA}-\\overset{\\to }{OP} \\\\  & =(⟨2,3,6⟩+t⟨-3,-2,1⟩)-⟨2,3,6⟩ \\\\  & =t\\,⟨-3,-2,1⟩ \\\\  & =⟨-3t,\\,-2t,\\,t⟩.\\end{aligned}\n$$\n\nUsing the fact that $PA=\\sqrt{14},$ we get:\n\n$$\n\\begin{aligned}AP & =\\sqrt{14} \\\\ |\\overset{\\to }{PA}| & =\\sqrt{14} \\\\ |⟨-3t,\\,-2t,\\,t⟩| & =\\sqrt{14} \\\\ \\sqrt{(-3t)^{2}+(-2t)^{2}+{t}^{2}} & =\\sqrt{14} \\\\ \\sqrt{9{t}^{2}+4{t}^{2}+{t}^{2}} & =\\sqrt{14} \\\\ \\pm t\\sqrt{14} & =\\sqrt{14} \\\\ t & =\\pm 1\\end{aligned}\n$$\n\nFinally, putting the values $t=\\pm 1$ into the equation for the line, we obtain\n\n$$\n\\begin{aligned} & \\overset{\\to }{O{A}_{1}}=⟨2,3,6⟩+⟨-3,-2,1⟩=⟨-1,1,7⟩, \\\\  & \\overset{\\to }{O{A}_{2}}=⟨2,3,6⟩-⟨-3,-2,1⟩=⟨5,5,5⟩.\\end{aligned}\n$$\n\nTherefore, the points are ${A}_{1}(-1,1,7)$ and ${A}_{2}(5,5,5).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-126995/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c338d1eb-7e13-5089-8dd3-d5ca6eefd4ba"] :knowledge-point/questions ["q-126995"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-22291"] :question/problem "Consider the straight line that passes through $P(3,1,-1)$ and is parallel to $v=⟨2,1,3⟩.$ Find all the possible points $A$ on that line such that $AP=\\sqrt{14}.$" :question/worked-solution "First, we find the vector equation of the line, as follows:\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =⟨3,1,-1⟩+t⟨2,1,3⟩\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nSince $A$ lies on the line, we know that there must be a real number $t$ such that\n\n$$\n\\begin{aligned}\\overset{\\to }{OA} & =⟨3,1,-1⟩+t⟨2,1,3⟩\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}\\overset{\\to }{PA} & =\\overset{\\to }{OA}-\\overset{\\to }{OP} \\\\  & =(⟨3,1,-1⟩+t⟨2,1,3⟩)-⟨3,1,-1⟩ \\\\  & =t\\,⟨2,1,3⟩ \\\\  & =⟨2t,\\,t,\\,3t⟩.\\end{aligned}\n$$\n\nUsing the fact that $PA=\\sqrt{14},$ we get:\n\n$$\n\\begin{aligned}AP & =\\sqrt{14} \\\\ |\\overset{\\to }{PA}| & =\\sqrt{14} \\\\ |⟨2t,\\,t,\\,3t⟩| & =\\sqrt{14} \\\\ \\sqrt{(2t)^{2}+{t}^{2}+(3t)^{2}} & =\\sqrt{14} \\\\ \\sqrt{14{t}^{2}} & =\\sqrt{14} \\\\ \\pm t\\sqrt{14} & =\\sqrt{14} \\\\ t & =\\pm 1\\end{aligned}\n$$\n\nFinally, putting the values $t=\\pm 1$ into the equation for the line, we obtain\n\n$$\n\\begin{aligned} & \\overset{\\to }{O{A}_{1}}=⟨3,1,-1⟩+1⟨2,1,3⟩=⟨5,2,2⟩, \\\\  & \\overset{\\to }{O{A}_{2}}=⟨3,1,-1⟩-1⟨2,1,3⟩=⟨1,0,-4⟩.\\end{aligned}\n$$\n\nTherefore, the points are ${A}_{1}(5,2,2)$ and ${A}_{2}(1,0,-4).$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-162168/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "3ce24760-9e5a-579a-bf02-dc5d8c8762c2" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-162168/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "e2b34324-ccf2-5c5d-aa4f-7ececfba962f" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-162168/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer/id #uuid "84296384-e8d0-558e-a49f-64e18e2954cb" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "q-162168/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "9bcf0c16-abc6-53e6-84d8-27e642ba913c" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-162168/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "1dd7e1cf-d4ed-56f3-8404-8d355d7c274a" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-162168/selection" :answer-field/id #uuid "e38cf0b5-6047-52e7-aa8a-656fc066d8dc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-162168/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-162168/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" "q-162168/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-162168/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" "q-162168/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" "q-162168/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-162168" :question/id #uuid "0fedc490-872a-5bf2-a731-f24282a97e7f" :question/math-academy-id "q-162168" :question/problem "The equation below describes all the points on the line segment $\\overset{―}{PQ},$ where $P(-6,2,-1)$ and $Q(-8,0,-1).$\n\n$$\nr(t)=[\\begin{aligned}-6 \\\\ 2 \\\\ a\\end{aligned}]+t[\\begin{aligned}-2 \\\\ b \\\\ 0\\end{aligned}],\\,t\\in [0,c]\n$$\n\nWhat is the value of $a+b+c?$" :question/worked-solution "We need to find a direction vector that is parallel to the given line. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =[\\begin{aligned}-8 \\\\ 0 \\\\ -1\\end{aligned}]-[\\begin{aligned}-6 \\\\ 2 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}-2 \\\\ -2 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\nr=p+tv\\,⟹\\,r=[\\begin{aligned}-6 \\\\ 2 \\\\ -1\\end{aligned}]+t[\\begin{aligned}-2 \\\\ -2 \\\\ 0\\end{aligned}]\n$$\n\nand the vector equation of the line segment $\\overset{―}{PQ}$ is\n\n$$\nr(t)=[\\begin{aligned}-6 \\\\ 2 \\\\ -1\\end{aligned}]+t[\\begin{aligned}-2 \\\\ -2 \\\\ 0\\end{aligned}],\\,t\\in [0,1].\n$$\n\nTherefore, we have\n\n$$\na+b+c=(-1)+(-2)+1=-2.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-162168/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f78fe749-e37e-53f2-879f-4c36931c1d6f"] :knowledge-point/questions ["q-162168"] :db/ensure [:knowledge-point/validate]} {:db/id "q-162177/selection/d167a88de8279919cd4426c42b45e96cbe79db72f579f94ad0e