ned}\n$$\n\nTherefore, the vector equation of the line is given by\n\n$$\n\\begin{aligned}r & =[\\begin{aligned}0 \\\\ -2 \\\\ -4\\end{aligned}]+t[\\begin{aligned}5 \\\\ 2 \\\\ 5\\end{aligned}],\\,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041286/state.json" "file_sha256" "33723098ec9036a058d34148050980f29b6e83d0e42fe99ed96394043cf200f6"} {"question" "q-35982" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041286/activity-metadata.json" "file_sha256" "c73d23bd8bda3653a2c735d25fd3f39c83e31fe3e1d881dcf365dcf8cc58b635"} {"question" "q-35982" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041286/state.json" "file_sha256" "33723098ec9036a058d34148050980f29b6e83d0e42fe99ed96394043cf200f6"} {"question" "q-35982" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "r=[\\begin{aligned}0 \\\\ -2 \\\\ -4\\end{aligned}]+t[\\begin{aligned}5 \\\\ -2 \\\\ 5\\end{aligned}],\\,t\\in (-\\infty ,\\infty )"] ["math" "r=[\\begin{aligned}0 \\\\ -2 \\\\ -4\\end{aligned}]+t[\\begin{aligned}5 \\\\ 0 \\\\ 1\\end{aligned}],\\,t\\in (-\\infty ,\\infty )"] ["math" "r=[\\begin{aligned}0 \\\\ -2 \\\\ -4\\end{aligned}]+t[\\begin{aligned}5 \\\\ 2 \\\\ 5\\end{aligned}],\\,t\\in (-\\infty ,\\infty )"] ["math" "r=[\\begin{aligned}5 \\\\ 0 \\\\ 1\\end{aligned}]+t[\\begin{aligned}0 \\\\ -2 \\\\ -4\\end{aligned}],\\,t\\in (-\\infty ,\\infty )"] ["math" "r=[\\begin{aligned}5 \\\\ 0 \\\\ 1\\end{aligned}]+t[\\begin{aligned}5 \\\\ -2 \\\\ 5\\end{aligned}],\\,t\\in (-\\infty ,\\infty )"]] "category" "ma_complete_choices" "file" "/home/jake/Develope