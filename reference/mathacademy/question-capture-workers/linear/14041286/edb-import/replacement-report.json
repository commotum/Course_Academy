          "question": "e-12444",
          "field": null,
          "attribute": "question/problem",
          "value": "Consider the straight line that passes through $P(1,2,0)$ and parallel to $\\mathbf{v}= \\langle -4,1,1 \\rangle.$ Find all the possible points $A$ on that line such that $PA=6\\sqrt{2}.$",
          "category": "ma_capture",
          "file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041286/example-12444.json",
