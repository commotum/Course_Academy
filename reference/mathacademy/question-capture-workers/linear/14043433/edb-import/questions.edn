#{[{:db/id #edb/ref 17592186060381 :knowledge-point/_questions [{:knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "925f58ea-7012-53dc-80f4-9fb77516328b" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186059270} {:answer/id #uuid "eabd78e4-02aa-5a26-9e74-b33ff7398276" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186059271} {:answer/id #uuid "fae3c952-6454-528c-ae70-9a57815ff1ef" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186059272} {:answer/id #uuid "3a48b213-3fc9-5909-b0f8-e252cc9152fc" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186059273} {:answer/id #uuid "58560319-7a4b-576a-bded-606ccbf3bc6e" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186059274}] :answer-field/correct {:answer/id #uuid "fae3c952-6454-528c-ae70-9a57815ff1ef" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186059272} :answer-field/id #uuid "25221b48-60ba-5400-b499-5bb9876737c6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186059269}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c4279505-241a-54e3-b9b3-ff9b46d09cfd" :question/math-academy-id "q-9838" :question/problem "Which of the following statements are true regarding the matrix $F$ given below?\n\n- $det(F)=0$\n- $F$ is a singular matrix\n- $det(F)=-2$\n\n$$\nF=[\\begin{aligned}0 & 1 & 2 \\\\ 3 & 4 & 5 \\\\ 6 & 7 & 8\\end{aligned}]\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(F) & =|\\begin{aligned}0 & 1 & 2 \\\\ 3 & 4 & 5 \\\\ 6 & 7 & 8\\end{aligned}| \\\\  & =0|\\begin{aligned}4 & 5 \\\\ 7 & 8\\end{aligned}|-1|\\begin{aligned}3 & 5 \\\\ 6 & 8\\end{aligned}|+2|\\begin{aligned}3 & 4 \\\\ 6 & 7\\end{aligned}| \\\\  & =0-1(24-30)+2(21-24) \\\\  & =0-1\\cdot (-6)+2\\cdot (-3) \\\\  & =6-6 \\\\  & =0\\end{aligned}\n$$\n\nSince $det(F)=0$, the matrix is singular. \n\nTherefore, only statements I and II are true."}] [{:db/id #edb/ref 17592186277650 :knowledge-point/_questions [{:knowledge-point/id #uuid "ab642ad6-d9e0-5734-83b4-81627b9132eb" :knowledge-point/title "Solving for an Unknown Given the Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51382d8f-40c3-51e7-b57e-261ef523580b" :answer/type {:db/ident :answer.type/text} :answer/value "Any real number" :db/id #edb/ref 17592186277652} {:answer/id #uuid "9b2aea28-f5d5-53a7-ab57-98ae2e45d344" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186277653} {:answer/id #uuid "5dd7dfb3-ed51-511d-97a5-5d37bbf05f2e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186277654} {:answer/id #uuid "60cd1aa0-9c13-548c-9c36-9269a0a86cd6" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186277655} {:answer/id #uuid "17bc47cd-2650-54a4-bf03-440c67712066" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186277656}] :answer-field/correct {:answer/id #uuid "17bc47cd-2650-54a4-bf03-440c67712066" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186277656} :answer-field/id #uuid "0bc5eb2e-fb99-57ba-a9fd-e41bc608475c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277651}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "5ba59bbc-ac1b-582d-8785-4e8bf9593306" :question/math-academy-id "q-9961" :question/problem "Given that the determinant of  $[\\begin{aligned}1 & n & 0 \\\\ 1 & 2 & 0 \\\\ -1 & 1 & 2\\end{aligned}]$ is $-6$, find the value of $n.$" :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $n:$\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & n & 0 \\\\ 1 & 2 & 0 \\\\ -1 & 1 & 2\\end{aligned}| & =1|\\begin{aligned}2 & 0 \\\\ 1 & 2\\end{aligned}|-n|\\begin{aligned}1 & 0 \\\\ -1 & 2\\end{aligned}|+0|\\begin{aligned}1 & 2 \\\\ -1 & 1\\end{aligned}| \\\\  & =4-n\\cdot 2+0 \\\\  & =4-2n\\end{aligned}\n$$\n\nSince the determinant of the matrix is $-6,$ we have:\n\n$$\n\\begin{aligned}4-2n & =-6 \\\\ -2n & =-10 \\\\ n & =5\\end{aligned}\n$$"}]}
