[{:db/id "q-69834/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "56ffd456-b1a8-5482-99ba-d0fd44f28177" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-69834/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "b701d13a-6d7c-5c2e-af31-553ee940d637" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-69834/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "2cf67513-e616-5396-9606-9a712c18313b" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-69834/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "0642cdce-55f9-54eb-b634-9b93f16a374e" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-69834/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "c4ca3280-98a6-5a16-8d21-d6e0ea4f6831" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-69834/selection" :answer-field/id #uuid "fcadcf19-fe11-5db7-801e-df274b9bd8ab" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-69834/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer-field/choices ["q-69834/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-69834/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-69834/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-69834/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-69834/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b"] :db/ensure [:answer-field/validate]} {:db/id "q-69834" :question/id #uuid "d8552c68-18e3-5895-ac27-d2772f0662c0" :question/math-academy-id "q-69834" :question/problem "Which of the following statements are true regarding the matrix $M$ given below?\n\n- $M$ is a singular matrix\n- $det(M)=1$\n- $det(M)=0$\n\n \n\n$$\nM=[\\begin{aligned}1 & -2 & 1 \\\\ 1 & 2 & 3 \\\\ -2 & 4 & -2\\end{aligned}]\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}1 & -2 & 1 \\\\ 1 & 2 & 3 \\\\ -2 & 4 & -2\\end{aligned}| \\\\  & =1|\\begin{aligned}2 & 3 \\\\ 4 & -2\\end{aligned}|-(-2)|\\begin{aligned}1 & 3 \\\\ -2 & -2\\end{aligned}|+1|\\begin{aligned}1 & 2 \\\\ -2 & 4\\end{aligned}| \\\\  & =1(-4-12)+2(-2+6)+1(4+4) \\\\  & =1\\cdot (-16)+2\\cdot 4+1\\cdot 8 \\\\  & =-16+8+8 \\\\  & =0\\end{aligned}\n$$\n\n \n\nSince $det(M)=0$, the matrix is singular. \n\nTherefore, only statements I and III are true." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-69834/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93"] :knowledge-point/questions ["q-69834"] :db/ensure [:knowledge-point/validate]} {:db/id "q-128506/selection/3289be10a0ed40f3d8e5078881b070f192c654c7c1d8f0236d425b96917628be" :answer/id #uuid "e053aafa-15e9-53d8-b693-05a611f29ea3" :answer/type :answer.type/text :answer/value "$4$ and $8$ only" :db/ensure [:answer/validate]} {:db/id "q-128506/selection/b906b4610516c73f6280b1bd35cdf65e2816c65cf4b896fa3880d4fd5e9be1f2" :answer/id #uuid "308cd1c5-fdc4-50d9-a9ee-e91c144ed145" :answer/type :answer.type/text :answer/value "$8$ only" :db/ensure [:answer/validate]} {:db/id "q-128506/selection/c41aeb7850b2292409db5f056fb1e9a6c39ab13305ebddd56f7590a2bff74e02" :answer/id #uuid "d6454265-e507-5721-bd63-f7e365b93e7b" :answer/type :answer.type/text :answer/value "$-6$ and $3$ only" :db/ensure [:answer/validate]} {:db/id "q-128506/selection/2f817eb15f994caf46175717f58bb0f51c9b451dbd74a973fe420ad3a98f96f2" :answer/id #uuid "d5864ebc-bd7f-518a-ae9b-cfcd1031f011" :answer/type :answer.type/text :answer/value "$1$ only" :db/ensure [:answer/validate]} {:db/id "q-128506/selection/93f2e90b0704a06587c464fa2e716f8ef3d62513200f4c4f5edd2c58a353b0ab" :answer/id #uuid "8d870840-8390-59b1-9bf4-6f4cc2c09cf8" :answer/type :answer.type/text :answer/value "$-5$ and $1$ only" :db/ensure [:answer/validate]} {:db/id "q-128506/selection" :answer-field/id #uuid "653b22c2-ac63-55f3-b4fb-7b1a85208b53" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-128506/selection/3289be10a0ed40f3d8e5078881b070f192c654c7c1d8f0236d425b96917628be" :answer-field/choices ["q-128506/selection/3289be10a0ed40f3d8e5078881b070f192c654c7c1d8f0236d425b96917628be" "q-128506/selection/b906b4610516c73f6280b1bd35cdf65e2816c65cf4b896fa3880d4fd5e9be1f2" "q-128506/selection/c41aeb7850b2292409db5f056fb1e9a6c39ab13305ebddd56f7590a2bff74e02" "q-128506/selection/2f817eb15f994caf46175717f58bb0f51c9b451dbd74a973fe420ad3a98f96f2" "q-128506/selection/93f2e90b0704a06587c464fa2e716f8ef3d62513200f4c4f5edd2c58a353b0ab"] :db/ensure [:answer-field/validate]} {:db/id "q-128506" :question/id #uuid "30a80f14-b653-5ec9-a12d-20d43bb40f91" :question/math-academy-id "q-128506" :question/problem "Given that the determinant of\n$[\\begin{aligned}1 & 6 & m \\\\ m & 3 & 0 \\\\ 2 & 1 & 1\\end{aligned}]$\nis $-29$, find all the possible values of $m.$" :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $m:$\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 6 & m \\\\ m & 3 & 0 \\\\ 2 & 1 & 1\\end{aligned}| & =1|\\begin{aligned}3 & 0 \\\\ 1 & 1\\end{aligned}|-6|\\begin{aligned}m & 0 \\\\ 2 & 1\\end{aligned}|+m|\\begin{aligned}m & 3 \\\\ 2 & 1\\end{aligned}| \\\\  & =(3-0)-6(m-0)+m(m-6) \\\\  & =3-6m+{m}^{2}-6m \\\\  & ={m}^{2}-12m+3\\end{aligned}\n$$\n\nSince the determinant of the matrix is $-29,$ we have:\n\n$$\n\\begin{aligned}{m}^{2}-12m+3 & =-29 \\\\ {m}^{2}-12m+32 & =0 \\\\ m & =\\frac{-(-12)\\pm \\sqrt{{12}^{2}-4\\cdot 1\\cdot 32}}{2\\cdot 1} \\\\  & =\\frac{12\\pm \\sqrt{16}}{2} \\\\  & =\\frac{12\\pm 4}{2} \\\\  & =6\\pm 2\\end{aligned}\n$$\n\nTherefore, the solutions are $m=4$ and $m=8.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-128506/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ab642ad6-d9e0-5734-83b4-81627b9132eb"] :knowledge-point/questions ["q-128506"] :db/ensure [:knowledge-point/validate]} {:db/id "q-280400/field-1/2fadfe0151f1f25e0ae6e00d2197f0e94fbc34184c655065ac97e6df3ba2d294" :answer/id #uuid "b68a947e-90bb-585f-9170-1a0941101983" :answer/type :answer.type/math :answer/value "69" :db/ensure [:answer/validate]} {:db/id "q-280400/field-1" :answer-field/id #uuid "ba0639e0-b406-58d8-8dd8-31ce1bc6e3ba" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-280400/field-1/2fadfe0151f1f25e0ae6e00d2197f0e94fbc34184c655065ac97e6df3ba2d294" :answer-field/choices ["q-280400/field-1/2fadfe0151f1f25e0ae6e00d2197f0e94fbc34184c655065ac97e6df3ba2d294"] :db/ensure [:answer-field/validate]} {:db/id "q-280400" :question/id #uuid "dde6084a-f22b-521b-8f63-80fc44758374" :question/math-academy-id "q-280400" :question/problem "If $W=[\\begin{aligned}5 & -2 & 3 \\\\ -1 & 4 & 6 \\\\ 2 & -3 & 1\\end{aligned}],$ then $det(W)=${{field-1}}." :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}5 & -2 & 3 \\\\ -1 & 4 & 6 \\\\ 2 & -3 & 1\\end{aligned}| & =5|\\begin{aligned}4 & 6 \\\\ -3 & 1\\end{aligned}|-(-2)|\\begin{aligned}-1 & 6 \\\\ 2 & 1\\end{aligned}|+3|\\begin{aligned}-1 & 4 \\\\ 2 & -3\\end{aligned}| \\\\  & =5(4\\cdot 1-6\\cdot (-3))+2((-1)(1)-6\\cdot 2)+3((-1)(-3)-4\\cdot 2) \\\\  & =5(4+18)+2(-1-12)+3(3-8) \\\\  & =5(22)+2(-13)+3(-5) \\\\  & =110-26-15 \\\\  & =69\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-280400/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "979859e4-b60c-548d-8da6-b180400e1b07"] :knowledge-point/questions ["q-280400"] :db/ensure [:knowledge-point/validate]}]
