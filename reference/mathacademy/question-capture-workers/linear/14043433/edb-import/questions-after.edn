#{[{:db/id #edb/ref 17592186320311 :knowledge-point/_questions [{:knowledge-point/id #uuid "ab642ad6-d9e0-5734-83b4-81627b9132eb" :knowledge-point/title "Solving for an Unknown Given the Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d5864ebc-bd7f-518a-ae9b-cfcd1031f011" :answer/type {:db/ident :answer.type/text} :answer/value "$1$ only" :db/id #edb/ref 17592186320313} {:answer/id #uuid "e053aafa-15e9-53d8-b693-05a611f29ea3" :answer/type {:db/ident :answer.type/text} :answer/value "$4$ and $8$ only" :db/id #edb/ref 17592186320314} {:answer/id #uuid "8d870840-8390-59b1-9bf4-6f4cc2c09cf8" :answer/type {:db/ident :answer.type/text} :answer/value "$-5$ and $1$ only" :db/id #edb/ref 17592186320315} {:answer/id #uuid "308cd1c5-fdc4-50d9-a9ee-e91c144ed145" :answer/type {:db/ident :answer.type/text} :answer/value "$8$ only" :db/id #edb/ref 17592186320316} {:answer/id #uuid "d6454265-e507-5721-bd63-f7e365b93e7b" :answer/type {:db/ident :answer.type/text} :answer/value "$-6$ and $3$ only" :db/id #edb/ref 17592186320317}] :answer-field/correct {:answer/id #uuid "e053aafa-15e9-53d8-b693-05a611f29ea3" :answer/type {:db/ident :answer.type/text} :answer/value "$4$ and $8$ only" :db/id #edb/ref 17592186320314} :answer-field/id #uuid "653b22c2-ac63-55f3-b4fb-7b1a85208b53" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186320312}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "30a80f14-b653-5ec9-a12d-20d43bb40f91" :question/math-academy-id "q-128506" :question/problem "Given that the determinant of\n$[\\begin{aligned}1 & 6 & m \\\\ m & 3 & 0 \\\\ 2 & 1 & 1\\end{aligned}]$\nis $-29$, find all the possible values of $m.$" :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $m:$\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 6 & m \\\\ m & 3 & 0 \\\\ 2 & 1 & 1\\end{aligned}| & =1|\\begin{aligned}3 & 0 \\\\ 1 & 1\\end{aligned}|-6|\\begin{aligned}m & 0 \\\\ 2 & 1\\end{aligned}|+m|\\begin{aligned}m & 3 \\\\ 2 & 1\\end{aligned}| \\\\  & =(3-0)-6(m-0)+m(m-6) \\\\  & =3-6m+{m}^{2}-6m \\\\  & ={m}^{2}-12m+3\\end{aligned}\n$$\n\nSince the determinant of the matrix is $-29,$ we have:\n\n$$\n\\begin{aligned}{m}^{2}-12m+3 & =-29 \\\\ {m}^{2}-12m+32 & =0 \\\\ m & =\\frac{-(-12)\\pm \\sqrt{{12}^{2}-4\\cdot 1\\cdot 32}}{2\\cdot 1} \\\\  & =\\frac{12\\pm \\sqrt{16}}{2} \\\\  & =\\frac{12\\pm 4}{2} \\\\  & =6\\pm 2\\end{aligned}\n$$\n\nTherefore, the solutions are $m=4$ and $m=8.$"}] [{:db/id #edb/ref 17592186320318 :knowledge-point/_questions [{:knowledge-point/id #uuid "979859e4-b60c-548d-8da6-b180400e1b07" :knowledge-point/title "Calculating the Determinant of a 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b68a947e-90bb-585f-9170-1a0941101983" :answer/type {:db/ident :answer.type/math} :answer/value "69" :db/id #edb/ref 17592186320320}] :answer-field/correct {:answer/id #uuid "b68a947e-90bb-585f-9170-1a0941101983" :answer/type {:db/ident :answer.type/math} :answer/value "69" :db/id #edb/ref 17592186320320} :answer-field/id #uuid "ba0639e0-b406-58d8-8dd8-31ce1bc6e3ba" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320319}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "dde6084a-f22b-521b-8f63-80fc44758374" :question/math-academy-id "q-280400" :question/problem "If $W=[\\begin{aligned}5 & -2 & 3 \\\\ -1 & 4 & 6 \\\\ 2 & -3 & 1\\end{aligned}],$ then $det(W)=${{field-1}}." :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}5 & -2 & 3 \\\\ -1 & 4 & 6 \\\\ 2 & -3 & 1\\end{aligned}| & =5|\\begin{aligned}4 & 6 \\\\ -3 & 1\\end{aligned}|-(-2)|\\begin{aligned}-1 & 6 \\\\ 2 & 1\\end{aligned}|+3|\\begin{aligned}-1 & 4 \\\\ 2 & -3\\end{aligned}| \\\\  & =5(4\\cdot 1-6\\cdot (-3))+2((-1)(1)-6\\cdot 2)+3((-1)(-3)-4\\cdot 2) \\\\  & =5(4+18)+2(-1-12)+3(3-8) \\\\  & =5(22)+2(-13)+3(-5) \\\\  & =110-26-15 \\\\  & =69\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186320321 :knowledge-point/_questions [{:knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b701d13a-6d7c-5c2e-af31-553ee940d637" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186320323} {:answer/id #uuid "c4ca3280-98a6-5a16-8d21-d6e0ea4f6831" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186320324} {:answer/id #uuid "2cf67513-e616-5396-9606-9a712c18313b" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186320325} {:answer/id #uuid "56ffd456-b1a8-5482-99ba-d0fd44f28177" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186320326} {:answer/id #uuid "0642cdce-55f9-54eb-b634-9b93f16a374e" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186320327}] :answer-field/correct {:answer/id #uuid "b701d13a-6d7c-5c2e-af31-553ee940d637" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186320323} :answer-field/id #uuid "fcadcf19-fe11-5db7-801e-df274b9bd8ab" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186320322}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d8552c68-18e3-5895-ac27-d2772f0662c0" :question/math-academy-id "q-69834" :question/problem "Which of the following statements are true regarding the matrix $M$ given below?\n\n- $M$ is a singular matrix\n- $det(M)=1$\n- $det(M)=0$\n\n \n\n$$\nM=[\\begin{aligned}1 & -2 & 1 \\\\ 1 & 2 & 3 \\\\ -2 & 4 & -2\\end{aligned}]\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}1 & -2 & 1 \\\\ 1 & 2 & 3 \\\\ -2 & 4 & -2\\end{aligned}| \\\\  & =1|\\begin{aligned}2 & 3 \\\\ 4 & -2\\end{aligned}|-(-2)|\\begin{aligned}1 & 3 \\\\ -2 & -2\\end{aligned}|+1|\\begin{aligned}1 & 2 \\\\ -2 & 4\\end{aligned}| \\\\  & =1(-4-12)+2(-2+6)+1(4+4) \\\\  & =1\\cdot (-16)+2\\cdot 4+1\\cdot 8 \\\\  & =-16+8+8 \\\\  & =0\\end{aligned}\n$$\n\n \n\nSince $det(M)=0$, the matrix is singular. \n\nTherefore, only statements I and III are true."}] [{:db/id #edb/ref 17592186060381 :knowledge-point/_questions [{:knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "925f58ea-7012-53dc-80f4-9fb77516328b" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186059270} {:answer/id #uuid "eabd78e4-02aa-5a26-9e74-b33ff7398276" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186059271} {:answer/id #uuid "fae3c952-6454-528c-ae70-9a57815ff1ef" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186059272} {:answer/id #uuid "3a48b213-3fc9-5909-b0f8-e252cc9152fc" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186059273} {:answer/id #uuid "58560319-7a4b-576a-bded-606ccbf3bc6e" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186059274}] :answer-field/correct {:answer/id #uuid "fae3c952-6454-528c-ae70-9a57815ff1ef" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186059272} :answer-field/id #uuid "25221b48-60ba-5400-b499-5bb9876737c6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186059269}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c4279505-241a-54e3-b9b3-ff9b46d09cfd" :question/math-academy-id "q-9838" :question/problem "Which of the following statements are true regarding the matrix $F$ given below?\n\n- $det(F)=0$\n- $F$ is a singular matrix\n- $det(F)=-2$\n\n$$\nF=[\\begin{aligned}0 & 1 & 2 \\\\ 3 & 4 & 5 \\\\ 6 & 7 & 8\\end{aligned}]\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(F) & =|\\begin{aligned}0 & 1 & 2 \\\\ 3 & 4 & 5 \\\\ 6 & 7 & 8\\end{aligned}| \\\\  & =0|\\begin{aligned}4 & 5 \\\\ 7 & 8\\end{aligned}|-1|\\begin{aligned}3 & 5 \\\\ 6 & 8\\end{aligned}|+2|\\begin{aligned}3 & 4 \\\\ 6 & 7\\end{aligned}| \\\\  & =0-1(24-30)+2(21-24) \\\\  & =0-1\\cdot (-6)+2\\cdot (-3) \\\\  & =6-6 \\\\  & =0\\end{aligned}\n$$\n\nSince $det(F)=0$, the matrix is singular. \n\nTherefore, only statements I and II are true."}] [{:db/id #edb/ref 17592186277650 :knowledge-point/_questions [{:knowledge-point/id #uuid "ab642ad6-d9e0-5734-83b4-81627b9132eb" :knowledge-point/title "Solving for an Unknown Given the Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51382d8f-40c3-51e7-b57e-261ef523580b" :answer/type {:db/ident :answer.type/text} :answer/value "Any real number" :db/id #edb/ref 17592186277652} {:answer/id #uuid "9b2aea28-f5d5-53a7-ab57-98ae2e45d344" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186277653} {:answer/id #uuid "5dd7dfb3-ed51-511d-97a5-5d37bbf05f2e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186277654} {:answer/id #uuid "60cd1aa0-9c13-548c-9c36-9269a0a86cd6" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186277655} {:answer/id #uuid "17bc47cd-2650-54a4-bf03-440c67712066" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186277656}] :answer-field/correct {:answer/id #uuid "17bc47cd-2650-54a4-bf03-440c67712066" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186277656} :answer-field/id #uuid "0bc5eb2e-fb99-57ba-a9fd-e41bc608475c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277651}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "5ba59bbc-ac1b-582d-8785-4e8bf9593306" :question/math-academy-id "q-9961" :question/problem "Given that the determinant of  $[\\begin{aligned}1 & n & 0 \\\\ 1 & 2 & 0 \\\\ -1 & 1 & 2\\end{aligned}]$ is $-6$, find the value of $n.$" :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $n:$\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & n & 0 \\\\ 1 & 2 & 0 \\\\ -1 & 1 & 2\\end{aligned}| & =1|\\begin{aligned}2 & 0 \\\\ 1 & 2\\end{aligned}|-n|\\begin{aligned}1 & 0 \\\\ -1 & 2\\end{aligned}|+0|\\begin{aligned}1 & 2 \\\\ -1 & 1\\end{aligned}| \\\\  & =4-n\\cdot 2+0 \\\\  & =4-2n\\end{aligned}\n$$\n\nSince the determinant of the matrix is $-6,$ we have:\n\n$$\n\\begin{aligned}4-2n & =-6 \\\\ -2n & =-10 \\\\ n & =5\\end{aligned}\n$$"}]}
