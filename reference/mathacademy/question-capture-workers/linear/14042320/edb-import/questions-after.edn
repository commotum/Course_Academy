#{[{:db/id #edb/ref 17592186198696 :knowledge-point/_questions [{:knowledge-point/id #uuid "739c04ac-6d0c-5173-aa91-b5cc4dec8128" :knowledge-point/title "Sets Defined Using Quadratic Equations and Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02263737-89e4-527f-b87d-0f369b7a010e" :answer/type {:db/ident :answer.type/math} :answer/value "{0, ± 1, ± 2, ± 3, …}" :db/id #edb/ref 17592186195127} {:answer/id #uuid "0699d145-9b77-56b5-b77c-765ac913f6da" :answer/type {:db/ident :answer.type/math} :answer/value "{…,-3 - 2,-1, 0, 1, 2}" :db/id #edb/ref 17592186195128} {:answer/id #uuid "1183e42c-adf9-5ac4-a75f-c7e6977d5a47" :answer/type {:db/ident :answer.type/math} :answer/value "{0, ± 1, ± 2}" :db/id #edb/ref 17592186195129} {:answer/id #uuid "309b5985-78ab-5652-86ab-74463ae0f435" :answer/type {:db/ident :answer.type/math} :answer/value "{-2,-1, 0, 1, 2, 3, 4, 5, 6, …}" :db/id #edb/ref 17592186195130} {:answer/id #uuid "6f664c64-2fcd-587a-8b50-d37bebc69ccf" :answer/type {:db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186195131}] :answer-field/correct {:answer/id #uuid "1183e42c-adf9-5ac4-a75f-c7e6977d5a47" :answer/type {:db/ident :answer.type/math} :answer/value "{0, ± 1, ± 2}" :db/id #edb/ref 17592186195129} :answer-field/id #uuid "9e43ffa4-9618-587e-adde-7017eeecc7ac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186195126}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "710d25bf-4f78-5b5f-87a8-342e13f707d3" :question/math-academy-id "q-180761" :question/problem "Which set is equivalent to $A={k\\in Z:{k}^{2}+1\\le 5}?$" :question/worked-solution "The elements of the given set are the integers that satisfy the inequality ${k}^{2}+1\\le 5.$ \n\nSo, we first need to solve our inequality for $k:$\n\n$$\n\\begin{aligned}{k}^{2}+1 & \\le 5 \\\\ {k}^{2} & \\le 4 \\\\ \\sqrt{{k}^{2}} & \\le \\sqrt{4} \\\\ |k| & \\le 2 \\\\ -2\\le k & \\le 2\\end{aligned}\n$$\n\nThe integer solutions of the inequality above are $0,\\pm 1,\\pm 2.$ Therefore, the given set can be written as \n\n$$\nA={0,\\pm 1,\\pm 2}.\n$$"}] [{:db/id #edb/ref 17592186338293 :knowledge-point/_questions [{:knowledge-point/id #uuid "739c04ac-6d0c-5173-aa91-b5cc4dec8128" :knowledge-point/title "Sets Defined Using Quadratic Equations and Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36ce5b93-7bd2-59b6-ab9d-7e1e8599a92f" :answer/type {:db/ident :answer.type/math} :answer/value "{1}" :db/id #edb/ref 17592186338295} {:answer/id #uuid "c7d4d0c5-734d-5b7c-81a1-301c185eec87" :answer/type {:db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186338296} {:answer/id #uuid "9a1845fe-427c-54da-bcc9-ca71224f84e1" :answer/type {:db/ident :answer.type/math} :answer/value "C" :db/id #edb/ref 17592186338297} {:answer/id #uuid "f84b70cf-7b64-53af-a24a-3adc214a9611" :answer/type {:db/ident :answer.type/math} :answer/value "{\\pm \\text{i}}" :db/id #edb/ref 17592186338298} {:answer/id #uuid "9492cba5-d475-5f26-be7b-dfba6321622f" :answer/type {:db/ident :answer.type/math} :answer/value "{\\pm 1}" :db/id #edb/ref 17592186338299}] :answer-field/correct {:answer/id #uuid "c7d4d0c5-734d-5b7c-81a1-301c185eec87" :answer/type {:db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186338296} :answer-field/id #uuid "2026e7ad-0e62-56fa-bd37-d30b754e67f2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338294}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "aebc17a9-1c9a-5a0d-b525-dec4f8fd7314" :question/math-academy-id "q-181137" :question/problem "Which set is equivalent to $A={x\\in R:{x}^{2}+1=0}?$" :question/worked-solution "The elements of the given set are the real numbers that satisfy the equation ${x}^{2}+1=0.$ \n\nSo, we first need to solve our equation for $x:$\n\n$$\n\\begin{aligned}{x}^{2}+1 & =0 \\\\ {x}^{2} & =-1 \\\\ x & =\\pm \\sqrt{-1} \\\\ x & =\\pm \\text{i}\\end{aligned}\n$$\n\nHowever, since $x\\in R$ and $\\pm \\text{i}\\notin R,$ we conclude that the set $A$ contains no elements. Hence, $A=∅.$"}] [{:db/id #edb/ref 17592186338300 :knowledge-point/_questions [{:knowledge-point/id #uuid "7c2ae57a-fde8-5d07-bbff-e66fbd4428b0" :knowledge-point/title "Sets Defined Using Absolute Value Equations and Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0889503b-7459-5428-b6f7-435c4bdae754" :answer/type {:db/ident :answer.type/math} :answer/value "{1,2,3,…,12}" :db/id #edb/ref 17592186338302} {:answer/id #uuid "41e34018-3b30-5acb-9b08-e22922f7cfcd" :answer/type {:db/ident :answer.type/math} :answer/value "[-12.12]" :db/id #edb/ref 17592186338303} {:answer/id #uuid "e16d041c-1090-5638-879f-bea05e66db5b" :answer/type {:db/ident :answer.type/math} :answer/value "{12}" :db/id #edb/ref 17592186338304} {:answer/id #uuid "88265b41-45fb-5ef3-958c-eb3a10319760" :answer/type {:db/ident :answer.type/math} :answer/value "[0,12]" :db/id #edb/ref 17592186338305} {:answer/id #uuid "90b93aa6-d4ed-5f83-83d6-0a1058ac0bee" :answer/type {:db/ident :answer.type/math} :answer/value "{-12,12}" :db/id #edb/ref 17592186338306}] :answer-field/correct {:answer/id #uuid "e16d041c-1090-5638-879f-bea05e66db5b" :answer/type {:db/ident :answer.type/math} :answer/value "{12}" :db/id #edb/ref 17592186338304} :answer-field/id #uuid "658389d5-ddb9-5195-a3d8-65799c8a671d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338301}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3946abdb-e383-543e-aba2-99064e3e9d6b" :question/math-academy-id "q-181767" :question/problem "Which set is equivalent to $A={n\\in N:|\\frac{n}{4}|=3}?$" :question/worked-solution "The elements of the given set are the natural numbers that satisfy the equation $|\\frac{n}{4}|=3.$ So, we first need to solve for $n:$\n\n$$\n\\begin{aligned}|\\frac{n}{4}| & =3 \\\\ \\frac{n}{4} & =\\pm 3 \\\\ n & =\\pm 12 \\\\ n & =-12,12\\end{aligned}\n$$\n\nThe solutions are $n=-12$ and $n=12.$ However, since $-12\\notin N,$ we conclude that the set $A$ contains only one element, namely $n=12.$\n\nTherefore, we can write the given set as\n\n$$\nA={12}.\n$$"}] [{:db/id #edb/ref 17592186338307 :knowledge-point/_questions [{:knowledge-point/id #uuid "74611c25-8501-52a7-a705-b7e9f8f6b8ee" :knowledge-point/title "Sets Defined Using Trigonometric Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "78a150d0-1cb3-5fc1-ac94-cbb319dbc0d4" :answer/type {:db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186338309} {:answer/id #uuid "d9147e5a-8a14-5124-9a96-42c38beccbf4" :answer/type {:db/ident :answer.type/math} :answer/value "{\\pm 1,\\pm 2,\\pm 3,\\pm 4,…}" :db/id #edb/ref 17592186338310} {:answer/id #uuid "b38c8678-5a6a-5b35-ab86-b048cb702565" :answer/type {:db/ident :answer.type/math} :answer/value "{N}_{0}" :db/id #edb/ref 17592186338311} {:answer/id #uuid "a2d3957f-1880-5773-bce1-928cac74894c" :answer/type {:db/ident :answer.type/math} :answer/value "{0,2,4,6,8,…}" :db/id #edb/ref 17592186338312} {:answer/id #uuid "a0a9c50e-7ed4-5445-b83b-1163cf1f80cb" :answer/type {:db/ident :answer.type/math} :answer/value "{0,\\,\\pm 2,\\,\\pm 4,\\,\\pm 6,\\,…}" :db/id #edb/ref 17592186338313}] :answer-field/correct {:answer/id #uuid "a0a9c50e-7ed4-5445-b83b-1163cf1f80cb" :answer/type {:db/ident :answer.type/math} :answer/value "{0,\\,\\pm 2,\\,\\pm 4,\\,\\pm 6,\\,…}" :db/id #edb/ref 17592186338313} :answer-field/id #uuid "e48bb30d-57b3-5780-b82c-91026f2e5a9a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338308}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "9fa8eea4-ecef-5654-b399-3872ddbe93b8" :question/math-academy-id "q-181787" :question/problem "Which set is equivalent to $A={x\\in R:\\operatorname{cos}⁡(\\pi x)=1}?$" :question/worked-solution "Notice that the solutions to the equation\n\n$$\n\\operatorname{cos}⁡(\\pi x)=1\n$$\n\n are given by\n\n$$\n\\begin{aligned}\\pi x & =2n\\pi  \\\\ x & =2n\\end{aligned}\n$$\n\nwhere $n\\in Z.$ \n\nSubstituting different values of $n,$ we see that the solutions are\n\n$$\nx=0,\\,\\pm 2,\\,\\pm 4,\\,\\pm 6,\\,…\n$$\n\nTherefore, our set $A$ is equivalent to \n\n$$\nA={0,\\,\\pm 2,\\,\\pm 4,\\,\\pm 6,\\,…}.\n$$"}] [{:db/id #edb/ref 17592186338314 :knowledge-point/_questions [{:knowledge-point/id #uuid "74611c25-8501-52a7-a705-b7e9f8f6b8ee" :knowledge-point/title "Sets Defined Using Trigonometric Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c0eb89c9-84c5-51d7-afbd-e51045df25c7" :answer/type {:db/ident :answer.type/math} :answer/value "N" :db/id #edb/ref 17592186338316} {:answer/id #uuid "6747da73-9ddc-50bd-9f4d-b8e002542f95" :answer/type {:db/ident :answer.type/math} :answer/value "{\\pm \\frac{1}{2},\\,\\pm \\frac{3}{2},\\,\\pm \\frac{5}{2},\\,…}" :db/id #edb/ref 17592186338317} {:answer/id #uuid "b2ea2a58-f7a7-5438-a67a-267b9f820996" :answer/type {:db/ident :answer.type/math} :answer/value "{1,3,5,7,9,…}" :db/id #edb/ref 17592186338318} {:answer/id #uuid "4121c576-624d-593a-b6ac-7841c3c4d88c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\frac{1}{2},\\,\\frac{3}{2},\\,\\frac{5}{2},\\,…}" :db/id #edb/ref 17592186338319} {:answer/id #uuid "a00d5c51-016f-59a2-9fef-01990d0cb0c8" :answer/type {:db/ident :answer.type/math} :answer/value "{1,\\frac{1}{2},2,\\frac{3}{2},3,\\frac{5}{2},…}" :db/id #edb/ref 17592186338320}] :answer-field/correct {:answer/id #uuid "6747da73-9ddc-50bd-9f4d-b8e002542f95" :answer/type {:db/ident :answer.type/math} :answer/value "{\\pm \\frac{1}{2},\\,\\pm \\frac{3}{2},\\,\\pm \\frac{5}{2},\\,…}" :db/id #edb/ref 17592186338317} :answer-field/id #uuid "8d8e2c9a-ae4b-5e1c-9670-38f6deef9ad5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338315}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "2abf339e-22e7-5c7c-96bd-5424e69802dd" :question/math-academy-id "q-181788" :question/problem "Which set is equivalent to $A={x\\in R:\\operatorname{cos}⁡(2\\pi x)=-1}?$" :question/worked-solution "Notice that the solutions to the equation\n\n$$\n\\operatorname{cos}⁡(2\\pi x)=-1\n$$\n\n are given by\n\n$$\n\\begin{aligned}2\\pi x & =\\pi +2n\\pi  \\\\ 2x & =1+2n \\\\ x & =\\frac{1}{2}+n\\end{aligned}\n$$\n\nwhere $n\\in Z.$ \n\nSubstituting different values of $n,$ we see that the solutions are\n\n$$\nx=\\pm \\frac{1}{2},\\,\\pm \\frac{3}{2},\\,\\pm \\frac{5}{2},\\,…\n$$\n\nTherefore, our set $A$ is equivalent to \n\n$$\nA={\\pm \\frac{1}{2},\\,\\pm \\frac{3}{2},\\,\\pm \\frac{5}{2},\\,…}.\n$$"}]}
