[{:db/id [:question/math-academy-id "q-180761"] :question/problem "Which set is equivalent to $A={k\\in Z:{k}^{2}+1\\le 5}?$" :question/worked-solution "The elements of the given set are the integers that satisfy the inequality ${k}^{2}+1\\le 5.$ \n\nSo, we first need to solve our inequality for $k:$\n\n$$\n\\begin{aligned}{k}^{2}+1 & \\le 5 \\\\ {k}^{2} & \\le 4 \\\\ \\sqrt{{k}^{2}} & \\le \\sqrt{4} \\\\ |k| & \\le 2 \\\\ -2\\le k & \\le 2\\end{aligned}\n$$\n\nThe integer solutions of the inequality above are $0,\\pm 1,\\pm 2.$ Therefore, the given set can be written as \n\n$$\nA={0,\\pm 1,\\pm 2}.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-181137/selection/719647113ebe76cad325dbc727372e3e0ede722e128aae0a17f5dbcdba7eb26b" :answer/id #uuid "f84b70cf-7b64-53af-a24a-3adc214a9611" :answer/type :answer.type/math :answer/value "{\\pm \\text{i}}" :db/ensure [:answer/validate]} {:db/id "q-181137/selection/2531b01062963bf17cb1953367062769d91dcfc4519f4f6b120c5de4951d40dd" :answer/id #uuid "c7d4d0c5-734d-5b7c-81a1-301c185eec87" :answer/type :answer.type/math :answer/value "∅" :db/ensure [:answer/validate]} {:db/id "q-181137/selection/199bf851613ea946edb4e75e8324794a50da9033dd50c48435253896891f6573" :answer/id #uuid "36ce5b93-7bd2-59b6-ab9d-7e1e8599a92f" :answer/type :answer.type/math :answer/value "{1}" :db/ensure [:answer/validate]} {:db/id "q-181137/selection/5fc5100246d98d57a3a3e1d40181b00e6e8dff5d4a097ce2d7b7f6ae0b08578e" :answer/id #uuid "9a1845fe-427c-54da-bcc9-ca71224f84e1" :answer/type :answer.type/math :answer/value "C" :db/ensure [:answer/validate]} {:db/id "q-181137/selection/cb463ed95f5152893e13529103ebcc1e328c2fcce32d29e5618e9d82dbd1cb90" :answer/id #uuid "9492cba5-d475-5f26-be7b-dfba6321622f" :answer/type :answer.type/math :answer/value "{\\pm 1}" :db/ensure [:answer/validate]} {:db/id "q-181137/selection" :answer-field/id #uuid "2026e7ad-0e62-56fa-bd37-d30b754e67f2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-181137/selection/2531b01062963bf17cb1953367062769d91dcfc4519f4f6b120c5de4951d40dd" :answer-field/choices ["q-181137/selection/719647113ebe76cad325dbc727372e3e0ede722e128aae0a17f5dbcdba7eb26b" "q-181137/selection/2531b01062963bf17cb1953367062769d91dcfc4519f4f6b120c5de4951d40dd" "q-181137/selection/199bf851613ea946edb4e75e8324794a50da9033dd50c48435253896891f6573" "q-181137/selection/5fc5100246d98d57a3a3e1d40181b00e6e8dff5d4a097ce2d7b7f6ae0b08578e" "q-181137/selection/cb463ed95f5152893e13529103ebcc1e328c2fcce32d29e5618e9d82dbd1cb90"] :db/ensure [:answer-field/validate]} {:db/id "q-181137" :question/id #uuid "aebc17a9-1c9a-5a0d-b525-dec4f8fd7314" :question/math-academy-id "q-181137" :question/problem "Which set is equivalent to $A={x\\in R:{x}^{2}+1=0}?$" :question/worked-solution "The elements of the given set are the real numbers that satisfy the equation ${x}^{2}+1=0.$ \n\nSo, we first need to solve our equation for $x:$\n\n$$\n\\begin{aligned}{x}^{2}+1 & =0 \\\\ {x}^{2} & =-1 \\\\ x & =\\pm \\sqrt{-1} \\\\ x & =\\pm \\text{i}\\end{aligned}\n$$\n\nHowever, since $x\\in R$ and $\\pm \\text{i}\\notin R,$ we conclude that the set $A$ contains no elements. Hence, $A=∅.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-181137/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "739c04ac-6d0c-5173-aa91-b5cc4dec8128"] :knowledge-point/questions ["q-181137"] :db/ensure [:knowledge-point/validate]} {:db/id "q-181767/selection/77f38958efaa165e431bed9d27cfde4c6dc55787bc27d0a07aa296b01796a670" :answer/id #uuid "88265b41-45fb-5ef3-958c-eb3a10319760" :answer/type :answer.type/math :answer/value "[0,12]" :db/ensure [:answer/validate]} {:db/id "q-181767/selection/42a03c7008a82298b0bff0d1441266ec23f5c5eefd416bacefeac760346b182f" :answer/id #uuid "e16d041c-1090-5638-879f-bea05e66db5b" :answer/type :answer.type/math :answer/value "{12}" :db/ensure [:answer/validate]} {