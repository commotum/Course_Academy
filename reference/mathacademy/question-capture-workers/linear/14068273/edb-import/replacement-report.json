    {
      "question": "e-5417",
      "field": null,
      "attribute": "question/worked-solution",
      "old_sha256": "80d282a999dfd7668ae71c98029a136492d07026dca1542fb93901b9e19aac95",
      "new_sha256": "a884f6cd1af29392ce8537b5c5071baa1656e3fdb12ed1dc093836cc99edb367",
      "category": "ma_capture",
      "authoring": [],
      "source": [
        {
          "question": "e-5417",
          "field": null,
          "attribute": "question/worked-solution",
          "value": "First, notice that a matrix of rank $4$ must have at least $4$ columns and at least $4$ rows. \nSo, we disregard the matrix $B$ since it has only $3$ rows. \n\nAlso, the matrix must have $4$ pivot columns. As we can see, the matrix $A$ has only $3$ pivot columns, while the matrix $C$ has exactly $4$ pivot columns. So, $\\textrm{rank}(A)=3$ and $\\textrm{rank}(C)=4.$\n\nTherefore, the correct answer is \"$C$ only\".",
          "category": "ma_capture",
          "file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068273/example-5417.json",
          "file_sha256": "f7cc217b340376aa47fba8f06f4417691a7b9b4231223bbafeea879694b9b4bd"
        }
