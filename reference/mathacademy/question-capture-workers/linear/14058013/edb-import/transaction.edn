85c1f2cc430f8770346177d91a9604e092db9047791b12"] :db/ensure [:answer-field/validate]} {:db/id "q-130823" :question/id #uuid "ac2e42f8-d970-5a58-b537-a5e42b74e334" :question/math-academy-id "q-130823" :question/problem "Find the product ${E}_{1}{E}_{2}^{-1}$, where\n\n$$\n\\begin{aligned}{E}_{1} & =[\\begin{aligned}1 & -4 \\\\ 0 & 1\\end{aligned}],\\,{E}_{2}=[\\begin{aligned}1 & 0 \\\\ 5 & 1\\end{aligned}].\\end{aligned}\n$$" :question/worked-solution "Notice that ${E}_{1}$ and ${E}_{2}$ are both elementary matrices.\n\nFirst, we need to find ${E}_{2}^{-1}.$ We write down ${E}_{2}$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}[{E}_{2}\\,|\\,I\\,] & =[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 5 & 1 & 0 & 1\\end{aligned}] &  & {R}_{2}:={R}_{2}+(-5){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 0 & 1 & -5 & 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{E}_{2}^{-1}=[\\begin{aligned}1 & 0 \\\\ -5 & 1\\end{aligned}].\n$$\n\nNow, we can find the product ${E}_{1}{E}_{2}^{-1}:$\n\n$$\n{E}_{1}{E}_{2}^{-1}=[\\begin{aligned}1 & -4 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ -5 & 1\\end{aligned}]=[\\begin{aligned}21 & -4 \\\\ -5 & 1\\end{aligned}]\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-130823/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "dd12bc7b-1b5d-5af2-bcef-c9d0fda7d8fc"] :knowledge-point/questions ["q-130823"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73680/selection/041e870bef51308bbd2f22ddd8f1ef11c71661ea5991d52b165106aa8a5b5480" :answer/id #uuid "62363135-995f-5aa7-93e7-8e2940c26133" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-7 & 0 \\\\ 1 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-73680/selection/6ce7734e5311c48f22fdd30a00486fa813cb9a3a0cfdd08c4c8bb909906c4de1" :answer/id #uuid "cf4f1c53-fa8b-549