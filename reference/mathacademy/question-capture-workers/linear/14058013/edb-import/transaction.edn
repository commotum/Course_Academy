b8f72a4ceab66578788f3005ee6db1c2e922f939061179b2c82"] :db/ensure [:answer-field/validate]} {:db/id "q-73646" :question/id #uuid "b534169a-9dbf-54bd-873e-e260f6c5b586" :question/math-academy-id "q-73646" :question/problem "Find the inverse of the elementary matrix \n$K=[\\begin{aligned}1 & 0 \\\\ 8 & 1\\end{aligned}].$" :question/worked-solution "We write down $K$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}[K\\,|\\,I\\,] & =[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 8 & 1 & 0 & 1\\end{aligned}] &  & {R}_{2}:={R}_{2}+(-8){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 0 & 1 & -8 & 1\\end{aligned}]\\end{aligned}\n$$\n\nThe inverse is obtained on the right-hand side of our big matrix after the transformation. Therefore, \n\n$$\n{K}^{-1}=[\\begin{aligned}1 & 0 \\\\ -8 & 1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-73646/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6c56b3e9-cf23-5e1e-8c7d-c474059c9a9d"] :knowledge-point/questions ["q-73646"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130796/selection/fbaa25e655f941af43f36526dfe9789bac9f800b04c2af0eda48d9257fe5f046" :answer/id #uuid "15810dea-da40-51d8-aac1-2dec6aefc072" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 \\\\ 1 & \\frac{1}{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130796/selection/da134ed1c80aafdac7346d5b8ada9a4a4d4bb6a9a5450de745918a95a7bceea8" :answer/id #uuid "be14afdf-8ac2-52d9-86eb-94fa20fc7e50" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & \\frac{1}{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130796/selection/84b471e7916291a7f7598e386b6ad698b3c8e2a78b583ae08956b7e8c4c4060f" :answer/id #uuid "2cc9a355-46d6-5b57-8384-b24c8740554b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}