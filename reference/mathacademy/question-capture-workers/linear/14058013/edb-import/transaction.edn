{R}_{2}+10{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 0 & 1 & 10 & 1\\end{aligned}]\\end{aligned}\n$$\n\nThe inverse is obtained on the right-hand side of our big matrix after the transformation. Therefore, \n\n$$\n{B}^{-1}=[\\begin{aligned}1 & 0 \\\\ 10 & 1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-130781/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6c56b3e9-cf23-5e1e-8c7d-c474059c9a9d"] :knowledge-point/questions ["q-130781"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130812/selection/2abc8fc3c3c93780bd1fd2bf2d457d203a7a22ddbf46c5f3273eac64cb913498" :answer/id #uuid "171f43a1-dc71-56dd-882a-0ac6bd227973" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 \\\\ 24 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130812/selection/4bd7c26367b2239abed1e45652da16447c34d694a6c6fe31d5607c67a090962b" :answer/id #uuid "5cd1e573-3711-5329-a5af-9cc7a39fece8" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 \\\\ -2 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130812/selection/44e0cb435f4e3ce7baf480b15b0f958920f17eebc7929e7738fd01a1fdf62f38" :answer/id #uuid "a887798b-9e33-51e5-805f-7ad39ec536ca" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 \\\\ 24 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130812/selection/f9952e7024e76bab2bff6e344ea5386d5049c9bdb710a754c49ff26d84e01e13" :answer/id #uuid "8dde1d06-4481-574c-a4d0-6eae770ef162" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 \\\\ -4 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130812/selection/63f39ed169f4cc125119e6f9cc261a479c9995c26b7d62072a6ba73464bafaec" :answer/id #uuid "161a1904-f175-5fd5-8c4e-5ee02c38e3f6" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & -2 \\\\ -4 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130812/selection" :answer-field/id #uuid "7cb4f32b-e128-5a58-8149-720d77a8c91f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-130812/selection/4bd7c26367b2239abed1e45652da16447c34d694a6c6fe31d5607c67a090962b" :answer-field/choices ["q-130812/selection/2abc8fc3c3c93780bd1fd2bf2d457d203a7a22ddbf46c5f3273eac64cb913498" "q-130812/selection/4bd7c26367b2239abed1e45652da16447c34d694a6c6fe31d5607c67a090962b" "q-130812/selection/44e0cb435f4e3ce7baf480b15b0f958920f17eebc7929e7738fd01a1fdf62f38" "q-130812/selection/f9952e7024e76bab2bff6e344ea5386d5049c9bdb710a754c49ff26d84e01e13" "q-130812/selection/63f39ed169f4cc125119e6f9cc261a479c9995c26b7d62072a6ba73464bafaec"] :db/ensure [:answer-field/validate]} {:db/id "q-130812" :question/id #uuid "9e20cc98-116e-57df-aec7-6d2c0f8b7480" :question/math-academy-id "q-130812" :question/problem "Find the product ${E}_{1}{E}_{2}^{-1}$, where\n\n$$\n\\begin{aligned}{E}_{1} & =[\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}],\\,{E}_{2}=[\\begin{aligned}1 & 0 \\\\ 0 & -\\frac{1}{2}\\end{aligned}].\\end{aligned}\n$$" :question/worked-solution "Notice that ${E}_{1}$ and ${E}_{2}$ are both elementary matrices.\n\nFirst, we need to find ${E}_{2}^{-1}.$ We write down ${E}_{2}$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}[{E}_{2}\\,|\\,I\\,] & =[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 0 & -\\frac{1}{2} & 0 & 1\\end{aligned}] &  & {R}_{2}:=(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 0 & 1 & 0 & -2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{E}_{2}^{-1} & =[\\begin{aligned}1 & 0 \\\\ 0 & -2\\end{aligned}].\\end{aligned}\n$$\n\nNow, we can find the product ${E}_{1}{E}_{2}^{-1}:$\n\n$$\n{E}_{1}{E}_{2}^{-1}=[\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 0 & -2\\end{aligned}]=[\\begin{aligned}1 & 0 \\\\ -2 & -2\\end{aligned}]\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-130812/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "dd12bc7b-1b5d-5af2-bcef-c9d0fda7d8fc"] :knowledge-point/questions ["q-130812"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73647/selection/80db910c7ae9dc114f0d7cc028c42e455035feb0a572da0640cdf9cb5aff9633" :answer/id #uuid "5019d738-a8c5-5f3a-8b09-880f5e5960bf" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 9 \\\\ 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-73647/selection/d9275e5b8c64d5dc201371e4c9fc2d0cd6f03ae56d496c4b6f21e237a312255f" :answer/id #uuid "248e9333-4f3b-5911-8bc2-79e052106f8b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-6 & 3 \\\\ 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-73647/selection/150d4f94172dc1013d39b826c96fc3ce2c84aec2fae397a411434458da62549b" :answer/id #uuid "e1172f0d-3100-59db-a4a7-83423cce999f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 & -6 \\\\ 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-73647/selection/183e0b4340396a7156e8e1f47c98d312fe1b9c1a5277c0045835700017604852" :answer/id #uuid "1817ffa4-e84b-518d-b7d0-59e24f3f3d1e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 & 0 \\\\ -9 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-73647/selection/824a30aa4ed248fa1f69d4270fef6eb4be14abb6e25faad7d16e687712ebe16f" :answer/id #uuid "b618fa54-c2d8-5d8c-97b3-3e9fa8786624" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 1 \\\\ 3 & -9\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-73647/selection" :answer-field/id #uuid "01f4020a-dcba-5680-86e1-71984b3e0774" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73647/selection/150d4f94172dc1013d39b826c96fc3ce2c84aec2fae397a411434458da62549b" :answer-field/choices ["q-73647/selection/80db910c7ae9dc114f0d7cc028c42e455035feb0a572da0640cdf9cb5aff9633" "q-73647/selection/d9275e5b8c64d5dc201371e4c9fc2d0cd6f03ae56d496c4b6f21e237a312255f" "q-73647/selection/150d4f94172dc1013d39b826c96fc3ce2c84aec2fae397a411434458da62549b" "q-73647/selection/183e0b4340396a7156e8e1f47c98d312fe1b9c1a5277c0045835700017604852" "q-73647/selection/824a30aa4ed248fa1f69d4270fef6eb4be14abb6e25faad7d16e687712ebe16f"] :db/ensure [:answer-field/validate]} {:db/id "q-73647" :question/id #uuid "bd74f139-452a-58af-a7f9-3d3621835dfc" :question/math-academy-id "q-73647" :question/problem "Find the product ${E}_{1}{E}_{2}^{-1}$, where\n\n$$\n\\begin{aligned}{E}_{1} & =[\\begin{aligned}3 & 0 \\\\ 0 & 1\\end{aligned}],\\,{E}_{2}=[\\begin{aligned}1 & 2 \\\\ 0 & 1\\end{aligned}].\\end{aligned}\n$$" :question/worked-solution "Notice that ${E}_{1}$ and ${E}_{2}$ are both elementary matrices.\n\nFirst, we need to find ${E}_{2}^{-1}.$ We write down ${E}_{2}$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}[{E}_{2}\\,|\\,I\\,] & =[\\begin{aligned}1 & 2 & 1 & 0 \\\\ 0 & 1 & 0 & 1\\end{aligned}] &  & {R}_{1}:={R}_{1}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & -2 \\\\ 0 & 1 & 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{E}_{2}^{-1}=[\\begin{aligned}1 & -2 \\\\ 0 & 1\\end{aligned}].\n$$\n\nNow, we can find the product ${E}_{1}{E}_{2}^{-1}:$\n\n$$\n{E}_{1}{E}_{2}^{-1}=[\\begin{aligned}3 & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 & -2 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}3 & -6 \\\\ 0 & 1\\end{aligned}]\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-73647/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "dd12bc7b-1b5d-5af2-bcef-c9d0fda7d8fc"] :knowledge-point/questions ["q-73647"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130823/selection/3ae8ebddb468c4f1ebb095b3a8b2a53dffedaa719b1