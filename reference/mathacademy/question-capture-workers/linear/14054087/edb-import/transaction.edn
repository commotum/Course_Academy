2}-20x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,33x-14 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{33x-66}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,52\\end{aligned}\n$$" :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,11{x}^{2}+10x+33 \\\\  & x-2\\,\\enclose{longdiv}{\\,\\,11{x}^{3}-12{x}^{2}+13x-14\\,\\,} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{11{x}^{3}-22{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,10{x}^{2}+13x-14 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{10{x}^{2}-20x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,33x-14 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{33x-66}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,52\\end{aligned}\n$$\n\n \n\nTherefore, the missing expressions are \n\n$\\,$ $11{x}^{2}+10x+33\\,$ and $\\,10{x}^{2}+13x-14.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-105589/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "dd4abd5d-2642-5f0d-af2f-5ed5c265526a"] :knowledge-point/questions ["q-105589"] :db/ensure [:knowledge-point/validate]} {:db/id "q-38049/selection/548d362f84c7293130bef380617dae87882489702393d04b5590c6430e6b1074" :answer/id #uuid "775594a7-038e-5f78-ba93-f99e1c52ead2" :answer/type :answer.type/math :answer/value "6{x}^{2}+8x+2-\\frac{1}{x-4}" :db/ensure [:answer/validate]} {:db/id "q-38049/selection/cffa0d503d662deaaebda200f3d23ddef951414a90633ef723ef15d8dcd5715e" :answer/id #uuid "847257d7-9bb4-5d52-92f5-4360f5b9f2d8" :answer/type :answer.type/math :answer/value "6{x}^{2}+8x-2+\\frac{1}{x-4}" :db/ensure [:answer/validate]} {:db/id "q-38049/selection/449515aea0924200948b396de9bfac98c6591a2549181d1dcacda48e194ad4f0" :answer/id #uuid "0ed17c77-f314-5a7d-a80f-ec09ec07f449" :answer/type :answer.type/math :answer/value "6{x}^{2}+8x+2+\\frac{2}{x-4}" :db/ensure [:answer/validate]} {:db/id "q-38049/selection/fe4612f8a84433668e4105c1f575e684b8e266b65a901fd6cb8387224e7fefcb" :answer/id #uuid "89a7b1e7-8b7c-5734-a358-c1237e32f680" :answer/type :answer.type/math :answer/value "6{x}^{2}+8x+2+\\frac{1}{x-4}" :db/ensure [:answer/validate]} {:db/id "q-38049/selection/2ae2ff5a414b31e4f539a7d1e24c24b0c152034182aa69d198b8a27741142272" :answer/id #uuid "e301f552-6a28-58c5-90bc-3f8798d79118" :answer/type :answer.type/math :answer/value "6{x}^{2}+8x+2" :db/ensure [:answer/validate]} {:db/id "q-38049/selection" :answer-field/id #uuid "43b96372-69a4-53cb-9f33-eadf9d5f9c22" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-38049/selection/2ae2ff5a414b31e4f539a7d1e24c24b0c152034182aa69d198b8a27741142272" :answer-field/choices ["q-38049/selection/548d362f84c7293130bef380617dae87882489702393d04b5590c6430e6b1074" "q-38049/selection/cffa0d503d662deaaebda200f3d23ddef951414a90633ef723ef15d8dcd5715e" "q-38049/selection/449515aea0924200948b396de9bfac98c6591a2549181d1dcacda48e194ad4f0" "q-38049/selection/fe4612f8a84433668e4105c1f575e684b8e266b65a901fd6cb8387224e7fefcb" "q-38049/selection/2ae2ff5a414b31e4f539a7d1e24c24b0c152034182aa69d198b8a27741142272"] :db/ensure [:answer-field/validate]} {:db/id "q-38049" :question/id #uuid "571834c6-f07f-578b-b816-e7ff7991f3a8" :question/math-academy-id "q-38049" :question/problem "Consider the following polynomial division:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,6{x}^{2}+8x+2 \\\\  & x-4\\,\\enclose{longdiv}{\\,\\,6{x}^{3}-16{x}^{2}-30x-8\\,\\,} \\\\  & \\,\\,\\,\\,\\,{6{x}^{3}-24{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,8{x}^{2}-30x-8 \\\\  & \\,\\,\\,\\,\\,\\,\\,{8{x}^{2}-32x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,2x-8 \\\\  & \\,\\,\\,\\,\\,\\,\\,{2x-8}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,0\\end{aligned}\n$$\n\nFrom the above, $\\frac{6{x}^{3}-16{x}^{2}-30x-8}{x-4}=$" :question/worked-solution "$$\n\\begin{aligned} & \\,\\,\\,\\,\\,6{x}^{2}+8x+2 \\\\  & x-4\\,\\enclose{longdiv}{\\,\\,6{x}^{3}-16{x}^{2}-30x-8\\,\\,} \\\\  & \\,\\,\\,\\,\\,{6{x}^{3}-24{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,8{x}^{2}-30x-8 \\\\  & \\,\\,\\,\\,\\,\\,\\,{8{x}^{2}-32x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,2x-8 \\\\  & \\,\\,\\,\\,\\,\\,\\,{2x-8}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,0\\end{aligned}\n$$\n\nFrom the given polynomial division, we deduce that dividing the polynomial $6{x}^{3}-16{x}^{2}-30x-8$ by the linear binomial $x-4$ gives\n\n- the quotient $6{x}^{2}+8x+2,$ and\n\n- the remainder $0.$\n\nTherefore, we obtain\n\n$$\n\\frac{6{x}^{3}-16{x}^{2}-30x-8}{x-4}=6{x}^{2}+8x+2+\\frac{0}{x-4}=6{x}^{2}+8x+2.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-38049/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3bdfd8fc-ce8d-5950-870d-c0570ef755bf"] :knowledge-point/questions ["q-38049"] :db/ensure [:knowledge-point/validate]} {:db/id "q-320865/field-1/291c20f900e3b75ac1d83c2ea267056fa6fa430044647db122f325aadb6010e8" :answer/id #uuid "26b3d08e-1a22-5281-84a8-ec95dd0fa0aa" :answer/type :answer.type/math :answer/value "3x^2-x+4" :db/ensure [:answer/validate]} {:db/id "q-320865/field-1/969be701b5c263fa7d9ebe3c31cc34a0da8f280b0a27c5876a8a1561222c2672" :answer/id #uuid "fabf741e-f3b3-5813-9a69-999334200609" :answer/type :answer.type/math :answer/value "3x^2+x+4" :db/ensure [:answer/validate]} {:db/id "q-320865/field-1" :answer-field/id #uuid "792146d0-d948-5d51-8c34-3d6f42fcc8be" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320865/field-1/291c20f900e3b75ac1d83c2ea267056fa6fa430044647db122f325aadb6010e8" :answer-field/choices ["q-320865/field-1/291c20f900e3b75ac1d83c2ea267056fa6fa430044647db122f325aadb6010e8" "q-320865/field-1/969be701b5c263fa7d9ebe3c31cc34a0da8f280b0a27c5876a8a1561222c2672"] :db/ensure [:answer-field/validate]} {:db/id "q-320865/field-2/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "dc625e0b-ba1a-54ee-a747-0aeb62165cd1" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-320865/field-2" :answer-field/id #uuid "9d867463-0ba6-54a3-8644-5164ac3f4cea" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320865/field-2/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-320865/field-2/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-320865" :question/id #uuid "9ae68684-3d32-56dc-9978-f459734a53fd" :question/math-academy-id "q-320865" :question/problem "Consider the following polynomial division:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,3{x}^{2}-x+4 \\\\  & x+2\\,\\enclose{longdiv}{\\,\\,3{x}^{3}+5{x}^{2}+2x+2\\,\\,\\,} \\\\  & \\,\\,\\,\\,\\,{3{x}^{3}+6{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,-{x}^{2}+2x+2 \\\\  & \\,\\,\\,\\,\\,\\,\\,{-{x}^{2}-2x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,4x+2 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,{4x+8}_{―} \\\\  & \\,\\,\\,\\,\\,-6\\end{aligned}\n$$\n\nFrom the above, we conclude the following:\n\n| $3{x}^{3}+5{x}^{2}+2x+2$ | $=$ | {{field-1}} | $-\\,\\,$ | {{field-2}} |  |\n| --- | --- | --- | --- | --- | --- |\n| $x+2$ |  | $x+2$ |  |  |  |" :question/worked-solution "$$\n\\begin{aligned} & \\,\\,\\,\\,\\,3{x}^{2}-x+4 \\\\  & x+2\\,\\enclose{longdiv}{\\,\\,3{x}^{3}+5{x}^{2}+2x+2\\,\\,\\,} \\\\  & \\,\\,\\,\\,\\,{3{x}^{3}+6{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,-{x}^{2}+2x+2 \\\\  & \\,\\,\\,\\,\\,\\,\\,{-{x}^{2}-2x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,4x+2 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,{4x+8}_{―} \\\\  & \\,\\,\\,\\,\\,-6\\end{aligned}\n$$\n\nFrom the given polynomial division, we deduce that dividing the polynomial $3{x}^{3}+5{x}^{2}+2x+2$ by the linear binomial $x+2$ gives\n\n- the quotient $3{x}^{2}-x+4,$ and\n\n- the remainder $-6.$\n\nTherefore, we obtain\n\n$$\n\\frac{3{x}^{3}+5{x}^{2}+2x+2}{x+2}=3{x}^{2}-x+4-\\frac{6}{x+2}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-320865/field-1" "q-320865/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3bdfd8fc-ce8d-5950-870d-c0570ef755bf"] :knowledge-point/questions ["q-320865"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113827/selection/430aee108c025c400d7bb05d1eaab4249b071f23dc615b4023875f5cbcceabce" :answer/id #uuid "368678fd-cdc1-5dde-814c-ed4cea0ea279" :answer/type :answer.type/math :answer/value "5x+3-\\frac{1}{x+1}" :db/ensure [:answer/validate]} {:db/id "q-113827/selection/ade36fd3ce3811349549ebd16c131967388471fe3f7e3573c5936723941333a2" :answer/id #uuid "063beb81-4a94-5c9d-a6de-ff043516cec8" :answer/type :answer.type/math :answer/value "5x-2+\\frac{1}{x+1}" :db/ensure [:answer/validate]} {:db/id "q-113827/selection/af80eed2fc59338f796570fc841fbeb87a8ceee9a61ab97ebf375050b0f327f5" :answer/id #uuid "b25ddf86-f7fe-5c5b-9080-1ca2ba9f01e2" :answer/type :answer.type/math :answer/value "5x-5-\\frac{2}{x+1}" :db/ensure [:answer/validate]} {:db/id "q-113827/selection/0258e063be8b59b6b06f7169b1c28cff9d3d702cca8b02d888f85b312f287800" :answer/id #uuid "7acdb856-a60d-546c-a1eb-8d0750f5e418" :answer/type :answer.type/math :answer/value "5x-1+\\frac{5}{x+1}" :db/ensure [:answer/validate]} {:db/id "q-113827/selection/82f6d2ba4af933fa21531403d661ef4b98c5d6b51397af60cf06cc47d12b896d" :answer/id #uuid "40ef858d-ce93-5a7a-8b4e-292c45060809" :answer/type :answer.type/math :answer/value "5x-3-\\frac{3}{x+1}" :db/ensure [:answer/validate]} {:db/id "q-113827/selection" :answer-field/id #uuid "f476abc9-7435-5a5b-a467-d0c5fabddbf0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113827/selection/82f6d2ba4af933fa21531403d661ef4b98c5d6b51397af60cf06cc47d12b896d" :answer-field/choices ["q-113827/selection/430aee108c025c400d7bb05d1eaab4249b071f23dc615b4023875f5cbcceabce" "q-113827/selection/ade36fd3ce3811349549ebd16c131967388471fe3f7e3573c5936723941333a2" "q-113827/selection/af80eed2fc59338f796570fc841fbeb87a8ceee9a61ab97ebf375050b0f327f5" "q-113827/selection/0258e063be8b59b6b06f7169b1c28cff9d3d702cca8b02d888f85b312f287800" "q-113827/selection/82f6d2ba4af933fa21531403d661ef4b98c5d6b51397af60cf06cc47d12b896d"] :db/ensure [:answer-field/validate]} {:db/id "q-113827" :question/id #uuid "721dc8b5-0c4e-5c7d-b5a9-6627d3e8e1db" :question/math-academy-id "q-113827" :question/problem "Consider the following polynomial division:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,5x-3 \\\\  & x+1\\,\\enclose{longdiv}{\\,\\,5{x}^{2}+2x-6\\,\\,} \\\\  & \\,\\,\\,\\,\\,{5{x}^{2}+5x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,-3x-6 \\\\  & \\,\\,\\,\\,\\,\\,\\,{-3x-3}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,-3\\end{aligned}\n$$\n\nFrom the above, $\\frac{5{x}^{2}+2x-6}{x+1}=$" :question/worked-solution "$$\n\\begin{aligned} & \\,\\,\\,\\,\\,5x-3 \\\\  & x+1\\,\\enclose{longdiv}{\\,\\,5{x}^{2}+2x-6\\,\\,} \\\\  & \\,\\,\\,\\,\\,{5{x}^{2}+5x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,-3x-6 \\\\  & \\,\\,\\,\\,\\,\\,\\,{-3x-3}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,-3\\end{aligned}\n$$\n\n  \n\nFrom the given polynomial division, we deduce that dividing the polynomial $5{x}^{2}+2x-6$ by the linear binomial $x+1$ gives\n\n- the quotient $5x-3,$ and\n\n- the remainder $-3.$\n\nTherefore, we obtain\n\n$$\n\\frac{5{x}^{2}+2x-6}{x+1}=5x-3-\\frac{3}{x+1}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-113827/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3bdfd8fc-ce8d-5950-870d-c0570ef755bf"] :knowledge-point/questions ["q-113827"] :db/ensure [:knowledge-point/validate]} {:db/id "q-320860/field-1/c7213c9f96be2efc59443b6e5a0cc1fd99781dd4f35f2b819834bbc1ddde9225" :answer/id #uuid "90082a3e-89bf-5853-8cbb-d2b243dc711b" :answer/type :answer.type/math :answer/value "3x+4" :db/ensure [:answer/validate]} {:db/id "q-320860/field-1/448a7c7b0178d4977391812ed162511cee281e5081c5ce8e849d97db40ebf2ae" :answer/id #uuid "5a95b865-4828-5dea-a10d-ccc83499dea3" :answer/type :answer.type/math :answer/value "3x-4" :db/ensure [:answer/validate]} {:db/id "q-320860/field-1" :answer-field/id #uuid "3ca4e512-1bea-5a9c-ae60-dfa66b9f7d29" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320860/field-1/c7213c9f96be2efc59443b6e5a0cc1fd99781dd4f35f2b819834bbc1ddde9225" :answer-field/choices ["q-320860/field-1/c7213c9f96be2efc59443b6e5a0cc1fd99781dd4f35f2b819834bbc1ddde9225" "q-320860/field-1/448a7c7b0178d4977391812ed162511cee281e5081c5ce8e849d97db40ebf2ae"] :db/ensure [:answer-field/validate]} {:db/id "q-320860/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "0c028963-784d-5ecb-a839-90be5cec35b7" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-320860/field-2" :answer-field/id #uuid "515e06f0-9957-5618-81ec-5da5cd88311d" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320860/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-320860/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-320860" :question/id #uuid "0dd8a252-fb1f-53b3-92e6-39fb1930bb1d" :question/math-academy-id "q-320860" :question/problem "Consider the following polynomial division:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,3x+4 \\\\  & x-3\\,\\enclose{longdiv}{\\,\\,3{x}^{2}-5x-10\\,\\,\\,} \\\\  & \\,\\,\\,\\,\\,{3{x}^{2}-9x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,4x-10 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,{4x-12}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,2\\end{aligned}\n$$\n\nFrom the above, we conclude the following:\n\n| $3{x}^{2}-5x-10$ | $=$ | {{field-1}} | $+\\,\\,$ | {{field-2}} |  |\n| --- | --- | --- | --- | --- | --- |\n| $x-3$ |  | $x-3$ |  |  |  |" :question/worked-solution "$$\n\\begin{aligned} & \\,\\,\\,\\,\\,3x+4 \\\\  & x-3\\,\\enclose{longdiv}{\\,\\,3{x}^{2}-5x-10\\,\\,\\,} \\\\  & \\,\\,\\,\\,\\,{3{x}^{2}-9x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,4x-10 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,{4x-12}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,2\\end{aligned}\n$$\n\nFrom the given polynomial division, we deduce that dividing the polynomial $3{x}^{2}-5x-10$ by the linear binomial $x-3$ gives\n\n- the quotient $3x+4,$ and\n\n- the remainder $2.$\n\nTherefore, we obtain\n\n$$\n\\frac{3{x}^{2}-5x-10}{x-3}=3x+4+\\frac{2}{x-3}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-320860/field-1" "q-320860/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3bdfd8fc-ce8d-5950-870d-c0570ef755bf"] :knowledge-point/questions ["q-320860"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-104218"] :question/problem "Consider the following polynomial division:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,{x}^{2}+3x+9 \\\\  & x-3\\,\\enclose{longdiv}{\\,\\,{x}^{3}+0{x}^{2}+0x-1\\,\\,} \\\\  & \\,\\,\\,\\,\\,{{x}^{3}-3{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,3{x}^{2}+0x-1 \\\\  & \\,\\,\\,\\,\\,\\,\\,{3{x}^{2}-9x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,9x-1 \\\\  & \\,\\,\\,\\,\\,\\,\\,{9x-27}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,26\\end{aligned}\n$$\n\nFrom the above, $\\frac{{x}^{3}-1}{x-3}=$" :question/worked-solution "$$\n\\begin{aligned} & \\,\\,\\,\\,\\,{x}^{2}+3x+9 \\\\  & x-3\\,\\enclose{longdiv}{\\,\\,{x}^{3}+0{x}^{2}+0x-1\\,\\,} \\\\  & \\,\\,\\,\\,\\,{{x}^{3}-3{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,3{x}^{2}+0x-1 \\\\  & \\,\\,\\,\\,\\,\\,\\,{3{x}^{2}-9x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,9x-1 \\\\  & \\,\\,\\,\\,\\,\\,\\,{9x-27}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,26\\end{aligned}\n$$\n\nFrom the given polynomial division, we deduce that dividing the polynomial ${x}^{3}-1$ by the linear binomial $x-3$ gives\n\n- the quotient ${x}^{2}+3x+9,$ and\n\n- the remainder $26.$\n\nTherefore, we obtain\n\n$$\n\\frac{{x}^{3}-1}{x-3}={x}^{2}+3x+9+\\frac{26}{x-3}.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-37977/selection/7a3d98a21b7aec9a3bb19e51d65dbae744a8b9a9a77d7a89dd9ebfb85921f1ec" :answer/id #uuid "e5afd13c-5860-526f-9136-7cc2b65da03d" :answer/type :answer.type/text :answer/value "$3{x}^{2}+3x+3\\,$ and $\\,3x-3$" :db/ensure [:answer/validate]} {:db/id "q-37977/selection/d697590edc370bdbceb6a0904447cf9830c6157629767a5cd0eda54107f9579a" :answer/id #uuid "6760fafb-634b-5cc5-a3d9-cd3be0642953" :answer/type :answer.type/text :answer/value "$3{x}^{2}+3x+3\\,$ and $\\,3{x}^{2}-3x$" :db/ensure [:answer/validate]} {:db/id "q-37977/selection/c0b7cb1328ac5f1631107ac4c188b555ecb7ce96f18490d6ea4e053ccbe6827e" :answer/id #uuid "8ff853e2-c415-531a-aab1-0480387a5f68" :answer/type :answer.type/text :answer/value "$3{x}^{2}-3x+3\\,$ and $\\,3{x}^{2}+3x$" :db/ensure [:answer/validate]} {:db/id "q-37977/selection/a343b30b1e7959ae3279cec9fcdd1136939aa41108377893e1ef9836d11804a0" :answer/id #uuid "0639961b-0b65-53d4-9385-192def894e1d" :answer/type :answer.type/text :answer/value "$3{x}^{2}+x-3\\,$ and $\\,3{x}^{2}-3x$" :db/ensure [:answer/validate]} {:db/id "q-37977/selection/981f4f5bd14e44d91074dd7c4c101c078550bf59c0ae17d7556c834f35ae26df" :answer/id #uuid "7e5df092-7dd1-5cdf-84a4-7dae6bbdcc30" :answer/type :answer.type/text :answer/value "$3{x}^{2}-3x+1\\,$ and $\\,3x+3$" :db/ensure [:answer/validate]} {:db/id "q-37977/selection" :answer-field/id #uuid "bb773819-93bd-5ba9-a5ee-2c6746b4d64e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-37977/selection/d697590edc370bdbceb6a0904447cf9830c6157629767a5cd0eda54107f9579a" :answer-field/choices ["q-37977/selection/7a3d98a21b7aec9a3bb19e51d65dbae744a8b9a9a77d7a89dd9ebfb85921f1ec" "q-37977/selection/d697590edc370bdbceb6a0904447cf9830c6157629767a5cd0eda54107f9579a" "q-37977/selection/c0b7cb1328ac5f1631107ac4c188b555ecb7ce96f18490d6ea4e053ccbe6827e" "q-37977/selection/a343b30b1e7959ae3279cec9fcdd1136939aa41108377893e1ef9836d11804a0" "q-37977/selection/981f4f5bd14e44d91074dd7c4c101c078550bf59c0ae17d7556c834f35ae26df"] :db/ensure [:answer-field/validate]} {:db/id "q-37977" :question/id #uuid "8f2beb0d-f178-5844-a215-15b69fb958ea" :question/math-academy-id "q-37977" :question/problem "From top to bottom, what are the missing expressions in the following polynomial division problem?\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,\\boxed{} \\\\  & x-1\\,\\enclose{longdiv}{\\,\\,3{x}^{3}+0{x}^{2}+0x+5\\,\\,} \\\\  & \\,\\,\\,\\,\\,{3{x}^{3}-3{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,3{x}^{2}+0x+5 \\\\  & \\,\\,\\,\\,\\,\\,\\,{\\boxed{}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,3x+5 \\\\  & \\,\\,\\,\\,\\,\\,\\,{3x-3}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,8\\end{aligned}\n$$" :question/worked-solution "Notice that the dividend is missing the ${x}^{2}$-term and the $x$-term. So, we write it using a zero coefficient, as follows:\n\n$$\n3{x}^{3}+0{x}^{2}+0x+5\n$$\n\nUsing the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,3{x}^{2}+3x+3 \\\\  & x-1\\,\\enclose{longdiv}{\\,\\,3{x}^{3}+0{x}^{2}+0x+5\\,\\,} \\\\  & \\,\\,\\,\\,\\,{3{x}^{3}-3{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,3{x}^{2}+0x+5 \\\\  & \\,\\,\\,\\,\\,\\,\\,{3{x}^{2}-3x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,3x+5 \\\\  & \\,\\,\\,\\,\\,\\,\\,{3x-3}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,8\\end{aligned}\n$$\n\nTherefore, the missing expressions are\n\n$\\,$ $3{x}^{2}+3x+3\\,$ and $\\,3{x}^{2}-3x.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-37977/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "26c342f1-881b-5f3e-8c76-448eec165168"] :knowledge-point/questions ["q-37977"] :db/ensure [:knowledge-point/validate]} {:db/id "q-38108/selection/30e65718c760de4d6faf22d7f29b7ca592891a28533bcd461308c6873d778c9