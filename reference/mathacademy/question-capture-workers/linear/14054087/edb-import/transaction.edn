ial division problem?\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\boxed{} \\\\  & 3x-1\\,\\enclose{longdiv}{6{x}^{3}-5{x}^{2}+7x+4\\,\\,} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{6{x}^{3}-2{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,-\\,3{x}^{2}+7x+4 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{\\boxed{}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,6x+4 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{6x-2}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,6\\end{aligned}\n$$" :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,2{x}^{2}-x+2 \\\\  & 3x-1\\,\\enclose{longdiv}{6{x}^{3}-5{x}^{2}+7x+4\\,\\,} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{6{x}^{3}-2{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,-\\,3{x}^{2}+7x+4 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{-\\,3{x}^{2}+\\,\\,x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,6x+4 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{6x-2}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,6\\end{aligned}\n$$\n\n  \n\nTherefore, the missing expressions are \n\n$\\,$ $2{x}^{2}-x+2\\,$ and $\\,-3{x}^{2}+x.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-105591/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "dd4abd5d-2642-5f0d-af2f-5ed5c265526a"] :knowledge-point/questions ["q-105591"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-104126"] :question/problem "From top to bottom, what are the missing expressions in the following polynomial division problem?\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\boxed{} \\\\  & 3x-1\\,\\enclose{longdiv}{\\,\\,6{x}^{2}+4x+3\\,\\,} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{6{x}^{2}-2x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,6x+3 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{\\boxed{}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,5 \\\\  & \\end{aligned}\n$$" :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,2x+2 \\\\  & 3x-1\\,\\enclose{longdiv}{\\,\\,6{x}^{2}+4x+3\\,\\,} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{6{x}^{2}-2x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,6x+3 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{6x-2}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,5 \\\\  & \\end{aligned}\n$$\n\nTherefore, the missing expressions are \n\n$\\,$ $2x+2\\,$ and $\\,6x-2.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-113746/selection/06168380f32700978d319155b4e50999f0509a206511d6e0bbe38cf9634c1d4e" :answer/id #uuid "3384283a-f70e-50c1-b859-18f1b221804a" :answer/type :answer.type/text :answer/value "$4{x}^{2}+10x+55\\,$ and $\\,9{x}^{2}+2x-5$" :db/ensure [:answer/validate]} {:db/id "q-113746/selection/3b2af94b74dcb2aae5ce96e9219184ece54328f21e3851240374731818528e9e" :answer/id #uuid "fbb2e4f3-c449-5c92-b535-aab50b1c4c36" :answer/type :answer.type/text :answer/value "$4{x}^{2}+10x+45\\,$ and $\\,11{x}^{2}-x-5$" :db/ensure [:answer/validate]} {:db/id "q-113746/selection/281b8041a33574b2d57d02cfad02789baf87d1a9ab0c3ca229739a11f14a73e4" :answer/id #uuid "81e34ca6-435c-5f9c-a994-6a45d3c57d82" :answer/type :answer.type/text :answer/value "$4{x}^{2}+11x+45\\,$ and $\\,11{x}^{2}+x-5$" :db/ensure [:answer/validate]} {:db/id "q-113746/selection/39936228ee7da8cc42e917ac347e398a3377ca8b0c678275cfea47e44ac47de7" :an