/id #edb/ref 17592186086276} {:answer/id #uuid "ea5bf088-3903-5838-a423-c67d403f6056" :answer/type {:db/ident :answer.type/math} :answer/value "y =-2" :db/id #edb/ref 17592186086277} {:answer/id #uuid "f9824ec8-13bd-5033-a60f-f8542009a779" :answer/type {:db/ident :answer.type/math} :answer/value "y = 1" :db/id #edb/ref 17592186086278} {:answer/id #uuid "11834379-2b4d-5fa4-bab1-e740d43a1a04" :answer/type {:db/ident :answer.type/math} :answer/value "y = 0" :db/id #edb/ref 17592186086279} {:answer/id #uuid "37385837-155f-54bc-8166-d06d3703aa95" :answer/type {:db/ident :answer.type/math} :answer/value "y =-\\frac{1}{9}" :db/id #edb/ref 17592186086280}] :answer-field/correct {:answer/id #uuid "11834379-2b4d-5fa4-bab1-e740d43a1a04" :answer/type {:db/ident :answer.type/math} :answer/value "y = 0" :db/id #edb/ref 17592186086279} :answer-field/id #uuid "ab05ef2a-9c6a-50f1-b48d-275148d454bf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086275}] :question/id #uuid "c0349865-9d9c-56c6-b862-8e79d0d94cb7" :question/math-academy-id "q-7006" :question/problem "Determine the horizontal asymptote of the function $f(x) = \\frac{2x + 1}{9x + 8x^{2} - x^{3}}$."}]}
