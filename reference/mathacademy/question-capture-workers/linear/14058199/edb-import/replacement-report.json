      "source": [
        {
          "question": "q-78715",
          "field": null,
          "attribute": "question/problem",
          "value": "The inverse of the $3\\times 3$ matrix $A$ is found using row operations, as shown below. Complete the process, and determine ${A}^{-1}.$\n\n$$\n\\begin{aligned}[A\\,|\\,I\\,] & =[\\begin{aligned}-3 & 1 & 0 & 1 & 0 & 0 \\\\ 1 & 0 & 0 & 0 & 1 & 0 \\\\ 0 & 0 & 1 & 0 & 0 & 1\\end{aligned}] & {R}_{1} & \u2194{R}_{2} \\\\  & \u223c[\\begin{aligned}1 & 0 & 0 & 0 & 1 & 0 \\\\ -3 & 1 & 0 & 1 & 0 & 0 \\\\ 0 & 0 & 1 & 0 & 0 & 1\\end{aligned}] & {R}_{2} & :=\\text{___________} \\\\  & \u223c[\\begin{aligned}1 & 0 & 0 &  &  &  \\\\ 0 & 1 & 0 &  &  &  \\\\ 0 & 0 & 1 &  &  & \\end{aligned}]\\end{aligned}\n$$",
          "category": "ma_capture",
          "file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058199/state.json",
          "file_sha256": "3355bcdc5b41f6c1595231dd81c702ba5cf8902b0832d1fa396bb707eec9fbc0"
        }
      ],
