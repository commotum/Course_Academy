\\\\ -1 & 1 & 0 \\\\ 0 & 1 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =I\\,✓ \\\\ C & =[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & -1 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & -1 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ -2 & -3 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only\"." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-78772/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "68350e0d-84ca-5b50-b05a-1bca3ceea40f"] :knowledge-point/questions ["q-78772"] :db/ensure [:knowledge-point/validate]} {:db/id "q-43068/selection/ca3404a9dcb14c92cd24f70f9b0055193ecb7c3210b66a8ced963edbca9af5f4" :answer/id #uuid "eb5cf7a3-d85d-5fad-9055-9dbfbb094e92" :answer/type :answer.type/math :answer/value "{R}_{1}↔{R}_{3}" :db/ensure [:answer/validate]} {:db/id "q-43068/selection/10749f3446ccaafbcbd871abeb60c34683e459cb552f88e989a4a8615d231b6f" :answer/id #uuid "6c70a28e-5add-5613-81af-b4770d6bf426" :answer/type :answer.type/math :answer/value "{R}_{3}:=(-1){R}_{3}" :db/ensure [:answer/validate]} {:db/id "q-43068/selection/5f3e21ffc18385e8c6e81aeae39f401e4e6680b1855c4cae8c4263e82b2f9bca" :answer/id #uuid "4e5498bb-32f2-55c6-ad4a-3842375810c5" :answer/type :answer.type/math :answer/value "{R}_{2}↔{R}_{3},\\,{R}_{3}:=(-1){R}_{3}" :db/ensure [:answer/validate]} {:db/id "q-43068/selection/7664f3aa460b93374a421fec697037c18731b6e23c82b307a7fde51316705757" :answer/id #uuid "b686a894-e5ba-55e2-9fd0-12e97ac3d167" :answer/type :answer.type/math :answer/value "{R}_{1}:={R}_{1}-2{R}_{2}" :db/ensure [:answer/validate]} {:db/id "q-