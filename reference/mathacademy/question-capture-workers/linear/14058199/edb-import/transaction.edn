 \\\\ 0 & 0 & 1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-43068/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "68350e0d-84ca-5b50-b05a-1bca3ceea40f"] :knowledge-point/questions ["q-43068"] :db/ensure [:knowledge-point/validate]} {:db/id "q-112249/selection/2377e3ffc3b5cd65e1036103e0b988e5af6634b2438c63c3b7cc0592571401ab" :answer/id #uuid "a7e49778-28fe-55a8-af5c-2f8763b75d13" :answer/type :answer.type/text :answer/value "$A$ and $C$ only" :db/ensure [:answer/validate]} {:db/id "q-112249/selection/e432f1020975ada4c83798ae75bfd6c0ae4dfe63215763f08b8be8ccabf8a5d3" :answer/id #uuid "494cb410-2fd5-5906-8d7c-23d10ec8f158" :answer/type :answer.type/text :answer/value "$C$ only" :db/ensure [:answer/validate]} {:db/id "q-112249/selection/e956c3af673c94782038951d8de50bf89c9a53bf4daf2ca6725a4bea4229074c" :answer/id #uuid "de17fdb5-ae93-5d4d-ae99-090699e4645d" :answer/type :answer.type/text :answer/value "$B$ only" :db/ensure [:answer/validate]} {:db/id "q-112249/selection/b967c3002b3f913c5b31990d1f8159d3e1e979aa07e2842a8b67bfff1a2fd3f2" :answer/id #uuid "7326dbfe-10be-5249-aed4-b527fc51034d" :answer/type :answer.type/text :answer/value "$A$ and $B$ only" :db/ensure [:answer/validate]} {:db/id "q-112249/selection/685c02320dbe687345f93d820499dea4c0c82808b910e8a0e5841f77aa82209d" :answer/id #uuid "4531e314-05b1-5e6c-8abc-85dfcdeb55d0" :answer/type :answer.type/text :answer/value "$A$ only" :db/ensure [:answer/validate]} {:db/id "q-112249/selection" :answer-field/id #uuid "9cc09925-0721-54b0-a74d-d437704e225a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-112249/selection/e956c3af673c94782038951d8de50bf89c9a53bf4daf2ca6725a4bea4229074c" :answer-field/choices ["q-112249/selection/2377e3ffc3b5cd65e1036103e0b988e5af6634b2438c63c3b7cc0592571401ab" "q-112249/selection/e432f1020975ada4c83798ae75bfd6c0ae4dfe63215763f08b8be8ccabf8a5d3" "q-112249/selection/e956c3af673c94782038951d8de50bf89c9a53bf4daf2ca6725a4bea4229074c" "q-112249/selection/b967c3002b3f913c5b31990d1f8159d3e1e979aa07e2842a8b67bfff1a2fd3f2" "q-112249/selection/685c02320dbe687345f93d820499dea4c0c82808b910e8a0e5841f77aa82209d"] :db/ensure [:answer-field/validate]} {:db/id "q-112249" :question/id #uuid "15cf510c-4fea-5c5d-a055-136ab2fff0a3" :question/math-academy-id "q-112249" :question/problem "Which of the following matrices are transformed into the $3\\times 3$ identity matrix after applying the row operations ${R}_{1}↔{R}_{2}\\,$ and $\\,{R}_{1}:={R}_{1}+5{R}_{2}?$\n\n$$\nA=[\\begin{aligned}0 & -5 & 0 \\\\ -5 & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}],\\,B=[\\begin{aligned}0 & 1 & 0 \\\\ 1 & -5 & 0 \\\\ 0 & 0 & 1\\end{aligned}],\\,C=[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 5\\end{aligned}]\n$$" :question/worked-solution "Let's apply the operations to each of the matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}0 & -5 & 0 \\\\ -5 & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}-5 & 0 & 0 \\\\ 0 & -5 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+5{R}_{2} \\\\  & ∼[\\begin{aligned}-5 & -25 & 0 \\\\ 0 & -5 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times  \\\\ B & =[\\begin{aligned}0 & 1 & 0 \\\\ 1 & -5 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -5 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+5{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =I\\,✓ \\\\ C & =[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 5\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}0 & 1 & 0 \\\\ 0 & 0 & 1 \\\\ 1 & 0 & 5\\end{aligned}] & {R}_{1} & :={R}_{1}+5{R}_{2} \\\\  & ∼[\\begin{aligned}0 & 1 & 5 \\\\ 0 & 0 & 1 \\\\ 1 & 0 & 5\\end{aligned}] \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only\"." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-112249/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "68350e0d-84ca-5b50-b05a-1bca3ceea40f"] :knowledge-point/questions ["q-112249"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186115869 :question/answer-fields 17592186114585] {:db/id "q-78715/selection/ma-v1/455598061dfb94ac7850a30e130aff2e9e0c36a18aa336c89878ce61131f3b9d/0b30b3c7d7a59474ae83012a1c0037f41865547c37c4db013b92d8ec33e0b91e" :answer/id #uuid "b1fcc8fd-d444-5cef-8641-9eae2a1559b9" :answer/type :answer.type/math :answer/value "{A}^{-1}=[\\begin{aligned}0 & 1 & 0 \\\\ 1 & 3 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78715/selection/ma-v1/455598061dfb94ac7850a30e130aff2e9e0c36a18aa336c89878ce61131f3b9d/9be157e145315ccabe9bfbc9750f73e0e0792b7570c736f2d6f4cb4e2c2e76c2" :answer/id #uuid "6aeaab03-578c-5ae7-af8b-424b2498e88f" :answer/type :answer.type/math :answer/value "{A}^{-1}=[\\begin{aligned}1 & 0 & 1 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78715/selection/ma-v1/455598061dfb94ac7850a30e130aff2e9e0c36a18aa336c89878ce61131f3b9d/bfe21e15feb3df9523ad788953b44d7632c4c90549af3b248e3aa9373d340343" :answer/id #uuid "a4793fdb-c34a-58a4-a4ae-ce5b47160349" :answer/type :answer.type/math :answer/value "{A}^{-1}=[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 3 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78715/selection/ma-v1/455598061dfb94ac7850a30e130aff2e9e0c36a18aa336c89878ce61131f3b9d/201298167a549c7ce3a7c719fc4481869bc230e5db1b257001b76a22fb985eca" :answer/id #uuid "ddf8e860-b717-5e37-83c3-6645f30baf9e" :answer/type :answer.type/math :answer/value "{A}^{-1}=[\\begin{aligned}0 & 1 & 0 \\\\ 0 & 3 & 1 \\\\ 0 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78715/selection/ma-v1/455598061dfb94ac7850a30e130aff2e9e0c36a18aa336c89878ce61131f3b9d/875fe009b3c760e2b2e781346b5eb2aac5b918b40529993cdebf558dc1d0d402" :answer/id #uuid "2efba78c-c406-57b5-a6bf-59329388974e" :answer/type :answer.type/math :answer/value "{A}^{-1}=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 3 & 1 \\\\ 0 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78715/selection/ma-v1/455598061dfb94ac7850a30e130aff2e9e0c36a18aa336c89878ce61131f3b9d" :answer-field/id #uuid "d388e879-b419-5738-974c-185901be9d64" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-78715/selection/ma-v1/455598061dfb94ac7850a30e130aff2e9e0c36a18aa336c89878ce61131f3b9d/0b30b3c7d7a59474ae83012a1c0037f41865547c37c4db013b92d8ec33e0b91e" :answer-field/choices ["q-78715/selection/ma-v1/455598061dfb94ac7850a30e130aff2e9e0c36a18aa336c89878ce61131f3b9d/0b30b3c7d7a59474ae83012a1c0037f41865547c37c4db013b92d8ec33e0b91e" "q-78715/selection/ma-v1/455598061dfb94ac7850a30e130aff2e9e0c36a18aa336c89878ce61131f3b9d/9be157e145315ccabe9bfbc9750f73e0e0792b7570c736f2d6f4cb4e2c2e76c2" "q-78715/selection/ma-v1/455598061dfb94ac7850a30e130aff2e9e0c36a18aa336c89878ce61131f3b9d/bfe21e15feb3df9523ad788953b44d7632c4c90549af3b248e3aa9373d340343" "q-78715/selection/ma-v1/455598061dfb94ac7850a30e130aff2e9e0c36a18aa336c89878ce61131f3b9d/201298167a549c7ce3a7c719fc4481869bc230e5db1b257001b76a22fb985eca" "q-78715/selection/ma-v1/455598061dfb94ac7850a30e130aff2e9e0c36a18aa336c89878ce61131f3b9d/875fe009b3c760e2b2e781346b5eb2aac5b918b40529993cdebf558dc1d0d402"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-78715"] :question/problem "The inverse of the $3\\times 3$ matrix $A$ is found using row operations, as shown below. Complete the process, and determine ${A}^{-1}.$\n\n$$\n\\begin{aligned}[A\\,|\\,I\\,] & =[\\begin{aligned}-3 & 1 & 0 & 1 & 0 & 0 \\\\ 1 & 0 & 0 & 0 & 1 & 0 \\\\ 0 & 0 & 1 & 0 & 0 & 1\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 0 & 1 & 0 \\\\ -3 & 1 & 0 & 1 & 0 & 0 \\\\ 0 & 0 & 1 & 0 & 0 & 1\\end{aligned}] & {R}_{2} & :=\\text{___________} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 &  &  &  \\\\ 0 & 1 & 0 &  &  &  \\\\ 0 & 0 & 1 &  &  & \\end{aligned}]\\end{aligned}\n$$" :question/worked-solution "We write down $A$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $A$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[A\\,|\\,I\\,] & =[\\begin{aligned}-3 & 1 & 0 & 1 & 0 & 0 \\\\ 1 & 0 & 0 & 0 & 1 & 0 \\\\ 0 & 0 & 1 & 0 & 0 & 1\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 0 & 1 & 0 \\\\ -3 & 1 & 0 & 1 & 0 & 0 \\\\ 0 & 0 & 1 & 0 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 0 & 1 & 0 \\\\ 0 & 1 & 0 & 1 & 3 & 0 \\\\ 0 & 0 & 1 & 0 & 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\n \n\nThe matrix ${A}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{A}^{-1}=[\\begin{aligned}0 & 1 & 0 \\\\ 1 & 3 & 0 \\\\ 0 & 0 & 1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-78715/selection/ma-v1/455598061dfb94ac7850a30e130aff2e9e0c36a18aa336c89878ce61131f3b9d"] :db/ensure [:question/validate]} {:db/id "q-78436/selection/fdb17b45d678bb1e4f42ae051e292a637fa230cad96d0fe6ea0d36caff816397" :answer/id #uuid "2a85d130-a988-5a20-be41-389bc0c532f2" :answer/type :answer.type/math :answer/value "{A}^{-1}=[\\begin{aligned}1 & 0 & 0 \\\\ -2 & 1 & 1 \\\\ 0 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78436/selection/b00e0020233f7bce74a1b50b85232f3f5e10fbd34548c8b95f588211c95c5c01" :answer/id #uuid "3f41fea9-3a1f-5866-86f8-ec0a84cac0a4" :answer/type :answer.type/math :answer/value "{A}^{-1}=[\\begin{aligned}1 & 0 & 0 \\\\ -2 & 1 & -1 \\\\ 0 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78436/selection/2abc2803dfc8afe6bad330cdc501e0b7690027cb7ccc2e523d40c6986df05dc9" :answer/id #uuid "47046014-7dbd-514d-b466-38fe58c6edba" :answer/type :answer.type/math :answer/value "{A}^{-1}=[\\begin{aligned}1 & 0 & -1 \\\\ -2 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78436/selection/f3e77a940ac867f8d4d916dac9ac120e25396a82e11e8015635c55be458b59ba" :answer/id #uuid "870a715c-7c2c-5f45-9a99-230d90b1ca48" :answer/type :answer.type/math :answer/value "{A}^{-1}=[\\begin{aligned}1 & 0 & -2 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78436/selection/dfdac2b807f9906ae63cd7c2309d9f19686b7ea674052c246e4ea2fd6ca6433f" :answer/id #uuid "0356a5d4-9a3f-5f0e-8876-dec93304a590" :answer/type :answer.type/math :answer/value "{A}^{-1}=[\\begin{aligned}1 & 0 & 2 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78436/selection" :answer-field/id #uuid "472c227a-4d15-5d8f-aa83-9caedc5f7c5e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-78436/selection/2abc2803dfc8afe6bad330cdc501e0b7690027cb7ccc2e523d40c6986df05dc9" :answer-field/choices ["q-78436/selection/fdb17b45d678bb1e4f42ae051e292a637fa230cad96d0fe6ea0d36caff816397" "q-78436/selection/b00e0020233f7bce74a1b50b85232f3f5e10fbd34548c8b95f588211c95c5c01" "q-78436/selection/2abc2803dfc8afe6bad330cdc501e0b7690027cb7ccc2e523d40c6986df05dc9" "q-78436/selection/f3e77a940ac867f8d4d916dac9ac120e25396a82e11e8015635c55be458b59ba" "q-78436/selection/dfdac2b807f9906ae63cd7c2309d9f19686b7ea674052c246e4ea2fd6ca6433f"] :db/ensure [:answer-field/validate]} {:db/id "q-78436" :question/id #uuid "97daae8e-7a63-517a-8715-286f71b669c7" :question/math-academy-id "q-78436" :question/problem "The inverse of the $3\\times 3$ matrix $A$ is found using row operations, as shown below. Complete the process, and determine ${A}^{-1}.$\n\n$$\n\\begin{aligned}[A\\,|\\,I\\,] & =[\\begin{aligned}1 & 0 & 1 & 1 & 0 & 0 \\\\ 2 & 1 & 2 & 0 & 1 & 0 \\\\ 0 & 0 & 1 & 0 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 1 & 0 & 0 \\\\ 0 & 1 & 0 & -2 & 1 & 0 \\\\ 0 & 0 & 1 & 0 & 0 & 1\\end{aligned}] & {R}_{1} & :=\\text{___________} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 &  &  &  \\\\ 0 & 1 & 0 &  &  &  \\\\ 0 & 0 & 1 &  &  & \\end{aligned}]\\end{aligned}\n$$" :question/worked-solution "We write down $A$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $A$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[A\\,|\\,I\\,] & =[\\begin{aligned}1 & 0 & 1 & 1 & 0 & 0 \\\\ 2 & 1 & 2 & 0 & 1 & 0 \\\\ 0 & 0 & 1 & 0 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 1 & 0 & 0 \\\\ 0 & 1 & 0 & -2 & 1 & 0 \\\\ 0 & 0 & 1 & 0 & 0 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+(-1){R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 1 & 0 & -1 \\\\ 0 & 1 & 0 & -2 & 1 & 0 \\\\ 0 & 0 & 1 & 0 & 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\n \n\nThe matrix ${A}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{A}^{-1}=[\\begin{aligned}1 & 0 & -1 \\\\ -2 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-78436/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c17a6569-f5a4-507b-8893-5411adb6ea23"] :knowledge-point/questions ["q-78436"] :db/ensure [:knowledge-point/validate]} {:db/id "q-78708/selection/8e7e039f64b1875d1cee3c82d5ca5917cffba3febcad096ba9bd617c9c82e9c8" :answer/id #uuid "010cafdf-fcb8-5b8c-896b-5648b2d69fc5" :answer/type :answer.type/math :answer/value "{A}^{-1}=[\\begin{aligned}1 & 0 & -4 \\\\ 0 & 1 & 3 \\\\ 0 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78708/selection/a11f111dea7cbd1b85eb5df3e3454abdcbda5491197c9729d11a6debb934319e" :answer/id #uuid "6e74aba4-efe5-53c5-9419-e1a864ef3009" :answer/type :answer.type/math :answer/value "{A}^{-1}=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 3 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78708/selection/a7e41c3517a210e96264c09107e07b2c0c20b1cc42adcd53d24aa55cf4a1b75c" :answer/id #uuid "da63145c-215a-507b-afa8-2c7c34ca218d" :answer/type :answer.type/math :answer/value "{A}^{-1}=[\\begin{aligned}1 & -4 & 0 \\\\ 3 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78708/selection/2695a759472a50eefa48b32befccd525f3362754098464d3c8e9a22c9943e518" :answer/id #uuid "f6ec7fc2-d074-56be-a997-9abf835b8a92" :answer/type :answer.type/math :answer/value "{A}^{-1}=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 3 \\\\ -4 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78708/selection/b3d8db15ddbad0db943368a237b256fc22bfbef5f88a1135d289f775f8adf5a1" :answer/id #uuid "f9786680-a129-56a0-88f6-778622d3c2cd" :answer/type :answer.type/math :answer/value "{A}^{-1}=[\\begin{aligned}1 & 0 & -4 \\\\ 0 & 1 & 0 \\\\ 0 & 3 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78708/selection" :answer-field/id #uuid "0aa58810-a188-5487-910f-7e5d9c88ea7b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-78708/selection/8e7e039f64b1875d1cee3c82d5ca5917cffba3febcad096ba9bd617c9c82e9c8" :answer-field/choices ["q-78708/selection/8e7e039f64b1875d1cee3c82d5ca5917cffba3febcad096ba9bd617c9c82e9c8" "q-78708/selection/a11f111dea7cbd1b85eb5df3e3454abdcbda5491197c9729d11a6debb934319e" "q-78708/selection/a7e41c3517a210e96264c09107e07b2c0c20b1cc42adcd53d24aa55cf4a1b75c" "q-78708/selection/2695a759472a50eefa48b32befccd525f3362754098464d3c8e9a22c9943e518" "q-78708/selection/b3d8db15ddbad0db943368a237b256fc22bfbef5f88a1135d289f775f8adf5a1"] :db/ensure [:answer-field/validate]} {:db/id "q-78708" :question/id #uuid "84a50754-3d18-56fe-abea-40afe1653050" :question/math-academy-id "q-78708" :question/problem "The inverse of the $3\\times 3$ matrix $A$ is found using row operations, as shown below. Complete the process, and determine ${A}^{-1}.$\n\n$$\n\\begin{aligned}[A\\,|\\,I\\,] & =[\\begin{aligned}1 & 0 & 4 & 1 & 0 & 0 \\\\ 0 & 1 & -3 & 0 & 1 & 0 \\\\ 0 & 0 & 1 & 0 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 4 & 1 & 0 & 0 \\\\ 0 & 1 & 0 & 0 & 1 & 3 \\\\ 0 & 0 & 1 & 0 & 0 & 1\\end{aligned}] & {R}_{1} & :=\\text{___________} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 &  &  &  \\\\ 0 & 1 & 0 &  &  &  \\\\ 0 & 0 & 1 &  &  & \\end{aligned}]\\end{aligned}\n$$" :question/worked-solution "We write down $A$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $A$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[A\\,|\\,I\\,] & =[\\begin{aligned}1 & 0 & 4 & 1 & 0 & 0 \\\\ 0 & 1 & -3 & 0 & 1 & 0 \\\\ 0 & 0 & 1 & 0 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 4 & 1 & 0 & 0 \\\\ 0 & 1 & 0 & 0 & 1 & 3 \\\\ 0 & 0 & 1 & 0 & 0 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+(-4){R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 1 & 0 & -4 \\\\ 0 & 1 & 0 & 0 & 1 & 3 \\\\ 0 & 0 & 1 & 0 & 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\n \n\nThe matrix ${A}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{A}^{-1}=[\\begin{aligned}1 & 0 & -4 \\\\ 0 & 1 & 3 \\\\ 0 & 0 & 1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-78708/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c17a6569-f5a4-507b-8893-5411adb6ea23"] :knowledge-point/questions ["q-78708"] :db/ensure [:knowledge-point/validate]} {:db/id "q-78717/selection/3771dfa81d5a6b2e36580ceca509057e2960a63ece8470e1be8f3b0b1095c4f1" :answer/id #uuid "a4aae020-d59f-5396-9ac3-eae189cd96c8" :answer/type :answer.type/math :answer/value "{A}^{-1}=[\\begin{aligned}1 & 0 & 0 \\\\ 2 & -4 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78717/selection/c7a2f4e2923cc83f523ececad8c711316a5a55f55591174a366e5e054158ba63" :answer/id #uuid "8bb54050-873e-53b6-a2ee-26bc239eefaa" :answer/type :answer.type/math :answer/value "{A}^{-1}=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & -\\frac{1}{2} \\\\ 0 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78717/selection/2a0d762afe2c8eebe8056dc13e8e1c231b6f27d40a0898d3f1b232361f114f48" :answer/id #uuid "e8e04661-84ef-5812-9237-b007157ecf46" :answer/type :answer.type/math :answer/value "{A}^{-1}=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & \\frac{1}{4} & 2 \\\\ 0 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78717/selection/8db8f0d9a9d7202f5629389a9bf1525282b9f7912a7969d7727615238bbae0ab" :answer/id #uuid "f9838029-c178-5aa1-8708-3ac97d4edff0" :answer/type :answer.type/math :answer/value "{A}^{-1}=[\\begin{aligned}1 & 2 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78717/selection/46f120f24f4c457ed2a1d0f5ad4bd853fd7e45812f65d1c6be8971930ec3576a" :answer/id #uuid "96acb545-b498-5cc4-9ef3-8b50fdbdea0a" :answer/type :answer.type/math :answer/value "{A}^{-1}=[\\begin{aligned}1 & 0 & 0 \\\\ 2 & 1 & \\frac{1}{4} \\\\ 0 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78717/selection" :answer-field/id #uuid "7d5dadb7-66ee-56e5-96be-1293a26ec586" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-78717/selection/2a0d762afe2c8eebe8056dc13e8e1c231b6f27d40a0898d3f1b232361f114f48" :answer-field/choices ["q-78717/selection/3771dfa81d5a6b2e36580ceca509057e2960a63ece8470e1be8f3b0b1095c4f1" "q-78717/selection/c7a2f4e2923cc83f523ececad8c711316a5a55f55591174a366e5e054158ba63" "q-78717/selection/2a0d762afe2c8eebe8056dc13e8e1c231b6f27d40a0898d3f1b232361f114f48" "q-78717/selection/8db8f0d9a9d7202f5629389a9