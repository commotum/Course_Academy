 :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186123225}] :answer-field/correct {:answer/id #uuid "3a6e6b30-bb74-5ed7-9701-8fe7b6b6055b" :answer/type {:db/ident :answer.type/math} :answer/value "b ∉ Im(T)" :db/id #edb/ref 17592186123223} :answer-field/id #uuid "d3b166a9-8163-5fbb-b535-19113d494b17" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123220}] :question/id #uuid "276425ed-7889-5b58-948f-0c76f30f34c1" :question/math-academy-id "q-38007" :question/problem "The linear transformation $T$ and the vector $b ∈ R^{4}$ are given below. Determine if there exists a vector $x ∈ R^{4}$ such that $T(x) = b$.\nIn the affirmative case, find the value of $x_{1} - x_{3}$, where $x_{1}, x_{2}, x_{3}, x_{4}$ are the components of $x$.\n\n$T: \\begin{bmatrix}x_{1} \\\\ x_{2} \\\\ x_{3} \\\\ x_{4}\\end{bmatrix}⟶\\begin{bmatrix}x_{1} + x_{2} - x_{4} \\\\ 2x_{2} - x_{1} + 3x_{3} + 4x_{4} \\\\ 2x_{1} + x_{2} - x_{3} - 3x_{4} \\\\ 0\\end{bmatrix}, b = \\begin{bmatrix}3 \\\\ 6 \\\\ -3 \\\\ 0\\end{bmatrix}$"}] [{:db/id #edb/ref 17592186125048 :knowledge-point/_questions [{:knowledge-point/id #uuid "4230d6ad-86c4-565e-8c5f-ab08179fc26f" :knowledge-point/title "Determining a Component of a Vector in the Image of a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87b1fbbb-72df-5a45-a327-d7b2776a02ab" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186123311} {:answer/id #uuid "88753680-8d6f-58a3-8905-e3b2cb1e2962" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186123312} {:answer/id #uuid "96ef4f05-ac30-57ac-ae92-88cf2018b893" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186123313} {:answer/id #uuid "36aece73-192c-5554-8400-34a4ff1294d6" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186123314} {:answer/id #uuid "36bb3421-743b