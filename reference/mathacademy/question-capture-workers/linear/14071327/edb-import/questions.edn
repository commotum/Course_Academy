wer.type/math} :answer/value "10" :db/id #edb/ref 17592186123319} :answer-field/id #uuid "612cfb5a-c629-5363-a78c-971d8dbcfa35" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123316}] :question/id #uuid "5471fadb-1b86-5cb7-bba6-ebb075794d52" :question/math-academy-id "q-38627" :question/problem "Let $T = \\begin{bmatrix}3 & -8 & 0 \\\\ 2 & -4 & 0 \\\\ -2 & 10 & 0\\end{bmatrix}$ be the standard matrix of the linear transformation $T$. Determine the value of $k$ for which the vector $v = \\begin{bmatrix}6 \\\\ 8 \\\\ k\\end{bmatrix}$ belongs to $Im(T)$."}] [{:db/id #edb/ref 17592186125066 :knowledge-point/_questions [{:knowledge-point/id #uuid "e1baaf3c-f907-59dc-b9f9-a476a2889e73" :knowledge-point/title "Calculating the Rank of a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90b9f09e-06eb-597a-8e8e-6809d6c36e3a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186123419} {:answer/id #uuid "d7fdeef1-b290-55c5-8869-0d9c213b5467" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186123420} {:answer/id #uuid "f7187eae-6cd3-5033-8042-7ab63c2235d2" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186123421} {:answer/id #uuid "335d6e5c-d705-5d76-9064-541f823f99d2" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186123422} {:answer/id #uuid "6d5a75c4-6d4e-54c4-8c19-f7515d73fe9c" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186123423}] :answer-field/correct {:answer/id #uuid "d7fdeef1-b290-55c5-8869-0d9c213b5467" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186123420} :answer-field/id #uuid "37a7684d-9d1f-500d-8b3d-16f48a3f445c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123418}] :question/id #uuid "