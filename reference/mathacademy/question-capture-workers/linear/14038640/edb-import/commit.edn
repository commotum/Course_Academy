54 13194139534644 true] [17592186300903 1111 #uuid "4bc90cb7-4ec9-59f6-8401-434e866fc3c4" 13194139534644 true] [17592186300904 1034 "I and III only" 13194139534644 true] [17592186300904 1103 #edb/ref 17592186045454 13194139534644 true] [17592186300904 1111 #uuid "cb5575f0-fea3-514f-ab3b-8c57659c577e" 13194139534644 true] [17592186300905 1034 "III only" 13194139534644 true] [17592186300905 1103 #edb/ref 17592186045454 13194139534644 true] [17592186300905 1111 #uuid "384948e2-1c4a-5bd4-a532-7818b6eaa82e" 13194139534644 true] [17592186300906 1034 "I, II and III" 13194139534644 true] [17592186300906 1103 #edb/ref 17592186045454 13194139534644 true] [17592186300906 1111 #uuid "449ccb0a-e190-598c-86c9-5f68b2f0620a" 13194139534644 true] [17592186300907 1034 "II only" 13194139534644 true] [17592186300907 1103 #edb/ref 17592186045454 13194139534644 true] [17592186300907 1111 #uuid "98b55c16-84c3-522a-af9e-025a4a6a2af4" 13194139534644 true] [17592186300908 1017 #edb/ref 17592186300909 13194139534644 true] [17592186300908 1089 "q-105039" 13194139534644 true] [17592186300908 1091 #edb/ref 17592186045463 13194139534644 true] [17592186300908 1100 "Which statement is **not** true?" 13194139534644 true] [17592186300908 1113 #uuid "91d09261-286a-5e85-a61f-8483207f7bbc" 13194139534644 true] [17592186300908 1145 "If $A⊆B,$ then $A$ is a subset of $B,$ meaning that every element of $A$ is an element of $B.$\n\nAmong the given choices, only ${Z}^{-}⊆N$ is not true. This statement is not true because not every negative integer is a natural number. For example, we have $-1\\in {Z}^{-}$ but $-1\\notin N.$" 13194139534644 true] [17592186300909 1000 #edb/ref 17592186300910 13194139534644 true] [17592186300909 1000 #edb/ref 17592186300911 13194139534644 true] [17592186300909 1000 #edb/ref 17592186300912 13194139534644 true] [17592186300909 1000 #edb/ref 17592186300913 13194139534644 true] [17592186300909 1000 #edb/ref 17592186300914 13194139534644 true] [17592186300909 1040 #edb/ref 17592186045450 13194139534644 true] [17592186300909 1041 "selection" 13194139534644 true] [17592186300909 1104 #edb/ref 17592186300912 13194139534644 true] [17592186300909 1110 #uuid "78636117-3097-5d38-a9ce-05be652b501a" 13194139534644 true] [17592186300910 1034 "Q⊆Q" 13194139534644 true] [17592186300910 1103 #edb/ref 17592186045453 13194139534644 true] [17592186300910 1111 #uuid "5e29efb3-1373-5e2e-8d00-795254c1eaa8" 13194139534644 true] [17592186300911 1034 "Q⊆R" 13194139534644 true] [17592186300911 1103 #edb/ref 17592186045453 13194139534644 true] [17592186300911 1111 #uuid "c7982993-e896-5b93-9233-611859b5a7b7" 13194139534644 true] [17592186300912 1034 "{Z}^{-}⊆N" 13194139534644 true] [17592186300912 1103 #edb/ref 17592186045453 13194139534644 true] [17592186300912 1111 #uuid "ea2f1c28-6275-5ddc-8751-ceafc1282548" 13194139534644 true] [17592186300913 1034 "N⊆C" 13194139534644 true] [17592186300913 1103 #edb/ref 17592186045453 13194139534644 true] [17592186300913 1111 #uuid "adef0a65-5cb8-52ba-8bf7-0637ee4acce7" 13194139534644 true] [17592186300914 1034 "Z⊆Q" 13194139534644 true] [17592186300914 1103 #edb/ref 17592186045453 13194139534644 true] [17592186300914 1111 #uuid "881498c9-be6f-5efd-a005-ac512575f4a5" 13194139534644 true] [17592186300915 1017 #edb/ref 17592186300916 13194139534644 true] [17592186300915 1089 "q-105064" 13194139534644 true] [17592186300915 1091 #edb/ref 17592186045465 13194139534644 true] [17592186300915 1100 "Which of the following statements are true for the sets $A={n\\in N∣n-2\\ge 4}$ and $B={n\\in Z∣n+2\\ge 5}?$\n\n- $A⊆B$\n- $B⊆A$\n- $∅⊆A$\n- $B⊇A$" 13194139534644 true] [17592186300915 1113 #uuid "90026120-6d23-527b-8cd4-e6e4979a06e4" 13194139534644 true] [17592186300915 1145 "First, we must find the elements of the sets $A$ and $B.$\n\n- The elements of the set $A$ are all the natural numbers that satisfy the inequality $n-2\\ge 4,$ that is to say, $n\\ge 6.$ So, we have\n\n$$\nA={6,7,8,9,10,11,…}.\n$$\n\n- On the other hand, the elements of the set $B$ are all integers that satisfy the inequality $n+2\\ge 5,$ That is to say, $n\\ge 3.$ So, we have\n\n$$\nB={3,4,5,6,7,8,…}.\n$$\n\nNow, let's inspect the given statements.\n\n- $A⊆B$ is true. Every element in the set $A$ is an element of the set $B.$\n\n- $B⊆A$ is false. For example, $3\\in B$ but $3\\notin A.$\n\n- $∅⊆A$ is true. The null set $∅={}$ is a subset of *every* set.\n\n- $B⊇A$ is equivalent to $A⊆B,$ which is true.\n\nTherefore, the correct answer is \"I, III, and IV only.\"" 13194139534644 true] [17592186300916 1000 #edb/ref 17592186300917 13194139534644 true] [17592186300916 1000 #edb/ref 17592186300918 13194139534644 true] [17592186300916 1000 #edb/ref 17592186300919 13194139534644 true] [17592186300916 1000 #edb/ref 17592186300920 13194139534644 true] [17592186300916 1000 #edb/ref 17592186300921 13194139534644 true] [17592186300916 1040 #edb/ref 17592186045450 13194139534644 true] [17592186300916 1041 "selection" 13194139534644 true] [17592186300916 1104 #edb/ref 17592186300919 13194139534644 true] [17592186300916 1110 #uuid "62b3f659-2e8b-5bf8-849c-7bf158e0d774" 13194139534644 true] [17592186300917 1034 "II and III only" 13194139534644 true] [17592186300917 1103 #edb/ref 17592186045454 13194139534644 true] [17592186300917 1111 #uuid "ddd387eb-ba17-5d21-b2de-737f5a252db5" 13194139534644 true] [17592186300918 1034 "I and III only" 13194139534644 true] [17592186300918 1103 #edb/ref 17592186045454 13194139534644 true] [17592186300918 1111 #uuid "2806b1b0-bb56-5070-b3ac-229501b50366" 13194139534644 true] [17592186300919 1034 "I, III, and IV only" 13194139534644 true] [17592186300919 1103 #edb/ref 17592186045454 13194139534644 true] [17592186300919 1111 #uuid "2845a4bf-3b5e-5cf9-a985-fc686a662a91" 13194139534644 true] [17592186300920 1034 "III and IV only" 13194139534644 true] [17592186300920 1103 #edb/ref 17592186045454 13194139534644 true] [17592186300920 1111 #uuid "02a66fd6-63a7-5f02-aac2-051a0cc4be24" 13194139534644 true] [17592186300921 