21dc69c8bc09f12797d1d686e8c9e8e6"] :db/ensure [:answer-field/validate]} {:db/id "q-80812" :question/id #uuid "bc2578ed-7aae-5f12-a163-5aa37a8919bf" :question/math-academy-id "q-80812" :question/problem "Which of the following are subsets of ${Q}^{+}$  (the set of positive rational numbers)?\n\n- ${Q}_{0}^{+}$ (the set of non-negative rational numbers)\n- $N$\n- $Z$" :question/worked-solution "$A$ is a subset of $B$ if every element of $A$ is an element of $B.$\n\nWith that in mind, let's inspect the given choices.\n\n- ${Q}_{0}^{+}$ is not a subset of ${Q}^{+}.$ For example, $0\\in {Q}_{0}^{+}$ but $0\\notin {Q}^{+}.$\n\n- $N$ is a subset of ${Q}^{+}.$ Indeed, every natural number is also a positive rational number.\n\n- $Z$ is not a subset of ${Q}^{+}.$ For example, $-1\\in Z$ but $-1\\notin {Q}^{+}.$\n\nTherefore, the correct answer is \"II only\"." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-80812/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9b7f1d12-3335-5dd7-bf36-e07077d0c45d"] :knowledge-point/questions ["q-80812"] :db/ensure [:knowledge-point/validate]} {:db/id "q-80810/selection/80ed9cdfaebda824cbe44298185f5d2a12041e636c6a7a263eeea8ce39cb2a89" :answer/id #uuid "85e6b4d8-a6ea-566f-9562-99e396f1006c" :answer/type :answer.type/math :answer/value "N⊆Q" :db/ensure [:answer/validate]} {:db/id "q-80810/selection/83ecf189389cf3fc70f0747c1da38769a48a4b0abd4fc8cd441b40be21951c93" :answer/id #uuid "1e79add0-ea94-5476-a9be-ae0681788037" :answer/type :answer.type/math :answer/value "Z⊆R" :db/ensure [:answer/validate]} {:db/id "q-80810/selection/608aa8eee889cc9ba516a8468964f58babe8f298be2aea159122552581473af6" :answer/id #uuid "0c5213fe-c035-5fec-a59a-ef4f9270f5e8" :answer/type :answer.type/math :answer/value "Q⊆R" :db/ensure [:answer/validate]} {:db/id "q-80810/selection/de61cabd6b263988b6c4eb8b6a195fa3de6877a4fc1e2d2a755ea1496347978a" :answer/id #uuid "ac99c84f-92d3-5525-a082-91a3afffe877" :answer/ty