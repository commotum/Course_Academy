d #uuid "98359209-bf7e-5f57-bdca-7083b041eb2a" :answer/type :answer.type/text :answer/value "$50$ and $32$" :db/ensure [:answer/validate]} {:db/id "q-7601/selection/9a72ca1dc47bf25f8c3aa0e227271ca50fb225e7541baa4aae4a32691ca11871" :answer/id #uuid "40790eb2-65af-5829-965a-210ba1346ceb" :answer/type :answer.type/text :answer/value "$5$ and $4$" :db/ensure [:answer/validate]} {:db/id "q-7601/selection/c9a320c544e7dc8e51eda8f9456d821856bb320ad2432a70e6675de2da0645d5" :answer/id #uuid "bb63ec74-31d9-5b97-bfd4-adb1557fc2da" :answer/type :answer.type/text :answer/value "$\\sqrt{5}$ and $2$" :db/ensure [:answer/validate]} {:db/id "q-7601/selection/b6b4843be470cec5c0f9008c4662f65a21e8758c2b1e0ce3d9c0f48693dcc468" :answer/id #uuid "6c1598a7-1301-5a4a-aee2-bb877212da6a" :answer/type :answer.type/text :answer/value "$10$ and $8$" :db/ensure [:answer/validate]} {:db/id "q-7601/selection/3282f377600ce3456dc77a27db571b30e94d2b5e6e55ad51ae66cad4ddde0e73" :answer/id #uuid "69780d0e-b47b-5857-a7d7-f64664effc32" :answer/type :answer.type/text :answer/value "$25$ and $16$" :db/ensure [:answer/validate]} {:db/id "q-7601/selection" :answer-field/id #uuid "35a53f71-a2af-5674-b14e-2dd4603052c1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-7601/selection/b6b4843be470cec5c0f9008c4662f65a21e8758c2b1e0ce3d9c0f48693dcc468" :answer-field/choices ["q-7601/selection/f2f65059744765325db885af7cced55fdd6c6870590563da11dd0edbd28605c0" "q-7601/selection/9a72ca1dc47bf25f8c3aa0e227271ca50fb225e7541baa4aae4a32691ca11871" "q-7601/selection/c9a320c544e7dc8e51eda8f9456d821856bb320ad2432a70e6675de2da0645d5" "q-7601/selection/b6b4843be470cec5c0f9008c4662f65a21e8758c2b1e0ce3d9c0f48693dcc468" "q-7601/selection/3282f377600ce3456dc77a27db571b30e94d2b5e6e55ad51ae66cad4ddde0e73"] :db/ensure [:answer-field/validate]} {:db/id "q-7601" :question/id #uuid "ac2c9003-5051-5900-b74a-13fbad11f3f1" :question/math-academy-id "q-7601" :question/problem "What are the lengths of the major and minor axes of an ellipse with equation \n$\\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{25}=1?$" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have ${a}^{2}=16$ and ${b}^{2}=25.$\n\n- Since ${a}^{2}=16,$ the length of the horizontal radius must be $a=\\sqrt{16}=4.$\n\n- Since ${b}^{2}=25,$ the length of the vertical radius must be $b=\\sqrt{25}=5.$\n\nSo the semi-major axis has length $b=5,$ and the semi-minor axis has length $a=4.$\n\nTherefore, the major axis has length $2b=2\\cdot 5=10,$ and the minor axis has length $2a=2\\cdot 4=8.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-7601/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4e43e393-8752-58bc-b87c-b72f679cbfd9"] :knowledge-point/questions ["q-7601"] :db/ensure [:knowledge-point/validate]} {:db/id "q-279174/field-1/d79808b1304c1856f3712e6e226ade34c7caf51f0407b91d3e2447e1f8a47743" :answer/id #uuid "c11b67ee-c12e-565b-9fc5-2eff5e0a6b19" :answer/type :answer.type/math :answer/value "4\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-279174/field-1/05402db46107d70ece210f0bd5e24b332ae4f43bd474d592035c3e3c92625629" :answer/id #uuid "ec3bd655-3364-5495-9679-0e145c9df1fa" :answer/type :answer.type/math :answer/value "2\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-279174/field-1" :answer-field/id #uuid "5ed18835-8117-5b30-ac45-d214f8df0f38" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-279174/field-1/d79808b1304c1856f3712e6e226ade34c7caf51f0407b91d3e2447e1f8a47743" :answer-field/choices ["q-279174/field-1/d79808b1304c1856f3712e6e226ade34c7caf51f0407b91d3e2447e1f8a47743" "q-279174/field-1/05402db46107d70ece210f0bd5e24b332ae4f43bd474d592035c3e3c92625629"] :db/ensure [:answer-field/validate]} {:db/id "q-279174/field-2/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "7aea9913-6c57-50c3-b4d5-77599533139e" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-279174/field-2" :answer-field/id #uuid "b4b37ddb-c852-5d0b-85bf-342941ca846c" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-279174/field-2/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-279174/field-2/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-279174" :question/id #uuid "97355673-c5e8-5526-b74b-524ac265b2d0" :question/math-academy-id "q-279174" :question/problem "For the ellipse $\\frac{{x}^{2}}{12}+\\frac{{y}^{2}}{9}=1,$ find the lengths of its major and minor axes.\n\n$\\,$ The length of the major axis is \n{{field-1}}.\n\n$\\,$ The length of the minor axis is \n{{field-2}}." :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have ${a}^{2}=12$ and ${b}^{2}=9.$\n\n- Since ${a}^{2}=12,$ the length of the horizontal radius must be $a=\\sqrt{12}=2\\sqrt{3}.$\n\n- Since ${b}^{2}=9,$ the length of the vertical radius must be $b=\\sqrt{9}=3.$\n\nThus, the semi-major axis has length $a=2\\sqrt{3},$ and the semi-minor axis has length $b=3.$\n\nTherefore, the major axis has length $2a=2\\cdot 2\\sqrt{3}=4\\sqrt{3},$ and the minor axis has length $2b=2\\cdot 3=6.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-279174/field-1" "q-279174/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4e43e393-8752-58bc-b87c-b72f679cbfd9"] :knowledge-point/questions ["q-279174"] :db/ensure [:knowledge-point/validate]} {:db/id "q-279172/field-1/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "d49428e2-09f5-5fa2-832e-472caf401405" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-279172/field-1" :answer-field/id #uuid "617a7b14-a82c-57c4-9d97-989ab57e0c1e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-279172/field-1/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer-field/choices ["q-279172/field-1/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97"] :db/ensure [:answer-field/validate]} {:db/id "q-279172/field-2/0c8b08d4b198d89c5fe756f861bd5b37e398d2a5b3237908210d9646370a666f" :answer/id #uuid "60bf746b-b736-5a8f-89ec-a28eb5121661" :answer/type :answer.type/math :answer/value "2\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "q-279172/field-2" :answer-field/id #uuid "721f4a97-2e90-559a-8019-033fddefb719" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-279172/field-2/0c8b08d4b198d89c5fe756f861bd5b37e398d2a5b3237908210d9646370a666f" :answer-field/choices ["q-279172/field-2/0c8b08d4b198d89c5fe756f861bd5b37e398d2a5b3237908210d9646370a666f"] :db/ensure [:answer-field/validate]} {:db/id "q-279172" :question/id #uuid "f3f5be58-b580-5f5b-b51d-181a795c844e" :question/math-academy-id "q-279172" :question/problem "For the ellipse $\\frac{{x}^{2}}{36}+\\frac{{y}^{2}}{5}=1,$ find the lengths of its major and minor axes.\n\n$\\,$ The length of the major axis is \n{{field-1}}.\n\n$\\,$ The length of the minor axis is \n{{field-2}}." :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have ${a}^{2}=36$ and ${b}^{2}=5.$\n\n- Since ${a}^{2}=36,$ the length of the horizontal radius must be $a=\\sqrt{36}=6.$\n\n- Since ${b}^{2}=5,$ the length of the vertical radius must be $b=\\sqrt{5}.$\n\nThus, the semi-major axis has length $a=6,$ and the semi-minor axis has length $b=\\sqrt{5}.$\n\nTherefore, the major axis has length $2a=2\\cdot 6=12,$ and the minor axis has length $2b=2\\cdot \\sqrt{5}=2\\sqrt{5}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-279172/field-1" "q-279172/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4e43e393-8752-58bc-b87c-b72f679cbfd9"] :knowledge-point/questions ["q-279172"] :db/ensure [:knowledge-point/validate]} {:db/id "q-7597/selection/78be9a384f78807f18f8d80eaa7b91a3fdff8b40ed26e0d72a32b8e9f5ccd9a4" :answer/id #uuid "49caabf1-8a45-5fb9-b285-5e0e6925936a" :answer/type :answer.type/text :answer/value "$20$ and $16$" :db/ensure [:answer/validate]} {:db/id "q-7597/selection/c9a320c544e7dc8e51eda8f9456d821856bb320ad2432a70e6675de2da0645d5" :answer/id #uuid "afb0cc5f-207a-5937-90f5-43576789c062" :answer/type :answer.type/text :answer/value "$\\sqrt{5}$ and $2$" :db/ensure [:answer/validate]} {:db/id "q-7597/selection/6a7004d084b2d346df9a3d8e434b1412014527000e696e6d1ef1af37e183d648" :answer/id #uuid "01fb5785-3bfd-590e-bd98-4314caba8958" :answer/type :answer.type/text :answer/value "$2\\sqrt{5}$ and $4$" :db/ensure [:answer/validate]} {:db/id "q-7597/selection/5a51552a2a5cd5c79e23e95115ade746abeb43ef25553e1701226da1e7510043" :answer/id #uuid "c08e4441-1b85-548e-866f-0bbe91509b31" :answer/type :answer.type/text :answer/value "$4\\sqrt{5}$ and $8$" :db/ensure [:answer/validate]} {:db/id "q-7597/selection/b6b4843be470cec5c0f9008c4662f65a21e8758c2b1e0ce3d9c0f48693dcc468" :answer/id #uuid "b7b8ca2d-f57a-5836-9fbf-cd20e35e1328" :answer/type :answer.type/text :answer/value "$10$ and $8$" :db/ensure [:answer/validate]} {:db/id "q-7597/selection" :answer-field/id #uuid "e6eb3028-8a16-537e-abc8-0c81cc9ab9b8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-7597/selection/5a51552a2a5cd5c79e23e95115ade746abeb43ef25553e1701226da1e7510043" :answer-field/choices ["q-7597/selection/78be9a384f78807f18f8d80eaa7b91a3fdff8b40ed26e0d72a32b8e9f5ccd9a4" "q-7597/selection/c9a320c544e7dc8e51eda8f9456d821856bb320ad2432a70e6675de2da0645d5" "q-7597/selection/6a7004d084b2d346df9a3d8e434b1412014527000e696e6d1ef1af37e183d648" "q-7597/selection/5a51552a2a5cd5c79e23e95115ade746abeb43ef25553e1701226da1e7510043" "q-7597/selection/b6b4843be470cec5c0f9008c4662f65a21e8758c2b1e0ce3d9c0f48693dcc468"] :db/ensure [:answer-field/validate]} {:db/id "q-7597" :question/id #uuid "e572cb8d-0721-59ec-897a-5e0fa685feb4" :question/math-academy-id "q-7597" :question/problem "What are the lengths of the major and minor axes of an ellipse with equation \n$\\frac{{x}^{2}}{20}+\\frac{{y}^{2}}{16}=1?$" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have ${a}^{2}=20$ and ${b}^{2}=16.$\n\n- Since ${a}^{2}=20,$ the length of the horizontal radius must be $a=\\sqrt{20}=2\\sqrt{5}.$\n\n- Since ${b}^{2}=16,$ the length of the vertical radius must be $b=\\sqrt{16}=4.$\n\nSo the semi-major axis has length $a=2\\sqrt{5},$ and the semi-minor axis has length $b=4.$\n\nTherefore, the major axis has length $2a=2\\cdot 2\\sqrt{5}=4\\sqrt{5},$ and the minor axis has length $2b=2\\cdot 4=8.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-7597/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4e43e393-8752-58bc-b87c-b72f679cbfd9"] :knowledge-point/questions ["q-7597"] :db/ensure [:knowledge-point/validate]} {:db/id "q-16452/selection/a1d3a0bfb4d700856d9fb14d1d861ba0bbc78f4b7d79ba9aec61a9bd1e355235" :answer/id #uuid "9246fb75-7836-569e-b02b-1f0dd0711b28" :answer/type :answer.type/text :answer/value "$4$ and $2$" :db/ensure [:answer/validate]} {:db/id "q-16452/selection/9bfe4c6947fdc56754d587c9f1f163d97339b2b79ae9df032f83a30c6d89af85" :answer/id #uuid "34b74a26-5ad4-57a6-a41d-060a064812a6" :answer/type :answer.type/text :answer/value "$4$ and $2\\sqrt{2}$" :db/ensure [:answer/validate]} {:db/id "q-16452/selection/e77f11ef954a64fce5809fc7c6d7619a34329c975e4a9bd121ecfe57b2fc2aa3" :answer/id #uuid "f7db46ca-fb33-5454-a0e1-0cadf0330499" :answer/type :answer.type/text :answer/value "$2\\sqrt{2}$ and $2$" :db/ensure [:answer/validate]} {:db/id "q-16452/selection/5a05eb07a343e37ff67585adb95517191778ce43ec136b94ea103266bbe9f740" :answer/id #uuid "1722f41a-afa9-525e-a1fd-62d5499b043c" :answer/type :answer.type/text :answer/value "$2\\sqrt{2}$ and $\\sqrt{2}$" :db/ensure [:answer/validate]} {:db/id "q-16452/selection/89e81e61edc51bcd8b1ce98252e8b23bf12cc0a8779101b87099cf50a6bb3857" :answer/id #uuid "028101b6-364f-568f-8d72-b8457b6b641e" :answer/type :answer.type/text :answer/value "$8$ and $4$" :db/ensure [:answer/validate]} {:db/id "q-16452/selection" :answer-field/id #uuid "0523d0ad-16cf-57cf-90d1-c281bfc83b91" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-16452/selection/9bfe4c6947fdc56754d587c9f1f163d97339b2b79ae9df032f83a30c6d89af85" :answer-field/choices ["q-16452/selection/a1d3a0bfb4d700856d9fb14d1d861ba0bbc78f4b7d79ba9aec61a9bd1e355235" "q-16452/selection/9bfe4c6947fdc56754d587c9f1f163d97339b2b79ae9df032f83a30c6d89af85" "q-16452/selection/e77f11ef954a64fce5809fc7c6d7619a34329c975e4a9bd121ecfe57b2fc2aa3" "q-16452/selection/5a05eb07a343e37ff67585adb95517191778ce43ec136b94ea103266bbe9f740" "q-16452/selection/89e81e61edc51bcd8b1ce98252e8b23bf12cc0a8779101b87099cf50a6bb3857"] :db/ensure [:answer-field/validate]} {:db/id "q-16452" :question/id #uuid "de7c911d-465c-5e7a-89aa-81a0a052648b" :question/math-academy-id "q-16452" :question/problem "What are the lengths of the major and minor axes of an ellipse with equation \n$\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{2}=1?$" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have ${a}^{2}=4$ and ${b}^{2}=2.$\n\n- Since ${a}^{2}=4,$ the length of the horizontal radius must be $a=\\sqrt{4}=2.$\n\n- Since ${b}^{2}=2,$ the length of the vertical radius must be $b=\\sqrt{2}.$\n\nSo the semi-major axis has length $a=2,$ and the semi-minor axis has length $b=\\sqrt{2}.$\n\nTherefore, the major axis has length $2a=2\\cdot 2=4,$ and the minor axis has length $2b=2\\cdot \\sqrt{2}=2\\sqrt{2}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-16452/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4e43e393-8752-58bc-b87c-b72f679cbfd9"] :knowledge-point/questions ["q-16452"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-5071"] :question/problem "What is the equation of the ellipse given below?\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039348/assets/6d2ba3fba1a05a841a486553ea3a52d6f3797974630420ad79ae50f4c6f5bc15.png)" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=5$ and the vertical radius has length $b=3.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{5}^{2}}+\\frac{{y}^{2}}{{3}^{2}} & =1 \\\\ \\frac{{x}^{2}}{25}+\\frac{{y}^{2}}{9} & =1.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5072"] :question/problem "What is the equation of the ellipse given below?\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039348/assets/3e8d5ed4bf055960b50e046c0688a3c4cc69907ebb1209bb9658ac4bcba48ffe.png)" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=2$ and the vertical radius has length $b=4.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{2}^{2}}+\\frac{{y}^{2}}{{4}^{2}} & =1 \\\\ \\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{16} & =1.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5073"] :question/problem "What are the lengths of the major and minor axes of an ellipse with equation $\\dfrac{x^2}{36} + \\dfrac{y^2}{25} = 1?$" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2}=1.\n$$\n\n \n\nIn the given equation, we have $a^2=36$ and $b^2=25.$\n\n- Since $a^2=36,$ the length of the horizontal radius must be $a=\\sqrt{36} = 6.$\n\n- Since $b^2=25,$ the length of the vertical radius must be $b=\\sqrt{25} = 5.$\n\nSo the semi-major axis has length $a=6,$ and the semi-minor axis has length $b=5.$\n\nTherefore, the major axis has length $2a = 2 \\cdot 6 = 12,$ and the minor axis has length $2b = 2 \\cdot 5 =10.$" :db/ensure [:question/validate]}]
