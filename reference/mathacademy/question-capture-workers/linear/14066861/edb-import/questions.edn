#{[{:db/id #edb/ref 17592186289681 :knowledge-point/_questions [{:knowledge-point/id #uuid "678ba6cb-b259-5a25-858c-9db161a34ca9" :knowledge-point/title "Dividing a Real Number by a Complex Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe872831-989c-5473-a0f8-75d5ab01b2d2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}+\\text{i}" :db/id #edb/ref 17592186289683} {:answer/id #uuid "809014ed-80e6-5dc4-bab2-00c035d21430" :answer/type {:db/ident :answer.type/math} :answer/value "-1+\\frac{1}{2}\\text{i}" :db/id #edb/ref 17592186289684} {:answer/id #uuid "f7492d90-829b-584f-8cf2-d8227282418c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}-\\text{i}" :db/id #edb/ref 17592186289685} {:answer/id #uuid "a501e753-3733-58cc-9a0d-efe174e90eb8" :answer/type {:db/ident :answer.type/math} :answer/value "-1-\\frac{1}{2}\\text{i}" :db/id #edb/ref 17592186289686} {:answer/id #uuid "b2dcbd05-d7d8-5833-994f-8f616fab98cb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}+\\text{i}" :db/id #edb/ref 17592186289687}] :answer-field/correct {:answer/id #uuid "f7492d90-829b-584f-8cf2-d8227282418c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}-\\text{i}" :db/id #edb/ref 17592186289685} :answer-field/id #uuid "d0be58e1-499a-5ed6-b5c8-bfb3ea378b0e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289682}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d941dd07-47ec-5356-b0e4-b3fa2d7c5f55" :question/math-academy-id "q-16440" :question/problem "$\\frac{5}{-2+4\\text{i}}=$" :question/worked-solution "The denominator is $-2+4\\text{i}$ and its conjugate is $-2-4\\text{i}.$ We multiply both the numerator and the denominator by $-2-4\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{5}{-2+4\\text{i}} & =\\frac{5}{-2+4\\text{i}}\\cdot \\frac{-2-4\\text{i}}{-2-4\\text{i}} \\\\  & =\\frac{-10-20\\text{i}}{4+8\\text{i}-8\\text{i}-16{\\text{i}}^{2}} \\\\  & =\\frac{-10-20\\text{i}}{4-16{\\text{i}}^{2}} \\\\  & =\\frac{-10-20\\text{i}}{4-16(-1)} \\\\  & =\\frac{-10-20\\text{i}}{4+16} \\\\  & =\\frac{-10-20\\text{i}}{20}\\end{aligned}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{-10-20\\text{i}}{20}=-\\frac{10}{20}-\\frac{20}{20}\\text{i}=-\\frac{1}{2}-\\text{i}\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186289688 :knowledge-point/_questions [{:knowledge-point/id #uuid "27da4eb7-48c8-58f4-9676-c88d659f5fbb" :knowledge-point/title "Dividing an Imaginary Number by a Complex Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fe10282-508d-5b3b-9908-a3fbb1809ad2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{12}{13}" :db/id #edb/ref 17592186289690} {:answer/id #uuid "5890c373-95be-51c9-b36a-e328a1eba4d2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{13}" :db/id #edb/ref 17592186289691}] :answer-field/correct {:answer/id #uuid "2fe10282-508d-5b3b-9908-a3fbb1809ad2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{12}{13}" :db/id #edb/ref 17592186289690} :answer-field/id #uuid "acc6a535-454a-5ae0-9bd1-6c9689bc94d5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289689} {:answer-field/choices [{:answer/id #uuid "1d4b58b2-e536-5fbf-b4be-42d31a2e89ea" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{8}{13}" :db/id #edb/ref 17592186289693}] :answer-field/correct {:answer/id #uuid "1d4b58b2-e536-5fbf-b4be-42d31a2e89ea" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{8}{13}" :db/id #edb/ref 17592186289693} :answer-field/id #uuid "9a14e7aa-438b-5c59-9476-9abd225220fe" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289692}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9171a28d-fa2f-567e-a2a1-2aa08147aac0" :question/math-academy-id "q-316855" :question/problem "Evaluate the expression below, expressing your answer in the form $a+b\\text{i},$ where $a$ and $b$ are real numbers.\n\n$\\frac{4\\text{i}}{-2-3\\text{i}}=($ {{field-1}} \n$)\\,+\\,($\n{{field-2}}\n$)\\,\\text{i}$" :question/worked-solution "The denominator is $-2-3\\text{i}$ and its conjugate is $-2+3\\text{i}.$ We multiply both the numerator and the denominator by $-2+3\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{4\\text{i}}{-2-3\\text{i}} & =\\frac{4\\text{i}}{-2-3\\text{i}}\\cdot \\frac{-2+3\\text{i}}{-2+3\\text{i}} \\\\  & =\\frac{-8\\text{i}+12{\\text{i}}^{2}}{(-2)^{2}-(3\\text{i})^{2}} \\\\  & =\\frac{-8\\text{i}+12(-1)}{4-(-9)} \\\\  & =\\frac{-12-8\\text{i}}{13}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\frac{-12-8\\text{i}}{13}=(-\\frac{12}{13})+(-\\frac{8}{13})\\,\\text{i}\n$$"}] [{:db/id #edb/ref 17592186060217 :knowledge-point/_questions [{:knowledge-point/id #uuid "678ba6cb-b259-5a25-858c-9db161a34ca9" :knowledge-point/title "Dividing a Real Number by a Complex Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a2cf344b-9410-514d-aa65-570d10bf6a17" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{13} - \\frac{2}{13}\\textrm{i}" :db/id #edb/ref 17592186058286} {:answer/id #uuid "a6ceb044-8bad-56fe-9bec-982ff9881361" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{13} + \\frac{2}{13}\\textrm{i}" :db/id #edb/ref 17592186058287} {:answer/id #uuid "fcc60e4d-e892-508c-8b3f-d2a8d891948e" :answer/type {:db/ident :answer.type/math} :answer