475e9deedf896f29edf73b7d70ba6a67fc36cabe69ff88e4b5f319a8651da3/7ffe312864b29cda80ee9798d60d1217ce7a84c9b0d12a5562e0f011d7460d32" :answer-field/choices ["q-541/selection/ma-v1/ba475e9deedf896f29edf73b7d70ba6a67fc36cabe69ff88e4b5f319a8651da3/9932a297eab1f5a253cc79236901cf5e89313fecf1a371cd8a9a03a90fdc2117" "q-541/selection/ma-v1/ba475e9deedf896f29edf73b7d70ba6a67fc36cabe69ff88e4b5f319a8651da3/7ffe312864b29cda80ee9798d60d1217ce7a84c9b0d12a5562e0f011d7460d32" "q-541/selection/ma-v1/ba475e9deedf896f29edf73b7d70ba6a67fc36cabe69ff88e4b5f319a8651da3/dbb05ba367591826c2bc743abc8476457aef86c5473ea6d1df971ce6275f5e4b" "q-541/selection/ma-v1/ba475e9deedf896f29edf73b7d70ba6a67fc36cabe69ff88e4b5f319a8651da3/1f7656003d06213b049a5b462ae239d0b9dbf54316bfd291741a5a612d3d1384" "q-541/selection/ma-v1/ba475e9deedf896f29edf73b7d70ba6a67fc36cabe69ff88e4b5f319a8651da3/dd031a8590167a446db649ebf5dee2072a4f32625f9c82e02eaf35233900296f"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-541"] :question/problem "$\\frac{3}{3+2\\text{i}}=$" :question/worked-solution "The denominator is $3+2\\text{i}$ and its conjugate is $3-2\\text{i}.$ We multiply both the numerator and the denominator by $3-2\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{3}{3+2\\text{i}} & =\\frac{3}{3+2\\text{i}}\\cdot \\frac{3-2\\text{i}}{3-2\\text{i}} \\\\  & =\\frac{9-6\\text{i}}{9-6\\text{i}+6\\text{i}-4{\\text{i}}^{2}} \\\\  & =\\frac{9-6\\text{i}}{9-4{\\text{i}}^{2}} \\\\  & =\\frac{9-6\\text{i}}{9-(4)(-1)} \\\\  & =\\frac{9-6\\text{i}}{9+4} \\\\  & =\\frac{9-6\\text{i}}{13}\\end{aligned}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{9-6\\text{i}}{13}=\\frac{9}{13}-\\frac{6}{13}\\text{i}\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-541/selection/ma-v1/ba475e9deedf896f29edf73b7d70ba6a67fc36cabe69ff88e4b5f319a8651da3"] :db/ensure [:question/validate]} {:db/id "q-316853/field-1/6954f64f1a7e4e23c6a2af9969e9f3c6a69492db61d355dbdd0190ca81c8bb08" :answer/id #uuid "63482b08-ed9c-542a-bf7a-390d49069a77" :answer/type :answer.type/math :answer/value "\\frac{16}{17}" :db/ensure [:answer/validate]} {:db/id "q-316853/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "0abc0ee6-062a-5ed2-bd29-3aa3466ae157" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-316853/field-1" :answer-field/id #uuid "3cdcad5b-61bb-511e-a35c-947990dd2e07" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316853/field-1/6954f64f1a7e4e23c6a2af9969e9f3c6a69492db61d355dbdd0190ca81c8bb08" :answer-field/choices ["q-316853/field-1/6954f64f1a7e4e23c6a2af9969e9f3c6a69492db61d355dbdd0190ca81c8bb08" "q-316853/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-316853/field-2/e0192cb23566eff78ac7077b75e26167992708c7b6b3747d50a4169176751304" :answer/id #uuid "9e842fb6-339b-59e3-8b4f-e94087a4da03" :answer/type :answer.type/math :answer/value "-\\frac{4}{17}" :db/ensure [:answer/validate]} {:db/id "q-316853/field-2" :answer-field/id #uuid "6532757c-3046-5eb8-a9b8-c2f2924bb280" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316853/field-2/e0192cb23566eff78ac7077b75e26167992708c7b6b3747d50a4169176751304" :answer-field/choices ["q-316853/field-2/e0192cb23566eff78ac7077b75e26167992708c7b6b3747d50a4169176751304"] :db/ensure [:answer-field/validate]} {:db/id "q-316853" :question/id #uuid "f0824f4a-ca8b-50d5-a258-9b2a91d0733a" :question/math-academy-id "q-316853" :question/problem "Evaluate the expression below, expressing your answer in the form $a+b\\text{i},$ where $a$ and $b$ are real numbers.\n\n$\\frac{4\\text{i}}{-1+4\\text{i}}=($\n {{field-1}} \n$)\\,+\\,($\n{{field-2}}\n$)\\,\\text{i}$" :question/worked-solution "The denominator is $-1+4\\text{i}$ and its conjugate is $-1-4\\text{i}.$ We multiply both the numerator and the denominator by $-1-4\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{4\\text{i}}{-1+4\\text{i}} & =\\frac{4\\text{i}}{-1+4\\text{i}}\\cdot \\frac{-1-4\\text{i}}{-1-4\\text{i}} \\\\  & =\\frac{-4\\text{i}-16{\\text{i}}^{2}}{(-1)^{2}-(4\\text{i})^{2}} \\\\  & =\\frac{-4\\text{i}-16(-1)}{1-(-16)} \\\\  & =\\frac{16-4\\text{i}}{17}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\frac{16-4\\text{i}}{17}=(\\frac{16}{17})+(-\\frac{4}{17})\\,\\text{i}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-316853/field-1" "q-316853/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "27da4eb7-48c8-58f4-9676-c88d659f5fbb"] :knowledge-point/questions ["q-316853"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316880/field-1/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "302ea23b-f884-54c1-b1c3-aa1160749532" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-316880/field-1" :answer-field/id #uuid "626e4074-5338-5148-a188-b1b0b8d3f1be" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316880/field-1/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer-field/choices ["q-316880/field-1/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5"] :db/ensure [:answer-field/validate]} {:db/id "q-316880/field-2/3224ab5f6f5fb64621a714f7654c4df06661a69e7edb8f5993dcef1e46ce3dea" :answer/id #uuid "24726a6a-0caa-5292-b26d-92337b47e4ab" :answer/type :answer.type/math :answer/value "-\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "q-316880/field-2" :answer-field/id #uuid "a17b17b1-31a5-5c9e-b222-3bfd8415f123" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316880/field-2/3224ab5f6f5fb64621a714f7654c4df06661a69e7edb8f5993dcef1e46ce3dea" :answer-field/choices ["q-316880/field-2/3224ab5f6f5fb64621a714f7654c4df06661a69e7edb8f5993dcef1e46ce3dea"] :db/ensure [:answer-field/validate]} {:db/id "q-316880" :question/id #uuid "0903e01a-1bb8-59e2-9cb1-4757419bf79a" :question/math-academy-id "q-316880" :question/problem "Evaluate the expression below, expressing your answer in the form $a+b\\text{i},$ where $a$ and $b$ are real numbers.\n\n$\\frac{3+2\\text{i}}{4\\text{i}}=($\n{{field-1}} \n$)\\,+\\,($\n{{field-2}}\n$)\\,\\text{i}$" :question/worked-solution "Here, the denominator is the imaginary number $4\\text{i}.$ Note that this can be written as $0+4\\text{i},$ so the conjugate is $0-4\\text{i},$ or simply $-4\\text{i}.$\n\nSo, we multiply both the numerator and the denominator by $-4\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{3+2\\text{i}}{4\\text{i}} & =\\frac{3+2\\text{i}}{4\\text{i}}\\cdot (\\frac{-4\\text{i}}{-4\\text{i}}) \\\\  & =\\frac{-12\\text{i}-8{\\text{i}}^{2}}{-16{\\text{i}}^{2}} \\\\  & =\\frac{-12\\text{i}-8(-1)}{-16(-1)} \\\\  & =\\frac{8-12\\text{i}}{16}.\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{8-12\\text{i}}{16} & =\\frac{8}{16}-\\frac{12}{16}\\text{i} \\\\  & =(\\frac{1}{2})+(-\\frac{3}{4})\\,\\text{i}\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-316880/field-1" "q-316880/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "730fc9a7-a1b8-55a4-b8d3-666f87b82958"] :knowledge-point/questions ["q-316880"] :db/ensure [:knowledge-point/validate]}]
