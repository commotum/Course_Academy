#{[{:db/id #edb/ref 17592186289681 :knowledge-point/_questions [{:knowledge-point/id #uuid "678ba6cb-b259-5a25-858c-9db161a34ca9" :knowledge-point/title "Dividing a Real Number by a Complex Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe872831-989c-5473-a0f8-75d5ab01b2d2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}+\\text{i}" :db/id #edb/ref 17592186289683} {:answer/id #uuid "809014ed-80e6-5dc4-bab2-00c035d21430" :answer/type {:db/ident :answer.type/math} :answer/value "-1+\\frac{1}{2}\\text{i}" :db/id #edb/ref 17592186289684} {:answer/id #uuid "f7492d90-829b-584f-8cf2-d8227282418c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}-\\text{i}" :db/id #edb/ref 17592186289685} {:answer/id #uuid "a501e753-3733-58cc-9a0d-efe174e90eb8" :answer/type {:db/ident :answer.type/math} :answer/value "-1-\\frac{1}{2}\\text{i}" :db/id #edb/ref 17592186289686} {:answer/id #uuid "b2dcbd05-d7d8-5833-994f-8f616fab98cb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}+\\text{i}" :db/id #edb/ref 17592186289687}] :answer-field/correct {:answer/id #uuid "f7492d90-829b-584f-8cf2-d8227282418c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}-\\text{i}" :db/id #edb/ref 17592186289685} :answer-field/id #uuid "d0be58e1-499a-5ed6-b5c8-bfb3ea378b0e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289682}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d941dd07-47ec-5356-b0e4-b3fa2d7c5f55" :question/math-academy-id "q-16440" :question/problem "$\\frac{5}{-2+4\\text{i}}=$" :question/worked-solution "The denominator is $-2+4\\text{i}$ and its conjugate is $-2-4\\text{i}.$ We multiply both the numerator and the denominator by $-2-4\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{5}{-2+4\\text{i}} & =\\frac{5}{-2+4\\text{i}}\\cdot \\frac{-2-4\\text{i}}{-2-4\\text{i}} \\\\  & =\\frac{-10-20\\text{i}}{4+8\\text{i}-8\\text{i}-16{\\text{i}}^{2}} \\\\  & =\\frac{-10-20\\text{i}}{4-16{\\text{i}}^{2}} \\\\  & =\\frac{-10-20\\text{i}}{4-16(-1)} \\\\  & =\\frac{-10-20\\text{i}}{4+16} \\\\  & =\\frac{-10-20\\text{i}}{20}\\end{aligned}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{-10-20\\text{i}}{20}=-\\frac{10}{20}-\\frac{20}{20}\\text{i}=-\\frac{1}{2}-\\text{i}\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186354533 :knowledge-point/_questions [{:knowledge-point/id #uuid "27da4eb7-48c8-58f4-9676-c88d659f5fbb" :knowledge-point/title "Dividing an Imaginary Number by a Complex Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63482b08-ed9c-542a-bf7a-390d49069a77" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16}{17}" :db/id #edb/ref 17592186354535} {:answer/id #uuid "0abc0ee6-062a-5ed2-bd29-3aa3466ae157" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186354536}] :answer-field/correct {:answer/id #uuid "63482b08-ed9c-542a-bf7a-390d49069a77" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16}{17}" :db/id #edb/ref 17592186354535} :answer-field/id #uuid "3cdcad5b-61bb-511e-a35c-947990dd2e07" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186354534} {:answer-field/choices [{:answer/id #uuid "9e842fb6-339b-59e3-8b4f-e94087a4da03" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{17}" :db/id #edb/ref 17592186354538}] :answer-field/correct {:answer/id #uuid "9e842fb6-339b-59e3-8b4f-e94087a4da03" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{17}" :db/id #edb/ref 17592186354538} :answer-field/id #uuid "6532757c-3046-5eb8-a9b8-c2f2924bb280" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186354537}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f0824f4a-ca8b-50d5-a258-9b2a91d0733a" :question/math-academy-id "q-316853" :question/problem "Evaluate the expression below, expressing your answer in the form $a+b\\text{i},$ where $a$ and $b$ are real numbers.\n\n$\\frac{4\\text{i}}{-1+4\\text{i}}=($\n {{field-1}} \n$)\\,+\\,($\n{{field-2}}\n$)\\,\\text{i}$" :question/worked-solution "The denominator is $-1+4\\text{i}$ and its conjugate is $-1-4\\text{i}.$ We multiply both the numerator and the denominator by $-1-4\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{4\\text{i}}{-1+4\\text{i}} & =\\frac{4\\text{i}}{-1+4\\text{i}}\\cdot \\frac{-1-4\\text{i}}{-1-4\\text{i}} \\\\  & =\\frac{-4\\text{i}-16{\\text{i}}^{2}}{(-1)^{2}-(4\\text{i})^{2}} \\\\  & =\\frac{-4\\text{i}-16(-1)}{1-(-16)} \\\\  & =\\frac{16-4\\text{i}}{17}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\frac{16-4\\text{i}}{17}=(\\frac{16}{17})+(-\\frac{4}{17})\\,\\text{i}\n$$"}] [{:db/id #edb/ref 17592186289688 :knowledge-point/_questions [{:knowledge-point/id #uuid "27da4eb7-48c8-58f4-9676-c88d659f5fbb" :knowledge-point/title "Dividing an Imaginary Number by a Complex Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fe10282-508d-5b3b-9908-a3fbb1809ad2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{12}{13}" :db/id #edb/ref 17592186289690} {:answer/id #uuid "5890c373-95be-51c9-b36a-e328a1eba4d2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{13}" :db/id #edb/ref 17592186289691}] :answer-field/correct {:answer/id #uuid "2fe10282-508d-5b3b-9908-a3fbb1809ad2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{12}{13}" :db/id #edb/ref 17592186289690} :answer-field/id #uuid "acc6a535-454a-5ae0-9bd1-6c9689bc94d5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289689} {:answer-field/choices [{:answer/id #uuid "1d4b58b2-e536-5fbf-b4be-42d31a2e89ea" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{8}{13}" :db/id #edb/ref 17592186289693}] :answer-field/correct {:answer/id #uuid "1d4b58b2-e536-5fbf-b4be-42d31a2e89ea" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{8}{13}" :db/id #edb/ref 17592186289693} :answer-field/id #uuid "9a14e7aa-438b-5c59-9476-9abd225220fe" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289692}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9171a28d-fa2f-567e-a2a1-2aa08147aac0" :question/math-academy-id "q-316855" :question/problem "Evaluate the expression below, expressing your answer in the form $a+b\\text{i},$ where $a$ and $b$ are real numbers.\n\n$\\frac{4\\text{i}}{-2-3\\text{i}}=($ {{field-1}} \n$)\\,+\\,($\n{{field-2}}\n$)\\,\\text{i}$" :question/worked-solution "The denominator is $-2-3\\text{i}$ and its conjugate is $-2+3\\text{i}.$ We multiply both the numerator and the denominator by $-2+3\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{4\\text{i}}{-2-3\\text{i}} & =\\frac{4\\text{i}}{-2-3\\text{i}}\\cdot \\frac{-2+3\\text{i}}{-2+3\\text{i}} \\\\  & =\\frac{-8\\text{i}+12{\\text{i}}^{2}}{(-2)^{2}-(3\\text{i})^{2}} \\\\  & =\\frac{-8\\text{i}+12(-1)}{4-(-9)} \\\\  & =\\frac{-12-8\\text{i}}{13}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\frac{-12-8\\text{i}}{13}=(-\\frac{12}{13})+(-\\frac{8}{13})\\,\\text{i}\n$$"}] [{:db/id #edb/ref 17592186354539 :knowledge-point/_questions [{:knowledge-point/id #uuid "730fc9a7-a1b8-55a4-b8d3-666f87b82958" :knowledge-point/title "Dividing a Complex Number by an Imaginary Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "302ea23b-f884-54c1-b1c3-aa1160749532" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186354541}] :answer-field/correct {:answer/id #uuid "302ea23b-f884-54c1-b1c3-aa1160749532" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186354541} :answer-field/id #uuid "626e4074-5338-5148-a188-b1b0b8d3f1be" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186354540} {:answer-field/choices [{:answer/id #uuid "24726a6a-0caa-5292-b26d-92337b47e4ab" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{4}" :db/id #edb/ref 17592186354543}] :answer-field/correct {:answer/id #uuid "24726a6a-0caa-5292-b26d-92337b47e4ab" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{4}" :db/id #edb/ref 17592186354543} :answer-field/id #uuid "a17b17b1-31a5-5c9e-b222-3bfd8415f123" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186354542}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "0903e01a-1bb8-59e2-9cb1-4757419bf79a" :question/math-academy-id "q-316880" :question/problem "Evaluate the expression below, expressing your answer in the form $a+b\\text{i},$ where $a$ and $b$ are real numbers.\n\n$\\frac{3+2\\text{i}}{4\\text{i}}=($\n{{field-1}} \n$)\\,+\\,($\n{{field-2}}\n$)\\,\\text{i}$" :question/worked-solution "Here, the denominator is the imaginary number $4\\text{i}.$ Note that this can be written as $0+4\\text{i},$ so the conjugate is $0-4\\text{i},$ or simply $-4\\text{i}.$\n\nSo, we multiply both the numerator and the denominator by $-4\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{3+2\\text{i}}{4\\text{i}} & =\\frac{3+2\\text{i}}{4\\text{i}}\\cdot (\\frac{-4\\text{i}}{-4\\text{i}}) \\\\  & =\\frac{-12\\text{i}-8{\\text{i}}^{2}}{-16{\\text{i}}^{2}} \\\\  & =\\frac{-12\\text{i}-8(-1)}{-16(-1)} \\\\  & =\\frac{8-12\\text{i}}{16}.\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{8-12\\text{i}}{16} & =\\frac{8}{16}-\\frac{12}{16}\\text{i} \\\\  & =(\\frac{1}{2})+(-\\frac{3}{4})\\,\\text{i}\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186060217 :knowledge-point/_questions [{:knowledge-point/id #uuid "678ba6cb-b259-5a25-858c-9db161a34ca9" :knowledge-point/title "Dividing a Real Number by a Complex Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95fe4c74-f943-5b6b-83aa-f14d5d2ae8e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{13}-\\frac{2}{13}\\text{i}" :db/id #edb/ref 17592186354545} {:answer/id #uuid "935e1409-f133-55ee-aa39-c1bf86f930bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{13}-\\frac{6}{13}\\text{i}" :db/id #edb/ref 17592186354546} {:answer/id #uuid "f7829d50-c4ef-5b70-81e4-be00b869e2d0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{13}-\\frac{2}{13}\\text{i}" :db/id #edb/ref 17592186354547} {:answer/id #uuid "7e3fb58d-dc73-5ec4-bb49-9105f69864e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{13}+\\frac{2}{13}\\text{i}" :db/id #edb/ref 17592186354548} {:answer/id #uuid "0e044227-f4f5-5711-bb99-b53748f32eda" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}-\\text{i}" :db/id #edb/ref 17592186354549}] :answer-field/correct {:answer/id #uuid "935e1409-f133-55ee-aa39-c1bf86f930bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{13}-\\frac{6}{13}\\text{i}" :db/id #edb/ref 17592186354546} :answer-field/id #uuid "68443228-0054-545f-a12f-1ebda9170e54" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354544}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "76a11de3-1480-5d9e-bbfd-ca87ec0904d1" :question/math-academy-id "q-541" :question/problem "$\\frac{3}{3+2\\text{i}}=$" :question/worked-solution "The denominator is $3+2\\text{i}$ and its conjugate is $3-2\\text{i}.$ We multiply both the numerator and the denominator by $3-2\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{3}{3+2\\text{i}} & =\\frac{3}{3+2\\text{i}}\\cdot \\frac{3-2\\text{i}}{3-2\\text{i}} \\\\  & =\\frac{9-6\\text{i}}{9-6\\text{i}+6\\text{i}-4{\\text{i}}^{2}} \\\\  & =\\frac{9-6\\text{i}}{9-4{\\text{i}}^{2}} \\\\  & =\\frac{9-6\\text{i}}{9-(4)(-1)} \\\\  & =\\frac{9-6\\text{i}}{9+4} \\\\  & =\\frac{9-6\\text{i}}{13}\\end{aligned}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{9-6\\text{i}}{13}=\\frac{9}{13}-\\frac{6}{13}\\text{i}\\end{aligned}\\end{aligned}\n$$"}]}
