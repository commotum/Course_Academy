nt :answer.type/math} :answer/value "T:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}x-z \\\\ x+y \\\\ y-z\\end{aligned}]" :db/id #edb/ref 17592186287581} {:answer/id #uuid "3179d5bf-a4c8-50f6-8c7b-8236129641a6" :answer/type {:db/ident :answer.type/math} :answer/value "T:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}x+z \\\\ -y+z \\\\ x-y\\end{aligned}]" :db/id #edb/ref 17592186287582} {:answer/id #uuid "2432f9e6-3b05-5b6c-9519-17ccf008e834" :answer/type {:db/ident :answer.type/math} :answer/value "T:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}x+z \\\\ x+y \\\\ y-z\\end{aligned}]" :db/id #edb/ref 17592186287583} {:answer/id #uuid "97c43184-bd7f-5195-8046-b27c8a4181f8" :answer/type {:db/ident :answer.type/math} :answer/value "T:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}x+z \\\\ -y-z \\\\ x+y\\end{aligned}]" :db/id #edb/ref 17592186287584} {:answer/id #uuid "3a3aa29a-9dcb-5c7d-8b40-5d0c4b6c7919" :answer/type {:db/ident :answer.type/math} :answer/value "T:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}x-z \\\\ -y-z \\\\ x+y\\end{aligned}]" :db/id #edb/ref 17592186287585}] :answer-field/correct {:answer/id #uuid "3179d5bf-a4c8-50f6-8c7b-8236129641a6" :answer/type {:db/ident :answer.type/math} :answer/value "T:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}x+z \\\\ -y+z \\\\ x-y\\end{aligned}]" :db/id #edb/ref 17592186287582} :answer-field/id #uuid "d8c1a1f5-5179-5f0a-9f82-f962aa64a33a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287580}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "4b3d954a-970e-5df9-84d3-b38ba96cad0e" :question/math-academy-id "q-168105" :question/problem "What is the linear transformation $T$ whose standard matrix is \n$T=[\\begin{aligned}1 & 0 & 1 \\\\ 0 & -1 & 1 \\\\ 1 & -1 & 0\\end{aligned}]?$" :question/worked-solution "Consider a general vector $\\,[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}].$ Multiplying by the matrix $T,$ we have\n\n$$\n\\begin{aligned}T\\cdot [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}1 & 0 & 1 \\\\ 0 & -1 & 1 \\\\ 1 & -1 & 0\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] \\\\  & =[\\begin{aligned}x+z \\\\ -y+z \\\\ x-y\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the linear transformation $\\,T\\,$ is given by\n\n$$\nT:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}x+z \\\\ -y+z \\\\ x-y\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186279955 :knowledge-point/_questions [{:knowledge-point/id #uuid "656da168-af12-53c2-8add-2c82cf71b31c" :knowledge-point/title "Determining a Linear Transformation Given its Standard Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c145210f-9618-55d9-8d67-bd6def47407a" :answer/type {:db/ident :answer.type/math} :answer/value "5y" :db/id #edb/ref 17592186279957}] :answer-field/correct {:answer/id #uuid "c145210f-9618-55d9-8d67-bd6def47407a" :answer/type {:db/ident :answer.type/math} :answer/value "5y" :db/id #edb/ref 17592186279957} :answer-field/id #uuid "21cb0da3-8f45-5813-a936-c8c539f7d8cd" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186279956} {:answer-field/choices [{:answer/id #uuid "147c33f5-35d3-5774-862b-6d2a535cece7" :answer/type {:db/ident :answer.type/math} :answer/value "-2x+7y" :db/id #edb/ref 17592186279959}] :answer-field/correct {:answer/id #uuid "147c33f5-35d3-5774-862b-6d2a535cece7" :answer/type {:db/ident :answer.type/math} :answer/value "-2x+7y" :db/id #edb/ref 17592186279959} :answer-field/id #uuid "c3804b6d-08a8-5810-bf26-caaee05d1eb2" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186279958}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7a0734cd-c859-54b2-bb43-6818e5dd483f" :question/math-academy-id "q-317038" :question/problem "What is the linear transformation $T$ whose standard matrix is $T=[\\begin{aligned}0 & 5 \\\\ -2 & 7\\end{aligned}]?$\n\n  \n\n| $T:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |" :question/worked-solution "Consider a general vector $\\,[\\begin{aligned}x \\\\ y\\end{aligned}].$ Multiplying by the matrix $T,$ we have\n\n$$\n\\begin{aligned}T\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}0 & 5 \\\\ -2 & 7\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}] \\\\  & =[\\begin{aligned}5y \\\\ -2x+7y\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the linear transformation $\\,T\\,$ is given by\n\n$$\nT:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}5y \\\\ -2x+7y\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186287609 :knowledge-point/_questions [{:knowledge-point/id #uuid "b2776554-94ce-5c25-b838-16fdfceddb1c" :knowledge-point/title "Identifying the Standard Matrix of a Linear Transformation With Rearranging"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bcb2e8ff-3121-5196-92e6-d918492b6934" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186287611}] :answer-field/correct {:answer/id #uuid "bcb2e8ff-3121-5196-92e6-d918492b6934" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186287611} :answer-field/id #uuid "35b4a8d7-1363-5534-b201-82e94429f588" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287610} {:answer-field/choices [{:answer/id #uuid "ea573bc7-d465-55d7-ad7a-1617138d218f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186287613}] :answer-field/correct {:answer/id #uuid "ea573bc7-d465-55d7-ad7a-1617138d218f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186287613} :answer-field/id #uuid "5bb16bc3-2efd-5f17-8da0-ce52fa6d81cd" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287612} {:answer-field/choices [{:answer/id #uuid "fe0f845f-ffa3-5015-aec7-5498cbc6b462" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186287615}] :answer-field/correct {:answer/id #uuid "fe0f845f-ffa3-5015-aec7-5498cbc6b462" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186287615} :answer-field/id #uuid "5b4d98af-565c-5dd9-b636-823006d646f3" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287614} {:answer-field/choices [{:answer/id #uuid "555d6b70-7f20-5fb3-8403-90a66073285f" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186287617}] :answer-field/correct {:answer/id #uuid "555d6b70-7f20-5fb3-8403-90a66073285f" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186287617} :answer-field/id #uuid "258b6df0-7357-5812-b3c8-874cafe1e994" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287616}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b6af6fab-87f4-501e-a8f1-9837b9d39287" :question/math-academy-id "q-317069" :question/problem "Find the standard matrix that represents  the  linear  transformation $T$, where\n\n$$\nT:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}-6x \\\\ 5y+9x\\end{aligned}].\n$$\n\n| $T=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |" :question/worked-solution "First, rewrite the order of the variables in the usual way:\n\n$$\nT:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}-6x \\\\ 9x+5y\\end{aligned}]\n$$\n\nWe require a $2\\times 2$ matrix $T$ such that\n    \n\n$$\nT\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-6x \\\\ 9x+5y\\end{aligned}].\n$$\n\nNotice that\n    \n\n$$\n[\\begin{aligned}-6 & 0 \\\\ 9 & 5\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-6x \\\\ 9x+5y\\end{aligned}].\n$$\n\n    Therefore, the matrix which represents the linear transformation $T$ is\n    \n\n$$\n[\\begin{aligned}-6 & 0 \\\\ 9 & 5\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186125027 :knowledge-point/_questions [{:knowledge-point/id #uuid "dd0537f8-b091-580a-974e-8e928d54939d" :knowledge-point/title "Finding the Image of a Vector Under a Linear Transformation Given its Standard Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "863a0b0c-4d85-58df-b416-cd5d6ec9fd70" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 3 \\\\ 12\\end{bmatrix}" :db/id #edb/ref 17592186123185} {:answer/id #uuid "b3cacdbc-5429-57d2-9e5f-b2ec6d40455a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}16 \\\\ 3 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186123186} {:answer/id #uuid "fcd1e744-184d-5af9-96c1-2b2e70c46b9c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 12 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186123187} {:answer/id #uuid "5f6c978f-3dc5-54e6-9361-6a4316c216b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}12 \\\\ 6 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186123188} {:answer/id #uuid "6bba33f4-e59f-5d92-aad2-e34a964b0415" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 4 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186123189}] :answer-field/correct {:answer/id #uuid "b3cacdbc-5429-57d2-9e5f-b2ec6d40455a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}16 \\\\ 3 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186123186} :answer-field/id #uuid "a5bbe309-e330-51ba-9760-7194eff2ef38" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123184}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "12f3bb3a-f83c-5bc7-89c6-1af5031ec24d" :question/math-academy-id "q-37881" :question/problem "Consider the matrix $T$ and the vector $v$ given below. If $T$ is the standard matrix of the linear transformation $T,$ find $T(v).$\n\n$$\nT=[\\begin{aligned}-2 & 4 & -1 \\\\ 5 & 1 & 3 \\\\ -1 & 3 & 4\\end{aligned}],\\,v=[\\begin{aligned}1 \\\\ 4 \\\\ -2\\end{aligned}]\n$$" :question/worked-solution "Using the fact that $\\,T(v)=T\\cdot v,$ we get\n\n$$\n\\begin{aligned}T(v) & =T\\cdot v \\\\  & =[\\begin{aligned}-2 & 4 & -1 \\\\ 5 & 1 & 3 \\\\ -1 & 3 & 4\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ 4 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}16 \\\\ 3 \\\\ 3\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186125030 :knowledge-point/_questions [{:knowledge-point/id #uuid "656da168-af12-53c2-8add-2c82cf71b31c" :knowledge-point/title "Determining a Linear Transformation Given its Standard Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b04f5bea-df52-546d-907d-e8f74136a8e3" :answer/type {:db/ident :answer.type/math} :answer/value "T: \\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}-4x + y \\\\ x + 2y\\end{bmatrix}" :db/id #edb/ref 17592186123203} {:answer/id #uuid "e5c237d4-e958-595e-b67a-45a6dfd0058a" :answer/type {:db/ident :answer.type/math} :answer/value "T: \\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}-8x + 4y \\\\ -3x + 2y\\end{bmatrix}" :db/id #edb/ref 17592186123204} {:answer/id #uuid "f201e6b9-61d0-591b-8205-20b20d0467f3" :answer/type {:db/ident :answer.type/math} :answer/value "T: \\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}4x - 8y \\\\ 3x - 2y\\end{bmatrix}" :db/id #edb/ref 17592186123205} {:answer/id #uuid "0ad41a92-d865-5ee1-9