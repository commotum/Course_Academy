\\\\ 3 & -1 & 1 \\\\ -2 & 3 & -1\\end{aligned}]" :db/id #edb/ref 17592186280033} {:answer/id #uuid "20c0c215-6da8-556c-a5df-acb2d9d99207" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 & -5 \\\\ 1 & -1 & 3 \\\\ -2 & 3 & -1\\end{aligned}]" :db/id #edb/ref 17592186280034} {:answer/id #uuid "bd48e46b-231b-5fdd-b920-223cf326b2ee" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 & -5 \\\\ 3 & -1 & 1 \\\\ -2 & 3 & -1\\end{aligned}]" :db/id #edb/ref 17592186280035}] :answer-field/correct {:answer/id #uuid "bd48e46b-231b-5fdd-b920-223cf326b2ee" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 & -5 \\\\ 3 & -1 & 1 \\\\ -2 & 3 & -1\\end{aligned}]" :db/id #edb/ref 17592186280035} :answer-field/id #uuid "2f1c1220-b501-550d-b027-49a87b60f60e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280030}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "b9c4fe27-fb6e-5544-9585-41aed92d912c" :question/math-academy-id "q-74944" :question/problem "Find the standard matrix that represents  the  linear  transformation $T$, where\n\n$$\nT:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}2y-5z+x \\\\ z-y+3x \\\\ -z-2x+3y\\end{aligned}].\n$$" :question/worked-solution "First, rewrite the order of the variables in the usual way:\n\n$$\nT:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}x+2y-5z \\\\ 3x-y+z \\\\ -2x+3y-z\\end{aligned}]\n$$\n\nWe require a $3\\times 3$ matrix $T$ such that\n\n$$\nT\\cdot [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}x+2y-5z \\\\ 3x-y+z \\\\ -2x+3y-z\\end{aligned}].\n$$\n\nNotice that\n\n$$\n[\\begin{aligned}1 & 2 & -5 \\\\ 3 & -1 & 1 \\\\ -2 & 3 & -1\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}x+2y-5z \\\\ 3x-y+z \\\\ -2x+3y-z\\end{aligned}].\n$$\n\nTherefore, the matrix which represents the linear transformation $T$ is\n\n$$\n[\\begin{aligned}1 & 2 & -5 \\\\ 3 & -1 & 1 \\\\ -2 & 3 & -1\\end{aligned}].\n$$"}]}
