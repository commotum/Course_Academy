ld.type/blank :answer-field/correct "q-275661/field-4/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-275661/field-4/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-275661" :question/id #uuid "74a3cd4d-9215-5d06-bd68-798666c6d028" :question/math-academy-id "q-275661" :question/problem "Find the standard matrix that represents  the  linear  transformation $T$, where\n\n$$\nT:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}9y-3x \\\\ 6x+y\\end{aligned}].\n$$\n\n| $T=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |" :question/worked-solution "First, rewrite the order of the variables in the usual way:\n\n$$\nT:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}-3x+9y \\\\ 6x+y\\end{aligned}]\n$$\n\nWe require a $2\\times 2$ matrix $T$ such that\n    \n\n$$\nT\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-3x+9y \\\\ 6x+y\\end{aligned}].\n$$\n\nNotice that\n    \n\n$$\n[\\begin{aligned}-3 & 9 \\\\ 6 & 1\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-3x+9y \\\\ 6x+y\\end{aligned}].\n$$\n\n    Therefore, the matrix which represents the linear transformation $T$ is\n    \n\n$$\n[\\begin{aligned}-3 & 9 \\\\ 6 & 1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-275661/field-1" "q-275661/field-2" "q-275661/field-3" "q-275661/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b2776554-94ce-5c25-b838-16fdfceddb1c"] :knowledge-point/questions ["q-275661"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74941/selection/5f7a95057d6d13460e86c9534165efd0e9d8b73ccfd91b9bd6885b969c15fa4c" :answer/id #uuid "625498ac-13fe-5c82-a219-b11a6574645b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 \\\\ -1 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-74941/selection/8dca059f5946a2c09103189e0e5d855af024189058a5bcbbb0733fe84648895d" :answer/id #uuid "2aa5d09a-a269-5417-8f4c-2011dfa7c921" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 & 1 \\\\ 1 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-74941/selection/d66e32c0c38dff35ebf92256da1968b40fdc5958df18ea8974b942f7a938a70a" :answer/id #uuid "cedf16e9-f5f8-5511-b962-cbe434104651" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 & 3 \\\\ -1 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-74941/selection/bfd65140e53a6f2fde4fcd2fcadf687663b7701a3baebd4899d8bd615917f0e8" :answer/id #uuid "2458d995-d090-55bb-b165-fa3012b60c56" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 \\\\ 1 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-74941/selection/d25ae292cfef236efb8038f9f5c5d5a98076b788a8e8b2953e6ae3cdaf6905bc" :answer/id #uuid "f292bd4d-56df-5c2b-8506-f36d4c3ffb57" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 & 1 \\\\ 1 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-74941/selection" :answer-field/id #uuid "6afa9463-6564-5a98-8773-b466467a6406" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74941/selection/5f7a95057d6d13460e86c9534165efd0e9d8b73ccfd91b9bd6885b969c15fa4c" :answer-field/choices ["q-74941/selection/5f7a95057d6d13460e86c9534165efd0e9d8b73ccfd91b9bd6885b969c15fa4c" "q-74941/selection/8dca059f5946a2c09103189e0e5d855af024189058a5bcbbb0733fe84648895d" "q-74941/selection/d66e32c0c38dff35ebf92256da1968b40fdc5958df18ea8974b942f7a938a70a" "q-74941/selection/bfd65140e53a6f2fde4fcd2fcadf687663b7701a3baebd4899d8bd615917f0e8" "q-74941/selection/d25ae292cfef236efb8038f9f5c5d5a98076b788a8e8b2953e6ae3cdaf6905bc"] :db/ensure [:answer-field/validate]} {:db/id "q-74941" :question/id #uuid "5f75e215-98a8-56cb-b6d1-346274712c51" :question/math-academy-id "q-74941" :question/problem "Find the standard matrix that represents  the  linear  transformation $T$, where\n\n$$\nT:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}3y+x \\\\ y-x\\end{aligned}].\n$$" :question/worked-solution "First, rewrite the order of the variables in the usual way:\n\n$$\nT:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}x+3y \\\\ -x+y\\end{aligned}]\n$$\n\nWe require a $2\\times 2$ matrix $T$ such that\n    \n\n$$\nT\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}x+3y \\\\ -x+y\\end{aligned}].\n$$\n\nNotice that\n    \n\n$$\n[\\begin{aligned}1 & 3 \\\\ -1 & 1\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}x+3y \\\\ -x+y\\end{aligned}].\n$$\n\nTherefore, the matrix which represents the linear transformation $T$ is\n    \n\n$$\n[\\begin{aligned}1 & 3 \\\\ -1 & 1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-74941/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b2776554-94ce-5c25-b838-16fdfceddb1c"] :knowledge-point/questions ["q-74941"] :db/ensure [:knowledge-point/validate]} {:db/id "q-317066/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "d9ccd936-6606-5adc-80d3-7e65fae42f3b" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-317066/field-1" :answer-field/id #uuid "46ced93a-5024-56b0-b2de-5b406f997613" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317066/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer-field/choices ["q-317066/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe"] :db/ensure [:answer-field/validate]} {:db/id "q-317066/field-2/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "4f4281c6-84e6-56da-a5fd-1d5289415c1a" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answe