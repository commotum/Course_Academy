7 & 2\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] \\\\  & =[\\begin{aligned}8x-2y-3z \\\\ -4x+9y+6z \\\\ 5x-7y+2z\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the linear transformation $\\,T\\,$ is given by\n\n$$\nT:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}8x-2y-3z \\\\ -4x+9y+6z \\\\ 5x-7y+2z\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186327463 :knowledge-point/_questions [{:knowledge-point/id #uuid "dd0537f8-b091-580a-974e-8e928d54939d" :knowledge-point/title "Finding the Image of a Vector Under a Linear Transformation Given its Standard Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "779ff3cc-0c89-5d71-8db2-e5ab6a59661b" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186327465} {:answer/id #uuid "46b98eb8-2503-547a-ac1a-8d578610b195" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186327466}] :answer-field/correct {:answer/id #uuid "779ff3cc-0c89-5d71-8db2-e5ab6a59661b" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186327465} :answer-field/id #uuid "76ce195f-757a-5cc1-8b4c-66e274f57564" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186327464} {:answer-field/choices [{:answer/id #uuid "1d437c12-5a22-5449-9c54-97d4c7db34db" :answer/type {:db/ident :answer.type/math} :answer/value "-19" :db/id #edb/ref 17592186327468}] :answer-field/correct {:answer/id #uuid "1d437c12-5a22-5449-9c54-97d4c7db34db" :answer/type {:db/ident :answer.type/math} :answer/value "-19" :db/id #edb/ref 17592186327468} :answer-field/id #uuid "b152cb29-5c31-552a-bf11-cadfafcd0a3a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186327467}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b1f58a84-f3b4-5858-bf68-570cb753c22e" :question