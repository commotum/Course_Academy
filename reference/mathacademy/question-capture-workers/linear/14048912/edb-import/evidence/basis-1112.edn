#{[{:db/id #edb/ref 17592186287579 :knowledge-point/_questions [{:knowledge-point/id #uuid "656da168-af12-53c2-8add-2c82cf71b31c" :knowledge-point/title "Determining a Linear Transformation Given its Standard Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c04f336-f728-53c1-b142-201c4cc187de" :answer/type {:db/ident :answer.type/math} :answer/value "T:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}x-z \\\\ x+y \\\\ y-z\\end{aligned}]" :db/id #edb/ref 17592186287581} {:answer/id #uuid "3179d5bf-a4c8-50f6-8c7b-8236129641a6" :answer/type {:db/ident :answer.type/math} :answer/value "T:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}x+z \\\\ -y+z \\\\ x-y\\end{aligned}]" :db/id #edb/ref 17592186287582} {:answer/id #uuid "2432f9e6-3b05-5b6c-9519-17ccf008e834" :answer/type {:db/ident :answer.type/math} :answer/value "T:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}x+z \\\\ x+y \\\\ y-z\\end{aligned}]" :db/id #edb/ref 17592186287583} {:answer/id #uuid "97c43184-bd7f-5195-8046-b27c8a4181f8" :answer/type {:db/ident :answer.type/math} :answer/value "T:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}x+z \\\\ -y-z \\\\ x+y\\end{aligned}]" :db/id #edb/ref 17592186287584} {:answer/id #uuid "3a3aa29a-9dcb-5c7d-8b40-5d0c4b6c7919" :answer/type {:db/ident :answer.type/math} :answer/value "T:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}x-z \\\\ -y-z \\\\ x+y\\end{aligned}]" :db/id #edb/ref 17592186287585}] :answer-field/correct {:answer/id #uuid "3179d5bf-a4c8-50f6-8c7b-8236129641a6" :answer/type {:db/ident :answer.type/math} :answer/value "T:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}x+z \\\\ -y+z \\\\ x-y\\end{aligned}]" :db/id #edb/ref 17592186287582} :answer-field/id #uuid "d8c1a1f5-5179-5f0a-9f82-f962aa64a33a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287580}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "4b3d954a-970e-5df9-84d3-b38ba96cad0e" :question/math-academy-id "q-168105" :question/problem "What is the linear transformation $T$ whose standard matrix is \n$T=[\\begin{aligned}1 & 0 & 1 \\\\ 0 & -1 & 1 \\\\ 1 & -1 & 0\\end{aligned}]?$" :question/worked-solution "Consider a general vector $\\,[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}].$ Multiplying by the matrix $T,$ we have\n\n$$\n\\begin{aligned}T\\cdot [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}1 & 0 & 1 \\\\ 0 & -1 & 1 \\\\ 1 & -1 & 0\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] \\\\  & =[\\begin{aligned}x+z \\\\ -y+z \\\\ x-y\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the linear transformation $\\,T\\,$ is given by\n\n$$\nT:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}x+z \\\\ -y+z \\\\ x-y\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186287609 :knowledge-point/_questions [{:knowledge-point/id #uuid "b2776554-94ce-5c25-b838-16fdfceddb1c" :knowledge-point/title "Identifying the Standard Matrix of a Linear Transformation With Rearranging"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bcb2e8ff-3121-5196-92e6-d918492b6934" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186287611}] :answer-field/correct {:answer/id #uuid "bcb2e8ff-3121-5196-92e6-d918492b6934" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186287611} :answer-field/id #uuid "35b4a8d7-1363-5534-b201-82e94429f588" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287610} {:answer-field/choices [{:answer/id #uuid "ea573bc7-d465-55d7-ad7a-1617138d218f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186287613}] :answer-field/correct {:answer/id #uuid "ea573bc7-d465-55d7-ad7a-1617138d218f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186287613} :answer-field/id #uuid "5bb16bc3-2efd-5f17-8da0-ce52fa6d81cd" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287612} {:answer-field/choices [{:answer/id #uuid "fe0f845f-ffa3-5015-aec7-5498cbc6b462" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186287615}] :answer-field/correct {:answer/id #uuid "fe0f845f-ffa3-5015-aec7-5498cbc6b462" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186287615} :answer-field/id #uuid "5b4d98af-565c-5dd9-b636-823006d646f3" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287614} {:answer-field/choices [{:answer/id #uuid "555d6b70-7f20-5fb3-8403-90a66073285f" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186287617}] :answer-field/correct {:answer/id #uuid "555d6b70-7f20-5fb3-8403-90a66073285f" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186287617} :answer-field/id #uuid "258b6df0-7357-5812-b3c8-874cafe1e994" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287616}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b6af6fab-87f4-501e-a8f1-9837b9d39287" :question/math-academy-id "q-317069" :question/problem "Find the standard matrix that represents  the  linear  transformation $T$, where\n\n$$\nT:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}-6x \\\\ 5y+9x\\end{aligned}].\n$$\n\n| $T=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |" :question/worked-solution "First, rewrite the order of the variables in the usual way:\n\n$$\nT:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}-6x \\\\ 9x+5y\\end{aligned}]\n$$\n\nWe require a $2\\times 2$ matrix $T$ such that\n    \n\n$$\nT\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-6x \\\\ 9x+5y\\end{aligned}].\n$$\n\nNotice that\n    \n\n$$\n[\\begin{aligned}-6 & 0 \\\\ 9 & 5\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-6x \\\\ 9x+5y\\end{aligned}].\n$$\n\n    Therefore, the matrix which represents the linear transformation $T$ is\n    \n\n$$\n[\\begin{aligned}-6 & 0 \\\\ 9 & 5\\end{aligned}].\n$$"}]}
