#{[{:db/id #edb/ref 17592186124239 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "e73b8bcf-79c2-5326-b396-d7d3e06badaa" :knowledge-point/title "Identifying the Standard Matrix of a Linear Transformation"}] :question/id #uuid "6aed23e0-cd3e-5940-a722-63550bcefc97" :question/math-academy-id "e-5431" :question/problem "Find the standard matrix that represents  the  linear  transformation $\\mathbf{T},$ where\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]\n$$" :question/worked-solution "We require a $2\\times 2$ matrix ${T}$ such that\n    \n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]\n$$\n\n    Notice that\n    \n\n$$\n[\\begin{aligned}1 & 3 \\\\ 2 & -1\\end{aligned}]\n$$\n\nTherefore, the matrix which represents the linear transformation $\\mathbf{T}$ is\n    \n\n$$\n[\\begin{aligned}1 & 3 \\\\ 2 & -1\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186124240 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "b2776554-94ce-5c25-b838-16fdfceddb1c" :knowledge-point/title "Identifying the Standard Matrix of a Linear Transformation With Rearranging"}] :question/id #uuid "521cc49e-dddb-5add-b619-18e2785049f8" :question/math-academy-id "e-5432" :question/problem "Find the standard matrix that represents  the  linear  transformation $\\mathbf{T},$ where\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]\n$$" :question/worked-solution "First, rewrite the order of the variables in the usual way:\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]\n$$\n\nWe require a $2\\times 2$ matrix ${T}$ such that\n    \n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]\n$$\n\nNotice that\n    \n\n$$\n[\\begin{aligned}-5 & 4 \\\\ 3 & 1\\end{aligned}]\n$$\n\nTherefore, the matrix which represents the linear transformation $\\mathbf{T}$ is\n    \n\n$$\n[\\begin{aligned}-5 & 4 \\\\ 3 & 1\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186124241 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "656da168-af12-53c2-8add-2c82cf71b31c" :knowledge-point/title "Determining a Linear Transformation Given its Standard Matrix"}] :question/id #uuid "77bd52ee-454e-5794-83e5-991e7e4c13b5" :question/math-academy-id "e-5433" :question/problem "What is the linear transformation $\\mathbf{T}$ whose standard matrix is $[\\begin{aligned}8 & -1 \\\\ -5 & -2\\end{aligned}]$" :question/worked-solution "Consider a general vector $[\\begin{aligned}x \\\\ y\\end{aligned}]$ Multiplying by the matrix $T,$ we have\n\n$$\n\\begin{aligned}T\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}8 & -1 \\\\ -5 & -2\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}] \\\\  & =[\\begin{aligned}8x-y \\\\ -5x-2y\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the linear transformation $\\,\\mathbf{T}\\,$ is given by\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186124242 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "dd0537f8-b091-580a-974e-8e928d54939d" :knowledge-point/title "Finding the Image of a Vector Under a Linear Transformation Given its Standard Matrix"}] :question/id #uuid "9c8d9615-6a5d-5b6a-8735-b9b2f58331f1" :question/math-academy-id "e-5434" :question/problem "Consider the matrix $T$ and the vector $\\mathbf{v}$ given below. If $T$ is the standard matrix of the linear transformation $\\mathbf{T},$ find $\\mathbf{T}(\\mathbf{v}).$\n\n$$\n[\\begin{aligned}4 & 7 \\\\ -6 & -2\\end{aligned}]\n$$" :question/worked-solution "Using the fact that $\\,\\mathbf{T}(\\mathbf{v})=T\\cdot \\mathbf{v},$ we get\n\n$$\n\\begin{aligned}T(v) & =T\\cdot v \\\\  & =[\\begin{aligned}4 & 7 \\\\ -6 & -2\\end{aligned}]\\cdot [\\begin{aligned}-2 \\\\ 5\\end{aligned}] \\\\  & =[\\begin{aligned}27 \\\\ 2\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186279955 :knowledge-point/_questions [{:knowledge-point/id #uuid "656da168-af12-53c2-8add-2c82cf71b31c" :knowledge-point/title "Determining a Linear Transformation Given its Standard Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c145210f-9618-55d9-8d67-bd6def47407a" :answer/type {:db/ident :answer.type/math} :answer/value "5y" :db/id #edb/ref 17592186279957}] :answer-field/correct {:answer/id #uuid "c145210f-9618-55d9-8d67-bd6def47407a" :answer/type {:db/ident :answer.type/math} :answer/value "5y" :db/id #edb/ref 17592186279957} :answer-field/id #uuid "21cb0da3-8f45-5813-a936-c8c539f7d8cd" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186279956} {:answer-field/choices [{:answer/id #uuid "147c33f5-35d3-5774-862b-6d2a535cece7" :answer/type {:db/ident :answer.type/math} :answer/value "-2x+7y" :db/id #edb/ref 17592186279959}] :answer-field/correct {:answer/id #uuid "147c33f5-35d3-5774-862b-6d2a535cece7" :answer/type {:db/ident :answer.type/math} :answer/value "-2x+7y" :db/id #edb/ref 17592186279959} :answer-field/id #uuid "c3804b6d-08a8-5810-bf26-caaee05d1eb2" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186279958}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7a0734cd-c859-54b2-bb43-6818e5dd483f" :question/math-academy-id "q-317038" :question/problem "What is the linear transformation $T$ whose standard matrix is $T=[\\begin{aligned}0 & 5 \\\\ -2 & 7\\end{aligned}]?$\n\n  \n\n| $T:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |" :question/worked-solution "Consider a general vector $\\,[\\begin{aligned}x \\\\ y\\end{aligned}].$ Multiplying by the matrix $T,$ we have\n\n$$\n\\begin{aligned}T\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}0 & 5 \\\\ -2 & 7\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}] \\\\  & =[\\begin{aligned}5y \\\\ -2x+7y\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the linear transformation $\\,T\\,$ is given by\n\n$$\nT:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}5y \\\\ -2x+7y\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186125027 :knowledge-point/_questions [{:knowledge-point/id #uuid "dd0537f8-b091-580a-974e-8e928d54939d" :knowledge-point/title "Finding the Image of a Vector Under a Linear Transformation Given its Standard Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "863a0b0c-4d85-58df-b416-cd5d6ec9fd70" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 3 \\\\ 12\\end{bmatrix}" :db/id #edb/ref 17592186123185} {:answer/id #uuid "b3cacdbc-5429-57d2-9e5f-b2ec6d40455a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}16 \\\\ 3 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186123186} {:answer/id #uuid "fcd1e744-184d-5af9-96c1-2b2e70c46b9c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 12 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186123187} {:answer/id #uuid "5f6c978f-3dc5-54e6-9361-6a4316c216b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}12 \\\\ 6 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186123188} {:answer/id #uuid "6bba33f4-e59f-5d92-aad2-e34a964b0415" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 4 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186123189}] :answer-field/correct {:answer/id #uuid "b3cacdbc-5429-57d2-9e5f-b2ec6d40455a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}16 \\\\ 3 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186123186} :answer-field/id #uuid "a5bbe309-e330-51ba-9760-7194eff2ef38" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123184}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "12f3bb3a-f83c-5bc7-89c6-1af5031ec24d" :question/math-academy-id "q-37881" :question/problem "Consider the matrix $T$ and the vector $v$ given below. If $T$ is the standard matrix of the linear transformation $T,$ find $T(v).$\n\n$$\nT=[\\begin{aligned}-2 & 4 & -1 \\\\ 5 & 1 & 3 \\\\ -1 & 3 & 4\\end{aligned}],\\,v=[\\begin{aligned}1 \\\\ 4 \\\\ -2\\end{aligned}]\n$$" :question/worked-solution "Using the fact that $\\,T(v)=T\\cdot v,$ we get\n\n$$\n\\begin{aligned}T(v) & =T\\cdot v \\\\  & =[\\begin{aligned}-2 & 4 & -1 \\\\ 5 & 1 & 3 \\\\ -1 & 3 & 4\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ 4 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}16 \\\\ 3 \\\\ 3\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186280029 :knowledge-point/_questions [{:knowledge-point/id #uuid "b2776554-94ce-5c25-b838-16fdfceddb1c" :knowledge-point/title "Identifying the Standard Matrix of a Linear Transformation With Rearranging"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bfa1bee-f474-5612-8af9-a7a21c8f37b6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -5 & 1 \\\\ 1 & -1 & 1 \\\\ -1 & -2 & 3\\end{aligned}]" :db/id #edb/ref 17592186280031} {:answer/id #uuid "fdb7cd95-4329-5840-9f18-8c037422f4ea" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 & -5 \\\\ 3 & -1 & 1 \\\\ -1 & -2 & 3\\end{aligned}]" :db/id #edb/ref 17592186280032} {:answer/id #uuid "c6b9a623-668b-548a-a88b-66a166acaf21" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -5 & 1 \\\\ 3 & -1 & 1 \\\\ -2 & 3 & -1\\end{aligned}]" :db/id #edb/ref 17592186280033} {:answer/id #uuid "20c0c215-6da8-556c-a5df-acb2d9d99207" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 & -5 \\\\ 1 & -1 & 3 \\\\ -2 & 3 & -1\\end{aligned}]" :db/id #edb/ref 17592186280034} {:answer/id #uuid "bd48e46b-231b-5fdd-b920-223cf326b2ee" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 & -5 \\\\ 3 & -1 & 1 \\\\ -2 & 3 & -1\\end{aligned}]" :db/id #edb/ref 17592186280035}] :answer-field/correct {:answer/id #uuid "bd48e46b-231b-5fdd-b920-223cf326b2ee" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 & -5 \\\\ 3 & -1 & 1 \\\\ -2 & 3 & -1\\end{aligned}]" :db/id #edb/ref 17592186280035} :answer-field/id #uuid "2f1c1220-b501-550d-b027-49a87b60f60e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280030}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "b9c4fe27-fb6e-5544-9585-41aed92d912c" :question/math-academy-id "q-74944" :question/problem "Find the standard matrix that represents  the  linear  transformation $T$, where\n\n$$\nT:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}2y-5z+x \\\\ z-y+3x \\\\ -z-2x+3y\\end{aligned}].\n$$" :question/worked-solution "First, rewrite the order of the variables in the usual way:\n\n$$\nT:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}x+2y-5z \\\\ 3x-y+z \\\\ -2x+3y-z\\end{aligned}]\n$$\n\nWe require a $3\\times 3$ matrix $T$ such that\n\n$$\nT\\cdot [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}x+2y-5z \\\\ 3x-y+z \\\\ -2x+3y-z\\end{aligned}].\n$$\n\nNotice that\n\n$$\n[\\begin{aligned}1 & 2 & -5 \\\\ 3 & -1 & 1 \\\\ -2 & 3 & -1\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}x+2y-5z \\\\ 3x-y+z \\\\ -2x+3y-z\\end{aligned}].\n$$\n\nTherefore, the matrix which represents the linear transformation $T$ is\n\n$$\n[\\begin{aligned}1 & 2 & -5 \\\\ 3 & -1 & 1 \\\\ -2 & 3 & -1\\end{aligned}].\n$$"}]}
