2} \\\\  & =8+2(4) \\\\  & =16 \\\\ {a}_{5} & ={a}_{4}+2{a}_{3} \\\\  & =16+2(8) \\\\  & =32 \\\\  & ⋮\\end{aligned}\n$$\n\nTherefore, \n\n$$\nA={2,4,8,16,32,…}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038029/state.json" "file_sha256" "a1015adf27d4e3e2ae3adee3bcf5ac092cc6922199e5c2f33bd99ae384d04bfc"} {"question" "q-181711" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038029/activity-metadata.json" "file_sha256" "95d55ca3254675c8ee695c1eb22f5cc3a1cf8fe6cddaaafe9f0a79fb3c7874f8"} {"question" "q-181711" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038029/state.json" "file_sha256" "a1015adf27d4e3e2ae3adee3bcf5ac092cc6922199e5c2f33bd99ae384d04bfc"} {"question" "q-181711" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{2,4,8,12,16,…}"] ["math" "{2,4,8,12,24,…}"] ["math" "{2,4,8,14,22,…}"] ["math" "{2,4,8,16,32,…}"] ["math" "{2,4,8,16,48,…}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038029/state.json" "file_sha256" "a1015adf27d4e3e2ae3adee3bcf5ac092cc6922199e5c2f33bd99ae384d04bfc"} {"question" "q-181711" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{2,4,8,16,32,…}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038029/state.json" "file_sha256" "a1015adf27d4e3e2ae3adee3bcf5ac092cc6922199e5c2f33bd99ae384d04bfc"} {"question" "q-183668" "field" nil "attribute" "question/problem" "value" "Consider the set $A,$ defined as\n\n$$\nA={{a}_{n}\\,:\\,{a}_{n+1}=3{a}_{n}-4,\\,{a}_{1}=0,\\,n\\in N}.\n$$\n\nWhich of the following sets is equivalent to $A?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038029/state.json" "file_sha256" "a1015adf27d4e3e2ae3adee3bcf5ac092cc6922199e5c2f33bd99ae384d04bfc"} {"question" "q-183668" "field" nil "attribute" "question/worked-solution" "value" "The elements of $A$ are all the terms of the *recursive* sequence ${a}_{n},$ given by\n\n$$\n{a}_{n+1}=3{a}_{n}-4,\\,{a}_{1}=0,\\,n\\in N.\n$$\n\nLet's write down the first few terms of our sequence:\n\n$$\n\\begin{aligned}{a}_{1} & =0 \\\\ {a}_{2} & =3{a}_{1}-4 \\\\  & =3(0)-4 \\\\  & =-4 \\\\ {a}_{3} & =3{a}_{2}-4 \\\\  & =3(-4)-4 \\\\  & =-16 \\\\ {a}_{4} & =3{a}_{3}-4 \\\\  & =3(-16)-4 \\\\  & =-52 \\\\  & ⋮\\end{aligned}\n$$\n\nTherefore, \n\n$$\nA={0,-4,-16,-52,…}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038029/state.json" "file_sha256" "a1015adf27d4e3e2ae3adee3bcf5ac092cc6922199e5c2f33bd99ae384d04bfc"} {"question" "q-183668" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038029/activity-metadata.json" "file_sha256" "95d55ca3254675c8ee695c1eb22f5cc3a1cf8fe6cddaaafe9f0a79fb3c7874f8"} {"question" "q-183668" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038029/state.json" "file_sha256" "a1015adf27d4e3e2ae3adee3bcf5ac092cc6922199e5c2f33bd99ae384d04bfc"} {"question" "q-183668" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{0,-4,-12,-24,…}"] ["math" "{0,-4,-16,-24,…}"] ["math" "{0,-4,-16,-32,…}"] ["math" "{0,-4,-16,-52,…}"] ["math" "{0,-4,-18,-12,…}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038029/state.json" "file_sha256" "a1015adf27d4e3e2ae3adee3bcf5ac092cc6922199e5c2f33bd99ae384d04bfc"} {"question" "q-183668" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{0,-4,-16,-52,…}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038029/state.json" "file_sha256" "a1015adf27d4e3e2ae3adee3bcf5ac092cc6922199e5c2f33bd99ae384d04bfc"} {"question" "q-183670" "field" nil "attribute" "question/problem" "value" "Consider the set $B,$ defined as\n\n$$\nB={{b}_{n}\\,:\\,{b}_{n+1}={b}_{n}+5\\,,\\,{b}_{1}=2,\\,n\\in N}.\n$$\n\nWhich of the following sets is equivalent to $B?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038029/state.json" "file_sha256" "a1015adf27d4e3e2ae3adee3bcf5ac092cc6922199e5c2f33bd99ae384d04bfc"} {"question" "q-183670" "field" nil "attribute" "question/worked-solution" "value" "The elements of $B$ are all the terms of the *recursive* sequence ${b}_{n},$ given by\n\n$$\n{b}_{n+1}={b}_{n}+5,\\,{b}_{1}=2,\\,n\\in N.\n$$\n\nLet's write down the first few terms of our sequence:\n\n$$\n\\begin{aligned}{b}_{1} & =2 \\\\ {b}_{2} & ={b}_{1}+5 \\\\  & =2+5 \\\\  & =7 \\\\ {b}_{3} & ={b}_{2}+5 \\\\  & =7+5 \\\\  & =12 \\\\ {b}_{4} & ={b}_{3}+5 \\\\  & =12+5 \\\\  & =17 \\\\  & ⋮\\end{aligned}\n$$\n\nTherefore, \n\n$$\nB={2,7,12,17,…}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038029/state.json" "file_sha256" "a1015adf27d4e3e2ae3adee3bcf5ac092cc6922199e5c2f33bd99ae384d04bfc"} {"question" "q-183670" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home