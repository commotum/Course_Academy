}{8}}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-180746/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0448a1c0-e35b-56a1-aaf3-6e7a33962ade"] :knowledge-point/questions ["q-180746"] :db/ensure [:knowledge-point/validate]} {:db/id "q-183518/selection/1f96ced56b43e4a1a7f6c1989801c0cb93a3a488dc7611f826dc460b93656b0c" :answer/id #uuid "01700d80-cc67-5ef0-9c39-effaa90cc186" :answer/type :answer.type/math :answer/value "{1,-2,10,25}" :db/ensure [:answer/validate]} {:db/id "q-183518/selection/3942270d63b9a1ecf13fa76a3e9e61d30f0e8d94a86e429255c36767510298c0" :answer/id #uuid "e550fdc9-517c-5dd3-a0aa-41704f8f2b3a" :answer/type :answer.type/math :answer/value "{1,-2,0,4}" :db/ensure [:answer/validate]} {:db/id "q-183518/selection/bab7b31d0e938deea42a9755d5354ce37dbcd17fa3779bcce966dcd0478a2a9e" :answer/id #uuid "4998f4b5-8717-5523-84f8-c8977d206439" :answer/type :answer.type/math :answer/value "{1,-2,5,9}" :db/ensure [:answer/validate]} {:db/id "q-183518/selection/f727aa4cb340c94cc4d179390d9eee633ad7145078538d61621982ad71b7ee9c" :answer/id #uuid "da9d4b2a-5656-5e90-8710-0906de9956a6" :answer/type :answer.type/math :answer/value "{1,-2,10,15}" :db/ensure [:answer/validate]} {:db/id "q-183518/selection/dbd10c366d9faa865ec0f61b4637bb967e17651318b37b624a27afe200d2e086" :answer/id #uuid "e32cc044-1e6d-50e4-b73d-f64126b1523a" :answer/type :answer.type/math :answer/value "{1,-2,-1,2,3}" :db/ensure [:answer/validate]} {:db/id "q-183518/selection" :answer-field/id #uuid "e96382b3-7a6e-5228-bf2c-b076a92c7b11" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-183518/selection/1f96ced56b43e4a1a7f6c1989801c0cb93a3a488dc7611f826dc460b93656b0c" :answer-field/choices ["q-183518/selection/1f96ced56b43e4a1a7f6c1989801c0cb93a3a488dc7611f826dc460b93656b0c" "q-183518/selection/3942270d63b9a1ecf13fa76a3e9e61d30f0e8d94a86e429255c36767510298c0" "q-183518/selection/bab7b31d0e938deea42a9755d5354ce37dbcd17fa3779bcce966dcd0478a2a9e" "q-183518/selection/f727aa4cb340c94cc4d179390d9eee633ad7145078538d61621982ad71b7ee9c" "q-183518/selection/dbd10c366d9faa865ec0f61b4637bb967e17651318b37b624a27afe200d2e086"] :db/ensure [:answer-field/validate]} {:db/id "q-183518" :question/id #uuid "5b7551b2-6098-5558-b207-19919ba6780f" :question/math-academy-id "q-183518" :question/problem "Consider the set $B,$ defined as\n\n$$\nB={3{n}^{2}-2:n\\in {-1,0,1,2,3}}.\n$$\n\nWhich of the following sets is equivalent to $B?$" :question/worked-solution "The elements of $B$ are all the terms of the sequence ${b}_{n},$ given by\n\n$$\n{b}_{n}=3{n}^{2}-2,\\,n\\in {-1,0,1,2,3}.\n$$\n\nLet's write down all the terms of our sequence:\n\n$$\n\\begin{aligned}{b}_{-1} & =3(-1)^{2}-2=3-2=1 \\\\ {b}_{0} & =3(0)^{2}-2=0-2=-2 \\\\ {b}_{1} & =3(1)^{2}-2=3-2=1 \\\\ {b}_{2} & =3(2)^{2}-2=12-2=10 \\\\ {b}_{3} & =3(3)^{2}-2=27-2=25\\end{aligned}\n$$\n\nTherefore, \n\n$$\nB={1,-2,1,10,25}={1,-2,10,25}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-183518/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0448a1c0-e35b-56a1-aaf3-6e7a33962ade"] :knowledge-point/questions ["q-183518"] :db/ensure [:knowledge-point/validate]} {:db/id "q-183523/selection/fa6ae4eebc7b8c3833e02783a40445da47d622b2bf7f3da11c8b76e4d45059a3" :answer/id #uuid "21589234-2ac7-5713-b255-567bd09f57d6" :answer/type :answer.type/math :answer/value "{\\frac{1}{8},\\frac{1}{2},4,16}" :db/ensure [:answer/validate]} {:db/id "q-183523/selection/05f69d3e1eade7027c9524306817cd5e3399c79d64b23556dbd457864ea5b81f" :answer/id #uuid "fa8e51f7-ac85-52fa-b8ee-9d605681b821" :answer/type :answer.type/math :answer/value "{\\frac{1}{8},\\frac{1}{2},\\frac{1}{4},1}" :db/ensure [:answer/validate]} {:db/id "q-183523/selection/7bae69ff66d8a562606fcd77977062403113ca1a7f4e276ebfbd7117aeb09988" :answer/id #uuid "b2c5eec0-cb98-5f58-90b5-53b93104f085" :answer/type :answer.type/math :answer/value "{\\frac{1}{8},\\frac{1}{2},1,2}" :db/ensure [:answer/validate]} {:db/id "q-183523/selection/d80483feff76a3eeca5684d486bf90bf113eb698e88f15d68a58e561cc5d5126" :answer/id #uuid "1f6cfd71-e47c-5d1a-b3bb-c90d0b114f46" :answer/type :answer.type/math :answer/value "{\\frac{1}{8},\\frac{1}{2},2,8}" :db/ensure [:answer/validate]} {:db/id "q-183523/selection/267009563dbdc9d24fdd7ceb2317fb2270a076dd17a5fbc55c42c52641feffcf" :answer/id #uuid "21167412-c1a2-5f33-a8d9-b9978ce9ae56" :answer/type :answer.type/math :answer/value "{\\frac{1}{8},\\frac{1}{4},1,4}" :db/ensure [:answer/validate]} {:db/id "q-183523/selection" :answer-field/id #uuid "e53ddd8b-ffe7-5490-8da4-e38dedb0c027" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-183523/selection/d80483feff76a3eeca5684d486bf90bf113eb698e88f15d68a58e561cc5d5126" :answer-field/choices ["q-183523/selection/fa6ae4eebc7b8c3833e02783a40445da47d622b2bf7f3da11c8b76e4d45059a3" "q-183523/selection/05f69d3e1eade7027c9524306817cd5e3399c79d64b23556dbd457864ea5b81f" "q-183523/selection/7bae69ff66d8a562606fcd77977062403113ca1a7f4e276ebfbd7117aeb09988" "q-183523/selection/d80483feff76a3eeca5684d486bf90bf113eb698e88f15d68a58e561cc5d5126" "q-183523/selection/267009563dbdc9d24fdd7ceb2317fb2270a076dd17a5fbc55c42c52641feffcf"] :db/ensure [:answer-field/validate]} {:db/id "q-183523" :question/id #uuid "a5c05e76-1db0-5564-9416-c7017a828cbe" :question/math-academy-id "q-183523" :question/problem "Consider the set $B,$ defined as\n\n$$\nB={\\frac{1}{2}(4)^{n}:n\\in Z,\\,-1\\le n\\le 2}.\n$$\n\nWhich of the following sets is equivalent to $B?$" :question/worked-solution "The condition after the \"$:$\" symbol\n\n$$\nn\\in Z,\\,-1\\le n\\le 2\n$$\n\nstates that $n$ can be any integer number that satisfies the inequality $-1\\le n\\le 2.$ In other words, \n\n$$\nn={-1,0,1,2}.\n$$\n\nTherefore, the elements of $B$ are all the terms of the sequence ${b}_{n},$ given by\n\n$$\n{b}_{n}=\\frac{1}{2}(4)^{n},\\,n\\in {-1,0,1,2}.\n$$\n\nLet's write down all the terms of our sequence:\n\n$$\n\\begin{aligned}{b}_{-1} & =\\frac{1}{2}(4)^{-1}=\\frac{1}{2}\\cdot \\frac{1}{4}=\\frac{1}{8} \\\\ {b}_{0} & =\\frac{1}{2}(4)^{0}=\\frac{1}{2}\\cdot 1=\\frac{1}{2} \\\\ {b}_{1} & =\\frac{1}{2}(4)^{1}=\\frac{1}{2}\\cdot 4=2 \\\\ {b}_{2} & =\\frac{1}{2}(4)^{2}=\\frac{1}{2}\\cdot 16=8\\end{aligned}\n$$\n\nTherefore, \n\n$$\nB={\\frac{1}{8},\\frac{1}{2},2,8}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-183523/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0448a1c0-e35b-56a1-aaf3-6e7a33962ade"] :knowledge-point/questions ["q-183523"] :db/ensure [:knowledge-point/validate]} {:db/id "q-183521/selection/1d5621d60f2f957a1b22ab06b082f4760958b9eee26c602bea294a2d6e14234e" :answer/id #uuid "bda9dffe-9782-5b9c-9819-843d827d1efb" :answer/type :answer.type/math :answer/value "{3,6,9,27,…}" :db/ensure [:answer/validate]} {:db/id "q-183521/selection/a851dd9aad90d1622fc271934bebead7b0ea3e7a6886ed17492aa11ab950a857" :answer/id #uuid "ca4da3e0-261f-52f7-9519-8ea174e6fa3c" :answer/type :answer.type/math :answer/value "{3,9,27,81,…}" :db/ensure [:answer/validate]} {:db/id "q-183521/selection/bc6489ef78a4caf5b1c3840c146316199e2559f88bb376581ce5af677dcbf2e3" :answer/id #uuid "9415ffe6-6946-5b9b-b091-36cf1062012f" :answer/type :answer.type/math :answer/value "{3,9,27,54,…}" :db/ensure [:answer/validate]} {:db/id "q-183521/selection/9b1fd7e6d20faa67f9198969bdcaa2fb1e3592a70af028e8eae88037f3a00e4a" :answer/id #uuid "546faba5-f660-5007-93fc-eded2f670661" :answer/type :answer.type/math :answer/value "{3,6,12,24,…}" :db/ensure [:answer/validate]} {:db/id "q-183521/selection/ac55bed9bc029171942ca66a2a69742e7a602ffd1160fa6b797fb6f6d0b8ef93" :answer/id #uuid "d381aa28-cb6e-5b2d-9274-e709840caf5c" :answer/type :answer.type/math :answer/value "{3,9,27,36,…}" :db/ensure [:answer/validate]} {:db/id "q-183521/selection" :answer-field/id #uuid "3bc30d47