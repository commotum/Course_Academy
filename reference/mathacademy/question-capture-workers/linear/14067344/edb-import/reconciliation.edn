on-capture/13948957/state.json" "file_sha256" "2e413607df37daceb6792959024f6c91ad3c91de05fe6ce68bf34c31ed306d2e" "basis" 559 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948957/edb-import/verification.json"} {"question" "q-74775" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}3 \\\\ 2\\end{aligned}]"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948957/state.json" "file_sha256" "2e413607df37daceb6792959024f6c91ad3c91de05fe6ce68bf34c31ed306d2e" "basis" 559 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948957/edb-import/verification.json"} {"question" "q-74775" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}6 \\\\ 12\\end{aligned}]"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948957/state.json" "file_sha256" "2e413607df37daceb6792959024f6c91ad3c91de05fe6ce68bf34c31ed306d2e" "basis" 559 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13948957/edb-import/verification.json"} {"question" "q-8331" "field" nil "attribute" "question/worked-solution" "value" "A linear transformation $T$ satisfies two properties:\n\n$$\n\\begin{aligned} & T[\\begin{aligned}kx \\\\ ky\\end{aligned}]=kT[\\begin{aligned}x \\\\ y\\end{aligned}], \\\\  & T[\\begin{aligned}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{aligned}]=T[\\begin{aligned}{x}_{1} \\\\ {y}_{1}\\end{aligned}]+T[\\begin{aligned}{x}_{2} \\\\ {y}_{2}\\end{aligned}].\\end{aligned}\n$$\n\n- Checking the first condition, we have\n\n$$\n\\begin{aligned}T[\\begin{aligned}kx \\\\ ky\\end{aligned}] & =[\\begin{aligned}ky \\\\ kx\\end{aligned}] \\\\  & =k[\\begin{aligned}y \\\\ x\\end{aligned}] \\\\  & =kT[\\begin{aligned}x \\\\ y\\end{aligned}].\\,✓\\end{aligned}\n$$\n\n- Checking the second condition, we have\n\n$$\n\\begin{aligned}T[\\begin{aligned}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{aligned}] & =[\\begin{aligned}{y}_{1}+{y}_{2} \\\\ {x}_{1}+{x}_{2}\\end{aligned}] \\\\  & =[\\begin{aligned}{y}_{1} \\\\ {x}_{1}\\end{aligned}]+[\\begin{aligned}{y}_{2} \\\\ {x}_{2}\\end{aligned}] \\\\  & =T[\\begin{aligned}{x}_{1} \\\\ {y}_{1}\\end{aligned}]+T[\\begin{aligned}{x}_{2} \\\\ {y}_{2}\\end{aligned}].\\,✓\\end{aligned}\n$$\n\nTherefore, $\\text{T}$ is a linear transformation.\n\nAs a result, all three statements are true." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13960038/state.json" "file_sha256" "eb6ac2725d148f0db807a2cb04781f248c3736c72d91eb6ed0a6f155a5b57273" "basis" 636 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13960038/edb-import/verification.json"} {"question" "q-8331" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13960038/activity-metadata.json" "file_sha256" "4c276450c172ff2b71e0201aa44f58a6cb1ae27410179c6d1f971842dfcfe3b1" "basis" 636 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13960038/edb-import/verification.json"} {"question" "q-8331" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13960038/state.json" "file_sha256" "eb6ac2725d148f0db807a2cb04781f248c3736c72d91eb6ed0a6f155a5b57273" "basis" 636 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13960038/edb-import/verification.json"} {"question" "q-8331" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "I and II only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy