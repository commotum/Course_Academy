#{[{:db/id #edb/ref 17592186262654 :knowledge-point/_questions [{:knowledge-point/id #uuid "381f7ffe-ae4b-5e45-9fa9-e2a6bd8348b3" :knowledge-point/title "Determining the Image of a Vector Under a Map Using Vector Addition and Scalar Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "471db198-499e-53ab-bde4-7f405b035dbe" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 \\\\ 12\\end{aligned}]" :db/id #edb/ref 17592186262656} {:answer/id #uuid "d2bd33c6-19d7-5a88-a88c-c8f48e942d66" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186262657} {:answer/id #uuid "ebdff365-0d82-5773-b245-ec0f4c32b657" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186262658} {:answer/id #uuid "03eaa1f8-6908-539e-b1a9-5c16d08c6632" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186262659} {:answer/id #uuid "46d6be46-15b2-52b7-82ea-ba26b3040f35" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186262660}] :answer-field/correct {:answer/id #uuid "03eaa1f8-6908-539e-b1a9-5c16d08c6632" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186262659} :answer-field/id #uuid "e228ddcc-0ebd-586f-b279-9dad1b31844d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262655}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "57cbc13b-b004-59d3-9b49-913460c9f9b2" :question/math-academy-id "q-74775" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,T(3{v}_{1}+7{v}_{2})=[\\begin{aligned}13 \\\\ 5\\end{aligned}]\\,$ and $\\,T({v}_{2})=[\\begin{aligned}1 \\\\ -1\\end{aligned}]$, then find $\\,T({v}_{1}).$" :question/worked-solution "Since $T$ is a linear transformation, we have that\n\n$$\n\\begin{aligned}T(kv+hw)=T(kv)+T(hw)=kT(v)+hT(w)\\end{aligned}\n$$\n\nfor any vectors $v$ and $w.$ Therefore,\n\n$$\n\\begin{aligned}T(3{v}_{1}+7{v}_{2}) & =3T({v}_{1})+7T({v}_{2}) \\\\ [\\begin{aligned}13 \\\\ 5\\end{aligned}] & =3T({v}_{1})+7[\\begin{aligned}1 \\\\ -1\\end{aligned}] \\\\ 3T({v}_{1}) & =[\\begin{aligned}13 \\\\ 5\\end{aligned}]-7[\\begin{aligned}1 \\\\ -1\\end{aligned}] \\\\ 3T({v}_{1}) & =[\\begin{aligned}13 \\\\ 5\\end{aligned}]-[\\begin{aligned}7 \\\\ -7\\end{aligned}] \\\\ 3T({v}_{1}) & =[\\begin{aligned}6 \\\\ 12\\end{aligned}] \\\\ T({v}_{1}) & =\\frac{1}{3}[\\begin{aligned}6 \\\\ 12\\end{aligned}] \\\\ T({v}_{1}) & =[\\begin{aligned}2 \\\\ 4\\end{aligned}].\\end{aligned}\n$$"}]}
