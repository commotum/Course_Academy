f3d156606a84e60b4"} {"question" "q-120260" "field" nil "attribute" "question/worked-solution" "value" "To find $\\lambda ,$ we want to match the expression\n\n$$\nc=\\lambda a-3b.\n$$\n\nWe are given that one of the components is $-3b.$ So, we first draw the vector $-3b$ from the origin. Then we complete the path to the point $C.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041137/assets/2484cf9fdda85c5c516babe6814f34c369ebdd91d6f100f0ce0fe4102e3c90a6.png)\n\nLet $P$ be the endpoint of the vector $-3b.$ Then\n\n$$\nc=\\overset{\\to }{OP}+\\overset{\\to }{PC}.\n$$\n\nIn $△OPC,$ we have:\n\n- $PC=3|a|$\n\n- $\\overset{\\to }{PC}$ and $a$ have opposite directions\n\nHence, $\\overset{\\to }{PC}=-3a.$\n\nAdditionally,\n\n$$\n\\begin{aligned}c & =\\overset{\\to }{OP}+\\overset{\\to }{PC} \\\\  & =-3b-3a.\\end{aligned}\n$$\n\nConsequently, $c=\\lambda a-3b=-3a-3b.$\n\nSince $a∦b,$ the linear combination can only be written in one way. Equating the coefficients of $a,$ we get:\n\n$$\n\\lambda =-3\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041137/state.json" "file_sha256" "7d2559e12ac5cac60589db9a1a4fec1d29173ce0f4bcc47f3d156606a84e60b4"} {"question" "q-120260" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041137/activity-metadata.json" "file_sha256" "ad534175e77d374dcb4f648bb962cc45896f56ca9dcb4ac16dd34918e0fa4f70"} {"question" "q-120260" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041137/state.json" "file_sha256" "7d2559e12ac5cac60589db9a1a4fec1d29173ce0f4bcc47f3d156606a84e60b4"} {"question" "q-120260" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-1.5"] ["math" "-2"] ["math" "-2.5"] ["math" "-3"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041137/state.json" "file_sha256" "7d2559e12ac5cac60589db9a1a4fec1d29173ce0f4bcc47f3d156606a84e60b4"} {"question" "q-120260" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-3"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041137/state.json" "file_sha256" "7d2559e12ac5cac60589db9a1a4fec1d29173ce0f4bcc47f3d156606a84e60b4"} {"question" "q-120254" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041137/assets/6882323d2c8017e95100a0ab9d1091fdf149e884ef27d2d2bf59ab7609b1a960.png)\n\nConsider the picture above. Given that $c=\\lambda a+2b,$ find $\\lambda .$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041137/state.json" "file_sha256" "7d2559e12ac5cac60589db9a1a4fec1d29173ce0f4bcc47f3d156606a84e60b4"} {"question" "q-120254" "field" nil "attribute" "question/worked-solution" "value" "To find $\\lambda ,$ we want to match the expression\n\n$$\nc=\\lambda a+2b.\n$$\n\nWe are given that one of the components is $2b.$ So, we first draw the vector $2b$ from the origin. Then we complete the path to the point $C.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041137/assets/a8309dc45ac43c6642010e744de5a062d6575d48ba85bd642df39dd261f47422.png)\n\nLet $P$ be the endpoint of the vector $2b.$ Then\n\n$$\nc=\\overset{\\to }{OP}+\\overset{\\to }{PC}.\n$$\n\nIn $△OPC,$ we have:\n\n- $PC=2|a|$\n\n- $\\overset{\\to }{PC}$ and $a$ have opposite directions\n\nHence, $\\overset{\\to }{PC}=-2a.$\n\nAdditionally,\n\n$$\n\\begin{aligned}c & =\\overset{\\to }{OP}+\\overset{\\to }{PC} \\\\  & =2b-2a.\\end{aligned}\n$$\n\nConsequently, $c=\\lambda a+2b=-2a+2b.$\n\nSince $a∦b,$ the linear combination can only be written in one way. Equating the coefficients of $a,$ we get:\n\n$$\n\\lambda =-2\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041137/state.json" "file_sha256" "7d2559e12ac5cac60589db9a1a4fec1d29173ce0f4bcc47f3d156606a84e60b4"} {"question" "q-120254" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041137/activity-metadata.json" "file_sha256" "ad534175e77d374dcb4f648bb962cc45896f56ca9dcb4ac16dd34918e0fa4f70"} {"question" "q-120254" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041137/state.json" "file_sha256" "7d2559e12ac5cac60589db9a1a4fec1d29173ce0f4bcc47f3d156606a84e60b4"} {"question" "q-120254" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1.5"] ["math" "-2"] ["math" "-3"] ["math" "1.5"] ["math" "2"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041137/state.json" "file_sha256" "7d2559e12ac5cac60589db9a1a4fec1d29173ce0f4bcc47f3d156606a84e60b4"} {"question" "q-120254" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041137/state.json" "file_sha256" "7d2559e12ac5cac60589db9a1a4fec1d29173ce0f4bcc47f3d156606a84e60b4"} {"question" "q-326022" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041137/assets/99d63eb31fba0757bde11dda3653e3791fcddb0b74b5325e20afcede4f3ea849.png)\n\nConsider the picture above. If $r=\\lambda a+\\mu b$, then$\\,\\lambda =$\n{{field-1}}\nand \n$\\mu =$\n{{field-2}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041137/state.json" "file_sha256" "7d2559e12ac5cac60589db9a1a4fec1d29173ce0f4bcc47f3d156606a84e60b4"} {"question" "q-326022" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041137/assets/f7acd51dcca9ad48f4aa7ec026beaeb67ddc9b1e88ab9b5042016674ba6ea542.png)\n\nIn $△OPR$ shown above, we have \n\n- $OP=|a|$\n\n- $\\overset{\\to }{OP}$ and $a$ have the same direction\n\nHence, $\\overset{\\to }{OP}=a.$\n\nSimilarly:\n\n- $PR=4|b|$\n\n- $\\overset{\\to }{PR}$ and $b$ have the same direction\n\nHence, $\\overset{\\to }{PR}=4b.$\n\nAdditionally, \n\n$$\n\\begin{aligned}r & =\\overset{\\to }{OP}+\\overset{\\to }{PR} \\\\  & =a+4b.\\end{aligned}\n$$\n\nConsequently, $r=\\lambda a+\\mu b=1a+4b.$\n\nSince $a∦b,$ the linear combination can only be written in one way. Equating the coefficients, we get:\n\n- $\\lambda =1$ and $\\mu =4$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041137/state.json" "file_sha256" "7d2559e12ac5cac60589db9a1a4fec1d29173ce0f4bcc47f3d156606a84e60b4"} {"question" "q-326022" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041137/activity-metadata.json" "file_sha256" "ad534175e77d374dcb4f648bb962cc45896f56ca9dcb4ac16dd34918e0fa4f70"} {"question" "q-326022" "field" "field-1" "attribu