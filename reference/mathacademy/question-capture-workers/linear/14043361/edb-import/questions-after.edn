7d0-a8c1-4e31e599547b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186319959}] :answer-field/correct {:answer/id #uuid "5cfe7e7d-a4f7-5085-825b-237568485a15" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186319958} :answer-field/id #uuid "9f358bca-d885-5aa1-9be8-626e2f85b59a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186319957} {:answer-field/choices [{:answer/id #uuid "82101486-cf63-5acd-a610-07ed0c7d4284" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186319961}] :answer-field/correct {:answer/id #uuid "82101486-cf63-5acd-a610-07ed0c7d4284" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186319961} :answer-field/id #uuid "2b28313a-e316-5276-af36-fcc9f90f3891" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186319960}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "86216eb9-d1e4-57db-8ca5-bd5748703fa5" :question/math-academy-id "q-320389" :question/problem "Let\n$E=[\\begin{aligned}2 & -1 \\\\ 0 & 5 \\\\ -3 & 4\\end{aligned}]$\nand\n$F=[\\begin{aligned}6 \\\\ -2\\end{aligned}].$ Then, the dimensions of $EF$ are{{field-1}}$\\times $\n{{field-2}}." :question/worked-solution "We notice that $E$ is a $3\\times 2$ matrix and $F$ is a $2\\times 1$ matrix. \n\nThere are $2$ columns in $E$ and $2$ rows in $F.$ Since the number of columns in $E$ equals the number of rows in $F,$ the matrices $E$ and $F$ are conformable for multiplication. \n\nThe product $EF$ has dimensions $3\\times 1:$ \n\n$$\n{E}_{3\\times \\boxed{\\text{2}}}{\\times }_{✓}{F}_{\\boxed{\\text{2}}\\times 1}={EF}_{3\\times 1}\n$$"}] [{:db/id #edb/ref 17592186101317 :knowledge-point/_questions [{:knowledge-point/id #uuid "b494140f-206a-5317-8079-ff719a253140" :knowledge-point/title "Determining Whether Two Matrices Are Conformable for Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "817ec199-0565-53e4-8206-076c4cf7c0a5" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186099499} {:answer/id #uuid "870da87b-4483-59f0-b257-80a06f5553e5" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186099500} {:answer/id #uuid "f11b07fd-5ac1-58a6-8b10-debb052aab82" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186099501} {:answer/id #uuid "2935fa50-cb13-5572-bb18-a0e7989736c9" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186099502} {:answer/id #uuid "2b5da84e-3db1-5a16-bde9-d9f42c48baeb" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186099503}] :answer-field/correct {:answer/id #uuid "2935fa50-cb13-5572-bb18-a0e7989736c9" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186099502} :answer-field/id #uuid "e51f60e0-c55d-5e98-8bd0-9bcaa73bb7ad" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186099498}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "59f14d04-9b7d-5b14-8363-a42027c3b11c" :question/math-academy-id "q-42374" :question/problem "$$\nA=[\\begin{aligned}1 & -1 \\\\ 1 & 2 \\\\ 5 & 3 \\\\ -2 & 1\\end{aligned}],\\,B=[\\begin{aligned}5 & -2 & 1 & 7 \\\\ -1 & 3 & 3 & 0\\end{aligned}],\\,C=[\\begin{aligned}2 & 5 \\\\ -0 & 6\\end{aligned}],\n$$\n\nWhich of the following statement are true regarding the matrices $A,B,$ and $C?$\n\n- The product $AB$ is well defined\n- The product $BA$ is well defined\n- The product $AC$ is well defined" :question/worked-solution "Notice that $A$ is a $4\\times 2$ matrix, $B$ is a $2\\times 4$ matrix, and $C$ is a $2\\times 2$ matrix.\n\nThere are $2$ columns in $A$ and $2$ rows in $B.$ Since the number of columns in $A$ equals the number of rows in $B,$ the matrices $A$ and $B$ are conformable for multiplication:\n\n$$\n{A}_{4\\times \\boxed{\\text{2}}}{\\times }_{✓}{B}_{\\boxed{\\text{2}}\\times 4}=\\text{well defined}\n$$\n\nOn the other hand, there are $4$ columns in $B$ and $4$ rows in $A.$ Since the number of columns in $B$ equals the number of rows in $A,$ the matrices $B$ and $A$ are conformable for multiplication:\n\n$$\n{B}_{2\\times \\boxed{\\text{4}}}{\\times }_{✓}{A}_{\\boxed{\\text{4}}\\times 2}=\\text{well defined}\n$$\n\nFinally, there are $2$ columns in $A$ and $2$ rows in $C.$ Since the number of columns in $A$ equals the number of rows in $C,$ the matrices $A$ and $C$ are conformable for multiplication:\n\n$$\n{A}_{4\\times \\boxed{\\text{2}}}{\\times }_{✓}{C}_{\\boxed{\\text{2}}\\times 2}=\\text{well defined}\n$$\n\nWe conclude that all three statements are true."}] [{:db/id #edb/ref 17592186319962 :knowledge-point/_questions [{:knowledge-point/id #uuid "b494140f-206a-5317-8079-ff719a253140" :knowledge-point/title "Determining Whether Two Matrices Are Conformable for Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2e04d10-c7e2-5141-8bc2-c81477b672ab" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186319964} {:answer/id #uuid "ecefff85-a6bb-5327-83d4-977fd4f803fd" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186319965} {:answer/id #uuid "1729579d-d89c-5b6b-8624-392ec00d7675" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186319966} {:answer/id #uuid "dc79beda-e403-5b60-b642-9464d319dd19" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186319967} {:answer/id #uuid "c02960f7-95ee-5842-91e7-fbb72d11cb9f" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186319968}] :answer-field/correct {:answer/id #uuid "c02960f7-95ee-5842-91e7-fbb72d11cb9f" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186319968} :answer-field/id #uuid "1d19f388-3e5d-5ebc-bf16-0563f40d77db" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186319963}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "fbab72a2-b996-5451-a2ce-a24571b5c158" :question/math-academy-id "q-42375" :question/problem "$$\nJ=[\\begin{aligned}2 & 0 & 3 & 1 \\\\ 1 & 2 & -3 & 1 \\\\ 0 & 0 & 2 & 7\\end{aligned}],\\,K=[\\begin{aligned}3 & -5 \\\\ 8 & 7 \\\\ 0 & -2\\end{aligned}],\\,L=[\\begin{aligned}3 & 0 & 1 & 4 \\\\ 2 & 1 & -9 & 0\\end{aligned}]\n$$\n\nWhich of the following statements are true regarding the matrices $J,K,$ and $L?$\n\n- The product $JK$ is well defined\n- The product $KL$ is well defined\n- The product $JL$ is well defined" :question/worked-solution "Notice that $J$ is a $3\\times 4$ matrix, $K$ is a $3\\times 2$ matrix, and $L$ is a $2\\times 4$ matrix.\n\nThere are $4$ columns in $J$ and $3$ rows in $K.$ Since the number of columns in $J$ does **not** equal the number of rows in $K,$ the matrices $J$ and $K$ are **not** conformable for multiplication:\n\n$$\n{J}_{3\\times 4}{\\times }_{\\ne }{K}_{3\\times 2}=\\text{undefined}\n$$\n\nOn the other hand, there are $2$ columns in $K$ and $2$ rows in $L.$ Since the number of columns in $K$ equals the number of rows in $L$, the matrices $K$ and $L$ are conformable for multiplication:\n\n$$\n{K}_{3\\times \\boxed{\\text{2}}}{\\times }_{✓}{L}_{\\boxed{\\text{2}}\\times 4}=\\text{well defined}\n$$\n\nFinally, there are $4$ columns in $J$ and $2$ rows in $L.$ Since the number of columns in $J$ does **not** equal the number of rows in $L$, the matrices $J$ and $L$ are **not** conformable for multiplication:\n\n$$\n{J}_{3\\times 4}{\\times }_{\\ne }{L}_{2\\times 4}=\\text{undefined}\n$$\n\nTherefore, statement II is true, while statements I and III are false."}] [{:db/id #edb/ref 17592186319969 :knowledge-point/_questions [{:knowledge-point/id #uuid "b494140f-206a-5317-8079-ff719a253140" :knowledge-point/title "Determining Whether Two Matrices Are Conformable for Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "479c1103-d4e0-5535-9ee1-05bf4b89f050" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186319971} {:answer/id #uuid "3009f0f1-8099-5948-b069-b058dbb85aeb" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186319972} {:answer/id #uuid "1fbbea6d-f080-52cc-b876-0e0125d2126f" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186319973} {:answer/id #uuid "632fab21-2f5c-5acb-83d2-2291286ba0bb" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186319974} {:answer/id #uuid "c75e3436-363d-5234-9b3e-ee511126cc77" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186319975}] :answer-field/correct {:answer/id #uuid "3009f0f1-8099-5948-b069-b058dbb85aeb" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186319972} :answer-field/id #uuid "5cf9b8d0-4482-546b-bbc0-5fed1ba7f873" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186319970}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "5a11eab4-94a2-5361-9f1e-16fe3bcd7ce1" :question/math-academy-id "q-42376" :question/problem "$$\nD=[\\begin{aligned}-2 & 3 \\\\ 1 & 0\\end{aligned}],\\,E=[\\begin{aligned}2 & 0 \\\\ -3 & 5 \\\\ 2 & 1\\end{aligned}],\\,F=[\\begin{aligned}3 & 1 & 4 \\\\ -2 & 3 & 2\\end{aligned}]\n$$\n\nWhich of the following statements are true regarding the matrices $D,E,$ and $F?$\n\n- The product $ED$ is well defined\n- The product $FD$ is well defined\n- The product $EF$ is well defined" :question/worked-solution "Notice that $D$ is a $2\\times 2$ matrix, $E$ is a $3\\times 2$ matrix, and $F$ is a $2\\times 3$ matrix.\n\nThere are $2$ columns in $E$ and $2$ rows in $D.$ Since the number of columns in $E$ equals the number of rows in $D,$ the matrices $E$ and $D$ are conformable for multiplication:\n\n$$\n{E}_{3\\times \\boxed{\\text{2}}}{\\times }_{✓}{D}_{\\boxed{\\text{2}}\\times 2}=\\text{well defined}\n$$\n\nOn the other hand, there are $3$ columns in $F$ and $2$ rows in $D.$ Since the number of columns in $F$ does **not** equal the number of rows in $D,$ the matrices $F$ and $D$ are **not** conformable for multiplication:\n\n$$\n{F}_{2\\times 3}{\\times }_{\\ne }{D}_{2\\times 2}=\\text{undefined}\n$$\n\nFinally, there are $2$ columns in $E$ and $2$ rows in $F.$ Since the number of columns in $E$ equals the number of rows in $F,$ the matrices $E$ and $F$ are conformable for multiplication:\n\n$$\n{E}_{3\\times \\boxed{\\text{2}}}{\\times }_{✓}{F}_{\\boxed{\\text{2}}\\times 3}=\\text{well defined}\n$$\n\nTherefore, statements I and III are true, while statement II is false."}] [{:db/id #edb/ref 17592186319976 :knowledge-point/_questions [{:knowledge-point/id #uuid "f38167e2-3c1d-5c00-9691-ba8e6ac6fdce" :knowledge-point/title "Determining the Dimension of the Product of Two Matrices Given the Dimensions of the Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac99cb50-da9b-5e97-85b6-1d4d301c9904" :answer/type {:db/ident :answer.type/math} :answer/value "4\\times 3" :db/id #edb/ref 17592186319978} {:answer/id #uuid "a71cc80d-e6a2-53e4-804e-56daf70ada7c" :answer/type {:db/ident :answer.type/math} :answer/value "3\\times 5" :db/id #edb/ref 17592186319979} {:answer/id #uuid "6654e2f1-6a95-55cb-9273-d21aed8511e0" :answer/type {:db/ident :answer.type/text} :answer/value "The product is undefined" :db/id #edb/ref 17592186319980} {:answer/id #uuid "c89a7270-3e73-53b6-a053-649d6cfbcba2" :answer/type {:db/ident :answer.type/math} :answer/value "5\\times 2" :db/id #edb/ref 17592186319981} {:answer/id #uuid "371f37c5-c633-5a3c-83cf-40238403a1db" :answer/type {:db/ident :answer.type/math} :answer/value "2\\times 5" :db/id #edb/ref 17592186319982}] :answer-field/correct {:answer/id #uuid "371f37c5-c633-5a3c-83cf-40238403a1db" :answer/type {:db/ident :answer.type/math} :answer/value "2\\times 5" :db/id #edb/ref 17592186319982} :answer-field/id #uuid "25371ec4-da27-5e3f-a920-53e57f0c18e3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186319977}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b6d91d7a-fd3c-5ac1-a867-f21d5c719d3a" :question/math-academy-id "q-70702" :question/problem "Suppose $R$ is a $4\\times 5$ matrix and $S$ is a  $2\\times 4$ matrix. What are the dimensions of $SR?$" :question/worked-solution "There are $4$ columns in $S$ and $4$ rows in $R.$ Since the number of columns in $S$ equals the number of rows in $R,$ the matrices $S$ and $R$ are conformable for multiplication, and $SR$ is a $2\\times 5$ matrix:\n\n$$\n{R}_{2\\times \\boxed{\\text{4}}}{\\times }_{✓}{S}_{\\boxed{\\text{4}}\\times 5}={SR}_{2\\times 5}\n$$"}] [{:db/id #edb/ref 17592186319983 :knowledge-point/_questions [{:knowledge-point/id #uuid "f38167e2-3c1d-5c00-9691-ba8e6ac6fdce" :knowledge-point/title "Determining the Dimension of the Product of Two Matrices Given the Dimensions of the Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36acc228-088a-52ea-b1f5-dd671df10abc" :answer/type {:db/ident :answer.type/math} :answer/value "3\\times 6" :db/id #edb/ref 17592186319985} {:answer/id #uuid "9bcd7a0e-df93-5012-8ec6-3ca318d7b326" :answer/type {:db/ident :answer.type/text} :answer/value "T