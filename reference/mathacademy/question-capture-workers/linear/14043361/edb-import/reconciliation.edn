{"authored" [{"question" "q-129486" "field" nil "attribute" "question/problem" "value" "Suppose $A$ is a $8\\times 7$ matrix and $B$ is a  $2\\times 8$ matrix. What are the dimensions of $BA?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/state.json" "file_sha256" "83bde52d19ee01cda00814b9fad01cc00ece6f9617075c72eacf4b36df781aa7" "basis" 918 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/edb-import/verification.json"} {"question" "q-129486" "field" nil "attribute" "question/worked-solution" "value" "There are $8$ columns in $B$ and $8$ rows in $A.$ Since the number of columns in $B$ equals the number of rows in $A,$ the matrices $B$ and $A$ are conformable for multiplication, and $BA$ is a $2\\times 7$ matrix: \n\n$$\n{B}_{2\\times \\boxed{\\text{8}}}{\\times }_{✓}{A}_{\\boxed{\\text{8}}\\times 7}={BA}_{2\\times 7}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/state.json" "file_sha256" "83bde52d19ee01cda00814b9fad01cc00ece6f9617075c72eacf4b36df781aa7" "basis" 918 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/edb-import/verification.json"} {"question" "q-129486" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/activity-metadata.json" "file_sha256" "f9257f8c40add6ab1b82355accdf9587b7750c84fd830461d2b204bd0b61c3bd" "basis" 918 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/edb-import/verification.json"} {"question" "q-129486" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/1397904