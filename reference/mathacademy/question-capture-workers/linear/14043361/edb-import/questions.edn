cf879824eb57" :answer/type {:db/ident :answer.type/math} :answer/value "1\\times 1" :db/id #edb/ref 17592186282911} {:answer/id #uuid "69320948-e510-5047-a958-17bfc6bd1f99" :answer/type {:db/ident :answer.type/math} :answer/value "3\\times 1" :db/id #edb/ref 17592186282912} {:answer/id #uuid "bacac1d7-3877-55cf-b556-9b5f4957a387" :answer/type {:db/ident :answer.type/math} :answer/value "3\\times 3" :db/id #edb/ref 17592186282913} {:answer/id #uuid "9d90252c-6d53-56c9-890a-3be3df47a168" :answer/type {:db/ident :answer.type/math} :answer/value "1\\times 3" :db/id #edb/ref 17592186282914}] :answer-field/correct {:answer/id #uuid "6e732728-847e-5252-ac8b-cf879824eb57" :answer/type {:db/ident :answer.type/math} :answer/value "1\\times 1" :db/id #edb/ref 17592186282911} :answer-field/id #uuid "9b2ca89d-15de-5651-b636-f4b9523a0e92" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186282909}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0f9e4b7d-8d63-5bd9-943e-83554bcbd252" :question/math-academy-id "q-77475" :question/problem "Let\n$Y=[\\begin{aligned}\\sqrt{2} & -1 & 0\\end{aligned}]$\nand\n$U=[\\begin{aligned}-4 \\\\ 0 \\\\ \\sqrt{3}\\end{aligned}].$\nWhat are the dimensions of $YU?$" :question/worked-solution "We notice that $Y$ is a $1\\times 3$ matrix and $U$ is a $3\\times 1$ matrix. \n\nThere are $3$ columns in $Y$ and $3$ rows in $U.$ Since the number of columns in $Y$ equals the number of rows in $U,$ the matrices $Y$ and $U$ are conformable for multiplication. \n\nThe product $YU$ has dimensions $1\\times 1:$\n\n$$\n{Y}_{1\\times \\boxed{\\text{3}}}{\\times }_{✓}{U}_{\\boxed{\\text{3}}\\times 1}={YU}_{1\\times 1}\n$$"}]}
