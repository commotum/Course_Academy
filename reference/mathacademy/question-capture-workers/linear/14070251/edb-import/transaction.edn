\\\ -5\\end{aligned}].$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-80828/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e568b6fc-88f0-592b-a24d-e3286cfa5043"] :knowledge-point/questions ["q-80828"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81228/selection/d4979dd67bc6dff4fb3d95f2fd70f3821ad884e128b4ec2858d857c901862799" :answer/id #uuid "bce2b1c3-5547-5855-902f-6dbd0087d002" :answer/type :answer.type/math :answer/value "[x]_{C}=[\\begin{aligned}-3 \\\\ 5 \\\\ -8\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81228/selection/73dadcbca1e15ab17b688396d6b677b53d7b85abca8d15713ab18c4432dbf9ee" :answer/id #uuid "8dd5c4f8-f187-575a-bd80-4be491babeac" :answer/type :answer.type/math :answer/value "[x]_{C}=[\\begin{aligned}-8 \\\\ -3 \\\\ 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81228/selection/d4055932f55f034742a4cc2c9070bb048aedfd9c0bb19ed1609aa5d8b4a9ca0c" :answer/id #uuid "f6f2cb71-daa8-555b-ab4f-7cd2976d5fcd" :answer/type :answer.type/math :answer/value "[x]_{C}=[\\begin{aligned}-5 \\\\ 8 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81228/selection/92c6d403eb6dfe3e21e99a27c64e1b7566eae668b8f9a3df2fed93be893a2cca" :answer/id #uuid "3cbad198-faeb-5e5f-a1e2-4b630d9785db" :answer/type :answer.type/math :answer/value "[x]_{C}=[\\begin{aligned}5 \\\\ 4 \\\\ 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81228/selection/bf9dd070eb6be7689cb3abe27eea3cc1898318c9a98c0c7d1e0de051ecc3b069" :answer/id #uuid "0bf77210-a4cc-59d0-b65d-35021f44befd" :answer/type :answer.type/math :answer/value "[x]_{C}=[\\begin{aligned}3 \\\\ -6 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81228/selection" :answer-field/id #uuid "646fac00-95ca-5e24-a043-13e5f70fc5ec" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81228/selection/73dadcbca1e15ab17b688396d6b677b53d7b85abca8d15713ab18c4432dbf9ee" :answer-field/choices ["q-81228/selection/d4979dd67bc6dff4fb3d95f2fd70f3821ad884e128b4ec2858d857c901862799" "q-81228/selection/73dadcbca1e15ab17b688396d6b677b53d7b85abca8d15713ab18c4432dbf9ee" "q-81228/selection/d4055932f55f034742a4cc2c9070bb048aedfd9c0bb19ed1609aa5d8b4a9ca0c" "q-81228/selection/92c6d403eb6dfe3e21e99a27c64e1b7566eae668b8f9a3df2fed93be893a2cca" "q-81228/selection/bf9dd070eb6be7689cb3abe27eea3cc1898318c9a98c0c7d1e0de051ecc3b069"] :db/ensure [:answer-field/validate]} {:db/id "q-81228" :question/id #uuid "0c50d71d-4c9b-56e2-bd55-7c3b84704bd1" :question/math-academy-id "q-81228" :question/problem "Let $B={{b}_{1},{b}_{2},{b}_{3}}$ be a basis of ${R}^{3}$ and $[x]_{B}=[\\begin{aligned}15 \\\\ -24 \\\\ 18\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C={{c}_{1},{c}_{2},{c}_{3}},$ where ${c}_{1}=3{b}_{2}$, ${c}_{2}=-6{b}_{3}$ and ${c}_{3}=3{b}_{1}?$" :question/worked-solution "Since $[x]_{B}=[\\begin{aligned}15 \\\\ -24 \\\\ 18\\end{aligned}]$, we can write $x$ as follows:\n\n$$\n\\begin{aligned}x & =15{b}_{1}-24{b}_{2}+18{b}_{3} \\\\  & =-24{b}_{2}+18{b}_{3}+15{b}_{1} \\\\  & =-8(3{b}_{2})-3(-6{b}_{3})+5(3{b}_{1}) \\\\  & =-8{c}_{1}-3{c}_{2}+5{c}_{3}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}-8 \\\\ -3 \\\\ 5\\end{aligned}].$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-81228/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "df96d21a-e1bc-5a9b-b528-d6e7b30d8451"] :knowledge-point/questions ["q-81228"] :db/ensure [:knowledge-point/validate]} {:db/id "q-112656/selection/045a7ff34b3672b70c2c8e22c4d43cc77afd9bd77b5040bde33d8b3010098170" :answer/id #uuid "f7cdb2c0-7adb-5bd5-bd6c-488f244747a4" :answer/type :answer.type/math :answer/value "[x]_{C}=[\\begin{aligned}-4 \\\\ 1 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-112656/selection/9faab7db0db27601ab7c5409455f297bf8c3563f5892b6ac520f7f6384c5a85d" :answer/id #uuid "302b1d3f-31c0-5096-