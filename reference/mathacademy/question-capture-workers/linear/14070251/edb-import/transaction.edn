1a2aa55e4cee0ebc" :answer-field/id #uuid "aaa6176c-45c5-57df-a74d-bf2237118f27" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-80635/selection/ma-v1/2bc5b43f97a36b6fcd498f206a97013213a453803a5165801a2aa55e4cee0ebc/56a4836ae6ef9ce5155b0c7fddadc1d82142bb4493da1063124de1ebfc447ade" :answer-field/choices ["q-80635/selection/ma-v1/2bc5b43f97a36b6fcd498f206a97013213a453803a5165801a2aa55e4cee0ebc/c93b810d05f4c12d94102355e6ee666556137d38f4a8071287a3bf44db058dcb" "q-80635/selection/ma-v1/2bc5b43f97a36b6fcd498f206a97013213a453803a5165801a2aa55e4cee0ebc/56a4836ae6ef9ce5155b0c7fddadc1d82142bb4493da1063124de1ebfc447ade" "q-80635/selection/ma-v1/2bc5b43f97a36b6fcd498f206a97013213a453803a5165801a2aa55e4cee0ebc/e6dfa4d621c6ccd24f1b350a93d5672b01f5cd14114d56153835cf3e8c93bd7d" "q-80635/selection/ma-v1/2bc5b43f97a36b6fcd498f206a97013213a453803a5165801a2aa55e4cee0ebc/e2e55369a3609becd6fa255a52018d5aea2b7d821c6b3e5e2fed2a4c5dde7a45" "q-80635/selection/ma-v1/2bc5b43f97a36b6fcd498f206a97013213a453803a5165801a2aa55e4cee0ebc/8d49f8b8ae4fff1518319fc821a7af14d82ab314bb75c6b7eca6003c0f999ae7"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-80635"] :question/problem "Let $B={{b}_{1},{b}_{2}}$ be a basis of ${R}^{2}$ and $[x]_{B}=[\\begin{aligned}2 \\\\ -3\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C={{c}_{1},{c}_{2}},$ where ${c}_{1}={b}_{1}-2{b}_{2}$ and ${c}_{2}={b}_{1}+{b}_{2}?$" :question/worked-solution "We are given that\n\n$$\n{\\begin{aligned}{c}_{1}={b}_{1}-2{b}_{2} \\\\ {c}_{2}={b}_{1}+{b}_{2}.\\end{aligned}\n$$\n\nFirst, we express the $b$'s in terms of $c$'s. Multiplying the second equation by $2$ and adding the equations, we get \n\n$$\n{c}_{1}+2{c}_{2}=3{b}_{1}\\,⟹\\,{b}_{1}=\\frac{1}{3}{c}_{1}+\\frac{2}{3}{c}_{2}.\n$$\n\nSubstituting this into the first equation, we obtain\n\n$$\n{c}_{1}=(\\frac{1}{3}{c}_{1}+\\frac{2}{3}{c}_{2})-2{b}_{2}\\,⟹\\,{b}_{2}=-\\frac{1}{3}{c}_{1}+\\frac{1}{3}{c}_{2}.\n$$\n\nSince $[x]_{B}=[\\begin{aligned}2 \\\\ -3\\end{aligned}]$, we can write the vector $x$ as follows:\n\n$$\n\\begin{aligned}x & =2{b}_{1}-3{b}_{2} \\\\  & =2(\\frac{1}{3}{c}_{1}+\\frac{2}{3}{c}_{2})-3(-\\frac{1}{3}{c}_{1}+\\frac{1}{3}{c}_{2}) \\\\  & =\\frac{2}{3}{c}_{1}+\\frac{4}{3}{c}_{2}+{c}_{1}-{c}_{2} \\\\  & =\\frac{5}{3}{c}_{1}+\\frac{1}{3}{c}_{2}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}\\frac{5}{3} \\\\ \\frac{1}{3}\\end{aligned}].$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-80635/selection/ma-v1/2bc5b43f97a36b6fcd498f206a97013213a453803a5165801a2aa55e4cee0ebc"] :db/ensure [:question/validate]} {:db/id "q-80828/selection/70918b9337c08ce912a38c22da74735796203abe1816873add5de5c335a5d188" :answer/id #uuid "8f09f026-adc0-55a9-9ba4-ec38fee84c9d" :answer/type :answer.type/math :answer/value "[x]_{C}=[\\begin{aligned}\\frac{32}{3} \\\\ -5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-80828/selection/256e290984151f34da75205e1e7bc592c502957b5ee9b8824e7215b4a8fd0587" :answer/id #uuid "13b9b4f1-4124-5835-8eec-db353f1f53e9" :answer/type :answer.type/math :answer/value "[x]_{C}=[\\begin{aligned}11 \\\\ 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-80828/selection/b3d4b5d94e1e4bf52e3fa890b31255f1887d153acbc55ea7530432a8d3647499" :answer/id #uuid "053255f5-b70c-58ec-8589-1c8fcd59e3cc" :answer/type :answer.type/math :answer/value "[x]_{C}=[\\begin{aligned}-5 \\\\ \\frac{32}{3}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-80828/selection/501456c2d7dbcaa7005eadd9f94d2139d3c8a2126c2aaf11a4d982c2598d1e82" :answer/id #uuid "fe9e28cf-3012-5885-86d3-92cba39dd0ee" :answer/type :answer.type/math :answer/value "[x]_{C}=[\\begin{aligned}32 \\\\ -5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-80828/selection/3e42e3a774caa33e881bb30ff8a6587abe0331afcc197d207c81a3edc8da341e" :answer/id #uuid "d8973f23-8527-53f0-b40c-c124a02f8c07" :answer/type :answer.type/math