\\\ 8\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C={{c}_{1},{c}_{2},{c}_{3}},$ where ${c}_{1}=4{b}_{3}$, ${c}_{2}=2{b}_{1}$ and ${c}_{3}=\\frac{1}{2}{b}_{2}?$" :question/worked-solution "Since $[x]_{B}=[\\begin{aligned}2 \\\\ 2 \\\\ 8\\end{aligned}]$, we can write $x$ as follows:\n\n$$\n\\begin{aligned}x & =2{b}_{1}+2{b}_{2}+8{b}_{3} \\\\  & =8{b}_{3}+2{b}_{1}+2{b}_{2} \\\\  & =2(4{b}_{3})+2{b}_{1}+2\\cdot 2(\\frac{1}{2}{b}_{2}) \\\\  & =2{c}_{1}+{c}_{2}+4{c}_{3}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}2 \\\\ 1 \\\\ 4\\end{aligned}].$"}] [{:db/id #edb/ref 17592186365443 :knowledge-point/_questions [{:knowledge-point/id #uuid "e568b6fc-88f0-592b-a24d-e3286cfa5043" :knowledge-point/title "Writing a Vector in a Different Basis Given a Linear Relationship Between Two Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2273a3b7-7955-5e9c-8a76-20b0a45cb8d8" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}2 \\\\ -7\\end{aligned}]" :db/id #edb/ref 17592186365445} {:answer/id #uuid "0ed0e007-c62d-599d-b28b-0e3805f57417" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{1}{7} \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186365446} {:answer/id #uuid "4ea92aeb-d5ba-5ba6-8924-14d4d64b5b91" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}3 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186365447} {:answer/id #uuid "4fbab916-cd05-5434-87bf-004ec4f4c5fe" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}7 \\\\ -12\\end{aligned}]" :db/id #edb/ref 17592186365448} {:answer/id #uuid "fd42eacb-2b42-5268-816e-d659f2835cb1" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}4 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186365449}] :answer-field/correct {:answer/id #uuid "4fbab916-cd05-5434-87bf-004ec4f4c5fe" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}7 \\\\ -12\\end{aligned}]" :db/id #edb/ref 17592186365448} :answer-field/id #uuid "42e2561b-4fdf-54ae-a64b-692264302692" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186365444}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "ef9641c5-8258-5345-9a36-98913b3bf3a5" :question/math-academy-id "q-112855" :question/problem "Let $B={{b}_{1},{b}_{2}}$ be a basis of ${R}^{2}$ and $[x]_{B}=[\\begin{aligned}2 \\\\ -3\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C={{c}_{1},{c}_{2}},$ where ${c}_{1}=2{b}_{1}+3{b}_{2}$ and ${c}_{2}={b}_{1}+2{b}_{2}?$" :question/worked-solution "We are given that\n\n$$\n{\\begin{aligned}{c}_{1}=2{b}_{1}+3{b}_{2} \\\\ {c}_{2}={b}_{1}+2{b}_{2}.\\end{aligned}\n$$\n\nFirst, we express the $b$'s in terms of $c$'s. Multiplying the second equation by $-2$ and adding the equations, we get  \n\n$$\n{c}_{1}-2{c}_{2}=-{b}_{2}\\,⟹\\,{b}_{2}=-{c}_{1}+2{c}_{2}.\n$$\n\nSubstituting this into the second equation, we obtain \n\n$$\n{c}_{2}={b}_{1}+2(-{c}_{1}+2{c}_{2})\\,⟹\\,{b}_{1}=2{c}_{1}-3{c}_{2}.\n$$\n\nSince $[x]_{B}=[\\begin{aligned}2 \\\\ -3\\end{aligned}]$, we can write the vector $x$ as follows:\n\n$$\n\\begin{aligned}x & =2{b}_{1}-3{b}_{2} \\\\  & =2(2{c}_{1}-3{c}_{2})-3(-{c}_{1}+2{c}_{2}) \\\\  & =4{c}_{1}-6{c}_{2}+3{c}_{1}-6{c}_{2} \\\\  & =7{c}_{1}-12{c}_{2}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}7 \\\\ -12\\end{aligned}].$"}] [{:db/id #edb/ref 17592186120459 :knowledge-point/_questions [{:knowledge-point/id #uuid "e568b6fc-88f0-592b-a24d-e3286cfa5043" :knowledge-point/title "Writing a Vector in a Different Basis Given a Linear Relationship Between Two Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5982175a-5012-542f-900c-55b937e96307" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{5}{3} \\\\ \\frac{1}{3}\\end{aligned}]" :db/id #edb/ref 17592186365451} {:answer/id #uuid "0162cdc3-10a9-5118-af79-3a89da737ccc" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-\\frac{5}{3} \\\\ -\\frac{2}{3}\\end{aligned}]" :db/id #edb/ref 17592186365452} {:answer/id #uuid "cf7d482f-7da3-544a-a21f-b7da354b5d25" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{5}{3} \\\\ -\\frac{4}{3}\\end{aligned}]" :db/id #edb/ref 17592186365453} {:answer/id #uuid "77628b49-fdff-5559-b373-e953e105fa03" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{1}{3} \\\\ -\\frac{2}{3}\\end{aligned}]" :db/id #edb/ref 17592186365454} {:answer/id #uuid "1f4602a8-5353-5cf1-8459-e0b16008753c" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-\\frac{2}{3} \\\\ \\frac{5}{3}\\end{aligned}]" :db/id #edb/ref 17592186365455}] :answer-field/correct {:answer/id #uuid "5982175a-5012-542f-900c-55b937e96307" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{5}{3} \\\\ \\frac{1}{3}\\end{aligned}]" :db/id #edb/ref 17592186365451} :answer-field/id #uuid "aaa6176c-45c5-57df-a74d-bf2237118f27" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186365450}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "a2b67a92-2b23-5739-813e-476de8609802" :question/math-academy-id "q-80635" :question/problem "Let $B={{b}_{1},{b}_{2}}$ be a basis of ${R}^{2}$ and $[x]_{B}=[\\begin{aligned}2 \\\\ -3\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C={{c}_{1},{c}_{2}},$ where ${c}_{1}={b}_{1}-2{b}_{2}$ and ${c}_{2}={b}_{1}+{b}_{2}?$" :question/worked-solution "We are given that\n\n$$\n{\\begin{aligned}{c}_{1}={b}_{1}-2{b}_{2} \\\\ {c}_{2}={b}_{1}+{b}_{2}.\\end{aligned}\n$$\n\nFirst, we express the $b$'s in terms of $c$'s. Multiplying the second equation by $2$ and adding the equations, we get \n\n$$\n{c}_{1}+2{c}_{2}=3{b}_{1}\\,⟹\\,{b}_{1}=\\frac{1}{3}{c}_{1}+\\frac{2}{3}{c}_{2}.\n$$\n\nSubstituting this into the first equation, we obtain\n\n$$\n{c}_{1}=(\\frac{1}{3}{c}_{1}+\\frac{2}{3}{c}_{2})-2{b}_{2}\\,⟹\\,{b}_{2}=-\\frac{1}{3}{c}_{1}+\\frac{1}{3}{c}_{2}.\n$$\n\nSince $[x]_{B}=[\\begin{aligned}2 \\\\ -3\\end{aligned}]$, we can write the vector $x$ as follows:\n\n$$\n\\begin{aligned}x & =2{b}_{1}-3{b}_{2} \\\\  & =2(\\frac{1}{3}{c}_{1}+\\frac{2}{3}{c}_{2})-3(-\\frac{1}{3}{c}_{1}+\\frac{1}{3}{c}_{2}) \\\\  & =\\frac{2}{3}{c}_{1}+\\frac{4}{3}{c}_{2}+{c}_{1}-{c}_{2} \\\\  & =\\frac{5}{3}{c}_{1}+\\frac{1}{3}{c}_{2}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}\\frac{5}{3} \\\\ \\frac{1}{3}\\end{aligned}].$"}] [{:db/id #edb/ref 17592186365456 :knowledge-point/_questions [{:knowledge-point/id #uuid "e568b6fc-88f0-592b-a24d-e3286cfa5043" :knowledge-point/title "Writing a Vector in a Different Basis Given a Linear Relationship Between Two Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13b9b4f1-4124-5835-8eec-db353f1f53e9" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}11 \\\\ 5\\end{aligned}]" :db/id #edb/ref 17592186365458} {:answer/id #uuid "d8973f23-8527-53f0-b40c-c124a02f8c07" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{31}{3} \\\\ -5\\end{aligned}]" :db/id #edb/ref 17592186365459} {:answer/id #uuid "fe9e28cf-3012-5885-86d3-92cba39dd0ee" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}32 \\\\ -5\\end{aligned}]" :db/id #edb/ref 17592186365460} {:answer/id #uuid "8f09f026-adc0-55a9-9ba4-ec38fee84c9d" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{32}{3} \\\\ -5\\end{aligned}]" :db/id #edb/ref 17592186365461} {:answer/id #uuid "053255f5-b70c-58ec-8589-1c8fcd59e3cc" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-5 \\\\ \\frac{32}{3}\\end{aligned}]" :db/id #edb/ref 17592186365462}] :answer-field/correct {:answer/id #uuid "8f09f026-adc0-55a9-9ba4-ec38fee84c9d" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{32}{3} \\\\ -5\\end{aligned}]" :db/id #edb/ref 17592186365461} :answer-field/id #uuid "24d35902-2be9-5ab7-937b-b66eb53abdef" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186365457}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "7a380edb-41ae-5d3a-bf28-8055a0d50a42" :question/math-academy-id "q-80828" :question/problem "Let $B={{b}_{1},{b}_{2}}$ be a basis of ${R}^{2}$ and $[x]_{B}=[\\begin{aligned}-5 \\\\ 2\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C={{c}_{1},{c}_{2}},$ where ${c}_{1}=3{b}_{2}$ and ${c}_{2}={b}_{1}+6{b}_{2}?$" :question/worked-solution "We are given that\n\n$$\n{\\begin{aligned}{c}_{1}=3{b}_{2} \\\\ {c}_{2}={b}_{1}+6{b}_{2}.\\end{aligned}\n$$\n\nFirst, we express the $b$'s in terms of $c$'s. From the first equation, we get \n\n$$\n{b}_{2}=\\frac{1}{3}{c}_{1}.\n$$\n\nSubstituting this into the second equation, we obtain\n\n$$\n{c}_{2}={b}_{1}+6(\\frac{1}{3}{c}_{1})\\,⟹\\,{b}_{1}={c}_{2}-2{c}_{1}.\n$$\n\nSince $[x]_{B}=[\\begin{aligned}-5 \\\\ 2\\end{aligned}]$, we can write the vector $x$ as follows:\n\n$$\n\\begin{aligned}x & =-5{b}_{1}+2{b}_{2} \\\\  & =-5({c}_{2}-2{c}_{1})+2(\\frac{1}{3}{c}_{1}) \\\\  & =-5{c}_{2}+10{c}_{1}+\\frac{2}{3}{c}_{1} \\\\  & =\\frac{32}{3}{c}_{1}-5{c}_{2}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}\\frac{32}{3} \\\\ -5\\end{aligned}].$"}] [{:db/id #edb/ref 17592186365463 :knowledge-point/_questions [{:knowledge-point/id #uuid "df96d21a-e1bc-5a9b-b528-d6e7b30d8451" :knowledge-point/title "Writing a Three-Dimensional Vector in a Different Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8dd5c4f8-f187-575a-bd80-4be491babeac" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-8 \\\\ -3 \\\\ 5\\end{aligned}]" :db/id #edb/ref 17592186365465} {:answer/id #uuid "3cbad198-faeb-5e5f-a1e2-4b630d9785db" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}5 \\\\ 4 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186365466} {:answer/id #uuid "0bf77210-a4cc-59d0-b65d-35021f44befd" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}3 \\\\ -6 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186365467} {:answer/id #uuid "f6f2cb71-daa8-555b-ab4f-7cd2976d5fcd" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-5 \\\\ 8 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186365468} {:answer/id #uuid "bce2b1c3-5547-5855-902f-6dbd0087d002" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-3 \\\\ 5 \\\\ -8\\end{aligned}]" :db/id #edb/ref 17592186365469}] :answer-field/correct {:answer/id #uuid "8dd5c4f8-f187-575a-bd80-4be491babeac" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-8 \\\\ -3 \\\\ 5\\end{aligned}]" :db/id #edb/ref 17592186365465} :answer-field/id #uuid "646fac00-95ca-5e24-a043-13e5f70fc5ec" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186365464}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0c50d71d-4c9b-56e2-bd55-7c3b84704bd1" :question/math-academy-id "q-81228" :question/problem "Let $B={{b}_{1},{b}_{2},{b}_{3}}$ be a basis of ${R}^{3}$ and $[x]_{B}=[\\begin{aligned}15 \\\\ -24 \\\\ 18\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C={{c}_{1},{c}_{2},{c}_{3}},$ where ${c}_{1}=3{b}_{2}$, ${c}_{2}=-6{b}_{3}$ and ${c}_{3}=3{b}_{1}?$" :question/worked-solution "Since $[x]_{B}=[\\begin{aligned}15 \\\\ -24 \\\\ 18\\end{aligned}]$, we can write $x$ as follows:\n\n$$\n\\begin{aligned}x & =15{b}_{1}-24{b}_{2}+18{b}_{3} \\\\  & =-24{b}_{2}+18{b}_{3}+15{b}_{1} \\\\  & =-8(3{b}_{2})-3(-6{b}_{3})+5(3{b}_{1}) \\\\  & =-8{c}_{1}-3{c}_{2}+5{c}_{3}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}-8 \\\\ -3 \\\\ 5\\end{aligned}].$"}]}
