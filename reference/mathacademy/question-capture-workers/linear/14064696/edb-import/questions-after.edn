#{[{:db/id #edb/ref 17592186348718 :knowledge-point/_questions [{:knowledge-point/id #uuid "0448a1c0-e35b-56a1-aaf3-6e7a33962ade" :knowledge-point/title "Listing the Elements of a Set Defined Over a Finite or Infinite Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2486233a-02dc-5099-80c1-09278a874515" :answer/type {:db/ident :answer.type/math} :answer/value "{\\frac{1}{5},\\frac{1}{6},\\frac{1}{7},\\frac{1}{8}}" :db/id #edb/ref 17592186348720} {:answer/id #uuid "c6441fb7-9068-5b48-9bbd-e9441e1e9674" :answer/type {:db/ident :answer.type/math} :answer/value "{\\frac{1}{5},\\frac{1}{6},\\frac{1}{12},\\frac{1}{15},…}" :db/id #edb/ref 17592186348721} {:answer/id #uuid "1b7a3b10-35e2-5294-9a54-3e356cb8fc86" :answer/type {:db/ident :answer.type/math} :answer/value "{\\frac{1}{5},\\frac{1}{6},\\frac{1}{8},\\frac{1}{9},…}" :db/id #edb/ref 17592186348722} {:answer/id #uuid "422cd870-a6a9-574b-962f-861018eb3301" :answer/type {:db/ident :answer.type/math} :answer/value "{\\frac{1}{5},\\frac{1}{6},\\frac{1}{7},\\frac{1}{8},…}" :db/id #edb/ref 17592186348723} {:answer/id #uuid "8f716b26-fbf4-500e-9ade-b24d8f202811" :answer/type {:db/ident :answer.type/math} :answer/value "{\\frac{1}{5},\\frac{1}{6},\\frac{1}{4},\\frac{1}{3},…}" :db/id #edb/ref 17592186348724}] :answer-field/correct {:answer/id #uuid "422cd870-a6a9-574b-962f-861018eb3301" :answer/type {:db/ident :answer.type/math} :answer/value "{\\frac{1}{5},\\frac{1}{6},\\frac{1}{7},\\frac{1}{8},…}" :db/id #edb/ref 17592186348723} :answer-field/id #uuid "746d79e3-39b9-5953-85a1-cd4c2b384187" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186348719}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c97629b2-2fa6-5f92-8dfd-95ee2f3256e5" :question/math-academy-id "q-180752" :question/problem "Consider the set $A,$ defined as\n\n$$\nA={\\frac{1}{n+4}:n\\in N}.\n$$\n\nWhich of the following sets is equivalent to $A?$" :question/worked-solution "The elements of $A$ are all the terms of the sequence ${a}_{n},$ given by\n\n$$\n{a}_{n}=\\frac{1}{n+4},\\,n\\in N.\n$$\n\nLet's write down the first few terms of our sequence:\n\n$$\n\\begin{aligned}{a}_{1} & =\\frac{1}{1+4}=\\frac{1}{5} \\\\ {a}_{2} & =\\frac{1}{2+4}=\\frac{1}{6} \\\\ {a}_{3} & =\\frac{1}{3+4}=\\frac{1}{7} \\\\ {a}_{4} & =\\frac{1}{4+4}=\\frac{1}{8} \\\\  & ⋮\\end{aligned}\n$$\n\nTherefore, \n\n$$\nA={\\frac{1}{5},\\frac{1}{6},\\frac{1}{7},\\frac{1}{8},…}.\n$$"}] [{:db/id #edb/ref 17592186348725 :knowledge-point/_questions [{:knowledge-point/id #uuid "4e28c42e-0d82-5e82-a130-a2cb72fb96d1" :knowledge-point/title "Listing the Elements of a Set Defined Using a Recursive Sequence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6eeb1f1c-8e48-5fb0-bfef-4bef8834736e" :answer/type {:db/ident :answer.type/math} :answer/value "{0,-5,-10,-25,-30,…}" :db/id #edb/ref 17592186348727} {:answer/id #uuid "9ff35a78-edf9-5f61-b6e4-0cd99eea48d1" :answer/type {:db/ident :answer.type/math} :answer/value "{0,-5,-10,-15,-45,…}" :db/id #edb/ref 17592186348728} {:answer/id #uuid "a10c3a1c-2d6a-5b27-9166-20680fde012e" :answer/type {:db/ident :answer.type/math} :answer/value "{0,-5,-10,-25,-50,…}" :db/id #edb/ref 17592186348729} {:answer/id #uuid "77cb21a7-c7ea-5242-a783-6ff641f2eddb" :answer/type {:db/ident :answer.type/math} :answer/value "{0,-5,-10,-20,-30,…}" :db/id #edb/ref 17592186348730} {:answer/id #uuid "b7799269-2fa2-5041-8be1-ce42bbacbe87" :answer/type {:db/ident :answer.type/math} :answer/value "{0,-5,-10,-15,-20,…}" :db/id #edb/ref 17592186348731}] :answer-field/correct {:answer/id #uuid "b7799269-2fa2-5041-8be1-ce42bbacbe87" :answer/type {:db/ident :answer.type/math} :answer/value "{0,-5,-10,-15,-20,…}" :db/id #edb/ref 17592186348731} :answer-field/id #uuid "d9621992-ee48-56d0-a881-5dc9e1ddb1f9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186348726}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9bef6129-9277-5ecc-b853-dc28eecb0db2" :question/math-academy-id "q-181707" :question/problem "Consider the set $A,$ defined as\n\n$$\nA={{a}_{n}\\,:\\,{a}_{n+1}={a}_{n}-5\\,,\\,{a}_{1}=0,\\,n\\in N}.\n$$\n\nWhich of the following sets is equivalent to $A?$" :question/worked-solution "The elements of $A$ are all the terms of the *recursive* sequence ${a}_{n},$ given by\n\n$$\n{a}_{n+1}={a}_{n}-5,\\,{a}_{1}=0,\\,n\\in N.\n$$\n\nLet's write down the first few terms of our sequence:\n\n$$\n\\begin{aligned}{a}_{1} & =0 \\\\ {a}_{2} & ={a}_{1}-5 \\\\  & =0-5 \\\\  & =-5 \\\\ {a}_{3} & ={a}_{2}-5 \\\\  & =-5-5 \\\\  & =-10 \\\\ {a}_{4} & ={a}_{3}-5 \\\\  & =-10-5 \\\\  & =-15 \\\\ {a}_{5} & ={a}_{4}-5 \\\\  & =-15-5 \\\\  & =-20 \\\\  & ⋮\\end{aligned}\n$$\n\nTherefore, \n\n$$\nA={0,-5,-10,-15,-20,…}.\n$$"}] [{:db/id #edb/ref 17592186348732 :knowledge-point/_questions [{:knowledge-point/id #uuid "4e28c42e-0d82-5e82-a130-a2cb72fb96d1" :knowledge-point/title "Listing the Elements of a Set Defined Using a Recursive Sequence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "303485f7-496c-5c29-9788-da068b132009" :answer/type {:db/ident :answer.type/math} :answer/value "{0,3,6,7,11,…}" :db/id #edb/ref 17592186348734} {:answer/id #uuid "df4a4e7a-def1-5fd5-862a-a73f02b7ee06" :answer/type {:db/ident :answer.type/math} :answer/value "{0,3,6,15,21,…}" :db/id #edb/ref 17592186348735} {:answer/id #uuid "300f0446-ce8e-5545-92f4-9a938ca05908" :answer/type {:db/ident :answer.type/math} :answer/value "{0,3,6,9,18,…}" :db/id #edb/ref 17592186348736} {:answer/id #uuid "43b4cb7b-1062-5865-b72b-e8329e92c85d" :answer/type {:db/ident :answer.type/math} :answer/value "{0,3,6,9,15,…}" :db/id #edb/ref 17592186348737} {:answer/id #uuid "d43f91c5-3272-54d5-941c-7e205a70c013" :answer/type {:db/ident :answer.type/math} :answer/value "{0,3,6,12,18,…}" :db/id #edb/ref 17592186348738}] :answer-field/correct {:answer/id #uuid "43b4cb7b-1062-5865-b72b-e8329e92c85d" :answer/type {:db/ident :answer.type/math} :answer/value "{0,3,6,9,15,…}" :db/id #edb/ref 17592186348737} :answer-field/id #uuid "37ea51b8-6d68-57fc-997b-0322aac04e3a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186348733}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "063c6e59-91ab-5b23-8d93-b847593363af" :question/math-academy-id "q-181710" :question/problem "Consider the set $B,$ defined as\n\n$$\nB={{b}_{n}\\,:\\,{b}_{n+2}={b}_{n+1}+{b}_{n}\\,,\\,{b}_{1}=0,\\,{b}_{2}=3,\\,n\\in N}.\n$$\n\nWhich of the following sets is equivalent to $B?$" :question/worked-solution "The elements of $B$ are all the terms of the *recursive* sequence ${b}_{n},$ given by\n\n$$\n{b}_{n+2}={b}_{n+1}+{b}_{n},\\,{b}_{1}=0,\\,{b}_{2}=3,\\,n\\in N.\n$$\n\nNotice that this is a Fibonacci sequence with ${b}_{1}=0$ and ${b}_{2}=3.$\n\nLet's write down the first few terms of our sequence:\n\n$$\n\\begin{aligned}{b}_{1} & =0 \\\\ {b}_{2} & =3 \\\\ {b}_{3} & ={b}_{2}+{b}_{1} \\\\  & =3+0 \\\\  & =3 \\\\ {b}_{4} & ={b}_{3}+{b}_{2} \\\\  & =3+3 \\\\  & =6 \\\\ {b}_{5} & ={b}_{4}+{b}_{3} \\\\  & =6+3 \\\\  & =9 \\\\ {b}_{6} & ={b}_{5}+{b}_{4} \\\\  & =9+6 \\\\  & =15 \\\\  & ⋮\\end{aligned}\n$$\n\nTherefore, \n\n$$\nB={0,3,3,6,9,15,…}={0,3,6,9,15,…}.\n$$"}] [{:db/id #edb/ref 17592186348739 :knowledge-point/_questions [{:knowledge-point/id #uuid "4e28c42e-0d82-5e82-a130-a2cb72fb96d1" :knowledge-point/title "Listing the Elements of a Set Defined Using a Recursive Sequence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "104edcf5-e7a0-5791-81c3-2efe81d7b41e" :answer/type {:db/ident :answer.type/math} :answer/value "{1,3,5,8,9,…}" :db/id #edb/ref 17592186348741} {:answer/id #uuid "db2a0304-4142-5f0e-b45e-b123987bca33" :answer/type {:db/ident :answer.type/math} :answer/value "{1,2,3,4,5,…}" :db/id #edb/ref 17592186348742} {:answer/id #uuid "885bed53-956f-5d2e-8b8b-521fffa02756" :answer/type {:db/ident :answer.type/math} :answer/value "{1,3,5,7,9,…}" :db/id #edb/ref 17592186348743} {:answer/id #uuid "f3e50712-59a5-5818-a797-afc5d355f5a4" :answer/type {:db/ident :answer.type/math} :answer/value "{1,3,4,5,9,…}" :db/id #edb/ref 17592186348744} {:answer/id #uuid "a39b7604-fe0d-59ef-8d93-2d67715c9ca2" :answer/type {:db/ident :answer.type/math} :answer/value "{0,1,2,3,4,…}" :db/id #edb/ref 17592186348745}] :answer-field/correct {:answer/id #uuid "f3e50712-59a5-5818-a797-afc5d355f5a4" :answer/type {:db/ident :answer.type/math} :answer/value "{1,3,4,5,9,…}" :db/id #edb/ref 17592186348744} :answer-field/id #uuid "d5ca3d97-b72a-534a-a62d-951dd80d442d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186348740}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "848d85e6-ddba-5554-b46d-0822f824fa7d" :question/math-academy-id "q-181712" :question/problem "Consider the set $B,$ defined as\n\n$$\nB={{b}_{n}\\,:\\,{b}_{n+2}={b}_{n+1}+{b}_{n}\\,,\\,{b}_{1}=3,\\,{b}_{2}=1,\\,n\\in N}.\n$$\n\nWhich of the following sets is equivalent to $B?$" :question/worked-solution "The elements of $B$ are all the terms of the *recursive* sequence ${b}_{n},$ given by\n\n$$\n{b}_{n+2}={b}_{n+1}+{b}_{n},\\,{b}_{1}=3,\\,{b}_{2}=1,\\,n\\in N.\n$$\n\nLet's write down the first few terms of our sequence:\n\n$$\n\\begin{aligned}{b}_{1} & =3 \\\\ {b}_{2} & =1 \\\\ {b}_{3} & ={b}_{2}+{b}_{1} \\\\  & =1+3 \\\\  & =4 \\\\ {b}_{4} & ={b}_{3}+{b}_{2} \\\\  & =4+1 \\\\  & =5 \\\\ {b}_{5} & ={b}_{4}+{b}_{3} \\\\  & =5+4 \\\\  & =9 \\\\  & ⋮\\end{aligned}\n$$\n\nTherefore, \n\n$$\nB={3,1,4,5,9,…}={1,3,4,5,9,…}.\n$$"}] [{:db/id #edb/ref 17592186348746 :knowledge-point/_questions [{:knowledge-point/id #uuid "0448a1c0-e35b-56a1-aaf3-6e7a33962ade" :knowledge-point/title "Listing the Elements of a Set Defined Over a Finite or Infinite Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09345243-2e5a-5b31-a386-2ca6ca2011ce" :answer/type {:db/ident :answer.type/math} :answer/value "{-12,-5,4,5,12}" :db/id #edb/ref 17592186348748} {:answer/id #uuid "298f61a9-bac3-5949-8ebc-edb7ea08a071" :answer/type {:db/ident :answer.type/math} :answer/value "{-12,-5,-4,-3,-2}" :db/id #edb/ref 17592186348749} {:answer/id #uuid "9def7892-21e1-5bcd-87cb-af80b9ca88f6" :answer/type {:db/ident :answer.type/math} :answer/value "{-12,-5,0,1,2}" :db/id #edb/ref 17592186348750} {:answer/id #uuid "6e732c4f-21f8-5b4a-bf69-d48493831d5b" :answer/type {:db/ident :answer.type/math} :answer/value "{-12,-5,-4,-3,4}" :db/id #edb/ref 17592186348751} {:answer/id #uuid "cc36e341-0060-5b62-9fd3-a4bd82edbfcb" :answer/type {:db/ident :answer.type/math} :answer/value "{-12,-5,-4,3,6}" :db/id #edb/ref 17592186348752}] :answer-field/correct {:answer/id #uuid "6e732c4f-21f8-5b4a-bf69-d48493831d5b" :answer/type {:db/ident :answer.type/math} :answer/value "{-12,-5,-4,-3,4}" :db/id #edb/ref 17592186348751} :answer-field/id #uuid "7f2df892-0858-5924-b65d-b9294a035c90" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186348747}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0fba0963-60dd-5faf-bd87-a5a5c82c372c" :question/math-academy-id "q-183520" :question/problem "Consider the set $B,$ defined as\n\n$$\nB={{n}^{3}-4:n\\in Z,\\,-2\\le n\\le 2}.\n$$\n\nWhich of the following sets is equivalent to $B?$" :question/worked-solution "The condition after the \"$:$\" symbol\n\n$$\nn\\in Z,\\,n\\le 4\n$$\n\nstates that $n$ can be any integer number that satisfies the inequality $-2\\le n\\le 2.$ In other words, \n\n$$\nn={-2,-1,0,1,2}.\n$$\n\nTherefore, the elements of $B$ are all the terms of the sequence ${b}_{n},$ given by\n\n$$\n{b}_{n}={n}^{3}-4,\\,n\\in {-2,-1,0,1,2}.\n$$\n\nLet's write down all the terms of our sequence:\n\n$$\n\\begin{aligned}{b}_{-2} & =(-2)^{3}-4=-8-4=-12 \\\\ {b}_{-1} & =(-1)^{3}-4=-1-4=-5 \\\\ {b}_{0} & ={0}^{3}-4=0-4=-4 \\\\ {b}_{1} & ={1}^{3}-4=1-4=-3 \\\\ {b}_{2} & ={2}^{3}-4=8-4=4\\end{aligned}\n$$\n\nTherefore, \n\n$$\nB={-12,-5,-4,-3,4}.\n$$"}]}
