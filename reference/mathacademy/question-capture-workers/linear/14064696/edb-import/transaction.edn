[{:db/id "q-180752/selection/844a8c8fb298f49bade82d77aa6bb0f69c266ee1577ccf9025c69dfcc0916270" :answer/id #uuid "422cd870-a6a9-574b-962f-861018eb3301" :answer/type :answer.type/math :answer/value "{\\frac{1}{5},\\frac{1}{6},\\frac{1}{7},\\frac{1}{8},…}" :db/ensure [:answer/validate]} {:db/id "q-180752/selection/ccf67fd4145c18d72c6bb288239aafd8e5fb128c69d41705365412256cf457ac" :answer/id #uuid "8f716b26-fbf4-500e-9ade-b24d8f202811" :answer/type :answer.type/math :answer/value "{\\frac{1}{5},\\frac{1}{6},\\frac{1}{4},\\frac{1}{3},…}" :db/ensure [:answer/validate]} {:db/id "q-180752/selection/829a01ecf84ca5f4fa3be2cdfd830ef854a847ec5beab9abbe235cc2ba27289a" :answer/id #uuid "1b7a3b10-35e2-5294-9a54-3e356cb8fc86" :answer/type :answer.type/math :answer/value "{\\frac{1}{5},\\frac{1}{6},\\frac{1}{8},\\frac{1}{9},…}" :db/ensure [:answer/validate]} {:db/id "q-180752/selection/0af47c2dfdf3240c7b2a28294ab563f63992583d8e14573297b0d32c7a3d05d6" :answer/id #uuid "2486233a-02dc-5099-80c1-09278a874515" :answer/type :answer.type/math :answer/value "{\\frac{1}{5},\\frac{1}{6},\\frac{1}{7},\\frac{1}{8}}" :db/ensure [:answer/validate]} {:db/id "q-180752/selection/4f0214461f1c18fbd20424362ab7a7b0312a0ccfb08f7b3fd8beb07aac0056da" :answer/id #uuid "c6441fb7-9068-5b48-9bbd-e9441e1e9674" :answer/type :answer.type/math :answer/value "{\\frac{1}{5},\\frac{1}{6},\\frac{1}{12},\\frac{1}{15},…}" :db/ensure [:answer/validate]} {:db/id "q-180752/selection" :answer-field/id #uuid "746d79e3-39b9-5953-85a1-cd4c2b384187" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-180752/selection/844a8c8fb298f49bade82d77aa6bb0f69c266ee1577ccf9025c69dfcc0916270" :answer-field/choices ["q-180752/selection/844a8c8fb298f49bade82d77aa6bb0f69c266ee1577ccf9025c69dfcc0916270" "q-180752/selection/ccf67fd4145c18d72c6bb288239aafd8e5fb128c69d41705365412256cf457ac" "q-180752/selection/829a01ecf84ca5f4fa3be2cdfd830ef854a847ec5beab9abbe235cc2ba27289a" "q-180752/selection/0af47c2dfdf3240c7b2a28294ab563f63992583d8e14573297b0d32c7a3d05d6" "q-180752/selection/4f0214461f1c18fbd20424362ab7a7b0312a0ccfb08f7b3fd8beb07aac0056da"] :db/ensure [:answer-field/validate]} {:db/id "q-180752" :question/id #uuid "c97629b2-2fa6-5f92-8dfd-95ee2f3256e5" :question/math-academy-id "q-180752" :question/problem "Consider the set $A,$ defined as\n\n$$\nA={\\frac{1}{n+4}:n\\in N}.\n$$\n\nWhich of the following sets is equivalent to $A?$" :question/worked-solution "The elements of $A$ are all the terms of the sequence ${a}_{n},$ given by\n\n$$\n{a}_{n}=\\frac{1}{n+4},\\,n\\in N.\n$$\n\nLet's write down the first few terms of our sequence:\n\n$$\n\\begin{aligned}{a}_{1} & =\\frac{1}{1+4}=\\frac{1}{5} \\\\ {a}_{2} & =\\frac{1}{2+4}=\\frac{1}{6} \\\\ {a}_{3} & =\\frac{1}{3+4}=\\frac{1}{7} \\\\ {a}_{4} & =\\frac{1}{4+4}=\\frac{1}{8} \\\\  & ⋮\\end{aligned}\n$$\n\nTherefore, \n\n$$\nA={\\frac{1}{5},\\frac{1}{6},\\frac{1}{7},\\frac{1}{8},…}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-180752/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0448a1c0-e35b-56a1-aaf3-6e7a33962ade"] :knowledge-point/questions ["q-180752"] :db/ensure [:knowledge-point/validate]} {:db/id "q-181707/selection/aea867a6a984d946dea9456360f79bf10042d3633871209b07e82608832757b1" :answer/id #uuid "b7799269-2fa2-5041-8be1-ce42bbacbe87" :answer/type :answer.type/math :answer/value "{0,-5,-10,-15,-20,…}" :db/ensure [:answer/validate]} {:db/id "q-181707/selection/4e951f699862796e4487b6804d4f4e6c350bf1719216359f3623dcc600d9f8eb" :answer/id #uuid "9ff35a78-edf9-5f61-b6e4-0cd99eea48d1" :answer/type :answer.type/math :answer/value "{0,-5,-10,-15,-45,…}" :db/ensure [:answer/validate]} {:db/id "q-181707/selection/1afff3a3d14f9967c98ca9069c54a39e583e3a787b472d2b6469c7e4dd9776f6" :answer/id #uuid "6eeb1f1c-8e48-5fb0-bfef-4bef8834736e" :answer/type :answer.type/math :answer/value "{0,-5,-10,-25,-30,…}" :db/ensure [:answer/validate]} {:db/id "q-181707/selection/72186cf457a8c6b6abe044219860b4038a8567e8898f7d43d82c20075d6753e4" :answer/id #uuid "77cb21a7-c7ea-5242-a783-6ff641f2eddb" :answer/type :answer.type/math :answer/value "{0,-5,-10,-20,-30,…}" :db/ensure [:answer/validate]} {:db/id "q-181707/selection/6cfaa6373ca14e86173ffb4829a44cccee7b89e85d43cc92f7757d8d5af1a2d2" :answer/id #uuid "a10c3a1c-2d6a-5b27-9166-20680fde012e" :answer/type :answer.type/math :answer/value "{0,-5,-10,-25,-50,…}" :db/ensure [:answer/validate]} {:db/id "q-181707/selection" :answer-field/id #uuid "d9621992-ee48-56d0-a881-5dc9e1ddb1f9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-181707/selection/aea867a6a984d946dea9456360f79bf10042d3633871209b07e82608832757b1" :answer-field/choices ["q-181707/selection/aea867a6a984d946dea9456360f79bf10042d3633871209b07e82608832757b1" "q-181707/selection/4e951f699862796e4487b6804d4f4e6c350bf1719216359f3623dcc600d9f8eb" "q-181707/selection/1afff3a3d14f9967c98ca9069c54a39e583e3a787b472d2b6469c7e4dd9776f6" "q-181707/selection/72186cf457a8c6b6abe044219860b4038a8567e8898f7d43d82c20075d6753e4" "q-181707/selection/6cfaa6373ca14e86173ffb4829a44cccee7b89e85d43cc92f7757d8d5af1a2d2"] :db/ensure [:answer-field/validate]} {:db/id "q-181707" :question/id #uuid "9bef6129-9277-5ecc-b853-dc28eecb0db2" :question/math-academy-id "q-181707" :question/problem "Consider the set $A,$ defined as\n\n$$\nA={{a}_{n}\\,:\\,{a}_{n+1}={a}_{n}-5\\,,\\,{a}_{1}=0,\\,n\\in N}.\n$$\n\nWhich of the following sets is equivalent to $A?$" :question/worked-solution "The elements of $A$ are all the terms of the *recursive* sequence ${a}_{n},$ given by\n\n$$\n{a}_{n+1}={a}_{n}-5,\\,{a}_{1}=0,\\,n\\in N.\n$$\n\nLet's write down the first few terms of our sequence:\n\n$$\n\\begin{aligned}{a}_{1} & =0 \\\\ {a}_{2} & ={a}_{1}-5 \\\\  & =0-5 \\\\  & =-5 \\\\ {a}_{3} & ={a}_{2}-5 \\\\  & =-5-5 \\\\  & =-10 \\\\ {a}_{4} & ={a}_{3}-5 \\\\  & =-10-5 \\\\  & =-15 \\\\ {a}_{5} & ={a}_{4}-5 \\\\  & =-15-5 \\\\  & =-20 \\\\  & ⋮\\end{aligned}\n$$\n\nTherefore, \n\n$$\nA={0,-5,-10,-15,-20,…}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-181707/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4e28c42e-0d82-5e82-a130-a2cb72fb96d1"] :knowledge-point/questions ["q-181707"] :db/ensure [:knowledge-point/validate]} {:db/id "q-181710/selection/6407e6110925c2d074141d05eef8ae27281e9c6aba2ca13e987abd19fed6cfec" :answer/id #uuid "300f0446-ce8e-5545-92f4-9a938ca05908" :answer/type :answer.type/math :answer/value "{0,3,6,9,18,…}" :db/ensure [:answer/validate]} {:db/id "q-181710/selection/659a378f3568987d8fc51ef9ae11c008b8291262e1d3542108ddaa654733a1de" :answer/id #uuid "43b4cb7b-1062-5865-b72b-e8329e92c85d" :answer/type :answer.type/math :answer/value "{0,3,6,9,15,…}" :db/ensure [:answer/validate]} {:db/id "q-181710/selection/542cef2c5500dec198b393f53b31da5b56cc266c84af2263c7c6cf3c54432acd" :answer/id #uuid "303485f7-496c-5c29-9788-da068b132009" :answer/type :answer.type/math :answer/value "{0,3,6,7,11,…}" :db/ensure [:answer/validate]} {:db/id "q-181710/selection/5f18c615aabc53eade9cefab4bae8fc5702d8aebb30b5388a4fd968eb6ef7982" :answer/id #uuid "df4a4e7a-def1-5fd5-862a-a73f02b7ee06" :answer/type :answer.type/math :answer/value "{0,3,6,15,21,…}" :db/ensure [:answer/validate]} {:db/id "q-181710/selection/d226d66ee5fbf714b262497c302e6df6ff32013a5dc96d9d62a6117c07b593f2" :answer/id #uuid "d43f91c5-3272-54d5-941c-7e205a70c013" :answer/type :answer.type/math :answer/value "{0,3,6,12,18,…}" :db/ensure [:answer/validate]} {:db/id "q-181710/selection" :answer-field/id #uuid "37ea51b8-6d68-57fc-997b-0322aac04e3a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-181710/selection/659a378f3568987d8fc51ef9ae11c008b8291262e1d3542108ddaa654733a1de" :answer-field/choices ["q-181710/selection/6407e6110925c2d074141d05eef8ae27281e9c6aba2ca13e987abd19fed6cfec" "q-181710/selection/659a378f3568987d8fc51ef9ae11c008b8291262e1d3542108ddaa654733a1de" "q-181710/selection/542cef2c5500dec198b393f53b31da5b56cc266c84af2263c7c6cf3c54432acd" "q-181710/selection/5f18c615aabc53eade9cefab4bae8fc5702d8aebb30b5388a4fd968eb6ef7982" "q-181710/selection/d226d66ee5fbf714b262497c302e6df6ff32013a5dc96d9d62a6117c07b593f2"] :db/ensure [:answer-field/validate]} {:db/id "q-181710" :question/id #uuid "063c6e59-91ab-5b23-8d93-b847593363af" :question/math-academy-id "q-181710" :question/problem "Consider the set $B,$ defined as\n\n$$\nB={{b}_{n}\\,:\\,{b}_{n+2}={b}_{n+1}+{b}_{n}\\,,\\,{b}_{1}=0,\\,{b}_{2}=3,\\,n\\in N}.\n$$\n\nWhich of the following sets is equivalent to $B?$" :question/worked-solution "The elements of $B$ are all the terms of the *recursive* sequence ${b}_{n},$ given by\n\n$$\n{b}_{n+2}={b}_{n+1}+{b}_{n},\\,{b}_{1}=0,\\,{b}_{2}=3,\\,n\\in N.\n$$\n\nNotice that this is a Fibonacci sequence with ${b}_{1}=0$ and ${b}_{2}=3.$\n\nLet's write down the first few terms of our sequence:\n\n$$\n\\begin{aligned}{b}_{1} & =0 \\\\ {b}_{2} & =3 \\\\ {b}_{3} & ={b}_{2}+{b}_{1} \\\\  & =3+0 \\\\  & =3 \\\\ {b}_{4} & ={b}_{3}+{b}_{2} \\\\  & =3+3 \\\\  & =6 \\\\ {b}_{5} & ={b}_{4}+{b}_{3} \\\\  & =6+3 \\\\  & =9 \\\\ {b}_{6} & ={b}_{5}+{b}_{4} \\\\  & =9+6 \\\\  & =15 \\\\  & ⋮\\end{aligned}\n$$\n\nTherefore, \n\n$$\nB={0,3,3,6,9,15,…}={0,3,6,9,15,…}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-181710/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4e28c42e-0d82-5e82-a130-a2cb72fb96d1"] :knowledge-point/questions ["q-181710"] :db/ensure [:knowledge-point/validate]} {:db/id "q-181712/selection/39ca890394802a31e6bfece71d27229782345af93db383be982d6f37f77ea45a" :answer/id #uuid "db2a0304-4142-5f0e-b45e-b123987bca33" :answer/type :answer.type/math :answer/value "{1,2,3,4,5,…}" :db/ensure [:answer/validate]} {:db/id "q-181712/selection/61ef26454348ffc7d651dd4c2b6a76df435eb827281568087535bf4c7388ba00" :answer/id #uuid "885bed53-956f-5d2e-8b8b-521fffa02756" :answer/type :answer.type/math :answer/value "{1,3,5,7,9,…}" :db/ensure [:answer/validate]} {:db/id "q-181712/selection/0dc75773f9dfab7d712172243cdcceb173eefd261a5a34c78f12dffa5b651b19" :answer/id #uuid "104edcf5-e7a0-5791-81c3-2efe81d7b41e" :answer/type :answer.type/math :answer/value "{1,3,5,8,9,…}" :db/ensure [:answer/validate]} {:db/id "q-181712/selection/7cd1539a2d7524a2a64dd3006a93ece9ee5939031b9be45a186af3d5fe6585dc" :answer/id #uuid "f3e50712-59a5-5818-a797-afc5d355f5a4" :answer/type :answer.type/math :answer/value "{1,3,4,5,9,…}" :db/ensure [:answer/validate]} {:db/id "q-181712/selection/fc54582543bd1585501f40a08c998276b5a2577baad4c5d9a13936801742f8d9" :answer/id #uuid "a39b7604-fe0d-59ef-8d93-2d67715c9ca2" :answer/type :answer.type/math :answer/value "{0,1,2,3,4,…}" :db/ensure [:answer/validate]} {:db/id "q-181712/selection" :answer-field/id #uuid "d5ca3d97-b72a-534a-a62d-951dd80d442d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-181712/selection/7cd1539a2d7524a2a64dd3006a93ece9ee5939031b9be45a186af3d5fe6585dc" :answer-field/choices ["q-181712/selection/39ca890394802a31e6bfece71d27229782345af93db383be982d6f37f77ea45a" "q-181712/selection/61ef26454348ffc7d651dd4c2b6a76df435eb827281568087535bf4c7388ba00" "q-181712/selection/0dc75773f9dfab7d712172243cdcceb173eefd261a5a34c78f12dffa5b651b19" "q-181712/selection/7cd1539a2d7524a2a64dd3006a93ece9ee5939031b9be45a186af3d5fe6585dc" "q-181712/selection/fc54582543bd1585501f40a08c998276b5a2577baad4c5d9a13936801742f8d9"] :db/ensure [:answer-field/validate]} {:db/id "q-181712" :question/id #uuid "848d85e6-ddba-5554-b46d-0822f824fa7d" :question/math-academy-id "q-181712" :question/problem "Consider the set $B,$ defined as\n\n$$\nB={{b}_{n}\\,:\\,{b}_{n+2}={b}_{n+1}+{b}_{n}\\,,\\,{b}_{1}=3,\\,{b}_{2}=1,\\,n\\in N}.\n$$\n\nWhich of the following sets is equivalent to $B?$" :question/worked-solution "The elements of $B$ are all the terms of the *recursive* sequence ${b}_{n},$ given by\n\n$$\n{b}_{n+2}={b}_{n+1}+{b}_{n},\\,{b}_{1}=3,\\,{b}_{2}=1,\\,n\\in N.\n$$\n\nLet's write down the first few terms of our sequence:\n\n$$\n\\begin{aligned}{b}_{1} & =3 \\\\ {b}_{2} & =1 \\\\ {b}_{3} & ={b}_{2}+{b}_{1} \\\\  & =1+3 \\\\  & =4 \\\\ {b}_{4} & ={b}_{3}+{b}_{2} \\\\  & =4+1 \\\\  & =5 \\\\ {b}_{5} & ={b}_{4}+{b}_{3} \\\\  & =5+4 \\\\  & =9 \\\\  & ⋮\\end{aligned}\n$$\n\nTherefore, \n\n$$\nB={3,1,4,5,9,…}={1,3,4,5,9,…}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-181712/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4e28c42e-0d82-5e82-a130-a2cb72fb96d1"] :knowledge-point/questions ["q-181712"] :db/ensure [:knowledge-point/validate]} {:db/id "q-183520/selection/af0837901aef88c157994ae58e37620d74145df3ee67470182bb0ff2f810028d" :answer/id #uuid "6e732c4f-21f8-5b4a-bf69-d48493831d5b" :answer/type :answer.type/math :answer/value "{-12,-5,-4,-3,4}" :db/ensure [:answer/validate]} {:db/id "q-183520/selection/a4f9f5959461d857433a34a89d4410c83b8392996acf39c02b1acfcaa648804a" :answer/id #uuid "9def7892-21e1-5bcd-87cb-af80b9ca88f6" :answer/type :answer.type/math :answer/value "{-12,-5,0,1,2}" :db/ensure [:answer/validate]} {:db/id "q-183520/selection/4efe63ba1412f8e9457ed8602795e8f515e8072fdc6e59034bf2f88ba5bc6d47" :answer/id #uuid "298f61a9-bac3-5949-8ebc-edb7ea08a071" :answer/type :answer.type/math :answer/value "{-12,-5,-4,-3,-2}" :db/ensure [:answer/validate]} {:db/id "q-183520/selection/2393e9f2aebc7cce5d5e9baba50caf54313b5c74523a91f3803d65cb6bb06312" :answer/id #uuid "09345243-2e5a-5b31-a386-2ca6ca2011ce" :answer/type :answer.type/math :answer/value "{-12,-5,4,5,12}" :db/ensure [:answer/validate]} {:db/id "q-183520/selection/dfff7689b5d07adbf52f26fe787858f83d6dab37a6926e244495cf20aceffe5a" :answer/id #uuid "cc36e341-0060-5b62-9fd3-a4bd82edbfcb" :answer/type :answer.type/math :answer/value "{-12,-5,-4,3,6}" :db/ensure [:answer/validate]} {:db/id "q-183520/selection" :answer-field/id #uuid "7f2df892-0858-5924-b65d-b9294a035c90" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-183520/selection/af0837901aef88c157994ae58e37620d74145df3ee67470182bb0ff2f810028d" :answer-field/choices ["q-183520/selection/af0837901aef88c157994ae58e37620d74145df3ee67470182bb0ff2f810028d" "q-183520/selection/a4f9f5959461d857433a34a89d4410c83b8392996acf39c02b1acfcaa648804a" "q-183520/selection/4efe63ba1412f8e9457ed8602795e8f515e8072fdc6e59034bf2f88ba5bc6d47" "q-183520/selection/2393e9f2aebc7cce5d5e9baba50caf54313b5c74523a91f3803d65cb6bb06312" "q-183520/selection/dfff7689b5d07adbf52f26fe787858f83d6dab37a6926e244495cf20aceffe5a"] :db/ensure [:answer-field/validate]} {:db/id "q-183520" :question/id #uuid "0fba0963-60dd-5faf-bd87-a5a5c82c372c" :question/math-academy-id "q-183520" :question/problem "Consider the set $B,$ defined as\n\n$$\nB={{n}^{3}-4:n\\in Z,\\,-2\\le n\\le 2}.\n$$\n\nWhich of the following sets is equivalent to $B?$" :question/worked-solution "The condition after the \"$:$\" symbol\n\n$$\nn\\in Z,\\,n\\le 4\n$$\n\nstates that $n$ can be any integer number that satisfies the inequality $-2\\le n\\le 2.$ In other words, \n\n$$\nn={-2,-1,0,1,2}.\n$$\n\nTherefore, the elements of $B$ are all the terms of the sequence ${b}_{n},$ given by\n\n$$\n{b}_{n}={n}^{3}-4,\\,n\\in {-2,-1,0,1,2}.\n$$\n\nLet's write down all the terms of our sequence:\n\n$$\n\\begin{aligned}{b}_{-2} & =(-2)^{3}-4=-8-4=-12 \\\\ {b}_{-1} & =(-1)^{3}-4=-1-4=-5 \\\\ {b}_{0} & ={0}^{3}-4=0-4=-4 \\\\ {b}_{1} & ={1}^{3}-4=1-4=-3 \\\\ {b}_{2} & ={2}^{3}-4=8-4=4\\end{aligned}\n$$\n\nTherefore, \n\n$$\nB={-12,-5,-4,-3,4}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-183520/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0448a1c0-e35b-56a1-aaf3-6e7a33962ade"] :knowledge-point/questions ["q-183520"] :db/ensure [:knowledge-point/validate]}]
