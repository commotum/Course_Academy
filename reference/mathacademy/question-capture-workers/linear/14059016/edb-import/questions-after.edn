#{[{:db/id #edb/ref 17592186337077 :knowledge-point/_questions [{:knowledge-point/id #uuid "272d9a54-ba97-5175-86df-0a78337da7b9" :knowledge-point/title "Calculating a Determinant After Multiplying a Matrix by a Scalar"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9708b244-f64c-5021-bea5-de40ca1711ae" :answer/type {:db/ident :answer.type/math} :answer/value "-88" :db/id #edb/ref 17592186337079} {:answer/id #uuid "32452624-c669-5a2a-af81-9a45d8922ef4" :answer/type {:db/ident :answer.type/math} :answer/value "-128" :db/id #edb/ref 17592186337080} {:answer/id #uuid "b45bae58-9882-59d5-9b7a-c988374c5c88" :answer/type {:db/ident :answer.type/math} :answer/value "-64" :db/id #edb/ref 17592186337081} {:answer/id #uuid "8b2f192f-2748-5265-96d7-cd12fd7aacfe" :answer/type {:db/ident :answer.type/math} :answer/value "160" :db/id #edb/ref 17592186337082} {:answer/id #uuid "b2da7c29-cefe-5090-81c6-f5dd571a32f2" :answer/type {:db/ident :answer.type/math} :answer/value "96" :db/id #edb/ref 17592186337083}] :answer-field/correct {:answer/id #uuid "32452624-c669-5a2a-af81-9a45d8922ef4" :answer/type {:db/ident :answer.type/math} :answer/value "-128" :db/id #edb/ref 17592186337080} :answer-field/id #uuid "0886aaa0-7d4a-5c70-b7ea-32b77b2b39a8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186337078}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8b833eb4-9e05-5944-8297-af141a86129b" :question/math-academy-id "q-130739" :question/problem "Suppose $Y$ is a $3\\times 3$ matrix and $det(Y)=2.$ What is the value of $det(-4Y)?$" :question/worked-solution "Multiplying a $n\\times n$ matrix by a scalar $k$ is equivalent to multiplying each row by $k,$ and this occurs $n$ times. This leads to the result\n\n$$\n\\begin{aligned}det(k\\cdot Y)={k}^{n}\\cdot det(Y).\\end{aligned}\n$$\n\nIn our case, we have $k=-4$ and $n=3.$ Therefore,\n\n$$\n\\begin{aligned}det(-4Y) & =(-4)^{3}\\cdot det(Y) \\\\  & =-64\\cdot 2 \\\\  & =-128.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186337084 :knowledge-point/_questions [{:knowledge-point/id #uuid "24e5e193-5e30-5480-9e5d-b7b8f1d5de87" :knowledge-point/title "Calculating a Determinant After Applying Several Elementary Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f2324e3-8eea-513b-84cb-8b138002693e" :answer/type {:db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186337086} {:answer/id #uuid "f268ffaf-758c-541d-a3af-ed74bd78a24e" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186337087} {:answer/id #uuid "afb71e20-5159-5ba5-aaff-5a081cb43436" :answer/type {:db/ident :answer.type/math} :answer/value "-75" :db/id #edb/ref 17592186337088} {:answer/id #uuid "fe8d28ab-d8e0-54f1-ae2f-41748d5803c1" :answer/type {:db/ident :answer.type/math} :answer/value "-90" :db/id #edb/ref 17592186337089} {:answer/id #uuid "e3f7ce9a-2702-5c4a-adc7-2cb51679018c" :answer/type {:db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186337090}] :answer-field/correct {:answer/id #uuid "7f2324e3-8eea-513b-84cb-8b138002693e" :answer/type {:db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186337086} :answer-field/id #uuid "ef923b97-f042-51db-894b-b3bdccf2e667" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186337085}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f84f51ef-7655-5ddd-814b-3221e5dd4c7b" :question/math-academy-id "q-130771" :question/problem "Suppose $B$ is a $6\\times 6$ matrix and $det(B)=-75.$ The matrix $C$ is obtained from $B$ by applying the elementary row operations ${R}_{2}:=\\frac{4}{5}{R}_{2}$ and ${R}_{5}↔{R}_{6}.$ What is the value of $det(C)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{5}↔{R}_{6}$ involves swapping two rows, so it changes the sign of the determinant to the opposite one.\n\n- The operation ${R}_{2}:=\\frac{4}{5}{R}_{2}$ involves multiplying a row by $\\frac{4}{5},$ so the determinant is multiplied by $\\frac{4}{5}$ as well.\n\nTherefore, we have to change the sign of the determinant to the opposite one and multiply by $\\frac{4}{5}$ as well. Consequently, we get\n\n$$\n\\begin{aligned}det(C) & =\\frac{4}{5}\\cdot (-det(B)) \\\\  & =-\\frac{4}{5}det(B) \\\\  & =-\\frac{4}{5}\\cdot (-75) \\\\  & =60.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186337091 :knowledge-point/_questions [{:knowledge-point/id #uuid "9a0ab53e-79ff-5520-bb50-069fd381d29d" :knowledge-point/title "Identifying a Row Operation Given the Connection Between Two Determinants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f145981-0fb0-583c-b651-8f4a66d6d2e7" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186337093} {:answer/id #uuid "86d825ee-7b34-5102-97b3-21279d710693" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186337094} {:answer/id #uuid "b5d27282-1505-5bc2-ba89-acb51d1328ea" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186337095} {:answer/id #uuid "efd1fd85-dcdb-5304-86df-874588915e6a" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186337096} {:answer/id #uuid "3e5a599c-e48f-5169-b52c-171486d54184" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186337097}] :answer-field/correct {:answer/id #uuid "86d825ee-7b34-5102-97b3-21279d710693" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186337094} :answer-field/id #uuid "ca72fa80-1e05-538a-bf3b-8898e7d8d5ee" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186337092}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "2147c852-ca7d-56cf-bfc5-b94dd52d4711" :question/math-academy-id "q-130855" :question/problem "Consider the matrices given below. Given that $X$ and $Y$ are row equivalent matrices and $det(X)=5$, find $det(Y).$\n\n$$\nX=[\\begin{aligned}2 & -3 & 1 \\\\ 1 & 1 & -2 \\\\ -3 & 2 & 2\\end{aligned}],\\,Y=[\\begin{aligned}2 & -3 & 1 \\\\ -3 & 2 & 2 \\\\ 1 & 1 & -2\\end{aligned}].\n$$" :question/worked-solution "Notice that $Y$ can be obtained from $X$ by swapping the $2$nd and the $3$rd rows. \n\nThis changes the sign of the determinant to the opposite one.\nTherefore, we obtain\n\n$$\n\\begin{aligned}det(Y) & =-det(X) \\\\  & =-(5) \\\\  & =-5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186337098 :knowledge-point/_questions [{:knowledge-point/id #uuid "9a0ab53e-79ff-5520-bb50-069fd381d29d" :knowledge-point/title "Identifying a Row Operation Given the Connection Between Two Determinants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc4b19f5-5156-5af2-86ba-7ecd0757ea0c" :answer/type {:db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186337100} {:answer/id #uuid "afb16502-e271-5984-9bb9-dcb1497f1422" :answer/type {:db/ident :answer.type/math} :answer/value "-50" :db/id #edb/ref 17592186337101} {:answer/id #uuid "1c74ea40-fc65-58d4-817b-6e10d9c9e72d" :answer/type {:db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186337102} {:answer/id #uuid "a1ff20bd-5bc2-5acb-9b74-804331a35c39" :answer/type {:db/ident :answer.type/math} :answer/value "96" :db/id #edb/ref 17592186337103} {:answer/id #uuid "e4ac646c-8e4f-5346-bf63-435da97e77d6" :answer/type {:db/ident :answer.type/math} :answer/value "-60" :db/id #edb/ref 17592186337104}] :answer-field/correct {:answer/id #uuid "bc4b19f5-5156-5af2-86ba-7ecd0757ea0c" :answer/type {:db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186337100} :answer-field/id #uuid "9867f2e2-088e-54ab-8ee5-2af6ceef6d58" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186337099}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d99b2d08-6502-52b9-9b94-888676f9d2b8" :question/math-academy-id "q-130857" :question/problem "Consider the matrices given below. Given that $X$ and $Y$ are row equivalent matrices and $det(X)=-60$, find $det(Y).$\n\n$$\nX=[\\begin{aligned}1 & 2 & -3 \\\\ 3 & -2 & 1 \\\\ 4 & 2 & 3\\end{aligned}],\\,Y=[\\begin{aligned}4 & 2 & 3 \\\\ 3 & -2 & 1 \\\\ 1 & 2 & -3\\end{aligned}]?\n$$" :question/worked-solution "Notice that $Y$ can be obtained from $X$ by swapping the $1$st and the $3$rd rows. \n\nThis changes the sign of the determinant to the opposite one.\nTherefore, we obtain\n\n$$\n\\begin{aligned}det(Y) & =-det(X) \\\\  & =-(-60) \\\\  & =60.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120440 :knowledge-point/_questions [{:knowledge-point/id #uuid "272d9a54-ba97-5175-86df-0a78337da7b9" :knowledge-point/title "Calculating a Determinant After Multiplying a Matrix by a Scalar"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a577cf1b-4b49-5d00-bcd8-c76ba6538667" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186119116} {:answer/id #uuid "0e0f9e6a-117b-51df-980d-5af210c4c45a" :answer/type {:db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186119117} {:answer/id #uuid "2ef361c2-5fce-5da9-916c-13188a782e53" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186119118} {:answer/id #uuid "4c022347-1ed3-52bf-af72-050ff484ee01" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186119119} {:answer/id #uuid "63c145d8-5c93-5e7e-909a-8ef73a7cbedd" :answer/type {:db/ident :answer.type/math} :answer/value "54" :db/id #edb/ref 17592186119120}] :answer-field/correct {:answer/id #uuid "0e0f9e6a-117b-51df-980d-5af210c4c45a" :answer/type {:db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186119117} :answer-field/id #uuid "d2079009-5fc4-5046-9f08-188d6dd7e285" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186119115}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "20b2b920-09b8-5c35-837e-344f00bccedd" :question/math-academy-id "q-72465" :question/problem "Suppose $B$ is a $2\\times 2$ matrix and $det(B)=-2.$ What is the value of $det(3B)?$" :question/worked-solution "Multiplying a $n\\times n$ matrix by a scalar $k$ is equivalent to multiplying each row by $k,$ and this occurs $n$ times. This leads to the result\n\n$$\n\\begin{aligned}det(k\\cdot B)={k}^{n}\\cdot det(B).\\end{aligned}\n$$\n\nIn our case, we have $k=3$ and $n=2.$ Therefore,\n\n$$\n\\begin{aligned}det(3B) & ={3}^{2}\\cdot det(B) \\\\  & =9\\cdot (-2) \\\\  & =-18.\\end{aligned}\n$$"}]}
