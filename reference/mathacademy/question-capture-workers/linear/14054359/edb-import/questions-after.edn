#{[{:db/id #edb/ref 17592186333031 :knowledge-point/_questions [{:knowledge-point/id #uuid "62196ae9-df2e-5a3a-bc0a-1c0f4c40af3e" :knowledge-point/title "Finding a Normal Vector To a Plane Given by Parametric Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06356366-ac14-5eca-ba74-a9d414b1ee18" :answer/type {:db/ident :answer.type/math} :answer/value "⟨6,-4,-26⟩" :db/id #edb/ref 17592186333033} {:answer/id #uuid "f2e456a8-7904-5407-9469-92019bd3731b" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-8,-2,-22⟩" :db/id #edb/ref 17592186333034} {:answer/id #uuid "26a44b18-bcce-5e94-b8e6-c0f974824a82" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-2,-8,-7⟩" :db/id #edb/ref 17592186333035} {:answer/id #uuid "fb0f231f-152a-5980-8fc7-9325b0e35cd5" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-8,2,-11⟩" :db/id #edb/ref 17592186333036} {:answer/id #uuid "8d56eef7-519e-54fc-96f9-fe184cd9a9e8" :answer/type {:db/ident :answer.type/math} :answer/value "⟨8,-2,17⟩" :db/id #edb/ref 17592186333037}] :answer-field/correct {:answer/id #uuid "f2e456a8-7904-5407-9469-92019bd3731b" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-8,-2,-22⟩" :db/id #edb/ref 17592186333034} :answer-field/id #uuid "6c54fa54-6a10-5289-8959-ccdbd95d229e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186333032}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f6f95ad4-636d-5fea-a576-1ccef1a66d8d" :question/math-academy-id "q-128497" :question/problem "Find a normal vector to the plane\n\n$$\nr=⟨3,\\sqrt{7},-2⟩+t⟨-2,8,0⟩+s⟨3,-1,-1⟩,\\,t,\\,s\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "From the parametric equation, we have that $v=⟨-2,8,0⟩$ and $w=⟨3,-1,-1⟩$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $v$ and $w$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =[\\begin{aligned}-2 \\\\ 8 \\\\ 0\\end{aligned}]\\times [\\begin{aligned}3 \\\\ -1 \\\\ -1\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ -2 & 8 & 0 \\\\ 3 & -1 & -1\\end{aligned}\\right| \\\\  & =-8i-2j-22k \\\\  & =⟨-8,-2,-22⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨-8,-2,-22⟩.$"}] [{:db/id #edb/ref 17592186333038 :knowledge-point/_questions [{:knowledge-point/id #uuid "3061cb06-f57f-57c8-8821-dbd962b1e78e" :knowledge-point/title "Finding the Parametric Equation of the Plane Parallel To Two Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ece0a88f-b35e-5d64-90b9-52f5003dbbe1" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨5,-2,4⟩+s⟨7,3,4⟩+t⟨3,5,2⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186333040} {:answer/id #uuid "2c8fedb2-8532-56b3-949e-e51ee1f68efa" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨4,-5,2⟩+s⟨-3,-7,4⟩+t⟨3,5,1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186333041} {:answer/id #uuid "293f270e-90c5-5f3c-a5e1-2aaf5e362033" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨4,-2,5⟩+s⟨4,-3,7⟩+t⟨1,-5,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186333042} {:answer/id #uuid "9073f282-790d-5237-93ba-134741c301e4" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨4,-2,5⟩+s⟨7,-4,3⟩+t⟨1,-5,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186333043} {:answer/id #uuid "3f00a533-7a38-59a0-8257-3a2e9e798324" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨4,-2,5⟩+s⟨7,-3,4⟩+t⟨3,-5,1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186333044}] :answer-field/correct {:answer/id #uuid "3f00a533-7a38-59a0-8257-3a2e9e798324" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨4,-2,5⟩+s⟨7,-3,4⟩+t⟨3,-5,1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186333044} :answer-field/id #uuid "685ec1e3-9c96-5227-b894-5ec0e3f01681" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186333039}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b43bb9ce-619f-53b3-8245-585a25c57b33" :question/math-academy-id "q-128538" :question/problem "Find a parametric equation of the plane that passes through the point $E(4,-2,5)$ and is parallel to the lines $r=⟨11,0,5⟩+s⟨7,-3,4⟩$ and $r=⟨12,-2,4⟩+t⟨3,-5,1⟩.$" :question/worked-solution "The direction vectors of the lines are ${v}_{1}=⟨7,-3,4⟩$ and ${v}_{2}=⟨3,-5,1⟩$, respectively. These vectors are parallel to the plane but not to each other.\n\nWe also know that the point $E(4,-2,5)$ lies on the plane and its position vector is $e=⟨4,-2,5⟩.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =e+s{v}_{1}+t{v}_{2} \\\\ r & =⟨4,-2,5⟩+s⟨7,-3,4⟩+t⟨3,-5,1⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186333045 :knowledge-point/_questions [{:knowledge-point/id #uuid "d11f13f0-1cfa-59ec-a04a-9483d942b1aa" :knowledge-point/title "Finding the Parametric Equation of the Plane Passing Through Three Given Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cc3ceb4-3bf2-56c1-af8b-8474e22b53a9" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨7,-2,3⟩+s⟨-3,6,-7⟩+t⟨-4,9,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186333047} {:answer/id #uuid "5facd0d9-6c14-580e-98d9-8c3a1540c055" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨7,-2,3⟩+s⟨-7,6,-3⟩+t⟨-9,4,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186333048} {:answer/id #uuid "1c1c14d9-943a-5f8a-9bf9-56ab7f5a98ee" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨7,-2,3⟩+s⟨3,7,-6⟩+t⟨-4,3,9⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186333049} {:answer/id #uuid "e73553d8-5c3b-5faa-b922-c360aa63fbdd" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨7,-2,3⟩+s⟨6,3,-7⟩+t⟨-3,9,4⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186333050} {:answer/id #uuid "39afe7ab-83b5-5a72-8e2f-2b0fc287778c" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨7,-2,3⟩+s⟨-3,7,-6⟩+t⟨-4,3,9⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186333051}] :answer-field/correct {:answer/id #uuid "0cc3ceb4-3bf2-56c1-af8b-8474e22b53a9" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨7,-2,3⟩+s⟨-3,6,-7⟩+t⟨-4,9,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186333047} :answer-field/id #uuid "9dc8a246-9302-54f6-a3da-d6a0da0e6fe2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186333046}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "84d99597-fe03-57ba-8248-b7d7039e4775" :question/math-academy-id "q-128743" :question/problem "Find a parametric equation of the plane that passes through the points $U(7,-2,3),\\,V(4,4,-4),$ and $W(3,7,6).$" :question/worked-solution "First, we need to find two vectors that are parallel to the plane (but not to each other). Let's use the displacement vectors $\\overset{\\to }{UV}$ and $\\overset{\\to }{UW},$ as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{UV} & =⟨4,4,-4⟩-⟨7,-2,3⟩ \\\\  & =⟨-3,6,-7⟩ \\\\ \\overset{\\to }{UW} & =⟨3,7,6⟩-⟨7,-2,3⟩ \\\\  & =⟨-4,9,3⟩\\end{aligned}\n$$\n\nNow, if we consider the position vector $u=⟨7,-2,3⟩$ of the point $U,$ then the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =u+s\\overset{\\to }{UV}+t\\overset{\\to }{UW} \\\\ r & =⟨7,-2,3⟩+s⟨-3,6,-7⟩+t⟨-4,9,3⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186333052 :knowledge-point/_questions [{:knowledge-point/id #uuid "62196ae9-df2e-5a3a-bc0a-1c0f4c40af3e" :knowledge-point/title "Finding a Normal Vector To a Plane Given by Parametric Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "713e2c83-a3c8-55c8-af97-c9931503d01b" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,0,3⟩" :db/id #edb/ref 17592186333054} {:answer/id #uuid "a4f163f8-9973-500d-8dc3-513d85f64410" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4,0,-3⟩" :db/id #edb/ref 17592186333055} {:answer/id #uuid "0bf172c8-f848-5d83-a9f1-585a753f8a8c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4,1,-3⟩" :db/id #edb/ref 17592186333056} {:answer/id #uuid "aa820a0b-5e86-59c5-89fa-803d83826b70" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,0,4⟩" :db/id #edb/ref 17592186333057} {:answer/id #uuid "6f383bdf-b038-5aad-aaed-af7158b89448" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,-1,1⟩" :db/id #edb/ref 17592186333058}] :answer-field/correct {:answer/id #uuid "0bf172c8-f848-5d83-a9f1-585a753f8a8c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4,1,-3⟩" :db/id #edb/ref 17592186333056} :answer-field/id #uuid "3010a2a7-5056-5199-bd35-1cbe0383577b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186333053}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6854f19a-2e50-57ec-bb13-506f8026ff43" :question/math-academy-id "q-70974" :question/problem "Find a normal vector to the plane\n\n$$\nr=[\\begin{aligned}1 \\\\ 12 \\\\ \\frac{3}{4}\\end{aligned}]+t[\\begin{aligned}3 \\\\ 0 \\\\ 4\\end{aligned}]+s[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}],\\,t,\\,s\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "From the parametric equation, we have that $v=⟨3,0,4⟩$ and $w=⟨1,-1,1⟩$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $v$ and $w$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =[\\begin{aligned}3 \\\\ 0 \\\\ 4\\end{aligned}]\\times [\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 3 & 0 & 4 \\\\ 1 & -1 & 1\\end{aligned}\\right| \\\\  & =4i+j-3k \\\\  & =⟨4,1,-3⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨4,1,-3⟩.$"}] [{:db/id #edb/ref 17592186333059 :knowledge-point/_questions [{:knowledge-point/id #uuid "3061cb06-f57f-57c8-8821-dbd962b1e78e" :knowledge-point/title "Finding the Parametric Equation of the Plane Parallel To Two Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f2767e5-5463-5d23-a7f6-883b69280319" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨2,1,-\\frac{1}{5}⟩+s⟨-3,0,1⟩+t⟨-3,2,7⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/id #edb/ref 17592186333061} {:answer/id #uuid "b22e69bb-a768-5781-ad70-f4ce11edc145" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨-3,2,7⟩+s⟨-3,0,1⟩+t⟨2,1,-\\frac{1}{5}⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/id #edb/ref 17592186333062} {:answer/id #uuid "8c67a038-fd9b-56c1-8600-a8134b2d6f6a" :answer/type {:db/ident :answer.type/text} :answer/value "The plane is undefined" :db/id #edb/ref 17592186333063} {:answer/id #uuid "a50cf202-facd-51e3-a6eb-6f07de85025c" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨-3,2,7⟩+s⟨3,-1,20⟩+t⟨0,3,-4⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/id #edb/ref 17592186333064} {:answer/id #uuid "b7f42377-3924-55b4-b6b8-ea16f7f09194" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨-3,0,1⟩+s⟨-3,2,7⟩+t⟨2,1,-\\frac{1}{5}⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/id #edb/ref 17592186333065}] :answer-field/correct {:answer/id #uuid "b22e69bb-a768-5781-ad70-f4ce11edc145" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨-3,2,7⟩+s⟨-3,0,1⟩+t⟨2,1,-\\frac{1}{5}⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/id #edb/ref 17592186333062} :answer-field/id #uuid "2032754d-8d77-5a59-8010-7070e31461f1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186333060}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a1e3ae2d-0bf0-5679-8209-36898e366f4e" :question/math-academy-id "q-70981" :question/problem "Find a parametric equation of the plane that passes through the point $H(-3,2,7)$ and is parallel to the lines $r=⟨3,-1,20⟩+s⟨-3,0,1⟩$ and $r=⟨0,3,-4⟩+t⟨2,1,-\\frac{1}{5}⟩.$" :question/worked-solution "The direction vectors of the lines are ${v}_{1}=⟨-3,0,1⟩$ and ${v}_{2}=⟨2,1,-\\frac{1}{5}⟩$, respectively. These vectors are parallel to the plane but not to each other.\n\nWe also know that the point $H(-3,2,7)$ lies on the plane and its position vector is $h=⟨-3,2,7⟩.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =h+s{v}_{1}+t{v}_{2} \\\\ r & =⟨-3,2,7⟩+s⟨-3,0,1⟩+t⟨2,1,-\\frac{1}{5}⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}]}
