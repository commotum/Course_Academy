r & =⟨7,-2,3⟩+s⟨-3,6,-7⟩+t⟨-4,9,3⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-128743/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d11f13f0-1cfa-59ec-a04a-9483d942b1aa"] :knowledge-point/questions ["q-128743"] :db/ensure [:knowledge-point/validate]}]
