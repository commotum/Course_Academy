6f8026ff43" :question/math-academy-id "q-70974" :question/problem "Find a normal vector to the plane\n\n$$\nr=[\\begin{aligned}1 \\\\ 12 \\\\ \\frac{3}{4}\\end{aligned}]+t[\\begin{aligned}3 \\\\ 0 \\\\ 4\\end{aligned}]+s[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}],\\,t,\\,s\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "From the parametric equation, we have that $v=⟨3,0,4⟩$ and $w=⟨1,-1,1⟩$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $v$ and $w$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =[\\begin{aligned}3 \\\\ 0 \\\\ 4\\end{aligned}]\\times [\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 3 & 0 & 4 \\\\ 1 & -1 & 1\\end{aligned}\\right| \\\\  & =4i+j-3k \\\\  & =⟨4,1,-3⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨4,1,-3⟩.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-70974/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "62196ae9-df2e-5a3a-bc0a-1c0f4c40af3e"] :knowledge-point/questions ["q-70974"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70981/selection/f980ad23e5a0b23b00f2853e44608492ba4b2654171c0c2f74aca5b11d262807" :answer/id #uuid "b7f42377-3924-55b4-b6b8-ea16f7f09194" :answer/type :answer.type/math :answer/value "r=⟨-3,0,1⟩+s⟨-3,2,7⟩+t⟨2,1,-\\frac{1}{5}⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/ensure [:answer/validate]} {:db/id "q-70981/selection/21c23afb400b5ecde4e1b3eb66e299e52cada41d68e41227ea75e59a02ad68a8" :answer/id #uuid "8c67a038-fd9b-56c1-8600-a8134b2d6f6a" :answer/type :answer.type/text :answer/value "The plane is undefined" :db/ensure [:answer/validate]} {:db/id "q-70981/selection/1245cc0259ebafb90bb814266fa6aec3adc0f722bbe4356c7c37f8b9ecc6f6e7" :answer/id #uuid "4f2767e5-5463-5d23-a7f6-883b69280319" :answer/type :answer.type/math :answer/value "r=⟨2,1,-\\frac{1}{5}⟩+s⟨-3,0,1⟩+t⟨-3,2,7⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/ensure [:answer/validate]} {:db/id "q-70981/selection/19aed1f26b606d49c3a2f75db9fa6ef6e8a70d3299aa02cda61fa5fa6c8c73c9" :answer/id #uuid "b22e69bb-a768-5781-ad70-f4ce11edc145" :answer/type :answer.type/math :answer/value "r=⟨-3,2,7⟩+s⟨-3,0,1⟩+t⟨2,1,-\\frac{1}{5}⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/ensure [:answer/validate]} {:db/id "q-70981/selection/a69fb2e1811019c79e9fe3c9fa196bc50790bf7471d17a248236961036f47daa" :answer/id #uuid "a50cf202-facd-51e3-a6eb-6f07de85025c" :answer/type :answer.type/math :answer/value "r=⟨-3,2,7⟩+s⟨3,-1,20⟩+t⟨0,3,-4⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/ensure [:answer/validate]} {:db/id "q-70981/selection" :answer-field/id #uuid "2032754d-8d77-5a59-8010-7070e31461f1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-70981/selection/19aed1f26b606d49c3a2f75db9fa6ef6e8a70d3299aa02cda61fa5fa6c8c73c9" :answer-field/choices ["q-70981/selection/f980ad23e5a0b23b00f2853e44608492ba4b2654171c0c2f74aca5b11d262807" "q-70981/selection/21c23afb400b5ecde4e1b3eb66e299e52cada41d68e41227ea75e59a02ad68a8" "q-70981/selection/1245cc0259ebafb90bb814266fa6aec3adc0f722bbe4356c7c37f8b9ecc6f6e7" "q-70981/selection/19aed1f26b606d49c3a2f75db9fa6ef6e8a70d3299aa02cda61fa5fa6c8c73c9" "q-70981/selection/a69fb2e1811019c79e9fe3c9fa196bc50790bf7471d17a248236961036f47daa"] :db/ensure [:answer-field/validate]} {:db/id "q-70981" :question/id #uuid "a1e3ae2d-0bf0-5679-8209-36898e366f4e" :question/math-academy-id "q-70981" :question/problem "Find a parametric equation of the plane that passes through the point $H(-3,2,7)$ and is parallel to the lines $r=⟨3,-1,20⟩+s⟨-3,0,1⟩$ and $r=⟨0,3,-4⟩+t⟨2,1,-\\frac{1}{5}⟩.$" :question/worked-solution "The direction vectors of the lines are ${v}_{1}=⟨-3,0,1⟩$ and ${v}_{2}=⟨2,1,-\\frac{1}{5}⟩$, respectively. These vectors are parallel to the plane but not to each other.\n\nWe also know that the point $H(-3,2,7)$ lies on the plane and its position vector is $h=⟨-3,2,7⟩.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =h+s{v}_{1}+t{v}_{2} \\\\ r & =⟨-3,2,7⟩+s⟨-3,0,1⟩+t⟨2,1,-\\frac{1}{5}⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-70981/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3061cb06-f57f-57c8-8821-dbd962b1e78e"] :knowledge-point/questions ["q-70981"] :db/ensure [:knowledge-point/validate]} {:db/id "q-128497/selection/47114cfa940ddcbe5e39ae8f925154a6826aaf0bd21e8e5f88681949e4fa19e3" :answer/id #uuid "fb0f231f-152a-5980-8fc7-9325b0e35cd5" :answer/type :answer.type/math :answer/value "⟨-8,2,-11⟩" :db/ensure [:answer/validate]} {:db/id "q-128497/selection/26b68a8350a64bb1a8627d7551ee5c080eb8b37905b1702f1e290c629b7a52c9" :answer/id #uuid "f2e456a8-7904-5407-9469-92019bd3731b" :answer/type :answer.type/math :answer/value "⟨-8,-2,-22⟩" :db/ensure [:answer/validate]} {:db/id "q-128497/selection/1aee1b18ee2a65bb57469c0591954524de1d4ede7ce3fa00d4510ba733cd5b8d" :answer/id #uuid "06356366-ac14-5eca-ba74-a9d414b1ee18" :answer/type :answer.type/math :answer/value "⟨6,-4,-26⟩" :db/ensure [:answer/validate]} {:db/id "q-128497/selection/6e6145c46661dbfdd5a776cd88dbb50a6d34b2d93e3b1de9d4a4a175fc172d16" :answer/id #uuid "8d56eef7-519e-54fc-96f9-fe184cd9a9e8" :answer/type :answer.type/math :answer/value "⟨8,-2,17⟩" :db/ensure [:answer/validate]} {:db/id "q-128497/selection/3d5b62400eb50539a632a072e58f9902a8187534df1dcc330595eaa28bb109a4" :answer/id #uuid "26a44b18-bcce-5e94-b8e6-c0f974824a82" :answer/type :answer.type/math :answer/value "⟨-2,-8,-7⟩" :db/ensure [:answer/validate]} {:db/id "q-128497/selection" :answer-field/id #uuid "6c54fa54-6a10-5289-8959-ccdbd95d229e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-128497/selection/26b68a8350a64bb1a8627d7551ee5c080eb8b37905b1702f1e290c629b7a52c9" :answer-field/choice