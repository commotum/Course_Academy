3⟩,\\,s,t\\in (-\\infty ,\\infty )" 13194139535134 true] [17592186333047 1103 #edb/ref 17592186045453 13194139535134 true] [17592186333047 1111 #uuid "0cc3ceb4-3bf2-56c1-af8b-8474e22b53a9" 13194139535134 true] [17592186333048 1034 "r=⟨7,-2,3⟩+s⟨-7,6,-3⟩+t⟨-9,4,3⟩,\\,s,t\\in (-\\infty ,\\infty )" 13194139535134 true] [17592186333048 1103 #edb/ref 17592186045453 13194139535134 true] [17592186333048 1111 #uuid "5facd0d9-6c14-580e-98d9-8c3a1540c055" 13194139535134 true] [17592186333049 1034 "r=⟨7,-2,3⟩+s⟨3,7,-6⟩+t⟨-4,3,9⟩,\\,s,t\\in (-\\infty ,\\infty )" 13194139535134 true] [17592186333049 1103 #edb/ref 17592186045453 13194139535134 true] [17592186333049 1111 #uuid "1c1c14d9-943a-5f8a-9bf9-56ab7f5a98ee" 13194139535134 true] [17592186333050 1034 "r=⟨7,-2,3⟩+s⟨6,3,-7⟩+t⟨-3,9,4⟩,\\,s,t\\in (-\\infty ,\\infty )" 13194139535134 true] [17592186333050 1103 #edb/ref 17592186045453 13194139535134 true] [17592186333050 1111 #uuid "e73553d8-5c3b-5faa-b922-c360aa63fbdd" 13194139535134 true] [17592186333051 1034 "r=⟨7,-2,3⟩+s⟨-3,7,-6⟩+t⟨-4,3,9⟩,\\,s,t\\in (-\\infty ,\\infty )" 13194139535134 true] [17592186333051 1103 #edb/ref 17592186045453 13194139535134 true] [17592186333051 1111 #uuid "39afe7ab-83b5-5a72-8e2f-2b0fc287778c" 13194139535134 true] [17592186333052 1017 #edb/ref 17592186333053 13194139535134 true] [17592186333052 1089 "q-70974" 13194139535134 true] [17592186333052 1091 #edb/ref 17592186045463 13194139535134 true] [17592186333052 1100 "Find a normal vector to the plane\n\n$$\nr=[\\begin{aligned}1 \\\\ 12 \\\\ \\frac{3}{4}\\end{aligned}]+t[\\begin{aligned}3 \\\\ 0 \\\\ 4\\end{aligned}]+s[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}],\\,t,\\,s\\in (-\\infty ,\\infty ).\n$$" 13194139535134 true] [17592186333052 1113 #uuid "6854f19a-2e50-57ec-bb13-506f8026ff43" 13194139535134 true] [17592186333052 1145 "From the parametric equation, we have that $v=⟨3,0,4⟩$ and $w=⟨1,-1,1⟩$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $v$ and $w$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =[\\begin{aligned}3 \\\\ 0 \\\\ 4\\end{aligned}]\\times [\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 3 & 0 & 4 \\\\ 1 & -1 & 1\\end{aligned}\\right| \\\\  & =4i+j-3k \\\\  & =⟨4,1,-3⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨4,1,-3⟩.$" 13194139535134 true] [17592186333053 1000 #edb/ref 17592186333054 13194139535134 true] [17592186333053 1000 #edb/ref 17592186333055 13194139535134 true] [17592186333053 1000 #edb/ref 17592186333056 13194139535134 true] [17592186333053 1000 #edb/ref 17592186333057 13194139535134 true] [17592186333053 1000 #edb/ref 17592186333058 13194139535134 true] [17592186333053 1040 #edb/ref 17592186045450 13194139535134 true] [17592186333053 1041 "selection" 13194139535134 true] [17592186333053 1104 #edb/ref 17592186333056 13194139535134 true] [17592186333053 1110 #uuid "3010a2a7-5056-5199-bd35-1cbe0383577b" 13194139535134 true] [17592186333054 1034 "⟨3,0,3⟩" 13194139535134 true] [17592186333054 1103 #edb/ref 17592186045453 13194139535134 true] [17592186333054 1111 #uuid "713e2c83-a3c8-55c8-af97-c9931503d01b" 13194139535134 true] [17592186333055 1034 "⟨4,0,-3⟩" 13194139535134 true] [17592186333055 1103 #edb/ref 17592186045453 13194139535134 true] [17592186333055 1111 #uuid "a4f163f8-9973-500d-8dc3-513d85f64410" 13194139535134 true] [17592186333056 1034 "⟨4,1,-3⟩" 13194139535134 true] [17592186333056 1103 #edb/ref 17592186045453 13194139535134 true] [17592186333056 1111 #uuid "0bf172c8-f848-5d83-a9f1-585a753f8a8c" 13194139535134 true] [17592186333057 1034 "⟨3,0,4⟩" 13194139535134 true] [17592186333057 1103 #edb/ref 17592186045453 13194139535134 true] [17592186333057 1111 #uuid "aa820a0b-5e86-59c5-89fa-803d83826b70" 13194139535134 true] [17592186333058 1034 "⟨1,-1,1⟩" 13194139535134 true] [17592186333058 1103 #edb/ref 17592186045453 13194139535134 true] [17592186333058 1111 #uui