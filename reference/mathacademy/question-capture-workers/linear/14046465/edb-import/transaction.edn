[{:db/id "q-318964/field-1/df4ef3a75f6d71027299791921d9536d50890079e16123ff435f8ed8ac6150b0" :answer/id #uuid "5c7a4be6-9f75-5e5a-b703-b61695fa0539" :answer/type :answer.type/math :answer/value "-\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-318964/field-1" :answer-field/id #uuid "a3b0342d-276c-53d6-857f-42e68c054f5a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-318964/field-1/df4ef3a75f6d71027299791921d9536d50890079e16123ff435f8ed8ac6150b0" :answer-field/choices ["q-318964/field-1/df4ef3a75f6d71027299791921d9536d50890079e16123ff435f8ed8ac6150b0"] :db/ensure [:answer-field/validate]} {:db/id "q-318964" :question/id #uuid "15c589ac-c774-565c-a921-9c4aacc2fd5a" :question/math-academy-id "q-318964" :question/problem "Suppose $|\\,k\\,|=2\\sqrt{2}$ and the angle between vectors $k$ and $l$ is $\\theta ={120}^{∘}.$ Find the scalar projection of $k$ onto $l.$\n\n${\\text{comp}}_{l}\\,k=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{l}\\,k & =|\\,k\\,|\\operatorname{cos}⁡\\theta  \\\\  & =2\\sqrt{2}\\operatorname{cos}⁡({120}^{∘}) \\\\  & =2\\sqrt{2}\\cdot (-\\frac{1}{2}) \\\\  & =-\\sqrt{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-318964/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6"] :knowledge-point/questions ["q-318964"] :db/ensure [:knowledge-point/validate]} {:db/id "q-275243/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "3ed87f31-da7e-5477-a243-91ce92941c0b" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-275243/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "7bd91897-2135-5487-93f8-bc117a2a984f" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-275243/field-1" :answer-field/id #uuid "25b61378-09a7-51dd-bde9-f225b89ee7ab" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-275243/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-275243/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-275243/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-275243" :question/id #uuid "2b0cb2d9-f792-50a5-b3a3-ff6be552240e" :question/math-academy-id "q-275243" :question/problem "Suppose $|\\,c\\,|=4$ and the angle between vectors $c$ and $d$ is $\\theta =\\frac{\\pi }{2}.$ Find the scalar projection of $c$ onto $d.$\n\n${\\text{comp}}_{d}\\,c=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =|\\,c\\,|\\operatorname{cos}⁡\\theta  \\\\  & =4\\operatorname{cos}⁡(\\frac{\\pi }{2}) \\\\  & =4\\cdot 0 \\\\  & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-275243/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6"] :knowledge-point/questions ["q-275243"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71530/selection/c0604a86cfd857bc489253f78a41d2e71ce7c6f6c7bd728e03e271ea75d6c980" :answer/id #uuid "2c2fab71-07da-5777-97fc-58739d2a11ea" :answer/type :answer.type/math :answer/value "\\frac{3\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-71530/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "f042bcf6-6c0e-5a30-9948-63a5c34edf24" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-71530/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "8a23bddc-bf75-54ba-ac6a-776d368bf3c0" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-71530/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "ee94829a-cf90-5bd6-b4ff-17addb05fc47" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-71530/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer/id #uuid "cf54d300-6435-5a5d-91fd-03ff865d0fbd" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-71530/selection" :answer-field/id #uuid "3975484c-8809-5dab-9b2d-57d000d834a3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71530/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-71530/selection/c0604a86cfd857bc489253f78a41d2e71ce7c6f6c7bd728e03e271ea75d6c980" "q-71530/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-71530/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-71530/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-71530/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10"] :db/ensure [:answer-field/validate]} {:db/id "q-71530" :question/id #uuid "ebf6f7b3-db73-58f2-8132-9775b13e2d37" :question/math-academy-id "q-71530" :question/problem "Suppose $|\\,p\\,|=3\\sqrt{2}$ and the angle between vectors $p$ and $q$ is $\\theta =\\frac{\\pi }{4}.$ Find the scalar projection of $p$ onto $q.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =|\\,p\\,|\\operatorname{cos}⁡\\theta  \\\\  & =3\\sqrt{2}\\operatorname{cos}⁡(\\frac{\\pi }{4}) \\\\  & =3\\sqrt{2}\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-71530/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6"] :knowledge-point/questions ["q-71530"] :db/ensure [:knowledge-point/validate]} {:db/id "q-318971/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "7d986a92-797b-5087-9f7a-aac8121a7b82" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id 17592186275294 :answer-field/choices ["q-318971/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-318979/field-1/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" :answer/id #uuid "29fc626e-908a-5210-bc9b-c842034bf3a3" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-318979/field-1" :answer-field/id #uuid "0c6e7d34-eda1-5901-af72-e7495be58b3b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-318979/field-1/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" :answer-field/choices ["q-318979/field-1/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277"] :db/ensure [:answer-field/validate]} {:db/id "q-318979" :question/id #uuid "1ab23067-0b24-53fd-9375-d57deff25b7a" :question/math-academy-id "q-318979" :question/problem "Let $a=⟨3,-2,1⟩$ and $b=⟨2,1,-2⟩.$ Find the scalar projection of $a$ onto $b.$\n\n${\\text{comp}}_{b}\\,a=$\n{{field-1}}" :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{(3)(2)+(-2)(1)+(1)(-2)}{\\sqrt{{2}^{2}+{1}^{2}+(-2)^{2}}} \\\\  & =\\frac{6-2-2}{\\sqrt{9}} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-318979/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036"] :knowledge-point/questions ["q-318979"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-18374"] :question/problem "Let $p=⟨\\sqrt{2},1,-1⟩$ and $q=⟨\\sqrt{8},-\\sqrt{3},1⟩.$ Find the scalar projection of $p$ onto $q.$" :db/ensure [:question/validate]} {:db/id "q-275244/field-1/9afcf67ca8f38e32ee954fc438cc642a9847b0b37bf69ce3090bdb42b19ce768" :answer/id #uuid "379dcbef-4c41-513f-8577-7563a279e9c1" :answer/type :answer.type/math :answer/value "\\frac{8}{\\sqrt{13}}" :db/ensure [:answer/validate]} {:db/id "q-275244/field-1" :answer-field/id #uuid "4a97814c-22dd-5e52-b37f-cc2496d165e1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-275244/field-1/9afcf67ca8f38e32ee954fc438cc642a9847b0b37bf69ce3090bdb42b19ce768" :answer-field/choices ["q-275244/field-1/9afcf67ca8f38e32ee954fc438cc642a9847b0b37bf69ce3090bdb42b19ce768"] :db/ensure [:answer-field/validate]} {:db/id "q-275244" :question/id #uuid "58e692ad-2f21-5e36-851a-c003694ad570" :question/math-academy-id "q-275244" :question/problem "Let $p=⟨2,1,-2⟩$ and $q=⟨3,2,0⟩.$ Find the exact value of the scalar projection of $p$ onto $q.$\n\n${\\text{comp}}_{q}\\,p=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{2\\cdot 3+1\\cdot 2+(-2)\\cdot 0}{\\sqrt{{3}^{2}+{2}^{2}+{0}^{2}}} \\\\  & =\\frac{8}{\\sqrt{13}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-275244/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036"] :knowledge-point/questions ["q-275244"] :db/ensure [:knowledge-point/validate]} {:db/id "q-101529/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "23c6799d-d769-53a4-a05d-0f24f735f159" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-101529/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "b88393da-6120-5acc-9337-a4c29e26e675" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-101529/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer/id #uuid "2beb6d99-5721-5b81-b258-f38cefe17cb1" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-101529/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "5d33cd9b-7afc-5f09-9efd-449b7e85677e" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-101529/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "198bb0b6-49d3-5215-9573-e0f1ba9abe89" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-101529/selection" :answer-field/id #uuid "0e75fe42-7171-56bb-82e1-1ce9148667d1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-101529/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-101529/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-101529/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-101529/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" "q-101529/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-101529/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-101529" :question/id #uuid "f391da49-b858-5b82-bce0-f8608ff7cc98" :question/math-academy-id "q-101529" :question/problem "Let $p=⟨1,\\sqrt{6},3⟩$ and $q=⟨-7,\\sqrt{6},3⟩.$ Find ${\\text{comp}}_{q}\\,p+{\\text{comp}}_{p}\\,q.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{1\\cdot (-7)+\\sqrt{6}\\cdot \\sqrt{6}+3\\cdot 3}{\\sqrt{(-7)^{2}+{\\sqrt{6}}^{2}+{3}^{2}}} \\\\  & =\\frac{8}{\\sqrt{64}} \\\\  & =1\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{p}\\,q & =\\frac{p\\cdot q}{|\\,p\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{p}_{x}^{2}+{p}_{y}^{2}+{p}_{z}^{2}}} \\\\  & =\\frac{8}{\\sqrt{{1}^{2}+{\\sqrt{6}}^{2}+{3}^{2}}} \\\\  & =\\frac{8}{\\sqrt{16}} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p+{\\text{comp}}_{p}\\,q & =1+2 \\\\  & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-101529/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036"] :knowledge-point/questions ["q-101529"] :db/ensure [:knowledge-point/validate]} {:db/id "q-319256/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "ca2add25-3529-52b3-b340-2eedecc0e375" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-319256/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "b1481793-c55c-5049-91f9-ed0b18ff0970" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-319256/field-1" :answer-field/id #uuid "0c9b1f01-a16f-55cc-88db-b9b06fb467fa" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-319256/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-319256/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-319256/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-319256" :question/id #uuid "08d3adde-2535-5271-b750-abe0a46d21cd" :question/math-academy-id "q-319256" :question/problem "Let $a=[\\begin{aligned}-2 \\\\ 5 \\\\ 1\\end{aligned}]$ and $b=[\\begin{aligned}3 \\\\ x \\\\ -4\\end{aligned}].$ Given that the scalar projection of $a$ onto $b$ is $0,$ find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z} \\\\  & =(-2)\\cdot 3+5\\cdot x+1\\cdot (-4) \\\\  & =5x-10.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}5x-10 & =0 \\\\ 5x & =10 \\\\ x & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-319256/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f"] :knowledge-point/questions ["q-319256"] :db/ensure [:knowledge-point/validate]} {:db/id "q-319171/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "fc76ae4a-05e5-51cd-b3d3-cc11e71454f2" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id 17592186275934 :answer-field/choices ["q-319171/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-319252/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "c481eb08-0dff-52c4-8a5a-7a97cef2247f" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-319252/field-1" :answer-field/id #uuid "efe481e5-d52b-5e9c-ba98-6d4ac7b3464b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-319252/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-319252/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-319252" :question/id #uuid "33e934e5-b1a5-58fa-978b-a2c4f60a64b5" :question/math-academy-id "q-319252" :question/problem "Let $p=2i-3j+k$ and $q=xi+4j.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =2\\cdot x+(-3)\\cdot 4+1\\cdot 0 \\\\  & =2x-12.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 2x-12 & =0 \\\\ 2x & =12 \\\\ x & =6.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-319252/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f"] :knowledge-point/questions ["q-319252"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-15608"] :question/problem "Let ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/assets/e477b14c9148f4132c747a358e1e99f76d40df85b82c66d6e7dd38581b33913c.png) and ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/assets/b17d86e3e395b2fd752f5529090c0a5e4e2fdce17642be5594bee98e8c47fed2.png) Find the scalar projection of $\\mathbf{a}$ onto $\\mathbf{b}.$" :db/ensure [:question/validate]}]
