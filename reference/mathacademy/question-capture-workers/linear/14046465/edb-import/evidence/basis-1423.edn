#{[{:db/id #edb/ref 17592186105411 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6" :knowledge-point/title "Calculating a Scalar Projection Using Angles and Magnitudes"}] :question/id #uuid "1a24b403-754c-5424-8182-8cad3487deed" :question/math-academy-id "e-15606" :question/problem "Suppose $|\\,\\mathbf{a}\\,|=13$ and the angle between vectors $\\mathbf{a}$ and $\\mathbf{b}$ is $\\theta = \\dfrac{2\\pi}{3}.$ Find the scalar projection of $\\mathbf{a}$ onto $\\mathbf{b}.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =|\\,a\\,|\\operatorname{cos}⁡\\theta  \\\\  & =13\\operatorname{cos}⁡(\\frac{2\\pi }{3}) \\\\  & =13\\cdot (-\\frac{1}{2}) \\\\  & =-\\frac{13}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105412 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/id #uuid "da8a1521-86cc-5747-88a7-e2ec56010c11" :question/math-academy-id "e-15607" :question/problem "Let $\\mathbf{a}=\\langle 3,3,-1 \\rangle$ and $\\mathbf{b}=\\langle 2,-7,0 \\rangle.$ Find the scalar projection of $\\mathbf{a}$ onto $\\mathbf{b}.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{3\\cdot 2+3\\cdot (-7)+(-1)\\cdot 0}{\\sqrt{{2}^{2}+(-7)^{2}+{0}^{2}}} \\\\  & =-\\frac{15}{\\sqrt{53}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105413 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/id #uuid "4693b28f-df75-574e-8e49-bb89e162b107" :question/math-academy-id "e-15608" :question/problem "Let $[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]$ and $[\\begin{aligned}2 \\\\ -4 \\\\ 0\\end{aligned}]$ Find the scalar projection of $\\mathbf{a}$ onto $\\mathbf{b}.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{c}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{0\\cdot 2+0\\cdot (-4)+1\\cdot 0}{\\sqrt{{2}^{2}+(-4)^{2}+{0}^{2}}} \\\\  & =\\frac{0}{\\sqrt{{2}^{2}+(-4)^{2}+{0}^{2}}} \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186306515 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b360b317-2ddd-56e7-bbce-073b28e9b7bc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{16}{21}" :db/id #edb/ref 17592186306517} {:answer/id #uuid "f988322b-3a51-54f8-ae3e-96abc9d89d40" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{7}" :db/id #edb/ref 17592186306518} {:answer/id #uuid "a291e390-37fa-55f4-bd08-e51118dc2ce1" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186306519} {:answer/id #uuid "008c994d-d127-523c-954f-ee5e191f61d3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{7}" :db/id #edb/ref 17592186306520} {:answer/id #uuid "d9e33301-a32b-5e8a-b475-3ff8dddcca16" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186306521}] :answer-field/correct {:answer/id #uuid "b360b317-2ddd-56e7-bbce-073b28e9b7bc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{16}{21}" :db/id #edb/ref 17592186306517} :answer-field/id #uuid "04de6a71-232e-5b57-822e-7fa6fe1505ab" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186306516}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e1ea5a15-b955-5f56-9693-5d850452583a" :question/math-academy-id "q-101528" :question/problem "Let $a=⟨2,-1,2⟩$ and $b=⟨6,2,-3⟩.$ Find ${\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{2\\cdot 6+(-1)\\cdot 2+2\\cdot (-3)}{\\sqrt{{6}^{2}+{2}^{2}+(-3)^{2}}} \\\\  & =\\frac{4}{\\sqrt{49}} \\\\  & =\\frac{4}{7}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{a}\\,b & =\\frac{b\\cdot a}{|\\,a\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}} \\\\  & =\\frac{4}{\\sqrt{{2}^{2}+(-1)^{2}+{2}^{2}}} \\\\  & =\\frac{4}{\\sqrt{9}} \\\\  & =\\frac{4}{3}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b & =\\frac{4}{7}-\\frac{4}{3} \\\\  & =4(\\frac{1}{7}-\\frac{1}{3}) \\\\  & =4(\\frac{3}{21}-\\frac{7}{21}) \\\\  & =-\\frac{16}{21}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186306522 :knowledge-point/_questions [{:knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6" :knowledge-point/title "Calculating a Scalar Projection Using Angles and Magnitudes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1673216b-bb5e-52ad-8245-a1e77f9c597e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186306524} {:answer/id #uuid "2772a0b1-e181-5003-8b5e-23abe30938fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186306525} {:answer/id #uuid "b2a32fbd-75a8-514a-b32c-0a04392fc7b3" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186306526} {:answer/id #uuid "fe074ee6-6095-581e-b352-3f0baee13f40" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186306527} {:answer/id #uuid "e43dbf93-e54d-5dc8-ae7a-f6d7ad348ffa" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186306528}] :answer-field/correct {:answer/id #uuid "fe074ee6-6095-581e-b352-3f0baee13f40" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186306527} :answer-field/id #uuid "30fdb03a-6e9a-598c-9c03-52813eb1ec68" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186306523}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "458b532b-3f7c-52f5-a53e-7171e61fa055" :question/math-academy-id "q-126498" :question/problem "Suppose $|\\,c\\,|=5$ and the angle between vectors $c$ and $d$ is $\\theta =\\frac{\\pi }{2}.$ Find the scalar projection of $c$ onto $d.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =|\\,c\\,|\\operatorname{cos}⁡\\theta  \\\\  & =5\\operatorname{cos}⁡(\\frac{\\pi }{2}) \\\\  & =5\\cdot 0 \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186306550 :knowledge-point/_questions [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "763365f5-a7b6-56af-b499-6b49a8baba4b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186306552}] :answer-field/correct {:answer/id #uuid "763365f5-a7b6-56af-b499-6b49a8baba4b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186306552} :answer-field/id #uuid "916c3fb5-e064-5a36-ab58-9496664a59c7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186306551}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f2a4a062-1d72-5aa1-8b04-33915ad48cf9" :question/math-academy-id "q-319255" :question/problem "Let $a=[\\begin{aligned}3 \\\\ -2 \\\\ 1\\end{aligned}]$ and $b=[\\begin{aligned}x \\\\ 1 \\\\ 2\\end{aligned}].$ Given that the scalar projection of $a$ onto $b$ is $0,$ find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =3\\cdot x+(-2)\\cdot 1+1\\cdot 2 \\\\  & =3x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 3x & =0 \\\\ x & =0.\\end{aligned}\n$$"}]}
