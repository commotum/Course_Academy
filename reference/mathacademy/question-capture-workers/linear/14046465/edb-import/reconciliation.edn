apture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-126498" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/activity-metadata.json" "file_sha256" "116abfe154838a6164d2dc5466f4720d03ebc4992780a9c9dbe8b22a380f4e02"} {"question" "q-126498" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-126498" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-5"] ["math" "-\\frac{5}{2}"] ["math" "0"] ["math" "5"] ["math" "\\frac{5}{2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-126498" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-318979" "field" nil "attribute" "question/problem" "value" "Let $a=⟨3,-2,1⟩$ and $b=⟨2,1,-2⟩.$ Find the scalar projection of $a$ onto $b.$\n\n${\\text{comp}}_{b}\\,a=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-318979" "field" nil "attribute" "question/worked-solution" "value" "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{(3)(2)+(-2)(1)+(1)(-2)}{\\sqrt{{2}^{2}+{1}^{2}+(-2)^{2}}} \\\\  & =\\frac{6-2-2}{\\sqrt{9}} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-318979" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/activity-metadata.json" "file_sha256" "116abfe154838a6164d2dc5466f4720d03ebc4992780a9c9dbe8b22a380f4e02"} {"question" "q-318979" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-318979" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{2}{3}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-18374" "field" nil "attribute" "question/problem" "value" "Let $p=⟨\\sqrt{2},1,-1⟩$ and $q=⟨\\sqrt{8},-\\sqrt{3},1⟩.$ Find the scalar projection of $p$ onto $q.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-18374" "field" nil "attribute" "question/worked-solution" "value" "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{\\sqrt{2}\\cdot \\sqrt{8}+1\\cdot (-\\sqrt{3})+(-1)\\cdot 1}{\\sqrt{(\\sqrt{8})^{2}+(-\\sqrt{3})^{2}+{1}^{2}}} \\\\  & =\\frac{3-\\sqrt{3}}{\\sqrt{12}} \\\\  & =\\frac{3-\\sqrt{3}}{2\\sqrt{3}} \\\\  & =\\frac{\\sqrt{3}-1}{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-18374" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/activity-metadata.json" "file_sha256" "116abfe154838a6164d2dc5466f4720d03ebc4992780a9c9dbe8b22a380f4e02"} {"question" "q-18374" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-18374" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "0"] ["math" "2"] ["math" "2\\sqrt{3}"] ["math" "\\frac{\\sqrt{3}-1}{2\\sqrt{3}}"] ["math" "\\frac{\\sqrt{3}-1}{2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-18374" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{\\sqrt{3}-1}{2}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-275244" "field" nil "attribute" "question/problem" "value" "Let $p=⟨2,1,-2⟩$ and $q=⟨3,2,0⟩.$ Find the exact value of the scalar projection of $p$ onto $q.$\n\n${\\text{comp}}_{q}\\,p=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-275244" "field" nil "attribute" "question/worked-solution" "value" "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{2\\cdot 3+1\\cdot 2+(-2)\\cdot 0}{\\sqrt{{3}^{2}+{2}^{2}+{0}^{2}}} \\\\  & =\\frac{8}{\\sqrt{13}}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-275244" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/activity-metadata.json" "file_sha256" "116abfe154838a6164d2dc5466f4720d03ebc4992780a9c9dbe8b22a380f4e02"} {"question" "q-275244" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-275244" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{8}{\\sqrt{13}}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-101528" "field" nil "attribute" "question/problem" "value" "Let $a=⟨2,-1,2⟩$ and $b=⟨6,2,-3⟩.$ Find ${\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-101528" "field" nil "attribute" "question/worked-solution" "value" "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{2\\cdot 6+(-1)\\cdot 2+2\\cdot (-3)}{\\sqrt{{6}^{2}+{2}^{2}+(-3)^{2}}} \\\\  & =\\frac{4}{\\sqrt{49}} \\\\  & =\\frac{4}{7}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{a}\\,b & =\\frac{b\\cdot a}{|\\,a\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}} \\\\  & =\\frac{4}{\\sqrt{{2}^{2}+(-1)^{2}+{2}^{2}}} \\\\  & =\\frac{4}{\\sqrt{9}} \\\\  & =\\frac{4}{3}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b & =\\frac{4}{7}-\\frac{4}{3} \\\\  & =4(\\frac{1}{7}-\\frac{1}{3}) \\\\  & =4(\\frac{3}{21}-\\frac{7}{21}) \\\\  & =-\\frac{16}{21}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-101528" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/activity-metadata.json" "file_sha256" "116abfe154838a6164d2dc5466f4720d03ebc4992780a9c9dbe8b22a380f4e02"} {"question" "q-101528" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-101528" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-\\frac{16}{21}"] ["math" "-\\frac{2}{7}"] ["math" "-\\frac{4}{3}"] ["math" "-\\frac{4}{7}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-101528" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{16}{21}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-101529" "field" nil "attribute" "question/problem" "value" "Let $p=⟨1,\\sqrt{6},3⟩$ and $q=⟨-7,\\sqrt{6},3⟩.$ Find ${\\text{comp}}_{q}\\,p+{\\text{comp}}_{p}\\,q.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-101529" "field" nil "attribute" "question/worked-solution" "value" "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{1\\cdot (-7)+\\sqrt{6}\\cdot \\sqrt{6}+3\\cdot 3}{\\sqrt{(-7)^{2}+{\\sqrt{6}}^{2}+{3}^{2}}} \\\\  & =\\frac{8}{\\sqrt{64}} \\\\  & =1\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{p}\\,q & =\\frac{p\\cdot q}{|\\,p\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{p}_{x}^{2}+{p}_{y}^{2}+{p}_{z}^{2}}} \\\\  & =\\frac{8}{\\sqrt{{1}^{2}+{\\sqrt{6}}^{2}+{3}^{2}}} \\\\  & =\\frac{8}{\\sqrt{16}} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p+{\\text{comp}}_{p}\\,q & =1+2 \\\\  & =3.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-101529" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/activity-metadata.json" "file_sha256" "116abfe154838a6164d2dc5466f4720d03ebc4992780a9c9dbe8b22a380f4e02"} {"question" "q-101529" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-101529" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "1"] ["math" "2"] ["math" "3"] ["math" "\\frac{1}{2}"] ["math" "\\frac{3}{2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-101529" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "3"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-319255" "field" nil "attribute" "question/problem" "value" "Let $a=[\\begin{aligned}3 \\\\ -2 \\\\ 1\\end{aligned}]$ and $b=[\\begin{aligned}x \\\\ 1 \\\\ 2\\end{aligned}].$ Given that the scalar projection of $a$ onto $b$ is $0,$ find the value of $x.$\n\n$x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-319255" "field" nil "attribute" "question/worked-solution" "value" "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =3\\cdot x+(-2)\\cdot 1+1\\cdot 2 \\\\  & =3x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 3x & =0 \\\\ x & =0.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-319255" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/activity-metadata.json" "file_sha256" "116abfe154838a6164d2dc5466f4720d03ebc4992780a9c9dbe8b22a380f4e02"} {"question" "q-319255" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-319255" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-319256" "field" nil "attribute" "question/problem" "value" "Let $a=[\\begin{aligned}-2 \\\\ 5 \\\\ 1\\end{aligned}]$ and $b=[\\begin{aligned}3 \\\\ x \\\\ -4\\end{aligned}].$ Given that the scalar projection of $a$ onto $b$ is $0,$ find the value of $x.$\n\n$x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-319256" "field" nil "attribute" "question/worked-solution" "value" "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z} \\\\  & =(-2)\\cdot 3+5\\cdot x+1\\cdot (-4) \\\\  & =5x-10.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}5x-10 & =0 \\\\ 5x & =10 \\\\ x & =2.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-319256" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/activity-metadata.json" "file_sha256" "116abfe154838a6164d2dc5466f4720d03ebc4992780a9c9dbe8b22a380f4e02"} {"question" "q-319256" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-319256" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-275256" "field" nil "attribute" "question/problem" "value" "Let $a=[\\begin{aligned}-1 \\\\ 2 \\\\ 4\\end{aligned}]$ and $b=[\\begin{aligned}0 \\\\ x \\\\ 2\\end{aligned}].$ Given that the scalar projection of $a$ onto $b$ is $0,$ find the value of $x.$\n\n$x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-275256" "field" nil "attribute" "question/worked-solution" "value" "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-1)\\cdot 0+2\\cdot x+4\\cdot 2 \\\\  & =2x+8.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 2x+8 & =0 \\\\ 2x & =-8 \\\\ x & =-4.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-275256" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/activity-metadata.json" "file_sha256" "116abfe154838a6164d2dc5466f4720d03ebc4992780a9c9dbe8b22a380f4e02"} {"question" "q-275256" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-275256" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-4"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-319171" "field" nil "attribute" "question/problem" "value" "Let $p=⟨4,1,-2⟩$ and $q=⟨1,x,3⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-319171" "field" nil "attribute" "question/worked-solution" "value" "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =4\\cdot 1+1\\cdot x+(-2)\\cdot 3 \\\\  & =x-2.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ x-2 & =0 \\\\ x & =2.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-319171" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/activity-metadata.json" "file_sha256" "116abfe154838a6164d2dc5466f4720d03ebc4992780a9c9dbe8b22a380f4e02"} {"question" "q-319171" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-319171" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-319252" "field" nil "attribute" "question/problem" "value" "Let $p=2i-3j+k$ and $q=xi+4j.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-319252" "field" nil "attribute" "question/worked-solution" "value" "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =2\\cdot x+(-3)\\cdot 4+1\\cdot 0 \\\\  & =2x-12.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 2x-12 & =0 \\\\ 2x & =12 \\\\ x & =6.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-319252" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/activity-metadata.json" "file_sha256" "116abfe154838a6164d2dc5466f4720d03ebc4992780a9c9dbe8b22a380f4e02"} {"question" "q-319252" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "q-319252" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "6"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/state.json" "file_sha256" "7669e053737b969ef851cac018c6723dff19eb302f201dcbb6c5526941f37aad"} {"question" "e-15606" "field" nil "attribute" "question/problem" "value" "Suppose $|\\,\\mathbf{a}\\,|=13$ and the angle between vectors $\\mathbf{a}$ and $\\mathbf{b}$ is $\\theta = \\dfrac{2\\pi}{3}.$ Find the scalar projection of $\\mathbf{a}$ onto $\\mathbf{b}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/example-15606.json" "file_sha256" "1c169543f3e4d5874063e25f1399b30d576b5294b3494ecc23cc172c197f7750"} {"question" "e-15606" "field" nil "attribute" "question/worked-solution" "value" "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =|\\,a\\,|\\operatorname{cos}⁡\\theta  \\\\  & =13\\operatorname{cos}⁡(\\frac{2\\pi }{3}) \\\\  & =13\\cdot (-\\frac{1}{2}) \\\\  & =-\\frac{13}{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/example-15606.json" "file_sha256" "1c169543f3e4d5874063e25f1399b30d576b5294b3494ecc23cc172c197f7750"} {"question" "e-15607" "field" nil "attribute" "question/problem" "value" "Let $\\mathbf{a}=\\langle 3,3,-1 \\rangle$ and $\\mathbf{b}=\\langle 2,-7,0 \\rangle.$ Find the scalar projection of $\\mathbf{a}$ onto $\\mathbf{b}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/example-15607.json" "file_sha256" "5c8443511f2a28783520e8e07f22baa9a83c725e576ec9e5002056034c74284a"} {"question" "e-15607" "field" nil "attribute" "question/worked-solution" "value" "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{3\\cdot 2+3\\cdot (-7)+(-1)\\cdot 0}{\\sqrt{{2}^{2}+(-7)^{2}+{0}^{2}}} \\\\  & =-\\frac{15}{\\sqrt{53}}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/example-15607.json" "file_sha256" "5c8443511f2a28783520e8e07f22baa9a83c725e576ec9e5002056034c74284a"} {"question" "e-15608" "field" nil "attribute" "question/problem" "value" "Let ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/assets/e477b14c9148f4132c747a358e1e99f76d40df85b82c66d6e7dd38581b33913c.png) and ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/assets/b17d86e3e395b2fd752f5529090c0a5e4e2fdce17642be5594bee98e8c47fed2.png) Find the scalar projection of $\\mathbf{a}$ onto $\\mathbf{b}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/example-15608.json" "file_sha256" "37b5f3b6f53d690937b883d07bc43fd8e283040140686fa0dffa80b6796b8a70"} {"question" "e-15608" "field" nil "attribute" "question/worked-solution" "value" "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{c}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{0\\cdot 2+0\\cdot (-4)+1\\cdot 0}{\\sqrt{{2}^{2}+(-4)^{2}+{0}^{2}}} \\\\  & =\\frac{0}{\\sqrt{{2}^{2}+(-4)^{2}+{0}^{2}}} \\\\  & =0.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Deve