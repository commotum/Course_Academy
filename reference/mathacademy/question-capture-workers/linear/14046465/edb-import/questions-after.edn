#{[{:db/id #edb/ref 17592186105411 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6" :knowledge-point/title "Calculating a Scalar Projection Using Angles and Magnitudes"}] :question/id #uuid "1a24b403-754c-5424-8182-8cad3487deed" :question/math-academy-id "e-15606" :question/problem "Suppose $|\\,\\mathbf{a}\\,|=13$ and the angle between vectors $\\mathbf{a}$ and $\\mathbf{b}$ is $\\theta = \\dfrac{2\\pi}{3}.$ Find the scalar projection of $\\mathbf{a}$ onto $\\mathbf{b}.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =|\\,a\\,|\\operatorname{cos}⁡\\theta  \\\\  & =13\\operatorname{cos}⁡(\\frac{2\\pi }{3}) \\\\  & =13\\cdot (-\\frac{1}{2}) \\\\  & =-\\frac{13}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105412 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/id #uuid "da8a1521-86cc-5747-88a7-e2ec56010c11" :question/math-academy-id "e-15607" :question/problem "Let $\\mathbf{a}=\\langle 3,3,-1 \\rangle$ and $\\mathbf{b}=\\langle 2,-7,0 \\rangle.$ Find the scalar projection of $\\mathbf{a}$ onto $\\mathbf{b}.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{3\\cdot 2+3\\cdot (-7)+(-1)\\cdot 0}{\\sqrt{{2}^{2}+(-7)^{2}+{0}^{2}}} \\\\  & =-\\frac{15}{\\sqrt{53}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105413 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/id #uuid "4693b28f-df75-574e-8e49-bb89e162b107" :question/math-academy-id "e-15608" :question/problem "Let ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/assets/e477b14c9148f4132c747a358e1e99f76d40df85b82c66d6e7dd38581b33913c.png) and ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14046465/assets/b17d86e3e395b2fd752f5529090c0a5e4e2fdce17642be5594bee98e8c47fed2.png) Find the scalar projection of $\\mathbf{a}$ onto $\\mathbf{b}.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{c}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{0\\cdot 2+0\\cdot (-4)+1\\cdot 0}{\\sqrt{{2}^{2}+(-4)^{2}+{0}^{2}}} \\\\  & =\\frac{0}{\\sqrt{{2}^{2}+(-4)^{2}+{0}^{2}}} \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186306515 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b360b317-2ddd-56e7-bbce-073b28e9b7bc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{16}{21}" :db/id #edb/ref 17592186306517} {:answer/id #uuid "f988322b-3a51-54f8-ae3e-96abc9d89d40" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{7}" :db/id #edb/ref 17592186306518} {:answer/id #uuid "a291e390-37fa-55f4-bd08-e51118dc2ce1" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186306519} {:answer/id #uuid "008c994d-d127-523c-954f-ee5e191f61d3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{7}" :db/id #edb/ref 17592186306520} {:answer/id #uuid "d9e33301-a32b-5e8a-b475-3ff8dddcca16" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186306521}] :answer-field/correct {:answer/id #uuid "b360b317-2ddd-56e7-bbce-073b28e9b7bc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{16}{21}" :db/id #edb/ref 17592186306517} :answer-field/id #uuid "04de6a71-232e-5b57-822e-7fa6fe1505ab" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186306516}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e1ea5a15-b955-5f56-9693-5d850452583a" :question/math-academy-id "q-101528" :question/problem "Let $a=⟨2,-1,2⟩$ and $b=⟨6,2,-3⟩.$ Find ${\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{2\\cdot 6+(-1)\\cdot 2+2\\cdot (-3)}{\\sqrt{{6}^{2}+{2}^{2}+(-3)^{2}}} \\\\  & =\\frac{4}{\\sqrt{49}} \\\\  & =\\frac{4}{7}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{a}\\,b & =\\frac{b\\cdot a}{|\\,a\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}} \\\\  & =\\frac{4}{\\sqrt{{2}^{2}+(-1)^{2}+{2}^{2}}} \\\\  & =\\frac{4}{\\sqrt{9}} \\\\  & =\\frac{4}{3}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b & =\\frac{4}{7}-\\frac{4}{3} \\\\  & =4(\\frac{1}{7}-\\frac{1}{3}) \\\\  & =4(\\frac{3}{21}-\\frac{7}{21}) \\\\  & =-\\frac{16}{21}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186325632 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b88393da-6120-5acc-9337-a4c29e26e675" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186325634} {:answer/id #uuid "5d33cd9b-7afc-5f09-9efd-449b7e85677e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186325635} {:answer/id #uuid "23c6799d-d769-53a4-a05d-0f24f735f159" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186325636} {:answer/id #uuid "198bb0b6-49d3-5215-9573-e0f1ba9abe89" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186325637} {:answer/id #uuid "2beb6d99-5721-5b81-b258-f38cefe17cb1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186325638}] :answer-field/correct {:answer/id #uuid "b88393da-6120-5acc-9337-a4c29e26e675" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186325634} :answer-field/id #uuid "0e75fe42-7171-56bb-82e1-1ce9148667d1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186325633}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f391da49-b858-5b82-bce0-f8608ff7cc98" :question/math-academy-id "q-101529" :question/problem "Let $p=⟨1,\\sqrt{6},3⟩$ and $q=⟨-7,\\sqrt{6},3⟩.$ Find ${\\text{comp}}_{q}\\,p+{\\text{comp}}_{p}\\,q.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{1\\cdot (-7)+\\sqrt{6}\\cdot \\sqrt{6}+3\\cdot 3}{\\sqrt{(-7)^{2}+{\\sqrt{6}}^{2}+{3}^{2}}} \\\\  & =\\frac{8}{\\sqrt{64}} \\\\  & =1\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{p}\\,q & =\\frac{p\\cdot q}{|\\,p\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{p}_{x}^{2}+{p}_{y}^{2}+{p}_{z}^{2}}} \\\\  & =\\frac{8}{\\sqrt{{1}^{2}+{\\sqrt{6}}^{2}+{3}^{2}}} \\\\  & =\\frac{8}{\\sqrt{16}} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p+{\\text{comp}}_{p}\\,q & =1+2 \\\\  & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186306522 :knowledge-point/_questions [{:knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6" :knowledge-point/title "Calculating a Scalar Projection Using Angles and Magnitudes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1673216b-bb5e-52ad-8245-a1e77f9c597e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186306524} {:answer/id #uuid "2772a0b1-e181-5003-8b5e-23abe30938fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186306525} {:answer/id #uuid "b2a32fbd-75a8-514a-b32c-0a04392fc7b3" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186306526} {:answer/id #uuid "fe074ee6-6095-581e-b352-3f0baee13f40" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186306527} {:answer/id #uuid "e43dbf93-e54d-5dc8-ae7a-f6d7ad348ffa" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186306528}] :answer-field/correct {:answer/id #uuid "fe074ee6-6095-581e-b352-3f0baee13f40" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186306527} :answer-field/id #uuid "30fdb03a-6e9a-598c-9c03-52813eb1ec68" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186306523}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "458b532b-3f7c-52f5-a53e-7171e61fa055" :question/math-academy-id "q-126498" :question/problem "Suppose $|\\,c\\,|=5$ and the angle between vectors $c$ and $d$ is $\\theta =\\frac{\\pi }{2}.$ Find the scalar projection of $c$ onto $d.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =|\\,c\\,|\\operatorname{cos}⁡\\theta  \\\\  & =5\\operatorname{cos}⁡(\\frac{\\pi }{2}) \\\\  & =5\\cdot 0 \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106023 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "846fec6b-0634-527c-95c2-25754ce33c08" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186102376} {:answer/id #uuid "98084e96-1175-5ccb-9f1b-d2c905265afd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3} - 1}{2\\sqrt{3}}" :db/id #edb/ref 17592186102377} {:answer/id #uuid "cda2fdc1-166a-5b7a-b0ce-a12be6fe892a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3} - 1}{2}" :db/id #edb/ref 17592186102378} {:answer/id #uuid "fdd1d530-3fe4-537c-8416-40b990c1ef12" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186102379} {:answer/id #uuid "22d7a360-bc93-5f42-9551-0ca7a207abd2" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186102380}] :answer-field/correct {:answer/id #uuid "cda2fdc1-166a-5b7a-b0ce-a12be6fe892a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3} - 1}{2}" :db/id #edb/ref 17592186102378} :answer-field/id #uuid "5a6ff4f7-e72a-5c98-af10-7d1e281c3900" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186102375}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1e48bd53-4841-5a1d-adee-85eb3b590727" :question/math-academy-id "q-18374" :question/problem "Let $p=⟨\\sqrt{2},1,-1⟩$ and $q=⟨\\sqrt{8},-\\sqrt{3},1⟩.$ Find the scalar projection of $p$ onto $q.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{\\sqrt{2}\\cdot \\sqrt{8}+1\\cdot (-\\sqrt{3})+(-1)\\cdot 1}{\\sqrt{(\\sqrt{8})^{2}+(-\\sqrt{3})^{2}+{1}^{2}}} \\\\  & =\\frac{3-\\sqrt{3}}{\\sqrt{12}} \\\\  & =\\frac{3-\\sqrt{3}}{2\\sqrt{3}} \\\\  & =\\frac{\\sqrt{3}-1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186325639 :knowledge-point/_questions [{:knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6" :knowledge-point/title "Calculating a Scalar Projection Using Angles and Magnitudes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7bd91897-2135-5487-93f8-bc117a2a984f" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186325641} {:answer/id #uuid "3ed87f31-da7e-5477-a243-91ce92941c0b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186325642}] :answer-field/correct {:answer/id #uuid "3ed87f31-da7e-5477-a243-91ce92941c0b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186325642} :answer-field/id #uuid "25b61378-09a7-51dd-bde9-f225b89ee7ab" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186325640}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "2b0cb2d9-f792-50a5-b3a3-ff6be552240e" :question/math-academy-id "q-275243" :question/problem "Suppose $|\\,c\\,|=4$ and the angle between vectors $c$ and $d$ is $\\theta =\\frac{\\pi }{2}.$ Find the scalar projection of $c$ onto $d.$\n\n${\\text{comp}}_{d}\\,c=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =|\\,c\\,|\\operatorname{cos}⁡\\theta  \\\\  & =4\\operatorname{cos}⁡(\\frac{\\pi }{2}) \\\\  & =4\\cdot 0 \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186325643 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "379dcbef-4c41-513f-8577-7563a279e9c1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{\\sqrt{13}}" :db/id #edb/ref 17592186325645}] :answer-field/correct {:answer/id #uuid "379dcbef-4c41-513f-8577-7563a279e9c1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{\\sqrt{13}}" :db/id #edb/ref 17592186325645} :answer-field/id #uuid "4a97814c-22dd-5e52-b37f-cc2496d165e1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186325644}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "58e692ad-2f21-5e36-851a-c003694ad570" :question/math-academy-id "q-275244" :question/problem "Let $p=⟨2,1,-2⟩$ and $q=⟨3,2,0⟩.$ Find the exact value of the scalar projection of $p$ onto $q.$\n\n${\\text{comp}}_{q}\\,p=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{2\\cdot 3+1\\cdot 2+(-2)\\cdot 0}{\\sqrt{{3}^{2}+{2}^{2}+{0}^{2}}} \\\\  & =\\frac{8}{\\sqrt{13}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275290 :knowledge-point/_questions [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e91d1d3b-1185-52e5-a2b0-ca758b020b9e" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186275292}] :answer-field/correct {:answer/id #uuid "e91d1d3b-1185-52e5-a2b0-ca758b020b9e" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186275292} :answer-field/id #uuid "825cc115-7959-55bc-9a6d-6100726bc4e5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275291}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d1067d56-4d83-5281-8c53-6dfcd93ed0f2" :question/math-academy-id "q-275256" :question/problem "Let $a=[\\begin{aligned}-1 \\\\ 2 \\\\ 4\\end{aligned}]$ and $b=[\\begin{aligned}0 \\\\ x \\\\ 2\\end{aligned}].$ Given that the scalar projection of $a$ onto $b$ is $0,$ find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-1)\\cdot 0+2\\cdot x+4\\cdot 2 \\\\  & =2x+8.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 2x+8 & =0 \\\\ 2x & =-8 \\\\ x & =-4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186325646 :knowledge-point/_questions [{:knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6" :knowledge-point/title "Calculating a Scalar Projection Using Angles and Magnitudes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c7a4be6-9f75-5e5a-b703-b61695fa0539" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{2}" :db/id #edb/ref 17592186325648}] :answer-field/correct {:answer/id #uuid "5c7a4be6-9f75-5e5a-b703-b61695fa0539" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{2}" :db/id #edb/ref 17592186325648} :answer-field/id #uuid "a3b0342d-276c-53d6-857f-42e68c054f5a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186325647}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "15c589ac-c774-565c-a921-9c4aacc2fd5a" :question/math-academy-id "q-318964" :question/problem "Suppose $|\\,k\\,|=2\\sqrt{2}$ and the angle between vectors $k$ and $l$ is $\\theta ={120}^{∘}.$ Find the scalar projection of $k$ onto $l.$\n\n${\\text{comp}}_{l}\\,k=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{l}\\,k & =|\\,k\\,|\\operatorname{cos}⁡\\theta  \\\\  & =2\\sqrt{2}\\operatorname{cos}⁡({120}^{∘}) \\\\  & =2\\sqrt{2}\\cdot (-\\frac{1}{2}) \\\\  & =-\\sqrt{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275293 :knowledge-point/_questions [{:knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6" :knowledge-point/title "Calculating a Scalar Projection Using Angles and Magnitudes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52455008-c333-5dd1-92b4-72b4768f2da6" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186275295} {:answer/id #uuid "7d986a92-797b-5087-9f7a-aac8121a7b82" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186325649}] :answer-field/correct {:answer/id #uuid "52455008-c333-5dd1-92b4-72b4768f2da6" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186275295} :answer-field/id #uuid "ec7d6cad-97ac-539c-a22f-fd918e59492a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275294}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "4153b8de-c0c0-52e9-920b-bb4a1839c543" :question/math-academy-id "q-318971" :question/problem "Suppose $|\\,r\\,|=10$ and the angle between vectors $r$ and $s$ is $\\theta =\\frac{2\\pi }{3}.$ Find the scalar projection of $r$ onto $s.$\n\n${\\text{comp}}_{s}\\,r=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{s}\\,r & =|\\,r\\,|\\operatorname{cos}⁡\\theta  \\\\  & =10cos\\,(\\frac{2\\pi }{3}) \\\\  & =10\\cdot (-\\frac{1}{2}) \\\\  & =-5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186325650 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29fc626e-908a-5210-bc9b-c842034bf3a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186325652}] :answer-field/correct {:answer/id #uuid "29fc626e-908a-5210-bc9b-c842034bf3a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186325652} :answer-field/id #uuid "0c6e7d34-eda1-5901-af72-e7495be58b3b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186325651}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1ab23067-0b24-53fd-9375-d57deff25b7a" :question/math-academy-id "q-318979" :question/problem "Let $a=⟨3,-2,1⟩$ and $b=⟨2,1,-2⟩.$ Find the scalar projection of $a$ onto $b.$\n\n${\\text{comp}}_{b}\\,a=$\n{{field-1}}" :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{(3)(2)+(-2)(1)+(1)(-2)}{\\sqrt{{2}^{2}+{1}^{2}+(-2)^{2}}} \\\\  & =\\frac{6-2-2}{\\sqrt{9}} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275933 :knowledge-point/_questions [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bcf84f5-af7e-5e1c-b912-1c3500934064" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186275935} {:answer/id #uuid "fc76ae4a-05e5-51cd-b3d3-cc11e71454f2" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186325653}] :answer-field/correct {:answer/id #uuid "1bcf84f5-af7e-5e1c-b912-1c3500934064" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186275935} :answer-field/id #uuid "37da1b28-1191-5323-840a-68f8d18e3a4a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275934}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "693153e1-7945-56bf-830b-01e6c2d76a16" :question/math-academy-id "q-319171" :question/problem "Let $p=⟨4,1,-2⟩$ and $q=⟨1,x,3⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =4\\cdot 1+1\\cdot x+(-2)\\cdot 3 \\\\  & =x-2.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ x-2 & =0 \\\\ x & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186325654 :knowledge-point/_questions [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c481eb08-0dff-52c4-8a5a-7a97cef2247f" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186325656}] :answer-field/correct {:answer/id #uuid "c481eb08-0dff-52c4-8a5a-7a97cef2247f" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186325656} :answer-field/id #uuid "efe481e5-d52b-5e9c-ba98-6d4ac7b3464b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186325655}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "33e934e5-b1a5-58fa-978b-a2c4f60a64b5" :question/math-academy-id "q-319252" :question/problem "Let $p=2i-3j+k$ and $q=xi+4j.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =2\\cdot x+(-3)\\cdot 4+1\\cdot 0 \\\\  & =2x-12.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 2x-12 & =0 \\\\ 2x & =12 \\\\ x & =6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186306550 :knowledge-point/_questions [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "763365f5-a7b6-56af-b499-6b49a8baba4b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186306552}] :answer-field/correct {:answer/id #uuid "763365f5-a7b6-56af-b499-6b49a8baba4b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186306552} :answer-field/id #uuid "916c3fb5-e064-5a36-ab58-9496664a59c7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186306551}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f2a4a062-1d72-5aa1-8b04-33915ad48cf9" :question/math-academy-id "q-319255" :question/problem "Let $a=[\\begin{aligned}3 \\\\ -2 \\\\ 1\\end{aligned}]$ and $b=[\\begin{aligned}x \\\\ 1 \\\\ 2\\end{aligned}].$ Given that the scalar projection of $a$ onto $b$ is $0,$ find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =3\\cdot x+(-2)\\cdot 1+1\\cdot 2 \\\\  & =3x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 3x & =0 \\\\ x & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186325657 :knowledge-point/_questions [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ca2add25-3529-52b3-b340-2eedecc0e375" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186325659} {:answer/id #uuid "b1481793-c55c-5049-91f9-ed0b18ff0970" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186325660}] :answer-field/correct {:answer/id #uuid "ca2add25-3529-52b3-b340-2eedecc0e375" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186325659} :answer-field/id #uuid "0c9b1f01-a16f-55cc-88db-b9b06fb467fa" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186325658}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "08d3adde-2535-5271-b750-abe0a46d21cd" :question/math-academy-id "q-319256" :question/problem "Let $a=[\\begin{aligned}-2 \\\\ 5 \\\\ 1\\end{aligned}]$ and $b=[\\begin{aligned}3 \\\\ x \\\\ -4\\end{aligned}].$ Given that the scalar projection of $a$ onto $b$ is $0,$ find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z} \\\\  & =(-2)\\cdot 3+5\\cdot x+1\\cdot (-4) \\\\  & =5x-10.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}5x-10 & =0 \\\\ 5x & =10 \\\\ x & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186325661 :knowledge-point/_questions [{:knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6" :knowledge-point/title "Calculating a Scalar Projection Using Angles and Magnitudes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f042bcf6-6c0e-5a30-9948-63a5c34edf24" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186325663} {:answer/id #uuid "8a23bddc-bf75-54ba-ac6a-776d368bf3c0" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186325664} {:answer/id #uuid "ee94829a-cf90-5bd6-b4ff-17addb05fc47" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186325665} {:answer/id #uuid "2c2fab71-07da-5777-97fc-58739d2a11ea" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{2}}{2}" :db/id #edb/ref 17592186325666} {:answer/id #uuid "cf54d300-6435-5a5d-91fd-03ff865d0fbd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186325667}] :answer-field/correct {:answer/id #uuid "f042bcf6-6c0e-5a30-9948-63a5c34edf24" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186325663} :answer-field/id #uuid "3975484c-8809-5dab-9b2d-57d000d834a3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186325662}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ebf6f7b3-db73-58f2-8132-9775b13e2d37" :question/math-academy-id "q-71530" :question/problem "Suppose $|\\,p\\,|=3\\sqrt{2}$ and the angle between vectors $p$ and $q$ is $\\theta =\\frac{\\pi }{4}.$ Find the scalar projection of $p$ onto $q.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =|\\,p\\,|\\operatorname{cos}⁡\\theta  \\\\  & =3\\sqrt{2}\\operatorname{cos}⁡(\\frac{\\pi }{4}) \\\\  & =3\\sqrt{2}\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =3.\\end{aligned}\n$$"}]}
