egin{aligned}1 & -3 \\\\ -3 & 1 \\\\ 4 & -2\\end{aligned}],\\,v=[\\begin{aligned}4 \\\\ -2\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14057898/state.json" "file_sha256" "d78ea8834cbee5c6daec59d5780adf8820695fd813402ec7a58885362f1a96b8"} {"question" "q-38270" "field" nil "attribute" "question/worked-solution" "value" "Using the fact that $\\,T(v)=T\\cdot v,$ we get\n\n$$\n\\begin{aligned}T(v) & =T\\cdot v \\\\  & =[\\begin{aligned}1 & -3 \\\\ -3 & 1 \\\\ 4 & -2\\end{aligned}]\\cdot [\\begin{aligned}4 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}10 \\\\ -14 \\\\ 20\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14057898/state.json" "file_sha256" "d78ea8834cbee5c6daec59d5780adf8820695fd813402ec7a58885362f1a96b8"} {"question" "q-38270" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14057898/activity-metadata.json" "file_sha256" "d2e764c3b4cab3bf4fbd7cda219a1ed6f0e07fb2a2d3992b436a11f4e061a0ce"} {"question" "q-38270" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14057898/state.json" "file_sha256" "d78ea8834cbee5c6daec59d5780adf8820695fd813402ec7a58885362f1a96b8"} {"question" "q-38270" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}0 \\\\ -4 \\\\ 0\\end{aligned}]"] ["math" "[\\begin{aligned}1 \\\\ -1 \\\\ 2\\end{aligned}]"] ["math" "[\\begin{aligned}10 \\\\ -14 \\\\ 20\\end{aligned}]"] ["math" "[\\begin{aligned}14 \\\\ -10 \\\\ 20\\end{aligned}]"] ["math" "[\\begin{aligned}20 \\\\ -14 \\\\ 10\\end{aligned}]"]] "