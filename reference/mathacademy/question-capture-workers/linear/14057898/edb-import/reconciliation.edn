\\\ y \\\\ z\\end{aligned}]\\,$ we have\n\n$$\n\\begin{aligned}[\\begin{aligned}7 & 2 & -5 \\\\ 3 & 0 & -3\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}7x+2y-5z \\\\ 3x-3z\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the linear transformation $T$ is given by\n\n$$\nT:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}7x+2y+(-5)z \\\\ 3x-3z\\end{aligned}].\n$$\n\nFinally, $a+b=(-5)+3=-2.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14057898/state.json" "file_sha256" "d78ea8834cbee5c6daec59d5780adf8820695fd813402ec7a58885362f1a96b8"} {"question" "q-96974" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14057898/activity-metadata.json" "file_sha256" "d2e764c3b4cab3bf4fbd7cda219a1ed6f0e07fb2a2d3992b436a11f4e061a0ce"} {"question" "q-96974" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14057898/state.json" "file_sha256" "d78ea8834cbee5c6daec59d5780adf8820695fd813402ec7a58885362f1a96b8"} {"question" "q-96974" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2"] ["math" "-5"] ["math" "3"] ["math" "4"] ["math" "8"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14057898/state.json" "file_sha256" "d78ea8834cbee5c6daec59d5780adf8820695fd813402ec7a58885362f1a96b8"} {"question" "q-96974" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14057898/state.json" "f