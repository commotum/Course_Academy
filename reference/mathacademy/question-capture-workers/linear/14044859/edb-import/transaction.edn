053382c46a4ada256a5e84c6e1d5947c0f96ab9fc99ce1388d130225" "q-35583/selection/ma-v1/38961ba9559ca9e70a0db19d4efebeaecd2e410ce1773eebacba23f560029843/c1a3741d94f96afa3cb61aec300c6abad6fd918a6b05ded4de8086fc2516e37d"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-35583"] :question/problem "From top to bottom, fill in the blanks and hence complete the proof of the following statement using the axioms $[\\text{A}1]-[\\text{A}8]$ given below.\n\n*Statement: *\n\n*$\\alpha 0=0$ for any $\\alpha \\in R$*\n\n*Proof:*\n\n$$\n\\begin{aligned}\\alpha 0 & =\\alpha 0 &  & [\\,\\text{given}\\,] \\\\ \\alpha 0 & =\\alpha (0+0) &  & [\\,\\text{axiom A3}\\,] \\\\ \\alpha 0 & =\\alpha 0+\\alpha 0 &  & [\\,\\text{axiom __}\\,\\,] \\\\ \\alpha 0+(-\\alpha 0) & =(\\alpha 0+\\alpha 0)+(-\\alpha 0) &  & [\\,\\text{add }-\\alpha 0\\text{ to both sides}\\,] \\\\ \\alpha 0+(-\\alpha 0) & =\\alpha 0+(\\alpha 0+(-\\alpha 0)) &  & [\\,\\text{axiom A2}\\,] \\\\ 0 & =\\alpha 0+0 &  & [\\,\\text{axiom A4}\\,] \\\\ 0 & =\\alpha 0 &  & [\\,\\text{axiom __}\\,\\,]\\end{aligned}\n$$\n\nThe axioms:\n\n$$\n\\begin{aligned}\\text{[A1]}:x+y=y+x & \\text{[A5]}:1\\cdot x=x \\\\ \\text{[A2]}:(x+y)+z=x+(y+z) & \\text{[A6]}:\\alpha (\\beta x)=(\\alpha \\beta )x \\\\ \\text{[A3]}:x+0=x & \\text{[A7]}:(\\alpha +\\beta )x=\\alpha x+\\beta x \\\\ \\text{[A4]}:x+(-x)=0 & \\text{[A8]}:\\alpha (x+y)=\\alpha x+\\alpha y\\end{aligned}\n$$" :question/worked-solution "Using the vector space axioms, we obtain the following:\n\n$$\n\\begin{aligned}\\alpha 0 & =\\alpha 0 &  & [\\,\\text{given}\\,] \\\\ \\alpha 0 & =\\alpha (0+0) &  & [\\,\\text{axiom A3}\\,] \\\\ \\alpha 0 & =\\alpha 0+\\alpha 0 &  & [\\,\\text{axiom }\\text{A8}\\,] \\\\ \\alpha 0+(-\\alpha 0) & =(\\alpha 0+\\alpha 0)+(-\\alpha 0) &  & [\\,\\text{add }-\\alpha 0\\text{ to both sides}\\,] \\\\ \\alpha 0+(-\\alpha 0) & =\\alpha 0+(\\alpha 0+(-\\alpha 0)) &  & [\\,\\text{axiom A2}\\,] \\\\ 0 & =\\alpha 0+0 &  & [\\,\\text{axiom A4}\\,] \\\\ 0 & =\\alpha 0 &  & [\\,\\text{axiom }\\text{A3}\\,]\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-35583/selection/ma-v1/38961ba9559ca9e70a0db19d4efebeaecd2e410ce1773eebacba23f560029843"] :db/ensure [:question/validate]} {:db/id "q-35661/selection/eb8b629ca749d3a3a588c7ede443b3fe5710b22dd0f1debc2ea8614f2bf97529" :answer/id #uuid "120f31c2-16f8-54b3-90a0-b99ea0569132" :answer/type :answer.type/text :answer/value "$\\text{A1}$, $\\text{A2}$" :db/ensure [:answer/validate]} {:db/id "q-35661/selection/9f8888e87a63ef77d671ed2f3db2e97cbd35b9a4a8059178c411958fffe8ac2f" :answer/id #uuid "090fbb82-f0dd-5293-8ff1-7e25fba362b0" :answer/type :answer.type/text :answer/value "$\\text{A4}$, $\\text{A4}$" :db/ensure [:answer/validate]} {:db/id "q-35661/selection/555a2a073ef60ef8036d08ae203d2837c9203c3bdcd844cbf1a49fe6d6977236" :answer/id #uuid "4b61e1fd-47f4-539d-b2cb-37742b51f971" :answer/type :answer.type/text :answer/value "$\\text{A7}$, $\\text{A3}$" :db/ensure [:answer/validate]} {:db/id "q-35661/selection/2df53d7033d468a797adc4e4a7e243c9e98f6c84849b9c640422aa67819abd59" :answer/id #uuid "55f4c348-8f34-53f9-bd7d-799cddd41196" :answer/type :answer.type/text :answer/value "$\\text{A4}$, $\\text{A3}$" :db/ensure [:answer/validate]} {:db/id "q-35661/selection/236d6c45e7a5cb9066dd1a98b91314ad3a806428a4483a98170e14d49f4f405c" :answer/id #uuid "85c6f6e5-4fb3-5bf2-9df5-d7a359e739e4" :answer/type :answer.type/text :answer/value "$\\text{A2}$, $\\text{A7}$" :db/ensure [:answer/validate]} {:db/id "q-35661/selection" :answer-field/id #uuid "10a64892-d71e-5fea-9ec1-bf18a0f6b21b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-35661/selection/2df53d7033d468a797adc4e4a7e243c9e98f6c84849b9c640422aa67819abd59" :answer-field/choices ["q-35661/selection/eb8b629ca749d3a3a588c7ede443b3fe5710b22dd0f1debc2ea8614f2bf97529" "q-35661/selection/9f8888e87a63ef77d671ed2f3db2e97cbd35b9a4a8059178c411958fffe8ac2f" "q-35661/selection/555a2a073ef60ef8036d08ae203d2837c9203c3bdcd844cbf1a49fe6d6977236" "q-35661/selection/2df53d7033d468a797adc4e4a7e243c9e98f6c84849b9c640422aa67819abd59" "q-35661/selection/236d6c45e7a5cb9066dd1a98b91314ad3a806428a4483a98170e14d49f4f405c"] :db/ensure [:answer-field/validate]} {:db/id "q-35661" :question/id #uuid "0e20fac2-93b2-5854-b480-093fb40bcf26" :question/math-academy-id "q-35661" :question/problem "From top to bottom, fill in the blanks and hence complete the proof of the following statement using the axioms $[\\text{A}1]-[\\text{A}8]$ given below.\n\n*Statement:* \n\n*If $w$ is a vector such that $w+w=w$, then $w=0$* \n\n*Proof:*\n\n$$\n\\begin{aligned}w+w & =w &  & [\\,\\text{given}\\,] \\\\ (w+w)+(-w) & =w+(-w) &  & [\\,\\text{add }(-w)\\text{ to both sides}\\,] \\\\ w+(w+(-w)) & =w+(-w) &  & [\\,\\text{axiom A2}\\,] \\\\ w+0 & =0 &  & [\\,\\text{axiom __}\\,\\,] \\\\ w & =0 &  & [\\,\\text{axiom __}\\,\\,]\\end{aligned}\n$$\n\nThe axioms:\n\n$$\n\\begin{aligned}\\text{[A1]}:x+y=y+x & \\text{[A5]}:1\\cdot x=x \\\\ \\text{[A2]}:(x+y)+z=x+(y+z) & \\text{[A6]}:\\alpha (\\beta x)=(\\alpha \\beta )x \\\\ \\text{[A3]}:x+0=x & \\text{[A7]}:(\\alpha +\\beta )x=\\alpha x+\\beta x \\\\ \\text{[A4]}:x+(-x)=0 & \\text{[A8]}:\\alpha (x+y)=\\alpha x+\\alpha y\\end{aligned}\n$$" :question/worked-solution "Using the vector space axioms, we obtain the following: \n\n$$\n\\begin{aligned}w+w & =w &  & [\\,\\text{given}\\,] \\\\ (w+w)+(-w) & =w+(-w) &  & [\\,\\text{add }(-w)\\text{ to both sides}\\,] \\\\ w+(w+(-w)) & =w+(-w) &  & [\\,\\text{axiom A2}\\,] \\\\ w+0 & =0 &  & [\\,\\text{axiom }\\text{A4}\\,] \\\\ w & =0 &  & [\\,\\text{axiom }\\text{A3}\\,]\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-35661/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9bdb6bc9-47e2-5330-a1ee-270882f2aced"] :knowledge-point/questions ["q-35661"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-8224"] :question/problem "Let $V$ be the set of all real polynomials of degree exactly $3$, equipped with the usual addition and scalar multiplication operations. Complete the following sentence:\n\n*$V$ is **not** a vector space because $\\textrm{_________}\\,.$*\n\n- the sum of two polynomials of degree $3$ may not be a polynomial of degree $3$\n\n- $V$ does not contain the polynomial $-p(x)$ for every $p(x) \\in V$\n\n- addition of polynomials is not commutative" :question/worked-solution "The correct answer  is as follows:\n\n*$V$ is **not** a vector space because **the sum of two polynomials of degree $3$ may not be a polynomial of degree $3$.** *\n\nFor instance, if $p(x) = 1 +x^3$ and $q(x) = 1-x^3$, then $p(x)$ and $q(x)$ are in $V.$ However  \n\n$$\n\\begin{aligned}p(x)+q(x) & =(1+{x}^{3})+(1-{x}^{3}) \\\\  & =2\\notin V.\\end{aligned}\n$$\n\nOn the other hand:\n\n- Addition of polynomials is commutative.\n\n- For any polynomial $p(x)$ of degree $3$, the corresponding negative polynomial $-p(x)$ also has degree $3.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4792"] :question/problem "From top to bottom, fill in the blanks and hence complete the proof of the following statement using the axioms $[\\textrm A1] - [\\textrm A8]$ given below.\n\n*Statement: *\n\n*If $\\mathbf{w}$ is a vector such that $\\mathbf{w}+\\mathbf{w} = \\mathbf{w}$, then $\\mathbf{w}=\\mathbf{0}.$* \n\n*Proof:*\n\n$$\n\\begin{aligned}w+w & =w &  & [\\,\\text{given}\\,] \\\\ (w+w)+(-w) & =w+(-w) &  & [\\,\\text{add [math]-\\mathbf{w}[/math] to both sides}\\,] \\\\ w+(w+(-w)) & =w+(-w) &  & [\\,\\text{axiom __}\\,\\,] \\\\ w+0 & =0 &  & [\\,\\text{axiom A4}\\,] \\\\ w & =0 &  & [\\,\\text{axiom __}\\,\\,]\\end{aligned}\n$$\n\nThe axioms:\n\n$$\n\\begin{aligned}\\text{[A1]}:x+y=y+x & \\text{[A5]}:1\\cdot x=x \\\\ \\text{[A2]}:(x+y)+z=x+(y+z) & \\text{[A6]}:\\alpha (\\beta x)=(\\alpha \\beta )x \\\\ \\text{[A3]}:x+0=x & \\text{[A7]}:(\\alpha +\\beta )x=\\alpha x+\\beta x \\\\ \\text{[A4]}:x+(-x)=0 & \\text{[A8]}:\\alpha (x+y)=\\alpha x+\\alpha y\\end{aligned}\n$$" :question/worked-solution "Using the axioms of a vector space, we obtain the following:\n\n$$\n\\begin{aligned}w+w & =w &  & [\\,\\text{given}\\,] \\\\ (w+w)+(-w) & =w+(-w) &  & [\\,\\text{add [math]-\\mathbf{w}[/math] to both sides}\\,] \\\\ w+(w+(-w)) & =w+(-w) &  & [\\,\\text{axiom [math]{\\color{blue}\\text{A2}}[/math]}\\,] \\\\ w+0 & =0 &  & [\\,\\text{axiom A4}\\,] \\\\ w & =0 &  & [\\,\\text{axiom [math]{\\color{blue}\\text{A3}}[/math]}\\,]\\end{aligned}\n$$" :db/ensure [:question/validate]}]
