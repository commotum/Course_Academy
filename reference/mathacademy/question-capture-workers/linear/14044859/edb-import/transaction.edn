\n\n$$\n\\begin{aligned}\\text{[A1]}:x+y=y+x & \\text{[A5]}:1\\cdot x=x \\\\ \\text{[A2]}:(x+y)+z=x+(y+z) & \\text{[A6]}:\\alpha (\\beta x)=(\\alpha \\beta )x \\\\ \\text{[A3]}:x+0=x & \\text{[A7]}:(\\alpha +\\beta )x=\\alpha x+\\beta x \\\\ \\text{[A4]}:x+(-x)=0 & \\text{[A8]}:\\alpha (x+y)=\\alpha x+\\alpha y\\end{aligned}\n$$" :question/worked-solution "Using the vector space axioms, we obtain the following: \n\n$$\n\\begin{aligned}0\\cdot 0 & =0\\cdot 0 &  & [\\,\\text{given}\\,] \\\\ 0\\cdot 0 & =0\\cdot 0+0 &  & [\\,\\text{axiom }\\text{A3}\\,] \\\\ 0\\cdot 0 & =0\\cdot 0+1\\cdot 0 &  & [\\,\\text{axiom }\\text{A5}\\,] \\\\ 0\\cdot 0 & =(0+1)\\cdot 0 &  & [\\,\\text{axiom A7}\\,] \\\\ 0\\cdot 0 & =1\\cdot 0 &  & [\\,\\text{addition of integers}\\,] \\\\ 0\\cdot 0 & =0 &  & [\\,\\text{axiom A5}\\,]\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-106944/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9bdb6bc9-47e2-5330-a1ee-270882f2aced"] :knowledge-point/questions ["q-106944"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74671/selection/6130a3dd4544005e8a0bb21eaf02c747d5f5d9e4ba5ef4acb45d9188ac85f147" :answer/id #uuid "627bf9ea-f8f3-5666-a6dd-a06e6dc7f01d" :answer/type :answer.type/text :answer/value "$\\text{A2}$, $\\text{A8}$" :db/ensure [:answer/validate]} {:db/id "q-74671/selection/f80ddb117ed9810d8452ea4353a0f593e9da4246505af106b1c35ac20acb8b3d" :answer/id #uuid "e6091862-7070-50c8-a541-2b547644d399" :answer/type :answer.type/text :answer/value "$\\text{A3}$, $\\text{A4}$" :db/ensure [:answer/validate]} {:db/id "q-74671/selection/31d38c50d8c71e2d42a7662c1b2cc6f833dac5bd7622055ae5233a91fa2d814c" :answer/id #uuid "86b35900-672e-543c-90f6-71d46bbf0ff7" :answer/type :answer.type/text :answer/value "$\\text{A2}$, $\\text{A5}$" :db/ensure [:answer/validate]} {:db/id "q-74671/selection/9e8514727248f5b67f046ee5d3463c87a46745f9f426856ba2270470431dc2ed" :answer/id #uuid "13a019dd-81