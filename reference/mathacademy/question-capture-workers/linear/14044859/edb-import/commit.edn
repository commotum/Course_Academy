,\\text{axiom __}\\,\\,] \\\\ y+(x+(-x)) & =-x &  & [\\,\\text{axiom __}\\,\\,] \\\\ y+0 & =-x &  & [\\,\\text{axiom A4}\\,] \\\\ y & =-x &  & [\\,\\text{axiom A3}\\,]\\end{aligned}\n$$\n\nThe axioms:\n\n$$\n\\begin{aligned}\\text{[A1]}:x+y=y+x & \\text{[A5]}:1\\cdot x=x \\\\ \\text{[A2]}:(x+y)+z=x+(y+z) & \\text{[A6]}:\\alpha (\\beta x)=(\\alpha \\beta )x \\\\ \\text{[A3]}:x+0=x & \\text{[A7]}:(\\alpha +\\beta )x=\\alpha x+\\beta x \\\\ \\text{[A4]}:x+(-x)=0 & \\text{[A8]}:\\alpha (x+y)=\\alpha x+\\alpha y\\end{aligned}\n$$" 13194139535104 true] [17592186331353 1113 #uuid "dd84fbde-b275-5aa2-98b5-041f7a21abda" 13194139535104 true] [17592186331353 1145 "Using the vector space axioms, we obtain the following:\n\n$$\n\\begin{aligned}x+y & =0 &  & [\\,\\text{given}\\,] \\\\ (x+y)+(-x) & =0+(-x) &  & [\\,\\text{add }-x\\text{ to both sides}\\,] \\\\ (y+x)+(-x) & =(-x)+0 &  & [\\,\\text{axiom A1}\\,] \\\\ (y+x)+(-x) & =-x &  & [\\,\\text{axiom }\\text{A3}\\,\\,] \\\\ y+(x+(-x)) & =-x &  & [\\,\\text{axiom }\\text{A2}\\,\\,] \\\\ y+0 & =-x &  & [\\,\\text{axiom A4}\\,] \\\\ y & =-x &  & [\\,\\text{axiom A3}\\,]\\end{aligned}\n$$" 13194139535104 true] [17592186331354 1000 #edb/ref 17592186331355 13194139535104 true] [17592186331354 1000 #edb/ref 17592186331356 13194139535104 true] [17592186331354 1000 #edb/ref 17592186331357 13194139535104 true] [17592186331354 1000 #edb/ref 17592186331358 13194139535104 true] [17592186331354 1000 #edb/ref 17592186331359 13194139535104 true] [17592186331354 1040 #edb/ref 17592186045450 13194139535104 true] [17592186331354 1041 "selection" 13194139535104 true] [17592186331354 1104 #edb/ref 17592186331356 13194139535104 true] [17592186331354 1110 #uuid "8cb8e73b-a644-5ef2-b66f-b49c5ba1f48f" 13194139535104 true] [17592186331355 1034 "$\\text{A1}$, $\\text{A4}$" 13194139535104 true] [17592186331355 1103 #edb/ref 17592186045454 13194139535104 true] [17592186331355 1111 #uuid "46e9f705-09df-5d5a-9c36-b997e0546d99" 13194139535104 true] [175921863