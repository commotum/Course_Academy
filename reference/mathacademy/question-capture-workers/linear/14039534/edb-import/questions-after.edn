ligned}6 \\\\ 22\\end{aligned}] \\\\ T({v}_{1}) & =\\frac{1}{2}[\\begin{aligned}6 \\\\ 22\\end{aligned}] \\\\ T({v}_{1}) & =[\\begin{aligned}3 \\\\ 11\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186303101 :knowledge-point/_questions [{:knowledge-point/id #uuid "381f7ffe-ae4b-5e45-9fa9-e2a6bd8348b3" :knowledge-point/title "Determining the Image of a Vector Under a Map Using Vector Addition and Scalar Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f411131b-0d69-513c-94f0-d8ace72cfdf5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186303103} {:answer/id #uuid "fdec5f53-9ca6-5017-af3a-72434a7f6326" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186303104} {:answer/id #uuid "a772e72a-d474-5df6-870c-7d92f4f2a690" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186303105} {:answer/id #uuid "16dccfc8-dfca-5442-837d-e8368bdd1d0e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186303106} {:answer/id #uuid "d3f18e64-29d5-534b-ac78-5fd2caeb7a92" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186303107}] :answer-field/correct {:answer/id #uuid "fdec5f53-9ca6-5017-af3a-72434a7f6326" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186303104} :answer-field/id #uuid "7431378d-493f-543a-8537-c3771a5d43a3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186303102}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d3aabb18-a945-51e2-bce9-9f0029a0d83e" :question/math-academy-id "q-74774" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,T(4{v}_{1}-5{v}_{2})=[\\begin{aligned}-13 \\\\ 6\\end{aligned}]\\,$ and $\\,T({v}_{1})=[\\begin{aligned}-2 \\\\ 4\\end{aligned}]$, then find $\\,T({v}_{2}).$" :question/worked-solution "Since $T$ is a linear transformation, we have that\n\n$$\n\\begin{aligned}T(kv+hw)=T(kv)+T(hw)=kT(v)+hT(w)\\end{aligned}\n$$\n\nfor any vectors $v$ and $w.$ Therefore,\n\n$$\n\\begin{aligned}T(4{v}_{1}-5{v}_{2}) & =4T({v}_{1})-5T({v}_{2}) \\\\ [\\begin{aligned}-13 \\\\ 6\\end{aligned}] & =4[\\begin{aligned}-2 \\\\ 4\\end{aligned}]-5T({v}_{2}) \\\\ 5T({v}_{2}) & =4[\\begin{aligned}-2 \\\\ 4\\end{aligned}]-[\\begin{aligned}-13 \\\\ 6\\end{aligned}] \\\\ 5T({v}_{2}) & =[\\begin{aligned}-8 \\\\ 16\\end{aligned}]-[\\begin{aligned}-13 \\\\ 6\\end{aligned}] \\\\ 5T({v}_{2}) & =[\\begin{aligned}5 \\\\ 10\\end{aligned}] \\\\ T({v}_{2}) & =\\frac{1}{5}[\\begin{aligned}5 \\\\ 10\\end{aligned}] \\\\ T({v}_{2}) & =[\\begin{aligned}1 \\\\ 2\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186303108 :knowledge-point/_questions [{:knowledge-point/id #uuid "9fbd335c-28cc-5f02-b773-f685e8b15417" :knowledge-point/title "Determining the Image of a Vector Sum Under a Map Using Vector Addition and Scalar Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e6bedd8-a681-55bb-a422-697c3261b8e1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ -13 \\\\ 7\\end{aligned}]" :db/id #edb/ref 17592186303110} {:answer/id #uuid "9266ea0c-fba6-5de0-bc11-ed9c2cc49460" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}21 \\\\ -39 \\\\ 21\\end{aligned}]" :db/id #edb/ref 17592186303111} {:answer/id #uuid "1e89fa85-449d-58cd-ae00-30e32c63d14a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-16 \\\\ 52 \\\\ -28\\end{aligned}]" :db/id #edb/ref 17592186303112} {:answer/id #uuid "13395b9e-9033-5fa5-929b-fd9524d93c