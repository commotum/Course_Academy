oices [{:answer/id #uuid "50cdf796-aae2-5db5-bb74-ede83d532257" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186262608}] :answer-field/correct {:answer/id #uuid "50cdf796-aae2-5db5-bb74-ede83d532257" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186262608} :answer-field/id #uuid "bd2ec9c0-2bcf-514f-bab6-05a3be1c52c6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186262607} {:answer-field/choices [{:answer/id #uuid "c8a958a7-1cb7-55a2-a620-1e490cda4534" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186262610}] :answer-field/correct {:answer/id #uuid "c8a958a7-1cb7-55a2-a620-1e490cda4534" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186262610} :answer-field/id #uuid "533be6a4-61b2-5380-863e-f14e4b613a56" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186262609}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1e8dd3fb-61a6-56c3-af5f-f21f08cff26f" :question/math-academy-id "q-317817" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,T(3{v}_{1}+{v}_{2})=[\\begin{aligned}-5 \\\\ 13\\end{aligned}]\\,$ and $\\,T({v}_{2})=[\\begin{aligned}1 \\\\ 10\\end{aligned}]$, then find $T({v}_{1}).$\n\n| $T({v}_{1})=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |" :question/worked-solution "Since $T$ is a linear transformation, we have that\n\n$$\n\\begin{aligned}T(kv+w)=T(kv)+T(w)=kT(v)+T(w)\\end{aligned}\n$$\n\nfor any vectors $v$ and $w.$ Therefore,\n\n$$\n\\begin{aligned}T(3{v}_{1}+{v}_{2}) & =3T({v}_{1})+T({v}_{2}) \\\\ [\\begin{aligned}-5 \\\\ 13\\end{aligned}] & =3T({v}_{1})+[\\begin{aligned}1 \\\\ 10\\end{aligned}] \\\\ 3T({v}_{1}) & =[\\begin{aligned}-5 \\\\ 13\\end{aligned}]-[\\begin{aligned}1 \\\\ 10\\end{aligned}] \\\\ 3T({v}_{1}) & =[\\begin{aligned}-6 \\\\ 3\\end{aligned}] \\\\ T({v}_{1}) & =\\frac{1}{3}[\\begin{aligned}-6 \\\\ 3\\end{aligned}] \\\\ T({v}_{1}) & =[\\begin{aligned}-2 \\\\ 1\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186303093 :knowledge-point/_questions [{:knowledge-point/id #uuid "9fbd335c-28cc-5f02-b773-f685e8b15417" :knowledge-point/title "Determining the Image of a Vector Sum Under a Map Using Vector Addition and Scalar Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e689255b-7099-50d9-bef5-04745b545fac" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186303095}] :answer-field/correct {:answer/id #uuid "e689255b-7099-50d9-bef5-04745b545fac" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186303095} :answer-field/id #uuid "25de9e1d-20da-5fe5-91da-d9a9f4fb65dd" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186303094} {:answer-field/choices [{:answer/id #uuid "0e6c5ed4-38a3-5c21-a785-e012b3b75edf" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186303097}] :answer-field/correct {:answer/id #uuid "0e6c5ed4-38a3-5c21-a785-e012b3b75edf" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186303097} :answer-field/id #uuid "6ab0ba19-97e1-5561-bd25-ab1c9573e973" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186303096} {:answer-field/choices [{:answer/id #uuid "e59179f3-ee79-52a2-9dda-b03feab2e0bf" :answer/type {:db/ident :answer.type/math} :answer/value "-30" :db/id #edb/ref 17592186303099}] :answer-field/correct {:answer/id #uuid "e59179f3-ee79-52a2-9dda-b03feab2e0bf" :answer/type {:db/ident :answer.type/math} :answer/value "-30" :db/id #edb/ref 17592186303099} :answer-field/id #uuid "b94fb7fb-671b-51b5-bf57-377bb817d938" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186303098}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "cff63153-15b9-5cd1-ac1e-878b39f8b821" :question/math-academy-id "q-317825" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,{v}_{1}+{v}_{2}=0\\,$ and $\\,T({v}_{1})=[\\begin{aligned}2 \\\\ -1 \\\\ 5\\end{aligned}]\\,$, find  $T(9{v}_{1}+15{v}_{2}).$\n\n| $\\,T(9{v}_{1}+15{v}_{2})=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |\n|  | {{field-3}} |  |  |" :question/worked-solution "First, since ${v}_{1}+{v}_{2}=0,$ we have that \n\n$$\n\\begin{aligned}9{v}_{1}+15{v}_{2} & =15{v}_{1}-6{v}_{1}+15{v}_{2} \\\\  & =15({v}_{1}+{v}_{2})-6{v}_{1} \\\\  & =15(0)-6{v}_{1} \\\\  & =-6{v}_{1}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nT(9{v}_{1}+15{v}_{2})=T(-6{v}_{1}).\n$$\n\nNow, since $T$ is a linear transformation, we have that $T(kv)=kT(v).$ So \n\n$$\n\\begin{aligned}T(-6{v}_{1}) & =-6T({v}_{1}) \\\\  & =-6[\\begin{aligned}2 \\\\ -1 \\\\ 5\\end{aligned}] \\\\  & =[\\begin{aligned}-12 \\\\ 6 \\\\ -30\\end{aligned}].\\end{aligned}\n$$\n\nIn conclusion, $T(9{v}_{1}+15{v}_{2})=[\\begin{aligned}-12 \\\\ 6 \\\\ -30\\end{aligned}].$"}] [{:db/id #edb/ref 17592186262618 :knowledge-point/_questions [{:knowledge-point/id #uuid "9fbd335c-28cc-5f02-b773-f685e8b15417" :knowledge-point/title "Determining the Image of a Vector Sum Under a Map Using Vector Addition and Scalar Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6316fc78-fd06-5292-a6bf-05dfdac423ea" :answer/type {:db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186262620} {:answer/id #uuid "6d5879bd-438c-5b38-b8f0-f326aeea51a1" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186303100}] :answer-field/correct {:answer/id #uuid "6316fc78-fd06-5292-a6bf-05dfdac423ea" :an