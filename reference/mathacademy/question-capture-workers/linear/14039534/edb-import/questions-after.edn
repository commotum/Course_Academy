er-field/choices [{:answer/id #uuid "c171812c-c6d8-5efe-a045-2f6187f65844" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186303084} {:answer/id #uuid "ca4edd64-fc89-5f45-88c0-80d748b34673" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186303085}] :answer-field/correct {:answer/id #uuid "ca4edd64-fc89-5f45-88c0-80d748b34673" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186303085} :answer-field/id #uuid "6f28e9d9-764f-512d-8346-c5e8e0f34ba1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186303083} {:answer-field/choices [{:answer/id #uuid "b66181a8-439c-5d7d-ac0b-23a7e45169ea" :answer/type {:db/ident :answer.type/math} :answer/value "-22" :db/id #edb/ref 17592186303087}] :answer-field/correct {:answer/id #uuid "b66181a8-439c-5d7d-ac0b-23a7e45169ea" :answer/type {:db/ident :answer.type/math} :answer/value "-22" :db/id #edb/ref 17592186303087} :answer-field/id #uuid "31126d29-34db-5fa9-8628-945cc75ef66e" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186303086}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "45c8f47a-506e-5b95-baa5-55e95970982d" :question/math-academy-id "q-317703" :question/problem "If $\\,T\\,$ is a linear transformation and $\\,T([\\begin{aligned}-3 \\\\ 5\\end{aligned}])=[\\begin{aligned}7 \\\\ -11\\end{aligned}]$, then find $T([\\begin{aligned}-6 \\\\ 10\\end{aligned}]).$\n\n| $\\,T([\\begin{aligned}-6 \\\\ 10\\end{aligned}])=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |" :question/worked-solution "Since $T$ is a linear transformation, it must satisfy $T(kv)=kT(v).$ Noting that $[\\begin{aligned}-6 \\\\ 10\\end{aligned}]=2[\\begin{aligned}-3 \\\\ 5\\end{aligned}],$ we have\n\n$$\n\\begin{aligned}T([\\begin{aligned}-6 \\\\ 10\\end{aligned}]) & =T(2[\\begin{aligned}-3 \\\\ 5\\end{aligned}]) \\\\  & =2T([\\begin{aligned}-3 \\\\ 5\\end{aligned}]) \\\\  & =2[\\begin{aligned}7 \\\\ -11\\end{aligned}] \\\\  & =[\\begin{aligned}14 \\\\ -22\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186303088 :knowledge-point/_questions [{:knowledge-point/id #uuid "381f7ffe-ae4b-5e45-9fa9-e2a6bd8348b3" :knowledge-point/title "Determining the Image of a Vector Under a Map Using Vector Addition and Scalar Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3db4bb52-3154-5d62-a425-54fa119b7f80" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186303090}] :answer-field/correct {:answer/id #uuid "3db4bb52-3154-5d62-a425-54fa119b7f80" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186303090} :answer-field/id #uuid "c3099b9a-7dff-581d-9887-94376b7a7d76" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186303089} {:answer-field/choices [{:answer/id #uuid "919d8e4b-99fc-552d-b792-ca81a5124885" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186303092}] :answer-field/correct {:answer/id #uuid "919d8e4b-99fc-552d-b792-ca81a5124885" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186303092} :answer-field/id #uuid "d511dec0-fc20-5b36-9376-b39ddb755ec2" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186303091}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "9f3cc03f-2d16-5c15-a2c4-b38cdf33c262" :question/math-academy-id "q-317716" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,T(-5{v}_{1}+4{v}_{2})=[\\begin{aligned}23 \\\\ -24\\end{aligned}]\\,$ and $\\,T({v}_{2})=[\\begin{aligned}-3 \\\\ 4\\end{aligned}]$, then find $T({v}_{1}).$\n\n| $T({v}_{1})=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |" :question/worked-solution "Since $T$ is a linear transformation, we have that\n\n$$\n\\begin{aligned}T(-kv+hw)=T(-kv)+T(hw)=-kT(v)+hT(w)\\end{aligned}\n$$\n\nfor any vectors $v$ and $w.$ Therefore,\n\n$$\n\\begin{aligned}T(-5{v}_{1}+4{v}_{2}) & =-5T({v}_{1})+4T({v}_{2}) \\\\ [\\begin{aligned}23 \\\\ -24\\end{aligned}] & =-5T({v}_{1})+4[\\begin{aligned}-3 \\\\ 4\\end{aligned}] \\\\ 5T({v}_{1}) & =4[\\begin{aligned}-3 \\\\ 4\\end{aligned}]-[\\begin{aligned}23 \\\\ -24\\end{aligned}] \\\\ 5T({v}_{1}) & =[\\begin{aligned}-12 \\\\ 16\\end{aligned}]-[\\begin{aligned}23 \\\\ -24\\end{aligned}] \\\\ 5T({v}_{1}) & =[\\begin{aligned}-35 \\\\ 40\\end{aligned}] \\\\ T({v}_{1}) & =\\frac{1}{5}[\\begin{aligned}-35 \\\\ 40\\end{aligned}] \\\\ T({v}_{1}) & =[\\begin{aligned}-7 \\\\ 8\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262595 :knowledge-point/_questions [{:knowledge-point/id #uuid "381f7ffe-ae4b-5e45-9fa9-e2a6bd8348b3" :knowledge-point/title "Determining the Image of a Vector Under a Map Using Vector Addition and Scalar Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "110b5302-b280-5712-853b-8b5b4166b93f" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186262597} {:answer/id #uuid "b6d5414d-ef5f-5aa0-9fda-33725bd98e73" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186262598}] :answer-field/correct {:answer/id #uuid "110b5302-b280-5712-853b-8b5b4166b93f" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186262597} :answer-field/id #uuid "0abef2cb-ec8c-50f5-a770-6319f0fea591" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186262596} {:answer-field/choices [{:answer/id #uuid "b50582a5-bd76-5df5-8f9e-e004f2f22ff0" :answer/type {:db/ident :answer.type/math} :answer/value "4" :