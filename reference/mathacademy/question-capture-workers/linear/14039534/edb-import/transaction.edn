d-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |" :question/worked-solution "Since $T$ is a linear transformation, it must satisfy $T(kv)=kT(v).$ Noting that $[\\begin{aligned}-6 \\\\ 10\\end{aligned}]=2[\\begin{aligned}-3 \\\\ 5\\end{aligned}],$ we have\n\n$$\n\\begin{aligned}T([\\begin{aligned}-6 \\\\ 10\\end{aligned}]) & =T(2[\\begin{aligned}-3 \\\\ 5\\end{aligned}]) \\\\  & =2T([\\begin{aligned}-3 \\\\ 5\\end{aligned}]) \\\\  & =2[\\begin{aligned}7 \\\\ -11\\end{aligned}] \\\\  & =[\\begin{aligned}14 \\\\ -22\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-317703/field-1" "q-317703/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ad1c29f7-c0e7-5bed-944f-a2e33579c7b8"] :knowledge-point/questions ["q-317703"] :db/ensure [:knowledge-point/validate]} {:db/id "q-317697/field-1/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "0ef581d2-91ff-5334-90a7-ccc5cd8f5b76" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-317697/field-1" :answer-field/id #uuid "a5953d4b-a0b4-5bf0-b100-491623542dd4" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317697/field-1/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer-field/choices ["q-317697/field-1/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53"] :db/ensure [:answer-field/validate]} {:db/id "q-317697/field-2/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "d74bf42e-0680-5f4f-85ae-4a2945afb564" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-317697/field-2" :answer-field/id #uuid "065eb33b-8423-5eb5-9bf4-2e08624c7707" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317697/field-2/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad