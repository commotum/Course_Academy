ulty :question.difficulty/easy :question/answer-fields ["q-170589/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ad1c29f7-c0e7-5bed-944f-a2e33579c7b8"] :knowledge-point/questions ["q-170589"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74774/selection/316e31382540e65d0f46665a667fc04a682c6856ba5ccfe153e95664a68b2948" :answer/id #uuid "f411131b-0d69-513c-94f0-d8ace72cfdf5" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-74774/selection/b70163afa80242b6e07599db9e6649592c88c8df8d6892329736a0a5f2ef7d0f" :answer/id #uuid "d3f18e64-29d5-534b-ac78-5fd2caeb7a92" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-74774/selection/4afe72ce1ff2948bb282f72a051259b7c7c995391c6a8ae0e3d05b32a2584b91" :answer/id #uuid "fdec5f53-9ca6-5017-af3a-72434a7f6326" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-74774/selection/60eadf18022e36714cee17e0479ab6af66a6361ceef7571ec8305b4e57ee6d8f" :answer/id #uuid "a772e72a-d474-5df6-870c-7d92f4f2a690" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-74774/selection/89509341da3fc059d3fae3c08ea87f7c7273dd2cfed4f405dd9f061ed448811c" :answer/id #uuid "16dccfc8-dfca-5442-837d-e8368bdd1d0e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-74774/selection" :answer-field/id #uuid "7431378d-493f-543a-8537-c3771a5d43a3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74774/selection/4afe72ce1ff2948bb282f72a051259b7c7c995391c6a8ae0e3d05b32a2584b91" :answer-field/choices ["q-74774/selection/316e31382540e65d0f46665a667fc04a682c6856ba5ccfe153e95664a68b2948" "q-74774/selection/b70163afa80242b6e07599db9e6649592c88c8df8d6892329736a0a5f2ef7d0f" "q-74774/selection/4afe72ce1ff2948bb282f72a051259b7c7c995391c6a8ae0e3d05b32a2584b91" "q-74774/selection/60eadf18022e36714cee17e0479ab6af66a6361ceef7571ec8305b4e57ee6d8f" "q-74774/selection/89509341da3fc059d3fae3c08ea87f7c7273dd2cfed4f405dd9f061ed448811c"] :db/ensure [:answer-field/validate]} {:db/id "q-74774" :question/id #uuid "d3aabb18-a945-51e2-bce9-9f0029a0d83e" :question/math-academy-id "q-74774" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,T(4{v}_{1}-5{v}_{2})=[\\begin{aligned}-13 \\\\ 6\\end{aligned}]\\,$ and $\\,T({v}_{1})=[\\begin{aligned}-2 \\\\ 4\\end{aligned}]$, then find $\\,T({v}_{2}).$" :question/worked-solution "Since $T$ is a linear transformation, we have that\n\n$$\n\\begin{aligned}T(kv+hw)=T(kv)+T(hw)=kT(v)+hT(w)\\end{aligned}\n$$\n\nfor any vectors $v$ and $w.$ Therefore,\n\n$$\n\\begin{aligned}T(4{v}_{1}-5{v}_{2}) & =4T({v}_{1})-5T({v}_{2}) \\\\ [\\begin{aligned}-13 \\\\ 6\\end{aligned}] & =4[\\begin{aligned}-2 \\\\ 4\\end{aligned}]-5T({v}_{2}) \\\\ 5T({v}_{2}) & =4[\\begin{aligned}-2 \\\\ 4\\end{aligned}]-[\\begin{aligned}-13 \\\\ 6\\end{aligned}] \\\\ 5T({v}_{2}) & =[\\begin{aligned}-8 \\\\ 16\\end{aligned}]-[\\begin{aligned}-13 \\\\ 6\\end{aligned}] \\\\ 5T({v}_{2}) & =[\\begin{aligned}5 \\\\ 10\\end{aligned}] \\\\ T({v}_{2}) & =\\frac{1}{5}[\\begin{aligned}5 \\\\ 10\\end{aligned}] \\\\ T({v}_{2}) & =[\\begin{aligned}1 \\\\ 2\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-74774/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "381f7ffe-ae4b-5e45-9fa9-e2a6bd8348b3"] :knowledge-point/questions ["q-74774"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-37871"] :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,T(2{v}_{1}+{v}_{2})=[\\begin{aligned}11 \\\\ 3\\end{aligned}]\\,$ and $\\,T({v}_{2})=[\\begin{aligned}5 \\\\ -19\\end{aligned}]$, then find $\\,T({v}_{1}).$" :question/worked-solution "Since $T$ is a linear transformation, we have that\n\n$$\n\\begin{aligned}T(kv+w)=T(kv)+T(w)=kT(v)+T(w)\\end{aligned}\n$$\n\nfor any vectors $v$ and $w.$ Therefore,\n\n$$\n\\begin{aligned}T(2{v}_{1}+{v}_{2}) & =2T({v}_{1})+T({v}_{2}) \\\\ [\\begin{aligned}11 \\\\ 3\\end{aligned}] & =2T({v}_{1})+[\\begin{aligned}5 \\\\ -19\\end{aligned}] \\\\ 2T({v}_{1}) & =[\\begin{aligned}11 \\\\ 3\\end{aligned}]-[\\begin{aligned}5 \\\\ -19\\end{aligned}] \\\\ 2T({v}_{1}) & =[\\begin{aligned}6 \\\\ 22\\end{aligned}] \\\\ T({v}_{1}) & =\\frac{1}{2}[\\begin{aligned}6 \\\\ 22\\end{aligned}] \\\\ T({v}_{1}) & =[\\begin{aligned}3 \\\\ 11\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-317716/field-1/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer/id #uuid "3db4bb52-3154-5d62-a425-54fa119b7f80" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "q-317716/field-1" :answer-field/id #uuid "c3099b9a-7dff-581d-9887-94376b7a7d76" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317716/field-1/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer-field/choices ["q-317716/field-1/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142"] :db/ensure [:answer-field/validate]} {:db/id "q-317716/field-2/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "919d8e4b-99fc-552d-b792-ca81a5124885" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-317716/field-2" :answer-field/id #uuid "d511dec0-fc20-5b36-9376-b39ddb755ec2" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317716/field-2/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer-field/choices ["q-317716/field-2/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af"] :db/ensure [:answer-field/validate]} {:db/id "q-317716" :question/id #uuid "9f3cc03f-2d16-5c15-a2c4-b38cdf33c262" :question/math-academy-id "q-317716" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,T(-5{v}_{1}+4{v}_{2})=[\\begin{aligned}23 \\\\ -24\\end{aligned}]\\,$ and $\\,T({v}_{2})=[\\begin{aligned}-3 \\\\ 4\\end{aligned}]$, then find $T({v}_{1}).$\n\n| $T({v}_{1})=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |" :question/worked-solution "Since $T$ is a linear transformation, we have that\n\n$$\n\\begin{aligned}T(-kv+hw)=T(-kv)+T(hw)=-kT(v)+hT(w)\\end{aligned}\n$$\n\nfor any vectors $v$ and $w.$ Therefore,\n\n$$\n\\begin{aligned}T(-5{v}_{1}+4{v}_{2}) & =-5T({v}_{1})+4T({v}_{2}) \\\\ [\\begin{aligned}23 \\\\ -24\\end{aligned}] & =-5T({v}_{1})+4[\\begin{aligned}-3 \\\\ 4\\end{aligned}] \\\\ 5T({v}_{1}) & =4[\\begin{aligned}-3 \\\\ 4\\end{aligned}]-[\\begin{aligned}23 \\\\ -24\\end{aligned}] \\\\ 5T({v}_{1}) & =[\\begin{aligned}-12 \\\\ 16\\end{aligned}]-[\\begin{aligned}23 \\\\ -24\\end{aligned}] \\\\ 5T({v}_{1}) & =[\\begin{aligned}-35 \\\\ 40\\end{aligned}] \\\\ T({v}_{1}) & =\\frac{1}{5}[\\begin{aligned}-35 \\\\ 40\\end{aligned}] \\\\ T({v}_{1}) & =[\\begin{aligned}-7 \\\\ 8\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-317716/field-1" "q-317716/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "381f7ffe-ae4b-5e45-9fa9-e2a6bd8348b3"] :knowledge-point/questions ["q-317716"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74782/selection/f115dba2c3ec67cbb121b77eee611baffe68832a6630017bc9304e3d86611f05" :answer/id #uuid "165cff79-aa46-5d80-b7ea-c38852f0b369" :answer/type :answer.type/math :answer/value "[\\begin{aligned}35 \\\\ 40 \\\\ 45\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-74782/selection/7dd853e02dd2822f1d1