 \\\\  & =4[\\begin{aligned}-4 \\\\ 13 \\\\ -7\\end{aligned}] \\\\  & =[\\begin{aligned}-16 \\\\ 52 \\\\ -28\\end{aligned}].\\end{aligned}\n$$\n\nIn conclusion, $T(41{v}_{1}+37{v}_{2})=[\\begin{aligned}-16 \\\\ 52 \\\\ -28\\end{aligned}].$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-74777/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9fbd335c-28cc-5f02-b773-f685e8b15417"] :knowledge-point/questions ["q-74777"] :db/ensure [:knowledge-point/validate]} {:db/id "q-317833/field-1/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd" :answer/id #uuid "6d5879bd-438c-5b38-b8f0-f326aeea51a1" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id 17592186262619 :answer-field/choices ["q-317833/field-1/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd"] :db/ensure [:answer-field/validate]} {:db/id "q-170636/selection/992f92c69f8b66a0f6931a8d309f786a890e2710f53d4de69684e1c9efce51c1" :answer/id #uuid "ca2c8385-8712-513a-b397-433ddc0c0afb" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-55 \\\\ 36 \\\\ 60\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-170636/selection/a070c112850bc788c71f89c3811dad98580d3537621bcbfe66bc2ab0f3cc63eb" :answer/id #uuid "590087a4-576a-5b51-bc56-f83a86d4eae7" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-60 \\\\ 36 \\\\ 54\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-170636/selection/a3cdf3aa6738f8ccb21c7f46d0db755b9773d212a0feb65f569acab9dea108e1" :answer/id #uuid "17300f69-b781-57d0-bcdc-05f0ff4c943e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-75 \\\\ 48 \\\\ 60\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-170636/selection/81a1b0ea2c519527c78ed8b303193f8c35db67dfce7c7bab5fa6a28f48bf204a" :answer/id #uuid "a8dad40f-0a40-5334-81a8-99d05f057af5" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-60 \\\\ 24 \\\\ 40\\end{