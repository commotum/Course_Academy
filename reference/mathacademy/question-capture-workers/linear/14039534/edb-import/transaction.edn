ed}]=-3[\\begin{aligned}3 \\\\ -4\\end{aligned}],$ we have\n\n$$\n\\begin{aligned}T([\\begin{aligned}-9 \\\\ 12\\end{aligned}]) & =T(-3[\\begin{aligned}3 \\\\ -4\\end{aligned}]) \\\\  & =-3T([\\begin{aligned}3 \\\\ -4\\end{aligned}]) \\\\  & =-3[\\begin{aligned}8 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}-24 \\\\ 6\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-317698/field-1" "q-317698/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ad1c29f7-c0e7-5bed-944f-a2e33579c7b8"] :knowledge-point/questions ["q-317698"] :db/ensure [:knowledge-point/validate]} {:db/id "q-170589/selection/958adcad40bcc6a75fec6fcdcdcd016a8d495743c409cac70c2921421e990efc" :answer/id #uuid "7d93dd8a-c6d0-5be2-8ae0-58b738a05e38" :answer/type :answer.type/math :answer/value "[\\begin{aligned}5 \\\\ -8\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-170589/selection/6e7d450d841cb7ba0bc7a13d7eb348aadaa42c7e5755c9e05e221a8418b45108" :answer/id #uuid "a0c77d1f-1d58-5fd1-90f0-83c7e53cdc8e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ -5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-170589/selection/c25b4c5a34c9f50ba5cab12d26d91674670de71293237dd889d3975aa50ccc8f" :answer/id #uuid "b16c8d3f-0a3c-5da5-9e42-a52c032def83" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-170589/selection/afbb4dc8596d14b16ed85530fd2cc6f492ca90cc501ab4ea04b5149cc22679e2" :answer/id #uuid "694ba66b-7e22-5c5d-bf7f-09db587f68a9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ -6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-170589/selection/0b70d815ed8df8d1f1e046fedecd44794c4f5899d792ee4eb6b4aa8a992d01a7" :answer/id #uuid "1ed52c73-5e80-5db4-bda4-1dea7f9c2e5d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 \\\\ -5\\end{aligned}]" :db/ensure [:answer/val