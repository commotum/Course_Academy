{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039534/state.json" "file_sha256" "acc0de8d030b386af044b586d1aafbd40539fa3a3057430467a9f381371e0306"} {"question" "q-37870" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}7 \\\\ -5\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039534/state.json" "file_sha256" "acc0de8d030b386af044b586d1aafbd40539fa3a3057430467a9f381371e0306"} {"question" "q-317817" "field" nil "attribute" "question/problem" "value" "Consider a linear transformation $\\,T\\,.$ If $\\,T(3{v}_{1}+{v}_{2})=[\\begin{aligned}-5 \\\\ 13\\end{aligned}]\\,$ and $\\,T({v}_{2})=[\\begin{aligned}1 \\\\ 10\\end{aligned}]$, then find $T({v}_{1}).$\n\n| $T({v}_{1})=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039534/state.json" "file_sha256" "acc0de8d030b386af044b586d1aafbd40539fa3a3057430467a9f381371e0306"} {"question" "q-317817" "field" nil "attribute" "question/worked-solution" "value" "Since $T$ is a linear transformation, we have that\n\n$$\n\\begin{aligned}T(kv+w)=T(kv)+T(w)=kT(v)+T(w)\\end{aligned}\n$$\n\nfor any vectors $v$ and $w.$ Therefore,\n\n$$\n\\begin{aligned}T(3{v}_{1}+{v}_{2}) & =3T({v}_{1})+T({v}_{2}) \\\\ [\\begin{aligned}-5 \\\\ 13\\end{aligned}] & =3T({v}_{1})+[\\begin{aligned}1 \\\\ 10\\end{aligned}] \\\\ 3T({v}_{1}) & =[\\begin{aligned}-5 \\\\ 13\\end{aligned}]-[\\begin{aligned}1 \\\\ 10\\end{aligned}] \\\\ 3T({v}_{1}) & =[\\begin{aligned}-6 \\\\ 3\\end{aligned}] \\\\ T({v}_{1}) & =\\frac{1}{3}[\\begin{aligned}-6 \\\\ 3\\end{aligned}] \\\\ T({v}_{1}) & =[\\begin{aligned}-2 \\\\ 1\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039534/state.json" "file_sha256" "acc0de8d030b386af044b586d1aafbd40539fa3a3057430467a9f381371e0306"} {"question" "q-317817" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039534/activity-metadata.json" "file_sha256" "ac4f50b8f701b6dffb9c4cd99045845bedf2eb03b2e18e969709210cedffd701"} {"question" "q-317817" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039534/state.json" "file_sha256" "acc0de8d030b386af044b586d1aafbd40539fa3a3057430467a9f381371e0306"} {"question" "q-317817" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039534/state.json" "file_sha256" "acc0de8d030b386af044b586d1aafbd40539fa3a3057430467a9f381371e0306"} {"question" "q-317817" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039534/state.json" "file_sha256" "acc0de8d030b386af044b586d1aafbd40539fa3a3057430467a9f381371e0306"} {"question" "q-317817" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "1"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039534/state.json" "file_sha256" "acc0de8d030b386af044b586d1aafbd40539fa3a3057430467a9f381371e0306"} {"question" "q-74774" "field" nil "attribute" "question/problem" "value" "Consider a linear transformation $\\,T\\,.$ If $\\,T(4{v}_{1}-5{v}_{2})=[\\begin{aligned}-13 \\\\ 6\\end{aligned}]\\,$ and $\\,T({v}_{1})=[\\begin{aligned}-2 \\\\ 4\\end{aligned}]$, then find $\\,T({v}_{2}).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039534/state.json" "file_sha256" "acc0de8d030b386af044b586d1aafbd40539fa3a3057430467a9f381371e0306"} {"question" "q-74774" "field" nil "attribute" "question/worked-solution" "value" "Since $T$ is a linear transformation, we have that\n\n$$\n\\begin{aligned}T(kv+hw)=T(kv)+T(hw)=kT(v)+hT(w)\\end{aligned}\n$$\n\nfor any vectors $v$ and $w.$ Therefore,\n\n$$\n\\begin{aligned}T(4{v}_{1}-5{v}_{2}) & =4T({v}_{1})-5T({v}_{2}) \\\\ [\\begin{aligned}-13 \\\\ 6\\end{aligned}] & =4[\\begin{aligned}-2 \\\\ 4\\end{aligned}]-5T({v}_{2}) \\\\ 5T({v}_{2}) & =4[\\begin{aligned}-2 \\\\ 4\\end{aligned}]-[\\begin{aligned}-13 \\\\ 6\\end{aligned}] \\\\ 5T({v}_{2}) & =[\\begin{aligned}-8 \\\\ 16\\end{aligned}]-[\\begin{aligned}-13 \\\\ 6\\end{aligned}] \\\\ 5T({v}_{2}) & =[\\begin{aligned}5 \\\\ 10\\end{aligned}] \\\\ T({v}_{2}) & =\\frac{1}{5}[\\begin{aligned}5 \\\\ 10\\end{aligned}] \\\\ T({v}_{2}) & =[\\begin{aligned}1 \\\\ 2\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039534/state.json" "file_sha256" "acc0de8d030b386af044b586d1aafbd40539fa3a3057430467a9f381371e0306"} {"question" "q-74774" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039534/activity-metadata.json" "file_sha256" "ac4f50b8f701b6dffb9c4cd99045845bedf2eb03b2e18e969709210cedffd701"} {"question" "q-74774" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/r