} \\\\  & =3{v}_{1}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nT(15{v}_{1}+12{v}_{2})=T(3{v}_{1}).\n$$\n\nNow, since $T$ is a linear transformation, we have that $T(kv)=kT(v).$ So \n\n$$\n\\begin{aligned}T(3{v}_{1}) & =3T({v}_{1}) \\\\  & =3[\\begin{aligned}-25 \\\\ 16 \\\\ 20\\end{aligned}] \\\\  & =[\\begin{aligned}-75 \\\\ 48 \\\\ 60\\end{aligned}].\\end{aligned}\n$$\n\nIn conclusion, $T(15{v}_{1}+12{v}_{2})=[\\begin{aligned}-75 \\\\ 48 \\\\ 60\\end{aligned}].$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039534/state.json" "file_sha256" "acc0de8d030b386af044b586d1aafbd40539fa3a3057430467a9f381371e0306"} {"question" "q-170636" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039534/activity-metadata.json" "file_sha256" "ac4f50b8f701b6dffb9c4cd99045845bedf2eb03b2e18e969709210cedffd701"} {"question" "q-170636" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039534/state.json" "file_sha256" "acc0de8d030b386af044b586d1aafbd40539fa3a3057430467a9f381371e0306"} {"question" "q-170636" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-55 \\\\ 36 \\\\ 60\\end{aligned}]"] ["math" "[\\begin{aligned}-60 \\\\ 24 \\\\ 40\\end{aligned}]"] ["math" "[\\begin{aligned}-60 \\\\ 36 \\\\ 54\\end{aligned}]"] ["math" "[\\begin{aligned}-75 \\\\ 48 \\\\ 60\\end{aligned}]"] ["math" "[\\begin{aligned}45 \\\\ -24 \\\\ 30\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039534/state.json" "file_sha256" "acc0de8d030b386af044b586d1aafbd40539fa3a3057430467a9f3