{aligned}T(-6{v}_{1}+5{v}_{2}) & =-6T({v}_{1})+5T({v}_{2}) \\\\ [\\begin{aligned}8 \\\\ -39\\end{aligned}] & =-6T({v}_{1})+5[\\begin{aligned}4 \\\\ -3\\end{aligned}] \\\\ 6T({v}_{1}) & =5[\\begin{aligned}4 \\\\ -3\\end{aligned}]-[\\begin{aligned}8 \\\\ -39\\end{aligned}] \\\\ 6T({v}_{1}) & =[\\begin{aligned}20 \\\\ -15\\end{aligned}]-[\\begin{aligned}8 \\\\ -39\\end{aligned}] \\\\ 6T({v}_{1}) & =[\\begin{aligned}12 \\\\ 24\\end{aligned}] \\\\ T({v}_{1}) & =\\frac{1}{6}[\\begin{aligned}12 \\\\ 24\\end{aligned}] \\\\ T({v}_{1}) & =[\\begin{aligned}2 \\\\ 4\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039534/state.json" "file_sha256" "acc0de8d030b386af044b586d1aafbd40539fa3a3057430467a9f381371e0306"} {"question" "q-317722" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039534/activity-metadata.json" "file_sha256" "ac4f50b8f701b6dffb9c4cd99045845bedf2eb03b2e18e969709210cedffd701"} {"question" "q-317722" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039534/state.json" "file_sha256" "acc0de8d030b386af044b586d1aafbd40539fa3a3057430467a9f381371e0306"} {"question" "q-317722" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039534/state.json" "file_sha256" "acc0de8d030b386af044b586d1aafbd40539fa3a3057430467a9f381371e0306"} {"question" "q-317722" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Cours