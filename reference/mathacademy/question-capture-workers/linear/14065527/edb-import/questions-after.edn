#{[{:db/id #edb/ref 17592186351490 :knowledge-point/_questions [{:knowledge-point/id #uuid "76a7314b-4ebf-52eb-b464-97865ea9a81e" :knowledge-point/title "Dividing a Quartic Polynomial by a Quadratic or Cubic Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf4886af-f97a-5049-84c9-37eeae59bad4" :answer/type {:db/ident :answer.type/math} :answer/value "10x-5" :db/id #edb/ref 17592186351492} {:answer/id #uuid "360d4066-e900-5647-acdd-b60e7b23c568" :answer/type {:db/ident :answer.type/math} :answer/value "-6x+6" :db/id #edb/ref 17592186351493} {:answer/id #uuid "fc56fbd3-6dff-527b-bfd7-cf26c61b6c27" :answer/type {:db/ident :answer.type/math} :answer/value "-10x+8" :db/id #edb/ref 17592186351494} {:answer/id #uuid "35ae1c9f-351b-5677-9db0-427a7301954e" :answer/type {:db/ident :answer.type/math} :answer/value "2x-5" :db/id #edb/ref 17592186351495} {:answer/id #uuid "fe48562f-1da1-53c7-ad5d-f4b80e0baaaa" :answer/type {:db/ident :answer.type/math} :answer/value "-12x-10" :db/id #edb/ref 17592186351496}] :answer-field/correct {:answer/id #uuid "fe48562f-1da1-53c7-ad5d-f4b80e0baaaa" :answer/type {:db/ident :answer.type/math} :answer/value "-12x-10" :db/id #edb/ref 17592186351496} :answer-field/id #uuid "e7da6c48-1331-5c88-aa9c-b1f1b75b015a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351491}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f7696ef5-5d63-5be6-b1bf-664936ebd8be" :question/math-academy-id "q-114492" :question/problem "What is the remainder when  ${x}^{4}-2{x}^{3}-4{x}^{2}-10x-7$ is divided by ${x}^{2}+2x+1?$" :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,\\,{x}^{2}-4x+3 \\\\  & {x}^{2}+2x+1\\,\\enclose{longdiv}{\\,\\,{x}^{4}-2{x}^{3}-4{x}^{2}-10x-7\\,\\,} \\\\  & \\,\\,\\,\\,\\,{{x}^{4}+2{x}^{3}+{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,-4{x}^{3}-5{x}^{2}-10x-7 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,4{x}^{3}-8{x}^{2}-4x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,3{x}^{2}-6x-7 \\\\  & \\,\\,\\,\\,\\,\\,\\,{3{x}^{2}+6x+3}_{―} \\\\  & \\,\\,\\,\\,\\,\\,-\\,12x-10\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is ${x}^{2}-4x+3,$ and\n\n- the remainder is $-12x-10.$"}] [{:db/id #edb/ref 17592186351497 :knowledge-point/_questions [{:knowledge-point/id #uuid "76a7314b-4ebf-52eb-b464-97865ea9a81e" :knowledge-point/title "Dividing a Quartic Polynomial by a Quadratic or Cubic Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fa227dc-68a1-5f2c-a513-1ae35c1388ab" :answer/type {:db/ident :answer.type/math} :answer/value "-2x^2+x-5" :db/id #edb/ref 17592186351499}] :answer-field/correct {:answer/id #uuid "0fa227dc-68a1-5f2c-a513-1ae35c1388ab" :answer/type {:db/ident :answer.type/math} :answer/value "-2x^2+x-5" :db/id #edb/ref 17592186351499} :answer-field/id #uuid "96125f21-a19b-51f6-868c-e614a9df64ca" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186351498} {:answer-field/choices [{:answer/id #uuid "da3d15bb-67b6-5406-a377-9a5a9774edad" :answer/type {:db/ident :answer.type/math} :answer/value "7x+6" :db/id #edb/ref 17592186351501}] :answer-field/correct {:answer/id #uuid "da3d15bb-67b6-5406-a377-9a5a9774edad" :answer/type {:db/ident :answer.type/math} :answer/value "7x+6" :db/id #edb/ref 17592186351501} :answer-field/id #uuid "56eed73e-ff28-5c57-a694-c3748ebb6f4d" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186351500}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "9285cb79-17c7-50c5-8156-d768562b3668" :question/math-academy-id "q-322924" :question/problem "Express $\\frac{-8{x}^{4}+10{x}^{3}-27{x}^{2}+24x-4}{4{x}^{2}-3x+2}$ in the form $q(x)+\\frac{r(x)}{4{x}^{2}-3x+2},$ where $q(x)$ is the quotient and $r(x)$ is the reminder of the division.$$\n\n| $-8{x}^{4}+10{x}^{3}-27{x}^{2}+24x-4$ | __ | {{field-1}} | $+$ | {{field-2}} |\n| --- | --- | --- | --- | --- |\n| $4{x}^{2}-3x+2$ | __ |  |  | $4{x}^{2}-3x+2$ |" :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,-2{x}^{2}+x-5 \\\\  & 4{x}^{2}-3x+2\\,\\enclose{longdiv}{\\,\\,-8{x}^{4}+10{x}^{3}-27{x}^{2}+24x-4\\,\\,} \\\\  & \\,\\,\\,\\,{\\,\\,-\\,8{x}^{4}+6{x}^{3}-4{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,4{x}^{3}-23{x}^{2}+24x-4 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,{4{x}^{3}-3{x}^{2}+2x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,-\\,20{x}^{2}+22x-4 \\\\  & \\,\\,\\,\\,\\,\\,\\,{-\\,20{x}^{2}+15x-10}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,7x+6\\end{aligned}\n$$\n\nAs a result, \n\n- the quotient is $-2{x}^{2}+x-5,$ and\n\n- the remainder is $7x+6.$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{-8{x}^{4}+10{x}^{3}-27{x}^{2}+24x-4}{4{x}^{2}-3x+2} & =-2{x}^{2}+x-5+\\frac{7x+6}{4{x}^{2}-3x+2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186351502 :knowledge-point/_questions [{:knowledge-point/id #uuid "76a7314b-4ebf-52eb-b464-97865ea9a81e" :knowledge-point/title "Dividing a Quartic Polynomial by a Quadratic or Cubic Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82ce60c2-2106-5c9f-8f5c-a930eb40c785" :answer/type {:db/ident :answer.type/math} :answer/value "2x+3" :db/id #edb/ref 17592186351504} {:answer/id #uuid "02b57776-02ac-59e6-bbab-8d7bb5b4473b" :answer/type {:db/ident :answer.type/math} :answer/value "2x-3" :db/id #edb/ref 17592186351505}] :answer-field/correct {:answer/id #uuid "02b57776-02ac-59e6-bbab-8d7bb5b4473b" :answer/type {:db/ident :answer.type/math} :answer/value "2x-3" :db/id #edb/ref 17592186351505} :answer-field/id #uuid "6ff9760f-96e1-5baf-8aa1-c733cb08b5d9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186351503}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "12438b1b-50e6-5f18-b2e4-ecce962c3001" :question/math-academy-id "q-325106" :question/problem "What is the quotient of $-2{x}^{4}+11{x}^{3}-17{x}^{2}+3x+3$ divided by $-{x}^{3}+4{x}^{2}-2x+1?$\n\nThe quotient is\n{{field-1}}." :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,2x-3 \\\\  & -{x}^{3}+4{x}^{2}-2x+1\\,\\enclose{longdiv}{\\,\\,-2{x}^{4}+11{x}^{3}-17{x}^{2}+3x+3\\,\\,} \\\\  & \\,\\,\\,\\,{\\,\\,-\\,2{x}^{4}+8{x}^{3}-4{x}^{2}+2x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,3{x}^{3}-13{x}^{2}+x+3 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,{3{x}^{3}-12{x}^{2}+6x-3}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,-{x}^{2}-5x+6\\end{aligned}\n$$\n\nTherefore,\n\n- the quotient is $2x-3,$ and\n\n- the remainder is $-{x}^{2}-5x+6.$"}] [{:db/id #edb/ref 17592186351506 :knowledge-point/_questions [{:knowledge-point/id #uuid "525be9c7-af11-506b-be69-444dfc640add" :knowledge-point/title "Dividing Polynomials When the Dividend Contains Zero Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f20edbd6-fa52-5062-acfc-afcbe7a018aa" :answer/type {:db/ident :answer.type/math} :answer/value "x+31" :db/id #edb/ref 17592186351508}] :answer-field/correct {:answer/id #uuid "f20edbd6-fa52-5062-acfc-afcbe7a018aa" :answer/type {:db/ident :answer.type/math} :answer/value "x+31" :db/id #edb/ref 17592186351508} :answer-field/id #uuid "8458d67b-1ddb-516b-b1c7-aca7b0e320a8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186351507}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5f489c11-d556-5f9b-8cf2-027cb23be58e" :question/math-academy-id "q-325143" :question/problem "What is the remainder of $-4{x}^{3}+16$ divided by $2{x}^{2}-3x+5?$\n\nThe remainder is\n{{field-1}}." :question/worked-solution "Notice that the dividend is missing the ${x}^{2}$ and $x$ terms. So, we first rewrite it by including the missing terms with zero coefficients, as follows:\n\n$$\n-4{x}^{3}+16=-4{x}^{3}+0{x}^{2}+0x+16\n$$\n\nNow, using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,-2x-3 \\\\  & 2{x}^{2}-3x+5\\,\\enclose{longdiv}{\\,\\,-4{x}^{3}+0{x}^{2}+0x+6\\,\\,} \\\\  & \\,\\,\\,\\,\\,\\,\\,{-4{x}^{3}+6{x}^{2}-10x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,-6{x}^{2}+10x+16 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,{-\\,6{x}^{2}+9x-15}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,x+31\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is $-2x-3,$ and\n\n- the remainder is $x+31.$"}] [{:db/id #edb/ref 17592186351509 :knowledge-point/_questions [{:knowledge-point/id #uuid "525be9c7-af11-506b-be69-444dfc640add" :knowledge-point/title "Dividing Polynomials When the Dividend Contains Zero Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "601f09c4-7e32-58ff-b170-cf167ef46577" :answer/type {:db/ident :answer.type/math} :answer/value "3x" :db/id #edb/ref 17592186351511} {:answer/id #uuid "59e4c9cb-3ffa-5ed6-ba7a-6d4a202a403f" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186351512} {:answer/id #uuid "6a3e8a97-595e-5ba0-a712-c905235acb7a" :answer/type {:db/ident :answer.type/math} :answer/value "5x-1" :db/id #edb/ref 17592186351513} {:answer/id #uuid "f141d559-d95e-5b68-8d14-30b92431626d" :answer/type {:db/ident :answer.type/math} :answer/value "-2x+3" :db/id #edb/ref 17592186351514} {:answer/id #uuid "c0139858-7be1-588f-9829-0da1a5986c54" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186351515}] :answer-field/correct {:answer/id #uuid "601f09c4-7e32-58ff-b170-cf167ef46577" :answer/type {:db/ident :answer.type/math} :answer/value "3x" :db/id #edb/ref 17592186351511} :answer-field/id #uuid "b678a0d9-922a-5837-9f34-3a9b11ffdca9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351510}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d827abae-dd9f-5627-9629-e5ca430ed96f" :question/math-academy-id "q-37972" :question/problem "What is the quotient of $3{x}^{3}-8$ divided by ${x}^{2}-1?$" :question/worked-solution "Notice that the dividend is missing the ${x}^{2}$ and $x$ terms. So, we first rewrite it by including the missing terms with zero coefficients, as follows:\n\n$$\n3{x}^{3}-8=3{x}^{3}+0{x}^{2}+0x-8\n$$\n\nNow, using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,3x \\\\  & {x}^{2}-1\\,\\enclose{longdiv}{\\,\\,3{x}^{3}+0{x}^{2}+0x-8\\,\\,} \\\\  & \\,\\,\\,\\,\\,{3{x}^{3}+0{x}^{2}-3x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,3x-8\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is $3x,$ and\n\n- the remainder is $3x-8.$"}]}
