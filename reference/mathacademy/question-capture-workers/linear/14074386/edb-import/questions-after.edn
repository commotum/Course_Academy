#{[{:db/id #edb/ref 17592186176152 :knowledge-point/_questions [{:knowledge-point/id #uuid "b629bead-e64a-5e73-ae42-80d4ebb3762b" :knowledge-point/title "Finding a Jordan Canonical Form of a 2x2 Matrix With Only One Eigenvalue"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c9827bf-41f1-5607-af01-71f35d8ec392" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 1 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186173575} {:answer/id #uuid "123104ed-edbe-514d-a62f-933847d6b982" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 0 \\\\ 0 & -3\\end{bmatrix}" :db/id #edb/ref 17592186173576} {:answer/id #uuid "1fd9f56a-19ad-509b-aab5-66a87eeb51cd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 0 \\\\ 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186173577} {:answer/id #uuid "2f4bda88-9236-5b55-ad74-1861fde1a355" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 1 \\\\ 0 & -3\\end{bmatrix}" :db/id #edb/ref 17592186173578} {:answer/id #uuid "3bcc2c4c-b5c3-5355-bd7f-60c50928775f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 0 \\\\ 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186173579}] :answer-field/correct {:answer/id #uuid "2f4bda88-9236-5b55-ad74-1861fde1a355" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 1 \\\\ 0 & -3\\end{bmatrix}" :db/id #edb/ref 17592186173578} :answer-field/id #uuid "882058c3-e527-5bc2-9e7e-d0447b7af8b7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186173574}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "8fce4ae0-ab7d-5b76-858c-c6d19c621a6a" :question/math-academy-id "q-109094" :question/problem "Find the Jordan canonical form of the matrix \n$A=[\\begin{aligned}-8 & 5 \\\\ -5 & 2\\end{aligned}].$" :question/worked-solution "Every $n\\times n$ matrix $A$ can be written in the form\n\n$$\nA=PJ{P}^{-1},\n$$\n\nwhere $J$ is a Jordan canonical form (or Jordan normal form) of $A,$ and $P$ is an invertible matrix.\n\nTo find the matrix $J,$ we first find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}|\\begin{aligned}-8-\\lambda  & 5 \\\\ -5 & 2-\\lambda \\end{aligned}| & =0 \\\\ (-8-\\lambda )(2-\\lambda )-5\\cdot (-5) & =0 \\\\ {\\lambda }^{2}+6\\lambda +9 & =0 \\\\ (\\lambda +3)(\\lambda +3) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues are ${\\lambda }_{1}={\\lambda }_{2}=-3.$ \n\nSince $A$ is not a scalar matrix, we conclude that $A$ is not diagonalizable, and its Jordan canonical form is\n\n$$\nJ={J}_{2}(-3)=[\\begin{aligned}-3 & 1 \\\\ 0 & -3\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186380658 :knowledge-point/_questions [{:knowledge-point/id #uuid "65f20482-73ea-5f1c-bb2b-1d7472fbfd4e" :knowledge-point/title "Finding a Jordan Canonical Form of a 2x2 Matrix With Two Distinct Eigenvalues"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8667fc82-527b-5beb-9ae7-624429a536a7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 1 \\\\ 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186380660} {:answer/id #uuid "4d7fdc8f-2c8a-5247-ac2f-c5a920323e43" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 1 \\\\ 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186380661} {:answer/id #uuid "ad0cfe53-af26-555e-8e16-9106902f2806" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 1 \\\\ 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186380662} {:answer/id #uuid "a9abccb2-ccf2-5651-8df0-c4163784ed67" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186380663} {:answer/id #uuid "c156b260-b97a-520d-af07-01844b538105" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186380664}] :answer-field/correct {:answer/id #uuid "c156b260-b97a-520d-af07-01844b538105" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186380664} :answer-field/id #uuid "f17853dc-60a5-5d04-ac99-da8cf84207e9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186380659}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d7242a7b-99e3-5e08-a5ad-d2a9535cb71f" :question/math-academy-id "q-109314" :question/problem "Find a Jordan canonical form of the matrix \n$A=[\\begin{aligned}0 & -1 \\\\ 2 & 3\\end{aligned}].$" :question/worked-solution "Every $n\\times n$ matrix $A$ can be written in the form\n\n$$\nA=PJ{P}^{-1},\n$$\n\nwhere $J$ is a Jordan canonical form (or Jordan normal form) of $A,$ and $P$ is an invertible matrix.\n\nTo find the matrix $J,$ we first find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}|\\begin{aligned}-\\lambda  & -1 \\\\ 2 & 3-\\lambda \\end{aligned}| & =0 \\\\ (-\\lambda )(3-\\lambda )-(-1)(2) & =0 \\\\ {\\lambda }^{2}-3\\lambda +2 & =0 \\\\ (\\lambda -2)(\\lambda -1) & =0\\end{aligned}\n$$\n\n \n\nSo, the eigenvalues are ${\\lambda }_{1}=1$ and ${\\lambda }_{2}=2.$ Since we get two distinct eigenvalues, the matrix $A$ is diagonalizable, and a Jordan canonical form is\n\n$$\nJ={J}_{1}(1)\\,⊕\\,{J}_{1}(2)=[\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186380665 :knowledge-point/_questions [{:knowledge-point/id #uuid "511398e8-780e-57b2-8f1b-092e9f6cca45" :knowledge-point/title "Finding a Jordan Canonical Form of a 2x2 Scalar Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21873374-4e4d-593e-939e-c022136782fc" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{align