[{:db/id "q-39950/selection/74f923e30bd1e60077b4941616bdd8e16717425c5c2d54b9fa80a277550d9802" :answer/id #uuid "a447173e-cd97-5123-a57e-da8f5d3c970f" :answer/type :answer.type/text :answer/value "${v}_{1}$ and ${v}_{3}$ only" :db/ensure [:answer/validate]} {:db/id "q-39950/selection/d3be21e1608ce4836bcb88db914330102f58ace612f0f4790ca7cbff8218981a" :answer/id #uuid "00736481-4d81-5237-9e29-6d7cfe4bcf5e" :answer/type :answer.type/text :answer/value "${v}_{1},{v}_{2},$ and ${v}_{3}$" :db/ensure [:answer/validate]} {:db/id "q-39950/selection/e59b1317e710cc3efb03339d0dda62b111e50354d142ee4531e7a4057ac1ae98" :answer/id #uuid "da512b2a-6247-5a95-a2f8-ea4a86db3326" :answer/type :answer.type/text :answer/value "${v}_{2}$ only" :db/ensure [:answer/validate]} {:db/id "q-39950/selection/c775d251c2737ff86ab12a951f39bac6f44f996847b75a21c2b9f77d1a77f1b5" :answer/id #uuid "43f54ee6-f19a-5f86-bfd9-b026080ed02a" :answer/type :answer.type/text :answer/value "${v}_{1}$ and ${v}_{2}$ only" :db/ensure [:answer/validate]} {:db/id "q-39950/selection/3b5c09299df187455e033e1efb084c2785900b543e47830f83626bf457d3bce4" :answer/id #uuid "188710dd-bf64-5655-a7b7-23f736ead657" :answer/type :answer.type/text :answer/value "${v}_{3}$ only" :db/ensure [:answer/validate]} {:db/id "q-39950/selection" :answer-field/id #uuid "bfb37e99-2a82-5daa-a730-6aa4ed3b9a5f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-39950/selection/d3be21e1608ce4836bcb88db914330102f58ace612f0f4790ca7cbff8218981a" :answer-field/choices ["q-39950/selection/74f923e30bd1e60077b4941616bdd8e16717425c5c2d54b9fa80a277550d9802" "q-39950/selection/d3be21e1608ce4836bcb88db914330102f58ace612f0f4790ca7cbff8218981a" "q-39950/selection/e59b1317e710cc3efb03339d0dda62b111e50354d142ee4531e7a4057ac1ae98" "q-39950/selection/c775d251c2737ff86ab12a951f39bac6f44f996847b75a21c2b9f77d1a77f1b5" "q-39950/selection/3b5c09299df187455e033e1efb084c2785900b543e47830f83626bf457d3bce4"] :db/ensure [:answer-field/validate]} {:db/id "q-39950" :question/id #uuid "5418e97c-69b9-563b-9b40-35e458b156c8" :question/math-academy-id "q-39950" :question/problem "Consider the vector subspace $H=\\text{Span}{[\\begin{aligned}-3 \\\\ -1 \\\\ 7\\end{aligned}],[\\begin{aligned}6 \\\\ 2 \\\\ -14\\end{aligned}]}.$ Which of the following vectors belong to ${H}^{⊥}?$\n\n$$\n{v}_{1}=[\\begin{aligned}5 \\\\ -1 \\\\ 2\\end{aligned}],\\,{v}_{2}=[\\begin{aligned}-3 \\\\ 2 \\\\ -1\\end{aligned}],\\,{v}_{3}=[\\begin{aligned}2 \\\\ 1 \\\\ 1\\end{aligned}].\n$$" :question/worked-solution "Let's denote the vectors that span the subspace $H$ as ${h}_{1}$ and ${h}_{2}.$ \n\nNow, a vector $v$ belongs to ${H}^{⊥}$ if $v$ is orthogonal to the set of vectors that spans the subspace $H.$ So, we have to find the products ${v}_{i}\\cdot {h}_{j}$ for for $i=1,2,3$ and  $j=1,2.$ \n\n- For ${v}_{1}$, we have the following:\n\n$$\n\\begin{aligned}{v}_{1}\\cdot {h}_{1} & =5\\cdot (-3)+(-1)\\cdot (-1)+2\\cdot 7=0 & \\,✓ \\\\ {v}_{1}\\cdot {h}_{2} & =5\\cdot 6+(-1)\\cdot 2+2\\cdot (-14)=0 & \\,✓\\end{aligned}\n$$\n\nSo, ${v}_{1}\\in {H}^{⊥}.$\n\n- For ${v}_{2}$, we have the following:\n\n$$\n\\begin{aligned}{v}_{2}\\cdot {h}_{1} & =(-3)\\cdot (-3)+2\\cdot (-1)+(-1)\\cdot 7=0 & \\,✓ \\\\ {v}_{2}\\cdot {h}_{2} & =(-3)\\cdot 6+2\\cdot 2+(-1)\\cdot (-14)=0 & \\,✓\\end{aligned}\n$$\n\nSo, ${v}_{2}\\in {H}^{⊥}.$\n\n- For ${v}_{3}$, we have the following:\n\n$$\n\\begin{aligned}{v}_{3}\\cdot {h}_{1} & =2\\cdot (-3)+1\\cdot (-1)+1\\cdot 7=0 & \\,✓ \\\\ {v}_{3}\\cdot {h}_{2} & =2\\cdot 6+1\\cdot 2+1\\cdot (-14)=0 & \\,✓\\end{aligned}\n$$\n\nSo, ${v}_{3}\\in {H}^{⊥}.$\n\nTherefore, the correct answer is  \"${v}_{1},{v}_{2},$ and ${v}_{3}.$\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-39950/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bb11d128-ee1b-5c35-aefb-1455570d20c6"] :knowledge-point/questions ["q-39950"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186134173 :question/answer-fields 17592186131480] {:db/id "q-39953/selection/ma-v1/6f7505ca217988f04f14229130b3a624c93c54356ff30e47f44b87a5c5a7ff85/19253c3abb42c14e51b5cde6280e99c5ec639c6b18647f3eb335ebfee9eecb6d" :answer/id #uuid "fb7dcf6c-619c-5058-8b36-96d1c60cef62" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}-\\frac{2}{5} \\\\ \\frac{3}{5} \\\\ 1\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-39953/selection/ma-v1/6f7505ca217988f04f14229130b3a624c93c54356ff30e47f44b87a5c5a7ff85/2ebbd3e84d03ae44e2413decc36a783de58d33ab783acb18945dfd8b3fd195f9" :answer/id #uuid "e10017af-9686-5606-9b6b-9240d995790f" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}2 \\\\ 3 \\\\ 1\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-39953/selection/ma-v1/6f7505ca217988f04f14229130b3a624c93c54356ff30e47f44b87a5c5a7ff85/e220447e9b4c9fb01eae852e0985e7c35f79563172a21838c32d3619a87f64bc" :answer/id #uuid "4540561a-bd6f-5c86-a0bc-31a7fc753d5c" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}2 \\\\ -5 \\\\ 0\\end{aligned}],[\\begin{aligned}-3 \\\\ 0 \\\\ 5\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-39953/selection/ma-v1/6f7505ca217988f04f14229130b3a624c93c54356ff30e47f44b87a5c5a7ff85/9711d46aace8153c43ca9814c1ec0100882c4ce4ee5a7bcdb0ddc9980ce75f72" :answer/id #uuid "5e857f09-5c40-5048-9d32-abc26bfd0fed" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}\\frac{5}{3} \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}-\\frac{2}{3} \\\\ 0 \\\\ 1\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-39953/selection/ma-v1/6f7505ca217988f04f14229130b3a624c93c54356ff30e47f44b87a5c5a7ff85/853a9260b79598b81fa7b18393509d38fad7aeff210198622c2edd9ed48f3164" :answer/id #uuid "62709121-1fc9-5393-a5f7-e0fe00e16961" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}\\frac{2}{5} \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}-\\frac{3}{5} \\\\ 0 \\\\ 1\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-39953/selection/ma-v1/6f7505ca217988f04f14229130b3a624c93c54356ff30e47f44b87a5c5a7ff85" :answer-field/id #uuid "5ca52b0c-98b8-5c19-8f9d-98dae399da4d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-39953/selection/ma-v1/6f7505ca217988f04f14229130b3a624c93c54356ff30e47f44b87a5c5a7ff85/853a9260b79598b81fa7b18393509d38fad7aeff210198622c2edd9ed48f3164" :answer-field/choices ["q-39953/selection/ma-v1/6f7505ca217988f04f14229130b3a624c93c54356ff30e47f44b87a5c5a7ff85/19253c3abb42c14e51b5cde6280e99c5ec639c6b18647f3eb335ebfee9eecb6d" "q-39953/selection/ma-v1/6f7505ca217988f04f14229130b3a624c93c54356ff30e47f44b87a5c5a7ff85/2ebbd3e84d03ae44e2413decc36a783de58d33ab783acb18945dfd8b3fd195f9" "q-39953/selection/ma-v1/6f7505ca217988f04f14229130b3a624c93c54356ff30e47f44b87a5c5a7ff85/e220447e9b4c9fb01eae852e0985e7c35f79563172a21838c32d3619a87f64bc" "q-39953/selection/ma-v1/6f7505ca217988f04f14229130b3a624c93c54356ff30e47f44b87a5c5a7ff85/9711d46aace8153c43ca9814c1ec0100882c4ce4ee5a7bcdb0ddc9980ce75f72" "q-39953/selection/ma-v1/6f7505ca217988f04f14229130b3a624c93c54356ff30e47f44b87a5c5a7ff85/853a9260b79598b81fa7b18393509d38fad7aeff210198622c2edd9ed48f3164"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-39953"] :question/problem "Find a basis of ${H}^{⊥}$ if $H=\\text{Span}{[\\begin{aligned}5 \\\\ -2 \\\\ 3\\end{aligned}]}.$" :question/worked-solution "Let's denote the vector that spans the subspace $H$ as ${h}_{1}.$ \n\nA vector $x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]$ belongs to ${H}^{⊥}$ if $x\\cdot {h}_{1}=0.$ So, we need to solve the following system:\n\n$$\n{\\begin{aligned}x\\cdot {h}_{1}=0\\end{aligned}\\,⟹\\,{\\begin{aligned}5{x}_{1}-2{x}_{2}+3{x}_{3}=0\\end{aligned}\n$$\n\nwith the augmented matrix $M,$ which is already in row echelon form:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}5 & -2 & 3 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, we have $1$ pivot column (the $1$st one), so ${x}_{2}$ and ${x}_{3}$ are free variables. From the equation, we get ${x}_{1}=\\frac{2}{5}{x}_{2}-\\frac{3}{5}{x}_{3}.$ \nSo, every vector in ${H}^{⊥}$ has the form\n\n$$\n[\\begin{aligned}\\frac{2}{5}{x}_{2}-\\frac{3}{5}{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]={x}_{2}[\\begin{aligned}\\frac{2}{5} \\\\ 1 \\\\ 0\\end{aligned}]+{x}_{3}[\\begin{aligned}-\\frac{3}{5} \\\\ 0 \\\\ 1\\end{aligned}],\\,{x}_{2},{x}_{3}\\in R.\n$$\n\nTherefore, $B={[\\begin{aligned}\\frac{2}{5} \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}-\\frac{3}{5} \\\\ 0 \\\\ 1\\end{aligned}]}$ is a basis of ${H}^{⊥}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-39953/selection/ma-v1/6f7505ca217988f04f14229130b3a624c93c54356ff30e47f44b87a5c5a7ff85"] :db/ensure [:question/validate]} {:db/id "q-80539/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "18d24a77-7258-519a-9f90-cb2d76360cbe" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-80539/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "0b97157d-9a53-5403-9446-0fe33a26f80a" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-80539/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "38ed1899-a7ef-521e-ade0-eaa0c3f3a5d2" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-80539/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "0490f5aa-2a0d-54fd-bdd5-bc4dcae46ed9" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-80539/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "415f088d-64ab-5f76-a080-19b87ec58628" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-80539/selection" :answer-field/id #uuid "087761a1-ae97-5b4f-ac6f-9085fdab03fe" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-80539/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer-field/choices ["q-80539/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-80539/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-80539/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-80539/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-80539/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-80539" :question/id #uuid "b7f1454a-4548-5391-a772-12f55c445e0c" :question/math-academy-id "q-80539" :question/problem "Given that $u=[\\begin{aligned}a \\\\ b \\\\ c\\end{aligned}]$ is a non-zero vector that is orthogonal to the set $W={[\\begin{aligned}1 \\\\ -3 \\\\ -1\\end{aligned}],[\\begin{aligned}3 \\\\ 1 \\\\ 1\\end{aligned}]},$ find the value of $\\frac{b+c}{a}.$" :question/worked-solution "The vector $u$ is orthogonal to the set $W$ if $u\\cdot {w}_{1}=0$ and $u\\cdot {w}_{2}=0.$ So, we need to solve the following system:\n\n$$\n{\\begin{aligned}u\\cdot {w}_{1}=0 \\\\ u\\cdot {w}_{2}=0\\end{aligned}\\,⟹\\,{\\begin{aligned}{x}_{1}-3{x}_{2}-{x}_{3}=0 \\\\ 3{x}_{1}+{x}_{2}+{x}_{3}=0\\end{aligned}\n$$\n\nwith the augmented matrix $M,$ which we reduce to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -3 & -1 & 0 \\\\ 3 & 1 & 1 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & -1 & 0 \\\\ 0 & 10 & 4 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, we have $2$ pivot columns (the $1$st and $2$nd), so ${x}_{3}$ is a free variable. From the second equation, we get ${x}_{2}=-\\frac{2}{5}{x}_{3}.$ Substituting this into the first equation, we obtain ${x}_{1}=-\\frac{1}{5}{x}_{3}.$ So, the general solution is\n\n$$\n[\\begin{aligned}-\\frac{1}{5}{x}_{3} \\\\ -\\frac{2}{5}{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in R.\n$$\n\nSetting ${x}_{3}=5$, we get the vector \n$[\\begin{aligned}-1 \\\\ -2 \\\\ 5\\end{aligned}].$\n\nTherefore, we obtain $a=-1,$ $b=-2,$ and $c=5.$\n\nFinally, $\\frac{b+c}{a}=\\frac{-2+5}{-1}=-3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-80539/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9aa43961-5b6a-5c8b-adea-809d0a693cd1"] :knowledge-point/questions ["q-80539"] :db/ensure [:knowledge-point/validate]} {:db/id "q-140466/selection/10293ac0295e0e79554137a949f5c5c46b9812dcc0a3ecb6349c4cb5e6acdff3" :answer/id #uuid "611c8600-51a3-57ce-89a2-c3c01227cc49" :answer/type :answer.type/math :answer/value "-9" :db/ensure [:answer/validate]} {:db/id "q-140466/selection/f7e51073a8044d706f62a310ce4d8f162b2fb8c60dce078b4b3b822d9f8ed6fa" :answer/id #uuid "44b5fa61-8321-5c01-88ce-ec336b4dc858" :answer/type :answer.type/math :answer/value "\\frac{10}{3}" :db/ensure [:answer/validate]} {:db/id "q-140466/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "55675eba-ecc0-5f3e-a44c-fcf80b61be4c" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-140466/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "efab0c1f-6cd1-5135-937d-54493eea3f56" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-140466/selection/801bcdd9cb6a10cec998162e05f71050c8aaf0c6974f095bdcaef715a09f4aee" :answer/id #uuid "e0570163-f0f2-562e-845d-70e10361a4fd" :answer/type :answer.type/math :answer/value "21" :db/ensure [:answer/validate]} {:db/id "q-140466/selection" :answer-field/id #uuid "98349c02-61dc-5524-b5b5-fb5ba1f482a4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-140466/selection/801bcdd9cb6a10cec998162e05f71050c8aaf0c6974f095bdcaef715a09f4aee" :answer-field/choices ["q-140466/selection/10293ac0295e0e79554137a949f5c5c46b9812dcc0a3ecb6349c4cb5e6acdff3" "q-140466/selection/f7e51073a8044d706f62a310ce4d8f162b2fb8c60dce078b4b3b822d9f8ed6fa" "q-140466/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-140466/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" "q-140466/selection/801bcdd9cb6a10cec998162e05f71050c8aaf0c6974f095bdcaef715a09f4aee"] :db/ensure [:answer-field/validate]} {:db/id "q-140466" :question/id #uuid "de22f8a7-0462-58b6-8ab0-2cf50f198a6b" :question/math-academy-id "q-140466" :question/problem "Given that $u=[\\begin{aligned}a \\\\ b \\\\ c\\end{aligned}]$ is a non-zero  vector that is orthogonal to the set $W={[\\begin{aligned}0 \\\\ 2 \\\\ -5\\end{aligned}],[\\begin{aligned}3 \\\\ -3 \\\\ 7\\end{aligned}]},$ find the value of $\\frac{b+c}{a}.$" :question/worked-solution "The vector $u$ is orthogonal to the set $W$ if $u\\cdot {w}_{1}=0$ and $u\\cdot {w}_{2}=0.$ So, we need to solve the following system:\n\n$$\n{\\begin{aligned}u\\cdot {w}_{1}=0 \\\\ u\\cdot {w}_{2}=0\\end{aligned}\\,⟹\\,{\\begin{aligned}2{x}_{2}-5{x}_{3}=0 \\\\ 3{x}_{1}-3{x}_{2}+7{x}_{3}=0\\end{aligned}\n$$\n\nwith the augmented matrix $M,$ which we reduce to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}0 & 2 & -5 & 0 \\\\ 3 & -3 & 7 & 0\\end{aligned}] & {R}_{1} & ⇔{R}_{2} \\\\  & ∼[\\begin{aligned}3 & -3 & 7 & 0 \\\\ 0 & 2 & -5 & 0\\end{aligned}] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & \\frac{7}{3} & 0 \\\\ 0 & 2 & -5 & 0\\end{aligned}] & {R}_{2} & :=\\frac{1}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & \\frac{7}{3} & 0 \\\\ 0 & 1 & -\\frac{5}{2} & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, we have $2$ pivot columns (the $1$st and $2$nd), so ${x}_{3}$ is a free variable. From the second equation, we get ${x}_{2}=\\frac{5}{2}{x}_{3}.$ Substituting this into the first equation, we obtain ${x}_{1}=\\frac{1}{6}{x}_{3}.$ So, the general solution is\n\n$$\n[\\begin{aligned}\\frac{1}{6}{x}_{3} \\\\ \\frac{5}{2}{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in R.\n$$\n\nSetting ${x}_{3}=6,$ we get the vector \n$[\\begin{aligned}1 \\\\ 15 \\\\ 6\\end{aligned}].$\n\nTherefore, we obtain $a=1,$ $b=15,$ and $c=6.$\n\nFinally, $\\frac{b+c}{a}=\\frac{15+6}{1}=21.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-140466/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9aa43961-5b6a-5c8b-adea-809d0a693cd1"] :knowledge-point/questions ["q-140466"] :db/ensure [:knowledge-point/validate]} {:db/id "q-140467/selection/e59b1317e710cc3efb03339d0dda62b111e50354d142ee4531e7a4057ac1ae98" :answer/id #uuid "fd6c9ebd-7c56-5aa5-bc8b-11ddd87c9492" :answer/type :answer.type/text :answer/value "${v}_{2}$ only" :db/ensure [:answer/validate]} {:db/id "q-140467/selection/74f923e30bd1e60077b4941616bdd8e16717425c5c2d54b9fa80a277550d9802" :answer/id #uuid "be5f2b0c-e962-52f8-893a-d22a2724bb1a" :answer/type :answer.type/text :answer/value "${v}_{1}$ and ${v}_{3}$ only" :db/ensure [:answer/validate]} {:db/id "q-140467/selection/ae1ff8dad45e2c5cacb282945bb7f05d8899845640df9f6d8c53708f78d95913" :answer/id #uuid "4fc16e04-0f08-5556-adf7-29be9718e1bc" :answer/type :answer.type/text :answer/value "${v}_{1}$ only" :db/ensure [:answer/validate]} {:db/id "q-140467/selection/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25" :answer/id #uuid "ad55c2fe-ca5d-59fe-aac2-6c177c4d799f" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id "q-140467/selection/c775d251c2737ff86ab12a951f39bac6f44f996847b75a21c2b9f77d1a77f1b5" :answer/id #uuid "0e4f2504-2723-5e55-a05a-bd88846a54e3" :answer/type :answer.type/text :answer/value "${v}_{1}$ and ${v}_{2}$ only" :db/ensure [:answer/validate]} {:db/id "q-140467/selection" :answer-field/id #uuid "59f5aa0f-b4f7-5bab-b9af-d0cb21b96c2d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-140467/selection/e59b1317e710cc3efb03339d0dda62b111e50354d142ee4531e7a4057ac1ae98" :answer-field/choices ["q-140467/selection/e59b1317e710cc3efb03339d0dda62b111e50354d142ee4531e7a4057ac1ae98" "q-140467/selection/74f923e30bd1e60077b4941616bdd8e16717425c5c2d54b9fa80a277550d9802" "q-140467/selection/ae1ff8dad45e2c5cacb282945bb7f05d8899845640df9f6d8c53708f78d95913" "q-140467/selection/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25" "q-140467/selection/c775d251c2737ff86ab12a951f39bac6f44f996847b75a21c2b9f77d1a77f1b5"] :db/ensure [:answer-field/validate]} {:db/id "q-140467" :question/id #uuid "6ae892dc-850f-50c8-a715-c60715cd438e" :question/math-academy-id "q-140467" :question/problem "Consider the vector subspace $H=\\text{Span}{[\\begin{aligned}2 \\\\ 5 \\\\ 7\\end{aligned}],[\\begin{aligned}0 \\\\ 2 \\\\ 1\\end{aligned}]}.$ Which of the following vectors belong to ${H}^{⊥}?$\n\n$$\n{v}_{1}=[\\begin{aligned}9 \\\\ -2 \\\\ 4\\end{aligned}],\\,{v}_{2}=[\\begin{aligned}9 \\\\ 2 \\\\ -4\\end{aligned}],\\,{v}_{3}=[\\begin{aligned}3 \\\\ -2 \\\\ 4\\end{aligned}]\n$$" :question/worked-solution "Let's denote the vectors that span the subspace $H$ as ${h}_{1}$ and ${h}_{2}.$ \n\nNow, a vector $v$ belongs to ${H}^{⊥}$ if $v$ is orthogonal to the set of vectors that spans the subspace $H.$ So, we have to find the products ${v}_{i}\\cdot {h}_{j}$ for $i=1,2,3$ and  $j=1,2.$  \n\n- For ${v}_{1}$, we have the following:\n\n$$\n\\begin{aligned}{v}_{1}\\cdot {h}_{1} & =9\\cdot 2+(-2)\\cdot 5+4\\cdot 7=36\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, ${v}_{1}\\notin {H}^{⊥}.$ We do not need to test ${v}_{1}\\cdot {h}_{2}.$\n\n- For ${v}_{2}$, we have the following:\n\n$$\n\\begin{aligned}{v}_{2}\\cdot {h}_{1} & =9\\cdot 2+2\\cdot 5+(-4)\\cdot 7=0 & ✓ \\\\ {v}_{2}\\cdot {h}_{2} & =9\\cdot 0+2\\cdot 2+(-4)\\cdot 1=0 & ✓\\end{aligned}\n$$\n\nSo, ${v}_{2}\\in {H}^{⊥}.$\n\n- For ${v}_{3}$, we have the following:\n\n$$\n\\begin{aligned}{v}_{3}\\cdot {h}_{1} & =3\\cdot 2+(-2)\\cdot 5+4\\cdot 7=24\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, ${v}_{3}\\notin {H}^{⊥}.$ We do not need to test ${v}_{3}\\cdot {h}_{2}.$\n\nTherefore, the correct answer is \"${v}_{2}$ only\"." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-140467/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bb11d128-ee1b-5c35-aefb-1455570d20c6"] :knowledge-point/questions ["q-140467"] :db/ensure [:knowledge-point/validate]}]
