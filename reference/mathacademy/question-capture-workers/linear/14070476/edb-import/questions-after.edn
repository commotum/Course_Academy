nt/_questions [{:knowledge-point/id #uuid "77673d0c-9f03-5915-b2ab-4a5d6cb2d94d" :knowledge-point/title "Inverting a Frobenius Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d7119347-3b88-5645-ba02-ec7e86a430e8" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & \\frac{1}{2} & 1\\end{aligned}]" :db/id #edb/ref 17592186367650} {:answer/id #uuid "2bfe06d8-9bcd-5709-8a8b-58c659c22058" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -\\frac{1}{2} & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186367651} {:answer/id #uuid "70940d59-2c37-588a-bcf1-297eeeb3dc94" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -2 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186367652} {:answer/id #uuid "192d2541-8e6f-5854-9b20-da750390f2e8" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 2 & 1\\end{aligned}]" :db/id #edb/ref 17592186367653} {:answer/id #uuid "2bcfaf99-8b5b-5b2c-b846-57f8d5fc7022" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -\\frac{1}{2} & 1\\end{aligned}]" :db/id #edb/ref 17592186367654}] :answer-field/correct {:answer/id #uuid "192d2541-8e6f-5854-9b20-da750390f2e8" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 2 & 1\\end{aligned}]" :db/id #edb/ref 17592186367653} :answer-field/id #uuid "83d353c3-dc20-5671-a7ec-f9f5a515bda2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186367649}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ac6d6fb4-9114-518c-9fa2-3e1da0b95e85" :question/math-academy-id "q-135393" :question/problem "Find the inverse of the following matrix:\n\n$$\nA=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -2 & 1\\end{aligned}]\n$$" :question/worked-solution "Notice that we're given a Frobenius matrix:\n\n- all entries on the main diagonal are ones\n\n- the matrix has only one column (the $2$nd column) where some entries below the main diagonal are not zeros\n\n- all the other entries outside the main diagonal are zeros\n\nTo find the inverse of a Frobenius matrix, we simply take the non-zero entries outside the main diagonal with opposite signs. \n\nIn our case, we obtain\n\n$$\n\\begin{aligned}{A}^{-1}={[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -2 & 1\\end{aligned}]}^{-1}=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 2 & 1\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186367655 :knowledge-point/_questions [{:knowledge-point/id #uuid "77673d0c-9f03-5915-b2ab-4a5d6cb2d94d" :knowledge-point/title "Inverting a Frobenius Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b3e496f-43a3-5939-9b6e-cda114464504" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{\\sqrt{2}}{2} & 1 & 0 \\\\ -\\frac{1}{2} & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186367657} {:answer/id #uuid "06aa3be6-dc87-5c1f-9157-e8cf726ba8c0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -\\sqrt{2} & 1 & 0 \\\\ 2 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186367658} {:answer/id #uuid "f61e1485-0570-5403-8490-33deccfbaad2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{\\sqrt{2}}{2} & 1 & 0 \\\\ \\frac{1}{2} & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186367659} {:answer/id #uuid "54b407e1-7905-5fa9-b44f-b757d64bf878" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -\\sqrt{2} & 2 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186367660} {:answer/id #uuid "b0f6ad52-7de1-5e17-bea1-39c06c993ad4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & \\sqrt{2} & -2 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186367661}] :answer-field/correct {:answer/id #uuid "06aa3be6-dc87-5c1f-9157-e8cf726ba8c0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -\\sqrt{2} & 1 & 0 \\\\ 2 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186367658} :answer-field/id #uuid "a287581e-117e-5077-9d32-1e5a5725f88a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186367656}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "52e7bde0-e781-5679-9557-81416d5dd1c3" :question/math-academy-id "q-135397" :question/problem "Find the inverse of the following matrix:\n\n$$\nA=[\\begin{aligned}1 & 0 & 0 \\\\ \\sqrt{2} & 1 & 0 \\\\ -2 & 0 & 1\\end{aligned}]\n$$" :question/worked-solution "Notice that we're given a Frobenius matrix:\n\n- all entries on the main diagonal are ones\n\n- the matrix has only one column (the $1$st column) where some entries below the main diagonal are not zeros\n\n- all the other entries outside the main diagonal are zeros\n\nTo find the inverse of a Frobenius matrix, we simply take the non-zero entries outside the main diagonal with opposite signs. \n\nIn our case, we obtain\n\n$$\n\\begin{aligned}{A}^{-1}={[\\begin{aligned}1 & 0 & 0 \\\\ \\sqrt{2} & 1 & 0 \\\\ -2 & 0 & 1\\end{aligned}]}^{-1}=[\\begin{aligned}1 & 0 & 0 \\\\ -\\sqrt{2} & 1 & 0 \\\\ 2 & 0 & 1\\end{aligned}].\\end{aligned}\n$$"}]}
