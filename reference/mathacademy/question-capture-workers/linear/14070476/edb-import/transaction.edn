a8239f6325" "q-135393/selection/1da86f2c0baef89832e6dac35d9f363fe6dff2335c49b1518a1d6a654fa06cfd" "q-135393/selection/3b0d6d811ca2c2744259dbc30cddaf82703d2da7f4d78db25bd52f7ae7491b15" "q-135393/selection/1be1309fa4afad108f090f8bf4e428eebf02bd35df167a5dbecc84787049205a" "q-135393/selection/58b0a868ebd3c756c8112255f6ea2bbd81c71384d3bc39ef8613fcfc3cbf63eb"] :db/ensure [:answer-field/validate]} {:db/id "q-135393" :question/id #uuid "ac6d6fb4-9114-518c-9fa2-3e1da0b95e85" :question/math-academy-id "q-135393" :question/problem "Find the inverse of the following matrix:\n\n$$\nA=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -2 & 1\\end{aligned}]\n$$" :question/worked-solution "Notice that we're given a Frobenius matrix:\n\n- all entries on the main diagonal are ones\n\n- the matrix has only one column (the $2$nd column) where some entries below the main diagonal are not zeros\n\n- all the other entries outside the main diagonal are zeros\n\nTo find the inverse of a Frobenius matrix, we simply take the non-zero entries outside the main diagonal with opposite signs. \n\nIn our case, we obtain\n\n$$\n\\begin{aligned}{A}^{-1}={[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -2 & 1\\end{aligned}]}^{-1}=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 2 & 1\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-135393/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "77673d0c-9f03-5915-b2ab-4a5d6cb2d94d"] :knowledge-point/questions ["q-135393"] :db/ensure [:knowledge-point/validate]} {:db/id "q-135397/selection/734206bcc852fdd60ce59f8f5ac58420917fd90d97d4180aa52a5b730b16bc15" :answer/id #uuid "54b407e1-7905-5fa9-b44f-b757d64bf878" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & -\\sqrt{2} & 2 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-135397/selection/ab918ee601a412541d8fd357b184e57df6dd23635cabd7eaaf7a4a75b2f7d35e" :a