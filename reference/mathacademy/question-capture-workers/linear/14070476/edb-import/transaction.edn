31b4fe73e83c99584ebde81b1a1d22940c17279aaeacc3e8da3777c0acd" "q-135366/selection/06ed81e4359d5f51cd6c4d2d9c8635e1f7485aed4bc177aec3f73b242ad592be" "q-135366/selection/247d307e0bae98dfb026e2300cce7c2d007a60dae9412a5eaf992731bf9deb04"] :db/ensure [:answer-field/validate]} {:db/id "q-135366" :question/id #uuid "40f40cda-7847-5c65-80b1-4137ece3b7f8" :question/math-academy-id "q-135366" :question/problem "Find the inverse of the following matrix:\n\n$$\nA=[\\begin{aligned}0 & 0 & 1 \\\\ 1 & 0 & 0 \\\\ 0 & 1 & 0\\end{aligned}]\n$$" :question/worked-solution "The given matrix can be obtained from the identity matrix by permuting its columns. Therefore, $A$ is a permutation matrix.\n\nThe inverse of a permutation matrix can be found as follows: \n\n$$\n{P}^{-1}={P}^{T}\n$$\n\nIn our case, we obtain\n\n$$\n\\begin{aligned}{A}^{-1}={[\\begin{aligned}0 & 0 & 1 \\\\ 1 & 0 & 0 \\\\ 0 & 1 & 0\\end{aligned}]}^{-1}={[\\begin{aligned}0 & 0 & 1 \\\\ 1 & 0 & 0 \\\\ 0 & 1 & 0\\end{aligned}]}^{T}=[\\begin{aligned}0 & 1 & 0 \\\\ 0 & 0 & 1 \\\\ 1 & 0 & 0\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-135366/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6affd858-749d-5a94-854e-ddadd790ae45"] :knowledge-point/questions ["q-135366"] :db/ensure [:knowledge-point/validate]} {:db/id "q-135367/selection/ec1386d0c7de40450936daa7993ba54817db76057a9c1137eababe6e69ae1b6c" :answer/id #uuid "f08b447b-d302-56fc-bdc6-f5bd64bdfa68" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 1 & 1 \\\\ 1 & 1 & 0 \\\\ 1 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-135367/selection/1fbcb6c2e4d759a46302ddae778618beb294391fda6b04867b1e502a05dfdde1" :answer/id #uuid "bb5ab357-7cac-5a9d-80af-bda0990c82d8" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 & 0 & 0 \\\\ 0 & 0 & -1 \\\\ 0 & -1 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-135367/selection/022b