/question-capture-workers/linear/14070476/state.json" "file_sha256" "bb319241702f26d3134acb0ff79440ad1b22e94950248c5cb08fa2f27c10db76"} {"question" "q-135373" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-1 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & -1\\end{aligned}]"] ["math" "[\\begin{aligned}-1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -1\\end{aligned}]"] ["math" "[\\begin{aligned}0 & 0 & -1 \\\\ 0 & -1 & 0 \\\\ -1 & 0 & 0\\end{aligned}]"] ["math" "[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}]"] ["math" "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070476/state.json" "file_sha256" "bb319241702f26d3134acb0ff79440ad1b22e94950248c5cb08fa2f27c10db76"} {"question" "q-135373" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}]"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070476/state.json" "file_sha256" "bb319241702f26d3134acb0ff79440ad1b22e94950248c5cb08fa2f27c10db76"} {"question" "q-135393" "field" nil "attribute" "question/problem" "value" "Find the inverse of the following matrix:\n\n$$\nA=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -2 & 1\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070476/state.json" "file_sha256" "bb319241702f26d3134acb0ff79440ad1b22e94950248c5cb08fa2f27c10db76"} {"question" "q-135393" "field" nil "attribute" "question/worked-solution" "value" "Notice that we're given a Frobenius matrix:\n\n- all entries on the main diagonal are ones\n\n- the matrix has only one column (the $2$nd column) where some entries below the main diagonal are not zeros\n\n- all the other entries outside the main diagonal are zeros\n\nTo find the inverse of a Frobenius matrix, we simply take the non-zero entries outside the main diagonal with opposite signs. \n\nIn our case, we obtain\n\n$$\n\\begin{aligned}{A}^{-1}={[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -2 & 1\\end{aligned}]}^{-1}=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 2 & 1\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070476/state.json" "file_sha256" "bb319241702f26d3134acb0ff79440ad1b22e94950248c5cb08fa2f27c10db76"} {"question" "q-135393" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070476/activity-metadata.json" "file_sha256" "e995597b22ac8c67939a86558392bc9717625f07bdb3494f044688b5cd86a273"} {"question" "q-135393" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070476/state.json" "file_sha256" "bb319241702f26d3134acb0ff79440ad1b22e94950248c5cb08fa2f27c10db76"} {"question" "q-135393" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}1 & -2 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]"] ["math" "[\\begin{aligned}1 & -\\frac{1}{2} & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]"] ["math" "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -\\frac{1}{2} & 1\\end{aligned}]"] ["math" "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 2 & 1\\end{aligned}]"] ["math" "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & \\frac{1}{2} & 1\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070476/state.json" "file_sha256" "bb319241702f26d3134acb0ff79440ad1b22e94950248c5cb08fa2f27c10db76"} {"question" "q-135393" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 2 & 1\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070476/state.json" "file_sha256" "bb319241702f26d3134acb0ff79440ad1b22e94950248c5cb08fa2f27c10db76"} {"question" "q-135397" "field" nil "attribute" "question/problem" "value" "Find the inverse of the following matrix:\n\n$$\nA=[\\begin{aligned}1 & 0 & 0 \\\\ \\sqrt{2} & 1 & 0 \\\\ -2 & 0 & 1\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070476/state.json" "file_sha256" "bb319241702f26d3134acb0ff79440ad1b22e94950248c5cb08fa2f27c10db76"} {"question" "q-135397" "field" nil "attribute" "question/worked-solution" "value" "Notice that we're given a Frobenius matrix:\n\n- all entries on the main diagonal are ones\n\n- the matrix has only one column (the $1$st column) where some entries below the main diagonal are not zeros\n\n- all the other entries outside the main diagonal are zeros\n\nTo find the inverse of a Frobenius matrix, we simply take the non-zero entries outside the main diagonal with opposite signs. \n\nIn our case, we obtain\n\n$$\n\\begin{aligned}{A}^{-1}={[\\begin{aligned}1 & 0 & 0 \\\\ \\sqrt{2} & 1 & 0 \\\\ -2 & 0 & 1\\end{aligned}]}^{-1}=[\\begin{aligned}1 & 0 & 0 \\\\ -\\sqrt{2} & 1 & 0 \\\\ 2 & 0 & 1\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070476/state.json" "file_sha256" "bb319241702f26d3134acb0ff79440ad1b22e94950248c5cb08fa2f27c10db76"} {"question" "q-135397" "field" nil "attribute" "question/difficulty" "value" :question.dif