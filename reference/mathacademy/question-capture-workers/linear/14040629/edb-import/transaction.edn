0141edc299fabdb127bc6248857d64dd75d70a"] :db/ensure [:answer-field/validate]} {:db/id "q-114685" :question/id #uuid "582936cd-ad73-5d84-91d0-0e021f4969e3" :question/math-academy-id "q-114685" :question/problem "$\\int (3{x}^{2}-{sin}^{2}⁡x+{cos}^{2}⁡x)\\text{d}x=$" :question/worked-solution "We can use the double-angle formula for cosine:\n\n$$\n{cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta =\\operatorname{cos}⁡2\\theta \n$$\n\nTherefore, \n\n$$\n\\begin{aligned}\\int (3{x}^{2}-{sin}^{2}⁡x+{cos}^{2}⁡x)\\text{d}x & =\\int (3{x}^{2}+{cos}^{2}⁡x-{sin}^{2}⁡x)\\text{d}x \\\\  & =\\int (3{x}^{2}+\\operatorname{cos}⁡2x)\\text{d}x \\\\  & =3(\\frac{1}{3}{x}^{3})+\\frac{1}{2}\\operatorname{sin}⁡2x+C \\\\  & ={x}^{3}+\\frac{1}{2}\\operatorname{sin}⁡2x+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-114685/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "064d3c62-5cfc-502b-aba4-48e40042593f"] :knowledge-point/questions ["q-114685"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74403/selection/76e58a84c9fa7351d6c2426dbf81a4f59dbfa91e97d80296410f110f58437668" :answer/id #uuid "718e047b-bdee-561c-a8c7-ab2fa2e7ff19" :answer/type :answer.type/math :answer/value "3\\operatorname{sin}⁡2x+1+C" :db/ensure [:answer/validate]} {:db/id "q-74403/selection/18897749b2d7ade40da7ddb6952033d8cc6f42c4b93703f28b2b8d0e00e7bd90" :answer/id #uuid "0b1df459-e9e7-5e24-ae93-8f0ff084df92" :answer/type :answer.type/math :answer/value "\\frac{3}{2}\\operatorname{sin}⁡2x+x+C" :db/ensure [:answer/validate]} {:db/id "q-74403/selection/591e9e8d1b80eac63c40ecd44b3d30d04511acebbf0ff8250bec76f41a98ef9b" :answer/id #uuid "927025b0-c583-5026-b39b-a84e6e40b2d1" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\operatorname{sin}⁡2x+1+C" :db/ensure [:answer/validate]} {:db/id "q-74403/selection/ce7a0517366c6990d1133f08fba61802dab74721e29d2fa17dbcdde144be6448" :answer/id #uuid "ac2ffba9-fc21-5cdd-a62e-13a587b0f243" :answer/type :answer.type/math :answer/value "-3\\operatorname{sin}⁡2x+x+C" :db/ensure [:answer/validate]} {:db/id "q-74403/selection/8af2df73d6a16282653e03b83f26c227621560e4fdba6d5f876da6140a3c7eb9" :answer/id #uuid "519c467f-ada4-539f-8dfb-7981817b82dc" :answer/type :answer.type/math :answer/value "-\\frac{3}{2}\\operatorname{sin}⁡2x+x+C" :db/ensure [:answer/validate]} {:db/id "q-74403/selection" :answer-field/id #uuid "9503887d-706b-5511-bfd5-17f38263336e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74403/selection/18897749b2d7ade40da7ddb6952033d8cc6f42c4b93703f28b2b8d0e00e7bd90" :answer-field/choices ["q-74403/selection/76e58a84c9fa7351d6c2426dbf81a4f59dbfa91e97d80296410f110f58437668" "q-74403/selection/18897749b2d7ade40da7ddb6952033d8cc6f42c4b93703f28b2b8d0e00e7bd90" "q-74403/selection/591e9e8d1b80eac63c40ecd44b3d30d04511acebbf0ff8250bec76f41a98ef9b" "q-74403/selection/ce7a0517366c6990d1133f08fba61802dab74721e29d2fa17dbcdde144be6448" "q-74403/selection/8af2df73d6a16282653e03b83f26c227621560e4fdba6d5f876da6140a3c7eb9"] :db/ensure [:answer-field/validate]} {:db/id "q-74403" :question/id #uuid "12b0a367-b2dc-50bf-a676-57aa1201b034" :question/math-academy-id "q-74403" :question/problem "$\\int (3{cos}^{2}⁡x+1-3{sin}^{2}⁡x)\\text{d}x=$" :question/worked-solution "We can use the double-angle formula for cosine:\n\n$$\n{cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta =\\operatorname{cos}⁡2\\theta \n$$\n\nTherefore, \n\n$$\n\\begin{aligned}\\int (3{cos}^{2}⁡x+1-3{sin}^{2}⁡x)\\text{d}x & =\\int [3({cos}^{2}⁡x-{sin}^{2}⁡x)+1]\\text{d}x \\\\  & =\\int (3\\operatorname{cos}⁡2x+1)\\text{d}x \\\\  & =3(\\frac{1}{2}\\cdot \\operatorname{sin}⁡2x)+x+C \\\\  & =\\frac{3}{2}\\operatorname{sin}⁡2x+x+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-74403/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "064d3c62-5cfc-502b-aba4-48e40042593f"] :knowledge-point/questions ["q-74403"] :db/ensure [:knowledge-point/validate]} {:db/id "q-348724/field-1/5c63590be0bc4f85fcca2c90de8f776dd7aca0de895708950fed044b24d9faa1" :answer/id #uuid "db6c166e-72c3-552d-b524-d11113f0a364" :answer/type :answer.type/math :answer/value "\\frac{2\\pi^2}{3}" :db/ensure [:answer/validate]} {:db/id "q-348724/field-1/eb9b52c6b87bb362e158ba17585049c5d4613995935564530e0512bf68f09c4a" :answer/id #uuid "76d59c68-af09-5e9e-a3c5-93ed10ab20f8" :answer/type :answer.type/math :answer/value "\\frac{\\pi^2}{3}" :db/ensure [:answer/validate]} {:db/id "q-348724/field-1" :answer-field/id #uuid "98143ef5-3ba7-5bf3-8e38-a70e9df4babe" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-348724/field-1/5c63590be0bc4f85fcca2c90de8f776dd7aca0de895708950fed044b24d9faa1" :answer-field/choices ["q-348724/field-1/5c63590be0bc4f85fcca2c90de8f776dd7aca0de895708950fed044b24d9faa1" "q-348724/field-1/eb9b52c6b87bb362e158ba17585049c5d4613995935564530e0512bf68f09c4a"] :db/ensure [:answer-field/validate]} {:db/id "q-348724" :question/id #uuid "3ea82d24-c80c-5089-8bd5-efac42e51f83" :question/math-academy-id "q-348724" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{\\pi /6}^{\\pi /2}(2{cos}^{2}⁡3x-2{sin}^{2}⁡3x+6x)\\text{d}x=$\n{{field-1}}" :question/worked-solution "Here, we use the double-angle formula for cosine:\n\n$$\n\\operatorname{cos}⁡2\\theta ={cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta .\n$$\n\nLetting $\\theta =3x,$ we get\n\n$$\n\\operatorname{cos}⁡6x={cos}^{2}⁡3x-{sin}^{2}⁡3x.\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}{\\int }_{\\pi /6}^{\\pi /2}(2{cos}^{2}⁡3x-2{sin}^{2}⁡3x+6x)\\text{d}x & ={\\int }_{\\pi /6}^{\\pi /2}(2\\operatorname{cos}⁡6x+6x)\\text{d}x \\\\  & ={(\\frac{2}{6}\\operatorname{sin}⁡6x+\\frac{6}{2}{x}^{2})|}_{\\pi /6}^{\\pi /2} \\\\  & ={(\\frac{1}{3}\\operatorname{sin}⁡6x+3{x}^{2})|}_{\\pi /6}^{\\pi /2} \\\\  & =[\\frac{1}{3}\\operatorname{sin}⁡(3\\pi )+3{(\\frac{\\pi }{2})}^{2}]-[\\frac{1}{3}\\operatorname{sin}⁡(\\pi )+3{(\\frac{\\pi }{6})}^{2}] \\\\  & =3(\\frac{{\\pi }^{2}}{4}-\\frac{{\\pi }^{2}}{36}) \\\\  & =\\frac{2{\\pi }^{2}}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-348724/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "064d3c62-5cfc-502b-aba4-48e40042593f"] :knowledge-point/questions ["q-348724"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74404/selection/5538af2fcefcde9e7c5bc220fe0082e736a045777c258e2280dd6b71dd8514c3" :answer/id #uuid "9f1f66d5-d53e-5f54-b9b9-a5e297a8c222" :answer/type :answer.type/math :answer/value "-\\frac{1}{8}\\operatorname{sin}⁡8x+C" :db/ensure [:answer/validate]} {:db/id "q-74404/selection/72f7a605df14b5e41cc596607c90503588316f35b80dcbaa8d3bc8dfb2d4240f" :answer/id #uuid "70c146da-be59-5567-be1a-047dca2fab98" :answer/type :answer.type/math :answer/value "-\\operatorname{sin}⁡8x+C" :db/ensure [:answer/validate]} {:db/id "q-74404/selection/6ecff3475118a52d0afb9c18902bad0eaee498f145ca6726c9a7d2ee6ee73115" :answer/id #uuid "9887b432-2bac-5735-80b4-90f4cdd9bbd0" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡8x+C" :db/ensure [:answer/validate]} {:db/id "q-74404/selection/01ad847a6ec5e575f641067ca4fed6aaa19703bbeb898a9e28ae0f77e0079fa7" :answer/id #uuid "09624124-1a88-5e39-af04-3d107ef290dc" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\operatorname{sin}⁡8x+C" :db/ensure [:answer/validate]} {:db/id "q-74404/selection/c41baf442821e5be73cdf2e1273484033a8319046dd1f37941f8a57a3d78edcf" :answer/id #uuid "ebd18883-e483-5895-a9ec-002ebcf28696" :answer/type :answer.type/math :answer/value "\\frac{1}{8}\\operatorname{sin}⁡8x+C" :db/ensure [:answer/validate]} {:db/id "q-74404/selection" :answer-field/id #uuid "ac197894-0e81-5570-a0fc-901dd079e6e5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74404/selection/c41baf442821e5be73cdf2e1273484033a8319046dd1f37941f8a57a3d78edcf" :answer-field/choices ["q-74404/selection/5538af2fcefcde9e7c5bc220fe0082e736a045777c258e2280dd6b71dd8514c3" "q-74404/selection/72f7a605df14b5e41cc596607c90503588316f35b80dcbaa8d3bc8dfb2d4240f" "q-74404/selection/6ecff3475118a52d0afb9c18902bad0eaee498f145ca6726c9a7d2ee6ee73115" "q-74404/selection/01ad847a6ec5e575f641067ca4fed6aaa19703bbeb898a9e28ae0f77e0079fa7" "q-74404/selection/c41baf442821e5be73cdf2e1273484033a8319046dd1f37941f8a57a3d78edcf"] :db/ensure [:answer-field/validate]} {:db/id "q-74404" :question/id #uuid "ef0bc46e-ed04-5efb-b68b-f38a43690c98" :question/math-academy-id "q-74404" :question/problem "$\\int ({cos}^{2}⁡4x-{sin}^{2}⁡4x)\\text{d}x=$" :question/worked-solution "Here, we use the double-angle formula for cosine:\n\n$$\n\\operatorname{cos}⁡2\\theta ={cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta \n$$\n\nLetting $\\theta =4x,$ we get\n\n$$\n\\operatorname{cos}⁡8x={cos}^{2}⁡4x-{sin}^{2}⁡4x.\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}\\int ({cos}^{2}⁡4x-{sin}^{2}⁡4x)\\text{d}x & =\\int \\operatorname{cos}⁡8x\\,\\text{d}x \\\\  & =\\frac{1}{8}\\operatorname{sin}⁡8x+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-74404/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "064d3c62-5cfc-502b-aba4-48e40042593f"] :knowledge-point/questions ["q-74404"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-49297"] :question/problem "Evaluate \n${\\int }_{\\pi }^{2\\pi }(2{cos}^{2}⁡2x-{x}^{2})\\text{d}x.$" :question/worked-solution "Here, we use the double-angle formula for cosine that involves the ${cos}^{2}⁡\\theta $ term, given by\n\n$$\n\\operatorname{cos}⁡2\\theta =2{cos}^{2}⁡\\theta -1.\n$$\n\n \n\nRearranging, we have\n\n$$\n{cos}^{2}⁡\\theta =\\frac{1}{2}(\\operatorname{cos}⁡2\\theta +1).\n$$\n\nLetting $\\theta =2x$, we have\n\n$$\n2{cos}^{2}⁡2x=2[\\frac{1}{2}(\\operatorname{cos}⁡4x+1)]=\\operatorname{cos}⁡4x+1.\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}{\\int }_{\\pi }^{2\\pi }(2{cos}^{2}⁡2x-{x}^{2})\\text{d}x & ={\\int }_{\\pi }^{2\\pi }(\\operatorname{cos}⁡4x+1-{x}^{2})\\,\\text{d}x \\\\  & ={(\\frac{1}{4}\\operatorname{sin}⁡4x+x-\\frac{1}{3}{x}^{3})|}_{\\pi }^{2\\pi } \\\\  & =[\\frac{1}{4}\\operatorname{sin}⁡2\\pi +2\\pi -\\frac{1}{3}\\cdot 2{\\pi }^{3}]-[\\frac{1}{4}\\operatorname{sin}⁡4\\pi +\\pi -\\frac{1}{3}{\\pi }^{3}] \\\\  & =2\\pi -\\frac{8{\\pi }^{3}}{3}-\\pi +\\frac{{\\pi }^{3}}{3} \\\\  & =\\pi -\\frac{7{\\pi }^{3}}{3} \\\\  & =\\frac{3\\pi -7{\\pi }^{3}}{3} \\\\  & =\\frac{\\pi (3-7{\\pi }^{2})}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-348766/field-1/64e30c82eef5691561bfd250c52f7857cc523ff8c5ca0a30cd86d8eec79a1471" :answer/id #uuid "8d1c4de3-983f-562f-a2f4-b741d4cd634a" :answer/type :answer.type/math :answer/value "2\\pi^2" :db/ensure [:answer/validate]} {:db/id 17592186288706 :answer-field/choices ["q-348766/field-1/64e30c82eef5691561bfd250c52f7857cc523ff8c5ca0a30cd86d8eec79a1471"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-348766"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040629/assets/5e40f35729a8e3df9f8403cad85bf0c4e6045733616c86cc399548a901c03ac7.png)\n\nA region in the $xy$-plane is bounded by the curve $y=2{cos}^{2}⁡x+x-1,$ the $x$-axis and the lines $x=\\frac{\\pi }{2}$ and $x=\\frac{3\\pi }{2},$ as shown above. The area of the region is\n\n$A=$\n{{field-1}}" :db/ensure [:question/validate]} {:db/id "q-49294/selection/f0f45940ed5df71758de7ff31ea171bc0689f380be113b3538530f3180b5105f" :answer/id #uuid "d9fa1dc7-f9d1-5d10-8eba-bff6dbe5acb4" :answer/type :answer.type/math :answer/value "\\frac{5\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-49294/selection/7073ddf865f0c9f97383f3a07b5458c92de9192b8b4e23bd69709c0792828aba" :answer/id #uuid "7b22b545-5cbd-59d0-a10c-e125008389ae" :answer/type :answer.type/math :answer/value "\\frac{9\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-49294/selection/8b0da25323387be7cd3dda381ee4e2ebbdc8b10be241bc2e3eeead0da24f888a" :answer/id #uuid "4e3de36f-be1f-55c5-b346-f8df85ebd217" :answer/type :answer.type/math :answer/value "5\\pi " :db/ensure [:answer/validate]} {:db/id "q-49294/selection/7a6dd5c496cf644a0db1a143c782adf0b4431eb2e3247c917eb0caf7a1522233" :answer/id #uuid "5c65b912-2ecc-5687-a187-03b23eab14f5" :answer/type :answer.type/math :answer/value "\\frac{11\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-49294/selection/1a2c3881891ab7eca8aa4af8d7002d84b8252f633df18da1be453e64ebd8a8b4" :answer/id #uuid "a062e6b2-270d-5706-ac54-52f5b414b139" :answer/type :answer.type/math :answer/value "4\\pi " :db/ensure [:answer/validate]} {:db/id "q-49294/selection" :answer-field/id #uuid "5535757e-39e9-5d86-b35f-1e14b8dcaa5d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49294/selection/7073ddf865f0c9f97383f3a07b5458c92de9192b8b4e23bd69709c0792828aba" :answer-field/choices ["q-49294/selection/f0f45940ed5df71758de7ff31ea171bc0689f380be113b3538530f3180b5105f" "q-49294/selection/7073ddf865f0c9f97383f3a07b5458c92de9192b8b4e23bd69709c0792828aba" "q-49294/selection/8b0da25323387be7cd3dda381ee4e2ebbdc8b10be241bc2e3eeead0da24f888a" "q-49294/selection/7a6dd5c496cf644a0db1a143c782adf0b4431eb2e3247c917eb0caf7a1522233" "q-49294/selection/1a2c3881891ab7eca8aa4af8d7002d84b8252f633df18da1be453e64ebd8a8b4"] :db/ensure [:answer-field/validate]} {:db/id "q-49294" :question/id #uuid "d2b44089-9275-5484-b599-c98b3e9d6e71" :question/math-academy-id "q-49294" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040629/assets/dcc78643dd44633f778d954de32a955dc5803abf7dc059c30bbbda97bc35413f.png)\n\nA region in the $xy$-plane is bounded by the curve $y=2{cos}^{2}⁡x+{sin}^{2}⁡x,$ the $x$-axis and the lines $x=-\\frac{\\pi }{2}$ and $x=\\pi ,$ as shown above. The area of the region is" :question/worked-solution "The area of the region is given by\n\n$$\nA={\\int }_{-\\pi /2}^{\\pi }(2{cos}^{2}⁡x+{sin}^{2}⁡x)\\,\\text{d}x.\n$$\n\nRecall  ${cos}^{2}⁡x+{sin}^{2}⁡x=1,$ so we have \n\n$$\n\\begin{aligned}2{cos}^{2}⁡x+{sin}^{2}⁡x & ={cos}^{2}⁡x+({sin}^{2}⁡x+{cos}^{2}⁡x) \\\\  & ={cos}^{2}⁡x+1.\\end{aligned}\n$$\n\nHere, we use the double-angle formula for cosine that involves the ${cos}^{2}⁡x$ term, given by\n\n$$\n\\operatorname{cos}⁡2x=2{cos}^{2}⁡x-1.\n$$\n\n \n\nRearranging, we have\n\n$$\n{cos}^{2}⁡x=\\frac{1}{2}(\\operatorname{cos}⁡2x+1).\n$$\n\nHence, the area of the region is\n\n$$\n\\begin{aligned}A & ={\\int }_{-\\pi /2}^{\\pi }({cos}^{2}⁡x+1)\\,\\text{d}x \\\\  & ={\\int }_{-\\pi /2}^{\\pi }[\\frac{1}{2}(\\operatorname{cos}⁡2x+1)+1]\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /2}^{\\pi }(\\operatorname{cos}⁡2x+3)\\,\\text{d}x \\\\  & =\\frac{1}{2}{(\\frac{1}{2}\\operatorname{sin}⁡2x+3x)|}_{-\\pi /2}^{\\pi } \\\\  & =\\frac{1}{2}[(\\frac{1}{2}\\operatorname{sin}⁡2\\pi +3\\pi )-(\\frac{1}{2}\\operatorname{sin}⁡(-\\pi )-\\frac{3\\pi }{2})] \\\\  & =\\frac{1}{2}(3\\pi +\\frac{3\\pi }{2}) \\\\  & =\\frac{1}{2}(\\frac{9\\pi }{2}) \\\\  & =\\frac{9\\pi }{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-49294/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b466bd78-724b-51b2-8fee-7991bf7b60d2"] :knowledge-point/questions ["q-49294"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49299/selection/87500fb6a34cb58163046cd3c76255afca2e7ce9d09f33fbcf502bbc41d4fce0" :answer/id #uuid "da323ecd-c961-5bef-a340-53426046d387" :answer/type :answer.type/math :answer/value "3{\\pi }^{2}-1" :db/ensure [:answer/validate]} {:db/id "q-49299/selection/9c506beb45cf88fc18905b0692b1a83f315a70253d9b0929232abcf3e5d0e4cd" :answer/id #uuid "eecb1c43-e6ed-582f-9ce2-ed9e9c7e1dca" :answer/type :answer.type/math :answer/value "\\frac{11{\\pi }^{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-49299/selection/39ce6c1758dda4aab76bf2b9b2f564f1db140ac1bbc46a03700d6356d7b60b54" :answer/id #uuid "aacd1714-1550-51d2-89c6-a24593dd23ff" :answer/type :answer.type/math :answer/value "\\frac{{\\pi }^{2}-2}{3}" :db/ensure [:answer/validate]} {:db/id "q-49299/selection/b48efa5c53471e4e90860807204bfe9f8ef5e110231de50f6c8454240c1feb37" :answer/id #uuid "ea6972e9-4a9f-5d60-8abb-85972aa5c031" :answer/type :answer.type/math :answer/value "\\frac{\\pi (8\\pi +1)}{8}" :db/ensure [:answer/validate]} {:db/id "q-49299/selection/f31ea70980dbdd0a44a4408e696c2ae8f35a1e6d43af844ba40a8675c54e8b09" :answer/id #uuid "9a1de0ef-72c4-5332-8967-6972faab508d" :answer/type :answer.type/math :answer/value "\\frac{\\pi (3\\pi -2)}{4}" :db/ensure [:answer/validate]} {:db/id "q-49299/selection" :answer-field/id #uuid "b15776f4-6403-5a3b-8397-ce952293bb85" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49299/selection/f31ea70980dbdd0a44a4408e696c2ae8f35a1e6d43af844ba40a8675c54e8b09" :answer-field/choices ["q-49299/selection/87500fb6a34cb58163046cd3c76255afca2e7ce9d09f33fbcf502bbc41d4fce0" "q-49299/selection/9c506beb45cf88fc18905b0692b1a83f315a70253d9b0929232abcf3e5d0e4cd" "q-49299/selection/39ce6c1758dda4aab76bf2b9b2f564f1db140ac1bbc46a03700d6356d7b60b54" "q-49299/selection/b48efa5c53471e4e90860807204bfe9f8ef5e110231de50f6c8454240c1feb37" "q-49299/selection/f31ea70980dbdd0a44a4408e696c2ae8f35a1e6d43af844ba40a8675c54e8b09"] :db/ensure [:answer-field/validate]} {:db/id "q-49299" :question/id #uuid "192ba048-78c9-5502-80f4-7a84b95c60aa" :question/math-academy-id "q-49299" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040629/assets/20844131c3d35b02f0ba7c6567b7765a54f0909e63ee309181dd5a25248dbfd5.png)\n\nA region in the $xy$-plane is bounded by the curve $y=-2{sin}^{2}⁡x+2x,$ the $x$-axis and the lines $x=\\frac{\\pi }{2}$ and $x=\\pi $, as shown above. The area of the region is" :question/worked-solution "The area of the region bounded by the curve $y=-2{sin}^{2}⁡x+2x,$ the $x$-axis and the lines $x=\\frac{\\pi }{2}$ and $x=\\pi $ is \n\n$$\nA={\\int }_{\\pi /2}^{\\pi }(-2{sin}^{2}⁡x+2x)\\,\\text{d}x.\n$$\n\nLet's recall the double-angle formula for cosine that involves the ${sin}^{2}$ term: \n\n$$\n\\operatorname{cos}⁡2x=1-2{sin}^{2}⁡x\n$$\n\nWe can rearrange the above formula as\n\n$$\n\\operatorname{cos}⁡2x-1=-2{sin}^{2}⁡x.\n$$\n\nWe can now integrate as follows:\n\n$$\n\\begin{aligned}A & ={\\int }_{\\pi /2}^{\\pi }(-2{sin}^{2}⁡x+2x)\\,\\text{d}x \\\\  & ={\\int }_{\\pi /2}^{\\pi }(\\operatorname{cos}⁡2x-1+2x)\\,\\text{d}x \\\\  & ={(\\frac{1}{2}\\operatorname{sin}⁡2x-x+{x}^{2})|}_{\\pi /2}^{\\pi } \\\\  & =[\\frac{1}{2}\\operatorname{sin}⁡2\\pi -\\pi +{\\pi }^{2}]-[\\frac{1}{2}\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{2})-\\frac{\\pi }{2}+\\frac{{\\pi }^{2}}{{2}^{2}}] \\\\  & =-\\pi +{\\pi }^{2}+\\frac{\\pi }{2}-\\frac{{\\pi }^{2}}{4} \\\\  & =\\frac{4{\\pi }^{2}-4\\pi -{\\pi }^{2}+2\\pi }{4} \\\\  & =\\frac{3{\\pi }^{2}-2\\pi }{4} \\\\  & =\\frac{\\pi (3\\pi -2)}{4}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-49299/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "31f3ead1-2549-5b61-baf9-0437ba28f09d"] :knowledge-point/questions ["q-49299"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-51127"] :question/problem "Calculate $\\int {sin}^{2}⁡x\\,\\text{d}x.$" :question/worked-solution "Let's recall the double-angle formula for cosine that involves the ${sin}^{2}$ term: \n\n$$\n\\operatorname{cos}⁡2x=1-2{sin}^{2}⁡x.\n$$\n\nWe can rearrange the above formula as\n\n$$\n\\frac{1}{2}(1-\\operatorname{cos}⁡2x)={sin}^{2}⁡x.\n$$\n\nWe can now integrate as follows:\n\n$$\n\\begin{aligned}\\int {sin}^{2}⁡x\\,\\text{d}x & =\\int \\frac{1}{2}(1-\\operatorname{cos}⁡2x)\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int (1-\\operatorname{cos}⁡2x)\\,\\text{d}x \\\\  & =\\frac{1}{2}(x-\\frac{1}{2}\\operatorname{sin}⁡2x)+C \\\\  & =\\frac{1}{2}x-\\frac{1}{4}\\operatorname{sin}⁡2x+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-348852/field-1/274c262b275986dca13bee168dda3df46afec66d15edb8d1b76c6a3beb3107cb" :answer/id #uuid "842161b7-0cab-5ebd-a4ed-0ffcd0c29574" :answer/type :answer.type/math :answer/value "\\frac{3\\pi^2}{2}" :db/ensure [:answer/validate]} {:db/id "q-348852/field-1" :answer-field/id #uuid "ea492ab3-cc2a-5743-9b68-03b6b0b54dc4" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-348852/field-1/274c262b275986dca13bee168dda3df46afec66d15edb8d1b76c6a3beb3107cb" :answer-field/choices ["q-348852/field-1/274c262b275986dca13bee168dda3df46afec66d15edb8d1b76c6a3beb3107cb"] :db/ensure [:answer-field/validate]} {:db/id "q-348852" :question/id #uuid "af9f658c-f88f-52fc-86e4-26004d3557fd" :question/math-academy-id "q-348852" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{\\pi }^{2\\pi }[6{sin}^{2}\\,(\\frac{x}{4})-3+3cos\\,(\\frac{x}{2})+x]\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "Let's recall the double-angle formula for cosine that involves the ${sin}^{2}$ term: \n\n$$\n\\operatorname{cos}⁡2\\theta =1-2{sin}^{2}⁡\\theta \n$$\n\nWe can rearrange the above formula as\n\n$$\n\\frac{1}{2}(1-\\operatorname{cos}⁡2\\theta )={sin}^{2}⁡\\theta .\n$$\n\nLetting $\\theta =\\frac{x}{4},$ we have\n\n$$\n6{sin}^{2}\\,(\\frac{x}{4})=3(1-cos\\,(\\frac{x}{2})).\n$$\n\nWe can now integrate as follows:\n\n$$\n\\begin{aligned}{\\int }_{\\pi }^{2\\pi }\\,\\,[6{sin}^{2}\\,(\\frac{x}{4})-3+3cos\\,(\\frac{x}{2})+x]dx & ={\\int }_{\\pi }^{2\\pi }\\,\\,[3-3cos\\,(\\frac{x}{2})-3+3cos\\,(\\frac{x}{2})+x]dx \\\\  & ={\\int }_{\\pi }^{2\\pi }x\\,dx \\\\  & ={\\frac{{x}^{2}}{2}|}_{\\pi }^{2\\pi } \\\\  & =\\frac{(2\\pi )^{2}-{\\pi }^{2}}{2} \\\\  & =\\frac{3{\\pi }^{2}}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-348852/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "31f3ead1-2549-5b61-baf9-0437ba28f09d"] :knowledge-point/questions ["q-348852"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74411/selection/f53622aeb18662ea57aef6b590b4c366076960338844e636e25893dc15c68972" :answer/id #uuid "59e8956d-5676-5586-9ce3-f3a9c9905de0" :answer/type :answer.type/math :answer/value "x-2\\operatorname{sin}⁡6x+C" :db/ensure [:answer/validate]} {:db/id "q-74411/selection/ff9a67b23f067462b2a708e462024d16c05b00056d12fb1fab6a64362771624b" :answer/id #uuid "80feccf5-caee-5dcd-81a1-46b031a56d70" :answer/type :answer.type/math :answer/value "x-\\frac{\\operatorname{sin}⁡6x}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-74411/selection/4b6f1a92a8bb4c571d4745b1d7c5a199d9169f79aa547ec3e225cdac2be98cf0" :answer/id #uuid "0254a88c-36fa-5f26-a7df-8bf243a71778" :answer/type :answer.type/math :answer/value "3x-\\frac{\\operatorname{sin}⁡6x}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-74411/selection/b2cca359d3d3962ea0026d3db1239ce0744dab6f05016ac4eb28c9ae54337c9f" :answer/id #uuid "3a44b182-07e3-553e-bd35-c3c2bb2bd76d" :answer/type :answer.type/math :answer/value "3x-\\operatorname{sin}⁡6x+C" :db/ensure [:answer/validate]} {:db/id "q-74411/selection" :answer-field/id #uuid "4d319f66-f2fd-56a4-a945-37930b4c2292" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74411/selection/4b6f1a92a8bb4c571d4745b1d7c5a199d9169f79aa547ec3e225cdac2be98cf0" :answer-field/choices ["q-74411/selection/f53622aeb18662ea57aef6b590b4c366076960338844e636e25893dc15c68972" "q-74411/selection/ff9a67b23f067462b2a708e462024d16c05b00056d12fb1fab6a64362771624b" "q-74411/selection/4b6f1a92a8bb4c571d4745b1d7c5a199d9169f79aa547ec3e225cdac2be98cf0" "q-74411/selection/b2cca359d3d3962ea0026d3db1239ce0744dab6f05016ac4eb28c9ae54337c9f"] :db/ensure [:answer-field/validate]} {:db/id "q-74411" :question/id #uuid "ddc02b71-b6b3-5e39-9bc4-f9919362f385" :question/math-academy-id "q-74411" :question/problem "Calculate\n$\\int 6{sin}^{2}⁡3x\\,\\text{d}x.$" :question/worked-solution "Let's recall the double-angle formula for cosine that involves the ${sin}^{2}$ term: \n\n$$\n\\operatorname{cos}⁡2\\theta =1-2{sin}^{2}⁡\\theta \n$$\n\nWe can rearrange the above formula as\n\n$$\n2{sin}^{2}⁡\\theta =1-\\operatorname{cos}⁡2\\theta .\n$$\n\nLetting $\\theta =3x$, we have\n\n$$\n2{sin}^{2}⁡3x=1-\\operatorname{cos}⁡6x.\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}\\int 6{sin}^{2}⁡3x\\,\\text{d}x & =\\int 3\\cdot 2{sin}^{2}⁡3x\\,\\text{d}x \\\\  & =\\int 3(1-\\operatorname{cos}⁡6x)\\text{d}x \\\\  & =\\int (3-3\\operatorname{cos}⁡6x)\\text{d}x \\\\  & =3x-\\frac{\\operatorname{sin}⁡6x}{2}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-74411/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "31f3ead1-2549-5b61-baf9-0437ba28f09d"] :knowledge-point/questions ["q-74411"] :db/ensure [:knowledge-point/validate]} {:db/id "q-348837/field-1/d2e5ac5d5dcba192fcba3a9943cd198d6d54ef2b54bcd6689f92dfae1fe7cd91" :answer/id #uuid "343a4fa6-cc8c-5385-ae4c-297b2c50024a" :answer/type :answer.type/math :answer/value "-\\frac{\\pi}{6}" :db/ensure [:answer/validate]} {:db/id "q-348837/field-1" :answer-field/id #uuid "f468b95c-c083-5e7f-aa17-9c9e4cce81d7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-348837/field-1/d2e5ac5d5dcba192fcba3a9943cd198d6d54ef2b54bcd6689f92dfae1fe7cd91" :answer-field/choices ["q-348837/field-1/d2e5ac5d5dcba192fcba3a9943cd198d6d54ef2b54bcd6689f92dfae1fe7cd91"] :db/ensure [:answer-field/validate]} {:db/id "q-348837" :question/id #uuid "6549d8b4-dd98-5be4-8fa6-e23e672f25d6" :question/math-academy-id "q-348837" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{\\pi /3}^{2\\pi /3}({cos}^{2}\\,(\\frac{3x}{2})-2{sin}^{2}\\,(\\frac{3x}{2}))\\,\\text{d}x=$ \n{{field-1}}" :question/worked-solution "Recall  ${cos}^{2}⁡\\theta =1-{sin}^{2}⁡\\theta ,$ so letting $\\theta =\\frac{3x}{2},$ we have\n\n$$\n\\begin{aligned}{cos}^{2}\\,(\\frac{3x}{2})-2{sin}^{2}\\,(\\frac{3x}{2}) & =1-{sin}^{2}\\,(\\frac{3x}{2})-2{sin}^{2}\\,(\\frac{3x}{2}) \\\\  & =1-3{sin}^{2}\\,(\\frac{3x}{2}).\\end{aligned}\n$$\n\nLet's recall the double-angle formula for cosine that involves the ${sin}^{2}$ term: \n\n$$\n\\operatorname{cos}⁡2\\theta =1-2{sin}^{2}⁡\\theta \n$$\n\nWe can rearrange the above formula as\n\n$$\n\\frac{1}{2}(1-\\operatorname{cos}⁡2\\theta )={sin}^{2}⁡\\theta .\n$$\n\nLetting $\\theta =\\frac{3x}{2},$ we have\n\n$$\n\\frac{1}{2}(1-\\operatorname{cos}⁡(3x))={sin}^{2}\\,(\\frac{3x}{2}).\n$$\n\nWe can now integrate as follows:\n\n$$\n\\begin{aligned}{\\int }_{\\pi /3}^{2\\pi /3}(1-3{sin}^{2}\\,(\\frac{3x}{2}))\\,\\text{d}x & ={\\int }_{\\pi /3}^{2\\pi /3}(1-3\\cdot \\frac{1}{2}(1-\\operatorname{cos}⁡(3x)))\\,\\text{d}x \\\\  & ={\\int }_{\\pi /3}^{2\\pi /3}(\\frac{3}{2}\\operatorname{cos}⁡(3x)-\\frac{1}{2})\\,\\text{d}x \\\\  & ={(\\frac{1}{2}\\operatorname{sin}⁡(3x)-\\frac{1}{2}x)\\,|}_{\\pi /3}^{2\\pi /3} \\\\  & =[\\frac{1}{2}\\operatorname{sin}⁡(3\\cdot \\frac{2\\pi }{3})-\\frac{1}{2}\\cdot \\frac{2\\pi }{3}]-[\\frac{1}{2}\\operatorname{sin}⁡(3\\cdot \\frac{\\pi }{3})-\\frac{1}{2}\\cdot \\frac{\\pi }{3}] \\\\  & =[0-\\frac{\\pi }{3}]-[0-\\frac{\\pi }{6}] \\\\  & =-\\frac{\\pi }{6}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-348837/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "31f3ead1-2549-5b61-baf9-0437ba28f09d"] :knowledge-point/questions ["q-348837"] :db/ensure [:knowledge-point/validate]}]
