9d2a-5258-91ad-8a4c83e1c2e9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186303677}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b03e35a1-e734-50b6-bb4d-c119df26dd8b" :question/math-academy-id "q-74402" :question/problem "$\\int ({cos}^{2}⁡x-{sin}^{2}⁡x)\\text{d}x=$" :question/worked-solution "We can use the double-angle formula for cosine:\n\n$$\n{cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta =\\operatorname{cos}⁡2\\theta \n$$\n\nTherefore, \n\n$$\n\\begin{aligned}\\int ({cos}^{2}⁡x-{sin}^{2}⁡x)\\text{d}x & =\\int \\operatorname{cos}⁡2x\\,\\text{d}x \\\\  & =\\frac{1}{2}\\operatorname{sin}⁡2x+C.\\end{aligned}\n$$"}]}
