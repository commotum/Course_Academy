#{[{:db/id #edb/ref 17592186315565 :knowledge-point/_questions [{:knowledge-point/id #uuid "21cef8c9-92ff-5527-a837-2236a0c1f9eb" :knowledge-point/title "Solving for an Unknown in an Equation Involving the Cross Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a5a3a32-3ec7-5c09-8e70-b9cf5a31ac91" :answer/type {:db/ident :answer.type/math} :answer/value "x=1" :db/id #edb/ref 17592186315567} {:answer/id #uuid "f787e2a1-a108-57d6-a197-91332c4c5fd5" :answer/type {:db/ident :answer.type/math} :answer/value "x=-1,\\,2" :db/id #edb/ref 17592186315568} {:answer/id #uuid "60440a4c-439d-5119-905c-67561e30bf29" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{2},\\,1" :db/id #edb/ref 17592186315569} {:answer/id #uuid "4f0cb6b0-78c4-5cee-ab00-3caf9cadda54" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{2},\\,2" :db/id #edb/ref 17592186315570} {:answer/id #uuid "c31e2fb8-44e8-5c3b-ade2-76d683db5509" :answer/type {:db/ident :answer.type/math} :answer/value "x=-2" :db/id #edb/ref 17592186315571}] :answer-field/correct {:answer/id #uuid "60440a4c-439d-5119-905c-67561e30bf29" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{2},\\,1" :db/id #edb/ref 17592186315569} :answer-field/id #uuid "ef892121-e7d4-5b3e-aa02-ae932bf62f5b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186315566}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "02a5a42a-3364-5f22-881f-c1eb596575d7" :question/math-academy-id "q-103552" :question/problem "Let $a=⟨0,-2,3⟩,$ $b=⟨-2,1,-2x⟩$ and $|\\,a\\times b\\,|=\\sqrt{53}.$ Find $x.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 0 & -2 & 3 \\\\ -2 & 1 & -2x\\end{aligned}| \\\\  & =|\\begin{aligned}-2 & 3 \\\\ 1 & -2x\\end{aligned}|i-|\\begin{aligned}0 & 3 \\\\ -2 & -2x\\end{aligned}|j+|\\begin{aligned}0 & -2 \\\\ -2 & 1\\end{aligned}|k \\\\  & =(4x-3)i-(0+6)j+(0-4)k \\\\  & =⟨4x-3,-6,-4⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{(4x-3)^{2}+(-6)^{2}+(-4)^{2}} \\\\  & =\\sqrt{16{x}^{2}-24x+9+36+16} \\\\  & =\\sqrt{16{x}^{2}-24x+61}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{53} \\\\ \\sqrt{16{x}^{2}-24x+61} & =\\sqrt{53} \\\\ 16{x}^{2}-24x+61 & =53 \\\\ 16{x}^{2}-24x+8 & =0 \\\\ 2{x}^{2}-3x+1 & =0 \\\\ (2x-1)(x-1) & =0 \\\\ x & =\\frac{1}{2},\\,1.\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\frac{1}{2},\\,1.$"}] [{:db/id #edb/ref 17592186318089 :knowledge-point/_questions [{:knowledge-point/id #uuid "733eab11-2a26-5402-8df5-bba50c9beaf9" :knowledge-point/title "Calculating the Cross Product Using Determinants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3012c61-1f39-57cd-b5c4-76fcb146b2c5" :answer/type {:db/ident :answer.type/math} :answer/value "6j" :db/id #edb/ref 17592186318091} {:answer/id #uuid "939e3efb-4761-59bb-8e9d-7fc08287b770" :answer/type {:db/ident :answer.type/math} :answer/value "8i" :db/id #edb/ref 17592186318092} {:answer/id #uuid "32073622-9481-5c5b-a8b9-d5d623398447" :answer/type {:db/ident :answer.type/math} :answer/value "3i+8k" :db/id #edb/ref 17592186318093} {:answer/id #uuid "c204d2bc-d0c1-50b4-b93a-c7c6292dc7ed" :answer/type {:db/ident :answer.type/math} :answer/value "3k" :db/id #edb/ref 17592186318094} {:answer/id #uuid "2c7109ce-871b-5055-8c12-884343ed0871" :answer/type {:db/ident :answer.type/math} :answer/value "4i-2j+3k" :db/id #edb/ref 17592186318095}] :answer-field/correct {:answer/id #uuid "a3012c61-1f39-57cd-b5c4-76fcb146b2c5" :answer/type {:db/ident :answer.type/math} :answer/value "6j" :db/id #edb/ref 17592186318091} :answer-field/id #uuid "7c08c9a6-c05a-5589-9bf4-38df62a78cab" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318090}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ecff366b-b6f0-5860-8fdc-e1e80643e44b" :question/math-academy-id "q-19782" :question/problem "Let $a=⟨0,0,3⟩$ and $b=⟨2,0,1⟩.$ Find $a\\times b.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 0 & 0 & 3 \\\\ 2 & 0 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 3 \\\\ 0 & 1\\end{aligned}|i-|\\begin{aligned}0 & 3 \\\\ 2 & 1\\end{aligned}|j+|\\begin{aligned}0 & 0 \\\\ 2 & 0\\end{aligned}|k \\\\  & =((0)(1)-(0)(3))i-((0)(1)-(2)(3))j+((0)(0)-(2)(0))k \\\\  & =(0-0)i-(0-6)j+(0-0)k \\\\  & =6j.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186318096 :knowledge-point/_questions [{:knowledge-point/id #uuid "733eab11-2a26-5402-8df5-bba50c9beaf9" :knowledge-point/title "Calculating the Cross Product Using Determinants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f5e29017-b8f5-56f2-90eb-487eba72f3c4" :answer/type {:db/ident :answer.type/math} :answer/value "7i+8j-12k" :db/id #edb/ref 17592186318098} {:answer/id #uuid "2364ac21-a148-5e19-a10e-bb1059403c36" :answer/type {:db/ident :answer.type/math} :answer/value "-14i+18j+6k" :db/id #edb/ref 17592186318099} {:answer/id #uuid "5fc6bf75-00ba-5c1c-87e1-e6a626c63c3f" :answer/type {:db/ident :answer.type/math} :answer/value "8i+12j-17k" :db/id #edb/ref 17592186318100} {:answer/id #uuid "cb8f1154-26f8-5dec-a540-40139ebfea75" :answer/type {:db/ident :answer.type/math} :answer/value "8i+12j-7k" :db/id #edb/ref 17592186318101} {:answer/id #uuid "b43c56c1-4951-50b8-8dd0-56af886726c2" :answer/type {:db/ident :answer.type/math} :answer/value "-12i+8j-7k" :db/id #edb/ref 17592186318102}] :answer-field/correct {:answer/id #uuid "b43c56c1-4951-50b8-8dd0-56af886726c2" :answer/type {:db/ident :answer.type/math} :answer/value "-12i+8j-7k" :db/id #edb/ref 17592186318102} :answer-field/id #uuid "4e600a78-555f-5580-ae1e-3ef782908f55" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318097}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "db59fadf-020c-5124-bcf7-f6360dfa1802" :question/math-academy-id "q-19787" :question/problem "Let $a=⟨1,5,4⟩$ and $b=⟨2,3,0⟩.$ Find $a\\times b.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 1 & 5 & 4 \\\\ 2 & 3 & 0\\end{aligned}| \\\\  & =|\\begin{aligned}5 & 4 \\\\ 3 & 0\\end{aligned}|i-|\\begin{aligned}1 & 4 \\\\ 2 & 0\\end{aligned}|j+|\\begin{aligned}1 & 5 \\\\ 2 & 3\\end{aligned}|k \\\\  & =((5)(0)-(3)(4))i-((1)(0)-(2)(4))j+((1)(3)-(2)(5))k \\\\  & =(0-12)i-(0-8)j+(3-10)k \\\\  & =-12i+8j-7k.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186318103 :knowledge-point/_questions [{:knowledge-point/id #uuid "733eab11-2a26-5402-8df5-bba50c9beaf9" :knowledge-point/title "Calculating the Cross Product Using Determinants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fdd9955a-377f-5d76-8eb5-9fadd44cba22" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186318105} {:answer/id #uuid "782ad791-7780-514b-9c8a-49517256f889" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186318106}] :answer-field/correct {:answer/id #uuid "782ad791-7780-514b-9c8a-49517256f889" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186318106} :answer-field/id #uuid "12874d1c-11ec-5996-85dd-d4a12794eb59" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318104} {:answer-field/choices [{:answer/id #uuid "b11176b1-86a4-5508-9060-761f97effa51" :answer/type {:db/ident :answer.type/math} :answer/value "38" :db/id #edb/ref 17592186318108}] :answer-field/correct {:answer/id #uuid "b11176b1-86a4-5508-9060-761f97effa51" :answer/type {:db/ident :answer.type/math} :answer/value "38" :db/id #edb/ref 17592186318108} :answer-field/id #uuid "67913577-bdc9-5e12-b26c-777c50a8e9ea" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318107} {:answer-field/choices [{:answer/id #uuid "287b3087-a03c-51cf-bdc9-66f4f54eed87" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186318110}] :answer-field/correct {:answer/id #uuid "287b3087-a03c-51cf-bdc9-66f4f54eed87" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186318110} :answer-field/id #uuid "e6ab4b56-2e7a-54d3-8a94-460f157f427b" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318109}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6572ddc0-25ae-52d8-b154-215a4d77456a" :question/math-academy-id "q-282145" :question/problem "Let $a=-6i+3j+2k$ and $b=4i-j+5k.$ Find $a\\times b.$\n\n$a\\times b=$\n\n{{field-1}}$\\,i\\,+\\,$\n{{field-2}}$\\,j\\,-\\,$\n{{field-3}}$\\,k$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ -6 & 3 & 2 \\\\ 4 & -1 & 5\\end{aligned}| \\\\  & =|\\begin{aligned}3 & 2 \\\\ -1 & 5\\end{aligned}|i-|\\begin{aligned}-6 & 2 \\\\ 4 & 5\\end{aligned}|j+|\\begin{aligned}-6 & 3 \\\\ 4 & -1\\end{aligned}|k \\\\  & =(3\\cdot 5-2\\cdot -1)i-(-6\\cdot 5-2\\cdot 4)j+(-6\\cdot -1-3\\cdot 4)k \\\\  & =(15+2)i-(-30-8)j+(6-12)k \\\\  & =17\\,i+38\\,j-6\\,k\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186303489 :knowledge-point/_questions [{:knowledge-point/id #uuid "21cef8c9-92ff-5527-a837-2236a0c1f9eb" :knowledge-point/title "Solving for an Unknown in an Equation Involving the Cross Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d3c239f-a333-5d88-ae92-08380d731a45" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186303491}] :answer-field/correct {:answer/id #uuid "4d3c239f-a333-5d88-ae92-08380d731a45" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186303491} :answer-field/id #uuid "d5e8eaf8-51e0-5844-8acf-f4e6db888966" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186303490} {:answer-field/choices [{:answer/id #uuid "c4dcc068-e785-52f8-bc25-d5e3ae981a4a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186303493}] :answer-field/correct {:answer/id #uuid "c4dcc068-e785-52f8-bc25-d5e3ae981a4a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186303493} :answer-field/id #uuid "330de255-3b94-5b56-9e5a-f8f0c53758db" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186303492}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1dba81c8-6f48-528d-b583-abc4c231bef3" :question/math-academy-id "q-282260" :question/problem "Let $a=⟨2x,3,1⟩,$ $b=⟨-2x,0,4⟩$ and $|\\,a\\times b\\,|=\\sqrt{280}.$ Then, in **ascending order**, the possible values of $x$ are\n\n$\\,x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 2x & 3 & 1 \\\\ -2x & 0 & 4\\end{aligned}| \\\\  & =|\\begin{aligned}3 & 1 \\\\ 0 & 4\\end{aligned}|i-|\\begin{aligned}2x & 1 \\\\ -2x & 4\\end{aligned}|j+|\\begin{aligned}2x & 3 \\\\ -2x & 0\\end{aligned}|k \\\\  & =(12-0)i-(8x+2x)j+(0+6x)k \\\\  & =⟨12,-10x,6x⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{{12}^{2}+(-10x)^{2}+(6x)^{2}} \\\\  & =\\sqrt{144+100{x}^{2}+36{x}^{2}} \\\\  & =\\sqrt{136{x}^{2}+144}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{280} \\\\ \\sqrt{136{x}^{2}+144} & =\\sqrt{280} \\\\ 136{x}^{2}+144 & =280 \\\\ 136{x}^{2} & =136 \\\\ {x}^{2} & =1\\end{aligned}\n$$\n\nTherefore, in ascending order, the solutions are $x=-1,$ $x=1.$"}]}
