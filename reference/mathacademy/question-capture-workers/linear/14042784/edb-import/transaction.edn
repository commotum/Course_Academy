on/math-academy-id "q-19782" :question/problem "Let $a=⟨0,0,3⟩$ and $b=⟨2,0,1⟩.$ Find $a\\times b.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 0 & 0 & 3 \\\\ 2 & 0 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 3 \\\\ 0 & 1\\end{aligned}|i-|\\begin{aligned}0 & 3 \\\\ 2 & 1\\end{aligned}|j+|\\begin{aligned}0 & 0 \\\\ 2 & 0\\end{aligned}|k \\\\  & =((0)(1)-(0)(3))i-((0)(1)-(2)(3))j+((0)(0)-(2)(0))k \\\\  & =(0-0)i-(0-6)j+(0-0)k \\\\  & =6j.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-19782/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "733eab11-2a26-5402-8df5-bba50c9beaf9"] :knowledge-point/questions ["q-19782"] :db/ensure [:knowledge-point/validate]} {:db/id "q-19787/selection/9f741ef68ea20a1711774c97278569f29700c53fecaa9dce53e735d286f5e357" :answer/id #uuid "cb8f1154-26f8-5dec-a540-40139ebfea75" :answer/type :answer.type/math :answer/value "8i+12j-7k" :db/ensure [:answer/validate]} {:db/id "q-19787/selection/44ae36d7aca583268637073ac12abeba65e1992e1faa81b11c6b0ace874a1492" :answer/id #uuid "2364ac21-a148-5e19-a10e-bb1059403c36" :answer/type :answer.type/math :answer/value "-14i+18j+6k" :db/ensure [:answer/validate]} {:db/id "q-19787/selection/23bc2e3ec0c2b8dbd89411ac69142cbb497f109a5a79b74c547b80f31bf38103" :answer/id #uuid "f5e29017-b8f5-56f2-90eb-487eba72f3c4" :answer/type :answer.type/math :answer/value "7i+8j-12k" :db/ensure [:answer/validate]} {:db/id "q-19787/selection/e9a70897555af78d98e3b22baba83ca0c83a6ad272717a46944711a31b18779c" :answer/id #uuid "b43c56c1-4951-50b8-8dd0-56af886726c2" :answer/type :answer.type/math :answer/value "-12i+8j-7k" :db/ensure [:answer/validate]} {:db/id "q-19787/selection/4d2aa8fc4afc838532f673534e2847845b74d43a48a713415e745338a4f8da0a" :answer/id #uuid "5fc6bf75-00ba-5c1c-87e1-e6a626c63c3f" :answer/type :answer.type/math :answer/value "8i+12j-17k" :db/ensure [:answer/validate]} {:db/id "q-19787/selection" :answer-field/id #uuid "4e600a78-555f-5580-ae1e-3ef782908f55" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-19787/selection/e9a70897555af78d98e3b22baba83ca0c83a6ad272717a46944711a31b18779c" :answer-field/choices ["q-19787/selection/9f741ef68ea20a1711774c97278569f29700c53fecaa9dce53e735d286f5e357" "q-19787/selection/44ae36d7aca583268637073ac12abeba65e1992e1faa81b11c6b0ace874a1492" "q-19787/selection/23bc2e3ec0c2b8dbd89411ac69142cbb497f109a5a79b74c547b80f31bf38103" "q-19787/selection/e9a70897555af78d98e3b22baba83ca0c83a6ad272717a46944711a31b18779c" "q-19787/selection/4d2aa8fc4afc838532f673534e2847845b74d43a48a713415e745338a4f8da0a"] :db/ensure [:answer-field/validate]} {:db/id "q-19787" :question/id #uuid "db59fadf-020c-5124-bcf7-f6360dfa1802" :question/math-academy-id "q-19787" :question/problem "Let $a=⟨1,5,4⟩$ and $b=⟨2,3,0⟩.$ Find $a\\times b.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 1 & 5 & 4 \\\\ 2 & 3 & 0\\end{aligned}| \\\\  & =|\\begin{aligned}5 & 4 \\\\ 3 & 0\\end{aligned}|i-|\\begin{aligned}1 & 4 \\\\ 2 & 0\\end{aligned}|j+|\\begin{aligned}1 & 5 \\\\ 2 & 3\\end{aligned}|k \\\\  & =((5)(0)-(3)(4))i-((1)(0)-(2)(4))j+((1)(3)-(2)(5))k \\\\  & =(0-12)i-(0-8)j+(3-10)k \\\\  & =-12i+8j-7k.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-19787/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "733eab11-2a26-5402-8df5-bba50c9beaf9"] :knowledge-point/questions ["q-19787"] :db/ensure [:knowledge-point/validate]} {:db/id "q-282145/field-1/ac46d580a95a8fc03d1a7cb07de70e107b73fba6bf1bc1d13103b84eff3df012" :answer/id #uuid "782ad791-7780-514b-9c8a-49517256f889" :answer/type :answer.type/math :answer/value "17" :db/ensure [:answer/validate]} {:db/id "q-282145/field-1/66dedd51c696580d351ab6a45c1c63cb49