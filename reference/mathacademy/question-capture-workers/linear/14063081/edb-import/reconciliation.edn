 & 0 \\\\ 3 & 2 & 1\\end{aligned}],\\,b=[\\begin{aligned}3 \\\\ -1 \\\\ 4\\end{aligned}].\n$$\n\nIf $A=LU$ is the LU factorization of some $3\\times 3$ matrix $A,$ find the vector $y$ such that\n\n$$\n{\\begin{aligned}Ly=b \\\\ Ux=y\\end{aligned}\n$$\n\nis equivalent to $Ax=b.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-32671" "field" nil "attribute" "question/worked-solution" "value" "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,{\\begin{aligned}Ly=b \\\\ Ux=y.\\end{aligned}\n$$\n\nWe now solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n[\\begin{aligned}1 & 0 & 0 \\\\ -4 & 1 & 0 \\\\ 3 & 2 & 1\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2} \\\\ {y}_{3}\\end{aligned}]=[\\begin{aligned}3 \\\\ -1 \\\\ 4\\end{aligned}].\n$$\n\nThis gives the system of equations\n\n$$\n{\\begin{aligned}{y}_{1}=3 \\\\ -4{y}_{1}+{y}_{2}=-1 \\\\ 3{y}_{1}+2{y}_{2}+{y}_{3}=4.\\end{aligned}\n$$\n\nWe can compute the solution to this system using forward substitution, as follows:\n\n$$\n\\begin{aligned}{y}_{1} & =3, \\\\ {y}_{2} & =-1+4{y}_{1} \\\\  & =-1+4(3) \\\\  & =11, \\\\ {y}_{3} & =4-3{y}_{1}-2{y}_{2} \\\\  & =4-3(3)-2(11) \\\\  & =-27.\\end{aligned}\n$$\n\nTherefore, \n$y=[\\begin{aligned}3 \\\\ 11 \\\\ -27\\end{aligned}].$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-32671" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/activity-metadata.json" "file_sha256" "0a855bb07bf8dede1768bc415331b9700f0c7b9e0347f38a6be52438ac7df5f3"} {"question" "q-32671" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-32671" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "y=[\\begin{aligned}3 \\\\ -11 \\\\ 27\\end{aligned}]"] ["math" "y=[\\begin{aligned}3 \\\\ 0 \\\\ 11\\end{aligned}]"] ["math" "y=[\\begin{aligned}3 \\\\ 1 \\\\ -27\\end{aligned}]"] ["math" "y=[\\begin{aligned}3 \\\\ 11 \\\\ -27\\end{aligned}]"] ["math" "y=[\\begin{aligned}3 \\\\ 11 \\\\ -7\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-32671" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "y=[\\begin{aligned}3 \\\\ 11 \\\\ -27\\end{aligned}]"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-105930" "field" nil "attribute" "question/problem" "value" "Consider the matrix $L$ and the vector $b,$ given by \n\n$$\nL=[\\begin{aligned}1 & 0 & 0 \\\\ 9 & 1 & 0 \\\\ -4 & 1 & 1\\end{aligned}],\\,b=[\\begin{aligned}-2 \\\\ -2 \\\\ 1\\end{aligned}].\n$$\n\nIf $A=LU$ is the LU factorization of some $3\\times 3$ matrix $A,$ find the vector $y$ such that\n\n$$\n{\\begin{aligned}Ly=b \\\\ Ux=y\\end{aligned}\n$$\n\nis equivalent to $Ax=b.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-105930" "field" nil "attribute" "question/worked-solution" "value" "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,{\\begin{aligned}Ly=b \\\\ Ux=y.\\end{aligned}\n$$\n\nWe now solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n[\\begin{aligned}1 & 0 & 0 \\\\ 9 & 1 & 0 \\\\ -4 & 1 & 1\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2} \\\\ {y}_{3}\\end{aligned}]=[\\begin{aligned}-2 \\\\ -2 \\\\ 1\\end{aligned}].\n$$\n\nThis gives the system of equations\n\n$$\n{\\begin{aligned}{y}_{1}=-2 \\\\ 9{y}_{1}+{y}_{2}=-2 \\\\ -4{y}_{1}+{y}_{2}+{y}_{3}=1.\\end{aligned}\n$$\n\nWe can compute the solution to this system using forward substitution, as follows:\n\n$$\n\\begin{aligned}{y}_{1} & =-2, \\\\ {y}_{2} & =-2-9{y}_{1} \\\\  & =-2-9(-2) \\\\  & =16, \\\\ {y}_{3} & =1+4{y}_{1}-{y}_{2} \\\\  & =1+4(-2)-(16) \\\\  & =-23.\\end{aligned}\n$$\n\nTherefore, \n$y=[\\begin{aligned}-2 \\\\ 16 \\\\ -23\\end{aligned}].$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-105930" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/activity-metadata.json" "file_sha256" "0a855bb07bf8dede1768bc415331b9700f0c7b9e0347f38a6be52438ac7df5f3"} {"question" "q-105930" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-105930" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "y=[\\begin{aligned}-2 \\\\ -8 \\\\ -11\\end{aligned}]"] ["math" "y=[\\begin{aligned}-2 \\\\ 16 \\\\ -23\\end{aligned}]"] ["math" "y=[\\begin{aligned}-2 \\\\ 4 \\\\ -3\\end{aligned}]"] ["math" "y=[\\begin{aligned}2 \\\\ -8 \\\\ -3\\end{aligned}]"] ["math" "y=[\\begin{aligned}2 \\\\ 4 \\\\ -11\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-105930" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "y=[\\begin{aligned}-2 \\\\ 16 \\\\ -23\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-105951" "field" nil "attribute" "question/problem" "value" "Consider the LU decomposition of the matrix $A$ and the vector $b,$ given by\n\n$$\nA={{[\\begin{aligned}1 & 0 \\\\ 4 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}2 & -1 \\\\ 0 & 4\\end{aligned}]}_{⏟}}_{U},\\,b=[\\begin{aligned}6 \\\\ 20\\end{aligned}].\n$$\n\nIf $⟨{x}_{1},{x}_{2}⟩$ and $⟨{y}_{1},{y}_{2}⟩$ are the solutions to the systems $Ax=b$ and $Ly=b$ respectively, what is the value of ${x}_{2}\\cdot {y}_{2}?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-105951" "field" nil "attribute" "question/worked-solution" "value" "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,{\\begin{aligned}Ly=b \\\\ Ux=y.\\end{aligned}\n$$\n\nNow, we solve the two systems in turn.\n\n- First, we solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n[\\begin{aligned}1 & 0 \\\\ 4 & 1\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]=b=[\\begin{aligned}6 \\\\ 20\\end{aligned}].\n$$\n\nThis gives the system of equations\n\n$$\n{\\begin{aligned}{y}_{1}=6 \\\\ 4{y}_{1}+{y}_{2}=20.\\end{aligned}\n$$\n\nThe solution to this system is ${y}_{1}=6$ and ${y}_{2}=-4.$ Therefore, \n\n$$\ny=[\\begin{aligned}6 \\\\ -4\\end{aligned}].\n$$\n\n- Next, we solve $Ux=y.$ Writing this equation in matrix form, we get\n\n$$\n[\\begin{aligned}2 & -1 \\\\ 0 & 4\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=y=[\\begin{aligned}6 \\\\ -4\\end{aligned}].\n$$\n\nThis gives the system of equations\n\n$$\n{\\begin{aligned}2{x}_{1}-{x}_{2}=6 \\\\ 4{x}_{2}=-4.\\end{aligned}\n$$\n\nThe solution to this system is ${x}_{2}=-1$ and ${x}_{1}=\\frac{5}{2}.$ Therefore, \n\n$$\nx=[\\begin{aligned}\\frac{5}{2} \\\\ -1\\end{aligned}].\n$$\n\nFinally, ${x}_{2}\\cdot {y}_{2}=(-1)\\cdot (-4)=4.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-105951" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/activity-metadata.json" "file_sha256" "0a855bb07bf8dede1768bc415331b9700f0c7b9e0347f38a6be52438ac7df5f3"} {"question" "q-105951" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-105951" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-10"] ["math" "-6"] ["math" "15"] ["math" "4"] ["math" "8"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-105951" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "4"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-32570" "field" nil "attribute" "question/problem" "value" "Consider the LU decomposition of the matrix $A$ and the vector $b,$ given by\n\n$$\nA={{[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}-4 & -6 \\\\ 0 & -3\\end{aligned}]}_{⏟}}_{U},\\,b=[\\begin{aligned}-4 \\\\ -6\\end{aligned}].\n$$\n\nIf $⟨{x}_{1},{x}_{2}⟩$ and $⟨{y}_{1},{y}_{2}⟩$ are the solutions to the systems $Ax=b$ and $Ly=b$ respectively, what is the value of ${y}_{1}+3{x}_{2}?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-32570" "field" nil "attribute" "question/worked-solution" "value" "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,{\\begin{aligned}Ly=b \\\\ Ux=y.\\end{aligned}\n$$\n\nNow, we solve the two systems in turn.\n\n- First, we solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]=b=[\\begin{aligned}-4 \\\\ -6\\end{aligned}].\n$$\n\nThis gives the system of equations\n\n$$\n{\\begin{aligned}{y}_{1}=-4 \\\\ 2{y}_{1}+{y}_{2}=-6.\\end{aligned}\n$$\n\nThe solution to this system is ${y}_{1}=-4$ and ${y}_{2}=2.$ Therefore, \n\n$$\ny=[\\begin{aligned}-4 \\\\ 2\\end{aligned}].\n$$\n\n- Next, we solve $Ux=y.$ Writing this equation in matrix form, we get\n\n$$\n[\\begin{aligned}-4 & -6 \\\\ 0 & -3\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=y=[\\begin{aligned}-4 \\\\ 2\\end{aligned}].\n$$\n\nThis gives the system of equations\n\n$$\n{\\begin{aligned}-4{x}_{1}-6{x}_{2}=-4 \\\\ -3{x}_{2}=2.\\end{aligned}\n$$\n\nThe solution to this system is ${x}_{2}=-\\frac{2}{3}$ and ${x}_{1}=2.$ Therefore, \n\n$$\nx=[\\begin{aligned}2 \\\\ -\\frac{2}{3}\\end{aligned}].\n$$\n\nFinally, ${y}_{1}+3{x}_{2}=-4+3(-\\frac{2}{3})=-6.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-32570" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/activity-metadata.json" "file_sha256" "0a855bb07bf8dede1768bc415331b9700f0c7b9e0347f38a6be52438ac7df5f3"} {"question" "q-32570" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-32570" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-3"] ["math" "-6"] ["math" "0"] ["math" "4"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-32570" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-6"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-104861" "field" nil "attribute" "question/problem" "value" "Consider the LU decomposition of the matrix $A$ and the vector $b,$ given by\n\n$$\nA={{[\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}]}_{⏟}}_{L}\\cdot {{[\\begin{aligned}2 & 1 \\\\ 0 & 1\\end{aligned}]}_{⏟}}_{U},\\,b=[\\begin{aligned}1 \\\\ 2\\end{aligned}].\n$$\n\nIf $⟨{x}_{1},{x}_{2}⟩$ and $⟨{y}_{1},{y}_{2}⟩$ are the solutions of the systems $Ax=b$ and $Ly=b$ respectively, what is the value of the product ${x}_{1}\\cdot {y}_{2}?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-104861" "field" nil "attribute" "question/worked-solution" "value" "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,{\\begin{aligned}Ly=b \\\\ Ux=y.\\end{aligned}\n$$\n\nNow, we solve the two systems in turn.\n\n- First, we solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n[\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]=b=[\\begin{aligned}1 \\\\ 2\\end{aligned}].\n$$\n\nThis gives the system of equations\n\n$$\n{\\begin{aligned}{y}_{1}=1 \\\\ -2{y}_{1}+{y}_{2}=2.\\end{aligned}\n$$\n\nThe solution to this system is ${y}_{1}=1$ and ${y}_{2}=4.$ Therefore, \n\n$$\ny=[\\begin{aligned}1 \\\\ 4\\end{aligned}].\n$$\n\n- Next, we solve $Ux=y.$ Writing this equation in matrix form, we get\n\n$$\n[\\begin{aligned}2 & 1 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=y=[\\begin{aligned}1 \\\\ 4\\end{aligned}].\n$$\n\nThis gives the system of equations\n\n$$\n{\\begin{aligned}2{x}_{1}+{x}_{2}=1 \\\\ {x}_{2}=4.\\end{aligned}\n$$\n\nThe solution to this system is ${x}_{2}=4$ and ${x}_{1}=-\\frac{3}{2}.$ Therefore, \n\n$$\nx=[\\begin{aligned}-\\frac{3}{2} \\\\ 4\\end{aligned}].\n$$\n\nFinally, ${x}_{1}\\cdot {y}_{2}=-\\frac{3}{2}\\cdot 4=-6.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-104861" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/activity-metadata.json" "file_sha256" "0a855bb07bf8dede1768bc415331b9700f0c7b9e0347f38a6be52438ac7df5f3"} {"question" "q-104861" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-104861" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-3"] ["math" "-6"] ["math" "-\\frac{3}{2}"] ["math" "16"] ["math" "4"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-104861" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-6"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-105953" "field" nil "attribute" "question/problem" "value" "Consider the LU decomposition of the matrix $A$ and the vector $b,$ given by\n\n$$\nA={{[\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}7 & 3 \\\\ 0 & -2\\end{aligned}]}_{⏟}}_{U},\\,b=[\\begin{aligned}5 \\\\ 4\\end{aligned}].\n$$\n\nIf $⟨{x}_{1},{x}_{2}⟩$ and $⟨{y}_{1},{y}_{2}⟩$ are the solutions to the systems $Ax=b$ and $Ly=b$ respectively, what is the value of ${x}_{1}\\cdot {y}_{2}?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-105953" "field" nil "attribute" "question/worked-solution" "value" "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,{\\begin{aligned}Ly=b \\\\ Ux=y.\\end{aligned}\n$$\n\nNow, we solve the two systems in turn.\n\n- First, we solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n[\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]=b=[\\begin{aligned}5 \\\\ 4\\end{aligned}].\n$$\n\nThis gives the system of equations\n\n$$\n{\\begin{aligned}{y}_{1}=5 \\\\ -2{y}_{1}+{y}_{2}=4.\\end{aligned}\n$$\n\nThe solution to this system is ${y}_{1}=5$ and ${y}_{2}=14.$ Therefore, \n\n$$\ny=[\\begin{aligned}5 \\\\ 14\\end{aligned}].\n$$\n\n- Next, we solve $Ux=y.$ Writing this equation in matrix form, we get\n\n$$\n[\\begin{aligned}7 & 3 \\\\ 0 & -2\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=y=[\\begin{aligned}5 \\\\ 14\\end{aligned}].\n$$\n\nThis gives the system of equations\n\n$$\n{\\begin{aligned}7{x}_{1}+3{x}_{2}=5 \\\\ -2{x}_{2}=14.\\end{aligned}\n$$\n\nThe solution to this system is ${x}_{2}=-7$ and ${x}_{1}=\\frac{26}{7}.$ Therefore, \n\n$$\nx=[\\begin{aligned}\\frac{26}{7} \\\\ -7\\end{aligned}].\n$$\n\nFinally, ${x}_{1}\\cdot {y}_{2}=\\frac{26}{7}\\cdot 14=52.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-105953" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/activity-metadata.json" "file_sha256" "0a855bb07bf8dede1768bc415331b9700f0c7b9e0347f38a6be52438ac7df5f3"} {"question" "q-105953" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-105953" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "35"] ["math" "50"] ["math" "52"] ["math" "\\frac{130}{7}"] ["math" "\\frac{23}{7}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-105953" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "52"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-105949" "field" nil "attribute" "question/problem" "value" "Consider the LU decomposition of the matrix $A$ and the vector $b,$ given by\n\n$$\nA={{[\\begin{aligned}1 & 0 \\\\ -1 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}-3 & -2 \\\\ 0 & 1\\end{aligned}]}_{⏟}}_{U},\\,b=[\\begin{aligned}-1 \\\\ 3\\end{aligned}].\n$$\n\nIf $⟨{x}_{1},{x}_{2}⟩$ and $⟨{y}_{1},{y}_{2}⟩$ are the solutions to the systems $Ax=b$ and $Ly=b$ respectively, what is the value of ${x}_{1}\\cdot {y}_{1}?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-105949" "field" nil "attribute" "question/worked-solution" "value" "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,{\\begin{aligned}Ly=b \\\\ Ux=y.\\end{aligned}\n$$\n\nNow, we solve the two systems in turn.\n\n- First, we solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n[\\begin{aligned}1 & 0 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]=b=[\\begin{aligned}-1 \\\\ 3\\end{aligned}].\n$$\n\nThis gives the system of equations\n\n$$\n{\\begin{aligned}{y}_{1}=-1 \\\\ -{y}_{1}+{y}_{2}=3.\\end{aligned}\n$$\n\nThe solution to this system is ${y}_{1}=-1$ and ${y}_{2}=2.$ Therefore, \n\n$$\ny=[\\begin{aligned}-1 \\\\ 2\\end{aligned}].\n$$\n\n- Next, we solve $Ux=y.$ Writing this equation in matrix form, we get\n\n$$\n[\\begin{aligned}-3 & -2 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=y=[\\begin{aligned}-1 \\\\ 2\\end{aligned}].\n$$\n\nThis gives the system of equations\n\n$$\n{\\begin{aligned}-3{x}_{1}-2{x}_{2}=-1 \\\\ {x}_{2}=2.\\end{aligned}\n$$\n\nThe solution to this system is ${x}_{2}=2$ and ${x}_{1}=-1.$ Therefore, \n\n$$\nx=[\\begin{aligned}-1 \\\\ 2\\end{aligned}].\n$$\n\nFinally, ${x}_{1}\\cdot {y}_{1}=(-1)\\cdot (-1)=1.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-105949" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/activity-metadata.json" "file_sha256" "0a855bb07bf8dede1768bc415331b9700f0c7b9e0347f38a6be52438ac7df5f3"} {"question" "q-105949" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-105949" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-2"] ["math" "1"] ["math" "2"] ["math" "4"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "q-105949" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "1"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/state.json" "file_sha256" "385e6f069156dc0f6f898e7f6f18862954ab6b167731863a03f1cd8b297536db"} {"question" "e-8926" "field" nil "attribute" "question/problem" "value" "Consider the matrix $L$ and the vector $\\mathbf b,$ given by \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/assets/fd1cf7c3d929fb79576a59d4ef3aebd3f24a0d570c938ab80ebd44c5bd4c238f.png)\n\nIf $A=LU$ is the LU factorization of some $2\\times 2$ matrix $A,$ find the vector $\\mathbf{y}$ such that \n\n$$\n{\\begin{aligned}Ly=b \\\\ Ux=y\\end{aligned}\n$$\n\nis equivalent to $A\\mathbf{x}=\\mathbf{b}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/example-8926.json" "file_sha256" "c7a8a1ddb5ec9b0500bf6c943c86a2826770095a99f2b7ecc07061fe705abc4a"} {"question" "e-8926" "field" nil "attribute" "question/worked-solution" "value" "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $U\\mathbf{x}=\\mathbf{y},$ we obtain\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/assets/b521c0b31d05de273d0abd37e00b046c0e36ed47ef30d22784a24cace4d676f9.png)\n\nWe now solve $L\\mathbf{y} = \\mathbf{b}.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}1 & 0 \\\\ 15 & 1\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}] & =[\\begin{aligned}5 \\\\ 66\\end{aligned}].\\end{aligned}\n$$\n\nThis gives the system of equations\n\n$$\n{\\begin{aligned}{y}_{1}=5 \\\\ 15{y}_{1}+{y}_{2}=66.\\end{aligned}\n$$\n\nThe solution to this system is $y_1=5$ and $y_2=-9.$ \n\nTherefore, ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/assets/ccb4ab47d3a270cf9545d4f79e6f90b944cf6121fca3752eeee6ddc712fcfdec.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/example-8926.json" "file_sha256" "c7a8a1ddb5ec9b0500bf6c943c86a2826770095a99f2b7ecc07061fe705abc4a"} {"question" "e-4777" "field" nil "attribute" "question/problem" "value" "Consider the matrix $L$ and the vector $\\mathbf b,$ given by \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/assets/f88cbbb9459dd3b467e6b87d230ad23634461597aa9d8da3e933774273e2ab2f.png)\nIf $A=LU$ is the LU factorization of some $3\\times 3$ matrix $A,$ find the vector $\\mathbf{y}$ such that\n\n$$\n{\\begin{aligned}Ly=b \\\\ Ux=y\\end{aligned}\n$$\n\nis equivalent to $A\\mathbf{x}=\\mathbf{b}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/example-4777.json" "file_sha256" "83aadf451b6e8f4ed42525229cba5924c8345f182cc4f352753bd7f91f7f991c"} {"question" "e-4777" "field" nil "attribute" "question/worked-solution" "value" "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $U\\mathbf{x}=\\mathbf{y},$ we obtain\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/assets/7704f9285f14f496bb9f1721d188866c9464c585e33235c5cc6eee42e3f3a3eb.png)\n\nWe now solve $L\\mathbf{y} = \\mathbf{b}.$ Writing this equation in matrix form, we get\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/assets/712643d674cf8a7a086a9a935659d86bba7bd2fb25f131ec56e798cfc1d538d9.png)\n\nThis gives the system of equations\n\n$$\n{\\begin{aligned}{y}_{1}=2 \\\\ {y}_{1}+{y}_{2}=4 \\\\ {y}_{1}-2{y}_{2}+{y}_{3}=1.\\end{aligned}\n$$\n\nWe can compute the solution to this system using forward substitution, as follows:\n\n$$\n\\begin{aligned}{y}_{1} & =2, \\\\ {y}_{2} & =4-{y}_{1} \\\\  & =4-(2) \\\\  & =2, \\\\ {y}_{3} & =1-{y}_{1}+2{y}_{2} \\\\  & =1-(2)+2(2) \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/assets/151dc664a131df0f3e13f2997bb1af6d41586b5f4dcf8a1acd1342f85e1b9c92.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/example-4777.json" "file_sha256" "83aadf451b6e8f4ed42525229cba5924c8345f182cc4f352753bd7f91f7f991c"} {"question" "e-4775" "field" nil "attribute" "question/problem" "value" "Consider the LU decomposition of the matrix $A$ and the vector $\\mathbf{b},$ given by\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/assets/45cefb7311cd5253b76164cc7f2f3ce01b445f0e9061b720865227128b60debe.png)\nIf $\\langle x_1,x_2 \\rangle$ and $\\langle y_1,y_2 \\rangle$ are the solutions to the systems $A\\mathbf{x}=\\mathbf{b}$ and $L\\mathbf{y}=\\mathbf{b}$ respectively, what is the value of $x_1 \\cdot y_2?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/example-4775.json" "file_sha256" "afa6f87382a7d83f63f9f709a85687b9afd956e7a69cc03d6daf1018ee8a7eef"} {"question" "e-4775" "field" nil "attribute" "question/worked-solution" "value" "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $U\\mathbf{x}=\\mathbf{y},$ we obtain\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/assets/b521c0b31d05de273d0abd37e00b046c0e36ed47ef30d22784a24cace4d676f9.png)\n\nNow, we solve the two systems in turn.\n\n- First, we solve $L\\mathbf{y} = \\mathbf{b}.$ Writing this equation in matrix form, we get\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/assets/9dcc9f71745cce72ce7e122b3bc8cd7064d05f3be90d712202f42956956ef18e.png)\nThis gives the system of equations\n\n$$\n{\\begin{aligned}{y}_{1}=6 \\\\ -2{y}_{1}+{y}_{2}=-8.\\end{aligned}\n$$\n\nThe solution to this system is $y_1=6$ and $y_2=4.$ Therefore, \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/assets/903fbfe6828526dace264d65baebf58c31e36db8a54e25ed1f3be859e6079ebb.png)\n\n- Next, we solve $U\\mathbf{x}=\\mathbf{y}.$ Writing this equation in matrix form, we get\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/assets/dcb234ae13cab2676ea5afa7fde452c870ff5088ff5748342c517bf2a96327a8.png)\nThis gives the system of equations\n\n$$\n{\\begin{aligned}7{x}_{1}+4{x}_{2}=6 \\\\ -2{x}_{2}=4.\\end{aligned}\n$$\n\nThe solution to this system is $x_2=-2$ and $x_1=2.$ Therefore, \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/assets/53bace542ba4dfd0d7e5e4bf9b6451c7f39502dd1bf24d030f654050629f0e0d.png)\n\nFinally, $x_1 \\cdot y_2 = 2 \\cdot 4 = 8.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14063081/example-4775.json" "file_sha256" "afa6f87382a7d83f63f9f709a85687b9afd956e7a69cc03d6daf1018ee8a7eef"}] "usage" {"e-8926" [] "e-4777" [] "q-105949" [] "e-4775" []} "basis" 2024 "retractions" [[17592186120005 :question/problem "Consider the LU decomposition of the matrix $A$ and the vector $b$, given by\n\n$A = \\begin{bmatrix}1 & 0 \\\\ -1 & 1\\end{bmatrix}_(⏟)_(L)\\begin{bmatrix}-3 & -2 \\\\ 0 & 1\\end{bmatrix}_(⏟)_(U), b = \\begin{bmatrix}-1 \\\\ 3\\end{bmatrix}$.\nIf $⟨x_{1}, x_{2}⟩$ and $⟨y_{1}, y_{2}⟩$ are the solutions to the systems $Ax = b$ and $Ly = b$ respectively, what is the value of $x_{1} \\cdot y_{1}$?"] [17592186119630 :question/problem "Consider the matrix $L$ and the vector $\\mathbf b$, given by\n\n$\\begin{bmatrix}1 & 0 \\\\ 15 & 1\\end{bmatrix}$\n\nIf $A=LU$ is the LU factorization of some $2\\times 2$ matrix $A$, find the vector $\\mathbf{y}$ such that\n\n${Ly = b; Ux = y$\nis equivalent to $A\\mathbf{x}=\\mathbf{b}$."] [17592186119630 :question/worked-solution "First, notice that since $A=LU$, we can write\n\n$$\nAx = b⟹(LU)_(⏟)_(A)x = b\n$$\n\nNow, setting\n\n$$\nU\\mathbf{x}=\\mathbf{y}\n$$\n\nwe obtain\n\n$$\n{Ly = b; Ux = y\n$$\n\nWe now solve\n\n$$\nL\\mathbf{y} = \\mathbf{b}\n$$\n\nWriting this equation in matrix form, we get\n\n$$\n\\begin{aligned}\n\\begin{bmatrix}1 & 0 \\\\ 15 & 1\\end{bmatrix}\\begin{bmatrix}y_{1} \\\\ y_{2}\\end{bmatrix} &= \\begin{bmatrix}5 \\\\ 66\\end{bmatrix}\n\\end{aligned}\n$$\n\nThis gives the system of equations\n\n$$\n{y_{1} = 5; 15y_{1} + y_{2} = 66\n$$\n\nThe solution to this system is $y_1=5$ and $y_2=-9$.\n\nTherefore, $\\begin{bmatrix}5 \\\\ -9\\end{bmatrix}$"] [17592186119538 :question/problem "Consider the matrix $L$ and the vector $\\mathbf b$, given by\n$\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 1 & -2 & 1\\end{bmatrix}$\nIf $A=LU$ is the LU factorization of some $3\\times 3$ matrix $A$, find the vector $\\mathbf{y}$ such that\n\n${Ly = b; Ux = y$\n\nis equivalent to $A\\mathbf{x}=\\mathbf{b}$."] [17592186119538 :question/worked-solution "First, notice that since $A=LU$, we can write\n\n$$\nAx = b⟹(LU)_(⏟)_(A)x = b\n$$\n\nNow, setting\n\n$$\nU\\mathbf{x}=\\mathbf{y}\n$$\n\nwe obtain\n\n$$\n{Ly = b; Ux = y\n$$\n\nWe now solve\n\n$$\nL\\mathbf{y} = \\mathbf{b}\n$$\n\nWriting this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 1 & -2 & 1\\end{bmatrix}\n$$\n\nThis gives the system of equations\n\n$$\n{y_{1} = 2; y_{1} + y_{2} = 4; y_{1} - 2y_{2} + y_{3} = 1\n$$\n\nWe can compute the solution to this system using forward substitution, as follows:\n\n$$\n\\begin{aligned}\ny_{1} &= 2, \\\\\ny_{2} &= 4 - y_{1} \\\\\n&= 4 - (2) \\\\\n&= 2, \\\\\ny_{3} &= 1 - y_{1} + 2y_{2} \\\\\n&= 1 - (2) + 2(2) \\\\\n&= 3\n\\end{aligned}\n$$\n\nTherefore,\n$\\begin{bmatrix}2 \\\\ 2 \\\\ 3\\end{bmatrix}$"] [17592186119537 :question/problem "Consider the LU decomposition of the matrix $A$ and the vector $\\mathbf{b}$, given by\n$\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix}$\nIf $\\langle x_1,x_2 \\rangle$ and $\\langle y_1,y_2 \\rangle$ are the solutions to the systems $A\\mathbf{x}=\\mathbf{b}$ and $L\\mathbf{y}=\\mathbf{b}$ respectively, what is the value of $x_1 \\cdot y_2$?"] [17592186119537 :question/worked-solution "First, notice that since $A=LU$, we can write\n\n$$\nAx = b⟹(LU)_(⏟)_(A)x = b\n$$\n\nNow, setting\n\n$$\nU\\mathbf{x}=\\mathbf{y}\n$$\n\nwe obtain\n\n$$\n{Ly = b; Ux = y\n$$\n\nNow, we solve the two systems in turn.\n\n- First, we solve $L\\mathbf{y} = \\mathbf{b}$. Writing this equation in matrix form, we get\n$\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix}$\nThis gives the system of equations\n${y_{1} = 6; - 2y_{1} + y_{2} =-8$.\nThe solution to this system is $y_1=6$ and $y_2=4$. Therefore,\n$\\begin{bmatrix}6 \\\\ 4\\end{bmatrix}$\n- Next, we solve $U\\mathbf{x}=\\mathbf{y}$. Writing this equation in matrix form, we get\n$\\begin{bmatrix}7 & 4 \\\\ 0 & -2\\end{bmatrix}$\nThis gives the system of equations\n${7x_{1} + 4x_{2} = 6; - 2x_{2} = 4$.\nThe solution to this system is $x_2=-2$ and $x_1=2$. Therefore,\n$\\begin{bmatrix}2 \\\\ -2\\end{bmatrix}$\n\nFinally,\n\n$$\nx_1 \\cdot y_2 = 2 \\cdot 4 = 8\n$$"]] "immutable_answers" [17592186116596 17592186116597 17592186116598 17592186116599 17592186116600] "immutable_fields" [[17592186116595 :answer-field/correct] [17592186116595 :answer-field/id] [17592186116595 :answer-field/key] [17592186116595 :answer-field/type]] "no_history" []}
