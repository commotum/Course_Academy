nd{aligned}] & =[\\begin{aligned}7 \\\\ -36\\end{aligned}].\\end{aligned}\n$$\n\nThis gives the system of equations\n\n$$\n{\\begin{aligned}{y}_{1}=7 \\\\ -10{y}_{1}+{y}_{2}=-36.\\end{aligned}\n$$\n\nThe solution to this system is ${y}_{1}=7$ and ${y}_{2}=34.$ \n\nTherefore, $y=[\\begin{aligned}7 \\\\ 34\\end{aligned}].$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-105760/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5250e0e1-4909-5075-8a8e-aa2f1be0bd9a"] :knowledge-point/questions ["q-105760"] :db/ensure [:knowledge-point/validate]} {:db/id "q-107171/selection/b54ebb3810f7868ae83ad9b8285a9d28b8dc64f7c3ffefbb3325fa7f0ba74513" :answer/id #uuid "4bc7a3fe-8196-5149-a0ea-393c121fe26c" :answer/type :answer.type/math :answer/value "y=[\\begin{aligned}5 \\\\ -7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-107171/selection/fa3412c57d7c4b6a26dfae454f136dff63c0a04202fb25bb7be54b6a6e7c515e" :answer/id #uuid "3e618217-99a7-5e24-99a3-bef253644ef1" :answer/type :answer.type/math :answer/value "y=[\\begin{aligned}5 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-107171/selection/cbdfd32387fea31eaea43f427839039681298e45e4f9620e9c339536110fc8f4" :answer/id #uuid "1fce18c8-f6b8-55c6-be89-37fe8737c3b5" :answer/type :answer.type/math :answer/value "y=[\\begin{aligned}1 \\\\ -7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-107171/selection/51ec4f11ba7eb99bdb24d7f339394bff64f09c4c5333e05bb1bc96bae6d4d166" :answer/id #uuid "590f790c-2c2a-5065-8521-c2c1ce0784d4" :answer/type :answer.type/math :answer/value "y=[\\begin{aligned}5 \\\\ 33\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-107171/selection/b143e350d3d8c07a8c4259db34d1bac2800788ddbff3cea9917582e98f40df91" :answer/id #uuid "8a3b7272-a8c5-58f2-93f5-f04c95af1660" :answer/type :answer.type/math :answer/value "y=[\\begin{aligned}1 \\\\ 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-107171/selection" :answer