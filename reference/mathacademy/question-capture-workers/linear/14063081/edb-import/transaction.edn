tion/083e69d507b827766b24dfbb08c8a4fadc5aa21c506b0c0c73350039b1258fae"] :db/ensure [:answer-field/validate]} {:db/id "q-32647" :question/id #uuid "338b1c4a-b1f5-53a7-9d9d-a5d1100b37c4" :question/math-academy-id "q-32647" :question/problem "Consider the matrix $L$ and the vector $b,$ given by \n\n$$\nL=[\\begin{aligned}1 & 0 \\\\ -4 & 1\\end{aligned}],\\,b=[\\begin{aligned}2 \\\\ -2\\end{aligned}].\n$$\n\nIf $A=LU$ is the LU factorization of some $2\\times 2$ matrix $A,$ find the vector $y$ such that \n\n$$\n{\\begin{aligned}Ly=b \\\\ Ux=y\\end{aligned}\n$$\n\nis equivalent to $Ax=b.$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,{\\begin{aligned}Ly=b \\\\ Ux=y.\\end{aligned}\n$$\n\nWe now solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}1 & 0 \\\\ -4 & 1\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}] & =[\\begin{aligned}2 \\\\ -2\\end{aligned}].\\end{aligned}\n$$\n\nThis gives the system of equations\n\n$$\n{\\begin{aligned}{y}_{1}=2 \\\\ -4{y}_{1}+{y}_{2}=-2.\\end{aligned}\n$$\n\nThe solution to this system is ${y}_{1}=2$ and ${y}_{2}=6.$ \n\nTherefore, $y=[\\begin{aligned}2 \\\\ 6\\end{aligned}].$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-32647/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5250e0e1-4909-5075-8a8e-aa2f1be0bd9a"] :knowledge-point/questions ["q-32647"] :db/ensure [:knowledge-point/validate]} {:db/id "q-107172/selection/4c2cd81bc0245dc958678b9218f59600cfda7d851eb145ad67f68cdfd5317de8" :answer/id #uuid "bf71b510-4ac3-53b8-9901-250c61e149ac" :answer/type :answer.type/math :answer/value "y=[\\begin{aligned}1 \\\\ 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-107172/selection/219b6f1be340b2394081083f0eb572b7cff82c562e3218dbae325532a179e56f" :answer/id #uuid "271469cd-1d30-58f7-a825-dbb12578bf77" :answer/type :answer.type/math :answer/value "y=[\\begin{aligned}0 \\\\ -6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-107172/selection/abf68b1368e11dd5e3bf1fd7dbfc69a875efd8df8988c099d1be1bd95dce28ae" :answer/id #uuid "2fadf827-734c-5872-88c6-3ad921566526" :answer/type :answer.type/math :answer/value "y=[\\begin{aligned}0 \\\\ 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-107172/selection/ae76dd813efe225c95efcae0d98bb558dbeadcd60c1ba7f4137fb1dba3d60216" :answer/id #uuid "e5d2debb-25e3-52f3-ae2e-069d9ea65c8d" :answer/type :answer.type/math :answer/value "y=[\\begin{aligned}1 \\\\ 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-107172/selection/f087621488c9e8f949a8bd772d3f42213df323882a45522395d4ce43e9f1cab3" :answer/id #uuid "d9ad9ba9-425a-563b-af47-47532c73c582" :answer/type :answer.type/math :answer/value "y=[\\begin{aligned}1 \\\\ -6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-107172/selection" :answer-field/id #uuid "f983b39e-12e6-5c41-a0db-99e5bfff64cc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-107172/selection/abf68b1368e11dd5e3bf1fd7dbfc69a875efd8df8988c099d1be1bd95dce28ae" :answer-field/choices ["q-107172/selection/4c2cd81bc0245dc958678b9218f59600cfda7d851eb145ad67f68cdfd5317de8" "q-107172/selection/219b6f1be340b2394081083f0eb572b7cff82c562e3218dbae325532a179e56f" "q-107172/selection/abf68b1368e11dd5e3bf1fd7dbfc69a875efd8df8988c099d1be1bd95dce28ae" "q-107172/selection/ae76dd813efe225c95efcae0d98bb558dbeadcd60c1ba7f4137fb1dba3d60216" "q-107172/selection/f087621488c9e8f949a8bd772d3f42213df323882a45522395d4ce43e9f1cab3"] :db/ensure [:answer-field/validate]} {:db/id "q-107172" :question/id #uuid "ed3602c3-c2aa-5ab4-82c9-5f20305df86b" :question/math-academy-id "q-107172" :question/problem "Consider the matrix $L$ and the vector $b,$ given by \n\n$$\nL=[\\begin{aligned}1 & 0 \\\\ -6 & 1\\end{aligned}],\\,b=[\\begin{aligned}0 \\\\ 4\\end{aligned}].\n$$\n\nIf $A=LU$ is the LU factorization of some $2\\times 2$ matrix $A,$ find the vector $y$ such that \n\n$$\n{\\begin{aligned}Ly=b \\\\ Ux=y\\end{aligned}\n$$\n\nis equivalent to $Ax=b.$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,{\\begin{aligned}Ly=b \\\\ Ux=y.\\end{aligned}\n$$\n\nWe now solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}1 & 0 \\\\ -6 & 1\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}] & =[\\begin{aligned}0 \\\\ 4\\end{aligned}].\\end{aligned}\n$$\n\nThis gives the system of equations\n\n$$\n{\\begin{aligned}{y}_{1}=0 \\\\ -6{y}_{1}+{y}_{2}=4.\\end{aligned}\n$$\n\nThe solution to this system is ${y}_{1}=0$ and ${y}_{2}=4.$ \n\nTherefore, $y=[\\begin{aligned}0 \\\\ 4\\end{aligned}].$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-107172/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5250e0e1-4909-5075-8a8e-aa2f1be0bd9a"] :knowledge-point/questions ["q-107172"] :db/ensure [:knowledge-point/validate]} {:db/id "q-105755/selection/c4d2e07c53713b74ca932edf8246f54c18297bd5dbca34b1345df36c6bd6dad6" :answer/id #uuid "3e4ddcc9-2dd0-5b3e-a2ed-a03e03591bcd" :answer/type :answer.type/math :answer/value "y=[\\begin{aligned}-2 \\\\ -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-105755/selection/35a2aa6455a45033fd3a86f8c38e83312be1e5de9b98ab04040669fd1b0d4f10" :answer/id #uuid "8b4c3882-1627-5504-b957-3c822235e005" :answer/type :answer.type/math :answer/value "y=[\\begin{aligned}2 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-105755/selection/2a0de99c019eb707505ab20185df6d238cdb9108d7eac37e2c0d3d7d45123889" :answer/id #uuid "566bdfde-c0a4-5796-be5e-7cd5e50579a3" :answer/type :answer.