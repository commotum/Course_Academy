lds ["q-105928/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9fa9fbb8-b2bc-5c93-bb07-bc8c7ef7c115"] :knowledge-point/questions ["q-105928"] :db/ensure [:knowledge-point/validate]} {:db/id "q-105934/selection/b91582d3c259e0ee00dd4ebf48ea470ae8b87b30dad196abbfe434fa94deacb9" :answer/id #uuid "ce8f2d82-5fdb-5363-a67e-a93400ee221f" :answer/type :answer.type/math :answer/value "y=[\\begin{aligned}9 \\\\ -63 \\\\ 81\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-105934/selection/8e48a788a92da45b2076f788a4be868379df8568ee64a23c32d4748051bc9acc" :answer/id #uuid "9e1f34c6-2812-509c-8066-a24b14f002c3" :answer/type :answer.type/math :answer/value "y=[\\begin{aligned}-9 \\\\ 70 \\\\ 80\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-105934/selection/96e6a2bf6cc9b3e362b249ecb1cb5fb0cd965d3d85449ddf0a4473142d82d009" :answer/id #uuid "07d108f8-d626-582c-8c9a-e882553f00db" :answer/type :answer.type/math :answer/value "y=[\\begin{aligned}9 \\\\ -56 \\\\ 80\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-105934/selection/3e35ab164c78ab080bfbbab696a5b4f69c8b9de54d570943b81ac79eb7d4b13f" :answer/id #uuid "d7f0b926-5f55-5455-9a5b-f2214b4ab48f" :answer/type :answer.type/math :answer/value "y=[\\begin{aligned}9 \\\\ -70 \\\\ 80\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-105934/selection/c828f29d268fd6eb4324b854192a840b0a6fa1ebb0104556a0e7df74bbd26a5c" :answer/id #uuid "c5625959-4513-57a3-a02b-bce0f878c626" :answer/type :answer.type/math :answer/value "y=[\\begin{aligned}-9 \\\\ 56 \\\\ -80\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-105934/selection" :answer-field/id #uuid "f6f6146d-2a6a-5ef3-88d9-37de88387dff" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-105934/selection/96e6a2bf6cc9b3e362b249ecb1cb5fb0cd965d3d85449ddf0a4473142d82d009" :answer-field/choices ["q-105934/selection/b91582d3c259e0ee00dd4ebf48ea470ae8b87b30dad196abbfe434fa94deacb