2 \\\\ 1 & -1 \\\\ 1 & 0 \\\\ 1 & 1 \\\\ 1 & 2\\end{aligned}]}}\\overset{\\beta }{\\overset{⏞}{[\\begin{aligned}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{aligned}]}} & =\\overset{y}{\\overset{⏞}{[\\begin{aligned}-6 \\\\ -5 \\\\ -1 \\\\ 1 \\\\ 1\\end{aligned}]}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector."}] [{:db/id #edb/ref 17592186375020 :knowledge-point/_questions [{:knowledge-point/id #uuid "6acfe386-f7e4-54b1-9701-6ff5905b4536" :knowledge-point/title "Identifying Elements of a Regression Line in Terms of Matrices and Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dbc040e0-0b47-5ee1-b79a-dacdb66c3caf" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 1 & 1 & 1 & 1 \\\\ -3 & -2 & -1 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186375022} {:answer/id #uuid "ae820213-a53a-5ea3-84e8-650e033dbb81" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 & -2 & -1 & 0 & 1 \\\\ -8 & -4 & 0 & 6 & 10\\end{aligned}]" :db/id #edb/ref 17592186375023} {:answer/id #uuid "9e031e17-eef6-579d-8341-208b25dad966" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -8 \\\\ 1 & -4 \\\\ 1 & 2 \\\\ 1 & 6 \\\\ 1 & 10\\end{aligned}]" :db/id #edb/ref 17592186375024} {:answer/id #uuid "d72c205e-cafd-5a78-af0e-71c8913872d2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -3 \\\\ 1 & -2 \\\\ 1 & -1 \\\\ 1 & 0 \\\\ 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186375025} {:answer/id #uuid "13340f7c-0245-5949-a01e-11ac78411f18" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-8 & -3 \\\\ -4 & -2 \\\\ 2 & -1 \\\\ 6 & 0 \\\\ 10 & 1\\end{aligned}]" :db/id #edb/ref 17592186375026}] :answer-field/correct {:answer/id #uuid "d72c205e-cafd-5a78-af0e-71c8913872d2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -3 \\\\ 1 & -2 \\\\ 1 & 