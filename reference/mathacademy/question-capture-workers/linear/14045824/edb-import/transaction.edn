alidate]} {:db/id "q-101505/selection/fd5967779d0e40ab49d4c185399dcd6499199b3657fefb48aeaab9b56647da60" :answer/id #uuid "9e405340-a8a0-5819-a80c-aa3e7c6f426b" :answer/type :answer.type/math :answer/value "{78.56}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-101505/selection/16037594660525919353ab74cfe37fbff7f49f1cec0d311aee938a352dcd48dd" :answer/id #uuid "1ceece46-3fc8-540c-b050-d10cf1f0c6b7" :answer/type :answer.type/math :answer/value "{85.09}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-101505/selection/41f9d5a6d3221995b04529ee62a981ca3b19325480b3ec936fcc161170bfeb5e" :answer/id #uuid "7200eebe-b8b7-5bef-8986-98b60860efff" :answer/type :answer.type/math :answer/value "{80.13}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-101505/selection/d0fc433446b1a24feedcd37fa292cbaa848631055cf0eecb38760817afdd6f16" :answer/id #uuid "6fc39dd4-f2d0-5981-959d-08bf86fb316f" :answer/type :answer.type/math :answer/value "{83.21}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-101505/selection/58d392a5a02730b79b534a1cbd7bd33ff908bbe934de1b775d0ef30108975314" :answer/id #uuid "d8b7e83e-1e78-5493-9b1b-5f5f0a8dc9fe" :answer/type :answer.type/math :answer/value "{77.11}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-101505/selection" :answer-field/id #uuid "33102697-50b6-5b38-88af-cdf9060ee2ab" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-101505/selection/41f9d5a6d3221995b04529ee62a981ca3b19325480b3ec936fcc161170bfeb5e" :answer-field/choices ["q-101505/selection/fd5967779d0e40ab49d4c185399dcd6499199b3657fefb48aeaab9b56647da60" "q-101505/selection/16037594660525919353ab74cfe37fbff7f49f1cec0d311aee938a352dcd48dd" "q-101505/selection/41f9d5a6d3221995b04529ee62a981ca3b19325480b3ec936fcc161170bfeb5e" "q-101505/selection/d0fc433446b1a24feedcd37fa292cbaa848631055cf0eecb38760817afdd6f16" "q-101505/selection/58d392a5a02730b79b534a1cbd7bd33ff908bbe934de1b775d0ef30108975314"] :db/ensure [:answer-field/validate]} {:db/id "q-101505" :question/id #uuid "48a4942c-3458-5abb-8ba9-d5e046195ced" :question/math-academy-id "q-101505" :question/problem "Find the angle between $a=[\\begin{aligned}8 \\\\ 0 \\\\ 6\\end{aligned}]$ and $b=[\\begin{aligned}3 \\\\ 6 \\\\ -2\\end{aligned}].$ Round your answer to $2$ decimal places." :question/worked-solution "Rearranging the dot product formula, we have: \n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{a\\cdot b}{|\\,a\\,||\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{8\\cdot 3+0\\cdot 6+6\\cdot (-2)}{\\sqrt{{8}^{2}+{0}^{2}+{6}^{2}}\\sqrt{{3}^{2}+{6}^{2}+(-2)^{2}}} \\\\  & =\\frac{12}{\\sqrt{100}\\cdot \\sqrt{49}} \\\\  & =\\frac{12}{10\\cdot 7} \\\\  & =\\frac{6}{35}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{6}{35})≈{80.13}^{∘}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-101505/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a087e7bc-4e74-584d-af3b-bf6bee4b75ea"] :knowledge-point/questions ["q-101505"] :db/ensure [:knowledge-point/validate]} {:db/id "q-69828/selection/fdad1f8a9ae245b85e8d5bf8256ba7cc36a81d54412ee184a99721006622ab47" :answer/id #uuid "463db236-d16b-5282-aa3f-6b049c656135" :answer/type :answer.type/math :answer/value "{120}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-69828/selection/1690f33e4dfc66b5d93932f8ce8df1d471d5c7db0590bc6354d143eec2af246a" :answer/id #uuid "6ab0f59e-5662-5943-95cb-331b97e423ba" :answer/type :answer.type/math :answer/value "{90}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-69828/selection/b8903bf0f0c79152fee06a2deb1a952caebfd91f17e1376aeed868afbb728af8" :answer/id #uuid "8de510b8-8eaf-5e4e-8b22-a2ca29bb7766" :answer/type :answer.type/math :answer/value "{45}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-69828/selection/494cd77ad8a9b447737f156e4d1a6455198b704f906ab2283374911afa938361" :answer/id #uuid "f0107953-55fc-5db8-8fd3-270eb966b147" :answer/type :answer.type/math :answer/value "{180}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-69828/selection/cfa59613343dcd1d266f69e78114708e270fc38593403a2183ff722c45bc8c6d" :answer/id #uuid "f7812e21-c38a-5718-ad93-9ebb5f4389aa" :answer/type :answer.type/math :answer/value "{30}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-69828/selection" :answer-field/id #uuid "8fc88583-440a-5429-bf11-adc4beff062b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-69828/selection/494cd77ad8a9b447737f156e4d1a6455198b704f906ab2283374911afa938361" :answer-field/choices ["q-69828/selection/fdad1f8a9ae245b85e8d5bf8256ba7cc36a81d54412ee184a99721006622ab47" "q-69828/selection/1690f33e4dfc66b5d93932f8ce8df1d471d5c7db0590bc6354d143eec2af246a" "q-69828/selection/b8903bf0f0c79152fee06a2deb1a952caebfd91f17e1376aeed868afbb728af8" "q-69828/selection/494cd77ad8a9b447737f156e4d1a6455198b704f906ab2283374911afa938361" "q-69828/selection/cfa59613343dcd1d266f69e78114708e270fc38593403a2183ff722c45bc8c6d"] :db/ensure [:answer-field/validate]} {:db/id "q-69828" :question/id #uuid "8202d480-d11e-56b0-8904-661a796de5e0" :question/math-academy-id "q-69828" :question/problem "Find $∠PQR$ given the points $P(-3,0,-1)$, $Q(-1,1,0)$, and $R(1,2,1).$" :question/worked-solution "Note that the position vectors of the points $P$, $Q$, $R$ are\n\n$$\n\\begin{aligned}p=⟨-3,0,-1⟩,\\,q=⟨-1,1,0⟩,\\,r=⟨1,2,1⟩.\\end{aligned}\n$$\n\nThe $△PQR$ is shown (schematically) in the diagram below, where we denote $∠PQR=\\theta .$ \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/assets/209d43a5aab5d57fbd4cd7b421d41f0fa85bc58cfdd36251a8acf392b0ba7312.png)\n\nFirst, we find the components of $\\overset{\\to }{QP}$ and $\\overset{\\to }{QR}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{QP} & =p-q \\\\  & =⟨-3,0,-1⟩-⟨-1,1,0⟩ \\\\  & =⟨-2,-1,-1⟩ \\\\ \\overset{\\to }{QR} & =r-q \\\\  & =⟨1,2,1⟩-⟨-1,1,0⟩ \\\\  & =⟨2,1,1⟩\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overset{\\to }{QP}$ and $\\overset{\\to }{QR}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{QP}\\cdot \\overset{\\to }{QR}}{|\\overset{\\to }{QP}||\\overset{\\to }{QR}|} \\\\  & =\\frac{(-2)\\cdot 2+(-1)\\cdot 1+(-1)\\cdot 1}{\\sqrt{(-2)^{2}+(-1)^{2}+(-1)^{2}}\\sqrt{{2}^{2}+{1}^{2}+{1}^{2}}} \\\\  & =\\frac{-6}{\\sqrt{6}\\cdot \\sqrt{6}} \\\\  & =-1.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(-1)={180}^{∘}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-69828/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f7b1b8dc-bb50-59b4-8716-bdd6fbeada4f"] :knowledge-point/questions ["q-69828"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-101511"] :question/worked-solution "Note that the position vectors of the points $A$, $B$, $C$ are\n\n$$\n\\begin{aligned}a=⟨2,-1,1⟩,\\,b=⟨3,1,-2⟩,\\,c=⟨-1,1,1⟩.\\end{aligned}\n$$\n\nThe triangle $△ABC$ is shown (schematically) in the diagram below, where we denote $∠BAC=\\theta .$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/assets/285b8343208079181ac6036cf9ca16abc974d59b9262878ed40c0da9af5683d0.png)\n\nFirst, we find the components of $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =⟨3,1,-2⟩-⟨2,-1,1⟩ \\\\  & =⟨1,2,-3⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =⟨-1,1,1⟩-⟨2,-1,1⟩ \\\\  & =⟨-3,2,0⟩.\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}}{|\\overset{\\to }{AB}||\\overset{\\to }{AC}|} \\\\  & =\\frac{1\\cdot (-3)+2\\cdot 2+(-3)\\cdot 0}{\\sqrt{{1}^{2}+{2}^{2}+(-3)^{2}}\\sqrt{(-3)^{2}+{2}^{2}+{0}^{2}}} \\\\  & =\\frac{1}{\\sqrt{14}\\cdot \\sqrt{13}} \\\\  & =\\frac{1}{\\sqrt{182}}.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{1}{\\sqrt{182}})≈{86}^{∘}.\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-69831"] :question/worked-solution "Note that the position vectors of the points $P$, $Q$, $R$ are\n\n$$\n\\begin{aligned}p=⟨2,1,2⟩,\\,q=⟨1,3,2⟩,\\,r=⟨4,5,-2⟩.\\end{aligned}\n$$\n\nThe triangle $△PQR$ is shown (schematically) in the diagram below, where we denote $∠QPR=\\theta .$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/assets/3003f0cb329a8f8ef9bc315c70df4773ac1f0c54843dea1208c68bd0f6227bd1.png)\n\nFirst, we find the components of $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =q-p \\\\  & =⟨1,3,2⟩-⟨2,1,2⟩ \\\\  & =⟨-1,2,0⟩ \\\\ \\overset{\\to }{PR} & =r-p \\\\  & =⟨4,5,-2⟩-⟨2,1,2⟩ \\\\  & =⟨2,4,-4⟩.\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{PQ}\\cdot \\overset{\\to }{PR}}{|\\overset{\\to }{PQ}||\\overset{\\to }{PR}|} \\\\  & =\\frac{(-1)\\cdot 2+2\\cdot 4+0\\cdot (-4)}{\\sqrt{(-1)^{2}+{2}^{2}+{0}^{2}}\\sqrt{{2}^{2}+{4}^{2}+(-4)^{2}}} \\\\  & =\\frac{6}{\\sqrt{5}\\cdot \\sqrt{36}} \\\\  & =\\frac{6}{6\\sqrt{5}} \\\\  & =\\frac{\\sqrt{5}}{5}\\,.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{\\sqrt{5}}{5})≈{63}^{∘}.\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-69833"] :question/worked-solution "Note that the position vectors of the points $X$, $Y$, $Z$ are\n\n$$\n\\begin{aligned}x=⟨-1,0,3⟩,\\,y=⟨-2,2,3⟩,\\,z=⟨-2,-1,3⟩.\\end{aligned}\n$$\n\nThe $△XYZ$ is shown (schematically) in the diagram below, where we denote $∠XZY=\\theta .$ \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/assets/87453fecb9da6b9e673ab5a85a289a3fac73f4fb90fc8f1b33e7c0a80b1ea77f.png)\n\nFirst, we find the components of $\\overset{\\to }{ZX}$ and $\\overset{\\to }{ZY}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{ZX} & =x-z \\\\  & =⟨-1,0,3⟩-⟨-2,-1,3⟩ \\\\  & =⟨1,1,0⟩ \\\\ \\overset{\\to }{ZY} & =y-z \\\\  & =⟨-2,2,3⟩-⟨-2,-1,3⟩ \\\\  & =⟨0,3,0⟩\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overset{\\to }{ZX}$ and $\\overset{\\to }{ZY}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{ZX}\\cdot \\overset{\\to }{ZY}}{|\\overset{\\to }{ZX}||\\overset{\\to }{ZY}|} \\\\  & =\\frac{1\\cdot 0+1\\cdot 3+0\\cdot 0}{\\sqrt{{1}^{2}+{1}^{2}+{0}^{2}}\\sqrt{{0}^{2}+{3}^{2}+{0}^{2}}} \\\\  & =\\frac{3}{\\sqrt{2}\\cdot \\sqrt{9}} \\\\  & =\\frac{1}{\\sqrt{2}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{1}{\\sqrt{2}})={45}^{∘}.\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-124826"] :question/worked-solution "Note that the position vectors of the points $X$, $Y$, $Z$ are\n\n$$\n\\begin{aligned}x=⟨-2,1,0⟩,\\,y=⟨-1,0,4⟩,\\,z=⟨-1,2,-2⟩.\\end{aligned}\n$$\n\nThe $△XYZ$ is shown (schematically) in the diagram below, where we denote $∠XZY=\\theta .$ \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/assets/87453fecb9da6b9e673ab5a85a289a3fac73f4fb90fc8f1b33e7c0a80b1ea77f.png)\n\nFirst, we find the components of $\\overset{\\to }{ZX}$ and $\\overset{\\to }{ZY}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{ZX} & =x-z \\\\  & =⟨-2,1,0⟩-⟨-1,2,-2⟩ \\\\  & =⟨-1,-1,2⟩ \\\\ \\overset{\\to }{ZY} & =y-z \\\\  & =⟨-1,0,4⟩-⟨-1,2,-2⟩ \\\\  & =⟨0,-2,6⟩\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overset{\\to }{ZX}$ and $\\overset{\\to }{ZY}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{ZX}\\cdot \\overset{\\to }{ZY}}{|\\overset{\\to }{ZX}||\\overset{\\to }{ZY}|} \\\\  & =\\frac{(-1)\\cdot 0+(-1)\\cdot (-2)+2\\cdot 6}{\\sqrt{(-1)^{2}+(-1)^{2}+{2}^{2}}\\sqrt{{0}^{2}+(-2)^{2}+{6}^{2}}} \\\\  & =\\frac{14}{\\sqrt{6}\\cdot \\sqrt{40}} \\\\  & =\\frac{14}{\\sqrt{240}} \\\\  & =\\frac{14}{4\\sqrt{15}} \\\\  & =\\frac{7}{2\\sqrt{15}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{7}{2\\sqrt{15}})={25}^{∘}.\n$$" :db/ensure [:question/validate]} {:db/id "q-19119/selection/74788977b850f9b1eb8c16e7936a0b30dc2596701a03e7587a8af0c329091587" :answer/id #uuid "fc63e80c-1a01-58e7-812c-d1b232e8a92a" :answer/type :answer.type/math :answer/value "{81.64}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-19119/selection/16d649370c85c7be76db1bf650f75c2b1101a52fc909e965687b98f694e4deb2" :answer/id #uuid "67a0e966-c4f3-560d-8ed6-ac3135eefe27" :answer/type :answer.type/math :answer/value "{88.29}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-19119/selection/8e4aa2b33493c941466795a453a94ab7c7c3349ce797e63b71dac91eca3104a4" :answer/id #uuid "09107298-68c8-5bea-a9c3-3569be3257a7" :answer/type :answer.type/math :answer/value "{52.15}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-19119/selection/2c18c6f594a58bc5de59f9eef1327990c3bb4b5bcaa4e164e207754fd03797c9" :answer/id #uuid "1a7c0d34-89b3-51f8-aa99-3d40a4d6cc25" :answer/type :answer.type/math :answer/value "{93.32}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-19119/selection/2241f3c308c2686614309f6af55ca3afe2925c70fdbe950ab43109d6720c0f7e" :answer/id #uuid "70b0e40d-efb1-50f0-bdc0-78ddb04a6a87" :answer/type :answer.type/math :answer/value "{67.48}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-19119/selection" :answer-field/id #uuid "5b70f907-71bb-5dc4-9e01-8a31caff20d0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-19119/selection/74788977b850f9b1eb8c16e7936a0b30dc2596701a03e7587a8af0c329091587" :answer-field/choices ["q-19119/selection/74788977b850f9b1eb8c16e7936a0b30dc2596701a03e7587a8af0c329091587" "q-19119/selection/16d649370c85c7be76db1bf650f75c2b1101a52fc909e965687b98f694e4deb2" "q-19119/selection/8e4aa2b33493c941466795a453a94ab7c7c3349ce797e63b71dac91eca3104a4" "q-19119/selection/2c18c6f594a58bc5de59f9eef1327990c3bb4b5bcaa4e164e207754fd03797c9" "q-19119/selection/2241f3c308c2686614309f6af55ca3afe2925c70fdbe950ab43109d6720c0f7e"] :db/ensure [:answer-field/validate]} {:db/id "q-19119" :question/id #uuid "b85d2bd6-f159-5eda-95b8-8ed7b380eebb" :question/math-academy-id "q-19119" :question/problem "Consider the points $D(1,3,2)$, $E(t,2,4)$ and $F(3,t,3).$ Find $∠EDF$ given that $\\overset{\\to }{DE}\\cdot \\overset{\\to }{DF}=2.$ Round your answer to $2$ decimal places." :question/worked-solution "Note that the position vectors of the points $D$, $E$, $F$ are\n\n$$\n\\begin{aligned}d=⟨1,\\,3,\\,2⟩,\\,e=⟨t,\\,2,\\,4⟩,\\,f=⟨3,\\,t,\\,3⟩.\\end{aligned}\n$$\n\nThe triangle $△DEF$ is shown (schematically) in the diagram below, where we denote $∠EDF=\\theta .$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/assets/c9cfb3e84e6f76d243125f2a09246b2a1300a0134e71359bb2b528082f064f93.png)\n\nFirst, we find the components of $\\overset{\\to }{DE}$ and $\\overset{\\to }{DF}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{DE} & =e-d \\\\  & =⟨t,\\,2,\\,4⟩-⟨1,\\,3,\\,2⟩ \\\\  & =⟨t-1,\\,-1,\\,2⟩ \\\\ \\overset{\\to }{DF} & =f-d \\\\  & =⟨3,\\,t,\\,3⟩-⟨1,\\,3,\\,2⟩ \\\\  & =⟨2,\\,t-3,\\,1⟩\\end{aligned}\n$$\n\nNow, since $\\overset{\\to }{DE}\\cdot \\overset{\\to }{DF}=2$, we can solve for $t$, as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{DE}\\cdot \\overset{\\to }{DF} & =2 \\\\ (t-1)\\cdot 2+(-1)\\cdot (t-3)+2\\cdot 1 & =2 \\\\ 2t-2-t+3+2 & =2 \\\\ t & =-1\\end{aligned}\n$$\n\nSo, \n\n$$\n\\begin{aligned}\\overset{\\to }{DE} & =⟨-1-1,-1,2⟩ \\\\  & =⟨-2,-1,2⟩, \\\\ \\overset{\\to }{DF} & =⟨2,-1-3,1⟩ \\\\  & =⟨2,-4,1⟩.\\end{aligned}\n$$\n\nNext, the cosine of the angle between $\\overset{\\to }{DE}$ and $\\overset{\\to }{DF}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{DE}\\cdot \\overset{\\to }{DF}}{|\\overset{\\to }{DE}||\\overset{\\to }{DF}|} \\\\  & =\\frac{2}{\\sqrt{(-2)^{2}+(-1)^{2}+{2}^{2}}\\sqrt{{2}^{2}+(-4)^{2}+{1}^{2}}} \\\\  & =\\frac{2}{\\sqrt{9}\\cdot \\sqrt{21}} \\\\  & =\\frac{2}{3\\sqrt{21}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{2}{3\\sqrt{21}})≈{81.64}^{∘}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-19119/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a418d9aa-d74d-58b1-a4c9-819f63593d50"] :knowledge-point/questions ["q-19119"] :db/ensure [:knowledge-point/validate]} {:db/id "q-19032/selection/42be4789c71a88e90f66848252c7068febecdc4e3c64e3b4a5d931b59a1418d2" :answer/id #uuid "e0b19f68-2650-526f-9f23-98b81778f5c2" :answer/type :answer.type/math :answer/value "{52.33}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-19032/selection/e667ab8adf1bc972d8a1a1b439cf7c230fc29926dbab07a4d2f8eec1fd4a9fd3" :answer/id #uuid "c1f2d9ac-ab27-5537-88a9-ae6bb04c1126" :answer/type :answer.type/math :answer/value "{42.27}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-19032/selection/007e3f722958f0533504aa10bb79a187415814635c150c4c30ac45806941e253" :answer/id #uuid "a48530c6-5151-5767-8d33-b9b385ac683b" :answer/type :answer.type/math :answer/value "{46.18}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-19032/selection/ec547f39b8411476762f4c8da0b0c1e4c77332dcfffa3a99c7af28cd100d5bf0" :answer/id #uuid "5621eec5-b695-5579-abef-41be75308fd8" :answer/type :answer.type/math :answer/value "{33.74}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-19032/selection/8645ba143fadf880d7a61c6c070969ee8b2e1d29795f65f6345a4fcd5ebd8b25" :answer/id #uuid "d9a2d70f-606d-53d8-888c-2ef44dcc4886" :answer/type :answer.type/math :answer/value "{37.75}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-19032/selection" :answer-field/id #uuid "ffcb5a00-9fa0-5f57-8dd7-870c04f9bd64" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-19032/selection/e667ab8adf1bc972d8a1a1b439cf7c230fc29926dbab07a4d2f8eec1fd4a9fd3" :answer-field/choices ["q-19032/selection/42be4789c71a88e90f66848252c7068febecdc4e3c64e3b4a5d931b59a1418d2" "q-19032/selection/e667ab8adf1bc972d8a1a1b439cf7c230fc29926dbab07a4d2f8eec1fd4a9fd3" "q-19032/selection/007e3f722958f0533504aa10bb79a187415814635c150c4c30ac45806941e253" "q-19032/selection/ec547f39b8411476762f4c8da0b0c1e4c77332dcfffa3a99c7af28cd100d5bf0" "q-19032/selection/8645ba143fadf880d7a61c6c070969ee8b2e1d29795f65f6345a4fcd5ebd8b25"] :db/ensure [:answer-field/validate]} {:db/id "q-19032" :question/id #uuid "30394f5f-9572-5a4f-bf32-50670ecbcc6a" :question/math-academy-id "q-19032" :question/problem "Given that $c\\cdot d=11$, find the angle between $c=⟨2t,1⟩$ and $d=⟨2,3⟩.$ Round your answer to $2$ decimal places." :question/worked-solution "First, since $c\\cdot d=11$, we can solve for $t$, as follows:\n\n$$\n\\begin{aligned}c\\cdot d & =11 \\\\ 2t\\cdot 2+1\\cdot 3 & =11 \\\\ 4t+3 & =11 \\\\ 4t & =8 \\\\ t & =2\\end{aligned}\n$$\n\nSo,\n\n$$\n\\begin{aligned}c & =⟨2(2),1⟩ \\\\  & =⟨4,1⟩.\\end{aligned}\n$$\n\nNow, the cosine of the angle between $c$ and $d$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{c\\cdot d}{|\\,c\\,||\\,d\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}}{\\sqrt{{c}_{x}^{2}+{c}_{y}^{2}}\\sqrt{{d}_{x}^{2}+{d}_{y}^{2}}} \\\\  & =\\frac{11}{\\sqrt{{4}^{2}+{1}^{2}}\\sqrt{{2}^{2}+{3}^{2}}} \\\\  & =\\frac{11}{\\sqrt{17}\\cdot \\sqrt{13}} \\\\  & =\\frac{11}{\\sqrt{221}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{11}{\\sqrt{221}})≈{42.27}^{∘}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-19032/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a418d9aa-d74d-58b1-a4c9-819f63593d50"] :knowledge-point/questions ["q-19032"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-77164"] :question/worked-solution "Note that the position vectors of the points $A,$ $B$ and $C$ are\n\n$$\n\\begin{aligned}a=⟨3t,\\,t,\\,4⟩,\\,b=⟨3t,\\,4t,\\,3⟩,\\,c=⟨5t,\\,t+1,\\,5⟩.\\end{aligned}\n$$\n\nThe triangle $△ABC$ is shown (schematically) in the diagram below, where we denote $∠BAC=\\theta .$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/assets/285b8343208079181ac6036cf9ca16abc974d59b9262878ed40c0da9af5683d0.png)\n\nFirst, we find the components of $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =⟨3t,\\,4t,\\,3⟩-⟨3t,\\,t,\\,4⟩ \\\\  & =⟨0,\\,3t,\\,-1⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =⟨5t,\\,t+1,\\,5⟩-⟨3t,\\,t,\\,4⟩ \\\\  & =⟨2t,\\,1,\\,1⟩\\end{aligned}\n$$\n\nNow, since $\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}=2$, we can solve for $t,$ as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC} & =2 \\\\ 0\\cdot 2t+3t\\cdot 1+(-1)\\cdot 1 & =2 \\\\ 3t-1 & =2 \\\\ 3t & =3 \\\\ t & =1\\end{aligned}\n$$\n\nSo, \n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =⟨0,3,-1⟩, \\\\ \\overset{\\to }{AC} & =⟨2,\\,1,\\,1⟩.\\end{aligned}\n$$\n\nNext, the cosine of the angle between $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}}{|\\overset{\\to }{AB}||\\overset{\\to }{AC}|} \\\\  & =\\frac{2}{\\sqrt{{0}^{2}+{3}^{2}+(-1)^{2}}\\cdot \\sqrt{{2}^{2}+{1}^{2}+{1}^{2}}} \\\\  & =\\frac{2}{\\sqrt{10}\\cdot \\sqrt{6}} \\\\  & =\\frac{2}{2\\sqrt{15}} \\\\  & =\\frac{1}{\\sqrt{15}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{1}{\\sqrt{15}})≈{75}^{∘}.\n$$" :db/ensure [:question/validate]} {:db/id "q-101515/selection/21de0e7a7663cbc14dcb456bb43e0c5dd3931903e21d730d39fb5e4460b5af88" :answer/id #uuid "cf1a3d83-c0d0-5d59-a725-a4e550616531" :answer/type :answer.type/math :answer/value "{40.5}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-101515/selection/f6b181b495910592cfd40b52b7aa373a2f64c0a19363d3da4bf887b7cd37028a" :answer/id #uuid "f43dd61c-e951-51e1-b3f0-81494fd85fe5" :answer/type :answer.type/math :answer/value "{39.9}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-101515/selection/ac2a6eccee20c30d4a4f57327e88f771c49e4f0ee0e19d980e9b3efa1b01a09b" :answer/id #uuid "61964971-6f18-575d-bb4c-ec4324e66d09" :answer/type :answer.type/math :answer/value "{44.4}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-101515/selection/45c5c1ea4ce093f858910a6e7b6e4f06291841010906851879e99642749f9667" :answer/id #uuid "345b08c5-cf95-54c0-961f-48ebefe29864" :answer/type :answer.type/math :answer/value "{42.3}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-101515/selection/929c64f6ba2a87358c0dc55c1805e26f47cff2659d79d56b2312e8db9a8c4345" :answer/id #uuid "15b71257-302d-58eb-b6d6-a575553f86d0" :answer/type :answer.type/math :answer/value "{45.1}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-101515/selection" :answer-field/id #uuid "885fe984-e9dc-55cb-800b-ef3684faddb7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-101515/selection/45c5c1ea4ce093f858910a6e7b6e4f06291841010906851879e99642749f9667" :answer-field/choices ["q-101515/selection/21de0e7a7663cbc14dcb456bb43e0c5dd3931903e21d730d39fb5e4460b5af88" "q-101515/selection/f6b181b495910592cfd40b52b7aa373a2f64c0a19363d3da4bf887b7cd37028a" "q-101515/selection/ac2a6eccee20c30d4a4f57327e88f771c49e4f0ee0e19d980e9b3efa1b01a09b" "q-101515/selection/45c5c1ea4ce093f858910a6e7b6e4f06291841010906851879e99642749f9667" "q-101515/selection/929c64f6ba2a87358c0dc55c1805e26f47cff2659d79d56b2312e8db9a8c4345"] :db/ensure [:answer-field/validate]} {:db/id "q-101515" :question/id #uuid "6924e182-afff-5ad5-8eac-9fcb60a7b5ab" :question/math-academy-id "q-101515" :question/problem "Given that $p\\cdot q=11$, find the angle between $p=⟨t,t-1⟩$ and $q=⟨-4,-1⟩.$ Round your answer to $1$ decimal place." :question/worked-solution "First, since $p\\cdot q=11$, we can solve for $t$, as follows:\n\n$$\n\\begin{aligned}p\\cdot q & =11 \\\\ t\\cdot (-4)+(t-1)\\cdot (-1) & =11 \\\\ -4t-t+1 & =11 \\\\ -5t & =10 \\\\ t & =-2\\end{aligned}\n$$\n\nSo, \n\n$$\n\\begin{aligned}p & =⟨(-2),(-2)-1⟩ \\\\  & =⟨-2,-3⟩.\\end{aligned}\n$$\n\nNow, the cosine of the angle between $p$ and $q$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{p\\cdot q}{|\\,p\\,||\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}}{\\sqrt{{p}_{x}^{2}+{p}_{y}^{2}}\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}}} \\\\  & =\\frac{11}{\\sqrt{(-2)^{2}+(-3)^{2}}\\sqrt{(-4)^{2}+(-1)^{2}}} \\\\  & =\\frac{11}{\\sqrt{13}\\cdot \\sqrt{17}} \\\\  & =\\frac{11}{\\sqrt{221}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{11}{\\sqrt{221}})≈{42.3}^{∘}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-101515/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a418d9aa-d74d-58b1-a4c9-819f63593d50"] :knowledge-point/questions ["q-101515"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-4328"] :question/worked-solution "Note that the position vectors of the points $A$, $B$, $C$ are\n\n$$\n\\begin{aligned}a=⟨2,-1,-5⟩,\\,b=⟨-1,0,-4⟩,\\,c=⟨5,1,1⟩.\\end{aligned}\n$$\n\nThe triangle $\\triangle ABC$ is shown (schematically) in the diagram below, where we denote $\\angle BAC = \\theta.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/assets/285b8343208079181ac6036cf9ca16abc974d59b9262878ed40c0da9af5683d0.png)\n\nFirst, we find the components of $\\overrightarrow{AB}$ and $\\overrightarrow{AC}\\mathbin{:}$\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =⟨-1,0,-4⟩-⟨2,-1,-5⟩ \\\\  & =⟨-3,1,1⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =⟨5,1,1⟩-⟨2,-1,-5⟩ \\\\  & =⟨3,2,6⟩\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overrightarrow{AB}$ and $\\overrightarrow{AC}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}}{|\\overset{\\to }{AB}||\\overset{\\to }{AC}|} \\\\  & =\\frac{-3\\cdot 3+1\\cdot 2+1\\cdot 6}{\\sqrt{(-3)^{2}+{1}^{2}+{1}^{2}}\\sqrt{{3}^{2}+{2}^{2}+{6}^{2}}} \\\\  & =\\frac{-1}{\\sqrt{11}\\sqrt{49}} \\\\  & =-\\frac{1}{7\\sqrt{11}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta = \\arccos \\left( -\\dfrac{1}{7\\sqrt{11}} \\right) \\approx 92.5^\\circ.\n$$" :db/ensure [:question/validate]}]
