[{:db/id "q-101501/selection/a75c4672c7dda7308ce7295cb1b20feece23cc672c997b01842c8cfef35f7f2b" :answer/id #uuid "a1f60648-fa54-5c56-aca9-55b17eae8093" :answer/type :answer.type/math :answer/value "{89.9}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-101501/selection/129b2106b464b30a5502865820be323b660d2db47d0c14eec16a9107931d6589" :answer/id #uuid "eb997459-1c05-5493-973d-0e89478a67e5" :answer/type :answer.type/math :answer/value "{91.7}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-101501/selection/ad3ba3b89188b1582c513fca5c9a62105100fd2c6969166e9500177e9c4a110e" :answer/id #uuid "6841f3bc-de1d-573c-8373-e481429455dd" :answer/type :answer.type/math :answer/value "{85.6}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-101501/selection/835510ff55729b8083d4ccf1ac95172978e2e52a3dfd76634567c4c5acb41134" :answer/id #uuid "ce46609d-1539-5250-978a-3c0846a2b548" :answer/type :answer.type/math :answer/value "{102.1}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-101501/selection/8762cd14af21d52266a3ec8725e7c1c9a41c945410330acb2366b3fdc1cafc7d" :answer/id #uuid "c4a32a1d-55b0-5423-b6cc-d008ab997367" :answer/type :answer.type/math :answer/value "{94.6}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-101501/selection" :answer-field/id #uuid "79d36258-e554-53c0-a410-c65dbdecabce" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-101501/selection/8762cd14af21d52266a3ec8725e7c1c9a41c945410330acb2366b3fdc1cafc7d" :answer-field/choices ["q-101501/selection/a75c4672c7dda7308ce7295cb1b20feece23cc672c997b01842c8cfef35f7f2b" "q-101501/selection/129b2106b464b30a5502865820be323b660d2db47d0c14eec16a9107931d6589" "q-101501/selection/ad3ba3b89188b1582c513fca5c9a62105100fd2c6969166e9500177e9c4a110e" "q-101501/selection/835510ff55729b8083d4ccf1ac95172978e2e52a3dfd76634567c4c5acb41134" "q-101501/selection/8762cd14af21d52266a3ec8725e7c1c9a41c945410330acb2366b3fdc1cafc7d"] :db/ensure [:answer-field/validate]} {:db/id "q-101501" :question/id #uuid "068e8007-9b15-5291-bff1-582a2d3f3df4" :question/math-academy-id "q-101501" :question/problem "Find the angle between $a=[\\begin{aligned}1 \\\\ -6\\end{aligned}]$ and $b=[\\begin{aligned}4 \\\\ 1\\end{aligned}].$ Round your answer to $1$ decimal place." :question/worked-solution "Rearranging the dot product formula, we have:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{a\\cdot b}{|\\,a\\,||\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}}\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}}} \\\\  & =\\frac{1\\cdot 4+(-6)\\cdot 1}{\\sqrt{{1}^{2}+(-6)^{2}}\\sqrt{{4}^{2}+{1}^{2}}} \\\\  & =-\\frac{2}{\\sqrt{37}\\cdot \\sqrt{17}} \\\\  & =-\\frac{2}{\\sqrt{629}}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(-\\frac{2}{\\sqrt{629}})≈{94.6}^{∘}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-101501/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a087e7bc-4e74-584d-af3b-bf6bee4b75ea"] :knowledge-point/questions ["q-101501"] :db/ensure [:knowledge-point/validate]} {:db/id "q-19028/selection/04a957e6e22629a4173a3ba5fec0752e198f21a1bfd1ab3b4e1aaccd930174d3" :answer/id #uuid "5bec37f1-5c4f-5b18-849a-dac4ba3e139a" :answer/type :answer.type/math :answer/value "{60}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-19028/selection/8054304fddf4b48693ad35887faf99224ec7548e30e7afaf6bf777ee8da45450" :answer/id #uuid "1a3deab4-c5ca-50d5-b1ca-8d0478828152" :answer/type :answer.type/math :answer/value "{0}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-19028/selection/1690f33e4dfc66b5d93932f8ce8df1d471d5c7db0590bc6354d143eec2af246a" :answer/id #uuid "43f0e300-ab89-572f-aa42-f3823226a421" :answer/type :answer.type/math :answer/value "{90}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-19028/selection/b8903bf0f0c79152fee06a2deb1a952caebfd91f17e1376aeed868afbb728af8" :answer/id #uuid "c1abf405-e4b4-5787-bd09-52c38e51affb" :answer/type :answer.type/math :answer/value "