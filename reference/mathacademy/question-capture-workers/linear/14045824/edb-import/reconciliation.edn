928b7f2f20f0df35" "basis" 650 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13964292/edb-import/verification.json"} {"question" "q-19037" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{11.49}^{∘}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13964292/state.json" "file_sha256" "3c138e79e69852f73c5d8d62bcc01cfaeaeb160d75072882928b7f2f20f0df35" "basis" 650 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13964292/edb-import/verification.json"} {"question" "q-101511" "field" nil "attribute" "question/problem" "value" "Find $∠BAC$ given the points $A(2,-1,1)$, $B(3,1,-2)$, and $C(-1,1,1).$ Round your answer to the nearest degree." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13964292/state.json" "file_sha256" "3c138e79e69852f73c5d8d62bcc01cfaeaeb160d75072882928b7f2f20f0df35" "basis" 650 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13964292/edb-import/verification.json"} {"question" "q-101511" "field" nil "attribute" "question/worked-solution" "value" "Note that the position vectors of the points $A$, $B$, $C$ are\n\n$$\n\\begin{aligned}a=⟨2,-1,1⟩,\\,b=⟨3,1,-2⟩,\\,c=⟨-1,1,1⟩.\\end{aligned}\n$$\n\nThe triangle $△ABC$ is shown (schematically) in the diagram below, where we denote $∠BAC=\\theta .$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13964292/assets/285b8343208079181ac6036cf9ca16abc974d59b9262878ed40c0da9af5683d0.png)\n\nFirst, we find the components of $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =⟨3,1,-2⟩-⟨2,-1,1⟩ \\\\  & =⟨1,2,-3⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =⟨-1,1,1⟩-⟨2,-1,1⟩ \\\\  & =⟨-3,2,0⟩.\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}}{|\\overset{\\to }{AB}||\\overset{\\to }{AC}|} \\\\  & =\\frac{1\\cdot (-3)+2\\cdot 2+(-3)\\cdot 0}{\\sqrt{{1}^{2}+{2}^{2}+(-3)^{2}}\\sqrt{(-3)^{2}+{2}^{2}+{0}^{2}}} \\\\  & =\\frac{1}{\\sqrt{14}\\cdot \\sqrt{13}} \\\\  & =\\frac{1}{\\sqrt{182}}.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{1}{\\sqrt{182}})≈{86}^{∘}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13964292/state.json" "file_sha256" "3c138e79e69852f73c5d8d62bcc01cfaeaeb160d75072882928b7f2f20f0df35" "basis" 650 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13964292/edb-import/verification.json"} {"question" "q-101511" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13964292/activity-metadata.json" "file_sha256" "3c4ae64d9a3b82d1d472628be6b7d38a56c75262d035fbf1513196b1932ceac9" "basis" 650 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13964292/edb-import/verification.json"} {"question" "q-101511" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13964292/state.json" "file_sha256" "3c138e79e69852f73c5d8d62bcc01cfaeaeb160d75072882928b7f2f20f0df35" "basis" 650 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13964292/edb-import/verification.json"} {"question" "q-101511" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "{77}^{∘}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/qu