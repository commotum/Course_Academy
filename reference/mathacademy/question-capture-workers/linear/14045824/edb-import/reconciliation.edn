Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-19037" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{11.49}^{∘}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-101505" "field" nil "attribute" "question/problem" "value" "Find the angle between $a=[\\begin{aligned}8 \\\\ 0 \\\\ 6\\end{aligned}]$ and $b=[\\begin{aligned}3 \\\\ 6 \\\\ -2\\end{aligned}].$ Round your answer to $2$ decimal places." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-101505" "field" nil "attribute" "question/worked-solution" "value" "Rearranging the dot product formula, we have: \n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{a\\cdot b}{|\\,a\\,||\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{8\\cdot 3+0\\cdot 6+6\\cdot (-2)}{\\sqrt{{8}^{2}+{0}^{2}+{6}^{2}}\\sqrt{{3}^{2}+{6}^{2}+(-2)^{2}}} \\\\  & =\\frac{12}{\\sqrt{100}\\cdot \\sqrt{49}} \\\\  & =\\frac{12}{10\\cdot 7} \\\\  & =\\frac{6}{35}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{6}{35})≈{80.13}^{∘}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-101505" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/activity-metadata.json" "file_sha256" "69439c99388ed4f03cb7c64633545f69bd84ad1aacf06d4f3cc7b3d16b3e60a7"} {"question" "q-101505" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-101505" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{77.11}^{∘}"] ["math" "{78.56}^{∘}"] ["math" "{80.13}^{∘}"] ["math" "{83.21}^{∘}"] ["math" "{85.09}^{∘}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-101505" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{80.13}^{∘}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-69828" "field" nil "attribute" "question/problem" "value" "Find $∠PQR$ given the points $P(-3,0,-1)$, $Q(-1,1,0)$, and $R(1,2,1).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-69828" "field" nil "attribute" "question/worked-solution" "value" "Note that the position vectors of the points $P$, $Q$, $R$ are\n\n$$\n\\begin{aligned}p=⟨-3,0,-1⟩,\\,q=⟨-1,1,0⟩,\\,r=⟨1,2,1⟩.\\end{aligned}\n$$\n\nThe $△PQR$ is shown (schematically) in the diagram below, where we denote $∠PQR=\\theta .$ \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/assets/209d43a5aab5d57fbd4cd7b421d41f0fa85bc58cfdd36251a8acf392b0ba7312.png)\n\nFirst, we find the components of $\\overset{\\to }{QP}$ and $\\overset{\\to }{QR}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{QP} & =p-q \\\\  & =⟨-3,0,-1⟩-⟨-1,1,0⟩ \\\\  & =⟨-2,-1,-1⟩ \\\\ \\overset{\\to }{QR} & =r-q \\\\  & =⟨1,2,1⟩-⟨-1,1,0⟩ \\\\  & =⟨2,1,1⟩\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overset{\\to }{QP}$ and $\\overset{\\to }{QR}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{QP}\\cdot \\overset{\\to }{QR}}{|\\overset{\\to }{QP}||\\overset{\\to }{QR}|} \\\\  & =\\frac{(-2)\\cdot 2+(-1)\\cdot 1+(-1)\\cdot 1}{\\sqrt{(-2)^{2}+(-1)^{2}+(-1)^{2}}\\sqrt{{2}^{2}+{1}^{2}+{1}^{2}}} \\\\  & =\\frac{-6}{\\sqrt{6}\\cdot \\sqrt{6}} \\\\  & =-1.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(-1)={180}^{∘}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-69828" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/activity-metadata.json" "file_sha256" "69439c99388ed4f03cb7c64633545f69bd84ad1aacf06d4f3cc7b3d16b3e60a7"} {"question" "q-69828" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-69828" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{120}^{∘}"] ["math" "{180}^{∘}"] ["math" "{30}^{∘}"] ["math" "{45}^{∘}"] ["math" "{90}^{∘}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-69828" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{180}^{∘}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-101511" "field" nil "attribute" "question/problem" "value" "Find $∠BAC$ given the points $A(2,-1,1)$, $B(3,1,-2)$, and $C(-1,1,1).$ Round your answer to the nearest degree." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-101511" "field" nil "attribute" "question/worked-solution" "value" "Note that the position vectors of the points $A$, $B$, $C$ are\n\n$$\n\\begin{aligned}a=⟨2,-1,1⟩,\\,b=⟨3,1,-2⟩,\\,c=⟨-1,1,1⟩.\\end{aligned}\n$$\n\nThe triangle $△ABC$ is shown (schematically) in the diagram below, where we denote $∠BAC=\\theta .$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/assets/285b8343208079181ac6036cf9ca16abc974d59b9262878ed40c0da9af5683d0.png)\n\nFirst, we find the components of $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =⟨3,1,-2⟩-⟨2,-1,1⟩ \\\\  & =⟨1,2,-3⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =⟨-1,1,1⟩-⟨2,-1,1⟩ \\\\  & =⟨-3,2,0⟩.\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}}{|\\overset{\\to }{AB}||\\overset{\\to }{AC}|} \\\\  & =\\frac{1\\cdot (-3)+2\\cdot 2+(-3)\\cdot 0}{\\sqrt{{1}^{2}+{2}^{2}+(-3)^{2}}\\sqrt{(-3)^{2}+{2}^{2}+{0}^{2}}} \\\\  & =\\frac{1}{\\sqrt{14}\\cdot \\sqrt{13}} \\\\  & =\\frac{1}{\\sqrt{182}}.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{1}{\\sqrt{182}})≈{86}^{∘}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-101511" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/activity-metadata.json" "file_sha256" "69439c99388ed4f03cb7c64633545f69bd84ad1aacf06d4f3cc7b3d16b3e60a7"} {"question" "q-101511" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-101511" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{77}^{∘}"] ["math" "{79}^{∘}"] ["math" "{81}^{∘}"] ["math" "{86}^{∘}"] ["math" "{91}^{∘}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-101511" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{86}^{∘}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-69831" "field" nil "attribute" "question/problem" "value" "Find $∠QPR$ given the points $P(2,1,2)$, $Q(1,3,2)$, and $R(4,5,-2).$ Round your answer to the nearest degree." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-69831" "field" nil "attribute" "question/worked-solution" "value" "Note that the position vectors of the points $P$, $Q$, $R$ are\n\n$$\n\\begin{aligned}p=⟨2,1,2⟩,\\,q=⟨1,3,2⟩,\\,r=⟨4,5,-2⟩.\\end{aligned}\n$$\n\nThe triangle $△PQR$ is shown (schematically) in the diagram below, where we denote $∠QPR=\\theta .$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/assets/3003f0cb329a8f8ef9bc315c70df4773ac1f0c54843dea1208c68bd0f6227bd1.png)\n\nFirst, we find the components of $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =q-p \\\\  & =⟨1,3,2⟩-⟨2,1,2⟩ \\\\  & =⟨-1,2,0⟩ \\\\ \\overset{\\to }{PR} & =r-p \\\\  & =⟨4,5,-2⟩-⟨2,1,2⟩ \\\\  & =⟨2,4,-4⟩.\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{PQ}\\cdot \\overset{\\to }{PR}}{|\\overset{\\to }{PQ}||\\overset{\\to }{PR}|} \\\\  & =\\frac{(-1)\\cdot 2+2\\cdot 4+0\\cdot (-4)}{\\sqrt{(-1)^{2}+{2}^{2}+{0}^{2}}\\sqrt{{2}^{2}+{4}^{2}+(-4)^{2}}} \\\\  & =\\frac{6}{\\sqrt{5}\\cdot \\sqrt{36}} \\\\  & =\\frac{6}{6\\sqrt{5}} \\\\  & =\\frac{\\sqrt{5}}{5}\\,.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{\\sqrt{5}}{5})≈{63}^{∘}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-69831" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/activity-metadata.json" "file_sha256" "69439c99388ed4f03cb7c64633545f69bd84ad1aacf06d4f3cc7b3d16b3e60a7"} {"question" "q-69831" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-69831" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{27}^{∘}"] ["math" "{57}^{∘}"] ["math" "{63}^{∘}"] ["math" "{88}^{∘}"] ["math" "{90}^{∘}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-69831" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{63}^{∘}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-69833" "field" nil "attribute" "question/problem" "value" "Find $∠XZY$ given the points $X(-1,0,3)$, $Y(-2,2,3)$, and $Z(-2,-1,3).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-69833" "field" nil "attribute" "question/worked-solution" "value" "Note that the position vectors of the points $X$, $Y$, $Z$ are\n\n$$\n\\begin{aligned}x=⟨-1,0,3⟩,\\,y=⟨-2,2,3⟩,\\,z=⟨-2,-1,3⟩.\\end{aligned}\n$$\n\nThe $△XYZ$ is shown (schematically) in the diagram below, where we denote $∠XZY=\\theta .$ \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/assets/87453fecb9da6b9e673ab5a85a289a3fac73f4fb90fc8f1b33e7c0a80b1ea77f.png)\n\nFirst, we find the components of $\\overset{\\to }{ZX}$ and $\\overset{\\to }{ZY}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{ZX} & =x-z \\\\  & =⟨-1,0,3⟩-⟨-2,-1,3⟩ \\\\  & =⟨1,1,0⟩ \\\\ \\overset{\\to }{ZY} & =y-z \\\\  & =⟨-2,2,3⟩-⟨-2,-1,3⟩ \\\\  & =⟨0,3,0⟩\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overset{\\to }{ZX}$ and $\\overset{\\to }{ZY}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{ZX}\\cdot \\overset{\\to }{ZY}}{|\\overset{\\to }{ZX}||\\overset{\\to }{ZY}|} \\\\  & =\\frac{1\\cdot 0+1\\cdot 3+0\\cdot 0}{\\sqrt{{1}^{2}+{1}^{2}+{0}^{2}}\\sqrt{{0}^{2}+{3}^{2}+{0}^{2}}} \\\\  & =\\frac{3}{\\sqrt{2}\\cdot \\sqrt{9}} \\\\  & =\\frac{1}{\\sqrt{2}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{1}{\\sqrt{2}})={45}^{∘}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-69833" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/activity-metadata.json" "file_sha256" "69439c99388ed4f03cb7c64633545f69bd84ad1aacf06d4f3cc7b3d16b3e60a7"} {"question" "q-69833" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-69833" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{120}^{∘}"] ["math" "{30}^{∘}"] ["math" "{45}^{∘}"] ["math" "{60}^{∘}"] ["math" "{90}^{∘}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-69833" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{45}^{∘}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-124826" "field" nil "attribute" "question/problem" "value" "Find $∠XZY$ given the points $X(-2,1,0)$, $Y(-1,0,4)$, and $Z(-1,2,-2).$ Round your answer to the nearest degree." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-124826" "field" nil "attribute" "question/worked-solution" "value" "Note that the position vectors of the points $X$, $Y$, $Z$ are\n\n$$\n\\begin{aligned}x=⟨-2,1,0⟩,\\,y=⟨-1,0,4⟩,\\,z=⟨-1,2,-2⟩.\\end{aligned}\n$$\n\nThe $△XYZ$ is shown (schematically) in the diagram below, where we denote $∠XZY=\\theta .$ \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/assets/87453fecb9da6b9e673ab5a85a289a3fac73f4fb90fc8f1b33e7c0a80b1ea77f.png)\n\nFirst, we find the components of $\\overset{\\to }{ZX}$ and $\\overset{\\to }{ZY}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{ZX} & =x-z \\\\  & =⟨-2,1,0⟩-⟨-1,2,-2⟩ \\\\  & =⟨-1,-1,2⟩ \\\\ \\overset{\\to }{ZY} & =y-z \\\\  & =⟨-1,0,4⟩-⟨-1,2,-2⟩ \\\\  & =⟨0,-2,6⟩\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overset{\\to }{ZX}$ and $\\overset{\\to }{ZY}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{ZX}\\cdot \\overset{\\to }{ZY}}{|\\overset{\\to }{ZX}||\\overset{\\to }{ZY}|} \\\\  & =\\frac{(-1)\\cdot 0+(-1)\\cdot (-2)+2\\cdot 6}{\\sqrt{(-1)^{2}+(-1)^{2}+{2}^{2}}\\sqrt{{0}^{2}+(-2)^{2}+{6}^{2}}} \\\\  & =\\frac{14}{\\sqrt{6}\\cdot \\sqrt{40}} \\\\  & =\\frac{14}{\\sqrt{240}} \\\\  & =\\frac{14}{4\\sqrt{15}} \\\\  & =\\frac{7}{2\\sqrt{15}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{7}{2\\sqrt{15}})={25}^{∘}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-124826" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/activity-metadata.json" "file_sha256" "69439c99388ed4f03cb7c64633545f69bd84ad1aacf06d4f3cc7b3d16b3e60a7"} {"question" "q-124826" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-124826" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{21}^{∘}"] ["math" "{23}^{∘}"] ["math" "{25}^{∘}"] ["math" "{28}^{∘}"] ["math" "{30}^{∘}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-124826" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{25}^{∘}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-19119" "field" nil "attribute" "question/problem" "value" "Consider the points $D(1,3,2)$, $E(t,2,4)$ and $F(3,t,3).$ Find $∠EDF$ given that $\\overset{\\to }{DE}\\cdot \\overset{\\to }{DF}=2.$ Round your answer to $2$ decimal places." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-19119" "field" nil "attribute" "question/worked-solution" "value" "Note that the position vectors of the points $D$, $E$, $F$ are\n\n$$\n\\begin{aligned}d=⟨1,\\,3,\\,2⟩,\\,e=⟨t,\\,2,\\,4⟩,\\,f=⟨3,\\,t,\\,3⟩.\\end{aligned}\n$$\n\nThe triangle $△DEF$ is shown (schematically) in the diagram below, where we denote $∠EDF=\\theta .$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/assets/c9cfb3e84e6f76d243125f2a09246b2a1300a0134e71359bb2b528082f064f93.png)\n\nFirst, we find the components of $\\overset{\\to }{DE}$ and $\\overset{\\to }{DF}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{DE} & =e-d \\\\  & =⟨t,\\,2,\\,4⟩-⟨1,\\,3,\\,2⟩ \\\\  & =⟨t-1,\\,-1,\\,2⟩ \\\\ \\overset{\\to }{DF} & =f-d \\\\  & =⟨3,\\,t,\\,3⟩-⟨1,\\,3,\\,2⟩ \\\\  & =⟨2,\\,t-3,\\,1⟩\\end{aligned}\n$$\n\nNow, since $\\overset{\\to }{DE}\\cdot \\overset{\\to }{DF}=2$, we can solve for $t$, as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{DE}\\cdot \\overset{\\to }{DF} & =2 \\\\ (t-1)\\cdot 2+(-1)\\cdot (t-3)+2\\cdot 1 & =2 \\\\ 2t-2-t+3+2 & =2 \\\\ t & =-1\\end{aligned}\n$$\n\nSo, \n\n$$\n\\begin{aligned}\\overset{\\to }{DE} & =⟨-1-1,-1,2⟩ \\\\  & =⟨-2,-1,2⟩, \\\\ \\overset{\\to }{DF} & =⟨2,-1-3,1⟩ \\\\  & =⟨2,-4,1⟩.\\end{aligned}\n$$\n\nNext, the cosine of the angle between $\\overset{\\to }{DE}$ and $\\overset{\\to }{DF}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{DE}\\cdot \\overset{\\to }{DF}}{|\\overset{\\to }{DE}||\\overset{\\to }{DF}|} \\\\  & =\\frac{2}{\\sqrt{(-2)^{2}+(-1)^{2}+{2}^{2}}\\sqrt{{2}^{2}+(-4)^{2}+{1}^{2}}} \\\\  & =\\frac{2}{\\sqrt{9}\\cdot \\sqrt{21}} \\\\  & =\\frac{2}{3\\sqrt{21}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{2}{3\\sqrt{21}})≈{81.64}^{∘}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-19119" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/activity-metadata.json" "file_sha256" "69439c99388ed4f03cb7c64633545f69bd84ad1aacf06d4f3cc7b3d16b3e60a7"} {"question" "q-19119" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-19119" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{52.15}^{∘}"] ["math" "{67.48}^{∘}"] ["math" "{81.64}^{∘}"] ["math" "{88.29}^{∘}"] ["math" "{93.32}^{∘}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-19119" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{81.64}^{∘}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-19032" "field" nil "attribute" "question/problem" "value" "Given that $c\\cdot d=11$, find the angle between $c=⟨2t,1⟩$ and $d=⟨2,3⟩.$ Round your answer to $2$ decimal places." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-19032" "field" nil "attribute" "question/worked-solution" "value" "First, since $c\\cdot d=11$, we can solve for $t$, as follows:\n\n$$\n\\begin{aligned}c\\cdot d & =11 \\\\ 2t\\cdot 2+1\\cdot 3 & =11 \\\\ 4t+3 & =11 \\\\ 4t & =8 \\\\ t & =2\\end{aligned}\n$$\n\nSo,\n\n$$\n\\begin{aligned}c & =⟨2(2),1⟩ \\\\  & =⟨4,1⟩.\\end{aligned}\n$$\n\nNow, the cosine of the angle between $c$ and $d$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{c\\cdot d}{|\\,c\\,||\\,d\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}}{\\sqrt{{c}_{x}^{2}+{c}_{y}^{2}}\\sqrt{{d}_{x}^{2}+{d}_{y}^{2}}} \\\\  & =\\frac{11}{\\sqrt{{4}^{2}+{1}^{2}}\\sqrt{{2}^{2}+{3}^{2}}} \\\\  & =\\frac{11}{\\sqrt{17}\\cdot \\sqrt{13}} \\\\  & =\\frac{11}{\\sqrt{221}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{11}{\\sqrt{221}})≈{42.27}^{∘}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-19032" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/activity-metadata.json" "file_sha256" "69439c99388ed4f03cb7c64633545f69bd84ad1aacf06d4f3cc7b3d16b3e60a7"} {"question" "q-19032" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-19032" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{33.74}^{∘}"] ["math" "{37.75}^{∘}"] ["math" "{42.27}^{∘}"] ["math" "{46.18}^{∘}"] ["math" "{52.33}^{∘}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-19032" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{42.27}^{∘}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-77164" "field" nil "attribute" "question/problem" "value" "Consider the points $A(3t,t,4),$ $B(3t,4t,3)$ and $C(5t,t+1,5).$ Find $∠BAC$ given that $\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}=2.$ Round your answer to the nearest degree." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-77164" "field" nil "attribute" "question/worked-solution" "value" "Note that the position vectors of the points $A,$ $B$ and $C$ are\n\n$$\n\\begin{aligned}a=⟨3t,\\,t,\\,4⟩,\\,b=⟨3t,\\,4t,\\,3⟩,\\,c=⟨5t,\\,t+1,\\,5⟩.\\end{aligned}\n$$\n\nThe triangle $△ABC$ is shown (schematically) in the diagram below, where we denote $∠BAC=\\theta .$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/assets/285b8343208079181ac6036cf9ca16abc974d59b9262878ed40c0da9af5683d0.png)\n\nFirst, we find the components of $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =⟨3t,\\,4t,\\,3⟩-⟨3t,\\,t,\\,4⟩ \\\\  & =⟨0,\\,3t,\\,-1⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =⟨5t,\\,t+1,\\,5⟩-⟨3t,\\,t,\\,4⟩ \\\\  & =⟨2t,\\,1,\\,1⟩\\end{aligned}\n$$\n\nNow, since $\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}=2$, we can solve for $t,$ as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC} & =2 \\\\ 0\\cdot 2t+3t\\cdot 1+(-1)\\cdot 1 & =2 \\\\ 3t-1 & =2 \\\\ 3t & =3 \\\\ t & =1\\end{aligned}\n$$\n\nSo, \n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =⟨0,3,-1⟩, \\\\ \\overset{\\to }{AC} & =⟨2,\\,1,\\,1⟩.\\end{aligned}\n$$\n\nNext, the cosine of the angle between $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}}{|\\overset{\\to }{AB}||\\overset{\\to }{AC}|} \\\\  & =\\frac{2}{\\sqrt{{0}^{2}+{3}^{2}+(-1)^{2}}\\cdot \\sqrt{{2}^{2}+{1}^{2}+{1}^{2}}} \\\\  & =\\frac{2}{\\sqrt{10}\\cdot \\sqrt{6}} \\\\  & =\\frac{2}{2\\sqrt{15}} \\\\  & =\\frac{1}{\\sqrt{15}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{1}{\\sqrt{15}})≈{75}^{∘}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-77164" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/activity-metadata.json" "file_sha256" "69439c99388ed4f03cb7c64633545f69bd84ad1aacf06d4f3cc7b3d16b3e60a7"} {"question" "q-77164" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-77164" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{58}^{∘}"] ["math" "{65}^{∘}"] ["math" "{75}^{∘}"] ["math" "{79}^{∘}"] ["math" "{82}^{∘}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-77164" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{75}^{∘}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-101512" "field" nil "attribute" "question/problem" "value" "Given that $a\\cdot b=-5$, find the angle between $a=⟨2t,t⟩$ and $b=⟨1,3⟩.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-101512" "field" nil "attribute" "question/worked-solution" "value" "First, since $a\\cdot b=-5$, we can solve for $t$, as follows:\n\n$$\n\\begin{aligned}a\\cdot b & =-5 \\\\ 2t\\cdot 1+t\\cdot 3 & =-5 \\\\ 2t+3t & =-5 \\\\ 5t & =-5 \\\\ t & =-1\\end{aligned}\n$$\n\nSo, \n\n$$\n\\begin{aligned}a & =⟨2(-1),\\,(-1)⟩ \\\\  & =⟨-2,-1⟩.\\end{aligned}\n$$\n\nNow, the cosine of the angle between $a$ and $b$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{a\\cdot b}{|\\,a\\,||\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}}\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}}} \\\\  & =\\frac{-5}{\\sqrt{(-2)^{2}+(-1)^{2}}\\sqrt{{1}^{2}+{3}^{2}}} \\\\  & =-\\frac{5}{\\sqrt{5}\\cdot \\sqrt{10}} \\\\  & =-\\frac{5}{5\\sqrt{2}} \\\\  & =-\\frac{1}{\\sqrt{2}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(-\\frac{1}{\\sqrt{2}})={135}^{∘}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-101512" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/activity-metadata.json" "file_sha256" "69439c99388ed4f03cb7c64633545f69bd84ad1aacf06d4f3cc7b3d16b3e60a7"} {"question" "q-101512" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-101512" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{120}^{∘}"] ["math" "{135}^{∘}"] ["math" "{150}^{∘}"] ["math" "{180}^{∘}"] ["math" "{90}^{∘}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-101512" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{135}^{∘}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-101515" "field" nil "attribute" "question/problem" "value" "Given that $p\\cdot q=11$, find the angle between $p=⟨t,t-1⟩$ and $q=⟨-4,-1⟩.$ Round your answer to $1$ decimal place." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-101515" "field" nil "attribute" "question/worked-solution" "value" "First, since $p\\cdot q=11$, we can solve for $t$, as follows:\n\n$$\n\\begin{aligned}p\\cdot q & =11 \\\\ t\\cdot (-4)+(t-1)\\cdot (-1) & =11 \\\\ -4t-t+1 & =11 \\\\ -5t & =10 \\\\ t & =-2\\end{aligned}\n$$\n\nSo, \n\n$$\n\\begin{aligned}p & =⟨(-2),(-2)-1⟩ \\\\  & =⟨-2,-3⟩.\\end{aligned}\n$$\n\nNow, the cosine of the angle between $p$ and $q$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{p\\cdot q}{|\\,p\\,||\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}}{\\sqrt{{p}_{x}^{2}+{p}_{y}^{2}}\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}}} \\\\  & =\\frac{11}{\\sqrt{(-2)^{2}+(-3)^{2}}\\sqrt{(-4)^{2}+(-1)^{2}}} \\\\  & =\\frac{11}{\\sqrt{13}\\cdot \\sqrt{17}} \\\\  & =\\frac{11}{\\sqrt{221}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{11}{\\sqrt{221}})≈{42.3}^{∘}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-101515" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/activity-metadata.json" "file_sha256" "69439c99388ed4f03cb7c64633545f69bd84ad1aacf06d4f3cc7b3d16b3e60a7"} {"question" "q-101515" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-101515" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{39.9}^{∘}"] ["math" "{40.5}^{∘}"] ["math" "{42.3}^{∘}"] ["math" "{44.4}^{∘}"] ["math" "{45.1}^{∘}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "q-101515" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{42.3}^{∘}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/state.json" "file_sha256" "8b7539a42230fed6e2d9ff5ed5cf1cf5b9909132f751d2f82feeade76ad8478f"} {"question" "e-4327" "field" nil "attribute" "question/problem" "value" "Find the angle between $\\mathbf{a}=\\langle 2,-1,1 \\rangle$ and $\\mathbf{b}=\\langle 1,5,-2 \\rangle$. Round your answer to $1$ decimal place." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/example-4327.json" "file_sha256" "cc39824eb1f8f5dfd4b9aae813a9c14b52bdbbd3fb365e6799d56d7be79ea447"} {"question" "e-4327" "field" nil "attribute" "question/worked-solution" "value" "Rearranging the dot product formula, we have:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{a\\cdot b}{|\\,a\\,||\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{2\\cdot 1+(-1)\\cdot 5+1\\cdot (-2)}{\\sqrt{{2}^{2}+(-1)^{2}+{1}^{2}}\\sqrt{{1}^{2}+{5}^{2}+(-2)^{2}}} \\\\  & =\\frac{-5}{\\sqrt{6}\\cdot \\sqrt{30}} \\\\  & =\\frac{-5}{\\sqrt{6}\\cdot \\sqrt{6}\\cdot \\sqrt{5}} \\\\  & =-\\frac{\\sqrt{5}}{6}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta = \\arccos \\left( -\\dfrac{\\sqrt{5}}{6} \\right) \\approx 111.9^\\circ.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/example-4327.json" "file_sha256" "cc39824eb1f8f5dfd4b9aae813a9c14b52bdbbd3fb365e6799d56d7be79ea447"} {"question" "e-4328" "field" nil "attribute" "question/problem" "value" "Find $\\angle BAC$ given the points $A(2,-1,-5)$, $B(-1,0,-4)$, and $C(5,1,1).$ Round your answer to $1$ decimal place." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/example-4328.json" "file_sha256" "3ce1a920424352f4fd8b6fb57a410a42fe5c6358bb046b1fd573e7bdda735459"} {"question" "e-4328" "field" nil "attribute" "question/worked-solution" "value" "Note that the position vectors of the points $A$, $B$, $C$ are\n\n$$\n\\begin{aligned}a=⟨2,-1,-5⟩,\\,b=⟨-1,0,-4⟩,\\,c=⟨5,1,1⟩.\\end{aligned}\n$$\n\nThe triangle $\\triangle ABC$ is shown (schematically) in the diagram below, where we denote $\\angle BAC = \\theta.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/assets/285b8343208079181ac6036cf9ca16abc974d59b9262878ed40c0da9af5683d0.png)\n\nFirst, we find the components of $\\overrightarrow{AB}$ and $\\overrightarrow{AC}\\mathbin{:}$\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =⟨-1,0,-4⟩-⟨2,-1,-5⟩ \\\\  & =⟨-3,1,1⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =⟨5,1,1⟩-⟨2,-1,-5⟩ \\\\  & =⟨3,2,6⟩\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overrightarrow{AB}$ and $\\overrightarrow{AC}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}}{|\\overset{\\to }{AB}||\\overset{\\to }{AC}|} \\\\  & =\\frac{-3\\cdot 3+1\\cdot 2+1\\cdot 6}{\\sqrt{(-3)^{2}+{1}^{2}+{1}^{2}}\\sqrt{{3}^{2}+{2}^{2}+{6}^{2}}} \\\\  & =\\frac{-1}{\\sqrt{11}\\sqrt{49}} \\\\  & =-\\frac{1}{7\\sqrt{11}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta = \\arccos \\left( -\\dfrac{1}{7\\sqrt{11}} \\right) \\approx 92.5^\\circ.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/example-4328.json" "file_sha256" "3ce1a920424352f4fd8b6fb57a410a42fe5c6358bb046b1fd573e7bdda735459"} {"question" "e-5112" "field" nil "attribute" "question/problem" "value" "Given that $\\mathbf{a}\\cdot \\mathbf{b}=-4$, find the angle between $\\mathbf{a}=\\langle t, \\, -2 \\rangle$ and $\\mathbf{b}=\\langle 6, \\, t \\rangle$. Round your answer to $1$ decimal place." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/example-5112.json" "file_sha256" "588ad10bbe53a200b9b9c9ecdd14406089740f2d09bfee84ff5a4621f9287593"} {"question" "e-5112" "field" nil "attribute" "question/worked-solution" "value" "First, since $\\mathbf{a}\\cdot \\mathbf{b}=-4$, we can solve for $t$, as follows:\n\n$$\n\\begin{aligned}a\\cdot b & =-4 \\\\ t\\cdot 6+(-2)\\cdot t & =-4 \\\\ 6t-2t & =-4 \\\\ 4t & =-4 \\\\ t & =-1\\end{aligned}\n$$\n\nSo, \n\n$$\n\\begin{aligned}a=⟨-1,-2⟩,\\,b=⟨6,-1⟩.\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\mathbf{a}$ and $\\mathbf{b}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{a\\cdot b}{|\\,a\\,||\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}}\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}}} \\\\  & =\\frac{-4}{\\sqrt{(-1)^{2}+(-2)^{2}}\\cdot \\sqrt{{6}^{2}+(-1)^{2}}} \\\\  & =-\\frac{4}{\\sqrt{5}\\cdot \\sqrt{37}} \\\\  & =-\\frac{4}{\\sqrt{185}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta = \\arccos \\left( -\\dfrac{4}{\\sqrt{185}} \\right) \\approx 107.1^\\circ.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045824/example-5112.json" "file_sha256" "588ad10bbe53a200b9b9c9ecdd14406089740f2d09bfee84ff5a4621f9287593"}] "usage" {"q-101511" [] "e-4327" [] "e-5112" [] "q-19037" [] "q-19027" [] "q-69831" [] "q-124826" [] "e-4328" [] "q-69833" [] "q-101512" [] "q-77164" []} "basis" 1678 "retractions" [[17592186269073 :question/worked-solution "Note that the position vectors of the points $A$, $B$, $C$ are\n\n$$\n\\begin{aligned}a=⟨2,-1,1⟩,\\,b=⟨3,1,-2⟩,\\,c=⟨-1,1,1⟩.\\end{aligned}\n$$\n\nThe triangle $△ABC$ is shown (schematically) in the diagram below, where we denote $∠BAC=\\theta .$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/assets/285b8343208079181ac6036cf9ca16abc974d59b9262878ed40c0da9af5683d0.png)\n\nFirst, we find the components of $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =⟨3,1,-2⟩-⟨2,-1,1⟩ \\\\  & =⟨1,2,-3⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =⟨-1,1,1⟩-⟨2,-1,1⟩ \\\\  & =⟨-3,2,0⟩.\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}}{|\\overset{\\to }{AB}||\\overset{\\to }{AC}|} \\\\  & =\\frac{1\\cdot (-3)+2\\cdot 2+(-3)\\cdot 0}{\\sqrt{{1}^{2}+{2}^{2}+(-3)^{2}}\\sqrt{(-3)^{2}+{2}^{2}+{0}^{2}}} \\\\  & =\\frac{1}{\\sqrt{14}\\cdot \\sqrt{13}} \\\\  & =\\frac{1}{\\sqrt{182}}.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{1}{\\sqrt{182}})≈{86}^{∘}.\n$$"] [17592186269136 :question/worked-solution "Note that the position vectors of the points $P$, $Q$, $R$ are\n\n$$\n\\begin{aligned}p=⟨2,1,2⟩,\\,q=⟨1,3,2⟩,\\,r=⟨4,5,-2⟩.\\end{aligned}\n$$\n\nThe triangle $△PQR$ is shown (schematically) in the diagram below, where we denote $∠QPR=\\theta .$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13964292/assets/3003f0cb329a8f8ef9bc315c70df4773ac1f0c54843dea1208c68bd0f6227bd1.png)\n\nFirst, we find the components of $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =q-p \\\\  & =⟨1,3,2⟩-⟨2,1,2⟩ \\\\  & =⟨-1,2,0⟩ \\\\ \\overset{\\to }{PR} & =r-p \\\\  & =⟨4,5,-2⟩-⟨2,1,2⟩ \\\\  & =⟨2,4,-4⟩.\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{PQ}\\cdot \\overset{\\to }{PR}}{|\\overset{\\to }{PQ}||\\overset{\\to }{PR}|} \\\\  & =\\frac{(-1)\\cdot 2+2\\cdot 4+0\\cdot (-4)}{\\sqrt{(-1)^{2}+{2}^{2}+{0}^{2}}\\sqrt{{2}^{2}+{4}^{2}+(-4)^{2}}} \\\\  & =\\frac{6}{\\sqrt{5}\\cdot \\sqrt{36}} \\\\  & =\\frac{6}{6\\sqrt{5}} \\\\  & =\\frac{\\sqrt{5}}{5}\\,.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{\\sqrt{5}}{5})≈{63}^{∘}.\n$$"] [17592186299818 :question/worked-solution "Note that the position vectors of the points $X$, $Y$, $Z$ are\n\n$$\n\\begin{aligned}x=⟨-1,0,3⟩,\\,y=⟨-2,2,3⟩,\\,z=⟨-2,-1,3⟩.\\end{aligned}\n$$\n\nThe $△XYZ$ is shown (schematically) in the diagram below, where we denote $∠XZY=\\theta .$ \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038738/assets/87453fecb9da6b9e673ab5a85a289a3fac73f4fb90fc8f1b33e7c0a80b1ea77f.png)\n\nFirst, we find the components of $\\overset{\\to }{ZX}$ and $\\overset{\\to }{ZY}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{ZX} & =x-z \\\\  & =⟨-1,0,3⟩-⟨-2,-1,3⟩ \\\\  & =⟨1,1,0⟩ \\\\ \\overset{\\to }{ZY} & =y-z \\\\  & =⟨-2,2,3⟩-⟨-2,-1,3⟩ \\\\  & =⟨0,3,0⟩\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overset{\\to }{ZX}$ and $\\overset{\\to }{ZY}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{ZX}\\cdot \\overset{\\to }{ZY}}{|\\overset{\\to }{ZX}||\\overset{\\to }{ZY}|} \\\\  & =\\frac{1\\cdot 0+1\\cdot 3+0\\cdot 0}{\\sqrt{{1}^{2}+{1}^{2}+{0}^{2}}\\sqrt{{0}^{2}+{3}^{2}+{0}^{2}}} \\\\  & =\\frac{3}{\\sqrt{2}\\cdot \\sqrt{9}} \\\\  & =\\frac{1}{\\sqrt{2}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{1}{\\sqrt{2}})={45}^{∘}.\n$$"] [17592186305587 :question/worked-solution "Note that the position vectors of the points $X$, $Y$, $Z$ are\n\n$$\n\\begin{aligned}x=⟨-2,1,0⟩,\\,y=⟨-1,0,4⟩,\\,z=⟨-1,2,-2⟩.\\end{aligned}\n$$\n\nThe $△XYZ$ is shown (schematically) in the diagram below, where we denote $∠XZY=\\theta .$ \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/assets/87453fecb9da6b9e673ab5a85a289a3fac73f4fb90fc8f1b33e7c0a80b1ea77f.png)\n\nFirst, we find the components of $\\overset{\\to }{ZX}$ and $\\overset{\\to }{ZY}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{ZX} & =x-z \\\\  & =⟨-2,1,0⟩-⟨-1,2,-2⟩ \\\\  & =⟨-1,-1,2⟩ \\\\ \\overset{\\to }{ZY} & =y-z \\\\  & =⟨-1,0,4⟩-⟨-1,2,-2⟩ \\\\  & =⟨0,-2,6⟩\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overset{\\to }{ZX}$ and $\\overset{\\to }{ZY}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{ZX}\\cdot \\overset{\\to }{ZY}}{|\\overset{\\to }{ZX}||\\overset{\\to }{ZY}|} \\\\  & =\\frac{(-1)\\cdot 0+(-1)\\cdot (-2)+2\\cdot 6}{\\sqrt{(-1)^{2}+(-1)^{2}+{2}^{2}}\\sqrt{{0}^{2}+(-2)^{2}+{6}^{2}}} \\\\  & =\\frac{14}{\\sqrt{6}\\cdot \\sqrt{40}} \\\\  & =\\frac{14}{\\sqrt{240}} \\\\  & =\\frac{14}{4\\sqrt{15}} \\\\  & =\\frac{7}{2\\sqrt{15}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{7}{2\\sqrt{15}})={25}^{∘}.\n$$"] [17592186269150 :question/worked-solution "Note that the position vectors of the points $A,$ $B$ and $C$ are\n\n$$\n\\begin{aligned}a=⟨3t,\\,t,\\,4⟩,\\,b=⟨3t,\\,4t,\\,3⟩,\\,c=⟨5t,\\,t+1,\\,5⟩.\\end{aligned}\n$$\n\nThe triangle $△ABC$ is shown (schematically) in the diagram below, where we denote $∠BAC=\\theta .$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/assets/285b8343208079181ac6036cf9ca16abc974d59b9262878ed40c0da9af5683d0.png)\n\nFirst, we find the components of $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =⟨3t,\\,4t,\\,3⟩-⟨3t,\\,t,\\,4⟩ \\\\  & =⟨0,\\,3t,\\,-1⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =⟨5t,\\,t+1,\\,5⟩-⟨3t,\\,t,\\,4⟩ \\\\  & =⟨2t,\\,1,\\,1⟩\\end{aligned}\n$$\n\nNow, since $\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}=2$, we can solve for $t,$ as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC} & =2 \\\\ 0\\cdot 2t+3t\\cdot 1+(-1)\\cdot 1 & =2 \\\\ 3t-1 & =2 \\\\ 3t & =3 \\\\ t & =1\\end{aligned}\n$$\n\nSo, \n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =⟨0,3,-1⟩, \\\\ \\overset{\\to }{AC} & =⟨2,\\,1,\\,1⟩.\\end{aligned}\n$$\n\nNext, the cosine of the angle between $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}}{|\\overset{\\to }{AB}||\\overset{\\to }{AC}|} \\\\  & =\\frac{2}{\\sqrt{{0}^{2}+{3}^{2}+(-1)^{2}}\\cdot \\sqrt{{2}^{2}+{1}^{2}+{1}^{2}}} \\\\  & =\\frac{2}{\\sqrt{10}\\cdot \\sqrt{6}} \\\\  & =\\frac{2}{2\\sqrt{15}} \\\\  & =\\frac{1}{\\sqrt{15}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{1}{\\sqrt{15}})≈{75}^{∘}.\n$$"] [17592186105512 :question/worked-solution "Note that the position vectors of the points $A$, $B$, $C$ are\n\n$$\n\\begin{aligned}a=⟨2,-1,-5⟩,\\,b=⟨-1,0,-4⟩,\\,c=⟨5,1,1⟩.\\end{aligned}\n$$\n\nThe triangle $\\triangle ABC$ is shown (schematically) in the diagram below, where we denote $\\angle BAC = \\theta.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/assets/285b8343208079181ac6036cf9ca16abc974d59b9262878ed40c0da9af5683d0.png)\n\nFirst, we find the components of $\\overrightarrow{AB}$ and $\\overrightarrow{AC}\\mathbin{:}$\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =⟨-1,0,-4⟩-⟨2,-1,-5⟩ \\\\  & =⟨-3,1,1⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =⟨5,1,1⟩-⟨2,-1,-5⟩ \\\\  & =⟨3,2,6⟩\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overrightarrow{AB}$ and $\\overrightarrow{AC}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}}{|\\overset{\\to }{AB}||\\overset{\\to }{AC}|} \\\\  & =\\frac{-3\\cdot 3+1\\cdot 2+1\\cdot 6}{\\sqrt{(-3)^{2}+{1}^{2}+{1}^{2}}\\sqrt{{3}^{2}+{2}^{2}+{6}^{2}}} \\\\  & =\\frac{-1}{\\sqrt{11}\\sqrt{49}} \\\\  & =-\\frac{1}{7\\sqrt{11}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta = \\arccos \\left( -\\dfrac{1}{7\\sqrt{11}} \\right) \\approx 92.5^\\circ.\n$$"]] "immutable_answers" [17592186269075 17592186269076 17592186269077 17592186269078 17592186269079 17592186269103 17592186269104 17592186269105 17592186269106 17592186269107 17592186269117 17592186269118 17592186269119 17592186269120 17592186269121 17592186269138 17592186269139 17592186269140 17592186269141 17592186269142 17592186269152 17592186269153 17592186269154 17592186269155 17592186269156 17592186299820 17592186299821 17592186299822 17592186299823 17592186299824 17592186305575 17592186305576 17592186305577 17592186305578 17592186305579 17592186305589 17592186305590 17592186305591 17592186305592 17592186305593] "immutable_fields" [[17592186269074 :answer-field/correct] [17592186269074 :answer-field/id] [17592186269074 :answer-field/key] [17592186269074 :answer