b/ensure [:answer-field/validate]} {:db/id "q-81137" :question/id #uuid "56109c7e-b321-5b60-9876-29d7ab35ea70" :question/math-academy-id "q-81137" :question/problem "Given the orthogonal basis $B$ of ${R}^{2}$ and the vector $x$ below, find the value of $30{x}_{1},$ where ${x}_{1}$ is the first component of $[x]_{B}.$\n\n$$\nB={[\\begin{aligned}1 \\\\ 2\\end{aligned}],[\\begin{aligned}-8 \\\\ 4\\end{aligned}]},\\,x=[\\begin{aligned}-3 \\\\ 2\\end{aligned}]\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2}.$ \n\nSince $B$ is an orthogonal basis, we have that $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$, where ${x}_{i}=\\frac{x\\cdot {q}_{i}}{{q}_{i}\\cdot {q}_{i}}.$ Computing ${x}_{1},$ we obtain \n\n$$\n\\begin{aligned}{x}_{1} & =\\frac{x\\cdot {q}_{1}}{{q}_{1}\\cdot {q}_{1}} \\\\  & =\\frac{-3\\cdot 1+2\\cdot 2}{{1}^{2}+{2}^{2}} \\\\  & =\\frac{-3+4}{5} \\\\  & =\\frac{1}{5}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n30{x}_{1}=30\\cdot \\frac{1}{5}=6.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-81137/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "15b92bed-c97f-5b87-9811-fbfc5c03314d"] :knowledge-point/questions ["q-81137"] :db/ensure [:knowledge-point/validate]} {:db/id "q-102341/selection/5d022a88a643e97abec4d01dfce48411101475c0705a98f29f3a8e3560fb0616" :answer/id #uuid "61b891fa-f463-5aae-8ea5-5ce62abd6936" :answer/type :answer.type/math :answer/value "-10" :db/ensure [:answer/validate]} {:db/id "q-102341/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "333d2333-6ed0-562c-a061-f7ddbe06f13c" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-102341/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer/id #uuid "705a0be6-2679-5da0-9c97-3725575859e7" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "q-102341/selection/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c" :answer/id #uuid "3a5810cd-95de-5c5f-b082-7bf82d04eace" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "q-102341/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45" :answer/id #uuid "da5b31a2-80f9-5dc0-8aea-ca59d751105d" :answer/type :answer.type/math :answer/value "-12" :db/ensure [:answer/validate]} {:db/id "q-102341/selection" :answer-field/id #uuid "23a77b6e-39ae-5cd9-9613-760704a65107" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-102341/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45" :answer-field/choices ["q-102341/selection/5d022a88a643e97abec4d01dfce48411101475c0705a98f29f3a8e3560fb0616" "q-102341/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" "q-102341/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" "q-102341/selection/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c" "q-102341/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45"] :db/ensure [:answer-field/validate]} {:db/id "q-102341" :question/id #uuid "ff9815f5-68cc-5b46-8c06-f6cff798eab0" :question/math-academy-id "q-102341" :question/problem "Given the orthogonal basis $B$ of ${R}^{2}$ and the vector $x$ below, find the value of $4{x}_{2},$ where ${x}_{2}$ is the second component of $[x]_{B}.$\n\n$$\nB={[\\begin{aligned}8 \\\\ 10\\end{aligned}],[\\begin{aligned}-5 \\\\ 4\\end{aligned}]},\\,x=[\\begin{aligned}15 \\\\ -12\\end{aligned}]\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2}.$ \n\nSince $B$ is an orthogonal basis, we have that $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$, where ${x}_{i}=\\frac{x\\cdot {q}_{i}}{{q}_{i}\\cdot {q}_{i}}.$ Computing ${x}_{1},$ we obtain \n\n$$\n\\begin{aligned}{x}_{2} & =\\frac{x\\cdot {q}_{2}}{{q}_{2}\\cdot {q}_{2}} \\\\  & =\\frac{15\\cdot (-5)+(-12)\\cdot 4}{(-5)^{2}+{4}^{2}} \\\\  & =\\frac{-75-48}{25+16} \\\\  & =-\\frac{123}{41} \\\\  & =-3.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n4{x}_{1}=4\\cdot (-3)=-12.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-102341/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "15b92bed-c97f-5b87-9811-fbfc5c03314d"] :knowledge-point/questions ["q-102341"] :db/ensure [:knowledge-point/validate]}]
