#{[{:db/id #edb/ref 17592186362107 :knowledge-point/_questions [{:knowledge-point/id #uuid "15b92bed-c97f-5b87-9811-fbfc5c03314d" :knowledge-point/title "Finding a Component of a Vector With Respect to a Given Orthogonal Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "705a0be6-2679-5da0-9c97-3725575859e7" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186362109} {:answer/id #uuid "333d2333-6ed0-562c-a061-f7ddbe06f13c" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186362110} {:answer/id #uuid "61b891fa-f463-5aae-8ea5-5ce62abd6936" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186362111} {:answer/id #uuid "3a5810cd-95de-5c5f-b082-7bf82d04eace" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186362112} {:answer/id #uuid "da5b31a2-80f9-5dc0-8aea-ca59d751105d" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186362113}] :answer-field/correct {:answer/id #uuid "da5b31a2-80f9-5dc0-8aea-ca59d751105d" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186362113} :answer-field/id #uuid "23a77b6e-39ae-5cd9-9613-760704a65107" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362108}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ff9815f5-68cc-5b46-8c06-f6cff798eab0" :question/math-academy-id "q-102341" :question/problem "Given the orthogonal basis $B$ of ${R}^{2}$ and the vector $x$ below, find the value of $4{x}_{2},$ where ${x}_{2}$ is the second component of $[x]_{B}.$\n\n$$\nB={[\\begin{aligned}8 \\\\ 10\\end{aligned}],[\\begin{aligned}-5 \\\\ 4\\end{aligned}]},\\,x=[\\begin{aligned}15 \\\\ -12\\end{aligned}]\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2}.$ \n\nSince $B$ is an orthogonal basis, we have that $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$, where ${x}_{i}=\\frac{x\\cdot {q}_{i}}{{q}_{i}\\cdot {q}_{i}}.$ Computing ${x}_{1},$ we obtain \n\n$$\n\\begin{aligned}{x}_{2} & =\\frac{x\\cdot {q}_{2}}{{q}_{2}\\cdot {q}_{2}} \\\\  & =\\frac{15\\cdot (-5)+(-12)\\cdot 4}{(-5)^{2}+{4}^{2}} \\\\  & =\\frac{-75-48}{25+16} \\\\  & =-\\frac{123}{41} \\\\  & =-3.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n4{x}_{1}=4\\cdot (-3)=-12.\n$$"}] [{:db/id #edb/ref 17592186157708 :knowledge-point/_questions [{:knowledge-point/id #uuid "39b12711-22c8-5cb7-bd61-e128734e7e6f" :knowledge-point/title "Calculating the Components of a Vector With Respect to a Given Orthonormal Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "841ea5ed-16e4-5e4a-99aa-f52e838a1628" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{11}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}}\\end{bmatrix}" :db/id #edb/ref 17592186155501} {:answer/id #uuid "c805fdab-6a65-5d18-b85b-608be6eb3927" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{11}{\\sqrt{10}} \\\\ -\\frac{3}{\\sqrt{10}}\\end{bmatrix}" :db/id #edb/ref 17592186155502} {:answer/id #uuid "dfae2a91-f1ba-581a-ad6a-a2fbc5a61707" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{13}{\\sqrt{10}} \\\\ -\\frac{1}{\\sqrt{10}}\\end{bmatrix}" :db/id #edb/ref 17592186155503} {:answer/id #uuid "480685a6-61d4-5e37-a63c-55f685b95c30" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{3}{\\sqrt{10}} \\\\ \\frac{11}{\\sqrt{10}}\\end{bmatrix}" :db/id #edb/ref 17592186155504} {:answer/id #uuid "6f575573-85a8-5bee-bc86-3bd3d9a64580" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{3}{\\sqrt{10}} \\\\ -\\frac{11}{\\sqrt{10}}\\end{bmatrix}" :db/id #edb/ref 17592186155505}] :answer-field/correct {:answer/id #uuid "c805fdab-6a65-5d18-b85b-608be6eb3927" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{11}{\\sqrt{10}} \\\\ -\\frac{3}{\\sqrt{10}}\\end{bmatrix}" :db/id #edb/ref 17592186155502} :answer-field/id #uuid "375b36d8-107e-5390-a3e9-77e310d16589" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186155500}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "824fadc8-cdf9-5224-b7eb-b17e3afd9cf8" :question/math-academy-id "q-39401" :question/problem "Given the **orthonormal** basis $B={[\\begin{aligned}\\frac{1}{\\sqrt{10}} \\\\ -\\frac{3}{\\sqrt{10}}\\end{aligned}],[\\begin{aligned}\\frac{3}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}}\\end{aligned}]}$ of ${R}^{2},$ find $[x]_{B}$ if $x=[\\begin{aligned}-2 \\\\ 3\\end{aligned}].$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2}.$ \n\nSince $B$ is an orthonormal basis, we have that $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$, where ${x}_{i}=x\\cdot {q}_{i}.$ Computing the components of $x,$ we get the following: \n\n$$\n\\begin{aligned}{x}_{1} & =[\\begin{aligned}-2 \\\\ 3\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{\\sqrt{10}} \\\\ -\\frac{3}{\\sqrt{10}}\\end{aligned}]=-\\frac{2}{\\sqrt{10}}-\\frac{9}{\\sqrt{10}}=-\\frac{11}{\\sqrt{10}} \\\\ {x}_{2} & =[\\begin{aligned}-2 \\\\ 3\\end{aligned}]\\cdot [\\begin{aligned}\\frac{3}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}}\\end{aligned}]=-\\frac{6}{\\sqrt{10}}+\\frac{3}{\\sqrt{10}}=-\\frac{3}{\\sqrt{10}}\\end{aligned}\n$$\n\nTherefore, we have \n\n$$\n[x]_{B}=[\\begin{aligned}-\\frac{11}{\\sqrt{10}} \\\\ -\\frac{3}{\\sqrt{10}}\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186362114 :knowledge-point/_questions [{:knowledge-point/id #uuid "39b12711-22c8-5cb7-bd61-e128734e7e6f" :knowledge-point/title "Calculating the Components of a Vector With Respect to a Given Orthonormal Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c44a129-4f2a-54db-b411-e4e8e45776ff" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{2}" :db/id #edb/ref 17592186362116} {:answer/id #uuid "bcfd9514-cac8-5ffa-b608-b4d24e82070f" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186362117} {:answer/id #uuid "2db211d0-365d-511a-9dd7-819b59f2dcda" :answer/type {:db/ident :answer.type/math} :answer/value "6\\sqrt{2}" :db/id #edb/ref 17592186362118} {:answer/id #uuid "69593fb5-7936-56ca-86e2-f32a8e096968" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186362119} {:answer/id #uuid "465b63f6-8ce7-515c-9858-3d5665444500" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186362120}] :answer-field/correct {:answer/id #uuid "bcfd9514-cac8-5ffa-b608-b4d24e82070f" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186362117} :answer-field/id #uuid "94719a91-9b3b-50fe-94ae-429886da0ed6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362115}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "900d61bc-c985-5a4a-bf86-703bef922f9d" :question/math-academy-id "q-40402" :question/problem "Given the **orthonormal** basis $B$ of ${R}^{3}$ and the vector $x$ below, find the value of $\\frac{{x}_{2}}{4}$, where ${x}_{2}$ is the second component of $[x]_{B}.$\n\n$$\nB={[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ 0 \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}],[\\begin{aligned}\\frac{1}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{3}} \\\\ -\\frac{1}{\\sqrt{3}}\\end{aligned}],[\\begin{aligned}-\\frac{1}{\\sqrt{6}} \\\\ \\frac{2}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{6}}\\end{aligned}]},\\,x=[\\begin{aligned}2\\sqrt{6} \\\\ 3\\sqrt{6} \\\\ \\sqrt{6}\\end{aligned}]\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2},\\,{q}_{3}.$ \n\nSince $B$ is an orthonormal basis, we have that $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]$, where ${x}_{i}=x\\cdot {q}_{i}.$ Computing ${x}_{2},$ we obtain\n\n$$\n\\begin{aligned}{x}_{2} & =x\\cdot {q}_{2} \\\\  & =[\\begin{aligned}2\\sqrt{6} \\\\ 3\\sqrt{6} \\\\ \\sqrt{6}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{3}} \\\\ -\\frac{1}{\\sqrt{3}}\\end{aligned}] \\\\  & =2\\sqrt{2}+3\\sqrt{2}-\\sqrt{2} \\\\  & =4\\sqrt{2}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\frac{{x}_{2}}{4}=\\frac{4\\sqrt{2}}{4}=\\sqrt{2}.\n$$"}] [{:db/id #edb/ref 17592186362121 :knowledge-point/_questions [{:knowledge-point/id #uuid "15b92bed-c97f-5b87-9811-fbfc5c03314d" :knowledge-point/title "Finding a Component of a Vector With Respect to a Given Orthogonal Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c6fe02e-fb01-5358-abb4-146f307d4eba" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{5}" :db/id #edb/ref 17592186362123} {:answer/id #uuid "59a29575-b2fb-52f4-8397-7296fb451439" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186362124} {:answer/id #uuid "ddd5c666-e267-57ca-aab1-54a5a2f8c64c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186362125} {:answer/id #uuid "3d52d185-9025-52a7-8f19-1ae7e89f776e" :answer/type {:db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186362126} {:answer/id #uuid "2d5ca909-6a46-540f-9712-a1665190b19f" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186362127}] :answer-field/correct {:answer/id #uuid "2d5ca909-6a46-540f-9712-a1665190b19f" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186362127} :answer-field/id #uuid "009181d9-d4e8-5b9a-851a-cb85e53ac25a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362122}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "635d95df-cb69-500d-9a34-b4738e046aa2" :question/math-academy-id "q-81105" :question/problem "Given the orthogonal basis $B$ of ${R}^{2}$ and the vector $x$ below, find the value of $10{x}_{2},$ where ${x}_{2}$ is the second component of $[x]_{B}.$\n\n$$\nB={[\\begin{aligned}-2 \\\\ -6\\end{aligned}],[\\begin{aligned}3 \\\\ -1\\end{aligned}]},\\,x=[\\begin{aligned}5 \\\\ -3\\end{aligned}]\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2}.$ \n\nSince $B$ is an orthogonal basis, we have that $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$, where ${x}_{i}=\\frac{x\\cdot {q}_{i}}{{q}_{i}\\cdot {q}_{i}}.$ Computing ${x}_{2},$ we obtain \n\n$$\n\\begin{aligned}{x}_{2} & =\\frac{x\\cdot {q}_{2}}{{q}_{2}\\cdot {q}_{2}} \\\\  & =\\frac{5\\cdot 3+(-3)\\cdot (-1)}{{3}^{2}+(-1)^{2}} \\\\  & =\\frac{15+3}{9+1} \\\\  & =\\frac{9}{5}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n10{x}_{2}=10\\cdot \\frac{9}{5}=18.\n$$"}] [{:db/id #edb/ref 17592186362128 :knowledge-point/_questions [{:knowledge-point/id #uuid "15b92bed-c97f-5b87-9811-fbfc5c03314d" :knowledge-point/title "Finding a Component of a Vector With Respect to a Given Orthogonal Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dfa3bcdd-cc21-51e2-8665-86d699548642" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186362130} {:answer/id #uuid "7715ae75-d5b6-5fba-a3cf-a3f609052744" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186362131} {:answer/id #uuid "e5aa3c38-128a-5e17-8e7a-1f227535552d" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186362132} {:answer/id #uuid "7c06b3fb-5d34-57ae-9686-fb2617fb2606" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186362133} {:answer/id #uuid "60738dd8-5967-5b8f-a367-a0322dc9f87f" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186362134}] :answer-field/correct {:answer/id #uuid "7c06b3fb-5d34-57ae-9686-fb2617fb2606" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186362133} :answer-field/id #uuid "063bc4b3-ea30-54e7-85d1-e9dd1a69a998" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362129}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "56109c7e-b321-5b60-9876-29d7ab35ea70" :question/math-academy-id "q-81137" :question/problem "Given the orthogonal basis $B$ of ${R}^{2}$ and the vector $x$ below, find the value of $30{x}_{1},$ where ${x}_{1}$ is the first component of $[x]_{B}.$\n\n$$\nB={[\\begin{aligned}1 \\\\ 2\\end{aligned}],[\\begin{aligned}-8 \\\\ 4\\end{aligned}]},\\,x=[\\begin{aligned}-3 \\\\ 2\\end{aligned}]\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2}.$ \n\nSince $B$ is an orthogonal basis, we have that $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$, where ${x}_{i}=\\frac{x\\cdot {q}_{i}}{{q}_{i}\\cdot {q}_{i}}.$ Computing ${x}_{1},$ we obtain \n\n$$\n\\begin{aligned}{x}_{1} & =\\frac{x\\cdot {q}_{1}}{{q}_{1}\\cdot {q}_{1}} \\\\  & =\\frac{-3\\cdot 1+2\\cdot 2}{{1}^{2}+{2}^{2}} \\\\  & =\\frac{-3+4}{5} \\\\  & =\\frac{1}{5}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n30{x}_{1}=30\\cdot \\frac{1}{5}=6.\n$$"}]}
