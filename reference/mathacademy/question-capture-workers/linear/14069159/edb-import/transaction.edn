[{:db/id [:question/math-academy-id "q-108558"] :question/problem "$$\n[\\begin{aligned}-2 & 1 & 0 \\\\ 0 & -2 & 1 \\\\ 0 & 0 & -2\\end{aligned}]\n$$\n\nConsider the matrix above. Find its decomposition using Jordan blocks." :question/worked-solution "Our matrix can be represented as a single Jordan block:\n\n$$\n[\\begin{aligned}-2 & 1 & 0 \\\\ 0 & -2 & 1 \\\\ 0 & 0 & -2\\end{aligned}]={J}_{3}(-2)\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-108565"] :question/problem "$$\n[\\begin{aligned}1 & 1 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\n$$\n\nConsider the matrix above. Find its decomposition using Jordan blocks." :question/worked-solution "Our matrix can be represented as the composition of two Jordan blocks (one $2\\times 2$ block and one $1\\times 1$ block), as follows:\n\n$$\n[\\begin{aligned}1 & 1 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 0\\end{aligned}]={J}_{2}(1)\\,⊕\\,{J}_{1}(0)\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-108570"] :question/problem "${J}_{2}(7)=$" :question/worked-solution "Let's construct our matrix:\n\n- The index $2$ in ${J}_{2}(7)$ means that we have a $2\\times 2$ matrix.\n\n- The value $7$ in ${J}_{2}(7)$ means that we have $7$'s on the main diagonal.\n\n- Also, we must have $1$'s on the superdiagonal (the diagonal above the main one).\n\nGiven that all the other entries must be zero, our Jordan block is\n\n$$\n{J}_{2}(1)=[\\begin{aligned}7 & 1 \\\\ 0 & 7\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-108969/selection/7337ec2d6f10f663ed772b1dcbd1abb73308027db22e2d73870b6bf1a0a58405" :answer/id #uuid "849472c2-eb1a-5319-bbfb-cb66b5326099" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-8 & 0 & 0 \\\\ 0 & -8 & 0 \\\\ 0 & 0 & -8\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-108969/selection/4e781a6e62c97569d1bfc787784d3fd82df386edabd321f6a920cf8cc6151fa3" :answer/id #uuid "f8e4b64d-5275-509c-bf8a-772548e1cc23" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-8 & 3 & 0 \\\\ 0 & -8 & 3 \\\\ 0 & 0 & -8\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-108969/selection/8f911177fb36b374b17bbc1c6107f1dfe00a487035dae47e9ba87a3b1d701ad3" :answer/id #uuid "7f7e7130-7043-59a8-970d-b5712822ce68" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 & 1 & 0 \\\\ 0 & 3 & 1 \\\\ 0 & 0 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-108969/selection/e388a7cca8d2e26834b368f9d50aee879d7d3f4a6a14a361cf2057cb452c513f" :answer/id #uuid "5330674e-f842-53d0-93e7-b675fafc2ee6" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-108969/selection/d52e5254dc07c314706c500c81e786ea042cbc023433eee5cfba5cb421e2feeb" :answer/id #uuid "a1b3f6d0-d0f4-5966-9f24-07eebe99973c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-8 & 1 & 0 \\\\ 0 & -8 & 1 \\\\ 0 & 0 & -8\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-108969/selection" :answer-field/id #uuid "559dfb67-c3ea-5c90-a4b1-a8e2db4e31a2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-108969/selection/d52e5254dc07c314706c500c81e786ea042cbc023433eee5cfba5cb421e2feeb" :answer-field/choices ["q-108969/selection/7337ec2d6f10f663ed772b1dcbd1abb73308027db22e2d73870b6bf1a0a58405" "q-108969/selection/4e781a6e62c97569d1bfc787784d3fd82df386edabd321f6a920cf8cc6151fa3" "q-108969/selection/8f911177fb36b374b17bbc1c6107f1dfe00a487035dae47e9ba87a3b1d701ad3" "q-108969/selection/e388a7cca8d2e26834b368f9d50aee879d7d3f4a6a14a361cf2057cb452c513f" "q-108969/selection/d52e5254dc07c314706c500c81e786ea042cbc023433eee5cfba5cb421e2feeb"] :db/ensure [:answer-field/validate]} {:db/id "q-108969" :question/id #uuid "8806f27c-bac9-5626-83fa-5aa4b2d96f89" :question/math-academy-id "q-108969" :question/problem "${J}_{3}(-8)=$" :question/worked-solution "Let's construct our matrix:\n\n- The index $3$ in ${J}_{3}(-8)$ means that we have a $3\\times 3$ matrix.\n\n- The value $-8$ in ${J}_{3}(-8)$ means that we have $-8$'s on the main diagonal.\n\n- Also, we must have $1$'s on the superdiagonal (the diagonal above the main one).\n\nGiven that all the other entries must be zero, our Jordan block is\n\n$$\n{J}_{3}(-8)=[\\begin{aligned}-8 & 1 & 0 \\\\ 0 & -8 & 1 \\\\ 0 & 0 & -8\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-108969/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5371da4f-89c4-530d-8ae7-dd20279b53ba"] :knowledge-point/questions ["q-108969"] :db/ensure [:knowledge-point/validate]} {:db/id "q-109057/selection/48104101899f09e13c40576864923093b18d9810693e7f64bce4d94448f20659" :answer/id #uuid "cca73417-798f-5d42-9148-8531fcfea7f8" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 0 & 0 \\\\ 0 & 2 & 1 \\\\ 0 & 0 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-109057/selection/a7780879412d189e9147d31fcd1ca9d6ce0a8740bc60b4e6106f0d3f41b0203c" :answer/id #uuid "99314761-b094-5bdb-81dd-c45b1de75b1c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-109057/selection/78680de4db4e0cef1fa20d482f13fdcadedd06da67a4f67bde889a054d7dce51" :answer/id #uuid "6edc6c81-fe37-50e7-a567-ea4bbbf442e2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-109057/selection/2796c9821af33aeae6a67e31ddd48849e72bf76c5a92ddddeb3437ddaef62d99" :answer/id #uuid "41051ecc-e26d-5072-be9e-0b21fbc252c8" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 1 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-109057/selection/319d4f8fa43832a736f4c132032ea125426d707c73e0ad21249faeb6155daca6" :answer/id #uuid "5aa7e77b-b16f-5ad3-af2b-2428139bc1a7" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 1 & 0 \\\\ 0 & 2 & 1 \\\\ 0 & 0 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-109057/selection" :answer-field/id #uuid "724862e1-44bd-5bb2-89fc-76424cfff1c9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-109057/selection/48104101899f09e13c40576864923093b18d9810693e7f64bce4d94448f20659" :answer-field/choices ["q-109057/selection/48104101899f09e13c40576864923093b18d9810693e7f64bce4d94448f20659" "q-109057/selection/a7780879412d189e9147d31fcd1ca9d6ce0a8740bc60b4e6106f0d3f41b0203c" "q-109057/selection/78680de4db4e0cef1fa20d482f13fdcadedd06da67a4f67bde889a054d7dce51" "q-109057/selection/2796c9821af33aeae6a67e31ddd48849e72bf76c5a92ddddeb3437ddaef62d99" "q-109057/selection/319d4f8fa43832a736f4c132032ea125426d707c73e0ad21249faeb6155daca6"] :db/ensure [:answer-field/validate]} {:db/id "q-109057" :question/id #uuid "07cafa35-dd9e-51de-92b7-c00ea4c89262" :question/math-academy-id "q-109057" :question/problem "${J}_{1}(0)\\,⊕\\,{J}_{2}(2)=$" :question/worked-solution "First, recall the following:\n\n- ${J}_{1}(0)$ represents a $1\\times 1$ Jordan block with $0$'s on the leading diagonal,\n\n- ${J}_{2}(2)$ represents a $2\\times 2$ Jordan block with $2$'s on the leading diagonal.\n\nTherefore, our Jordan blocks are given by\n\n$$\n{J}_{1}(0)=[\\begin{aligned}0\\end{aligned}],\\,{J}_{2}(2)=[\\begin{aligned}2 & 1 \\\\ 0 & 2\\end{aligned}].\n$$\n\nThe composition of our Jordan blocks gives the following block diagonal matrix:\n\n$$\n{J}_{1}(0)\\,⊕\\,{J}_{2}(2)=[\\begin{aligned}0 & 0 & 0 \\\\ 0 & 2 & 1 \\\\ 0 & 0 & 2\\end{aligned}]\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-109057/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4f7ad55b-efda-5622-8bdf-e660be24d0c4"] :knowledge-point/questions ["q-109057"] :db/ensure [:knowledge-point/validate]}]
