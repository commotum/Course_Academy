& 0 & 0\\end{aligned}]={J}_{2}(1)\\,⊕\\,{J}_{1}(0)\n$$"}] [{:db/id #edb/ref 17592186162187 :knowledge-point/_questions [{:knowledge-point/id #uuid "5371da4f-89c4-530d-8ae7-dd20279b53ba" :knowledge-point/title "Constructing Jordan Blocks"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b6cb385c-078d-50f7-88b8-7813b330f9f2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186158665} {:answer/id #uuid "1334baf6-3d9d-578a-a8f8-4656c22babf2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 2 \\\\ 0 & 7\\end{bmatrix}" :db/id #edb/ref 17592186158666} {:answer/id #uuid "39bf0873-d10e-58e9-9eec-5242be9281fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 1 \\\\ 0 & 7\\end{bmatrix}" :db/id #edb/ref 17592186158667} {:answer/id #uuid "406b5581-e2d8-53c7-9ebc-e0fe462cbeec" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 0 \\\\ 0 & 7\\end{bmatrix}" :db/id #edb/ref 17592186158668} {:answer/id #uuid "7b1cf570-34a8-5efe-92bc-2fc9994c3770" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 1 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186158669}] :answer-field/correct {:answer/id #uuid "39bf0873-d10e-58e9-9eec-5242be9281fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 1 \\\\ 0 & 7\\end{bmatrix}" :db/id #edb/ref 17592186158667} :answer-field/id #uuid "3d442fbe-f685-56e2-8faa-8ab81ee6a9d9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186158664}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d37d1388-ba63-5e87-8ec5-3e0a469003ee" :question/math-academy-id "q-108570" :question/problem "${J}_{2}(7)=$" :question/worked-solution "Let's construct our matrix:\n\n- The index $2$ in ${J}_{2}(7)$ means that we have a $2\\times 2$ matrix.\n\n- The value $7$ in ${J}_{2}(7)$ means that we have $7$'s on the main diagonal.\n\n- Also, we must have $1$'s on the superdiagonal (the diagonal above the main one).\n\nGiven that all the other entries must be zero, our Jordan block is\n\n$$\n{J}_{2}(1)=[\\begin{aligned}7 & 1 \\\\ 0 & 7\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186362859 :knowledge-point/_questions [{:knowledge-point/id #uuid "5371da4f-89c4-530d-8ae7-dd20279b53ba" :knowledge-point/title "Constructing Jordan Blocks"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f8e4b64d-5275-509c-bf8a-772548e1cc23" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-8 & 3 & 0 \\\\ 0 & -8 & 3 \\\\ 0 & 0 & -8\\end{aligned}]" :db/id #edb/ref 17592186362861} {:answer/id #uuid "849472c2-eb1a-5319-bbfb-cb66b5326099" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-8 & 0 & 0 \\\\ 0 & -8 & 0 \\\\ 0 & 0 & -8\\end{aligned}]" :db/id #edb/ref 17592186362862} {:answer/id #uuid "7f7e7130-7043-59a8-970d-b5712822ce68" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 1 & 0 \\\\ 0 & 3 & 1 \\\\ 0 & 0 & 3\\end{aligned}]" :db/id #edb/ref 17592186362863} {:answer/id #uuid "a1b3f6d0-d0f4-5966-9f24-07eebe99973c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-8 & 1 & 0 \\\\ 0 & -8 & 1 \\\\ 0 & 0 & -8\\end{aligned}]" :db/id #edb/ref 17592186362864} {:answer/id #uuid "5330674e-f842-53d0-93e7-b675fafc2ee6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186362865}] :answer-field/correct {:answer/id #uuid "a1b3f6d0-d0f4-5966-9f24-07eebe99973c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-8 & 1 & 0 \\\\ 0 & -8 & 1 \\\\ 0 & 0 & -8\\end{aligned}]" :db/id #edb/ref 17592186362864} :answer-field/id #uuid "559dfb67-c3ea-5c90-a4b1-a8e2db4e31a2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362860}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8806f27c-bac9-5626-83fa-5aa4b2d96f89" :question/math-academy-id "q-108969" :question/problem "${J}_{3}(-8)=$" :question/worked-solution "Let's construct our matrix:\n\n- The index $3$ in ${J}_{3}(-8)$ means that we have a $3\\times 3$ matrix.\n\n- The value $-8$ in ${J}_{3}(-8)$ means that we have $-8$'s on the main diagonal.\n\n- Also, we must have $1$'s on the superdiagonal (the diagonal above the main one).\n\nGiven that all the other entries must be zero, our Jordan block is\n\n$$\n{J}_{3}(-8)=[\\begin{aligned}-8 & 1 & 0 \\\\ 0 & -8 & 1 \\\\ 0 & 0 & -8\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186362866 :knowledge-point/_questions [{:knowledge-point/id #uuid "4f7ad55b-efda-5622-8bdf-e660be24d0c4" :knowledge-point/title "Identifying Matrices Corresponding to a Composition of Jordan Blocks"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41051ecc-e26d-5072-be9e-0b21fbc252c8" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 1 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186362868} {:answer/id #uuid "5aa7e77b-b16f-5ad3-af2b-2428139bc1a7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 1 & 0 \\\\ 0 & 2 & 1 \\\\ 0 & 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186362869} {:answer/id #uuid "cca73417-798f-5d42-9148-8531fcfea7f8" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 & 0 \\\\ 0 & 2 & 1 \\\\ 0 & 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186362870} {:answer/id #uuid "6edc6c81-fe37-50e7-a567-ea4bbbf442e2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186362871} {:answer/id #uuid "99314761-b094-5bdb-81dd-c45b1de75b1c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186362872}] :answer-field/correct {:answer/id #uuid "cca73417-798f-5d42-9148-8531fcfea7f8" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 & 0 \\\\ 0 & 2 & 1 \\\\ 0 & 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186362870} :answer-field/id #uuid "724862e1-44bd-5bb2-89fc-76424cfff1c9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362867}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "07cafa35-dd9e-51de-92b7-c00ea4c89262" :question/math-academy-id "q-109057" :question/problem "${J}_{1}(0)\\,⊕\\,{J}_{2}(2)=$" :question/worked-solution "First, recall the following:\n\n- ${J}_{1}(0)$ represents a $1\\times 1$ Jordan block with $0$'s on the leading diagonal,\n\n- ${J}_{2}(2)$ represents a $2\\times 2$ Jordan block with $2$'s on the leading diagonal.\n\nTherefore, our Jordan blocks are given by\n\n$$\n{J}_{1}(0)=[\\begin{aligned}0\\end{aligned}],\\,{J}_{2}(2)=[\\begin{aligned}2 & 1 \\\\ 0 & 2\\end{aligned}].\n$$\n\nThe composition of our Jordan blocks gives the following block diagonal matrix:\n\n$$\n{J}_{1}(0)\\,⊕\\,{J}_{2}(2)=[\\begin{aligned}0 & 0 & 0 \\\\ 0 & 2 & 1 \\\\ 0 & 0 & 2\\end{aligned}]\n$$"}]}
