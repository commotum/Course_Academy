y/reference/mathacademy/question-capture-workers/linear/14041529/assets/a87b00f9f7908fe62542ef7bca94277f040af97b4af24698dd648c167bcd3376.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,1\\,{{field-1}}\\,x\\,{{field-2}}\\,5,\\,2\\,{{field-3}}\\,y\\,{{field-4}}\\,5}\n$$" :question/worked-solution "A point $P(x,y)$ lies *inside* the rectangle if the following conditions are satisfied:\n\n$$\n\\begin{aligned}1<x<5,\\,2<y<5\\end{aligned}\n$$\n\nNotice that we also need to *include* the bottom edge ($y=2$).\n\nTherefore, we change the corresponding inequality symbol to non-strict, as follows:\n\n$$\n\\begin{aligned}1<x<5,\\,2\\le y<5\\end{aligned}\n$$\n\nMoreover, since *every* real value in these intervals is included, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write our set as follows:\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,1<x<5,\\,2\\le y<5}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-181804/field-1" "q-181804/field-2" "q-181804/field-3" "q-181804/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d9f0da82-f79b-5056-ac99-b401eb1630c7"] :knowledge-point/questions ["q-181804"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186195164 :answer-field/correct 17592186195166 :db/ensure [:answer-field/validate]} {:db/id 17592186195144 :answer-field/correct 17592186195146 :db/ensure [:answer-field/validate]} {:db/id 17592186195149 :answer-field/correct 17592186195151 :db/ensure [:answer-field/validate]} {:db/id 17592186195154 :answer-field/correct 17592186195158 :db/ensure [:answer-field/validate]} {:db/id 17592186195159 :answer-field/correct 17592186195160 :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-181129"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041529/assets/d550ecec3b7103c9510b6e45e738ae1385e07fa63ff2e50c54da6c17606faaec.png)\n\nDescribe the set of points shown above using set-builder notation.\n\n$$\n{(x,y)\\in {{field-1}}\\,:\\,{{field-2}}\\le x\\le {{field-3}},\\,{{field-4}}\\le y\\le {{field-5}}}\n$$" :question/worked-solution "Since all points $P(x,y)$ in our set lie at integer values of $x$ and $y,$ we have $x\\in Z,y\\in Z,$ and therefore \n\n$$\n(x,y)\\in Z\\times Z={Z}^{2}.\n$$\n\nThe points $P(x,y)$ satisfy the condition\n\n$$\nx\\in {-3,-2,-1},\\,y\\in {-4,-3,-2,-1}.\n$$\n\nIn other words,\n\n$$\n-3\\le x\\le -1,\\,-4\\le y\\le -1\n$$\n\nTherefore, we can write our set as follows:\n\n$$\n{(x,y)\\in {Z}^{2}\\,:\\,-3\\le x\\le -1,\\,-4\\le y\\le -1}.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-181130/field-1/5fc5100246d98d57a3a3e1d40181b00e6e8dff5d4a097ce2d7b7f6ae0b08578e" :answer/id #uuid "06bfec6b-1d54-539b-8758-ca0b41383b87" :answer/type :answer.type/math :answer/value "C" :db/ensure [:answer/validate]} {:db/id "q-181130/field-1/62fc74d0eb6ece7bf9beb52d92d3e5dd4c591eb0e1df3eb95bec90a49e0fa322" :answer/id #uuid "04e2abc6-61d4-5107-8338-1beaa4753837" :answer/type :answer.type/math :answer/value "{C}^{2}" :db/ensure [:answer/validate]} {:db/id "q-181130/field-1/7d512723ec7933fc53d818fe067378407b0cca1985b020babe9fcffa79cfd32b" :answer/id #uuid "f73bb3a6-b5d8-5a45-a5ed-d5d5e2e2cad2" :answer/type :answer.type/math :answer/value "Z" :db/ensure [:answer/validate]} {:db/id "q-181130/field-1/904a9c19982d1c360bd0486a099ef7bc8a84d0ace236de1e1f77c56ca4d4caec" :answer/id #uuid "0c09b59d-5ea2-58bc-b97b-7f898134b98d" :answer/type :answer.type/math :answer/value "{Z}^{2}" :db/ensure [:answer/validate]} {:db/id "q-181130/field-1/07d4d169afe54b72e6508fedd544e5d357fac0ff0f623249ab3b7f264f513fcf" :answer/id #uuid "fbe8d7e2-7a00-5a6c-9c30-2f82cc2512fc" :answer/type :answer.type/math :answer/value "{R}^{2}" :db/ensure [:answer/validate]} {:db/id "q-181130/field-1/a1f44d584f3d5c0539cb338e6289ad49d176231f52c1da87f33