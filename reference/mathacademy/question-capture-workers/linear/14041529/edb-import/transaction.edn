d #uuid "65a47e1e-81d3-5461-9161-e9508b577163" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "q-181682/field-3/7d149b60a8e2a3be02476cb4e4d26616193c2006082edf79693d6816cf527c19" :answer-field/choices ["q-181682/field-3/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e" "q-181682/field-3/22814de28a0b1b4f20d5edd62707d192b78050d457a70349795d30d86dfcd7fa" "q-181682/field-3/55f4eef1ef55065220056c9644bf18d21761bc8db2d8f5c41f767a2fc9186b70" "q-181682/field-3/7d149b60a8e2a3be02476cb4e4d26616193c2006082edf79693d6816cf527c19" "q-181682/field-3/cc57b3a2811193b1201e1d8d139011f0b8b63f9cad9aaf57f40ab2b8d40ee2eb"] :db/ensure [:answer-field/validate]} {:db/id "q-181682" :question/id #uuid "df68e3b8-ec68-5a1d-ad28-a45ea280bbbe" :question/math-academy-id "q-181682" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041529/assets/b1d71eb496878cedda9defd9932e3bc42ecb2772ad06e298e06881d1fb51f184.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n{(x,y)\\in {{field-1}}\\,:\\,-2\\,{{field-2}}\\,y\\,{{field-3}}\\,\\frac{1}{2}x+2}\n$$" :question/worked-solution "The points in our set include all those that lie *above* the line $y=-2$ and *below* the line $y=\\frac{1}{2}x+2.$\n\nA point $P(x,y)$ lies *inside* the shaded region if the following conditions are satisfied:\n\n$$\ny>-2,\\,y<\\frac{1}{2}x+2.\n$$\n\nCombining this into a single condition, we have\n\n$$\n-2<y<\\frac{1}{2}x+2.\n$$\n\nWe must also include the lines $y=-2$ and $y=\\frac{1}{2}x+2$ since the boundaries are included in the set (the lines are solid). So, we change the corresponding inequality symbols above as follows:\n\n$$\n-2\\le y\\le \\frac{1}{2}x+2\n$$\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,-2\\le y\\le \\frac{1}{2}x+2}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-181682/field-1" "q-181682/field-2" "q-181682/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5a3df69f-653e-5148-bd46-580097e43362"] :knowledge-point/questions ["q-181682"] :db/ensure [:knowledge-point/validate]} {:db/id "q-181679/field-1/203f88d94a38bb859e78e84aea518cf34952815758cf391887040455367d62ef" :answer/id #uuid "a0cb6add-8446-5852-a89a-86fad0c31eef" :answer/type :answer.type/math :answer/value "N" :db/ensure [:answer/validate]} {:db/id "q-181679/field-1/62fc74d0eb6ece7bf9beb52d92d3e5dd4c591eb0e1df3eb95bec90a49e0fa322" :answer/id #uuid "904a4d56-7513-5053-a23a-1cf07ee38800" :answer/type :answer.type/math :answer/value "{C}^{2}" :db/ensure [:answer/validate]} {:db/id "q-181679/field-1/07d4d169afe54b72e6508fedd544e5d357fac0ff0f623249ab3b7f264f513fcf" :answer/id #uuid "fd5bfe7f-98ee-5e74-8e4b-59c29915319a" :answer/type :answer.type/math :answer/value "{R}^{2}" :db/ensure [:answer/validate]} {:db/id "q-181679/field-1/5fc5100246d98d57a3a3e1d40181b00e6e8dff5d4a097ce2d7b7f6ae0b08578e" :answer/id #uuid "7a06e985-4de1-576a-8dc9-68c1fecc4c00" :answer/type :answer.type/math :answer/value "C" :db/ensure [:answer/validate]} {:db/id "q-181679/field-1/a1f44d584f3d5c0539cb338e6289ad49d176231f52c1da87f334282351fe2472" :answer/id #uuid "473d31ce-119a-5791-8fdc-857f58f4c2a7" :answer/type :answer.type/math :answer/value "R" :db/ensure [:answer/validate]} {:db/id "q-181679/field-1" :answer-field/id #uuid "01989ee4-d6e0-5b00-b3d7-4cb04d3bd660" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-181679/field-1/07d4d169afe54b72e6508fedd544e5d357fac0ff0f623249ab3b7f264f513fcf" :answer-field/choices ["q-181679/field-1/203f88d94a38bb859e78e84aea518cf34952815758cf391887040455367d62ef" "q-181679/field-1/62fc74d0eb6ece7bf9beb52d92d3e5dd4c591eb0e1df3eb95bec90a49e0fa322" "q-181679/field-1/07d4d169afe54b