9-a5b0-197e1fcbcadb" :answer/type :answer.type/math :answer/value "\\le " :db/ensure [:answer/validate]} {:db/id "q-181691/field-2/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e" :answer/id #uuid "c2a9425a-5680-5179-a324-99565a2c0e17" :answer/type :answer.type/math :answer/value "<" :db/ensure [:answer/validate]} {:db/id "q-181691/field-2/22814de28a0b1b4f20d5edd62707d192b78050d457a70349795d30d86dfcd7fa" :answer/id #uuid "409eff4d-9f84-5267-81a9-f82d5d5135ec" :answer/type :answer.type/math :answer/value ">" :db/ensure [:answer/validate]} {:db/id "q-181691/field-2" :answer-field/id #uuid "11debab5-76b5-5bef-9909-a32347b8bccd" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-181691/field-2/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e" :answer-field/choices ["q-181691/field-2/cc57b3a2811193b1201e1d8d139011f0b8b63f9cad9aaf57f40ab2b8d40ee2eb" "q-181691/field-2/55f4eef1ef55065220056c9644bf18d21761bc8db2d8f5c41f767a2fc9186b70" "q-181691/field-2/7d149b60a8e2a3be02476cb4e4d26616193c2006082edf79693d6816cf527c19" "q-181691/field-2/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e" "q-181691/field-2/22814de28a0b1b4f20d5edd62707d192b78050d457a70349795d30d86dfcd7fa"] :db/ensure [:answer-field/validate]} {:db/id "q-181691" :question/id #uuid "e7026035-86e3-5abe-a75f-990ad273e2b2" :question/math-academy-id "q-181691" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041529/assets/6affe267a93d1dab16de3dc153fddbdb165bab831790f7387dcbd29354ebb63a.png)\n\nUse set builder notation to describe the shaded region given in the diagram above:\n\n$$\n{(x,y)\\in {{field-1}}\\,:\\,y\\,{{field-2}}\\,-\\frac{1}{2}{x}^{2}}\n$$" :question/worked-solution "The points in our set include all those that lie *below* the curve $y=-\\frac{1}{2}{x}^{2}.$\n\nTherefore, a point $P(x,y)$ lies *inside* the shaded region if the following condition is satisfied:\n\n$$\ny<-\\frac{1}{2}{x}^{2}\n$$\n\nSince the boundary is not included in the set (the curve is dashed), the inequality is strict.\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,y<-\\frac{1}{2}{x}^{2}}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-181691/field-1" "q-181691/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "36fa0f2f-3812-521a-aca3-900556be84ff"] :knowledge-point/questions ["q-181691"] :db/ensure [:knowledge-point/validate]} {:db/id "q-181696/field-1/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c" :answer/id #uuid "71a7f34f-5b40-545a-bfe9-9b55fda6dd80" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "q-181696/field-1" :answer-field/id #uuid "8b8601b2-1afc-537f-a796-ab7867755b52" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-181696/field-1/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c" :answer-field/choices ["q-181696/field-1/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c"] :db/ensure [:answer-field/validate]} {:db/id "q-181696/field-2/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "59685f75-e8f2-51c0-a015-46e411bd7c31" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-181696/field-2" :answer-field/id #uuid "ca7caad9-afa5-509d-814e-5d12ff61deff" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-181696/field-2/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-181696/field-2/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-181696/field-3/b785f042bcb1e3ac9f1c15e72aea8c54b522212617bb84e48c5ba505bb17b3ea" :answer/id #uuid "6ea5ff0b-c8f9-5207-bfe5-b97d68be645b" :answer/type :answer.type/math :answer/value "\\ge" :db/ensure [:answer/validate]} {:db/id "q-181696/field-3" :answer-field/id #uuid "a1453974-9515-59b7-a97b-11a0a067b4e4" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-181696/field-3/b785f042bcb1e3ac9f1c15e72aea8c54b522212617bb84e48c5ba505bb17b3ea" :answer-field/choices ["q-181696/field-3/b785f042bcb1e3ac9f1c15e72aea8c54b522212617bb84e48c5ba505bb17b3ea"] :db/ensure [:answer-field/validate]} {:db/id "q-181696" :question/id #uuid "776a3516-03ea-5a65-aa0b-94e7bab490df" :question/math-academy-id "q-181696" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041529/assets/5cd989164ddda8a542098548f401a055e085943e35d95a63fe47b132f723d8ce.png)\n\nUse set builder notation to describe the shaded region given in the diagram above:\n\n${(x,y)\\in {R}^{2}\\,:\\,$\n{{field-1}}\n${x}^{2}\\,+\\,$\n{{field-2}}\n${y}^{2}$\n{{field-3}}\n\n$64$\n\n$}$" :question/worked-solution "The equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the elliptical boundary of our region has horizontal radius $a=2$ and vertical radius $b=4.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{16} & =1,\\end{aligned}\n$$\n\nwhich we can write as\n\n$$\n16{x}^{2}+4{y}^{2}=64.\n$$\n\nWe're interested in describing all points that lie *outside* the ellipse. So, let's pick any point outside the region, say, $(0,5).$ Substituting its coordinates into the equation of the boundary, we obtain\n\n$$\n16(0)^{2}+4(5)^{2}\\,>\\,64.\n$$\n\nAs a result, the points $P(x,y)$ in our region are any real numbers that satisfy the condition\n\n$$\n16{x}^{2}+4{y}^{2}>64.\n$$\n\nWe must also include the curve $16{x}^{2}+4{y}^{2}=64$ since the boundary is included in the set (the curve is solid). So, we change the inequality symbol above as follows:\n\n$$\n16{x}^{2}+4{y}^{2}\\ge 64.\n$$\n\nTherefore, we can write the set as\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,16{x}^{2}+4{y}^{2}\\ge 64}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-181696/field-1" "q-181696/field-2" "q-181696/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "36fa0f2f-3812-521a-aca3-900556be84ff"] :knowledge-point/questions ["q-181696"] :db/ensure [:knowledge-point/validate]} {:db/id "q-181808/field-1/07d4d169afe54b72e6508fedd544e5d357fac0ff0f623249ab3b7f264f513fcf" :answer/id #uuid "907144ab-1571-5ad9-9d62-f1a0d4895464" :answer/type :answer.type/math :answer/value "{R}^{2}" :db/ensure [:answer/validate]} {:db/id "q-181808/field-1/a1f44d584f3d5c0539cb338e6289ad49d176231f52c1da87f334282351fe2472" :answer/id #uuid "0cb6faa4-71a4-5afb-abea-771e51bafcf6" :answer/type :answer.type/math :answer/value "R" :db/ensure [:answer/validate]} {:db/id "q-181808/field-1/7d512723ec7933fc53d818fe067378407b0cca1985b020babe9fcffa79cfd32b" :answer/id #uuid "b07ebc6d-af67-5434-965c-c3a53de55979" :answer/type :answer.type/math :answer/value "Z" :db/ensure [:answer/validate]} {:db/id "q-181808/field-1/904a9c19982d1c360bd0486a099ef7bc8a84d0ace236de1e1f77c56ca4d4caec" :answer/id #uuid "f32ed7d7-5c25-51b4-b504-f0007fd41016" :answer/type :answer.type/math :answer/value "{Z}^{2}" :db/ensure [:answer/validate]} {:db/id "q-181808/field-1" :answer-field/id #uuid "79f6d23b-e63e-5419-9dd6-8037aba92787" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-181808/field-1/07d4d169afe54b72e6508fedd544e5d357fac0ff0f623249ab3b7f264f513fcf" :answer-field/choices ["q-181808/field-1/07d4d169afe54b72e6508fedd544e5d357fac0ff0f623249ab3b7f264f513fcf" "q-181808/field-1/a1f44d584f