4d26616193c2006082edf79693d6816cf527c19" "q-181808/field-2/22814de28a0b1b4f20d5edd62707d192b78050d457a70349795d30d86dfcd7fa"] :db/ensure [:answer-field/validate]} {:db/id "q-181808" :question/id #uuid "2a69b369-bbb1-51a1-a0c6-42cc01864162" :question/math-academy-id "q-181808" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041529/assets/664c70223ca8a6219b04a287c779d20bf0f88d770920d1357303721574d90787.png)\n\nUse set builder notation to describe the shaded region given in the diagram above:\n\n$$\n{(x,y)\\in {{field-1}}\\,:\\,y\\,{{field-2}}\\,{x}^{2}}\n$$" :question/worked-solution "The points in our set include all those that lie *above* the curve $y={x}^{2}.$\n\nTherefore, a point $P(x,y)$ lies *inside* the shaded region if the following condition is satisfied:\n\n$$\ny>{x}^{2}\n$$\n\nWe must also include the curve $y={x}^{2}$ since the boundary is included in the set (the curve is solid). So, we change the inequality symbol above as follows:\n\n$$\ny\\ge {x}^{2}\n$$\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,y\\ge {x}^{2}}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-181808/field-1" "q-181808/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "36fa0f2f-3812-521a-aca3-900556be84ff"] :knowledge-point/questions ["q-181808"] :db/ensure [:knowledge-point/validate]} {:db/id "q-181809/field-1/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "7a06aeb8-ebbf-5be2-aa81-046f5ec144b0" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-181809/field-1" :answer-field/id #uuid "4dcfd8f0-cd57-5eae-b02b-1ceb6aec28bb" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-181809/field-1/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer-field/choices ["q-181809/field-1/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53"] :db/ensure [:answer-field/validate]} {:db/id "q-181809/field-2/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c" :answer/id #uuid "3cc62fef-e865-5ef2-af53-3ed9aba4c018" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "q-181809/field-2" :answer-field/id #uuid "e3ed1374-c069-5d94-93d3-448c33b038ff" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-181809/field-2/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c" :answer-field/choices ["q-181809/field-2/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c"] :db/ensure [:answer-field/validate]} {:db/id "q-181809/field-3/22814de28a0b1b4f20d5edd62707d192b78050d457a70349795d30d86dfcd7fa" :answer/id #uuid "9f846df1-067e-51fc-ad78-1627373ac119" :answer/type :answer.type/math :answer/value ">" :db/ensure [:answer/validate]} {:db/id "q-181809/field-3" :answer-field/id #uuid "2b083f2b-befa-55c2-bf5a-678e6148376c" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-181809/field-3/22814de28a0b1b4f20d5edd62707d192b78050d457a70349795d30d86dfcd7fa" :answer-field/choices ["q-181809/field-3/22814de28a0b1b4f20d5edd62707d192b78050d457a70349795d30d86dfcd7fa"] :db/ensure [:answer-field/validate]} {:db/id "q-181809" :question/id #uuid "8b0ab361-6cc4-50f5-a263-8b645cd23440" :question/math-academy-id "q-181809" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041529/assets/8be62d80165b756aedf31e998d6636d7f77a5606e195b3ec288cb0ac6fb52d6f.png)\n\nUse set builder notation to describe the shaded region given in the diagram above:\n\n${(x,y)\\in {R}^{2}\\,:\\,$\n{{field-1}}\n${x}^{2}\\,+\\,$\n{{field-2}}\n${y}^{2}$\n{{field-3}}\n\n$144$\n\n$}$" :question/worked-solution "The equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the elliptical boundary of our region has horizontal radius $a=4$ and vertical radius $b=3.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{9} & =1,\\end{aligned}\n$$\n\nwhich we can write as\n\n$$\n9{x}^{2}+16{y}^{2}=144.\n$$\n\nWe're interested in describing all points that lie *outside* the ellipse. So, let's pick any point outside the region, say, $(0,4).$ Substituting its coordinates into the equation of the boundary, we obtain\n\n$$\n9(0)^{2}+16(4)^{2}\\,>\\,144.\n$$\n\nAs a result, the points $P(x,y)$ in our region are any real numbers that satisfy the condition\n\n$$\n9{x}^{2}+16{y}^{2}>144.\n$$\n\nNotice that we use $>$ since the boundary is excluded from the set (the boundary curve is dashed).\n\nTherefore, we can write the set as\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,9{x}^{2}+16{y}^{2}>144}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-181809/field-1" "q-181809/field-2" "q-181809/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "36fa0f2f-3812-521a-aca3-900556be84ff"] :knowledge-point/questions ["q-181809"] :db/ensure [:knowledge-point/validate]} {:db/id "q-181807/field-1/7d512723ec7933fc53d818fe067378407b0cca1985b020babe9fcffa79cfd32b" :answer/id #uuid "bb105375-3a73-5ff1-989b-a3fd473cbc1b" :answer/type :answer.type/math :answer/value "Z" :db/ensure [:answer/validate]} {:db/id "q-181807/field-1/07d4d169afe54b72e6508fedd544e5d357fac0ff0f623249ab3b7f264f513fcf" :answer/id #uuid "f450c047-e61e-5202-a9d7-5dec1755ad5e" :answer/type :answer.type/math :answer/value "{R}^{2}" :db/ensure [:answer/validate]} {:db/id "q-181807/field-1/904a9c19982d1c360bd0486a099ef7bc8a84d0ace236de1e1f77c56ca4d4caec" :answer/id #uuid "3a963cbb-df45-5309-8299-166a9b5a6954" :answer/type :answer.type/math :answer/value "{Z}^{2}" :db/ensure [:answer/validate]} {:db/id "q-181807/field-1/a1f44d584f3d5c0539cb338e6289ad49d176231f52c1da87f334282351fe2472" :answer/id #uuid "f563bb43-8b8f-56ad-af70-2addcca6f79a" :answer/type :answer.type/math :answer/value "R" :db/ensure [:answer/validate]} {:db/id "q-181807/field-1" :answer-field/id #uuid "737a7821-7523-5d22-86f7-a10c5ad64d90" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-181807/field-1/07d4d169afe54b72e6508fedd544e5d357fac0ff0f623249ab3b7f264f513fcf" :answer-field/choices ["q-181807/field-1/7d512723ec7933fc53d818fe067378407b0cca1985b020babe9fcffa79cfd32b" "q-181807/field-1/07d4d169afe54b72e6508fedd544e5d357fac0ff0f623249ab3b7f264f513fcf" "q-181807/field-1/904a9c19982d1c360bd0486a099ef7bc8a84d0ace236de1e1f77c56ca4d4caec" "q-181807/field-1/a1f44d584f3d5c0539cb338e6289ad49d176231f52c1da87f334282351fe2472"] :db/ensure [:answer-field/validate]} {:db/id "q-181807/field-2/22814de28a0b1b4f20d5edd62707d192b78050d457a70349795d30d86dfcd7fa" :answer/id #uuid "917c637a-e2cf-58ad-91b7-9041a7346f79" :answer/type :answer.type/math :answer/value ">" :db/ensure [:answer/validate]} {:db/id "q-181807/field-2/7d149b60a8e2a3be02476cb4e4d26616193c2006082edf79693d6816cf527c19" :answer/id #uuid "f7b2a731-6fea-5993-8a0f-9ea7e0dd9247" :answer/type :answer.type/math :answer/value "\\le " :db/ensure [:answer/validate]} {:db/id "q-181807/field-2/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e" :answer/id #uuid "19d8b18a-3ad5-5e33-99c2-78f3532d3083" :answer/type :answer.type/math :answer/value "<" :db/ensure [:answer/validate]} {:db/id "q-181807/field-2/55f4eef1ef55065220056c9644bf18d21761bc8db2d8f5c41f767a2fc9186b70" :answer/id #uuid "b78c198a-bce7-55b5-9b71-28e1075fa5cf" :answer/type :answer.type/math :answer/value "\\ne " :db/ensure [:answer/validate]} {:db/id "q-181807/field-2/cc57b3a2811193b1201e1d8d139011f0b8b63f9cad9aaf57f40ab2b8d40ee2eb" :answer/id #uuid "05de3ffa-3948-53fc-b935-dbcff9765caf" :answer/type :answer.type/math :answer/value "\\ge " :db/ensure [:answer/validate]} {:db/id "q-181807/field-2" :answer-field/id #uuid "0fab2ce5-84ed-54ae-b1b0-f776d64e95cf" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-181807/field-2/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e" :answer-field/choices ["q-181807/field-2/22814de28a0b1b4f20d5edd62707d192b78050d457a70349795d30d86dfcd7fa" "q-181807/field-2/7d149b60a8e2a3be02476cb4e4d26616193c2006082edf79693d6816cf527c19" "q-181807/field-2/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e" "q-181807/field-2/55f4eef1ef55065220056c9644bf18d21761bc8db2d8f5c41f767a2fc9186b70" "q-181807/field-2/cc57b3a2811193b1201e1d8d139011f0b8b63f9cad9aaf57f40ab2b8d40ee2eb"] :db/ensure [:answer-field/validate]} {:db/id "q-181807" :question/id #uuid "cf93bafd-c531-5005-a89e-494f2be67c60" :question/math-academy-id "q-181807" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041529/assets/8c23fe5aa17b46293ff29cd8621ee10b2e143cb23b77811ddf20037a1639bce0.png)\n\nUse set builder notation to describe the shaded region given in the diagram above:\n\n$$\n{(x,y)\\in {{field-1}}\\,:\\,x\\,{{field-2}}\\,{y}^{2}}\n$$" :question/worked-solution "The points in our set include all those that lie *to the left* of the curve $x={y}^{2}.$\n\nTherefore, a point $P(x,y)$ lies *inside* the shaded region if the following condition is satisfied:\n\n$$\nx<{y}^{2}\n$$\n\nSince the boundary is not included in the set (the curve is dashed), the inequality is strict.\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,x<{y}^{2}}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-181807/field-1" "q-181807/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "36fa0f2f-3812-521a-aca3-900556be84ff"] :knowledge-point/questions ["q-181807"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-13145"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041529/assets/89fa15ffb9a7f6b319cf3b9ff0de4ab821a15f632d7f93618fbe99b7979260f4.png)\n\nDescribe the set of points shown above using set-builder notation." :question/worked-solution "Since all points $P(x,y)$ in our set lie at integer values of $x$ and $y,$ we have $x\\in \\mathbb Z, y\\in\\mathbb Z,$ and therefore \n\n$$\n(x,y)\\in \\mathbb Z\\times\\mathbb Z = \\mathbb Z^2.\n$$\n\nThe points $P(x,y)$ satisfy the condition\n\n$$\nx \\in \\{1,2,3\\}, \\quad y \\in \\{ -3,-2,-1,0,1,2 \\}.\n$$\n\nIn other words,\n\n$$\n1 \\leq x \\leq 3, \\quad -3 \\leq y \\leq 2\n$$\n\nTherefore, we can write our set as follows:\n\n$$\n\\Big\\{ (x,y)  \\in \\bbox[2pt,Gainsboro]{\\color{blue}\\mathbb Z^2}\n\\: : \\: \n\\bbox[2pt,Gainsboro]{\\color{blue}1}  \n\\leq  x \\leq  \n\\bbox[2pt,Gainsboro]{\\color{blue}3} , \\: \n\\bbox[2pt,Gainsboro]{\\color{blue}-3}  \n\\leq  y \\leq  \n\\bbox[2pt,Gainsboro]{\\color{blue}2} \n\\Big\\}.\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-13183"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041529/assets/787b62fbe367feae9e4c8ed10b983a256840e3a93727fea7c1ff67cacad0129d.png)\n\nDescribe the shaded region shown above using set-builder notation." :question/worked-solution "Since all points $P(x,y)$ in our set lie at integer values of $x$ and $y,$ we have $x\\in \\mathbb Z, y\\in\\mathbb Z,$ and therefore \n\n$$\n(x,y)\\in \\mathbb Z\\times\\mathbb Z = \\mathbb Z^2.\n$$\n\nThe points in our set include all those that lie *below* the line $y=x+2.$ For those points, the following condition is satisfied:\n\n$$\ny \\lt x+2\n$$\n\nAlso, notice that some points in our set lie *on* the line. We include these points by changing the inequality symbol above as follows:\n\n$$\ny \\bbox[2pt,Gainsboro]{\\color{blue}\\leq }x+2\n$$\n\nTherefore, we can write the set as follows:\n\n$$\n\\Big\\{(x,y) \\in \\bbox[2pt,Gainsboro]{\\color{blue}\\mathbb Z ^2} \\: : \\: y \\bbox[2pt,Gainsboro]{\\color{blue}\\leq }x+2 \\Big\\}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-13156"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041529/assets/45260087c5196cc239f21402d73169f60139bd7d2c10ee0aa1db4e1a2c56be4a.png)\n\nDescribe the shaded region shown above using set-builder notation." :question/worked-solution "The points in our set include all those that lie *above* the line $y=2x$ and *below* the line $y=3.$\n\nA point $P(x,y)$ lies *inside* the shaded region if the following conditions are satisfied:\n\n$$\ny \\gt 2x, \\qquad y < 3.\n$$\n\nCombining this into a single condition, we have\n\n$$\n2x \\lt y < 3.\n$$\n\nWe must also include the line $y= 3$ since the boundary is included in the set (the curve is solid). So, we change the corresponding inequality symbol above as follows:\n\n$$\n2x \\lt y  \\bbox[2pt,Gainsboro]{\\color{blue}\\leq } 3\n$$\n\nMoreover, since we're considering *every* real value in this region, $x\\in \\mathbb R, y\\in\\mathbb R,$ and therefore \n\n$$\n(x,y)\\in \\mathbb R\\times\\mathbb R = \\mathbb R^2.\n$$\n\nTherefore, we can write the set as\n\n$$\n\\Big\\{(x,y)\\in \\bbox[2pt,Gainsboro]{\\color{blue}\\mathbb R^2 } \\: : \\:  2x \\bbox[2pt,Gainsboro]{\\color{blue}\\lt } y \\bbox[2pt,Gainsboro]{\\color{blue}\\leq } 3 \\Big\\}.\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-13158"] :question/problem "Use set builder notation to describe the shaded region given in the diagram below:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041529/assets/e5f5f2f2e67ba0ad566b2759ca5536d248f671bf0f082d567a7f7d993772601e.png)" :question/worked-solution "The equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2}=1.\n$$\n\n \n\nHere, the elliptical boundary of our region has horizontal radius $a=5$ and vertical radius $b=4.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{25}+\\frac{{y}^{2}}{16} & =1,\\end{aligned}\n$$\n\nwhich we can write as\n\n$$\n16x^2 + 25y^2 = 400.\n$$\n\nWe're interested in describing all points that lie *outside* the ellipse. So, let's pick any point outside the region, say, $(10,0).$ Substituting its coordinates into the equation of the boundary, we obtain\n\n$$\n16(10)^2+25(0)^2 \\: {\\color{blue}>} \\: 400.\n$$\n\nAs a result, the points $P(x,y)$ in our region are any real numbers that satisfy the condition\n\n$$\n16x^2 + 25y^2  \\gt 400.\n$$\n\nWe must also include the curve $16x^2 + 25y^2 = 400$ since the boundary is included in the set (the curve is solid). So, we change the inequality symbol above as follows:\n\n$$\n16x^2 + 25y^2  \\bbox[2pt,Gainsboro]{\\color{blue}\\geq } 400.\n$$\n\nTherefore, we can write the set as\n\n$$\n\\Big\\{(x,y) \\in \\mathbb{R}^2 \\: : \\: \\bbox[2pt,Gainsboro]{\\color{blue}16 }x^2 + \\bbox[2pt,Gainsboro]{\\color{blue}25 }y^2  \\bbox[2pt,Gainsboro]{\\color{blue}\\geq } 400 \\bigg\\}.\n$$" :db/ensure [:question/validate]}]
