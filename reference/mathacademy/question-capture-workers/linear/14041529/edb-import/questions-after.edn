ar Boundaries, Two Conditions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9148d96d-ab00-5448-b4eb-0260568ce65a" :answer/type {:db/ident :answer.type/math} :answer/value "≤" :db/id #edb/ref 17592186195325} {:answer/id #uuid "bafe6067-3faf-54f2-b60c-adb72169f675" :answer/type {:db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186195326} {:answer/id #uuid "c87b3536-4cb2-5494-80a3-1f14e16bf42c" :answer/type {:db/ident :answer.type/math} :answer/value "≠" :db/id #edb/ref 17592186195327} {:answer/id #uuid "34990d9e-ad8a-560c-9a80-abcb0d67d1d2" :answer/type {:db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186195328} {:answer/id #uuid "68b078a3-cef5-5b4d-8719-874970a4b0c3" :answer/type {:db/ident :answer.type/math} :answer/value "≥" :db/id #edb/ref 17592186195329}] :answer-field/correct {:answer/id #uuid "9148d96d-ab00-5448-b4eb-0260568ce65a" :answer/type {:db/ident :answer.type/math} :answer/value "≤" :db/id #edb/ref 17592186195325} :answer-field/id #uuid "317637f7-252c-5754-b35f-2e6c187d8991" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186195324} {:answer-field/choices [{:answer/id #uuid "f83b87f6-d8c3-54ab-a7e8-8140cbf28527" :answer/type {:db/ident :answer.type/math} :answer/value "C" :db/id #edb/ref 17592186195331} {:answer/id #uuid "f976bd3f-b404-500b-a916-241b6e962cbe" :answer/type {:db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186195332} {:answer/id #uuid "2b553228-d2c1-5d12-99f4-af83c0879fb8" :answer/type {:db/ident :answer.type/math} :answer/value "N" :db/id #edb/ref 17592186195333} {:answer/id #uuid "5946048c-e67a-5c4f-974a-891dc379050c" :answer/type {:db/ident :answer.type/math} :answer/value "R^{2}" :db/id #edb/ref 17592186195334} {:answer/id #uuid "6856a413-6b54-53f9-98c0-4cd285fe4b0e" :answer/type {:db/ident :answer.type/math} :answer/value "C^{2}" :db/id #edb/ref 17592186195335}] :answer-field/correct {:answer/id #uuid "5946048c-e67a-5c4f-974a-891dc379050c" :answer/type {:db/ident :answer.type/math} :answer/value "R^{2}" :db/id #edb/ref 17592186195334} :answer-field/id #uuid "4bcfb027-8d1c-594e-a5d7-96f3d433b8c8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186195330} {:answer-field/choices [{:answer/id #uuid "04d1bedf-ed09-5652-ac5f-431006c0939d" :answer/type {:db/ident :answer.type/math} :answer/value "≠" :db/id #edb/ref 17592186195337} {:answer/id #uuid "0d3284ef-0447-57e0-a17a-b5ea5ef29985" :answer/type {:db/ident :answer.type/math} :answer/value "≥" :db/id #edb/ref 17592186195338} {:answer/id #uuid "2b93574f-3896-52e7-b9df-1fbba0de58ac" :answer/type {:db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186195339} {:answer/id #uuid "5a39a0c3-0326-5d6f-8c94-3fe7c17de19d" :answer/type {:db/ident :answer.type/math} :answer/value "≤" :db/id #edb/ref 17592186195340} {:answer/id #uuid "605452a9-9870-5ce3-897d-3ce5fc32fb8e" :answer/type {:db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186195341}] :answer-field/correct {:answer/id #uuid "5a39a0c3-0326-5d6f-8c94-3fe7c17de19d" :answer/type {:db/ident :answer.type/math} :answer/value "≤" :db/id #edb/ref 17592186195340} :answer-field/id #uuid "bac1b22b-bde8-584c-a8b0-682707987f7a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186195336}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "53b0ed93-9159-5efa-a2a9-9f30d7664a91" :question/math-academy-id "q-181678" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041529/assets/0f95f6b259237816a5a3da041452cfd9458f0852b1ae717a044738b6f310ab5d.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n{(x,y)\\in {{field-1}}\\,:\\,3\\,{{field-2}}\\,y\\,{{field-3}}\\,2x+3}\n$$" :question/worked-solution "The points in our set include all those that lie *above* the line $y=3$ and *below* the line $y=2x+3.$\n\nA point $P(x,y)$ lies *inside* the shaded region if the following conditions are satisfied:\n\n$$\ny>3,\\,y<2x+3.\n$$\n\nCombining this into a single condition, we have\n\n$$\n3<y<2x+3.\n$$\n\nWe must also include the lines $y=3$ and $y=2x+3$ since the boundaries are included in the set (the lines are solid). So, we change the corresponding inequality symbols above as follows:\n\n$$\n3\\le y\\le 2x+3\n$$\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,3\\le y\\le 2x+3}.\n$$"}] [{:db/id #edb/ref 17592186312990 :knowledge-point/_questions [{:knowledge-point/id #uuid "5a3df69f-653e-5148-bd46-580097e43362" :knowledge-point/title "Linear Boundaries, Two Conditions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fd5bfe7f-98ee-5e74-8e4b-59c29915319a" :answer/type {:db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186312992} {:answer/id #uuid "a0cb6add-8446-5852-a89a-86fad0c31eef" :answer/type {:db/ident :answer.type/math} :answer/value "N" :db/id #edb/ref 17592186312993} {:answer/id #uuid "7a06e985-4de1-576a-8dc9-68c1fecc4c00" :answer/type {:db/ident :answer.type/math} :answer/value "C" :db/id #edb/ref 17592186312994} {:answer/id #uuid "904a4d56-7513-5053-a23a-1cf07ee38800" :answer/type {:db/ident :answer.type/math} :answer/value "{C}^{2}" :db/id #edb/ref 17592186312995} {:answer/id #uuid "473d31ce-119a-5791-8fdc-857f58f4c2a7" :answer/type {:db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186312996}] :answer-field/correct {:answer/id #uuid "fd5bfe7f-98ee-5e74-8e4b-59c29915319a" :answer/type {:db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186312992} :answer-field/id #uuid "01989ee4-d6e0-5b00-b3d7-4cb