id #edb/ref 17592186313093} {:answer-field/choices [{:answer/id #uuid "061e6e6c-fe4d-5707-9138-1df374dafce9" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186313099} {:answer/id #uuid "612dc06f-2740-5650-8b20-a88ba17dde22" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186313100} {:answer/id #uuid "cb382c5a-dba2-5701-9528-3ce0e392113b" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186313101} {:answer/id #uuid "5fdbaa62-1f73-5173-a52e-91956c42569f" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186313102}] :answer-field/correct {:answer/id #uuid "612dc06f-2740-5650-8b20-a88ba17dde22" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186313100} :answer-field/id #uuid "524ce159-d28b-5f72-ba32-b595d381f27d" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186313098} {:answer-field/choices [{:answer/id #uuid "9ff60c13-4e93-5c1f-bc7e-4bf5403d8846" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186313104} {:answer/id #uuid "7e6bd17f-b3e6-51fc-8fa7-f429313acad2" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186313105} {:answer/id #uuid "040d3626-82f2-5f31-90d7-4aeb5578f540" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186313106} {:answer/id #uuid "0ce5502f-c7fd-50ae-8ba9-12a2b62f8429" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186313107}] :answer-field/correct {:answer/id #uuid "0ce5502f-c7fd-50ae-8ba9-12a2b62f8429" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186313107} :answer-field/id #uuid "cd8efc04-7461-57bf-bbee-2d1c85b55894" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186313103} {:answer-field/choices [{:answer/id #uuid "961aca2d-79e8-5c31-8cf0-356255b7ebe9" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186313109} {:answer/id #uuid "0d61f582-1c6d-5337-8dd3-cb0f95505860" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186313110} {:answer/id #uuid "7fcdb500-7435-52dd-82ed-09fac64e637c" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186313111} {:answer/id #uuid "b8771d82-7ba2-569a-9dc1-7c6ceb70ae81" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186313112}] :answer-field/correct {:answer/id #uuid "961aca2d-79e8-5c31-8cf0-356255b7ebe9" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186313109} :answer-field/id #uuid "05e34449-7f71-5cc1-9d94-706202cd999a" :answer-field/key "field-5" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186313108}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "687ac3aa-9849-53df-815f-3b15e789efbd" :question/math-academy-id "q-181791" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041529/assets/af3a9e323fa460b60bfa900c7edbcceb4057c442803160b2b4b5bd0704b4db7c.png)\n\nDescribe the set of points shown above using set-builder notation.\n\n$$\n{(x,y)\\in {{field-1}}\\,:\\,{{field-2}}\\le x\\le {{field-3}},\\,{{field-4}}\\le y\\le {{field-5}}}\n$$" :question/worked-solution "Since all points $P(x,y)$ in our set lie at integer values of $x$ and $y,$ we have $x\\in Z,y\\in Z,$ and therefore \n\n$$\n(x,y)\\in Z\\times Z={Z}^{2}.\n$$\n\nThe points $P(x,y)$ satisfy the condition\n\n$$\nx\\in {-1,0,1,2},\\,y\\in {-2,-1,0,1,2,3}.\n$$\n\nIn other words,\n\n$$\n-1\\le x\\le 2,\\,-2\\le y\\le 3.\n$$\n\nTherefore, we can write our set as follows:\n\n$$\n{(x,y)\\in {Z}^{2}\\,:\\,-1\\le x\\le 2,\\,-2\\le y\\le 3}\n$$"}] [{