[{:db/id "q-68068/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "566fc2c2-2861-5eb4-9c20-f7f4124412a0" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-68068/selection/3089f9a34f7a805d8b2b2d5d51b10dc7aea027e8ec8fd8d06ad11cecf2ba9740" :answer/id #uuid "33c414d1-cfcc-5fac-8014-342830e4022f" :answer/type :answer.type/math :answer/value "\\frac{4}{5}" :db/ensure [:answer/validate]} {:db/id "q-68068/selection/b4433cc3a1cf5e75fc9a785442bb7c0d16a914e01f6e6fe624ef0ea36d614fe6" :answer/id #uuid "1e978216-3ebf-5b01-b37d-f16a838e1460" :answer/type :answer.type/text :answer/value "No horizontal asymptote" :db/ensure [:answer/validate]} {:db/id "q-68068/selection/1f5b353af7cbb90a89e4a07f196cff5b0ba27d9934d00e9a38de61eff80108f7" :answer/id #uuid "5c31ce23-e515-5423-9df1-29f09523d2cc" :answer/type :answer.type/math :answer/value "-\\frac{4}{5}" :db/ensure [:answer/validate]} {:db/id "q-68068/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "b9662d48-4126-504b-b812-58d3e6f652c0" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-68068/selection" :answer-field/id #uuid "0d06aabd-9ed4-5161-b2c8-451377b46bd5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-68068/selection/b4433cc3a1cf5e75fc9a785442bb7c0d16a914e01f6e6fe624ef0ea36d614fe6" :answer-field/choices ["q-68068/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-68068/selection/3089f9a34f7a805d8b2b2d5d51b10dc7aea027e8ec8fd8d06ad11cecf2ba9740" "q-68068/selection/b4433cc3a1cf5e75fc9a785442bb7c0d16a914e01f6e6fe624ef0ea36d614fe6" "q-68068/selection/1f5b353af7cbb90a89e4a07f196cff5b0ba27d9934d00e9a38de61eff80108f7" "q-68068/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-68068" :question/id #uuid "f4cb2e8d-afe2-5fca-a220-99b0b541a3cf" :question/math-academy-id "q-68068" :question/problem "Find the horizontal asymptote of $y=f(x)$ where $f(x)=\\frac{4{x}^{3}+6}{5x}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is $x.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{4{x}^{3}+6}{5x} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{4{x}^{3}}{x}+\\frac{6}{x})}{(\\frac{5x}{x})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(4{x}^{2}+\\frac{6}{x})}{5} \\\\  & ={lim}_{x\\to \\infty }\\frac{(4{x}^{2}+0)}{5} \\\\  & =\\frac{4}{5}{lim}_{x\\to \\infty }{x}^{2} \\\\  & =\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-68068/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bde258b7-1654-5e73-8703-0e42371db8f4"] :knowledge-point/questions ["q-68068"] :db/ensure [:knowledge-point/validate]} {:db/id "q-101312/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "1f2e15f6-0541-53c7-a247-aea94c19ff8f" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-101312/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" :answer/id #uuid "e25f3813-a022-50c9-8183-a17baa4e9675" :answer/type :answer.type/math :answer/value "\\infty " :db/ensure [:answer/validate]} {:db/id "q-101312/selection/c5e624c1da93ecfedccf3fa70b8e1fb64de1e5d703dcc02fa7b4793f81a70f81" :answer/id #uuid "2443d773-ae12-5d54-bd33-3e04a0444c1f" :answer/type :answer.type/math :answer/value "\\text{DNE}" :db/ensure [:answer/validate]} {:db/id "q-101312/selection/7bc54ef2cebd9c4cf6fef3072c83d13d0dfd6652d02cb9919fbcbc5497b7a408" :answer/id #uuid "7ee7260f-e17b-5bc2-893c-a10200b99370" :answer/type :answer.type/math :answer/value "-\\infty " :db/ensure [:answer/validate]} {:db/id "q-101312/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer/id #uuid "1623ef14-6d1f-5c7e-a1eb-f7bdec40a15e" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-101312/selection" :answer-field/id #uuid "f4a6fd89-9d41-56ea-b077-a1b6e540ea67" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-101312/selection/7bc54ef2cebd9c4cf6fef3072c83d13d0dfd6652d02cb9919fbcbc5497b7a408" :answer-field/choices ["q-101312/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-101312/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" "q-101312/selection/c5e624c1da93ecfedccf3fa70b8e1fb64de1e5d703dcc02fa7b4793f81a70f81" "q-101312/selection/7bc54ef2cebd9c4cf6fef3072c83d13d0dfd6652d02cb9919fbcbc5497b7a408" "q-101312/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833"] :db/ensure [:answer-field/validate]} {:db/id "q-101312" :question/id #uuid "d17168f1-346a-54bf-af48-01ec1076b631" :question/math-academy-id "q-101312" :question/problem "${lim}_{x\\to -\\infty }\\frac{{x}^{3}-x}{{x}^{2}-3}=$" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{2}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\frac{{x}^{3}-x}{{x}^{2}-3} & ={lim}_{x\\to -\\infty }\\frac{(\\frac{{x}^{3}}{{x}^{2}}-\\frac{x}{{x}^{2}})}{(\\frac{{x}^{2}}{{x}^{2}}-\\frac{3}{{x}^{2}})} \\\\  & ={lim}_{x\\to -\\infty }\\frac{(x-\\frac{1}{x})}{(1-\\frac{3}{{x}^{2}})} \\\\  & ={lim}_{x\\to -\\infty }\\frac{x-0}{1-0} \\\\  & ={lim}_{x\\to -\\infty }x \\\\  & =-\\infty .\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-101312/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "020c3de3-bcaf-5ade-ba50-2f15e344157d"] :knowledge-point/questions ["q-101312"] :db/ensure [:knowledge-point/validate]} {:db/id "q-302235/field-1/b67476ffce451bf9cc94e82f22f7f4f4b23075d2e02b9ea63c2ad56fd611692c" :answer/id #uuid "db46589f-c0a8-5332-84cf-eea5dc4af7c6" :answer/type :answer.type/math :answer/value "\\infty" :db/ensure [:answer/validate]} {:db/id "q-302235/field-1" :answer-field/id #uuid "6c699efb-5074-5e44-95c5-8ba8432e111c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-302235/field-1/b67476ffce451bf9cc94e82f22f7f4f4b23075d2e02b9ea63c2ad56fd611692c" :answer-field/choices ["q-302235/field-1/b67476ffce451bf9cc94e82f22f7f4f4b23075d2e02b9ea63c2ad56fd611692c"] :db/ensure [:answer-field/validate]} {:db/id "q-302235" :question/id #uuid "46e469c8-b773-5cdd-85cb-ec925f153af7" :question/math-academy-id "q-302235" :question/problem "Evaluate the limit:\n\n${lim}_{x\\to \\infty }\\,\\,\\frac{8{x}^{6}+5}{2{x}^{5}-7x}=$\n\n{{field-1}}" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{5}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\,\\,\\frac{8{x}^{6}+5}{2{x}^{5}-7x} & ={lim}_{x\\to \\infty }\\,\\,\\frac{(\\frac{8{x}^{6}}{{x}^{5}}+\\frac{5}{{x}^{5}})}{(\\frac{2{x}^{5}}{{x}^{5}}-\\frac{7x}{{x}^{5}})} \\\\  & ={lim}_{x\\to \\infty }\\,\\,\\frac{(8x+\\frac{5}{{x}^{5}})}{(2-\\frac{7}{{x}^{4}})} \\\\  & =\\frac{8x+0}{2-0} \\\\  & ={lim}_{x\\to \\infty }\\,\\,4x \\\\  & =\\infty .\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-302235/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "020c3de3-bcaf-5ade-ba50-2f15e344157d"] :knowledge-point/questions ["q-302235"] :db/ensure [:knowledge-point/validate]}]
