#{[{:db/id #edb/ref 17592186364786 :knowledge-point/_questions [{:knowledge-point/id #uuid "020c3de3-bcaf-5ade-ba50-2f15e344157d" :knowledge-point/title "Evaluating a Limit at Infinity: Infinite Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e25f3813-a022-50c9-8183-a17baa4e9675" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186364788} {:answer/id #uuid "7ee7260f-e17b-5bc2-893c-a10200b99370" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186364789} {:answer/id #uuid "1f2e15f6-0541-53c7-a247-aea94c19ff8f" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186364790} {:answer/id #uuid "2443d773-ae12-5d54-bd33-3e04a0444c1f" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186364791} {:answer/id #uuid "1623ef14-6d1f-5c7e-a1eb-f7bdec40a15e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186364792}] :answer-field/correct {:answer/id #uuid "7ee7260f-e17b-5bc2-893c-a10200b99370" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186364789} :answer-field/id #uuid "f4a6fd89-9d41-56ea-b077-a1b6e540ea67" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364787}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d17168f1-346a-54bf-af48-01ec1076b631" :question/math-academy-id "q-101312" :question/problem "${lim}_{x\\to -\\infty }\\frac{{x}^{3}-x}{{x}^{2}-3}=$" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{2}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\frac{{x}^{3}-x}{{x}^{2}-3} & ={lim}_{x\\to -\\infty }\\frac{(\\frac{{x}^{3}}{{x}^{2}}-\\frac{x}{{x}^{2}})}{(\\frac{{x}^{2}}{{x}^{2}}-\\frac{3}{{x}^{2}})} \\\\  & ={lim}_{x\\to -\\infty }\\frac{(x-\\frac{1}{x})}{(1-\\frac{3}{{x}^{2}})} \\\\  & ={lim}_{x\\to -\\infty }\\frac{x-0}{1-0} \\\\  & ={lim}_{x\\to -\\infty }x \\\\  & =-\\infty .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186364793 :knowledge-point/_questions [{:knowledge-point/id #uuid "020c3de3-bcaf-5ade-ba50-2f15e344157d" :knowledge-point/title "Evaluating a Limit at Infinity: Infinite Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "db46589f-c0a8-5332-84cf-eea5dc4af7c6" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186364795}] :answer-field/correct {:answer/id #uuid "db46589f-c0a8-5332-84cf-eea5dc4af7c6" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186364795} :answer-field/id #uuid "6c699efb-5074-5e44-95c5-8ba8432e111c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186364794}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "46e469c8-b773-5cdd-85cb-ec925f153af7" :question/math-academy-id "q-302235" :question/problem "Evaluate the limit:\n\n${lim}_{x\\to \\infty }\\,\\,\\frac{8{x}^{6}+5}{2{x}^{5}-7x}=$\n\n{{field-1}}" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{5}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\,\\,\\frac{8{x}^{6}+5}{2{x}^{5}-7x} & ={lim}_{x\\to \\infty }\\,\\,\\frac{(\\frac{8{x}^{6}}{{x}^{5}}+\\frac{5}{{x}^{5}})}{(\\frac{2{x}^{5}}{{x}^{5}}-\\frac{7x}{{x}^{5}})} \\\\  & ={lim}_{x\\to \\infty }\\,\\,\\frac{(8x+\\frac{5}{{x}^{5}})}{(2-\\frac{7}{{x}^{4}})} \\\\  & =\\frac{8x+0}{2-0} \\\\  & ={lim}_{x\\to \\infty }\\,\\,4x \\\\  & =\\infty .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275182 :knowledge-point/_questions [{:knowledge-point/id #uuid "ee15db10-b92c-5f48-8983-e602068c7e08" :knowledge-point/title "Identifying the Horizontal Asymptote of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91924e9c-268a-549b-acdb-3bcd1759bd84" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186275184}] :answer-field/correct {:answer/id #uuid "91924e9c-268a-549b-acdb-3bcd1759bd84" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186275184} :answer-field/id #uuid "94f42605-5fb1-5527-bedd-e379c95369fe" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275183}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e6f0ac3c-98f9-5ddd-b191-1756531965cc" :question/math-academy-id "q-339641" :question/problem "What is the horizontal asymptote of $y=f(x)$ for $x>0$ with $f(x)=\\frac{|3-8x|}{4x+1}?$\n\nThe horizontal asymptote is $y=$\n\n{{field-1}}." :question/worked-solution "For large positive values of $x,$ we have $|3-8x|=8x-3.$ Consequently, for $x\\to \\infty ,$ we get\n\n$$\n{lim}_{x\\to \\infty }\\frac{|3-8x|}{4x+1}={lim}_{x\\to \\infty }\\frac{8x-3}{4x+1}.\n$$\n\nThe horizontal asymptote for $x>0$ is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is $x.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{8x-3}{4x+1} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{8x}{x}-\\frac{3}{x})}{(\\frac{4x}{x}+\\frac{1}{x})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(8-\\frac{3}{x})}{(4+\\frac{1}{x})} \\\\  & =\\frac{8-0}{4+0} \\\\  & =2.\\end{aligned}\n$$\n\n \n\nTherefore, the horizontal asymptote is $y=2.$"}] [{:db/id #edb/ref 17592186275192 :knowledge-point/_questions [{:knowledge-point/id #uuid "ee15db10-b92c-5f48-8983-e602068c7e08" :knowledge-point/title "Identifying the Horizontal Asymptote of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc2d79df-16bd-54f3-90e0-fae80e320a4c" :answer/type {:db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186275194} {:answer/id #uuid "c745edd4-05d9-53f7-abab-2c20c7db0f09" :answer/type {:db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186275195} {:answer/id #uuid "852e1584-cf82-51dd-b11f-0e961c5afcb2" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}" :db/id #edb/ref 17592186275196} {:answer/id #uuid "c4084f72-1b9c-5365-8522-d0b138dc08fa" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{7}{3}" :db/id #edb/ref 17592186275197} {:answer/id #uuid "8b3bc636-484d-5b85-96b3-0d5c42d00ece" :answer/type {:db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186275198}] :answer-field/correct {:answer/id #uuid "c4084f72-1b9c-5365-8522-d0b138dc08fa" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{7}{3}" :db/id #edb/ref 17592186275197} :answer-field/id #uuid "35ca9071-6662-5afe-ba8d-2d66e1d227d0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275193}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "89041eed-f9ba-5e78-85a0-a5586670c312" :question/math-academy-id "q-35831" :question/problem "Find the horizontal asymptote of the function $f(x)=\\frac{14{x}^{3}}{6{x}^{3}+1}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{3}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{14{x}^{3}}{6{x}^{3}+1} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{14{x}^{3}}{{x}^{3}})}{(\\frac{6{x}^{3}}{{x}^{3}}+\\frac{1}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{14}{(6+\\frac{1}{{x}^{3}})} \\\\  & =\\frac{14}{6+0} \\\\  & =\\frac{7}{3}.\\end{aligned}\n$$\n\n \n\nTherefore, the horizontal asymptote of $f(x)$ is $y=\\frac{7}{3}.$"}] [{:db/id #edb/ref 17592186364796 :knowledge-point/_questions [{:knowledge-point/id #uuid "bde258b7-1654-5e73-8703-0e42371db8f4" :knowledge-point/title "Identifying When a Rational Function has No Horizontal Asymptote"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c31ce23-e515-5423-9df1-29f09523d2cc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{5}" :db/id #edb/ref 17592186364798} {:answer/id #uuid "33c414d1-cfcc-5fac-8014-342830e4022f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186364799} {:answer/id #uuid "b9662d48-4126-504b-b812-58d3e6f652c0" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186364800} {:answer/id #uuid "1e978216-3ebf-5b01-b37d-f16a838e1460" :answer/type {:db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186364801} {:answer/id #uuid "566fc2c2-2861-5eb4-9c20-f7f4124412a0" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186364802}] :answer-field/correct {:answer/id #uuid "1e978216-3ebf-5b01-b37d-f16a838e1460" :answer/type {:db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186364801} :answer-field/id #uuid "0d06aabd-9ed4-5161-b2c8-451377b46bd5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364797}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f4cb2e8d-afe2-5fca-a220-99b0b541a3cf" :question/math-academy-id "q-68068" :question/problem "Find the horizontal asymptote of $y=f(x)$ where $f(x)=\\frac{4{x}^{3}+6}{5x}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is $x.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{4{x}^{3}+6}{5x} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{4{x}^{3}}{x}+\\frac{6}{x})}{(\\frac{5x}{x})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(4{x}^{2}+\\frac{6}{x})}{5} \\\\  & ={lim}_{x\\to \\infty }\\frac{(4{x}^{2}+0)}{5} \\\\  & =\\frac{4}{5}{lim}_{x\\to \\infty }{x}^{2} \\\\  & =\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote."}]}
