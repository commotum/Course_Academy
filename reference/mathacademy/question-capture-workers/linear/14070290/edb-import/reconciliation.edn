2 \\\\ -1\\end{aligned}].\\end{aligned}\n$$\n\nNow, we normalize each vector to get an orthonormal basis:\n\n- ${u}_{1}=\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{{1}^{2}+{0}^{2}+{1}^{2}}}[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}]=[\\begin{aligned}\\frac{\\sqrt{2}}{2} \\\\ 0 \\\\ \\frac{\\sqrt{2}}{2}\\end{aligned}].$\n\n- ${u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{{1}^{2}+{2}^{2}+{(-1)}^{2}}}[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}]=[\\begin{aligned}\\frac{\\sqrt{6}}{6} \\\\ \\frac{\\sqrt{6}}{3} \\\\ -\\frac{\\sqrt{6}}{6}\\end{aligned}].$\n\nTherefore, $B={{u}_{1},{u}_{2}}={[\\begin{aligned}\\frac{\\sqrt{2}}{2} \\\\ 0 \\\\ \\frac{\\sqrt{2}}{2}\\end{aligned}],[\\begin{aligned}\\frac{\\sqrt{6}}{6} \\\\ \\frac{\\sqrt{6}}{3} \\\\ -\\frac{\\sqrt{6}}{6}\\end{aligned}]}$ is an  orthonormal basis of $V.$   \n\nFinally, $a=\\frac{\\sqrt{6}}{6},$ $b=\\frac{\\sqrt{6}}{3},$ $c=-\\frac{\\sqrt{6}}{6}$ and   \n\n$$\n|a|+|b|+|c|=|\\frac{\\sqrt{6}}{6}|+|\\,\\frac{\\sqrt{6}}{3}\\,|+|-\\frac{\\sqrt{6}}{6}|=\\frac{2\\sqrt{6}}{3}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/state.json" "file_sha256" "17f114862f8bc295086bfd6ca75eb6d0dd2e240f3680f1e892861a2def005131"} {"question" "q-140537" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/activity-metadata.json" "file_sha256" "9921c61e8a2def5f859b3c22e7e48c790ef5fc52270d26a70301c7efbd7d2a1d"} {"question" "q-140537" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/state.json" "file_sha256" "17f114862f8bc295086bfd6ca75eb6d0dd2e240f3680f1e892861a2def005131"} {"question" "q-140537" "field" "selection" "attri