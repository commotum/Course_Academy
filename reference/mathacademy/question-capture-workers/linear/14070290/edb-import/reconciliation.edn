\\\\ 0 \\\\ 1\\end{aligned}].$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=[\\begin{aligned}2 \\\\ -2 \\\\ -1\\end{aligned}].$\n\n**Step 2**: Next, we find ${v}_{2}$, using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{5\\cdot 2+0\\cdot (-2)+1\\cdot (-1)}{{2}^{2}+(-2)^{2}+(-1)^{2}}{v}_{1} \\\\  & =[\\begin{aligned}5 \\\\ 0 \\\\ 1\\end{aligned}]-[\\begin{aligned}2 \\\\ -2 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}3 \\\\ 2 \\\\ 2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, $B={{v}_{1},{v}_{2}}={[\\begin{aligned}2 \\\\ -2 \\\\ -1\\end{aligned}],[\\begin{aligned}3 \\\\ 2 \\\\ 2\\end{aligned}]}$ is an orthogonal basis for $V.$\n\nFinally, $a=3,$ $b=2,$ and  \n\n$$\n\\frac{a}{b}=\\frac{3}{2}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/state.json" "file_sha256" "17f114862f8bc295086bfd6ca75eb6d0dd2e240f3680f1e892861a2def005131"} {"question" "q-41032" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/activity-metadata.json" "file_sha256" "9921c61e8a2def5f859b3c22e7e48c790ef5fc52270d26a70301c7efbd7d2a1d"} {"question" "q-41032" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/state.json" "file_sha256" "17f114862f8bc295086bfd6ca75eb6d0dd2e240f3680f1e892861a2def005131"} {"question" "q-41032" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-\\frac{3}{2}"] ["math" "1"] ["math" "\\frac{2}{3}"] ["math" "\\frac{3}{2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/state.json" "file_sha256" "17f114862f8bc295086bfd6ca75eb6d0dd2e240f3680f1e892861a2def005131"} {"question" "q-41032" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{3}{2}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/state.json" "file_sha256" "17f114862f8bc295086bfd6ca75eb6d0dd2e240f3680f1e892861a2def005131"} {"question" "q-86845" "field" nil "attribute" "question/problem" "value" "$$\nV=\\text{Span}{[\\begin{aligned}-2 \\\\ 0 \\\\ 1\\end{aligned}],[\\begin{aligned}3 \\\\ 5 \\\\ -4\\end{aligned}]},\\,B={[\\begin{aligned}-2 \\\\ 0 \\\\ 1\\end{aligned}],[\\begin{aligned}a \\\\ b \\\\ c\\end{aligned}]}\n$$\n\nConsider the subspace $V$ and an orthogonal basis $B$ of $V,$ given above. Given that $B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $\\frac{c}{b}?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/state.json" "file_sha256" "17f114862f8bc295086bfd6ca75eb6d0dd2e240f3680f1e892861a2def005131"} {"question" "q-86845" "field" nil "attribute" "question/worked-solution" "value" "First, let's denote\n\n$\\,$ ${a}_{1}=[\\begin{aligned}-2 \\\\ 0 \\\\ 1\\end{aligned}]\\,$ and $\\,{a}_{2}=[\\begin{aligned}3 \\\\ 5 \\\\ -4\\end{aligned}].$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=[\\begin{aligned}-2 \\\\ 0 \\\\ 1\\end{aligned}].$\n\n**Step 2**: Next, we find ${v}_{2}$, using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{3\\cdot (-2)+5\\cdot 0+(-4)\\cdot 1}{(-2)^{2}+{0}^{2}+{1}^{2}}{v}_{1} \\\\  & =[\\begin{aligned}3 \\\\ 5 \\\\ -4\\end{aligned}]-(-2)[\\begin{aligned}-2 \\\\ 0 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ 5 \\\\ -2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, $B={{v}_{1},{v}_{2}}={[\\begin{aligned}-2 \\\\ 0 \\\\ 1\\end{aligned}],[\\begin{aligned}-1 \\\\ 5 \\\\ -2\\end{aligned}]}$ is an orthogonal basis for $V.$\n\nFinally, $b=5,$ $c=-2,$ and  \n\n$$\n\\frac{c}{b}=\\frac{-2}{5}=-\\frac{2}{5}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/state.json" "file_sha256" "17f114862f8bc295086bfd6ca75eb6d0dd2e240f3680f1e892861a2def005131"} {"question" "q-86845" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/activity-metadata.json" "file_sha256" "9921c61e8a2def5f859b3c22e7e48c790ef5fc52270d26a70301c7efbd7d2a1d"} {"question" "q-86845" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/state.json" "file_sha256" "17f114862f8bc295086bfd6ca75eb6d0dd2e240f3680f1e892861a2def005131"} {"question" "q-86845" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-5"] ["math" "-\\frac{2}{5}"] ["math" "-\\frac{5}{2}"] ["math" "\\frac{2}{5}"] ["math" "\\frac{5}{2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/state.json" "file_sha256" "17f114862f8bc295086bfd6ca75eb6d0dd2e240f3680f1e892861a2def005131"} {"question" "q-86845" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{2}{5}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/state.json" "file_sha256" "17f114862f8bc295086bfd6ca75eb6d0dd2e240f3680f1e892861a2def005131"} {"question" "q-81211" "field" nil "attribute" "question/problem" "value" "$$\nA=[\\begin{aligned}1 & 2 \\\\ -1 & 5 \\\\ 1 & 6\\end{aligned}],\\,B={[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}],[\\begin{aligned}a \\\\ b \\\\ c\\end{aligned}]}\n$$\n\nConsider the subspace $\\text{Col}(A)$ and an orthogonal basis $B$ of $\\text{Col}(A),$ where $A$ and $B$ are given above. Given that $B$ is derived from $\\text{Col}(A)$ using the Gram-Schmidt process, what is the value of $\\frac{b}{c}?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/state.json" "file_sha256" "17f114862f8bc295086bfd6ca75eb6d0dd2e240f3680f1e892861a2def005131"} {"question" "q-81211" "field" nil "attribute" "question/worked-solution" "value" "Recall that $\\text{Col}(A)$ is the span of the columns of $A.$  \n\nFirst, let's denote\n\n$\\,$ ${a}_{1}=[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}]\\,$ and $\\,{a}_{2}=[\\begin{aligned}2 \\\\ 5 \\\\ 6\\end{aligned}].$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}].$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{2\\cdot 1+5\\cdot (-1)+6\\cdot 1}{{1}^{2}+(-1)^{2}+{1}^{2}}{v}_{1} \\\\  & =[\\begin{aligned}2 \\\\ 5 \\\\ 6\\end{aligned}]-[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 6 \\\\ 5\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, $B={{v}_{1},{v}_{2}}={[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}],[\\begin{aligned}1 \\\\ 6 \\\\ 5\\end{aligned}]}$ is an orthogonal basis for $\\text{Col}(A).$\n\nFinally, $b=6,$ $c=5,$ and  \n\n$$\n\\frac{b}{c}=\\frac{6}{5}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/state.json" "file_sha256" "17f114862f8bc295086bfd6ca75eb6d0dd2e240f3680f1e892861a2def005131"} {"question" "q-81211" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/activity-metadata.json" "file_sha256" "9921c61e8a2def5f859b3c22e7e48c790ef5fc52270d26a70301c7efbd7d2a1d"} {"question" "q-81211" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/state.json" "file_sha256" "17f114862f8bc295086bfd6ca75eb6d0dd2e240f3680f1e892861a2def005131"} {"question" "q-81211" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "6"] ["math" "\\frac{1}{5}"] ["math" "\\frac{1}{6}"] ["math" "\\frac{5}{6}"] ["math" "\\frac{6}{5}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/state.json" "file_sha256" "17f114862f8bc295086bfd6ca75eb6d0dd2e240f3680f1e892861a2def005131"} {"question" "q-81211" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{6}{5}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/state.json" "file_sha256" "17f114862f8bc295086bfd6ca75eb6d0dd2e240f3680f1e892861a2def005131"} {"question" "q-41034" "field" nil "attribute" "question/problem" "value" "$$\nA=[\\begin{aligned}3 & 4 \\\\ \\sqrt{3} & 0 \\\\ 0 & 7\\end{aligned}],\\,B={[\\begin{aligned}3 \\\\ \\sqrt{3} \\\\ 0\\end{aligned}],[\\begin{aligned}a \\\\ b \\\\ c\\end{aligned}]}\n$$\n\nConsider the subspace $\\text{Col}(A)$ and an orthogonal basis $B$ of $\\text{Col}(A),$ where $A$ and $B$ are given above. Given that $B$ is derived from $\\text{Col}(A)$ using the Gram-Schmidt process, what is the value of $\\frac{b}{a}?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/state.json" "file_sha256" "17f114862f8bc295086bfd6ca75eb6d0dd2e240f3680f1e892861a2def005131"} {"question" "q-41034" "field" nil "attribute" "question/worked-solution" "value" "Recall that $\\text{Col}(A)$ is the span of the columns of $A.$  \n\nFirst, let's denote\n\n$\\,$ ${a}_{1}=[\\begin{aligned}3 \\\\ \\sqrt{3} \\\\ 0\\end{aligned}]\\,$ and $\\,{a}_{2}=[\\begin{aligned}4 \\\\ 0 \\\\ 7\\end{aligned}].$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=[\\begin{aligned}3 \\\\ \\sqrt{3} \\\\ 0\\end{aligned}].$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{4\\cdot 3+0\\cdot \\sqrt{3}+7\\cdot 0}{{3}^{2}+(\\sqrt{3})^{2}+{0}^{2}}{v}_{1} \\\\  & =[\\begin{aligned}4 \\\\ 0 \\\\ 7\\end{aligned}]-[\\begin{aligned}3 \\\\ \\sqrt{3} \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ -\\sqrt{3} \\\\ 7\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, $B={{v}_{1},{v}_{2}}={[\\begin{aligned}3 \\\\ \\sqrt{3} \\\\ 0\\end{aligned}],[\\begin{aligned}1 \\\\ -\\sqrt{3} \\\\ 7\\end{aligned}]}$ is an orthogonal basis for $\\text{Col}(A).$\n\nFinally, $a=1,$ $b=-\\sqrt{3},$ and  \n\n$$\n\\frac{b}{a}=\\frac{-\\sqrt{3}}{1}=-\\sqrt{3}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/state.json" "file_sha256" "17f114862f8bc295086bfd6ca75eb6d0dd2e240f3680f1e892861a2def005131"} {"question" "q-41034" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/activity-metadata.json" "file_sha256" "9921c61e8a2def5f859b3c22e7e48c790ef5fc52270d26a70301c7efbd7d2a1d"} {"question" "q-41034" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/state.json" "file_sha256" "17f114862f8bc295086bfd6ca75eb6d0dd2e240f3680f1e892861a2def005131"} {"question" "q-41034" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2\\sqrt{3}"] ["math" "-\\frac{\\sqrt{3}}{3}"] ["math" "-\\sqrt{3}"] ["math" "\\frac{\\sqrt{3}}{3}"] ["math" "\\sqrt{3}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/state.json" "file_sha256" "17f114862f8bc295086bfd6ca75eb6d0dd2e240f3680f1e892861a2def005131"} {"question" "q-41034" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\sqrt{3}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/state.json" "file_sha256" "17f114862f8bc295086bfd6ca75eb6d0dd2e240f3680f1e892861a2def005131"} {"question" "q-40742" "field" nil "attribute" "question/problem" "value" "$$\nA=[\\begin{aligned}2 & -3 \\\\ -1 & 4 \\\\ 4 & -1\\end{aligned}],\\,B={[\\begin{aligned}2 \\\\ -1 \\\\ 4\\end{aligned}],[\\begin{aligned}a \\\\ b \\\\ c\\end{aligned}]}\n$$\n\nConsider the subspace 