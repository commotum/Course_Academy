\ -1\\end{bmatrix}$\n- $\\begin{bmatrix}4 \\\\ -2 \\\\ 4\\end{bmatrix}$\n\nTherefore,\n\n$$\n\\begin{bmatrix}\\frac{2}{3} \\\\ \\frac{2}{3} \\\\ -\\frac{1}{3}\\end{bmatrix}\n$$\n\nis an orthonormal basis for $V$.\n\nFinally,\n\n$$\na=\\dfrac{2}{3}\n$$\n\n$$\nb=-\\dfrac1 3\n$$\n\n$$\nc=\\dfrac{2}{3}\n$$\n\nand\n\n$$\n\\begin{vmatrix}a & + & b & + & c & = \\left & \\dfrac{2}{3} \\right & + \\left & -\\dfrac{1}{3}\\right & + \\left & \\dfrac{2}{3} \\right\\end{vmatrix} = \\dfrac 5 3\n$$"]] "immutable_answers" [17592186131847 17592186131848 17592186131849 17592186131850 17592186131851 17592186131865 17592186131866 17592186131867 17592186131868 17592186131869] "immutable_fields" [[17592186131846 :answer-field/correct] [17592186131846 :answer-field/id] [17592186131846 :answer-field/key] [17592186131846 :answer-field/type] [17592186131864 :answer-field/correct] [17592186131864 :answer-field/id] [17592186131864 :answer-field/key] [17592186131864 :answer-field/type]] "no_history" []}
