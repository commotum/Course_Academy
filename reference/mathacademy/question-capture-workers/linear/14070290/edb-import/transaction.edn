\\\\ \\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3}\\end{aligned}]}$ is an orthonormal basis of $V.$\n\nFinally, $a=\\frac{\\sqrt{3}}{3},$ $b=\\frac{\\sqrt{3}}{3},$ $c=\\frac{\\sqrt{3}}{3}$ and  \n\n$$\n|a|+|b|+|c|=|\\,\\frac{\\sqrt{3}}{3}\\,|+|\\frac{\\sqrt{3}}{3}|+|\\frac{\\sqrt{3}}{3}|=\\sqrt{3}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-86858/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ccdefb8e-1bb5-52e9-812d-d2a5bffff731"] :knowledge-point/questions ["q-86858"] :db/ensure [:knowledge-point/validate]} {:db/id "q-140539/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer/id #uuid "4f46f6b7-52ef-5793-b5e9-2e15aaa4c15b" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-140539/selection/05402db46107d70ece210f0bd5e24b332ae4f43bd474d592035c3e3c92625629" :answer/id #uuid "e1e6fb0d-26c7-5c34-a694-38776d0f4a5f" :answer/type :answer.type/math :answer/value "2\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-140539/selection/9f6bfd6fa85d96298a99db901d9b73f609ef64ac0bcf5fbdc4a7ac6d3b733558" :answer/id #uuid "4471dd05-2f63-5ae6-a6f3-d3d72b3ac3f8" :answer/type :answer.type/math :answer/value "\\sqrt{6}" :db/ensure [:answer/validate]} {:db/id "q-140539/selection/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" :answer/id #uuid "8b090b44-24fe-5c33-851c-ae6d677f8836" :answer/type :answer.type/math :answer/value "\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-140539/selection/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d" :answer/id #uuid "3cb3faac-8c3a-55bd-a7fa-80a31e9f40d0" :answer/type :answer.type/math :answer/value "\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-140539/selection" :answer-field/id #uuid "8552b761-5c83-5ad2-82ca-75234de75e84" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-140539/selection/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" :answer-field/choices ["q-140539/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" "q-140539/selection/05402db46107d70ece210f0bd5e24b332ae4f43bd474d592035c3e3c92625629" "q-140539/selection/9f6bfd6fa85d96298a99db901d9b73f609ef64ac0bcf5fbdc4a7ac6d3b733558" "q-140539/selection/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" "q-140539/selection/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d"] :db/ensure [:answer-field/validate]} {:db/id "q-140539" :question/id #uuid "94688131-b2c5-511f-94cd-d923b0e6c74e" :question/math-academy-id "q-140539" :question/problem "$$\nV=\\text{Span}{[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}],[\\begin{aligned}0 \\\\ 3 \\\\ -3\\end{aligned}]},\\,B={[\\begin{aligned}\\frac{\\sqrt{6}}{3} \\\\ -\\frac{\\sqrt{6}}{6} \\\\ \\frac{\\sqrt{6}}{6}\\end{aligned}],[\\begin{aligned}a \\\\ b \\\\ c\\end{aligned}]}\n$$\n\nConsider the subspace $V$ and an **orthonormal** basis $B$ of $V,$ given above. Given that $B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $|a|+|b|+|c|?$" :question/worked-solution "First, let's denote\n\n$\\,$ ${a}_{1}=[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}]\\,$ and $\\,{a}_{2}=[\\begin{aligned}0 \\\\ 3 \\\\ -3\\end{aligned}].$  \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}].$  \n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{0\\cdot 2+3\\cdot (-1)+(-3)\\cdot 1}{{2}^{2}+(-1)^{2}+{1}^{2}}{v}_{1} \\\\  & =[\\begin{aligned}0 \\\\ 3 \\\\ -3\\end{aligned}]+[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ 2 \\\\ -2\\end{aligned}].\\end{aligned}\n$$\n\nNow, we normalize each vector to get an orthonormal basis:\n\n- ${u}_{1}=\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{{2}^{2}+(-1)^{2}+{1}^{2}}}[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}]=[\\begin{aligned}\\frac{\\sqrt{6}}{3} \\\\ -\\frac{\\sqrt{6}}{6} \\\\ \\frac{\\sqrt{6}}{6}\\end{aligned}].$\n\n- ${u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{{2}^{2}+{2}^{2}+(-2)^{2}}}[\\begin{aligned}2 \\\\ 2 \\\\ -2\\end{aligned}]=[\\begin{aligned}\\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3} \\\\ -\\frac{\\sqrt{3}}{3}\\end{aligned}].$\n\nTherefore, $B={{u}_{1},{u}_{2}}={[\\begin{aligned}\\frac{\\sqrt{6}}{6} \\\\ \\frac{\\sqrt{6}}{6} \\\\ \\frac{\\sqrt{6}}{6}\\end{aligned}],[\\begin{aligned}\\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3} \\\\ -\\frac{\\sqrt{3}}{3}\\end{aligned}]}$ is an  orthonormal basis of $V.$   \n\nFinally, $a=\\frac{\\sqrt{3}}{3},$ $b=\\frac{\\sqrt{3}}{3},$ $c=-\\frac{\\sqrt{3}}{3}$ and  \n\n$$\n|a|+|b|+|c|=|\\frac{\\sqrt{3}}{3}|+|\\frac{\\sqrt{3}}{3}|+|-\\frac{\\sqrt{3}}{3}|=\\sqrt{3}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-140539/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ccdefb8e-1bb5-52e9-812d-d2a5bffff731"] :knowledge-point/questions ["q-140539"] :db/ensure [:knowledge-point/validate]} {:db/id "q-40743/selection/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" :answer/id #uuid "d8a6ee85-11a3-5ae3-bbf8-d6963cf4cb82" :answer/type :answer.type/math :answer/value "\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-40743/selection/05402db46107d70ece210f0bd5e24b332ae4f43bd474d592035c3e3c92625629" :answer/id #uuid "33b3a29a-8921-5fc7-b727-ab1b052581c3" :answer/type :answer.type/math :answer/value "2\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-40743/selection/e7f6c27482797e11bd6b0013338edc6789517ab47eb94f4fe9912fc5f8b6c4b8" :answer/id #uuid "69480397-adfc-559e-b482-a91da75074c1" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "q-40743/selection/a05724295bc0340162295da21b8749cd336584b7c76ed9f6810ddb03e7f98d00" :answer/id #uuid "d6b4fdb2-e4da-50a8-99b5-6bb886c02623" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{3}" :db/ensure [:answer/validate]} {:db/id "q-40743/selection/bb5e3e524771fed0f8298cd585cdb5759ed07bb1ac0ac034d00b73a0b668a9ce" :answer/id #uuid "53bc9a18-a05d-53f6-bd2f-497f2d4cff26" :answer/type :answer.type/math :answer/value "3\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-40743/selection" :answer-field/id #uuid "f21b7350-47cc-584b-a997-dc1c6b6c3bde" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-40743/selection/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" :answer-field/choices ["q-40743/selection/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" "q-40743/selection/05402db46107d70ece210f0bd5e24b332ae4f43bd474d592035c3e3c92625629" "q-40743/selection/e7f6c27482797e11bd6b0013338edc6789517ab47eb94f4fe9912fc5f8b6c4b8" "q-40743/selection/a05724295bc0340162295da21b8749cd336584b7c76ed9f6810ddb03e7f98d00" "q-40743/selection/bb5e3e524771fed0f8298cd585cdb5759ed07bb1ac0ac034d00b73a0b668a9ce"] :db/ensure [:answer-field/validate]} {:db/id "q-40743" :question/id #uuid "82b6d02e-6952-5420-9b40-34001b0ef897" :question/math-academy-id "q-40743" :question/problem "$$\nA=[\\begin{aligned}1 & -3 \\\\ -1 & 3 \\\\ 2 & -3\\end{aligned}],\\,B={{u}_{1},{u}_{2}}={[\\begin{aligned}\\frac{\\sqrt{6}}{6} \\\\ -\\frac{\\sqrt{6}}{6} \\\\ \\frac{\\sqrt{6}}{3}\\end{aligned}],[\\begin{aligned}a \\\\ b \\\\ c\\end{aligned}]}\n$$\n\nConsider the subspace $\\text{Col}(A)$ and an **orthonormal** basis $B$ of $\\text{Col}(A),$ where $A$ and $B$ are given above. Given that $B$ is derived from $\\text{Col}(A)$ using the Gram-Schmidt process, what is the value of $|a|+|b|+|c|?$" :question/worked-solution "Recall that $\\text{Col}(A)$ is the span of the columns of $A.$  \n\nFirst, let's denote\n\n$\\,$ ${a}_{1}=[\\begin{aligned}1 \\\\ -1 \\\\ 2\\end{aligned}]\\,$ and $\\,{a}_{2}=[\\begin{aligned}-3 \\\\ 3 \\\\ -3\\end{aligned}].$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=[\\begin{aligned}1 \\\\ -1 \\\\ 2\\end{aligned}].$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{(-3)\\cdot 1+3\\cdot (-1)+(-3)\\cdot 2}{{1}^{2}+(-1)^{2}+{2}^{2}}{v}_{1} \\\\  & =[\\begin{aligned}-3 \\\\ 3 \\\\ -3\\end{aligned}]+[\\begin{aligned}2 \\\\ -2 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}].\\end{aligned}\n$$\n\nNow, we normalize each vector to get an orthonormal basis:\n\n- ${u}_{1}=\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{{1}^{2}+(-1)^{2}+{2}^{2}}}[\\begin{aligned}1 \\\\ -1 \\\\ 2\\end{aligned}]=[\\begin{aligned}\\frac{\\sqrt{6}}{6} \\\\ -\\frac{\\sqrt{6}}{6} \\\\ \\frac{\\sqrt{6}}{3}\\end{aligned}].$\n\n- ${u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{(-1)^{2}+{1}^{2}+{1}^{2}}}[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}]=[\\begin{aligned}-\\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3}\\end{aligned}].$\n\nTherefore, $B={{v}_{1},{v}_{2}}={[\\begin{aligned}\\frac{\\sqrt{6}}{6} \\\\ -\\frac{\\sqrt{6}}{6} \\\\ \\frac{\\sqrt{6}}{3}\\end{aligned}],[\\begin{aligned}-\\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3}\\end{aligned}]}$ is an orthonormal basis for $\\text{Col}(A).$\n\nFinally, $a=-\\frac{\\sqrt{3}}{3},$ $b=\\frac{\\sqrt{3}}{3},$ $c=\\frac{\\sqrt{3}}{3}$ and  \n\n$$\n|a|+|b|+|c|=|-\\frac{\\sqrt{3}}{3}|+|\\frac{\\sqrt{3}}{3}|+|\\frac{\\sqrt{3}}{3}|=\\sqrt{3}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-40743/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ccdefb8e-1bb5-52e9-812d-d2a5bffff731"] :knowledge-point/questions ["q-40743"] :db/ensure [:knowledge-point/validate]} {:db/id "q-140537/selection/de67724e28e3ffc563c9d92aefa0f82f887fc73341d69574b61f499bf9cceb87" :answer/id #uuid "573e0830-6a21-592b-8555-4531ee3244bc" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{6}}{6}" :db/ensure [:answer/validate]} {:db/id "q-140537/selection/f52409178afa6605d44eeec7644d28d3cde5bf5b850da6e6e545f0ac20ada3d9" :answer/id #uuid "c0d06a7d-abf2-581a-98b5-eddc9247248e" :answer/type :answer.type/math :answer/value "\\frac{2\\sqrt{6}}{3}" :db/ensure [:answer/validate]} {:db/id "q-140537/selection/faad0727b2c62b6cced88abf9b210ea8763c2fd1c03c01c27346d66484992037" :answer/id #uuid "ff2cdffe-5a1d-5397-a3ab-de1de3ac50b6" :answer/type :answer.type/math :answer/value "2\\sqrt{6}" :db/ensure [:answer/validate]} {:db/id "q-140537/selection/9f6bfd6fa85d96298a99db901d9b73f609ef64ac0bcf5fbdc4a7ac6d3b733558" :answer/id #uuid "708121fe-18ed-5ede-825b-d4b0074b5ba1" :answer/type :answer.type/math :answer/value "\\sqrt{6}" :db/ensure [:answer/validate]} {:db/id "q-140537/selection/257a2afc22734cbfc05cf0e198a5fab4417366a332dfe0ea2a385a765174fbcc" :answer/id #uuid "fe97330d-27e0-5494-8f26-111b5713b378" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{6}}{3}" :db/ensure [:answer/validate]} {:db/id "q-140537/selection" :answer-field/id #uuid "20cdb0d8-83e5-5e81-83ab-aa4c6c50de0f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-140537/selection/f52409178afa6605d44eeec7644d28d3cde5bf5b850da6e6e545f0ac20ada3d9" :answer-field/choices ["q-140537/selection/de67724e28e3ffc563c9d92aefa0f82f887fc73341d69574b61f499bf9cceb87" "q-140537/selection/f52409178afa6605d44eeec7644d28d3cde5bf5b850da6e6e545f0ac20ada3d9" "q-140537/selection/faad0727b2c62b6cced88abf9b210ea8763c2fd1c03c01c27346d66484992037" "q-140537/selection/9f6bfd6fa85d96298a99db901d9b73f609ef64ac0bcf5fbdc4a7ac6d3b733558" "q-140537/selection/257a2afc22734cbfc05cf0e198a5fab4417366a332dfe0ea2a385a765174fbcc"] :db/ensure [:answer-field/validate]} {:db/id "q-140537" :question/id #uuid "6876e598-e4f1-547d-a2d9-0f26842bf21e" :question/math-academy-id "q-140537" :question/problem "$$\nV=\\text{Span}{[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}],[\\begin{aligned}2 \\\\ 2 \\\\ 0\\end{aligned}]},\\,B={[\\begin{aligned}\\frac{\\sqrt{2}}{2} \\\\ 0 \\\\ \\frac{\\sqrt{2}}{2}\\end{aligned}],[\\begin{aligned}a \\\\ b \\\\ c\\end{aligned}]}\n$$\n\nConsider the subspace $V$ and an **orthonormal** basis $B$ of $V,$ given above. Given that $B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $|a|+|b|+|c|?$" :question/worked-solution "First, let's denote\n\n$\\,$ ${a}_{1}=[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}]\\,$ and $\\,{a}_{2}=[\\begin{aligned}2 \\\\ 2 \\\\ 0\\end{aligned}].$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}].$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{2\\cdot 1+2\\cdot 0+0\\cdot 1}{{1}^{2}+{0}^{2}+{1}^{2}}{v}_{1} \\\\  & =[\\begin{aligned}2 \\\\ 2 \\\\ 0\\end{aligned}]-[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}].\\end{aligned}\n$$\n\nNow, we normalize each vector to get an orthonormal basis:\n\n- ${u}_{1}=\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{{1}^{2}+{0}^{2}+{1}^{2}}}[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}]=[\\begin{aligned}\\frac{\\sqrt{2}}{2} \\\\ 0 \\\\ \\frac{\\sqrt{2}}{2}\\end{aligned}].$\n\n- ${u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{{1}^{2}+{2}^{2}+{(-1)}^{2}}}[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}]=[\\begin{aligned}\\frac{\\sqrt{6}}{6} \\\\ \\frac{\\sqrt{6}}{3} \\\\ -\\frac{\\sqrt{6}}{6}\\end{aligned}].$\n\nTherefore, $B={{u}_{1},{u}_{2}}={[\\begin{aligned}\\frac{\\sqrt{2}}{2} \\\\ 0 \\\\ \\frac{\\sqrt{2}}{2}\\end{aligned}],[\\begin{aligned}\\frac{\\sqrt{6}}{6} \\\\ \\frac{\\sqrt{6}}{3} \\\\ -\\frac{\\sqrt{6}}{6}\\end{aligned}]}$ is an  orthonormal basis of $V.$   \n\nFinally, $a=\\frac{\\sqrt{6}}{6},$ $b=\\frac{\\sqrt{6}}{3},$ $c=-\\frac{\\sqrt{6}}{6}$ and   \n\n$$\n|a|+|b|+|c|=|\\frac{\\sqrt{6}}{6}|+|\\,\\frac{\\sqrt{6}}{3}\\,|+|-\\frac{\\sqrt{6}}{6}|=\\frac{2\\sqrt{6}}{3}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-140537/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ccdefb8e-1bb5-52e9-812d-d2a5bffff731"] :knowledge-point/questions ["q-140537"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81216/selection/94541272efd313dbae911baa80284edca3c21ad9d05698aa0c847620058c4ed5" :answer/id #uuid "da76baf3-08b5-5cc4-9c5b-aa405cc0de94" :answer/type :answer.type/math :answer/value "\\frac{4\\sqrt{41}}{41}" :db/ensure [:answer/validate]} {:db/id "q-81216/selection/0af6f50847f79f968f4218fc53e61482eb88ad4609fd5e2ec66831e5b0da9218" :answer/id #uuid "af3b0f5c-403c-5262-a3c2-03b16f9ab479" :answer/type :answer.type/math :answer/value "\\frac{3\\sqrt{41}}{41}" :db/ensure [:answer/validate]} {:db/id "q-81216/selection/c234591c06b9b1df56532698dbe36ef59f3cad9e556e03067c33f6bb09b369f4" :answer/id #uuid "e391a34f-dc12-574e-afd1-6c7f3fb99b05" :answer/type :answer.type/math :answer/value "\\frac{7\\sqrt{41}}{41}" :db/ensure [:answer/validate]} {:db/id "q-81216/selection/9e8f385e0134eaa0bb1b8978af6833d7d2f17cb68ec310deaf35765859fb7ea0" :answer/id #uuid "04c8ee57-53ad-5313-8b49-b73a3b7b374d" :answer/type :answer.type/math :answer/value "\\frac{13\\sqrt{41}}{41}" :db/ensure [:answer/validate]} {:db/id "q-81216/selection/c7ecb60ee5a8523bfd5b240fb488aa9e39321791f179c6378f66cbfa53454d1b" :answer/id #uuid "88e7eb5b-c21c-572b-a92c-716c96ddf49d" :answer/type :answer.type/math :answer/value "\\frac{11\\sqrt{41}}{41}" :db/ensure [:answer/validate]} {:db/id "q-81216/selection" :answer-field/id #uuid "5cdde4d6-ad18-5852-bd67-1c6d8491f484" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81216/selection/c7ecb60ee5a8523bfd5b240fb488aa9e39321791f179c6378f66cbfa53454d1b" :answer-field/choices ["q-81216/selection/94541272efd313dbae911baa80284edca3c21ad9d05698aa0c847620058c4ed5" "q-81216/selection/0af6f50847f79f968f4218fc53e61482eb88ad4609fd5e2ec66831e5b0da9218" "q-81216/selection/c234591c06b9b1df56532698dbe36ef59f3cad9e556e03067c33f6bb09b369f4" "q-81216/selection/9e8f385e0134eaa0bb1b8978af6833d7d2f17cb68ec310deaf35765859fb7ea0" "q-81216/selection/c7ecb60ee5a8523bfd5b240fb488aa9e39321791f179c6378f66cbfa53454d1b"] :db/ensure [:answer-field/validate]} {:db/id "q-81216" :question/id #uuid "509a8722-d616-55c3-bf11-ae781c7826de" :question/math-academy-id "q-81216" :question/problem "$$\nV=\\text{Span}{[\\begin{aligned}4 \\\\ 0 \\\\ 3\\end{aligned}],[\\begin{aligned}5 \\\\ -4 \\\\ 10\\end{aligned}]},\\,B={[\\begin{aligned}\\frac{4}{5} \\\\ 0 \\\\ \\frac{3}{5}\\end{aligned}],[\\begin{aligned}a \\\\ b \\\\ c\\end{aligned}]}\n$$\n\nConsider the subspace $V$ and an **orthonormal** basis $B$ of $V,$ given above. Given that $B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $|a|+|b|+|c|?$" :question/worked-solution "First, let's denote\n\n$\\,$ ${a}_{1}=[\\begin{aligned}4 \\\\ 0 \\\\ 3\\end{aligned}]\\,$ and $\\,{a}_{2}=[\\begin{aligned}5 \\\\ -4 \\\\ 10\\end{aligned}].$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=[\\begin{aligned}4 \\\\ 0 \\\\ 3\\end{aligned}].$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{5\\cdot 4+(-4)\\cdot 0+10\\cdot 3}{{4}^{2}+{0}^{2}+{3}^{2}}{v}_{1} \\\\  & =[\\begin{aligned}5 \\\\ -4 \\\\ 10\\end{aligned}]-2[\\begin{aligned}4 \\\\ 0 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}-3 \\\\ -4 \\\\ 4\\end{aligned}].\\end{aligned}\n$$\n\nNow, we normalize each vector to get an orthonormal basis:\n\n- ${u}_{1}=\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{{4}^{2}+{0}^{2}+{3}^{2}}}[\\begin{aligned}4 \\\\ 0 \\\\ 3\\end{aligned}]=[\\begin{aligned}\\frac{4}{5} \\\\ 0 \\\\ \\frac{3}{5}\\end{aligned}].$\n\n- ${u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{(-3)^{2}+(-4)^{2}+{4}^{2}}}[\\begin{aligned}-3 \\\\ -4 \\\\ 4\\end{aligned}]=[\\begin{aligned}-\\frac{3\\sqrt{41}}{41} \\\\ -\\frac{4\\sqrt{41}}{41} \\\\ \\frac{4\\sqrt{41}}{41}\\end{aligned}].$\n\nTherefore, $B={{u}_{1},{u}_{2}}={[\\begin{aligned}\\frac{4}{5} \\\\ 0 \\\\ \\frac{3}{5}\\end{aligned}],[\\begin{aligned}-\\frac{3\\sqrt{41}}{41} \\\\ -\\frac{4\\sqrt{41}}{41} \\\\ \\frac{4\\sqrt{41}}{41}\\end{aligned}]}$ is an orthonormal basis of $V.$\n\nFinally, $a=-\\frac{3\\sqrt{41}}{41},$ $b=-\\frac{4\\sqrt{41}}{41},$ $c=\\frac{4\\sqrt{41}}{41}$ and  \n\n$$\n|a|+|b|+|c|=|-\\frac{3\\sqrt{41}}{41}|+|-\\frac{4\\sqrt{41}}{41}|+|\\frac{4\\sqrt{41}}{41}|=\\frac{11\\sqrt{41}}{41}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-81216/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ccdefb8e-1bb5-52e9-812d-d2a5bffff731"] :knowledge-point/questions ["q-81216"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-5581"] :question/problem "Consider the subspace $V$ and an orthogonal basis $\\mathcal B$ of $V,$ given below. Given that $\\mathcal B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $\\dfrac{a}{c}?$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/assets/8f4bdd28c709b7f1b162e98ad196547f90c577df74e52fb6eef1d88efa209af9.png)" :question/worked-solution "First, let's denote\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/assets/948d731d51fff2a1462db9eacab511eefbfdb1634bc9c45b2cf92ca67c4a4d18.png)\n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n- **Step 1**: We set ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/assets/e8a3c7b01b547745c01f123634ca06ffc966ef9acec682af33f05066e00ceef1.png)\n\n- **Step 2**: Next, we find $\\mathbf{v}_2$, using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for $\\mathbf v_2$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{(-3)\\cdot 1+5\\cdot (-1)+2\\cdot 2}{{1}^{2}+(-1)^{2}+{2}^{2}}{v}_{1} \\\\  & =[\\begin{aligned}-3 \\\\ 5 \\\\ 2\\end{aligned}]+\\frac{2}{3}[\\begin{aligned}1 \\\\ -1 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{7}{3} \\\\ \\frac{13}{3} \\\\ \\frac{10}{3}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/assets/bb718fb5d9931c6f99268f40bbef401b50dc160304b271bd2035528bddabdec0.png) is an orthogonal basis for $V.$\n\nFinally, $a=-\\dfrac 7 3,$ $c=\\dfrac{10}{3}$ and  \n\n$$\n\\dfrac{a}{c} = \\dfrac{\\left(-\\dfrac{7}{3}\\right)}{\\left(\\dfrac{10}{3}\\right)} = -\\dfrac{7}{10}.\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5582"] :question/problem "Consider the subspace $\\textrm{Col}(A)$ and an orthogonal basis $\\mathcal B$ of $\\textrm{Col}(A),$ where $A$ and $\\mathcal B$ are given below. Given that $\\mathcal B$ is derived from $\\textrm{Col}(A)$ using the Gram-Schmidt process, what is the value of $\\dfrac{c}{a}?$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/assets/9af89cb1c6f57895919cfec30701a6aa0da76adafcae91a0636b1e7ee3a89e1a.png)" :question/worked-solution "Recall that $\\textrm{Col}(A)$ is the span of the columns of $A.$  \n\nFirst, let's denote\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/assets/fc5495a909acfddca53e63d336f5d7c2261ee6df626f9db2ab9fe4f9714a3198.png)\n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n- **Step 1**: We set ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/assets/8db4c83e14f998397313580b16662b9c80e44bda34da21e8bf92b4a4e1d89ab8.png)\n\n- **Step 2**: Next, we find $\\mathbf{v}_2$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for $\\mathbf v_2$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{(-5)\\cdot 1+(-1)\\cdot (-2)+(-3)\\cdot 2}{{1}^{2}+(-2)^{2}+{2}^{2}}{v}_{1} \\\\  & =[\\begin{aligned}-5 \\\\ -1 \\\\ -3\\end{aligned}]+[\\begin{aligned}1 \\\\ -2 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}-4 \\\\ -3 \\\\ -1\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/assets/061b35426271be433b6f2a92dd3e189edfd3a725dd0fac17cb865a4984c0911d.png) is an orthogonal basis for $\\textrm{Col}(A).$\n\nFinally, $a=-4,$ $c=-1,$ and  \n\n$$\n\\dfrac{c}{a} = \\dfrac{-1}{-4} = \\dfrac{1}{4}.\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5583"] :question/problem "Consider the subspace $V$ and an **orthonormal** basis $\\mathcal B$ of $V,$ given below. Given that $\\mathcal B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $|a|+|b|+|c|?$\n'\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/assets/9c34e0953d430b0a657c7a784e1929a874479e507a1fa1082ceff8d4f3db6340.png)" :question/worked-solution "First, let's denote\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/assets/07343af18e216ada95c688294d28b29fb1e87e34e7e3485b1bf742295fcd2a44.png)\n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n- **Step 1**: We set ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/assets/7d5937987c8cbcab12bbb0f1349e330d221163ec557e7ae2aecee98b3cad072c.png)\n\n- **Step 2**: Next, we find $\\mathbf{v}_2$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for $\\mathbf v_2$ in our case gives\n\n$$\n\\begin{aligned} & ={a}_{2}-\\frac{6\\cdot 2+0\\cdot 2+3\\cdot (-1)}{{2}^{2}+{2}^{2}+(-1)^{2}}{v}_{1} \\\\  & =[\\begin{aligned}6 \\\\ 0 \\\\ 3\\end{aligned}]-[\\begin{aligned}2 \\\\ 2 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ -2 \\\\ 4\\end{aligned}].\\end{aligned}\n$$\n\nNow, we normalize each vector to get an orthonormal basis:\n\n- ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/assets/61267a1a5ef9c57217e148bccbbfa84095d5e838c968ba2cb626c6ef8baa4f58.png)\n\n- ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/assets/fa5773aa1c638263efeb922d8c605068e0ec30070b01ee89c2c902f1977c81b8.png)\n\nTherefore, ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070290/assets/990c25b329f93c269df9291bf8d6521bd7ff7e474f46815f95749abfb843fe83.png) is an orthonormal basis for $V.$\n\nFinally, $a=\\dfrac{2}{3},$ $b=-\\dfrac1  3,$ $c=\\dfrac{2}{3},$ and  \n\n$$\n|a|+|b|+|c| = \\left| \\dfrac{2}{3} \\right| + \\left|-\\dfrac{1}{3}\\right| + \\left| \\dfrac{2}{3} \\right| = \\dfrac 5 3.\n$$" :db/ensure [:question/validate]}]
