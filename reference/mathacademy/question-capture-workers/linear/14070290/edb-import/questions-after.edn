{aligned}\n$$\n\nTherefore, $B={{v}_{1},{v}_{2}}={[\\begin{aligned}1 \\\\ -2 \\\\ 2\\end{aligned}],[\\begin{aligned}-\\frac{4}{3} \\\\ \\frac{11}{3} \\\\ \\frac{13}{3}\\end{aligned}]}$ is an orthogonal basis for $V.$\n\nFinally, we have $a=-\\frac{4}{3},$ $c=\\frac{13}{3},$ and \n\n$$\n\\frac{a}{c}=\\frac{(-\\frac{4}{3})}{(\\frac{13}{3})}=-\\frac{4}{13}.\n$$"}] [{:db/id #edb/ref 17592186365794 :knowledge-point/_questions [{:knowledge-point/id #uuid "b15719b6-0ce4-5fb8-80be-abcaf9344a10" :knowledge-point/title "Finding an Orthogonal Basis For the Column Space of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87168157-d8da-5be6-807c-a97fb6c5306e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186365796} {:answer/id #uuid "cea44f8f-81ee-5420-b9b1-92dfacefd3d0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186365797} {:answer/id #uuid "1ed02350-176b-59dd-b73b-9aa51ca373a7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186365798} {:answer/id #uuid "7805cfd9-7b02-50b6-baf7-5b9531f945d8" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186365799} {:answer/id #uuid "a41c7943-e854-51d5-9d9b-9e3695591cfd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186365800}] :answer-field/correct {:answer/id #uuid "cea44f8f-81ee-5420-b9b1-92dfacefd3d0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186365797} :answer-field/id #uuid "428da11d-a3dd-5412-921a-156ac83235e8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186365795}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "102fd904-ea9d-5874-becf-6a58242475ab" :question/math-academy-id "q-81211" :question/problem "$$\nA=[\\begin{aligned}1 & 2 \\\\ -1 & 5 \\\\ 1 & 6\\end{aligned}],\\,B={[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}],[\\begin{aligned}a \\\\ b \\\\ c\\end{aligned}]}\n$$\n\nConsider the subspace $\\text{Col}(A)$ and an orthogonal basis $B$ of $\\text{Col}(A),$ where $A$ and $B$ are given above. Given that $B$ is derived from $\\text{Col}(A)$ using the Gram-Schmidt process, what is the value of $\\frac{b}{c}?$" :question/worked-solution "Recall that $\\text{Col}(A)$ is the span of the columns of $A.$  \n\nFirst, let's denote\n\n$\\,$ ${a}_{1}=[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}]\\,$ and $\\,{a}_{2}=[\\begin{aligned}2 \\\\ 5 \\\\ 6\\end{aligned}].$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}].$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{2\\cdot 1+5\\cdot (-1)+6\\cdot 1}{{1}^{2}+(-1)^{2}+{1}^{2}}{v}_{1} \\\\  & =[\\begin{aligned}2 \\\\ 5 \\\\ 6\\end{aligned}]-[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 6 \\\\ 5\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, $B={{v}_{1},{v}_{2}}={[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}],[\\begin{aligned}1 \\\\ 6 \\\\ 5\\end{aligned}]}$ is an orthogonal basis for $\\text{Col}(A).$\n\nFinally, $b=6,$ $c=5,$ and  \n\n$$\n\\frac{b}{c}=\\frac{6}{5}.\n$$"}] [{:db/id #edb/ref 17592186365801 :knowledge-point/_questions [{:knowledge-point/id #uuid "ccdefb8e-1bb5-52e9-812d-d2a5bffff731" :knowledge-point/title "Finding an Orthonormal Basis of a Vector Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af3b0f5c-403c-5262-a3c2-03b16f9ab479" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{41}}{41}" :db/id #edb/ref 17592186365803} {:answer/id #uuid "da76baf3-08b5-5cc4-9c5b-aa405cc0de94" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{41}}{41}" :db/id #edb/ref 17592186365804} {:answer/id #uuid "04c8ee57-53ad-5313-8b49-b73a3b7b374d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13\\sqrt{41}}{41}" :db/id #edb/ref 17592186365805} {:answer/id #uuid "e391a34f-dc12-574e-afd1-6c7f3fb99b05" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7\\sqrt{41}}{41}" :db/id #edb/ref 17592186365806} {:answer/id #uuid "88e7eb5b-c21c-572b-a92c-716c96ddf49d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11\\sqrt{41}}{41}" :db/id #edb/ref 17592186365807}] :answer-field/correct {:answer/id #uuid "88e7eb5b-c21c-572b-a92c-716c96ddf49d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11\\sqrt{41}}{41}" :db/id #edb/ref 17592186365807} :answer-field/id #uuid "5cdde4d6-ad18-5852-bd67-1c6d8491f484" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186365802}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "509a8722-d616-55c3-bf11-ae781c7826de" :question/math-academy-id "q-81216" :question/problem "$$\nV=\\text{Span}{[\\begin{aligned}4 \\\\ 0 \\\\ 3\\end{aligned}],[\\begin{aligned}5 \\\\ -4 \\\\ 10\\end{aligned}]},\\,B={[\\begin{aligned}\\frac{4}{5} \\\\ 0 \\\\ \\frac{3}{5}\\end{aligned}],[\\begin{aligned}a \\\\ b \\\\ c\\end{aligned}]}\n$$\n\nConsider the subspace $V$ and an **orthonormal** basis $B$ of $V,$ given above. Given that $B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $|a|+|b|+|c|?$" :question/worked-solution "First, let's denote\n\n$\\,$ ${a}_{1}=[\\begin{aligned}4 \\\\ 0 \\\\ 3\\end{aligned}]\\,$ and $\\,{a}_{2}=[\\begin{aligned}5 \\\\ -4 \\\\ 10\\end{aligned}].$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=[\\begin{aligned}4 \\\\ 0 \\\\ 3\\end{aligned}].$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{5\\cdot 4+(-4)\\cdot 0+10\\cdot 3}{{4}^{2}+{0}^{2}+{3}^{2}}{v}_{1} \\\\  & =[\\begin{aligned}5 \\\\ -4 \\\\ 10\\end{aligned}]-2[\\begin{aligned}4 \\\\ 0 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}-3 \\\\ -4 \\\\ 4\\end{aligned}].\\end{aligned}\n$$\n\nNow, we normalize each vector to get an orthonormal basis:\n\n- ${u}_{1}=\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{{4}^{2}+{0}^{2}+{3}^{2}}}[\\begin{aligned}4 \\\\ 0 \\\\ 3\\end{aligned}]=[\\begin{aligned}\\frac{4}{5} \\\\ 0 \\\\ \\frac{3}{5}\\end{aligned}].$\n\n- ${u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{(-3)^{2}+(-4)^{2}+{4}^{2}}}[\\begin{aligned}-3 \\\\ -4 \\\\ 4\\end{aligned}]=[\\begin{aligned}-\\frac{3\\sqrt{41}}{41} \\\\ -\\frac{4\\sqrt{41}}{41} \\\\ \\frac{4\\sqrt{41}}{41}\\end{aligned}].$\n\nTherefore, $B={{u}_{1},{u}_{2}}={[\\begin{aligned}\\frac{4}{5} \\\\ 0 \\\\ \\frac{3}{5}\\end{aligned}],[\\begin{aligned}-\\frac{3\\sqrt{41}}{41} \\\\ -\\frac{4\\sqrt{41}}{41} \\\\ \\frac{4\\sqrt{41}}{41}\\end{aligned}]}$ is an orthonormal basis of $V.$\n\nFinally, $a=-\\frac{3\\sqrt{41}}{41},$ $b=-\\frac{4\\sqrt{41}}{41},$ $c=\\frac{4\\sqrt{41}}{41}$ and  \n\n$$\n|a|+|b|+|c|=|-\\frac{3\\sqrt{41}}{41}|+|-\\frac{4\\sqrt{41}}{41}|+|\\frac{4\\sqrt{41}}{41}|=\\frac{11\\sqrt{41}}{41}.\n$$"}] [{:db/id #edb/ref 17592186365808 :knowledge-point/_questions [{:knowledge-point/id #uuid "16e43d27-ffaf-58ea-bb6e-664b70770003" :knowledge-point/title "Finding an Orthogonal Basis For the Span of Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e8d03df6-f7d0-59d1-85b2-3bffd57089b1" :answer/type {