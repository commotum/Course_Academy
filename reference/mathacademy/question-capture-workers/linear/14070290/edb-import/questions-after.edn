2} \\\\ \\frac{1}{2} \\\\ \\sqrt{7}\\end{aligned}]}$ is an orthogonal basis for $V.$\n\nFinally, we have $a=\\frac{5}{2},$ $b=\\frac{1}{2},$ and \n\n$$\n\\frac{b}{a}=\\frac{(\\frac{1}{2})}{(\\frac{5}{2})}=\\frac{1}{5}.\n$$"}] [{:db/id #edb/ref 17592186365822 :knowledge-point/_questions [{:knowledge-point/id #uuid "ccdefb8e-1bb5-52e9-812d-d2a5bffff731" :knowledge-point/title "Finding an Orthonormal Basis of a Vector Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2d169e4-7cda-5411-8937-68da7533a44a" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186365824} {:answer/id #uuid "cb362381-c0db-58c6-a904-be246616ebd1" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186365825} {:answer/id #uuid "f9ecde1c-19fd-5ea5-b4a1-9211dc1d7066" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{3}}{3}" :db/id #edb/ref 17592186365826} {:answer/id #uuid "a5b62e9a-6552-5681-a13a-e93f767a1fff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186365827} {:answer/id #uuid "4fff373f-59f2-523c-ad42-ab7a9d525699" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{3}" :db/id #edb/ref 17592186365828}] :answer-field/correct {:answer/id #uuid "cb362381-c0db-58c6-a904-be246616ebd1" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186365825} :answer-field/id #uuid "bc91a99c-3ac4-54dd-9f87-8c57714880b5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186365823}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "c07f366d-afc5-563b-b722-94e210283cd6" :question/math-academy-id "q-86858" :question/problem "$$\nV=\\text{Span}{[\\begin{aligned}-1 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}4 \\\\ -2 \\\\ 1\\end{aligned}]},\\,B={[\\begin{aligned}-\