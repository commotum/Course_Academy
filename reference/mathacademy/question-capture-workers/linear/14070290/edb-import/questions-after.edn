}_{1},{v}_{2}}={[\\begin{aligned}2 \\\\ -1 \\\\ 4\\end{aligned}],[\\begin{aligned}-\\frac{5}{3} \\\\ \\frac{10}{3} \\\\ \\frac{5}{3}\\end{aligned}]}$ is an orthogonal basis for $\\text{Col}(A).$\n\nFinally, $b=\\frac{10}{3},$ $c=\\frac{5}{3},$ and  \n\n$$\n\\frac{b}{c}=\\frac{(\\frac{10}{3})}{(\\frac{5}{3})}=2.\n$$"}] [{:db/id #edb/ref 17592186365766 :knowledge-point/_questions [{:knowledge-point/id #uuid "ccdefb8e-1bb5-52e9-812d-d2a5bffff731" :knowledge-point/title "Finding an Orthonormal Basis of a Vector Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33b3a29a-8921-5fc7-b727-ab1b052581c3" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186365768} {:answer/id #uuid "d8a6ee85-11a3-5ae3-bbf8-d6963cf4cb82" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186365769} {:answer/id #uuid "d6b4fdb2-e4da-50a8-99b5-6bb886c02623" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186365770} {:answer/id #uuid "53bc9a18-a05d-53f6-bd2f-497f2d4cff26" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{3}" :db/id #edb/ref 17592186365771} {:answer/id #uuid "69480397-adfc-559e-b482-a91da75074c1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186365772}] :answer-field/correct {:answer/id #uuid "d8a6ee85-11a3-5ae3-bbf8-d6963cf4cb82" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186365769} :answer-field/id #uuid "f21b7350-47cc-584b-a997-dc1c6b6c3bde" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186365767}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "82b6d02e-6952-5420-9b40-34001b0ef897" :question/math-academy-id "q-40743" :question/problem "$$\nA=[\\begin{aligned}1 & -3 \\\\ -1 & 3 \\\\ 2 & -3\\end{aligned}],\\,B={{u}_{1},{u}_{2}}={[\\begin{aligned}\\frac{\\sqrt{6}}{6} \\\\ -\\frac{\\sqrt{6}}{6} \\\\ \\frac{\\sqrt{6}}{3}\\end{aligned}],[\\begin{aligned}a \\\\ b \\\\ c\\end{aligned}]}\n$$\n\nConsider the subspace $\\text{Col}(A)$ and an **orthonormal** basis $B$ of $\\text{Col}(A),$ where $A$ and $B$ are given above. Given that $B$ is derived from $\\text{Col}(A)$ using the Gram-Schmidt process, what is the value of $|a|+|b|+|c|?$" :question/worked-solution "Recall that $\\text{Col}(A)$ is the span of the columns of $A.$  \n\nFirst, let's denote\n\n$\\,$ ${a}_{1}=[\\begin{aligned}1 \\\\ -1 \\\\ 2\\end{aligned}]\\,$ and $\\,{a}_{2}=[\\begin{aligned}-3 \\\\ 3 \\\\ -3\\end{aligned}].$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=[\\begin{aligned}1 \\\\ -1 \\\\ 2\\end{aligned}].$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{(-3)\\cdot 1+3\\cdot (-1)+(-3)\\cdot 2}{{1}^{2}+(-1)^{2}+{2}^{2}}{v}_{1} \\\\  & =[\\begin{aligned}-3 \\\\ 3 \\\\ -3\\end{aligned}]+[\\begin{aligned}2 \\\\ -2 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}].\\end{aligned}\n$$\n\nNow, we normalize each vector to get an orthonormal basis:\n\n- ${u}_{1}=\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{{1}^{2}+(-1)^{2}+{2}^{2}}}[\\begin{aligned}1 \\\\ -1 \\\\ 2\\end{aligned}]=[\\begin{aligned}\\frac{\\sqrt{6}}{6} \\\\ -\\frac{\\sqrt{6}}{6} \\\\ \\frac{\\sqrt{6}}{3}\\end{aligned}].$\n\n- ${u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{(-1)^{2}+{1}^{2}+{1}^{2}}}[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}]=[\\begin{aligned}-\\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3}\\end{aligned}].$\n\nTherefore, $B={{v}_{1},{v}_{2}}={[\\begin{aligned}\\frac{\\sqrt{6}}{6} \\\\ -\\frac{\\sqrt{6}}{6} \\\\ \\frac{\\sqrt{6}}{3}\\end{aligned}],[\\begin{aligned}-\\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3}\\end{aligned}]}$ is an orthonormal basis for $\\text{Col}(A).$\n\nFinally, $a=-\\frac{\\sqrt{3}}{3},$ $b=\\frac{\\sqrt{3}}{3},$ $c=\\frac{\\sqrt{3}}{3}$ and  \n\n$$\n|a|+|b|+|c|=|-\\frac{\\sqrt{3}}{3}|+|\\frac{\\sqrt{3}}{3}|+|\\frac{\\sqrt{3}}{3}|=\\sqrt{3}.\n$$"}] [{:db/id #edb/ref 17592186365773 :knowledge-point/_questions [{:knowledge-point/id #uuid "16e43d27-ffaf-58ea-bb6e-664b70770003" :knowledge-point/title "Finding an Orthogonal Basis For the Span of Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73be5941-3990-54c7-a242-c7f788f841d0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186365775} {:answer/id #uuid "8141208f-3669-5912-bd0c-05a0ac36807b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186365776} {:answer/id #uuid "7bda3e40-a3d4-5c56-ab2c-abd5b6684938" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186365777} {:answer/id #uuid "2f3547f5-6e4c-5a6f-87a0-81886aeda339" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186365778} {:answer/id #uuid "e9f7b97a-26e5-5144-8f26-70cf7a8ea9e4" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186365779}] :answer-field/correct {:answer/id #uuid "2f3547f5-6e4c-5a6f-87a0-81886aeda339" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186365778} :answer-field/id #uuid "52029c19-93b3-5db9-ada2-1f62778f6c95" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186365774}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "31ef4074-5e05-5e74-bf00-d149947b3c4c" :question/math-academy-id "q-41032" :question/problem "$$\nV=\\text{Span}{[\\begin{aligned}2 \\\\ -2 \\\\ -1\\end{aligned}],[\\begin{aligned}5 \\\\ 0 \\\\ 1\\end{aligned}]},\\,B={[\\begin{aligned}2 \\\\ -2 \\\\ -1\\end{aligned}],[\\begin{aligned}a \\\\ b \\\\ c\\end{aligned}]}\n$$\n\nConsider the subspace $V$ and an orthogonal basis $B$ of $V,$ given above. Given that $B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $\\frac{a}{b}?$" :question/worked-solution "First, let's denote\n\n$\\,$ ${a}_{1}=[\\begin{aligned}2 \\\\ -2 \\\\ -1\\end{aligned}]\\,$ and $\\,{a}_{2}=[\\begin{aligned}5 \\\\ 0 \\\\ 1\\end{aligned}].$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=[\\begin{aligned}2 \\\\ -2 \\\\ -1\\end{aligned}].$\n\n**Step 2**: Next, we find ${v}_{2}$, using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{5\\cdot 2+0\\cdot (-2)+1\\cdot (-1)}{{2}^{2}+(-2)^{2}+(-1)^{2}}{v}_{1} \\\\  & =[\\begin{aligned}5 \\\\ 0 \\\\ 1\\end{aligned}]-[\\begin{aligned}2 \\\\ -2 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}3 \\\\ 2 \\\\ 2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, $B={{v}_{1},{v}_{2}}={[\\begin{aligned}2 \\\\ -2 \\\\ -1\\end{aligned}],[\\begin{aligned}3 \\\\ 2 \\\\ 2\\end{aligned}]}$ is an orthogonal basis for $V.$\n\nFinally, $a=3,$ $b=2,$ and  \n\n$$\n\\frac{a}{b}=\\frac{3}{2}.\n$$"}] [{:db/id #edb/ref 17592186365780 :knowledge-point/_questions [{:knowledge-point/id #uuid "b15719b6-0ce4-5fb8-80be-abcaf9344a10" :knowledge-point/title "Finding an Orthogonal Basis For the Column Space of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f8113c3c-bb18-5719-9e9d-e39ea762cfa8" :answer/type {:db/ident :answer.type/math} 