ty :question.difficulty/easy :question/answer-fields ["q-34760/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6e4f1675-9146-5279-9b64-07a63a9bed99"] :knowledge-point/questions ["q-34760"] :db/ensure [:knowledge-point/validate]} {:db/id "q-75972/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "4ee694a0-3d42-586e-a149-359de26a0721" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-75972/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "88fccecb-330a-5a95-b97e-1b4c3b87e3a8" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-75972/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "88019d9b-1174-5aa4-aa2e-53e0b7053a57" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-75972/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "496fd45d-66c9-530d-9d92-76dcf03785ad" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-75972/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "2951fe69-44d3-51a7-a18d-2a4ad1ada921" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-75972/selection" :answer-field/id #uuid "c8b40f9e-d75c-5b48-b677-64be1aca5a5e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-75972/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer-field/choices ["q-75972/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" "q-75972/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" "q-75972/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-75972/selection/954f2b2ecf089f1c43903a