92f8a71c271fa3076456a3b" :answer/id #uuid "7cc83b96-76b2-54e7-931a-e329b2226f8c" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-112208/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "37f0aae3-fcde-50e3-bab4-5352b6c74dc7" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-112208/selection/f6dab1aaf947cb8c1f47690c13a34f270ff23312486a212e76af727dcf7e93a5" :answer/id #uuid "f8dc706c-f7e1-50de-a576-ba20c50033e2" :answer/type :answer.type/math :answer/value "x\\notin \\text{Span}{{b}_{1},{b}_{2},{b}_{3}}" :db/ensure [:answer/validate]} {:db/id "q-112208/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "754182ac-9548-56f5-98b1-4595edd5cfc8" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-112208/selection" :answer-field/id #uuid "0f72de21-6acd-56ed-b14e-634f553b4f01" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-112208/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-112208/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-112208/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-112208/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-112208/selection/f6dab1aaf947cb8c1f47690c13a34f270ff23312486a212e76af727dcf7e93a5" "q-112208/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-112208" :question/id #uuid "8584d99b-2ab1-5c27-a4e7-d130562b2404" :question/math-academy-id "q-112208" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B={{b}_{1},{b}_{2},{b}_{3}},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}],\\,{b}_{3}=[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}],\\,x=[\\begin{aligned}6 \\\\ 2 \\\\ 3\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]$ then what is the value of ${x}_{2}?$" :question/worked-solution "Remember, the order of the vectors in a basis is important.\n\nNotice that \n\n$$\n{{[\\begin{aligned}6 \\\\ 2 \\\\ 3\\end{aligned}]}_{⏟}}_{x}={{(\\,2\\,)}_{⏟}}_{{x}_{1}}\\cdot {{[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]}_{⏟}}_{{b}_{1}}+{{(\\,3\\,)}_{⏟}}_{{x}_{2}}\\cdot {{[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]}_{⏟}}_{{b}_{2}}+{{(\\,6\\,)}_{⏟}}_{{x}_{3}}\\cdot {{[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]}_{⏟}}_{{b}_{3}}\n$$\n\nwhich means that\n\n$$\nx=2\\cdot {b}_{1}+3\\cdot {b}_{2}+6\\cdot {b}_{3}\n$$\n\nand therefore \n\n$$\n[x]_{B}=[\\begin{aligned}2 \\\\ 3 \\\\ 6\\end{aligned}],\n$$\n\nFinally, ${x}_{2}=3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-112208/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a2926764-dfbc-5e4e-a6b0-db24a7298a64"] :knowledge-point/questions ["q-112208"] :db/ensure [:knowledge-point/validate]} {:db/id "q-112242/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "c4875985-edcb-5cd5-8bfe-0ac3d2ee7824" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-112242/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "73cb70b5-af17-5a76-942b-a3ed2355f449" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-112242/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "9e60f97f-fc03-579c-92c4-4ed2faf4d6e4" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-112242/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "24a8a667-e0fd-5375-bd39-9775c1b7620c" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-112242/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "0ff2fa20-abf7-52b6-a4e2-0036bfb6b1cc" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-112242/selection" :answer-field/id #uuid "9246335a-62f7-503a-97ea-ed74ae16da4d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-112242/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer-field/choices ["q-112242/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-112242/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-112242/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-112242/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-112242/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-112242" :question/id #uuid "413cbee8-b598-5cbf-b19b-566a259d8943" :question/math-academy-id "q-112242" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B={{b}_{1},{b}_{2}},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}-3 \\\\ 2 \\\\ 0\\end{aligned}],\\,x=[\\begin{aligned}-9 \\\\ 7 \\\\ 3\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ then what is the value of ${x}_{1}+{x}_{2}?$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2} & =x \\\\ {x}_{1}[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}]+{x}_{2}[\\begin{aligned}-3 \\\\ 2 \\\\ 0\\end{aligned}] & =[\\begin{aligned}-9 \\\\ 7 \\\\ 3\\end{aligned}].\\end{aligned}\n$$\n\nThe equation above gives the system with the augmented matrix\n\n$$\nM=[\\begin{aligned}2 & -3 & -9 \\\\ -1 & 2 & 7 \\\\ 1 & 0 & 3\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}2 & -3 & -9 \\\\ -1 & 2 & 7 \\\\ 1 & 0 & 3\\end{aligned}] & {R}_{1} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 3 \\\\ -1 & 2 & 7 \\\\ 2 & -3 & -9\\end{aligned}] & {R}_{1} & :={R}_{1}+{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 3 \\\\ 0 & 2 & 10 \\\\ 2 & -3 & -9\\end{aligned}] & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 3 \\\\ 0 & 2 & 10 \\\\ 0 & -3 & -15\\end{aligned}] & {R}_{3} & :={R}_{3}+\\frac{3}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 3 \\\\ 0 & 2 & 10 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n{\\begin{aligned}{x}_{1}=3 \\\\ 2{x}_{2}=10.\\end{aligned}\n$$\n\nFrom the second equation, we get ${x}_{2}=5.$ \n\nTherefore, $[x]_{B}=[\\begin{aligned}3 \\\\ 5\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=3+5=8.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-112242/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "841f498b-f737-5086-8f79-44f1a143bebb"] :knowledge-point/questions ["q-112242"] :db/ensure [:knowledge-point/validate]} {:db/id "q-112248/selection/23c0b4da815e7ba954fedc5e75955047cfe471feec4d2029849a63511c000fa3" :answer/id #uuid "a3ac504d-aa46-5ccf-8ec9-ce253c96321d" :answer/type :answer.type/math :answer/value "-11" :db/ensure [:answer/validate]} {:db/id "q-112248/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "8828ae3a-eaea-58ab-b7cc-ccf0c3a4c48c" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-112248/selection/ee656f2f7acc785a949760828ef3e60f674870aa37fc70a0a8d876b682813bfb" :answer/id #uuid "011a8e96-0993-517e-a5e6-7969ca3be482" :answer/type :answer.type/math :answer/value "x\\notin \\text{Span}{{b}_{1},{b}_{2}}" :db/ensure [:answer/validate]} {:db/id "q-112248/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer/id #uuid "5ff4aa1c-c6a9-505d-9480-20960f48be41" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "q-112248/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "78b74cea-788d-52e8-bea4-cc21c8707392" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-112248/selection" :answer-field/id #uuid "1dbfbab0-5111-57f5-a38f-f5fbd087c35d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-112248/selection/23c0b4da815e7ba954fedc5e75955047cfe471feec4d2029849a63511c000fa3" :answer-field/choices ["q-112248/selection/23c0b4da815e7ba954fedc5e75955047cfe471feec4d2029849a63511c000fa3" "q-112248/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" "q-112248/selection/ee656f2f7acc785a949760828ef3e60f674870aa37fc70a0a8d876b682813bfb" "q-112248/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" "q-112248/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133"] :db/ensure [:answer-field/validate]} {:db/id "q-112248" :question/id #uuid "a97dc568-4c19-58fa-9b11-454130c0a6c4" :question/math-academy-id "q-112248" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B={{b}_{1},{b}_{2}},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}1 \\\\ -5\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}-3 \\\\ 2\\end{aligned}],\\,x=[\\begin{aligned}-3 \\\\ 41\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ then what is the value of ${x}_{1}+{x}_{2}?$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2} & =x \\\\ {x}_{1}[\\begin{aligned}1 \\\\ -5\\end{aligned}]+{x}_{2}[\\begin{aligned}-3 \\\\ 2\\end{aligned}] & =[\\begin{aligned}-3 \\\\ 41\\end{aligned}].\\end{aligned}\n$$\n\nThe equation above gives the system with the augmented matrix\n\n$$\nM=[\\begin{aligned}1 & -3 & -3 \\\\ -5 & 2 & 41\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -3 & -3 \\\\ -5 & 2 & 41\\end{aligned}] & {R}_{2} & :={R}_{2}+5{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & -3 \\\\ 0 & -13 & 26\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n{\\begin{aligned}{x}_{1}-3{x}_{2}=-3 \\\\ -13{x}_{2}=26.\\end{aligned}\n$$\n\nFrom the second equation, we get ${x}_{2}=-2.$ Substituting this into the first equation, we obtain\n\n$$\n{x}_{1}-3(-2)=-3\\,⟹\\,{x}_{1}=-9.\n$$\n\nTherefore, $[x]_{B}=[\\begin{aligned}-9 \\\\ -2\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=(-9)+(-2)=-11.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-112248/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "841f498b-f737-5086-8f79-44f1a143bebb"] :knowledge-point/questions ["q-112248"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186120285 :question/answer-fields 17592186118185] {:db/id "q-34617/selection/ma-v1/d2c4de6ad64fc6a4179e6ea9980296d04b3184b8c51841372dabb8680068f529/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "cd4d5e0d-6f55-5693-ab9a-c3f142ae1c1b" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-34617/selection/ma-v1/d2c4de6ad64fc6a4179e6ea9980296d04b3184b8c51841372dabb8680068f529/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "3516d133-9201-5577-b0c8-72fae9569599" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-34617/selection/ma-v1/d2c4de6ad64fc6a4179e6ea9980296d04b3184b8c51841372dabb8680068f529/ee656f2f7acc785a949760828ef3e60f674870aa37fc70a0a8d876b682813bfb" :answer/id #uuid "523d2a17-8094-5db0-a745-0055c936fbc0" :answer/type :answer.type/math :answer/value "x\\notin \\text{Span}{{b}_{1},{b}_{2}}" :db/ensure [:answer/validate]} {:db/id "q-34617/selection/ma-v1/d2c4de6ad64fc6a4179e6ea9980296d04b3184b8c51841372dabb8680068f529/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "fe7b058e-2ca5-5751-9b36-9f86c5dedebb" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-34617/selection/ma-v1/d2c4de6ad64fc6a4179e6ea9980296d04b3184b8c51841372dabb8680068f529/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "72a2abdb-0e9b-566b-b3f0-d0d1c9a4046b" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-34617/selection/ma-v1/d2c4de6ad64fc6a4179e6ea9980296d04b3184b8c51841372dabb8680068f529" :answer-field/id #uuid "0b268451-011d-5331-93df-abb15112bf90" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-34617/selection/ma-v1/d2c4de6ad64fc6a4179e6ea9980296d04b3184b8c51841372dabb8680068f529/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-34617/selection/ma-v1/d2c4de6ad64fc6a4179e6ea9980296d04b3184b8c51841372dabb8680068f529/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-34617/selection/ma-v1/d2c4de6ad64fc6a4179e6ea9980296d04b3184b8c51841372dabb8680068f529/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-34617/selection/ma-v1/d2c4de6ad64fc6a4179e6ea9980296d04b3184b8c51841372dabb8680068f529/ee656f2f7acc785a949760828ef3e60f674870aa37fc70a0a8d876b682813bfb" "q-34617/selection/ma-v1/d2c4de6ad64fc6a4179e6ea9980296d04b3184b8c51841372dabb8680068f529/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-34617/selection/ma-v1/d2c4de6ad64fc6a4179e6ea9980296d04b3184b8c51841372dabb8680068f529/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-34617"] :question/problem "Find the coordinates of the vector $x$ relative to the basis $B={{b}_{1},{b}_{2}},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}1 \\\\ -2\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}2 \\\\ 1\\end{aligned}],\\,x=[\\begin{aligned}2 \\\\ 6\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ then what is the value of ${x}_{1}+{x}_{2}?$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2} & =x \\\\ {x}_{1}[\\begin{aligned}1 \\\\ -2\\end{aligned}]+{x}_{2}[\\begin{aligned}2 \\\\ 1\\end{aligned}] & =[\\begin{aligned}2 \\\\ 6\\end{aligned}].\\end{aligned}\n$$\n\nThe equation above gives the system with the augmented matrix\n\n$$\nM=[\\begin{aligned}1 & 2 & 2 \\\\ -2 & 1 & 6\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 2 & 2 \\\\ -2 & 1 & 6\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & 2 \\\\ 0 & 5 & 10\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n{\\begin{aligned}{x}_{1}+2{x}_{2}=2 \\\\ 5{x}_{2}=10.\\end{aligned}\n$$\n\nFrom the second equation, we get ${x}_{2}=2.$ Substituting this into the first equation, we obtain\n\n$$\n{x}_{1}+2(2)=2\\,⟹\\,{x}_{1}=-2.\n$$\n\nTherefore, $[x]_{B}=[\\begin{aligned}-2 \\\\ 2\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=(-2)+2=0.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-34617/selection/ma-v1/d2c4de6ad64fc6a4179e6ea9980296d04b3184b8c51841372dabb8680068f529"] :db/ensure [:question/validate]} {:db/id "q-75989/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "9fab14b8-5b76-5ebc-a951-0974de0053f1" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-75989/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "c1adf9b8-757a-5591-bd41-0945f4f3ebdb" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-75989/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "101d640c-9d3b-5fe1-8b5b-942a69311cf2" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-75989/selection/ee656f2f7acc785a949760828ef3e60f674870aa37fc70a0a8d876b682813bfb" :answer/id #uuid "32aa3c23-6c3c-53ce-8d37-8bbbf36699d1" :answer/type :answer.type/math :answer/value "x\\notin \\text{Span}{{b}_{1},{b}_{2}}" :db/ensure [:answer/validate]} {:db/id "q-75989/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "d3560207-ea34-5342-800c-9809ff445db1" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-75989/selection" :answer-field/id #uuid "78c8e017-14e5-5a53-9234-8eb4be444efe" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-75989/selection/ee656f2f7acc785a949760828ef3e60f674870aa37fc70a0a8d876b682813bfb" :answer-field/choices ["q-75989/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-75989/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-75989/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-75989/selection/ee656f2f7acc785a949760828ef3e60f674870aa37fc70a0a8d876b682813bfb" "q-75989/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-75989" :question/id #uuid "a3792d36-5f2e-5d45-b116-f88bebb471ff" :question/math-academy-id "q-75989" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B={{b}_{1},{b}_{2}},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}1 \\\\ 2 \\\\ 1\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}2 \\\\ 1 \\\\ 2\\end{aligned}],\\,x=[\\begin{aligned}1 \\\\ 5 \\\\ 2\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ then what is the value of ${x}_{1}+{x}_{2}?$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2} & =x \\\\ {x}_{1}[\\begin{aligned}1 \\\\ 2 \\\\ 1\\end{aligned}]+{x}_{2}[\\begin{aligned}2 \\\\ 1 \\\\ 2\\end{aligned}] & =[\\begin{aligned}1 \\\\ 5 \\\\ 2\\end{aligned}].\\end{aligned}\n$$\n\nThe equation above gives the system with the augmented matrix\n\n$$\nM=[\\begin{aligned}1 & 2 & 1 \\\\ 2 & 1 & 5 \\\\ 1 & 2 & 2\\end{aligned}].\n$$\n\nNow, we reduce $M$ using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 2 & 1 \\\\ 2 & 1 & 5 \\\\ 1 & 2 & 2\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & 1 \\\\ 0 & -3 & 3 \\\\ 1 & 2 & 2\\end{aligned}] & {R}_{3} & :={R}_{3}+(-1){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & 1 \\\\ 0 & -3 & 3 \\\\ 0 & 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n{\\begin{aligned}{x}_{1}+2{x}_{2}=1 \\\\ -3{x}_{2}=3 \\\\ 0=1,\\end{aligned}\n$$\n\nwhere the third equation is always false. Therefore, the system has no solution and we conclude that $x\\notin \\text{Span}{{b}_{1},{b}_{2}}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-75989/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "841f498b-f737-5086-8f79-44f1a143bebb"] :knowledge-point/questions ["q-75989"] :db/ensure [:knowledge-point/validate]} {:db/id "q-34741/selection/d278d4936eb1c69dc660a77f5f1c7b1eb5b4a4db4aee8a8ad2dc52aa3f827f2e" :answer/id #uuid "4d306810-d0f3-5da8-b786-19b561535cd9" :answer/type :answer.type/math :answer/value "\\frac{5}{4}" :db/ensure [:answer/validate]} {:db/id "q-34741/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "468d8c67-dd00-5387-8108-0d61134af7b2" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-34741/selection/a272cbe64fea514fe5c8c9685aef2c9378fdfe44c54941c8bcba64a5f713bc84" :answer/id #uuid "cb03703d-7d3c-5a74-963c-03378a9566a6" :answer/type :answer.type/math :answer/value "\\frac{7}{8}" :db/ensure [:answer/validate]} {:db/id "q-34741/selection/81ec9cf26b4d634e9c6dd41dfa456114165178124fc4fbd86ade95b2369b8a6b" :answer/id #uuid "0420573c-7608-5c0e-aa13-77edcc13d575" :answer/type :answer.type/math :answer/value "x\\notin \\text{span}{{b}_{1},{b}_{2}}" :db/ensure [:answer/validate]} {:db/id "q-34741/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer/id #uuid "713931b7-b925-5a2a-b835-cfc33af3c87b" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "q-34741/selection" :answer-field/id #uuid "15cd6f0d-31a1-5674-b72e-1ca9815fc6dd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-34741/selection/a272cbe64fea514fe5c8c9685aef2c9378fdfe44c54941c8bcba64a5f713bc84" :answer-field/choices ["q-34741/selection/d278d4936eb1c69dc660a77f5f1c7b1eb5b4a4db4aee8a8ad2dc52aa3f827f2e" "q-34741/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-34741/selection/a272cbe64fea514fe5c8c9685aef2c9378fdfe44c54941c8bcba64a5f713bc84" "q-34741/selection/81ec9cf26b4d634e9c6dd41dfa456114165178124fc4fbd86ade95b2369b8a6b" "q-34741/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142"] :db/ensure [:answer-field/validate]} {:db/id "q-34741" :question/id #uuid "db704894-2037-5bf0-be1f-49d13ea86704" :question/math-academy-id "q-34741" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B={{b}_{1},{b}_{2}},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}2 \\\\ -5 \\\\ 6\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}4 \\\\ -2 \\\\ 4\\end{aligned}],\\,x=[\\begin{aligned}2 \\\\ -4 \\\\ 5\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ then what is the value of ${x}_{1}+{x}_{2}?$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that  \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2} & =x \\\\ {x}_{1}[\\begin{aligned}2 \\\\ -5 \\\\ 6\\end{aligned}]+{x}_{2}[\\begin{aligned}4 \\\\ -2 \\\\ 4\\end{aligned}] & =[\\begin{aligned}2 \\\\ -4 \\\\ 5\\end{aligned}].\\end{aligned}\n$$\n\nThe equation above gives the system with the augmented matrix\n\n$$\nM=[\\begin{aligned}2 & 4 & 2 \\\\ -5 & -2 & -4 \\\\ 6 & 4 & 5\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following: \n\n$$\n\\begin{aligned}M & =[\\begin{aligned}2 & 4 & 2 \\\\ -5 & -2 & -4 \\\\ 6 & 4 & 5\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{5}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}2 & 4 & 2 \\\\ 0 & 8 & 1 \\\\ 6 & 4 & 5\\end{aligned}] & {R}_{3} & :={R}_{3}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}2 & 4 & 2 \\\\ 0 & 8 & 1 \\\\ 0 & -8 & -1\\end{aligned}] & {R}_{3} & :={R}_{3}+{R}_{2} \\\\  & ∼[\\begin{aligned}2 & 4 & 2 \\\\ 0 & 8 & 1 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\n \n\nThe system is now \n\n$$\n{\\begin{aligned}2{x}_{1}+4{x}_{2}=2 \\\\ 8{x}_{2}=1.\\end{aligned}\n$$\n\nFrom the second equation, we get ${x}_{2}=\\frac{1}{8}.$ Substituting this into the first equation, we obtain\n\n$$\n2{x}_{1}+4\\cdot \\frac{1}{8}=2\\,⟹\\,{x}_{1}=\\frac{3}{4}.\n$$\n\nTherefore, $[x]_{B}=[\\begin{aligned}\\frac{3}{4} \\\\ \\frac{1}{8}\\end{aligned}].$ \n\nFinally, ${x}_{1}+{x}_{2}=\\frac{3}{4}+\\frac{1}{8}=\\frac{7}{8}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-34741/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "841f498b-f737-5086-8f79-44f1a143bebb"] :knowledge-point/questions ["q-34741"] :db/ensure [:knowledge-point/validate]} {:db/id "q-76056/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "ccfe7f65-bcbd-5885-bbc9-020116b3699f" :answer/type :answer.type/ma