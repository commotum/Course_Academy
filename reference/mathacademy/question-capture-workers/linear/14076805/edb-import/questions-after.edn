2\\end{aligned}].$"}] [{:db/id #edb/ref 17592186383586 :knowledge-point/_questions [{:knowledge-point/id #uuid "ee6832be-62e1-506c-9b78-685f65362117" :knowledge-point/title "Finding the Principal Axes of a Quadratic Plane Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2a0f586-3fe4-5db2-9bbb-e73db2312994" :answer/type {:db/ident :answer.type/text} :answer/value "$\\frac{1}{\\sqrt{10}}[\\begin{aligned}1 \\\\ 3\\end{aligned}]\\,$ and $\\,\\frac{1}{\\sqrt{10}}[\\begin{aligned}-3 \\\\ 1\\end{aligned}]$" :db/id #edb/ref 17592186383588} {:answer/id #uuid "90ffe2e5-1380-5278-81e7-3bba0f69f756" :answer/type {:db/ident :answer.type/text} :answer/value "$\\frac{1}{\\sqrt{17}}[\\begin{aligned}4 \\\\ 1\\end{aligned}]\\,$ and $\\,\\frac{1}{\\sqrt{17}}[\\begin{aligned}-1 \\\\ 4\\end{aligned}]$" :db/id #edb/ref 17592186383589} {:answer/id #uuid "55cb96b8-f8e5-5ef9-9958-3aa7b48f3044" :answer/type {:db/ident :answer.type/text} :answer/value "$\\frac{1}{5}[\\begin{aligned}4 \\\\ 3\\end{aligned}]\\,$ and $\\,\\frac{1}{5}[\\begin{aligned}-3 \\\\ 4\\end{aligned}]$" :db/id #edb/ref 17592186383590} {:answer/id #uuid "3c69cba2-74d1-5d12-863a-6e1f734ec6d1" :answer/type {:db/ident :answer.type/text} :answer/value "$\\frac{1}{\\sqrt{5}}[\\begin{aligned}2 \\\\ 1\\end{aligned}]\\,$ and $\\,\\frac{1}{\\sqrt{5}}[\\begin{aligned}-1 \\\\ 2\\end{aligned}]$" :db/id #edb/ref 17592186383591} {:answer/id #uuid "6bc5490b-0a80-59bd-b8d1-d2ea97c4ca38" :answer/type {:db/ident :answer.type/text} :answer/value "$\\frac{1}{\\sqrt{13}}[\\begin{aligned}2 \\\\ 3\\end{aligned}]\\,$ and $\\,\\frac{1}{\\sqrt{13}}[\\begin{aligned}-3 \\\\ 2\\end{aligned}]$" :db/id #edb/ref 17592186383592}] :answer-field/correct {:answer/id #uuid "55cb96b8-f8e5-5ef9-9958-3aa7b48f3044" :answer/type {:db/ident :answer.type/text} :answer/value "$\\frac{1}{5}[\\begin{aligned}4 \\\\ 3\\end{aligned}]\\,$ and $\\,\\frac{1}{5}[\\begin{aligned}-3 \\\\ 4\\end{aligned}]$" :db/id #edb/ref 17592186383590} :answer-field/id #uuid "fca7bd62-6c64-59d7-9614-84d916bd4c29" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383587}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "0cec331c-560b-5802-99a0-d8554eb80573" :question/math-academy-id "q-95810" :question/problem "Find the principal axes of the curve $4{x}_{1}^{2}+24{x}_{1}{x}_{2}-3{x}_{2}^{2}=72.$" :question/worked-solution "First, consider the quadratic form $Q(x)=4{x}_{1}^{2}+24{x}_{1}{x}_{2}-3{x}_{2}^{2}.$ The matrix of the form is\n\n$$\nA=[\\begin{aligned}4 & 12 \\\\ 12 & -3\\end{aligned}].\n$$\n\nNotice that $A$ is symmetric. The principal axes of the curve \n\n$$\n{x}^{T}\\,Ax=1\n$$\n\nare the vectors that form an orthonormal eigenvector basis of $A.$ \n\nBy solving the characteristic equation $|A-\\lambda I|=0,$ we obtain\n\n$\\,$ ${\\lambda }_{1}=13\\,$ and $\\,{\\lambda }_{2}=-12.$\n\nLet's now find the eigenvectors.\n\n- For ${\\lambda }_{1}=13,$ we have\n\n$$\n\\begin{aligned}A-13I & =[\\begin{aligned}4 & 12 \\\\ 12 & -3\\end{aligned}]-13[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}-9 & 12 \\\\ 12 & -16\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-13I)x=0$ gives the eigenvector ${v}_{1}=[\\begin{aligned}4 \\\\ 3\\end{aligned}].$ Dividing ${v}_{1}$ by its norm $‖{v}_{1}‖=5,$ we get \n\n$$\n\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{5}[\\begin{aligned}4 \\\\ 3\\end{aligned}].\n$$\n\n- For ${\\lambda }_{2}=-12,$ we have\n\n$$\n\\begin{aligned}A-(-12)I & =[\\begin{aligned}4 & 12 \\\\ 12 & -3\\end{aligned}]+12[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}16 & 12 \\\\ 12 & 9\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-(-12)I)x=0$ gives the eigenvector ${v}_{2}=[\\begin{aligned}-3 \\\\ 4\\end{aligned}].$ Dividing ${v}_{2}$ by its norm $‖{v}_{2}‖=5,$ we get \n\n$$\n\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{5}[\\begin{aligned}-3 \\\\ 4\\end{aligned}].\n$$\n\nTherefore, the principal axes of our curve are\n\n$\\,$ $\\frac{1}{5}[\\begin{aligned}4 \\\\ 3\\end{aligned}]\\,$ and $\\,\\frac{1}{5}[\\begin{aligned}-3 \\\\ 4\\end{aligned}].$"}] [{:db/id #edb/ref 17592186162607 :knowledge-point/_questions [{:knowledge-point/id #uuid "cf2e573c-f351-5d5a-8e59-9c6532f1ab9d" :knowledge-point/title "Identifying the Principal Axes of a Quadratic Curve Using a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a23584f-4232-5a34-9cf2-8913689e8fce" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/3129/Source/Images/q-96031-a-4.png" :db/id #edb/ref 17592186161275} {:answer/id #uuid "c36067ad-b8f6-5114-a6d9-1910f202198a" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/3129/Source/Images/q-96031-a-5.png" :db/id #edb/ref 17592186161276} {:answer/id #uuid "dc1099bd-4821-5c2f-82a6-2deb7dadf175" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/3129/Source/Images/q-96031-a-2.png" :db/id #edb/ref 17592186161277} {:answer/id #uuid "41b701f8-2014-59dc-9964-39560ba34974" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/3129/Source/Images/q-96031-a-1.png" :db/id #edb/ref 17592186161278} {:answer/id #uuid "4c9d8cf7-5115-59a6-b4ce-8a99d83728b3" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/3129/Source/Images/q-96031-a-3.png" :db/id #edb/ref 17592186161279}] :answer-field/correct {:answer/id #uuid "41b701f8-2014-59dc-9964-39560ba34974" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/3129/Source/Images/q-96031-a-1.png" :db/id #edb/ref 17592186161278} :answer-field/id #uuid "a974994b-7115-58ea-a231-959690e5e5fb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref