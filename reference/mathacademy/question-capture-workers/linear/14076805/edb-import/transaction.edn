{5},$ we get \n\n$$\n\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{5}}[\\begin{aligned}-2 \\\\ 1\\end{aligned}].\n$$\n\n- For ${\\lambda }_{2}=0,$ we have\n\n$$\n\\begin{aligned}A-0I & =[\\begin{aligned}4 & -2 \\\\ -2 & 1\\end{aligned}]-0[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}4 & -2 \\\\ -2 & 1\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-0I)x=0$ gives the eigenvector ${v}_{2}=[\\begin{aligned}1 \\\\ 2\\end{aligned}].$ Dividing ${v}_{2}$ by its norm $‖{v}_{2}‖=\\sqrt{5},$ we get \n\n$$\n\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{5}}[\\begin{aligned}1 \\\\ 2\\end{aligned}].\n$$\n\nTherefore, the principal axes of our curve are\n\n$\\,$ $\\frac{1}{\\sqrt{5}}[\\begin{aligned}-2 \\\\ 1\\end{aligned}]\\,$ and $\\,\\frac{1}{\\sqrt{5}}[\\begin{aligned}1 \\\\ 2\\end{aligned}].$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-95808/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ee6832be-62e1-506c-9b78-685f65362117"] :knowledge-point/questions ["q-95808"] :db/ensure [:knowledge-point/validate]} {:db/id "q-95806/selection/9946a6591a484bfd820474c755ab3073410cd966f4d790c250ee7fd8bec9ac67" :answer/id #uuid "e72c7240-e7d8-5752-8639-1ac7d92ecee9" :answer/type :answer.type/text :answer/value "$\\frac{1}{\\sqrt{5}}[\\begin{aligned}1 \\\\ 2\\end{aligned}]\\,$ and $\\,\\frac{1}{\\sqrt{5}}[\\begin{aligned}-2 \\\\ 1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-95806/selection/0d886085183df1a260e428d1bf8f690275217f82e75e86d5e87f88eebd8a758f" :answer/id #uuid "ab47c137-7e18-5621-8368-5cd5c53f5dd4" :answer/type :answer.type/text :answer/value "$\\frac{1}{\\sqrt{10}}[\\begin{aligned}1 \\\\ 3\\end{aligned}]\\,$ and $\\,\\frac{1}{\\sqrt{10}}[\\begin{aligned}-3 \\\\ 1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-95806/selection/5f765ac255c1b78ca55ccd2342d5bc0426b7fdf137ab50f26c0f4bc17f71543a" :answer/id #uuid "d09b551b-6f73-5a41-93da-519aab8797b3" :answer/type :answer.type/text :answer/value "$\\frac{1}{\\sqrt{3}}[\\begin{aligned}-\\sqrt{2} \\\\ 1\\end{aligned}]\\,$ and $\\,\\frac{1}{\\sqrt{3}}[\\begin{aligned}1 \\\\ \\sqrt{2}\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-95806/selection/67b8cebd0db609471c38b5ada2ac1137dbbb9116b1a15ec8e85809b8a2ac12d1" :answer/id #uuid "a8ddd895-787a-5cab-a4bf-9ef8e06933ca" :answer/type :answer.type/text :answer/value "$\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]\\,$ and $\\,\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ 1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-95806/selection/173ca1044a302373109db6618949f4e6f7fd5753f94e2462b5a9947d37f94a4d" :answer/id #uuid "06dda8d5-74dc-56af-96a1-bece69eb2877" :answer/type :answer.type/text :answer/value "$\\frac{1}{\\sqrt{13}}[\\begin{aligned}-3 \\\\ 2\\end{aligned}]\\,$ and $\\,\\frac{1}{\\sqrt{13}}[\\begin{aligned}2 \\\\ 3\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-95806/selection" :answer-field/id #uuid "54127762-40ae-5140-bead-918a471f3ca3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-95806/selection/67b8cebd0db609471c38b5ada2ac1137dbbb9116b1a15ec8e85809b8a2ac12d1" :answer-field/choices ["q-95806/selection/9946a6591a484bfd820474c755ab3073410cd966f4d790c250ee7fd8bec9ac67" "q-95806/selection/0d886085183df1a260e428d1bf8f690275217f82e75e86d5e87f88eebd8a758f" "q-95806/selection/5f765ac255c1b78ca55ccd2342d5bc0426b7fdf137ab50f26c0f4bc17f71543a" "q-95806/selection/67b8cebd0db609471c38b5ada2ac1137dbbb9116b1a15ec8e85809b8a2ac12d1" "q-95806/selection/173ca1044a302373109db6618949f4e6f7fd5753f94e2462b5a9947d37f94a4d"] :db/ensure [:answer-field/validate]} {:db/id "q-95806" :question/id #uuid "32b90dfa-ec90-5077-b365-15209caf0421" :question/math-academy-id "q-95806" :question/problem "Find the principal axes of the curve $2{x}_{1}^{2}-4{x}_{1}{x}_{2}+2{x}_{2}^{2}=9.$" :question/worked-solution "First, consider the quadratic form $Q(x)=2{x}_{1}^{2}-4{x}_{1}{x}_{2}+2{x}_{2}^{2}.$ The matrix of the form is\n\n$$\nA=[\\begin{aligned}2 & -2 \\\\ -2 & 2\\end{aligned}].\n$$\n\nNotice that $A$ is symmetric. The principal axes of the curve \n\n$$\n{x}^{T}\\,Ax=9\n$$\n\nare the vectors that form an orthonormal eigenvector basis of $A.$ \n\nBy solving the characteristic equation $|A-\\lambda I|=0,$ we obtain\n\n$\\,$ ${\\lambda }_{1}=4\\,$ and $\\,{\\lambda }_{2}=0.$\n\nLet's now find the eigenvectors.\n\n- For ${\\lambda }_{1}=4,$ we have\n\n$$\n\\begin{aligned}A-4I & =[\\begin{aligned}2 & -2 \\\\ -2 & 2\\end{aligned}]-4[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}-2 & -2 \\\\ -2 & -2\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-6I)x=0$ gives the eigenvector ${v}_{1}=[\\begin{aligned}-1 \\\\ 1\\end{aligned}].$ Dividing ${v}_{1}$ by its norm $‖{v}_{1}‖=\\sqrt{2},$ we get \n\n$$\n\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 \\\\ 1\\end{aligned}].\n$$\n\n- For ${\\lambda }_{2}=0,$ we have\n\n$$\n\\begin{aligned}A-0I & =[\\begin{aligned}2 & -2 \\\\ -2 & 2\\end{aligned}]-0[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}2 & -2 \\\\ -2 & 2\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-0I)x=0$ gives the eigenvector ${v}_{2}=[\\begin{aligned}1 \\\\ 1\\end{aligned}].$ Dividing ${v}_{2}$ by its norm $‖{v}_{2}‖=\\sqrt{2},$ we get \n\n$$\n\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ 1\\end{aligned}].\n$$\n\nTherefore, the principal axes of our curve are\n\n$\\,$ $\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]\\,$ and $\\,\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ 1\\end{aligned}].$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-95806/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ee6832be-62e1-506c-9b78-685f65362117"] :knowledge-point/questions ["q-95806"] :db/ensure [:knowledge-point/validate]} {:db/id "q-95810/selection/b63bf283a78bf3276dfbd3678bb21affdeea1cd25e362531a83ef978fcac20f0" :answer/id #uuid "3c69cba2-74d1-5d12-863a-6e1f734ec6d1" :answer/type :answer.type/text :answer/value "$\\frac{1}{\\sqrt{5}}[\\begin{aligned}2 \\\\ 1\\end{aligned}]\\,$ and $\\,\\frac{1}{\\sqrt{5}}[\\begin{aligned}-1 \\\\ 2\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-95810/selection/7d34d2935917069f38103b8c8bc59cdf07117bf5b0dda9669bb7a0ac36d96f59" :answer/id #uuid "55cb96b8-f8e5-5ef9-9958-3aa7b48f3044" :answer/type :answer.type/text :answer/value "$\\frac{1}{5}[\\begin{aligned}4 \\\\ 3\\end{aligned}]\\,$ and $\\,\\frac{1}{5}[\\begin{aligned}-3 \\\\ 4\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-95810/selection/c00cf52e39054b9b2a40b5aac29e88cc15953defb404ef0a6003237fd552be9b" :answer/id #uuid "6bc5490b-0a80-59bd-b8d1-d2ea97c4ca38" :answer/type :answer.type/text :answer/value "$\\frac{1}{\\sqrt{13}}[\\begin{aligned}2 \\\\ 3\\end{aligned}]\\,$ and $\\,\\frac{1}{\\sqrt{13}}[\\begin{aligned}-3 \\\\ 2\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-95810/selection/0d886085183df1a260e428d1bf8f690275217f82e75e86d5e87f88eebd8a758f" :answer/id #uuid "b2a0f586-3fe4-5db2-9bbb-e73db2312994" :answer/type :answer.type/text :answer/value "$\\frac{1}{\\sqrt{10}}[\\begin{aligned}1 \\\\ 3\\end{aligned}]\\,$ and $\\,\\frac{1}{\\sqrt{10}}[\\begin{aligned}-3 \\\\ 1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-95810/selection/370c356d324c7aae6b112b643fdfb2c2a7bdaadb6fe4ba16e8453a535e3f1bce" :answer/id #uuid "90ffe2e5-1380-5278-81e7-3bba0f69f756" :answer/type :answer.type/text :answer/value "$\\frac{1}{\\sqrt{17}}[\\begin{aligned}4 \\\\ 1\\end{aligned}]\\,$ and $\\,\\frac{1}{\\sqrt{17}}[\\begin{aligned}-1 \\\\ 4\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-95810/selection" :answer-field/id #uuid "fca7bd62-6c64-59d7-9614-84d916bd4c29" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-95810/selection/7d34d2935917069f38103b8c8bc59cdf07117bf5b0dda9669bb7a0ac36d96f59" :answer-field/choices ["q-95810/selection/b63bf283a78bf3276dfbd3678bb21affdeea1cd25e362531a83ef978fcac20f0" "q-95810/selection/7d34d2935917069f38103b8c8bc59cdf07117bf5b0dda9669bb7a0ac36d96f59" "q-95810/selection/c00cf52e39054b9b2a40b5aac29e88cc15953defb404ef0a6003237fd552be9b" "q-95810/selection/0d886085183df1a260e428d1bf8f690275217f82e75e86d5e87f88eebd8a758f" "q-95810/selection/370c356d324c7aae6b112b643fdfb2c2a7bdaadb6fe4ba16e8453a535e3f1bce"] :db/ensure [:answer-field/validate]} {:db/id "q-95810" :question/id #uuid "0cec331c-560b-5802-99a0-d8554eb80573" :question/math-academy-id "q-95810" :question/problem "Find the principal axes of the curve $4{x}_{1}^{2}+24{x}_{1}{x}_{2}-3{x}_{2}^{2}=72.$" :question/worked-solution "First, consider the quadratic form $Q(x)=4{x}_{1}^{2}+24{x}_{1}{x}_{2}-3{x}_{2}^{2}.$ The matrix of the form is\n\n$$\nA=[\\begin{aligned}4 & 12 \\\\ 12 & -3\\end{aligned}].\n$$\n\nNotice that $A$ is symmetric. The principal axes of the curve \n\n$$\n{x}^{T}\\,Ax=1\n$$\n\nare the vectors that form an orthonormal eigenvector basis of $A.$ \n\nBy solving the characteristic equation $|A-\\lambda I|=0,$ we obtain\n\n$\\,$ ${\\lambda }_{1}=13\\,$ and $\\,{\\lambda }_{2}=-12.$\n\nLet's now find the eigenvectors.\n\n- For ${\\lambda }_{1}=13,$ we have\n\n$$\n\\begin{aligned}A-13I & =[\\begin{aligned}4 & 12 \\\\ 12 & -3\\end{aligned}]-13[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}-9 & 12 \\\\ 12 & -16\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-13I)x=0$ gives the eigenvector ${v}_{1}=[\\begin{aligned}4 \\\\ 3\\end{aligned}].$ Dividing ${v}_{1}$ by its norm $‖{v}_{1}‖=5,$ we get \n\n$$\n\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{5}[\\begin{aligned}4 \\\\ 3\\end{aligned}].\n$$\n\n- For ${\\lambda }_{2}=-12,$ we have\n\n$$\n\\begin{aligned}A-(-12)I & =[\\begin{aligned}4 & 12 \\\\ 12 & -3\\end{aligned}]+12[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}16 & 12 \\\\ 12 & 9\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-(-12)I)x=0$ gives the eigenvector ${v}_{2}=[\\begin{aligned}-3 \\\\ 4\\end{aligned}].$ Dividing ${v}_{2}$ by its norm $‖{v}_{2}‖=5,$ we get \n\n$$\n\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{5}[\\begin{aligned}-3 \\\\ 4\\end{aligned}].\n$$\n\nTherefore, the principal axes of our curve are\n\n$\\,$ $\\frac{1}{5}[\\begin{aligned}4 \\\\ 3\\end{aligned}]\\,$ and $\\,\\frac{1}{5}[\\begin{aligned}-3 \\\\ 4\\end{aligned}].$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-95810/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ee6832be-62e1-506c-9b78-685f65362117"] :knowledge-point/questions ["q-95810"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-8473"] :question/problem "Draw a diagram that depicts the lines representing the principal axes of the quadratic curve shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076805/assets/5354b2fa6d2fb2c8b1b9ea3cb675225619e8debe64e1ec108b556248d6e672ec.png)" :question/worked-solution "The principal axes of a curve define a coordinate system in which the curve can be represented by its (simplest) canonical equation. \n\nOur curve is a hyperbola. This curve will have the canonical equation of the form\n\n$$\n\\dfrac{x^2}{a^2} - \\dfrac{y^2}{b^2} = 1\n$$\n\nif one axis passes through the vertices of the hyperbola and the other axis is the perpendicular bisector of the segment connecting the two vertices.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076805/assets/bd0d117543012be1c4eab0acda878c9aea67518e46c93048e8c249de1a0c03e6.png)" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8277"] :question/problem "Which curve is defined by the equation $6x_1^2+8x_1x_2-9x_2^2= 70?$" :question/worked-solution "Consider the quadratic form $Q(\\mathbf{x})=6x_1^2+8x_1x_2-9x_2^2.$ To  determine the curve defined by the given equation, we reduce $Q(\\mathbf{x})$ to its canonical (diagonal) form.\n\nFirst, we write down the matrix of $Q(\\mathbf{x}),$ which is\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076805/assets/33a30f2c07875359a60caed74f802a2de29ac9e44089800ed8f30a2015303bce.png)\n\nNext, we find the eigenvalues of $A\\mathbin{:}$\n\n$$\n\\begin{aligned}|A-\\lambda I| & =0 \\\\ |\\begin{aligned}6-\\lambda  & 4 \\\\ 4 & -9-\\lambda \\end{aligned}| & =0 \\\\ {\\lambda }^{2}+3\\lambda -70 & =0 \\\\ \\lambda  & =7,\\,-10\\end{aligned}\n$$\n\nSo, our quadratic form can be reduced to $7y_1^2 -10 y_2^2.$  \n\nIn the new variables, the curve has the following equation:\n\n$$\n\\begin{aligned}7{y}_{1}^{2}-10{y}_{2}^{2} & =70 \\\\ \\frac{{y}_{1}^{2}}{10}-\\frac{{y}_{2}^{2}}{7} & =1 \\\\ \\frac{{y}_{1}^{2}}{(\\sqrt{10})^{2}}-\\frac{{y}_{2}^{2}}{(\\sqrt{7})^{2}} & =1\\end{aligned}\n$$\n\nThis is a hyperbola with semiaxes $\\sqrt{10}$ and $\\sqrt{7}.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8678"] :question/problem "Consider the matrix ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076805/assets/4114e6536f57106949ed39a6ae4979646a0dd58c5690d7e7bcf9ffed15de8086.png) and the quadratic curve $\\mathbf{x}^T \\! A \\mathbf{x} = 1.$ Given that $A$ has eigenvalues $\\lambda_1=3$ and $\\lambda_2=1,$ find the principal axes of the curve." :question/worked-solution "Notice that $A$ is symmetric. The principal axes of the curve \n\n$$\n\\mathbf{x}^T \\! A \\mathbf{x} = 1\n$$\n\nare the vectors that give an orthonormal eigenvector basis for $A.$ Let's now find these eigenvectors.\n\n- For $\\lambda_1=3,$ we have\n\n$$\n\\begin{aligned}A-3I & =[\\begin{aligned}2 & 1 \\\\ 1 & 2\\end{aligned}]-3[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}-1 & 1 \\\\ 1 & -1\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-3I)\\mathbf{x}=\\mathbf{0}$ gives the eigenvector ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076805/assets/771d020606de64641ab305039a0c9a9de926080e83707b270a333b5775a8e028.png) Dividing $\\mathbf{v}_1$ by its norm $\\| \\mathbf{v}_1  \\| = \\sqrt{2},$ we get \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076805/assets/54a77383e863630dfd4e21a796801001aaed3084f1097bca62ef4a098e20b405.png)\n\n- For $\\lambda_2=1,$ we have\n\n$$\n\\begin{aligned}A-1I & =[\\begin{aligned}-2 & 2 \\\\ 2 & 1\\end{aligned}]-1[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}1 & 1 \\\\ 1 & 1\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-I)\\mathbf{x}=\\mathbf{0}$ gives the eigenvector ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076805/assets/e0d71ad9216b9fa7c1831e6874b9a97bba9c1d9c5dbd6d9664635ed468d82a4c.png) Dividing $\\mathbf{v}_2$ by its norm $\\| \\mathbf{v}_2  \\| = \\sqrt{2},$ we get \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076805/assets/83fd398b476c1c749346754a05c7f4071a98ab61453405a99ad8fcff65e38aaf.png)\n\nTherefore, the principal axes of our curve are\n\n$\\qquad$ ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076805/assets/8f0d84bb5c3ae37714c781b5dafbba1ae7de8561234ca558d3da2dcbfa9d75cf.png) and ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076805/assets/293ad98697d595e3e0049aae93e54209b6d17aa92eb131b57791f211167690fc.png)" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8276"] :question/problem "Find the principal axes of the curve $19x_1^2-6x_1x_2+11x_2^2 = 20.$" :question/worked-solution "First, consider the quadratic form $Q(\\mathbf{x})=19x_1^2-6x_1x_2+11x_2^2.$ The matrix of the form is \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076805/assets/31f8c54fecdb8b2e8b3f3cad20a642a39eab9ae2987d49849a1c1dabc34e5368.png)\n\nNotice that $A$ is symmetric. The principal axes of the curve \n\n$$\n\\mathbf{x}^T \\! A \\mathbf{x} = 20\n$$\n\nare the vectors that form an orthonormal eigenvector basis of $A.$ \n\nBy solving the characteristic equation $|A-\\lambda I| = 0,$ we obtain\n\n$\\qquad$ $\\lambda_1=20 \\quad$ and $\\quad \\lambda_2=10.$\n\nLet's now find the eigenvectors.\n\n- For $\\lambda_2=20,$ we have\n\n$$\n\\begin{aligned}A-20I & =[\\begin{aligned}19 & -3 \\\\ -3 & 11\\end{aligned}]-20[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}-1 & -3 \\\\ -3 & -9\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-20I)\\mathbf{x}=\\mathbf{0}$ gives the eigenvector ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076805/assets/51897cac20d424f599eba1c8aada5259279ab9ad263e7557d6614ce79e68fa0f.png) Dividing $\\mathbf{v}_2$ by its norm $\\| \\mathbf{v}_2  \\| = \\sqrt{10},$ we get \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076805/assets/f9913f9139af447be912bccc2350f086ce32bae89849495f8e82a3eebf8a7918.png)\n\n- For $\\lambda_1=10,$ we have\n\n$$\n\\begin{aligned}A-10I & =[\\begin{aligned}19 & -3 \\\\ -3 & 11\\end{aligned}]-10[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}9 & -3 \\\\ -3 & 1\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-10I)\\mathbf{x}=\\mathbf{0}$ gives the eigenvector ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076805/assets/2cdd8527be173b17e254bd4ecda571d71b15938c3a1f6cb2609122db2b10c64d.png) Dividing $\\mathbf{v}_1$ by its norm $\\| \\mathbf{v}_1  \\| = \\sqrt{10},$ we get \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076805/assets/f6764ef3200afce932740e8100915018b6a0c21e902d932b218e79bcd57e0b95.png)\n\nTherefore, the principal axes of our curve are\n\n$\\qquad$ ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076805/assets/1549a73afb90f3fa0fb8218d9d63daa1a5534c3e546613cbf3f226371b8f1092.png) and ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14076805/assets/d4a6e3f0c138e6dd83252df8adc14359ba67ae77dec0270264ea6d00c7b08667.png)" :db/ensure [:question/validate]}]
