}}[\\begin{aligned}1 \\\\ 3\\end{aligned}].\n$$\n\nTherefore, the principal axes of our curve are\n\n$\\,$ $\\frac{1}{\\sqrt{10}}[\\begin{aligned}-3 \\\\ 1\\end{aligned}]\\,$ and $\\,\\frac{1}{\\sqrt{10}}[\\begin{aligned}1 \\\\ 3\\end{aligned}].$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-97993/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e97b8e36-3790-5cdc-bd77-417574af23f3"] :knowledge-point/questions ["q-97993"] :db/ensure [:knowledge-point/validate]} {:db/id "q-95805/selection/b63bf283a78bf3276dfbd3678bb21affdeea1cd25e362531a83ef978fcac20f0" :answer/id #uuid "34e35e0b-21df-530b-9a3f-8844d4592dc9" :answer/type :answer.type/text :answer/value "$\\frac{1}{\\sqrt{5}}[\\begin{aligned}2 \\\\ 1\\end{aligned}]\\,$ and $\\,\\frac{1}{\\sqrt{5}}[\\begin{aligned}-1 \\\\ 2\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-95805/selection/1eadd010c5094e2d33eaf76f4322873b0a1d7af1be08272ab40f2ea8b7063c2e" :answer/id #uuid "11ef7813-3304-557e-be6f-83b068a472f3" :answer/type :answer.type/text :answer/value "$\\frac{1}{\\sqrt{13}}[\\begin{aligned}1 \\\\ 4\\end{aligned}]\\,$ and $\\,\\frac{1}{\\sqrt{13}}[\\begin{aligned}-4 \\\\ 1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-95805/selection/370c356d324c7aae6b112b643fdfb2c2a7bdaadb6fe4ba16e8453a535e3f1bce" :answer/id #uuid "e5c47226-b411-5f15-a5b7-a7981300f27b" :answer/type :answer.type/text :answer/value "$\\frac{1}{\\sqrt{17}}[\\begin{aligned}4 \\\\ 1\\end{aligned}]\\,$ and $\\,\\frac{1}{\\sqrt{17}}[\\begin{aligned}-1 \\\\ 4\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-95805/selection/2c8dd2717b4b539cf3fd995c4237442e1fcd1094d45c8172682cf61c8e4e46de" :answer/id #uuid "07feeeca-fa62-5e55-bf81-939bd13666fc" :answer/type :answer.type/text :answer/value "$\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ 1\\end{aligned}]\\,$ and $\\,\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id 