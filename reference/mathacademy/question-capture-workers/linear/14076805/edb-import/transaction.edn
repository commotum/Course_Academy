igned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}-1 & 4 \\\\ 4 & -16\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-10I)x=0$ gives the eigenvector ${v}_{1}=[\\begin{aligned}4 \\\\ 1\\end{aligned}].$ Dividing ${v}_{1}$ by its norm $‖{v}_{1}‖=\\sqrt{17},$ we get \n\n$$\n\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{17}}[\\begin{aligned}4 \\\\ 1\\end{aligned}].\n$$\n\n- For ${\\lambda }_{2}=-7,$ we have\n\n$$\n\\begin{aligned}A-(-7)I & =[\\begin{aligned}9 & 4 \\\\ 4 & -6\\end{aligned}]+7[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}16 & 4 \\\\ 4 & 1\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-1I)x=0$ gives the eigenvector ${v}_{2}=[\\begin{aligned}-1 \\\\ 4\\end{aligned}].$ Dividing ${v}_{2}$ by its norm $‖{v}_{2}‖=\\sqrt{17},$ we get \n\n$$\n\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{17}}[\\begin{aligned}-1 \\\\ 4\\end{aligned}].\n$$\n\nTherefore, the principal axes of our curve are\n\n$\\,$ $\\frac{1}{\\sqrt{17}}[\\begin{aligned}4 \\\\ 1\\end{aligned}]\\,$ and $\\,\\frac{1}{\\sqrt{17}}[\\begin{aligned}-1 \\\\ 4\\end{aligned}].$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-95805/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ee6832be-62e1-506c-9b78-685f65362117"] :knowledge-point/questions ["q-95805"] :db/ensure [:knowledge-point/validate]} {:db/id "q-95058/selection/bde3b9f04dbda48de16b994ec45c6fe83de3932d775c8aa23df763899ad59922" :answer/id #uuid "d4f55f70-5733-5fe5-991f-0d992f212dbf" :answer/type :answer.type/text :answer/value "$\\frac{1}{\\sqrt{10}}[\\begin{aligned}3 \\\\ 1\\end{aligned}]\\,$ and $\\,\\frac{1}{\\sqrt{10}}[\\begin{aligned}-1 \\\\ 3\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-95058/selection/7ea84d625179c3d1cd5268597c08e623a17934d5e21dcd764e38f0bf1b5c6d60" :answer/id #uuid "30d054d8-174c-5bf7-a614-fa857b7f80bd" :answer/type :answer.type/text :answer/value "$\\frac{1}{2}[\\begin{aligned}1 \\\\ 