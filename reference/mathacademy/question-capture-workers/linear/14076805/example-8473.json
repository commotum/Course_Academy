  "proof_feedback": null,
  "html": "<div id=\"step-e8473\" class=\"step\" style=\"display: block;\">\n    \n                 \n                <div class=\"example\">\n                    <div class=\"stepHeader\">\n                        <div class=\"stepName\"><span class=\"stepType\">Example:</span> Identifying the Principal Axes of a Quadratic Curve Using a Diagram</div>       \n                        <div class=\"helpButton\" stepid=\"e8473\">?</div>\n                    </div>\n            \n                    <div class=\"exampleQuestion\">\n                        <p>Draw a diagram that depicts the lines representing the principal axes of the quadratic curve shown below.</p>\n<div id=\"graphic-fa1f2ef5edfdc2471cf95a125c9702a1\" class=\"graphic\"><img src=\"/graphics/fa1f2ef5edfdc2471cf95a125c9702a1\"></div> \n                    </div>     \n            \n                    <div class=\"exampleExplanationHeader\">EXPLANATION</div>\n            \n                    <div class=\"exampleExplanation\">\n                        <style type=\"text/css\">\n                            .mjpage .MJX-monospace {\n                            font-family: monospace\n                            }\n\n                            .mjpage .MJX-sans-serif {\n                            font-family: sans-serif\n                            }\n\n                            .mjpage {\n                            display: inline;\n                            font-style: normal;\n                            font-weight: normal;\n                            line-height: normal;\n                            font-size: 100%;\n                            font-size-adjust: none;\n                            text-indent: 0;\n                            text-align: left;\n                            text-transform: none;\n                            letter-spacing: normal;\n                            word-spacing: normal;\n                            word-wrap: normal;\n                            white-spac