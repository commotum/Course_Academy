36379e9c292e20245c96734be16ec054769fbd2b5afd99b/3c9fd56690fcf730a39694cfa3b25992f5e8bb967fe8ecfd6c9388a3a36828f4"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-33004"] :question/problem "Consider the straight line with the canonical equation $\\frac{x}{1}=\\frac{y+1}{2}=\\frac{z}{3}.$ Find the vector equation of the line." :question/worked-solution "Remember that the Cartesian (canonical) equation of the straight line that passes through the point $P({x}_{0},{y}_{0},{z}_{0})$ and is parallel to the vector $v=⟨{v}_{x},{v}_{y},{v}_{z}⟩$, is given by\n\n$$\n\\frac{x-{x}_{0}}{{v}_{x}}=\\frac{y-{y}_{0}}{{v}_{y}}=\\frac{z-{z}_{0}}{{v}_{z}}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nComparing the above to our given equation\n\n$$\n\\frac{x}{1}=\\frac{y-(-1)}{2}=\\frac{z}{3},\n$$\n\nwe find that our line passes through the point $P(0,-1,0)$ and is parallel to $v=⟨1,2,3⟩.$ Therefore, its vector equation is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}0 \\\\ -1 \\\\ 0\\end{aligned}]+t[\\begin{aligned}1 \\\\ 2 \\\\ 3\\end{aligned}],\\,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-33004/selection/ma-v1/d568231fb00dd6fcd36379e9c292e20245c96734be16ec054769fbd2b5afd99b"] :db/ensure [:question/validate]} {:db/id "q-33006/selection/665d8fefb436ed30fc9779d1fc1a4b04e7e25c9ba6209c1fc89cf0693f0403d8" :answer/id #uuid "14a0c2d7-9f78-523a-8cd3-f9f8a1e40a29" :answer/type :answer.type/math :answer/value "\\frac{x}{2}=\\frac{y}{5}=\\frac{z}{-1}" :db/ensure [:answer/validate]} {:db/id "q-33006/selection/f5b62588ec012ec6b4f4446feaed9a525ffa2e0e4cbe1a55a39a9631588ce882" :answer/id #uuid "7ecb2359-2362-568c-9193-fba9c11b4c96" :answer/type :answer.type/math :answer/value "\\frac{x-2}{4}=\\frac{y-5}{5}=\\frac{z+1}{6}" :db/ensure [:answer/validate]} {:db/id "q-33006/selection/2b2f4c148432385e81bc5a70976780b40ed6545c9f629ae2c2467ffa67b0a02d" :answer/id #uuid "b860324c-156a-5ff8-91d0-