6fcb3f841b3d35e439f5c6921524b18b2ac4e044aa5f2628bfd034" "q-127068/selection/083e2740936a0deb52a556f0dc02eefa0ee56cae97744955246e60748b812134" "q-127068/selection/76ca88a3be2012faa23603de4960513cf4833ded92b3c37914afed078f1373af"] :db/ensure [:answer-field/validate]} {:db/id "q-127068" :question/id #uuid "ef077b10-897a-59ae-a756-7a254900bdb1" :question/math-academy-id "q-127068" :question/problem "Find the vector equation of the line $\\frac{x-2}{3}=\\frac{y-1}{-2}=\\frac{z+3}{7}.$" :question/worked-solution "Remember that the Cartesian (canonical) equation of the straight line that passes through the point $P({x}_{0},{y}_{0},{z}_{0})$ and is parallel to the vector $v=⟨{v}_{x},{v}_{y},{v}_{z}⟩$, is given by\n\n$$\n\\frac{x-{x}_{0}}{{v}_{x}}=\\frac{y-{y}_{0}}{{v}_{y}}=\\frac{z-{z}_{0}}{{v}_{z}}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nComparing the above to our given equation\n\n$$\n\\frac{x-2}{3}=\\frac{y-1}{-2}=\\frac{z-(-3)}{7}\n$$\n\nwe find that our line passes through the point $P(2,1,-3)$ and is parallel to $v=⟨3,-2,7⟩.$ Therefore, its vector equation is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}2 \\\\ 1 \\\\ -3\\end{aligned}]+t[\\begin{aligned}3 \\\\ -2 \\\\ 7\\end{aligned}],\\,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-127068/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9927bff1-c245-542b-8d5d-fa7d24188b85"] :knowledge-point/questions ["q-127068"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127069/selection/e72f1c18ebffb16df00f99a5c9f07b7bf2cb23c8dfcd7990a04b8abdfa46dcda" :answer/id #uuid "bab9505f-1030-5316-a396-4880e36937d3" :answer/type :answer.type/math :answer/value "r=[\\begin{aligned}4 \\\\ 7 \\\\ -6\\end{aligned}]+t[\\begin{aligned}3 \\\\ -1 \\\\ -7\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-127069/selection/a5fea5f0d039edef3be4bf950f194fc679defe9905ce63a345d56cb8186716e2