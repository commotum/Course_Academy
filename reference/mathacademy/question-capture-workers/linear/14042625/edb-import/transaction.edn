-(-5)}{9}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nSimplifying, we reach\n\n$$\n\\frac{x-3}{4}=\\frac{y-4}{6}=\\frac{z+5}{9}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-71029/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d44cf726-a4a6-5ac9-a63c-7464fe5566c5"] :knowledge-point/questions ["q-71029"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71020/selection/c8022c5cc28bcf5a2c91a6f3ab126a0fee59a0f5ebac4db2927bce1b4538f114" :answer/id #uuid "1b95e6f2-06b2-5cdc-9070-9418b85275cf" :answer/type :answer.type/math :answer/value "\\frac{x}{4}=\\frac{y}{5}=\\frac{z}{-6}" :db/ensure [:answer/validate]} {:db/id "q-71020/selection/9287f45d41b69992cc0bbb6df0c51a4c9f8819cbc10377880ea505156ce9eb88" :answer/id #uuid "933861c6-91ab-5956-b932-587f993220e3" :answer/type :answer.type/math :answer/value "\\frac{x-2}{4}=\\frac{y+3}{5}=\\frac{z-7}{-6}" :db/ensure [:answer/validate]} {:db/id "q-71020/selection/347682afa7164a34cf49a8c60d5a22f9b5b7fe0cec962eb0ef6fc84d02781550" :answer/id #uuid "64385382-c507-533a-9b07-1c09bca60793" :answer/type :answer.type/math :answer/value "\\frac{x+2}{4}=\\frac{y-3}{5}=\\frac{z+7}{-6}" :db/ensure [:answer/validate]} {:db/id "q-71020/selection/76a48305678ef256072a80650635578e8ae9623419065fbe65059c410ae0743a" :answer/id #uuid "64f006f7-7110-52c2-967f-369700e3bfe4" :answer/type :answer.type/math :answer/value "\\frac{x-4}{2}=\\frac{y-5}{-3}=\\frac{z+6}{7}" :db/ensure [:answer/validate]} {:db/id "q-71020/selection/efce842062927785a5284774dcc4945be85e8628fce0c6f0d57a4722e436c520" :answer/id #uuid "17c61443-5940-554e-953a-e513e2167a8b" :answer/type :answer.type/math :answer/value "\\frac{x+4}{2}=\\frac{y+5}{-3}=\\frac{z-6}{7}" :db/ensure [:answer/validate]} {:db/id "q-71020/selection" :answer-field/id #uuid "21465bc2-9ec2-5647-9dfa-2cc98839b17f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71020/selection/9287f45d41b69992cc0bbb6df0