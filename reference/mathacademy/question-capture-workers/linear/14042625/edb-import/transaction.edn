ction"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d44cf726-a4a6-5ac9-a63c-7464fe5566c5"] :knowledge-point/questions ["q-71020"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127397/selection/6100dee1f0d83688eed8accf37ce4583e56e5d1a1c28c7db024d28bc2939f28e" :answer/id #uuid "3ace73dc-415c-501c-b51d-216f60dcbe4b" :answer/type :answer.type/math :answer/value "\\frac{x-2}{2}=\\frac{y+3}{-5}=\\frac{z-3}{3}" :db/ensure [:answer/validate]} {:db/id "q-127397/selection/ee0f0687bdb5e3b3220819efd3da214e3e5d1f8cbb65e8fc2744387ab79bd2a3" :answer/id #uuid "46f124a8-2503-535f-b345-376c65b0fa64" :answer/type :answer.type/math :answer/value "\\frac{x+2}{2}=\\frac{y-3}{-5}=\\frac{z-3}{3}" :db/ensure [:answer/validate]} {:db/id "q-127397/selection/be226f236f60764307793a78dd5f29fa213e45cca869602c244c42ebb64b1817" :answer/id #uuid "c49fa192-4ede-5a9e-bd9f-75e6cc660f21" :answer/type :answer.type/math :answer/value "\\frac{x-2}{2}=\\frac{y+5}{-3}=\\frac{z-3}{3}" :db/ensure [:answer/validate]} {:db/id "q-127397/selection/c0045cc03b5d49c9e41d3206bdc81dd0deed9e8d88dda24c84e7dea1ca570ab4" :answer/id #uuid "6388d026-50f4-5a7f-bbb4-0ca3efb823ce" :answer/type :answer.type/math :answer/value "\\frac{x-2}{-2}=\\frac{y+5}{3}=\\frac{z-3}{3}" :db/ensure [:answer/validate]} {:db/id "q-127397/selection/414c6b5575e36154eef8b619a0ffa4c13fdbaf3cf90073953610824908f443d5" :answer/id #uuid "2e88e358-756d-5c5d-a4cc-5ed7dcd26fe8" :answer/type :answer.type/math :answer/value "\\frac{x+2}{-2}=\\frac{y-3}{5}=\\frac{z+3}{3}" :db/ensure [:answer/validate]} {:db/id "q-127397/selection" :answer-field/id #uuid "ec7fd33a-18e5-5585-9475-633a2028521a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127397/selection/ee0f0687bdb5e3b3220819efd3da214e3e5d1f8cbb65e8fc2744387ab79bd2a3" :answer-field/choices ["q-127397/selection/6100dee1f0d83688eed8accf37ce4583e56e5d1a1c28c7db024d28bc2939f28e" "q-127397/selection/ee0f0687bdb5e3b3220819efd3da214e3e5d1f8cbb65e8fc2744387ab79bd2a3" "q-127397/selection/be226f236f60764307793a78dd5f29fa213e45cca869602c244c42ebb64b1817" "q-127397/selection/c0045cc03b5d49c9e41d3206bdc81dd0deed9e8d88dda24c84e7dea1ca570ab4" "q-127397/selection/414c6b5575e36154eef8b619a0ffa4c13fdbaf3cf90073953610824908f443d5"] :db/ensure [:answer-field/validate]} {:db/id "q-127397" :question/id #uuid "8f0384bb-f286-5414-906c-44f0eb2d0482" :question/math-academy-id "q-127397" :question/problem "Consider the straight line with the vector equation\n\n$$\nr=[\\begin{aligned}-2 \\\\ 3 \\\\ 3\\end{aligned}]+t[\\begin{aligned}2 \\\\ -5 \\\\ 3\\end{aligned}]\n$$\n\nfor $t\\in (-\\infty ,\\infty ).$ Find the Cartesian equation of this line." :question/worked-solution "We have the vector equation \n\n$$\nr=[\\begin{aligned}-2 \\\\ 3 \\\\ 3\\end{aligned}]+t[\\begin{aligned}2 \\\\ -5 \\\\ 3\\end{aligned}],\\,t\\in (-\\infty ,\\infty ).\n$$\n\n \n\nThis implies that the straight line passes through the point $P(-2,3,3)$ and is parallel to the vector $v=⟨2,-5,3⟩.$ So, its Cartesian (canonical) equation is given by\n\n$$\n\\frac{x-(-2)}{2}=\\frac{y-3}{-5}=\\frac{z-3}{3}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nSimplifying, we reach\n\n$$\n\\frac{x+2}{2}=\\frac{y-3}{-5}=\\frac{z-3}{3}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-127397/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d44cf726-a4a6-5ac9-a63c-7464fe5566c5"] :knowledge-point/questions ["q-127397"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127406/selection/abc2ce4fee9218d65aa4190c5cba6fef82a4722f78f977e8afeae6e89c36a805" :answer/id #uuid "2c26ae25-d301-5afd-8f9f-03240b793bf2" :answer/type :answer.type/math :answer/value "\\frac{x-1}{7}=\\frac{y+2}{-2}=\\frac{z-3}{4}" :db/ensure [:answer/validate]} {:db/id "q-127406/selection/c24383c67bfc80d589f255754e715855521277fb3a7355325c917b7b530348c0" :answer/id #uuid "0cf460ff-83f6-57b3-aa74-173cc07e0c43" :answer/type :answer.type/math :answ