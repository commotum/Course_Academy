\\end{aligned}]+t[\\begin{aligned}2 \\\\ 4 \\\\ 3\\end{aligned}],\\,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$\n\nTherefore, the parametric equations are the following:\n\n$$\n{\\begin{aligned}x=2+2t \\\\ y=1+4t \\\\ z=-1+3t\\end{aligned}\n$$" 13194139534873 true] [17592186316489 1000 #edb/ref 17592186316490 13194139534873 true] [17592186316489 1000 #edb/ref 17592186316491 13194139534873 true] [17592186316489 1000 #edb/ref 17592186316492 13194139534873 true] [17592186316489 1000 #edb/ref 17592186316493 13194139534873 true] [17592186316489 1000 #edb/ref 17592186316494 13194139534873 true] [17592186316489 1040 #edb/ref 17592186045450 13194139534873 true] [17592186316489 1041 "selection" 13194139534873 true] [17592186316489 1104 #edb/ref 17592186316493 13194139534873 true] [17592186316489 1110 #uuid "ff32e8e6-b1fe-5d99-a72d-be93068c71c9" 13194139534873 true] [17592186316490 1034 "{\\begin{aligned}x=2t \\\\ y=t \\\\ z=t\\end{aligned}" 13194139534873 true] [17592186316490 1103 #edb/ref 17592186045453 13194139534873 true] [17592186316490 1111 #uuid "a214e0dd-c5f7-56c0-bcc3-0066251d066e" 13194139534873 true] [17592186316491 1034 "{\\begin{aligned}x=2+2t \\\\ y=4+t \\\\ z=3-t\\end{aligned}" 13194139534873 true] [17592186316491 1103 #edb/ref 17592186045453 13194139534873 true] [17592186316491 1111 #uuid "7fa083d4-63e8-51d2-9073-2efef9626234" 13194139534873 true] [17592186316492 1034 "None of the listed" 13194139534873 true] [17592186316492 1103 #edb/ref 17592186045454 13194139534873 true] [17592186316492 1111 #uuid "dc8eff61-2342-59ca-85df-e736f0507a5b" 13194139534873 true] [17592186316493 1034 "{\\begin{aligned}x=2+2t \\\\ y=1+4t \\\\ z=-1+3t\\end{aligned}" 13194139534873 true] [17592186316493 1103 #edb/ref 17592186045453 13194139534873 true] [17592186316493 1111 #uuid "bbd7c90b-9b5c-5578-9d30-9ad89e8460df" 13194139534873 true] [17592186316494 1034 "{\\begin{aligned}x=2t \\\\ y=4t \\\\ z=3t\\end{aligned}" 13194139534873 true] [17592186316494 1103 #edb/ref 17592186045453 