ure [:knowledge-point/validate]} {:db/id "q-135483/selection/bfbf91f109f6c4c7b8242ca2b1bf4bae476945344d0e5e07bf789ea29825342a" :answer/id #uuid "fda39a29-456e-59be-afe1-60d438978098" :answer/type :answer.type/text :answer/value "$v$ and $w$ only" :db/ensure [:answer/validate]} {:db/id "q-135483/selection/0f7808983f38e7b4b595d56627230241abf6e41b2aafced76bde4f2a0620a863" :answer/id #uuid "16e613e2-6d0d-53e5-8657-3d907d9bb5bd" :answer/type :answer.type/text :answer/value "$u,$ $v,$ and $w$" :db/ensure [:answer/validate]} {:db/id "q-135483/selection/af06989463b81d9876355a53f3053ca2ba83c5a2bfb8fa3884fd55f4c101acc2" :answer/id #uuid "0a65d192-66ac-5803-b9f7-0def781477b1" :answer/type :answer.type/text :answer/value "$v$ only" :db/ensure [:answer/validate]} {:db/id "q-135483/selection/50dc037bcd603b3f900ac4f80f2cdcad5054db0eabfb8b0e3487575a41dc5b1f" :answer/id #uuid "7ad5be55-e33a-5b7b-9029-ec64d9c62fca" :answer/type :answer.type/text :answer/value "$w$ only" :db/ensure [:answer/validate]} {:db/id "q-135483/selection/943c19d914c72bdbb573870579ca24725a8b7607e28ae46984bace02edde3fdc" :answer/id #uuid "47032687-3142-5650-bf96-1338798b0125" :answer/type :answer.type/text :answer/value "$u$ and $v$ only" :db/ensure [:answer/validate]} {:db/id "q-135483/selection" :answer-field/id #uuid "cc5de049-629b-5b07-8fdc-67c03529f585" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-135483/selection/bfbf91f109f6c4c7b8242ca2b1bf4bae476945344d0e5e07bf789ea29825342a" :answer-field/choices ["q-135483/selection/bfbf91f109f6c4c7b8242ca2b1bf4bae476945344d0e5e07bf789ea29825342a" "q-135483/selection/0f7808983f38e7b4b595d56627230241abf6e41b2aafced76bde4f2a0620a863" "q-135483/selection/af06989463b81d9876355a53f3053ca2ba83c5a2bfb8fa3884fd55f4c101acc2" "q-135483/selection/50dc037bcd603b3f900ac4f80f2cdcad5054db0eabfb8b0e3487575a41dc5b1f" "q-135483/selection/943c19d914c72bdbb573870579ca24725a8b7607e28ae46984bace02edde3fdc"] :db/ensure [:answer-field/validate]} {:db/id "q-135483" :question/id #uuid "60493d3a-a1d2-50c0-a800-38f0bca06ee2" :question/math-academy-id "q-135483" :question/problem "Which of the following are stochastic vectors?\n\n$$\nu=[\\begin{aligned}0.45 \\\\ 0.55 \\\\ -0.05\\end{aligned}],\\,v=[\\begin{aligned}0.7 \\\\ 0.3\\end{aligned}],\\,w=[\\begin{aligned}0.65 \\\\ 0.15 \\\\ 0.2\\end{aligned}]\n$$" :question/worked-solution "Recall that a stochastic vector is a vector with nonnegative entries that add up to $1.$\n\nWith that in mind, let's examine our vectors in turn.\n\n- Vector $u$ is *not* a stochastic vector since it contains negative entries.\n\n- Vector $v$ is a stochastic vector. Indeed, \n\n- its entries are all nonnegative, and\n\n- the entries add up to one:\n\n$$\n0.7+0.3=1\n$$\n\n- Vector $w$ is a stochastic vector. Indeed, \n\n- its entries are all nonnegative, and\n\n- the entries add up to one:\n\n$$\n0.65+0.15+0.2=1\n$$\n\nTherefore, the correct answer is \"$v$ and $w$ only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-135483/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "66b24a98-c641-5e08-8bec-30f221d1bb22"] :knowledge-point/questions ["q-135483"] :db/ensure [:knowledge-point/validate]} {:db/id "q-135484/selection/943c19d914c72bdbb573870579ca24725a8b7607e28ae46984bace02edde3fdc" :answer/id #uuid "6192a61a-0edd-5e31-bf74-8114ac1e6682" :answer/type :answer.type/text :answer/value "$u$ and $v$ only" :db/ensure [:answer/validate]} {:db/id "q-135484/selection/50dc037bcd603b3f900ac4f80f2cdcad5054db0eabfb8b0e3487575a41dc5b1f" :answer/id #uuid "8a091220-b8c1-55f9-b9e5-18ebec307d98" :answer/type :answer.type/text :answer/value "$w$ only" :db/ensure [:answer/validate]} {:db/id "q-135484/selection/5377e59dcf00c73b10937783e5bfc89841f270ab1078b9a5ff32cb656e9efc16" :answer/id #uuid "548da9a8-23f4-542c-99d7-893c1ec4e12c" :answer/type :answer.type/text :answer/value "$u$ only" :db/ensure [:answer/validate]} {:db/id "q-135484/selection/df20580b1de38ef466a084b8d688ddc41e251d771855d15d0ac63f41f71bfd19" :answer/id #uuid "e47f9a8f-2f23-5e60-bbdf-e021d70b1529" :answer/type :answer.type/text :answer/value "$u$ and $w$ only" :db/ensure [:answer/validate]} {:db/id "q-135484/selection/0f7808983f38e7b4b595d56627230241abf6e41b2aafced76bde4f2a0620a863" :answer/id #uuid "fea52d41-5f99-5f73-85a7-28c75cbe32cb" :answer/type :answer.type/text :answer/value "$u,$ $v,$ and $w$" :db/ensure [:answer/validate]} {:db/id "q-135484/selection" :answer-field/id #uuid "561a31d8-e775-5904-8b22-46ef410361bd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-135484/selection/df20580b1de38ef466a084b8d688ddc41e251d771855d15d0ac63f41f71bfd19" :answer-field/choices ["q-135484/selection/943c19d914c72bdbb573870579ca24725a8b7607e28ae46984bace02edde3fdc" "q-135484/selection/50dc037bcd603b3f900ac4f80f2cdcad5054db0eabfb8b0e3487575a41dc5b1f" "q-135484/selection/5377e59dcf00c73b10937783e5bfc89841f270ab1078b9a5ff32cb656e9efc16" "q-135484/selection/df20580b1de38ef466a084b8d688ddc41e251d771855d15d0ac63f41f71bfd19" "q-135484/selection/0f7808983f38e7b4b595d56627230241abf6e41b2aafced76bde4f2a0620a863"] :db/ensure [:answer-field/validate]} {:db/id "q-135484" :question/id #uuid "10395110-66fb-5363-ba85-098bdc5e23da" :question/math-academy-id "q-135484" :question/problem "Which of the following are stochastic vectors?\n\n$$\nu=[\\begin{aligned}0.15 \\\\ 0.85\\end{aligned}],\\,v=[\\begin{aligned}0.8 \\\\ -0.1 \\\\ 0.3\\end{aligned}],\\,w=[\\begin{aligned}0.2 \\\\ 0.3 \\\\ 0.5\\end{aligned}]\n$$" :question/worked-solution "Recall that a stochastic vector is a vector with nonnegative entries that add up to $1.$\n\nWith that in mind, let's examine our vectors in turn.\n\n- Vector $u$ is a stochastic vector. Indeed, \n\n- its entries are all nonnegative, and\n\n- the entries add up to one:\n\n$$\n0.15+0.85=1\n$$\n\n- Vector $v$ is *not* a stochastic vector since it contains negative entries.\n\n- Vector $w$ is a stochastic vector. Indeed, \n\n- its entries are all nonnegative, and\n\n- the entries add up to one:\n\n$$\n0.2+0.3+0.5=1\n$$\n\nTherefore, the correct answer is \"$u$ and $w$ only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-135484/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "66b24a98-c641-5e08-8bec-30f221d1bb22"] :knowledge-point/questions ["q-135484"] :db/ensure [:knowledge-point/validate]} {:db/id "q-135488/selection/04646d488959d0b10c98bd9055615c2535925a7b59f21ec7dcdb79a9fb18da0d" :answer/id #uuid "d8b4fbc5-a04c-5b22-b4cf-4bc2d56c5a72" :answer/type :answer.type/text :answer/value "$U$ and $W$ only" :db/ensure [:answer/validate]} {:db/id "q-135488/selection/16b50194516e7dcad35bdecafc4c70a67642e9c995267daaf0accfcc873be095" :answer/id #uuid "9162a11b-976e-5e4a-892d-9ce8f9899756" :answer/type :answer.type/text :answer/value "$U$ only" :db/ensure [:answer/validate]} {:db/id "q-135488/selection/ada5cc9b7cb3c1f0ee40e3f0daf3ce48624840426207eb57c599d2352c73fca0" :answer/id #uuid "279a078b-cb83-5d69-89c6-4b12d0e6cdde" :answer/type :answer.type/text :answer/value "$U$ and $V$ only" :db/ensure [:answer/validate]} {:db/id "q-135488/selection/1454d2f1915a335c7d01677c9b98fbae5aedebb848a7a30361c0ea47ca70fb1e" :answer/id #uuid "11bb2216-6b97-5be8-98b3-b5f516c93f4f" :answer/type :answer.type/text :answer/value "$V$ and $W$ only" :db/ensure [:answer/validate]} {:db/id "q-135488/selection/e2d52a456cba49e8b5bad42a80eb2a8b1b2bb244f8c178b51f34d013592f152f" :answer/id #uuid "786eb244-0f74-5bf7-93f7-0eb7dad83d5e" :answer/type :answer.type/text :answer/value "$W$ only" :db/ensure [:answer/validate]} {:db/id "q-135488/selection" :answer-field/id #uuid "40cfa081-d29b-57f7-a9f0-dc54a0338a6d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-135488/selection/e2d52a456cba49e8b5bad42a80eb2a8b1b2bb244f8c178b51f34d013592f152f" :answer-field/choices ["q-135488/selection/04646d488959d0b10c98bd9055615c2535925a7b59f21ec7dcdb79a9fb18da0d" "q-135488/selection/16b50194516e7dcad35bdecafc4c70a67642e9c995267daaf0accfcc873be095" "q-135488/selection/ada5cc9b7cb3c1f0ee40e3f0daf3ce48624840426207eb57c599d2352c73fca0" "q-135488/selection/1454d2f1915a335c7d01677c9b98fbae5aedebb848a7a30361c0ea47ca70fb1e" "q-135488/selection/e2d52a456cba49e8b5bad42a80eb2a8b1b2bb244f8c178b51f34d013592f152f"] :db/ensure [:answer-field/validate]} {:db/id "q-135488" :question/id #uuid "d9e8f97c-57bc-5f59-8108-1c5296ef33a7" :question/math-academy-id "q-135488" :question/problem "Which of the following are stochastic matrices?\n\n$$\nU=[\\begin{aligned}0.1 & 0 & 0.9 \\\\ 0 & 0 & 0 \\\\ 0.9 & 0 & 0.1\\end{aligned}],\\,V=[\\begin{aligned}-0.1 & 0.2 \\\\ 1.1 & 0.8\\end{aligned}],\\,W=[\\begin{aligned}0.5 & 0.3 \\\\ 0.5 & 0.7\\end{aligned}]\n$$" :question/worked-solution "Recall that a stochastic vector is a vector with nonnegative entries that add up to $1.$ A matrix is stochastic if all its columns are stochastic vectors.\n\nWith that in mind, let's examine our matrices in turn.\n\n- Matrix $U$ is *not* a stochastic matrix since its second column is not a stochastic vector (the corresponding entries don't add up to one): \n\n$$\n[\\begin{aligned}0.1 & 0 & 0.9 \\\\ 0 & 0 & 0 \\\\ 0.9 & 0 & 0.1\\end{aligned}]\n$$\n\n- Matrix $V$  is *not* a stochastic matrix since its first column is not a stochastic vector (it contains negative entries): \n\n$$\n[\\begin{aligned}-0.1 & 0.2 \\\\ 1.1 & 0.8\\end{aligned}]\n$$\n\n- Matrix $W$ is a stochastic matrix. Indeed, each column is a stochastic vector (the corresponding entries are non-negative and add up to one): \n\n$$\n\\begin{aligned}[\\begin{aligned}0.5 & 0.3 \\\\ 0.5 & 0.7\\end{aligned}]\\,\\begin{aligned}0.5+0.5=1 \\\\ 0.3+0.7=1\\end{aligned}\\end{aligned}\n$$\n\nTherefore, the correct answer is \"$W$ only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-135488/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "66b24a98-c641-5e08-8bec-30f221d1bb22"] :knowledge-point/questions ["q-135488"] :db/ensure [:knowledge-point/validate]} {:db/id "q-135566/selection/441f9a41e4c1d7c29719a73a7d795c394ee1337b1a990ebfb59a7b69a254418f" :answer/id #uuid "f7bf1303-5570-5700-9fd6-556fc2eef36a" :answer/type :answer.type/math :answer/value "0.7" :db/ensure [:answer/validate]} {:db/id "q-135566/selection/7c2fec16fd7ae02af1a8818a9096a676afc42249e7e68d108c3f64859048a45f" :answer/id #uuid "3bc0e126-c04b-54a2-8ff4-bacf99c7f908" :answer/type :answer.type/math :answer/value "1.25" :db/ensure [:answer/validate]} {:db/id "q-135566/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "cc5160a5-9c20-5ada-89be-2916efdec933" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-135566/selection/bd0c5293c05dbcd56341c67931e9e0ae46e20e1d0de3da140e1b2dcd87ea42e2" :answer/id #uuid "f204d38d-30bf-589a-be26-2341da76de50" :answer/type :answer.type/math :answer/value "0.45" :db/ensure [:answer/validate]} {:db/id "q-135566/selection/e459c513a8ab41d90fbedd18ffc02e71387b30263f9b62ed7d74cc4e1864eeb6" :answer/id #uuid "2dd3e102-bfe1-5ed3-9404-9d359d8d8ee5" :answer/type :answer.type/math :answer/value "0.55" :db/ensure [:answer/validate]} {:db/id "q-135566/selection" :answer-field/id #uuid "70dae69e-1f08-56a4-9010-50d401036fd0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-135566/selection/bd0c5293c05dbcd56341c67931e9e0ae46e20e1d0de3da140e1b2dcd87ea42e2" :answer-field/choices ["q-135566/selection/441f9a41e4c1d7c29719a73a7d795c394ee1337b1a990ebfb59a7b69a254418f" "q-135566/selection/7c2fec16fd7ae02af1a8818a9096a676afc42249e7e68d108c3f64859048a45f" "q-135566/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-135566/selection/bd0c5293c05dbcd56341c67931e9e0ae46e20e1d0de3da140e1b2dcd87ea42e2" "q-135566/selection/e459c513a8ab41d90fbedd18ffc02e71387b30263f9b62ed7d74cc4e1864eeb6"] :db/ensure [:answer-field/validate]} {:db/id "q-135566" :question/id #uuid "e269fcad-8675-50e2-b907-1b09ce78f588" :question/math-academy-id "q-135566" :question/problem "There are three cable TV providers in a particular apartment block: provider $A,$ provider $B,$ and provider $C.$ A study has shown that, each year\n\n- from the tenants using provider $A,$ $80%$ swap to provider $B$ and $10%$ swap to provider $C,$\n\n- from the tenants using provider $B,$ $25%$ swap to provider $A$ and $25%$ swap to provider $C,$\n\n- from the tenants using provider $C,$ $70%$ swap to provider $A$ and $10%$ swap to provider $B.$\n\nThe stochastic matrix that describes this situation is given below. What is the value of $a+b+c?$\n\n$$\nP=[\\begin{aligned}0.1 & a & 0.7 \\\\ 0.8 & 0.5 & b \\\\ c & 0.25 & 0.2\\end{aligned}]\n$$" :question/worked-solution "We are given the following situation for each year:\n\n- From the tenants using provider $A,$ $80%$ swap to provider $B$ and $10%$ swap to provider $C.$  This implies that $10%$ of them continue using provider $A.$\n\n- From the tenants using provider $B,$ $25%$ swap to provider $A$ and $25%$ swap to provider $C.$ This implies that $50%$ of them continue using provider $B.$\n\n- From the tenants using provider $C,$ $70%$ swap to provider $A$ and $10%$ swap to provider $B.$ This implies that $20%$ of them continue using provider $C.$\n\nWriting this information in tabular form, we obtain the following:\n\n|  |  | From: |  |  |\n| --- | --- | --- | --- | --- |\n|  |  | **Provider A** | **Provider B** | **Provider C** |\n| To: | **Provider A** | $0.1$ | $0.25$ | $0.7$ |\n| **Provider B** | $0.8$ | $0.5$ | $0.1$ |  |\n| **Provider C** | $0.1$ | $0.25$ | $0.2$ |  |\n\nWe can write the corresponding stochastic matrix as follows:\n\n$$\nP=[\\begin{aligned}0.1 & 0.25 & 0.7 \\\\ 0.8 & 0.5 & 0.1 \\\\ 0.1 & 0.25 & 0.2\\end{aligned}].\n$$\n\nFinally, we have\n\n$$\na+b+c=0.25+0.1+0.1=0.45.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-135566/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "abbdd778-7ace-5539-9d6f-cdf01804b237"] :knowledge-point/questions ["q-135566"] :db/ensure [:knowledge-point/validate]} {:db/id "q-135556/selection/34ce4b54ccccbc84417e1dc8de1785b65baa381caac1ed8f6aecebfb0e5793e1" :answer/id #uuid "213007d7-02a0-5480-a695-99e3de3a68cf" :answer/type :answer.type/text :answer/value "|  |  | From: |  |\n| --- | --- | --- | --- |\n|  |  | **Rain** | **Dry** |\n| To: | **Rain** | $0.38$ | $0.45$ |\n| **Dry** | $0.62$ | $0.55$ |  |" :db/ensure [:answer/validate]} {:db/id "q-135556/selection/927ab0306bc7c77d640ec4654742c497ce525709cf31d9f43d816924691b436a" :answer/id #uuid "a7902499-2284-5831-a9a7-7969589eb875" :answer/type :answer.type/text :answer/value "|  |  | From: |  |\n| --- | --- | --- | --- |\n|  |  | **Rain** | **Dry** |\n| To: | **Rain** | $0.62$ | $0.55$ |\n| **Dry** | $0.38$ | $0.45$ |  |" :db/ensure [:answer/validate]} {:db/id "q-135556/selection/516e7aafc4ac059be41fd419a5357a13c0380054c24706a667095338fe4b66b3" :answer/id #uuid "b3ab16f2-8651-5f58-b192-80bc6e0ee97b" :answer/type :answer.type/text :answer/value "|  |  | From: |  |\n| --- | --- | --- | --- |\n|  |  | **Rain** | **Dry** |\n| To: | **Rain** | $0.45$ | $0.38$ |\n| **Dry** | $0.55$ | $0.62$ |  |" :db/ensure [:answer/validate]} {:db/id "q-135556/selection/33d64cc5cabf62efa8f7cd0cd71426c558eea0426cfc206014599e5459c2fc9b" :answer/id #uuid "e3c0b6e6-4b95-54fe-82a8-7d935bd53119" :answer/type :answer.type/text :answer/value "|  |  | From: |  |\n| --- | --- | --- | --- |\n|  |  | **Rain** | **Dry** |\n| To: | **Rain** | $0.62$ | $0.45$ |\n| **Dry** | $0.38$ | $0.55$ |  |" :db/ensure [:answer/validate]} {:db/id "q-135556/selection/fe8b74cbf7bdff0ca7b97e108888301930db1f11756e4f088516d228f910230c" :answer/id #uuid "25f39168-7656-5388-986f-ec3e14112dd5" :answer/type :answer.type/text :answer/value "|  |  | 