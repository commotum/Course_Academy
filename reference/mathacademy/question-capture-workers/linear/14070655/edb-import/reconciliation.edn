lues, the matrix $A$ is diagonalizable, and a Jordan canonical form is\n\n$$\nJ={J}_{1}(7)\\,⊕\\,{J}_{1}(6)=[\\begin{aligned}7 & 0 \\\\ 0 & 6\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070655/state.json" "file_sha256" "c67052bf2f9b4a45f5bf80ae1d28860516e47afe9e7139dda5b8b5ffecbd52e8"} {"question" "q-112453" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070655/activity-metadata.json" "file_sha256" "a7066aa10d12f19078b3a27ba56611d3a38e8139bc4054fd44694510132822df"} {"question" "q-112453" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070655/state.json" "file_sha256" "c67052bf2f9b4a45f5bf80ae1d28860516e47afe9e7139dda5b8b5ffecbd52e8"} {"question" "q-112453" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}6 & 0 \\\\ 0 & 6\\end{aligned}]"] ["math" "[\\begin{aligned}6 & 7 \\\\ 0 & 1\\end{aligned}]"] ["math" "[\\begin{aligned}7 & 0 \\\\ 0 & 6\\end{aligned}]"] ["math" "[\\begin{aligned}7 & 1 \\\\ 0 & 6\\end{aligned}]"] ["math" "[\\begin{aligned}7 & 1 \\\\ 0 & 7\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070655/state.json" "file_sha256" "c67052bf2f9b4a45f5bf80ae1d28860516e47afe9e7139dda5b8b5ffecbd52e8"} {"question" "q-112453" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}7 & 0 \\\\ 0 & 6\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070655/state.json" "file_sha2