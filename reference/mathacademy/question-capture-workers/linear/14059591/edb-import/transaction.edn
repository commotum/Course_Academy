236f0a772ff68edddb9e2ff94c951e9cdd2049007dd3dd3b5dfe"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-42681"] :question/problem "Consider the system of equations\n\n$$\n{\\begin{aligned}-3x+5y+z=-9 \\\\ x+y-4z=-1 \\\\ -2x+8y=3.\\end{aligned}\n$$\n\nAccording to Cramer's rule, $x=\\frac{{D}_{x}}{D}$, where $D$ is the determinant of the coefficient matrix and ${D}_{x}=$" :question/worked-solution "We are given the system\n\n$$\n{\\begin{aligned}-3x+5y+1z=-9 \\\\ 1x+1y+(-4)z=-1 \\\\ -2x+8y+0z=3.\\end{aligned}\n$$\n\nThe determinant of the coefficient matrix is\n\n$$\nD=|\\begin{aligned}-3 & 5 & 1 \\\\ 1 & 1 & -4 \\\\ -2 & 8 & 0\\end{aligned}|.\n$$\n\nNow, to construct ${D}_{x}$, we replace the first column of the coefficient matrix by the right-hand side column of the given system:\n\n$$\n{D}_{x}=|\\begin{aligned}-9 & 5 & 1 \\\\ -1 & 1 & -4 \\\\ 3 & 8 & 0\\end{aligned}|.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-42681/selection/ma-v1/7a565013f64f800de4ebb7d98243ce73ba567d5ffbbb4dedf1fb1eea5c00b1c0"] :db/ensure [:question/validate]} {:db/id "q-73688/selection/78e4db90a9491c8764150dbb560d946a33cf4eb49708e3a642a985b0ca9c021c" :answer/id #uuid "97d6ed59-cd0a-5cb2-9754-869150ccc2ff" :answer/type :answer.type/math :answer/value "|\\begin{aligned}-4 & 2 & -1 \\\\ 7 & 12 & -8 \\\\ 3 & 0 & 1\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-73688/selection/7e10c6c8fa15342b495083276a3b81f58b1d11d5f7993d9b4979b8cf7fb6ffdd" :answer/id #uuid "460b565d-c3e3-5c6e-9b7b-fc5344b2b975" :answer/type :answer.type/math :answer/value "|\\begin{aligned}-4 & 6 & 2 \\\\ 7 & 0 & 12 \\\\ 3 & 5 & 0\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-73688/selection/78bd1a263653f20d4b16db2d3d9405f3d0cab9ca60a9249e3cde7972a2e33089" :answer/id #uuid "64b7da7f-60e1-531d-9477-e9821079c416" :answer/type :answer.type/math :answer/value "|\\begin{aligned}-4 & 0 & 2 \\\\ 7 & 0 & 12 \\\\ 3 & 0 & 0\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-73688/selection/b5afadfb54dbe6b5dc880e058edb2e09b186736f36b23fa67c4fb1a740177ffa" :answer/id #uuid "7cad11f9-44b6-53da-aabf-8e30ce26b61f" :answer/type :answer.type/math :answer/value "|\\begin{aligned}2 & 6 & -1 \\\\ 12 & 0 & -8 \\\\ 0 & 5 & 1\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-73688/selection/0af598252115ea373e1b5277f8872e727a38932d2f757addc95bd7e6df1e8633" :answer/id #uuid "a5040e5a-a75f-5d55-9282-44bcd1c78587" :answer/type :answer.type/math :answer/value "|\\begin{aligned}-4 & 6 & 0 \\\\ 7 & 0 & 0 \\\\ 3 & 5 & 0\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-73688/selection" :answer-field/id #uuid "3eeb98cd-5458-5d84-b1ab-f0d4fb928080" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73688/selection/7e10c6c8fa15342b495083276a3b81f58b1d11d5f7993d9b4979b8cf7fb6ffdd" :answer-field/choices ["q-73688/selection/78e4db90a9491c8764150dbb560d946a33cf4eb49708e3a642a985b0ca9c021c" "q-73688/selection/7e10c6c8fa15342b495083276a3b81f58b1d11d5f7993d9b4979b8cf7fb6ffdd" "q-73688/selection/78bd1a263653f20d4b16db2d3d9405f3d0cab9ca60a9249e3cde7972a2e33089" "q-73688/selection/b5afadfb54dbe6b5dc880e058edb2e09b186736f36b23fa67c4fb1a740177ffa" "q-73688/selection/0af598252115ea373e1b5277f8872e727a38932d2f757addc95bd7e6df1e8633"] :db/ensure [:answer-field/validate]} {:db/id "q-73688" :question/id #uuid "dfde2756-df99-506c-8f8b-640eb254c853" :question/math-academy-id "q-73688" :question/problem "Consider the system of equations \n\n$$\n{\\begin{aligned}-4x+6y-z=2 \\\\ 7x-8z=12 \\\\ 3x+5y+z=0.\\end{aligned}\n$$\n\nAccording to Cramer's rule, $z=\\frac{{D}_{z}}{D}$, where $D$ is the determinant of the coefficient matrix and ${D}_{z}=$" :question/worked-solution "We are given the system\n\n$$\n{\\begin{aligned}(-4)x+6y+(-1)z=2 \\\\ 7x+0y+(-8)z=12 \\\\ 3x+5y+1z=0.\\end{aligned}\n$$\n\nThe determinant of the coefficient matrix is\n\n$$\nD=|\\begin{aligned}-4 & 6 & -1 \\\\ 7 & 0 & -8 \\\\ 3 & 5 & 1\\end{aligned}|.\n$$\n\nNow, to construct ${D}_{z}$, we replace the third column of the coefficient matrix by the right-hand side column of the given system:\n\n$$\n{D}_{z}=|\\begin{aligned}-4 & 6 & 2 \\\\ 7 & 0 & 12 \\\\ 3 & 5 & 0\\end{aligned}|.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-73688/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b9c2dc67-95ca-52f2-a292-32891000b76a"] :knowledge-point/questions ["q-73688"] :db/ensure [:knowledge-point/validate]} {:db/id "q-139985/selection/5bb4c3597862a42ed629eee3676696577f3a466da097c6510748467181d5ea01" :answer/id #uuid "0f388ca8-65e7-554d-a8fd-3d3a959d188e" :answer/type :answer.type/math :answer/value "|\\begin{aligned}2 & -5 & 7 \\\\ -5 & 6 & 7 \\\\ 3 & -2 & -3\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-139985/selection/2accfdafa2647f050f9ad6f0fb634e67530560e17918afa68ca36b439b5d7210" :answer/id #uuid "fc98a559-6bbf-524f-b7e1-dbd315906bea" :answer/type :answer.type/math :answer/value "|\\begin{aligned}2 & -5 & 7 \\\\ -5 & 6 & 2 \\\\ 3 & -2 & 4\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-139985/selection/814a62cf74d5fbf56ecde9c4478153814b0d881b27b16f2f595ab4e789ae7bb8" :answer/id #uuid "3b7c75fe-f424-5cc1-8be5-8692c0ac3e60" :answer/type :answer.type/math :answer/value "|\\begin{aligned}2 & -5 & -7 \\\\ -5 & 6 & 11 \\\\ 3 & -2 & 5\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-139985/selection/ac2e8386bdeb0ed520b9c654fec83c23c2cac1116e1a56f549334f34e7d4ce7a" :answer/id #uuid "67f041c7-d7b9-5edd-bef5-c977a079635c" :answer/type :answer.type/math :answer/value "|\\begin{aligned}2 & -5 & -14 \\\\ -5 & 6 & -9 \\\\ 3 & -2 & -1\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-139985/selection/87c68bc59a5203b26f455448dea156e620a3565d6536faa9382affd2a4454a3f" :answer/id #uuid "f1c3acd0-0c0f-53a7-b83b-3fd2df08623f" :answer/type :answer.type/math :answer/value "|\\begin{aligned}2 & -5 & 14 \\\\ -5 & 6 & 9 \\\\ 3 & -2 & 1\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-139985/selection" :answer-field/id #uuid "6abd8c83-28a2-5047-bc01-8fad5c56653c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-139985/selection/87c68bc59a5203b26f455448dea156e620a3565d6536faa9382affd2a4454a3f" :answer-field/choices ["q-139985/selection/5bb4c3597862a42ed629eee3676696577f3a466da097c6510748467181d5ea01" "q-139985/selection/2accfdafa2647f050f9ad6f0fb634e67530560e17918afa68ca36b439b5d7210" "q-139985/selection/814a62cf74d5fbf56ecde9c4478153814b0d881b27b16f2f595ab4e789ae7bb8" "q-139985/selection/ac2e8386bdeb0ed520b9c654fec83c23c2cac1116e1a56f549334f34e7d4ce7a" "q-139985/selection/87c68bc59a5203b26f455448dea156e620a3565d6536faa9382affd2a4454a3f"] :db/ensure [:answer-field/validate]} {:db/id "q-139985" :question/id #uuid "dc681317-cba5-5425-a2bb-3eee6e432e5a" :question/math-academy-id "q-139985" :question/problem "Consider the system of equations \n\n$$\n{\\begin{aligned}2x-5y+7z=14 \\\\ -5x+6y+2z=9 \\\\ 3x-2y+4z=1.\\end{aligned}\n$$\n\nAccording to Cramer's rule, $z=\\frac{{D}_{z}}{D}$, where $D$ is the determinant of the coefficient matrix and ${D}_{z}=$" :question/worked-solution "We are given the system\n\n$$\n{\\begin{aligned}2x+(-5)y+7z=14 \\\\ -5x+6y+2z=9 \\\\ 3x+(-2)y+4z=1.\\end{aligned}\n$$\n\nThe determinant of the coefficient matrix is\n\n$$\nD=|\\begin{aligned}2 & -5 & 7 \\\\ -5 & 6 & 2 \\\\ 3 & -2 & 4\\end{aligned}|.\n$$\n\nNow, to construct ${D}_{z}$, we replace the third column of the coefficient matrix by the right-hand side column of the given system:\n\n$$\n\\begin{aligned}{D}_{z}=|\\begin{aligned}2 & -5 & 14 \\\\ -5 & 6 & 9 \\\\ 3 & -2 & 1\\end{aligned}|.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-139985/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b9c2dc67-95ca-52f2-a292-32891000b76a"] :knowledge-point/questions ["q-139985"] :db/ensure [:knowledge-point/validate]} {:db/id "q-43124/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "a5adbe48-56a3-5d8c-b6e9-20cc2aefd6e6" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-43124/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "3fdc2439-cb49-59e4-893d-14cf84a87d4e" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-43124/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "24af3807-ab08-5a46-927f-f3a33c0a21ea" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-43124/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "a3e3b73c-8e18-55e9-8ad9-4231ca11b4c2" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-43124/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "c4c2291e-0e81-5a67-95d4-94237f0f79de" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-43124/selection" :answer-field/id #uuid "bc9ccb96-42ef-537e-8227-5047403b336c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-43124/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-43124/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-43124/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-43124/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" "q-43124/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-43124/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c"] :db/ensure [:answer-field/validate]} {:db/id "q-43124" :question/id #uuid "e5084e55-f30f-50d4-ad6b-db2d733686dc" :question/math-academy-id "q-43124" :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n{\\begin{aligned}2x+y-z=1 \\\\ x-2y+2z=3 \\\\ 3x-2y+z=2\\end{aligned}\n$$\n\nGiven that the determinant of the coefficient matrix is equal to $5,$ then $x=$" :question/worked-solution "First, let's rewrite the system to reveal the coefficients:\n\n$$\n{\\begin{aligned}2x+1y+(-1)z=1 \\\\ 1x+(-2)y+2z=3 \\\\ 3x+(-2)y+1z=2.\\end{aligned}\n$$\n\nWe start by writing the determinant of the coefficients matrix, as follows:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}2 & 1 & -1 \\\\ 1 & -2 & 2 \\\\ 3 & -2 & 1\\end{aligned}|=5.\\end{aligned}\n$$\n\nNow, to find ${D}_{x}$, we replace the first column by the right-hand side of the system, and calculate the determinant:\n\n$$\n\\begin{aligned}{D}_{x}=|\\begin{aligned}1 & 1 & -1 \\\\ 3 & -2 & 2 \\\\ 2 & -2 & 1\\end{aligned}| & =1\\cdot |\\begin{aligned}-2 & 2 \\\\ -2 & 1\\end{aligned}|-1\\cdot |\\begin{aligned}3 & 2 \\\\ 2 & 1\\end{aligned}|+(-1)\\cdot |\\begin{aligned}3 & -2 \\\\ 2 & -2\\end{aligned}| \\\\  & =(-2-(-4))-(3-4)-(-6-(-4)) \\\\  & =2+1+2 \\\\  & =5.\\end{aligned}\n$$\n\nFinally, applying Cramer's rule, we get\n\n$$\n\\begin{aligned}x & =\\frac{{D}_{x}}{D}=\\frac{5}{5}=1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-43124/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "71c540ac-3cb5-5e0e-9b7b-5e2ccf1615c5"] :knowledge-point/questions ["q-43124"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-42623"] :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n{\\begin{aligned}3x+5y-z=1 \\\\ 2x-3z=-2 \\\\ -x+y-2z=6\\end{aligned}\n$$\n\nGiven that the determinant of the coefficient matrix is equal to $42,$ then $x=$" :question/worked-solution "First, let's rewrite the system to reveal the coefficients:\n\n$$\n{\\begin{aligned}3x+5y+(-1)z=1 \\\\ 2x+0y+(-3)z=-2 \\\\ (-1)x+1y+(-2)z=6.\\end{aligned}\n$$\n\nWe start by writing the determinant of the coefficients matrix, as follows:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}3 & 5 & -1 \\\\ 2 & 0 & -3 \\\\ -1 & 1 & -2\\end{aligned}|=42.\\end{aligned}\n$$\n\nNow, to find ${D}_{x}$, we replace the first column by the right-hand side of the system, and calculate the determinant:\n\n$$\n\\begin{aligned}{D}_{x}=|\\begin{aligned}1 & 5 & -1 \\\\ -2 & 0 & -3 \\\\ 6 & 1 & -2\\end{aligned}| & =1\\cdot |\\begin{aligned}0 & -3 \\\\ 1 & -2\\end{aligned}|-5\\cdot |\\begin{aligned}-2 & -3 \\\\ 6 & -2\\end{aligned}|+(-1)\\cdot |\\begin{aligned}-2 & 0 \\\\ 6 & 1\\end{aligned}| \\\\  & =(0+3)-5(4+18)-(-2-0) \\\\  & =3-110+2 \\\\  & =-105.\\end{aligned}\n$$\n\nFinally, applying Cramer's rule, we get\n\n$$\n\\begin{aligned}x & =\\frac{{D}_{x}}{D}=\\frac{-105}{42}=-\\frac{5}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-42671"] :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n{\\begin{aligned}5x-3y+z=5 \\\\ x+y-2z=-3 \\\\ -5x+4z=-1\\end{aligned}\n$$\n\nGiven that the determinant of the coefficient matrix is equal to $7,$ then $y=$" :question/worked-solution "First, let's rewrite the system to reveal the coefficients:\n\n$$\n{\\begin{aligned}5x+(-3)y+1z=5 \\\\ 1x+1y+(-2)z=-3 \\\\ -5x+0y+4z=-1\\end{aligned}\n$$\n\nWe start by writing the determinant of the coefficients matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}5 & -3 & 1 \\\\ 1 & 1 & -2 \\\\ -5 & 0 & 4\\end{aligned}|=7\\end{aligned}\n$$\n\nNow, to find ${D}_{y},$ we take the coefficients matrix, replace the second column by the right-hand side of the system, and calculate the determinant:\n\n$$\n\\begin{aligned}{D}_{y}=|\\begin{aligned}5 & 5 & 1 \\\\ 1 & -3 & -2 \\\\ -5 & -1 & 4\\end{aligned}| & =5\\cdot |\\begin{aligned}-3 & -2 \\\\ -1 & 4\\end{aligned}|-5\\cdot |\\begin{aligned}1 & -2 \\\\ -5 & 4\\end{aligned}|+1\\cdot |\\begin{aligned}1 & -3 \\\\ -5 & -1\\end{aligned}| \\\\  & =5(-12-2)-5(4-10)+(-1-15) \\\\  & =-70+30-16 \\\\  & =-56.\\end{aligned}\n$$\n\nFinally, applying Cramer's rule, we get\n\n$$\n\\begin{aligned}y & =\\frac{{D}_{y}}{D}=\\frac{-56}{7}=-8.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-73690/selection/21bc1f5ac2b6db8ca11973d9b85c1eeb6af2cd920b556e0cf3d98ab9a728286a" :answer/id #uuid "8ed72d85-0558-5884-99b9-a08d1a819b04" :answer/type :answer.type/math :answer/value "\\frac{5}{6}" :db/ensure [:answer/validate]} {:db/id "q-73690/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" :answer/id #uuid "08380bd6-130b-5d95-ae69-849e439e212b" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-73690/selection/830a08a17a3bc68a8e849c8d7e7a7e21cd8b84724f1767acc4bccbeebb91b0c8" :answer/id #uuid "66b08a1d-1947-594e-8b71-f81a880eae34" :answer/type :answer.type/math :answer/value "\\frac{1}{18}" :db/ensure [:answer/validate]} {:db/id "q-73690/selection/551f136ff3857b671ef7656e36b2b7a1f31f4551d47528d0881fd4dfc84040c0" :answer/id #uuid "e38ffdd1-b7f6-58c9-a2d6-62b4ab549617" :answer/type :answer.type/math :answer/value "\\frac{7}{9}" :db/ensure [:answer/validate]} {:db/id "q-73690/selection/8ff357f4935974c4e1a199a6769d5b598176459dfe26105f3e6a4e74539a9e47" :answer/id #uuid "0f52caf1-b1f2-5e93-8ab7-e85730d2691d" :answer/type :answer.type/math :answer/value "\\frac{11}{18}" :db/ensure [:answer/validate]} {:db/id "q-73690/selection" :answer-field/id #uuid "bb7669c3-8989-50dc-a76c-b4ea1f273722" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73690/selection/830a08a17a3bc68a8e849c8d7e7a7e21cd8b84724f1767acc4bccbeebb91b0c8" :answer-field/choices ["q-73690/selection/21bc1f5ac2b6db8ca11973d9b85c1eeb6af2cd920b556e0cf3d98ab9a728286a" "q-73690/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" "q-73690/selection/830a08a17a3bc68a8e849c8d7e7a7e21cd8b84724f1767acc4bccbeebb91b0c8" "q-73690/selection/551f136ff3857b671ef7656e36b2b7a1f31f4551d47528d0881fd4dfc84040c0" "q-73690/selection/8ff357f4935974c4e1a199a6769d5b598176459dfe26105f3e6a4e74539a9e47"] :db/ensure [:answer-field/validate]} {:db/id "q-73690" :question/id #uuid "ebeef91b-bb14-5996-92d1-28a0a60ce495" :question/math-academy-id "q-73690" :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n{\\begin{aligned}x+y+3z=-2 \\\\ 2x-y=3 \\\\ -x-2y+z=6\\end{aligned}\n$$\n\nGiven that the determinant of the coefficient matrix is equal to $-18,$ then $x=$" :question/worked-solution "First, let's rewrite the system to reveal the coefficients:\n\n$$\n{\\begin{aligned}1x+1y+3z=-2 \\\\ 2x+(-1)y+0z=3 \\\\ (-1)x+(-2)y+1z=6.\\end{aligned}\n$$\n\nWe start by writing the determinant of the coefficients matrix, as follows:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}1 & 1 & 3 \\\\ 2 & -1 & 0 \\\\ -1 & -2 & 1\\end{aligned}|=-18.\\end{aligned}\n$$\n\nNow, to find ${D}_{x}$, we replace the first column by the right-hand side of the system, and calculate the determinant:\n\n$$\n\\begin{aligned}{D}_{x}=|\\begin{aligned}-2 & 1 & 3 \\\\ 3 & -1 & 0 \\\\ 6 & -2 & 1\\end{aligned}| & =-2\\cdot |\\begin{aligned}-1 & 0 \\\\ -2 & 1\\end{aligned}|-1\\cdot |\\begin{aligned}3 & 0 \\\\ 6 & 1\\end{aligned}|+(-1)\\cdot |\\begin{aligned}3 & -1 \\\\ 6 & -2\\end{aligned}| \\\\  & =-2(-1-0)-(3-0)-(-6+6) \\\\  & =2-3-0 \\\\  & =-1.\\end{aligned}\n$$\n\nFinally, applying Cramer's rule, we get\n\n$$\n\\begin{aligned}x & =\\frac{{D}_{x}}{D}=\\frac{-1}{-18}=\\frac{1}{18}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-73690/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "71c540ac-3cb5-5e0e-9b7b-5e2ccf1615c5"] :knowledge-point/questions ["q-73690"] :db/ensure [:knowledge-point/validate]} {:db/id "q-139987/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "4efa8416-b71b-50a0-86ec-4a680256b17c" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-139987/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "6787759c-82ed-5aca-bccc-3902fda81eae" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-139987/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "e393f701-01c8-54f7-9b17-4bfda820f1fb" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-139987/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "d2a65bf9-700a-5380-aeb2-5693e6a143bf" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-139987/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "d63c4c9a-1efc-53c9-b1be-d9764656f395" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-139987/selection" :answer-field/id #uuid "5115c7d5-5395-592e-82a7-d9fb6c0fe1e9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-139987/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-139987/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-139987/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-139987/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-139987/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-139987/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473"] :db/ensure [:answer-field/validate]} {:db/id "q-139987" :question/id #uuid "ec3c1c9e-2a56-5c26-b4fb-012a626f542c" :question/math-academy-id "q-139987" :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n{\\begin{aligned}2x+4y+2z=-2 \\\\ 2x-5y+1z=-10 \\\\ 2x+y-2z=-1\\end{aligned}\n$$\n\nGiven that the determinant of the coefficient matrix is equal to $66,$ then $y=$" :question/worked-solution "First, let's rewrite the system to reveal the coefficients:\n\n$$\n{\\begin{aligned}2x+4y+2z=-2 \\\\ 2x+(-5)y+1z=-10 \\\\ 2x+1y+(-2)z=-1\\end{aligned}\n$$\n\nWe start by writing the determinant of the coefficients matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}2 & 4 & 2 \\\\ 2 & -5 & 1 \\\\ 2 & 1 & -2\\end{aligned}|=66\\end{aligned}\n$$\n\nNow, to find ${D}_{y},$ we take the coefficients matrix, replace the second column by the right-hand side of the system, and calculate the determinant:\n\n$$\n\\begin{aligned}{D}_{y}=|\\begin{aligned}2 & -2 & 2 \\\\ 2 & -10 & 1 \\\\ 2 & -1 & -2\\end{aligned}| & =2\\cdot |\\begin{aligned}-10 & 1 \\\\ -1 & -2\\end{aligned}|-(-2)\\cdot |\\begin{aligned}2 & 1 \\\\ 2 & -2\\end{aligned}|+2\\cdot |\\begin{aligned}2 & -10 \\\\ 2 & -1\\end{aligned}| \\\\  & =2(20+1)+2(-4-2)+2(-2+20) \\\\  & =42-12+36 \\\\  & =66.\\end{aligned}\n$$\n\nFinally, applying Cramer's rule, we get\n\n$$\n\\begin{aligned}y & =\\frac{{D}_{y}}{D}=\\frac{66}{66}=1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-139987/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "71c540ac-3cb5-5e0e-9b7b-5e2ccf1615c5"] :knowledge-point/questions ["q-139987"] :db/ensure [:knowledge-point/validate]} {:db/id "q-43111/selection/99308c630bb61642567370331cf7f00923f341daf010971193b3aeace8b32c69" :answer/id #uuid "c9462c7a-c4e9-5fc4-bb4e-e75059cdf0e5" :answer/type :answer.type/math :answer/value "k=4" :db/ensure [:answer/validate]} {:db/id "q-43111/selection/4e2429b00a3baaac76f6e33158fbcdff5dcf0af49a1b90a9dac6995df4919225" :answer/id #uuid "d96612d7-2c0d-5c43-a025-1e514a946d01" :answer/type :answer.type/math :answer/value "k=5" :db/ensure [:answer/validate]} {:db/id "q-43111/selection/a80a330cf07901aff7b5aa904c4a3541c2351751eef1834664dea83e123d76ff" :answer/id #uuid "db0b321a-721a-5606-94b1-03bbeb804045" :answer/type :answer.type/math :answer/value "k=1" :db/ensure [:answer/validate]} {:db/id "q-43111/selection/e3dbb6296906b72dd0511b45b9171b9cca162c2f0d1c5924ef315cf1c16044f5" :answer/id #uuid "e95c287f-ac22-5725-846f-cb7fb5abbd54" :answer/type :answer.type/math :answer/value "k=-3" :db/ensure [:answer/validate]} {:db/id "q-43111/selection/ac9ae2052cc2e067abcad4ecf5a3f3d17a02fa2d9a881931a644b74ccc7546a6" :answer/id #uuid "5958a7e0-d7b8-537a-bcc4-0db66f2af9b8" :answer/type :answer.type/math :answer/value "k=-6" :db/ensure [:answer/validate]} {:db/id "q-43111/selection" :answer-field/id #uuid "ff51e010-33ca-5af4-85f5-4176bdd31b6a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-43111/selection/ac9ae2052cc2e067abcad4ecf5a3f3d17a02fa2d9a881931a644b74ccc7546a6" :answer-field/choices ["q-43111/selection/99308c630bb61642567370331cf7f00923f341daf010971193b3aeace8b32c69" "q-43111/selection/4e2429b00a3baaac76f6e33158fbcdff5dcf0af49a1b90a9dac6995df4919225" "q-43111/selection/a80a330cf07901aff7b5aa904c4a3541c2351751eef1834664dea83e123d76ff" "q-43111/selection/e3dbb6296906b72dd0511b45b9171b9cca162c2f0d1c5924ef315cf1c16044f5" "q-43111/selection/ac9ae2052cc2e067abcad4ecf5a3f3d17a02fa2d9a881931a644b74ccc7546a6"] :db/ensure [:answer-field/validate]} {:db/id "q-43111" :question/id #uuid "d5aa8446-02d6-51e0-93fb-a5e6dc5a4473" :question/math-academy-id "q-43111" :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n{\\begin{aligned}5x-3y-z=1 \\\\ x+4y+kz=-1 \\\\ 2x+3y+4z=9.\\end{aligned}\n$$\n\nGiven that  $z=1$ and that the determinant of the coefficient matrix is equal to $97-21k,$ find the value of $k.$" :question/worked-solution "First, let's write the determinant of the coefficient matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}5 & -3 & -1 \\\\ 1 & 4 & k \\\\ 2 & 3 & 4\\end{aligned}|=97-21k\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $z$ is given by $z=\\frac{{D}_{z}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{z}=|\\begin{aligned}5 & -3 & 1 \\\\ 1 & 4 & -1 \\\\ 2 & 3 & 9\\end{aligned}| & =5\\cdot |\\begin{aligned}4 & -1 \\\\ 3 & 9\\end{aligned}|-(-3)\\cdot |\\begin{aligned}1 & -1 \\\\ 2 & 9\\end{aligned}|+1\\cdot |\\begin{aligned}1 & 4 \\\\ 2 & 3\\end{aligned}| \\\\  & =5(36+3)+3(9+2)+(3-8) \\\\  & =195+33-5 \\\\  & =223.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nz=\\frac{{D}_{z}}{D}=\\frac{223}{97-21k}.\n$$\n\nFrom the problem statement, we know that $z=1.$ So, we can solve for $k$ as follows:\n\n$$\n\\begin{aligned}\\frac{223}{97-21k} & =1 \\\\ 223 & =97-21k \\\\ 21k & =-126 \\\\ k & =-6.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-43111/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7263e25b-117e-528c-b2ad-2624f325da35"] :knowledge-point/questions ["q-43111"] :db/ensure [:knowledge-point/validate]} {:db/id "q-140043/selection/fec406b037c336df04ddc47abb8cf02e3ae194404415f3659041d4a99c636727" :answer/id #uuid "7e372905-bf0a-546b-a628-c090cb9970b1" :answer/type :answer.type/math :answer/value "k=-4" :db/ensure [:answer/validate]} {:db/id "q-140043/selection/a9d809426690fc6065e8673c85a555723d4ab72d745ec39834681473e579f93a" :answer/id #uuid "6d744429-c9d6-54f9-ab40-17933949c698" :answer/type :answer.type/math :answer/value "k=2" :db/ensure [:answer/validate]} {:db/id "q-140043/selection/d8a1a66d52573b40c97531ec83902e7d5c053a629619f48b95bf9742d3eabd83" :answer/id #uuid "2d40e0d5-2d12-5098-8ea5-843f2f305c7b" :answer/type :answer.type/math :answer/value "k=9" :db/ensure [:answer/validate]} {:db/id "q-140043/selection/c00312f5b528cc391b7b33597f8aa73e2f5bf76538b1521f031d1b22f7578d8a" :answer/id #uuid "520e2a65-54d8-50b9-97bc-488c98f2210f" :answer/type :answer.type/math :answer/value "k=11" :db/ensure [:answer/validate]} {:db/id "q-140043/selection/a80a330cf07901aff7b5aa904c4a3541c2351751eef1834664dea83e123d76ff" :answer/id #uuid "5c6db2f6-826c-5a27-b46a-69b5ebe01437" :answer/type :answer.type/math :answer/value "k=1" :db/ensure [:answer/validate]} {:db/id "q-140043/selection" :answer-field/id #uuid "63879d92-0fd2-5899-a811-72c8353c96d0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-140043/selection/a80a330cf07901aff7b5aa904c4a3541c2351751eef1834664dea83e123d76ff" :answer-field/choices ["q-140043/selection/fec406b037c336df04ddc47abb8cf02e3ae194404415f3659041d4a99c636727" "q-140043/selection/a9d809426690fc6065e8673c85a555723d4ab72d745ec39834681473e579f93a" "q-140043/selection/d8a1a66d52573b40c97531ec83902e7d5c053a629619f48b95bf9742d3eabd83" "q-140043/selection/c00312f5b528cc391b7b33597f8aa73e2f5bf76538b1521f031d1b22f7578d8a" "q-140043/selection/a80a330cf07901aff7b5aa904c4a3541c2351751eef1834664dea83e123d76ff"] :db/ensure [:answer-field/validate]} {:db/id "q-140043" :question/id #uuid "331e1a6c-be73-51ec-ae92-9f497d84d18c" :question/math-academy-id "q-140043" :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n{\\begin{aligned}6x+5y-3z=2 \\\\ 4x-5y+kz=1 \\\\ -2x+10y-5z=-2.\\end{aligned}\n$$\n\nGiven that  $x=\\frac{1}{2}$ and that the determinant of the coefficient matrix is equal to $160-70k,$ find the value of $k.$" :question/worked-solution "First, let's write the determinant of the coefficient matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}6 & 5 & -2 \\\\ 4 & -5 & k \\\\ -2 & 10 & -5\\end{aligned}|=160-70k\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $x$ is given by $x=\\frac{{D}_{x}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{x}=|\\begin{aligned}2 & 5 & -3 \\\\ 1 & -5 & k \\\\ -2 & 10 & -5\\end{aligned}| & =2\\cdot |\\begin{aligned}-5 & k \\\\ 10 & -5\\end{aligned}|-5\\cdot |\\begin{aligned}1 & k \\\\ -2 & -5\\end{aligned}|+(-3)\\cdot |\\begin{aligned}1 & -5 \\\\ -2 & 10\\end{aligned}| \\\\  & =2(25-10k)-5(-5+2k)-3(10-10) \\\\  & =50-20k+25-10k+0 \\\\  & =75-30k.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nx=\\frac{{D}_{x}}{D}=\\frac{75-30k}{160-70k}.\n$$\n\nFrom the problem statement, we know that $x=\\frac{1}{2}.$ So, we can solve for $k$ as follows:\n\n$$\n\\begin{aligned}\\frac{75-30k}{160-70k} & =\\frac{1}{2} \\\\ 2(75-30k) & =160-70k \\\\ 150-60k & =160-70k \\\\ 10k & =10 \\\\ k & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-140043/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7263e25b-117e-528c-b2ad-2624f325da35"] :knowledge-point/questions ["q-140043"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73694/selection/e3dbb6296906b72dd0511b45b9171b9cca162c2f0d1c5924ef315cf1c16044f5" :answer/id #uuid "34400ad0-c331-5035-a94b-6b9057827fee" :answer/type :answer.type/math :answer/value "k=-3" :db/ensure [:answer/validate]} {:db/id "q-73694/selection/3c752b55a9d477bd0ba6387c5f2201a280295f1502439e3749cf69f3da3e0cae" :answer/id #uuid "97d91fe9-c39a-5cf1-bdd9-0ce1e60c3382" :answer/type :answer.type/math :answer/value "k=3" :db/ensure [:answer/validate]} {:db/id "q-73694/selection/fec406b037c336df04ddc47abb8cf02e3ae194404415f3659041d4a99c636727" :answer/id #uuid "335f1839-2d8f-57aa-be7c-42007a87199e" :answer/type :answer.type/math :answer/value "k=-4" :db/ensure [:answer/validate]} {:db/id "q-73694/selection/40a1a273986776af283f3fe5271d8cce9b3f9fa9c2c7fc5bf8516dd5a30de4b0" :answer/id #uuid "4c0ca57f-a015-531e-97cd-4c402a506333" :answer/type :answer.type/math :answer/value "k=-2" :db/ensure [:answer/validate]} {:db/id "q-73694/selection/d8632041aa9cb2a71b6ada1b8f9b15e5f58f906bc98b3276e25ff9a0f4ed73ae" :answer/id #uuid "a19474d4-3ddb-5ea5-ac74-b6e2d2ef142c" :answer/type :answer.type/math :answer/value "k=7" :db/ensure [:answer/validate]} {:db/id "q-73694/selection" :answer-field/id #uuid "8a1af9e5-1ed4-5b7b-a644-c03f0bce16a4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73694/selection/e3dbb6296906b72dd0511b45b9171b9cca162c2f0d1c5924ef315cf1c16044f5" :answer-field/choices ["q-73694/selection/e3dbb6296906b72dd0511b45b9171b9cca162c2f0d1c5924ef315cf1c16044f5" "q-73694/selection/3c752b55a9d477bd0ba6387c5f2201a280295f1502439e3749cf69f3da3e0cae" "q-73694/selection/fec406b037c336df04ddc47abb8cf02e3ae194404415f3659041d4a99c636727" "q-73694/selection/40a1a273986776af283f3fe5271d8cce9b3f9fa9c2c7fc5bf8516dd5a30de4b0" "q-73694/selection/d8632041aa9cb2a71b6ada1b8f9b15e5f58f906bc98b3276e25ff9a0f4ed73ae"] :db/ensure [:answer-field/validate]} {:db/id "q-73694" :question/id #uuid "c9a3e974-f820-5185-9b0b-9dcc400af0e6" :question/math-academy-id "q-73694" :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n{\\begin{aligned}2x+3y+z=3 \\\\ x-z=k \\\\ x-2y+2z=1\\end{aligned}\n$$\n\nGiven that $z=2$ and that the determinant of the coefficient matrix is equal to $-15,$ find the value of $k.$" :question/worked-solution "First, let's write the determinant of the coefficients matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}2 & 3 & 1 \\\\ 1 & 0 & -1 \\\\ 1 & -2 & 2\\end{aligned}|=-15\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $z$ is given by $z=\\frac{{D}_{z}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{z}=|\\begin{aligned}2 & 3 & 3 \\\\ 1 & 0 & k \\\\ 1 & -2 & 1\\end{aligned}| & =2\\cdot |\\begin{aligned}0 & k \\\\ -2 & 1\\end{aligned}|-3\\cdot |\\begin{aligned}1 & k \\\\ 1 & 1\\end{aligned}|+3\\cdot |\\begin{aligned}1 & 0 \\\\ 1 & -2\\end{aligned}| \\\\  & =2(0+2k)-3(1-k)+3(-2-0) \\\\  & =4k-3+3k-6 \\\\  & =7k-9.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nz=\\frac{{D}_{z}}{D}=\\frac{7k-9}{-15}.\n$$\n\nFrom the problem statement, we know that $z=2.$ So, we can solve for $k$ as follows:\n\n$$\n\\begin{aligned}\\frac{7k-9}{-15} & =2 \\\\ 7k-9 & =-30 \\\\ 7k & =-21 \\\\ k & =-3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-73694/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7263e25b-117e-528c-b2ad-2624f325da35"] :knowledge-point/questions ["q-73694"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-43113"] :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n{\\begin{aligned}2x-y+2z=6 \\\\ 3x+2y-z=k \\\\ 4x+3y-3z=1\\end{aligned}\n$$\n\nGiven that $x=1$ and that the determinant of the coefficient matrix is equal to $-9,$ find the value of $k.$" :question/worked-solution "First, let's write the determinant of the coefficients matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}2 & -1 & 2 \\\\ 3 & 2 & -1 \\\\ 4 & 3 & -3\\end{aligned}|=-9\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $x$ is given by $x=\\frac{{D}_{x}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{x}=|\\begin{aligned}6 & -1 & 2 \\\\ k & 2 & -1 \\\\ 1 & 3 & -3\\end{aligned}| & =6\\cdot |\\begin{aligned}2 & -1 \\\\ 3 & -3\\end{aligned}|-(-1)\\cdot |\\begin{aligned}k & -1 \\\\ 1 & -3\\end{aligned}|+2\\cdot |\\begin{aligned}k & 2 \\\\ 1 & 3\\end{aligned}| \\\\  & =6(-6+3)+(-3k+1)+2(3k-2) \\\\  & =-18-3k+1+6k-4 \\\\  & =3k-21.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nx=\\frac{{D}_{x}}{D}=\\frac{3k-21}{-9}.\n$$\n\nFrom the problem statement, we know that $x=1.$ So, we can solve for $k$ as follows:\n\n$$\n\\begin{aligned}\\frac{-9}{3k-21} & =1 \\\\ -9 & =3k-21 \\\\ 12 & =3k \\\\ k & =4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-73698/selection/3c752b55a9d477bd0ba6387c5f2201a280295f1502439e3749cf69f3da3e0cae" :answer/id #uuid "196bbe75-f665-52f6-9880-cfdee05c2629" :answer/type :answer.type/math :answer/value "k=3" :db/ensure [:answer/validate]} {:db/id "q-73698/selection/d8632041aa9cb2a71b6ada1b8f9b15e5f58f906bc98b3276e25ff9a0f4ed73ae" :answer/id #uuid "351bf833-39b3-5a78-a846-13f0f839edae" :answer/type :answer.type/math :answer/value "k=7" :db/ensure [:answer/validate]} {:db/id "q-73698/selection/a9d809426690fc6065e8673c85a555723d4ab72d745ec39834681473e579f93a" :answer/id #uuid "afb8eeba-8974-593d-be16-f419bd6447c3" :answer/type :answer.type/math :answer/value "k=2" :db/ensure [:answer/validate]} {:db/id "q-73698/selection/e3dbb6296906b72dd0511b45b9171b9cca162c2f0d1c5924ef315cf1c16044f5" :answer/id #uuid "77f94c55-4a88-58f3-ae11-7f9ac42741eb" :answer/type :answer.type/math :answer/value "k=-3" :db/ensure [:answer/validate]} {:db/id "q-73698/selection/2288413a383e153ad9acb6430532cecdb55509b55573ff6fd9f6b1db345a1152" :answer/id #uuid "853a81ab-d822-586d-8414-d6ae5935a83a" :answer/type :answer.type/math :answer/value "k=-7" :db/ensure [:answer/validate]} {:db/id "q-73698/selection" :answer-field/id #uuid "016b67e1-6019-5605-a354-33b891947928" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73698/selection/d8632041aa9cb2a71b6ada1b8f9b15e5f58f906bc98b3276e25ff9a0f4ed73ae" :answer-field/choices ["q-73698/selection/3c752b55a9d477bd0ba6387c5f2201a280295f1502439e3749cf69f3da3e0cae" "q-73698/selection/d8632041aa9cb2a71b6ada1b8f9b15e5f58f906bc98b3276e25ff9a0f4ed73ae" "q-73698/selection/a9d809426690fc6065e8673c85a555723d4ab72d745ec39834681473e579f93a" "q-73698/selection/e3dbb6296906b72dd0511b45b9171b9cca162c2f0d1c5924ef315cf1c16044f5" "q-73698/selection/2288413a383e153ad9acb6430532cecdb55509b55573ff6fd9f6b1db345a1152"] :db/ensure [:answer-field/validate]} {:db/id "q-73698" :question/id #uuid "72d31309-5c4e-58c9-abc0-d67229855def" :question/math-academy-id "q-73698" :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n{\\begin{aligned}2x+3y+2z=k \\\\ x+y=-1 \\\\ y+z=2\\end{aligned}\n$$\n\nGiven that $y=-5$ and that the determinant of the coefficient matrix is equal to $1,$ find the value of $k.$" :question/worked-solution "First, let's write the determinant of the coefficients matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}2 & 3 & 2 \\\\ 1 & 1 & 0 \\\\ 0 & 1 & 1\\end{aligned}|=1\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $y$ is given by $y=\\frac{{D}_{y}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{y}=|\\begin{aligned}2 & k & 2 \\\\ 1 & -1 & 0 \\\\ 0 & 2 & 1\\end{aligned}| & =2\\cdot |\\begin{aligned}-1 & 0 \\\\ 2 & 1\\end{aligned}|-k\\cdot |\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}|+2\\cdot |\\begin{aligned}1 & -1 \\\\ 0 & 2\\end{aligned}| \\\\  & =2(-1-0)-k(1-0)+2(2-0) \\\\  & =-2-k+4 \\\\  & =2-k.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\ny=\\frac{{D}_{y}}{D}=\\frac{2-k}{1}=2-k.\n$$\n\nFrom the problem statement, we know that $y=-5.$ So, we can solve for $k$ as follows:\n\n$$\n\\begin{aligned}2-k & =-5 \\\\ k & =7.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-73698/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7263e25b-117e-528c-b2ad-2624f325da35"] :knowledge-point/questions ["q-73698"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-6172"] :question/problem "Consider the system of equations\n\n$$\n{\\begin{aligned}9x+3y-6z=8 \\\\ -6x+4y+2z=3 \\\\ 5x-5y-15z=10.\\end{aligned}\n$$\n\nAccording to Cramer's rule, $x=\\dfrac{D_x}{D}$, where $D$ is the determinant of the coefficient matrix and $D_x=$" :question/worked-solution "We are given the system\n\n$$\n{\\begin{aligned}9x+3y+(-6)z=8 \\\\ (-6)x+4y+2z=3 \\\\ 5x+(-5)y+(-15)z=10.\\end{aligned}\n$$\n\nThe determinant of the coefficient matrix is\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059591/assets/00a69fe1d48b41e376971f3669ae51668733d36dfda18c0f9cc736d5d071a441.png)\n\nNow, to construct $D_x$, we replace the first column of the coefficient matrix by the right-hand side column of the given system:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059591/assets/14e850c9af7c0b2fdd1e36299667b2cbe91c84e8bb90030b729ee23b296ad984.png)" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4577"] :question/problem "Let $\\langle x,y,z \\rangle$ be the solution of the system of equations below. Find $z.$\n\n$$\n{\\begin{aligned}x-y+3z=-1 \\\\ 4x-2z=1 \\\\ 3x+y-z=-2\\end{aligned}\n$$" :question/worked-solution "First, let's rewrite the system to reveal the coefficients:\n\n$$\n{\\begin{aligned}1x-1y+3z=-1 \\\\ 4x+0y-2z=1 \\\\ 3x+1y-1z=-2\\end{aligned}\n$$\n\nWe start by finding the determinant of the coefficients matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}1 & -1 & 3 \\\\ 4 & 0 & -2 \\\\ 3 & 1 & -1\\end{aligned}| & =1\\cdot |\\begin{aligned}0 & -2 \\\\ 1 & -1\\end{aligned}|-(-1)\\cdot |\\begin{aligned}4 & -2 \\\\ 3 & -1\\end{aligned}|+3\\cdot |\\begin{aligned}4 & 0 \\\\ 3 & 1\\end{aligned}| \\\\  & =(0-(-2))+(-4+6)+3(4-0) \\\\  & =2+2+12 \\\\  & =16\\end{aligned}\n$$\n\nNow, to find $D_z,$ we take the coefficients matrix, replace the *third* column by the right-hand side of the system, and calculate the determinant:\n\n$$\n\\begin{aligned}{D}_{z}=|\\begin{aligned}1 & -1 & -1 \\\\ 4 & 0 & 1 \\\\ 3 & 1 & -2\\end{aligned}| & =1\\cdot |\\begin{aligned}0 & 1 \\\\ 1 & -2\\end{aligned}|-(-1)\\cdot |\\begin{aligned}4 & 1 \\\\ 3 & -2\\end{aligned}|+(-1)\\cdot |\\begin{aligned}4 & 0 \\\\ 3 & 1\\end{aligned}| \\\\  & =(0-1)+(-8-3)-(4-0) \\\\  & =-1-11-4 \\\\  & =-16\\end{aligned}\n$$\n\nFinally, applying Cramer's rule, we get\n\n$$\n\\begin{aligned}z & =\\frac{{D}_{z}}{D}=\\frac{-16}{16}=-1.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4579"] :question/problem "Let $\\langle x,y,z \\rangle$ be the solution of the system of equations below. Given that $x = 2,$ find the value of $k.$\n\n$$\n{\\begin{aligned}x+2y-z=-1 \\\\ kx+3y-2z=1 \\\\ 3x-y+2z=3\\end{aligned}\n$$" :question/worked-solution "First, let's find the determinant of the coefficients matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}1 & 2 & -1 \\\\ k & 3 & -2 \\\\ 3 & -1 & 2\\end{aligned}| & =1\\cdot |\\begin{aligned}3 & -2 \\\\ -1 & 2\\end{aligned}|-2\\cdot |\\begin{aligned}k & -2 \\\\ 3 & 2\\end{aligned}|+(-1)\\cdot |\\begin{aligned}k & 3 \\\\ 3 & -1\\end{aligned}| \\\\  & =(6-2)-2(2k+6)-(-k-9) \\\\  & =4-4k-12+k+9 \\\\  & =1-3k\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $x$ is given by $x = \\dfrac{D_x}{D},$ where\n\n$$\n\\begin{aligned}{D}_{x}=|\\begin{aligned}-1 & 2 & -1 \\\\ 1 & 3 & -2 \\\\ 3 & -1 & 2\\end{aligned}| & =(-1)\\cdot |\\begin{aligned}3 & -2 \\\\ -1 & 2\\end{aligned}|-2\\cdot |\\begin{aligned}1 & -2 \\\\ 3 & 2\\end{aligned}|+(-1)\\cdot |\\begin{aligned}1 & 3 \\\\ 3 & -1\\end{aligned}| \\\\  & =-(6-2)-2(2+6)-(-1-9) \\\\  & =-4-16+10 \\\\  & =-10.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nx = \\dfrac{D_x}{D} = \\dfrac{-10}{1-3k}.\n$$\n\nFrom the problem statement, we know that $x=2.$ So, we can solve for $k$ as follows:\n\n$$\n\\begin{aligned}\\frac{-10}{1-3k} & =2 \\\\ -10 & =2-6k \\\\ 6k & =12 \\\\ k & =2\\end{aligned}\n$$" :db/ensure [:question/validate]}]
