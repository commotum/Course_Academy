c8a2f5a34ac71ec77963bc7d5c374ac1c90a4261e" "basis" 761 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13973600/edb-import/verification.json"} {"question" "q-128030" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "{f}^{2}+{g}^{2}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13973600/state.json" "file_sha256" "2031ff9c967ebaa718901c3c8a2f5a34ac71ec77963bc7d5c374ac1c90a4261e" "basis" 761 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13973600/edb-import/verification.json"} {"question" "q-128030" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "gf(f-g)"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13973600/state.json" "file_sha256" "2031ff9c967ebaa718901c3c8a2f5a34ac71ec77963bc7d5c374ac1c90a4261e" "basis" 761 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13973600/edb-import/verification.json"} {"question" "e-4439" "field" nil "attribute" "question/problem" "value" "Calculate the minor of the entry $b_{21}$ in the matrix\n\n$$\n[\\begin{aligned}10 & 1 & 5 \\\\ 3 & 6 & 8 \\\\ 4 & 7 & 2\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13973600/example-4439.json" "file_sha256" "52f40ccd834aaab7ac53f555879411bf4897dc5b68d572af815dc32e7284b121" "basis" 761 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13973600/edb-import/verification.json"} {"question" "e-4439" "field" nil "attribute" "question/worked-solution" "value" "The minor of $b_{21} = 3$ (second row, first column) is the determinant of the remaining entries when the column and row containing $3$ are removed: \n\n$$\n[\\begin{aligned}∗ & 1 & 5 \\\\ 3 & ∗ & ∗ \\\\ ∗ & 7 & 2\\end{aligned}]\n$$\n\nSo, the minor of $b_{21}=3$ is\n\n$$\n\\begin{aligned}det[\\begin{aligned}1 & 5 \\\\ 7 & 2\\end{aligned}] & =|\\begin{aligned}1 & 5 \\\\ 7 & 2\\end{aligned}| \\\\  & =1\\cdot 2-5\\cdot 7 \\\\  & =2-35 \\\\  & =-33.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13973600/example-4439.json" "file_sha256" "52f40ccd834aaab7ac53f555879411bf4897dc5b68d572af815dc32e7284b121" "basis" 761 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13973600/edb-import/verification.json"} {"question" "e-4440" "field" nil "attribute" "question/problem" "value" "What is the minor of $c_{22}$ in the matrix\n\n$$\n[\\begin{aligned}7x & 0 & -3y \\\\ 1 & x+2y & 4 \\\\ -y & 0 & 5\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13973600/example-4440.json" "file_sha256" "a5112db55b664532de0130c202c6b6e919c5c44ac143c1b3e00ea18492050162" "basis" 761 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13973600/edb-import/verification.json"} {"question" "e-4440" "field" nil "attribute" "question/worked-solution" "value" "First, we remove the second row and second column: \n\n$$\n[\\begin{aligned}7x & ∗ & -3y \\\\ ∗ & x+2y & ∗ \\\\ -y & ∗ & 5\\end{aligned}]\n$$\n\nNext, we calculate the determinant:\n\n$$\n\\begin{aligned}det[\\begin{aligned}7x & -3y \\\\ -y & 5\\end{aligned}] & =|\\begin{aligned}7x & -3y \\\\ -y & 5\\end{aligned}| \\\\  & =7x\\cdot 5-(-3y)\\cdot (-y) \\\\  & =35x-3{y}^{2}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13973600/example-4440.json" "file_sha256" "a5112db55b664532de0130c202c6b6e919c5c44ac143c1b3e00ea18492050162" "basis" 761 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13973600/edb-import/verification.json"} {"question" "e-4441" "field" nil "attribute" "question/problem" "value" "Given that the minor of $a_{23}$ is $5,$ find all the possible values of $k$ in the matrix\n\n$$\n[\\begin{aligned}k & 3 & -1 \\\\ -5 & 2 & 7 \\\\ -1 & 2k & -6\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13973600/example-4441.json" "file_sha256" "7b0302819c882ad98b46d9e471117c6f55cf0debed9240f0e7ab4734d6d5219a" "basis" 761 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13973600/edb-import/verification.json"} {"question" "e-4441" "field" nil "attribute" "question/worked-solution" "value" "First, we remove the second row and third column:\n\n$$\n[\\begin{aligned}k & 3 & ∗ \\\\ ∗ & ∗ & 7 \\\\ -1 & 2k & ∗\\end{aligned}]\n$$\n\nThe minor of $a_{23}$ is\n\n$$\n\\begin{aligned}det[\\begin{aligned}k & 3 \\\\ -1 & 2k\\end{aligned}] & =|\\begin{aligned}k & 3 \\\\ -1 & 2k\\end{aligned}| \\\\  & =k\\cdot 2k-3\\cdot (-1) \\\\  & =2{k}^{2}+3.\\end{aligned}\n$$\n\nWe're told that the minor of $a_{23}$ is $5,$ so we must have:\n\n$$\n\\begin{aligned}2{k}^{2}+3 & =5 \\\\ 2{k}^{2} & =2 \\\\ {k}^{2} & =1 \\\\ k & =\\pm 1\\end{aligned}\n$$\n\nTherefore, the solutions are $k=-1$ and $k=1.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13973600/example-4441.json" "file_sha256" "7b0302819c882ad98b46d9e471117c6f55cf0debed9240f0e7ab4734d6d5219a" "basis" 761 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13973600/edb-import/verification.json"} {"question" "q-275530" "field" nil "attribute" "question/problem" "value" "Given that the minor of ${a}_{11}$ is $17$, find all the possible values of $p$ in the matrix\n\n$$\nA=[\\begin{aligned}5 & 2 & 3 \\\\ 1 & p & 4 \\\\ 6 & -2 & p\\end{aligned}].\n$$\n\nIn **ascending order**, the values of $p$ are\n\n$p=$ \n{{field-1}} $\\,$ and $\\,p=$\n{{field-2}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979306/state.json" "file_sha256" "e8bbdc1efc5aa0b9a7ba1232bc640074938c5346633459d8f769b279b7c14358" "basis" 853 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979306/edb-import/verification.json"} {"question" "q-275530" "field" nil "attribute" "question/worked-solution" "value" "To evaluate the minor of ${a}_{11},$ we remove the first row and first column:\n\n$$\nA=[\\begin{aligned}5 & ∗ & ∗ \\\\ ∗ & p & 4 \\\\ ∗ & -2 & p\\end{aligned}]\n$$\n\nSo, the minor of ${a}_{11}$ is\n\n \n\n$$\n\\begin{aligned}\\text{det}[\\begin{aligned}p & 4 \\\\ -2 & p\\end{aligned}] & =|\\begin{aligned}p & 4 \\\\ -2 & p\\end{aligned}| \\\\  & =p\\cdot p-4\\cdot (-2) \\\\  & ={p}^{2}+8.\\end{aligned}\n$$\n\nWe're told that the minor of ${a}_{11}$ is $17$, so we get\n\n$$\n\\begin{aligned}{p}^{2}+8 & =17 \\\\ {p}^{2}-9 & =0 \\\\ (p-3)(p+3) & =0.\\end{aligned}\n$$\n\nTherefore, in ascending order, the solutions are $p=-3$ and $p=3.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979306/state.json" "file_sha256" "e8bbdc1efc5aa0b9a7ba1232bc640074938c5346633459d8f769b279b7c14358" "basis" 853 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979306/edb-import/verification.json"} {"question" "q-275530" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979306/activity-metadata.json" "file_sha256" "9e190c333e855850688ad931cdee76a7d34af7ad2b7d8601d9dd703ab3b989bd" "basis" 853 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979306/edb-import/verification.json"} {"question" "q-275530" "field" "field-1" "attribute" "answer-field/type" "value" :