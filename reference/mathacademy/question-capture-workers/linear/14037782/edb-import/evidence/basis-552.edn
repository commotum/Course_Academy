#{[{:db/id #edb/ref 17592186257814 :knowledge-point/_questions [{:knowledge-point/id #uuid "2e1b4442-eca7-5283-9d5d-5bcbd1d67975" :knowledge-point/title "Calculating a Minor in a 3x3 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cedb97a5-a477-5288-a35c-c5df85b5d92d" :answer/type {:db/ident :answer.type/math} :answer/value "68" :db/id #edb/ref 17592186257816}] :answer-field/correct {:answer/id #uuid "cedb97a5-a477-5288-a35c-c5df85b5d92d" :answer/type {:db/ident :answer.type/math} :answer/value "68" :db/id #edb/ref 17592186257816} :answer-field/id #uuid "0f71b00e-de6c-5483-9764-a413e5bd29b4" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257815}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f7eee920-abd1-5e92-872a-5f2d162a508d" :question/math-academy-id "q-127701" :question/problem "Calculate the minor of the entry ${p}_{32}$ in the matrix\n$P=[\\begin{aligned}8 & 8 & 4 \\\\ -5 & 4 & 6 \\\\ 10 & 3 & 0\\end{aligned}].$\n\nAnswer: {{answer}}" :question/worked-solution "The minor of ${p}_{32}=3$ (third row, second column) is the determinant of the remaining entries when the column and row containing $3$ are removed: \n\n$$\nP=[\\begin{aligned}8 & ∗ & 4 \\\\ -5 & ∗ & 6 \\\\ ∗ & 3 & ∗\\end{aligned}]\n$$\n\nSo, the minor of ${p}_{32}=3$ is\n\n$$\n\\begin{aligned}\\text{det}[\\begin{aligned}8 & 4 \\\\ -5 & 6\\end{aligned}] & =|\\begin{aligned}8 & 4 \\\\ -5 & 6\\end{aligned}| \\\\  & =8\\cdot 6-4\\cdot (-5) \\\\  & =48+20 \\\\  & =68.\\end{aligned}\n$$"}]}
