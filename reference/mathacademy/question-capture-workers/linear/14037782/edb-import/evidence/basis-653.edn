#{[{:db/id #edb/ref 17592186257814 :knowledge-point/_questions [{:knowledge-point/id #uuid "2e1b4442-eca7-5283-9d5d-5bcbd1d67975" :knowledge-point/title "Calculating a Minor in a 3x3 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c6f6331-3ac5-53aa-bc06-82af95a393bd" :answer/type {:db/ident :answer.type/math} :answer/value "− 7" :db/id #edb/ref 17592186270797} {:answer/id #uuid "65d7e823-c5bf-52ab-b7c3-434eeac22186" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186270798} {:answer/id #uuid "cb3c79ac-a26f-543b-bfd4-d5be97b5af63" :answer/type {:db/ident :answer.type/math} :answer/value "68" :db/id #edb/ref 17592186270799} {:answer/id #uuid "17df280f-fd7f-5701-b5b1-34c15f8dc6ef" :answer/type {:db/ident :answer.type/math} :answer/value "− 8" :db/id #edb/ref 17592186270800} {:answer/id #uuid "bbbba8b3-1347-55cd-8c85-ecd622bd0787" :answer/type {:db/ident :answer.type/math} :answer/value "− 6" :db/id #edb/ref 17592186270801}] :answer-field/correct {:answer/id #uuid "cb3c79ac-a26f-543b-bfd4-d5be97b5af63" :answer/type {:db/ident :answer.type/math} :answer/value "68" :db/id #edb/ref 17592186270799} :answer-field/id #uuid "1039aa1c-3943-5c35-8e39-fa6fddb16954" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274435}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f7eee920-abd1-5e92-872a-5f2d162a508d" :question/math-academy-id "q-127701" :question/problem "Calculate the minor of the entry ${p}_{32}$ in the matrix\n$P=[\\begin{aligned}8 & 8 & 4 \\\\ -5 & 4 & 6 \\\\ 10 & 3 & 0\\end{aligned}].$" :question/worked-solution "The minor of ${p}_{32}=3$ (third row, second column) is the determinant of the remaining entries when the column and row containing $3$ are removed: \n\n$$\nP=[\\begin{aligned}8 & ∗ & 4 \\\\ -5 & ∗ & 6 \\\\ ∗ & 3 & ∗\\end{aligned}]\n$$\n\nSo, the minor of ${p}_{32}=3$ is\n\n$$\n\\begin{aligned}\\text{det}[\\begin{aligned}8 & 4 \\\\ -5 & 6\\end{aligned}] & =|\\begin{aligned}8 & 4 \\\\ -5 & 6\\end{aligned}| \\\\  & =8\\cdot 6-4\\cdot (-5) \\\\  & =48+20 \\\\  & =68.\\end{aligned}\n$$"}]}
