#{[{:db/id #edb/ref 17592186059484 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "2e1b4442-eca7-5283-9d5d-5bcbd1d67975" :knowledge-point/title "Calculating a Minor in a 3x3 Matrix With Integer Entries"}] :question/id #uuid "79841c0d-e191-566b-8fe2-63828dcfc23a" :question/math-academy-id "e-4439" :question/problem "Calculate the minor of the entry $b_{21}$ in the matrix\n\n$$\n[\\begin{aligned}10 & 1 & 5 \\\\ 3 & 6 & 8 \\\\ 4 & 7 & 2\\end{aligned}]\n$$" :question/worked-solution "The minor of $b_{21} = 3$ (second row, first column) is the determinant of the remaining entries when the column and row containing $3$ are removed: \n\n$$\n[\\begin{aligned}∗ & 1 & 5 \\\\ 3 & ∗ & ∗ \\\\ ∗ & 7 & 2\\end{aligned}]\n$$\n\nSo, the minor of $b_{21}=3$ is\n\n$$\n\\begin{aligned}det[\\begin{aligned}1 & 5 \\\\ 7 & 2\\end{aligned}] & =|\\begin{aligned}1 & 5 \\\\ 7 & 2\\end{aligned}| \\\\  & =1\\cdot 2-5\\cdot 7 \\\\  & =2-35 \\\\  & =-33.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059485 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "1ff88785-9281-5431-86d8-95fd89866787" :knowledge-point/title "Calculating a Minor in a 3x3 Matrix With Variable Entries"}] :question/id #uuid "51f60726-3d12-507e-b942-5d316fc28bd0" :question/math-academy-id "e-4440" :question/problem "What is the minor of $c_{22}$ in the matrix\n\n$$\n[\\begin{aligned}7x & 0 & -3y \\\\ 1 & x+2y & 4 \\\\ -y & 0 & 5\\end{aligned}]\n$$" :question/worked-solution "First, we remove the second row and second column: \n\n$$\n[\\begin{aligned}7x & ∗ & -3y \\\\ ∗ & x+2y & ∗ \\\\ -y & ∗ & 5\\end{aligned}]\n$$\n\nNext, we calculate the determinant:\n\n$$\n\\begin{aligned}det[\\begin{aligned}7x & -3y \\\\ -y & 5\\end{aligned}] & =|\\begin{aligned}7x & -3y \\\\ -y & 5\\end{aligned}| \\\\  & =7x\\cdot 5-(-3y)\\cdot (-y) \\\\  & =35x-3{y}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059486 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "4aa65a73-e750-5052-9249-7c096297ae51" :knowledge-point/title "Solving for an Unknown Given the Value of a Minor"}] :question/id #uuid "afd06762-0a78-5559-b035-98bd05e6c084" :question/math-academy-id "e-4441" :question/problem "Given that the minor of $a_{23}$ is $5,$ find all the possible values of $k$ in the matrix\n\n$$\n[\\begin{aligned}k & 3 & -1 \\\\ -5 & 2 & 7 \\\\ -1 & 2k & -6\\end{aligned}]\n$$" :question/worked-solution "First, we remove the second row and third column:\n\n$$\n[\\begin{aligned}k & 3 & ∗ \\\\ ∗ & ∗ & 7 \\\\ -1 & 2k & ∗\\end{aligned}]\n$$\n\nThe minor of $a_{23}$ is\n\n$$\n\\begin{aligned}det[\\begin{aligned}k & 3 \\\\ -1 & 2k\\end{aligned}] & =|\\begin{aligned}k & 3 \\\\ -1 & 2k\\end{aligned}| \\\\  & =k\\cdot 2k-3\\cdot (-1) \\\\  & =2{k}^{2}+3.\\end{aligned}\n$$\n\nWe're told that the minor of $a_{23}$ is $5,$ so we must have:\n\n$$\n\\begin{aligned}2{k}^{2}+3 & =5 \\\\ 2{k}^{2} & =2 \\\\ {k}^{2} & =1 \\\\ k & =\\pm 1\\end{aligned}\n$$\n\nTherefore, the solutions are $k=-1$ and $k=1.$"}] [{:db/id #edb/ref 17592186059910 :knowledge-point/_questions [{:knowledge-point/id #uuid "1ff88785-9281-5431-86d8-95fd89866787" :knowledge-point/title "Calculating a Minor in a 3x3 Matrix With Variable Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97ba517c-b045-5288-867f-6ecbbe98efc1" :answer/type {:db/ident :answer.type/math} :answer/value "2ac - b^{2}" :db/id #edb/ref 17592186056180} {:answer/id #uuid "1000a0de-d232-5754-9483-fb2eeb5c959e" :answer/type {:db/ident :answer.type/math} :answer/value "-b^{2} - 2ac" :db/id #edb/ref 17592186056181} {:answer/id #uuid "2e8aeaba-c5b2-5ab0-8c41-d091d75fa247" :answer/type {:db/ident :answer.type/math} :answer/value "b^{2} + 2ac" :db/id #edb/ref 17592186056182} {:answer/id #uuid "46107214-20e4-522b-8a30-41030216ba4f" :answer/type {:db/ident :answer.type/math} :answer/value "-3ab" :db/id #edb/ref 17592186056183} {:answer/id #uuid "66c07939-2daf-56ab-a8d2-3cc5edbd41ae" :answer/type {:db/ident :answer.type/math} :answer/value "6ac - b^{c}2" :db/id #edb/ref 17592186056184}] :answer-field/correct {:answer/id #uuid "1000a0de-d232-5754-9483-fb2eeb5c959e" :answer/type {:db/ident :answer.type/math} :answer/value "-b^{2} - 2ac" :db/id #edb/ref 17592186056181} :answer-field/id #uuid "c8cd75da-237b-5581-bde0-cfd611d413b1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056179}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "16f02ef4-4851-5023-bd54-49a8bd7d2abc" :question/math-academy-id "q-1098" :question/problem "What is the minor of ${x}_{12}$ in the matrix\n$X=[\\begin{aligned}6a & -3a & c \\\\ -b & {b}^{2} & -2c \\\\ -a & 0 & b\\end{aligned}]?$" :question/worked-solution "First, we remove the first row and second column:\n\n$$\nX=[\\begin{aligned}∗ & -3a & ∗ \\\\ -b & ∗ & -2c \\\\ -a & ∗ & b\\end{aligned}]\n$$\n\nNext, we calculate the determinant:\n\n$$\n\\begin{aligned}det[\\begin{aligned}-b & -2c \\\\ -a & b\\end{aligned}] & =|\\begin{aligned}-b & -2c \\\\ -a & b\\end{aligned}| \\\\  & =-b\\cdot b-(-2c)\\cdot (-a) \\\\  & =-{b}^{2}-2ac\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186298263 :knowledge-point/_questions [{:knowledge-point/id #uuid "2e1b4442-eca7-5283-9d5d-5bcbd1d67975" :knowledge-point/title "Calculating a Minor in a 3x3 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c918cc98-ace1-52d2-9066-6b346444ab0a" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186298265} {:answer/id #uuid "372d7438-e6f3-5617-abdc-618e851981f0" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186298266} {:answer/id #uuid "b540fe3f-51a0-5475-9c53-5cb3f0d93706" :answer/type {:db/ident :answer.type/math} :answer/value "33" :db/id #edb/ref 17592186298267} {:answer/id #uuid "fb5f8118-57ac-5cd0-b1e3-90e225df0c5e" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186298268} {:answer/id #uuid "2213e1a4-c597-5325-8da3-8cd00b99758c" :answer/type {:db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186298269}] :answer-field/correct {:answer/id #uuid "2213e1a4-c597-5325-8da3-8cd00b99758c" :answer/type {:db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186298269} :answer-field/id #uuid "6c387737-99de-5940-94d1-0f499584da1e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186298264}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "4fdb2b2f-4f29-5f8d-80c7-aedf558eadfc" :question/math-academy-id "q-127699" :question/problem "Calculate the minor of the entry ${p}_{31}$ in the matrix\n$P=[\\begin{aligned}-11 & 7 & -9 \\\\ 2 & -2 & 9 \\\\ 8 & -5 & 72\\end{aligned}].$" :question/worked-solution "The minor of ${p}_{31}=8$ (third row, first column) is the determinant of the remaining entries when the column and row containing $8$ are removed: \n\n$$\nP=[\\begin{aligned}∗ & 7 & -9 \\\\ ∗ & -2 & 9 \\\\ 8 & ∗ & ∗\\end{aligned}]\n$$\n\nSo, the minor of ${p}_{31}=8$ is\n\n$$\n\\begin{aligned}\\text{det}[\\begin{aligned}7 & -9 \\\\ -2 & 9\\end{aligned}] & =|\\begin{aligned}7 & -9 \\\\ -2 & 9\\end{aligned}| \\\\  & =7\\cdot 9-(-9)\\cdot (-2) \\\\  & =63-18 \\\\  & =45.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257814 :knowledge-point/_questions [{:knowledge-point/id #uuid "2e1b4442-eca7-5283-9d5d-5bcbd1d67975" :knowledge-point/title "Calculating a Minor in a 3x3 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c8882cab-abb7-5103-96c1-d77fcef5dee3" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186298271} {:answer/id #uuid "0779f870-b565-5326-a6d2-ce5d3a75bee5" :answer/type {:db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186298272} {:answer/id #uuid "2f7067dc-9ee4-5c74-b8f4-7db0fcaf9202" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186298273} {:answer/id #uuid "df688c96-8db4-51c7-af51-a7d98c99c3b8" :answer/type {:db/ident :answer.type/math} :answer/value "68" :db/id #edb/ref 17592186298274} {:answer/id #uuid "77a65c47-6fc9-5233-a409-4dc413e4ecf9" :answer/type {:db/ident :answer.type/math} :answer/value "-32" :db/id #edb/ref 17592186298275}] :answer-field/correct {:answer/id #uuid "df688c96-8db4-51c7-af51-a7d98c99c3b8" :answer/type {:db/ident :answer.type/math} :answer/value "68" :db/id #edb/ref 17592186298274} :answer-field/id #uuid "f53df037-93ae-5cbf-a55f-d13f3442d144" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186298270}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f7eee920-abd1-5e92-872a-5f2d162a508d" :question/math-academy-id "q-127701" :question/problem "Calculate the minor of the entry ${p}_{32}$ in the matrix\n$P=[\\begin{aligned}8 & 8 & 4 \\\\ -5 & 4 & 6 \\\\ 10 & 3 & 0\\end{aligned}].$" :question/worked-solution "The minor of ${p}_{32}=3$ (third row, second column) is the determinant of the remaining entries when the column and row containing $3$ are removed: \n\n$$\nP=[\\begin{aligned}8 & ∗ & 4 \\\\ -5 & ∗ & 6 \\\\ ∗ & 3 & ∗\\end{aligned}]\n$$\n\nSo, the minor of ${p}_{32}=3$ is\n\n$$\n\\begin{aligned}\\text{det}[\\begin{aligned}8 & 4 \\\\ -5 & 6\\end{aligned}] & =|\\begin{aligned}8 & 4 \\\\ -5 & 6\\end{aligned}| \\\\  & =8\\cdot 6-4\\cdot (-5) \\\\  & =48+20 \\\\  & =68.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186298276 :knowledge-point/_questions [{:knowledge-point/id #uuid "1ff88785-9281-5431-86d8-95fd89866787" :knowledge-point/title "Calculating a Minor in a 3x3 Matrix With Variable Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1109c780-7ce5-5d53-bbc0-44d57dd777ca" :answer/type {:db/ident :answer.type/math} :answer/value "2{w}^{2}-4w+2" :db/id #edb/ref 17592186298278} {:answer/id #uuid "a89a05c2-2ad7-5adf-bdfc-3051e9dc9eec" :answer/type {:db/ident :answer.type/math} :answer/value "x{w}^{2}-10" :db/id #edb/ref 17592186298279} {:answer/id #uuid "2fdada4d-b49c-5845-8aa3-f64dc17b7185" :answer/type {:db/ident :answer.type/math} :answer/value "{w}^{2}-4y" :db/id #edb/ref 17592186298280} {:answer/id #uuid "163e6636-bd4c-58d7-b849-b532254525b9" :answer/type {:db/ident :answer.type/math} :answer/value "yw+2" :db/id #edb/ref 17592186298281} {:answer/id #uuid "fdca2581-f8c4-5386-abf3-b810cc6132d9" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186298282}] :answer-field/correct {:answer/id #uuid "fdca2581-f8c4-5386-abf3-b810cc6132d9" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186298282} :answer-field/id #uuid "48236aee-28c2-5b7f-828d-eb27d966b24c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186298277}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6013d5b8-a82a-5978-a154-afb8372379c0" :question/math-academy-id "q-128021" :question/problem "What is the minor of ${e}_{13}$ in the matrix\n$E=[\\begin{aligned}x & 2 & y \\\\ w-1 & 1-w & 3 \\\\ 1-w & w-1 & -10y\\end{aligned}]?$" :question/worked-solution "First, we remove the first row and the third column:\n\n$$\nE=[\\begin{aligned}∗ & ∗ & y \\\\ w-1 & 1-w & ∗ \\\\ 1-w & w-1 & ∗\\end{aligned}]\n$$\n\nNext, we calculate the determinant:\n\n$$\n\\begin{aligned}\\text{det}[\\begin{aligned}w-1 & 1-w \\\\ 1-w & w-1\\end{aligned}] & =|\\begin{aligned}w-1 & 1-w \\\\ 1-w & w-1\\end{aligned}| \\\\  & =(w-1)\\cdot (w-1)-(1-w)\\cdot (1-w) \\\\  & =(w-1)^{2}-(1-w)^{2} \\\\  & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186298283 :knowledge-point/_questions [{:knowledge-point/id #uuid "1ff88785-9281-5431-86d8-95fd89866787" :knowledge-point/title "Calculating a Minor in a 3x3 Matrix With Variable Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe51f681-4cec-5e9f-bede-fa871db0e0bf" :answer/type {:db/ident :answer.type/math} :answer/value "3pr-{r}^{2}" :db/id #edb/ref 17592186298285} {:answer/id #uuid "f3cd295b-4fed-5adc-897a-a71f06f52553" :answer/type {:db/ident :answer.type/math} :answer/value "6qr-p" :db/id #edb/ref 17592186298286} {:answer/id #uuid "b05169d7-fb45-5e04-9f2c-ead03ca17e6c" :answer/type {:db/ident :answer.type/math} :answer/value "36pq" :db/id #edb/ref 17592186298287} {:answer/id #uuid "3551efc8-ecf9-59b4-baf9-21a2202187a9" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186298288} {:answer/id #uuid "dd2cfc91-9471-5e2f-8551-8ce7e8b6d1fc" :answer/type {:db/ident :answer.type/math} :answer/value "5pq+6r" :db/id #edb/ref 17592186298289}] :answer-field/correct {:answer/id #uuid "b05169d7-fb45-5e04-9f2c-ead03ca17e6c" :answer/type {:db/ident :answer.type/math} :answer/value "36pq" :db/id #edb/ref 17592186298287} :answer-field/id #uuid "c8c45f40-f1d2-5ffe-ac46-e6a4a82771f5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186298284}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "841cf7a3-361e-5d84-b9d9-a3fbecbeaf00" :question/math-academy-id "q-128024" :question/problem "What is the minor of ${t}_{22}$ in the matrix\n$T=[\\begin{aligned}3p & r & 3p \\\\ q & r & -q \\\\ -6q & -p & 6q\\end{aligned}]?$" :question/worked-solution "First, we remove the second row and the second column:\n\n$$\nT=[\\begin{aligned}3p & ∗ & 3p \\\\ ∗ & r & ∗ \\\\ -6q & ∗ & 6q\\end{aligned}]\n$$\n\n \n\nNext, we calculate the determinant:\n\n$$\n\\begin{aligned}det[\\begin{aligned}3p & 3p \\\\ -6q & 6q\\end{aligned}] & =|\\begin{aligned}3p & 3p \\\\ -6q & 6q\\end{aligned}| \\\\  & =3p\\cdot 6q-3p\\cdot (-6q) \\\\  & =18pq+18pq \\\\  & =36pq\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186276691 :knowledge-point/_questions [{:knowledge-point/id #uuid "1ff88785-9281-5431-86d8-95fd89866787" :knowledge-point/title "Calculating a Minor in a 3x3 Matrix With Variable Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cca4795-f42d-55c8-a9c7-5384cc03c78d" :answer/type {:db/ident :answer.type/math} :answer/value "gf+5f" :db/id #edb/ref 17592186276693} {:answer/id #uuid "5fd0c10a-c26c-572b-9a05-84069587b78b" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{2}+{g}^{2}" :db/id #edb/ref 17592186276694} {:answer/id #uuid "40934120-ed89-554b-91fb-88b74a122a0b" :answer/type {:db/ident :answer.type/math} :answer/value "gf(f-g)" :db/id #edb/ref 17592186276695} {:answer/id #uuid "bb4c8859-ccc8-5842-89ec-80805b18e974" :answer/type {:db/ident :answer.type/math} :answer/value "gf(f+g)" :db/id #edb/ref 17592186276696} {:answer/id #uuid "970311e3-4e14-55b5-93f4-ec2948735196" :answer/type {:db/ident :answer.type/math} :answer/value "gf-3g" :db/id #edb/ref 17592186276697}] :answer-field/correct {:answer/id #uuid "40934120-ed89-554b-91fb-88b74a122a0b" :answer/type {:db/ident :answer.type/math} :answer/value "gf(f-g)" :db/id #edb/ref 17592186276695} :answer-field/id #uuid "37bbeca6-2643-5edd-a7b9-5e2edf1c9dc9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186276692}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "79af0c62-6c1b-55d6-8154-076e57601d0b" :question/math-academy-id "q-128030" :question/problem "What is the minor of ${m}_{31}$ in the matrix\n$M=[\\begin{aligned}-50 & g & f \\\\ f & {g}^{2} & {f}^{2} \\\\ 20g & g & -5\\end{aligned}]?$" :question/worked-solution "First, we remove the third row and first column:\n\n$$\nM=[\\begin{aligned}∗ & g & f \\\\ ∗ & {g}^{2} & {f}^{2} \\\\ 20g & ∗ & ∗\\end{aligned}]\n$$\n\nNext, we calculate the determinant:\n\n$$\n\\begin{aligned}\\text{det}[\\begin{aligned}g & f \\\\ {g}^{2} & {f}^{2}\\end{aligned}] & =|\\begin{aligned}g & f \\\\ {g}^{2} & {f}^{2}\\end{aligned}| \\\\  & =g\\cdot {f}^{2}-f\\cdot {g}^{2} \\\\  & =g{f}^{2}-f{g}^{2} \\\\  & =gf(f-g)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186298290 :knowledge-point/_questions [{:knowledge-point/id #uuid "4aa65a73-e750-5052-9249-7c096297ae51" :knowledge-point/title "Solving for an Unknown Given the Value of a Minor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa36533f-738e-53cc-8990-a2eafef3ca13" :answer/type {:db/ident :answer.type/text} :answer/value "$z=2$ only" :db/id #edb/ref 17592186298292} {:answer/id #uuid "ea589215-4c0b-5fcc-81c3-c7b1334ca8cc" :answer/type {:db/ident :answer.type/text} :answer/value "$z=-1$ only" :db/id #edb/ref 17592186298293} {:answer/id #uuid "cdfaa42d-2c4c-55de-b25f-a0fd71b6e27e" :answer/type {:db/ident :answer.type/text} :answer/value "$z=-4$ only" :db/id #edb/ref 17592186298294} {:answer/id #uuid "9bc16220-84f0-5d0e-8996-ff890ae74034" :answer/type {:db/ident :answer.type/text} :answer/value "$z=3$ and $z=6$ only" :db/id #edb/ref 17592186298295} {:answer/id #uuid "1352f0fa-e25f-52a1-9ddd-88e28ada8a2e" :answer/type {:db/ident :answer.type/text} :answer/value "$z=2$ and $z=6$ only" :db/id #edb/ref 17592186298296}] :answer-field/correct {:answer/id #uuid "1352f0fa-e25f-52a1-9ddd-88e28ada8a2e" :answer/type {:db/ident :answer.type/text} :answer/value "$z=2$ and $z=6$ only" :db/id #edb/ref 17592186298296} :answer-field/id #uuid "95421a8b-8562-5323-92fa-ae1bd6823f85" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186298291}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "9acbd8f6-ace2-5d4b-b1b4-446f57c1b3d0" :question/math-academy-id "q-128116" :question/problem "Given that the minor of ${r}_{33}$ is $3$, find all the possible values of $z$ in the matrix\n\n$$\nR=[\\begin{aligned}z & -3 & -1 \\\\ 5 & z-8 & 8 \\\\ 2 & -3 & 6z\\end{aligned}].\n$$" :question/worked-solution "First, we remove the third row and third column:\n\n$$\nR=[\\begin{aligned}z & -3 & ∗ \\\\ -5 & z-8 & ∗ \\\\ ∗ & ∗ & 6z\\end{aligned}]\n$$\n\nThe minor of ${r}_{33}$ is\n\n \n\n$$\n\\begin{aligned}\\text{det}[\\begin{aligned}z & -3 \\\\ 5 & z-8\\end{aligned}] & =|\\begin{aligned}z & -3 \\\\ 5 & z-8\\end{aligned}| \\\\  & =z\\cdot (z-8)-(-3)\\cdot 5 \\\\  & ={z}^{2}-8z+15.\\end{aligned}\n$$\n\nWe're told that the minor of ${r}_{33}$ is $3$, so we must have:\n\n$$\n\\begin{aligned}{z}^{2}-8z+15 & =3 \\\\ {z}^{2}-8z+12 & =0 \\\\ (z-2)(z-6) & =0\\end{aligned}\n$$\n\nTherefore, the solutions are $z=2$ and $z=6.$"}] [{:db/id #edb/ref 17592186298297 :knowledge-point/_questions [{:knowledge-point/id #uuid "4aa65a73-e750-5052-9249-7c096297ae51" :knowledge-point/title "Solving for an Unknown Given the Value of a Minor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b85cb246-c698-55bc-8b18-da723deb5667" :answer/type {:db/ident :answer.type/math} :answer/value "x=3" :db/id #edb/ref 17592186298299} {:answer/id #uuid "c1ee9ea8-62d8-5cad-97a9-15d187f60311" :answer/type {:db/ident :answer.type/math} :answer/value "x=-3" :db/id #edb/ref 17592186298300} {:answer/id #uuid "231855f3-d286-5df5-942c-77edc8fa47da" :answer/type {:db/ident :answer.type/math} :answer/value "x=9" :db/id #edb/ref 17592186298301} {:answer/id #uuid "63521ed3-045b-5774-b39a-ea27c3c032a0" :answer/type {:db/ident :answer.type/math} :answer/value "x=-12" :db/id #edb/ref 17592186298302} {:answer/id #uuid "8cdf44e5-a05f-5c21-b4d6-fec60261bb95" :answer/type {:db/ident :answer.type/math} :answer/value "x=-9" :db/id #edb/ref 17592186298303}] :answer-field/correct {:answer/id #uuid "b85cb246-c698-55bc-8b18-da723deb5667" :answer/type {:db/ident :answer.type/math} :answer/value "x=3" :db/id #edb/ref 17592186298299} :answer-field/id #uuid "532a60cf-79bc-5817-8c3e-f2405d2ab092" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186298298}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "8109dc07-0894-5c72-a0c1-64a6ec00257c" :question/math-academy-id "q-18239" :question/problem "Given that the minor of ${c}_{23}$ is $-86$, find all the possible values of $x$ in the matrix\n\n$$\nC=[\\begin{aligned}-3 & 7 & -1 \\\\ 4 & -4 & 5 \\\\ 11 & x & 6\\end{aligned}].\n$$" :question/worked-solution "First, we remove the second row and third column:\n\n$$\nC=[\\begin{aligned}-3 & 7 & ∗ \\\\ ∗ & ∗ & 5 \\\\ 11 & x & ∗\\end{aligned}]\n$$\n\nThe minor of ${c}_{23}$ is\n\n$$\n\\begin{aligned}\\text{det}[\\begin{aligned}-3 & 7 \\\\ 11 & x\\end{aligned}] & =|\\begin{aligned}-3 & 7 \\\\ 11 & x\\end{aligned}| \\\\  & =(-3)\\cdot x-7\\cdot 11 \\\\  & =-3x-77.\\end{aligned}\n$$\n\nWe're told that the minor of ${c}_{23}$ is $-86$, so we must have:\n\n$$\n\\begin{aligned}-3x-77 & =-86 \\\\ -3x & =-9 \\\\ x & =3\\end{aligned}\n$$\n\nTherefore, the solution is $x=3.$"}] [{:db/id #edb/ref 17592186298304 :knowledge-point/_questions [{:knowledge-point/id #uuid "4aa65a73-e750-5052-9249-7c096297ae51" :knowledge-point/title "Solving for an Unknown Given the Value of a Minor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97ffc395-0c6c-5f12-b553-45ad6dce9761" :answer/type {:db/ident :answer.type/math} :answer/value "x=20" :db/id #edb/ref 17592186298306} {:answer/id #uuid "8d553ff4-f15e-56da-9035-f594b21d0a5e" :answer/type {:db/ident :answer.type/math} :answer/value "x=-20" :db/id #edb/ref 17592186298307} {:answer/id #uuid "60f02bd9-1c37-5b23-83da-b31dbaf1ad8b" :answer/type {:db/ident :answer.type/math} :answer/value "x=2" :db/id #edb/ref 17592186298308} {:answer/id #uuid "adb22bdb-3f6b-579f-a28c-38c8fb46ce8f" :answer/type {:db/ident :answer.type/math} :answer/value "x=4" :db/id #edb/ref 17592186298309} {:answer/id #uuid "772ea363-0488-5020-8781-9c331d86b865" :answer/type {:db/ident :answer.type/math} :answer/value "x=-2" :db/id #edb/ref 17592186298310}] :answer-field/correct {:answer/id #uuid "60f02bd9-1c37-5b23-83da-b31dbaf1ad8b" :answer/type {:db/ident :answer.type/math} :answer/value "x=2" :db/id #edb/ref 17592186298308} :answer-field/id #uuid "73bd7825-55d8-5dfe-af07-5e9a8b9125d7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186298305}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "70f7cc0c-8526-5067-ba4f-898ff5e73bb9" :question/math-academy-id "q-18247" :question/problem "Given that the minor of ${a}_{32}$ is $-50$, find all the possible values of $x$ in the matrix\n\n$$\nA=[\\begin{aligned}-7 & 3 & 4 \\\\ x & 1 & 3x \\\\ -12 & -4 & 5\\end{aligned}].\n$$" :question/worked-solution "First, we remove the third row and second column:\n\n$$\nA=[\\begin{aligned}-7 & ∗ & 4 \\\\ x & ∗ & 3x \\\\ ∗ & -4 & ∗\\end{aligned}]\n$$\n\nThe minor of ${a}_{32}$ is\n\n$$\n\\begin{aligned}\\text{det}[\\begin{aligned}-7 & 4 \\\\ x & 3x\\end{aligned}] & =|\\begin{aligned}-7 & 4 \\\\ x & 3x\\end{aligned}| \\\\  & =(-7)\\cdot 3x-x\\cdot 4 \\\\  & =-21x-4x \\\\  & =-25x.\\end{aligned}\n$$\n\nWe're told that the minor of ${a}_{32}$ is $-50$, so we must have:\n\n$$\n\\begin{aligned}-25x & =-50 \\\\ x & =2\\end{aligned}\n$$\n\nTherefore, the solution is $x=2.$"}] [{:db/id #edb/ref 17592186276705 :knowledge-point/_questions [{:knowledge-point/id #uuid "1ff88785-9281-5431-86d8-95fd89866787" :knowledge-point/title "Calculating a Minor in a 3x3 Matrix With Variable Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3533297a-1039-56a0-b0cc-22dc1b6c0056" :answer/type {:db/ident :answer.type/math} :answer/value "10+z" :db/id #edb/ref 17592186276707} {:answer/id #uuid "51178909-aa0b-5954-8261-958a2c91b4a0" :answer/type {:db/ident :answer.type/math} :answer/value "10-z" :db/id #edb/ref 17592186276708}] :answer-field/correct {:answer/id #uuid "51178909-aa0b-5954-8261-958a2c91b4a0" :answer/type {:db/ident :answer.type/math} :answer/value "10-z" :db/id #edb/ref 17592186276708} :answer-field/id #uuid "bf6a41e9-50ac-558f-a56d-814d22a0cce6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186276706}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "03e055b5-d0f8-53f2-9e9e-d73f97dbbc13" :question/math-academy-id "q-275501" :question/problem "For the matrix\n$A=[\\begin{aligned}x & 3 & y \\\\ 2 & x & z \\\\ 1 & w & 5\\end{aligned}],$\nfind the minor ${M}_{12}$ of the element ${a}_{12}.$\n\n${M}_{12}=${{field-1}}" :question/worked-solution "To evaluate the minor of ${a}_{12},$ we remove the first row and second column: \n\n$$\nA=[\\begin{aligned}∗ & 3 & ∗ \\\\ 2 & ∗ & z \\\\ 1 & ∗ & 5\\end{aligned}]\n$$\n\nSo, the minor of ${a}_{12}$ is\n\n$$\n\\begin{aligned}{M}_{12} & =det[\\begin{aligned}2 & z \\\\ 1 & 5\\end{aligned}] \\\\  & =|\\begin{aligned}2 & z \\\\ 1 & 5\\end{aligned}| \\\\  & =2\\cdot 5-z\\cdot 1 \\\\  & =10-z\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186279907 :knowledge-point/_questions [{:knowledge-point/id #uuid "4aa65a73-e750-5052-9249-7c096297ae51" :knowledge-point/title "Solving for an Unknown Given the Value of a Minor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fcec5bf5-c244-5346-a821-261d6fd2baa0" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186279909} {:answer/id #uuid "9d382f75-3cf3-500a-a4bd-ca561f8516bb" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186279910}] :answer-field/correct {:answer/id #uuid "fcec5bf5-c244-5346-a821-261d6fd2baa0" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186279909} :answer-field/id #uuid "562568b5-fbbd-5a72-b8c7-51736263fa19" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186279908} {:answer-field/choices [{:answer/id #uuid "db4b9131-5fa9-552a-ba5b-692e5cfc1451" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186279912}] :answer-field/correct {:answer/id #uuid "db4b9131-5fa9-552a-ba5b-692e5cfc1451" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186279912} :answer-field/id #uuid "42c56cc1-6826-5ee1-9aee-341d32eb0613" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186279911}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "11118463-734f-544a-8796-95bbe47cd463" :question/math-academy-id "q-275530" :question/problem "Given that the minor of ${a}_{11}$ is $17$, find all the possible values of $p$ in the matrix\n\n$$\nA=[\\begin{aligned}5 & 2 & 3 \\\\ 1 & p & 4 \\\\ 6 & -2 & p\\end{aligned}].\n$$\n\nIn **ascending order**, the values of $p$ are\n\n$p=$ \n{{field-1}} $\\,$ and $\\,p=$\n{{field-2}}." :question/worked-solution "To evaluate the minor of ${a}_{11},$ we remove the first row and first column:\n\n$$\nA=[\\begin{aligned}5 & ∗ & ∗ \\\\ ∗ & p & 4 \\\\ ∗ & -2 & p\\end{aligned}]\n$$\n\nSo, the minor of ${a}_{11}$ is\n\n \n\n$$\n\\begin{aligned}\\text{det}[\\begin{aligned}p & 4 \\\\ -2 & p\\end{aligned}] & =|\\begin{aligned}p & 4 \\\\ -2 & p\\end{aligned}| \\\\  & =p\\cdot p-4\\cdot (-2) \\\\  & ={p}^{2}+8.\\end{aligned}\n$$\n\nWe're told that the minor of ${a}_{11}$ is $17$, so we get\n\n$$\n\\begin{aligned}{p}^{2}+8 & =17 \\\\ {p}^{2}-9 & =0 \\\\ (p-3)(p+3) & =0.\\end{aligned}\n$$\n\nTherefore, in ascending order, the solutions are $p=-3$ and $p=3.$"}] [{:db/id #edb/ref 17592186298311 :knowledge-point/_questions [{:knowledge-point/id #uuid "2e1b4442-eca7-5283-9d5d-5bcbd1d67975" :knowledge-point/title "Calculating a Minor in a 3x3 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71e97608-6c1c-51e2-9aed-e21f3dfde233" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186298313} {:answer/id #uuid "a20ac927-78cb-5316-8ae7-111549d4c641" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186298314}] :answer-field/correct {:answer/id #uuid "71e97608-6c1c-51e2-9aed-e21f3dfde233" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186298313} :answer-field/id #uuid "64c28f30-524c-5364-b11a-805f4dffe2c5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298312}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ffdca226-d35a-593e-8cef-091714db0ce4" :question/math-academy-id "q-319096" :question/problem "For the matrix\n$B=[\\begin{aligned}2 & 5 & -3 \\\\ 1 & -1 & 4 \\\\ 0 & 2 & 6\\end{aligned}],$\nfind the minor ${M}_{33}$ of the entry ${b}_{33}.$\n\n${M}_{33}=${{field-1}}" :question/worked-solution "The minor of ${b}_{33}=6$ (third row, third column) is the determinant of the remaining entries when the column and row containing $6$ are removed: \n\n$$\nB=[\\begin{aligned}2 & 5 & ∗ \\\\ 1 & -1 & ∗ \\\\ ∗ & ∗ & 6\\end{aligned}]\n$$\n\nSo, the minor of ${b}_{33}=6$ is\n\n$$\n\\begin{aligned}{M}_{33} & =\\text{det}[\\begin{aligned}2 & 5 \\\\ 1 & -1\\end{aligned}] \\\\  & =|\\begin{aligned}2 & 5 \\\\ 1 & -1\\end{aligned}| \\\\  & =2\\cdot (-1)-5\\cdot 1 \\\\  & =-2-5 \\\\  & =-7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186276720 :knowledge-point/_questions [{:knowledge-point/id #uuid "2e1b4442-eca7-5283-9d5d-5bcbd1d67975" :knowledge-point/title "Calculating a Minor in a 3x3 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "314415fe-7cd9-52b3-80ba-cb0a22a689ec" :answer/type {:db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186276722}] :answer-field/correct {:answer/id #uuid "314415fe-7cd9-52b3-80ba-cb0a22a689ec" :answer/type {:db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186276722} :answer-field/id #uuid "64537d78-b188-5768-9579-25652dc3ba52" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186276721}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f10c0b88-4a8e-58c9-9d15-7c8f967e4b7a" :question/math-academy-id "q-319112" :question/problem "For the matrix\n$C=[\\begin{aligned}5 & 2 & -1 \\\\ 0 & 3 & 4 \\\\ 7 & -2 & 6\\end{aligned}].$\nfind the minor ${M}_{12}$ of the entry ${c}_{12}.$\n\n${M}_{12}=${{field-1}}" :question/worked-solution "The minor of ${c}_{12}=2$ (first row, second column) is the determinant of the remaining entries when the column and row containing $2$ are removed: \n\n$$\nC=[\\begin{aligned}∗ & 2 & ∗ \\\\ 0 & ∗ & 4 \\\\ 7 & ∗ & 6\\end{aligned}]\n$$\n\nSo, the minor of ${c}_{12}=2$ is\n\n$$\n\\begin{aligned}{M}_{12} & =\\text{det}[\\begin{aligned}0 & 4 \\\\ 7 & 6\\end{aligned}] \\\\  & =|\\begin{aligned}0 & 4 \\\\ 7 & 6\\end{aligned}| \\\\  & =0\\cdot 6-4\\cdot 7 \\\\  & =0-28 \\\\  & =-28.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186298315 :knowledge-point/_questions [{:knowledge-point/id #uuid "4aa65a73-e750-5052-9249-7c096297ae51" :knowledge-point/title "Solving for an Unknown Given the Value of a Minor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81fa6546-2f41-562d-b47c-ce5cccab275a" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186298317}] :answer-field/correct {:answer/id #uuid "81fa6546-2f41-562d-b47c-ce5cccab275a" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186298317} :answer-field/id #uuid "7d32d62e-7421-5cce-9068-5855b5441b9e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298316}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a6434174-5c6c-5e73-8661-3e8b5b1e0618" :question/math-academy-id "q-319139" :question/problem "$$\nB=[\\begin{aligned}1 & r & 3 \\\\ 4 & 5 & 6 \\\\ 7 & 8 & 9\\end{aligned}].\n$$\n\nGiven that the minor of ${b}_{23}$ is $15$, find the value of $r$ in the matrix above.\n\n$r=$\n {{field-1}}" :question/worked-solution "To evaluate the minor of ${b}_{23},$ we remove the second row and third column: \n\n$$\nB=[\\begin{aligned}1 & r & ∗ \\\\ ∗ & ∗ & 6 \\\\ 7 & 8 & ∗\\end{aligned}]\n$$\n\nSo, the minor of ${b}_{23}$ is\n\n$$\n\\begin{aligned}\\text{det}[\\begin{aligned}1 & r \\\\ 7 & 8\\end{aligned}] & =1\\cdot 8-r\\cdot 7 \\\\  & =8-7r.\\end{aligned}\n$$\n\nWe're told that the minor of ${b}_{23}$ is $15$, so we get\n\n$$\n\\begin{aligned}8-7r & =15 \\\\ -7r & =7 \\\\ r & =-1.\\end{aligned}\n$$\n\nTherefore, the solution is $r=-1.$"}] [{:db/id #edb/ref 17592186298318 :knowledge-point/_questions [{:knowledge-point/id #uuid "2e1b4442-eca7-5283-9d5d-5bcbd1d67975" :knowledge-point/title "Calculating a Minor in a 3x3 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26f7bd2d-896d-5517-9f9a-68ec68afede9" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186298320} {:answer/id #uuid "3f14f5ee-cdd3-5e5d-a7f4-fb8192b090aa" :answer/type {:db/ident :answer.type/math} :answer/value "-38" :db/id #edb/ref 17592186298321} {:answer/id #uuid "e7067138-bfc1-55a4-97a7-9f782aafddb1" :answer/type {:db/ident :answer.type/math} :answer/value "-23" :db/id #edb/ref 17592186298322} {:answer/id #uuid "f1faebf2-0fd8-588d-8f08-4f56c44e013b" :answer/type {:db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186298323} {:answer/id #uuid "573cbba3-84b2-5654-95c5-0ab9376b53e9" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186298324}] :answer-field/correct {:answer/id #uuid "573cbba3-84b2-5654-95c5-0ab9376b53e9" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186298324} :answer-field/id #uuid "4659feba-87ca-59ea-a8f4-6573b0e974e9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186298319}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3935152b-b83d-5d28-b27b-0c6d5d0f30a3" :question/math-academy-id "q-69858" :question/problem "Calculate the minor of the entry ${d}_{33}$ in the matrix\n$D=[\\begin{aligned}3 & -2 & 4 \\\\ 4 & -1 & 54 \\\\ 11 & 6 & 7\\end{aligned}].$" :question/worked-solution "The minor of ${d}_{33}=7$ (third row, third column) is the determinant of the remaining entries when the column and row containing $7$ are removed: \n\n$$\nD=[\\begin{aligned}3 & -2 & ∗ \\\\ 4 & -1 & ∗ \\\\ ∗ & ∗ & 7\\end{aligned}]\n$$\n\nSo, the minor of ${d}_{33}=7$ is\n\n$$\n\\begin{aligned}\\text{det}[\\begin{aligned}3 & -2 \\\\ 4 & -1\\end{aligned}] & =|\\begin{aligned}3 & -2 \\\\ 4 & -1\\end{aligned}| \\\\  & =3\\cdot (-1)-(-2)\\cdot 4 \\\\  & =-3-(-8) \\\\  & =5.\\end{aligned}\n$$"}]}
