{i}\\end{aligned}],\\,{v}_{3}=[\\begin{aligned}1 \\\\ 0 \\\\ -2\\end{aligned}],\\,B=[\\begin{aligned}-1 & -2 & 0 \\\\ 2 & -1 & 0 \\\\ 0 & 0 & -2\\end{aligned}]\n$$\n\nThe vectors ${v}_{1}$ and ${v}_{3}$ are the eigenvectors of a matrix $A$ corresponding to the eigenvalues ${\\lambda }_{1}=-1-2\\text{i}$ and ${\\lambda }_{3}=-2,$  respectively. \nGiven that $A=PB{P}^{-1},$ which of the following could be the matrix $P?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071697/state.json" "file_sha256" "ce805066c1aa047de8640e8e15e03d4ab24fb938955a97cd746937fef1b5f487"} {"question" "q-38660" "field" nil "attribute" "question/worked-solution" "value" "Recall that if $A$ is a real $3\\times 3$ matrix that has one real eigenvalue ${\\lambda }_{3}$ with corresponding eigenvector ${v}_{3},$ and two complex eigenvalues ${\\lambda }_{1}={\\overset{―}{\\lambda }}_{2}$ with corresponding eigenvectors ${v}_{1}={\\overset{―}{v}}_{2},$ then $A=PB{P}^{-1},$ where\n\n$$\nB=[\\begin{aligned}\\text{Re}({\\lambda }_{1}) & \\text{Im}({\\lambda }_{1}) & 0 \\\\ -\\text{Im}({\\lambda }_{1}) & \\text{Re}({\\lambda }_{1}) & 0 \\\\ 0 & 0 & {\\lambda }_{3}\\end{aligned}],\\,\\,P=[\\begin{aligned}| & | & | \\\\ \\text{Re}({v}_{1}) & \\text{Im}({v}_{1}) & {v}_{3} \\\\ | & | & |\\end{aligned}].\n$$\n\nSwapping the blocks on the main diagonal of $B$ will result in switching the corresponding columns in $P.$\n\nFrom our block diagonal matrix\n\n$$\nB=[\\begin{aligned}-1 & -2 & 0 \\\\ 2 & -1 & 0 \\\\ 0 & 0 & -2\\end{aligned}],\n$$\n\nwe deduce that the first and second columns of $P$ will correspond to the complex eigenvector ${v}_{1},$ and the third column of $P$ will correspond to the real eigenvector ${v}_{3}:$\n\n$$\nP=[\\begin{aligned}5 & 7 & 1 \\\\ 1 & 1 & 0 \\\\ 0 & 1 & -2\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071697/state.json" "file_sha256" "ce805066c1aa047de8640e8e15e03d4ab24fb938955a97cd746937fef1b5f487"} {"question" "q-38660" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071697/activity-metadata.json" "file_sha256" "2fc383c6c9a7184f366816aa22799e9ae44a9bbcadd70d0919144630611ce4d9"} {"question" "q-38660" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071697/state.json" "file_sha256" "ce805066c1aa047de8640e8e15e03d4ab24fb938955a97cd746937fef1b5f487"} {"question" "q-38660" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}1 & 5 & 7 \\\\ 0 & 1 & 1 \\\\ -2 & 0 & 1\\end{aligned}]"] ["math" "[\\begin{aligned}1 & 7 & 5 \\\\ 0 & 1 & 1 \\\\ -2 & 1 & 1\\end{aligned}]"] ["math" "[\\begin{aligned}5 & 1 & 7 \\\\ 1 & 0 & 1 \\\\ 0 & -2 & 1\\end{aligned}]"] ["math" "[\\begin{aligned}5 & 7 & 1 \\\\ 1 & 1 & 0 \\\\ 0 & 1 & -2\\end{aligned}]"] ["math" "[\\begin{aligned}7 & 5 & 1 \\\\ 1 & 1 & 0 \\\\ 1 & 0 & -2\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071697/state.json" "file_sha256" "ce805066c1aa047de8640e8e15e03d4ab24fb938955a97cd746937fef1b5f487"} {"question" "q-38660" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}5 & 7 & 1 \\\\ 1 & 1 & 0 \\\\ 0 & 1 & -2\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071697/state.json" "file_sha256" "ce805066c1aa047de8640e8e15e03d4ab24fb938955a97cd746937fef1b5f487"} {"question" "q-135660" "field" nil "attribute" "question/problem" "value" "Consider the vectors ${v}_{1}$ and ${v}_{3}$ and the block diagonal matrix $B$ shown below, where the $2\\times 2$ block of $B$ represents a rotation-scaling matrix:\n\n$$\n{v}_{1}=[\\begin{aligned}4-\\text{i} \\\\ -5\\text{i} \\\\ 3-2\\text{i}\\end{aligned}],\\,{v}_{3}=[\\begin{aligned}1 \\\\ -3 \\\\ 4\\end{aligned}],\\,B=[\\begin{aligned}4 & 6 & 0 \\\\ -6 & 4 & 0 \\\\ 0 & 0 & -1\\end{aligned}]\n$$\n\nThe vectors ${v}_{1}$ and ${v}_{3}$ are the eigenvectors of a matrix $A$ corresponding to the eigenvalues ${\\lambda }_{1}=4+6\\text{i}$ and ${\\lambda }_{3}=-1,$  respectively. \nGiven that $A=PB{P}^{-1},$ which of the following could be the matrix $P?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071697/state.json" "file_sha256" "ce805066c1aa047de8640e8e15e03d4ab24fb938955a97cd746937fef1b5f487"} {"question" "q-135660" "field" nil "attribute" "question/worked-solution" "value" "Recall that if $A$ is a real $3\\times 3$ matrix that has one real eigenvalue ${\\lambda }_{3}$ with corresponding eigenvector ${v}_{3},$ and two complex eigenvalues ${\\lambda }_{1}={\\overset{―}{\\lambda }}_{2}$ with corresponding eigenvectors ${v}_{1}={\\overset{―}{v}}_{2},$ then $A=PB{P}^{-1},$ where\n\n$$\nB=[\\begin{aligned}\\text{Re}({\\lambda }_{1}) & \\text{Im}({\\lambda }_{1}) & 0 \\\\ -\\text{Im}({\\lambda }_{1}) & \\text{Re}({\\lambda }_{1}) & 0 \\\\ 0 & 0 & {\\lambda }_{3}\\end{aligned}],\\,\\,P=[\\begin{aligned}| & | & | \\\\ \\text{Re}({v}_{1}) & \\text{Im}({v}_{1}) & {v}_{3} \\\\ | & | & |\\end{aligned}].\n$$\n\nSwapping the blocks on the main diagonal of $B$ will result in switching the corresponding columns in $P.$\n\nFrom our block diagonal matrix\n\n$$\nB=[\\begin{aligned}4 & 6 & 0 \\\\ -6 & 4 & 0 \\\\ 0 & 0 & -1\\end{aligned}],\n$$\n\nwe deduce that the first and second columns of $P$ will correspond to the complex eigenvector ${v}_{1},$ and the third column of $P$ will correspond to the real eigenvector ${v}_{3}:$\n\n$$\nP=[\\begin{aligned}4 & -1 & 1 \\\\ 0 & -5 & -3 \\\\ 3 & -2 & 4\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071697/state.json" "file_sha256" "ce805066c1aa047de8640e8e15e03d4ab24fb938955a97cd746937fef1b5f487"} {"question" "q-135660" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071697/activity-metadata.json" "file_sha256" "2fc383c6c9a7184f366816aa22799e9ae44a9bbcadd70d0919144630611ce4d9"} {"question" "q-135660" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071697/state.json" "file_sha256" "ce805066c1aa047de8640e8e15e03d4ab24fb938955a97cd746937fef1b5f487"} {"question" "q-135660" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}4 & -1 & 0 \\\\ 0 & -2 & -3 \\\\ 3 & 5 & 0\\end{aligned}]"] ["math" "[\\begin{aligned}4 & -1 & 1 \\\\ 0 & -5 & -3 \\\\ 3 & -2 & 4\\end{aligned}]"] ["math" "[\\begin{aligned}4 & -1 & 1 \\\\ 0 & -5 & 4 \\\\ -2 & -2 & 0\\end{aligned}]"] ["math" "[\\begin{aligned}4 & -1 & 1 \\\\ 3 & -5 & -3 \\\\ 3 & 0 & 1\\end{aligned}]"] ["math" "[\\begin{aligned}5 & -1 & 1 \\\\ -2 & -5 & -3 \\\\ 1 & -2 & 0\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071697/state.json" "file_sha256" "ce805066c1aa047de8640e8e15e03d4ab24fb938955a97cd746937fef1b5f487"} {"question" "q-135660" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}4 & -1 & 1 \\\\ 0 & -5 & -3 \\\\ 3 & -2 & 4\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071697/state.json" "file_sha256" "ce805066c1aa047de8640e8e15e03d4ab24fb938955a97cd746937fef1b5f487"} {"question" "q-135537" "field" nil "attribute" "question/problem" "value" "Consider the vectors ${v}_{1}$ and ${v}_{3}$ and the block diagonal matrix $B$ shown below, where both $2\\times 2$ blocks of $B$ represent rotation-scaling matrices:\n\n$$\n{v}_{1}=[\\begin{aligned}-3+\\text{i} \\\\ 5-2\\text{i} \\\\ 2+4\\text{i} \\\\ 3-4\\text{i}\\end{aligned}],\\,{v}_{3}=[\\begin{aligned}2 \\\\ 4-7\\text{i} \\\\ 1-2\\text{i} \\\\ 3+\\text{i}\\end{aligned}],\\,B=[\\begin{aligned}-5 & 1 & 0 & 0 \\\\ -1 & -5 & 0 & 0 \\\\ 0 & 0 & 0 & -3 \\\\ 0 & 0 & 3 & 0\\end{aligned}]\n$$\n\nThe vectors ${v}_{1}$ and ${v}_{3}$ are the eigenvectors of a matrix $A$ corresponding to the eigenvalues ${\\lambda }_{1}=-5+\\text{i}$ and ${\\lambda }_{3}=-3\\text{i},$ respectively. \nGiven that $A=PB{P}^{-1},$ which of the following could be the matrix $P?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071697/state.json" "file_sha256" "ce805066c1aa047de8640e8e15e03d4ab24fb938955a97cd746937fef1b5f487"} {"question" "q-135537" "field" nil "attribute" "question/worked-solution" "value" "Recall that if $A$ is a $4\\times 4$ real matrix that has complex eigenvalues \n\n$\\,$ ${\\lambda }_{1}={\\overset{―}{\\lambda }}_{2}\\,$ and $\\,{\\lambda }_{3}={\\overset{―}{\\lambda }}_{4}$ \n\nwith corresponding eigenvectors \n\n$\\,$ ${v}_{1}={\\overset{―}{v}}_{2}\\,$ and $\\,{v}_{3}={\\overset{―}{v}}_{4},$ \n\nthen $A=PB{P}^{-1},$ where\n\n$$\nB=[\\begin{aligned}\\text{Re}({\\lambda }_{1}) & \\text{Im}({\\lambda }_{1}) & 0 & 0 \\\\ -\\text{Im}({\\lambda }_{1}) & \\text{Re}({\\lambda }_{1}) & 0 & 0 \\\\ 0 & 0 & \\text{Re}({\\lambda }_{3}) & \\text{Im}({\\lambda }_{3}) \\\\ 0 & 0 & -\\text{Im}({\\lambda }_{3}) & \\text{Re}({\\lambda }_{3})\\end{aligned}]\n$$\n\nand\n\n$$\nP=[\\begin{aligned}| & | & | & | \\\\ \\text{Re}({v}_{1}) & \\text{Im}({v}_{1}) & \\text{Re}({v}_{3}) & \\text{Im}({v}_{3}) \\\\ | & | & | & |\\end{aligned}].\n$$\n\nSwapping the blocks on the main diagonal of $B$ will result in switching the corresponding columns in $P.$\n\nFrom our block diagonal matrix\n\n$$\nB=[\\begin{aligned}-5 & 1 & 0 & 0 \\\\ -1 & -5 & 0 & 0 \\\\ 0 & 0 & 0 & -3 \\\\ 0 & 0 & 3 & 0\\end{aligned}],\n$$\n\nwe deduce that the first and second columns of $P$ correspond to the complex eigenvector ${v}_{1},$ and the third and forth columns of $P$ correspond to the complex eigenvector ${v}_{3}.$ Therefore,\n\n$$\nP=[\\begin{aligned}-3 & 1 & 2 & 0 \\\\ 5 & -2 & 4 & -7 \\\\ 2 & 4 & 1 & -2 \\\\ 3 & -4 & 3 & 1\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071697/state.json" "file_sha256" "ce805066c1aa047de8640e8e15e03d4ab24fb938955a97cd746937fef1b5f487"} {"question" "q-135537" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071697/activity-metadata.json" "file_sha256" "2fc383c6c9a7184f366816aa22799e9ae44a9bbcadd70d0919144630611ce4d9"} {"question" "q-135537" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14071697/state.json" "file_sha256" "ce805066c1aa047de8640e8e15e03d4ab24fb938955a97cd746937fef1b5f487"} {"question" "q-135537" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-3 & 1 & 2 & 0 \\\\ 3 & -4 & 3 & 1 \\\\ 2 & 4 & 1 & -2 \\\\ 5 & -2 & 4 & -7\\end{aligned}]"] ["math" "[\\begin{aligned}-3 & 1 & 2 & 0 \\\\ 5 & -2 & 4 & -7 \\\\ 2 & 4 & 1 & -2 \\\\ 3 & -4 & 3 & 1\\end{aligned}]"] ["math