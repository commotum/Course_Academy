e}({\\lambda }_{3}) & \\text{Im}({\\lambda }_{3}) \\\\ 0 & 0 & -\\text{Im}({\\lambda }_{3}) & \\text{Re}({\\lambda }_{3})\\end{aligned}]\n$$\n\nand\n\n$$\nP=[\\begin{aligned}| & | & | & | \\\\ \\text{Re}({v}_{1}) & \\text{Im}({v}_{1}) & \\text{Re}({v}_{3}) & \\text{Im}({v}_{3}) \\\\ | & | & | & |\\end{aligned}].\n$$\n\nSwapping the blocks on the main diagonal of $B$ will result in switching the corresponding columns in $P.$\n\nFrom our block diagonal matrix\n\n$$\nB=[\\begin{aligned}0 & 4 & 0 & 0 \\\\ -4 & 0 & 0 & 0 \\\\ 0 & 0 & 2 & 1 \\\\ 0 & 0 & -1 & 2\\end{aligned}],\n$$\n\nwe deduce that the first and second columns of $P$ correspond to the complex eigenvector ${v}_{1},$ and the third and forth columns of $P$ correspond to the complex eigenvector ${v}_{3}.$ Therefore,\n\n$$\nP=[\\begin{aligned}-7 & 2 & 5 & -5 \\\\ -2 & -7 & -7 & 0 \\\\ -2 & -2 & -2 & 3 \\\\ -3 & -2 & -5 & -5\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186372945 :knowledge-point/_questions [{:knowledge-point/id #uuid "e5ccd12c-a814-5ebb-985c-eef8707001f0" :knowledge-point/title "Calculating the Invertible Matrix in Block Diagonal Form of an NxN Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42994a56-000a-59a3-b46a-c79b34c1b9e9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & 4 & -2 & -1 \\\\ -7 & -6 & -2 & 5 \\\\ -1 & -2 & -1 & -7 \\\\ -2 & 5 & -3 & 0\\end{aligned}]" :db/id #edb/ref 17592186372947} {:answer/id #uuid "83edda4c-0647-57e6-9880-a261b58c739c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & 4 & -1 & -2 \\\\ -2 & 5 & 0 & -3 \\\\ -7 & -6 & 5 & -2 \\\\ -1 & -2 & -7 & -1\\end{aligned}]" :db/id #edb/ref 17592186372948} {:answer/id #uuid "91bbefe5-b6e3-575f-bdc1-4afb081c5394" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & 4 & -2 & -1 \\\\ -2 & 5 & -3 & 0 \\\\ -7 & -6 & -2 & 5 \\\\ -1 & -2 & -1 & -7\\end{aligned}]" :db/id #edb/ref 17592186372949} {:answer/id #uuid "06