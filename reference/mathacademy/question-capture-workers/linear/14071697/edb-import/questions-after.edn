 & 0 \\\\ -1 & -5 & 0 & 0 \\\\ 0 & 0 & 0 & -3 \\\\ 0 & 0 & 3 & 0\\end{aligned}],\n$$\n\nwe deduce that the first and second columns of $P$ correspond to the complex eigenvector ${v}_{1},$ and the third and forth columns of $P$ correspond to the complex eigenvector ${v}_{3}.$ Therefore,\n\n$$\nP=[\\begin{aligned}-3 & 1 & 2 & 0 \\\\ 5 & -2 & 4 & -7 \\\\ 2 & 4 & 1 & -2 \\\\ 3 & -4 & 3 & 1\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186372938 :knowledge-point/_questions [{:knowledge-point/id #uuid "e5ccd12c-a814-5ebb-985c-eef8707001f0" :knowledge-point/title "Calculating the Invertible Matrix in Block Diagonal Form of an NxN Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25fea1ff-ee71-5688-a5f3-91ca54da1f40" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & -7 & -7 & 0 \\\\ -7 & 2 & 5 & -5 \\\\ -3 & -2 & -5 & -5 \\\\ -2 & -2 & -2 & 3\\end{aligned}]" :db/id #edb/ref 17592186372940} {:answer/id #uuid "44904daa-f28e-5cd1-b5a0-bb79c773dcd0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & -7 & 0 & -7 \\\\ -2 & -2 & 3 & -2 \\\\ -7 & 2 & -5 & 5 \\\\ -3 & -2 & -5 & -5\\end{aligned}]" :db/id #edb/ref 17592186372941} {:answer/id #uuid "6d20b522-2ec4-561b-8766-9e0d2f6df43d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-7 & 2 & 5 & -5 \\\\ -3 & -2 & -5 & -5 \\\\ -2 & -2 & -2 & 3 \\\\ -2 & -7 & -7 & 0\\end{aligned}]" :db/id #edb/ref 17592186372942} {:answer/id #uuid "91581eb7-09e1-5061-8cb2-c8b3a426e462" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-7 & 2 & 5 & -5 \\\\ -2 & -7 & -7 & 0 \\\\ -2 & -2 & -2 & 3 \\\\ -3 & -2 & -5 & -5\\end{aligned}]" :db/id #edb/ref 17592186372943} {:answer/id #uuid "182e476a-4986-535d-ab6b-52cb124ec6dd" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & -7 & -7 & 0 \\\\ -2 & -2 & -2 & 3 \\\\ -7 & 2 & 5 & -5 \\\\ -3 & -2 & -5 & -5\\end{aligned}]" :db/id #edb/ref 17592186372