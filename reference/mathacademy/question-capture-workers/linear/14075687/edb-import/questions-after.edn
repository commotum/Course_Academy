#{[{:db/id #edb/ref 17592186382565 :knowledge-point/_questions [{:knowledge-point/id #uuid "76a7314b-4ebf-52eb-b464-97865ea9a81e" :knowledge-point/title "Dividing a Quartic Polynomial by a Quadratic or Cubic Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7204cb3f-b7b0-50b0-8857-28a40a5aab23" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}-x+3" :db/id #edb/ref 17592186382567} {:answer/id #uuid "51b76bcd-40f5-5e10-bfc6-2e102ae8014c" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+x+4" :db/id #edb/ref 17592186382568} {:answer/id #uuid "f9491f66-194e-5c24-835f-3d62defc3054" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}-x+4" :db/id #edb/ref 17592186382569} {:answer/id #uuid "050e1371-8872-5c8e-948d-2c1fa549cea7" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{2}-x-3" :db/id #edb/ref 17592186382570} {:answer/id #uuid "672f2511-759c-5d22-956e-4fc62be0a522" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{2}+x+3" :db/id #edb/ref 17592186382571}] :answer-field/correct {:answer/id #uuid "7204cb3f-b7b0-50b0-8857-28a40a5aab23" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}-x+3" :db/id #edb/ref 17592186382567} :answer-field/id #uuid "7dcb356f-da3f-5180-a959-8b3e7afd5d15" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382566}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "66fd2043-7400-507b-bfb6-3768a91a3dae" :question/math-academy-id "q-105618" :question/problem "What is the quotient of $2{x}^{4}+{x}^{3}-{x}^{2}+13x-7$ divided by $2{x}^{2}+3x-4?$" :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,{x}^{2}-x+3 \\\\  & 2{x}^{2}+3x-4\\,\\enclose{longdiv}{\\,\\,2{x}^{4}+{x}^{3}-{x}^{2}+13x-7\\,\\,} \\\\  & \\,\\,\\,\\,\\,{2{x}^{4}+3{x}^{3}-4{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,-2{x}^{3}+3{x}^{2}+13x-7 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,2{x}^{3}-3{x}^{2}+4x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,6{x}^{2}+9x-7 \\\\  & \\,\\,\\,\\,\\,\\,\\,{6{x}^{2}+9x-12}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,5\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is ${x}^{2}-x+3,$ and\n\n- the remainder is $5.$"}] [{:db/id #edb/ref 17592186382572 :knowledge-point/_questions [{:knowledge-point/id #uuid "525be9c7-af11-506b-be69-444dfc640add" :knowledge-point/title "Dividing Polynomials When the Dividend Contains Zero Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c9525d9-2140-53d7-90a8-d77ea75019d5" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+4x-1" :db/id #edb/ref 17592186382574} {:answer/id #uuid "8ce82f94-5e04-5046-9807-b07adf80e759" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+4" :db/id #edb/ref 17592186382575} {:answer/id #uuid "28875687-fbb8-5cc8-be28-4a986bd09e5a" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}-x-4" :db/id #edb/ref 17592186382576} {:answer/id #uuid "e9c9bb4d-c54c-521f-986b-1dcdf890b60f" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}-4" :db/id #edb/ref 17592186382577} {:answer/id #uuid "ea08d729-ddad-5ab0-963b-674e3d2a59bc" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}-4x+1" :db/id #edb/ref 17592186382578}] :answer-field/correct {:answer/id #uuid "e9c9bb4d-c54c-521f-986b-1dcdf890b60f" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}-4" :db/id #edb/ref 17592186382577} :answer-field/id #uuid "200a22c6-ce4d-5cf0-a5df-fb437345b4aa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382573}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "3f96d1b0-9727-58d0-92e3-ce42479a406a" :question/math-academy-id "q-114515" :question/problem "What is the quotient of ${x}^{4}-3{x}^{2}-4$ divided by ${x}^{2}+1?$" :question/worked-solution "Notice that the dividend is missing the ${x}^{3}$ and $x$ terms. So, we first rewrite it by including the missing terms with zero coefficients, as follows:\n\n$$\n{x}^{4}-3{x}^{2}-4={x}^{4}+0{x}^{3}-3{x}^{2}+0x-4\n$$\n\nNow, using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,{x}^{2}-4 \\\\  & {x}^{2}+1\\,\\enclose{longdiv}{\\,\\,{x}^{4}+0{x}^{3}-3{x}^{2}+0x-4\\,\\,\\,} \\\\  & \\,\\,\\,\\,\\,{{x}^{4}+0{x}^{3}+{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,-4{x}^{2}+0x-4 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,4{x}^{2}+0x-4}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,0\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is ${x}^{2}-4,$ and\n\n- the remainder is $0.$"}] [{:db/id #edb/ref 17592186382579 :knowledge-point/_questions [{:knowledge-point/id #uuid "76a7314b-4ebf-52eb-b464-97865ea9a81e" :knowledge-point/title "Dividing a Quartic Polynomial by a Quadratic or Cubic Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "824e1247-d155-5894-ba5d-c8a68a06765e" :answer/type {:db/ident :answer.type/math} :answer/value "-2x+5" :db/id #edb/ref 17592186382581}] :answer-field/correct {:answer/id #uuid "824e1247-d155-5894-ba5d-c8a68a06765e" :answer/type {:db/ident :answer.type/math} :answer/value "-2x+5" :db/id #edb/ref 17592186382581} :answer-field/id #uuid "728069d7-d1d7-52f6-9d9d-fb007f8a2dc9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186382580} {:answer-field/choices [{:answer/id #uuid "19797490-b808-5970-b235-e4ce63397729" :answer/type {:db/ident :answer.type/math} :answer/value "-x^2+4x-7" :db/id #edb/ref 17592186382583}] :answer-field/correct {:answer/id #uuid "19797490-b808-5970-b235-e4ce63397729" :answer/type {:db/ident :answer.type/math} :answer/value "-x^2+4x-7" :db/id #edb/ref 17592186382583} :answer-field/id #uuid "677694ea-a97d-5b32-9091-249a0c0de726" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186382582}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "0743b4b9-f377-5889-a7c9-656b1539fae1" :question/math-academy-id "q-325111" :question/problem "Express $\\frac{-6{x}^{4}+25{x}^{3}-28{x}^{2}+x+13}{3{x}^{3}-5{x}^{2}+x+4}$ in the form $q(x)+\\frac{r(x)}{3{x}^{3}-5{x}^{2}+x+4},$ where $q(x)$ is the quotient and $r(x)$ is the remainder of the division.$$\n\n| $-6{x}^{4}+25{x}^{3}-28{x}^{2}+x+13$ | __ | {{field-1}} | $+$ | {{field-2}} |\n| --- | --- | --- | --- | --- |\n| $3{x}^{3}-5{x}^{2}+x+4$ | __ |  |  | $3{x}^{3}-5{x}^{2}+x+4$ |" :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,-2x+5 \\\\  & 3{x}^{3}-5{x}^{2}+x+4\\,\\enclose{longdiv}{\\,\\,-6{x}^{4}+25{x}^{3}-28{x}^{2}+x+13\\,\\,} \\\\  & \\,\\,\\,\\,\\,{\\,-\\,6{x}^{4}+10{x}^{3}-2{x}^{2}-8x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,15{x}^{3}-26{x}^{2}+9x+13 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,{15{x}^{3}-25{x}^{2}+5x+20}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,-{x}^{2}+4x-7\\end{aligned}\n$$\n\nAs a result, \n\n- the quotient is $-2x+5,$ and\n\n- the remainder is $-{x}^{2}+4x-7.$\n\nTherefore,\n\n$$\n\\frac{-6{x}^{4}+25{x}^{3}-28{x}^{2}+x+13}{3{x}^{3}-5{x}^{2}+x+4}=-2x+5\\,+\\,\\frac{(-{x}^{2}+4x-7)}{3{x}^{3}-5{x}^{2}+x+4}.\n$$"}] [{:db/id #edb/ref 17592186382584 :knowledge-point/_questions [{:knowledge-point/id #uuid "525be9c7-af11-506b-be69-444dfc640add" :knowledge-point/title "Dividing Polynomials When the Dividend Contains Zero Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d941a1af-d5c9-51b5-a7a2-c3dc595810d3" :answer/type {:db/ident :answer.type/math} :answer/value "2x-1" :db/id #edb/ref 17592186382586} {:answer/id #uuid "30e105ec-fbe2-5831-965d-5469a2550dc8" :answer/type {:db/ident :answer.type/math} :answer/value "2x+1" :db/id #edb/ref 17592186382587}] :answer-field/correct {:answer/id #uuid "30e105ec-fbe2-5831-965d-5469a2550dc8" :answer/type {:db/ident :answer.type/math} :answer/value "2x+1" :db/id #edb/ref 17592186382587} :answer-field/id #uuid "627bdb85-3e2f-5691-8725-82985cfbabf5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186382585} {:answer-field/choices [{:answer/id #uuid "6fba225c-a5a7-5fd9-b01c-3697a9894a62" :answer/type {:db/ident :answer.type/math} :answer/value "3x^2+7x+5" :db/id #edb/ref 17592186382589}] :answer-field/correct {:answer/id #uuid "6fba225c-a5a7-5fd9-b01c-3697a9894a62" :answer/type {:db/ident :answer.type/math} :answer/value "3x^2+7x+5" :db/id #edb/ref 17592186382589} :answer-field/id #uuid "418fdad4-ad1a-5256-98e1-5532ebb66b81" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186382588}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "f2706f58-1f14-5bc3-b52d-584c0d4b829e" :question/math-academy-id "q-325150" :question/problem "Express $\\frac{2{x}^{4}-3{x}^{3}+3{x}^{2}+1}{\\,{x}^{3}-2{x}^{2}+x-4\\,}$ in the form $q(x)+\\frac{r(x)}{\\,{x}^{3}-2{x}^{2}+x-4\\,},$ where $q(x)$ is the quotient and $r(x)$ is the reminder of the division.$$\n\n| $2{x}^{4}-3{x}^{3}+3{x}^{2}+1$ | __ | {{field-1}} | $+$ | {{field-2}} |\n| --- | --- | --- | --- | --- |\n| ${x}^{3}-2{x}^{2}+x-4$ | __ |  |  | ${x}^{3}-2{x}^{2}+x-4$ |" :question/worked-solution "Notice that the dividend is missing the $x$ term. So, we first rewrite it by including the missing term with a zero coefficient, as follows:\n\n$$\n2{x}^{4}-3{x}^{3}+3{x}^{2}+1\\,=\\,2{x}^{4}-3{x}^{3}+3{x}^{2}+0x+1\n$$\n\nNow, using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,2x+1 \\\\  & {x}^{3}-2{x}^{2}+x-4\\,\\enclose{longdiv}{\\,\\,2{x}^{4}-3{x}^{3}+3{x}^{2}+0x+1\\,\\,} \\\\  & \\,\\,\\,\\,\\,{2{x}^{4}-4{x}^{3}+2{x}^{2}-8x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,{x}^{3}+{x}^{2}+8x+1 \\\\  & \\,\\,\\,\\,\\,\\,\\,{{x}^{3}-2{x}^{2}+x-4}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,3{x}^{2}+7x+5\\end{aligned}\n$$\n\nAs a result, \n\n- the quotient is $2x+1,$ and\n\n- the remainder is $3{x}^{2}+7x+5.$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{2{x}^{4}-3{x}^{3}+3{x}^{2}+1}{\\,{x}^{3}-2{x}^{2}+x-4\\,} & =2x+1+\\frac{3{x}^{2}+7x+5}{{x}^{3}-2{x}^{2}+x-4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186382590 :knowledge-point/_questions [{:knowledge-point/id #uuid "525be9c7-af11-506b-be69-444dfc640add" :knowledge-point/title "Dividing Polynomials When the Dividend Contains Zero Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "db3d6bc5-fa0f-564a-9e32-4e77314c6c70" :answer/type {:db/ident :answer.type/math} :answer/value "3x^2+4x-2" :db/id #edb/ref 17592186382592}] :answer-field/correct {:answer/id #uuid "db3d6bc5-fa0f-564a-9e32-4e77314c6c70" :answer/type {:db/ident :answer.type/math} :answer/value "3x^2+4x-2" :db/id #edb/ref 17592186382592} :answer-field/id #uuid "40f94c77-273f-5a73-93ba-a3932799c178" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186382591} {:answer-field/choices [{:answer/id #uuid "ce6664f3-bc4d-5f27-8e27-048a34d81318" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186382594}] :answer-field/correct {:answer/id #uuid "ce6664f3-bc4d-5f27-8e27-048a34d81318" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186382594} :answer-field/id #uuid "2d088b6f-af9e-58fb-859c-7434af360d36" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186382593}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "f11bd3cf-0b1a-5fb5-ae05-b3e880b91e82" :question/math-academy-id "q-325151" :question/problem "Express $\\frac{-9{x}^{3}+22x}{\\,-3x+4\\,}$ in the form $q(x)+\\frac{r(x)}{\\,-3x+4\\,},$ where $q(x)$ is the quotient and $r(x)$ is the reminder of the division.$$\n\n| $-9{x}^{3}+22x$ | __ | {{field-1}} | $+$ | {{field-2}} |\n| --- | --- | --- | --- | --- |\n| $-3x+4$ | __ |  |  | $-3x+4$ |" :question/worked-solution "Notice that the dividend is missing the ${x}^{2}$ term and the constant term. So, we first rewrite it by including the missing terms with zero coefficients, as follows:\n\n$$\n-9{x}^{3}+22x\\,=\\,-9{x}^{3}+0{x}^{2}+22x+0\n$$\n\nNow, using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,3{x}^{2}+4x-2 \\\\  & -3x+4\\,\\enclose{longdiv}{\\,-9{x}^{3}+0{x}^{2}+22x+0\\,\\,} \\\\  & \\,\\,\\,\\,\\,{-9{x}^{3}+12{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,-12{x}^{2}+22x+0 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,12{x}^{2}+16x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,6x+0 \\\\  & \\,\\,\\,\\,\\,\\,\\,{\\,6x-8}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,8\\end{aligned}\n$$\n\nAs a result, \n\n- the quotient is $3{x}^{2}+4x-2,$ and\n\n- the remainder is $8.$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{-9{x}^{3}+22x}{\\,-3x+4\\,} & =3{x}^{2}+4x-2+\\frac{8}{-3x+4}.\\end{aligned}\n$$"}]}
