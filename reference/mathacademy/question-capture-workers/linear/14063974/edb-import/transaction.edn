812c1f0e4f8492cea8cdbe84a64b1a34c0a1428d9af84487931d2f53"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-8858"] :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n\\begin{aligned}{\\begin{aligned}2x+y=0 \\\\ 3x-6y=2.\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "This system can be written as\n\n$$\n[\\begin{aligned}2 & 1 \\\\ 3 & -6\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}0 \\\\ 2\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}2 & 1 \\\\ 3 & -6\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{2\\cdot (-6)-1\\cdot 3}[\\begin{aligned}-6 & -1 \\\\ -3 & 2\\end{aligned}] \\\\  & =-\\frac{1}{15}[\\begin{aligned}-6 & -1 \\\\ -3 & 2\\end{aligned}].\\end{aligned}\n$$\n\nWe can now find the solution to this system as\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{15}[\\begin{aligned}-6 & -1 \\\\ -3 & 2\\end{aligned}][\\begin{aligned}0 \\\\ 2\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-8858/selection/ma-v1/11ef3bc47aa56d975a2d746d923add17a9920377602fed04115da7f4f5b28151"] :db/ensure [:question/validate]} {:db/id "q-32141/selection/f64e54b3f082aae6e6a4c8fd18c713b56c19c1001f9219f412f9324426dff1ec" :answer/id #uuid "4540b966-2966-5174-b7ea-f1a753ca4f6e" :answer/type :answer.type/math :answer/value "x=\\frac{1}{21}[\\begin{aligned}1 & 2 \\\\ -8 & 5\\end{aligned}][\\begin{aligned}7 \\\\ 7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-32141/selection/029260ef5c2bd1c457620470fd864156a1a4309b40bed651b4b77bf34764a641" :answer/id #uuid "5c010b75-821c-58b3-afc9-00c0bf092020" :answer/type :answer.type/math :answer/value "x=\\frac{1}{21}[\\begin{aligned}1 & -2 \\\\ 8 & 5\\end{aligned}][\\begin{aligned}7 \\\\ 7\\end{aligned}]" :db/ensure [:answer/validate]} {: