ned}][\\begin{aligned}0 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-8857/selection/ma-v1/7849d7da391ab5127f2109a14518aabb1bc9714806055e372ea692077111762c" :answer-field/id #uuid "2aacc902-1c76-5d63-80c2-7563a9d8956a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-8857/selection/ma-v1/7849d7da391ab5127f2109a14518aabb1bc9714806055e372ea692077111762c/588f4de989261ffd7d5f4af30db07ba5eb7cd5e9c5b5a4f364a0d2be35fbcc83" :answer-field/choices ["q-8857/selection/ma-v1/7849d7da391ab5127f2109a14518aabb1bc9714806055e372ea692077111762c/25f699aab5ca769635b0d98c831444e40728a94782dcc6885677a216c32972ac" "q-8857/selection/ma-v1/7849d7da391ab5127f2109a14518aabb1bc9714806055e372ea692077111762c/fd645a74ce2b3c0ec287a60f74642015488ab11dee140bb718775c73ce6fd8ac" "q-8857/selection/ma-v1/7849d7da391ab5127f2109a14518aabb1bc9714806055e372ea692077111762c/742680e951f7b93b2fdd45c7d6e7c28b9abb263035d0c0c2092bccaae174c97f" "q-8857/selection/ma-v1/7849d7da391ab5127f2109a14518aabb1bc9714806055e372ea692077111762c/588f4de989261ffd7d5f4af30db07ba5eb7cd5e9c5b5a4f364a0d2be35fbcc83" "q-8857/selection/ma-v1/7849d7da391ab5127f2109a14518aabb1bc9714806055e372ea692077111762c/7417de2488699448d96f2b0d6706251320e50030c51a1a5cf7bef7bc63b9cc6f"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-8857"] :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n\\begin{aligned}{\\begin{aligned}2x=5y \\\\ x=-2\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n\\begin{aligned}{\\begin{aligned}2x-5y=0 \\\\ x=-2.\\end{aligned}\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}2 & -5 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}0 \\\\ -2\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $A=[\\begin{aligned}2 & -5 \\\\ 1 & 0\\end{aligned}].$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{2\\cdot 0-(-5)\\cdot 1}[\\begin{aligned}0 & 5 \\\\ -1 & 2\\end{aligned}] \\\\  & =\\frac{1}{5}[\\begin{aligned}0 & 5 \\\\ -1 & 2\\end{aligned}].\\end{aligned}\n$$\n\nWe can now find the solution to this system as:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{5}[\\begin{aligned}0 & 5 \\\\ -1 & 2\\end{aligned}][\\begin{aligned}0 \\\\ -2\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-8857/selection/ma-v1/7849d7da391ab5127f2109a14518aabb1bc9714806055e372ea692077111762c"] :db/ensure [:question/validate]} [:db/retract 17592186092832 :question/answer-fields 17592186091457] {:db/id "q-8858/selection/ma-v1/11ef3bc47aa56d975a2d746d923add17a9920377602fed04115da7f4f5b28151/e5638db5bf731cf14bab88f7b9a759a20650d94edb6def8e8fcf002d2560cc7b" :answer/id #uuid "5aa1fe5c-4c55-5bf1-b4b3-6452f295acec" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{15}[\\begin{aligned}2 & 1 \\\\ 3 & -6\\end{aligned}][\\begin{aligned}0 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-8858/selection/ma-v1/11ef3bc47aa56d975a2d746d923add17a9920377602fed04115da7f4f5b28151/8d7494f647684b3ea55766dad0abcfc9d0e2886d939c2de319ab4a94c615a309" :answer/id #uuid "e8aa4411-a0fe-5307-802e-eb8550bd83e3" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{15}[\\begin{aligned}-6 & -1 \\\\ -3 & 2\\end{aligned}][\\begin{aligned}0 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-8858/selection/ma-v1/11ef3bc47aa56d975a2d746d923add17a9920377602fed04115da7f4f5b28151/6408172c596d86103d7a35d0029e3c4d59d4f063c8a51ad3a55a2b93aa3f4522" :answer/id #uuid "fd9b5840-5452-5034-ab41-46c9016587b5" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{6}[\\begin{aligned}-6 & -1 \\\\ -3 & 2\\end{aligned}][\\begin{aligned}0 \\\\ 2\\end{