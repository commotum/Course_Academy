#{[{:db/id #edb/ref 17592186277047 :knowledge-point/_questions [{:knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01" :knowledge-point/title "Solving for a Variable in a Singular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64d8056c-aeec-5a1a-9059-5f0e94f09159" :answer/type {:db/ident :answer.type/math} :answer/value "t=\\pm 2" :db/id #edb/ref 17592186277049} {:answer/id #uuid "05dc6303-a43b-529a-a7f1-9f6d34ebdccb" :answer/type {:db/ident :answer.type/math} :answer/value "t=-3" :db/id #edb/ref 17592186277050} {:answer/id #uuid "3c5f34b8-d55a-5f8e-b013-27cabcaff0f0" :answer/type {:db/ident :answer.type/math} :answer/value "t=2" :db/id #edb/ref 17592186277051} {:answer/id #uuid "f7c0fbba-f976-568b-a400-c82dd733eb64" :answer/type {:db/ident :answer.type/math} :answer/value "t=\\pm 3" :db/id #edb/ref 17592186277052} {:answer/id #uuid "83da0946-6dc3-516e-8d19-168392f39733" :answer/type {:db/ident :answer.type/math} :answer/value "t=3" :db/id #edb/ref 17592186277053}] :answer-field/correct {:answer/id #uuid "f7c0fbba-f976-568b-a400-c82dd733eb64" :answer/type {:db/ident :answer.type/math} :answer/value "t=\\pm 3" :db/id #edb/ref 17592186277052} :answer-field/id #uuid "970a4e18-384b-538a-b9f2-9f09c076bae6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277048}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "4918baf6-577a-5ac9-9070-414a1d323782" :question/math-academy-id "q-11719" :question/problem "If $F=[\\begin{aligned}3 & t \\\\ t & 3\\end{aligned}]$ is a singular matrix, calculate the value(s) of $t.$" :question/worked-solution "The matrix $F$ is singular if and only if $det(F)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(F) & =3\\cdot 3-t\\cdot t \\\\  & =9-{t}^{2}.\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $t:$\n\n$$\n\\begin{aligned}9-{t}^{2} & =0 \\\\ {t}^{2} & =9 \\\\ t & =\\pm 3\\end{aligned}\n$$\n\nTherefore, the values of $t$ are $t=\\pm 3.$"}] [{:db/id #edb/ref 17592186277089 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98ca54b2-8431-5444-9efe-fdbd7d2615eb" :answer/type {:db/ident :answer.type/text} :answer/value "$U$ only" :db/id #edb/ref 17592186277091} {:answer/id #uuid "142c305f-1241-5ca4-bd3c-20f1cc8d1f80" :answer/type {:db/ident :answer.type/text} :answer/value "$T$ only" :db/id #edb/ref 17592186277092} {:answer/id #uuid "46e22156-77f8-53ae-b232-4c1481123bd5" :answer/type {:db/ident :answer.type/text} :answer/value "$S$ only" :db/id #edb/ref 17592186277093} {:answer/id #uuid "2c91a010-1966-513a-b4c0-a950a36e14de" :answer/type {:db/ident :answer.type/text} :answer/value "$T$ and $S$ only" :db/id #edb/ref 17592186277094} {:answer/id #uuid "231b50e7-c515-5b7a-8237-1688f362c11c" :answer/type {:db/ident :answer.type/text} :answer/value "$S$ and $U$ only" :db/id #edb/ref 17592186277095}] :answer-field/correct {:answer/id #uuid "142c305f-1241-5ca4-bd3c-20f1cc8d1f80" :answer/type {:db/ident :answer.type/text} :answer/value "$T$ only" :db/id #edb/ref 17592186277092} :answer-field/id #uuid "f9614a24-643b-5a1c-a444-f3d4704932cd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277090}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "4a2fb10f-1cf2-5a6b-8b70-3549d9280b9f" :question/math-academy-id "q-127757" :question/problem "Which of the matrices below are singular?\n\n$$\nS=[\\begin{aligned}1 & 0 \\\\ -1 & -1\\end{aligned}],\\,T=[\\begin{aligned}2 & -3 \\\\ 4 & -6\\end{aligned}],\\,U=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}].\n$$" :question/worked-solution "- For the matrix $S$, we have\n\n$$\ndet(S)=1\\cdot (-1)-(-1)\\cdot 0=-1.\n$$\n\nBecause $det(S)\\ne 0,$ we conclude that $S$ is invertible.\n\n- For the matrix $T$, we have\n\n$$\ndet(T)=2\\cdot (-6)-4\\cdot (-3)=0.\n$$\n\nBecause $det(T)=0,$ we conclude that $T$ is not invertible. Since $T$ is a square matrix that is not invertible, we also say that $T$ is singular.\n\n- For the matrix $U$, we have\n\n$$\ndet(U)=0\\cdot 0-1\\cdot (-1)=1.\n$$\n\nBecause $det(U)\\ne 0,$ we conclude that $U$ is invertible.\n\nTherefore, only $T$ is singular."}] [{:db/id #edb/ref 17592186279737 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42922570-2de3-53ca-b704-55aa639db9d9" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186279739} {:answer/id #uuid "7cf08954-fd67-52e6-bd7a-76c18a37a27b" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186279740} {:answer/id #uuid "aec41eb0-803e-533d-b77f-d9c8ceaf2c5b" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186279741} {:answer/id #uuid "cbc9bb08-60d3-50c8-b1cc-956c5c17465b" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186279742} {:answer/id #uuid "bbd0ce3f-efa7-5d5c-94e0-4e9e72e19eeb" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186279743}] :answer-field/correct {:answer/id #uuid "7cf08954-fd67-52e6-bd7a-76c18a37a27b" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186279740} :answer-field/id #uuid "432ab73b-dcda-5589-8ece-932442e46212" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186279738}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "dd3729c7-43c0-5883-808f-5b63c7f7af84" :question/math-academy-id "q-127826" :question/problem "Which of the matrices below does **not** have an inverse?\n\n$$\nA=[\\begin{aligned}3 \\\\ 1 \\\\ 9\\end{aligned}],\\,B=[\\begin{aligned}-3 & 15 \\\\ 1 & 5\\end{aligned}],\\,C=[\\begin{aligned}7 & 4 \\\\ 3 & 2\\end{aligned}].\n$$" :question/worked-solution "- The matrix $A$ is a $3\\times 1$ matrix. So, it is not invertible.\n\n- For the matrix $B$, we have\n\n$$\ndet(B)=-3\\cdot 5-1\\cdot 15=-30.\n$$\n\nBecause $det(B)\\ne 0,$ we conclude that $B$ is invertible.\n\n- For the matrix $C$, we have\n\n$$\ndet(C)=7\\cdot 2-3\\cdot 4=2.\n$$\n\nBecause $det(C)\\ne 0,$ we conclude that $C$ is invertible.\n\nTherefore, only $A$ does not have an inverse."}] [{:db/id #edb/ref 17592186382665 :knowledge-point/_questions [{:knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01" :knowledge-point/title "Solving for a Variable in a Singular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c784e1e-459d-509b-9622-86a5898d3c23" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186382667}] :answer-field/correct {:answer/id #uuid "2c784e1e-459d-509b-9622-86a5898d3c23" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186382667} :answer-field/id #uuid "588d26c3-4d17-54ae-b871-0fb44f1739ac" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186382666} {:answer-field/choices [{:answer/id #uuid "9d7f55c7-be1d-5e79-b8af-61d91cb82c12" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186382669}] :answer-field/correct {:answer/id #uuid "9d7f55c7-be1d-5e79-b8af-61d91cb82c12" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186382669} :answer-field/id #uuid "0b465e1f-321f-5e89-a053-c0bcd5500b59" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186382668}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5de2acf0-9418-52f4-b9a6-27b23fa60b6c" :question/math-academy-id "q-316829" :question/problem "Let $B=[\\begin{aligned}3 & -x+7 \\\\ x-5 & 0\\end{aligned}]$\nbe a singular matrix. **In ascending order**, the values of $x$ are\n\n$x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "The matrix $B$ is singular if and only if $det(B)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(B) & =3\\cdot 0-(-x+7)\\cdot (x-5) \\\\  & ={x}^{2}-5x-7x+35 \\\\  & ={x}^{2}-12x+35.\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $x:$\n\n$$\n\\begin{aligned}{x}^{2}-12x+35 & =0 \\\\ (x-7)(x-5) & =0 \\\\ x & =7,5\\end{aligned}\n$$\n\nTherefore, in ascending order, the values of $x$ are\n\n$$\nx=5\\,\\text{and}\\,x=7.\n$$"}] [{:db/id #edb/ref 17592186382670 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51a60d9c-e5a7-5a76-b0fd-994eda482900" :answer/type {:db/ident :answer.type/text} :answer/value "$Z$ only" :db/id #edb/ref 17592186382672} {:answer/id #uuid "79e7c4ae-51f8-5c49-83c7-9764c072dc4b" :answer/type {:db/ident :answer.type/text} :answer/value "$V$ and $Z$ only" :db/id #edb/ref 17592186382673} {:answer/id #uuid "6b084eae-6588-5efa-8c6b-6329ed2a8264" :answer/type {:db/ident :answer.type/text} :answer/value "$N$ only" :db/id #edb/ref 17592186382674} {:answer/id #uuid "d333a178-720a-57b7-ab5e-07daebcd2af3" :answer/type {:db/ident :answer.type/text} :answer/value "$N$ and $V$ only" :db/id #edb/ref 17592186382675} {:answer/id #uuid "ff91e5e1-d20a-50fa-abd2-dbd390595a95" :answer/type {:db/ident :answer.type/text} :answer/value "$N$ and $Z$ only" :db/id #edb/ref 17592186382676}] :answer-field/correct {:answer/id #uuid "6b084eae-6588-5efa-8c6b-6329ed2a8264" :answer/type {:db/ident :answer.type/text} :answer/value "$N$ only" :db/id #edb/ref 17592186382674} :answer-field/id #uuid "ac0bcc82-7aad-5f54-ab32-0edb3e2d8e04" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382671}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "5f5bb9d1-db59-54f4-aa53-0a0fa0a6f6c0" :question/math-academy-id "q-71935" :question/problem "Which of the matrices below are singular?\n\n$$\nN=[\\begin{aligned}3 & 1 \\\\ 0 & 0\\end{aligned}],\\,V=[\\begin{aligned}1 \\\\ 2 \\\\ -2 \\\\ 1 \\\\ -1\\end{aligned}],\\,Z=[\\begin{aligned}0 & 8 \\\\ 2 & 0\\end{aligned}].\n$$" :question/worked-solution "- For the matrix $N$, we have\n\n$$\ndet(N)=3\\cdot 0-0\\cdot 1=0.\n$$\n\nBecause $det(N)=0,$ we conclude that $N$ is not invertible. Since $N$ is a square matrix that is not invertible, we also say that $N$ is singular.\n\n- The matrix $V$ is a $5\\times 1$ matrix. So, it is not invertible. Since the matrix is not square, we can't say that it's singular.\n\n- For the matrix $Z$, we have\n\n$$\ndet(Z)=0\\cdot 0-2\\cdot 8=-16.\n$$\n\nBecause $det(Z)\\ne 0,$ we conclude that $Z$ is invertible.\n\nTherefore, only $N$ is singular."}]}
