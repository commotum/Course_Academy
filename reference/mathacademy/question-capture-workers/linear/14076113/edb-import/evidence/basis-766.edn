#{[{:db/id #edb/ref 17592186277047 :knowledge-point/_questions [{:knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01" :knowledge-point/title "Solving for a Variable in a Singular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64d8056c-aeec-5a1a-9059-5f0e94f09159" :answer/type {:db/ident :answer.type/math} :answer/value "t=\\pm 2" :db/id #edb/ref 17592186277049} {:answer/id #uuid "05dc6303-a43b-529a-a7f1-9f6d34ebdccb" :answer/type {:db/ident :answer.type/math} :answer/value "t=-3" :db/id #edb/ref 17592186277050} {:answer/id #uuid "3c5f34b8-d55a-5f8e-b013-27cabcaff0f0" :answer/type {:db/ident :answer.type/math} :answer/value "t=2" :db/id #edb/ref 17592186277051} {:answer/id #uuid "f7c0fbba-f976-568b-a400-c82dd733eb64" :answer/type {:db/ident :answer.type/math} :answer/value "t=\\pm 3" :db/id #edb/ref 17592186277052} {:answer/id #uuid "83da0946-6dc3-516e-8d19-168392f39733" :answer/type {:db/ident :answer.type/math} :answer/value "t=3" :db/id #edb/ref 17592186277053}] :answer-field/correct {:answer/id #uuid "f7c0fbba-f976-568b-a400-c82dd733eb64" :answer/type {:db/ident :answer.type/math} :answer/value "t=\\pm 3" :db/id #edb/ref 17592186277052} :answer-field/id #uuid "970a4e18-384b-538a-b9f2-9f09c076bae6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277048}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "4918baf6-577a-5ac9-9070-414a1d323782" :question/math-academy-id "q-11719" :question/problem "If $F=[\\begin{aligned}3 & t \\\\ t & 3\\end{aligned}]$ is a singular matrix, calculate the value(s) of $t.$" :question/worked-solution "The matrix $F$ is singular if and only if $det(F)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(F) & =3\\cdot 3-t\\cdot t \\\\  & =9-{t}^{2}.\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $t:$\n\n$$\n\\begin{aligned}9-{t}^{2} & =0 \\\\ {t}^{2} & =9 \\\\ t & =\\pm 3\\end{aligned}\n$$\n\nTherefore, the values of $t$ are $t=\\pm 3.$"}] [{:db/id #edb/ref 17592186277089 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98ca54b2-8431-5444-9efe-fdbd7d2615eb" :answer/type {:db/ident :answer.type/text} :answer/value "$U$ only" :db/id #edb/ref 17592186277091} {:answer/id #uuid "142c305f-1241-5ca4-bd3c-20f1cc8d1f80" :answer/type {:db/ident :answer.type/text} :answer/value "$T$ only" :db/id #edb/ref 17592186277092} {:answer/id #uuid "46e22156-77f8-53ae-b232-4c1481123bd5" :answer/type {:db/ident :answer.type/text} :answer/value "$S$ only" :db/id #edb/ref 17592186277093} {:answer/id #uuid "2c91a010-1966-513a-b4c0-a950a36e14de" :answer/type {:db/ident :answer.type/text} :answer/value "$T$ and $S$ only" :db/id #edb/ref 17592186277094} {:answer/id #uuid "231b50e7-c515-5b7a-8237-1688f362c11c" :answer/type {:db/ident :answer.type/text} :answer/value "$S$ and $U$ only" :db/id #edb/ref 17592186277095}] :answer-field/correct {:answer/id #uuid "142c305f-1241-5ca4-bd3c-20f1cc8d1f80" :answer/type {:db/ident :answer.type/text} :answer/value "$T$ only" :db/id #edb/ref 17592186277092} :answer-field/id #uuid "f9614a24-643b-5a1c-a444-f3d4704932cd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277090}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "4a2fb10f-1cf2-5a6b-8b70-3549d9280b9f" :question/math-academy-id "q-127757" :question/problem "Which of the matrices below are singular?\n\n$$\nS=[\\begin{aligned}1 & 0 \\\\ -1 & -1\\end{aligned}],\\,T=[\\begin{aligned}2 & -3 \\\\ 4 & -6\\end{aligned}],\\,U=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}].\n$$" :question/worked-solution "- For the matrix $S$, we have\n\n$$\ndet(S)=1\\cdot (-1)-(-1)\\cdot 0=-1.\n$$\n\nBecause $det(S)\\ne 0,$ we conclude that $S$ is invertible.\n\n- For the matrix $T$, we have\n\n$$\ndet(T)=2\\cdot (-6)-4\\cdot (-3)=0.\n$$\n\nBecause $det(T)=0,$ we conclude that $T$ is not invertible. Since $T$ is a square matrix that is not invertible, we also say that $T$ is singular.\n\n- For the matrix $U$, we have\n\n$$\ndet(U)=0\\cdot 0-1\\cdot (-1)=1.\n$$\n\nBecause $det(U)\\ne 0,$ we conclude that $U$ is invertible.\n\nTherefore, only $T$ is singular."}]}
