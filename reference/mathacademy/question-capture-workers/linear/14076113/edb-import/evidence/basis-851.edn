#{[{:db/id #edb/ref 17592186279737 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42922570-2de3-53ca-b704-55aa639db9d9" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186279739} {:answer/id #uuid "7cf08954-fd67-52e6-bd7a-76c18a37a27b" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186279740} {:answer/id #uuid "aec41eb0-803e-533d-b77f-d9c8ceaf2c5b" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186279741} {:answer/id #uuid "cbc9bb08-60d3-50c8-b1cc-956c5c17465b" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186279742} {:answer/id #uuid "bbd0ce3f-efa7-5d5c-94e0-4e9e72e19eeb" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186279743}] :answer-field/correct {:answer/id #uuid "7cf08954-fd67-52e6-bd7a-76c18a37a27b" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186279740} :answer-field/id #uuid "432ab73b-dcda-5589-8ece-932442e46212" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186279738}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "dd3729c7-43c0-5883-808f-5b63c7f7af84" :question/math-academy-id "q-127826" :question/problem "Which of the matrices below does **not** have an inverse?\n\n$$\nA=[\\begin{aligned}3 \\\\ 1 \\\\ 9\\end{aligned}],\\,B=[\\begin{aligned}-3 & 15 \\\\ 1 & 5\\end{aligned}],\\,C=[\\begin{aligned}7 & 4 \\\\ 3 & 2\\end{aligned}].\n$$" :question/worked-solution "- The matrix $A$ is a $3\\times 1$ matrix. So, it is not invertible.\n\n- For the matrix $B$, we have\n\n$$\ndet(B)=-3\\cdot 5-1\\cdot 15=-30.\n$$\n\nBecause $det(B)\\ne 0,$ we conclude that $B$ is invertible.\n\n- For the matrix $C$, we have\n\n$$\ndet(C)=7\\cdot 2-3\\cdot 4=2.\n$$\n\nBecause $det(C)\\ne 0,$ we conclude that $C$ is invertible.\n\nTherefore, only $A$ does not have an inverse."}]}
