4d399653e2369d28f6924327f8ee56.png)\n\nDetermine the area $A$ of the parallelogram in the figure.\n\n$\\,\\,A=$ {{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979011/state.json" "file_sha256" "a55497375466263ccdf67b84ebf3970194cec0d090d8f03130b8a92102a9b700" "basis" 841 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979011/edb-import/verification.json"} {"question" "q-320392" "field" nil "attribute" "question/worked-solution" "value" "From the diagram, we get the vectors\n\n$$\n\\text{u}=⟨-3,2⟩,\\,\\text{v}=⟨1,3⟩.\n$$\n\nFirst, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}-3 & 1 \\\\ 2 & 3\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}-3 & 1 \\\\ 2 & 3\\end{aligned}| \\\\  & =(-3)\\cdot 3-1\\cdot 2 \\\\  & =-9-2 \\\\  & =-11\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|-11|=11\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979011/state.json" "file_sha256" "a55497375466263ccdf67b84ebf3970194cec0d090d8f03130b8a92102a9b700" "basis" 841 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979011/edb-import/verification.json"} {"question" "q-320392" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979011/activity-metadata.json" "file_sha256" "f48e535706214e002125807a3f3cce07ee9c034f6ca3ddf00a515c1c69ed35bc" "basis" 841 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979011/edb-import/verification.json"} {"question" "q-320392" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979011/state.json" "file_sha256" "a55497375466263ccdf67b84ebf3970194cec0d090d8f03130b8a92102a9b700" "basis" 841 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979011/edb-import/verification.json"} {"question" "q-320392" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "11"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979011/state.json" "file_sha256" "a55497375466263ccdf67b84ebf3970194cec0d090d8f03130b8a92102a9b700" "basis" 841 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979011/edb-import/verification.json"} {"question" "q-320558" "field" nil "attribute" "question/problem" "value" "Given that the area spanned between the vectors $\\text{u}=[\\begin{aligned}-\\sqrt{7} \\\\ 5\\end{aligned}]$ and $\\text{v}=[\\begin{aligned}a \\\\ -10\\end{aligned}]$ equals zero, what is the value of $a?$\n\n$a=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008824/state.json" "file_sha256" "d15b150f3a38fc3cbb41417ee5c1920ebb93691e27bb0c6208938a2ad22986f3" "basis" 1142 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008824/edb-import/verification.json"} {"question" "q-320558" "field" nil "attribute" "question/worked-solution" "value" "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}-\\sqrt{7} & a \\\\ 5 & -10\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}-\\sqrt{7} & a \\\\ 5 & -10\\end{aligned}| \\\\  & =(-\\sqrt{7})(-10)-a\\cdot 5 \\\\  & =10\\sqrt{7}-5a\\end{aligned}\n$$\n\nFinally, setting the expression for the determinant equal to $0$ and solving for $a,$ we get\n\n$$\n\\begin{aligned}10\\sqrt{7}-5a & =0 \\\\ 5a & =10\\sqrt{7} \\\\ a & =2\\sqrt{7}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008824/state.json" "file_sha256" "d15b150f3a38fc3cbb41417ee5c1920ebb93691e27bb0c6208938a2ad22986f3" "basis" 1142 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008824/edb-import/verification.json"} {"question" "q-320558" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008824/activity-metadata.json" "file_sha256" "e0d2b8203f602925d5c9e95d8816b7054e330e64b8609d000fecb50d032ce8f1" "basis" 1142 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008824/edb-import/verification.json"} {"question" "q-320558" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008824/state.json" "file_sha256" "d15b150f3a38fc3cbb41417ee5c1920ebb93691e27bb0c6208938a2ad22986f3" "basis" 1142 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008824/edb-import/verification.json"} {"question" "q-320558" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "2\\sqrt{7}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008824/state.json" "file_sha256" "d15b150f3a38fc3cbb41417ee5c1920ebb93691e27bb0c6208938a2ad22986f3" "basis" 1142 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008824/edb-import/verification.json"}] "sources" [{"question" "q-320402" "field" nil "attribute" "question/problem" "value" "Determine the area $A$ of the parallelogram spanned by $\\text{u}=[\\begin{aligned}3 \\\\ -1\\end{aligned}]$ and $\\text{v}=[\\begin{aligned}-2 \\\\ 5\\end{aligned}].$\n\n$\\,\\,A=$ {{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043024/state.json" "file_sha256" "dbe2719c92ef7ff41bff47f6a4d5e89da62e639e7f2425811ea9e91ce66b507c"} {"question" "q-320402" "field" nil "attribute" "question/worked-solution" "value" "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}3 & -2 \\\\ -1 & 5\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}3 & -2 \\\\ -1 & 5\\end{aligned}| \\\\  & =3\\cdot 5-(-2)\\cdot (-1) \\\\  & =15-2 \\\\  & =13\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|\\,13\\,|=13\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043024/state.json" "file_sha256" "dbe2719c92ef7ff41bff47f6a4d5e89da62e639e7f2425811ea9e91ce66b507c"} {"question" "q-320402" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043024/activity-metadata.json" "file_sha256" "de8a3787a199968123220fff16e5e1dc1feab2878bffd8d7a7d780bfd9195179"} {"question" "q-320402" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043024/state.json" "file_sha256" "dbe2719c92ef7ff41bff47f6a4d5e89da62e639e7f2425811ea9e91ce66b507c"} {"question" "q-320402" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "13"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043024/state.json" "file_sha256" "dbe2719c92ef7ff41bff47f6a4d5e89da62e639e7f2425811ea9e91ce66b507c"} {"question" "q-320392" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043024/assets/6881c7b52de83103dcfc483ec25455781a4d399653e2369d28f6924327f8ee56.png)\n\nDetermine the area $A$ of the parallelogram in the figure.\n\n$\\,\\,A=$ {{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043024/state.json" "file_sha256" "dbe2719c92ef7ff41bff47f6a4d5e89da62e639e7f2425811ea9e91ce66b507c"} {"question" "q-320392" "field" nil "attribute" "question/worked-solution" "value" "From the diagram, we get the vectors\n\n$$\n\\text{u}=⟨-3,2⟩,\\,\\text{v}=⟨1,3⟩.\n$$\n\nFirst, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}-3 & 1 \\\\ 2 & 3\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}-3 & 1 \\\\ 2 & 3\\end{aligned}| \\\\  & =(-3)\\cdot 3-1\\cdot 2 \\\\  & =-9-2 \\\\  & =-11\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|-11|=11\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043024/state.json" "file_sha256" "dbe2719c92ef7ff41bff47f6a4d5e89da62e639e7f2425811ea9e91ce66b507c"} {"question" "q-320392" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043024/activity-metadata.json" "file_sha256" "de8a3787a199968123220fff16e5e1dc1feab287