 :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-13958/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-13958/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-13958/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-13958/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-13958/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-13958/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-13958" :question/id #uuid "529d8005-e18f-5393-a462-f33e95fd4a29" :question/math-academy-id "q-13958" :question/problem "Calculate the area of the parallelogram spanned by $\\text{u}=⟨0,2⟩$ and $\\text{v}=⟨3,3⟩.$" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}0 & 3 \\\\ 2 & 3\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}0 & 3 \\\\ 2 & 3\\end{aligned}| \\\\  & =0\\cdot 3-3\\cdot 2 \\\\  & =-6\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|-6\\,|=6\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-13958/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "288e49b0-f706-54de-86b7-a17248fe2408"] :knowledge-point/questions ["q-13958"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-13944"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043024/assets/7a70285258e584708a7296a2a008536dec9c97750b48e5fe0eb2f8cb7761bed1.png)\n\nCalculate the area of the parallelogram in the figure." :db/ensure [:question/validate]} {:db/id "q-320558/field-1/a6a73de90386c5fd791902b6ac51c80fcc5f575dbdd5ff913b1fd2b4abd564e9" :answer/id #uuid "5824f598-19e4-5f13-956f-26984dcfe33b" :answer/type :answer.type/math :answer/value "-2\\sqrt{7}" :db/ensure [:answer/validate]} {:db/id 17592186289221 :answer-field/choices ["q-320558/field-1/a6a73de90386c5fd791902b6ac51c80fcc5f575dbdd5ff913b1fd2b4abd564e9"] :db/ensure [:answer-field/validate]} {:db/id "q-69938/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "cdb343e7-6744-57f7-95eb-b8163e9b56cd" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-69938/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "54fd7310-988b-54fd-86cc-5ad88ea5fddc" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-69938/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "82708d50-9b75-5ab6-953d-fd8e7e464fff" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-69938/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "0c3c279e-321f-502a-9f06-ca642f12c0e0" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-69938/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "c2bb3e70-ec30-58a2-a509-af52654b0fdd" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-69938/selection" :answer-field/id #uuid "c9264a88-2298-511f-a5ac-9b34c4534515" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-69938/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-69938/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-69938/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-69938/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-69938/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-69938/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-69938" :question/id #uuid "fec406bd-1c02-5450-9bb3-294b965e105d" :question/math-academy-id "q-69938" :question/problem "Calculate the area of the parallelogram spanned by $\\text{u}=⟨-2,3⟩$ and $\\text{v}=⟨4,-6⟩.$" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}-2 & 4 \\\\ 3 & -6\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}-2 & 4 \\\\ 3 & -6\\end{aligned}| \\\\  & =(-2)\\cdot (-6)-4\\cdot 3 \\\\  & =12-12 \\\\  & =0\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|\\,0\\,|=0\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-69938/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0272b8d6-8400-5a6d-b51d-fc6ca84bd166"] :knowledge-point/questions ["q-69938"] :db/ensure [:knowledge-point/validate]} {:db/id "q-320556/field-1/5ac3779a726295ec9ec15e4a85878d439a98489148691329db2389993db95b87" :answer/id #uuid "c32f8367-d095-5b0a-acdb-74ddb19bdabe" :answer/type :answer.type/math :answer/value "-6\\sqrt{10}" :db/ensure [:answer/validate]} {:db/id "q-320556/field-1" :answer-field/id #uuid "ff815ddc-e32f-5769-b372-2373baad5c21" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320556/field-1/5ac3779a726295ec9ec15e4a85878d439a98489148691329db2389993db95b87" :answer-field/choices ["q-320556/field-1/5ac3779a726295ec9ec15e4a85878d439a98489148691329db2389993db95b87"] :db/ensure [:answer-field/validate]} {:db/id "q-320556" :question/id #uuid "6e4da092-ee77-55ed-836b-88264c9d0d79" :question/math-academy-id "q-320556" :question/problem "Given that the area spanned between the vectors $\\text{u}=⟨3\\sqrt{2},\\,-\\sqrt{5}⟩$ and $\\text{v}=⟨a,\\,10⟩$ equals zero, what is the value of $a?$\n\n$a=$\n{{field-1}}" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}3\\sqrt{2} & a \\\\ -\\sqrt{5} & 10\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}3\\sqrt{2} & a \\\\ -\\sqrt{5} & 10\\end{aligned}| \\\\  & =3\\sqrt{2}\\cdot 10-a\\cdot (-\\sqrt{5}) \\\\  & =30\\sqrt{2}+a\\sqrt{5}\\end{aligned}\n$$\n\nFinally, setting the expression for the determinant equal to $0$ and solving for $a,$ we get\n\n$$\n\\begin{aligned}30\\sqrt{2}+a\\sqrt{5} & =0 \\\\ a\\sqrt{5} & =-30\\sqrt{2} \\\\ a & =-\\frac{30\\sqrt{2}}{\\sqrt{5}} \\\\ a & =-\\frac{30\\sqrt{2}}{\\sqrt{5}}\\cdot \\frac{\\sqrt{5}}{\\sqrt{5}} \\\\ a & =-\\frac{30\\sqrt{10}}{5} \\\\ a & =-6\\sqrt{10}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-320556/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0272b8d6-8400-5a6d-b51d-fc6ca84bd166"] :knowledge-point/questions ["q-320556"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-4437"] :question/problem "Calculate the area of the parallelogram spanned by $\\textbf{u}=\\langle 1,2 \\rangle$ and $\\textbf{v}=\\langle 3, -3 \\rangle.$" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043024/assets/f4b59236b774117dfc764389f3525a01c5f4c8429cece16552622f54cfb3d863.png)\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}1 & 3 \\\\ 2 & -3\\end{aligned}| \\\\  & =1\\cdot (-3)-3\\cdot 2 \\\\  & =-9\\end{aligned}\n$$\n\nThe absolute value of $\\det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA = |{-9}| = 9\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4438"] :question/problem "Calculate the area of the parallelogram spanned by $\\textbf{u}=\\langle 3,-2 \\rangle$ and $\\textbf{v}=\\langle 6, -4 \\rangle.$" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043024/assets/b25d71fb75afcb5e4f9e8ce137ec69fb1dfda54aa544b1636e11503273527844.png)\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}3 & 6 \\\\ -2 & -4\\end{aligned}| \\\\  & =3\\cdot (-4)-6\\cdot (-2) \\\\  & =0\\end{aligned}\n$$\n\nThe absolute value of $\\det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA = |\\,0\\,| = 0\n$$" :db/ensure [:question/validate]}]
