r/id #uuid "8c6aa692-e632-521d-bb73-83ccdec07908" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186123329} :answer-field/id #uuid "4776b888-ff4b-5704-8363-e0555bd6438e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123328}] :question/id #uuid "61ec1738-c727-5f71-a158-a3fc80b2a14e" :question/math-academy-id "q-38676" :question/problem "Given the linear transformation $T: \\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}5x - 7y \\\\ 14y - 10x\\end{bmatrix}$,\n\nfind $3 \\cdot nullity(T) + 1$."}] [{:db/id #edb/ref 17592186125054 :knowledge-point/_questions [{:knowledge-point/id #uuid "a60cd4e9-d478-52ef-871e-fb08ff3d68a5" :knowledge-point/title "Finding the Kernel of a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1577f04-b0e8-5356-91ab-8ff27efd16c8" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}-y \\\\ y \\\\ 0\\end{bmatrix}: y ∈ R}" :db/id #edb/ref 17592186123347} {:answer/id #uuid "cbc4fec6-3b63-5128-97df-0baa72759017" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}}" :db/id #edb/ref 17592186123348} {:answer/id #uuid "d8090c5e-7377-5c6a-a202-4cf800a70bfd" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}}" :db/id #edb/ref 17592186123349} {:answer/id #uuid "f019caac-735f-5746-b3c8-442aa020c812" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}y - 2z \\\\ y \\\\ z\\end{bmatrix}: y, z ∈ R}" :db/id #edb/ref 17592186123350} {:answer/id #uuid "35950c18-0381-50cb-bccc-9c9c6f48e3a9" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}x \\\\ 1 \\\\ z\\end{bmatrix}: x, z ∈ R}" :db/id #edb/ref 17592186123351}] :answer-field/correct {:answer/id #uuid "d8090c5e-7377-5c6a-a202-4cf800a70bfd" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}}" :db/id #edb/ref 17592186123349} :answer-field/id #uuid "11539bf7-1b86-5839-9950-ba1366205823" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123346}] :question/id #uuid "70fb9633-c0bc-5291-ae81-e236155dd61d" :question/math-academy-id "q-38719" :question/problem "Consider the linear transformation $T: \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}⟶\\begin{bmatrix}2x - 4y + 2z \\\\ x - 3y + z \\\\ 4x - 4y + z\\end{bmatrix}$. Find $Ker(T)$."}]}
