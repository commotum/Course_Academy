\\end{aligned}\n$$\n\nSince $\\,T({v}_{2})=0,$ we conclude that the only vector that belongs to the kernel of $\\,T$ is ${v}_{2}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-139998/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9af17e52-688b-5b75-8902-65be7464d50b"] :knowledge-point/questions ["q-139998"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81386/selection/9ee5b7299b5081feb73880ff427f94a4f20a0524e7e9f02d2426693a6da8815a" :answer/id #uuid "0ff1f22f-4713-5814-85f3-bc23ccd81044" :answer/type :answer.type/text :answer/value "${v}_{2}$ and ${v}_{3}$ only" :db/ensure [:answer/validate]} {:db/id "q-81386/selection/ae1ff8dad45e2c5cacb282945bb7f05d8899845640df9f6d8c53708f78d95913" :answer/id #uuid "bf86bee8-18fd-5f63-8bc4-9e4d5ff44597" :answer/type :answer.type/text :answer/value "${v}_{1}$ only" :db/ensure [:answer/validate]} {:db/id "q-81386/selection/74f923e30bd1e60077b4941616bdd8e16717425c5c2d54b9fa80a277550d9802" :answer/id #uuid "dc687c50-5415-549c-be66-2e4eb2acf837" :answer/type :answer.type/text :answer/value "${v}_{1}$ and ${v}_{3}$ only" :db/ensure [:answer/validate]} {:db/id "q-81386/selection/0482547ba4c57e810096b6d1c5be91fc8f58a6900b8903fad7ebb8752dddd009" :answer/id #uuid "d352ce7e-9e86-5ed2-b3cc-953d4cb61682" :answer/type :answer.type/text :answer/value "${v}_{1},$ ${v}_{2},$ and ${v}_{3}$" :db/ensure [:answer/validate]} {:db/id "q-81386/selection/cb5d8200d542b56188d12750b7c81f6b335546e9c1ed0ad9cbb9a67ef1a936aa" :answer/id #uuid "70888d7f-08da-53e6-9603-6f48e8e19bbf" :answer/type :answer.type/text :answer/value "${v}_{1}$ and ${v}_{2},$ only" :db/ensure [:answer/validate]} {:db/id "q-81386/selection" :answer-field/id #uuid "ee331383-2503-52f0-865a-c94193793cc0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81386/selection/0482547ba4c57e810096b6d1c5be91fc8f58a6900b8903fad7ebb8752dddd009" :answer-field/choices ["q-81386/selection/9ee5b7299b5081feb73880ff427f94a4f20a0524e7e9f02d2426693a6da8815a" "q-81386/selection/ae1ff8dad45e2c5cacb282945bb7f05d8899845640df9f6d8c53708f78d95913" "q-81386/selection/74f923e30bd1e60077b4941616bdd8e16717425c5c2d54b9fa80a277550d9802" "q-81386/selection/0482547ba4c57e810096b6d1c5be91fc8f58a6900b8903fad7ebb8752dddd009" "q-81386/selection/cb5d8200d542b56188d12750b7c81f6b335546e9c1ed0ad9cbb9a67ef1a936aa"] :db/ensure [:answer-field/validate]} {:db/id "q-81386" :question/id #uuid "8fe978ee-e242-5740-b3cc-178c387af89b" :question/math-academy-id "q-81386" :question/problem "Consider the linear transformation\n$T:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}x+4y \\\\ y+z \\\\ x-4z\\end{aligned}]$ and the vectors \n${v}_{1}=[\\begin{aligned}4 \\\\ -1 \\\\ 1\\end{aligned}],\\,{v}_{2}=[\\begin{aligned}-4 \\\\ 1 \\\\ -1\\end{aligned}],\\,{v}_{3}=[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}].$ Which of the given vectors belong to $\\text{Ker}(T)?$" :question/worked-solution "A vector $u$ belongs to the kernel of a linear transformation $T$ if $T(u)=0.$ \n\nTherefore, we need to compute $T({v}_{i})$ for each ${v}_{i}:$\n\n$$\n\\begin{aligned}T({v}_{1}) & =T([\\begin{aligned}4 \\\\ -1 \\\\ 1\\end{aligned}])=[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}] \\\\ T({v}_{2}) & =T([\\begin{aligned}-4 \\\\ 1 \\\\ -1\\end{aligned}])=[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}] \\\\ T({v}_{3}) & =T([\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}])=[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nSince $T({v}_{1})=T({v}_{2})=T({v}_{3})=0,$ we conclude that the vectors that belong to the kernel of $T$ are ${v}_{1},$ ${v}_{2},$ and ${v}_{3}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-81386/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9af17e52-688b-5b75-8902-65be7464d50b"] :knowledge-point/questions ["q-81386"] :db/ensure [:knowledge-point/validate]} {:db/id "q-37840/selectio