3ae75fb99bcb4" "q-83649/selection/964248f621b09394fc0b5c7c00e8c9f757ae400448c314d2d1a3b67e0e42b853"] :db/ensure [:answer-field/validate]} {:db/id "q-83649" :question/id #uuid "c652198c-eb51-5ff9-a8db-886e24ee0c6e" :question/math-academy-id "q-83649" :question/problem "Given the vector $x$ and the system of linear equations below, find the projection of $x$ onto the solution space of the system.\n\n$$\nx=[\\begin{aligned}0 \\\\ 1 \\\\ 5\\end{aligned}],\\,{\\begin{aligned}2{x}_{1}-4{x}_{3}=0 \\\\ 6{x}_{1}-12{x}_{3}=0\\end{aligned}\n$$" :question/worked-solution "First, we need to find a basis for the solution space of the system. \n\nConsider the augmented matrix $M$ of the system, which we reduce to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}2 & 0 & -4 & 0 \\\\ 6 & 0 & -12 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼[\\begin{aligned}2 & 0 & -4 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nIn the reduced matrix above, there is $1$ pivot column (the $1$st one). Thus, ${x}_{2},\\,{x}_{3}$ are free variables. Now, from the first equation, we get ${x}_{1}=2{x}_{3}.$ Therefore, the general solution is\n\n$$\n[\\begin{aligned}2{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]={x}_{2}[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]+{x}_{3}[\\begin{aligned}2 \\\\ 0 \\\\ 1\\end{aligned}],\\,{x}_{2},\\,{x}_{3}\\in R.\n$$\n\nConsequently, $B={[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}2 \\\\ 0 \\\\ 1\\end{aligned}]}$ is the basis of the solution space of the system.\n\nNow, we find the orthogonal projection of $x$ onto the solution space of the system:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x \\\\  & =[\\begin{aligned}0 & 2 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot {([\\begin{aligned}0 & 1 & 0 \\\\ 2 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}0 & 2 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}0 & 1 & 0 \\\\ 2 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ 1 \\\\ 5\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 2 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot {[\\begin{aligned}1 & 0 \\\\ 0 & 5\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}1 \\\\ 5\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 2 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot \\frac{1}{5}[\\begin{aligned}5 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ 5\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 2 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ 1 \\\\ 1\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-83649/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "26b41192-9680-55c3-930c-52ff235e1800"] :knowledge-point/questions ["q-83649"] :db/ensure [:knowledge-point/validate]} {:db/id "q-83652/selection/0fd141f3fb3eedf976f7c236168846c83106c12f4cd8fd2d97a80cfd764d01f4" :answer/id #uuid "260a6bc0-d7c9-549e-8428-229e0e11202a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ 31 \\\\ 16\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-83652/selection/fa47c94736c87a7ff94acae3145f60da43ad20a0b5de20eeb9aaf07c6bcd9d29" :answer/id #uuid "575dfb14-d8b1-50ae-ac0b-485160eb6ed7" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ 5 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-83652/selection/d7b325bcff1e88047b8876aed7595809970a80c18df9bca5fc30a8c9bc835219" :answer/id #uuid "87de39c7-fc6d-5cd4-b6ca-72e92f661a1e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-21 \\\\ 2 \\\\ -5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-83652/selection/ff3d2b47641f407b117e185b24aa22363c1833a178ddba7d10b98959cdfe27ac" :answer/id #uuid "692f7cf9-13d0-50ac-8169-7cac0d1a7a07" :answer/type :answer.type/math :answer/value "[\\begin{aligned}11 \\\\ 3 \\\\ -5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-83652/selection/2598400dcd1bc5e0a8e3610dcab872807d4ed760c7cd657013441f94ea090e8b" :answer/id #uuid "98d4d922-b459-55eb-b56f-6e592ad80e6a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}11 \\\\ 2 \\\\ -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-83652/selection" :answer-field/id #uuid "2b850af1-c033-5e43-8270-287d10f35039" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-83652/selection/d7b325bcff1e88047b8876aed7595809970a80c18df9bca5fc30a8c9bc835219" :answer-field/choices ["q-83652/selection/0fd141f3fb3eedf976f7c236168846c83106c12f4cd8fd2d97a80cfd764d01f4" "q-83652/selection/fa47c94736c87a7ff94acae3145f60da43ad20a0b5de20eeb9aaf07c6bcd9d29" "q-83652/selection/d7b325bcff1e88047b8876aed7595809970a80c18df9bca5fc30a8c9bc835219" "q-83652/selection/ff3d2b47641f407b117e185b24aa22363c1833a178ddba7d10b98959cdfe27ac" "q-83652/selection/2598400dcd1bc5e0a8e3610dcab872807d4ed760c7cd657013441f94ea090e8b"] :db/ensure [:answer-field/validate]} {:db/id "q-83652" :question/id #uuid "67c2d2db-fab5-5533-94db-ede589bf98fc" :question/math-academy-id "q-83652" :question/problem "Given the vector $x$ and the system of linear equations below, find the projection of $x$ onto the solution space of the system.\n\n$$\nx=[\\begin{aligned}-20 \\\\ 5 \\\\ -8\\end{aligned}],\\,{\\begin{aligned}{x}_{1}+3{x}_{2}-3{x}_{3}=0 \\\\ 4{x}_{1}+12{x}_{2}-12{x}_{3}=0\\end{aligned}\n$$" :question/worked-solution "First, we need to find a basis for the solution space of the system. \n\nConsider the augmented matrix $M$ of the system, which we reduce to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 3 & -3 & 0 \\\\ 4 & 12 & -12 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}-4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & -3 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, there is $1$ pivot column (the $1$st one). Thus, ${x}_{2},\\,{x}_{3}$ are free variables. Now, from the first equation, we get ${x}_{1}=-3{x}_{2}+3{x}_{3}.$ Therefore, the general solution is\n\n$$\n[\\begin{aligned}-3{x}_{2}+3{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]={x}_{2}[\\begin{aligned}-3 \\\\ 1 \\\\ 0\\end{aligned}]+{x}_{3}[\\begin{aligned}3 \\\\ 0 \\\\ 1\\end{aligned}],\\,{x}_{2},\\,{x}_{3}\\in R.\n$$\n\nConsequently, $B={[\\begin{aligned}-3 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}3 \\\\ 0 \\\\ 1\\end{aligned}]}$ is the basis of the solution space of the system.\n\nNow, we find the orthogonal projection of $x$ onto the solution space of the system:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x \\\\  & =[\\begin{aligned}-3 & 3 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot {([\\begin{aligned}-3 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}-3 & 3 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}-3 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}-20 \\\\ 5 \\\\ -8\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 3 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot {[\\begin{aligned}10 & -9 \\\\ -9 & 10\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}65 \\\\ -68\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 3 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot \\frac{1}{19}[\\begin{aligned}10 & 9 \\\\ 9 & 10\\end{aligned}]\\cdot [\\begin{aligned}65 \\\\ -68\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 3 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ -5\\end{aligned}] \\\\  & =[\\begin{aligned}-21 \\\\ 2 \\\\ -5\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-83652/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "26b41192-9680-55c3-930c-52ff235e1800"] :knowledge-point/questions ["q-83652"] :db/ensure [:knowledge-point/validate]} {:db/id "q-86846/selection/082c327711ff61dfae0f10b55d1ae0e7789010d71a6ca17bb06f88e1845ac0c0" :answer/id #uuid "6cbcbcb1-97cf-5503-9403-2ab165688af6" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-6 \\\\ 3 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-86846/selection/1aa80acb15dca4b66c881dd9ab5da3a4cc11c8c46e2ae28bd82d38e9cba604c1" :answer/id #uuid "75d4a077-746b-54da-ba7f-da27a27b95d9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 \\\\ 1 \\\\ -5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-86846/selection/2f0f1ba2fe63dfb8aa20b90436c2dc3ecaa11e5ed4c939797e93fb36d1823f83" :answer/id #uuid "e8d05ad2-ccc1-50f1-ad03-6d4b0b276017" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-9 \\\\ 5 \\\\ -6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-86846/selection/caa35dc19eaf242cad10101d6b5b6f3e5095c7f44cc2ba32439ed775cd1adb2d" :answer/id #uuid "61c4b152-856d-51d5-8f81-d2243aab2742" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-9 \\\\ 3 \\\\ -5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-86846/selection/483c249d42b95eb0bf7ea85426bd8fb13d5b67f0eb12f94d8922fc0ef702ed8d" :answer/id #uuid "b7116bf0-fc18-5e57-a4b7-17149badeeea" :answer/type :answer.type/math :answer/value "[\\begin{aligned}5 \\\\ 6 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-86846/selection" :answer-field/id #uuid "04f9141e-137e-5391-90e4-c0577d972549" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-86846/selection/caa35dc19eaf242cad10101d6b5b6f3e5095c7f44cc2ba32439ed775cd1adb2d" :answer-field/choices ["q-86846/selection/082c327711ff61dfae0f10b55d1ae0e7789010d71a6ca17bb06f88e1845ac0c0" "q-86846/selection/1aa80acb15dca4b66c881dd9ab5da3a4cc11c8c46e2ae28bd82d38e9cba604c1" "q-86846/selection/2f0f1ba2fe63dfb8aa20b90436c2dc3ecaa11e5ed4c939797e93fb36d1823f83" "q-86846/selection/caa35dc19eaf242cad10101d6b5b6f3e5095c7f44cc2ba32439ed775cd1adb2d" "q-86846/selection/483c249d42b95eb0bf7ea85426bd8fb13d5b67f0eb12f94d8922fc0ef702ed8d"] :db/ensure [:answer-field/validate]} {:db/id "q-86846" :question/id #uuid "5cf24a3d-38a9-5fd8-a2a7-b75acfc0bac4" :question/math-academy-id "q-86846" :question/problem "Given the vector $x$ and the system of linear equations below, find the projection of $x$ onto the solution space of the system.\n\n$$\nx=[\\begin{aligned}-8 \\\\ 1 \\\\ -8\\end{aligned}],\\,{\\begin{aligned}3{x}_{1}-6{x}_{2}-9{x}_{3}=0 \\\\ -2{x}_{1}+4{x}_{2}+6{x}_{3}=0\\end{aligned}\n$$" :question/worked-solution "First, we need to find a basis for the solution space of the system. \n\nConsider the augmented matrix $M$ of the system, which we reduce to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}3 & -6 & -9 & 0 \\\\ -2 & 4 & 6 & 0\\end{aligned}] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & -3 & 0 \\\\ -2 & 4 & 6 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & -3 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\n \n\nIn the reduced matrix above, there is $1$ pivot column (the $1$st one). Thus, ${x}_{2},\\,{x}_{3}$ are free variables. Now, from the first equation, we get ${x}_{1}=2{x}_{2}+3{x}_{3}.$ Therefore, the general solution is \n\n$$\n[\\begin{aligned}2{x}_{2}+3{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]={x}_{2}[\\begin{aligned}2 \\\\ 1 \\\\ 0\\end{aligned}]+{x}_{3}[\\begin{aligned}3 \\\\ 0 \\\\ 1\\end{aligned}],\\,{x}_{2},\\,{x}_{3}\\in R.\n$$\n\nConsequently, $B={[\\begin{aligned}2 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}3 \\\\ 0 \\\\ 1\\end{aligned}]}$ is the basis of the solution space of the system. \n\nNow, we find the orthogonal projection of $x$ onto the solution space of the system:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x \\\\  & =[\\begin{aligned}2 & 3 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot {([\\begin{aligned}2 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 & 3 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}2 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}-8 \\\\ 1 \\\\ -8\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 3 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot {[\\begin{aligned}5 & 6 \\\\ 6 & 10\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}-15 \\\\ -32\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 3 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot \\frac{1}{14}[\\begin{aligned}10 & -6 \\\\ -6 & 5\\end{aligned}]\\cdot [\\begin{aligned}-15 \\\\ -32\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 3 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot \\frac{1}{14}[\\begin{aligned}42 \\\\ -70\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 3 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}3 \\\\ -5\\end{aligned}] \\\\  & =[\\begin{aligned}-9 \\\\ 3 \\\\ -5\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-86846/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "26b41192-9680-55c3-930c-52ff235e1800"] :knowledge-point/questions ["q-86846"] :db/ensure [:knowledge-point/validate]} {:db/id "q-139475/selection/82f0679237d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5" :answer/id #uuid "9db2825b-86bf-51af-ac37-7e144a6e8508" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-139475/selection/adbad78d33491a071139fe589fefda7e9ba65cf97ebbcae14d252ac90459e198" :answer/id #uuid "5053bc2f-93d0-5b72-96c1-d81e1b8e56a7" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "q-139475/selection/1e940709a1b00fa910544fd0093551b452ea4b241ad5d9959525312e8a27fa19" :answer/id #uuid "ff0eca06-a5b5-5502-80b4-fe80cda83480" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{8}" :db/ensure [:answer/validate]} {:db/id "q-139475/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "6ac7ece0-3e06-59d6-81d0-855e2f55661c" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-139475/selection/e0bd991ac2e2f2a23ec920e03c6d5103be6b20c12a25d724ab290d4ba5292c3e" :answer/id #uuid "7146ae0e-c383-58f9-b13c-2e35338ab78a" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{6}" :db/ensure [:answer/validate]} {:db/id "q-139475/selection" :answer-field/id #uuid "24849fe2-d7aa-516f-8ad3-daf9939d75be" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-139475/selection/e0bd991ac2e2f2a23ec920e03c6d5103be6b20c12a25d724ab290d4ba5292c3e" :answer-field/choices ["q-139475/selection/82f0679237d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5" "q-139475/selection/adbad78d33491a071139fe589fefda7e9ba65cf97ebbcae14d252ac90459e198" "q-139475/selection/1e940709a1b00fa910544fd0093551b452ea4b241ad5d9959525312e8a27fa19" "q-139475/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-139475/selection/e0bd991ac2e2f2a23ec920e03c6d5103be6b20c12a25d724ab290d4ba5292c3e"] :db/ensure [:answer-field/validate]} {:db/id "q-139475" :question/id #uuid "c22671a2-0398-56c8-a280-658f39299023" :question/math-academy-id "q-139475" :question/problem "Find the acute angle between the vector $x$ and the subspace spanned by the linearly independent vectors ${{a}_{1},{a}_{2}},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}0 \\\\ 1 \\\\ 2\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}1 \\\\ 2 \\\\ 3\\end{aligned}],\\,x=[\\begin{aligned}-1 \\\\ -1 \\\\ 2\\end{aligned}].\n$$" :question/worked-solution "The orthogonal projection of $x$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have\n\n$$\nA=[\\begin{aligned}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{aligned}]=[\\begin{aligned}0 & 1 \\\\ 1 & 2 \\\\ 2 & 3\\end{aligned}]\\,⟹\\,{A}^{T}=[\\begin{aligned}0 & 1 & 2 \\\\ 1 & 2 & 3\\end{aligned}].\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}0 & 1 \\\\ 1 & 2 \\\\ 2 & 3\\end{aligned}]\\cdot {([\\begin{aligned}0 & 1 & 2 \\\\ 1 & 2 & 3\\end{aligned}]\\cdot [\\begin{aligned}0 & 1 \\\\ 1 & 2 \\\\ 2 & 3\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}0 & 1 & 2 \\\\ 1 & 2 & 3\\end{aligned}]\\cdot [\\begin{aligned}-1 \\\\ -1 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 1 \\\\ 1 & 2 \\\\ 2 & 3\\end{aligned}]\\cdot {[\\begin{aligned}5 & 8 \\\\ 8 & 14\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}3 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 1 \\\\ 1 & 2 \\\\ 2 & 3\\end{aligned}]\\cdot \\frac{1}{6}[\\begin{aligned}14 & -8 \\\\ -8 & 5\\end{aligned}]\\cdot [\\begin{aligned}3 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 1 \\\\ 1 & 2 \\\\ 2 & 3\\end{aligned}]\\cdot \\frac{1}{2}[\\begin{aligned}6 \\\\ -3\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}-3 \\\\ 0 \\\\ 3\\end{aligned}]\\end{aligned}\n$$\n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x.$ Equivalently, it is the acute angle between $x$ and any non-zero vector that is parallel to ${\\text{proj}}_{S}x.$ So, to make calculations easier, we can find the angle between the vectors\n\n$\\,$ $x=[\\begin{aligned}-1 \\\\ -1 \\\\ 2\\end{aligned}]\\,$ and $\\,2\\,{\\text{proj}}_{S}x=[\\begin{aligned}-3 \\\\ 0 \\\\ 3\\end{aligned}].$\n\nComputing the cosine using the dot product, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{(-1)\\cdot (-3)+(-1)\\cdot 0+2\\cdot 3}{\\sqrt{(-1)^{2}+(-1)^{2}+{2}^{2}}\\sqrt{(-3)^{2}+{0}^{2}+{3}^{2}}} \\\\  & =\\frac{9}{\\sqrt{6}\\sqrt{18}} \\\\  & =\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{\\sqrt{3}}{2})=\\frac{\\pi }{6},\n$$\n\nwhich is already an acute angle." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-139475/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1224e2dd-96bc-5c24-aacf-3c36a7c3a1e1"] :knowledge-point/questions ["q-139475"] :db/ensure [:knowledge-point/validate]} {:db/id "q-139514/selection/bd08b3d0b4798ec98f00308ce1a9bc55049688879ed551efd8f6e9fabd70aabb" :answer/id #uuid "a45b6b6b-61c0-585b-90f8-2d170537f7dc" :answer/type :answer.type/math :answer/value "{18.88}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-139514/selection/17131692adc238636e13056fb19b9138cd758dac16b78c5cac501beaff55b934" :answer/id #uuid "ec87d9cc-2606-5e2f-829b-33d5e965b2a9" :answer/type :answer.type/math :answer/value "{17.36}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-139514/selection/b4f9d5570a9735e6893b2c6524f11f403291b0bdc0361d6fa7d7f77b938bde6f" :answer/id #uuid "b3e054ba-4c25-55ff-a17b-d79ad1e72654" :answer/type :answer.type/math :answer/value "{20.02}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-139514/selection/ae820741ab75b63270e97d9ba1c227802b7c3202a87bf59fa68811f6ac862520" :answer/id #uuid "2cdea0aa-4fa4-5aa4-89bc-fd49fcce9bf4" :answer/type :answer.type/math :answer/value "{19.47}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-139514/selection/14dfbb2c4e2ca54653ac37ec3123b623f9d0456fbcac222f72d004b3f4bc8413" :answer/id #uuid "7615ff4d-be18-5825-a4af-8890e53486d4" :answer/type :answer.type/math :answer/value "{21.83}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-139514/selection" :answer-field/id #uuid "1ecade9a-1a07-5690-8fec-47498e02a4d0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-139514/selection/ae820741ab75b63270e97d9ba1c227802b7c3202a87bf59fa68811f6ac862520" :answer-field/choices ["q-139514/selection/bd08b3d0b4798ec98f00308ce1a9bc55049688879ed551efd8f6e9fabd70aabb" "q-139514/selection/17131692adc238636e13056fb19b9138cd758dac16b78c5cac501beaff55b934" "q-139514/selection/b4f9d5570a9735e6893b2c6524f11f403291b0bdc0361d6fa7d7f77b938bde6f" "q-139514/selection/ae820741ab75b63270e97d9ba1c227802b7c3202a87bf59fa68811f6ac862520" "q-139514/selection/14dfbb2c4e2ca54653ac37ec3123b623f9d0456fbcac222f72d004b3f4bc8413"] :db/ensure [:answer-field/validate]} {:db/id "q-139514" :question/id #uuid "a4223d70-b479-503c-ae0a-73ea28bfde29" :question/math-academy-id "q-139514" :question/problem "Find the acute angle between the vector $x$ and the subspace spanned by the linearly independent vectors ${{a}_{1},{a}_{2}},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}2 \\\\ 2 \\\\ 0\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-1 \\\\ 1 \\\\ -1\\end{aligned}],\\,\\,x=[\\begin{aligned}5 \\\\ -5 \\\\ 2\\end{aligned}].\n$$\n\nRound the answer to $2$ decimal places." :question/worked-solution "The orthogonal projection of $x$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have\n\n$$\nA=[\\begin{aligned}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{aligned}]=[\\begin{aligned}2 & -1 \\\\ 2 & 1 \\\\ 0 & -1\\end{aligned}]\\,⟹\\,{A}^{T}=[\\begin{aligned}2 & 2 & 0 \\\\ -1 & 1 & -1\\end{aligned}].\n$$\n\n \n\nTherefore, we get the following projection: \n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}2 & -1 \\\\ 2 & 1 \\\\ 0 & -1\\end{aligned}]\\cdot {([\\begin{aligned}2 & 2 & 0 \\\\ -1 & 1 & -1\\end{aligned}]\\cdot [\\begin{aligned}2 & -1 \\\\ 2 & 1 \\\\ 0 & -1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}2 & 2 & 0 \\\\ -1 & 1 & -1\\end{aligned}]\\cdot [\\begin{aligned}5 \\\\ -5 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -1 \\\\ 2 & 1 \\\\ 0 & -1\\end{aligned}]\\cdot {[\\begin{aligned}8 & 0 \\\\ 0 & 3\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}0 \\\\ -12\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -1 \\\\ 2 & 1 \\\\ 0 & -1\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{8} & 0 \\\\ 0 & \\frac{1}{3}\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ -12\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -1 \\\\ 2 & 1 \\\\ 0 & -1\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ -4\\end{aligned}] \\\\  & =4[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}].\\end{aligned}\n$$\n\n \n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x.$ Equivalently, it is the acute angle between $x$ and any non-zero vector that is parallel to ${\\text{proj}}_{S}x.$ So, to make calculations easier, we can find the angle between the vectors\n\n$\\,$ $x=[\\begin{aligned}5 \\\\ -5 \\\\ 2\\end{aligned}]\\,$ and $\\,\\frac{1}{4}\\,{\\text{proj}}_{S}x=[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}].$\n\nComputing the cosine using the dot product, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{x\\cdot {\\text{proj}}_{S}x}{‖x‖‖{\\text{proj}}_{S}x‖} \\\\  & =\\frac{5\\cdot 1+(-5)\\cdot (-1)+2\\cdot 1}{\\sqrt{{5}^{2}+(-5)^{2}+{2}^{2}}\\cdot \\sqrt{{1}^{2}+(-1)^{2}+{1}^{2}}} \\\\  & =\\frac{12}{\\sqrt{54}\\sqrt{3}} \\\\  & =\\frac{12}{9\\sqrt{2}} \\\\  & =\\frac{4}{3\\sqrt{2}}\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{4}{3\\sqrt{2}})≈{19.47}^{∘},\n$$\n\nwhich is already an acute angle." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-139514/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1224e2dd-96bc-5c24-aacf-3c36a7c3a1e1"] :knowledge-point/questions ["q-139514"] :db/ensure [:knowledge-point/validate]}]
