#{[{:db/id #edb/ref 17592186382120 :knowledge-point/_questions [{:knowledge-point/id #uuid "f020b27f-1cd4-550b-a83a-2afbb7e5db72" :knowledge-point/title "Identifying the Dimension of the Null Space of Matrices Using Inspection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "624e1d0c-cd74-5e91-8efa-53087a853596" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186382122} {:answer/id #uuid "115bdaee-f46e-50df-8c5d-006013b38843" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186382123} {:answer/id #uuid "102591f6-0608-55e9-8c95-169cd337ad4e" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186382124} {:answer/id #uuid "ec436cc7-7876-57a0-a969-10f75ef6a459" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186382125} {:answer/id #uuid "932d5dea-43c5-5d7d-95f4-0e4f9b8b9d0d" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186382126}] :answer-field/correct {:answer/id #uuid "ec436cc7-7876-57a0-a969-10f75ef6a459" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186382125} :answer-field/id #uuid "be8be31f-e4ef-525c-80ff-4091d9770d58" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382121}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "865fdfe5-f0b6-527a-b037-58ab9657cb54" :question/math-academy-id "q-139974" :question/problem "Consider the matrices given below. Find $\\text{dim(Null}(A))+\\text{dim(Null}(B))+\\text{dim(Null}(C)).$\n\n$$\nA=[\\begin{aligned}1 & 8 & 7 & 2 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & 0 & 0 & 0\\end{aligned}],\\,B=[\\begin{aligned}1 & 4 & -4 & 3 \\\\ 0 & 0 & 6 & 0 \\\\ 0 & 0 & 0 & 9 \\\\ 0 & 0 & 0 & 0\\end{aligned}],\\,C=[\\begin{aligned}1 & 5 & -4 & 3 \\\\ 0 & 2 & 1 & 0 \\\\ 0 & 0 & 0 & 7 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\n$$" :question/worked-solution "The dimension of the null space of a matrix is the number of non-pivot columns in the matrix. \n\nAlso, all of the given matrices are in row echelon form.\n\nWith that in mind, let's consider each of the statements.\n\n- The matrix $A$ has $2$ pivot columns and $2$ non-pivot columns (namely, the $2$nd and $3$rd columns). So, \n\n$$\n\\text{dim(Null}(A))=2.\n$$\n\n- The matrix $B$ has $3$ pivot columns and $1$ non-pivot column (namely, the $2$nd  column). So, \n\n$$\n\\text{dim(Null}(B))=1.\n$$\n\n- The matrix $C$ has $3$ pivot columns and $1$ non-pivot column (namely, the $3$rd column). So, \n\n$$\n\\text{dim(Null}(C))=1.\n$$\n\nTherefore,\n\n$$\n\\text{dim(Null}(A))+\\text{dim(Null}(B))+\\text{dim(Null}(C))=2+1+1=4.\n$$"}] [{:db/id #edb/ref 17592186382127 :knowledge-point/_questions [{:knowledge-point/id #uuid "f3a0e3b9-931a-52bd-9ed9-b8001c8de67b" :knowledge-point/title "Finding the Nullity of a Matrix Using Row Reduction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e609c32-859b-56f5-b278-bc24eac161fa" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186382129} {:answer/id #uuid "154f473a-5f96-5541-9be9-3b2f0a4900a6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186382130} {:answer/id #uuid "db00afdc-d58e-5471-a170-a1c465a070f5" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186382131} {:answer/id #uuid "8b948f3a-aae6-5c89-8587-87bac56c2df6" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186382132} {:answer/id #uuid "46761e41-84c7-58fe-b166-c8a9df522f03" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186382133}] :answer-field/correct {:answer/id #uuid "46761e41-84c7-58fe-b166-c8a9df522f03" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186382133} :answer-field/id #uuid "151111ff-9af0-5025-b738-e9286bf5ac9d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382128}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "2fb10982-5a62-516b-936f-d507119ad565" :question/math-academy-id "q-35318" :question/problem "If $A=[\\begin{aligned}2 & -1 & 3 \\\\ 0 & 9 & -5 \\\\ -4 & 2 & 7 \\\\ 6 & -3 & 9\\end{aligned}],\\,$ then $\\text{nullity}(A)=$" :question/worked-solution "Recall that by definition, $\\text{nullity}(A)=\\text{dim}(\\text{Null}(A)).$\n\nTo find $\\text{dim}(\\text{Null}(A))$, we reduce $A$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2 & -1 & 3 \\\\ 0 & 9 & -5 \\\\ -4 & 2 & 7 \\\\ 6 & -3 & 9\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼[\\begin{aligned}2 & -1 & 3 \\\\ 0 & 9 & -5 \\\\ 0 & 0 & 13 \\\\ 6 & -3 & 9\\end{aligned}] & {R}_{4} & :={R}_{4}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}2 & -1 & 3 \\\\ 0 & 9 & -5 \\\\ 0 & 0 & 13 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix has $3$ pivot columns and no non-pivot columns. \n\nTherefore,\n\n$$\n\\text{nullity}(A)=\\text{dim}(\\text{Null}(A))=0.\n$$"}] [{:db/id #edb/ref 17592186382134 :knowledge-point/_questions [{:knowledge-point/id #uuid "f3a0e3b9-931a-52bd-9ed9-b8001c8de67b" :knowledge-point/title "Finding the Nullity of a Matrix Using Row Reduction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5baea4f-9bc6-54b4-bdbd-539478c7752b" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186382136} {:answer/id #uuid "ba715dfb-63d8-57d8-98eb-d748539e0f28" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186382137} {:answer/id #uuid "6b1647ae-9b3d-567b-8ee0-590a76a8603c" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186382138} {:answer/id #uuid "46493b1a-d566-5974-a5b2-6cc33865f1b9" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186382139} {:answer/id #uuid "13b5bace-ecf9-54fd-a0b5-f9dcfd214b12" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186382140}] :answer-field/correct {:answer/id #uuid "6b1647ae-9b3d-567b-8ee0-590a76a8603c" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186382138} :answer-field/id #uuid "93e26811-707c-542a-8c14-6dafeed2bd49" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382135}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "daab19d5-bf99-519c-b857-bce1128afeef" :question/math-academy-id "q-35348" :question/problem "Given $Z=[\\begin{aligned}-3 & 12 & 3 & -6 & 9 \\\\ 0 & -2 & 4 & -7 & 11 \\\\ -1 & 4 & 4 & -1 & 5 \\\\ 0 & 2 & -4 & 7 & -1 \\\\ -2 & 8 & 2 & -4 & 6\\end{aligned}],\\,$ what is $\\text{dim}(\\text{Null}(Z))?$" :question/worked-solution "To find $\\text{dim}(\\text{Null}(Z))$, we reduce $Z$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}Z & =[\\begin{aligned}-3 & 12 & 3 & -6 & 9 \\\\ 0 & -2 & 4 & -7 & 11 \\\\ -1 & 4 & 4 & -1 & 5 \\\\ 0 & 2 & -4 & 7 & -1 \\\\ -2 & 8 & 2 & -4 & 6\\end{aligned}] & {R}_{3} & :={R}_{3}+(-\\frac{1}{3}){R}_{1} \\\\  & ∼[\\begin{aligned}-3 & 12 & 3 & -6 & 9 \\\\ 0 & -2 & 4 & -7 & 11 \\\\ 0 & 0 & 3 & 1 & 2 \\\\ 0 & 2 & -4 & 7 & -1 \\\\ -2 & 8 & 2 & -4 & 6\\end{aligned}] & {R}_{5} & :={R}_{5}+(-\\frac{2}{3}){R}_{1} \\\\  & ∼[\\begin{aligned}-3 & 12 & 3 & -6 & 9 \\\\ 0 & -2 & 4 & -7 & 11 \\\\ 0 & 0 & 3 & 1 & 2 \\\\ 0 & 2 & -4 & 7 & -1 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}] & {R}_{4} & :={R}_{4}+{R}_{2} \\\\  & ∼[\\begin{aligned}-3 & 12 & 3 & -6 & 9 \\\\ 0 & -2 & 4 & -7 & 11 \\\\ 0 & 0 & 3 & 1 & 2 \\\\ 0 & 0 & 0 & 0 & 10 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix has $4$ pivot columns and $1$ non-pivot column (namely, the $4$th column). \n\nTherefore,\n\n$$\n\\text{dim}(\\text{Null}(Z))=1.\n$$"}] [{:db/id #edb/ref 17592186124793 :knowledge-point/_questions [{:knowledge-point/id #uuid "f020b27f-1cd4-550b-a83a-2afbb7e5db72" :knowledge-point/title "Identifying the Dimension of the Null Space of Matrices Using Inspection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a582c39-97d3-5d2f-b486-72b41c4fd3a3" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186121781} {:answer/id #uuid "c47edece-6f7d-566c-89b5-7dcd9de7133f" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186121782} {:answer/id #uuid "f9105c39-144e-58a1-93a6-9df21b568272" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186121783} {:answer/id #uuid "5321353c-34d0-5db8-881d-63ececdb47d3" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186121784} {:answer/id #uuid "57fe7eb8-f28d-59b0-b282-b32adf90cd5b" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186121785}] :answer-field/correct {:answer/id #uuid "c47edece-6f7d-566c-89b5-7dcd9de7133f" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186121782} :answer-field/id #uuid "0633da0e-56c5-54f3-b8da-02429b2fc95c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121780}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1eb36ea9-01c5-5b94-89ae-678eeae6fd31" :question/math-academy-id "q-35349" :question/problem "Consider the matrices given below. Find $\\text{dim(Null}(A))+\\text{dim(Null}(B))+\\text{dim(Null}(C)).$\n\n$$\nA=[\\begin{aligned}1 & -1 & 5 \\\\ 0 & 0 & -7 \\\\ 0 & 0 & 0\\end{aligned}],\\,B=[\\begin{aligned}2 & -4 & 7 & 2 \\\\ 0 & 0 & 5 & 3 \\\\ 0 & 0 & 0 & 0\\end{aligned}],\\,C=[\\begin{aligned}1 & 0 & -4 & 3 \\\\ 0 & 2 & 1 & 0 \\\\ 0 & 0 & -7 & 9 \\\\ 0 & 0 & 0 & 2\\end{aligned}]\n$$" :question/worked-solution "The dimension of the null space of a matrix is the number of non-pivot columns in the matrix. \n\nAlso, all of the given matrices are in row echelon form.\n\nWith that in mind, let's consider each of the statements.\n\n- The matrix $A$ has $2$ pivot columns and $1$ non-pivot column (namely, the $2$nd column). So, \n\n$$\n\\text{dim(Null}(A))=1.\n$$\n\n- The matrix $B$ has $2$ pivot columns and $2$ non-pivot columns (namely, the $2$nd and $4$th columns). So, \n\n$$\n\\text{dim(Null}(B))=2.\n$$\n\n- The matrix $C$ has $4$ pivot columns and no non-pivot columns. So, \n\n$$\n\\text{dim(Null}(C))=0.\n$$\n\nTherefore,\n\n$$\n\\text{dim(Null}(A))+\\text{dim(Null}(B))+\\text{dim(Null}(C))=1+2+0=3.\n$$"}] [{:db/id #edb/ref 17592186382141 :knowledge-point/_questions [{:knowledge-point/id #uuid "ce5ddb87-f7c0-5bda-8d6e-ac1728dd2f99" :knowledge-point/title "Determining the Dimension of the Null Space of a Matrix Given the Number of Non-Pivot Columns"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dba79471-ee02-58ef-b2fd-1abe42bc188d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186382143} {:answer/id #uuid "8d83f58a-e8e5-593b-af7f-cf926bdab03d" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186382144} {:answer/id #uuid "b1ed8aa0-75d2-5f74-8203-9a155629e396" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186382145} {:answer/id #uuid "bef5420b-2662-5de7-99c4-43398761f3d9" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186382146} {:answer/id #uuid "528d1861-3336-579a-a6af-82d402e095ac" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186382147}] :answer-field/correct {:answer/id #uuid "dba79471-ee02-58ef-b2fd-1abe42bc188d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186382143} :answer-field/id #uuid "4005ef44-3477-5cb7-a13b-40fda2dc0064" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382142}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "585570f5-8f9c-5c98-a1b7-b1b44c87b365" :question/math-academy-id "q-79336" :question/problem "Let $Q$ be a $5\\times 8$ matrix that has $5$ pivot columns. What is the dimension of the null space of $Q?$" :question/worked-solution "We know that $\\text{dim(Null}(Q))$ is the number of non-pivot columns in $Q.$ \n\nSince $Q$ has $8$ columns and $5$ of them are pivots, then the number of non-pivot columns in $Q$ is \n\n$$\n8-5=3.\n$$\n\nTherefore, $\\text{dim(Null}(Q))=3.$"}]}
