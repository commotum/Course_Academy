#{[{:db/id #edb/ref 17592186366056 :knowledge-point/_questions [{:knowledge-point/id #uuid "7083d465-9871-59ca-97fa-583e740e961f" :knowledge-point/title "Evaluating a Bilinear Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2ebb4f8-da81-590f-b864-dcd9284598cd" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186366058} {:answer/id #uuid "ba0f3095-cf7b-5d71-9a79-e3b700e224d2" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186366059} {:answer/id #uuid "3fc25b48-e112-5f68-8e77-6f57099aeb50" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186366060} {:answer/id #uuid "55ae36c2-2d7f-533c-ba1f-473ff3462994" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186366061} {:answer/id #uuid "aa86bd07-88ac-5bdb-8039-5173c1cc21c5" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186366062}] :answer-field/correct {:answer/id #uuid "3fc25b48-e112-5f68-8e77-6f57099aeb50" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186366060} :answer-field/id #uuid "5aa60481-686a-5eb6-ac2e-42effa99d225" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366057}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ac50817d-d0cd-5bab-aa46-bd534774fa22" :question/math-academy-id "q-140853" :question/problem "Consider the bilinear form $B(x,y),$ given by \n\n$$\nB(x,y)=2{x}_{1}{y}_{2}+{x}_{1}{y}_{3}-3{x}_{2}{y}_{2}+2{x}_{3}{y}_{1}.\n$$\n\n \n\nEvaluate $B(x,y)$ when $x=[\\begin{aligned}3 \\\\ 1 \\\\ -2\\end{aligned}]$ and $y=[\\begin{aligned}0 \\\\ 5 \\\\ 2\\end{aligned}].$" :question/worked-solution "We are given that \n\n$\\,$ $x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]=[\\begin{aligned}3 \\\\ 1 \\\\ -2\\end{aligned}]\\,$ and $\\,y=[\\begin{aligned}{y}_{1} \\\\ {y}_{2} \\\\ {y}_{3}\\end{aligned}]=[\\begin{aligned}0 \\\\ 5 \\\\ 2\\end{aligned}].$\n\nSubstituting these into the bilinear expression, we obtain\n\n$$\n\\begin{aligned}B(x,y) & =2{x}_{1}{y}_{2}+{x}_{1}{y}_{3}-3{x}_{2}{y}_{2}+2{x}_{3}{y}_{1} \\\\  & =2\\cdot 3\\cdot 5+3\\cdot 2-3\\cdot 1\\cdot 5+2\\cdot (-2)\\cdot 0 \\\\  & =30+6-15+0 \\\\  & =21.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186162517 :knowledge-point/_questions [{:knowledge-point/id #uuid "f60cd05d-e4af-5bf1-8827-cab48da934f1" :knowledge-point/title "Finding the Matrix of a Bilinear Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c11cd929-0e7a-5230-8aa7-39bc2a551d35" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186160735} {:answer/id #uuid "cf0b46a9-469a-54b5-8107-69049a8db261" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186160736} {:answer/id #uuid "27d333f1-0665-5e4a-afbb-b4edb5e3b679" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186160737} {:answer/id #uuid "29dd1938-cc82-553a-ac59-82e154305332" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186160738} {:answer/id #uuid "7ed51051-d2bc-5393-b618-3565d1d705f5" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186160739}] :answer-field/correct {:answer/id #uuid "27d333f1-0665-5e4a-afbb-b4edb5e3b679" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186160737} :answer-field/id #uuid "2426506e-6641-5c48-9e39-b679fd02c646" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186160734}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "82537968-6767-565c-820b-eb7ee2eb1460" :question/math-academy-id "q-93685" :question/problem "$$\n[\\begin{aligned}a & 0 & -3 \\\\ 0 & 0 & b \\\\ 0 & 0 & c\\end{aligned}]\n$$\n\nThe matrix of the bilinear form $B(x,y)={x}_{1}{y}_{1}-3{x}_{1}{y}_{3}+{x}_{2}{y}_{3}-{x}_{3}{y}_{3}$ is given above. What is the value of $a+b+c?$" :question/worked-solution "Each term ${a}_{ij}{x}_{i}{y}_{j}$ in the expression of the bilinear form corresponds to the entry ${a}_{ij}$ of the matrix:\n\n$$\n\\begin{aligned}B(x,y) & ={x}_{1}{y}_{1}-3{x}_{1}{y}_{3}+{x}_{2}{y}_{3}-{x}_{3}{y}_{3} \\\\  & =1{x}_{1}{y}_{1}+0{x}_{1}{y}_{2}+(-3){x}_{1}{y}_{3} \\\\  & +\\,0{x}_{2}{y}_{1}+0{x}_{2}{y}_{2}+1{x}_{2}{y}_{3} \\\\  & +\\,0{x}_{3}{y}_{1}+0{x}_{3}{y}_{2}+(-1){x}_{3}{y}_{3}\\end{aligned}\n$$\n\nThen, the corresponding matrix of the bilinear form is\n\n$$\n[\\begin{aligned}1 & 0 & -3 \\\\ 0 & 0 & 1 \\\\ 0 & 0 & -1\\end{aligned}].\n$$\n\nTherefore, $a=1,$ $b=1,$ and $c=-1.$ Finally, \n\n$$\na+b+c=1+1+(-1)=1.\n$$"}] [{:db/id #edb/ref 17592186366063 :knowledge-point/_questions [{:knowledge-point/id #uuid "55277d69-eedc-5c5c-883a-083746e00947" :knowledge-point/title "Writing Down a Bilinear Form Given Its Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "817a6e53-bae3-5084-b075-af5376788550" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}_{1}{y}_{1}-{x}_{1}{y}_{2}-{x}_{2}{y}_{1}+{x}_{2}{y}_{2}" :db/id #edb/ref 17592186366065} {:answer/id #uuid "b514cf9c-3dc3-565f-9ff6-2cf8a817bff8" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}_{1}{y}_{1}+{x}_{1}{y}_{2}-{x}_{2}{y}_{1}+3{x}_{2}{y}_{2}" :db/id #edb/ref 17592186366066} {:answer/id #uuid "131a7aaa-60e1-5667-89b9-05264d0c1f9c" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}_{1}{y}_{1}+{x}_{1}{y}_{2}+{x}_{2}{y}_{1}+2{x}_{2}{y}_{2}" :db/id #edb/ref 17592186366067} {:answer/id #uuid "7d6b4b41-bce9-59b2-a5c5-e7b971b3c199" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}_{1}{y}_{1}+{x}_{1}{y}_{2}-3{x}_{2}{y}_{1}+2{x}_{2}{y}_{2}" :db/id #edb/ref 17592186366068} {:answer/id #uuid "e735d04e-5ce8-5cdb-bba8-d247ff2be594" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}_{1}{y}_{1}+{x}_{1}{y}_{2}-{x}_{2}{y}_{1}+2{x}_{2}{y}_{2}" :db/id #edb/ref 17592186366069}] :answer-field/correct {:answer/id #uuid "e735d04e-5ce8-5cdb-bba8-d247ff2be594" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}_{1}{y}_{1}+{x}_{1}{y}_{2}-{x}_{2}{y}_{1}+2{x}_{2}{y}_{2}" :db/id #edb/ref 17592186366069} :answer-field/id #uuid "130441bc-66e3-5d38-9a11-87ef6ff299d7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366064}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "95bc1c5a-4cad-5587-8969-cf8149e63588" :question/math-academy-id "q-93982" :question/problem "$$\nA=[\\begin{aligned}3 & 1 \\\\ -1 & 2\\end{aligned}]\n$$\n\nConsider the matrix $A$ above. Which of the following represents the corresponding bilinear form ${x}^{T}\\,Ay$ in terms of the components of $x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ and $y=[\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]?$" :question/worked-solution "**Method 1**\n\nEach entry ${a}_{ij}$ of $A$ corresponds to the term ${a}_{ij}{x}_{i}{y}_{j}$ in the expression of the bilinear form:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ay & =3{x}_{1}{y}_{1}+1{x}_{1}{y}_{2}+(-1){x}_{2}{y}_{1}+2{x}_{2}{y}_{2} \\\\  & =3{x}_{1}{y}_{1}+{x}_{1}{y}_{2}-{x}_{2}{y}_{1}+2{x}_{2}{y}_{2}\\end{aligned}\n$$\n\n**Method 2**\n\nTo write down a bilinear form in terms of vector components, we compute the following expression:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ay & =[\\begin{aligned}{x}_{1} & {x}_{2}\\end{aligned}][\\begin{aligned}3 & 1 \\\\ -1 & 2\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{1} & {x}_{2}\\end{aligned}][\\begin{aligned}3{y}_{1}+{y}_{2} \\\\ -{y}_{1}+2{y}_{2}\\end{aligned}] \\\\  & ={x}_{1}(3{y}_{1}+{y}_{2})+{x}_{2}(-{y}_{1}+2{y}_{2}) \\\\  & =3{x}_{1}{y}_{1}+{x}_{1}{y}_{2}-{x}_{2}{y}_{1}+2{x}_{2}{y}_{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186162540 :knowledge-point/_questions [{:knowledge-point/id #uuid "55277d69-eedc-5c5c-883a-083746e00947" :knowledge-point/title "Writing Down a Bilinear Form Given Its Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f8e3d32-cb88-5abe-88b9-1868be3e4827" :answer/type {:db/ident :answer.type/math} :answer/value "x_{1}y_{1} + 2x_{1}y_{2} - 4x_{2}y_{1} - 3x_{2}y_{2}" :db/id #edb/ref 17592186160873} {:answer/id #uuid "d5555511-4bae-5686-a31a-69ec0fb29eb9" :answer/type {:db/ident :answer.type/math} :answer/value "3x_{1}y_{1} + 2x_{1}y_{2} - 3x_{2}y_{1} - 4x_{2}y_{2}" :db/id #edb/ref 17592186160874} {:answer/id #uuid "e23038ac-d68e-541f-bd4d-07f39009af2b" :answer/type {:db/ident :answer.type/math} :answer/value "x_{1}y_{1} - 4x_{1}y_{2} - 3x_{2}y_{1} - x_{2}y_{2}" :db/id #edb/ref 17592186160875} {:answer/id #uuid "5828b9de-e429-5479-829d-99464f292dac" :answer/type {:db/ident :answer.type/math} :answer/value "4x_{1}y_{1} + 2x_{1}y_{2} - 3x_{2}y_{1} - x_{2}y_{2}" :db/id #edb/ref 17592186160876} {:answer/id #uuid "66256c8a-924c-5a2f-ac31-7edd945e3b9a" :answer/type {:db/ident :answer.type/math} :answer/value "2x_{1}y_{1} + 3x_{1}y_{2} - 3x_{2}y_{1} - 4x_{2}y_{2}" :db/id #edb/ref 17592186160877}] :answer-field/correct {:answer/id #uuid "d5555511-4bae-5686-a31a-69ec0fb29eb9" :answer/type {:db/ident :answer.type/math} :answer/value "3x_{1}y_{1} + 2x_{1}y_{2} - 3x_{2}y_{1} - 4x_{2}y_{2}" :db/id #edb/ref 17592186160874} :answer-field/id #uuid "6144377b-2858-57bb-9019-cb785d435d77" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186160872}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7f94487d-a953-56f1-b8df-bebe18a80b03" :question/math-academy-id "q-94004" :question/problem "$$\nA=[\\begin{aligned}3 & 2 \\\\ -3 & -4\\end{aligned}]\n$$\n\nConsider the matrix $A$ above. Which of the following represents the corresponding bilinear form ${x}^{T}\\,Ay$ in terms of the components of $x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ and $y=[\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]?$" :question/worked-solution "**Method 1**\n\nEach entry ${a}_{ij}$ of $A$ corresponds to the term ${a}_{ij}{x}_{i}{y}_{j}$ in the expression of the bilinear form:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ay & =(3){x}_{1}{y}_{1}+2{x}_{1}{y}_{2}+(-3){x}_{2}{y}_{1}+-4{x}_{2}{y}_{2} \\\\  & =3{x}_{1}{y}_{1}+2{x}_{1}{y}_{2}-3{x}_{2}{y}_{1}-4{x}_{2}{y}_{2}\\end{aligned}\n$$\n\n**Method 2**\n\nTo write down a bilinear form in terms of vector components, we compute the following expression:\n\n$$\n\\begin{aligned}{x}^{T}\\,Ay & =[\\begin{aligned}{x}_{1} & {x}_{2}\\end{aligned}][\\begin{aligned}3 & 2 \\\\ -3 & -4\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{1} & {x}_{2}\\end{aligned}][\\begin{aligned}3{y}_{1}+2{y}_{2} \\\\ -3{y}_{1}-4{y}_{2}\\end{aligned}] \\\\  & ={x}_{1}(3{y}_{1}+2{y}_{2})+{x}_{2}(-3{y}_{1}-4{y}_{2}) \\\\  & =3{x}_{1}{y}_{1}+2{x}_{1}{y}_{2}-3{x}_{2}{y}_{1}-4{x}_{2}{y}_{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186366070 :knowledge-point/_questions [{:knowledge-point/id #uuid "f60cd05d-e4af-5bf1-8827-cab48da934f1" :knowledge-point/title "Finding the Matrix of a Bilinear Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c40c08b-c93d-5def-af01-c24b25ae8939" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186366072} {:answer/id #uuid "716c2ae5-3dd7-564a-9933-303c6c2e55cb" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186366073} {:answer/id #uuid "a2f13e28-1f68-58cc-83fb-910473ea581a" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186366074} {:answer/id #uuid "b5a81527-9cbf-533b-b0dd-a58842ffdc28" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186366075} {:answer/id #uuid "a1cfac5e-9efd-554c-a559-1e0f5d0b8357" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186366076}] :answer-field/correct {:answer/id #uuid "a2f13e28-1f68-58cc-83fb-910473ea581a" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186366074} :answer-field/id #uuid "ed45c267-15d0-55f9-8584-ff5e403bcc8e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366071}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b10e7084-45ad-5978-87c8-4808b0be70b8" :question/math-academy-id "q-94057" :question/problem "$$\n[\\begin{aligned}0 & a & 0 \\\\ b & 0 & 0 \\\\ 0 & -3 & c\\end{aligned}]\n$$\n\nThe matrix of the bilinear form $B(x,y)={x}_{1}{y}_{2}+3{x}_{2}{y}_{1}-3{x}_{3}{y}_{2}+2{x}_{3}{y}_{3}$ is given above. What is the value of $a+b+c?$" :question/worked-solution "Each term ${a}_{ij}{x}_{i}{y}_{j}$ in the expression of the bilinear form corresponds to the entry ${a}_{ij}$ of the matrix:\n\n$$\n\\begin{aligned}B(x,y) & ={x}_{1}{y}_{2}+3{x}_{2}{y}_{1}-3{x}_{3}{y}_{2}+2{x}_{3}{y}_{3} \\\\  & =0{x}_{1}{y}_{1}+1{x}_{1}{y}_{2}+0{x}_{1}{y}_{3} \\\\  & +\\,3{x}_{2}{y}_{1}+0{x}_{2}{y}_{2}+0{x}_{2}{y}_{3} \\\\  & +\\,0{x}_{3}{y}_{1}+(-3){x}_{3}{y}_{2}+2{x}_{3}{y}_{3}\\end{aligned}\n$$\n\nThen, the corresponding matrix of the bilinear form is\n\n$$\n[\\begin{aligned}0 & 1 & 0 \\\\ 3 & 0 & 0 \\\\ 0 & -3 & 2\\end{aligned}].\n$$\n\nTherefore, $a=1,$ $b=3,$ and $c=2.$ Finally, \n\n$$\na+b+c=1+3+2=6.\n$$"}]}
