} \\\\  & =-6{b}_{2}+3{b}_{1} \\\\  & =-\\frac{6}{5}(5{b}_{2})-\\frac{3}{2}(-2{b}_{1}) \\\\  & =-\\frac{6}{5}{c}_{1}-\\frac{3}{2}{c}_{2}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}-\\frac{6}{5} \\\\ -\\frac{3}{2}\\end{aligned}].$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-35257/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "29b27833-e930-5339-89b3-c5651d791dcd"] :knowledge-point/questions ["q-35257"] :db/ensure [:knowledge-point/validate]} {:db/id "q-112639/selection/bd53f54f196cb7ef2fea33bc8b4ad3d5ddf8f55dfde6596b838ee6e8e9512f9e" :answer/id #uuid "a0d90e71-43ce-5c52-adc3-97d147851ad8" :answer/type :answer.type/math :answer/value "[x]_{B}=[\\begin{aligned}9 \\\\ \\frac{1}{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-112639/selection/e5e3f153e1acdb95f030758785d2f39809d69bc01313083b27414c8a337fd82e" :answer/id #uuid "dc9dad9a-fa23-5dcb-aeaa-72fcd672d533" :answer/type :answer.type/math :answer/value "[x]_{B}=[\\begin{aligned}3 \\\\ 2\\end{aligned}]." :db/ensure [:answer/validate]} {:db/id "q-112639/selection/e64a64c734a0284f81cfe0a42be6b1eb178de592c2fade5b675021fef4200223" :answer/id #uuid "422ed304-e99c-5f65-ba96-4e650f5b5cff" :answer/type :answer.type/math :answer/value "[x]_{B}=[\\begin{aligned}\\frac{1}{2} \\\\ 3\\end{aligned}]." :db/ensure [:answer/validate]} {:db/id "q-112639/selection/fcb3274c216cb86e589ff203cece56b2b54b5aa834607b669d02e6647f10f818" :answer/id #uuid "11d556fc-538a-595c-86cb-9a46c7991b51" :answer/type :answer.type/math :answer/value "[x]_{B}=[\\begin{aligned}2 \\\\ 9\\end{aligned}]." :db/ensure [:answer/validate]} {:db/id "q-112639/selection/55f61d5702b350173f8b5748cf7a58169f58deacd97ee05140f91b452db3eb41" :answer/id #uuid "1a04de8f-3dfe-5d66-9d7b-bafab822ccf1" :answer/type :answer.type/math :answer/value "[x]_{B}=[\\begin{aligned}\\frac{1}{9} \\\\ 2\\end{aligned}]." :db/ensure [:answer/validate]} {:db/id "q-112639/selection" :answer-field/id #uuid 