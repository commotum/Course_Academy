election/ef9a3f1f1246e6f49b4054f43041218feb27a85bbf302e147d535019a4aae15b" "q-80826/selection/612b8a8ec91d34a7c19b79238d124859721b2a6addcd050978a4c4a77f014cef" "q-80826/selection/f2b0379726e8513d4e43436a5f44b35fe1690f8212c64ce86503183863bb5bbc" "q-80826/selection/e1b71b92f3621365fb51a1293b5a6c2993ab42b3984f5912b9224189452cec24"] :db/ensure [:answer-field/validate]} {:db/id "q-80826" :question/id #uuid "0fc3b741-d40b-5c43-a5b2-8fe80dfda5f5" :question/math-academy-id "q-80826" :question/problem "Let $B={{b}_{1},{b}_{2}}$ be a basis of ${R}^{2}$ and $[x]_{B}=[\\begin{aligned}1 \\\\ -7\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C={{c}_{1},{c}_{2}},$ where ${c}_{1}=4{b}_{1}+{b}_{2}$ and ${c}_{2}=2{b}_{1}?$" :question/worked-solution "We are given that\n\n$$\n{\\begin{aligned}{c}_{1}=4{b}_{1}+{b}_{2} \\\\ {c}_{2}=2{b}_{1}.\\end{aligned}\n$$\n\nFirst, we express the $b$'s in terms of $c$'s. From the second equation, we get \n\n$$\n{b}_{1}=\\frac{1}{2}{c}_{2}.\n$$\n\nSubstituting this into the first equation, we obtain\n\n$$\n{c}_{1}=4(\\frac{1}{2}{c}_{2})+{b}_{2}\\,⟹\\,{b}_{2}={c}_{1}-2{c}_{2}.\n$$\n\nSince $[x]_{B}=[\\begin{aligned}1 \\\\ -7\\end{aligned}]$, we can write the vector $x$ as follows:\n\n$$\n\\begin{aligned}x & ={b}_{1}-7{b}_{2} \\\\  & =\\frac{1}{2}{c}_{2}-7({c}_{1}-2{c}_{2}) \\\\  & =\\frac{1}{2}{c}_{2}-7{c}_{1}+14{c}_{2} \\\\  & =-7{c}_{1}+\\frac{29}{2}{c}_{1}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}-7 \\\\ \\frac{29}{2}\\end{aligned}].$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-80826/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e568b6fc-88f0-592b-a24d-e3286cfa5043"] :knowledge-point/questions ["q-80826"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81229/selection/8b2042fbbf78b13a4006a314660528b8bbd5b5309a7e476ea0ab07c4cf2a6d6f" :answer/id #uuid "abc40be0-fea0-59ac-8fc4-9dc040139697" :answer/type :answer.type/math :answer/value "[