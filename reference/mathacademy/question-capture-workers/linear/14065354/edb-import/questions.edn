#{[{:db/id #edb/ref 17592186119561 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "29b27833-e930-5339-89b3-c5651d791dcd" :knowledge-point/title "Writing a Two-Dimensional Vector in a Different Basis"}] :question/id #uuid "6a082146-0d63-59dd-9224-a319d73ca59c" :question/math-academy-id "e-4827" :question/problem "Let $\\mathcal{B}= \\left\\{\\mathbf{b}_1, \\mathbf{b}_2 \\right\\}$ be a basis of $\\mathbb{R}^2$ and $\\begin{bmatrix}5 \\\\ -2\\end{bmatrix}$ What are the coordinates of $\\mathbf{x}$ relative to the basis $\\mathcal{C}= \\left\\{\\mathbf{c}_1, \\mathbf{c}_2 \\right\\}$, where $\\mathbf{c}_1 = -\\mathbf{b}_2$ and $\\mathbf{c}_2 = -3\\mathbf{b}_1$?" :question/worked-solution "Since $\\begin{bmatrix}5 \\\\ -2\\end{bmatrix}$ we can write $\\mathbf{x}$ in terms of the vectors $\\mathbf c_1$ and $\\mathbf c_2$, as follows:\n\n$$\n\\begin{aligned}\nx &= 5b_{1} - 2b_{2} \\\\\n&=-2b_{2} + 5b_{1} \\\\\n&= 2(-b_{2}) - \\frac{5}{3}(-3b_{1}) \\\\\n&= 2c_{1} - \\frac{5}{3}c_{2}\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{bmatrix}2 \\\\ -\\frac{5}{3}\\end{bmatrix}\n$$"}] [{:db/id #edb/ref 17592186119562 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "df96d21a-e1bc-5a9b-b528-d6e7b30d8451" :knowledge-point/title "Writing a Three-Dimensional Vector in a Different Basis"}] :question/id #uuid "f07356b8-aeb3-50ac-b017-c370d87395d2" :question/math-academy-id "e-4828" :question/problem "Let $\\mathcal{B}= \\left\\{\\mathbf{b}_1, \\mathbf{b}_2,\\mathbf{b}_3 \\right\\}$ be a basis of $\\mathbb{R}^3$ and $\\begin{bmatrix}-2 \\\\ -3 \\\\ 5\\end{bmatrix}$ What are the coordinates of $\\mathbf{x}$ relative to the basis $\\mathcal{C}= \\left\\{\\mathbf{c}_1, \\mathbf{c}_2, \\mathbf{c}_3 \\right\\}$, where $\\mathbf{c}_1 = -3\\mathbf{b}_2$, $\\mathbf{c}_2=-\\mathbf{b}_3$, and $\\mathbf{c}_3 = -4\\mathbf{b}_1$?" :question/worked-solution "Since $\\begin{bmatrix}-2 \\\\ -3 \\\\ 5\\end{bmatrix}$ we can write $\\mathbf{x}$ in terms of the vectors $\\mathbf c_1, \\mathbf c_2$, and $\\mathbf c_3$, as follows:\n\n$$\n\\begin{aligned}\nx &= -2b_{1} - 3b_{2} + 5b_{3} \\\\\n&=-3b_{2} + 5b_{3} - 2b_{1} \\\\\n&= (-3b_{2}) - 5(-b_{3}) + \\frac{1}{2}(-4b_{1}) \\\\\n&= c_{1} - 5c_{2} + \\frac{1}{2}c_{3}\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{bmatrix}1 \\\\ -5 \\\\ \\frac{1}{2}\\end{bmatrix}\n$$"}] [{:db/id #edb/ref 17592186119563 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "e568b6fc-88f0-592b-a24d-e3286cfa5043" :knowledge-point/title "Writing a Vector in a Different Basis Given a Linear Relationship Between Two Bases"}] :question/id #uuid "91fac4cd-7097-5244-a385-9f3f76395912" :question/math-academy-id "e-4829" :question/problem "Let $\\mathcal{B}= \\left\\{\\mathbf{b}_1, \\mathbf{b}_2 \\right\\}$ be a basis of $\\mathbb{R}^2$ and $\\begin{bmatrix}1 \\\\ -3\\end{bmatrix}$ What are the coordinates of $\\mathbf{x}$ relative to the basis $\\mathcal{C}= \\left\\{\\mathbf{c}_1, \\mathbf{c}_2 \\right\\}$, where $\\mathbf{c}_1 = \\mathbf{b}_2-\\mathbf{b}_1$ and $\\mathbf{c}_2 = 2\\mathbf{b}_1 - 3\\mathbf{b}_2$?" :question/worked-solution "We are given that\n\n$$\n{c_{1} = b_{2} - b_{1}; c_{2} = 2b_{1} - 3b_{2}\n$$\n\nFirst, we express the $\\mathbf{b}$'s in terms of $\\mathbf{c}$'s. Multiplying the first equation by $2$ and adding the equations, we get\n\n$$\n2\\mathbf{c}_1+\\mathbf{c}_2 = -\\mathbf{b}_2 \\qquad\\Longrightarrow\\qquad \\mathbf{b}_2 = -2\\mathbf{c}_1-\\mathbf{c}_2\n$$\n\nSubstituting this into the first equation, we obtain\n\n$$\n\\mathbf{c}_1 = \\left(-2\\mathbf{c}_1-\\mathbf{c}_2 \\right) - \\mathbf{b}_1 \\qquad\\Longrightarrow\\qquad \\mathbf{b}_1 = -3\\mathbf{c}_1-\\mathbf{c}_2\n$$\n\nSince $\\begin{bmatrix}1 \\\\ -3\\end{bmatrix}$ we can write the vector $\\mathbf{x}$ in terms of the vectors $\\mathbf c_1$ and $\\mathbf c_2$, as follows:\n\n$$\n\\begin{aligned}\nx &= b_{1} - 3b_{2} \\\\\n&= (-3c_{1} - c_{2}) - 3(-2c_{1} - c_{2}) \\\\\n&=-3c_{1} - c_{2} + 6c_{1} + 3c_{2} \\\\\n&= 3c_{1} + 2c_{2}\n\\end{aligned}\n$$\n\nTherefore, $\\begin{bmatrix}3 \\\\ 2\\end{bmatrix}$"}] [{:db/id #edb/ref 17592186120292 :knowledge-point/_questions [{:knowledge-point/id #uuid "29b27833-e930-5339-89b3-c5651d791dcd" :knowledge-point/title "Writing a Two-Dimensional Vector in a Different Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d1e8a600-9151-5322-a624-c736529094b1" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{B} = \\begin{bmatrix}2 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186118228} {:answer/id #uuid "d3bfd622-aa31-557d-8639-b6572be8d8e2" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{B} = \\begin{bmatrix}-1 \\\\ \\frac{2}{3}\\end{bmatrix}" :db/id #edb/ref 17592186118229} {:answer/id #uuid "efb0bc02-ee7d-57f0-a0d7-6faefef6479f" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{B} = \\begin{bmatrix}2 \\\\ \\frac{1}{3}\\end{bmatrix}" :db/id #edb/ref 17592186118230} {:answer/id #uuid "0a844c21-c797-5d0a-a2b0-db81d329d8b4" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{B} = \\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186118231} {:answer/id #uuid "0c8bfb46-028b-506b-b40a-c09a722d6f84" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{B} = \\begin{bmatrix}\\frac{1}{3} \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186118232}] :answer-field/correct {:answer/id #uuid "efb0bc02-ee7d-57f0-a0d7-6faefef6479f" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{B} = \\begin{bmatrix}2 \\\\ \\frac{1}{3}\\end{bmatrix}" :db/id #edb/ref 17592186118230} :answer-field/id #uuid "21c22a27-4aa4-5698-b262-df2fe24871c8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186118227}] :question/id #uuid "336edbee-8e37-5f76-9b04-8490bfd6d48b" :question/math-academy-id "q-34769" :question/problem "Let $C = {c_{1}, c_{2}}$ be a basis of $R^{2}$ and $[x]_{C} = \\begin{bmatrix}1 \\\\ -2\\end{bmatrix}$. What are the coordinates of $x$ relative to the basis $B = {b_{1}, b_{2}}$, where $b_{1} =-c_{2}$ and $b_{2} = 3c_{1}$?"}] [{:db/id #edb/ref 17592186120293 :knowledge-point/_questions [{:knowledge-point/id #uuid "df96d21a-e1bc-5a9b-b528-d6e7b30d8451" :knowledge-point/title "Writing a Three-Dimensional Vector in a Different Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a3720fe-1f9d-5a61-bcce-e81d4b66cd2a" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C} = \\begin{bmatrix}\\frac{5}{2} \\\\ 2 \\\\ -\\frac{4}{3}\\end{bmatrix}" :db/id #edb/ref 17592186118234} {:answer/id #uuid "acf4f778-9308-5778-90f1-6d1600456f82" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C} = \\begin{bmatrix}\\frac{2}{5} \\\\ 2 \\\\ -\\frac{3}{4}\\end{bmatrix}" :db/id #edb/ref 17592186118235} {:answer/id #uuid "d1effe0e-a9c7-5763-91e6-c341017976d5" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C} = \\begin{bmatrix}\\frac{5}{2} \\\\ 2 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186118236} {:answer/id #uuid "d97a6241-a8f4-5afb-9834-fd157728c9aa" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C} = \\begin{bmatrix}5 \\\\ 2 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186118237} {:answer/id #uuid "1dee65e4-588d-5cd5-8944-010e0c6f2a7c" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C} = \\begin{bmatrix}5 \\\\ 2 \\\\ -\\frac{4}{3}\\end{bmatrix}" :db/id #edb/ref 17592186118238}] :answer-field/correct {:answer/id #uuid "8a3720fe-1f9d-5a61-bcce-e81d4b66cd2a" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C} = \\begin{bmatrix}\\frac{5}{2} \\\\ 2 \\\\ -\\frac{4}{3}\\end{bmatrix}" :db/id #edb/ref 17592186118234} :answer-field/id #uuid "98373713-894f-568c-839d-f51bfe5d4956" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186118233}] :question/id #uuid "8db838b1-f0b2-5003-b1ee-a4f1dfa03764" :question/math-academy-id "q-34770" :question/problem "Let $B = {b_{1}, b_{2}, b_{3}}$ be a basis of $R^{3}$ and $[x]_{B} = \\begin{bmatrix}4 \\\\ -5 \\\\ 2\\end{bmatrix}$. What are the coordinates of $x$ relative to the basis $C = {c_{1}, c_{2}, c_{3}}$, where $c_{1} =-2b_{2}$, $c_{2} = b_{3}$ and $c_{3} =-3b_{1}$?"}]}
