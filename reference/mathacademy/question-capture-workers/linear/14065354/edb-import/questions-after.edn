Between Two Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0acf494d-609d-5697-811a-c819c22e76d2" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{29}{2} \\\\ -7\\end{aligned}]" :db/id #edb/ref 17592186350082} {:answer/id #uuid "55b88357-5aca-5c61-a4c3-ef04c2ce91a4" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-7 \\\\ 29\\end{aligned}]" :db/id #edb/ref 17592186350083} {:answer/id #uuid "fd9bd13c-b1a7-56b4-9861-3a1ee2219d75" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}7 \\\\ \\frac{29}{2}\\end{aligned}]" :db/id #edb/ref 17592186350084} {:answer/id #uuid "8ba771c8-96ba-5817-a13b-1e8a67ed22c8" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}7 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186350085} {:answer/id #uuid "ec13e888-d0d6-5f99-8dbe-6e8ef1fb5e9d" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-7 \\\\ \\frac{29}{2}\\end{aligned}]" :db/id #edb/ref 17592186350086}] :answer-field/correct {:answer/id #uuid "ec13e888-d0d6-5f99-8dbe-6e8ef1fb5e9d" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-7 \\\\ \\frac{29}{2}\\end{aligned}]" :db/id #edb/ref 17592186350086} :answer-field/id #uuid "3a63eb61-f612-5935-8f68-057cc8573203" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350081}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0fc3b741-d40b-5c43-a5b2-8fe80dfda5f5" :question/math-academy-id "q-80826" :question/problem "Let $B={{b}_{1},{b}_{2}}$ be a basis of ${R}^{2}$ and $[x]_{B}=[\\begin{aligned}1 \\\\ -7\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C={{c}_{1},{c}_{2}},$ where ${c}_{1}=4{b}_{1}+{b}_{2}$ and ${c}_{2}=2{b}_{1}?$" :question/worked-solution "We are given that\n\n$$\n{\\begin{aligned}{c}_{1}=4{b}_{1}+{b}_{2} \\\\ {c}_{2}=2{b}_{1}.\\end{aligned}\n$$\n\nFirst, we express the $b$'s in terms of $c$'s. From the second equation, we get \n\n$$\n{b}_{1}=\\frac{1}{2}{c}_{2}.\n$$\n\nSubstituting this into the first equation, we obtain\n\n$$\n{c}_{1}=4(\\frac{1}{2}{c}_{2})+{b}_{2}\\,⟹\\,{b}_{2}={c}_{1}-2{c}_{2}.\n$$\n\nSince $[x]_{B}=[\\begin{aligned}1 \\\\ -7\\end{aligned}]$, we can write the vector $x$ as follows:\n\n$$\n\\begin{aligned}x & ={b}_{1}-7{b}_{2} \\\\  & =\\frac{1}{2}{c}_{2}-7({c}_{1}-2{c}_{2}) \\\\  & =\\frac{1}{2}{c}_{2}-7{c}_{1}+14{c}_{2} \\\\  & =-7{c}_{1}+\\frac{29}{2}{c}_{1}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}-7 \\\\ \\frac{29}{2}\\end{aligned}].$"}] [{:db/id #edb/ref 17592186350087 :knowledge-point/_questions [{:knowledge-point/id #uuid "e568b6fc-88f0-592b-a24d-e3286cfa5043" :knowledge-point/title "Writing a Vector in a Different Basis Given a Linear Relationship Between Two Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b8f50825-c3b3-55f8-8e83-bdeeb17796e3" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}5 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186350089} {:answer/id #uuid "e18c26d7-ea65-5c8c-8610-d8a8c32c6390" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}3 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186350090} {:answer/id #uuid "8e4514f6-a1fb-51f5-a325-c1d8923a512b" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}3 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186350091} {:answer/id #uuid "ca0dc37d-b770-5eef-9e6c-e5b8db427989" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}3 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186350092} {:answer/id #uuid "699cda3c-4767-5ff1-b3ee-65ded4807f96" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}5 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186350093}] :answer-field/correct {:answer/id #uuid "8e4514f6-a1fb-51f5-a325-c1d8923a512b" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}3 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186350091} :answer-field/id #uuid "34a98386-b9ef-5b87-bb5a-1d645bb64037" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350088}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "fda7b684-3b39-5fc1-88de-29fdd05dbc36" :question/math-academy-id "q-80835" :question/problem "Let $B={{b}_{1},{b}_{2}}$ be a basis of ${R}^{2}$ and $[x]_{B}=[\\begin{aligned}2 \\\\ 1\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C={{c}_{1},{c}_{2}},$ where ${c}_{1}={b}_{1}+{b}_{2}$ and ${c}_{2}={b}_{1}+2{b}_{2}?$" :question/worked-solution "We are given that\n\n$$\n{\\begin{aligned}{c}_{1}={b}_{1}+{b}_{2} \\\\ {c}_{2}={b}_{1}+2{b}_{2}.\\end{aligned}\n$$\n\nFirst, we express the $b$'s in terms of $c$'s. Multiplying the second equation by $-1$ and adding the equations, we get \n\n$$\n{c}_{1}-{c}_{2}=-{b}_{2}\\,⟹\\,{b}_{2}={c}_{2}-{c}_{1}.\n$$\n\nSubstituting this into the first equation, we obtain\n\n$$\n{c}_{1}={b}_{1}+({c}_{2}-{c}_{1})\\,⟹\\,{b}_{1}=2{c}_{1}-{c}_{2}.\n$$\n\nSince $[x]_{B}=[\\begin{aligned}2 \\\\ 1\\end{aligned}]$, we can write the vector $x$ as follows:\n\n$$\n\\begin{aligned}x & =2{b}_{1}+{b}_{2} \\\\  & =2(2{c}_{1}-{c}_{2})+({c}_{2}-{c}_{1}) \\\\  & =4{c}_{1}-2{c}_{2}+{c}_{2}-{c}_{1} \\\\  & =3{c}_{1}-{c}_{2}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}3 \\\\ -1\\end{aligned}].$"}] [{:db/id #edb/ref 17592186350094 :knowledge-point/_questions [{:knowledge-point/id #uuid "e568b6fc-88f0-592b-a24d-e3286cfa5043" :knowledge-point/title "Writing a Vector in a Different Basis Given a Linear Relationship Between Two Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12d7535c-540a-52a8-b25a-d57f1317f03d" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}11 \\\\ -7\\end{aligned}]" :db/id #edb/ref 17592186350096} {:answer/id #uuid "d53e3b0c-86e8-5373-9ec4-4d247f2f2d6b" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}3 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186350097} {:answer/id #uuid "f750226d-f1d9-5666-9701-36d7b4700c40" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}4 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186350098} {:answer/id #uuid "2b3a0628-0911-584f-a9e7-6166fff8cbe4" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{13}{3} \\\\ -\\frac{5}{3}\\end{aligned}]" :db/id #edb/ref 17592186350099} {:answer/id #uuid "6c5691a1-f01a-593a-9f81-6885e8e7441a" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{5}{3} \\\\ \\frac{8}{3}\\end{aligned}]" :db/id #edb/ref 17592186350100}] :answer-field/correct {:answer/id #uuid "6c5691a1-f01a-593a-9f81-6885e8e7441a" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{5}{3} \\\\ \\frac{8}{3}\\end{aligned}]" :db/id #edb/ref 17592186350100} :answer-field/id #uuid "7b850130-9b94-533e-b114-2dec2846c1bc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350095}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "05cca5db-1496-5858-9cd6-f4db1975d817" :question/math-academy-id "q-80838" :question/problem "Let $B={{b}_{1},{b}_{2}}$ be a basis of ${R}^{2}$ and $[x]_{B}=[\\begin{aligned}6 \\\\ -1\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C={{c}_{1},{c}_{2}},$ where ${c}_{1}=2{b}_{1}+{b}_{2}$ and ${c}_{2}={b}_{1}-{b}_{2}?$" :question/worked-solution "We are given that\n\n$$\n{\\begin{aligned}{c}_{1}=2{b}_{1}+{b}_{2} \\\\ {c}_{2}={b}_{1}-{b}_{2}.\\end{aligned}\n$$\n\nFirst, we express the $b$'s in terms of $c$'s. Adding the equations, we get \n\n$$\n{c}_{1}+{c}_{2}=3{b}_{1}\\,⟹\\,{b}_{1}=\\frac{1}{3}{c}_{1}+\\frac{1}{3}{c}_{2}.\n$$\n\nSubstituting this into the first equation, we obtain\n\n$$\n{c}_{1}=2(\\frac{1}{3}{c}_{1}+\\frac{1}{3}{c}_{2})+{b}_{2}\\,⟹\\,{b}_{2}=\\frac{1}{3}{c}_{1}-\\frac{2}{3}{c}_{2}.\n$$\n\nSince $[x]_{B}=[\\begin{aligned}6 \\\\ -1\\end{aligned}]$, we can write the vector $x$ as follows:\n\n$$\n\\begin{aligned}x & =6{b}_{1}-{b}_{2} \\\\  & =6(\\frac{1}{3}{c}_{1}+\\frac{1}{3}{c}_{2})-(\\frac{1}{3}{c}_{1}-\\frac{2}{3}{c}_{2}) \\\\  & =2{c}_{1}+2{c}_{2}-\\frac{1}{3}{c}_{1}+\\frac{2}{3}{c}_{2} \\\\  & =\\frac{5}{3}{c}_{1}+\\frac{8}{3}{c}_{2}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}\\frac{5}{3} \\\\ \\frac{8}{3}\\end{aligned}].$"}] [{:db/id #edb/ref 17592186350101 :knowledge-point/_questions [{:knowledge-point/id #uuid "29b27833-e930-5339-89b3-c5651d791dcd" :knowledge-point/title "Writing a Two-Dimensional Vector in a Different Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ceceaf3a-8277-52ab-b8a7-6fe48a71fc17" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{B}=[\\begin{aligned}-5 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186350103} {:answer/id #uuid "5b8692d1-14fc-558b-86a9-bfd974684646" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{B}=[\\begin{aligned}\\frac{5}{2} \\\\ -\\frac{3}{5}\\end{aligned}]" :db/id #edb/ref 17592186350104} {:answer/id #uuid "8c80bb23-7ca3-5778-8543-1ac6f8c8401e" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{B}=[\\begin{aligned}\\frac{5}{2} \\\\ \\frac{3}{5}\\end{aligned}]" :db/id #edb/ref 17592186350105} {:answer/id #uuid "c321818e-a69c-50b8-882a-f16474896a41" :answer/type {:db/ident :answer.type/math} :answer/value "[x]_{B}=[\\begin{aligned}\\frac{3}{5} \\\\ \\frac{5}{2}\\end{aligned}]" :db/id #edb/ref 17592186350106} {:answer/id #uuid "ec9a1074-f347-5ae2-8b1a-