port/verification.json"} {"question" "q-81827" "field" "selection" "attribute" "answer/value" "value" [:answer.type/image "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/assets/d187f89ab21a36c6709422c48263541df1acc8568d436614502c001cf576b426.png"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/state.json" "file_sha256" "5f82fa702c211b046081b0fcaee8c5a347d50545af66c632d5e643818e7988a1" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "q-81827" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/image "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/assets/b4e5acb557d1b4fefa77f644d675723c84d5fa103888a6cb6b04372a57189c73.png"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/state.json" "file_sha256" "5f82fa702c211b046081b0fcaee8c5a347d50545af66c632d5e643818e7988a1" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "q-160643" "field" nil "attribute" "question/problem" "value" "A triangle $S$ has vertices at $(0,1),(-1,0),(-1,-2).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the counterclockwise rotation ${R}_{{270}^{∘}}$ by an angle of ${270}^{∘}$ about the origin?\n\n- $(1,0)$\n- $(0,-1)$\n- $(-2,1)$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/state.json" "file_sha256" "5f82fa702c211b046081b0fcaee8c5a347d50545af66c632d5e643818e7988a1" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "q-160643" "field" nil "attribute" "question/worked-solution" "value" "The counterclockwise rotation ${R}_{{270}^{∘}}$ by an angle of ${270}^{∘}$ is given by the matrix\n\n$$\nR=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}].\n$$\n\nTo find the image of $S$ under the action of ${R}_{{270}^{∘}},$ we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}0 & -1 & -1 \\\\ 1 & 0 & -2\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under ${R}_{{270}^{∘}}$ by calculating the matrix product $RX:$\n\n$$\n\\begin{aligned}RX & =[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}0 & -1 & -1 \\\\ 1 & 0 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 & -2 \\\\ 0 & 1 & 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(1,0),(0,1),(-2,1).$\n\nSo, the correct answer is \"I and III only.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/state.json" "file_sha256" "5f82fa702c211b046081b0fcaee8c5a347d50545af66c632d5e643818e7988a1" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "q-160643" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/activity-metadata.json" "file_sha256" "31c2feb4266eff72b427e01802c275f867994df67b826b638bbbd5094a9a83ca" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "q-160643" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/state.json" "file_sha25