#{[{:db/id #edb/ref 17592186293911 :knowledge-point/_questions [{:knowledge-point/id #uuid "1b86558a-4c99-5ccb-a100-719692a056f4" :knowledge-point/title "Using a Matrix That Represents a Rotation of 90 Degrees"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61129a8e-e817-555a-b8cc-c20f7bd58800" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186293913} {:answer/id #uuid "ad5b0ee2-7af1-5000-b95c-9787ca1087c5" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186293914} {:answer/id #uuid "317cb7f7-cd1c-5803-88fa-e4caf85faf2a" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186293915} {:answer/id #uuid "b5f75dfa-b784-5059-a491-313dfb65c162" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186293916} {:answer/id #uuid "bf7197e7-af48-5688-acbe-4eaf01deb432" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186293917}] :answer-field/correct {:answer/id #uuid "61129a8e-e817-555a-b8cc-c20f7bd58800" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186293913} :answer-field/id #uuid "0e1d7e5c-861f-50ad-96f8-5c1feba4e907" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186293912}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "8d8905ff-87fc-56b7-a3d8-d73cbc677520" :question/math-academy-id "q-160644" :question/problem "A triangle $S$ has vertices at $(2,-3),(3,1),(-4,-1).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the counterclockwise rotation ${R}_{{270}^{∘}}$ by an angle of ${270}^{∘}$ about the origin?\n\n- $(3,2)$\n- $(1,-3)$\n- $(-1,4)$" :question/worked-solution "The counterclockwise rotation ${R}_{{270}^{∘}}$ by an angle of ${270}^{∘}$ is given by the matrix\n\n$$\nR=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}].\n$$\n\nTo find the image of $S$ under the action of ${R}_{{270}^{∘}},$ we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}2 & 3 & -4 \\\\ -3 & 1 & -1\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under ${R}_{{270}^{∘}}$ by calculating the matrix product $RX:$\n\n$$\n\\begin{aligned}RX & =[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}2 & 3 & -4 \\\\ -3 & 1 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 1 & -1 \\\\ -2 & -3 & 4\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(-3,-2),(1,-3),(-1,4).$\n\nSo, the correct answer is \"II and III only.\""}]}
