49-2bec-59ba-91d8-3f26a5d1d9dd" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/4387/Source/Images/q-181987-a-4.png" :db/id #edb/ref 17592186195461} {:answer/id #uuid "123dada4-b1fa-58e4-9523-a85c56398af1" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/4387/Source/Images/q-181987-a-1.png" :db/id #edb/ref 17592186195462} {:answer/id #uuid "34a7d35a-8582-569d-a279-cf93880bbbc8" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/4387/Source/Images/q-181987-a-2.png" :db/id #edb/ref 17592186195463} {:answer/id #uuid "39ef5d1e-89e9-50ad-b865-5cb8beed15b0" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/4387/Source/Images/q-181987-a-5.png" :db/id #edb/ref 17592186195464} {:answer/id #uuid "611e76b4-a957-5ff1-8317-0bab4ca89c27" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/4387/Source/Images/q-181987-a-3.png" :db/id #edb/ref 17592186195465}] :answer-field/correct {:answer/id #uuid "123dada4-b1fa-58e4-9523-a85c56398af1" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/4387/Source/Images/q-181987-a-1.png" :db/id #edb/ref 17592186195462} :answer-field/id #uuid "35fa6e74-a2da-5824-8c02-9458dddb39ac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186195460}] :question/id #uuid "3bd0f51c-7480-5612-9de3-790f45702d19" :question/math-academy-id "q-181987" :question/problem "Which of the following is a representation of the set $S = {1, 2} \\cdot (-1, 1)$ in the Cartesian plane?"}]}
