3.png" :db/id #edb/ref 17592186307976} {:answer/id #uuid "1618ac54-f2d7-51e1-b09d-f50853ab917f" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/a1a9065f9dbb6648100bc6a22bff367916c241dc2eba5f3878d6cf1b9821d4e8.png" :db/id #edb/ref 17592186307977} {:answer/id #uuid "b41c35a5-9190-5679-b841-18c47510d67b" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/687ed490e4b4bf72689bc2da100a5ec01d4d853fbf9d1a5297cb288e40774d1e.png" :db/id #edb/ref 17592186307978} {:answer/id #uuid "75b5d04a-de74-5260-86c4-31a9c1808bbb" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/34770ca1c57cf00c5779a435dbbc72bf74e024433d8210ce0ea912a22f51008a.png" :db/id #edb/ref 17592186307979} {:answer/id #uuid "de74481f-1027-5cca-ad6f-e2cae2c3c17e" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/761e56f14b968a8485c5acf6c648fe04448d374d0f2375f0b5e473953262e958.png" :db/id #edb/ref 17592186307980}] :answer-field/correct {:answer/id #uuid "1618ac54-f2d7-51e1-b09d-f50853ab917f" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/a1a9065f9dbb6648100bc6a22bff367916c241dc2eba5f3878d6cf1b9821d4e8.png" :db/id #edb/ref 17592186307977} :answer-field/id #uuid "cf48689f-9c4b-56ab-b6bf-18fbfb5b6057" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307975}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a6d81b0a-f074-57c3-bc8c-0e04b7fc5a69" :question/math-academy-id "q-181960" :question/problem "Which of the following is a representation of the set $S=[0,2]\\times {-1,0,1}$ in the Cartesian plane?" :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\n$$\nA\\times B={(a,b)\\,:\\,a\\in A,\\,b\\in B}\n$$\n\nIn this case, the set \n\n$$\nS=[0,2]\\times {-1,0,1}\n$$\n\ncontains every point in ${R}^{2}$ whose $x$-coordinate is any real number in the interval $[0,2]$ and whose $y$-coordinate is either $-1,0,$ or $1.$\n\n$$\nS={(x,y)\\,:\\,x\\in [0,2],\\,y\\in {-1,0,1}}.\n$$\n\nTo visualize $S$, consider ${S}_{1}⊂S$ containing all points whose $x$-coordinate is any real number in the interval $[0,2]$ and whose $y$-coordinate equals $-1$\n\n$$\n{S}_{1}={(x,-1)\\,:\\,x\\in [0,2]}\n$$\n\nThis set is represented by the line segment shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/de9bd6dc79cabf8230b0cec26233958aa0fbb001875b9942cbb7f4d36e6b08fb.png)\n\nNext, consider ${S}_{2}⊂S$ containing all points whose $x$-coordinate is any real number in the interval $[0,2]$ and whose $y$-coordinate equals $0.$\n\n$$\n{S}_{2}={(x,0)\\,:\\,x\\in [0,2]}.\n$$\n\nThis set is represented by the line segment shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/819c31e4d29dbd3e18c7dea8df495a565d2ede866ec019c764704d6dc47f5c70.png)\n\nNow, consider ${S}_{3}⊂S$ containing all points whose $x$-coordinate is any real number in the interval $[0,2]$ and whose $y$-coordinate equals $1.$\n\n$$\n{S}_{3}={(x,1)\\,:\\,x\\in [0,2]}.\n$$\n\nThis set is represented by the line segment shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/3f335df98dc9cb33ccc96f87d24efa3bd78a4d4c271d0fbaf7ae5e8c30916d9e.png)\n\nOur Cartesian product is the *union* of these subsets:\n\n$$\nS={S}_{1}\\cup {S}_{2}\\cup {S}_{3}\n$$\n\nTherefore, $S$ can be represented by the three line segments shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/a1a9065f9dbb6648100bc6a22bff367916c241dc2eba5f3878d6cf1b9821d4e8.png)"}] [{:db/id #edb/ref 17592186307981 :knowledge-point/_questions [{:knowledge-point/id #uuid "e2aee319-68d6-54f7-8023-b24d32610bc4" :knowledge-point/title "Sketching Cartesian Products of Special Sets in the Coordinate Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cac57808-fb29-58a9-9a51-a3760b4bd0d3" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/8de1a050eed07445dd4a80be2809e275419238f72e098693bfc1642a9e714403.png" :db/id #edb/ref 17592186307983} {:answer/id #uuid "a88b7a69-8601-51e5-9537-bb47c7344882" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/2df87b90d770a5f2c0ba40a55330409d1cd80866b7e34299eab6dcbf675c6a13.png" :db/id #edb/ref 17592186307984} {:answer/id #uuid "23046aa2-d99e-59b1-8d64-e4267ed8eb2c" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/de19fcf0f246b09d4bb957568e026b36de3f55c1a6c7065d79faacee794a8326.png" :db/id #edb/ref 17592186307985} {:answer/id #uuid "8c233025-4185-5730-914f-157508544a3e" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/463ae2387423a48dd557af8cfd9b01b6bc08b95f1b3c2f337c6b0c53d3731fa2.png" :db/id #edb/ref 17592186307986} {:answer/id #uuid "99819f3d-1733-5f29-936f-25f43d428cc3" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/80c13426f812f1e98b0ffd61d81eeb7c70a04c5013625d6e6d2add5f2d4a6d85.png" :db/id #edb/ref 17592186307987}] :answer-field/correct {:answer/id #uuid "23046aa2-d99e-59b1-8d64-e4267ed8eb2c" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/de19fcf0f246b09d4bb957568e026b36de3f55c1a6c7065d79faacee794a8326.png" :db/id #edb/ref 17592186307985} :answer-field/id #uuid "74dbbc93-a894-5a25-a86e-42a3bfff7df8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307982}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "241c59ff-21cb-5099-884b-4ec060248a86" :question/math-academy-id "q-181966" :question/problem "Which of the following is a representation of the set $S=Z\\times Z$ in the Cartesian plane?" :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\n$$\nA\\times B={(a,b)\\,:\\,a\\in A,\\,b\\in B}\n$$\n\nIn this case, the set \n\n$$\nS=Z\\times Z\n$$\n\ncontains every point in ${R}^{2}$ whose $x$-coordinate is an integer number and whose $y$-coordinate is an integer number.\n\n$$\nS={(x,y)\\,:\\,x\\in Z,\\,y\\in Z}.\n$$\n\nTo visualize $S$, consider ${S}_{-1}⊂S$ containing all points whose $x$-coordinate equals $-1$ and whose $y$-coordinate is any integer number.\n\n$$\n{S}_{-1}={(-1,y)\\,:\\,y\\in Z}.\n$$\n\nWe can represent ${S}_{-1}$ in the plane as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/9673951b4e72ba503e740369462f9e528e43ffc083706ee558ade7ccd52702f5.png)\n\nNext, consider ${S}_{0}⊂S$ containing all points whose $x$-coordinate equals $0$ and whose $y$-coordinate is any integer number.\n\n$$\n{S}_{0}={(0,y)\\,:\\,y\\in Z}.\n$$\n\nWe can represent ${S}_{0}$ in the plane as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/797b66a293eb241f841869abe97e324f4301907f71029acceefd68487bef1b4f.png)\n\nWe can create the subsets $…,{S}_{-3},{S}_{-2},{S}_{1},{S}_{2},{S}_{3},…$ similarly. Our Cartesian product $S$ is the *union* of these subsets:\n\n$$\n\\begin{aligned}S & =…\\cup {S}_{-3}\\cup {S}_{-2}\\cup {S}_{-1}\\cup {S}_{0}\\cup {S}_{1}\\cup \\text{ }{S}_{2}\\cup {S}_{3}… \\\\  & ={⋃}_{i\\in Z}{S}_{i}\\end{aligned}\n$$\n\nTherefore, we can visualize $Z\\times Z$ as the set of points in the diagram below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/de19fcf0f246b09d4bb957568e026b36de3f55c1a6c7065d79faacee794a8326.png)"}] [{:db/id #edb/ref 17592186307988 :knowledge-point/_questions [{:knowledge-point/id #uuid "6290e701-b4ea-5a86-ab7e-7371c5bdc11e" :knowledge-point/title "Visualizing Unions of Uncountable Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44402000-6bb8-5f16-9dd2-72fdf1784cca" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/e5b130683075dd04e4b5129065d32b4d75b3dabfaff0b05b90de858b5e0f2961.png" :db/id #edb/ref 17592186307990} {:answer/id #uuid "db102bdb-40c9-5f2e-9db6-1e84772de75d" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/3332464bdc0583c6ce99bf126805abaf57461e67aee6bdf12c95e11042baf9c6.png" :db/id #edb/ref 17592186307991} {:answer/id #uuid "6340ae68-198d-5d52-acec-5a8dd175241e" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/288ca0010ecc1fada05a67637b583a6e86b7f805d4e272e91563a13c18fc164a.png" :db/id #edb/ref 17592186307992} {:answer/id #uuid "51d59392-c69f-5fd5-97ae-5af166ca26cc" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/96a29779da824d7d2dc7b6d4f2b9c781a4a593b58e44f491724221c77888e3e3.png" :db/id #edb/ref 17592186307993} {:answer/id #uuid "3619e446-a9ce-5195-9ca5-304cc1554281" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/97a74b119ddb8a618d6564bc077d03a5a4ceb7152702beb3682f2eab1a436b70.png" :db/id #edb/ref 17592186307994}] :answer-field/correct {:answer/id #uuid "3619e446-a9ce-5195-9ca5-304cc1554281" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/97a74b119ddb8a618d6564bc077d03a5a4ceb7152702beb3682f2eab1a436b70.png" :db/id #edb/ref 17592186307994} :answer-field/id #uuid "88441877-1369-58f7-9883-48348cde2398" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307989}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c70aae50-ffb5-59f2-930c-cbbe5d9bb642" :question/math-academy-id "q-181985" :question/problem "Which of the following is a representation of the set $S=[-1,0]\\times [-1,1]$ in the Cartesian plane?" :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\n$$\nA\\times B={(a,b)\\,:\\,a\\in A,\\,b\\in B}\n$$\n\nIn this case, the set\n\n$$\nS=[-1,0]\\times [-1,1]\n$$\n\ncontains every point in ${R}^{2}$ whose $x$-coordinate is any real number in the interval $[-1,0]$ and whose $y$-coordinate is any real number in the interval $[-1,1].$\n\n$$\nS={(x,y)\\,:\\,x\\in [-1,0],\\,y\\in [-1,1]}.\n$$\n\nTo visualize $S$, consider ${S}_{0}⊂S$ containing all points whose $x$-coordinate equals $0$ and whose $y$-coordinate is any real number in the interval $[-1,1].$\n\n$$\n{S}_{0}={(0,y)\\,:\\,y\\in [-1,1]}\n$$\n\nWe can represent ${S}_{0}$ in the plane as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/c93f3ad399b88ccbaac990f8f73e93cfdcb1192f52b9b12f2d3ce178776fa13b.png)\n\nNow, consider a general ${S}_{i}⊂S$ containing all points whose $x$-coordinate equals some $i\\in [-1,0]$ and whose $y$-coordinate is any real number in the interval $[-1,1].$\n\n$$\n{S}_{i}={(i,y)\\,:\\,y\\in [-1,1]}\n$$\n\nFor each $i\\in [-1,0],$ ${S}_{i}$ is a vertical line segment from the point $(i,-1)$ to the point $(i,1).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/6557201d202a401a92ee37c9a69eab9ab6ab87c6342dbb9d2afebae30141346f.png)\n\nOur Cartesian product $S$ is the union of these subsets over $I=[-1,0]:$\n\n$$\nS={⋃}_{i\\in I}{S}_{i}.\n$$\n\nAs $i$ runs over $I,$ these line segments sweep the following rectangle that represents the union ${⋃}_{i\\in I}{S}_{i}:$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/97a74b119ddb8a618d6564bc077d03a5a4ceb7152702beb3682f2eab1a436b70.png)"}] [{:db/id #edb/ref 17592186307995 :knowledge-point/_questions [{:knowledge-point/id #uuid "6290e701-b4ea-5a86-ab7e-7371c5bdc11e" :knowledge-point/title "Visualizing Unions of Uncountable Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dab77a87-45d7-5974-b2be-638f5741fd76" :answer/type {:db/ident :answer.type/image} :answer/value 