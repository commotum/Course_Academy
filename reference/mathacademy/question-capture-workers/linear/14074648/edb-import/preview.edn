{10} \\\\ 0\\end{aligned}]+{x}_{2}[\\begin{aligned}\\frac{1}{3} \\\\ 1\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nTherefore, we have\n\n$$\n-10a+\\frac{6b}{c}=-10\\cdot (-\\frac{3}{10})+\\frac{6\\cdot (\\frac{1}{3})}{1}=5.\n$$" 13194139536047 true] [17592186380876 1000 #edb/ref 17592186380877 13194139536047 true] [17592186380876 1000 #edb/ref 17592186380878 13194139536047 true] [17592186380876 1000 #edb/ref 17592186380879 13194139536047 true] [17592186380876 1000 #edb/ref 17592186380880 13194139536047 true] [17592186380876 1000 #edb/ref 17592186380881 13194139536047 true] [17592186380876 1040 #edb/ref 17592186045450 13194139536047 true] [17592186380876 1041 "selection" 13194139536047 true] [17592186380876 1104 #edb/ref 17592186380881 13194139536047 true] [17592186380876 1110 #uuid "eb8cb891-a6e3-568c-9946-ef9f6177f598" 13194139536047 true] [17592186380877 1034 "\\frac{3}{10}" 13194139536047 true] [17592186380877 1103 #edb/ref 17592186045453 13194139536047 true] [17592186380877 1111 #uuid "e0c546f8-9329-56af-bbd2-bf11daf44b12" 13194139536047 true] [17592186380878 1034 "7" 13194139536047 true] [17592186380878 1103 #edb/ref 17592186045453 13194139536047 true] [17592186380878 1111 #uuid "81445d13-7bb5-5334-a54f-bebd7ac1929c" 13194139536047 true] [17592186380879 1034 "6" 13194139536047 true] [17592186380879 1103 #edb/ref 17592186045453 13194139536047 true] [17592186380879 1111 #uuid "a3fc0537-4156-5e37-b150-584ca846a703" 13194139536047 true] [17592186380880 1034 "\\frac{1}{3}" 13194139536047 true] [17592186380880 1103 #edb/ref 17592186045453 13194139536047 true] [17592186380880 1111 #uuid "6203dd2d-7540-5bf0-89d9-3e6de19c8b00" 13194139536047 true] [17592186380881 1034 "5" 13194139536047 true] [17592186380881 1103 #edb/ref 17592186045453 13194139536047 true] [17592186380881 1111 #uuid "7f58dd33-5108-5802-a32d-22af9721f427" 13194139536047 true] [17592186380882 1017 #edb/ref 17592186380883 13194139536047 true] [17592186380882 1089 "q-40927" 13194139536047 true] [17592186380882 1091 #edb/ref 17592186045463 13194139536047 true] [17592186380882 1100 "$$\nA=[\\begin{aligned}2 & -4 \\\\ 1 & -2 \\\\ -5 & 10\\end{aligned}],\\,b=[\\begin{aligned}-3 \\\\ 1 \\\\ 2\\end{aligned}].\n$$\n\nConsider the matrix $A$ and vector $b$ shown above. If the general least-squares solution of $Ax=b$ is \n\n$$\n[\\begin{aligned}a \\\\ 0\\end{aligned}]+{x}_{2}[\\begin{aligned}b \\\\ c\\end{aligned}],\\,{x}_{2}\\in R,\n$$\n\nwhat is the value of $-2a+\\frac{b}{c}?$" 13194139536047 true] [17592186380882 1113 #uuid "ddc4d719-e103-5cb7-a726-54a80444ed51" 13194139536047 true] [17592186380882 1145 "The least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}\\,Ax={A}^{T}b\n$$\n\nNotice that the columns of $A$ are linearly dependent. So first, let's write down the normal equation in matrix form:\n\n$$\n\\begin{aligned}[\\begin{aligned}2 & 1 & -5 \\\\ -4 & -2 & 10\\end{aligned}][\\begin{aligned}2 & -4 \\\\ 1 & -2 \\\\ -5 & 10\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}2 & 1 & -5 \\\\ -4 & -2 & 10\\end{aligned}][\\begin{aligned}-3 \\\\ 1 \\\\ 2\\end{aligned}] \\\\ [\\begin{aligned}30 & -60 \\\\ -60 & 120\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}-15 \\\\ 30\\end{aligned}]\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the above matrix equation using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -2 & -\\frac{1}{2} \\\\ -2 & 4 & 1\\end{aligned}] & {R}_{2}:={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & -\\frac{1}{2} \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we have \n\n$$\n{x}_{1}=-\\frac{1}{2}+2{x}_{2}.\n$$\n\n Hence, the general solution is\n\n$$\n[\\begin{aligned}-\\frac{1}{2}+2{x}_{2} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}-\\frac{1}{2} \\\\ 0\\end{aligned}]+{x}_{2}[\\begin{aligned}2 \\\\ 1\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nTherefore, we have\n\n$$\n-2a+\\frac{b}{c}=-2\\cdot (-\\frac{1}{2})+\\frac{2}{1}=3.\n$$" 13194139536047 true] [17592186380883 1000 #edb/ref 17592186380884 13194139536047 true] [17592186380883 1000 #edb/ref 17592186380885 13194139536047 true] [17592186380883 1000 #edb/ref 17592186380886 13194139536047 true] [17592186380883 1000 #edb/ref 17592186380887 13194139536047 true] [17592186380883 1000 #edb/ref 17592186380888 13194139536047 true] [17592186380883 1040 #edb/ref 17592186045450 13194139536047 true] [17592186380883 1041 "selection" 13194139536047 true] [17592186380883 1104 #edb/ref 17592186380884 13194139536047 true] [17592186380883 1110 #uuid "68a50524-9ce1-5fe4-ad4a-db5985d781b5" 13194139536047 true] [17592186380884 1034 "3" 13194139536047 true] [17592186380884 1103 #edb/ref 17592186045453 13194139536047 true] [17592186380884 1111 #uuid "211875f2-b3d1-57c4-b207-64c0ed73e4eb" 13194139536047 true] [17592186380885 1034 "1" 13194139536047 true] [17592186380885 1103 #edb/ref 17592186045453 13194139536047 true] [17592186380885 1111 #uuid "75a0a7d2-127d-5220-bfe4-2fde58dc6d9a" 13194139536047 true] [17592186380886 1034 "-4" 13194139536047 true] [17592186380886 1103 #edb/ref 17592186045453 13194139536047 true] [17592186380886 1111 #uuid "0676778f-0861-50d7-899c-c78aa3d50b98" 13194139536047 true] [17592186380887 1034 "0" 13194139536047 true] [17592186380887 1103 #edb/ref 17592186045453 13194139536047 true] [17592186380887 1111 #uuid "a96219e1-7cb4-5a9f-897f-e71018443a3e" 13194139536047 true] [17592186380888 1034 "5" 13194139536047 true] [17592186380888 1103 #edb/ref 17592186045453 13194139536047 true] [17592186380888 1111 #uuid "a9630fea-21bf-5eb0-a0ef-5d441136993e" 13194139536047 true]] :edb/tempids {"q-137097" 17592186380868 "q-137097/selection" 17592186380869 "q-137097/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" 17592186380870 "q-137097/selection/954f2b2ecf089f1c