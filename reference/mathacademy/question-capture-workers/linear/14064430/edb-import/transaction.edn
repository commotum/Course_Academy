aligned}4 \\\\ 8 \\\\ 7\\end{aligned}]=[\\begin{aligned}0 \\\\ 0\\end{aligned}]=0\\,✓ \\\\ A{b}_{3} & =[\\begin{aligned}3 & -5 & 4 \\\\ 6 & -10 & 8\\end{aligned}][\\begin{aligned}-4 \\\\ -3 \\\\ 1\\end{aligned}]=[\\begin{aligned}7 \\\\ 14\\end{aligned}]\\ne 0\\,\\times \\end{aligned}\n$$\n\nTherefore, only ${b}_{2}$ lies in $\\text{Null}(A).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-34361/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e3c3466c-dfb0-5b5f-b556-ce57a1d78519"] :knowledge-point/questions ["q-34361"] :db/ensure [:knowledge-point/validate]} {:db/id "q-111091/selection/f12c94618fbd28b16f991f5fd9091068b5a931d8080395d53712da0d57bd9de8" :answer/id #uuid "1af731e9-5c02-596e-a975-2c1841af3501" :answer/type :answer.type/text :answer/value "${b}_{1}$ and ${b}_{2}$ only" :db/ensure [:answer/validate]} {:db/id "q-111091/selection/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25" :answer/id #uuid "88f638b4-4824-52d0-ab2b-594d9009fd10" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id "q-111091/selection/02550eeed44ec93329a8764c9ef60cdd40cdacf7ff3c44dd51b8effbfddd2eb1" :answer/id #uuid "7dab1407-7408-56a1-8d78-39e2b49774ea" :answer/type :answer.type/text :answer/value "${b}_{2}$ only" :db/ensure [:answer/validate]} {:db/id "q-111091/selection/00e911a728c661733ab7b561a1d5c54093301790498c550bb929830af11828f0" :answer/id #uuid "fb2e96e2-da62-5903-b3e0-a69acc1c4c5d" :answer/type :answer.type/text :answer/value "${b}_{1}$ and ${b}_{3}$ only" :db/ensure [:answer/validate]} {:db/id "q-111091/selection/6df6d4de1ba752f381f58299e475590cc0cff1560977f181df78ee444c4a73a4" :answer/id #uuid "686e3339-8c57-5e60-aef0-80138037ee02" :answer/type :answer.type/text :answer/value "${b}_{1}$ only" :db/ensure [:answer/validate]} {:db/id "q-111091/selection" :answer-field/id #uuid "351fd9fd-2830-5a89-b3ec-ebbf8d18c91c" :answer-field/key "selection" :answer-field/type :