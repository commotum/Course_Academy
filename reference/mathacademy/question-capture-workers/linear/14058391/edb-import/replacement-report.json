        {
          "question": "e-4722",
          "field": null,
          "attribute": "question/problem",
          "value": "Suppose that the following elementary row operations, in the given order, are to be applied to a $2\\times 2$ matrix $A\\mathbin{:}$\n\n$$\nR_1 \\leftrightarrow R_2, \\qquad  R_2:=R_2+3R_1\n$$\n\nFind the equivalent notation in terms of matrix multiplication.",
          "category": "ma_capture",
          "file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14058391/example-4722.json",
