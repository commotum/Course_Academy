field.type/radio :answer-field/correct "q-32037/selection/481fbe3f4e5ca2a2ffab6f351dfa165bc1ad4b53aac36b03c4d5531e2a0a7f70" :answer-field/choices ["q-32037/selection/481fbe3f4e5ca2a2ffab6f351dfa165bc1ad4b53aac36b03c4d5531e2a0a7f70" "q-32037/selection/500fd23cf9057505887fe1cf278e2815084e08f3553cdc710562f1d2ad5d2b90" "q-32037/selection/cc62e164119371b324ac6931e2a0c17fd0cf3b4fdca8ab5e3b56357dbfe16098" "q-32037/selection/a531a083aa2f55a19d59de891668c0b2de9e718f776862427ad19c512d57c08f" "q-32037/selection/fab46564fe409c5610029875baaa3164611e81a53a55a89bd1348345387d4dc8"] :db/ensure [:answer-field/validate]} {:db/id "q-32037" :question/id #uuid "19927b14-6169-5952-8c42-a5915b0400a9" :question/math-academy-id "q-32037" :question/problem "Suppose that the following elementary row operations, in the given order, are to be applied to a $2\\times 2$ matrix $A:$\n\n$$\n{R}_{1}:={R}_{1}+(-3){R}_{2},\\,{R}_{2}:=\\frac{1}{3}{R}_{2}\n$$\n\nFind the equivalent notation in terms of matrix multiplication." :question/worked-solution "First, let's find the elementary matrices corresponding to the two given elementary row operations.\n\n- The first elementary row operation is ${R}_{1}:={R}_{1}+(-3){R}_{2}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows: \n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] & {R}_{1}:={R}_{1}+(-3){R}_{2} \\\\  & ∼[\\begin{aligned}1 & -3 \\\\ 0 & 1\\end{aligned}] \\\\  & ={E}_{1}\\end{aligned}\n$$\n\n- The second elementary row operation is ${R}_{2}:=\\frac{1}{3}{R}_{2}$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows: \n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 0 & \\frac{1}{3}\\end{aligned}] \\\\  & ={E}_{2}\\end{aligned}\n$$\n\nTo apply the first elementary row operation to the matrix $A,$ we multiply by ${E}_{1}$ on the left and get ${E}_{1}A:$\n\n$$\n[\\begin{aligned}1 & -3 \\\\ 0 & 1\\end{aligned}]\\cdot A\n$$\n\nThen, to apply the second elementary row operation to ${E}_{1}A,$ we multiply by ${E}_{2}$ on the left and get ${E}_{2}{E}_{1}A:$ \n\n$$\n[\\begin{aligned}1 & 0 \\\\ 0 & \\frac{1}{3}\\end{aligned}]\\cdot [\\begin{aligned}1 & -3 \\\\ 0 & 1\\end{aligned}]\\cdot A\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-32037/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5c6f890b-fab1-51f1-9ac7-b680553c835a"] :knowledge-point/questions ["q-32037"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186115754 :question/answer-fields 17592186113895] {:db/id "q-42767/selection/ma-v1/33898e31ff837c6f94a329bc46c6a8ef91b6215bd2d4862d10e7bfa0ba364651/3faaa9d80fc5185e02aa605ec6ae4d9845133c8b2a5806684f18372abf1690a4" :answer/id #uuid "9dd20871-6457-56e0-af1f-a93ca4f7f1aa" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}]\\cdot [\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]\\cdot [\\begin{aligned}-2 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "q-42767/selection/ma-v1/33898e31ff837c6f94a329bc46c6a8ef91b6215bd2d4862d10e7bfa0ba364651/aaaa9052aa432d04a26338f5b59799c25d69ff5114e8767b091b606183bdbbf6" :answer/id #uuid "32f4a6b7-943a-53f6-80ca-e1796ba345e7" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 1 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 \\\\ 0 & -2\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "q-42767/selection/ma-v1/33898e31ff837c6f94a329bc46c6a8ef91b6215bd2d4862d10e7bfa0ba364651/66acf0231bf3196a5c83f8bb451402f57a9b1980dff3441cfaf7cde8ad05775c" :answer/id #uuid "367a6a30-35eb-5abb-937f-4b8d15049554" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 \\\\ 0 