ea945a21b4d2937257442a7a15232d3b55efde9e1d5b66"] :db/ensure [:answer-field/validate]} {:db/id "q-130839" :question/id #uuid "e513b774-583b-518a-8b52-207376a2ba3b" :question/math-academy-id "q-130839" :question/problem "Let $E=[\\begin{aligned}1 & 0 \\\\ 0 & -10\\end{aligned}].$ Find the row operation that, when applied to a $2\\times 2$ matrix $A,$ gives the result of the product $EA.$" :question/worked-solution "The given matrix $E$ is obtained by multiplying the second row of the identity matrix by $-10$: \n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] & {R}_{2} & :=-10{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 0 & -10\\end{aligned}] \\\\  & =E\\end{aligned}\n$$\n\nTherefore, $EA$ is equivalent to applying the row operation  ${R}_{2}:=-10{R}_{2}$ to $A.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-130839/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f0f47800-98b3-512e-af20-1899e6b0c86d"] :knowledge-point/questions ["q-130839"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130853/selection/790b41da81e49f885a6b4e869fe62e17843171710d39627179999c6aeaf69608" :answer/id #uuid "94f340e1-e695-530e-8a05-07280a75e2ae" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 \\\\ -18 & 1\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "q-130853/selection/f02efe1c26bf5bfa8adcc7a25f334296ea7858e6156c4bf09d9aa3f23a95aec7" :answer/id #uuid "610adf77-3d0b-5624-97b5-8e6d3353935c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}18 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "q-130853/selection/24caae132111f53b7e0ee9518734fd61086157d6019d5bf99c36efa757a9e24d" :answer/id #uuid "5949911c-9c93-52cb-99d7-1e63d4ef58e1" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 18\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "q-130853/selection/0beb53dfae93ad71d75149779ccd359