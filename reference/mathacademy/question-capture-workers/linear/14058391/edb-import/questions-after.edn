}1 & 7 \\\\ 0 & 1\\end{aligned}] \\\\  & =E\\end{aligned}\n$$\n\nTherefore, the equivalent notation in terms of matrix multiplication is $EA:$\n\n$$\n[\\begin{aligned}1 & 7 \\\\ 0 & 1\\end{aligned}]\\cdot A\n$$"}] [{:db/id #edb/ref 17592186335980 :knowledge-point/_questions [{:knowledge-point/id #uuid "94c2cd65-810b-52ad-a20d-7b5a0a9eaf2b" :knowledge-point/title "Finding a Matrix Product That's Equivalent To a Given Row Operation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e35680f-6f66-5e2a-8f0e-9873b044fbe0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 16 \\\\ 0 & 1\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186335982} {:answer/id #uuid "cdb3720d-91c9-5f33-9e34-6f9d76d6a047" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 16 & 1\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186335983} {:answer/id #uuid "9c964d78-980f-510f-8b3e-34d03a856f1a" :answer/type {:db/ident :answer.type/math} :answer/value "A\\cdot [\\begin{aligned}1 & 0 \\\\ -16 & 1\\end{aligned}]" :db/id #edb/ref 17592186335984} {:answer/id #uuid "da84e0ea-74c8-5079-9c4e-657733c5f4d1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}16 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186335985} {:answer/id #uuid "48f02c6f-2f57-5350-9bcc-97d74270a8bc" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 16\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186335986}] :answer-field/correct {:answer/id #uuid "cdb3720d-91c9-5f33-9e34-6f9d76d6a047" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 16 & 1\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186335983} :answer-field/id #uuid "c69eaf1e-838d-559a-ad53-76746e4b1850" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335981}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9c57aadb-3982-5d6f-a765-c7aeaad46196" :question/math-academy-id "q-130847" :question/problem "Suppose we are applying the elementary row operation ${R}_{2}:={R}_{2}+16{R}_{1}$ to a $2\\times 2$ matrix $A.$ Find the equivalent notation in terms of matrix multiplication." :question/worked-solution "We need to find an elementary matrix $E$ such that $EA$ is equivalent to applying the elementary row operation ${R}_{2}:={R}_{2}+16{R}_{1}$ to $A.$ \n\nTo find $E,$ we apply the given row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+16{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 16 & 1\\end{aligned}] \\\\  & =E\\end{aligned}\n$$\n\nTherefore, the equivalent notation in terms of matrix multiplication is $EA:$\n\n$$\n[\\begin{aligned}1 & 0 \\\\ 16 & 1\\end{aligned}]\\cdot A\n$$"}] [{:db/id #edb/ref 17592186335987 :knowledge-point/_questions [{:knowledge-point/id #uuid "94c2cd65-810b-52ad-a20d-7b5a0a9eaf2b" :knowledge-point/title "Finding a Matrix Product That's Equivalent To a Given Row Operation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a595f5d0-53e9-5568-939d-d0d4b25c3150" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & \\frac{1}{2} \\\\ 0 & 1\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186335989} {:answer/id #uuid "238ec761-4aee-5f19-bc5e-76b6aff767c0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{2} & 0 \\\\ 0 & 1\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186335990} {:answer/id #uuid "3dc3041b-d837-593e-ac80-5d412cc40a49" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186335991} {:answer/id #uuid "11a2628d-30fe-50df-8de8-2330272f2198" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{2} & \\frac{1}{2} \\\\ 0 & 1\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186335992} {:answer/id #uuid "ea2e953f-5575-55a2-9ca2-2cb431b1b7c4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 0 \\\\ 0 & 2\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186335993}] :answer-field/correct {:answer/id #uuid "238ec761-4aee-5f19-bc5e-76b6aff767c0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{2} & 0 \\\\ 0 & 1\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186335990} :answer-field/id #uuid "772703a3-8c6b-55e9-8fe3-eac5a35e71f3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335988}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d46d64cf-1d2c-5f6e-b61a-6892ada06565" :question/math-academy-id "q-130850" :question/problem "Suppose we are applying the elementary row operation ${R}_{1}:=\\frac{1}{2}{R}_{1}$ to a $2\\times 2$ matrix $A.$ Find the equivalent notation in terms of matrix multiplication." :question/worked-solution "We need to find an elementary matrix $E$ such that $EA$ is equivalent to applying the elementary row operation ${R}_{1}:=\\frac{1}{2}{R}_{1}$ to $A.$\n\nTo find $E,$ we apply the given row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}\\frac{1}{2} & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =E\\end{aligned}\n$$\n\nTherefore, the equivalent notation in terms of matrix multiplication is $EA:$\n\n$$\n[\\begin{aligned}\\frac{1}{2} & 0 \\\\ 0 & 1\\end{aligned}]\\cdot A\n$$"}] [{:db/id #edb/ref 17592186335994 :knowledge-point/_questions [{:knowledge-point/id #uuid "94c2cd65-810b-52ad-a20d-7b5a0a9eaf2b" :knowledge-point/title "Finding a Matrix Product That's Equivalent To a Given Row Operation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e97e1d6-34ba-