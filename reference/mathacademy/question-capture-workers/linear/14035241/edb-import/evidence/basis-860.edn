#{[{:db/id #edb/ref 17592186280335 :knowledge-point/_questions [{:knowledge-point/id #uuid "5ad95b4e-e367-5e26-800c-1a87a537ca83" :knowledge-point/title "Finding the Intervals on Which a Trigonometric Function Is Continuous"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9dd589af-501b-58ef-be7c-77e8aebe245d" :answer/type {:db/ident :answer.type/math} :answer/value "[-\\pi ,0)" :db/id #edb/ref 17592186280337} {:answer/id #uuid "b9fafe48-2b75-5c8b-982f-0d3a787bd528" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\pi ,\\pi )" :db/id #edb/ref 17592186280338} {:answer/id #uuid "e3ecf695-f90a-56fa-afc1-b3676f0ce3ad" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\pi ]" :db/id #edb/ref 17592186280339} {:answer/id #uuid "daf96ed1-e2cb-583a-baae-e28322ca8c6e" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\pi ,0)\\cup (0,\\pi )" :db/id #edb/ref 17592186280340} {:answer/id #uuid "47d3832d-8107-51fa-af49-98b1f281c348" :answer/type {:db/ident :answer.type/math} :answer/value "[-\\pi ,0)\\cup (0,\\pi ]" :db/id #edb/ref 17592186280341}] :answer-field/correct {:answer/id #uuid "daf96ed1-e2cb-583a-baae-e28322ca8c6e" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\pi ,0)\\cup (0,\\pi )" :db/id #edb/ref 17592186280340} :answer-field/id #uuid "0bbca804-05ba-50e4-93e4-6e760667c220" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280336}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e0955151-e22d-56d2-b9a3-a4df1b6955c4" :question/math-academy-id "q-40081" :question/problem "The interval $I$ consists of all real numbers $x$ such that $-\\pi \\le x\\le \\pi .$ What is the largest subset of $I$ on which the function $g(x)=\\operatorname{csc}⁡(x)-\\operatorname{cos}⁡(x)$ is continuous?" :question/worked-solution "Trigonometric functions are continuous at all points in their respective domains.\n\nThe function $\\operatorname{cos}⁡x$ is continuous over the entire interval $[-\\pi ,\\pi ],$ but the function $\\operatorname{csc}⁡x$ is not defined at $x=-\\pi ,0,\\pi .$ \n\nTherefore, the domain of $g(x)$ consists of the union of the intervals $(-\\pi ,0)$ and $(0,\\pi ),$ namely\n\n$$\n(-\\pi ,0)\\cup (0,\\pi )\n$$\n\nand the function is also continuous on this union of intervals."}]}
