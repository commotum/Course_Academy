#{[{:db/id #edb/ref 17592186256857 :knowledge-point/_questions [{:knowledge-point/id #uuid "fb183013-a42d-50a3-a1b8-cd8501781075" :knowledge-point/title "Factoring a Polynomial With Multiple Variables as a Difference of Squares"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e7718bc-af7f-52f7-b830-adb8e4000d64" :answer/type {:db/ident :answer.type/math} :answer/value "2((9{m}^{2}+{n}^{2})(3m+n)(3m-n))" :db/id #edb/ref 17592186269840} {:answer/id #uuid "f7044c1a-f05f-565d-931d-5edd79b4bfb4" :answer/type {:db/ident :answer.type/math} :answer/value "(9{m}^{2}+{n}^{2})(3m+n)(3m-n)" :db/id #edb/ref 17592186269841} {:answer/id #uuid "ca911217-b2a9-5e19-bca1-58c35a5f2854" :answer/type {:db/ident :answer.type/math} :answer/value "3((9{m}^{2}+{n}^{2})(3m+n)(3m-n))" :db/id #edb/ref 17592186269842} {:answer/id #uuid "653be50b-56fa-5bcb-acb6-afe7df3e5044" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}((9{m}^{2}+{n}^{2})(3m+n)(3m-n))" :db/id #edb/ref 17592186269843} {:answer/id #uuid "26da3000-f2b1-5412-a006-c929f0e87251" :answer/type {:db/ident :answer.type/math} :answer/value "-((9{m}^{2}+{n}^{2})(3m+n)(3m-n))" :db/id #edb/ref 17592186269844}] :answer-field/correct {:answer/id #uuid "f7044c1a-f05f-565d-931d-5edd79b4bfb4" :answer/type {:db/ident :answer.type/math} :answer/value "(9{m}^{2}+{n}^{2})(3m+n)(3m-n)" :db/id #edb/ref 17592186269841} :answer-field/id #uuid "ef5766b8-6144-510b-b404-2d833c9c13b9" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274243}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "653b723d-c78b-5196-a990-9f8d17649f57" :question/math-academy-id "q-112044" :question/problem "Factor the expression $81{m}^{4}-{n}^{4}.$" :question/worked-solution "The difference of squares formula is given by\n\n$$\n{a}^{2}-{b}^{2}=(a+b)(a-b)\n$$\n\nNotice that our expression can be written as a difference of squares:\n\n$$\n81{m}^{4}-{n}^{4}={(9{m}^{2})}^{2}-{({n}^{2})}^{2}\n$$\n\nNow, we factor our expression using the difference of squares formula:\n\n$$\n{(9{m}^{2})}^{2}-{({n}^{2})}^{2}=(9{m}^{2}+{n}^{2})(9{m}^{2}-{n}^{2})\n$$\n\nFinally, we notice that the expression in the second set of parentheses is also a difference of squares: \n\n$$\n9{m}^{2}-{n}^{2}={(3m)}^{2}-{n}^{2}\n$$\n\nTherefore, the expression can be factored further, as follows:\n\n$$\n\\begin{aligned}(9{m}^{2}+{n}^{2})(9{m}^{2}-{n}^{2}) & =(9{m}^{2}+{n}^{2})(3m+n)(3m-n)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248072 :knowledge-point/_questions [{:knowledge-point/id #uuid "caf358b8-31fb-5587-8663-f414317c42be" :knowledge-point/title "Integrating Secant Squared"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "723760e9-23c3-5c48-a8a0-14f367264b24" :answer/type {:db/ident :answer.type/math} :answer/value "cot⁡x-2{csc}^{2}⁡x+C" :db/id #edb/ref 17592186248074} {:answer/id #uuid "5aee1186-068d-5f33-a19a-e3ce34344f5d" :answer/type {:db/ident :answer.type/math} :answer/value "tan⁡x-2cot⁡x+C" :db/id #edb/ref 17592186248075} {:answer/id #uuid "04031012-33d0-5561-93e3-da78c34d54b8" :answer/type {:db/ident :answer.type/math} :answer/value "cot⁡x+2csc⁡x+C" :db/id #edb/ref 17592186248076} {:answer/id #uuid "861a76b1-9acc-50f7-a332-a3e1dee6fea4" :answer/type {:db/ident :answer.type/math} :answer/value "-tan⁡x+2{csc}^{2}⁡x+C" :db/id #edb/ref 17592186248077} {:answer/id #uuid "0c38b7cb-d5fb-547e-9b72-178759d37b75" :answer/type {:db/ident :answer.type/math} :answer/value "tan⁡x+2csc⁡x+C" :db/id #edb/ref 17592186248078}] :answer-field/correct {:answer/id #uuid "0c38b7cb-d5fb-547e-9b72-178759d37b75" :answer/type {:db/ident :answer.type/math} :answer/value "tan⁡x+2csc⁡x+C" :db/id #edb/ref 17592186248078} :answer-field/id #uuid "8f509c10-f8e6-5732-8ee4-cf646431ecb4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186248073}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "02d1ee40-9cf5-5a6c-bd46-1af85125c0b9" :question/math-academy-id "q-113944" :question/problem "$\\int ({sec}^{2}⁡x-2csc⁡xcot⁡x)\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int csc⁡xcot⁡x\\,\\text{d}x & =-csc⁡x+C \\\\ \\int {sec}^{2}⁡x\\,\\text{d}x & =tan⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int ({sec}^{2}⁡x-2csc⁡xcot⁡x)\\,\\text{d}x & =\\int {sec}^{2}⁡x\\,\\text{d}x-2\\int csc⁡xcot⁡x\\,\\text{d}x \\\\  & =tan⁡x-2(-csc⁡x)+C \\\\  & =tan⁡x+2csc⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257116 :knowledge-point/_questions [{:knowledge-point/id #uuid "9fed1761-ceeb-5033-afa2-cb735e6bb96c" :knowledge-point/title "Determining the Lengths of the Major and Minor Axes of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b85f6829-84a8-52bd-a851-877b050f4826" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186270172} {:answer/id #uuid "86aca8a2-f7fe-513f-947c-c40ad74f365e" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186270173} {:answer/id #uuid "c8999e92-bba2-5179-9360-ba488b206d7b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186270174} {:answer/id #uuid "4a151041-d89e-5dbe-bf68-8e8b24859960" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186270175} {:answer/id #uuid "17825f5f-edbb-5a96-8348-df95f5d17098" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186270176}] :answer-field/correct {:answer/id #uuid "86aca8a2-f7fe-513f-947c-c40ad74f365e" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186270173} :answer-field/id #uuid "6bc9a344-346e-560d-9fc5-2c6bf704bb5b" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274310}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1bd10278-9b76-5fcf-980b-136026be1670" :question/math-academy-id "q-114961" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/d624edaffd8c90de40041d419cf65bcf8f3af5d31c8d88d1123bd8f3d7555166.png)\n\nWhat is the length of the major axis of the ellipse given above?" :question/worked-solution "The major axis is the longest diameter of the ellipse, which is the line segment bounded by the points $(-3,1)$ and $(5,1).$ So, the length of the major axis is $5-(-3)=8.$"}] [{:db/id #edb/ref 17592186257134 :knowledge-point/_questions [{:knowledge-point/id #uuid "29e2083d-fe76-5a35-9c3a-7e6ad19ff968" :knowledge-point/title "Determining the Equation of a Parabola With Non-Origin Vertex Passing Through a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0fce35b-dea5-5fa0-915b-14d76c22527c" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac34(x-2)^2+4" :db/id #edb/ref 17592186270192} {:answer/id #uuid "8709881b-83e9-54b1-9114-9945ac274319" :answer/type {:db/ident :answer.type/math} :answer/value "y=3(-\\frac34(x-2)^2+4)" :db/id #edb/ref 17592186270193} {:answer/id #uuid "993c66db-4485-5a71-b899-3bd5a69c5cf4" :answer/type {:db/ident :answer.type/math} :answer/value "y=2(-\\frac34(x-2)^2+4)" :db/id #edb/ref 17592186270194} {:answer/id #uuid "72d1f3ec-4258-589b-82d9-11e84123fd2c" :answer/type {:db/ident :answer.type/math} :answer/value "y=-(-\\frac34(x-2)^2+4)" :db/id #edb/ref 17592186270195} {:answer/id #uuid "9d22fe07-a608-5ece-ab09-4690c51631d4" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}(-\\frac34(x-2)^2+4)" :db/id #edb/ref 17592186270196}] :answer-field/correct {:answer/id #uuid "f0fce35b-dea5-5fa0-915b-14d76c22527c" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac34(x-2)^2+4" :db/id #edb/ref 17592186270192} :answer-field/id #uuid "1b47dac2-6abb-5629-98e5-0416c1e1241f" :answer-field/key "y" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274314}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6c976869-dd96-5219-84a7-962a7edc295e" :question/math-academy-id "q-115511" :question/problem "Find the equation of the downward-opening parabola that has its vertex at $(2,4)$ and which passes through the point $(4,1).$" :question/worked-solution "For any upward or downward-opening parabola with its vertex at $(h,k),$ the general standard equation is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nHere, the vertex has coordinates $(h,k)=(2,4).$ Substituting these into the general standard equation, we get\n\n$$\n\\begin{aligned}(x-2)^{2} & =4p(y-4).\\end{aligned}\n$$\n\nWe are left to find the value of $p.$ We know that the given parabola also passes through the point $(4,1),$ so we can substitute $x=4$ and $y=1$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}(x-2)^{2} & =4p(y-4) \\\\ (4-2)^{2} & =4p(1-4) \\\\ 4 & =-12p \\\\ p & =-\\frac{1}{3}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}(x-2)^{2} & =4p(y-4) \\\\ (x-2)^{2} & =4(-\\frac{1}{3})(y-4) \\\\ (x-2)^{2} & =-\\frac{4}{3}(y-4).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257386 :knowledge-point/_questions [{:knowledge-point/id #uuid "b05f4be1-95d4-5137-bbaa-71c95862bb59" :knowledge-point/title "Simplifying Expressions by Factoring an Alternate Form of the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "463b6d4c-409f-55ba-b1f6-69f6d9773939" :answer/type {:db/ident :answer.type/math} :answer/value "2 − \\cos x" :db/id #edb/ref 17592186270417} {:answer/id #uuid "d9182720-44d8-5d56-bdf5-2439aa2c0463" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cos x − 1" :db/id #edb/ref 17592186270418} {:answer/id #uuid "11cd5682-9da4-5615-b3a5-54f04a88f23c" :answer/type {:db/ident :answer.type/math} :answer/value "1 + \\cos x" :db/id #edb/ref 17592186270419} {:answer/id #uuid "afa22122-5058-57c5-9441-e138d829ef82" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}x" :db/id #edb/ref 17592186270420} {:answer/id #uuid "c03774a8-b129-5c10-b7e5-c6274b9465cb" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos x − 1" :db/id #edb/ref 17592186270421}] :answer-field/correct {:answer/id #uuid "afa22122-5058-57c5-9441-e138d829ef82" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}x" :db/id #edb/ref 17592186270420} :answer-field/id #uuid "7f2c4aa7-a316-5bc3-b0f0-430c759b4ac7" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274359}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5a918518-91f1-50bb-bef6-5c2c5dd04e5a" :question/math-academy-id "q-119865" :question/problem "Simplify $\\frac{{sin}^{2}x}{1-\\operatorname{cos}x}-1$" :question/worked-solution "First, we rewrite the numerator of the first term using $1-{cos}^{2}x={sin}^{2}x.$\n\n$$\n\\frac{{sin}^{2}x}{1-\\operatorname{cos}x}-1=\\frac{1-{cos}^{2}x}{1-\\operatorname{cos}x}-1\n$$\n\nNext, we factor the numerator of the first term as a difference of squares, and simplify:\n\n$$\n\\begin{aligned}\\frac{1-{cos}^{2}x}{1-\\operatorname{cos}x}-1 & =\\frac{(1-\\operatorname{cos}x)(1+\\operatorname{cos}x)}{1-\\operatorname{cos}x}-1 \\\\  & =\\frac{\\cancel{(1-\\operatorname{cos}x)}(1+\\operatorname{cos}x)}{\\cancel{1-\\operatorname{cos}x}}-1 \\\\  & =\\frac{1+\\operatorname{cos}x}{1}-1 \\\\  & =1+\\operatorname{cos}x-1 \\\\  & =\\operatorname{cos}x\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257802 :knowledge-point/_questions [{:knowledge-point/id #uuid "ed7286fe-b6e2-5544-8bc6-86afc6cdb813" :knowledge-point/title "Identifying a Matrix by Its Description"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe671429-b86c-5c26-8226-91ad7084774e" :answer/type {:db/ident :answer.type/math} :answer/value "2(F)" :db/id #edb/ref 17592186270777} {:answer/id #uuid "d5ddac2f-bcb7-52b9-8fcf-7cfe949730b6" :answer/type {:db/ident :answer.type/math} :answer/value "F" :db/id #edb/ref 17592186270778} {:answer/id #uuid "e240b1d7-1c05-5544-9706-dc0c104329f4" :answer/type {:db/ident :answer.type/math} :answer/value "3(F)" :db/id #edb/ref 17592186270779} {:answer/id #uuid "f6d5c7ae-25c4-5e1e-aef4-1f7412832f59" :answer/type {:db/ident :answer.type/math} :answer/value "-(F)" :db/id #edb/ref 17592186270780} {:answer/id #uuid "b4a28d25-f408-5135-b0f3-ad826234d9ac" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(F)" :db/id #edb/ref 17592186270781}] :answer-field/correct {:answer/id #uuid "d5ddac2f-bcb7-52b9-8fcf-7cfe949730b6" :answer/type {:db/ident :answer.type/math} :answer/value "F" :db/id #edb/ref 17592186270778} :answer-field/id #uuid "4aebfe4e-3679-5699-963a-8896ca0a36bf" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274431}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "11d30a39-1dc6-581f-aa48-ba6b816cb779" :question/math-academy-id "q-125550" :question/problem "Which of the following is a $3\\times 2$ matrix?\n\n$$\nE=[\\begin{aligned}3 & 3 & 2 \\\\ 3 & 0 & 0\\end{aligned}],\\,F=[\\begin{aligned}1 & 2 \\\\ 2 & 8 \\\\ -2 & 3\\end{aligned}],\\,G=[\\begin{aligned}5 & 2 & 7 \\\\ 0 & 5 & 0 \\\\ 1 & 0 & 0\\end{aligned}]\n$$" :question/worked-solution "- The matrix $E$ has $2$ rows and $3$ columns. So, its dimensions are $2\\times 3.$ $\\,\\times $\n\n- The matrix $F$ has $3$ rows and $2$ columns. So, its dimensions are $3\\times 2.$ $\\,✓$\n\n- The matrix $G$ has $3$ rows and $3$ columns. So, its dimensions are $3\\times 3.$ $\\,\\times $\n\nTherefore, only $F$ is a $3\\times 2$ matrix."}] [{:db/id #edb/ref 17592186258090 :knowledge-point/_questions [{:knowledge-point/id #uuid "4b12a7b7-1df3-5203-934e-8820604de3de" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4618627-82f2-504b-ae29-ec11136eae20" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin x" :db/id #edb/ref 17592186270937} {:answer/id #uuid "7e469656-bd75-5579-910a-b16978b23215" :answer/type {:db/ident :answer.type/math} :answer/value "− \\sin x" :db/id #edb/ref 17592186270938} {:answer/id #uuid "320cd49a-eb63-5e3d-aff0-d07fd19f7577" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}x-\\operatorname{sin}x}{2}" :db/id #edb/ref 17592186270939} {:answer/id #uuid "4ff7a7ff-0478-5b8d-a50e-2cef499bdc25" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos x" :db/id #edb/ref 17592186270940} {:answer/id #uuid "33503006-56a2-51d8-83c8-db4406f65503" :answer/type {:db/ident :answer.type/math} :answer/value "− \\cos x" :db/id #edb/ref 17592186270941}] :answer-field/correct {:answer/id #uuid "320cd49a-eb63-5e3d-aff0-d07fd19f7577" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}x-\\operatorname{sin}x}{2}" :db/id #edb/ref 17592186270939} :answer-field/id #uuid "0f0ad887-88be-52fa-8b2d-8779ddd115b5" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274463}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "4878f13e-2679-5b9e-8cae-9094f9bb2d55" :question/math-academy-id "q-141281" :question/problem "$\\operatorname{sin}(x+\\frac{2\\pi }{3})=$" :question/worked-solution "Recall the sum formula for sine:\n\n$$\n\\operatorname{sin}(u+v)=\\operatorname{sin}u\\operatorname{cos}v+\\operatorname{cos}u\\operatorname{sin}v\n$$\n\nApplying the sum formula for sine with $u=x$ and $v=\\frac{2\\pi }{3},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}(x+\\frac{2\\pi }{3}) & =\\operatorname{sin}x\\operatorname{cos}(\\frac{2\\pi }{3})+\\operatorname{cos}x\\operatorname{sin}(\\frac{2\\pi }{3}) \\\\  & =\\operatorname{sin}x\\cdot (-\\frac{1}{2})+\\operatorname{cos}x\\cdot (\\frac{\\sqrt{3}}{2}) \\\\  & =-\\frac{\\operatorname{sin}x}{2}+\\frac{\\sqrt{3}\\operatorname{cos}x}{2} \\\\  & =\\frac{\\sqrt{3}\\operatorname{cos}x-\\operatorname{sin}x}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258842 :knowledge-point/_questions [{:knowledge-point/id #uuid "1671fb4f-937f-5a3c-85b7-7f54f35ea543" :knowledge-point/title "Determining the Intervals on Which a Function Is Increasing Using Differentiation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "119ffdc3-3b49-536a-86d7-12c14e7cc6b1" :answer/type {:db/ident :answer.type/math} :answer/value "− 4 < x < 2" :db/id #edb/ref 17592186271410} {:answer/id #uuid "ff773ede-2bef-5d5f-85d7-d273663b11bf" :answer/type {:db/ident :answer.type/math} :answer/value "− 2 < x < 4" :db/id #edb/ref 17592186271411} {:answer/id #uuid "2486cb39-0171-50f7-984f-c0dd87348263" :answer/type {:db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,0)\\cup (1,\\infty )" :db/id #edb/ref 17592186271412} {:answer/id #uuid "836d0c26-e586-5f45-8a4b-853e0e9aa83b" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty,-3)" :db/id #edb/ref 17592186271413} {:answer/id #uuid "acada4bb-a1b6-51a1-b897-26c28af244ab" :answer/type {:db/ident :answer.type/math} :answer/value "− 2 < x < 2" :db/id #edb/ref 17592186271414}] :answer-field/correct {:answer/id #uuid "2486cb39-0171-50f7-984f-c0dd87348263" :answer/type {:db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,0)\\cup (1,\\infty )" :db/id #edb/ref 17592186271412} :answer-field/id #uuid "9d97e671-67af-535a-b8bc-1ad7c19158e2" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274560}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "20089cbf-a0a2-56b3-8290-b7c3572f1443" :question/math-academy-id "q-21026" :question/problem "Find the values of $x$ for which the function $f(x)=2{x}^{3}-3{x}^{2}+8$ is strictly increasing." :question/worked-solution "The function is strictly increasing where ${f}^{'}(x)>0.$ Differentiating $f(x),$ we get\n\n$$\n\\begin{aligned}{f}^{'}(x) & =2\\cdot 3{x}^{2}-3\\cdot 2x \\\\  & =6{x}^{2}-6x,\\end{aligned}\n$$\n\nso we need to solve the inequality\n\n$$\n\\begin{aligned}6{x}^{2}-6x & >0.\\end{aligned}\n$$\n\nThe above inequality factors as\n\n$$\n6x(x-1)>0.\n$$\n\nThe graph of $y=6x(x-1)$ has roots at $x=0$ and $x=1,$ as shown below:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/ec7ea6baa82d60a6cf472c904460190042d889d86cb092b19d9809111bd93b36.png)\n\nTherefore, we conclude that the function is strictly increasing on the intervals $x\\in (-\\infty ,0)\\cup (1,\\infty ).$"}] [{:db/id #edb/ref 17592186260204 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4014376-4dae-56f1-b981-b35d3afab874" :knowledge-point/title "Solving for a Constant Such that the Limit of a Piecewise Function Exists"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90d7ac25-3873-59c3-b25f-4ce0e686e30e" :answer/type {:db/ident :answer.type/text} :answer/value "b = $(-1)-1$; c = $-1$" :db/id #edb/ref 17592186271944} {:answer/id #uuid "92500148-04ef-5384-aa75-1d399017380e" :answer/type {:db/ident :answer.type/text} :answer/value "b = $(-1)-2$; c = $-1$" :db/id #edb/ref 17592186271945} {:answer/id #uuid "7b435b66-be3e-5219-bfb4-33fdc82905e8" :answer/type {:db/ident :answer.type/text} :answer/value "b = $(-1)+1$; c = $-1$" :db/id #edb/ref 17592186271946} {:answer/id #uuid "bd74bb1c-f699-5657-8dd9-dbcd9e8883dc" :answer/type {:db/ident :answer.type/text} :answer/value "b = $(-1)+2$; c = $-1$" :db/id #edb/ref 17592186271947} {:answer/id #uuid "067904ef-5d42-559c-bf0c-885d75617f41" :answer/type {:db/ident :answer.type/text} :answer/value "b = $-1$; c = $-1$" :db/id #edb/ref 17592186271948}] :answer-field/correct {:answer/id #uuid "067904ef-5d42-559c-bf0c-885d75617f41" :answer/type {:db/ident :answer.type/text} :answer/value "b = $-1$; c = $-1$" :db/id #edb/ref 17592186271948} :answer-field/id #uuid "33a5c13f-378a-5d73-9805-cca4c35cb699" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274668}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "3cbc081a-4656-5dca-b3b1-aa3f8536f992" :question/math-academy-id "q-36743" :question/problem "For the piecewise function \n\n$$\nf(x)={\\begin{aligned}{x}^{2}+2x+b\\, & \\text{ for }\\,x\\le 1 \\\\ {x}^{2}+cx+2\\, & \\text{ for }\\,x>1\\end{aligned}\n$$\n\nit is known that ${lim}_{x\\to 1}f(x)=2.$ What is the value of the constants $b$ and $c?$" :question/worked-solution "In order for ${lim}_{x\\to 1}f(x)$ to be equal to $2,$ the left and right-sided limits must both exist and be equal to $2.$\n\n- Approaching from the left, we have $x<1,$ so we use the expression $f(x)={x}^{2}+2x+b.$ We get \n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{-}}f(x) & ={lim}_{x\\to {1}^{-}}({x}^{2}+2x+b) \\\\  & ={1}^{2}+2(1)+b \\\\  & =1+2+b \\\\  & =b+3\\,.\\end{aligned}\n$$\n\nSince the left-sided limit must be equal to $2,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{-}}f(x) & =2 \\\\ b+3 & =2 \\\\ b & =2-3 \\\\ b & =-1.\\end{aligned}\n$$\n\n- Approaching from the right, we have $x>1,$ so we use the expression $f(x)={x}^{2}+cx+2.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{+}}f(x) & ={lim}_{x\\to {1}^{+}}({x}^{2}+cx+2) \\\\  & ={1}^{2}+c(1)+2 \\\\  & =1+c+2 \\\\  & =c+3\\,.\\end{aligned}\n$$\n\nSince the right-sided limit must be equal to $2,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{+}}f(x) & =2 \\\\ c+3 & =2 \\\\ c & =2-3 \\\\ c & =-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186280335 :knowledge-point/_questions [{:knowledge-point/id #uuid "5ad95b4e-e367-5e26-800c-1a87a537ca83" :knowledge-point/title "Finding the Intervals on Which a Trigonometric Function Is Continuous"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9dd589af-501b-58ef-be7c-77e8aebe245d" :answer/type {:db/ident :answer.type/math} :answer/value "[-\\pi ,0)" :db/id #edb/ref 17592186280337} {:answer/id #uuid "b9fafe48-2b75-5c8b-982f-0d3a787bd528" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\pi ,\\pi )" :db/id #edb/ref 17592186280338} {:answer/id #uuid "e3ecf695-f90a-56fa-afc1-b3676f0ce3ad" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\pi ]" :db/id #edb/ref 17592186280339} {:answer/id #uuid "daf96ed1-e2cb-583a-baae-e28322ca8c6e" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\pi ,0)\\cup (0,\\pi )" :db/id #edb/ref 17592186280340} {:answer/id #uuid "47d3832d-8107-51fa-af49-98b1f281c348" :answer/type {:db/ident :answer.type/math} :answer/value "[-\\pi ,0)\\cup (0,\\pi ]" :db/id #edb/ref 17592186280341}] :answer-field/correct {:answer/id #uuid "daf96ed1-e2cb-583a-baae-e28322ca8c6e" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\pi ,0)\\cup (0,\\pi )" :db/id #edb/ref 17592186280340} :answer-field/id #uuid "0bbca804-05ba-50e4-93e4-6e760667c220" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280336}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e0955151-e22d-56d2-b9a3-a4df1b6955c4" :question/math-academy-id "q-40081" :question/problem "The interval $I$ consists of all real numbers $x$ such that $-\\pi \\le x\\le \\pi .$ What is the largest subset of $I$ on which the function $g(x)=\\operatorname{csc}⁡(x)-\\operatorname{cos}⁡(x)$ is continuous?" :question/worked-solution "Trigonometric functions are continuous at all points in their respective domains.\n\nThe function $\\operatorname{cos}⁡x$ is continuous over the entire interval $[-\\pi ,\\pi ],$ but the function $\\operatorname{csc}⁡x$ is not defined at $x=-\\pi ,0,\\pi .$ \n\nTherefore, the domain of $g(x)$ consists of the union of the intervals $(-\\pi ,0)$ and $(0,\\pi ),$ namely\n\n$$\n(-\\pi ,0)\\cup (0,\\pi )\n$$\n\nand the function is also continuous on this union of intervals."}] [{:db/id #edb/ref 17592186279075 :knowledge-point/_questions [{:knowledge-point/id #uuid "89362140-1a17-56fd-a9ab-4da336112bee" :knowledge-point/title "Multiplying a Matrix by a Column or Row of the Identity Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d130fa2-0493-59f0-af50-5160da776d28" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 1 & -\\sqrt{3}\\end{aligned}]" :db/id #edb/ref 17592186279077} {:answer/id #uuid "51168f06-2e01-5b0b-8693-e06b3de9dde2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\sqrt{5} \\\\ -3 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186279078} {:answer/id #uuid "bbd472d0-73ef-50e9-855a-0399cfed9979" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\sqrt{5} & 4 & 1\\end{aligned}]" :db/id #edb/ref 17592186279079} {:answer/id #uuid "4460027c-0c38-5e6a-8d86-3dc9b9c03c6b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 & 2\\sqrt{2} & -3.2\\end{aligned}]" :db/id #edb/ref 17592186279080} {:answer/id #uuid "3d480acf-3659-5c9e-a0aa-59046b467d2b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ 2\\sqrt{2} \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186279081}] :answer-field/correct {:answer/id #uuid "4460027c-0c38-5e6a-8d86-3dc9b9c03c6b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 & 2\\sqrt{2} & -3.2\\end{aligned}]" :db/id #edb/ref 17592186279080} :answer-field/id #uuid "d5abea32-c0b7-548b-8c88-75fbbdda6178" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186279076}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c7963c06-fa30-5a29-ac72-ec8ff733ff33" :question/math-academy-id "q-41944" :question/problem "Find the product $AB$, if\n$A=[\\begin{aligned}0 & 1 & 0\\end{aligned}]$\nand \n$B=[\\begin{aligned}\\sqrt{5} & 4 & 1 \\\\ -3 & 2\\sqrt{2} & -3.2 \\\\ 0 & 1 & -\\sqrt{3}\\end{aligned}].$" :question/worked-solution "Notice that $A$ is the $2$nd *row* of the identity matrix ${I}_{3}.$\n\nSince we're multiplying the $3\\times 3$ matrix $B$ by the $2$nd *row* of the identity matrix ${I}_{3}$ on the *left*, the result must be the $2$nd *row* of $B.$ Therefore,\n\n$$\nAB=[\\begin{aligned}-3 & 2\\sqrt{2} & -3.2\\end{aligned}].\n$$\n\nLet's check the long way:\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}0 & 1 & 0\\end{aligned}][\\begin{aligned}\\sqrt{5} & 4 & 1 \\\\ -3 & 2\\sqrt{2} & -3.2 \\\\ 0 & 1 & -\\sqrt{3}\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 2\\sqrt{2} & -3.2\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260869 :knowledge-point/_questions [{:knowledge-point/id #uuid "831f9aa0-099e-5e0c-8a9d-c4828b629f64" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef898c1e-d9fd-5fc5-a3b2-eec2abe8e15f" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin x" :db/id #edb/ref 17592186272664} {:answer/id #uuid "747f9201-514b-5369-b32b-70d05b3dbe38" :answer/type {:db/ident :answer.type/math} :answer/value "− \\sin x" :db/id #edb/ref 17592186272665} {:answer/id #uuid "94c0dee0-cade-5849-8e5a-19c0769bab47" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}(\\operatorname{cos}x+\\sqrt{3}\\operatorname{sin}x)" :db/id #edb/ref 17592186272666} {:answer/id #uuid "669f7bc5-f47d-5b7a-b784-944f3727762a" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos x" :db/id #edb/ref 17592186272667} {:answer/id #uuid "66f976c1-142e-5ac1-8488-8cd193d35356" :answer/type {:db/ident :answer.type/math} :answer/value "− \\cos x" :db/id #edb/ref 17592186272668}] :answer-field/correct {:answer/id #uuid "94c0dee0-cade-5849-8e5a-19c0769bab47" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}(\\operatorname{cos}x+\\sqrt{3}\\operatorname{sin}x)" :db/id #edb/ref 17592186272666} :answer-field/id #uuid "3d2bdce8-f6d8-51cd-b5d9-d083888cb53c" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274816}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "8bb03c0c-2bf3-5dda-8102-58698d5cc17e" :question/math-academy-id "q-65502" :question/problem "$\\operatorname{cos}(x+\\frac{2\\pi }{3})=$" :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}(u+v)=\\operatorname{cos}u\\operatorname{cos}v-\\operatorname{sin}u\\operatorname{sin}v\n$$\n\nApplying the sum formula for cosine with $u=x$ and $v=\\frac{2\\pi }{3}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}(x+\\frac{2\\pi }{3}) & =\\operatorname{cos}x\\operatorname{cos}(\\frac{2\\pi }{3})-\\operatorname{sin}x\\operatorname{sin}(\\frac{2\\pi }{3}) \\\\  & =\\operatorname{cos}x\\cdot (-\\frac{1}{2})-\\operatorname{sin}x\\cdot (\\frac{\\sqrt{3}}{2}) \\\\  & =-\\frac{1}{2}(\\operatorname{cos}x+\\sqrt{3}\\operatorname{sin}x).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286320 :knowledge-point/_questions [{:knowledge-point/id #uuid "8e6b5d85-0b53-580f-9520-6c33463231d5" :knowledge-point/title "Integrating Using Inverse Trigonometric Functions and Some Manipulations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f9e81eb7-bf3a-517d-af64-d1da3ae6d57a" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+2arcsecx+C" :db/id #edb/ref 17592186286322} {:answer/id #uuid "c397fa53-cb24-5dc2-a069-9832669a4288" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+2\\operatorname{arcsin}⁡x+C" :db/id #edb/ref 17592186286323} {:answer/id #uuid "2567307c-9ce2-5010-b084-aa0a655b06b0" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186286324} {:answer/id #uuid "d863f590-61bd-59df-ade8-40d9e17ee6a7" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{2}+\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186286325} {:answer/id #uuid "4cfee2d8-4cf7-525f-aa6b-7120847a36f3" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{2}+\\operatorname{arcsin}⁡x+C" :db/id #edb/ref 17592186286326}] :answer-field/correct {:answer/id #uuid "2567307c-9ce2-5010-b084-aa0a655b06b0" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186286324} :answer-field/id #uuid "bc2fcc97-3fad-5708-9192-efb02b0b2438" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286321}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "0f79a7e7-fd0c-5a15-b868-815d3bd17ec4" :question/math-academy-id "q-71779" :question/problem "$\\int \\frac{2{x}^{3}+2x+1}{{x}^{2}+1}\\,\\text{d}x=$" :question/worked-solution "This integral doesn't look like one of the basic ones. However, we can manipulate the numerator a bit  to make it look more like the denominator, which reveals a more familiar expression:\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{2{x}^{3}+2x+1}{{x}^{2}+1} & =\\frac{2x({x}^{2}+1)+1}{{x}^{2}+1} \\\\  & =\\frac{2x\\cancel{({x}^{2}+1)}}{\\cancel{{x}^{2}+1}}+\\frac{1}{{x}^{2}+1} \\\\  & =2x+\\frac{1}{{x}^{2}+1}\\end{aligned}\n$$\n\nRemembering that\n\n$$\n\\int \\frac{1}{1+{x}^{2}}\\text{d}x=\\operatorname{arctan}⁡x+C,\n$$\n\nwe can now calculate the integral and get\n\n$$\n\\begin{aligned}f(x)=\\int {f}^{′}(x)\\,\\text{d}x & =\\int (2x+\\frac{1}{{x}^{2}+1})\\text{d}x \\\\  & =2\\int x\\text{d}x+\\int \\frac{1}{{x}^{2}+1}\\,\\text{d}x \\\\  & =2\\cdot \\frac{{x}^{2}}{2}+\\operatorname{arctan}⁡x+C \\\\  & ={x}^{2}+\\operatorname{arctan}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261501 :knowledge-point/_questions [{:knowledge-point/id #uuid "11263ba1-2ef9-5c93-8c56-d09dcbea8f8b" :knowledge-point/title "Calculating the Sum of a Geometric Series Given Two Consecutive Terms of the Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e54e5c89-c83b-5423-b43e-83d1925f845c" :answer/type {:db/ident :answer.type/math} :answer/value "433" :db/id #edb/ref 17592186273422} {:answer/id #uuid "a90dcdb2-36c5-5b94-84b7-dfefb2a13566" :answer/type {:db/ident :answer.type/math} :answer/value "519" :db/id #edb/ref 17592186273423} {:answer/id #uuid "9095c23b-ff1e-5941-869d-8cabd48a59bd" :answer/type {:db/ident :answer.type/math} :answer/value "326" :db/id #edb/ref 17592186273424} {:answer/id #uuid "4fbaea85-2c65-5fc4-930b-de355262d977" :answer/type {:db/ident :answer.type/math} :answer/value "127" :db/id #edb/ref 17592186273425} {:answer/id #uuid "be06a76b-75fb-5b52-9651-8d15c24e78e8" :answer/type {:db/ident :answer.type/math} :answer/value "292" :db/id #edb/ref 17592186273426}] :answer-field/correct {:answer/id #uuid "4fbaea85-2c65-5fc4-930b-de355262d977" :answer/type {:db/ident :answer.type/math} :answer/value "127" :db/id #edb/ref 17592186273425} :answer-field/id #uuid "f5c6546d-012a-58a9-9649-b5c3fb0835c3" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274968}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "a1680abc-bbec-518f-a962-a951e4463528" :question/math-academy-id "q-73306" :question/problem "The fifth term of a geometric series is $4$ and the sixth term is $2.$ What is the sum of the first $7$ terms?" :question/worked-solution "The sum of the first $N$ terms of a geometric series is given by the formula\n\n$$\n{S}_{N}={a}_{1}\\frac{(1-{r}^{N})}{1-r},\n$$\n\nwhere ${a}_{1}$ is the first term of the series, and $r$ is the common ratio.\n\nTo find $r,$ we find the ratio between the consecutive terms ${a}_{5}$ and ${a}_{6}:$\n\n$$\n\\begin{aligned}r & =\\frac{{a}_{6}}{{a}_{5}} \\\\  & =\\frac{2}{4} \\\\  & =\\frac{1}{2}\\end{aligned}\n$$\n\nNow we must determine the value of ${a}_{1}.$ To do this, we use the formula for the $n$th term, which states that\n\n$$\n{a}_{n}={a}_{1}\\cdot {r}^{n-1}.\n$$\n\nFor $n=5,$ we get:\n\n$$\n\\begin{aligned}{a}_{5} & ={a}_{1}\\cdot {(\\frac{1}{2})}^{5-1} \\\\ 4 & ={a}_{1}\\cdot {(\\frac{1}{2})}^{4} \\\\ 4 & ={a}_{1}\\cdot \\frac{1}{16} \\\\ {a}_{1} & =\\frac{4}{(\\frac{1}{16})} \\\\ {a}_{1} & =64\\end{aligned}\n$$\n\nFinally, if we substitute ${a}_{1}=64,N=7$ and $r=\\frac{1}{2}$ into the formula for ${S}_{N},$ we obtain:\n\n$$\n\\begin{aligned}{S}_{7} & =64\\cdot \\frac{1-{(\\frac{1}{2})}^{7}}{1-\\frac{1}{2}} \\\\  & =64\\cdot \\frac{1-{(\\frac{1}{2})}^{7}}{\\frac{1}{2}} \\\\  & =\\frac{64}{(\\frac{1}{2})}\\cdot (1-\\frac{1}{128}) \\\\  & =128(1-\\frac{1}{128}) \\\\  & =128-1 \\\\  & =127\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286965 :knowledge-point/_questions [{:knowledge-point/id #uuid "4d63e99a-9db4-565e-97c5-ffc3090b0074" :knowledge-point/title "Calculating a Definite Integral of a Rational Function Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09e1f14f-36a3-5fb5-af37-568e066845ca" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(\\frac{5}{3})" :db/id #edb/ref 17592186286967} {:answer/id #uuid "de6eac51-5ed0-5ae3-ad45-4c8e808a1e68" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(\\frac{3}{2})" :db/id #edb/ref 17592186286968} {:answer/id #uuid "faf62a37-808a-5111-a65a-fbc2c71853dc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(\\frac{3}{2})" :db/id #edb/ref 17592186286969} {:answer/id #uuid "4aa26fc9-f7c0-536a-85e7-fb53721fb180" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(2)" :db/id #edb/ref 17592186286970} {:answer/id #uuid "7d956354-a411-5f73-9663-586be922e240" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(\\frac{5}{3})" :db/id #edb/ref 17592186286971}] :answer-field/correct {:answer/id #uuid "09e1f14f-36a3-5fb5-af37-568e066845ca" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(\\frac{5}{3})" :db/id #edb/ref 17592186286967} :answer-field/id #uuid "2d7d72e0-4d11-52ca-80cb-919ecfd57e61" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286966}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ba2d9110-9750-574a-89bb-6445eeb6564f" :question/math-academy-id "q-73432" :question/problem "Calculate the definite integral ${\\int }_{0}^{2}\\frac{{x}^{3}}{{x}^{4}+9}\\,\\text{d}x.$" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & ={x}^{4}+9 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =4{x}^{3} \\\\ \\text{d}u & =4{x}^{3}\\,\\text{d}x \\\\ \\frac{1}{4}\\text{d}u & ={x}^{3}\\,\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u={x}^{4}+9.$ \n\n$$\n\\begin{aligned}x & 0 & 2 \\\\ u & 9 & 25\\end{aligned}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{0}^{2}\\frac{1}{({x}^{4}+9)}\\,{x}^{3}\\,\\text{d}x={\\int }_{9}^{25}\\frac{1}{u}\\cdot \\frac{1}{4}\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{9}^{25}\\frac{1}{u}\\cdot \\frac{1}{4}\\text{d}u & =\\frac{1}{4}{\\int }_{9}^{25}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\operatorname{ln}⁡(u){|}_{9}^{25} \\\\  & =\\frac{1}{4}(\\operatorname{ln}⁡(25)-\\operatorname{ln}⁡(9)) \\\\  & =\\frac{1}{4}(\\operatorname{ln}⁡({5}^{2})-\\operatorname{ln}⁡({3}^{2})) \\\\  & =\\frac{1}{4}(2\\operatorname{ln}⁡(5)-2\\operatorname{ln}⁡(3)) \\\\  & =\\frac{1}{4}\\cdot 2(\\operatorname{ln}⁡(5)-\\operatorname{ln}⁡(3)) \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(\\frac{5}{3}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261529 :knowledge-point/_questions [{:knowledge-point/id #uuid "ed3b6c3d-b840-50ef-9e6b-584bf14877b3" :knowledge-point/title "More Complex Cases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fec0920f-bc0e-55cc-9453-d2370d91105a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\frac{2\\sqrt{{2}^{z}-9}}{\\operatorname{ln}2}+C)" :db/id #edb/ref 17592186273452} {:answer/id #uuid "de8df9e5-3393-5182-9b73-c2edbb2fb0f9" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\frac{2\\sqrt{{2}^{z}-9}}{\\operatorname{ln}2}+C)" :db/id #edb/ref 17592186273453} {:answer/id #uuid "b005af95-964b-506e-b1b3-d37eb8bf67d1" :answer/type {:db/ident :answer.type/math} :answer/value "3(\\frac{2\\sqrt{{2}^{z}-9}}{\\operatorname{ln}2}+C)" :db/id #edb/ref 17592186273454} {:answer/id #uuid "90730d15-747f-52e5-85f1-0b80c24c717f" :answer/type {:db/ident :answer.type/math} :answer/value "-(\\frac{2\\sqrt{{2}^{z}-9}}{\\operatorname{ln}2}+C)" :db/id #edb/ref 17592186273455} {:answer/id #uuid "c517daba-b3ed-507a-9f0c-a22b6d6e8c67" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{{2}^{z}-9}}{\\operatorname{ln}2}+C" :db/id #edb/ref 17592186273456}] :answer-field/correct {:answer/id #uuid "c517daba-b3ed-507a-9f0c-a22b6d6e8c67" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{{2}^{z}-9}}{\\operatorname{ln}2}+C" :db/id #edb/ref 17592186273456} :answer-field/id #uuid "53d2a103-dde2-51d2-8360-99e666136b32" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274974}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "cf6e7469-a047-53fb-9915-fd6e8f55046c" :question/math-academy-id "q-73670" :question/problem "Calculate the integral $\\int \\frac{{2}^{z}}{\\sqrt{{2}^{z}-9}}\\,\\text{d}z.$" :question/worked-solution "Let's introduce the new variable $u={2}^{z}-9.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}z}={2}^{z}\\operatorname{ln}2\\,⟹\\,\\frac{1}{\\operatorname{ln}2}\\,\\text{d}u={2}^{z}\\,\\text{d}z.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{{2}^{z}}{\\sqrt{{2}^{z}-9}}\\,\\text{d}z & =\\int \\frac{1}{\\sqrt{{2}^{z}-9}}\\cdot {2}^{z}\\,\\text{d}z \\\\  & =\\int \\frac{1}{\\operatorname{ln}2}\\cdot \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =\\frac{1}{\\operatorname{ln}2}\\int {u}^{-1/2}\\,\\text{d}u \\\\  & =\\frac{1}{\\operatorname{ln}2}\\cdot \\frac{{u}^{1/2}}{(\\frac{1}{2})} \\\\  & =\\frac{2\\sqrt{{2}^{z}-9}}{\\operatorname{ln}2}+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261574 :knowledge-point/_questions [{:knowledge-point/id #uuid "9afc8277-0fcd-5fdd-9ced-a8de9e5d4168" :knowledge-point/title "Determining Whether a Piecewise Infinite Series Converges or Diverges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62c93bf3-207c-59ce-a1b9-e78bffd77c61" :answer/type {:db/ident :answer.type/text} :answer/value "Diverges" :db/id #edb/ref 17592186261576} {:answer/id #uuid "f17b3011-3910-51b9-b03b-b12b6857b9f5" :answer/type {:db/ident :answer.type/text} :answer/value "Converges" :db/id #edb/ref 17592186261577}] :answer-field/correct {:answer/id #uuid "62c93bf3-207c-59ce-a1b9-e78bffd77c61" :answer/type {:db/ident :answer.type/text} :answer/value "Diverges" :db/id #edb/ref 17592186261576} :answer-field/id #uuid "c4cbd5f5-4303-5bab-a71c-9e19c41003cc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186261575}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c6c03b37-a458-5686-aa0d-f791bd5b116f" :question/math-academy-id "q-75133" :question/problem "Given that the sequence ${a}_{n}$ is defined by\n\n$$\n{a}_{n}={\\begin{aligned}0,\\,n=1 \\\\ 1,\\,n=2 \\\\ -2,\\,n\\ge 3,\\end{aligned}\n$$\n\ndoes ${\\sum }_{n=1}^{\\infty }{a}_{n}$ converge or diverge? If it converges, what is the sum of the series?" :question/worked-solution "Let's compute the first few partial sums:\n\n$$\n\\begin{aligned}{s}_{1} & =0 \\\\ {s}_{2} & =0+1=1 \\\\ {s}_{3} & =1-2=-1 \\\\ {s}_{4} & =-1-2=-3 \\\\ {s}_{5} & =-3-2=-5\\end{aligned}\n$$\n\nLooking at the sequence of partial sums, we can see that the formula for the $n$th partial sum for $n\\ge 3$ is\n\n$$\n{s}_{n}=1-2(n-2)=5-2n.\n$$\n\nThe sequence of partial sums is divergent:\n\n$$\n{lim}_{n\\to \\infty }{s}_{n}={lim}_{n\\to \\infty }(5-2n)=-\\infty \n$$\n\nTherefore, the series ${\\sum }_{n=1}^{\\infty }{a}_{n}$ diverges."}] [{:db/id #edb/ref 17592186261704 :knowledge-point/_questions [{:knowledge-point/id #uuid "9f783fe8-8f52-5f93-adef-bf4bd030fea0" :knowledge-point/title "Writing the Equation of a Vertical Hyperbola in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7fe253a0-ed5d-5555-b285-435327a0f166" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y^2}{10}-\\frac{x^2}{8}=-(1)" :db/id #edb/ref 17592186273676} {:answer/id #uuid "33fb4628-7add-51c2-934b-71d0cf67b7a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y^2}{10}-\\frac{x^2}{8}=1" :db/id #edb/ref 17592186273677} {:answer/id #uuid "8c3d7ac6-be3e-5b00-8eea-08be847d1662" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y^2}{10}-\\frac{x^2}{8}=\\frac{1}{2}(1)" :db/id #edb/ref 17592186273678} {:answer/id #uuid "99679d3b-293c-5c7c-bae4-e47e93374f1d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y^2}{10}-\\frac{x^2}{8}=3(1)" :db/id #edb/ref 17592186273679} {:answer/id #uuid "ca192385-d364-5616-b55d-a35d7e2f24fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y^2}{10}-\\frac{x^2}{8}=2(1)" :db/id #edb/ref 17592186273680}] :answer-field/correct {:answer/id #uuid "33fb4628-7add-51c2-934b-71d0cf67b7a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y^2}{10}-\\frac{x^2}{8}=1" :db/id #edb/ref 17592186273677} :answer-field/id #uuid "8d9fa9ac-68d1-54f9-892f-67d0b3e6e2ed" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275019}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "fa7228ce-645a-52a8-9a40-e535c79572db" :question/math-academy-id "q-78257" :question/problem "Write the equation of the hyperbola $4{y}^{2}-5{x}^{2}=40$ in standard form." :question/worked-solution "The Cartesian equation of a vertical hyperbola centered at the origin is\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1.\n$$\n\nTherefore, to write the equation of the hyperbola in standard form, we need to divide both sides of the equation by $40$ and then simplify, as follows:\n\n$$\n\\begin{aligned}4{y}^{2}-5{x}^{2} & =40 \\\\ \\frac{4{y}^{2}}{40}-\\frac{5{x}^{2}}{40} & =\\frac{40}{40} \\\\ \\frac{{y}^{2}}{10}-\\frac{{x}^{2}}{8} & =1\\end{aligned}\n$$"}]}
