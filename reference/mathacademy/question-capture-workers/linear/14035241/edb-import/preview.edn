xt{i} & 2\\end{aligned}]\\,$ and $\\,x=[\\begin{aligned}1+2\\text{i} \\\\ 1-\\text{i}\\end{aligned}]\\,$, then $\\,Ax=$" 13194139534549 true] [17592186294379 1113 #uuid "93cd3e49-db0b-5ee5-918c-8c97827d57f3" 13194139534549 true] [17592186294379 1145 "Multiplying the matrix by the vector using the usual method, we get\n\n$$\n\\begin{aligned}Ax & =[\\begin{aligned}\\text{i} & 2-\\text{i} \\\\ 1-2\\text{i} & 2\\end{aligned}]\\cdot [\\begin{aligned}1+2\\text{i} \\\\ 1-\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}\\text{i}(1+2\\text{i})+(2-\\text{i})(1-\\text{i}) \\\\ (1-2\\text{i})(1+2\\text{i})+2(1-\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}(\\text{i}-2)+(1-3\\text{i}) \\\\ 5+(2-2\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}-1-2\\text{i} \\\\ 7-2\\text{i}\\end{aligned}].\\end{aligned}\n$$" 13194139534549 true] [17592186294380 1000 #edb/ref 17592186294381 13194139534549 true] [17592186294380 1000 #edb/ref 17592186294382 13194139534549 true] [17592186294380 1000 #edb/ref 17592186294383 13194139534549 true] [17592186294380 1000 #edb/ref 17592186294384 13194139534549 true] [17592186294380 1000 #edb/ref 17592186294385 13194139534549 true] [17592186294380 1040 #edb/ref 17592186045450 13194139534549 true] [17592186294380 1041 "selection" 13194139534549 true] [17592186294380 1104 #edb/ref 17592186294384 13194139534549 true] [17592186294380 1110 #uuid "79d7745d-f9d6-5352-a971-0ad567d7937d" 13194139534549 true] [17592186294381 1034 "[\\begin{aligned}-7-2\\text{i} \\\\ 1-2\\text{i}\\end{aligned}]" 13194139534549 true] [17592186294381 1103 #edb/ref 17592186045453 13194139534549 true] [17592186294381 1111 #uuid "a9921209-dae9-5088-9de7-05c7fd47e501" 13194139534549 true] [17592186294382 1034 "[\\begin{aligned}1+2\\text{i} \\\\ -7+2\\text{i}\\end{aligned}]" 13194139534549 true] [17592186294382 1103 #edb/ref 17592186045453 13194139534549 true] [17592186294382 1111 #uuid "3754d50a-db5d-5ff0-b7b6-372317e63a2c" 13194139534549 true] [17592186294383 1034 "[\\begin{aligned}7-2\\text{i} \\\\ -1-2\\text{i}\\end{aligned}]" 13194139534549 true] [17592186294383 1103 #edb/ref 17592186045453 13194139534549 true] [17592186294383 1111 #uuid "c9681e1b-016c-5383-b6d6-a29ae4e874ee" 13194139534549 true] [17592186294384 1034 "[\\begin{aligned}-1-2\\text{i} \\\\ 7-2\\text{i}\\end{aligned}]" 13194139534549 true] [17592186294384 1103 #edb/ref 17592186045453 13194139534549 true] [17592186294384 1111 #uuid "bd707435-20e3-5699-af51-97510db3a9ad" 13194139534549 true] [17592186294385 1034 "[\\begin{aligned}-1+2\\text{i} \\\\ 7+2\\text{i}\\end{aligned}]" 13194139534549 true] [17592186294385 1103 #edb/ref 17592186045453 13194139534549 true] [17592186294385 1111 #uuid "4fb85375-392a-5d81-a298-78fb82c7fe13" 13194139534549 true] [17592186294386 1017 #edb/ref 17592186294387 13194139534549 true] [17592186294386 1089 "q-77433" 13194139534549 true] [17592186294386 1091 #edb/ref 17592186045465 13194139534549 true] [17592186294386 1100 "Find a vector equation of the line that passes through the points $A(1,1,0)$ and $B(3,-1,2).$" 13194139534549 true] [17592186294386 1113 #uuid "e77266e3-e110-5646-9023-0f09c4f4c827" 13194139534549 true] [17592186294386 1145 "The vector equation of the straight line passing through $A$ and parallel to $v$ is given by\n\n$$\nr=a+tv,\n$$\n\nwhere $t\\in (-\\infty ,\\infty )$ and $a$ is the position vector of $A.$ \n\nWe can find a direction vector by computing the displacement vector between the given points $A(1,1,0)$ and $B(3,-1,2)$, as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{AB} \\\\  & =⟨3,-1,2⟩-⟨1,1,0⟩ \\\\  & =⟨2,-2,2⟩\\end{aligned}\n$$\n\nTherefore, the vector equation of the line is given by\n\n$$\n\\begin{aligned}r & =[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]+t[\\begin{aligned}2 \\\\ -2 \\\\ 2\\end{aligned}],\\,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" 13194139534549 true] [17592186294387 1000 #edb/ref 17592186294388 13194139534549 true] [17592186294387 1000 #edb/ref 17592186294389 13194139534549 tr