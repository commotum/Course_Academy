torname{sin}⁡x}{2}.\\end{aligned}\n$$" :question/answer-fields ["q-141281/selection/ma-v1/9723f48e4e745674e4460ba92ef4a9f38cf3ad7fe7fcdde356528c4afa71e2db"] :db/ensure [:question/validate]} [:db/retract 17592186260869 :question/answer-fields 17592186274816] {:db/id "q-65502/selection/ma-v1/150df31c6cff514d2ae5bd47c0d4f1324dd7e481f52d31475a090738d8cddad8/52439feb171929ea61e70c567803be74b9bd63b68d911342f45b3f12653bfaa6" :answer/id #uuid "a8890cb1-796d-5e73-9f8e-477954728915" :answer/type :answer.type/math :answer/value "\\frac{1}{2}(\\operatorname{cos}⁡x-\\sqrt{3}\\operatorname{sin}⁡x)" :db/ensure [:answer/validate]} {:db/id "q-65502/selection/ma-v1/150df31c6cff514d2ae5bd47c0d4f1324dd7e481f52d31475a090738d8cddad8/9b9441bd8ca17246b54874e49f7ad4f0b5918065d0b673a0e2e330a7f17cdb2e" :answer/id #uuid "f886e3e2-bc69-5e9f-8cd6-9f9f6b4e1c40" :answer/type :answer.type/math :answer/value "\\frac{1}{2}(\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)" :db/ensure [:answer/validate]} {:db/id "q-65502/selection/ma-v1/150df31c6cff514d2ae5bd47c0d4f1324dd7e481f52d31475a090738d8cddad8/350e6e757841783cbf07500c572734a3b099e28cb67a2ee8ff2c5e5241fc3107" :answer/id #uuid "6b40c74f-5636-54fa-8e48-1cc8dc48453b" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}(\\operatorname{cos}⁡x+\\sqrt{3}\\operatorname{sin}⁡x)" :db/ensure [:answer/validate]} {:db/id "q-65502/selection/ma-v1/150df31c6cff514d2ae5bd47c0d4f1324dd7e481f52d31475a090738d8cddad8/1e75b138a6cedf7ed99f36d01e593bc726bd7c57f1b393224a065a8efef239e7" :answer/id #uuid "2f10507d-8411-501b-bf2a-099f1599108a" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)" :db/ensure [:answer/validate]} {:db/id "q-65502/selection/ma-v1/150df31c6cff514d2ae5bd47c0d4f1324dd7e481f52d31475a090738d8cddad8/ce676beb78c3ff8140fbbfe4ff3bcfab106b8b33786d3d2ea6277adab90b7003" :answer/id #uuid "ef9f71ba-6aae-578e-ae86-a1f2d811e951" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)" :db/ensure [:answer/validate]} {:db/id "q-65502/selection/ma-v1/150df31c6cff514d2ae5bd47c0d4f1324dd7e481f52d31475a090738d8cddad8" :answer-field/id #uuid "0028443c-1e65-58fd-b318-c517c386e7d7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-65502/selection/ma-v1/150df31c6cff514d2ae5bd47c0d4f1324dd7e481f52d31475a090738d8cddad8/350e6e757841783cbf07500c572734a3b099e28cb67a2ee8ff2c5e5241fc3107" :answer-field/choices ["q-65502/selection/ma-v1/150df31c6cff514d2ae5bd47c0d4f1324dd7e481f52d31475a090738d8cddad8/52439feb171929ea61e70c567803be74b9bd63b68d911342f45b3f12653bfaa6" "q-65502/selection/ma-v1/150df31c6cff514d2ae5bd47c0d4f1324dd7e481f52d31475a090738d8cddad8/9b9441bd8ca17246b54874e49f7ad4f0b5918065d0b673a0e2e330a7f17cdb2e" "q-65502/selection/ma-v1/150df31c6cff514d2ae5bd47c0d4f1324dd7e481f52d31475a090738d8cddad8/350e6e757841783cbf07500c572734a3b099e28cb67a2ee8ff2c5e5241fc3107" "q-65502/selection/ma-v1/150df31c6cff514d2ae5bd47c0d4f1324dd7e481f52d31475a090738d8cddad8/1e75b138a6cedf7ed99f36d01e593bc726bd7c57f1b393224a065a8efef239e7" "q-65502/selection/ma-v1/150df31c6cff514d2ae5bd47c0d4f1324dd7e481f52d31475a090738d8cddad8/ce676beb78c3ff8140fbbfe4ff3bcfab106b8b33786d3d2ea6277adab90b7003"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-65502"] :question/problem "$\\operatorname{cos}⁡(x+\\frac{2\\pi }{3})=$" :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u+v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the sum formula for cosine with $u=x$ and $v=\\frac{2\\pi }{3}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x+\\frac{2\\pi }{3}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡(\\frac{2\\pi }{3})-\\operatorname{sin}⁡x\\operatorname{sin}⁡(\\frac{2\\pi }{3}) \\\\  & =\\operatorname{cos}⁡x\\cdot (-\\frac{1}{2})-\\operatorname{sin}⁡x\\cdot (\\frac{\\sqrt{3}}{2}) \\\\  & =-\\frac{1}{2}(\\operatorname{cos}⁡x+\\sqrt{3}\\operatorname{sin}⁡x).\\end{aligned}\n$$" :question/answer-fields ["q-65502/selection/ma-v1/150df31c6cff514d2ae5bd47c0d4f1324dd7e481f52d31475a090738d8cddad8"] :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-113944"] :question/problem "$\\int ({sec}^{2}⁡x-2\\operatorname{csc}⁡x\\operatorname{cot}⁡x)\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x & =-\\operatorname{csc}⁡x+C \\\\ \\int {sec}^{2}⁡x\\,\\text{d}x & =\\operatorname{tan}⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int ({sec}^{2}⁡x-2\\operatorname{csc}⁡x\\operatorname{cot}⁡x)\\,\\text{d}x & =\\int {sec}^{2}⁡x\\,\\text{d}x-2\\int \\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x \\\\  & =\\operatorname{tan}⁡x-2(-\\operatorname{csc}⁡x)+C \\\\  & =\\operatorname{tan}⁡x+2\\operatorname{csc}⁡x+C.\\end{aligned}\\end{aligned}\n$$" :db/ensure [:question/validate]} [:db/retract 17592186256857 :question/answer-fields 17592186274243] {:db/id "q-112044/selection/ma-v1/667669f63786159e20920946c39130b48feec90ebd98596d5231f0a3c1349cf9/a92bc7804786054eb7fc504a46163f39807c4fd0d0b33313f16f177468714f2a" :answer/id #uuid "79bf5014-de53-5906-b5c8-f2dbc24f0938" :answer/type :answer.type/math :answer/value "(3{m}^{2}+{n}^{2})(3m-n)^{2}" :db/ensure [:answer/validate]} {:db/id "q-112044/selection/ma-v1/667669f63786159e20920946c39130b48feec90ebd98596d5231f0a3c1349cf9/78ddfc229c627aad6b7026758edb1862ddf0839579fd79ca779ac09201cc9f38" :answer/id #uuid "39cfafe3-9cb9-5989-9bf5-a4a6b4d03ea4" :answer/type :answer.type/math :answer/value "(9{m}^{2}+{n}^{2})(3m+n)(3m-n)" :db/ensure [:answer/validate]} {:db/id "q-112044/selection/ma-v1/667669f63786159e20920946c39130b48feec90ebd98596d5231f0a3c1349cf9/f05806a52f843775c50cfabf74ff886cc7a5be61648ec7bee03e3690a40bca2b" :answer/id #uuid "f46cfd6f-87ea-5e12-a7a8-01