[{:db/id "q-641/selection/07ff617f470ea58028ecfddcf410a7d8f9184f37844168633a9eafca70784fb0" :answer/id #uuid "f33fd02c-497d-504e-9ae9-6f2b5f6b9839" :answer/type :answer.type/math :answer/value "3+\\sqrt{3}\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-641/selection/982757d1b6123a2602f3f4108e31d13b04dde4123aa2659b57e9f1e2992c3f6b" :answer/id #uuid "f09cdef1-a9c3-561f-b3b4-c29d7234de11" :answer/type :answer.type/math :answer/value "3-5\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-641/selection/678191095307e0008c18a06c03adbd1b481fff21f6c2b79f07941866fe419896" :answer/id #uuid "67e1c1c2-2971-5bde-9063-81842866aac4" :answer/type :answer.type/math :answer/value "3+5\\sqrt{3}\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-641/selection/dc77907bafa33ab7e70810273b78ab735a0208242bf77432fbe237af85ffa331" :answer/id #uuid "30a7abb8-a769-50e1-a912-10e98d5342eb" :answer/type :answer.type/math :answer/value "3-\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-641/selection/283777d927a7ac3bf07e3b7d7fc549f72acf5b21213b5582481a34d6b263754e" :answer/id #uuid "74c6932a-d6f4-54f4-aad5-dbcc5564d2eb" :answer/type :answer.type/math :answer/value "3+5\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-641/selection" :answer-field/id #uuid "4130c88a-b92e-50e6-8964-32d85675b281" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-641/selection/678191095307e0008c18a06c03adbd1b481fff21f6c2b79f07941866fe419896" :answer-field/choices ["q-641/selection/07ff617f470ea58028ecfddcf410a7d8f9184f37844168633a9eafca70784fb0" "q-641/selection/982757d1b6123a2602f3f4108e31d13b04dde4123aa2659b57e9f1e2992c3f6b" "q-641/selection/678191095307e0008c18a06c03adbd1b481fff21f6c2b79f07941866fe419896" "q-641/selection/dc77907bafa33ab7e70810273b78ab735a0208242bf77432fbe237af85ffa331" "q-641/selection/283777d927a7ac3bf07e3b7d7fc549f72acf5b21213b5582481a34d6b263754e"] :db/ensure [:answer-field/validate]} {:db/id "q-641" :question/id #uuid "872ca040-750e-56cb-8f16-1a83b695a834" :question/math-academy-id "q-641" :question/problem "$(7+\\sqrt{-27})-(4-\\sqrt{-12})=$" :question/worked-solution "Given the complex number $a+b\\,\\text{i},$ $a$ represents its real part while $b$ represents its imaginary part.\n\nTo add or subtract complex numbers, we add or subtract their real parts, and we add or subtract their imaginary parts.\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(7+\\sqrt{-27})-(4-\\sqrt{-12}) & =(7+\\sqrt{9\\cdot 3}\\,\\text{i})-(4-\\sqrt{4\\cdot 3}\\,\\text{i}) \\\\  & =(7+3\\sqrt{3}\\,\\text{i})-(4-2\\sqrt{3}\\,\\text{i}) \\\\  & =(7-4)+(3\\sqrt{3}-(-2\\sqrt{3}))\\,\\text{i} \\\\  & =3+(3\\sqrt{3}+2\\sqrt{3})\\,\\text{i} \\\\  & =3+5\\sqrt{3}\\,\\text{i}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-641/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8246fcfc-c7fb-51e8-826a-ed4e88665706"] :knowledge-point/questions ["q-641"] :db/ensure [:knowledge-point/validate]} {:db/id "q-101417/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "f08499b8-d38b-557d-83fb-451ce3eac732" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-101417/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "b3ac1cc3-16ca-5657-b07f-633d638bc2ea" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-101417/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "fc0d2878-365e-5c00-8eb8-e6c896cd2249" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-101417/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "ffd71fc7-7dd0-594b-9a9e-18b3c358d8f7" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-101417/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "f2988f4d-c60d-5c79-8a12-3bc7ecb9b924" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-101417/selection" :answer-field/id #uuid "92fbf9d8-c1e1-5ee1-9dcd-80f58cd34bf8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-101417/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer-field/choices ["q-101417/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-101417/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-101417/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" "q-101417/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-101417/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133"] :db/ensure [:answer-field/validate]} {:db/id "q-101417" :question/id #uuid "3893bb9a-24bf-5f2a-8cb4-667c5be755d4" :question/math-academy-id "q-101417" :question/problem "Let $u=[\\begin{aligned}9 \\\\ 2x\\end{aligned}]$ and $v=[\\begin{aligned}-2 \\\\ x\\end{aligned}].$ Given that $u⊥v$ and $x<0$, find the value of $x.$" :question/worked-solution "We know that $u⊥v$ ($u$ and $v$ are perpendicular) if and only if $u\\cdot v=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}u\\cdot v & ={u}_{x}\\cdot {v}_{x}+{u}_{y}\\cdot {v}_{y} \\\\  & =9\\cdot (-2)+2x\\cdot x \\\\  & =-18+2{x}^{2}.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}u\\cdot v & =0 \\\\ -18+2{x}^{2} & =0 \\\\ 2{x}^{2} & =18 \\\\ {x}^{2} & =9 \\\\ x & =\\pm 3\\end{aligned}\n$$\n\nWe disregard the positive solution since we are told that $x<0.$ Therefore, $x=-3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-101417/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8bff08bf-003