swer-field.type/radio :answer-field/correct "q-119865/selection/ma-v1/b6e7992febf5af0afa7f2bce5809eebb26984b2b4679e66752fc0827bcf3130b/c6320ec392e90656124bec836a388a81515802396f2025168d0ca9dac75dacd2" :answer-field/choices ["q-119865/selection/ma-v1/b6e7992febf5af0afa7f2bce5809eebb26984b2b4679e66752fc0827bcf3130b/c6320ec392e90656124bec836a388a81515802396f2025168d0ca9dac75dacd2" "q-119865/selection/ma-v1/b6e7992febf5af0afa7f2bce5809eebb26984b2b4679e66752fc0827bcf3130b/4b78b54cc79d738bb71be97b90261f1c938c6d65d5d5612895882837caabe921" "q-119865/selection/ma-v1/b6e7992febf5af0afa7f2bce5809eebb26984b2b4679e66752fc0827bcf3130b/35c0d04af9622de3840be4b9057e0e217b5b397382260d5721b234450e0a3153" "q-119865/selection/ma-v1/b6e7992febf5af0afa7f2bce5809eebb26984b2b4679e66752fc0827bcf3130b/376b7e6657094b6f27cfd097d0316675d1ce4f8d239bebcb30613cfcfa6702c5" "q-119865/selection/ma-v1/b6e7992febf5af0afa7f2bce5809eebb26984b2b4679e66752fc0827bcf3130b/9f5d6ebc37e3e9c474831c3dab83213664bb8cf4a3a0293e6f1120f4e65ce5bb"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-119865"] :question/problem "Simplify $\\frac{{sin}^{2}⁡x}{1-\\operatorname{cos}⁡x}-1$" :question/worked-solution "First, we rewrite the numerator of the first term using $1-{cos}^{2}⁡x={sin}^{2}⁡x.$\n\n$$\n\\frac{{sin}^{2}⁡x}{1-\\operatorname{cos}⁡x}-1=\\frac{1-{cos}^{2}⁡x}{1-\\operatorname{cos}⁡x}-1\n$$\n\nNext, we factor the numerator of the first term as a difference of squares, and simplify:\n\n$$\n\\begin{aligned}\\frac{1-{cos}^{2}⁡x}{1-\\operatorname{cos}⁡x}-1 & =\\frac{(1-\\operatorname{cos}⁡x)(1+\\operatorname{cos}⁡x)}{1-\\operatorname{cos}⁡x}-1 \\\\  & =\\frac{\\cancel{(1-\\operatorname{cos}⁡x)}(1+\\operatorname{cos}⁡x)}{\\cancel{1-\\operatorname{cos}⁡x}}-1 \\\\  & =\\frac{1+\\operatorname{cos}⁡x}{1}-1 \\\\  & =1+\\operatorname{cos}⁡x-1 \\\\  & =\\operatorname{cos}⁡x\\end{aligned}\n$$" :question/answer-fields ["q-119865/selection/ma-v1/b6e7992febf5af0afa7f2bce5809eebb26984b2b4679e66752fc0827bcf3130b"] :db/ensure [:question/validate]} [:db/retract 17592186258090 :question/answer-fields 17592186274463] {:db/id "q-141281/selection/ma-v1/9723f48e4e745674e4460ba92ef4a9f38cf3ad7fe7fcdde356528c4afa71e2db/4b098d8883ebf2ba53c3601846fe278f4795f8ac00c0d681adaeae0c20d765d8" :answer/id #uuid "5c800bf1-db0e-5a4f-b1f7-79de46c24ed9" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x}{2}" :db/ensure [:answer/validate]} {:db/id "q-141281/selection/ma-v1/9723f48e4e745674e4460ba92ef4a9f38cf3ad7fe7fcdde356528c4afa71e2db/5e2dade78e1cff22f8fb22194941190915731ffe16f81b89cc90d798cb2e0027" :answer/id #uuid "7bdc1a32-3ddc-5b62-b443-798708784e12" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)}{2}" :db/ensure [:answer/validate]} {:db/id "q-141281/selection/ma-v1/9723f48e4e745674e4460ba92ef4a9f38cf3ad7fe7fcdde356528c4afa71e2db/f0c2bd5d925ee1ef1b7ee0eb315286445d2b385b93bddea08ad1fcbcfc7ebc22" :answer/id #uuid "976eda39-25fa-5c0c-ada1-63cab5aa0334" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}(\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)}{2}" :db/ensure [:answer/validate]} {:db/id "q-141281/selection/ma-v1/9723f48e4e745674e4460ba92ef4a9f38cf3ad7fe7fcdde356528c4afa71e2db/c843592faadf2d42b42dd58ccc28f8a0ffce9bf51591b76fed91e91714507a58" :answer/id #uuid "2ee8162a-22a0-5c9e-b9db-f9b656661d56" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{sin}⁡x-\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/ensure [:answer/validate]} {:db/id "q-141281/selection/ma-v1/9723f48e4e745674e4460ba92ef4a9f38cf3ad7fe7fcdde356528c4afa71e2db/bfeb8bc7697b49e21563a1ae24d3100f7c8e69ac73b008bd6515d938828f8867" :answer/id #uuid "8fbfce8f-1539-5097-be10-dbae597cac5a" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x}{2}" :db/ensure [:answer/validate]} {:db/id "q-141281/selection/ma-v1/9723f48e4e745674e4460ba92ef4a9f38cf3a