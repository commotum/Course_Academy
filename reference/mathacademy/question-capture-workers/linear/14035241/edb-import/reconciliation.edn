-3.2\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978659/state.json" "file_sha256" "5d202b35250385a2fb2656559dcf5f4a0b5ce8cd4ea309239a368884332ab69c" "basis" 840 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978659/edb-import/verification.json"} {"question" "q-41944" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978659/activity-metadata.json" "file_sha256" "4365440057493f60dc29fe8f63f7736b97744b7a6b03774345cdab7e0f4a7dd7" "basis" 840 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978659/edb-import/verification.json"} {"question" "q-41944" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978659/state.json" "file_sha256" "5d202b35250385a2fb2656559dcf5f4a0b5ce8cd4ea309239a368884332ab69c" "basis" 840 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978659/edb-import/verification.json"} {"question" "q-41944" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}-3 & 2\\sqrt{2} & -3.2\\end{aligned}]"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978659/state.json" "file_sha256" "5d202b35250385a2fb2656559dcf5f4a0b5ce8cd4ea309239a368884332ab69c" "basis" 840 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978659/edb-import/verification.json"} {"question" "q-41944" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}0 & 1 & -\\sqrt{3}\\end{aligned}]"] "category" "ma_capture" "