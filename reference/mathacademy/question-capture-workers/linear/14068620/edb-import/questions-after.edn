#{[{:db/id #edb/ref 17592186357821 :knowledge-point/_questions [{:knowledge-point/id #uuid "164c56ea-afbb-5ce4-800a-19002695db76" :knowledge-point/title "Calculating the Determinant of the Inverse of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cdd717ce-edfc-5edd-b0eb-452ebf3fc9bd" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186357823} {:answer/id #uuid "b36703d2-3027-5e81-b805-df9f58e5c925" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186357824} {:answer/id #uuid "b6cdf8c0-7bc3-569f-8653-4f2b52808616" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186357825} {:answer/id #uuid "adc39493-fce0-57e9-b913-85b48c69a400" :answer/type {:db/ident :answer.type/math} :answer/value "-45" :db/id #edb/ref 17592186357826} {:answer/id #uuid "a69ce41f-611c-540e-9f80-506d5789bc81" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186357827}] :answer-field/correct {:answer/id #uuid "cdd717ce-edfc-5edd-b0eb-452ebf3fc9bd" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186357823} :answer-field/id #uuid "da580575-0cfb-50ca-a650-ff04847ffcee" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357822}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "18a0ba50-4a2e-5bdc-b928-f30ebbc43507" :question/math-academy-id "q-130631" :question/problem "Let $A,$ $B,$ and $C$ be square matrices. If $A=B\\cdot C,$  $|B|=-15$ and $|{C}^{-1}|=3$, find $|A|.$" :question/worked-solution "Given two $n\\times n$ matrices $M$ and $N,$ we have\n\n$$\ndet(MN)=det(M)\\cdot det(N).\n$$\n\nAlso, given an invertible $n\\times n$ matrix $M,$ we have\n\n$$\ndet({M}^{-1})=\\frac{1}{det(M)}.\n$$\n\nSince $|C|=\\frac{1}{|{C}^{-1}|}$, we get $|C|=\\frac{1}{3}.$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}|A| & =|B|\\cdot |C| \\\\  & =(-15)\\cdot (\\frac{1}{3}) \\\\  & =-5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186357828 :knowledge-point/_questions [{:knowledge-point/id #uuid "164c56ea-afbb-5ce4-800a-19002695db76" :knowledge-point/title "Calculating the Determinant of the Inverse of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c0937a2b-c2c9-5851-95f8-98906380fb1a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{13}" :db/id #edb/ref 17592186357830} {:answer/id #uuid "6ef1e9d3-d0ca-5136-bfc7-7818d2922e72" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{6}" :db/id #edb/ref 17592186357831} {:answer/id #uuid "3af95393-2575-5229-bc05-c6f36fb0b54d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{7}" :db/id #edb/ref 17592186357832} {:answer/id #uuid "8ce046a4-1ded-5ee3-8d1b-d7366349cab1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186357833} {:answer/id #uuid "62b29e01-141e-5f84-9c47-b2cfbf282d19" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{21}" :db/id #edb/ref 17592186357834}] :answer-field/correct {:answer/id #uuid "6ef1e9d3-d0ca-5136-bfc7-7818d2922e72" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{6}" :db/id #edb/ref 17592186357831} :answer-field/id #uuid "a8d9f240-e780-5c74-b003-2aa3f0d7d460" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357829}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "87beaefa-a44a-5f78-b5fb-0779a6230df3" :question/math-academy-id "q-42579" :question/problem "Find $|{A}^{-1}|,$ if $A=[\\begin{aligned}0 & 6 & -3 \\\\ -12 & -2 & 0 \\\\ 1 & 0 & 0\\end{aligned}].$" :question/worked-solution "Given an invertible $n\\times n$ matrix $A,$ we have\n\n$$\n|{A}^{-1}|=\\frac{1}{|A|}.\n$$\n\nFirst, we find $|A|$ using a Laplace expansion across the $3$rd row:\n\n$$\n\\begin{aligned}|A| & =|\\begin{aligned}0 & 6 & -3 \\\\ -12 & -2 & 0 \\\\ 1 & 0 & 0\\end{aligned}| \\\\  & =1\\cdot (-1)^{3+1}\\cdot |\\begin{aligned}6 & -3 \\\\ -2 & 0\\end{aligned}| \\\\  & =1\\cdot (-6) \\\\  & =-6\\end{aligned}\n$$\n\nTherefore, we obtain \n\n$$\n|{A}^{-1}|=\\frac{1}{|A|}=-\\frac{1}{6}.\n$$"}] [{:db/id #edb/ref 17592186120384 :knowledge-point/_questions [{:knowledge-point/id #uuid "6e4dd07e-475b-5c89-883b-0e4adcf6a723" :knowledge-point/title "Calculating a Determinant Using the Linearity of the Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a473de6b-e105-54ad-a3d3-cd848c9fa174" :answer/type {:db/ident :answer.type/math} :answer/value "-434" :db/id #edb/ref 17592186118780} {:answer/id #uuid "b10842f6-2964-50f1-813d-4866313b501e" :answer/type {:db/ident :answer.type/math} :answer/value "440" :db/id #edb/ref 17592186118781} {:answer/id #uuid "eb32c05b-7f47-53cb-94de-43d8c2552a1e" :answer/type {:db/ident :answer.type/math} :answer/value "2146" :db/id #edb/ref 17592186118782} {:answer/id #uuid "057e7ae0-9d00-5f9b-91d0-5e6e0b2d9be8" :answer/type {:db/ident :answer.type/math} :answer/value "-424" :db/id #edb/ref 17592186118783} {:answer/id #uuid "3c198142-a365-57a6-be8e-4b9baa7abc71" :answer/type {:db/ident :answer.type/math} :answer/value "870" :db/id #edb/ref 17592186118784}] :answer-field/correct {:answer/id #uuid "a473de6b-e105-54ad-a3d3-cd848c9fa174" :answer/type {:db/ident :answer.type/math} :answer/value "-434" :db/id #edb/ref 17592186118780} :answer-field/id #uuid "20347eac-3ea6-558e-afc8-1a25a371d31a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186118779}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "6ac6b8ae-6cc0-5802-bd63-e9b3982c4a3a" :question/math-academy-id "q-43097" :question/problem "$|\\begin{aligned}107 & 215 & 99 \\\\ 6 & 8 & 11 \\\\ 107 & 215 & 100\\end{aligned}|=$" :question/worked-solution "First, notice that the $1$st row of our determinant is almost equal to the $3$rd row. So, we can rewrite the given determinant, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}107 & 215 & 99 \\\\ 6 & 8 & 11 \\\\ 107 & 215 & 100\\end{aligned}| & =|\\begin{aligned}107 & 215 & 99 \\\\ 6 & 8 & 11 \\\\ 107+0 & 215+0 & 99+1\\end{aligned}|\\end{aligned}\n$$\n\nNext, using the linearity property of determinants, we obtain\n\n$$\n\\begin{aligned}|\\begin{aligned}107 & 215 & 99 \\\\ 6 & 8 & 11 \\\\ 107+0 & 215+0 & 99+1\\end{aligned}| & =|\\begin{aligned}107 & 215 & 99 \\\\ 6 & 8 & 11 \\\\ 107 & 215 & 99\\end{aligned}|+|\\begin{aligned}107 & 215 & 99 \\\\ 6 & 8 & 11 \\\\ 0 & 0 & 1\\end{aligned}|.\\end{aligned}\n$$\n\nThe first determinant must be zero since it has two identical rows, while the second determinant can be expanded across the $3$rd row, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}107 & 215 & 99 \\\\ 6 & 8 & 11 \\\\ 107 & 215 & 99\\end{aligned}|+|\\begin{aligned}107 & 215 & 99 \\\\ 6 & 8 & 11 \\\\ 0 & 0 & 1\\end{aligned}| & =0+1(-1)^{3+3}|\\begin{aligned}107 & 215 \\\\ 6 & 8\\end{aligned}| \\\\  & =107\\cdot 8-215\\cdot 6 \\\\  & =-434\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186357835 :knowledge-point/_questions [{:knowledge-point/id #uuid "6e4dd07e-475b-5c89-883b-0e4adcf6a723" :knowledge-point/title "Calculating a Determinant Using the Linearity of the Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fa7dff8-4d1b-556e-ba35-c9fa9fa5bb1b" :answer/type {:db/ident :answer.type/math} :answer/value "282" :db/id #edb/ref 17592186357837} {:answer/id #uuid "acdbb5db-10fe-5a27-8e47-9cc3ac0a56c4" :answer/type {:db/ident :answer.type/math} :answer/value "273" :db/id #edb/ref 17592186357838} {:answer/id #uuid "12545f41-d171-55b2-af91-5e9b4c424928" :answer/type {:db/ident :answer.type/math} :answer/value "447" :db/id #edb/ref 17592186357839} {:answer/id #uuid "34af4101-dcbe-5ecb-8e0d-ddb5735e925e" :answer/type {:db/ident :answer.type/math} :answer/value "372" :db/id #edb/ref 17592186357840} {:answer/id #uuid "1cf3db08-ca3a-5302-89e3-9ebadc458749" :answer/type {:db/ident :answer.type/math} :answer/value "327" :db/id #edb/ref 17592186357841}] :answer-field/correct {:answer/id #uuid "acdbb5db-10fe-5a27-8e47-9cc3ac0a56c4" :answer/type {:db/ident :answer.type/math} :answer/value "273" :db/id #edb/ref 17592186357838} :answer-field/id #uuid "1565cf83-4e5c-5e79-b4a6-dcedd2ff911e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357836}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "d58b86b5-6f51-56c2-a665-c8dd4a8423ca" :question/math-academy-id "q-88301" :question/problem "Find\n$|\\begin{aligned}1 & 3 & 6 \\\\ 91 & 92 & 93 \\\\ 90 & 92 & 93\\end{aligned}|.$" :question/worked-solution "First, notice that the $2$nd row of our determinant is almost equal to the $3$rd row. So, we can rewrite the given determinant, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 3 & 6 \\\\ 91 & 92 & 93 \\\\ 90 & 92 & 93\\end{aligned}| & =|\\begin{aligned}1 & 3 & 6 \\\\ 90+1 & 92+0 & 93+0 \\\\ 90 & 92 & 93\\end{aligned}|\\end{aligned}\n$$\n\nNext, using the linearity property of determinants, we obtain\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 3 & 6 \\\\ 90+1 & 92+0 & 93+0 \\\\ 90 & 92 & 93\\end{aligned}| & =|\\begin{aligned}1 & 3 & 6 \\\\ 90 & 92 & 93 \\\\ 90 & 92 & 93\\end{aligned}|+|\\begin{aligned}1 & 3 & 6 \\\\ 1 & 0 & 0 \\\\ 90 & 92 & 93\\end{aligned}|.\\end{aligned}\n$$\n\nThe first determinant must be zero since it has two identical rows, while the second determinant can be expanded across the $2$nd row, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 3 & 6 \\\\ 90 & 92 & 93 \\\\ 90 & 92 & 93\\end{aligned}|+|\\begin{aligned}1 & 3 & 6 \\\\ 1 & 0 & 0 \\\\ 90 & 92 & 93\\end{aligned}| & =0+1(-1)^{2+1}|\\begin{aligned}3 & 6 \\\\ 92 & 93\\end{aligned}| \\\\  & =-(3\\cdot 93-6\\cdot 92) \\\\  & =-(279-552) \\\\  & =273\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186357842 :knowledge-point/_questions [{:knowledge-point/id #uuid "6e4dd07e-475b-5c89-883b-0e4adcf6a723" :knowledge-point/title "Calculating a Determinant Using the Linearity of the Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38fd79f2-f154-5cfc-b521-704cf2ca6c00" :answer/type {:db/ident :answer.type/math} :answer/value "210" :db/id #edb/ref 17592186357844} {:answer/id #uuid "ae574dbc-5006-533c-8e81-4d7ab8b7c335" :answer/type {:db/ident :answer.type/math} :answer/value "192" :db/id #edb/ref 17592186357845} {:answer/id #uuid "dedb69f2-900d-5ac0-b6be-f452f83d624e" :answer/type {:db/ident :answer.type/math} :answer/value "204" :db/id #edb/ref 17592186357846} {:answer/id #uuid "6932afb5-b862-5c85-94a7-5dc1a8cf814a" :answer/type {:db/ident :answer.type/math} :answer/value "202" :db/id #edb/ref 17592186357847} {:answer/id #uuid "87128e6f-5362-5d22-80f6-008e9dc1be5c" :answer/type {:db/ident :answer.type/math} :answer/value "200" :db/id #edb/ref 17592186357848}] :answer-field/correct {:answer/id #uuid "87128e6f-5362-5d22-80f6-008e9dc1be5c" :answer/type {:db/ident :answer.type/math} :answer/value "200" :db/id #edb/ref 17592186357848} :answer-field/id #uuid "ee4a31fc-fc2d-5449-a80f-443c1c780cae" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357843}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "3b8437bb-5814-520e-ae8b-9b81b894af29" :question/math-academy-id "q-88304" :question/problem "Find\n$|\\begin{aligned}97 & 98 & 99 \\\\ 6 & 4 & 2 \\\\ 96 & 98 & 99\\end{aligned}|.$" :question/worked-solution "First, notice that the $1$st row of our determinant is almost equal to the $3$rd row. So, we can rewrite the given determinant, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}97 & 98 & 99 \\\\ 6 & 4 & 2 \\\\ 96 & 98 & 99\\end{aligned}| & =|\\begin{aligned}96+1 & 98+0 & 99+0 \\\\ 6 & 4 & 2 \\\\ 96 & 98 & 99\\end{aligned}|\\end{aligned}\n$$\n\nNext, using the linearity property of determinants, we obtain\n\n$$\n\\begin{aligned}|\\begin{aligned}96+1 & 98+0 & 99+0 \\\\ 6 & 4 & 2 \\\\ 96 & 98 & 99\\end{aligned}| & =|\\begin{aligned}96 & 98 & 99 \\\\ 6 & 4 & 2 \\\\ 96 & 98 & 99\\end{aligned}|+|\\begin{aligned}1 & 0 & 0 \\\\ 6 & 4 & 2 \\\\ 96 & 98 & 99\\end{aligned}|.\\end{aligned}\n$$\n\nThe first determinant must be zero since it has two identical rows, while the second determinant can be expanded across the $1$st row, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}96 & 98 & 99 \\\\ 6 & 4 & 2 \\\\ 96 & 98 & 99\\end{aligned}|+|\\begin{aligned}1 & 0 & 0 \\\\ 6 & 4 & 2 \\\\ 96 & 98 & 99\\end{aligned}| & =0+1(-1)^{1+1}|\\begin{aligned}4 & 2 \\\\ 98 & 99\\end{aligned}| \\\\  & =4\\cdot 99-2\\cdot 98 \\\\  & =396-196 \\\\  & =200\\end{aligned}\n$$"}]}
