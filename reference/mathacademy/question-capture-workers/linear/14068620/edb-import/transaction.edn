[{:db/id "q-42579/selection/852df530a82e413447a8b733db5e62e6c70e6d0be8b2e885cd815d17a6fb4ba1" :answer/id #uuid "3af95393-2575-5229-bc05-c6f36fb0b54d" :answer/type :answer.type/math :answer/value "-\\frac{1}{7}" :db/ensure [:answer/validate]} {:db/id "q-42579/selection/3b526d0871203a7fa20c2a891525c650a26e23eb2a93fea36737a1cf4d4423af" :answer/id #uuid "c0937a2b-c2c9-5851-95f8-98906380fb1a" :answer/type :answer.type/math :answer/value "\\frac{1}{13}" :db/ensure [:answer/validate]} {:db/id "q-42579/selection/a4db6ef6d27ed37bc0a7f59eccb85db4cbf1a96842b6ba92f02980c320892714" :answer/id #uuid "62b29e01-141e-5f84-9c47-b2cfbf282d19" :answer/type :answer.type/math :answer/value "-\\frac{1}{21}" :db/ensure [:answer/validate]} {:db/id "q-42579/selection/71b1db0b2a675655ec27a2d2ceef2e86712a68eb78548232215378e0a354fb4c" :answer/id #uuid "6ef1e9d3-d0ca-5136-bfc7-7818d2922e72" :answer/type :answer.type/math :answer/value "-\\frac{1}{6}" :db/ensure [:answer/validate]} {:db/id "q-42579/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "8ce046a4-1ded-5ee3-8d1b-d7366349cab1" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-42579/selection" :answer-field/id #uuid "a8d9f240-e780-5c74-b003-2aa3f0d7d460" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-42579/selection/71b1db0b2a675655ec27a2d2ceef2e86712a68eb78548232215378e0a354fb4c" :answer-field/choices ["q-42579/selection/852df530a82e413447a8b733db5e62e6c70e6d0be8b2e885cd815d17a6fb4ba1" "q-42579/selection/3b526d0871203a7fa20c2a891525c650a26e23eb2a93fea36737a1cf4d4423af" "q-42579/selection/a4db6ef6d27ed37bc0a7f59eccb85db4cbf1a96842b6ba92f02980c320892714" "q-42579/selection/71b1db0b2a675655ec27a2d2ceef2e86712a68eb78548232215378e0a354fb4c" "q-42579/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e"] :db/ensure [:answer-field/validate]} {:db/id "q-42579" :question/id #uuid "87beaefa-a44a-5f78-b5fb-0779a6230df3" :question/math-academy-id "q-42579" :question/problem "Find $|{A}^{-1}|,$ if $A=[\\begin{aligned}0 & 6 & -3 \\\\ -12 & -2 & 0 \\\\ 1 & 0 & 0\\end{aligned}].$" :question/worked-solution "Given an invertible $n\\times n$ matrix $A,$ we have\n\n$$\n|{A}^{-1}|=\\frac{1}{|A|}.\n$$\n\nFirst, we find $|A|$ using a Laplace expansion across the $3$rd row:\n\n$$\n\\begin{aligned}|A| & =|\\begin{aligned}0 & 6 & -3 \\\\ -12 & -2 & 0 \\\\ 1 & 0 & 0\\end{aligned}| \\\\  & =1\\cdot (-1)^{3+1}\\cdot |\\begin{aligned}6 & -3 \\\\ -2 & 0\\end{aligned}| \\\\  & =1\\cdot (-6) \\\\  & =-6\\end{aligned}\n$$\n\nTherefore, we obtain \n\n$$\n|{A}^{-1}|=\\frac{1}{|A|}=-\\frac{1}{6}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-42579/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "164c56ea-afbb-5ce4-800a-19002695db76"] :knowledge-point/questions ["q-42579"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-43097"] :question/problem "$|\\begin{aligned}107 & 215 & 99 \\\\ 6 & 8 & 11 \\\\ 107 & 215 & 100\\end{aligned}|=$" :question/worked-solution "First, notice that the $1$st row of our determinant is almost equal to the $3$rd row. So, we can rewrite the given determinant, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}107 & 215 & 99 \\\\ 6 & 8 & 11 \\\\ 107 & 215 & 100\\end{aligned}| & =|\\begin{aligned}107 & 215 & 99 \\\\ 6 & 8 & 11 \\\\ 107+0 & 215+0 & 99+1\\end{aligned}|\\end{aligned}\n$$\n\nNext, using the linearity property of determinants, we obtain\n\n$$\n\\begin{aligned}|\\begin{aligned}107 & 215 & 99 \\\\ 6 & 8 & 11 \\\\ 107+0 & 215+0 & 99+1\\end{aligned}| & =|\\begin{aligned}107 & 215 & 99 \\\\ 6 & 8 & 11 \\\\ 107 & 215 & 99\\end{aligned}|+|\\begin{aligned}107 & 215 & 99 \\\\ 6 & 8 & 11 \\\\ 0 & 0 & 1\\end{aligned}|.\\end{aligned}\n$$\n\nThe first determinant must be zero since it has two identical rows, while the second determinant can be expanded across the $3$rd row, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}107 & 215 & 99 \\\\ 6 & 8 & 11 \\\\ 107 & 215 & 99\\end{aligned}|+|\\begin{aligned}107 & 215 & 99 \\\\ 6 & 8 & 11 \\\\ 0 & 0 & 1\\end{aligned}| & =0+1(-1)^{3+3}|\\begin{aligned}107 & 215 \\\\ 6 & 8\\end{aligned}| \\\\  & =107\\cdot 8-215\\cdot 6 \\\\  & =-434\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-88301/selection/8d0ca618524ebb794cf8c2e372b9425026f89f9666790da3124dc3ab8e2b6695" :answer/id #uuid "34af4101-dcbe-5ecb-8e0d-ddb5735e925e" :answer/type :answer.type/math :answer/value "372" :db/ensure [:answer/validate]} {:db/id "q-88301/selection/8908ce213bea73c8307c34f65f6be208564fd23aa05a5b299382ea7ca3ee6bff" :answer/id #uuid "12545f41-d171-55b2-af91-5e9b4c424928" :answer/type :answer.type/math :answer/value "447" :db/ensure [:answer/validate]} {:db/id "q-88301/selection/918a71f4a72837bbdb11b4ef2e822d6482579fc24887ee0b9d49048fe0db62e3" :answer/id #uuid "1cf3db08-ca3a-5302-89e3-9ebadc458749" :answer/type :answer.type/math :answer/value "327" :db/ensure [:answer/validate]} {:db/id "q-88301/selection/7596e4bf337d554f665f6c46f5a637471e88b3c19b47248ac8a083983354dfbb" :answer/id #uuid "acdbb5db-10fe-5a27-8e47-9cc3ac0a56c4" :answer/type :answer.type/math :answer/value "273" :db/ensure [:answer/validate]} {:db/id "q-88301/selection/099695e20870c94dd2923b2f4de494f2eac8642a1e9335e3667f80cfe695a845" :answer/id #uuid "4fa7dff8-4d1b-556e-ba35-c9fa9fa5bb1b" :answer/type :answer.type/math :answer/value "282" :db/ensure [:answer/validate]} {:db/id "q-88301/selection" :answer-field/id #uuid "1565cf83-4e5c-5e79-b4a6-dcedd2ff911e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-88301/selection/7596e4bf337d554f665f6c46f5a637471e88b3c19b47248ac8a083983354dfbb" :answer-field/choices ["q-88301/selection/8d0ca618524ebb794cf8c2e372b9425026f89f9666790da3124dc3ab8e2b6695" "q-88301/selection/8908ce213bea73c8307c34f65f6be208564fd23aa05a5b299382ea7ca3ee6bff" "q-88301/selection/918a71f4a72837bbdb11b4ef2e822d6482579fc24887ee0b9d49048fe0db62e3" "q-88301/selection/7596e4bf337d554f665f6c46f5a637471e88b3c19b47248ac8a083983354dfbb" "q-88301/selection/099695e20870c94dd2923b2f4de494f2eac8642a1e9335e3667f80cfe695a845"] :db/ensure [:answer-field/validate]} {:db/id "q-88301" :question/id #uuid "d58b86b5-6f51-56c2-a665-c8dd4a8423ca" :question/math-academy-id "q-88301" :question/problem "Find\n$|\\begin{aligned}1 & 3 & 6 \\\\ 91 & 92 & 93 \\\\ 90 & 92 & 93\\end{aligned}|.$" :question/worked-solution "First, notice that the $2$nd row of our determinant is almost equal to the $3$rd row. So, we can rewrite the given determinant, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 3 & 6 \\\\ 91 & 92 & 93 \\\\ 90 & 92 & 93\\end{aligned}| & =|\\begin{aligned}1 & 3 & 6 \\\\ 90+1 & 92+0 & 93+0 \\\\ 90 & 92 & 93\\end{aligned}|\\end{aligned}\n$$\n\nNext, using the linearity property of determinants, we obtain\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 3 & 6 \\\\ 90+1 & 92+0 & 93+0 \\\\ 90 & 92 & 93\\end{aligned}| & =|\\begin{aligned}1 & 3 & 6 \\\\ 90 & 92 & 93 \\\\ 90 & 92 & 93\\end{aligned}|+|\\begin{aligned}1 & 3 & 6 \\\\ 1 & 0 & 0 \\\\ 90 & 92 & 93\\end{aligned}|.\\end{aligned}\n$$\n\nThe first determinant must be zero since it has two identical rows, while the second determinant can be expanded across the $2$nd row, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 3 & 6 \\\\ 90 & 92 & 93 \\\\ 90 & 92 & 93\\end{aligned}|+|\\begin{aligned}1 & 3 & 6 \\\\ 1 & 0 & 0 \\\\ 90 & 92 & 93\\end{aligned}| & =0+1(-1)^{2+1}|\\begin{aligned}3 & 6 \\\\ 92 & 93\\end{aligned}| \\\\  & =-(3\\cdot 93-6\\cdot 92) \\\\  & =-(279-552) \\\\  & =273\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-88301/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6e4dd07e-475b-5c89-883b-0e4adcf6a723"] :knowledge-point/questions ["q-88301"] :db/ensure [:knowledge-point/validate]} {:db/id "q-88304/selection/880a0d897c978cd3284f4ecfb10c77792658d8e40b9c8b17803ac3cc531f93ff" :answer/id #uuid "dedb69f2-900d-5ac0-b6be-f452f83d624e" :answer/type :answer.type/math :answer/value "204" :db/ensure [:answer/validate]} {:db/id "q-88304/selection/407a8c9dd7706a5c0017938bdc16d552cb404ed5280e2197eaee2471cbb5128e" :answer/id #uuid "38fd79f2-f154-5cfc-b521-704cf2ca6c00" :answer/type :answer.type/math :answer/value "210" :db/ensure [:answer/validate]} {:db/id "q-88304/selection/54cfebb7812c62c403fa4750caa00c349a4a8a6f3740641546f8b756058a6fc0" :answer/id #uuid "ae574dbc-5006-533c-8e81-4d7ab8b7c335" :answer/type :answer.type/math :answer/value "192" :db/ensure [:answer/validate]} {:db/id "q-88304/selection/f1a3f6364b4b6488166c92c743a5a8e2e2bdb28aff5bc6025ac2678cb4926932" :answer/id #uuid "87128e6f-5362-5d22-80f6-008e9dc1be5c" :answer/type :answer.type/math :answer/value "200" :db/ensure [:answer/validate]} {:db/id "q-88304/selection/b3c31e0e2d10ac6352946ed6a701a2833119f2aabfabe023adb86915d661b475" :answer/id #uuid "6932afb5-b862-5c85-94a7-5dc1a8cf814a" :answer/type :answer.type/math :answer/value "202" :db/ensure [:answer/validate]} {:db/id "q-88304/selection" :answer-field/id #uuid "ee4a31fc-fc2d-5449-a80f-443c1c780cae" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-88304/selection/f1a3f6364b4b6488166c92c743a5a8e2e2bdb28aff5bc6025ac2678cb4926932" :answer-field/choices ["q-88304/selection/880a0d897c978cd3284f4ecfb10c77792658d8e40b9c8b17803ac3cc531f93ff" "q-88304/selection/407a8c9dd7706a5c0017938bdc16d552cb404ed5280e2197eaee2471cbb5128e" "q-88304/selection/54cfebb7812c62c403fa4750caa00c349a4a8a6f3740641546f8b756058a6fc0" "q-88304/selection/f1a3f6364b4b6488166c92c743a5a8e2e2bdb28aff5bc6025ac2678cb4926932" "q-88304/selection/b3c31e0e2d10ac6352946ed6a701a2833119f2aabfabe023adb86915d661b475"] :db/ensure [:answer-field/validate]} {:db/id "q-88304" :question/id #uuid "3b8437bb-5814-520e-ae8b-9b81b894af29" :question/math-academy-id "q-88304" :question/problem "Find\n$|\\begin{aligned}97 & 98 & 99 \\\\ 6 & 4 & 2 \\\\ 96 & 98 & 99\\end{aligned}|.$" :question/worked-solution "First, notice that the $1$st row of our determinant is almost equal to the $3$rd row. So, we can rewrite the given determinant, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}97 & 98 & 99 \\\\ 6 & 4 & 2 \\\\ 96 & 98 & 99\\end{aligned}| & =|\\begin{aligned}96+1 & 98+0 & 99+0 \\\\ 6 & 4 & 2 \\\\ 96 & 98 & 99\\end{aligned}|\\end{aligned}\n$$\n\nNext, using the linearity property of determinants, we obtain\n\n$$\n\\begin{aligned}|\\begin{aligned}96+1 & 98+0 & 99+0 \\\\ 6 & 4 & 2 \\\\ 96 & 98 & 99\\end{aligned}| & =|\\begin{aligned}96 & 98 & 99 \\\\ 6 & 4 & 2 \\\\ 96 & 98 & 99\\end{aligned}|+|\\begin{aligned}1 & 0 & 0 \\\\ 6 & 4 & 2 \\\\ 96 & 98 & 99\\end{aligned}|.\\end{aligned}\n$$\n\nThe first determinant must be zero since it has two identical rows, while the second determinant can be expanded across the $1$st row, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}96 & 98 & 99 \\\\ 6 & 4 & 2 \\\\ 96 & 98 & 99\\end{aligned}|+|\\begin{aligned}1 & 0 & 0 \\\\ 6 & 4 & 2 \\\\ 96 & 98 & 99\\end{aligned}| & =0+1(-1)^{1+1}|\\begin{aligned}4 & 2 \\\\ 98 & 99\\end{aligned}| \\\\  & =4\\cdot 99-2\\cdot 98 \\\\  & =396-196 \\\\  & =200\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-88304/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6e4dd07e-475b-5c89-883b-0e4adcf6a723"] :knowledge-point/questions ["q-88304"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130631/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "b36703d2-3027-5e81-b805-df9f58e5c925" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-130631/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "cdd717ce-edfc-5edd-b0eb-452ebf3fc9bd" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-130631/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "b6cdf8c0-7bc3-569f-8653-4f2b52808616" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-130631/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "a69ce41f-611c-540e-9f80-506d5789bc81" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-130631/selection/8ca4b7a1e89c730869f48c3a3ace0473b36e7c19c70ef8efef65592fedc719dd" :answer/id #uuid "adc39493-fce0-57e9-b913-85b48c69a400" :answer/type :answer.type/math :answer/value "-45" :db/ensure [:answer/validate]} {:db/id "q-130631/selection" :answer-field/id #uuid "da580575-0cfb-50ca-a650-ff04847ffcee" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-130631/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer-field/choices ["q-130631/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" "q-130631/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" "q-130631/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-130631/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" "q-130631/selection/8ca4b7a1e89c730869f48c3a3ace0473b36e7c19c70ef8efef65592fedc719dd"] :db/ensure [:answer-field/validate]} {:db/id "q-130631" :question/id #uuid "18a0ba50-4a2e-5bdc-b928-f30ebbc43507" :question/math-academy-id "q-130631" :question/problem "Let $A,$ $B,$ and $C$ be square matrices. If $A=B\\cdot C,$  $|B|=-15$ and $|{C}^{-1}|=3$, find $|A|.$" :question/worked-solution "Given two $n\\times n$ matrices $M$ and $N,$ we have\n\n$$\ndet(MN)=det(M)\\cdot det(N).\n$$\n\nAlso, given an invertible $n\\times n$ matrix $M,$ we have\n\n$$\ndet({M}^{-1})=\\frac{1}{det(M)}.\n$$\n\nSince $|C|=\\frac{1}{|{C}^{-1}|}$, we get $|C|=\\frac{1}{3}.$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}|A| & =|B|\\cdot |C| \\\\  & =(-15)\\cdot (\\frac{1}{3}) \\\\  & =-5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-130631/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "164c56ea-afbb-5ce4-800a-19002695db76"] :knowledge-point/questions ["q-130631"] :db/ensure [:knowledge-point/validate]}]
