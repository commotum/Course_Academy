51247919b3f"] :db/ensure [:answer-field/validate]} {:db/id "q-78569" :question/id #uuid "84130eac-31b9-56bd-a2ab-ea4421847f7e" :question/math-academy-id "q-78569" :question/problem "Consider a matrix equation ${B}^{-1}\\,x=A\\,d,$ where $A$ and $B$ are $9\\times 9$ non-singular matrices, while $x$ and $d$ are $9\\times 1$ column vectors. Solve the equation for $x.$" :question/worked-solution "Pre-multiplying both sides of the equation ${B}^{-1}\\,x=A\\,d$ by $B,$ we obtain\n\n$$\n\\begin{aligned}{B}^{-1}\\,x & =A\\,d \\\\ B{B}^{-1}\\,x & =BA\\,d \\\\ {I}_{9}\\,x & =BA\\,d \\\\ x & =BA\\,d.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-78569/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5d0cda54-4a4b-5255-b375-ce5e7b604dff"] :knowledge-point/questions ["q-78569"] :db/ensure [:knowledge-point/validate]}]
