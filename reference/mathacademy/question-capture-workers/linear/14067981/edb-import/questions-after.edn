#{[{:db/id #edb/ref 17592186356173 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ad1721d-26a4-5459-bc81-297ff0e4d678" :knowledge-point/title "Solving a 3x3 System of Equations By Calculating the Inverse of the Coefficient Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8588b2fd-16ea-5e3f-8a9a-83e74982b7d6" :answer/type {:db/ident :answer.type/math} :answer/value "x=-13,\\,y=19,\\,z=57" :db/id #edb/ref 17592186356175} {:answer/id #uuid "4a2d4aa6-c884-598c-a58c-f059ccd28125" :answer/type {:db/ident :answer.type/math} :answer/value "x=13,\\,y=19,\\,z=77" :db/id #edb/ref 17592186356176} {:answer/id #uuid "4eb713b9-b55e-5c11-b3ef-408b8a1b338d" :answer/type {:db/ident :answer.type/math} :answer/value "x=13,\\,y=25,\\,z=77" :db/id #edb/ref 17592186356177} {:answer/id #uuid "5ce6a623-3928-5e07-a08a-4c8d22b8fc49" :answer/type {:db/ident :answer.type/math} :answer/value "x=-11,\\,y=19,\\,z=77" :db/id #edb/ref 17592186356178} {:answer/id #uuid "de33c3a6-275d-54d0-8d6f-0c1285533e9d" :answer/type {:db/ident :answer.type/math} :answer/value "x=-18,\\,y=25,\\,z=77" :db/id #edb/ref 17592186356179}] :answer-field/correct {:answer/id #uuid "de33c3a6-275d-54d0-8d6f-0c1285533e9d" :answer/type {:db/ident :answer.type/math} :answer/value "x=-18,\\,y=25,\\,z=77" :db/id #edb/ref 17592186356179} :answer-field/id #uuid "277eb88c-abd3-566e-bb51-1ac538dd4326" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186356174}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "15a1f403-3848-58c6-8e7b-f2e35da90058" :question/math-academy-id "q-10038" :question/problem "Solve the following system of linear equations by finding the inverse of the coefficient matrix:\n\n$$\n\\begin{aligned}{\\begin{aligned}z+2y+7x=1 \\\\ 3y-z=-2 \\\\ 4y-2z-3x=0\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "We organize the system so that it’s in the correct order first:\n\n$$\n\\begin{aligned}{\\begin{aligned}7x+2y+z=1 \\\\ 3y-z=-2 \\\\ -3x+4y-2z=0\\end{aligned}\\end{aligned}\n$$\n\nWe wish to write this system in the form $Ax=b$, where $A$ is a $3\\times 3$ matrix and $x$ and $b$ are $3\\times 1$ column vectors. We can do this as follows:\n\n$$\n[\\begin{aligned}7 & 2 & 1 \\\\ 0 & 3 & -1 \\\\ -3 & 4 & -2\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}1 \\\\ -2 \\\\ 0\\end{aligned}].\n$$\n\nNow, the solution to $Ax=b$ is given by $x={A}^{-1}b.$ So, we compute ${A}^{-1}$ as follows:\n\n*Step 1:*\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}7 & 2 & 1 \\\\ 0 & 3 & -1 \\\\ -3 & 4 & -2\\end{aligned}| \\\\  & =7|\\begin{aligned}3 & -1 \\\\ 4 & -2\\end{aligned}|-2|\\begin{aligned}0 & -1 \\\\ -3 & -2\\end{aligned}|+1|\\begin{aligned}0 & 3 \\\\ -3 & 4\\end{aligned}| \\\\  & =7(-6+4)-2(-3)+1(9) \\\\  & =-14+6+9 \\\\  & =1.\\end{aligned}\n$$\n\n*Step 2:*\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}|\\begin{aligned}3 & -1 \\\\ 4 & -2\\end{aligned}| & |\\begin{aligned}0 & -1 \\\\ -3 & -2\\end{aligned}| & |\\begin{aligned}0 & 3 \\\\ -3 & 4\\end{aligned}| \\\\ |\\begin{aligned}2 & 1 \\\\ 4 & -2\\end{aligned}| & |\\begin{aligned}7 & 1 \\\\ -3 & -2\\end{aligned}| & |\\begin{aligned}7 & 2 \\\\ -3 & 4\\end{aligned}| \\\\ |\\begin{aligned}2 & 1 \\\\ 3 & -1\\end{aligned}| & |\\begin{aligned}7 & 1 \\\\ 0 & -1\\end{aligned}| & |\\begin{aligned}7 & 2 \\\\ 0 & 3\\end{aligned}|\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -3 & 9 \\\\ -8 & -11 & 34 \\\\ -5 & -7 & 21\\end{aligned}].\\end{aligned}\n$$\n\n*Step 3:*\n\n$$\nC=[\\begin{aligned}-2 & 3 & 9 \\\\ 8 & -11 & -34 \\\\ -5 & 7 & 21\\end{aligned}].\n$$\n\n*Step 4:*\n\n$$\n{C}^{T}=[\\begin{aligned}-2 & 8 & -5 \\\\ 3 & -11 & 7 \\\\ 9 & -34 & 21\\text{ }\\end{aligned}].\n$$\n\n*Step 5:*\n\n$$\n{A}^{-1}=\\frac{1}{det(A)}{C}^{T}=\\frac{1}{1}[\\begin{aligned}-2 & 8 & -5 \\\\ 3 & -11 & 7 \\\\ 9 & -34 & 21\\text{ }\\end{aligned}].\n$$\n\nHence\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =[\\begin{aligned}-2 & 8 & -5 \\\\ 3 & -11 & 7 \\\\ 9 & -34 & 21\\text{ }\\end{aligned}][\\begin{aligned}1 \\\\ -2 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}-18 \\\\ 25 \\\\ 77\\end{aligned}].\\end{aligned}\n$$\n\nHence the solution is $x=-18,\\,y=25,\\,z=77.$"}] [{:db/id #edb/ref 17592186356180 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ad1721d-26a4-5459-bc81-297ff0e4d678" :knowledge-point/title "Solving a 3x3 System of Equations By Calculating the Inverse of the Coefficient Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ec6fd1a-4199-5af8-819a-7effc76c946f" :answer/type {:db/ident :answer.type/math} :answer/value "x=-3,y=-\\frac{19}{5},z=-\\frac{3}{5}" :db/id #edb/ref 17592186356182} {:answer/id #uuid "98c806f7-a143-52ca-9e83-14d5abb4f3d1" :answer/type {:db/ident :answer.type/math} :answer/value "x=3,y=-\\frac{19}{5},z=-\\frac{3}{5}" :db/id #edb/ref 17592186356183} {:answer/id #uuid "7352d767-1ab8-506c-b209-fe843152c887" :answer/type {:db/ident :answer.type/math} :answer/value "x=15,y=-19,z=-3" :db/id #edb/ref 17592186356184} {:answer/id #uuid "3a3ecd5b-bf00-53eb-bb1c-a447059a7d46" :answer/type {:db/ident :answer.type/math} :answer/value "x=3,y=\\frac{19}{5},z=\\frac{3}{5}" :db/id #edb/ref 17592186356185} {:answer/id #uuid "944673ff-4cff-503b-b55d-85e37661b1b5" :answer/type {:db/ident :answer.type/math} :answer/value "x=15,y=19,z=-3" :db/id #edb/ref 17592186356186}] :answer-field/correct {:answer/id #uuid "98c806f7-a143-52ca-9e83-14d5abb4f3d1" :answer/type {:db/ident :answer.type/math} :answer/value "x=3,y=-\\frac{19}{5},z=-\\frac{3}{5}" :db/id #edb/ref 17592186356183} :answer-field/id #uuid "5f0f2f23-d7bf-5dba-87e5-f5875bc831bd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186356181}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c6772a4c-bd5a-5161-8ec4-e23338cb7803" :question/math-academy-id "q-10075" :question/problem "Solve the following system of linear equations by finding the inverse of the coefficient matrix:\n\n$$\n\\begin{aligned}{\\begin{aligned}3z-y+x-5=0 \\\\ y+2x+2z=1 \\\\ z-2x-2y=1\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "We organize the system so that it’s in the correct order first:\n\n$$\n\\begin{aligned}{\\begin{aligned}x-y+3z=5 \\\\ 2x+y+2z=1 \\\\ -2x-2y+z=1\\end{aligned}\\end{aligned}\n$$\n\nWe wish to write this system in the form $Ax=b$, where $A$ is a $3\\times 3$ matrix and $x$ and $b$ are $3\\times 1$ column vectors. We can do this as follows:\n\n$$\n[\\begin{aligned}1 & -1 & 3 \\\\ 2 & 1 & 2 \\\\ -2 & -2 & 1\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}5 \\\\ 1 \\\\ 1\\end{aligned}].\n$$\n\nNow, the solution to $Ax=b$ is given by $x={A}^{-1}b.$ So, we compute ${A}^{-1}$ as follows:\n\n*Step 1:*\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}1 & -1 & 3 \\\\ 2 & 1 & 2 \\\\ -2 & -2 & 1\\end{aligned}| \\\\  & =1|\\begin{aligned}1 & 2 \\\\ -2 & 1\\end{aligned}|-(-1)|\\begin{aligned}2 & 2 \\\\ -2 & 1\\end{aligned}|+3|\\begin{aligned}2 & 1 \\\\ -2 & -2\\end{aligned}| \\\\  & =1(1+4)+1(2+4)+3(-4+2) \\\\  & =5+6-6 \\\\  & =5.\\end{aligned}\n$$\n\n*Step 2:*\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}|\\begin{aligned}1 & 2 \\\\ -2 & 1\\end{aligned}| & |\\begin{aligned}2 & 2 \\\\ -2 & 1\\end{aligned}| & |\\begin{aligned}2 & 1 \\\\ -2 & -2\\end{aligned}| \\\\ |\\begin{aligned}-1 & 3 \\\\ -2 & 1\\end{aligned}| & |\\begin{aligned}1 & 3 \\\\ -2 & 1\\end{aligned}| & |\\begin{aligned}1 & -1 \\\\ -2 & -2\\end{aligned}| \\\\ |\\begin{aligned}-1 & 3 \\\\ 1 & 2\\end{aligned}| & |\\begin{aligned}1 & 3 \\\\ 2 & 2\\end{aligned}| & |\\begin{aligned}1 & -1 \\\\ 2 & 1\\end{aligned}|\\end{aligned}] \\\\  & =[\\begin{aligned}5 & 6 & -2 \\\\ 5 & 7 & -4 \\\\ -5 & -4 & 3\\end{aligned}].\\end{aligned}\n$$\n\n*Step 3:*\n\n$$\nC=[\\begin{aligned}5 & -6 & -2 \\\\ -5 & 7 & 4 \\\\ -5 & 4 & 3\\end{aligned}].\n$$\n\n*Step 4:*\n\n$$\n{C}^{T}=[\\begin{aligned}5 & -5 & -5 \\\\ -6 & 7 & 4 \\\\ -2 & 4 & 3\\end{aligned}].\n$$\n\n*Step 5:*\n\n$$\n{A}^{-1}=\\frac{1}{det(A)}{C}^{T}=\\frac{1}{5}[\\begin{aligned}5 & -5 & -5 \\\\ -6 & 7 & 4 \\\\ -2 & 4 & 3\\end{aligned}].\n$$\n\nHence\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{5}[\\begin{aligned}5 & -5 & -5 \\\\ -6 & 7 & 4 \\\\ -2 & 4 & 3\\end{aligned}][\\begin{aligned}5 \\\\ 1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}3 \\\\ -\\frac{19}{5} \\\\ -\\frac{3}{5}\\end{aligned}].\\end{aligned}\n$$\n\nHence the solution is $x=3,y=-\\frac{19}{5},z=-\\frac{3}{5}.$"}] [{:db/id #edb/ref 17592186356187 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ad1721d-26a4-5459-bc81-297ff0e4d678" :knowledge-point/title "Solving a 3x3 System of Equations By Calculating the Inverse of the Coefficient Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5bcc481-cc80-53ab-8ada-8994bcf2f6bb" :answer/type {:db/ident :answer.type/math} :answer/value "x=8,y=-8,z=8" :db/id #edb/ref 17592186356189} {:answer/id #uuid "cf8bca25-b939-5f03-8ddd-08ff31f525ea" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{2}{3},y=-\\frac{2}{3},z=\\frac{2}{3}" :db/id #edb/ref 17592186356190} {:answer/id #uuid "131e9eab-c9d9-5aa4-a89a-05bb7f068efb" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{2}{3},y=-\\frac{2}{3},z=-\\frac{2}{3}" :db/id #edb/ref 17592186356191} {:answer/id #uuid "474b6b36-cfe8-5cba-9548-3dab20970df4" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{2}{3},y=\\frac{2}{3},z=\\frac{2}{3}" :db/id #edb/ref 17592186356192} {:answer/id #uuid "c8092c29-2fc6-5beb-a48f-bc974db8093d" :answer/type {:db/ident :answer.type/math} :answer/value "x=8,y=8,z=8" :db/id #edb/ref 17592186356193}] :answer-field/correct {:answer/id #uuid "cf8bca25-b939-5f03-8ddd-08ff31f525ea" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{2}{3},y=-\\frac{2}{3},z=\\frac{2}{3}" :db/id #edb/ref 17592186356190} :answer-field/id #uuid "85c5d548-84fe-5350-99f6-9a31c34161f9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186356188}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "be5a9299-0f7a-5c96-82dc-a78e4b6223ee" :question/math-academy-id "q-10101" :question/problem "Solve the following system of linear equations by finding the inverse of the coefficient matrix:\n\n$$\n\\begin{aligned}{\\begin{aligned}x-z=0 \\\\ x+y+3z=2 \\\\ 3x-2y+z=4\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "We wish to write this system in the form $Ax=b$, where $A$ is a $3\\times 3$ matrix and $x$ and $b$ are $3\\times 1$ column vectors. We can do this as follows:\n\n$$\n[\\begin{aligned}1 & 0 & -1 \\\\ 1 & 1 & 3 \\\\ 3 & -2 & 1\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}0 \\\\ 2 \\\\ 4\\end{aligned}].\n$$\n\nNow, the solution to $Ax=b$ is given by $x={A}^{-1}b.$ So, we compute ${A}^{-1}$ as follows:\n\n*Step 1:*\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}1 & 0 & -1 \\\\ 1 & 1 & 3 \\\\ 3 & -2 & 1\\end{aligned}| \\\\  & =1|\\begin{aligned}1 & 3 \\\\ -2 & 1\\end{aligned}|-0|\\begin{aligned}1 & 3 \\\\ 3 & 1\\end{aligned}|-1|\\begin{aligned}1 & 1 \\\\ 3 & -2\\end{aligned}| \\\\  & =1(1-3(-2))+0-1(-2-3) \\\\  & =1+6+2+3 \\\\  & =12.\\end{aligned}\n$$\n\n*Step 2:*\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}|\\begin{aligned}1 & 3 \\\\ -2 & 1\\end{aligned}| & |\\begin{aligned}1 & 3 \\\\ 3 & 1\\end{aligned}| & |\\begin{aligned}1 & 1 \\\\ 3 & -2\\end{aligned}| \\\\ |\\begin{aligned}0 & -1 \\\\ -2 & 1\\end{aligned}| & |\\begin{aligned}1 & -1 \\\\ 3 & 1\\end{aligned}| & |\\begin{aligned}1 & 0 \\\\ 3 & -2\\end{aligned}| \\\\ |\\begin{aligned}0 & -1 \\\\ 1 & 3\\end{aligned}| & |\\begin{aligned}1 & -1 \\\\ 1 & 3\\end{aligned}| & |\\begin{aligned}1 & 0 \\\\ 1 & 1\\end{aligned}|\\end{aligned}] \\\\  & =[\\begin{aligned}7 & -8 & -5 \\\\ -2 & 4 & -2 \\\\ 1 & 4 & 1\\end{aligned}].\\end{aligned}\n$$\n\n*Step 3:*\n\n$$\nC=[\\begin{aligned}7 & 8 & -5 \\\\ 2 & 4 & 2 \\\\ 1 & -4 & 1\\end{aligned}].\n$$\n\n*Step 4:*\n\n$$\n{C}^{T}=[\\begin{aligned}7 & 2 & 1 \\\\ 8 & 4 & -4 \\\\ -5 & 2 & 1\\end{aligned}].\n$$\n\n*Step 5:*\n\n$$\n{A}^{-1}=\\frac{1}{det(A)}{C}^{T}=\\frac{1}{12}[\\begin{aligned}7 & 2 & 1 \\\\ 8 & 4 & -4 \\\\ -5 & 2 & 1\\end{aligned}].\n$$\n\nHence\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{12}[\\begin{aligned}7 & 2 & 1 \\\\ 8 & 4 & -4 \\\\ -5 & 2 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 2 \\\\ 4\\end{aligned}] \\\\  & =\\frac{1}{12}[\\begin{aligned}8 \\\\ -8 \\\\ 8\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{2}{3} \\\\ -\\frac{2}{3} \\\\ \\frac{2}{3}\\end{aligned}].\\end{aligned}\n$$\n\nHence the solution is $x=\\frac{2}{3},y=-\\frac{2}{3},z=\\frac{2}{3}.$"}] [{:db/id #edb/ref 17592186356194 :knowledge-point/_questions [{:knowledge-point/id #uuid "5d0cda54-4a4b-5255-b375-ce5e7b604dff" :knowledge-point/title "Solving a Matrix Equation Using Algebraic Manipulation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54d44a50-b3d4-50b0-97d1-fb18583495a2" :answer/type {:db/ident :answer.type/math} :answer/value "x=A\\,d\\,{B}^{-1}" :db/id #edb/ref 17592186356196} {:answer/id #uuid "ced753b4-8963-512f-8d65-1bf75bb81d6e" :answer/type {:db/ident :answer.type/math} :answer/value "x=BA\\,d" :db/id #edb/ref 17592186356197} {:answer/id #uuid "483368e7-9094-54b7-a58d-a2c9c8e38f34" :answer/type {:db/ident :answer.type/math} :answer/value "x=A{B}^{-1}\\,d" :db/id #edb/ref 17592186356198} {:answer/id #uuid "389329d8-7516-5254-a766-be4a42351ab1" :answer/type {:db/ident :answer.type/math} :answer/value "x={B}^{-1}A\\,d" :db/id #edb/ref 17592186356199} {:answer/id #uuid "e186f39f-00e7-5136-90ac-cdd6db200aad" :answer/type {:db/ident :answer.type/math} :answer/value "x={B}^{-1}{A}^{-1}\\,d" :db/id #edb/ref 17592186356200}] :answer-field/correct {:answer/id #uuid "389329d8-7516-5254-a766-be4a42351ab1" :answer/type {:db/ident :answer.type/math} :answer/value "x={B}^{-1}A\\,d" :db/id #edb/ref 17592186356199} :answer-field/id #uuid "94d1232a-7a26-5aa4-a478-4fcd8f70f4f5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186356195}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "0ec9f7c8-9125-5a99-8012-bc8baca62664" :question/math-academy-id "q-78567" :question/problem "Consider a matrix equation ${A}^{-1}B\\,x=d,$ where $A$ and $B$ are $6\\times 6$ non-singular matrices, while $x$ and $d$ are $6\\times 1$ column vectors. Solve the equation for $x.$" :question/worked-solution "Pre-multiplying both sides of the equation ${A}^{-1}B\\,x=d$ by $A,$ we obtain\n\n$$\n\\begin{aligned}{A}^{-1}B\\,x & =d \\\\ A{A}^{-1}B\\,x & =A\\,d \\\\ {I}_{6}B\\,x & =A\\,d \\\\ B\\,x & =A\\,d.\\end{aligned}\n$$\n\nSince $B$ is not singular, it must have an inverse ${B}^{-1}.$ Now, pre-multiplying both sides of the equation $B\\,x=A\\,d$ by ${B}^{-1},$ we obtain\n\n$$\n\\begin{aligned}B\\,x & =A\\,d \\\\ {B}^{-1}B\\,x & ={B}^{-1}A\\,d \\\\ {I}_{6}\\,x & ={B}^{-1}A\\,d \\\\ x & ={B}^{-1}A\\,d.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186356201 :knowledge-point/_questions [{:knowledge-point/id #uuid "5d0cda54-4a4b-5255-b375-ce5e7b604dff" :knowledge-point/title "Solving a Matrix Equation Using Algebraic Manipulation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94d24aec-d7e7-5f17-b920-b3b914dd829d" :answer/type {:db/ident :answer.type/math} :answer/value "x=AB\\,d" :db/id #edb/ref 17592186356203} {:answer/id #uuid "2cc2836b-bf86-5df6-bfe5-31277fc45419" :answer/type {:db/ident :answer.type/math} :answer/value "x=BA\\,d" :db/id #edb/ref 17592186356204} {:answer/id #uuid "d8dd2a82-97dd-51c8-96e3-a5ca51e7d653" :answer/type {:db/ident :answer.type/math} :answer/value "x=A\\,d{B}^{-1}" :db/id #edb/ref 17592186356205} {:answer/id #uuid "883e0dd7-31f9-5c1e-87a5-34efb034ec48" :answer/type {:db/ident :answer.type/math} :answer/value "x={B}^{-1}A\\,d" :db/id #edb/ref 17592186356206} {:answer/id #uuid "4178c819-ad55-557d-a1e0-de3ff00e0e52" :answer/type {:db/ident :answer.type/math} :answer/value "x=A\\,d\\,B" :db/id #edb/ref 17592186356207}] :answer-field/correct {:answer/id #uuid "2cc2836b-bf86-5df6-bfe5-31277fc45419" :answer/type {:db/ident :answer.type/math} :answer/value "x=BA\\,d" :db/id #edb/ref 17592186356204} :answer-field/id #uuid "bddb0682-f79b-52c1-9086-ed8f6f602c78" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186356202}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "84130eac-31b9-56bd-a2ab-ea4421847f7e" :question/math-academy-id "q-78569" :question/problem "Consider a matrix equation ${B}^{-1}\\,x=A\\,d,$ where $A$ and $B$ are $9\\times 9$ non-singular matrices, while $x$ and $d$ are $9\\times 1$ column vectors. Solve the equation for $x.$" :question/worked-solution "Pre-multiplying both sides of the equation ${B}^{-1}\\,x=A\\,d$ by $B,$ we obtain\n\n$$\n\\begin{aligned}{B}^{-1}\\,x & =A\\,d \\\\ B{B}^{-1}\\,x & =BA\\,d \\\\ {I}_{9}\\,x & =BA\\,d \\\\ x & =BA\\,d.\\end{aligned}\n$$"}]}
