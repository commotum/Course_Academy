ned}3 & 0 & 0 \\\\ 0 & -5 & 1 \\\\ 0 & 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186310165}] :answer-field/correct {:answer/id #uuid "9aa7d7e2-01e7-5351-8a36-b87756ced8ad" :answer/type {:db/ident :answer.type/math} :answer/value "C=[\\begin{aligned}3 & 0 & 0 \\\\ 0 & -5 & 1 \\\\ 0 & 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186310165} :answer-field/id #uuid "940b40d5-c529-5222-8c39-f339831cca2b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186310160}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "91c8b870-01b8-5cdd-a0e6-31fdbbd32f0e" :question/math-academy-id "q-68740" :question/problem "Which of the following is an upper triangular matrix?" :question/worked-solution "Notice that $C$ is a matrix for which all entries *below* the diagonal are $0$'s:\n\n$$\nC=[\\begin{aligned}3 & 0 & 0 \\\\ 0 & -5 & 1 \\\\ 0 & 0 & 2\\end{aligned}]\n$$\n\nHence, it is an upper triangular matrix. \n\nBy contrast, matrices $A$, $B$, $D$, and $E$ each have at least one non-zero entry below the diagonal:\n\n$$\nA=[\\begin{aligned}1 & 0 \\\\ 2 & 3\\end{aligned}],\\,B=[\\begin{aligned}2 & 0 & 0 \\\\ 0 & 5 & 0 \\\\ 0 & 1 & -3\\end{aligned}],\\,D=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}],\\,E=[\\begin{aligned}2 & 4 & 0 \\\\ 4 & 0 & 4 \\\\ 0 & 4 & 2\\end{aligned}].\n$$\n\nSo, they are not upper triangular matrices."}] [{:db/id #edb/ref 17592186310166 :knowledge-point/_questions [{:knowledge-point/id #uuid "e69a4aee-6e92-598b-99b5-1d830b6dea54" :knowledge-point/title "Identifying Correct Statements About a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb76d62c-22f5-5301-8054-45fb72adc0ab" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186310168} {:answer/id #uuid "deec8578-f219-5388-8a38-e1ee4ac93f38" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186310169} {:answer/id #uuid "dfd93e44-e4ff-569c-82d6-9d53d096f334" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186310170} {:answer/id #uuid "687e0b70-44a8-509e-9155-cbe7861deb6a" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186310171} {:answer/id #uuid "9010054b-dacc-5bed-bc46-0f6cb8a81a4c" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186310172}] :answer-field/correct {:answer/id #uuid "dfd93e44-e4ff-569c-82d6-9d53d096f334" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186310170} :answer-field/id #uuid "9fb21a6f-b403-5e74-a945-8d49b17921c6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186310167}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "0f1cf79d-1845-5bb5-b44c-74ff9fd5e795" :question/math-academy-id "q-68754" :question/problem "Consider the matrix \n$A=[\\begin{aligned}0 & -2 & -7 \\\\ 2 & -1 & 8 \\\\ 7 & -8 & 1\\end{aligned}].$\nWhich of the following statements are true?\n\n- $A$ is upper triangular\n- $A$ is lower triangular\n- $A+{A}^{T}$ is upper triangular" :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is false, since $A$ has non-zero entries below the main diagonal:\n\n$$\nA=[\\begin{aligned}0 & -2 & -7 \\\\ 2 & -1 & 8 \\\\ 7 & -8 & 1\\end{aligned}]\n$$\n\n- Statement II is false, since $A$ has non-zero entries above the main diagonal:\n\n$$\nA=[\\begin{aligned}0 & -2 & -7 \\\\ 2 & -1 & 8 \\\\ 7 & -8 & 1\\end{aligned}]\n$$\n\n- Statement III is true, since the result of $A+{A}^{T}$ has all the entries below the main diagonal equal to zero:\n\n$$\nA+{A}^{T}=[\\begin{aligned}0 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & 2\\end{aligned}]\n$$\n\nTherefore, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186310173 :knowledge-point/_questions [{:knowledge-point/id #uuid "b55b50a0-034f-57c0-8a61-883cfb0412dc" :knowledge-point/title "Identifying a Triangular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9aa0a801-971e-5f8d-976c-60ed0cf02d1b" :answer/type {:db/ident :answer.type/math} :answer/value "C=[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186310175} {:answer/id #uuid "c35c995a-7379-50c3-abde-73d1d455563f" :answer/type {:db/ident :answer.type/math} :answer/value "D=[\\begin{aligned}2 & -3 \\\\ 0 & 3\\end{aligned}]" :db/id #edb/ref 17592186310176} {:answer/id #uuid "eea79a67-ba5d-50bb-87f0-7ae25345a1c2" :answer/type {:db/ident :answer.type/math} :answer/value "A=[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 3\\end{aligned}]" :db/id #edb/ref 17592186310177} {:answer/id #uuid "61ebcdba-6474-56b2-9ca1-fffb415731fe" :answer/type {:db/ident :answer.type/math} :answer/value "E=[\\begin{aligned}0 & -4 & 0 \\\\ 5 & 0 & -7 \\\\ 1 & 2 & 0\\end{aligned}]" :db/id #edb/ref 17592186310178} {:answer/id #uuid "6d3af057-d640-5f17-b234-b1e74ea7af98" :answer/type {:db/ident :answer.type/math} :answer/value "B=[\\begin{aligned}0 & 0 & 0 \\\\ 2 & 5 & 0 \\\\ 1 & 4 & 3\\end{aligned}]" :db/id #edb/ref 17592186310179}] :answer-field/correct {:answer/id #uuid "6d3af057-d640-5f17-b234-b1e74ea7af98" :answer/type {:db/ident :answer.type/math} :answer/value "B=[\\begin{aligned}0 & 0 & 0 \\\\ 2 & 5 & 0 \\\\ 1 & 4 & 3\\end{aligned}]" :db/id #edb/ref 17592186310179} :answer-field/id #uuid "a76a1147-d129-5ba9-9c8b-3218c6327cc9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186310174}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9af406e1-4ead-558e-9219-f0bb53a377fc" :question/math-academy-id "q-74316" :question/problem "Which of the following is a lower triangular matrix?" :question/worked-solution "Notice that $B$ is a matrix for which all entries *above* the diagonal are $0$'s:\n\n$$\nB=[\\begin{aligned}0 & 0 & 0 \\\\ 2 & 5 & 0 \\\\ 1 & 4 & 3\\end{aligned}]\n$$\n\nHence, it is a lower triangular matrix. \n\nBy contrast, matrices $A$, $C$, $D$, and $E$ each have at least one non-zero entry above the diagonal:\n\n$$\nA=[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 3\\end{aligned}],\\,C=[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}],\\,D=[\\begin{aligned}2 & -3 \\\\ 0 & 3\\end{aligned}],\\,E=[\\begin{aligned}0 & -4 & 0 \\\\ 5 & 0 & -7 \\\\ 1 & 2 & 0\\end{aligned}].\n$$\n\nSo, they are not lower triangular matrices."}] [{:db/id #edb/ref 17592186310180 :knowledge-point/_questions [{:knowledge-point/id #uuid "e69a4aee-6e92-598b-99b5-1d830b6dea54" :knowledge-point/title "Identifying Correct Statements About a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fd82bea3-c4d1-5c99-a0f8-3ded82884c67" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186310182} {:answer/id #uuid "08e40fd7-c8ee-582b-a6e1-bd1cb96da954" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186310183} {:answer/id #uuid "f7142fd9-cb74-5255-9207-e9619258a851" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186310184} {:answer/id #uuid "9562542f-892f-5d59-b7db-7e1ede55634c" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186310185} {:answer/id #uuid "e7224598-83d2-55a8-a48b-c484a41fce8a" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186310186}] :answer-field/correct {:answer/id #uuid "08e40fd7-c8ee-582b-a6e1-bd1cb96da954" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186310183} :answer-field/id #uuid "1038c4bc-05f5-530b-9d08-918371fe520d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186310181}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "9df7e584-7e82-5b84-94bc-a429fcc799f7" :question/math-academy-id "q-74318" :question/problem "Consider the matrix \n$C=[\\begin{aligned}2 & 0 & 1 & 0 \\\\ 0 & 4 & 0 & 4 \\\\ 0 & 0 & 2 & 1 \\\\ 0 & 0 & 0 & 3\\end{aligned}].$\nWhich of the following statements are true?\n\n- $C$ is upper triangular\n- $C$ is lower triangular\n- ${C}^{T}$ is upper triangular" :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is true. All the entries below the main diagonal of $C$ are zeros:\n\n$$\nC=[\\begin{aligned}2 & 0 & 1 & 0 \\\\ 0 & 4 & 0 & 4 \\\\ 0 & 0 & 2 & 1 \\\\ 0 & 0 & 0 & 3\\end{aligned}]\n$$\n\n- Statement II is false, since $C$ has non-zero entries above the main diagonal:\n\n$$\nC=[\\begin{aligned}2 & 0 & 1 & 0 \\\\ 0 & 4 & 0 & 4 \\\\ 0 & 0 & 2 & 1 \\\\ 0 & 0 & 0 & 3\\end{aligned}]\n$$\n\n- Statement III is false, since ${C}^{T}$ has non-zero entries below the main diagonal:\n\n$$\n{C}^{T}=[\\begin{aligned}2 & 0 & 0 & 0 \\\\ 0 & 4 & 0 & 0 \\\\ 1 & 0 & 2 & 0 \\\\ 0 & 4 & 1 & 3\\end{aligned}]\n$$\n\nTherefore, the correct answer is \"I only\"."}]}
