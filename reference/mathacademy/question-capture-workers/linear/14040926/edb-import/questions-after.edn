t :answer-field.type/radio} :db/id #edb/ref 17592186310147}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "260938e8-7ffc-55b7-bd5c-d266a338e0eb" :question/math-academy-id "q-13782" :question/problem "How can we best describe the following matrix? \n\n$$\nA=[\\begin{aligned}9 & 0 & 0 \\\\ 2 & 7 & 0 \\\\ 0 & 4 & 1\\end{aligned}]\n$$" :question/worked-solution "Notice that $A$ is a matrix for which all entries above the diagonal are $0$'s:\n\n$$\nA=[\\begin{aligned}9 & 0 & 0 \\\\ 2 & 7 & 0 \\\\ 0 & 4 & 1\\end{aligned}]\n$$\n\nTherefore, it is a lower triangular matrix.\n\nIt is not an upper triangular matrix or a diagonal matrix since there is a non-zero element below the diagonal: ${a}_{21}=2\\ne 0.$"}] [{:db/id #edb/ref 17592186310153 :knowledge-point/_questions [{:knowledge-point/id #uuid "1cca9b7c-358a-5f62-9a53-a696df0dd0ff" :knowledge-point/title "Describing a Triangular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d05f5a6a-bf6c-5d84-bcdc-d9368c9cbef8" :answer/type {:db/ident :answer.type/text} :answer/value "Other" :db/id #edb/ref 17592186310155} {:answer/id #uuid "2b73ec89-d6f5-562b-a298-3a09a6d7e58e" :answer/type {:db/ident :answer.type/text} :answer/value "Identity matrix" :db/id #edb/ref 17592186310156} {:answer/id #uuid "ccf57353-15e9-5cda-a664-a0ed2c4abd4b" :answer/type {:db/ident :answer.type/text} :answer/value "Lower triangular matrix" :db/id #edb/ref 17592186310157} {:answer/id #uuid "f877b560-d41e-5060-a968-fccad932c076" :answer/type {:db/ident :answer.type/text} :answer/value "Diagonal matrix" :db/id #edb/ref 17592186310158} {:answer/id #uuid "96dd08a0-4401-53ea-bf78-c77689e55a5e" :answer/type {:db/ident :answer.type/text} :answer/value "Upper triangular matrix" :db/id #edb/ref 17592186310159}] :answer-field/correct {:answer/id #uuid "f877b560-d41e-5060-a968-fccad932c076" :answer/type {:db/ident :answer.type/text} :answer/value "Diagonal matrix" :db/id #e