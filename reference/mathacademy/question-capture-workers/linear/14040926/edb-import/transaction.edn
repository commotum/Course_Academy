ices ["q-126354/selection/cd7694f7109db8f25a3fa44b59e36529ecd4ce115ebe810bb33a2742e94bd50e" "q-126354/selection/699660d0302e0f22001eeae36c0702d8ffb17fd83748cfefabfc0922a9dc2002" "q-126354/selection/38f3627ffa6417ad917de3b8022419eb695a566ab3393d30159c130054901680" "q-126354/selection/6725395841dd527d3d6f1cbd2a2a5a204536a871d0e700da75b1d16aaa43dbc9" "q-126354/selection/a0b9081c36f88561e9df23375a28cb632bf35975310ab6708f31c4e42c7945ee"] :db/ensure [:answer-field/validate]} {:db/id "q-126354" :question/id #uuid "73ffc370-9a32-5663-9460-f8c07e978254" :question/math-academy-id "q-126354" :question/problem "Which of the following is an upper triangular matrix?" :question/worked-solution "Notice that $E$ is a matrix for which all entries *below* the diagonal are $0$'s:\n\n$$\nE=[\\begin{aligned}1 & -3 \\\\ 0 & 5\\end{aligned}]\n$$\n\nHence, it is an upper triangular matrix. \n\nBy contrast, matrices $A$, $B$, $C$, and $D$ each have at least one non-zero entry below the diagonal:\n\n$$\nA=[\\begin{aligned}9 & 0 \\\\ -1 & 1\\end{aligned}],\\,B=[\\begin{aligned}2 & 0 \\\\ 1 & 1\\end{aligned}],\\,C=[\\begin{aligned}6 & 7 \\\\ -2 & 1\\end{aligned}],\\,D=[\\begin{aligned}2 & 1 \\\\ 1 & 2\\end{aligned}].\n$$\n\nSo, they are not upper triangular matrices." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-126354/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b55b50a0-034f-57c0-8a61-883cfb0412dc"] :knowledge-point/questions ["q-126354"] :db/ensure [:knowledge-point/validate]} {:db/id "q-126477/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "9e77d134-7848-5eb3-a893-0655b38a7c54" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-126477/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "2c51a088-0fd4-5160-8719-5f3f23d34d6a" :answer/type :answer.type/text :answer/value "I only" :db/ensure 