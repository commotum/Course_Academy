selection/4e5c5bd88405910d3b00015b769c3a507c5e97b1b9fc7ffe5910ad41a1f3070e" "q-13760/selection/a7f9fc8c8a2d55aaea1b27ece090c378da7b626a1690353b73f5897c7b58dd7a" "q-13760/selection/b6314311466196d736d5eecd77fb956173c00be161bf81d99b1c0f7310467f02" "q-13760/selection/88f58d6a95f6bab22a4e8053f5f360549d39a0688c4f93f2838484d9e1f53d65" "q-13760/selection/3e07d868119652914e8b15ef81356f17ec55a5a7be449582e3b8e2b1a7364e61"] :db/ensure [:answer-field/validate]} {:db/id "q-13760" :question/id #uuid "817df60a-a122-5c88-a4b8-f32eff3f52e0" :question/math-academy-id "q-13760" :question/problem "Which of the following is an upper triangular matrix?" :question/worked-solution "Notice that $A$ is a matrix for which all entries *below* the diagonal are $0$'s:\n\n$$\nA=[\\begin{aligned}0 & 1 & 0 \\\\ 0 & 2 & 3 \\\\ 0 & 0 & 0\\end{aligned}]\n$$\n\nHence, it is an upper triangular matrix. \n\nBy contrast, matrices $B$, $C$, $D$, and $E$ each have at least one non-zero entry below the diagonal:\n\n$$\nB=[\\begin{aligned}2 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ -5 & 0 & 0\\end{aligned}],\\,C=[\\begin{aligned}0 & 1 & 0 \\\\ -1 & 2 & 3 \\\\ 0 & -3 & 0\\end{aligned}],\\,D=[\\begin{aligned}1 & 1 \\\\ 1 & 1\\end{aligned}],\\,E=[\\begin{aligned}1 & 0 \\\\ 1 & 1\\end{aligned}].\n$$\n\nSo, they are not upper triangular matrices." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-13760/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b55b50a0-034f-57c0-8a61-883cfb0412dc"] :knowledge-point/questions ["q-13760"] :db/ensure [:knowledge-point/validate]} {:db/id "q-126353/selection/ef425e0d7e2016b7170ef4936814a14c36344092a15fcd4f25e63fb99d3c16a6" :answer/id #uuid "c3b293f4-4819-5ded-a76d-a0c094a7223d" :answer/type :answer.type/math :answer/value "D=[\\begin{aligned}0 & -2 \\\\ 7 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-126353/selection/5f163daaf664f57490ab66cbe4637a59c623e5988f17e3c937beac8252dcd746" :answer/id #uuid "6d151779-f227-558a-af