gned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{3\\cdot (-1)-5\\cdot 2}[\\begin{aligned}-1 & -2 \\\\ -5 & 3\\end{aligned}] \\\\  & =-\\frac{1}{13}[\\begin{aligned}-1 & -2 \\\\ -5 & 3\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{13}[\\begin{aligned}-1 & -2 \\\\ -5 & 3\\end{aligned}][\\begin{aligned}4 \\\\ -6\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041555/state.json" "file_sha256" "1a35cce6ef5b960efb55fbeefff0165f9791a554d68db697e65fd87a63ed6dfe" "basis" 1503 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041555/edb-import/verification.json"} {"question" "q-321441" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041555/activity-metadata.json" "file_sha256" "accd8fff95b0dbeadacb9cd38ae26fe1ab7cf46fa5191fd1db1f96a6a46c559f" "basis" 1503 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041555/edb-import/verification.json"} {"question" "q-321441" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041555/state.json" "file_sha256" "1a35cce6ef5b960efb55fbeefff0165f9791a554d68db697e65fd87a63ed6dfe" "basis" 1503 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041555/edb-import/verification.json"} {"question" "q-321441" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{1}{13}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041555/st