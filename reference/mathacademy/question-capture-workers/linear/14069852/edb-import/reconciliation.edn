ourse_Academy/reference/mathacademy/question-capture/14041555/edb-import/verification.json"}] "sources" [{"question" "q-12286" "field" nil "attribute" "question/problem" "value" "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n{\\begin{aligned}8y=6 \\\\ -5x=7-6y\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069852/state.json" "file_sha256" "e51121f334fe1790547cffd501e4519a55456dd6fa3e47acee2aea482ddce61b"} {"question" "q-12286" "field" nil "attribute" "question/worked-solution" "value" "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n{\\begin{aligned}8y=6 \\\\ -5x+6y=7\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}0 & 8 \\\\ -5 & 6\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}6 \\\\ 7\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}0 & 8 \\\\ -5 & 6\\end{aligned}]$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{6\\cdot 0-(-5)\\cdot 8}[\\begin{aligned}6 & -8 \\\\ 5 & 0\\end{aligned}] \\\\  & =\\frac{1}{40}[\\begin{aligned}6 & -8 \\\\ 5 & 0\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{40}[\\begin{aligned}6 & -8 \\\\ 5 & 0\\end{aligned}][\\begin{aligned}6 \\\\ 7\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069852/state.json" "file_sha256" "e51121f334fe1790547cffd501e4519a55456dd6fa3e47acee2aea482ddce61b"} {"question" "q-12286" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069852/activity-metadata.json" "file_sha256" "d151efaeeca7576e66fa515ce42372e3392a836969f4c655782ddf588aabf9f5"} {"question" "q-12286" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069852/state.json" "file_sha256" "e51121f334fe1790547cffd501e4519a55456dd6fa3e47acee2aea482ddce61b"} {"question" "q-12286" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "x=-\\frac{1}{40}[\\begin{aligned}6 & -8 \\\\ 5 & 0\\end{aligned}][\\begin{aligned}6 \\\\ 7\\end{aligned}]"] ["math" "x=\\frac{1}{20}[\\begin{aligned}6 & -8 \\\\ 5 & 0\\end{aligned}][\\begin{aligned}6 \\\\ 7\\end{aligned}]"] ["math" "x=\\frac{1}{40}[\\begin{aligned}6 & -8 \\\\ 5 & 0\\end{aligned}][\\begin{aligned}6 \\\\ 7\\end{aligned}]"] ["math" "x=\\frac{1}{40}[\\begin{aligned}6 & 8 \\\\ 5 & 0\\end{aligned}][\\begin{aligned}6 \\\\ 7\\end{aligned}]"] ["math" "x=\\frac{1}{4}[\\begin{aligned}6 & 8 \\\\ -5 & 0\\end{aligned}][\\begin{aligned}6 \\\\ 7\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069852/state.json" "file_sha256" "e51121f334fe1790547cffd501e4519a55456dd6fa3e47acee2aea482ddce61b"} {"question" "q-12286" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "x=\\frac{1}{40}[\\begin{aligned}6 & -8 \\\\ 5 & 0\\end{aligned}][\\begin{aligned}6 \\\\ 7\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069852/state.json" "file_sha256" "e51121f334fe1790547cffd501e4519a55456dd6fa3e47acee2aea482ddce61b"} {"question" "q-32139" "field" nil "attribute" "question/problem" "value" "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n{\\begin{aligned}2x+6y=46 \\\\ 8x+y=-23\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069852/state.json" "file_sha256" "e51121f334fe1790547cffd501e4519a55456dd6fa3e47acee2aea482ddce61b"} {"question" "q-32139" "field" nil "attribute" "question/worked-solution" "value" "This system can be written as\n\n$$\n[\\begin{aligned}2 & 6 \\\\ 8 & 1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}46 \\\\ -23\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}2 & 6 \\\\ 8 & 1\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{2\\cdot 1-6\\cdot 8}[\\begin{aligned}1 & -6 \\\\ -8 & 2\\end{aligned}] \\\\  & =-\\frac{1}{46}[\\begin{aligned}1 & -6 \\\\ -8 & 2\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{46}[\\begin{aligned}1 & -6 \\\\ -8 & 2\\end{aligned}][\\begin{aligned}46 \\\\ -23\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069852/state.json" "file_sha256" "e51121f334fe1790547cffd501e4519a55456dd6fa3e47acee2aea482ddce61b"} {"question" "q-32139" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069852/activity-metadata.json" "file_sha256" "d151efaeeca7576e66fa515ce42372e3392a836969f4c655782ddf588aabf9f5"} {"question" "q-32139" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069852/state.json" "file_sha256" "e51121f334fe1790547cffd501e4519a55456dd6fa3e47acee2aea482ddce61b"} {"question" "q-32139" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "x=-\\frac{1}{46}[\\begin{aligned}1 & -6 \\\\ -8 & 2\\end{aligned}][\\begin{aligned}46 \\\\ -23\\end{aligned}]"] ["math" "x=-\\frac{1}{46}[\\begin{aligned}1 & -8 \\\\ -6 & 2\\end{aligned}][\\begin{aligned}46 \\\\ -23\\end{aligned}]"] ["math" "x=-\\frac{1}{50}[\\begin{aligned}2 & -6 \\\\ -8 & 1\\end{aligned}][\\begin{aligned}46 \\\\ -23\\end{aligned}]"] ["math" "x=\\frac{1}{46}[\\begin{aligned}2 & 6 \\\\ 8 & 1\\end{aligned}][\\begin{aligned}46 \\\\ -23\\end{aligned}]"] ["math" "x=\\frac{1}{50}[\\begin{aligned}1 & 6 \\\\ 8 & 2\\end{aligned}][\\begin{aligned}46 \\\\ -23\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069852/state.json" "file_sha256" "e51121f334fe1790547cffd501e4519a55456dd6fa3e47acee2aea482ddce61b"} {"question" "q-32139" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "x=-\\frac{1}{46}[\\begin{aligned}1 & -6 \\\\ -8 & 2\\end{aligned}][\\begin{aligned}46 \\\\ -23\\end{aligned}]"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069852/state.json" "file_sha256" "e51121f334fe1790547cffd501e4519a55456dd6fa3e47acee2aea482ddce61b"} {"question" "q-72733" "field" nil "attribute" "question/problem" "value" "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n\\begin{aligned}{\\begin{aligned}2x=y+1 \\\\ x-y=2\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069852/state.json" "file_sha256" "e51121f334fe1790547cffd501e4519a55456dd6fa3e47acee2aea482ddce61b"} {"question" "q-72733" "field" nil "attribute" "question/worked-solution" "value" "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n\\begin{aligned}{\\begin{aligned}2x-y=1 \\\\ x-y=2\\end{aligned}\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}2 & -1 \\\\ 1 & -1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}1 \\\\ 2\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $A=[\\begin{aligned}2 & -1 \\\\ 1 & -1\\end{aligned}].$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{(-1)\\cdot 2-(-1)\\cdot 1}[\\begin{aligned}-1 & 1 \\\\ -1 & 2\\end{aligned}] \\\\  & =\\frac{1}{-1}[\\begin{aligned}-1 & 1 \\\\ -1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -1 \\\\ 1 & -2\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =[\\begin{aligned}1 & -1 \\\\ 1 & -2\\end{aligned}][\\begin{aligned}1 \\\\ 2\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069852/state.json" "file_sha256" "e51121f334fe1790547cffd501e4519a55456dd6fa3e47acee2aea482ddce61b"} {"question" "q-72733" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069852/activity-metadata.json" "file_sha256" "d151efaeeca7576e66fa515ce42372e3392a836969f4c655782ddf588aabf9f5"} {"question" "q-72733" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069852/state.json" "file_sha256" "e51121f334fe1790547cffd501e4519a55456dd6fa3e47acee2aea482ddce61b"} {"question" "q-72733" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "x=[\\begin{aligned}-1 & -1 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}2 \\\\ 1\\end{aligned}]"] ["math" "x=[\\begin{aligned}1 & -1 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}2 \\\\ 0\\end{aligned}]"] ["math" "x=[\\begin{aligned}1 & -1 \\\\ 1 & -2\\end{aligned}][\\begin{aligned}1 \\\\ 2\\end{aligned}]"] ["math" "x=[\\begin{aligned}1 & 1 \\\\ -1 & -2\\end{aligned}][\\begin{aligned}0 \\\\ 2\\end{aligned}]"] ["math" "x=[\\begin{aligned}2 & 1 \\\\ -1 & -1\\end{aligned}][\\begin{aligned}1 \\\\ 2\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069852/state.json" "file_sha256" "e51121f334fe1790547cffd501e4519a55456dd6fa3e47acee2aea482ddce61b"} {"question" "q-72733" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "x=[\\begin{aligned}1 & -1 \\\\ 1 & -2\\end{aligned}][\\begin{aligned}1 \\\\ 2\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069852/state.json" "file_sha256" "e51121f334fe1790547cffd501e4519a55456dd6fa3e47acee2aea482ddce61b"} {"question" "q-320803" "field" nil "attribute" "question/problem" "value" "The solution to the system of linear equations\n\n$$\n{\\begin{aligned}7y=5 \\\\ 2x+3y=-1\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n| $x=$ {{field-1}} |\n| --- |\n\n| |  | $3$ | {{field-2}} |  |\n| --- | --- | --- | --- |\n|  | $-2$ | {{field-3}} |  | |  |  |  | |  | $5$ |  |\n| --- | --- | --- |\n|  | $-1$ |  | | . |\n| --- | --- | --- | --- | --- | --- |\n|  | $3$ | {{field-2}} |  |  |  |\n|  | $-2$ | {{field-3}} |  |  |  |\n|  | $5$ |  |  |  |  |\n|  | $-1$ |  |  |  |  |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069852/state.json" "file_sha256" "e51121f334fe1790547cffd501e4519a55456dd6fa3e47acee2aea482ddce61b"} {"question" "q-320803" "field" nil "attribute" "question/worked-solution" "value" "This system can be written as\n\n$$\n[\\begin{aligned}0 & 7 \\\\ 2 & 3\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}5 \\\\ -1\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}0 & 7 \\\\ 2 & 3\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{0\\cdot 3-2\\cdot 7}[\\begin{aligned}3 & -7 \\\\ -2 & 0\\end{aligned}] \\\\  & =-\\frac{1}{14}[\\begin{aligned}3 & -7 \\\\ -2 & 0\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{14}[\\begin{aligned}3 & -7 \\\\ -2 & 0\\end{aligned}][\\begin{aligned}5 \\\\ -1\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069852/state.json" "file_sha256" "e51121f334fe1790547cffd501e4519a55456dd6fa3e47acee2aea482ddce61b"} {"question" "q-320803" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069852/activity-metadata.json" "file_sha256" "d151efaeeca7576e66fa515ce42372e3392a836969f4c655782ddf588aabf9f5"} {"question" "q-320803" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069852/state.json" "file_sha256" "e51121f334fe1790547cffd501e4519a55456dd6fa3e47acee2aea482ddce61b"} {"question" "q-320803" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{1}{14}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069852