#{[{:db/id #edb/ref 17592186092474 :knowledge-point/_questions [{:knowledge-point/id #uuid "4691976a-d825-5f6c-aed7-0d9b45560952" :knowledge-point/title "Solving a 2x2 System of Equations Using an Inverse Matrix With Reorganization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42a622a6-8840-57ed-93ea-2420c8fd8a7a" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{4}[\\begin{aligned}6 & 8 \\\\ -5 & 0\\end{aligned}][\\begin{aligned}6 \\\\ 7\\end{aligned}]" :db/id #edb/ref 17592186364257} {:answer/id #uuid "83d4c411-3b24-56c9-bccf-b1c058f74446" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{40}[\\begin{aligned}6 & 8 \\\\ 5 & 0\\end{aligned}][\\begin{aligned}6 \\\\ 7\\end{aligned}]" :db/id #edb/ref 17592186364258} {:answer/id #uuid "f53cd946-a294-5e21-af18-be686391d4a8" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{40}[\\begin{aligned}6 & -8 \\\\ 5 & 0\\end{aligned}][\\begin{aligned}6 \\\\ 7\\end{aligned}]" :db/id #edb/ref 17592186364259} {:answer/id #uuid "3f0b47d9-64da-54a3-b87c-362f0f9b7c8f" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{1}{40}[\\begin{aligned}6 & -8 \\\\ 5 & 0\\end{aligned}][\\begin{aligned}6 \\\\ 7\\end{aligned}]" :db/id #edb/ref 17592186364260} {:answer/id #uuid "50b5649d-fd6a-5f3a-ab0d-cc37d180aa7d" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{20}[\\begin{aligned}6 & -8 \\\\ 5 & 0\\end{aligned}][\\begin{aligned}6 \\\\ 7\\end{aligned}]" :db/id #edb/ref 17592186364261}] :answer-field/correct {:answer/id #uuid "f53cd946-a294-5e21-af18-be686391d4a8" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{40}[\\begin{aligned}6 & -8 \\\\ 5 & 0\\end{aligned}][\\begin{aligned}6 \\\\ 7\\end{aligned}]" :db/id #edb/ref 17592186364259} :answer-field/id #uuid "766671fe-4beb-5660-bec0-0446183b6768" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364256}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ef69c0bd-1e6b-5aa5-8b52-0d9fec08f2b5" :question/math-academy-id "q-12286" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n{\\begin{aligned}8y=6 \\\\ -5x=7-6y\\end{aligned}\n$$" :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n{\\begin{aligned}8y=6 \\\\ -5x+6y=7\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}0 & 8 \\\\ -5 & 6\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}6 \\\\ 7\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}0 & 8 \\\\ -5 & 6\\end{aligned}]$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{6\\cdot 0-(-5)\\cdot 8}[\\begin{aligned}6 & -8 \\\\ 5 & 0\\end{aligned}] \\\\  & =\\frac{1}{40}[\\begin{aligned}6 & -8 \\\\ 5 & 0\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{40}[\\begin{aligned}6 & -8 \\\\ 5 & 0\\end{aligned}][\\begin{aligned}6 \\\\ 7\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186291778 :knowledge-point/_questions [{:knowledge-point/id #uuid "c89778fa-3c8d-5f0a-a0f8-c9b3d9193ffd" :knowledge-point/title "Solving a 2x2 System of Equations Using an Inverse Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e9e4281b-45b9-5850-b450-663e551b37c9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{14}" :db/id #edb/ref 17592186291780} {:answer/id #uuid "eb802aaa-6f8e-5cf3-bed3-725de7ca309c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{14}" :db/id #edb/ref 17592186364262}] :answer-field/correct {:answer/id #uuid "e9e4281b-45b9-5850-b450-663e551b37c9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{14}" :db/id #edb/ref 17592186291780} :answer-field/id #uuid "14a722ce-cd86-500f-834b-94f317a86457" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291779} {:answer-field/choices [{:answer/id #uuid "72328781-dd75-5a77-82a0-8c1ff6390051" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186291782}] :answer-field/correct {:answer/id #uuid "72328781-dd75-5a77-82a0-8c1ff6390051" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186291782} :answer-field/id #uuid "2c995dba-1502-5177-b159-f659f8875718" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291781} {:answer-field/choices [{:answer/id #uuid "fa6664cf-c8e0-5040-93e8-aac3939aa28c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186291784}] :answer-field/correct {:answer/id #uuid "fa6664cf-c8e0-5040-93e8-aac3939aa28c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186291784} :answer-field/id #uuid "117fb54e-bfa2-503f-9440-27ba8f15512e" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291783}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1646183f-9371-519e-bbf3-6fa5fa1a7cab" :question/math-academy-id "q-320803" :question/problem "The solution to the system of linear equations\n\n$$\n{\\begin{aligned}7y=5 \\\\ 2x+3y=-1\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n| $x=$ {{field-1}} |\n| --- |\n\n| |  | $3$ | {{field-2}} |  |\n| --- | --- | --- | --- |\n|  | $-2$ | {{field-3}} |  | |  |  |  | |  | $5$ |  |\n| --- | --- | --- |\n|  | $-1$ |  | | . |\n| --- | --- | --- | --- | --- | --- |\n|  | $3$ | {{field-2}} |  |  |  |\n|  | $-2$ | {{field-3}} |  |  |  |\n|  | $5$ |  |  |  |  |\n|  | $-1$ |  |  |  |  |" :question/worked-solution "This system can be written as\n\n$$\n[\\begin{aligned}0 & 7 \\\\ 2 & 3\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}5 \\\\ -1\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}0 & 7 \\\\ 2 & 3\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{0\\cdot 3-2\\cdot 7}[\\begin{aligned}3 & -7 \\\\ -2 & 0\\end{aligned}] \\\\  & =-\\frac{1}{14}[\\begin{aligned}3 & -7 \\\\ -2 & 0\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{14}[\\begin{aligned}3 & -7 \\\\ -2 & 0\\end{aligned}][\\begin{aligned}5 \\\\ -1\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286356 :knowledge-point/_questions [{:knowledge-point/id #uuid "c89778fa-3c8d-5f0a-a0f8-c9b3d9193ffd" :knowledge-point/title "Solving a 2x2 System of Equations Using an Inverse Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50336411-1fa5-5ede-962e-0f9067f0173b" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{1}{50}[\\begin{aligned}2 & -6 \\\\ -8 & 1\\end{aligned}][\\begin{aligned}46 \\\\ -23\\end{aligned}]" :db/id #edb/ref 17592186286358} {:answer/id #uuid "8e577c6e-12c2-5ac9-8f6c-342c5862f64e" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{1}{46}[\\begin{aligned}1 & -8 \\\\ -6 & 2\\end{aligned}][\\begin{aligned}46 \\\\ -23\\end{aligned}]" :db/id #edb/ref 17592186286359} {:answer/id #uuid "dfb7f0bc-862e-5a37-9056-f59979467bb4" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{50}[\\begin{aligned}1 & 6 \\\\ 8 & 2\\end{aligned}][\\begin{aligned}46 \\\\ -23\\end{aligned}]" :db/id #edb/ref 17592186286360} {:answer/id #uuid "15c7f7c9-a850-5b04-a269-df4f141633d8" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{46}[\\begin{aligned}2 & 6 \\\\ 8 & 1\\end{aligned}][\\begin{aligned}46 \\\\ -23\\end{aligned}]" :db/id #edb/ref 17592186286361} {:answer/id #uuid "81201c97-fe44-565d-b701-3f21d12bd4ed" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{1}{46}[\\begin{aligned}1 & -6 \\\\ -8 & 2\\end{aligned}][\\begin{aligned}46 \\\\ -23\\end{aligned}]" :db/id #edb/ref 17592186286362}] :answer-field/correct {:answer/id #uuid "81201c97-fe44-565d-b701-3f21d12bd4ed" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{1}{46}[\\begin{aligned}1 & -6 \\\\ -8 & 2\\end{aligned}][\\begin{aligned}46 \\\\ -23\\end{aligned}]" :db/id #edb/ref 17592186286362} :answer-field/id #uuid "d4d621bb-24d8-503d-8db5-4373766fe8dd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286357}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "34c426c5-7657-5020-93fd-26e20c441212" :question/math-academy-id "q-32139" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n{\\begin{aligned}2x+6y=46 \\\\ 8x+y=-23\\end{aligned}\n$$" :question/worked-solution "This system can be written as\n\n$$\n[\\begin{aligned}2 & 6 \\\\ 8 & 1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}46 \\\\ -23\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}2 & 6 \\\\ 8 & 1\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{2\\cdot 1-6\\cdot 8}[\\begin{aligned}1 & -6 \\\\ -8 & 2\\end{aligned}] \\\\  & =-\\frac{1}{46}[\\begin{aligned}1 & -6 \\\\ -8 & 2\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{46}[\\begin{aligned}1 & -6 \\\\ -8 & 2\\end{aligned}][\\begin{aligned}46 \\\\ -23\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311804 :knowledge-point/_questions [{:knowledge-point/id #uuid "c89778fa-3c8d-5f0a-a0f8-c9b3d9193ffd" :knowledge-point/title "Solving a 2x2 System of Equations Using an Inverse Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ef8351b-b7c0-56ce-8896-04c9de714e9d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{13}" :db/id #edb/ref 17592186311806}] :answer-field/correct {:answer/id #uuid "1ef8351b-b7c0-56ce-8896-04c9de714e9d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{13}" :db/id #edb/ref 17592186311806} :answer-field/id #uuid "4a0752da-4404-5c4b-ae3a-687f49db8bb6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311805} {:answer-field/choices [{:answer/id #uuid "39b4f766-4a01-5582-a9fb-59b6ebee58c9" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186311808}] :answer-field/correct {:answer/id #uuid "39b4f766-4a01-5582-a9fb-59b6ebee58c9" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186311808} :answer-field/id #uuid "2a05cf06-46b3-5b36-a34a-76484ba317e2" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311807} {:answer-field/choices [{:answer/id #uuid "0bca49bc-48c4-5d62-9b05-2365f095a552" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186311810}] :answer-field/correct {:answer/id #uuid "0bca49bc-48c4-5d62-9b05-2365f095a552" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186311810} :answer-field/id #uuid "3bbdd4e3-1fe4-5a52-ba95-95c6c76ddd71" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311809}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "5037554e-827b-5077-aae9-a05ccc0e3b02" :question/math-academy-id "q-321441" :question/problem "The solution to the system of linear equations\n\n$$\n{\\begin{aligned}3x+2y=4 \\\\ 5x-y=-6\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n| $x=$ {{field-1}} |\n| --- |\n\n| |  | $-1$ | {{field-2}} |  |\n| --- | --- | --- | --- |\n|  | {{field-3}} | $3$ |  | |  |  |  | |  | $4$ |  |\n| --- | --- | --- |\n|  | $-6$ |  | | . |\n| --- | --- | --- | --- | --- | --- |\n|  | $-1$ | {{field-2}} |  |  |  |\n|  | {{field-3}} | $3$ |  |  |  |\n|  | $4$ |  |  |  |  |\n|  | $-6$ |  |  |  |  |" :question/worked-solution "This system can be written as\n\n$$\n[\\begin{aligned}3 & 2 \\\\ 5 & -1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}4 \\\\ -6\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}3 & 2 \\\\ 5 & -1\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{3\\cdot (-1)-5\\cdot 2}[\\begin{aligned}-1 & -2 \\\\ -5 & 3\\end{aligned}] \\\\  & =-\\frac{1}{13}[\\begin{aligned}-1 & -2 \\\\ -5 & 3\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{13}[\\begin{aligned}-1 & -2 \\\\ -5 & 3\\end{aligned}][\\begin{aligned}4 \\\\ -6\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311811 :knowledge-point/_questions [{:knowledge-point/id #uuid "4691976a-d825-5f6c-aed7-0d9b45560952" :knowledge-point/title "Solving a 2x2 System of Equations Using an Inverse Matrix With Reorganization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17f57512-fab5-5581-8f42-0dd10e1f2c80" :answer/type {:db/ident :answer.type/math} :answer/value "x=[\\begin{aligned}1 & -1 \\\\ 1 & -2\\end{aligned}][\\begin{aligned}1 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186311813} {:answer/id #uuid "4e89bbbf-21a4-5e14-8d55-32ad48d7d8fb" :answer/type {:db/ident :answer.type/math} :answer/value "x=[\\begin{aligned}1 & 1 \\\\ -1 & -2\\end{aligned}][\\begin{aligned}0 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186311814} {:answer/id #uuid "90af8c35-1090-58d1-9d50-e581d7b600f4" :answer/type {:db/ident :answer.type/math} :answer/value "x=[\\begin{aligned}-1 & -1 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}2 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186311815} {:answer/id #uuid "eec0083a-1955-54e8-a26c-955ae7e4e64f" :answer/type {:db/ident :answer.type/math} :answer/value "x=[\\begin{aligned}2 & 1 \\\\ -1 & -1\\end{aligned}][\\begin{aligned}1 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186311816} {:answer/id #uuid "669aec03-1b73-5cfa-b04c-038b10b5d7d4" :answer/type {:db/ident :answer.type/math} :answer/value "x=[\\begin{aligned}1 & -1 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}2 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186311817}] :answer-field/correct {:answer/id #uuid "17f57512-fab5-5581-8f42-0dd10e1f2c80" :answer/type {:db/ident :answer.type/math} :answer/value "x=[\\begin{aligned}1 & -1 \\\\ 1 & -2\\end{aligned}][\\begin{aligned}1 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186311813} :answer-field/id #uuid "bcb9503e-a87d-5cff-9ea9-1cf33d2a4045" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311812}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "68e213ba-56c3-52ad-a2ef-a544dacede35" :question/math-academy-id "q-72733" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n\\begin{aligned}{\\begin{aligned}2x=y+1 \\\\ x-y=2\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n\\begin{aligned}{\\begin{aligned}2x-y=1 \\\\ x-y=2\\end{aligned}\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}2 & -1 \\\\ 1 & -1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}1 \\\\ 2\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $A=[\\begin{aligned}2 & -1 \\\\ 1 & -1\\end{aligned}].$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{(-1)\\cdot 2-(-1)\\cdot 1}[\\begin{aligned}-1 & 1 \\\\ -1 & 2\\end{aligned}] \\\\  & =\\frac{1}{-1}[\\begin{aligned}-1 & 1 \\\\ -1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -1 \\\\ 1 & -2\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =[\\begin{aligned}1 & -1 \\\\ 1 & -2\\end{aligned}][\\begin{aligned}1 \\\\ 2\\end{aligned}]\\end{aligned}\n$$"}]}
