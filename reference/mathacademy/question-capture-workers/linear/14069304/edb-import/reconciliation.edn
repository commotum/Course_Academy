mbda \\end{aligned}|+(-1)|\\begin{aligned}1 & -3-\\lambda  \\\\ 1 & 2\\end{aligned}| & =0 \\\\ (3-\\lambda )({\\lambda }^{2}+5\\lambda )+(-\\lambda -5)-(5+\\lambda ) & =0 \\\\ (-{\\lambda }^{3}-2{\\lambda }^{2}+15\\lambda )-\\lambda -5-5-\\lambda  & =0 \\\\ -{\\lambda }^{3}-2{\\lambda }^{2}+13\\lambda -10 & =0 \\\\ {\\lambda }^{3}+2{\\lambda }^{2}-13\\lambda +10 & =0\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069304/state.json" "file_sha256" "5f573799971842410fe5a6e974beb856ffdb8ac2f3d98fec1c7fe6e1a2cdd4ea"} {"question" "q-140515" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069304/activity-metadata.json" "file_sha256" "ed1e89aa50aeafedf94e75660cb5117aff44b782d1fdce0129ac6c1d42a8c669"} {"question" "q-140515" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069304/state.json" "file_sha256" "5f573799971842410fe5a6e974beb856ffdb8ac2f3d98fec1c7fe6e1a2cdd4ea"} {"question" "q-140515" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{\\lambda }^{3}+13{\\lambda }^{2}+2\\lambda +4=0"] ["math" "{\\lambda }^{3}+2{\\lambda }^{2}+13\\lambda -15=0"] ["math" "{\\lambda }^{3}+2{\\lambda }^{2}-13\\lambda +10=0"] ["math" "{\\lambda }^{3}-2{\\lambda }^{2}-13\\lambda +25=0"] ["math" "{\\lambda }^{3}-2{\\lambda }^{2}-13\\lambda -30=0"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069304/state.json" "file_sha256" "5f573799971842410fe5a6e974beb856ffdb8ac2f3d98fec1c7fe6e1a2cdd4ea"} {"question" "q-140515" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{\\lambda }^{3}+2{\\lambda }^{2}-13\\lambda +10=0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069304/state.json" "file_sha256" "5f573799971842410fe5a6e974beb856ffdb8ac2f3d98fec1c7fe6e1a2cdd4ea"} {"question" "q-80825" "field" nil "attribute" "question/problem" "value" "Determine all real eigenvalues $\\lambda $ of the matrix \n$A=[\\begin{aligned}-1 & 1 & 0 \\\\ 1 & 2 & 1 \\\\ 0 & 3 & -1\\end{aligned}].$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069304/state.json" "file_sha256" "5f573799971842410fe5a6e974beb856ffdb8ac2f3d98fec1c7fe6e1a2cdd4ea"} {"question" "q-80825" "field" nil "attribute" "question/worked-solution" "value" "First, we find the matrix $\\,A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=[\\begin{aligned}-1-\\lambda  & 1 & 0 \\\\ 1 & 2-\\lambda  & 1 \\\\ 0 & 3 & -1-\\lambda \\end{aligned}]\n$$\n\nThe characteristic equation is given by $det(A-\\lambda I)=0.$ \n\nExpanding the determinant across the $1$st row, we get the following:\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ |\\begin{aligned}-1-\\lambda  & 1 & 0 \\\\ 1 & 2-\\lambda  & 1 \\\\ 0 & 3 & -1-\\lambda \\end{aligned}| & =0 \\\\ (-1-\\lambda )|\\begin{aligned}2-\\lambda  & 1 \\\\ 3 & -1-\\lambda \\end{aligned}|-1|\\begin{aligned}1 & 1 \\\\ 0 & -1-\\lambda \\end{aligned}| & =0 \\\\ (-{\\lambda }^{3}+6\\lambda +5)-(-1-\\lambda ) & =0 \\\\ -{\\lambda }^{3}+7\\lambda +6 & =0 \\\\ {\\lambda }^{3}-7\\lambda -6 & =0\\end{aligned}\n$$\n\nNow, we need to solve this equation. We find the first root by testing some values. According to the rational zeros theorem, a list of good first guesses consists of all divisors of $6:$ \n\n$$\n\\pm 1,\\pm 2,\\pm 3,\\pm 6\n$$\n\n- Let's pick $x=1.$ Substituting to the characteristic equation gives\n\n$$\n\\begin{aligned}(1)^{3}-7(1)-6 & =-12.\\end{aligned}\n$$\n\nHence, $\\lambda =1$ is not a root of the equation.\n\n- Let's pick $x=-1.$ Substituting to the characteristic equation gives\n\n$$\n\\begin{aligned}(-1)^{3}-7(-1)-6 & =0.\\end{aligned}\n$$\n\nHence, $\\lambda =-1$ is a root of the equation.\n\nSo, we can factor $(\\lambda +1)$ out of ${\\lambda }^{3}-7\\lambda -6$ using synthetic division:\n\n| $-1$ | $1$ | $0$ | $-7$ | $-6$ |\n| --- | --- | --- | --- | --- |\n|  | $↓$ | $-1$ | $1$ | $6$ |\n|  | $1$ | $-1$ | $-6$ | $0$ |\n\nSo, we obtain the following factorization:\n\n$$\n\\begin{aligned}(\\lambda +1)({\\lambda }^{2}-\\lambda -6) & =0 \\\\ (\\lambda +1)(\\lambda +2)(\\lambda -3) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues are ${\\lambda }_{1}=-1,$ $\\,{\\lambda }_{2}=-2,\\,$ and $\\,{\\lambda }_{3}=3.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069304/state.json" "file_sha256" "5f573799971842410fe5a6e974beb856ffdb8ac2f3d98fec1c7fe6e1a2cdd4ea"} {"question" "q-80825" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069304/activity-metadata.json" "file_sha256" "ed1e89aa50aeafedf94e75660cb5117aff44b782d1fdce0129ac6c1d42a8c669"} {"question" "q-80825" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069304/state.json" "file_sha256" "5f573799971842410fe5a6e974beb856ffdb8ac2f3d98fec1c7fe6e1a2cdd4ea"} {"question" "q-80825" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\lambda \\in {-1,-2,3}"] ["math" "\\lambda \\in {-1,2,-3}"] ["math" "\\lambda \\in {-1,2}"] ["math" "\\lambda \\in {1,-6}"] ["math" "\\lambda \\in {2,-3}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069304/state.json" "file_sha256" "5f573799971842410fe5a6e974beb856ffdb8ac2f3d98fec1c7fe6e1a2cdd4ea"} {"question" "q-80825" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\lambda \\in {-1,-2,3}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069304/state.json" "file_sha256" "5f573799971842410fe5a6e974beb856ffdb8ac2f3d98fec1c7fe6e1a2cdd4ea"} {"question" "q-37396" "field" nil "attribute" "question/problem" "value" "Find the characteristic equation of the matrix \n$B=[\\begin{aligned}-9 & 9 & 0 \\\\ 0 & 5 & -8 \\\\ -2 & 1 & 0\\end{aligned}].$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069304/state.json" "file_sha256" "5f573799971842410fe5a6e974beb856ffdb8ac2f3d98fec1c7fe6e1a2cdd4ea"} {"question" "q-37396" "field" nil "attribute" "question/worked-solution" "value" "First, we find the matrix $\\,B-\\lambda I:$\n﻿﻿﻿\n\n$$\nB-\\lambda I=[\\begin{aligned}-9-\\lambda  & 9 & 0 \\\\ 0 & 5-\\lambda  & -8 \\\\ -2 & 1 & -\\lambda \\end{aligned}].\n$$\n\nThe characteristic equation is $det(B-\\lambda I)=0.$ \n\nExpanding the determinant across the $1$st row, we get the following:\n\n$$\n\\begin{aligned}det(B-\\lambda I) & =0 \\\\ |\\begin{aligned}-9-\\lambda  & 9 & 0 \\\\ 0 & 5-\\lambda  & -8 \\\\ -2 & 1 & -\\lambda \\end{aligned}| & =0 \\\\ (-9-\\lambda )|\\begin{aligned}5-\\lambda  & -8 \\\\ 1 & -\\lambda \\end{aligned}|-9|\\begin{aligned}0 & -8 \\\\ -2 & -\\lambda \\end{aligned}| & =0 \\\\ (-9-\\lambda )({\\lambda }^{2}-5\\lambda +8)-9(-16) & =0 \\\\ (-{\\lambda }^{3}-4{\\lambda }^{2}+37\\lambda -72)+144 & =0 \\\\ -{\\lambda }^{3}-4{\\lambda }^{2}+37\\lambda +72 & =0 \\\\ {\\lambda }^{3}+4{\\lambda }^{2}-37\\lambda -72 & =0\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069304/state.json" "file_sha256" "5f573799971842410fe5a6e974beb856ffdb8ac2f3d98fec1c7fe6e1a2cdd4ea"} {"question" "q-37396" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069304/activity-metadata.json" "file_sha256" "ed1e89aa50aeafedf94e75660cb5117aff44b782d1fdce0129ac6c1d42a8c669"} {"question" "q-37396" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069304/state.json" "file_sha256" "5f573799971842410fe5a6e974beb856ffdb8ac2f3d98fec1c7fe6e1a2cdd4ea"} {"question" "q-37396" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{\\lambda }^{3}+4{\\lambda }^{2}-37\\lambda -108=0"] ["math" "{\\lambda }^{3}+4{\\lambda }^{2}-37\\lambda -72=0"] ["math" "{\\lambda }^{3}+4{\\lambda }^{2}-53\\lambda -36=0"] ["math" "{\\lambda }^{3}-4{\\lambda }^{2}+53\\lambda +36=0"] ["math" "{\\lambda }^{3}-4{\\lambda }^{2}-37\\lambda +72=0"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069304/state.json" "file_sha256" "5f573799971842410fe5a6e974beb856ffdb8ac2f3d98fec1c7fe6e1a2cdd4ea"} {"question" "q-37396" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{\\lambda }^{3}+4{\\lambda }^{2}-37\\lambda -72=0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069304/state.json" "file_sha256" "5f573799971842410fe5a6e974beb856ffdb8ac2f3d98fec1c7fe6e1a2cdd4ea"} {"question" "q-86758" "field" nil "attribute" "question/problem" "value" "Determine all real eigenvalues $\\lambda $ of the matrix \n$O=[\\begin{aligned}-1 & 0 & 1 \\\\ 0 & -1 & 1 \\\\ 1 & 1 & 0\\end{aligned}].$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069304/state.json" "file_sha256" "5f573799971842410fe5a6e974beb856ffdb8ac2f3d98fec1c7fe6e1a2cdd4ea"} {"question" "q-86758" "field" nil "attribute" "question/worked-solution" "value" "First, we find the matrix $\\,O-\\lambda I:$\n﻿﻿﻿\n\n$$\nO-\\lambda I=[\\begin{aligned}-1-\\lambda  & 0 & 1 \\\\ 0 & -1-\\lambda  & 1 \\\\ 1 & 1 & -\\lambda \\end{aligned}]\n$$\n\nThe characteristic equation is given by $det(O-\\lambda I)=0.$ \n\nExpanding the determinant across the $1$st row, we get the following:\n\n$$\n\\begin{aligned}det(O-\\lambda I) & =0 \\\\ |\\begin{aligned}-1-\\lambda  & 0 & 1 \\\\ 0 & -1-\\lambda  & 1 \\\\ 1 & 1 & -\\lambda \\end{aligned}| & =0 \\\\ (-1-\\lambda )|\\begin{aligned}-1-\\lambda  & 1 \\\\ 1 & -\\lambda \\end{aligned}|+1|\\begin{aligned}0 & -1-\\lambda  \\\\ 1 & 1\\end{aligned}| & =0 \\\\ (-{\\lambda }^{3}-2{\\lambda }^{2}+1)+(\\lambda +1) & =0 \\\\ -{\\lambda }^{3}-2{\\lambda }^{2}+\\lambda +2 & =0 \\\\ {\\lambda }^{3}+2{\\lambda }^{2}-\\lambda -2 & =0\\end{aligned}\n$$\n\nNow, we need to solve this equation. We find the first root by testing some values. According to the rational zeros theorem, a list of good first guesses consists of all divisors of $2:$ \n\n$$\n\\pm 1,\\pm 2\n$$\n\nLet's pick $x=1.$ Substituting to the characteristic equation gives\n\n$$\n\\begin{aligned}(1)^{3}+2(1)^{2}-(1)-2 & =0.\\end{aligned}\n$$\n\nHence, $\\lambda =1$ is a root of the equation. So, we can factor $(\\lambda -1)$ out of ${\\lambda }^{3}+2{\\lambda }^{2}-\\lambda -2$ using synthetic division:\n\n| $1$ | $1$ | $2$ | $-1$ | $-2$ |\n| --- | --- | --- | --- | --- |\n|  | $↓$ | $1$ | $3$ | $2$ |\n|  | $1$ | $3$ | $2$ | $0$ |\n\nSo, we obtain the following factorization:\n\n$$\n\\begin{aligned}(\\lambda -1)({\\lambda }^{2}+3\\lambda +2) & =0 \\\\ (\\lambda -1)(\\lambda +2)(\\lambda +1) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues are ${\\lambda }_{1}=1,$ $\\,{\\lambda }_{2}=-2,\\,$ and $\\,{\\lambda }_{3}=-1.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069304/state.json" "file_sha256" "5f573799971842410fe5a6e974beb856ffdb8ac2f3d98fec1c7fe6e1a2cdd4ea"} {"question" "q-86758" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069304/activity-metadata.json" "file_sha256" "ed1e89aa50aeafedf94e75660cb5117aff44b782d1fdce0129ac6c1d42a8c669"} {"question" "q-86758" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069304/state.json" "file_sha256" "5f573799971842410fe5a6e974beb856ffdb8ac2f3d98fec1c7fe6e1a2cdd4ea"} {"question" "q-86758" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\lambda \\in {-1,1}"] ["math" "\\lambda \\in {-2,-1,1}"] ["math" "\\lambda \\in {-2,-1}"] ["math" "\\lambda \\in {-2,1}"] ["math" "\\lambda \\in {2,-1,1}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069304/state.json" "file_sha256" "5f573799971842410fe5a6e974beb856ffdb8ac2f3d98fec1c7fe6e1a2cdd4ea"} {"question" "q-86758" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\lambda \\in {-2,-1,1}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069304/state.json" "file_sha256" "5f573799971842410fe5a6e974beb856ffdb8ac2f3d98fec1c7fe6e1a2cdd4ea"} {"question" "q-37394" "field" nil "attribute" "question/problem" "value" "Find the characteristic equation of the matrix \n$B=[\\begin{aligned}-1 & -8 & -4 \\\\ 3 & 8 & 3 \\\\ -6 & -10 & -3\\end{aligned}].$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069304/state.json" "file_sha256" "5f573799971842410fe5a6e974beb856ffdb8ac2f3d98fec1c7fe6e1a2cdd4ea"} {"question" "q-37394" "field" nil "attribute" "question/worked-solution" "value" "First, we find the matrix $\\,B-\\lambda I:$\n﻿﻿﻿\n\n$$\nB-\\lambda I=[\\begin{aligned}-1-\\lambda  & -8 & -4 \\\\ 3 & 8-\\lambda  & 3 \\\\ -6 & -10 & -3-\\lambda \\end{aligned}]\n$$\n\nThe characteristic equation is $det(B-\\lambda I)=0.$ \n\nExpanding the determinant across the $1$st row, we get the following:\n\n$$\n\\begin{aligned}det(B-\\lambda I) & =0 \\\\ |\\begin{aligned}-1-\\lambda  & -8 & -4 \\\\ 3 & 8-\\lambda  & 3 \\\\ -6 & -10 & -3-\\lambda \\end{aligned}| & =0 \\\\ (-1-\\lambda )|\\begin{aligned}8-\\lambda  & 3 \\\\ -10 & -3-\\lambda \\end{aligned}|-(-8)|\\begin{aligned}3 & 3 \\\\ -6 & -3-\\lambda \\end{aligned}|+(-4)|\\begin{aligned}3 & 8-\\lambda  \\\\ -6 & -10\\end{aligned}| & =0 \\\\ (-1-\\lambda )({\\lambda }^{2}-5\\lambda +6)+8(-3\\lambda +9)-4(-6\\lambda +18) & =0 \\\\ (-{\\lambda }^{3}+4{\\lambda }^{2}-\\lambda -6)+(-24\\lambda +72)-(-24\\lambda +72) & =0 \\\\ -{\\lambda }^{3}+4{\\lambda }^{2}-\\lambda -6 & =0 \\\\ {\\lambda }^{3}-4{\\lambda }^{2}+\\lambda +6 & =0\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069304/state.json" "file_sha256" "5f573799971842410fe5a6e974beb856ffdb8ac2f3d98fec1c7fe6e1a2cdd4ea"} {"question" "q-37394" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069304/activity-metadata.json" "file_sha256" "ed1e89aa50aeafedf94e75660cb5117aff44b782d1fdce0129ac6c1d42a8c669"} {"question" "q-37394" "field" "sel