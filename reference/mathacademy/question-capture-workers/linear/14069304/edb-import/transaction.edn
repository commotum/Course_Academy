[{:db/id "q-37354/selection/dd90dc92028d1ae5996cac92e1d1924a372626c0bb7cd4c44ede90257c16daa3" :answer/id #uuid "da51c6ac-1022-5800-9c2f-052f43258537" :answer/type :answer.type/math :answer/value "(\\lambda -1)^{2}(\\lambda +2)=0" :db/ensure [:answer/validate]} {:db/id "q-37354/selection/1da723837aba5341143ae46353b9486b05d7cbf58f98bcc42f821913f91a8a90" :answer/id #uuid "a242941f-f2f7-50ba-9bab-fd846d68afc8" :answer/type :answer.type/math :answer/value "(\\lambda +2)({\\lambda }^{2}-2\\lambda +10)=0" :db/ensure [:answer/validate]} {:db/id "q-37354/selection/dfc7160c08d85b6153f99c4bebc1e9f2a4ab17cbc83b43e7ef6bda53b338fb78" :answer/id #uuid "bcc42793-33f7-534b-883c-f3243664ac50" :answer/type :answer.type/math :answer/value "(\\lambda +3)(\\lambda +2)(\\lambda -3)=0" :db/ensure [:answer/validate]} {:db/id "q-37354/selection/7ea98bcca6ed77f02647889711ee25d293bad3b1bbff7ae28be3b3faa0f32260" :answer/id #uuid "161311e1-e355-556c-978e-16b024e293d1" :answer/type :answer.type/math :answer/value "(\\lambda -2)({\\lambda }^{2}+2\\lambda +10)=0" :db/ensure [:answer/validate]} {:db/id "q-37354/selection/a96ca181e1a50f448d785f71e622ace2391093dd7f913d33e90d2c28edd9c016" :answer/id #uuid "b97a0964-53f2-5c3c-aa92-3fd44114c849" :answer/type :answer.type/math :answer/value "(\\lambda +2)({\\lambda }^{2}-4\\lambda -10)=0" :db/ensure [:answer/validate]} {:db/id "q-37354/selection" :answer-field/id #uuid "3d69bddc-0fd1-5b2b-a519-1f3571f9da53" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-37354/selection/1da723837aba5341143ae46353b9486b05d7cbf58f98bcc42f821913f91a8a90" :answer-field/choices ["q-37354/selection/dd90dc92028d1ae5996cac92e1d1924a372626c0bb7cd4c44ede90257c16daa3" "q-37354/selection/1da723837aba5341143ae46353b9486b05d7cbf58f98bcc42f821913f91a8a90" "q-37354/selection/dfc7160c08d85b6153f99c4bebc1e9f2a4ab17cbc83b43e7ef6bda53b338fb78" "q-37354/selection/7ea98bcca6ed77f02647889711ee25d293bad3b1bbff7ae28be3b3faa0f32260" "q-37354/selection/a96ca181e1a50f448d785f71e622ace2391093dd7f913d33e90d2c28edd9c016"] :db/ensure [:answer-field/validate]} {:db/id "q-37354" :question/id #uuid "fb701c86-951a-5dc2-8e1d-2b0685986ccb" :question/math-academy-id "q-37354" :question/problem "Find the characteristic equation of the matrix \n$B=[\\begin{aligned}1 & -4 & 3 \\\\ 0 & -2 & 0 \\\\ -3 & 5 & 1\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,B-\\lambda I:$\n﻿﻿﻿\n\n$$\nB-\\lambda I=[\\begin{aligned}1-\\lambda  & -4 & 3 \\\\ 0 & -2-\\lambda  & 0 \\\\ -3 & 5 & 1-\\lambda \\end{aligned}]\n$$\n\nThe characteristic equation is $det(B-\\lambda I)=0.$ \n\nExpanding the determinant across the $2$nd row, we obtain the following:  \n\n$$\n\\begin{aligned}det(B-\\lambda I) & =0 \\\\ |\\begin{aligned}1-\\lambda  & -4 & 3 \\\\ 0 & -2-\\lambda  & 0 \\\\ -3 & 5 & 1-\\lambda \\end{aligned}| & =0 \\\\ (-2-\\lambda )|\\begin{aligned}1-\\lambda  & 3 \\\\ -3 & 1-\\lambda \\end{aligned}| & =0 \\\\ (-2-\\lambda )((1-\\lambda )(1-\\lambda )-(3)(-3)) & =0 \\\\ (\\lambda +2)({\\lambda }^{2}-2\\lambda +10) & =0\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-37354/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "289ae874-f555-50ee-896f-eb2188004124"] :knowledge-point/questions ["q-37354"] :db/ensure [:knowledge-point/validate]} {:db/id "q-140449/selection/50baae4f5703afa1e0543da1cfc3cb9a4486e67fbcde0c8e3f2c36b80835447f" :answer/id #uuid "2d0e4b7b-ca76-5bda-a6b2-38485033e3a9" :answer/type :answer.type/math :answer/value "\\lambda \\in {3,-2,6}" :db/ensure [:answer/validate]} {:db/id "q-140449/selection/1b88382b71fc7b0b64e5c9b7cdf6487df43a748ff68e536760bf0db662d96eb5" :answer/id #uuid "e44d3298-65f4-56a6-9eb7-0c0057ca0ae8" :answer/type :answer.type/math :answer/value "\\lambda \\in {3,0,6}" :db/ensure [:answer/validate]} {:db/id "q-140449/selection/a1852f70c79213d2476aad5d86caf928617d9ea2e0d2b0baeaf48f9c5a9da7c9" :answer/id #uuid "bfc8089c-9cb3-55cf-af77-8a3c85e18ff3" :answer/type :answer.type/math :answer/value "\\lambda \\in {-3,4,6}" :db/ensure [:answer/validate]} {:db/id "q-140449/selection/55f8bcbc3b8d65ae2ac9567e1127d352a7a6c483f7e4def6df6b736e5f003fb0" :answer/id #uuid "b25d4d6b-7fa7-5d7e-bd3f-4b7e5ed63218" :answer/type :answer.type/math :answer/value "\\lambda \\in {3,4,6}" :db/ensure [:answer/validate]} {:db/id "q-140449/selection/22e4530037e45a49826bc5d7aa123bff94f378e6ed0613ce7836e337167cc067" :answer/id #uuid "0714fec2-c0cf-5990-90c2-c21f57dbedb0" :answer/type :answer.type/math :answer/value "\\lambda \\in {3,4,9}" :db/ensure [:answer/validate]} {:db/id "q-140449/selection" :answer-field/id #uuid "13700d7b-91ba-5b16-9317-ecb5fb5190fe" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-140449/selection/55f8bcbc3b8d65ae2ac9567e1127d352a7a6c483f7e4def6df6b736e5f003fb0" :answer-field/choices ["q-140449/selection/50baae4f5703afa1e0543da1cfc3cb9a4486e67fbcde0c8e3f2c36b80835447f" "q-140449/selection/1b88382b71fc7b0b64e5c9b7cdf6487df43a748ff68e536760bf0db662d96eb5" "q-140449/selection/a1852f70c79213d2476aad5d86caf928617d9ea2e0d2b0baeaf48f9c5a9da7c9" "q-140449/selection/55f8bcbc3b8d65ae2ac9567e1127d352a7a6c483f7e4def6df6b736e5f003fb0" "q-140449/selection/22e4530037e45a49826bc5d7aa123bff94f378e6ed0613ce7836e337167cc067"] :db/ensure [:answer-field/validate]} {:db/id "q-140449" :question/id #uuid "f772a19b-8ab2-5f26-9ef1-47231e01914d" :question/math-academy-id "q-140449" :question/problem "Determine all real eigenvalues $\\lambda $ of the matrix \n$A=[\\begin{aligned}4 & 0 & 0 \\\\ -5 & 3 & 0 \\\\ -4 & 1 & 6\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=[\\begin{aligned}4-\\lambda  & 0 & 0 \\\\ -5 & 3-\\lambda  & 0 \\\\ -4 & 1 & 6-\\lambda \\end{aligned}]\n$$\n\nThe characteristic equation is $det(A-\\lambda I)=0.$ \n\nSince the determinant of a triangular (or diagonal) matrix is given by the product of the entries on the main diagonal, we obtain the following: \n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ |\\begin{aligned}4-\\lambda  & 0 & 0 \\\\ -5 & 3-\\lambda  & 0 \\\\ -4 & 1 & 6-\\lambda \\end{aligned}| & =0 \\\\ (4-\\lambda )(3-\\lambda )(6-\\lambda ) & =0 \\\\ (\\lambda -4)(\\lambda -3)(\\lambda -6) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues are ${\\lambda }_{1}=3,$ $\\,{\\lambda }_{2}=4,$ and ${\\lambda }_{3}=6.$\n\n**Note:** The eigenvalues of a triangular (or diagonal) matrix are always the entries on the main diagonal." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-140449/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "289ae874-f555-50ee-896f-eb2188004124"] :knowledge-point/questions ["q-140449"] :db/ensure [:knowledge-point/validate]} {:db/id "q-37390/selection/0a22981dbe407a7b0a43d4dca381d0943a7d327402c860c8a901f8ae4916f44b" :answer/id #uuid "fe0382d8-ce11-556a-8bba-f884c1587f14" :answer/type :answer.type/math :answer/value "(\\lambda -8)(\\lambda +7)(\\lambda -3)=0" :db/ensure [:answer/validate]} {:db/id "q-37390/selection/d4a84db78ab466f0b80464c33b4781cee00eaa94f505f0770d18e168cf48b0de" :answer/id #uuid "5f3c6f37-9dcc-5e84-a77b-abcbb8463334" :answer/type :answer.type/math :answer/value "\\lambda (\\lambda -6)(\\lambda +7)=0" :db/ensure [:answer/validate]} {:db/id "q-37390/selection/9277b4e552f0aec58d0467631227b7d657acbfe454600f8d0ccf8af540cbaf81" :answer/id #uuid "b976364e-6983-545a-8c2b-af906b9adbb4" :answer/type :answer.type/math :answer/value "(\\lambda -3)(\\lambda -3)(\\lambda +2)=0" :db/ensure [:answer/validate]} {:db/id "q-37390/selection/4bca76163c2e736c935e4d6a2b7b29f861d2e351aac9b7ff453581bca494acd7" :answer/id #uuid "771bf140-b753-5831-9648-6acf3648614e" :answer/type :answer.type/math :answer/value "(\\lambda -3)(\\lambda -6)(\\lambda +1)=0" :db/ensure [:answer/validate]} {:db/id "q-37390/selection/3a23530ec94ff006e7f91d80c962cf30e5cb76db391ff6084927bbe768f1e205" :answer/id #uuid "d959fb0f-8ecb-5c8a-b5fd-7753de4c41c2" :answer/type :answer.type/math :answer/value "(\\lambda +3)(\\lambda -3)(\\lambda +2)=0" :db/ensure [:answer/validate]} {:db/id "q-37390/selection" :answer-field/id #uuid "3661ee4a-6b05-5186-bc74-d541bbc7585a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-37390/selection/9277b4e552f0aec58d0467631227b7d657acbfe454600f8d0ccf8af540cbaf81" :answer-field/choices ["q-37390/selection/0a22981dbe407a7b0a43d4dca381d0943a7d327402c860c8a901f8ae4916f44b" "q-37390/selection/d4a84db78ab466f0b80464c33b4781cee00eaa94f505f0770d18e168cf48b0de" "q-37390/selection/9277b4e552f0aec58d0467631227b7d657acbfe454600f8d0ccf8af540cbaf81" "q-37390/selection/4bca76163c2e736c935e4d6a2b7b29f861d2e351aac9b7ff453581bca494acd7" "q-37390/selection/3a23530ec94ff006e7f91d80c962cf30e5cb76db391ff6084927bbe768f1e205"] :db/ensure [:answer-field/validate]} {:db/id "q-37390" :question/id #uuid "eddb6d20-0cb7-5e2b-9283-ce07307da093" :question/math-academy-id "q-37390" :question/problem "Find the characteristic equation of the matrix \n$B=[\\begin{aligned}8 & 10 & 0 \\\\ -5 & -7 & 0 \\\\ 6 & -9 & 3\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,B-\\lambda I:$\n﻿﻿﻿\n\n$$\nB-\\lambda I=[\\begin{aligned}8-\\lambda  & 10 & 0 \\\\ -5 & -7-\\lambda  & 0 \\\\ 6 & -9 & 3-\\lambda \\end{aligned}]\n$$\n\nThe characteristic equation is $det(B-\\lambda I)=0.$ \n\nExpanding the determinant across the $3$rd column, we obtain the following:  \n\n$$\n\\begin{aligned}det(B-\\lambda I) & =0 \\\\ |\\begin{aligned}8-\\lambda  & 10 & 0 \\\\ -5 & -7-\\lambda  & 0 \\\\ 6 & -9 & 3-\\lambda \\end{aligned}| & =0 \\\\ (3-\\lambda )|\\begin{aligned}8-\\lambda  & 10 \\\\ -5 & -7-\\lambda \\end{aligned}| & =0 \\\\ (3-\\lambda )((8-\\lambda )(-7-\\lambda )-(-5)(10)) & =0 \\\\ (3-\\lambda )({\\lambda }^{2}-\\lambda -6) & =0 \\\\ (\\lambda -3)(\\lambda -3)(\\lambda +2) & =0\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-37390/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "289ae874-f555-50ee-896f-eb2188004124"] :knowledge-point/questions ["q-37390"] :db/ensure [:knowledge-point/validate]} {:db/id "q-36860/selection/e7b3c90e3da05e034a0a41cd1a32f0bbfdb61a5b422c73fb8387b72c2e8c8a23" :answer/id #uuid "e2042c0b-850e-5f19-8300-eb6487bcf00e" :answer/type :answer.type/math :answer/value "(\\lambda +1)(\\lambda +3)(\\lambda -2)=0" :db/ensure [:answer/validate]} {:db/id "q-36860/selection/6da3cade148fe95de740671eb274c4a1522dcde5dd75065ea7c313d7486240fe" :answer/id #uuid "fd72688e-9a02-53f0-97b4-a015ad6f91cd" :answer/type :answer.type/math :answer/value "(\\lambda -1)(\\lambda -3)(\\lambda -2)=0" :db/ensure [:answer/validate]} {:db/id "q-36860/selection/df20856ff317c8fee61ceadd01f509facc2e802203d778ff740f03a7063489ac" :answer/id #uuid "27d171fb-2b6d-513f-8e7d-3aced11830c3" :answer/type :answer.type/math :answer/value "(\\lambda +1)(\\lambda -1)(\\lambda +1)=0" :db/ensure [:answer/validate]} {:db/id "q-36860/selection/c10f6d5c7fa3ea5c1fe0a513abee43b06755a1406ce751d94b4ad53b42b79b05" :answer/id #uuid "b7961078-4bc8-53ca-b41f-57f2d9c4c8be" :answer/type :answer.type/math :answer/value "(\\lambda -1)(\\lambda +3)(\\lambda -2)=0" :db/ensure [:answer/validate]} {:db/id "q-36860/selection/54181ad4adbc79f10520029d45a59a5a885d293d0ff6e625af023078b7de3c0c" :answer/id #uuid "a3e7f30c-f81a-57b0-acc2-3d20f5428f78" :answer/type :answer.type/math :answer/value "\\lambda (\\lambda -2)(\\lambda +2)=0" :db/ensure [:answer/validate]} {:db/id "q-36860/selection" :answer-field/id #uuid "7c9d897a-ac21-54d0-a991-410c149ebcd0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-36860/selection/e7b3c90e3da05e034a0a41cd1a32f0bbfdb61a5b422c73fb8387b72c2e8c8a23" :answer-field/choices ["q-36860/selection/e7b3c90e3da05e034a0a41cd1a32f0bbfdb61a5b422c73fb8387b72c2e8c8a23" "q-36860/selection/6da3cade148fe95de740671eb274c4a1522dcde5dd75065ea7c313d7486240fe" "q-36860/selection/df20856ff317c8fee61ceadd01f509facc2e802203d778ff740f03a7063489ac" "q-36860/selection/c10f6d5c7fa3ea5c1fe0a513abee43b06755a1406ce751d94b4ad53b42b79b05" "q-36860/selection/54181ad4adbc79f10520029d45a59a5a885d293d0ff6e625af023078b7de3c0c"] :db/ensure [:answer-field/validate]} {:db/id "q-36860" :question/id #uuid "575aa320-c74e-5266-82e6-e8a0338048e2" :question/math-academy-id "q-36860" :question/problem "Find the characteristic equation of the matrix \n$A=[\\begin{aligned}-2 & 0 & -2 \\\\ 1 & -1 & -1 \\\\ -2 & 0 & 1\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=[\\begin{aligned}-2-\\lambda  & 0 & -2 \\\\ 1 & -1-\\lambda  & -1 \\\\ -2 & 0 & 1-\\lambda \\end{aligned}]\n$$\n\nThe characteristic equation is $det(A-\\lambda I)=0.$ \n\nExpanding the determinant across the $2$nd column, we obtain the following:  \n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ |\\begin{aligned}-2-\\lambda  & 0 & -2 \\\\ 1 & -1-\\lambda  & -1 \\\\ -2 & 0 & 1-\\lambda \\end{aligned}| & =0 \\\\ (-1-\\lambda )|\\begin{aligned}-2-\\lambda  & -2 \\\\ -2 & 1-\\lambda \\end{aligned}| & =0 \\\\ (-1-\\lambda )((-2-\\lambda )(1-\\lambda )-(-2)(-2)) & =0 \\\\ (-1-\\lambda )({\\lambda }^{2}+\\lambda -6) & =0 \\\\ (\\lambda +1)(\\lambda +3)(\\lambda -2) & =0\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-36860/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "289ae874-f555-50ee-896f-eb2188004124"] :knowledge-point/questions ["q-36860"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-36845"] :question/problem "Find the characteristic equation of the matrix \n$A=[\\begin{aligned}-3 & 2 & -1 \\\\ 5 & 2 & 3 \\\\ 0 & 0 & 1\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=[\\begin{aligned}-3-\\lambda  & 2 & -1 \\\\ 5 & 2-\\lambda  & 3 \\\\ 0 & 0 & 1-\\lambda \\end{aligned}]\n$$\n\nThe characteristic equation is $det(A-\\lambda I)=0.$ \n\nExpanding the determinant across the $3$rd row, we obtain the following:  \n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ |\\begin{aligned}-3-\\lambda  & 2 & -1 \\\\ 5 & 2-\\lambda  & 3 \\\\ 0 & 0 & 1-\\lambda \\end{aligned}| & =0 \\\\ (1-\\lambda )|\\begin{aligned}-3-\\lambda  & 2 \\\\ 5 & 2-\\lambda \\end{aligned}| & =0 \\\\ (1-\\lambda )((-3-\\lambda )(2-\\lambda )-2\\cdot 5) & =0 \\\\ (1-\\lambda )({\\lambda }^{2}+\\lambda -16) & =0\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-140450/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "6b33ede0-1ce7-56a0-a5df-0c8c7ab20259" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-140450/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "3cb1039a-08f6-5305-80e0-d0a938815b73" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-140450/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "c79cd94f-34d2-56ce-894e-6e609c3549c4" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-140450/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "8a0fded2-ac9c-5437-9236-65c121f82c76" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-140450/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "a5d1578d-4cb5-5420-ae87-122043255126" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-140450/selection" :answer-field/id #uuid "492b4a75-3451-5d04-92fd-2f0fe38420f6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-140450/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer-field/choices ["q-140450/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-140450/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-140450/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-140450/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-140450/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6"] :db/ensure [:answer-field/validate]} {:db/id "q-140450" :question/id #uuid "9ecc9ad3-e2ba-5fb3-b1f1-c3971775671e" :question/math-academy-id "q-140450" :question/problem "$$\nP=[\\begin{aligned}5 & 2 & -6 & 8 \\\\ 0 & 0 & 0 & 7 \\\\ 0 & -3 & -4 & 9 \\\\ 0 & 0 & 0 & 2\\end{aligned}].\n$$\n\nConsider the matrix $P$ given above. Which of the following statements are true?\n\n- $\\lambda =0$ is an eigenvalue of $P$\n- $\\lambda =-4$ is an eigenvalue of $P$\n- The eigenvalue $\\lambda =2$ has algebraic multiplicity $2$" :question/worked-solution "First, we find the matrix $\\,P-\\lambda I:$\n﻿﻿﻿\n\n$$\nP-\\lambda I=[\\begin{aligned}5-\\lambda  & 2 & -6 & 8 \\\\ 0 & -\\lambda  & 0 & 7 \\\\ 0 & -3 & -4-\\lambda  & 9 \\\\ 0 & 0 & 0 & 2-\\lambda \\end{aligned}]\n$$\n\nThe characteristic equation is $det(P-\\lambda I)=0.$ \n\nNotice that we can expand the $4\\times 4$ determinant across the $1$st column, as follows:\n\n$$\n\\begin{aligned}det(P-\\lambda I) & =0 \\\\ |\\begin{aligned}5-\\lambda  & 2 & -6 & 8 \\\\ 0 & -\\lambda  & 0 & 7 \\\\ 0 & -3 & -4-\\lambda  & 9 \\\\ 0 & 0 & 0 & 2-\\lambda \\end{aligned}| & =0 \\\\ (5-\\lambda )|\\begin{aligned}-\\lambda  & 0 & 7 \\\\ -3 & -4-\\lambda  & 9 \\\\ 0 & 0 & 2-\\lambda \\end{aligned}| & =0\\end{aligned}\n$$\n\nNow, expanding the $3\\times 3$ determinant across the $3$rd row, we obtain the following:\n\n$$\n\\begin{aligned}(5-\\lambda )\\cdot (2-\\lambda )|\\begin{aligned}-\\lambda  & 0 \\\\ -3 & -4-\\lambda \\end{aligned}| & =0 \\\\ (5-\\lambda )(2-\\lambda )(-\\lambda )(-4-\\lambda ) & =0 \\\\ (\\lambda -5)(\\lambda -2)\\lambda (\\lambda +4) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues of $P$ are $\\lambda =5,$ $\\lambda =2,$ $\\lambda =0,$ and $\\lambda =-4$  (all with algebraic multiplicity $1$).\n\nTherefore, the correct answer is \"I and II only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-140450/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ef311af0-0e95-5574-a151-2971ad66bd08"] :knowledge-point/questions ["q-140450"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-37355"] :question/problem "$$\nP=[\\begin{aligned}-1 & -9 & -18 & -3 \\\\ 0 & -10 & 0 & 0 \\\\ 0 & 0 & -10 & 0 \\\\ -18 & 18 & -36 & -4\\end{aligned}].\n$$\n\nConsider the matrix $P$ given above. Which of the following statements are true?\n\n- $\\lambda =-1$ is an eigenvalue of $P$\n- $\\lambda =-10$ is an eigenvalue of $P$\n- The eigenvalue $\\lambda =-10$ has algebraic multiplicity $3$" :question/worked-solution "First, we find the matrix $\\,P-\\lambda I:$\n﻿﻿﻿\n\n$$\nP-\\lambda I=[\\begin{aligned}-1-\\lambda  & -9 & -18 & -3 \\\\ 0 & -10-\\lambda  & 0 & 0 \\\\ 0 & 0 & -10-\\lambda  & 0 \\\\ -18 & 18 & -36 & -4-\\lambda \\end{aligned}]\n$$\n\nThe characteristic equation is $det(P-\\lambda I)=0.$ \n\nNotice that we can expand the $4\\times 4$ determinant across the $2$nd row, as follows:\n\n$$\n\\begin{aligned}det(P-\\lambda I) & =0 \\\\ |\\begin{aligned}-1-\\lambda  & -9 & -18 & -3 \\\\ 0 & -10-\\lambda  & 0 & 0 \\\\ 0 & 0 & -10-\\lambda  & 0 \\\\ -18 & 18 & -36 & -4-\\lambda \\end{aligned}| & =0 \\\\ (-10-\\lambda )|\\begin{aligned}-1-\\lambda  & -18 & -3 \\\\ 0 & -10-\\lambda  & 0 \\\\ -18 & -36 & -4-\\lambda \\end{aligned}| & =0\\end{aligned}\n$$\n\nNow, expanding the $3\\times 3$ determinant across the $2$nd row, we obtain the following:\n\n$$\n\\begin{aligned}(-10-\\lambda )\\cdot (-10-\\lambda )|\\begin{aligned}-1-\\lambda  & -3 \\\\ -18 & -4-\\lambda \\end{aligned}| & =0 \\\\ (-10-\\lambda )^{2}((-1-\\lambda )(-4-\\lambda )-54) & =0 \\\\ (\\lambda +10)^{2}({\\lambda }^{2}+5\\lambda -50) & =0 \\\\ (\\lambda +10)^{2}(\\lambda +10)(\\lambda -5) & =0 \\\\ (\\lambda +10)^{3}(\\lambda -5) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues of $P$ are $\\lambda =-10$ (with algebraic multiplicity $3$) and $\\lambda =5.$\n\nTherefore, the correct answer is \"II and III only.\"" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-36843/selection/33416de53847b62a961a50e0ab958ec18ee8949f5711cf57fb282cc59f2485bc" :answer/id #uuid "7dfa30de-bbee-53c1-9abe-937ef3ea82de" :answer/type :answer.type/math :answer/value "(\\lambda -6)(\\lambda +6)(\\lambda +7)(\\lambda +2)=0" :db/ensure [:answer/validate]} {:db/id "q-36843/selection/996ff90af14faa64aac85267b762ec0fd45f59a694825645ffe0412fcf8583bf" :answer/id #uuid "ec022287-4ec7-5d5e-9a88-4f2911268b83" :answer/type :answer.type/math :answer/value "(\\lambda -6)(\\lambda +6)(\\lambda -7)(\\lambda -2)=0" :db/ensure [:answer/validate]} {:db/id "q-36843/selection/58ec400dfad47cf70efedc86e6e065a51b9f82dda148c5174fe89be25433c782" :answer/id #uuid "3585b816-a104-5c3c-86b2-7faeaa866408" :answer/type :answer.type/math :answer/value "(\\lambda -6)(\\lambda +7)(\\lambda +2)=0" :db/ensure [:answer/validate]} {:db/id "q-36843/selection/ce80f7e34fa61f367af9f20e93d23bc9c6bc6ffe4eabe9be372a219a56bac00c" :answer/id #uuid "7c46d776-ca14-5e9a-a854-4a0be2cf06ca" :answer/type :answer.type/math :answer/value "(\\lambda -6)^{2}(\\lambda -7)(\\lambda -2)=0" :db/ensure [:answer/validate]} {:db/id "q-36843/selection/04bbeb10a368d2458c2817fd942a52902742cd13f25c0af56eda59cac99c1cd1" :answer/id #uuid "a55e2efa-8a04-5f25-8922-92ec59bbbaf3" :answer/type :answer.type/math :answer/value "(\\lambda -6)^{2}(\\lambda +7)(\\lambda +2)=0" :db/ensure [:answer/validate]} {:db/id "q-36843/selection" :answer-field/id #uuid "572d8d26-c351-5a69-bb59-ea1f519173de" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-36843/selection/04bbeb10a368d2458c2817fd942a52902742cd13f25c0af56eda59cac99c1cd1" :answer-field/choices ["q-36843/selection/33416de53847b62a961a50e0ab958ec18ee8949f5711cf57fb282cc59f2485bc" "q-36843/selection/996ff90af14faa64aac85267b762ec0fd45f59a694825645ffe0412fcf8583bf" "q-36843/selection/58ec400dfad47cf70efedc86e6e065a51b9f82dda148c5174fe89be25433c782" "q-36843/selection/ce80f7e34fa61f367af9f20e93d23bc9c6bc6ffe4eabe9be372a219a56bac00c" "q-36843/selection/04bbeb10a368d2458c2817fd942a52902742cd13f25c0af56eda59cac99c1cd1"] :db/ensure [:answer-field/validate]} {:db/id "q-36843" :question/id #uuid "d240320f-4168-5ae1-a3dc-306aaeeb5354" :question/math-academy-id "q-36843" :question/problem "Find the characteristic equation of the matrix \n$A=[\\begin{aligned}6 & 0 & 0 & 0 \\\\ 0 & -7 & 0 & 0 \\\\ 0 & 0 & 6 & 0 \\\\ 0 & 0 & 0 & -2\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=[\\begin{aligned}6-\\lambda  & 0 & 0 & 0 \\\\ 0 & -7-\\lambda  & 0 & 0 \\\\ 0 & 0 & 6-\\lambda  & 0 \\\\ 0 & 0 & 0 & -2-\\lambda \\end{aligned}]\n$$\n\nThe characteristic equation is $det(A-\\lambda I)=0.$ \n\nSince the determinant of a triangular (or diagonal) matrix is given by the product of the entries on the main diagonal, we obtain the following: \n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ |\\begin{aligned}6-\\lambda  & 0 & 0 & 0 \\\\ 0 & -7-\\lambda  & 0 & 0 \\\\ 0 & 0 & 6-\\lambda  & 0 \\\\ 0 & 0 & 0 & -2-\\lambda \\end{aligned}| & =0 \\\\ (6-\\lambda )(-7-\\lambda )(6-\\lambda )(-2-\\lambda ) & =0 \\\\ (\\lambda -6)^{2}(\\lambda +7)(\\lambda +2) & =0\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-36843/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ef311af0-0e95-5574-a151-2971ad66bd08"] :knowledge-point/questions ["q-36843"] :db/ensure [:knowledge-point/validate]} {:db/id "q-140471/selection/8b51efe57bedac8b00f1c7143bb90393f945a5c41c5090253adec7e52ab20739" :answer/id #uuid "8d3ad5f3-c593-5589-b3fa-5454d895a1c6" :answer/type :answer.type/math :answer/value "(\\lambda -7)(\\lambda +4)(\\lambda +5)=0" :db/ensure [:answer/validate]} {:db/id "q-140471/selection/6bd3fc41da47bdf3bd936ca3c9ea3d4f72d5a2a8dad76e6c542f2ad19d2a12b0" :answer/id #uuid "5f357b7a-a968-5ef8-b69c-a98b188ccc1f" :answer/type :answer.type/math :answer/value "(\\lambda +7)(\\lambda +4)(\\lambda -3)(\\lambda -2)=0" :db/ensure [:answer/validate]} {:db/id "q-140471/selection/c8c3e66f2bdefb7ec4fc5be7f7b3d80e7324e0680fdd402f810ad3909d560ef3" :answer/id #uuid "445ebe4c-5a57-5934-b05d-cb31e30e72b7" :answer/type :answer.type/math :answer/value "(\\lambda -7)(\\lambda +4)(\\lambda -3)(\\lambda -5)=0" :db/ensure [:answer/validate]} {:db/id "q-140471/selection/58151ac03c5056b7c374f3174d54b78c5e340c6cd393f3e659ee6cff3f0e422b" :answer/id #uuid "903adb35-9bfa-510e-90bf-ea53b460b4e1" :answer/type :answer.type/math :answer/value "(\\lambda -7)(\\lambda +4)(\\lambda -3)(\\lambda +5)=0" :db/ensure [:answer/validate]} {:db/id "q-140471/selection/423e8baf0ffd4b74ab9a6cb9c78f3e5dd9f3db59143ba0d0f2233fbae9493bee" :answer/id #uuid "cefb8419-40ce-5cc3-a557-5f463855cc8e" :answer/type :answer.type/math :answer/value "(\\lambda -1)(\\lambda +4)(\\lambda -8)(\\lambda +5)=0" :db/ensure [:answer/validate]} {:db/id "q-140471/selection" :answer-field/id #uuid "d17c83f0-6240-52e2-b8dc-6604507cf6cb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-140471/selection/58151ac03c5056b7c374f3174d54b78c5e340c6cd393f3e659ee6cff3f0e422b" :answer-field/choices ["q-140471/selection/8b51efe57bedac8b00f1c7143bb90393f945a5c41c5090253adec7e52ab20739" "q-14047