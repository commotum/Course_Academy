+3)=0" :db/ensure [:answer/validate]} {:db/id "q-86749/selection/b253dce42c40cb6fce4e6d69694b9f1d05e84108a79df66262fa80d801a73691" :answer/id #uuid "d77d3a94-0fde-5916-851f-e9e6603ba1db" :answer/type :answer.type/math :answer/value "(\\lambda -3)^{2}(\\lambda +2)(\\lambda -1)=0" :db/ensure [:answer/validate]} {:db/id "q-86749/selection/942c362f247797681556c6dcac6de94b9e6787098f48b6f4040aac58a83e3d74" :answer/id #uuid "5a82c8eb-7cb4-5e10-896c-527d136aa2eb" :answer/type :answer.type/math :answer/value "(\\lambda -3)(\\lambda -2)(\\lambda -1)(\\lambda +3)=0" :db/ensure [:answer/validate]} {:db/id "q-86749/selection/731ef30cccdb19b77977776272b53e7136c6f84e986cea6db33a3e23d9451d74" :answer/id #uuid "767f2c83-ff07-595e-ac4a-c24f9382a823" :answer/type :answer.type/math :answer/value "(\\lambda +{3}^{2})(\\lambda +2)(\\lambda -1)=0" :db/ensure [:answer/validate]} {:db/id "q-86749/selection/0f5ecb552afee21670ca94a56c793321c883efe66e1f02e125b8109ffe764bdc" :answer/id #uuid "99ef1261-29d5-5c12-9eaa-dc191cc40c44" :answer/type :answer.type/math :answer/value "(\\lambda -3)^{2}(\\lambda -2)(\\lambda -1)=0" :db/ensure [:answer/validate]} {:db/id "q-86749/selection" :answer-field/id #uuid "dfee94dc-1ded-5fec-a74a-56f360247b0c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-86749/selection/bbebd40d629b33b5ca832ac42a0e4afb929d406315c56e232f82c7f11b05098d" :answer-field/choices ["q-86749/selection/bbebd40d629b33b5ca832ac42a0e4afb929d406315c56e232f82c7f11b05098d" "q-86749/selection/b253dce42c40cb6fce4e6d69694b9f1d05e84108a79df66262fa80d801a73691" "q-86749/selection/942c362f247797681556c6dcac6de94b9e6787098f48b6f4040aac58a83e3d74" "q-86749/selection/731ef30cccdb19b77977776272b53e7136c6f84e986cea6db33a3e23d9451d74" "q-86749/selection/0f5ecb552afee21670ca94a56c793321c883efe66e1f02e125b8109ffe764bdc"] :db/ensure [:answer-field/validate]} {:db/id "q-86749" :question/id #uuid "5abaedb5-7997-51fd-b21a-260cfe3dbc5e" :question/math-academy-id "q-86749" :question/problem "Find the characteristic equation of the matrix \n$P=[\\begin{aligned}3 & 5 & 2 & 0 \\\\ 0 & -2 & 0 & -1 \\\\ 0 & 0 & 1 & 7 \\\\ 0 & 0 & 0 & -3\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,P-\\lambda I:$\n﻿﻿﻿\n\n$$\nP-\\lambda I=[\\begin{aligned}3-\\lambda  & 5 & 2 & 0 \\\\ 0 & -2-\\lambda  & 0 & -1 \\\\ 0 & 0 & 1-\\lambda  & 7 \\\\ 0 & 0 & 0 & -3-\\lambda \\end{aligned}]\n$$\n\nThe characteristic equation is $det(P-\\lambda I)=0.$ \n\nSince the determinant of a triangular (or diagonal) matrix is given by the product of the entries on the main diagonal, we obtain the following: \n\n$$\n\\begin{aligned}det(P-\\lambda I) & =0 \\\\ |\\begin{aligned}3-\\lambda  & 5 & 2 & 0 \\\\ 0 & -2-\\lambda  & 0 & -1 \\\\ 0 & 0 & 1-\\lambda  & 7 \\\\ 0 & 0 & 0 & -3-\\lambda \\end{aligned}| & =0 \\\\ (3-\\lambda )(-2-\\lambda )(1-\\lambda )(-3-\\lambda ) & =0 \\\\ (\\lambda -3)(\\lambda +2)(\\lambda -1)(\\lambda +3) & =0\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-86749/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ef311af0-0e95-5574-a151-2971ad66bd08"] :knowledge-point/questions ["q-86749"] :db/ensure [:knowledge-point/validate]} {:db/id "q-140515/selection/85689e71f638e1881e0b7cdffd59f59905007441b8a2261ae2ec07e55f2a7f58" :answer/id #uuid "d8a3e926-e46e-5b32-8178-fddfad35b0cb" :answer/type :answer.type/math :answer/value "{\\lambda }^{3}-2{\\lambda }^{2}-13\\lambda +25=0" :db/ensure [:answer/validate]} {:db/id "q-140515/selection/e1d9f8b1d7ddf137427053e737a3de39967a981b0bd8ff8ed26aa2afa8bfac6a" :answer/id #uuid "7f2b09b9-4f5c-5972-8f6f-3d39d5f12e11" :answer/type :answer.type/math :answer/value "{\\lambda }^{3}+2{\\lambda }^{2}+13\\lambda -15=0" :db/ensure [:answer/validate]} {:db/id "q-140515/selection/412df6054beb81754c392d889e79f21e6353596cc1a6500994492d24205ce1ea" :answer/id #uuid "b3f02453-061b-56f3-bfa0-a2ffbe3778ce" :answer/type :answer.type/math :answer/value "{\\lambda }^{3}+2{\\lambda }^{2}-13\\lambda +10=0" :db/ensure [:answer/validate]} {:db/id "q-140515/selection/6f74cc9a0d715fd32c5bdff49f1813ade9eac095416894fe6f9e9c2baba66e32" :answer/id #uuid "798ac345-1a15-5080-8724-fe75d9fb6a75" :answer/type :answer.type/math :answer/value "{\\lambda }^{3}+13{\\lambda }^{2}+2\\lambda +4=0" :db/ensure [:answer/validate]} {:db/id "q-140515/selection/86b1c4775ee66abcd156ffe355630a606720575325554f2774a73be54df758ac" :answer/id #uuid "567fb19b-9406-5b40-849b-28b42ca090d4" :answer/type :answer.type/math :answer/value "{\\lambda }^{3}-2{\\lambda }^{2}-13\\lambda -30=0" :db/ensure [:answer/validate]} {:db/id "q-140515/selection" :answer-field/id #uuid "04e97fc9-c02b-54b1-b844-e543dff3515e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-140515/selection/412df6054beb81754c392d889e79f21e6353596cc1a6500994492d24205ce1ea" :answer-field/choices ["q-140515/selection/85689e71f638e1881e0b7cdffd59f59905007441b8a2261ae2ec07e55f2a7f58" "q-140515/selection/e1d9f8b1d7ddf137427053e737a3de39967a981b0bd8ff8ed26aa2afa8bfac6a" "q-140515/selection/412df6054beb81754c392d889e79f21e6353596cc1a6500994492d24205ce1ea" "q-140515/selection/6f74cc9a0d715fd32c5bdff49f1813ade9eac095416894fe6f9e9c2baba66e32" "q-140515/selection/86b1c4775ee66abcd156ffe355630a606720575325554f2774a73be54df758ac"] :db/ensure [:answer-field/validate]} {:db/id "q-140515" :question/id #uuid "e1fed639-500d-5637-9314-77381d4239bd" :question/math-academy-id "q-140515" :question/problem "Find the characteristic equation of the matrix \n$C=[\\begin{aligned}3 & -1 & -1 \\\\ 1 & -3 & 3 \\\\ 1 & 2 & -2\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,C-\\lambda I:$\n﻿﻿﻿\n\n$$\nC-\\lambda I=[\\begin{aligned}3-\\lambda  & -1 & -1 \\\\ 1 & -3-\\lambda  & 3 \\\\ 1 & 2 & -2-\\lambda \\end{aligned}]\n$$\n\nThe characteristic equation is $det(C-\\lambda I)=0.$ \n\nExpanding the determinant across the $1$st row, we get the following:\n\n$$\n\\begin{aligned}det(C-\\lambda I) & =0 \\\\ |\\begin{aligned}3-\\lambda  & -1 & -1 \\\\ 1 & -3-\\lambda  & 3 \\\\ 1 & 2 & -2-\\lambda \\end{aligned}| & =0 \\\\ (3-\\lambda )|\\begin{aligned}-3-\\lambda  & 3 \\\\ 2 & -2-\\lambda \\end{aligned}|-(-1)|\\begin{aligned}1 & 3 \\\\ 1 & -2-\\lambda \\end{aligned}|+(-1)|\\begin{aligned}1 & -3-\\lambda  \\\\ 1 & 2\\end{aligned}| & =0 \\\\ (3-\\lambda )({\\lambda }^{2}+5\\lambda )+(-\\lambda -5)-(5+\\lambda ) & =0 \\\\ (-{\\lambda }^{3}-2{\\lambda }^{2}+15\\lambda )-\\lambda -5-5-\\lambda  & =0 \\\\ -{\\lambda }^{3}-2{\\lambda }^{2}+13\\lambda -10 & =0 \\\\ {\\lambda }^{3}+2{\\lambda }^{2}-13\\lambda +10 & =0\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-140515/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5abea3ab-76a7-5598-8ede-b4cf88dd47d7"] :knowledge-point/questions ["q-140515"] :db/ensure [:knowledge-point/validate]} {:db/id "q-80825/selection/ed58388be20aa7bfac211a1fa09210bc6f5a6778a089d042e0a470fdb373ad8d" :answer/id #uuid "4456285c-e35f-599b-ae8d-4471c7a3f302" :answer/type :answer.type/math :answer/value "\\lambda \\in {-1,2}" :db/ensure [:answer/validate]} {:db/id "q-80825/selection/0a44ea7392d1c976ae683a99088b193d1a3fa24879999646752d32bae4917760" :answer/id #uuid "178742c6-30df-54a6-9afa-983ce72e4d2d" :answer/type :answer.type/math :answer/value "\\lambda \\in {1,-6}" :db/ensure [:answer/validate]} {:db/id "q-80825/selection/4afd66b6a207a8fabb431b33d809c1913d1338d877c7186594eaf9c610c1596d" :answer/id #uuid "aeb73f3b-34ed-5b89-a489-a5e2fa5283fc" :answer/type :answer.type/math :answer/value "\\lambda \\in {2,-3}" :db/ensure [:answer/validate]} {:db/id "q-80825/selection/73ff2449378b2e1793f2cf309c230f993426ab33a12e722b39978a1c56a39685" :answer/id #uuid "1eca8a58-c362-5164-a53b-25c70af9c711" :answer/type :answer.type/math :answer/value "\\lambda \\in {-1,-2,3}" :db/ensure [:answer/validate]} {:db/id "q-80825/selection/2476ebf9ee3010db6342843e58ff4ae506b921ee1a00e970c6abfb1c7fb9325d" :answer/id #uuid "e8d1e6c9-7726-56fd-a746-66f82dff793e" :answer/type :answer.type/math :answer/value "\\lambda \\in {-1,2,-3}" :db/ensure [:answer/validate]} {:db/id "q-80825/selection" :answer-field/id #uuid "49f71074-aa93-5289-bc34-af112c416de2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-80825/selection/73ff2449378b2e1793f2cf309c230f993426ab33a12e722b39978a1c56a39685" :answer-field/choices ["q-80825/selection/ed58388be20aa7bfac211a1fa09210bc6f5a6778a089d042e0a470fdb373ad8d" "q-80825/selection/0a44ea7392d1c976ae683a99088b193d1a3fa24879999646752d32bae4917760" "q-80825/selection/4afd66b6a207a8fabb431b33d809c1913d1338d877c7186594eaf9c610c1596d" "q-80825/selection/73ff2449378b2e1793f2cf309c230f993426ab33a12e722b39978a1c56a39685" "q-80825/selection/2476ebf9ee3010db6342843e58ff4ae506b921ee1a00e970c6abfb1c7fb9325d"] :db/ensure [:answer-field/validate]} {:db/id "q-80825" :question/id #uuid "ba3b9cc6-841d-5636-9777-0bc1e8c24e7f" :question/math-academy-id "q-80825" :question/problem "Determine all real eigenvalues $\\lambda $ of the matrix \n$A=[\\begin{aligned}-1 & 1 & 0 \\\\ 1 & 2 & 1 \\\\ 0 & 3 & -1\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=[\\begin{aligned}-1-\\lambda  & 1 & 0 \\\\ 1 & 2-\\lambda  & 1 \\\\ 0 & 3 & -1-\\lambda \\end{aligned}]\n$$\n\nThe characteristic equation is given by $det(A-\\lambda I)=0.$ \n\nExpanding the determinant across the $1$st row, we get the following:\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ |\\begin{aligned}-1-\\lambda  & 1 & 0 \\\\ 1 & 2-\\lambda  & 1 \\\\ 0 & 3 & -1-\\lambda \\end{aligned}| & =0 \\\\ (-1-\\lambda )|\\begin{aligned}2-\\lambda  & 1 \\\\ 3 & -1-\\lambda \\end{aligned}|-1|\\begin{aligned}1 & 1 \\\\ 0 & -1-\\lambda \\end{aligned}| & =0 \\\\ (-{\\lambda }^{3}+6\\lambda +5)-(-1-\\lambda ) & =0 \\\\ -{\\lambda }^{3}+7\\lambda +6 & =0 \\\\ {\\lambda }^{3}-7\\lambda -6 & =0\\end{aligned}\n$$\n\nNow, we need to solve this equation. We find the first root by testing some values. According to the rational zeros theorem, a list of good first guesses consists of all divisors of $6:$ \n\n$$\n\\pm 1,\\pm 2,\\pm 3,\\pm 6\n$$\n\n- Let's pick $x=1.$ Substituting to the characteristic equation gives\n\n$$\n\\begin{aligned}(1)^{3}-7(1)-6 & =-12.\\end{aligned}\n$$\n\nHence, $\\lambda =1$ is not a root of the equation.\n\n- Let's pick $x=-1.$ Substituting to the characteristic equation gives\n\n$$\n\\begin{aligned}(-1)^{3}-7(-1)-6 & =0.\\end{aligned}\n$$\n\nHence, $\\lambda =-1$ is a root of the equation.\n\nSo, we can factor $(\\lambda +1)$ out of ${\\lambda }^{3}-7\\lambda -6$ using synthetic division:\n\n| $-1$ | $1$ | $0$ | $-7$ | $-6$ |\n| --- | --- | --- | --- | --- |\n|  | $↓$ | $-1$ | $1$ | $6$ |\n|  | $1$ | $-1$ | $-6$ | $0$ |\n\nSo, we obtain the following factorization:\n\n$$\n\\begin{aligned}(\\lambda +1)({\\lambda }^{2}-\\lambda -6) & =0 \\\\ (\\lambda +1)(\\lambda +2)(\\lambda -3) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues are ${\\lambda }_{1}=-1,$ $\\,{\\lambda }_{2}=-2,\\,$ and $\\,{\\lambda }_{3}=3.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-80825/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5abea3ab-76a7-5598-8ede-b4cf88dd47d7"] :knowledge-point/questions ["q-80825"] :db/ensure [:knowledge-point/validate]} {:db/id "q-37396/selection/27a199d72d003428008c738d344c45ee67c9ef26c62657e90192b21a05412a21" :answer/id #uuid "3090eabf-d749-545f-8cd3-cf9c65d3d9c9" :answer/type :answer.type/math :answer/value "{\\lambda }^{3}+4{\\lambda }^{2}-37\\lambda -72=0" :db/ensure [:answer/validate]} {:db/id "q-37396/selection/c6717fb38547f24919fbc49331579b3a9227dc45f155d18d7169d95d574ef60d" :answer/id #uuid "8311f9f3-dc55-5bd2-a226-1642ee8ee281" :answer/type :answer.type/math :answer/value "{\\lambda }^{3}+4{\