& 1\\end{aligned}]\\cdot {[\\begin{aligned}14 & 8 \\\\ 8 & 6\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}4 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 2 \\\\ -3 & -1 \\\\ 1 & 1\\end{aligned}]\\cdot \\frac{1}{10}[\\begin{aligned}3 & -4 \\\\ -4 & 7\\end{aligned}]\\cdot [\\begin{aligned}4 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 2 \\\\ -3 & -1 \\\\ 1 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}-2 \\\\ -3 \\\\ -1\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-158359/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c07721dd-4b97-5d57-8de1-5098117e3071"] :knowledge-point/questions ["q-158359"] :db/ensure [:knowledge-point/validate]} {:db/id "q-158362/selection/ec2be52694122eca93ab82f2e612ce049271eebcdc7876b9925a45242982c70b" :answer/id #uuid "38965953-77f8-54c4-af90-26afc2efc9c6" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 \\\\ -3 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-158362/selection/0518bd170ae4aae460d736ff822537cd09066fbde8a5136ff0b9c1d8d95f1f28" :answer/id #uuid "2ceced9c-105a-5ab3-aff0-250feacaa3a8" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-158362/selection/34325bd3b7263abb29706604ca52dc13883cb7570290ba57fae43195c879664a" :answer/id #uuid "146434a3-246e-5543-8016-746775576406" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ -3 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-158362/selection/2ac3c07f46ddae25b284d9881e9bd8b68a558040ab4d435e0646ad7c10766fc1" :answer/id #uuid "8539903a-77bf-5d56-945a-94b1edfc432a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ -3 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-158362/selection/a30f8fcf7c0fdb6a54becc7a8b4c7d304b58a12cdf7e8f52a022bc9f12cde7ea"