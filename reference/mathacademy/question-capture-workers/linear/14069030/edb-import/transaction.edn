n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}2 & 1 \\\\ -1 & 1 \\\\ 2 & 1\\end{aligned}]\\cdot {([\\begin{aligned}2 & -1 & 2 \\\\ 1 & 1 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 & 1 \\\\ -1 & 1 \\\\ 2 & 1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}2 & -1 & 2 \\\\ 1 & 1 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ -3 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 1 \\\\ -1 & 1 \\\\ 2 & 1\\end{aligned}]\\cdot {[\\begin{aligned}9 & 3 \\\\ 3 & 3\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}3 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 1 \\\\ -1 & 1 \\\\ 2 & 1\\end{aligned}]\\cdot \\frac{1}{6}[\\begin{aligned}1 & -1 \\\\ -1 & 3\\end{aligned}]\\cdot [\\begin{aligned}3 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 1 \\\\ -1 & 1 \\\\ 2 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ -3 \\\\ 0\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-158362/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c07721dd-4b97-5d57-8de1-5098117e3071"] :knowledge-point/questions ["q-158362"] :db/ensure [:knowledge-point/validate]} {:db/id "q-40573/selection/cdc27eb0d5120efa923e1ede8baaf7973b368871366f876801a01fcc59b75b15" :answer/id #uuid "ae2f2d1b-04c1-5f4e-822d-cb4d0b2ca568" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ 1 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-40573/selection/5a9754212d32fa7a6637eb1aa12aa0d0fec6e604e099f964e41f095b10bf7bab" :answer/id #uuid "3829567d-7f52-5dfb-a6e1-aa1221912788" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 \\\\ -4 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-40573/selection/9cad3c6ca192ea199c686171b050996f97b21f1c9ec5581abdd222d94da6e841" :answer/id #uuid "918b0a4d-0f1f-5e11-93cb-46a9fc73cd67" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ 6 \\\\ 3\\end{aligne