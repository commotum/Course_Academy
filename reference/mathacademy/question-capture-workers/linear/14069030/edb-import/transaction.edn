{2}\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-40571/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ad9f55b2-ce37-507f-8cb6-7d4e30e6868a"] :knowledge-point/questions ["q-40571"] :db/ensure [:knowledge-point/validate]} {:db/id "q-158123/selection/4379e1f3c21fd58a27fa01d68c039e70e39b38ff7cc5265c887338ecc8ebe1df" :answer/id #uuid "8a498902-85c6-5f89-883e-a85e9e36af5d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-158123/selection/530ed5335e470d6b09e8ed23a9403b58f6f0b95aa92b1e6337b4aab7e18a3cf6" :answer/id #uuid "37291497-80d8-55fd-a719-2f8271551118" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ -2 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-158123/selection/f633c367fdb8be12fa7ec1b63456c99f32fe6ac8d4f9ec8af507fb2d2b76e8ec" :answer/id #uuid "50f4c4fa-4cba-5b8a-b3c3-c3801cdf2dd1" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3 \\\\ 1 \\\\ -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-158123/selection/b78a63c464beb89bdc57645bffaaf57dbb3ca23cc5fb74937d584a2b615bd0d9" :answer/id #uuid "a4152323-3f5a-5239-b473-9012441c929e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ 2 \\\\ -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-158123/selection/ccc76f151078fefb3e1322aec6fa20f50f5c5aaad0ace92880d35b4471629df9" :answer/id #uuid "6f094c64-d945-5962-9bb0-fc67c85dac21" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ -2 \\\\ -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-158123/selection" :answer-field/id #uuid "d1643379-feea-50ae-b265-4e642bed09f7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-158123/selection/ccc76f151078fefb3e1322aec6fa20f50f5c5aaad0ace92880d35b4471629df9" :answer-field/choices ["q-158123/selection/4379e1f3c21fd58a27fa01d68c039e70e39b38ff7cc5265c887338ecc8ebe1df" "q-158123/selection/530ed5335e470d6b09e8ed23a9403b58f6f0b95aa92b1e6337b4aab7e18a3cf6" "q-158123/selection/f633c367fdb8be12fa7ec1b63456c99f32fe6ac8d4f9ec8af507fb2d2b76e8ec" "q-158123/selection/b78a63c464beb89bdc57645bffaaf57dbb3ca23cc5fb74937d584a2b615bd0d9" "q-158123/selection/ccc76f151078fefb3e1322aec6fa20f50f5c5aaad0ace92880d35b4471629df9"] :db/ensure [:answer-field/validate]} {:db/id "q-158123" :question/id #uuid "dd7403df-a496-59c6-8226-c07a3e6dd8d2" :question/math-academy-id "q-158123" :question/problem "Find the vector in the subspace spanned by ${{a}_{1},{a}_{2}}$ \nthat is closest to the vector $x,$ where \n\n$$\n{a}_{1}=[\\begin{aligned}3 \\\\ 0 \\\\ -1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}1 \\\\ 1 \\\\ 1\\end{aligned}],\\,x=[\\begin{aligned}2 \\\\ -6 \\\\ 0\\end{aligned}].\n$$" :question/worked-solution "First, notice that ${a}_{1}$ and ${a}_{2}$ are linearly independent. \n\nThe closest vector to $x$ in the subspace spanned by ${{a}_{1},{a}_{2}}$ is orthogonal projection of $x$ onto the subspace, which is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have\n\n$$\nA=[\\begin{aligned}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{aligned}]=[\\begin{aligned}3 & 1 \\\\ 0 & 1 \\\\ -1 & 1\\end{aligned}]\\,⟹\\,{A}^{T}=[\\begin{aligned}3 & 0 & -1 \\\\ 1 & 1 & 1\\end{aligned}].\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}3 & 1 \\\\ 0 & 1 \\\\ -1 & 1\\end{aligned}]\\cdot {([\\begin{aligned}3 & 0 & -1 \\\\ 1 & 1 & 1\\end{aligned}]\\cdot [\\begin{aligned}3 & 1 \\\\ 0 & 1 \\\\ -1 & 1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}3 & 0 & -1 \\\\ 1 & 1 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ -6 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 1 \\\\ 0 & 1 \\\\ -1 & 1\\end{aligned}]\\cdot {[\\begin{aligned}10 & 2 \\\\ 2 & 3\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}6 \\\\ -4\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 1 \\\\ 0 & 1 \\\\ -1 & 1\\end{aligned}]\\cdot \\frac{1}{26}[\\begin{aligned}3 & -2 \\\\ -2 & 10\\end{aligned}]\\cdot [\\begin{aligned}6 \\\\ -4\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 1 \\\\ 0 & 1 \\\\ -1 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ -2 \\\\ -3\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-158123/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ad9f55b2-ce37-507f-8cb6-7d4e30e6868a"] :knowledge-point/questions ["q-158123"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-40570"] :question/problem "Find the vector in the subspace spanned by ${{a}_{1},{a}_{2}}$ \nthat is closest to the vector $x,$ where \n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}2 \\\\ 2 \\\\ -2\\end{aligned}],\\,x=[\\begin{aligned}8 \\\\ -4 \\\\ 8\\end{aligned}].\n$$" :question/worked-solution "First, notice that ${a}_{1}$ and ${a}_{2}$ are linearly independent. \n\nThe closest vector to $x$ in the subspace spanned by ${{a}_{1},{a}_{2}}$ is orthogonal projection of $x$ onto the subspace, which is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have\n\n$$\nA=[\\begin{aligned}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{aligned}]=[\\begin{aligned}1 & 2 \\\\ 1 & 2 \\\\ 0 & -2\\end{aligned}]\\,⟹\\,{A}^{T}=[\\begin{aligned}1 & 1 & 0 \\\\ 2 & 2 & -2\\end{aligned}].\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}1 & 2 \\\\ 1 & 2 \\\\ 0 & -2\\end{aligned}]\\cdot {([\\begin{aligned}1 & 1 & 0 \\\\ 2 & 2 & -2\\end{aligned}]\\cdot [\\begin{aligned}1 & 2 \\\\ 1 & 2 \\\\ 0 & -2\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}1 & 1 & 0 \\\\ 2 & 2 & -2\\end{aligned}]\\cdot [\\begin{aligned}8 \\\\ -4 \\\\ 8\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 \\\\ 1 & 2 \\\\ 0 & -2\\end{aligned}]\\cdot {[\\begin{aligned}2 & 4 \\\\ 4 & 12\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}4 \\\\ -8\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 \\\\ 1 & 2 \\\\ 0 & -2\\end{aligned}]\\cdot \\frac{1}{4}[\\begin{aligned}6 & -2 \\\\ -2 & 1\\end{aligned}]\\cdot [\\begin{aligned}4 \\\\ -8\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 \\\\ 1 & 2 \\\\ 0 & -2\\end{aligned}]\\cdot [\\begin{aligned}10 \\\\ -4\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ 2 \\\\ 8\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-40630/selection/0f72f521d66cd60cef8497958f734e1d9aaa92761e6928bf86733fd1b254e4be" :answer/id #uuid "979cda63-7a7c-583f-a946-666d941be1e0" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 \\\\ -7 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-40630/selection/9f2e4aa0c42b9fbe364b751b26a6f022fb1838b2351b9e93aea07215c9a81a21" :answer/id #uuid "a1d8e69d-a74d-5529-8da2-78aecf8f2490" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ -2 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-40630/selection/89916073ebc0928b0c11712a684e02933461aea6505bb8d0ada24019694de4d1" :answer/id #uuid "0987ed84-5fcb-5d02-88ce-86e10359ae70" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ -5 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-40630/selection/759c9678500e91b2ecffe41b5313b269dfb591dd88993ed0efa989e3fa53efdf" :answer/id #uuid "889971ae-0603-517d-b871-01bf52522d9f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ -4 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-40630/selection/472cab20b18245f70f27f4866c92200d0800747672169a765fb3d8fcc5cee878" :answer/id #uuid "e0e58591-bdd1-5a83-bd56-d0bd00cb458b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 \\\\ -1 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-40630/selection" :answer-field/id #uuid "7a0a5268-bdd5-5871-9b8b-a0b20b27449d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-40630/selection/9f2e4aa0c42b9fbe364b751b26a6f022fb1838b2351b9e93aea07215c9a81a21" :answer-field/choices ["q-40630/selection/0f72f521d66cd60cef8497958f734e1d9aaa92761e6928bf86733fd1b254e4be" "q-40630/selection/9f2e4aa0c42b9fbe364b751b26a6f022fb1838b2351b9e93aea07215c9a81a21" "q-40630/selection/89916073ebc0928b0c11712a684e02933461aea6505bb8d0ada24019694de4d1" "q-40630/selection/759c9678500e91b2ecffe41b5313b269dfb591dd88993ed0efa989e3fa53efdf" "q-40630/selection/472cab20b18245f70f27f4866c92200d0800747672169a765fb3d8fcc5cee878"] :db/ensure [:answer-field/validate]} {:db/id "q-40630" :question/id #uuid "5c071401-3e46-54b6-b9cb-b8280a1a58b2" :question/math-academy-id "q-40630" :question/problem "Verify whether the vectors ${a}_{1},{a}_{2},{a}_{3}$ are linearly independent, and find the orthogonal projection of $x$ onto the subspace spanned by the vectors ${{a}_{1},{a}_{2},{a}_{3}},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}2 \\\\ -3 \\\\ 1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}1 \\\\ -2 \\\\ 1\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}0 \\\\ 1 \\\\ -1\\end{aligned}],\\,x=[\\begin{aligned}3 \\\\ -1 \\\\ 1\\end{aligned}].\n$$" :question/worked-solution "First, we verify whether ${a}_{1},{a}_{2},{a}_{3}$ are linearly independent. So, we start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned} & [\\begin{aligned}2 & 1 & 0 \\\\ -3 & -2 & 1 \\\\ 1 & 1 & -1\\end{aligned}] &  & \\begin{aligned}{R}_{1}↔{R}_{3}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 1 & -1 \\\\ -3 & -2 & 1 \\\\ 2 & 1 & 0\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+3{R}_{1} \\\\ {R}_{3}:={R}_{3}-2{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 1 & -1 \\\\ 0 & 1 & -2 \\\\ 0 & -1 & 2\\end{aligned}] &  & \\begin{aligned}{R}_{3}:={R}_{3}+{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 1 & -1 \\\\ 0 & 1 & -2 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, the pivot columns correspond to the linearly independent vectors ${a}_{1}$ and ${a}_{2}$ that form the basis of our span.\n\nNow, the orthogonal projection of $x$ onto the subspace spanned by the linearly independent columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have\n\n$$\nA=[\\begin{aligned}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{aligned}]=[\\begin{aligned}2 & 1 \\\\ -3 & -2 \\\\ 1 & 1\\end{aligned}]\\,⇒\\,{A}^{T}=[\\begin{aligned}2 & -3 & 1 \\\\ 1 & -2 & 1\\end{aligned}].\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}2 & 1 \\\\ -3 & -2 \\\\ 1 & 1\\end{aligned}]\\cdot {([\\begin{aligned}2 & -3 & 1 \\\\ 1 & -2 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 & 1 \\\\ -3 & -2 \\\\ 1 & 1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}2 & -3 & 1 \\\\ 1 & -2 & 1\\end{aligned}]\\cdot [\\begin{aligned}3 \\\\ -1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 1 \\\\ -3 & -2 \\\\ 1 & 1\\end{aligned}]\\cdot {[\\begin{aligned}14 & 9 \\\\ 9 & 6\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}10 \\\\ 6\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 1 \\\\ -3 & -2 \\\\ 1 & 1\\end{aligned}]\\cdot \\frac{1}{3}[\\begin{aligned}6 & -9 \\\\ -9 & 14\\end{aligned}]\\cdot [\\begin{aligned}10 \\\\ 6\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 1 \\\\ -3 & -2 \\\\ 1 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ -2 \\\\ 0\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-40630/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ad9f55b2-ce37-507f-8cb6-7d4e30e6868a"] :knowledge-point/questions ["q-40630"] :db/ensure [:knowledge-point/validate]} {:db/id "q-39871/selection/7894546b3903677da13bdeaf9d7d2b29dd1b9c4bd056c1fb4a4b4fec38ca0754" :answer/id #uuid "fd91d4e9-0316-51f9-8e1a-3ec508fa5fd2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 \\\\ 2 \\\\ 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-39871/selection/13a9f816e061129c6e619930b56752058785c370c0c8d98bbd0d12e57a7801bc" :answer/id #uuid "91018703-02af-5427-b8ea-7b7e51a9811d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}7 \\\\ 4 \\\\ 7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-39871/selection/c36a2109bfe2800a9ab76f409a2e1e76003ed53023983bf9c5b3818ee5e85892" :answer/id #uuid "492f12a1-116e-5f76-8362-c28d70f34293" :answer/type :answer.type/math :answer/value "[\\begin{aligned}6 \\\\ 8 \\\\ 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-39871/selection/6da3062c38fc73b9036b39c8218b25a8ecdd3f0363711616309becdd49598f90" :answer/id #uuid "4b2a00e8-e673-57cd-9470-a797da27d539" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{3}{4} \\\\ \\frac{1}{2} \\\\ \\frac{3}{4}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-39871/selection/370ab967f39e9c5621253a613217c0f0f85ecff8ecff632a78bffae3c08ad7a7" :answer/id #uuid "78cfae3e-03de-5cc6-8cc2-405f07fd3838" :answer/type :answer.type/math :answer/value "[\\begin{aligned}25 \\\\ 11 \\\\ 25\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-39871/selection" :answer-field/id #uuid "8a3a8569-a777-56bc-9a83-9acf5010552e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-39871/selection/13a9f816e061129c6e619930b56752058785c370c0c8d98bbd0d12e57a7801bc" :answer-field/choices ["q-39871/selection/7894546b3903677da13bdeaf9d7d2b29dd1b9c4bd056c1fb4a4b4fec38ca0754" "q-39871/selection/13a9f816e061129c6e619930b56752058785c370c0c8d98bbd0d12e57a7801bc" "q-39871/selection/c36a2109bfe2800a9ab76f409a2e1e76003ed53023983bf9c5b3818ee5e85892" "q-39871/selection/6da3062c38fc73b9036b39c8218b25a8ecdd3f0363711616309becdd49598f90" "q-39871/selection/370ab967f39e9c5621253a613217c0f0f85ecff8ecff632a78bffae3c08ad7a7"] :db/ensure [:answer-field/validate]} {:db/id "q-39871" :question/id #uuid "6102ade5-8e07-551c-bd72-f8a53d7fcf98" :question/math-academy-id "q-39871" :question/problem "Find the vector in the subspace spanned by ${{a}_{1},{a}_{2}}$ \nthat is closest to the vector $x,$ where   \n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 1 \\\\ 1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-2 \\\\ 2 \\\\ -2\\end{aligned}],\\,x=[\\begin{aligned}8 \\\\ 4 \\\\ 6\\end{aligned}].\n$$" :question/worked-solution "First, notice that ${a}_{1}$ and ${a}_{2}$ are linearly independent. \n\nThe closest vector to $x$ in the subspace spanned by ${{a}_{1},{a}_{2}}$ is orthogonal projection of $x$ onto the subspace, which is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have\n\n$$\nA=[\\begin{aligned}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{aligned}]=[\\begin{aligned}1 & -2 \\\\ 1 & 2 \\\\ 1 & -2\\end{aligned}]\\,⟹\\,{A}^{T}=[\\begin{aligned}1 & 1 & 1 \\\\ -2 & 2 & -2\\end{aligned}].\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}1 & -2 \\\\ 1 & 2 \\\\ 1 & -2\\end{aligned}]\\cdot {([\\begin{aligned}1 & 1 & 1 \\\\ -2 & 2 & -2\\end{aligned}]\\cdot [\\begin{aligned}1 & -2 \\\\ 1 & 2 \\\\ 1 & -2\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}1 & 1 & 1 \\\\ -2 & 2 & -2\\end{aligned}]\\cdot [\\begin{aligned}8 \\\\ 4 \\\\ 6\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -2 \\\\ 1 & 2 \\\\ 1 & -2\\end{aligned}]\\cdot {[\\begin{aligned}3 & -2 \\\\ -2 & 12\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}18 \\\\ -20\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -2 \\\\ 1 & 2 \\\\ 1 & -2\\end{aligned}]\\cdot \\frac{1}{32}[\\begin{aligned}12 & 2 \\\\ 2 & 3\\end{aligned}]\\cdot [\\begin{aligned}18 \\\\ -20\\end{aligned}] \\\\  & =\\frac{1}{4}[\\begin{aligned}1 & -2 \\\\ 1 & 2 \\\\ 1 & -2\\end{aligned}]\\cdot [\\begin{aligned}22 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}7 \\\\ 4 \\\\ 7\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-39871/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ad9f55b2-ce37-507f-8cb6-7d4e30e6868a"] :knowledge-point/questions ["q-39871"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-5576"] :question/problem "Find the orthogonal projection of the vector $\\mathbf{x}$ onto the plane $\\mathbf{r}=s\\mathbf{v}+t\\mathbf{w},$ where $s,t\\in\\mathbb R,$ and\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/assets/df90590ac6801e6f2efaada175e5d8460a45cb06375064eb53f80eddbbd3991c.png)" :question/worked-solution "First, notice that $\\mathbf v$ and $\\mathbf w$ are linearly independent. \n\nThe orthogonal projection of $\\mathbf{x}$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n\\textrm{proj}_{S} \\: \\mathbf{x} = A\\left(A^T\\!A\\right)^{-1}\\!A^T\\,\\mathbf{x}.\n$$\n\nSince our plane passes through the origin, it defines the subspace $S=\\text{Span}\\{\\mathbf{v}, \\mathbf{w}\\}$ in $\\mathbb{R}^3.$ In our case, we have\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/assets/a1592d17b242a66e66948692dfaf7892f9df6d415ae96fb59154455ffe1a4ef9.png)\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}-2 & -2 \\\\ -2 & -2 \\\\ 2 & -2\\end{aligned}]\\cdot {([\\begin{aligned}-2 & -2 & 2 \\\\ -2 & -2 & -2\\end{aligned}]\\cdot [\\begin{aligned}-2 & -2 \\\\ -2 & -2 \\\\ 2 & -2\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}-2 & -2 & 2 \\\\ -2 & -2 & -2\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 0 \\\\ 8\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -2 \\\\ -2 & -2 \\\\ 2 & -2\\end{aligned}]\\cdot {[\\begin{aligned}12 & 4 \\\\ 4 & 12\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}12 \\\\ -20\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -2 \\\\ -2 & -2 \\\\ 2 & -2\\end{aligned}]\\cdot \\frac{1}{32}[\\begin{aligned}3 & -1 \\\\ -1 & 3\\end{aligned}]\\cdot [\\begin{aligned}12 \\\\ -20\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -2 \\\\ -2 & -2 \\\\ 2 & -2\\end{aligned}]\\cdot \\frac{1}{4}[\\begin{aligned}7 \\\\ -9\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 1 \\\\ 8\\end{aligned}]\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5575"] :question/problem "Verify whether the vectors $\\mathbf{a}_1, \\mathbf{a}_2, \\mathbf{a}_3$ are linearly independent, and find the orthogonal projection of $\\mathbf{x}$ onto the subspace spanned by the vectors $\\{ \\mathbf{a}_1, \\mathbf{a}_2, \\mathbf{a}_3 \\},$ where\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/assets/226d83de1fff110426877af083e1aee5eac7f7de1244bb59f7f801aeea8ec6a5.png)" :question/worked-solution "First, we verify whether $\\mathbf{a}_1, \\mathbf{a}_2, \\mathbf{a}_3$ are linearly independent. So, we start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned} & [\\begin{aligned}4 & 1 & 1 \\\\ 3 & 1 & 2 \\\\ 1 & 1 & 4\\end{aligned}] &  & \\begin{aligned}{R}_{3}↔{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 1 & 4 \\\\ 3 & 1 & 2 \\\\ 4 & 1 & 1\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-3){R}_{1} \\\\ {R}_{3}:={R}_{3}+(-4){R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 1 & 4 \\\\ 0 & -2 & -10 \\\\ 0 & -3 & -15\\end{aligned}] &  & \\begin{aligned}{R}_{3}:={R}_{3}+(-\\frac{3}{2}){R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 1 & 4 \\\\ 0 & -2 & -10 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, the pivot columns correspond to the linearly independent vectors $\\mathbf{a}_1$ and $\\mathbf{a}_2$ that form the basis of our span.\n\nNow, the orthogonal projection of $\\mathbf{x}$ onto the subspace spanned by the linearly independent columns of a matrix $A$ is given by\n\n$$\n\\textrm{proj}_{S} \\: \\mathbf{x} = A(A^T\\!A)^{-1}\\!A^T\\,\\mathbf{x}.\n$$\n\nIn our case, we have\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/assets/c051729499bde9389ad7e38ab91d3609c8153cbed59233f4b3e3e7ac9e9c2534.png)\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}4 & 1 \\\\ 3 & 1 \\\\ 1 & 1\\end{aligned}]\\cdot {([\\begin{aligned}4 & 3 & 1 \\\\ 1 & 1 & 1\\end{aligned}]\\cdot [\\begin{aligned}4 & 1 \\\\ 3 & 1 \\\\ 1 & 1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}4 & 3 & 1 \\\\ 1 & 1 & 1\\end{aligned}]\\cdot [\\begin{aligned}5 \\\\ -1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}4 & 1 \\\\ 3 & 1 \\\\ 1 & 1\\end{aligned}]\\cdot {[\\begin{aligned}26 & 8 \\\\ 8 & 3\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}18 \\\\ 5\\end{aligned}] \\\\  & =[\\begin{aligned}4 & 1 \\\\ 3 & 1 \\\\ 1 & 1\\end{aligned}]\\cdot \\frac{1}{14}[\\begin{aligned}3 & -8 \\\\ -8 & 26\\end{aligned}]\\cdot [\\begin{aligned}18 \\\\ 5\\end{aligned}] \\\\  & =[\\begin{aligned}4 & 1 \\\\ 3 & 1 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}1 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}3 \\\\ 2 \\\\ 0\\end{aligned}]\\end{aligned}\n$$" :db/ensure [:question/validate]}]
