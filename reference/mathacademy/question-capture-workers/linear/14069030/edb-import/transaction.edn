debedb026079" "q-83581/selection/1bc0f7b20d7b8fc62de5b4618304885d4295b346efad79d01c82aa9c01b86d06"] :db/ensure [:answer-field/validate]} {:db/id "q-83581" :question/id #uuid "f07d051f-511e-591e-9291-2d697e2bdb0b" :question/math-academy-id "q-83581" :question/problem "Find the orthogonal projection of the vector $x$ onto the plane $r=sv+tw,$ where $s,t\\in R,$ and\n\n$$\nv=[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}],\\,w=[\\begin{aligned}3 \\\\ 2 \\\\ 1\\end{aligned}],\\,x=[\\begin{aligned}3 \\\\ -6 \\\\ 3\\end{aligned}].\n$$" :question/worked-solution "First, notice that $v$ and $w$ are linearly independent. \n\nThe orthogonal projection of $x$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nSince our plane passes through the origin, it defines the subspace $S=\\text{Span}{v,w}$ in ${R}^{3}.$ In our case, we have\n\n$$\nA=[\\begin{aligned}| & | \\\\ v & w \\\\ | & |\\end{aligned}]=[\\begin{aligned}1 & 3 \\\\ 0 & 2 \\\\ 1 & 1\\end{aligned}]\\,⟹\\,{A}^{T}=[\\begin{aligned}1 & 0 & 1 \\\\ 3 & 2 & 1\\end{aligned}].\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}1 & 3 \\\\ 0 & 2 \\\\ 1 & 1\\end{aligned}]\\cdot {([\\begin{aligned}1 & 0 & 1 \\\\ 3 & 2 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 3 \\\\ 0 & 2 \\\\ 1 & 1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}1 & 0 & 1 \\\\ 3 & 2 & 1\\end{aligned}]\\cdot [\\begin{aligned}3 \\\\ -6 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 3 \\\\ 0 & 2 \\\\ 1 & 1\\end{aligned}]\\cdot {[\\begin{aligned}2 & 4 \\\\ 4 & 14\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}6 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 3 \\\\ 0 & 2 \\\\ 1 & 1\\end{aligned}]\\cdot \\frac{1}{6}[\\begin{aligned}7 & -2 \\\\ -2 & 1\\end{aligned}]\\cdot [\\begin{aligned}6 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 3 \\\\ 0 & 2 \\\\ 1 & 1\\end{aligned}]\\cdot [\\begin{aligned}7 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ -4 \\\\ 5\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-83581/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c07721dd-4b97-5d57-8de1-5098117e3071"] :knowledge-point/questions ["q-83581"] :db/ensure [:knowledge-point/validate]} {:db/id "q-158359/selection/437a84bb5c29f81d335032e308bf81eb5234a3e2d9bcf3e5672c03ab043e88d6" :answer/id #uuid "b2bbbd68-7fc6-528a-9327-3e6c2753e4f4" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 \\\\ -3 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-158359/selection/c21a546facf21668d91a3ba505042e24f5d68a07e27d8dd113ff2c41e79ec917" :answer/id #uuid "7332c187-dbe0-52d0-a541-44f26ad77d19" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 2 \\\\ -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-158359/selection/445e39325220068790e9ef4d97182de12cb9caa61768c7206ba7197d6f36a35e" :answer/id #uuid "1831f40d-a022-50db-a924-ad36e8473bae" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3 \\\\ -2 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-158359/selection/a9df128b88581e01449456736dae6a832d3bc4f68452fe66c35753eb5c917e8f" :answer/id #uuid "6da6cf4f-435c-5ede-8a38-3e68a1d621fe" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ -3 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-158359/selection/03cdccb0daac644c022c6bfec718cc3944a6147fdea6409b452f24a5142bd26d" :answer/id #uuid "6992c1b7-d169-52f6-9bba-a7182a85e32e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ -1 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-158359/selection" :answer-field/id #uuid "6adf1085-d2a9-58f1-9d58-adcf99e522a5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-158359/selection/437a84bb5c29f81d335032e308bf