 \\\\ 2\\end{aligned}],\\,w=[\\begin{aligned}3 \\\\ 2 \\\\ 1\\end{aligned}],\\,x=[\\begin{aligned}2 \\\\ 9 \\\\ -1\\end{aligned}].\n$$" :question/worked-solution "First, notice that $v$ and $w$ are linearly independent. \n\nThe orthogonal projection of $x$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nSince our plane passes through the origin, it defines the subspace $S=\\text{Span}{v,w}$ in ${R}^{3}.$ In our case, we have\n\n$$\nA=[\\begin{aligned}| & | \\\\ v & w \\\\ | & |\\end{aligned}]=[\\begin{aligned}1 & 3 \\\\ 2 & 2 \\\\ 2 & 1\\end{aligned}]\\,⟹\\,{A}^{T}=[\\begin{aligned}1 & 2 & 2 \\\\ 3 & 2 & 1\\end{aligned}].\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}1 & 3 \\\\ 2 & 2 \\\\ 2 & 1\\end{aligned}]\\cdot {([\\begin{aligned}1 & 2 & 2 \\\\ 3 & 2 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 3 \\\\ 2 & 2 \\\\ 2 & 1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}1 & 2 & 2 \\\\ 3 & 2 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 9 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 3 \\\\ 2 & 2 \\\\ 2 & 1\\end{aligned}]\\cdot {[\\begin{aligned}9 & 9 \\\\ 9 & 14\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}18 \\\\ 23\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 3 \\\\ 2 & 2 \\\\ 2 & 1\\end{aligned}]\\cdot \\frac{1}{45}[\\begin{aligned}14 & -9 \\\\ -9 & 9\\end{aligned}]\\cdot [\\begin{aligned}18 \\\\ 23\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 3 \\\\ 2 & 2 \\\\ 2 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ 4 \\\\ 3\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-86760/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c07721dd-4b97-5d57-8de1-5098117e3071"] :knowledge-point/questions ["q-86760"] :db/ensure [:knowledge-point/validate]} {:db/id "q-40571/se