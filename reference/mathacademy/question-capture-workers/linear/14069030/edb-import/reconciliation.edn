aligned}]\\cdot {([\\begin{aligned}3 & 0 & -1 \\\\ 1 & 1 & 1\\end{aligned}]\\cdot [\\begin{aligned}3 & 1 \\\\ 0 & 1 \\\\ -1 & 1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}3 & 0 & -1 \\\\ 1 & 1 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ -6 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 1 \\\\ 0 & 1 \\\\ -1 & 1\\end{aligned}]\\cdot {[\\begin{aligned}10 & 2 \\\\ 2 & 3\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}6 \\\\ -4\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 1 \\\\ 0 & 1 \\\\ -1 & 1\\end{aligned}]\\cdot \\frac{1}{26}[\\begin{aligned}3 & -2 \\\\ -2 & 10\\end{aligned}]\\cdot [\\begin{aligned}6 \\\\ -4\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 1 \\\\ 0 & 1 \\\\ -1 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ -2 \\\\ -3\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-158123" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/activity-metadata.json" "file_sha256" "dc01981be994ba947da44dd911e6db4e8f8b70f65e927c0e9ccb37c908388958"} {"question" "q-158123" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-158123" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-3 \\\\ 1 \\\\ -3\\end{aligned}]"] ["math" "[\\begin{aligned}1 \\\\ -2 \\\\ -3\\end{aligned}]"] ["math" "[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}]"] ["math" "[\\begin{aligned}3 \\\\ -2 \\\\ -1\\end{aligned}]"] ["math" "[\\begin{aligned}3 \\\\ 2 \\\\ -3\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-158123" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}1 \\\\ -2 \\\\ -3\\end{aligned}]"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-40570" "field" nil "attribute" "question/problem" "value" "Find the vector in the subspace spanned by ${{a}_{1},{a}_{2}}$ \nthat is closest to the vector $x,$ where \n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}2 \\\\ 2 \\\\ -2\\end{aligned}],\\,x=[\\begin{aligned}8 \\\\ -4 \\\\ 8\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-40570" "field" nil "attribute" "question/worked-solution" "value" "First, notice that ${a}_{1}$ and ${a}_{2}$ are linearly independent. \n\nThe closest vector to $x$ in the subspace spanned by ${{a}_{1},{a}_{2}}$ is orthogonal projection of $x$ onto the subspace, which is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have\n\n$$\nA=[\\begin{aligned}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{aligned}]=[\\begin{aligned}1 & 2 \\\\ 1 & 2 \\\\ 0 & -2\\end{aligned}]\\,⟹\\,{A}^{T}=[\\begin{aligned}1 & 1 & 0 \\\\ 2 & 2 & -2\\end{aligned}].\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}1 & 2 \\\\ 1 & 2 \\\\ 0 & -2\\end{aligned}]\\cdot {([\\begin{aligned}1 & 1 & 0 \\\\ 2 & 2 & -2\\end{aligned}]\\cdot [\\begin{aligned}1 & 2 \\\\ 1 & 2 \\\\ 0 & -2\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}1 & 1 & 0 \\\\ 2 & 2 & -2\\end{aligned}]\\cdot [\\begin{aligned}8 \\\\ -4 \\\\ 8\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 \\\\ 1 & 2 \\\\ 0 & -2\\end{aligned}]\\cdot {[\\begin{aligned}2 & 4 \\\\ 4 & 12\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}4 \\\\ -8\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 \\\\ 1 & 2 \\\\ 0 & -2\\end{aligned}]\\cdot \\frac{1}{4}[\\begin{aligned}6 & -2 \\\\ -2 & 1\\end{aligned}]\\cdot [\\begin{aligned}4 \\\\ -8\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 \\\\ 1 & 2 \\\\ 0 & -2\\end{aligned}]\\cdot [\\begin{aligned}10 \\\\ -4\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ 2 \\\\ 8\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-40570" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/activity-metadata.json" "file_sha256" "dc01981be994ba947da44dd911e6db4e8f8b70f65e927c0e9ccb37c908388958"} {"question" "q-40570" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-40570" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}2 \\\\ 2 \\\\ 8\\end{aligned}]"] ["math" "[\\begin{aligned}3 \\\\ 3 \\\\ -2\\end{aligned}]"] ["math" "[\\begin{aligned}5 \\\\ 5 \\\\ -6\\end{aligned}]"] ["math" "[\\begin{aligned}6 \\\\ 6 \\\\ -4\\end{aligned}]"] ["math" "[\\begin{aligned}7 \\\\ 7 \\\\ -6\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-40570" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}2 \\\\ 2 \\\\ 8\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-40630" "field" nil "attribute" "question/problem" "value" "Verify whether the vectors ${a}_{1},{a}_{2},{a}_{3}$ are linearly independent, and find the orthogonal projection of $x$ onto the subspace spanned by the vectors ${{a}_{1},{a}_{2},{a}_{3}},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}2 \\\\ -3 \\\\ 1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}1 \\\\ -2 \\\\ 1\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}0 \\\\ 1 \\\\ -1\\end{aligned}],\\,x=[\\begin{aligned}3 \\\\ -1 \\\\ 1\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-40630" "field" nil "attribute" "question/worked-solution" "value" "First, we verify whether ${a}_{1},{a}_{2},{a}_{3}$ are linearly independent. So, we start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned} & [\\begin{aligned}2 & 1 & 0 \\\\ -3 & -2 & 1 \\\\ 1 & 1 & -1\\end{aligned}] &  & \\begin{aligned}{R}_{1}↔{R}_{3}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 1 & -1 \\\\ -3 & -2 & 1 \\\\ 2 & 1 & 0\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+3{R}_{1} \\\\ {R}_{3}:={R}_{3}-2{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 1 & -1 \\\\ 0 & 1 & -2 \\\\ 0 & -1 & 2\\end{aligned}] &  & \\begin{aligned}{R}_{3}:={R}_{3}+{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 1 & -1 \\\\ 0 & 1 & -2 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, the pivot columns correspond to the linearly independent vectors ${a}_{1}$ and ${a}_{2}$ that form the basis of our span.\n\nNow, the orthogonal projection of $x$ onto the subspace spanned by the linearly independent columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have\n\n$$\nA=[\\begin{aligned}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{aligned}]=[\\begin{aligned}2 & 1 \\\\ -3 & -2 \\\\ 1 & 1\\end{aligned}]\\,⇒\\,{A}^{T}=[\\begin{aligned}2 & -3 & 1 \\\\ 1 & -2 & 1\\end{aligned}].\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}2 & 1 \\\\ -3 & -2 \\\\ 1 & 1\\end{aligned}]\\cdot {([\\begin{aligned}2 & -3 & 1 \\\\ 1 & -2 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 & 1 \\\\ -3 & -2 \\\\ 1 & 1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}2 & -3 & 1 \\\\ 1 & -2 & 1\\end{aligned}]\\cdot [\\begin{aligned}3 \\\\ -1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 1 \\\\ -3 & -2 \\\\ 1 & 1\\end{aligned}]\\cdot {[\\begin{aligned}14 & 9 \\\\ 9 & 6\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}10 \\\\ 6\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 1 \\\\ -3 & -2 \\\\ 1 & 1\\end{aligned}]\\cdot \\frac{1}{3}[\\begin{aligned}6 & -9 \\\\ -9 & 14\\end{aligned}]\\cdot [\\begin{aligned}10 \\\\ 6\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 1 \\\\ -3 & -2 \\\\ 1 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ -2 \\\\ 0\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-40630" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/activity-metadata.json" "file_sha256" "dc01981be994ba947da44dd911e6db4e8f8b70f65e927c0e9ccb37c908388958"} {"question" "q-40630" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-40630" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}0 \\\\ -1 \\\\ 1\\end{aligned}]"] ["math" "[\\begin{aligned}2 \\\\ -2 \\\\ 0\\end{aligned}]"] ["math" "[\\begin{aligned}3 \\\\ -4 \\\\ 1\\end{aligned}]"] ["math" "[\\begin{aligned}3 \\\\ -5 \\\\ 2\\end{aligned}]"] ["math" "[\\begin{aligned}4 \\\\ -7 \\\\ 3\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-40630" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}2 \\\\ -2 \\\\ 0\\end{aligned}]"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-39871" "field" nil "attribute" "question/problem" "value" "Find the vector in the subspace spanned by ${{a}_{1},{a}_{2}}$ \nthat is closest to the vector $x,$ where   \n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 1 \\\\ 1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-2 \\\\ 2 \\\\ -2\\end{aligned}],\\,x=[\\begin{aligned}8 \\\\ 4 \\\\ 6\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-39871" "field" nil "attribute" "question/worked-solution" "value" "First, notice that ${a}_{1}$ and ${a}_{2}$ are linearly independent. \n\nThe closest vector to $x$ in the subspace spanned by ${{a}_{1},{a}_{2}}$ is orthogonal projection of $x$ onto the subspace, which is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have\n\n$$\nA=[\\begin{aligned}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{aligned}]=[\\begin{aligned}1 & -2 \\\\ 1 & 2 \\\\ 1 & -2\\end{aligned}]\\,⟹\\,{A}^{T}=[\\begin{aligned}1 & 1 & 1 \\\\ -2 & 2 & -2\\end{aligned}].\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}1 & -2 \\\\ 1 & 2 \\\\ 1 & -2\\end{aligned}]\\cdot {([\\begin{aligned}1 & 1 & 1 \\\\ -2 & 2 & -2\\end{aligned}]\\cdot [\\begin{aligned}1 & -2 \\\\ 1 & 2 \\\\ 1 & -2\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}1 & 1 & 1 \\\\ -2 & 2 & -2\\end{aligned}]\\cdot [\\begin{aligned}8 \\\\ 4 \\\\ 6\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -2 \\\\ 1 & 2 \\\\ 1 & -2\\end{aligned}]\\cdot {[\\begin{aligned}3 & -2 \\\\ -2 & 12\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}18 \\\\ -20\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -2 \\\\ 1 & 2 \\\\ 1 & -2\\end{aligned}]\\cdot \\frac{1}{32}[\\begin{aligned}12 & 2 \\\\ 2 & 3\\end{aligned}]\\cdot [\\begin{aligned}18 \\\\ -20\\end{aligned}] \\\\  & =\\frac{1}{4}[\\begin{aligned}1 & -2 \\\\ 1 & 2 \\\\ 1 & -2\\end{aligned}]\\cdot [\\begin{aligned}22 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}7 \\\\ 4 \\\\ 7\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-39871" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/activity-metadata.json" "file_sha256" "dc01981be994ba947da44dd911e6db4e8f8b70f65e927c0e9ccb37c908388958"} {"question" "q-39871" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-39871" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}25 \\\\ 11 \\\\ 25\\end{aligned}]"] ["math" "[\\begin{aligned}4 \\\\ 2 \\\\ 4\\end{aligned}]"] ["math" "[\\begin{aligned}6 \\\\ 8 \\\\ 4\\end{aligned}]"] ["math" "[\\begin{aligned}7 \\\\ 4 \\\\ 7\\end{aligned}]"] ["math" "[\\begin{aligned}\\frac{3}{4} \\\\ \\frac{1}{2} \\\\ \\frac{3}{4}\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-39871" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}7 \\\\ 4 \\\\ 7\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" 