12 \\\\ -20\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -2 \\\\ -2 & -2 \\\\ 2 & -2\\end{aligned}]\\cdot \\frac{1}{32}[\\begin{aligned}3 & -1 \\\\ -1 & 3\\end{aligned}]\\cdot [\\begin{aligned}12 \\\\ -20\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -2 \\\\ -2 & -2 \\\\ 2 & -2\\end{aligned}]\\cdot \\frac{1}{4}[\\begin{aligned}7 \\\\ -9\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 1 \\\\ 8\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/example-5576.json" "file_sha256" "0396cf4f28c2db92e59a6503da147767cc526117f639ccfb6f34ae2a5076619b"} {"question" "e-5575" "field" nil "attribute" "question/problem" "value" "Verify whether the vectors $\\mathbf{a}_1, \\mathbf{a}_2, \\mathbf{a}_3$ are linearly independent, and find the orthogonal projection of $\\mathbf{x}$ onto the subspace spanned by the vectors $\\{ \\mathbf{a}_1, \\mathbf{a}_2, \\mathbf{a}_3 \\},$ where\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/assets/226d83de1fff110426877af083e1aee5eac7f7de1244bb59f7f801aeea8ec6a5.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/example-5575.json" "file_sha256" "2a586120244028357f04010403df915558d403170b6ffb35c80f155e257b87b1"} {"question" "e-5575" "field" nil "attribute" "question/worked-solution" "value" "First, we verify whether $\\mathbf{a}_1, \\mathbf{a}_2, \\mathbf{a}_3$ are linearly independent. So, we start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned} & [\\begin{aligned}4 & 1 & 1 \\\\ 3 & 1 & 2 \\\\ 1 & 1 & 4\\end{aligned}] &  & \\begin{aligned}{R}_{3}↔{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 1 & 4 \\\\ 3 & 1 & 2 \\\\ 4 & 1 & 1\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-3){R}_{1} \\\\ {R}_{3}:={R}_{3}+(-4){R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 1 & 4 \\\\ 0 & -2 & -10 \\\\ 0 & -3 & -15\\end{aligned}] &  & \\begin{aligned}{R}_{3}:={R}_{3}+(-\\frac{3}{2}){R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 1 & 4 \\\\ 0 & -2 & -10 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, the pivot columns correspond to the linearly independent vectors $\\mathbf{a}_1$ and $\\mathbf{a}_2$ that form the basis of our span.\n\nNow, the orthogonal projection of $\\mathbf{x}$ onto the subspace spanned by the linearly independent columns of a matrix $A$ is given by\n\n$$\n\\textrm{proj}_{S} \\: \\mathbf{x} = A(A^T\\!A)^{-1}\\!A^T\\,\\mathbf{x}.\n$$\n\nIn our case, we have\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/assets/c051729499bde9389ad7e38ab91d3609c8153cbed59233f4b3e3e7ac9e9c2534.png)\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}4 & 1 \\\\ 3 & 1 \\\\ 1 & 1\\end{aligned}]\\cdot {([\\begin{aligned}4 & 3 & 1 \\\\ 1 & 1 & 1\\end{aligned}]\\cdot [\\begin{aligned}4 & 1 \\\\ 3 & 1 \\\\ 1 & 1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}4 & 3 & 1 \\\\ 1 & 1 & 1\\end{aligned}]\\cdot [\\begin{aligned}5 \\\\ -1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}4 & 1 \\\\ 3 & 1 \\\\ 1 & 1\\end{aligned}]\\cdot {[\\begin{aligned}26 & 8 \\\\ 8 & 3\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}18 \\\\ 5\\end{aligned}] \\\\  & =[\\begin{aligned}4 & 1 \\\\ 3 & 1 \\\\ 1 & 1\\end{aligned}]\\cdot \\frac{1}{14}[\\begin{aligned}3 & -8 \\\\ -8 & 26\\end{aligned}]\\cdot [\\begin{aligned}18 \\\\ 5\\end{aligned}] \\\\  & =[\\begin{aligned}4 & 1 \\\\ 3 & 1 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}1 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}3 \\\\ 2 \\\\ 0\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/exampl