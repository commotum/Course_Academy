gned}]}^{-1}\\cdot [\\begin{aligned}3 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 1 \\\\ -1 & 1 \\\\ 2 & 1\\end{aligned}]\\cdot \\frac{1}{6}[\\begin{aligned}1 & -1 \\\\ -1 & 3\\end{aligned}]\\cdot [\\begin{aligned}3 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 1 \\\\ -1 & 1 \\\\ 2 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ -3 \\\\ 0\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-158362" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/activity-metadata.json" "file_sha256" "dc01981be994ba947da44dd911e6db4e8f8b70f65e927c0e9ccb37c908388958"} {"question" "q-158362" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-158362" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}0 \\\\ -3 \\\\ 0\\end{aligned}]"] ["math" "[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}]"] ["math" "[\\begin{aligned}2 \\\\ -3 \\\\ 2\\end{aligned}]"] ["math" "[\\begin{aligned}2 \\\\ 1 \\\\ 2\\end{aligned}]"] ["math" "[\\begin{aligned}3 \\\\ -3 \\\\ 1\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-158362" "field" "selecti