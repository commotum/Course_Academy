aligned}2 & 1 \\\\ 1 & -1 \\\\ 2 & 1\\end{aligned}]\\cdot {[\\begin{aligned}9 & 3 \\\\ 3 & 3\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}13 \\\\ 5\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 1 \\\\ 1 & -1 \\\\ 2 & 1\\end{aligned}]\\cdot \\frac{1}{6}[\\begin{aligned}1 & -1 \\\\ -1 & 3\\end{aligned}]\\cdot [\\begin{aligned}13 \\\\ 5\\end{aligned}] \\\\  & =\\frac{1}{6}[\\begin{aligned}2 & 1 \\\\ 1 & -1 \\\\ 2 & 1\\end{aligned}]\\cdot [\\begin{aligned}8 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}3 \\\\ 1 \\\\ 3\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-40573" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/activity-metadata.json" "file_sha256" "dc01981be994ba947da44dd911e6db4e8f8b70f65e927c0e9ccb37c908388958"} {"question" "q-40573" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-40573" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-2 \\\\ -4 \\\\ -2\\end{aligned}]"] ["math" "[\\begin{aligned}3 \\\\ 1 \\\\ 3\\end{aligned}]"] ["math" "[\\begin{aligned}3 \\\\ 6 \\\\ 3\\end{aligned}]"] ["math" "[\\begin{aligned}4 \\\\ -1 \\\\ 4\\end{aligned}]"] ["math" "[\\begin{aligned}5 \\\\ 1 \\\\ 5\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-40573" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}3 \\\\ 1 \\\\ 3\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-86760" "field" nil "attribute" "question/problem" "value" "Find the orthogonal projection of the vector $x$ onto the plane $r=sv+tw,$ where $s,t\\in R,$ and\n\n$$\nv=[\\begin{aligned}1 \\\\ 2 \\\\ 2\\end{aligned}],\\,w=[\\begin{aligned}3 \\\\ 2 \\\\ 1\\end{aligned}],\\,x=[\\begin{aligned}2 \\\\ 9 \\\\ -1\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-86760" "field" nil "attribute" "question/worked-solution" "value" "First, notice that $v$ and $w$ are linearly independent. \n\nThe orthogonal projection of $x$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nSince our plane passes through the origin, it defines the subspace $S=\\text{Span}{v,w}$ in ${R}^{3}.$ In our case, we have\n\n$$\nA=[\\begin{aligned}| & | \\\\ v & w \\\\ | & |\\end{aligned}]=[\\begin{aligned}1 & 3 \\\\ 2 & 2 \\\\ 2 & 1\\end{aligned}]\\,⟹\\,{A}^{T}=[\\begin{aligned}1 & 2 & 2 \\\\ 3 & 2 & 1\\end{aligned}].\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}1 & 3 \\\\ 2 & 2 \\\\ 2 & 1\\end{aligned}]\\cdot {([\\begin{aligned}1 & 2 & 2 \\\\ 3 & 2 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 3 \\\\ 2 & 2 \\\\ 2 & 1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}1 & 2 & 2 \\\\ 3 & 2 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 9 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 3 \\\\ 2 & 2 \\\\ 2 & 1\\end{aligned}]\\cdot {[\\begin{aligned}9 & 9 \\\\ 9 & 14\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}18 \\\\ 23\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 3 \\\\ 2 & 2 \\\\ 2 & 1\\end{aligned}]\\cdot \\frac{1}{45}[\\begin{aligned}14 & -9 \\\\ -9 & 9\\end{aligned}]\\cdot [\\begin{aligned}18 \\\\ 23\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 3 \\\\ 2 & 2 \\\\ 2 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ 4 \\\\ 3\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-86760" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/activity-metadata.json" "file_sha256" "dc01981be994ba947da44dd911e6db4e8f8b70f65e927c0e9ccb37c908388958"} {"question" "q-86760" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-86760" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-2 \\\\ 1 \\\\ 2\\end{aligned}]"] ["math" "[\\begin{aligned}1 \\\\ 7 \\\\ -3\\end{aligned}]"] ["math" "[\\begin{aligned}2 \\\\ 2 \\\\ 1\\end{aligned}]"] ["math" "[\\begin{aligned}4 \\\\ 4 \\\\ 3\\end{aligned}]"] ["math" "[\\begin{aligned}9 \\\\ 2 \\\\ -3\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-86760" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}4 \\\\ 4 \\\\ 3\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-40571" "field" nil "attribute" "question/problem" "value" "Find the vector in the subspace spanned by ${{a}_{1},{a}_{2}}$ \nthat is closest to the vector $x,$ where \n\n$$\n{a}_{1}=[\\begin{aligned}-3 \\\\ 3 \\\\ 3\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}],\\,x=[\\begin{aligned}1 \\\\ 1 \\\\ 1\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-40571" "field" nil "attribute" "question/worked-solution" "value" "First, notice that ${a}_{1}$ and ${a}_{2}$ are linearly independent. \n\nThe closest vector to $x$ in the subspace spanned by ${{a}_{1},{a}_{2}}$ is orthogonal projection of $x$ onto the subspace, which is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have\n\n$$\nA=[\\begin{aligned}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{aligned}]=[\\begin{aligned}-3 & 1 \\\\ 3 & 1 \\\\ 3 & -1\\end{aligned}]\\,⇒\\,{A}^{T}=[\\begin{aligned}-3 & 3 & 3 \\\\ 1 & 1 & -1\\end{aligned}].\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}-3 & 1 \\\\ 3 & 1 \\\\ 3 & -1\\end{aligned}]\\cdot {([\\begin{aligned}-3 & 3 & 3 \\\\ 1 & 1 & -1\\end{aligned}]\\cdot [\\begin{aligned}-3 & 1 \\\\ 3 & 1 \\\\ 3 & -1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}-3 & 3 & 3 \\\\ 1 & 1 & -1\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ 1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 1 \\\\ 3 & 1 \\\\ 3 & -1\\end{aligned}]\\cdot {[\\begin{aligned}27 & -3 \\\\ -3 & 3\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}3 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 1 \\\\ 3 & 1 \\\\ 3 & -1\\end{aligned}]\\cdot \\frac{1}{24}[\\begin{aligned}1 & 1 \\\\ 1 & 9\\end{aligned}]\\cdot [\\begin{aligned}3 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 1 \\\\ 3 & 1 \\\\ 3 & -1\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{6} \\\\ \\frac{1}{2}\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-40571" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/activity-metadata.json" "file_sha256" "dc01981be994ba947da44dd911e6db4e8f8b70f65e927c0e9ccb37c908388958"} {"question" "q-40571" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069030/state.json" "file_sha256" "ac75dcc4cf260bcebbc75bca64a777d9d0a3a8f16a7039c5b24b6a5182ee6ca0"} {"question" "q-40571" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]"] ["math" "[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]"] ["math" "[\\begin{aligned}0 \\\\ 6 \\\\ 0\\end{aligned}]"] ["math" "[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]"] ["math" "[\\begin{aligned}4 \\\