d90-ad7c-01aac06079e3" 13194139536006 true] [17592186379183 1034 "15" 13194139536006 true] [17592186379183 1103 #edb/ref 17592186045453 13194139536006 true] [17592186379183 1111 #uuid "1ed888f5-9a42-576a-9439-909c12a2aa42" 13194139536006 true] [17592186379184 1034 "1" 13194139536006 true] [17592186379184 1103 #edb/ref 17592186045453 13194139536006 true] [17592186379184 1111 #uuid "255885b8-92e4-526e-8a76-1e0ebcc8d39b" 13194139536006 true] [17592186379185 1034 "0" 13194139536006 true] [17592186379185 1103 #edb/ref 17592186045453 13194139536006 true] [17592186379185 1111 #uuid "3f59f455-b01b-5da8-87da-67e459f12a72" 13194139536006 true] [17592186379186 1017 #edb/ref 17592186379187 13194139536006 true] [17592186379186 1089 "q-74212" 13194139536006 true] [17592186379186 1091 #edb/ref 17592186045465 13194139536006 true] [17592186379186 1100 "Consider the matrix given by $L=[\\begin{aligned}3 & 1 \\\\ 4 & -2 \\\\ -1 & 1\\end{aligned}].$ Determine the value of $k$ for which the vector $b=[\\begin{aligned}k-11 \\\\ -10 \\\\ 5\\end{aligned}]$ belongs to $\\text{Col}(L).$" 13194139536006 true] [17592186379186 1113 #uuid "7ad6fcbc-db24-5596-8c00-5b434344d5b8" 13194139536006 true] [17592186379186 1145 "If $b$ lies in $\\text{Col}(L),$ then the equation $Lx=b$ must be consistent. So, let's find the row echelon form of the augmented matrix $[L\\,|\\,b]$ as follows:\n\n$$\n\\begin{aligned}[L\\,|\\,b] & =[\\begin{aligned}3 & 1 & k-11 \\\\ 4 & -2 & -10 \\\\ -1 & 1 & 5\\end{aligned}] & {R}_{1} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}-1 & 1 & 5 \\\\ 4 & -2 & -10 \\\\ 3 & 1 & k-11\\end{aligned}] & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼[\\begin{aligned}-1 & 1 & 5 \\\\ 0 & 2 & 10 \\\\ 3 & 1 & k-11\\end{aligned}] & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼[\\begin{aligned}-1 & 1 & 5 \\\\ 0 & 2 & 10 \\\\ 0 & 4 & k+4\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}-1 & 1 & 5 \\\\ 0 & 2 & 10 \\\\ 0 & 0 & k-16\\end{aligned}]\\end{aligned}\n$$\n\nSo, we have the system\n\n$$\n{\\begin{aligned}-{x}_{1}+{x}_{2}=5 \\\\ 2{x}_{2}=10 \\\\ 0=k-16.\\end{aligned}\n$$\n\nIn order for this system to be consistent, we require $0=k-16,$ which means that $k=16.$" 13194139536006 true] [17592186379187 1000 #edb/ref 17592186379188 13194139536006 true] [17592186379187 1000 #edb/ref 17592186379189 13194139536006 true] [17592186379187 1000 #edb/ref 17592186379190 13194139536006 true] [17592186379187 1000 #edb/ref 17592186379191 13194139536006 true] [17592186379187 1000 #edb/ref 17592186379192 13194139536006 true] [17592186379187 1040 #edb/ref 17592186045450 13194139536006 true] [17592186379187 1041 "selection" 13194139536006 true] [17592186379187 1104 #edb/ref 17592186379190 13194139536006 true] [17592186379187 1110 #uuid "febcff31-456f-5038-9642-c05427f99f40" 13194139536006 true] [17592186379188 1034 "-8" 13194139536006 true] [17592186379188 1103 #edb/ref 17592186045453 13194139536006 true] [17592186379188 1111 #uuid "2174c897-5862-5221-8787-7bc085ca705c" 13194139536006 true] [17592186379189 1034 "-16" 13194139536006 true] [17592186379189 1103 #edb/ref 17592186045453 13194139536006 true] [17592186379189 1111 #uuid "551f6eba-0d08-55bf-b62a-1f370731a475" 13194139536006 true] [17592186379190 1034 "16" 13194139536006 true] [17592186379190 1103 #edb/ref 17592186045453 13194139536006 true] [17592186379190 1111 #uuid "82fea190-b04d-5c74-bd5d-4d54deffa25c" 13194139536006 true] [17592186379191 1034 "8" 13194139536006 true] [17592186379191 1103 #edb/ref 17592186045453 13194139536006 true] [17592186379191 1111 #uuid "d885c88c-f693-572e-ad9a-e0f689ad96d0" 13194139536006 true] [17592186379192 1034 "24" 13194139536006 true] [17592186379192 1103 #edb/ref 17592186045453 13194139536006 true] [17592186379192 1111 #uuid "2260775e-fc56-553a-958b-5a9b2e0f8545" 13194139536006 true] [17592186379193 1017 #edb/ref 17592186379194 13194139536006 true] [17592186379193 1089 "q-74223" 13194139536006 true] [17592186379193 1091 #edb/ref 17592186045465 13194139536006 true] [17592186379193 1100 "The matrix $M$ and the vector $b$ are given below.\nDetermine if $b\\in \\text{Col}(M).$ \nIn the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}$, where ${x}_{1},{x}_{2}$ and ${x}_{3}$ are real numbers such that $b={x}_{1}{m}_{1}+{x}_{2}{m}_{2}+{x}_{3}{m}_{3},$ and ${m}_{1}$, ${m}_{2}$, and ${m}_{3}$ are the respective columns of $M.$\n\n$$\nM=[\\begin{aligned}2 & 1 & -5 \\\\ 2 & 1 & -4 \\\\ 6 & 0 & -13\\end{aligned}],\\,b=[\\begin{aligned}2 \\\\ 1 \\\\ 16\\end{aligned}]\n$$" 13194139536006 true] [17592186379193 1113 #uuid "2495c295-7729-594d-b36b-7f04ca3acef0" 13194139536006 true] [17592186379193 1145 "In order to determine whether $b$ lies in $\\text{Col}(M),$ we need to check if the equation $Mx=b$ is consistent. So, let's find the row echelon form of the augmented matrix $[M\\,|\\,b]$ as follows:\n\n$$\n\\begin{aligned}[M\\,|\\,b] & =[\\begin{aligned}2 & 1 & -5 & 2 \\\\ 2 & 1 & -4 & 1 \\\\ 6 & 0 & -13 & 16\\end{aligned}] & {R}_{2} & :={R}_{2}-{R}_{1} \\\\  & ∼[\\begin{aligned}2 & 1 & -5 & 2 \\\\ 0 & 0 & 1 & -1 \\\\ 6 & 0 & -13 & 16\\end{aligned}] & {R}_{3} & :={R}_{3}-3{R}_{1} \\\\  & ∼[\\begin{aligned}2 & 1 & -5 & 2 \\\\ 0 & 0 & 1 & -1 \\\\ 0 & -3 & 2 & 10\\end{aligned}] & {R}_{2} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}2 & 1 & -5 & 2 \\\\ 0 & -3 & 2 & 10 \\\\ 0 & 0 & 1 & -1\\end{aligned}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n{\\begin{aligned}2{x}_{1}+{x}_{2}-5{x}_{3}=2 \\\\ -3{x}_{2}+2{x}_{3}=10 \\\\ {x}_{3}=-1.\\end{aligned}\n$$\n\nFrom the third equation, we get ${x}_{3}=-1.$ Substituting it into the second equation gives \n\n$$\n\\begin{aligned}-3{x}_{2}+2(-1) & =10 \\\\ -3{x}_{2}-2 & =10 \\\\ -3{x}_{2} & =12 \\\\ {x}_{2} & =-4.\\end{aligned}\n$$\n\nFinally, from the first equation, we get \n\n$$\n\\begin{aligned}2{x}_{1}+(-4)-5(-1) & =2 \\\\ 2{x}_{1}+1 & =2 \\\\ 2{x}_{1} & =1 \\\\ {x}_{1} & =\\frac{1}{2}.\\end{aligned}\n$$\n\nSince we have a solution, the equation $Mx=b$ is consistent, which implies that $b\\in \\text{Col}(M).$ \n\nMoreover, there is exactly one solution, so we have exactly one way to write $b$ as a linear combination of ${m}_{1},$ ${m}_{2},$ and ${m}_{3}:$\n\n$$\n{{[\\begin{aligned}2 \\\\ 1 \\\\ 16\\end{aligned}]}_{⏟}}_{b}=\\frac{1}{2}\\cdot {{[\\begin{aligned}2 \\\\ 2 \\\\ 6\\end{aligned}]}_{⏟}}_{{m}_{1}}+(-4)\\cdot {{[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]}_{⏟}}_{{m}_{2}}+(-1)\\cdot {{[\\begin{aligned}-5 \\\\ -4 \\\\ -13\\end{aligned}]}_{⏟}}_{{m}_{3}}\n$$\n\nFinally, we get ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}=\\frac{1}{2}\\cdot (-4)\\cdot (-1)=2.$" 13194139536006 true] [17592186379194 1000 #edb/ref 17592186379195 13194139536006 true] [17592186379194 1000 #edb/ref 17592186379196 13194139536006 true] [17592186379194 1000 #edb/ref 17592186379197 13194139536006 true] [17592186379194 1000 #edb/ref 17592186379198 13194139536006 true] [17592186379194 1000 #edb/ref 17592186379199 13194139536006 true] [17592186379194 1040 #edb/ref 17592186045450 13194139536006 true] [17592186379194 1041 "selection" 13194139536006 true] [17592186379194 1104 #edb/ref 17592186379197 13194139536006 true] [17592186379194 1110 #uuid "60830f8e-0c88-54f4-8f62-c2a959b1a9bb" 13194139536006 true] [17592186379195 1034 "-\\frac{1}{2}" 13194139536006 true] [17592186379195 1103 #edb/ref 17592186045453 13194139536006 true] [17592186379195 1111 #uuid "a6249785-9289-5c5e-b1b7-6a64649145e8" 13194139536006 true] [17592186379196 1034 "\\frac{1}{2}" 13194139536006 true] [17592186379196 1103 #edb/ref 17592186045453 13194139536006 true] [17592186379196 1111 #uuid "2cfbfee2-c8fd-5afb-8b32-9dfb5558271c" 13194139536006 true] [17592186379197 1034 "2" 13194139536006 true] [17592186379197 1103 #edb/ref 17592186045453 13194139536006 true] [17592186379197 1111 #uuid "4b379667-5ea1-5281-ac13-348be95c320d" 13194139536006 true] [17592186379198 1034 "1" 13194139536006 true] [17592186379198 1103 #edb/ref 17592186045453 13194139536006 true] [17592186379198 1111 #uuid "2522f8e4-d611-5206-8484-84a6b3f3a51c