-aa35-ed7bf39e7ec5" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-5 \\\\ 3\\sqrt{2} \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-41943/selection/05764deb8d20ea819b5443e82d3809fe173a214d93a1c1a58146559a5188dbba" :answer/id #uuid "e1d6720e-c498-58e0-83b2-372b7b20bd8b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}5 \\\\ -3.5 \\\\ -4\\sqrt{5}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-41943/selection/b61d7a7a463a201a325d88b585f66f2bd4ab2f25e235fb0cdb8b1c5f1f2eb5ed" :answer/id #uuid "427445ff-478a-544f-ac80-6fb9cb9c9bc5" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-5 & 3\\sqrt{2} & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-41943/selection" :answer-field/id #uuid "00b33009-1dcd-54c7-bb70-908009796cfe" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-41943/selection/05764deb8d20ea819b5443e82d3809fe173a214d93a1c1a58146559a5188dbba" :answer-field/choices ["q-41943/selection/eb742d93b09ab6735516433591246296733a867696f3421ba92abba17b9544f2" "q-41943/selection/c8327bb8e89fb8df9286a6f7a9b766d8bfeb3fd14b5ae412c95f77f1ca8737ed" "q-41943/selection/2bc15b438683a68b721b073bed9dd1570aa07f7241757d15b198b23e3b07190a" "q-41943/selection/05764deb8d20ea819b5443e82d3809fe173a214d93a1c1a58146559a5188dbba" "q-41943/selection/b61d7a7a463a201a325d88b585f66f2bd4ab2f25e235fb0cdb8b1c5f1f2eb5ed"] :db/ensure [:answer-field/validate]} {:db/id "q-41943" :question/id #uuid "7d52bfbe-0cf7-5e74-a083-e7db8c4ef851" :question/math-academy-id "q-41943" :question/problem "Find the product $AB$, if\n$A=[\\begin{aligned}\\sqrt{3} & -5 & 5 \\\\ -5 & 3\\sqrt{2} & -3.5 \\\\ 1 & 2 & -4\\sqrt{5}\\end{aligned}]$\nand \n$B=[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}].$" :question/worked-solution "Notice that $B$ is the $3$rd *column* of the identity matrix ${I}_{3}.$\n\nSince we're multiplying the $3\\times 3$ matrix $A$ by the $3$rd *column* of the identity matrix ${I}_{3}$, the result must be the $3$rd column of $A.$ Therefore,\n\n$$\nAB=[\\begin{aligned}5 \\\\ -3.5 \\\\ -4\\sqrt{5}\\end{aligned}].\n$$\n\n \n\nLet's check the long way:\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}\\sqrt{3} & -5 & 5 \\\\ -5 & 3\\sqrt{2} & -3.5 \\\\ 1 & 2 & -4\\sqrt{5}\\end{aligned}][\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}\\sqrt{3}\\cdot 0+(-5)\\cdot 0+5\\cdot 1 \\\\ (-5)\\cdot 0+3\\sqrt{2}\\cdot 0+(-3.5)\\cdot 1 \\\\ 1\\cdot 0+2\\cdot 0+(-4\\sqrt{5})\\cdot 1\\end{aligned}] \\\\  & =[\\begin{aligned}5 \\\\ -3.5 \\\\ -4\\sqrt{5}\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-41943/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "89362140-1a17-56fd-a9ab-4da336112bee"] :knowledge-point/questions ["q-41943"] :db/ensure [:knowledge-point/validate]} {:db/id "q-275527/field-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "3bf4955a-0239-5c2c-bd32-b7fa2fbed817" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-275527/field-1" :answer-field/id #uuid "7e8b2017-bffe-5983-954a-4470a99846a9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-275527/field-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer-field/choices ["q-275527/field-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133"] :db/ensure [:answer-field/validate]} {:db/id "q-275527/field-2/219347bb4a6f51134d7f5aff5da33544f44afee934064621ebff9cf9e335ee59" :answer/id #uuid "3833740f-88dd-5b09-bb26-7450818c8a3c" :answer/type :answer.type/math :answer/value "\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "q-275527/field-2" :answer-field/id #uuid "5f7ed158-e257-5030-9300-7ec93f2aae85" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-275527/field-2/219347bb4a