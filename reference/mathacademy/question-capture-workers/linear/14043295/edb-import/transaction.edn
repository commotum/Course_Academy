ned}-5 \\\\ \\sqrt{5} \\\\ -8\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-275527/field-1" "q-275527/field-2" "q-275527/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "89362140-1a17-56fd-a9ab-4da336112bee"] :knowledge-point/questions ["q-275527"] :db/ensure [:knowledge-point/validate]} {:db/id "q-41979/selection/a7634a5d76926e96486885bd78de404cd08ca8397cbd019c1d5e5050ce02f284" :answer/id #uuid "3dffed79-29f4-553b-a32d-a1a03f842101" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1.5 \\\\ -2\\sqrt{3} \\\\ 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-41979/selection/26fe73512c661c2ed7ed20b32b27b6836c5904da0c235d0d2b32138468b15900" :answer/id #uuid "d00674fd-2103-5bf9-b297-1d5e5e58073a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3.5 & -2\\sqrt{3} & -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-41979/selection/1d145271c6ea3c3e6f165551239146aea86412c54876358f5f2ea6afd67056b9" :answer/id #uuid "1737013f-1094-5684-afcb-7469f0d78e88" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 4 & -\\sqrt{5}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-41979/selection/84fdc059a8ff7d4660fd48c50497c13fad9491a5d4d6163490a009461c7d23ed" :answer/id #uuid "ff612315-9591-557d-936c-5f7684d98e54" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4\\sqrt{2} \\\\ -3.5 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-41979/selection/9a92ec75f8ebb63aba4a0532c8369a18a08947be83974ef9c0a2172f49402562" :answer/id #uuid "14da55fc-6b8e-53f9-9c47-f7be3c9c3f26" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4\\sqrt{2} & 1.5 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-41979/selection" :answer-field/id #uuid "b28a5a05-ff3a-5076-96ff-de7375fa3c6b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-41979/selectio