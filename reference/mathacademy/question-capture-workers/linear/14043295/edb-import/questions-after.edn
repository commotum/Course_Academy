value "-5" :db/id #edb/ref 17592186319624} :answer-field/id #uuid "7e8b2017-bffe-5983-954a-4470a99846a9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186319623} {:answer-field/choices [{:answer/id #uuid "3833740f-88dd-5b09-bb26-7450818c8a3c" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186319626}] :answer-field/correct {:answer/id #uuid "3833740f-88dd-5b09-bb26-7450818c8a3c" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186319626} :answer-field/id #uuid "5f7ed158-e257-5030-9300-7ec93f2aae85" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186319625} {:answer-field/choices [{:answer/id #uuid "6d5fe693-7b52-5121-a726-3d26460de018" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186319628}] :answer-field/correct {:answer/id #uuid "6d5fe693-7b52-5121-a726-3d26460de018" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186319628} :answer-field/id #uuid "da1fe341-9b19-5582-bb5f-cdacb624f260" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186319627}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a88eeeca-4999-565a-b61f-4c13b23c85fb" :question/math-academy-id "q-275527" :question/problem "Find the product $AB,$ if\n$A=[\\begin{aligned}\\sqrt{5} & -5 & 2 \\\\ 3 & \\sqrt{5} & -6 \\\\ 7 & -8 & 0\\end{aligned}]$\nand \n$B=[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}].$\n\n|  |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n| $AB=\\,\\,$ |  | {{field-2}} |  |\n|  |  | {{field-3}} |  |" :question/worked-solution "Notice that $B$ is the $2$nd *column* of the identity matrix ${I}_{3}.$\n\nSince we're multiplying the $3\\times 3$ matrix $A$ by the $2$nd *column* of the identity matrix ${I}_{3},$ the result must be the $2$nd *column* of $A.$ Therefore,\n\n$$\nAB=[\\begin{aligned}-5 \\\\ \\sqrt{5} \\\\ -8\\end{aligned}].\n$$\n\nLet's check the long way:\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}\\sqrt{5} & -5 & 2 \\\\ 3 & \\sqrt{5} & -6 \\\\ 7 & -8 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}\\sqrt{5}\\cdot 0+(-5)\\cdot 1+2\\cdot 0 \\\\ 3\\cdot 0+\\sqrt{5}\\cdot 1+(-6)\\cdot 0 \\\\ 7\\cdot 0+(-8)\\cdot 1+0\\cdot 0\\end{aligned}] \\\\  & =[\\begin{aligned}-5 \\\\ \\sqrt{5} \\\\ -8\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186319629 :knowledge-point/_questions [{:knowledge-point/id #uuid "1f2f5234-df9c-5269-8702-30b4dde9a2ca" :knowledge-point/title "Multiplying a Matrix by the Identity Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ac69b9c-a2ec-5ecf-9985-578ca47af22b" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186319631} {:answer/id #uuid "c5c614b4-56e8-5e23-8694-71a38e66bde4" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186319632}] :answer-field/correct {:answer/id #uuid "7ac69b9c-a2ec-5ecf-9985-578ca47af22b" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186319631} :answer-field/id #uuid "5b02db87-f401-50d8-883f-823c11fa7338" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186319630} {:answer-field/choices [{:answer/id #uuid "15554c4f-307a-5249-b09f-9b3d6dee7e76" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186319634}] :answer-field/correct {:answer/id #uuid "15554c4f-307a-5249-b09f-9b3d6dee7e76" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186319634} :answer-field/id #uuid "45ff6125-74bb-5615-86be-70dc532f9a3b" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592