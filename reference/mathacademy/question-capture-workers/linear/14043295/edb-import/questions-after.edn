#{[{:db/id #edb/ref 17592186100609 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "1f2f5234-df9c-5269-8702-30b4dde9a2ca" :knowledge-point/title "Multiplying a Matrix by the Identity Matrix"}] :question/id #uuid "f7868f7f-b296-5a38-9af6-61dc4d1198a7" :question/math-academy-id "e-4408" :question/problem "Calculate the product $I_3 B$ given that $I_3$ is the $3 \\times 3$ identity matrix and\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043295/assets/9b8d8f439845a4949789fe313997d2245249e1a4df58c750d7cda0af36f1ce18.png)" :question/worked-solution "Any matrix, when multiplied by an identity matrix, remains unchanged (assuming that the multiplication is well defined).\n\nThe matrix $I_3$ is a $3 \\times 3$ matrix and $B$ is a $3 \\times 3$ matrix too. \n\nTherefore, the multiplication is well defined and \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043295/assets/ac591cf90fae6e8275fed52c26c8487bff9d654733d414974631948fe30b8150.png)"}] [{:db/id #edb/ref 17592186100610 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "89362140-1a17-56fd-a9ab-4da336112bee" :knowledge-point/title "Multiplying a Matrix by a Column or Row of the Identity Matrix"}] :question/id #uuid "9832238f-baff-5527-a11a-c65b6529cb0b" :question/math-academy-id "e-4410" :question/problem "Calculate the product $C D,$ if\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043295/assets/945664c408577aac1d1a745120b3c17c46fd9db93e6d26cc53a4e501390936e2.png)\nand \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043295/assets/907ffa0b29d96249fe03a7fce3fe682c08982b14c7b7f72840540e6269196425.png)" :question/worked-solution "Notice that $D$ is the $2$nd *column* of the identity matrix $I_3.$\n\nSince we're multiplying the $3\\times 3$ matrix $C$ by the $2$nd *column* of the identity matrix $I_3,$ the result must be the $2$nd *column* of $C.$ Therefore,\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043295/assets/980ae75452824b4a8aa701b4e11be8c31448557933357458329f0a2b73a1cca6.png)\n\nDon't believe it? Let's check the long way:\n\n$$\n\\begin{aligned}CD & =[\\begin{aligned}2 & 1 & 0 \\\\ -1 & 1 & -4 \\\\ 5 & 4 & -2\\end{aligned}][\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}2\\cdot 0+1\\cdot 1+0\\cdot 0 \\\\ -1\\cdot 0+1\\cdot 1+(-4)\\cdot 0 \\\\ 5\\cdot 0+4\\cdot 1+(-2)\\cdot 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 1 \\\\ 4\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186319606 :knowledge-point/_questions [{:knowledge-point/id #uuid "1f2f5234-df9c-5269-8702-30b4dde9a2ca" :knowledge-point/title "Multiplying a Matrix by the Identity Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1c0dba9-91be-573d-a083-f1205003d5cd" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 & 4 \\\\ 2 & -1\\end{aligned}]" :db/id #edb/ref 17592186319608} {:answer/id #uuid "2fa5f7fd-fa89-502c-8936-e352f7926590" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -1 \\\\ -3 & 4\\end{aligned}]" :db/id #edb/ref 17592186319609} {:answer/id #uuid "addc1b0b-1543-5a65-80e4-0471506b3c40" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 1 \\\\ 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186319610} {:answer/id #uuid "7171a6f9-8b96-5aa7-b932-9b4d99050b5f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186319611} {:answer/id #uuid "47ba17c3-173e-5a01-80ae-17660d8f4788" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & -3 \\\\ -1 & 2\\end{aligned}]" :db/id #edb/ref 17592186319612}] :answer-field/correct {:answer/id #uuid "a1c0dba9-91be-573d-a083-f1205003d5cd" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 & 4 \\\\ 2 & -1\\end{aligned}]" :db/id #edb/ref 17592186319608} :answer-field/id #uuid "f9703643-ad5b-5b47-afb3-3ac816a0fd0e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186319607}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "66e5c6c9-fe50-5402-8857-ebb27b865919" :question/math-academy-id "q-130243" :question/problem "Calculate the product $A{I}_{2}$ given that ${I}_{2}$ is the $2\\times 2$ identity matrix and\n$A=[\\begin{aligned}-3 & 4 \\\\ 2 & -1\\end{aligned}].$" :question/worked-solution "Any matrix, when multiplied by an identity matrix, remains unchanged (assuming that the multiplication is well defined).\n\nThe matrix $A$ is a $2\\times 2$ matrix and ${I}_{2}$ is a $2\\times 2$ matrix too. \n\nTherefore, the multiplication is well defined and \n\n$$\nA\\cdot {I}_{2}=A=[\\begin{aligned}-3 & 4 \\\\ 2 & -1\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186279032 :knowledge-point/_questions [{:knowledge-point/id #uuid "89362140-1a17-56fd-a9ab-4da336112bee" :knowledge-point/title "Multiplying a Matrix by a Column or Row of the Identity Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f9228cb9-585a-5f6f-bb50-d41711011f01" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{\\sqrt{2}}{2} \\\\ \\frac{\\sqrt{2}}{2} \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186279034} {:answer/id #uuid "c26801bd-4f21-5d47-b61b-29883a1f9efd" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{\\sqrt{2}}{2} & \\frac{\\sqrt{2}}{2} & 0\\end{aligned}]" :db/id #edb/ref 17592186279035} {:answer/id #uuid "c9e0c733-b35b-50ea-84d7-f989fd75cd74" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186279036} {:answer/id #uuid "534cefcc-eadd-5531-ad7f-ae5d9901da55" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{\\sqrt{2}}{2} \\\\ \\frac{1}{2} \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186279037} {:answer/id #uuid "0be9da00-88e9-5d6d-9157-b1810eb736a5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{1}{2} \\\\ \\frac{1}{2} \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186279038}] :answer-field/correct {:answer/id #uuid "f9228cb9-585a-5f6f-bb50-d41711011f01" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{\\sqrt{2}}{2} \\\\ \\frac{\\sqrt{2}}{2} \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186279034} :answer-field/id #uuid "c9e9beb0-2e23-50ee-9d1b-bd0e3c85478b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186279033}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "4d0b6a4e-efb1-5ae5-9574-5048a588b6e3" :question/math-academy-id "q-130247" :question/problem "Find the product $AB$, if\n$A=[\\begin{aligned}\\frac{\\sqrt{2}}{2} & -\\frac{\\sqrt{2}}{2} & 0 \\\\ \\frac{\\sqrt{2}}{2} & \\frac{\\sqrt{2}}{2} & 0 \\\\ 0 & 0 & 1\\end{aligned}]$\nand \n$B=[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}].$" :question/worked-solution "Notice that $B$ is the $2$nd *column* of the identity matrix ${I}_{3}.$\n\nSince we're multiplying the $3\\times 3$ matrix $A$ by the $2$nd *column* of the identity matrix ${I}_{3},$ the result must be the $2$nd *column* of $A.$ Therefore,\n\n$$\nAB=[\\begin{aligned}-\\frac{\\sqrt{2}}{2} \\\\ -\\frac{\\sqrt{2}}{2} \\\\ 0\\end{aligned}].\n$$\n\nLet's check the long way:\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}\\frac{\\sqrt{2}}{2} & -\\frac{\\sqrt{2}}{2} & 0 \\\\ \\frac{\\sqrt{2}}{2} & \\frac{\\sqrt{2}}{2} & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{\\sqrt{2}}{2}\\cdot 0+(\\frac{-\\sqrt{2}}{2})\\cdot 1+0\\cdot 0 \\\\ \\frac{\\sqrt{2}}{2}\\cdot 0+\\frac{\\sqrt{2}}{2}\\cdot 1+0\\cdot 0 \\\\ 0\\cdot 0+0\\cdot 1+1\\cdot 0\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{\\sqrt{2}}{2} \\\\ \\frac{\\sqrt{2}}{2} \\\\ 0\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186319613 :knowledge-point/_questions [{:knowledge-point/id #uuid "1f2f5234-df9c-5269-8702-30b4dde9a2ca" :knowledge-point/title "Multiplying a Matrix by the Identity Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ccabd11-519f-5448-918b-74b5a50a43fb" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186319615}] :answer-field/correct {:answer/id #uuid "7ccabd11-519f-5448-918b-74b5a50a43fb" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186319615} :answer-field/id #uuid "deaf01d4-7c6e-5eb1-85c0-260dc5d30420" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186319614} {:answer-field/choices [{:answer/id #uuid "4287b820-f7a4-5012-bf0d-36b24762573b" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186319617}] :answer-field/correct {:answer/id #uuid "4287b820-f7a4-5012-bf0d-36b24762573b" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186319617} :answer-field/id #uuid "5fc90050-ab05-5709-9465-577886470fe6" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186319616} {:answer-field/choices [{:answer/id #uuid "f1d9bd2d-51f2-5abd-9451-0f2e867698ab" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186319619}] :answer-field/correct {:answer/id #uuid "f1d9bd2d-51f2-5abd-9451-0f2e867698ab" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186319619} :answer-field/id #uuid "e8a2e1b6-038c-59c4-8b60-ff29f53fab7e" :answer-field/key "field-3" :answer-field/type {:db/ident 