swer-field/key "field-6" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186319641} {:answer-field/choices [{:answer/id #uuid "b2792dba-9b72-5dcb-8a7e-3eb84c15aa7c" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186319644}] :answer-field/correct {:answer/id #uuid "b2792dba-9b72-5dcb-8a7e-3eb84c15aa7c" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186319644} :answer-field/id #uuid "dfe440ee-7196-5852-a20c-5aaabdb61a20" :answer-field/key "field-7" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186319643} {:answer-field/choices [{:answer/id #uuid "aafaec6c-1d8b-5383-8943-4d32de25294d" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186319646}] :answer-field/correct {:answer/id #uuid "aafaec6c-1d8b-5383-8943-4d32de25294d" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186319646} :answer-field/id #uuid "ead103d3-1e91-53c5-afaf-20fa3e52aeae" :answer-field/key "field-8" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186319645} {:answer-field/choices [{:answer/id #uuid "4b6f41ad-7c2c-5ca9-989a-133d2e2eface" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186319648}] :answer-field/correct {:answer/id #uuid "4b6f41ad-7c2c-5ca9-989a-133d2e2eface" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186319648} :answer-field/id #uuid "e8134ad2-d44f-5187-8cbc-65229f0b7906" :answer-field/key "field-9" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186319647}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7de6b20e-f6e2-590c-bf9e-47d9bc8cba76" :question/math-academy-id "q-337655" :question/problem "Calculate the product ${I}_{3}B$ given that ${I}_{3}$ is the $3\\times 3$ identity matrix and\n$B=[\\begin{aligned}4 & -1 & 3 \\\\ 2 & 0 & -6 \\\\ -5 & 7 & 1\\end{aligned}].$\n\n|  |  | {{field-1}} | {{field-2}} | {{field-3}} |  |\n| --- | --- | --- | --- | --- | --- |\n| ${I}_{3}\\cdot B=\\,\\,$ |  | {{field-4}} | {{field-5}} | {{field-6}} |  |\n|  |  | {{field-7}} | {{field-8}} | {{field-9}} |  |" :question/worked-solution "Any matrix, when multiplied by an identity matrix, remains unchanged (assuming that the multiplication is well defined).\n\nThe matrix $B$ is a $3\\times 3$ matrix and ${I}_{3}$ is a $3\\times 3$ matrix too. \n\nTherefore, the multiplication is well defined and \n\n$$\n{I}_{3}\\cdot B=B=[\\begin{aligned}4 & -1 & 3 \\\\ 2 & 0 & -6 \\\\ -5 & 7 & 1\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186319649 :knowledge-point/_questions [{:knowledge-point/id #uuid "89362140-1a17-56fd-a9ab-4da336112bee" :knowledge-point/title "Multiplying a Matrix by a Column or Row of the Identity Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1d6720e-c498-58e0-83b2-372b7b20bd8b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 \\\\ -3.5 \\\\ -4\\sqrt{5}\\end{aligned}]" :db/id #edb/ref 17592186319651} {:answer/id #uuid "95ec2b21-9e06-5186-aa35-ed7bf39e7ec5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 \\\\ 3\\sqrt{2} \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186319652} {:answer/id #uuid "427445ff-478a-544f-ac80-6fb9cb9c9bc5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 & 3\\sqrt{2} & 2\\end{aligned}]" :db/id #edb/ref 17592186319653} {:answer/id #uuid "f576764d-8777-5c42-a272-c11967618c80" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\sqrt{3} \\\\ -5 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186319654} {:answer/id #uuid "3b4bc049-bf2b-514e-8dcd-9b4fd085f70e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\sqrt{3} & -5 & 1\\end{aligned}]" :db/id #edb/ref 17592186319655}] :answer-field/correct {:answer/id #uuid "e1d6720e-c498-58e0-83b2-372b7b20bd8b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 \\\\ -3.5 \\\\ -4\\sqrt{5}\\end{aligned}]" :db/id #edb/ref 17592186319651} :answer-field/id #uuid "00b33009-1dcd-54c7-bb70-908009796cfe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186319650}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7d52bfbe-0cf7-5e74-a083-e7db8c4ef851" :question/math-academy-id "q-41943" :question/problem "Find the product $AB$, if\n$A=[\\begin{aligned}\\sqrt{3} & -5 & 5 \\\\ -5 & 3\\sqrt{2} & -3.5 \\\\ 1 & 2 & -4\\sqrt{5}\\end{aligned}]$\nand \n$B=[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}].$" :question/worked-solution "Notice that $B$ is the $3$rd *column* of the identity matrix ${I}_{3}.$\n\nSince we're multiplying the $3\\times 3$ matrix $A$ by the $3$rd *column* of the identity matrix ${I}_{3}$, the result must be the $3$rd column of $A.$ Therefore,\n\n$$\nAB=[\\begin{aligned}5 \\\\ -3.5 \\\\ -4\\sqrt{5}\\end{aligned}].\n$$\n\n \n\nLet's check the long way:\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}\\sqrt{3} & -5 & 5 \\\\ -5 & 3\\sqrt{2} & -3.5 \\\\ 1 & 2 & -4\\sqrt{5}\\end{aligned}][\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}\\sqrt{3}\\cdot 0+(-5)\\cdot 0+5\\cdot 1 \\\\ (-5)\\cdot 0+3\\sqrt{2}\\cdot 0+(-3.5)\\cdot 1 \\\\ 1\\cdot 0+2\\cdot 0+(-4\\sqrt{5})\\cdot 1\\end{aligned}] \\\\  & =[\\begin{aligned}5 \\\\ -3.5 \\\\ -4\\sqrt{5}\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186319656 :knowledge-point/_questions [{:knowledge-point/id #uuid "89362140-1a17-56fd-a9ab-4da336112bee" :knowledge-point/title "Multiplying a Matrix by a Column or Row of the Identity Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c61e51f-fb32-5b4e-8a47-1a09f71f27e9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -3 & -\\sqrt{3}\\end{aligned}]" :db/id #edb/ref 17592186319658} {:answer/id #uuid "d3bf9147-1f0e-56b6-9e93-b22e55ee6235" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\sqrt{6} & 4 & 1\\end{aligned}]" :db/id #edb/ref 17592186319659} {:answer/id #uuid "6a89f43d-9e54-58cb-b803-f19488322895" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\sqrt{7} \\\\ -3.2 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186319660} {:answer/id #uuid "e5d7c919-f82d-5fee-90cc-a893fb7be0d1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2\\sqrt{2} & \\sqrt{5} & -3.2\\end{aligned}]" :db/id #edb/ref 17592186319661} {:answer/id #uuid "668fab7c-53a5-52b6-a4fc-a8d0cf36605f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 \\\\ \\sqrt{5} \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186319662}] :answer-field/correct {:answer/id #uuid "e5d7c919-f82d-5fee-90cc-a893fb7be0d1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2\\sqrt{2} & \\sqrt{5} & -3.2\\end{aligned}]" :db/id #edb/ref 17592186319661} :answer-field/id #uuid "c3793e72-05ae-547f-b526-5db132a90f0e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186319657}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ebc5630e-e6db-53b3-a857-6c1c02e997fa" :question/math-academy-id "q-41977" :question/problem "Find the product $AB$, if\n$A=[\\begin{aligned}0 & 1 & 0\\end{aligned}]$\nand \n$B=[\\begin{aligned}1 & -3 & -\\sqrt{7} \\\\ 2\\sqrt{2} & \\sqrt{5} & -3.2 \\\\ \\sqrt{6} & 4 & 1\\end{aligned}].$" :question/worked-solution "Notice that $A$ is the $2$nd *row* of the identity matrix ${I}_{3}.$\n\nSince we're multiplying the $3\\times 3$ matrix $B$ by the $2$nd *row* of the identity matrix ${I}_{3}$ on the *left*, the result must be the $2$nd *row* of $B.$ Therefore, \n\n$$\nAB=[\\begin{aligned}2\\sqrt{2} & \\sqrt{5} & -3.2\\end{aligned}].\n$$\n\nLet's check the long way: \n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}0 & 1 & 0\\end{aligned}][\\begin{aligned}1 & -3 & -\\sqrt{7} \\\\ 2\\sqrt{2} & \\sqrt{5} & -3.2 \\\\ \\sqrt{6} & 4 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}2\\sqrt{2} & \\sqrt{5} & -3.2\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186319663 :knowledge-point/_questions [{:knowledge-point/id #uuid "89362140-1a17-56fd-a9ab-4da336112bee" :knowledge-point/title "Multiplying a Matrix by a Column or Row of the Identity Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1737013f-1094-5684-afcb-7469f0d78e88" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 4 & -\\sqrt{5}\\end{aligned}]" :db/id #edb/ref 17592186319665} {:answer/id #uuid "d00674fd-2103-5bf9-b297-1d5e5e58073a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3.5 & -2\\sqrt{3} & -3\\end{aligned}]" :db/id #edb/ref 17592186319666} {:answer/id #uuid "ff612315-9591-557d-936c-5f7684d98e54" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4\\sqrt{2} \\\\ -3.5 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186319667} {:answer/id #uuid "14da55fc-6b8e-53f9-9c47-f7be3c9c3f26" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4\\sqrt{2} & 1.5 & 2\\end{aligned}]" :db/id #edb/ref 17592186319668} {:answer/id #uuid "3dffed79-29f4-553b-a32d-a1a03f842101" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1.5 \\\\ -2\\sqrt{3} \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186319669}] :answer-field/correct {:answer/id #uuid "d00674fd-2103-5bf9-b297-1d5e5e58073a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3.5 & -2\\sqrt{3} & -3\\end{aligned}]" :db/id #edb/ref 17592186319666} :answer-field/id #uuid "b28a5a05-ff3a-5076-96ff-de7375fa3c6b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186319664}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5a82f967-13eb-5468-be5e-6279bc86bd17" :question/math-academy-id "q-41979" :question/problem "Find the product $AB$, if\n$A=[\\begin{aligned}0 & 1 & 0\\end{aligned}]$\nand \n$B=[\\begin{aligned}4\\sqrt{2} & 1.5 & 2 \\\\ -3.5 & -2\\sqrt{3} & -3 \\\\ 1 & 4 & -\\sqrt{5}\\end{aligned}].$" :question/worked-solution "Notice that $A$ is the $2$nd *row* of the identity matrix ${I}_{3}.$\n\nSince we're multiplying the $3\\times 3$ matrix $B$ by the $2$nd *row* of the identity matrix ${I}_{3}$ on the *left*, the result must be the $2$nd *row* of $B.$ Therefore,\n\n$$\nAB=[\\begin{aligned}-3.5 & -2\\sqrt{3} & -3\\end{aligned}].\n$$\n\nLet's check the long way:\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}0 & 1 & 0\\end{aligned}][\\begin{aligned}4\\sqrt{2} & 1.5 & 2 \\\\ -3.5 & -2\\sqrt{3} & -3 \\\\ 1 & 4 & -\\sqrt{5}\\end{aligned}] \\\\  & =[\\begin{aligned}-3.5 & -2\\sqrt{3} & -3\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186319670 :knowledge-point/_questions [{:knowledge-point/id #uuid "1f2f5234-df9c-5269-8702-30b4dde9a2ca" :knowledge-point/title "Multiplying a Matrix by the Identity Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0388c589-ea80-5aaf-8a19-e17f21e0d2d9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & -1 \\\\ -2 & -3\\end{aligned}]" :db/id #edb/ref 17592186319672} {:answer/id #uuid "5d9e46c4-3374-57b0-b862-b0048ae119e1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 0 \\\\ 2 & 1\\end{aligned}]" :db/id #edb/ref 17592186319673} {:answer/id #uuid "f80dc751-1955-5e28-9b37-31da99f86ea6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ -2 & 3\\end{aligned}]" :db/id #edb/ref 17592186319674} {:answer/id #uuid "c82bac02-f010-534d-bd1c-ff856ac596c4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 & 0 \\\\ 2 & -1\\end{aligned}]" :db/id #edb/ref 17592186319675} {:answer/id #uuid "da87b683-8e60-5f76-b3aa-7d0d13e574e5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 0 \\\\ -2 & -3\\end{aligned}]" :db/id #edb/ref 17592186319676}] :answer-field/correct {:answer/id #uuid "da87b683-8e60-5f76-b3aa-7d0d13e574e5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 0 \\\\ -2 & -3\\end{aligned}]" :db/id #edb/ref 17592186319676} :answer-field/id #uuid "b561be2a-1274-5087-be4a-8977eebada22" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186319671}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f7e33d66-32a7-5f90-977a-c52df9f42564" :question/math-academy-id "q-75473" :question/problem "Calculate the product $J{I}_{2}$ given that ${I}_{2}$ is the $2\\times 2$ identity matrix and\n$J=[\\begin{aligned}-1 & 0 \\\\ -2 & -3\\end{aligned}].$" :question/worked-solution "Any matrix, when multiplied by an identity matrix, remains unchanged (assuming that the multiplication is well defined).\n\nThe matrix $J$ is a $2\\times 2$ matrix and ${I}_{2}$ is a $2\\times 2$ matrix too. \n\nTherefore, the multiplication is well defined and \n\n$$\nJ\\cdot {I}_{2}=J=[\\begin{aligned}-1 & 0 \\\\ -2 & -3\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186279096 :knowledge-point/_questions [{:knowledge-point/id #uuid "1f2f5234-df9c-5269-8702-30b4dde9a2ca" :knowledge-point/title "Multiplying a Matrix by the Identity Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49f73cee-b4a6-59b2-9533-74a783242bbd" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-7 & 7 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186279098} {:answer/id #uuid "acb56da7-c69a-5fc5-8ea7-e004233b23a3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-7 & 7 \\\\ 1 & 0\\end{aligned}]" :db/id #edb/ref 17592186279099} {:answer/id #uuid "99d42236-dca2-531d-ba31-48e7b138dde6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 1 \\\\ -7 & 7\\end{aligned}]" :db/id #edb/ref 17592186279100} {:answer/id #uuid "0b5c1c45-15ac-5eb6-871b-1828c386cb79" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-7 & 7 \\\\ 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186279101} {:answer/id #uuid "abeb432e-237f-5f51-887a-eee7ca8f11d3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & -7 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186279102}] :answer-field/correct {:answer/id #uuid "abeb432e-237f-5f51-887a-eee7ca8f11d3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & -7 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186279102} :answer-field/id #uuid "3155ad0a-8145-538f-afcb-5578645ad5cb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186279097}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1fd6de04-63a9-5f4e-b338-88b9712e3f7f" :question/math-academy-id "q-75479" :question/problem "Calculate the product $Q{I}_{2}$ given that ${I}_{2}$ is the $2\\times 2$ identity matrix and\n$Q=[\\begin{aligned}7 & -7 \\\\ 0 & 1\\end{aligned}].$" :question/worked-solution "Any matrix, when multiplied by an identity matrix, remains unchanged (assuming that the multiplication is well defined).\n\nThe matrix $Q$ is a $2\\times 2$ matrix and ${I}_{2}$ is a $2\\times 2$ matrix too. \n\nTherefore, the multiplication is well defined and \n\n$$\nQ\\cdot {I}_{2}=Q=[\\begin{aligned}7 & -7 \\\\ 0 & 1\\end{aligned}].\n$$"}]}
