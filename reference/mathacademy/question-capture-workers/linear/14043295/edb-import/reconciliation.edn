\\end{aligned}]"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978659/state.json" "file_sha256" "5d202b35250385a2fb2656559dcf5f4a0b5ce8cd4ea309239a368884332ab69c" "basis" 840 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978659/edb-import/verification.json"} {"question" "q-130247" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}\\frac{\\sqrt{2}}{2} & \\frac{\\sqrt{2}}{2} & 0\\end{aligned}]"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978659/state.json" "file_sha256" "5d202b35250385a2fb2656559dcf5f4a0b5ce8cd4ea309239a368884332ab69c" "basis" 840 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978659/edb-import/verification.json"} {"question" "q-130247" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}-\\frac{\\sqrt{2}}{2} \\\\ \\frac{\\sqrt{2}}{2} \\\\ 0\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978659/state.json" "file_sha256" "5d202b35250385a2fb2656559dcf5f4a0b5ce8cd4ea309239a368884332ab69c" "basis" 840 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978659/edb-import/verification.json"} {"question" "e-4408" "field" nil "attribute" "question/problem" "value" "Calculate the product $I_3 B$ given that $I_3$ is the $3 \\times 3$ identity matrix and\n$[\\begin{aligned}2 & 3 & -1 \\\\ 5 & 2 & 7 \\\\ 0 & 4 & 6\\end{aligned}]$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978659/example-4408.json" "file_sha256" "00991ba6f54b2c41bbd5bd22a2cf649259caae4d55dc3532a32705de0a65d816" "basis" 840 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978659/edb-import/verification.json"} {"question" "e-4408" "field" nil "attribute" "question/worked-solution" "value" "Any matrix, when multiplied by an identity matrix, remains unchanged (assuming that the multiplication is well defined).\n\nThe matrix $I_3$ is a $3 \\times 3$ matrix and $B$ is a $3 \\times 3$ matrix too. \n\nTherefore, the multiplication is well defined and \n\n$$\n[\\begin{aligned}2 & 3 & -1 \\\\ 5 & 2 & 7 \\\\ 0 & 4 & 6\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978659/example-4408.json" "file_sha256" "00991ba6f54b2c41bbd5bd22a2cf649259caae4d55dc3532a32705de0a65d816" "basis" 840 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978659/edb-import/verification.json"} {"question" "e-4410" "field" nil "attribute" "question/problem" "value" "Calculate the product $C D,$ if\n$[\\begin{aligned}2 & 1 & 0 \\\\ -1 & 1 & -4 \\\\ 5 & 4 & -2\\end{aligned}]$\nand \n$[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978659/example-4410.json" "file_sha256" "389140b0a38fbc4fd076fc95bb794fe1f90434f228c66aedd9dd381018684d16" "basis" 840 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978659/edb-import/verification.json"} {"question" "e-4410" "field" nil "attribute" "question/worked-solution" "value" "Notice that $D$ is the $2$nd *column* of the identity matrix $I_3.$\n\nSince we're multiplying the $3\\times 3$ matrix $C$ by the $2$nd *column* of the identity matrix $I_3,$ the result must be the $2$nd *column* of $C.$ Therefore,\n\n$$\n[\\begin{aligned}1 \\\\ 1 \\\\ 4\\end{aligned}]\n$$\n\nDon't believe it? Let's check the long way:\n\n$$\n\\begin{aligned}CD & =[\\begin{aligned}2 & 1 & 0 \\\\ -1 & 1 & -4 \\\\ 5 & 4 & -2\\end{aligned}][\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}2\\cdot 0+1\\cdot 1+0\\cdot 0 \\\\ -1\\cdot 0+1\\cdot 1+(-4)\\cdot 0 \\\\ 5\\cdot 0+4\\cdot 1+(-2)\\cdot 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 1 \\\\ 4\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978659/example-4410.json" "file_sha256" "389140b0a38fbc4fd076fc95bb794fe1f90434f228c66aedd9dd381018684d16" "basis" 840 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978659/edb-import/verification.json"}] "sources" [{"question" "q-75473" "field" nil "attribute" "question/problem" "value" "Calculate the product $J{I}_{2}$ given that ${I}_{2}$ is the $2\\times 2$ identity matrix and\n$J=[\\begin{aligned}-1 & 0 \\\\ -2 & -3\\end{aligned}].$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043295/state.json" "file_sha256" "61f050b22ddd2adc712957940b0d2c1107925c54ab9aab554a81c166f6f23daf"} {"question" "q-75473" "field" nil "attribute" "question/worked-solution" "value" "Any matrix, when multiplied by an identity matrix, remains unchanged (assuming that the multiplication is well defined).\n\nThe matrix $J$ is a $2\\times 2$ matrix and ${I}_{2}$ is a $2\\times 2$ matrix too. \n\nTherefore, the multiplication is well defined and \n\n$$\nJ\\cdot {I}_{2}=J=[\\begin{aligned}-1 & 0 \\\\ -2 & -3\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043295/state.json" "file_sha256" "61f050b22ddd2adc712957940b0d2c1107925c54ab9aab554a81c166f6f23daf"} {"question" "q-75473" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14043295/activity-metadata.json" "file_sha256" "8f3ee00b57b51bc6b