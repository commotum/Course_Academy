#{[{:db/id #edb/ref 17592186308505 :knowledge-point/_questions [{:knowledge-point/id #uuid "5e023193-7494-5e3a-bd6e-e15ae0e9a1bd" :knowledge-point/title "Calculating the Norm of a Vector in an Inner Product Space of Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac47e7cf-caaa-5f81-81a8-c53bd757c1dc" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{5}" :db/id #edb/ref 17592186308507} {:answer/id #uuid "df89db0b-eeef-5618-8765-65957c5d75b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{21}" :db/id #edb/ref 17592186308508} {:answer/id #uuid "e4758cb0-61fb-5fa9-88b1-6e7f6d2326dd" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{21}" :db/id #edb/ref 17592186308509} {:answer/id #uuid "8c41e0f4-705a-56bd-b39a-8abe336523f5" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{14}" :db/id #edb/ref 17592186308510} {:answer/id #uuid "12d336ee-0d17-540f-8180-c981b7c25631" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{5}" :db/id #edb/ref 17592186308511}] :answer-field/correct {:answer/id #uuid "e4758cb0-61fb-5fa9-88b1-6e7f6d2326dd" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{21}" :db/id #edb/ref 17592186308509} :answer-field/id #uuid "2cd76808-9a8b-58eb-9a64-8f4ac3af00d4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186308506}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "2cfd7234-83ad-57e9-960b-f838a9b42ca8" :question/math-academy-id "q-141167" :question/problem "Let $V={R}_{2}[t]$ be the vector space of all polynomials of degree at most $2,$ equipped with the inner product\n\n$$\n⟨x(t),y(t)⟩=x(1)y(1)+x(2)y(2)+x(3)y(3).\n$$\n\nCalculate the norm of the vector $p(t)=2-t+{t}^{2}.$" :question/worked-solution "The norm of a vector $p(t)$ with respect to an inner product $⟨\\cdot ,\\cdot ⟩$ is defined as\n\n$$\n\\begin{aligned}‖p(t)‖=\\sqrt{⟨p(t),p(t)⟩}.\\end{aligned}\n$$\n\nSince $p(t)=2-t+{t}^{2},$ we obtain\n\n$$\np(1)=2,\\,p(2)=4,\\,p(3)=8.\n$$\n\nComputing $‖p(t)‖$ using our definition, we get\n\n$$\n\\begin{aligned}‖p(t)‖ & =\\sqrt{⟨p(t),p(t)⟩} \\\\  & =\\sqrt{p(1)p(1)+p(2)p(2)+p(3)p(3)} \\\\  & =\\sqrt{[p(1)]^{2}+[p(2)]^{2}+[p(3)]^{2}} \\\\  & =\\sqrt{{2}^{2}+{4}^{2}+{8}^{2}} \\\\  & =\\sqrt{4+16+64} \\\\  & =\\sqrt{84} \\\\  & =2\\sqrt{21}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186308519 :knowledge-point/_questions [{:knowledge-point/id #uuid "090d6747-55e2-548b-84f2-88f6c732518f" :knowledge-point/title "Calculating the Norm of a Vector in an Inner Product Space of Continuous Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b143890-0503-5b24-8531-6e85acf23ee2" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2\\pi +2}" :db/id #edb/ref 17592186308521} {:answer/id #uuid "9bdb1a46-0d13-58b3-84ac-263992a26deb" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{\\pi }" :db/id #edb/ref 17592186308522} {:answer/id #uuid "314dc21b-8871-5df2-a10f-d67e3bed48fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2\\pi +1}" :db/id #edb/ref 17592186308523} {:answer/id #uuid "83c6089a-5085-5afa-9420-c8c743c14463" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\pi }" :db/id #edb/ref 17592186308524} {:answer/id #uuid "a1c66ed9-f5a7-5e46-b119-fe80c0508e4b" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2\\pi }" :db/id #edb/ref 17592186308525}] :answer-field/correct {:answer/id #uuid "a1c66ed9-f5a7-5e46-b119-fe80c0508e4b" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2\\pi }" :db/id #edb/ref 17592186308525} :answer-field/id #uuid "8e0e9478-9f06-55a6-a86b-6a58136206e7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186308520}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "76a38372-c4e4-54ba-9d14-0563306ec42c" :question/math-academy-id "q-141171" :question/problem "Let $V=C[-\\pi ,\\pi ]$ be the vector space of all functions that are continuous on $[-\\pi ,\\pi ],$ equipped with the inner product \n\n$$\n⟨x(t),y(t)⟩={\\int }_{-\\pi }^{\\pi }x(t)y(t)\\,\\text{d}t.\n$$\n\nCalculate the norm of the vector $f(t)=\\operatorname{cos}⁡t-\\operatorname{sin}⁡t.$" :question/worked-solution "The norm of a vector $f(t)$ with respect to an inner product $⟨\\cdot ,\\cdot ⟩$ is defined as\n\n$$\n‖f(t)‖=\\sqrt{⟨f(t),f(t)⟩}.\n$$\n\nComputing the inner product using our definition, we get\n\n$$\n\\begin{aligned}⟨f(t),f(t)⟩ & ={\\int }_{-\\pi }^{\\pi }(f(t))^{2}\\,\\text{d}t \\\\  & ={\\int }_{-\\pi }^{\\pi }\\,{(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)}^{2}\\,\\text{d}t \\\\  & ={\\int }_{-\\pi }^{\\pi }\\,({cos}^{2}⁡t+{sin}^{2}⁡t-2\\operatorname{cos}⁡t\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & ={\\int }_{-\\pi }^{\\pi }(1-\\operatorname{sin}⁡2t)\\,\\text{d}t \\\\  & =(t+\\frac{\\operatorname{cos}⁡2t}{2}){|}_{-\\pi }^{\\pi } \\\\  & =(\\pi +\\frac{\\operatorname{cos}⁡2\\pi }{2})-((-\\pi )+\\frac{\\operatorname{cos}⁡(-2\\pi )}{2}) \\\\  & =2\\pi .\\end{aligned}\n$$\n\nNote that we made use of the trigonometric identities\n\n$$\n{sin}^{2}⁡t+{cos}^{2}⁡t=1\\,\\text{and}\\,\\operatorname{sin}⁡2t=2\\operatorname{sin}⁡t\\operatorname{cos}⁡t.\n$$\n\nFinally then,\n\n$$\n\\begin{aligned}‖f(t)‖ & =\\sqrt{2\\pi }.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186355875 :knowledge-point/_questions [{:knowledge-point/id #uuid "466fb505-1ff3-5b27-a5f7-0ea5b31b2927" :knowledge-point/title "Normalizing a Vector in an Inner Product Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "776d4006-b018-504b-adcc-e1248624dc6a" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{6}(t-{t}^{2})" :db/id #edb/ref 17592186355877} {:answer/id #uuid "cdf88e72-a3c5-5952-8707-983f384f399d" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{6}(t-{t}^{2})" :db/id #edb/ref 17592186355878} {:answer/id #uuid "d57690fd-57ae-5d89-9737-95320a3a7481" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{30}(t-{t}^{2})" :db/id #edb/ref 17592186355879} {:answer/id #uuid "1fae3e8a-f015-5da6-ac85-bd257de206f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{15}(t-{t}^{2})" :db/id #edb/ref 17592186355880} {:answer/id #uuid "56c09d4f-6feb-5a16-87e3-7b3d0ded5550" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{2}(t-{t}^{2})" :db/id #edb/ref 17592186355881}] :answer-field/correct {:answer/id #uuid "d57690fd-57ae-5d89-9737-95320a3a7481" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{30}(t-{t}^{2})" :db/id #edb/ref 17592186355879} :answer-field/id #uuid "ff6a1cee-ebb6-5433-9ddf-8710b81594cb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186355876}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "4e019df4-8208-5025-86f1-fc5239abb5d6" :question/math-academy-id "q-141175" :question/problem "Let $V=C[0,1]$ be the vector space of all functions that are continuous on $[0,1],$ equipped with the inner product \n\n$$\n⟨x(t),y(t)⟩={\\int }_{0}^{1}x(t)y(t)\\,\\text{d}t.\n$$\n\nNormalize the vector $f(t)=t-{t}^{2}.$" :question/worked-solution "The norm of a vector $f(t)$ with respect to an inner product $⟨\\cdot ,\\cdot ⟩$ is defined as\n\n$$\n‖f(t)‖=\\sqrt{⟨f(t),f(t)⟩}.\n$$\n\nComputing the inner product using our definition, we get\n\n$$\n\\begin{aligned}⟨f(t),f(t)⟩ & ={\\int }_{0}^{1}{(t-{t}^{2})}^{2}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\,({t}^{2}-2{t}^{3}+{t}^{4}),\\text{d}t \\\\  & ={(\\frac{{t}^{3}}{3}-\\frac{{t}^{4}}{2}+\\frac{{t}^{5}}{5})|}_{0}^{1}\\,\\text{d}t \\\\  & =\\frac{1}{3}-\\frac{1}{2}+\\frac{1}{5} \\\\  & =\\frac{1}{30}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n‖f(t)‖=\\frac{1}{\\sqrt{30}}.\n$$\n\nTo normalize the vector $f(t),$ we divide $f(t)$ by its norm $‖f(t)‖:$\n\n$$\n\\begin{aligned}u(t) & =\\frac{f(t)}{‖f(t)‖} \\\\  & =\\frac{(t-{t}^{2})}{\\frac{1}{\\sqrt{30}}} \\\\  & =\\sqrt{30}(t-{t}^{2})\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186308582 :knowledge-point/_questions [{:knowledge-point/id #uuid "5e023193-7494-5e3a-bd6e-e15ae0e9a1bd" :knowledge-point/title "Calculating the Norm of a Vector in an Inner Product Space of Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cc5c60d-9e70-5d4e-9225-20400855a68a" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{42}" :db/id #edb/ref 17592186308584} {:answer/id #uuid "d43bde1b-fa03-5c0a-aa29-f4f6493c0650" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186308585} {:answer/id #uuid "c34d5bb2-ad98-5ec6-9662-b23415bb77e1" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{5}" :db/id #edb/ref 17592186308586} {:answer/id #uuid "39069c42-1238-5182-a60d-a057d0829972" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186308587} {:answer/id #uuid "1d6e4c7e-42c8-567e-902f-8ef06e680fd2" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{11}" :db/id #edb/ref 17592186308588}] :answer-field/correct {:answer/id #uuid "0cc5c60d-9e70-5d4e-9225-20400855a68a" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{42}" :db/id #edb/ref 17592186308584} :answer-field/id #uuid "4a34ca04-ed6c-5c04-ad43-438ffc89c787" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186308583}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7690c503-491a-5df3-8fbf-bbfb20b8c977" :question/math-academy-id "q-97425" :question/problem "Let $V={R}_{2}[t]$ be the vector space of all polynomials of degree at most $2,$ equipped with the inner product\n\n$$\n⟨x(t),y(t)⟩=x(0)y(0)+x(2)y(2)+x(3)y(3).\n$$\n\nCalculate the norm of the vector $p(t)=5-3t.$" :question/worked-solution "The norm of a vector $p(t)$ with respect to an inner product $⟨\\cdot ,\\cdot ⟩$ is defined as\n\n$$\n\\begin{aligned}‖p(t)‖=\\sqrt{⟨p(t),p(t)⟩}.\\end{aligned}\n$$\n\nSince $p(t)=5-3t,$ we obtain\n\n$$\np(0)=5,\\,p(2)=-1,\\,p(3)=-4.\n$$\n\nComputing $‖p(t)‖$ using our definition, we get\n\n$$\n\\begin{aligned}‖p(t)‖ & =\\sqrt{⟨p(t),p(t)⟩} \\\\  & =\\sqrt{p(0)p(0)+p(2)p(2)+p(3)p(3)} \\\\  & =\\sqrt{[p(0)]^{2}+[p(2)]^{2}+[p(3)]^{2}} \\\\  & =\\sqrt{(5)^{2}+(-1)^{2}+(-4)^{2}} \\\\  & =\\sqrt{25+1+16} \\\\  & =\\sqrt{42}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186355882 :knowledge-point/_questions [{:knowledge-point/id #uuid "090d6747-55e2-548b-84f2-88f6c732518f" :knowledge-point/title "Calculating the Norm of a Vector in an Inner Product Space of Continuous Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cff18d2-32c2-59a1-8da7-62f352c12793" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\pi +1}" :db/id #edb/ref 17592186355884} {:answer/id #uuid "500f7c90-a0d5-502b-9e8f-bcd52f47fefd" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{\\pi }{2}}" :db/id #edb/ref 17592186355885} {:answer/id #uuid "d6373608-7c3c-544a-b897-e82fc13256d8" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\pi }" :db/id #edb/ref 17592186355886} {:answer/id #uuid "aad3384d-7e56-5e91-8401-40f4beff3697" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{\\pi }{2}-1}" :db/id #edb/ref 17592186355887} {:answer/id #uuid "2b99490b-1fdb-5b1d-abd5-03a4800cc5ae" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\pi -1}" :db/id #edb/ref 17592186355888}] :answer-field/correct {:answer/id #uuid "d6373608-7c3c-544a-b897-e82fc13256d8" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\pi }" :db/id #edb/ref 17592186355886} :answer-field/id #uuid "f92c7057-0bf9-564b-9a29-12f0bd5ccd63" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186355883}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "113d15a6-0fe2-5e15-8f69-833b952efa0b" :question/math-academy-id "q-97710" :question/problem "Let $V=C[0,\\pi ]$ be the vector space of all functions that are continuous on $[0,\\pi ],$ equipped with the inner product \n\n$$\n⟨x(t),y(t)⟩={\\int }_{0}^{\\pi }x(t)y(t)\\,\\text{d}t.\n$$\n\nCalculate the norm of the vector $f(t)=\\operatorname{cos}⁡t+\\operatorname{sin}⁡t.$" :question/worked-solution "The norm of a vector $f(t)$ with respect to an inner product $⟨\\cdot ,\\cdot ⟩$ is defined as\n\n$$\n‖f(t)‖=\\sqrt{⟨f(t),f(t)⟩}.\n$$\n\nComputing the inner product using our definition, we get\n\n$$\n\\begin{aligned}⟨f(t),f(t)⟩ & ={\\int }_{0}^{\\pi }(f(t))^{2}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\,{(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)}^{2}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\,({cos}^{2}⁡t+{sin}^{2}⁡t+2\\operatorname{cos}⁡t\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }(1+\\operatorname{sin}⁡2t)\\,\\text{d}t \\\\  & =(t-\\frac{\\operatorname{cos}⁡2t}{2}){|}_{0}^{\\pi } \\\\  & =(\\pi -\\frac{\\operatorname{cos}⁡2\\pi }{2})-(0-\\frac{\\operatorname{cos}⁡0}{2}) \\\\  & =\\pi .\\end{aligned}\n$$\n\nNote that we made use of the trigonometric identities\n\n$$\n{sin}^{2}⁡t+{cos}^{2}⁡t=1\\,\\text{and}\\,\\operatorname{sin}⁡2t=2\\operatorname{sin}⁡t\\operatorname{cos}⁡t.\n$$\n\nFinally then,\n\n$$\n\\begin{aligned}‖f(t)‖ & =\\sqrt{\\pi }.\\end{aligned}\n$$"}]}
