[{:db/id "q-97710/selection/d20243f58bbb5c9cec78fb53f7cc6e7992da3e814ee374105aae9c3bc4b5da10" :answer/id #uuid "aad3384d-7e56-5e91-8401-40f4beff3697" :answer/type :answer.type/math :answer/value "\\sqrt{\\frac{\\pi }{2}-1}" :db/ensure [:answer/validate]} {:db/id "q-97710/selection/2bb248346834586e66e2b9c5633835c3d863fd25b4f81bc0bb31745cd846108b" :answer/id #uuid "8cff18d2-32c2-59a1-8da7-62f352c12793" :answer/type :answer.type/math :answer/value "\\sqrt{\\pi +1}" :db/ensure [:answer/validate]} {:db/id "q-97710/selection/7588f01677744ddb693c2eeed655549ef2f2749a671a64c9ba9a6becd838a362" :answer/id #uuid "500f7c90-a0d5-502b-9e8f-bcd52f47fefd" :answer/type :answer.type/math :answer/value "\\sqrt{\\frac{\\pi }{2}}" :db/ensure [:answer/validate]} {:db/id "q-97710/selection/e581d19ffc84bd7cf3d1e369d24480fb8d36b8f6dac8d3812f8dacc4049b0078" :answer/id #uuid "2b99490b-1fdb-5b1d-abd5-03a4800cc5ae" :answer/type :answer.type/math :answer/value "\\sqrt{\\pi -1}" :db/ensure [:answer/validate]} {:db/id "q-97710/selection/8f3ef73b7999870c68e02c54e14bf59d32e0c05408243c9952a057bf19f6acf5" :answer/id #uuid "d6373608-7c3c-544a-b897-e82fc13256d8" :answer/type :answer.type/math :answer/value "\\sqrt{\\pi }" :db/ensure [:answer/validate]} {:db/id "q-97710/selection" :answer-field/id #uuid "f92c7057-0bf9-564b-9a29-12f0bd5ccd63" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-97710/selection/8f3ef73b7999870c68e02c54e14bf59d32e0c05408243c9952a057bf19f6acf5" :answer-field/choices ["q-97710/selection/d20243f58bbb5c9cec78fb53f7cc6e7992da3e814ee374105aae9c3bc4b5da10" "q-97710/selection/2bb248346834586e66e2b9c5633835c3d863fd25b4f81bc0bb31745cd846108b" "q-97710/selection/7588f01677744ddb693c2eeed655549ef2f2749a671a64c9ba9a6becd838a362" "q-97710/selection/e581d19ffc84bd7cf3d1e369d24480fb8d36b8f6dac8d3812f8dacc4049b0078" "q-97710/selection/8f3ef73b7999870c68e02c54e14bf59d32e0c05408243c9952a057bf19f6acf5"] :db/ensure [:answer-field/validate]} {:db/id "q-97710" :question/id #uuid "113d15a6-0fe2-5e15-8f69-833b952efa0b" :question/math-academy-id "q-97710" :question/problem "Let $V=C[0,\\pi ]$ be the vector space of all functions that are continuous on $[0,\\pi ],$ equipped with the inner product \n\n$$\n⟨x(t),y(t)⟩={\\int }_{0}^{\\pi }x(t)y(t)\\,\\text{d}t.\n$$\n\nCalculate the norm of the vector $f(t)=\\operatorname{cos}⁡t+\\operatorname{sin}⁡t.$" :question/worked-solution "The norm of a vector $f(t)$ with respect to an inner product $⟨\\cdot ,\\cdot ⟩$ is defined as\n\n$$\n‖f(t)‖=\\sqrt{⟨f(t),f(t)⟩}.\n$$\n\nComputing the inner product using our definition, we get\n\n$$\n\\begin{aligned}⟨f(t),f(t)⟩ & ={\\int }_{0}^{\\pi }(f(t))^{2}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\,{(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)}^{2}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\,({cos}^{2}⁡t+{sin}^{2}⁡t+2\\operatorname{cos}⁡t\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }(1+\\operatorname{sin}⁡2t)\\,\\text{d}t \\\\  & =(t-\\frac{\\operatorname{cos}⁡2t}{2}){|}_{0}^{\\pi } \\\\  & =(\\pi -\\frac{\\operatorname{cos}⁡2\\pi }{2})-(0-\\frac{\\operatorname{cos}⁡0}{2}) \\\\  & =\\pi .\\end{aligned}\n$$\n\nNote that we made use of the trigonometric identities\n\n$$\n{sin}^{2}⁡t+{cos}^{2}⁡t=1\\,\\text{and}\\,\\operatorname{sin}⁡2t=2\\operatorname{sin}⁡t\\operatorname{cos}⁡t.\n$$\n\nFinally then,\n\n$$\n\\begin{aligned}‖f(t)‖ & =\\sqrt{\\pi }.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-97710/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "090d6747-55e2-548b-84f2-88f6c732518f"] :knowledge-point/questions ["q-97710"] :db/ensure [:knowledge-point/validate]} {:db/id "q-141175/selection/9ed4aca4bbf77bd46d90244e9d494b407642496e9c781dc8eafb37aa23d7c255" :answer/id #uuid "56c09d4f-6feb-5a16-87e3-7b3d0ded5550" :answer/type :answer.type/math :answer/value "3\\sqrt{2}(t-{t}^{2})" :db/ensure [:answer/validate]} {:db/id "q-141175/selection/9e25ca9cf4fb0733f5f3e41499a1dfed3f14bb6af6218210ac080d8979494d0b" :answer/id #uuid "1fae3e8a-f015-5da6-ac85-bd257de206f9" :answer/type :answer.type/math :answer/value "\\sqrt{15}(t-{t}^{2})" :db/ensure [:answer/validate]} {:db/id "q-141175/selection/0874dcb0e9ba25790e2d283a41d7777b3d43919d82346ffa2bfed27479a9e029" :answer/id #uuid "776d4006-b018-504b-adcc-e1248624dc6a" :answer/type :answer.type/math :answer/value "2\\sqrt{6}(t-{t}^{2})" :db/ensure [:answer/validate]} {:db/id "q-141175/selection/57b979be9f775e7e6abc9fc15bfb8acc2b3e9108259338bc565d101573e132cf" :answer/id #uuid "cdf88e72-a3c5-5952-8707-983f384f399d" :answer/type :answer.type/math :answer/value "\\sqrt{6}(t-{t}^{2})" :db/ensure [:answer/validate]} {:db/id "q-141175/selection/95c4e571449c6b966163f44adb6ed98216589da07d8cc0f1734637b7b9d96119" :answer/id #uuid "d57690fd-57ae-5d89-9737-95320a3a7481" :answer/type :answer.type/math :answer/value "\\sqrt{30}(t-{t}^{2})" :db/ensure [:answer/validate]} {:db/id "q-141175/selection" :answer-field/id #uuid "ff6a1cee-ebb6-5433-9ddf-8710b81594cb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-141175/selection/95c4e571449c6b966163f44adb6ed98216589da07d8cc0f1734637b7b9d96119" :answer-field/choices ["q-141175/selection/9ed4aca4bbf77bd46d90244e9d494b407642496e9c781dc8eafb37aa23d7c255" "q-141175/selection/9e25ca9cf4fb0733f5f3e41499a1dfed3f14bb6af6218210ac080d8979494d0b" "q-141175/selection/0874dcb0e9ba25790e2d283a41d7777b3d43919d82346ffa2bfed27479a9e029" "q-141175/selection/57b979be9f775e7e6abc9fc15bfb8acc2b3e9108259338bc565d101573e132cf" "q-141175/selection/95c4e571449c6b966163f44adb6ed98216589da07d8cc0f1734637b7b9d96119"] :db/ensure [:answer-field/validate]} {:db/id "q-141175" :question/id #uuid "4e019df4-8208-5025-86f1-fc5239abb5d6" :question/math-academy-id "q-141175" :question/problem "Let $V=C[0,1]$ be the vector space of all functions that are continuous on $[0,1],$ equipped with the inner product \n\n$$\n⟨x(t),y(t)⟩={\\int }_{0}^{1}x(t)y(t)\\,\\text{d}t.\n$$\n\nNormalize the vector $f(t)=t-{t}^{2}.$" :question/worked-solution "The norm of a vector $f(t)$ with respect to an inner product $⟨\\cdot ,\\cdot ⟩$ is defined as\n\n$$\n‖f(t)‖=\\sqrt{⟨f(t),f(t)⟩}.\n$$\n\nComputing the inner product using our definition, we get\n\n$$\n\\begin{aligned}⟨f(t),f(t)⟩ & ={\\int }_{0}^{1}{(t-{t}^{2})}^{2}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\,({t}^{2}-2{t}^{3}+{t}^{4}),\\text{d}t \\\\  & ={(\\frac{{t}^{3}}{3}-\\frac{{t}^{4}}{2}+\\frac{{t}^{5}}{5})|}_{0}^{1}\\,\\text{d}t \\\\  & =\\frac{1}{3}-\\frac{1}{2}+\\frac{1}{5} \\\\  & =\\frac{1}{30}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n‖f(t)‖=\\frac{1}{\\sqrt{30}}.\n$$\n\nTo normalize the vector $f(t),$ we divide $f(t)$ by its norm $‖f(t)‖:$\n\n$$\n\\begin{aligned}u(t) & =\\frac{f(t)}{‖f(t)‖} \\\\  & =\\frac{(t-{t}^{2})}{\\frac{1}{\\sqrt{30}}} \\\\  & =\\sqrt{30}(t-{t}^{2})\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-141175/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "466fb505-1ff3-5b27-a5f7-0ea5b31b2927"] :knowledge-point/questions ["q-141175"] :db/ensure [:knowledge-point/validate]}]
