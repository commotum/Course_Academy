egin{aligned}5-3\\text{i} \\\\ 2\\text{i}-7\\end{aligned}]={{[\\begin{aligned}5 \\\\ -7\\end{aligned}]}_{⏟}}_{\\text{Re}(v)}+\\text{i}{{[\\begin{aligned}-3 \\\\ 2\\end{aligned}]}_{⏟}}_{\\text{Im}(v)}\\end{aligned}\n$$\n\nFinally, we can now construct $P:$ \n\n$$\n\\begin{aligned}P & =[\\begin{aligned}| & | \\\\ \\text{Re}(v) & \\text{Im}(v) \\\\ | & |\\end{aligned}]=[\\begin{aligned}5 & -3 \\\\ -7 & 2\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-39127/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b049dea4-5045-57ec-ad6a-c49f30e5da1f"] :knowledge-point/questions ["q-39127"] :db/ensure [:knowledge-point/validate]} {:db/id "q-99337/selection/eca12fefd641a77bac0ad97a936fd784a5ece6dfc049f44c479ff1f184896ba6" :answer/id #uuid "08f110f7-97c9-5364-aaed-82fc74a0d960" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & 3 \\\\ 7 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-99337/selection/4ad3760a6d779fddbb859d4fa8132b34d5074fa6b24d58c11c6391100ee464d3" :answer/id #uuid "15cd1d4e-5d40-556f-8d2f-4280f312d7d4" :answer/type :answer.type/math :answer/value "[\\begin{aligned}7 & -3 \\\\ 2 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-99337/selection/463fe05ec67d8721b347528e0bb145314b8b68c9f75bd6bc68a8afa42508c4df" :answer/id #uuid "98fdd609-769d-5859-a88b-961cd42e7c27" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3 & 0 \\\\ 2 & 7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-99337/selection/1f21afecae3e7588ba2123c8a96130134750049ec7c0058b6d4a93ea50c430e3" :answer/id #uuid "49ac5d4c-797f-563a-ac79-27e6e565e02c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}7 & -3 \\\\ 0 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-99337/selection/f40caf1260dea0e62299db9377b8bce7f11c481913c13a96513daeb63b757a84" :answer/id #uuid "786969b8-97b7-5a43-a703-4f48e15b9998" :answer/type :answer.typ