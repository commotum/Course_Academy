nd{aligned}]=C.\n$$\n\nNext, we can find the real and imaginary parts of our eigenvector:\n\n$$\n\\begin{aligned}v & =[\\begin{aligned}7-3\\text{i} \\\\ 2\\end{aligned}]={{[\\begin{aligned}7 \\\\ 2\\end{aligned}]}_{⏟}}_{\\text{Re}(v)}+\\text{i}{{[\\begin{aligned}-3 \\\\ 0\\end{aligned}]}_{⏟}}_{\\text{Im}(v)}\\end{aligned}\n$$\n\nFinally, we can now construct $P:$ \n\n$$\n\\begin{aligned}P & =[\\begin{aligned}| & | \\\\ \\text{Re}(v) & \\text{Im}(v) \\\\ | & |\\end{aligned}]=[\\begin{aligned}7 & -3 \\\\ 2 & 0\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-99337/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b049dea4-5045-57ec-ad6a-c49f30e5da1f"] :knowledge-point/questions ["q-99337"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-38557"] :question/problem "$$\nv=[\\begin{aligned}-\\text{i} \\\\ 1\\end{aligned}],\\,C=[\\begin{aligned}3 & 4 \\\\ -4 & 3\\end{aligned}]\n$$\n\nConsider the vector $v$ and the rotation-scaling matrix $C$ shown above. Given that $v$ is an eigenvector of a $2\\times 2$ matrix $A$ corresponding to the eigenvalue $\\lambda =3+4\\text{i},$ find a matrix $P$ such that $A=PC{P}^{-1}.$" :question/worked-solution "Recall that for any $2\\times 2$ real matrix $A$ with complex eigenvalues, we have $A=PC{P}^{-1},$ where \n\n$$\nP=[\\begin{aligned}| & | \\\\ \\text{Re}(v) & \\text{Im}(v) \\\\ | & |\\end{aligned}],\\,C=[\\begin{aligned}\\text{Re}(\\lambda ) & \\text{Im}(\\lambda ) \\\\ -\\text{Im}(\\lambda ) & \\text{Re}(\\lambda )\\end{aligned}],\n$$\n\nand $v$ is an eigenvector of $A$ corresponding to the complex eigenvalue  $\\lambda .$\n\nFirst, notice that \n\n$$\n[\\begin{aligned}\\text{Re}(\\lambda ) & \\text{Im}(\\lambda ) \\\\ -\\text{Im}(\\lambda ) & \\text{Re}(\\lambda )\\end{aligned}]=[\\begin{aligned}3 & 4 \\\\ -4 & 3\\end{aligned}]=C.\n$$\n\nNext, we can find the real and imaginary parts of our eigenvector:\n\n$$\n\\begin{aligned}v & =[\\begin{aligned}-\\text{i} \\\\ 1\\end{aligned}]={{[\\begin{aligned}0 \\\\ 1\\end{aligned}]}_{⏟}}_{\\text{Re}(v)}+\\text{i}{{[\\begin{aligned}-1 \\\\ 0\\end{aligned}]}_{⏟}}_{\\text{Im}(v)}\\end{aligned}\n$$\n\nFinally, we can now construct $P:$ \n\n$$\n\\begin{aligned}P & =[\\begin{aligned}| & | \\\\ \\text{Re}(v) & \\text{Im}(v) \\\\ | & |\\end{aligned}]=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-99412/selection/500c2df04ee699be158997658f4065023d2cfc774b0fcf4f4ec1f8bd1298af90" :answer/id #uuid "372d559f-9023-5573-9c56-f09e5bf7a2d7" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & -1 \\\\ 1 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-99412/selection/abceaf2db8c0f89e093548d4b921ea5de02a7d4dcfc3b7d958d98e48c9456f43" :answer/id #uuid "a785df69-e51c-5318-bab7-05a81432cde4" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 & -1 \\\\ -1 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-99412/selection/e0be34b736c19b8cf3a8d9886d743574590edf965e9d37b45142455b9585d000" :answer/id #uuid "83177c4b-4a5a-5818-b243-870ec0fba6a2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 & -1 \\\\ -1 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-99412/selection/9d35998ae9fdbd8a2a9c7698f5c8d39d753aca244a7fb29e910ab759009ba5f4" :answer/id #uuid "ee204e12-a2a1-504a-b709-a26ce0ecc9a0" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & 1 \\\\ 1 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-99412/selection/7370f4dd81bfd8eb813fd206f557e795e22ba1a5cd86372a67f07494430132a7" :answer/id #uuid "bcbcd57f-d525-5ddf-8cd8-e2c8838f1a3d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & 1 \\\\ 1 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-99412/selection" :answer-field/id #uuid "2f9936c9-a23e-5a9e-ae7d-26cd5