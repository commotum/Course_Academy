cfaf-56bd-b394-34ac6e069fef" :question/math-academy-id "q-129453" :question/problem "Solve the following system of equations:\n    \n\n$$\n{\\begin{aligned} & {x}_{1}-{x}_{2}-{x}_{3}=4 \\\\  & {x}_{2}+{x}_{3}=2 \\\\  & {x}_{3}=-2\\end{aligned}\n$$" :question/worked-solution "The third equation states that ${x}_{3}=-2.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}+(-2)=2\\,⟹\\,{x}_{2}=2+2=4.\n$$\n\nNow, we substitute ${x}_{2}=4$ and ${x}_{3}=-2$ into the first equation to get\n\n$$\n{x}_{1}-4-(-2)=4\\,⟹\\,{x}_{1}=4+4-2=6.\n$$\n\nTherefore, the solution is ${x}_{1}=6$, ${x}_{2}=4$, and ${x}_{3}=-2.$ In vector form, the solution can be written as $⟨6,4,-2⟩.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-129453/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b8f8937b-de15-5d4c-aa77-1d45595fc7af"] :knowledge-point/questions ["q-129453"] :db/ensure [:knowledge-point/validate]} {:db/id "q-10195/selection/cec5d63f6905349162f4e4262ba220f7162a746ad6c394dce05c1166d8ceb427" :answer/id #uuid "6f792197-a7a6-50d1-9961-b194c7b83e98" :answer/type :answer.type/math :answer/value "⟨\\frac{1}{2},-1,2⟩" :db/ensure [:answer/validate]} {:db/id "q-10195/selection/2b48d8a0fa94854d45312dcab27406196ae03eeaaf34e93d2ffe6313c556bfc9" :answer/id #uuid "fc0a6eba-eb8b-58ec-8897-d0cf1febfe20" :answer/type :answer.type/math :answer/value "⟨-\\frac{1}{2},-1,2⟩" :db/ensure [:answer/validate]} {:db/id "q-10195/selection/775695697c7a03172ab9d1c56b768edb274f51cd6c8c84d95d53270e79eec548" :answer/id #uuid "ae09bc59-42cc-51aa-9db6-d093d23069fa" :answer/type :answer.type/math :answer/value "⟨\\frac{3}{2},1,2⟩" :db/ensure [:answer/validate]} {:db/id "q-10195/selection/cccadc690d88ddfd0280ea61eba654b6d0afaae0714b914dc2b2871872d862cd" :answer/id #uuid "bdfacfc6-c10d-5ce5-8763-0b7178d5f4fc" :answer/type :answer.type/math :answer/value "⟨-\\frac{3}{2},-1,2⟩" :db/ensure [:answer/validate]} {:db/id "q-10195/selection/df9891c318fd0603d8ac82d74fa418bafb7e8cddf07ba7b30315d27da3069f5a" :answer/id #uuid "90eec126-71d1-5c9a-9cb6-21f58fa00483" :answer/type :answer.type/math :answer/value "⟨-\\frac{3}{2},1,2⟩" :db/ensure [:answer/validate]} {:db/id "q-10195/selection" :answer-field/id #uuid "be15f084-0468-539e-9586-3dcf21de9144" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-10195/selection/2b48d8a0fa94854d45312dcab27406196ae03eeaaf34e93d2ffe6313c556bfc9" :answer-field/choices ["q-10195/selection/cec5d63f6905349162f4e4262ba220f7162a746ad6c394dce05c1166d8ceb427" "q-10195/selection/2b48d8a0fa94854d45312dcab27406196ae03eeaaf34e93d2ffe6313c556bfc9" "q-10195/selection/775695697c7a03172ab9d1c56b768edb274f51cd6c8c84d95d53270e79eec548" "q-10195/selection/cccadc690d88ddfd0280ea61eba654b6d0afaae0714b914dc2b2871872d862cd" "q-10195/selection/df9891c318fd0603d8ac82d74fa418bafb7e8cddf07ba7b30315d27da3069f5a"] :db/ensure [:answer-field/validate]} {:db/id "q-10195" :question/id #uuid "86f396e6-bece-557c-89fe-7bc8d07b01b1" :question/math-academy-id "q-10195" :question/problem "Solve the following system of equations:\n    \n\n$$\n{\\begin{aligned} & x+y+z=\\frac{1}{2} \\\\  & y+z=1 \\\\  & z=2\\end{aligned}\n$$" :question/worked-solution "The third equation states that  $z=2.$ Substituting this into the second equation, we get \n\n$$\ny+2=1\\,⟹\\,y=1-2=-1.\n$$\n\nNow, we substitute $z=2$ and $y=-1$into the first equation to get\n\n$$\nx+(-1)+(2)=\\frac{1}{2}\\,⟹\\,x=\\frac{1}{2}-2+1=-\\frac{1}{2}.\n$$\n\nTherefore, the solution is $x=-\\frac{1}{2}$, $y=-1$, and $z=2.$ In vector form, the solution can be written as $⟨-\\frac{1}{2},-1,2⟩.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-10195/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b8f8937b-de15-5d4c-aa77-1d45595fc7af"] :knowledge-point/questions ["q-10195"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-20418"] :question/problem "Solve the following system of equations:\n    \n\n$$\n{\\begin{aligned} & {x}_{1}+{x}_{2}-{x}_{3}=3 \\\\  & {x}_{2}-{x}_{3}=\\frac{1}{2} \\\\  & {x}_{3}=2\\end{aligned}\n$$" :question/worked-solution "The third equation states that ${x}_{3}=2.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}-(2)=\\frac{1}{2}\\,⟹\\,{x}_{2}=\\frac{1}{2}+2=\\frac{5}{2}.\n$$\n\nNow, we substitute ${x}_{2}=\\frac{5}{2}$ and ${x}_{3}=2$ into the first equation to get\n\n$$\n{x}_{1}+(\\frac{5}{2})-(2)=3\\,⟹\\,{x}_{1}=3+2-\\frac{5}{2}=\\frac{5}{2}.\n$$\n\nTherefore, the solution is ${x}_{1}=\\frac{5}{2}$, ${x}_{2}=\\frac{5}{2}$, and ${x}_{3}=2.$ In vector form, the solution can be written as $⟨\\frac{5}{2},\\frac{5}{2},2⟩.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-10199/selection/818a2aad1a941f705f94949131a93b1d420b500d7e0aca61659882abae2cdfaf" :answer/id #uuid "368b36f4-17b6-51cf-a950-0dc99d21e7a6" :answer/type :answer.type/math :answer/value "⟨7,3,1⟩" :db/ensure [:answer/validate]} {:db/id "q-10199/selection/1df34d93cec8f45a7163fb0eec926297257aa81e2f182a20b5cc1756ffee9293" :answer/id #uuid "64e1c4fa-7964-539e-ba2f-0cbc349382a4" :answer/type :answer.type/math :answer/value "⟨5,2,0⟩" :db/ensure [:answer/validate]} {:db/id "q-10199/selection/c31f2e7c73404a1ef9eb097d3257daa9218cdc4401e1e1bac2f2d22ebbd7409b" :answer/id #uuid "95b97466-613f-5dad-a9cc-1df6ee9e20ac" :answer/type :answer.type/math :answer/value "⟨7,-2,-1⟩" :db/ensure [:answer/validate]} {:db/id "q-10199/selection/beb9dd50ca571c512b75f5b6ece5d618b500609cb0bd000978c852096018e591" :answer/id #uuid "0f772a7f-048a-537d-a117-892b331c647e" :answer/type :answer.type/math :answer/value "⟨5,3,-1⟩" :db/ensure [:answer/validate]} {:db/id "q-10199/selection/e01dcdeb1c1cfb6dde76f20dc5edf11345d89e84e8f83057eee9b2a55fb8ec13" :answer/id #uuid "4d92fa0b-61ff-5cf6-b0a7-2b60b6c5a15f" :answer/type :answer.type/math :answer/value "⟨6,2,1⟩" :db/ensure [:answer/validate]} {:db/id "q-10199/selection" :answer-field/id #uuid "cdb603b5-cfa3-51c1-a64d-0eaea53c68f2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-10199/selection/818a2aad1a941f705f94949131a93b1d420b500d7e0aca61659882abae2cdfaf" :answer-field/choices ["q-10199/selection/818a2aad1a941f705f94949131a93b1d420b500d7e0aca61659882abae2cdfaf" "q-10199/selection/1df34d93cec8f45a7163fb0eec926297257aa81e2f182a20b5cc1756ffee9293" "q-10199/selection/c31f2e7c73404a1ef9eb097d3257daa9218cdc4401e1e1bac2f2d22ebbd7409b" "q-10199/selection/beb9dd50ca571c512b75f5b6ece5d618b500609cb0bd000978c852096018e591" "q-10199/selection/e01dcdeb1c1cfb6dde76f20dc5edf11345d89e84e8f83057eee9b2a55fb8ec13"] :db/ensure [:answer-field/validate]} {:db/id "q-10199" :question/id #uuid "557245ad-45e9-56b6-9e4b-33daba094cce" :question/math-academy-id "q-10199" :question/problem "Solve the following system of equations:\n    \n\n$$\n{\\begin{aligned} & x-y-z=3 \\\\  & y-z=2 \\\\  & z=1\\end{aligned}\n$$" :question/worked-solution "The third equation states that $z=1.$ Substituting this into the second equation, we get\n\n$$\ny-(1)=2\\,⟹\\,y=2+1=3.\n$$\n\nNow, we substitute $z=1$ and $y=3$ into the first equation to get\n\n$$\nx-(3)-(1)=3\\,⟹\\,x=3+4=7.\n$$\n\nThus, the solution is $x=7$,  $y=3$,  and $z=1.$ In vector form, the solution can be written as $⟨7,3,1⟩.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-10199/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b8f8937b-de15-5d4c-aa77-1d45595fc7af"] :knowledge-point/questions ["q-10199"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129452/selection/25e8432820d01f27cfca32677ccf7a0a1dfc6798b80df4530e08b18041826e08" :answer/id #uuid "a31375a6-883e-5051-a742-29eedb120fc9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{15}{2} \\\\ -\\frac{5}{2} \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-129452/selection/02af898ab3b36083ffc4520a24b4642a79faa098d7107f00e9fa1eca4fe44e32" :answer/id #uuid "bd5346a4-ea23-5594-8312-c9e8aea44d71" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{5}{2} \\\\ \\frac{5}{2} \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-129452/selection/974c9d4357e361f29400e41e201cc98110db155b5fef8365bd168ee6064d6341" :answer/id #uuid "3a955797-f60a-5584-919d-01520baa4d35" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{15}{2} \\\\ \\frac{5}{2} \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-129452/selection/bc40b5c803d21cd294e21380677a119814b38108ee2111dc599ff25e30c30de7" :answer/id #uuid "71d7d0c6-68a9-5712-891a-739df23e3015" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{3}{2} \\\\ \\frac{7}{2} \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-129452/selection/4edeb2117650b7119c2fe3055500d2aa4375bb41d4b054f13f86f7b4e06fc1d9" :answer/id #uuid "3d476a05-b478-5bef-89be-a3483c85ae39" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{3}{2} \\\\ -\\frac{5}{2} \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-129452/selection" :answer-field/id #uuid "3f80d039-b214-5111-9821-e8630f15c48e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129452/selection/bc40b5c803d21cd294e21380677a119814b38108ee2111dc599ff25e30c30de7" :answer-field/choices ["q-129452/selection/25e8432820d01f27cfca32677ccf7a0a1dfc6798b80df4530e08b18041826e08" "q-129452/selection/02af898ab3b36083ffc4520a24b4642a79faa098d7107f00e9fa1eca4fe44e32" "q-129452/selection/974c9d4357e361f29400e41e201cc98110db155b5fef8365bd168ee6064d6341" "q-129452/selection/bc40b5c803d21cd294e21380677a119814b38108ee2111dc599ff25e30c30de7" "q-129452/selection/4edeb2117650b7119c2fe3055500d2aa4375bb41d4b054f13f86f7b4e06fc1d9"] :db/ensure [:answer-field/validate]} {:db/id "q-129452" :question/id #uuid "8a0e4715-4168-526b-b47f-345c81075134" :question/math-academy-id "q-129452" :question/problem "Solve the following system of equations:\n    \n\n$$\n{\\begin{aligned} & x+y-z=2 \\\\  & y-z=\\frac{1}{2} \\\\  & z=3\\end{aligned}\n$$" :question/worked-solution "The third equation states that $z=3.$ Substituting this into the second equation, we get\n\n$$\ny-3=\\frac{1}{2}\\,⟹\\,y=\\frac{1}{2}+3=\\frac{7}{2}.\n$$\n\nNow, we substitute $y=\\frac{7}{2}$ and $z=3$ into the first equation to get\n\n$$\nx+\\frac{7}{2}-3=2\\,⟹\\,x=2-\\frac{7}{2}+3=\\frac{3}{2}.\n$$\n\nTherefore, the solution is $x=\\frac{3}{2}$, $y=\\frac{7}{2}$, and $z=3.$ In vector form, the solution can be written as\n$[\\begin{aligned}\\frac{3}{2} \\\\ \\frac{7}{2} \\\\ 3\\end{aligned}].$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-129452/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b8f8937b-de15-5d4c-aa77-1d45595fc7af"] :knowledge-point/questions ["q-129452"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129459/selection/09efc3d8d301ef483f5c8df91d78eb088617dc04e049fca86891da7c8e757976" :answer/id #uuid "28a64c07-1e37-5008-9614-b71485ada7a3" :answer/type :answer.type/math :answer/value "⟨1,12,3⟩" :db/ensure [:answer/validate]} {:db/id "q-129459/selection/69016b87ab74f300b7c2c66388657faed2d2e7a03f2a3f33aa75982726c332f7" :answer/id #uuid "48f920e7-68eb-5ca2-8d90-52212ac5ae19" :answer/type :answer.type/math :answer/value "⟨-22,12,3⟩" :db/ensure [:answer/validate]} {:db/id "q-129459/selection/dea1510543b3c0286498562166bed688578455f71a0bd6b9884a4c2960c59f9b" :answer/id #uuid "467732f5-8683-5df6-8520-cc82d38631c5" :answer/type :answer.type/math :answer/value "⟨-22,-12,3⟩" :db/ensure [:answer/validate]} {:db/id "q-129459/selection/10d4c7c230f47838437f2fd0f6df1e6e8e078b4642b4639ac4bf488068f55170" :answer/id #uuid "18fae80b-6dea-5c12-a1af-d72bc7e5108c" :answer/type :answer.type/math :answer/value "⟨-1,-12,3⟩" :db/ensure [:answer/validate]} {:db/id "q-129459/selection/287e7d5e2c93f101a7a2813b80ea8ffee0551b1e32ac8d6fdc28e8af6f6b38ac" :answer/id #uuid "264949a0-af89-584e-9adf-a8be61d6a1f7" :answer/type :answer.type/math :answer/value "⟨1,-12,3⟩" :db/ensure [:answer/validate]} {:db/id "q-129459/selection" :answer-field/id #uuid "1f63b891-747a-5381-97f9-79b498dc5190" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129459/selection/287e7d5e2c93f101a7a2813b80ea8ffee0551b1e32ac8d6fdc28e8af6f6b38ac" :answer-field/choices ["q-129459/selection/09efc3d8d301ef483f5c8df91d78eb088617dc04e049fca86891da7c8e757976" "q-129459/selection/69016b87ab74f300b7c2c66388657faed2d2e7a03f2a3f33aa75982726c332f7" "q-129459/selection/dea1510543b3c0286498562166bed688578455f71a0bd6b9884a4c2960c59f9b" "q-129459/selection/10d4c7c230f47838437f2fd0f6df1e6e8e078b4642b4639ac4bf488068f55170" "q-129459/selection/287e7d5e2c93f101a7a2813b80ea8ffee0551b1e32ac8d6fdc28e8af6f6b38ac"] :db/ensure [:answer-field/validate]} {:db/id "q-129459" :question/id #uuid "e303c953-d83b-5fd3-b1b2-48ffdf768a6d" :question/math-academy-id "q-129459" :question/problem "Solve the system of equations represented by the augmented matrix \n\n$$\n[\\begin{aligned}1 & 1 & 3 & -2 \\\\ 0 & 1 & 4 & 0 \\\\ 0 & 0 & 1 & 3\\end{aligned}].\n$$" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say, $x$, $y$, and $z.$ We obtain the following system of linear equations:\n\n$$\n{\\begin{aligned} & x+y+3z=-2 \\\\  & y+4z=0 \\\\  & z=3\\end{aligned}\n$$\n\nThe third equation states that $z=3.$ Substituting this into the second equation, we get\n\n$$\ny+4(3)=0\\,⟹\\,y=-12.\n$$\n\nNow, we substitute $z=3$ and $y=-12$ into the first equation to get\n\n$$\nx+(-12)+3(3)=-2\\,⟹\\,x=-2+12-9=1.\n$$\n\nTherefore, the solution is $x=1$, $y=-12$, and $z=3.$ In vector form, the solution can be written as $⟨1,-12,3⟩.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-129459/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "de05090a-2461-514a-971d-b83c7cea124e"] :knowledge-point/questions ["q-129459"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129569/selection/513b730ee09b7de84a4d6cb6a9916d126faa640e1d49cdd8a3d6257ae98a576b" :answer/id #uuid "99568179-759a-5036-8a90-de1cae6320db" :answer/type :answer.type/math :answer/value "⟨7,2,-1⟩" :db/ensure [:answer/validate]} {:db/id "q-129569/selection/474e87b533f632940c88a8a5efe60e808312499440db64a1d523abd520b00a33" :answer/id #uuid "b857276e-b1e0-5673-8dc3-023d455f1e71" :answer/type :answer.type/math :answer/value "⟨7,-4,-1⟩" :db/ensure [:answer/validate]} {:db/id "q-129569/selection/61e1a5c99d39502201d18d6719a974958c3bd1bde43ae3bcff6a9484b0774239" :answer/id #uuid "547c829e-2139-5580-ba1b-56c8e0f8a4ad" :answer/type :answer.type/math :answer/value "⟨11,4,-1⟩" :db/ensure [:answer/validate]} {:db/id "q-129569/selection/5b72a32171c4cdb021ea8dcb2d04b163d7e7797b722ab814e898e367a9c556df" :answer/id #uuid "31d3929d-40e1-5c75-a958-1a6f8b5f4cfc" :answer/type :answer.type/math :answer/value "⟨-5,-4,-1⟩" :db/ensure [:answer/validate]} {:db/id "q-129569/selection/563df5d01ad0567b266104353cde0e14fe7d6c02c514c1b85ff59e4d02f01d13" :answer/id #uuid "94d8d6a9-37b5-5d9c-b143-db45dda31501" :answer/type :answer.type/math :answer/value "⟨11,2,-1⟩" :db/ensure [:answer/validate]} {:db/id "q-129569/selection" :answer-field/id #uuid "32714145-cff6-5187-a015-f39d08c18b4a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129569/selection/61e1a5c99d39502201d18d6719a974958c3bd1bde43ae3bcff6a9484b0774239" :answer-field/choices ["q-129569/selection/513b730ee09b7de84a4d6cb6a9916d126faa640e1d49cdd8a3d6257ae98a576b" "q-129569/selection/474e87b533f632940c88a8a5efe60e808312499440db64a1d523abd520b00a33" "q-129569/selection/61e1a5c99d39502201d18d6719a974958c3bd1bde43ae3bcff6a9484b0774239" "q-129569/selection/5b72a32171c4cdb021ea8dcb2d04b163d7e7797b722ab814e898e367a9c556df" "q-129569/selection/563df5d01ad0567b266104353cde0e14fe7d6c02c514c1b85ff59e4d02f01d13"] :db/ensure [:answer-field/validate]} {:db/id "q-129569" :question/id #uuid "0eaa730f-d0fe-50bd-974e-f7fe25ee9ac0" :question/math-academy-id "q-129569" :question/problem "Solve the system of equations represented by the augmented matrix\n\n$$\n[\\begin{aligned}1 & -2 & 3 & 0 \\\\ 0 & 1 & 1 & 3 \\\\ 0 & 0 & 1 & -1\\end{aligned}].\n$$" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say,  ${x}_{1}$, ${x}_{2}$, and ${x}_{3}.$ We obtain the following system of linear equations:\n\n$$\n{\\begin{aligned} & {x}_{1}-2{x}_{2}+3{x}_{3}=0 \\\\  & {x}_{2}+{x}_{3}=3 \\\\  & {x}_{3}=-1\\end{aligned}\n$$\n\nThe third equation states that ${x}_{3}=-1.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}+(-1)=3\\,⟹\\,{x}_{2}=3+1=4.\n$$\n\nNow, we substitute ${x}_{3}=-1$ and ${x}_{2}=4$ into the first equation to get\n\n$$\n{x}_{1}-2(4)+3(-1)=0\\,⟹\\,{x}_{1}=8+3=11.\n$$\n\nTherefore, the solution is ${x}_{1}=11$, ${x}_{2}=4$, and ${x}_{3}=-1.$ In vector form, the solution can be written as $⟨11,4,-1⟩.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-129569/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "de05090a-2461-514a-971d-b83c7cea124e"] :knowledge-point/questions ["q-129569"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72978/selection/38fc249955de84fc8fbf59f01ef57612034497a7160e63dc37df5815756cf0be" :answer/id #uuid "1a8db00c-9bdd-558f-a610-eb8e0db31f3e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 \\\\ -2 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72978/selection/bd1f43d2bd52a8672f7c5c60d1716d9bc6789f0ddc9c5c8eb3361f757f0d4181" :answer/id #uuid "d3af7ab8-ef27-570c-9735-3b7c2ddc6612" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ -1 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72978/selection/9d1e17d9784da5ae0067ade351923f4b0836785a26b2360fd2d3ae75fb99bcb4" :answer/id #uuid "b1e02ac5-b200-510c-b992-56f824058b21" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ 1 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72978/selection/a0b0c84f7474b29c632359c82fd91876fa5a80fc037da48c563f31aaa7ddc045" :answer/id #uuid "0772fc5c-e315-5830-8cc4-de47bad2cd1b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 \\\\ 1 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72978/selection/78e0e96825141df4bbd7b1f3ef350a2359cec5d37791b3006a38ba21753827ad" :answer/id #uuid "45fc48ab-b908-5066-96ed-b0529967aa5f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 \\\\ 1 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72978/selection" :answer-field/id #uuid "9050c533-c1a6-5967-b42d-a8a454ee3269" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72978/selection/bd1f43d2bd52a8672f7c5c60d1716d9bc6789f0ddc9c5c8eb3361f757f0d4181" :answer-field/choices ["q-72978/selection/38fc249955de84fc8fbf59f01ef57612034497a7160e63dc37df5815756cf0be" "q-72978/selection/bd1f43d2bd52a8672f7c5c60d1716d9bc6789f0ddc9c5c8eb3361f757f0d4181" "q-72978/selection/9d1e17d9784da5ae0067ade351923f4b0836785a26b2360fd2d3ae75fb99bcb4" "q-72978/selection/a0b0c84f7474b29c632359c82fd91876fa5a80fc037da48c563f31aaa7ddc045" "q-72978/selection/78e0e96825141df4bbd7b1f3ef350a2359cec5d37791b3006a38ba21753827ad"] :db/ensure [:answer-field/validate]} {:db/id "q-72978" :question/id #uuid "cadceb90-b589-55eb-81c2-7bb7de4f1a06" :question/math-academy-id "q-72978" :question/problem "Solve the system of equations represented by the augmented matrix\n\n$$\n[\\begin{aligned}1 & 1 & 4 & -3 \\\\ 0 & 1 & 3 & -4 \\\\ 0 & 0 & 1 & -1\\end{aligned}].\n$$" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say,  ${x}_{1}$, ${x}_{2}$, and ${x}_{3}.$ We obtain the following system of linear equations:\n\n$$\n{\\begin{aligned} & {x}_{1}+{x}_{2}+4{x}_{3}=-3 \\\\  & {x}_{2}+3{x}_{3}=-4 \\\\  & {x}_{3}=-1\\end{aligned}\n$$\n\nThe third equation states that  ${x}_{3}=-1.$ Substituting this into the second equation,  we get\n\n$$\n{x}_{2}+3(-1)=-4\\,⟹\\,{x}_{2}=-4+3=-1.\n$$\n\nNow, we substitute ${x}_{3}=-1$ and ${x}_{2}=-1$ into the first equation to get\n\n$$\n{x}_{1}+(-1)+4(-1)=-3\\,⟹\\,{x}_{1}=-3+1+4=2.\n$$\n\nTherefore, the solution is ${x}_{1}=2$, ${x}_{2}=-1$, and ${x}_{3}=-1.$ In vector form, the solution can be written as\n$[\\begin{aligned}2 \\\\ -1 \\\\ -1\\end{aligned}].$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-72978/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "de05090a-2461-514a-971d-b83c7cea124e"] :knowledge-point/questions ["q-72978"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129599/selection/6d386a5ed68f5376776b105804b26b636d9b9ea677546e212757ec6015077447" :answer/id #uuid "d3dd163c-b4e2-5d8c-8be9-72d600368503" :answer/type :answer.type/math :answer/value "⟨-14,-7,3⟩" :db/ensure [:answer/validate]} {:db/id "q-129599/selection/63ce766f38137a658e6cc9b40c171061eeb9813bc4310daaba197f61f9705a86" :answer/id #uuid "f037ea77-52d5-56a3-931c-215f425627df" :answer/type :answer.type/math :answer/value "⟨0,7,3⟩" :db/ensure [:answer/validate]} {:db/id "q-129599/selection/5f89dc97ece6dee0df5423d9496690d885396be2a3ed8ec745d66df5834651c9" :answer/id #uuid "c4dad004-aa19-56f3-89ea-60e4cd24d8b5" :answer/type :answer.type/math :answer/value "⟨0,-7,3⟩" :db/ensure [:answer/validate]} {:db/id "q-129599/selection/fbc8f125714d58fb77d580565f501a74ed0011b2424c005937002d3a543c0573" :answer/id #uuid "77a84be8-010b-5f74-b393-7b42bc5eb19d" :answer/type :answer.type/math :answer/value "⟨4,-11,3⟩" :db/ensure [:answer/validate]} {:db/id "q-129599/selection/cf8d06326fb2db8977fd7f470ca560a1a7117ad633287c11c90550ab3ba82009" :answer/id #uuid "a5be449