answer-field/validate]} {:db/id "q-72972" :question/id #uuid "8ab8c60d-5430-57fc-a283-bc3692f237cc" :question/math-academy-id "q-72972" :question/problem "Solve the system of equations represented by the augmented matrix \n\n$$\n[\\begin{aligned}1 & 2 & 1 & -8 \\\\ 0 & 1 & 2 & -1 \\\\ 0 & 0 & 1 & 2\\end{aligned}].\n$$" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say, $x$, $y$, and $z.$ We obtain the following system of linear equations:\n\n$$\n{\\begin{aligned} & x+2y+z=-8 \\\\  & y+2z=-1 \\\\  & z=2\\end{aligned}\n$$\n\nThe third equation states that $z=2.$ Substituting this into the second equation, we get\n\n$$\ny+2(2)=-1\\,⟹\\,y=-1-4=-5.\n$$\n\nNow, we substitute $z=2$ and $y=-5$ into the first equation to get\n\n$$\nx+2(-5)+(2)=-8\\,⟹\\,x=-8+10-2=0.\n$$\n\nTherefore, the solution is $x=0$, $y=-5$, and $z=2.$ In vector form, the solution can be written as $⟨0,-5,2⟩.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-72972/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "de05090a-2461-514a-971d-b83c7cea124e"] :knowledge-point/questions ["q-72972"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129615/selection/266add342849b844a7c1eb9dfc75c6bc948aca33c0531d70200b26ff180f7c39" :answer/id #uuid "4bf3ff45-c8a5-5493-b4a8-f5463a6bd2ee" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-8 \\\\ -1 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-129615/selection/58193d60f2539cfc30bdfe45ccbd1ca140d96c2b9218933f091b67cb82928c29" :answer/id #uuid "2f8a3db6-c440-5bf6-ae84-805d076130e8" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-30 \\\\ 5 \\\\ 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-129615/selection/f6c09541856ef952752ef3c391f1d532a2bd429b6f1ac98aac8336782936a4bb" :answer/id #uuid "72f8e646-aefa-573f-bb99-790398bb6c3e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ 5 \\\\ 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-129615/selection/ab323100515a17d4d726049ef3ed20665e64c0c8fd021489d10f1996f297d9cd" :answer/id #uuid "be25d5a3-63a1-589a-8d12-f5b0c73b490f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-8 \\\\ 1 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-129615/selection/2510a3241ddb528e10e21b59d7837aa92aa4a577bbc545fb6b7d9214aa86bd40" :answer/id #uuid "dd95bf8e-829a-55b9-89e9-a0d8d899ca04" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ -1 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-129615/selection" :answer-field/id #uuid "4bdbcdf0-b3ed-5eda-9596-47f9c1d7f98d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129615/selection/2510a3241ddb528e10e21b59d7837aa92aa4a577bbc545fb6b7d9214aa86bd40" :answer-field/choices ["q-129615/selection/266add342849b844a7c1eb9dfc75c6bc948aca33c0531d70200b26ff180f7c39" "q-129615/selection/58193d60f2539cfc30bdfe45ccbd1ca140d96c2b9218933f091b67cb82928c29" "q-129615/selection/f6c09541856ef952752ef3c391f1d532a2bd429b6f1ac98aac8336782936a4bb" "q-129615/selection/ab323100515a17d4d726049ef3ed20665e64c0c8fd021489d10f1996f297d9cd" "q-129615/selection/2510a3241ddb528e10e21b59d7837aa92aa4a577bbc545fb6b7d9214aa86bd40"] :db/ensure [:answer-field/validate]} {:db/id "q-129615" :question/id #uuid "8c43eaff-6e8a-54f3-9041-509e363b9890" :question/math-academy-id "q-129615" :question/problem "Solve the following system of equations:\n\n$$\n{\\begin{aligned} & {x}_{1}+5{x}_{2}+{x}_{3}=-1 \\\\  & -{x}_{2}+3{x}_{3}=7 \\\\  & 2{x}_{3}=4\\end{aligned}\n$$" :question/worked-solution "The third equation states that \n\n$$\n2{x}_{3}=4\\,⟹\\,{x}_{3}=2.\n$$\n\n Substituting this into the second equation, we get\n\n$$\n-{x}_{2}+3(2)=7\\,⟹\\,{x}_{2}=6-7=-1.\n$$\n\nNow, we substitute ${x}_{3}=2$ and ${x}_{2}=-1$ into the first equation to get\n\n$$\n{x}_{1}+5(-1)+(2)=-1\\,⟹\\,{x}_{1}=-1+5-2=2.\n$$\n\nTherefore, the solution is \n${x}_{1}=2$, ${x}_{2}=-1$, and ${x}_{3}=2.$  In vector form, the solution can be written as $[\\begin{aligned}2 \\\\ -1 \\\\ 2\\end{aligned}].$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-129615/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "52e51c9a-6bce-5ea6-a9fe-febb09f8754d"] :knowledge-point/questions ["q-129615"] :db/ensure [:knowledge-point/validate]} {:db/id "q-10203/selection/107d4e3615bafb5e00a444f0c3b0a8a4bd61c1895cf4063d66848480ac413118" :answer/id #uuid "aa116539-a226-5200-9cb2-c11a3659577b" :answer/type :answer.type/math :answer/value "⟨2,-2,0⟩" :db/ensure [:answer/validate]} {:db/id "q-10203/selection/aa3ff83b8a1f1cf3a730026b6043228db7130af4209594135971571193be91de" :answer/id #uuid "cbf4b6b5-bc24-5f6d-b9f5-7ecf4966ace1" :answer/type :answer.type/math :answer/value "⟨2,-1,0⟩" :db/ensure [:answer/validate]} {:db/id "q-10203/selection/0c9ab9ea4f0e60f3c434e46ab61c51107ee020f0f0ef12f8c8796aff5d5d0b21" :answer/id #uuid "aa53efee-83ce-5308-9161-139ad9390047" :answer/type :answer.type/math :answer/value "⟨3,-1,0⟩" :db/ensure [:answer/validate]} {:db/id "q-10203/selection/7e9349a85f80d24766f27b330571dfa1e2070f5c012d75a6f965ee71f92c16a6" :answer/id #uuid "4d4d3fa8-869f-5a4f-b976-dfd62a77f30d" :answer/type :answer.type/math :answer/value "⟨0,1,-8⟩" :db/ensure [:answer/validate]} {:db/id "q-10203/selection/cb0ce83b4ab36dae6cc9d5321d6e3545b2b4243d1015e3d6ebd78130b8ae74c1" :answer/id #uuid "848de5e7-387e-5d76-a00a-a3a0e44658d8" :answer/type :answer.type/math :answer/value "⟨0,-1,8⟩" :db/ensure [:answer/validate]} {:db/id "q-10203/selection" :answer-field/id #uuid "63515660-8cda-56ff-ae25-8ef09026bdd0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-10203/selection/0c9ab9ea4f0e60f3c434e46ab61c51107ee020f0f0ef12f8c8796aff5d5d0b21" :answer-field/choices ["q-10203/selection/107d4e3615bafb5e00a444f0c3b0a8a4bd61c1895cf4063d66848480ac413118" "q-10203/selection/aa3ff83b8a1f1cf3a730026b6043228db7130af4209594135971571193be91de" "q-10203/selection/0c9ab9ea4f0e60f3c434e46ab61c51107ee020f0f0ef12f8c8796aff5d5d0b21" "q-10203/selection/7e9349a85f80d24766f27b330571dfa1e2070f5c012d75a6f965ee71f92c16a6" "q-10203/selection/cb0ce83b4ab36dae6cc9d5321d6e3545b2b4243d1015e3d6ebd78130b8ae74c1"] :db/ensure [:answer-field/validate]} {:db/id "q-10203" :question/id #uuid "c7e4218f-47e8-518f-8a12-cc5cea874766" :question/math-academy-id "q-10203" :question/problem "Solve the system of equations represented by the augmented matrix\n\n$$\n[\\begin{aligned}2 & -2 & 1 & 8 \\\\ 0 & 1 & -1 & -1 \\\\ 0 & 0 & 1 & 0\\end{aligned}].\n$$" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say, $x$, $y$, and $z.$ We obtain the following system of linear equations:\n\n$$\n{\\begin{aligned} & 2x-2y+z=8 \\\\  & y-z=-1 \\\\  & z=0\\end{aligned}\n$$\n\nThe third equation states that $z=0.$ Substituting this into the second equation, we get\n\n$$\ny-0=-1\\,⟹\\,y=-1.\n$$\n\nNow, we substitute $z=0$ and $y=-1$ into the first equation to get\n\n$$\n2x-2(-1)+(0)=8\\,⟹\\,x=\\frac{8-2}{2}=3.\n$$\n\nTherefore, the solution is $x=3$, $y=-1$, and $z=0.$ In vector form, the solution can be written as $⟨3,-1,0⟩.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-10203/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "52e51c9a-6bce-5ea6-a9fe-febb09f8754d"] :knowledge-point/questions ["q-10203"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72980/selection/9f056fe26622b6e90d4c80b21e5982b0fa254e30b23723e7b3d3d2a8405cd00a" :answer/id #uuid "499125a6-45eb-51c6-a59d-4a00033ac533" :answer/type :answer.type/math :answer/value "⟨1,-3,3⟩" :db/ensure [:answer/validate]} {:db/id "q-72980/selection/e7c349a03e9f6fdff2554f2d62de0a201f326ba5c6dc6bd1bbb73eb3ec166c6b" :answer/id #uuid "0b6f5e3b-de33-5b71-aefa-ddead7c1603a" :answer/type :answer.type/math :answer/value "⟨1,3,-3⟩" :db/ensure [:answer/validate]} {:db/id "q-72980/selection/689f1f17ee76f3020ee57f42cba2a2b3e0002108c871c495c179b8bddcc6d6d9" :answer/id #uuid "37fabebe-4aac-5c89-aa6c-173d855f3d37" :answer/type :answer.type/math :answer/value "⟨4,-3,3⟩" :db/ensure [:answer/validate]} {:db/id "q-72980/selection/45e1e6abb4c57f66e7d524d8f97ea54d16c44c8a0f27c93725a0d4b709171704" :answer/id #uuid "4b02f1c1-08b2-510e-8e1f-64f312f89d07" :answer/type :answer.type/math :answer/value "⟨3,4,-3⟩" :db/ensure [:answer/validate]} {:db/id "q-72980/selection/cb09f48019d322a8f0d4fdb293364978df220dac63a627269e41a68e2b37dbbd" :answer/id #uuid "1d616cc2-cfac-5774-a7cc-cab8e41e4940" :answer/type :answer.type/math :answer/value "⟨2,-4,3⟩" :db/ensure [:answer/validate]} {:db/id "q-72980/selection" :answer-field/id #uuid "614a3b60-e86f-5567-923f-e609ab89f646" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72980/selection/689f1f17ee76f3020ee57f42cba2a2b3e0002108c871c495c179b8bddcc6d6d9" :answer-field/choices ["q-72980/selection/9f056fe26622b6e90d4c80b21e5982b0fa254e30b23723e7b3d3d2a8405cd00a" "q-72980/selection/e7c349a03e9f6fdff2554f2d62de0a201f326ba5c6dc6bd1bbb73eb3ec166c6b" "q-72980/selection/689f1f17ee76f3020ee57f42cba2a2b3e0002108c871c495c179b8bddcc6d6d9" "q-72980/selection/45e1e6abb4c57f66e7d524d8f97ea54d16c44c8a0f27c93725a0d4b709171704" "q-72980/selection/cb09f48019d322a8f0d4fdb293364978df220dac63a627269e41a68e2b37dbbd"] :db/ensure [:answer-field/validate]} {:db/id "q-72980" :question/id #uuid "3ee944c9-4b43-5da0-ab41-c5200c36245b" :question/math-academy-id "q-72980" :question/problem "Solve the following system of equations:\n\n$$\n{\\begin{aligned} & 2x+y-z=2 \\\\  & y+3z=6 \\\\  & -z=-3\\end{aligned}\n$$" :question/worked-solution "The third equation states that\n\n$$\n-z=-3\\,⟹\\,z=3.\n$$\n\nSubstituting this into the second equation, we get\n\n$$\ny+3(3)=6\\,⟹\\,y=6-9=-3.\n$$\n\nNow, we substitute $z=3$ and $y=-3$ into the first equation to get \n\n$$\n2x+(-3)-(3)=2\\,⟹\\,x=\\frac{1}{2}(2+3+3)=4.\n$$\n\nTherefore, the solution is $x=4$, $y=-3$ and $z=3.$ In vector form, the solution can be written as $⟨4,-3,3⟩.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-72980/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "52e51c9a-6bce-5ea6-a9fe-febb09f8754d"] :knowledge-point/questions ["q-72980"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-10204"] :question/problem "Solve the following system of equations:\n\n$$\n{\\begin{aligned} & x+2y-z=10 \\\\  & y+5z=15 \\\\  & -z=5\\end{aligned}\n$$" :question/worked-solution "The third equation states that \n\n$$\n-z=5\\,⟹\\,z=-5.\n$$\n\nSubstituting this into the second equation, we get\n\n$$\ny+5(-5)=15\\,⟹\\,y=15+25=40.\n$$\n\nNow, we substitute $z=-5$ and $y=40$ into the first equation to get\n\n$$\nx+2(40)-(-5)=10\\,⟹\\,x=10-80-5=-75.\n$$\n\nTherefore, the solution is $x=-75,y=40$ and $z=-5.$ In vector form, the solution can be written as $⟨-75,40,-5⟩.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-72981/selection/1c629f40f8aaa99efb3c7115fb6f609d0792119901021c541568423123369fa8" :answer/id #uuid "1f457b3a-0152-50e2-8a41-4a037ce038ec" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 \\\\ 4 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72981/selection/242774710dcfb10f1ae7da84656837f11b58944aa1f36cf6952c95ed9edc3106" :answer/id #uuid "9cc151f6-e1ea-522c-bf33-e362ba3eb24f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ 1 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72981/selection/f99caa9c83647598622afafa9e59e9bc105a4cf4c5acb3ae4eadc71872e93814" :answer/id #uuid "f5e47b5b-ca91-593c-b2dd-65beb434984b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ 1 \\\\ -4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72981/selection/b30ff6e8c1a7e901998b3e70bae8840c30dfad63f87b10bb05038b7bb3dbb0e5" :answer/id #uuid "db28743f-692a-54d1-ab07-b7d5c103e0a1" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 \\\\ 1 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72981/selection/43b735ee6e410bfa2832737976b127a2008857d151a2ba7b09a5138bdb2310ec" :answer/id #uuid "08a6391a-012b-5b5c-9204-ac55f6ae0c02" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ 2 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72981/selection" :answer-field/id #uuid "c4583fae-dac3-5c1c-ae90-1949b18bda67" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72981/selection/b30ff6e8c1a7e901998b3e70bae8840c30dfad63f87b10bb05038b7bb3dbb0e5" :answer-field/choices ["q-72981/selection/1c629f40f8aaa99efb3c7115fb6f609d0792119901021c541568423123369fa8" "q-72981/selection/242774710dcfb10f1ae7da84656837f11b58944aa1f36cf6952c95ed9edc3106" "q-72981/selection/f99caa9c83647598622afafa9e59e9bc105a4cf4c5acb3ae4eadc71872e93814" "q-72981/selection/b30ff6e8c1a7e901998b3e70bae8840c30dfad63f87b10bb05038b7bb3dbb0e5" "q-72981/selection/43b735ee6e410bfa2832737976b127a2008857d151a2ba7b09a5138bdb2310ec"] :db/ensure [:answer-field/validate]} {:db/id "q-72981" :question/id #uuid "c67fc178-cf1a-54db-8b4d-208b21f2bc23" :question/math-academy-id "q-72981" :question/problem "Solve the system of equations represented by the augmented matrix: \n\n$$\n[\\begin{aligned}1 & 0 & 1 & 2 \\\\ 0 & 3 & 2 & -1 \\\\ 0 & 0 & -1 & 2\\end{aligned}].\n$$" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say, $x$, $y$, and $z.$ We obtain the following system of linear equations: \n\n$$\n{\\begin{aligned} & x+z=2 \\\\  & 3y+2z=-1 \\\\  & -z=2\\end{aligned}\n$$\n\nThe third equation states that\n\n$$\n-z=2\\,⟹\\,z=-2.\n$$\n\nSubstituting this into the second equation, we get\n\n$$\n3y+2(-2)=-1\\,⟹\\,y=\\frac{1}{3}(-1+4)=1.\n$$\n\nNow, we substitute $z=-2$ and $y=1$ into the first equation to get\n\n$$\nx+(-2)=2\\,⟹\\,x=2+2=4.\n$$\n\nTherefore, the solution is $x=4$, $y=1$, and $z=-2.$ In vector form, the solution can be written as \n$[\\begin{aligned}4 \\\\ 1 \\\\ -2\\end{aligned}].$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-72981/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "52e51c9a-6bce-5ea6-a9fe-febb09f8754d"] :knowledge-point/questions ["q-72981"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-4690"] :question/problem "Solve the following system of equations:\n\n$$\n\\begin{aligned}x+y+z=3 \\\\ y+z=2 \\\\ z=2\\end{aligned}\n$$" :question/worked-solution "The third equation states that $z=2.$ Substituting this into the second equation, we get\n\n$$\ny+(2)=2 \n\t\\qquad\\Longrightarrow\\qquad\n\ty = 2-2 = 0.\n$$\n\nNow, we substitute both $z=2$ and $y=0$ into the first equation to get\n\n$$\nx+(0)+(2)=3\n\t\\qquad\\Longrightarrow\\qquad\n\tx = 3-2 = 1.\n$$\n\nTherefore, the solution is $x = 1,$ $y=0,$ and $z = 2.$ Or, in vector form, the solution is $\\langle 1,0,2 \\rangle.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4691"] :question/problem "Solve the system of equations that is represented by the augmented matrix\n\n$$\n\\begin{aligned}1 & 1 & -1 & 1 \\\\ 0 & 1 & 1 & -2 \\\\ 0 & 0 & 1 & 5\\end{aligned}\n$$" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say, $x_1,$ $x_2,$ and $x_3.$ We obtain the following system of linear equations:\n\n$$\n\\begin{aligned}{x}_{1}+{x}_{2}-{x}_{3}=1 \\\\ {x}_{2}+{x}_{3}=-2 \\\\ {x}_{3}=5\\end{aligned}\n$$\n\nThe third equation states that $x_3=5.$ Substituting this into the second equation, we get\n\n$$\nx_2+(5)=-2\n\t\\qquad\\Longrightarrow\\qquad\n\tx_2=-2-5=-7.\n$$\n\nNow, we substitute both $x_3 = 5$ and $x_2 = -7$ into the first equation to get\n\n$$\nx_1+(-7)-(5) = 1\n\t\\qquad\\Longrightarrow\\qquad\n\tx_1 = 1 + 7 + 5 = 13.\n$$\n\nTherefore, the solution is $x_1 = 13,$ $x_2=-7,$ and $x_3 = 5.$ Or, in vector form, the solution is $\\langle 13,-7,5 \\rangle.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4692"] :question/problem "Solve the system of equations that is represented by the augmented matrix\n\n$$\n\\begin{aligned}2 & 1 & -1 & 0 \\\\ 0 & 1 & 1 & -2 \\\\ 0 & 0 & 3 & 3\\end{aligned}\n$$" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say, $x_1,$ $x_2,$ and $x_3.$ We obtain the following system of linear equations:\n\n$$\n\\begin{aligned}2{x}_{1}+{x}_{2}-{x}_{3}=0 \\\\ {x}_{2}+{x}_{3}=-2 \\\\ 3{x}_{3}=3\\end{aligned}\n$$\n\nThe third equation states that\n\n$$\n3x_3=3 \n\t\\qquad\\Longrightarrow\\qquad \n\tx_3=1.\n$$\n\nSubstituting this into the second equation, we get\n\n$$\nx_2+(1)=-2\n\t\\qquad\\Longrightarrow\\qquad\n\tx_2=-2-1=-3.\n$$\n\nNow, we substitute both $x_3 = 1$ and $x_2 = -3$ into the first equation to get\n\n$$\n2x_1+(-3)-(1) = 0\n\t\\qquad\\Longrightarrow\\qquad\n\tx_1 = \\dfrac{1}{2} (3 + 1) = 2.\n$$\n\nTherefore, the solution is $x_1 = 2,$ $x_2=-3,$ and $x_3 = 1.$ Or, in vector form, the solution is $\\langle 2,-3,1 \\rangle.$" :db/ensure [:question/validate]}]
