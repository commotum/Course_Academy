efc3-9f36-58cd-8661-fa04801b6e5a" :answer/value "9x-3"] ["answer-field-54fc702b-edd1-54aa-8ad1-69534578dde9" :answer-field/key "selection"] ["answer-field-54fc702b-edd1-54aa-8ad1-69534578dde9" :answer-field/type :answer-field.type/radio] ["answer-field-54fc702b-edd1-54aa-8ad1-69534578dde9" :answer-field/correct "answer-9bdf722e-820e-5637-ba90-106a58a4e7cf"] ["answer-field-54fc702b-edd1-54aa-8ad1-69534578dde9" :answer-field/choices "answer-5239f06a-9c88-5796-bad4-dd01e0598425"] ["answer-field-54fc702b-edd1-54aa-8ad1-69534578dde9" :answer-field/choices "answer-828b3fdb-edff-5b38-88e4-936da5ad6e9d"] ["answer-field-54fc702b-edd1-54aa-8ad1-69534578dde9" :answer-field/choices "answer-9bdf722e-820e-5637-ba90-106a58a4e7cf"] ["answer-field-54fc702b-edd1-54aa-8ad1-69534578dde9" :answer-field/choices "answer-262707e8-a17c-59ce-971e-969d38b738cd"] ["answer-field-54fc702b-edd1-54aa-8ad1-69534578dde9" :answer-field/choices "answer-80d1efc3-9f36-58cd-8661-fa04801b6e5a"] [17592186233078 :question/answer-fields "answer-field-54fc702b-edd1-54aa-8ad1-69534578dde9"] ["question-5eb05574-37e3-55ae-bfb9-7d07106c577c" :question/id #uuid "5eb05574-37e3-55ae-bfb9-7d07106c577c"] ["question-5eb05574-37e3-55ae-bfb9-7d07106c577c" :question/math-academy-id "q-160571"] ["question-5eb05574-37e3-55ae-bfb9-7d07106c577c" :question/problem "What is the distance between the points $(-3,-2)$  and $(-3,-7)?$"] ["question-5eb05574-37e3-55ae-bfb9-7d07106c577c" :question/worked-solution "**Method 1** \n\nWe plot the given points in the coordinate plane.\n\n![](images/fa/fa516432771fd242ed51ba8548dd04ca88991fc14992be811a53f8e124b9ff7d.png)\n\nThe distance between two points is the length of the line segment that connects them.\n\nFrom the diagram, we see that the length of the segment is $5$ units, so the distance equals $5.$\n\n![](images/99/999cdc70474e5b928b28d611d4c66fb3eeea5716f516af41574712337cb6f9e9.png)\n\n**Method 2**\n\nWe can find the distance between the two points by finding the distance of each point from the $x$-axis and then subtracting.\n\n![](images/91/91bd9f4cd88e966b796f97184eee8aa791e2f20301ff700906ded4d4731eaaf7.png)\n\nThe point $(-3,-7)$ is at a distance of $7$ from the $x$-axis, and the point $(-3,-2)$ is at a distance of $2$ from the $x$-axis. Therefore, the distance between the two points is $7-2=5.$"] ["question-5eb05574-37e3-55ae-bfb9-7d07106c577c" :question/difficulty :question.difficulty/easy] ["answer-field-add93cc1-1ee0-532a-8ce2-54ed8f5fbdab" :answer-field/id #uuid "add93cc1-1ee0-532a-8ce2-54ed8f5fbdab"] ["answer-c7ea6629-a518-5ad2-a4e0-fa65bbb22766" :answer/id #uuid "c7ea6629-a518-5ad2-a4e0-fa65bbb22766"] ["answer-c7ea6629-a518-5ad2-a4e0-fa65bbb22766" :answer/type :answer.type/math] ["answer-c7ea6629-a518-5ad2-a4e0-fa65bbb22766" :answer/value "3"] ["answer-6ec6fdb1-0f32-56ac-9952-f5cc890af556" :answer/id #uuid "6ec6fdb1-0f32-56ac-9952-f5cc890af556"] ["answer-6ec6fdb1-0f32-56ac-9952-f5cc890af556" :answer/type :answer.type/math] ["answer-6ec6fdb1-0f32-56ac-9952-f5cc890af556" :answer/value "4"] ["answer-04640621-f02a-52d2-815f-5bc639b2de01" :answer/id #uuid "04640621-f02a-52d2-815f-5bc639b2de01"] ["answer-04640621-f02a-52d2-815f-5bc639b2de01" :answer/type :answer.type/math] ["answer-04640621-f02a-52d2-815f-5bc639b2de01" :answer/value "5"] ["answer-5682a8f0-9627-5c70-87ea-7d47bc48f253" :answer/id #uuid "5682a8f0-9627-5c70-87ea-7d47bc48f253"] ["answer-5682a8f0-9627-5c70-87ea-7d47bc48f253" :answer/type :answer.type/math] ["answer-5682a8f0-9627-5c70-87ea-7d47bc48f253" :answer/value "6"] ["answer-20b16185-d12a-5e60-bcb5-5871047f9569" :answer/id #uuid "20b16185-d12a-5e60-bcb5-5871047f9569"] ["answer-20b16185-d12a-5e60-bcb5-5871047f9569" :answer/type :answer.type/math] ["answer-20b16185-d12a-5e60-bcb5-5871047f9569" :answer/value "7"] ["answer-field-add93cc1-1ee0-532a-8ce2-54ed8f5fbdab" :answer-field/key "selection"] ["answer-field-add93cc1-1ee0-532a-8ce2-54ed8f5fbdab" :answer-field/type :answer-field.type/radio] ["answer-field-add93cc1-1ee0-532a-8ce2-54ed8f5fbdab" :answer-field/correct "answer-04640621-f02a-52d2-815f-5bc639b2de01"] ["answer-field-add93cc1-1ee0-532a-8ce2-54ed8f5fbdab" :answer-field/choices "answer-c7ea6629-a518-5ad2-a4e0-fa65bbb22766"] ["answer-field-add93cc1-1ee0-532a-8ce2-54ed8f5fbdab" :answer-field/choices "answer-6ec6fdb1-0f32-56ac-9952-f5cc890af556"] ["answer-field-add93cc1-1ee0-532a-8ce2-54ed8f5fbdab" :answer-field/choices "answer-04640621-f02a-52d2-815f-5bc639b2de01"] ["answer-field-add93cc1-1ee0-532a-8ce2-54ed8f5fbdab" :answer-field/choices "answer-5682a8f0-9627-5c70-87ea-7d47bc48f253"] ["answer-field-add93cc1-1ee0-532a-8ce2-54ed8f5fbdab" :answer-field/choices "answer-20b16185-d12a-5e60-bcb5-5871047f9569"] ["question-5eb05574-37e3-55ae-bfb9-7d07106c577c" :question/answer-fields "answer-field-add93cc1-1ee0-532a-8ce2-54ed8f5fbdab"] [17592186073899 :knowledge-point/questions "question-5eb05574-37e3-55ae-bfb9-7d07106c577c"] ["question-d99374cc-b8d8-56af-8d1d-9419fba84ed0" :question/id #uuid "d99374cc-b8d8-56af-8d1d-9419fba84ed0"] ["question-d99374cc-b8d8-56af-8d1d-9419fba84ed0" :question/math-academy-id "q-162123"] ["question-d99374cc-b8d8-56af-8d1d-9419fba84ed0" :question/problem "What is the missing part of the expression below?\n\n$$\n-\\frac{9}{2}=\\frac{\\bbox[1pt,border:1pt solid black]{\\phantom{A}}}{2}\n$$"] ["question-d99374cc-b8d8-56af-8d1d-9419fba84ed0" :question/worked-solution "A negative number can be obtained if we divide two numbers, one of which is positive and the other negative.\n\nSo, given a negative fraction, we have the following equivalent notations:\n\n$$\n-\\frac{9}{2}=\\frac{-9}{2}=\\frac{9}{-2}\n$$\n\nIn our case, we see that the denominator on the right-hand side is positive $(2).$ Therefore, the missing numerator must be $(-9):$\n\n$$\n-\\frac{9}{2}=\\frac{-9}{2}\n$$"] ["question-d99374cc-b8d8-56af-8d1d-9419fba84ed0" :question/difficulty :question.difficulty/easy] ["answer-field-0459262a-2257-5a6c-8f05-5a7eb2664614" :answer-field/id #uuid "0459262a-2257-5a6