34129}} {:db/id #edb/ref 17592186534129 :step/content {:db/id #edb/ref 17592186534026 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fd76159-2140-5346-98a1-4afe816c2e3d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186533332} {:answer/id #uuid "a62ca124-9da6-5b38-bae4-21401dc99670" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{25}{8}" :db/id #edb/ref 17592186533540} {:answer/id #uuid "df606574-cd00-549e-b533-e130e89eaadb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{16}" :db/id #edb/ref 17592186533691} {:answer/id #uuid "e8be0511-cfcd-558e-ab87-0f2fcf576a90" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{25}{4}" :db/id #edb/ref 17592186533711} {:answer/id #uuid "eb0bdda5-9a04-5aae-a0c0-3728d75cd1ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186533720}] :answer-field/correct {:db/id #edb/ref 17592186533332} :answer-field/id #uuid "406ab344-f9fd-5033-9ed9-b2f83ded5ae0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186533832}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7fc0fee8-5d8f-576c-8b1d-3594d43c9abb" :question/math-academy-id "q-44083" :question/problem "$\\sqrt[3]{\\frac{125}{64}}=$" :question/worked-solution "First, notice that the numbers $125$ and $64$ are both perfect cubes. \n\nSo, to determine the value of $\\sqrt[3]{\\frac{125}{64}},$ we express $\\frac{125}{64}$ as a perfect cube:\n\n$$\n\\begin{aligned}\\sqrt[3]{\\frac{125}{64}} & = \\\\ \\sqrt[3]{\\frac{{5}^{3}}{{4}^{3}}} & = \\\\ \\sqrt[3]{\\frac{5\\cdot 5\\cdot 5}{4\\cdot 4\\cdot 4}} & = \\\\ \\sqrt[3]{\\frac{5}{4}\\cdot \\frac{5}{4}\\cdot \\frac{5}{4}} & = \\\\ \\sqrt[3]{{(\\frac{5}{4})}^{3}} & = \\\\ \\frac{5}{4} & \\end{aligned}\n$$"} :step/id #uuid "646a95eb-3d50-5de4-b371-82aed596236d" :step/next {:db/id #edb/ref 17592186534154}} {:db/id #edb/ref 17592186534154 :step/content {:db/id #edb/ref 17592186534043 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39a10731-5fc5-5806-9d35-87c5df736739" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "49" :db/id #edb/ref 17592186533273} {:answer/id #uuid "3e32be5a-ab1f-58fc-8cd8-39d0fdebf2af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "343" :db/id #edb/ref 17592186533283} {:answer/id #uuid "6b798186-aa8c-5b3b-91a6-72f60d4af904" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186533390} {:answer/id #uuid "8346c2e4-3159-519a-933c-ed33451c4b6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7" :db/id #edb/ref 17592186533448} {:answer/id #uuid "9b467886-d4bd-53f1-975f-d7a82a45d740" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-343" :db/id #edb/ref 17592186533516}] :answer-field/correct {:db/id #edb/ref 17592186533516} :answer-field/id #uuid "69802b94-6643-58fc-ad81-08af38307602" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186533864}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a6550081-06ce-5fdd-8f86-5cb7f9262731" :question/math-academy-id "q-71502" :question/problem "$(\\sqrt[3]{-343})^{3}=$" :question/worked-solution "The cube and the cube root cancel each other out. So, we have\n\n$$\n(\\sqrt[3]{-343})^{3}=-343.\n$$"} :step/id #uuid "e9d03a39-8b21-5275-aa96-f0cc96d800f3"}] :activity/title "The Cube Root of a Perfect Cube" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186533123}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186065135} :activity/id #uuid "457bb695-c5a7-5c4b-bc54-87bb84576ab7" :activity/scope {:db/id #edb/ref 17592186048957 :topic/id #uuid "cf262221-31bc-5e58-a6f2-8acf1c2b4906" :topic/math-academy-id 355} :activity/steps [{:db/id #edb/ref 17592186065135 :step/content {:db/id #edb/ref 17592186065367 :tutorial/content "Fractions that contain multiple terms in the numerator and a single term in the denominator can be split into separate terms.\n\nFor example, \n\n$$\n\\eqalign{\n\t\t\\dfrac {x + 2} {3} &= \\\n\t\t\\dfrac x 3 + \\dfrac 2 3\n\t}\n$$\n\nand\n\n$$\n\\eqalign{\n\t\t\\dfrac {3a - 4b + 1} {5} &= \\\n\t\t\\dfrac {3a} 5 - \\dfrac {4b} 5 + \\dfrac 1 5.\n\t}\n$$\n\nOften, we're able to simplify the fractions in the individual terms, as follows:\n\n$$\n\\eqalign{\n\t\t\\dfrac {10x + 9} {2} &= \\\n\t\t\\dfrac {10x} {2} + \\dfrac 9 2 &= \\\n\t\t\\dfrac {10} {2} \\cdot x + \\dfrac 9 2 &= \\\t\n\t\t5 \\cdot x + \\dfrac 9 2 &= \\\n\t\t5x + \\dfrac 9 2 \n\t}\n$$" :tutorial/id #uuid "0a37b6ec-6750-5aea-ae26-ad82d059a0ef" :tutorial/math-academy-id 3375 :tutorial/title "Introduction"} :step/id #uuid "871a576b-9882-5cab-a267-5bfaae09bb5c" :step/math-academy-id 18870 :step/next {:db/id #edb/ref 17592186065136}} {:db/id #edb/ref 17592186065136 :step/content {:db/id #edb/ref 17592186064257 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064102 :question/id #uuid "6e148f32-5352-5368-a08a-6da278a6068d" :question/math-academy-id "e-5124"} :knowledge-point/id #uuid "724bdf2f-c9f0-564e-ae33-c64d44c582ef" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050998}] :knowledge-point/questions [{:db/id #edb/ref 17592186064665} {:db/id #edb/ref 17592186064717} {:db/id #edb/ref 17592186233078} {:db/id #edb/ref 17592186233687} {:db/id #edb/ref 17592186446899} {:db/id #edb/ref 17592186446901} {:db/id #edb/ref 17592186514373} {:db/id #edb/ref 17592186514417} {:db/id #edb/ref 17592186514455}] :knowledge-point/title "Splitting a Rational Expression With Two Terms in the Numerator"} :step/id #uuid "213c99f3-2e96-5282-8c9f-7798f6d583ee" :step/math-academy-id 18871 :step/next {:db/id #edb/ref 17592186065137}} {:db/id #edb/ref 17592186065137 :step/content {:db/id #edb/ref 17592186064258 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064103 :question/id #uuid "41294f0b-dc6a-5a84-a7f8-7c2370b5733c" :question/math-academy-id "e-5125"} :knowledge-point/id #uuid "0649943a-643f-592f-8815-45c871f7e7dd" :knowledge-point/questions [{:db/id #edb/ref 17592186064666} {:db/id #edb/ref 17592186064718} {:db/id #edb/ref 17592186233685} {:db/id #edb/ref 17592186233686} {:db/id #edb/ref 17592186446900} {:db/id #edb/ref 17592186514368} {:db/id #edb/ref 17592186531561} {:db/id #edb/ref 17592186536897}] :knowledge-point/title "Splitting a Rational Expression With Three Terms in the Numerator"} :step/id #uuid "2ca88a28-b372-506f-bc28-472bf491340a" :step/math-academy-id 18872}] :activity/title "Splitting Rational Expressions Into Separate Terms" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064444}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186514536} :activity/id #uuid "b23c2052-349f-52a5-ba1e-34bdd73733c2" :activity/scope {:db/id #edb/ref 17592186048957 :topic/id #uuid "cf262221-31bc-5e58-a6f2-8acf1c2b4906" :topic/math-academy-id 355} :activity/steps [{:db/id #edb/ref 17592186514499 :step/content {:db/id #edb/ref 17592186233686 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03200003-7c03-5877-9799-fe42b38367d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5d}{3}-3e+2f" :db/id #edb/ref 17592186513535} {:answer/id #uuid "875b0e1a-c6ee-5156-9b67-b9182be36dd7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{3}-3e+2f" :db/id #edb/ref 17592186513884} {:answer/id #uuid "a837bab8-9905-5840-bdf4-12b924029d23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5d}{3}-3e-2f" :db/id #edb/ref 17592186513968} {:answer/id #uuid "b7dfca26-24d1-5b2e-89b8-03b7057f94a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "d-9e-2f" :db/id #edb/ref 17592186514016} {:answer/id #uuid "e8af9eea-0d25-50f2-b747-1968474f3c58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2d-9e-2f" :db/id #edb/ref 17592186514140}] :answer-field/correct {:db/id #edb/ref 17592186513968} :answer-field/id #uuid "5be07d56-1b09-5907-9a4a-651321f7cdec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514269}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cedc5783-2073-5a5a-9238-c637979688f1" :question/math-academy-id "q-2595" :question/problem "$\\frac{5d-9e-6f}{3}=$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in the individual terms, we get\n\n$$\n\\begin{aligned}\\frac{5d-9e-6f}{3} & = \\\\ \\frac{5d}{3}-\\frac{9e}{3}-\\frac{6f}{3} & = \\\\ \\frac{5d}{3}-\\frac{9}{3}\\cdot e-\\frac{6}{3}\\cdot f & = \\\\ \\frac{5d}{3}-3e-2f & .\\end{aligned}\n$$"} :step/id #uuid "500be06c-ef79-5741-b61d-1e169ee21469" :step/next {:db/id #edb/ref 17592186514518}} {:db/id #edb/ref 17592186514516 :step/content {:db/id #edb/ref 17592186514417 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75c969ca-367d-5068-acbe-f0467f813227" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$a=2$ and $b=-3$" :db/id #edb/ref 17592186513843} {:answer/id #uuid "c1682820-b145-57af-bb60-67f57aa12777" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$a=2$ and $b=3$" :db/id #edb/ref 17592186514043} {:answer/id #uuid "cd8541b1-df31-5bf9-9595-f8be69351a38" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$a=8$ and $b=-3$" :db/id #edb/ref 17592186514063} {:answer/id #uuid "e31a9be0-36c9-524a-9bf7-ae092f66b308" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$a=3$ and $b=-2$" :db/id #edb/ref 17592186514127} {:answer/id #uuid "f8331f74-2394-5f6e-af1d-324225a8b66a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$a=2$ and $b=-12$" :db/id #edb/ref 17592186514180}] :answer-field/correct {:db/id #edb/ref 17592186513843} :answer-field/id #uuid "23253a0c-91f5-5d73-8605-1ae876bdd4b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514235}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "69e15305-fd39-5e12-9afd-c74d993158ed" :question/math-academy-id "q-2593" :question/problem "If $\\frac{8x-12y}{4}$ is written in the form $ax+by,$ what are the values of $a$ and $b?$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in the individual terms, we get\n\n$$\n\\begin{aligned}\\frac{8x-12y}{4} & = \\\\ \\frac{8x}{4}-\\frac{12y}{4} & = \\\\ \\frac{8}{4}\\cdot x-\\frac{12}{4}\\cdot y & = \\\\ 2x-3y & .\\end{aligned}\n$$\n\nWriting the above in the form $ax+by,$ we get\n\n$$\n\\begin{aligned}{{(2)}_{⏟}}_{a}x+{{(-3)}_{⏟}}_{b}y.\\end{aligned}\n$$\n\nTherefore, $a=2$ and $b=-3.$"} :step/id #uuid "7d64cf93-ea34-55d5-ba8a-91d5a0d045c0" :step/next {:db/id #edb/ref 17592186514499}} {:db/id #edb/ref 17592186514518 :step/content {:db/id #edb/ref 17592186514455 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "233176ce-70f9-5e6d-87d1-a9ee42aee061" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a-6b" :db/id #edb/ref 17592186513629} {:answer/id #uuid "2b6d12dd-a924-575c-bf78-e849044273ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a-4" :db/id #edb/ref 17592186513650} {:answer/id #uuid "6a973a8f-68d4-5f16-b9b5-43302aeb1566" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4a-\\frac{3b}{2}" :db/id #edb/ref 17592186513818} {:answer/id #uuid "98adbab9-1df8-5350-9e28-7f78e7ab5f5f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a-\\frac{3b}{2}" :db/id #edb/ref 17592186513929} {:answer/id #uuid "b3b993a8-041c-5f04-b5e8-b517b901f0ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\frac{3b}{2}" :db/id #edb/ref 17592186514002}] :answer-field/correct {:db/id #edb/ref 17592186513929} :answer-field/id #uuid "a56dfd75-69de-5099-a23d-5bcbe223963a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514304}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b8beba6a-7b91-5602-93f9-62eba4e754b8" :question/math-academy-id "q-2596" :question/problem "Which of the following is equivalent to $\\frac{4a-6b}{4}?$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in the individual terms, we get\n\n$$\n\\begin{aligned}\\frac{4a-6b}{4} & = \\\\ \\frac{4a}{4}-\\frac{6b}{4} & = \\\\ \\frac{4}{4}\\cdot a-\\frac{6}{4}\\cdot b & = \\\\ a-\\frac{3}{2}\\cdot b & = \\\\ a-\\frac{3b}{2} & .\\end{aligned}\n$$"} :step/id #uuid "98967ed7-c764-5a5b-b909-edddb93ab4db" :step/next {:db/id #edb/ref 17592186514530}} {:db/id #edb/ref 17592186514530 :step/content {:db/id #edb/ref 17592186514373 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19980522-9bdd-55a7-8d9d-8828e76405ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6-\\frac{y}{2}" :db/id #edb/ref 17592186513600} {:answer/id #uuid "320dbf36-2cfb-59da-86bb-c1a4774c9420" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4-\\frac{y}{2}" :db/id #edb/ref 17592186513668} {:answer/id #uuid "c52cd410-949a-5ecc-9db0-e370a7d7839c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4-y" :db/id #edb/ref 17592186514049} {:answer/id #uuid "c6076542-ac8d-521b-91c3-c0f173f61489" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2-\\frac{y}{2}" :db/id #edb/ref 17592186514051} {:answer/id #uuid "db0641d9-8d65-5bc9-86fa-3e03187c823e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2-y" :db/id #edb/ref 17592186514105}] :answer-field/correct {:db/id #edb/ref 17592186514051} :answer-field/id #uuid "abc45ee2-9c31-50c1-96af-d62cdd130b8d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514307}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "18e51362-5c55-557f-b76e-006c8ec5e5f2" :question/math-academy-id "q-103607" :question/problem "Which of the following is equivalent to $\\frac{12-3y}{6}?$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in individual terms, we get\n\n$$\n\\begin{aligned}\\frac{12-3y}{6} & = \\\\ \\frac{12}{6}-\\frac{3y}{6} & = \\\\ \\frac{12}{6}-\\frac{3}{6}\\cdot y & = \\\\ 2-\\frac{1}{2}\\cdot y & = \\\\ 2-\\frac{y}{2}.\\end{aligned}\n$$"} :step/id #uuid "c51eee0e-bd4d-55fb-bf8e-c27eef65b158"} {:db/id #edb/ref 17592186514536 :step/content {:db/id #edb/ref 17592186514368 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "000d1ee2-eb0e-516d-880b-59e76d658afd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4a}{3}-2b+3c" :db/id #edb/ref 17592186513525} {:answer/id #uuid "17d560ac-9cc4-58ec-bd8a-4cc87ded49ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{a}{3}-2b+3c" :db/id #edb/ref 17592186513592} {:answer/id #uuid "3def3569-bf02-567b-a7ce-c0676ebb8e33" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4a}{3}-2b-3c" :db/id #edb/ref 17592186513694} {:answer/id #uuid "a1c1327e-3c63-5535-94ec-15c702bd94af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7abc}{3}" :db/id #edb/ref 17592186513950} {:answer/id #uuid "d2165713-727d-5608-af21-2766b713333b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4a}{3}+2b-3c" :db/id #edb/ref 17592186514078}] :answer-field/correct {:db/id #edb/ref 17592186513525} :answer-field/id #uuid "33f1ff95-b84b-5146-8e81-b9dec5eae7f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514247}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1169d5be-77b9-5c01-b29e-d873231e9f86" :question/math-academy-id "q-2591" :question/problem "Which of the following is equivalent to $\\frac{4a-6b+9c}{3}?$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in the individual terms, we get\n\n$$\n\\begin{aligned}\\frac{4a-6b+9c}{3} & = \\\\ \\frac{4a}{3}-\\frac{6b}{3}+\\frac{9c}{3} & = \\\\ \\frac{4a}{3}-\\frac{6}{3}\\cdot b+\\frac{9}{3}\\cdot c & = \\\\ \\frac{4a}{3}-2b+3c & .\\end{aligned}\n$$"} :step/id #uuid "d09296b7-b1c5-5fd5-a919-8913f8b1040a" :step/next {:db/id #edb/ref 17592186514516}}] :activity/title "Splitting Rational Expressions Into Separate Terms" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186513521}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186139522} :activity/id #uuid "4e2e5333-ed8e-576e-abed-94cc93efbdb5" :activity/scope {:db/id #edb/ref 17592186049051 :topic/id #uuid "d5e55293-c14f-55db-a945-4aa2b42df552" :topic/math-academy-id 2310} :activity/steps [{:db/id #edb/ref 17592186139522 :step/content {:db/id #edb/ref 17592186139662 :tutorial/content "A **compound inequality** is an inequality that consists of multiple different inequalities put together. For example, the compound inequality \n\n$$\nx \\leq 0 \\hspace{.25cm} \\text{ or } \\hspace{.25cm} x \\gt  3\n$$\n\n states that $x$ is less than or equal to $0$, or greater than $3$.\n\nFor the compound \"or\" inequality to be satisfied, at least one of the separate inequalities must be satisfied. To illustrate:\n\n- $x=-1$ satisfies the inequality because it satisfies $x \\leq 0.$\n\n- $x=5$ satisfies the inequality because it satisfies $x > 3.$\n\n- $x=1$ does not satisfy the inequality because it does not satisfy $x \\leq 0$ and it also does not satisfy $x > 3.$\n\nTo graph a compound inequality involving the word \"or,\" we graph the two separate inequalities on the same number line. In this particular case,\n\n- the inequality $x \\leq 0$ consists of a closed circle at $0$ and an arrow to the left, while\n\n- the inequality $x >3$ consists of an open circle at $3$ and an arrow to the right.\n\nThe resulting graph is as follows:\n\n![](images/96/96f1b1ee25ebc210a83ba12d90396683b7e2660050f820c4057ab85de419db91.png)" :tutorial/id #uuid "770f70a7-6710-533c-bd9a-e37123e913bb" :tutorial/math-academy-id 8132 :tutorial/title "Introduction"} :step/id #uuid "73ffc612-4a54-5b2a-9949-3131ab4b5010" :step/math-academy-id 79780 :step/next {:db/id #edb/ref 17592186139523}} {:db/id #edb/ref 17592186139523 :step/content {:db/id #edb/ref 17592186138536 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138073 :question/id #uuid "014723fc-0b7d-5212-a41e-73847f5adb00" :question/math-academy-id "e-13011"} :knowledge-point/id #uuid "6090342d-3d4e-519f-ab7d-3fb6df6e92a8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050519}] :knowledge-point/questions [{:db/id #edb/ref 17592186138770} {:db/id #edb/ref 17592186139089} {:db/id #edb/ref 17592186447251} {:db/id #edb/ref 17592186481665}] :knowledge-point/title "Representing \"Or\" Inequalities on Number Lines"} :step/id #uuid "1d905dee-c60b-587c-8b1e-96a234f4883a" :step/math-academy-id 79781 :step/next {:db/id #edb/ref 17592186139524}} {:db/id #edb/ref 17592186139524 :step/content {:db/id #edb/ref 17592186138537 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138075 :question/id #uuid "e5b6a9dc-3a19-5496-9e22-d953ff4eb647" :question/math-academy-id "e-13018"} :knowledge-point/id #uuid "32daa2fb-e5fa-5e44-b6f2-5d815d9145af" :knowledge-point/questions [{:db/id #edb/ref 17592186138848} {:db/id #edb/ref 17592186139090} {:db/id #edb/ref 17592186447247} {:db/id #edb/ref 17592186447252} {:db/id #edb/ref 17592186491986} {:db/id #edb/ref 17592186534083} {:db/id #edb/ref 17592186536851}] :knowledge-point/title "Identifying \"Or\" Inequalities Given on Number Lines"} :step/id #uuid "bcf79e23-3398-56f2-9f7c-6dddc11d8b32" :step/math-academy-id 79784 :step/next {:db/id #edb/ref 17592186139525}} {:db/id #edb/ref 17592186139525 :step/content {:db/id #edb/ref 17592186139663 :tutorial/content "Compound inequalities can also be written with the word \"and.\" However, such inequalities are often written together as a single expression with two inequality signs. For example, the compound inequality \n\n$$\n-4 \\leq x < -1\n$$\n\n means that $-4 \\leq x$ and $x < -1.$\n\nFor the compound \"and\" inequality to be satisfied, both of the separate inequalities must be satisfied. To illustrate:\n\n- $x=-3$ satisfies the inequality because it satisfies both $-4 \\leq x$ and $x < -1.$\n\n- $x=-5$ does not satisfy the inequality because it does not satisfy $-4 \\leq x.$\n\n- $x=0$ does not satisfy the inequality because it does not satisfy $x < -1.$\n\nTo graph this compound inequality, we first graph the two inequalities separately.\n\n![](images/42/42edf8ee61badbbd1e5525a3843cfbe189e6432b2ad06455c1bdca6a7087ac56.png)\n\nThen, we keep only where they overlap.\n\n![](images/fa/fa07233f96bed30ddfcc5905a55a835763359cd34188e4d1c249c13b1d27d25c.png)\n\n**Note:** Any compound \"and\" inequality will always represent a segment between two points. So, it is not always necessary to draw both inequalities and find the overlap. To speed up the process, we can just draw the endpoints with open or closed circles as appropriate, and highlight the area between the endpoints." :tutorial/id #uuid "9859e4f2-2267-558c-923f-35c348957ad9" :tutorial/math-academy-id 8133 :tutorial/title "Compound \"And\" Inequalities"} :step/id #uuid "59dbf0dd-b3a9-5867-8cbf-3b28624f9ad9" :step/math-academy-id 79788 :step/next {:db/id #edb/ref 17592186139526}} {:db/id #edb/ref 17592186139526 :step/content {:db/id #edb/ref 17592186138538 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138074 :question/id #uuid "21eace75-0b5a-5b37-903c-c238e3821bee" :question/math-academy-id "e-13012"} :knowledge-point/id #uuid "9106723c-b8b0-586e-8c2b-9bb4f50bc945" :knowledge-point/questions [{:db/id #edb/ref 17592186138765} {:db/id #edb/ref 17592186138847} {:db/id #edb/ref 17592186447250} {:db/id #edb/ref 17592186492061}] :knowledge-point/title "Representing \"And\" Inequalities on Number Lines"} :step/id #uuid "7e38370d-1c18-5d27-bb22-cf9444dd1b90" :step/math-academy-id 79789 :step/next {:db/id #edb/ref 17592186139527}} {:db/id #edb/ref 17592186139527 :step/content {:db/id #edb/ref 17592186138539 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138076 :question/id #uuid "347520ff-e759-5d99-acf7-0bc8a8f26689" :question/math-academy-id "e-13019"} :knowledge-point/id #uuid "a707a741-0208-5a74-8478-ac05ff2673ab" :knowledge-point/questions [{:db/id #edb/ref 17592186138766} {:db/id #edb/ref 17592186138776} {:db/id #edb/ref 17592186447248} {:db/id #edb/ref 17592186447249} {:db/id #edb/ref 17592186492032}] :knowledge-point/title "Identifying \"And\" Inequalities Given on Number Lines"} :step/id #uuid "40b2748c-2bc7-5064-b788-ba5145c312f9" :step/math-academy-id 79793}] :activity/title "Compound Inequalities" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186138614}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186492094} :activity/id #uuid "9814bdeb-c5c1-549b-8942-0dcd8592f0fd" :activity/scope {:db/id #edb/ref 17592186049051 :topic/id #uuid "d5e55293-c14f-55db-a945-4aa2b42df552" :topic/math-academy-id 2310} :activity/steps [{:db/id #edb/ref 17592186492079 :step/content {:db/id #edb/ref 17592186492061 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03910583-d566-5a8b-bfc2-8972fe3ecdd6" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/f6/f6139cea308db19681b8e2239e01f77d4af406a728041aa738b29ee3ce6a603e.png" :db/id #edb/ref 17592186491454} {:answer/id #uuid "7b650c21-47ed-5214-a59e-48d2075d1b3f" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/90/901ffc463b1516e30690f41af6225c62a1a3cc3950bc34e28bc5b13ae7314b28.png" :db/id #edb/ref 17592186491672} {:answer/id #uuid "8698ddac-ea80-50d9-9ad8-a8742ba97aef" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/24/2415d02b1c88fbeb254f41d3540b81e20be8fb94da400b77fabca65e40da3b8c.png" :db/id #edb/ref 17592186491685} {:answer/id #uuid "97ae2684-9fda-5d9f-bda1-046e9cd84f79" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/6f/6fa6ef603a454d9f219ca5967a87a99cc8afabc30105d36879c172b8385fd36b.png" :db/id #edb/ref 17592186491718} {:answer/id #uuid "ad0ec700-72a5-535a-a4a1-e48679183f05" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/49/496986cb7dca8bffb2d2856f3867e48d794f106139d4703e1b2166d9a223781d.png" :db/id #edb/ref 17592186491756}] :answer-field/correct {:db/id #edb/ref 17592186491454} :answer-field/id #uuid "d9c1885b-25c3-55b9-8caf-90ff3bd587c6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491970}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d2934ac4-af1a-5b63-bae8-4d35ad544ba0" :question/math-academy-id "q-54810" :question/problem "Which of the following number lines represents the inequality $-3<x<1?$" :question/worked-solution "The inequality $-3<x<1$ means that $x$ can take any value greater than $-3,$ and less than $1.$\n\nTo represent this on a number line, we draw an open circle at $-3$ and another open circle at $1.$ Then, we highlight the region between the points.\n\n![](images/f6/f6139cea308db19681b8e2239e01f77d4af406a728041aa738b29ee3ce6a603e.png)"} :step/id #uuid "1a122adf-7490-5a96-86fc-64fdc36ac5fa" :step/next {:db/id #edb/ref 17592186492092}} {:db/id #edb/ref 17592186492092 :step/content {:db/id #edb/ref 17592186491986 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0158d2c2-46e2-511e-9829-663aca526316" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$x\\le -1$ or $x\\ge 1$" :db/id #edb/ref 17592186491450} {:answer/id #uuid "2fd0b12d-c6d3-5074-bd89-cbaa31e2e2ef" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$x<-1$ or $x>1$" :db/id #edb/ref 17592186491548} {:answer/id #uuid "3f38c2dd-7e7e-5407-9e8b-c247c54b9afc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$x>-1$ or $x>1$" :db/id #edb/ref 17592186491579} {:answer/id #uuid "7853872b-6305-5952-a1e3-1e4da4e83d64" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$x<-1$ or $x<1$" :db/id #edb/ref 17592186491663} {:answer/id #uuid "a7ce2a8a-1854-5692-8ab6-ce6a4ef7ea6e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$x\\ge -1$ or $x\\le 1$" :db/id #edb/ref 17592186491747}] :answer-field/correct {:db/id #edb/ref 17592186491548} :answer-field/id #uuid "81599ce3-b5fd-5790-a91f-aa92a6b6fa9f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491931}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "087d9e13-8fc3-51e2-a62c-c006b17d535f" :question/math-academy-id "q-54820" :question/problem "![](images/f2/f2fc2248ce56cd8209d9f6438d24c7f9e9f805f320ef5549be25282cfbaa6e61.png)\n\nWhich inequality corresponds to the highlighted region shown on the number line above?" :question/worked-solution "The red rays contain all values less than  $-1$ or greater than $1.$ In addition,\n\n- the open circle at $-1$ implies that $x$ cannot be equal to $-1,$ and\n\n- the open circle at $1$ implies that $x$ cannot be equal to $1.$\n\nTherefore, the highlighted region represents $x<-1$ or $x>1.$"} :step/id #uuid "471f4a51-0ae6-5b3b-b0f1-91ebb382a932"} {:db/id #edb/ref 17592186492094 :step/content {:db/id #edb/ref 17592186492032 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05fd7dc9-4b77-586d-9ed5-f96227aed75b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2<x<2" :db/id #edb/ref 17592186491463} {:answer/id #uuid "1b458bce-037d-59e4-a297-afaa3a6e5449" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2<x\\le 2" :db/id #edb/ref 17592186491508} {:answer/id #uuid "5101b5ff-6f7e-5771-aeaf-1f3ea7c2baa6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\le x\\le 2" :db/id #edb/ref 17592186491607} {:answer/id #uuid "9bb5ca05-d4de-59e6-8172-825f719298fb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$x\\le 2$ or $x\\ge -2$" :db/id #edb/ref 17592186491722} {:answer/id #uuid "f6121d20-e884-5a07-9ef4-25a31648abf1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\le x<2" :db/id #edb/ref 17592186491875}] :answer-field/correct {:db/id #edb/ref 17592186491607} :answer-field/id #uuid "9deac3f0-5baf-51d6-9fda-87f6599c1dbb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491947}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8a1c7bea-76d1-5380-abbc-23d155edc522" :question/math-academy-id "q-28797" :question/problem "![](images/67/67c1fa5db66f96b6bbbccacf251f3cdc655fc88a6b87499234f4b1cd0a21da1d.png)\n\nWhich inequality corresponds to the highlighted region shown on the number line above?" :question/worked-solution "The red segment contains all values between  $-2$ and $2.$\n\n- the closed circle at $-2$ implies that $x$ can be equal to $-2,$ while\n\n- the closed circle at $2$ implies that $x$ can be equal to $2.$\n\nTherefore, the highlighted region represents $-2\\le x\\le 2.$"} :step/id #uuid "5ec340ac-62fa-5a0a-99de-ca8554313a1d" :step/next {:db/id #edb/ref 17592186492079}}] :activity/title "Compound Inequalities" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186491445}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186111763} :activity/id #uuid "cceda887-69b2-551b-ab27-e3d019c77f5a" :activity/scope {:db/id #edb/ref 17592186049068 :topic/id #uuid "d78ca6bb-945f-51db-a4af-fc777024df22" :topic/math-academy-id 1459} :activity/steps [{:db/id #edb/ref 17592186111598 :step/content {:db/id #edb/ref 17592186111900 :tutorial/content "We can organize all mentioned types of quadrilaterals into the following hierarchy diagram:\n\n![](images/1d/1dbe4c3e8ea97c0ac077c37143802366c5817d86965ab1dbc5abf54cd01d27c3.png)\n\nEach shape below another is a specific type of the one above it. For example, every square is a rectangle, and every rectangle is a parallelogram. This means every square is also a parallelogram." :tutorial/id #uuid "d9d3be2f-753b-5a4b-9f26-20b34ab8f89a" :tutorial/math-academy-id 5931 :tutorial/title "Classifying Quadrilaterals"} :step/id #uuid "eab37537-55a4-56e5-9fd6-7ee823f295bb" :step/math-academy-id 36207 :step/next {:db/id #edb/ref 17592186111765}} {:db/id #edb/ref 17592186111763 :step/content {:db/id #edb/ref 17592186111845 :tutorial/content "There are lots of different types of quadrilaterals. Let's look at some examples.\n\n- A **trapezoid** is a quadrilateral with exactly ![](images/95/95836ae470c61ab15bfb67d6f0c92d2ad8d03d400b04473e81e58de3ee44bf32.svg) pair of opposite sides that are parallel to each other. \nThe parallel sides are called the **bases**. The other two sides are called the **legs**.\n\n![](images/9f/9fa09c46a2119d35c796065a696954931e20062fd5b3677a5484bef92bc2b0d8.png)\n\n- An **isosceles trapezoid** is a  trapezoid with congruent legs.\n\n![](images/b6/b6b2b2012c1d724f9da8b23551ec4f978f190d86875d7db7a3074635d7f40c02.png)\n\n- A **parallelogram** is a quadrilateral with ![](images/f5/f5f3224583db57b9cfe323c8489ef5e5271000002b5ea253eb98fd067a858b2d.svg) pairs of parallel sides.\n\n \n\n![](images/5d/5d0f383f3510f54b415a7ab99ef52fb30270924f97b8afec59534a96cd3edcef.png)\n\n Opposite sides and opposite angles of a parallelogram are always congruent. Moreover, if a quadrilateral has ![](images/f5/f5f3224583db57b9cfe323c8489ef5e5271000002b5ea253eb98fd067a858b2d.svg) pairs of opposite congruent sides or  ![](images/f5/f5f3224583db57b9cfe323c8489ef5e5271000002b5ea253eb98fd067a858b2d.svg) pairs of opposite congruent angles, it is always a parallelogram.\n\n![](images/39/39ccf26333785f9ef47eed68a96bc40005a6ba025fdb6e250beefe14f10b043d.png)\n\n- A **rectangle** is a parallelogram where all angles are right.\n\n \n\n![](images/55/55a16e0ba93bf1f01d576cca558805aaea9631d1fa8e43b149509d4f8eb4c834.png)\n\n A rectangle where all sides are congruent is a **square**.\n\n![](images/a0/a04b2a0e86be8b085c5e3fc906d5aa66dfea45c033d52cd4746031202a7d427d.png)\n\n- A **rhombus** is a parallelogram where all sides are congruent. The opposite angles of a rhombus are also congruent.\n\n![](images/d3/d3588d7cbe8f285198df3909df3c03fdec04f53a3f75769e46a0ab4283fa27b3.png)\n\n A rhombus where all angles are congruent is a **square**.\n\n \n\n![](images/94/941872050d5407bcd9cb532e318276adccff802230ed854a2d292666fc0096fc.png)\n\n- A **kite** is a quadrilateral with two pairs of congruent sides that are adjacent to each other.\n\n![](images/11/116e323d81ee190c0f69b4d7cdcefe9f0952da883b0d6d3c6d4036119794baa7.png)" :tutorial/id #uuid "06a11fa2-5911-52f5-9a6d-1028e49b44dd" :tutorial/math-academy-id 2262 :tutorial/title "Introduction"} :step/id #uuid "04c2712b-f67a-5317-b34e-8936b6acdd9c" :step/math-academy-id 9452 :step/next {:db/id #edb/ref 17592186111598}} {:db/id #edb/ref 17592186111765 :step/content {:db/id #edb/ref 17592186110776 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110405 :question/id #uuid "515ab620-8513-55cc-8c88-61c0ad27aff2" :question/math-academy-id "e-2833"} :knowledge-point/id #uuid "00889b75-3745-52f6-9157-912846482689" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048723} {:db/id #edb/ref 17592186049584}] :knowledge-point/questions [{:db/id #edb/ref 17592186111260} {:db/id #edb/ref 17592186111261} {:db/id #edb/ref 17592186446849} {:db/id #edb/ref 17592186446853} {:db/id #edb/ref 17592186536886}] :knowledge-point/title "Describing a Quadrilateral"} :step/id #uuid "4f398499-a037-5d65-8f25-ecbcfa7534c2" :step/math-academy-id 9454 :step/next {:db/id #edb/ref 17592186111767}} {:db/id #edb/ref 17592186111767 :step/content {:db/id #edb/ref 17592186110777 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110406 :question/id #uuid "ee3a028c-93df-5e5a-bc06-4c286a5e1839" :question/math-academy-id "e-2834"} :knowledge-point/id #uuid "c81cf5ed-8dd7-5174-b8e9-faf63bf0a278" :knowledge-point/questions [{:db/id #edb/ref 17592186111263} {:db/id #edb/ref 17592186111264} {:db/id #edb/ref 17592186446851} {:db/id #edb/ref 17592186446852} {:db/id #edb/ref 17592186506540} {:db/id #edb/ref 17592186531582} {:db/id #edb/ref 17592186539025} {:db/id #edb/ref 17592186540039} {:db/id #edb/ref 17592186540058}] :knowledge-point/title "Identifying a Quadrilateral"} :step/id #uuid "14f9869d-2b87-58dd-a3bd-3dfd6047425b" :step/math-academy-id 9459 :step/next {:db/id #edb/ref 17592186111768}} {:db/id #edb/ref 17592186111768 :step/content {:db/id #edb/ref 17592186110778 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110408 :question/id #uuid "a7b82dde-36fc-582e-9ed6-fbfcfbf8b47c" :question/math-academy-id "e-2839"} :knowledge-point/id #uuid "34ed7bcd-3c06-592e-906c-5010e80370db" :knowledge-point/questions [{:db/id #edb/ref 17592186111262} {:db/id #edb/ref 17592186111266} {:db/id #edb/ref 17592186446850} {:db/id #edb/ref 17592186506515} {:db/id #edb/ref 17592186506571} {:db/id #edb/ref 17592186536811} {:db/id #edb/ref 17592186536834} {:db/id #edb/ref 17592186540037}] :knowledge-point/title "Identifying True Statements About Quadrilaterals"} :step/id #uuid "615b803e-ca7c-56d1-9167-9829ed84b5c5" :step/math-academy-id 9460}] :activity/title "Classifying Quadrilaterals" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110831}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186506608} :activity/id #uuid "0fada08e-9ee8-50a7-a281-27eecc4451e2" :activity/scope {:db/id #edb/ref 17592186049068 :topic/id #uuid "d78ca6bb-945f-51db-a4af-fc777024df22" :topic/math-academy-id 1459} :activity/steps [{:db/id #edb/ref 17592186506608 :step/content {:db/id #edb/ref 17592186506515 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04cd6f91-4830-5fb2-a760-6d1458397aff" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186505925} {:answer/id #uuid "3cb14bc8-1566-5a66-a92e-6847a87ef3a0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186506011} {:answer/id #uuid "40c8a717-049b-5524-b555-5e7634dfb774" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186506019} {:answer/id #uuid "6b6d04c0-fedf-5f99-93ce-81d660f42b3b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186506097} {:answer/id #uuid "9f2a5be0-7fd3-5d96-a0c9-2797fdcde248" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None" :db/id #edb/ref 17592186506194}] :answer-field/correct {:db/id #edb/ref 17592186506011} :answer-field/id #uuid "b73d6aaf-8b71-5986-9a72-f3f8cba064c2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186506464}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "16005fe9-c0e8-5807-8dbf-172a83d89558" :question/math-academy-id "q-53062" :question/problem "Which of the following statements are true?\n\nI. A square is sometimes not a rectangle.\n\nII. A rectangle is always a quadrilateral.\n\nIII. A square is never a rhombus." :question/worked-solution "First, recall the hierarchy diagram of quadrilaterals, where each shape below another is a specific type of the one above it.\n\n![](images/1d/1dbe4c3e8ea97c0ac077c37143802366c5817d86965ab1dbc5abf54cd01d27c3.png)\n\nLet's now look at each statement in turn.\n\n- Statement I is false. In a rectangle, its four angles are right angles. The same is true for a square. A square is a specific type of rectangle, where the four angles are right angles and the four sides are congruent.\n\n- Statement II is true. A rectangle is always a quadrilateral because it has four sides.\n\n- Statement III is false. A rhombus is a parallelogram where all sides are congruent. A square is a specific type of rhombus, where the four angles are right angles and the four sides are congruent.\n\nIn conclusion, only statement II is true."} :step/id #uuid "1472f937-314f-5429-8263-e1a67f2a5b4d" :step/next {:db/id #edb/ref 17592186506644}} {:db/id #edb/ref 17592186506644 :step/content {:db/id #edb/ref 17592186506571 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "015f0057-b143-57ad-8fa5-2978f72ea3dc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186505914} {:answer/id #uuid "1afb074a-342e-57b7-b473-fffc06924988" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186505957} {:answer/id #uuid "555289bb-109d-55d5-955e-bed2ff4c8443" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None" :db/id #edb/ref 17592186506057} {:answer/id #uuid "92f03582-9a2a-59ce-8ac4-d6529d374b33" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186506160} {:answer/id #uuid "e905ed52-46a6-5b4b-9ca4-e3a4bea9ebdc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186506337}] :answer-field/correct {:db/id #edb/ref 17592186506160} :answer-field/id #uuid "38a2df37-5f07-59b3-9c74-e390691ea42b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186506405}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "978998ae-c2d1-5709-a415-cc49252cea0c" :question/math-academy-id "q-53063" :question/problem "Which of the following statements are true?\n\nI. A parallelogram is sometimes a rectangle.\n\nII. A kite is never a quadrilateral.\n\nIII. A square is always a trapezoid." :question/worked-solution "First, recall the hierarchy diagram of quadrilaterals, where each shape below another is a specific type of the one above it.\n\n![](images/1d/1dbe4c3e8ea97c0ac077c37143802366c5817d86965ab1dbc5abf54cd01d27c3.png)\n\nLet's now look at each statement in turn.\n\n- Statement I is true. A parallelogram is a rectangle when all the angles are right.\n\n- Statement II is false. A kite is always a quadrilateral because it has four sides.\n\n- Statement III is false. A trapezoid has only $1$ pair of opposite sides that are parallel. However, in a square, $2$ pairs of opposite sides are parallel, and so doesn't fit the definition of a trapezoid.\n\nIn conclusion, only statement I is true."} :step/id #uuid "a7b19881-e4d4-5ce2-a2db-ec80491290b8" :step/next {:db/id #edb/ref 17592186506648}} {:db/id #edb/ref 17592186506648 :step/content {:db/id #edb/ref 17592186506540 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c5ff65a-e0ad-54f7-95cd-72299fae692b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None" :db/id #edb/ref 17592186506101} {:answer/id #uuid "ab8a2580-e988-59db-b88f-bdf851f5dff2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$R$ only" :db/id #edb/ref 17592186506224} {:answer/id #uuid "dabfe65d-e001-5f6f-8eae-84c4f049a38c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$S$ only" :db/id #edb/ref 17592186506304} {:answer/id #uuid "f6b01984-7aec-5b99-b309-32e1700f88cf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$Q$ only" :db/id #edb/ref 17592186506364} {:answer/id #uuid "faa76e22-ab2a-5e2f-b51a-88f71d4a4169" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$P$ only" :db/id #edb/ref 17592186506371}] :answer-field/correct {:db/id #edb/ref 17592186506364} :answer-field/id #uuid "7c39ae96-03b7-5d75-924b-50c66d2fd7a7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186506435}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4ee12482-99b3-5022-8d03-b6e6abfce44f" :question/math-academy-id "q-74591" :question/problem "![](images/e3/e3708d7723606224e201147b432250dd759022fd7ed275dabebf51935d68d8f8.png)\n\nWhich of the figures above is a rhombus?" :question/worked-solution "First, recall the hierarchy diagram of quadrilaterals, where each shape below another is a specific type of the one above it.\n\n![](images/1d/1dbe4c3e8ea97c0ac077c37143802366c5817d86965ab1dbc5abf54cd01d27c3.png)\n\nRemember that a rhombus is a parallelogram where all sides are congruent.\n\nWith that in mind, let's look at each shape in turn.\n\n- The shape $P$ is a rectangle. The sides are not all congruent, so it is not a rhombus.\n\n- The shape $Q$ is a square. All its sides are congruent and the opposite sides are parallel, so it is a rhombus.\n\n- The shape $R$ is a trapezoid. Since it has only one pair of parallel sides, it is not a rhombus.\n\n- The shape $S$ is an isosceles trapezoid.  Since it has only one pair of parallel sides, it is not a rhombus.\n\nTherefore, shape $Q$ is a rhombus. The shapes $P,$ $R,$ and $S$ are not rhombuses."} :step/id #uuid "b98f15bb-0b73-5666-9f9e-51644b2b10be"}] :activity/title "Classifying Quadrilaterals" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186505900}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186536948} :activity/id #uuid "5011f029-40b3-50ae-adc7-c8594e763c6a" :activity/scope {:db/id #edb/ref 17592186049068 :topic/id #uuid "d78ca6bb-945f-51db-a4af-fc777024df22" :topic/math-academy-id 1459} :activity/steps [{:db/id #edb/ref 17592186536917 :step/content {:db/id #edb/ref 17592186111263 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8113f0c1-13bf-5ab2-9884-6d72597b1b88" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$Q$ and $S$ only" :db/id #edb/ref 17592186109304} {:answer/id #uuid "8a8d835d-c354-5c3b-ad6e-6b19f2da5a27" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$R$ only" :db/id #edb/ref 17592186109305} {:answer/id #uuid "bee1b7de-ab86-59bc-81ce-c2ecde07ae92" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None" :db/id #edb/ref 17592186109306} {:answer/id #uuid "2aa8a596-87e0-598e-9105-9841f4e811d8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$P$ only" :db/id #edb/ref 17592186109307} {:answer/id #uuid "44b7bf2b-d86f-5d31-82a9-bbadefe43231" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$P$ and $R$ only" :db/id #edb/ref 17592186109308}] :answer-field/correct {:db/id #edb/ref 17592186109308} :answer-field/id #uuid "e044e866-6811-5b05-95ac-6974da60d777" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186109303}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5b35d665-09e4-54b3-8c80-68318024b0ef" :question/math-academy-id "q-53035" :question/problem "![](images/70/702edb8e1ea4a79ea12e891ed3874c36ff3e6628c9cb000753f74ca7bc35ec74.png)\n\nWhich of the figures above is a parallelogram?" :question/worked-solution "First, recall the hierarchy diagram of quadrilaterals, where each shape below another is a specific type of the one above it.\n\n![](images/1d/1dbe4c3e8ea97c0ac077c37143802366c5817d86965ab1dbc5abf54cd01d27c3.png)\n\nRemember that a parallelogram is a quadrilateral with $2$ pairs of parallel sides.\n\nWith that in mind, let's look at each shape in turn.\n\n- The shape $P$ is a rectangle. Therefore, its opposite sides are parallel, so it is a parallelogram.\n\n- The shape $Q$ is a kite. It has a pair of opposite sides that are not parallel, therefore, it is not a parallelogram.\n\n- The shape $R$ is a rhombus. Since the opposite sides of a rhombus are parallel, it is a parallelogram.\n\n- The shape $S$ is a trapezoid. It has only one pair of parallel sides, therefore, it is not a parallelogram.\n\nTherefore, shapes $P$ and $R$ are parallelograms. The shapes $Q$ and $S$ are not parallelograms."} :step/id #uuid "2cfe7fe6-dfad-5186-856c-597f87ad3a5e"} {:db/id #edb/ref 17592186536937 :step/content {:db/id #edb/ref 17592186536834 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48305576-11d5-5617-960a-a3990bcb7dca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186536394} {:answer/id #uuid "5af8d66e-d7ec-5f20-b9b6-13fb2ff0d05e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186536443} {:answer/id #uuid "bfbf47b7-c34e-5794-aa4d-102f253c4306" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186536584} {:answer/id #uuid "f2464b38-1ef3-59d6-af91-e21eb614b53f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186536670} {:answer/id #uuid "f5b0cf17-65c2-51ce-89a4-44437b972a52" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186536677}] :answer-field/correct {:db/id #edb/ref 17592186536443} :answer-field/id #uuid "ec71a978-52b7-54a3-b5fa-ef72f160c9d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186536797}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "55788c3c-c1d0-5ef8-8ff4-5e5fd3b4c618" :question/math-academy-id "q-53012" :question/problem "![](images/4e/4e20dca5a916c43e93dd94b92ff4c1949a111537a8cb2e45b9ca0be7e2300f40.png)\n\nWhich of the following statements are true regarding the square above?\n\nI. $AB=BC=CD=AD.$\n\nII. $m∠ABC=m∠ADC.$\n\nIII. $\\overset{―}{AD}$ is parallel to $\\overset{―}{BC}.$" :question/worked-solution "Let's look at each statement in turn.\n\n- Statement I is true. A square is a rectangle where all sides are congruent, hence $AB=BC=CD=AD.$\n\n- Statement II is true. The angles in a square are all right. Therefore, $m∠ABC={90}^{∘}=m∠ADC.$\n\n- Statement III is true. Opposite sides of a square are parallel, and $\\overset{―}{AD}$ is opposite $\\overset{―}{BC},$ therefore $\\overset{―}{AD}$ is parallel to $\\overset{―}{BC}.$\n\nIn conclusion, statements I, II, and III are true."} :step/id #uuid "6b24c0db-50fd-51da-9580-556fff1c0632" :step/next {:db/id #edb/ref 17592186536917}} {:db/id #edb/ref 17592186536948 :step/content {:db/id #edb/ref 17592186536811 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24387f91-25bf-5714-8675-ef415eba960e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186536337} {:answer/id #uuid "28dbcf41-1538-5429-b8d5-50fbfa182de1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None" :db/id #edb/ref 17592186536344} {:answer/id #uuid "8d7da163-a580-5e50-a38f-f8e138ef74c7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186536510} {:answer/id #uuid "edec2c50-c3f2-5ae9-9a96-0ba69435f615" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186536661} {:answer/id #uuid "f02da5b5-90ef-5511-90c7-04d4ca4bf833" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186536664}] :answer-field/correct {:db/id #edb/ref 17592186536510} :answer-field/id #uuid "6a514638-3f19-527b-a1de-1e926b7c8285" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186536750}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "13987c3a-59aa-55ed-8fe6-1cb169d96b89" :question/math-academy-id "q-53009" :question/problem "![](images/1b/1b0dd854ae2edb38245466049806c7e93bb4b704a03284905d968869fa1b4146.png)\n\nWhich of the following statements are true regarding the kite above?\n\nI. $AB=AD.$\n\nII. The kite has a pair of congruent opposite angles.\n\nIII. $AB=BC=CD=AD.$" :question/worked-solution "Let's look at each statement in turn.\n\n- Statement I is true. A kite is a quadrilateral with two pairs of congruent sides that are adjacent to each other. In the figure, we can see that $AB=AD.$\n\n- Statement II is true. A kite always has a pair of congruent opposite angles.\n\n- Statement III is false. A kite is a quadrilateral with two pairs of congruent sides that are adjacent to each other. However, not all sides are congruent, for instance, $AB\\ne BC.$\n\nIn conclusion, statements I and II are true."} :step/id #uuid "866cff26-8806-5fb7-acaa-154a2dd5266d" :step/next {:db/id #edb/ref 17592186536937}}] :activity/title "Classifying Quadrilaterals" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186536273}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186540175} :activity/id #uuid "2630917f-aced-5106-9904-8233756f6371" :activity/scope {:db/id #edb/ref 17592186049068 :topic/id #uuid "d78ca6bb-945f-51db-a4af-fc777024df22" :topic/math-academy-id 1459} :activity/steps [{:db/id #edb/ref 17592186540162 :step/content {:db/id #edb/ref 17592186540058 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20a142cb-5a03-56b5-9608-5de7dc8a4e1d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$P$ only" :db/id #edb/ref 17592186539543} {:answer/id #uuid "5158fa1a-17a4-51ee-8896-bddf8a29d1e8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$R$ only" :db/id #edb/ref 17592186539622} {:answer/id #uuid "7adc4555-752a-5e57-bcb0-83e8ec2f53d1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "All" :db/id #edb/ref 17592186539684} {:answer/id #uuid "ccadcf93-d50b-58d0-9015-33e93c374069" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$Q$ and $R$ only" :db/id #edb/ref 17592186539831} {:answer/id #uuid "d45dc88e-eeff-51ce-b206-d2acb0e76ad6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$Q$, $R$ and $S$ only" :db/id #edb/ref 17592186539840}] :answer-field/correct {:db/id #edb/ref 17592186539831} :answer-field/id #uuid "e718d457-5460-5935-99e9-b9a4df1c718d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186540007}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6ffd60c0-4297-5e49-a178-11a94ccb47c6" :question/math-academy-id "q-53038" :question/problem "![](images/b1/b15000ac7f2de0770140ba289a8f5224433bfb6570d985ab184eacba016c97c4.png)\n\nWhich of the figures above is a rectangle?" :question/worked-solution "First, recall the hierarchy diagram of quadrilaterals, where each shape below another is a specific type of the one above it.\n\n![](images/1d/1dbe4c3e8ea97c0ac077c37143802366c5817d86965ab1dbc5abf54cd01d27c3.png)\n\nRemember that a rectangle is a quadrilateral where all angles are right with two pairs of parallel sides.\n\nWith that in mind, let's look at each shape in turn.\n\n- The shape $P$ is an isosceles trapezoid. It has no right angles, therefore, it is not a rectangle.\n\n- The shape $Q$ is a square. Therefore, all its angles are right, so it is a rectangle.\n\n- The shape $R$ is a rectangle since all its angles are right.\n\n- The shape $S$ is a kite. Since there are no pairs of parallel sides, it is not a rectangle.\n\nTherefore, shapes $Q$ and $R$ are rectangles. The shapes $P$ and $S$ are not rectangles."} :step/id #uuid "adc711d8-746b-5e53-b6c3-e0b7e18d4113"} {:db/id #edb/ref 17592186540175 :step/content {:db/id #edb/ref 17592186540037 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81dd0b82-3bdc-58b9-aace-0499be563ebd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186539692} {:answer/id #uuid "92cbbb20-640e-5d85-8433-6e6a415bd113" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186539723} {:answer/id #uuid "a7cac4dc-2679-5603-a932-b379a986241e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186539763} {:answer/id #uuid "fd559331-35f7-58ab-877a-14827b89cf19" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186539909} {:answer/id #uuid "fe52eb10-47ee-5fd1-bfca-3c219b4d2d9c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II and III" :db/id #edb/ref 17592186539912}] :answer-field/correct {:db/id #edb/ref 17592186539723} :answer-field/id #uuid "b909ad7e-6288-5330-b18b-d4332e6e69e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539989}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2b8aa940-8e5f-5fd6-a1b0-b18405dff657" :question/math-academy-id "q-53011" :question/problem "![](images/6a/6ada3cc0fcd02f363da922e9537d3f832cd616886da84f63e65085bd271aa3e0.png)\n\nWhich of the following statements are true regarding the rectangle above?\n\nI. $∠BCD$ is not a right angle.\n\nII. $\\overset{―}{AD}$ and $\\overset{―}{BC}$ are parallel.\n\nIII. $BC=CD.$" :question/worked-solution "Let's look at each statement in turn.\n\n- Statement I is false. A rectangle is a parallelogram where all angles are right. Therefore, $∠BCD$ is a right angle.\n\n- Statement II is true. The opposite sides of a rectangle are parallel, so $\\overset{―}{AD}$ and $\\overset{―}{BC}$ are parallel.\n\n- Statement III is false. Opposite sides of a rectangle are congruent, however, $BC$ and $CD$ are adjacent and we see that $BC\\ne CD.$\n\nIn conclusion, only statement II is true."} :step/id #uuid "e319bf65-c10b-5a7b-a690-7eba1bdc7f18" :step/next {:db/id #edb/ref 17592186540178}} {:db/id #edb/ref 17592186540178 :step/content {:db/id #edb/ref 17592186540039 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "533ff24d-0dd5-597d-81d4-ef34db14a4d2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$R$ only" :db/id #edb/ref 17592186539623} {:answer/id #uuid "57efc2a7-dd61-536c-bba1-56239c4d994b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$S$ only" :db/id #edb/ref 17592186539629} {:answer/id #uuid "95a90f98-8016-522b-90ea-a421361fd65d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$Q$ and $R$ only" :db/id #edb/ref 17592186539728} {:answer/id #uuid "bd7493e8-0792-51c0-8f9c-1ab66d7e9c0c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None" :db/id #edb/ref 17592186539808} {:answer/id #uuid "c1bb7450-f341-5f68-89ad-4d37a81dadfb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$P,$ $R$ and $S$ only" :db/id #edb/ref 17592186539814}] :answer-field/correct {:db/id #edb/ref 17592186539623} :answer-field/id #uuid "8aa685bd-830c-5c31-bbf0-5ff6dfa7d380" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539968}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "33255947-d8b8-558c-b5b9-74099a601ba7" :question/math-academy-id "q-53031" :question/problem "![](images/fe/fe3724e266b68939b97f07fd7f428173ff0693b0d309d085187e44a45ba466ac.png)\n\nWhich of the figures above is a kite?" :question/worked-solution "First, recall the hierarchy diagram of quadrilaterals, where each shape below another is a specific type of the one above it.\n\n![](images/1d/1dbe4c3e8ea97c0ac077c37143802366c5817d86965ab1dbc5abf54cd01d27c3.png)\n\nRemember that a kite is a quadrilateral with two pairs of congruent sides that are adjacent to each other.\n\nWith that in mind, let's look at each shape in turn.\n\n- The shape $P$ is a trapezoid. It doesn't have two pairs of congruent sides that are adjacent to each other, therefore, it is not a kite.\n\n- The shape $Q$ is a rectangle. Since it doesn't have two pairs of congruent sides that are adjacent to each other, it is not a kite.\n\n- The shape $R$ is a rhombus. Therefore, it has two pairs of congruent sides that are adjacent to each other, so it is a kite.\n\n- The shape $S$ is a parallelogram. Any two adjacent sides are not congruent with each other, therefore, it is not a kite.\n\nTherefore, only shape $R$ is a kite."} :step/id #uuid "eef9ecda-4b2e-53de-8198-669f60557288" :step/next {:db/id #edb/ref 17592186540162}}] :activity/title "Classifying Quadrilaterals" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186539467}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186074775} :activity/id #uuid "e7d0e915-5cc0-5d0f-b4c6-027cb6220aa3" :activity/scope {:db/id #edb/ref 17592186049463 :topic/id #uuid "f762d717-d0f3-5d60-8a4d-561cc023f344" :topic/math-academy-id 524} :activity/steps [{:db/id #edb/ref 17592186074775 :step/content {:db/id #edb/ref 17592186075029 :tutorial/content "Given a number, its **additive inverse** is the number we need to add to get zero.\nTo find the additive inverse of a number, we change its sign by placing a minus symbol $({\\color{red}{-}})$ in front of it. \n\nFor example, to find the additive inverse of $5,$ we obtain \n\n$$\n{\\color{red}{-}}\\,(5) = -5.\n$$\n\nTo check our work, we add the inverse to the original number. If we're correct, we should get zero.\n\n$$\n5+(-5) = 5-5 = 0 \\quad {\\color{green}\\checkmark}\n$$" :tutorial/id #uuid "21fd73d9-f9b8-5ef8-9e18-9ba21d6d8d79" :tutorial/math-academy-id 15159 :tutorial/title "Introduction"} :step/id #uuid "c1f41837-dee8-5f07-9c9f-5cfaebd69d2e" :step/math-academy-id 620103 :step/next {:db/id #edb/ref 17592186074776}} {:db/id #edb/ref 17592186074776 :step/content {:db/id #edb/ref 17592186073820 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073437 :question/id #uuid "735e0a05-bc90-5b18-b096-d51d9f9c50e3" :question/math-academy-id "e-22709"} :knowledge-point/id #uuid "d7d26bc9-6f89-5da4-b8a9-6be6f4280f81" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050421}] :knowledge-point/questions [{:db/id #edb/ref 17592186074498} {:db/id #edb/ref 17592186074499} {:db/id #edb/ref 17592186445907} {:db/id #edb/ref 17592186445912} {:db/id #edb/ref 17592186533988} {:db/id #edb/ref 17592186542154}] :knowledge-point/title "Finding the Additive Inverse of a Positive Integer"} :step/id #uuid "6255e96d-283e-52d1-815a-3ba256caf351" :step/math-academy-id 620104 :step/next {:db/id #edb/ref 17592186074777}} {:db/id #edb/ref 17592186074777 :step/content {:db/id #edb/ref 17592186075030 :tutorial/content "To find the additive inverse of a negative number, we can use the same process.\n\nFor instance, to find the additive inverse of the number $-3,$ we change its sign by placing a minus symbol $({\\color{red}{-}})$ in front of it.\nSo, we obtain\n\n$$\n{\\color{red}{-}}\\,(-3) = 3.\n$$\n\nAgain, we check our work by adding the inverse to the original number. If we're correct, we should get zero.\n\n$$\n(-3)+3 = -3+3 = 0 \\quad {\\color{green}\\checkmark}\n$$" :tutorial/id #uuid "d30313d5-d29e-5eea-b11c-0619439becb0" :tutorial/math-academy-id 15161 :tutorial/title "Finding the Additive Inverse of a Negative Integer"} :step/id #uuid "29da515a-cf3c-5833-83f4-fdcc7d1ce495" :step/math-academy-id 620107 :step/next {:db/id #edb/ref 17592186074778}} {:db/id #edb/ref 17592186074778 :step/content {:db/id #edb/ref 17592186073821 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073438 :question/id #uuid "de14e5df-9b12-5878-a134-9b02db1d5b5d" :question/math-academy-id "e-22710"} :knowledge-point/id #uuid "b38f30b0-9e05-510f-9ba6-928ab1b8482b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048546}] :knowledge-point/questions [{:db/id #edb/ref 17592186074497} {:db/id #edb/ref 17592186074500} {:db/id #edb/ref 17592186445909} {:db/id #edb/ref 17592186445910} {:db/id #edb/ref 17592186445911} {:db/id #edb/ref 17592186531586}] :knowledge-point/title "Finding the Additive Inverse of a Negative Integer"} :step/id #uuid "d90caf33-37bf-5639-9bbb-33de68320604" :step/math-academy-id 620108 :step/next {:db/id #edb/ref 17592186074779}} {:db/id #edb/ref 17592186074779 :step/content {:db/id #edb/ref 17592186073822 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073439 :question/id #uuid "8b152054-aec8-58f3-9a7a-e435e49fe8c9" :question/math-academy-id "e-22711"} :knowledge-point/id #uuid "b88b2def-7312-5076-9ff3-60319d37f1d6" :knowledge-point/questions [{:db/id #edb/ref 17592186074501} {:db/id #edb/ref 17592186074502} {:db/id #edb/ref 17592186445906} {:db/id #edb/ref 17592186445908}] :knowledge-point/title "Finding the Additive Inverse of a Decimal or Fraction"} :step/id #uuid "0a3e5261-c30f-51be-aebe-8a0790994019" :step/math-academy-id 620111}] :activity/title "Additive Inverses of Numbers" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073944}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186189246} :activity/id #uuid "d79ba348-c646-5f14-ae8e-c850ebf9ecf1" :activity/scope {:db/id #edb/ref 17592186049496 :topic/id #uuid "f93c391b-70b7-5915-96b7-e71123856cd6" :topic/math-academy-id 3873} :activity/steps [{:db/id #edb/ref 17592186189246 :step/content {:db/id #edb/ref 17592186189440 :tutorial/content "Let's think about how to simplify the following expression:\n\n$$\n6x-(3+2x)\n$$\n\nIn this example, we're subtracting the entire group of terms in parentheses from $6x.$ In such cases, we distribute the negative sign to each term in the parentheses *first* and then simplify by collecting like terms.\n\nRemoving the parentheses by distributing the negative sign, we get\n\n$$\n\\begin{aligned}6x-(3+2x) & = \\\\ 6x-3-2x & .\\end{aligned}\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}6x-3-2x & = \\\\ (6x-2x)-3 & = \\\\ 4x-3 & \\end{aligned}\n$$\n\nLet's take a look at another example." :tutorial/id #uuid "e0305f7d-c5ac-5566-af24-891e025ad938" :tutorial/math-academy-id 8189 :tutorial/title "Introduction"} :step/id #uuid "48299c1f-8045-5cb7-a906-450404a7722b" :step/math-academy-id 54169 :step/next {:db/id #edb/ref 17592186189247}} {:db/id #edb/ref 17592186189247 :step/content {:db/id #edb/ref 17592186188373 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188086 :question/id #uuid "7f43385c-ccc0-5855-916a-e6bb689c290f" :question/math-academy-id "e-13094"} :knowledge-point/id #uuid "77a8929d-7aa9-5410-97d7-c7c72e9f1356" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049939} {:db/id #edb/ref 17592186050452}] :knowledge-point/questions [{:db/id #edb/ref 17592186188574} {:db/id #edb/ref 17592186188576} {:db/id #edb/ref 17592186475944} {:db/id #edb/ref 17592186475982}] :knowledge-point/title "Distributing the Negative Sign Before Simplifying"} :step/id #uuid "b722a519-23e4-59d9-b070-fe41c31e900a" :step/math-academy-id 54170 :step/next {:db/id #edb/ref 17592186189248}} {:db/id #edb/ref 17592186189248 :step/content {:db/id #edb/ref 17592186188374 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188087 :question/id #uuid "d73b6911-278d-5c8e-a900-fc751fa518fa" :question/math-academy-id "e-13095"} :knowledge-point/id #uuid "b93a6e36-3ec9-5451-92c0-a534f2776cf1" :knowledge-point/questions [{:db/id #edb/ref 17592186188575} {:db/id #edb/ref 17592186188577} {:db/id #edb/ref 17592186475951} {:db/id #edb/ref 17592186504669} {:db/id #edb/ref 17592186504687} {:db/id #edb/ref 17592186538938}] :knowledge-point/title "Distributing the Negative Sign Before Simplifying: Negative Terms in Parentheses"} :step/id #uuid "2d27c88e-9503-5c41-bf18-fcea1bf5999f" :step/math-academy-id 54173 :step/next {:db/id #edb/ref 17592186189249}} {:db/id #edb/ref 17592186189249 :step/content {:db/id #edb/ref 17592186189441 :tutorial/content "Sometimes, to subtract a group of terms, we have to apply the distributive law.\n\nFor example, let's simplify the following expression:\n\n$$\n7-4(y+2)\n$$\n\nFirst, let's write some big brackets around the expression in parentheses, keeping the minus sign *outside*.\n\n$$\n7 - \\Big[4(y+2)\\Big]\n$$\n\nNext, we expand the expression inside the brackets using the distributive law. This gives\n\n$$\n7 - \\Big[4y+8\\Big].\n$$\n\nNow, we proceed as before. Removing the brackets by distributing the negative sign gives\n\n$$\n7 - 4y - 8.\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}7-4y-8 & = \\\\ (7-8)-4y & = \\\\ -1-4y & \\end{aligned}\n$$" :tutorial/id #uuid "7ded6b18-fb82-5e0c-999c-e8bede8f99c8" :tutorial/math-academy-id 8190 :tutorial/title "Subtracting a Group of Terms Using the Distributive Law"} :step/id #uuid "ad56d248-e365-5d0f-9646-35528365848b" :step/math-academy-id 54176 :step/next {:db/id #edb/ref 17592186189250}} {:db/id #edb/ref 17592186189250 :step/content {:db/id #edb/ref 17592186188375 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188088 :question/id #uuid "34317825-e142-5f97-951f-45f87d9672d5" :question/math-academy-id "e-13096"} :knowledge-point/id #uuid "9012632c-56fc-59b7-8212-39aeb96e2f9d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050575}] :knowledge-point/questions [{:db/id #edb/ref 17592186188950} {:db/id #edb/ref 17592186188974} {:db/id #edb/ref 17592186475946} {:db/id #edb/ref 17592186475983}] :knowledge-point/title "Applying the Distributive Law Before Simplifying"} :step/id #uuid "f8f736f0-3a01-5ac8-a88f-d5962e78c148" :step/math-academy-id 54177 :step/next {:db/id #edb/ref 17592186189251}} {:db/id #edb/ref 17592186189251 :step/content {:db/id #edb/ref 17592186188376 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188089 :question/id #uuid "d6283f26-9e20-5255-b358-8bc0c6523065" :question/math-academy-id "e-13097"} :knowledge-point/id #uuid "1f9b26ce-9f61-5cb0-aeab-ee44bb3584c9" :knowledge-point/questions [{:db/id #edb/ref 17592186188971} {:db/id #edb/ref 17592186188972} {:db/id #edb/ref 17592186475950} {:db/id #edb/ref 17592186475981}] :knowledge-point/title "Applying the Distributive Law Before Simplifying: Negative Terms in Parentheses"} :step/id #uuid "7f09baad-048d-5278-9394-d9bf15b40156" :step/math-academy-id 54180}] :activity/title "Simplifying Linear Expressions When a Group of Terms Is Subtracted" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186188467}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186504736} :activity/id #uuid "9fecab51-b2b7-570a-b77c-aaf9f1c9d473" :activity/scope {:db/id #edb/ref 17592186049496 :topic/id #uuid "f93c391b-70b7-5915-96b7-e71123856cd6" :topic/math-academy-id 3873} :activity/steps [{:db/id #edb/ref 17592186504712 :step/content {:db/id #edb/ref 17592186504687 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34afa9ed-00ce-5ad3-8ac0-de8b2107befb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6+2t" :db/id #edb/ref 17592186504121} {:answer/id #uuid "56a02156-0eda-5329-a27c-ae71c16b1d13" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4+2t" :db/id #edb/ref 17592186504183} {:answer/id #uuid "7094ccad-f184-5eda-960d-72aaa2be77f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4-2t" :db/id #edb/ref 17592186504229} {:answer/id #uuid "ae9e55e7-5332-5599-bce1-06cd145becde" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5+2t" :db/id #edb/ref 17592186504333} {:answer/id #uuid "bbf61ddd-6039-5de5-8c94-ab6c85436dcc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6-2t" :db/id #edb/ref 17592186504357}] :answer-field/correct {:db/id #edb/ref 17592186504229} :answer-field/id #uuid "846bf343-94dc-5249-9587-db971cfd4284" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186504539}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d29eb87c-44a4-5a37-bf93-591857617749" :question/math-academy-id "q-144242" :question/problem "Simplify the expression $-5-(2t-1).$" :question/worked-solution "First, we remove the parentheses by distributing the negative sign. This gives\n\n$$\n-5-2t+1\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}-5-2t+1 & = \\\\ (-5+1)-2t & = \\\\ -4-2t & \\end{aligned}\n$$"} :step/id #uuid "1400d1b1-0431-5937-822b-73dc0d2e03d3" :step/next {:db/id #edb/ref 17592186504722}} {:db/id #edb/ref 17592186504722 :step/content {:db/id #edb/ref 17592186504669 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f196ffb-2adb-5a67-bb3e-2b31b5c43446" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z-4" :db/id #edb/ref 17592186504174} {:answer/id #uuid "50315422-59be-5fbc-81e9-8488f57b7566" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2z+4" :db/id #edb/ref 17592186504176} {:answer/id #uuid "6b1aee99-c06b-5e49-889b-b7b106beb421" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3z+4" :db/id #edb/ref 17592186504219} {:answer/id #uuid "80a4c9b3-c7c7-5c88-a811-ea10d3447e52" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3z-4" :db/id #edb/ref 17592186504256} {:answer/id #uuid "b6ea043f-71dc-55a6-85e3-43551c5df0ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z+4" :db/id #edb/ref 17592186504348}] :answer-field/correct {:db/id #edb/ref 17592186504219} :answer-field/id #uuid "d8ee21a4-8187-5196-bc40-be0eccd3b690" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186504584}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b758fdc7-6117-52fe-b304-75d15ade9ee4" :question/math-academy-id "q-144248" :question/problem "Simplify the expression $-z-(2z-4).$" :question/worked-solution "First, we remove the parentheses by distributing the negative sign. This gives\n\n$$\n-z-2z+4\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}-z-2z+4 & = \\\\ (-z-2z)+4 & = \\\\ -3z+4 & \\end{aligned}\n$$"} :step/id #uuid "476044c1-7592-5496-b5a8-09989c9fdef0"} {:db/id #edb/ref 17592186504736 :step/content {:db/id #edb/ref 17592186188950 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "503a5a0c-6d91-57c6-948d-dc1e42b752c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2+3x" :db/id #edb/ref 17592186504177} {:answer/id #uuid "7896240f-c609-59c4-ad0e-5e18c1ac5585" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2-x" :db/id #edb/ref 17592186504238} {:answer/id #uuid "e47bba09-a7c0-55d0-b09a-a6c628a5c61a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6-x" :db/id #edb/ref 17592186504426} {:answer/id #uuid "f49610d5-614f-58e0-bcf7-ba25b5bd037f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2-3x" :db/id #edb/ref 17592186504458} {:answer/id #uuid "f78366f5-867d-50a1-aae2-976f8223d54e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6-3x" :db/id #edb/ref 17592186504462}] :answer-field/correct {:db/id #edb/ref 17592186504458} :answer-field/id #uuid "f7c1fbb4-4134-53c6-a8fa-ae4d00ea2050" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186187776}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fb908c23-fe0f-52b8-bd9d-1f4c58233cb6" :question/math-academy-id "q-57060" :question/problem "$5-3(x+1)=$" :question/worked-solution "Notice that the expression we need to subtract from $5$ must be expanded using the distributive law. \n\nSo first, let's write some big brackets around the expression in parentheses, keeping the minus sign *outside*.\n\n$$\n5-[3(x+1)]\n$$\n\nNext, we expand the expression inside the brackets using the distributive law. This gives\n\n$$\n5-[3x+3].\n$$\n\nNow, we remove the brackets by distributing the negative sign. This gives\n\n$$\n5-3x-3.\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}5-3x-3 & = \\\\ (5-3)-3x & = \\\\ 2-3x & \\end{aligned}\n$$"} :step/id #uuid "caf89608-4574-585a-892a-4ade1daf1ba9" :step/next {:db/id #edb/ref 17592186504712}}] :activity/title "Simplifying Linear Expressions When a Group of Terms Is Subtracted" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186504026}] [{:activity/expected-seconds 1140.0 :activity/first-step {:db/id #edb/ref 17592186055656} :activity/id #uuid "0c86ff1c-1fc9-55e7-bf07-5e59726ce644" :activity/scope {:db/id #edb/ref 17592186049520 :topic/id #uuid "fc088d7c-dbfc-5873-80cb-82bec1e45e30" :topic/math-academy-id 85} :activity/steps [{:db/id #edb/ref 17592186055656 :step/content {:db/id #edb/ref 17592186055936 :tutorial/content "The **greatest common factor** (or ![](images/86/861891fd828ee3558330774b23f5dcee69976d8f302da6f1e6825bf3b4be47e6.svg)) of ![](images/f5/f5a17e5e4e88d2fd8eed0ac09f0e02d77507121fac42d5f696cf407aaab6185c.svg) and ![](images/2f/2fd89ffbc3140e9c2f12576c1dec2522d603c45e8b1d4128c02892f651c6e6bb.svg) is the largest expression that will divide *both* ![](images/f5/f5a17e5e4e88d2fd8eed0ac09f0e02d77507121fac42d5f696cf407aaab6185c.svg) and ![](images/2f/2fd89ffbc3140e9c2f12576c1dec2522d603c45e8b1d4128c02892f651c6e6bb.svg) with no remainder.\n\nTo find the GCF, we list the factors of the coefficients and then identify any variable factors the expressions have in common.\n\nThe factors of ![](images/f5/f5a17e5e4e88d2fd8eed0ac09f0e02d77507121fac42d5f696cf407aaab6185c.svg) are\n![](images/05/05dbff97b169f70d1dd03beb2c23670b48520c5d98a839d218db50a06518fbf6.svg)\n\nThe factors of ![](images/34/34d666f013d8ce4f2b50c0a9ab9c2b5808feb37163ba38470555867babada4ef.svg) are\n![](images/59/59919e2659e3bb232e4dbc1857c9f0eca27706bbad72aea6a55bb749706307a2.svg)\n\nThe common factors of ![](images/f5/f5a17e5e4e88d2fd8eed0ac09f0e02d77507121fac42d5f696cf407aaab6185c.svg) and ![](images/34/34d666f013d8ce4f2b50c0a9ab9c2b5808feb37163ba38470555867babada4ef.svg) are\n![](images/b0/b08502484874a42582d63ddfc0eda0048576d0cc460aced250ad962721d0e985.svg)\n\nThe greatest of these common factors is ![](images/fe/fe34f715005da1a8b682c9650a76785673fdf25c3b7c7546bb94824470c54caf.svg)\n\nNow we look at the variable factors. Since ![](images/f5/f5a17e5e4e88d2fd8eed0ac09f0e02d77507121fac42d5f696cf407aaab6185c.svg) has no variable and ![](images/2f/2fd89ffbc3140e9c2f12576c1dec2522d603c45e8b1d4128c02892f651c6e6bb.svg) contains ![](images/5a/5aac2c81021f3f9e468e7840c5f95ece35c10b894bdae19ec1d247bdeb47ac6f.svg) there are no variable factors in common.\n\nThus, the greatest common factor of ![](images/f5/f5a17e5e4e88d2fd8eed0ac09f0e02d77507121fac42d5f696cf407aaab6185c.svg) and ![](images/2f/2fd89ffbc3140e9c2f12576c1dec2522d603c45e8b1d4128c02892f651c6e6bb.svg) is ![](images/fe/fe34f715005da1a8b682c9650a76785673fdf25c3b7c7546bb94824470c54caf.svg)" :tutorial/id #uuid "b2b71877-6097-5d59-a2b8-7440bd0d5329" :tutorial/math-academy-id 1360 :tutorial/title "Introduction"} :step/id #uuid "c78d0b7d-678e-5655-a213-713eadefdc2c" :step/math-academy-id 629467 :step/next {:db/id #edb/ref 17592186055657}} {:db/id #edb/ref 17592186055657 :step/content {:db/id #edb/ref 17592186054687 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054588 :question/id #uuid "6ce77198-a3b2-5e9b-98d5-db8922addc1a" :question/math-academy-id "e-816"} :knowledge-point/id #uuid "92176bb0-84dc-5fa4-8154-e974c05fff06" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049540} {:db/id #edb/ref 17592186051009}] :knowledge-point/questions [{:db/id #edb/ref 17592186055262} {:db/id #edb/ref 17592186055400} {:db/id #edb/ref 17592186459236} {:db/id #edb/ref 17592186459247}] :knowledge-point/title "Finding the Greatest Common Factor of a Number and a Variable Expression"} :step/id #uuid "ed6a9f50-301e-58d1-8a60-afe81d9aaa27" :step/math-academy-id 629468 :step/next {:db/id #edb/ref 17592186055658}} {:db/id #edb/ref 17592186055658 :step/content {:db/id #edb/ref 17592186054688 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054589 :question/id #uuid "f4d78520-1050-5ca1-a2da-1b813269dd9d" :question/math-academy-id "e-817"} :knowledge-point/id #uuid "01ac1e8c-128c-5c13-b845-105092ae74d6" :knowledge-point/questions [{:db/id #edb/ref 17592186055263} {:db/id #edb/ref 17592186055265} {:db/id #edb/ref 17592186459211} {:db/id #edb/ref 17592186459222} {:db/id #edb/ref 17592186459257} {:db/id #edb/ref 17592186534064}] :knowledge-point/title "Finding the Greatest Common Factor of Two Variable Expressions"} :step/id #uuid "0a66a45e-e56e-5d68-a099-199219a3f0cc" :step/math-academy-id 629471 :step/next {:db/id #edb/ref 17592186055763}} {:db/id #edb/ref 17592186055763 :step/content {:db/id #edb/ref 17592186054756 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054489 :question/id #uuid "7bc66df5-26b7-5eb0-b756-f8b086607209" :question/math-academy-id "e-1520"} :knowledge-point/id #uuid "ee5e58b3-f6d7-56e2-bccd-97095e94495e" :knowledge-point/questions [{:db/id #edb/ref 17592186055264} {:db/id #edb/ref 17592186055402} {:db/id #edb/ref 17592186459281} {:db/id #edb/ref 17592186459285}] :knowledge-point/title "Finding the Greatest Common Factor of Three Variable Expressions"} :step/id #uuid "13969cc3-8838-5efa-96ad-09b1b4177c3f" :step/math-academy-id 629474}] :activity/title "The Greatest Common Factor of Two Linear Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054927}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186055897} :activity/id #uuid "1741802a-ec50-5bf7-99b5-64889f83ba7d" :activity/scope {:db/id #edb/ref 17592186049714 :topic/id #uuid "0d37b7c6-5217-5761-9584-b301738c5f16" :topic/math-academy-id 125} :activity/steps [{:db/id #edb/ref 17592186055897 :step/content {:db/id #edb/ref 17592186056006 :tutorial/content "We've already seen that $5^2$ means $5\\cdot 5,$ and that $5^3$ means $5\\cdot 5 \\cdot 5.$ We can extend this to have any number in the exponent, for example\n\n$$\n5^{\\color{blue}7} = \\underbrace{5\\cdot 5\\cdot 5\\cdot 5\\cdot 5\\cdot 5 \\cdot 5}_{\\large{\\color{blue}7} \\textrm{ copies of } 5}.\n$$\n\nThe **exponent** $({\\color{blue}7})$ says how many times the **base** $(5)$ is multiplied by itself.\n\nRecall that $5^2$ is said as \"five squared\" and that $5^3$ is \"five cubed.\" We don't have special names for larger exponents. However, we can say $5^7$  in several different ways:\n\n- \"five raised to the seventh power,\"\n\n- \"five raised to the power seven,\"\n\n- \"five to the seventh power,\"\n\n- \"five to the power seven.\"\n\nRaising to the power of one is special. Any number raised to the first power is itself. For example, $5^{\\color{blue}1}$ means one copy of $5,$ so $5^{\\color{blue}1} = 5.$" :tutorial/id #uuid "964b1381-44c4-5a32-832a-ec441cc4a890" :tutorial/math-academy-id 8020 :tutorial/title "Introduction"} :step/id #uuid "bb689754-aa8e-5f1a-bf8d-0c16cbd2123a" :step/math-academy-id 74297 :step/next {:db/id #edb/ref 17592186055898}} {:db/id #edb/ref 17592186055898 :step/content {:db/id #edb/ref 17592186054842 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054371 :question/id #uuid "890b54a1-db53-5a05-bdba-1477aed3461a" :question/math-academy-id "e-12792"} :knowledge-point/id #uuid "40e41bd9-1eee-552d-8507-e8cdf50ddfa4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050838}] :knowledge-point/questions [{:db/id #edb/ref 17592186055097} {:db/id #edb/ref 17592186055275} {:db/id #edb/ref 17592186055517} {:db/id #edb/ref 17592186475940}] :knowledge-point/title "Expressing a Product Using an Exponent"} :step/id #uuid "e9014a35-b28c-5285-9282-5aba8ec6ac64" :step/math-academy-id 74298 :step/next {:db/id #edb/ref 17592186055899}} {:db/id #edb/ref 17592186055899 :step/content {:db/id #edb/ref 17592186054843 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054372 :question/id #uuid "757d0b35-b4ce-5573-bffd-5badc527bc40" :question/math-academy-id "e-12793"} :knowledge-point/id #uuid "85e60062-7218-5aab-a67a-2cc84f7ad973" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050287}] :knowledge-point/questions [{:db/id #edb/ref 17592186054938} {:db/id #edb/ref 17592186055100} {:db/id #edb/ref 17592186055101} {:db/id #edb/ref 17592186475954} {:db/id #edb/ref 17592186475956}] :knowledge-point/title "Evaluating an Exponential Expression"} :step/id #uuid "54b5575d-a602-5aa6-b10e-76a946359f7d" :step/math-academy-id 74302 :step/next {:db/id #edb/ref 17592186055900}} {:db/id #edb/ref 17592186055900 :step/content {:db/id #edb/ref 17592186054844 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054373 :question/id #uuid "93e87899-2b3f-5a97-9a86-538b1acc34b5" :question/math-academy-id "e-12794"} :knowledge-point/id #uuid "1f2cde7b-5f1d-57d0-b24c-c215d83a1936" :knowledge-point/questions [{:db/id #edb/ref 17592186055009} {:db/id #edb/ref 17592186055010} {:db/id #edb/ref 17592186475926} {:db/id #edb/ref 17592186475960}] :knowledge-point/title "Raising a Number to the Power of One"} :step/id #uuid "156590f0-8245-5a72-b5e9-95d4b42d678f" :step/math-academy-id 74306}] :activity/title "Exponents With Rational Bases" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054878}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186074901} :activity/id #uuid "71a6f31c-0bb8-5061-8779-9e3b7984d66e" :activity/scope {:db/id #edb/ref 17592186049868 :topic/id #uuid "19c222a3-03e5-5eb1-b6c2-e026705f9eda" :topic/math-academy-id 573} :activity/steps [{:db/id #edb/ref 17592186074898 :step/content {:db/id #edb/ref 17592186073898 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073587 :question/id #uuid "fb5d2269-5350-5d79-9414-1a25caa48d8c" :question/math-academy-id "e-2647"} :knowledge-point/id #uuid "1d9b6948-92f4-58b3-8c06-fae61765dc57" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049688} {:db/id #edb/ref 17592186050517}] :knowledge-point/questions [{:db/id #edb/ref 17592186074463} {:db/id #edb/ref 17592186074466} {:db/id #edb/ref 17592186441866} {:db/id #edb/ref 17592186441867} {:db/id #edb/ref 17592186441869} {:db/id #edb/ref 17592186441871} {:db/id #edb/ref 17592186538992}] :knowledge-point/title "Finding the Horizontal Distance Between Two Points"} :step/id #uuid "123d2929-5563-5b7e-8588-e7734bb4eb42" :step/math-academy-id 8890 :step/next {:db/id #edb/ref 17592186074899}} {:db/id #edb/ref 17592186074899 :step/content {:db/id #edb/ref 17592186073899 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073588 :question/id #uuid "1250785a-1ae3-5218-925a-0eac01281f3f" :question/math-academy-id "e-2648"} :knowledge-point/id #uuid "f0708cd3-0608-5d57-ac14-4c16ef362473" :knowledge-point/questions [{:db/id #edb/ref 17592186074465} {:db/id #edb/ref 17592186074467} {:db/id #edb/ref 17592186441863} {:db/id #edb/ref 17592186441864} {:db/id #edb/ref 17592186441872} {:db/id #edb/ref 17592186441873} {:db/id #edb/ref 17592186495146} {:db/id #edb/ref 17592186495173} {:db/id #edb/ref 17592186525009} {:db/id #edb/ref 17592186527128} {:db/id #edb/ref 17592186527138}] :knowledge-point/title "Finding the Vertical Distance Between Two Points"} :step/id #uuid "f954535e-e2c6-5a01-85b8-f90fdccafc1b" :step/math-academy-id 8891 :step/next {:db/id #edb/ref 17592186074902}} {:db/id #edb/ref 17592186074900 :step/content {:db/id #edb/ref 17592186073900 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073589 :question/id #uuid "e05457af-60c5-519f-935e-db465fc76efa" :question/math-academy-id "e-2649"} :knowledge-point/id #uuid "83bbdad9-c2a5-5caa-a4e9-2a0c904c605b" :knowledge-point/questions [{:db/id #edb/ref 17592186074468} {:db/id #edb/ref 17592186074469} {:db/id #edb/ref 17592186441865} {:db/id #edb/ref 17592186441868} {:db/id #edb/ref 17592186441870} {:db/id #edb/ref 17592186495116} {:db/id #edb/ref 17592186527153} {:db/id #edb/ref 17592186527168} {:db/id #edb/ref 17592186531593}] :knowledge-point/title "Finding the Distance Between Two Points: Crossing the Axis"} :step/id #uuid "3a335606-3bdb-5535-8956-9a3ababd7eb1" :step/math-academy-id 8892} {:db/id #edb/ref 17592186074901 :step/content {:db/id #edb/ref 17592186074978 :tutorial/content "The distance between two points in the coordinate plane is the number of units between them. Let's explore two methods for calculating the horizontal distance between two points with the points $(1,1)$ and $(5,1).$\n\n**Method 1** \n\nThe distance between two points is the length of the line segment that connects them.\n\nFirst, we plot the given points in the coordinate plane.\n\n![](images/19/196c50295e8d8a95084c31226fb9319ede7b70603d894b6939e4615df583c29c.png)\n\nFrom the diagram, we see that the length of the segment is $4$ units, so the distance equals $4.$\n\n![](images/4b/4b531e29616f3e8d7ea0c65761e59cfea224b9c0e756c68b7647c7271dc09493.png)\n\n**Method 2**\n\nWe can find the distance between the two points by finding the distance of each point from the $y$-axis and then subtracting.\n\n![](images/6d/6d5c6760e15098dc381e639cd806b6410f2fa6d9049d11d5467427635c9872b6.png)\n\nThe point $({\\color{blue}{1}},1)$ is at a distance of $\\color{blue}{1}$ from the $y$-axis, and the point $({\\color{red}{5}},1)$ is at a distance of $\\color{red}{5}$ from the $y$-axis. Therefore, the distance between the two points is ${\\color{red}{5}} - {\\color{blue}{1}} = 4.$" :tutorial/id #uuid "aeee8d0d-20f6-5700-8c35-c66e0eef8daa" :tutorial/math-academy-id 2199 :tutorial/title "Introduction"} :step/id #uuid "1961bdcc-cea7-5d78-88c1-4f69e1dab833" :step/math-academy-id 8895 :step/next {:db/id #edb/ref 17592186074898}} {:db/id #edb/ref 17592186074902 :step/content {:db/id #edb/ref 17592186074979 :tutorial/content "When we want to find the distance between two points in different quadrants, method 1 works exactly the same, but method 2 is slightly different.\n\nWe can find the distance between the two points by finding the distance of each point from the $y$-axis for a horizontal distance, or $x$-axis for a vertical distance, and then *adding*. \n\nSo, what's the distance between $(-3,2)$ and $(1,2)?$\n\n**Method 1** \n\nWe plot the given points in the coordinate plane.\n\n![](images/e0/e0fec8fca43b421b62efc3d6d892563c80beaab3c2816be47aa7563868555268.png)\n\nThe distance between two points is the length of the line segment that connects them.\n\nFrom the diagram, we see that the length of the segment is $4$ units, so the distance equals $4.$\n\n![](images/dd/ddc1e6cec323fe245ff2a115a587e773d408dc0115ba5002c02ac1d238620c63.png)\n\n**Method 2**\n\nWe can find the distance between the two points by finding the distance of each point from the $y$-axis and then adding.\n\n![](images/0b/0bbb91fc8c0e7ad577261dcdbc8e7aaa16a44e8be2e937e2d6870aae58af4ccf.png)\n\nThe point $({\\color{blue}{1}},2)$ is at a distance of $\\color{blue}{1}$ from the $y$-axis, and the point $({\\color{red}{-3}},2)$ is at a distance of $\\color{red}{3}$ from the $y$-axis. Therefore, the distance between the two points is ${\\color{red}{3}} + {\\color{blue}{1}} = 4.$" :tutorial/id #uuid "a1233efd-87e1-5707-9b70-24c24ed47418" :tutorial/math-academy-id 2204 :tutorial/title "The Distance Between Two Points in Different Quadrants"} :step/id #uuid "d97c5e30-e125-5cba-9973-1e1898eca20e" :step/math-academy-id 8947 :step/next {:db/id #edb/ref 17592186074900}}] :activity/title "Distances Between Points in the Coordinate Plane" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073991}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186495267} :activity/id #uuid "4ad6406f-28ca-5b57-94e6-4b4cc6fef04e" :activity/scope {:db/id #edb/ref 17592186049868 :topic/id #uuid "19c222a3-03e5-5eb1-b6c2-e026705f9eda" :topic/math-academy-id 573} :activity/steps [{:db/id #edb/ref 17592186495237 :step/content {:db/id #edb/ref 17592186495116 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5bdc2701-e79a-5b33-86a6-ef27722a55d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186494506} {:answer/id #uuid "6822bf50-caeb-554f-938f-a5cc8683af71" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186494526} {:answer/id #uuid "80300fbe-d90a-591a-928d-9196db5a2240" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186494596} {:answer/id #uuid "b85c490c-92e9-5030-a0f6-291132b15fa4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186494748} {:answer/id #uuid "dceb000c-8083-5f83-9e97-ae002b6b6ba1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186494841}] :answer-field/correct {:db/id #edb/ref 17592186494506} :answer-field/id #uuid "7a673c29-4fae-58d2-bcf6-86accdee64d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186494972}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "95857c13-ed71-5f23-a1a7-f058676d3273" :question/math-academy-id "q-161670" :question/problem "What is the distance between the points $(-1,5)$  and $(3,5)?$" :question/worked-solution "**Method 1** \n\nWe plot the given points in the coordinate plane.\n\n![](images/74/74dfce8c8444a841f9f742d70204d82b22157bf5b955bb2691eb0cdefe62fb75.png)\n\nThe distance between two points is the length of the line segment that connects them.\n\nFrom the diagram, we see that the length of the segment is $4$ units, so the distance equals $4.$\n\n![](images/4d/4df0d2515a43236634f934879d6a4d8926cc09163f79216ce288e07e2ba28e72.png)\n\n**Method 2**\n\nWe can find the distance between the two points by finding the distance of each point from the $y$-axis and then adding.\n\n![](images/aa/aaf091301a2b004e80bef49a2893eed00f0a28693d8799ee366ed47425869a9c.png)\n\nThe point $(-1,5)$ is at a distance of $1$ from the $y$-axis, and the point $(3,5)$ is at a distance of $3$ from the $y$-axis. Therefore, the distance between the two points is $1+3=4.$"} :step/id #uuid "a89caa7f-1651-5452-aad2-2238b199389e"} {:db/id #edb/ref 17592186495257 :step/content {:db/id #edb/ref 17592186495173 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42efa052-c9ab-54d8-9f6d-f34afac5ba39" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186494453} {:answer/id #uuid "6ec87af5-64e1-5fd2-bd75-166d861e724a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186494553} {:answer/id #uuid "70a17d06-9360-5c19-9fa3-a5b4fb34974f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186494559} {:answer/id #uuid "c731f4ef-fe9c-53df-889c-769685b74d4a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186494787} {:answer/id #uuid "ea8a321d-e3fc-594f-880d-2f2880f86d49" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186494873}] :answer-field/correct {:db/id #edb/ref 17592186494553} :answer-field/id #uuid "7857e68d-f576-5073-be69-923b7ef4e7c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186494970}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fce25e13-2247-5592-b858-9038960a704e" :question/math-academy-id "q-61243" :question/problem "What is the distance between the points $(-5,-2)$  and $(-5,-9)?$" :question/worked-solution "**Method 1** \n\nWe plot the given points in the coordinate plane.\n\n![](images/35/353bedad7a1692dea35f8b6adf30b7b461458c7852b4123a3fc865e1b23370a6.png)\n\nThe distance between two points is the length of the line segment that connects them.\n\nFrom the diagram, we see that the length of the segment is $7$ units, so the distance equals $7.$\n\n![](images/e3/e3516729d7662a3b4438a3d3085da3428605d026ba3387a71afeb085e2bd3e73.png)\n\n**Method 2**\n\nWe can find the distance between the two points by finding the distance of each point from the $x$-axis and then subtracting.\n\n![](images/f8/f8c5583d14d4e5ca50df3ce906254446c402177734f352169d794de2bb7dea5c.png)\n\nThe point $(-5,-2)$ is at a distance of $2$ from the $x$-axis, and the point $(-5,-9)$ is at a distance of $9$ from the $x$-axis. Therefore, the distance between the two points is $9-2=7.$"} :step/id #uuid "d5842dc7-b1b5-522c-8151-6d2e56afbed8" :step/next {:db/id #edb/ref 17592186495237}} {:db/id #edb/ref 17592186495267 :step/content {:db/id #edb/ref 17592186495146 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4844ffa7-9148-54b8-9e72-b30c1cb0c11e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186494463} {:answer/id #uuid "800b7dfe-1222-53bf-82a3-9afc3077f999" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186494595} {:answer/id #uuid "b32d799a-1971-505f-9d44-6d88dea78839" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186494736} {:answer/id #uuid "cde81723-b01c-5413-aefe-9f6e7a2f5589" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186494806} {:answer/id #uuid "ee3d1b5c-cd0f-5511-8f83-2c24cef83452" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186494883}] :answer-field/correct {:db/id #edb/ref 17592186494736} :answer-field/id #uuid "ce35d819-2898-51ad-bcff-556e53b6cc07" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186495016}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d345ec95-0d6e-5d8e-a681-8aa64a38a770" :question/math-academy-id "q-61238" :question/problem "What is the distance between the points $(-2,2)$  and $(-2,7)?$" :question/worked-solution "**Method 1** \n\nWe plot the given points in the coordinate plane.\n\n![](images/39/39ac0f7718d7ee4ca8ed96b43c4f5ff9b644e0a3f7b5e2629052468b36ccf687.png)\n\nThe distance between two points is the length of the line segment that connects them.\n\nFrom the diagram, we see that the length of the segment is $5$ units, so the distance equals $5.$\n\n![](images/59/5995f7494a28a33cc4bdeef51d7d4cc0a85ee8e3219d8630d366c50345629d54.png)\n\n**Method 2**\n\nWe can find the distance between the two points by finding the distance of each point from the $x$-axis and then subtracting.\n\n![](images/1c/1cb541f6fcbb93b30a8f154763b0daa60e3b76142db1001ce804a2a68ba79247.png)\n\nThe point $(-2,7)$ is at a distance of $7$ from the $x$-axis, and the point $(-2,2)$ is at a distance of $2$ from the $x$-axis. Therefore, the distance between the two points is $7-2=5.$"} :step/id #uuid "ef3e2ccc-1312-5209-8ec4-fde9203f2c0d" :step/next {:db/id #edb/ref 17592186495257}}] :activity/title "Distances Between Points in the Coordinate Plane" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186494305}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186527232} :activity/id #uuid "6400b63d-ece5-55c3-ace8-f3cf09eb034e" :activity/scope {:db/id #edb/ref 17592186049868 :topic/id #uuid "19c222a3-03e5-5eb1-b6c2-e026705f9eda" :topic/math-academy-id 573} :activity/steps [{:db/id #edb/ref 17592186527232 :step/content {:db/id #edb/ref 17592186527128 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02dbb7c8-1405-51e2-be89-1394776caad6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186526506} {:answer/id #uuid "0cc1dfda-0971-51d2-b2f6-fd8adfa0f1ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186526529} {:answer/id #uuid "24e265ed-ab68-54e6-95e4-cfa966d948c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186526583} {:answer/id #uuid "cf7ea040-309d-5faf-bab9-81177579d7ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186526900} {:answer/id #uuid "d456bc45-475c-5809-ba80-4e99f3a8ac38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186526911}] :answer-field/correct {:db/id #edb/ref 17592186526529} :answer-field/id #uuid "6c47ba7d-aa0c-5abb-a75b-b6921e6c2540" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527063}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0a27d18e-df05-520d-948c-41b1732464a2" :question/math-academy-id "q-60606" :question/problem "![](images/84/84da1d1bb056c8c5d823a585889699e3ba3fe5ca7b2706b4e0a16c96f2e65ac3.png)\n\nWhat is the distance between the points $(3,1)$  and $(3,4)?$" :question/worked-solution "**Method 1** \n\nThe distance between two points is the length of the line segment that connects them.\n\nFrom the diagram, we see that the length of the segment is $3$ units, so the distance equals $3.$\n\n![](images/a0/a0eb36fd37d73ed20e0ee17717f80cb33a56910cc57eb181897ad44197a7f268.png)\n\n**Method 2**\n\nWe can find the distance between the two points by finding the distance of each point from the $x$-axis and then subtracting.\n\n![](images/2b/2b4771270aec2dd62828f4063262cfaf81fba31f6be6d1a2ba8bfe0d59778b48.png)\n\nThe point $(3,4)$ is at a distance of $4$ from the $x$-axis, and the point $(3,1)$ is at a distance of $1$ from the $x$-axis. Therefore, the distance between the two points is $4-1=3.$"} :step/id #uuid "12252c44-f6ed-5a4c-877a-529ad585fdea" :step/next {:db/id #edb/ref 17592186527255}} {:db/id #edb/ref 17592186527243 :step/content {:db/id #edb/ref 17592186527153 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "068e3080-4337-581d-9b8b-cc0e663f7828" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186526516} {:answer/id #uuid "0a1c255d-9fb4-5411-b2aa-255dce8090e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186526524} {:answer/id #uuid "155fbdce-2870-53b4-bdf7-758d24346ab9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186526545} {:answer/id #uuid "21bbce83-c3c6-5f3b-ac9d-a19684c5d630" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186526575} {:answer/id #uuid "b70f45a0-ba84-55de-ab9d-38674206db65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186526855}] :answer-field/correct {:db/id #edb/ref 17592186526516} :answer-field/id #uuid "ba2c0b6c-0868-582f-9fb0-8f7239a4a7d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527091}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3ab19b4a-4627-54ee-8e9e-8d051f6ac141" :question/math-academy-id "q-61265" :question/problem "What is the distance between the points $(-3,2)$  and $(-3,-4)?$" :question/worked-solution "**Method 1** \n\nWe plot the given points in the coordinate plane.\n\n![](images/c0/c0dcef8b6c0c63e17fc9b516e3e3176f054dd0eddb93c71375a3de3272da9623.png)\n\nThe distance between two points is the length of the line segment that connects them.\n\nFrom the diagram, we see that the length of the segment is $6$ units, so the distance equals $6.$\n\n![](images/c1/c1764499f4600d5c74c598b205e0a1971ca91231c4464f77e0809a680003bf11.png)\n\n**Method 2**\n\nWe can find the distance between the two points by finding the distance of each point from the $x$-axis and then adding.\n\n![](images/5b/5b4c4c665b07575604dc873703517548404d7c31e8395070642ca37584c6d08f.png)\n\nThe point $(-3,2)$ is at a distance of $2$ from the $x$-axis, and the point $(-3,-4)$ is at a distance of $4$ from the $x$-axis. Therefore, the distance between the two points is $4+2=6.$"} :step/id #uuid "35f258ab-51ea-5cc4-ab06-dadec569e07a"} {:db/id #edb/ref 17592186527255 :step/content {:db/id #edb/ref 17592186527168 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "199f5bd1-cf24-5ec5-87fb-e715dfad0524" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186526557} {:answer/id #uuid "4446140c-ebf8-5421-a61b-bfae02059671" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186526633} {:answer/id #uuid "7e700299-d0cc-5e63-95d1-97a04cb6ea9a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186526752} {:answer/id #uuid "921e2d09-f58f-50dc-91f3-e6324b399fae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186526789} {:answer/id #uuid "9dd79885-eb4b-5b18-8642-27db39ab655a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186526808}] :answer-field/correct {:db/id #edb/ref 17592186526557} :answer-field/id #uuid "7a86d0ab-34e6-5c19-97fc-00a0a1fc39ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527070}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "67699b33-3e46-5c7c-ad2b-2f6df6bd8eb1" :question/math-academy-id "q-61105" :question/problem "![](images/25/25e1891ce31fa7043723b2dcb4cd1e01c41dbd82ae70ef5024c64ed2d6deab33.png)\n\nWhat is the distance between the points $(-3,1)$  and $(-3,-5)?$" :question/worked-solution "**Method 1** \n\nThe distance between two points is the length of the line segment that connects them.\n\nFrom the diagram, we see that the length of the segment is $6$ units, so the distance equals $6.$\n\n![](images/1f/1f3eeede9aa301cf6d64b48cc86f770fc86517ed51285da9bdc86e5a580b243f.png)\n\n**Method 2**\n\nWe can find the distance between the two points by finding the distance of each point from the $x$-axis and then adding.\n\n![](images/a5/a504ca22769a377cd7e23e0b6a09595d00c8ad25733f3d1e6a716b52f262e139.png)\n\nThe point $(-3,-5)$ is at a distance of $5$ from the $x$-axis, and the point $(-3,1)$ is at a distance of $1$ from the $x$-axis. Therefore, the distance between the two points is $5+1=6.$"} :step/id #uuid "5c465ab7-ebb0-5979-8fd6-300e20ddd25b" :step/next {:db/id #edb/ref 17592186527287}} {:db/id #edb/ref 17592186527287 :step/content {:db/id #edb/ref 17592186074465 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff3933f1-5330-5a93-bd06-b1a968921e45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186073029} {:answer/id #uuid "038610b4-8855-5613-ad62-a56e0c0f24e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186073030} {:answer/id #uuid "288f063e-1947-5a0f-8867-d300a95793d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186073031} {:answer/id #uuid "3d64ff07-ead1-5334-9540-a844d96b19ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186073032} {:answer/id #uuid "4eced26e-1801-553d-a9a9-d047aee0b82a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186073033}] :answer-field/correct {:db/id #edb/ref 17592186073031} :answer-field/id #uuid "723fead1-3866-508a-9080-2df0ed86113b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186073028}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3943d606-fff6-5e9c-a446-2d4378743487" :question/math-academy-id "q-61224" :question/problem "What is the distance between the points $(4,2)$  and $(4,8)?$" :question/worked-solution "**Method 1** \n\nWe plot the given points in the coordinate plane.\n\n![](images/66/66c988b7fede0e97eae46388dd0e57aee2c49a3c185c9a888277da8fefc947ab.png)\n\nThe distance between two points is the length of the line segment that connects them.\n\nFrom the diagram, we see that the length of the segment is $6$ units, so the distance equals $6.$\n\n![](images/63/63f70c20c918dae51ecddc7891a8cbee7c5749720521e62fe26e9bc4e33bb9e6.png)\n\n**Method 2**\n\nWe can find the distance between the two points by finding the distance of each point from the $x$-axis and then subtracting.\n\n![](images/d3/d3693b8c3d07636143b2c77c3bd2645015885b77ec4e8ddffde2e121da0511bc.png)\n\nThe point $(4,8)$ is at a distance of $8$ from the $x$-axis, and the point $(4,2)$ is at a distance of $2$ from the $x$-axis. Therefore, the distance between the two points is $8-2=6.$"} :step/id #uuid "f27b2fa2-b4cf-5259-af6d-f395c41888da" :step/next {:db/id #edb/ref 17592186527243}}] :activity/title "Distances Between Points in the Coordinate Plane" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186526490}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186111613} :activity/id #uuid "dc520173-74e8-57e7-ad6f-9e7a82ef78e1" :activity/scope {:db/id #edb/ref 17592186049892 :topic/id #uuid "1c2006c0-c4c4-5ff8-8fa2-7f9dd3693f49" :topic/math-academy-id 1500} :activity/steps [{:db/id #edb/ref 17592186111613 :step/content {:db/id #edb/ref 17592186111906 :tutorial/content "For any two distinct points, there is always one (and only one) line that passes through them.\n\nFor example, the line passing through the points $P$ and $Q$ is $\\overset{\\longleftrightarrow}{PQ},$ while the line that passes through $A$ and $B$ is $\\overset{\\longleftrightarrow}{AB}\\mathbin{:}$\n\n![](images/8c/8c79a551e7ced71de157ea292baa3d7f38afaca4ea76ee467fc4add1b28ed33f.png)\n\nHowever, given three or more points, there is not always a line that passes through all of them.\n\nFor example, for the three points $F, G,$ and $H$ below, it is impossible to draw a single straight line that passes through all of them.\n\n![](images/30/30361c0bd49e571e317746f2d88848626da52e5ddbcda8fe9b6f496e4aff6b69.png)\n\nHowever, it is *sometimes* possible to draw a line through three (or more) points. In such cases, we say that the points are **collinear**.\n\nFor example, the points $M,$ $N,$ and $O$ shown below are collinear since they all lie on the same line.\n\n![](images/bf/bf3de55518c21de30718b2d9fee7032139c89aa3a4a963b8346b457ceafbeada.png)" :tutorial/id #uuid "051ac95a-dc63-5270-a5fa-a498a36c8297" :tutorial/math-academy-id 6732 :tutorial/title "Introduction"} :step/id #uuid "2afa6da4-491a-5a31-8b50-09bd210fc929" :step/math-academy-id 40727 :step/next {:db/id #edb/ref 17592186111615}} {:db/id #edb/ref 17592186111614 :step/content {:db/id #edb/ref 17592186110674 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110295 :question/id #uuid "a042ba66-3567-5b06-84e6-344ad0043bbc" :question/math-academy-id "e-10748"} :knowledge-point/id #uuid "f67c3319-1153-51ed-a57a-f85c06c7e76c" :knowledge-point/questions [{:db/id #edb/ref 17592186110905} {:db/id #edb/ref 17592186111394} {:db/id #edb/ref 17592186441206} {:db/id #edb/ref 17592186441209} {:db/id #edb/ref 17592186441210} {:db/id #edb/ref 17592186441212} {:db/id #edb/ref 17592186527150}] :knowledge-point/title "Determining Whether Points on Intersecting Lines Are Collinear"} :step/id #uuid "08fe2b06-8140-5116-be8c-f9a047f0e538" :step/math-academy-id 40728} {:db/id #edb/ref 17592186111615 :step/content {:db/id #edb/ref 17592186110675 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110296 :question/id #uuid "76902823-634d-5525-afc5-5f2a98cea481" :question/math-academy-id "e-10749"} :knowledge-point/id #uuid "9ef4e321-841e-5933-b5e4-ff7dab6c5275" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049350}] :knowledge-point/questions [{:db/id #edb/ref 17592186110928} {:db/id #edb/ref 17592186110929} {:db/id #edb/ref 17592186441205} {:db/id #edb/ref 17592186441207} {:db/id #edb/ref 17592186441208} {:db/id #edb/ref 17592186441211} {:db/id #edb/ref 17592186524990} {:db/id #edb/ref 17592186531608} {:db/id #edb/ref 17592186531655} {:db/id #edb/ref 17592186531657}] :knowledge-point/title "Identifying Collinear Points on a Grid"} :step/id #uuid "f4bbacca-99b9-57fe-b9c5-a2075ef9663b" :step/math-academy-id 40731 :step/next {:db/id #edb/ref 17592186111614}}] :activity/title "Collinear Points" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110859}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186531680} :activity/id #uuid "1e277d26-3cd4-5f96-8fca-4798fc8680e1" :activity/scope {:db/id #edb/ref 17592186049892 :topic/id #uuid "1c2006c0-c4c4-5ff8-8fa2-7f9dd3693f49" :topic/math-academy-id 1500} :activity/steps [{:db/id #edb/ref 17592186531676 :step/content {:db/id #edb/ref 17592186531655 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fe09bc4-31c7-568f-be87-02c28b0907ab" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186530929} {:answer/id #uuid "4160685f-7ffd-5ade-9845-5db543cb5598" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186531003} {:answer/id #uuid "88414189-b1f0-5218-8c18-851c2eff974f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186531162} {:answer/id #uuid "c0e424dc-7e89-5bd6-b6e8-84d2d9dea85f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186531271} {:answer/id #uuid "ec66f155-3fe5-5781-8a8a-8f6d97fb5483" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186531341}] :answer-field/correct {:db/id #edb/ref 17592186531341} :answer-field/id #uuid "ff504920-6a29-5379-af64-ee43cc431a4a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186531555}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f44be398-7e63-5657-97ac-ad7b78dba187" :question/math-academy-id "q-155051" :question/problem "![](images/01/01aba7550fb134b1f3a93276dc8f3b91794844ea21254c2c75a0702a443a60e3.png)\n\nWhich of the diagrams above shows three collinear points?" :question/worked-solution "Three (or more) points are collinear if a straight line passes through all points.\n\nWith that in mind, let's examine our diagrams in turn.\n\n- Diagram I shows three collinear points. There is a straight line that passes through all three of these points.\n\n![](images/63/6310ff39996be529bc44e5058ef9710400f0c8089196a57e7f4eb541703e53ae.png)\n\n- Diagram II shows three points that are *not* collinear. We can't draw a straight line that passes through all three points.\n\n![](images/63/6334d2bc1fda6390b6ec542afb8cc37d4f76322b98d41ca6bbb3af3c8d735c8f.png)\n\n- Diagram III shows three points that are *not* collinear. We can't draw a straight line that passes through all three points.\n\n![](images/89/8939cff2d7cc8ca9a08c7be63517ffb900e49b769edc5c2454119f4da25904cc.png)\n\n \n\nTherefore, the correct answer is \"I only.\""} :step/id #uuid "2a5c9c16-0e21-58e2-96cf-f2e548e46cfb"} {:db/id #edb/ref 17592186531680 :step/content {:db/id #edb/ref 17592186111394 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb0faf0f-5618-54d9-89a7-80c77140df42" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186110090} {:answer/id #uuid "f86d63d7-74b3-530e-91d9-8ff31f761445" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186110091} {:answer/id #uuid "479e057f-e9e5-52df-ba3d-412259c39194" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186110092} {:answer/id #uuid "6af6be9b-f51c-5bcf-b37a-cca78ef06518" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186110093} {:answer/id #uuid "6ccc7e23-2f5e-5bc7-b82f-ad9500638c6f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186110094}] :answer-field/correct {:db/id #edb/ref 17592186110091} :answer-field/id #uuid "cfb9f9a8-0793-550e-8000-7cbb65bc3ee6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186110089}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7d9ca7f7-8b8f-513d-9055-bfafe5f332c2" :question/math-academy-id "q-7484" :question/problem "![](images/d1/d1fd1460fe24739d1c1bf1a7cad39da6775860b0764eaa4b41fffaae073e3a50.png)\n\nGiven the picture shown above, which of the following statements are true?\n\nI. $E$, $G$ and $H$ are collinear\n\nII. $A$, $B$ and $G$ are **not** collinear\n\nIII. $B$, $F$ and $H$ are collinear" :question/worked-solution "Three (or more) points are collinear if a straight line passes through all points.\n\nWith that in mind, let's examine our diagrams in turn.\n\n- Statement I is true. There is a straight line that passes through these three points.\n\n![](images/fb/fb82255ac578efc90bb070dab669a19950387cab7d9011de4d5d0d94dd9de505.png)\n\n- Statement II is true. We can't draw a straight line that passes through these three points.\n\n![](images/2c/2c20ebe076b3e655b7709ccb337c68d4aa8505bfabdb5a8755e5a1410642d612.png)\n\n- Statement III is false. We can't draw a straight line that passes through these three points.\n\n![](images/98/9859ea0144923d69e37d64130910608f6fc3e7afe09d74af19a5402030e0d3cb.png)\n\nTherefore, the correct answer is \"I and II only.\""} :step/id #uuid "31152b20-4269-5712-98a1-7b73a2698d69" :step/next {:db/id #edb/ref 17592186531693}} {:db/id #edb/ref 17592186531693 :step/content {:db/id #edb/ref 17592186531608 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23cd9f25-8435-55d5-b158-0660cc1531d5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186530942} {:answer/id #uuid "2caca10d-0d8d-59c0-ac12-d60468871006" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186530962} {:answer/id #uuid "7b3c3526-8bc0-510b-9c22-722374cff8f4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186531135} {:answer/id #uuid "d4bd80d9-e2bb-50d2-8715-080b48547162" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186531303} {:answer/id #uuid "f3622c66-9de1-5f33-ba19-0af4be6d1d74" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186531360}] :answer-field/correct {:db/id #edb/ref 17592186531360} :answer-field/id #uuid "3c338420-c385-5c49-a1ce-a9b479af623d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186531439}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "73e5dd6e-2c47-5055-afc2-9cc17f2d620e" :question/math-academy-id "q-155031" :question/problem "![](images/97/97faa2ca35485f76f012475a9ba2b6af7938cfc86728bddd560cf3da59fff197.png)\n\nWhich of the diagrams above shows three collinear points?" :question/worked-solution "Three (or more) points are collinear if a straight line passes through all points.\n\nWith that in mind, let's examine our diagrams in turn.\n\n- Diagram I shows three collinear points. There is a straight line that passes through all three of these points.\n\n![](images/f5/f52592db0fee86e26318d6d2de9d7f685f1fb9f5d416628a04878857f1c54b54.png)\n\n- Diagram II shows three points that are *not* collinear. We can't draw a straight line that passes through all three points.\n\n![](images/76/76f0da764caf0237a2d30d32d593886d8df6c348368fe889f7447be781b6faf1.png)\n\n- Diagram III shows three collinear points. There is a straight line that passes through all three of these points.\n\n![](images/97/9778abd955cdc9b705800eba8f3d0d635af1c6a5fd5724583bdb32a943c6d44f.png)\n\nTherefore, the correct answer is \"I and III only.\""} :step/id #uuid "765a5c07-dcf7-5bfa-9917-01071a277a0b" :step/next {:db/id #edb/ref 17592186531676}}] :activity/title "Collinear Points" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186530854}] [{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186074893} :activity/id #uuid "48334486-8ae7-5572-8e8f-b176d6318f35" :activity/scope {:db/id #edb/ref 17592186050138 :topic/id #uuid "2fda426e-c98b-5b36-800a-304f9ce90e0d" :topic/math-academy-id 554} :activity/steps [{:db/id #edb/ref 17592186074893 :step/content {:db/id #edb/ref 17592186075038 :tutorial/content "Let's take a look at the following equivalent ratios:\n\n![](images/6c/6cda61e0fbd0d9695644a29f0c6fa3478eae84cf253623da7f4b544f35873472.svg)\n\nWe can place the equivalent ratios in a **ratio table**, such as the one below. In a ratio table, each row represents a ratio.\n\n| ${\\color{blue}5}$ | ${\\color{red}10}$ |\n| --- | --- |\n| ${\\color{blue}10}$ | $\\bbox[3pt,Gainsboro]{\\color{red}\\textrm{?}}$ |\n| ${\\color{blue}20}$ | ${\\color{red}40}$ |\n\nOne number is missing. Let's figure out what it is.\n\nWe start with the ratio ${\\color{blue}5}:{\\color{red}10},$ which is the first ratio in the table. Writing this ratio as a fraction, we have\n\n$$\n\\dfrac{{\\color{blue}5}}{{\\color{red}10}}.\n$$\n\nThe numerator represents the left-hand entry (${\\color{blue}5}$), and the denominator represents the right-hand entry (${\\color{red}10}$).\n\nTo find the missing number, we need to make a numerator of ${\\color{blue}10}.$ We can do this by multiplying the numerator and denominator by $2$:\n\n$$\n\\begin{aligned}\\frac{5\\times 2}{10\\times 2} & =\\frac{10}{20}\\end{aligned}\n$$\n\nWe now add this to our ratio table:\n\n| ${\\color{blue}5}$ | ${\\color{red}10}$ |\n| --- | --- |\n| ${\\color{blue}10}$ | $\\bbox[3pt,Gainsboro]{\\color{red}20}$ |\n| ${\\color{blue}20}$ | ${\\color{red}40}$ |\n\nSo, the missing number is $\\color{red}20.$" :tutorial/id #uuid "ca7b3d51-7281-5705-bed5-276f34939c25" :tutorial/math-academy-id 8357 :tutorial/title "Introduction"} :step/id #uuid "ac8583b6-39eb-5a51-9b51-c3c4ebec13fa" :step/math-academy-id 81656 :step/next {:db/id #edb/ref 17592186074894}} {:db/id #edb/ref 17592186074894 :step/content {:db/id #edb/ref 17592186073894 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073453 :question/id #uuid "8e2f5bec-3573-5f1d-9870-41ac26b1ddf2" :question/math-academy-id "e-13342"} :knowledge-point/id #uuid "b9357cc9-e383-5d88-9741-f49f6fbcca99" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049733} {:db/id #edb/ref 17592186050481}] :knowledge-point/questions [{:db/id #edb/ref 17592186074048} {:db/id #edb/ref 17592186074049} {:db/id #edb/ref 17592186455472} {:db/id #edb/ref 17592186455473}] :knowledge-point/title "Filling a Ratio Table by Multiplying: Missing Denominators"} :step/id #uuid "f054590d-449e-5753-b1fc-569c01699cad" :step/math-academy-id 81657 :step/next {:db/id #edb/ref 17592186074895}} {:db/id #edb/ref 17592186074895 :step/content {:db/id #edb/ref 17592186073895 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073455 :question/id #uuid "e2ada4db-c1f0-53b0-9af7-ee2712ae75ef" :question/math-academy-id "e-13409"} :knowledge-point/id #uuid "6e3287b0-2ecb-5d83-9596-7943d68f8884" :knowledge-point/questions [{:db/id #edb/ref 17592186074024} {:db/id #edb/ref 17592186074384} {:db/id #edb/ref 17592186455446} {:db/id #edb/ref 17592186455501} {:db/id #edb/ref 17592186538941}] :knowledge-point/title "Filling a Ratio Table by Multiplying: Missing Numerators"} :step/id #uuid "aab5d8f4-9d49-5c7f-9619-01557ca3969b" :step/math-academy-id 81660 :step/next {:db/id #edb/ref 17592186074896}} {:db/id #edb/ref 17592186074896 :step/content {:db/id #edb/ref 17592186073896 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073454 :question/id #uuid "11fac5c9-ca4a-54a6-9f38-3c675411673e" :question/math-academy-id "e-13343"} :knowledge-point/id #uuid "60021495-9d2a-58a5-9321-bb16013bbba7" :knowledge-point/questions [{:db/id #edb/ref 17592186073996} {:db/id #edb/ref 17592186074050} {:db/id #edb/ref 17592186455439} {:db/id #edb/ref 17592186455465} {:db/id #edb/ref 17592186533991}] :knowledge-point/title "Filling a Ratio Table by Multiplying and Dividing"} :step/id #uuid "bd74231b-139c-5091-8fd3-66103c7f1329" :step/math-academy-id 81663 :step/next {:db/id #edb/ref 17592186074897}} {:db/id #edb/ref 17592186074897 :step/content {:db/id #edb/ref 17592186073897 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073456 :question/id #uuid "f1a6757d-3e68-5263-a6c7-d03c73391848" :question/math-academy-id "e-13410"} :knowledge-point/id #uuid "84a526bf-9d98-54e1-a54e-cd625bbaea49" :knowledge-point/questions [{:db/id #edb/ref 17592186074385} {:db/id #edb/ref 17592186074398} {:db/id #edb/ref 17592186455467} {:db/id #edb/ref 17592186455502}] :knowledge-point/title "Word Problems"} :step/id #uuid "b13509a4-8a23-5240-a77b-f79cb3691c99" :step/math-academy-id 81666}] :activity/title "Ratio Tables" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073973}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186176625} :activity/id #uuid "a4ff07dc-a8f7-53b1-8ab9-7a78e691a8a6" :activity/scope {:db/id #edb/ref 17592186050204 :topic/id #uuid "3609f48c-4b74-5e7c-8832-d67903fa5696" :topic/math-academy-id 3552} :activity/steps [{:db/id #edb/ref 17592186176625 :step/content {:db/id #edb/ref 17592186176970 :tutorial/content "Let's calculate $(\\sqrt{100})^2$ by performing each operation one step at a time:\n\n$$\n(\\sqrt{\\color{blue}100})^2 = \\left(\\sqrt{{\\color{red}10}^2}\\right)^2 = ({\\color{red}10})^2 = {\\color{blue}100}\n$$\n\nNotice that the squaring the square root gives the number under the square root:\n\n$$\n\\left( \\sqrt{100} \\right)^2 = 100\n$$\n\nThis result holds in general for any non-negative number. If $\\color{blue}\\square$ is any positive number or zero, then\n\n$$\n(\\sqrt{\\color{blue}\\square})^2 = {\\color{blue}\\square}\\,.\n$$\n\nThe square and the square root cancel each other out, and we're left with the number that we started with.\n\n![](images/1f/1fa29ca192dc3fb99f4180c300aa3120064e3682361d175a698b1d457a569ba0.png)" :tutorial/id #uuid "871b272d-6a05-5ad2-b443-785a6abbd186" :tutorial/math-academy-id 3093 :tutorial/title "Introduction"} :step/id #uuid "e1e25251-ada4-572c-af12-8dec4f2cc93b" :step/math-academy-id 16791 :step/next {:db/id #edb/ref 17592186176626}} {:db/id #edb/ref 17592186176626 :step/content {:db/id #edb/ref 17592186175916 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175774 :question/id #uuid "a4796dd0-e8ee-5ffe-b96c-6646c209d4be" :question/math-academy-id "e-4609"} :knowledge-point/id #uuid "5a937bb0-da50-5be0-a007-dce431a84282" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050358}] :knowledge-point/questions [{:db/id #edb/ref 17592186176484} {:db/id #edb/ref 17592186176489} {:db/id #edb/ref 17592186447326} {:db/id #edb/ref 17592186447328}] :knowledge-point/title "Finding the Square of a Square Root"} :step/id #uuid "8bcb8880-f2b7-5129-b867-7a66c1a6f8d9" :step/math-academy-id 16792 :step/next {:db/id #edb/ref 17592186176627}} {:db/id #edb/ref 17592186176627 :step/content {:db/id #edb/ref 17592186176971 :tutorial/content "We must be careful when taking the square root of a negative number that's been squared.\n\nFor example, $\\sqrt{(-9)^2}$ is *not* equal to $-9!$ We can write this using a **not equal to** symbol $\\neq$ as\n\n$$\n\\sqrt{(-9)^2}  \\neq -9.\n$$\n\nThis is because the square root of a number can *only* be positive or zero, never negative.\nLet's work it out the long way:\n\n$$\n\\begin{aligned}\\sqrt{(-9)^{2}} & = \\\\ \\sqrt{(-9)\\cdot (-9)} & = \\\\ \\sqrt{81} & = \\\\ \\sqrt{{9}^{2}} & = \\\\ 9\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n\\sqrt{(-9)^2}=\\sqrt{9^2} = 9.\n$$\n\nFor any positive perfect square, we always have exactly two numbers whose squares equal that number. Here, we have\n\n$$\n9^2=81\\quad \\textrm{and} \\quad (-9)^2=81.\n$$\n\nBut *by definition* the square root is always *positive* (or zero) and *cannot* be negative. So here, $\\sqrt{81}=+9,$ and for any non-negative $\\color{blue}\\square$ we get\n\n$$\n\\sqrt{\\color{blue}\\square} \\geq 0.\n$$" :tutorial/id #uuid "27f63bb3-bf90-584e-b96c-d999c482f4e4" :tutorial/math-academy-id 3094 :tutorial/title "The Square Root of a Negative Number Squared"} :step/id #uuid "b53578db-d74c-51c3-a032-b84c8468af3c" :step/math-academy-id 16793 :step/next {:db/id #edb/ref 17592186176628}} {:db/id #edb/ref 17592186176628 :step/content {:db/id #edb/ref 17592186175917 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175775 :question/id #uuid "0e96044b-b1f8-5d33-85ec-6a6a7f1fec6c" :question/math-academy-id "e-4610"} :knowledge-point/id #uuid "0f524f08-137f-56e6-8a6d-a45c3dae2635" :knowledge-point/questions [{:db/id #edb/ref 17592186176482} {:db/id #edb/ref 17592186176483} {:db/id #edb/ref 17592186447327} {:db/id #edb/ref 17592186447329} {:db/id #edb/ref 17592186482577} {:db/id #edb/ref 17592186482600}] :knowledge-point/title "Finding the Square Root of a Negative Number Squared"} :step/id #uuid "b246c6a3-8aeb-5a46-904f-bf555b6a6441" :step/math-academy-id 16794}] :activity/title "Squaring a Square Root" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186176103}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186482623} :activity/id #uuid "5b7f0e4f-3348-59d7-a1d5-4c76f7ddaa47" :activity/scope {:db/id #edb/ref 17592186050204 :topic/id #uuid "3609f48c-4b74-5e7c-8832-d67903fa5696" :topic/math-academy-id 3552} :activity/steps [{:db/id #edb/ref 17592186482623 :step/content {:db/id #edb/ref 17592186176484 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a024b6e6-f598-5bfb-9c5b-9891ec143e43" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186175043} {:answer/id #uuid "ad93111b-ae82-568b-baa1-a2eb0e8edcfe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186175044} {:answer/id #uuid "ef209fb7-1988-5052-bb3c-b7bb08c2e94a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186175045} {:answer/id #uuid "05007abd-c0fb-50e9-936d-298b4ff76f0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-64" :db/id #edb/ref 17592186175046} {:answer/id #uuid "7d39ed9e-f884-5860-88d1-2fe2375e50b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "64" :db/id #edb/ref 17592186175047}] :answer-field/correct {:db/id #edb/ref 17592186175047} :answer-field/id #uuid "325a11df-fa0e-5ef9-9315-be877024bfaa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186175042}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4cf96200-b795-57c8-ab21-303d7b2f1640" :question/math-academy-id "q-40878" :question/problem "What is $(\\sqrt{64})^{2}?$" :question/worked-solution "The number in the square root is non-negative, so the square and the square root cancel each other out.\n\nTherefore, we have\n\n$$\n(\\sqrt{64})^{2}=64.\n$$"} :step/id #uuid "10c71a29-7215-5eb1-a413-a092dcb8ff4c" :step/next {:db/id #edb/ref 17592186482643}} {:db/id #edb/ref 17592186482643 :step/content {:db/id #edb/ref 17592186482577 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0561decb-7e57-5d8d-98fc-79752f342f51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-36" :db/id #edb/ref 17592186481781} {:answer/id #uuid "445ae046-f9c4-5f28-92c9-c8ffe97025d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186481944} {:answer/id #uuid "dfb477dd-f26c-5b3f-8833-6f12839a60d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "36" :db/id #edb/ref 17592186482304} {:answer/id #uuid "e2a559a8-743c-5e88-8b4d-b691e17f2fef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pm 6" :db/id #edb/ref 17592186482309} {:answer/id #uuid "e759f29b-0ea4-5a5d-b64b-64a3e53e26b4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Not a real number" :db/id #edb/ref 17592186482328}] :answer-field/correct {:db/id #edb/ref 17592186482304} :answer-field/id #uuid "61228407-9b50-5d5e-8859-cbf8ab07e73b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186482425}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ad6df804-3e3c-5d45-acbc-edbd4509746d" :question/math-academy-id "q-69750" :question/problem "What is $\\sqrt{{(-36)}^{2}}?$" :question/worked-solution "Remember that by definition, the square root is always zero or positive, never negative.\n\nSo, the square root comes out to\n\n$$\n\\sqrt{(-36)^{2}}=\\sqrt{{36}^{2}}=36.\n$$"} :step/id #uuid "9d0e2d7e-42c8-5bfc-81a6-2d2b8834e576" :step/next {:db/id #edb/ref 17592186482653}} {:db/id #edb/ref 17592186482653 :step/content {:db/id #edb/ref 17592186482600 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14ae428d-aab0-5f78-89db-42a367dcd699" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "121" :db/id #edb/ref 17592186481831} {:answer/id #uuid "1e086f22-20d2-508d-b0b6-19a9f7aabcf9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186481853} {:answer/id #uuid "293ea8b6-0d2c-5afd-9cd6-0ed4ad1a7ae8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-11" :db/id #edb/ref 17592186481880} {:answer/id #uuid "3ef2e639-78a9-5bc6-8bf4-6296ef202694" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pm 121" :db/id #edb/ref 17592186481932} {:answer/id #uuid "9bf5b202-ccac-5fa4-b851-c67dd1c3fb4d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Not a real number" :db/id #edb/ref 17592186482145}] :answer-field/correct {:db/id #edb/ref 17592186481831} :answer-field/id #uuid "6c44f552-1870-5d06-b54a-efa25d989250" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186482433}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "da6d460c-dde7-5fc1-ac50-c5ee168f1351" :question/math-academy-id "q-71565" :question/problem "What is $\\sqrt{{(-121)}^{2}}?$" :question/worked-solution "Remember that by definition, the square root is always zero or positive, never negative.\n\nSo, the square root comes out to\n\n$$\n\\sqrt{(-121)^{2}}=\\sqrt{{121}^{2}}=121.\n$$"} :step/id #uuid "dd5c2617-10d3-5d03-a33c-d87b258640bb"}] :activity/title "Squaring a Square Root" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186481768}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186074877} :activity/id #uuid "b18f153a-24ae-52c2-833b-f1d51a752952" :activity/scope {:db/id #edb/ref 17592186050948 :topic/id #uuid "7447137e-4148-57e3-9e8c-8ef64742b913" :topic/math-academy-id 561} :activity/steps [{:db/id #edb/ref 17592186074877 :step/content {:db/id #edb/ref 17592186074968 :tutorial/content "Remember that we can place equivalent ratios in a ratio table, like the one below.\n\n| $\\color{blue}x$ | $\\color{red}y$ |\n| --- | --- |\n| $\\color{blue}1$ | $\\color{red}2$ |\n| $\\color{blue}2$ | $\\color{red}4$ |\n| $\\color{blue}4$ | $\\color{red}8$ |\n\nBy setting the values in the left column as $\\color{blue}x$-coordinates and the values in the right column as the corresponding $\\color{red}y$-coordinates, we can graph the points to represent a relationship between the ratios.\n\nIn this case, we have the following ordered pairs: $({\\color{blue}1},{\\color{red}2}),$ $({\\color{blue}2},{\\color{red}4}),$ $({\\color{blue}4},{\\color{red}8}).$\n\nPlotting these points on a coordinate plane, we get the following graph:\n\n![](images/0c/0c4abb8d462730ed9b532feeca1e0a800f5376a978bfc799afb9d9a927ff310d.png)\n\nConnecting the points gives us a straight line! Plotting equivalent ratios will *always* give a straight line. Furthermore, the straight line will *always* pass through the origin $(0,0).$" :tutorial/id #uuid "05d7bd91-e8b4-5ada-936f-6036f766cf23" :tutorial/math-academy-id 2053 :tutorial/title "Introduction"} :step/id #uuid "e3c01e56-883c-55ab-9e6a-10ceb0575884" :step/math-academy-id 7803 :step/next {:db/id #edb/ref 17592186074878}} {:db/id #edb/ref 17592186074878 :step/content {:db/id #edb/ref 17592186073883 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073565 :question/id #uuid "9a740a80-f655-5d20-a839-d9a809d4c6a4" :question/math-academy-id "e-2285"} :knowledge-point/id #uuid "a1c72ed5-ab55-5815-b0a2-9a88eb15d362" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049682} {:db/id #edb/ref 17592186050138}] :knowledge-point/questions [{:db/id #edb/ref 17592186074417} {:db/id #edb/ref 17592186074418} {:db/id #edb/ref 17592186455438} {:db/id #edb/ref 17592186455492}] :knowledge-point/title "Graphing Ratios"} :step/id #uuid "5eafd168-51d7-5307-98d8-6cbe0835f715" :step/math-academy-id 7804 :step/next {:db/id #edb/ref 17592186074879}} {:db/id #edb/ref 17592186074879 :step/content {:db/id #edb/ref 17592186073884 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073566 :question/id #uuid "ce72406a-a57e-53b5-b066-f147e197d317" :question/math-academy-id "e-2287"} :knowledge-point/id #uuid "08c2f97b-d178-59b0-b58f-b273ddc2ec1d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050078}] :knowledge-point/questions [{:db/id #edb/ref 17592186074428} {:db/id #edb/ref 17592186074429} {:db/id #edb/ref 17592186455429} {:db/id #edb/ref 17592186542159}] :knowledge-point/title "Determining a Ratio From a Graph"} :step/id #uuid "7b457667-0972-5621-9729-0ef04c05c3b0" :step/math-academy-id 7807 :step/next {:db/id #edb/ref 17592186074880}} {:db/id #edb/ref 17592186074880 :step/content {:db/id #edb/ref 17592186073885 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073568 :question/id #uuid "a0c6e401-4364-575d-94d2-97108b688d43" :question/math-academy-id "e-2289"} :knowledge-point/id #uuid "309e24a1-6c8c-5705-beca-001fed696acc" :knowledge-point/questions [{:db/id #edb/ref 17592186074397} {:db/id #edb/ref 17592186074430} {:db/id #edb/ref 17592186455440} {:db/id #edb/ref 17592186455455} {:db/id #edb/ref 17592186534056}] :knowledge-point/title "