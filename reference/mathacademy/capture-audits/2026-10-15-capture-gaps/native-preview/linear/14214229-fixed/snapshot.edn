\\text{d}x}({x}^{2})+2\\frac{\\text{d}}{\\text{d}x}(x)+6\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =2x+2+6{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={(2x+2+6{e}^{x})\\,|}_{x=0} \\\\  & =2\\cdot 0+2+6\\cdot {e}^{0} \\\\  & =2+6\\cdot 1 \\\\  & =8.\\end{aligned}\n$$"} :step/expected-seconds 90.0 :step/id #uuid "6c7a0ccc-737a-46dc-a6da-45334c4508ff" :step/next {:db/id 17592186480002}} {:answer-field/choices [{:answer/id #uuid "1859eb59-5659-5101-b949-46d66d579831" :answer/type {:db/id 17592186045498} :answer/value "8e" :db/id 17592186269472} {:answer/id #uuid "1c0e81a7-1d07-50d3-b00e-dd0c50955d37" :answer/type {:db/id 17592186045498} :answer/value "2+6e" :db/id 17592186269501} {:answer/id #uuid "2d71f9f8-72d8-5409-b4ca-0645cd6983b2" :answer/type {:db/id 17592186045498} :answer/value "1+6e" :db/id 17592186269679} {:answer/id #uuid "c2ca486a-dc13-5bb9-932e-532847144371" :answer/type {:db/id 17592186045498} :answer/value "6e" :db/id 17592186270990} {:answer/id #uuid "c5a796d4-403d-5aad-82ff-004acd0b4a0e" :answer/type {:db/id 17592186045498} :answer/value "8" :db/id 17592186271012}] :answer-field/correct {:db/id 17592186271012} :answer-field/id #uuid "d0c8b5dd-9fdc-5213-98ff-f269c094b6e2" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493} :db/id 17592186271882} {:answer/id #uuid "1859eb59-5659-5101-b949-46d66d579831" :answer/type {:db/id 17592186045498} :answer/value "8e" :db/id 17592186269472} {:answer/id #uuid "1c0e81a7-1d07-50d3-b00e-dd0c50955d37" :answer/type {:db/id 17592186045498} :answer/value "2+6e" :db/id 17592186269501} {:answer/id #uuid "2d71f9f8-72d8-5409-b4ca-0645cd6983b2" :answer/type {:db/id 17592186045498} :answer/value "1+6e" :db/id 17592186269679} {:answer/id #uuid "c2ca486a-dc13-5bb9-932e-532847144371" :answer/type {:db/id 17592186045498} :answer/value "6e" :db/id 17592186270990} {:answer/id #uuid "c5a796d4-403d-5aad-82ff-004acd0