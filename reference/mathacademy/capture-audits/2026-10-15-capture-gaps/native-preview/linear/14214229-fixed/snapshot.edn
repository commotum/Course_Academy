63d-53dc-91b3-3f3e99aa0687"} {:db/id 17592186480017 :question/id #uuid "5184f338-d6d0-533d-88bb-8b37da109e6c"} {:db/id 17592186480023 :question/id #uuid "5f698a42-ae62-5802-8f77-88360f877560"} {:db/id 17592186480027 :question/id #uuid "78a2b5f7-5cef-5012-a53c-264a4e19606b"} {:db/id 17592186480034 :question/id #uuid "b423e41e-b9ca-54b7-896b-f125c7eb77b4"} {:db/id 17592186480041 :question/id #uuid "cf08154e-5ad6-5738-b7be-7d9a74b0856c"} {:db/id 17592186480044 :question/id #uuid "e471cfb8-b421-5129-be11-398f77d53a45"} {:db/id 17592186480048 :question/id #uuid "f32ccf8c-9eba-53b7-a331-a184e3771a1b"} {:db/id 17592186524982 :question/id #uuid "451b7f5e-73c7-5775-8944-779b29e93099" :question/math-academy-id "q-340053"} {:db/id 17592186525017 :question/id #uuid "9cb89f9e-c6cf-5b21-994c-7efe5115b691" :question/math-academy-id "q-304018"}] :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Constant"} {:db/id 17592186096410 :question/id #uuid "8e4367b2-f7bc-5588-b30b-d612915e3e68" :question/math-academy-id "e-3624" :knowledge-point/_canonical-example [{:db/id 17592186096610 :knowledge-point/id #uuid "bb40a0ff-c3b5-512d-a436-cc2fce456008" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Constant"}] :question/problem "Given that $f(x)=3e^x + \\ln 3$, find $f'(x).$" :question/worked-solution "The derivative of $e^x$ is just $e^x$ itself. On the other hand, $\\ln 3$ is a constant, so its derivative is $0.$\n\nUsing the addition rule, then, we have \n\n$$\n\\eqalign{\nf'(x) &= \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(3e^x + \\ln 3\\right)\\\n                                                  &= \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left( 3e^x\\right) +  \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left( \\ln 3 \\right)\\\n                                                  &= 3\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(e^x\\right) + 0\\\n                                                  &= 3 e^x.\n}\n$$"} {:db/id 17592186048932} {:db/id 17592186480049} {:db/id 17592186097160 :question/id #uuid "c5e514ba-2b59-510b-8545-fa3adc383ab3" :question/math-academy-id "q-1927"} {:db/id 17592186097316 :question/id #uuid "32d48a7b-7bcb-5f18-b8f4-b39f8f7670ef" :question/math-academy-id "q-51208"} {:db/id 17592186237849 :question/id #uuid "987874a9-79ce-51e5-b80a-f5a44c3f0800" :question/math-academy-id "q-101587"} {:db/id 17592186237850 :question/id #uuid "cf78a5ba-4334-5b57-bc16-3a848e2f0dba" :question/math-academy-id "q-101590"} {:db/id 17592186314904 :question/id #uuid "6869b95a-63a5-54db-b062-b375ad3ac68d" :question/math-academy-id "q-340056"} {:db/id 17592186314906 :question/id #uuid "19b7181e-4102-59d9-864a-c870a873bbda" :question/math-academy-id "q-340067"} {:db/id 17592186338886 :question/id #uuid "bd4ec376-93b4-54c8-9a98-7640cf3d729e" :question/math-academy-id "q-71053"} {:db/id 17592186480008 :question/id #uuid "24285fdc-6262-5d37-b204-181d4efdc6b1"} {:db/id 17592186480009 :question/id #uuid "27963039-7ab9-50a1-a524-335dda2120d3"} {:db/id 17592186480011 :question/id #uuid "3368f5c9-3775-5d06-9195-e0e05c5824a2"} {:db/id 17592186480014 :question/id #uuid "40eee14f-7f06-5ca0-8856-ee0dc15c1493"} {:db/id 17592186480016 :question/id #uuid "5104b80b-063d-53dc-91b3-3f3e99aa0687"} {:db/id 17592186480017 :question/id #uuid "5184f338-d6d0-533d-88bb-8b37da109e6c"} {:db/id 17592186480023 :question/id #uuid "5f698a42-ae62-5802-8f77-88360f877560"} {:db/id 17592186480027 :question/id #uuid "78a2b5f7-5cef-5012-a53c-264a4e19606b"} {:db/id 17592186480034 :question/id #uuid "b423e41e-b9ca-54b7-896b-f125c7eb77b4"} {:db/id 17592186480041 :question/id #uuid "cf08154e-5ad6-5738-b7be-7d9a74b0856c"} {:db/id 17592186480044 :question/id #uuid "e471cfb8-b421-5129-be11-398f77d53a45"} {:db/id 17592186480048 :question/id #uuid "f32ccf8c-9eba-53b7-a331-a184e3771a1b"} {:db/id 17592186524982 :question/id #uuid "451b7f5e-73c7-5775-8944-779b29e93099" :question/math-academy-id "q-340053" :knowledge-point/_questions [{:db/id 17592186096610 :knowledge-point/id #uuid "bb40a0ff-c3b5-512d-a436-cc2fce456008" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53709e9e-7e4f-52ba-ab20-e6b13619abb3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "9e^{x}" :db/id 17592186524525}] :answer-field/correct {:answer/id #uuid "53709e9e-7e4f-52ba-ab20-e6b13619abb3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "9e^{x}" :db/id 17592186524525} :answer-field/id #uuid "321e32b9-7ce0-5a4e-9141-f36ce7923b8b" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186524862}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/problem "Given that $f(x)=9{e}^{x}-11,$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $-11$ is a constant, so its derivative is $0.$\n\nUsing the addition rule, then, we have \n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(9{e}^{x}-11) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(9{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(-11) \\\\  & =9\\frac{\\text{d}}{\\text{d}x}({e}^{x})+0 \\\\  & =9{e}^{x}.\\end{aligned}\\end{aligned}\n$$"} {:db/id 17592186525017 :question/id #uuid "9cb89f9e-c6cf-5b21-994c-7efe5115b691" :question/math-academy-id "q-304018" :knowledge-point/_questions [{:db/id 17592186096610 :knowledge-point/id #uuid "bb40a0ff-c3b5-512d-a436-cc2fce456008" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25800a6b-d642-5c57-b91d-e8e45649680a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id 17592186524450}] :answer-field/correct {:answer/id #uuid "25800a6b-d642-5c57-b91d-e8e45649680a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id 17592186524450} :answer-field/id #uuid "ff484f27-c600-5f6e-a8a7-362f170f3f67" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186524955}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/problem "Given that $f(x)=4{e}^{x}+17$, the slope of the tangent line at $x=\\operatorname{ln}⁡3$ is{{field-1}}." :question/worked-solution "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $17$ is a constant, so its derivative is $0.$\n\nFirst, using the addition rule, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x}+17) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(17) \\\\  & =4\\frac{\\text{d}}{\\text{d}x}({e}^{x})+0 \\\\  & =4{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=\\operatorname{ln}⁡3$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=\\operatorname{ln}⁡3} & ={(4{e}^{x})\\,|}_{x=\\operatorname{ln}⁡3} \\\\  & =4{e}^{\\operatorname{ln}⁡3} \\\\  & =4\\cdot 3 \\\\  & =12.\\end{aligned}\n$$"} {:db/id 17592186096611 :knowledge-point/canonical-example {:db/id 17592186096411 :question/id #uuid "48334c0c-a49e-5dfb-9f8a-8caa0c22d1f9" :question/math-academy-id "e-3625"} :knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/question-generator {:db/id 17592186480109} :knowledge-point/questions [{:db/id 17592186096989 :question/id #uuid "be52e61b-18d3-573c-9b27-5eaa6fa86e49" :question/math-academy-id "q-11728"} {:db/id 17592186096990 :question/id #uuid "b6d07184-6bd9-5ef7-9517-a325fafb836a" :question/math-academy-id "q-11730"} {:db/id 17592186235457 :question/id #uuid "413988df-903b-557d-87b6-8594e3b605b0" :question/math-academy-id "q-167636"} {:db/id 17592186235471 :question/id #uuid "cfc04756-ffae-5a03-8a05-d0ea5dfb5207" :question/math-academy-id "q-167694"} {:db/id 17592186272085 :question/id #uuid "d2ffa4af-5dbe-569b-8d78-f233584a8913" :question/math-academy-id "q-140431"} {:db/id 17592186272086 :question/id #uuid "578adda7-12d4-5f1e-a8c7-f591ce6d42cb" :question/math-academy-id "q-140432"} {:db/id 17592186284688 :question/id #uuid "5816a349-a320-5d09-93fc-2ee07a9147af" :question/math-academy-id "q-17247"} {:db/id 17592186284689 :question/id #uuid "a7bb16ef-b727-58e4-9164-1a907f3660c1" :question/math-academy-id "q-17255"} {:db/id 17592186297289 :question/id #uuid "0f66d07e-3ca1-595a-b1d7-b4c775329676" :question/math-academy-id "q-304035"} {:db/id 17592186480052 :question/id #uuid "0e3e6e3a-5c3f-5613-b235-49ab4e4951fc"} {:db/id 17592186480057 :question/id #uuid "2463bece-a1cd-5c87-bc99-c540684a9946"} {:db/id 17592186480059 :question/id #uuid "28f1a34b-c02b-5f32-a2d4-3b8647e374de"} {:db/id 17592186480063 :question/id #uuid "39b1266c-5944-5dcf-b535-d35e41bcefcb"} {:db/id 17592186480079 :question/id #uuid "715a8ac6-fd66-549a-b175-7f154dd14992"} {:db/id 17592186480081 :question/id #uuid "79103b32-86de-5f9f-9f15-ae04d815512a"} {:db/id 17592186480083 :question/id #uuid "7f89f273-a11f-549a-8a60-c366a1c603b1"} {:db/id 17592186480088 :question/id #uuid "a03b064f-d419-5044-8615-d5e461c22029"} {:db/id 17592186480089 :question/id #uuid "a8456306-9118-592b-ba3e-acf608603d3d"} {:db/id 17592186480091 :question/id #uuid "bbc1984d-8d4d-5124-b526-4edb9aabc7e9"} {:db/id 17592186480092 :question/id #uuid "bd74a88f-3e9e-54af-946f-d004983e42ec"} {:db/id 17592186480093 :question/id #uuid "bf13a195-c5b0-5308-8807-0ec8ba1fef3d"} {:db/id 17592186480107 :question/id #uuid "fc8205dd-9383-5240-aa7c-245bff3c1e94"} {:db/id 17592186525040 :question/id #uuid "c8792aa5-0567-5ee4-a5c8-0188d2815575" :question/math-academy-id "q-71061"}] :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"} {:db/id 17592186096411 :question/id #uuid "48334c0c-a49e-5dfb-9f8a-8caa0c22d1f9" :question/math-academy-id "e-3625" :knowledge-point/_canonical-example [{:db/id 17592186096611 :knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/problem "Given that $f(x)=4e^x+ 3x^4 - x^2,$ find $f'(x).$" :question/worked-solution "Using the addition and the power rules, we get\n\n$$\n\\eqalign{ \n                          f'(x)             &= \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(4e^x+3x^{4} - x^2 \\right)\\\n                                             &= \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(4e^x\\right)+\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(3x^{4}\\right) -\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(x^{2}\\right) \\\n\t\t\t\t\t     &= 4\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(e^x\\right)+3\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(x^{4}\\right) - 2x \\\t\t\t\n                                             &=  4 e^x+  3 \\cdot 4x^{3} - 2x \\\n                                             &=  4 e^x+  12x^{3} - 2x.\n}\n$$"} {:db/id 17592186480109} {:db/id 17592186096989 :question/id #uuid "be52e61b-18d3-573c-9b27-5eaa6fa86e49" :question/math-academy-id "q-11728" :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c78d12d-e0a1-56ab-9f9b-0b5ab3109e1b" :answer/type {:db/id 17592186045498} :answer/value "{f}^{′}(x)=5{e}^{x}+4{x}^{2}-3" :db/id 17592186542713} {:answer/id #uuid "207cc40d-fc6f-5da2-b43d-321cce4f0d3b" :answer/type {:db/id 17592186045498} :answer/value "{f}^{′}(x)={e}^{x}+4x" :db/id 17592186542728} {:answer/id #uuid "92c2fe7a-f2f7-5b68-8d4d-cf6414096282" :answer/type {:db/id 17592186045498} :answer/value "{f}^{′}(x)=5{e}^{x}+4x" :db/id 17592186543024} {:answer/id #uuid "9caf9432-187f-5eb0-a837-cd39bf99957b" :answer/type {:db/id 17592186045498} :answer/value "{f}^{′}(x)=5{e}^{x}+4x-3" :db/id 17592186543051} {:answer/id #uuid "c2b5f78e-5928-5e0b-9292-bc6f68419181" :answer/type {:db/id 17592186045498} :answer/value "{f}^{′}(x)=5{e}^{x}+4{x}^{2}" :db/id 17592186543149}] :answer-field/correct {:db/id 17592186543024} :answer-field/id #uuid "7eaf35cc-b950-5185-a9a1-b26eb9ffff7a" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493} :db/id 17592186093908}] :question/difficulty {:db/id 17592186045485} :question/problem "Given that $f(x)=5{e}^{x}+2{x}^{2}-3$, find ${f}^{′}(x).$" :question/worked-solution "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(5{e}^{x}+2{x}^{2}-3) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(5{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(2{x}^{2})-\\frac{\\text{d}}{\\text{d}x}(3) \\\\  & =5\\frac{\\text{d}}{\\text{d}x}({e}^{x})+2\\frac{\\text{d}}{\\text{d}x}({x}^{2})-0 \\\\  & =5{e}^{x}+2(2x)-0 \\\\  & =5{e}^{x}+4x.\\end{aligned}\n$$"} {:db/id 17592186096990 :question/id #uuid "b6d07184-6bd9-5ef7-9517-a325fafb836a" :question/math-academy-id "q-11730"} {:db/id 17592186235457 :question/id #uuid "413988df-903b-557d-87b6-8594e3b605b0" :question/math-academy-id "q-167636"} {:db/id 17592186235471 :question/id #uuid "cfc04756-ffae-5a03-8a05-d0ea5dfb5207" :question/math-academy-id "q-167694" :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58606740-b081-5671-ab93-5b28309b7d77" :answer/type {:db/id 17592186045498} :answer/value "{e}^{x}+2x+1" :db/id 17592186234683}] :answer-field/correct {:db/id 17592186234683} :answer-field/id #uuid "d0bd4a86-aed0-5919-98b7-ad23d53bddbe" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492} :db/id 17592186235226}] :question/difficulty {:db/id 17592186045487} :question/problem "For $x<1,$ ${f}^{′}(x)=$\n\n                            \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        ." :question/worked-solution "For $x<1,$ we use the expression $f(x)={e}^{x}+{x}^{2}+x,$ which is differentiable.\n\nUsing the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({e}^{x}+{x}^{2}+x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({e}^{x})+\\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & ={e}^{x}+2x+1.\\end{aligned}\n$$"} {:db/id 17592186272085 :question/id #uuid "d2ffa4af-5dbe-569b-8d78-f233584a8913" :question/math-academy-id "q-140431" :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0884ad38-9d14-5f8e-b665-d8b35b5af237" :answer/type {:db/id 17592186045498} :answer/value "e+4" :db/id 17592186269346} {:answer/id #uuid "0db0ac08-c4ce-5d3f-845f-d38358413506" :answer/type {:db/id 17592186045498} :answer/value "e+8" :db/id 17592186269388} {:answer/id #uuid "2934301c-7684-5c1f-b910-d7819431eba3" :answer/type {:db/id 17592186045498} :answer/value "2e" :db/id 17592186269640} {:answer/id #uuid "7789397b-7630-5bd8-9c80-42e72f128cee" :answer/type {:db/id 17592186045498} :answer/value "2e+8" :db/id 17592186270328} {:answer/id #uuid "81639cc6-e903-5cd2-bc14-50bfc72b4d70" :answer/type {:db/id 17592186045498} :answer/value "2e+4" :db/id 17592186270388}] :answer-field/correct {:db/id 17592186270328} :answer-field/id #uuid "c7c2979c-8072-5209-9ca0-20ccbaf77003" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493} :db/id 17592186271876}] :question/difficulty {:db/id 17592186045485} :question/problem "Given that $f(x)=2{e}^{x}+4{x}^{2}-3$, find the slope of the tangent at $x=1.$" :question/worked-solution "First, using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2{e}^{x}+4{x}^{2}-3) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(4{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(-3) \\\\  & =2\\frac{\\text{d}}{\\text{d}x}({e}^{x})+4\\frac{\\text{d}}{\\text{d}x}({x}^{2})+0 \\\\  & =2{e}^{x}+8x.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=1} & ={(2{e}^{x}+8x)\\,|}_{x=1} \\\\  & =2\\cdot {e}^{1}+8\\cdot 1 \\\\  & =2e+8.\\end{aligned}\n$$"} {:db/id 17592186272086 :question/id #uuid "578adda7-12d4-5f1e-a8c7-f591ce6d42cb" :question/math-academy-id "q-140432" :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1859eb59-5659-5101-b949-46d66d579831" :answer/type {:db/id 17592186045498} :answer/value "8e" :db/id 17592186269472} {:answer/id #uuid "1c0e81a7-1d07-50d3-b00e-dd0c50955d37" :answer/type {:db/id 17592186045498} :answer/value "2+6e" :db/id 17592186269501} {:answer/id #uuid "2d71f9f8-72d8-5409-b4ca-0645cd6983b2" :answer/type {:db/id 17592186045498} :answer/value "1+6e" :db/id 17592186269679} {:answer/id #uuid "c2ca486a-dc13-5bb9-932e-532847144371" :answer/type {:db/id 17592186045498} :answer/value "6e" :db/id 17592186270990} {:answer/id #uuid "c5a796d4-403d-5aad-82ff-004acd0b4a0e" :answer/type {:db/id 17592186045498} :answer/value "8" :db/id 17592186271012}] :answer-field/correct {:db/id 17592186271012} :answer-field/id #uuid "d0c8b5dd-9fdc-5213-98ff-f269c094b6e2" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493} :db/id 17592186271882}] :question/difficulty {:db/id 17592186045485} :question/problem "Given that $f(x)={x}^{2}+2x+6{e}^{x}$, find the slope of the tangent at $x=0.$" :question/worked-solution "First, using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}+2x+6{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}(2x)+\\frac{\\text{d}}{\\text{d}x}(6{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{2})+2\\frac{\\text{d}}{\\text{d}x}(x)+6\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =2x+2+6{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={(2x+2+6{e}^{x})\\,|}_{x=0} \\\\  & =2\\cdot 0+2+6\\cdot {e}^{0} \\\\  & =2+6\\cdot 1 \\\\  & =8.\\end{aligned}\n$$"} {:db/id 17592186284688 :question/id #uuid "5816a349-a320-5d09-93fc-2ee07a9147af" :question/math-academy-id "q-17247"} {:db/id 17592186284689 :question/id #uuid "a7bb16ef-b727-58e4-9164-1a907f3660c1" :question/math-academy-id "q-17255"} {:db/id 17592186297289 :question/id #uuid "0f66d07e-3ca1-595a-b1d7-b4c775329676" :question/math-academy-id "q-304035" :knowledge-point/_questions [{:db/id 17592186096611 :knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b89210db-d5da-5a48-8355-741becb1873c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "42+\\frac{2}{e}" :db/id 17592186296232} {:answer/id #uuid "c4f887ee-f564-4711-a252-4f52754bf8ba" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "42x^6+2e^{x}" :db/id 17592186409338 :task-item/_responses [{:db/id 17592186409255}]}] :answer-field/correct {:answer/id #uuid "b89210db-d5da-5a48-8355-741becb1873c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "42+\\frac{2}{e}" :db/id 17592186296232} :answer-field/id #uuid "ca439fbc-124d-5dae-b8b3-a85cb6575e03" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186297054}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/problem "Given that $f(x)=6{x}^{7}+2{e}^{x}$, the exact value of the slope of the tangent line at $x=-1$ is{{field-1}}." :question/worked-solution "First, using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(6{x}^{7}+2{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(6{x}^{7})+\\frac{\\text{d}}{\\text{d}x}(2{e}^{x}) \\\\  & =6\\frac{\\text{d}}{\\text{d}x}({x}^{7})+2\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =6(7{x}^{6})+2{e}^{x} \\\\  & =42{x}^{6}+2{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=-1$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=-1} & ={(42{x}^{6}+2{e}^{x})\\,|}_{x=-1} \\\\  & =42(-1)^{6}+2{e}^{-1} \\\\  & =42\\cdot 1+\\frac{2}{e} \\\\  & =42+\\frac{2}{e}.\\end{aligned}\n$$"} {:db/id 17592186480052 :question/id #uuid "0e3e6e3a-5c3f-5613-b235-49ab4e4951fc"} {:db/id 17592186480057 :question/id #uuid "2463bece-a1cd-5c87-bc99-c540684a9946"} {:db/id 17592186480059 :question/id #uuid "28f1a34b-c02b-5f32-a2d4-3b8647e374de"} {:db/id 17592186480063 :question/id #uuid "39b1266c-5944-5dcf-b535-d35e41bcefcb"} {:db/id 17592186480079 :question/id #uuid "715a8ac6-fd66-549a-b175-7f154dd14992"} {:db/id 17592186480081 :question/id #uuid "79103b32-86de-5f9f-9f15-ae04d815512a"} {:db/id 17592186480083 :question/id #uuid "7f89f273-a11f-549a-8a60-c366a1c603b1"} {:db/id 17592186480088 :question/id #uuid "a03b064f-d419-5044-8615-d5e461c22029"} {:db/id 17592186480089 :question/id #uuid "a8456306-9118-592b-ba3e-acf608603d3d"} {:db/id 17592186480091 :question/id #uuid "bbc1984d-8d4d-5124-b526-4edb9aabc7e9"} {:db/id 17592186480092 :question/id #uuid "bd74a88f-3e9e-54af-946f-d004983e42ec"} {:db/id 17592186480093 :question/id #uuid "bf13a195-c5b0-5308-8807-0ec8ba1fef3d"} {:db/id 17592186480107 :question/id #uuid "fc8205dd-9383-5240-aa7c-245bff3c1e94"} {:db/id 17592186525040 :question/id #uuid "c8792aa5-0567-5ee4-a5c8-0188d2815575" :question/math-academy-id "q-71061" :knowledge-point/_questions [{:db/id 17592186096611 :knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13a8ae5e-2b27-5896-8bf1-0e1c78f29b99" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(x)=4{e}^{x}-5{x}^{2}" :db/id 17592186524417} {:answer/id #uuid "a76babff-69cc-5977-a846-865ec261880c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(x)={e}^{x}-9x" :db/id 17592186524648} {:answer/id #uuid "abe87bd5-4230-5c4c-a3fa-4e14394a9de6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(x)=4{e}^{x}-10x-4" :db/id 17592186524657} {:answer/id #uuid "c7f7e59c-61a8-51bc-b810-b28f0b8fe05c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(x)={e}^{x}-15{x}^{2}-4" :db/id 17592186524706} {:answer/id #uuid "f62c6064-bf12-5a1a-94a5-4dec0bfb8ced" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(x)=4{e}^{x}-15{x}^{2}" :db/id 17592186524817}] :answer-field/correct {:answer/id #uuid "f62c6064-bf12-5a1a-94a5-4dec0bfb8ced" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(x)=4{e}^{x}-15{x}^{2}" :db/id 17592186524817} :answer-field/id #uuid "cb8c7399-82f9-563a-b941-a6a1414975f7" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186524926}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/problem "Given that $f(x)=4{e}^{x}-5{x}^{3}-4$, find ${f}^{′}(x).$" :question/worked-solution "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x}-5{x}^{3}-4) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(5{x}^{3})-\\frac{\\text{d}}{\\text{d}x}(4) \\\\  & =4\\frac{\\text{d}}{\\text{d}x}({e}^{x})-5\\frac{\\text{d}}{\\text{d}x}({x}^{3})-\\frac{\\text{d}}{\\text{d}x}(4) \\\\  & =4{e}^{x}-5(3{x}^{2})-0 \\\\  & =4{e}^{x}-15{x}^{2}.\\end{aligned}\n$$"} {:db/id 17592186096612 :knowledge-point/canonical-example {:db/id 17592186096412 :question/id #uuid "16b1a91c-ae83-5e6b-a11d-bb9d78e4d218" :question/math-academy-id "e-3626"} :knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/question-generator {:db/id 17592186479997} :knowledge-point/questions [{:db/id 17592186096991 :question/id #uuid "991df192-1bbb-5ddd-b9f8-9c449c0a2bfd" :question/math-academy-id "q-11732"} {:db/id 17592186097155 :question/id #uuid "e0af69f1-1a58-5ac7-90e2-c2859723b842" :question/math-academy-id "q-1917"} {:db/id 17592186253334 :question/id #uuid "50678a5c-afcb-522f-98fb-80e9680afca6" :question/math-academy-id "q-11735"} {:db/id 17592186284697 :question/id #uuid "3e51c642-d912-5d35-8cf2-7c273fba130d" :question/math-academy-id "q-17388"} {:db/id 17592186297290 :question/id #uuid "4df22161-f9b7-5077-b623-7a70a19c609f" :question/math-academy-id "q-304038"} {:db/id 17592186314919 :question/id #uuid "ca876738-9b8d-5832-85d7-2d09df78130a" :question/math-academy-id "q-340272"} {:db/id 17592186314920 :question/id #uuid "d2b3624c-f62d-5f81-b0de-c13d8e4bf17c" :question/math-academy-id "q-340280"} {:db/id 17592186479956 :question/id #uuid "4ab89b2e-90ef-5667-856a-b34e71dd8ca6"} {:db/id 17592186479960 :question/id #uuid "50148e2c-17f0-5238-804f-16d18ed920ad"} {:db/id 17592186479964 :question/id #uuid "582239d0-9d5e-5fbf-8b8c-312d6a4b25f3"} {:db/id 17592186479971 :question/id #uuid "90f05299-4aec-5aef-a19d-5af09d844fc9"} {:db/id 17592186479973 :question/id #uuid "9227db0a-2b43-5781-8e85-e3ce3701dc2c"} {:db/id 17592186479974 :question/id #uuid "9b5eb51d-f8f2-5555-81b1-c63476f8f13a"} {:db/id 17592186479976 :question/id #uuid "9f8d11c7-1ce6-57ae-a750-00abfd861493"} {:db/id 17592186479981 :question/id #uuid "b4aa7414-d170-5940-95df-f23e78929052"} {:db/id 17592186479982 :question/id #uuid "b995540b-f7ab-55d7-8f91-c51d207d2180"} {:db/id 17592186479989 :question/id #uuid "cf41a068-fd0d-5f4b-9f3b-52ecb794226b"} {:db/id 17592186479990 :question/id #uuid "df5079ea-2748-53c3-9b3e-39ecdb2bea5f"} {:db/id 17592186479993 :question/id #uuid "ec00e600-a612-5a76-94ca-79ecaa3d171e"} {:db/id 17592186479996 :question/id #uuid "f8120d99-4d4d-56ef-af5e-c92f6fe86369"} {:db/id 17592186524984 :question/id #uuid "46572da3-e0a7-57d7-a2f6-062b0d2adadb" :question/math-academy-id "q-140439"} {:db/id 17592186543477 :question/id #uuid "0f325821-aed1-5216-b5a3-ffaf528190d5" :question/math-academy-id "q-340284"} {:db/id 17592186543497 :question/id #uuid "47d673bd-5b90-569f-9bcd-5db84649c548" :question/math-academy-id "q-340277"} {:db/id 17592186543507 :question/id #uuid "5e010595-5a96-5d35-8548-77ec2815a5a0" :question/math-academy-id "q-340285"}] :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"} {:db/id 17592186096412 :question/id #uuid "16b1a91c-ae83-5e6b-a11d-bb9d78e4d218" :question/math-academy-id "e-3626" :knowledge-point/_canonical-example [{:db/id 17592186096612 :knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/problem "Given that $f(x)=3 \\cdot 2^x$, find $f'(x).$" :question/worked-solution "Applying the formula, we get\n\n$$\n\\eqalign{\n\t\tf'(x)      &= \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(3 \\cdot 2^x\\right) \\\n                            &= 3 \\cdot \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(2^x\\right) \\\n                            &=  3 \\cdot 2^{x}\\ln(2) \\\n                            &=  3 \\ln(2) \\cdot 2^{x}.\n\t}\n$$"} {:db/id 17592186479997} {:db/id 17592186096991 :question/id #uuid "991df192-1bbb-5ddd-b9f8-9c449c0a2bfd" :question/math-academy-id "q-11732"} {:db/id 17592186097155 :question/id #uuid "e0af69f1-1a58-5ac7-90e2-c2859723b842" :question/math-academy-id "q-1917"} {:db/id 17592186253334 :question/id #uuid "50678a5c-afcb-522f-98fb-80e9680afca6" :question/math-academy-id "q-11735" :knowledge-point/_questions [{:db/id 17592186096612 :knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3232bdcf-d781-5e59-bb5b-56c10f0d7fa1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10{x}^{2}+6x" :db/id 17592186250976} {:answer/id #uuid "37865371-b061-54aa-9810-81e59d0b835b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}-10{x}^{2}+6x-19" :db/id 17592186251009} {:answer/id #uuid "3d09661f-ce26-5e19-a8b8-2ae50263662e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10x+6" :db/id 17592186251060 :task-item/_responses [{:db/id 17592186409262}]} {:answer/id #uuid "9007950f-ce55-5f0c-a1f6-d3963f0294f9" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}-10x+6" :db/id 17592186251775} {:answer/id #uuid "bbf32e0c-8341-5060-b67e-c44870ab4cd0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10{x}^{2}+6x-19" :db/id 17592186252214}] :answer-field/correct {:answer/id #uuid "3d09661f-ce26-5e19-a8b8-2ae50263662e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10x+6" :db/id 17592186251060} :answer-field/id #uuid "e849ca6e-9bda-5244-a669-0f22826facaa" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186253210}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/problem "Given that $f(x)={6}^{x}-5{x}^{2}+6x-19$, find ${f}^{′}(x).$" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({6}^{x}-5{x}^{2}+6x-19) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})-\\frac{\\text{d}}{\\text{d}x}(5{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(6x)-\\frac{\\text{d}}{\\text{d}x}(19) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})-5\\frac{\\text{d}}{\\text{d}x}({x}^{2})+6\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(19) \\\\  & =ln⁡6\\cdot {6}^{x}-5(2x)+6(1)-0 \\\\  & ={6}^{x}ln⁡6-10x+6.\\end{aligned}\n$$"} {:db/id 17592186284697 :question/id #uuid "3e51c642-d912-5d35-8cf2-7c273fba130d" :question/math-academy-id "q-17388"} {:db/id 17592186297290 :question/id #uuid "4df22161-f9b7-5077-b623-7a70a19c609f" :question/math-academy-id "q-304038" :knowledge-point/_questions [{:db/id 17592186096612 :knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3554bc38-45ed-5174-b2e0-b7a82dde78d2" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{ln}(8){8}^{x}+12" :db/id 17592186295565} {:answer/id #uuid "f54d10f9-87ce-520f-be5c-16afa4e5c6a2" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3\\cdot8^{x}\\ln(8)+12" :db/id 17592186524815}] :answer-field/correct {:answer/id #uuid "f54d10f9-87ce-520f-be5c-16afa4e5c6a2" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3\\cdot8^{x}\\ln(8)+12" :db/id 17592186524815} :answer-field/id #uuid "0a6fdabb-ec35-5bee-8e6f-6b6e93c3ccd5" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186296661}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/problem "Given that $f(x)=3\\cdot {8}^{x}+12x+10$, find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(3\\cdot {8}^{x}+12x+10) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3\\cdot {8}^{x})+\\frac{\\text{d}}{\\text{d}x}(12x)+\\frac{\\text{d}}{\\text{d}x}(10) \\\\  & =3\\frac{\\text{d}}{\\text{d}x}({8}^{x})+12\\frac{\\text{d}}{\\text{d}x}(x)+\\frac{\\text{d}}{\\text{d}x}(10) \\\\  & =3(\\operatorname{ln}⁡(8){8}^{x})+12(1)+0 \\\\  & =3\\operatorname{ln}⁡(8){8}^{x}+12.\\end{aligned}\n$$"} {:db/id 17592186314919 :question/id #uuid "ca876738-9b8d-5832-85d7-2d09df78130a" :question/math-academy-id "q-340272"} {:db/id 17592186314920 :question/id #uuid "d2b3624c-f62d-5f81-b0de-c13d8e4bf17c" :question/math-academy-id "q-340280"} {:db/id 17592186479956 :question/id #uuid "4ab89b2e-90ef-5667-856a-b34e71dd8ca6"} {:db/id 17592186479960 :question/id #uuid "50148e2c-17f0-5238-804f-16d18ed920ad" :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e51092c-d3e1-5116-8c4b-6104b8f6691c" :answer/type {:db/id 17592186045498} :answer/value "\\ln 6+5" :db/id 17592186479945} {:answer/id #uuid "1f3f4162-2d0a-5c5d-82e4-1a26519c89c5" :answer/type {:db/id 17592186045498} :answer/value "5" :db/id 17592186479947} {:answer/id #uuid "438a7220-979d-55dc-93b4-36a1d239218c" :answer/type {:db/id 17592186045498} :answer/value "\\ln 6+5e" :db/id 17592186479954} {:answer/id #uuid "556ea93d-c41f-51e1-a3d5-3a153a74e606" :answer/type {:db/id 17592186045498} :answer/value "\\ln 6" :db/id 17592186479963} {:answer/id #uuid "c713293d-b983-5584-b151-359e1e3a8af8" :answer/type {:db/id 17592186045498} :answer/value "6" :db/id 17592186479985}] :answer-field/correct {:db/id 17592186479945} :answer-field/id #uuid "380060b1-e35e-58d8-84f1-6cb9bb1b875b" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493} :db/id 17592186479950}] :question/difficulty {:db/id 17592186045487} :question/problem "Given that $f(x)={6}^{x}+5{e}^{x}$, find the instantaneous rate of change at $x=0.$" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({6}^{x}+5{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})+\\frac{\\text{d}}{\\text{d}x}(5{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})+5\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & ={6}^{x}\\ln 6+5{e}^{x}\\,.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={({6}^{x}\\ln 6+5{e}^{x})|}_{x=0} \\\\  & ={6}^{0}\\ln 6+5{e}^{0} \\\\  & =1\\cdot \\ln 6+5\\cdot 1 \\\\  & =\\ln 6+5.\\end{aligned}\n$$"} {:db/id 17592186479964 :question/id #uuid "582239d0-9d5e-5fbf-8b8c-312d6a4b25f3"} {:db/id 17592186479971 :question/id #uuid "90f05299-4aec-5aef-a19d-5af09d844fc9"} {:db/id 17592186479973 :question/id #uuid "9227db0a-2b43-5781-8e85-e3ce3701dc2c"} {:db/id 17592186479974 :question/id #uuid "9b5eb51d-f8f2-5555-81b1-c63476f8f13a"} {:db/id 17592186479976 :question/id #uuid "9f8d11c7-1ce6-57ae-a750-00abfd861493"} {:db/id 17592186479981 :question/id #uuid "b4aa7414-d170-5940-95df-f23e78929052"} {:db/id 17592186479982 :question/id #uuid "b995540b-f7ab-55d7-8f91-c51d207d2180"} {:db/id 17592186479989 :question/id #uuid "cf41a068-fd0d-5f4b-9f3b-52ecb794226b" :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a9d9676-be2e-55f1-8608-d21cf8ae6b8c" :answer/type {:db/id 17592186045498} :answer/value "\\frac{\\ln{\\left(5 \\right)}}{5} + \\ln{\\left(2 \\right)} + 6" :db/id 17592186479944}] :answer-field/correct {:db/id 17592186479944} :answer-field/id #uuid "c6f7efb5-5352-5998-97f1-7e7dd561f8f9" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492} :db/id 17592186479984}] :question/difficulty {:db/id 17592186045486} :question/problem "Given that $f(x)=1\\cdot {5}^{x}+2\\cdot {2}^{x}-3x^2+1$, find the instantaneous rate of change at $x=-1.$\n\n{{field-1}}" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}f'(x)&=\\frac{\\text{d}}{\\text{d}x}(1\\cdot {5}^{x}+2\\cdot {2}^{x}-3x^2+1) \\\\ &=1\\frac{\\text{d}}{\\text{d}x}({5}^{x})+2\\frac{\\text{d}}{\\text{d}x}({2}^{x})-3\\frac{\\text{d}}{\\text{d}x}(x^2)+\\frac{\\text{d}}{\\text{d}x}(1) \\\\ &=1({5}^{x}\\ln(5))+2({2}^{x}\\ln(2))-3(2x)+0 \\\\ &=1\\ln(5)\\cdot {5}^{x}+2\\ln(2)\\cdot {2}^{x}-6x.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=-1$ is\n\n$$\n\\begin{aligned}f'(-1)&=1\\ln(5)\\cdot {5}^{(-1)}+2\\ln(2)\\cdot {2}^{(-1)}-6(-1) \\\\ &=1(\\frac{1}{5})\\ln(5)+2(\\frac{1}{2})\\ln(2)-(6)(-1) \\\\ &=\\frac{\\ln{\\left(5 \\right)}}{5} + \\ln{\\left(2 \\right)} + 6.\\end{aligned}\n$$"} {:db/id 17592186479990 :question/id #uuid "df5079ea-2748-53c3-9b3e-39ecdb2bea5f"} {:db/id 17592186479993 :question/id #uuid "ec00e600-a612-5a76-94ca-79ecaa3d171e" :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27addd41-1b34-5638-873b-b749efd9cbcc" :answer/type {:db/id 17592186045498} :answer/value "\\operatorname{ln}(9)+2" :db/id 17592186479948}] :answer-field/correct {:db/id 17592186479948} :answer-field/id #uuid "e1395a30-edad-54d2-9382-c62a8875aa3f" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492} :db/id 17592186479991}] :question/difficulty {:db/id 17592186045487} :question/problem "Given that $f(x)={9}^{x}-1{x}^{3}+2x-1$, the slope of the tangent at $x=0$ is{{field-1}}." :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({9}^{x}-1{x}^{3}+2x-1) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({9}^{x})-\\frac{\\text{d}}{\\text{d}x}(1{x}^{3})+\\frac{\\text{d}}{\\text{d}x}(2x)-\\frac{\\text{d}}{\\text{d}x}(6) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({9}^{x})-1\\frac{\\text{d}}{\\text{d}x}({x}^{3})+2\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(6) \\\\  & =\\ln (9)\\cdot {9}^{x}-1(3{x}^{2})+2(1)-0 \\\\  & =\\ln (9)\\cdot {9}^{x}-3{x}^{2}+2.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={(\\ln (9)\\cdot {9}^{x}-3{x}^{2}+2)|}_{x=0} \\\\  & =\\ln (9)\\cdot {9}^{0}-3(0)^{2}+2 \\\\  & =\\ln (9)\\cdot 1-0+2 \\\\  & =\\ln (9)+2.\\end{aligned}\n$$"} {:db/id 17592186479996 :question/id #uuid "f8120d99-4d4d-56ef-af5e-c92f6fe86369"} {:db/id 17592186524984 :question/id #uuid "46572da3-e0a7-57d7-a2f6-062b0d2adadb" :question/math-academy-id "q-140439" :knowledge-point/_questions [{:db/id 17592186096612 :knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0caca0a6-1e08-5ddf-bb83-3bec4e2484b5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡2-2e" :db/id 17592186524404} {:answer/id #uuid "29c8efb8-570d-51ab-b67b-d69348dbbf78" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2-4e" :db/id 17592186524458} {:answer/id #uuid "83f09c8c-036c-5988-8f2a-b6776804e7ba" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2e" :db/id 17592186524587} {:answer/id #uuid "ddfba5da-de74-5003-94d8-2da062180d72" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡2+e" :db/id 17592186524760} {:answer/id #uuid "f466827c-355f-5cbc-b5b1-a9351be94db5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡2" :db/id 17592186524814}] :answer-field/correct {:answer/id #uuid "f466827c-355f-5cbc-b5b1-a9351be94db5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡2" :db/id 17592186524814} :answer-field/id #uuid "552b41e9-7a71-51a8-a342-aa77b81b7fa3" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186524874}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/problem "Given that $f(x)=4\\cdot {2}^{x}+{x}^{3}-{e}^{2}$,  find the slope of the tangent at $x=0.$" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4\\cdot {2}^{x}+{x}^{3}-{e}^{2}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4\\cdot {2}^{x})+\\frac{\\text{d}}{\\text{d}x}({x}^{3})+\\frac{\\text{d}}{\\text{d}x}(-{e}^{2}) \\\\  & =4\\cdot {2}^{x}\\operatorname{ln}⁡2+\\frac{\\text{d}}{\\text{d}x}({x}^{3})+0 \\\\  & =4\\cdot {2}^{x}\\operatorname{ln}⁡2+3{x}^{2}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & =(4\\cdot {2}^{x}\\operatorname{ln}⁡2+3{x}^{2}){|}_{x=0} \\\\  & =4\\cdot {2}^{0}\\operatorname{ln}⁡2+3\\cdot {0}^{2} \\\\  & =4\\cdot 1\\cdot \\operatorname{ln}⁡2+3\\cdot 0 \\\\  & =4\\operatorname{ln}⁡2.\\end{aligned}\n$$"} {:db/id 17592186543477 :question/id #uuid "0f325821-aed1-5216-b5a3-ffaf528190d5" :question/math-academy-id "q-340284" :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5669689b-d4c2-598a-9b8e-4640a33a9697" :answer/type {:db/id 17592186045498} :answer/value "-6\\ln 2" :db/id 17592186542874}] :answer-field/correct {:db/id 17592186542874} :answer-field/id #uuid "4d0c9719-4708-560e-a504-150738be227f" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492} :db/id 17592186543338}] :question/difficulty {:db/id 17592186045487} :question/problem "Given that $f(x)=\\operatorname{ln}⁡(5)-3\\cdot {2}^{x}$, the slope of the tangent at $x=1$ is{{field-1}}." :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡(5)-3\\cdot {2}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡(5))-\\frac{\\text{d}}{\\text{d}x}(3\\cdot {2}^{x}) \\\\  & =0-3\\frac{\\text{d}}{\\text{d}x}({2}^{x}) \\\\  & =-3\\operatorname{ln}⁡(2)\\cdot {2}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=1} & ={(-3\\operatorname{ln}⁡(2)\\cdot {2}^{x})|}_{x=1} \\\\  & =-3\\operatorname{ln}⁡(2)\\cdot {2}^{1} \\\\  & =-3\\operatorname{ln}⁡(2)\\cdot 2 \\\\  & =-6\\operatorname{ln}⁡(2).\\end{aligned}\n$$"} {:db/id 17592186543497 :question/id #uuid "47d673bd-5b90-569f-9bcd-5db84649c548" :question/math-academy-id "q-340277" :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8301abdf-6346-54fc-a966-bee78fbb19e6" :answer/type {:db/id 17592186045498} :answer/value "12\\ln 4-2e" :db/id 17592186542988}] :answer-field/correct {:db/id 17592186542988} :answer-field/id #uuid "b41aee66-8662-5e0a-8dc7-1405a17238b0" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492} :db/id 17592186543424}] :question/difficulty {:db/id 17592186045487} :question/problem "Given that $f(x)=3\\cdot {4}^{x}-2{e}^{x}$, the slope of the tangent at $x=1$ is{{field-1}}." :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(3\\cdot {4}^{x}-2{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3\\cdot {4}^{x})-\\frac{\\text{d}}{\\text{d}x}(2{e}^{x}) \\\\  & =3\\frac{\\text{d}}{\\text{d}x}({4}^{x})-2\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =3\\operatorname{ln}⁡(4)\\cdot {4}^{x}-2{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=1} & ={(3\\operatorname{ln}⁡(4)\\cdot {4}^{x}-2{e}^{x})|}_{x=1} \\\\  & =3\\operatorname{ln}⁡(4)\\cdot {4}^{1}-2{e}^{1} \\\\  & =12\\operatorname{ln}⁡(4)-2e.\\end{aligned}\n$$"} {:db/id 17592186543507 :question/id #uuid "5e010595-5a96-5d35-8548-77ec2815a5a0" :question/math-academy-id "q-340285" :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3481b85e-58eb-5313-8a75-21e00c14674a" :answer/type {:db/id 17592186045498} :answer/value "5\\ln 7" :db/id 17592186542780}] :answer-field/correct {:db/id 17592186542780} :answer-field/id #uuid "5f82e929-b888-5d34-a5dc-e42fb4ed9aff" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492} :db/id 17592186543349}] :question/difficulty {:db/id 17592186045487} :question/problem "Given that $f(x)=5\\cdot {7}^{x}$, the slope of the tangent at $x=0$ is{{field-1}}." :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(5\\cdot {7}^{x}) \\\\  & =5\\frac{\\text{d}}{\\text{d}x}({7}^{x}) \\\\  & =5\\operatorname{ln}⁡(7)\\cdot {7}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={(5\\operatorname{ln}⁡(7)\\cdot {7}^{x})|}_{x=0} \\\\  & =5\\operatorname{ln}⁡(7)\\cdot {7}^{0} \\\\  & =5\\operatorname{ln}⁡(7)\\cdot 1 \\\\  & =5\\operatorname{ln}⁡(7).\\end{aligned}\n$$"} {:db/id 17592186050271} {:db/id 17592186050690} {:answer-field/choices [{:answer/id #uuid "3232bdcf-d781-5e59-bb5b-56c10f0d7fa1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10{x}^{2}+6x" :db/id 17592186250976} {:answer/id #uuid "37865371-b061-54aa-9810-81e59d0b835b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}-10{x}^{2}+6x-19" :db/id 17592186251009} {:answer/id #uuid "3d09661f-ce26-5e19-a8b8-2ae50263662e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10x+6" :db/id 17592186251060 :task-item/_responses [{:db/id 17592186409262}]} {:answer/id #uuid "9007950f-ce55-5f0c-a1f6-d3963f0294f9" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}-10x+6" :db/id 17592186251775} {:answer/id #uuid "bbf32e0c-8341-5060-b67e-c44870ab4cd0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10{x}^{2}+6x-19" :db/id 17592186252214}] :answer-field/correct {:answer/id #uuid "3d09661f-ce26-5e19-a8b8-2ae50263662e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math}