61 1078 17592186524815 17592186045417] [17592186296661 1079 #uuid "0a6fdabb-ec35-5bee-8e6f-6b6e93c3ccd5" 17592186045417] [17592186297054 1075 17592186296232 17592186045417] [17592186297054 1075 17592186409338 17592186045416] [17592186297054 1076 17592186045492 17592186045417] [17592186297054 1077 "field-1" 17592186045417] [17592186297054 1078 17592186296232 17592186045417] [17592186297054 1079 #uuid "ca439fbc-124d-5dae-b8b3-a85cb6575e03" 17592186045417] [17592186297289 1068 17592186297054 17592186045417] [17592186297289 1069 "q-304035" 17592186045417] [17592186297289 1070 17592186045485 17592186045417] [17592186297289 1071 "Given that $f(x)=6{x}^{7}+2{e}^{x}$, the exact value of the slope of the tangent line at $x=-1$ is{{field-1}}." 17592186045417] [17592186297289 1072 #uuid "0f66d07e-3ca1-595a-b1d7-b4c775329676" 17592186045417] [17592186297289 1074 "First, using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(6{x}^{7}+2{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(6{x}^{7})+\\frac{\\text{d}}{\\text{d}x}(2{e}^{x}) \\\\  & =6\\frac{\\text{d}}{\\text{d}x}({x}^{7})+2\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =6(7{x}^{6})+2{e}^{x} \\\\  & =42{x}^{6}+2{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=-1$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=-1} & ={(42{x}^{6}+2{e}^{x})\\,|}_{x=-1} \\\\  & =42(-1)^{6}+2{e}^{-1} \\\\  & =42\\cdot 1+\\frac{2}{e} \\\\  & =42+\\frac{2}{e}.\\end{aligned}\n$$" 17592186045417] [17592186297290 1068 17592186296661 17592186045417] [17592186297290 1069 "q-304038" 17592186045417] [17592186297290 1070 17592186045485 17592186045417] [17592186297290 1071 "Given that $f(x)=3\\cdot {8}^{x}+12x+10$, find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" 17592186045417] [17592186297290 1072 #uuid "4df22161-f9b7-5077-b623-7a70a19c609f" 17592186045417] [17592186297290 1074 "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(3\\cdot {8}^{x}+12x+10) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3\\cdot {8}^{x})+\\frac{\\text{d}}{\\text{d}x}(12x)+\\frac{\\text{d}}{\\text{d}x}(10) \\\\  & =3\\frac{\\text{d}}{\\text{d}x}({8}^{x})+12\\frac{\\text{d}}{\\text{d}x}(x)+\\frac{\\text{d}}{\\text{d}x}(10) \\\\  & =3(\\operatorname{ln}⁡(8){8}^{x})+12(1)+0 \\\\  & =3\\operatorname{ln}⁡(8){8}^{x}+12.\\end{aligned}\n$$" 17592186045417] [17592186409255 1146 17592186409338 17592186045416] [17592186409255 1148 19.056 17592186045443] [17592186409255 1156 17592186409256 17592186045443] [17592186409255 1158 17592186297289 17592186045443] [17592186409255 1161 #uuid "5666f4fd-29fb-49fa-86c1-bbbc0bd3ca29" 17592186045443] [17592186409255 1162 17592186045572 17592186045443] [17592186409262 1146 17592186251060 17592186045416] [17592186409262 1148 101.998 17592186045443] [17592186409262 1156 17592186409263 17592186045443] [17592186409262 1158 17592186253334 17592186045443] [17592186409262 1161 #uuid "2400d6f0-de9d-4711-a743-56063c38ea56" 17592186045443] [17592186409262 1162 17592186045571 17592186045443] [17592186409338 1080 "42x^6+2e^{x}" 17592186045416] [17592186409338 1082 17592186045498 17592186045416] [17592186409338 1083 #uuid "c4f887ee-f564-4711-a252-4f52754bf8ba" 17592186045416] [17592186479944 1080 "\\frac{\\ln{\\left(5 \\right)}}{5} + \\ln{\\left(2 \\right)} + 6" 17592186045443] [17592186479944 1082 17592186045498 17592186045443] [17592186479944 1083 #uuid "1a9d9676-be2e-55f1-8608-d21cf8ae6b8c" 17592186045443] [17592186479945 1080 "\\ln 6+5" 17592186045443] [17592186479945 1082 17592186045498 17592186045443] [17592186479945 1083 #uuid "1e51092c-d3e1-5116-8c4b-6104b8f6691c" 17592186045443] [17592186479947 1080 "5" 17592186045443] [17592186479947 1082 17592186045498 17592186045443] [17592186479947 1083 #uuid "1f3f4162-2d0a-5c5d-82e4-1a26519c89c5" 17592186045443] [17592186479948 1080 "\\operatorname{ln}(9)+2" 17592186045443] [17592186479948 1082 17592186045498 17592186045443] [17592186479948 1083 #uuid "27addd41-1b34-5638-873b-b749efd9cbcc" 17592186045443] [17592186479950 1075 17592186479945 17592186045443] [17592186479950 1075 17592186479947 17592186045443] [17592186479950 1075 17592186479954 17592186045443] [17592186479950 1075 17592186479963 17592186045443] [17592186479950 1075 17592186479985 17592186045443] [17592186479950 1076 17592186045493 17592186045443] [17592186479950 1077 "selection" 17592186045443] [17592186479950 1078 17592186479945 17592186045443] [17592186479950 1079 #uuid "380060b1-e35e-58d8-84f1-6cb9bb1b875b" 17592186045443] [17592186479954 1080 "\\ln 6+5e" 17592186045443] [17592186479954 1082 17592186045498 17592186045443] [17592186479954 1083 #uuid "438a7220-979d-55dc-93b4-36a1d239218c" 17592186045443] [17592186479956 1068 17592186479966 17592186045443] [17592186479956 1070 17592186045486 17592186045443] [17592186479956 1071 "Given that $f(x)=1\\cdot {4}^{x}+1\\cdot {6}^{x}-4x^2+2$, find the instantaneous rate of change at $x=1.$\n\n{{field-1}}" 17592186045443] [17592186479956 1072 #uuid "4ab89b2e-90ef-5667-856a-b34e71dd8ca6" 17592186045443] [17592186479956 1074 "Applying the formula, we get\n\n$$\n\\begin{aligned}f'(x)&=\\frac{\\text{d}}{\\text{d}x}(1\\cdot {4}^{x}+1\\cdot {6}^{x}-4x^2+2) \\\\ &=1\\frac{\\text{d}}{\\text{d}x}({4}^{x})+1\\frac{\\text{d}}{\\text{d}x}({6}^{x})-4\\frac{\\text{d}}{\\text{d}x}(x^2)+\\frac{\\text{d}}{\\text{d}x}(2) \\\\ &=1({4}^{x}\\ln(4))+1({6}^{x}\\ln(6))-4(2x)+0 \\\\ &=1\\ln(4)\\cdot {4}^{x}+1\\ln(6)\\cdot {6}^{x}-8x.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=1$ is\n\n$$\n\\begin{aligned}f'(1)&=1\\ln(4)\\cdot {4}^{(1)}+1\\ln(6)\\cdot {6}^{(1)}-8(1) \\\\ &=1(4)\\ln(4)+1(6)\\ln(6)-(8)(1) \\\\ &=-8 + 4 \\ln{\\left(4 \\right)} + 6 \\ln{\\left(6 \\right)}.\\end{aligned}\n$$" 17592186045443] [17592186479960 1068 17592186479950 17592186045443] [17592186479960 1070 17592186045487 17592186045443] [17592186479960 1071 "Given that $f(x)={6}^{x}+5{e}^{x}$, find the instantaneous rate of change at $x=0.$" 17592186045443] [17592186479960 1072 #uuid "50148e2c-17f0-5238-804f-16d18ed920ad" 17592186045443] [17592186479960 1074 "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({6}^{x}+5{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})+\\frac{\\text{d}}{\\text{d}x}(5{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})+5\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & ={6}^{x}\\ln 6+5{e}^{x}\\,.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={({6}^{x}\\ln 6+5{e}^{x})|}_{x=0} \\\\  & ={6}^{0}\\ln 6+5{e}^{0} \\\\  & =1\\cdot \\ln 6+5\\cdot 1 \\\\  & =\\ln 6+5.\\end{aligned}\n$$" 17592186045443] [17592186479963 1080 "\\ln 6" 17592186045443] [17592186479963 1082 17592186045498 17592186045443] [17592186479963 1083 #uuid "556ea93d-c41f-51e1-a3d5-3a153a74e606" 17592186045443] [17592186479964 1068 17592186479992 17592186045443] [17592186479964 1070 17592186045485 17592186045443] [17592186479964 1071 "Given that $f(x) = 5 \\cdot 6^{x}$, find $f^{′}(x)$." 17592186045443] [17592186479964 1072 #uuid "582239d0-9d5e-5fbf-8b8c-312d6a4b25f3" 17592186045443] [17592186479964 1074 "Applying the formula, we get\n\n$$\n\\begin{aligned}f^{′}(x)&=\\frac{\\text{d}}{\\text{d}x}(5 \\cdot 6^{x}) \\\\ &=5\\frac{\\text{d}}{\\text{d}x}(6^{x}) \\\\ &=5\\cdot 6^{x}\\ln 6 \\\\ &=5\\ln 6\\cdot 6^{x}.\\end{aligned}\n$$" 17592186045443] [17592186479971 1068 17592186479978 17592186045443] [17592186479971 1070 17592186045485 17592186045443] [17592186479971 1071 "Given that $f(x) = 9^{x} + 1e^{x}$, find $f^{′}(x)$." 17592186045443] [17592186479971 1072 #uuid "90f05299-4aec-5aef-a19d-5af09d844fc9" 17592186045443] [17592186479971 1074 "Applying the formula, we get\n\n$$\n\\begin{aligned}f^{′}(x)&=\\frac{\\text{d}}{\\text{d}x}(9^{x}+1e^{x}) \\\\ &=\\frac{\\text{d}}{\\text{d}x}(9^{x})+\\frac{\\text{d}}{\\text{d}x}(1e^{x}) \\\\ &=\\frac{\\text{d}}{\\text{d}x}(9^{x})+1\\frac{\\text{d}}{\\text{d}x}(e^{x}) \\\\ &=9^{x}\\ln 9+1e^{x}.\\end{aligned}\n$$" 17592186045443] [17592186479973 1068 17592186479942 17592186045443] [17592186479973 1070 17592186045485 17592186045443] [17592186479973 1071 "Given that $f(x)=6\\cdot {8}^{x}+4x+1$, find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" 17592186045443] [17592186479973 1072 #uuid "9227db0a-2b43-5781-8e85-e3ce3701dc2c" 17592186045443] [17592186479973 1074 "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(6\\cdot {8}^{x}+4x+1) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(6\\cdot {8}^{x})+\\frac{\\text{d}}{\\text{d}x}(4x)+\\frac{\\text{d}}{\\text{d}x}(1) \\\\  & =6\\frac{\\text{d}}{\\text{d}x}({8}^{x})+4\\frac{\\text{d}}{\\text{d}x}(x)+\\frac{\\text{d}}{\\text{d}x}(1) \\\\  & =6(\\ln (8){8}^{x})+4(1)+0 \\\\  & =6\\ln (8){8}^{x}+4.\\end{aligned}\n$$" 17592186045443] [17592186479974 1068 17592186479940 17592186045443] [17592186479974 1070 17592186045485 17592186045443] [17592186479974 1071 "Given that $f(x)={3}^{x}-9{x}^{2}+5x-8$, find ${f}^{′}(x).$" 17592186045443] [17592186479974 1072 #uuid "9b5eb51d-f8f2-5555-81b1-c63476f8f13a" 17592186045443] [17592186479974 1074 "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({3}^{x}-9{x}^{2}+5x-8) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({3}^{x})-\\frac{\\text{d}}{\\text{d}x}(9{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(5x)-\\frac{\\text{d}}{\\text{d}x}(8) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({3}^{x})-9\\frac{\\text{d}}{\\text{d}x}({x}^{2})+5\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(8) \\\\  & =\\ln 3\\cdot {3}^{x}-9(2x)+5(1)-0 \\\\  & ={3}^{x}\\ln 3-18x+5.\\end{aligned}\n$$" 17592186045443] [17592186479976 1068 17592186479953 17592186045443] [17592186479976 1070 17592186045487 17592186045443] [17592186479976 1071 "Given that $f(x)={3}^{x}+9{e}^{x}$, find the instantaneous rate of change at $x=0.$" 17592186045443] [17592186479976 1072 #uuid "9f8d11c7-1ce6-57ae-a750-00abfd861493" 17592186045443] [17592186479976 1074 "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({3}^{x}+9{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({3}^{x})+\\frac{\\text{d}}{\\text{d}x}(9{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({3}^{x})+9\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & ={3}^{x}\\ln 3+9{e}^{x}\\,.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={({3}^{x}\\ln 3+9{e}^{x})|}_{x=0} \\\\  & ={3}^{0}\\ln 3+9{e}^{0} \\\\  & =1\\cdot \\ln 3+9\\cdot 1 \\\\  & =\\ln 3+9.\\end{aligned}\n$$" 17592186045443] [17592186479981 1068 17592186479952 17592186045443] [17592186479981 1070 17592186045486 17592186045443] [17592186479981 1071 "Given that $f(x)=2\\cdot {2}^{x}+3\\cdot {4}^{x}-4x^2+5$, find the instantaneous rate of change at $x=1.$\n\n{{field-1}}" 17592186045443] [17592186479981 1072 #uuid "b4aa7414-d170-5940-95df-f23e78929052" 17592186045443] [17592186479981 1074 "Applying the formula, we get\n\n$$\n\\begin{aligned}f'(x)&=\\frac{\\text{d}}{\\text{d}x}(2\\cdot {2}^{x}+3\\cdot {4}^{x}-4x^2+5) \\\\ &=2\\frac{\\text{d}}{\\text{d}x}({2}^{x})+3\\frac{\\text{d}}{\\text{d}x}({4}^{x})-4\\frac{\\text{d}}{\\text{d}x}(x^2)+\\frac{\\text{d}}{\\text{d}x}(5) \\\\ &=2({2}^{x}\\ln(2))+3({4}^{x}\\ln(4))-4(2x)+0 \\\\ &=2\\ln(2)\\cdot {2}^{x}+3\\ln(4)\\cdot {4}^{x}-8x.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=1$ is\n\n$$\n\\begin{aligned}f'(1)&=2\\ln(2)\\cdot {2}^{(1)}+3\\ln(4)\\cdot {4}^{(1)}-8(1) \\\\ &=2(2)\\ln(2)+3(4)\\ln(4)-(8)(1) \\\\ &=-8 + 4 \\ln{\\left(2 \\right)} + 12 \\ln{\\left(4 \\right)}.\\end{aligned}\n$$" 17592186045443] [17592186479982 1068 17592186479965 17592186045443] [17592186479982 1070 17592186045486 17592186045443] [17592186479982 1071 "Given that $f(x)=2\\cdot {4}^{x}+1\\cdot {5}^{x}-3x^2+4$, find the instantaneous rate of change at $x=1.$\n\n{{field-1}}" 17592186045443] [17592186479982 1072 #uuid "b995540b-f7ab-55d7-8f91-c51d207d2180" 17592186045443] [17592186479982 1074 "Applying the formula, we get\n\n$$\n\\begin{aligned}f'(x)&=\\frac{\\text{d}}{\\text{d}x}(2\\cdot {4}^{x}+1\\cdot {5}^{x}-3x^2+4) \\\\ &=2\\frac{\\text{d}}{\\text{d}x}({4}^{x})+1\\frac{\\text{d}}{\\text{d}x}({5}^{x})-3\\frac{\\text{d}}{\\text{d}x}(x^2)+\\frac{\\text{d}}{\\text{d}x}(4) \\\\ &=2({4}^{x}\\ln(4))+1({5}^{x}\\ln(5))-3(2x)+0 \\\\ &=2\\ln(4)\\cdot {4}^{x}+1\\ln(5)\\cdot {5}^{x}-6x.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=1$ is\n\n$$\n\\begin{aligned}f'(1)&=2\\ln(4)\\cdot {4}^{(1)}+1\\ln(5)\\cdot {5}^{(1)}-6(1) \\\\ &=2(4)\\ln(4)+1(5)\\ln(5)-(6)(1) \\\\ &=-6 + 5 \\ln{\\left(5 \\right)} + 8 \\ln{\\left(4 \\right)}.\\end{aligned}\n$$" 17592186045443] [17592186479984 1075 17592186479944 17592186045443] [17592186479984 1076 17592186045492 17592186045443] [17592186479984 1077 "field-1" 17592186045443] [17592186479984 1078 17592186479944 17592186045443] [17592186479984 1079 #uuid "c6f7efb5-5352-5998-97f1-7e7dd561f8f9" 17592186045443] [17592186479985 1080 "6" 17592186045443] [17592186479985 1082 17592186045498 17592186045443] [17592186479985 1083 #uuid "c713293d-b983-5584-b151-359e1e3a8af8" 17592186045443] [17592186479989 1068 17592186479984 17592186045443] [17592186479989 1070 17592186045486 17592186045443] [17592186479989 1071 "Given that $f(x)=1\\cdot {5}^{x}+2\\cdot {2}^{x}-3x^2+1$, find the instantaneous rate of change at $x=-1.$\n\n{{field-1}}" 17592186045443] [17592186479989 1072 #uuid "cf41a068-fd0d-5f4b-9f3b-52ecb794226b" 17592186045443] [17592186479989 1074 "Applying the formula, we get\n\n$$\n\\begin{aligned}f'(x)&=\\frac{\\text{d}}{\\text{d}x}(1\\cdot {5}^{x}+2\\cdot {2}^{x}-3x^2+1) \\\\ &=1\\frac{\\text{d}}{\\text{d}x}({5}^{x})+2\\frac{\\text{d}}{\\text{d}x}({2}^{x})-3\\frac{\\text{d}}{\\text{d}x}(x^2)+\\frac{\\text{d}}{\\text{d}x}(1) \\\\ &=1({5}^{x}\\ln(5))+2({2}^{x}\\ln(2))-3(2x)+0 \\\\ &=1\\ln(5)\\cdot {5}^{x}+2\\ln(2)\\cdot {2}^{x}-6x.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=-1$ is\n\n$$\n\\begin{aligned}f'(-1)&=1\\ln(5)\\cdot {5}^{(-1)}+2\\ln(2)\\cdot {2}^{(-1)}-6(-1) \\\\ &=1(\\frac{1}{5})\\ln(5)+2(\\frac{1}{2})\\ln(2)-(6)(-1) \\\\ &=\\frac{\\ln{\\left(5 \\right)}}{5} + \\ln{\\left(2 \\right)} + 6.\\end{aligned}\n$$" 17592186045443] [17592186479990 1068 17592186479987 17592186045443] [17592186479990 1070 17592186045487 17592186045443] [17592186479990 1071 "Given that $f(x)={7}^{x}-7{x}^{3}+4x-1$, the slope of the tangent at $x=0$ is{{field-1}}." 17592186045443] [17592186479990 1072 #uuid "df5079ea-2748-53c3-9b3e-39ecdb2bea5f" 17592186045443] [17592186479990 1074 "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({7}^{x}-7{x}^{3}+4x-1) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({7}^{x})-\\frac{\\text{d}}{\\text{d}x}(7{x}^{3})+\\frac{\\text{d}}{\\text{d}x}(4x)-\\frac{\\text{d}}{\\text{d}x}(1) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({7}^{x})-7\\frac{\\text{d}}{\\text{d}x}({x}^{3})+4\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(1) \\\\  & =\\ln (7)\\cdot {7}^{x}-7(3{x}^{2})+4(1)-0 \\\\  & =\\ln (7)\\cdot {7}^{x}-21{x}^{2}+4.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={(\\ln (7)\\cdot {7}^{x}-21{x}^{2}+4)|}_{x=0} \\\\  & =\\ln (7)\\cdot {7}^{0}-21(0)^{2}+4 \\\\  & =\\ln (7)\\cdot 1-0+4 \\\\  & =\\ln (7)+4.\\end{aligned}\n$$" 17592186045443] [17592186479991 1075 17592186479948 17592186045443] [17592186479991 1076 17592186045492 17592186045443] [17592186479991 1077 "field-1" 17592186045443] [17592186479991 1078 17592186479948 17592186045443] [17592186479991 1079 #uuid "e1395a30-edad-54d2-9382-c62a8875aa3f" 17592186045443] [17592186479993 1068 17592186479991 17592186045443] [17592186479993 1070 17592186045487 17592186045443] [17592186479993 1071 "Given that $f(x)={9}^{x}-1{x}^{3}+2x-1$, the slope of the tangent at $x=0$ is{{field-1}}." 17592186045443] [17592186479993 1072 #uuid "ec00e600-a612-5a76-94ca-79ecaa3d171e" 17592186045443] [17592186479993 1074 "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({9}^{x}-1{x}^{3}+2x-1) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({9}^{x})-\\frac{\\text{d}}{\\text{d}x}(1{x}^{3})+\\frac{\\text{d}}{\\text{d}x}(2x)-\\frac{\\text{d}}{\\text{d}x}(6) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({9}^{x})-1\\frac{\\text{d}}{\\text{d}x}({x}^{3})+2\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(6) \\\\  & =\\ln (9)\\cdot {9}^{x}-1(3{x}^{2})+2(1)-0 \\\\  & =\\ln (9)\\cdot {9}^{x}-3{x}^{2}+2.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={(\\ln (9)\\cdot {9}^{x}-3{x}^{2}+2)|}_{x=0} \\\\  & =\\ln (9)\\cdot {9}^{0}-3(0)^{2}+2 \\\\  & =\\ln (9)\\cdot 1-0+2 \\\\  & =\\ln (9)+2.\\end{aligned}\n$$" 17592186045443] [17592186479996 1068 17592186479970 17592186045443] [17592186479996 1070 17592186045486 17592186045443] [17592186479996 1071 "Given that $f(x)=2\\cdot {6}^{x}+1\\cdot {3}^{x}-3x^2+2$, find the instantaneous rate of change at $x=-1.$\n\n{{field-1}}" 17592186045443] [17592186479996 1072 #uuid "f8120d99-4d4d-56ef-af5e-c92f6fe86369" 17592186045443] [17592186479996 1074 "Applying the formula, we get\n\n$$\n\\begin{aligned}f'(x)&=\\frac{\\text{d}}{\\text{d}x}(2\\cdot {6}^{x}+1\\cdot {3}^{x}-3x^2+2) \\\\ &=2\\frac{\\text{d}}{\\text{d}x}({6}^{x})+1\\frac{\\text{d}}{\\text{d}x}({3}^{x})-3\\frac{\\text{d}}{\\text{d}x}(x^2)+\\frac{\\text{d}}{\\text{d}x}(2) \\\\ &=2({6}^{x}\\ln(6))+1({3}^{x}\\ln(3))-3(2x)+0 \\\\ &=2\\ln(6)\\cdot {6}^{x}+1\\ln(3)\\cdot {3}^{x}-6x.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=-1$ is\n\n$$\n\\begin{aligned}f'(-1)&=2\\ln(6)\\cdot {6}^{(-1)}+1\\ln(3)\\cdot {3}^{(-1)}-6(-1) \\\\ &=2(\\frac{1}{6})\\ln(6)+1(\\frac{1}{3})\\ln(3)-(6)(-1) \\\\ &=\\frac{\\ln{\\left(3 \\right)}}{3} + \\frac{\\ln{\\left(6 \\right)}}{3} + 6.\\end{aligned}\n$$" 17592186045443] [17592186479997 1168 "generate/scratch/17592186096612.py" 17592186045443] [17592186479997 1169 #uuid "1a5c3131-e07d-52bf-8fa5-e96ba318a4bc" 17592186045443] [17592186479998 1043 17592186479999 17592186045443] [17592186479998 1043 17592186480000 17592186045443] [17592186479998 1043 17592186480001 17592186045443] [17592186479998 1043 17592186480002 17592186045443] [17592186479998 1043 17592186480003 17592186045443] [17592186479998 1044 17592186045464 17592186045443] [17592186479998 1045 "Review: Differentiating Exponential Functions" 17592186045443] [17592186479998 1046 17592186479999 17592186045443] [17592186479998 1048 17592186046647 17592186045443] [17592186479998 1049 17592186048749 17592186045443] [17592186479998 1050 270.0 17592186045443] [17592186479998 1053 #uuid "f1fdb787-c3cd-4a39-a6e0-2e71d411593d" 17592186045443] [17592186479999 1058 17592186480000 17592186045443] [17592186479999 1059 90.0 17592186045443] [17592186479999 1062 #uuid "33ad21e0-2609-477f-8599-5b745a6fabda" 17592186045443] [17592186479999 1063 17592186235471 17592186045443] [17592186480000 1058 17592186480001 17592186045443] [17592186480000 1059 90.0 17592186045443] [17592186480000 1062 #uuid "f8f4561f-e1dc-46f4-bf5b-373c5c3b7779" 17592186045443] [17592186480000 1063 17592186479989 17592186045443] [17592186480001 1058 17592186480002 17592186045443] [17592186480001 1059 90.0 17592186045443] [17592186480001 1062 #uuid "6c7a0ccc-737a-46dc-a6da-45334c4508ff" 17592186045443] [17592186480001 1063 17592186272086 17592186045443] [17592186480002 1058 17592186480003 17592186045443] [17592186480002 1059 90.0 17592186045443] [17592186480002 1062 #uuid "ce63fcf4-9592-481e-982a-405b6f12d7be" 17592186045443] [17592186480002 1063 17592186479960 17592186045443] [17592186480003 1059 90.0 17592186045443] [17592186480003 1062 #uuid "fab70c36-4b77-4dae-b226-e0c0429677ee" 17592186045443] [17592186480003 1063 17592186479993 17592186045443] [17592186480008 1068 17592186480012 17592186045443] [17592186480008 1070 17592186045487 17592186045443] [17592186480008 1071 "Given that $f(x)=- \\frac{5}{3}{e}^{x}-8$, the slope of the tangent line at $x=-ln⁡3$ is{{field-1}}." 17592186045443] [17592186480008 1072 #uuid "24285fdc-6262-5d37-b204-181d4efdc6b1" 17592186045443] [17592186480008 1074 "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $-8$ is a constant, so its derivative is $0.$\n\nFirst, using the addition rule, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(- \\frac{5}{3}{e}^{x}-8) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(- \\frac{5}{3}{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(-8) \\\\  & =- \\frac{5}{3}\\frac{\\text{d}}{\\text{d}x}({e}^{x})+0 \\\\  & =- \\frac{5}{3}{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=-ln⁡3$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=-ln⁡3} & ={(- \\frac{5}{3}{e}^{x})\\,|}_{x=-ln⁡3} \\\\  & =- \\frac{5}{3}{e}^{-ln⁡3} \\\\  & =- \\frac{5}{3}\\cdot \\frac{1}{3} \\\\  & =- \\frac{5}{9}.\\end{aligned}\n$$" 17592186045443] [17592186480009 1068 17592186480033 17592186045443] [17592186480009 1070 17592186045485 17592186045443] [17592186480009 1071 "Given that $f(x) = \\ln 2 + 2e^{x}$, find $f^{′}(x)$." 17592186045443] [17592186480009 1072 #uuid "27963039-7ab9-50a1-a524-335dda2120d3" 17592186045443] [17592186480009 1074 "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $ln⁡2$ is a constant, so its derivative is $0.$\n\nUsing the addition rule, then, we have \n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(ln⁡2+2{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(ln⁡2)+\\frac{\\text{d}}{\\text{d}x}(2{e}^{x}) \\\\  & =0+2\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =2{e}^{x}.\\end{aligned}\n$$" 17592186045443] [17592186480011 1068 17592186480042 17592186045443] [17592186480011 1070 17592186045486 17592186045443] [17592186480011 1071 "Given that $f(x)=\\frac{4}{3}{e}^{x}-11$, the slope of the tangent line at $x=ln⁡\\frac{4}{5}$ is{{field-1}}." 17592186045443] [17592186480011 1072 #uuid "3368f5c9-3775-5d06-9195-e0e05c5824a2" 17592186045443] [17592186480011 1074 "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $-11$ is a constant, so its derivative is $0.$\n\nFirst, using the addition rule, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{4}{3}{e}^{x}-11) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\frac{4}{3}{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(-11) \\\\  & =\\frac{4}{3}\\frac{\\text{d}}{\\text{d}x}({e}^{x})+0 \\\\  & =\\frac{4}{3}{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=ln⁡\\frac{4}{5}$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=ln⁡\\frac{4}{5}} & ={(\\frac{4}{3}{e}^{x})\\,|}_{x=ln⁡\\frac{4}{5}} \\\\  & =\\frac{4}{3}{e}^{ln⁡\\frac{4}{5}} \\\\  & =\\frac{4}{3}\\cdot \\frac{4}{5} \\\\  & =\\frac{16}{15}.\\end{aligned}\n$$" 17592186045443] [17592186480014 1068 17592186480046 17592186045443] [17592186480014 1070 17592186045485 17592186045443] [17592186480014 1071 "Given that $f(x)=-ln⁡9+7{e}^{x}$, find the slope of the tangent at $x=1.$" 17592186045443] [17592186480014 1072 #uuid "40eee14f-7f06-5ca0-8856-ee0dc15c1493" 17592186045443] [17592186480014 1074 "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $-ln⁡9$ is a constant, so its derivative is $0.$\n\nFirst, using the addition rule, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(-ln⁡9+7{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(-ln⁡9)+\\frac{\\text{d}}{\\text{d}x}(7{e}^{x}) \\\\  & =0+7\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =7{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=1} & ={(7{e}^{x})\\,|}_{x=1} \\\\  & =7{e}^{1} \\\\  & =7 e.\\end{aligned}\n$$" 17592186045443] [17592186480016 1068 17592186480019 17592186045443] [17592186480016 1070 17592186045487 17592186045443] [17592186480016 1071 "Given that $f(x)=- \\frac{5}{2}{e}^{x}+ln⁡7$, the slope of the tangent line at $x=-ln⁡9$ is{{field-1}}." 17592186045443] [17592186480016 1072 #uuid "5104b80b-063d-53dc-91b3-3f3e99aa0687" 17592186045443] [17592186480016 1074 "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $ln⁡7$ is a constant, so its derivative is $0.$\n\nFirst, using the addition rule, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(- \\frac{5}{2}{e}^{x}+ln⁡7) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(- \\frac{5}{2}{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(ln⁡7) \\\\  & =- \\frac{5}{2}\\frac{\\text{d}}{\\text{d}x}({e}^{x})+0 \\\\  & =- \\frac{5}{2}{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=-ln⁡9$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=-ln⁡9} & ={(- \\frac{5}{2}{e}^{x})\\,|}_{x=-ln⁡9} \\\\  & =- \\frac{5}{2}{e}^{-ln⁡9} \\\\  & =- \\frac{5}{2}\\cdot \\frac{1}{9} \\\\  & =- \\frac{5}{18}.\\end{aligned}\n$$" 17592186045443] [17592186480017 1068 17592186480021 17592186045443] [17592186480017 1070 17592186045487 17592186045443] [17592186480017 1071 "Given that $f(x)=- \\frac{4}{3}{e}^{x}+2$, the slope of the tangent line at $x=-ln⁡2$ is{{field-1}}." 17592186045443] [17592186480017 1072 #uuid "5184f338-d6d0-533d-88bb-8b37da109e6c" 17592186045443] [17592186480017 1074 "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $2$ is a constant, so its derivative is $0.$\n\nFirst, using the addition rule, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(- \\frac{4}{3}{e}^{x}+2) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(- \\frac{4}{3}{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(2) \\\\  & =- \\frac{4}{3}\\frac{\\text{d}}{\\text{d}x}({e}^{x})+0 \\\\  & =- \\frac{4}{3}{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=-ln⁡2$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=-ln⁡2} & ={(- \\frac{4}{3}{e}^{x})\\,|}_{x=-ln⁡2} \\\\  & =- \\frac{4}{3}{e}^{-ln⁡2} \\\\  & =- \\frac{4}{3}\\cdot \\frac{1}{2} \\\\  & =- \\frac{2}{3}.\\end{aligned}\n$$" 17592186045443] [17592186480023 1068 17592186480037 17592186045443] [17592186480023 1070 17592186045486 17592186045443] [17592186480023 1071 "Given that $f(x)=\\frac{5}{3}{e}^{x}-8$, the slope of the tangent line at $x=-ln⁡\\frac{12}{5}$ is{{field-1}}." 17592186045443] [17592186480023 1072 #uuid "5f698a42-ae62-5802-8f77-88360f877560" 17592186045443] [17592186480023 1074 "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $-8$ is a constant, so its derivative is $0.$\n\nFirst, using the addition rule, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{5}{3}{e}^{x}-8) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\frac{5}{3}{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(-8) \\\\  & =\\frac{5}{3}\\frac{\\text{d}}{\\text{d}x}({e}^{x})+0 \\\\  & =\\frac{5}{3}{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=-ln⁡\\frac{12}{5}$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=-ln⁡\\frac{12}{5}} & ={(\\frac{5}{3}{e}^{x})\\,|}_{x=-ln⁡\\frac{12}{5}} \\\\  & =\\frac{5}{3}{e}^{-ln⁡\\frac{12}{5}} \\\\  & =\\frac{5}{3}\\cdot \\frac{5}{12} \\\\  & =\\frac{25}{36}.\\end{aligned}\n$$" 17592186045443] [17592186480027 1068 17592186480047 17592186045443] [17592186480027 1070 17592186045486 17592186045443] [17592186480027 1071 "Given that $f(x)=ln⁡5+\\frac{1}{4}{e}^{x}$, the slope of the tangent line at $x=ln⁡\\frac{4}{5}$ is{{field-1}}." 17592186045443] [17592186480027 1072 #uuid "78a2b5f7-5cef-5012-a53c-264a4e19606b" 17592186045443] [17592186480027 1074 "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $ln⁡5$ is a constant, so its derivative is $0.$\n\nFirst, using the addition rule, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(ln⁡5+\\frac{1}{4}{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(ln⁡5)+\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{4}{e}^{x}) \\\\  & =0+\\frac{1}{4}\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =\\frac{1}{4}{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=ln⁡\\frac{4}{5}$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=ln⁡\\frac{4}{5}} & ={(\\frac{1}{4}{e}^{x})\\,|}_{x=ln⁡\\frac{4}{5}} \\\\  & =\\frac{1}{4}{e}^{ln⁡\\frac{4}{5}} \\\\  & =\\frac{1}{4}\\cdot \\frac{4}{5} \\\\  & =\\frac{1}{5}.\\end{aligned}\n$$" 17592186045443] [17592186480034 1068 17592186480039 17592186045443] [17592186480034 1070 17592186045486 17592186045443] [17592186480034 1071 "Given that $f(x)=\\frac{7}{4}{e}^{x}+2$, the slope of the tangent line at $x=-ln⁡\\frac{2}{3}$ is{{field-1}}." 17592186045443] [17592186480034 1072 #uuid "b423e41e-b9ca-54b7-896b-f125c7eb77b4" 17592186045443] [17592186480034 1074 "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $2$ is a constant, so its derivative is $0.$\n\nFirst, using the addition rule, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{7}{4}{e}^{x}+2) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\frac{7}{4}{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(2) \\\\  & =\\frac{7}{4}\\frac{\\text{d}}{\\text{d}x}({e}^{x})+0 \\\\  & =\\frac{7}{4}{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=-ln⁡\\frac{2}{3}$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=-ln⁡\\frac{2}{3}} & ={(\\frac{7}{4}{e}^{x})\\,|}_{x=-ln⁡\\frac{2}{3}} \\\\  & =\\frac{7}{4}{e}^{-ln⁡\\frac{2}{3}} \\\\  & =\\frac{7}{4}\\cdot \\frac{3}{2} \\\\  & =\\frac{21}{8}.\\end{aligned}\n$$" 17592186045443] [17592186480041 1068 17592186480030 17592186045443] [17592186480041 1070 17592186045486 17592186045443] [17592186480041 1071 "Given that $f(x)=- \\frac{8}{5}{e}^{x}+ln⁡7$, the slope of the tangent line at $x=-ln⁡\\frac{11}{2}$ is{{field-1}}." 17592186045443] [17592186480041 1072 #uuid "cf08154e-5ad6-5738-b7be-7d9a74b0856c" 17592186045443] [17592186480041 1074 "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $ln⁡7$ is a constant, so its derivative is $0.$\n\nFirst, using the addition rule, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(- \\frac{8}{5}{e}^{x}+ln⁡7) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(- \\frac{8}{5}{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(ln⁡7) \\\\  & =- \\frac{8}{5}\\frac{\\text{d}}{\\text{d}x}({e}^{x})+0 \\\\  & =- \\frac{8}{5}{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=-ln⁡\\frac{11}{2}$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=-ln⁡\\frac{11}{2}} & ={(- \\frac{8}{5}{e}^{x})\\,|}_{x=-ln⁡\\frac{11}{2}} \\\\  & =- \\frac{8}{5}{e}^{-ln⁡\\frac{11}{2}} \\\\  & =- \\frac{8}{5}\\cdot \\frac{2}{11} \\\\  & =- \\frac{16}{55}.\\end{aligned}\n$$" 17592186045443] [17592186480044 1068 17592186480006 17592186045443] [17592186480044 1070 17592186045487 17592186045443] [17592186480044 1071 "Given that $f(x)=ln⁡5+\\frac{7}{4}{e}^{x}$, the slope of the tangent line at $x=-ln⁡2$ is{{field-1}}." 17592186045443] [17592186480044 1072 #uuid "e471cfb8-b421-5129-be11-398f77d53a45" 17592186045443] [17592186480044 1074 "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $ln⁡5$ is a constant, so its derivative is $0.$\n\nFirst, using the addition rule, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(ln⁡5+\\frac{7}{4}{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(ln⁡5)+\\frac{\\text{d}}{\\text{d}x}(\\frac{7}{4}{e}^{x}) \\\\  & =0+\\frac{7}{4}\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =\\frac{7}{4}{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=-ln⁡2$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=-ln⁡2} & ={(\\frac{7}{4}{e}^{x})\\,|}_{x=-ln⁡2} \\\\  & =\\frac{7}{4}{e}^{-ln⁡2} \\\\  & =\\frac{7}{4}\\cdot \\frac{1}{2} \\\\  & =\\frac{7}{8}.\\end{aligned}\n$$" 17592186045443] [17592186480048 1068 17592186480035 17592186045443] [17592186480048 1070 17592186045487 17592186045443] [17592186480048 1071 "Given that $f(x)=\\frac{11}{4}{e}^{x}-11$, the slope of the tangent line at $x=-ln⁡5$ is{{field-1}}." 17592186045443] [17592186480048 1072 #uuid "f32ccf8c-9eba-53b7-a331-a184e3771a1b" 17592186045443] [17592186480048 1074 "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $-11$ is a constant, so its derivative is $0.$\n\nFirst, using the addition rule, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{11}{4}{e}^{x}-11) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\frac{11}{4}{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(-11) \\\\  & =\\frac{11}{4}\\frac{\\text{d}}{\\text{d}x}({e}^{x})+0 \\\\  & =\\frac{11}{4}{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=-ln⁡5$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=-ln⁡5} & ={(\\frac{11}{4}{e}^{x})\\,|}_{x=-ln⁡5} \\\\  & =\\frac{11}{4}{e}^{-ln⁡5} \\\\  & =\\frac{11}{4}\\cdot \\frac{1}{5} \\\\  & =\\frac{11}{20}.\\end{aligned}\n$$" 17592186045443] [17592186480049 1168 "generate/scratch/17592186096610.py" 17592186045443] [17592186480049 1169 #uuid "2b29a621-7f80-57ec-a542-5a8f8da8297b" 17592186045443] [17592186480052 1068 17592186480072 17592186045443] [17592186480052 1070 17592186045486 17592186045443] [17592186480052 1071 "Given that $f(x)=5{e}^{x}-4{x}^{5}+{x}^{3}$, find $f'(x)=$ {{field-1}}." 17592186045443] [17592186480052 1072 #uuid "0e3e6e3a-5c3f-5613-b235-49ab4e4951fc" 17592186045443] [17592186480052 1074 "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}f'(x) & =\\frac{\\text{d}}{\\text{d}x}(5{e}^{x}-4{x}^{5}+{x}^{3}) \\\\ & =\\frac{\\text{d}}{\\text{d}x}(5{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(4{x}^{5})+\\frac{\\text{d}}{\\text{d}x}({x}^{3}) \\\\ & =5\\frac{\\text{d}}{\\text{d}x}({e}^{x})-4\\frac{\\text{d}}{\\text{d}x}({x}^{5})+\\frac{\\text{d}}{\\text{d}x}({x}^{3}) \\\\ & =5{e}^{x}-4(5{x}^{4})+(3{x}^{2}) \\\\ & =5{e}^{x}-20{x}^{4}+3{x}^{2}.\\end{aligned}\n$$" 17592186045443] [17592186480057 1068 17592186480061 17592186045443] [17592186480057 1070 17592186045486 17592186045443] [17592186480057 1071 "Given that $f(x)=-2{e}^{x}-7{x}^{7}+2{x}^{3}$, find $f'(x)=$ {{field-1}}." 17592186045443] [17592186480057 1072 #uuid "2463bece-a1cd-5c87-bc99-c540684a9946" 17592186045443] [17592186480057 1074 "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}f'(x) & =\\frac{\\text{d}}{\\text{d}x}(-2{e}^{x}-7{x}^{7}+2{x}^{3}) \\\\ & =-\\frac{\\text{d}}{\\text{d}x}(2{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(7{x}^{7})+\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}) \\\\ & =-2\\frac{\\text{d}}{\\text{d}x}({e}^{x})-7\\frac{\\text{d}}{\\text{d}x}({x}^{7})+2\\frac{\\text{d}}{\\text{d}x}({x}^{3}) \\\\ & =-2{e}^{x}-7(7{x}^{6})+2(3{x}^{2}) \\\\ & =-2{e}^{x}-49{x}^{6}+6{x}^{2}.\\end{aligned}\n$$" 17592186045443] [17592186480059 1068 17592186480099 17592186045443] [17592186480059 1070 17592186045486 17592186045443] [17592186480059 1071 "Given that $f(x)=7{e}^{x}-2{x}^{4}-2{x}^{2}$, find $f'(x)=$ {{field-1}}." 17592186045443] [17592186480059 1072 #uuid "28f1a34b-c02b-5f32-a2d4-3b8647e374de" 17592186045443] [17592186480059 1074 "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}f'(x) & =\\frac{\\text{d}}{\\text{d}x}(7{e}^{x}-2{x}^{4}-2{x}^{2}) \\\\ & =\\frac{\\text{d}}{\\text{d}x}(7{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(2{x}^{4})-\\frac{\\text{d}}{\\text{d}x}(2{x}^{2}) \\\\ & =7\\frac{\\text{d}}{\\text{d}x}({e}^{x})-2\\frac{\\text{d}}{\\text{d}x}({x}^{4})-2\\frac{\\text{d}}{\\text{d}x}({x}^{2}) \\\\ & =7{e}^{x}-2(4{x}^{3})-2(2x) \\\\ & =7{e}^{x}-8{x}^{3}-4x.\\end{aligned}\n$$" 17592186045443] [17592186480063 1068 17592186480050 17592186045443] [17592186480063 1070 17592186045487 17592186045443] [17592186480063 1071 "For $x<-3$, let $f(x)=4{e}^{x}-4{x}^{2}-6x$. Then $f'(x)=$ {{field-1}}." 17592186045443] [17592186480063 1072 #uuid "39b1266c-5944-5dcf-b535-d35e41bcefcb" 17592186045443] [17592186480063 1074 "For $x<-3,$ we use the expression $f(x)=4{e}^{x}-4{x}^{2}-6x,$ which is differentiable.\n\nUsing the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x}-4{x}^{2}-6x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(4{x}^{2})-\\frac{\\text{d}}{\\text{d}x}(6x) \\\\  & =4{e}^{x}-8x-6.\\end{aligned}\n$$" 17592186045443] [17592186480079 1068 17592186480086 17592186045443] [17592186480079 1070 17592186045485 17592186045443] [17592186480079 1071 "Given that $f(x) = 7{e}^{x} - 2{x}^{2} + 1$, find $f^{′}(x)$." 17592186045443] [17592186480079 1072 #uuid "715a8ac6-fd66-549a-b175-7f154dd14992" 17592186045443] [17592186480079 1074 "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}f'(x) & =\\frac{\\text{d}}{\\text{d}x}(7{e}^{x}-2{x}^{2}+1) \\\\ & =\\frac{\\text{d}}{\\text{d}x}(7{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(2{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(1) \\\\ & =7\\frac{\\text{d}}{\\text{d}x}({e}^{x})-2\\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}(1) \\\\ & =7{e}^{x}-2(2x)+0 \\\\ & =7{e}^{x}-4x.\\end{aligned}\n$$" 17592186045443] [17592186480081 1068 17592186480103 17592186045443] [17592186480081 1070 17592186045487 17592186045443] [17592186480081 1071 "For $x<3$, let $g(x)=-2{e}^{x}-7{x}^{2}+2x$. Then $g'(x)=$ {{field-1}}." 17592186045443] [17592186480081 1072 #uuid "79103b32-86de-5f9f-9f15-ae04d815512a" 17592186045443] [17592186480081 1074 "For $x<3,$ we use the expression $g(x)=-2{e}^{x}-7{x}^{2}+2x,$ which is differentiable.\n\nUsing the addition and the power rules, we get\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(-2{e}^{x}-7{x}^{2}+2x) \\\\  & =-\\frac{\\text{d}}{\\text{d}x}(2{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(7{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(2x) \\\\  & =-2{e}^{x}-14x+2.\\end{aligned}\n$$" 17592186045443] [17592186480083 1068 17592186480076 17592186045443] [17592186480083 1070 17592186045486 17592186045443] [17592186480083 1071 "Given that $h(x)=4{e}^{x}-2{x}^{7}+6{x}^{3}$, find $h'(x)=$ {{field-1}}." 17592186045443] [17592186480083 1072 #uuid "7f89f273-a11f-549a-8a60-c366a1c603b1" 17592186045443] [17592186480083 1074 "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}h'(x) & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x}-2{x}^{7}+6{x}^{3}) \\\\ & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(2{x}^{7})+\\frac{\\text{d}}{\\text{d}x}(6{x}^{3}) \\\\ & =4\\frac{\\text{d}}{\\text{d}x}({e}^{x})-2\\frac{\\text{d}}{\\text{d}x}({x}^{7})+6\\frac{\\text{d}}{\\text{d}x}({x}^{3}) \\\\ & =4{e}^{x}-2(7{x}^{6})+6(3{x}^{2}) \\\\ & =4{e}^{x}-14{x}^{6}+18{x}^{2}.\\end{aligned}\n$$" 17592186045443] [17592186480088 1068 17592186480064 17592186045443] [17592186480088 1070 17592186045486 17592186045443] [17592186480088 1071 "Given that $h(x)=4{e}^{x}-4{x}^{4}-6{x}^{2}$, find $h'(x)=$ {{field-1}}." 17592186045443] [17592186480088 1072 #uuid "a03b064f-d419-5044-8615-d5e461c22029" 17592186045443] [17592186480088 1074 "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}h'(x) & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x}-4{x}^{4}-6{x}^{2}) \\\\ & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(4{x}^{4})-\\frac{\\text{d}}{\\text{d}x}(6{x}^{2}) \\\\ & =4\\frac{\\text{d}}{\\text{d}x}({e}^{x})-4\\frac{\\text{d}}{\\text{d}x}({x}^{4})-6\\frac{\\text{d}}{\\text{d}x}({x}^{2}) \\\\ & =4{e}^{x}-4(4{x}^{3})-6(2x) \\\\ & =4{e}^{x}-16{x}^{3}-12x.\\end{aligned}\n$$" 17592186045443] [17592186480089 1068 17592186480090 17592186045443] [17592186480089 1070 17592186045487 17592186045443] [17592186480089 1071 "Given that $f(x) = 7{e}^{x} - 2{x}^{2} - 2x - 18$, find $f^{′}(x)$." 17592186045443] [17592186480089 1072 #uuid "a8456306-9118-592b-ba3e-acf608603d3d" 17592186045443] [17592186480089 1074 "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}f'(x) & =\\frac{\\text{d}}{\\text{d}x}(7{e}^{x}-2{x}^{2}-2x-18) \\\\ & =\\frac{\\text{d}}{\\text{d}x}(7{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(2{x}^{2})-\\frac{\\text{d}}{\\text{d}x}(2x)-\\frac{\\text{d}}{\\text{d}x}(18) \\\\ & =7\\frac{\\text{d}}{\\text{d}x}({e}^{x})-2\\frac{\\text{d}}{\\text{d}x}({x}^{2})-2\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(18) \\\\ & =7{e}^{x}-2(2x)-2(1)-0 \\\\ & =7{e}^{x}-4x-2.\\end{aligned}\n$$" 17592186045443] [17592186480091 1068 17592186480098 17592186045443] [17592186480091 1070 17592186045487 17592186045443] [17592186480091 1071 "Given that $g(x) = 5{e}^{x} - 4{x}^{2} + x - 11$, find $g^{′}(x)$." 17592186045443] [17592186480091 1072 #uuid "bbc1984d-8d4d-5124-b526-4edb9aabc7e9" 17592186045443] [17592186480091 1074 "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}g'(x) & =\\frac{\\text{d}}{\\text{d}x}(5{e}^{x}-4{x}^{2}+x-11) \\\\ & =\\frac{\\text{d}}{\\text{d}x}(5{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(4{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(11) \\\\ & =5\\frac{\\text{d}}{\\text{d}x}({e}^{x})-4\\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(11) \\\\ & =5{e}^{x}-4(2x)+(1)-0 \\\\ & =5{e}^{x}-8x+1.\\end{aligned}\n$$" 17592186045443] [17592186480092 1068 17592186480073 17592186045443] [17592186480092 1070 17592186045485 17592186045443] [17592186480092 1071 "Let $f(x)={x}^{3}+6x$ and $g(x)={e}^{x}$. If $k(x)=g(x)-f(x)$, then $\\frac{\\text{d}k}{\\text{d}x}=$ {{field-1}}." 17592186045443] [17592186480092 1072 #uuid "bd74a88f-3e9e-54af-946f-d004983e42ec" 17592186045443] [17592186480092 1074 "Using the given definitions, we have\n\n$$\n\\begin{aligned}k(x) & =g(x)-f(x) \\\\  & ={e}^{x}-({x}^{3}+6x) \\\\  & ={e}^{x}-{x}^{3}-6x\\end{aligned}\n$$\n\nUsing the addition and power rules, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}k}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}({e}^{x}-{x}^{3}-6x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({e}^{x})-\\frac{\\text{d}}{\\text{d}x}({x}^{3})-\\frac{\\text{d}}{\\text{d}x}(6x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({e}^{x})-\\frac{\\text{d}}{\\text{d}x}({x}^{3})-6\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & ={e}^{x}-3{x}^{2}-6.\\end{aligned}\n$$" 17592186045443] [17592186480093 1068 17592186480066 17592186045443] [17592186480093 1070 17592186045485 17592186045443] [17592186480093 1071 "Given that $g(x)=4{e}^{x}-2{x}^{2}+8$, find the slope of the tangent at $x=1.$" 17592186045443] [17592186480093 1072 #uuid "bf13a195-c5b0-5308-8807-0ec8ba1fef3d" 17592186045443] [17592186480093 1074 "First, using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x}-2{x}^{2}+8) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(-2{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(8) \\\\  & =4\\frac{\\text{d}}{\\text{d}x}({e}^{x})-2\\frac{\\text{d}}{\\text{d}x}({x}^{2})+0 \\\\  & =4{e}^{x}-4x.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}g}{\\text{d}x}|}_{x=1} & ={(4{e}^{x}-4x)\\,|}_{x=1} \\\\  & =4{e}^{1}-4\\cdot 1 \\\\  & =-4 + 4 e.\\end{aligned}\n$$" 17592186045443] [17592186480107 1068 17592186480101 17592186045443] [17592186480107 1070 17592186045487 17592186045443] [17592186480107 1071 "Given that $g(x)=4{e}^{x}-2{x}^{2}+6x+8$, find the slope of the tangent at $x=0.$" 17592186045443] [17592186480107 1072 #uuid "fc8205dd-9383-5240-aa7c-245bff3c1e94" 17592186045443] [17592186480107 1074 "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x}-2{x}^{2}+6x+8) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(2{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(6x)+\\frac{\\text{d}}{\\text{d}x}(8) \\\\  & =4\\frac{\\text{d}}{\\text{d}x}({e}^{x})-2\\frac{\\text{d}}{\\text{d}x}({x}^{2})+6\\frac{\\text{d}}{\\text{d}x}(x)+\\frac{\\text{d}}{\\text{d}x}(8) \\\\  & =4{e}^{x}-2(2x)+6(1)+0 \\\\  & =4{e}^{x}-4x+6.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}g}{\\text{d}x}|}_{x=0} & ={(4{e}^{x}-4x+6)\\,|}_{x=0} \\\\  & =4{e}^{0}-4\\cdot 0+6 \\\\  & =4\\cdot 1+0+6 \\\\  & =4+6 \\\\  & =10.\\end{aligned}\n$$" 17592186045443] [17592186480109 1168 "generate/scratch/17592186096611.py" 17592186045443] [17592186480109 1169 #uuid "337ca211-135e-5973-81fe-043f1cf73b4b" 17592186045443] [17592186524404 1080 "4\\operatorname{ln}⁡2-2e" 17592186045417] [17592186524404 1082 17592186045498 17592186045417] [17592186524404 1083 #uuid "0caca0a6-1e08-5ddf-bb83-3bec4e2484b5" 17592186045417] [17592186524417 1080 "{f}^{′}(x)=4{e}^{x}-5{x}^{2}" 17592186045417] [17592186524417 1082 17592186045498 17592186045417] [17592186524417 1083 #uuid "13a8ae5e-2b27-5896-8bf1-0e1c78f29b99" 17592186045417] [17592186524450 1080 "12" 17592186045417] [17592186524450 1082 17592186045498 17592186045417] [17592186524450 1083 #uuid "25800a6b-d642-5c57-b91d-e8e45649680a" 17592186045417] [17592186524458 1080 "\\operatorname{ln}⁡2-4e" 17592186045417] [17592186524458 1082 17592186045498 17592186045417] [17592186524458 1083 #uuid "29c8efb8-570d-51ab-b67b-d69348dbbf78" 17592186045417] [17592186524525 1080 "9e^{x}" 17592186045417] [17592186524525 1082 17592186045498 17592186045417] [17592186524525 1083 #uuid "53709e9e-7e4f-52ba-ab20-e6b13619abb3" 17592186045417] [17592186524587 1080 "2e" 17592186045417] [17592186524587 1082 17592186045498 17592186045417] [17592186524587 1083 #uuid "83f09c8c-036c-5988-8f2a-b6776804e7ba" 17592186045417] [17592186524648 1080 "{f}^{′}(x)={e}^{x}-9x" 17592186045417] [17592186524648 1082 17592186045498 17592186045417] [17592186524648 1083 #uuid "a76babff-69cc-5977-a846-865ec261880c" 17592186045417] [17592186524657 1080 "{f}^{′}(x)=4{e}^{x}-10x-4" 17592186045417] [17592186524657 1082 17592186045498 17592186045417] [17592186524657 1083 #uuid "abe87bd5-4230-5c4c-a3fa-4e14394a9de6" 17592186045417] [1