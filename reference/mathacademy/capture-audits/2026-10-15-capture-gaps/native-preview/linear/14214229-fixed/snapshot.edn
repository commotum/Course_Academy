uuid "5f82e929-b888-5d34-a5dc-e42fb4ed9aff" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492} :db/id 17592186543349}] :question/difficulty {:db/id 17592186045487} :question/id #uuid "5e010595-5a96-5d35-8548-77ec2815a5a0" :question/math-academy-id "q-340285" :question/problem "Given that $f(x)=5\\cdot {7}^{x}$, the slope of the tangent at $x=0$ is{{field-1}}." :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(5\\cdot {7}^{x}) \\\\  & =5\\frac{\\text{d}}{\\text{d}x}({7}^{x}) \\\\  & =5\\operatorname{ln}⁡(7)\\cdot {7}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={(5\\operatorname{ln}⁡(7)\\cdot {7}^{x})|}_{x=0} \\\\  & =5\\operatorname{ln}⁡(7)\\cdot {7}^{0} \\\\  & =5\\operatorname{ln}⁡(7)\\cdot 1 \\\\  & =5\\operatorname{ln}⁡(7).\\end{aligned}\n$$"} :step/id #uuid "af2c57ec-5158-512f-86f1-2fb4d3101440"} {:db/id 17592186543657 :step/content {:db/id 17592186096989 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c78d12d-e0a1-56ab-9f9b-0b5ab3109e1b" :answer/type {:db/id 17592186045498} :answer/value "{f}^{′}(x)=5{e}^{x}+4{x}^{2}-3" :db/id 17592186542713} {:answer/id #uuid "207cc40d-fc6f-5da2-b43d-321cce4f0d3b" :answer/type {:db/id 17592186045498} :answer/value "{f}^{′}(x)={e}^{x}+4x" :db/id 17592186542728} {:answer/id #uuid "92c2fe7a-f2f7-5b68-8d4d-cf6414096282" :answer/type {:db/id 17592186045498} :answer/value "{f}^{′}(x)=5{e}^{x}+4x" :db/id 17592186543024} {:answer/id #uuid "9caf9432-187f-5eb0-a837-cd39bf99957b" :answer/type {:db/id 17592186045498} :answer/value "{f}^{′}(x)=5{e}^{x}+4x-3" :db/id 17592186543051} {:answer/id #uuid "c2b5f78e-5928-5e0b-9292-bc6f68419181" :answer/type {:db/id 17592186045498} :answer/value "{f}^{′}(x)=5{e}^{x}+4{x}^{2}" :db/id 17592186543149}] :answer-field/correct {:db/id 17592186543024} :answer-field/id #uuid "7eaf35cc-b950-5185-a9a1