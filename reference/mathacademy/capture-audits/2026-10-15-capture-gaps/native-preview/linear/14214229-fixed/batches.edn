[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186253334 :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({6}^{x}-5{x}^{2}+6x-19) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})-\\frac{\\text{d}}{\\text{d}x}(5{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(6x)-\\frac{\\text{d}}{\\text{d}x}(19) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})-5\\frac{\\text{d}}{\\text{d}x}({x}^{2})+6\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(19) \\\\  & =\\operatorname{ln}⁡6\\cdot {6}^{x}-5(2x)+6(1)-0 \\\\  & ={6}^{x}\\operatorname{ln}⁡6-10x+6.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186251060 :answer/value "{6}^{x}\\operatorname{ln}⁡6-10x+6" :db/ensure [:answer/validate]} {:db/id 17592186250976 :answer/value "{6}^{x}\\operatorname{ln}⁡6-10{x}^{2}+6x" :db/ensure [:answer/validate]} {:db/id 17592186252214 :answer/value "{6}^{x}\\operatorname{ln}⁡6-10{x}^{2}+6x-19" :db/ensure [:answer/validate]}] "assertions" [[17592186253334 :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({6}^{x}-5{x}^{2}+6x-19) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})-\\frac{\\text{d}}{\\text{d}x}(5{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(6x)-\\frac{\\text{d}}{\\text{d}x}(19) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})-5\\frac{\\text{d}}{\\text{d}x}({x}^{2})+6\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(19) \\\\  & =\\operatorname{ln}⁡6\\cdot {6}^{x}-5(2x)+6(1)-0 \\\\  & ={6}^{x}\\operatorname{ln}⁡6-10x+6.\\end{aligned}\n$$"] [17592186251060 :answer/value "{6}^{x}\\operatorname{ln}⁡6-10x+6"] [17592186250976 :answer/value "{6}^{x}\\operatorname{ln}⁡6-10{x}^{2}+6x"] [17592186252214 :answer/value "{6}^{x}\\operatorname{ln}⁡6-10{x}^{2}+6x-19"]] "retractions" [[17592186253334 :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({6}^{x}-5{x}