86045417] [17592186527081 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186527081 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186527081 #edb/ref 1078 #edb/ref 17592186526810 #edb/ref 17592186045417] [17592186527081 #edb/ref 1079 #uuid "a285d13c-8e91-53ff-befc-22c00f6c4f72" #edb/ref 17592186045417] [17592186527093 #edb/ref 1075 #edb/ref 17592186526512 #edb/ref 17592186045417] [17592186527093 #edb/ref 1075 #edb/ref 17592186526636 #edb/ref 17592186045417] [17592186527093 #edb/ref 1075 #edb/ref 17592186526673 #edb/ref 17592186045417] [17592186527093 #edb/ref 1075 #edb/ref 17592186526869 #edb/ref 17592186045417] [17592186527093 #edb/ref 1075 #edb/ref 17592186526905 #edb/ref 17592186045417] [17592186527093 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186527093 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186527093 #edb/ref 1078 #edb/ref 17592186526905 #edb/ref 17592186045417] [17592186527093 #edb/ref 1079 #uuid "bc195312-1e76-599e-a6d3-b22fd38f25b6" #edb/ref 17592186045417] [17592186527094 #edb/ref 1075 #edb/ref 17592186526677 #edb/ref 17592186045417] [17592186527094 #edb/ref 1075 #edb/ref 17592186526734 #edb/ref 17592186045417] [17592186527094 #edb/ref 1075 #edb/ref 17592186526857 #edb/ref 17592186045417] [17592186527094 #edb/ref 1075 #edb/ref 17592186526866 #edb/ref 17592186045417] [17592186527094 #edb/ref 1075 #edb/ref 17592186526878 #edb/ref 17592186045417] [17592186527094 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186527094 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186527094 #edb/ref 1078 #edb/ref 17592186526878 #edb/ref 17592186045417] [17592186527094 #edb/ref 1079 #uuid "c0679843-7790-5fe7-98d3-601893fb4657" #edb/ref 17592186045417] [17592186527146 #edb/ref 1068 #edb/ref 17592186527080 #edb/ref 17592186045417] [17592186527146 #edb/ref 1069 "q-143507" #edb/ref 17592186045417] [17592186527146 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186527146 #edb/ref 1071 "Let ${X}_{1},{X}_{2},…,{X}_{75}$ be a random sample of size $n=75$ from a population with probability density function \n\n$$\nf(x)=\\{\\begin{aligned}\\frac{3}{{x}^{4}}, & x\\ge 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nGiven that the population variance ${\\sigma }^{2}=0.75,$ calculate $P(1.5<\\overset{―}{X}<1.6).$\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $z$ | $\\,0.00\\,$ | $\\,0.01\\,$ | $\\,0.02\\,$ |\n| --- | --- | --- | --- |\n| $\\,0.9\\,$ | $\\,0.8159\\,$ | $\\,0.8186\\,$ | $\\,0.8212\\,$ |\n| $\\,1.0\\,$ | $\\,0.8413\\,$ | $\\,0.8438\\,$ | $\\,0.8461\\,$ |\n| $\\,1.1\\,$ | $\\,0.8643\\,$ | $\\,0.8665\\,$ | $\\,0.8686\\,$ |" #edb/ref 17592186045417] [17592186527146 #edb/ref 1072 #uuid "2f85c49f-b8cd-5032-99b8-bc70560e429d" #edb/ref 17592186045417] [17592186527146 #edb/ref 1074 "Suppose that ${X}_{1},{X}_{2},…,{X}_{n}$ is a random sample of size $n$ from a population with population mean $\\mu $ and population standard deviation $\\sigma .$ The central limit theorem (or CLT) states that for sufficiently large $n,$ the distribution of the sample mean $\\overset{―}{X}$ can be approximated as \n\n$$\n\\overset{―}{X}∼N\\,(\\mu ,\\frac{{\\sigma }^{2}}{n}).\n$$\n\nIn our case:\n\n- the sample size is\n\n$$\n\\begin{aligned}n & =75,\\end{aligned}\n$$\n\n- the population mean is\n\n$$\n\\begin{aligned}\\mu  & =\\text{E}[X] \\\\  & ={\\int }_{-\\infty }^{\\infty }x\\,f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }x\\cdot \\frac{3}{{x}^{4}}\\,\\text{d}x \\\\  & ={lim}_{b\\to \\infty }{\\int }_{1}^{b}\\frac{3}{{x}^{3}}\\,\\text{d}x \\\\  & ={lim}_{b\\to \\infty }{[-\\frac{3}{2{x}^{2}}]}_{1}^{b} \\\\  & ={lim}_{b\\to \\infty }[\\frac{3}{2}-\\frac{3}{2{b}^{2}}] \\\\  & =\\frac{3}{2} \\\\  & =1.5,\\end{aligned}\n$$\n\n- the population variance is ${\\sigma }^{2}=0.75.$\n\nTherefore, by the CLT, we have that the distribution of the sample mean can be approximated as\n\n$$\n\\begin{aligned}\\overset{―}{X} & ∼N\\,(\\mu ,\\frac{{\\sigma }^{2}}{n}) \\\\  & ∼N\\,(1.5,\\frac{0.75}{75}) \\\\  & ∼N(1.5,0.01).\\end{aligned}\n$$\n\nWe want to find $P(1.5<\\overset{―}{X}<1.6).$ So, we convert $\\overset{―}{X}$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(1.5<\\overset{―}{X}<1.6) & =P(\\frac{1.5-1.5}{\\sqrt{0.01}}<Z<\\frac{1.6-1.5}{\\sqrt{0.01}}) \\\\  & =P(0<Z<1) \\\\  & =P(Z<1)-P(Z<0) \\\\  & =Φ(1)-Φ(0)\\end{aligned}\n$$\n\nFrom the table, we have\n\n$$\nΦ(1)=0.8413,\n$$\n\nand by the symmetry of the normal distribution, $Φ(0)=0.5.$ Therefore,\n\n$$\n\\begin{aligned}P(1.5<\\overset{―}{X}<1.6) & =Φ(1)-Φ(0) \\\\  & =0.8413-0.5 \\\\  & =0.3413.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186527172 #edb/ref 1068 #edb/ref 17592186527093 #edb/ref 17592186045417] [17592186527172 #edb/ref 1069 "q-138973" #edb/ref 17592186045417] [17592186527172 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186527172 #edb/ref 1071 "Consider the curve defined parametrically as \n\n$$\nx=2\\operatorname{cos}⁡t,\\,y={sin}^{2}⁡t,\\,t\\in [0,\\pi ].\n$$\n\nWhat integral gives the surface area generated when this curve is rotated $2\\pi $ radians about the $x$-axis?" #edb/ref 17592186045417] [17592186527172 #edb/ref 1072 #uuid "7a3648d6-4396-5f3b-a4a5-7bdad067d750" #edb/ref 17592186045417] [17592186527172 #edb/ref 1074 "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $x$-axis using the formula\n\n$$\nS=\\int 2\\pi y\\,\\text{d}s.\n$$\n\nSince our curve is given in parametric form, we have\n\n$$\n\\text{d}s=\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}y\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nWe are told that the limits of integration are from ${t}_{1}=0$ to ${t}_{2}=\\pi .$ \n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)=-2\\operatorname{sin}⁡t \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({sin}^{2}⁡t)=2\\operatorname{sin}⁡t\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}y\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi }{sin}^{2}⁡t\\sqrt{{(-2\\operatorname{sin}⁡t)}^{2}+{(2\\operatorname{sin}⁡t\\operatorname{cos}⁡t)}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi }{sin}^{2}⁡t\\sqrt{4{sin}^{2}⁡t+4{sin}^{2}⁡t{cos}^{2}⁡t}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi }{sin}^{2}⁡t\\sqrt{4{sin}^{2}⁡t(1+{cos}^{2}⁡t)}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi }{sin}^{2}⁡t\\cdot |2\\operatorname{sin}⁡t|\\sqrt{1+{cos}^{2}⁡t}\\,\\text{d}t \\\\  & =4\\pi {\\int }_{0}^{\\pi }{sin}^{3}⁡t\\sqrt{1+{cos}^{2}⁡t}\\,\\text{d}t.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186527196 #edb/ref 1068 #edb/ref 17592186527029 #edb/ref 17592186045417] [17592186527196 #edb/ref 1069 "q-139125" #edb/ref 17592186045417] [17592186527196 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186527196 #edb/ref 1071 "The displacement $r,$ in meters, of a particle $P$ of mass $3\\,\\text{kg}$ is given by\n\n$$\nr=⟨{t}^{3},\\,{t}^{4}-{t}^{2}⟩,\n$$\n\nwhere $t>0$ is the time in seconds. Calculate the magnitude of the resultant force acting on the particle when $t=4\\,\\text{s}.$ Round your final answer to the nearest Newton." #edb/ref 17592186045417] [17592186527196 #edb/ref 1072 #uuid "ac6c0c1f-be4b-5795-8838-93be63fc1a08" #edb/ref 17592186045417] [17592186527196 #edb/ref 1074 "Newton’s second law states that\n\n$$\nF=ma,\n$$\n\n \nwhere $F$ is the *resultant* force, $m$ is the mass, and $a$ is the acceleration.\n\nTo compute the acceleration vector, we first differentiate $r$ to get the velocity vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{3}),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{4}-{t}^{2})⟩ \\\\  & =⟨3{t}^{2},\\,4{t}^{3}-2t⟩\\end{aligned}\n$$\n\nNext, we differentiate the velocity vector to get the acceleration vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}(4{t}^{3}-2t)⟩ \\\\  & =⟨6t,\\,12{t}^{2}-2⟩\\end{aligned}\n$$\n\nTherefore, the resultant force $F$ at time $t$ equals\n\n$$\n\\begin{aligned}F & =ma \\\\  & =3\\cdot ⟨6t,\\,12{t}^{2}-2⟩ \\\\  & =⟨18t,\\,36{t}^{2}-6⟩.\\end{aligned}\n$$\n\nWhen $t=4\\,\\text{s},$ we have\n\n$$\n\\begin{aligned}F(4) & =⟨18(4),\\,36({4}^{2})-6⟩ \\\\  & =⟨72,\\,570⟩.\\end{aligned}\n$$\n\nFinally, the magnitude of $F(4)$ is given by\n\n$$\n\\begin{aligned}|F(4)| & =\\sqrt{(72)^{2}+{(570)}^{2}} \\\\  & ≈575\\,\\text{N}\\end{aligned}\n$$\n\nrounded to the nearest Newton." #edb/ref 17592186045417] [17592186527230 #edb/ref 1058 #edb/ref 17592186527284 #edb/ref 17592186045417] [17592186527230 #edb/ref 1062 #uuid "09565298-9c43-54e4-9ad2-16dc8176d4eb" #edb/ref 17592186045417] [17592186527230 #edb/ref 1063 #edb/ref 17592186527195 #edb/ref 17592186045417] [17592186527233 #edb/ref 1058 #edb/ref 17592186527230 #edb/ref 17592186045417] [17592186527233 #edb/ref 1062 #uuid "12270953-49ad-5cbc-9697-5a803cf8a2d3" #edb/ref 17592186045417] [17592186527233 #edb/ref 1063 #edb/ref 17592186527202 #edb/ref 17592186045417] [17592186527249 #edb/ref 1062 #uuid "4f7e1c6e-7d68-545c-b26a-04a011d3cdbd" #edb/ref 17592186045417] [17592186527249 #edb/ref 1063 #edb/ref 17592186527171 #edb/ref 17592186045417] [17592186527259 #edb/ref 1058 #edb/ref 17592186527249 #edb/ref 17592186045417] [17592186527259 #edb/ref 1062 #uuid "710840c6-390b-5ef5-bf9d-aa99fdfbc7aa" #edb/ref 17592186045417] [1759