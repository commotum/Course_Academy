60-b67e-c44870ab4cd0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10{x}^{2}+6x-19" :db/id 17592186252214} {:db/id 17592186045493 :db/ident :answer-field.type/radio} {:db/id 17592186420504 :knowledge-point/_questions [{:db/id 17592186124654 :knowledge-point/id #uuid "4ca319c5-9f62-51e3-b670-611fc8a8daaa" :knowledge-point/title "Classifying a Critical Point Using the Second Partial Derivatives Test"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f54eb3dc-8f1a-5dd1-962f-c6bca73b03cb" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186477271} {:answer/id #uuid "8c3bd524-ddd5-53ed-ac7b-67c5c3c6cc25" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186477272}] :answer-field/correct {:answer/id #uuid "f54eb3dc-8f1a-5dd1-962f-c6bca73b03cb" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186477271} :answer-field/id #uuid "665a7adb-4995-5ab8-8dc0-620e006ab150" :answer-field/key "I" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186477605} {:answer-field/choices [{:answer/id #uuid "32a85eda-3d96-59fb-ae1a-38073082f1cc" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186477273} {:answer/id #uuid "dc13ebbc-79a8-5f41-b29b-888f990acc60" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186477274}] :answer-field/correct {:answer/id #uuid "dc13ebbc-79a8-5f41-b29b-888f990acc60" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186477274} :answer-field/id #uuid "3e1f0653-0d7e-5971-b6ae-0758b0a5f1c6" :answer-field/key "II" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186477606} {:answer-field/choices [{:answer/id #uuid "3e834f58-d2a9-5c2a-898e-e22835894832" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186477275} {:answer/id #uuid "793854ab-f508-5b37-924d-9eca03e5429b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186477276}] :answer-field/correct {:answer/id #uuid "3e834f58-d2a9-5c2a-898e-e22835894832" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186477275} :answer-field/id #uuid "56acc568-b4e3-5dd3-8613-65932ac1d099" :answer-field/key "III" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186477607}] :question/id #uuid "d1a7556c-36af-5f0b-b64c-a00089e6850e" :question/math-academy-id "q-37456" :question/problem "The function \n$f(x,y)$ \nhas the second derivative\n\n$$\n\\boldsymbol{f}^{″}(x,y)=\\begin{bmatrix}2 & 1 \\\\ 1 & 0\\end{bmatrix}\n$$\n\nand has a stationary point at $(1,1).$ If $H$ denotes the Hessian determinant of $f,$ which of the following statements are true?\n\nI. $H(1,1)>0$\n\nII. $\\frac{{∂}^{2}f}{∂{x}^{2}}(1,1)>0$\n\nIII. The point $(1,1)$ is a local minimum of $f$\n\nSelect all that apply." :question/worked-solution "The second partial derivative test states that if $a\\in {R}^{2}$ is a stationary point of $f(x,y)$ with Hessian determinant $H(a),$ we have the following:\n\n- If $H(a)>0,$ then:\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)<0,$ then $f$ has a local maximum at $a$\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)>0,$ then $f$ has a local minimum at $a$\n\n- If $H(a)<0,$ then $f$ has a saddle point at $a$\n\n- If $H(a)=0,$ then the second partial derivatives test is inconclusive.\n\nEvaluating the second derivative at $(1,1),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(1,1)=\\begin{bmatrix}2 & 1 \\\\ 1 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, let's examine our statements in turn.\n\n- Statement I is false. Indeed, computing the determinant of ${f}^{″}(1,1),$ we get\n\n$$\nH(1,1)=det({f}^{″}(1,1))=2\\cdot 0-{1}^{2}=-1<0.\n$$\n\n- Statement II is true. Indeed, we have $\\frac{{∂}^{2}f}{∂{x}^{2}}(1,1)=({f}^{″}(1,1))_{11}=2>0.$\n\n- Statement III is false. Since $H(1,1)<0,$ then $(1,1)$ is a saddle point by the second partial derivative test.\n\nTherefore, the correct answer is \"II only.\""} {:db/id 17592186124654 :knowledge-point/id #uuid "4ca319c5-9f62-51e3-b670-611fc8a8daaa" :knowledge-point/title "Classifying a Critical Point Using the Second Partial Derivatives Test"} {:answer-field/choices [{:answer/id #uuid "f54eb3dc-8f1a-5dd1-962f-c6bca73b03cb" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186477271} {:answer/id #uuid "8c3bd524-ddd5-53ed-ac7b-67c5c3c6cc25" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186477272}] :answer-field/correct {:answer/id #uuid "f54eb3dc-8f1a-5dd1-962f-c6bca73b03cb" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186477271} :answer-field/id #uuid "665a7adb-4995-5ab8-8dc0-620e006ab150" :answer-field/key "I" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186477605} {:answer/id #uuid "f54eb3dc-8f1a-5dd1-962f-c6bca73b03cb" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186477271} {:db/id 17592186045499 :db/ident :answer.type/text} {:answer/id #uuid "8c3bd524-ddd5-53ed-ac7b-67c5c3c6cc25" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186477272} {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} {:answer-field/choices [{:answer/id #uuid "32a85eda-3d96-59fb-ae1a-38073082f1cc" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186477273} {:answer/id #uuid "dc13ebbc-79a8-5f41-b29b-888f990acc60" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text}