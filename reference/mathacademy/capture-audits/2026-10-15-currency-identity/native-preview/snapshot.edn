swer/id #uuid "8af9a23c-445a-5275-9661-7299cac973d5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "40\\,875" :db/id 17592186556762} {:answer/id #uuid "9ee33d95-d119-584c-b8ee-7dac64f9c29c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "50\\,000" :db/id 17592186556817} {:answer/id #uuid "fb544b2f-30e9-5368-a619-27b767c38ae4" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "48\\,675" :db/id 17592186557052} {:activity/expected-seconds 420.0 :activity/first-step {:db/id 17592186116356} :activity/id #uuid "c1204165-46fa-568c-a8e1-e13727d2be23" :activity/scope {:db/id 17592186049732 :topic/id #uuid "0f13295d-4ece-5423-b035-ea84905ef389" :topic/math-academy-id 1629} :activity/steps [{:db/id 17592186116356 :step/content {:db/id 17592186116434 :tutorial/content "In this lesson, we will learn how to interpret various aspects of an exponential decay expression or function.\n\nFor example, suppose that, due to overfishing, a fish population decays exponentially. The population $y(t)$ is given by\n\n$$\ny(t) = 5\\,000 \\left(\\dfrac 1 2\\right)^t,\n$$\n\nwhere $t$ is the time, in months, since the overfishing began. What can we deduce about the population of fish from this model?\n\nThe first thing to notice is that the function above is an exponential decay function of the form\n\n$$\ny(t) = a \\cdot b^t.\n$$\n\nSo, we can deduce the following:\n\n- $a=5\\,000$ represents the initial value. So this tells us that there were $5\\,000$ fish when the overfishing began.\n\n- $b = \\dfrac 1 2$ is the decay factor. Since $0 < b < 1,$ this tells us that we're dealing with exponential decay, *not* exponential growth (for exponential growth we need $b > 1$).\n\n- $t$ is the time, in months, since the overfishing began." :tutorial/id #uuid "adec391e-8573-55bf-b53b-d5d15177f633" :tutorial/math-academy-id 1970 :tutorial/title "Introduction"} :step/id #uuid "b36f7829-7634-567d-9517-b3c22769bd8e" :step/math-academy-id 7129 :step/next {:db/id 17592186116359}} {:db/id 17592186116357 :step/content {:db/id 17592186115383 :knowledge-point/canonical-example {:db/id 17592186114948 :question/id #uuid "df739a77-559a-53ed-ad04-be16403b9f46" :question/math-academy-id "e-2076"} :knowledge-point/id #uuid "aeafe81f-2d40-5413-8d19-881972161400" :knowledge-point/questions [{:db/id 17592186115868} {:db/id 17592186115869} {:db/id 17592186508972} {:db/id 17592186508980} {:db/id 17592186557278}] :knowledge-point/title "Interpreting the Output of an Exponential Decay Function"} :step/id #uuid "a9eb3a9e-cbd0-5d23-976c-d6e30621bd62" :step/math-academy-id 7131 :step/next {:db/id 17592186116358}} {:db/id 17592186116358 :step/content {:db/id 17592186115384 :knowledge-point/canonical-example {:db/id 17592186114949 :question/id #uuid "d550f36c-a6f0-5b37-a998-4d44fa5f1d3d" :question/math-academy-id "e-2078"} :knowledge-point/id #uuid "cd0f5949-6a1a-5187-a246-8f9bac2e8d58" :knowledge-point/questions [{:db/id 17592186115865} {:db/id 17592186115866} {:db/id 17592186508947} {:db/id 17592186508951}] :knowledge-point/title "Interpreting a Decay Rate"} :step/id #uuid "370e94ab-be87-5775-983a-458131b0b569" :step/math-academy-id 7133} {:db/id 17592186116359 :step/content {:db/id 17592186115385 :knowledge-point/canonical-example {:db/id 17592186114950 :question/id #uuid "795b2573-6738-5fbd-a0f4-9d94eff7aee7" :question/math-academy-id "e-2079"} :knowledge-point/id #uuid "ab694f0f-947f-5bba-ad7a-988ea28a97fd" :knowledge-point/key-prerequisites [{:db/id 17592186049657}] :knowledge-point/questions [{:db/id 17592186115867} {:db/id 17592186115910} {:db/id 17592186508950} {:db/id 17592186508967}] :knowledge-point/title "Interpreting Exponential Expressions"} :step/id #uuid "07158a3f-d957-5396-9819-37e29b775de6" :step/math-academy-id 7137 :step/next {:db/id 17592186116357}}] :activity/title "Interpreting Exponential Decay" :activity/type {:db/id 17592186045463 :db/ident :activity.type/lesson} :db/id 175