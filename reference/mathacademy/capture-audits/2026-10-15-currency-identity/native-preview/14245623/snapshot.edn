2-9c18-6a21a65bc008" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493} :db/id 17592186544720}] :question/difficulty {:db/id 17592186045487} :question/id #uuid "6e8aaddd-953c-576c-ad6b-2e4d36b66988" :question/math-academy-id "q-130578" :question/problem "Evaluate $f(1,1)$ if $f(x,y)=(3y-x)^{3}+(2x-y)^{2}.$" :question/worked-solution "We substitute $x=1$ and $y=1$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}f(x,y) & =(3y-x)^{3}+(2x-y)^{2} \\\\ f(1,1) & =(3(1)-1)^{3}+(2(1)-1)^{2} \\\\  & ={2}^{3}+{1}^{2} \\\\  & =8+1 \\\\  & =9\\end{aligned}\n$$"} :step/id #uuid "fffd7ed9-55d6-58a4-b296-ec80636460e6"} {:answer-field/choices [{:answer/id #uuid "2522a912-6ec9-5d1e-9006-2d6a985f8f29" :answer/type {:db/id 17592186045498} :answer/value "6" :db/id 17592186544168} {:answer/id #uuid "32bfe30f-860e-5462-9664-fd946b7e9aeb" :answer/type {:db/id 17592186045498} :answer/value "11" :db/id 17592186544200} {:answer/id #uuid "432f6ee1-afa8-57d6-ae54-4a08db2f0814" :answer/type {:db/id 17592186045498} :answer/value "10" :db/id 17592186544235} {:answer/id #uuid "92fc0bde-21ea-528f-87e4-e626ffa89252" :answer/type {:db/id 17592186045498} :answer/value "7" :db/id 17592186544411} {:answer/id #uuid "f5c66c90-2e89-5fdf-92e0-e36e92e33fac" :answer/type {:db/id 17592186045498} :answer/value "9" :db/id 17592186544622}] :answer-field/correct {:db/id 17592186544622} :answer-field/id #uuid "92a31c45-7d31-5b52-9c18-6a21a65bc008" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493} :db/id 17592186544720} {:answer/id #uuid "2522a912-6ec9-5d1e-9006-2d6a985f8f29" :answer/type {:db/id 17592186045498} :answer/value "6" :db/id 17592186544168} {:answer/id #uuid "32bfe30f-860e-5462-9664-fd946b7e9aeb" :answer/type {:db/id 17592186045498} :answer/value "11" :db/id 17592186544200} {:answer/id #uuid "432f6ee1-afa8-57d6-ae54-4a08db2f0814" :answer/type {:db/id 17592186045498} :answer/value "10" :db/id 17592186544235} {:answer/id #uuid "92fc0bde-21ea-528f-87e4-e626ffa89252" :answer/type {:db/id 17592186045498} :answer/value "7" :db/id 17592186544411} {:answer/id #uuid "f5c66c90-2e89-5fdf-92e0-e36e92e33fac" :answer/type {:db/id 17592186045498} :answer/value "9" :db/id 17592186544622} {:activity/expected-seconds 660.0 :activity/first-step {:db/id 17592186074657} :activity/id #uuid "7809af08-83ac-5450-986d-2614a3fd22d3" :activity/scope {:db/id 17592186048826 :topic/id #uuid "c375d3cc-e398-5a47-a69f-ddc853431752" :topic/math-academy-id 487} :activity/steps [{:db/id 17592186074657 :step/content {:db/id 17592186075033 :tutorial/content "Suppose that we want to solve, *without* using graphs, the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}x+y &=4 \\\\ x-2 &=y\\,\\end{aligned}\\right.\n$$\n\nIn order to solve the system without a graph, we will need to combine the equations into a single equation that can be solved using algebraic manipulation.\n\nOne way to combine the equations is called the **substitution method.** To use the substitution method, we substitute for one variable in terms of the other.\n\nFor instance, notice that we can make $y$ the subject of the second equation:\n\n$$\n\\color{red}y=x - 2\n$$\n\nSubstituting this expression for $y$ into the first equation, we get an equation that we can solve for $x\\mathbin{:}$\n\n$$\n\\begin{aligned}x+y & =4 \\\\ x+(x-2) & =4 \\\\ 2x-2 & =4 \\\\ 2x & =6 \\\\ x & =3\\end{aligned}\n$$\n\nSo, the solution must have $x=3.$ But we also need to figure out what $y$ is. We can do this by substituting $x=3$ back into the second equation:\n\n$$\n\\begin{aligned}y & =x-2 \\\\ y & =3-2 \\\\ y & =1\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x = 3$ and $y = 1$, which can be written as $\\left(3, 1\\right).$\n\n**Note:** Whenever we isolate the variable in one equation, we have to substitute it into the *other* equation. We cannot substitute a variable into the same equation it came from, because this will not give us any more information about the variable." :tutorial/id #uuid "e1e8cb2d-3d4e-5cb9-8947-2bd9deb11b89" :tutorial/math-academy-id 8131 :tutorial/title "Introduction"} :step/id #uuid "413b9b90-7693-5568-a868-970271a5a258" :step/math-academy-id 197419 :step/next {:db/id 17592186074658}} {:db/id 17592186074658 :step/content {:db/id 17592186073752 :knowledge-point/canonical-example {:db/id 17592186073445 :question/id #uuid "e9aae52c-65f3-5dff-bc6b-a530f8c7acc1" :question/math-academy-id "e-13009"} :knowledge-point/id #uuid "5e79a91b-c479-53da-9f06-59c082fa4187" :knowledge-point/key-prerequisites [{:db/id 17592186048678} {:db/id 17592186050622}] :knowledge-point/question-generator {:db/id 17592186508241} :knowledge-point/questions [{:db/id 17592186074030} {:db/id 17592186074172} {:db/id 17592186074185} {:db/id 17592186233560} {:db/id 17592186233567} {:db/id 17592186233574} {:db/id 17592186496226} {:db/id 17592186496255} {:db/id 17592186497411} {:db/id 17592186503753} {:db/id 17592186508171} {:db/id 17592186508174} {:db/id 17592186508179} {:db/id 17592186508187} {:db/id 17592186508204} {:db/id 17592186508205} {:db/id 17592186508207} {:db/id 17592186508210} {:db/id 17592186508214} {:db/id 17592186508215} {:db/id 17592186508227} {:db/id 17592186508233} {:db/id 17592186546971} {:db/id 17592186558573} {:db/id 17592186562396}] :knowledge-point/title "Solving a System of Linear Equations Using Substitution"} :step/id #uuid "99e9f36f-648c-5025-bfca-c63f6f77d9b1" :step/math-academy-id 197420 :step/next {:db/id 17592186074659}} {:db/id 17592186074659 :step/content {:db/id 17592186073753 :knowledge-point/canonical-example {:db/id 17592186073446 :question/id #uuid "707504e8-a367-5dc2-a663-371a9dcf7224" :question/math-academy-id "e-13010"} :knowledge-point/id #uuid "b4352698-7af7-5d74-9c3a-0f951c3e6078" :knowledge-point/question-generator {:db/id 17592186505092} :knowledge-point/questions [{:db/id 17592186073997} {:db/id 17592186073998} {:db/id 17592186074047} {:db/id 17592186496252} {:db