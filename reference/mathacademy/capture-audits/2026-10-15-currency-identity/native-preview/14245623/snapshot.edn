answer/id #uuid "28841ece-193a-5984-aca8-980d7d142fd5" :answer/type {:db/id 17592186045498} :answer/value "g(-3)=29" :db/id 17592186492301} {:answer/id #uuid "8bf18704-fb98-57f4-be11-81048d8cd298" :answer/type {:db/id 17592186045498} :answer/value "g(-3)=49" :db/id 17592186492495} {:answer/id #uuid "8d6261f9-d215-5ae3-bfdb-9431ed756997" :answer/type {:db/id 17592186045498} :answer/value "g(-3)=-21" :db/id 17592186492496}] :answer-field/correct {:db/id 17592186492496} :answer-field/id #uuid "76bd600f-4df3-5837-8db3-4c610cb01b2d" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493} :db/id 17592186492754}] :question/difficulty {:db/id 17592186045487} :question/id #uuid "3e0ff0f4-e55f-55b3-97b5-30132033682d" :question/math-academy-id "q-12993" :question/problem "Evaluate $g(-3)$, where $g(x)=(x+1)^{2}-(x-2)^{2}.$" :question/worked-solution "We substitute $x=-3$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}g(x) & =(x+1)^{2}-(x-2)^{2} \\\\ g(-3) & =(-3+1)^{2}-(-3-2)^{2} \\\\  & =(-2)^{2}-(-5)^{2} \\\\  & =4-25 \\\\  & =-21\\end{aligned}\n$$"} :step/id #uuid "45066582-f649-5b97-b9fa-5d0d0116ad1b" :step/next {:db/id 17592186492959}} {:db/id 17592186492957 :step/content {:db/id 17592186492852 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ea9fe05-136c-54fa-8287-468235cbdb0d" :answer/type {:db/id 17592186045498} :answer/value "-8" :db/id 17592186492316} {:answer/id #uuid "92ff2ec6-c1ed-57da-a105-85732944baad" :answer/type {:db/id 17592186045498} :answer/value "-16" :db/id 17592186492504} {:answer/id #uuid "c4dd854f-76b8-57b7-925b-6bec0085d762" :answer/type {:db/id 17592186045498} :answer/value "6" :db/id 17592186492611} {:answer/id #uuid "c81618e6-76ad-5708-8e7c-de8c549d1cea" :answer/type {:db/id 17592186045498} :answer/value "-12" :db/id 17592186492616} {:answer/id #uuid "cfb62b1a-34c6-56d6-983c-37f403386609" :answer/type {:db/id 17592186045498} :answer/value "10" :db/id 17592186492629}] :answer-field/correc