 {:db/id 17592186508214 :question/id #uuid "92720f95-de85-556b-8f87-1b3810fd832e"} {:db/id 17592186508215 :question/id #uuid "9362a51f-6c19-5264-931e-57aaf13ce3e6"} {:db/id 17592186508227 :question/id #uuid "b0966484-f411-5cf8-8677-c24b7843a43c"} {:db/id 17592186508233 :question/id #uuid "ddedcc45-5aba-5229-89b3-d8e7abbe4344"} {:db/id 17592186546971 :question/id #uuid "1ad70587-af92-55e0-95cf-31aa82c10e13" :question/math-academy-id "q-52115"} {:db/id 17592186558573 :question/id #uuid "f2633cd2-d747-5eed-ad0b-333971ef5a97" :question/math-academy-id "q-181154"} {:db/id 17592186562396 :question/id #uuid "0c604a3f-ba93-531d-b858-55cd303f28fb" :question/math-academy-id "q-171693"}] :knowledge-point/title "Solving a System of Linear Equations Using Substitution"} {:db/id 17592186073445 :question/id #uuid "e9aae52c-65f3-5dff-bc6b-a530f8c7acc1" :question/math-academy-id "e-13009"} {:db/id 17592186048678} {:db/id 17592186508241} {:db/id 17592186074030 :question/id #uuid "acc0a44e-6eb6-5a95-a139-3841ec88693b" :question/math-academy-id "q-171690"} {:db/id 17592186074172 :question/id #uuid "963fb1bc-3f29-5c06-94a9-37168b40e1c1" :question/math-academy-id "q-4133"} {:db/id 17592186074185 :question/id #uuid "5c71bd6b-b9a3-5587-89f4-a14a2c760bc2" :question/math-academy-id "q-5179" :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "831b8a12-3240-5543-8f0b-63a066174430" :answer/type {:db/id 17592186045498} :answer/value "3" :db/id 17592186071349} {:answer/id #uuid "e71abec1-af90-564e-96cc-65f749dff99a" :answer/type {:db/id 17592186045498} :answer/value "-4" :db/id 17592186071350} {:answer/id #uuid "f9bd14c8-f201-5c70-ba77-5489006197a2" :answer/type {:db/id 17592186045498} :answer/value "-3" :db/id 17592186071351} {:answer/id #uuid "30891c0a-e32e-5e99-9826-2629f5f5792b" :answer/type {:db/id 17592186045498} :answer/value "2" :db/id 17592186071352} {:answer/id #uuid "424e6c76-ef65-55f4-bb2c-05129500785f" :answer/type {:db/id 17592186045498} :answer/value "5" :db/id 17592186071353}] :answer-field/correct {:db/id 17592186071349} :answer-field/id #uuid "4ff0f62d-b46f-5fed-abea-e9c339cbff76" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493} :db/id 17592186071348}] :question/difficulty {:db/id 17592186045487} :question/problem "Given the system of equations below, what is the value of $p-q?$\n\n$$\n\\{\\begin{aligned}3p=15 \\\\ p+2q=9.\\end{aligned}\n$$" :question/worked-solution "We will isolate a variable in one of the equations and then substitute it into the other equation. It doesn't matter which equation we pick first, so we choose the easiest one. In this case, the first equation looks like the easiest.\n\nUsing the first equation, we can isolate $p$ by dividing both sides of the equation by $3:$\n\n$$\n\\begin{aligned}3p & =15 \\\\ p & =5\\end{aligned}\n$$\n\nIf we now substitute $p=5$ into $p+2q=9,$ then we can find the value of $q:$\n\n$$\n\\begin{aligned}p+2q & =9 \\\\ (5)+2q & =9 \\\\ 2q & =4 \\\\ q & =2\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $p=5,\\,q=2.$ So,\n\n$$\np-q=5-2=3.\n$$"} {:db/id 17592186233560 :question/id #uuid "ba03c851-f080-5b98-bcba-fc2174ffc663" :question/math-academy-id "q-167194"} {:db/id 17592186233567 :question/id #uuid "d104504e-e7b5-56df-8154-499bbc1d3f80" :question/math-academy-id "q-167210"} {:db/id 17592186233574 :question/id #uuid "6afc1799-60d6-5f69-94a5-994731079a93" :question/math-academy-id "q-167226"} {:db/id 17592186496226 :question/id #uuid "07b5302b-d797-5328-827e-aa28a460f929" :question/math-academy-id "q-181149"} {:db/id 17592186496255 :question/id #uuid "4c3907fe-c83e-5bd5-ac54-297aa503451b" :question/math-academy-id "q-181175"} {:db/id 17592186497411 :question/id #uuid "ededc7bf-b310-5714-a047-930df525362b" :question/math-academy-id "q-166843"} {:db/id 17592186503753 :question/id #uuid "ee041a5d-3530-58d3-9ad7-acdf10ca4984" :question/math-academy-id "q-166761"} {:db/id 17592186508171 :question/id #uuid "01d4210c-99cb-5509-8003-8615f9f2d644"} {:db/id 17592186508174 :question/id #uuid "1814dd75-6dc3-5a88-93bf-56fa1a5ec858"} {:db/id 17592186508179 :question/id #uuid "2e8faafd-e3ef-5205-a5d6-b458af26d97f"} {:db/id 17592186508187 :question/id #uuid "3db3cd07-1246-5ea5-a44f-5fee48dd9a13"} {:db/id 17592186508204 :question/id #uuid "76c476e0-406c-5751-a806-f5cbe03fe610"} {:db/id 17592186508205 :question/id #uuid "7afeeb08-8b8f-54f1-86b4-033f592e20d8"} {:db/id 17592186508207 :question/id #uuid "7c5faa09-66e6-54c1-b548-04286527c92b"} {:db/id 17592186508210 :question/id #uuid "873b7f6f-85bd-5d73-adb8-dc5d593e552e"} {:db/id 17592186508214 :question/id #uuid "92720f95-de85-556b-8f87-1b3810fd832e"} {:db/id 17592186508215 :question/id #uuid "9362a51f-6c19-5264-931e-57aaf13ce3e6"} {:db/id 17592186508227 :question/id #uuid "b0966484-f411-5cf8-8677-c24b7843a43c"} {:db/id 17592186508233 :question/id #uuid "ddedcc45-5aba-5229-89b3-d8e7abbe4344"} {:db/id 17592186546971 :question/id #uuid "1ad70587-af92-55e0-95cf-31aa82c10e13" :question/math-academy-id "q-52115" :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25d7a53c-5916-5db7-992b-ff7a626a51c4" :answer/type {:db/id 17592186045498} :answer/value "-5" :db/id 17592186546336} {:answer/id #uuid "51399b6f-2763-5014-9b02-635633f0dada" :answer/type {:db/id 17592186045498} :answer/value "7" :db/id 17592186546427} {:answer/id #uuid "9e23c320-e17b-534f-8a91-354568ebc163" :answer/type {:db/id 17592186045498} :answer/value "6" :db/id 17592186546603} {:answer/id #uuid "a3f272eb-ffc1-5fb6-b622-055a0def12d3" :answer/type {:db/id 17592186045498} :answer/value "-1" :db/id 17592186546617} {:answer/id #uuid "d9f37f2b-79d8-5ebd-8615-8e1bcfb28380" :answer/type {:db/id 17592186045498} :answer/value "8" :db/id 17592186546732}] :answer-field/correct {:db/id 17592186546732} :answer-field/id #uuid "78ca5c4c-b502-5598-a6f0-d81d606b319e" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493} :db/id 17592186546881}] :question/difficulty {:db/id 17592186045487} :question/problem "Given the system of equations below, what is the value of $a-b?$\n\n$$\n\\{\\begin{aligned}a=7 \\\\ 3a+6b=15\\end{aligned}\n$$" :question/worked-solution "We will isolate a variable in one of the equations and then substitute it into the other equation. It so happens that the first equation is already solved for $a:$\n\n$$\na=7\n$$\n\nIf we now substitute $a=7$ into $3a+6b=15,$ then we can find the value of $b:$\n\n$$\n\\begin{aligned}3a+6b & =15 \\\\ 3(7)+6b & =15 \\\\ 6b & =-6 \\\\ b & =-1\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $a=7,\\,b=-1.$ So,\n\n$$\na-b=7-(-1)=7+1=8.\n$$"} {:db/id 17592186558573 :question/id #uuid "f2633cd2-d747-5eed-ad0b-333971ef5a97" :question/math-academy-id "q-181154"} {:db/id 17592186562396 :question/id #uuid "0c604a3f-ba93-531d-b858-55cd303f28fb" :question/math-academy-id "q-171693"} {:db/id 17592186073753 :knowledge-point/canonical-example {:db/id 17592186073446 :question/id #uuid "707504e8-a367-5dc2-a663-371a9dcf7224" :question/math-academy-id "e-13010"} :knowledge-point/id #uuid "b4352698-7af7-5d74-9c3a-0f951c3e6078" :knowledge-point/question-generator {:db/id 17592186505092} :knowledge-point/questions [{:db/id 17592186073997 :question/id #uuid "833a2ed3-b37f-5ade-bd6a-5fdaf64b6506" :question/math-academy-id "q-12444"} {:db/id 17592186073998 :question/id #uuid "90bf8b55-699c-5e18-b484-90473cb6a72f" :question/math-academy-id "q-12457"} {:db/id 17592186074047 :question/id #uuid "a7c18dc6-0363-5db7-9c51-22de1db359fc" :question/math-academy-id "q-18483"} {:db/id 17592186496252 :question/id #uuid "498d2b3f-6756-59df-bd3d-256bb722b0aa" :question/math-academy-id "q-112214"} {:db/id 17592186496314 :question/id #uuid "d389f84f-6df2-5d57-9702-acb625d9c80f" :question/math-academy-id "q-181207"} {:db/id 17592186505001 :question/id #uuid "019711ee-80ff-5bba-9b3e-59b676517b88"} {:db/id 17592186505002 :question/id #uuid "037d812f-9cb8-5f58-959c-05369edfd299"} {:db/id 17592186505004 :