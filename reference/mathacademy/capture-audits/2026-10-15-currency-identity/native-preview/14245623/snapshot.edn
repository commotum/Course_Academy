 substitute $x=1$ into the expression for $g(x)$ and simplify: \n\n$$\n\\begin{aligned}g(x) & ={x}^{4}+3{x}^{3}+{x}^{2}-4x \\\\ g(1) & ={1}^{4}+3\\cdot {1}^{3}+{1}^{2}-4\\cdot 1 \\\\  & =1+3+1-4 \\\\  & =1\\end{aligned}\n$$\n\nTherefore, $g(1)=1.$"} {:db/id 17592186485579 :question/id #uuid "c90c9cf4-1ba5-5ca6-8d2b-ccc36ce67160" :question/math-academy-id "q-52131" :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33703d26-72cd-5cc0-aca3-ff27ce58c3a9" :answer/type {:db/id 17592186045498} :answer/value "28" :db/id 17592186484926} {:answer/id #uuid "4a0251a2-5a6f-5f2e-a8d7-4946c3bfa1a2" :answer/type {:db/id 17592186045498} :answer/value "10" :db/id 17592186484979} {:answer/id #uuid "4a178c66-540d-5353-b5cb-382e367946e5" :answer/type {:db/id 17592186045498} :answer/value "27" :db/id 17592186484980} {:answer/id #uuid "7976dd35-fda1-58e9-9f8c-a10bdfaee619" :answer/type {:db/id 17592186045498} :answer/value "11" :db/id 17592186485080} {:answer/id #uuid "d27f363a-0795-5e28-96ae-acdc39887ec9" :answer/type {:db/id 17592186045498} :answer/value "30" :db/id 17592186485260}] :answer-field/correct {:db/id 17592186484926} :answer-field/id #uuid "39e37d12-a990-5afb-9a51-3025326ee005" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493} :db/id 17592186485391}] :question/difficulty {:db/id 17592186045485} :question/problem "Given the polynomial $f(x)=3{x}^{2}+1,$ $f(3)=$" :question/worked-solution "We substitute $x=x$ into the expression for $f(x)$ and simplify: \n\n$$\n\\begin{aligned}f(x) & =3{x}^{2}+1 \\\\ f(3) & =3(3)^{2}+1 \\\\  & =27+1 \\\\  & =28\\end{aligned}\n$$\n\nTherefore, $f(3)=28.$"} {:db/id 17592186048369} {:db/id 17592186048406} {:db/id 17592186048422} {:db/id 17592186049399 :topic/id #uuid "f1aa8ae2-23cf-5d91-8af0-a43e9db5e668" :topic/knowledge-points [{:db/id 17592186133746 :knowledge-point/canonical-example {:db/id 17592186133531 :question/id #uuid "00113d76-b950-513e-a3ea-29eef91c9cec" :question/math-academy-id "e-14383"} :kno