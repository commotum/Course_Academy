 17592186485426}] :question/difficulty {:db/id 17592186045485} :question/id #uuid "14cc1a32-5526-5826-8d11-3b9752e2a607" :question/math-academy-id "q-74463" :question/problem "Given the polynomial $g(x)={x}^{4}+3{x}^{3}+{x}^{2}-4x,$ $g(1)=$" :question/worked-solution "We substitute $x=1$ into the expression for $g(x)$ and simplify: \n\n$$\n\\begin{aligned}g(x) & ={x}^{4}+3{x}^{3}+{x}^{2}-4x \\\\ g(1) & ={1}^{4}+3\\cdot {1}^{3}+{1}^{2}-4\\cdot 1 \\\\  & =1+3+1-4 \\\\  & =1\\end{aligned}\n$$\n\nTherefore, $g(1)=1.$"} :step/id #uuid "fb3db9c8-817f-5352-8d1f-22e473869755"}] :activity/title "Introduction to Polynomials" :activity/type {:db/id 17592186045464 :db/ident :activity.type/review} :db/id 17592186484811} {:db/id 17592186485641 :step/content {:db/id 17592186078853 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d49c7bc-c10c-5365-bdcf-53015828e98b" :answer/type {:db/id 17592186045498} :answer/value "3" :db/id 17592186075902} {:answer/id #uuid "d4ce4605-76fb-5b21-b5ed-7fb4b116e814" :answer/type {:db/id 17592186045498} :answer/value "1" :db/id 17592186075903} {:answer/id #uuid "f885dbbc-c1d7-5f2c-8a5d-4b57aad4d071" :answer/type {:db/id 17592186045498} :answer/value "-19" :db/id 17592186075904} {:answer/id #uuid "3bffe3f8-7623-5e82-8b00-0282c3071997" :answer/type {:db/id 17592186045498} :answer/value "-16" :db/id 17592186075905} {:answer/id #uuid "551c4823-47ff-5e04-8c66-bc8ba9ac8296" :answer/type {:db/id 17592186045498} :answer/value "-13" :db/id 17592186075906}] :answer-field/correct {:db/id 17592186075904} :answer-field/id #uuid "4215e270-50a3-50bb-b7ed-bf7f3eb3d7b6" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493} :db/id 17592186075901}] :question/difficulty {:db/id 17592186045485} :question/id #uuid "cb6fcbdf-91d2-5cfa-a995-0b092c5eba28" :question/math-academy-id "q-30334" :question/problem "Evaluate the polynomial $-2{x}^{3}-3$ at $x=2.$" :question/worked-solution "To evaluate, we substitute $x=2$ into the polynomial 