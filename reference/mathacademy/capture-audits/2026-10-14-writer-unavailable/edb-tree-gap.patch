+#[test]
+fn merge_first_leaf_inherits_sparse_parent_range() {
+    use crate::{Datom, Value, IndexOrder, t_to_tx};
+    use super::tree::{build_tree, merge_tree, TreeConfig, TreeMergeEdits};
+    let fact = |entity, t| Datom { entity, attribute: 100, value: Value::Ref(77),
+        tx: t_to_tx(t).unwrap(), source: 98, added: true };
+    let config = TreeConfig { max_leaf_datoms: 1, max_leaves_per_directory: 1,
+        ..Default::default() };
+    for order in [IndexOrder::Eavt, IndexOrder::Aevt, IndexOrder::Avet,
+                  IndexOrder::Vaet, IndexOrder::Saevt, IndexOrder::Savet] {
+        for history in [false, true] {
+            let mut input = vec![fact(10, 1), fact(20, 1)];
+            input.sort_by(|a, b| a.cmp_in(b, order));
+            let built = build_tree(order, history, input, &config).unwrap();
+            let edits = TreeMergeEdits {
+                removals: if history { vec![] } else { vec![fact(20, 1)] },
+                insertions: vec![fact(20, 2)], ..Default::default()
+            };
+            let merged = merge_tree(&built.descriptor, &built.nodes, &edits, &config)
+                .unwrap_or_else(|e| panic!("{order:?} history={history}: {e}"));
+            assert_eq!(merged.descriptor.count, if history { 3 } else { 2 });
+        }
+    }
+}
