#{[{:db/id #edb/ref 17592186354538 :knowledge-point/_questions [{:db/id #edb/ref 17592186115303 :knowledge-point/id #uuid "a227c7a8-977d-54b0-9409-d364da03656f" :knowledge-point/title "Computing the Mean of a Data Set From the Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19d54d1f-efb8-552f-ab3b-abbbe3b0f8a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23.6" :db/id #edb/ref 17592186351794} {:answer/id #uuid "2e2993ee-9bdd-5531-bd61-349cf661922e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26.4" :db/id #edb/ref 17592186351991} {:answer/id #uuid "56cb2b30-74c2-59e2-8165-0d814424a123" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25.7" :db/id #edb/ref 17592186352333} {:answer/id #uuid "873b25b6-3d91-5f71-aa9e-c71a735899af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26.9" :db/id #edb/ref 17592186352751} {:answer/id #uuid "a7e9a2e7-cbd5-5bb1-942a-2f9b29401f9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24.3" :db/id #edb/ref 17592186352993}] :answer-field/correct {:answer/id #uuid "56cb2b30-74c2-59e2-8165-0d814424a123" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25.7" :db/id #edb/ref 17592186352333} :answer-field/id #uuid "521666e1-0f9d-5046-b997-80486f7e0f9e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353959}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "81127073-3815-575d-a148-cb1ef2bb975d" :question/math-academy-id "q-86932" :question/problem "Given a data set with $23$ data points and ${\\sum }_{i=1}^{23}{x}_{i}=590,$ compute $\\overset{―}{x}.$ Round your answer to one decimal place." :question/worked-solution "If we have a data set that consists of the points ${x}_{1},{x}_{2},…,{x}_{n},$ then the mean is denoted by $\\overset{―}{x}$ and is given by the following formula:\n\n$$\n\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}\n$$\n\nSubstituting $n=23$ and ${\\sum }_{i=1}^{23}{x}_{i}=590,$ we get\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{23}\\cdot 590≈25.7,\\end{aligned}\n$$\n\nwhere we have rounded our answer to one decimal place."}] [{:db/id #edb/ref 17592186354570 :knowledge-point/_questions [{:db/id #edb/ref 17592186115361 :knowledge-point/id #uuid "b6b41a05-7b11-52b8-a407-af505dffaf10" :knowledge-point/title "Computing the Variance of a Data Set Using the Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b345208-118e-5652-b22b-098c78c034f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{27}{3}" :db/id #edb/ref 17592186351665} {:answer/id #uuid "43267825-1da1-549f-b40f-13640900b0c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186352185} {:answer/id #uuid "756d7bb4-ec1d-5b8d-9ec1-bdd7581a5796" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186352597} {:answer/id #uuid "a95b216b-5707-5c1c-9ebf-22afc3b7925d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{37}{3}" :db/id #edb/ref 17592186353003} {:answer/id #uuid "c3e627b0-c925-5cfa-9749-80dbb8d824eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{49}{3}" :db/id #edb/ref 17592186353260}] :answer-field/correct {:answer/id #uuid "a95b216b-5707-5c1c-9ebf-22afc3b7925d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{37}{3}" :db/id #edb/ref 17592186353003} :answer-field/id #uuid "725eaeaf-88ac-5d74-9ca0-28e3a580f020" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354029}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a33c9758-e856-52e3-9ca0-8b4d2b8f793f" :question/math-academy-id "q-87464" :question/problem "What is the variance of the following data set?\n\n$$\n-3,\\,1,\\,-5,\\,-5,\\,2,\\,-8\n$$" :question/worked-solution "If we have a data set that consists of the points ${x}_{1},{x}_{2},…,{x}_{n},$ then the variance of the data set is given by \n\n$$\n{\\sigma }^{2}=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})^{2},\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ is the mean of the data set.\n\nFirst, we need to compute the mean. There are $n=6$ points in our data set, so the mean is\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{6}\\cdot (-3+1-5-5+2-8) \\\\  & =\\frac{1}{6}\\cdot (-18) \\\\  & =-3.\\end{aligned}\n$$\n\nTherefore, the variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})^{2} \\\\  & =\\frac{1}{6}[(-3-(-3))^{2}+(1-(-3))^{2}+(-5-(-3))^{2}+(-5-(-3))^{2}+(2-(-3))^{2}+(-8-(-3))^{2}] \\\\  & =\\frac{1}{6}[0+16+4+4+25+25] \\\\  & =\\frac{74}{6} \\\\  & =\\frac{37}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186354579 :knowledge-point/_questions [{:db/id #edb/ref 17592186115363 :knowledge-point/id #uuid "d0040fc1-2134-5eaa-a3e8-6c7a457f75f5" :knowledge-point/title "Computing the Variance of a Data Set Using the Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d194127-5565-5ea6-9149-fb729c34c731" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186351826} {:answer/id #uuid "249d55e5-0b47-5cef-9a5d-7c2c9ce22b60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186351903} {:answer/id #uuid "60dc0e33-8bff-54f1-9044-88c8aa366515" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186352429} {:answer/id #uuid "618c0075-6c89-5ce7-8205-c22c83cbce81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186352439} {:answer/id #uuid "b0c1e82b-4a36-567b-b964-7eae626ffb2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186353080}] :answer-field/correct {:answer/id #uuid "1d194127-5565-5ea6-9149-fb729c34c731" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186351826} :answer-field/id #uuid "e885e1fb-3ce2-57f1-87d2-e78acd0124d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354211}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6e1e3be6-fb14-565f-8535-3adfd3c2eec9" :question/math-academy-id "q-87606" :question/problem "What is the variance of the following data set?\n\n$$\n1,\\,5,\\,1,\\,2,\\,3,\\,6,\\,1,\\,2,\\,6\n$$" :question/worked-solution "If we have a data set that consists of the points ${x}_{1},{x}_{2},…,{x}_{n},$ then the variance can be computed as\n\n$$\n{\\sigma }^{2}=\\overset{―}{{x}^{2}}-(\\overset{―}{x})^{2},\n$$\n\nwhere $\\overset{―}{x}$ is the mean of the data set and $\\overset{―}{{x}^{2}}$ is the mean of the squares of the points in the data set.\n\nFirst, let's compute $\\overset{―}{x}.$ There are $n=9$ points in our data set, so the mean is\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{9}\\cdot (1+5+1+2+3+6+1+2+6) \\\\  & =\\frac{1}{9}\\cdot 27 \\\\  & =3.\\end{aligned}\n$$\n\nNow, let's compute $\\overset{―}{{x}^{2}}.$ Computing the mean of the squares of the points in the data set, we get\n\n$$\n\\begin{aligned}\\overset{―}{{x}^{2}} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}^{2} \\\\  & =\\frac{1}{9}\\cdot ({1}^{2}+{5}^{2}+{1}^{2}+{2}^{2}+{3}^{2}+{6}^{2}+{1}^{2}+{2}^{2}+{6}^{2}) \\\\  & =\\frac{1}{9}\\cdot (1+25+1+4+9+36+1+4+36) \\\\  & =\\frac{1}{9}\\cdot 117 \\\\  & =13.\\end{aligned}\n$$\n\nSo, the variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\overset{―}{{x}^{2}}-(\\overset{―}{x})^{2} \\\\  & =13-{(3)}^{2} \\\\  & =13-9 \\\\  & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186354582 :knowledge-point/_questions [{:db/id #edb/ref 17592186115364 :knowledge-point/id #uuid "5a72dae6-2bbf-5e59-b71d-8ee57f589753" :knowledge-point/title "Computing the Standard Deviation of a Data Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "427e4e36-8e8f-518b-8674-8478d60112ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{34}{7}}" :db/id #edb/ref 17592186352177} {:answer/id #uuid "b0adc768-befd-5424-a027-a014f92b2b70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{31}{7}}" :db/id #edb/ref 17592186353078} {:answer/id #uuid "d7ae299a-102c-532a-a8e9-1db85591ce85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{97}{7}}" :db/id #edb/ref 17592186353439} {:answer/id #uuid "f38cadee-21b7-58cf-9f69-13b52ed1e1a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{55}{7}}" :db/id #edb/ref 17592186353697} {:answer/id #uuid "f4963773-d74e-538c-9779-c3ce7fcedcde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{87}{7}}" :db/id #edb/ref 17592186353705}] :answer-field/correct {:answer/id #uuid "427e4e36-8e8f-518b-8674-8478d60112ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{34}{7}}" :db/id #edb/ref 17592186352177} :answer-field/id #uuid "a48d3bea-1363-5f06-866b-d0c35b8f69dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354103}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c5f5a511-45ef-5fe1-b914-88ccd3d31b71" :question/math-academy-id "q-87612" :question/problem "What is the standard deviation of the following data set?\n\n$$\n7,\\,3,\\,3,\\,5,\\,1,\\,0,\\,2\n$$" :question/worked-solution "The standard deviation of a data set ${x}_{1},{x}_{2},…,{x}_{n}$ is the square root of the variance:\n\n$$\n\\sigma =\\sqrt{{\\sigma }^{2}}=\\sqrt{\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})^{2}}=\\sqrt{\\,\\,\\,\\overset{―}{{x}^{2}}-{(\\overset{―}{x})}^{2}}\n$$\n\nFirst, let's compute $\\overset{―}{x}.$ There are $n=7$ points in our data set, so the mean is\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{7}\\cdot (7+3+3+5+1+0+2) \\\\  & =\\frac{1}{7}\\cdot 21 \\\\  & =3.\\end{aligned}\n$$\n\nNow, let's compute $\\overset{―}{{x}^{2}}.$ Computing the mean of the squares of the points in the data set, we get\n\n$$\n\\begin{aligned}\\overset{―}{{x}^{2}} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}^{2} \\\\  & =\\frac{1}{7}\\cdot ({7}^{2}+{3}^{2}+{3}^{2}+{5}^{2}+{1}^{2}+{0}^{2}+{2}^{2}) \\\\  & =\\frac{1}{7}\\cdot (49+9+9+25+1+0+4) \\\\  & =\\frac{97}{7}.\\end{aligned}\n$$\n\nSo, the variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\overset{―}{{x}^{2}}-(\\overset{―}{x})^{2} \\\\  & =\\frac{97}{7}-{(3)}^{2} \\\\  & =\\frac{97}{7}-9 \\\\  & =\\frac{97-63}{7} \\\\  & =\\frac{34}{7}.\\end{aligned}\n$$\n\nFinally, the standard deviation is\n\n$$\n\\sigma =\\sqrt{{\\sigma }^{2}}=\\sqrt{\\frac{34}{7}}.\n$$"}] [{:db/id #edb/ref 17592186354583 :knowledge-point/_questions [{:db/id #edb/ref 17592186115364 :knowledge-point/id #uuid "5a72dae6-2bbf-5e59-b71d-8ee57f589753" :knowledge-point/title "Computing the Standard Deviation of a Data Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1715cab9-06ff-5775-8221-04bf4db52149" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{44}{5}}" :db/id #edb/ref 17592186351771} {:answer/id #uuid "2286aa66-4634-5f2a-86f3-a4cdcce1fc98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{124}{5}}" :db/id #edb/ref 17592186351878} {:answer/id #uuid "44f1270a-9110-58f6-8fa9-8ef77b30ed2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{48}{5}}" :db/id #edb/ref 17592186352202} {:answer/id #uuid "56928ff8-cc5a-56f5-92ac-4b2a6100b8b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{41}{5}}" :db/id #edb/ref 17592186352330} {:answer/id #uuid "ddb6a08a-013d-586d-a88a-e2d2b3e0595d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{37}{5}}" :db/id #edb/ref 17592186353494}] :answer-field/correct {:answer/id #uuid "1715cab9-06ff-5775-8221-04bf4db52149" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{44}{5}}" :db/id #edb/ref 17592186351771} :answer-field/id #uuid "c7a93a33-8e48-5ada-8662-5f5d2efbde64" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354160}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ab0de973-6daf-5f45-9069-960a74229aa4" :question/math-academy-id "q-87613" :question/problem "What is the standard deviation of the following data set?\n\n$$\n1,\\,1,\\,5,\\,4,\\,9\n$$" :question/worked-solution "The standard deviation of a data set ${x}_{1},{x}_{2},…,{x}_{n}$ is the square root of the variance:\n\n$$\n\\sigma =\\sqrt{{\\sigma }^{2}}=\\sqrt{\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})^{2}}=\\sqrt{\\,\\,\\,\\overset{―}{{x}^{2}}-{(\\overset{―}{x})}^{2}}\n$$\n\nFirst, let's compute $\\overset{―}{x}.$ There are $n=5$ points in our data set, so the mean is\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{5}\\cdot (1+1+5+4+9) \\\\  & =\\frac{1}{5}\\cdot 20 \\\\  & =4.\\end{aligned}\n$$\n\nNow, let's compute $\\overset{―}{{x}^{2}}.$ Computing the mean of the squares of the points in the data set, we get\n\n$$\n\\begin{aligned}\\overset{―}{{x}^{2}} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}^{2} \\\\  & =\\frac{1}{5}\\cdot ({1}^{2}+{1}^{2}+{5}^{2}+{4}^{2}+{9}^{2}) \\\\  & =\\frac{1}{5}\\cdot (1+1+25+16+81) \\\\  & =\\frac{124}{5}.\\end{aligned}\n$$\n\nSo, the variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\overset{―}{{x}^{2}}-(\\overset{―}{x})^{2} \\\\  & =\\frac{124}{5}-{(4)}^{2} \\\\  & =\\frac{124}{5}-16 \\\\  & =\\frac{124-80}{5} \\\\  & =\\frac{44}{5}.\\end{aligned}\n$$\n\nFinally, the standard deviation is\n\n$$\n\\sigma =\\sqrt{{\\sigma }^{2}}=\\sqrt{\\frac{44}{5}}.\n$$"}] [{:db/id #edb/ref 17592186354594 :knowledge-point/_questions [{:db/id #edb/ref 17592186105871 :knowledge-point/id #uuid "6445834c-7788-5427-a72c-30b06cc8e6ab" :knowledge-point/title "Calculating the Area of an Isosceles Right Triangle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0663bea7-12f5-5928-84d7-bc207c70bfaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186351623} {:answer/id #uuid "3101c5fb-53ba-5942-ad43-1ae35079f738" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186352018} {:answer/id #uuid "7e914068-1f39-55f3-a988-748244647a92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "200" :db/id #edb/ref 17592186352677} {:answer/id #uuid "8150fcea-b946-540d-b0fd-6ae56c257637" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186352692} {:answer/id #uuid "aa336a88-ddef-5077-bcae-4e7bf818c424" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186353009}] :answer-field/correct {:answer/id #uuid "3101c5fb-53ba-5942-ad43-1ae35079f738" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186352018} :answer-field/id #uuid "69982ee7-0741-5c08-835f-b26951ee678f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354013}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "298d5629-725b-5aa5-9d76-4ed61398d66b" :question/math-academy-id "q-87802" :question/problem "![](images/37/3756b00cce29aad77b7a0b1ebb09f43cb89a602f8462edce89e8ba6346cb7fab.png)\n\nWhat is the area of the right triangle $ABC$ shown above?" :question/worked-solution "Since $m∠A=m∠B$, we have an isosceles triangle, where $AC=BC.$\n\nHence, the area of the triangle is \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}AC\\cdot BC \\\\  & =\\frac{1}{2}\\cdot {10}^{2} \\\\  & =\\frac{1}{2}\\cdot 100 \\\\  & =50.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186404426 :knowledge-point/_questions [{:db/id #edb/ref 17592186105872 :knowledge-point/id #uuid "a7656d23-06c9-5d22-b62a-3636bca66ab6" :knowledge-point/title "Finding the Base or the Height of a Triangle Given Its Area"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ef35ba9-a1a6-5901-a68b-21603e2051d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36\\,{cm}^{2}" :db/id #edb/ref 17592186404428} {:answer/id #uuid "fdf3609b-ef5e-5b0b-9c1a-f2b156f94734" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30\\,{cm}^{2}" :db/id #edb/ref 17592186404429} {:answer/id #uuid "f5f39be9-b1e0-5587-868d-9f77d0afc794" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "72\\,{cm}^{2}" :db/id #edb/ref 17592186404430} {:answer/id #uuid "5d9dd512-8f07-5391-be34-d4707734b6d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35\\,{cm}^{2}" :db/id #edb/ref 17592186404431} {:answer/id #uuid "7c69f1fa-94c7-5dbc-8f48-c65d49727acf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60\\,{cm}^{2}" :db/id #edb/ref 17592186404432}] :answer-field/correct {:answer/id #uuid "fdf3609b-ef5e-5b0b-9c1a-f2b156f94734" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30\\,{cm}^{2}" :db/id #edb/ref 17592186404429} :answer-field/id #uuid "9d266bcc-fa01-524b-89f8-39a6f9df7aea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404427}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7bcc27a5-b987-5302-94f2-988d56293740" :question/math-academy-id "q-87910" :question/problem "![](images/4c/4c19425664f79df1f46863f59268ebd27e20defce41b21e877926bbcadc9e5c3.png)\n\nConsider the triangles $△ABC$ and $△CDE$ shown above. If the area of $△CDE$ is $42{\\text{ cm}}^{2}$, find the area of $△ABC.$\n\n(Figure not drawn to scale)" :question/worked-solution "Let's consider $△CDE.$ We can see that $\\overset{―}{CD}$ is the height corresponding to the base $\\overset{―}{DE}$ and that $DE=7\\text{ cm}.$ \n\nSince the area of $△CDE$ is $42{\\text{ cm}}^{2},$ we get\n\n$$\n\\begin{aligned}A & =\\frac{b\\cdot h}{2} \\\\ 42 & =\\frac{7\\cdot CD}{2} \\\\ 7CD & =84 \\\\ CD & =12\\text{ cm}.\\end{aligned}\n$$\n\nNow, notice that $\\overset{―}{CD}$ is also the height of $△ABC$ corresponding to the base $\\overset{―}{AB}.$\n\n![](images/00/0014faf05eaf15d70f885802e5b820b0c72d42a96f400442f827ed229de8b240.png)\n\nTherefore, we find the area of $△ABC$ as follows:\n\n$$\n\\begin{aligned}A & =\\frac{b\\cdot h}{2} \\\\  & =\\frac{AB\\cdot CD}{2} \\\\  & =\\frac{5\\cdot 12}{2} \\\\  & =30{\\text{ cm}}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186394779 :knowledge-point/_questions [{:db/id #edb/ref 17592186157437 :knowledge-point/id #uuid "3758cf02-ba4b-539a-bc61-8c2030ff6f6f" :knowledge-point/title "Solving an Exponential Equation by Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef56dae1-235e-58a4-9d49-dac58019c11c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186394781} {:answer/id #uuid "5d542604-cc75-5fe8-a314-152f5e0d0baf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186394782} {:answer/id #uuid "98750137-8ecd-58a9-830f-28a32bdedfa5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186394783} {:answer/id #uuid "d7e12eec-8e62-581b-b20f-14c8b66d8602" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186394784} {:answer/id #uuid "57fa678f-41a4-5b0a-9cfb-0034cbdf2533" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186394785}] :answer-field/correct {:answer/id #uuid "57fa678f-41a4-5b0a-9cfb-0034cbdf2533" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186394785} :answer-field/id #uuid "e16451bc-a0a9-548c-ba07-f9abe1416b11" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394780}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d3d7afbe-c052-55bc-910e-6663c48abfcd" :question/math-academy-id "q-88459" :question/problem "What is the product of solutions of the equation $2{x}^{2}\\cdot {2}^{x-1}+12x\\cdot {2}^{x-1}+10\\cdot {2}^{x-1}=0?$" :question/worked-solution "First, we factor the equation:\n\n$$\n\\begin{aligned}2{x}^{2}\\cdot {2}^{x-1}+12x\\cdot {2}^{x-1}+10\\cdot {2}^{x-1} & =0 \\\\ (2{x}^{2}+12x+10){2}^{x-1} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n2{x}^{2}+12x+10=0\\,\\text{and}\\,{2}^{x-1}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation $2{x}^{2}+12x+10=0$ can be factored as\n\n$$\n2(x+1)(x+5)=0,\n$$\n\nwhich leads to the solutions $x=-5,-1.$\n\n- The equation ${2}^{x-1}=0$ has no solutions because ${2}^{x-1}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=-5,-1,$ and their product is $(-5)\\cdot (-1)=5.$"}] [{:db/id #edb/ref 17592186357366 :knowledge-point/_questions [{:db/id #edb/ref 17592186083317 :knowledge-point/id #uuid "c07eb336-1ac8-5633-abaf-fcfca4c12bd1" :knowledge-point/title "Using The Law of Total Probability Stated in Terms of Intersections"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ca39c86-c237-57c2-8d8c-dda21442afec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{7}" :db/id #edb/ref 17592186355347} {:answer/id #uuid "8ce90c57-4877-5774-9681-0f9aa958e585" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186355909} {:answer/id #uuid "9280f538-12fe-5a96-8f3c-4ff956dd093f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{7}" :db/id #edb/ref 17592186355957} {:answer/id #uuid "9cb85bb0-6fa4-59b2-ad41-5c5cd393e251" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186356060} {:answer/id #uuid "d5bb5ddb-c925-56df-85f5-227622e09a3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186356538}] :answer-field/correct {:answer/id #uuid "4ca39c86-c237-57c2-8d8c-dda21442afec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{7}" :db/id #edb/ref 17592186355347} :answer-field/id #uuid "26ad4582-1eee-5ebd-8785-6a3cf5b49efc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186356982}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "db570458-831d-5df7-87a7-8b916c4f12ed" :question/math-academy-id "q-88918" :question/problem "A pet center registered $34$ dogs and $29$ cats on a particular day. Of the dogs registered that day, $12$ were vaccinated. Of the cats registered that day, $15$ were vaccinated. What is the probability that a randomly selected pet registered that day was vaccinated?" :question/worked-solution "Let $V$ be the event that the chosen pet was vaccinated, and let $D$ be the event that the pet is a dog. Then ${D}^{′}$ is the event that the pet is a cat.\n\nTo calculate the probability that a randomly selected pet was vaccinated, we can use the law of total probability:\n\n$$\nP(V)=P(V\\cap D)+P(V\\cap {D}^{′})\n$$\n\nTo calculate $P(V\\cap D),$ we take the number of dogs who visited the pet center and were vaccinated $(12)$ and divide by the total number of pets $(34+29=63).$ So, we have\n\n$$\nP(V\\cap D)=\\frac{12}{63}.\n$$\n\nSimilarly, to calculate $P(V\\cap {D}^{′}),$ we take the number of cats who visited the pet center and were vaccinated $(15)$ and divide by the total number of pets $(63).$ So, we have\n\n$$\nP(V\\cap {D}^{′})=\\frac{15}{63}.\n$$\n\nFinally, substituting the above information into the law of total probability, the probability that a randomly selected pet was vaccinated is\n\n$$\n\\begin{aligned}P(V) & =P(V\\cap D)+P(V\\cap {D}^{′}) \\\\  & =\\frac{12}{63}+\\frac{15}{63} \\\\  & =\\frac{27}{63} \\\\  & =\\frac{3}{7}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186357370 :knowledge-point/_questions [{:db/id #edb/ref 17592186083316 :knowledge-point/id #uuid "f0f7055d-9f45-5115-97f4-35d0c56008e0" :knowledge-point/title "Using The Law of Total Probability Stated in Terms of Conditional Probability"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "177abed1-3340-52f4-b1b1-3e9d3c91a06c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{10}" :db/id #edb/ref 17592186354875} {:answer/id #uuid "9ce948d9-38e5-5268-a841-288391c7dc4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186356063} {:answer/id #uuid "a0d2bdc3-4057-5d74-97aa-8279dd26fa33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186356091} {:answer/id #uuid "b51115cb-95b0-5606-8be1-1cd205702798" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186356257} {:answer/id #uuid "c42cb318-2ebc-50d6-8303-ec19ea35ed9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186356377}] :answer-field/correct {:answer/id #uuid "a0d2bdc3-4057-5d74-97aa-8279dd26fa33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186356091} :answer-field/id #uuid "73d73bcd-8256-5970-b6ac-230469df04c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357121}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e058ddbe-425b-5426-85a0-6f69cb521a44" :question/math-academy-id "q-89027" :question/problem "John keeps his marbles in two boxes, box $A$ and box $B.$ Of the marbles in his collection, $\\frac{3}{4}$ of them are in box $A,$ and $\\frac{1}{4}$ of them are in box $B.$ If $\\frac{1}{3}$ of the marbles in box $A$ are red and $\\frac{3}{5}$ of the marbles in box $B$ are red, what is the probability that a randomly selected marble in John's collection is red?" :question/worked-solution "Let $R$ be the event that the chosen marble is red, and let $A$ be the event that the marble was selected from box $A.$ Then, ${A}^{′}$ is the event that the marble was selected from box $B.$\n\nTo calculate the probability that a randomly selected marble is red, we can use the law of total probability:\n\n$$\nP(R)=P(R|A)P(A)+P(R|{A}^{′})P({A}^{′})\n$$\n\nLet's go through the problem statement and translate each bit of information into mathematical notation.\n\n- Since $\\frac{3}{4}$ of the marbles are in box $A$ and $\\frac{1}{4}$ are in box $B,$ we have\n\n$$\nP(A)=\\frac{3}{4},\\,P({A}^{′})=\\frac{1}{4}.\n$$\n\n- Since $\\frac{1}{3}$ of the marbles in box $A$ are red and $\\frac{3}{5}$ of the marbles in box $B$ are red, we have\n\n$$\nP(R|A)=\\frac{1}{3},\\,P(R|{A}^{′})=\\frac{3}{5}.\n$$\n\nSubstituting the above information into the law of total probability, the probability that a randomly selected marble is red is\n\n$$\n\\begin{aligned}P(R) & =P(R|A)P(A)+P(R|{A}^{′})P({A}^{′}) \\\\  & =(\\frac{1}{3})(\\frac{3}{4})+(\\frac{3}{5})(\\frac{1}{4}) \\\\  & =\\frac{1}{4}+\\frac{3}{20} \\\\  & =\\frac{5+3}{20} \\\\  & =\\frac{2}{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186357373 :knowledge-point/_questions [{:db/id #edb/ref 17592186083316 :knowledge-point/id #uuid "f0f7055d-9f45-5115-97f4-35d0c56008e0" :knowledge-point/title "Using The Law of Total Probability Stated in Terms of Conditional Probability"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2566a906-660a-5539-8fd2-506a252beb2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.637" :db/id #edb/ref 17592186354977} {:answer/id #uuid "357ee747-8ccf-5b3a-ad24-9fe9d1620072" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.579" :db/id #edb/ref 17592186355146} {:answer/id #uuid "494958d9-9794-5e66-b1da-63cf9ff33c95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.623" :db/id #edb/ref 17592186355311} {:answer/id #uuid "654869f5-50fd-5413-ada4-6ad56a42a98b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.518" :db/id #edb/ref 17592186355563} {:answer/id #uuid "e463b964-6231-5f45-aec0-6341c1449646" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.535" :db/id #edb/ref 17592186356661}] :answer-field/correct {:answer/id #uuid "357ee747-8ccf-5b3a-ad24-9fe9d1620072" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.579" :db/id #edb/ref 17592186355146} :answer-field/id #uuid "9f0e9367-128c-5d29-9e01-6dd7b04cb3fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357202}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cc55985a-a406-5bf4-8dc7-f8f925865628" :question/math-academy-id "q-89040" :question/problem "In a gas station, $42%$ of the clients buy regular gasoline while $58%$ buy premium gasoline. If $62%$ of the clients that buy regular gasoline paid with a credit card while $55%$ of the clients that buy premium gasoline paid with a credit card, what is the probability that a randomly selected client paid with a credit card? Round your answer to $3$ decimal places." :question/worked-solution "Let $C$ be the event that the chosen person paid with a credit card, and let $R$ be the event that the person bought regular gasoline. Then ${R}^{′}$ is the event that the person bought premium gasoline.\n\nTo calculate the probability that a randomly selected person paid with a credit card, we can use the law of total probability:\n\n$$\nP(C)=P(C|R)P(R)+P(C|{R}^{′})P({R}^{′})\n$$\n\nLet's go through the problem statement and translate each bit of information into mathematical notation.\n\n- Since $42%$ of the clients buy regular gasoline while $58%$ buy premium gasoline, we have\n\n$$\nP(R)=0.42,\\,P({R}^{′})=0.58.\n$$\n\n- Since $62%$ of the clients that buy regular gasoline paid with a credit card while $55%$ of the clients that buy premium gasoline paid with a credit card, we have\n\n$$\nP(C|R)=0.62,\\,P(C|{R}^{′})=0.55.\n$$\n\nSubstituting the above information into the law of total probability, the probability that a randomly selected client paid with a credit card is\n\n$$\n\\begin{aligned}P(C) & =P(C|R)P(R)+P(C|{R}^{′})P({R}^{′}) \\\\  & =(0.62)(0.42)+(0.55)(0.58) \\\\  & ≈0.579\\end{aligned}\n$$\n\nrounded to three decimal places."}] [{:db/id #edb/ref 17592186357377 :knowledge-point/_questions [{:db/id #edb/ref 17592186083318 :knowledge-point/id #uuid "5000a4b1-c0cb-59f3-9d45-6287fa8ac9b6" :knowledge-point/title "Solving for an Unknown Using the Law of Total Probability"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7acda339-8e7a-5d97-8d07-87d56f55cf59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.38" :db/id #edb/ref 17592186355742} {:answer/id #uuid "9ac1d3b7-75a1-5c1c-8ff2-b5129406317f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.44" :db/id #edb/ref 17592186356039} {:answer/id #uuid "9dd7d09b-b5f0-5551-884a-1cbb0b928521" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.48" :db/id #edb/ref 17592186356071} {:answer/id #uuid "c42b2c84-13f4-5082-b461-631d5e9b5fcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.40" :db/id #edb/ref 17592186356376} {:answer/id #uuid "e20a7c7c-2570-5ddb-b5bf-ae180319b6d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.35" :db/id #edb/ref 17592186356641}] :answer-field/correct {:answer/id #uuid "c42b2c84-13f4-5082-b461-631d5e9b5fcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.40" :db/id #edb/ref 17592186356376} :answer-field/id #uuid "20d03e9b-4d9b-5f17-8196-2161f649cd18" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186356971}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e146c7f5-1f60-52aa-a388-c884e771fa07" :question/math-academy-id "q-89044" :question/problem "Jacob has two email accounts, account $A$ and account $B.$ In account $A$ he receives $40%$ of his emails and he receives the remaining $60%$ in account $B.$ Approximately $30%$ of the emails received in account $A$ are spam and $36%$ of the emails received in both accounts are spam. What is the probability that a randomly selected email from account $B$ is spam? Round your answer to $2$ decimal places." :question/worked-solution "Let $S$ be the event that the chosen email is spam, and let $A$ be the event that the email selected is from account $A.$ Then ${A}^{′}$ is the event that the email selected is from account $B.$\n\nTo calculate the probability that a randomly selected email is spam, we can use the law of total probability:\n\n$$\nP(S)=P(S|A)P(A)+P(S|{A}^{′})P({A}^{′})\n$$\n\nLet's go through the problem statement and translate each bit of information into mathematical notation.\n\n- Since $40%$ of the emails are received in account $A$ and the remaining $60%$ in account $B,$ we have\n\n$$\nP(A)=0.40,\\,P({A}^{′})=0.60.\n$$\n\n- Since $30%$ of the emails received in account $A$ are spam, we have \n\n$$\nP(S|A)=0.30.\n$$\n\n- Since $36%$ of the emails received in both accounts are spam, we have \n\n$$\nP(S)=0.36.\n$$\n\nSubstituting the above information into the law of total probability and solving for $P(S|{A}^{′})$, we get\n\n$$\n\\begin{aligned}P(S) & =P(S|A)P(A)+P(S|{A}^{′})P({A}^{′}) \\\\ 0.36 & =(0.30)(0.40)+P(S|{A}^{′})(0.60) \\\\ 0.36 & =0.12+0.6P(S|{A}^{′}) \\\\ 0.6P(S|{A}^{′}) & =0.24 \\\\ P(S|{A}^{′}) & =0.40.\\end{aligned}\n$$\n\nTherefore, the probability that a randomly selected email from account $B$ is spam is $0.40.$"}] [{:db/id #edb/ref 17592186357379 :knowledge-point/_questions [{:db/id #edb/ref 17592186083318 :knowledge-point/id #uuid "5000a4b1-c0cb-59f3-9d45-6287fa8ac9b6" :knowledge-point/title "Solving for an Unknown Using the Law of Total Probability"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13ec3618-ccd9-584a-a671-2d5604a02992" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186354840} {:answer/id #uuid "35323479-c980-5e35-8a43-4987fdb1d440" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186355140} {:answer/id #uuid "7ac8d006-37eb-5ce9-b169-71af759ce8a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186355741} {:answer/id #uuid "836c2510-2c98-5336-8916-b05ea6092d1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186355823} {:answer/id #uuid "9b5dcc0b-b087-57d3-a0dd-557c5d8b3697" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186356042}] :answer-field/correct {:answer/id #uuid "9b5dcc0b-b087-57d3-a0dd-557c5d8b3697" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186356042} :answer-field/id #uuid "7424e924-2e89-51e9-90d0-aa5b63cbb997" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357123}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6a852c2d-1240-54fc-a444-5143c0301a19" :question/math-academy-id "q-89051" :question/problem "Daniel has a desk with two drawers, drawer $A$ and drawer $B.$ Of the total amount of pens that he has, $\\frac{4}{5}$ of them are in drawer $A,$ and $\\frac{1}{5}$ are in drawer $B.$ Also, $\\frac{3}{4}$ of the pens in drawer $A$ are blue, and Daniel knows that $\\frac{2}{3}$ of the pens in both drawers are blue. What is the probability that a randomly selected pen from drawer $B$ is blue?" :question/worked-solution "Let $U$ be the event that the chosen pen is blue, and let $A$ be the event that the pen was selected from drawer $A.$ Then ${A}^{′}$ is the event that the pen was selected from drawer $B.$\n\nTo calculate the probability that a randomly selected pen is blue, we can use the law of total probability:\n\n$$\nP(U)=P(U|A)P(A)+P(U|{A}^{′})P({A}^{′})\n$$\n\nLet's go through the problem statement and translate each bit of information into mathematical notation.\n\n- Since $\\frac{4}{5}$ of the pens are in drawer $A$ and $\\frac{1}{5}$ are in drawer $B,$ we have\n\n$$\nP(A)=\\frac{4}{5},\\,P({A}^{′})=\\frac{1}{5}.\n$$\n\n- Since $\\frac{3}{4}$ of the pens in drawer $A$ are blue, we have\n\n$$\nP(U|A)=\\frac{3}{4}.\n$$\n\n- Since $\\frac{2}{3}$ of the pens on the desk drawers are blue, we have\n\n$$\nP(U)=\\frac{2}{3}.\n$$\n\nSubstituting the above information into the law of total probability and solving for $P(U|{D}^{′})$, we get\n\n$$\n\\begin{aligned}P(U) & =P(U|A)P(A)+P(U|{A}^{′})P({A}^{′}) \\\\ \\frac{2}{3} & =(\\frac{3}{4})(\\frac{4}{5})+P(U|{A}^{′})(\\frac{1}{5}) \\\\ \\frac{2}{3} & =\\frac{3}{5}+\\frac{1}{5}P(U|{A}^{′}) \\\\ \\frac{1}{5}P(U|{A}^{′}) & =\\frac{10-9}{15} \\\\ P(U|{A}^{′}) & =\\frac{1}{3}.\\end{aligned}\n$$\n\nTherefore, the probability that a randomly selected pen from drawer $B$ is blue is $\\frac{1}{3}.$"}] [{:db/id #edb/ref 17592186172609 :knowledge-point/_questions [{:db/id #edb/ref 17592186172023 :knowledge-point/id #uuid "3e6159dd-c12e-5882-be17-815b4cc9ae52" :knowledge-point/title "Finding the Roots of a Transformed Radical Function With an Odd Index"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "720ce82d-536f-52e4-a924-9dc9994eace0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{12}{5}" :db/id #edb/ref 17592186355669} {:answer/id #uuid "9c357947-0335-531e-b792-b57594efd6eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2" :db/id #edb/ref 17592186356049} {:answer/id #uuid "a14eace9-3890-5be9-b73b-56227bff4efd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=3" :db/id #edb/ref 17592186356096} {:answer/id #uuid "a60dca9c-200d-526d-95e8-ae5ecfbe0621" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{12}{5}" :db/id #edb/ref 17592186356135} {:answer/id #uuid "d317e9da-0cf9-523f-af7e-fdda914c3077" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function has no roots" :db/id #edb/ref 17592186356506}] :answer-field/correct {:answer/id #uuid "a14eace9-3890-5be9-b73b-56227bff4efd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=3" :db/id #edb/ref 17592186356096} :answer-field/id #uuid "7a0524cb-a296-51c4-96c8-ba5fc5980ac8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357132}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1da47db3-4817-571a-b409-df8d62fa2bb2" :question/math-academy-id "q-92875" :question/problem "Find the root of $f(x)=\\sqrt[3]{5x+12}-3.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n\\sqrt[3]{5x+12}-3=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\\sqrt[3]{5x+12}-3 & =0 \\\\ \\sqrt[3]{5x+12} & =3 \\\\ (\\sqrt[3]{5x+12})^{3} & ={3}^{3} \\\\ 5x+12 & =27 \\\\ 5x & =15 \\\\ x & =3\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=3.$"}] [{:db/id #edb/ref 17592186357532 :knowledge-point/_questions [{:db/id #edb/ref 17592186115205 :knowledge-point/id #uuid "e7df2ec3-6138-5b84-864b-a856c28b9747" :knowledge-point/title "Finding the Y-Intercept of a Transformed Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "110202e8-093f-58a8-9e0d-f6d0462fe4fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2e" :db/id #edb/ref 17592186354817} {:answer/id #uuid "4ec7982b-e6e2-5127-9750-dd495e4fc60a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5e+3" :db/id #edb/ref 17592186355367} {:answer/id #uuid "6b5cd5d7-65b0-52b7-a3d8-f1ee2974f09d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186355615} {:answer/id #uuid "6b8dd3e6-8366-51e5-8487-6e2a2ed44084" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There is no $y$-intercept" :db/id #edb/ref 17592186355616} {:answer/id #uuid "bd971419-1d83-5381-8060-ebd02a942d89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186356325}] :answer-field/correct {:answer/id #uuid "bd971419-1d83-5381-8060-ebd02a942d89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186356325} :answer-field/id #uuid "388f326d-f720-5ae1-b8d8-e7be69c7f1e5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357012}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ab1d8b5d-ee01-5c7e-86ea-f76938391b95" :question/math-academy-id "q-92930" :question/problem "What is the $y$-intercept of $y=-5{e}^{-{x}^{3}}+3?$" :question/worked-solution "To find the $y$-intercept, we substitute $x=0$ into the equation:\n\n$$\n\\begin{aligned}y & =-5{e}^{-(0)^{3}}+3 \\\\  & =-5{e}^{0}+3 \\\\  & =-5(1)+3 \\\\  & =-2\\end{aligned}\n$$\n\nTherefore, the $y$-intercept is $-2.$"}] [{:db/id #edb/ref 17592186357535 :knowledge-point/_questions [{:db/id #edb/ref 17592186115204 :knowledge-point/id #uuid "3c2518d5-0fde-5dfc-aa07-f1bdd3c1585a" :knowledge-point/title "Finding the End-Behavior of a Transformed Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3346b133-465c-5f7c-8f6e-ed203cfa9c21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186355115} {:answer/id #uuid "6e902916-33fe-5cad-9fa1-d693583d5c07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186355642} {:answer/id #uuid "7016e321-e75a-5e1d-9c03-93b9317abb94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186355653} {:answer/id #uuid "8ef13b5a-fed1-5020-9287-b841ede6880e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186355925} {:answer/id #uuid "e3296fe7-7c8e-558c-bc20-fd9a8725aecf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186356652}] :answer-field/correct {:answer/id #uuid "6e902916-33fe-5cad-9fa1-d693583d5c07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186355642} :answer-field/id #uuid "cd144ebe-3889-52dd-aeed-40781f7c5ac5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357289}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e35f675f-b059-5f5e-9a19-8ac6f6c3e6e7" :question/math-academy-id "q-92963" :question/problem "Suppose that $f(x)={(\\frac{1}{3})}^{2x-3}+2.$ Given that $f(x)\\to a$ as $x\\to \\infty ,$ then $a=$" :question/worked-solution "Let's plot the graph of $y=f(x):$\n\n![](images/86/8646efab1e707e57bd8ff93b5f3f7b1336ae23588abf2d423a45bbcf702f86ab.png)\n\nSince the function approaches the line $y=2$ as $x\\to \\infty ,$ we conclude that\n\n$$\nf(x)\\to 2\\,\\text{as}\\,x\\to \\infty .\n$$\n\nTherefore, $a=2.$"}] [{:db/id #edb/ref 17592186357537 :knowledge-point/_questions [{:db/id #edb/ref 17592186115204 :knowledge-point/id #uuid "3c2518d5-0fde-5dfc-aa07-f1bdd3c1585a" :knowledge-point/title "Finding the End-Behavior of a Transformed Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42ba6113-d9e6-554c-a5ab-303df960703d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-5" :db/id #edb/ref 17592186355256} {:answer/id #uuid "59222bb1-9b57-550e-b74f-18960c6bcc76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2" :db/id #edb/ref 17592186355454} {:answer/id #uuid "b9602130-4235-5679-81e3-ffa15cdfc320" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{5}" :db/id #edb/ref 17592186356