"127ab74a-78a9-50ff-b775-392162c822af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "132" :db/id #edb/ref 17592186253831} {:answer/id #uuid "4140e843-380b-520e-9639-e1b7bc237667" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "239\\,500\\,800" :db/id #edb/ref 17592186254226} {:answer/id #uuid "a727dcc2-5949-5f0f-a458-9c12220bec19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "66" :db/id #edb/ref 17592186255147} {:answer/id #uuid "be060741-8b48-5973-a63b-7e1138fc9f36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,257\\,600" :db/id #edb/ref 17592186255366} {:answer/id #uuid "cb1fdb78-68f8-5ff0-b763-90f79c412945" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,628\\,800" :db/id #edb/ref 17592186255475}] :answer-field/correct {:answer/id #uuid "a727dcc2-5949-5f0f-a458-9c12220bec19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "66" :db/id #edb/ref 17592186255147} :answer-field/id #uuid "d3fda8d8-6510-5eb5-b566-7a40e0ff23da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256298}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6f26a8de-f79d-5639-bcb0-5e1797aee6a5" :question/math-academy-id "q-122496" :question/problem "Evaluate $(\\frac{12}{2}).$" :question/worked-solution "First, note that $(\\frac{12}{2})$ means the same thing as ${}_{12}{C}_{2}.$\n\n In general, the number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nSubstituting $n=12$ and $r=2,$ we get\n\n$$\n\\begin{aligned}{}_{12}{C}_{2} & =\\frac{12!}{(12-2)!2!} \\\\  & =\\frac{12!}{10!2!} \\\\  & =\\frac{12\\cdot 11\\cdot \\cancel{10!}}{\\cancel{10!}\\cdot 2} \\\\  & =66.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256650 :knowledge-point/_questions [{:db/id #edb/ref 17592186083312 :knowledge-point/id #uuid "b6b720d4-59b0-5d86-b856-ff69abfe4152" :knowledge-point/title "Evaluating Combinations Given Using Alternate Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "111b2cfd-82b0-5772-b24e-fd1bd23e4b33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,040" :db/id #edb/ref 17592186253819} {:answer/id #uuid "21171d16-53d1-5b90-a331-d3226cde70e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186253963} {:answer/id #uuid "46c7e24a-c1fd-5962-ac5d-4839e3b8c67a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186254268} {:answer/id #uuid "6832b881-4d09-5782-a46a-848fa67f6fc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186254613} {:answer/id #uuid "78be4145-2565-5481-9bb8-5816c8527f3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "720" :db/id #edb/ref 17592186254737}] :answer-field/correct {:answer/id #uuid "21171d16-53d1-5b90-a331-d3226cde70e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186253963} :answer-field/id #uuid "4c6b1a42-ec84-598a-a9a5-a2d349f20b27" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256067}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b9dcfba9-1011-5da0-85ce-637573b456f3" :question/math-academy-id "q-122498" :question/problem "Evaluate $(\\frac{7}{6}).$" :question/worked-solution "First, note that $(\\frac{7}{6})$ means the same thing as ${}_{7}{C}_{6}.$\n\n In general, the number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nSubstituting $n=7$ and $r=6,$ we get\n\n$$\n\\begin{aligned}{}_{7}{C}_{6} & =\\frac{7!}{(7-6)!6!} \\\\  & =\\frac{7!}{1!6!} \\\\  & =\\frac{7\\cdot \\cancel{6!}}{1\\cdot \\cancel{6!}} \\\\  & =7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256658 :knowledge-point/_questions [{:db/id #edb/ref 17592186083225 :knowledge-point/id #uuid "120f626e-dd00-537a-8948-d8f81850d696" :knowledge-point/title "Calculating the Number of Combinations of Objects Chosen From a Group Fewer Than Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ec50a16-bb6b-5f05-b165-80436402a0f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186253933} {:answer/id #uuid "2a47123d-f4ec-5210-b67f-61a4869b33fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "720" :db/id #edb/ref 17592186254046} {:answer/id #uuid "3b29dafa-efbf-5a37-8d32-4a83de611c04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186254185} {:answer/id #uuid "82e767a8-42f1-58ae-87ff-b6da314b6877" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186254834} {:answer/id #uuid "c081a7f4-7f7e-5025-bc7b-e08baf4bd4b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186255383}] :answer-field/correct {:answer/id #uuid "c081a7f4-7f7e-5025-bc7b-e08baf4bd4b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186255383} :answer-field/id #uuid "c6ca1418-3eca-579f-bc5d-83202ced8211" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256272}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d62b2335-132d-58f4-9c9e-53b886749092" :question/math-academy-id "q-122550" :question/problem "In a group of six dancers, if every possible pair dances together, what is the total number of dances?" :question/worked-solution "The number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nThere are $6$ people, so $n=6.$ We want to select $2$ of those people for each dance, so we have $r=2.$\n\nTherefore, the number of dances is\n\n$$\n\\begin{aligned}{}_{6}{C}_{2} & =\\frac{6!}{(6-2)!\\,2!} \\\\  & =\\frac{6!}{4!2!} \\\\  & =\\frac{6\\cdot 5\\cdot \\cancel{4!}}{\\cancel{4!}2!} \\\\  & =\\frac{6\\cdot 5}{2\\cdot 1} \\\\  & =\\frac{30}{2} \\\\  & =15.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256659 :knowledge-point/_questions [{:db/id #edb/ref 17592186083225 :knowledge-point/id #uuid "120f626e-dd00-537a-8948-d8f81850d696" :knowledge-point/title "Calculating the Number of Combinations of Objects Chosen From a Group Fewer Than Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d412dbf-4d63-56a8-97f9-9b35e1f750a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16\\,807" :db/id #edb/ref 17592186253916} {:answer/id #uuid "2b5b6064-5a8e-5103-a78f-a2c0f2e9b9be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186254054} {:answer/id #uuid "9aef58db-6ad9-5889-81a4-34935e92803f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,520" :db/id #edb/ref 17592186255035} {:answer/id #uuid "aaf8596c-104e-5f0a-9f7f-a01c66e5d834" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186255183} {:answer/id #uuid "e4b62d0a-3b46-5af4-9af2-0aff7507291f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186255692}] :answer-field/correct {:answer/id #uuid "aaf8596c-104e-5f0a-9f7f-a01c66e5d834" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186255183} :answer-field/id #uuid "dd1052dc-4eee-5989-a0a2-a3cf9141dddf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256314}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d4102b5a-9ebe-5326-97ea-80b1e81d8483" :question/math-academy-id "q-122551" :question/problem "Mike wants to work out five days a week. In how many ways can Mike choose five days to work out?" :question/worked-solution "The number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nThere are $7$ days in a week, so $n=7.$ We want to select $5$ of those days for Mike to workout, so we have $r=5.$\n\nTherefore, the number of choices is\n\n$$\n\\begin{aligned}{}_{7}{C}_{5} & =\\frac{7!}{(7-5)!\\,5!} \\\\  & =\\frac{7!}{2!5!} \\\\  & =\\frac{7\\cdot 6\\cdot \\cancel{5!}}{2!\\cancel{5!}} \\\\  & =\\frac{7\\cdot 6}{2\\cdot 1} \\\\  & =\\frac{42}{2} \\\\  & =21.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256661 :knowledge-point/_questions [{:db/id #edb/ref 17592186083224 :knowledge-point/id #uuid "d22726fc-8e6b-5e22-80c8-fbc2aa245217" :knowledge-point/title "Calculating the Number of Combinations of Objects Chosen From a Group of at Least Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28decb17-2f60-5f59-a7f6-7cd775afb238" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186254037} {:answer/id #uuid "383c9e5e-11b5-576b-8182-b0c4670f77ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60\\,480" :db/id #edb/ref 17592186254156} {:answer/id #uuid "4821aeac-b15c-52cb-80e2-ce26701d85ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "220" :db/id #edb/ref 17592186254284} {:answer/id #uuid "6e8875a4-0a40-525e-86e4-1aa56ad397a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,728" :db/id #edb/ref 17592186254650} {:answer/id #uuid "9e619d41-571d-589f-8e3b-716a7b602217" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,320" :db/id #edb/ref 17592186255063}] :answer-field/correct {:answer/id #uuid "4821aeac-b15c-52cb-80e2-ce26701d85ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "220" :db/id #edb/ref 17592186254284} :answer-field/id #uuid "2f6f2b63-feb8-5d1c-b0ef-b85df01026cd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256003}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0df0d84e-0701-5f25-a0a7-891dc8357fe1" :question/math-academy-id "q-122560" :question/problem "Claire has a bag of candies with $12$ assorted flavors. In how many ways can Claire pick $3$ flavors of candies?" :question/worked-solution "In general, the number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nThere are $12$ flavors, so $n=12.$ We want to select $3$ of those flavors, so we have $r=3.$\n\nTherefore, the number of choices is\n\n$$\n\\begin{aligned}{}_{12}{C}_{3} & =\\frac{12!}{(12-3)!\\,3!} \\\\  & =\\frac{12!}{9!3!} \\\\  & =\\frac{12\\cdot 11\\cdot 10\\cdot \\cancel{9!}}{\\cancel{9!}3!} \\\\  & =\\frac{12\\cdot 11\\cdot 10}{3\\cdot 2\\cdot 1} \\\\  & =\\frac{1\\,320}{6} \\\\  & =220.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186387437 :knowledge-point/_questions [{:db/id #edb/ref 17592186087721 :knowledge-point/id #uuid "e0dc11d5-8eda-52b1-b7b1-42b481813ff4" :knowledge-point/title "Graphing a Curve Defined Parametrically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e3809196-0e72-568a-acb4-8f1806b011f3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d1/d1cec5ea2da4a0b5f141bb24b4addc797defbc48e76cdfdbfab3a303e348b8cc.png" :db/id #edb/ref 17592186387439} {:answer/id #uuid "d44a46da-960a-5000-b573-28968c62249a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bc/bcb2b08bab14ce74347d37a0e896451750db0203ab830b835a83de6b7a81b61d.png" :db/id #edb/ref 17592186387440} {:answer/id #uuid "a8c8555e-f76d-58d2-98de-66b72a2089cb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/02/02b248ea373f295fa4dbad215eba4c211ef18548dca4a56d57cb3f15424ad501.png" :db/id #edb/ref 17592186387441} {:answer/id #uuid "6dbecde8-5a29-5731-8756-dcd4a93b4487" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/09/097262c9e70a68d3a7ae1b1186bed57cefd7b99b0af2215d4ce6b08a086f90c6.png" :db/id #edb/ref 17592186387442} {:answer/id #uuid "63870ff1-4a2f-5845-b126-b062e8aa81ef" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c4/c477137fe47dc3f0475f44658117545da3dae94f18e3bf2ce897d2a89fad2a37.png" :db/id #edb/ref 17592186387443}] :answer-field/correct {:answer/id #uuid "a8c8555e-f76d-58d2-98de-66b72a2089cb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/02/02b248ea373f295fa4dbad215eba4c211ef18548dca4a56d57cb3f15424ad501.png" :db/id #edb/ref 17592186387441} :answer-field/id #uuid "533eaf8b-e6a9-5c0c-825d-2916631bb54e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387438}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5a8d7579-5453-54bf-bdf9-b20277da40a8" :question/math-academy-id "q-123783" :question/problem "Determine the graph of the following parametrically defined curve:\n\n$$\nx=1-2t,\\,y=t,\\,-3\\le t\\le 3\n$$" :question/worked-solution "We need to create a table of values and then sketch the curve. First, we work out the $x$-values using the formula $x=1-2t.$ This gives\n\n| **$t$** | $-3$ | $-2$ | $-1$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $7$ | $5$ | $3$ | $1$ | $-1$ | $-3$ | $-5$ |\n| $y$ | $$ | $$ | $$ | $$ | $$ | $$ | $$ |\n\n$$\n\n$$\n\nNow, we work out the $y$ values using $y=t.$ This gives\n\n| **$t$** | $-3$ | $-2$ | $-1$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $7$ | $5$ | $3$ | $1$ | $-1$ | $-3$ | $-5$ |\n| $y$ | $-3$ | $-2$ | $-1$ | $0$ | $1$ | $2$ | $3$ |\n\n$$\n\n$$\n\nPlotting these points, we obtain the following curve:\n\n![](images/ef/ef5f33b74b59b5a62fd8670a8feb6487b01a97aed4a44a098a576d10d891bd68.png)"}] [{:db/id #edb/ref 17592186179998 :knowledge-point/_questions [{:db/id #edb/ref 17592186179730 :knowledge-point/id #uuid "90a5c75b-e93d-5f09-a126-3d0cb5ede2d5" :knowledge-point/title "Writing a Factorial in an Equivalent Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f928683-2206-515e-9154-238c2b97ff67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(k+2)\\cdot k" :db/id #edb/ref 17592186257621} {:answer/id #uuid "771aae05-3e43-53e5-a66d-413cfd014971" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(k+2)\\cdot (k+1)!" :db/id #edb/ref 17592186257834} {:answer/id #uuid "8401c7a8-8de7-538a-b715-56aeb8b85245" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186257952} {:answer/id #uuid "a0f47d0b-3af1-5625-9eef-20a43b3c90a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(k+2)\\cdot (k+1)" :db/id #edb/ref 17592186258194} {:answer/id #uuid "baf66338-ec48-5785-9b89-dee745803bf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(k+2)\\cdot k!" :db/id #edb/ref 17592186258420}] :answer-field/correct {:answer/id #uuid "771aae05-3e43-53e5-a66d-413cfd014971" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(k+2)\\cdot (k+1)!" :db/id #edb/ref 17592186257834} :answer-field/id #uuid "a0b168bd-c6b6-557b-94bf-969806cf924b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259315}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "06937889-7753-54db-a2ad-60dda70867ce" :question/math-academy-id "q-124142" :question/problem "Which of the following is equivalent to $(k+2)!$ for any $k\\ge 0?$" :question/worked-solution "Using the definition of factorial, we have \n\n$$\n(k+2)!=(k+2)\\cdot (k+1)\\cdot k\\cdot \\,⋯\\,\\cdot 2\\cdot 1.\n$$\n\nNow, applying the factorial definition to all but the first factor, we get\n\n$$\n\\begin{aligned}(k+2)! & =(k+2)\\cdot \\overset{(k+1)!}{\\overset{⏞}{(k+1)\\cdot k\\cdot \\,⋯\\,\\cdot 2\\cdot 1}} \\\\  & =(k+2)\\cdot (k+1)!\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259688 :knowledge-point/_questions [{:db/id #edb/ref 17592186115360 :knowledge-point/id #uuid "fe83dedc-3034-5e3a-b546-dd57c0ccc6e8" :knowledge-point/title "Finding the Area of a Triangle by Solving for a Variable Given an Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27147d26-f01c-583d-935d-f91c78e5041f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{3}}{2}" :db/id #edb/ref 17592186257121} {:answer/id #uuid "286fec25-4908-5694-a681-f2ea16ea8ca2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{3}" :db/id #edb/ref 17592186257142} {:answer/id #uuid "9ce385bc-2516-5301-a4cb-0ce65a749f7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt{3}" :db/id #edb/ref 17592186258162} {:answer/id #uuid "b22bab3f-9316-5310-8fb4-b670b1d10da9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\sqrt{3}" :db/id #edb/ref 17592186258333} {:answer/id #uuid "f1239ea4-4271-56cc-bc8e-fe1a2fd69654" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9\\sqrt{3}}{2}" :db/id #edb/ref 17592186258879}] :answer-field/correct {:answer/id #uuid "b22bab3f-9316-5310-8fb4-b670b1d10da9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\sqrt{3}" :db/id #edb/ref 17592186258333} :answer-field/id #uuid "f7b4e062-0d53-5765-889c-2a0da239ec0b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259468}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9cbd5c1c-b243-5354-99fa-1a41e7c9ebe7" :question/math-academy-id "q-124475" :question/problem "![](images/0a/0ad5279a7ec9ac20a2c4e1449f93ae67854caf021aba8435165b80069f23afbd.png)\n\nFind the area (in square units) of $△ABC$ shown above." :question/worked-solution "In this case, the area of the right triangle is\n\n$$\nA=\\frac{1}{2}AC\\cdot AB.\n$$\n\nWe are given that $m∠B={60}^{∘}.$ Notice that relative to $∠B,$ we have expressions for the lengths of the opposite side $\\overset{―}{AC}$ and adjacent side $\\overset{―}{AB}.$ Hence, we can use the tangent ratio to solve for $x:$\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡(m∠A) & =\\frac{AC}{AB} \\\\ \\operatorname{tan}⁡({60}^{∘}) & =\\frac{2\\sqrt{3}\\,x}{x+2} \\\\ \\sqrt{3} & =\\frac{2\\sqrt{3}\\,x}{x+2} \\\\ \\sqrt{3}(x+2) & =2\\sqrt{3}\\,x \\\\ \\sqrt{3}\\,x+2\\sqrt{3} & =2\\sqrt{3}\\,x \\\\ 2\\sqrt{3} & =\\sqrt{3}\\,x \\\\ x & =2\\end{aligned}\n$$\n\nSo, the side lengths are \n\n$$\n\\begin{aligned}AC & =2\\sqrt{3}\\,x=2\\sqrt{3}\\cdot 2=4\\sqrt{3}, \\\\ AB & =x+2=2+2=4.\\end{aligned}\n$$\n\nTherefore, the area of $△ABC$ is\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}\\cdot AC\\cdot AB \\\\  & =\\frac{1}{2}\\cdot 4\\sqrt{3}\\cdot 4 \\\\  & =8\\sqrt{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233346 :knowledge-point/_questions [{:db/id #edb/ref 17592186179730 :knowledge-point/id #uuid "90a5c75b-e93d-5f09-a126-3d0cb5ede2d5" :knowledge-point/title "Writing a Factorial in an Equivalent Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8fae7a58-5f8a-59f7-a26b-e37ea84449ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n+2)!" :db/id #edb/ref 17592186258044} {:answer/id #uuid "ac295ae4-0956-533a-95bb-43fe80dfb821" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n+3)\\cdot (n+2)!" :db/id #edb/ref 17592186258282} {:answer/id #uuid "b5c69797-b7c1-5c9b-8c12-6254b4fc206c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n+3)\\cdot (n+2)" :db/id #edb/ref 17592186258358} {:answer/id #uuid "c63b6375-a6af-5c2b-bb3b-f9ac6aca359c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n+3)\\cdot (n+1)!" :db/id #edb/ref 17592186258515} {:answer/id #uuid "efaa4806-083a-546d-8433-3487b50984f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n+2)" :db/id #edb/ref 17592186258862}] :answer-field/correct {:answer/id #uuid "ac295ae4-0956-533a-95bb-43fe80dfb821" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n+3)\\cdot (n+2)!" :db/id #edb/ref 17592186258282} :answer-field/id #uuid "b03fcfaa-96c1-5bd9-a600-2d70d1ca8a57" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259341}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "12e390ab-b9d1-50cd-bae8-a1a0dd93fc74" :question/math-academy-id "q-124498" :question/problem "Which of the following is equivalent to $(n+3)!$ for any $n\\ge -1?$" :question/worked-solution "Using the definition of factorial, we have\n\n$$\n(n+3)!=(n+3)\\cdot (n+2)\\cdot (n+1)\\cdot \\,⋯\\,\\cdot 2\\cdot 1.\n$$\n\nNow, applying the factorial definition to all but the first factor, we get\n\n$$\n\\begin{aligned}(n+3)! & =(n+3)\\cdot \\overset{(n+2)!}{\\overset{⏞}{(n+2)\\cdot (n+1)\\cdot \\,⋯\\,\\cdot 2\\cdot 1}} \\\\  & =(n+3)\\cdot (n+2)!\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259693 :knowledge-point/_questions [{:db/id #edb/ref 17592186110754 :knowledge-point/id #uuid "87c18ea8-af12-52bd-8420-ec24ed63de65" :knowledge-point/title "Using the Pythagorean Theorem on the Unit Circle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "037a7c54-c302-5789-b25e-bd233adb82e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{11}}{9}" :db/id #edb/ref 17592186256811} {:answer/id #uuid "0bf43ace-4823-5eaa-9ad1-0be3fc1525b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{7}}{3}" :db/id #edb/ref 17592186256898} {:answer/id #uuid "45b120b9-4ece-5a16-a391-5bfbb0ea9f21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{3}" :db/id #edb/ref 17592186257392} {:answer/id #uuid "ad55cbe1-d31f-5103-bded-f0845d5ae71e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{6}}{9}" :db/id #edb/ref 17592186258296} {:answer/id #uuid "c5881a22-3400-5139-bc65-47b813f402ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{11}}{3}" :db/id #edb/ref 17592186258510}] :answer-field/correct {:answer/id #uuid "0bf43ace-4823-5eaa-9ad1-0be3fc1525b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{7}}{3}" :db/id #edb/ref 17592186256898} :answer-field/id #uuid "9474a253-0604-56e8-84bf-d3c9bd812162" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259293}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e7d8485d-2f78-5d59-9916-1d1cd2c548de" :question/math-academy-id "q-124608" :question/problem "The point $A$ is located in the first quadrant and lies on the unit circle. The $y$-coordinate of $A$ is $\\frac{\\sqrt{2}}{3}.$ What is the $x$-coordinate of $A?$" :question/worked-solution "Since the point $A$ lies on the unit circle, it must satisfy the Pythagorean theorem: \n\n$$\n{x}^{2}+{y}^{2}=1\n$$\n\nSubstituting $y=\\frac{\\sqrt{2}}{3}$ into the above and solving for $x$ gives\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =1 \\\\ {x}^{2}+{(\\frac{\\sqrt{2}}{3})}^{2} & =1 \\\\ {x}^{2}+(\\frac{2}{9}) & =1 \\\\ {x}^{2} & =1-\\frac{2}{9} \\\\ {x}^{2} & =\\frac{7}{9} \\\\ x & =\\sqrt{\\frac{7}{9}} \\\\ x & =\\pm \\frac{\\sqrt{7}}{3}.\\end{aligned}\n$$\n\nSince $A$ lies in the first quadrant, $x$ must be positive, so we select the positive answer. Therefore, our final answer is $x=\\frac{\\sqrt{7}}{3}.$"}] [{:db/id #edb/ref 17592186259694 :knowledge-point/_questions [{:db/id #edb/ref 17592186110754 :knowledge-point/id #uuid "87c18ea8-af12-52bd-8420-ec24ed63de65" :knowledge-point/title "Using the Pythagorean Theorem on the Unit Circle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c11b11b-3274-5c34-b09c-f5ec78de4e43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186257177} {:answer/id #uuid "4dcebdf8-f732-50f7-b15a-29792fc1f881" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186257450} {:answer/id #uuid "52f6bed6-51b4-5841-9d86-c1222468a4fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186257491} {:answer/id #uuid "5d59303b-e2ee-5904-a3d2-9f17c7fcfaa7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{9}" :db/id #edb/ref 17592186257597} {:answer/id #uuid "dcb144b3-687e-5d43-94a0-00b76d2854a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{3}" :db/id #edb/ref 17592186258706}] :answer-field/correct {:answer/id #uuid "52f6bed6-51b4-5841-9d86-c1222468a4fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186257491} :answer-field/id #uuid "cd602cdd-cbaf-5de8-8895-9b474285c26d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259393}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "66205715-ba82-541e-8ac0-31ae0009bc90" :question/math-academy-id "q-124611" :question/problem "The point $A$ is located in the first quadrant and lies on the unit circle. The $y$-coordinate of $A$ is $\\frac{\\sqrt{5}}{3}.$ What is the $x$-coordinate of $A?$" :question/worked-solution "Since the point $A$ lies on the unit circle, it must satisfy the Pythagorean theorem: \n\n$$\n{x}^{2}+{y}^{2}=1\n$$\n\nSubstituting $y=\\frac{\\sqrt{5}}{3}$ into the above and solving for $x$ gives\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =1 \\\\ {x}^{2}+{(\\frac{\\sqrt{5}}{3})}^{2} & =1 \\\\ {x}^{2}+(\\frac{5}{9}) & =1 \\\\ {x}^{2} & =1-\\frac{5}{9} \\\\ {x}^{2} & =\\frac{4}{9} \\\\ x & =\\sqrt{\\frac{4}{9}} \\\\ x & =\\pm \\frac{2}{3}.\\end{aligned}\n$$\n\nSince $A$ lies in the first quadrant, $x$ must be positive, so we select the positive answer. Therefore, our final answer is $x=\\frac{2}{3}.$"}] [{:db/id #edb/ref 17592186259728 :knowledge-point/_questions [{:db/id #edb/ref 17592186110756 :knowledge-point/id #uuid "435bc6f9-651f-511c-a972-9afe90baff32" :knowledge-point/title "Computing a Reciprocal Ratio Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ae50b4c-8d48-5e94-905d-2050bbd834e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{2}}{4}" :db/id #edb/ref 17592186258142} {:answer/id #uuid "a5ae39b9-8d77-5506-95cb-36cfda6b93ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{6}}{3}" :db/id #edb/ref 17592186258226} {:answer/id #uuid "b1ca8282-18dd-559f-b3d0-161a4153c226" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{2}}{2}" :db/id #edb/ref 17592186258329} {:answer/id #uuid "f50445f6-c5b6-5037-8d82-ae09d76d2629" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{3}}{2}" :db/id #edb/ref 17592186258921} {:answer/id #uuid "f57c9ed2-c68c-53ab-85fa-4cb0d40fff12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186258925}] :answer-field/correct {:answer/id #uuid "9ae50b4c-8d48-5e94-905d-2050bbd834e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{2}}{4}" :db/id #edb/ref 17592186258142} :answer-field/id #uuid "62707eaf-bd66-53e1-b24c-8b731568b056" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259199}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "186cddc1-d1ed-556b-9213-9d3efc27c116" :question/math-academy-id "q-124743" :question/problem "![](images/02/02cb693b74f0f315389f87ceed1674da11f661b3363e4df0890bdf82d61cc60c.png)\n\nThe diagram above shows the unit circle. Given that the $x$-coordinate of the point $P$ is $\\frac{1}{3},$ use the Pythagorean identity to find $csc⁡\\theta .$" :question/worked-solution "![](images/a4/a479e8e7906a3a0dc43e925c5bccd6534b4ab2e02a289403b2d0c92d0b0eb1d9.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=cos⁡\\theta ,\\,y=sin⁡\\theta \n$$\n\nWe're given that $x=\\frac{1}{3}$ at the point $P.$ Therefore, we have\n\n$$\ncos⁡\\theta =\\frac{1}{3}.\n$$\n\nWe can use the Pythagorean identity to find $sin⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ sin⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $cos⁡\\theta =\\frac{1}{3}$ gives\n\n$$\n\\begin{aligned}sin⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{1}{3})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{1}{9}} \\\\  & =\\pm \\sqrt{\\frac{8}{9}} \\\\  & =\\pm \\frac{2\\sqrt{2}}{3}.\\end{aligned}\n$$\n\nWe select the positive answer since $sin⁡\\theta $ is positive in the first quadrant. So, $sin⁡\\theta =\\frac{2\\sqrt{2}}{3}.$\n\nKnowing that $csc⁡\\theta =\\frac{1}{sin⁡\\theta },$ we have\n\n$$\ncsc⁡\\theta =\\frac{1}{(\\frac{2\\sqrt{2}}{3})}=\\frac{3}{2\\sqrt{2}}.\n$$\n\nFinally, we rationalize the denominator.\n\n$$\n\\begin{aligned}csc⁡\\theta  & =\\frac{3}{2\\sqrt{2}} \\\\  & =\\frac{3}{2\\sqrt{2}}\\cdot \\frac{\\sqrt{2}}{\\sqrt{2}} \\\\  & =\\frac{3\\sqrt{2}}{2\\cdot 2} \\\\  & =\\frac{3\\sqrt{2}}{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259733 :knowledge-point/_questions [{:db/id #edb/ref 17592186110758 :knowledge-point/id #uuid "74d05ad6-7e4a-5c50-92d1-ca4b2f00cbb1" :knowledge-point/title "Computing a Tangent or Cotangent Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "148d9fa6-e709-5ed3-8dee-a9794d49d279" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{2}}{9}" :db/id #edb/ref 17592186256967} {:answer/id #uuid "57004998-41ca-5e4e-90f5-2c24561a08c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{2}}{5}" :db/id #edb/ref 17592186257531} {:answer/id #uuid "7ee702e6-7a9d-5c39-9f0f-93b8b0fe4698" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{35}}{6}" :db/id #edb/ref 17592186257913} {:answer/id #uuid "d244da59-6698-5edd-a3a0-8e822fc76895" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{3}}{6}" :db/id #edb/ref 17592186258615} {:answer/id #uuid "d255b826-a073-5d0c-8306-dc2845cf337e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{39}}{6}" :db/id #edb/ref 17592186258617}] :answer-field/correct {:answer/id #uuid "d255b826-a073-5d0c-8306-dc2845cf337e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{39}}{6}" :db/id #edb/ref 17592186258617} :answer-field/id #uuid "8654efa3-cd29-5e20-bbaf-04bd03e93e30" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259265}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dba2d6f5-ab4c-55d2-aafd-8aaa2c0dbeec" :question/math-academy-id "q-124791" :question/problem "![](images/c2/c2938adc4474cec0da06b5cee00b60110b7e7be86d2b0cec3f1cff99653b8f76.png)\n\nThe diagram above shows the unit circle. Given that the $x$-coordinate of the point $P$ is $\\frac{2\\sqrt{3}}{5},$ what is $tan⁡\\theta ?$" :question/worked-solution "![](images/af/af76b605cad900f45bc9def13e9ec2ffb12cb253ff0bdd4c07e764eac2a30937.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=cos⁡\\theta ,\\,y=sin⁡\\theta \n$$\n\nWe're given that $x=\\frac{2\\sqrt{3}}{5}$ at the point $P.$ Therefore, we have\n\n$$\ncos⁡\\theta =\\frac{2\\sqrt{3}}{5}.\n$$\n\nWe can use the Pythagorean identity to find $sin⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ sin⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $cos⁡\\theta =\\frac{2\\sqrt{3}}{5}$ gives\n\n$$\n\\begin{aligned}sin⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{2\\sqrt{3}}{5})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{12}{25}} \\\\  & =\\pm \\sqrt{\\frac{13}{25}} \\\\  & =\\pm \\frac{\\sqrt{13}}{5}.\\end{aligned}\n$$\n\nWe select the positive answer since $sin⁡\\theta $ is positive in the first quadrant. Therefore $sin⁡\\theta =\\frac{\\sqrt{13}}{5}.$\n\nKnowing that $tan⁡\\theta =\\frac{sin⁡\\theta }{cos⁡\\theta },$ we have\n\n$$\ntan⁡\\theta =\\frac{(\\frac{\\sqrt{13}}{5})}{(\\frac{2\\sqrt{3}}{5})}=\\frac{\\sqrt{13}}{2\\sqrt{3}}.\n$$\n\nFinally, we rationalize the denominator.\n\n$$\n\\begin{aligned}tan⁡\\theta  & =\\frac{\\sqrt{13}}{2\\sqrt{3}} \\\\  & =\\frac{\\sqrt{13}}{2\\sqrt{3}}\\cdot \\frac{\\sqrt{3}}{\\sqrt{3}} \\\\  & =\\frac{\\sqrt{13\\cdot 3}}{2\\cdot 3} \\\\  & =\\frac{\\sqrt{39}}{6}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259737 :knowledge-point/_questions [{:db/id #edb/ref 17592186129080 :knowledge-point/id #uuid "021e3349-c54d-55a8-9095-902bba933660" :knowledge-point/title "Applying the Pythagorean Theorem to the Unit Circle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "374059a8-6fd5-53d5-82e6-c0ca083f7019" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\sqrt{6}}{7}" :db/id #edb/ref 17592186257267} {:answer/id #uuid "605bf4ad-ad76-590d-bd34-06fd61323e87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\sqrt{11}}{7}" :db/id #edb/ref 17592186257629} {:answer/id #uuid "8ca6d0e9-6ce5-54df-867d-65c15a711c1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\sqrt{5}}{7}" :db/id #edb/ref 17592186258017} {:answer/id #uuid "9e56d472-5870-5827-b0a4-e0552ef27936" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\sqrt{10}}{7}" :db/id #edb/ref 17592186258174} {:answer/id #uuid "a6765343-206b-5392-8a7c-8689b6c899f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\sqrt{13}}{7}" :db/id #edb/ref 17592186258234}] :answer-field/correct {:answer/id #uuid "a6765343-206b-5392-8a7c-8689b6c899f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\sqrt{13}}{7}" :db/id #edb/ref 17592186258234} :answer-field/id #uuid "affc45c9-4666-5a81-994f-df2750e5a840" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259339}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a0991dc0-bba8-5452-beb4-9ef876fd9e49" :question/math-academy-id "q-124816" :question/problem "![](images/36/3687e362fea73defca43332ee70f232282ad1eded9dc14cbbc045de4324067f0.png)\n\nThe point $P$ is located on the unit circle, as shown above. The $y$-coordinate of $P$ is $-\\frac{6}{7}.$ What is the $x$-coordinate of $P?$" :question/worked-solution "Since the point $P$ lies on the unit circle, it must satisfy the Pythagorean theorem: \n\n$$\n{x}^{2}+{y}^{2}=1\n$$\n\nSubstituting $y=-\\frac{6}{7}$ into the above and solving for $x$ gives\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =1 \\\\ {x}^{2}+{(-\\frac{6}{7})}^{2} & =1 \\\\ {x}^{2}+(\\frac{36}{49}) & =1 \\\\ {x}^{2} & =1-\\frac{36}{49} \\\\ {x}^{2} & =\\frac{13}{49} \\\\ x & =\\pm \\sqrt{\\frac{13}{49}} \\\\ x & =\\pm \\frac{\\sqrt{13}}{7}.\\end{aligned}\n$$\n\nFinally, we select the positive answer since $x$ is positive in the fourth quadrant. So our final answer is $x=\\frac{\\sqrt{13}}{7}.$"}] [{:db/id #edb/ref 17592186259759 :knowledge-point/_questions [{:db/id #edb/ref 17592186129081 :knowledge-point/id #uuid "9089ba5c-f241-574e-9592-a26e09535b69" :knowledge-point/title "Computing a Trigonometric Ratio Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14557b18-0563-5b53-9f86-fa3ca7f47384" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sin⁡\\theta =\\frac{3\\sqrt{6}}{2}" :db/id #edb/ref 17592186256963} {:answer/id #uuid "655311f9-e5d1-5870-9895-37bfc0e5bf06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sin⁡\\theta =-\\frac{\\sqrt{15}}{4}" :db/id #edb/ref 17592186257671} {:answer/id #uuid "764ac68c-5a27-54cd-b524-a31f92868b1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sin⁡\\theta =\\frac{\\sqrt{15}}{4}" :db/id #edb/ref 17592186257820} {:answer/id #uuid "82af07e0-822b-5ca8-9bee-31fb9e99ddde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sin⁡\\theta =-\\frac{3\\sqrt{6}}{2}" :db/id #edb/ref 17592186257940} {:answer/id #uuid "fbb1be87-9bec-5261-a137-45f33fdea218" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sin⁡\\theta =\\frac{3\\sqrt{2}}{4}" :db/id #edb/ref 17592186258983}] :answer-field/correct {:answer/id #uuid "764ac68c-5a27-54cd-b524-a31f92868b1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sin⁡\\theta =\\frac{\\sqrt{15}}{4}" :db/id #edb/ref 17592186257820} :answer-field/id #uuid "6318d8bf-6cd1-5740-986d-80321788e4a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259201}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d5732cef-fd51-5b54-b80c-b4a2a52357b6" :question/math-academy-id "q-124958" :question/problem "If $cos⁡\\theta =-\\frac{1}{4}$ and $\\frac{\\pi }{2}<\\theta <\\pi $ then what is the value of $sin⁡\\theta ?$" :question/worked-solution "![](images/7e/7e887638bb8b3b135c6a8e6eecf564fe8310a43f2ce26f8b565ec6966bafb89c.png)\n\nWe're given that $cos⁡\\theta =-\\frac{1}{4}.$ We can use the Pythagorean identity to find $sin⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ sin⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $cos⁡\\theta =-\\frac{1}{4}$ gives\n\n$$\n\\begin{aligned}sin⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{1}{4})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{1}{16}} \\\\  & =\\pm \\sqrt{\\frac{15}{16}} \\\\  & =\\pm \\frac{\\sqrt{15}}{4}.\\end{aligned}\n$$\n\nWe select the positive answer since $sin⁡\\theta $ is positive in the second quadrant. So, $sin⁡\\theta =\\frac{\\sqrt{15}}{4}.$"}] [{:db/id #edb/ref 17592186259760 :knowledge-point/_questions [{:db/id #edb/ref 17592186129081 :knowledge-point/id #uuid "9089ba5c-f241-574e-9592-a26e09535b69" :knowledge-point/title "Computing a Trigonometric Ratio Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "283723ea-a88e-58ae-b5e7-50b3adc30b80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cos⁡\\theta =\\frac{\\sqrt{3}}{6}" :db/id #edb/ref 17592186257138} {:answer/id #uuid "554dab01-2781-5b3b-904c-6f7365f441e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cos⁡\\theta =-\\frac{\\sqrt{3}}{6}" :db/id #edb/ref 17592186257512} {:answer/id #uuid "a9807580-b8ed-5e0b-9685-81cacc71955c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cos⁡\\theta =\\frac{\\sqrt{11}}{6}" :db/id #edb/ref 17592186258262} {:answer/id #uuid "cba11a29-a963-50dc-95d2-18ae2dc7ff60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cos⁡\\theta =-\\frac{\\sqrt{11}}{6}" :db/id #edb/ref 17592186258547} {:answer/id #uuid "f47fdff0-7ad2-5bd4-8cd6-52ab13350e82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cos⁡\\theta =-\\frac{5\\sqrt{3}}{6}" :db/id #edb/ref 17592186258918}] :answer-field/correct {:answer/id #uuid "cba11a29-a963-50dc-95d2-18ae2dc7ff60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cos⁡\\theta =-\\frac{\\sqrt{11}}{6}" :db/id #edb/ref 17592186258547} :answer-field/id #uuid "9e570dc4-28db-5cee-8f25-148cbb584b9d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259312}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f344f8f2-1c82-536a-b6c4-df0e2bd726d5" :question/math-academy-id "q-124959" :question/problem "If $sin⁡\\theta =\\frac{5}{6}$ and ${90}^{∘}<\\theta <{180}^{∘}$ then what is the value of $cos⁡\\theta ?$" :question/worked-solution "![](images/f6/f6c2b0f2e6b8c9b10de0341a73d8c7d1d88ba64bd046e82fee8db37828ca2555.png)\n\nWe're given that $sin⁡\\theta =\\frac{5}{6}.$ We can use the Pythagorean identity to find $cos⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ cos⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $sin⁡\\theta =\\frac{5}{6}$ gives\n\n$$\n\\begin{aligned}cos⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{5}{6})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{25}{36}} \\\\  & =\\pm \\sqrt{\\frac{11}{36}} \\\\  & =\\pm \\frac{\\sqrt{11}}{6}.\\end{aligned}\n$$\n\nWe select the negative answer since $cos⁡\\theta $ is negative in the second quadrant. So, $cos⁡\\theta =-\\frac{\\sqrt{11}}{6}.$"}] [{:db/id #edb/ref 17592186069030 :knowledge-point/_questions [{:db/id #edb/ref 17592186068723 :knowledge-point/id #uuid "8fe2a279-0b92-561e-b17d-b902f43725ac" :knowledge-point/title "Integrating an Expression Involving a Power Function Multiplied by a Constant Multiple of Its Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0439a2aa-fc95-5a6f-8ba6-a08e185beaa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{44}{({x}^{4}+11)}^{10}+C" :db/id #edb/ref 17592186256815} {:answer/id #uuid "76cdbd0e-31fa-5d43-9da9-087458569c34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{40}{({x}^{4}+11)}^{10}+C" :db/id #edb/ref 17592186257830} {:answer/id #uuid "7a976b23-fe40-5cb5-af5e-04ee0fd15dd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}{({x}^{4}+11)}^{9}+C" :db/id #edb/ref 17592186257866} {:answer/id #uuid "bf4cbcec-1f82-59d7-95a8-2396d64d3e5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{36}{({x}^{4}+11)}^{9}+C" :db/id #edb/ref 17592186258449} {:answer/id #uuid "cb446671-4285-5ffd-806b-31e615004133" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}{({x}^{4}+11)}^{10}+C" :db/id #edb/ref 17592186258546}] :answer-field/correct {:answer/id #uuid "76cdbd0e-31fa-5d43-9da9-087458569c34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{40}{({x}^{4}+11)}^{10}+C" :db/id #edb/ref 17592186257830} :answer-field/id #uuid "87ede77b-ed26-5e38-bf4c-454ee0d7c02e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259267}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "395d59bc-74f3-5209-b445-2d063af44516" :question/math-academy-id "q-12496" :question/problem "Calculate $\\int {x}^{3}{({x}^{4}+11)}^{9}\\,\\text{d}x.$" :question/worked-solution "In this case, the ${x}^{3}$ that's outside the parentheses isn't quite the derivative of $({x}^{4}+11).$ But the derivative is $4{x}^{3},$ so we're only out by a constant factor. \n\nSo we make the substitution\n\n$$\nu={x}^{4}+11.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =4{x}^{3}\\,⟹\\,\\frac{1}{4}\\text{d}u={x}^{3}\\,\\text{d}x,\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\begin{aligned}\\int {x}^{3}{({x}^{4}+11)}^{9}\\,\\text{d}x & =\\int ({x}^{4}+11)^{9}\\cdot {x}^{3}\\,\\text{d}x \\\\  & =\\int {u}^{9}\\cdot \\frac{1}{4}\\text{d}u \\\\  & =\\frac{1}{4}\\int {u}^{9}\\,\\text{d}u\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}\\frac{1}{4}\\int {u}^{9}\\,\\text{d}u & =\\frac{1}{4}\\cdot \\frac{{u}^{10}}{10}+C \\\\  & =\\frac{1}{40}{u}^{10}+C \\\\  & =\\frac{1}{40}({x}^{4}+11)^{10}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186400156 :knowledge-point/_questions [{:db/id #edb/ref 17592186129082 :knowledge-point/id #uuid "98d6004a-547a-5b0b-9748-9571cc3ee632" :knowledge-point/title "Computing a Tangent or Cotangent Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d1e516a-fd02-539c-a55b-1d53b977ac63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡\\theta =\\frac{\\sqrt{15}}{15}" :db/id #edb/ref 17592186400158} {:answer/id #uuid "3dd19dff-a905-5735-9496-24d7b4eee41f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡\\theta =-\\frac{3\\sqrt{5}}{5}" :db/id #edb/ref 17592186400159} {:answer/id #uuid "7175eeec-eda1-5a92-99be-f76806feffc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡\\theta =\\frac{3\\sqrt{5}}{5}" :db/id #edb/ref 17592186400160} {:answer/id #uuid "14302d62-f56c-5807-8418-d9e29a49a8ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡\\theta =-\\frac{3\\sqrt{2}}{2}" :db/id #edb/ref 17592186400161} {:answer/id #uuid "df3a9c05-b642-53bc-aee7-47f4b93b0bb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡\\theta =-\\frac{\\sqrt{15}}{15}" :db/id #edb/ref 17592186400162}] :answer-field/correct {:answer/id #uuid "df3a9c05-b642-53bc-aee7-47f4b93b0bb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡\\theta =-\\frac{\\sqrt{15}}{15}" :db/id #edb/ref 17592186400162} :answer-field/id #uuid "7ec6cfae-f16c-5f01-8f87-2f00e0b258ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400157}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6bb1887b-828c-58c3-9b10-3c0e7dc6d40b" :question/math-academy-id "q-124965" :question/problem "![](images/cd/cd41c969aee2e7c04c9034106978d8522d6a715733098bfde87abbdb861da7a8.png)\n\nThe diagram above shows the unit circle. Given that $\\operatorname{sin}⁡\\theta =\\frac{1}{4},$ what is the value of $\\operatorname{tan}⁡\\theta ?$" :question/worked-solution "![](images/49/4942cec8983dd2bddddd0ba2f8f9332b1b82f3999a44adb138b905457d39c633.png)\n\nWe can use the Pythagorean identity to find $\\operatorname{cos}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ \\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\operatorname{sin}⁡\\theta =\\frac{1}{4}$ gives\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{1}{4})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{1}{16}} \\\\  & =\\pm \\sqrt{\\frac{15}{16}} \\\\  & =\\pm \\frac{\\sqrt{15}}{4}.\\end{aligned}\n$$\n\nWe select the negative answer since $\\operatorname{cos}⁡\\theta $ is negative in the second quadrant. So, $\\operatorname{cos}⁡\\theta =-\\frac{\\sqrt{15}}{4}.$\n\nFinally, knowing that $\\operatorname{tan}⁡\\theta =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta },$ we have\n\n$$\n\\operatorname{tan}⁡\\theta =\\frac{(\\frac{1}{4})}{(-\\frac{\\sqrt{15}}{4})}=-\\frac{1}{\\sqrt{15}}=-\\frac{\\sqrt{15}}{15}.\n$$"}] [{:db/id #edb/ref 17592186395728 :knowledge-point/_questions [{:db/id #edb/ref 17592186064205 :knowledge-point/id #uuid "0ae5760b-9277-596c-8546-dca4fd985bd7" :knowledge-point/title "Integrating an Algebraic Function With Fractional Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c00a40ba-01e3-5ee1-8e78-5ca100de2c2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\sqrt{(5x+1)^{3}}+C" :db/id #edb/ref 17592186395730} {:answer/id #uuid "b95804dd-01ed-5465-b1ec-454869fcea4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\sqrt{5x+1}+C" :db/id #edb/ref 17592186395731} {:answer/id #uuid "957bc594-a52d-54c5-8fe2-348b94cdf190" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\sqrt{5x+1}+C" :db/id #edb/ref 17592186395732} {:answer/id #uuid "40a36a09-4403-51a9-8c9b-14cdbfe2aa41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{15}\\sqrt{(5x+1)^{3}}+C" :db/id #edb/ref 17592186395733} {:answer/id #uuid "2458c64b-d709-5fd5-a6bf-7d12e7bb36e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\sqrt{(5x+1)^{3}}+C" :db/id #edb/ref 17592186395734}] :answer-field/correct {:answer/id #uuid "40a36a09-4403-51a9-8c9b-14cdbfe2aa41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{15}\\sqrt{(5x+1)^{3}}+C" :db/id #edb/ref 17592186395733} :answer-field/id #uuid "0bf9bf65-124a-5233-aedc-81c57617266f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395729}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "457b9ae0-36a8-577c-85ad-8057dc66fc9a" :question/math-academy-id "q-12498" :question/problem "$\\int \\sqrt{5x+1}\\,\\text{d}x=$" :question/worked-solution "First, we rewrite the integral as\n\n$$\n\\int (5x+1)^{1/2}\\,\\text{d}x.\n$$\n\nNow, we let $u=5x+1.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5\\,⟹\\,\\text{d}x=\\frac{1}{5}\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $u$ at the very end:\n\n$$\n\\begin{aligned}\\int (5x+1)^{1/2}\\,\\text{d}x & =\\int {u}^{1/2}\\cdot (\\frac{1}{5})\\,\\text{d}u \\\\  & =\\frac{1}{5}\\int {u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{1}{5}\\cdot \\frac{2}{3}{u}^{3/2}+C \\\\  & =\\frac{2}{15}{u}^{3/2}+C \\\\  & =\\frac{2}{15}(5x+1)^{3/2}+C \\\\  & =\\frac{2}{15}\\sqrt{(5x+1)^{3}}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[\\frac{2}{15}\\sqrt{(5x+1)^{3}}+C] & =\\frac{2}{15}\\cdot \\frac{\\text{d}}{\\text{d}x}[\\sqrt{(5x+1)^{3}}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =\\frac{2}{15}\\cdot \\frac{\\text{d}}{\\text{d}x}[(5x+1)^{3/2}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =\\frac{2}{15}\\cdot \\frac{3}{2}(5x+1)^{1/2}\\cdot \\frac{\\text{d}}{\\text{d}x}(5x+1)+0 \\\\  & =\\frac{1}{5}(5x+1)^{1/2}\\cdot 5 \\\\  & =(5x+1)^{1/2} \\\\  & =\\sqrt{5x+1}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186400163 :knowledge-point/_questions [{:db/id #edb/ref 17592186129083 :knowledge-point/id #uuid "55a09362-632a-56c4-b246-903e18fc77ee" :knowledge-point/title "Computing a Reciprocal Trigonometric Ratio Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cbeb0313-5651-561b-a4b7-42ac4f88f1ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sec⁡\\theta =8\\sqrt{15}" :db/id #edb/ref 17592186400165} {:answer/id #uuid "1a165698-e8f8-506c-9756-3955aee8c79d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sec⁡\\theta =\\frac{8\\sqrt{15}}{15}" :db/id #edb/ref 17592186400166} {:answer/id #uuid "32a56d6b-1f3c-53ed-9db5-88987f60fdbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sec⁡\\theta =-\\frac{8\\sqrt{15}}{15}" :db/id #edb/ref 17592186400167} {:answer/id #uuid "9c3e631f-f822-5565-8077-5a496dd0604b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sec⁡\\theta =-\\frac{4\\sqrt{15}}{3}" :db/id #edb/ref 17592186400168} {:answer/id #uuid "0944c75f-3871-5029-b2ac-06fe51638caa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sec⁡\\theta =-8\\sqrt{15}" :db/id #edb/ref 17592186400169}] :answer-field/correct {:answer/id #uuid "32a56d6b-1f3c-53ed-9db5-88987f60fdbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sec⁡\\theta =-\\frac{8\\sqrt{15}}{15}" :db/id #edb/ref 17592186400167} :answer-field/id #uuid "77272688-3fb6-5eaf-8b2d-59ba189820e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400164}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c006e542-29a2-5102-8308-98f4920ebd17" :question/math-academy-id "q-125004" :question/problem "If $sin⁡\\theta =\\frac{7}{8}$ and $\\frac{\\pi }{2}<\\theta <\\pi $ then what is the value of $sec⁡\\theta ?$" :question/worked-solution "Let's sketch our angle $\\theta $ in the coordinate plane.\n\n![](images/5c/5c98414bbe0e1e373864e9ec1d6b8667bb0032c8824f20bed1e6f9b9079c4d02.png)\n\nWe're given that $sin⁡\\theta =\\frac{7}{8}.$ We can use the Pythagorean identity to find $cos⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ cos⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $sin⁡\\theta =\\frac{7}{8}$ gives\n\n$$\n\\begin{aligned}cos⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{7}{8})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{49}{64}} \\\\  & =\\pm \\sqrt{\\frac{15}{64}} \\\\  & =\\pm \\frac{\\sqrt{15}}{8}.\\end{aligned}\n$$\n\nWe select the negative answer since $cos⁡\\theta $ is negative in the second quadrant. So, $cos⁡\\theta =-\\frac{\\sqrt{15}}{8}.$\n\nFinally, knowing that $sec⁡\\theta =\\frac{1}{cos⁡\\theta },$ we have\n\n$$\nsec⁡\\theta =\\frac{1}{(-\\frac{\\sqrt{15}}{8})}=-\\frac{8}{\\sqrt{15}}=-\\frac{8\\sqrt{15}}{15}.\n$$"}] [{:db/id #edb/ref 17592186259766 :knowledge-point/_questions [{:db/id #edb/ref 17592186068786 :knowledge-point/id #uuid "03e934c8-da65-5615-9717-a50eee3577fd" :knowledge-point/title "Integrating Other Fractional Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "453def53-174d-5896-8e4f-7faa7466d05c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2{({x}^{2}+5)}^{8}}+C" :db/id #edb/ref 17592186257385} {:answer/id #uuid "98eb7e12-8b7e-5878-badc-a9f99309abb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9{({x}^{2}+5)}^{9}}+C" :db/id #edb/ref 17592186258129} {:answer/id #uuid "a1b2fef7-0445-5ee0-9c9b-2663d3fb7feb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{9{({x}^{2}+5)}^{9}}+C" :db/id #edb/ref 17592186258199} {:answer/id #uuid "bdcefc88-d3ad-5c21-9ac6-75e0800e4041" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{18{({x}^{2}+5)}^{8}}+C" :db/id #edb/ref 17592186258438} {:answer/id #uuid "dfeda5a9-a962-51e6-b8b1-1e93608cc2ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{18{({x}^{2}+5)}^{9}}+C" :db/id #edb/ref 17592186258733}] :answer-field/correct {:answer/id #uuid "dfeda5a9-a962-51e6-b8b1-1e93608cc2ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{18{({x}^{2}+5)}^{9}}+C" :db/id #edb/ref 17592186258733} :answer-field/id #uuid "0d7f8515-44cd-5765-b9d4-3675220879f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259058}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3d839b9a-ccae-57dc-9109-2e848ce0d27f" :question/math-academy-id "q-12502" :question/problem "Calculate $\\int \\frac{x}{{({x}^{2}+5)}^{10}}\\,\\text{d}x.$" :question/worked-solution "Let $u={x}^{2}+5.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{x}{{({x}^{2}+5)}^{10}}\\,\\text{d}x & =\\int \\frac{1}{{({x}^{2}+5)}^{10}}\\cdot x\\,\\text{d}x \\\\  & =\\int \\frac{1}{{u}^{10}}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int \\frac{1}{{u}^{10}}\\,\\text{d}u \\\\  & =\\frac{1}{2}(-\\frac{1}{9{u}^{9}})+C \\\\  & =-\\frac{1}{18{u}^{9}}+C \\\\  & =-\\frac{1}{18({x}^{2}+5)^{9}}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186400184 :knowledge-point/_questions [{:db/id #edb/ref 17592186087713 :knowledge-point/id #uuid "ed7286fe-b6e2-5544-8bc6-86afc6cdb813" :knowledge-point/title "Identifying a Matrix by Its Description"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d3912714-af31-5641-8bff-9b46c1aa3234" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $R$ only" :db/id #edb/ref 17592186400186} {:answer/id #uuid "4ceb3c00-a293-5837-a92d-52eeb50f0ae2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ only" :db/id #edb/ref 17592186400187} {:answer/id #uuid "e1eca2de-1a70-5b67-a36e-991a07dbc939" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$Q$ only" :db/id #edb/ref 17592186400188} {:answer/id #uuid "9f38d46b-1ede-55d8-a14d-a43663a75ca9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ only" :db/id #edb/ref 17592186400189} {:answer/id #uuid "6ab42314-64ed-5e2f-b8e6-3a69d859b6fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $Q$ only" :db/id #edb/ref 17592186400190}] :answer-field/correct {:answer/id #uuid "d3912714-af31-5641-8bff-9b46c1aa3234" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $R$ only" :db/id #edb/ref 17592186400186} :answer-field/id #uuid "441fdc82-6754-52e3-ae25-4987eecf3c9a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400185}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8b30b956-8f97-5e5a-bc88-28b6d6148226" :question/math-academy-id "q-125549" :question/problem "Which of the following is a $2\\times 2$ matrix?\n\n$$\nP=[\\begin{aligned}3 & 3 \\\\ 3 & 3\\end{aligned}],\\,Q=[\\begin{aligned}4 & -2 \\\\ 0 & 0 \\\\ 1 & 3 \\\\ 0 & 5\\end{aligned}],\\,R=[\\begin{aligned}4 & -2 \\\\ -1 & -2\\end{aligned}]\n$$" :question/worked-solution "- The matrix $P$ has $2$ rows and $2$ columns. So, its dimensions are $2\\times 2.$ $\\,✓$\n\n- The matrix $Q$ has $4$ rows and $2$ columns. So, its dimensions are $4\\times 2.$ $\\,\\times $\n\n- The matrix $R$ has $2$ rows and $2$ columns. So, its dimensions are $2\\times 2.$ $\\,✓$\n\nTherefore, only $P$ and $R$ are $2\\times 2$ matrices."}] [{:db/id #edb/ref 17592186400226 :knowledge-point/_questions [{:db/id #edb/ref 17592186059766 :knowledge-point/id #uuid "f71a8f16-93d4-5e5a-9b8b-e29efc682430" :knowledge-point/title "Identifying the Reflection of a Cosine Curve Over the Horizontal Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4e173d4-f5b8-5ccc-9008-d91b45244f8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1.5cos⁡(x)" :db/id #edb/ref 17592186400228} {:answer/id #uuid "4c24a715-ead1-58d4-8292-0189666d823a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=cos⁡(x)-1.5" :db/id #edb/ref 17592186400229} {:answer/id #uuid "c1cd17dd-96e3-5b25-bf97-b5e326ff0ab9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=cos⁡(x)+1.5" :db/id #edb/ref 17592186400230} {:answer/id #uuid "774b4b4b-55ca-5041-80c5-d41b0058a5c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-cos⁡(x-1.5)" :db/id #edb/ref 17592186400231} {:answer/id #uuid "c37c2d1e-7ba4-57eb-9816-faa0ae5b47ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-1.5cos⁡(x)" :db/id #edb/ref 17592186400232}] :answer-field/correct {:answer/id #uuid "c37c2d1e-7ba4-57eb-9816-faa0ae5b47ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-1.5cos⁡(x)" :db/id #edb/ref 17592186400232} :answer-field/id #uuid "56e9c54d-acd0-56fe-8076-95dec659fb84" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400227}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5183ff04-e16d-572d-aca9-41a49c02cc01" :question/math-academy-id "q-12675" :question/problem "![](images/14/146cd919d8b1cdc034dc8aa1d8d0867bee7475b7ed72837c935de3cd11b38d59.png)\n\nWhat is the equation of the graph shown above?" :question/worked-solution "![](images/85/857a4b0109ddc20535b65ffe16191494ab9fdef01b6def354fcd68b862b98679.png)\n\nTo plot the given curve, we follow these steps:\n\n- Start with the graph of $y=cos⁡x.$\n\n- Then, reflect it in the $x$-axis to give $y=-cos⁡x.$\n\n- Finally, stretch it parallel to the $y$-axis by a stretch factor of $1.5$ to give $y=-1.5cos⁡x$\n\nTherefore, the given curve is the graph of $y=-1.5cos⁡x.$"}] [{:db/id #edb/ref 17592186265789 :knowledge-point/_questions [{:db/id #edb/ref 17592186068861 :knowledge-point/id #uuid "a7f04ab7-f6f6-5d01-bfcf-b667e37e4f0b" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Irrational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d5085e7-9df9-5583-a9eb-4aca834756b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=55" :db/id #edb/ref 17592186263545} {:answer/id #uuid "49bc3a1b-22cf-5a66-a6c0-83bfe3292149" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=-45" :db/id #edb/ref 17592186263634} {:answer/id #uuid "884cd699-7583-5968-ae5f-5297ccb1d1f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=-50" :db/id #edb/ref 17592186264178} {:answer/id #uuid "8ad3250f-b580-5861-a4c8-475bce8d9d0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=45" :db/id #edb/ref 17592186264188} {:answer/id #uuid "9c4347fb-3578-5e6a-b949-5f25952eb680" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=50" :db/id #edb/ref 17592186264338}] :answer-field/correct {:answer/id #uuid "3d5085e7-9df9-5583-a9eb-4aca834756b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=55" :db/id #edb/ref 17592186263545} :answer-field/id #uuid "a7460a0f-9af3-55d8-9183-7f36516a5325" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265545}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b2094d9e-dc94-52c2-adb6-43e9a1505bb1" :question/math-academy-id "q-12995" :question/problem "The equation ${z}^{2}-25=-10z$ can be written in the form $(z+p{)}^{2}=q.$ Find $p+q.$" :question/worked-solution "First, we move the constant term to the right-hand side, the $-10z$ term to the left-hand side, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}{z}^{2}-25 & =-10z \\\\ {z}^{2}+10z & =25 \\\\ {z}^{2}+2\\cdot 5\\cdot z & =25 \\\\ {z}^{2}+2\\cdot 5\\cdot z+{5}^{2}-{5}^{2} & =25 \\\\ (z+5{)}^{2}-{5}^{2} & =25\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(z+5{)}^{2}-{5}^{2} & =25 \\\\ (z+5{)}^{2} & =50\\end{aligned}\n$$\n\nSo, $p=5,q=50,$ and $p+q=55.$"}] [{:db/id #edb/ref 17592186396018 :knowledge-point/_questions [{:db/id #edb/ref 17592186068860 :knowledge-point/id #uuid "9d78ba1c-5297-5540-afdc-d419d33e0cf7" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Rational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "596d615e-5286-5202-8b68-e459a1ad6de4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p+q=64,\\,a=-12$ and $a=4$" :db/id #edb/ref 17592186396020} {:answer/id #uuid "ab85b611-a835-5c9b-b93a-92affdbe8c81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p+q=68,\\,a=12$ and $a=-4$" :db/id #edb/ref 17592186396021} {:answer/id #uuid "cb49ee04-f343-57a4-b655-73c807196dc3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p+q=60,\\,a=12$ and $a=-8$" :db/id #edb/ref 17592186396022} {:answer/id #uuid "60eb227e-be77-5810-a6ee-f5a5a9b9ed9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p+q=68,\\,a=-12$ and $a=4$" :db/id #edb/ref 17592186396023} {:answer/id #uuid "1c7592ca-f49a-5a60-b8d5-154388f0691b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p+q=64,\\,a=-12$ and $a=-4$" :db/id #edb/ref 17592186396024}] :answer-field/correct {:answer/id #uuid "60eb227e-be77-5810-a6ee-f5a5a9b9ed9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p+q=68,\\,a=-12$ and $a=4$" :db/id #edb/ref 17592186396023} :answer-field/id #uuid "950ac440-c42e-5efd-8288-46527f1353b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396019}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4870cb8f-66f0-5759-83b5-334830749092" :question/math-academy-id "q-12997" :question/problem "The equation ${a}^{2}+8a=48$ can be written in the form $(a+p{)}^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "First, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{a}^{2}+8a & =48 \\\\ {a}^{2}+2\\cdot 4\\cdot a & =48 \\\\ {a}^{2}+2\\cdot 4\\cdot a+{4}^{2}-{4}^{2} & =48 \\\\ ({a}^{2}+2\\cdot 4\\cdot a+{4}^{2})-16 & =48 \\\\ {(a+4)}^{2}-16 & =48\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(a+4{)}^{2}-16 & =48 \\\\ (a+4{)}^{2} & =64\\end{aligned}\n$$\n\nSo, $p=4,q=64,$ and $p+q=68.$\n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(a+4{)}^{2} & =64 \\\\ \\sqrt{(a+4{)}^{2}} & =\\sqrt{64} \\\\ a+4 & =\\pm 8 \\\\ a & =-4\\pm 8\\end{aligned}\n$$\n\nTherefore, the solutions are $a=-12$ and $a=4.$"}] [{:db/id #edb/ref 17592186152417 :knowledge-point/_questions [{:db/id #edb/ref 17592186152238 :knowledge-point/id #uuid "890526df-fd1a-5340-8732-efc0c1a1b0ae" :knowledge-point/title "Estimating the Equation of a Trendline"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "406ddd97-a2f3-5770-b220-a12ff910fb55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.7" :db/id #edb/ref 17592186266727} {:answer/id #uuid "78fccb29-a94d-5fd1-8387-f1f5806cc249" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.7" :db/id #edb/ref 17592186267210} {:answer/id #uuid "808bfacd-b828-51bc-aac7-15a52841d9f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.5" :db/id #edb/ref 17592186267276} {:answer/id #uuid "8305f82a-d153-5349-9a40-5df62a8c2dd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186267297} {:answer/id #uuid "d926c8aa-6d92-5c1f-a305-6a624a663b13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186268066}] :answer-field/correct {:answer/id #uuid "808bfacd-b828-51bc-aac7-15a52841d9f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.5" :db/id #edb/ref 17592186267276} :answer-field/id #uuid "1c5c0a7e-bde9-5222-ac42-addf6181e056" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268450}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bf5281e3-0502-59b7-8231-a65966150dfe" :question/math-academy-id "q-133768" :question/problem "![](images/cb/cbe12f1271134a82701640386fcf89e39da4efbca3658569aff52cc743272660.png)\n\nEstimate the slope of the trend line for the scatter plot above. Round your answer to the nearest $0.5.$" :question/worked-solution "First, let's draw an approximate trend line for our scatter plot:\n\n![](images/05/0575edf80f4a6f26c8f1002404ac04331d4c5d1f81b644021bc6284a6212338a.png)\n\nIt seems that the trend line passes through $({x}_{1},{y}_{1})≈(2,2)$ and $({x}_{2},{y}_{2})≈(6,8).$\n\nTherefore, we estimate the slope $m$ of the line as follows:\n\n$$\n\\begin{aligned}m & ≈\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{8-2}{6-2} \\\\  & =\\frac{6}{4} \\\\  & =1.5\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186180064 :knowledge-point/_questions [{:db/id #edb/ref 17592186179653 :knowledge-point/id #uuid "892f45fd-1e75-5500-90c3-0218fab5f1e1" :knowledge-point/title "Using Trend Lines to Make Predictions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02d1fd6e-6806-5107-a9b9-f1166aad9873" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2012" :db/id #edb/ref 17592186266168} {:answer/id #uuid "49bae636-6d63-5ff3-91b0-bda02c7cd5cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2008" :db/id #edb/ref 17592186266797} {:answer/id #uuid "49efc2d2-24de-56ad-9d1a-ea04160e642f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2006" :db/id #edb/ref 17592186266800} {:answer/id #uuid "72680e93-fc03-5818-886b-1fb7836935fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2010" :db/id #edb/ref 17592186267147} {:answer/id #uuid "817d7a73-060a-5abb-89b0-40c2335aae2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2004" :db/id #edb/ref 17592186267283}] :answer-field/correct {:answer/id #uuid "72680e93-fc03-5818-886b-1fb7836935fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2010" :db/id #edb/ref 17592186267147} :answer-field/id #uuid "4f0345eb-4f3c-542f-aca7-5c58e9ccc429" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268544}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "04c26611-8a14-59f2-b00c-17923a404b5a" :question/math-academy-id "q-133772" :question/problem "![](images/97/9749ca6ec771a94dc60c64a48c2b3924641db17ced56b131bc530e1eb51eb1a0.png)\n\nThe scatter plot above shows the population of a town recorded at certain times between the years $2000$ and $2020.$\nUse the trend line to estimate in which year the town's population was $56\\,000.$" :question/worked-solution "To make our estimation, we proceed as follows:\n\n- We start at $y=56$ on the vertical axis.\n\n![](images/a9/a9d57651c5c342c3d619a20cfae2bc632df47f8924d49f400ed764870b7ae900.png)\n\n- Then, we move right until we intersect the trend line.\n\n![](images/c8/c816d47fc84f31c3a436818777d9473b68e9d8468051c40fe9b7b94005cc89ee.png)\n\n- Finally, we move down until we intersect the horizontal axis.\n\n![](images/e6/e6cbfe34a6e3bd002171d2474542a12c66b7d88ce5989b0fbb4b3542f76a2155.png)\n\nTherefore, the population was $56\\,000$ in approximately the year $2000+10=2010.$"}] [{:db/id #edb/ref 17592186180065 :knowledge-point/_questions [{:db/id #edb/ref 17592186179654 :knowledge-point/id #uuid "28adc95e-e6e5-580c-9eed-55a3d12d5232" :knowledge-point/title "Using Trend Line Equations to Make a Prediction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f440f8d-212e-598d-8f9f-659b6451b176" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186266851} {:answer/id #uuid "52760bde-f5a5-5528-95ef-7bbe23fe19c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186266881} {:answer/id #uuid "584b3843-6687-57b7-ac8c-269a9c085fc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186266932} {:answer/id #uuid "78ec6a8d-4d13-5508-b86f-b1f23b549353" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186267209} {:answer/id #uuid "9d86b59d-0202-5aff-b73f-257b8701b1a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186267561}] :answer-field/correct {:answer/id #uuid "52760bde-f5a5-5528-95ef-7bbe23fe19c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186266881} :answer-field/id #uuid "0ecb75f6-2653-5a85-866a-87ded5f8c3cc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268434}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f9a2fa13-4227-5518-b473-4e39aa559784" :question/math-academy-id "q-133774" :question/problem "![](images/47/47b77320474a559f69e6ef08b8f6638aac920b05014820ab1b4b82690059c997.png)\n\nThe scatter plot above gives the correspondence between the variables $x$ and $y$ for some data points.\nThe equation of the trend line is $y=-0.5x+9.$ Assuming this trend continues, estimate the value of $x$ when $y=2.$" :question/requires-calculator true :question/worked-solution "We can estimate the required value by substituting $y=2$ into the equation of the trend line and solving for $x:$\n\n$$\n\\begin{aligned}y & =-0.5x+9 \\\\ 2 & =-0.5x+9 \\\\ 2+0.5x & =9 \\\\ 0.5x & =7 \\\\ x & =14\\end{aligned}\n$$\n\nTherefore, according to this model, when $y=2$ we have $x≈14.$\n\nNote: The point where $y=2$ is not shown on our trend line. Therefore, our result *may* be unreliable."}] [{:db/id #edb/ref 17592186400695 :knowledge-point/_questions [{:db/id #edb/ref 17592186179654 :knowledge-point/id #uuid "28adc95e-e6e5-580c-9eed-55a3d12d5232" :knowledge-point/title "Using Trend Line Equations to Make a Prediction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e4c4d81f-1807-5985-bc75-f78a53aceac8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ decades" :db/id #edb/ref 17592186400697} {:answer/id #uuid "2b8e005e-3461-54dc-ade3-c36922d765ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7$ decades" :db/id #edb/ref 17592186400698} {:answer/id #uuid "f3927082-1031-515d-8b67-7ab60167c394" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$11$ decades" :db/id #edb/ref 17592186400699} {:answer/id #uuid "72fb5990-5df5-5b7d-af99-8c775eef439e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$8$ decades" :db/id #edb/ref 17592186400700} {:answer/id #uuid "baae8426-6809-58f7-b30c-71ec0d63e5b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$9$ decades" :db/id #edb/ref 17592186400701}] :answer-field/correct {:answer/id #uuid "baae8426-6809-58f7-b30c-71ec0d63e5b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$9$ decades" :db/id #edb/ref 17592186400701} :answer-field/id #uuid "276c6bfa-9bed-5b15-b91d-56f8ec1aea0e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400696}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "87bad21a-36f4-5e06-9484-4b7826190ce1" :question/math-academy-id "q-133929" :question/problem "![](images/ce/ce3aec85d418c8f51988f819c04403f3f3ea2e0c0e35165ed729fc1e78d0f12f.png)\n\nThe scatter plot shows the value of an artwork $y,$ in thousands of dollars, and the number of decades $x$ since it was first created. The equation of the trend line is $y=3x+5.$ \n\nAssuming this trend continues, estimate the time it takes for the artwork to be worth $$32\\,000.$" :question/worked-solution "To predict the time that must pass before the artwork is worth $$32\\,000,$ we need to substitute $y=32$ into the equation of the trend line and solve for $x:$\n\n$$\n\\begin{aligned}y & =3x+5 \\\\ 32 & =3x+5 \\\\ 3x & =27 \\\\ x & =9\\end{aligned}\n$$\n\n \n\nTherefore, according to this model, it takes approximately $9$ decades for the artwork to have a value of $$32\\,000.$ \n\nNote: The point where $y=32$ is not shown on our trend line. Therefore, our result *may* be unreliable."}] [{:db/id #edb/ref 17592186268936 :knowledge-point/_questions [{:db/id #edb/ref 17592186179655 :knowledge-point/id #uuid "877509f5-a5de-55d2-ab5d-6c37fc5b0650" :knowledge-point/title "Making a Prediction by Estimating a Trend Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35b193b3-2679-5e57-8519-13a75ee39c10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9.5" :db/id #edb/ref 17592186266607} {:answer/id #uuid "63960119-96c8-5a11-ac8b-ce536b8c33fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186267020} {:answer/id #uuid "6d5351fc-ea93-5077-808a-2e970121ae5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.5" :db/id #edb/ref 17592186267106} {:answer/id #uuid "741f39ef-7c89-590a-98d9-9e6e5d60231a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186267164} {:answer/id #uuid "e30490b9-cb52-56b4-adaf-fdd3ed2b6536" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186268150}] :answer-field/correct {:answer/id #uuid "e30490b9-cb52-56b4-adaf-fdd3ed2b6536" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186268150} :answer-field/id #uuid "454866ab-76dc-5d3a-ae98-8d88fb102885" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268522}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b4e2e69a-6742-55aa-baed-902f71aaf13b" :question/math-academy-id "q-133943" :question/problem "![](images/7b/7ba7aa1cf49bb5a2dc430d9a21baaa8491aa61d8898f2aad142406c5c569b51b.png)\n\nThe scatter plot above gives the correspondence between the variables $x$ and $y$ for some data points. Estimate the value of $x$ when $y=7.$ \n\n*Hint: Assume the trend is linear, and that the trend line passes through the points $(1,1)$ and $(5,4).$*" :question/worked-solution "First, using the hint, let's draw an approximate trend line for our scatter plot.\n\n![](images/59/59efe1b79b0d032179a5210ee694b0d59ad082853ca9fb80a9d79d9f6444f2bf.png)\n\nOur trend line passes through $({x}_{1},{y}_{1})=(1,1)$ and $({x}_{2},{y}_{2})=(5,4).$\n\nWe will write the equation of the line in the slope-intercept form \n\n$$\ny=mx+b.\n$$\n\nFirst, we calculate the slope $m$ of the line as follows:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{4-1}{5-1} \\\\  & =\\frac{3}{4} \\\\  & =0.75\\end{aligned}\n$$\n\nSubstituting $m=0.75$ into the slope-intercept form above, we get\n\n$$\ny=0.75x+b.\n$$\n\nWe now need to calculate the $y$-intercept $b.$ We can do this by substituting the coordinates of a point on the line. Any point will do, so let's substitute $(1,1):$\n\n$$\n\\begin{aligned}y & =0.75x+b \\\\ 1 & =0.75(1)+b \\\\ 1 & =0.75+b \\\\ b & =0.25\\end{aligned}\n$$\n\nTherefore, the equation of the line is \n\n$$\ny=0.75x+0.25.\n$$\n\nFinally, we substitute $y=7$ into the equation above and solve for $x:$\n\n$$\n\\begin{aligned}y & =0.75x+0.25 \\\\ 7 & =0.75x+0.25 \\\\ 6.75 & =0.75x \\\\ x & =9\\end{aligned}\n$$\n\nTherefore, according to this model, when $y=7$ we have $x≈9.$\n\nNote: The point where $y=7$ is not shown on our trend line. Therefore, our result *may* be unreliable."}] [{:db/id #edb/ref 17592186268942 :knowledge-point/_questions [{:db/id #edb/ref 17592186179655 :knowledge-point/id #uuid "877509f5-a5de-55d2-ab5d-6c37fc5b0650" :knowledge-point/title "Making a Prediction by Estimating a Trend Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17f29363-b569-5d10-bfb6-d2079ad002cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186266341} {:answer/id #uuid "21adce06-163c-56df-805d-189e82316cfd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186266444} {:answer/id #uuid "5eb9a5f6-a02a-50a1-82fc-c1b17fea560a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186266978} {:answer/id #uuid "8471999f-0fd0-539e-80f6-36a51c97305c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186267308} {:answer/id #uuid "84f2a1f9-f092-5363-87eb-b298f12956d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186267314}] :answer-field/correct {:answer/id #uuid "17f29363-b569-5d10-bfb6-d2079ad002cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186266341} :answer-field/id #uuid "6bb94996-186d-52e6-9592-b3343bd68e4c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268601}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9cd1cd6f-81d1-5aa8-a97e-ba1b2bd9d144" :question/math-academy-id "q-133965" :question/problem "![](images/e3/e3319694b1112e92602219492d51116d514a88e885431ac1ef0c8f8becb0dc18.png)\n\nA tea shop wants to determine the relationship between the outside temperature and the number of customers they serve. The scatter plot above shows the information they collected over several days. Assuming this trend continues, estimate the number of customers the tea shop expects to serve if the outside temperature is ${36}^{∘}\\,\\text{C}.$\n\n*Hint: Assume the trend is linear and that the trend line passes through the points $(15,60)$ and $(30,30).$*" :question/worked-solution "First, using the hint, let's draw an approximate trend line for our scatter plot.\n\n![](images/7a/7adb5dd9bfcfcea8842eebfcacc704237f010f87c8ffd695afab890801237abd.png)\n\nThe trend line passes through $({x}_{1},{y}_{1})=(15,60)$ and $({x}_{2},{y}_{2})=(30,30).$\n\nWe will write the equation of the line in the slope-intercept form \n\n$$\ny=mx+b.\n$$\n\nFirst, we find the slope $m$ of the line as follows:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{30-60}{30-15} \\\\  & =\\frac{(-30)}{15} \\\\  & =-2\\end{aligned}\n$$\n\nSubstituting $m=-2$ into the slope-intercept form above, we get\n\n$$\ny=-2x+b.\n$$\n\nWe now need to calculate the $y$-intercept $b.$ We can do this by substituting the coordinates of a point on the line. Any point will do, so let's substitute $(15,60):$\n\n$$\n\\begin{aligned}y & =-2x+b \\\\ 60 & =-2(15)+b \\\\ 60 & =-30+b \\\\ b & =90\\end{aligned}\n$$\n\nTherefore, the equation of the line is \n\n$$\ny=-2x+90.\n$$\n\nFinally, we substitute $x=36$ into the equation above, which gives\n\n$$\n\\begin{aligned}y & =-2x+90 \\\\  & =-2(36)+90 \\\\  & =-72+90 \\\\  & =18.\\end{aligned}\n$$\n\nTherefore, according to this model, the tea shop expects to serve $18$ customers.\n\nNote: The point where $x=36$ is not shown on our trend line. Therefore, our result *may* be unreliable."}] [{:db/id #edb/ref 17592186268943 :knowledge-point/_questions [{:db/id #edb/ref 17592186179653 :knowledge-point/id #uuid "892f45fd-1e75-5500-90c3-0218fab5f1e1" :knowledge-point/title "Using Trend Lines to Make Predictions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3219263b-abe6-5728-9661-5138a2700247" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ hours" :db/id #edb/ref 17592186266585} {:answer/id #uuid "381bfb6f-c43f-59ee-a686-ab558a709a60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5.5$ hours" :db/id #edb/ref 17592186266631} {:answer/id #uuid "5bc2d41a-ea63-5ca1-9147-b914f0535d73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4.5$ hours" :db/id #edb/ref 17592186266957} {:answer/id #uuid "6b0c2701-9911-51b4-900b-6cab03bd2c54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6$ hours" :db/id #edb/ref 17592186267091} {:answer/id #uuid "eec77403-0e51-5d0c-9b05-535493cd6148" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ hours" :db/id #edb/ref 17592186268269}] :answer-field/correct {:answer/id #uuid "3219263b-abe6-5728-9661-5138a2700247" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ hours" :db/id #edb/ref 17592186266585} :answer-field/id #uuid "8409954c-10b2-59ea-b026-9a4d57399061" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268643}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d6bab4ea-9515-5432-8897-bfe0c69aa515" :question/math-academy-id "q-133967" :question/problem "![](images/1d/1d4df2d201ccbaf2305534d61c8a0ed5f7957b1629d8cd2fbd5fff933283c0dc.png)\n\nThe scatter plot above shows the number of matches won by some chess players in a championship and the hours they spend training per day.\nUse the trend line to estimate how much time players need to train each day to win $30$ championship games." :question/worked-solution "To make our estimation, we proceed as follows:\n\n- We start at $y=30$ on the vertical axis.\n\n![](images/26/26ba10258a8794a97dfc5e61c8160b342ed6890f7a9af40c1e21ac814c779188.png)\n\n- Then, we move right until we intersect the trend line.\n\n![](images/e5/e50d79adb9803f6509314cf3512fcd388ccc78b287d6653b9e318ce54ce45022.png)\n\n- Finally, we move down until we intersect the horizontal axis.\n\n![](images/a9/a9bd5a7973ecb2e88c328d0943d4bfebe9862b2cea1abbd0b3fa3665fa177167.png)\n\nTherefore, a chess player that wins $30$ games spends around $5$ hours training per day."}] [{:db/id #edb/ref 17592186388307 :knowledge-point/_questions [{:db/id #edb/ref 17592186152233 :knowledge-point/id #uuid "79f1049a-8af9-50ee-9dac-9dbd9c19bdc6" :knowledge-point/title "Correctly Identifying a Scatter Plot"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d71911a4-1607-57a3-939c-1ce77fc6b325" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d5/d5d7978459fa262b16b4216fa5363a8f14f431e6524163d6e1bbc0f0bdaad7dc.png" :db/id #edb/ref 17592186388309} {:answer/id #uuid "f6dd706d-50c4-58f6-b939-f20e9d0556b5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5b/5bdbaadf2d3ea794c145365f5ee61ee4c1551dc72b62c8a681933b9aac74d214.png" :db/id #edb/ref 17592186388310} {:answer/id #uuid "30229580-8e50-507d-83e4-267c38aa9543" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/75/75196d39e72e9ce6ba5b0b32ca486d191bbe209a8a646b030c83b2979fdc3054.png" :db/id #edb/ref 17592186388311} {:answer/id #uuid "6aa0cce7-f139-50cd-9987-c94e8df7b25d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/58/58c61701533884a6497bb0e3f692adf4a4d72c648577451fae650dbd164e5001.png" :db/id #edb/ref 17592186388312} {:answer/id #uuid "237d4951-e701-5b11-a8f1-c101458de5ec" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/37/37667e67c6148e8e46c216b1351ada6b16b0e9d3a22de69564415679535fc92e.png" :db/id #edb/ref 17592186388313}] :answer-field/correct {:answer/id #uuid "f6dd706d-50c4-58f6-b939-f20e9d0556b5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5b/5bdbaadf2d3ea794c145365f5ee61ee4c1551dc72b62c8a681933b9aac74d214.png" :db/id #edb/ref 17592186388310} :answer-field/id #uuid "02ccddff-56cd-51ab-852a-3e4a3e3b4576" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388308}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "935951a4-ee2a-54bc-9e42-14a72505ef8e" :question/math-academy-id "q-133968" :question/problem "A teacher wants to determine whether a student's performance in mathematics influences their performance in physics. The following table shows the grades of $5$ students in a mathematics and physics class. \n\n| **Math Grade** | **$8$** | **$6$** | **$8$** | **$4$** | **$5$** |\n| --- | --- | --- | --- | --- | --- |\n| **Physics Grade** | $9$ | $5$ | $8$ | $4$ | $3$ |\n\nWhich of the following scatter plots represents this data?" :question/worked-solution "We create a scatter diagram in the coordinate plane as follows:\n\n- First, we draw the independent variable (math grade) along the horizontal axis.\n\n- Then, we draw the dependent variable (physics grade) along the vertical axis.\n\n- Finally, we plot the points that correspond to the pairs from the data.\n\nThis gives us the following scatter plot.\n\n![](images/5b/5bdbaadf2d3ea794c145365f5ee61ee4c1551dc72b62c8a681933b9aac74d214.png)"}] [{:db/id #edb/ref 17592186388314 :knowledge-point/_questions [{:db/id #edb/ref 17592186152233 :knowledge-point/id #uuid "79f1049a-8af9-50ee-9dac-9dbd9c19bdc6" :knowledge-point/title "Correctly Identifying a Scatter Plot"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d96ca6e-aa39-56b6-a603-08fb5fae2a80" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/72/726a22a7d72af2ba9a7b9c9568cc1723557ee8c0af4dd38a3dd9bacca4f72769.png" :db/id #edb/ref 17592186388316} {:answer/id #uuid "9816374b-f222-57ec-9346-41bf02f900e3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ef/ef920634ab0391c8b13566e8575ee66839bcaf38dd6e4d87bfa336035ab10166.png" :db/id #edb/ref 17592186388317} {:answer/id #uuid "66b02031-af4a-5dc1-ac7f-ed1163e286f3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b7/b741264e080009d9e634e7ffce5e9041b6cd65b34e4d840700397a7378255ea8.png" :db/id #edb/ref 17592186388318} {:answer/id #uuid "448502eb-fb15-5ab2-9d96-04aeaf2da0b1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8e/8ea63450225d8b50e6f00e012afcd3afe8215eb573ed3a31ce9aa57c30ec8132.png" :db/id #edb/ref 17592186388319} {:answer/id #uuid "8388f37e-7b04-57a4-a21b-751817dec11b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/81/81364754556cfeed2c4a2b74d2c745c054491e7f0a9e1d2512fffe6dc4569e5d.png" :db/id #edb/ref 17592186388320}] :answer-field/correct {:answer/id #uuid "66b02031-af4a-5dc1-ac7f-ed1163e286f3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b7/b741264e080009d9e634e7ffce5e9041b6cd65b34e4d840700397a7378255ea8.png" :db/id #edb/ref 17592186388318} :answer-field/id #uuid "da2b298a-e144-5d4b-ab37-e427ce14674c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388315}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "711b7d57-8e73-5262-a6cb-c7a387e51978" :question/math-academy-id "q-133969" :question/problem "Lucy, who plays basketball, notices that the number of points she scores in a game increases as a function of the number of hours she practices her jump shot each week. She records the following data.\n\n| **Number of Hours Training** | **$4$** | **$6$** | **$7$** | **$8$** | **$10$** |\n| --- | --- | --- | --- | --- | --- |\n| **Points Scored per Game** | $8$ | $12$ | $16$ | $20$ | $28$ |\n\nWhich of the following scatter plots represents this data?" :question/worked-solution "We create a scatter diagram in the coordinate plane as follows:\n\n- First, we draw the independent variable (number of hours training) along the horizontal axis.\n\n- Then, we draw the dependent variable (points scored per game) along the vertical axis.\n\n- Finally, we plot the points that correspond to the pairs from the data.\n\nThis gives us the following scatter plot.\n\n![](images/b7/b741264e080009d9e634e7ffce5e9041b6cd65b34e4d840700397a7378255ea8.png)"}] [{:db/id #edb/ref 17592186176329 :knowledge-point/_questions [{:db/id #edb/ref 17592186176031 :knowledge-point/id #uuid "534de76f-d4bc-55b5-858e-2b594f63b7bc" :knowledge-point/title "Calculating Distance Given Speed and Time"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00100cbe-fb7e-5a60-bebf-70ac5833c23b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$145$ miles" :db/id #edb/ref 17592186266151} {:answer/id #uuid "39cf88bf-156e-548d-929c-87b676eb8d65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$165$ miles" :db/id #edb/ref 17592186266654} {:answer/id #uuid "63e7bb25-145e-5483-bd59-9ec85466a225" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$185$ miles" :db/id #edb/ref 17592186267023} {:answer/id #uuid "6fa4073d-79a4-50e5-bcf9-c804d6b75650" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$21.3$ miles" :db/id #edb/ref 17592186267124} {:answer/id #uuid "cde549c5-0f81-5026-93bf-a2769df847df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$18.3$ miles" :db/id #edb/ref 17592186267983}] :answer-field/correct {:answer/id #uuid "39cf88bf-156e-548d-929c-87b676eb8d65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$165$ miles" :db/id #edb/ref 17592186266654} :answer-field/id #uuid "bef8f0e7-5010-5fd0-8979-0100c812c7ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268746}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6a0c4502-fd0b-5e9b-b54c-913ee6f1d90c" :question/math-academy-id "q-133998" :question/problem "A car traveled for $3$ hours at a constant speed of $55$ miles per hour. Find the distance covered by the car." :question/worked-solution "The speed is $55$ miles per hour. To find the distance covered in $3$ hours, we multiply the speed by $3.$ This gives\n\n$$\n\\begin{aligned}\\text{distance} & =\\text{speed}\\cdot \\text{time} \\\\  & =55\\times 3 \\\\  & =165.\\end{aligned}\n$$\n\nTherefore, the car covered $165$ miles in $3$ hours."}]}
