#{[{:db/id #edb/ref 17592186399802 :knowledge-point/_questions [{:db/id #edb/ref 17592186087845 :knowledge-point/id #uuid "4b0b57da-f9af-5fab-a337-51ee4cb28f9e" :knowledge-point/title "Calculating Vertical Asymptotes With Common Factors When the Denominator Has Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac9bdca2-12f3-5135-add9-f6cee60b6017" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ and $x=\\sqrt{3}$" :db/id #edb/ref 17592186399804} {:answer/id #uuid "ea637b56-a1b6-530a-b8ad-0581d7725118" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-\\sqrt{3},x=0$ and $x=\\sqrt{3}$" :db/id #edb/ref 17592186399805} {:answer/id #uuid "6caf38b1-8d42-5322-9446-2276f113b03b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=\\sqrt{3}$ only" :db/id #edb/ref 17592186399806} {:answer/id #uuid "88004c88-6f69-578a-840b-c594bbb79e81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ and $x=-3$" :db/id #edb/ref 17592186399807} {:answer/id #uuid "7aeb7239-f064-571a-82f0-341dafcdd4e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function has no vertical asymptotes" :db/id #edb/ref 17592186399808}] :answer-field/correct {:answer/id #uuid "7aeb7239-f064-571a-82f0-341dafcdd4e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function has no vertical asymptotes" :db/id #edb/ref 17592186399808} :answer-field/id #uuid "ce9f7db0-7e00-5308-89b8-2a0dcddb1466" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399803}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e0085fda-c140-5022-a903-4aa2d0060987" :question/math-academy-id "q-113554" :question/problem "Determine the vertical asymptotes of $f(x)=\\frac{2{x}^{2}-6}{{x}^{4}-9}.$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{2{x}^{2}-6}{{x}^{4}-9} \\\\  & =\\frac{2({x}^{2}-3)}{({x}^{2}-3)({x}^{2}+3)} \\\\  & =\\frac{2\\cancel{({x}^{2}-3)}}{\\cancel{({x}^{2}-3)}({x}^{2}+3)} \\\\  & =\\frac{2}{{x}^{2}+3}\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero:\n\n$$\n{x}^{2}+3=0\n$$\n\nThis equation does not have any real solutions. Therefore, $f(x)$ has no vertical asymptotes."}] [{:db/id #edb/ref 17592186247402 :knowledge-point/_questions [{:db/id #edb/ref 17592186068786 :knowledge-point/id #uuid "03e934c8-da65-5615-9717-a50eee3577fd" :knowledge-point/title "Integrating Other Fractional Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "387b1fd3-d0b6-5a4f-9f87-df4622619640" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{5(3-{x}^{5})^{5}}+C" :db/id #edb/ref 17592186244813} {:answer/id #uuid "5a108ad3-8f59-57fb-86b0-8078293f3c34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{7(3-{x}^{5})^{5}}+C" :db/id #edb/ref 17592186245104} {:answer/id #uuid "64849b83-6c8e-5754-857d-65fbc670429e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{25(3-{x}^{5})^{5}}+C" :db/id #edb/ref 17592186245200} {:answer/id #uuid "92481de8-22aa-54dd-8e3e-03c362cb4b5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{25(3-{x}^{5})^{5}}+C" :db/id #edb/ref 17592186245589} {:answer/id #uuid "d7b59bc3-4c29-5982-981f-e767a487ae12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{7(3-{x}^{5})^{5}}+C" :db/id #edb/ref 17592186246233}] :answer-field/correct {:answer/id #uuid "92481de8-22aa-54dd-8e3e-03c362cb4b5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{25(3-{x}^{5})^{5}}+C" :db/id #edb/ref 17592186245589} :answer-field/id #uuid "a5979b9c-8e33-51cf-9331-a30916482816" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246840}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "14745f6d-a16a-5fbf-98d1-0322f61ed9f2" :question/math-academy-id "q-113726" :question/problem "Calculate $\\int \\frac{7{x}^{4}}{{(3-{x}^{5})}^{6}}\\,\\text{d}x.$" :question/worked-solution "Let $u=3-{x}^{5}.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-5{x}^{4}\\,⟹\\,-\\frac{7}{5}\\text{d}u=7{x}^{4}\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{7{x}^{4}}{{(3-{x}^{5})}^{6}}\\,\\text{d}x & =\\int \\frac{1}{{(3-{x}^{5})}^{6}}\\cdot 7{x}^{4}\\,\\text{d}x \\\\  & =\\int \\frac{1}{{u}^{6}}\\cdot (-\\frac{7}{5})\\,\\text{d}u \\\\  & =-\\frac{7}{5}\\int \\frac{1}{{u}^{6}}\\,\\text{d}u \\\\  & =-\\frac{7}{5}(-\\frac{1}{5{u}^{5}})+C \\\\  & =\\frac{7}{25{u}^{5}}+C \\\\  & =\\frac{7}{25(3-{x}^{5})^{5}}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247405 :knowledge-point/_questions [{:db/id #edb/ref 17592186054610 :knowledge-point/id #uuid "078c9361-898f-5b9f-889e-c92442f882d9" :knowledge-point/title "Using the Constant Factor Rule to Integrate a Constant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a047b88-d760-555b-9e93-164a62866d3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5y}+C" :db/id #edb/ref 17592186245252} {:answer/id #uuid "95a7a62a-096c-53a6-9e63-99bffb683248" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{y}+C" :db/id #edb/ref 17592186245622} {:answer/id #uuid "a51fd8e4-b513-5c94-9774-6b4bdb6b2119" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y}{10}+C" :db/id #edb/ref 17592186245797} {:answer/id #uuid "b43d5d61-14e6-5d21-a689-c9df2d507f9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}y+C" :db/id #edb/ref 17592186245921} {:answer/id #uuid "f824863b-216c-5fb2-8443-c7b2f37cefa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}y+C" :db/id #edb/ref 17592186246495}] :answer-field/correct {:answer/id #uuid "f824863b-216c-5fb2-8443-c7b2f37cefa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}y+C" :db/id #edb/ref 17592186246495} :answer-field/id #uuid "b72ce3d4-25eb-5424-b4ec-a1a9ca20b6ff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246880}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1e9f7c60-e13f-56df-879c-69f076975c52" :question/math-academy-id "q-113743" :question/problem "Calculate $\\int \\frac{2}{5}\\,\\text{d}y.$" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\int \\frac{2}{5}\\,\\text{d}y & =\\frac{2}{5}\\int 1\\,\\text{d}y \\\\  & =\\frac{2}{5}\\int {y}^{0}\\,\\text{d}y \\\\  & =\\frac{2}{5}\\cdot \\frac{{y}^{0+1}}{0+1}+C \\\\  & =\\frac{2}{5}\\cdot y+C \\\\  & =\\frac{2}{5}y+C\\end{aligned}\n$$\n\nIn general, we can see that for any constant $k,$ we have $\\int k\\,\\text{d}x=kx+C.$"}] [{:db/id #edb/ref 17592186250117 :knowledge-point/_questions [{:db/id #edb/ref 17592186068759 :knowledge-point/id #uuid "f149f8ef-dd7f-5f65-928e-534e1541f9b2" :knowledge-point/title "Dividing Rational Expressions with a Single Common Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3138c09d-4d43-51c5-bead-0fdb778e1372" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5k}{2h}" :db/id #edb/ref 17592186247870} {:answer/id #uuid "31b53764-ce11-5727-886a-8d35ebdf717e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{kh}{2}" :db/id #edb/ref 17592186247876} {:answer/id #uuid "4536e350-3f2a-5750-abb4-9f26a11d9ba9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2hk}" :db/id #edb/ref 17592186248045} {:answer/id #uuid "a62285a7-f22e-5063-a1e7-ac6ebe678521" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{k}{5h}" :db/id #edb/ref 17592186248905} {:answer/id #uuid "eee7c8c3-97c8-59fa-9ad6-63ca4f761b48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{k}{2h}" :db/id #edb/ref 17592186249521}] :answer-field/correct {:answer/id #uuid "eee7c8c3-97c8-59fa-9ad6-63ca4f761b48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{k}{2h}" :db/id #edb/ref 17592186249521} :answer-field/id #uuid "1a8d3447-4499-5d0e-ad45-b2bcd7eff6ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249715}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d696dd66-1554-57e6-9d74-9c8f4a560ef5" :question/math-academy-id "q-113818" :question/problem "$\\frac{5}{h}÷\\frac{10}{k}=$" :question/worked-solution "To compute\n\n$$\n\\frac{5}{h}÷\\frac{10}{k},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{5}{h}÷\\frac{10}{k} & = \\\\ \\frac{5}{h}\\cdot \\frac{k}{10} & = \\\\ \\frac{5k}{10h} & = \\\\ \\frac{\\cancel{5}\\cdot k}{\\cancel{5}\\cdot 2h} & = \\\\ \\frac{k}{2h} & \\end{aligned}\n$$\n\nNote that in the final step, we canceled out a common factor of $5$ in the numerator and denominator."}] [{:db/id #edb/ref 17592186250120 :knowledge-point/_questions [{:db/id #edb/ref 17592186068760 :knowledge-point/id #uuid "f7614a05-f221-5fda-b491-6893f44a1a5f" :knowledge-point/title "Dividing Rational Expressions with Multiple Common Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97c1c6ab-73c5-56f5-9fee-ca0a10e54db6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(z-2)}{z+1}" :db/id #edb/ref 17592186248776} {:answer/id #uuid "a9625933-0685-5510-8621-3032717dd0ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18(z-2)}{z+1}" :db/id #edb/ref 17592186248929} {:answer/id #uuid "b3efc6b8-c94f-51b9-8dc1-1921a321212b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18}{z+1}" :db/id #edb/ref 17592186249034} {:answer/id #uuid "badd22b5-a641-5ad8-8db4-43458737b054" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18(z+1)}{z-2}" :db/id #edb/ref 17592186249093} {:answer/id #uuid "ef35f532-0726-5061-9704-c32df9534b0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{z+1}" :db/id #edb/ref 17592186249524}] :answer-field/correct {:answer/id #uuid "b3efc6b8-c94f-51b9-8dc1-1921a321212b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18}{z+1}" :db/id #edb/ref 17592186249034} :answer-field/id #uuid "96e98c2b-f5b8-5971-a5f1-a27e14529d08" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249939}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fd3f875b-33f7-55de-93e3-693ddb1d2606" :question/math-academy-id "q-113826" :question/problem "Given that $\\frac{3(z-2)}{(z+1)^{2}}=a$ and $\\frac{z-2}{6(z+1)}=b,$ what is $a÷b?$" :question/worked-solution "To compute\n\n$$\na÷b=\\frac{3(z-2)}{(z+1)^{2}}÷\\frac{z-2}{6(z+1)},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{3(z-2)}{(z+1)^{2}}÷\\frac{z-2}{6(z+1)} & = \\\\ \\frac{3(z-2)}{(z+1)^{2}}\\cdot \\frac{6(z+1)}{z-2} & = \\\\ \\frac{3\\cancel{(z-2)}}{(z+1)^{\\cancel{2}}}\\cdot \\frac{6\\cancel{(z+1)}}{\\cancel{(z-2)}} & = \\\\ \\frac{3}{z+1}\\cdot 6 & = \\\\ \\frac{18}{z+1}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250126 :knowledge-point/_questions [{:db/id #edb/ref 17592186096630 :knowledge-point/id #uuid "89902023-09e6-50cd-b08a-9d3e82d826c9" :knowledge-point/title "Writing the Area Bounded by a Curve as a Definite Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3245c48f-1a4d-5b3a-9824-8d88eff85902" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A={\\int }_{0}^{3}({x}^{2}-2x+2)\\,\\text{d}x" :db/id #edb/ref 17592186247883} {:answer/id #uuid "630663c5-73ef-581c-8f85-9dab63b65145" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A={\\int }_{-1}^{0}(-{x}^{2}+2x-2)\\,\\text{d}x" :db/id #edb/ref 17592186248322} {:answer/id #uuid "78f4a7cf-7d63-5517-b755-104a70761128" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A={\\int }_{-3}^{0}(-{x}^{2}+2x-2)\\,\\text{d}x" :db/id #edb/ref 17592186248484} {:answer/id #uuid "907fc2ff-2b6f-5b81-8ef6-ee353873c46f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A={\\int }_{-3}^{0}({x}^{2}-2x+2)\\,\\text{d}x" :db/id #edb/ref 17592186248707} {:answer/id #uuid "e0f6fe33-4274-5a92-8a81-3a822cd289e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A={\\int }_{-1}^{3}({x}^{2}-2x+2)\\,\\text{d}x" :db/id #edb/ref 17592186249414}] :answer-field/correct {:answer/id #uuid "3245c48f-1a4d-5b3a-9824-8d88eff85902" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A={\\int }_{0}^{3}({x}^{2}-2x+2)\\,\\text{d}x" :db/id #edb/ref 17592186247883} :answer-field/id #uuid "31720fdc-70b9-5d97-9b44-5f4fe1d54cab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249760}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "63bcbbf8-c502-5d3b-bd0e-da913f8e74d5" :question/math-academy-id "q-113868" :question/problem "![](images/14/149fd953075c1d9909e036d4935ccd4f17ad1734d86bba4a70254468cd2035d5.png)\n\nFor the function $f(x)={x}^{2}-2x+2$ shown above, what is the expression for the area $A$ as a definite integral?" :question/worked-solution "We want to express the area $A$ between the function $f(x)={x}^{2}-2x+2$ and the $x$-axis, between $x=0$ and $x=3.$\n\nThis can be expressed as the definite integral of $f(x)={x}^{2}-2x+2$ between the lower limit $x=0$ and the upper limit $x=3,$ as follows:\n\n$$\nA={\\int }_{0}^{3}({x}^{2}-2x+2)\\,\\text{d}x\n$$"}] [{:db/id #edb/ref 17592186250130 :knowledge-point/_questions [{:db/id #edb/ref 17592186064172 :knowledge-point/id #uuid "8bd8c6d8-0b11-5735-88a1-9b12e6315401" :knowledge-point/title "Integrating an Exponential Function With a General Base"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0558a391-cdbf-584c-a0f0-8f221f341cae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{5}^{x}ln⁡5+C" :db/id #edb/ref 17592186247467} {:answer/id #uuid "06607b0a-9d24-576c-adf1-bdc2e55f52bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{5}^{x}+C" :db/id #edb/ref 17592186247482} {:answer/id #uuid "22d652bf-3b5e-5181-8f0c-7123f5c17343" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{ln⁡x}{ln⁡5}+C" :db/id #edb/ref 17592186247734} {:answer/id #uuid "68d69094-f985-5c03-a478-6c0269a3cc32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{5}^{x}}{ln⁡5}+C" :db/id #edb/ref 17592186248365} {:answer/id #uuid "99a53d55-830f-55db-ac33-a12525e3cd5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5ln⁡x+C" :db/id #edb/ref 17592186248795}] :answer-field/correct {:answer/id #uuid "68d69094-f985-5c03-a478-6c0269a3cc32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{5}^{x}}{ln⁡5}+C" :db/id #edb/ref 17592186248365} :answer-field/id #uuid "3eca50b8-7630-5d78-accd-b706994b9510" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249782}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "333b8bc2-8d50-5f18-bbc4-8fbfe08b346d" :question/math-academy-id "q-113887" :question/problem "Calculate $\\int {5}^{x}\\,\\text{d}x.$" :question/worked-solution "To compute the integral of a general exponential function, we just need to divide by the natural logarithm of the base of the exponential function:\n\n$$\n\\begin{aligned}\\int {5}^{x}\\,\\text{d}x & =\\frac{{5}^{x}}{ln⁡5}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250134 :knowledge-point/_questions [{:db/id #edb/ref 17592186064178 :knowledge-point/id #uuid "0cae5c1b-57bd-51f6-a360-db946d25532f" :knowledge-point/title "Integrating Sine and Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "271c490c-5a05-5e0a-9c8e-cee6e93cd8b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{6}cos⁡\\theta +C" :db/id #edb/ref 17592186247771} {:answer/id #uuid "39e2cf43-8568-5bca-98a7-54e900afc4d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6cos⁡\\theta +C" :db/id #edb/ref 17592186247936} {:answer/id #uuid "8369302d-e75e-5f17-a44e-47eda2ef57fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6sin⁡\\theta +C" :db/id #edb/ref 17592186248585} {:answer/id #uuid "8f10e1a5-527b-5f97-860b-39eca916d8f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6sin⁡\\theta +C" :db/id #edb/ref 17592186248696} {:answer/id #uuid "a8b91066-0304-5eec-9198-3b7d46a0b0c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6cos⁡\\theta +C" :db/id #edb/ref 17592186248923}] :answer-field/correct {:answer/id #uuid "39e2cf43-8568-5bca-98a7-54e900afc4d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6cos⁡\\theta +C" :db/id #edb/ref 17592186247936} :answer-field/id #uuid "d679155c-4e3c-59a8-a851-7bdacacd637d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250043}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4099e9a0-92e6-5376-9bf3-b36d248db1d1" :question/math-academy-id "q-113907" :question/problem "$\\int (-6sin⁡\\theta )\\,\\text{d}\\theta =$" :question/worked-solution "Recall that\n\n$$\n\\int sin⁡\\theta \\,\\text{d}\\theta =-cos⁡\\theta +C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (-6sin⁡\\theta )\\,\\text{d}\\theta  & =-6\\int sin⁡\\theta \\,\\text{d}\\theta  \\\\  & =-6(-cos⁡\\theta )+C \\\\  & =6cos⁡\\theta +C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250138 :knowledge-point/_questions [{:db/id #edb/ref 17592186064179 :knowledge-point/id #uuid "e617f241-254b-5f70-9937-5883b6f28c4f" :knowledge-point/title "Integrating Secant-Tangent and Cosecant-Cotangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a6b2d77-6333-57e0-afd5-ae25cfed1172" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3sec⁡xcot⁡x+C" :db/id #edb/ref 17592186247800} {:answer/id #uuid "558aa8a6-6ebf-5d3f-a5a9-3b19d8e488c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3csc⁡x+C" :db/id #edb/ref 17592186248195} {:answer/id #uuid "73fffa3b-03d4-5a40-b567-70c7ae4ccf96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3csc⁡x+C" :db/id #edb/ref 17592186248445} {:answer/id #uuid "a4b2a2ae-e079-58a1-a369-536f12c56dbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3sec⁡x+C" :db/id #edb/ref 17592186248893} {:answer/id #uuid "acbcb4c2-9b18-5aa7-84c2-3dabda9f77dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3sec⁡x+C" :db/id #edb/ref 17592186248966}] :answer-field/correct {:answer/id #uuid "73fffa3b-03d4-5a40-b567-70c7ae4ccf96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3csc⁡x+C" :db/id #edb/ref 17592186248445} :answer-field/id #uuid "c3fad684-5e9d-51a7-9e19-ea6cfd103f16" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250006}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0ba0c93b-e27b-584f-9b8e-5ad2b653f757" :question/math-academy-id "q-113920" :question/problem "$\\int -3csc⁡x\\,cot⁡x\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\int csc⁡xcot⁡x\\,\\text{d}x=-csc⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int -3csc⁡x\\,cot⁡x\\,\\text{d}x & =-3\\int csc⁡xcot⁡x\\,\\text{d}x \\\\  & =-3(-csc⁡x)+C \\\\  & =3csc⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250142 :knowledge-point/_questions [{:db/id #edb/ref 17592186064180 :knowledge-point/id #uuid "caf358b8-31fb-5587-8663-f414317c42be" :knowledge-point/title "Integrating Secant Squared"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a394ebb-e724-5257-b2b3-c6ee24c9c0ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2sec⁡\\theta +C" :db/id #edb/ref 17592186247513} {:answer/id #uuid "645e7853-d773-51a7-97f0-145e363f5063" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2csc⁡\\theta +C" :db/id #edb/ref 17592186248330} {:answer/id #uuid "a159c48f-05f8-5b71-ac43-7e38b5032b08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{csc}^{2}⁡\\theta +C" :db/id #edb/ref 17592186248866} {:answer/id #uuid "cb0b4d51-0534-5643-95e4-f3c845c225d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{tan}^{2}⁡\\theta +C" :db/id #edb/ref 17592186249233} {:answer/id #uuid "ee2434c9-75b3-5a4f-85a5-13b29917e9e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2tan⁡\\theta +C" :db/id #edb/ref 17592186249513}] :answer-field/correct {:answer/id #uuid "ee2434c9-75b3-5a4f-85a5-13b29917e9e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2tan⁡\\theta +C" :db/id #edb/ref 17592186249513} :answer-field/id #uuid "0726a333-67f4-5bae-9092-988faf871214" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249681}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1eae0c2a-9fbb-58f9-9e02-1ea035b71ceb" :question/math-academy-id "q-113936" :question/problem "$\\int 2{sec}^{2}⁡\\theta \\,\\text{d}\\theta =$" :question/worked-solution "Recall that \n\n$$\n\\int {sec}^{2}⁡\\theta \\,\\text{d}\\theta =tan⁡\\theta +C\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int 2{sec}^{2}⁡\\theta \\,\\text{d}\\theta  & =2\\int {sec}^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =2tan⁡\\theta +C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250241 :knowledge-point/_questions [{:db/id #edb/ref 17592186073810 :knowledge-point/id #uuid "522b66f4-8a46-5dd0-a9d7-3b081c0ed157" :knowledge-point/title "Finding the Distance Between a Point and a Horizontal or Vertical Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b1feabb-d80c-59ec-8f66-d72d31498c1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186247669} {:answer/id #uuid "42c0433e-7aaf-5761-81da-33fe01ca9740" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186248020} {:answer/id #uuid "84f2ec16-f076-58cc-9d96-6046d0c047cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186248604} {:answer/id #uuid "a2228bab-407a-5173-8ec9-6f138869205f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186248871} {:answer/id #uuid "da8f8caf-52fa-57a4-9034-247fa54a5c3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186249355}] :answer-field/correct {:answer/id #uuid "1b1feabb-d80c-59ec-8f66-d72d31498c1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186247669} :answer-field/id #uuid "7bbc3278-eb17-5700-bb41-ce67c5754955" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249883}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a7327f68-1eda-5ad2-867d-ca3941f336b9" :question/math-academy-id "q-114323" :question/problem "Find the shortest distance between the point $(4,3)$ and the line $x=2.$" :question/worked-solution "Let's sketch the given situation.\n\n![](images/ea/ea64c0752738b0c917d897060351cdd43ed7bbf687cc20781b7241ee3be0ad3c.png)\n\nSince the line $x=2$ is a vertical line, the shortest distance between this line and the point $(4,3)$ is given by the absolute value of the difference between the $x$-coordinate of the point and $2.$ \n\nSo, the shortest distance is\n\n$$\nd=|4-2|=2.\n$$"}] [{:db/id #edb/ref 17592186250247 :knowledge-point/_questions [{:db/id #edb/ref 17592186073811 :knowledge-point/id #uuid "d7030a12-bd18-5f8b-84eb-28b6f216f972" :knowledge-point/title "Finding the Distance Between a Point and a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dc625ac-31af-5204-8aa1-d135161d7f0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186247552} {:answer/id #uuid "0ef14e40-61a3-5e9d-8570-f753f7cc4507" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{2}" :db/id #edb/ref 17592186247562} {:answer/id #uuid "17d12124-8c76-5d6d-96b2-2686e53d0068" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\sqrt{2}" :db/id #edb/ref 17592186247640} {:answer/id #uuid "2e6ebd32-522e-573e-b812-a47b4e052305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186247836} {:answer/id #uuid "80085e2c-2862-5780-b8b7-faf2920e4807" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186248548}] :answer-field/correct {:answer/id #uuid "0ef14e40-61a3-5e9d-8570-f753f7cc4507" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{2}" :db/id #edb/ref 17592186247562} :answer-field/id #uuid "54362198-2ea2-5313-8e36-1d82209afe8b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249825}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "633d0fd6-e7a8-521b-a27a-54658471a6ed" :question/math-academy-id "q-114343" :question/problem "Find the shortest distance between the point $(-1,5)$ and the line $y=x-2.$" :question/worked-solution "Let's draw a diagram describing our situation. \n\n![](images/02/021b08ba0d14e40939103d6d3e9e2004d49e5d047a5f89677b3fe542aa866f82.png)\n\n \n\nFirst, we find the equation of the line that's perpendicular to $y=x-2$ and passes through the point $(-1,5).$\n\nThe given line has a slope of $1,$ so our perpendicular line must have a slope of $-1.$\n\nUsing point-slope form and simplifying, we obtain the equation of the perpendicular line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-5 & =-(x+1) \\\\ y & =-x-1+5 \\\\ y & =-x+4\\end{aligned}\n$$\n\nWe now find the point where the two lines intersect. To do this, we solve the following system of equations:\n\n$$\n{\\begin{aligned}y=x-2 \\\\ y=-x+4\\end{aligned}\n$$\n\nWe can solve this system by putting the two equations equal to one another and solving for $x.$ This gives\n\n$$\n\\begin{aligned}x-2 & =-x+4 \\\\ x+x & =4+2 \\\\ 2x & =6 \\\\ x & =3.\\end{aligned}\n$$\n\nSubstituting $x=3$ into either of the two equations gives $y=1.$ So, our solution is $x=3$ and $y=1.$ Therefore, the lines intersect at the point $(3,1).$\n\nFinally, we find the distance $d$ between the points $(-1,5)$ and $(3,1):$\n\n$$\n\\begin{aligned}d & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{(3+1)^{2}+(1-5)^{2}} \\\\  & =\\sqrt{(4)^{2}+(-4)^{2}} \\\\  & =\\sqrt{16+16} \\\\  & =4\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, we conclude that the shortest distance between the point $(-1,5)$ and the line $y=x-2$ is $4\\sqrt{2}.$"}] [{:db/id #edb/ref 17592186250248 :knowledge-point/_questions [{:db/id #edb/ref 17592186073815 :knowledge-point/id #uuid "59d3a391-c163-5a04-944c-5d61a3950e03" :knowledge-point/title "Finding a Point on a Line That Is Closest to a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "072e45bc-d35a-54a2-8ab9-5f295ebf110f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{3}{13},\\frac{11}{13})" :db/id #edb/ref 17592186247490} {:answer/id #uuid "14581a73-ac53-505c-8447-0394a875fcd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{3}{13},-\\frac{11}{13})" :db/id #edb/ref 17592186247608} {:answer/id #uuid "6cb5a940-7e41-5de0-9f76-33adbc3d81da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\frac{3}{13},\\frac{11}{13})" :db/id #edb/ref 17592186248386} {:answer/id #uuid "bd6d5bb5-c38f-58f9-bdcf-296b1625b1d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{11}{13},\\frac{3}{13})" :db/id #edb/ref 17592186249109} {:answer/id #uuid "de549bfd-d213-57c1-ad88-fadc596d833b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,11)" :db/id #edb/ref 17592186249395}] :answer-field/correct {:answer/id #uuid "072e45bc-d35a-54a2-8ab9-5f295ebf110f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{3}{13},\\frac{11}{13})" :db/id #edb/ref 17592186247490} :answer-field/id #uuid "a5d3e168-c279-50d0-a119-0930eb63b6db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249960}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dd8e8e07-0b88-58f7-806a-13412093afb7" :question/math-academy-id "q-114345" :question/problem "![](images/ff/ff9810290868f7fd465bc310c969255b92f646d6b59ad71a93a3dcc9c38ef49c.png)\n\nFind the point on the line $3y+2x=3$ that is closest to the point $(3,5).$" :question/worked-solution "First, we rewrite the equation of the given line in slope-intercept form:\n\n$$\n\\begin{aligned}3y+2x & =3 \\\\ 3y & =-2x+3 \\\\ y & =-\\frac{2}{3}x+1\\end{aligned}\n$$\n\nNext, we find the equation of the line that's perpendicular to $y=-\\frac{2}{3}x+1$ and passes through the point $(3,5).$\n\nThe given line has a slope of $-\\frac{2}{3},$ so our perpendicular line must have a slope of $\\frac{3}{2}.$\n\nUsing point-slope form and simplifying, we obtain the equation of the perpendicular line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-5 & =\\frac{3}{2}(x-3) \\\\ y & =\\frac{3}{2}x-\\frac{9}{2}+5 \\\\ y & =\\frac{3}{2}x+\\frac{1}{2}\\end{aligned}\n$$\n\nWe now find the point where the two lines intersect. To do this, we solve the following system of equations:\n\n$$\n{\\begin{aligned}y=-\\frac{2}{3}x+1 \\\\ y=\\frac{3}{2}x+\\frac{1}{2}\\end{aligned}\n$$\n\nWe can solve this system by putting the two equations equal to one another and solving for $x.$ This gives\n\n$$\n\\begin{aligned}-\\frac{2}{3}x+1 & =\\frac{3}{2}x+\\frac{1}{2} \\\\ -\\frac{2}{3}x-\\frac{3}{2}x & =\\frac{1}{2}-1 \\\\ -\\frac{13}{6}x & =-\\frac{1}{2} \\\\ x & =\\frac{3}{13}.\\end{aligned}\n$$\n\nSubstituting $x=\\frac{3}{13}$ into either of the two equations gives $y=\\frac{11}{13}.$ So, our solution is $x=\\frac{3}{13}$ and $y=\\frac{11}{13}.$ So, the lines intersect at the point $(\\frac{3}{13},\\frac{11}{13}).$\n\nTherefore, we conclude that the point on the line  $3y+2x=3$ that is closest to the point $(3,5)$ is  $(\\frac{3}{13},\\frac{11}{13}).$"}] [{:db/id #edb/ref 17592186054967 :knowledge-point/_questions [{:db/id #edb/ref 17592186054648 :knowledge-point/id #uuid "9a248b79-7e8b-5ad8-b2e8-847ac2030783" :knowledge-point/title "Adding Square Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a55f584c-0261-59b4-bb28-5df04c5e5bd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 6 \\\\ 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186051333} {:answer/id #uuid "df503ec5-393a-5e2d-b982-c56e35aaa181" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 2 \\\\ 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186051334} {:answer/id #uuid "03de6fb6-f81c-5d37-a647-7b5873b78089" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 5 \\\\ 5 & 5\\end{bmatrix}" :db/id #edb/ref 17592186051335} {:answer/id #uuid "423881fd-5f5f-52b5-95c3-bdb632772bba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 & 6 \\\\ 1 & -3\\end{bmatrix}" :db/id #edb/ref 17592186051336} {:answer/id #uuid "4cb4b1ee-1844-5475-bfe1-7abebf91b3b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 6 \\\\ 6 & 6\\end{bmatrix}" :db/id #edb/ref 17592186051337}] :answer-field/id #uuid "8876c980-9b7f-5aa5-b5a7-7c5722252f32" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186051332} {:answer-field/choices [{:answer/id #uuid "a6e60215-8077-5f8c-8c55-359a0a908320" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 2 \\\\ 1 & 3\\end{aligned}]" :db/id #edb/ref 17592186386738} {:answer/id #uuid "29d738c0-81db-5e6c-91c9-db679852e3b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-6 & 6 \\\\ 1 & -3\\end{aligned}]" :db/id #edb/ref 17592186386739} {:answer/id #uuid "20fa7a5b-5a7b-5d2e-91fe-afbafad3502d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & 6 \\\\ 6 & 6\\end{aligned}]" :db/id #edb/ref 17592186386740} {:answer/id #uuid "f1d7ca1e-94f6-54ec-80f6-9ab401480cbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & 6 \\\\ 1 & 3\\end{aligned}]" :db/id #edb/ref 17592186386741} {:answer/id #uuid "8751a674-6cb2-575b-98a1-e1863e33ff8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 5 \\\\ 5 & 5\\end{aligned}]" :db/id #edb/ref 17592186386742}] :answer-field/correct {:answer/id #uuid "f1d7ca1e-94f6-54ec-80f6-9ab401480cbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & 6 \\\\ 1 & 3\\end{aligned}]" :db/id #edb/ref 17592186386741} :answer-field/id #uuid "1ce63358-0fcc-55be-a22f-c3c4afd97cf2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386737}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "06528850-f3e1-5360-9392-bba2a3bf7deb" :question/math-academy-id "q-11440" :question/problem "Calculate $A+B$, where\n\n$$\nA=[\\begin{aligned}2 & 5 \\\\ 3 & 1\\end{aligned}],\\,B=[\\begin{aligned}4 & 1 \\\\ -2 & 2\\end{aligned}].\n$$" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}A+B & =[\\begin{aligned}2 & 5 \\\\ 3 & 1\\end{aligned}]+[\\begin{aligned}4 & 1 \\\\ -2 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2+4 & 5+1 \\\\ 3+(-2) & 1+2\\end{aligned}] \\\\  & =[\\begin{aligned}6 & 6 \\\\ 1 & 3\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250484 :knowledge-point/_questions [{:db/id #edb/ref 17592186068881 :knowledge-point/id #uuid "beab791b-0819-5768-9e5f-0dc621d5a462" :knowledge-point/title "Solving Rational Equations Containing Two Distinct Linear Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bbe6c94-b151-5c1d-9c24-6ac6eaedff7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186247527} {:answer/id #uuid "284a2d2d-aec2-56b2-a83a-447fe88b345e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186247782} {:answer/id #uuid "4bd2d177-bb80-5fbb-b4fb-239d54aa4023" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186248101} {:answer/id #uuid "9a88c5c8-97bc-5272-bbaa-7a0f74513dbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186248802} {:answer/id #uuid "bfeb1cf3-0a3b-5e0b-81f5-f88d8973a54f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186249129}] :answer-field/correct {:answer/id #uuid "0bbe6c94-b151-5c1d-9c24-6ac6eaedff7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186247527} :answer-field/id #uuid "929d68dd-7d98-50ea-b0e6-bb084af9ebee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249932}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0a05ffdc-3b52-5cee-9869-369fd44c61d1" :question/math-academy-id "q-115794" :question/problem "Which value of $z$ satisfies the equation $\\frac{2z-1}{6z}=\\frac{3z-1}{3z}+\\frac{z-1}{6z}?$" :question/worked-solution "We note that $z=0$ cannot be a solution since division by $0$ is undefined. \n\nThe equation has the denominators $3z$ and $6z.$ So first, we find the least common multiple (or $\\text{LCM}$) of the denominators. We find that\n\n$$\n\\text{LCM}(3z,6z)=6z.\n$$\n\nSo, we multiply both sides of the equation by $6z,$ and simplify: \n\n$$\n\\begin{aligned}\\frac{2z-1}{6z}=\\frac{3z-1}{3z}+\\frac{z-1}{6z} \\\\ 6z\\cdot (\\frac{2z-1}{6z}) & =6z\\cdot (\\frac{3z-1}{3z}+\\frac{z-1}{6z}) \\\\ 6z\\cdot (\\frac{2z-1}{6z}) & =6z\\cdot (\\frac{3z-1}{3z})+6z\\cdot (\\frac{z-1}{6z}) \\\\ \\cancel{6z}\\cdot (\\frac{2z-1}{\\cancel{6z}}) & =2\\cdot \\cancel{3z}\\cdot (\\frac{3z-1}{\\cancel{3z}})+\\cancel{6z}\\cdot (\\frac{z-1}{\\cancel{6z}}) \\\\ 2z-1 & =2\\cdot (3z-1)+z-1\\end{aligned}\n$$\n\nWe now have a linear equation in $z,$ and we can solve this using the addition and multiplication principles:\n\n$$\n\\begin{aligned}2z-1 & =2(3z-1)+z-1 \\\\ 2z-1 & =6z-2+z-1 \\\\ 2z-1 & =7z-3 \\\\ 2z-7z & =-3+1 \\\\ -5z & =-2 \\\\ z & =\\frac{2}{5}\\end{aligned}\n$$\n\nFinally, we recall that we cannot allow $z=0$ as a solution. But since $z=\\frac{2}{5}\\ne 0,$ we conclude that the solution is $z=\\frac{2}{5}.$"}] [{:db/id #edb/ref 17592186250526 :knowledge-point/_questions [{:db/id #edb/ref 17592186083298 :knowledge-point/id #uuid "cdab0134-e416-51cf-89fa-73ad4a2c2eb9" :knowledge-point/title "Finding the Center of a Vertical Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12d15b2a-d840-5012-b070-e3462c9da9d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(36,16)" :db/id #edb/ref 17592186247594} {:answer/id #uuid "247c9c2b-5862-5eab-b7d6-5bc4e81f7699" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,6)" :db/id #edb/ref 17592186247743} {:answer/id #uuid "a0c70e60-f026-55b3-9d72-4a1fbcbe300c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(16,36)" :db/id #edb/ref 17592186248861} {:answer/id #uuid "dd02f9e6-3fef-5510-9fef-c8504811fe08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,-6)" :db/id #edb/ref 17592186249383} {:answer/id #uuid "e539cb36-7d2c-587b-a892-73405cb109ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-6,-4)" :db/id #edb/ref 17592186249442}] :answer-field/correct {:answer/id #uuid "e539cb36-7d2c-587b-a892-73405cb109ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-6,-4)" :db/id #edb/ref 17592186249442} :answer-field/id #uuid "667ba501-b342-5000-bcdf-f4159e0d68ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249850}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b2a54ae2-f488-56eb-9b24-9f9d28627e54" :question/math-academy-id "q-116103" :question/problem "What is the center of the hyperbola $\\frac{(y+4)^{2}}{16}-\\frac{(x+6)^{2}}{36}=1?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nNote that the given equation can be rewritten as follows:\n\n$$\n\\frac{(y-(-4))^{2}}{{4}^{2}}-\\frac{(x-(-6))^{2}}{{6}^{2}}=1\n$$\n\nIn this case, we have $h=-6$ and $k=-4.$\n\nTherefore, the center of the hyperbola is $(-6,-4).$"}] [{:db/id #edb/ref 17592186250527 :knowledge-point/_questions [{:db/id #edb/ref 17592186068883 :knowledge-point/id #uuid "9c698912-1f35-5110-8d5d-d490cce2e9a7" :knowledge-point/title "Solving Rational Equations Containing Quadratic Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0237b559-7d33-5cd0-9da8-8d8b205f4742" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186247438} {:answer/id #uuid "1fb99e31-a544-5220-80a8-c1892b899c64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186247705} {:answer/id #uuid "cac77d12-ae34-5ddd-8afb-806b1d42068b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186249230} {:answer/id #uuid "d2d99394-c6b7-5118-9b32-40e3e577b39d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186249294} {:answer/id #uuid "fc368912-431d-5c1c-94c8-d1e252061d60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186249623}] :answer-field/correct {:answer/id #uuid "d2d99394-c6b7-5118-9b32-40e3e577b39d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186249294} :answer-field/id #uuid "05de44ca-2588-5951-97b7-06f8b0b05597" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249677}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0f403d57-f6d2-5901-9ad6-4def1edb7127" :question/math-academy-id "q-116104" :question/problem "Which value of $x$ satisfies the equation $\\frac{3x-1}{{x}^{2}}=\\frac{2}{x}-\\frac{x-3}{{x}^{2}}?$" :question/worked-solution "We note that $x=0$ cannot be a solution since division by $0$ is undefined. \n\nThe equation has the denominators $x$ and ${x}^{2}.$ So first, we find the least common multiple (or $\\text{LCM}$) of the denominators. We find that\n\n$$\n\\text{LCM}(x,{x}^{2})={x}^{2}.\n$$\n\nSo, we multiply both sides of the equation by ${x}^{2},$ and simplify: \n\n$$\n\\begin{aligned}\\frac{3x-1}{{x}^{2}}=\\frac{2}{x}-\\frac{x-3}{{x}^{2}} \\\\ {x}^{2}\\cdot (\\frac{3x-1}{{x}^{2}}) & ={x}^{2}\\cdot (\\frac{2}{x}-\\frac{x-3}{{x}^{2}}) \\\\ {x}^{2}\\cdot (\\frac{3x-1}{{x}^{2}}) & ={x}^{2}\\cdot (\\frac{2}{x})-{x}^{2}\\cdot (\\frac{x-3}{{x}^{2}}) \\\\ \\cancel{{x}^{2}}\\cdot (\\frac{3x-1}{\\cancel{{x}^{2}}}) & =x\\cdot \\cancel{x}\\cdot (\\frac{2}{\\cancel{x}})-\\cancel{{x}^{2}}\\cdot (\\frac{x-3}{\\cancel{{x}^{2}}}) \\\\ (3x-1) & =x\\cdot 2-(x-3) \\\\ (3x-1) & =2x-(x-3)\\end{aligned}\n$$\n\nWe now have a linear equation in $x,$ and we can solve this using the addition and multiplication principles:\n\n$$\n\\begin{aligned}(3x-1) & =2x-(x-3) \\\\ 3x-1 & =2x-x+3 \\\\ 3x-1 & =x+3 \\\\ 3x-x & =3+1 \\\\ 2x & =4 \\\\ x & =2\\end{aligned}\n$$\n\nFinally, we recall that we cannot allow $x=0$ as a solution. But since $x=2\\ne 0,$ we conclude that the solution is $x=2.$"}] [{:db/id #edb/ref 17592186399961 :knowledge-point/_questions [{:db/id #edb/ref 17592186105871 :knowledge-point/id #uuid "6445834c-7788-5427-a72c-30b06cc8e6ab" :knowledge-point/title "Calculating the Area of an Isosceles Right Triangle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e208d2b-dec6-562a-a378-e1098ccc8637" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "113" :db/id #edb/ref 17592186399963} {:answer/id #uuid "95086ebb-7581-57b3-a760-1b80ee3581dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186399964} {:answer/id #uuid "d51ba212-184c-5759-8461-dffee9f36c0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "72.5" :db/id #edb/ref 17592186399965} {:answer/id #uuid "6365eea9-1bba-56eb-bc53-b9734f86d4ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "84.5" :db/id #edb/ref 17592186399966} {:answer/id #uuid "d5f4da11-8df3-5c32-9ef0-645590937087" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "169" :db/id #edb/ref 17592186399967}] :answer-field/correct {:answer/id #uuid "6365eea9-1bba-56eb-bc53-b9734f86d4ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "84.5" :db/id #edb/ref 17592186399966} :answer-field/id #uuid "564afc56-93e1-5116-bc1b-3a39fadf5bbd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399962}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3b82680f-f801-5d98-98f5-3b30c67dd0ca" :question/math-academy-id "q-117347" :question/problem "![](images/4a/4aa952124ddaaa1dc2a54ebb4601255ae42346a9e02f02391c05453a81542505.png)\n\nWhat is the area of the right triangle $ABC$ shown above?" :question/worked-solution "Since $m∠A=m∠C={45}^{∘}$ and $AB=BC,$ we have an isosceles right triangle. \n\n![](images/67/670afdec3633984b2fb493706e762740062348ccbdd0f56df14e3add3d4bbd23.png)\n\nTherefore, the area of the triangle is\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}AB\\cdot BC \\\\  & =\\frac{1}{2}\\cdot {13}^{2} \\\\  & =\\frac{1}{2}\\cdot 169 \\\\  & =84.5\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253334 :knowledge-point/_questions [{:db/id #edb/ref 17592186096612 :knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3232bdcf-d781-5e59-bb5b-56c10f0d7fa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10{x}^{2}+6x" :db/id #edb/ref 17592186250976} {:answer/id #uuid "37865371-b061-54aa-9810-81e59d0b835b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}-10{x}^{2}+6x-19" :db/id #edb/ref 17592186251009} {:answer/id #uuid "3d09661f-ce26-5e19-a8b8-2ae50263662e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10x+6" :db/id #edb/ref 17592186251060 :task-item/_responses [{:db/id #edb/ref 17592186409262}]} {:answer/id #uuid "9007950f-ce55-5f0c-a1f6-d3963f0294f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}-10x+6" :db/id #edb/ref 17592186251775} {:answer/id #uuid "bbf32e0c-8341-5060-b67e-c44870ab4cd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10{x}^{2}+6x-19" :db/id #edb/ref 17592186252214}] :answer-field/correct {:answer/id #uuid "3d09661f-ce26-5e19-a8b8-2ae50263662e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10x+6" :db/id #edb/ref 17592186251060} :answer-field/id #uuid "e849ca6e-9bda-5244-a669-0f22826facaa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253210}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "50678a5c-afcb-522f-98fb-80e9680afca6" :question/math-academy-id "q-11735" :question/problem "Given that $f(x)={6}^{x}-5{x}^{2}+6x-19$, find ${f}^{′}(x).$" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({6}^{x}-5{x}^{2}+6x-19) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})-\\frac{\\text{d}}{\\text{d}x}(5{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(6x)-\\frac{\\text{d}}{\\text{d}x}(19) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})-5\\frac{\\text{d}}{\\text{d}x}({x}^{2})+6\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(19) \\\\  & =ln⁡6\\cdot {6}^{x}-5(2x)+6(1)-0 \\\\  & ={6}^{x}ln⁡6-10x+6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386869 :knowledge-point/_questions [{:db/id #edb/ref 17592186105872 :knowledge-point/id #uuid "a7656d23-06c9-5d22-b62a-3636bca66ab6" :knowledge-point/title "Finding the Base or the Height of a Triangle Given Its Area"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85c1f01f-96af-5f7c-96aa-279c3ec7396b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11\\,\\text{m}" :db/id #edb/ref 17592186386871} {:answer/id #uuid "2997f072-b449-5713-9807-6a5f2600c14b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\,\\text{m}" :db/id #edb/ref 17592186386872} {:answer/id #uuid "8fb6c5c4-f4a0-508f-836c-123e77528fc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\text{m}" :db/id #edb/ref 17592186386873} {:answer/id #uuid "1fee1997-ce6c-5947-a48e-604fe553cb79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,\\text{m}" :db/id #edb/ref 17592186386874} {:answer/id #uuid "f0514960-ea4a-54b8-90e9-aaff6e94282c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16\\,\\text{m}" :db/id #edb/ref 17592186386875}] :answer-field/correct {:answer/id #uuid "8fb6c5c4-f4a0-508f-836c-123e77528fc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\text{m}" :db/id #edb/ref 17592186386873} :answer-field/id #uuid "a7d95cca-e9e0-5148-9e42-b90b4a803ca8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386870}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4303d1bd-0440-58eb-a5d5-e6551f7a6e46" :question/math-academy-id "q-117356" :question/problem "![](images/10/10b6f63df56c789d0d28cd14caad0a2588e247ba4a60239f4cb0dd5a32777daf.png)\n\nFind $AM$ given that the area of $△ABC$ is $64\\,{m}^{2},$ $MC=11\\,m,$ and $BM=8\\,m.$}\n\n(Figure not drawn to scale)" :question/worked-solution "The area of the triangle is defined as \n\n$$\nA=\\frac{b\\cdot h}{2},\n$$\n\n where $b$ is a base and $h$ is the corresponding height.\n\nFrom the diagram, we see that the base is $b=AC,$ and the corresponding height is \n\n$$\nh=BM=8\\,m.\n$$\n\nTherefore, using the formula for the area, we can solve for the base as follows:\n\n$$\n\\begin{aligned}A & =\\frac{b\\cdot h}{2} \\\\ 64 & =\\frac{b\\cdot 8}{2} \\\\ 128 & =b\\cdot 8 \\\\ b & =\\frac{128}{8} \\\\ b & =16\\,m\\end{aligned}\n$$\n\nAs a result, $AC=16\\,m$ and hence, we have\n\n$$\nAM=AC-MC=16-11=5\\,\\text{m}.\n$$"}] [{:db/id #edb/ref 17592186253366 :knowledge-point/_questions [{:db/id #edb/ref 17592186129121 :knowledge-point/id #uuid "7f8fa2b3-ccaa-5390-89fa-03e338cf8690" :knowledge-point/title "Determining the Amplitude of a Transformed Sinusoidal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42d9acc7-d7bc-5ee0-a5fe-5e4dd49f1b24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186251112} {:answer/id #uuid "62a72008-6a6e-556c-809d-015ca2b2740f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186251358} {:answer/id #uuid "d1881db5-b1bc-59b9-9956-32e11311533c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186252402} {:answer/id #uuid "f784db78-b2a6-5828-92f9-43c51bb6371d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186252716} {:answer/id #uuid "fdfe367d-16eb-5c43-87a8-b57680a82f9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186252780}] :answer-field/correct {:answer/id #uuid "f784db78-b2a6-5828-92f9-43c51bb6371d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186252716} :answer-field/id #uuid "e24beebb-313f-5175-ae17-e942cb6940f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253192}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1489edd6-f3f4-5ab1-9410-746b5fd6547f" :question/math-academy-id "q-117570" :question/problem "What is the amplitude of the function $f(x)=4\\operatorname{cos}⁡(2x+3)?$" :question/worked-solution "Given a function in the form $f(x)=A\\operatorname{cos}⁡(Bx+C)+D,$ the amplitude is $|A|.$\n\nSince $A=4,$ we have that the amplitude is $|A|=|4|=4.$"}] [{:db/id #edb/ref 17592186253369 :knowledge-point/_questions [{:db/id #edb/ref 17592186129122 :knowledge-point/id #uuid "1eeb42af-74ee-53d7-af9f-be171f77968f" :knowledge-point/title "Calculating the Period of a Transformed Sinusoidal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4161544d-5503-509c-a919-47b75546d693" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{2}" :db/id #edb/ref 17592186251094} {:answer/id #uuid "ab0b8f2d-8bf9-5548-96dd-fe899f5d298f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\pi }{3}" :db/id #edb/ref 17592186252036} {:answer/id #uuid "ba23df8f-a679-5d5c-bde8-2b7238d24224" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186252191} {:answer/id #uuid "c9834705-9dcd-5c24-afb6-f095959807d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8\\pi }{3}" :db/id #edb/ref 17592186252335} {:answer/id #uuid "f25fe0b5-3a2d-5c1e-b5a3-425fbf7a30c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186252674}] :answer-field/correct {:answer/id #uuid "c9834705-9dcd-5c24-afb6-f095959807d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8\\pi }{3}" :db/id #edb/ref 17592186252335} :answer-field/id #uuid "918ffa31-2155-56a2-9928-59d9d880148e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253057}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "53685d44-d788-5019-bc63-97c441bd2453" :question/math-academy-id "q-117578" :question/problem "What is the period of the function $f(x)=-3\\operatorname{sin}⁡(\\frac{3x}{4}+\\frac{\\pi }{3})?$" :question/worked-solution "Given a function in the form $y=A\\operatorname{sin}⁡(Bx+C)+D,$ the period is $\\frac{2\\pi }{B}.$\n\nIn our case, we have that $B=\\frac{3}{4}.$ Therefore, the period is $\\frac{2\\pi }{(\\frac{3}{4})}=\\frac{8\\pi }{3}.$"}] [{:db/id #edb/ref 17592186253372 :knowledge-point/_questions [{:db/id #edb/ref 17592186203961 :knowledge-point/id #uuid "58c7cd44-30a9-5f61-822c-13640ad41c93" :knowledge-point/title "Finding the Zeros of a Transformed Sine or Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d740ebb-367e-5b13-abb3-4aaa7aaffcc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{6}+\\frac{n\\pi }{2}" :db/id #edb/ref 17592186251327} {:answer/id #uuid "76a2175d-f7a4-5539-8d5c-3821bd16c125" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{12}+\\frac{n\\pi }{6}" :db/id #edb/ref 17592186251531} {:answer/id #uuid "a02621c3-5f65-5847-b218-aabe23216fce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{6}+\\frac{n\\pi }{3}" :db/id #edb/ref 17592186251935} {:answer/id #uuid "cce190ce-0319-5382-a9e1-b39ca5b6c857" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{12}+\\frac{n\\pi }{3}" :db/id #edb/ref 17592186252359} {:answer/id #uuid "e26fda5d-8dbd-578f-ba57-15366c54f032" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{12}+\\frac{n\\pi }{4}" :db/id #edb/ref 17592186252543}] :answer-field/correct {:answer/id #uuid "cce190ce-0319-5382-a9e1-b39ca5b6c857" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{12}+\\frac{n\\pi }{3}" :db/id #edb/ref 17592186252359} :answer-field/id #uuid "b25237fb-1e27-5e8c-8801-00721dc99e4b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253115}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e6c40bb9-f96b-5776-9878-956cda7f4ab8" :question/math-academy-id "q-117602" :question/problem "Which expression gives all of the zeros of $y=\\operatorname{sin}⁡(3x-\\frac{\\pi }{4})?$  Assume that $n$ is an integer." :question/worked-solution "First, let's start by defining a new variable $X$ as\n\n$$\nX=3x-\\frac{\\pi }{4}.\n$$\n\nSo, we need to calculate the zeros of \n\n$$\ny=\\operatorname{sin}⁡X.\n$$\n\nThe zeros of this function are given by the following expression:\n\n$$\nX=n\\pi \n$$\n\nwhere $n$ is an integer.\n\nTo find the zeros of our original function, we rewrite $X$ in terms of the original variable $x$ and solve the resulting equation for $x:$\n\n$$\n\\begin{aligned}X & =n\\pi  \\\\ 3x-\\frac{\\pi }{4} & =n\\pi  \\\\ 3x & =\\frac{\\pi }{4}+n\\pi  \\\\ x & =\\frac{\\pi }{12}+\\frac{n\\pi }{3}\\end{aligned}\n$$\n\nTherefore, we conclude that the zeros are $x=\\frac{\\pi }{12}+\\frac{n\\pi }{3},$ where $n$ is any integer."}] [{:db/id #edb/ref 17592186253374 :knowledge-point/_questions [{:db/id #edb/ref 17592186203963 :knowledge-point/id #uuid "75e981a4-ba75-5db2-81ab-b321953cc225" :knowledge-point/title "Minima of Transformed Sine or Cosine Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a6315d9-4c5b-52e3-98df-900d3c444852" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{10}+\\frac{n\\pi }{5}" :db/id #edb/ref 17592186250644} {:answer/id #uuid "50caab44-146e-5114-bb63-a98abf44bbf0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{5}+\\frac{n\\pi }{5}" :db/id #edb/ref 17592186251216} {:answer/id #uuid "7d8a89f1-cd1e-5d53-97df-4d4822adf932" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\pi }{5}+\\frac{2n\\pi }{5}" :db/id #edb/ref 17592186251602} {:answer/id #uuid "8cef8dea-f51e-5b0b-821f-4305afcb5ffc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{2\\pi }{5}+\\frac{2n\\pi }{5}" :db/id #edb/ref 17592186251744} {:answer/id #uuid "a7938484-56c7-5ea3-8eac-d9b734d000ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\pi }{10}+2n\\pi " :db/id #edb/ref 17592186251997}] :answer-field/correct {:answer/id #uuid "7d8a89f1-cd1e-5d53-97df-4d4822adf932" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\pi }{5}+\\frac{2n\\pi }{5}" :db/id #edb/ref 17592186251602} :answer-field/id #uuid "f788a829-1171-5925-a3c0-50bd4a554edb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253243}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "21457735-cc06-5dc4-85da-719f77cfb1e9" :question/math-academy-id "q-117609" :question/problem "Consider the function $f(x)=3\\operatorname{sin}⁡(5x+\\frac{\\pi }{2}).$ Which expression gives all of the values of $x$ at which $f(x)$ attains its minimum value? Assume that $n$ is an integer." :question/worked-solution "First, let's start by defining a new variable $X$ as\n\n$$\nX=5x+\\frac{\\pi }{2}.\n$$\n\nSo, we need to calculate $X$-values at the minima of\n\n$$\nf(x)=3\\operatorname{sin}⁡X.\n$$\n\nThe $X$-values at the minima are given by the following expression:\n\n$$\nX=-\\frac{\\pi }{2}+2n\\pi \n$$\n\nwhere $n$ is an integer.\n\nTo find the $x$-values at the minima of our original function, we rewrite $X$ in terms of the original variable $x$ and solve the resulting equation for $x:$\n\n$$\n\\begin{aligned}X & =-\\frac{\\pi }{2}+2n\\pi  \\\\ 5x+\\frac{\\pi }{2} & =-\\frac{\\pi }{2}+2n\\pi  \\\\ 5x & =-\\pi +2n\\pi  \\\\ x & =-\\frac{\\pi }{5}+\\frac{2n\\pi }{5}\\end{aligned}\n$$\n\nWe conclude that the values of $x$ that minimize $f(x)$ are given by $x=-\\frac{\\pi }{5}+\\frac{2n\\pi }{5},$ where $n$ is any integer."}] [{:db/id #edb/ref 17592186253384 :knowledge-point/_questions [{:db/id #edb/ref 17592186129099 :knowledge-point/id #uuid "6506f7e3-4c69-5352-a09d-262adee65e59" :knowledge-point/title "Determining the Period of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a24ca73-da2f-5891-880a-ef75f6b9593c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186250779} {:answer/id #uuid "7150f51b-e3ac-5d81-a7f7-48ee5bc0bba5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\pi " :db/id #edb/ref 17592186251481} {:answer/id #uuid "78cfaed6-e561-54a3-bf1b-803861939fec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186251555} {:answer/id #uuid "8a4ab11c-2641-522c-977a-0adc46be731f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\pi " :db/id #edb/ref 17592186251718} {:answer/id #uuid "f94e9a48-ac9c-5839-8dce-557d1258a588" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186252735}] :answer-field/correct {:answer/id #uuid "1a24ca73-da2f-5891-880a-ef75f6b9593c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186250779} :answer-field/id #uuid "adab447b-5cdd-5271-ba5a-532032cbadc6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253107}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7daa9d90-3598-5b04-bfa2-8fabe3b59b76" :question/math-academy-id "q-117659" :question/problem "Calculate the period of the function $f(x)=\\operatorname{tan}⁡(3x)+6.$" :question/worked-solution "Given a function of the form $y=A\\operatorname{tan}⁡(Bx+C)+D,$ the period is $\\frac{\\pi }{B}.$\n\nIn our case, we have that $B=3.$ Therefore, the period is $\\frac{\\pi }{3}.$"}] [{:db/id #edb/ref 17592186253386 :knowledge-point/_questions [{:db/id #edb/ref 17592186129099 :knowledge-point/id #uuid "6506f7e3-4c69-5352-a09d-262adee65e59" :knowledge-point/title "Determining the Period of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2430686f-6354-5ae3-a56a-86797016a196" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186250867} {:answer/id #uuid "84c30401-b464-5d98-8a9b-267f533cca26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\pi " :db/id #edb/ref 17592186251667} {:answer/id #uuid "97869399-0a57-5928-b446-b55279c01911" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186251853} {:answer/id #uuid "a5606c09-671a-5dc4-abd2-15172f36984e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186251979} {:answer/id #uuid "ab67f75e-df9d-5d97-89f6-287ab3d2483f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{8}" :db/id #edb/ref 17592186252038}] :answer-field/correct {:answer/id #uuid "97869399-0a57-5928-b446-b55279c01911" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186251853} :answer-field/id #uuid "5f5b3662-7c4a-554a-a3fa-0abb3a6d9754" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252975}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dc8f3fd2-a7ad-59ae-81ee-947a33e17f52" :question/math-academy-id "q-117661" :question/problem "Calculate the period of the function $f(x)=-3\\operatorname{tan}⁡(\\frac{8x-\\pi }{4}).$" :question/worked-solution "Given a function of the form $y=A\\operatorname{tan}⁡(Bx+C)+D,$ the period is $\\frac{\\pi }{B}.$\n\nIn our case, we have that\n\n$$\nf(x)=-3\\operatorname{tan}⁡(\\frac{8x-\\pi }{4})=-3\\operatorname{tan}⁡(2x-\\frac{\\pi }{4}).\n$$\n\nTherefore, $B=2,$ and so the period is $\\frac{\\pi }{2}.$"}] [{:db/id #edb/ref 17592186253398 :knowledge-point/_questions [{:db/id #edb/ref 17592186129101 :knowledge-point/id #uuid "8854eaba-96c7-5ea8-a071-7ff7c954f943" :knowledge-point/title "Finding a General Expression for the Asymptotes of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "192cc94d-2bdc-5aa5-8395-3038aa3ee599" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{8}+\\frac{n\\pi }{8}" :db/id #edb/ref 17592186250773} {:answer/id #uuid "4831ea5f-e09b-527b-af85-515fffa0b3b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{16}+\\frac{n\\pi }{16}" :db/id #edb/ref 17592186251154} {:answer/id #uuid "5214d5d3-d621-543f-8d56-e6f7af5a61c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{4}+\\frac{n\\pi }{4}" :db/id #edb/ref 17592186251225} {:answer/id #uuid "65c18de8-50f1-510b-be3e-67e3e14593c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{16}+\\frac{n\\pi }{4}" :db/id #edb/ref 17592186251389} {:answer/id #uuid "9ee22af7-fed1-5570-8b02-e7f32f959eaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{4}+\\frac{n\\pi }{8}" :db/id #edb/ref 17592186251923}] :answer-field/correct {:answer/id #uuid "65c18de8-50f1-510b-be3e-67e3e14593c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{16}+\\frac{n\\pi }{4}" :db/id #edb/ref 17592186251389} :answer-field/id #uuid "9c602f0c-b42d-53d5-bc8e-aa3b17f2cc1f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253080}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1a30a0cb-a192-58f4-b341-cb115dd8b12f" :question/math-academy-id "q-117698" :question/problem "Which of the following expressions gives all of the vertical asymptotes of the function $f(x)=\\operatorname{tan}⁡(4x+\\frac{\\pi }{4})?$ Assume that $n$ is an integer." :question/worked-solution "The asymptotes of $y=\\operatorname{tan}⁡x$ are given by the expression\n\n$$\nx=\\frac{\\pi }{2}+n\\pi ,\n$$\n\nwhere $n$ is an integer.\n\nTo find the asymptotes of $\\operatorname{tan}⁡(4x+\\frac{\\pi }{4}),$ we replace the $x$ on the left-hand side of the above with $(4x+\\frac{\\pi }{4}).$ This gives\n\n$$\n4x+\\frac{\\pi }{4}=\\frac{\\pi }{2}+n\\pi .\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}4x+\\frac{\\pi }{4} & =\\frac{\\pi }{2}+n\\pi  \\\\ 4x & =\\frac{\\pi }{2}+n\\pi -\\frac{\\pi }{4} \\\\ 4x & =\\frac{\\pi }{4}+n\\pi  \\\\ x & =\\frac{\\pi }{16}+\\frac{n\\pi }{4}.\\end{aligned}\n$$\n\nTherefore, we conclude that the expression giving all the vertical asymptotes is $x=\\frac{\\pi }{16}+\\frac{n\\pi }{4},$ where $n$ is an integer."}] [{:db/id #edb/ref 17592186253410 :knowledge-point/_questions [{:db/id #edb/ref 17592186083152 :knowledge-point/id #uuid "0b19d6e0-8a12-525d-8c80-ac2de8080830" :knowledge-point/title "The Period of a Transformed Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2935cc2d-27c9-58b3-96a6-79c8386f3a29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186250904} {:answer/id #uuid "54137cf8-14cc-55d2-a3b0-586abb911a1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\pi " :db/id #edb/ref 17592186251241} {:answer/id #uuid "80c578dc-923e-50b4-8174-f24b0bd436b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186251638} {:answer/id #uuid "92a04e97-de9c-5fe7-b1bc-3c133f09c650" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\pi " :db/id #edb/ref 17592186251808} {:answer/id #uuid "a1ed5eb0-3633-589d-acca-01d3eccf8929" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{12}" :db/id #edb/ref 17592186251948}] :answer-field/correct {:answer/id #uuid "92a04e97-de9c-5fe7-b1bc-3c133f09c650" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\pi " :db/id #edb/ref 17592186251808} :answer-field/id #uuid "27623253-c44d-540a-b82d-ad67ac207865" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252877}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b44fb065-7fc5-53f5-aa2b-171c7b74a7ad" :question/math-academy-id "q-117752" :question/problem "Calculate the period of the function $y=-5\\operatorname{csc}⁡(\\frac{x}{6}-\\frac{\\pi }{4}).$" :question/worked-solution "Given a function of the form $y=A\\operatorname{csc}⁡(Bx+C)+D,$ the period is $\\frac{2\\pi }{B}.$\n\nIn our case, we have that $B=\\frac{1}{6}.$ Therefore, the period is $\\frac{2\\pi }{(\\frac{1}{6})}=12\\pi .$"}] [{:db/id #edb/ref 17592186398165 :knowledge-point/_questions [{:db/id #edb/ref 17592186184236 :knowledge-point/id #uuid "af228cc4-8be2-5c16-8537-4e5dab4e2ff4" :knowledge-point/title "Identifying the Horizontal Stretch and Vertical Shift of a Transformed Tangent Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34eca68d-7384-5ac4-aae3-9fd3ad9100c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186398167} {:answer/id #uuid "ebf81549-b73c-5aa8-ae6f-2eb529e3d650" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186398168} {:answer/id #uuid "4b365ba9-edc9-5d4f-9d0c-a4e1280cad8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186398169} {:answer/id #uuid "95065041-df6a-55e2-ba59-eb39e1ef3c42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186398170} {:answer/id #uuid "4041d9b8-a50e-5114-a489-9911977efeb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186398171}] :answer-field/correct {:answer/id #uuid "ebf81549-b73c-5aa8-ae6f-2eb529e3d650" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186398168} :answer-field/id #uuid "b20222d5-4d8b-5ef3-b5e6-cdd257fd9b17" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398166}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5ecbe368-922d-5a9f-956d-5a27886e10df" :question/math-academy-id "q-117796" :question/problem "![](images/92/9278723975d70fec73e313d0e164908ddd339231cb74f75b07c2edce14680111.png)\n\nThe graph above shows the function $y=\\operatorname{tan}⁡(Bx)+D,$ where $B$ and $D$ are constants. What is $B+D?$" :question/worked-solution "The period $T$ of the function is\n\n$$\nT=\\frac{2\\pi }{5}-(-\\frac{2\\pi }{5})=\\frac{4\\pi }{5}.\n$$\n\nThe formula for the period $T$ of the function $y=A\\operatorname{tan}⁡(Bx+C)+D$ is given by \n\n$$\nT=\\frac{\\pi }{B}.\n$$\n\nApplying the formula of the period, we get\n\n$$\n\\frac{4\\pi }{5}=\\frac{\\pi }{B}\\,⟹\\,B=\\frac{\\pi }{(\\frac{4\\pi }{5})}=\\frac{5}{4}.\n$$\n\nThe parameter $D$ represents the vertical shift of the tangent function. We see that the function has been translated by $\\frac{1}{2}$ unit up. Hence, $D=\\frac{1}{2}.$\n\nTherefore, $B+D=\\frac{5}{4}+\\frac{1}{2}=\\frac{7}{4}.$\n\nFinally, the equation of the curve is\n\n$$\ny=\\operatorname{tan}⁡(\\frac{5x}{4})+\\frac{1}{2}.\n$$"}] [{:db/id #edb/ref 17592186253417 :knowledge-point/_questions [{:db/id #edb/ref 17592186083155 :knowledge-point/id #uuid "5085a30f-a347-5ba8-80fd-102e4e0f37ce" :knowledge-point/title "Finding Local Extrema of a Transformed Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08ef0ad4-504c-5ff5-b6b1-d2d3e980875f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186250635} {:answer/id #uuid "298bec1a-ff16-5540-a476-6b3fca320aa8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186250908} {:answer/id #uuid "2dc5b675-6831-54be-906b-a9a1b71d2899" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186250944} {:answer/id #uuid "885e749a-e263-5b04-8671-ccd884576931" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186251703} {:answer/id #uuid "a365c952-0f98-5c32-87e5-0e635c62c1d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186251962}] :answer-field/correct {:answer/id #uuid "2dc5b675-6831-54be-906b-a9a1b71d2899" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186250944} :answer-field/id #uuid "94db1709-d36e-5a1b-b01a-c474544f7620" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253067}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "97fbbd90-72d5-5259-afd8-7a25639443c6" :question/math-academy-id "q-117805" :question/problem "What is the value of $f(x)=4\\operatorname{sec}⁡(x-\\frac{\\pi }{4})+1$ at its local maximum points?" :question/worked-solution "On a negative branch of the graph of $y=\\operatorname{sec}⁡x,$ we have\n\n$$\n\\operatorname{sec}⁡x\\le -1.\n$$\n\nThe points where $\\operatorname{sec}⁡x=-1$ are local maximums of the graph of $y=\\operatorname{sec}⁡x.$ \n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n\\operatorname{sec}⁡(x-\\frac{\\pi }{4})\\le -1.\n$$\n\nMultiplying the above inequality by $4$ and adding $1$, we get\n\n$$\n\\begin{aligned} & \\operatorname{sec}⁡(x-\\frac{\\pi }{4})\\le -1 \\\\  & 4\\operatorname{sec}⁡(x-\\frac{\\pi }{4})\\le -4 \\\\  & 4\\operatorname{sec}⁡(x-\\frac{\\pi }{4})+1\\le -4+1 \\\\  & f(x)\\le -3.\\end{aligned}\n$$\n\nTherefore, $f(x)=-3$ at the local maximum points."}] [{:db/id #edb/ref 17592186253456 :knowledge-point/_questions [{:db/id #edb/ref 17592186083241 :knowledge-point/id #uuid "89dc22a6-dd98-544c-8232-5043fac2bd3d" :knowledge-point/title "Solving a Rational Equations by Factoring a Quadratic Denominator With No Constant Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18683fc1-6e6f-552f-b3d8-1a598e647afe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "d=\\frac{3}{2}" :db/id #edb/ref 17592186250768} {:answer/id #uuid "afd8104c-d61b-5874-bc43-96a15275c763" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "d=-2" :db/id #edb/ref 17592186252087} {:answer/id #uuid "b3372c5e-1b3d-526f-a2ff-bdb9fc2ba5f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "d=5" :db/id #edb/ref 17592186252121} {:answer/id #uuid "c7189c96-8126-52ba-9ab5-81ef9869fbe6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No solutions" :db/id #edb/ref 17592186252312} {:answer/id #uuid "db77b71c-5ce2-5ae9-9c3c-53b2ac47a7d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "d=4" :db/id #edb/ref 17592186252480}] :answer-field/correct {:answer/id #uuid "c7189c96-8126-52ba-9ab5-81ef9869fbe6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No solutions" :db/id #edb/ref 17592186252312} :answer-field/id #uuid "485e4678-0882-55ac-8cb1-e26d4e0dafbf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252933}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8477c0d3-7e97-5832-b4f8-9e356450f509" :question/math-academy-id "q-118114" :question/problem "Solve the equation $\\frac{4}{d}+\\frac{6}{{d}^{2}-3d}=\\frac{2}{d-3}.$" :question/worked-solution "First, we factor the quadratic denominator, giving us the equation\n\n$$\n\\frac{4}{d}+\\frac{6}{d(d-3)}=\\frac{2}{d-3}.\n$$\n\nWe now make the following observations:\n\n- The least common denominator of our equation is given by\n\n$$\n\\text{LCM}(d,\\,d(d-3),\\,d-3)=d(d-3).\n$$\n\n- The values $d=0$ and $d=3$ cannot be solutions to our equation. These values make at least one denominator in our original equation equal zero, and division by zero is undefined.\n\nNow, multiplying both sides of the equation by the least common denominator, we can simplify it as follows:\n\n$$\n\\begin{aligned}\\frac{4}{d}+\\frac{6}{d(d-3)} & =\\frac{2}{d-3} \\\\ d(d-3)\\cdot (\\frac{4}{d}+\\frac{6}{d(d-3)}) & =d(d-3)\\cdot \\frac{2}{d-3} \\\\ \\frac{4d(d-3)}{d}+\\frac{6d(d-3)}{d(d-3)} & =\\frac{2d(d-3)}{d-3} \\\\ \\frac{4\\cdot \\cancel{d}\\cdot (d-3)}{\\cancel{d}}+\\frac{6\\cdot \\cancel{d(d-3)}}{\\cancel{d(d-3)}} & =\\frac{2d\\cdot \\cancel{(d-3)}}{\\cancel{d-3}} \\\\ 4(d-3)+6 & =2d\\end{aligned}\n$$\n\nSolving this equation for $d,$ we get the following:\n\n$$\n\\begin{aligned}4(d-3)+6 & =2d \\\\ 4d-6 & =2d \\\\ 2d & =6 \\\\ d & =3\\end{aligned}\n$$\n\nHowever, since $d=3$  is not a valid solution, our equation has no solutions."}] [{:db/id #edb/ref 17592186253467 :knowledge-point/_questions [{:db/id #edb/ref 17592186096845 :knowledge-point/id #uuid "1c269944-636a-50f2-bfc9-c32a7b2e7ca3" :knowledge-point/title "Calculating a Derivative Using the Chain and Product Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46092d6a-5809-530b-96aa-d18ca741a149" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(9x+1){e}^{9x}" :db/id #edb/ref 17592186251132} {:answer/id #uuid "9449d2c4-40c8-5886-a8f8-d377e92abd71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(9x+10){e}^{9x}" :db/id #edb/ref 17592186251828} {:answer/id #uuid "9fcc1d83-99af-5f5a-b373-703da0e18e92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+1){e}^{9x}" :db/id #edb/ref 17592186251929} {:answer/id #uuid "a8022752-cd20-552c-942e-08b64f288227" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9x{e}^{9x}" :db/id #edb/ref 17592186252002} {:answer/id #uuid "af7653ed-b253-50e2-9a68-8c72c94c9870" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9(x+1){e}^{9x}" :db/id #edb/ref 17592186252083}] :answer-field/correct {:answer/id #uuid "9449d2c4-40c8-5886-a8f8-d377e92abd71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(9x+10){e}^{9x}" :db/id #edb/ref 17592186251828} :answer-field/id #uuid "2531d2a5-3c0e-51d6-8cfe-475ebfb26445" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252873}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ab66beff-1db7-5265-a536-ea4d30aeb123" :question/math-academy-id "q-11824" :question/problem "Given that $y=(x+1){e}^{9x},$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "This question requires the product rule. Let $u(x)=x+1$ and $v(x)={e}^{9x}.$ Then\n\n$$\n{u}^{′}(x)=1,\\,{v}^{′}(x)=9{e}^{9x}.\n$$\n\nNote that we used the chain rule to differentiate $v.$\n\nNow, applying the product rule and simplifying, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(1)({e}^{9x})+(x+1)(9{e}^{9x}) \\\\  & ={e}^{9x}+9(x+1){e}^{9x} \\\\  & =(1+9(x+1)){e}^{9x} \\\\  & =(9x+10){e}^{9x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253474 :knowledge-point/_questions [{:db/id #edb/ref 17592186059763 :knowledge-point/id #uuid "64edd709-3f6c-59e1-ae1f-bca25eca0483" :knowledge-point/title "Identifying the Reflection of a Sine Curve Over the Horizontal Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4755537d-9558-58e3-b1fb-e15adf27ad35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-sin⁡(x-\\frac{1}{4})" :db/id #edb/ref 17592186251146} {:answer/id #uuid "4f6bddc5-a5cd-5875-abbb-9f22efb60464" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-sin⁡(\\frac{x}{4})" :db/id #edb/ref 17592186251203} {:answer/id #uuid "6b736f08-32b3-5af6-a82e-5816f1c230a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{4}-sin⁡x" :db/id #edb/ref 17592186251431} {:answer/id #uuid "790ade44-b249-5c2c-8b0f-5e62399db5ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{4}sin⁡x" :db/id #edb/ref 17592186251558} {:answer/id #uuid "cdec9314-5fd3-5b0f-8a26-a6c75f8c9e96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-sin⁡x-\\frac{1}{4}" :db/id #edb/ref 17592186252370}] :answer-field/correct {:answer/id #uuid "790ade44-b249-5c2c-8b0f-5e62399db5ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{4}sin⁡x" :db/id #edb/ref 17592186251558} :answer-field/id #uuid "5268f851-1f31-5f10-a461-a1a9a49c25a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252950}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c5a416a1-a537-5d81-9140-46bc32e0a299" :question/math-academy-id "q-118350" :question/problem "![](images/a0/a065146d50b16eade39c758b59e13994272cf7180aaa662008a1865e4160421e.png)\n\nWhat is the equation of the graph shown above?" :question/worked-solution "![](images/46/46e8f92e758c7f4643b64c05d0b457f7b99b6723ddf9be9cd63da28079b89618.png)\n\nTo plot the given curve, we follow these steps:\n\n- Start with the graph of $y=sin⁡x.$\n\n- Then, reflect it in the $x$-axis to give $y=-sin⁡x.$\n\n- Finally, compress it parallel to the $y$-axis by a stretch factor of $\\frac{1}{4}$ to give $y=-\\frac{1}{4}sin⁡x.$\n\nTherefore, the given curve is the graph of $y=-\\frac{1}{4}sin⁡x.$"}] [{:db/id #edb/ref 17592186398186 :knowledge-point/_questions [{:db/id #edb/ref 17592186059764 :knowledge-point/id #uuid "85090bdf-4f1b-5f79-a751-48521ad98895" :knowledge-point/title "Identifying the Reflection of a Sine or Cosine Curve Over the Vertical Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bddbf7dd-8781-50a4-b250-66fd8e233371" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{5}sin⁡(-x)" :db/id #edb/ref 17592186398188} {:answer/id #uuid "7f35edde-ed58-55bc-8274-99043f11903d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=sin⁡(-x)-5" :db/id #edb/ref 17592186398189} {:answer/id #uuid "e98140d9-64d1-5b2b-87eb-6cb37aace0e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=sin⁡(-\\frac{x}{5})" :db/id #edb/ref 17592186398190} {:answer/id #uuid "1866cc81-a61e-52b4-828e-7f095d95514b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=sin⁡(-5x)" :db/id #edb/ref 17592186398191} {:answer/id #uuid "76a9807d-df1a-5832-b429-0890d06c222f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5sin⁡(-x)" :db/id #edb/ref 17592186398192}] :answer-field/correct {:answer/id #uuid "76a9807d-df1a-5832-b429-0890d06c222f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5sin⁡(-x)" :db/id #edb/ref 17592186398192} :answer-field/id #uuid "0aeaedd6-8135-5962-8437-2a69c460095e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398187}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e694bf71-afc9-51ff-82ce-ddde47237115" :question/math-academy-id "q-118442" :question/problem "![](images/99/997eb5cc08dcff78cb32f5b47b5d066546854b05f3b066953772e456e713d773.png)\n\nWhich of the following equations could be used to describe the graph shown above?" :question/worked-solution "![](images/1e/1e532c806d81c3c4015d78f814dc4ea3fc3483f22d34ade385894df2e8e7e3c5.png)\n\nTo plot the given curve, we follow these steps:\n\n- Start with the graph of $y=sin⁡x.$\n\n- Then, reflect it across the $y$-axis.\n\n- Finally, stretch it parallel to the $y$-axis by a stretch factor of $5.$\n\nTherefore, the given curve is the graph of $y=5sin⁡(-x).$\n\nNotice that, because the sine function is odd, the $y$-axis reflection has the same effect as the $x$-axis reflection, i.e.,\n\n$$\n5sin⁡(-x)=-5sin⁡x.\n$$\n\nSo the graph could also be viewed as $y=-5sin⁡x.$ However, $y=-5sin⁡x$ is not among the given options."}] [{:db/id #edb/ref 17592186398193 :knowledge-point/_questions [{:db/id #edb/ref 17592186059764 :knowledge-point/id #uuid "85090bdf-4f1b-5f79-a751-48521ad98895" :knowledge-point/title "Identifying the Reflection of a Sine or Cosine Curve Over the Vertical Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62375a92-edd9-5873-9edf-ef0ddd9dccaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=6sin⁡(-x)" :db/id #edb/ref 17592186398195} {:answer/id #uuid "1f1a872d-3b88-5a7f-8b75-ab249c2d63b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=sin⁡(-x)+6" :db/id #edb/ref 17592186398196} {:answer/id #uuid "839a4786-7b8b-587f-884b-34a3e1fb530a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=sin⁡(-\\frac{x}{6})" :db/id #edb/ref 17592186398197} {:answer/id #uuid "fbef0156-6d81-5b0b-80b2-e4c086df567d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{6}sin⁡(-x)" :db/id #edb/ref 17592186398198} {:answer/id #uuid "ab0aa795-c7d5-534e-922f-0ead75cd6cdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=sin⁡(-6x)" :db/id #edb/ref 17592186398199}] :answer-field/correct {:answer/id #uuid "62375a92-edd9-5873-9edf-ef0ddd9dccaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=6sin⁡(-x)" :db/id #edb/ref 17592186398195} :answer-field/id #uuid "1f0f56dd-8c86-5cbb-8889-d10079bd9452" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398194}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ef71e5dd-2133-5139-bcc4-313a9e867ac5" :question/math-academy-id "q-118443" :question/problem "![](images/f0/f012ee5880b4ec6c4c2cad4aa44da672b789f21c7f9969dcec50a25596e47c4b.png)\n\nWhich of the following equations could be used to describe the graph shown above?" :question/worked-solution "![](images/bc/bc61bf27fb210e0dc849829d5c287936fcb3f73bc279e98af8a64ba4085b8309.png)\n\nTo plot the given curve, we follow these steps:\n\n- Start with the graph of $y=sin⁡x.$\n\n- Then, reflect it across the $y$-axis.\n\n- Finally, stretch it parallel to the $y$-axis by a stretch factor of $6.$\n\nTherefore, the given curve is the graph of $y=6sin⁡(-x).$\n\nNotice that, because the sine function is odd, the $y$-axis reflection has the same effect as the $x$-axis reflection, i.e.,\n\n$$\n6sin⁡(-x)=-6sin⁡x.\n$$\n\nSo the graph could also be viewed as $y=-6sin⁡x.$ However, $y=-6sin⁡x$ is not among the given options."}] [{:db/id #edb/ref 17592186253480 :knowledge-point/_questions [{:db/id #edb/ref 17592186059765 :knowledge-point/id #uuid "1fe335eb-dc4a-5ea0-83cf-ad929e19b908" :knowledge-point/title "Identifying the Reflection and Shifting of a Sine or Cosine Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31777cec-aa4a-531c-8f91-1af7a0f66a13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-cos⁡x" :db/id #edb/ref 17592186250973} {:answer/id #uuid "3c737870-c937-5be1-9306-cc57cf97a411" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-sin⁡x-1" :db/id #edb/ref 17592186251056} {:answer/id #uuid "4c303ce3-dff7-58a3-b70c-6bed684870f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-cos⁡x-1" :db/id #edb/ref 17592186251183} {:answer/id #uuid "b4c0f728-a1b5-55fd-890b-dbd31577858c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=sin⁡(1-x)" :db/id #edb/ref 17592186252145} {:answer/id #uuid "e3100428-23e3-5316-a71c-cc8576b92026" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-sin⁡(1-x)" :db/id #edb/ref 17592186252551}] :answer-field/correct {:answer/id #uuid "3c737870-c937-5be1-9306-cc57cf97a411" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-sin⁡x-1" :db/id #edb/ref 17592186251056} :answer-field/id #uuid "011a22c2-f8f2-5ad2-9c5f-c7e5ef1ebd65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252807}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e1484f94-afd5-5ba7-9351-7b1e33dca84c" :question/math-academy-id "q-118450" :question/problem "![](images/98/98e3dc2a664f5096d2b7c9ba7bf7fc56faa189cd573a3de462e0b249fbc90af6.png)\n\nIdentify the equation that generated the graph above." :question/worked-solution "![](images/84/8499856915baa0bf144561dd35143e024586f4d417ac4f9c1ee48d7586e0f26c.png)\n\nTo plot the given curve, we follow these steps:\n\n- Start with the graph of $y=sin⁡x.$\n\n- Then, reflect it in the $x$-axis to give $y=-sin⁡x.$\n\n- Finally, translate it by $1$ unit **down** to give $y=-sin⁡x-1.$\n\nTherefore, the given curve is the graph of $y=-sin⁡x-1.$"}] [{:db/id #edb/ref 17592186386882 :knowledge-point/_questions [{:db/id #edb/ref 17592186115409 :knowledge-point/id #uuid "f7e817a0-edcf-54ca-ba4c-ffe91af04675" :knowledge-point/title "Finding a Height of a Triangle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b161b259-2a2c-531b-b051-34dd949dc4d6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/16/16c9990277df1c1b212ff154c4951b59301ef5b7f8360f82b041e73a5a3a984b.png" :db/id #edb/ref 17592186386884} {:answer/id #uuid "e0792fd2-fe4a-5351-bd8d-d02531595632" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/10/10e9f5a6af4d6d2b9c6392de91432b09620107d3dc645fc6ca65fdbda52f7c83.png" :db/id #edb/ref 17592186386885} {:answer/id #uuid "b85c7ea1-4023-5d0d-86b4-0459134b26d0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ce/ce3493e78660cfa84515970053105b95df5542eafbc4630c1e5b0afe9f658036.png" :db/id #edb/ref 17592186386886} {:answer/id #uuid "6c9daab7-90f4-5583-88a7-85210ed3b622" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/16/168ba7b705d9a579dc11408cc7bf60fb13249c5d4c6a25c3c490c09cfc77ec38.png" :db/id #edb/ref 17592186386887} {:answer/id #uuid "26d31697-89a3-57f9-9d21-e473be574ab7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/30/301c31fa98ce5c016337f422566b94a742e3da126b76f9060e4b13d6a8e86358.png" :db/id #edb/ref 17592186386888}] :answer-field/correct {:answer/id #uuid "26d31697-89a3-57f9-9d21-e473be574ab7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/30/301c31fa98ce5c016337f422566b94a742e3da126b76f9060e4b13d6a8e86358.png" :db/id #edb/ref 17592186386888} :answer-field/id #uuid "05bed876-047b-5aad-854a-94fee100e605" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386883}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3f1782d4-ceb0-5897-9f90-478b4c1242ae" :question/math-academy-id "q-118692" :question/problem "![](images/55/5548481ccbe3aee88fd4b346ad53777b7101223c19f7e8408c8ef85bb0d9df25.png)\n\nGiven the right triangle $△PQR$ shown above, which of the following diagrams represents the height corresponding to $\\overset{―}{PR}?$" :question/worked-solution "The height (or altitude) corresponding to $\\overset{―}{PR}$ is a line segment that \n\n- runs from the opposite vertex $Q$ to the line $\\overset{⟷}{PR},$ and\n\n- is perpendicular to $\\overset{⟷}{PR}.$\n\nThe correct diagram is shown below.\n\n![](images/30/301c31fa98ce5c016337f422566b94a742e3da126b76f9060e4b13d6a8e86358.png)"}] [{:db/id #edb/ref 17592186253503 :knowledge-point/_questions [{:db/id #edb/ref 17592186115336 :knowledge-point/id #uuid "6a916099-a237-5612-b7f1-3679b7ff069d" :knowledge-point/title "Calculating an Unknown Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37f6e98b-9e74-5362-9415-76b0e5788bd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{26}^{∘}" :db/id #edb/ref 17592186251016} {:answer/id #uuid "412b51d2-1c6c-5e96-b7f4-3a46ab2a6b3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{28}^{∘}" :db/id #edb/ref 17592186251093} {:answer/id #uuid "5df0c213-f26e-5d44-b086-a8082f8ff356" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{22}^{∘}" :db/id #edb/ref 17592186251329} {:answer/id #uuid "6a726442-67f6-5b29-aa0d-827d6fcd828e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{18}^{∘}" :db/id #edb/ref 17592186251427} {:answer/id #uuid "b7d0d4d2-0d27-5b44-a286-f8c17048fc8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{32}^{∘}" :db/id #edb/ref 17592186252172}] :answer-field/correct {:answer/id #uuid "412b51d2-1c6c-5e96-b7f4-3a46ab2a6b3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{28}^{∘}" :db/id #edb/ref 17592186251093} :answer-field/id #uuid "fd987d2b-51a1-5e48-9b29-2cadc9f301dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253251}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "574c517e-3266-5464-9df0-9e740c923895" :question/math-academy-id "q-118757" :question/problem "![](images/95/95b534f8c159b37884e32b730d9aa502565ff4971cd7d08903ffbfaa94b76623.png)\n\nConsider $△PQR$ shown above. The line segment $\\overset{―}{RH}$ is the altitude corresponding to $\\overset{―}{PQ}.$ If $m∠PQR={118}^{∘},$ calculate $m∠QRH.$" :question/worked-solution "Since the straight angle must have a measure of ${180}^{∘},$ we have\n\n$$\n\\begin{aligned}m∠HQR+m∠PQR & ={180}^{∘} \\\\ m∠HQR+{118}^{∘} & ={180}^{∘} \\\\ m∠HQR & ={62}^{∘}.\\end{aligned}\n$$\n\nNote that $△QHR$ is a right triangle. Since its interior angles must sum to ${180}^{∘},$ we have\n\n$$\n\\begin{aligned}m∠QRH+m∠HQR+m∠RHQ & ={180}^{∘} \\\\ m∠QRH+{62}^{∘}+{90}^{∘} & ={180}^{∘} \\\\ m∠QRH+{152}^{∘} & ={180}^{∘} \\\\ m∠QRH & ={28}^{∘}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253529 :knowledge-point/_questions [{:db/id #edb/ref 17592186096615 :knowledge-point/id #uuid "5856f3cc-5423-5a97-b2fd-7f44e0797ec7" :knowledge-point/title "Differentiating a Logarithmic Function With a General Base"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "010fae26-d218-5d85-80be-b5da7fa03138" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{xln⁡4}" :db/id #edb/ref 17592186250562} {:answer/id #uuid "1d7274d3-9d6c-566f-8ab0-5d6dadc206db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4x}" :db/id #edb/ref 17592186250801} {:answer/id #uuid "3fea77d7-dd38-54a3-ab38-de4a5e6af670" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{xln⁡5}" :db/id #edb/ref 17592186251082} {:answer/id #uuid "90d31982-431c-5c96-9fd1-28cbe6930c37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{xln⁡4}" :db/id #edb/ref 17592186251788 :task-item/_responses [{:db/id #edb/ref 17592186409265}]} {:answer/id #uuid "e56177c0-fb1c-54a8-8c75-934ef63a1c08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{x}" :db/id #edb/ref 17592186252561}] :answer-field/correct {:answer/id #uuid "90d31982-431c-5c96-9fd1-28cbe6930c37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{xln⁡4}" :db/id #edb/ref 17592186251788} :answer-field/id #uuid "35ef16c9-7f8c-57e6-86fd-b4dbee5a6bfa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252894}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b9de855f-8e10-5bff-89a6-c3649ce380b6" :question/math-academy-id "q-11900" :question/problem "Given that $y=5{log}_{4}⁡x$, find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{xln⁡a}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(5{log}_{4}⁡x) \\\\  & =5\\frac{\\text{d}}{\\text{d}x}({log}_{4}⁡x) \\\\  & =5\\cdot \\frac{1}{xln⁡4} \\\\  & =\\frac{5}{xln⁡4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253547 :knowledge-point/_questions [{:db/id #edb/ref 17592186096614 :knowledge-point/id #uuid "83ce3c28-857b-5538-b362-cf52526e3688" :knowledge-point/title "Differentiating a Sum Containing a Natural Logarithm Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26bf5cf8-eaf1-5b10-8d2a-662c31b3b508" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{x}" :db/id #edb/ref 17592186250885} {:answer/id #uuid "783b0f4c-199c-5928-b08e-dcb4df838be4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+\\frac{2}{x}" :db/id #edb/ref 17592186251549} {:answer/id #uuid "89f1e417-01f6-5b82-ba77-84fd142edcc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2x}" :db/id #edb/ref 17592186251714} {:answer/id #uuid "e0afa8a6-a60b-5d30-b8a6-b2c64b3b9e85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+\\frac{1}{x}" :db/id #edb/ref 17592186252532} {:answer/id #uuid "fe2d11d8-637f-5d1f-abb2-68fd4be88574" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+\\frac{1}{x}" :db/id #edb/ref 17592186252782 :task-item/_responses [{:db/id #edb/ref 17592186409245}]}] :answer-field/correct {:answer/id #uuid "fe2d11d8-637f-5d1f-abb2-68fd4be88574" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+\\frac{1}{x}" :db/id #edb/ref 17592186252782} :answer-field/id #uuid "ef06db64-440f-52c2-ab98-0824b44d15d2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253222}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2a7a5557-d240-5298-a285-f0853a897b06" :question/math-academy-id "q-11911" :question/problem "Given that $y=2x+ln⁡x$, find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2x+ln⁡x) \\\\  & =2+\\frac{1}{x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253566 :knowledge-point/_questions [{:db/id #edb/ref 17592186059669 :knowledge-point/id #uuid "38b450bd-b43a-507c-9bbe-0aaf7a64a3ed" :knowledge-point/title "Finding a Point That Lies on a Transformed Curve Given Another Transformed Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42a70a80-9905-5343-a34c-136a375e25ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-1)" :db/id #edb/ref 17592186251108} {:answer/id #uuid "9d7c8745-888b-5fc6-9d1a-fc1686129698" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,0)" :db/id #edb/ref 17592186251913} {:answer/id #uuid "a8ce837a-8964-565e-9e2d-f825bac56dba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,2)" :db/id #edb/ref 17592186252014} {:answer/id #uuid "d6b4c14b-cbd8-5494-b7e3-3692ec97eb35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,1)" :db/id #edb/ref 17592186252455} {:answer/id #uuid "e0fa8370-7c51-5755-8595-d094b48e3a78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-3)" :db/id #edb/ref 17592186252534}] :answer-field/correct {:answer/id #uuid "9d7c8745-888b-5fc6-9d1a-fc1686129698" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,0)" :db/id #edb/ref 17592186251913} :answer-field/id #uuid "2019c876-575f-5be0-a410-079acd66193f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252863}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4d38949b-9d50-5e0f-bb63-ea8ff36967c0" :question/math-academy-id "q-119308" :question/problem "The point $(2,3)$ lies on the curve $y=f(x)-1.$ Which of the following points **must** lie on $y=-f(x)+4?$" :question/worked-solution "**Method 1**\n\nTo plot $y=-f(x)+4,$ we apply the following steps:\n\n- First, take the graph $y=f(x)-1.$\n\n- Then, we shift the graph vertically by $1$ unit up and get the graph of $y=f(x).$ After this transformation, the point $(2,3)$ will be mapped to the point\n\n$$\n(2,3+1)=(2,4).\n$$\n\n- Next, we reflect the result across the $x$-axis and get the graph of $y=-f(x).$ After this transformation, the point $(2,4)$ will be mapped  to the point\n\n$$\n(2,-(4))=(2,-4).\n$$\n\n- Finally, shift the result vertically by $4$ units up and obtain the graph of $y=-f(x)+4.$ After this transformation, the point $(2,-4)$ will be mapped to the point \n\n$$\n(2,-4+4)=(2,0).\n$$\n\n**Method 2**\n\nSince the point $(2,3)$ lies on the graph of $y=f(x)-1$, we have that \n\n$$\nf(2)-1=3\\,⟹\\,f(2)=4.\n$$\n\nNow consider the graph of $y=-f(x)+4.$ Substituting $x=2$, we get\n\n$$\n\\begin{aligned}y & =-f(2)+4 \\\\  & =-4+4 \\\\  & =0.\\end{aligned}\n$$\n\nTherefore, the point $(2,0)$ must lie on $y=-f(x)+4.$"}] [{:db/id #edb/ref 17592186253574 :knowledge-point/_questions [{:db/id #edb/ref 17592186059641 :knowledge-point/id #uuid "3332b534-bd04-5e86-995e-1e6d691d8e1b" :knowledge-point/title "Simplifying an Expression by Factoring and Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1815e8ee-c289-5f64-9f4d-5df43b4aab39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\theta +1" :db/id #edb/ref 17592186250764} {:answer/id #uuid "25423e87-2e31-52ea-9bed-9680a8ad4d75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186250872} {:answer/id #uuid "380b2f49-3850-505e-a125-48611fc7669a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186251019} {:answer/id #uuid "b6fc9b1c-0a28-54c2-82c9-b8ff1ad7eae4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186252166} {:answer/id #uuid "bb0ddaa2-dc14-5f83-8293-f70b43e52381" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡\\theta +1" :db/id #edb/ref 17592186252200}] :answer-field/correct {:answer/id #uuid "380b2f49-3850-505e-a125-48611fc7669a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186251019} :answer-field/id #uuid "a308e80e-fc90-57c9-9815-5d63c4e60f59" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253090}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1e264613-6b71-5c6c-b1c0-6da9257b1f1a" :question/math-academy-id "q-119371" :question/problem "Simplify the trigonometric expression ${sin}^{3}⁡\\theta +\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta +\\operatorname{sin}⁡\\theta .$" :question/worked-solution "First, we factor the expression:\n\n$$\n{sin}^{3}⁡\\theta +\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta +\\operatorname{sin}⁡\\theta =\\operatorname{sin}⁡\\theta ({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta )+\\operatorname{sin}⁡\\theta \n$$\n\nThen, we use ${sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta =1$ to simplify the expression in the parentheses:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡\\theta ({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta )+\\operatorname{sin}⁡\\theta  & =\\operatorname{sin}⁡\\theta \\cdot 1+\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta +\\operatorname{sin}⁡\\theta  \\\\  & =2\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n{sin}^{3}⁡\\theta +\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta +\\operatorname{sin}⁡\\theta =2\\operatorname{sin}⁡\\theta .\n$$"}] [{:db/id #edb/ref 17592186253577 :knowledge-point/_questions [{:db/id #edb/ref 17592186059642 :knowledge-point/id #uuid "868125f0-22e0-57fc-9620-f3242419a689" :knowledge-point/title "Simplifying a Rational Expression Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08ed664b-fff1-5712-ac2e-5525f9cdacef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡\\theta " :db/id #edb/ref 17592186250634} {:answer/id #uuid "3b69e247-6d23-5ff1-a976-eb6503b80dcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡\\theta +1" :db/id #edb/ref 17592186251045} {:answer/id #uuid "58c39cbe-5a9b-575c-ae8a-d7f92d34e4dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{cot}⁡\\theta " :db/id #edb/ref 17592186251282} {:answer/id #uuid "923c3e09-f2e0-5124-82ce-83280737e8aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{cot}⁡\\theta " :db/id #edb/ref 17592186251804} {:answer/id #uuid "b061ebd1-c842-5f84-80fa-eec468f6b43d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡\\theta -1" :db/id #edb/ref 17592186252093}] :answer-field/correct {:answer/id #uuid "08ed664b-fff1-5712-ac2e-5525f9cdacef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡\\theta " :db/id #edb/ref 17592186250634} :answer-field/id #uuid "89a2bbe3-2ba2-5a56-9f75-7bcd2efd08bd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253041}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e604df29-4056-5a18-af72-ee9756feedd1" :question/math-academy-id "q-119387" :question/problem "$\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{5}⁡\\theta +{sin}^{3}⁡\\theta {cos}^{2}⁡\\theta }=$" :question/worked-solution "First, we factor the denominator:\n\n$$\n\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{5}⁡\\theta +{sin}^{3}⁡\\theta {cos}^{2}⁡\\theta }=\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{3}⁡\\theta \\cdot ({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta )}\n$$\n\nNext, we use the Pythagorean identity to rewrite the expression in the parentheses, and then we simplify the resulting expression as much as possible.\n\n$$\n\\begin{aligned}\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{3}⁡\\theta \\cdot ({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta )} & =\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{3}⁡\\theta \\cdot 1} \\\\  & =\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{3}⁡\\theta } \\\\  & =\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{2}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta } \\\\  & =\\frac{\\cancel{{sin}^{2}⁡\\theta }\\operatorname{cos}⁡\\theta }{\\cancel{{sin}^{2}⁡\\theta }\\cdot \\operatorname{sin}⁡\\theta } \\\\  & =\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta } \\\\  & =\\operatorname{cot}⁡\\theta \\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{5}⁡\\theta +{sin}^{3}⁡\\theta {cos}^{2}⁡\\theta }=\\operatorname{cot}⁡\\theta .\n$$"}] [{:db/id #edb/ref 17592186253581 :knowledge-point/_questions [{:db/id #edb/ref 17592186059666 :knowledge-point/id #uuid "283415d8-47d7-5d42-8836-0c0b0c4efc85" :knowledge-point/title "Finding Exact Values Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33c614c8-e574-54c4-afe7-ea7cbe93a089" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}-\\sqrt{6}}{4}" :db/id #edb/ref 17592186250984} {:answer/id #uuid "82138ae6-184b-5b43-9d31-1dafcb47b464" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}+\\sqrt{6}}{4}" :db/id #edb/ref 17592186251649} {:answer/id #uuid "866785b4-4b0d-5ed0-ab10-df319b0d8757" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}-\\sqrt{6}}{4}" :db/id #edb/ref 17592186251680} {:answer/id #uuid "cb17904f-e9e2-5ce4-ac6b-159a7742e47c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}+\\sqrt{6}}{4}" :db/id #edb/ref 17592186252351} {:answer/id #uuid "f85fd59f-f673-55d7-9727-39ba21278ce9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}+\\sqrt{6}}{4}" :db/id #edb/ref 17592186252727}] :answer-field/correct {:answer/id #uuid "82138ae6-184b-5b43-9d31-1dafcb47b464" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}+\\sqrt{6}}{4}" :db/id #edb/ref 17592186251649} :answer-field/id #uuid "307233f6-b9b3-54e3-9937-9c7b41e5ed35" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252888}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9b9e46d2-105c-587e-ad59-8da071cc7eea" :question/math-academy-id "q-119479" :question/problem "Find the exact value of  $\\operatorname{cos}⁡{195}^{∘}.$\n\n*Hint: Use the fact that ${195}^{∘}={135}^{∘}+{60}^{∘}.$*" :question/worked-solution "Recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(x+y)=\\operatorname{cos}⁡x\\operatorname{cos}⁡y-\\operatorname{sin}⁡x\\operatorname{sin}⁡y\n$$\n\nApplying the sum formula for cosine with $x={135}^{∘}$ and $y={60}^{∘}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡({195}^{∘}) & =\\operatorname{cos}⁡({135}^{∘}+{60}^{∘}) \\\\  & =\\operatorname{cos}⁡{135}^{∘}\\operatorname{cos}⁡{60}^{∘}-\\operatorname{sin}⁡{135}^{∘}\\operatorname{sin}⁡{60}^{∘} \\\\  & =(-\\frac{\\sqrt{2}}{2})\\cdot \\frac{1}{2}-\\frac{\\sqrt{2}}{2}\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =-\\frac{\\sqrt{2}}{4}-\\frac{\\sqrt{6}}{4} \\\\  & =-\\frac{\\sqrt{2}+\\sqrt{6}}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253582 :knowledge-point/_questions [{:db/id #edb/ref 17592186059821 :knowledge-point/id #uuid "c6a58962-cb06-519a-8c64-0dfa3b9c14d7" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "046c3fff-e187-5d6d-817c-fcad26542595" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\operatorname{cos}⁡x+\\sqrt{3}\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186250586} {:answer/id #uuid "4206c502-18de-5733-a8cd-4790cc23f4b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186251105} {:answer/id #uuid "459effbf-a2af-5f96-b9e0-38a98c849e15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186251129} {:answer/id #uuid "6c93157b-2ac8-5521-831f-507d005bc1c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186251447} {:answer/id #uuid "7d8d63a7-52ee-5a72-956d-4feb52257b50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186251603}] :answer-field/correct {:answer/id #uuid "4206c502-18de-5733-a8cd-4790cc23f4b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186251105} :answer-field/id #uuid "af98a692-a950-5516-913c-d1527e2c4e36" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253111}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "24fefd74-9f51-579d-ab19-a20613b6de76" :question/math-academy-id "q-119482" :question/problem "$\\operatorname{cos}⁡(x-{30}^{∘})=$" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for cosine with $u=x$ and $v={30}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x-{30}^{∘}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡{30}^{∘}+\\operatorname{sin}⁡x\\operatorname{sin}⁡{30}^{∘} \\\\  & =\\operatorname{cos}⁡x\\cdot \\frac{\\sqrt{3}}{2}+\\operatorname{sin}⁡x\\cdot \\frac{1}{2} \\\\  & =\\frac{1}{2}(\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253590 :knowledge-point/_questions [{:db/id #edb/ref 17592186096622 :knowledge-point/id #uuid "af269509-92c0-5a82-b828-e8626f8e8eda" :knowledge-point/title "Differentiating a Quotient Using Leibniz Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b89321c-e3ba-5c4f-81cd-a7cbf23d72d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{{(9-2x)}^{2}}" :db/id #edb/ref 17592186250653} {:answer/id #uuid "0fbd81fe-3865-51f1-85e7-89c40d3f7b84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{{(9-2x)}^{2}}" :db/id #edb/ref 17592186250690} {:answer/id #uuid "3a22468e-a8b9-5374-a6b1-4af81ef69538" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4x-9}{{(9-2x)}^{2}}" :db/id #edb/ref 17592186251034} {:answer/id #uuid "bd9f93f8-6285-5333-9fbc-0e76b0bb68f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2x-9}{{(9-2x)}^{2}}" :db/id #edb/ref 17592186252231} {:answer/id #uuid "e86a868c-0137-5698-8032-3302efc36e18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4x-9}{{(9-2x)}^{2}}" :db/id #edb/ref 17592186252584}] :answer-field/correct {:answer/id #uuid "0fbd81fe-3865-51f1-85e7-89c40d3f7b84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{{(9-2x)}^{2}}" :db/id #edb/ref 17592186250690} :answer-field/id #uuid "05c220dd-0a63-5428-9d3d-76e098f2cb6c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252820}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4ae64d20-c5b4-50bb-94bc-ab5da04017e1" :question/math-academy-id "q-11969" :question/problem "Given that $y=\\frac{-x}{9-2x}$, find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "Let $u=-x$ and $v=9-2x.$ Then\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =-1\\,\\text{and}\\,\\frac{\\text{d}v}{\\text{d}x}=-2.\\end{aligned}\n$$\n\nUsing the quotient rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{v\\frac{\\text{d}u}{\\text{d}x}-u\\frac{\\text{d}v}{\\text{d}x}}{{v}^{2}} \\\\  & =\\frac{(9-2x)\\cdot (-1)-(-x)\\cdot (-2)}{{(9-2x)}^{2}} \\\\  & =\\frac{-9+2x-2x}{{(9-2x)}^{2}} \\\\  & =-\\frac{9}{{(9-2x)}^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186097026 :knowledge-point/_questions [{:db/id #edb/ref 17592186096844 :knowledge-point/id #uuid "261910cd-a1a4-5c90-8caa-238208558458" :knowledge-point/title "Calculating a Derivative Using the Chain and Quotient Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39a5acaf-0b97-5eec-b5dc-80f14127936e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6x}{{(3x+5)}^{3}}" :db/id #edb/ref 17592186251028} {:answer/id #uuid "5fc87138-62df-5eac-9d34-752a109148de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{{(3x+5)}^{4}}" :db/id #edb/ref 17592186251338} {:answer/id #uuid "794835b2-c8d2-5e60-99aa-d141cf6639aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{30x}{{(3x+5)}^{3}}" :db/id #edb/ref 17592186251559} {:answer/id #uuid "80538af1-96e8-546c-8e04-53ab4e77cd46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x}{{(3x+5)}^{4}}" :db/id #edb/ref 17592186251634} {:answer/id #uuid "e543d792-894d-58ae-966d-434f788becaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5x}{{(3x+5)}^{4}}" :db/id #edb/ref 17592186252560}] :answer-field/correct {:answer/id #uuid "794835b2-c8d2-5e60-99aa-d141cf6639aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{30x}{{(3x+5)}^{3}}" :db/id #edb/ref 17592186251559} :answer-field/id #uuid "dcc00428-34a0-5c80-bcd3-256eb4ce28ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253182}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4603accf-ccdb-5030-90b8-c9b568c4df0b" :question/math-academy-id "q-11973" :question/problem "Given that $y=\\frac{3{x}^{2}}{(3x+5)^{2}}$, find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "We use the quotient rule with the numerator $u(x)=3{x}^{2}$ and the denominator $v(x)=(3x+5)^{2}.$ \n\nDifferentiating $u(x)$ and $v(x),$ we have\n\n$$\n{u}^{′}(x)=6x,\\,{v}^{′}(x)=6(3x+5).\n$$\n\nNote that we used the chain rule to differentiate $v.$\n\nNow, applying the quotient rule and simplifying, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(6x){(3x+5)}^{2}-(3{x}^{2})\\cdot 6(3x+5)}{{((3x+5)^{2})}^{2}} \\\\  & =\\frac{6x(3x+5)(3x+5-3x)}{{(3x+5)}^{4}} \\\\  & =\\frac{6x(3x+5)(5)}{{(3x+5)}^{4}} \\\\  & =\\frac{30x}{{(3x+5)}^{3}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253599 :knowledge-point/_questions [{:db/id #edb/ref 17592186059643 :knowledge-point/id #uuid "1bc8c875-3393-5fd6-90cf-87737e16f2f2" :knowledge-point/title "Simplifying a Trigonometric Expression Using a Common Denominator and the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55eb6103-d65c-564e-8146-1b697fcf6114" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x+1" :db/id #edb/ref 17592186251257} {:answer/id #uuid "9c494cc4-f14a-523f-afab-b55ead4e2206" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186251902} {:answer/id #uuid "9cabf4a9-d334-52aa-94a3-29c1226a338c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186251905} {:answer/id #uuid "ac59de0c-94ce-555a-a9af-0f345fa9844c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186252052} {:answer/id #uuid "cdfac5b4-b918-541c-bab0-02afa81cd836" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x" :db/id #edb/ref 17592186252374}] :answer-field/correct {:answer/id #uuid "ac59de0c-94ce-555a-a9af-0f345fa9844c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186252052} :answer-field/id #uuid "5889b846-4b45-54d4-a4c7-1acb0782d3ec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252962}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8a4d16bb-7544-56af-8e64-b1dbb3f56d7c" :question/math-academy-id "q-119770" :question/problem "Simplify the trigonometric expression $\\frac{{cos}^{2}⁡x}{1+\\operatorname{sin}⁡x}+\\operatorname{sin}⁡x.$" :question/worked-solution "We put both terms over a common denominator, and combine the two fractions:\n\n$$\n\\begin{aligned}\\frac{{cos}^{2}⁡x}{1+\\operatorname{sin}⁡x}+\\operatorname{sin}⁡x & =\\frac{{cos}^{2}⁡x}{1+\\operatorname{sin}⁡x}+\\frac{\\operatorname{sin}⁡x}{1} \\\\  & =\\frac{{cos}^{2}⁡x}{1+\\operatorname{sin}⁡x}+\\frac{\\operatorname{sin}⁡x(1+\\operatorname{sin}⁡x)}{1(1+\\operatorname{sin}⁡x)} \\\\  & =\\frac{{cos}^{2}⁡x+\\operatorname{sin}⁡x(1+\\operatorname{sin}⁡x)}{1+\\operatorname{sin}⁡x}\\end{aligned}\n$$\n\nFinally, we simplify using the Pythagorean identity, as follows:\n\n$$\n\\begin{aligned}\\frac{{cos}^{2}⁡x+\\operatorname{sin}⁡x(1+\\operatorname{sin}⁡x)}{1+\\operatorname{sin}⁡x} & =\\frac{{cos}^{2}⁡x+\\operatorname{sin}⁡x+{sin}^{2}⁡x}{1+\\operatorname{sin}⁡x} \\\\  & =\\frac{({sin}^{2}⁡x+{cos}^{2}⁡x)+\\operatorname{sin}⁡x}{1+\\operatorname{sin}⁡x} \\\\  & =\\frac{1+\\operatorname{sin}⁡x}{1+\\operatorname{sin}⁡x} \\\\  & =1\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{{cos}^{2}⁡x}{2+\\operatorname{sin}⁡x}+\\operatorname{sin}⁡x=1.\n$$"}] [{:db/id #edb/ref 17592186253603 :knowledge-point/_questions [{:db/id #edb/ref 17592186096844 :knowledge-point/id #uuid "261910cd-a1a4-5c90-8caa-238208558458" :knowledge-point/title "Calculating a Derivative Using the Chain and Quotient Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "010ec989-6a70-5560-8c6d-96bcabcf07f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(1-x)^{2}}{{({x}^{2}+1)}^{2}}" :db/id #edb/ref 17592186250561} {:answer/id #uuid "185de746-f2a2-5bc0-a895-8eef91887f33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(x+1)}{{({x}^{2}+1)}^{2}}" :db/id #edb/ref 17592186250767} {:answer/id #uuid "5cf0aeab-facc-582b-9a39-b2c196aead5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(1-{x}^{2})}{{({x}^{2}+1)}^{2}}" :db/id #edb/ref 17592186251320} {:answer/id #uuid "c4f44c2b-b5c6-5adc-a37b-c3386048fc4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(1-x)}{{({x}^{2}+1)}^{2}}" :db/id #edb/ref 17592186252297} {:answer/id #uuid "e2b8be0a-88c7-5856-ade3-8586c358ec8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(1-2{x}^{2})}{{({x}^{2}+1)}^{2}}" :db/id #edb/ref 17592186252547}] :answer-field/correct {:answer/id #uuid "5cf0aeab-facc-582b-9a39-b2c196aead5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(1-{x}^{2})}{{({x}^{2}+1)}^{2}}" :db/id #edb/ref 17592186251320} :answer-field/id #uuid "910e876b-71ca-514d-ad43-ceb4c9229334" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253056}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3000a138-321d-511f-bb2f-c25bd88c5e97" :question/math-academy-id "q-11978" :question/problem "Given that $y=\\frac{(x+1)^{2}}{{x}^{2}+1},$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "We use the quotient rule with the numerator $u(x)=(x+1)^{2}$ and the denominator $v(x)={x}^{2}+1.$ \n\nDifferentiating $u(x)$ and $v(x),$ we have\n\n$$\n{u}^{′}(x)=2(x+1),\\,{v}^{′}(x)=2x.\n$$\n\nNote that we used the chain rule to differentiate $u.$\n\nNow, applying the quotient rule and simplifying, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(2(x+1))({x}^{2}+1)-((x+1)^{2})(2x)}{({x}^{2}+1)^{2}} \\\\  & =\\frac{2(x+1)({x}^{2}+1)-2x(x+1)^{2}}{({x}^{2}+1)^{2}} \\\\  & =\\frac{2(x+1)(({x}^{2}+1)-x(x+1))}{({x}^{2}+1)^{2}} \\\\  & =\\frac{2(x+1)({x}^{2}+1-{x}^{2}-x)}{({x}^{2}+1)^{2}} \\\\  & =\\frac{2(x+1)(1-x)}{({x}^{2}+1)^{2}} \\\\  & =\\frac{2(1-{x}^{2})}{({x}^{2}+1)^{2}}.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253617 :knowledge-point/_questions [{:db/id #edb/ref 17592186059652 :knowledge-point/id #uuid "b05f4be1-95d4-5137-bbaa-71c95862bb59" :knowledge-point/title "Simplifying Expressions by Factoring an Alternate Form of the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00677872-7616-5c6b-bc06-e85a41bca0b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+1" :db/id #edb/ref 17592186250553} {:answer/id #uuid "60dff4f9-0626-5330-99dd-f03bb2eb6f7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186251345} {:answer/id #uuid "a43f7607-4390-56c0-ba26-6beaa6359216" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186251971} {:answer/id #uuid "bbc2c36b-5bb0-5f2e-8ad7-e904eb5d214b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-(1+\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186252208} {:answer/id #uuid "bc732a44-7bfc-58d9-95fa-404ba29a3bd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x-1" :db/id #edb/ref 17592186252217}] :answer-field/correct {:answer/id #uuid "bbc2c36b-5bb0-5f2e-8ad7-e904eb5d214b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-(1+\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186252208} :answer-field/id #uuid "68996742-5572-5673-a555-2490c8c236c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252995}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a1b437a5-869a-5ccd-aeb4-884c52b20f38" :question/math-academy-id "q-119864" :question/problem "Simplify the expression $\\frac{{cos}^{2}⁡x}{\\operatorname{sin}⁡x-1}.$" :question/worked-solution "First, we rewrite the numerator using $1-{sin}^{2}⁡x={cos}^{2}⁡x.$\n\n$$\n\\frac{{cos}^{2}⁡x}{\\operatorname{sin}⁡x-1}=\\frac{1-{sin}^{2}⁡x}{\\operatorname{sin}⁡x-1}\n$$\n\nNext, we factor the numerator as a difference of squares, and simplify:\n\n$$\n\\begin{aligned}\\frac{1-{sin}^{2}⁡x}{\\operatorname{sin}⁡x-1} & =\\frac{(1+\\operatorname{sin}⁡x)(1-\\operatorname{sin}⁡x)}{\\operatorname{sin}⁡x-1} \\\\  & =-\\frac{(1+\\operatorname{sin}⁡x)(1-\\operatorname{sin}⁡x)}{1-\\operatorname{sin}⁡x} \\\\  & =-\\frac{(1+\\operatorname{sin}⁡x)\\cancel{(1-\\operatorname{sin}⁡x)}}{\\cancel{1-\\operatorname{sin}⁡x}} \\\\  & =-\\frac{1+\\operatorname{sin}⁡x}{1} \\\\  & =-(1+\\operatorname{sin}⁡x)\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{{cos}^{2}⁡x}{\\operatorname{sin}⁡x-1}=-(1+\\operatorname{sin}⁡x).\n$$"}] [{:db/id #edb/ref 17592186253628 :knowledge-point/_questions [{:db/id #edb/ref 17592186059673 :knowledge-point/id #uuid "5f9683d9-05b9-5a42-9f81-0170a15dfac1" :knowledge-point/title "Using the Double-Angle Formula to Simplify Ratios"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "024f4b95-a6a5-5f2d-a751-2755ac5cce12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡(\\frac{\\pi }{8})" :db/id #edb/ref 17592186250575} {:answer/id #uuid "0e20a623-1450-54d0-9595-8a7aa3109a42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sin}⁡(\\frac{\\pi }{8})" :db/id #edb/ref 17592186250675} {:answer/id #uuid "3a0ea007-0dad-5df4-93e4-28082fff80d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{csc}⁡(\\frac{\\pi }{4})" :db/id #edb/ref 17592186251033} {:answer/id #uuid "8f9f6191-c575-5400-985e-09588bd93769" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡(\\frac{\\pi }{4})" :db/id #edb/ref 17592186251773} {:answer/id #uuid "adab3445-9088-5485-a515-0fc08abd7e3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{csc}⁡(\\frac{\\pi }{8})" :db/id #edb/ref 17592186252067}] :answer-field/correct {:answer/id #uuid "adab3445-9088-5485-a515-0fc08abd7e3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{csc}⁡(\\frac{\\pi }{8})" :db/id #edb/ref 17592186252067} :answer-field/id #uuid "8a4e8fb7-0cf4-569d-9a43-083899802b06" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253044}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "11defe63-9b06-5fba-87b6-5807bf8b34d3" :question/math-academy-id "q-120018" :question/problem "$\\frac{\\operatorname{cos}⁡(\\frac{\\pi }{8})}{\\operatorname{sin}⁡(\\frac{\\pi }{4})}=$" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n\\operatorname{sin}⁡2x=2\\operatorname{sin}⁡x\\operatorname{cos}⁡x\n$$\n\nSubstituting $x=\\frac{\\pi }{8}$ into the above, we get\n\n$$\n\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{8})=2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8})\n$$\n\nwhich simplifies as\n\n$$\n\\operatorname{sin}⁡(\\frac{\\pi }{4})=2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8}).\n$$\n\nTherefore, we can simplify the given expression by rewriting the $\\operatorname{sin}⁡(\\frac{\\pi }{4})$ in the denominator, as follows:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{cos}⁡(\\frac{\\pi }{8})}{\\operatorname{sin}⁡(\\frac{\\pi }{4})} & =\\frac{\\operatorname{cos}⁡(\\frac{\\pi }{8})}{2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8})} \\\\  & =\\frac{\\cancel{\\operatorname{cos}⁡(\\frac{\\pi }{8})}}{2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\cancel{\\operatorname{cos}⁡(\\frac{\\pi }{8})}} \\\\  & =\\frac{1}{2\\operatorname{sin}⁡(\\frac{\\pi }{8})} \\\\  & =\\frac{1}{2}\\operatorname{csc}⁡(\\frac{\\pi }{8}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186395991 :knowledge-point/_questions [{:db/id #edb/ref 17592186087746 :knowledge-point/id #uuid "d8c04b23-e341-57e9-a072-985e4b536e5a" :knowledge-point/title "Identifying Linear Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af31ad74-3d71-5216-82f4-241c0fe0d883" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186395993} {:answer/id #uuid "55344227-ef64-559d-b72e-d67580b900d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186395994} {:answer/id #uuid "8c8d3009-744a-5594-85d0-81623acfa040" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186395995} {:answer/id #uuid "1acecbea-2330-5d66-8f7e-c711b7d73ea2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186395996} {:answer/id #uuid "cabd1c0f-3241-5f02-a31b-66428bbc54cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186395997}] :answer-field/correct {:answer/id #uuid "af31ad74-3d71-5216-82f4-241c0fe0d883" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186395993} :answer-field/id #uuid "e3af571d-ad32-5475-bbe0-4ca42f82e8b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395992}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d2b3861b-a381-5b7c-bc56-9232209a631c" :question/math-academy-id "q-12008" :question/problem "Let \n$T:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}x+y \\\\ 4x+3y\\end{aligned}].$\nWhich of the following statements are true?\n\nI. $T(kv)=kT(v)$ for any real $2\\times 1$ column vector $v$ and real scalar $k$\nII. $T({v}_{1}+{v}_{2})=T({v}_{1})+T({v}_{2})$ for any real $2\\times 1$ column vectors ${v}_{1}$ and ${v}_{2}$\nIII. $T$ is a linear transformation" :question/worked-solution "A linear transformation $T$ satisfies two properties:\n\n$$\n\\begin{aligned} & T[\\begin{aligned}kx \\\\ ky\\end{aligned}]=kT[\\begin{aligned}x \\\\ y\\end{aligned}], \\\\  & T[\\begin{aligned}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{aligned}]=T[\\begin{aligned}{x}_{1} \\\\ {y}_{1}\\end{aligned}]+T[\\begin{aligned}{x}_{2} \\\\ {y}_{2}\\end{aligned}].\\end{aligned}\n$$\n\n- Checking the first condition, we have\n\n$$\n\\begin{aligned}T[\\begin{aligned}kx \\\\ ky\\end{aligned}] & =[\\begin{aligned}kx+ky \\\\ 4kx+3ky\\end{aligned}] \\\\  & =k[\\begin{aligned}x+y \\\\ 4x+3y\\end{aligned}] \\\\  & =kT[\\begin{aligned}x \\\\ y\\end{aligned}].\\,✓\\end{aligned}\n$$\n\n- Checking the second condition, we have\n\n$$\n\\begin{aligned}T[\\begin{aligned}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{aligned}] & =[\\begin{aligned}{x}_{1}+{x}_{2}+{y}_{1}+{y}_{2} \\\\ 4({x}_{1}+{x}_{2})+3({y}_{1}+{y}_{2})\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{1}+{y}_{1} \\\\ 4{x}_{1}+3{y}_{1}\\end{aligned}]+[\\begin{aligned}{x}_{2}+{y}_{2} \\\\ 4{x}_{2}+3{y}_{2}\\end{aligned}] \\\\  & =T[\\begin{aligned}{x}_{1} \\\\ {y}_{1}\\end{aligned}]+T[\\begin{aligned}{x}_{2} \\\\ {y}_{2}\\end{aligned}].\\,✓\\end{aligned}\n$$\n\nTherefore, $\\text{T}$ is a linear transformation.\n\nAs a result, all three statements are true."}] [{:db/id #edb/ref 17592186235344 :knowledge-point/_questions [{:db/id #edb/ref 17592186235285 :knowledge-point/id #uuid "58a49d00-cc58-5228-af38-9369cf31d8c8" :knowledge-point/title "Finding a Scalar Factor When Direction Reverses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cdd0854-261d-5ed4-92ef-477febc75b21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186234639} {:answer/id #uuid "3eab765d-2302-5205-b5fd-0ada1e027409" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186234642} {:answer/id #uuid "6e5da092-7603-5a36-a455-4137459af1b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186234713} {:answer/id #uuid "dde73660-f588-5765-aec3-a2559c655608" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186234894} {:answer/id #uuid "e5f2c8c3-d49b-55df-8a1c-5ef41ca2446f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186234905}] :answer-field/correct {:answer/id #uuid "e5f2c8c3-d49b-55df-8a1c-5ef41ca2446f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186234905} :answer-field/id #uuid "959370f5-d157-5592-9470-19e5d767b960" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186235154}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "16c001cc-439d-56cc-834f-f6d6a747b8e6" :question/math-academy-id "q-120257" :question/problem "![](images/55/551316d1e36175ca302c5c472d4109a9bc9cadf32cc85d2a1751424a386070cc.png)\n\nConsider the picture above. Given that $c=\\lambda a-2b,$ find $\\lambda .$" :question/worked-solution "To find $\\lambda ,$ we want to match the expression\n\n$$\nc=\\lambda a-2b.\n$$\n\nWe are given that one of the components is $-2b.$ So, we first draw the vector $-2b$ from the origin. Then we complete the path to the point $C.$\n\n![](images/40/40a0137d6227212db9b7ef9f349029838f3f51398790ec5e1c304e12c3743a0f.png)\n\nLet $P$ be the endpoint of the vector $-2b.$ Then\n\n$$\nc=\\overset{\\to }{OP}+\\overset{\\to }{PC}.\n$$\n\nIn $△OPC,$ we have:\n\n- $PC=\\frac{1}{2}|a|$\n\n- $\\overset{\\to }{PC}$ and $a$ have opposite directions\n\nHence, $\\overset{\\to }{PC}=-\\frac{1}{2}a.$\n\nAdditionally,\n\n$$\n\\begin{aligned}c & =\\overset{\\to }{OP}+\\overset{\\to }{PC} \\\\  & =-2b-\\frac{1}{2}a.\\end{aligned}\n$$\n\nConsequently, $c=\\lambda a-2b=-\\frac{1}{2}a-2b.$\n\nSince $a∦b,$ the linear combination can only be written in one way. Equating the coefficients of $a,$ we get:\n\n$$\n\\lambda =-\\frac{1}{2}\n$$"}] [{:db/id #edb/ref 17592186256393 :knowledge-point/_questions [{:db/id #edb/ref 17592186087669 :knowledge-point/id #uuid "5ec37c5e-8a40-58a7-8af3-4457cd5da43f" :knowledge-point/title "Using the Double-Angle Formula to Simplify Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05d4fe96-e437-5459-b90d-0a3bdfc1825d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}\\operatorname{cos}⁡{70}^{∘}" :db/id #edb/ref 17592186253714} {:answer/id #uuid "60f62d48-049d-5a6d-a9e6-66749d676bd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}\\operatorname{cos}⁡{35}^{∘}" :db/id #edb/ref 17592186254537} {:answer/id #uuid "988c0b62-37ae-5848-98ed-b1e6c7c32632" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}\\operatorname{cos}⁡{35}^{∘}" :db/id #edb/ref 17592186255019} {:answer/id #uuid "a00792a6-ab66-5c63-99fe-0e99a6d1bfd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}\\operatorname{cos}⁡{70}^{∘}" :db/id #edb/ref 17592186255080} {:answer/id #uuid "d0cd2ac8-79c2-55c9-8923-9989a38dea95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}\\operatorname{cos}⁡{70}^{∘}" :db/id #edb/ref 17592186255532}] :answer-field/correct {:answer/id #uuid "d0cd2ac8-79c2-55c9-8923-9989a38dea95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}\\operatorname{cos}⁡{70}^{∘}" :db/id #edb/ref 17592186255532} :answer-field/id #uuid "88f8237f-b76a-5905-b3b4-ed1d154b073e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256175}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cf1faff6-afe0-59ea-a58f-f8289c637840" :question/math-academy-id "q-120348" :question/problem "Express $\\sqrt{3}{cos}^{2}⁡{35}^{∘}-\\sqrt{3}{sin}^{2}⁡{35}^{∘}$ as a single trigonometric ratio." :question/worked-solution "Our expression can be factored as follows:\n\n$$\n\\sqrt{3}({cos}^{2}⁡{35}^{∘}-{sin}^{2}⁡{35}^{∘})\n$$\n\nNow, let's recall the double-angle formula for cosine:\n\n$$\n{cos}^{2}⁡x-{sin}^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x={35}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡{35}^{∘}-{sin}^{2}⁡{35}^{∘} & =\\operatorname{cos}⁡(2\\cdot {35}^{∘})=\\operatorname{cos}⁡{70}^{∘}.\\end{aligned}\n$$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}\\sqrt{3}({cos}^{2}⁡{35}^{∘}-{sin}^{2}⁡{35}^{∘})=\\sqrt{3}\\operatorname{cos}⁡{70}^{∘}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256398 :knowledge-point/_questions [{:db/id #edb/ref 17592186087670 :knowledge-point/id #uuid "12ff17ae-9319-5498-a5e0-1d49ddbef50a" :knowledge-point/title "Using Alternative Forms of Double-Angle Formula to Simplify Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "157cee2f-b39d-5759-8141-9311f65baea4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}\\operatorname{cos}⁡{110}^{∘}" :db/id #edb/ref 17592186253857} {:answer/id #uuid "b658d1bf-666b-53ab-86f3-7ef9d39e3d7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}\\operatorname{cos}⁡{55}^{∘}" :db/id #edb/ref 17592186255284} {:answer/id #uuid "d6a267b4-b9d7-542f-b375-9cbb1aec3915" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}\\operatorname{cos}⁡{110}^{∘}" :db/id #edb/ref 17592186255571} {:answer/id #uuid "f1c24ae1-987c-52e7-81fe-5a16178072dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}\\operatorname{cos}⁡{55}^{∘}" :db/id #edb/ref 17592186255782} {:answer/id #uuid "f3389054-48e3-5025-9361-e8574b467c1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{cos}⁡{110}^{∘}" :db/id #edb/ref 17592186255799}] :answer-field/correct {:answer/id #uuid "157cee2f-b39d-5759-8141-9311f65baea4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}\\operatorname{cos}⁡{110}^{∘}" :db/id #edb/ref 17592186253857} :answer-field/id #uuid "20eaadd3-fcd2-5ba3-9fe8-b461ce34013a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186255977}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "de163629-b9d5-5fdd-bc23-30faf9d38fa4" :question/math-academy-id "q-120362" :question/problem "Express $\\sqrt{2}-2\\sqrt{2}{sin}^{2}⁡{55}^{∘}$ as a single trigonometric ratio." :question/worked-solution "Our expression can be factored as follows:\n\n$$\n\\sqrt{2}(1-2{sin}^{2}⁡{55}^{∘})\n$$\n\nNow, let's recall the double-angle formula for cosine:\n\n$$\n1-2{sin}^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x={55}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}1-2{sin}^{2}⁡{55}^{∘} & =\\operatorname{cos}⁡(2\\cdot {55}^{∘})=\\operatorname{cos}⁡{110}^{∘}.\\end{aligned}\n$$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}\\sqrt{2}(1-2{sin}^{2}⁡{55}^{∘}) & =\\sqrt{2}\\operatorname{cos}⁡{110}^{∘}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186060004 :knowledge-point/_questions [{:db/id #edb/ref 17592186059670 :knowledge-point/id #uuid "e6eef35a-3502-5429-bd71-fb5bd0e8efc8" :knowledge-point/title "Identifying Extrema on Transformed Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0737c6dd-2968-5cc9-a8f8-c0079a8268a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,5)" :db/id #edb/ref 17592186253724} {:answer/id #uuid "2173f031-3969-54c9-823a-49ff47d49386" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,4)" :db/id #edb/ref 17592186253967} {:answer/id #uuid "75bbd111-a6df-57f9-ac2f-45af1364cecd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,3)" :db/id #edb/ref 17592186254712} {:answer/id #uuid "8398ba0c-a692-519d-9e74-4243e928998b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,2)" :db/id #edb/ref 17592186254841} {:answer/id #uuid "acc2456f-4e14-5655-aa35-0e7518c63750" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,4)" :db/id #edb/ref 17592186255193}] :answer-field/correct {:answer/id #uuid "2173f031-3969-54c9-823a-49ff47d49386" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,4)" :db/id #edb/ref 17592186253967} :answer-field/id #uuid "7037b1e7-eb89-5813-ae66-13b1ef312f28" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256125}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bce89a1c-1788-5140-a53a-cfabf6eebe67" :question/math-academy-id "q-121221" :question/problem "![](images/1e/1eb29eb3eb3627e24a23d7315295a1d889308d67895f9b798dbf9dd71ba226df.png)\n\nThe diagram above shows the local minimum and maximum of the function $y=f(x).$ What is the local maximum of $y=f(x-2)+1?$" :question/worked-solution "Notice that the graph of $y=f(x-2)+1$ can be obtained from the graph of $y=f(x)$ by \n\n- translating it by $2$ units to the right, and then\n\n- translating it by $1$ unit up.\n\nSince these transformations do not flip the graph across the $x$-axis, the combined transformation maps the local maximum of $y=f(x)$ to the local maximum of $y=f(x-2)+1.$ So, we need to find the image of $(2,3),$ the local maximum of $y=f(x),$ under the transformation. \n\nTo plot $y=f(x-2)+1,$ we apply the following steps: \n\n- First, we take the graph $y=f(x)$ that passes through $(2,3).$\n\n- Then, we shift the graph horizontally by $2$ units to the right and get the graph of $y=f(x-2).$ After this transformation, the point $(2,3)$ will be mapped to the point\n\n$$\n(2+2,3)=(4,3).\n$$\n\n- Finally, we shift the result vertically by $1$ unit upward and get the graph of $y=f(x-2)+1.$ After this transformation, the point $(4,3)$ will be mapped to the point\n\n$$\n(4,3+1)=(4,4).\n$$\n\nTherefore, the local maximum of $y=f(x-2)+1$ is $(4,4).$"}] [{:db/id #edb/ref 17592186256539 :knowledge-point/_questions [{:db/id #edb/ref 17592186059668 :knowledge-point/id #uuid "0bd940e7-fccc-5811-b07a-11e4843b1785" :knowledge-point/title "Finding a Point That Lies on a Transformed Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "165e3ec5-5bc9-5cba-9c8a-6b6ebe75a58b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(a-2,b+3)" :db/id #edb/ref 17592186253863} {:answer/id #uuid "5828d10b-52d2-519e-94d5-63d2d5b4c550" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(a-2,b-3)" :db/id #edb/ref 17592186254445} {:answer/id #uuid "74fc90a5-c321-5fe2-a988-759338bbb191" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(a-2,3b)" :db/id #edb/ref 17592186254707} {:answer/id #uuid "b59d2443-c7bf-54dc-9108-20e2c63d903b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(a+2,b+3)" :db/id #edb/ref 17592186255271} {:answer/id #uuid "c709185f-e827-59eb-bd52-699c51a7e1b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(a+2,b-3)" :db/id #edb/ref 17592186255448}] :answer-field/correct {:answer/id #uuid "b59d2443-c7bf-54dc-9108-20e2c63d903b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(a+2,b+3)" :db/id #edb/ref 17592186255271} :answer-field/id #uuid "ca534256-c181-5ac0-b56d-2d5a591a2172" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256283}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9b584cb7-ff23-5cf8-a53c-0371ad6cd2e4" :question/math-academy-id "q-121383" :question/problem "The point $(a,b)$ lies on the curve $y={2}^{x}.$ Which of the following points **must** lie on $y={2}^{x-2}+3?$" :question/worked-solution "**Method 1**\n\nTo plot $y={2}^{x-2}+3,$ we apply the following steps:\n\n- First, we take the graph $y={2}^{x}.$\n\n- Then, we shift the graph horizontally by $2$ units to the right and get the graph of $y={2}^{x-2}.$ After this transformation, the point $(a,b)$ will be mapped to the point\n\n$$\n(a+2,b).\n$$\n\n- Finally, we shift the result vertically by $3$ units up and obtain the graph of $y={2}^{x-2}+3.$ After this transformation, the point $(a+2,b)$ will be mapped to the point\n\n$$\n(a+2,b+3).\n$$\n\n**Method 2**\n\nSince the point $(a,b)$ lies on the graph of $y={2}^{x}$, we have that ${2}^{a}=b.$\n\nNow consider the graph of $y={2}^{x-2}+3.$ Substituting $x=a+2$, we get\n\n$$\n\\begin{aligned}y & ={2}^{a+2-2}+3 \\\\  & ={2}^{a}+3 \\\\  & =b+3.\\end{aligned}\n$$\n\nTherefore, the point $(a+2,b+3)$ must lie on $y={2}^{x-2}+3.$"}] [{:db/id #edb/ref 17592186256543 :knowledge-point/_questions [{:db/id #edb/ref 17592186059669 :knowledge-point/id #uuid "38b450bd-b43a-507c-9bbe-0aaf7a64a3ed" :knowledge-point/title "Finding a Point That Lies on a Transformed Curve Given Another Transformed Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30f927d8-7469-5f46-bcd8-ceb6220bf583" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,1)" :db/id #edb/ref 17592186254097} {:answer/id #uuid "5679b0cb-b917-5834-9cfc-21236c05bf34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,2)" :db/id #edb/ref 17592186254431} {:answer/id #uuid "8ddf4522-8bdc-5052-93ac-81ce5d766651" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,-1)" :db/id #edb/ref 17592186254921} {:answer/id #uuid "d96d1372-c430-5db2-a838-5534030331cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,3)" :db/id #edb/ref 17592186255597} {:answer/id #uuid "dc8c348e-dc48-52a8-a7a2-dcc717c081b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,4)" :db/id #edb/ref 17592186255624}] :answer-field/correct {:answer/id #uuid "30f927d8-7469-5f46-bcd8-ceb6220bf583" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,1)" :db/id #edb/ref 17592186254097} :answer-field/id #uuid "65ce4959-7406-5c8f-b9dc-e08ef35e4173" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256112}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e35c2dec-10c0-57fb-accb-533118e28579" :question/math-academy-id "q-121414" :question/problem "The point  $(4,8)$ lies on the curve $y=4f(x).$ Which of the following points **must** lie on $y=-f(x)+3?$" :question/worked-solution "**Method 1**\n\nWe first find a point corresponding to $(4,8)$ on $y=f(x).$ Then, we find a corresponding point on $y=-f(x)+3:$\n\n- To plot the graph of $y=f(x),$ we apply the following steps:\n\n- First, take the graph $y=4f(x).$\n\n- Then, we stretch the graph by a scale factor of $\\frac{1}{4}$ parallel to the $y$-axis and get the graph of $y=f(x).$ After this transformation, the point $(4,8)$ will be mapped to the point\n\n$$\n(4,\\frac{1}{4}\\cdot 8)=(4,2).\n$$\n\n- Next, to plot the graph of $y=-f(x)+3,$ we apply the following steps:\n\n- First, take the graph $y=f(x).$\n\n- Then, we reflect the result across the $x$-axis and get the graph of $y=-f(x).$ After this transformation, the point $(4,2)$ will be mapped  to the point\n\n$$\n(4,-(2))=(4,-2).\n$$\n\n- Next, we shift the result vertically by $3$ units up and obtain the graph of $y=-f(x)+3.$ After this transformation, the point $(4,-2)$ will be mapped to the point \n\n$$\n(4,-2+3)=(4,1).\n$$\n\n**Method 2**\n\nSince the point $(4,8)$ lies on the graph of $y=4f(x)$, we have that \n\n$$\n4f(4)=8\\,⟹\\,f(4)=2.\n$$\n\nNow consider the graph of $y=-f(x)+3.$ Substituting $x=4$, we get\n\n$$\n\\begin{aligned}y & =-f(4)+3 \\\\  & =-2+3 \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the point $(4,1)$ must lie on $y=-f(x)+3.$"}] [{:db/id #edb/ref 17592186256573 :knowledge-point/_questions [{:db/id #edb/ref 17592186059792 :knowledge-point/id #uuid "94cbd132-72fc-5645-bca3-9c81b6ac3845" :knowledge-point/title "Applying the Rule of Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11db05bd-9ab4-556b-b08c-5f413ae1deb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186253826} {:answer/id #uuid "3e9c00e8-1605-5a95-892e-22c5d0a9f5e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186254209} {:answer/id #uuid "59eb34f9-6e61-5d97-9fe1-18b606c71948" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186254456} {:answer/id #uuid "7a4d43af-6ef7-5ca9-bd63-044dde0b062c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186254754} {:answer/id #uuid "a24e86cc-f14d-5bae-9f2d-dcd6f5e4d085" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186255101}] :answer-field/correct {:answer/id #uuid "3e9c00e8-1605-5a95-892e-22c5d0a9f5e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186254209} :answer-field/id #uuid "cbec9b8e-d8d1-568e-ab48-073ed75855c6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256287}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9c584242-8e22-52ce-9821-6c8dee361ca3" :question/math-academy-id "q-122083" :question/problem "A theme park has $5$ roller coasters, $7$ flat rides, and $3$ dark rides. How many choices are there to select a single attraction?" :question/worked-solution "In order to find the total number of choices, we can use the **rule of sum**:\n\n$$\n5+7+3=15\n$$\n\nTherefore, there are $15$ choices of attractions."}] [{:db/id #edb/ref 17592186256585 :knowledge-point/_questions [{:db/id #edb/ref 17592186083223 :knowledge-point/id #uuid "e7c35604-c9f9-5077-bddc-fe9446ac45e6" :knowledge-point/title "Calculating a Permutation Given Using Alternate Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01148ac2-6ac0-5e04-93a7-3196fa35ad68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186253676} {:answer/id #uuid "35ae1d72-23d6-596a-879c-e800c845afc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186254129} {:answer/id #uuid "7d173d10-18ea-5551-a7bb-790b842d29e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186254778} {:answer/id #uuid "89a0aaaa-e6ea-5b09-becc-419140f14d82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186254889} {:answer/id #uuid "a8d42a24-5e98-57ea-b711-10a196072802" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "360" :db/id #edb/ref 17592186255155}] :answer-field/correct {:answer/id #uuid "01148ac2-6ac0-5e04-93a7-3196fa35ad68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186253676} :answer-field/id #uuid "9f70b4b3-8dd0-51e3-bea1-f70ad540b925" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256207}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "18f22bc1-36af-522d-b473-f6bd873bb081" :question/math-academy-id "q-122216" :question/problem "Evaluate $P(6,3).$" :question/worked-solution "The formula for ${}_{n}{P}_{r}$ is given by\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}\\,.\n$$\n\n$P(6,3)$ means the same thing as ${}_{6}{P}_{3}.$ Using the usual formula for ${}_{n}{P}_{r},$ we get\n\n$$\n\\begin{aligned}P(6,3) & =\\frac{6!}{(6-3)!} \\\\  & =\\frac{6!}{3!} \\\\  & =\\frac{6\\cdot 5\\cdot 4\\cdot \\cancel{3!}}{\\cancel{3!}} \\\\  & =6\\cdot 5\\cdot 4 \\\\  & =120.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256589 :knowledge-point/_questions [{:db/id #edb/ref 17592186083221 :knowledge-point/id #uuid "060e80f0-44bd-5378-9253-999548115dd9" :knowledge-point/title "Calculating the Number of Permutations of Objects Chosen From a Group Fewer Than Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "561397ca-0aaf-55cf-acb7-9f2f45914f62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186254426} {:answer/id #uuid "72fdbf28-1f9a-569a-9245-1a70198fbda6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186254689} {:answer/id #uuid "bc05cfc5-d8ad-5018-a2e9-831c14936249" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186255350} {:answer/id #uuid "f609c15b-ded6-52da-b36c-13f39f37d49b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186255823} {:answer/id #uuid "fd37e614-e084-5355-9cab-722e12ed06b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186255895}] :answer-field/correct {:answer/id #uuid "f609c15b-ded6-52da-b36c-13f39f37d49b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186255823} :answer-field/id #uuid "05ff70b8-903e-5a0d-92b5-def57d33a213" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186255925}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "25fc1043-9206-5ece-b5e7-cb7b2c40f5c7" :question/math-academy-id "q-122233" :question/problem "Ashley has $5$ tasks. She decides to do one on Thursday and another on Friday. How many different choices of the two tasks does Ashley have?" :question/worked-solution "The number of permutations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}.\n$$\n\nThere are $5$ tasks to choose from, so $n=5.$ We want to select $2$ of those for Ashley to do, so we have $r=2.$ \n\nTherefore, the number of different choices is\n\n$$\n\\begin{aligned}{}_{5}{P}_{2} & =\\frac{5!}{(5-2)!} \\\\  & =\\frac{5!}{3!} \\\\  & =\\frac{5\\cdot 4\\cdot \\cancel{3!}}{\\cancel{3!}} \\\\  & =5\\cdot 4 \\\\  & =20.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256597 :knowledge-point/_questions [{:db/id #edb/ref 17592186083317 :knowledge-point/id #uuid "c07eb336-1ac8-5633-abaf-fcfca4c12bd1" :knowledge-point/title "Using The Law of Total Probability Stated in Terms of Intersections"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c0a398a-a39e-5d7a-b21e-9951160886d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{51}" :db/id #edb/ref 17592186253905} {:answer/id #uuid "43b6e1e0-72b9-5214-b851-80c0c8ac14b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{102}" :db/id #edb/ref 17592186254248} {:answer/id #uuid "68809187-f417-5b7f-b53c-352c15bacc85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14}{51}" :db/id #edb/ref 17592186254614} {:answer/id #uuid "a1351cab-316e-5c01-a778-a2d8194cac2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{51}" :db/id #edb/ref 17592186255087} {:answer/id #uuid "ba7cb6a7-d137-5ea5-a3d4-8a5744941442" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186255331}] :answer-field/correct {:answer/id #uuid "a1351cab-316e-5c01-a778-a2d8194cac2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{51}" :db/id #edb/ref 17592186255087} :answer-field/id #uuid "9e45a2b1-1c88-5f68-8900-758b9b643962" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256205}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "723e5d66-e944-5f06-8fda-5b320d046477" :question/math-academy-id "q-122299" :question/problem "Ann has two shuffled $52$-card decks of playing cards, $A$ and $B.$ $2$ red cards of deck $B$ were lost. The cards of the two decks are mixed together. What is the probability that a randomly selected card from the resulting set of cards is red?\n\n*Hint: A standard $52$-card deck contains $26$ red cards and $26$ black cards.*" :question/worked-solution "Let $R$ be the event that the selected card is red, and let $A$ be the event that the card was one of the cards of deck $A.$ Then ${A}^{′}$ is the event that the card was one of the cards of deck $B.$\n\nTo calculate the probability that a randomly selected card is red, we can use the law of total probability:\n\n$$\nP(R)=P(R\\cap A)+P(R\\cap {A}^{′})\n$$\n\nTo calculate $P(R\\cap A),$ we take the number of red cards in deck $A$ $(26)$ and divide by the total number of cards in both decks $(52+50=102).$ So, we have\n\n$$\nP(R\\cap A)=\\frac{26}{102}.\n$$\n\nSimilarly, to calculate $P(R\\cap {A}^{′}),$ we take the number of red cards in deck $B$ $(24)$ and divide by the total number of cards in both decks $(102).$ So, we have\n\n$$\nP(R\\cap {A}^{′})=\\frac{24}{102}.\n$$\n\nFinally, substituting the above information into the law of total probability, the probability that a randomly selected card from either deck is red is\n\n$$\n\\begin{aligned}P(R) & =P(R\\cap A)+P(R\\cap {A}^{′}) \\\\  & =\\frac{26}{102}+\\frac{24}{102} \\\\  & =\\frac{25}{51}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186387201 :knowledge-point/_questions [{:db/id #edb/ref 17592186083222 :knowledge-point/id #uuid "256d3a08-0ade-51e9-887b-67250d5fae21" :knowledge-point/title "Calculating the Number of Permutations of Objects Chosen From a Group of at Least Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "259822a5-969c-59bd-9409-203032b8e5c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "151\\,200" :db/id #edb/ref 17592186387203} {:answer/id #uuid "3abdd947-03f1-5fe3-acea-f4487dafdafc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,024" :db/id #edb/ref 17592186387204} {:answer/id #uuid "16948774-922d-5453-867e-9d6ae6b1b44d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100\\,000" :db/id #edb/ref 17592186387205} {:answer/id #uuid "a3a7f2b7-c75d-5c1f-8bac-5e57c8a4dbd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30\\,240" :db/id #edb/ref 17592186387206} {:answer/id #uuid "e8cb95f4-d026-5528-8f18-e7dc00345196" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186387207}] :answer-field/correct {:answer/id #uuid "a3a7f2b7-c75d-5c1f-8bac-5e57c8a4dbd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30\\,240" :db/id #edb/ref 17592186387206} :answer-field/id #uuid "3f3ce0b2-9f8b-54dc-a549-62477751c6e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387202}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8f3b348f-3d24-534c-8714-77102243eca3" :question/math-academy-id "q-122476" :question/problem "How many $5$-letter words (legitimate or made-up) can be made using the letters of the word ALGORITHMS, where each letter cannot appear in the word more than once?" :question/worked-solution "The number of permutations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}.\n$$\n\nThere are $10$ different letters in the word ALGORITHMS, so $n=10.$ We want to select $5$ of those letters to make a $5$-letter word, so we have $r=5.$\n\nTherefore, the number of different made-up words is\n\n$$\n\\begin{aligned}{}_{10}{P}_{5} & =\\frac{10!}{(10-5)!} \\\\  & =\\frac{10!}{5!} \\\\  & =\\frac{10\\cdot 9\\cdot 8\\cdot 7\\cdot 6\\cdot \\cancel{5!}}{\\cancel{5!}} \\\\  & =10\\cdot 9\\cdot 8\\cdot 7\\cdot 6 \\\\  & =30\\,240.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256646 :knowledge-point/_questions [{:db/id #edb/ref 17592186083231 :knowledge-point/id #uuid "320acdc4-d3ca-5bc8-85de-cea9cc2fa9c3" :knowledge-point/title "Evaluating Combinations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18c0452b-d15f-5899-a436-dd8642dcc5db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186253881} {:answer/id #uuid "250d9ed9-66b7-5b3b-8feb-de5189f93ec5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186254001} {:answer/id #uuid "912d1654-2a1f-5d20-89d6-9699fc40e068" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186254945} {:answer/id #uuid "95e34277-0d88-5bd4-857c-f822beece5d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "720" :db/id #edb/ref 17592186254990} {:answer/id #uuid "b155eb0e-3c35-5aad-9152-3a0752bb0aaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186255228}] :answer-field/correct {:answer/id #uuid "250d9ed9-66b7-5b3b-8feb-de5189f93ec5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186254001} :answer-field/id #uuid "50f4be61-f116-5a13-a35d-96e6d7b36613" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256081}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6cf19641-6883-5510-a800-b65cf3b840e8" :question/math-academy-id "q-122491" :question/problem "Evaluate ${}_{6}{C}_{3}.$" :question/worked-solution "In general, the number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nSubstituting $n=6$ and $r=3,$ we get\n\n$$\n\\begin{aligned}{}_{6}{C}_{3} & =\\frac{6!}{(6-3)!\\,3!} \\\\  & =\\frac{6!}{3!\\,3!} \\\\  & =\\frac{6\\cdot 5\\cdot 4\\cdot \\cancel{3!}}{\\cancel{3!}3!} \\\\  & =\\frac{6\\cdot 5\\cdot 4}{6} \\\\  & =20.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256647 :knowledge-point/_questions [{:db/id #edb/ref 17592186083231 :knowledge-point/id #uuid "320acdc4-d3ca-5bc8-85de-cea9cc2fa9c3" :knowledge-point/title "Evaluating Combinations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "111aa603-0355-57ff-8921-275edb48d538" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,991\\,680" :db/id #edb/ref 17592186253818} {:answer/id #uuid "15096900-5ab9-5f2b-bb35-78154801a683" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "792" :db/id #edb/ref 17592186253852} {:answer/id #uuid "1e57cf5c-3e