#{[{:db/id #edb/ref 17592186338971 :knowledge-point/_questions [{:db/id #edb/ref 17592186064181 :knowledge-point/id #uuid "9836abbe-e172-5c2f-8b19-145ef6d5c02d" :knowledge-point/title "Integrating Cosecant Squared"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29f94094-a13e-59d3-8e01-6476ad259936" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sec⁡ytan⁡y+C" :db/id #edb/ref 17592186336421} {:answer/id #uuid "4bbf7e18-db54-5ad4-94b3-6740e294fa86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "tan⁡y+C" :db/id #edb/ref 17592186336736} {:answer/id #uuid "5a246749-d6a8-5b61-ab0c-eb37e92ba4e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-tan⁡y+C" :db/id #edb/ref 17592186336853} {:answer/id #uuid "7eef5879-dbe7-5b97-97a6-26e4a74a9d5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cot⁡y+C" :db/id #edb/ref 17592186337182} {:answer/id #uuid "cbbba5ec-56d3-5218-abf9-36a5e07211a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-cot⁡y+C" :db/id #edb/ref 17592186337821}] :answer-field/correct {:answer/id #uuid "7eef5879-dbe7-5b97-97a6-26e4a74a9d5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cot⁡y+C" :db/id #edb/ref 17592186337182} :answer-field/id #uuid "709f437f-6931-5254-8a8a-e5df59c326ec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338469}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e6d46060-4d10-5e18-98aa-e065865069a6" :question/math-academy-id "q-71664" :question/problem "$\\int -{csc}^{2}⁡y\\,\\text{d}y=$" :question/worked-solution "Recall that \n\n$$\n\\int {csc}^{2}⁡y\\,\\text{d}y=-cot⁡y+C\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int -{csc}^{2}⁡y\\,\\text{d}y & =-\\int {csc}^{2}⁡y\\,\\text{d}y \\\\  & =-(-cot⁡y)+C \\\\  & =cot⁡y+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339009 :knowledge-point/_questions [{:db/id #edb/ref 17592186064171 :knowledge-point/id #uuid "3f9548e6-28ef-5a97-ab04-dfb1b6e23c16" :knowledge-point/title "Integrating the Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23784fc4-3a90-53e4-89bb-df7f53cf6d59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{x}+C" :db/id #edb/ref 17592186336365} {:answer/id #uuid "2c3c2a30-99f8-537b-8508-e5713aa27c9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{2x}+C" :db/id #edb/ref 17592186336450} {:answer/id #uuid "67383a40-44c5-5a00-bfa0-07f13c0dcbe6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{x}+C" :db/id #edb/ref 17592186336953} {:answer/id #uuid "b945ae93-7849-5d6e-b645-1e8c14a1d6cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{1/2x}+C" :db/id #edb/ref 17592186337675} {:answer/id #uuid "fbb744da-ccfd-5f44-8169-07909ef53f32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{x}+C" :db/id #edb/ref 17592186338242}] :answer-field/correct {:answer/id #uuid "23784fc4-3a90-53e4-89bb-df7f53cf6d59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{x}+C" :db/id #edb/ref 17592186336365} :answer-field/id #uuid "f9fc2e0f-aa1f-50b5-8ba0-74df5403bd7c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338718}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7119fae9-f265-530e-8dcf-9a8fd6ab825e" :question/math-academy-id "q-71900" :question/problem "$\\int \\frac{1}{2}{e}^{x}\\,\\text{d}x=$" :question/worked-solution "Factoring out the constant $\\frac{1}{2}$ and calculating the resulting integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{1}{2}{e}^{x}\\,\\text{d}x & =\\frac{1}{2}\\int {e}^{x}\\,\\text{d}x \\\\  & =\\frac{1}{2}{e}^{x}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339023 :knowledge-point/_questions [{:db/id #edb/ref 17592186096843 :knowledge-point/id #uuid "0a312840-0d35-50bb-94b3-b04778f4efc3" :knowledge-point/title "Differentiating a Function Using the Chain Rule and Prime Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d2f6517-e258-513a-b912-2250e7c54e17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15(2+5x{)}^{2}" :db/id #edb/ref 17592186336461} {:answer/id #uuid "3b2c8729-231c-5b49-a873-246a32aa4645" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15(2-5x{)}^{3}" :db/id #edb/ref 17592186336588} {:answer/id #uuid "77d335ef-89db-5392-8e96-2e5663d37f72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15(2+5x{)}^{2}" :db/id #edb/ref 17592186337111} {:answer/id #uuid "84c34e15-f7f7-51bd-91ad-be1849bcac42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15(2-5x{)}^{2}" :db/id #edb/ref 17592186337229} {:answer/id #uuid "ba6755f1-59bc-5601-b289-66317d2b0d63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15(2-5x{)}^{2}" :db/id #edb/ref 17592186337682}] :answer-field/correct {:answer/id #uuid "ba6755f1-59bc-5601-b289-66317d2b0d63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15(2-5x{)}^{2}" :db/id #edb/ref 17592186337682} :answer-field/id #uuid "20dca297-5492-547a-957c-959f9e7520f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338339}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ccad926b-6344-5bec-99bc-507d50cda1e3" :question/math-academy-id "q-71956" :question/problem "Given that $f(x)={(2-5x)}^{3},$ find ${f}^{′}(x).$" :question/worked-solution "Let $g(x)=2-5x$ and $f(g(x))=g(x{)}^{3}.$ \n\nDifferentiating, we have\n\n$$\n\\begin{aligned}{f}^{′}(g(x)) & =({g}^{3}{)}^{′}=3{g}^{2}, \\\\ {g}^{′}(x) & =(2-5x{)}^{′}=-5.\\end{aligned}\n$$\n\nThen, using the chain rule, \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={f}^{′}(g(x))\\cdot {g}^{′}(x) \\\\  & =3{g}^{2}\\cdot (-5) \\\\  & =-15(2-5x{)}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339038 :knowledge-point/_questions [{:db/id #edb/ref 17592186087846 :knowledge-point/id #uuid "37a4168b-1425-5f3a-a577-4b5884906a52" :knowledge-point/title "Calculating the Sum of a Complex Number and Its Conjugate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "131e439a-9165-56c6-8fdd-b21c8dea91e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8+14\\text{i}" :db/id #edb/ref 17592186336212} {:answer/id #uuid "1b6aa3b5-1f23-581f-bd0e-52f0682b50a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186336285} {:answer/id #uuid "1e6f5eb4-3b18-507b-9c32-4ce046ab8046" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186336313} {:answer/id #uuid "d95dea67-8da9-5f2b-8c58-9a5fb247332b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\text{i}" :db/id #edb/ref 17592186337923} {:answer/id #uuid "f90cfae7-9eea-5dc8-8b18-628804095bea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186338215}] :answer-field/correct {:answer/id #uuid "1b6aa3b5-1f23-581f-bd0e-52f0682b50a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186336285} :answer-field/id #uuid "bd3178b7-71a4-5c4f-9b23-601af5c49da4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338617}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "568e1d1c-4c3e-536f-acb0-c6800da06527" :question/math-academy-id "q-71986" :question/problem "If $z=4+7\\text{i}$, calculate $z+\\overset{―}{z}.$" :question/worked-solution "**Method 1**\n\nWhen we add a complex number and its conjugate, the result is always twice the real part of the complex number.\n\nFor the given complex number $z=4+7\\text{i},$ the real part is $Re(z)=4,$ so we have\n\n$$\n\\begin{aligned}z+\\overset{―}{z} & =2\\text{Re}(z) \\\\  & =2(4) \\\\  & =8.\\end{aligned}\n$$\n\n**Method 2**\n\nAlternatively, we can actually carry out the process of adding the complex number and its conjugate.\n\nTo obtain the conjugate of the complex number $z=4+7\\text{i},$ we flip the sign of the imaginary part and get $\\overset{―}{z}=4-7\\text{i}.$\n\nAdding, we get\n\n$$\n\\begin{aligned}z+\\overset{―}{z} & =(4+7\\text{i})+(4-7\\text{i}) \\\\  & =(4+4)+\\text{i}(7-7) \\\\  & =8+\\text{i}0 \\\\  & =8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064947 :knowledge-point/_questions [{:db/id #edb/ref 17592186064272 :knowledge-point/id #uuid "fa38f112-466c-50e9-ac08-be72b6f53782" :knowledge-point/title "Relating a Derivative to a Rate of Change"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "148eb00f-3a9c-5cde-b11e-4aa6e5df5baf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N(t)=r(t)" :db/id #edb/ref 17592186336227} {:answer/id #uuid "3ce9ccdf-1421-5fcb-b41e-795e91107452" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N(t)={r}^{′}(t)" :db/id #edb/ref 17592186336606} {:answer/id #uuid "3d4ac506-d0f2-599b-b8f3-e6dce6983161" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{N}^{′}(t)=r(t)" :db/id #edb/ref 17592186336611} {:answer/id #uuid "80a522d2-bd93-5515-9735-bcaf1eb17692" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N(t)=-{r}^{′}(t)" :db/id #edb/ref 17592186337197} {:answer/id #uuid "e3743113-4ad5-561d-af41-cbb9230afbba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{N}^{′}(t)=-r(t)" :db/id #edb/ref 17592186338017}] :answer-field/correct {:answer/id #uuid "3d4ac506-d0f2-599b-b8f3-e6dce6983161" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{N}^{′}(t)=r(t)" :db/id #edb/ref 17592186336611} :answer-field/id #uuid "874c5434-9157-538e-be59-176244d35d61" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338525}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "97f8f938-0d50-59f5-922b-f7bea8bb44f7" :question/math-academy-id "q-72004" :question/problem "Jason, a biologist, is measuring the growth of bacteria in a Petri dish by recording the following two numbers for different values of $t,$ where $t$ is the time, in hours, since he started his observations:\n\n- $N(t)$ - the number of bacteria in the dish.\n\n- $r(t)$ - the rate at which the number of bacteria in the dish is increasing.\n\nWhat is the relationship between $N(t)$ and $r(t)?$" :question/worked-solution "The function $N(t)$ gives the number of bacteria inside the dish after $t$ hours. Then,\n\n$$\n{N}^{′}(t)=\\frac{\\text{d}N(t)}{\\text{d}t}=\\frac{\\text{Change in }N}{\\text{Change in }t}.\n$$\n\nThus, ${N}^{′}(t)$ gives the rate at which the number of bacteria is increasing at time $t$, which is the same as $r(t).$ Therefore, the relationship between $N(t)$ and $r(t)$ is ${N}^{′}(t)=r(t).$"}] [{:db/id #edb/ref 17592186339052 :knowledge-point/_questions [{:db/id #edb/ref 17592186105715 :knowledge-point/id #uuid "cf98ee24-7774-5674-8a1e-63f4f6d225c0" :knowledge-point/title "Integrating a Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f88c79e-e25c-5fcd-a473-3f9adb3d4e9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{7}}{7}ln⁡|x|+C" :db/id #edb/ref 17592186336327} {:answer/id #uuid "58b493c2-73d3-5db1-af15-0200a2937632" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{7}}{ln⁡|x|}+C" :db/id #edb/ref 17592186336844} {:answer/id #uuid "daf20704-2d65-5753-af90-f6e026c52e12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{7}ln⁡|x|+C" :db/id #edb/ref 17592186337940} {:answer/id #uuid "ec4261ce-b5b3-5551-9fbd-56937e1eea24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{\\sqrt{7}}ln⁡|x|+C" :db/id #edb/ref 17592186338091} {:answer/id #uuid "f7a97ce9-ff10-5758-b496-1ffe87d0bb3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-ln⁡|\\sqrt{7}x|+C" :db/id #edb/ref 17592186338202}] :answer-field/correct {:answer/id #uuid "1f88c79e-e25c-5fcd-a473-3f9adb3d4e9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{7}}{7}ln⁡|x|+C" :db/id #edb/ref 17592186336327} :answer-field/id #uuid "f930863c-55bb-55cc-bd9d-51b8ae4abea3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338715}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d9daecf1-e255-5c0c-a433-fdc798f551aa" :question/math-academy-id "q-72059" :question/problem "Calculate $\\int -\\frac{1}{\\sqrt{7}x}\\,\\text{d}x.$" :question/worked-solution "First, we apply the constant factor rule and take the coefficient $-\\frac{1}{\\sqrt{7}}=-\\frac{1}{\\sqrt{7}}\\frac{\\sqrt{7}}{\\sqrt{7}}=-\\frac{\\sqrt{7}}{7}$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int -\\frac{1}{\\sqrt{7}x}\\,\\text{d}x & =-\\frac{1}{\\sqrt{7}}\\int \\frac{1}{x}\\,\\,\\text{d}x \\\\  & =-\\frac{\\sqrt{7}}{7}ln⁡|x|+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339059 :knowledge-point/_questions [{:db/id #edb/ref 17592186064152 :knowledge-point/id #uuid "159b4d58-b34d-52cd-aad2-2c058f772ad2" :knowledge-point/title "Interpreting the Derivative of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08f73173-53b3-594c-9f00-73f6211f3aba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The rate at which the perimeter changes as each side changes" :db/id #edb/ref 17592186336106} {:answer/id #uuid "2f86ab33-c24f-513c-9f78-18726fd0321b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The rate at which the area changes as each side changes" :db/id #edb/ref 17592186336488} {:answer/id #uuid "8526b1a3-6e9c-580f-9c0b-82c5736c43b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The rate at which each side changes as the perimeter changes" :db/id #edb/ref 17592186337231} {:answer/id #uuid "95ba1001-8463-59e2-bed5-38495c9afaab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The rate at which the perimeter changes as the area changes" :db/id #edb/ref 17592186337400} {:answer/id #uuid "eddb83ed-12b2-59b9-8dd1-0e4ed245941a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The rate at which each side changes as the area changes" :db/id #edb/ref 17592186338109}] :answer-field/correct {:answer/id #uuid "08f73173-53b3-594c-9f00-73f6211f3aba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The rate at which the perimeter changes as each side changes" :db/id #edb/ref 17592186336106} :answer-field/id #uuid "aa385052-bba0-5f25-abff-7baf2aaa746f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338590}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c47d8541-4bf8-5eff-901b-cba03fe2cd37" :question/math-academy-id "q-72104" :question/problem "Consider a regular pentagon such that the length $s$ of each side varies. What is the best interpretation of ${P}^{′}(s)$ if $P$ is the perimeter of the pentagon?" :question/worked-solution "The function $P(s)$ gives the perimeter of a pentagon with side $s.$ So,\n\n$$\n{P}^{′}(s)=\\frac{\\text{d}P}{\\text{d}s}=\\frac{\\text{Change in }P}{\\text{Change in }s}.\n$$\n\nTherefore, ${P}^{′}(s)$ is the rate at which the perimeter changes as each side changes."}] [{:db/id #edb/ref 17592186339060 :knowledge-point/_questions [{:db/id #edb/ref 17592186064272 :knowledge-point/id #uuid "fa38f112-466c-50e9-ac08-be72b6f53782" :knowledge-point/title "Relating a Derivative to a Rate of Change"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bd3314e-09b5-5ed6-b34d-9c8eb2cd078f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{A}^{′}(t)=r(t)" :db/id #edb/ref 17592186336291} {:answer/id #uuid "5f89b95a-dc2f-5355-a891-5f7ad0897f2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A(t)=-{r}^{′}(t)" :db/id #edb/ref 17592186336898} {:answer/id #uuid "d84adbce-e1e5-541f-ae42-248e49f85aef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{A}^{′}(t)=-r(t)" :db/id #edb/ref 17592186337909} {:answer/id #uuid "eb90804a-9cb1-5c0e-93ff-93893405ab87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A(t)={r}^{′}(t)" :db/id #edb/ref 17592186338088} {:answer/id #uuid "f843d514-c114-567f-8b4e-d0d7f91897e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A(t)=r(t)" :db/id #edb/ref 17592186338207}] :answer-field/correct {:answer/id #uuid "1bd3314e-09b5-5ed6-b34d-9c8eb2cd078f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{A}^{′}(t)=r(t)" :db/id #edb/ref 17592186336291} :answer-field/id #uuid "27c52aef-834f-5c1c-9709-b11a313c17d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338353}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4da77317-b047-59f4-8384-7a00ca57d0df" :question/math-academy-id "q-72105" :question/problem "Douglas, a pilot, is flying a plane. The plane's control systems record two measurements for different values of $t,$ where $t$ is the time, in minutes, since take off. The two measurements are:\n\n- $A(t)$ - the altitude (height) of the plane\n\n- $r(t)$ the rate at which the altitude is increasing\n\nWhat is the relationship between $A(t)$ and $r(t)?$" :question/worked-solution "The function $A(t)$ gives the altitude of the plane after $t$ hours. Then,\n\n$$\n{A}^{′}(t)=\\frac{\\text{d}A(t)}{\\text{d}t}=\\frac{\\text{Change in }A}{\\text{Change in }t}.\n$$\n\nThus, ${A}^{′}(t)$ gives the rate at which the altitude is increasing at time $t$, which is the same as $r(t).$ Therefore, the relationship between $A(t)$ and $r(t)$ is ${A}^{′}(t)=r(t).$"}] [{:db/id #edb/ref 17592186339066 :knowledge-point/_questions [{:db/id #edb/ref 17592186064284 :knowledge-point/id #uuid "a483e892-90f2-51f4-80cd-2b1200cd0c37" :knowledge-point/title "Differentiating a Composition of Trigonometric Functions Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35d0b5a0-960c-537b-b36b-f81b09719172" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{sec}⁡x\\operatorname{tan}⁡(-\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186336532} {:answer/id #uuid "8659cf38-7f28-521b-9eb6-a1f4bb5d55a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{sin}⁡x\\operatorname{sec}⁡(-\\operatorname{sin}⁡x)\\operatorname{tan}⁡(-\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186337248} {:answer/id #uuid "cf2b4496-4d43-50c5-b8f4-50cbe3748941" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{cos}⁡x\\operatorname{sec}⁡(\\operatorname{cos}⁡x)\\operatorname{tan}⁡(\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186337845} {:answer/id #uuid "e5a21dd0-44ef-54d6-bc1c-1c98a20cbcd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{sin}⁡x\\operatorname{sec}⁡x\\operatorname{tan}⁡(\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186338037} {:answer/id #uuid "f7b439b8-4fb4-5bd2-b82d-c5283f54f75b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\operatorname{sin}⁡x\\operatorname{sec}⁡(\\operatorname{cos}⁡x)\\operatorname{tan}⁡(\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186338204}] :answer-field/correct {:answer/id #uuid "f7b439b8-4fb4-5bd2-b82d-c5283f54f75b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\operatorname{sin}⁡x\\operatorname{sec}⁡(\\operatorname{cos}⁡x)\\operatorname{tan}⁡(\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186338204} :answer-field/id #uuid "76164faf-c99c-514d-8f55-17d4f55b16c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338480}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bdadc1fd-0dca-59ce-bd49-88a477cdb0a0" :question/math-academy-id "q-72173" :question/problem "Find the derivative of $y=3\\operatorname{sec}⁡(\\operatorname{cos}⁡x).$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=3\\operatorname{sec}⁡u,\\,u=\\operatorname{cos}⁡x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=3\\operatorname{sec}⁡u\\operatorname{tan}⁡u,\\,\\frac{\\text{d}u}{\\text{d}x}=-\\operatorname{sin}⁡x.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =3\\operatorname{sec}⁡u\\operatorname{tan}⁡u\\cdot (-\\operatorname{sin}⁡x) \\\\  & =-3\\operatorname{sin}⁡x\\operatorname{sec}⁡(\\operatorname{cos}⁡x)\\operatorname{tan}⁡(\\operatorname{cos}⁡x).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339079 :knowledge-point/_questions [{:db/id #edb/ref 17592186054677 :knowledge-point/id #uuid "619182bf-107d-5217-a306-ec4f7c1109eb" :knowledge-point/title "Finding the Derivative of a Function Given in Implicit Form Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b322d9c-37ab-52f7-9c7e-158b2aad5a2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}-2xy}{{x}^{2}+4}" :db/id #edb/ref 17592186336727} {:answer/id #uuid "4fa8641b-f12e-5282-8639-b287c9ca081d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{6x-xy}{{x}^{2}+4}" :db/id #edb/ref 17592186336764} {:answer/id #uuid "778b8f44-4e6f-5e84-b5d0-3856a65b2fcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6-2xy}{{x}^{2}+4}" :db/id #edb/ref 17592186337107} {:answer/id #uuid "8e0a7e37-7922-5237-be4e-0d4daf2edd15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6x-2y}{{x}^{2}+4}" :db/id #edb/ref 17592186337313} {:answer/id #uuid "d8ffdd28-a653-5368-a470-1763333eed55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6x+2xy}{{x}^{2}-4}" :db/id #edb/ref 17592186337920}] :answer-field/correct {:answer/id #uuid "4b322d9c-37ab-52f7-9c7e-158b2aad5a2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}-2xy}{{x}^{2}+4}" :db/id #edb/ref 17592186336727} :answer-field/id #uuid "f8ea9a9d-1024-53db-ae2f-47b539ab86b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338714}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3b84d5b9-93df-56c4-be18-4346c8b72764" :question/math-academy-id "q-72260" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for ${x}^{2}y+4y=2{x}^{3}.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\nNote that to differentiate the ${x}^{2}y$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}{x}^{2}y+4y & =2{x}^{3} \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2}y+4y) & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2}y)+\\frac{\\text{d}}{\\text{d}x}(4y) & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}) \\\\ [{x}^{2}\\frac{\\text{d}y}{\\text{d}x}+y\\cdot 2x]+4\\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2} \\\\ {x}^{2}\\frac{\\text{d}y}{\\text{d}x}+2xy+4\\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2}\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}{x}^{2}\\frac{\\text{d}y}{\\text{d}x}+4\\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2}-2xy \\\\ \\frac{\\text{d}y}{\\text{d}x}({x}^{2}+4) & =6{x}^{2}-2xy \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{6{x}^{2}-2xy}{{x}^{2}+4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186403550 :knowledge-point/_questions [{:db/id #edb/ref 17592186087822 :knowledge-point/id #uuid "79daf9dd-814d-562b-b3bc-b066bd2dfb90" :knowledge-point/title "Identifying the Shift Applied to an Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93a712bc-5c5d-5646-9703-82e77d69b46e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-3({3}^{x})" :db/id #edb/ref 17592186403552} {:answer/id #uuid "c63beba4-7686-58ae-845d-111254d3e6ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={3}^{x}-1" :db/id #edb/ref 17592186403553} {:answer/id #uuid "5996d30b-a352-5547-9b35-f09224ff8616" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={3}^{x}-3" :db/id #edb/ref 17592186403554} {:answer/id #uuid "e2d5db3c-106b-5a20-8512-215f226e23f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={3}^{x}-2" :db/id #edb/ref 17592186403555} {:answer/id #uuid "3d9e24e9-f8f1-50d2-a309-392b65ff2168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2({3}^{x})" :db/id #edb/ref 17592186403556}] :answer-field/correct {:answer/id #uuid "e2d5db3c-106b-5a20-8512-215f226e23f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={3}^{x}-2" :db/id #edb/ref 17592186403555} :answer-field/id #uuid "7f6e4f21-8993-51e5-a1c9-737356240b0e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403551}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bbca085f-0b60-5f9a-bdc1-1da6491170fe" :question/math-academy-id "q-7230" :question/problem "![](images/87/8764149ca0000522277d48bf48f4ef14ba06f7e4793ba1a58ef639ff7af3a3b9.png)\n\nThe graph above shows the curve $y={3}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={3}^{x}$ is $y=0.$ The vertical translation $y={3}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=-2.$ Therefore, $c=-2.$"}] [{:db/id #edb/ref 17592186403557 :knowledge-point/_questions [{:db/id #edb/ref 17592186087822 :knowledge-point/id #uuid "79daf9dd-814d-562b-b3bc-b066bd2dfb90" :knowledge-point/title "Identifying the Shift Applied to an Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "760d4f2f-67c3-578b-90ce-e44b5cc0e475" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={2}^{x}-2" :db/id #edb/ref 17592186403559} {:answer/id #uuid "a42ff124-ce1b-58ec-a4c4-728cb4b536df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-3({2}^{x})" :db/id #edb/ref 17592186403560} {:answer/id #uuid "9bb95f56-7efa-56a4-ab5b-5f4220d4b140" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={2}^{x}-3" :db/id #edb/ref 17592186403561} {:answer/id #uuid "840799e0-019f-5e56-960e-e4dce9f6a43e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={3}^{x}-4" :db/id #edb/ref 17592186403562} {:answer/id #uuid "97c4002b-68c4-5b92-bb46-3a3c52c7bbac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3({2}^{x})" :db/id #edb/ref 17592186403563}] :answer-field/correct {:answer/id #uuid "9bb95f56-7efa-56a4-ab5b-5f4220d4b140" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={2}^{x}-3" :db/id #edb/ref 17592186403561} :answer-field/id #uuid "117f36b7-d2dd-58cf-81f2-744857f29ebf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403558}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bb2d08ab-7e1f-579d-8314-e037ebc00133" :question/math-academy-id "q-7232" :question/problem "![](images/2a/2ad72b3df34f32d6a76f79f6801887bd6fe1d762fefd74071517a754b1890ac2.png)\n\nThe graph above shows the curve $y={2}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={2}^{x}$ is $y=0.$ The vertical translation $y={2}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=-3.$ Therefore, $c=-3.$"}] [{:db/id #edb/ref 17592186339090 :knowledge-point/_questions [{:db/id #edb/ref 17592186068690 :knowledge-point/id #uuid "9f29435f-b112-5999-b0ca-9003d9e622e1" :knowledge-point/title "Calculating an Indeterminate Limit of the Form Infinity Divided by Infinity Using L'Hopital's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2905b3c7-5120-5928-8659-ab7cf49215cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186336415} {:answer/id #uuid "9c9f02de-6945-5986-9bd6-77c4fda53a38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186337447} {:answer/id #uuid "c4c17bce-f321-5a5a-b8a2-e2f57aa0f0a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186337781} {:answer/id #uuid "d1424795-2c4b-569b-984c-33e713fb9a2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186337866} {:answer/id #uuid "f3baaf2a-856c-5b97-ba7e-56d8806079c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186338162}] :answer-field/correct {:answer/id #uuid "f3baaf2a-856c-5b97-ba7e-56d8806079c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186338162} :answer-field/id #uuid "1d342821-bbce-5fd1-b3bb-822b8446cf81" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338330}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "83ace1c9-0a10-59aa-bb99-7a86a6dbfa17" :question/math-academy-id "q-72333" :question/problem "Evaluate ${lim}_{x\\to {0}^{+}}\\frac{\\operatorname{ln}⁡x}{{e}^{1/x}}.$" :question/worked-solution "Here the limits of the numerator and denominator are ${lim}_{x\\to {0}^{+}}\\operatorname{ln}⁡x=-\\infty $ and ${lim}_{x\\to {0}^{+}}{e}^{1/x}=\\infty ,$ respectively, so we have the case $\\frac{-\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}\\frac{\\operatorname{ln}⁡x}{{e}^{1/x}} & ={lim}_{x\\to {0}^{+}}\\frac{[\\operatorname{ln}⁡x]^{′}}{[{e}^{1/x}]^{′}} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{(\\frac{1}{x})}{{e}^{1/x}(-\\frac{1}{{x}^{2}})} \\\\  & =-{lim}_{x\\to {0}^{+}}\\frac{{x}^{-1}}{{e}^{1/x}\\cdot {x}^{-2}} \\\\  & =-{lim}_{x\\to {0}^{+}}\\frac{x}{{e}^{1/x}} \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339092 :knowledge-point/_questions [{:db/id #edb/ref 17592186068690 :knowledge-point/id #uuid "9f29435f-b112-5999-b0ca-9003d9e622e1" :knowledge-point/title "Calculating an Indeterminate Limit of the Form Infinity Divided by Infinity Using L'Hopital's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dd6dd70-5f78-54b6-ac97-950f2f384aef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186336473} {:answer/id #uuid "4e08260e-b4f6-5c7a-ad2d-8294f523a3ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186336757} {:answer/id #uuid "5b538add-4209-5721-8b56-652729cc391f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186336862} {:answer/id #uuid "7d7564a4-f738-5faf-a2c3-bdd625a0ef99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186337163} {:answer/id #uuid "bb83b45c-700e-5a49-955e-7ea35708e865" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186337697}] :answer-field/correct {:answer/id #uuid "4e08260e-b4f6-5c7a-ad2d-8294f523a3ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186336757} :answer-field/id #uuid "64250102-7382-5959-9fea-4e5f4501809d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338454}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d0dae206-0030-50d7-a470-3e9d541986a9" :question/math-academy-id "q-72336" :question/problem "Evaluate ${lim}_{x\\to 0}\\frac{(\\frac{1}{{x}^{2}})}{(\\frac{1}{{x}^{4}}-1)}.$" :question/worked-solution "Here the limits of the numerator and denominator are ${lim}_{x\\to 0}\\frac{1}{{x}^{2}}=\\infty $ and ${lim}_{x\\to 0}(\\frac{1}{{x}^{4}}-1)=\\infty ,$ respectively, so we have the case $\\frac{\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{(\\frac{1}{{x}^{2}})}{(\\frac{1}{{x}^{4}}-1)} & ={lim}_{x\\to 0}\\frac{{[\\frac{1}{{x}^{2}}]}^{′}}{{[\\frac{1}{{x}^{4}}-1]}^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{(-\\frac{2}{{x}^{3}})}{(-\\frac{4}{{x}^{5}})} \\\\  & ={lim}_{x\\to 0}\\frac{2{x}^{-3}}{4{x}^{-5}} \\\\  & ={lim}_{x\\to 0}\\frac{{x}^{2}}{2} \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339100 :knowledge-point/_questions [{:db/id #edb/ref 17592186068722 :knowledge-point/id #uuid "b89c50f3-2181-5b61-96cb-386ef88d2035" :knowledge-point/title "Integrating an Expression Involving a Power Function Multiplied by Its Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "181818f9-ee5d-570b-8805-3453bec6da26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{(1+{x}^{5})^{3}}+C" :db/id #edb/ref 17592186336257} {:answer/id #uuid "324b72d3-41e0-5026-af58-5b34dc0551ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{1+{x}^{5}}+C" :db/id #edb/ref 17592186336509} {:answer/id #uuid "601c5f25-3385-59f3-b9ec-6f4783410687" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{1+{x}^{5}}}{2}+C" :db/id #edb/ref 17592186336901} {:answer/id #uuid "d13e9d9a-a682-5a93-b274-9657dd12c702" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x\\sqrt{1+{x}^{5}}+C" :db/id #edb/ref 17592186337864} {:answer/id #uuid "e2d6ab9a-d942-55d2-8674-766bbfa15318" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{(1+{x}^{5})^{3}}}{2}+C" :db/id #edb/ref 17592186338008}] :answer-field/correct {:answer/id #uuid "324b72d3-41e0-5026-af58-5b34dc0551ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{1+{x}^{5}}+C" :db/id #edb/ref 17592186336509} :answer-field/id #uuid "1287170e-aae1-5d7e-9ef3-ec229bb6713f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338307}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "94a2c36c-7f20-5b89-950f-742f856d9127" :question/math-academy-id "q-72382" :question/problem "Calculate $\\int \\frac{5{x}^{4}}{\\sqrt{1+{x}^{5}}}\\,\\text{d}x.$" :question/worked-solution "We note that $5{x}^{4}$ is the derivative of the quantity in the radical. So we make a substitution\n\n$$\nu=1+{x}^{5}.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =5{x}^{4}\\,⟹\\,\\text{d}u=5{x}^{4}\\,\\text{d}x,\\end{aligned}\n$$\n\nand rewriting our integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{5{x}^{4}}{\\sqrt{1+{x}^{5}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{1+{x}^{5}}}\\,5{x}^{4}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =\\int \\frac{1}{{u}^{1/2}}\\,\\text{d}u \\\\  & =\\int {u}^{-1/2}\\,\\text{d}u.\\end{aligned}\n$$\n\nWe can now solve the integral using the power rule:\n\n$$\n\\begin{aligned}\\int {u}^{-1/2}\\,\\text{d}u & =\\frac{{u}^{1/2}}{(\\frac{1}{2})}+C \\\\  & =2{u}^{1/2}+C \\\\  & =2\\sqrt{u}+C\\end{aligned}\n$$\n\nLastly, we substitute $u=1+{x}^{5}$ back in the expression. So the final result is\n\n$$\n\\begin{aligned}\\int \\frac{5{x}^{4}}{\\sqrt{1+{x}^{5}}}\\,\\text{d}x & =2\\sqrt{1+{x}^{5}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339103 :knowledge-point/_questions [{:db/id #edb/ref 17592186087824 :knowledge-point/id #uuid "0b70a3b7-90a7-5a83-b71f-304f7f25c4ef" :knowledge-point/title "Identifying the Shift and Stretch Applied to an Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "121b16a2-0458-5600-9a6f-f4f6e552fd5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3({2}^{x})-2" :db/id #edb/ref 17592186336202} {:answer/id #uuid "4c671da3-c302-5f3c-9ea5-2dc6dac2cc6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3({2}^{x})+2" :db/id #edb/ref 17592186336742} {:answer/id #uuid "6fed05ea-acde-5be8-b414-01135dc6f042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3({2}^{x})-1" :db/id #edb/ref 17592186337023} {:answer/id #uuid "826ab4ce-caa8-5db7-9188-f1b3cd74a9bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={2}^{x}-1" :db/id #edb/ref 17592186337218} {:answer/id #uuid "9cf95245-48b9-524a-917b-0ba71da5cdb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2({2}^{x})-1" :db/id #edb/ref 17592186337452}] :answer-field/correct {:answer/id #uuid "6fed05ea-acde-5be8-b414-01135dc6f042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3({2}^{x})-1" :db/id #edb/ref 17592186337023} :answer-field/id #uuid "0eab9c10-198f-58c5-918e-000cc777273e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338303}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9f0333a8-0cc0-5b0c-9999-f5175286f364" :question/math-academy-id "q-7239" :question/problem "![](images/1c/1ca11413bbce2ff307e494fb5a79028535b76cff24619e6921620f88c3e274ec.png)\n\nThe graph above shows $y=k({2}^{x})+c.$  Determine the values of $k$ and $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of the curve $y=k({2}^{x})+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=-1,$ so $c=-1.$\n\nTherefore, our function takes the form\n\n$$\ny=k({2}^{x})-1.\n$$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ The labeled point on the graph is $(0,2),$ so we substitute $x=0$ and $y=2$ into the function and solve for $k:$\n\n$$\n\\begin{aligned}y & =k({2}^{x})-1 \\\\ 2 & =k({2}^{0})-1 \\\\ 2 & =k(1)-1 \\\\ 2 & =k-1 \\\\ 3 & =k\\end{aligned}\n$$\n\nTherefore, the curve is $y=3({2}^{x})-1.$"}] [{:db/id #edb/ref 17592186339109 :knowledge-point/_questions [{:db/id #edb/ref 17592186087824 :knowledge-point/id #uuid "0b70a3b7-90a7-5a83-b71f-304f7f25c4ef" :knowledge-point/title "Identifying the Shift and Stretch Applied to an Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49005b9e-8885-518c-a503-38932dbc77f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1.5({2}^{x})+4" :db/id #edb/ref 17592186336710} {:answer/id #uuid "a7777608-b4d4-5368-84cb-c7a407165b82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1.5({2}^{x})+3" :db/id #edb/ref 17592186337546} {:answer/id #uuid "ba7873cf-81b9-5aaf-8051-9f548d554ab8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0.5({2}^{x})+4" :db/id #edb/ref 17592186337684} {:answer/id #uuid "c3ad9d29-36d5-5b4e-bad4-d6181862fae0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1.5({2}^{x})+5" :db/id #edb/ref 17592186337768} {:answer/id #uuid "e97102d4-c948-5475-a8f4-3282b09cc04f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0.5({2}^{x})+5" :db/id #edb/ref 17592186338069}] :answer-field/correct {:answer/id #uuid "49005b9e-8885-518c-a503-38932dbc77f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1.5({2}^{x})+4" :db/id #edb/ref 17592186336710} :answer-field/id #uuid "08a06ece-0b13-5c0a-9459-301060485f8d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338290}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5a92c523-6f37-5b9d-8ed7-2c5b4d7360ee" :question/math-academy-id "q-7241" :question/problem "![](images/3a/3a78c4fc61bbf60e1cdfdba6303ecc1a9d5e09caa21d0879556106893a931a09.png)\n\nThe graph above shows $y=k({2}^{x})+c.$  Determine the values of $k$ and $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of the curve $y=k({2}^{x})+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=4,$ so $c=4.$\n\nTherefore, our function takes the form\n\n$$\ny=k({2}^{x})+4.\n$$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ The labeled point on the graph is $(0,5.5),$ so we substitute $x=0$ and $y=5.5$ into the function and solve for $k:$\n\n$$\n\\begin{aligned}y & =k({2}^{x})+4 \\\\ 5.5 & =k({2}^{0})+4 \\\\ 5.5 & =k(1)+4 \\\\ 5.5 & =k+4 \\\\ 1.5 & =k\\end{aligned}\n$$\n\nTherefore, the curve is $y=1.5({2}^{x})+4.$"}] [{:db/id #edb/ref 17592186398961 :knowledge-point/_questions [{:db/id #edb/ref 17592186064203 :knowledge-point/id #uuid "e2b47545-fdf1-5e6a-b0bb-bbbecb8067cc" :knowledge-point/title "Integrating an Algebraic Function With Positive Integer Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6058cb14-4722-5ae2-982a-1d1d72759305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-(7-2x)^{8}+C" :db/id #edb/ref 17592186398963} {:answer/id #uuid "615ab3c3-1cc9-56db-a561-9ade7641ace4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}(7-2x)^{8}+C" :db/id #edb/ref 17592186398964} {:answer/id #uuid "2b200597-1f86-5ecd-b8bc-18b09c132aad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(7-2x)^{8}+C" :db/id #edb/ref 17592186398965} {:answer/id #uuid "13a3fa38-b420-5956-8a4b-2194f2d8ef30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}(7-2x)^{8}+C" :db/id #edb/ref 17592186398966} {:answer/id #uuid "5674f007-df38-5b04-ac90-1342c70182a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(7-2x)^{8}+C" :db/id #edb/ref 17592186398967}] :answer-field/correct {:answer/id #uuid "6058cb14-4722-5ae2-982a-1d1d72759305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-(7-2x)^{8}+C" :db/id #edb/ref 17592186398963} :answer-field/id #uuid "6ee57767-a470-5ed2-888e-e7479cb9accb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398962}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8c75bb9c-44e2-5f73-9a68-3c296ae237a7" :question/math-academy-id "q-72424" :question/problem "$\\int 16(7-2x)^{7}\\,\\text{d}x=$" :question/worked-solution "Let $u=7-2x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-2\\,⟹\\,\\text{d}x=-\\frac{1}{2}\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $x$ at the very end:\n\n$$\n\\begin{aligned}\\int 16(7-2x)^{7}\\,\\text{d}x & =\\int 16{u}^{7}\\cdot (-\\frac{1}{2})\\,\\text{d}u \\\\  & =16\\int {u}^{7}\\cdot (-\\frac{1}{2})\\,\\text{d}u \\\\  & =16\\cdot (-\\frac{1}{2})\\int {u}^{7}\\,\\text{d}u \\\\  & =-8\\cdot \\frac{{u}^{8}}{8}+C \\\\  & =-{u}^{8}+C \\\\  & =-(7-2x)^{8}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[-(7-2x)^{8}+C] & =-\\frac{\\text{d}}{\\text{d}x}[(7-2x)^{8}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =-8(7-2x)^{7}\\cdot \\frac{\\text{d}}{\\text{d}x}(7-2x)+0 \\\\  & =-8(7-2x)^{7}\\cdot (-2) \\\\  & =16(7-2x)^{7}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339117 :knowledge-point/_questions [{:db/id #edb/ref 17592186064207 :knowledge-point/id #uuid "bdbfa506-08a1-5e43-b958-2ae373df775d" :knowledge-point/title "Integrating a Linear Rational Function and Simplifying the Arbitrary Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07b76063-8fda-596f-8106-cbb57f2ef69a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186336093} {:answer/id #uuid "86f6a2e9-4d29-5e23-9617-09660280aaa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186337252} {:answer/id #uuid "b4ead48b-c59a-570e-a7de-39bcbc22b8fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186337638} {:answer/id #uuid "bec88b66-0b15-559a-8f7c-3341c51c2ee0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186337729} {:answer/id #uuid "f6322442-f9d7-5f7c-ac2d-896d214f1436" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186338188}] :answer-field/correct {:answer/id #uuid "bec88b66-0b15-559a-8f7c-3341c51c2ee0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186337729} :answer-field/id #uuid "209f233a-25a9-55a5-ab33-40122ec3bf02" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338337}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2d475585-492e-5142-bfa4-12e97136e061" :question/math-academy-id "q-72446" :question/problem "Calculate $\\int \\frac{1}{5-2x}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "First, let $u=5-2x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-2\\,⟹\\,\\text{d}x=-\\frac{1}{2}\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{5-2x}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot (-\\frac{1}{2})\\,\\text{d}u \\\\  & =-\\frac{1}{2}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡|u|+C \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡|5-2x|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=-\\frac{1}{2}\\operatorname{ln}⁡K$ for another arbitrary constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}-\\frac{1}{2}\\operatorname{ln}⁡|5-2x|+C & =-\\frac{1}{2}\\operatorname{ln}⁡|5-2x|-\\frac{1}{2}\\operatorname{ln}⁡K \\\\  & =-\\frac{1}{2}(\\operatorname{ln}⁡|5-2x|+\\operatorname{ln}⁡K) \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{1}{5-2x}\\text{d}x=-\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|).\n$$"}] [{:db/id #edb/ref 17592186339123 :knowledge-point/_questions [{:db/id #edb/ref 17592186068723 :knowledge-point/id #uuid "8fe2a279-0b92-561e-b17d-b902f43725ac" :knowledge-point/title "Integrating an Expression Involving a Power Function Multiplied by a Constant Multiple of Its Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e59935f-f93b-599b-9816-d15f61104595" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186336167} {:answer/id #uuid "1ccce204-ca7a-5eee-bc02-3fcc7e16e632" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186336299} {:answer/id #uuid "4b5b5f53-8881-5e03-8cde-ddfcc41895a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186336732} {:answer/id #uuid "75e7362c-a6a5-5145-bf5d-1527db0f317d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186337095} {:answer/id #uuid "7bc5cfb0-4b70-528a-a0e4-e88e561188b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186337152}] :answer-field/correct {:answer/id #uuid "75e7362c-a6a5-5145-bf5d-1527db0f317d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186337095} :answer-field/id #uuid "80b5679a-f4f7-56bb-9b5b-253ee5665aec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338504}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "de70203f-dd05-5f0d-9800-283717012618" :question/math-academy-id "q-72467" :question/problem "Calculate $\\int x\\sqrt{{x}^{2}-5}\\,\\text{d}x.$" :question/worked-solution "In this case, the $x$ that's outside the square root isn't quite the derivative of $({x}^{2}-5).$ But the derivative is $2x,$ so we're only out by a constant factor.\n\nSo we make the substitution\n\n$$\nu={x}^{2}-5.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x,\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\begin{aligned}\\int x\\sqrt{{x}^{2}-5}\\,\\text{d}x & =\\int \\sqrt{{x}^{2}-5}\\cdot x\\,\\text{d}x \\\\  & =\\int \\sqrt{u}\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{1}{2}\\int {u}^{1/2}\\,\\text{d}u\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}\\frac{1}{2}\\int {u}^{1/2}\\,\\text{d}u & =\\frac{1}{2}\\cdot \\frac{{u}^{3/2}}{(\\frac{3}{2})}+C \\\\  & =\\frac{1}{2}\\cdot \\frac{2}{3}\\cdot {u}^{3/2}+C \\\\  & =\\frac{1}{3}{u}^{3/2}+C \\\\  & =\\frac{1}{3}\\sqrt{{u}^{3}}+C \\\\  & =\\frac{1}{3}\\sqrt{({x}^{2}-5)^{3}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186111390 :knowledge-point/_questions [{:db/id #edb/ref 17592186110669 :knowledge-point/id #uuid "34645eb8-3624-5ff3-817d-28f8d0cee4ba" :knowledge-point/title "Identifying the Scaling Constant From a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dc7ed7d-8822-50d6-adbe-ad3f4f94cc16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186336309} {:answer/id #uuid "2855b2b9-6a8b-51fc-bc86-192bc1d62f6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186336410} {:answer/id #uuid "62f307be-5f4b-5771-b9ee-77edd782e456" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186336922} {:answer/id #uuid "75294229-d638-5281-9b75-127f796a0330" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186337087} {:answer/id #uuid "a40c3d37-1f3e-56af-9259-897cf2fc43fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186337522}] :answer-field/correct {:answer/id #uuid "1dc7ed7d-8822-50d6-adbe-ad3f4f94cc16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186336309} :answer-field/id #uuid "dfe47395-e6a4-5174-8bac-b9841d8af59f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338671}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7ca56a13-e2a8-587b-a791-0b4526ed9f52" :question/math-academy-id "q-7249" :question/problem "![](images/db/db4c6694a3bc172aea8a47f1a828eac8235286b7ce6b7e327574790a6c31c270.png)\n\nThe graph above shows $y=k{(\\frac{1}{3})}^{x}.$ What is the value of $k?$" :question/worked-solution "To plot the graph of $y=k{(\\frac{1}{3})}^{x}$ we take the graph of $y={(\\frac{1}{3})}^{x}$ and stretch it vertically by a scale factor of  $k.$ Under the action of this transformation, the $y$-intercept is mapped from $(0,1)$ to $(0,k).$\n\nComparing the point $(0,3)$ on the graph to $(0,k),$ we see that we must have $k=3.$"}] [{:db/id #edb/ref 17592186339129 :knowledge-point/_questions [{:db/id #edb/ref 17592186110599 :knowledge-point/id #uuid "29005c66-9f30-5862-926f-8a09320d404c" :knowledge-point/title "Determining Whether Two Lines in Slope-Intercept Form are Perpendicular"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad7f19f7-5593-5372-821e-d1252d3b8446" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x" :db/id #edb/ref 17592186337587} {:answer/id #uuid "c0e66778-1d33-59c9-9c63-84193616625d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2x-3" :db/id #edb/ref 17592186337745} {:answer/id #uuid "cf4a56a8-6d0c-5363-9d42-b65beb462d50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{x}{2}x+5" :db/id #edb/ref 17592186337846} {:answer/id #uuid "cf58d7b6-9e04-5b2a-b15f-7c5224686dfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{x}{2}x-1" :db/id #edb/ref 17592186337847} {:answer/id #uuid "f9e1b841-fe74-5a6f-9da0-dd60389da801" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x+19" :db/id #edb/ref 17592186338222}] :answer-field/correct {:answer/id #uuid "f9e1b841-fe74-5a6f-9da0-dd60389da801" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x+19" :db/id #edb/ref 17592186338222} :answer-field/id #uuid "833a989b-8bb1-589d-92ce-6ba9062090a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338511}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cdd0bbdf-150a-52db-a038-e888ce1f0809" :question/math-academy-id "q-72524" :question/problem "Which of the following lines is perpendicular to $y=-\\frac{x}{2}+7?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nThe line $y=-\\frac{x}{2}+7$ is in slope-intercept form, and its slope is $-\\frac{1}{2}.$\n\nLooking at the answer choices, the line $y=2x+19$ has a slope of $2.$\n\nMultiplying the slopes together, we have\n\n$$\n-\\frac{1}{2}\\cdot 2=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=2x+19$ is perpendicular to the given line."}] [{:db/id #edb/ref 17592186403592 :knowledge-point/_questions [{:db/id #edb/ref 17592186068900 :knowledge-point/id #uuid "66ade855-4b16-514b-b44a-1d6b9d61ef28" :knowledge-point/title "Identifying the Shift Applied to an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "128902a2-01ba-574b-8cb8-9e24d91588d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{2})}^{x}+3" :db/id #edb/ref 17592186403594} {:answer/id #uuid "d421b62c-91bc-51bd-9a1e-dcb674541fa2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{2})}^{x}" :db/id #edb/ref 17592186403595} {:answer/id #uuid "89b95e28-4bdc-577f-9fef-39eb015deed9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{2})}^{x}-1" :db/id #edb/ref 17592186403596} {:answer/id #uuid "1f9a6792-46dd-54a0-852a-c3ce900255d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{2})}^{x}+1" :db/id #edb/ref 17592186403597} {:answer/id #uuid "cdf02042-68e8-57bc-821d-c4e709f6e6d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{2})}^{x}+2" :db/id #edb/ref 17592186403598}] :answer-field/correct {:answer/id #uuid "1f9a6792-46dd-54a0-852a-c3ce900255d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{2})}^{x}+1" :db/id #edb/ref 17592186403597} :answer-field/id #uuid "86226cb6-da89-5070-bdaf-be3482566831" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403593}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c80543b3-4997-5175-82f2-660b5af23e52" :question/math-academy-id "q-7253" :question/problem "![](images/50/50be1f4a894e86b5f06fba18655caca163c3d4c7a3423d2ecf159aa49975eb8c.png)\n\nThe graph above shows the curve $y={(\\frac{1}{2})}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={(\\frac{1}{2})}^{x}$ is $y=0.$\n\nThe vertical translation $y={(\\frac{1}{2})}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=1.$ Therefore, $c=1.$"}] [{:db/id #edb/ref 17592186341834 :knowledge-point/_questions [{:db/id #edb/ref 17592186175923 :knowledge-point/id #uuid "44b9b212-27c4-5d6d-a221-cd85c25fc956" :knowledge-point/title "Finding the Equation of a Line Perpendicular to a Line Through Two Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "460f3e7e-a692-5e84-84d3-bb04895e42c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x+9" :db/id #edb/ref 17592186339750} {:answer/id #uuid "7de51bcc-dba4-5f66-9ed1-e89e2285349b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x+3" :db/id #edb/ref 17592186340264} {:answer/id #uuid "a496b65e-0fa0-5379-bb60-a181cb54a9be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}x+6" :db/id #edb/ref 17592186340623} {:answer/id #uuid "dc1a70a6-b427-555b-b378-aaf49435f770" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x+7" :db/id #edb/ref 17592186341084} {:answer/id #uuid "f252e1db-2d4f-5cfe-b195-696e6f606c03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}x-3" :db/id #edb/ref 17592186341262}] :answer-field/correct {:answer/id #uuid "a496b65e-0fa0-5379-bb60-a181cb54a9be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}x+6" :db/id #edb/ref 17592186340623} :answer-field/id #uuid "f4e67ea3-0bdd-589c-834c-8bb372afcf1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341816}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "99fe5e6a-20b3-53d0-a013-c1c2c0d3ad0c" :question/math-academy-id "q-72568" :question/problem "Find the equation of the line that passes through the point $(-2,5)$ and is perpendicular to the line passing through the points $(6,1)$ and $(4,5).$" :question/worked-solution "Perpendicular lines have slopes which are negative reciprocals of each other.\n\nFirst, let's find the slope ${m}_{1}$ of the line passing through the points $(6,1)$ and $(4,5):$\n\n$$\n\\begin{aligned}{m}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{5-1}{4-6} \\\\  & =\\frac{4}{-2} \\\\  & =-2\\end{aligned}\n$$\n\nSince we want a perpendicular line, the slope $m$ of the line we're trying to find must satisfy\n\n$$\nm\\cdot (-2)=-1\\,⇒\\,m=\\frac{1}{2}.\n$$\n\nWe know that the line passes through the point $(-2,5).$ Using point-slope form and simplifying, we obtain the equation of the line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-5 & =\\frac{1}{2}(x-(-2)) \\\\ y-5 & =\\frac{1}{2}(x+2) \\\\ y-5 & =\\frac{1}{2}x+1 \\\\ y & =\\frac{1}{2}x+6\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341836 :knowledge-point/_questions [{:db/id #edb/ref 17592186175924 :knowledge-point/id #uuid "c52fd5dd-780e-5dab-805f-561383873dd4" :knowledge-point/title "Finding the Equation of a Line Perpendicular to a Line in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e1988b7-4bc8-5bda-86c5-639e0552dedd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-3y=7" :db/id #edb/ref 17592186339683} {:answer/id #uuid "51dac7ff-2d97-5661-b543-ad769758a707" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+y=6" :db/id #edb/ref 17592186339880} {:answer/id #uuid "6d11b816-6f21-575c-a776-01785873cb84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-3y=5" :db/id #edb/ref 17592186340089} {:answer/id #uuid "803a7a88-7553-50e1-862d-0b786cfc737c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+3y=13" :db/id #edb/ref 17592186340279} {:answer/id #uuid "af6755f9-b09b-562d-a589-5067ac2ec549" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+3y=7" :db/id #edb/ref 17592186340728}] :answer-field/correct {:answer/id #uuid "803a7a88-7553-50e1-862d-0b786cfc737c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+3y=13" :db/id #edb/ref 17592186340279} :answer-field/id #uuid "58e7ea68-a247-56ce-a08d-252af6a5df70" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341536}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ad191a02-5856-5306-8980-ab9514c55d3b" :question/math-academy-id "q-72571" :question/problem "Find the equation of the line that passes through the point $(5,1)$ and is perpendicular to the line passing through the points $(1,5)$ and $(-3,-1).$" :question/worked-solution "Perpendicular lines have slopes which are negative reciprocals of each other.\n\nFirst, let's find the slope ${m}_{1}$ of the line passing through the points $(1,5)$ and $(-3,-1):$\n\n$$\n\\begin{aligned}{m}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{-1-5}{-3-1} \\\\  & =\\frac{-6}{-4} \\\\  & =\\frac{3}{2}\\end{aligned}\n$$\n\nSince we want a perpendicular line, the slope $m$ of the line we're trying to find must satisfy\n\n$$\nm\\cdot (\\frac{3}{2})=-1\\,⇒\\,m=-\\frac{2}{3}.\n$$\n\nWe know that the line passes through the point $(5,1).$ Using point-slope form and simplifying, we obtain the equation of the line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =-\\frac{2}{3}(x-5) \\\\ y-1 & =-\\frac{2}{3}x+\\frac{10}{3} \\\\ y & =-\\frac{2}{3}x+\\frac{13}{3}\\end{aligned}\n$$\n\nHowever, we want to write the equation in standard form. So, we will bring the $x$ term to the left-hand side and multiply both sides of the equation by $3:$\n\n$$\n\\begin{aligned}y & =-\\frac{2}{3}x+\\frac{13}{3} \\\\ \\frac{2}{3}x+y & =\\frac{13}{3} \\\\ 3\\cdot (\\frac{2}{3}x+y) & =3\\cdot \\frac{13}{3} \\\\ 2x+3y & =13\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341840 :knowledge-point/_questions [{:db/id #edb/ref 17592186068724 :knowledge-point/id #uuid "18ce1807-3a09-5ebd-b3cd-a91db8d2b4a8" :knowledge-point/title "Integrating a Rational Function Using Natural Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "424f1750-2255-5cd3-97f1-bff8ae1f779e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{ln}⁡|2-5{x}^{5}|+C" :db/id #edb/ref 17592186339710} {:answer/id #uuid "64a24bd8-02d1-5da1-875a-ff8313d79449" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5(2-5{x}^{5})^{2}}+C" :db/id #edb/ref 17592186340018} {:answer/id #uuid "cd66158f-066f-573b-a023-86fcc42573cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2(2-5{x}^{5})^{2}}+C" :db/id #edb/ref 17592186340950} {:answer/id #uuid "d40a6f74-0d5f-5192-b1f2-24adfd672a83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}\\operatorname{ln}⁡|2-5{x}^{5}|+C" :db/id #edb/ref 17592186341003} {:answer/id #uuid "f1c87e78-2256-558f-a463-3af7ee7e05a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{5}\\operatorname{ln}⁡|2-5{x}^{5}|+C" :db/id #edb/ref 17592186341259}] :answer-field/correct {:answer/id #uuid "f1c87e78-2256-558f-a463-3af7ee7e05a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{5}\\operatorname{ln}⁡|2-5{x}^{5}|+C" :db/id #edb/ref 17592186341259} :answer-field/id #uuid "c4f33047-2f0b-50bf-84ac-e403b1fabf2c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341723}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "958efc2b-d91b-53e5-b712-1690bc1b7068" :question/math-academy-id "q-72605" :question/problem "$\\int \\frac{10{x}^{4}}{2-5{x}^{5}}\\,\\text{d}x=$" :question/worked-solution "Let $u=2-5{x}^{5}.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-25{x}^{4}\\,⟹\\,(-\\frac{1}{25})\\text{d}u={x}^{4}\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{10{x}^{4}}{2-5{x}^{5}}\\,\\text{d}x & =10\\int \\frac{1}{2-5{x}^{5}}\\cdot {x}^{4}\\,\\text{d}x \\\\  & =10\\int \\frac{1}{u}\\cdot (-\\frac{1}{25})\\text{d}u \\\\  & =-\\frac{10}{25}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{2}{5}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{2}{5}\\operatorname{ln}⁡|u|+C \\\\  & =-\\frac{2}{5}\\operatorname{ln}⁡|2-5{x}^{5}|+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341845 :knowledge-point/_questions [{:db/id #edb/ref 17592186059641 :knowledge-point/id #uuid "3332b534-bd04-5e86-995e-1e6d691d8e1b" :knowledge-point/title "Simplifying an Expression by Factoring and Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "733d9013-5828-5e8a-a6ca-98d0ee84db3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{sin}⁡x+\\operatorname{cos}⁡x" :db/id #edb/ref 17592186340151} {:answer/id #uuid "9e08cb06-fa94-559a-b45f-0247593ae993" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186340553} {:answer/id #uuid "ce427bad-7fbf-553d-94e7-4eac1f2a458e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+3\\operatorname{cos}⁡x" :db/id #edb/ref 17592186340960} {:answer/id #uuid "d512d53f-d1ef-5fcf-a459-a5ecee4d6396" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x" :db/id #edb/ref 17592186341012} {:answer/id #uuid "ddb559b7-bf25-5a4d-8461-b1784d7b4dd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x+\\operatorname{cos}⁡x" :db/id #edb/ref 17592186341097}] :answer-field/correct {:answer/id #uuid "d512d53f-d1ef-5fcf-a459-a5ecee4d6396" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x" :db/id #edb/ref 17592186341012} :answer-field/id #uuid "7c77d87a-34f1-5f64-8f04-06a22766d6be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341597}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5b1e203a-fce6-56f0-bd3a-5a969f3f611d" :question/math-academy-id "q-72711" :question/problem "Simplify the trigonometric expression $\\operatorname{sin}⁡x+2{cos}^{3}⁡x+2{sin}^{2}⁡x\\operatorname{cos}⁡x.$" :question/worked-solution "First, we factor the expression:\n\n$$\n\\operatorname{sin}⁡x+2{cos}^{3}⁡x+2{sin}^{2}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x({cos}^{2}⁡x+{sin}^{2}⁡x)\n$$\n\nThen, we use ${cos}^{2}⁡x+{sin}^{2}⁡x=1$ to simplify the expression in the parentheses:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x({cos}^{2}⁡x+{sin}^{2}⁡x) & =\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x\\cdot 1 \\\\  & =\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x\\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n\\operatorname{sin}⁡x+2{cos}^{3}⁡x+2{sin}^{2}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x.\n$$"}] [{:db/id #edb/ref 17592186341846 :knowledge-point/_questions [{:db/id #edb/ref 17592186059642 :knowledge-point/id #uuid "868125f0-22e0-57fc-9620-f3242419a689" :knowledge-point/title "Simplifying a Rational Expression Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18d5cf9e-61a5-56dc-ab85-48cc3361b6cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{tan}⁡x+\\operatorname{sec}⁡x" :db/id #edb/ref 17592186339348} {:answer/id #uuid "2a4a8bfb-24ab-5d4f-85c0-b03c7be1078c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{tan}⁡x" :db/id #edb/ref 17592186339502} {:answer/id #uuid "5af65e91-2dda-5a02-a6b9-84e591e12cdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡x+1" :db/id #edb/ref 17592186339956} {:answer/id #uuid "94adee08-1ae4-5711-87c2-0b92afcedb4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡x+\\operatorname{sec}⁡x" :db/id #edb/ref 17592186340463} {:answer/id #uuid "a2128603-79a4-5ac2-aad8-d0e79ce06174" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{tan}⁡x-\\operatorname{sec}⁡x" :db/id #edb/ref 17592186340599}] :answer-field/correct {:answer/id #uuid "94adee08-1ae4-5711-87c2-0b92afcedb4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡x+\\operatorname{sec}⁡x" :db/id #edb/ref 17592186340463} :answer-field/id #uuid "7ffbbed8-ad51-5238-b319-cf240d8126f8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341605}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "508dcfe6-ec7a-5fa0-ab23-63e62cd88ad5" :question/math-academy-id "q-72712" :question/problem "Simplify the trigonometric expression $\\frac{{sin}^{3}⁡x+\\operatorname{sin}⁡x{cos}^{2}⁡x+1}{\\operatorname{cos}⁡x}.$" :question/worked-solution "First, we factor $\\operatorname{sin}⁡x$ from the first two terms:\n\n$$\n\\frac{{sin}^{3}⁡x+\\operatorname{sin}⁡x{cos}^{2}⁡x+1}{\\operatorname{cos}⁡x}=\\frac{\\operatorname{sin}⁡x({sin}^{2}⁡x+{cos}^{2}⁡x)+1}{\\operatorname{cos}⁡x}\n$$\n\nNext, we use the Pythagorean identity to rewrite the expression in the parentheses, and then we simplify the resulting expression as much as possible:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡x({sin}^{2}⁡x+{cos}^{2}⁡x)+1}{\\operatorname{cos}⁡x} & =\\frac{\\operatorname{sin}⁡x+1}{\\operatorname{cos}⁡x} \\\\  & =\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}+\\frac{1}{\\operatorname{cos}⁡x} \\\\  & =\\operatorname{tan}⁡x+\\operatorname{sec}⁡x\\end{aligned}\n$$\n\nHence, we conclude that:\n\n$$\n\\frac{{sin}^{3}⁡x+\\operatorname{sin}⁡x{cos}^{2}⁡x+1}{\\operatorname{cos}⁡x}=\\operatorname{tan}⁡x+\\operatorname{sec}⁡x\n$$"}] [{:db/id #edb/ref 17592186341858 :knowledge-point/_questions [{:db/id #edb/ref 17592186105906 :knowledge-point/id #uuid "5dd3dcff-06d2-5d61-9863-0f5b541d8d4b" :knowledge-point/title "Finding the Area of a Triangle Given the Area of a Quadrilateral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f07a6b5-32ea-529d-9160-238820145dc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "34{\\text{ cm}}^{2}" :db/id #edb/ref 17592186339267} {:answer/id #uuid "174b9032-2956-564a-826e-c2c81592003e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23{\\text{ cm}}^{2}" :db/id #edb/ref 17592186339336} {:answer/id #uuid "508acfdf-0761-5691-be12-cc8ecd53beb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19{\\text{ cm}}^{2}" :db/id #edb/ref 17592186339862} {:answer/id #uuid "84059e1d-50ea-57c1-a02c-e73cba67744f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13{\\text{ cm}}^{2}" :db/id #edb/ref 17592186340317} {:answer/id #uuid "f79db4a6-d5f5-5ae3-9697-f4ab3f3df76c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25{\\text{ cm}}^{2}" :db/id #edb/ref 17592186341318}] :answer-field/correct {:answer/id #uuid "508acfdf-0761-5691-be12-cc8ecd53beb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19{\\text{ cm}}^{2}" :db/id #edb/ref 17592186339862} :answer-field/id #uuid "ea1b3e9c-7be4-50dc-84b7-55a05c94254f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341796}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d86eb6a4-4303-50bf-b47a-fa898e3f8037" :question/math-academy-id "q-72764" :question/problem "![](images/f5/f53996727138b9442ac041cf492618db8287b54ba652c4f9e375cdde27dc1862.png)\n\nThe area of $ABCD$ is $34{\\text{ cm}}^{2}.$   What is the area of $△BCD$ rounded to the nearest integer?" :question/worked-solution "Let's start by finding the area of $△ABD.$ We get \n\n$$\n\\begin{aligned}{A}_{△ABD} & =\\frac{1}{2}\\cdot AB\\cdot AD\\cdot \\operatorname{sin}⁡A \\\\  & =\\frac{1}{2}\\cdot 9\\cdot 15\\cdot \\operatorname{sin}⁡{52}^{∘} \\\\  & =67.5\\cdot \\operatorname{sin}⁡{52}^{∘} \\\\  & =53.190… \\\\  & ≈53{\\text{ cm}}^{2}\\end{aligned}\n$$\n\nrounded to the nearest integer.\n\nThe difference of the areas of $△ABD$ and the quadrilateral $ABCD$ gives the area of $△BCD.$ Therefore, \n\n$$\n\\begin{aligned}{A}_{△BCD} & ={A}_{△ABD}-{A}_{ABCD} \\\\  & =53-34 \\\\  & =19{\\text{ cm}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341859 :knowledge-point/_questions [{:db/id #edb/ref 17592186105905 :knowledge-point/id #uuid "3173d361-b91d-5699-97d8-6595ef59d0a3" :knowledge-point/title "Calculating the Area of a Quadrilateral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d011d15-855e-593b-a305-503c6f4d7b4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "65" :db/id #edb/ref 17592186339829} {:answer/id #uuid "5049855a-0cf1-52ff-a6d7-82ad580a1998" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "135" :db/id #edb/ref 17592186339858} {:answer/id #uuid "65970e9b-6b55-55f9-87cb-642a2bfcf59a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "132" :db/id #edb/ref 17592186340026} {:answer/id #uuid "810e57dc-6211-51e2-9530-7c30c274a5a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "98" :db/id #edb/ref 17592186340286} {:answer/id #uuid "941f7586-f901-520c-ba5a-d3f77fa4895c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "112" :db/id #edb/ref 17592186340460}] :answer-field/correct {:answer/id #uuid "5049855a-0cf1-52ff-a6d7-82ad580a1998" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "135" :db/id #edb/ref 17592186339858} :answer-field/id #uuid "59a7e60a-6a2a-50ed-b8ee-1ebc1c309e07" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341540}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c1e965d5-3d0b-5c28-9671-3eb1e1598d0f" :question/math-academy-id "q-72768" :question/problem "![](images/36/36af7324fd2112d94feddc5a1a02a91d97bbc0866cb93a6ca711dd73f566305a.png)\n\nFind, to the nearest integer, the area of the parallelogram $ABCD.$" :question/worked-solution "The diagonal $\\overset{―}{AC}$ divides the parallelogram into two congruent triangles. Therefore, the area of the parallelogram is twice the area of $△ACB$ (see the illustration below).\n\n![](images/7c/7cfcb5cdf77b4afbf25afd64e37bb33f0ab2c211e09659181bfc16db0ccd2db7.png)\n\n Computing the area of $△ACB,$ we find\n \n\n$$\n\\begin{aligned}{A}_{ACD} & =\\frac{1}{2}(18)(8)\\operatorname{sin}⁡{70}^{∘} \\\\  & =72\\cdot \\operatorname{sin}⁡{70}^{∘} \\\\  & ≈67.658,\\end{aligned}\n$$\n\nrounded to three decimal places. Consequently,\n\n$$\n\\begin{aligned}{A}_{ABCD} & =2{A}_{ACB} \\\\  & =2\\cdot 67.658 \\\\  & =135.316.\\end{aligned}\n$$\n\nSo, to the nearest integer, the area of the parallelogram is $135.$"}] [{:db/id #edb/ref 17592186341896 :knowledge-point/_questions [{:db/id #edb/ref 17592186096804 :knowledge-point/id #uuid "0a16e7b6-2a09-5aeb-9a8b-ea8fb1d59807" :knowledge-point/title "Calculating the Derivative of a Function From Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "062499b4-be47-5b28-982d-86c642bba935" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186339180} {:answer/id #uuid "0c2e9142-707f-5bcc-a580-ee524bee6fdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186339234} {:answer/id #uuid "359a8a35-2225-5f23-8b9d-aae7b68bb0a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186339604} {:answer/id #uuid "96928fb6-9fc9-5f9b-b89c-531b735c25b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186340487} {:answer/id #uuid "c6587bc5-7cad-5be9-a21b-564e512cd0a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186340885}] :answer-field/correct {:answer/id #uuid "96928fb6-9fc9-5f9b-b89c-531b735c25b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186340487} :answer-field/id #uuid "4f07086c-8b55-5351-9a76-5d3e1c547bcf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341518}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "241c4369-248c-546e-84df-6e2b47d7a0e2" :question/math-academy-id "q-72998" :question/problem "![](images/6d/6d5146afb9508532145180a4f632c0b5c4495487b0a9a89cfd4f71e134b95f50.png)\n\nThe graph of the function $y=f(x)$ is given above. Find ${f}^{′}(-1.5).$" :question/worked-solution "To compute ${f}^{′}(-1.5),$ we need to find the slope of the tangent to $f(x)$ at $x=-1.5.$\n\nLet's consider the graph of $y=f(x)$ on $[-2,1].$ Notice that $x=-1.5$ lies in this interval.\n\n![](images/22/2216d3014a8c74102d5e298c300092a575798de0b66d89914716898bc16ac655.png)\n\nThe slope of $y=f(x)$ on $x\\in (-2,1)$ is constant and equals\n\n$$\n\\begin{aligned}\\frac{Δf}{Δx} & =\\frac{0-2}{1-(-2)}=-\\frac{2}{3}.\\end{aligned}\n$$\n\nTherefore, ${f}^{′}(-1.5)=-\\frac{2}{3}.$"}] [{:db/id #edb/ref 17592186234328 :knowledge-point/_questions [{:db/id #edb/ref 17592186179659 :knowledge-point/id #uuid "44e3a595-a9ae-5d8c-9aa5-c8e3403fcb28" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient of Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ae24c67-169d-568f-9906-74f5b3cc2e0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n(n+1)" :db/id #edb/ref 17592186339505} {:answer/id #uuid "35c068a3-dbe1-516f-a719-8c52f792f017" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}^{2}(n+1)" :db/id #edb/ref 17592186339606} {:answer/id #uuid "4cc01694-bcd6-5105-860b-e7ae3171d223" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n(n-2)" :db/id #edb/ref 17592186339824} {:answer/id #uuid "9d31eea3-a5b0-5f91-81ac-06d7e2e82a81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n-1)(n+1)" :db/id #edb/ref 17592186340545} {:answer/id #uuid "cb8da782-b040-553f-a209-d1c9c3875b8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n(n-1)" :db/id #edb/ref 17592186340932}] :answer-field/correct {:answer/id #uuid "2ae24c67-169d-568f-9906-74f5b3cc2e0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n(n+1)" :db/id #edb/ref 17592186339505} :answer-field/id #uuid "20784676-1346-5beb-bf37-2d8560fbcb5c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341437}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "81d120ad-3169-5d64-9a97-a76dfeab46ec" :question/math-academy-id "q-73023" :question/problem "Given that $n\\ge 1$ is an integer, simplify $\\frac{(n+1)!}{(n-1)!}.$" :question/worked-solution "First, notice the following:\n\n$$\n(n+1)!=(n+1)\\cdot n\\cdot (n-1)!\n$$\n\nThen, we cancel the $(n-1)!$ that occurs in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(n+1)!}{(n-1)!} & =\\frac{(n+1)\\cdot n\\cdot (n-1)!}{(n-1)!} \\\\  & =\\frac{(n+1)\\cdot n\\cdot \\cancel{(n-1)!}}{\\cancel{(n-1)!}} \\\\  & =n(n+1)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186234331 :knowledge-point/_questions [{:db/id #edb/ref 17592186179659 :knowledge-point/id #uuid "44e3a595-a9ae-5d8c-9aa5-c8e3403fcb28" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient of Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29487ed3-a525-52dd-9167-d626037dc815" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{n+2}" :db/id #edb/ref 17592186339491} {:answer/id #uuid "7f774ed2-5f28-52ae-865d-32a61cabb3ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{n+1}" :db/id #edb/ref 17592186340273} {:answer/id #uuid "9c213996-40cb-543e-9a55-403ef758636c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n+2" :db/id #edb/ref 17592186340533} {:answer/id #uuid "9d2f4e0c-cc16-5245-84c3-7f919dd4a20d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{n}^{2}+n}" :db/id #edb/ref 17592186340543} {:answer/id #uuid "dca1f91a-c517-5f9d-abf6-091011b8edcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n+1" :db/id #edb/ref 17592186341087}] :answer-field/correct {:answer/id #uuid "29487ed3-a525-52dd-9167-d626037dc815" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{n+2}" :db/id #edb/ref 17592186339491} :answer-field/id #uuid "247d41fd-6e73-5f0c-95b3-a198cf2975b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341444}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "72330c15-2550-5193-88bf-8afccb0b16d4" :question/math-academy-id "q-73028" :question/problem "Given that $n\\ge -1$ is an integer, simplify $\\frac{(n+1)!}{(n+2)!}.$" :question/worked-solution "First, notice the following:\n\n$$\n(n+2)!=(n+2)\\cdot (n+1)!\n$$\n\nThen, we cancel the $(n+1)!$ that occurs in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(n+1)!}{(n+2)!} & =\\frac{(n+1)!}{(n+2)\\cdot (n+1)!} \\\\  & =\\frac{\\cancel{(n+1)!}}{(n+2)\\cdot \\cancel{(n+1)!}} \\\\  & =\\frac{1}{n+2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186234332 :knowledge-point/_questions [{:db/id #edb/ref 17592186179660 :knowledge-point/id #uuid "644b7f09-7f66-50f2-8eba-ef6e009429d0" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient With Many Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04802008-4ed6-5b73-83f5-d29dc06587f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k+1" :db/id #edb/ref 17592186339160} {:answer/id #uuid "1ba86355-0ac6-5962-ae05-e44d9250bd1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{k}^{2}+k" :db/id #edb/ref 17592186339366} {:answer/id #uuid "af54b886-24b1-56d3-9d8e-4c71dd5f011f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{k+2}" :db/id #edb/ref 17592186340727} {:answer/id #uuid "f4bcde05-f467-51e7-b960-da690faabda6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{k}{k+2}" :db/id #edb/ref 17592186341287} {:answer/id #uuid "f7792b0b-5d92-53fc-957c-3f59a201b930" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{k}^{2}+2k}" :db/id #edb/ref 17592186341316}] :answer-field/correct {:answer/id #uuid "af54b886-24b1-56d3-9d8e-4c71dd5f011f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{k+2}" :db/id #edb/ref 17592186340727} :answer-field/id #uuid "e83b7853-94c1-56fb-bb60-7f7706a1acaa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341792}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4c27af90-5244-552c-a6c5-2d976ec6599f" :question/math-academy-id "q-73037" :question/problem "Given that $k\\ge -1$ is an integer, $\\frac{(k+2)((k+1)!)^{2}}{((k+2)!)^{2}}=$" :question/worked-solution "First, we notice that\n\n$$\n(k+2)!=(k+2)(k+1)!\n$$\n\nThen, we can cancel the $k!$ that occurs in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(k+2)((k+1)!)^{2}}{((k+2)!)^{2}} & =\\frac{(k+2)\\cdot (k+1)!\\cdot (k+1)!}{(k+2)!\\cdot (k+2)!} \\\\  & =\\frac{(k+2)\\cdot (k+1)!\\cdot (k+1)!}{(k+2)\\cdot (k+1)!\\cdot (k+2)\\cdot (k+1)!} \\\\  & =\\frac{\\cancel{(k+2)}\\cdot \\cancel{(k+1)!}\\cdot \\cancel{(k+1)!}}{(k+2)\\cdot \\cancel{(k+1)!}\\cdot \\cancel{(k+2)}\\cdot \\cancel{(k+1)!}} \\\\  & =\\frac{1}{k+2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341901 :knowledge-point/_questions [{:db/id #edb/ref 17592186059671 :knowledge-point/id #uuid "143766e0-0ef5-5caf-b699-d394d4a707e9" :knowledge-point/title "Using the Double-Angle Formula to Simplify Products"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d39e1d2-809f-5155-a07c-2be82fe6f5c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡(\\frac{3\\pi }{7})" :db/id #edb/ref 17592186339382} {:answer/id #uuid "40729786-50b6-5ff5-b256-a96bf88930f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{6\\pi }{7})" :db/id #edb/ref 17592186339704} {:answer/id #uuid "ab3fcfc4-5970-535a-9851-ae25c946b062" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{3\\pi }{14})" :db/id #edb/ref 17592186340688} {:answer/id #uuid "dc526537-6440-5beb-89ba-a669341bd361" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{6\\pi }{7})" :db/id #edb/ref 17592186341086} {:answer/id #uuid "f54d10f1-3bdb-508e-83f2-6340ec8fe28b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡(\\frac{3\\pi }{7})" :db/id #edb/ref 17592186341292}] :answer-field/correct {:answer/id #uuid "dc526537-6440-5beb-89ba-a669341bd361" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{6\\pi }{7})" :db/id #edb/ref 17592186341086} :answer-field/id #uuid "6bdfe7ee-6a1b-5a6c-8716-9c970e741c65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341565}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "188c3216-6730-58aa-bfa7-8985bab845cd" :question/math-academy-id "q-7305" :question/problem "Express $2\\operatorname{sin}⁡(\\frac{3\\pi }{7})\\operatorname{cos}⁡(\\frac{3\\pi }{7})$ as a single trigonometric ratio." :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x=\\frac{3\\pi }{7}$ into the above, we get\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡(\\frac{3\\pi }{7})\\operatorname{cos}⁡(\\frac{3\\pi }{7}) & =\\operatorname{sin}⁡(2\\cdot \\frac{3\\pi }{7})=\\operatorname{sin}⁡(\\frac{6\\pi }{7}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341908 :knowledge-point/_questions [{:db/id #edb/ref 17592186068700 :knowledge-point/id #uuid "81247553-750f-5bf7-a1c4-698ad63b5ae4" :knowledge-point/title "Identifying True Statements Regarding Left- and Right-Continuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33ab5c9a-741e-507f-8a99-07a9f7aa451c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186339588} {:answer/id #uuid "3bf55990-23dc-5693-8dde-0dd252a432b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186339663} {:answer/id #uuid "48fe273f-13eb-5f78-8272-5b9b3a2db061" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186339782} {:answer/id #uuid "4a2895ac-425c-5001-bb2a-284e8601acaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186339796} {:answer/id #uuid "ea2ab1df-0cb6-5919-a2be-e9cca71bcc58" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186341194}] :answer-field/correct {:answer/id #uuid "4a2895ac-425c-5001-bb2a-284e8601acaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186339796} :answer-field/id #uuid "bf84d3cb-0dfa-513a-bcdd-3183ad8dee6c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341710}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "79464211-37d1-5cac-b164-284bb9d9308a" :question/math-academy-id "q-73105" :question/problem "![](images/ad/ad3fb8a0cce2a6dac706d7876aca0a2339fe49c05cb7aa6ae54de86735ceafab.png)\n\nWhich of the following statements are true regarding the function $y=f(x)$ plotted above?\n\n- The function is left-continuous at $x=3$\n- The function is right-continuous at $x=3$\n- The function is continuous at $x=3$" :question/worked-solution "Let's look at each statement in turn:\n\n- Statement I is false. The function is not left-continuous at $x=3,$ since the left-sided limit is not equal to the function value:\n\n$$\n{lim}_{x\\to {3}^{-}}f(x)=3\\ne 1=f(3)\n$$\n\n- Statement II is true. The function is right-continuous at $x=3,$ since the right-sided limit is equal to the function value:\n\n$$\n{lim}_{x\\to {3}^{+}}f(x)=1=f(3)\n$$\n\n- Statement III is false. In order for the function to be continuous at $x=3,$ it must be both left-continuous and right-continuous. However, we have already determined that the function is not left-continuous at this point.\n\nIn conclusion, only statement II is true."}] [{:db/id #edb/ref 17592186393250 :knowledge-point/_questions [{:db/id #edb/ref 17592186096631 :knowledge-point/id #uuid "cdc82e49-5df6-5096-a8fd-e00017fb1e3a" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Left Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ce3626c4-68fc-5111-92bb-c6a72ef04b3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[ln⁡(e+\\frac{4ie}{n})\\cdot \\frac{4e}{n}]" :db/id #edb/ref 17592186393252} {:answer/id #uuid "51976397-23e1-57d8-a039-644bf6317f62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{(-2i/n)}\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186393253} {:answer/id #uuid "9d2df163-f8cb-55a5-aa92-94fe12f6f8d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[ln⁡(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}]" :db/id #edb/ref 17592186393254} {:answer/id #uuid "680c2096-a3a6-56c7-af41-ad8e3a2a9b3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{(2i/n)}\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186393255} {:answer/id #uuid "7e48b7d1-54ea-5e38-b291-212dbf407565" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[ln⁡(e+\\frac{ie}{n})\\cdot \\frac{e}{n}]" :db/id #edb/ref 17592186393256}] :answer-field/correct {:answer/id #uuid "9d2df163-f8cb-55a5-aa92-94fe12f6f8d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[ln⁡(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}]" :db/id #edb/ref 17592186393254} :answer-field/id #uuid "ae6ae5ee-b93f-55d8-b530-ad34a29b014a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393251}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d2f3eda7-3ae2-5c51-adcd-171934d8313e" :question/math-academy-id "q-73156" :question/problem "What is ${\\int }_{e}^{3e}ln⁡x\\,\\text{d}x$ expressed as the limit of a left Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{i}=a+iΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{e}^{3e}ln⁡x\\,\\text{d}x,\n$$\n\nthe function is $f(x)=ln⁡x,$ the lower bound is $a=e,$ and the upper bound is $b=3e.$ So, we have\n\n$$\nΔx=\\frac{3e-e}{n}=\\frac{2e}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{e}^{3e}ln⁡x\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(e+i\\cdot \\frac{2e}{n})\\cdot \\frac{2e}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[ln⁡(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393264 :knowledge-point/_questions [{:db/id #edb/ref 17592186096633 :knowledge-point/id #uuid "29b136d3-69bc-51ef-a262-dbee8af377d2" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Right Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "516433a3-ddcf-5286-911f-d1661221641b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(\\frac{5k}{n})}^{-2}\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186393266} {:answer/id #uuid "91a60e1f-ff52-5d12-8845-6de6b6f23736" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(-2+\\frac{5k}{n})}^{3}\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186393267} {:answer/id #uuid "6006a006-5f33-5ef4-b609-573993a53f00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(2+\\frac{k}{n})}^{3}\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186393268} {:answer/id #uuid "8ff05667-12f6-5f44-9206-bc6cf51be751" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-{(-1+\\frac{5k}{n})}^{3}\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186393269} {:answer/id #uuid "af9dfa31-4950-5539-b718-f5c060dd0d43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2(5+\\frac{2k}{n})\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186393270}] :answer-field/correct {:answer/id #uuid "91a60e1f-ff52-5d12-8845-6de6b6f23736" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(-2+\\frac{5k}{n})}^{3}\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186393267} :answer-field/id #uuid "97365ecd-a18f-5653-861f-4053aa6db95b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393265}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f5568099-5914-5fb0-903c-d4010e585001" :question/math-academy-id "q-73180" :question/problem "What is ${\\int }_{-2}^{3}-2{x}^{3}\\text{d}x$ expressed as the limit of a right Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx,\n$$\n\nwhere ${x}_{k}=a+kΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{-2}^{3}-2{x}^{3}\\text{d}x,\n$$\n\nthe function is $f(x)=-2{x}^{3},$ the lower bound is $a=-2$ and the upper bound is $b=3.$ So, we have\n\n$$\nΔx=\\frac{3-(-2)}{n}=\\frac{5}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-2}^{3}-2{x}^{3}\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(-2+k\\cdot \\frac{5}{n})\\cdot \\frac{5}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(-2+\\frac{5k}{n})\\cdot \\frac{5}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(-2+\\frac{5k}{n})}^{3}\\cdot \\frac{5}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186342181 :knowledge-point/_questions [{:db/id #edb/ref 17592186073810 :knowledge-point/id #uuid "522b66f4-8a46-5dd0-a9d7-3b081c0ed157" :knowledge-point/title "Finding the Distance Between a Point and a Horizontal or Vertical Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59078a96-a4c1-5355-9bdf-3b0f39c93291" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186339938} {:answer/id #uuid "836328cc-8806-5c45-bf00-1c3923682d40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186340310} {:answer/id #uuid "9909d2b8-e7fa-56b5-9269-e5951dc53bcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186340509} {:answer/id #uuid "a86ba75a-1b29-5797-9053-bf2a3ad7aa27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186340658} {:answer/id #uuid "b0de169a-6a53-5b29-85e4-09cc91632445" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186340736}] :answer-field/correct {:answer/id #uuid "59078a96-a4c1-5355-9bdf-3b0f39c93291" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186339938} :answer-field/id #uuid "cab68815-1850-5693-b986-be3ac48add05" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341736}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "79f2f5ac-44c5-5b82-9c80-2524e0bd699c" :question/math-academy-id "q-74202" :question/problem "Find the shortest distance between the point $(-1,-4)$ and the line $x=4.$" :question/worked-solution "Let's sketch the given situation.\n\n![](images/d4/d46a6ed76af5c226e327ba197fe019df0d9085e095ca4781898aba54268a1706.png)\n\nSince the line $x=4$ is a vertical line, the shortest distance between this line and the point $(-1,-4)$ is given by the absolute value of the difference between $x$-coordinate of the point and $4.$ \n\nSo, the shortest distance is\n\n$$\nd=|-1-4|=5.\n$$"}] [{:db/id #edb/ref 17592186342208 :knowledge-point/_questions [{:db/id #edb/ref 17592186073811 :knowledge-point/id #uuid "d7030a12-bd18-5f8b-84eb-28b6f216f972" :knowledge-point/title "Finding the Distance Between a Point and a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b6fecf3-af6d-570c-a4e0-5bd2f8943b6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\sqrt{2}" :db/id #edb/ref 17592186339805} {:answer/id #uuid "86531e02-9d87-59a8-99d4-328fa2c86fbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186340333} {:answer/id #uuid "d5e737ba-76b9-5760-80fc-271f650d20e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186341023} {:answer/id #uuid "e47935d1-86c8-5a85-a24b-c428d0150116" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186341149} {:answer/id #uuid "e58979f5-86fa-57ab-b8b7-766696bc055b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{3}" :db/id #edb/ref 17592186341156}] :answer-field/correct {:answer/id #uuid "86531e02-9d87-59a8-99d4-328fa2c86fbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186340333} :answer-field/id #uuid "6f8851fb-c592-5f14-9bf4-a48b2c458a74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341574}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f0e530ca-0510-53a9-a606-7cbe24765900" :question/math-academy-id "q-74417" :question/problem "Find the shortest distance between the point $(-1,-3)$ and the line $y=-x+2.$" :question/worked-solution "Let's draw a diagram describing our situation.\n\n![](images/eb/eb1176b4a5e2565fceb03e9af652a6ae875f5ee678c103405045fcebc36342e1.png)\n\nFirst, we find the equation of the line that's perpendicular to $y=-x+2$ and passes through the point $(-1,-3).$\n\n The given line has a slope of $-1,$ so our perpendicular line must have a slope of $1.$\n\nUsing point-slope form and simplifying, we obtain the equation of the perpendicular line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y+3 & =1(x+1) \\\\ y+3 & =x+1 \\\\ y & =x-2\\end{aligned}\n$$\n\nWe now find the point where the two lines intersect. To do this, we solve the following system of equations:\n\n$$\n{\\begin{aligned}y=-x+2 \\\\ y=x-2\\end{aligned}\n$$\n\nWe can solve this system by putting the two equations equal to one another and solving for $x.$ This gives\n\n$$\n\\begin{aligned}-x+2 & =x-2 \\\\ -x-x & =-2-2 \\\\ -2x & =-4 \\\\ x & =2.\\end{aligned}\n$$\n\nSubstituting $x=2$ into either of the two equations gives $y=0.$ So, our solution is $x=2$ and $y=0.$ Therefore, the lines intersect at the point $(2,0).$\n\nFinally, we find the distance $d$ between the points $(-1,-3)$ and $(2,0):$\n\n$$\n\\begin{aligned}d & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{(2-(-1))^{2}+(0-(-3))^{2}} \\\\  & =\\sqrt{9+9} \\\\  & =\\sqrt{18} \\\\  & =3\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, we conclude that the shortest distance between the point $(-1,-3)$ and the line $y=-x+2$ is $3\\sqrt{2}.$"}] [{:db/id #edb/ref 17592186342212 :knowledge-point/_questions [{:db/id #edb/ref 17592186073815 :knowledge-point/id #uuid "59d3a391-c163-5a04-944c-5d61a3950e03" :knowledge-point/title "Finding a Point on a Line That Is Closest to a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47f7ce0c-16e5-531a-94b9-547622df3f25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,-2)" :db/id #edb/ref 17592186339767} {:answer/id #uuid "569cbb0a-f99c-5355-8f53-bdc678082993" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,0)" :db/id #edb/ref 17592186339923} {:answer/id #uuid "8688ee8a-8219-5c84-a042-632559c1a6df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,-3)" :db/id #edb/ref 17592186340337} {:answer/id #uuid "95f977c5-80d6-5f10-bfe2-b1560cf968b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-1)" :db/id #edb/ref 17592186340481} {:answer/id #uuid "ae765e2d-062d-5b17-8c52-1eef7d4ff32e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-5,1)" :db/id #edb/ref 17592186340720}] :answer-field/correct {:answer/id #uuid "95f977c5-80d6-5f10-bfe2-b1560cf968b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-1)" :db/id #edb/ref 17592186340481} :answer-field/id #uuid "73585de0-1b70-548d-9d76-12f3a61d673b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341582}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7220b7e3-9cce-5102-874c-014511b9e7f6" :question/math-academy-id "q-74439" :question/problem "![](images/1d/1d687bcdc23c283e0945b039781450d2a020f0fd89c0d2976bb252914b296978.png)\n\nFind the point on the line $y+x=-4$ that is closest to the point $(0,2).$" :question/worked-solution "First, we rewrite the equation of the given line in slope-intercept form:\n\n$$\n\\begin{aligned}y+x & =-4 \\\\ y & =-x-4\\end{aligned}\n$$\n\nNext, we find the equation of the line that's perpendicular to $y=-x-4$ and passes through the point $(0,2).$\n\n The given line has a slope of $-1,$ so our perpendicular line must have a slope of $1.$\n\nUsing point-slope form and simplifying, we obtain the equation of the perpendicular line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-2 & =1(x-0) \\\\ y-2 & =x \\\\ y & =x+2\\end{aligned}\n$$\n\nWe now find the point where the two lines intersect. To do this, we solve the following system of equations:\n\n$$\n{\\begin{aligned}y=x+2 \\\\ y=-x-4\\end{aligned}\n$$\n\nWe can solve this system by putting the two equations equal to one another and solving for $x.$ This gives\n\n$$\n\\begin{aligned}x+2 & =-x-4 \\\\ x+x & =-4-2 \\\\ 2x & =-6 \\\\ x & =-3.\\end{aligned}\n$$\n\nSubstituting $x=-3$ into either of the two equations gives $y=-1.$ So, our solution is $x=-3$ and $y=-1.$ So, the lines intersect at the point $(-3,-1).$\n\nTherefore, we conclude that the point on the line $y+x=-4$ that is closest to the point $(0,2)$ is  $(-3,-1).$"}] [{:db/id #edb/ref 17592186344977 :knowledge-point/_questions [{:db/id #edb/ref 17592186087671 :knowledge-point/id #uuid "2902b205-4508-55c6-9a68-f57d3afc9eab" :knowledge-point/title "Finding Exact Values of Trigonometric Expressions Using the Double-Angle Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02d46c16-ac4e-57b4-ae20-20086616c19f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186342277} {:answer/id #uuid "24e78c28-e4f9-5764-a34b-418c159f48ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186342548} {:answer/id #uuid "461de0e9-b9bb-5f6f-af7c-df1d3be102dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186342814} {:answer/id #uuid "80b774e9-0533-56ca-9013-aade87186d21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186343348} {:answer/id #uuid "9d2368da-9551-54cc-b612-4a5cc5d70024" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186343622}] :answer-field/correct {:answer/id #uuid "80b774e9-0533-56ca-9013-aade87186d21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186343348} :answer-field/id #uuid "a4a9942c-2ff0-547a-87bb-c11cc79e965c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344783}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b81c92b6-aaf0-5164-b094-1fd4bab4c1a6" :question/math-academy-id "q-7473" :question/problem "Find the exact value of $1-2{sin}^{2}⁡({22.5}^{∘}).$" :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n1-2{sin}^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x={22.5}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}1-2{sin}^{2}⁡({22.5}^{∘}) & =\\operatorname{cos}⁡(2\\cdot {22.5}^{∘}) \\\\  & =\\operatorname{cos}⁡{45}^{∘} \\\\  & =\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393431 :knowledge-point/_questions [{:db/id #edb/ref 17592186087747 :knowledge-point/id #uuid "ad1c29f7-c0e7-5bed-944f-a2e33579c7b8" :knowledge-point/title "Determining the Image of a Vector Under a Map Using the Scalar Multiplication Property"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c348231-faac-5f15-ba88-4a5fcff9895b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186393433} {:answer/id #uuid "1cbe61fb-3b9a-5b63-aefd-518ef08c77c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186393434} {:answer/id #uuid "741f5285-7e52-5afa-8fd8-e7ffe7bb3ffa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186393435} {:answer/id #uuid "3e486dbe-f3f0-57e0-8019-075933a8c6cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186393436} {:answer/id #uuid "9e1aa637-1399-5be1-8754-cfd06e8753a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186393437}] :answer-field/correct {:answer/id #uuid "9e1aa637-1399-5be1-8754-cfd06e8753a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186393437} :answer-field/id #uuid "3d0c3af7-ad97-5864-bf2c-f087f946215b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393432}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "96c9c6b4-4b9d-5bd8-af24-21ff4fd8965e" :question/math-academy-id "q-74762" :question/problem "If $\\,T\\,$ is a linear transformation and $\\,T([\\begin{aligned}4 \\\\ 12\\end{aligned}])=[\\begin{aligned}-12 \\\\ 16\\end{aligned}]$, then find $\\,T([\\begin{aligned}1 \\\\ 3\\end{aligned}]).$" :question/worked-solution "Since $T$ is a linear transformation, it must satisfy $T(kv)=kT(v).$ Noting that $[\\begin{aligned}4 \\\\ 12\\end{aligned}]=4[\\begin{aligned}1 \\\\ 3\\end{aligned}],$ we have\n\n$$\n\\begin{aligned}T([\\begin{aligned}4 \\\\ 12\\end{aligned}]) & =T(4[\\begin{aligned}1 \\\\ 3\\end{aligned}])=4T([\\begin{aligned}1 \\\\ 3\\end{aligned}]).\\end{aligned}\n$$\n\nNow, since we're told that \n\n$$\nT([\\begin{aligned}4 \\\\ 12\\end{aligned}])=[\\begin{aligned}-12 \\\\ 16\\end{aligned}],\n$$\n\nwe must have\n\n$$\n\\begin{aligned}4T([\\begin{aligned}1 \\\\ 3\\end{aligned}]) & =[\\begin{aligned}-12 \\\\ 16\\end{aligned}] \\\\ T([\\begin{aligned}1 \\\\ 3\\end{aligned}]) & =\\frac{1}{4}[\\begin{aligned}-12 \\\\ 16\\end{aligned}] \\\\ T([\\begin{aligned}1 \\\\ 3\\end{aligned}]) & =[\\begin{aligned}-3 \\\\ 4\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186344981 :knowledge-point/_questions [{:db/id #edb/ref 17592186087748 :knowledge-point/id #uuid "381f7ffe-ae4b-5e45-9fa9-e2a6bd8348b3" :knowledge-point/title "Determining the Image of a Vector Under a Map Using Vector Addition and Scalar Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e37951b-03d5-5d76-8207-ab35ada60274" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186342489} {:answer/id #uuid "6884287b-be82-539e-a37e-d742e488e1f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 \\\\ 12\\end{aligned}]" :db/id #edb/ref 17592186343130} {:answer/id #uuid "6fd306d4-ea1c-535c-800d-cf76b50ffc31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186343199} {:answer/id #uuid "bd29d454-d450-573b-992f-b35c8afcb1e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186343901} {:answer/id #uuid "e53aba8b-8d6b-5204-b078-e2ccc56fd5f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186344254}] :answer-field/correct {:answer/id #uuid "1e37951b-03d5-5d76-8207-ab35ada60274" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186342489} :answer-field/id #uuid "761eb299-8f17-5fa6-8798-80c42abd8f3d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344706}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c7ac2355-a1ae-54c5-9e5b-62d94023dff1" :question/math-academy-id "q-74775" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,T(3{v}_{1}+7{v}_{2})=[\\begin{aligned}13 \\\\ 5\\end{aligned}]\\,$ and $\\,T({v}_{2})=[\\begin{aligned}1 \\\\ -1\\end{aligned}]$, then find $\\,T({v}_{1}).$" :question/worked-solution "Since $T$ is a linear transformation, we have that\n\n$$\n\\begin{aligned}T(kv+hw)=T(kv)+T(hw)=kT(v)+hT(w)\\end{aligned}\n$$\n\nfor any vectors $v$ and $w.$ Therefore,\n\n$$\n\\begin{aligned}T(3{v}_{1}+7{v}_{2}) & =3T({v}_{1})+7T({v}_{2}) \\\\ [\\begin{aligned}13 \\\\ 5\\end{aligned}] & =3T({v}_{1})+7[\\begin{aligned}1 \\\\ -1\\end{aligned}] \\\\ 3T({v}_{1}) & =[\\begin{aligned}13 \\\\ 5\\end{aligned}]-7[\\begin{aligned}1 \\\\ -1\\end{aligned}] \\\\ 3T({v}_{1}) & =[\\begin{aligned}13 \\\\ 5\\end{aligned}]-[\\begin{aligned}7 \\\\ -7\\end{aligned}] \\\\ 3T({v}_{1}) & =[\\begin{aligned}6 \\\\ 12\\end{aligned}] \\\\ T({v}_{1}) & =\\frac{1}{3}[\\begin{aligned}6 \\\\ 12\\end{aligned}] \\\\ T({v}_{1}) & =[\\begin{aligned}2 \\\\ 4\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186398989 :knowledge-point/_questions [{:db/id #edb/ref 17592186087749 :knowledge-point/id #uuid "9fbd335c-28cc-5f02-b773-f685e8b15417" :knowledge-point/title "Determining the Image of a Vector Sum Under a Map Using Vector Addition and Scalar Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a9149cf2-edbf-544d-9c0f-90c2f55edc73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}63 \\\\ 51 \\\\ -42\\end{aligned}]" :db/id #edb/ref 17592186398991} {:answer/id #uuid "1f624e49-b4d8-5481-a766-3d48a04ffb70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-42 \\\\ -34 \\\\ 28\\end{aligned}]" :db/id #edb/ref 17592186398992} {:answer/id #uuid "f08777ee-7bc2-552d-b942-d0cc1bce2816" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-21 \\\\ -17 \\\\ 14\\end{aligned}]" :db/id #edb/ref 17592186398993} {:answer/id #uuid "05991325-fa66-564d-8673-e9450a190897" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-63 \\\\ -51 \\\\ 42\\end{aligned}]" :db/id #edb/ref 17592186398994} {:answer/id #uuid "91bbea6d-c7c9-55fe-bfcc-d43e664cab17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}42 \\\\ 34 \\\\ -28\\end{aligned}]" :db/id #edb/ref 17592186398995}] :answer-field/correct {:answer/id #uuid "91bbea6d-c7c9-55fe-bfcc-d43e664cab17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}42 \\\\ 34 \\\\ -28\\end{aligned}]" :db/id #edb/ref 17592186398995} :answer-field/id #uuid "8bb35426-6c4d-5808-82e6-12f94e6cdf85" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398990}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7e4e42a9-e81d-5610-8794-d5c4cdbe24ee" :question/math-academy-id "q-74781" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,{v}_{1}+{v}_{2}=0\\,$ and $\\,T({v}_{2})=[\\begin{aligned}21 \\\\ 17 \\\\ -14\\end{aligned}]\\,$, find $\\,T(37{v}_{1}+39{v}_{2}).$" :question/worked-solution "First, we have that \n\n$$\n\\begin{aligned}37{v}_{1}+39{v}_{2} & =37{v}_{1}+37{v}_{2}+2{v}_{2} \\\\  & =37({v}_{1}+{v}_{2})+2{v}_{2} \\\\  & =37(0)+2{v}_{2} \\\\  & =2{v}_{2}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nT(37{v}_{1}+39{v}_{2})=T(2{v}_{2}).\n$$\n\n \n\nNow, since $T$ is a linear transformation, we have that $T(kv)=kT(v).$ So \n\n$$\n\\begin{aligned}T(2{v}_{2}) & =2T({v}_{2}) \\\\  & =2[\\begin{aligned}21 \\\\ 17 \\\\ -14\\end{aligned}] \\\\  & =[\\begin{aligned}42 \\\\ 34 \\\\ -28\\end{aligned}].\\end{aligned}\n$$\n\nIn conclusion, $T(37{v}_{1}+39{v}_{2})=[\\begin{aligned}42 \\\\ 34 \\\\ -28\\end{aligned}].$"}] [{:db/id #edb/ref 17592186345133 :knowledge-point/_questions [{:db/id #edb/ref 17592186096635 :knowledge-point/id #uuid "a7eb3fea-e4cf-5537-9a33-06b9d2b35c6b" :knowledge-point/title "Solving a System Containing Fractions in Both Equations Using Elimination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "703429e4-f6ee-5ae0-b54b-621a3b3aa87c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-2,\\,y=-12" :db/id #edb/ref 17592186343202} {:answer/id #uuid "a374971b-c760-5d83-adbf-3b1936e47374" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1,\\,y=-6" :db/id #edb/ref 17592186343673} {:answer/id #uuid "bbd32382-778d-546c-b434-bc2f6f15182c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-4,\\,y=-4" :db/id #edb/ref 17592186343889} {:answer/id #uuid "bd80722c-1778-5d31-a005-82a0a1a70cf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2},\\,y=-3" :db/id #edb/ref 17592186343905} {:answer/id #uuid "f93e23d5-adfb-539c-932c-d93d3f7f5111" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=4,\\,y=4" :db/id #edb/ref 17592186344431}] :answer-field/correct {:answer/id #uuid "bd80722c-1778-5d31-a005-82a0a1a70cf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2},\\,y=-3" :db/id #edb/ref 17592186343905} :answer-field/id #uuid "0e62a385-bb95-5754-89d7-c5b01db0db60" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344523}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "263b5643-f9a7-58b5-b4f2-be4d8aef81b1" :question/math-academy-id "q-75862" :question/problem "Find the solution to the  following system of equations:\n\n$$\n{\\begin{aligned}2x-\\frac{1}{3}y=2 \\\\ \\frac{1}{2}x-\\frac{1}{4}y=1\\end{aligned}\n$$" :question/worked-solution "To get rid of fractions, we multiply the first equation by $3$ and the second equation by $4,$ as follows:\n\n$$\n{\\begin{aligned}2x-\\frac{1}{3}y=2 & |\\times 3 \\\\ \\frac{1}{2}x-\\frac{1}{4}y=1 & |\\times 4\\end{aligned}\\,⟹\\,{\\begin{aligned}6x-y=6 \\\\ 2x-y=4\\end{aligned}\n$$\n\nWe will use the elimination method to solve the system. Notice that if we multiply the second equation by $-1,$ then we will get a $y$ term that can cancel with the $-y$ term in the first equation:\n\n$$\n{\\begin{aligned}6x-y=6 &  \\\\ 2x-y=4 & |\\,\\times (-1)\\end{aligned}\\,⟹\\,{\\begin{aligned}6x-y=6 \\\\ -2x+y=-4\\end{aligned}\n$$\n\nAdding the two equations eliminates the $y$-variable, and allows us to solve for $x:$\n\n$$\n\\begin{aligned}6x-\\cancel{y} & =6 \\\\ -2x+\\cancel{y} & =-4 \\\\ (6x-2x) & =(6-4) \\\\ 4x & =2 \\\\ x & =\\frac{2}{4} \\\\ x & =\\frac{1}{2}\\end{aligned}\n$$\n\nFinally, we substitute $x=\\frac{1}{2}$ into the second equation to solve for $y:$\n\n$$\n\\begin{aligned}2x-y & =4 \\\\ 2(\\frac{1}{2})-y & =4 \\\\ 1-y & =4 \\\\ y & =1-4 \\\\ y & =-3\\end{aligned}\n$$\n\nTherefore, the solution to the system is $x=\\frac{1}{2},\\,y=-3.$"}] [{:db/id #edb/ref 17592186345134 :knowledge-point/_questions [{:db/id #edb/ref 17592186068880 :knowledge-point/id #uuid "b5916154-14b6-5e2d-b33c-176b76293927" :knowledge-point/title "Solving Rational Equations Containing One Distinct Linear Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "403fead1-28dc-51e8-883e-1ea78fb58c8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186342768} {:answer/id #uuid "51524fcb-5371-5134-98fd-7bc0b95c2398" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186342910} {:answer/id #uuid "6d345723-89f4-5351-84cf-b5bdbe44c4c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186343174} {:answer/id #uuid "bcca82d0-a051-5fde-94e1-fbf46764a754" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186343898} {:answer/id #uuid "dce93094-4d77-5ba6-b201-1d213789909e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186344178}] :answer-field/correct {:answer/id #uuid "6d345723-89f4-5351-84cf-b5bdbe44c4c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186343174} :answer-field/id #uuid "db497c06-807c-5ce4-a68f-3dd5b362ea6c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344873}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "19f3a0d4-a9e3-5752-9f3d-c41b8d14446d" :question/math-academy-id "q-75924" :question/problem "Solve for $x$ where $\\frac{x+7}{x}-\\frac{1-x}{x}=4.$" :question/worked-solution "First, we note that $x=0$ is an excluded solution since division by $0$ is undefined. \n\nWe multiply both sides of the equation by $x,$ and simplify: \n\n$$\n\\begin{aligned}\\frac{x+7}{x}-\\frac{1-x}{x} & =4 \\\\ x\\cdot (\\frac{x+7}{x}-\\frac{1-x}{x}) & =x\\cdot 4 \\\\ x\\cdot \\frac{x+7}{x}-x\\cdot \\frac{1-x}{x} & =x\\cdot 4 \\\\ \\cancel{x}\\cdot \\frac{x+7}{\\cancel{x}}-\\cancel{x}\\cdot \\frac{1-x}{\\cancel{x}} & =4x \\\\ x+7-(1-x) & =4x\\end{aligned}\n$$\n\nWe now have a linear equation in $x,$ and we can solve this using the addition and multiplication principles:\n\n$$\n\\begin{aligned}x+7-(1-x) & =4x \\\\ 2x+6 & =4x \\\\ 4x-2x & =6 \\\\ 2x & =6 \\\\ x & =3\\end{aligned}\n$$\n\nFinally, we recall that we cannot allow $x=0$ as a solution. But since $x=3\\ne 0,$ we conclude that the solution is $x=3.$"}] [{:db/id #edb/ref 17592186345135 :knowledge-point/_questions [{:db/id #edb/ref 17592186068880 :knowledge-point/id #uuid "b5916154-14b6-5e2d-b33c-176b76293927" :knowledge-point/title "Solving Rational Equations Containing One Distinct Linear Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2685fdf5-b2ef-5419-a715-1c74ce9389ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186342565} {:answer/id #uuid "26c73ff8-7bb1-58f5-b9d4-61756b11ddfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}" :db/id #edb/ref 17592186342568} {:answer/id #uuid "75251e7a-9236-5e4c-9b53-7cfd86320732" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186343251} {:answer/id #uuid "978d082a-57ab-588e-8901-810af078103c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186343568} {:answer/id #uuid "9f71a6a2-9c4d-582e-afe9-1afe12b68ba5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186343645}] :answer-field/correct {:answer/id #uuid "26c73ff8-7bb1-58f5-b9d4-61756b11ddfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}" :db/id #edb/ref 17592186342568} :answer-field/id #uuid "4171e3f8-5f6b-53b2-9b4c-3f49129ae323" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344598}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dd8936d7-9acb-5f42-aac4-919b57567005" :question/math-academy-id "q-75925" :question/problem "Solve for $x$ where $\\frac{x-2}{5x}=\\frac{3-20x}{5x}+5.$" :question/worked-solution "First, we note that $x=0$ is an excluded solution since division by $0$ is undefined. \n\nWe multiply both sides of the equation by $5x,$ and simplify: \n\n$$\n\\begin{aligned}\\frac{x-2}{5x} & =\\frac{3-20x}{5x}+5 \\\\ 5x\\cdot (\\frac{x-2}{5x}) & =5x\\cdot (\\frac{3-20x}{5x}+5) \\\\ 5x\\cdot \\frac{x-2}{5x} & =5x\\cdot \\frac{3-20x}{5x}+5x\\cdot 5 \\\\ \\cancel{5x}\\cdot \\frac{x-2}{\\cancel{5x}} & =\\cancel{5x}\\cdot \\frac{3-20x}{\\cancel{5x}}+25x \\\\ x-2 & =3-20x+25x\\end{aligned}\n$$\n\nWe now have a linear equation in $x,$ and we can solve this using the addition and multiplication principles:\n\n$$\n\\begin{aligned}x-2 & =3-20x+25x \\\\ x-2 & =3+5x \\\\ 5x-x & =-2-3 \\\\ 4x & =-5 \\\\ x & =-\\frac{5}{4}\\end{aligned}\n$$\n\nFinally, we recall that we cannot allow $x=0$ as a solution. But since $x=-\\frac{5}{4}\\ne 0,$ we conclude that the solution is $x=-\\frac{5}{4}.$"}] [{:db/id #edb/ref 17592186345137 :knowledge-point/_questions [{:db/id #edb/ref 17592186068882 :knowledge-point/id #uuid "f63f80b8-f564-56e6-8c90-6918d64e0316" :knowledge-point/title "Solving Rational Equations Containing Three Distinct Linear Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14a7452c-e3f9-526d-82be-805b605b288f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186342420} {:answer/id #uuid "2377a0c3-c1bd-53c7-93bf-77cbc38fa76c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186342532} {:answer/id #uuid "7c304e6a-4939-558c-9504-44c7f57d0bd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{4}" :db/id #edb/ref 17592186343307} {:answer/id #uuid "b825111c-c17e-5e28-b1d7-789b226b6fd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186343852} {:answer/id #uuid "cef19a74-15fe-5db4-b7f1-7bf698a07ed9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186344060}] :answer-field/correct {:answer/id #uuid "b825111c-c17e-5e28-b1d7-789b226b6fd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186343852} :answer-field/id #uuid "4c9331d1-6e4e-5569-b803-cfc624eda5cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344621}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "64167e5a-a3e2-55d1-956c-8945cc13aa71" :question/math-academy-id "q-75941" :question/problem "Which value of $m$ satisfies the equation $\\frac{2m-3}{3m}+\\frac{m+5}{5m}=\\frac{m+4}{15m}?$" :question/worked-solution "We note that $m=0$ cannot be a solution since division by $0$ is undefined. \n\nThe equation has the denominators $3m,5m,$ and $15m.$ So first, we find the least common multiple (or $\\text{LCM}$) of the denominators. We find that\n\n$$\n\\text{LCM}(3m,5m,15m)=15m.\n$$\n\nSo, we multiply both sides of the equation by $15m,$ and simplify: \n\n$$\n\\begin{aligned}\\frac{2m-3}{3m}+\\frac{m+5}{5m} & =\\frac{m+4}{15m} \\\\ 15m\\cdot (\\frac{2m-3}{3m}+\\frac{m+5}{5m}) & =15m\\cdot (\\frac{m+4}{15m}) \\\\ 15m\\cdot (\\frac{2m-3}{3m})+15m\\cdot (\\frac{m+5}{5m}) & =15m\\cdot (\\frac{m+4}{15m}) \\\\ 5\\cdot 3m\\cdot (\\frac{2m-3}{3m})+3\\cdot 5m\\cdot (\\frac{m+5}{5m}) & =15m\\cdot (\\frac{m+4}{15m}) \\\\ 5\\cdot \\cancel{3m}\\cdot (\\frac{2m-3}{\\cancel{3m}})+3\\cdot \\cancel{5m}\\cdot (\\frac{m+5}{\\cancel{5m}}) & =\\cancel{15m}\\cdot (\\frac{m+4}{\\cancel{15m}}) \\\\ 5(2m-3)+3(m+5) & =m+4\\end{aligned}\n$$\n\nWe now have a linear equation in $m,$ and we can solve this using the addition and multiplication principles:\n\n$$\n\\begin{aligned}5(2m-3)+3(m+5) & =m+4 \\\\ 10m-15+3m+15 & =m+4 \\\\ 13m & =m+4 \\\\ 12m & =4 \\\\ m & =\\frac{1}{3}\\end{aligned}\n$$\n\nFinally, we recall that we cannot allow $m=0$ as a solution. But since $m=\\frac{1}{3}\\ne 0,$ we conclude that the solution is $m=\\frac{1}{3}.$"}] [{:db/id #edb/ref 17592186399050 :knowledge-point/_questions [{:db/id #edb/ref 17592186078404 :knowledge-point/id #uuid "3e806aac-62fc-5c53-a15e-a2ce175dad25" :knowledge-point/title "Determining Open Intervals of Continuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7db323bd-027d-5a72-8744-915dc9466d84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,-2)" :db/id #edb/ref 17592186399052} {:answer/id #uuid "363b9e46-0e55-5119-8918-a99ef9c17cd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,4)" :db/id #edb/ref 17592186399053} {:answer/id #uuid "c64155b0-249e-5565-ad41-5aa4d4de25a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,3)" :db/id #edb/ref 17592186399054} {:answer/id #uuid "ab114369-abaf-5996-96e1-bc98ccf909b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,5)" :db/id #edb/ref 17592186399055} {:answer/id #uuid "5bd9f381-647a-53f8-8916-ebcaa02fb734" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,0)" :db/id #edb/ref 17592186399056}] :answer-field/correct {:answer/id #uuid "c64155b0-249e-5565-ad41-5aa4d4de25a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,3)" :db/id #edb/ref 17592186399054} :answer-field/id #uuid "ad20513b-7f6b-51c1-b3e8-54f31e6cfac0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399051}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bfd92570-bd08-5565-9c64-935de2ba2369" :question/math-academy-id "q-76110" :question/problem "![](images/76/760ddc657e8372a3860e2553e4f2b713a8b12544586c708e5f2c1922462567a8.png)\n\nOn which of the following intervals is the function $y=f(x)$ above continuous? You may assume that all points of discontinuity of $f(x)$ are shown in the diagram." :question/worked-solution "To determine the intervals of continuity of a function, we take the domain of the function and exclude any points of discontinuity.\n\nThe function is defined on the intervals $(-\\infty ,3),$  and $(3,\\infty ).$ There is a discontinuity at $x=3$  but this is already excluded.  \n\nThere is also a discontinuity at $x=-3,$ so we need to exclude that.\n\nTherefore, the function is continuous on the intervals $(-\\infty ,-3),$ $(-3,3),$  and $(3,\\infty ).$ It is also continuous on any subinterval of these intervals. \n\nAmong the answer choices, the correct one is the following:\n\n$\\,$ $(-2,3)$ \n\nNotice that:\n\n- $(-3,4)$ and $(0,5)$ contain the excluded point $x=3,$ so the function is not continuous on these intervals.\n\n- $(-\\infty ,-2)$ and  $(-\\infty ,0)$ contain the point of discontinuity $x=-3$, so the function is not continuous on these intervals."}] [{:db/id #edb/ref 17592186345221 :knowledge-point/_questions [{:db/id #edb/ref 17592186152117 :knowledge-point/id #uuid "92a06a13-9e6b-53b1-9fad-ec6cba8b9545" :knowledge-point/title "Finding the LCM of Two Single-Variable Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d89e619-199e-55ac-8eca-9d77fffa7706" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30(y+1)^{6}" :db/id #edb/ref 17592186343023} {:answer/id #uuid "a00fafbc-22ed-52d6-8f01-31dffa057768" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30(y+1)^{10}" :db/id #edb/ref 17592186343651} {:answer/id #uuid "da747809-5242-5b07-9971-7285cceb6b5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "150(y+1)^{10}" :db/id #edb/ref 17592186344157} {:answer/id #uuid "eb3e407c-9b56-57b2-833f-24e819c942f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30(y+1)^{12}" :db/id #edb/ref 17592186344298} {:answer/id #uuid "eb9d1027-57d3-5a23-9b93-f847e9338320" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "150(y+1)^{6}" :db/id #edb/ref 17592186344302}] :answer-field/correct {:answer/id #uuid "5d89e619-199e-55ac-8eca-9d77fffa7706" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30(y+1)^{6}" :db/id #edb/ref 17592186343023} :answer-field/id #uuid "81b1b5e2-12f3-59b8-8a06-c39c41de6a36" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344722}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6fe6c820-9683-5a7a-b33c-5f323f0359af" :question/math-academy-id "q-76457" :question/problem "Find the least common multiple of $10(y+1)^{6}$ and $15(y+1)^{4}.$" :question/worked-solution "To find the least common multiple ($\\text{LCM}$) of two polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of the variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(10,15):$\n\n- Multiples of $10:$ $\\,10,\\,20,\\,30,\\,40,…$\n\n- Multiples of $15:$ $\\,15,\\,30,\\,45,…$\n\nSo, $\\text{LCM}(10,15)=30.$\n\nTo find the $\\text{LCM}$ of $(y+1)^{6}$ and $(y+1)^{4},$ we raise $(y+1)$ to the largest power that appears in the expressions, which is $6.$ Therefore,\n\n$$\n\\text{LCM}((y+1)^{6},\\,(y+1)^{4})=(y+1)^{6}.\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\text{LCM}(10(y+1)^{6},\\,15(y+1)^{4})=30\\cdot (y+1)^{6}=30(y+1)^{6}.\n$$"}] [{:db/id #edb/ref 17592186345222 :knowledge-point/_questions [{:db/id #edb/ref 17592186152119 :knowledge-point/id #uuid "57496436-8bd0-567e-8c37-ed584849ce1a" :knowledge-point/title "Finding the LCM of Three Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0605e45f-3e5a-5d33-a682-7100aa2a8ca5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120{x}^{4}(y+2)" :db/id #edb/ref 17592186342294} {:answer/id #uuid "11f59668-bc57-5e29-9418-45b2197c07c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120{x}^{7}(y+2)^{3}" :db/id #edb/ref 17592186342398} {:answer/id #uuid "b54ac959-62ea-5199-9f5f-2f2c86259b21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60{x}^{17}(y+2)^{6}" :db/id #edb/ref 17592186343825} {:answer/id #uuid "ca0e194f-07bb-5959-8ccc-8a01a267e3db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60{x}^{4}(y+2)" :db/id #edb/ref 17592186344013} {:answer/id #uuid "d99fcded-2ea6-5c5d-aeda-dffd3b0f7c7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60{x}^{7}(y+2)^{3}" :db/id #edb/ref 17592186344149}] :answer-field/correct {:answer/id #uuid "d99fcded-2ea6-5c5d-aeda-dffd3b0f7c7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60{x}^{7}(y+2)^{3}" :db/id #edb/ref 17592186344149} :answer-field/id #uuid "27415d0b-998e-58eb-abc2-faf32c0e2a98" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344563}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "288f9264-3705-5ed8-96fa-98d1f57e896b" :question/math-academy-id "q-76475" :question/problem "Find the least common multiple of the polynomials $20{x}^{7}(y+2),$ $\\,10{x}^{6}(y+2)^{3},$ and $12{x}^{4}(y+2)^{2}.$" :question/worked-solution "To find the least common multiple ($\\text{LCM}$) of three polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of each variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(20,10,12):$\n\n- Multiples of $20:$ $\\,20,\\,40,\\,60,\\,80,\\,100,\\,…$\n\n- Multiples of $10:$ $\\,10,\\,20,\\,30,\\,40,\\,50,\\,60,\\,70,\\,…$\n\n- Multiples of $12:$ $\\,12,\\,24,\\,36,\\,48,\\,60,\\,72,…$\n\nSo, $\\text{LCM}(20,10,12)=60.$\n\nTo find the $\\text{LCM}$ of ${x}^{7}(y+2),{x}^{6}(y+2)^{3},$ and ${x}^{4}(y+2)^{2},$ we find the largest powers for $x$ and $(y+2)$ that appear in all these expressions:\n\n- For ${x}^{7},\\,{x}^{6},$ and ${x}^{4},$ the largest power is $7.$\n\n- For $(y+2),(y+2)^{3},$ and $(y+2)^{2},$ the largest power is $3.$\n\nNow, we raise $x$ and $(y+2)$ to the corresponding largest powers. Therefore,\n\n$$\n\\text{LCM}({x}^{7}(y+2),\\,{x}^{6}(y+2)^{3},\\,{x}^{4}(y+2)^{2})={x}^{7}\\cdot (y+2)^{3}.\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\begin{aligned}\\text{LCM}(20{x}^{7}(y+2),\\,10{x}^{6}(y+2)^{3},\\,12{x}^{4}(y+2)^{2}) & = \\\\ 60\\cdot {x}^{7}\\cdot (y+2)^{3} & = \\\\ 60{x}^{7}(y+2)^{3} & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186345256 :knowledge-point/_questions [{:db/id #edb/ref 17592186115360 :knowledge-point/id #uuid "fe83dedc-3034-5e3a-b546-dd57c0ccc6e8" :knowledge-point/title "Finding the Area of a Triangle by Solving for a Variable Given an Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11080520-591d-552f-a2b5-376652328032" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{3}" :db/id #edb/ref 17592186342388} {:answer/id #uuid "20d23199-1707-5c8a-9c95-20a93346eafc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{3}}{2}" :db/id #edb/ref 17592186342508} {:answer/id #uuid "23574e97-dff3-5da7-b5f5-3cada9731425" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9\\sqrt{3}}{2}" :db/id #edb/ref 17592186342530} {:answer/id #uuid "bb1702de-fd43-50d8-a686-676b7d54dfb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24\\sqrt{3}" :db/id #edb/ref 17592186343884} {:answer/id #uuid "f9127ae7-e1de-5695-9e51-049f89115cde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt{3}" :db/id #edb/ref 17592186344429}] :answer-field/correct {:answer/id #uuid "f9127ae7-e1de-5695-9e51-049f89115cde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt{3}" :db/id #edb/ref 17592186344429} :answer-field/id #uuid "2b740c15-4310-51b1-b74c-cbe3e504200f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344566}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c61332e0-ca58-508b-96a8-0bfc3b0688b0" :question/math-academy-id "q-76773" :question/problem "![](images/ca/ca9c6640b6cb239ae19b195731d8f605adae8826f66e10b075f7b0ad4a60690f.png)\n\nFind the area (in square units) of $△ABC$ shown above." :question/worked-solution "In this case, the area of the right triangle is\n\n$$\nA=\\frac{1}{2}AB\\cdot BC.\n$$\n\nWe are given that $m∠A={30}^{∘}.$ Notice that relative to $∠A,$ we have expressions for the lengths of the opposite side $\\overset{―}{BC}$ and adjacent side $\\overset{―}{AB}.$ Hence, we can use the tangent ratio to solve for $x:$\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡(m∠A) & =\\frac{BC}{AB} \\\\ \\operatorname{tan}⁡({30}^{∘}) & =\\frac{\\sqrt{3}\\,x}{x+4} \\\\ \\frac{\\sqrt{3}}{3} & =\\frac{\\sqrt{3}\\,x}{x+4} \\\\ \\sqrt{3}(x+4) & =3\\cdot \\sqrt{3}\\,x \\\\ \\sqrt{3}\\,x+4\\sqrt{3} & =3\\sqrt{3}\\,x \\\\ -2\\sqrt{3}\\,x & =-4\\sqrt{3} \\\\ x & =\\frac{4\\sqrt{3}}{2\\sqrt{3}} \\\\ x & =2\\end{aligned}\n$$\n\nSo, the side lengths are \n\n$$\n\\begin{aligned}BC & =\\sqrt{3}\\,x=\\sqrt{3}(2)=2\\sqrt{3}, \\\\ AB & =x+4=2+4=6.\\end{aligned}\n$$\n\nTherefore, the area of $△ABC$ is\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}\\cdot AB\\cdot BC \\\\  & =\\frac{1}{2}\\cdot 6\\cdot 2\\sqrt{3} \\\\  & =6\\sqrt{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186235582 :knowledge-point/_questions [{:db/id #edb/ref 17592186235285 :knowledge-point/id #uuid "58a49d00-cc58-5228-af38-9369cf31d8c8" :knowledge-point/title "Finding a Scalar Factor When Direction Reverses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ab5b44a-6f14-5d8c-b994-0ff723092bf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186234586} {:answer/id #uuid "2b5b4c72-e340-52b5-be53-6903f63361a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.5" :db/id #edb/ref 17592186234611} {:answer/id #uuid "cbe36434-9519-583f-9b69-c587e4937715" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186234866} {:answer/id #uuid "ce1ea7c1-61ca-56ba-a7d9-91573e3d6a5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186234869} {:answer/id #uuid "f46ca5b6-1fd3-597e-9657-e4197a5f9d69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186234933}] :answer-field/correct {:answer/id #uuid "1ab5b44a-6f14-5d8c-b994-0ff723092bf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186234586} :answer-field/id #uuid "1aa48e98-a238-5102-8717-85e261cb4e21" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186234997}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "adcdd06d-1586-51df-9df4-c005428c239d" :question/math-academy-id "q-77451" :question/problem "![](images/28/28faea3a553c505a8a5ab9bc7dd6e784dd23a47c336c70d31218fbe249d57cff.png)\n\nConsider the picture above. Given that $c=\\lambda a+3b,$ find $\\lambda .$" :question/worked-solution "To find $\\lambda ,$ we want to match the expression\n\n$$\nc=\\lambda a+3b.\n$$\n\nWe are given that one of the components is $3b.$ So, we first draw the vector $3b$ from the origin. Then we complete the path to the point $C.$\n\n![](images/52/52421034c2919620a0a9aae844db0eba2d396e5d6f1152d69bee40ff56c4d8ad.png)\n\nLet $P$ be the endpoint of the vector $3b.$ Then\n\n$$\nc=\\overset{\\to }{OP}+\\overset{\\to }{PC}.\n$$\n\nIn $△OPC,$ we have:\n\n- $PC=3|a|$\n\n- $\\overset{\\to }{PC}$ and $a$ have opposite directions\n\nHence, $\\overset{\\to }{PC}=-3a.$\n\nAdditionally,\n\n$$\n\\begin{aligned}c & =\\overset{\\to }{OP}+\\overset{\\to }{PC} \\\\  & =3b-3a.\\end{aligned}\n$$\n\nConsequently, $c=\\lambda a+3b=-3a+3b.$\n\nSince $a∦b,$ the linear combination can only be written in one way. Equating the coefficients of $a,$ we get:\n\n$$\n\\lambda =-3\n$$"}] [{:db/id #edb/ref 17592186393737 :knowledge-point/_questions [{:db/id #edb/ref 17592186115409 :knowledge-point/id #uuid "f7e817a0-edcf-54ca-ba4c-ffe91af04675" :knowledge-point/title "Finding a Height of a Triangle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5975ee7c-248f-52aa-92e6-7307c035348b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/38/389163fbb07fef4fc36fca5dce7cbe86cd4830d810b0210fe47c2b7cedd4b8c8.png" :db/id #edb/ref 17592186393739} {:answer/id #uuid "69276a71-4933-599e-b951-26b490c52cbe" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3e/3e2b6cde516dc1737124576ffdc212331e3ad74f728f47aece5911ed04cf7f5a.png" :db/id #edb/ref 17592186393740} {:answer/id #uuid "df0291cf-6864-5a2c-a3de-e53242dc7ff8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/77/7720d00d73ea3d4b4cf4905cf57ec12a3953caeb135272ec2d5283dad1479efe.png" :db/id #edb/ref 17592186393741} {:answer/id #uuid "5358c8ed-0c53-52b2-9dde-eca396e3f641" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c1/c1ecb1d567916c708cc6bbbd394517835e86b4105ae045cf5ef9490b181900fa.png" :db/id #edb/ref 17592186393742} {:answer/id #uuid "3896dd03-da28-567c-b00f-2916b9f8afe3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5f/5f4e50dfc88fdb9109961e2cef0dc0b1f7968d7b588e2f944450ac2969075bd7.png" :db/id #edb/ref 17592186393743}] :answer-field/correct {:answer/id #uuid "5975ee7c-248f-52aa-92e6-7307c035348b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/38/389163fbb07fef4fc36fca5dce7cbe86cd4830d810b0210fe47c2b7cedd4b8c8.png" :db/id #edb/ref 17592186393739} :answer-field/id #uuid "8715746d-70c4-5d7d-a61a-15d532009b48" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393738}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "813db841-ac50-5fa6-a6b6-270cab223353" :question/math-academy-id "q-77606" :question/problem "![](images/35/3507450dd4d81fb14269ec651cc3f93ef52d615797ac3e6f4f779a0df98debe2.png)\n\nGiven the triangle $△ABC$ shown above, which of the following diagrams represents the altitude  corresponding to $\\overset{―}{AB}?$" :question/worked-solution "The height (or altitude)  corresponding to $\\overset{―}{AB}$ is a line segment that \n\n- runs from the opposite vertex $C$ to the line $\\overset{⟷}{AB},$ and\n\n- is perpendicular to $\\overset{⟷}{AB}.$\n\nThe correct diagram is shown below:\n\n![](images/38/389163fbb07fef4fc36fca5dce7cbe86cd4830d810b0210fe47c2b7cedd4b8c8.png)"}] [{:db/id #edb/ref 17592186348060 :knowledge-point/_questions [{:db/id #edb/ref 17592186078618 :knowledge-point/id #uuid "c538b0a9-a084-5a83-a5fa-eca4e0270a93" :knowledge-point/title "Comparing an Exponential Function and a Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08f4dadb-28d5-582a-b2ed-8ed6faec0d17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{ln}⁡6}" :db/id #edb/ref 17592186345421} {:answer/id #uuid "0d8dfa95-d908-5058-8424-56e86a5e56fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e}{\\operatorname{ln}⁡6}" :db/id #edb/ref 17592186345459} {:answer/id #uuid "1064f00d-bc7f-5c7a-b35a-043241be2aef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186345491} {:answer/id #uuid "89f10bff-844a-5272-bf2d-066f640d14c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{2}}{\\operatorname{ln}⁡6}" :db/id #edb/ref 17592186346550} {:answer/id #uuid "dd3cacc9-07ac-5e10-a702-e49578e0954d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186347292}] :answer-field/correct {:answer/id #uuid "dd3cacc9-07ac-5e10-a702-e49578e0954d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186347292} :answer-field/id #uuid "5ea8fd09-6e18-5c7d-9352-b57872f05fa2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347771}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7c3a8a5e-9f27-59d8-ab5a-abb566b24c3e" :question/math-academy-id "q-78030" :question/problem "Evaluate ${lim}_{x\\to \\infty }\\frac{{e}^{2x}}{\\operatorname{ln}⁡(6x)}.$" :question/worked-solution "Both the numerator and denominator approach $\\infty $ as $x\\to \\infty .$ However, since ${e}^{2x}≫\\operatorname{ln}⁡(6x)$ for large values of $x,$ the numerator is growing much faster than the denominator. Consequently, we conclude that\n\n$$\n{lim}_{x\\to \\infty }\\frac{{e}^{2x}}{\\operatorname{ln}⁡(6x)}=\\infty .\n$$"}] [{:db/id #edb/ref 17592186348063 :knowledge-point/_questions [{:db/id #edb/ref 17592186087694 :knowledge-point/id #uuid "34fd903a-fa34-57b0-a098-08fa1cbd4f95" :knowledge-point/title "Determining the Dimensions of a Matrix with One Row or Column"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "084d51f3-27f2-5017-9b38-8362f1786e68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0\\times 4" :db/id #edb/ref 17592186345418} {:answer/id #uuid "1f19011d-f9d7-51a2-b47b-062470e495ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\times 0" :db/id #edb/ref 17592186345624} {:answer/id #uuid "7b5ee179-ea1e-5b7b-8108-6d7ffb3f3335" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\times 1" :db/id #edb/ref 17592186346429} {:answer/id #uuid "7f7b8f9f-5bd0-5fbb-946c-210bcc263174" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\times 4" :db/id #edb/ref 17592186346469} {:answer/id #uuid "ddc997d2-fa6c-5774-9ee3-84c1a35725c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\times 7" :db/id #edb/ref 17592186347300}] :answer-field/correct {:answer/id #uuid "7f7b8f9f-5bd0-5fbb-946c-210bcc263174" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\times 4" :db/id #edb/ref 17592186346469} :answer-field/id #uuid "48ba6808-50d1-57d5-9c23-1cf6910fb334" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347727}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d16d6d10-2374-5a1c-9c0b-fb79f9319483" :question/math-academy-id "q-7809" :question/problem "What are the dimensions of the matrix $F$, where $F=[\\begin{aligned}3 & 5 & 2 & 7\\end{aligned}]?$" :question/worked-solution "The matrix $F$ has $1$ row and $4$ columns.  Hence,  its dimensions are  $1\\times 4.$"}] [{:db/id #edb/ref 17592186348066 :knowledge-point/_questions [{:db/id #edb/ref 17592186068695 :knowledge-point/id #uuid "6cd6c125-ecaf-5847-a802-ec1b3594a15c" :knowledge-point/title "Determining Whether a Function Is Continuous at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01aeaace-3dee-5861-928d-6a23090d00f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186345366} {:answer/id #uuid "01c007c5-b958-5f05-bcdb-d16eb849a4b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186345367} {:answer/id #uuid "02100b32-fbcc-582d-903e-bf23af1e8c8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186345368} {:answer/id #uuid "c5a6767c-d2f1-526e-934e-fbbf34e09777" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186347068} {:answer/id #uuid "f40cbba4-ff28-567c-bde7-f1a1ff700f2d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186347512}] :answer-field/correct {:answer/id #uuid "f40cbba4-ff28-567c-bde7-f1a1ff700f2d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186347512} :answer-field/id #uuid "01de2c48-cbc5-5a34-8784-842c895031e0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347609}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5c2c6cc4-6d0f-5ca4-bd69-989208f699b4" :question/math-academy-id "q-78132" :question/problem "![](images/89/890e7eaf519a65ca19d4a90b604e7d7a8ab7054635296c4b08f000546f23b545.png)\n\nThe curve $y=f(x)$ is shown above. At which of the following points is $f(x)$ continuous?\n\n- $x=-2$\n- $x=1$\n- $x=3$" :question/worked-solution "Let's consider each point separately.\n\n- The function $f(x)$ is continuous at $-2.$ The graph can be drawn in the neighborhood of $x=-2$ without taking our pencil off of the paper.\n\n- The function $f(x)$ is not continuous at $x=1.$ Since there is a jump at $x=1,$ it is impossible to draw the function in the neighborhood of $x=1$ without taking our pencil off of the paper.\n\n- Therefore, the function $f(x)$ is continuous $x=3.$ The graph can be drawn in the neighborhood of  $x=3$ without taking our pencil off of the paper.\n\nHence, the correct answer is  \"I and III only\".\n\n![](images/7c/7c96c401ddae0049859fd5608cb08c6ce9ae8a2e6c3db69d7d4b379b3824094e.png)"}] [{:db/id #edb/ref 17592186348077 :knowledge-point/_questions [{:db/id #edb/ref 17592186083206 :knowledge-point/id #uuid "345d6df7-2ada-5c2e-8146-7c779afae3af" :knowledge-point/title "Finding the Center of a Vertical Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41d6c920-989f-5ce5-a8d5-c2abc399051f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,3)" :db/id #edb/ref 17592186345915} {:answer/id #uuid "5b65b5d5-07d7-5975-9ee4-291d6b399353" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-2)" :db/id #edb/ref 17592186346130} {:answer/id #uuid "9e973f9e-81b5-5854-88b0-98066c9a699d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6,9)" :db/id #edb/ref 17592186346735} {:answer/id #uuid "b2220b9a-c972-5a58-a399-44ce9b253549" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,-3)" :db/id #edb/ref 17592186346905} {:answer/id #uuid "fbfc5434-346a-59f7-b3db-0e599e3994ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,6)" :db/id #edb/ref 17592186347572}] :answer-field/correct {:answer/id #uuid "41d6c920-989f-5ce5-a8d5-c2abc399051f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,3)" :db/id #edb/ref 17592186345915} :answer-field/id #uuid "13539e3e-82b2-55bb-b37b-e5e32ff876f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347641}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8280a162-8b28-5252-92be-7c19e3ebbf0c" :question/math-academy-id "q-78379" :question/problem "What is the center of the hyperbola \n$-3{x}^{2}+2{y}^{2}+12x-12y=12?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}-3{x}^{2}+2{y}^{2}+12x-12y & =12 \\\\ 2{y}^{2}-12y-3{x}^{2}+12x & =12 \\\\ 2[{y}^{2}-6y]-3[{x}^{2}-4x] & =12 \\\\ 2[(y-3)^{2}-9]-3[(x-2)^{2}-4] & =12 \\\\ 2(y-3)^{2}-18-3(x-2)^{2}+12 & =12 \\\\ 2(y-3)^{2}-3(x-2)^{2} & =12+18-12 \\\\ 2(y-3)^{2}-3(x-2)^{2} & =18 \\\\ \\frac{(y-3)^{2}}{9}-\\frac{(x-2)^{2}}{6} & =1.\\end{aligned}\n$$\n\nHence, the center is $(2,3).$"}] [{:db/id #edb/ref 17592186348118 :knowledge-point/_questions [{:db/id #edb/ref 17592186083299 :knowledge-point/id #uuid "223e29c9-1bb5-51ee-9ec8-4d5c15363951" :knowledge-point/title "Finding the Center of a Horizontal Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0703d799-0111-55e4-99f9-70c3eb59a8b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,-1)" :db/id #edb/ref 17592186345414} {:answer/id #uuid "40758a02-7b8c-5d72-ab58-a8d20d28afdf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,-5)" :db/id #edb/ref 17592186345905} {:answer/id #uuid "63992de9-ec6d-51ab-a206-cde915c80422" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,2)" :db/id #edb/ref 17592186346218} {:answer/id #uuid "9eb31ca7-c07d-505f-bbbb-56822f2e4ae5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,1)" :db/id #edb/ref 17592186346736} {:answer/id #uuid "f59b0784-1475-5ee1-bbd4-044ae1258144" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-5,1)" :db/id #edb/ref 17592186347528}] :answer-field/correct {:answer/id #uuid "0703d799-0111-55e4-99f9-70c3eb59a8b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,-1)" :db/id #edb/ref 17592186345414} :answer-field/id #uuid "2f2ac7a2-8856-589e-8887-844636305c61" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347683}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "209d3fb4-3f5a-5f61-958c-85386d790787" :question/math-academy-id "q-78871" :question/problem "What is the center of the hyperbola \n$2{x}^{2}-{y}^{2}-20x-2y=-47?$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}2{x}^{2}-{y}^{2}-20x-2y & =-47 \\\\ 2{x}^{2}-20x-{y}^{2}-2y & =-47 \\\\ 2[{x}^{2}-10x]-[{y}^{2}+2y] & =-47 \\\\ 2[(x-5)^{2}-25]-[(y+1)^{2}-1] & =-47 \\\\ 2(x-5)^{2}-50-(y+1)^{2}+1 & =-47 \\\\ 2(x-5)^{2}-(y+1)^{2} & =-47+50-1 \\\\ 2(x-5)^{2}-(y+1)^{2} & =2 \\\\ (x-5)^{2}-\\frac{(y+1)^{2}}{2} & =1.\\end{aligned}\n$$\n\nTherefore, the center is $(5,-1).$"}] [{:db/id #edb/ref 17592186348133 :knowledge-point/_questions [{:db/id #edb/ref 17592186068788 :knowledge-point/id #uuid "16dac5bd-acbd-51c6-8636-172e3a55aaf1" :knowledge-point/title "Finding the Second Derivative of a Parametric Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02ad9106-6449-5425-9ea8-8c4d982508a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡(2t)" :db/id #edb/ref 17592186345373} {:answer/id #uuid "45dc42bc-9e4d-55b0-9f61-b8cbcec2623e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{sec}^{2}⁡(2t)" :db/id #edb/ref 17592186345960} {:answer/id #uuid "a4b9b883-5db0-5670-b24b-baadb64f5beb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{sec}^{3}⁡(2t)" :db/id #edb/ref 17592186346787} {:answer/id #uuid "bc4fe63e-62d3-5e7b-87ef-17e62dfe7c2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{sec}⁡(2t)" :db/id #edb/ref 17592186346988} {:answer/id #uuid "e4746b2e-d4c3-51e0-b47c-2a5f28dfd1f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{sec}^{2}⁡(t)" :db/id #edb/ref 17592186347363}] :answer-field/correct {:answer/id #uuid "a4b9b883-5db0-5670-b24b-baadb64f5beb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{sec}^{3}⁡(2t)" :db/id #edb/ref 17592186346787} :answer-field/id #uuid "3bbb2f12-0ff8-5ad2-898f-75f1bc5be3b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347704}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "858cfde7-5900-59e1-9b39-5d78acc22281" :question/math-academy-id "q-78950" :question/problem "A curve is defined by the parametric equations $x=\\operatorname{sin}⁡(2t),\\,y=\\operatorname{cos}⁡(2t)-3.$ Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}.$" :question/worked-solution "To find the first derivative, we will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=2\\operatorname{cos}⁡(2t),\\,{y}^{′}(t)=-2\\operatorname{sin}⁡(2t).\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=-\\frac{2\\operatorname{sin}⁡(2t)}{2\\operatorname{cos}⁡(2t)}=-\\operatorname{tan}⁡(2t).\n$$\n\nTo compute the second derivative, we can use the formula\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(\\frac{dy}{dx})}{(\\frac{dx}{dt})}.\\end{aligned}\n$$\n\nSubstituting into the formula, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(-\\operatorname{tan}⁡(2t))}{2\\operatorname{cos}⁡(2t)} \\\\  & =-\\frac{2{sec}^{2}⁡(2t)}{2\\operatorname{cos}⁡(2t)} \\\\  & =-{sec}^{3}⁡(2t).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348135 :knowledge-point/_questions [{:db/id #edb/ref 17592186068778 :knowledge-point/id #uuid "8fb50541-88df-5f3f-b9e0-cf51edae401e" :knowledge-point/title "Calculating the Derivative of a Parametric Curve at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bbf0b70-eb73-5737-870e-2b2a733a604d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186345593} {:answer/id #uuid "22ea9738-c711-5104-a068-657f18af36ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14}{3}" :db/id #edb/ref 17592186345664} {:answer/id #uuid "58320d87-d5f1-5831-b7ba-1fc8e51312dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186346104} {:answer/id #uuid "7d80556e-d68c-5841-8c9b-4fac2591689a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186346449} {:answer/id #uuid "de267612-3488-5cfc-bf84-8951e79d0127" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186347305}] :answer-field/correct {:answer/id #uuid "7d80556e-d68c-5841-8c9b-4fac2591689a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186346449} :answer-field/id #uuid "eb795487-a850-5ed5-84bc-cdf04a7dfdc5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186348020}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2921b965-ad16-58ab-8156-5829abb484a7" :question/math-academy-id "q-78954" :question/problem "A curve has parametric equations $x=\\frac{{t}^{5}}{5}-2,\\,y={t}^{7}+2.$ Given that $\\frac{\\text{d}y}{\\text{d}x}=7{t}^{2},$ calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ at the point where $t=2.$" :question/worked-solution "To compute $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}},$ we can use the formula\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(\\frac{dy}{dx})}{(\\frac{dx}{dt})}.\\end{aligned}\n$$\n\nWe're given that $\\frac{dy}{dx}=7{t}^{2},$ and we can calculate $\\frac{dx}{dt}$ as follows:\n\n$$\n\\frac{dx}{dt}=\\frac{d}{dt}(\\frac{{t}^{5}}{5}-2)={t}^{4}.\n$$\n\nSubstituting into the formula, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(7{t}^{2})}{{t}^{4}} \\\\  & =\\frac{14t}{{t}^{4}} \\\\  & =\\frac{14}{{t}^{3}}.\\end{aligned}\n$$\n\nFinally, we evaluate at $t=2,$ and we get\n\n$$\n{\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{t=2}=\\frac{14}{(2)^{3}}=\\frac{14}{8}=\\frac{7}{4}.\n$$"}] [{:db/id #edb/ref 17592186184844 :knowledge-point/_questions [{:db/id #edb/ref 17592186184148 :knowledge-point/id #uuid "dac9c72b-c23f-56fa-b939-6e3b56d3a13b" :knowledge-point/title "Identifying the Horizontal Stretch and Vertical Shift of a Transformed Cotangent Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aad4bfcf-ac83-5c47-928b-5b1a7fc0f104" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186183674} {:answer/id #uuid "df3e3991-8f50-5de8-b75b-5960efe17e47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186183675} {:answer/id #uuid "f2572169-df3d-5c99-975a-9f3f678ee3a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186183676} {:answer/id #uuid "f28c8896-b9fe-5342-9cba-cebeee74006f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186183677} {:answer/id #uuid "095c622d-5db2-5a48-942e-b312abb3f7c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186183678}] :answer-field/id #uuid "2d980f41-06e1-5562-995c-dd718d6a8c7a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186183673} {:answer-field/choices [{:answer/id #uuid "081bfb29-fde1-5481-b123-8eac743f086f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186399099} {:answer/id #uuid "51e08aac-9339-503c-9a66-b74268d4d2f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186399100} {:answer/id #uuid "03fedd1c-29b4-5722-b1e7-b3c046e5b66c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186399101} {:answer/id #uuid "a2ce8598-f6eb-5e70-b2e5-0d95b7a5f429" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186399102} {:answer/id #uuid "6704d952-af2f-5f8a-a722-c90281d08d85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186399103}] :answer-field/correct {:answer/id #uuid "03fedd1c-29b4-5722-b1e7-b3c046e5b66c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186399101} :answer-field/id #uuid "1848e56b-8e02-510d-9f75-0f28e4f3c082" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399098}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d92d6b12-34ec-5e74-a8fa-e75755bbf55a" :question/math-academy-id "q-79188" :question/problem "![](images/ae/ae6a514e0d9cde3db3c3b1dfa94e3804b5469dd5fb99b40a94684e88b573ec38.png)\n\nThe graph above shows the function $y=\\operatorname{cot}⁡(Bx)+D,$ where $B$ and $D$ are constants. What is $B+D?$" :question/worked-solution "The period $T$ of the function is\n\n$$\nT=\\frac{\\pi }{3}.\n$$\n\nThe formula for the period $T$ of the function $y=A\\operatorname{cot}⁡(Bx+C)+D$ is given by \n\n$$\nT=\\frac{\\pi }{B}.\n$$\n\nApplying the formula of the period, we get\n\n$$\n\\frac{\\pi }{3}=\\frac{\\pi }{B}\\,⟹\\,B=\\frac{\\pi }{(\\frac{\\pi }{3})}=3.\n$$\n\nThe parameter $D$ represents the vertical shift of the cotangent function. We see that the function has been translated by $3$ units up. Hence, $D=3.$\n\nTherefore, $B+D=3+3=6.$\n\nFinally, the equation of the curve is\n\n$$\ny=\\operatorname{cot}⁡(3x)+3.\n$$"}] [{:db/id #edb/ref 17592186348233 :knowledge-point/_questions [{:db/id #edb/ref 17592186179648 :knowledge-point/id #uuid "63080bb8-7a6a-505d-813a-e6c99d337064" :knowledge-point/title "Adding and Subtracting a Number and a Rational Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "004712b6-f610-5c1b-85fc-ea7f5dac42b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3a-2}{a}" :db/id #edb/ref 17592186345356} {:answer/id #uuid "1f9c9fb7-186e-5b20-a5ae-9968ec5bb0cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(a+1)}{a}" :db/id #edb/ref 17592186345629} {:answer/id #uuid "5f647f49-d7f6-51ed-a318-7ae05732cfa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(a+2)}{a}" :db/id #edb/ref 17592186346174} {:answer/id #uuid "6edfa3c8-26af-59e1-83da-3da4f171bbe1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3a+2}{a}" :db/id #edb/ref 17592186346319} {:answer/id #uuid "8714236f-9c2b-58c3-a954-b1f5b9039774" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2-3a}{a}" :db/id #edb/ref 17592186346522}] :answer-field/correct {:answer/id #uuid "6edfa3c8-26af-59e1-83da-3da4f171bbe1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3a+2}{a}" :db/id #edb/ref 17592186346319} :answer-field/id #uuid "c86f26bc-cd60-5415-a7c8-50d3d722dac4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347952}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "381e5b72-d586-538b-b748-3282ad434825" :question/math-academy-id "q-79545" :question/problem "Write $3+\\frac{2}{a}$ as a single fraction." :question/worked-solution "Using the fact that $3=\\frac{3}{1},$ we can write the expression as\n\n$$\n\\frac{3}{1}+\\frac{2}{a}.\n$$\n\n \n\nIn order to add the two fractions, we need them to have a common denominator. So, we put both fractions over a common denominator of $a$ by multiplying the top and bottom of the first fraction by $a:$\n\n$$\n\\begin{aligned}\\frac{3}{1}+\\frac{2}{a} & = \\\\ \\frac{a}{a}\\cdot \\frac{3}{1}+\\frac{2}{a} & = \\\\ \\frac{3a}{a}+\\frac{2}{a}\\end{aligned}\n$$\n\nFinally, we add the fractions and simplify the result:\n\n$$\n\\begin{aligned}\\frac{3a}{a}+\\frac{2}{a} & = \\\\ \\frac{3a+2}{a}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348234 :knowledge-point/_questions [{:db/id #edb/ref 17592186068754 :knowledge-point/id #uuid "fb2231aa-8afa-57df-a43c-cb3add25b2cc" :knowledge-point/title "Adding Rational Expressions in Multiple Variables With Common Factors in the Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17060fa7-3524-5310-9dfd-dc07b4e8832c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3t+k}{2(k+3t)}" :db/id #edb/ref 17592186345555} {:answer/id #uuid "8e08b27c-99f7-56ac-8b9f-96e0b8ceef2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3t+2k}{2(k+3t)}" :db/id #edb/ref 17592186346586} {:answer/id #uuid "aaae7946-dd0b-5491-a675-76007cd01c9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3t+k}{k+3t}" :db/id #edb/ref 17592186346842} {:answer/id #uuid "c3dcd984-a6b9-52d2-bddf-c9136d14c8a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3t-2k}{2(k+3t)}" :db/id #edb/ref 17592186347043} {:answer/id #uuid "ce330a49-fcee-5fd6-95ef-e1da5c0f2f22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3t+2k}{k+3t}" :db/id #edb/ref 17592186347158}] :answer-field/correct {:answer/id #uuid "8e08b27c-99f7-56ac-8b9f-96e0b8ceef2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3t+2k}{2(k+3t)}" :db/id #edb/ref 17592186346586} :answer-field/id #uuid "7650f596-e2e4-5bc7-be67-53414e53752a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347815}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e830cbad-9670-547b-94f1-5280434ab395" :question/math-academy-id "q-79551" :question/problem "Simplify $\\frac{3t}{2(k+3t)}+\\frac{k}{k+3t}.$" :question/worked-solution "In order to add the two fractions, we need them to have a common denominator. Here, we can put both fractions over a common denominator of $2(k+3t)$ if we multiply the top and bottom of the second fraction by $2:$\n\n$$\n\\begin{aligned}\\frac{3t}{2(k+3t)}+\\frac{k}{k+3t} & = \\\\ \\frac{3t}{2(k+3t)}+\\frac{2}{2}\\cdot \\frac{k}{k+3t} & = \\\\ \\frac{3t}{2(k+3t)}+\\frac{2k}{2(k+3t)} & = \\\\ \\frac{3t+2k}{2(k+3t)} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348327 :knowledge-point/_questions [{:db/id #edb/ref 17592186129142 :knowledge-point/id #uuid "5dce1c69-c79d-541a-b479-8fc127352c2a" :knowledge-point/title "Identifying the Graph of a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "218cb034-3e85-59b7-a903-56bfc598b9b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the given options is correct" :db/id #edb/ref 17592186345650} {:answer/id #uuid "5f26a8c0-2af0-5bee-a1cd-0bf2f5569905" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A" :db/id #edb/ref 17592186346172} {:answer/id #uuid "6db0d065-e8ef-5454-9cf2-b8d92a429fa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B" :db/id #edb/ref 17592186346309} {:answer/id #uuid "afcb4450-4ae6-54b7-b7e5-2a45c0d057a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C" :db/id #edb/ref 17592186346883} {:answer/id #uuid "c8fffe14-90a9-51ed-b231-0b2a4af2d1c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D" :db/id #edb/ref 17592186347102}] :answer-field/correct {:answer/id #uuid "c8fffe14-90a9-51ed-b231-0b2a4af2d1c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D" :db/id #edb/ref 17592186347102} :answer-field/id #uuid "5a7510d2-2b7e-5e14-bd9b-6604c31ce57e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347762}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "de44d5ab-abd2-5362-b1b7-cef838348808" :question/math-academy-id "q-80107" :question/problem "![](images/f1/f1f31073c260d8111cca3d5de1ec6db3e0f7f76a13c9a41a71b5512acd17f704.png)\n\nWhich of the diagrams above can be the graph of the polynomial $y=-{x}^{5}+4{x}^{2}-3?$" :question/worked-solution "Let's call $P(x)$ the given polynomial:\n\n$$\nP(x)=-{x}^{5}+4{x}^{2}-3\n$$\n\nThe degree $(n=5)$ is odd and the leading coefficient $({a}_{5}=-1)$ is negative. Therefore, the polynomial has the following end behavior:\n\n- $P(x)\\to \\infty $ as $x\\to -\\infty .$\n\n- $P(x)\\to -\\infty $ as $x\\to \\infty .$\n\nOnly the graph $D$ satisfies these conditions."}] [{:db/id #edb/ref 17592186348357 :knowledge-point/_questions [{:db/id #edb/ref 17592186129154 :knowledge-point/id #uuid "a66188f6-3228-59e9-9766-0f9bacbe8443" :knowledge-point/title "Identifying True Statements Regarding the Graph of a Given Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b75e759-23b9-5a00-8a2f-7c0ca516d97a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186345736} {:answer/id #uuid "910cdafc-67fc-587c-87f0-bdba48190064" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186346616} {:answer/id #uuid "b75eed07-3b22-5842-aac1-37ec3c1762bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186346950} {:answer/id #uuid "c106e615-06ca-5d4a-9046-a19b20c78b0a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186347019} {:answer/id #uuid "d48896a5-f655-5550-962f-afc68a851fd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186347213}] :answer-field/correct {:answer/id #uuid "910cdafc-67fc-587c-87f0-bdba48190064" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186346616} :answer-field/id #uuid "b0b44f15-bb40-5519-8a0c-c8353afc8e01" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347910}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9e0f13e6-ba4b-56eb-b269-f07bb6ae2732" :question/math-academy-id "q-80303" :question/problem "![](images/0a/0a7b19b50822235a2dcbfcdf74984735a1e26b2b775180b24bdc2bcbf24c588b.png)\n\nThe graph of a polynomial $p(x)$ is shown above. Which of the following statements are true?\n\n- $x=-2$ is a root of even multiplicity.\n- $x=1$ is **not** a simple root.\n- $x=1$ is a root of even multiplicity." :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is false. The root $x=-2$ has an odd multiplicity because at $x=-2$ the graph passes through the $x$-axis at this point.\n\n- Statement II is true. The root $x=1$ is not a simple root because the graph crosses the $x$-axis at that point, and the curve is tangent to the $x$-axis at that point.\n\n- Statement III is false. The root $x=1$ has an odd multiplicity because at $x=1$ the graph passes through the $x$-axis at this point.\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186348369 :knowledge-point/_questions [{:db/id #edb/ref 17592186129145 :knowledge-point/id #uuid "4fc09a0f-34d3-5ca9-9964-6cb00498bfa7" :knowledge-point/title "Identifying the Factored Polynomial Shown in a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "433015c8-b02a-5d3b-9bc4-7270edca0b40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{3}(x+1)(x-2)" :db/id #edb/ref 17592186345929} {:answer/id #uuid "444cadbf-3703-59f5-bad4-46404cc1a695" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{2}(x+1){(x-2)}^{2}" :db/id #edb/ref 17592186345940} {:answer/id #uuid "654ada61-08a2-5d34-998b-5c8db9d07e87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{3}(x+1){(x-2)}^{3}" :db/id #edb/ref 17592186346234} {:answer/id #uuid "6dbb7820-ea22-5b52-910b-269aa2f0dbbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{5}{(x+1)}^{2}(x-2)" :db/id #edb/ref 17592186346310} {:answer/id #uuid "f282e323-500b-5dcf-a254-2d713e281555" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x{(x+1)}^{2}(x-2)" :db/id #edb/ref 17592186347497}] :answer-field/correct {:answer/id #uuid "654ada61-08a2-5d34-998b-5c8db9d07e87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{3}(x+1){(x-2)}^{3}" :db/id #edb/ref 17592186346234} :answer-field/id #uuid "9d5873ca-3084-51bf-9b1d-3de807002492" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347880}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ad55c8cb-7248-5482-9f28-0afc365f8908" :question/math-academy-id "q-80348" :question/problem "![](images/8b/8b086759a25af7e464c0c8be78d36cd4d8458c5c25e7c84cb6ecb28b2d59e9df.png)\n\nWhich of the following could be the equation of the polynomial curve shown above?" :question/worked-solution "First, we notice that the function has precisely three distinct roots, $x=-1$, $x=0$ and $x=2.$\n\nBased on the graph, we can make the following conclusions about the multiplicities of the roots:\n\n- Since the graph is *not* tangent to the $x$-axis at $x=-1,$ this root is a simple root (the multiplicity equals $1$).\n\n- Since the graph passes through $x=0,$ this root has odd multiplicity, and since the graph is tangent to the $x$-axis at $x=0,$ the multiplicity must be greater than one.\n\n- Since the graph passes through $x=2,$ this root has odd multiplicity, and since the graph is tangent to the $x$-axis at $x=2,$ the multiplicity must be greater than one.\n\nFrom the given options, the only possible equation is $y={x}^{3}(x+1){(x-2)}^{3}.$"}] [{:db/id #edb/ref 17592186348371 :knowledge-point/_questions [{:db/id #edb/ref 17592186129145 :knowledge-point/id #uuid "4fc09a0f-34d3-5ca9-9964-6cb00498bfa7" :knowledge-point/title "Identifying the Factored Polynomial Shown in a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b68fad9-861a-5a5d-b8d5-ff1e2fa15ab7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x(x+2)^{7}(x-1)" :db/id #edb/ref 17592186346430} {:answer/id #uuid "8724b35c-787a-52ef-80ff-eaf99f6a667a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x(x+2)^{5}(x-1)^{2}" :db/id #edb/ref 17592186346523} {:answer/id #uuid "94213796-5be7-57ae-81b2-17ed395cf18a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x(x+2)^{3}(x-1)^{3}" :db/id #edb/ref 17592186346645} {:answer/id #uuid "b2ec07fb-d5b8-585e-82ea-e6c5d87d6e70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-{x}^{3}(x+2)^{5}(x-1)" :db/id #edb/ref 17592186346910} {:answer/id #uuid "b5c1df98-76d9-50de-b003-8111fdce77bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-{x}^{2}(x+2)(x-1)^{7}" :db/id #edb/ref 17592186346933}] :answer-field/correct {:answer/id #uuid "94213796-5be7-57ae-81b2-17ed395cf18a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x(x+2)^{3}(x-1)^{3}" :db/id #edb/ref 17592186346645} :answer-field/id #uuid "db472ae2-2f21-533d-93c0-3a75b3b10cf1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347991}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0154a31e-007f-558f-af24-913ca9813ba7" :question/math-academy-id "q-80352" :question/problem "![](images/19/1956e8c684cc03538877d3ec5d1e72d3d3f48b63341f7739b9a18962b080f1e3.png)\n\nWhich of the following could be the equation of the polynomial curve shown above?" :question/worked-solution "First, we notice that the function has precisely three distinct roots, $x=-2,x=0$ and $x=1.$\n\nBased on the graph, we can make the following conclusions about the multiplicities of the roots:\n\n- Since the graph passes through $x=-2,$ this root has odd multiplicity, and since the graph is tangent to the $x$-axis at $x=-2,$ the multiplicity must be greater than one.\n\n- Since the graph is *not* tangent to the $x$-axis at $x=0,$ this root is a simple root (the multiplicity equals $1$).\n\n- Since the graph passes through $x=1,$ this root has odd multiplicity, and since the graph is tangent to the $x$-axis at $x=1,$ the multiplicity must be greater than one.\n\nFrom the given options, the only possible equation is $y=-x(x+2)^{3}(x-1)^{3}.$"}] [{:db/id #edb/ref 17592186351284 :knowledge-point/_questions [{:db/id #edb/ref 17592186129302 :knowledge-point/id #uuid "503a2d0a-ba6c-5529-9f26-b83c769a26a2" :knowledge-point/title "Finding the Domain of a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07cf5972-f40e-5217-8db4-af4d714d0f29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,5)\\cup (5,\\infty )" :db/id #edb/ref 17592186348511} {:answer/id #uuid "4ff5e665-aaa0-5a32-9ee9-f1bfeace33e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-3)\\cup (-3,\\infty )" :db/id #edb/ref 17592186349171} {:answer/id #uuid "86623a7d-5813-5d35-94af-16d6fb07a0e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,\\frac{1}{5})\\cup (\\frac{1}{5},\\infty )" :db/id #edb/ref 17592186349673} {:answer/id #uuid "c3ecf398-d445-5f07-9e39-0e0872bbfc4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186350178} {:answer/id #uuid "e061e2c5-0620-5228-ad52-cedd9b116361" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-\\frac{1}{3})\\cup (-\\frac{1}{3},\\infty )" :db/id #edb/ref 17592186350417}] :answer-field/correct {:answer/id #uuid "86623a7d-5813-5d35-94af-16d6fb07a0e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,\\frac{1}{5})\\cup (\\frac{1}{5},\\infty )" :db/id #edb/ref 17592186349673} :answer-field/id #uuid "0a944731-6928-5c95-9932-5dd54d8c5f7b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350725}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f524ac1c-6637-5a2f-a68c-7f9c181d3393" :question/math-academy-id "q-81297" :question/problem "What is the domain of the function $f(x)=\\frac{3x+1}{5x-1}?$" :question/worked-solution "A reciprocal function is defined for all values of $x$ except for those that make the denominator zero. So, to find the domain, we must exclude all values of $x$ that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}5x-1 & =0 \\\\ 5x & =1 \\\\ x & =\\frac{1}{5}.\\end{aligned}\n$$\n\nTherefore, the domain is $x\\in (-\\infty ,\\frac{1}{5})\\cup (\\frac{1}{5},\\infty ).$"}] [{:db/id #edb/ref 17592186351285 :knowledge-point/_questions [{:db/id #edb/ref 17592186129303 :knowledge-point/id #uuid "bd0aa5fc-79de-525e-a688-a8a2d2fcf858" :knowledge-point/title "Solving for an Unknown Constant in a Transformed Reciprocal Function Given the Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f8d2777-c68c-5bac-b02b-e76ea7832227" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186348585} {:answer/id #uuid "4440720a-4b25-56ac-acfb-e35454aaf42f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186349068} {:answer/id #uuid "aa03c041-3060-57a7-9832-43fc7a4091d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186349958} {:answer/id #uuid "b607c09a-ead1-5f9f-8366-b91cefea5b3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186350056} {:answer/id #uuid "fe48bdf6-69b4-58e6-ab4b-56b33ca29990" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186350684}] :answer-field/correct {:answer/id #uuid "aa03c041-3060-57a7-9832-43fc7a4091d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186349958} :answer-field/id #uuid "96ab50f6-ff51-5cc2-a2e4-1ac35c1df983" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350965}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "69d362d8-5140-5de9-97ea-ddf053c6a1b5" :question/math-academy-id "q-81306" :question/problem "The domain of the function $f(x)=\\frac{3x-7}{kx-4}$ is $(-\\infty ,\\frac{4}{5})\\cup (\\frac{4}{5},\\infty ).$ What is the value of $k?$" :question/worked-solution "A reciprocal function is defined for all values of $x$ except for those that make the denominator zero. So, to find the domain, we must exclude all values that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}kx-4 & =0 \\\\ kx & =4 \\\\ x & =\\frac{4}{k}.\\end{aligned}\n$$\n\nSo, the point that must be excluded from the domain is $x=\\frac{4}{k}.$ \n\nOn the other hand, we can see that $x=\\frac{4}{5}$ is excluded from the domain. Equating this to $\\frac{4}{k},$ we get\n\n$$\n\\begin{aligned}\\frac{4}{k} & =\\frac{4}{5} \\\\ \\frac{1}{k} & =\\frac{1}{5} \\\\ k & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186129876 :knowledge-point/_questions [{:db/id #edb/ref 17592186129304 :knowledge-point/id #uuid "66d82fa3-d576-5c42-9dca-4e1b76473424" :knowledge-point/title "Finding the Range of a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e75273e-f9fe-5904-9b97-df326138bc4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186348572} {:answer/id #uuid "56bde1c1-ec8e-5414-abd3-cf3a35ed829d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,-1)\\cup (1,\\infty )" :db/id #edb/ref 17592186349240} {:answer/id #uuid "70ec2a49-c0cb-50b3-96d0-78c9ed276005" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,1)\\cup (1,\\infty )" :db/id #edb/ref 17592186349486} {:answer/id #uuid "710ec1a0-ca77-5baf-9aea-64447273a88e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,-6)\\cup (1,\\infty )" :db/id #edb/ref 17592186349487} {:answer/id #uuid "76603cce-9fe2-582e-98c8-b6b5dfe79841" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,6)\\cup (6,\\infty )" :db/id #edb/ref 17592186349534}] :answer-field/correct {:answer/id #uuid "70ec2a49-c0cb-50b3-96d0-78c9ed276005" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,1)\\cup (1,\\infty )" :db/id #edb/ref 17592186349486} :answer-field/id #uuid "2d01f1a9-302b-5e9b-a9b7-f275dfb86ddd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350788}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d6996c90-1b1f-5226-b63d-1aa92068c6b3" :question/math-academy-id "q-81416" :question/problem "What is the range of $f(x)=\\frac{1}{x-6}+1?$" :question/worked-solution "A transformed reciprocal function of the form\n\n$$\nf(x)=\\frac{a}{bx+c}+d\n$$\n\nhas the horizontal asymptote $y=d,$ and therefore, its range is\n\n$$\nf(x)\\in (-\\infty ,d)\\cup (d,\\infty ).\n$$\n\nIn our case, $d=1.$ Therefore, the horizontal asymptote is $y=1,$ and the range of the function is\n\n$$\nf(x)\\in (-\\infty ,1)\\cup (1,\\infty ).\n$$\n\nThe graph $y=f(x)$ is shown below.\n\n![](images/f6/f6b1316dd9c7f2a40c23de08dde63cbc6402593c6209d99384279a7c1ae29da6.png)"}] [{:db/id #edb/ref 17592186351320 :knowledge-point/_questions [{:db/id #edb/ref 17592186203962 :knowledge-point/id #uuid "37ff20d1-fa3d-50aa-90d1-7bcb848ee460" :knowledge-point/title "Maxima of Transformed Sine or Cosine Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "808a85c2-ca4a-542f-8886-908783750d8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{16}+n\\cdot \\frac{\\pi }{4}" :db/id #edb/ref 17592186349626} {:answer/id #uuid "8cd3458d-3fcd-5615-89ef-119fa3a75163" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{16}+n\\cdot \\frac{\\pi }{2}" :db/id #edb/ref 17592186349718} {:answer/id #uuid "99b11afc-eea4-51cc-90b6-2bcc44f1ccd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{2}+n\\pi " :db/id #edb/ref 17592186349822} {:answer/id #uuid "ec838bdb-4a1f-5b1a-b168-73687add9f3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{8}+n\\pi " :db/id #edb/ref 17592186350513} {:answer/id #uuid "f0d92b5e-622a-5e98-8d37-c85026582415" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{8}+n\\cdot \\frac{\\pi }{16}" :db/id #edb/ref 17592186350555}] :answer-field/correct {:answer/id #uuid "8cd3458d-3fcd-5615-89ef-119fa3a75163" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{16}+n\\cdot \\frac{\\pi }{2}" :db/id #edb/ref 17592186349718} :answer-field/id #uuid "e6fff443-d103-5115-9f6d-56a670c1f10e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351113}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8dc88ce5-1862-53d4-934e-e04fef66ce16" :question/math-academy-id "q-81532" :question/problem "Consider the function $f(x)=\\operatorname{sin}⁡(4x+\\frac{\\pi }{4}).$ Which expression gives all of the values of $x$ at which $f(x)$ attains its maximum value? Assume that $n$ is an integer." :question/worked-solution "First, let's start by defining a new variable $X$ as\n\n$$\nX=4x+\\frac{\\pi }{4}.\n$$\n\nSo, we need to calculate $X$-values at the maxima of\n\n$$\ny=\\operatorname{sin}⁡X.\n$$\n\n \n\nThe $X$-values at the maxima are given by the following expression:\n\n$$\nX=\\frac{\\pi }{2}+2n\\pi \n$$\n\nwhere $n$ is an integer.\n\nTo find the $x$-values at the maxima of our original function, we rewrite $X$ in terms of the original variable $x$ and solve the resulting equation for $x:$\n\n$$\n\\begin{aligned}X & =\\frac{\\pi }{2}+2n\\pi  \\\\ 4x+\\frac{\\pi }{4} & =\\frac{\\pi }{2}+2n\\pi  \\\\ 4x & =\\frac{\\pi }{4}+2n\\pi  \\\\ x & =\\frac{\\pi }{16}+n\\cdot \\frac{\\pi }{2}\\end{aligned}\n$$\n\nWe conclude that the values of $x$ that maximize $f(x)$ are given by $x=\\frac{\\pi }{16}+n\\cdot \\frac{\\pi }{2},$ where $n$ is an integer."}] [{:db/id #edb/ref 17592186351322 :knowledge-point/_questions [{:db/id #edb/ref 17592186203963 :knowledge-point/id #uuid "75e981a4-ba75-5db2-81ab-b321953cc225" :knowledge-point/title "Minima of Transformed Sine or Cosine Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a08b123-1007-51d0-9626-6957cea1cbdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{4\\pi }{3}+3\\pi n" :db/id #edb/ref 17592186348819} {:answer/id #uuid "57b185da-3c33-5e53-b896-4c58bbe65ab3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{15\\pi }{4}+6\\pi n" :db/id #edb/ref 17592186349253} {:answer/id #uuid "65cf0fb8-b80b-5dd5-873d-133d51e5ed5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pi +2\\pi n" :db/id #edb/ref 17592186349378} {:answer/id #uuid "d17b82e0-699f-5810-bbfd-d8426a2e29ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{4}+6\\pi n" :db/id #edb/ref 17592186350286} {:answer/id #uuid "e029609d-c698-570a-9c3e-6c5b9a4f3d4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pi +3\\pi n" :db/id #edb/ref 17592186350415}] :answer-field/correct {:answer/id #uuid "57b185da-3c33-5e53-b896-4c58bbe65ab3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{15\\pi }{4}+6\\pi n" :db/id #edb/ref 17592186349253} :answer-field/id #uuid "8380bcb3-1b34-51e5-86b8-2bf85dedf899" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350935}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c0891f6b-b8f3-59bf-bdab-23a45deeee45" :question/math-academy-id "q-81536" :question/problem "Consider the function $f(x)=\\operatorname{cos}⁡(\\frac{x}{3}-\\frac{\\pi }{4}).$ Which expression gives all of the values of $x$ at which $f(x)$ attains its minimum value? Assume that $n$ is an integer." :question/worked-solution "First, let's start by defining a new variable $X$ as\n\n$$\nX=\\frac{x}{3}-\\frac{\\pi }{4}.\n$$\n\nSo, we need to calculate $X$-values at the minima of\n\n$$\nf(x)=\\operatorname{cos}⁡X.\n$$\n\nThe $X$-values at the minima are given by the following expression:\n\n$$\nX=(2n+1)\\pi \n$$\n\nwhere $n$ is an integer.\n\nTo find the $x$-values at the minima of our original function, we rewrite $X$ in terms of the original variable $x$ and solve the resulting equation for $x:$\n\n$$\n\\begin{aligned}X & =(2n+1)\\pi  \\\\ \\frac{x}{3}-\\frac{\\pi }{4} & =\\pi +2\\pi n \\\\ \\frac{x}{3} & =\\frac{5\\pi }{4}+2\\pi n \\\\ x & =\\frac{15\\pi }{4}+6\\pi n\\end{aligned}\n$$\n\nWe conclude that the values of $x$ that minimize $f(x)$ are given by $x=\\frac{15\\pi }{4}+6\\pi n,$ where $n$ is an integer."}] [{:db/id #edb/ref 17592186351326 :knowledge-point/_questions [{:db/id #edb/ref 17592186129100 :knowledge-point/id #uuid "fabd8865-cc14-508a-aa81-4ba147f7f8d4" :knowledge-point/title "Finding a General Expression for the Zeros of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bdbc89b-3531-5aca-8ba9-f97488020ae6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}+6n\\pi " :db/id #edb/ref 17592186348987} {:answer/id #uuid "4113848c-c05d-566b-b1dc-5db84a4d0393" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}+3n\\pi " :db/id #edb/ref 17592186349038} {:answer/id #uuid "5d7a3fae-b9d5-5b5e-bd0f-dcd4106b4c3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{n\\pi }{6}" :db/id #edb/ref 17592186349305} {:answer/id #uuid "7bb5e873-76c9-58bf-8d7a-7e75030cf3fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}+\\frac{n\\pi }{6}" :db/id #edb/ref 17592186349581} {:answer/id #uuid "abfe1148-d014-58cf-9667-7f0d1e092c7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6n\\pi " :db/id #edb/ref 17592186349971}] :answer-field/correct {:answer/id #uuid "5d7a3fae-b9d5-5b5e-bd0f-dcd4106b4c3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{n\\pi }{6}" :db/id #edb/ref 17592186349305} :answer-field/id #uuid "6f6083aa-ab96-52a6-8f56-aa3dc31b367b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350896}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "57be2016-4f15-558e-8c73-c2bdbd52fe97" :question/math-academy-id "q-81546" :question/problem "Which of the following expressions gives all of the zeros of the function $f(x)=\\operatorname{cot}⁡(6x+\\frac{\\pi }{2})?$ Assume that $n$ is an integer." :question/worked-solution "The zeros of $y=\\operatorname{cot}⁡x$ are given by \n\n$$\nx=\\frac{\\pi }{2}+n\\pi ,\n$$\n\nwhere $n$ is an integer.\n\nTo find the zeros of $f(x)=\\operatorname{cot}⁡(6x+\\frac{\\pi }{2}),$ we replace the $x$ on the left-hand side of the above with $(6x+\\frac{\\pi }{2}).$ This gives\n\n$$\n6x+\\frac{\\pi }{2}=\\frac{\\pi }{2}+n\\pi .\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}6x+\\frac{\\pi }{2} & =\\frac{\\pi }{2}+n\\pi  \\\\ 6x & =n\\pi  \\\\ x & =\\frac{n\\pi }{6}.\\end{aligned}\n$$\n\nTherefore, we conclude that the zeros are $x=\\frac{n\\pi }{6},$ where $n$ is an integer."}] [{:db/id #edb/ref 17592186351332 :knowledge-point/_questions [{:db/id #edb/ref 17592186083154 :knowledge-point/id #uuid "a8dbb426-dd34-5686-bde9-3ef9d246b5e5" :knowledge-point/title "Finding the Range of a Transformed Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e3e445b-242f-5183-8134-e1a2873f586c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,-4]\\cup [4,\\infty )" :db/id #edb/ref 17592186348570} {:answer/id #uuid "29c5d455-ea88-583b-878a-5b2da6e2eca5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,3]\\cup [5,\\infty )" :db/id #edb/ref 17592186348815} {:answer/id #uuid "87848d38-9a7f-500f-8ee0-d03c8430c2a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,0]\\cup [4,\\infty )" :db/id #edb/ref 17592186349681} {:answer/id #uuid "c66561f4-bc83-5fd5-927f-843045ce31e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,-3]\\cup [5,\\infty )" :db/id #edb/ref 17592186350193} {:answer/id #uuid "c6d22d26-f36a-5676-9a92-d9439050a127" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,-5]\\cup [-3,\\infty )" :db/id #edb/ref 17592186350197}] :answer-field/correct {:answer/id #uuid "29c5d455-ea88-583b-878a-5b2da6e2eca5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,3]\\cup [5,\\infty )" :db/id #edb/ref 17592186348815} :answer-field/id #uuid "05d872cb-4071-5344-a1bc-bda53e5bcc36" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350715}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e7bdacc5-30cf-5786-b5bc-164c930bb79b" :question/math-academy-id "q-81567" :question/problem "Find the range of the function $f(x)=\\operatorname{sec}⁡(2x-1)+4.$" :question/worked-solution "The range of $\\operatorname{sec}⁡x$ consists of two intervals:\n\n$$\n\\operatorname{sec}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty )\n$$\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n\\operatorname{sec}⁡(2x-1)\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nWe can split this into two inequalities:\n\n$$\n\\operatorname{sec}⁡(2x-1)\\le -1,\\,\\operatorname{sec}⁡(2x-1)\\ge 1\n$$\n\nTo find the range of $f(x),$ we consider both intervals separately.\n\n- If we add $4$ to the first interval, we get\n\n$$\n\\begin{aligned} & \\operatorname{sec}⁡(2x-1)\\le -1 \\\\  & \\operatorname{sec}⁡(2x-1)+4\\le -1+4 \\\\  & \\operatorname{sec}⁡(2x-1)+4\\le 3 \\\\  & f(x)\\le 3.\\end{aligned}\n$$\n\n- If we add $4$ to the second interval, we get\n\n$$\n\\begin{aligned} & \\operatorname{sec}⁡(2x-1)\\ge 1 \\\\  & \\operatorname{sec}⁡(2x-1)+4\\ge 1+4 \\\\  & \\operatorname{sec}⁡(2x-1)+4\\ge 5 \\\\  & f(x)\\ge 5.\\end{aligned}\n$$\n\nCombining both inequalities, we get\n\n$$\nf(x)\\le 3,\\,f(x)\\ge 5.\n$$\n\nTherefore, we conclude that the range is $f(x)\\in (-\\infty ,3]\\cup [5,\\infty ).$"}] [{:db/id #edb/ref 17592186351333 :knowledge-point/_questions [{:db/id #edb/ref 17592186083154 :knowledge-point/id #uuid "a8dbb426-dd34-5686-bde9-3ef9d246b5e5" :knowledge-point/title "Finding the Range of a Transformed Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3beb2bf3-85a6-5351-8707-3d22b1ee479b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,-3]\\cup [2,\\infty )" :db/id #edb/ref 17592186348988} {:answer/id #uuid "7bcaac38-7ca5-5639-8065-5ed95845a2c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,1]\\cup [3,\\infty )" :db/id #edb/ref 17592186349583} {:answer/id #uuid "b9239d6e-0398-536e-96ea-926946d19cf4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,-3]\\cup [-1,\\infty )" :db/id #edb/ref 17592186350087} {:answer/id #uuid "f19cb4c0-bc6d-5293-af8d-6cb78b330c4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,0]\\cup [2,\\infty )" :db/id #edb/ref 17592186350559} {:answer/id #uuid "f665cb8d-c8b2-5193-ac92-977971e1d72e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,-2]\\cup [2,\\infty )" :db/id #edb/ref 17592186350603}] :answer-field/correct {:answer/id #uuid "f665cb8d-c8b2-5193-ac92-977971e1d72e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,-2]\\cup [2,\\infty )" :db/id #edb/ref 17592186350603} :answer-field/id #uuid "718ade24-34b7-5766-a493-7153cbbe8e60" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350903}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6209583e-a305-5e36-8803-ab5525f3111a" :question/math-academy-id "q-81568" :question/problem "Find the range of the function $f(x)=2\\operatorname{csc}⁡(4x+5).$" :question/worked-solution "The range of $\\operatorname{csc}⁡x$ consists of two intervals:\n\n$$\n\\operatorname{csc}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty )\n$$\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n\\operatorname{csc}⁡(4x+5)\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nWe can split this into two inequalities:\n\n$$\n\\operatorname{csc}⁡(4x+5)\\le -1,\\,\\operatorname{csc}⁡(4x+5)\\ge 1\n$$\n\nTo find the range of $f(x),$ we consider both intervals separately.\n\n- Multiplying the first interval by $2,$ we get\n\n$$\n\\begin{aligned} & \\operatorname{csc}⁡(4x+5)\\le -1 \\\\  & 2\\operatorname{csc}⁡(4x+5)\\le -2 \\\\  & f(x)\\le -2.\\end{aligned}\n$$\n\n- Multiplying the second interval by $2,$ we get\n\n$$\n\\begin{aligned} & \\operatorname{csc}⁡(4x+5)\\ge 1 \\\\  & 2\\operatorname{csc}⁡(4x+5)\\ge 2 \\\\  & f(x)\\ge 2.\\end{aligned}\n$$\n\nCombining both inequalities, we get\n\n$$\nf(x)\\le -2,\\,f(x)\\ge 2.\n$$\n\nTherefore, we conclude that the range is $f(x)\\in (-\\infty ,-2]\\cup [2,\\infty ).$"}] [{:db/id #edb/ref 17592186351335 :knowledge-point/_questions [{:db/id #edb/ref 17592186083153 :knowledge-point/id #uuid "2ec59516-4ba6-5e62-b26a-bad36ea4448f" :knowledge-point/title "Finding the Domain and Asymptotes of a Transformed Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e37e352-2ebd-519b-b752-f0f303d5c735" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne {60}^{∘}+n\\cdot {180}^{∘}" :db/id #edb/ref 17592186348712} {:answer/id #uuid "4d2d114b-f236-58ac-bb08-c56f9ad411f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne {60}^{∘}+n\\cdot {45}^{∘}" :db/id #edb/ref 17592186349151} {:answer/id #uuid "76d9e37c-df77-5f7d-b7e9-be9174f15aa9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne {60}^{∘}+n\\cdot {90}^{∘}" :db/id #edb/ref 17592186349539} {:answer/id #uuid "88cba209-3291-583a-9d5b-5e1a16336323" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne {120}^{∘}+n\\cdot {90}^{∘}" :db/id #edb/ref 17592186349689} {:answer/id #uuid "c32d5354-3148-51a9-aede-6809d8386c86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne {120}^{∘}+n\\cdot {180}^{∘}" :db/id #edb/ref 17592186350176}] :answer-field/correct {:answer/id #uuid "1e37e352-2ebd-519b-b752-f0f303d5c735" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne {60}^{∘}+n\\cdot {180}^{∘}" :db/id #edb/ref 17592186348712} :answer-field/id #uuid "1b4a398d-6bb6-535f-9a7e-aa4d0e416252" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350758}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c63c20b6-af06-5453-a6bf-493adf10c2a3" :question/math-academy-id "q-81581" :question/problem "What is the domain of the function $f(x)=\\operatorname{sec}⁡(x+{30}^{∘}),$ where $x$ is measured in degrees? Assume that $n$ is an integer." :question/worked-solution "The domain of $y=\\operatorname{sec}⁡x$ consists of all values where $\\operatorname{cos}⁡x\\ne 0,$ and is given by the expression\n\n$$\nx\\ne {90}^{∘}+n\\cdot {180}^{∘},\n$$\n\nwhere $n$ is an integer.\n\nTo find the domain of $\\operatorname{sec}⁡(x+{30}^{∘}),$ we replace the $x$ on the left-hand side of the above with $(x+{30}^{∘}).$ This gives\n\n$$\nx+{30}^{∘}\\ne {90}^{∘}+n\\cdot {180}^{∘}.\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}x+{30}^{∘} & \\ne {90}^{∘}+n\\cdot {180}^{∘} \\\\ x & \\ne {60}^{∘}+n\\cdot {180}^{∘}.\\end{aligned}\n$$\n\nTherefore, the domain of the function is $x\\ne {60}^{∘}+n\\cdot {180}^{∘},$ where $n$ is an integer."}] [{:db/id #edb/ref 17592186351386 :knowledge-point/_questions [{:db/id #edb/ref 17592186115208 :knowledge-point/id #uuid "2f6f4cfa-db03-5ae6-9f43-79fd3167c473" :knowledge-point/title "The Vertical Asymptote of a Transformed Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "379491ec-d15c-5213-ab37-21be3454aa2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-3" :db/id #edb/ref 17592186348948} {:answer/id #uuid "5675de99-d640-5a79-8625-1bf0d30b0cad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2" :db/id #edb/ref 17592186349237} {:answer/id #uuid "a4caf121-6c14-50f0-aeb3-fd2aed32744f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-2" :db/id #edb/ref 17592186349918} {:answer/id #uuid "f28f2ddb-3aaf-5065-ac5a-85f3f483c5ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=0" :db/id #edb/ref 17592186350574} {:answer/id #uuid "ff18f0bb-e463-5951-b0c4-3badeb9977f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=1" :db/id #edb/ref 17592186350691}] :answer-field/correct {:answer/id #uuid "5675de99-d640-5a79-8625-1bf0d30b0cad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2" :db/id #edb/ref 17592186349237} :answer-field/id #uuid "6545ad2b-c92a-5487-bc20-82c927dbe614" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350875}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e53bfbce-8b32-5854-943b-ffd612dcb153" :question/math-academy-id "q-81994" :question/problem "Find the equation of the vertical asymptote of the function $f(x)=-3\\operatorname{ln}⁡(4-2x)+6.$" :question/worked-solution "The equation of the vertical asymptote of the function $y=\\operatorname{ln}⁡x$ is $x=0.$\n\nTo find the equation of the vertical asymptote of $f(x),$ we set the argument of the logarithmic term equal to zero, and solve for $x.$ This gives\n\n$$\n\\begin{aligned}4-2x & =0 \\\\ -2x & =-4 \\\\ x & =2.\\end{aligned}\n$$\n\nTherefore, the equation of the vertical asymptote is $x=2.$"}] [{:db/id #edb/ref 17592186088402 :knowledge-point/_questions [{:db/id #edb/ref 17592186087730 :knowledge-point/id #uuid "cb2860c1-8ed6-5c0c-8f43-c1ba75225c02" :knowledge-point/title "Finding the Complex Conjugate of a Complex Number With Positive Imaginary Part"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0922c4b6-d25d-551a-9cb3-5200b81e3ea6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{z}=3+5\\text{i}" :db/id #edb/ref 17592186348522} {:answer/id #uuid "7e6579a7-a15a-511f-8185-1f0d53d6b68b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{z}=\\frac{1}{3+5\\text{i}}" :db/id #edb/ref 17592186349605} {:answer/id #uuid "9ce7bbc3-fac1-53f3-a1de-86a5cc73fcd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{z}=-3-5\\text{i}" :db/id #edb/ref 17592186349845} {:answer/id #uuid "b477f944-a4de-5199-ad13-36fc4346d627" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{z}=-3+5\\text{i}" :db/id #edb/ref 17592186350042} {:answer/id #uuid "b5672995-afd4-5eed-ad77-cd6033ca9a65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{z}=3-5\\text{i}" :db/id #edb/ref 17592186350052}] :answer-field/correct {:answer/id #uuid "b5672995-afd4-5eed-ad77-cd6033ca9a65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{z}=3-5\\text{i}" :db/id #edb/ref 17592186350052} :answer-field/id #uuid "1b1cebfd-d980-591f-bac4-9d01fdc80d24" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350757}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8be49ea4-410e-5bb3-9aa7-a4c55fff790b" :question/math-academy-id "q-8220" :question/problem "What is the complex conjugate of $z=3+5\\text{i}?$" :question/worked-solution "To find the complex conjugate, we flip the sign of the imaginary part.\n\nIn the given number $z=3+5\\text{i},$ the imaginary part is $5\\text{i}.$ Flipping the sign, we get $-5\\text{i}.$\n\nTherefore, the complex conjugate is given by $\\overset{―}{z}=3-5\\text{i}.$"}] [{:db/id #edb/ref 17592186351437 :knowledge-point/_questions [{:db/id #edb/ref 17592186087758 :knowledge-point/id #uuid "833ac63c-235b-5059-ab7c-56eb1e44d79e" :knowledge-point/title "Finding the Argument of a Complex Number in the Second Quadrant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bdc6138-01e7-5dca-90c2-ee5ef772f650" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.95" :db/id #edb/ref 17592186348685} {:answer/id #uuid "3a5f7895-83a7-5868-921c-57c50450ef1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.82" :db/id #edb/ref 17592186348975} {:answer/id #uuid "69962bbe-75b8-5ae4-99aa-4f7910f71965" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.11" :db/id #edb/ref 17592186349425} {:answer/id #uuid "7df6bfdf-a463-5e56-a7b0-8cc61b55f17f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.07" :db/id #edb/ref 17592186349601} {:answer/id #uuid "b60fe42a-6aaa-59ac-b35e-8ac4d19e26ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.66" :db/id #edb/ref 17592186350058}] :answer-field/correct {:answer/id #uuid "1bdc6138-01e7-5dca-90c2-ee5ef772f650" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.95" :db/id #edb/ref 17592186348685} :answer-field/id #uuid "4c0ed589-e9f7-57d6-8078-aa521972d708" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350836}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "61e93f3c-1103-58d6-a5e4-4e5649a9f688" :question/math-academy-id "q-8258" :question/problem "Find, in radians to two decimal places, the argument of $z=-2+5\\text{i}.$ \n\n**Hint**: The argument of a complex number is in the range $[0,2\\pi ).$" :question/requires-calculator true :question/worked-solution "Let's plot $z$ in the complex plane.\n\n![](images/fc/fc6a2568ba77ce043ae0d48840ed4707b3e629b8a52c4b5f182c1e23a249fa44.png)\n\nThe complex number $z$ lies in the second quadrant of the complex plane. Therefore $\\frac{\\pi }{2}<arg⁡(z)<\\pi .$ If $\\alpha $ is the angle that $z$ makes with the negative real axis, then\n\n$$\n\\begin{aligned}tan⁡\\alpha  & =\\frac{5}{2} \\\\ \\alpha  & =arctan⁡(\\frac{5}{2}) \\\\  & ≈1.190\\text{ }29\\end{aligned}\n$$\n\nrounded to $5$ decimal places.\n\nTherefore,\n\n$$\n\\theta =arg⁡(z)≈\\pi -1.190\\text{ }29≈1.95\n$$\n\nto two decimal places."}] [{:db/id #edb/ref 17592186354284 :knowledge-point/_questions [{:db/id #edb/ref 17592186087836 :knowledge-point/id #uuid "c249cf3a-7864-5132-80fa-c18a3ea915c2" :knowledge-point/title "Finding the Y-Intercepts of a Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "336d5b0b-46fb-592f-8727-3a06de946703" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-3)" :db/id #edb/ref 17592186352042} {:answer/id #uuid "82209c5f-513d-558a-80b5-81bcad912708" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,5)" :db/id #edb/ref 17592186352699} {:answer/id #uuid "da005a29-2e30-58a3-8eda-87359ad503f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\pm 3)" :db/id #edb/ref 17592186353459} {:answer/id #uuid "dfb5462e-f1c5-5814-83c4-35e425cabf84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\pm 5)" :db/id #edb/ref 17592186353512} {:answer/id #uuid "fe7b25f7-d0b9-528a-83fb-6c5aa038ad8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no $y$-intercepts" :db/id #edb/ref 17592186353798}] :answer-field/correct {:answer/id #uuid "82209c5f-513d-558a-80b5-81bcad912708" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,5)" :db/id #edb/ref 17592186352699} :answer-field/id #uuid "8f23fd7e-f0b2-5902-a559-b924fdec7db9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354072}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "40af28c7-87f4-525e-8058-edd168d8bbcf" :question/math-academy-id "q-84045" :question/problem "Calculate the $y$-intercepts of the hyperbola $\\frac{(x+3)^{2}}{9}-\\frac{(y-5)^{2}}{25}=1.$" :question/worked-solution "To find the $y$-intercepts of the hyperbola, we substitute $x=0$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}\\frac{(x+3)^{2}}{9}-\\frac{(y-5)^{2}}{25} & =1 \\\\ \\frac{(0+3)^{2}}{9}-\\frac{(y-5)^{2}}{25} & =1 \\\\ 1-\\frac{(y-5)^{2}}{25} & =1 \\\\ -\\frac{(y-5)^{2}}{25} & =0 \\\\ (y-5)^{2} & =0 \\\\ y-5 & =0 \\\\ y & =5\\end{aligned}\n$$\n\nTherefore, the $y$-intercept is $(0,5).$"}] [{:db/id #edb/ref 17592186088434 :knowledge-point/_questions [{:db/id #edb/ref 17592186087759 :knowledge-point/id #uuid "54588722-bb80-54ca-b100-03aca39e0c17" :knowledge-point/title "Finding the Argument of a Complex Number in the Fourth Quadrant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f1b0500-415f-5429-89d9-fbbb92a98ae2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.31" :db/id #edb/ref 17592186352546} {:answer/id #uuid "cd29b07a-70bf-5347-a5b0-93e51c59301b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.74" :db/id #edb/ref 17592186353348} {:answer/id #uuid "e36a586c-680f-580d-a120-8ca0ede7f5be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.22" :db/id #edb/ref 17592186353548} {:answer/id #uuid "ef8e504f-d2c6-5f83-8ce5-d298b778f10a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.23" :db/id #edb/ref 17592186353653} {:answer/id #uuid "fde2ebba-1cad-5211-b6e3-3a258bce156d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.66" :db/id #edb/ref 17592186353793}] :answer-field/correct {:answer/id #uuid "fde2ebba-1cad-5211-b6e3-3a258bce156d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.66" :db/id #edb/ref 17592186353793} :answer-field/id #uuid "4ee08007-7eba-5dcc-a203-e575bd3f6bdf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353951}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1eede2a0-b32f-5395-87d1-df0fef1f0013" :question/math-academy-id "q-8454" :question/problem "Find, in radians to two decimal places, the argument of $z=7-5\\text{i}.$ \n\n**Hint**: The argument of a complex number is in the range $[0,2\\pi ).$" :question/requires-calculator true :question/worked-solution "Let's plot $z$ in the complex plane.\n\n![](images/d0/d096d76118bc06b2d5c79d5017c0178d96fc84bff6f97d563b7b872d26e75d20.png)\n\nThe complex number $z$ lies in the fourth quadrant of the complex plane. Therefore $\\frac{3\\pi }{2}<arg⁡(z)<2\\pi .$ \n\nIf $\\alpha $ is the angle that $z$ makes with the positive real axis, then\n\n$$\n\\alpha =arctan⁡(\\frac{5}{7})≈0.620\\,25.\n$$\n\nTherefore,\n\n$$\n\\theta =arg⁡(z)=2\\pi -0.620\\,25≈5.66\n$$\n\nto two decimal places."}] [{:db/id #edb/ref 17592186354368 :knowledge-point/_questions [{:db/id #edb/ref 17592186083225 :knowledge-point/id #uuid "120f626e-dd00-537a-8948-d8f81850d696" :knowledge-point/title "Calculating the Number of Combinations of Objects Chosen From a Group Fewer Than Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "260ee64b-60f9-577f-b9cd-899af296d9b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "84" :db/id #edb/ref 17592186351917} {:answer/id #uuid "73b8b006-61f8-5c7a-906f-a83360295df8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186352580} {:answer/id #uuid "b91e1eea-f224-503d-85e7-b2faa41fc99d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186353149} {:answer/id #uuid "ca9be550-efdd-5dc5-80d3-353296eb9f18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "243" :db/id #edb/ref 17592186353327} {:answer/id #uuid "ef9b644a-cfec-5d4f-922b-5a3e24daabe5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186353654}] :answer-field/correct {:answer/id #uuid "260ee64b-60f9-577f-b9cd-899af296d9b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "84" :db/id #edb/ref 17592186351917} :answer-field/id #uuid "fcee7007-39c0-575f-87b4-92eaeeb2b54a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354257}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a9b3fff3-7ca8-5a05-bacf-2186c0ce6253" :question/math-academy-id "q-84956" :question/problem "A pizzeria has nine different toppings from which to choose. How many different pizzas can be made using only three toppings?" :question/worked-solution "The number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nThere are $9$ toppings, so $n=9.$ We want to select $3$ of those toppings for each of the pizzas, so we have $r=3.$\n\nTherefore, the number of different pizzas is\n\n$$\n\\begin{aligned}{}_{9}{C}_{3} & =\\frac{9!}{(9-3)!\\,3!} \\\\  & =\\frac{9!}{6!3!} \\\\  & =\\frac{9\\cdot 8\\cdot 7\\cdot \\cancel{6!}}{\\cancel{6!}3!} \\\\  & =\\frac{9\\cdot 8\\cdot 7}{3\\cdot 2\\cdot 1} \\\\  & =\\frac{504}{6} \\\\  & =84.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186354369 :knowledge-point/_questions [{:db/id #edb/ref 17592186083225 :knowledge-point/id #uuid "120f626e-dd00-537a-8948-d8f81850d696" :knowledge-point/title "Calculating the Number of Combinations of Objects Chosen From a Group Fewer Than Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1755d2b2-8ef2-5841-967a-37231874078e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "154" :db/id #edb/ref 17592186351776} {:answer/id #uuid "22aa46f6-d9f6-52a0-921d-e699a6fdabc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "82" :db/id #edb/ref 17592186351880} {:answer/id #uuid "aefddd11-ffea-5b50-af77-6441d3546955" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "102" :db/id #edb/ref 17592186353052} {:answer/id #uuid "d8ef2388-0f72-5871-b0be-8276cb5fe915" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186353453} {:answer/id #uuid "debdfcd2-ba10-5c33-a152-32714bf2926b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "126" :db/id #edb/ref 17592186353500}] :answer-field/correct {:answer/id #uuid "debdfcd2-ba10-5c33-a152-32714bf2926b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "126" :db/id #edb/ref 17592186353500} :answer-field/id #uuid "bb52f3bb-59b4-5a00-86e6-1550bcc92127" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354137}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "44e1ceb1-ad30-5708-98e7-b7ac9be19ae7" :question/math-academy-id "q-84959" :question/problem "Sara has a box of $9$ colored pencils. In how many ways can Sara pick a set of $4$ different pencils from the box?" :question/worked-solution "The number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nThere are $9$ pencils in the box, so $n=9.$ We want to select $4$ of those pencils, so we have $r=4.$\n\nTherefore, the number of different potential sets of four pencils is\n\n$$\n\\begin{aligned}{}_{9}{C}_{4} & =\\frac{9!}{(9-4)!\\,4!} \\\\  & =\\frac{9!}{5!4!} \\\\  & =\\frac{9\\cdot 8\\cdot 7\\cdot 6\\cdot \\cancel{5!}}{\\cancel{5!}4!} \\\\  & =\\frac{9\\cdot 8\\cdot 7\\cdot 6}{4\\cdot 3\\cdot 2\\cdot 1} \\\\  & =\\frac{3\\,024}{24} \\\\  & =126.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186354379 :knowledge-point/_questions [{:db/id #edb/ref 17592186083221 :knowledge-point/id #uuid "060e80f0-44bd-5378-9253-999548115dd9" :knowledge-point/title "Calculating the Number of Permutations of Objects Chosen From a Group Fewer Than Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "290f943b-3622-50d0-924f-31daf0acc563" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186351948} {:answer/id #uuid "77ef416e-a3b0-5473-bf35-8e1898c31847" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186352617} {:answer/id #uuid "7b5e835c-ce12-5b70-842e-5afce9455637" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186352642} {:answer/id #uuid "82456399-e756-555d-81e7-d2b347aafff7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186352701} {:answer/id #uuid "f32745fa-711d-5685-96d5-140a1218db12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186353692}] :answer-field/correct {:answer/id #uuid "82456399-e756-555d-81e7-d2b347aafff7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186352701} :answer-field/id #uuid "07f7e8b6-11ec-5218-9222-810bc50fc8fb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353831}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fda58513-e80c-5984-860c-d5cee3ac12ce" :question/math-academy-id "q-84980" :question/problem "How many made-up $3$-letter words can be made using only $5$ vowels, where each vowel cannot appear in the word more than once?" :question/worked-solution "The number of permutations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}.\n$$\n\nThere are $5$ vowels, so $n=5.$ We want to select $3$ of those vowels to make-up a $3$-letter word, so we have $r=3.$ \n\nTherefore, the number of different made-up words is \n\n$$\n\\begin{aligned}{}_{5}{P}_{3} & =\\frac{5!}{(5-3)!} \\\\  & =\\frac{5!}{2!} \\\\  & =\\frac{5\\cdot 4\\cdot 3\\cdot \\cancel{2!}}{\\cancel{2!}} \\\\  & =5\\cdot 4\\cdot 3 \\\\  & =60.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186394620 :knowledge-point/_questions [{:db/id #edb/ref 17592186083221 :knowledge-point/id #uuid "060e80f0-44bd-5378-9253-999548115dd9" :knowledge-point/title "Calculating the Number of Permutations of Objects Chosen From a Group Fewer Than Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aaed84db-333e-5211-84c5-2d24c1d90316" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,016" :db/id #edb/ref 17592186394622} {:answer/id #uuid "e1c1b16c-2ec4-5950-92f8-59f867978e1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,024" :db/id #edb/ref 17592186394623} {:answer/id #uuid "542940cc-ac17-5702-9c22-d185b7bb47c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186394624} {:answer/id #uuid "2e70f827-6004-57e0-825e-f0e45fc164d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,344" :db/id #edb/ref 17592186394625} {:answer/id #uuid "3d0a0e84-7492-5601-b7a4-02b8e70ea90d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15\\,120" :db/id #edb/ref 17592186394626}] :answer-field/correct {:answer/id #uuid "e1c1b16c-2ec4-5950-92f8-59f867978e1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,024" :db/id #edb/ref 17592186394623} :answer-field/id #uuid "72d9fa78-c6ea-5ff0-a6cb-0b7ec2cbcfc0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394621}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4ef67e9d-56e9-502f-9f38-dd41f4d01e7c" :question/math-academy-id "q-84983" :question/problem "A bag contains $9$ different colored marbles. Jamie takes $4$ marbles from the bag, one at a time, and puts them in the order they were taken from the bag to create a sequence of colors. How many different sequences of colors are possible?" :question/worked-solution "The number of permutations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}.\n$$\n\nThere are $9$ colored marbles, so $n=9.$ We want to select $4$ of those marbles to make a sequence of colors, so we have $r=4.$ \n\nTherefore, the number of different ways to choose the marbles is \n\n$$\n\\begin{aligned}{}_{9}{P}_{4} & =\\frac{9!}{(9-4)!} \\\\  & =\\frac{9!}{5!} \\\\  & =\\frac{9\\cdot 8\\cdot 7\\cdot 6\\cdot \\cancel{5!}}{\\cancel{5!}} \\\\  & =9\\cdot 8\\cdot 7\\cdot 6 \\\\  & =3\\,024.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186394627 :knowledge-point/_questions [{:db/id #edb/ref 17592186083312 :knowledge-point/id #uuid "b6b720d4-59b0-5d86-b856-ff69abfe4152" :knowledge-point/title "Evaluating Combinations Given Using Alternate Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43fa39e5-ce50-500d-851f-de9eb3b12eda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19\\,380" :db/id #edb/ref 17592186394629} {:answer/id #uuid "b8e55eef-a2a6-5dcc-8dbd-442ffb6f3b06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,480" :db/id #edb/ref 17592186394630} {:answer/id #uuid "24b6f013-8ec7-5811-963d-26ce3311756c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,860" :db/id #edb/ref 17592186394631} {:answer/id #uuid "cde0fe8a-36a8-5e30-8de3-aa6250e1a52c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\,280" :db/id #edb/ref 17592186394632} {:answer/id #uuid "f9dca18c-0cda-53f2-ae56-98a74295c88b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,845" :db/id #edb/ref 17592186394633}] :answer-field/correct {:answer/id #uuid "f9dca18c-0cda-53f2-ae56-98a74295c88b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,845" :db/id #edb/ref 17592186394633} :answer-field/id #uuid "ee128c64-8462-52f2-aa05-6a02c9deb300" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394628}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ccb665c6-b272-5591-95cb-e38be54fe76e" :question/math-academy-id "q-85044" :question/problem "Evaluate $(\\begin{aligned}20 \\\\ 16\\end{aligned}).$" :question/worked-solution "First, note that $(\\frac{20}{16})$ means the same thing as ${}_{20}{C}_{16}.$\n\n In general, the number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nSubstituting $n=20$ and $r=16,$ we get\n\n$$\n\\begin{aligned}{}_{20}{C}_{16} & =\\frac{20!}{(20-16)!16!} \\\\  & =\\frac{20!}{4!16!} \\\\  & =\\frac{20\\cdot 19\\cdot 18\\cdot 17\\cdot \\cancel{16!}}{4!\\cancel{16!}} \\\\  & =\\frac{20\\cdot 19\\cdot 18\\cdot 17}{4\\cdot 3\\cdot 2\\cdot 1} \\\\  & =\\frac{116\\,280}{24} \\\\  & =4\\,845.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186394634 :knowledge-point/_questions [{:db/id #edb/ref 17592186083311 :knowledge-point/id #uuid "e9c145aa-bcbf-54bd-ba88-93f10aeb00f0" :knowledge-point/title "Calculating a Permutation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bcef49e9-f6e2-5903-88c5-5668ea726fad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,652" :db/id #edb/ref 17592186394636} {:answer/id #uuid "00becd7c-07c7-51a1-8d01-c22ee90258d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,326" :db/id #edb/ref 17592186394637} {:answer/id #uuid "5dbc2ffb-e921-5ab1-a79b-de22cae70506" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,248" :db/id #edb/ref 17592186394638} {:answer/id #uuid "f4f8eb3e-2322-5192-b908-a3996052fac4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,304" :db/id #edb/ref 17592186394639} {:answer/id #uuid "043e4ba5-d6b6-52c1-acd4-3439e275df92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,225" :db/id #edb/ref 17592186394640}] :answer-field/correct {:answer/id #uuid "bcef49e9-f6e2-5903-88c5-5668ea726fad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,652" :db/id #edb/ref 17592186394636} :answer-field/id #uuid "66c1eba9-fa9c-5dcd-af76-d9dc0545ee45" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394635}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b6727864-63ba-5449-a9b7-0dc7ad66d6bd" :question/math-academy-id "q-85046" :question/problem "${}_{52}{P}_{2}=$" :question/worked-solution "The formula for ${}_{n}{P}_{r}$ is given by\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}\\,.\n$$\n\nSubstituting $n=52$ and $r=2$ into the above, we get\n\n$$\n\\begin{aligned}{}_{52}{P}_{2} & =\\frac{52!}{(52-2)!} \\\\  & =\\frac{52!}{50!} \\\\  & =\\frac{52\\cdot 51\\cdot \\cancel{50!}}{\\cancel{50!}} \\\\  & =52\\cdot 51 \\\\  & =2\\,652.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186394641 :knowledge-point/_questions [{:db/id #edb/ref 17592186083223 :knowledge-point/id #uuid "e7c35604-c9f9-5077-bddc-fe9446ac45e6" :knowledge-point/title "Calculating a Permutation Given Using Alternate Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9972d5bf-226c-5e87-988b-2fa3e0b4fbd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186394643} {:answer/id #uuid "82c57328-7703-57d6-912b-2ecb7333260d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,040" :db/id #edb/ref 17592186394644} {:answer/id #uuid "57d5dc3c-cc5e-57df-b81a-64cfa2b4c5cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186394645} {:answer/id #uuid "7dc1825b-3805-54c0-b2fd-b20b91c26d42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "720" :db/id #edb/ref 17592186394646} {:answer/id #uuid "4c2571b5-b785-5912-b9bf-d0e4a3fa1a43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49" :db/id #edb/ref 17592186394647}] :answer-field/correct {:answer/id #uuid "82c57328-7703-57d6-912b-2ecb7333260d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,040" :db/id #edb/ref 17592186394644} :answer-field/id #uuid "ff3b3c1d-8754-5e1f-a814-29025fd4b1b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394642}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b1198cf2-96b8-5b7c-bdc4-b79e3231eb29" :question/math-academy-id "q-85049" :question/problem "$P(7,7)=$" :question/worked-solution "The formula for ${}_{n}{P}_{r}$ is given by\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}\\,.\n$$\n\n$P(7,7)$ means the same thing as ${}_{7}{P}_{7}.$ Using the usual formula for ${}_{n}{P}_{r},$ we get\n\n$$\n\\begin{aligned}P(7,7) & =\\frac{7!}{(7-7)!} \\\\  & =\\frac{7!}{0!} \\\\  & =\\frac{7\\cdot 6\\cdot 5\\cdot 4\\cdot 3\\cdot 2\\cdot 1}{1} \\\\  & =5\\,040.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186404315 :knowledge-point/_questions [{:db/id #edb/ref 17592186129082 :knowledge-point/id #uuid "98d6004a-547a-5b0b-9748-9571cc3ee632" :knowledge-point/title "Computing a Tangent or Cotangent Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06cba355-0ee9-5493-b5b4-b01907ba7853" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cot⁡\\theta =\\frac{2\\sqrt{3}}{9}" :db/id #edb/ref 17592186404317} {:answer/id #uuid "88bc01f1-e620-5d5f-b135-3c829509a914" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cot⁡\\theta =-\\frac{\\sqrt{5}}{7}" :db/id #edb/ref 17592186404318} {:answer/id #uuid "c44c5852-2bff-553c-b41d-6c60dda93e43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cot⁡\\theta =-\\frac{\\sqrt{5}}{3}" :db/id #edb/ref 17592186404319} {:answer/id #uuid "e6647b56-89a1-5a81-85bf-14ccfa47147b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cot⁡\\theta =-\\frac{2\\sqrt{5}}{15}" :db/id #edb/ref 17592186404320} {:answer/id #uuid "814df066-a51f-5318-8a89-ed554769eecb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cot⁡\\theta =\\frac{2}{5}" :db/id #edb/ref 17592186404321}] :answer-field/correct {:answer/id #uuid "e6647b56-89a1-5a81-85bf-14ccfa47147b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cot⁡\\theta =-\\frac{2\\sqrt{5}}{15}" :db/id #edb/ref 17592186404320} :answer-field/id #uuid "9151fede-a06c-511f-acdd-16c15e3d7d4c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404316}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "37e87bc7-80c8-5654-8c99-e96b9d9f6c6d" :question/math-academy-id "q-85640" :question/problem "![](images/97/97c98411b3455c78c9e061cf54fa76eabfccc369e9e364a5366eb58bd5d2935d.png)\n\nThe diagram above shows the unit circle. Given that $cos⁡\\theta =\\frac{2}{7},$ what is the value of $cot⁡\\theta ?$" :question/worked-solution "![](images/8c/8c7889d63cf5894236bc5f5e24feb64ecf5a47acb2c07c807a4e65458a991232.png)\n\nWe can use the Pythagorean identity to find $sin⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ sin⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $cos⁡\\theta =\\frac{2}{7}$ gives\n\n$$\n\\begin{aligned}sin⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{2}{7})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{4}{49}} \\\\  & =\\pm \\sqrt{\\frac{45}{49}} \\\\  & =\\pm \\frac{3\\sqrt{5}}{7}.\\end{aligned}\n$$\n\nWe select the negative answer since $sin⁡\\theta $ is negative in the fourth quadrant. So, $sin⁡\\theta =-\\frac{3\\sqrt{5}}{7}.$\n\nFinally, knowing that $cot⁡\\theta =\\frac{cos⁡\\theta }{sin⁡\\theta },$ we have\n\n$$\ncot⁡\\theta =\\frac{(\\frac{2}{7})}{(-\\frac{3\\sqrt{5}}{7})}=-\\frac{2}{3\\sqrt{5}}=-\\frac{2\\sqrt{5}}{15}.\n$$"}] [{:db/id #edb/ref 17592186404322 :knowledge-point/_questions [{:db/id #edb/ref 17592186129083 :knowledge-point/id #uuid "55a09362-632a-56c4-b246-903e18fc77ee" :knowledge-point/title "Computing a Reciprocal Trigonometric Ratio Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6bce3c75-6a0d-53d7-9a0d-6b6d8acd31bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sec⁡\\theta =-\\frac{7\\sqrt{6}}{12}" :db/id #edb/ref 17592186404324} {:answer/id #uuid "2613efdb-cd4c-5ddd-8173-e348bdcb96f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sec⁡\\theta =-\\frac{7\\sqrt{5}}{3}" :db/id #edb/ref 17592186404325} {:answer/id #uuid "1f7b0ef2-5302-5b29-89fc-f8f26371b54c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sec⁡\\theta =-\\frac{7\\sqrt{3}}{12}" :db/id #edb/ref 17592186404326} {:answer/id #uuid "39dd9d4a-1c32-59d2-b731-ba230d302e82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sec⁡\\theta =\\frac{3\\sqrt{2}}{2}" :db/id #edb/ref 17592186404327} {:answer/id #uuid "b99f4a1b-d16f-5aa6-a399-a33703bd010f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sec⁡\\theta =\\frac{\\sqrt{6}}{12}" :db/id #edb/ref 17592186404328}] :answer-field/correct {:answer/id #uuid "6bce3c75-6a0d-53d7-9a0d-6b6d8acd31bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sec⁡\\theta =-\\frac{7\\sqrt{6}}{12}" :db/id #edb/ref 17592186404324} :answer-field/id #uuid "e48430d0-09a9-535a-843b-f4fdfbee498f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404323}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0902cd66-9d18-50eb-a894-3b1edfc4b17b" :question/math-academy-id "q-85643" :question/problem "![](images/3b/3be6fa94deb7fc38d870e5a31cc81c3cfd6b9ab84c21340e7e88f7246b1058bc.png)\n\nThe diagram above shows the unit circle. Given that the $y$-coordinate of the point $P$ is $\\frac{5}{7},$ what is the value of $sec⁡\\theta ?$" :question/worked-solution "![](images/17/17e6320115f2cf8b5ffad6abc099169774536af20d2559b453aaa97c1286d96d.png)\n\nWe're given that $y=\\frac{5}{7}$ at the point $P.$ Therefore, $sin⁡\\theta =\\frac{5}{7}.$\n\nWe can use the Pythagorean identity to find $cos⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ cos⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $sin⁡\\theta =\\frac{5}{7}$ gives\n\n$$\n\\begin{aligned}cos⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{5}{7})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{25}{49}} \\\\  & =\\pm \\sqrt{\\frac{24}{49}} \\\\  & =\\pm \\frac{\\sqrt{24}}{7} \\\\  & =\\pm \\frac{2\\sqrt{6}}{7}.\\end{aligned}\n$$\n\nWe select the negative answer since $cos⁡\\theta $ is negative in the second quadrant. So, $cos⁡\\theta =-\\frac{2\\sqrt{6}}{7}.$\n\nFinally, knowing that $sec⁡\\theta =\\frac{1}{cos⁡\\theta },$ we have\n\n$$\nsec⁡\\theta =\\frac{1}{(-\\frac{2\\sqrt{6}}{7})}=-\\frac{7}{2\\sqrt{6}}=-\\frac{7\\sqrt{6}}{12}.\n$$"}] [{:db/id #edb/ref 17592186354463 :knowledge-point/_questions [{:db/id #edb/ref 17592186078489 :knowledge-point/id #uuid "236cec41-4836-5526-893d-e6f2a23d1801" :knowledge-point/title "Determining a Rate of Change for a Given Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12788cbb-a78d-5eff-ac3d-7309a6c971b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{355}{1+{e}^{-t}}$ liters per day" :db/id #edb/ref 17592186351725} {:answer/id #uuid "1bf2fe45-b3b9-5c97-b1bb-c7df2b59a6ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{710{e}^{t}}{2+{e}^{-t}}$  liters per day" :db/id #edb/ref 17592186351818} {:answer/id #uuid "2c9337cc-7a9c-50b8-8966-c08de1912686" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{710}{1+{e}^{-t}}$  liters per day" :db/id #edb/ref 17592186351975} {:answer/id #uuid "35aeabef-1c3d-5a27-b9ce-17d6c7474cba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$710{e}^{-t}$  liters per day" :db/id #edb/ref 17592186352067} {:answer/id #uuid "62e25f9f-c9c4-5c73-8e53-f310197acc34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$355{e}^{t}$  liters per day" :db/id #edb/ref 17592186352446}] :answer-field/correct {:answer/id #uuid "2c9337cc-7a9c-50b8-8966-c08de1912686" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{710}{1+{e}^{-t}}$  liters per day" :db/id #edb/ref 17592186351975} :answer-field/id #uuid "5f24ed36-8d2c-53fe-81db-4d1f78c00dca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353986}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f3efcfb8-9934-5ac8-a968-8c9e18c90fc0" :question/math-academy-id "q-86191" :question/problem "The function $P(t)=710\\operatorname{ln}⁡(1+{e}^{t})$ represents the volume of milk, in liters, produced on a farm $t$ days after the owner bought new cows. What is the instantaneous rate of change of the volume of produced milk as a function of $t?$" :question/worked-solution "The instantaneous rate of change of the volume of produced milk with respect to time is ${P}^{′}(t).$\n\nNow, the rate of change of $P(t)$ with respect to $t$ is\n\n$$\n\\begin{aligned}{P}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(710\\operatorname{ln}⁡(1+{e}^{t})) \\\\  & =710\\,\\frac{{e}^{t}}{1+{e}^{t}} \\\\  & =\\frac{710}{1+{e}^{-t}}\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change of the volume of produced milk is  $\\frac{710}{1+{e}^{-t}}$ liters per day."}] [{:db/id #edb/ref 17592186354465 :knowledge-point/_questions [{:db/id #edb/ref 17592186059844 :knowledge-point/id #uuid "f0052499-42ab-5818-a844-20eb099c3f7b" :knowledge-point/title "Finding the Sine or Cosine of a Special Angle Given in Radians"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "044b0751-3888-55cc-a3f5-80549082bb96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{4}" :db/id #edb/ref 17592186351606} {:answer/id #uuid "7b30bf64-0acc-5282-b803-06945c32a50f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186352639} {:answer/id #uuid "92bdbad7-2d48-5c77-876c-fcc57313f9ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186352838} {:answer/id #uuid "9f0f11de-1be9-5064-990b-af0dfef7ce48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186352930} {:answer/id #uuid "dec91441-cb91-59c4-a043-47f7c0f1aa32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{2}}{2}" :db/id #edb/ref 17592186353501}] :answer-field/correct {:answer/id #uuid "7b30bf64-0acc-5282-b803-06945c32a50f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186352639} :answer-field/id #uuid "0c5e282a-f0f5-5ba8-8e6f-9a5d8748314c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353837}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fb464a1e-3e09-57c1-9d5b-ec060c590e24" :question/math-academy-id "q-86327" :question/problem "$cos⁡(\\frac{\\pi }{4})=$" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/db/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle $\\frac{\\pi }{4}$ corresponds to the point $(\\frac{\\sqrt{2}}{2},\\frac{\\sqrt{2}}{2}).$\n\nSince the cosine of the angle corresponds to the $x$-coordinate, we have $cos⁡(\\frac{\\pi }{4})=\\frac{\\sqrt{2}}{2}.$"}] [{:db/id #edb/ref 17592186354467 :knowledge-point/_questions [{:db/id #edb/ref 17592186105814 :knowledge-point/id #uuid "01fe05cd-8acc-5676-9328-7a26362a77d0" :knowledge-point/title "Solving for an Unknown Given the Value of a Right Riemann Sum With Regular Step Size"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15c0277c-fb4b-5026-9fd8-6c7810e057b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186351756} {:answer/id #uuid "1e6dd320-c836-51a4-ad23-8614799db41b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186351838} {:answer/id #uuid "5f17f867-8ede-528f-b531-5e234c5f7333" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186352410} {:answer/id #uuid "67375961-39e8-54d5-9054-515f282d6534" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186352482} {:answer/id #uuid "c3a357ac-56ed-5863-b3dc-01fa6b42eb7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186353259}] :answer-field/correct {:answer/id #uuid "c3a357ac-56ed-5863-b3dc-01fa6b42eb7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186353259} :answer-field/id #uuid "4d77c46d-1aa3-501f-aae2-671960790f6f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353950}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "682dd404-2e33-5194-9b75-83eececc2df8" :question/math-academy-id "q-86350" :question/problem "The following table shows the velocity of a plane during a $20$-minute trip.\n\n| $t\\,(\\text{minutes})$ | $0$ | $5$ | $10$ | $15$ | $20$ |\n| --- | --- | --- | --- | --- | --- |\n| $v(t)\\,(\\text{kilometers/minute})$ | $17$ | $25$ | $27$ | $k$ | $18$ |\n\nIf the right Riemann sum approximation of the total distance traveled during this period has a value of  $450\\,\\text{km}$, what is the value of $k?$\n\n*Hint: The distance traveled is given by the area under the velocity-time graph.*" :question/worked-solution "The area $A$ under the curve $y=v(t)$ can be approximated using the formula\n\n$$\nA≈(\\overset{\\text{heights}}{\\overset{⏞}{v(5)+v(10)+v(15)+v(20)}})\\cdot {{Δt}_{⏟}}_{\\text{width}}.\n$$\n\nSo, we now set up a table with the values of $v(t)$ at each point:\n\n| $t$ | $5$ | $10$ | $15$ | $20$ |\n| --- | --- | --- | --- | --- |\n| $v(t)$ | $25$ | $27$ | $k$ | $18$ |\n\nNow, we obtain the following approximation for the area:\n\n$$\n\\begin{aligned}A & ≈(25+27+k+18)\\cdot 5 \\\\  & =5(k+70) \\\\  & =5k+350\\end{aligned}\n$$\n\nFinally, in the given context, the area under the curve represents the total distance traveled during the $20$ minute period. Since we are given that the right Riemann sum approximation of the total distance is $450\\,\\text{km},$ we obtain\n\n$$\n\\begin{aligned}5k+350 & =450 \\\\ 5k & =450-350 \\\\ k & =\\frac{100}{5} \\\\ k & =20.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186354468 :knowledge-point/_questions [{:db/id #edb/ref 17592186068861 :knowledge-point/id #uuid "a7f04ab7-f6f6-5d01-bfcf-b667e37e4f0b" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Irrational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "029fa0e3-dd36-5f3b-83ad-2cba2e31a6df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=20" :db/id #edb/ref 17592186351588} {:answer/id #uuid "0347f6ba-8275-55a4-aac2-653e481c8564" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=26" :db/id #edb/ref 17592186351595} {:answer/id #uuid "371907b8-8d3b-547a-9416-21dcd94a96bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=36" :db/id #edb/ref 17592186352079} {:answer/id #uuid "64af757f-a5f5-5de8-9518-714b14936255" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=-16" :db/id #edb/ref 17592186352457} {:answer/id #uuid "67a3e342-6a19-5ca4-9745-f0c27bfd5f69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=6" :db/id #edb/ref 17592186352490}] :answer-field/correct {:answer/id #uuid "0347f6ba-8275-55a4-aac2-653e481c8564" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=26" :db/id #edb/ref 17592186351595} :answer-field/id #uuid "6b5c2324-629b-5b3c-99c4-45b9f2afb50e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354016}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6913ef2e-5530-525b-8ba5-681a643ef5b4" :question/math-academy-id "q-86404" :question/problem "The equation ${y}^{2}+16=-12y$ can be written in the form $(y+p)^{2}=q.$ Find $p+q.$" :question/worked-solution "First, we move the constant term to the right-hand side, the $-12y$ term to the left-hand side, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}{y}^{2}+16 & =-12y \\\\ {y}^{2}+12y & =-16 \\\\ {y}^{2}+2\\cdot 6\\cdot y & =-16 \\\\ {y}^{2}+2\\cdot 6\\cdot y+{6}^{2}-{6}^{2} & =-16 \\\\ (y+6)^{2}-{6}^{2} & =-16\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(y+6)^{2}-{6}^{2} & =-16 \\\\ (y+6)^{2} & =20\\end{aligned}\n$$\n\nSo, $p=6,q=20,$ and $p+q=26.$"}] [{:db/id #edb/ref 17592186404329 :knowledge-point/_questions [{:db/id #edb/ref 17592186184192 :knowledge-point/id #uuid "3996c79f-9281-5b9d-9b33-8863f10adc33" :knowledge-point/title "Solving a Quadratic Equation With a Negative Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b68c25b-c193-5a40-829b-fd51b04788c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q=12,\\,w=\\frac{1}{2}\\pm \\sqrt{2}" :db/id #edb/ref 17592186404331} {:answer/id #uuid "0cd1cdc0-3122-5e73-85f9-af559fd24792" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q=2,\\,w=\\frac{1}{2}\\pm \\sqrt{3}" :db/id #edb/ref 17592186404332} {:answer/id #uuid "7c200ff8-dd75-5421-837d-9ef23ff5522e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q=2,\\,w=-\\frac{1}{2}\\pm \\sqrt{3}" :db/id #edb/ref 17592186404333} {:answer/id #uuid "5671ea71-84dd-554c-92ae-a5caaefc57b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q=12,\\,w=-2\\pm \\sqrt{3}" :db/id #edb/ref 17592186404334} {:answer/id #uuid "34743567-dc8f-5027-8a31-2da4c77b759c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q=12,\\,w=-\\frac{1}{2}\\pm \\sqrt{3}" :db/id #edb/ref 17592186404335}] :answer-field/correct {:answer/id #uuid "34743567-dc8f-5027-8a31-2da4c77b759c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q=12,\\,w=-\\frac{1}{2}\\pm \\sqrt{3}" :db/id #edb/ref 17592186404335} :answer-field/id #uuid "3733f599-455f-5b42-9817-59fac3c5944c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404330}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7895edb1-f2c2-5302-ad9e-dc0b6ea9c033" :question/math-academy-id "q-86413" :question/problem "The equation $-4{w}^{2}-4w+11=0$ can be written in the form $4(w+p)^{2}=q.$ Find $q,$ and solve the equation." :question/worked-solution "First, we multiply the equation by $-1$:\n\n$$\n\\begin{aligned}(-1)\\cdot (-4{w}^{2}-4w+11) & =(-1)\\cdot 0 \\\\ 4{w}^{2}+4w-11 & =0\\end{aligned}\n$$\n\nNow we move the constant term to the right-hand side, factor the coefficient of the quadratic term, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}4{w}^{2}+4w-11 & =0 \\\\ 4({w}^{2}+w) & =11 \\\\ 4[{w}^{2}+2\\cdot \\frac{1}{2}w+{(\\frac{1}{2})}^{2}-{(\\frac{1}{2})}^{2}] & =11 \\\\ 4[{(w+\\frac{1}{2})}^{2}-\\frac{1}{4}] & =11\\end{aligned}\n$$\n\nNext, we expand the brackets, and write the equation in the required form:\n\n$$\n\\begin{aligned}4{(w+\\frac{1}{2})}^{2}-4\\cdot \\frac{1}{4} & =11 \\\\ 4{(w+\\frac{1}{2})}^{2}-1 & =11 \\\\ 4{(w+\\frac{1}{2})}^{2} & =11+1 \\\\ 4{(w+\\frac{1}{2})}^{2} & =12\\end{aligned}\n$$\n\nTherefore, $q=12.$ We now solve the equation using the square root method:\n\n$$\n\\begin{aligned}4{(w+\\frac{1}{2})}^{2} & =12 \\\\ {(w+\\frac{1}{2})}^{2} & =\\frac{12}{4} \\\\ {(w+\\frac{1}{2})}^{2} & =3 \\\\ \\sqrt{{(w+\\frac{1}{2})}^{2}} & =\\sqrt{3} \\\\ |w+\\frac{1}{2}| & =\\sqrt{3} \\\\ w+\\frac{1}{2} & =\\pm \\sqrt{3} \\\\ w & =-\\frac{1}{2}\\pm \\sqrt{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186404343 :knowledge-point/_questions [{:db/id #edb/ref 17592186184192 :knowledge-point/id #uuid "3996c79f-9281-5b9d-9b33-8863f10adc33" :knowledge-point/title "Solving a Quadratic Equation With a Negative Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c07dfad2-047a-527a-a51a-4f998f1949f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$q=25,\\,w=\\frac{5}{2}$ and $w=\\frac{15}{2}$" :db/id #edb/ref 17592186404345} {:answer/id #uuid "fff341dd-b41a-5304-ad09-cc4af765adfb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$q=15,\\,w=-\\frac{5}{2}$ and $w=\\frac{15}{2}$" :db/id #edb/ref 17592186404346} {:answer/id #uuid "0b80197a-b970-5c44-9c91-75cf359e8575" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$q=25,\\,w=5$ and $w=\\frac{11}{2}$" :db/id #edb/ref 17592186404347} {:answer/id #uuid "fe959228-e459-5b19-9cf7-7d8a7111d3eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$q=15,\\,w=\\frac{5}{2}$ and $w=\\frac{15}{2}$" :db/id #edb/ref 17592186404348} {:answer/id #uuid "89145d06-76ec-5ca5-93f9-df5b33533d95" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$q=25,\\,w=\\frac{\\sqrt{5}}{2}$ and $w=15$" :db/id #edb/ref 17592186404349}] :answer-field/correct {:answer/id #uuid "c07dfad2-047a-527a-a51a-4f998f1949f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$q=25,\\,w=\\frac{5}{2}$ and $w=\\frac{15}{2}$" :db/id #edb/ref 17592186404345} :answer-field/id #uuid "417df0a0-d7e8-5502-826d-e0777e84a95f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404344}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "211d779e-92bf-5786-beb2-56b9bec0ebf9" :question/math-academy-id "q-86415" :question/problem "The equation $-4{w}^{2}+40w-75=0$ can be written in the form $4(w+p)^{2}=q.$ Find $q,$ and solve the equation." :question/worked-solution "First, we multiply the equation by $-1$:\n\n$$\n\\begin{aligned}(-1)\\cdot (-4{w}^{2}+40w-75) & =(-1)\\cdot 0 \\\\ 4{w}^{2}-40w+75 & =0\\end{aligned}\n$$\n\nNow we move the constant term to the right-hand side, factor the coefficient of the quadratic term, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}4{w}^{2}-40w+75 & =0 \\\\ 4{w}^{2}-40w & =-75 \\\\ 4({w}^{2}-10w) & =-75 \\\\ 4[{w}^{2}-2\\cdot 5w+{5}^{2}-{5}^{2}] & =-75 \\\\ 4[{(w-5)}^{2}-25] & =-75\\end{aligned}\n$$\n\nNext, we expand the brackets, and write the equation in the required form:\n\n$$\n\\begin{aligned}4{(w-5)}^{2}-4\\cdot 25 & =-75 \\\\ 4{(w-5)}^{2}-100 & =-75 \\\\ 4{(w-5)}^{2} & =-75+100 \\\\ 4{(w-5)}^{2} & =25\\end{aligned}\n$$\n\nTherefore, $q=25.$ We now solve the equation using the square root method:\n\n$$\n\\begin{aligned}4{(w-5)}^{2} & =25 \\\\ {(w-5)}^{2} & =\\frac{25}{4} \\\\ \\sqrt{{(w-5)}^{2}} & =\\sqrt{\\frac{25}{4}} \\\\ |w-5| & =\\frac{5}{2} \\\\ w-5 & =\\pm \\frac{5}{2} \\\\ w & =5\\pm \\frac{5}{2}\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}w & =5+\\frac{5}{2}=\\frac{15}{2} \\\\ w & =5-\\frac{5}{2}=\\frac{5}{2}\\end{aligned}\n$$\n\nTherefore, the solutions are $w=\\frac{5}{2}$ and $w=\\frac{15}{2}.$"}] [{:db/id #edb/ref 17592186115969 :knowledge-point/_questions [{:db/id #edb/ref 17592186115303 :knowledge-point/id #uuid "a227c7a8-977d-54b0-9409-d364da03656f" :knowledge-point/title "Computing the Mean of a Data Set From the Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30c20a01-270f-5737-ae9a-84d63a1f7fbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.1" :db/id #edb/ref 17592186352015} {:answer/id #uuid "4d3569a6-6912-57e6-a85c-9238f40ddbba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.2" :db/id #edb/ref 17592186352272} {:answer/id #uuid "afdfff25-ae14-5a9e-93f1-0dc0a031e75e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.8" :db/id #edb/ref 17592186353070} {:answer/id #uuid "d5e84888-7272-5abb-8f63-afaab6047bda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.9" :db/id #edb/ref 17592186353419} {:answer/id #uuid "fd0af2fb-0e67-5b16-95b0-3d374048e7ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.0" :db/id #edb/ref 17592186353783}] :answer-field/correct {:answer/id #uuid "30c20a01-270f-5737-ae9a-84d63a1f7fbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.1" :db/id #edb/ref 17592186352015} :answer-field/id #uuid "af5b7a45-08a6-51e0-b39b-62df1bc74ed8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354126}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1b510547-4334-5503-aa02-8d3585bbd83f" :question/math-academy-id "q-86566" :question/problem "Given a data set with $15$ data points and ${\\sum }_{i=1}^{15}{x}_{i}=91,$ compute $\\overset{―}{x}.$ Round your answer to one decimal place." :question/requires-calculator true :question/worked-solution "If we have a data set that consists of the points ${x}_{1},{x}_{2},…,{x}_{n},$ then the mean is denoted by $\\overset{―}{x}$ and is given by the following formula:\n\n$$\n\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}\n$$\n\nSubstituting $n=15$ and ${\\sum }_{i=1}^{15}{x}_{i}=91,$ we get\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{15}\\cdot 91≈6.1,\\end{aligned}\n$$\n\nwhere we have rounded our answer to one decimal place."}] [{:db/id #edb/ref 17592186354531 :knowledge-point/_questions [{:db/id #edb/ref 17592186083220 :knowledge-point/id #uuid "e49e2595-62a1-595a-8df9-99541bccbdf5" :knowledge-point/title "Calculating Permutations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "087937ab-4446-5368-9bce-1fce43b01fae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "480" :db/id #edb/ref 17592186351643} {:answer/id #uuid "62d604ea-fe2e-5a98-826f-4071e1838830" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "910" :db/id #edb/ref 17592186352445} {:answer/id #uuid "99c0e736-b604-56b8-b963-6ab73e357502" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "720" :db/id #edb/ref 17592186352885} {:answer/id #uuid "bbd10b1b-d951-577b-8d78-314446269a90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "540" :db/id #edb/ref 17592186353161} {:answer/id #uuid "faf4206d-50cc-5507-9c11-16e00ad05a75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "360" :db/id #edb/ref 17592186353765}] :answer-field/correct {:answer/id #uuid "99c0e736-b604-56b8-b963-6ab73e357502" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "720" :db/id #edb/ref 17592186352885} :answer-field/id #uuid "65e3c440-dfb0-5d0a-a444-7331a8e9d7d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354005}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1af97a6c-2901-5306-ad12-401b993aaea1" :question/math-academy-id "q-86869" :question/problem "A railway train has $6$ passenger wagons. How many ways can $6$ conductors be distributed among the wagons if one conductor is assigned to each wagon?" :question/worked-solution "There are $6$  conductors to arrange, so there are $6!$ ways of arranging them:\n\n$$\n\\begin{aligned}6! & =6\\times 5\\times \\times 3\\times 2\\times 1 \\\\  & =720.\\end{aligned}\n$$"}]}
