#{[{:db/id #edb/ref 17592186287900 :knowledge-point/_questions [{:db/id #edb/ref 17592186096785 :knowledge-point/id #uuid "cc62d8df-450f-5f7a-b647-b53c051f8339" :knowledge-point/title "Solving a System Containing Decimals in Both Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e87017a-3d71-526f-882c-4c2dfef523bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.5" :db/id #edb/ref 17592186285378} {:answer/id #uuid "779e6eca-f602-5727-b029-1c18d87c1280" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.5" :db/id #edb/ref 17592186285898} {:answer/id #uuid "77d04a2c-eb10-5431-830c-d23e900376e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186285903} {:answer/id #uuid "8a09092a-f7a8-583a-ab31-352d4e305731" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5.5" :db/id #edb/ref 17592186286049} {:answer/id #uuid "d485a384-181e-5a8e-9b1f-2a7c89a1bcb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186286717}] :answer-field/correct {:answer/id #uuid "77d04a2c-eb10-5431-830c-d23e900376e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186285903} :answer-field/id #uuid "8315d25a-73c2-509a-9efb-209d1dae20b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287422}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "afe3b13e-ab14-5340-83f7-304f398b7445" :question/math-academy-id "q-18720" :question/problem "Let $(p,q)$ be the solution of the following system. What is the value of $p+2q?$\n\n$$\n{\\begin{aligned}0.36p+1.2q=0.36 \\\\ -1.9p-7.6q=3.8\\end{aligned}\n$$" :question/worked-solution "To get rid of the decimals, we multiply the first equation by $100$ and the second equation by $10,$ as follows:\n\n$$\n{\\begin{aligned}0.36p+1.2q=0.36 & |\\times 100 \\\\ -1.9p-7.6q=3.8 & |\\times 10\\end{aligned}\\,⟹\\,{\\begin{aligned}36p+120q=36 \\\\ -19p-76q=38\\end{aligned}\n$$\n\nNotice that we can solve for $p$ in the second equation:\n\n$$\n\\begin{aligned}-19p-76q & =38 \\\\ -19p & =76q+38 \\\\ p & =\\frac{76q+38}{-19} \\\\ p & =-4q-2\\end{aligned}\n$$\n\nNow, to find the value of $q,$ we can substitute $p=-4q-2$ into the first equation:\n\n$$\n\\begin{aligned}36p+120q & =36 \\\\ 36(-4q-2)+120q & =36 \\\\ -144q-72+120q & =36 \\\\ -24q & =108 \\\\ q & =-\\frac{108}{24} \\\\ q & =-4.5\\end{aligned}\n$$\n\nFinally, we substitute $q=-4.5$ into the equation $p=-4q-2$ to get:\n\n$$\n\\begin{aligned}p & =-4q-2 \\\\ p & =-4(-4.5)-2 \\\\ p & =18-2 \\\\ p & =16\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $p=16$ and $q=-4.5.$ So, \n\n$$\np+2q=16+2(-4.5)=16-9=7.\n$$"}] [{:db/id #edb/ref 17592186287917 :knowledge-point/_questions [{:db/id #edb/ref 17592186115193 :knowledge-point/id #uuid "7995b377-1de4-5126-aa29-8cc30b4918f8" :knowledge-point/title "Finding the Slope of the Tangent at a Point of a Function Involving Reciprocal Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04d15acc-1672-5ec4-bb78-f3474884b897" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{3}-5\\sqrt{3}" :db/id #edb/ref 17592186284830} {:answer/id #uuid "48fabaf5-be8a-589c-8cf0-074c455a9240" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}-10\\sqrt{3}" :db/id #edb/ref 17592186285458} {:answer/id #uuid "63f73e2e-4004-5fc8-9825-f8337f6c2b07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{6}-10\\sqrt{3}" :db/id #edb/ref 17592186285697} {:answer/id #uuid "766bb2aa-4af5-5e09-aed3-a777505c1a5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}+10\\sqrt{3}" :db/id #edb/ref 17592186285891} {:answer/id #uuid "e40e7c86-1ed2-5d5e-9940-61e65ceaec5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{3}-10\\sqrt{3}" :db/id #edb/ref 17592186286873}] :answer-field/correct {:answer/id #uuid "e40e7c86-1ed2-5d5e-9940-61e65ceaec5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{3}-10\\sqrt{3}" :db/id #edb/ref 17592186286873} :answer-field/id #uuid "e8570317-ecab-5ed9-a868-188d2c2ead8e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287627}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f9daa906-697e-5ad9-9a96-96e98679f403" :question/math-academy-id "q-1904" :question/problem "Find the slope of $y=f(x)$ at $x=\\frac{\\pi }{6}$ if $f(x)=-{x}^{2}+5csc⁡x.$" :question/worked-solution "First, we calculate the derivative using the sum rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{d}{dx}(-{x}^{2}+5csc⁡x) \\\\  & =2\\cdot (-x)+5(-csc⁡xcot⁡x) \\\\  & =-2x-5csc⁡xcot⁡x\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{6}$ into the derivative and get:\n\n$$\n\\begin{aligned}{f}^{′}(\\frac{\\pi }{6}) & =-2(\\frac{\\pi }{6})-5csc⁡(\\frac{\\pi }{6})cot⁡(\\frac{\\pi }{6}) \\\\  & =-\\frac{\\pi }{3}-5\\cdot 2\\cdot \\sqrt{3} \\\\  & =-\\frac{\\pi }{3}-10\\sqrt{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401805 :knowledge-point/_questions [{:db/id #edb/ref 17592186115191 :knowledge-point/id #uuid "9699341b-c4e2-547f-8d98-bcda30567272" :knowledge-point/title "Differentiating Expressions Involving the Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a34f86b-faa2-5844-9680-3f6951dc4ecf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}{csc}^{2}⁡x+8{x}^{3}cot⁡x" :db/id #edb/ref 17592186401807} {:answer/id #uuid "63214331-a811-5bf2-8cb7-4da5c8c1d678" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{4}{cot}^{2}⁡x-8{x}^{3}csc⁡x" :db/id #edb/ref 17592186401808} {:answer/id #uuid "2285f6af-f131-5a62-954e-164127014717" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{4}{csc}^{2}⁡x-8{x}^{3}cot⁡x" :db/id #edb/ref 17592186401809} {:answer/id #uuid "5a35c415-50b4-5005-8173-6121abbd643e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}csc⁡x-8{x}^{3}cot⁡x" :db/id #edb/ref 17592186401810} {:answer/id #uuid "cb8e226f-a28c-5b1a-b7df-6f312bfd06a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{4}{csc}^{2}⁡x+8{x}^{3}tan⁡x" :db/id #edb/ref 17592186401811}] :answer-field/correct {:answer/id #uuid "2285f6af-f131-5a62-954e-164127014717" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{4}{csc}^{2}⁡x-8{x}^{3}cot⁡x" :db/id #edb/ref 17592186401809} :answer-field/id #uuid "f7aeb284-4f80-510f-8935-07a7e23c626b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401806}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ee4e083b-fcc9-5eb5-9a27-ac52f9a97afd" :question/math-academy-id "q-1913" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ if $y=-2{x}^{4}cot⁡x.$" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-2{x}^{4}cot⁡x) \\\\  & =(-8{x}^{3})(cot⁡x)+(-2{x}^{4})(-{csc}^{2}⁡x) \\\\  & =-8{x}^{3}cot⁡x+2{x}^{4}{csc}^{2}⁡x\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401812 :knowledge-point/_questions [{:db/id #edb/ref 17592186064370 :knowledge-point/id #uuid "a1ec1379-ce50-53c7-b04d-3380676ebeb9" :knowledge-point/title "Calculating the Velocity of a Particle at a Particular Moment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e41ae0ea-e83b-581f-a124-c29c127545ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v=9.46" :db/id #edb/ref 17592186401814} {:answer/id #uuid "2ddc81bc-6b74-5b86-9aa6-68b7985e21ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v=4.94" :db/id #edb/ref 17592186401815} {:answer/id #uuid "4c2d52e0-5f90-57ca-a8a9-c0f4aaadbdfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v=10.03" :db/id #edb/ref 17592186401816} {:answer/id #uuid "e34561e5-c74f-5726-99b2-cd744a8924ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v=9.24" :db/id #edb/ref 17592186401817} {:answer/id #uuid "eea394a2-6e5a-5394-a910-d19a50a2530e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v=8.36" :db/id #edb/ref 17592186401818}] :answer-field/correct {:answer/id #uuid "e41ae0ea-e83b-581f-a124-c29c127545ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v=9.46" :db/id #edb/ref 17592186401814} :answer-field/id #uuid "ab640647-5232-553a-be5a-08e8539221b0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401813}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "59ea1544-758d-5928-bf3f-4995dd8b61f1" :question/math-academy-id "q-19299" :question/problem "The position $s(t)$ of a particle at time $t$ is given by \n\n$$\ns(t)=4{e}^{-t}+3{t}^{2}-2t+1,\\,t\\ge 0.\n$$\n\nCalculate the velocity at time $t=2.$ Round your answer to $2$ decimal places." :question/worked-solution "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4{e}^{-t}+3{t}^{2}-2t+1) \\\\  & =-4{e}^{-t}+6t-2\\end{aligned}\n$$\n\nTo calculate the velocity at $t=2,$ we substitute $t=2$ into the velocity function above:\n\n$$\n\\begin{aligned}v(2) & =-4{e}^{-2}+6\\cdot 2-2 \\\\  & =-4{e}^{-2}+10 \\\\  & =9.458\\,658… \\\\  & ≈9.46\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287951 :knowledge-point/_questions [{:db/id #edb/ref 17592186092261 :knowledge-point/id #uuid "2f4bfd24-dafd-57b3-940a-154a6e0acf3d" :knowledge-point/title "Differentiating a General Exponential Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bb72661-686b-55b7-acd2-2a3bd4990839" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\cdot {2}^{9x}" :db/id #edb/ref 17592186284881} {:answer/id #uuid "0fa45466-3a87-5294-bb09-177ec594bc1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9x" :db/id #edb/ref 17592186284925} {:answer/id #uuid "7da55036-6972-52f3-847b-a31f95df7852" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2}^{9x}" :db/id #edb/ref 17592186285944} {:answer/id #uuid "968393cd-2595-5198-a30d-859a805cd56e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\operatorname{ln}⁡2\\cdot {2}^{9x}" :db/id #edb/ref 17592186286156} {:answer/id #uuid "f0d61fb9-24f0-590c-861d-b0dc09f76a1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\cdot {2}^{9x}" :db/id #edb/ref 17592186286998}] :answer-field/correct {:answer/id #uuid "968393cd-2595-5198-a30d-859a805cd56e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\operatorname{ln}⁡2\\cdot {2}^{9x}" :db/id #edb/ref 17592186286156} :answer-field/id #uuid "05333763-722c-5f4d-b56e-21e02dec7970" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287152}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "15807573-b299-5e98-85b6-db47d2fbe91c" :question/math-academy-id "q-1952" :question/problem "Given that $y={2}^{9x},$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={2}^{u},\\,u=9x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={2}^{u}\\operatorname{ln}⁡2,\\,\\frac{\\text{d}u}{\\text{d}x}=9.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={2}^{u}\\operatorname{ln}⁡2\\cdot 9 \\\\  & =9\\operatorname{ln}⁡2\\cdot {2}^{u} \\\\  & =9\\operatorname{ln}⁡2\\cdot {2}^{9x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233619 :knowledge-point/_questions [{:db/id #edb/ref 17592186179660 :knowledge-point/id #uuid "644b7f09-7f66-50f2-8eba-ef6e009429d0" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient With Many Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22766496-0abf-50a1-80d1-5c3aa17a5c49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n-8)(n+8)(n+9)" :db/id #edb/ref 17592186285095} {:answer/id #uuid "2decc5e8-9169-5cef-a48f-c52612fb5bb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n+8)(n+9)" :db/id #edb/ref 17592186285195} {:answer/id #uuid "68bba672-b656-58bd-ab7d-b6d8e1d686e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n+7)(n+8)(n+9)" :db/id #edb/ref 17592186285750} {:answer/id #uuid "96c58f78-9e89-5c29-947e-3e0a3eea9a98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(n+8)(n+9)}{n-9}" :db/id #edb/ref 17592186286158} {:answer/id #uuid "bd10a16d-830d-53c9-ba1c-682004537a80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{n+9}{n-9}" :db/id #edb/ref 17592186286513}] :answer-field/correct {:answer/id #uuid "22766496-0abf-50a1-80d1-5c3aa17a5c49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n-8)(n+8)(n+9)" :db/id #edb/ref 17592186285095} :answer-field/id #uuid "12acb7ca-836f-551c-8db4-207dc9c189b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287179}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f3ef0665-6f2a-5dd9-af17-7da892c3b332" :question/math-academy-id "q-19882" :question/problem "Given that $n\\ge 9$ is an integer, simplify $\\frac{(n-8)!\\,(n+9)!}{(n-9)!\\,(n+7)!}.$" :question/worked-solution "First, we notice that\n\n$$\n\\begin{aligned}(n+9)! & =(n+9)(n+8)(n+7)! \\\\ (n-8)! & =(n-8)(n-9)!\\end{aligned}\n$$\n\nThen, we can cancel the $(n+7)!$ and $(n-9)!$ that occur in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(n-8)!\\,(n+9)!}{(n-9)!\\,(n+7)!} & =\\frac{[(n-8)\\cdot (n-9)!]\\cdot [(n+9)\\cdot (n+8)\\cdot (n+7)!]}{(n-9)!\\cdot (n+7)!} \\\\  & =\\frac{(n-8)\\cdot \\cancel{(n-9)!}\\cdot (n+9)\\cdot (n+8)\\cdot \\cancel{(n+7)!}}{\\cancel{(n-9)!}\\cdot \\cancel{(n+7)!}} \\\\  & =(n-8)\\cdot (n+8)\\cdot (n+9) \\\\  & =(n-8)(n+8)(n+9)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287987 :knowledge-point/_questions [{:db/id #edb/ref 17592186064179 :knowledge-point/id #uuid "e617f241-254b-5f70-9937-5883b6f28c4f" :knowledge-point/title "Integrating Secant-Tangent and Cosecant-Cotangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16d4843e-1503-5b14-9ef4-6d9bd866b768" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sec⁡\\theta +C" :db/id #edb/ref 17592186284994} {:answer/id #uuid "5f513476-ecb1-5481-9bb0-8cd729eba6f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "csc⁡xcot⁡x+C" :db/id #edb/ref 17592186285660} {:answer/id #uuid "c159be5b-9ba9-50ec-90b5-6beba2ba516f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "csc⁡\\theta +C" :db/id #edb/ref 17592186286558} {:answer/id #uuid "dbdb10ca-14c4-5f21-a345-f92c3250e22c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-sec⁡\\theta +C" :db/id #edb/ref 17592186286788} {:answer/id #uuid "f5a909e4-a442-5f93-bb1c-8af5b5eeb86f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-csc⁡\\theta +C" :db/id #edb/ref 17592186287037}] :answer-field/correct {:answer/id #uuid "dbdb10ca-14c4-5f21-a345-f92c3250e22c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-sec⁡\\theta +C" :db/id #edb/ref 17592186286788} :answer-field/id #uuid "f5759735-03db-58c8-afc1-42a56314fd9a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287647}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8eefdd68-c49a-5b6b-9578-f46e438f3aac" :question/math-academy-id "q-2038" :question/problem "$\\int (-sec⁡\\theta tan⁡\\theta )\\text{d}\\theta =$" :question/worked-solution "Recall that\n\n$$\n\\int sec⁡\\theta tan⁡\\theta \\,\\text{d}\\theta =sec⁡\\theta +C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (-sec⁡\\theta tan⁡\\theta )\\text{d}\\theta  & =-\\int sec⁡\\theta tan⁡\\theta \\,\\text{d}\\theta  \\\\  & =-(sec⁡\\theta )+C \\\\  & =-sec⁡\\theta +C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401840 :knowledge-point/_questions [{:db/id #edb/ref 17592186083240 :knowledge-point/id #uuid "8922ab07-5ac7-5f85-bfee-c30de7f4024a" :knowledge-point/title "Finding the Derivative of a Parametric Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e5ec4eb-fb50-5d50-87c7-e15a073c23f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186401842} {:answer/id #uuid "7b15bc55-e6d8-5c21-b55e-568e588591b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186401843} {:answer/id #uuid "2c8c26cd-3204-5045-8920-160928c0068e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186401844} {:answer/id #uuid "7828179c-427e-5c33-a7ae-bd0edbe05cfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186401845} {:answer/id #uuid "db0ee922-0122-505b-abc7-21b2699ea220" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186401846}] :answer-field/correct {:answer/id #uuid "1e5ec4eb-fb50-5d50-87c7-e15a073c23f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186401842} :answer-field/id #uuid "0ec6f4c2-cef2-5136-bda0-046075ea56a5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401841}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a11f695c-004e-57f4-b1f5-cd09434f69e2" :question/math-academy-id "q-20851" :question/problem "For the parametric curve \n\n$$\nx=2\\sqrt{t},\\,y=12t+1,\\,0\\le t<\\infty ,\n$$\n\n find the derivative $\\frac{dy}{dx}$ at the point $P$ on the curve where $t=1.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=\\frac{1}{\\sqrt{t}},\\,{y}^{′}(t)=12.\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{12}{\\frac{1}{\\sqrt{t}}}=12\\sqrt{t}.\n$$\n\nAt the point where $t=1$ we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =12\\sqrt{1} \\\\  & =12\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290287 :knowledge-point/_questions [{:db/id #edb/ref 17592186059670 :knowledge-point/id #uuid "e6eef35a-3502-5429-bd71-fb5bd0e8efc8" :knowledge-point/title "Identifying Extrema on Transformed Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01b3ee48-738d-5154-93f4-593da455f6f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,6)" :db/id #edb/ref 17592186288038} {:answer/id #uuid "02202242-35fc-558e-b9c0-5e30f23f7048" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,0)" :db/id #edb/ref 17592186288042} {:answer/id #uuid "7017f50c-dcb4-516e-bbbc-55369bab2f30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,0)" :db/id #edb/ref 17592186288810} {:answer/id #uuid "c4904f95-4b3c-5515-9fcf-0a99b245182b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,-3)" :db/id #edb/ref 17592186289330} {:answer/id #uuid "cbce72d8-a3b3-5305-909c-46fd579eba75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,6)" :db/id #edb/ref 17592186289382}] :answer-field/correct {:answer/id #uuid "7017f50c-dcb4-516e-bbbc-55369bab2f30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,0)" :db/id #edb/ref 17592186288810} :answer-field/id #uuid "09418823-c229-5178-abcd-3466929f3782" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289745}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c0430c7a-d01d-554d-86e5-a8ca9cccf773" :question/math-academy-id "q-211462" :question/problem "![](images/80/8000655c1943c60282d8844a2ae965b6415e21962c44309cd68806f04744b806.png)\n\nThe diagram above shows the global minimum and maximum of the function $y=f(x).$ What is the global maximum of $y=-f(2x)+3?$" :question/worked-solution "Notice that the graph of $y=-f(2x)+3$ can be obtained from the graph of $y=f(x)$ by \n\n- stretching it by a scale factor of $\\frac{1}{2}$ parallel to the $x$-axis,\n\n- flipping it across the $x$-axis, and finally\n\n- translating it by $3$ units up.\n\nSince one of these transformations flips the graph across the $x$-axis, the combined transformation maps the global **minimum** of $y=f(x)$ to the global **maximum** of $y=-f(2x)+3.$ So, we need to find the image of $(2,3),$ the global minimum of $y=f(x),$ under the transformation. \n\nTo plot $y=-f(2x)+3,$ we apply the following steps: \n\n- First, we take the graph $y=f(x)$ that passes through $(2,3).$\n\n- Then, we stretch the graph  along the $x$-axis by a scale factor of $\\frac{1}{2}$ and get the graph of $y=f(2x).$ After this transformation, the point $(2,3)$ will be mapped to the point\n\n$$\n(\\frac{1}{2}\\cdot 2,3)=(1,3).\n$$\n\n- Next, we flip the result across the $x$-axis and get the graph of $y=-f(2x).$ After this transformation, the point $(1,3)$ will be mapped to the point\n\n$$\n(1,-1\\cdot 3)=(1,-3).\n$$\n\n- Finally, we translate the result by $3$ units up and get the graph of $y=-f(2x)+3.$ After this transformation, the point $(1,-3)$ will be mapped to the point\n\n$$\n(1,-3+3)=(1,0).\n$$\n\nTherefore, the global maximum of $y=-f(2x)+3$ is $(1,0).$"}] [{:db/id #edb/ref 17592186290323 :knowledge-point/_questions [{:db/id #edb/ref 17592186110599 :knowledge-point/id #uuid "29005c66-9f30-5862-926f-8a09320d404c" :knowledge-point/title "Determining Whether Two Lines in Slope-Intercept Form are Perpendicular"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f2f9488-176e-5ee3-ad8e-2db95b1123f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x-2" :db/id #edb/ref 17592186288350} {:answer/id #uuid "3f03d5e0-e5b1-53b3-ab18-0d7e379a24cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x+9" :db/id #edb/ref 17592186288461} {:answer/id #uuid "ccf2b0ef-9634-5c51-86e7-60eaa13bc504" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x+1" :db/id #edb/ref 17592186289396} {:answer/id #uuid "cea07821-893d-5fac-a3e9-4d99a591dc1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2x+1" :db/id #edb/ref 17592186289410} {:answer/id #uuid "f789d1aa-f223-5771-a67e-fc052240756a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x-\\frac{1}{2}" :db/id #edb/ref 17592186289662}] :answer-field/correct {:answer/id #uuid "3f03d5e0-e5b1-53b3-ab18-0d7e379a24cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x+9" :db/id #edb/ref 17592186288461} :answer-field/id #uuid "aed86ac2-1482-5201-9d78-def088012c7d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290116}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "da3fa1e4-9073-5723-b4d9-3e3d9f56d008" :question/math-academy-id "q-215890" :question/problem "Which of the following lines is perpendicular to $y=x+\\frac{1}{2}?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nThe line $y=x+\\frac{1}{2}$ is in slope-intercept form, and its slope is $1.$\n\nLooking at the answer choices, the line $y=-x+9$ has a slope of $-1.$\n\nMultiplying the slopes together, we have\n\n$$\n1\\cdot (-1)=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=-x+9$ is perpendicular to the given line."}] [{:db/id #edb/ref 17592186290329 :knowledge-point/_questions [{:db/id #edb/ref 17592186096634 :knowledge-point/id #uuid "14370371-529b-5f25-9963-62c0cd9a172e" :knowledge-point/title "Solving a System Containing Fractions in One Equation Using Elimination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28be3240-f527-5881-b030-d0e2f6f588f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=9,\\,q=10" :db/id #edb/ref 17592186288304} {:answer/id #uuid "2cd4f05d-ba10-5b34-a545-fb122617cedb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=5,\\,q=2" :db/id #edb/ref 17592186288324} {:answer/id #uuid "3c45f0cb-960d-58d2-8635-289e83d41c5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=3,\\,q=9" :db/id #edb/ref 17592186288448} {:answer/id #uuid "4eeddfa0-2016-5856-83e5-03c446213f2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=-3,\\,q=5" :db/id #edb/ref 17592186288578} {:answer/id #uuid "c538b0db-744e-5c84-a6a0-48a8617f619c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=3,\\,q=10" :db/id #edb/ref 17592186289338}] :answer-field/correct {:answer/id #uuid "c538b0db-744e-5c84-a6a0-48a8617f619c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=3,\\,q=10" :db/id #edb/ref 17592186289338} :answer-field/id #uuid "3459c60d-978a-5a3f-861a-110bccb1e94a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289840}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "906fc64a-e7c8-5770-89dc-d9c9f6b082d4" :question/math-academy-id "q-216042" :question/problem "$$\n{\\begin{aligned}-3p+\\frac{4}{5}q=-1 \\\\ 9p-4q=-13\\end{aligned}\n$$\n\nFind the solution to the system of equations given above." :question/worked-solution "To get rid of the fractions in the first equation, we must multiply the first equation by the lowest common denominator of the fractions, which is $5.$\n\n$$\n{\\begin{aligned}-3p+\\frac{4}{5}q=-1 & |\\,\\times 5 \\\\ 9p-4q=-13\\end{aligned}\\,⟹\\,{\\begin{aligned}-15p+4q=-5 \\\\ 9p-4q=-13\\end{aligned}\n$$\n\nWe will use the elimination method to solve the system. Notice that the $4q$ term in the first equation can cancel with the $-4q$ term in the second equation.\n\nAdding the two equations eliminates the $q$-variable, and allows us to solve for $p:$\n\n$$\n\\begin{aligned}-15p+\\cancel{4q} & =-5 \\\\ 9p-\\cancel{4q} & =-13 \\\\ -6p & =-18 \\\\ p & =3\\end{aligned}\n$$\n\nFinally, we can substitute $p=3$ into the equation $9p-4q=-13$ to solve for $q:$\n\n$$\n\\begin{aligned}9p-4q & =-13 \\\\ 9\\cdot 3-4q & =-13 \\\\ 27-4q & =-13 \\\\ -4q & =-40 \\\\ q & =10\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $p=3,\\,q=10.$"}] [{:db/id #edb/ref 17592186290336 :knowledge-point/_questions [{:db/id #edb/ref 17592186064178 :knowledge-point/id #uuid "0cae5c1b-57bd-51f6-a360-db946d25532f" :knowledge-point/title "Integrating Sine and Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "346358f5-312e-5c8a-9238-6be633b31e62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-sin⁡x-cos⁡x+C" :db/id #edb/ref 17592186288379} {:answer/id #uuid "419bbacf-36c2-544f-888a-5bf28372bd28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-sin⁡x+cos⁡x+C" :db/id #edb/ref 17592186288478} {:answer/id #uuid "70205983-7a23-51c1-a345-bf2ec479a0bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2sin⁡x+C" :db/id #edb/ref 17592186288812} {:answer/id #uuid "ba4296e8-700e-5668-8c90-e562531a6962" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sin⁡x+cos⁡x+C" :db/id #edb/ref 17592186289261} {:answer/id #uuid "c6a193d2-0ce7-5a28-86c4-834fae7f7271" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sin⁡x-cos⁡x+C" :db/id #edb/ref 17592186289350}] :answer-field/correct {:answer/id #uuid "ba4296e8-700e-5668-8c90-e562531a6962" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sin⁡x+cos⁡x+C" :db/id #edb/ref 17592186289261} :answer-field/id #uuid "0c59fbc8-d124-507b-af30-f117e1976ad1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289758}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d70818e9-1705-53df-abe3-9e6e72f287c6" :question/math-academy-id "q-2161" :question/problem "$\\int (cos⁡x-sin⁡x)\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int sin⁡x\\,\\text{d}x & =-cos⁡x+C, \\\\ \\int cos⁡x\\,\\text{d}x & =sin⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (cos⁡x-sin⁡x)\\,\\text{d}x & =\\int cos⁡x\\,\\text{d}x-\\int sin⁡x\\,\\text{d}x \\\\  & =sin⁡x-(-cos⁡x)+C \\\\  & =sin⁡x+cos⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069141 :knowledge-point/_questions [{:db/id #edb/ref 17592186068722 :knowledge-point/id #uuid "b89c50f3-2181-5b61-96cb-386ef88d2035" :knowledge-point/title "Integrating an Expression Involving a Power Function Multiplied by Its Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d5927e7-3d1a-5589-9ab4-b01b479f66f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x({x}^{2}+1)^{13}}{13}+C" :db/id #edb/ref 17592186288882} {:answer/id #uuid "a65798db-1640-5ac0-9550-f0316b86d818" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{({x}^{2}+1)^{13}}{13}+C" :db/id #edb/ref 17592186289133} {:answer/id #uuid "a71c627c-e9b2-5a11-b21d-b190f3a77006" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2x({x}^{2}+1)^{13}}{13}+C" :db/id #edb/ref 17592186289138} {:answer/id #uuid "d436ea16-40f5-50d5-8944-8947c0a63c89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2x({x}^{2}+1)^{12}}{12}+C" :db/id #edb/ref 17592186289436} {:answer/id #uuid "eb4463e3-17c4-52b2-809c-06d7c4b4e286" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{({x}^{2}+1)^{12}}{12}+C" :db/id #edb/ref 17592186289589}] :answer-field/correct {:answer/id #uuid "a65798db-1640-5ac0-9550-f0316b86d818" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{({x}^{2}+1)^{13}}{13}+C" :db/id #edb/ref 17592186289133} :answer-field/id #uuid "827ea8a6-3f45-58a9-acce-ef8eb4a48299" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290018}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c4b49482-74ae-5d27-81da-2160ac3cb246" :question/math-academy-id "q-2195" :question/problem "$\\int 2x({x}^{2}+1)^{12}\\,\\text{d}x=$" :question/worked-solution "We note that $2x$ is the derivative of the quantity in the parentheses. So we make a substitution\n\n$$\nu={x}^{2}+1.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =2x\\,⟹\\,\\text{d}u=2x\\,\\text{d}x,\\end{aligned}\n$$\n\nand rewriting our integral, we get\n\n$$\n\\begin{aligned}\\int 2x({x}^{2}+1)^{12}\\,\\text{d}x & =\\int ({x}^{2}+1)^{12}\\,2x\\,\\text{d}x \\\\  & =\\int {u}^{12}\\,\\text{d}u.\\end{aligned}\n$$\n\nWe can now solve the integral using the power rule:\n\n$$\n\\int {u}^{12}\\,\\text{d}u=\\frac{{u}^{13}}{13}+C\n$$\n\nLastly, we substitute $u={x}^{2}+1$ back in the expression. So the final result is\n\n$$\n\\int 2x({x}^{2}+1)^{12}\\,\\text{d}x=\\frac{({x}^{2}+1)^{13}}{13}+C.\n$$"}] [{:db/id #edb/ref 17592186290437 :knowledge-point/_questions [{:db/id #edb/ref 17592186064177 :knowledge-point/id #uuid "980bb2fb-4bb5-5cbb-aea8-87010493c013" :knowledge-point/title "Integrating a Sum of Exponential Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39f1030c-14e2-59e9-a189-ae72636d7cec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{x}+\\frac{{5}^{x}}{ln⁡2}+C" :db/id #edb/ref 17592186288429} {:answer/id #uuid "831fe1aa-d1a9-59de-914e-66c8e45135cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{e}^{x}+{2}^{x}ln⁡2+C" :db/id #edb/ref 17592186288914} {:answer/id #uuid "a92a1f84-319a-5ffc-912d-da344601d75d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}}{5}+\\frac{{2}^{x}}{ln⁡2}+C" :db/id #edb/ref 17592186289153} {:answer/id #uuid "bfec5a66-eb21-510f-ac20-724d2da23f30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{e}^{x}+\\frac{x}{ln⁡2}+C" :db/id #edb/ref 17592186289301} {:answer/id #uuid "f611671a-7317-5307-aefb-d9046cadfb32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{e}^{x}+\\frac{{2}^{x}}{ln⁡2}+C" :db/id #edb/ref 17592186289655}] :answer-field/correct {:answer/id #uuid "f611671a-7317-5307-aefb-d9046cadfb32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{e}^{x}+\\frac{{2}^{x}}{ln⁡2}+C" :db/id #edb/ref 17592186289655} :answer-field/id #uuid "6b01bf45-11e5-550e-91d5-6d78dcabad9c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289964}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e3b4a92d-a353-507a-becb-bee354a44152" :question/math-academy-id "q-2277" :question/problem "$\\int (5{e}^{x}+{2}^{x})\\,\\text{d}x=$" :question/worked-solution "Here, we combine the sum rule and our exponential rules to get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (5{e}^{x}+{2}^{x})\\,\\text{d}x & =5\\int {e}^{x}\\,\\text{d}x+\\int {2}^{x}\\,\\text{d}x \\\\  & =5{e}^{x}+\\frac{{2}^{x}}{ln⁡2}+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290442 :knowledge-point/_questions [{:db/id #edb/ref 17592186054845 :knowledge-point/id #uuid "9bf25f86-6b27-5eaa-b1a1-1104478b290a" :knowledge-point/title "Finding the Derivative of a Function Given in Implicit Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e268375-538a-538a-80bc-2f086cffdbb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6x}{1-\\operatorname{ln}⁡(2)\\,{2}^{y}}" :db/id #edb/ref 17592186288224} {:answer/id #uuid "793b6c32-8350-533d-bf9d-724d40064c5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{2}^{y}}{6x-\\operatorname{ln}⁡2\\,}" :db/id #edb/ref 17592186288865} {:answer/id #uuid "a3589f85-19fc-5bd4-ac3b-96bf622c2422" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6x}{\\operatorname{ln}⁡(2)\\,{2}^{y}}" :db/id #edb/ref 17592186289122} {:answer/id #uuid "e0d85bbf-5174-563d-a666-9a94bd4cf6fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6x}{{2}^{y}}" :db/id #edb/ref 17592186289532} {:answer/id #uuid "e27c90f5-ce7c-52d7-8488-fe25083eb2d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6x}{1-{2}^{y}}" :db/id #edb/ref 17592186289540}] :answer-field/correct {:answer/id #uuid "1e268375-538a-538a-80bc-2f086cffdbb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6x}{1-\\operatorname{ln}⁡(2)\\,{2}^{y}}" :db/id #edb/ref 17592186288224} :answer-field/id #uuid "3f58fa9b-a3f6-53aa-a4c8-4680d5988ce9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289871}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "623f14ca-5670-5819-81c3-5ed253df18c6" :question/math-academy-id "q-2289" :question/problem "Given that  $y-{2}^{y}=3{x}^{2},$ calculate $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$ \n\n$$\n\\begin{aligned}\\begin{aligned}y-{2}^{y} & =3{x}^{2} \\\\ \\frac{\\text{d}}{\\text{d}x}(y-{2}^{y}) & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{2}) \\\\ \\frac{\\text{d}}{\\text{d}x}(y)-\\frac{\\text{d}}{\\text{d}x}({2}^{y}) & =6x \\\\ (1-\\operatorname{ln}⁡(2){2}^{y})(\\frac{\\text{d}y}{\\text{d}x}) & =6x\\end{aligned}\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}(1-\\operatorname{ln}⁡(2)\\,{2}^{y}) & =6x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{6x}{1-\\operatorname{ln}⁡(2)\\,{2}^{y}}\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290450 :knowledge-point/_questions [{:db/id #edb/ref 17592186129080 :knowledge-point/id #uuid "021e3349-c54d-55a8-9095-902bba933660" :knowledge-point/title "Applying the Pythagorean Theorem to the Unit Circle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "041bb980-2220-5c0f-b904-f70291dc858b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\sqrt{29}}{12}" :db/id #edb/ref 17592186288059} {:answer/id #uuid "1bcd216a-5d96-580d-89a1-1300b816ea9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\sqrt{29}}{12}" :db/id #edb/ref 17592186288211} {:answer/id #uuid "6428772c-31cb-5d11-ad40-b384b65de264" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\sqrt{23}}{12}" :db/id #edb/ref 17592186288738} {:answer/id #uuid "a6ab4c14-8b8f-5d7f-941d-c5430187106a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\sqrt{23}}{12}" :db/id #edb/ref 17592186289135} {:answer/id #uuid "b4335ae8-54ab-5f8c-98b6-6b1f10f60c80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{7\\sqrt{33}}{12}" :db/id #edb/ref 17592186289224}] :answer-field/correct {:answer/id #uuid "6428772c-31cb-5d11-ad40-b384b65de264" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\sqrt{23}}{12}" :db/id #edb/ref 17592186288738} :answer-field/id #uuid "94cc4b6d-4396-5dd4-a8e0-bcf717fb1b6e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290063}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "808fb241-7b41-5e43-96f3-08a62164f95c" :question/math-academy-id "q-23289" :question/problem "![](images/89/8904a5ebafade54a46cee77a2e20cac255c888d257ef1c208b2def32d247f2cd.png)\n\nThe point $P$ is located on the unit circle, as shown above. The $y$-coordinate of $P$ is $\\frac{11}{12}.$ What is the $x$-coordinate of $P?$" :question/worked-solution "Since the point $P$ lies on the unit circle, it must satisfy the Pythagorean theorem: \n\n$$\n{x}^{2}+{y}^{2}=1\n$$\n\nSubstituting $y=\\frac{11}{12}$ into the above and solving for $x$ gives\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =1 \\\\ {x}^{2}+{(\\frac{11}{12})}^{2} & =1 \\\\ {x}^{2}+(\\frac{121}{144}) & =1 \\\\ {x}^{2} & =1-\\frac{121}{144} \\\\ {x}^{2} & =\\frac{23}{144} \\\\ x & =\\pm \\sqrt{\\frac{23}{144}} \\\\ x & =\\pm \\frac{\\sqrt{23}}{12}.\\end{aligned}\n$$\n\nFinally, we select the negative answer since $x$ is negative in the second quadrant. So our final answer is $x=-\\frac{\\sqrt{23}}{12}.$"}] [{:db/id #edb/ref 17592186290461 :knowledge-point/_questions [{:db/id #edb/ref 17592186059651 :knowledge-point/id #uuid "23637774-8d69-500d-8cb0-5e41a0207542" :knowledge-point/title "Simplifying Rational Expressions Using an Alternate Form of the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "277373e3-169a-586e-ad29-c1c31afaae90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186288292} {:answer/id #uuid "6a095a67-ddbe-5bf7-9a39-f8782eff2ea0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{sin}^{2}⁡\\theta " :db/id #edb/ref 17592186288780} {:answer/id #uuid "94d134d0-8d56-5307-b137-977c53f49ff7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡\\theta " :db/id #edb/ref 17592186289029} {:answer/id #uuid "ae3d194e-cae3-5d1d-9ecd-a175924b168f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡\\theta " :db/id #edb/ref 17592186289186} {:answer/id #uuid "cc7343e7-6e46-504c-b190-873fccc910a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186289392}] :answer-field/correct {:answer/id #uuid "cc7343e7-6e46-504c-b190-873fccc910a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186289392} :answer-field/id #uuid "78b2f4eb-6782-5d0a-9ec1-3e356d9f2e48" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289993}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d60ea30f-16e8-5e44-938b-3986249a44fc" :question/math-academy-id "q-23526" :question/problem "$\\frac{1-2{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }+\\frac{{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }=$" :question/worked-solution "Since both fractions are over a common denominator, we can add them. This gives\n\n$$\n\\begin{aligned}\\frac{1-2{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }+\\frac{{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta } & =\\frac{1-2{cos}^{2}⁡\\theta +{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta } \\\\  & =\\frac{1-{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }.\\end{aligned}\n$$\n\nThen, we use ${cos}^{2}⁡\\theta =1-{sin}^{2}⁡\\theta $ to simplify the expression in the numerator:\n\n$$\n\\begin{aligned}\\frac{1-{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta } & =\\frac{{sin}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta } \\\\  & =\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{1-2{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }+\\frac{{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }=\\operatorname{sin}⁡\\theta .\n$$"}] [{:db/id #edb/ref 17592186290468 :knowledge-point/_questions [{:db/id #edb/ref 17592186110600 :knowledge-point/id #uuid "e732f270-1d6f-5ff8-8792-d9b329ea858d" :knowledge-point/title "Determining Whether Two Lines in Standard Form are Perpendicular"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b644ab2-4c21-5aeb-9032-26a79415192f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{3}" :db/id #edb/ref 17592186288444} {:answer/id #uuid "540e1587-3f3e-52a8-8424-5abf66ff30e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{3}x" :db/id #edb/ref 17592186288610} {:answer/id #uuid "70b1df14-3de9-50cb-8b16-2a2eec5b3954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3x" :db/id #edb/ref 17592186288816} {:answer/id #uuid "959ae715-31b5-5f44-931c-f40632872d6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-3x+1" :db/id #edb/ref 17592186289030} {:answer/id #uuid "c2d44e35-06ab-5ae0-8bfd-256c7f07808a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{3}x-3" :db/id #edb/ref 17592186289319}] :answer-field/correct {:answer/id #uuid "70b1df14-3de9-50cb-8b16-2a2eec5b3954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3x" :db/id #edb/ref 17592186288816} :answer-field/id #uuid "990087b9-37dc-5d9d-b34d-123762544320" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290071}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d4eec6d2-1c29-5a4c-9b34-ea67f65dce06" :question/math-academy-id "q-23621" :question/problem "Which of the following lines is perpendicular to $x+3y=6?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nTo find the slope of the given line $x+3y=6,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}x+3y & =6 \\\\ 3y & =-x+6 \\\\ y & =-\\frac{1}{3}x+2\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope of the given line is $-\\frac{1}{3}.$\n\nLooking at the answer choices, the line $y=3x$ has a slope of $3.$\n\nMultiplying the slopes together, we have\n\n$$\n(-\\frac{1}{3})\\cdot 3=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=3x$ is perpendicular to the given line."}] [{:db/id #edb/ref 17592186290470 :knowledge-point/_questions [{:db/id #edb/ref 17592186175924 :knowledge-point/id #uuid "c52fd5dd-780e-5dab-805f-561383873dd4" :knowledge-point/title "Finding the Equation of a Line Perpendicular to a Line in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b9cfaf6-9a1a-5e8a-ba94-ac0ace22d609" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-2y=-5" :db/id #edb/ref 17592186288209} {:answer/id #uuid "4b0ae802-61bf-59f5-8b33-d414ac86732a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+y=0" :db/id #edb/ref 17592186288552} {:answer/id #uuid "5a9e515d-8988-5114-8e78-b9e0df04aced" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+3y=1" :db/id #edb/ref 17592186288663} {:answer/id #uuid "6463122b-ca6b-5780-a23a-d3c73e619707" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-3y=-5" :db/id #edb/ref 17592186288741} {:answer/id #uuid "9a46eb07-3565-5f66-8f29-3f6a3b2e30be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x+2y=-1" :db/id #edb/ref 17592186289064}] :answer-field/correct {:answer/id #uuid "9a46eb07-3565-5f66-8f29-3f6a3b2e30be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x+2y=-1" :db/id #edb/ref 17592186289064} :answer-field/id #uuid "ec350e8b-707f-561e-b0a8-e7f213d56fbc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290223}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "96f3c704-d5cd-55de-a550-62294d23b6d6" :question/math-academy-id "q-23631" :question/problem "Find the equation of the line containing the point $(-1,1)$ that is perpendicular to $2x-3y=-5.$" :question/worked-solution "First, we write the equation $2x-3y=-5$ in its slope-intercept form, as follows:\n\n$$\n\\begin{aligned}2x-3y & =-5 \\\\ -3y & =-2x-5 \\\\ y & =\\frac{2}{3}x+\\frac{5}{3}\\end{aligned}\n$$\n\nSince perpendicular lines have slopes that are negative reciprocals of each other, the slope of the new line should be the negative reciprocal of the slope of the given line $y=\\frac{2}{3}x+\\frac{5}{3}.$ The given line has a slope of $\\frac{2}{3},$ so our perpendicular line must have a slope of $-\\frac{3}{2}.$\n\nOur perpendicular line must have the slope $m=-\\frac{3}{2}$ and pass through the point $({x}_{1},{y}_{1})=(-1,1).$ Using point-slope form and simplifying, we obtain the equation of the line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =-\\frac{3}{2}(x-(-1)) \\\\ y-1 & =-\\frac{3}{2}(x+1) \\\\ y-1 & =-\\frac{3}{2}x-\\frac{3}{2} \\\\ y & =-\\frac{3}{2}x-\\frac{1}{2} \\\\ 2y & =-3x-1 \\\\ 3x+2y & =-1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290475 :knowledge-point/_questions [{:db/id #edb/ref 17592186129123 :knowledge-point/id #uuid "933b20c7-323f-5443-9cf4-97e87fa2c6fc" :knowledge-point/title "Finding the Midline of a Transformed Sinusoidal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b0d2e17-b1cc-53d6-a590-29ca48abe4d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2" :db/id #edb/ref 17592186288441} {:answer/id #uuid "4a00572c-39f3-51f2-908d-92627f661500" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-4" :db/id #edb/ref 17592186288544} {:answer/id #uuid "a37b2fb0-553a-530f-99ca-b90f84cdee3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-7" :db/id #edb/ref 17592186289123} {:answer/id #uuid "ab1273fc-bf67-57d2-a722-130587889698" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3" :db/id #edb/ref 17592186289164} {:answer/id #uuid "f95f3f20-7128-592d-a073-380a9759c7df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186289672}] :answer-field/correct {:answer/id #uuid "3b0d2e17-b1cc-53d6-a590-29ca48abe4d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2" :db/id #edb/ref 17592186288441} :answer-field/id #uuid "246102b7-25b3-5a75-9c7c-581da5239b11" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289815}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "250619d1-370b-5c0d-af5b-ed64a801198a" :question/math-academy-id "q-236893" :question/problem "Find the equation of the midline for a transformed sine function with a minimum value of $-7$ and a maximum value of $3.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{-7+3}{2} \\\\  & =\\frac{-4}{2} \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, the midline is $y=-2.$"}] [{:db/id #edb/ref 17592186129562 :knowledge-point/_questions [{:db/id #edb/ref 17592186129123 :knowledge-point/id #uuid "933b20c7-323f-5443-9cf4-97e87fa2c6fc" :knowledge-point/title "Finding the Midline of a Transformed Sinusoidal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ffe8c2d-22ae-5a74-9fb5-b44fdb8cce26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=7" :db/id #edb/ref 17592186288150} {:answer/id #uuid "3f9156c5-37a7-56f3-b8d3-991ed27e42a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=9" :db/id #edb/ref 17592186288465} {:answer/id #uuid "90eda464-9558-5e5e-b442-f50682de504d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186289005} {:answer/id #uuid "d650ff67-6889-5b78-bc90-d9ce4271c33c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-4" :db/id #edb/ref 17592186289456} {:answer/id #uuid "d7360b5c-2ef2-52b6-a3be-6f516c9b4151" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-5" :db/id #edb/ref 17592186289463}] :answer-field/correct {:answer/id #uuid "90eda464-9558-5e5e-b442-f50682de504d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186289005} :answer-field/id #uuid "b0fa4e38-53cb-50b5-ba34-1bae28b400d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290121}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "723b13df-bde4-592d-ade7-17cdd1dad568" :question/math-academy-id "q-236896" :question/problem "Find the equation of the midline for a transformed cosine function with a minimum value of $-5$ and a maximum value of $9.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{-5+9}{2} \\\\  & =\\frac{4}{2} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, the midline is $y=2.$"}] [{:db/id #edb/ref 17592186290478 :knowledge-point/_questions [{:db/id #edb/ref 17592186203962 :knowledge-point/id #uuid "37ff20d1-fa3d-50aa-90d1-7bcb848ee460" :knowledge-point/title "Maxima of Transformed Sine or Cosine Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a4385b2-cedb-5f97-84c3-917a017432a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={60}^{∘}+{180}^{∘}\\cdot n" :db/id #edb/ref 17592186288112} {:answer/id #uuid "1c9f0461-9e12-5816-9c05-6b4fa234ef57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={60}^{∘}+{120}^{∘}\\cdot n" :db/id #edb/ref 17592186288216} {:answer/id #uuid "58d0b77c-504d-574d-966c-005ac0e0d6f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={30}^{∘}+{120}^{∘}\\cdot n" :db/id #edb/ref 17592186288652} {:answer/id #uuid "5f9bb498-f6e5-5039-b259-d917d5660a03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={90}^{∘}+{120}^{∘}\\cdot n" :db/id #edb/ref 17592186288699} {:answer/id #uuid "f4bd4a4b-0690-5bdb-96fa-3576eebd5a61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={90}^{∘}+{360}^{∘}\\cdot n" :db/id #edb/ref 17592186289646}] :answer-field/correct {:answer/id #uuid "58d0b77c-504d-574d-966c-005ac0e0d6f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={30}^{∘}+{120}^{∘}\\cdot n" :db/id #edb/ref 17592186288652} :answer-field/id #uuid "057f72f3-32e2-5bf8-9e0a-6bb801c5adf3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289739}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7caa2144-9fd2-5d73-bd9e-432e5c2fb4d1" :question/math-academy-id "q-236971" :question/problem "Consider the function $f(x)=\\frac{2}{3}\\operatorname{sin}⁡(3x).$ Which expression gives all of the values of $x$ at which $f(x)$ attains its maximum value? Assume that $n$ is an integer." :question/worked-solution "First, let's start by defining a new variable $X$ as\n\n$$\nX=3x.\n$$\n\nSo, we need to calculate $X$-values at the maxima of\n\n$$\ny=\\frac{2}{3}\\operatorname{sin}⁡X.\n$$\n\n \n\nThe $X$-values at the maxima are given by the following expression:\n\n$$\nX={90}^{∘}+{360}^{∘}\\cdot n\n$$\n\nwhere $n$ is an integer.\n\nTo find the $x$-values at the maxima of our original function, we rewrite $X$ in terms of the original variable $x$ and solve the resulting equation for $x:$\n\n$$\n\\begin{aligned}X & ={90}^{∘}+{360}^{∘}\\cdot n \\\\ 3x & ={90}^{∘}+{360}^{∘}\\cdot n \\\\ x & ={30}^{∘}+{120}^{∘}\\cdot n\\end{aligned}\n$$\n\nWe conclude that the values of $x$ that maximize $f(x)$ are given by $x={30}^{∘}+{120}^{∘}\\cdot n,$ where $n$ is an integer."}] [{:db/id #edb/ref 17592186290519 :knowledge-point/_questions [{:db/id #edb/ref 17592186096845 :knowledge-point/id #uuid "1c269944-636a-50f2-bfc9-c32a7b2e7ca3" :knowledge-point/title "Calculating a Derivative Using the Chain and Product Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38e395c8-f565-5740-959d-6bf0c34f8710" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{3x}({sec}^{2}⁡x+3\\operatorname{ln}⁡a\\operatorname{tan}⁡x)" :db/id #edb/ref 17592186288420} {:answer/id #uuid "47d8a58a-8445-5585-bc47-18b1d4683989" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{3x}({sec}^{2}⁡x+3\\operatorname{tan}⁡x)" :db/id #edb/ref 17592186288526} {:answer/id #uuid "60da0eec-e09f-556c-977c-0afa9bca8118" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{3x}{sec}^{2}⁡x+3\\operatorname{tan}⁡x" :db/id #edb/ref 17592186288710} {:answer/id #uuid "9efacfe8-4ef9-586f-935e-d85e18391332" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{a}^{3x}({sec}^{2}⁡x+\\operatorname{ln}⁡a\\operatorname{tan}⁡x)" :db/id #edb/ref 17592186289098} {:answer/id #uuid "d7f42cff-705d-5052-8de2-d67ef0b14a77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{sec}^{2}⁡x+3{a}^{3x}\\operatorname{tan}⁡x" :db/id #edb/ref 17592186289468}] :answer-field/correct {:answer/id #uuid "38e395c8-f565-5740-959d-6bf0c34f8710" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{3x}({sec}^{2}⁡x+3\\operatorname{ln}⁡a\\operatorname{tan}⁡x)" :db/id #edb/ref 17592186288420} :answer-field/id #uuid "84733a66-1c91-5acb-9908-573c1e35d199" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290021}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d4cb91b7-6460-5845-ba44-f35610f01889" :question/math-academy-id "q-2392" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y={a}^{3x}\\operatorname{tan}⁡x.$" :question/worked-solution "This question requires the product rule. Let $u(x)=\\operatorname{tan}⁡x$ and $v(x)={a}^{3x}.$ Then\n\n$$\n{u}^{′}(x)={sec}^{2}⁡x,\\,{v}^{′}(x)=3{a}^{3x}\\operatorname{ln}⁡a.\n$$\n\nNote that we used the chain rule to differentiate $v.$\n\nNow, applying the product rule and simplifying, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =({sec}^{2}⁡x)({a}^{3x})+(\\operatorname{tan}⁡x)(3{a}^{3x}\\operatorname{ln}⁡a) \\\\  & ={a}^{3x}({sec}^{2}⁡x+3\\operatorname{ln}⁡a\\operatorname{tan}⁡x).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290543 :knowledge-point/_questions [{:db/id #edb/ref 17592186179789 :knowledge-point/id #uuid "2dc9469a-e2ca-55ba-b05a-b0be37384f9e" :knowledge-point/title "Finding Solutions of Exponential Equations Using the Natural Logarithm: Advanced Cases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dcd191d-3785-54a0-a639-e0094f61d3df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(8)" :db/id #edb/ref 17592186288129} {:answer/id #uuid "6905831a-aab1-5aa6-90c9-108a514050cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{ln}⁡(3)+\\operatorname{ln}⁡(8)}{\\operatorname{ln}⁡(3)-\\operatorname{ln}⁡(8)}" :db/id #edb/ref 17592186288770} {:answer/id #uuid "78f720c7-027b-52c2-b6ef-5787c36db04a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2(\\operatorname{ln}⁡(3)+3\\operatorname{ln}⁡(8))}" :db/id #edb/ref 17592186288863} {:answer/id #uuid "978813b7-39da-53a5-9479-68b97e87dbf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡(8)}{2(\\operatorname{ln}⁡(3)+3\\operatorname{ln}⁡(8))}" :db/id #edb/ref 17592186289046} {:answer/id #uuid "9bb5517e-f727-547d-b85c-617c8b602edd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡(3)+\\operatorname{ln}⁡(8)" :db/id #edb/ref 17592186289079}] :answer-field/correct {:answer/id #uuid "978813b7-39da-53a5-9479-68b97e87dbf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡(8)}{2(\\operatorname{ln}⁡(3)+3\\operatorname{ln}⁡(8))}" :db/id #edb/ref 17592186289046} :answer-field/id #uuid "5c40079c-8840-5be3-8c8b-803492714f39" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289927}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "399f64e6-0f82-5ca3-861d-fbe99de11ba6" :question/math-academy-id "q-242923" :question/problem "Find the solution of ${3}^{2x}={8}^{1-6x}.$" :question/worked-solution "First, we take the natural logarithm $(ln)$ of both sides of the equation:\n\n$$\n\\begin{aligned}{3}^{2x} & ={8}^{1-6x} \\\\ \\operatorname{ln}⁡({3}^{2x}) & =\\operatorname{ln}⁡({8}^{1-6x})\\end{aligned}\n$$\n\nNow, we use the power law of logarithms to simplify both sides of the equation. This gives:\n\n$$\n\\begin{aligned}2x\\operatorname{ln}⁡(3) & =(1-6x)\\operatorname{ln}⁡(8)\\end{aligned}\n$$\n\nFinally, we solve for $x$, as follows:\n\n$$\n\\begin{aligned}2x\\operatorname{ln}⁡(3) & =(1-6x)\\operatorname{ln}⁡(8) \\\\ 2x\\operatorname{ln}⁡(3) & =\\operatorname{ln}⁡(8)-6x\\operatorname{ln}⁡(8) \\\\ 2x\\operatorname{ln}⁡(3)+6x\\operatorname{ln}⁡(8) & =\\operatorname{ln}⁡(8) \\\\ 2x(\\operatorname{ln}⁡(3)+3\\operatorname{ln}⁡(8)) & =\\operatorname{ln}⁡(8) \\\\ x & =\\frac{\\operatorname{ln}⁡(8)}{2(\\operatorname{ln}⁡(3)+3\\operatorname{ln}⁡(8))}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290546 :knowledge-point/_questions [{:db/id #edb/ref 17592186087670 :knowledge-point/id #uuid "12ff17ae-9319-5498-a5e0-1d49ddbef50a" :knowledge-point/title "Using Alternative Forms of Double-Angle Formula to Simplify Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c6c484f-0d4c-5059-abdc-0a5388322664" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{\\pi }{10})" :db/id #edb/ref 17592186288449} {:answer/id #uuid "905767c2-2f4f-53cd-a805-da5f17ade7e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡(\\frac{\\pi }{5})" :db/id #edb/ref 17592186288998} {:answer/id #uuid "a2d3b909-fd08-568d-a4fd-3a367cf58a52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{2\\pi }{5})" :db/id #edb/ref 17592186289118} {:answer/id #uuid "b27cd6d7-da62-5d7b-84c9-e5730cb22b5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{4\\pi }{5})" :db/id #edb/ref 17592186289211} {:answer/id #uuid "e1c5c2bc-0b3f-5d28-8a4b-51fdecf0f8b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡(\\frac{\\pi }{10})" :db/id #edb/ref 17592186289536}] :answer-field/correct {:answer/id #uuid "a2d3b909-fd08-568d-a4fd-3a367cf58a52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{2\\pi }{5})" :db/id #edb/ref 17592186289118} :answer-field/id #uuid "f665bcbb-88dc-5ad6-8703-67a0c36bad75" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290240}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a509f6a5-78b4-503c-a592-ded49f6e4644" :question/math-academy-id "q-24341" :question/problem "Express $1-2{sin}^{2}⁡(\\frac{\\pi }{5})$ as a single trigonometric ratio." :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n1-2{sin}^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{5}$ into the above, we get\n\n$$\n\\begin{aligned}1-2{sin}^{2}⁡(\\frac{\\pi }{5}) & =\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{5}) \\\\  & =\\operatorname{cos}⁡(\\frac{2\\pi }{5}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290548 :knowledge-point/_questions [{:db/id #edb/ref 17592186078386 :knowledge-point/id #uuid "dff5ec0b-1456-5231-94e1-0fc5923d6672" :knowledge-point/title "Determining a Rate of Change for a Given Function at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5fe34d4f-b1fc-5ae0-9d55-04367e3e3a49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7$ pounds per year" :db/id #edb/ref 17592186288703} {:answer/id #uuid "8837d663-da3e-54d6-ad9e-b7fbd44fd2ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ pounds per year" :db/id #edb/ref 17592186288950} {:answer/id #uuid "b1646ebc-8eb5-5ea1-9807-4559284424b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ pounds per year" :db/id #edb/ref 17592186289205} {:answer/id #uuid "bf59944a-828b-52d4-8152-acc3370d61a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ pounds per year" :db/id #edb/ref 17592186289294} {:answer/id #uuid "da9443d8-9b09-5781-bcc9-9bb6ff7ade2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$15$ pounds per year" :db/id #edb/ref 17592186289489}] :answer-field/correct {:answer/id #uuid "b1646ebc-8eb5-5ea1-9807-4559284424b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ pounds per year" :db/id #edb/ref 17592186289205} :answer-field/id #uuid "4197b5aa-e931-53da-b252-0e4b8f548ea2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289879}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "89c5ed41-56cc-572f-ab21-6b6ef12532fd" :question/math-academy-id "q-2439" :question/problem "The weight $w,$ in pounds, of a baby gorilla $t$ years after birth can be modeled by the function $w(t)=4{t}^{3}-{t}^{2}+15.$ What is the instantaneous rate of change of his weight when $t=1$ year?" :question/worked-solution "The instantaneous rate of change of weight when $t=1$ year is equal to ${w}^{′}(1).$\n\nFirst, we take the derivative and get\n\n$$\n\\begin{aligned}{w}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(4{t}^{3}-{t}^{2}+15) \\\\  & =12{t}^{2}-2t.\\end{aligned}\n$$\n\nNow, substituting $t=1,$ we get\n\n$$\n\\begin{aligned}{w}^{′}(1) & =12(1)^{2}-2(1) \\\\  & =12-2 \\\\  & =10.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate change of the weight when $t=1$ year is $10$ pounds per year."}] [{:db/id #edb/ref 17592186290550 :knowledge-point/_questions [{:db/id #edb/ref 17592186087669 :knowledge-point/id #uuid "5ec37c5e-8a40-58a7-8af3-4457cd5da43f" :knowledge-point/title "Using the Double-Angle Formula to Simplify Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43eca4f5-7e71-5c4d-b3d7-7641c44eb318" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{\\pi }{5})" :db/id #edb/ref 17592186288495} {:answer/id #uuid "492ca887-fe22-579a-b5cb-0f29cfad327c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{6\\pi }{5})" :db/id #edb/ref 17592186288539} {:answer/id #uuid "93678e0d-634c-5d71-b943-62299e286df9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{3\\pi }{5})" :db/id #edb/ref 17592186289019} {:answer/id #uuid "c7df7cd8-b50b-55b6-b605-e2f558905842" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{2\\pi }{5})" :db/id #edb/ref 17592186289355} {:answer/id #uuid "c878a2ea-30a4-57ca-8bad-92bcefc1de12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{4\\pi }{5})" :db/id #edb/ref 17592186289360}] :answer-field/correct {:answer/id #uuid "492ca887-fe22-579a-b5cb-0f29cfad327c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{6\\pi }{5})" :db/id #edb/ref 17592186288539} :answer-field/id #uuid "44b91e88-c247-552d-ac22-5e6fb9335e1a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289882}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ccbcdf42-d0d6-5ef1-b1a3-dd2467d078f8" :question/math-academy-id "q-24499" :question/problem "Express ${cos}^{2}⁡(\\frac{3\\pi }{5})-{sin}^{2}⁡(\\frac{3\\pi }{5})$ as a single trigonometric ratio." :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n{cos}^{2}⁡x-{sin}^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x=(\\frac{3\\pi }{5})$ into the above, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡(\\frac{3\\pi }{5})-{sin}^{2}⁡(\\frac{3\\pi }{5}) & =\\operatorname{cos}⁡(2\\cdot \\frac{3\\pi }{5}) \\\\  & =\\operatorname{cos}⁡(\\frac{6\\pi }{5}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186088096 :knowledge-point/_questions [{:db/id #edb/ref 17592186087671 :knowledge-point/id #uuid "2902b205-4508-55c6-9a68-f57d3afc9eab" :knowledge-point/title "Finding Exact Values of Trigonometric Expressions Using the Double-Angle Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0043b9dd-acd7-5722-ae3f-3f717ea8f717" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186288026} {:answer/id #uuid "0fcd1b2f-6684-5235-9ad9-1439089c5d1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186288147} {:answer/id #uuid "2e93b461-8b28-554d-a5d3-b0197fe38c18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186288346} {:answer/id #uuid "38664848-58db-58e9-955b-e673ca767957" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{3}" :db/id #edb/ref 17592186288415} {:answer/id #uuid "679b2481-2702-5446-9e64-41947ec19124" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186288759}] :answer-field/correct {:answer/id #uuid "679b2481-2702-5446-9e64-41947ec19124" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186288759} :answer-field/id #uuid "0e2b6c24-7b3b-5d04-808b-ab04891dc6ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289763}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "baeab088-833a-54f7-96df-e4a2e1a80c83" :question/math-academy-id "q-24514" :question/problem "Find the exact value of ${cos}^{2}⁡(\\frac{\\pi }{12})-{sin}^{2}⁡(\\frac{\\pi }{12}).$" :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n{cos}^{2}⁡x-{sin}^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{12}$ into the above, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡(\\frac{\\pi }{12})-{sin}^{2}⁡(\\frac{\\pi }{12}) & =\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{12}) \\\\  & =\\operatorname{cos}⁡(\\frac{\\pi }{6}) \\\\  & =\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290559 :knowledge-point/_questions [{:db/id #edb/ref 17592186059672 :knowledge-point/id #uuid "d820aa9f-7c02-53b5-9b09-c25ee59dbdaf" :knowledge-point/title "Using the Double-Angle Formula Multiple Times"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "250cdf52-80dd-5fc2-af4b-70ef347a1cea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{\\pi }{4})" :db/id #edb/ref 17592186288273} {:answer/id #uuid "3fd9b186-aadf-56c5-aa56-1a4655188af6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{\\pi }{2})" :db/id #edb/ref 17592186288467} {:answer/id #uuid "aa4e972a-a6ae-5ee9-939d-472e588fddcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡(\\frac{\\pi }{2})" :db/id #edb/ref 17592186289160} {:answer/id #uuid "dd44e3ed-170a-5c64-abc8-da906810e3b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sin}⁡(\\frac{\\pi }{4})" :db/id #edb/ref 17592186289505} {:answer/id #uuid "e97836dd-63c8-53a9-9a9c-9ddec55ceab1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sin}⁡(\\frac{\\pi }{2})" :db/id #edb/ref 17592186289583}] :answer-field/correct {:answer/id #uuid "3fd9b186-aadf-56c5-aa56-1a4655188af6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{\\pi }{2})" :db/id #edb/ref 17592186288467} :answer-field/id #uuid "dd8d3d20-451b-5d5a-b8e5-ba16d376b2a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290201}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4270d786-b50e-5319-88f8-bca386712273" :question/math-academy-id "q-24645" :question/problem "$4\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{4})=$" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{8}$ into the above, we get\n\n$$\n2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8})=\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{8})\n$$\n\nwhich simplifies as\n\n$$\n2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8})=\\operatorname{sin}⁡(\\frac{\\pi }{4}).\n$$\n\nNow, we can rewrite the given expression using the above, as follows:\n\n$$\n\\begin{aligned}4\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{4}) & =2[2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8})]\\operatorname{cos}⁡(\\frac{\\pi }{4}) \\\\  & =2\\operatorname{sin}⁡(\\frac{\\pi }{4})\\operatorname{cos}⁡(\\frac{\\pi }{4})\\end{aligned}\n$$\n\nNow, using the double-angle formula once more with $x=\\frac{\\pi }{4}$, we can further simplify the above expression: \n\n$$\n\\begin{aligned}4\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{4}) & =2\\operatorname{sin}⁡(\\frac{\\pi }{4})\\operatorname{cos}⁡(\\frac{\\pi }{4}) \\\\  & =\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{4}) \\\\  & =\\operatorname{sin}⁡(\\frac{\\pi }{2})\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290560 :knowledge-point/_questions [{:db/id #edb/ref 17592186059671 :knowledge-point/id #uuid "143766e0-0ef5-5caf-b699-d394d4a707e9" :knowledge-point/title "Using the Double-Angle Formula to Simplify Products"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c357368-fcee-57c4-bf91-a6420fe440cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{\\pi }{3})" :db/id #edb/ref 17592186288213} {:answer/id #uuid "27f10174-6b5a-51a5-a3ff-b27f66395464" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{sin}⁡(\\frac{\\pi }{6})" :db/id #edb/ref 17592186288298} {:answer/id #uuid "853e171a-cb9a-5680-8257-0e827c783b56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{sin}⁡(\\frac{\\pi }{3})" :db/id #edb/ref 17592186288930} {:answer/id #uuid "cc2b8d46-c755-5546-ae37-7ed12f4842f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡(\\frac{\\pi }{3})" :db/id #edb/ref 17592186289390} {:answer/id #uuid "e5710b37-6161-53d9-9349-b0d8e0d217e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sin}⁡(\\frac{\\pi }{6})" :db/id #edb/ref 17592186289552}] :answer-field/correct {:answer/id #uuid "cc2b8d46-c755-5546-ae37-7ed12f4842f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡(\\frac{\\pi }{3})" :db/id #edb/ref 17592186289390} :answer-field/id #uuid "f984848b-f15f-5efc-b09a-0122e1e107ed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290247}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "feecaade-207a-51bf-96ee-61bce1de2e85" :question/math-academy-id "q-24647" :question/problem "Express $4\\operatorname{sin}⁡(\\frac{\\pi }{6})\\operatorname{cos}⁡(\\frac{\\pi }{6})$ as a single trigonometric ratio." :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{6}$ into the above, we get\n\n$$\n2\\operatorname{sin}⁡(\\frac{\\pi }{6})\\operatorname{cos}⁡(\\frac{\\pi }{6})=\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{6})=\\operatorname{sin}⁡(\\frac{\\pi }{3}).\n$$\n\nTherefore,\n\n$$\n4\\operatorname{sin}⁡(\\frac{\\pi }{6})\\operatorname{cos}⁡(\\frac{\\pi }{6})=2\\cdot 2\\operatorname{sin}⁡(\\frac{\\pi }{6})\\operatorname{cos}⁡(\\frac{\\pi }{6})=2\\operatorname{sin}⁡(\\frac{\\pi }{3}).\n$$"}] [{:db/id #edb/ref 17592186292541 :knowledge-point/_questions [{:db/id #edb/ref 17592186175924 :knowledge-point/id #uuid "c52fd5dd-780e-5dab-805f-561383873dd4" :knowledge-point/title "Finding the Equation of a Line Perpendicular to a Line in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "222e0bdd-c45c-5f9b-ae54-71cdb6646a9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-y=2" :db/id #edb/ref 17592186290780} {:answer/id #uuid "93fc4b47-47c7-5ebf-9229-bb1de3d6fc45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+5y=26" :db/id #edb/ref 17592186291272} {:answer/id #uuid "96366abc-617a-5664-be0a-124e181d78a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+y=10" :db/id #edb/ref 17592186291284} {:answer/id #uuid "d0dd3655-249b-55c7-ad7e-aa78ebaf2966" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+2y=11" :db/id #edb/ref 17592186291519} {:answer/id #uuid "d8c2f176-99d3-5c0e-91c7-0a77ab6cde83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+4y=19" :db/id #edb/ref 17592186291538}] :answer-field/correct {:answer/id #uuid "d0dd3655-249b-55c7-ad7e-aa78ebaf2966" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+2y=11" :db/id #edb/ref 17592186291519} :answer-field/id #uuid "f929ad97-39dd-50e0-b2f2-34f577615f96" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292514}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9bf24f67-6184-5bd5-8b16-92247aa73ac4" :question/math-academy-id "q-252524" :question/problem "Find the equation of the line that passes through the point $(3,4)$ and is perpendicular to the line passing through the points $(2,2)$ and $(5,8).$" :question/worked-solution "Perpendicular lines have slopes, which are negative reciprocals of each other.\n\nFirst, let's find the slope ${m}_{1}$ of the line passing through the points $(2,2)$ and $(5,8):$\n\n$$\n\\begin{aligned}{m}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{8-2}{5-2} \\\\  & =\\frac{6}{3} \\\\  & =2\\end{aligned}\n$$\n\nSince we want a perpendicular line, the slope $m$ of the line we're trying to find must satisfy\n\n$$\nm\\cdot (2)=-1\\,⇒\\,m=-\\frac{1}{2}.\n$$\n\nWe know that the line passes through the point $(3,4).$ Using point-slope form and simplifying, we obtain the equation of the line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-4 & =-\\frac{1}{2}(x-3) \\\\ 2(y-4) & =-(x-3) \\\\ 2y-8 & =-x+3 \\\\ 2y & =-x+11 \\\\ y & =-\\frac{1}{2}x+\\frac{11}{2}\\end{aligned}\n$$\n\nHowever, we want to write the equation in standard form. So, we will bring the $x$ term to the left-hand side and multiply both sides of the equation by $2:$\n\n$$\n\\begin{aligned}y & =-\\frac{1}{2}x+\\frac{11}{2} \\\\ \\frac{1}{2}x+y & =\\frac{11}{2} \\\\ 2\\cdot (\\frac{1}{2}x+y) & =2\\cdot \\frac{11}{2} \\\\ x+2y & =11\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292608 :knowledge-point/_questions [{:db/id #edb/ref 17592186129102 :knowledge-point/id #uuid "bd6703d2-36f6-5665-90e3-f75aea5f663b" :knowledge-point/title "Finding a General Expression for the Domain of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0247856b-a519-56dd-a2b1-a1b70c9b2dd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{6}+\\frac{n\\pi }{3}" :db/id #edb/ref 17592186290651} {:answer/id #uuid "6880d187-a9df-5074-bc5d-223d72e1916c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{6}+\\frac{n\\pi }{2}" :db/id #edb/ref 17592186291077} {:answer/id #uuid "d2246bcc-e2cc-5d62-bed2-bbaf586f4fa8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{8}+\\frac{n\\pi }{2}" :db/id #edb/ref 17592186291520} {:answer/id #uuid "de5d79b6-0b6d-56b2-b4b8-34d1931786d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{8}+n\\pi " :db/id #edb/ref 17592186291565} {:answer/id #uuid "e45c748f-05b7-55c6-9a75-1f27a3900067" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{4}+\\frac{n\\pi }{2}" :db/id #edb/ref 17592186291587}] :answer-field/correct {:answer/id #uuid "e45c748f-05b7-55c6-9a75-1f27a3900067" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{4}+\\frac{n\\pi }{2}" :db/id #edb/ref 17592186291587} :answer-field/id #uuid "7482ef83-edf6-558f-8523-f7d7648ec139" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292094}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6007df97-7592-55f0-9719-8190411bf59a" :question/math-academy-id "q-26063" :question/problem "What is the domain of the function $f(x)=\\operatorname{tan}⁡(2x)?$  Assume that $n$ is an integer." :question/worked-solution "The domain of $y=\\operatorname{tan}⁡x$ is given by\n\n$$\nx\\ne \\frac{\\pi }{2}+n\\pi ,\n$$\n\nwhere $n$ is an integer.\n\nTo find the domain of $\\operatorname{tan}⁡(2x),$ we replace the $x$ on the left-hand side of the above with $(2x).$ This gives\n\n$$\n2x\\ne \\frac{\\pi }{2}+n\\pi .\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}2x & \\ne \\frac{\\pi }{2}+n\\pi  \\\\ x & \\ne \\frac{\\pi }{2\\cdot 2}+\\frac{n\\pi }{2} \\\\ x & \\ne \\frac{\\pi }{4}+\\frac{n\\pi }{2}.\\end{aligned}\n$$\n\nTherefore, the domain of the function is $x\\ne \\frac{\\pi }{4}+\\frac{n\\pi }{2},$ where $n$ is an integer."}] [{:db/id #edb/ref 17592186292609 :knowledge-point/_questions [{:db/id #edb/ref 17592186096636 :knowledge-point/id #uuid "90455606-1080-552e-a825-0cc7054b4be3" :knowledge-point/title "Solving a System Containing Fractions in One Equation Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83f90f5e-a59d-5dbb-b7bc-2235614d11e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=4,\\,y=4" :db/id #edb/ref 17592186291191} {:answer/id #uuid "88278ddc-f2aa-572e-bfa1-75529cee7a88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-4,\\,y=6" :db/id #edb/ref 17592186291213} {:answer/id #uuid "8b6b2395-ed33-5ae6-ab41-6b9f005b95ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2,\\,y=2" :db/id #edb/ref 17592186291224} {:answer/id #uuid "a00f19d2-18a2-58fa-85b9-7734b7ab495a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-3,\\,y=3" :db/id #edb/ref 17592186291328} {:answer/id #uuid "ae7b1a51-3e08-5e97-9ce6-48f66f412876" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=3,\\,y=-15" :db/id #edb/ref 17592186291389}] :answer-field/correct {:answer/id #uuid "a00f19d2-18a2-58fa-85b9-7734b7ab495a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-3,\\,y=3" :db/id #edb/ref 17592186291328} :answer-field/id #uuid "64524a94-87ea-54e7-b6ab-78b313a3c370" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292039}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "35a25c61-ba3b-5b21-8d90-ee3bc07b7267" :question/math-academy-id "q-26094" :question/problem "Find the solution to the following system of equations.\n\n$$\n{\\begin{aligned}\\frac{x}{6}+\\frac{5y}{6}-2=0 \\\\ 3x+y+6=0\\end{aligned}\n$$" :question/worked-solution "To get rid of the fractions in the first equation, we must multiply the first equation by the lowest common denominator of the fractions, which is $6.$\n\n$$\n{\\begin{aligned}\\frac{x}{6}+\\frac{5y}{6}-2=0 & |\\,\\times 6 \\\\ 3x+y+6=0\\end{aligned}\\,⟹\\,{\\begin{aligned}x+5y-12=0 \\\\ 3x+y+6=0\\end{aligned}\n$$\n\nWe will use the substitution method to solve the system. Notice that the second equation can easily be solved for $y:$\n\n$$\n\\begin{aligned}3x+y+6 & =0 \\\\ y & =-3x-6\\end{aligned}\n$$\n\nWe substitute $y=-3x-6$ into the first equation and then solve for $x:$\n\n$$\n\\begin{aligned}x+5y-12 & =0 \\\\ x+5(-3x-6)-12 & =0 \\\\ x-15x-30-12 & =0 \\\\ -14x-42 & =0 \\\\ -14x & =42 \\\\ x & =-3\\end{aligned}\n$$\n\nFinally, to find the value of $y,$ we substitute $x=-3$ into the equation $y=-3x-6$ as follows:\n\n$$\n\\begin{aligned}y & =-3x-6 \\\\  & =-3(-3)-6 \\\\  & =9-6 \\\\  & =3\\end{aligned}\n$$\n\nThus, the solution to the system of equations is $x=-3,\\,y=3.$"}] [{:db/id #edb/ref 17592186401908 :knowledge-point/_questions [{:db/id #edb/ref 17592186096785 :knowledge-point/id #uuid "cc62d8df-450f-5f7a-b647-b53c051f8339" :knowledge-point/title "Solving a System Containing Decimals in Both Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c29c57bf-e265-52a1-bca7-e9f5dad2f3f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=\\frac{4}{3},$ $y=-2$" :db/id #edb/ref 17592186401910} {:answer/id #uuid "211a2e7b-9745-58a0-94ae-5560db869797" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=1,$ $y=-3$" :db/id #edb/ref 17592186401911} {:answer/id #uuid "862aa3fb-5e83-5622-8209-8caba2d722df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=\\frac{7}{3},$ $y=1$" :db/id #edb/ref 17592186401912} {:answer/id #uuid "30d0a7a2-ddd3-5355-ab33-3b6c7d057ae2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=2,$ $y=0$" :db/id #edb/ref 17592186401913} {:answer/id #uuid "0284c37f-87d7-5181-9665-5eb50a2bc860" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=\\frac{5}{3},$ $y=-1$" :db/id #edb/ref 17592186401914}] :answer-field/correct {:answer/id #uuid "0284c37f-87d7-5181-9665-5eb50a2bc860" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=\\frac{5}{3},$ $y=-1$" :db/id #edb/ref 17592186401914} :answer-field/id #uuid "e422abe5-7836-5aa6-bfb2-34896476a4d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401909}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3d7c59ff-df86-5863-a05a-c20fb84b2ead" :question/math-academy-id "q-26223" :question/problem "Solve the following system of equations:\n\n$$\n{\\begin{aligned}0.3x-0.1y=0.6 \\\\ 0.6x+0.8y=0.2\\end{aligned}\n$$" :question/worked-solution "To get rid of the decimals, we multiply both equations by $10,$ as follows:\n\n$$\n{\\begin{aligned}0.3x-0.1y=0.6 & |\\,\\times 10 \\\\ 0.6x+0.8y=0.2 & |\\,\\times 10\\end{aligned}\\,⟹\\,{\\begin{aligned}3x-y=6 \\\\ 6x+8y=2\\end{aligned}\n$$\n\nNotice that if we divide the second equation by $(-2),$ we will get a $-3x$ term in the second equation that can cancel with the $3x$ term in the first equation:\n\n$$\n{\\begin{aligned}3x-y=6 &  \\\\ 6x+8y=2 & |\\,÷(-2)\\end{aligned}\\,⟹\\,{\\begin{aligned}3x-y=6 \\\\ -3x-4y=-1\\end{aligned}\n$$\n\nAdding the two equations eliminates the $x$-variable and allows us to solve for $y:$\n\n$$\n\\begin{aligned}\\cancel{3x}-y & =6 \\\\ -\\cancel{3x}-4y & =-1 \\\\ (-y-4y) & =(6-1) \\\\ -5y & =5 \\\\ y & =-1\\end{aligned}\n$$\n\nFinally, we can substitute $y=-1$ into the equation $3x-y=6$ to solve for $x:$\n\n$$\n\\begin{aligned}3x-y & =6 \\\\ 3x-(-1) & =6 \\\\ 3x & =5 \\\\ x & =\\frac{5}{3}\\end{aligned}\n$$\n\nThus, the solution to the system of equations is $x=\\frac{5}{3}$ and $y=-1.$"}] [{:db/id #edb/ref 17592186292646 :knowledge-point/_questions [{:db/id #edb/ref 17592186179787 :knowledge-point/id #uuid "7e37891e-d24f-53cd-ba74-d887fa99aa3b" :knowledge-point/title "Finding Exact Solutions of Exponential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47fe5df5-7916-5060-8fbe-5ad8b202e09b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{1+2\\operatorname{log}⁡(7)}" :db/id #edb/ref 17592186290928} {:answer/id #uuid "6566b744-0a39-5a79-adc4-eb963875b944" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{1-\\operatorname{log}⁡(7)}" :db/id #edb/ref 17592186291063} {:answer/id #uuid "84375010-b552-520c-9e30-6bce98e9d946" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{log}⁡(7)" :db/id #edb/ref 17592186291193} {:answer/id #uuid "a942eb9e-20af-5ce8-bcb0-edde94e6b8d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{\\operatorname{log}⁡(7)}" :db/id #edb/ref 17592186291370} {:answer/id #uuid "da13d7a6-842f-5188-995b-f601e0fb9261" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{\\operatorname{log}⁡(7)}" :db/id #edb/ref 17592186291544}] :answer-field/correct {:answer/id #uuid "6566b744-0a39-5a79-adc4-eb963875b944" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{1-\\operatorname{log}⁡(7)}" :db/id #edb/ref 17592186291063} :answer-field/id #uuid "480c9754-f2a3-545e-b087-84a9e0daed41" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291963}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3565dc73-156f-57ee-a4a3-9af19402d1e5" :question/math-academy-id "q-26385" :question/problem "Expressed in terms of common logarithms, what value of $x$ satisfies the equation ${10}^{x-3}={7}^{x}?$" :question/worked-solution "First, we take the common logarithm $(log)$ of both sides of the equation:\n\n$$\n\\begin{aligned}{10}^{x-3} & ={7}^{x} \\\\ \\operatorname{log}⁡({10}^{x-3}) & =\\operatorname{log}⁡({7}^{x})\\end{aligned}\n$$\n\nNow, we use the fact that ${log}_{b}⁡({b}^{c})=c$ to simplify the left-hand side. This gives:\n\n$$\n\\begin{aligned}x-3 & =\\operatorname{log}⁡({7}^{x})\\end{aligned}\n$$\n\nNext, we use the power law of logarithms to simplify the right-hand side:\n\n$$\n\\begin{aligned}x-3 & =x\\operatorname{log}⁡(7)\\end{aligned}\n$$\n\nFinally, we solve for $x,$ as follows:\n\n$$\n\\begin{aligned}x-x\\operatorname{log}⁡(7) & =3 \\\\ x(1-\\operatorname{log}⁡(7)) & =3 \\\\ x & =\\frac{3}{1-\\operatorname{log}⁡(7)}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292672 :knowledge-point/_questions [{:db/id #edb/ref 17592186059668 :knowledge-point/id #uuid "0bd940e7-fccc-5811-b07a-11e4843b1785" :knowledge-point/title "Finding a Point That Lies on a Transformed Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33c00c15-b13b-5bcc-8be2-21e93f4c417e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186290839} {:answer/id #uuid "487a2755-1c9b-50dc-a9ef-825d319c08d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-2)" :db/id #edb/ref 17592186290930} {:answer/id #uuid "5a5b7f1c-6ca6-519d-9324-afd97504caa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,2)" :db/id #edb/ref 17592186291021} {:answer/id #uuid "bfbeb462-5ad4-5751-9859-039c2c20e85a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-3)" :db/id #edb/ref 17592186291457} {:answer/id #uuid "f4debbbb-a978-5aa2-807b-d09d5e6771d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-3)" :db/id #edb/ref 17592186291662}] :answer-field/correct {:answer/id #uuid "33c00c15-b13b-5bcc-8be2-21e93f4c417e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186290839} :answer-field/id #uuid "337977c2-17f5-5416-91d9-a9bbf15f1e4e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291907}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6eb852b1-3670-5b7e-89d9-1b29c405f01a" :question/math-academy-id "q-26594" :question/problem "The point  $(3,1)$ lies on the curve $y=f(x).$ Which of the following points **must** lie on $y=-f(x)-1?$" :question/worked-solution "**Method 1**\n\nTo plot $y=-f(x)-1,$ we apply the following steps: \n\n- First, we take the graph $y=f(x).$\n\n- Then, we reflect the graph across the $x$-axis and get the graph of $y=-f(x).$ After this transformation, the point $(3,1)$ will be mapped to the point\n\n$$\n(3,-(1))=(3,-1).\n$$\n\n- Finally, we shift the result vertically by $1$ unit down and obtain the graph of $y=-f(x)-1.$ After this transformation, the point $(3,-1)$ will be mapped to the point\n\n$$\n(3,-1-1)=(3,-2).\n$$\n\n**Method 2**\n\nSince the point $(3,1)$ lies on the graph of $y=f(x)$, we have that $f(3)=1.$\n\nNow consider the graph of $y=-f(x)-1.$ Substituting $x=3$, we get\n\n$$\n\\begin{aligned}y & =-f(3)-1 \\\\  & =-(1)-1 \\\\  & =-1-1 \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, the point $(3,-2)$ must lie on $y=-f(x)-1.$"}] [{:db/id #edb/ref 17592186292673 :knowledge-point/_questions [{:db/id #edb/ref 17592186059669 :knowledge-point/id #uuid "38b450bd-b43a-507c-9bbe-0aaf7a64a3ed" :knowledge-point/title "Finding a Point That Lies on a Transformed Curve Given Another Transformed Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f5bb3ff-2bf2-59a6-a9dc-028e36b29e5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186290821} {:answer/id #uuid "6a0dffee-d291-5706-b099-bf26056b0a79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,4)" :db/id #edb/ref 17592186291085} {:answer/id #uuid "745f11b3-4abb-5778-b95c-05bfed92c9ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,2)" :db/id #edb/ref 17592186291130} {:answer/id #uuid "add1ba6b-56e1-507d-81c4-d7cc7dd66d71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186291387} {:answer/id #uuid "f811fc7c-86fc-528d-a6a8-cba9ceee139f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-2)" :db/id #edb/ref 17592186291677}] :answer-field/correct {:answer/id #uuid "add1ba6b-56e1-507d-81c4-d7cc7dd66d71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186291387} :answer-field/id #uuid "e46bb93d-f096-5e20-be4c-e4f183d28feb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292449}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4ee92c98-a45f-55db-8092-7db7c00e5a4e" :question/math-academy-id "q-26596" :question/problem "The point  $(3,2)$ lies on the curve $y=f(x)-2.$ Which of the following points **must** lie on $y=-f(x)+2?$" :question/worked-solution "**Method 1**\n\nWe first find a point corresponding to $(3,2)$ on $y=f(x).$ Then, we find a corresponding point on $y=-f(x)+2:$\n\n- To plot the graph of $y=f(x),$ we apply the following steps:\n\n- First, take the graph $y=f(x)-2.$\n\n- Then, we shift the graph vertically by $2$ units up and get the graph of $y=f(x).$ After this transformation, the point $(3,2)$ will be mapped to the point\n\n$$\n(3,2+2)=(3,4).\n$$\n\n- Next, to plot the graph of $y=-f(x)+2,$ we apply the following steps:\n\n- First, take the graph $y=f(x).$\n\n- Then, we reflect the result across the $x$-axis and get the graph of $y=-f(x).$ After this transformation, the point $(3,4)$ will be mapped  to the point\n\n$$\n(3,-(4))=(3,-4).\n$$\n\n- Next, we shift the result vertically by $2$ units up and obtain the graph of $y=-f(x)+2.$ After this transformation, the point $(3,-4)$ will be mapped to the point \n\n$$\n(3,-4+2)=(3,-2).\n$$\n\n**Method 2**\n\nSince the point $(3,2)$ lies on the graph of $y=f(x)-2$, we have that \n\n$$\nf(3)-2=2\\,⟹\\,f(3)=4.\n$$\n\nNow consider the graph of $y=-f(x)+2.$ Substituting $x=3$, we get\n\n$$\n\\begin{aligned}y & =-f(3)+2 \\\\  & =-4+2 \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, the point $(3,-2)$ must lie on $y=-f(x)+2.$"}] [{:db/id #edb/ref 17592186390514 :knowledge-point/_questions [{:db/id #edb/ref 17592186087821 :knowledge-point/id #uuid "dd63cb30-a236-546e-82ac-08bce09c88f7" :knowledge-point/title "Identifying a Vertically Shifted Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1db17739-2def-5e37-af22-164593bd5829" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/61/61cd6304483770e91658f37cd8ac3dbf57c58f25c9a631ab45a56cd706d381ee.png" :db/id #edb/ref 17592186390516} {:answer/id #uuid "9904a233-df69-591c-90af-01e22fb617bb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/31/31f0d95293939e141e0ebff2aaad6223a9a82188e892441906ae09c530919b1d.png" :db/id #edb/ref 17592186390517} {:answer/id #uuid "acd865cc-8ca0-5df0-b0c5-c2cd29210f44" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/df/dfb46737087c1196ce079607220107a88857d6ca139d0d5c53b181795fe1344a.png" :db/id #edb/ref 17592186390518} {:answer/id #uuid "ddc2a988-d900-5cd3-a9a0-9a6ecf303b6b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ee/eef682605cf7486a9d8fa23cd508705e70443622164eeb2c253ca342bbce92cb.png" :db/id #edb/ref 17592186390519} {:answer/id #uuid "fffb642d-e2f2-5134-92b3-6bde0b2a9298" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bc/bce2bc405efee4fc0fc0f8cd53a3f230fe407f1232c98237ced4ce64743a8499.png" :db/id #edb/ref 17592186390520}] :answer-field/correct {:answer/id #uuid "fffb642d-e2f2-5134-92b3-6bde0b2a9298" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bc/bce2bc405efee4fc0fc0f8cd53a3f230fe407f1232c98237ced4ce64743a8499.png" :db/id #edb/ref 17592186390520} :answer-field/id #uuid "fe0ebeea-e82f-58d4-a5b0-0f856e91026c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390515}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "63caaf01-44b4-5dc6-a569-9e3a3a5c8859" :question/math-academy-id "q-26811" :question/problem "Which of the following is the graph of $y={7}^{x}+4?$" :question/worked-solution "First, we plot the graph of $y={7}^{x}:$\n\n![](images/cd/cd8226319b26b3fef6db6e98efc187b1c474c91bc0252e424151791fda373b95.png)\n\nTo sketch the graph of $y={7}^{x}+4,$ we take the graph of $y={7}^{x}$ and shift it $4$ units up. The $y$-intercept moves from $(0,1)$ to $(0,5),$ and the horizontal asymptote moves from $y=0$ to $y=4.$\n\n![](images/85/85cc1403ab74e2df97669a7c3363d1abddf6d093c358e888a69b655f1ca7450a.png)"}] [{:db/id #edb/ref 17592186390521 :knowledge-point/_questions [{:db/id #edb/ref 17592186087821 :knowledge-point/id #uuid "dd63cb30-a236-546e-82ac-08bce09c88f7" :knowledge-point/title "Identifying a Vertically Shifted Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e4093346-6cc0-5f63-9423-7b76da2a672f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1d/1d80c585063f3cd30a6ec1f877e0f2add2bf109bc54506e4b6c9e44a7b5019d2.png" :db/id #edb/ref 17592186390523} {:answer/id #uuid "fd28d0fd-5ee9-586e-ade7-f559ef7573ec" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bb/bbdfe3e538e840385c082f16ca2cdfd07a7731c561d05cab6e7a25f487cdf463.png" :db/id #edb/ref 17592186390524} {:answer/id #uuid "be9702e6-d21c-5c09-a96e-1267b5361dc9" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/cd/cd11656e3dae8a4976b1051a135b4bead1e5afc4beb21fa7541571892a037500.png" :db/id #edb/ref 17592186390525} {:answer/id #uuid "35b1a419-9084-5fab-a034-b69305bdd882" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/66/6674add26b7a15f5b09c53a832d649979484f0ffd41b440069dd5230cd9a5187.png" :db/id #edb/ref 17592186390526} {:answer/id #uuid "724df295-2359-5b8b-ab62-27d9d0e10f5e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a3/a30938f3d3af2fd70a0ee9498d7d99973d5386f062f22aaa8a028e9e18b3fb57.png" :db/id #edb/ref 17592186390527}] :answer-field/correct {:answer/id #uuid "be9702e6-d21c-5c09-a96e-1267b5361dc9" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/cd/cd11656e3dae8a4976b1051a135b4bead1e5afc4beb21fa7541571892a037500.png" :db/id #edb/ref 17592186390525} :answer-field/id #uuid "9cb7b8b6-ddf5-57db-b6c9-dfd64245bb49" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390522}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5100b042-b82c-5834-8756-fafba09daf0e" :question/math-academy-id "q-26815" :question/problem "Which of the following is the graph of $y={6}^{x}-0.75?$" :question/worked-solution "First, we plot the graph of $y={6}^{x}:$\n\n![](images/29/29d270676a48f4cf40625ef3ec50b0323c9c99389b2a7d080881727eda28de56.png)\n\nTo sketch the graph of $y={6}^{x}-0.75,$ we take the graph of $y={6}^{x}$ and shift it $0.75$ units down. The $y$-intercept moves from $(0,1)$ to $(0,0.25),$ and the horizontal asymptote moves from $y=0$ to $y=-0.75.$\n\n![](images/3b/3b141be99e5c01c70d6f6f04f4adf06741f1dc0fcef80c73b52e3dba1ae44a87.png)"}] [{:db/id #edb/ref 17592186292685 :knowledge-point/_questions [{:db/id #edb/ref 17592186059674 :knowledge-point/id #uuid "4c898bbf-004c-5905-a0a0-761adefc8bd8" :knowledge-point/title "Finding Exact Value of a Trigonometric Expression Using the Double-Angle Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "078b25eb-c753-58c4-a8bb-c23711fdad11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186290671} {:answer/id #uuid "7908b470-d7ec-55b9-b4ab-b86372edd49a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186291145} {:answer/id #uuid "820532c3-42ff-5bba-a8ac-2af534fa5f77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186291181} {:answer/id #uuid "9fdbc26c-f0b1-58b7-b55e-4663ee54eccb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186291327} {:answer/id #uuid "fcc2c5b1-4056-55a7-8817-839d1d89caec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2+\\sqrt{3}}{2}" :db/id #edb/ref 17592186291707}] :answer-field/correct {:answer/id #uuid "820532c3-42ff-5bba-a8ac-2af534fa5f77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186291181} :answer-field/id #uuid "d670500b-2a4c-531d-a949-3190b98d3ea6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292387}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "83f3d502-62d9-5e1b-a7be-52d9144a4c16" :question/math-academy-id "q-26907" :question/problem "Find the exact value of ${(\\operatorname{sin}⁡({105}^{∘})+\\operatorname{cos}⁡({105}^{∘}))}^{2}.$" :question/worked-solution "First, we expand the parenthesis and use the Pythagorean identity.\n\n$$\n\\begin{aligned}{(\\operatorname{sin}⁡({105}^{∘})+\\operatorname{cos}⁡({105}^{∘}))}^{2} & ={sin}^{2}⁡({105}^{∘})+2\\operatorname{sin}⁡({105}^{∘})\\operatorname{cos}⁡({105}^{∘})+{cos}^{2}⁡({105}^{∘}) \\\\  & =[{sin}^{2}⁡({105}^{∘})+{cos}^{2}⁡({105}^{∘})]+2\\operatorname{sin}⁡({105}^{∘})\\operatorname{cos}⁡({105}^{∘}) \\\\  & =1+2\\operatorname{sin}⁡({105}^{∘})\\operatorname{cos}⁡({105}^{∘})\\end{aligned}\n$$\n\nNow, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x={105}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡({105}^{∘})\\operatorname{cos}⁡({105}^{∘}) & =\\operatorname{sin}⁡(2\\cdot {105}^{∘}) \\\\  & =\\operatorname{sin}⁡({210}^{∘}) \\\\  & =\\operatorname{sin}⁡({180}^{∘}+{30}^{∘}) \\\\  & =-\\operatorname{sin}⁡({30}^{∘}) \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$\n\nHence, we obtain\n\n$$\n1+2\\operatorname{sin}⁡({105}^{∘})\\operatorname{cos}⁡({105}^{∘})=1-\\frac{1}{2}=\\frac{1}{2}.\n$$\n\nTherefore, we conclude that\n\n$$\n{(\\operatorname{sin}⁡({105}^{∘})+\\operatorname{cos}⁡({105}^{∘}))}^{2}=\\frac{1}{2}.\n$$"}] [{:db/id #edb/ref 17592186292696 :knowledge-point/_questions [{:db/id #edb/ref 17592186176047 :knowledge-point/id #uuid "542df339-5020-5680-a39c-a1ae161083e7" :knowledge-point/title "Describing Properties of the Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "043c68c8-e391-5780-a3ff-6d80dc52b081" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186290656} {:answer/id #uuid "931ab8d4-be2c-5e4d-92d6-fc6433eec3f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186291265} {:answer/id #uuid "9767e111-d1e9-5924-9dc2-6f58d60a1d5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186291290} {:answer/id #uuid "bb01b60e-6bb3-5d81-89d4-9256edcd3ff6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186291443} {:answer/id #uuid "d869766d-8d2f-5348-b322-4dd0c0dc459d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186291536}] :answer-field/correct {:answer/id #uuid "043c68c8-e391-5780-a3ff-6d80dc52b081" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186290656} :answer-field/id #uuid "c15b4588-e9b5-5b8e-af3b-02394e3239c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292328}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "69137884-05b3-53be-9c7c-95b53b1ed329" :question/math-academy-id "q-27009" :question/problem "Which of the following statements are true regarding the function $y=cos⁡x?$ \n\n- The function intersects the $x$-axis at $x=\\frac{\\pi }{2}.$\n- The function has a minimum value at  $x=2\\pi .$\n- The function intersects the $y$-axis at $y=0.$" :question/worked-solution "Let's plot the graph of $y=cos⁡x.$\n\n![](images/9c/9c77bec4ebb04668fbff5176418ed9c09143a8660879fdf523a158c5f109006c.png)\n\nLet's go through each statement.\n\n- Statement I is true. At $x=\\frac{\\pi }{2}$ the function intersects the $x$-axis.\n\n- Statement II is false. The function has a maximum at $x=2\\pi .$\n\n- Statement III is false. The function intersects the $y$-axis at $y=1.$"}] [{:db/id #edb/ref 17592186390531 :knowledge-point/_questions [{:db/id #edb/ref 17592186068829 :knowledge-point/id #uuid "5bb394c3-cd7c-523d-88df-b1306d9d528f" :knowledge-point/title "Identifying a Vertically Shifted Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5145dde8-60d2-54b7-ad8d-2892ff5d3963" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a4/a4161037f51b8c4d95037c3ff28d7e6afecb354d4e0fabc22e5dd819bb65b6cc.png" :db/id #edb/ref 17592186390533} {:answer/id #uuid "6680ac81-034b-5243-a46f-e14b15ca391f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a4/a4511ffac1899bdeb512b0b50b50b6a121477f486ef7e2efc83697fd9dddb8d2.png" :db/id #edb/ref 17592186390534} {:answer/id #uuid "2d7b451c-b477-571c-b8f0-b6b471ddf99b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/95/953bb642696a6b9c934627f978d150d27adbc7f73779a3d017c2ba714ff0835e.png" :db/id #edb/ref 17592186390535} {:answer/id #uuid "6fd2d67a-323e-5832-a842-a36b0a6fce73" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d6/d6034af21a31fdfdbaff6760ab5dd97bb227d0538a475aef9e5c14a1559e16b1.png" :db/id #edb/ref 17592186390536} {:answer/id #uuid "3fbecea5-be5b-5a1e-bd55-ff4ec8267187" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/df/df2b0819dabd55db60af06fecb52e19a013b471ab632484d4066ef5e011ccfe5.png" :db/id #edb/ref 17592186390537}] :answer-field/correct {:answer/id #uuid "3fbecea5-be5b-5a1e-bd55-ff4ec8267187" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/df/df2b0819dabd55db60af06fecb52e19a013b471ab632484d4066ef5e011ccfe5.png" :db/id #edb/ref 17592186390537} :answer-field/id #uuid "fe628ffa-6fae-5342-9742-f9cf2475f662" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390532}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4cf19722-da75-5d66-8864-81b9e6bc4f1a" :question/math-academy-id "q-27477" :question/problem "Which of the following is the graph of  $y={(\\frac{1}{10})}^{x}-\\frac{1}{10}?$" :question/worked-solution "First we plot the graph of $y={(\\frac{1}{10})}^{x}:$\n\n![](images/f0/f02afa6dd2d1c107fd72b1221fddb7f6c698506deb834cad0dc11af1bebb18e6.png)\n\nNext, we shift this graph $\\frac{1}{10}$ units down. \nThe horizontal asymptote under such a transformation becomes $y=-\\frac{1}{10},$ the $y$-intercept becomes $(0,\\frac{9}{10}).$\nThe resulting graph of $y={(\\frac{1}{10})}^{x}-\\frac{1}{10}$ is shown below.\n\n![](images/57/57539870ff45bae449d3ad7c11580d9c8068cfe76ac98c2f849ee38494288036.png)"}] [{:db/id #edb/ref 17592186401915 :knowledge-point/_questions [{:db/id #edb/ref 17592186068900 :knowledge-point/id #uuid "66ade855-4b16-514b-b44a-1d6b9d61ef28" :knowledge-point/title "Identifying the Shift Applied to an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c3666f3-ba98-51a9-b678-f25e043d3a37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}+3.5" :db/id #edb/ref 17592186401917} {:answer/id #uuid "e8039e0c-f293-5ce4-b395-a4064a0685bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}-2.5" :db/id #edb/ref 17592186401918} {:answer/id #uuid "a5f24666-89d0-5332-bb2a-21f966094be5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}-3.5" :db/id #edb/ref 17592186401919} {:answer/id #uuid "a479a80c-f0e1-5b4f-9f67-06b99cd086bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}+1.5" :db/id #edb/ref 17592186401920} {:answer/id #uuid "266f8f59-63e6-5980-a4b9-749b4fb8201c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}+2.5" :db/id #edb/ref 17592186401921}] :answer-field/correct {:answer/id #uuid "266f8f59-63e6-5980-a4b9-749b4fb8201c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}+2.5" :db/id #edb/ref 17592186401921} :answer-field/id #uuid "828a7f8a-1289-571e-8aa4-3a396be14d44" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401916}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6948e752-4360-51fe-b06f-c6885f4f282f" :question/math-academy-id "q-27482" :question/problem "![](images/c0/c091fc5d742ddca3090725974f00ff7da77b1530d601bb82e288518b27970b0a.png)\n\nThe graph above shows the curve $y={(\\frac{1}{9})}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={(\\frac{1}{9})}^{x}$ is $y=0.$\n\nThe vertical translation $y={(\\frac{1}{9})}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=2.5.$ Therefore, $c=2.5.$"}] [{:db/id #edb/ref 17592186390538 :knowledge-point/_questions [{:db/id #edb/ref 17592186068830 :knowledge-point/id #uuid "617f0fe6-7998-5d77-b11f-55a0eca11440" :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11991a9d-264d-57e7-9fdd-da7348694651" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/77/77ddeefbcbd24c80f6ed0bb7a29d2a43e3151436b0a60b56686b1c67ca31c738.png" :db/id #edb/ref 17592186390540} {:answer/id #uuid "f32fd0b0-49ce-539d-9672-8d020e261fbb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f7/f73be44a90c4a240b316bcf7ac5586b54ed1ca4cdedfac42f055cd39086ffe2d.png" :db/id #edb/ref 17592186390541} {:answer/id #uuid "407fad6c-67c3-5a63-bb5b-a49d0b7c8b56" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f4/f405cfe76e1d69d7ecad35e96ced1c76c1b64130a118d881d331bcb0b119068c.png" :db/id #edb/ref 17592186390542} {:answer/id #uuid "a9519e6c-79f2-5f62-a983-2670eb2a7aba" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/33/33f78e0590a7039f0e2e17d5bc871e0503dd3526d282b5fb76e4ef0f3b78cc28.png" :db/id #edb/ref 17592186390543} {:answer/id #uuid "29d4d4e8-fe84-544d-8606-3bfce7839133" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9d/9d332fa8d3d8ef65daaf34bf906c5ca7cd7e2edaf562386ed4e0ebc4555b0a64.png" :db/id #edb/ref 17592186390544}] :answer-field/correct {:answer/id #uuid "29d4d4e8-fe84-544d-8606-3bfce7839133" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9d/9d332fa8d3d8ef65daaf34bf906c5ca7cd7e2edaf562386ed4e0ebc4555b0a64.png" :db/id #edb/ref 17592186390544} :answer-field/id #uuid "49a74683-a726-5cb6-b2c2-b253e72cf78d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390539}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b5e7ffcf-d49d-5dfe-9c73-ca9c0369ba7d" :question/math-academy-id "q-27538" :question/problem "Which of the following is the graph of  $y=3{(\\frac{1}{6})}^{x}-1?$" :question/worked-solution "We start with plotting the graph of $y={(\\frac{1}{6})}^{x}:$\n\n![](images/4c/4cdc9e4fa78513bca01fa10242ba6c3f12b31c262448a8edf350c76e84b188b8.png)\n\nNext, we plot the graph of $y=3{(\\frac{1}{6})}^{x}.$ To do this, we scale the graph above by a factor of $3.$ The $y$-intercept moves from $(0,1)$ to $(0,3)$ but the horizontal asymptote stays at $y=0.$\n\n![](images/8e/8e7d6c5eb931f55a9f94ac33382c0e1ec9e9e49f50b3ab538d9848d6a77be665.png)\n\nFinally, we plot the graph of $y=3{(\\frac{1}{6})}^{x}-1.$ To do this, we shift the above graph $1$ unit down. The $y$-intercept moves from $(0,3)$ to $(0,2)$ and the horizontal asymptote moves from $y=0$ to $y=-1.$\n\n![](images/9d/9d332fa8d3d8ef65daaf34bf906c5ca7cd7e2edaf562386ed4e0ebc4555b0a64.png)"}] [{:db/id #edb/ref 17592186390545 :knowledge-point/_questions [{:db/id #edb/ref 17592186068830 :knowledge-point/id #uuid "617f0fe6-7998-5d77-b11f-55a0eca11440" :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f70e31a-a6d8-57be-8930-fe9e46798cf1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e5/e545a84145ac0a139ee5ecdf9692c20837d211f9a70fd79ad33dd13f60c856f7.png" :db/id #edb/ref 17592186390547} {:answer/id #uuid "3dd43261-0c67-5dec-abd5-e030f8c694d1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f6/f63e49a2e8f4a0702841eb132093bf6f69b8405af25719ea8f5abbf2bd691122.png" :db/id #edb/ref 17592186390548} {:answer/id #uuid "c08648ea-dc6d-5578-89fa-a0be944fb62c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c6/c64e79b7c0069aaf7d4393a6879612f58f48103247b1ba7efef3531dc3986b93.png" :db/id #edb/ref 17592186390549} {:answer/id #uuid "84311dad-8f82-5f9c-ab3a-b304e0b27aae" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/57/571e2268e6b7f41e80b71c8764d321c298fe58232e5b4c5a84ce309fa0dd3530.png" :db/id #edb/ref 17592186390550} {:answer/id #uuid "8b546f29-cf64-542e-8f37-af2b900bcda8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3d/3d7af2718ba7c30956218a00da51e77db950183bd2a85dbe74107e493fd5f03b.png" :db/id #edb/ref 17592186390551}] :answer-field/correct {:answer/id #uuid "0f70e31a-a6d8-57be-8930-fe9e46798cf1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e5/e545a84145ac0a139ee5ecdf9692c20837d211f9a70fd79ad33dd13f60c856f7.png" :db/id #edb/ref 17592186390547} :answer-field/id #uuid "b29207c3-5e76-521f-8c52-fed97e9cf151" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390546}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ab17c05b-3a04-5ac4-9de0-6246c2badd83" :question/math-academy-id "q-27540" :question/problem "Which of the following is the graph of $y=\\frac{1}{2}{(\\frac{1}{4})}^{x}-3?$" :question/worked-solution "We start with plotting the graph of $y={(\\frac{1}{4})}^{x}:$\n\n![](images/e6/e648e3a5f0c844d6596d4848629c3e6749647228116bcc5da6fce250895141d5.png)\n\nNext, we plot the graph of $y=\\frac{1}{2}{(\\frac{1}{4})}^{x}.$ To do this, we scale the graph above by a factor of $\\frac{1}{2}.$ The $y$-intercept moves from $(0,1)$ to $(0,\\frac{1}{2})$ but the horizontal asymptote stays at $y=0.$\n\n![](images/37/378016bbd17371e3dfee1e80934e76b1357139d405cb320ac5befa252da82b28.png)\n\nFinally, we plot the graph of $y=\\frac{1}{2}{(\\frac{1}{4})}^{x}-3.$ To do this, we shift the above graph $3$ units down. The $y$-intercept moves from $(0,\\frac{1}{2})$ to $(0,-\\frac{5}{2})$ and the horizontal asymptote moves from $y=0$ to $y=-3.$\n\n![](images/e5/e545a84145ac0a139ee5ecdf9692c20837d211f9a70fd79ad33dd13f60c856f7.png)"}] [{:db/id #edb/ref 17592186294980 :knowledge-point/_questions [{:db/id #edb/ref 17592186115336 :knowledge-point/id #uuid "6a916099-a237-5612-b7f1-3679b7ff069d" :knowledge-point/title "Calculating an Unknown Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "250975f6-1855-51d4-855b-4756eab86379" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{30}^{∘}" :db/id #edb/ref 17592186293090} {:answer/id #uuid "74682fc2-217c-57f5-ab98-c931310e5466" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{18}^{∘}" :db/id #edb/ref 17592186293411} {:answer/id #uuid "7d0ac39b-3059-5c95-9035-fede9601ced2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{15}^{∘}" :db/id #edb/ref 17592186293433} {:answer/id #uuid "c8f82474-ac34-5dcf-9935-8a82efc05435" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{20}^{∘}" :db/id #edb/ref 17592186293712} {:answer/id #uuid "e390ae5f-9602-5bc0-bd7b-333ec91cd6ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{25}^{∘}" :db/id #edb/ref 17592186293825}] :answer-field/correct {:answer/id #uuid "c8f82474-ac34-5dcf-9935-8a82efc05435" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{20}^{∘}" :db/id #edb/ref 17592186293712} :answer-field/id #uuid "5dff0f5f-38be-5491-8c48-4be6dc5f48b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294264}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "94753d7f-95e4-5b39-9c21-ede7ecea7547" :question/math-academy-id "q-27832" :question/problem "![](images/66/6665784a8ce048fd26fbd97038346e8e6fdf6800d645ea0488f1c18986f5864b.png)\n\nConsider the triangle $△ABC$ shown above. The line segment $\\overset{―}{CH}$ is the altitude corresponding to $\\overset{―}{AB}.$ If $m∠BAC={110}^{∘},$ calculate $m∠HCA.$" :question/worked-solution "Since the straight angle must have a measure of ${180}^{∘},$ we have\n\n$$\n\\begin{aligned}m∠HAC+m∠BAC & ={180}^{∘} \\\\ m∠HAC+{110}^{∘} & ={180}^{∘} \\\\ m∠HAC & ={70}^{∘}.\\end{aligned}\n$$\n\nNote that $△ACH$ is a right triangle. Since its interior angles must sum to ${180}^{∘},$ we have\n\n$$\n\\begin{aligned}m∠HCA+m∠HAC+m∠AHC & ={180}^{∘} \\\\ m∠HCA+{70}^{∘}+{90}^{∘} & ={180}^{∘} \\\\ m∠HCA+{160}^{∘} & ={180}^{∘} \\\\ m∠HCA & ={20}^{∘}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115676 :knowledge-point/_questions [{:db/id #edb/ref 17592186115358 :knowledge-point/id #uuid "51739685-2d53-5c9b-870b-b557ffdf2768" :knowledge-point/title "Finding the Area of a Triangle by Solving for a Variable Given a Trigonometric Ratio of One Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1757e5f4-54b5-5159-9ab2-49bce96f3df1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186293023} {:answer/id #uuid "9cbbe909-d185-59d0-b912-c153b5d3e71b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186293549} {:answer/id #uuid "a10e5fb3-4c1c-5b66-89cd-0598cd19bb77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186293566} {:answer/id #uuid "a838bda5-a5e8-5f6a-a576-b0a05239ea5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186293599} {:answer/id #uuid "ac38d79d-d749-555c-aea9-60b199533b57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186293606}] :answer-field/correct {:answer/id #uuid "1757e5f4-54b5-5159-9ab2-49bce96f3df1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186293023} :answer-field/id #uuid "331c0849-08b7-58b1-a991-ead4ea6bc11c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294107}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f0a77aee-e012-5d50-a91c-7eccfeb5ef38" :question/math-academy-id "q-28266" :question/problem "![](images/48/48cb6a248ab3ce706f26dc2e84e2feb337d509041c8b9756ea32fb3817aa097f.png)\n\nGiven that $\\operatorname{tan}⁡(m∠A)=5,$ calculate the area (in square units) of $△ABC$ shown above." :question/worked-solution "In this case, the area of the right triangle is\n\n$$\nA=\\frac{1}{2}AC\\cdot BC.\n$$\n\nWe are given that $\\operatorname{tan}⁡(m∠A)=5.$ Notice that relative to $∠A,$ we have expressions for the lengths of the opposite side $\\overset{―}{BC}$ and adjacent side $\\overset{―}{AC}.$ Hence, we can use the tangent ratio to solve for $x:$\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡(m∠A) & =\\frac{BC}{AC} \\\\ 5 & =\\frac{2x+4}{x-1} \\\\ 5(x-1) & =2x+4 \\\\ 5x-5 & =2x+4 \\\\ 3x & =9 \\\\ x & =3\\end{aligned}\n$$\n\nSo, the side lengths are\n\n$$\n\\begin{aligned}BC & =2x+4=2(3)+4=10, \\\\ AC & =x-1=3-1=2.\\end{aligned}\n$$\n\nTherefore, the area of $△ABC$ is\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}AC\\cdot BC \\\\  & =\\frac{1}{2}\\cdot 2\\cdot 10 \\\\  & =10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295268 :knowledge-point/_questions [{:db/id #edb/ref 17592186110601 :knowledge-point/id #uuid "6f3d7d62-686b-59c4-9ea1-695c6be3180b" :knowledge-point/title "Determining Unknown Parameters Given Two Perpendicular Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55f88508-da2b-5f50-bc9a-a9d26b49e411" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186293282} {:answer/id #uuid "a5105cfc-01bb-5d42-a770-d43d047ecbd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186293581} {:answer/id #uuid "c8156b99-af7d-5f7b-b0a7-f383c4b1a5c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{15}" :db/id #edb/ref 17592186293707} {:answer/id #uuid "c91b613b-66f6-5d95-9a11-12d165d11100" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186293713} {:answer/id #uuid "f1ecb80b-49f9-59d8-9960-66dfad7c060e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{15}" :db/id #edb/ref 17592186293875}] :answer-field/correct {:answer/id #uuid "c8156b99-af7d-5f7b-b0a7-f383c4b1a5c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{15}" :db/id #edb/ref 17592186293707} :answer-field/id #uuid "e2a93840-02de-536d-9650-a5ee63bece85" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294727}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fe99c4a9-356e-5f86-a2a8-a7dd24fba9f7" :question/math-academy-id "q-28328" :question/problem "Given that the lines $y=5qx+9$ and $y=-3x-8$ are perpendicular, what is the value of $q?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nBoth lines are slope-intercept form, and the slope is the $x$-coefficient. \n\n- The slope of the line $y=5qx+9$ is $5q.$\n\n- The slope of the line $y=-3x-8$ is $-3.$\n\nMultiplying the slopes together, we have\n\n$$\n5q\\cdot (-3)=-1\\,⟹\\,q=\\frac{1}{15}.\n$$"}] [{:db/id #edb/ref 17592186295269 :knowledge-point/_questions [{:db/id #edb/ref 17592186110600 :knowledge-point/id #uuid "e732f270-1d6f-5ff8-8792-d9b329ea858d" :knowledge-point/title "Determining Whether Two Lines in Standard Form are Perpendicular"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96da5639-b1ab-5764-ba59-7e12ce5f9525" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{2}{5}x+4" :db/id #edb/ref 17592186293524} {:answer/id #uuid "c3c3ebe1-76b4-534e-ac97-16940002c63a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{2}{5}x-\\frac{3}{2}" :db/id #edb/ref 17592186293692} {:answer/id #uuid "d426e426-55ae-5a3a-aa02-c573670e3364" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{5}{2}x-4" :db/id #edb/ref 17592186293751} {:answer/id #uuid "d741d61c-f686-5e74-9421-30cd24022c0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{2}x+\\frac{16}{5}" :db/id #edb/ref 17592186293765} {:answer/id #uuid "fcbe027c-6c76-580a-9173-eaad9074aa07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{5}{2}x+\\frac{12}{5}" :db/id #edb/ref 17592186293920}] :answer-field/correct {:answer/id #uuid "d426e426-55ae-5a3a-aa02-c573670e3364" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{5}{2}x-4" :db/id #edb/ref 17592186293751} :answer-field/id #uuid "9c87e56a-6a3b-50b2-a894-d68a942d6fc2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294494}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7542d07b-ac7a-53fd-84e7-5ac011364c8c" :question/math-academy-id "q-28338" :question/problem "Which of the following lines is perpendicular to $4x+10y=20?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nTo find the slope of the given line $4x+10y=20,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}4x+10y & =20 \\\\ 10y & =-4x+20 \\\\ y & =-\\frac{4}{10}x+\\frac{20}{10} \\\\ y & =-\\frac{2}{5}x+2\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope of the given line is $-\\frac{2}{5}.$\n\nLooking at the answer choices, the line $y=\\frac{5}{2}x-4$ has a slope of $\\frac{5}{2}.$\n\nMultiplying the slopes together, we have\n\n$$\n(-\\frac{2}{5})\\cdot \\frac{5}{2}=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=\\frac{5}{2}x-4$ is perpendicular to the given line."}] [{:db/id #edb/ref 17592186297159 :knowledge-point/_questions [{:db/id #edb/ref 17592186059677 :knowledge-point/id #uuid "89f65f58-bd3d-5c3f-b9e0-462d74d75b59" :knowledge-point/title "Computing Second Order Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b268833-a892-5a14-ab75-38558f16bc57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186295511} {:answer/id #uuid "bf7be3a8-94b4-5a24-adb6-b753140ab093" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186296278} {:answer/id #uuid "d19d31e7-9654-53a0-8391-14a1f9103d85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186296372} {:answer/id #uuid "d427a2bc-12c0-5bdc-b3d1-7a4dbeb358d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186296383} {:answer/id #uuid "edf73d42-1443-5359-8707-64a0a6a850c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "75" :db/id #edb/ref 17592186296527}] :answer-field/correct {:answer/id #uuid "d427a2bc-12c0-5bdc-b3d1-7a4dbeb358d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186296383} :answer-field/id #uuid "e0375b64-7629-58c5-bdc5-3b40af6de210" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297096}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "88cefa50-35a4-5398-bbcf-d41d22641c1f" :question/math-academy-id "q-28556" :question/problem "Find ${g}^{″}(4)$ if $g(x)=4{x}^{2}\\sqrt{x}-2x+7.$" :question/worked-solution "Computing the first derivative, we have\n\n$$\n\\begin{aligned}{g}^{′}(x) & ={(4{x}^{2}\\sqrt{x}-2x+7)}^{′} \\\\  & ={(4{x}^{5/2}-2x+7)}^{′} \\\\  & =4(\\frac{5}{2}){x}^{3/2}-2+0 \\\\  & =10{x}^{3/2}-2.\\end{aligned}\n$$\n\nComputing the second derivative, we have\n\n$$\n\\begin{aligned}{g}^{″}(x) & ={(10{x}^{3/2}-2)}^{′} \\\\  & =10(\\frac{3}{2}){x}^{1/2}-0 \\\\  & =15{x}^{1/2} \\\\  & =15\\sqrt{x}.\\end{aligned}\n$$\n\nFinally, evaluating the second derivative at $x=4$, we obtain\n\n$$\n\\begin{aligned}{g}^{″}(4) & =15\\sqrt{4} \\\\  & =15(2) \\\\  & =30.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186111134 :knowledge-point/_questions [{:db/id #edb/ref 17592186110720 :knowledge-point/id #uuid "c6cd2f04-e0d5-5df0-8e74-ea737501cdf8" :knowledge-point/title "Solving For an Unknown Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16ca1cf7-eae8-588f-b62e-92e2eed7ae06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186295403} {:answer/id #uuid "5f7c70a7-d1b8-56a0-9961-6101a0fea82a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186295813} {:answer/id #uuid "89099718-058c-53aa-ac2e-3dc7b59c4b5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186296004} {:answer/id #uuid "a1cb3a02-6977-565b-8c6f-64a04e91a8d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186296129} {:answer/id #uuid "fcf45a98-a317-5ebe-a0ee-d58863e54e01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186296613}] :answer-field/correct {:answer/id #uuid "16ca1cf7-eae8-588f-b62e-92e2eed7ae06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186295403} :answer-field/id #uuid "78f9540e-726b-5906-87cd-68bbcee4ccc9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296880}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "573bc8f1-012d-5d7e-834a-c6ec17bb0b63" :question/math-academy-id "q-287970" :question/problem "Consider the equation\n\n$$\n2px=3x\n$$\n\nwhere $p$ is a constant. Given that this equation has infinitely many solutions, what is the value of $p?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=bx\n$$\n\nwhere $a$ and $b$ are constants. If $a=b,$ then the equation has infinitely many solutions.\n\nNotice that this equation is in the form $ax=bx.$ In this case, \n\n$$\na=2p,\\,b=3.\n$$\n\nTherefore, the equation has infinitely many solutions if\n\n$$\n2p=3.\n$$\n\nSolving this for $p,$ we get\n\n$$\np=\\frac{3}{2}.\n$$"}] [{:db/id #edb/ref 17592186297178 :knowledge-point/_questions [{:db/id #edb/ref 17592186204090 :knowledge-point/id #uuid "c0e7426e-553d-5f20-811f-15f3a5ea0056" :knowledge-point/title "Solving For an Unknown Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a9cd574-87f6-5684-a4a2-52f23dcc4f6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186295323} {:answer/id #uuid "4512c30d-0418-5d1a-a9a4-5767ffaddbf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186295659} {:answer/id #uuid "4e445b8e-50d5-51d4-9056-86f12aba889d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186295718} {:answer/id #uuid "967246bb-eb10-50c8-9141-55173f83e32f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186296068} {:answer/id #uuid "b2ae615f-ae70-595f-a21b-63e9d4cc1379" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186296210}] :answer-field/correct {:answer/id #uuid "b2ae615f-ae70-595f-a21b-63e9d4cc1379" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186296210} :answer-field/id #uuid "078b8df7-1fda-503a-8213-ba030a04d1b7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296656}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9d84e977-5f76-5e6a-86a0-a01877993e64" :question/math-academy-id "q-288143" :question/problem "Consider the equation in the variable $x,$ given by\n\n$$\n-3(q+4)x=6\n$$\n\nwhere $q$ is a constant. Given that this equation has no solution, what is the value of $q?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=b\n$$\n\nwhere $a$ and $b$ are constants, and $b\\ne 0.$ If $a=0,$ then the equation has no solution.\n\nNotice that this equation is in the form $ax=b.$ In this case, \n\n$$\na=-3(q+4),\\,b=6.\n$$\n\nTherefore, the equation has no solution if\n\n$$\n-3(q+4)=0.\n$$\n\nSolving this for $q,$ we get\n\n$$\n\\begin{aligned}-3(q+4) & =0 \\\\ \\frac{-3(q+4)}{-3} & =\\frac{0}{-3} \\\\ q+4 & =0 \\\\ q & =-4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297180 :knowledge-point/_questions [{:db/id #edb/ref 17592186213003 :knowledge-point/id #uuid "5cf64df7-0abb-5b42-bed6-b3664c2de89a" :knowledge-point/title "Matching a Single Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "381c6cc6-b38f-5f53-b305-453281ca3851" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186295581} {:answer/id #uuid "60e8b5fe-246c-568f-92d9-946f0504fb9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186295824} {:answer/id #uuid "77d2ee40-a49f-5b7b-8c75-007236a13614" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186295922} {:answer/id #uuid "93a6f32e-a6a3-5689-96e3-737573f92b3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186296057} {:answer/id #uuid "c4c8bcbd-fd03-58ad-896a-0505d8219e4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186296304}] :answer-field/correct {:answer/id #uuid "c4c8bcbd-fd03-58ad-896a-0505d8219e4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186296304} :answer-field/id #uuid "a549f3f8-6e62-5582-a6e8-36a320f44157" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296984}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7d2e83b2-fdb4-5969-995c-ff8567f8cf5b" :question/math-academy-id "q-288406" :question/problem "The following equation is true for all values of $x.$\n\n$$\n-5{x}^{2}+mx-6=-5{x}^{2}-3x-6\n$$\n\nWhat is the value of the constant $m?$" :question/worked-solution "Since the equation is true for all values of $x,$ the expressions on both sides must be exactly the same. That means the coefficients of the matching powers of $x$ must be equal.\n\nWe compare the linear terms on both sides. On the left-hand side, the coefficient of $x$ is $m.$ On the right-hand side, the coefficient of $x$ is $-3.$\n\nSo, we have\n\n$$\nm=-3.\n$$"}] [{:db/id #edb/ref 17592186297183 :knowledge-point/_questions [{:db/id #edb/ref 17592186110720 :knowledge-point/id #uuid "c6cd2f04-e0d5-5df0-8e74-ea737501cdf8" :knowledge-point/title "Solving For an Unknown Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45491d55-84a5-5641-85ee-02ca1a1e90b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186295660} {:answer/id #uuid "7b982f8e-1429-5175-9e47-06c33c917451" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186295944} {:answer/id #uuid "9130ffb1-ff3d-56f6-b44a-a46263f888e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186296047} {:answer/id #uuid "9540e0f1-3b23-5210-976d-85a05ecc13df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186296063} {:answer/id #uuid "f61f19b9-1bc9-5327-81ed-c1e60a23106f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186296576}] :answer-field/correct {:answer/id #uuid "9540e0f1-3b23-5210-976d-85a05ecc13df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186296063} :answer-field/id #uuid "057a3936-10b0-5e7b-83aa-558ff78363fc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296650}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "556d6e5b-c151-55e9-9606-63f27cad6bd7" :question/math-academy-id "q-288436" :question/problem "Consider the equation\n\n$$\n5px=10x\n$$\n\nwhere $p$ is a constant. Given that this equation has infinitely many solutions, what is the value of $p?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=bx\n$$\n\nwhere $a$ and $b$ are constants. If $a=b,$ then the equation has infinitely many solutions.\n\nNotice that this equation is in the form $ax=bx.$ In this case, \n\n$$\na=5p,\\,b=10.\n$$\n\nTherefore, the equation has infinitely many solutions if\n\n$$\n5p=10.\n$$\n\nSolving this for $p,$ we get\n\n$$\np=2.\n$$"}] [{:db/id #edb/ref 17592186297189 :knowledge-point/_questions [{:db/id #edb/ref 17592186213004 :knowledge-point/id #uuid "b2caeb2c-39cf-595a-8105-67d11bf0e45e" :knowledge-point/title "Solving for Two Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a121ddd-d30b-57ab-802c-d2a28aedc332" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186295598} {:answer/id #uuid "3d2d0db4-00f9-5688-a436-3938b8bbd7af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186295617} {:answer/id #uuid "902f311b-9a33-5eca-947d-790debf8ade1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186296040} {:answer/id #uuid "93583915-e4a1-5ab4-acc2-719563e5af95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186296056} {:answer/id #uuid "bf2391b3-6270-5d08-8a37-4f5e7d3097e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186296276}] :answer-field/correct {:answer/id #uuid "3a121ddd-d30b-57ab-802c-d2a28aedc332" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186295598} :answer-field/id #uuid "8913da08-c2a3-53da-a58d-4cb84b000f0c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296916}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "12cdfe66-5367-5a52-9239-ea7358c10305" :question/math-academy-id "q-288452" :question/problem "The equation\n\n$$\n{x}^{2}+nx+d={x}^{2}-12x-8\n$$\n\nis true for all values of $x,$ where $n$ and $d$ are constants. What is the value of $n+d?$" :question/worked-solution "Since the equation is true for all values of $x,$ the expressions on both sides must be exactly the same. That means the coefficients of the matching powers of $x$ must be equal.\n\nLet's compare the coefficients:\n\n- The coefficient of $x$ on the left-hand side is $n,$ and on the right-hand side it is $-12.$ So, we have \n\n$$\nn=-12.\n$$\n\n- The constant term on the left-hand side is $d,$ and on the right-hand side it is $-8.$ So, we have \n\n$$\nd=-8.\n$$\n\nNow, we compute the sum:\n\n$$\n\\begin{aligned}n+d & =-12+(-8) \\\\  & =-12-8 \\\\  & =-20\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297193 :knowledge-point/_questions [{:db/id #edb/ref 17592186213005 :knowledge-point/id #uuid "46822f28-8863-5150-a420-09c61a5c28b1" :knowledge-point/title "Comparing Factored Forms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02184017-3e72-54aa-bfde-e944921a8b7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186295273} {:answer/id #uuid "16eb5901-201a-51bf-b087-292957bc4fd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186295404} {:answer/id #uuid "6c4db019-1fa9-5008-a1ff-18e087f00500" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186295869} {:answer/id #uuid "afa15348-38f9-5b8f-840e-cdf2428bbe13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186296192} {:answer/id #uuid "e425cd77-1bed-5dc0-8e91-a77932df18a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186296485}] :answer-field/correct {:answer/id #uuid "afa15348-38f9-5b8f-840e-cdf2428bbe13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186296192} :answer-field/id #uuid "1f05b554-7726-5f32-a015-9268ca6b0c9e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296692}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "58c900de-ded0-51c6-94b4-0ca8530168c9" :question/math-academy-id "q-288468" :question/problem "The equation\n\n$$\nt(2{x}^{2}-3x+1)=-6{x}^{2}+9x-3\n$$\n\nis true for all values of $x,$ where $t$ is a constant. What is the value of $t?$" :question/worked-solution "Since the equation is true for all values of $x,$ the expressions on both sides must be exactly the same. That means that after distributing $t$ on the left-hand side, the coefficients of the matching powers of $x$ must be equal.\n\nLet's expand the left-hand side:\n\n$$\nt(2{x}^{2}-3x+1)=2t{x}^{2}-3tx+t\n$$\n\nThis must equal the right-hand side. So, we have\n\n$$\n2t{x}^{2}-3tx+t=-6{x}^{2}+9x-3.\n$$\n\nNow, we compare the coefficients of corresponding terms. \n\nComparing the ${x}^{2}$ terms, we have\n\n$$\n2t=-6\\,⇒\\,t=-3.\n$$\n\nLet's verify that value $t=-3$ produces the correct linear coefficient and constant term:\n\n- $-3t=(-3)(-3)=9\\,✓$\n\n- $t=-3\\,✓$\n\nSo, our solution is valid."}] [{:db/id #edb/ref 17592186297197 :knowledge-point/_questions [{:db/id #edb/ref 17592186204090 :knowledge-point/id #uuid "c0e7426e-553d-5f20-811f-15f3a5ea0056" :knowledge-point/title "Solving For an Unknown Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "298bad1f-9367-5a05-95d2-933a09daee2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186295501} {:answer/id #uuid "3dad73b7-975d-5246-83b7-9657d612712e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186295623} {:answer/id #uuid "a52921f6-35e3-5fd6-831b-5c76a68fe597" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186296138} {:answer/id #uuid "c10c0188-b833-5221-be57-af73a4dae17b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186296286} {:answer/id #uuid "f34978c9-f088-5aab-b438-960ba47ee1ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186296559}] :answer-field/correct {:answer/id #uuid "a52921f6-35e3-5fd6-831b-5c76a68fe597" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186296138} :answer-field/id #uuid "aab0add4-30b0-59ee-8400-8a7cc1beaf29" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296994}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1328ee8c-fdcc-59c5-a877-6291af207d84" :question/math-academy-id "q-288596" :question/problem "Consider the equation in the variable $y,$ given by\n\n$$\n(q+9)y=-6\n$$\n\nwhere $q$ is a constant. Given that this equation has no solution, what is the value of $q?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=b\n$$\n\nwhere $a$ and $b$ are constants, and $b\\ne 0.$ If $a=0,$ then the equation has no solution.\n\nNotice that this equation is in the form $ay=b.$ In this case,\n\n$$\na=q+9,\\,b=-6.\n$$\n\nTherefore, the equation has no solution if\n\n$$\nq+9=0.\n$$\n\nSolving this for $q,$ we get\n\n$$\n\\begin{aligned}q+9 & =0 \\\\ q & =-9.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297198 :knowledge-point/_questions [{:db/id #edb/ref 17592186110721 :knowledge-point/id #uuid "4b1fd794-f42b-5316-80e9-0698cb1f8b87" :knowledge-point/title "Solving a General Equation With Infinitely Many Solutions For Unknown Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26dea449-5daa-571d-bc24-21b16885571b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186295478} {:answer/id #uuid "46ff9640-80f1-5703-b7a0-6219bb604868" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186295672} {:answer/id #uuid "7f368c30-e2fd-5534-8546-adacd3bdc62c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186295955} {:answer/id #uuid "bb0e5e07-5208-59c1-8031-79b63eb57a08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186296248} {:answer/id #uuid "e8efa7fd-e32d-5724-96bb-c481dd8ea2c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186296507}] :answer-field/correct {:answer/id #uuid "46ff9640-80f1-5703-b7a0-6219bb604868" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186295672} :answer-field/id #uuid "049c5b1b-3107-5777-ad7f-5a1a5ac925c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296646}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "afc322c5-285c-5560-a114-d1da26bf18af" :question/math-academy-id "q-288622" :question/problem "Consider the equation\n\n$$\n(m+2)x+5n=7x+15\n$$\n\nwhere $m$ and $n$ are constants. Given that this equation has infinitely many solutions, what is the value of $m+n?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax+b=cx+d\n$$\n\nwhere $a,b,c,$ and $d$ are constants. This equation has infinitely many solutions if \n\n$$\na=c\\,\\text{and}\\,b=d.\n$$\n\nTo determine the values of $m$ and $n$ such that the equation\n\n$$\n(m+2)x+5n=7x+15\n$$\n\nhas infinitely many solutions, we equate the coefficients of $x,$ and we equate the constants:\n\n- Equating the coefficients of $x,$ we have\n\n$$\nm+2=7.\n$$\n\nSolving this equation for $m,$ we get\n\n$$\n\\begin{aligned}m & =5.\\end{aligned}\n$$\n\n- Equating the constants, we have\n\n$$\n5n=15.\n$$\n\nSolving this equation for $n,$ we get\n\n$$\n\\begin{aligned}n & =3.\\end{aligned}\n$$\n\nFinally, since $m=5$ and $n=3,$ we have\n\n$$\nm+n=5+3=8.\n$$"}] [{:db/id #edb/ref 17592186297200 :knowledge-point/_questions [{:db/id #edb/ref 17592186110721 :knowledge-point/id #uuid "4b1fd794-f42b-5316-80e9-0698cb1f8b87" :knowledge-point/title "Solving a General Equation With Infinitely Many Solutions For Unknown Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28da790f-20c9-5875-b417-1be764fa2aeb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186295496} {:answer/id #uuid "8db21277-c307-578a-8ebf-d5c8733da1ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186296020} {:answer/id #uuid "c24c121c-9aae-5ae4-989f-173c011f7cdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186296294} {:answer/id #uuid "c7c8cfa6-04bf-59ad-b50b-09698209ddbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186296316} {:answer/id #uuid "e7994d65-33f9-5bec-9e19-0969a17a2b2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186296497}] :answer-field/correct {:answer/id #uuid "8db21277-c307-578a-8ebf-d5c8733da1ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186296020} :answer-field/id #uuid "a71ebbc6-abec-50c8-b8f1-d671ed8c0cf9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296986}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9f55693d-3dd0-5310-a538-5dcb7f69af97" :question/math-academy-id "q-288627" :question/problem "Consider the equation\n\n$$\n\\frac{p}{2}x+q=4x+20\n$$\n\nwhere $p$ and $q$ are constants. Given that this equation has infinitely many solutions, what is the value of $p+q?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax+b=cx+d\n$$\n\nwhere $a,b,c,$ and $d$ are constants. This equation has infinitely many solutions if \n\n$$\na=c\\,\\text{and}\\,b=d.\n$$\n\nTo determine the values of $p$ and $q$ such that the equation\n\n$$\n\\frac{p}{2}x+q=4x+20\n$$\n\nhas infinitely many solutions, we equate the coefficients of $x,$ and we equate the constants:\n\n- Equating the coefficients of $x,$ we have\n\n$$\n\\frac{p}{2}=4.\n$$\n\nSolving this equation for $p,$ we get\n\n$$\n\\begin{aligned}p & =8.\\end{aligned}\n$$\n\n- Equating the constants, we get\n\n$$\nq=20.\n$$\n\nFinally, since $p=8$ and $q=20,$ we have\n\n$$\np+q=8+20=28.\n$$"}] [{:db/id #edb/ref 17592186297213 :knowledge-point/_questions [{:db/id #edb/ref 17592186083388 :knowledge-point/id #uuid "c16a30bc-0c1a-54f2-95d6-47edb0c85736" :knowledge-point/title "Determining the Product of the Roots of a Quadratic Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79894418-732c-58c9-9ddb-c28b8aa917f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{6}" :db/id #edb/ref 17592186295931} {:answer/id #uuid "c7374353-ec78-5263-b05c-f6719c421c59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186296313} {:answer/id #uuid "dcff367f-1190-560a-bb1e-d83c05126b52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186296439} {:answer/id #uuid "fb46df49-667f-5745-8cbf-7537238ae05d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{6}" :db/id #edb/ref 17592186296604} {:answer/id #uuid "fef8aec2-f84b-51b7-bcb0-0ca5c486d888" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186296625}] :answer-field/correct {:answer/id #uuid "fef8aec2-f84b-51b7-bcb0-0ca5c486d888" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186296625} :answer-field/id #uuid "d1dc5883-eb26-5861-aa29-b6e4365854e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297070}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f379d5ac-6fe2-5ce8-b120-ae7f8d1580fe" :question/math-academy-id "q-288816" :question/problem "Consider the quadratic equation\n\n$$\n6{x}^{2}-17x-30=0.\n$$\n\n**Without** solving the equation, determine the product of its solutions." :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na=6,\\,b=-17,\\,c=-30.\n$$\n\nTherefore, the product of the solutions is\n\n$$\n\\begin{aligned}\\frac{c}{a} & =\\frac{(-30)}{6}=-5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186390572 :knowledge-point/_questions [{:db/id #edb/ref 17592186083388 :knowledge-point/id #uuid "c16a30bc-0c1a-54f2-95d6-47edb0c85736" :knowledge-point/title "Determining the Product of the Roots of a Quadratic Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a1d95b8-6f28-5ebe-ae92-d043359fa511" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,395" :db/id #edb/ref 17592186390574} {:answer/id #uuid "eed1e1d6-f081-50ba-9a0f-960b330272be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2)\\cdot 8\\,395" :db/id #edb/ref 17592186390575} {:answer/id #uuid "28190f64-9c46-5f7f-af80-807614a00568" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{146}{2}" :db/id #edb/ref 17592186390576} {:answer/id #uuid "6125f799-589f-5f34-b51a-3dae9be8eba0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\,395" :db/id #edb/ref 17592186390577} {:answer/id #uuid "9b4ae3e2-672a-57a7-8dcb-1c4b9825daed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-8\\,395}{146}" :db/id #edb/ref 17592186390578}] :answer-field/correct {:answer/id #uuid "6125f799-589f-5f34-b51a-3dae9be8eba0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\,395" :db/id #edb/ref 17592186390577} :answer-field/id #uuid "e368a500-4f4d-5598-bf19-014504f88343" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390573}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a60a042a-0631-504b-9c2c-28fdb04eadac" :question/math-academy-id "q-288819" :question/problem "Consider the quadratic equation\n\n$$\n{x}^{2}+146x-8\\,395=0.\n$$\n\n**Without** solving the equation, determine the product of its solutions." :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na=1,\\,b=146,\\,c=-8\\,395.\n$$\n\nTherefore, the product of the solutions is\n\n$$\n\\begin{aligned}\\frac{c}{a} & =\\frac{(-8\\,395)}{1}=-8\\,395.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297216 :knowledge-point/_questions [{:db/id #edb/ref 17592186083388 :knowledge-point/id #uuid "c16a30bc-0c1a-54f2-95d6-47edb0c85736" :knowledge-point/title "Determining the Product of the Roots of a Quadratic Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2567084b-b026-5eb4-b95e-0227a0635f61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "391" :db/id #edb/ref 17592186295471} {:answer/id #uuid "32c4576b-1351-5ac7-8694-de0426c7c366" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-391" :db/id #edb/ref 17592186295554} {:answer/id #uuid "71a3851f-e88d-5f38-b01f-fcaaad95d68b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-391}{41}" :db/id #edb/ref 17592186295893} {:answer/id #uuid "922397a2-e0b6-58f1-bde5-54e22966b2c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2)\\cdot 391" :db/id #edb/ref 17592186296054} {:answer/id #uuid "abf37a1f-02b7-5b10-aaaf-f70acb95ee5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{41}{2}" :db/id #edb/ref 17592186296172}] :answer-field/correct {:answer/id #uuid "32c4576b-1351-5ac7-8694-de0426c7c366" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-391" :db/id #edb/ref 17592186295554} :answer-field/id #uuid "29b0ff42-3a4a-57e5-b225-3f319bf73f19" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296715}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "edeac1f1-6a23-50a2-b07f-f8b62b91f0ee" :question/math-academy-id "q-288825" :question/problem "Consider the quadratic equation\n\n$$\n{x}^{2}+41x-391=0.\n$$\n\n**Without** solving the equation, determine the product of its solutions." :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na=1,\\,b=41,\\,c=-391.\n$$\n\nTherefore, the product of the solutions is\n\n$$\n\\begin{aligned}\\frac{c}{a} & =\\frac{(-391)}{1}=-391.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186111141 :knowledge-point/_questions [{:db/id #edb/ref 17592186110667 :knowledge-point/id #uuid "ce7ef1dd-58cc-57f5-9ff9-fc997f4280ee" :knowledge-point/title "Identifying True Statements Regarding an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14d716c0-c74a-57f6-833b-a5816bf99cd8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186295386} {:answer/id #uuid "67139bf8-96d1-5cee-b658-3ffcabbeb7f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186295848} {:answer/id #uuid "68c9ab76-11b5-597a-b277-a022ff7d7ce0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186295856} {:answer/id #uuid "8406301a-c3a9-5c90-b099-4f4b2c78ba3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186295973} {:answer/id #uuid "c5a38ae3-a755-5134-b132-4a013f680737" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186296308}] :answer-field/correct {:answer/id #uuid "14d716c0-c74a-57f6-833b-a5816bf99cd8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186295386} :answer-field/id #uuid "3cc8c0d6-c061-513b-98bf-4315a1ac025c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296752}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c4102b2c-f2ad-56ac-9dd6-7dd59719b972" :question/math-academy-id "q-28973" :question/problem "Which of the following statements are true in relation to the function $f(x)={(\\frac{2}{7})}^{x}?$\n\n- Its domain is $x\\in (-\\infty ,\\infty )$\n- Its range is $y\\in (0,\\infty )$\n- It is a decreasing function" :question/worked-solution "Let's start by recalling the graph of ${(\\frac{2}{7})}^{x}.$\n\n![](images/c1/c1bbffed32708d30355ed3592deae845d1a84cd1f1772ef1d0fae7ac39518295.png)\n\nLet's go through the statements one by one.\n\n- Statement I is true. The function $f(x)={(\\frac{2}{7})}^{x}$ is defined for all input values $x.$\n\n- Statement II is true. The set of possible outputs of $f(x)={(\\frac{2}{7})}^{x}$ consists of all the positive numbers.\n\n- Statement III is true. For $x\\in (-\\infty ,\\infty ),$ the graph of $y=f(x)$ falls. Therefore, $y=f(x)$ is a decreasing function.\n\nIn conclusion, statements I, II, and III are true."}] [{:db/id #edb/ref 17592186297222 :knowledge-point/_questions [{:db/id #edb/ref 17592186110667 :knowledge-point/id #uuid "ce7ef1dd-58cc-57f5-9ff9-fc997f4280ee" :knowledge-point/title "Identifying True Statements Regarding an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d7bb9f1-b157-599d-93ed-6607f6670caf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186295620} {:answer/id #uuid "57f33323-a574-5d3a-9709-4eb09849a56b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186295774} {:answer/id #uuid "a8d54f7c-6d02-5810-afd3-16ba3cfaf37c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186296154} {:answer/id #uuid "bba10e7d-2cc2-5341-a2f3-b9fb123d6f6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186296250} {:answer/id #uuid "e870b774-8e7e-5746-ab82-10ba9e3d3195" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186296503}] :answer-field/correct {:answer/id #uuid "3d7bb9f1-b157-599d-93ed-6607f6670caf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186295620} :answer-field/id #uuid "543e005e-a445-5e44-847a-061f1c3bcb23" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296804}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7c7808ae-1f8f-5217-b026-8ee08973156b" :question/math-academy-id "q-28981" :question/problem "Which of the following statements are true in relation to the function $f(x)=(0.08)^{x}?$\n\n- Its range is $y>0$\n- It is an increasing function\n- $f(x)\\to 0$ as $x\\to \\infty $" :question/worked-solution "Let's start by recalling the graph of ${(0.08)}^{x}.$\n\n![](images/b4/b4e3b5119c92d02bbceb786fefd238182c7c84ca0f4abc85a19f2df86a6ba267.png)\n\nLet's go through the statements one by one.\n\n- Statement I is true. The set of possible outputs of $f(x)={(0.08)}^{x}$ consists of all the positive numbers.\n\n- Statement II is false. For $x\\in (-\\infty ,\\infty ),$ the graph of $y=f(x)$ falls. Therefore, $y=f(x)$ is a decreasing function.\n\n- Statement III is true. As $x$ increases, the function value gets smaller and smaller, approaching zero. Therefore $f(x)\\to 0$ as $x\\to \\infty .$\n\nIn conclusion, only statements I and III are true."}] [{:db/id #edb/ref 17592186204605 :knowledge-point/_questions [{:db/id #edb/ref 17592186203961 :knowledge-point/id #uuid "58c7cd44-30a9-5f61-822c-13640ad41c93" :knowledge-point/title "Finding the Zeros of a Transformed Sine or Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b1117d8-3922-58c9-9530-2863e9f66fdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-{45}^{∘}+n\\cdot {180}^{∘}" :db/id #edb/ref 17592186295326} {:answer/id #uuid "1bf04524-d8f1-5e7a-91a7-879af77ff5ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={45}^{∘}" :db/id #edb/ref 17592186295431} {:answer/id #uuid "3c4a9f04-2536-5359-9635-1fd6075b188e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=n\\cdot {180}^{∘}" :db/id #edb/ref 17592186295612} {:answer/id #uuid "94fd6bb9-96bf-57e3-9aa7-5130e61029b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={90}^{∘}+n\\cdot {360}^{∘}" :db/id #edb/ref 17592186296062} {:answer/id #uuid "d478ba2a-8dd5-55b8-a559-1c7c60934547" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={45}^{∘}+n\\cdot {180}^{∘}" :db/id #edb/ref 17592186296386}] :answer-field/correct {:answer/id #uuid "d478ba2a-8dd5-55b8-a559-1c7c60934547" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={45}^{∘}+n\\cdot {180}^{∘}" :db/id #edb/ref 17592186296386} :answer-field/id #uuid "a9270dcb-2a83-5da1-b03e-a2f7992cae9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296992}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6cc77154-ecae-5ece-8bcc-9eb3f418b440" :question/math-academy-id "q-29132" :question/problem "Which expression gives all of the zeros of $y=3\\operatorname{cos}⁡(x+{45}^{∘})?$ Assume that $n$ is an integer." :question/worked-solution "First, let's start by defining a new variable $X$ as\n\n$$\nX=x+{45}^{∘}.\n$$\n\nSo, we need to calculate the zeros of \n\n$$\ny=3\\operatorname{cos}⁡X.\n$$\n\nThe zeros of this function are given by the following expression:\n\n$$\nX={90}^{∘}+n\\cdot {180}^{∘}\n$$\n\nwhere $n$ is an integer.\n\nTo find the zeros of our original function, we rewrite $X$ in terms of the original variable $x$ and solve the resulting equation for $x:$\n\n$$\n\\begin{aligned}X & ={90}^{∘}+n\\cdot {180}^{∘} \\\\ x+{45}^{∘} & ={90}^{∘}+n\\cdot {180}^{∘} \\\\ x+{45}^{∘}-{45}^{∘} & ={90}^{∘}+n\\cdot {180}^{∘}-{45}^{∘} \\\\ x & ={45}^{∘}+n\\cdot {180}^{∘}\\end{aligned}\n$$\n\nTherefore, we conclude that the zeros are $x={45}^{∘}+n\\cdot {180}^{∘},$ where $n$ is any integer."}] [{:db/id #edb/ref 17592186297232 :knowledge-point/_questions [{:db/id #edb/ref 17592186129101 :knowledge-point/id #uuid "8854eaba-96c7-5ea8-a071-7ff7c954f943" :knowledge-point/title "Finding a General Expression for the Asymptotes of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8266d9da-29ef-5142-889c-67032e696941" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={30}^{∘}+n\\cdot {180}^{∘}" :db/id #edb/ref 17592186295969} {:answer/id #uuid "8f36dd3b-18aa-5423-9a63-6be24cb45a5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={60}^{∘}+n\\cdot {45}^{∘}" :db/id #edb/ref 17592186296030} {:answer/id #uuid "b9a3b5aa-10fe-59e1-8b60-91383fc7c7a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={45}^{∘}+n\\cdot {90}^{∘}" :db/id #edb/ref 17592186296242} {:answer/id #uuid "ce3fe793-587a-5cb1-82ef-b60494e08387" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={90}^{∘}+n\\cdot {180}^{∘}" :db/id #edb/ref 17592186296347} {:answer/id #uuid "f5728d81-5718-5a99-b836-93226b4b6cc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=n\\cdot {180}^{∘}" :db/id #edb/ref 17592186296569}] :answer-field/correct {:answer/id #uuid "b9a3b5aa-10fe-59e1-8b60-91383fc7c7a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={45}^{∘}+n\\cdot {90}^{∘}" :db/id #edb/ref 17592186296242} :answer-field/id #uuid "3d308903-8122-5b47-a276-3957b8fde22e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296754}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "493ac61e-d5aa-548d-a691-2dfa99e52431" :question/math-academy-id "q-29349" :question/problem "Which of the following expressions gives all of the vertical asymptotes of the function $y=\\operatorname{tan}⁡(2x)-2,$ where $x$ is measured in degrees? Assume that $n$ is an integer." :question/worked-solution "The asymptotes of $y=\\operatorname{tan}⁡x$ are given by the following expression:\n\n$$\nx={90}^{∘}+n\\cdot {180}^{∘}\n$$\n\nTo find the asymptotes of $\\operatorname{tan}⁡(2x)-2,$ we replace the $x$ on the left-hand side of the above with $(2x).$ This gives:\n\n$$\n2x={90}^{∘}+n\\cdot {180}^{∘}\n$$\n\nSolving this for $x$ gives:\n\n$$\n\\begin{aligned}x & ={45}^{∘}+n\\cdot {90}^{∘}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297237 :knowledge-point/_questions [{:db/id #edb/ref 17592186129100 :knowledge-point/id #uuid "fabd8865-cc14-508a-aa81-4ba147f7f8d4" :knowledge-point/title "Finding a General Expression for the Zeros of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53c921c9-46e0-5bef-95de-0f5b588ebca5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{6}+\\frac{n\\pi }{2}" :db/id #edb/ref 17592186295749} {:answer/id #uuid "85d07a4f-56af-578a-a679-6e632e293884" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{12}+n\\pi " :db/id #edb/ref 17592186295983} {:answer/id #uuid "8c7e58fb-f78c-5c59-97d6-77d4f59a186a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{4}+\\frac{n\\pi }{2}" :db/id #edb/ref 17592186296016} {:answer/id #uuid "ab14ced1-375e-5455-909c-7a3ced2bd998" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{12}+\\frac{n\\pi }{2}" :db/id #edb/ref 17592186296164} {:answer/id #uuid "ee73340c-4d12-5b82-9ec4-7452a202940f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{6}+n\\pi " :db/id #edb/ref 17592186296533}] :answer-field/correct {:answer/id #uuid "ab14ced1-375e-5455-909c-7a3ced2bd998" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{12}+\\frac{n\\pi }{2}" :db/id #edb/ref 17592186296164} :answer-field/id #uuid "79362fdd-d341-5e89-bee7-6cb695806517" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296881}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "670b4725-4f5f-5e5b-81ee-7bebf6dbdf85" :question/math-academy-id "q-29556" :question/problem "Which of the following expressions gives all of the zeros of the function $f(x)=2\\operatorname{tan}⁡(2x-\\frac{\\pi }{6})?$ Assume that $n$ is an integer." :question/worked-solution "The zeros of $y=\\operatorname{tan}⁡x$ are given by\n\n$$\nx=n\\pi ,\n$$\n\nwhere $n$ is an integer.\n\nTo find the zeros of $f(x)=2\\operatorname{tan}⁡(2x-\\frac{\\pi }{6}),$ we replace the $x$ on the left-hand side of the above with $(2x-\\frac{\\pi }{6}).$ This gives\n\n$$\n2x-\\frac{\\pi }{6}=n\\pi .\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}2x-\\frac{\\pi }{6} & =n\\pi  \\\\ 2x & =n\\pi +\\frac{\\pi }{6} \\\\ x & =\\frac{\\pi }{12}+\\frac{n\\pi }{2}.\\end{aligned}\n$$\n\nTherefore, we conclude that the zeros are $x=\\frac{\\pi }{12}+\\frac{n\\pi }{2},$ where $n$ is an integer."}] [{:db/id #edb/ref 17592186297238 :knowledge-point/_questions [{:db/id #edb/ref 17592186176049 :knowledge-point/id #uuid "4241c7bd-4a2b-556f-be9f-8a884addebb9" :knowledge-point/title "Describing Properties of the Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "064a647e-d06a-50bb-9cbc-0f17389eca42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186295298} {:answer/id #uuid "1066d92d-62c9-5dad-8b4c-dbbe71386d05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186295362} {:answer/id #uuid "3f3a0291-6ad9-5566-9fd5-0de08933b4a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186295630} {:answer/id #uuid "8e8ba8e5-5fce-5a75-b9a3-f9b2aab87da3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186296026} {:answer/id #uuid "bb2ff4e9-ee34-51e6-b267-06c09d19013f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186296249}] :answer-field/correct {:answer/id #uuid "8e8ba8e5-5fce-5a75-b9a3-f9b2aab87da3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186296026} :answer-field/id #uuid "b1618392-44be-533c-81a8-efd84eeee3ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297006}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c5a3a079-0ec8-5b33-84d2-568517288149" :question/math-academy-id "q-29608" :question/problem "Which of the following statements are true regarding the function $y=tan⁡x?$ Assume that $n$ represents any integer.\n\n- The function has asymptotes at $x=n\\pi .$\n- $tan⁡(x)=tan⁡(x+2n\\pi ).$\n- The range of the function is $[-1,1].$" :question/worked-solution "Let's recall the graph of $y=tan⁡x.$\n\n![](images/31/31b430f003171dcc04a8f17402d6035fbbc305c244d3676bbf5da83fa447bd50.png)\n\nLet's examine each statement.\n\n- Statement I is false. The function $y=tan⁡x$ has asymptotes at $x=\\frac{\\pi }{2}+\\pi n.$\n\n- Statement II is true. The function has period $\\pi .$ So, $tan⁡(x+2n\\pi )=tan⁡(x+n\\pi +n\\pi )=tan⁡(x+n\\pi )=tan⁡(x).$\n\n- Statement III is false. The range of $y=tan⁡x$ is $(-\\infty ,+\\infty ).$"}] [{:db/id #edb/ref 17592186297248 :knowledge-point/_questions [{:db/id #edb/ref 17592186105715 :knowledge-point/id #uuid "cf98ee24-7774-5674-8a1e-63f4f6d225c0" :knowledge-point/title "Integrating a Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "155da407-c8ba-5fa2-9127-413d6bff8d2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3ln⁡x+C" :db/id #edb/ref 17592186295391} {:answer/id #uuid "2ca76ff5-0227-56f5-94be-d80b462a5d45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{ln⁡x}+C" :db/id #edb/ref 17592186295528} {:answer/id #uuid "5c5899f6-d895-5413-bfee-0587b9cf1149" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3ln⁡|x|+C" :db/id #edb/ref 17592186295802} {:answer/id #uuid "705c2710-b928-5586-a10e-67ac7d7acb16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3ln⁡|x|+C" :db/id #edb/ref 17592186295884} {:answer/id #uuid "bd595728-5d66-5fce-842a-829a9bf9e495" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-3}{ln⁡|x|}+C" :db/id #edb/ref 17592186296265}] :answer-field/correct {:answer/id #uuid "705c2710-b928-5586-a10e-67ac7d7acb16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3ln⁡|x|+C" :db/id #edb/ref 17592186295884} :answer-field/id #uuid "d6439f4c-9689-5960-aa2c-ca05e0a5ed1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297080}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f3f7435c-4593-5eb7-979c-b6475dc0ac4f" :question/math-academy-id "q-29831" :question/problem "Calculate $\\int -\\frac{3}{x}\\,\\text{d}x=$" :question/worked-solution "First, we apply the constant factor rule and take the coefficient $-3$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int -\\frac{3}{x}\\,\\text{d}x & =-3\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =-3ln⁡|x|+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297249 :knowledge-point/_questions [{:db/id #edb/ref 17592186105720 :knowledge-point/id #uuid "df7dddc6-a4fd-5b1b-9b73-8528e5224ca9" :knowledge-point/title "Integrating a Reciprocal Function and Simplifying the Arbitrary Constant Using the Laws of Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b9f3ccb-57a5-54e7-9651-cd8e38e071bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}ln⁡(5K|x|)" :db/id #edb/ref 17592186295330} {:answer/id #uuid "137963fa-e7bf-5b99-b97d-16a6e2b83b62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}ln⁡(K|x|)" :db/id #edb/ref 17592186295376} {:answer/id #uuid "3ba78d99-70e5-5576-9ab3-f6f5d63e5557" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}ln⁡(K|x|)" :db/id #edb/ref 17592186295610} {:answer/id #uuid "ab6cacd1-8561-54df-98e0-e7424109595d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-ln⁡(\\frac{5}{2}K|x|)" :db/id #edb/ref 17592186296168} {:answer/id #uuid "e35e2f64-0c17-5dfe-a27c-81e2452e3e98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}ln⁡(|x|+K)" :db/id #edb/ref 17592186296477}] :answer-field/correct {:answer/id #uuid "3ba78d99-70e5-5576-9ab3-f6f5d63e5557" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}ln⁡(K|x|)" :db/id #edb/ref 17592186295610} :answer-field/id #uuid "c450e82f-bb3f-51ae-bbf9-78580de51634" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297036}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eec65b66-7ead-5d6e-b179-5aacd453b9d8" :question/math-academy-id "q-29834" :question/problem "What is the antiderivative of $-\\frac{5}{2x}?$" :question/worked-solution "First, we apply the constant factor rule and take the coefficient $-\\frac{5}{2}$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int -\\frac{5}{2x}\\,\\text{d}x & =-\\frac{5}{2}\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =-\\frac{5}{2}ln⁡|x|+C.\\end{aligned}\n$$\n\nLastly, let's rewrite the constant so that we can combine it with the natural logarithm. For any constant $C,$ we can always write $C=-\\frac{5}{2}ln⁡K$ where $K$ is some other positive constant. Doing this allows us to combine the constant with $-\\frac{5}{2}ln⁡|x|$ term, and we get\n\n$$\n\\begin{aligned}\\int -\\frac{5}{2x}\\,\\text{d}x & =-\\frac{5}{2}ln⁡|x|-\\frac{5}{2}ln⁡K \\\\  & =-\\frac{5}{2}(ln⁡|x|+ln⁡K) \\\\  & =-\\frac{5}{2}ln⁡(K|x|).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297251 :knowledge-point/_questions [{:db/id #edb/ref 17592186105716 :knowledge-point/id #uuid "3c865ec2-5bed-5892-966b-a586097be923" :knowledge-point/title "Integrating the Sum of a Reciprocal Function and a Power Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "298a44ce-4517-57c9-8784-5136e6d9c6af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{5}{x}^{11/3}+\\sqrt{5}\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186295500} {:answer/id #uuid "2e55410d-693f-527e-b63c-efdd8027016a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{5}{x}^{4/3}+2\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186295534} {:answer/id #uuid "91074ff5-3842-537b-b69c-20abfee3093d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\operatorname{ln}⁡x}{5}{x}^{5/3}+\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186296046} {:answer/id #uuid "ae484638-462d-55ee-b006-7e7f7e36be1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{5}{x}^{7/3}+\\sqrt{3}\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186296183} {:answer/id #uuid "d6b38dca-ffa5-5659-aa91-113d55a9cced" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}{x}^{5/3}+\\sqrt{2}\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186296395}] :answer-field/correct {:answer/id #uuid "d6b38dca-ffa5-5659-aa91-113d55a9cced" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}{x}^{5/3}+\\sqrt{2}\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186296395} :answer-field/id #uuid "d4ea97da-7b64-5d03-a1a8-9448f2925fe1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297075}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a9a35970-b3a0-5bae-b863-30b3731d8d68" :question/math-academy-id "q-29885" :question/problem "Calculate $\\int ({x}^{2/3}+\\frac{\\sqrt{2}}{x})\\,\\text{d}x.$" :question/worked-solution "First, we apply the sum rule and get\n\n$$\n\\int ({x}^{2/3}+\\frac{\\sqrt{2}}{x})\\,\\text{d}x=\\int {x}^{2/3}\\,\\text{d}x+\\sqrt{2}\\int \\frac{1}{x}\\,\\text{d}x\n$$\n\nNow, using the power rule in the first term, and taking out the coefficient in the second term, we get\n\n$$\n\\begin{aligned}\\int {x}^{2/3}\\,\\text{d}x+\\sqrt{2}\\int \\frac{1}{x}\\,\\text{d}x & =\\frac{{x}^{2/3+1}}{\\frac{2}{3}+1}+\\sqrt{2}\\operatorname{ln}⁡|x|+C \\\\  & =\\frac{3}{5}{x}^{5/3}+\\sqrt{2}\\operatorname{ln}⁡|x|+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297254 :knowledge-point/_questions [{:db/id #edb/ref 17592186105716 :knowledge-point/id #uuid "3c865ec2-5bed-5892-966b-a586097be923" :knowledge-point/title "Integrating the Sum of a Reciprocal Function and a Power Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0abba1e8-07a5-5982-8931-920e2b54ed11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5ln⁡|x|+C" :db/id #edb/ref 17592186295324} {:answer/id #uuid "14c3a82a-71bb-5b22-a1d7-5d3ffaa433a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4ln⁡|x|+C" :db/id #edb/ref 17592186295384} {:answer/id #uuid "218a6eff-a0a2-5775-878d-fb334d854a63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4ln⁡|x|+C" :db/id #edb/ref 17592186295454} {:answer/id #uuid "5203ee4a-c762-565e-a1e7-1c414c5d786d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6x+C" :db/id #edb/ref 17592186295738} {:answer/id #uuid "e96a5e23-083b-5d3f-bddc-50fd9a0aed8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x+C" :db/id #edb/ref 17592186296509}] :answer-field/correct {:answer/id #uuid "14c3a82a-71bb-5b22-a1d7-5d3ffaa433a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4ln⁡|x|+C" :db/id #edb/ref 17592186295384} :answer-field/id #uuid "65380cf5-c8c6-595a-9584-e99d721414af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296843}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "77e80b12-44f5-5ee6-b586-d6d7898a0c32" :question/math-academy-id "q-29915" :question/problem "Find the integral of $\\frac{\\sqrt{{x}^{3}}}{\\sqrt{{x}^{5}}}-5{x}^{-1}$ with respect to $x.$" :question/worked-solution "Simplifying the exponents and applying the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int (\\frac{\\sqrt{{x}^{3}}}{\\sqrt{{x}^{5}}}-5{x}^{-1})\\text{d}x & =\\int \\frac{1}{{x}^{5/2-3/2}}\\,\\text{d}x-5\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =\\int \\frac{1}{x}\\,\\text{d}x-5\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =-4\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =-4ln⁡|x|+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297256 :knowledge-point/_questions [{:db/id #edb/ref 17592186068760 :knowledge-point/id #uuid "f7614a05-f221-5fda-b491-6893f44a1a5f" :knowledge-point/title "Dividing Rational Expressions with Multiple Common Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c4f1d16-78b3-5045-8bb5-5579fec4543a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11(k+2)}{{y}^{2}}" :db/id #edb/ref 17592186295613} {:answer/id #uuid "4d3602d9-f3c5-5344-8c7b-288df52749cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11{y}^{2}}{k+4}" :db/id #edb/ref 17592186295709} {:answer/id #uuid "93b20eed-4388-595a-84d8-977910934218" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{k+4}{{y}^{2}}" :db/id #edb/ref 17592186296058} {:answer/id #uuid "aa7ed919-742c-5a4c-b988-a4265e3f6f06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{44(k+2)}" :db/id #edb/ref 17592186296162} {:answer/id #uuid "e8492be0-a6b9-5d09-afa1-2e0f3bbeb2cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{22(k+2)}{{y}^{2}}" :db/id #edb/ref 17592186296502}] :answer-field/correct {:answer/id #uuid "e8492be0-a6b9-5d09-afa1-2e0f3bbeb2cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{22(k+2)}{{y}^{2}}" :db/id #edb/ref 17592186296502} :answer-field/id #uuid "17d9d487-4676-539c-9b1c-0c3a024bdb73" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296680}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "964f86e1-4f13-55f4-a1ab-8caf3da2db2d" :question/math-academy-id "q-29970" :question/problem "If $\\frac{2(k+2)}{121y}\\cdot Y=\\frac{4(k+2)^{2}}{11{y}^{3}},$ then what is $Y?$" :question/worked-solution "Since $\\frac{2(k+2)}{121y}\\cdot Y=\\frac{4(k+2)^{2}}{11{y}^{3}},$ we have\n\n$$\nY=\\frac{4(k+2)^{2}}{11{y}^{3}}÷\\frac{2(k+2)}{121y}.\n$$\n\nTo compute this quotient, we just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{4(k+2)^{2}}{11{y}^{3}}÷\\frac{2(k+2)}{121y} & = \\\\ \\frac{4(k+2)^{2}}{11{y}^{3}}\\cdot \\frac{121y}{2(k+2)} & = \\\\ \\frac{2\\cdot 2(k+2)\\cdot (k+2)}{11y\\cdot {y}^{2}}\\cdot \\frac{11\\cdot 11y}{2(k+2)} & = \\\\ \\frac{2\\cdot \\cancel{2(k+2)}\\cdot (k+2)}{\\cancel{11y}\\cdot {y}^{2}}\\cdot \\frac{11\\cdot \\cancel{11y}}{\\cancel{2(k+2)}} & = \\\\ \\frac{2(k+2)}{{y}^{2}}\\cdot 11 & = \\\\ \\frac{22(k+2)}{{y}^{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069217 :knowledge-point/_questions [{:db/id #edb/ref 17592186068860 :knowledge-point/id #uuid "9d78ba1c-5297-5540-afdc-d419d33e0cf7" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Rational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9253c945-96c0-5170-ab31-77a3ad0f24d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p + q = 7, x_{1} + x_{2} = 4" :db/id #edb/ref 17592186066485} {:answer/id #uuid "a2710526-3439-5d45-a3cb-b94809df5d4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p + q = 9, x_{1} + x_{2} = 4" :db/id #edb/ref 17592186066486} {:answer/id #uuid "b5eac8af-989a-5812-82cd-e6e80a244860" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p + q = 7, x_{1} + x_{2} =-4" :db/id #edb/ref 17592186066487} {:answer/id #uuid "cec6266a-38e0-5082-ae2c-0c20a9b251e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p + q = 7, x_{1} + x_{2} = 6" :db/id #edb/ref 17592186066488} {:answer/id #uuid "d0b0d285-5968-53b9-b5b2-00fcaf5e3048" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p + q =-11x_{1} + x_{2} = 4" :db/id #edb/ref 17592186066489}] :answer-field/id #uuid "d792d360-b68f-53ea-add1-82615c19183b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186066484} {:answer-field/choices [{:answer/id #uuid "76d7ebef-b52d-5f30-ac74-d49866c8f6a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=7\\,,\\,\\,{x}_{1}+{x}_{2}=4" :db/id #edb/ref 17592186401956} {:answer/id #uuid "d00f8b18-cb37-5c31-961a-3438330ad683" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=7\\,,\\,\\,{x}_{1}+{x}_{2}=6" :db/id #edb/ref 17592186401957} {:answer/id #uuid "ae0444d5-a369-5e49-89bd-c5ebc8c0237a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=-11\\,\\,\\,{x}_{1}+{x}_{2}=4" :db/id #edb/ref 17592186401958} {:answer/id #uuid "44f7e400-b932-5f1e-a0ab-bdb9a22e3846" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=7\\,,\\,\\,{x}_{1}+{x}_{2}=-4" :db/id #edb/ref 17592186401959} {:answer/id #uuid "7d8857d6-881c-5549-bde0-3f1a4f61d2d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=9\\,,\\,\\,{x}_{1}+{x}_{2}=4" :db/id #edb/ref 17592186401960}] :answer-field/correct {:answer/id #uuid "76d7ebef-b52d-5f30-ac74-d49866c8f6a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=7\\,,\\,\\,{x}_{1}+{x}_{2}=4" :db/id #edb/ref 17592186401956} :answer-field/id #uuid "b5fa6494-6274-595a-88b0-e033638de4a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401955}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c02e0e4e-c511-5b9e-9632-6db46dfe1bf6" :question/math-academy-id "q-30052" :question/problem "The equation ${x}^{2}-4x+4=9$ can be written in the form $(x+p)^{2}=q.$ Find $\\,p+q,$ and the sum of the roots ${x}_{1}+{x}_{2}.$" :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-4x+4 & =9 \\\\ {x}^{2}-4x & =5 \\\\ {x}^{2}-2\\cdot 2\\cdot x & =5 \\\\ {x}^{2}-2\\cdot 2\\cdot x+{2}^{2}-{2}^{2} & =5 \\\\ ({x}^{2}-2\\cdot 2\\cdot x+{2}^{2})-4 & =5 \\\\ (x-2)^{2}-4 & =5\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(x-2)^{2}-4 & =5 \\\\ (x-2)^{2} & =9\\end{aligned}\n$$\n\nSo, $p=-2,q=9,$ and $p+q=7.$\n\nNow, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(x-2)^{2} & =9 \\\\ \\sqrt{(x-2)^{2}} & =\\sqrt{9} \\\\ x-2 & =\\pm 3 \\\\ x & =2\\pm 3\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =2+3=5 \\\\ {x}_{2} & =2-3=-1\\end{aligned}\n$$\n\nSo, the solutions are ${x}_{1}=-1$ and ${x}_{2}=5.$ Thus, the sum is $4.$"}] [{:db/id #edb/ref 17592186401961 :knowledge-point/_questions [{:db/id #edb/ref 17592186068860 :knowledge-point/id #uuid "9d78ba1c-5297-5540-afdc-d419d33e0cf7" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Rational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f24ab63d-b4d8-50ae-8389-5045b51319bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=0\\,$ and $\\,{x}_{1}+{x}_{2}=2$" :db/id #edb/ref 17592186401963} {:answer/id #uuid "6c1507f7-b1b3-56e3-a38c-1b563d660137" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=1$" :db/id #edb/ref 17592186401964} {:answer/id #uuid "b2d7f47d-c746-5735-9e9f-835593e46fab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=2$" :db/id #edb/ref 17592186401965} {:answer/id #uuid "aa922213-ad7d-513f-ad50-36362f5e8cc5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=1\\,$ and $\\,{x}_{1}+{x}_{2}=2$" :db/id #edb/ref 17592186401966} {:answer/id #uuid "b9d50863-24e6-52af-928c-18cf82d1862f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=-1$" :db/id #edb/ref 17592186401967}] :answer-field/correct {:answer/id #uuid "b2d7f47d-c746-5735-9e9f-835593e46fab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=2$" :db/id #edb/ref 17592186401965} :answer-field/id #uuid "5f724395-4532-5650-9bbb-1b5a58b225fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401962}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "85741874-6828-5db4-a1ab-e8bb9b524df8" :question/math-academy-id "q-30055" :question/problem "The equation ${x}^{2}-2x+1=1$ can be written in the form $(x+p)^{2}=q.$ Find $\\,pq\\,,$ and the sum of the roots ${x}_{1}+{x}_{2}.$" :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-2x+1 & =1 \\\\ {x}^{2}-2x & =0 \\\\ {x}^{2}-2\\cdot x\\cdot 1+{1}^{2}-{1}^{2} & =0 \\\\ (x-1)^{2}-{1}^{2} & =0 \\\\ (x-1)^{2} & =1\\end{aligned}\n$$\n\nHence, $p=-1$ and $q=1.$ Thus, $pq=-1.$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-1)^{2} & =1 \\\\ \\sqrt{(x-1)^{2}} & =\\sqrt{1} \\\\ |x-1| & =1 \\\\ x-1 & =\\pm 1 \\\\ x & =1\\pm 1\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =1-1=0 \\\\ {x}_{2} & =1+1=2\\end{aligned}\n$$\n\nTherefore, the sum is ${x}_{1}+{x}_{2}=2.$"}] [{:db/id #edb/ref 17592186297279 :knowledge-point/_questions [{:db/id #edb/ref 17592186087823 :knowledge-point/id #uuid "40eeb5a8-3ffe-54d2-b263-f2b1c41fed93" :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0265ab4b-e69c-58cd-bb39-877b73f3298f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,11.5)" :db/id #edb/ref 17592186295275} {:answer/id #uuid "6ab493a4-b37f-5582-a8b9-4570920c001f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(10.5,0)" :db/id #edb/ref 17592186295861} {:answer/id #uuid "a1678182-8bd9-5b40-83a4-560b3c92dfe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,10.5)" :db/id #edb/ref 17592186296126} {:answer/id #uuid "ecdd579a-68d8-530f-aec2-948295be5064" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,5.5)" :db/id #edb/ref 17592186296522} {:answer/id #uuid "f541b6c1-d1ab-5c71-9e34-c29b7b48861a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5.5,0)" :db/id #edb/ref 17592186296566}] :answer-field/correct {:answer/id #uuid "a1678182-8bd9-5b40-83a4-560b3c92dfe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,10.5)" :db/id #edb/ref 17592186296126} :answer-field/id #uuid "b0972749-6df3-5836-b156-61b2f017bcaf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297005}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "91d38446-45fe-5f55-b13c-726fa96fa8c7" :question/math-academy-id "q-30269" :question/problem "For the curve $y=2.5({1.5}^{x})+8$, find the point of intersection with the $y-$axis." :question/worked-solution "**Method 1**\n\n- For the curve $y={1.5}^{x},$ the point of intersection with the $y$-axis is $(0,1).$\n\n- For the scaled function $y=2.5({1.5}^{x}),$ the $y$-coordinate becomes\n\n$$\ny=2.5\\cdot 1=2.5.\n$$\n\n- Finally, after a vertical shift of $8$ units up, we get a point with the $y$-coordinate\n\n$$\ny=2.5+8=10.5.\n$$\n\n**Method 2** \n\nTo find the $y$-intercept, we substitute $x=0$ into the equation of the curve:\n\n$$\n\\begin{aligned}y & =2.5({1.5}^{0})+8 \\\\  & =2.5\\cdot 1+8 \\\\  & =2.5+8 \\\\  & =10.5\\end{aligned}\n$$\n\nTherefore, $y=2.5({1.5}^{x})+8$ intercepts the $y$-axis at $(0,10.5).$"}] [{:db/id #edb/ref 17592186297286 :knowledge-point/_questions [{:db/id #edb/ref 17592186064207 :knowledge-point/id #uuid "bdbfa506-08a1-5e43-b958-2ae373df775d" :knowledge-point/title "Integrating a Linear Rational Function and Simplifying the Arbitrary Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dbf09c3-18df-50a3-84f7-e6f47d2ef7a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\operatorname{ln}⁡(K|3x+4|)" :db/id #edb/ref 17592186295347} {:answer/id #uuid "6e3b22d0-1d8f-5569-b6bf-7b7599fb5580" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡(K|3x+4|)" :db/id #edb/ref 17592186295876} {:answer/id #uuid "962c31da-ae4b-5022-8358-2aec9b89c95b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(K|3x+4|)" :db/id #edb/ref 17592186296067} {:answer/id #uuid "b8e4ad65-9186-54e0-8792-0e53759b7716" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡(K|3x+4|)" :db/id #edb/ref 17592186296235} {:answer/id #uuid "fa999cda-1369-5935-898a-85571f00711c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}\\operatorname{ln}⁡(K|3x+4|)" :db/id #edb/ref 17592186296595}] :answer-field/correct {:answer/id #uuid "b8e4ad65-9186-54e0-8792-0e53759b7716" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡(K|3x+4|)" :db/id #edb/ref 17592186296235} :answer-field/id #uuid "6dfec598-1f66-5fc7-8005-3949a52a7718" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296863}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "60fb4a8e-0b44-516d-9ebb-a8d91494c67e" :question/math-academy-id "q-30368" :question/problem "Calculate $\\int \\frac{1}{3x+4}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "First, let $u=3x+4.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{3x+4}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡|3x+4|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=\\frac{1}{3}\\operatorname{ln}⁡K$ for another arbitrary constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}\\frac{1}{3}\\operatorname{ln}⁡|3x+4|+C & =\\frac{1}{3}\\operatorname{ln}⁡|3x+4|+\\frac{1}{3}\\operatorname{ln}⁡K \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡(K|3x+4|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{1}{3x+4}\\,\\text{d}x=\\frac{1}{3}\\operatorname{ln}⁡(K|3x+4|).\n$$"}] [{:db/id #edb/ref 17592186297305 :knowledge-point/_questions [{:db/id #edb/ref 17592186087823 :knowledge-point/id #uuid "40eeb5a8-3ffe-54d2-b263-f2b1c41fed93" :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e5493f0-49e5-5ac0-a64b-444f26facf5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-10)" :db/id #edb/ref 17592186295811} {:answer/id #uuid "cedf3ffd-b468-57c5-a1fb-5644942d8367" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,7)" :db/id #edb/ref 17592186296352} {:answer/id #uuid "d228956c-dabb-5adf-b1f0-eea00077c044" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-7)" :db/id #edb/ref 17592186296375} {:answer/id #uuid "e5e90daa-a470-5b92-aeb7-f90fc7f25a72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-6)" :db/id #edb/ref 17592186296492} {:answer/id #uuid "ec3169b4-14de-5f3c-837e-5d327959c0c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,10)" :db/id #edb/ref 17592186296521}] :answer-field/correct {:answer/id #uuid "d228956c-dabb-5adf-b1f0-eea00077c044" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-7)" :db/id #edb/ref 17592186296375} :answer-field/id #uuid "9ef5eb88-b39d-569b-bc4c-949ed152d723" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296969}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5fda2bca-a959-55aa-9acd-07aede112347" :question/math-academy-id "q-30873" :question/problem "For the curve $y=1.5({10}^{x})-8.5$, find the point of intersection with the $y-$axis." :question/worked-solution "**Method 1**\n\n- For the curve $y={10}^{x},$ the point of intersection with the $y$-axis is $(0,1).$\n\n- For the scaled function $y=1.5({10}^{x}),$ the $y$-coordinate becomes\n\n$$\ny=1.5\\cdot 1=1.5.\n$$\n\n- Finally, after a vertical shift of $8.5$ units down, we get a point with the $y$-coordinate\n\n$$\ny=1.5-8.5=-7.\n$$\n\n**Method 2** \n\nTo find the $y$-intercept, we substitute $x=0$ into the equation of the curve:\n\n$$\n\\begin{aligned}y & =1.5({10}^{0})-8.5 \\\\  & =1.5\\cdot 1-8.5 \\\\  & =1.5-8.5 \\\\  & =-7\\end{aligned}\n$$\n\nTherefore, $y=1.5({10}^{x})-8.5$ intercepts the $y$-axis at $(0,-7).$"}] [{:db/id #edb/ref 17592186390592 :knowledge-point/_questions [{:db/id #edb/ref 17592186068829 :knowledge-point/id #uuid "5bb394c3-cd7c-523d-88df-b1306d9d528f" :knowledge-point/title "Identifying a Vertically Shifted Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c95a3fca-97ff-5e46-ad67-42c5b5b68ef4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bc/bc4c0c21c45fc3ed02d88150facf89718896a3e2992105f5a8a5d89b0355f9e0.png" :db/id #edb/ref 17592186390594} {:answer/id #uuid "73326b1a-1067-5996-991e-bb9d853a4e78" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e6/e6edb90966ce90a141e3fa4ee1a9eb3cf9c7131e3121e45f56b16bc4395076d5.png" :db/id #edb/ref 17592186390595} {:answer/id #uuid "e7a74885-a855-53a6-a12b-5c1f9db59688" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/06/062274f402396a61c76fae3a47c54de80ad31deac970c746f3f8f4627ce535f1.png" :db/id #edb/ref 17592186390596} {:answer/id #uuid "dbeafe1a-8a14-5f3a-8d70-6e398d0ebc6b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b3/b3f96cf981a9c127dd0e3c0fa3b73f548db8c640bbc4f0e048b4576356b69532.png" :db/id #edb/ref 17592186390597} {:answer/id #uuid "44eec2a2-c1e5-5830-a6f1-3345cbd3b0c0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b4/b48f88ac53107fddece776c81d91fc5684c7d6f06ea3b862fb99cd973eae2dc3.png" :db/id #edb/ref 17592186390598}] :answer-field/correct {:answer/id #uuid "73326b1a-1067-5996-991e-bb9d853a4e78" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e6/e6edb90966ce90a141e3fa4ee1a9eb3cf9c7131e3121e45f56b16bc4395076d5.png" :db/id #edb/ref 17592186390595} :answer-field/id #uuid "a5e7cf18-216c-59ac-8255-427849d7152c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390593}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f6a50d86-9c2e-59fc-b26e-b4043bba0c39" :question/math-academy-id "q-31146" :question/problem "Which of the following is the graph of  $y={(\\frac{1}{12})}^{x}-4?$" :question/worked-solution "First we plot the graph of $y={(\\frac{1}{12})}^{x}:$\n\n![](images/e2/e2f13711ca62a8a4a698e23bdfe78caca6df44d88ded27b88c517219dffbb866.png)\n\nNext, we shift this graph $4$ units down. \nThe horizontal asymptote under such a transformation becomes $y=-4,$ the $y$-intercept becomes $(0,-3).$\nThe resulting graph of $y={(\\frac{1}{12})}^{x}-4$ is shown below.\n\n![](images/dc/dc7f93220ac18ac5671b7b41de141940ca5296139b836d56755fdccf6164ed26.png)"}] [{:db/id #edb/ref 17592186064731 :knowledge-point/_questions [{:db/id #edb/ref 17592186064171 :knowledge-point/id #uuid "3f9548e6-28ef-5a97-ab04-dfb1b6e23c16" :knowledge-point/title "Integrating the Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cfff078-9fb4-5b67-bb26-7811957a40b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{e}^{ln⁡x}+C" :db/id #edb/ref 17592186295341} {:answer/id #uuid "36c4e4d8-ea74-510a-8195-fcca114fa7c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{e}^{x}}{2}+C" :db/id #edb/ref 17592186295573} {:answer/id #uuid "4d71c1ee-dea6-5890-90dd-6cf50a8cd3a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-2x}+C" :db/id #edb/ref 17592186295711} {:answer/id #uuid "bc3c34e1-3b8b-568c-889c-57fe85dd59ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{e}^{x}+C" :db/id #edb/ref 17592186296256} {:answer/id #uuid "cd13943f-d3e1-5920-9b15-4d7240e4db43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{{e}^{x}}+C" :db/id #edb/ref 17592186296342}] :answer-field/correct {:answer/id #uuid "bc3c34e1-3b8b-568c-889c-57fe85dd59ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{e}^{x}+C" :db/id #edb/ref 17592186296256} :answer-field/id #uuid "b94705d1-73b6-521f-a07d-12831457766a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297018}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f474ed40-025d-552e-9e67-da66415ffc42" :question/math-academy-id "q-31245" :question/problem "$\\int -2{e}^{x}\\,\\text{d}x=$" :question/worked-solution "Factoring out the constant $-2$ and calculating the resulting integral, we get\n\n$$\n\\begin{aligned}\\int -2{e}^{x}\\,\\text{d}x & =-2\\int {e}^{x}\\,\\text{d}x \\\\  & =-2{e}^{x}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297342 :knowledge-point/_questions [{:db/id #edb/ref 17592186064177 :knowledge-point/id #uuid "980bb2fb-4bb5-5cbb-aea8-87010493c013" :knowledge-point/title "Integrating a Sum of Exponential Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ddda862-700e-5259-8a9b-324825fe885d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{x}+\\frac{{3}^{x}}{ln⁡2}+\\frac{{x}^{2}}{3}+C" :db/id #edb/ref 17592186295436} {:answer/id #uuid "3b3aafd2-10f8-5647-aeef-217f0b123766" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{x}-\\frac{{3}^{x}}{ln⁡3}+\\frac{{x}^{3}}{3}+C" :db/id #edb/ref 17592186295606} {:answer/id #uuid "4aaae1a6-c031-5bc5-a104-23401003f961" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{3}^{x}}{ln⁡3}+{x}^{2}+{e}^{x}+C" :db/id #edb/ref 17592186295691} {:answer/id #uuid "531024e5-c103-583c-92eb-e4200ac7a6df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{3x}-\\frac{{3}^{2x}}{ln⁡x}+\\frac{{x}^{2}}{2}+C" :db/id #edb/ref 17592186295744} {:answer/id #uuid "56637843-7c20-5243-80d5-7c1405ee9de3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{2}^{x}}{ln⁡2}+\\frac{{x}^{2}}{2}-3{e}^{x}+C" :db/id #edb/ref 17592186295769}] :answer-field/correct {:answer/id #uuid "3b3aafd2-10f8-5647-aeef-217f0b123766" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{x}-\\frac{{3}^{x}}{ln⁡3}+\\frac{{x}^{3}}{3}+C" :db/id #edb/ref 17592186295606} :answer-field/id #uuid "32505d16-6c49-5e59-9ed0-fdcb1b385a52" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296726}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "42f6b48b-f5fd-5245-b823-ea76a025e943" :question/math-academy-id "q-31252" :question/problem "$\\int (2{e}^{x}-{3}^{x}+{x}^{2})\\,\\text{d}x=$" :question/worked-solution "Here, we combine the sum rule and our exponential rules to get\n\n$$\n\\begin{aligned}\\int (2{e}^{x}-{3}^{x}+{x}^{2})\\,\\text{d}x & =2\\int {e}^{x}\\,\\text{d}x-\\int {3}^{x}\\,\\text{d}x+\\int {x}^{2}\\,\\text{d}x \\\\  & =2{e}^{x}-\\frac{{3}^{x}}{ln⁡3}+\\frac{{x}^{3}}{3}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115727 :knowledge-point/_questions [{:db/id #edb/ref 17592186115190 :knowledge-point/id #uuid "bbb56f0a-ead0-5794-9e33-7fe0e1f87dc6" :knowledge-point/title "Differentiating Expressions Involving the Cosecant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "136ad750-eb9e-5055-a26a-c8cda8dba5ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+6csc⁡xcot⁡x" :db/id #edb/ref 17592186295374} {:answer/id #uuid "1cce689b-d66b-5419-b42f-1c935770579a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-6csc⁡xcot⁡x" :db/id #edb/ref 17592186295433} {:answer/id #uuid "4c7cbd2b-769e-5c2a-8198-1408890da6d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2+6csc⁡xcot⁡x" :db/id #edb/ref 17592186295702} {:answer/id #uuid "be094b01-e8a4-5075-a548-43ad86b83a02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+6csc⁡xcot⁡x" :db/id #edb/ref 17592186296269} {:answer/id #uuid "e0c1681e-054f-5ee6-ac7d-f24a14f0c567" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+6csc⁡xcot⁡x" :db/id #edb/ref 17592186296463}] :answer-field/correct {:answer/id #uuid "e0c1681e-054f-5ee6-ac7d-f24a14f0c567" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+6csc⁡xcot⁡x" :db/id #edb/ref 17592186296463} :answer-field/id #uuid "ed22d9b2-1f65-5896-a2a0-0c98a0de1f14" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297120}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "683c5003-d2ff-5388-892e-f05923834b32" :question/math-academy-id "q-31283" :question/problem "Find ${f}^{′}(x)$ if $f(x)={x}^{2}-6csc⁡x.$" :question/worked-solution "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}-6csc⁡x) \\\\  & =2x-6(-csc⁡xcot⁡x) \\\\  & =2x+6csc⁡xcot⁡x\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297368 :knowledge-point/_questions [{:db/id #edb/ref 17592186064282 :knowledge-point/id #uuid "8ef81a0d-5a3a-5d7c-83e9-7d9ed0e8c5c6" :knowledge-point/title "Differentiating a Reciprocal Trigonometric Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "074a9ec9-6bfa-51c3-b293-a2e6c7634c3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186295302} {:answer/id #uuid "3b8e6cf9-9f11-5e02-a08b-b0ce3fd9f2b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186295608} {:answer/id #uuid "64d5cac3-e49f-55a4-a517-b40d5927cff8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186295841} {:answer/id #uuid "748fff53-6b97-5ddb-a2b7-7573ce8fffb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186295904} {:answer/id #uuid "c09b0310-1b57-58cd-bbcf-bbf81a785509" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186296283}] :answer-field/correct {:answer/id #uuid "3b8e6cf9-9f11-5e02-a08b-b0ce3fd9f2b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186295608} :answer-field/id #uuid "67494433-5316-509e-bbfc-ae0d8a99e4af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296848}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8d5db746-ab9b-5b5a-bc25-31e21fc4632d" :question/math-academy-id "q-31338" :question/problem "Find the slope of $f(x)=\\operatorname{cot}⁡(2\\pi -3x)$ at $x=\\frac{\\pi }{2}.$" :question/worked-solution "The slope of $y=f(x)$ at $x=\\frac{\\pi }{2}$ is given by ${f}^{′}(\\frac{\\pi }{2}).$\n\nWe will calculate ${f}^{′}(x)$ using the chain rule. First, we express $f(x)$ as the composite function\n\n$$\nf=\\operatorname{cot}⁡u,\\,u=2\\pi -3x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=-{csc}^{2}⁡u\\,\\text{and}\\,\\frac{\\text{d}u}{\\text{d}x}=-3.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-{csc}^{2}⁡u\\cdot (-3) \\\\  & =3{csc}^{2}⁡(2\\pi -3x).\\end{aligned}\n$$\n\nEvaluating at $x=\\frac{\\pi }{2},$ we find\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(\\frac{\\pi }{2}) & =3{csc}^{2}⁡(2\\pi -\\frac{3\\pi }{2}) \\\\  & =3{csc}^{2}⁡(\\frac{\\pi }{2}) \\\\  & =3\\cdot {1}^{2} \\\\  & =3.\\end{aligned}\\end{aligned}\n$$\n\nTherefore, the slope of $y=f(x)$ at $x=\\frac{\\pi }{2}$ is $3.$"}] [{:db/id #edb/ref 17592186297371 :knowledge-point/_questions [{:db/id #edb/ref 17592186096742 :knowledge-point/id #uuid "f3ee0d5d-0821-5f6b-b613-6b814e65df50" :knowledge-point/title "Calculating a Derivative Using Multiple Instances of the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "143d951a-1e7a-598c-ab01-6ac4eebb972d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20{cot}^{3}⁡1{csc}^{2}⁡1" :db/id #edb/ref 17592186295381} {:answer/id #uuid "80ac022d-2fa2-5312-b6bb-20edccc427c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{cot}^{3}⁡1{sec}^{2}⁡1" :db/id #edb/ref 17592186295959} {:answer/id #uuid "cfd53f52-57a0-58c2-84e5-51e7836dcaa8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4{cot}^{2}⁡1{csc}^{2}⁡1" :db/id #edb/ref 17592186296358} {:answer/id #uuid "df819a99-e827-5e8d-8038-4bdc1f81e2b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20\\operatorname{cot}⁡1{sec}^{2}⁡1" :db/id #edb/ref 17592186296451} {:answer/id #uuid "f7c37201-fff5-5a86-9be9-3c9d741d2eaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4{cot}^{3}⁡1{csc}^{2}⁡1" :db/id #edb/ref 17592186296584}] :answer-field/correct {:answer/id #uuid "143d951a-1e7a-598c-ab01-6ac4eebb972d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20{cot}^{3}⁡1{csc}^{2}⁡1" :db/id #edb/ref 17592186295381} :answer-field/id #uuid "c18783dd-cacf-52c8-94df-17f7aaad8258" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297033}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "60550674-e8b4-5f20-9b57-5b71c82e6894" :question/math-academy-id "q-31361" :question/problem "Find ${f}^{′}(0)$ when $f(x)={cot}^{4}⁡(5x-1).$" :question/worked-solution "First, we express $f$ as the composite function\n\n$$\nf={u}^{4},\\,u=\\operatorname{cot}⁡v,\\,v=5x-1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=4{u}^{3},\\,\\frac{\\text{d}u}{\\text{d}v}=-{csc}^{2}⁡v,\\,\\frac{\\text{d}v}{\\text{d}x}=5.\n$$\n\nApplying now the chain rule twice, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}v}\\cdot \\frac{\\text{d}v}{\\text{d}x} \\\\  & =4{u}^{3}\\cdot (-{csc}^{2}⁡v)\\cdot 5 \\\\  & =4(\\operatorname{cot}⁡(5x-1))^{3}\\cdot (-{csc}^{2}⁡(5x-1))\\cdot 5 \\\\  & =-20{cot}^{3}⁡(5x-1){csc}^{2}⁡(5x-1)\\end{aligned}\n$$\n\nNow we compute ${f}^{′}(0):$\n\n$$\n\\begin{aligned}{f}^{′}(0) & =-20{cot}^{3}⁡(5(0)-1){csc}^{2}⁡(5(0)-1) \\\\  & =-20{cot}^{3}⁡(-1){csc}^{2}⁡(-1) \\\\  & =-20(-{cot}^{3}⁡1){csc}^{2}⁡1 \\\\  & =20{cot}^{3}⁡1{csc}^{2}⁡1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069235 :knowledge-point/_questions [{:db/id #edb/ref 17592186068830 :knowledge-point/id #uuid "617f0fe6-7998-5d77-b11f-55a0eca11440" :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84ebbe2d-74ec-5380-9a07-702d026d313d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/73/73590d55299fc519582252723f34bfa143818da7f03a16f7aeb8d208217ee3d4.png" :db/id #edb/ref 17592186066589} {:answer/id #uuid "00accd83-f7f9-57bb-aa6e-78f38f349bb6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b5/b53396e5736d8e09a11acef07594950ee50a0c027e190f0c8eb85880cf721494.png" :db/id #edb/ref 17592186066590} {:answer/id #uuid "0e7e45dc-8e5a-5e38-a11e-07a10f544e45" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c8/c8652694c97439511e4098e2b8f3d9d1e9727d9953d32348164c3ff7f741f22c.png" :db/id #edb/ref 17592186066591} {:answer/id #uuid "319a2339-b438-5f58-b459-e90c8e2d9866" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a8/a84109a9d68fe4b185ede5ab47c8ea2c07acd609367b629b594ab0b8e415bc82.png" :db/id #edb/ref 17592186066592} {:answer/id #uuid "7941c9a0-4881-5921-a1a9-38e914122b39" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7e/7e457f65868b58c9246d17744317ad6f76a96c8bd3b024f4fe2d37523a6490fa.png" :db/id #edb/ref 17592186066593}] :answer-field/id #uuid "375a8c1c-ecfc-5e8e-99de-762874c0a19a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186066588} {:answer-field/choices [{:answer/id #uuid "f871c9fe-ce5c-57e0-b3ab-1c1c8b065a12" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b5/b53396e5736d8e09a11acef07594950ee50a0c027e190f0c8eb85880cf721494.png" :db/id #edb/ref 17592186390607} {:answer/id #uuid "3dfaa41c-4be2-5d25-a838-46703edf0110" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a8/a84109a9d68fe4b185ede5ab47c8ea2c07acd609367b629b594ab0b8e415bc82.png" :db/id #edb/ref 17592186390608} {:answer/id #uuid "857c287c-8899-5fbc-b5f9-5a9ea6523a2e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7e/7e457f65868b58c9246d17744317ad6f76a96c8bd3b024f4fe2d37523a6490fa.png" :db/id #edb/ref 17592186390609} {:answer/id #uuid "b422f31c-7ac6-593f-9a66-3623920a036a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/73/73590d55299fc519582252723f34bfa143818da7f03a16f7aeb8d208217ee3d4.png" :db/id #edb/ref 17592186390610} {:answer/id #uuid "e921280b-88b6-51bc-a473-f6af4ac53ca8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c8/c8652694c97439511e4098e2b8f3d9d1e9727d9953d32348164c3ff7f741f22c.png" :db/id #edb/ref 17592186390611}] :answer-field/correct {:answer/id #uuid "e921280b-88b6-51bc-a473-f6af4ac53ca8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c8/c8652694c97439511e4098e2b8f3d9d1e9727d9953d32348164c3ff7f741f22c.png" :db/id #edb/ref 17592186390611} :answer-field/id #uuid "3f6f078f-4b80-5f34-98d4-3100f6b4d2cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390606}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3af553bc-4342-536e-bf61-1a65d8389d56" :question/math-academy-id "q-31424" :question/problem "Which of the following is the graph of $y=4{(\\frac{1}{2})}^{x}-2?$" :question/worked-solution "First, we plot the graph of $y={(\\frac{1}{2})}^{x}:$\n\n![](images/41/4100e1298857ca36288dc390501fc69dfa68fd13303101d21691d3b056f3365e.png)\n\nNext, we plot the graph of $y=4{(\\frac{1}{2})}^{x}.$ To do this, we scale the graph above by a factor of $4.$ The $y$-intercept moves from $(0,1)$ to $(0,4)$ but the horizontal asymptote stays at $y=0.$\n\n![](images/37/37bb36e82a659fc52e02f2fe2aa3bdfdc11737af467db62b4694c9b63ee4ae6e.png)\n\nFinally, we plot the graph of $y=4{(\\frac{1}{2})}^{x}-2.$ To do this, we shift the above graph $2$ units down. The $y$-intercept moves from $(0,4)$ to $(0,2)$ and the horizontal asymptote moves from $y=0$ to $y=-2.$\n\n![](images/c8/c8652694c97439511e4098e2b8f3d9d1e9727d9953d32348164c3ff7f741f22c.png)"}] [{:db/id #edb/ref 17592186297401 :knowledge-point/_questions [{:db/id #edb/ref 17592186068831 :knowledge-point/id #uuid "cc402a1d-e538-5510-8a6f-79dd1626ff1f" :knowledge-point/title "Identifying the Shift and Stretch Applied to an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a1c47f7-5b8c-5177-997f-9c9709da23dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186295599} {:answer/id #uuid "4e3cb064-2eaf-5f92-9194-de89c9125599" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186295717} {:answer/id #uuid "7b75ed7d-abd8-526c-8c58-6405c2b625a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186295942} {:answer/id #uuid "d96c6138-85f4-575a-bbd3-c78b6c063670" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186296413} {:answer/id #uuid "f51945cd-cb43-5802-a043-9d995443a3f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186296565}] :answer-field/correct {:answer/id #uuid "3a1c47f7-5b8c-5177-997f-9c9709da23dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186295599} :answer-field/id #uuid "c9d0e6b0-fcd1-5675-b95f-02f242a5a3ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297051}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7b52cd54-7f7c-57a1-892c-73badca0d5f6" :question/math-academy-id "q-31435" :question/problem "![](images/01/016286e82482af83783f0eef6361591861b564643d4d9f010f2b82999fcaad27.png)\n\nThe graph above shows $y=k{(\\frac{1}{3})}^{x}+c.$ Find the value of $k-c.$" :question/worked-solution "The horizontal asymptote of the curve $y=k{(\\frac{1}{3})}^{x}+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=-4.$ Hence, $c=-4.$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ The labeled point on the graph is $(0,-2),$ so we substitute $x=0$ and $y=-2$ into the function and solve for $k:$\n\n$$\n\\begin{aligned}k{(\\frac{1}{3})}^{x}+c & =y \\\\ k{(\\frac{1}{3})}^{x}-4 & =y \\\\ k{(\\frac{1}{3})}^{0}-4 & =-2 \\\\ k-4 & =-2 \\\\ k & =2\\end{aligned}\n$$\n\nTherefore,\n\n$$\nk-c=2-(-4)=6.\n$$\n\nThe equation of the curve is $y=2{(\\frac{1}{3})}^{x}-4.$"}] [{:db/id #edb/ref 17592186297417 :knowledge-point/_questions [{:db/id #edb/ref 17592186068691 :knowledge-point/id #uuid "aeebf57f-21dc-558a-bec5-4e97a5b26de4" :knowledge-point/title "Calculating a Limit at Positive or Negative Infinity Using L'Hopital's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "169ba8d5-e22c-50d2-9733-e76f465346c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186295401} {:answer/id #uuid "358520ce-be66-5f40-8a5d-895602d02530" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186295568} {:answer/id #uuid "38549704-6a61-553b-a029-2c376582ae9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186295584} {:answer/id #uuid "6986393b-a4fa-50a9-8106-363feaca3624" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186295859} {:answer/id #uuid "7f9c92c9-e91d-5425-a408-be18f6225423" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186295956}] :answer-field/correct {:answer/id #uuid "169ba8d5-e22c-50d2-9733-e76f465346c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186295401} :answer-field/id #uuid "7f3a5154-fd03-5ed7-b3ff-94e6906bb61f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296893}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6c446587-25a8-5d97-80ba-a22c604d7eae" :question/math-academy-id "q-31517" :question/problem "${lim}_{x\\to \\infty }\\frac{x\\operatorname{ln}⁡x}{{e}^{x}}=$" :question/worked-solution "In this case, we have an indeterminate form of type $\\frac{\\infty }{\\infty },$ so applying  L'Hopital's rule yields\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{x\\operatorname{ln}⁡x}{{e}^{x}} & ={lim}_{x\\to \\infty }\\frac{[x\\operatorname{ln}⁡x]^{′}}{[{e}^{x}]^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{\\operatorname{ln}⁡x+1}{{e}^{x}}.\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{\\infty }{\\infty }.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{x\\operatorname{ln}⁡x}{{e}^{x}} & ={lim}_{x\\to \\infty }\\frac{\\operatorname{ln}⁡x+1}{{e}^{x}} \\\\  & ={lim}_{x\\to \\infty }\\frac{[\\operatorname{ln}⁡x+1]^{′}}{[{e}^{x}]^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{1}{x})}{{e}^{x}} \\\\  & ={lim}_{x\\to \\infty }\\frac{1}{x{e}^{x}} \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297438 :knowledge-point/_questions [{:db/id #edb/ref 17592186068688 :knowledge-point/id #uuid "33f9c59a-257d-52f2-ab08-6986d283c94a" :knowledge-point/title "Calculating a Limit Using L'Hopital's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43669ea8-4439-5c52-932e-09963c9aed69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186295646} {:answer/id #uuid "68ac4fcc-e9cd-56f7-9ba5-512586a67a7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186295855} {:answer/id #uuid "90f6ca85-5f26-52db-bbfc-d1f9279260bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186296045} {:answer/id #uuid "b0e455bc-7676-59e0-8421-fc92303b6dec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186296199} {:answer/id #uuid "f0c847f9-8cd7-5aad-ae9b-9ef397a14e1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186296549}] :answer-field/correct {:answer/id #uuid "f0c847f9-8cd7-5aad-ae9b-9ef397a14e1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186296549} :answer-field/id #uuid "fe39cd51-4508-5a79-ba59-d1e9f1443e16" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297155}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e847ac9b-6147-5e36-9747-365456716188" :question/math-academy-id "q-31600" :question/problem "${lim}_{x\\to -1}\\frac{x\\operatorname{ln}⁡(x+2)}{{x}^{2}+3x+2}=$" :question/worked-solution "Note that plugging in $x=-1$ gives the indeterminate form $\\frac{0}{0}.$ However, we can use L'Hopital's rule to find this limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to -1}\\frac{x\\operatorname{ln}⁡(x+2)}{{x}^{2}+3x+2} & ={lim}_{x\\to -1}\\frac{[x\\operatorname{ln}⁡(x+2)]^{′}}{[{x}^{2}+3x+2]^{′}} \\\\  & ={lim}_{x\\to -1}\\frac{(\\operatorname{ln}⁡(x+2)+\\frac{x}{x+2})}{2x+3} \\\\  & =\\frac{(\\operatorname{ln}⁡(-1+2)+\\frac{-1}{-1+2})}{2(-1)+3} \\\\  & =\\frac{\\operatorname{ln}⁡(1)-1}{1} \\\\  & =-1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186390645 :knowledge-point/_questions [{:db/id #edb/ref 17592186115368 :knowledge-point/id #uuid "0f61a7c3-82e6-5f90-8a95-4a79078fd542" :knowledge-point/title "Vertical Reflections of Exponential Growth Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a771d975-2aaa-513d-bcb8-8905d9edc2ca" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/55/5559cd21367ed24058d7f0a3f1f646feb6cbdc269cbd4128788b17cbd331a01e.png" :db/id #edb/ref 17592186390647} {:answer/id #uuid "41d7c55e-75b0-54d8-907f-70f90a5594aa" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b0/b05cb7e1d42380d1a1ac76139b39bbed49f429dbc43fddbae79b47e61d5659fd.png" :db/id #edb/ref 17592186390648} {:answer/id #uuid "1dd1f9e6-af1e-5909-94b9-5f25d90a06ae" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/30/30b885e19455654b28e87aba56427a82bfb9abe98d28dc5b542214a7fd55315f.png" :db/id #edb/ref 17592186390649} {:answer/id #uuid "bb