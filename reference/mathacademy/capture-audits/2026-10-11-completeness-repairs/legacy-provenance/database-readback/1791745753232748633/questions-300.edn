7592186390653}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "72b43272-13a0-5f4c-969a-26359e69928e" :question/math-academy-id "q-317285" :question/problem "Which of the following is the graph of $y=-{2}^{x}-4?$" :question/worked-solution "To plot the given function, we follow these steps:\n\n- We take the curve $y={2}^{x}.$\n\n![](images/2f/2fe0fb3f0f5d302d39f6ad578148c4973618595452b59fea8a8bb2399ef92ddc.png)\n\n- Reflect it on the $x$-axis to give $y=-{2}^{x}.$ The $y$-intercept moves from $(0,1)$ to $(0,-1)$ but the horizontal asymptote stays at $y=0.$\n\n![](images/98/98c622f4675812dcada993e4022398aac18f37cda76bbaf3ecbe6147c6e5bc97.png)\n\n- Then, vertically shift it by $4$ units down to give $y=-{2}^{x}-4.$ The point $(0,-1)$ moves to $(0,-5)$ and the horizontal asymptote moves from $y=0$ to $y=-4.$\n\n![](images/c5/c5d06a922bc2fc4841bc33d0bd7dcc68244ce5ebacfd717aaa710044ec5c3caa.png)"}] [{:db/id #edb/ref 17592186390659 :knowledge-point/_questions [{:db/id #edb/ref 17592186115368 :knowledge-point/id #uuid "0f61a7c3-82e6-5f90-8a95-4a79078fd542" :knowledge-point/title "Vertical Reflections of Exponential Growth Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa5ad512-8266-5b4a-a8c5-1bab80b297e8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3f/3f0c303e3628db26bc0130806289232b40641ede7b3f58eb513cd126829c8eb4.png" :db/id #edb/ref 17592186390661} {:answer/id #uuid "97ef185c-2aea-5f09-ba17-d65c12c0fa1e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/93/93939e0c2bb62d22cf8bcb2fbd07de61227ab2c8be1160e1f90c5fae61d0b389.png" :db/id #edb/ref 17592186390662} {:answer/id #uuid "f00e7665-38bc-561a-bb1b-187f53c509dc" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1b/1bc6e9b3495e78fb0d152077b203f39cb10412990a971de1519456cb7189a817.png