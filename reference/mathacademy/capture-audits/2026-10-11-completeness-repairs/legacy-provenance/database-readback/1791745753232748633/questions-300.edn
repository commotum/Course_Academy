-3)$ moves to $(0,-2)$ and the horizontal asymptote moves from $y=0$ to $y=1.$\n\n![](images/66/662ad8370cf4c696bf831544bf425a28223a74a63cbf959521f69a7166b4dfc8.png)"}] [{:db/id #edb/ref 17592186390680 :knowledge-point/_questions [{:db/id #edb/ref 17592186217153 :knowledge-point/id #uuid "b4b5807f-a10a-518a-84fa-907bf699884c" :knowledge-point/title "Exponential Functions With Vertical Reflections and Horizontal Shifts"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e9fb04f9-c122-5136-a929-969453140eee" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2c/2c6df3a259e786bdba7842f6c03dd4957d2104959240d64208f68e0cc350b7fd.png" :db/id #edb/ref 17592186390682} {:answer/id #uuid "c5324db0-1c8d-5ca2-92c3-1ef87eddf02c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/92/9218584ade58b0e40a234498f90abe3f661f3e620fcfd98fb4b82433dd99958d.png" :db/id #edb/ref 17592186390683} {:answer/id #uuid "54653963-690a-52a6-a533-9defb3577bb4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/4b/4b5375fa460909ed1756abeb3e2acbe064a331d21928ac99fad5da557e61b1b0.png" :db/id #edb/ref 17592186390684} {:answer/id #uuid "06ee6e96-30fc-5606-bc7f-9789793644e0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a3/a365c3aecacbce3013b97534a7ddca47a11ffd4d0cecf719d87b2291cc5be801.png" :db/id #edb/ref 17592186390685} {:answer/id #uuid "bcd83c4a-02e7-57f0-8bdb-2ff0fba50393" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/75/759728d0987f60743a3416381eeea7f76c11d3f41581b05bdf858a5185abd678.png" :db/id #edb/ref 17592186390686}] :answer-field/correct {:answer/id #uuid "e9fb04f9-c122-5136-a929-969453140eee" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2c/2c6df3a259e786bdba7842f6c03dd4957d2104959240d64208f68e0cc350b7fd.png" :db/id #edb/ref 17592186390682} :answer-field/id #uuid "2e3ae387-5eb5-5976-a10c-afeed3b761fc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390681}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e138a2bb-43a8-5dac-9ca3-18e579e2b5cd" :question/math-academy-id "q-317895" :question/problem "Which of the following is the graph of the function $y=-{(\\frac{2}{3})}^{x-1}?$" :question/worked-solution "To plot the given function, we follow these steps:\n\n- We take the curve $y={(\\frac{2}{3})}^{x}.$\n\n![](images/fb/fbbddeb527a9ea78b274fd7c4afe9809546a61ba833a67a385cb18aac9e14942.png)\n\n \n\n- Horizontally shift it by $1$ unit to the right to give $y={(\\frac{2}{3})}^{x-1}.$ The $y$-intercept moves from $(0,1)$ to $(1,1)$ but the horizontal asymptote stays at $y=0.$\n\n![](images/61/617dbba0d17c30ce03da929550d17062fd644ed7992a07b55caa02e5815e7232.png)\n\n- Then, reflect it on the $x$-axis to give $y=-{(\\frac{2}{3})}^{x-1}.$ The point $(1,1)$ moves to $(1,-1)$ and the horizontal asymptote stays at $y=0.$\n\n![](images/7e/7e4d38e401c4ce01330d6082dadd43e50974a55b666023d8b8d51bbcbc7f7258.png)"}] [{:db/id #edb/ref 17592186390687 :knowledge-point/_questions [{:db/id #edb/ref 17592186217153 :knowledge-point/id #uuid "b4b5807f-a10a-518a-84fa-907bf699884c" :knowledge-point/title "Exponential Functions With Vertical Reflections and Horizontal Shifts"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cc9b1f7f-77e0-5da3-a182-cc99609a2934" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f5/f5643bb8e251468bea69940e4c0335739096d371e36ab569d898b8675da5f3a0.png" :db/id #edb/ref 17592186390689} {:answer/id #uuid "bb991bf3-446e-5307-9c14-0e8ab3fa5b02" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1a/1ab4f9a548004379156deb2f1e152a16b88b585ee7d576674d394cf96c5bca20.png" :db/id #edb/ref 17592186390690} {:answer/id #uuid "0e9da463-d94e-51f1-810f-5dd1f81b36f2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2f/2fddab60da44e86e5c99f9f2933145602a1aa8660140488a9ce2da42aab5900a.png" :db/id #edb/ref 17592186390691} {:answer/id #uuid "8f17d8a1-3239-5d48-8787-3f1e717b189e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/51/51b6901035dee1fe0ba56eb7b06b1ca0d43a1edf612cfff23ea44383b8bdd312.png" :db/id #edb/ref 17592186390692} {:answer/id #uuid "9cfd6fee-10fa-50ff-9481-7390456eb2fc" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d9/d968dcdb24e3e5538ccbe51ec4c2a94b8f8e4b23b585810a3d24fcbf255e15ed.png" :db/id #edb/ref 17592186390693}] :answer-field/correct {:answer/id #uuid "8f17d8a1-3239-5d48-8787-3f1e717b189e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/51/51b6901035dee1fe0ba56eb7b06b1ca0d43a1edf612cfff23ea44383b8bdd312.png" :db/id #edb/ref 17592186390692} :answer-field/id #uuid "b2555f44-ce03-5e69-bf96-d85a58e09bb8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390688}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8a41594a-f79c-59b8-b328-4364bfa01e24" :question/math-academy-id "q-317898" :question/problem "Which of the following is the graph of  $y=-{(\\frac{3}{10})}^{x+1}?$" :question/worked-solution "To plot the given function, we follow these steps:\n\n- We take the curve $y={(\\frac{3}{10})}^{x}.$\n\n![](images/a9/a9b6c2b12c1bc4bc7794dd5d409a99c61bf256ea58f9a016657cbbea5ef6b1e4.png)\n\n \n\n- Horizontally shift it by $1$ units to the left to give $y={(\\frac{3}{10})}^{x+1}.$ The $y$-intercept moves from $(0,1)$ to $(-1,1)$ but the horizontal asymptote stays at $y=0.$\n\n![](images/5f/5f4c0e3c4573f6e3167390d54ee21bbb8bf6e3879fcc06e7adf9d311e80ccb62.png)\n\n- Then, reflect it on the $x$-axis to give $y=-{(\\frac{3}{10})}^{x+1}.$ The point $(-1,1)$ moves to $(-1,-1)$ and the horizontal asymptote stays at $y=0.$\n\n![](images/b5/b541282b8661f2fb28d0ce1f10c22a9a8cc7b083460c05093a89722bc084d7b9.png)"}] [{:db/id #edb/ref 17592186299806 :knowledge-point/_questions [{:db/id #edb/ref 17592186078459 :knowledge-point/id #uuid "fb183013-a42d-50a3-a1b8-cd8501781075" :knowledge-point/title "Factoring a Polynomial With Multiple Variables as a Difference of Squares"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17f420e0-2ce0-5aca-8dee-2fc02f4be838" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({x}^{2}+{y}^{3})({x}^{2}-{y}^{3})" :db/id #edb/ref 17592186297656} {:answer/id #uuid "2decc769-5d34-52a4-8f61-0d917cf2c0e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({x}^{5}+{y}^{2})(x-{y}^{4})" :db/id #edb/ref 17592186297746} {:answer/id #uuid "84d3cf7b-8bb1-5c05-bad0-4556bf860b32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({x}^{3}+{y}^{3})({x}^{2}-{y}^{2})" :db/id #edb/ref 17592186298125} {:answer/id #uuid "903c4fc8-2bfb-5749-a8dc-9a4f1681fb2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({x}^{3}+{y}^{2})({x}^{3}-{y}^{2})" :db/id #edb/ref 17592186298178} {:answer/id #uuid "bd0ab2a9-e83d-55df-8e55-44c8b207e2a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({x}^{2}+{y}^{2})({x}^{2}-{y}^{2})" :db/id #edb/ref 17592186298375}] :answer-field/correct {:answer/id #uuid "17f420e0-2ce0-5aca-8dee-2fc02f4be838" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({x}^{2}+{y}^{3})({x}^{2}-{y}^{3})" :db/id #edb/ref 17592186297656} :answer-field/id #uuid "710ade4f-6788-57df-bfae-27eab8eaa863" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186299022}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a03ef93a-a766-5bc2-9cd5-d8ee9f70bca4" :question/math-academy-id "q-31991" :question/problem "Factor ${x}^{4}-{y}^{6}.$" :question/worked-solution "The difference of squares formula is given by\n\n$$\n{a}^{2}-{b}^{2}=(a+b)(a-b)\n$$\n\nNotice that our expression can be written as a difference of squares:\n\n$$\n{x}^{4}-{y}^{6}={({x}^{2})}^{2}-{({y}^{3})}^{2}\n$$\n\nFinally, we factor our expression using the difference of squares formula:\n\n$$\n{({x}^{2})}^{2}-{({y}^{3})}^{2}=({x}^{2}+{y}^{3})({x}^{2}-{y}^{3})\n$$"}] [{:db/id #edb/ref 17592186060270 :knowledge-point/_questions [{:db/id #edb/ref 17592186059685 :knowledge-point/id #uuid "993c8fe4-dae9-5dc4-9f94-5012f905e0ee" :knowledge-point/title "Finding the Correct Quadrant for Negative Angles that Contain More Than One Full Rotation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "252d775f-77ed-511b-95ad-524d7bb4cd39" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "IV" :db/id #edb/ref 17592186315326} {:answer/id #uuid "6bcab351-5c37-5d1b-99d8-985db29eacd6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II" :db/id #edb/ref 17592186315726} {:answer/id #uuid "969cb243-da0c-5f4c-8e30-aedc2baa4e6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Between quadrants III and IV" :db/id #edb/ref 17592186315954} {:answer/id #uuid "ae942c7b-d556-576d-99b4-c2d5e0d5ad8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I" :db/id #edb/ref 17592186316110} {:answer/id #uuid "e7b0d548-2819-5f8e-b792-8ccfa0fb789c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III" :db/id #edb/ref 17592186316400}] :answer-field/correct {:answer/id #uuid "969cb243-da0c-5f4c-8e30-aedc2baa4e6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Between quadrants III and IV" :db/id #edb/ref 17592186315954} :answer-field/id #uuid "e94ae561-6bac-5708-8ab7-f7ca8354b9fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186317100}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8483a20c-9e8e-5588-94ee-dd0e0014806e" :question/math-academy-id "q-34325" :question/problem "The angle $\\theta =-{450}^{∘}$ is represented in the coordinate plane in the usual way. In which quadrant does it lie?" :question/worked-solution "First, we find an angle that's coterminal with $-{450}^{∘}$ by *adding* integer multiples of ${360}^{∘}$ until we get an angle that lies in the range $[{0}^{∘},{360}^{∘}).$\n\n- $-{450}^{∘}+{360}^{∘}=-90$\n\n- $-{450}^{∘}+2\\cdot {360}^{∘}={270}^{∘}\\,✓$\n\nSo the angle ${270}^{∘}$ is coterminal with $-{450}^{∘}.$ Let's draw this coterminal angle in the coordinate plane.\n\n![](images/35/35b9783c9ac87b0a8d177e7bdf340b48513146404b7c768a8532da59b6ec7948.png)\n\nWe see that ${270}^{∘}$ lies between quadrants III and IV. Therefore, $-{450}^{∘}$ also lies between these quadrants."}] [{:db/id #edb/ref 17592186069268 :knowledge-point/_questions [{:db/id #edb/ref 17592186068861 :knowledge-point/id #uuid "a7f04ab7-f6f6-5d01-bfcf-b667e37e4f0b" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Irrational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "824db7a0-468b-5b7c-bdd3-7bd19185dd56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p + q = 80, z =-5 ± 5\\sqrt{3}" :db/id #edb/ref 17592186066779} {:answer/id #uuid "f44af2a5-1591-5f5e-93ba-40c0ddd584b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p + q = 80, z =-8 ± 3" :db/id #edb/ref 17592186066780} {:answer/id #uuid "30dfca08-4199-59da-8d02-2600e0f2122b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p + q = 75, z = 5 ± 5\\sqrt{3}" :db/id #edb/ref 17592186066781} {:answer/id #uuid "4a3b9749-a33c-5c57-89ac-26939f855dba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p + q = 80, z = 5 ± 5\\sqrt{3}" :db/id #edb/ref 17592186066782} {:answer/id #uuid "6d135e5e-ebb4-5c27-84bf-0be68ee6c029" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p + q =-70, z = ± \\sqrt{3}" :db/id #edb/ref 17592186066783}] :answer-field/id #uuid "988361f0-82f8-5fa0-bce8-8775fead2e27" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186066778} {:answer-field/choices [{:answer/id #uuid "9eb9e11c-6e9c-5d9f-85b6-41a705579cde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=80,\\,z=-5\\pm 5\\sqrt{3}" :db/id #edb/ref 17592186402357} {:answer/id #uuid "23289d14-87e9-57fb-bbda-cdd305eb9ab6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=-70,\\,z=\\pm \\sqrt{3}" :db/id #edb/ref 17592186402358} {:answer/id #uuid "691a3cdd-d3d5-50e7-a708-646cfa31e0a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=80,\\,z=-8\\pm 3" :db/id #edb/ref 17592186402359} {:answer/id #uuid "823c0a9e-ef4b-5a9d-a5eb-0fe274767e74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=75,\\,z=5\\pm 5\\sqrt{3}" :db/id #edb/ref 17592186402360} {:answer/id #uuid "ee362d99-5b0e-55c5-83d5-a9a8872163ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=80,\\,z=5\\pm 5\\sqrt{3}" :db/id #edb/ref 17592186402361}] :answer-field/correct {:answer/id #uuid "9eb9e11c-6e9c-5d9f-85b6-41a705579cde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=80,\\,z=-5\\pm 5\\sqrt{3}" :db/id #edb/ref 17592186402357} :answer-field/id #uuid "0174c191-2a23-5d0f-b8d7-9880c6f7ee41" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402356}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5c0076f5-08a5-5d4c-9789-196650ab8295" :question/math-academy-id "q-3435" :question/problem "The equation ${z}^{2}-50=-10z$ can be written in the form $(z+p{)}^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "First, we move the constant term to the right-hand side, the $-10z$ term to the left-hand side, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}{z}^{2}-50 & =-10z \\\\ {z}^{2}+10z & =50 \\\\ {z}^{2}+2\\cdot 5\\cdot z & =50 \\\\ {z}^{2}+2\\cdot 5\\cdot z+{5}^{2}-{5}^{2} & =50 \\\\ (z+5{)}^{2}-{5}^{2} & =50\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(z+5{)}^{2}-{5}^{2} & =50 \\\\ (z+5{)}^{2} & =75\\end{aligned}\n$$\n\nSo, $p=5,q=75,$ and $p+q=80.$\n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(z+5{)}^{2} & =75 \\\\ \\sqrt{(z+5{)}^{2}} & =\\sqrt{75} \\\\ |z+5| & =\\sqrt{75} \\\\ z+5 & =\\pm 5\\sqrt{3} \\\\ z & =-5\\pm 5\\sqrt{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186320740 :knowledge-point/_questions [{:db/id #edb/ref 17592186184212 :knowledge-point/id #uuid "3202d7cc-541b-553b-8ec1-d4ea85dd0590" :knowledge-point/title "Completing the Square on an Expression With a Negative Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53025447-2eb1-5df5-a00f-6e8c8a103513" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{(z+\\frac{7}{2})}^{2}-\\frac{89}{4}" :db/id #edb/ref 17592186319630} {:answer/id #uuid "66db5717-8d6c-56e3-9e6e-8159327ca744" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{(z+\\frac{7}{2})}^{2}-\\frac{67}{2}" :db/id #edb/ref 17592186319706} {:answer/id #uuid "6f875b91-463b-5b9e-b642-9334220d3e01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{(z-\\frac{7}{2})}^{2}-\\frac{49}{2}" :db/id #edb/ref 17592186319727} {:answer/id #uuid "78093d05-d766-51e5-bfbd-15a4b1ad83e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{(z-\\frac{7}{2})}^{2}+\\frac{67}{4}" :db/id #edb/ref 17592186319753} {:answer/id #uuid "b538e599-0c29-5367-95db-1d80a51d71e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{(z+\\frac{7}{2})}^{2}+\\frac{81}{2}" :db/id #edb/ref 17592186319948}] :answer-field/correct {:answer/id #uuid "b538e599-0c29-5367-95db-1d80a51d71e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{(z+\\frac{7}{2})}^{2}+\\frac{81}{2}" :db/id #edb/ref 17592186319948} :answer-field/id #uuid "9c1dc974-537c-5a19-8b0e-de4ef3bf427a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186320478}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8b2f4df1-3e4e-5541-bb2f-d2b7890aaf73" :question/math-academy-id "q-35079" :question/problem "Rewrite $-2{z}^{2}-14z+16$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $-2.$ So, we take out a factor of $-2$ from the entire expression:\n\n$$\n-2({z}^{2}+7z-8)\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{z}^{2}+7z-8\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{z}^{2}+2\\cdot \\frac{7}{2}\\cdot z-8\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{7}{2})}^{2},$ writing the constant term $8$ last:\n\n$$\n{{z}^{2}+2\\cdot \\frac{7}{2}\\cdot z+{(\\frac{7}{2})}^{2}}_{⏟}-{(\\frac{7}{2})}^{2}-8\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(z+\\frac{7}{2})}^{2}-{(\\frac{7}{2})}^{2}-8\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(z+\\frac{7}{2})}^{2}-\\frac{81}{4}.\n$$\n\nFinally, we substitute this result back into our original expression::\n\n$$\n\\begin{aligned}-2({z}^{2}+7z-8) & =-2({(z+\\frac{7}{2})}^{2}-\\frac{81}{4}) \\\\  & =-2{(z+\\frac{7}{2})}^{2}+(-2)\\cdot (-\\frac{81}{4}) \\\\  & =-2{(z+\\frac{7}{2})}^{2}+\\frac{81}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106285 :knowledge-point/_questions [{:db/id #edb/ref 17592186105854 :knowledge-point/id #uuid "a5bea806-2913-57f5-ba32-be7aeda5bd15" :knowledge-point/title "Computing the Limit at Infinity of a Power Function With an Odd Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15ff9d00-cfe3-5000-9f39-f5b084d00080" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186319455} {:answer/id #uuid "9035921e-6fcf-5772-b9a5-7d9a496b6106" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186319823} {:answer/id #uuid "d6df4228-d351-594e-9eea-e865f3a883bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186320046} {:answer/id #uuid "dcc970a1-4ea5-589f-8352-ce90a07452c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186320063} {:answer/id #uuid "f9a74ebb-b1db-5cf0-a20e-5165336efc1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186320137}] :answer-field/correct {:answer/id #uuid "d6df4228-d351-594e-9eea-e865f3a883bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186320046} :answer-field/id #uuid "1cb04ca6-e219-5d5e-ab67-487f7d66d988" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186320233}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7c7529a5-2ffe-53f0-9bca-cd9b5d97a802" :question/math-academy-id "q-35192" :question/problem "Evaluate ${lim}_{x\\to -\\infty }(-\\frac{{x}^{5}}{4}).$" :question/worked-solution "First, we note that\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }-\\frac{{x}^{5}}{4} & ={lim}_{x\\to -\\infty }(-\\frac{1}{4}\\cdot {x}^{5}) \\\\  & =-\\frac{1}{4}\\cdot {lim}_{x\\to -\\infty }{x}^{5}.\\end{aligned}\n$$\n\nThe graph $y={x}^{5}$ is power function with an odd positive power and therefore has the property that\n\n$$\n{lim}_{x\\to -\\infty }{x}^{5}=-\\infty .\n$$\n\nMultiplication by the negative constant $-\\frac{1}{4}$ changes the sign of the limit. \nSo, we have\n\n$$\n\\begin{aligned}-\\frac{1}{4}\\cdot {lim}_{x\\to -\\infty }{x}^{5} & =-{lim}_{x\\to -\\infty }{x}^{5}=\\infty .\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{lim}_{x\\to -\\infty }(-\\frac{{x}^{5}}{4})=\\infty .\n$$"}]}
