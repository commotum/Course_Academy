/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e5/e57af2e43bd292195f617f60ffed8055891531a2ca5d0249706497d7932d6639.png" :db/id #edb/ref 17592186392633} :answer-field/id #uuid "7b9e37d1-a2f5-593f-a51a-6ff6525396de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392629}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b9688522-541f-5cbf-8ad0-7cde48d13425" :question/math-academy-id "q-48293" :question/problem "Which of the following functions is continuous on the interval $[-1,2]?$" :question/worked-solution "The correct answer is the following. \n\n![](images/e5/e57af2e43bd292195f617f60ffed8055891531a2ca5d0249706497d7932d6639.png)\n\n      \n\nIndeed, this function is continuous on the open intervals $(-\\infty ,2)$ and $(2,\\infty ).$\n\nAdditionally, the function is left-continuous at $x=2.$ Hence, it is continuous on the interval $(-\\infty ,2].$\n\nSo, we can say that the function is continuous on the intervals $(-\\infty ,2]$ and  $(2,\\infty ).$ It is also continuous on any subinterval of these intervals.\n\nTherefore, this function is continuous on $[-1,2],$ because $[-1,2]$ is contained inside the interval $(-\\infty ,2].$\n\nNotice that:\n\n- $g(x)$ and $p(x)$ are not left-continuous at $x=2.$\n\n- $h(x)$ is not defined at $x=-1,$ and so it is not continuous on the interval $[-1,2].$\n\n- $q(x)$ is not defined at $x=1,$ and so it is not continuous on the interval $[-1,2].$"}] [{:db/id #edb/ref 17592186392635 :knowledge-point/_questions [{:db/id #edb/ref 17592186078486 :knowledge-point/id #uuid "bbfddefc-d68b-5b1e-9ec5-fd18be204d92" :knowledge-point/title "Identifying Semi-Open Intervals of Continuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10ef9b73-f52e-5b9c-9db2-9010a5191176" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/72/7225a16c8dfa80bc750607b30c6deb30bb82807365c0c975c6b5ae3e33e11c6f.png" :db/id #edb/ref 17592186392637} {:answer/id #uuid "d19ed205-b0ad-5bbb-bcec-dfa49650fec0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/da/da6eb0e1cc28a0bef252e0d66bb232006f6a6e54142b27bb04401ca97025af30.png" :db/id #edb/ref 17592186392638} {:answer/id #uuid "f034c628-7593-57d9-af24-2336a12e680e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/6c/6c04be0224db916731c3f7b4e2093887ffd36a258b19c4112766125ff435704c.png" :db/id #edb/ref 17592186392639} {:answer/id #uuid "899a69d0-95f3-5220-8187-28e906306a43" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/49/49356dbd9984d40899b321698d641f200d1d28d498323aa88fdfdfac53ed7910.png" :db/id #edb/ref 17592186392640} {:answer/id #uuid "c336072e-08e4-5982-8f58-51b86e8995ab" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/13/1326b043af92c5945a5fa679f7daa57eb269ae13edb6d3f9296b3a522678039c.png" :db/id #edb/ref 17592186392641}] :answer-field/correct {:answer/id #uuid "10ef9b73-f52e-5b9c-9db2-9010a5191176" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/72/7225a16c8dfa80bc750607b30c6deb30bb82807365c0c975c6b5ae3e33e11c6f.png" :db/id #edb/ref 17592186392637} :answer-field/id #uuid "d4d2a845-2450-5e73-b0b2-bcfee6b03964" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392636}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c74056bd-b0fc-5dc2-914f-2bbc6b987726" :question/math-academy-id "q-48348" :question/problem "Which of the following functions is continuous on the interval $(-\\infty ,-1]?$  You may assume that all points of discontinuity for each function are shown." :question/worked-solution "The correct answer is the following.\n\n![](images/72/7225a16c8dfa80bc750607b30c6deb30bb82807365c0c975c6b5ae3e33e11c6f.png)\n\nWe see that $h(x)$ is continuous on the interval $(-\\infty ,0],$ and since $(-\\infty ,-1]$ lies completely inside $(-\\infty ,0],$ it is also continuous on $(-\\infty ,-1].$\n\nNotice that:\n\n- $f(x)$ and $g(x)$ are not continuous at $x=-2$, and so are not continuous on $(-\\infty ,-1].$\n\n- $p(x)$ and $q(x)$ are not continuous at $x=-3$, and so are not continuous on $(-\\infty ,-1].$"}] [{:db/id #edb/ref 17592186329887 :knowledge-point/_questions [{:db/id #edb/ref 17592186096621 :knowledge-point/id #uuid "3c547746-49c8-5a4a-85fe-c6b75493a354" :knowledge-point/title "Differentiating a Quotient Containing Other Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22e53f34-1f08-55ea-b027-91a6570c9ba2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e" :db/id #edb/ref 17592186327234} {:answer/id #uuid "9d3be258-9fcf-5d57-a47f-1395e89bbde9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186328293} {:answer/id #uuid "c4c08959-081a-5f50-a3f0-ce4b51612304" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186328658} {:answer/id #uuid "e95dd2da-108e-5550-b9b6-a61109df65bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186328979} {:answer/id #uuid "efde6b46-482d-55c0-a8b0-e2ad91b34126" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e}{2}" :db/id #edb/ref 17592186329029}] :answer-field/correct {:answer/id #uuid "22e53f34-1f08-55ea-b027-91a6570c9ba2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e" :db/id #edb/ref 17592186327234} :answer-field/id #uuid "23c86c24-0972-56ca-8779-29609bc15897" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329248}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bf60d52b-f79d-5da2-9400-715a7866a23a" :question/math-academy-id "q-48504" :question/problem "If a curve $C$ is given by $y=\\frac{{x}^{2}}{ln⁡(x)},$ calculate the slope of the tangent line to the curve at the point where $x=e.$" :question/worked-solution "In this case, the expression for $y$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)={x}^{2}$ and $v(x)=ln⁡x.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{({x}^{2})^{′}\\cdot ln⁡x-{x}^{2}\\cdot (ln⁡x)^{′}}{(ln⁡x)^{2}} \\\\  & =\\frac{2x\\cdot ln⁡(x)-{x}^{2}\\cdot (\\frac{1}{x})}{{(ln⁡(x))}^{2}} \\\\  & =\\frac{2x\\cdot ln⁡(x)-x}{{ln}^{2}⁡(x)} \\\\  & =\\frac{x(2ln⁡(x)-1)}{{ln}^{2}⁡(x)}\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=e$ into the formula and get\n\n$$\n\\begin{aligned}{f}^{′}(e) & =\\frac{e(2ln⁡(e)-1)}{{ln}^{2}⁡(e)} \\\\  & =\\frac{e(2-1)}{{1}^{2}} \\\\  & =e.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $e.$"}] [{:db/id #edb/ref 17592186329888 :knowledge-point/_questions [{:db/id #edb/ref 17592186096621 :knowledge-point/id #uuid "3c547746-49c8-5a4a-85fe-c6b75493a354" :knowledge-point/title "Differentiating a Quotient Containing Other Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d637eb0-49d3-5d5a-bc2f-46a3198b126a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4\\pi }" :db/id #edb/ref 17592186327188} {:answer/id #uuid "2d2b75a4-6c3e-559a-99f1-a4062d43aa68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\pi " :db/id #edb/ref 17592186327331} {:answer/id #uuid "9ab0189b-f12c-5d69-a3ac-1572bccacdb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186328273} {:answer/id #uuid "b66a4a70-89cf-5764-a364-dbddd46ff6e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186328520} {:answer/id #uuid "bd42ca1a-304b-5562-8e62-1ee43deef421" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2\\pi }" :db/id #edb/ref 17592186328583}] :answer-field/correct {:answer/id #uuid "bd42ca1a-304b-5562-8e62-1ee43deef421" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2\\pi }" :db/id #edb/ref 17592186328583} :answer-field/id #uuid "a2dfe786-1989-54c2-ac40-7bcf2f579b50" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329461}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e735330d-c2f3-5b05-83d4-12a709d794e0" :question/math-academy-id "q-48507" :question/problem "If a curve $C$ is given by $y=\\frac{sin⁡x}{2x},$ calculate the slope of the tangent line to the curve at the point where $x=\\pi .$" :question/worked-solution "In this case, the expression for $y$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)=sin⁡x$ and $v(x)=2x.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(sin⁡x)^{′}\\cdot (2x)-sin⁡x\\cdot (2x)^{′}}{(2x)^{2}} \\\\  & =\\frac{cos⁡x\\cdot (2x)-sin⁡x\\cdot 2}{{(2x)}^{2}} \\\\  & =\\frac{2(xcos⁡x-sin⁡x)}{4{x}^{2}} \\\\  & =\\frac{xcos⁡x-sin⁡x}{2{x}^{2}}\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\pi $ into the formula and get\n\n$$\n\\begin{aligned}{f}^{′}(\\pi ) & =\\frac{\\pi cos⁡(\\pi )-sin⁡(\\pi )}{2(\\pi )^{2}} \\\\  & =\\frac{\\pi (-1)-(0)}{2{\\pi }^{2}} \\\\  & =-\\frac{\\pi }{2{\\pi }^{2}} \\\\  & =-\\frac{1}{2\\pi }.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $-\\frac{1}{2\\pi }.$"}] [{:db/id #edb/ref 17592186329889 :knowledge-point/_questions [{:db/id #edb/ref 17592186064282 :knowledge-point/id #uuid "8ef81a0d-5a3a-5d7c-83e9-7d9ed0e8c5c6" :knowledge-point/title "Differentiating a Reciprocal Trigonometric Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45e2c946-cebd-5416-8a76-6327b5030505" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{\\pi }{2}" :db/id #edb/ref 17592186327546} {:answer/id #uuid "8c9341d4-99b6-50f0-aa6d-9c6dd9382020" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186328140} {:answer/id #uuid "acbeb3ba-53eb-5b9a-b551-835bc36de883" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x-\\frac{\\pi }{2}" :db/id #edb/ref 17592186328432} {:answer/id #uuid "ca6bee3f-bd8c-5dcf-8359-5ca512f57072" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3x-\\frac{\\pi }{2}" :db/id #edb/ref 17592186328708} {:answer/id #uuid "db84f8eb-8423-54a1-b09a-ae141285ed5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3x-\\frac{3\\pi }{2}" :db/id #edb/ref 17592186328851}] :answer-field/correct {:answer/id #uuid "db84f8eb-8423-54a1-b09a-ae141285ed5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3x-\\frac{3\\pi }{2}" :db/id #edb/ref 17592186328851} :answer-field/id #uuid "ac2d96d1-6187-53ac-b42b-8e94f57a3b62" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329484}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "33385857-91b0-513f-9a43-e506cd0cb163" :question/math-academy-id "q-48512" :question/problem "Find the equation of the tangent to the curve $y=\\operatorname{cot}⁡(2\\pi -3x)$ at the point $(\\frac{\\pi }{2},0).$" :question/worked-solution "First, the slope of $y=f(x)$ at $x=\\frac{\\pi }{2}$ is given by ${f}^{′}(\\frac{\\pi }{2}).$\n\nWe will calculate ${f}^{′}(x)$ using the chain rule. First, we express $f(x)$ as the composite function\n\n$$\nf=\\operatorname{cot}⁡u,\\,u=2\\pi -3x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-{csc}^{2}⁡u\\,\\text{and}\\,\\frac{\\text{d}u}{\\text{d}x}=-3.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =(-{csc}^{2}⁡u)\\cdot (-3) \\\\  & =3{csc}^{2}⁡(2\\pi -3x).\\end{aligned}\n$$\n\nEvaluating at $x=\\frac{\\pi }{2},$ we find\n\n$$\n\\begin{aligned}m={f}^{′}(\\frac{\\pi }{2}) & =3{csc}^{2}⁡(2\\pi -\\frac{3\\pi }{2}) \\\\  & =3{csc}^{2}⁡(\\frac{\\pi }{2}) \\\\  & =3\\cdot {1}^{2} \\\\  & =3.\\end{aligned}\n$$\n\nFinally, we find the equation of the tangent at the point $(\\frac{\\pi }{2},0):$\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-0 & =3(x-\\frac{\\pi }{2}) \\\\ y & =3x-\\frac{3\\pi }{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329890 :knowledge-point/_questions [{:db/id #edb/ref 17592186096619 :knowledge-point/id #uuid "ee64135e-9b9f-5429-a4df-efa522042b83" :knowledge-point/title "Finding the Slope of the Tangent Line to a Product  at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d41e3a6-5106-5f1f-89a7-bdf0659fd667" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3" :db/id #edb/ref 17592186327605} {:answer/id #uuid "5722ae40-633d-5817-9b2f-fd696d396624" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186327690} {:answer/id #uuid "7d059a2c-54e1-581a-9631-274cba73cd9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{ln}⁡2" :db/id #edb/ref 17592186328010} {:answer/id #uuid "e54916ae-cb46-54d5-9769-ffc8af47b71e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5+2\\operatorname{ln}⁡5" :db/id #edb/ref 17592186328941} {:answer/id #uuid "ef1b3eab-bf60-5779-ac14-8316a78be3d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186329022}] :answer-field/correct {:answer/id #uuid "5722ae40-633d-5817-9b2f-fd696d396624" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186327690} :answer-field/id #uuid "4b4c9edf-2978-575c-9b65-ca2b012c2b2f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329326}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "33d86109-fb1d-5bea-8ffd-bc18d4e7651a" :question/math-academy-id "q-48515" :question/problem "If a curve $C$ is given by $y=(3x-2)\\operatorname{ln}⁡x,$ calculate the slope of the tangent line to the curve at the point where $x=1.$" :question/worked-solution "We differentiate using the product rule. Let $u(x)=3x-2$ and $v(x)=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3,\\,\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & =(3x-2)\\cdot \\frac{1}{x}+(\\operatorname{ln}⁡x)\\cdot 3 \\\\  & =\\frac{3x-2}{x}+3\\operatorname{ln}⁡x.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=1$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{3x-2}{x}+3\\operatorname{ln}⁡x)|}_{x=1} \\\\  & =\\frac{3(1)-2}{1}+3\\operatorname{ln}⁡1 \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $1.$"}] [{:db/id #edb/ref 17592186329891 :knowledge-point/_questions [{:db/id #edb/ref 17592186096619 :knowledge-point/id #uuid "ee64135e-9b9f-5429-a4df-efa522042b83" :knowledge-point/title "Finding the Slope of the Tangent Line to a Product  at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02bc770f-35b5-51f7-ac23-0dd7e7626849" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186326966} {:answer/id #uuid "a57078c9-1989-5bc2-8b84-47cb7c7b7fce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{\\pi }" :db/id #edb/ref 17592186328362} {:answer/id #uuid "acccd38a-7649-5753-9632-b00f2c05b4e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{e}^{\\pi }" :db/id #edb/ref 17592186328433} {:answer/id #uuid "bce8eacc-997c-5af0-a8a5-5af0dda6e688" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi {e}^{\\pi }" :db/id #edb/ref 17592186328578} {:answer/id #uuid "d019d383-2037-503a-8480-3e5bdb84df98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\pi {e}^{\\pi }" :db/id #edb/ref 17592186328764}] :answer-field/correct {:answer/id #uuid "acccd38a-7649-5753-9632-b00f2c05b4e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{e}^{\\pi }" :db/id #edb/ref 17592186328433} :answer-field/id #uuid "8008b7a2-773f-5257-8a67-dd590b27a6d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329395}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e7dfe1e7-2a9e-5927-a9e6-a1ed58369b31" :question/math-academy-id "q-48516" :question/problem "If a curve $C$ is given by $y={e}^{x}sin⁡x,$ calculate the slope of the tangent line to the curve at the point where $x=\\pi .$" :question/worked-solution "We differentiate using the product rule. Let $u(x)={e}^{x}$ and $v(x)=sin⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}={e}^{x},\\,\\frac{\\text{d}v}{\\text{d}x}=cos⁡x.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{x}\\cdot cos⁡x+(sin⁡x)\\cdot {e}^{x} \\\\  & ={e}^{x}(cos⁡x+sin⁡x).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\pi $ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=\\pi } & ={{e}^{x}(cos⁡x+sin⁡x)|}_{x=\\pi } \\\\  & ={e}^{\\pi }(-1+0) \\\\  & =-{e}^{\\pi }.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $-{e}^{\\pi }.$"}] [{:db/id #edb/ref 17592186329895 :knowledge-point/_questions [{:db/id #edb/ref 17592186092265 :knowledge-point/id #uuid "a9102c1c-1c38-58dd-9932-b04bd24a6846" :knowledge-point/title "Differentiating a General Logarithm Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79f13dd8-26c9-5adf-8bdd-6c74fc06256d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{x}^{3}ln⁡(2)}" :db/id #edb/ref 17592186327980} {:answer/id #uuid "8b93ae68-75e8-5e22-9480-dd13fcb145cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{x}" :db/id #edb/ref 17592186328133} {:answer/id #uuid "9f823260-520c-55a0-b92f-e5fd464f4ac6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{xln⁡(2)}" :db/id #edb/ref 17592186328312} {:answer/id #uuid "a3e3c6b3-2aba-508b-9ed5-660969c16420" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{{x}^{2}}" :db/id #edb/ref 17592186328353} {:answer/id #uuid "ef8c97b0-8b83-5367-985e-2d436e277e28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3xln⁡(2)}" :db/id #edb/ref 17592186329026}] :answer-field/correct {:answer/id #uuid "9f823260-520c-55a0-b92f-e5fd464f4ac6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{xln⁡(2)}" :db/id #edb/ref 17592186328312} :answer-field/id #uuid "9056d537-4120-54a4-91a1-0704cebf5089" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329423}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "288c307e-b8cb-5e83-b4ba-4f7abf6cf59d" :question/math-academy-id "q-48559" :question/problem "Given that $y={log}_{2}⁡({x}^{3}),$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={log}_{2}⁡(u),\\,u={x}^{3}.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{uln⁡(2)},\\,\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{1}{uln⁡(2)}\\cdot 3{x}^{2} \\\\  & =\\frac{3{x}^{2}}{{x}^{3}ln⁡(2)} \\\\  & =\\frac{\\cancel{{x}^{2}}\\cdot 3}{\\cancel{{x}^{2}}\\cdot xln⁡(2)} \\\\  & =\\frac{3}{xln⁡(2)}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186092733 :knowledge-point/_questions [{:db/id #edb/ref 17592186092261 :knowledge-point/id #uuid "2f4bfd24-dafd-57b3-940a-154a6e0acf3d" :knowledge-point/title "Differentiating a General Exponential Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d9ee625-e773-554a-b6fd-1b00c950d2f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 \\cdot 3^{2x}\\ln (3)" :db/id #edb/ref 17592186090599} {:answer/id #uuid "a2e4f469-6799-5ce4-b565-a59f324b5ec8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x3^{2x^{2}}" :db/id #edb/ref 17592186090600} {:answer/id #uuid "bdacec05-5c20-55b6-8105-e82bd5158002" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x3^{2x^{2}}" :db/id #edb/ref 17592186090601} {:answer/id #uuid "f7139b42-c4a4-5c78-ab9a-4c8bcf3ecb8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x3^{2x^{2}}\\ln (3)" :db/id #edb/ref 17592186090602} {:answer/id #uuid "15755bfa-20fa-599b-b783-c67a495db7ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x3^{2x}\\ln (3)" :db/id #edb/ref 17592186090603}] :answer-field/id #uuid "4acd11bc-cb2e-5a8e-a9ee-06ec6470c2d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186090598} {:answer-field/choices [{:answer/id #uuid "9c382a73-b479-5088-ba73-8174216969b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x{3}^{2{x}^{2}}\\operatorname{ln}⁡(3)" :db/id #edb/ref 17592186402979} {:answer/id #uuid "7bd5037d-c800-5b92-94d5-bf8378100f05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{3}^{2x}\\operatorname{ln}⁡(3)" :db/id #edb/ref 17592186402980} {:answer/id #uuid "bc15acd8-2e05-54df-824b-49b27e8976d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x{3}^{2{x}^{2}}" :db/id #edb/ref 17592186402981} {:answer/id #uuid "c86614c3-2ff7-5322-a6c3-9ce930da4214" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x{3}^{2{x}^{2}}" :db/id #edb/ref 17592186402982} {:answer/id #uuid "098f7a16-97a6-5c7b-bd17-6d5da322792f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\cdot {3}^{2x}\\operatorname{ln}⁡(3)" :db/id #edb/ref 17592186402983}] :answer-field/correct {:answer/id #uuid "9c382a73-b479-5088-ba73-8174216969b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x{3}^{2{x}^{2}}\\operatorname{ln}⁡(3)" :db/id #edb/ref 17592186402979} :answer-field/id #uuid "08bb9372-bdf9-5f57-a4fb-f3aaaf1824d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402978}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8711f34a-9cc5-5a70-9af6-219e0592f067" :question/math-academy-id "q-48565" :question/problem "If $f(x)={3}^{2{x}^{2}},$ find ${f}^{′}(x).$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf={3}^{u},\\,u=2{x}^{2}.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={3}^{u}\\operatorname{ln}⁡(3),\\,\\frac{\\text{d}u}{\\text{d}x}=4x.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={3}^{u}\\operatorname{ln}⁡(3)\\cdot (4x) \\\\  & =4x\\cdot {3}^{u}\\operatorname{ln}⁡(3) \\\\  & =4x\\cdot {3}^{2{x}^{2}}\\operatorname{ln}⁡(3).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064828 :knowledge-point/_questions [{:db/id #edb/ref 17592186064153 :knowledge-point/id #uuid "2451a654-2255-5867-871d-54340dfeff81" :knowledge-point/title "Interpreting the Derivative of a Function in a Given Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e6b77c5-ddfd-5b08-a361-9ab4187a9d4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ hours after the launch, the number of users increased at a rate of $650$ users per hour" :db/id #edb/ref 17592186327481} {:answer/id #uuid "80be97f8-97ac-5b85-a8f9-3150ff9145c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The number of users increased at a constant rate of $162.5$ users per hour" :db/id #edb/ref 17592186328044} {:answer/id #uuid "9ebe19ed-4105-5740-8271-2100f1c58c04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ hours after the launch, there are exactly $650$ users." :db/id #edb/ref 17592186328304} {:answer/id #uuid "bd3d8b40-f651-514c-8adb-8e02d8ddf76f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ hours after the launch, the number of users decreased at a rate of $650$ users per hour" :db/id #edb/ref 17592186328581} {:answer/id #uuid "c7ba5d88-2149-5501-afd7-d16c293347cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The number of users increased by $650$ during the first $4$ hours" :db/id #edb/ref 17592186328689}] :answer-field/correct {:answer/id #uuid "3e6b77c5-ddfd-5b08-a361-9ab4187a9d4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ hours after the launch, the number of users increased at a rate of $650$ users per hour" :db/id #edb/ref 17592186327481} :answer-field/id #uuid "6590d944-81ce-5446-a022-cd1f094cac01" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329364}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8b66dae7-140e-5116-ac81-188561d113a9" :question/math-academy-id "q-48571" :question/problem "The function $U(t)$ models the number of users of a new mobile phone app, $t$ hours after launching the app. What is the best interpretation of ${U}^{′}(4)=650?$" :question/worked-solution "The function ${U}^{′}(t)$ represents the rate at which the number of users is changing at the moment $t$ hours after launch. \n\nTherefore, ${U}^{′}(4)=650$ means:\n\n$\\,$ *$4$ hours after the launch, the number of users increased at a rate of $650$ users per hour*"}] [{:db/id #edb/ref 17592186402984 :knowledge-point/_questions [{:db/id #edb/ref 17592186064271 :knowledge-point/id #uuid "0fa5bdf9-4b27-5565-9ee1-ecb9f9db4791" :knowledge-point/title "Determining the Units of a Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "edec9b0f-e74f-5f71-8e01-c49ef9dcd993" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Degrees Fahrenheit per minute" :db/id #edb/ref 17592186402986} {:answer/id #uuid "f6d4c614-ec2d-5d40-969c-a53c3dd207e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Degrees Fahrenheit" :db/id #edb/ref 17592186402987} {:answer/id #uuid "4ec8af8b-c1c2-588d-b21b-584e7bda5fb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Minutes per degrees Fahrenheit" :db/id #edb/ref 17592186402988} {:answer/id #uuid "c8dada28-2d89-5b17-8652-6cc73bf5852f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Minutes" :db/id #edb/ref 17592186402989} {:answer/id #uuid "9dc2b148-ac18-514b-b0ae-11c7d6164436" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Degrees Fahrenheit squared per minute" :db/id #edb/ref 17592186402990}] :answer-field/correct {:answer/id #uuid "edec9b0f-e74f-5f71-8e01-c49ef9dcd993" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Degrees Fahrenheit per minute" :db/id #edb/ref 17592186402986} :answer-field/id #uuid "ad3df16f-9c93-57df-88a3-0c0fe3164587" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402985}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "453a4f9f-dc2c-5ef4-9ab6-f86f7acd693b" :question/math-academy-id "q-48611" :question/problem "A cup of coffee sitting on a teacher's desk $t$ minutes after it has been made has the temperature $F(t)$ degrees Fahrenheit. What are the units of $\\frac{\\text{d}F}{\\text{d}t}?$" :question/worked-solution "We have that the temperature $F(t)$ is measured in degrees Fahrenheit and the time is measured in minutes. \n\n$$\n\\begin{aligned}F(t): & \\text{degrees Fahrenheit} \\\\ t: & \\text{minutes}\\end{aligned}\n$$\n\nThe derivative $\\frac{\\text{d}F}{\\text{d}t}$ measures a change in $F(t)$ over a change in $t.$ So, it represents a ratio of the units:\n\n$$\n\\begin{aligned}\\frac{\\text{d}F}{\\text{d}t}: & \\frac{\\text{degrees Fahrenheit}}{\\text{minutes}}\\end{aligned}\n$$\n\nTherefore, $\\frac{\\text{d}F}{\\text{d}t}$ is measured in \"degrees Fahrenheit per minute\"."}] [{:db/id #edb/ref 17592186329902 :knowledge-point/_questions [{:db/id #edb/ref 17592186092260 :knowledge-point/id #uuid "a83f86ab-a008-5487-b118-f1495a0fe4d6" :knowledge-point/title "Differentiating an Exponential Function with a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3844e08c-6f9d-5cf6-a14e-cc030d9a01b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{e}^{5}" :db/id #edb/ref 17592186327425} {:answer/id #uuid "a89f0a93-4737-553c-9bbe-0034bad64d50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3e" :db/id #edb/ref 17592186328394} {:answer/id #uuid "adef63ee-5bd4-5b53-b409-c9e308d93260" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186328445} {:answer/id #uuid "c199d559-8e1d-58ab-8615-2d150595957a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{e}^{2}" :db/id #edb/ref 17592186328624} {:answer/id #uuid "d557a2be-477a-515d-91b2-d30108f2cab4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186328801}] :answer-field/correct {:answer/id #uuid "adef63ee-5bd4-5b53-b409-c9e308d93260" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186328445} :answer-field/id #uuid "d0d50368-ac7e-5bb9-86d5-22e01e5b4791" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329554}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fbf43982-c74c-540d-95a5-32f181ac4ea6" :question/math-academy-id "q-48658" :question/problem "Find the slope of the tangent to the curve $y=-3{e}^{5-x}$ at the point where $x=5-ln⁡(2).$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=-3{e}^{u},\\,u=5-x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-3{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-1.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-3{e}^{u}\\cdot (-1) \\\\  & =3{e}^{u} \\\\  & =3{e}^{5-x}.\\end{aligned}\n$$\n\nFinally, to find the slope of the tangent to the curve at $x=5-ln⁡(2)$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{x=5-ln⁡(2)} & =3{e}^{5-(5-ln⁡(2))} \\\\  & =3{e}^{ln⁡(2)} \\\\  & =3\\cdot 2 \\\\  & =6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064834 :knowledge-point/_questions [{:db/id #edb/ref 17592186064152 :knowledge-point/id #uuid "159b4d58-b34d-52cd-aad2-2c058f772ad2" :knowledge-point/title "Interpreting the Derivative of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21259e1a-7c04-5c09-82e5-7243bcf85664" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The area of a rectangle with base $b$" :db/id #edb/ref 17592186327218} {:answer/id #uuid "5fc94605-ed86-5627-829b-c4455291deab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The rate at which the height changes as the area changes" :db/id #edb/ref 17592186327776} {:answer/id #uuid "65f9a132-8f61-5572-a179-107ef44e827e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The length of the base of the rectangle" :db/id #edb/ref 17592186327819} {:answer/id #uuid "a66e4302-c64c-5bcf-b355-707357f1f6a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The rate at which the area changes as the height changes" :db/id #edb/ref 17592186328373} {:answer/id #uuid "fe57e3fa-21c0-5395-89e5-133cd34e4d57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The rate at which the area changes as the base changes" :db/id #edb/ref 17592186329169}] :answer-field/correct {:answer/id #uuid "fe57e3fa-21c0-5395-89e5-133cd34e4d57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The rate at which the area changes as the base changes" :db/id #edb/ref 17592186329169} :answer-field/id #uuid "17ac5fb5-0106-5c51-8d69-9c1dee49bf09" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329225}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b3408555-de68-5409-ab55-f212404a9d43" :question/math-academy-id "q-48684" :question/problem "Consider a rectangle such that the height is fixed but its base $b$ can vary. What is the best interpretation of ${A}^{′}(b)$ if $A$ is the area of the rectangle?" :question/worked-solution "The function $A(b)$ gives the area of a rectangle with base $b.$ So\n\n$$\n{A}^{′}(b)=\\frac{\\text{d}A}{\\text{d}b}=\\frac{\\text{Change in }A}{\\text{Change in }b}.\n$$\n\nTherefore, ${A}^{′}(b)$ is the rate at which the area changes as the base changes."}] [{:db/id #edb/ref 17592186329911 :knowledge-point/_questions [{:db/id #edb/ref 17592186064153 :knowledge-point/id #uuid "2451a654-2255-5867-871d-54340dfeff81" :knowledge-point/title "Interpreting the Derivative of a Function in a Given Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "224a9606-2cff-583a-a5a5-2ad7bd61c0d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ hours after launching, the number of visitors decreased at a rate of $1\\,500$ visitors per hour" :db/id #edb/ref 17592186327231} {:answer/id #uuid "2805d6d9-2178-5b35-a75a-b51a961ecf7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ hours after launching, the number of visitors increased by a total of $1\\,500$ visitors" :db/id #edb/ref 17592186327275} {:answer/id #uuid "2d5469b6-041f-5e92-a4a1-d055f18d58b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ hours after launching, the number of visitors increased at a rate of $1\\,500$ visitors per hour" :db/id #edb/ref 17592186327334} {:answer/id #uuid "63be821f-e737-542f-b20e-fcd904ca356a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ hours after launching, the number of visitors increased at a constant rate of $150$ visitors per hour" :db/id #edb/ref 17592186327801} {:answer/id #uuid "9571fdf5-f5e6-5c7d-844e-6c82e23412aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ hours after launching, the number of visitors decreased by a total of $1\\,500$ visitors" :db/id #edb/ref 17592186328236}] :answer-field/correct {:answer/id #uuid "2d5469b6-041f-5e92-a4a1-d055f18d58b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ hours after launching, the number of visitors increased at a rate of $1\\,500$ visitors per hour" :db/id #edb/ref 17592186327334} :answer-field/id #uuid "b67658e3-d1f9-53fe-9d3e-ca9f1907b2b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329503}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d89bcd84-b867-5262-b6e7-a8266afa7fe2" :question/math-academy-id "q-48709" :question/problem "The function $V(t)$ models the number of visitors, in thousands, to a new website, $t$ hours after the website's launch. What is the best interpretation of the statement below?\n\n$\\,$ *The slope of the tangent line to the graph of $V(t)$ at $t=10$ is equal to $1.5.$*" :question/worked-solution "The slope of the line tangent to the graph of $V(t)$ at $t=10$ gives the derivative of $V(t)$ at $t=10.$ So, we have that\n\n$$\n{V}^{′}(10)=1.5.\n$$\n\nWe can interpret the above statement as\n\n$\\,$ *$10$ hours after launching, the number of visitors increased at a rate of $1\\,500$ visitors per hour.*"}] [{:db/id #edb/ref 17592186329917 :knowledge-point/_questions [{:db/id #edb/ref 17592186078385 :knowledge-point/id #uuid "20b289d4-96a7-5d1b-9714-6afabab4804d" :knowledge-point/title "Further Determining Rates of Change in Geometrical Settings"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e15011b-d73b-5f22-b4f0-a15022660fc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186327477} {:answer/id #uuid "4df3dc0b-3c66-5b0c-9233-fc024c2c2e79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,{\\text{cm}}^{2}/\\text{cm}" :db/id #edb/ref 17592186327610} {:answer/id #uuid "929e9c48-dfc0-5b94-944e-91b75a184293" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186328211} {:answer/id #uuid "a25c5714-78cc-5cc1-8d9c-67634fc3e3e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,{\\text{cm}}^{2}/\\text{cm}" :db/id #edb/ref 17592186328340} {:answer/id #uuid "c2ffe668-436d-5964-a066-4569f02017c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,{\\text{cm}}^{2}/\\text{cm}" :db/id #edb/ref 17592186328637}] :answer-field/correct {:answer/id #uuid "4df3dc0b-3c66-5b0c-9233-fc024c2c2e79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,{\\text{cm}}^{2}/\\text{cm}" :db/id #edb/ref 17592186327610} :answer-field/id #uuid "ed04a43e-d5dc-56f8-8840-4184e8566674" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329597}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d2ec9a19-d603-5b0b-942d-afd44e39a0e9" :question/math-academy-id "q-48720" :question/problem "![](images/2b/2b5d589462bf2477be3d305ea88f3d5462b7d6ea4e001a9a71790d53e1683665.png)\n\nThe area of a square is increasing. Find the instantaneous rate at which the area of a square is increasing with respect to the length of its side at the moment when the length of the sides is equal to $l=6\\,\\text{cm}.$" :question/worked-solution "We know that the area of the square with respect to $l$ is given by  \n\n$$\nA=A(l)={l}^{2}.\n$$\n\nTaking the derivative, the rate of change of $A(l)$  with respect to $l$ is \n\n$$\n\\begin{aligned}{A}^{′}(l) & =\\frac{\\text{d}}{\\text{d}l}({l}^{2})=2l,\\end{aligned}\n$$\n\nand evaluating at $l=6$ gives\n\n$$\n{A}^{′}(6)=2(6)=12.\n$$\n\n \n\nTherefore, the instantaneous rate at which the area of the square is increasing when the length of the side is $l=6\\,\\text{cm}$ is $12\\,{\\text{cm}}^{2}/\\text{cm}.$"}] [{:db/id #edb/ref 17592186329922 :knowledge-point/_questions [{:db/id #edb/ref 17592186078386 :knowledge-point/id #uuid "dff5ec0b-1456-5231-94e1-0fc5923d6672" :knowledge-point/title "Determining a Rate of Change for a Given Function at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67e970de-f69a-5faf-a1f9-894ed9152874" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{4}{3}$ gallons per dollar" :db/id #edb/ref 17592186327833} {:answer/id #uuid "8f9408c5-73a6-5a07-a318-c5f403503efe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{1}{3}$ dollars per gallon" :db/id #edb/ref 17592186328188} {:answer/id #uuid "9ade8d73-66b2-5f69-b283-68aec2a496fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{3}{4}$ dollars per gallon" :db/id #edb/ref 17592186328275} {:answer/id #uuid "c1834f7c-5892-5dbc-a7c9-15c6c63601cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-\\frac{4}{3}$ dollars per gallon" :db/id #edb/ref 17592186328623} {:answer/id #uuid "e1cff52d-84f6-52a6-8958-91f1bdf338cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-\\frac{3}{4}$ gallons per dollar" :db/id #edb/ref 17592186328909}] :answer-field/correct {:answer/id #uuid "c1834f7c-5892-5dbc-a7c9-15c6c63601cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-\\frac{4}{3}$ dollars per gallon" :db/id #edb/ref 17592186328623} :answer-field/id #uuid "888f3e42-3c7e-547b-8e3c-866522e779ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329412}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "113af4b2-44b6-5fbb-b225-f94f6ccbc4f2" :question/math-academy-id "q-48742" :question/problem "The function $P(v)=\\frac{2v+50}{v+1}$ models the price at which gas is sold, in dollars, depending on the volume $v$ sold the previous day, in gallons. What is the instantaneous rate of change of the price of gas when $v=5$ gallons?" :question/worked-solution "The instantaneous rate of change of the price when $v=5$ gallons is equal to ${P}^{′}(5).$\n\nNow, we take the derivative and get\n\n$$\n\\begin{aligned}{P}^{′}(v) & =\\frac{\\text{d}}{\\text{d}v}(\\frac{2v+50}{v+1}) \\\\  & =\\frac{\\frac{\\text{d}}{\\text{d}v}(2v+50)\\cdot (v+1)-(2v+50)\\cdot \\frac{\\text{d}}{\\text{d}v}(v+1)}{(v+1)^{2}} \\\\  & =\\frac{(2)\\cdot (v+1)-(2v+50)\\cdot (1)}{(v+1)^{2}} \\\\  & =\\frac{2v+2-2v-50}{(v+1)^{2}} \\\\  & =-\\frac{48}{(v+1)^{2}}.\\end{aligned}\n$$\n\nNow, substituting $v=5$, we get\n\n$$\n\\begin{aligned}{P}^{′}(5) & =-\\frac{48}{((5)+1)^{2}} \\\\  & =-\\frac{48}{36} \\\\  & =-\\frac{4}{3}.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate change of the price when $v=5$ gallons is $-\\frac{4}{3}$ dollars per gallon."}] [{:db/id #edb/ref 17592186329926 :knowledge-point/_questions [{:db/id #edb/ref 17592186064259 :knowledge-point/id #uuid "00a74f63-a4eb-5894-b4a4-eb4fd297a3f3" :knowledge-point/title "Finding a Point on a Curve With a Certain Slope"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1eaebcbd-9756-50eb-bd1d-5df67107c5f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=3" :db/id #edb/ref 17592186327200} {:answer/id #uuid "76095c4e-fe50-5e62-a537-b4a30720bfe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-3" :db/id #edb/ref 17592186327946} {:answer/id #uuid "9a0124b8-1270-54e6-85c6-b6c4821e0345" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=1" :db/id #edb/ref 17592186328265} {:answer/id #uuid "a11fde28-0164-5479-b55c-449aff8e5bd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-3,\\,1." :db/id #edb/ref 17592186328332} {:answer/id #uuid "f75dcddb-213f-536c-96ae-50a77358eeb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1,\\,3" :db/id #edb/ref 17592186329105}] :answer-field/correct {:answer/id #uuid "f75dcddb-213f-536c-96ae-50a77358eeb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1,\\,3" :db/id #edb/ref 17592186329105} :answer-field/id #uuid "587f04fc-1b5a-59da-ba85-fcbbd60d19f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329343}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ac72967c-0395-50e5-812a-2bfe9c19348f" :question/math-academy-id "q-48817" :question/problem "Find the $x$-coordinates of the points on the curve $y=-2{x}^{3}+6{x}^{2}+20x-1$ whose tangent has a slope of $2.$" :question/worked-solution "Let $f(x)=-2{x}^{3}+6{x}^{2}+20x-1.$ The slope of the tangent at the point $x$ is equal to ${f}^{′}(x).$ Computing the derivative, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(-2{x}^{3}+6{x}^{2}+20x-1) \\\\  & =-2\\frac{\\text{d}}{\\text{d}x}({x}^{3})+6\\frac{\\text{d}}{\\text{d}x}({x}^{2})+20\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(1) \\\\  & =-2\\cdot 3{x}^{2}+6\\cdot 2x+20\\cdot 1-0 \\\\  & =-6{x}^{2}+12x+20.\\end{aligned}\n$$\n\nWe now set ${f}^{′}(x)=2$ and solve for $x:$\n\n$$\n\\begin{aligned}-6{x}^{2}+12x+20 & =2 \\\\ -6{x}^{2}+12x+18 & =0 \\\\ -6({x}^{2}-2x-3) & =0 \\\\ -6(x+1)(x-3) & =0.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent is equal to $2$ at the points where $x=-1,3.$"}] [{:db/id #edb/ref 17592186329927 :knowledge-point/_questions [{:db/id #edb/ref 17592186100920 :knowledge-point/id #uuid "2f08b8fa-6f05-5c10-b2d7-5d35e6c48e74" :knowledge-point/title "Computing the Derivative of a Product Given the Necessary Data"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a91b002-bedc-510c-80ac-f78dd9d30e15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{2}" :db/id #edb/ref 17592186327584} {:answer/id #uuid "57dc5b1f-b7a5-582e-8d8a-dfe2311da82d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3e" :db/id #edb/ref 17592186327703} {:answer/id #uuid "602bf6cc-f379-509b-b24f-a7a7348f90d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{e}^{2}" :db/id #edb/ref 17592186327779} {:answer/id #uuid "629e0549-d5e9-5dae-bbbf-54474664a90e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e" :db/id #edb/ref 17592186327796} {:answer/id #uuid "eba393cc-1f36-5519-865e-16fdc999f7a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{e}" :db/id #edb/ref 17592186328996}] :answer-field/correct {:answer/id #uuid "57dc5b1f-b7a5-582e-8d8a-dfe2311da82d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3e" :db/id #edb/ref 17592186327703} :answer-field/id #uuid "b7098143-3be2-5bb1-8586-d6d0b447a237" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329504}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "453f2cf0-7530-570a-af1d-cd58417d4794" :question/math-academy-id "q-48835" :question/problem "For the function $f(x)$ and $g(x)$, you're given the following data:\n\n$$\nf(e)=1,\\,{f}^{′}(e)=\\frac{1}{e},\\,g(e)={e}^{2},\\,{g}^{′}(e)=2e\n$$\n\nCompute $\\frac{\\text{d}}{\\text{d}x}(f(x)g(x))$ at $x=e.$" :question/worked-solution "Using the product rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(f(x)g(x)) & =f(x){g}^{′}(x)+g(x){f}^{′}(x).\\end{aligned}\n$$\n\nAt the point where $x=e$, this gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}}{\\text{d}x}(f(x)g(x))|}_{x=e} & =f(e){g}^{′}(e)+g(e){f}^{′}(e) \\\\  & =1\\cdot 2e+{e}^{2}\\cdot \\frac{1}{e} \\\\  & =3e.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329928 :knowledge-point/_questions [{:db/id #edb/ref 17592186100920 :knowledge-point/id #uuid "2f08b8fa-6f05-5c10-b2d7-5d35e6c48e74" :knowledge-point/title "Computing the Derivative of a Product Given the Necessary Data"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ae7586a-2102-574e-9b18-822f6929fad3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{4}" :db/id #edb/ref 17592186327029} {:answer/id #uuid "16c746d7-4cac-5551-a09b-0f2b80bf776b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{4}" :db/id #edb/ref 17592186327132} {:answer/id #uuid "2fba0d9f-cb1e-5ddd-aa91-90102d0d5db3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186327360} {:answer/id #uuid "b918127f-fb63-5f62-b855-8aa8a0ce41bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}" :db/id #edb/ref 17592186328549} {:answer/id #uuid "e8d88c8d-a4e4-5907-b91a-d2dc4d72d1f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{4}" :db/id #edb/ref 17592186328971}] :answer-field/correct {:answer/id #uuid "0ae7586a-2102-574e-9b18-822f6929fad3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{4}" :db/id #edb/ref 17592186327029} :answer-field/id #uuid "28119b73-a9a4-5084-a3ff-38ce56c25333" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329255}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "85dcfb6d-59c6-5a6b-b23d-70f1ab526efc" :question/math-academy-id "q-48836" :question/problem "For the function $f(x)$ and $g(x)$, you're given the following data:\n\n$$\nf(4)=-3,\\,{f}^{′}(4)=-1,\\,g(4)=2,\\,{g}^{′}(4)=\\frac{1}{4}\n$$\n\nCompute $\\frac{\\text{d}}{\\text{d}x}(f(x)g(x))$ at $x=4.$" :question/worked-solution "Using the product rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(f(x)g(x)) & =f(x){g}^{′}(x)+g(x){f}^{′}(x).\\end{aligned}\n$$\n\nAt the point where $x=4$, this gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}}{\\text{d}x}(f(x)g(x))|}_{x=4} & =f(4){g}^{′}(4)+g(4){f}^{′}(4) \\\\  & =(-3)\\cdot \\frac{1}{4}+2\\cdot (-1) \\\\  & =-\\frac{11}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186101442 :knowledge-point/_questions [{:db/id #edb/ref 17592186100827 :knowledge-point/id #uuid "d2b7d79a-cd1a-583f-be7a-d568bc8e32a3" :knowledge-point/title "Computing the Derivative of a Quotient Given the Necessary Data"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32bb9385-2e12-5272-a62e-7d322f0c0aec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186327376} {:answer/id #uuid "5e4c6fb8-1d6a-5d01-87cb-cc2ae9db526c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186327764} {:answer/id #uuid "61f5b08e-b4f8-5cd7-9366-887df6c9c695" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186327790} {:answer/id #uuid "d5dac1be-d0a9-5355-b292-386fa99e59b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186328805} {:answer/id #uuid "f54e32a5-58a3-5982-876f-705094203b21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186329078}] :answer-field/correct {:answer/id #uuid "5e4c6fb8-1d6a-5d01-87cb-cc2ae9db526c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186327764} :answer-field/id #uuid "154ce75e-a9a9-555e-96c7-1de5d9741872" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329220}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3cd961da-21ad-5bfd-88cf-d61e5f8fe86e" :question/math-academy-id "q-48844" :question/problem "For the functions $f(x)$ and $g(x),$ you are given the following data:\n\n$$\nf(0)=2,\\,{f}^{′}(0)=2,\\,g(0)=1,\\,{g}^{′}(0)=2\n$$\n\nCompute $\\frac{\\text{d}}{\\text{d}x}(\\frac{f(x)}{g(x)})$ at $x=0.$" :question/worked-solution "Using the quotient rule, we get\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{f(x)}{g(x)})=\\frac{{f}^{′}(x)g(x)-f(x){g}^{′}(x)}{(g(x))^{2}}.\n$$\n\nAt the point where $x=0$, this gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}}{\\text{d}x}(\\frac{f(x)}{g(x)})|}_{x=0} & =\\frac{{f}^{′}(0)g(0)-f(0){g}^{′}(0)}{{g}^{2}(0)} \\\\  & =\\frac{2\\cdot 1-2\\cdot 2}{{1}^{2}} \\\\  & =-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329938 :knowledge-point/_questions [{:db/id #edb/ref 17592186064154 :knowledge-point/id #uuid "c7df31c9-b27a-5ce2-93c8-178ba96da000" :knowledge-point/title "Determining a Rate of Change"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d986347-5304-5bf8-9489-b5458173cd49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-94$ elephants per year" :db/id #edb/ref 17592186327049} {:answer/id #uuid "38a1f85b-0932-59c9-8d00-d2afb106da3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-200$ elephants per year" :db/id #edb/ref 17592186327430} {:answer/id #uuid "5acea6b6-3caf-5eff-af39-aa31ffcec36a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-220$ elephants per year" :db/id #edb/ref 17592186327729} {:answer/id #uuid "d9489eab-ebee-5d5c-a32b-d59ea30a9b42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$420$ elephants per year" :db/id #edb/ref 17592186328833} {:answer/id #uuid "e22a41b0-6c91-593e-ac0d-e8429be02811" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$240$ elephants per year" :db/id #edb/ref 17592186328914}] :answer-field/correct {:answer/id #uuid "38a1f85b-0932-59c9-8d00-d2afb106da3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-200$ elephants per year" :db/id #edb/ref 17592186327430} :answer-field/id #uuid "eabd25e6-300b-5d8d-ae1c-f832bb8ce89c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329593}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2f24a112-83bc-5dfc-b8eb-4133c86e6e85" :question/math-academy-id "q-48914" :question/problem "The birth rate of a herd of elephants in a region in Africa is modeled by the function  $B(t)=500\\cdot {2}^{0.125t}$ while the rate of death is modeled by $D(t)=400\\cdot {3}^{0.125t}.$ In both cases, $t$ represents the number of years since $1990.$  \n\nWhat was the rate of change of the elephant population in that region in $1998?$" :question/worked-solution "The  rate of change in the number of elephants  $t$ years since $1990$ is equal to the difference between the two given rates, that is\n\n$$\nB(t)-D(t).\n$$\n\nAs $1998$ is $8$ years after $1990$, we have $t=8.$  Hence, the  rate of change in the elephant population in that region in $1998$ was \n\n$$\n\\begin{aligned}B(8)-D(8) & =500\\cdot {2}^{0.125(8)}-400\\cdot {3}^{0.125(8)} \\\\  & =500\\cdot 2-400\\cdot 3 \\\\  & =-200.\\end{aligned}\n$$\n\nTherefore, the rate of change in the elephant population was $-200$ elephants per year."}] [{:db/id #edb/ref 17592186329942 :knowledge-point/_questions [{:db/id #edb/ref 17592186096807 :knowledge-point/id #uuid "0e274fe1-7242-5a6c-8351-eeff9877d2bf" :knowledge-point/title "Computing the Derivative of a Quotient of Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e62398c-c7f2-5a90-94bd-6534d22dd4f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186328169} {:answer/id #uuid "99b31e0c-b9b1-53de-af5e-060da1733789" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186328262} {:answer/id #uuid "a8518df8-be72-56e5-a662-44b7d46a18e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186328392} {:answer/id #uuid "dc886477-bb24-5eb3-b05d-d4dc07641d24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186328859} {:answer/id #uuid "ff6183e1-ed84-51b0-b43f-2a95ee508630" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186329176}] :answer-field/correct {:answer/id #uuid "a8518df8-be72-56e5-a662-44b7d46a18e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186328392} :answer-field/id #uuid "ef80b9f7-4df8-5e89-9334-106d6c34b0e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329600}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "432a3453-fc74-5b9b-8b50-79e9585f1cfe" :question/math-academy-id "q-48952" :question/problem "![](images/e1/e13e109301fca50036cbf933b2a7946f3f53397f39f5e249c0d64e1f6ae78ba2.png)\n\nGiven the plots of $y=f(x)$ and $y=g(x)$ above, find ${q}^{′}(\\frac{3}{2})$ where $q(x)=\\frac{f(x)}{g(x)}.$" :question/worked-solution "The quotient rule for derivatives gives\n\n$$\n{q}^{′}(x)=\\frac{{f}^{′}(x)\\cdot g(x)-f(x)\\cdot {g}^{′}(x)}{(g(x))^{2}}.\n$$\n\nAs a result, we have that\n\n$$\n{q}^{′}(\\frac{3}{2})=\\frac{{f}^{′}(\\frac{3}{2})\\cdot g(\\frac{3}{2})-f(\\frac{3}{2})\\cdot {g}^{′}(\\frac{3}{2})}{{(g(\\frac{3}{2}))}^{2}}.\n$$\n\nFrom the graph above, we obtain that $f(\\frac{3}{2})=1$ and $g(\\frac{3}{2})=-1.$\n\nAdditionally:\n\n- The slope of $f(x)$ on $x\\in (1,3)$ equals $0.$ So, ${f}^{′}(\\frac{3}{2})=0.$\n\n- The slope of $g(x)$ on $x\\in (1,3)$ equals $1.$ So, ${g}^{′}(\\frac{3}{2})=1.$\n\nFinally, we have\n\n$$\n\\begin{aligned}{q}^{′}(\\frac{3}{2}) & =\\frac{{f}^{′}(\\frac{3}{2})\\cdot g(\\frac{3}{2})-f(\\frac{3}{2})\\cdot {g}^{′}(\\frac{3}{2})}{{(g(\\frac{3}{2}))}^{2}} \\\\  & =\\frac{0\\cdot (-1)-1\\cdot 1}{(-1)^{2}} \\\\  & =-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329944 :knowledge-point/_questions [{:db/id #edb/ref 17592186100827 :knowledge-point/id #uuid "d2b7d79a-cd1a-583f-be7a-d568bc8e32a3" :knowledge-point/title "Computing the Derivative of a Quotient Given the Necessary Data"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03c9c5af-ae60-5c19-98de-2006a010f6a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186326974} {:answer/id #uuid "725259ac-e334-586e-b4bf-e101625ee9dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186327923} {:answer/id #uuid "b72f49d7-33bf-5349-9709-3d90489d4014" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186328527} {:answer/id #uuid "b9a0ce48-bfd5-5bc5-a291-7a5731068d01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186328553} {:answer/id #uuid "e911496f-9a62-5fc4-92e0-55083c62392c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186328974}] :answer-field/correct {:answer/id #uuid "03c9c5af-ae60-5c19-98de-2006a010f6a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186326974} :answer-field/id #uuid "fc3899ec-04b9-5456-8803-fb530c320aa6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329621}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "963ec6dc-aa96-5129-a681-815db2627be7" :question/math-academy-id "q-48960" :question/problem "The values of functions $f(x)$ and $g(x)$ and their derivatives at $x=3$ are given in the table below. \n\n| $x$ | $f(x)$ | $g(x)$ | ${f}^{′}(x)$ | ${g}^{′}(x)$ |\n| --- | --- | --- | --- | --- |\n| $3$ | $2$ | $-1$ | $-4$ | $\\frac{1}{2}$ |\n\nCompute $\\frac{\\text{d}}{\\text{d}x}(\\frac{f(x)}{g(x)})$ at $x=3.$" :question/worked-solution "Using the quotient rule, we get\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{f(x)}{g(x)})=\\frac{{f}^{′}(x)g(x)-f(x){g}^{′}(x)}{(g(x))^{2}}.\n$$\n\nAt the point where $x=3$, this gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}}{\\text{d}x}(\\frac{f(x)}{g(x)})|}_{x=3} & =\\frac{{f}^{′}(3)g(3)-f(3){g}^{′}(3)}{(g(3))^{2}} \\\\  & =\\frac{(-4)\\cdot (-1)-2\\cdot \\frac{1}{2}}{(-1)^{2}} \\\\  & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329945 :knowledge-point/_questions [{:db/id #edb/ref 17592186100828 :knowledge-point/id #uuid "f1d07a6d-3994-5620-a756-ee6e2c0a8de6" :knowledge-point/title "Computing the Derivative of the Product or Quotient of a Composition of Functions Given the Necessary Data"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e8612e1-4306-5c49-8f06-ea7b5746fb9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186327198} {:answer/id #uuid "6e07c738-ae4e-5929-8e41-f604a66d3b5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186327887} {:answer/id #uuid "a079bd8b-5910-56b6-8f1c-d4c339443dad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186328323} {:answer/id #uuid "b0b17434-b7e6-5437-8e57-734e2d888aa7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186328467} {:answer/id #uuid "f0d7b11d-8f56-571b-a255-73e3d45babfd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186329037}] :answer-field/correct {:answer/id #uuid "a079bd8b-5910-56b6-8f1c-d4c339443dad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186328323} :answer-field/id #uuid "79b8edb2-ee82-5b3e-a449-9f7e35912b1f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329385}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d3a263d5-d91f-5cc8-85f3-bb4b472cc091" :question/math-academy-id "q-48965" :question/problem "For the functions $f(x)$ and $g(x),$ you're given the following data:\n\n$$\nf(2)=-1,\\,{f}^{′}(2)=-2,\\,g(2)=-5,\\,{g}^{′}(2)=1\n$$\n\nIf $h(x)=\\frac{5f(x)+4}{g(x)+6},$ find the value of ${h}^{′}(2).$" :question/worked-solution "The quotient rule states that\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{u}{v})=\\frac{v{u}^{′}-u{v}^{′}}{{v}^{2}}.\n$$\n\nLet $u=5f(x)+4$ and $v=g(x)+6.$ Differentiating each, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5{f}^{′}(x)\\,\\text{and}\\,\\frac{\\text{d}v}{\\text{d}x}={g}^{′}(x).\n$$\n\nSubstituting this into the quotient rule gives\n\n$$\n\\begin{aligned}{h}^{′}(x) & =\\frac{v{u}^{′}-u{v}^{′}}{{v}^{2}} \\\\  & =\\frac{(g(x)+6)\\cdot 5{f}^{′}(x)-(5f(x)+4)\\cdot {g}^{′}(x)}{(g(x)+6)^{2}} \\\\  & =\\frac{5{f}^{′}(x)(g(x)+6)-{g}^{′}(x)(5f(x)+4)}{(g(x)+6)^{2}}.\\end{aligned}\n$$\n\nAt $x=2$, this gives\n\n$$\n\\begin{aligned}{h}^{′}(2) & =\\frac{5{f}^{′}(2)(g(2)+6)-{g}^{′}(2)(5f(2)+4)}{(g(2)+6)^{2}} \\\\  & =\\frac{5\\cdot (-2)\\cdot (-5+6)-1\\cdot (5\\cdot (-1)+4)}{(-5+6)^{2}} \\\\  & =\\frac{(-10)\\cdot 1-(-1)}{{1}^{2}} \\\\  & =-9.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332660 :knowledge-point/_questions [{:db/id #edb/ref 17592186105716 :knowledge-point/id #uuid "3c865ec2-5bed-5892-966b-a586097be923" :knowledge-point/title "Integrating the Sum of a Reciprocal Function and a Power Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25ea8d40-84bf-534f-8e8c-6302589f6d1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2xln⁡|x|+C" :db/id #edb/ref 17592186330280} {:answer/id #uuid "3a4ddb04-2a0f-541d-8c66-b81a1140bf9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "ln⁡|2-\\frac{1}{x}|+C" :db/id #edb/ref 17592186330472} {:answer/id #uuid "9ecd5285-27bd-58a2-ae63-f8d42089b197" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-ln⁡|x|+C" :db/id #edb/ref 17592186331373} {:answer/id #uuid "ebfcaae4-3cd8-5b37-ad78-afba74998213" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x-4ln⁡|x|-\\frac{1}{x}+C" :db/id #edb/ref 17592186332021} {:answer/id #uuid "f6fa8737-41d4-5415-b503-7159707db2c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(2x-ln⁡|x|)}^{2}+C" :db/id #edb/ref 17592186332118}] :answer-field/correct {:answer/id #uuid "ebfcaae4-3cd8-5b37-ad78-afba74998213" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x-4ln⁡|x|-\\frac{1}{x}+C" :db/id #edb/ref 17592186332021} :answer-field/id #uuid "0a2c34fc-7951-5002-8305-c48283de9967" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332210}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3c37bd55-c0e8-559f-80d9-e5fdbb837ece" :question/math-academy-id "q-49100" :question/problem "Find the integral of ${(2-\\frac{1}{x})}^{2}$ with respect to $x.$" :question/worked-solution "Expanding the binomial and applying the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int {(2-\\frac{1}{x})}^{2}\\text{d}x & =\\int (4-\\frac{4}{x}+\\frac{1}{{x}^{2}})\\text{d}x \\\\  & =\\int 4\\,\\text{d}x-\\int \\frac{4}{x}\\,\\text{d}x+\\int \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & =4\\int \\text{d}x-4\\int \\frac{1}{x}\\,\\text{d}x+\\int \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & =4x-4ln⁡|x|+\\frac{{x}^{-2+1}}{-2+1}+C \\\\  & =4x-4ln⁡|x|-\\frac{1}{x}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332662 :knowledge-point/_questions [{:db/id #edb/ref 17592186064180 :knowledge-point/id #uuid "caf358b8-31fb-5587-8663-f414317c42be" :knowledge-point/title "Integrating Secant Squared"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "274362a6-a3c6-5920-81f8-1b2abcf16ef9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7tan⁡x+4csc⁡x+C" :db/id #edb/ref 17592186330301} {:answer/id #uuid "4a02aa3a-212d-52ee-bcdb-e1c48e5f318d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7tan⁡x-4csc⁡x+C" :db/id #edb/ref 17592186330616} {:answer/id #uuid "6d5434a6-e354-57cc-8be3-921a471e1964" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7tan⁡x+4sec⁡x+C" :db/id #edb/ref 17592186330929} {:answer/id #uuid "c85ca58b-0676-50a2-a51f-81c36b63f586" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7cot⁡x+4sec⁡x+C" :db/id #edb/ref 17592186331724} {:answer/id #uuid "eeff4377-3048-5370-9c27-9dad4e9d4466" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7cot⁡x-4sec⁡x+C" :db/id #edb/ref 17592186332047}] :answer-field/correct {:answer/id #uuid "6d5434a6-e354-57cc-8be3-921a471e1964" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7tan⁡x+4sec⁡x+C" :db/id #edb/ref 17592186330929} :answer-field/id #uuid "f5cb83ec-ba9e-5744-a1c6-b0f47594acda" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332632}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c3a5d5fb-8f22-572d-9122-04a2c3a1b6ad" :question/math-academy-id "q-49122" :question/problem "Calculate $\\int sec⁡x(7sec⁡x+4tan⁡x)\\text{d}x.$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int sec⁡xtan⁡x\\,\\text{d}x & =sec⁡x+C, \\\\ \\int {sec}^{2}⁡x\\,\\text{d}x & =tan⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int sec⁡x(7sec⁡x+4tan⁡x)\\text{d}x & =\\int (7{sec}^{2}⁡x+4sec⁡xtan⁡x)\\text{d}x \\\\  & =\\int 7{sec}^{2}⁡x\\,\\text{d}x+\\int 4sec⁡xtan⁡x\\,\\text{d}x \\\\  & =7\\int {sec}^{2}⁡x\\,\\text{d}x+4\\int sec⁡xtan⁡x\\,\\text{d}x \\\\  & =7tan⁡x+4sec⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332706 :knowledge-point/_questions [{:db/id #edb/ref 17592186064208 :knowledge-point/id #uuid "af32f07f-fa65-5ede-a506-735dc2d3a5ef" :knowledge-point/title "Integrating a Combination of Linear Rational Functions Using the General Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "228ee8e3-4cbc-54ca-86e0-41d6984f52f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(K|(1+x)(1-x)|)" :db/id #edb/ref 17592186330248} {:answer/id #uuid "415b24a1-a0a1-566e-804a-10c3a545d297" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(K|(1+x)(1-x)|)" :db/id #edb/ref 17592186330529} {:answer/id #uuid "4af1094c-11cd-5b21-a560-c386722e9007" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(K|\\frac{1+x}{1-x}|)" :db/id #edb/ref 17592186330628} {:answer/id #uuid "5e33cd57-a4d3-57fa-af23-86332f408cbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(K|\\frac{1+x}{1-x}|)" :db/id #edb/ref 17592186330791} {:answer/id #uuid "86a4a011-da14-5843-825b-84a1ae516e62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(K|\\frac{1+x}{1-x}|)" :db/id #edb/ref 17592186331147}] :answer-field/correct {:answer/id #uuid "86a4a011-da14-5843-825b-84a1ae516e62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(K|\\frac{1+x}{1-x}|)" :db/id #edb/ref 17592186331147} :answer-field/id #uuid "d573eb9f-5b4a-5c4d-be89-c86d1a19944c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332577}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1dc5a85a-4afe-5495-af86-22c90f6982a7" :question/math-academy-id "q-49360" :question/problem "Calculate $\\int (\\frac{1}{1+x}+\\frac{1}{1-x})\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "Let's solve this using the general formula:\n\n$$\n\\begin{aligned}\\int (\\frac{1}{1+x}+\\frac{1}{1-x})\\,\\text{d}x & =\\int \\frac{1}{1+x}\\,\\text{d}x+\\int \\frac{1}{1-x}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡|1+x|-\\operatorname{ln}⁡|1-x|+C \\\\  & =\\operatorname{ln}⁡|\\frac{1+x}{1-x}|+\\operatorname{ln}⁡K \\\\  & =\\operatorname{ln}⁡(K|\\frac{1+x}{1-x}|)\\end{aligned}\n$$\n\nNotice that we used the laws of logarithms to write the result as a single logarithm."}] [{:db/id #edb/ref 17592186398876 :knowledge-point/_questions [{:db/id #edb/ref 17592186064205 :knowledge-point/id #uuid "0ae5760b-9277-596c-8546-dca4fd985bd7" :knowledge-point/title "Integrating an Algebraic Function With Fractional Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70657675-2db0-5a10-9cf9-052f05edf016" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{11}\\sqrt[4]{(x-100)^{11}}+C" :db/id #edb/ref 17592186398878} {:answer/id #uuid "3909aff4-3810-5b83-850f-f988be7ba4f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[4]{(x-100)^{11}}+C" :db/id #edb/ref 17592186398879} {:answer/id #uuid "4061afb3-02dc-5f4e-ae19-437ea14959c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11\\sqrt[4]{(x-100)^{11}}+C" :db/id #edb/ref 17592186398880} {:answer/id #uuid "3295113f-e7ef-59d3-92a7-66e977a1b12b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[4]{(x-100)^{9}}+C" :db/id #edb/ref 17592186398881} {:answer/id #uuid "732c775a-c5f4-5d4e-91c3-0fdfab8cfb52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{9}\\sqrt[4]{(x-100)^{9}}+C" :db/id #edb/ref 17592186398882}] :answer-field/correct {:answer/id #uuid "70657675-2db0-5a10-9cf9-052f05edf016" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{11}\\sqrt[4]{(x-100)^{11}}+C" :db/id #edb/ref 17592186398878} :answer-field/id #uuid "cad56171-faf0-523d-b089-53ed18731d86" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398877}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "61d8dd43-99c6-5162-9111-9fc96bb88dcd" :question/math-academy-id "q-49439" :question/problem "Calculate the integral $\\int \\sqrt[4]{(x-100)^{7}}\\,\\text{d}x.$" :question/worked-solution "First, we rewrite the integral as\n\n$$\n\\int (x-100)^{7/4}\\,\\text{d}x.\n$$\n\nNow, we let  $u=x-100.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $u$ at the very end:\n\n$$\n\\begin{aligned}\\int (x-100)^{7/4}\\,\\text{d}x & =\\int {u}^{7/4}\\,\\text{d}u \\\\  & =\\frac{{u}^{11/4}}{11/4}+C \\\\  & =\\frac{4}{11}(x-100)^{11/4}+C \\\\  & =\\frac{4}{11}\\sqrt[4]{(x-100)^{11}}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[\\frac{4}{11}\\sqrt[4]{(x-100)^{11}}+C] & =\\frac{4}{11}\\cdot \\frac{\\text{d}}{\\text{d}x}[\\sqrt[4]{(x-100)^{11}}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =\\frac{4}{11}\\cdot \\frac{\\text{d}}{\\text{d}x}[(x-100)^{11/4}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =\\frac{4}{11}\\cdot \\frac{11}{4}(x-100)^{7/4}\\cdot \\frac{\\text{d}}{\\text{d}x}(x-100)+0 \\\\  & =(x-100)^{7/4}\\cdot 1 \\\\  & =\\sqrt[4]{(x-100)^{7}}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332718 :knowledge-point/_questions [{:db/id #edb/ref 17592186068724 :knowledge-point/id #uuid "18ce1807-3a09-5ebd-b3cd-a91db8d2b4a8" :knowledge-point/title "Integrating a Rational Function Using Natural Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b8b60ab-4072-5f31-94dd-75c493f8372d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡({x}^{2}+1)+C" :db/id #edb/ref 17592186330332} {:answer/id #uuid "7e6534ec-42dc-57fa-b80f-40c681fa5d3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡({x}^{2}+1)+C" :db/id #edb/ref 17592186331061} {:answer/id #uuid "ad30acb9-e2fc-5534-870a-032790c3f83f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{({x}^{2}+1)^{2}}+C" :db/id #edb/ref 17592186331484} {:answer/id #uuid "e1762878-a949-5466-848b-82eaa3555015" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡({x}^{2}+1)+C" :db/id #edb/ref 17592186331941} {:answer/id #uuid "f51b2f83-41fe-5b84-b9cb-eee7ef105dd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{({x}^{2}+1)^{2}}+C" :db/id #edb/ref 17592186332106}] :answer-field/correct {:answer/id #uuid "e1762878-a949-5466-848b-82eaa3555015" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡({x}^{2}+1)+C" :db/id #edb/ref 17592186331941} :answer-field/id #uuid "1f3093a8-9026-569a-a294-190db04689b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332247}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "503a6da2-cd33-5244-b696-2a607d8e13a7" :question/math-academy-id "q-49451" :question/problem "$\\int \\frac{4x}{{x}^{2}+1}\\,\\text{d}x=$" :question/worked-solution "Let $u={x}^{2}+1.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{4x}{{x}^{2}+1}\\,\\text{d}x & =4\\int \\frac{1}{{x}^{2}+1}\\cdot x\\,\\text{d}x \\\\  & =4\\int \\frac{1}{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =2\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡|u|+C \\\\  & =2\\operatorname{ln}⁡({x}^{2}+1)+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332720 :knowledge-point/_questions [{:db/id #edb/ref 17592186064206 :knowledge-point/id #uuid "fc4294d6-3d60-5c9e-a862-863e1d129049" :knowledge-point/title "Integrating a Linear Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a085972-1baf-5648-867f-fa22e0ba0ea8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡|x+4|+C" :db/id #edb/ref 17592186330175} {:answer/id #uuid "333a8449-f54e-51ed-9268-4a29c687d042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡|x+4|+C" :db/id #edb/ref 17592186330401} {:answer/id #uuid "903c6656-2cfe-57a6-9d04-bf4558a5f1f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|x+4|+C" :db/id #edb/ref 17592186331233} {:answer/id #uuid "b84ce15d-f916-5272-a13b-c0e2002f591a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\operatorname{ln}⁡|x+4|+C" :db/id #edb/ref 17592186331578} {:answer/id #uuid "c7f98b80-b189-5486-9209-b6f6b685306a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}\\operatorname{ln}⁡|x+4|+C" :db/id #edb/ref 17592186331720}] :answer-field/correct {:answer/id #uuid "333a8449-f54e-51ed-9268-4a29c687d042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡|x+4|+C" :db/id #edb/ref 17592186330401} :answer-field/id #uuid "e906895e-8048-51d8-952c-ac1ed3e3bf3a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332609}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f7ef9efb-7fe5-57f8-b97b-c7d8ad3002b1" :question/math-academy-id "q-49453" :question/problem "Calculate $\\int \\frac{3}{x+4}\\,\\text{d}x.$" :question/worked-solution "First, let $u=x+4.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{3}{x+4}\\,\\text{d}x & =3\\int \\frac{1}{x+4}\\,\\text{d}x \\\\  & =3\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡|u|+C \\\\  & =3\\operatorname{ln}⁡|x+4|+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332794 :knowledge-point/_questions [{:db/id #edb/ref 17592186068778 :knowledge-point/id #uuid "8fb50541-88df-5f3f-b9e0-cf51edae401e" :knowledge-point/title "Calculating the Derivative of a Parametric Curve at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "341bbdfc-0958-57c4-a8fc-adcfd2832b27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186330412} {:answer/id #uuid "3a4eb11e-164a-505d-8222-3a3c8cc2aa8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186330473} {:answer/id #uuid "5173e85f-be65-57f7-b4ad-50a4243824a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186330686} {:answer/id #uuid "900d9ce2-2884-5941-890f-cca5011570ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186331231} {:answer/id #uuid "e1a39abd-a637-559d-b40e-9331517387e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186331945}] :answer-field/correct {:answer/id #uuid "e1a39abd-a637-559d-b40e-9331517387e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186331945} :answer-field/id #uuid "99a69d51-520e-57bf-a0e9-67ec91b1dca0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332471}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "defadd51-e009-5740-8eb4-1acd4e92eb56" :question/math-academy-id "q-50018" :question/problem "A curve has parametric equations $x=2\\operatorname{cos}⁡(2t),\\,y=\\operatorname{sin}⁡(2t).$ Given that $\\frac{\\text{d}y}{\\text{d}x}=-\\frac{1}{2}\\operatorname{cot}⁡(2t),$ calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ at the point where $t=\\frac{\\pi }{12}.$" :question/worked-solution "To compute $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}},$ we can use the formula\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(\\frac{dy}{dx})}{(\\frac{dx}{dt})}.\\end{aligned}\n$$\n\nWe're given that $\\frac{dy}{dx}=-\\frac{1}{2}\\operatorname{cot}⁡(2t),$ and we can calculate $\\frac{dx}{dt}$ as follows:\n\n$$\n\\frac{dx}{dt}=\\frac{d}{dt}(2\\operatorname{cos}⁡(2t))=-4\\operatorname{sin}⁡(2t).\n$$\n\nSubstituting into the formula, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(-\\frac{1}{2}\\operatorname{cot}⁡(2t))}{-4\\operatorname{sin}⁡(2t)} \\\\  & =\\frac{{csc}^{2}⁡(2t)}{-4\\operatorname{sin}⁡(2t)} \\\\  & =-\\frac{1}{4}{csc}^{3}⁡(2t).\\end{aligned}\n$$\n\nFinally, we evaluate at $t=\\frac{\\pi }{12},$ and we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}{|}_{t=\\pi /12} & =-\\frac{1}{4}{csc}^{3}⁡(2\\cdot \\frac{\\pi }{12}) \\\\  & =-\\frac{1}{4{sin}^{3}⁡(\\frac{\\pi }{6})} \\\\  & =-\\frac{1}{4\\cdot {(\\frac{1}{2})}^{3}} \\\\  & =-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332815 :knowledge-point/_questions [{:db/id #edb/ref 17592186068788 :knowledge-point/id #uuid "16dac5bd-acbd-51c6-8636-172e3a55aaf1" :knowledge-point/title "Finding the Second Derivative of a Parametric Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0aedc002-f5a6-54e6-9744-7dcd1264c9db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{6}{e}^{5t-2}" :db/id #edb/ref 17592186330044} {:answer/id #uuid "94c7559f-dc37-58c5-8f05-31b0f239cbbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}{e}^{2+5t}" :db/id #edb/ref 17592186331267} {:answer/id #uuid "9770e4f7-8ffd-5efd-b347-5be76f613443" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{6}{e}^{2-5t}" :db/id #edb/ref 17592186331298} {:answer/id #uuid "99afcf09-a4ab-59a9-a911-b1d8a5327735" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6{e}^{2-5t}" :db/id #edb/ref 17592186331327} {:answer/id #uuid "c9b97d74-536f-52a5-baba-826d10b2969c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6{e}^{5-2t}" :db/id #edb/ref 17592186331736}] :answer-field/correct {:answer/id #uuid "9770e4f7-8ffd-5efd-b347-5be76f613443" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{6}{e}^{2-5t}" :db/id #edb/ref 17592186331298} :answer-field/id #uuid "4dff75f0-f423-53f7-90ad-5ea82c6cdb2d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332342}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "730becc0-14c6-5133-bbd8-aaf700159913" :question/math-academy-id "q-50242" :question/problem "A curve is defined by the parametric equations $x=2{e}^{3t},\\,y=3{e}^{t+2}-5$ where $t$ is a real number. Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}.$" :question/worked-solution "To find the first derivative, we will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=6{e}^{3t},\\,{y}^{′}(t)=3{e}^{t+2}.\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{3{e}^{t+2}}{6{e}^{3t}}=\\frac{1}{2}{e}^{2-2t}.\n$$\n\nTo compute the second derivative, we can use the formula\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(\\frac{dy}{dx})}{(\\frac{dx}{dt})}.\\end{aligned}\n$$\n\nSubstituting into the formula, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(\\frac{1}{2}{e}^{2-2t})}{6{e}^{3t}} \\\\  & =\\frac{-{e}^{2-2t}}{6{e}^{3t}} \\\\  & =-\\frac{1}{6}{e}^{2-5t}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332822 :knowledge-point/_questions [{:db/id #edb/ref 17592186068777 :knowledge-point/id #uuid "16e04567-d2e1-5eef-aee3-62d784a9fe49" :knowledge-point/title "Finding the Second Derivative of a Parametric Curve Given the First Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f191b13-825b-5416-8838-96dcdfe09985" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-4t}(4t+1)}{{t}^{3}}" :db/id #edb/ref 17592186330218} {:answer/id #uuid "9872acd7-7eb7-50ae-9b3c-851760c20bdd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-4t}(1-2t)}{{t}^{3}}" :db/id #edb/ref 17592186331311} {:answer/id #uuid "99ac4658-4973-5057-bf1a-ac90579a65ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-2t}(4t+1)}{{t}^{2}}" :db/id #edb/ref 17592186331325} {:answer/id #uuid "ca4c8a27-8293-5412-8e68-c58c6bc8b6df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-4t}(2t-1)}{{t}^{3}}" :db/id #edb/ref 17592186331741} {:answer/id #uuid "fe2c6554-4cb6-5fba-be9f-c05762bf19fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{e}^{-4t}(t+1)}{{t}^{2}}" :db/id #edb/ref 17592186332187}] :answer-field/correct {:answer/id #uuid "1f191b13-825b-5416-8838-96dcdfe09985" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-4t}(4t+1)}{{t}^{3}}" :db/id #edb/ref 17592186330218} :answer-field/id #uuid "209fa9dc-670a-542f-8478-5c1255d77e7e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332249}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "daa33906-2d77-5e9e-b519-e39e6466e412" :question/math-academy-id "q-50448" :question/problem "A curve is defined by the parametric equations $x={t}^{2}-1,\\,y={e}^{-4t}.$ Given that $\\frac{dy}{dx}=\\frac{-2{e}^{-4t}}{t},$ calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}.$" :question/worked-solution "To compute the second derivative, we can use the formula\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(\\frac{dy}{dx})}{(\\frac{dx}{dt})}.\\end{aligned}\n$$\n\nWe're given that $\\frac{dy}{dx}=\\frac{-2{e}^{-4t}}{t},$ and we can calculate $\\frac{dx}{dt}$ as follows:\n\n$$\n\\frac{dx}{dt}=\\frac{d}{dt}({t}^{2}-1)=2t\n$$\n\nSubstituting into the formula, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(\\frac{-2{e}^{-4t}}{t})}{2t} \\\\  & =\\frac{(\\frac{8t{e}^{-4t}+2{e}^{-4t}}{{t}^{2}})}{2t} \\\\  & =\\frac{8t{e}^{-4t}+2{e}^{-4t}}{2{t}^{3}} \\\\  & =\\frac{{e}^{-4t}(4t+1)}{{t}^{3}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332850 :knowledge-point/_questions [{:db/id #edb/ref 17592186096682 :knowledge-point/id #uuid "450aebfe-d896-50bc-a392-e43aee7afabd" :knowledge-point/title "Expressing a Rational Function With Two Linear Factors as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66d28f82-ac5b-5ae8-ac49-3837b5b1a0f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186330871} {:answer/id #uuid "756a3b47-ad40-5f60-9997-64713626c9e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186331003} {:answer/id #uuid "b4b69123-e74a-59d5-8172-fc7b6a40e7d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186331550} {:answer/id #uuid "bda8cb78-3b56-5886-93d1-f64c837a2d24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186331626} {:answer/id #uuid "ee7e6df2-3a00-5165-a4ca-d91a0c640677" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186332045}] :answer-field/correct {:answer/id #uuid "bda8cb78-3b56-5886-93d1-f64c837a2d24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186331626} :answer-field/id #uuid "b852ba36-bd01-51f8-af0d-af8a533d3801" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332521}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9b63aac4-0a1a-5d37-898e-889fc9ac99c7" :question/math-academy-id "q-51134" :question/problem "Given that\n\n$$\n\\frac{x+5}{(x-1)(x+1)}=\\frac{3}{(x-1)}+\\frac{B}{(x+1)},\n$$\n\nwhat is the value of $B?$" :question/worked-solution "Our task is to find $B$ such that\n\n$$\n\\begin{aligned}\\frac{x+5}{(x-1)(x+1)}=\\frac{3}{(x-1)}+\\frac{B}{(x+1)}.\\end{aligned}\n$$\n\nMultiplying both sides by $(x-1)(x+1)$ gives\n\n$$\nx+5=3(x+1)+B(x-1).\n$$\n\nFor $x=-1$, we get \n\n$$\n\\begin{aligned}(-1)+5 & =3(-1+1)+B(-1-1) \\\\ 4 & =-2B \\\\ B & =-2.\\end{aligned}\n$$"}]}
