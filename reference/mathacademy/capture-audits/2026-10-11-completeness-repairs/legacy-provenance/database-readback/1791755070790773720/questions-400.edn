#edb/ref 17592186398133} {:answer/id #uuid "77a1d4df-21dd-55c4-aa5e-6b99c9ef011e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-\\frac{1}{4})" :db/id #edb/ref 17592186398134} {:answer/id #uuid "2cf0c4d3-d5f0-5202-86d5-80c8f41021ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,0)" :db/id #edb/ref 17592186398135} {:answer/id #uuid "4cb579ad-3bd5-5860-ac4c-55d8de9d5206" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{4},0)" :db/id #edb/ref 17592186398136}] :answer-field/correct {:answer/id #uuid "b4cc77fc-0c8b-561f-9299-051fca465f89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186398132} :answer-field/id #uuid "f07588f6-2130-5bc1-a3cb-f62e9cade978" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398131}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "682478c9-f41b-564c-8e03-bd7edda3fd9a" :question/math-academy-id "q-115910" :question/problem "What are the coordinates of the vertex of the parabola ${y}^{2}=-x?$" :question/worked-solution "The standard equation of a left- or right-opening parabola that has its vertex at the origin is\n\n$$\n{y}^{2}=4px,\n$$\n\nwhere $p$ is a constant.\n\nWe can rewrite the given equation as \n\n$$\n{y}^{2}=4(-\\frac{1}{4})x.\n$$\n\nIt is now clear that our equation is of the standard type with $p=-\\frac{1}{4}.$ Therefore, our parabola has its vertex at $(0,0).$"}] [{:db/id #edb/ref 17592186250508 :knowledge-point/_questions [{:db/id #edb/ref 17592186096763 :knowledge-point/id #uuid "9e302810-8b14-5c8c-8bbb-245386a66b7c" :knowledge-point/title "Stating the Vertex of a Horizontal Parabola Given Its Equation in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "106bf08a-6288-5161-b589-b3a6bfd5d596" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-7,5)" :db/id #edb/ref 17592186247568} {:answer/id #uuid "7ecf6f9d-a2f5-586a-b320-3685a62fe9bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,-7)" :db/id #edb/ref 17592186248538} {:answer/id #uuid "9d436ef0-528d-5c42-acfd-fecb45ade3e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-7,1)" :db/id #edb/ref 17592186248822} {:answer/id #uuid "e75adbb9-dff5-55d0-b063-3054aec88c1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(7,-1)" :db/id #edb/ref 17592186249463} {:answer/id #uuid "ed0d9b69-2f3f-545f-8357-505ac2a681cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,-1)" :db/id #edb/ref 17592186249504}] :answer-field/correct {:answer/id #uuid "9d436ef0-528d-5c42-acfd-fecb45ade3e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-7,1)" :db/id #edb/ref 17592186248822} :answer-field/id #uuid "791f4c31-853e-56a1-9a6c-8d9759f6db39" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249877}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9ec04397-a1d2-5a43-be90-9c3301fd7dc0" :question/math-academy-id "q-115911" :question/problem "What are the coordinates of the vertex of the parabola $(y-1)^{2}=5(x+7)?$" :question/worked-solution "The standard equation of a left- or right-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(y-k)^{2}=4p(x-h),\n$$\n\nwhere $p$ is constant.\n\nWe can rewrite the given equation as \n\n$$\n(y-1)^{2}=4(\\frac{5}{4})(x+7).\n$$\n\nIt is now clear that our equation is of the standard type with $p=\\frac{5}{4}.$ \n\nComparing our equation with the standard equation, we can see that we have $h=-7$ and $k=1.$ Therefore, the coordinates of the vertex of the parabola are $(-7,1).$"}] [{:db/id #edb/ref 17592186250514 :knowledge-point/_questions [{:db/id #edb/ref 17592186192762 :knowledge-point/id #uuid "1acdfb7b-9e3d-5475-bb07-d5e2944294f2" :knowledge-point/title "Using an Implicitly Defined Curve to Determine a Second Coordinate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a08fcff-f9fc-5f00-a759-e7517f90bfc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186248238} {:answer/id #uuid "5ad1fa1c-c395-5d76-b97c-c7a9135a2c71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e" :db/id #edb/ref 17592186248246} {:answer/id #uuid "6811966e-a3e4-5429-bd2f-e113c90ccae3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186248358} {:answer/id #uuid "b6e4fbe9-3b05-5894-b9c0-d627a7782fc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{e}" :db/id #edb/ref 17592186249064} {:answer/id #uuid "bea8bd10-f7dc-588b-bdf4-16bef0135d41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}" :db/id #edb/ref 17592186249117}] :answer-field/correct {:answer/id #uuid "5a08fcff-f9fc-5f00-a759-e7517f90bfc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186248238} :answer-field/id #uuid "d5721355-274a-572f-bbd7-b4eb8671497a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250041}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "32cbcf42-bec0-509f-ae29-5197f19f2be6" :question/math-academy-id "q-115951" :question/problem "Consider the curve ${e}^{x}-{e}^{y}=y.$ Given that $x=x(t),$   $y=y(t),$  and $\\frac{\\text{d}x}{\\text{d}t}=-3$ on the curve at the point where $y=0,$ find the value of $\\frac{\\text{d}y}{\\text{d}t}$ at that point." :question/worked-solution "Differentiating the given relation with respect to $t$ using implicit differentiation, we get\n\n$$\n\\begin{aligned}{e}^{x}-{e}^{y} & =y \\\\ \\frac{\\text{d}}{\\text{d}t}({e}^{x}-{e}^{y}) & =\\frac{\\text{d}}{\\text{d}t}(y) \\\\ \\frac{\\text{d}}{\\text{d}t}({e}^{x})-\\frac{\\text{d}}{\\text{d}t}({e}^{y}) & =\\frac{\\text{d}}{\\text{d}t}(y) \\\\ \\frac{\\text{d}x}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}x}({e}^{x})-\\frac{\\text{d}y}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}y}({e}^{y}) & =\\frac{\\text{d}y}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}y}(y) \\\\ \\frac{\\text{d}x}{\\text{d}t}\\cdot {e}^{x}-\\frac{\\text{d}y}{\\text{d}t}\\cdot {e}^{y} & =\\frac{\\text{d}y}{\\text{d}t} \\\\ \\frac{\\text{d}x}{\\text{d}t}\\cdot {e}^{x} & =\\frac{\\text{d}y}{\\text{d}t}\\cdot ({e}^{y}+1).\\end{aligned}\n$$\n\nNow, we substitute the given information $\\frac{\\text{d}x}{\\text{d}t}=-3$ and $y=0.$ We get\n\n$$\n\\begin{aligned}(-3)\\cdot {e}^{x} & =\\frac{\\text{d}y}{\\text{d}t}\\cdot ({e}^{0}+1) \\\\ -3{e}^{x} & =2\\frac{\\text{d}y}{\\text{d}t}\\end{aligned}\n$$\n\nWe also want to substitute for $x,$ but we are not given this value. However, we can find it by substituting $y=0$ into the equation of the curve.\n\nAt the point where $y=0,$ we have\n\n$$\n\\begin{aligned}{e}^{x}-{e}^{y} & =y \\\\ {e}^{x}-{e}^{0} & =0 \\\\ {e}^{x}-1 & =0 \\\\ {e}^{x} & =1 \\\\ x & =0.\\end{aligned}\n$$\n\nFinally, substituting $x=0,$ we get \n\n$$\n\\begin{aligned}-3{e}^{0} & =2\\frac{\\text{d}y}{\\text{d}t} \\\\ -3 & =2\\frac{\\text{d}y}{\\text{d}t} \\\\ \\frac{\\text{d}y}{\\text{d}t} & =-\\frac{3}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386806 :knowledge-point/_questions [{:db/id #edb/ref 17592186083297 :knowledge-point/id #uuid "f99d4fec-bc58-5a09-9fac-38b46f233489" :knowledge-point/title "Finding the Center of a Horizontal Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "680863db-696e-54bf-815e-d81a79628f10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,16)" :db/id #edb/ref 17592186386808} {:answer/id #uuid "47bc2847-d584-582a-a11d-609029a8b0d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,-1)" :db/id #edb/ref 17592186386809} {:answer/id #uuid "3b6ec257-a50f-59b1-9c05-6d1a88d84db7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,8)" :db/id #edb/ref 17592186386810} {:answer/id #uuid "b993af9d-e1b6-586d-9b51-5a297c8535cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,4)" :db/id #edb/ref 17592186386811} {:answer/id #uuid "bdc3073a-a09b-5191-9d03-ff6dec0d602b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,4)" :db/id #edb/ref 17592186386812}] :answer-field/correct {:answer/id #uuid "47bc2847-d584-582a-a11d-609029a8b0d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,-1)" :db/id #edb/ref 17592186386809} :answer-field/id #uuid "2376383e-880e-525b-ab35-c17cbfd0147a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386807}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7fdd3814-398e-591c-9527-aafc82c5dac2" :question/math-academy-id "q-116085" :question/problem "What is the center of the hyperbola $\\frac{(x-4)^{2}}{2}-\\frac{(y+1)^{2}}{16}=1?$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nNote that the given equation can be rewritten as follows:\n\n$$\n\\frac{(x-4)^{2}}{(\\sqrt{2})^{2}}-\\frac{(y-(-1))^{2}}{{4}^{2}}=1\n$$\n\nIn this case, $h=4$ and $k=-1.$\n\nTherefore, the center of the hyperbola is $(4,-1).$"}] [{:db/id #edb/ref 17592186250524 :knowledge-point/_questions [{:db/id #edb/ref 17592186083298 :knowledge-point/id #uuid "cdab0134-e416-51cf-89fa-73ad4a2c2eb9" :knowledge-point/title "Finding the Center of a Vertical Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "316d7132-e4d2-552b-8229-76cf4a760b3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,-1)" :db/id #edb/ref 17592186247871} {:answer/id #uuid "8b9febdf-840d-5e4a-9454-270334fac866" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,6)" :db/id #edb/ref 17592186248674} {:answer/id #uuid "bb19e8fc-2e30-562b-bb53-409259921842" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-5,1)" :db/id #edb/ref 17592186249096} {:answer/id #uuid "dbb9b84b-92e1-5992-bbf6-9dbd59a7b2b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6,2)" :db/id #edb/ref 17592186249366} {:answer/id #uuid "e3d8c934-c5fd-5811-a685-9aa2936725ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,5)" :db/id #edb/ref 17592186249432}] :answer-field/correct {:answer/id #uuid "e3d8c934-c5fd-5811-a685-9aa2936725ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,5)" :db/id #edb/ref 17592186249432} :answer-field/id #uuid "bb9b725b-1554-5fc4-b7bb-be67fcd944ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249997}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "35bb8fc9-b273-5104-bbf5-373700e22296" :question/math-academy-id "q-116100" :question/problem "What is the center of the hyperbola $\\frac{(y-5)^{2}}{36}-\\frac{(x+1)^{2}}{4}=1?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nNote that the given equation can be rewritten as follows:\n\n$$\n\\frac{(y-5)^{2}}{{6}^{2}}-\\frac{(x-(-1))^{2}}{{2}^{2}}=1\n$$\n\nIn this case, we have $h=-1$ and $k=5.$\n\nTherefore, the center of the hyperbola is $(-1,5).$"}] [{:db/id #edb/ref 17592186250526 :knowledge-point/_questions [{:db/id #edb/ref 17592186083298 :knowledge-point/id #uuid "cdab0134-e416-51cf-89fa-73ad4a2c2eb9" :knowledge-point/title "Finding the Center of a Vertical Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12d15b2a-d840-5012-b070-e3462c9da9d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(36,16)" :db/id #edb/ref 17592186247594} {:answer/id #uuid "247c9c2b-5862-5eab-b7d6-5bc4e81f7699" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,6)" :db/id #edb/ref 17592186247743} {:answer/id #uuid "a0c70e60-f026-55b3-9d72-4a1fbcbe300c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(16,36)" :db/id #edb/ref 17592186248861} {:answer/id #uuid "dd02f9e6-3fef-5510-9fef-c8504811fe08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,-6)" :db/id #edb/ref 17592186249383} {:answer/id #uuid "e539cb36-7d2c-587b-a892-73405cb109ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-6,-4)" :db/id #edb/ref 17592186249442}] :answer-field/correct {:answer/id #uuid "e539cb36-7d2c-587b-a892-73405cb109ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-6,-4)" :db/id #edb/ref 17592186249442} :answer-field/id #uuid "667ba501-b342-5000-bcdf-f4159e0d68ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249850}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b2a54ae2-f488-56eb-9b24-9f9d28627e54" :question/math-academy-id "q-116103" :question/problem "What is the center of the hyperbola $\\frac{(y+4)^{2}}{16}-\\frac{(x+6)^{2}}{36}=1?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nNote that the given equation can be rewritten as follows:\n\n$$\n\\frac{(y-(-4))^{2}}{{4}^{2}}-\\frac{(x-(-6))^{2}}{{6}^{2}}=1\n$$\n\nIn this case, we have $h=-6$ and $k=-4.$\n\nTherefore, the center of the hyperbola is $(-6,-4).$"}] [{:db/id #edb/ref 17592186250527 :knowledge-point/_questions [{:db/id #edb/ref 17592186068883 :knowledge-point/id #uuid "9c698912-1f35-5110-8d5d-d490cce2e9a7" :knowledge-point/title "Solving Rational Equations Containing Quadratic Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0237b559-7d33-5cd0-9da8-8d8b205f4742" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186247438} {:answer/id #uuid "1fb99e31-a544-5220-80a8-c1892b899c64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186247705} {:answer/id #uuid "cac77d12-ae34-5ddd-8afb-806b1d42068b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186249230} {:answer/id #uuid "d2d99394-c6b7-5118-9b32-40e3e577b39d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186249294} {:answer/id #uuid "fc368912-431d-5c1c-94c8-d1e252061d60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186249623}] :answer-field/correct {:answer/id #uuid "d2d99394-c6b7-5118-9b32-40e3e577b39d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186249294} :answer-field/id #uuid "05de44ca-2588-5951-97b7-06f8b0b05597" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249677}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0f403d57-f6d2-5901-9ad6-4def1edb7127" :question/math-academy-id "q-116104" :question/problem "Which value of $x$ satisfies the equation $\\frac{3x-1}{{x}^{2}}=\\frac{2}{x}-\\frac{x-3}{{x}^{2}}?$" :question/worked-solution "We note that $x=0$ cannot be a solution since division by $0$ is undefined. \n\nThe equation has the denominators $x$ and ${x}^{2}.$ So first, we find the least common multiple (or $\\text{LCM}$) of the denominators. We find that\n\n$$\n\\text{LCM}(x,{x}^{2})={x}^{2}.\n$$\n\nSo, we multiply both sides of the equation by ${x}^{2},$ and simplify: \n\n$$\n\\begin{aligned}\\frac{3x-1}{{x}^{2}}=\\frac{2}{x}-\\frac{x-3}{{x}^{2}} \\\\ {x}^{2}\\cdot (\\frac{3x-1}{{x}^{2}}) & ={x}^{2}\\cdot (\\frac{2}{x}-\\frac{x-3}{{x}^{2}}) \\\\ {x}^{2}\\cdot (\\frac{3x-1}{{x}^{2}}) & ={x}^{2}\\cdot (\\frac{2}{x})-{x}^{2}\\cdot (\\frac{x-3}{{x}^{2}}) \\\\ \\cancel{{x}^{2}}\\cdot (\\frac{3x-1}{\\cancel{{x}^{2}}}) & =x\\cdot \\cancel{x}\\cdot (\\frac{2}{\\cancel{x}})-\\cancel{{x}^{2}}\\cdot (\\frac{x-3}{\\cancel{{x}^{2}}}) \\\\ (3x-1) & =x\\cdot 2-(x-3) \\\\ (3x-1) & =2x-(x-3)\\end{aligned}\n$$\n\nWe now have a linear equation in $x,$ and we can solve this using the addition and multiplication principles:\n\n$$\n\\begin{aligned}(3x-1) & =2x-(x-3) \\\\ 3x-1 & =2x-x+3 \\\\ 3x-1 & =x+3 \\\\ 3x-x & =3+1 \\\\ 2x & =4 \\\\ x & =2\\end{aligned}\n$$\n\nFinally, we recall that we cannot allow $x=0$ as a solution. But since $x=2\\ne 0,$ we conclude that the solution is $x=2.$"}] [{:db/id #edb/ref 17592186250529 :knowledge-point/_questions [{:db/id #edb/ref 17592186083299 :knowledge-point/id #uuid "223e29c9-1bb5-51ee-9ec8-4d5c15363951" :knowledge-point/title "Finding the Center of a Horizontal Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "517936ab-6832-55e4-a0fe-ef27e3b3a7e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-3)" :db/id #edb/ref 17592186248157} {:answer/id #uuid "6ca19062-c4cf-5547-82fd-d256d225b858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,3)" :db/id #edb/ref 17592186248385} {:answer/id #uuid "7c1070e5-6fb8-589a-b8e7-34d79476cb2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,3)" :db/id #edb/ref 17592186248514} {:answer/id #uuid "95473dab-e88c-5267-a74b-6f3a87a6bfb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,-8)" :db/id #edb/ref 17592186248751} {:answer/id #uuid "be5729f9-be49-52ba-92f4-ee35e32111da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(8,1)" :db/id #edb/ref 17592186249115}] :answer-field/correct {:answer/id #uuid "6ca19062-c4cf-5547-82fd-d256d225b858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,3)" :db/id #edb/ref 17592186248385} :answer-field/id #uuid "9c4cca46-48f9-5e49-9d19-12ffc9b3dd69" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249945}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7f27bda9-78fa-5fec-acdb-71588b2abb59" :question/math-academy-id "q-116107" :question/problem "What is the center of the hyperbola \n${x}^{2}-8{y}^{2}+6x+48y=71?$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}{x}^{2}-8{y}^{2}+6x+48y & =71 \\\\ {x}^{2}+6x-8{y}^{2}+48y & =71 \\\\ [{x}^{2}+6x]-8[{y}^{2}-6y] & =71 \\\\ [(x+3)^{2}-9]-8[(y-3)^{2}-9] & =71 \\\\ (x+3)^{2}-9-8(y-3)^{2}+72 & =71 \\\\ (x+3)^{2}-8(y-3)^{2} & =8 \\\\ \\frac{(x+3)^{2}}{8}-(y-3)^{2} & =1 \\\\ \\frac{(x-(-3))^{2}}{(\\sqrt{8})^{2}}-\\frac{(y-3)^{2}}{{1}^{2}} & =1.\\end{aligned}\n$$\n\nTherefore, the center is $(-3,3).$"}] [{:db/id #edb/ref 17592186250532 :knowledge-point/_questions [{:db/id #edb/ref 17592186083206 :knowledge-point/id #uuid "345d6df7-2ada-5c2e-8146-7c779afae3af" :knowledge-point/title "Finding the Center of a Vertical Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0da8f012-4b8e-59d2-86f2-6cf9ded76584" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6,-4)" :db/id #edb/ref 17592186247549} {:answer/id #uuid "1d73eb71-f3b0-5802-bd97-3518478f6143" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-5,-1)" :db/id #edb/ref 17592186247688} {:answer/id #uuid "5c6e6b00-01a7-50ba-8b49-1508e2c1ebb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,5)" :db/id #edb/ref 17592186248267} {:answer/id #uuid "93a15523-e8ae-509a-8f92-1e5d130afcfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,6)" :db/id #edb/ref 17592186248737} {:answer/id #uuid "f70239d3-779d-5762-a4c5-9498427f2ea9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,1)" :db/id #edb/ref 17592186249581}] :answer-field/correct {:answer/id #uuid "5c6e6b00-01a7-50ba-8b49-1508e2c1ebb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,5)" :db/id #edb/ref 17592186248267} :answer-field/id #uuid "465002b5-f411-5a4c-a8ea-09bf4dac334e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249798}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "09ea155c-8ce4-5cf1-a51e-cc7b1072dc21" :question/math-academy-id "q-116116" :question/problem "What is the center of the hyperbola $6{y}^{2}-4{x}^{2}-60y+8x=-122?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}6{y}^{2}-4{x}^{2}-60y+8x & =-122 \\\\ 6{y}^{2}-60y-4{x}^{2}+8x & =-122 \\\\ 6[{y}^{2}-10y]-4[{x}^{2}-2x] & =-122 \\\\ 6[(y-5)^{2}-25]-4[(x-1)^{2}-1] & =-122 \\\\ 6(y-5)^{2}-150-4(x-1)^{2}+4 & =-122 \\\\ 6(y-5)^{2}-4(x-1)^{2} & =-122+150-4 \\\\ 6(y-5)^{2}-4(x-1)^{2} & =24 \\\\ \\frac{(y-5)^{2}}{4}-\\frac{(x-1)^{2}}{6} & =1 \\\\ \\frac{(y-5)^{2}}{{2}^{2}}-\\frac{(x-1)^{2}}{(\\sqrt{6})^{2}} & =1.\\end{aligned}\n$$\n\nHence, the center is $(1,5).$"}]}
