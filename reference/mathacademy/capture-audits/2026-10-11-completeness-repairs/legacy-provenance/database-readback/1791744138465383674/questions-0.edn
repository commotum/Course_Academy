(x-11{)}^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({x}^{2}-22x+121)-4 & = \\\\ (x-11{)}^{2}-4 & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272292 :knowledge-point/_questions [{:db/id #edb/ref 17592186068873 :knowledge-point/id #uuid "f10e4a34-a512-5ff4-abbc-66e6830d63d0" :knowledge-point/title "Completing the Square When the Perfect Square is Isolated"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "110ee8cd-e830-5bb3-bab0-f16cb26fe2b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+4{)}^{2}-3" :db/id #edb/ref 17592186269421} {:answer/id #uuid "13e31713-81cb-5dec-8652-93d586dd34fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-3{)}^{2}-3" :db/id #edb/ref 17592186269445} {:answer/id #uuid "29d7d2be-f02c-521d-b752-bf360c856fdf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+3{)}^{2}-3" :db/id #edb/ref 17592186269648} {:answer/id #uuid "5eb20cc7-de16-5bcf-8e1b-43826770ca5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-6{)}^{2}-3" :db/id #edb/ref 17592186270109} {:answer/id #uuid "f84d763b-739b-535d-8995-04b2349046b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+6{)}^{2}-3" :db/id #edb/ref 17592186271448}] :answer-field/correct {:answer/id #uuid "f84d763b-739b-535d-8995-04b2349046b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+6{)}^{2}-3" :db/id #edb/ref 17592186271448} :answer-field/id #uuid "ee48d03a-569e-51f8-be78-887782d15f39" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271927}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "48f5b61f-2f3f-5cda-a551-c1e861cdd220" :question/math-academy-id "q-141513" :question/problem "Rewrite the expression $({y}^{2}+12y+{6}^{2})-3$ as the difference between a perfect square and a constant." :question/worked-solution "First, we recall the following formula:\n\n$$\n{y}^{2}+2ay+{a}^{2}=(y+a{)}^{2}\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{y}^{2}+12y+{6}^{2} & = \\\\ {y}^{2}+2\\cdot 6y+{6}^{2} & = \\\\ (y+6{)}^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({y}^{2}+12y+{6}^{2})-3 & = \\\\ (y+6{)}^{2}-3 & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186400930 :knowledge-point/_questions [{:db/id #edb/ref 17592186068875 :knowledge-point/id #uuid "366b36a5-c909-5ea5-a05d-a6052fcd41d7" :knowledge-point/title "Completing the Square on a Quadratic Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4bc4897-6558-52b5-bb24-657fa38a810c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=6,\\,q=8" :db/id #edb/ref 17592186400932} {:answer/id #uuid "62f6fb47-ecea-56a8-9070-83fc55e7254f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=3,\\,q=-5" :db/id #edb/ref 17592186400933} {:answer/id #uuid "3d43940b-e27a-5dff-9dca-bf6857baf92f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=3,\\,q=5" :db/id #edb/ref 17592186400934} {:answer/id #uuid "bdeaea36-9352-52ca-8483-6b276a77d472" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=6,\\,q=7" :db/id #edb/ref 17592186400935} {:answer/id #uuid "bfc66d56-1a8c-5626-b30a-e9774929570d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=3,\\,q=-4" :db/id #edb/ref 17592186400936}] :answer-field/correct {:answer/id #uuid "3d43940b-e27a-5dff-9dca-bf6857baf92f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=3,\\,q=5" :db/id #edb/ref 17592186400934} :answer-field/id #uuid "95bbc964-13ea-55a0-9065-a7c49f46fb65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400931}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bd1c73ef-6818-5b51-baee-cca065c2f0da" :question/math-academy-id "q-141539" :question/problem "If the expression ${x}^{2}+6x+14$ is written as $(x+p{)}^{2}+q,$ then what are the values of $p$ and $q?$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}+2\\cdot 3x+14\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${3}^{2},$ writing the constant term $14$ last:\n\n$$\n{{x}^{2}+2\\cdot 3x+{3}^{2}}_{⏟}-\\,{3}^{2}+14\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(x+3{)}^{2}-{3}^{2}+14\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n(x+3{)}^{2}+5.\n$$\n\nTherefore, $p=3$ and $q=5.$"}] [{:db/id #edb/ref 17592186400937 :knowledge-point/_questions [{:db/id #edb/ref 17592186068876 :knowledge-point/id #uuid "08c6d8d6-3d86-5074-bf99-0cb744c9412a" :knowledge-point/title "Completing the Square on a Quadratic Expression with a Negative Linear Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d53fe67-7a37-5135-9bda-59dc26da7eba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=-5,\\text{ }q=10" :db/id #edb/ref 17592186400939} {:answer/id #uuid "9b5c7488-0854-5209-9e72-78867a6a1be6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=5,\\text{ }q=5" :db/id #edb/ref 17592186400940} {:answer/id #uuid "a2ec775e-a603-50a4-a821-b02cc8bdf4a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=-10,\\text{ }q=5" :db/id #edb/ref 17592186400941} {:answer/id #uuid "91f01cc1-7dda-5a0a-a09b-a1edcdb5224f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=-5,\\text{ }q=5" :db/id #edb/ref 17592186400942} {:answer/id #uuid "c0e81c67-49e3-5deb-9f3d-4bfdd5f4f433" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=5,\\text{ }q=-5" :db/id #edb/ref 17592186400943}] :answer-field/correct {:answer/id #uuid "91f01cc1-7dda-5a0a-a09b-a1edcdb5224f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=-5,\\text{ }q=5" :db/id #edb/ref 17592186400942} :answer-field/id #uuid "c559c184-d951-52c2-ae9b-1fd6b5cd4853" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400938}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a81398bc-73ed-504a-b8b3-ef512650d7f6" :question/math-academy-id "q-141622" :question/problem "If the expression ${y}^{2}-10y+30$ is written as $(y+p{)}^{2}+q,$ then what are the values of $p$ and $q?$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}-2\\cdot 5y+30\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${5}^{2},$ writing the constant term $30$ last:\n\n$$\n{{y}^{2}-2\\cdot 5y+{5}^{2}}_{⏟}-\\,{5}^{2}+30\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(y-5{)}^{2}-{5}^{2}+30\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n(y-5{)}^{2}+5.\n$$\n\nTherefore, $p=-5$ and $q=5.$"}] [{:db/id #edb/ref 17592186272309 :knowledge-point/_questions [{:db/id #edb/ref 17592186068827 :knowledge-point/id #uuid "c3e24f9c-d383-5b77-a22a-8e142a072f0a" :knowledge-point/title "Solving a Quadratic Equation Given a Corresponding Perfect Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33162c16-a26a-585b-b93a-caff202d8543" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186269736} {:answer/id #uuid "472c723c-83ab-5626-ad0b-8949bf5249de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186269915} {:answer/id #uuid "929563b1-603a-55ce-b34f-10a3c1c67754" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "104" :db/id #edb/ref 17592186270550} {:answer/id #uuid "dbafdf59-1e66-5dce-9f48-65bc473487a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186271191} {:answer/id #uuid "f1de299d-a3c5-5ebc-80da-bb0051f2d8ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "109" :db/id #edb/ref 17592186271392}] :answer-field/correct {:answer/id #uuid "929563b1-603a-55ce-b34f-10a3c1c67754" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "104" :db/id #edb/ref 17592186270550} :answer-field/id #uuid "16c6ad9b-646e-5a06-a5b2-bcae2f52ebb1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271547}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f0de10d9-8ebd-58e0-b040-9c2f5e59c9c7" :question/math-academy-id "q-141812" :question/problem "Let ${x}_{1}$ and ${x}_{2}$ be the solutions of the equation ${x}^{2}-8x=20.$ Find the value ${x}_{1}^{2}+{x}_{2}^{2}.$ \n\n*Hint: Use the fact that ${x}^{2}-8x+16$ is a perfect square.*" :question/worked-solution "Using the hint, we have\n\n$$\n{x}^{2}-8x+16=(x-4{)}^{2}.\n$$\n\nFirst, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-8x & =20 \\\\ {x}^{2}-2\\cdot 4\\cdot x & =20 \\\\ {x}^{2}-2\\cdot 4\\cdot x+{4}^{2}-{4}^{2} & =20 \\\\ (x-4{)}^{2}-16 & =20\\end{aligned}\n$$\n\nNext, we isolate the perfect square by adding $16$ to both sides:\n\n$$\n\\begin{aligned}(x-4{)}^{2}-16+16 & =20+16 \\\\ (x-4{)}^{2} & =36\\end{aligned}\n$$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-4{)}^{2} & =36 \\\\ \\sqrt{(x-4{)}^{2}} & =\\sqrt{36} \\\\ |x-4| & =6 \\\\ x-4 & =\\pm 6 \\\\ x & =4\\pm 6\\end{aligned}\n$$\n\nFinally, we simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =4-6=-2 \\\\ {x}_{2} & =4+6=10\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{x}_{1}^{2}+{x}_{2}^{2}=(-2{)}^{2}+{10}^{2}=104.\n$$"}] [{:db/id #edb/ref 17592186272321 :knowledge-point/_questions [{:db/id #edb/ref 17592186068827 :knowledge-point/id #uuid "c3e24f9c-d383-5b77-a22a-8e142a072f0a" :knowledge-point/title "Solving a Quadratic Equation Given a Corresponding Perfect Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08658d01-89d0-5f4d-8f01-ca95f49a8f8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "68" :db/id #edb/ref 17592186269345} {:answer/id #uuid "91635a34-3072-5810-bbe9-632fc13648c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "58" :db/id #edb/ref 17592186270534} {:answer/id #uuid "b63daf1b-11dc-55f7-bcdf-962180261257" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186270887} {:answer/id #uuid "c16cb9a6-c3c8-5125-ae28-f529c2244338" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186270983} {:answer/id #uuid "f5121dc9-a221-5173-bccc-27c79eacbf3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186271416}] :answer-field/correct {:answer/id #uuid "91635a34-3072-5810-bbe9-632fc13648c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "58" :db/id #edb/ref 17592186270534} :answer-field/id #uuid "3f3ef694-6ed8-54b6-8d68-ea9692dda819" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271625}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "36afe386-dcce-5814-bb16-64bd8f39ae6b" :question/math-academy-id "q-142015" :question/problem "Let ${x}_{1}$ and ${x}_{2}$ be the solutions of the equation ${x}^{2}-10x=-21.$ Find the value ${x}_{1}^{2}+{x}_{2}^{2}.$ \n\n*Hint: Use the fact that ${x}^{2}-10x+25$ is a perfect square.*" :question/worked-solution "Using the hint, we have\n\n$$\n{x}^{2}-10x+25=(x-5{)}^{2}.\n$$\n\nFirst, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-10x & =-21 \\\\ {x}^{2}-2\\cdot 5\\cdot x & =-21 \\\\ {x}^{2}-2\\cdot 5\\cdot x+{5}^{2}-{5}^{2} & =-21 \\\\ (x-5{)}^{2}-25 & =-21\\end{aligned}\n$$\n\nNext, we isolate the perfect square by adding $25$ to both sides: \n\n$$\n\\begin{aligned}(x-5{)}^{2}-25+25 & =-21+25 \\\\ (x-5{)}^{2} & =4\\end{aligned}\n$$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-5{)}^{2} & =4 \\\\ \\sqrt{(x-5{)}^{2}} & =\\sqrt{4} \\\\ |x-5| & =2 \\\\ x-5 & =\\pm 2 \\\\ x & =5\\pm 2\\end{aligned}\n$$\n\nFinally, we simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =5-2=3 \\\\ {x}_{2} & =5+2=7\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{x}_{1}^{2}+{x}_{2}^{2}={3}^{2}+{7}^{2}=58.\n$$"}] [{:db/id #edb/ref 17592186284636 :knowledge-point/_questions [{:db/id #edb/ref 17592186087759 :knowledge-point/id #uuid "54588722-bb80-54ca-b100-03aca39e0c17" :knowledge-point/title "Finding the Argument of a Complex Number in the Fourth Quadrant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fc383aa-c6d8-5cb4-9f37-78f78398d296" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.84" :db/id #edb/ref 17592186282112} {:answer/id #uuid "8bcd893c-01c1-52b0-8774-2ca408dfc3cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.99" :db/id #edb/ref 17592186282899} {:answer/id #uuid "97b0eb56-a4d3-596c-a9c5-af16c716e2e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.97" :db/id #edb/ref 17592186283002} {:answer/id #uuid "e5691c8f-e6ed-5728-ace3-4968571878b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.35" :db/id #edb/ref 17592186283691} {:answer/id #uuid "ef691221-3ed8-5189-8810-d04927763ada" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.70" :db/id #edb/ref 17592186283774}] :answer-field/correct {:answer/id #uuid "ef691221-3ed8-5189-8810-d04927763ada" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.70" :db/id #edb/ref 17592186283774} :answer-field/id #uuid "a32f94de-a65d-57b8-a1d7-93ea2655c742" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284216}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "876ee8ae-f199-5a6e-ad24-4a4c31d3be35" :question/math-academy-id "q-170494" :question/problem "Find, in radians to two decimal places, the argument of $z=9-6\\text{i}.$ \n\n**Hint**: The argument of a complex number is in the range $[0,2\\pi ).$" :question/worked-solution "Let's plot $z$ in the complex plane.\n\n![](images/1b/1bc5f38d44d9df32a7493f8d210bbc17d716d8a63316e3d730a1c4258d56fe46.png)\n\nThe complex number $z$ lies in the fourth quadrant of the complex plane. Therefore $\\frac{3\\pi }{2}<arg⁡(z)<2\\pi .$ \n\nIf $\\alpha $ is the angle that $z$ makes with the positive real axis, then\n\n$$\n\\alpha =arctan⁡(\\frac{6}{9})=arctan⁡(\\frac{2}{3})≈0.588\\,00.\n$$\n\nTherefore,\n\n$$\n\\theta =arg⁡(z)=2\\pi -0.588\\,00≈5.70\n$$\n\nto two decimal places."}] [{:db/id #edb/ref 17592186398638 :knowledge-point/_questions [{:db/id #edb/ref 17592186054751 :knowledge-point/id #uuid "ca7f6e86-a083-5dcd-beaa-8c3eae151bf1" :knowledge-point/title "Determining the Multiplicity of a Root of a Cubic Polynomial Using Grouping"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49f83912-5796-573a-b936-a61ffb603ff7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-5,\\,5" :db/id #edb/ref 17592186398640} {:answer/id #uuid "b6a7c8bb-09ff-5a0f-b690-cf0f292ac7ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=5" :db/id #edb/ref 17592186398641} {:answer/id #uuid "d012c549-4023-5194-9620-c38392bb0ca8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{5}" :db/id #edb/ref 17592186398642} {:answer/id #uuid "1ca07054-2359-5a47-9068-5f524310351e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{1}{5}" :db/id #edb/ref 17592186398643} {:answer/id #uuid "d7f9a8cc-12c2-5db4-9c8e-f8300024f0d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-5" :db/id #edb/ref 17592186398644}] :answer-field/correct {:answer/id #uuid "b6a7c8bb-09ff-5a0f-b690-cf0f292ac7ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=5" :db/id #edb/ref 17592186398641} :answer-field/id #uuid "7a80fbe4-dbfb-530c-af35-e0f30a4a5542" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398639}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d601c130-3a93-5630-8b35-93cbbfae4d1b" :question/math-academy-id "q-178256" :question/problem "Which root(s) of the polynomial $p(x)={x}^{3}-5{x}^{2}-25x+125$ have multiplicity $2?$" :question/worked-solution "First, we need to factor the polynomial. For this polynomial, we can factor by grouping:\n\n$$\n\\begin{aligned}p(x) & ={x}^{3}-5{x}^{2}-25x+125 \\\\  & ={x}^{2}(x-5)-25(x-5) \\\\  & =({x}^{2}-25)(x-5) \\\\  & =(x+5)(x-5)(x-5) \\\\  & =(x-5{)}^{2}(x+5)\\end{aligned}\n$$\n\nTo find the roots and their multiplicities, we look at the factors:\n\n- The factor $(x-5)$ has an exponent of $2$ in the factored form of $p(x).$ So the root $x=5$ has multiplicity $2.$\n\n- The factor $(x+5)$ has an exponent of $1$ in the factored form of $p(x).$ So the root $x=-5$ has multiplicity $1.$\n\nIn conclusion, only the root $x=5$ has multiplicity $2.$"}] [{:db/id #edb/ref 17592186284784 :knowledge-point/_questions [{:db/id #edb/ref 17592186083219 :knowledge-point/id #uuid "74677256-e307-5d49-b7e0-c3f4e79cf818" :knowledge-point/title "Calculating the Number of Ways That N Objects Can Be Arranged"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08737316-aa20-5df6-851c-dce808b637e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186281762} {:answer/id #uuid "18fd45dc-1ede-51cf-9585-369b367a8961" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186281914} {:answer/id #uuid "82a108e9-b949-5ec3-82d9-001193cc0c6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "95" :db/id #edb/ref 17592186282820} {:answer/id #uuid "b939e1e9-b6b5-5e42-8a94-194f830d95e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186283290} {:answer/id #uuid "ea97fa87-edd6-5cc7-984b-14ae7f4f6d7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "115" :db/id #edb/ref 17592186283739}] :answer-field/correct {:answer/id #uuid "b939e1e9-b6b5-5e42-8a94-194f830d95e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186283290} :answer-field/id #uuid "6814504a-adfe-5300-8bd4-6599a98f28d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284106}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "53fbad36-9779-558b-839c-131c419555eb" :question/math-academy-id "q-1804" :question/problem "Suppose that $5$ pictures are to be hung from left to right in a hallway. In how many possible ways can they be hung?" :question/worked-solution "There are $n=5$ pictures, so the number of possible arrangements is\n\n$$\n\\begin{aligned}5! & =5\\times 4\\times 3\\times 2\\times 1 \\\\  & =120.\\end{aligned}\n$$\n\nTherefore, there are $120$ ways of arranging the $5$ pictures."}] [{:db/id #edb/ref 17592186060174 :knowledge-point/_questions [{:db/id #edb/ref 17592186059865 :knowledge-point/id #uuid "f8e49a0c-9575-5bd0-af4e-6463495e56b3" :knowledge-point/title "Differentiating a Sum of Functions With Constant Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5446db9d-f32b-503a-98c3-71bd4b13a940" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{{x}^{3}}-\\frac{9{x}^{1/4}}{4}" :db/id #edb/ref 17592186285562} {:answer/id #uuid "72b849ec-c73e-51c6-8bd6-7d57955bf8d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{{x}^{3}}-\\frac{9}{4\\sqrt[3]{x}}" :db/id #edb/ref 17592186285843} {:answer/id #uuid "93d4bb13-717f-50aa-afa5-f6147b1c9f75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{{x}^{2}}-9{x}^{3}" :db/id #edb/ref 17592186286135} {:answer/id #uuid "a7da2020-89e3-5d5f-bbdb-6fb669e629c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{{x}^{3}}+\\frac{9{x}^{-1/4}}{4}" :db/id #edb/ref 17592186286320} {:answer/id #uuid "e9029ff2-9352-53d1-a4ea-86df802fa96d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{{x}^{3}}-\\frac{9}{4\\sqrt[4]{x}}" :db/id #edb/ref 17592186286919}] :answer-field/correct {:answer/id #uuid "e9029ff2-9352-53d1-a4ea-86df802fa96d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{{x}^{3}}-\\frac{9}{4\\sqrt[4]{x}}" :db/id #edb/ref 17592186286919} :answer-field/id #uuid "8320dfd3-7a24-5485-a9b9-30a0c49ac165" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287423}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "76292ca7-955e-5da2-801e-cf1602a2e16d" :question/math-academy-id "q-1856" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{2}{{x}^{2}}-3{x}^{3/4}.$" :question/worked-solution "Here, we apply the addition, constant multiple, and power rules:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{{x}^{2}}-3{x}^{3/4}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{-2})-\\frac{\\text{d}}{\\text{d}x}(3{x}^{3/4}) \\\\  & =2\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{-2})-3\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{3/4}) \\\\  & =2\\cdot (-2){x}^{(-2-1)}-3\\cdot \\frac{3}{4}{x}^{(3/4-1)} \\\\  & =-4{x}^{-3}-\\frac{9}{4}{x}^{-1/4} \\\\  & =-\\frac{4}{{x}^{3}}-\\frac{9}{4\\sqrt[4]{x}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186060177 :knowledge-point/_questions [{:db/id #edb/ref 17592186059670 :knowledge-point/id #uuid "e6eef35a-3502-5429-bd71-fb5bd0e8efc8" :knowledge-point/title "Identifying Extrema on Transformed Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "132ada2d-225c-55ef-ad34-507a30f3f6af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,-8)" :db/id #edb/ref 17592186284958} {:answer/id #uuid "874eb524-3ed8-5726-b354-81594d6ba038" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-4)" :db/id #edb/ref 17592186286028} {:answer/id #uuid "8da77226-b79f-5aa1-9fbb-eff1ddcce302" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,8)." :db/id #edb/ref 17592186286083} {:answer/id #uuid "de9a3fa5-07d3-5f60-9264-81029b284219" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-4)" :db/id #edb/ref 17592186286813} {:answer/id #uuid "e77beded-c213-529c-9af4-9172511b2a92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,8)." :db/id #edb/ref 17592186286904}] :answer-field/correct {:answer/id #uuid "132ada2d-225c-55ef-ad34-507a30f3f6af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,-8)" :db/id #edb/ref 17592186284958} :answer-field/id #uuid "e490dbf9-e5ff-5dfa-a559-074583566e32" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287616}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1c0bb866-f5d6-5c26-9148-409419fa5279" :question/math-academy-id "q-186866" :question/problem "![](images/f4/f4da78b7a12ed475b64c1f824e8cecdf36657c6d174f0db770219fd8dd6c0801.png)\n\nThe diagram above shows the global minimum and maximum of the function $y=f(x).$ What is the global minimum of $y=-2f(x+1)?$" :question/worked-solution "Notice that the graph of $y=-2f(x+1)$ can be obtained from the graph of $y=f(x)$ by \n\n- translating it by $1$ unit to the left, then\n\n- stretching it by a scale factor of $2$ parallel to the $y$-axis, and finally\n\n- flipping it across the $x$-axis.\n\nSince one of these transformations flips the graph across the $x$-axis, the combined transformation maps the global **maximum** of $y=f(x)$ to the global **minimum** of $y=-2f(x+1).$ So, we need to find the image of $(-1,4),$ the global maximum of $y=f(x),$ under the transformation. \n\nTo plot $y=-2f(x+1),$ we apply the following steps: \n\n- First, we take the graph $y=f(x)$ that passes through $(-1,4).$\n\n- Then, we shift the graph horizontally by $1$ unit to the left and get the graph of $y=f(x+1).$ After this transformation, the point $(-1,4)$ will be mapped to the point\n\n$$\n(-1-1,4)=(-2,4).\n$$\n\n- Next, we stretch the result by a scale factor of $2$ along the $y$-axis and get the graph of $y=2f(x+1).$ After this transformation, the point $(-2,4)$ will be mapped to the point\n\n$$\n(-2,2\\cdot 4)=(-2,8).\n$$\n\n- Finally, we flip the result vertically across the $x$-axis and get the graph of $y=-2f(x+1).$ After this transformation, the point $(-2,8)$ will be mapped to the point\n\n$$\n(-2,-1\\cdot 8)=(-2,-8).\n$$\n\nTherefore, the global minimum of $y=-2f(x+1)$ is $(-2,-8).$"}] [{:db/id #edb/ref 17592186292672 :knowledge-point/_questions [{:db/id #edb/ref 17592186059668 :knowledge-point/id #uuid "0bd940e7-fccc-5811-b07a-11e4843b1785" :knowledge-point/title "Finding a Point That Lies on a Transformed Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33c00c15-b13b-5bcc-8be2-21e93f4c417e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186290839} {:answer/id #uuid "487a2755-1c9b-50dc-a9ef-825d319c08d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-2)" :db/id #edb/ref 17592186290930} {:answer/id #uuid "5a5b7f1c-6ca6-519d-9324-afd97504caa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,2)" :db/id #edb/ref 17592186291021} {:answer/id #uuid "bfbeb462-5ad4-5751-9859-039c2c20e85a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-3)" :db/id #edb/ref 17592186291457} {:answer/id #uuid "f4debbbb-a978-5aa2-807b-d09d5e6771d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-3)" :db/id #edb/ref 17592186291662}] :answer-field/correct {:answer/id #uuid "33c00c15-b13b-5bcc-8be2-21e93f4c417e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186290839} :answer-field/id #uuid "337977c2-17f5-5416-91d9-a9bbf15f1e4e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291907}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6eb852b1-3670-5b7e-89d9-1b29c405f01a" :question/math-academy-id "q-26594" :question/problem "The point  $(3,1)$ lies on the curve $y=f(x).$ Which of the following points **must** lie on $y=-f(x)-1?$" :question/worked-solution "**Method 1**\n\nTo plot $y=-f(x)-1,$ we apply the following steps: \n\n- First, we take the graph $y=f(x).$\n\n- Then, we reflect the graph across the $x$-axis and get the graph of $y=-f(x).$ After this transformation, the point $(3,1)$ will be mapped to the point\n\n$$\n(3,-(1))=(3,-1).\n$$\n\n- Finally, we shift the result vertically by $1$ unit down and obtain the graph of $y=-f(x)-1.$ After this transformation, the point $(3,-1)$ will be mapped to the point\n\n$$\n(3,-1-1)=(3,-2).\n$$\n\n**Method 2**\n\nSince the point $(3,1)$ lies on the graph of $y=f(x)$, we have that $f(3)=1.$\n\nNow consider the graph of $y=-f(x)-1.$ Substituting $x=3$, we get\n\n$$\n\\begin{aligned}y & =-f(3)-1 \\\\  & =-(1)-1 \\\\  & =-1-1 \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, the point $(3,-2)$ must lie on $y=-f(x)-1.$"}] [{:db/id #edb/ref 17592186292673 :knowledge-point/_questions [{:db/id #edb/ref 17592186059669 :knowledge-point/id #uuid "38b450bd-b43a-507c-9bbe-0aaf7a64a3ed" :knowledge-point/title "Finding a Point That Lies on a Transformed Curve Given Another Transformed Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f5bb3ff-2bf2-59a6-a9dc-028e36b29e5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186290821} {:answer/id #uuid "6a0dffee-d291-5706-b099-bf26056b0a79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,4)" :db/id #edb/ref 17592186291085} {:answer/id #uuid "745f11b3-4abb-5778-b95c-05bfed92c9ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,2)" :db/id #edb/ref 17592186291130} {:answer/id #uuid "add1ba6b-56e1-507d-81c4-d7cc7dd66d71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186291387} {:answer/id #uuid "f811fc7c-86fc-528d-a6a8-cba9ceee139f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-2)" :db/id #edb/ref 17592186291677}] :answer-field/correct {:answer/id #uuid "add1ba6b-56e1-507d-81c4-d7cc7dd66d71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186291387} :answer-field/id #uuid "e46bb93d-f096-5e20-be4c-e4f183d28feb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292449}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4ee92c98-a45f-55db-8092-7db7c00e5a4e" :question/math-academy-id "q-26596" :question/problem "The point  $(3,2)$ lies on the curve $y=f(x)-2.$ Which of the following points **must** lie on $y=-f(x)+2?$" :question/worked-solution "**Method 1**\n\nWe first find a point corresponding to $(3,2)$ on $y=f(x).$ Then, we find a corresponding point on $y=-f(x)+2:$\n\n- To plot the graph of $y=f(x),$ we apply the following steps:\n\n- First, take the graph $y=f(x)-2.$\n\n- Then, we shift the graph vertically by $2$ units up and get the graph of $y=f(x).$ After this transformation, the point $(3,2)$ will be mapped to the point\n\n$$\n(3,2+2)=(3,4).\n$$\n\n- Next, to plot the graph of $y=-f(x)+2,$ we apply the following steps:\n\n- First, take the graph $y=f(x).$\n\n- Then, we reflect the result across the $x$-axis and get the graph of $y=-f(x).$ After this transformation, the point $(3,4)$ will be mapped  to the point\n\n$$\n(3,-(4))=(3,-4).\n$$\n\n- Next, we shift the result vertically by $2$ units up and obtain the graph of $y=-f(x)+2.$ After this transformation, the point $(3,-4)$ will be mapped to the point \n\n$$\n(3,-4+2)=(3,-2).\n$$\n\n**Method 2**\n\nSince the point $(3,2)$ lies on the graph of $y=f(x)-2$, we have that \n\n$$\nf(3)-2=2\\,⟹\\,f(3)=4.\n$$\n\nNow consider the graph of $y=-f(x)+2.$ Substituting $x=3$, we get\n\n$$\n\\begin{aligned}y & =-f(3)+2 \\\\  & =-4+2 \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, the point $(3,-2)$ must lie on $y=-f(x)+2.$"}] [{:db/id #edb/ref 17592186390514 :knowledge-point/_questions [{:db/id #edb/ref 17592186087821 :knowledge-point/id #uuid "dd63cb30-a236-546e-82ac-08bce09c88f7" :knowledge-point/title "Identifying a Vertically Shifted Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1db17739-2def-5e37-af22-164593bd5829" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/61/61cd6304483770e91658f37cd8ac3dbf57c58f25c9a631ab45a56cd706d381ee.png" :db/id #edb/ref 17592186390516} {:answer/id #uuid "9904a233-df69-591c-90af-01e22fb617bb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/31/31f0d95293939e141e0ebff2aaad6223a9a82188e892441906ae09c530919b1d.png" :db/id #edb/ref 17592186390517} {:answer/id #uuid "acd865cc-8ca0-5df0-b0c5-c2cd29210f44" :answer/type {:db/id #edb/ref 17592186