3 & -6\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186388458 :knowledge-point/_questions [{:db/id #edb/ref 17592186184329 :knowledge-point/id #uuid "a54dcd1d-56f5-527d-9f24-ff4b7d221d06" :knowledge-point/title "Calculating the Position Vector of a Particle Moving With Constant Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7fa049e-4b25-5fc5-a09a-9704fb67dd37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2i\\,\\text{km}" :db/id #edb/ref 17592186388460} {:answer/id #uuid "3ac4c593-47e1-5159-be74-f27d100fda00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2i+4j)\\,\\text{km}" :db/id #edb/ref 17592186388461} {:answer/id #uuid "bb9e5274-3b45-5edb-bd9b-22c73c49179e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(i-8j)\\,\\text{km}" :db/id #edb/ref 17592186388462} {:answer/id #uuid "cfebf470-6905-5030-a9f9-81bb9da7f5ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3i-4j)\\,\\text{km}" :db/id #edb/ref 17592186388463} {:answer/id #uuid "525a48f0-ca25-535e-849d-b1f62a4f7ab8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2j\\,\\text{km}" :db/id #edb/ref 17592186388464}] :answer-field/correct {:answer/id #uuid "cfebf470-6905-5030-a9f9-81bb9da7f5ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3i-4j)\\,\\text{km}" :db/id #edb/ref 17592186388463} :answer-field/id #uuid "dcb12218-53e5-5b77-b85e-bdd7e2c65d71" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388459}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "afe1f0be-e3c3-5ca8-ae7c-e8a7cf49172c" :question/math-academy-id "q-136375" :question/problem "A particle starts moving from the point with position vector $(i-4j)\\,\\text{km}$ with a constant velocity of $i\\,\\text{km/h}.$ Find the position vector of the particle after $2$ hours." :question/worked-solution "If a particle moves with constant velocity $u,$  the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut,\n$$\n\n \nwhere ${r}_{0}$ is the initial position of the particle.\n\nIn our case, we have\n\n$$\n{r}_{0}=i-4j,\\,u=i.\n$$\n\nTherefore, the position vector of the particle after $t=2\\,\\text{h}$ is\n\n$$\n\\begin{aligned}r & ={r}_{0}+ut \\\\  & =(i-4j)+i(2) \\\\  & =(i-4j)+2i \\\\  & =(3i-4j)\\,\\text{km}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186269117 :knowledge-point/_questions [{:db/id #edb/ref 17592186184330 :knowledge-point/id #uuid "da1d8490-fd41-5363-97d2-91b360f10723" :knowledge-point/title "Calculating the Position Vector of a Particle Moving With Constant Acceleration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69a5037c-5aad-53bf-873d-a3ad2cfc3736" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-7i-14j)\\,\\text{ft}" :db/id #edb/ref 17592186267079} {:answer/id #uuid "83f5852c-094a-5ca9-8fa9-ef1a49c93b8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7j\\,\\text{ft}" :db/id #edb/ref 17592186267306} {:answer/id #uuid "8e5053e5-c013-5dc1-938a-82668a475b96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5i-j)\\,\\text{ft}" :db/id #edb/ref 17592186267410} {:answer/id #uuid "aef42013-c05e-5a1d-8a4a-08f13bcc55dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(15i+5j)\\,\\text{ft}" :db/id #edb/ref 17592186267719} {:answer/id #uuid "b7ae6063-ca02-52c6-a4f7-e3d4932fa33a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14i\\,\\text{ft}" :db/id #edb/ref 17592186267790}] :answer-field/correct {:answer/id #uuid "b7ae6063-ca02-52c6-a4f7-e3d4932fa33a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14i\\,\\text{ft}" :db/id #edb/ref 17592186267790} :answer-field/id #uuid "3f76534e-f695-5dd6-abae-63a242daa2e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268510}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a7bf5c71-d863-573a-99bf-be4eff6cad18" :question/math-academy-id "q-136416" :question/problem "A particle starts moving from the point with position vector $-2j\\,\\text{ft}$ with an acceleration of $4i\\,{\\text{ft/min}}^{2}$ and an initial velocity of $(3i+j)\\,\\text{ft/min}.$ Find the position vector of the particle after $2$ minutes." :question/worked-solution "If a particle moves with constant acceleration $a,$ the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut+\\frac{1}{2}a{t}^{2},\n$$\n\n \n\nwhere ${r}_{0}$ is the initial position of the particle and $u$ is its initial velocity.\n\nIn our case, we have\n\n$$\n{r}_{0}=-2j,\\,u=3i+j,\\,a=4i.\n$$\n\nTherefore, the position vector of the particle after $t=2\\,\\text{min}$ is\n\n$$\n\\begin{aligned}r & =(-2j)+(3i+j)(2)+\\frac{1}{2}(4i)(2)^{2} \\\\  & =-2j+(6i+2j)+2(4i) \\\\  & =6i+8i \\\\  & =14i\\,\\text{ft}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186388472 :knowledge-point/_questions [{:db/id #edb/ref 17592186184331 :knowledge-point/id #uuid "3048320d-7346-53fd-819b-d6e32e4fc02c" :knowledge-point/title "Calculating the Distance Between a Particle and the Origin"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f569ac07-df0e-5527-9b3e-47d71e03dd46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{17}\\,\\text{m}" :db/id #edb/ref 17592186388474} {:answer/id #uuid "30feb053-b683-54f2-969d-deb8d00c6fc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{13}\\,\\text{m}" :db/id #edb/ref 17592186388475} {:answer/id #uuid "b87afdd3-db17-55b5-a378-00982528af4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,\\text{m}" :db/id #edb/ref 17592186388476} {:answer/id #uuid "0338b1eb-7f79-5542-be04-c6ed77e1d0ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}\\,\\text{m}" :db/id #edb/ref 17592186388477} {:answer/id #uuid "c9ab0d3b-d69c-5a75-8bac-7760afc6c24a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\,\\text{m}" :db/id #edb/ref 17592186388478}] :answer-field/correct {:answer/id #uuid "f569ac07-df0e-5527-9b3e-47d71e03dd46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{17}\\,\\text{m}" :db/id #edb/ref 17592186388474} :answer-field/id #uuid "26ef82b9-317e-5c14-a35e-1de7fcba946d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388473}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "889ae6c0-54a0-5d30-bfc5-d1d48e052f8c" :question/math-academy-id "q-136437" :question/problem "A particle starts moving from the point with position vector $(2i-4j)\\,\\text{m},$ with an acceleration of $(-i+j)\\,{\\text{m/min}}^{2}$ and an initial velocity of $(3i-j)\\,\\text{m/min}.$ Find the distance from the particle to the origin after $6$ minutes." :question/worked-solution "If a particle moves with constant acceleration $a,$ the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut+\\frac{1}{2}a{t}^{2},\n$$\n\n \n\nwhere ${r}_{0}$ is the initial position of the particle and $u$ is its initial velocity.\n\nIn our case, we have\n\n$$\n{r}_{0}=2i-4j,\\,u=3i-j,\\,a=-i+j.\n$$\n\nTherefore, the position vector of the particle after $t=6\\,\\text{min}$ is\n\n$$\n\\begin{aligned}r & =(2i-4j)+(3i-j)(6)+\\frac{1}{2}(-i+j)(6)^{2} \\\\  & =(2i-4j)+(18i-6j)+18(-i+j) \\\\  & =(20i-10j)+(-18i+18j) \\\\  & =(2i+8j)\\,\\text{m}.\\end{aligned}\n$$\n\nFinally, the distance from the particle to the origin at this time is\n\n$$\n\\begin{aligned}|r| & =|2i+8j| \\\\  & =\\sqrt{{2}^{2}+{8}^{2}} \\\\  & =\\sqrt{4+64} \\\\  & =\\sqrt{68} \\\\  & =2\\sqrt{17}\\,\\text{m}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186388486 :knowledge-point/_questions [{:db/id #edb/ref 17592186184331 :knowledge-point/id #uuid "3048320d-7346-53fd-819b-d6e32e4fc02c" :knowledge-point/title "Calculating the Distance Between a Particle and the Origin"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b03ef991-31b7-5c3c-8b28-cd001e42667a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,\\text{ft}" :db/id #edb/ref 17592186388488} {:answer/id #uuid "728e30d4-12eb-5617-b30e-b6e961dfe3ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{14}\\,\\text{ft}" :db/id #edb/ref 17592186388489} {:answer/id #uuid "2deb2ef1-fcdb-5251-b84f-3c5238a00b50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{6}\\,\\text{ft}" :db/id #edb/ref 17592186388490} {:answer/id #uuid "71dca4a6-e2e3-5a3d-8cf6-0a8416d002c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{12}\\,\\text{ft}" :db/id #edb/ref 17592186388491} {:answer/id #uuid "7883fae2-e5ce-5c5e-a580-bd2a84a787fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,\\text{ft}" :db/id #edb/ref 17592186388492}] :answer-field/correct {:answer/id #uuid "b03ef991-31b7-5c3c-8b28-cd001e42667a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,\\text{ft}" :db/id #edb/ref 17592186388488} :answer-field/id #uuid "c931c31d-4510-5111-b470-d3552788cdc7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388487}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "de2ee23a-84b8-57f6-8861-b47cf90097b3" :question/math-academy-id "q-136442" :question/problem "A particle moves from the origin with an acceleration of $(-2i+j)\\,{\\text{ft/s}}^{2}$ and an initial velocity of $(4i+j)\\,\\text{ft/s}.$ Find the distance from the particle to the origin after $4$ seconds." :question/worked-solution "If a particle moves with constant acceleration $a,$ the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut+\\frac{1}{2}a{t}^{2},\n$$\n\n \n\nwhere ${r}_{0}$ is the initial position of the particle and $u$ is its initial velocity.\n\nIn our case, we have\n\n$$\n{r}_{0}=0i+0j,\\,u=4i+j,\\,a=-2i+j.\n$$\n\nTherefore, the position vector of the particle after $t=4\\,\\text{s}$ is\n\n$$\n\\begin{aligned}r & =(0i+0j)+(4i+j)(4)+\\frac{1}{2}(-2i+j)(4)^{2} \\\\  & =(16i+4j)+8(-2i+j) \\\\  & =(16i+4j)+(-16i+8j) \\\\  & =12j\\,\\text{ft}.\\end{aligned}\n$$\n\nFinally, the distance from the particle to the origin at this time is\n\n$$\n\\begin{aligned}|r| & =|12j| \\\\  & =|12| \\\\  & =12\\,\\text{ft}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186176347 :knowledge-point/_questions [{:db/id #edb/ref 17592186176058 :knowledge-point/id #uuid "66a1733a-d7bb-5c86-a154-9e54422053a7" :knowledge-point/title "Utilizing the Oddness Property of the Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19df7d47-b87b-5e46-8360-7533c525ec2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186266358} {:answer/id #uuid "3c2908b8-2ead-5a77-be9f-804bc07bb7fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186266672} {:answer/id #uuid "6ccc1b1b-9a04-5bb8-a591-9f5cc4c7efc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186267102} {:answer/id #uuid "8b14d04b-7661-55d9-a6d2-74ec1e93a05a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186267392} {:answer/id #uuid "a5bfc5ef-972c-5d0d-9011-6abdfdf11b45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186267642}] :answer-field/correct {:answer/id #uuid "19df7d47-b87b-5e46-8360-7533c525ec2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186266358} :answer-field/id #uuid "a6737d96-a059-592e-9cfb-df4b5f79acd2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268703}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ccd7ae50-1c4e-5bcc-8b8b-d405f5154f0b" :question/math-academy-id "q-136548" :question/problem "If $tan⁡a=-2,$ then $tan⁡(-a)=$" :question/worked-solution "First, let's recall the graph of $y=tan⁡x.$\n\n![](images/df/df1aba3f5ff980de82a74dde8170ad708e379caf2188873bcddc83177e87c7a6.png)\n\nOur graph has rotational symmetry of order $2$ about the origin. If we rotate the graph ${180}^{∘}$ around the origin, we get the same picture. This means that $tan⁡x$ is an *odd* function, and we have\n\n$$\ntan⁡(-x)=-tan⁡x.\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}tan⁡(-a) & =-tan⁡a \\\\  & =-(-2) \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186269128 :knowledge-point/_questions [{:db/id #edb/ref 17592186176059 :knowledge-point/id #uuid "d4b378b0-30e5-59a8-b9f7-882b5e226a2e" :knowledge-point/title "Utilizing the Evenness Property of the Secant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04ba9a98-d418-5054-94e5-129c6b76bfac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186266186} {:answer/id #uuid "19edb75b-03b9-59e8-bc8e-e9f768d59cb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186266360} {:answer/id #uuid "5e2ed2c4-f432-5dc5-84ad-45be5e6c0e95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186266975} {:answer/id #uuid "5e32262d-72d6-5e5a-894e-153eb250705f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{12}" :db/id #edb/ref 17592186266977} {:answer/id #uuid "f0b9b848-8717-52db-b148-c872c7061d08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186268284}] :answer-field/correct {:answer/id #uuid "04ba9a98-d418-5054-94e5-129c6b76bfac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186266186} :answer-field/id #uuid "aa7bd887-2e1e-5f25-8630-dbf79ed567a6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268713}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b8cc1f5d-680d-525d-9686-5ade22a43012" :question/math-academy-id "q-136627" :question/problem "If $sec⁡a=-12,$ then $sec⁡(-a)=$" :question/worked-solution "First, let's recall the graph of $y=sec⁡x.$\n\n![](images/fb/fbf6ef1ca91f998ab4dc2dda1890ffc8a713f2eeff19e5569351b2466256d63a.png)\n\nNotice that our graph is symmetric about the $y$-axis. If we reflect the graph about the $y$-axis, we get the same picture. This means that $sec⁡x$ is an *even* function, and we have\n\n$$\nsec⁡(-x)=sec⁡x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}sec⁡(-a) & =sec⁡a \\\\  & =-12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186269129 :knowledge-point/_questions [{:db/id #edb/ref 17592186176057 :knowledge-point/id #uuid "94645507-186a-54a7-a96b-ccfb0fb1f769" :knowledge-point/title "Utilizing the Evenness Property of the Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a49b518-1242-5538-88d2-11c15ad409a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{10}" :db/id #edb/ref 17592186266511} {:answer/id #uuid "47bd735c-d78a-5fa1-af23-606d585fec22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{10}" :db/id #edb/ref 17592186266785} {:answer/id #uuid "d7848761-d53a-5319-b2fc-3092efadcb6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186268060} {:answer/id #uuid "f7519539-e4d9-5d01-ab39-32fa53d98166" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{10}" :db/id #edb/ref 17592186268336} {:answer/id #uuid "fb6c5ae7-fa41-560e-9dd3-471731162c02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{91}}{10}" :db/id #edb/ref 17592186268367}] :answer-field/correct {:answer/id #uuid "f7519539-e4d9-5d01-ab39-32fa53d98166" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{10}" :db/id #edb/ref 17592186268336} :answer-field/id #uuid "8efb648d-3ab0-5adb-a826-86d01fca5115" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268658}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4dcab682-c7ea-5000-bb2e-9cbc57f39eb0" :question/math-academy-id "q-136629" :question/problem "If $cos⁡x=-\\frac{3}{10},$ then $cos⁡(-x)=$" :question/worked-solution "First, let's recall the graph of $y=cos⁡x.$\n\n![](images/23/2373daf4b5fd26f098bf90e998e2685db6a8b793e94ac9d80b08ea423cb535c0.png)\n\nNotice that our graph is symmetric about the $y$-axis. If we reflect the graph over the $y$-axis, we get the same picture. This means that $cos⁡x$ is an *even* function, and we have\n\n$$\ncos⁡(-x)=cos⁡x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}cos⁡(-x) & =cos⁡x \\\\  & =-\\frac{3}{10}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186269131 :knowledge-point/_questions [{:db/id #edb/ref 17592186176059 :knowledge-point/id #uuid "d4b378b0-30e5-59a8-b9f7-882b5e226a2e" :knowledge-point/title "Utilizing the Evenness Property of the Secant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "038a1bc6-e647-59b6-aaa7-d35e90993bc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{8}" :db/id #edb/ref 17592186266176} {:answer/id #uuid "1d7c73d5-90cc-5170-965c-525cdbc8308d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186266399} {:answer/id #uuid "3a3b8949-b671-5cf2-bbef-476092a89eb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186266656} {:answer/id #uuid "bdb40afd-ce8b-5929-b1b9-111a96d60fa4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186267848} {:answer/id #uuid "f750f91c-c511-5f89-913b-c6b563802807" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186268335}] :answer-field/correct {:answer/id #uuid "f750f91c-c511-5f89-913b-c6b563802807" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186268335} :answer-field/id #uuid "e0