{:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ef/ef920634ab0391c8b13566e8575ee66839bcaf38dd6e4d87bfa336035ab10166.png" :db/id #edb/ref 17592186388317} {:answer/id #uuid "66b02031-af4a-5dc1-ac7f-ed1163e286f3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b7/b741264e080009d9e634e7ffce5e9041b6cd65b34e4d840700397a7378255ea8.png" :db/id #edb/ref 17592186388318} {:answer/id #uuid "448502eb-fb15-5ab2-9d96-04aeaf2da0b1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8e/8ea63450225d8b50e6f00e012afcd3afe8215eb573ed3a31ce9aa57c30ec8132.png" :db/id #edb/ref 17592186388319} {:answer/id #uuid "8388f37e-7b04-57a4-a21b-751817dec11b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/81/81364754556cfeed2c4a2b74d2c745c054491e7f0a9e1d2512fffe6dc4569e5d.png" :db/id #edb/ref 17592186388320}] :answer-field/correct {:answer/id #uuid "66b02031-af4a-5dc1-ac7f-ed1163e286f3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b7/b741264e080009d9e634e7ffce5e9041b6cd65b34e4d840700397a7378255ea8.png" :db/id #edb/ref 17592186388318} :answer-field/id #uuid "da2b298a-e144-5d4b-ab37-e427ce14674c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388315}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "711b7d57-8e73-5262-a6cb-c7a387e51978" :question/math-academy-id "q-133969" :question/problem "Lucy, who plays basketball, notices that the number of points she scores in a game increases as a function of the number of hours she practices her jump shot each week. She records the following data.\n\n| **Number of Hours Training** | **$4$** | **$6$** | **$7$** | **$8$** | **$10$** |\n| --- | --- | --- | --- | --- | --- |\n| **Points Scored per Game** | $8$ | $12$ | $16$ | $20$ | $28$ |\n\nWhich of the following scatter plots represents this data?" :question/worked-solution "We create a scatter diagram in the coordinate plane as follows:\n\n- First, we draw the independent variable (number of hours training) along the horizontal axis.\n\n- Then, we draw the dependent variable (points scored per game) along the vertical axis.\n\n- Finally, we plot the points that correspond to the pairs from the data.\n\nThis gives us the following scatter plot.\n\n![](images/b7/b741264e080009d9e634e7ffce5e9041b6cd65b34e4d840700397a7378255ea8.png)"}] [{:db/id #edb/ref 17592186176329 :knowledge-point/_questions [{:db/id #edb/ref 17592186176031 :knowledge-point/id #uuid "534de76f-d4bc-55b5-858e-2b594f63b7bc" :knowledge-point/title "Calculating Distance Given Speed and Time"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00100cbe-fb7e-5a60-bebf-70ac5833c23b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$145$ miles" :db/id #edb/ref 17592186266151} {:answer/id #uuid "39cf88bf-156e-548d-929c-87b676eb8d65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$165$ miles" :db/id #edb/ref 17592186266654} {:answer/id #uuid "63e7bb25-145e-5483-bd59-9ec85466a225" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$185$ miles" :db/id #edb/ref 17592186267023} {:answer/id #uuid "6fa4073d-79a4-50e5-bcf9-c804d6b75650" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$21.3$ miles" :db/id #edb/ref 17592186267124} {:answer/id #uuid "cde549c5-0f81-5026-93bf-a2769df847df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$18.3$ miles" :db/id #edb/ref 17592186267983}] :answer-field/correct {:answer/id #uuid "39cf88bf-156e-548d-929c-87b676eb8d65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$165$ miles" :db/id #edb/ref 17592186266654} :answer-field/id #uuid "bef8f0e7-5010-5fd0-8979-0100c812c7ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268746}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6a0c4502-fd0b-5e9b-b54c-913ee6f1d90c" :question/math-academy-id "q-133998" :question/problem "A car traveled for $3$ hours at a constant speed of $55$ miles per hour. Find the distance covered by the car." :question/worked-solution "The speed is $55$ miles per hour. To find the distance covered in $3$ hours, we multiply the speed by $3.$ This gives\n\n$$\n\\begin{aligned}\\text{distance} & =\\text{speed}\\cdot \\text{time} \\\\  & =55\\times 3 \\\\  & =165.\\end{aligned}\n$$\n\nTherefore, the car covered $165$ miles in $3$ hours."}] [{:db/id #edb/ref 17592186268944 :knowledge-point/_questions [{:db/id #edb/ref 17592186152236 :knowledge-point/id #uuid "327d9a77-b2dd-57b1-b959-570684714bf9" :knowledge-point/title "Identifying the Trendline of a Given Scatter Plot"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "033cb659-414d-5787-a9bc-eb2bf16dbd44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s" :db/id #edb/ref 17592186266172} {:answer/id #uuid "49ed65a6-6e4a-51fe-b7ce-0c318fdf7c3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There is no linear trend in the data" :db/id #edb/ref 17592186266799} {:answer/id #uuid "4c7ebdbd-2438-570b-9a84-211c2b18c807" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q" :db/id #edb/ref 17592186266819} {:answer/id #uuid "6e4796e2-4fe4-50ac-8634-04a9e6ab6537" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r" :db/id #edb/ref 17592186267109} {:answer/id #uuid "c706c232-ee64-