#{[{:db/id #edb/ref 17592186253469 :knowledge-point/_questions [{:db/id #edb/ref 17592186096695 :knowledge-point/id #uuid "29e2083d-fe76-5a35-9c3a-7e6ad19ff968" :knowledge-point/title "Determining the Equation of a Parabola With Non-Origin Vertex Passing Through a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06cec48d-e68e-5bcc-8270-08fe2e886d9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+5)^{2}=y-3" :db/id #edb/ref 17592186250608} {:answer/id #uuid "8e6cc6fa-f362-599f-ade6-ae329e081e03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-3)^{2}=2(y+5)" :db/id #edb/ref 17592186251760} {:answer/id #uuid "bb75a7c2-9da9-57cf-a080-80bcbe9c27dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-3)^{2}=-2(y+5)" :db/id #edb/ref 17592186252202} {:answer/id #uuid "c9b6a622-8399-502c-875d-4a9c8d81675b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-3)^{2}=-(y+5)" :db/id #edb/ref 17592186252339} {:answer/id #uuid "d07899d6-980a-597d-8721-0d4dbbcd9959" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-3)^{2}=y+5" :db/id #edb/ref 17592186252396}] :answer-field/correct {:answer/id #uuid "d07899d6-980a-597d-8721-0d4dbbcd9959" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-3)^{2}=y+5" :db/id #edb/ref 17592186252396} :answer-field/id #uuid "9cb337ec-659a-584a-b940-40e7dd1bcc66" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253081}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a291d23e-d654-581b-aa5a-090e3a807669" :question/math-academy-id "q-11827" :question/problem "Find the equation of the upward-opening parabola that has its vertex at $(3,-5)$ and which passes through the point $(0,4).$" :question/worked-solution "For any upward or downward-opening parabola with its vertex at $(h,k),$ the general standard equation is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nHere, the vertex has coordinates $(h,k)=(3,-5).$ Substituting these into the general standard equation, we get\n\n$$\n\\begin{aligned}(x-3)^{2} & =4p(y-(-5)) \\\\ (x-3)^{2} & =4p(y+5).\\end{aligned}\n$$\n\nWe are left to find the value of $p.$ We know that the given parabola also passes through the point $(0,4),$ so we can substitute $x=0$ and $y=4$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}(x-3)^{2} & =4p(y+5) \\\\ (0-3)^{2} & =4p(4+5) \\\\ 9 & =36p \\\\ p & =\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}(x-3)^{2} & =4p(y+5) \\\\ (x-3)^{2} & =4(\\frac{1}{4})(y+5) \\\\ (x-3)^{2} & =y+5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253471 :knowledge-point/_questions [{:db/id #edb/ref 17592186096695 :knowledge-point/id #uuid "29e2083d-fe76-5a35-9c3a-7e6ad19ff968" :knowledge-point/title "Determining the Equation of a Parabola With Non-Origin Vertex Passing Through a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0204d1a4-979b-5e5a-91e8-16da198d96f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+1)^{2}=-7(y+1)" :db/id #edb/ref 17592186250572} {:answer/id #uuid "03bd375b-9e1f-597d-b5e9-e0b4bc54bc30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-1)^{2}=7(y-1)" :db/id #edb/ref 17592186250582} {:answer/id #uuid "12e32eca-626a-5a03-9f08-308e2110d81a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-1)^{2}=-3(y-1)" :db/id #edb/ref 17592186250714} {:answer/id #uuid "7de8efb9-9a5f-5339-a2b1-15a8967978ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-1)^{2}=-7(y-1)" :db/id #edb/ref 17592186251610} {:answer/id #uuid "efdf1fa1-0772-50d6-9d54-6cbe5ab65088" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-1)^{2}=3(y-1)" :db/id #edb/ref 17592186252652}] :answer-field/correct {:answer/id #uuid "7de8efb9-9a5f-5339-a2b1-15a8967978ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-1)^{2}=-7(y-1)" :db/id #edb/ref 17592186251610} :answer-field/id #uuid "8ee73095-9b6e-56be-abd4-9d4c75590945" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253052}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6128a71e-f744-5ae8-9df3-81f671cec4ad" :question/math-academy-id "q-11833" :question/problem "Find the equation of the downward-opening parabola that has its vertex at $(1,1)$ and which passes through the point $(-6,-6).$" :question/worked-solution "For any upward or downward-opening parabola with its vertex at $(h,k),$ the general standard equation is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nHere, the vertex has coordinates $(h,k)=(1,1).$ Substituting these into the general standard equation, we get\n\n$$\n\\begin{aligned}(x-1)^{2} & =4p(y-1).\\end{aligned}\n$$\n\nWe are left to find the value of $p.$ We know that the given parabola also passes through the point $(-6,-6),$ so we can substitute $x=-6$ and $y=-6$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}(x-1)^{2} & =4p(y-1) \\\\ (-6-1)^{2} & =4p(-6-1) \\\\ 49 & =-28p \\\\ p & =-\\frac{7}{4}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}(x-1)^{2} & =4p(y-1) \\\\ (x-1)^{2} & =4(-\\frac{7}{4})(y-1) \\\\ (x-1)^{2} & =-7(y-1).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253473 :knowledge-point/_questions [{:db/id #edb/ref 17592186096694 :knowledge-point/id #uuid "a991a3b1-6de7-5978-9dd6-cb9eb3f183a6" :knowledge-point/title "Determining the Equation of a Parabola With Non-Origin Vertex Given its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a2abbd7-97f8-5e38-941b-3ada6db5798c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+4)^{2}=\\frac{16}{3}(y-6)" :db/id #edb/ref 17592186251035} {:answer/id #uuid "8787dc86-a84a-5867-8afa-8d199ba176b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+4)^{2}=-\\frac{8}{3}(y-6)" :db/id #edb/ref 17592186251694} {:answer/id #uuid "b0735a9e-9190-50e7-a39d-2d9c6954469a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+4)^{2}=-\\frac{16}{3}(y-6)" :db/id #edb/ref 17592186252095} {:answer/id #uuid "bbc062ed-3073-5920-bc31-ce60d55001a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-6)^{2}=-\\frac{16}{3}(y+4)" :db/id #edb/ref 17592186252207} {:answer/id #uuid "c2ea3214-bf6f-5b3f-a080-c4a79666da78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+4)^{2}=\\frac{8}{3}(y-6)" :db/id #edb/ref 17592186252276}] :answer-field/correct {:answer/id #uuid "b0735a9e-9190-50e7-a39d-2d9c6954469a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+4)^{2}=-\\frac{16}{3}(y-6)" :db/id #edb/ref 17592186252095} :answer-field/id #uuid "2d36355d-1e8b-5128-984f-3296bcb5a4b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252883}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f807a98f-968e-51ff-a643-2a1ff4add6c7" :question/math-academy-id "q-11835" :question/problem "![](images/28/2819ceb4214f8df19ef349794c243771a1080bccf0bf2bbdbdbca9be67d4fbdb.png)\n\nWhat is the equation of the parabola shown above?" :question/worked-solution "We know that for any upward or downward-opening parabola with its vertex at $(h,k),$ the general standard equation is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nHere, the vertex has coordinates $(h,k)=(-4,6).$ Substituting these into the general standard equation, we get\n\n$$\n(x+4)^{2}=4p(y-6).\n$$\n\nWe are left to find the value of $p.$ We know that the given parabola also passes through the point $(4,-6),$ so we can substitute $x=4$ and $y=-6$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}(x+4)^{2} & =4p(y-6) \\\\ (4+4)^{2} & =4p(-6-6) \\\\ 64 & =-48p \\\\ p & =-\\frac{4}{3}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}(x+4)^{2} & =4p(y-6) \\\\ (x+4)^{2} & =4(-\\frac{4}{3})(y-6) \\\\ (x+4)^{2} & =-\\frac{16}{3}(y-6).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253474 :knowledge-point/_questions [{:db/id #edb/ref 17592186059763 :knowledge-point/id #uuid "64edd709-3f6c-59e1-ae1f-bca25eca0483" :knowledge-point/title "Identifying the Reflection of a Sine Curve Over the Horizontal Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4755537d-9558-58e3-b1fb-e15adf27ad35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-sin⁡(x-\\frac{1}{4})" :db/id #edb/ref 17592186251146} {:answer/id #uuid "4f6bddc5-a5cd-5875-abbb-9f22efb60464" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-sin⁡(\\frac{x}{4})" :db/id #edb/ref 17592186251203} {:answer/id #uuid "6b736f08-32b3-5af6-a82e-5816f1c230a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{4}-sin⁡x" :db/id #edb/ref 17592186251431} {:answer/id #uuid "790ade44-b249-5c2c-8b0f-5e62399db5ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{4}sin⁡x" :db/id #edb/ref 17592186251558} {:answer/id #uuid "cdec9314-5fd3-5b0f-8a26-a6c75f8c9e96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-sin⁡x-\\frac{1}{4}" :db/id #edb/ref 17592186252370}] :answer-field/correct {:answer/id #uuid "790ade44-b249-5c2c-8b0f-5e62399db5ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{4}sin⁡x" :db/id #edb/ref 17592186251558} :answer-field/id #uuid "5268f851-1f31-5f10-a461-a1a9a49c25a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252950}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c5a416a1-a537-5d81-9140-46bc32e0a299" :question/math-academy-id "q-118350" :question/problem "![](images/a0/a065146d50b16eade39c758b59e13994272cf7180aaa662008a1865e4160421e.png)\n\nWhat is the equation of the graph shown above?" :question/worked-solution "![](images/46/46e8f92e758c7f4643b64c05d0b457f7b99b6723ddf9be9cd63da28079b89618.png)\n\nTo plot the given curve, we follow these steps:\n\n- Start with the graph of $y=sin⁡x.$\n\n- Then, reflect it in the $x$-axis to give $y=-sin⁡x.$\n\n- Finally, compress it parallel to the $y$-axis by a stretch factor of $\\frac{1}{4}$ to give $y=-\\frac{1}{4}sin⁡x.$\n\nTherefore, the given curve is the graph of $y=-\\frac{1}{4}sin⁡x.$"}] [{:db/id #edb/ref 17592186399982 :knowledge-point/_questions [{:db/id #edb/ref 17592186198246 :knowledge-point/id #uuid "38bfb48e-9b66-58a8-966a-fb6938e08073" :knowledge-point/title "Finding an Equation That Determines a Minimum Distance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87a1b81f-6a01-51e3-8077-b35d6d3c965e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{{x}^{2}}" :db/id #edb/ref 17592186399984} {:answer/id #uuid "121d4c99-f9fd-560e-b8d1-8cf12f76ef01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186399985} {:answer/id #uuid "37c5a8a6-835d-5948-a4e4-bc4371e503af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{x}" :db/id #edb/ref 17592186399986} {:answer/id #uuid "ed218258-9b28-520e-b77f-948add6059b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2x}" :db/id #edb/ref 17592186399987} {:answer/id #uuid "1a5f6dc5-0cb2-55ae-b3d1-11c8ecd253e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{{x}^{3}}" :db/id #edb/ref 17592186399988}] :answer-field/correct {:answer/id #uuid "121d4c99-f9fd-560e-b8d1-8cf12f76ef01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186399985} :answer-field/id #uuid "e83f0ff3-bc35-5721-8d0b-7a1f7fc531ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399983}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f0024a60-f6e5-5b56-9272-60dda6ebe058" :question/math-academy-id "q-118389" :question/problem "![](images/37/37434a61262f829160fc2b19fcadb67745a024d589cd1ce318ca4ab90d6ab2d9.png)\n\nThe $x$-coordinate of the point $P$ on the curve $y=\\frac{x+1}{\\sqrt{x}}$ that is closest to the point $(2,0)$ satisfies the equation\n\n$$\n2x-3-\\bbox[3pt,border:1pt solid black]{\\phantom{AAAAAA}}=0.\n$$\n\n \nWhat is the missing expression?" :question/worked-solution "Let's consider the *squared* distance $S$ between $(2,0)$ and a general point $P(x,y):$ \n\n$$\n\\begin{aligned}S(x,y) & =(x-2)^{2}+(y-0)^{2} \\\\  & ={x}^{2}-4x+4+{y}^{2}\\end{aligned}\n$$\n\nWe require that the point $P$ lies on the curve $y=\\frac{x+1}{\\sqrt{x}}.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S & ={x}^{2}-4x+4+{y}^{2} \\\\  & ={x}^{2}-4x+4+{(\\frac{x+1}{\\sqrt{x}})}^{2} \\\\  & ={x}^{2}-4x+4+\\frac{(x+1)^{2}}{x} \\\\  & ={x}^{2}-4x+4+\\frac{{x}^{2}+2x+1}{x} \\\\  & ={x}^{2}-4x+4+x+2+\\frac{1}{x} \\\\  & ={x}^{2}-3x+\\frac{1}{x}+6.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=2x-3-\\frac{1}{{x}^{2}} & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186398186 :knowledge-point/_questions [{:db/id #edb/ref 17592186059764 :knowledge-point/id #uuid "85090bdf-4f1b-5f79-a751-48521ad98895" :knowledge-point/title "Identifying the Reflection of a Sine or Cosine Curve Over the Vertical Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bddbf7dd-8781-50a4-b250-66fd8e233371" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{5}sin⁡(-x)" :db/id #edb/ref 17592186398188} {:answer/id #uuid "7f35edde-ed58-55bc-8274-99043f11903d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=sin⁡(-x)-5" :db/id #edb/ref 17592186398189} {:answer/id #uuid "e98140d9-64d1-5b2b-87eb-6cb37aace0e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=sin⁡(-\\frac{x}{5})" :db/id #edb/ref 17592186398190} {:answer/id #uuid "1866cc81-a61e-52b4-828e-7f095d95514b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=sin⁡(-5x)" :db/id #edb/ref 17592186398191} {:answer/id #uuid "76a9807d-df1a-5832-b429-0890d06c222f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5sin⁡(-x)" :db/id #edb/ref 17592186398192}] :answer-field/correct {:answer/id #uuid "76a9807d-df1a-5832-b429-0890d06c222f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5sin⁡(-x)" :db/id #edb/ref 17592186398192} :answer-field/id #uuid "0aeaedd6-8135-5962-8437-2a69c460095e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398187}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e694bf71-afc9-51ff-82ce-ddde47237115" :question/math-academy-id "q-118442" :question/problem "![](images/99/997eb5cc08dcff78cb32f5b47b5d066546854b05f3b066953772e456e713d773.png)\n\nWhich of the following equations could be used to describe the graph shown above?" :question/worked-solution "![](images/1e/1e532c806d81c3c4015d78f814dc4ea3fc3483f22d34ade385894df2e8e7e3c5.png)\n\nTo plot the given curve, we follow these steps:\n\n- Start with the graph of $y=sin⁡x.$\n\n- Then, reflect it across the $y$-axis.\n\n- Finally, stretch it parallel to the $y$-axis by a stretch factor of $5.$\n\nTherefore, the given curve is the graph of $y=5sin⁡(-x).$\n\nNotice that, because the sine function is odd, the $y$-axis reflection has the same effect as the $x$-axis reflection, i.e.,\n\n$$\n5sin⁡(-x)=-5sin⁡x.\n$$\n\nSo the graph could also be viewed as $y=-5sin⁡x.$ However, $y=-5sin⁡x$ is not among the given options."}] [{:db/id #edb/ref 17592186398193 :knowledge-point/_questions [{:db/id #edb/ref 17592186059764 :knowledge-point/id #uuid "85090bdf-4f1b-5f79-a751-48521ad98895" :knowledge-point/title "Identifying the Reflection of a Sine or Cosine Curve Over the Vertical Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62375a92-edd9-5873-9edf-ef0ddd9dccaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=6sin⁡(-x)" :db/id #edb/ref 17592186398195} {:answer/id #uuid "1f1a872d-3b88-5a7f-8b75-ab249c2d63b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=sin⁡(-x)+6" :db/id #edb/ref 17592186398196} {:answer/id #uuid "839a4786-7b8b-587f-884b-34a3e1fb530a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=sin⁡(-\\frac{x}{6})" :db/id #edb/ref 17592186398197} {:answer/id #uuid "fbef0156-6d81-5b0b-80b2-e4c086df567d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{6}sin⁡(-x)" :db/id #edb/ref 17592186398198} {:answer/id #uuid "ab0aa795-c7d5-534e-922f-0ead75cd6cdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=sin⁡(-6x)" :db/id #edb/ref 17592186398199}] :answer-field/correct {:answer/id #uuid "62375a92-edd9-5873-9edf-ef0ddd9dccaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=6sin⁡(-x)" :db/id #edb/ref 17592186398195} :answer-field/id #uuid "1f0f56dd-8c86-5cbb-8889-d10079bd9452" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398194}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ef71e5dd-2133-5139-bcc4-313a9e867ac5" :question/math-academy-id "q-118443" :question/problem "![](images/f0/f012ee5880b4ec6c4c2cad4aa44da672b789f21c7f9969dcec50a25596e47c4b.png)\n\nWhich of the following equations could be used to describe the graph shown above?" :question/worked-solution "![](images/bc/bc61bf27fb210e0dc849829d5c287936fcb3f73bc279e98af8a64ba4085b8309.png)\n\nTo plot the given curve, we follow these steps:\n\n- Start with the graph of $y=sin⁡x.$\n\n- Then, reflect it across the $y$-axis.\n\n- Finally, stretch it parallel to the $y$-axis by a stretch factor of $6.$\n\nTherefore, the given curve is the graph of $y=6sin⁡(-x).$\n\nNotice that, because the sine function is odd, the $y$-axis reflection has the same effect as the $x$-axis reflection, i.e.,\n\n$$\n6sin⁡(-x)=-6sin⁡x.\n$$\n\nSo the graph could also be viewed as $y=-6sin⁡x.$ However, $y=-6sin⁡x$ is not among the given options."}] [{:db/id #edb/ref 17592186253480 :knowledge-point/_questions [{:db/id #edb/ref 17592186059765 :knowledge-point/id #uuid "1fe335eb-dc4a-5ea0-83cf-ad929e19b908" :knowledge-point/title "Identifying the Reflection and Shifting of a Sine or Cosine Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31777cec-aa4a-531c-8f91-1af7a0f66a13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-cos⁡x" :db/id #edb/ref 17592186250973} {:answer/id #uuid "3c737870-c937-5be1-9306-cc57cf97a411" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-sin⁡x-1" :db/id #edb/ref 17592186251056} {:answer/id #uuid "4c303ce3-dff7-58a3-b70c-6bed684870f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-cos⁡x-1" :db/id #edb/ref 17592186251183} {:answer/id #uuid "b4c0f728-a1b5-55fd-890b-dbd31577858c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=sin⁡(1-x)" :db/id #edb/ref 17592186252145} {:answer/id #uuid "e3100428-23e3-5316-a71c-cc8576b92026" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-sin⁡(1-x)" :db/id #edb/ref 17592186252551}] :answer-field/correct {:answer/id #uuid "3c737870-c937-5be1-9306-cc57cf97a411" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-sin⁡x-1" :db/id #edb/ref 17592186251056} :answer-field/id #uuid "011a22c2-f8f2-5ad2-9c5f-c7e5ef1ebd65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252807}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e1484f94-afd5-5ba7-9351-7b1e33dca84c" :question/math-academy-id "q-118450" :question/problem "![](images/98/98e3dc2a664f5096d2b7c9ba7bf7fc56faa189cd573a3de462e0b249fbc90af6.png)\n\nIdentify the equation that generated the graph above." :question/worked-solution "![](images/84/8499856915baa0bf144561dd35143e024586f4d417ac4f9c1ee48d7586e0f26c.png)\n\nTo plot the given curve, we follow these steps:\n\n- Start with the graph of $y=sin⁡x.$\n\n- Then, reflect it in the $x$-axis to give $y=-sin⁡x.$\n\n- Finally, translate it by $1$ unit **down** to give $y=-sin⁡x-1.$\n\nTherefore, the given curve is the graph of $y=-sin⁡x-1.$"}] [{:db/id #edb/ref 17592186253482 :knowledge-point/_questions [{:db/id #edb/ref 17592186096711 :knowledge-point/id #uuid "61861939-69d4-5b1e-a0f0-6a1b383b775b" :knowledge-point/title "Identifying the Vertex of a Horizontal Parabola Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ed39256-683e-5ef6-a893-2ffd1ac7cfd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,0)" :db/id #edb/ref 17592186250952} {:answer/id #uuid "3bcffef7-c4e0-5618-a54c-3d0b1bd5feba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,2)" :db/id #edb/ref 17592186251053} {:answer/id #uuid "5a24d0d7-0cee-5b3c-8d59-814969cbbcad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186251294} {:answer/id #uuid "b9016ea9-a887-53a4-97d6-743534d4d445" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,0)" :db/id #edb/ref 17592186252181} {:answer/id #uuid "e8a06d70-c6d7-5b07-b5fa-a43959fc8051" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,1)" :db/id #edb/ref 17592186252588}] :answer-field/correct {:answer/id #uuid "b9016ea9-a887-53a4-97d6-743534d4d445" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,0)" :db/id #edb/ref 17592186252181} :answer-field/id #uuid "736e577a-1579-5c66-a73e-dca1bc5214d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253011}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "054b33c1-48d0-5971-9cd6-626efbf760f9" :question/math-academy-id "q-11854" :question/problem "![](images/af/af896b84fd035bc81e97ab6214858ec7627c12b7b9ff25f18483839f4e389ba7.png)\n\nWhat is the vertex of the parabola shown above?" :question/worked-solution "The vertex of a left-opening parabola is the right-most point of the parabola.\n\n![](images/54/5410d736f7bae2f5c968d52083745b91279913045405ad75d154cf6b05bba4bd.png)\n\nTherefore, the coordinates of the vertex are $(2,0).$"}] [{:db/id #edb/ref 17592186253484 :knowledge-point/_questions [{:db/id #edb/ref 17592186176020 :knowledge-point/id #uuid "4728b3c6-a600-569d-922e-228e9f6fb2a6" :knowledge-point/title "Determining the Carrying Capacity of a Logistic Growth Model In Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21345446-40e5-555a-8c69-4278f8474c08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "600" :db/id #edb/ref 17592186250834} {:answer/id #uuid "bee31f53-257f-5377-b97b-f254d08ac4c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "500" :db/id #edb/ref 17592186252236} {:answer/id #uuid "cf60d0b2-9b21-5060-b2b7-579b6657bd35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "850" :db/id #edb/ref 17592186252385} {:answer/id #uuid "d56e2723-492d-5f07-b7a3-d85a5ce7888a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "300" :db/id #edb/ref 17592186252442} {:answer/id #uuid "f1d031c6-c32d-57f6-b187-e224d892ee90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,200" :db/id #edb/ref 17592186252667}] :answer-field/correct {:answer/id #uuid "21345446-40e5-555a-8c69-4278f8474c08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "600" :db/id #edb/ref 17592186250834} :answer-field/id #uuid "63a8671e-f9fd-5cd6-8126-9a66988843ec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252985}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "374e2fb9-5e2c-5d76-b0e3-c554c19e0eff" :question/math-academy-id "q-118552" :question/problem "The population $y(t)$ of Weddell seals in a certain region of Antarctica follows the logistic growth model\n\n$$\n{y}^{′}=1.2y-0.002{y}^{2},\\,y(0)=100,\n$$\n\nwhere $t$ is the time, in years. According to this model, what is the maximum possible seal population?" :question/worked-solution "A logistic growth equation has the form\n\n$$\n{y}^{′}=ky(a-y),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>y$ is the carrying capacity. \n\nThe carrying capacity $a$ represents the maximum possible population. A diagram showing a typical logistic growth curve is shown below.\n\n![](images/57/57f4b604c546daed4f1cb3895191fae0ccac33b5c17aac705f203f0a837c7e69.png)\n\nFirst, let's rewrite the right-hand side of the given equation so that it matches the form above:\n\n$$\n\\begin{aligned}{y}^{′} & =1.2y-0.002{y}^{2} \\\\  & =0.002y(600-y)\\end{aligned}\n$$\n\nFrom here, we see that $a=600.$ Hence, the carrying capacity is $600,$ and we conclude that the number of seals cannot exceed $600.$"}] [{:db/id #edb/ref 17592186097013 :knowledge-point/_questions [{:db/id #edb/ref 17592186096711 :knowledge-point/id #uuid "61861939-69d4-5b1e-a0f0-6a1b383b775b" :knowledge-point/title "Identifying the Vertex of a Horizontal Parabola Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2c58e0b-893d-537f-bcb4-04d6e664e880" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(8, 6)" :db/id #edb/ref 17592186094052} {:answer/id #uuid "068f8801-49bd-5331-a301-53f89c102401" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6, 6)" :db/id #edb/ref 17592186094053} {:answer/id #uuid "2cec2cc9-f6b9-51e6-ac74-3f341f3e0251" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6, 4)" :db/id #edb/ref 17592186094054} {:answer/id #uuid "6e159f91-c086-5b7f-affd-373d731eeeed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6, 8)" :db/id #edb/ref 17592186094055} {:answer/id #uuid "6fe5bdba-1077-5d77-a7af-aa5149e32767" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4, 6)" :db/id #edb/ref 17592186094056}] :answer-field/id #uuid "2ad6c4fd-734b-51b4-9a6f-6bebb4733b96" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186094051} {:answer-field/choices [{:answer/id #uuid "86993d2d-50bf-5dff-9967-dc3897b186ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(8,6)" :db/id #edb/ref 17592186386877} {:answer/id #uuid "847a514e-ed4d-5ab9-9b42-da968819ca5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6,6)" :db/id #edb/ref 17592186386878} {:answer/id #uuid "71a2b3ad-6b2a-5de5-b052-f25d736480f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,6)" :db/id #edb/ref 17592186386879} {:answer/id #uuid "f8a63424-7ca7-5ab9-b588-f4b8e06f836e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6,4)" :db/id #edb/ref 17592186386880} {:answer/id #uuid "3f20f38a-98c7-5e51-86e9-1958a8ecab18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6,8)" :db/id #edb/ref 17592186386881}] :answer-field/correct {:answer/id #uuid "f8a63424-7ca7-5ab9-b588-f4b8e06f836e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6,4)" :db/id #edb/ref 17592186386880} :answer-field/id #uuid "15bf4a4d-fe97-5b21-94a9-19c7806ee1e5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386876}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "781d9979-bbb4-5c2f-b5a4-4d9ed9d2fd48" :question/math-academy-id "q-11856" :question/problem "![](images/91/91d23b43c3d6ddd08b90efd5d3576ec509b5e0dd4a8e5c1745b21ec2119aad77.png)\n\nWhat is the vertex of the parabola shown above?" :question/worked-solution "The vertex of a left-opening parabola is the right-most point of the parabola.\n\n![](images/94/94d33dcb92ddb84479c1ea7b01d5619268a10786a19f318fba61f3107ba9b551.png)\n\nTherefore, the coordinates of the vertex are $(6,4).$"}] [{:db/id #edb/ref 17592186097014 :knowledge-point/_questions [{:db/id #edb/ref 17592186096711 :knowledge-point/id #uuid "61861939-69d4-5b1e-a0f0-6a1b383b775b" :knowledge-point/title "Identifying the Vertex of a Horizontal Parabola Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e81d39f-516e-5368-bc2d-95dfd56ecc89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-6,0)" :db/id #edb/ref 17592186250951} {:answer/id #uuid "5c03ac82-c231-5272-a9f5-a8427c78969f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6,0)" :db/id #edb/ref 17592186251313} {:answer/id #uuid "689bd0b0-919d-55db-882e-177fbc8a49bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-4)" :db/id #edb/ref 17592186251412} {:answer/id #uuid "9087b924-4289-55bc-b40d-7d3076a7e6b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-6)" :db/id #edb/ref 17592186251783} {:answer/id #uuid "e93901db-4d3a-50ca-a596-af6453f3997b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,0)" :db/id #edb/ref 17592186252594}] :answer-field/correct {:answer/id #uuid "2e81d39f-516e-5368-bc2d-95dfd56ecc89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-6,0)" :db/id #edb/ref 17592186250951} :answer-field/id #uuid "1177d6ca-055d-590d-ba84-4ee5a4872460" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252840}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4afc9701-6ad5-5e60-8fef-e96b8a6fe757" :question/math-academy-id "q-11858" :question/problem "![](images/8b/8b1d78038032973d7bb5738b67963e0bfadb258e4c1eb06f191496bded406696.png)\n\nWhat is the vertex of the parabola shown above?" :question/worked-solution "The vertex of a right-opening parabola is the left-most point of the parabola.\n\n![](images/aa/aaf295d69a75c976df8aaf02ee6680486c502f7ce5719b41682cdf2499cab984.png)\n\nTherefore, the coordinates of the vertex are $(-6,0).$"}] [{:db/id #edb/ref 17592186253494 :knowledge-point/_questions [{:db/id #edb/ref 17592186083344 :knowledge-point/id #uuid "6dc2621a-77e1-56d9-af63-1917eaa933b2" :knowledge-point/title "Calculating Improper Integrals With an Unbounded Upper Limit Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2796c11a-4fa6-505d-9e0a-aa25efdb9c37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The integral diverges" :db/id #edb/ref 17592186250892} {:answer/id #uuid "5ec32c39-76e1-531c-a980-52d6069a233f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186251335} {:answer/id #uuid "946eb912-f177-51c6-8055-52cb6bf80ad7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186251830} {:answer/id #uuid "9c077374-79f0-523e-825a-f5521b2be909" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186251898} {:answer/id #uuid "bd295589-d9fe-5cee-b9fd-e8e6c502b237" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186252223}] :answer-field/correct {:answer/id #uuid "5ec32c39-76e1-531c-a980-52d6069a233f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186251335} :answer-field/id #uuid "c8899cbd-a6dc-541a-a768-564111ff4288" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253151}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "bfa67a4d-773b-5a56-87ac-2e520036ce73" :question/math-academy-id "q-118618" :question/problem "Evaluate the integral ${\\int }_{0}^{\\infty }\\frac{x}{\\sqrt{({x}^{2}+1)^{3}}}\\,\\text{d}x.$" :question/worked-solution "First, we substitute $u={x}^{2}+1.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to \\infty ,$ the table for the limits of integration using the rule $u={x}^{2}+1$ is as follows:\n\n| $x$ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $1$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{x}{\\sqrt{({x}^{2}+1)^{3}}}\\,\\text{d}x & =\\frac{1}{2}{\\int }_{1}^{\\infty }\\frac{1}{\\sqrt{{u}^{3}}}\\,\\text{d}u.\\end{aligned}\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{x}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x & =\\frac{1}{2}{\\int }_{1}^{\\infty }\\frac{1}{\\sqrt{{u}^{3}}}\\,\\text{d}u \\\\  & =\\frac{1}{2}{\\int }_{1}^{\\infty }{u}^{-3/2}\\,\\text{d}u \\\\  & =\\frac{1}{2}{lim}_{a\\to \\infty }{\\int }_{1}^{a}{u}^{-3/2}\\,\\text{d}u \\\\  & =\\frac{1}{2}{lim}_{a\\to \\infty }{[-2{u}^{-1/2}]}_{1}^{a} \\\\  & =-{lim}_{a\\to \\infty }{[\\frac{1}{\\sqrt{u}}]}_{1}^{a} \\\\  & =-{lim}_{a\\to \\infty }(\\frac{1}{\\sqrt{a}}-1) \\\\  & =-(0-1) \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083496 :knowledge-point/_questions [{:db/id #edb/ref 17592186083344 :knowledge-point/id #uuid "6dc2621a-77e1-56d9-af63-1917eaa933b2" :knowledge-point/title "Calculating Improper Integrals With an Unbounded Upper Limit Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5844549f-b897-5a58-bf08-acfbe8efa2a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186251276} {:answer/id #uuid "7667e2f4-ee83-5482-af7c-d2bdd84fc202" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186251526} {:answer/id #uuid "a218e653-d88f-5440-be12-f0ad6810fe89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The integral diverges" :db/id #edb/ref 17592186251949} {:answer/id #uuid "c7cc8e9f-2139-5926-aacc-b95747012288" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186252321} {:answer/id #uuid "f79ecc31-c3ea-5c7d-ae4d-ea007b99bc9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186252718}] :answer-field/correct {:answer/id #uuid "7667e2f4-ee83-5482-af7c-d2bdd84fc202" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186251526} :answer-field/id #uuid "9f22f9c0-c715-5c9f-b358-40ff3aa9350f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253084}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8d988115-5b28-5cc4-948a-8ebc728e32c9" :question/math-academy-id "q-118619" :question/problem "Evaluate the integral ${\\int }_{0}^{\\infty }\\frac{x}{{(1+{x}^{2})}^{2}}\\,\\text{d}x.$" :question/worked-solution "First, we substitute $u=1+{x}^{2}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to \\infty ,$ the table for the limits of integration using the rule $u=1+{x}^{2}$ is as follows:\n\n| $x$ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $1$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{x}{{(1+{x}^{2})}^{2}}\\,\\text{d}x & =\\frac{1}{2}{\\int }_{1}^{\\infty }\\frac{1}{{u}^{2}}\\,\\text{d}u.\\end{aligned}\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{x}{{(1+{x}^{2})}^{2}}\\,\\text{d}x & =\\frac{1}{2}{\\int }_{1}^{\\infty }\\frac{1}{{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{1}{2}{\\int }_{1}^{\\infty }{u}^{-2}\\,\\text{d}u \\\\  & =\\frac{1}{2}{lim}_{a\\to \\infty }{\\int }_{1}^{a}{u}^{-2}\\,\\text{d}u \\\\  & =\\frac{1}{2}{lim}_{a\\to \\infty }[-{u}^{-1}]_{1}^{a} \\\\  & =-\\frac{1}{2}{lim}_{a\\to \\infty }{[\\frac{1}{u}]}_{1}^{a} \\\\  & =-\\frac{1}{2}{lim}_{a\\to \\infty }(\\frac{1}{a}-1) \\\\  & =-\\frac{1}{2}(0-1) \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386882 :knowledge-point/_questions [{:db/id #edb/ref 17592186115409 :knowledge-point/id #uuid "f7e817a0-edcf-54ca-ba4c-ffe91af04675" :knowledge-point/title "Finding a Height of a Triangle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b161b259-2a2c-531b-b051-34dd949dc4d6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/16/16c9990277df1c1b212ff154c4951b59301ef5b7f8360f82b041e73a5a3a984b.png" :db/id #edb/ref 17592186386884} {:answer/id #uuid "e0792fd2-fe4a-5351-bd8d-d02531595632" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/10/10e9f5a6af4d6d2b9c6392de91432b09620107d3dc645fc6ca65fdbda52f7c83.png" :db/id #edb/ref 17592186386885} {:answer/id #uuid "b85c7ea1-4023-5d0d-86b4-0459134b26d0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ce/ce3493e78660cfa84515970053105b95df5542eafbc4630c1e5b0afe9f658036.png" :db/id #edb/ref 17592186386886} {:answer/id #uuid "6c9daab7-90f4-5583-88a7-85210ed3b622" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/16/168ba7b705d9a579dc11408cc7bf60fb13249c5d4c6a25c3c490c09cfc77ec38.png" :db/id #edb/ref 17592186386887} {:answer/id #uuid "26d31697-89a3-57f9-9d21-e473be574ab7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/30/301c31fa98ce5c016337f422566b94a742e3da126b76f9060e4b13d6a8e86358.png" :db/id #edb/ref 17592186386888}] :answer-field/correct {:answer/id #uuid "26d31697-89a3-57f9-9d21-e473be574ab7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/30/301c31fa98ce5c016337f422566b94a742e3da126b76f9060e4b13d6a8e86358.png" :db/id #edb/ref 17592186386888} :answer-field/id #uuid "05bed876-047b-5aad-854a-94fee100e605" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386883}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3f1782d4-ceb0-5897-9f90-478b4c1242ae" :question/math-academy-id "q-118692" :question/problem "![](images/55/5548481ccbe3aee88fd4b346ad53777b7101223c19f7e8408c8ef85bb0d9df25.png)\n\nGiven the right triangle $△PQR$ shown above, which of the following diagrams represents the height corresponding to $\\overset{―}{PR}?$" :question/worked-solution "The height (or altitude) corresponding to $\\overset{―}{PR}$ is a line segment that \n\n- runs from the opposite vertex $Q$ to the line $\\overset{⟷}{PR},$ and\n\n- is perpendicular to $\\overset{⟷}{PR}.$\n\nThe correct diagram is shown below.\n\n![](images/30/301c31fa98ce5c016337f422566b94a742e3da126b76f9060e4b13d6a8e86358.png)"}] [{:db/id #edb/ref 17592186253501 :knowledge-point/_questions [{:db/id #edb/ref 17592186105922 :knowledge-point/id #uuid "4e93fd7f-070f-5359-aabb-cba5cc275015" :knowledge-point/title "Identifying Convergent or Divergent Integrals With Unbounded Limits"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "256aa671-a669-57d4-b91d-ced24db81e43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186250876} {:answer/id #uuid "5a277d68-b884-5e7d-b52b-01b0500937b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186251295} {:answer/id #uuid "ac672eaa-7a45-596b-aff7-c0a0076f4abb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186252053} {:answer/id #uuid "c6240e34-c165-5a5d-b60f-e16d15bc4bb8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186252304} {:answer/id #uuid "eb6959c8-58ee-530d-bb52-f3078500cbf9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186252618}] :answer-field/correct {:answer/id #uuid "256aa671-a669-57d4-b91d-ced24db81e43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186250876} :answer-field/id #uuid "92e60e35-c089-5683-b48c-03659e05f5af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253059}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "260fa3cd-f59d-50c6-a56e-8cfbd29393f0" :question/math-academy-id "q-118755" :question/problem "Consider the function $f(x)=\\frac{x}{{x}^{2}+4}.$ Which of the following statements are true?\n\nI. ${\\int }_{0}^{\\infty }f(x)\\,\\text{d}x$ is convergent\n\nII. ${\\int }_{-\\infty }^{0}f(x)\\,\\text{d}x$ is divergent\n\nIII. ${\\int }_{-\\infty }^{\\infty }f(x)\\,\\text{d}x$ is divergent" :question/worked-solution "Suppose we have an improper integral in which both the left and right endpoints are unbounded:\n\n$$\n{\\int }_{-\\infty }^{\\infty }f(x)\\,\\text{d}x\n$$\n\nIf the integrand $f(x)$ is continuous on $(-\\infty ,\\infty ),$ then we can break the integral up into two improper integrals, each with a single unbounded endpoint:\n\n$$\n{\\int }_{-\\infty }^{\\infty }f(x)\\,\\text{d}x={\\int }_{-\\infty }^{0}f(x)\\,\\text{d}x+{\\int }_{0}^{\\infty }f(x)\\,\\text{d}x\n$$\n\nThen, we can compute each of the two integrals separately and combine their results. \n\n**Watch out!** If either of the two integrals on the right-hand side is divergent, then the integral on the left-hand side is also divergent.\n\nFirst, we calculate the antiderivative using a substitution.  Let $u={x}^{2}+4$,  then $\\text{d}u=2x\\,\\text{d}x.$ Hence, the antiderivative is\n\n$$\n\\begin{aligned}\\int \\frac{x}{{x}^{2}+4}\\,\\text{d}x & =\\frac{1}{2}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡({x}^{2}+4)+C.\\end{aligned}\n$$\n\nNow, let's evaluate each integral in turn.\n\n- Statement I is false. Computing the required integral, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{x}{{x}^{2}+4}\\,\\text{d}x & ={lim}_{a\\to \\infty }{\\int }_{0}^{a}\\frac{x}{{x}^{2}+4}\\,\\text{d}x \\\\  & ={lim}_{a\\to \\infty }{(\\frac{1}{2}\\operatorname{ln}⁡({x}^{2}+4))|}_{0}^{a} \\\\  & =\\frac{1}{2}{lim}_{a\\to \\infty }(\\operatorname{ln}⁡({a}^{2}+4)-\\operatorname{ln}⁡4) \\\\  & =\\frac{1}{2}{lim}_{a\\to \\infty }\\operatorname{ln}⁡({a}^{2}+4)-\\frac{\\operatorname{ln}⁡4}{2}.\\end{aligned}\n$$\n\nAs $a\\to \\infty $, we have that $\\operatorname{ln}⁡({a}^{2}+4)\\to \\infty .$ So the integral diverges.\n\n- Statement II is true. Computing the required integral, we get\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{x}{{x}^{2}+4}\\,\\text{d}x & ={lim}_{a\\to -\\infty }{\\int }_{a}^{0}\\frac{x}{{x}^{2}+4}\\,\\text{d}x \\\\  & ={lim}_{a\\to -\\infty }{(\\frac{1}{2}\\operatorname{ln}⁡({x}^{2}+4))|}_{a}^{0} \\\\  & =\\frac{1}{2}{lim}_{a\\to -\\infty }(\\operatorname{ln}⁡4-\\operatorname{ln}⁡({a}^{2}+4)) \\\\  & =\\frac{\\operatorname{ln}⁡4}{2}-{lim}_{a\\to -\\infty }\\operatorname{ln}⁡({a}^{2}+4).\\end{aligned}\n$$\n\nAs $a\\to -\\infty $, we have that $\\operatorname{ln}⁡({a}^{2}+4)\\to \\infty .$ So the integral diverges.\n\n- Statement III is true. The integral in statement III can be expressed as\n\n$$\n{\\int }_{-\\infty }^{\\infty }f(x)\\,\\text{d}x={\\int }_{-\\infty }^{0}f(x)\\,\\text{d}x+{\\int }_{0}^{\\infty }f(x)\\,\\text{d}x.\n$$\n\nHowever, both integrals on the right-hand side are divergent. Therefore, the integral on the left-hand side is also divergent.\n\nIn conclusion,  only statements II and III are true."}] [{:db/id #edb/ref 17592186253503 :knowledge-point/_questions [{:db/id #edb/ref 17592186115336 :knowledge-point/id #uuid "6a916099-a237-5612-b7f1-3679b7ff069d" :knowledge-point/title "Calculating an Unknown Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37f6e98b-9e74-5362-9415-76b0e5788bd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{26}^{∘}" :db/id #edb/ref 17592186251016} {:answer/id #uuid "412b51d2-1c6c-5e96-b7f4-3a46ab2a6b3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{28}^{∘}" :db/id #edb/ref 17592186251093} {:answer/id #uuid "5df0c213-f26e-5d44-b086-a8082f8ff356" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{22}^{∘}" :db/id #edb/ref 17592186251329} {:answer/id #uuid "6a726442-67f6-5b29-aa0d-827d6fcd828e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{18}^{∘}" :db/id #edb/ref 17592186251427} {:answer/id #uuid "b7d0d4d2-0d27-5b44-a286-f8c17048fc8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{32}^{∘}" :db/id #edb/ref 17592186252172}] :answer-field/correct {:answer/id #uuid "412b51d2-1c6c-5e96-b7f4-3a46ab2a6b3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{28}^{∘}" :db/id #edb/ref 17592186251093} :answer-field/id #uuid "fd987d2b-51a1-5e48-9b29-2cadc9f301dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253251}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "574c517e-3266-5464-9df0-9e740c923895" :question/math-academy-id "q-118757" :question/problem "![](images/95/95b534f8c159b37884e32b730d9aa502565ff4971cd7d08903ffbfaa94b76623.png)\n\nConsider $△PQR$ shown above. The line segment $\\overset{―}{RH}$ is the altitude corresponding to $\\overset{―}{PQ}.$ If $m∠PQR={118}^{∘},$ calculate $m∠QRH.$" :question/worked-solution "Since the straight angle must have a measure of ${180}^{∘},$ we have\n\n$$\n\\begin{aligned}m∠HQR+m∠PQR & ={180}^{∘} \\\\ m∠HQR+{118}^{∘} & ={180}^{∘} \\\\ m∠HQR & ={62}^{∘}.\\end{aligned}\n$$\n\nNote that $△QHR$ is a right triangle. Since its interior angles must sum to ${180}^{∘},$ we have\n\n$$\n\\begin{aligned}m∠QRH+m∠HQR+m∠RHQ & ={180}^{∘} \\\\ m∠QRH+{62}^{∘}+{90}^{∘} & ={180}^{∘} \\\\ m∠QRH+{152}^{∘} & ={180}^{∘} \\\\ m∠QRH & ={28}^{∘}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386889 :knowledge-point/_questions [{:db/id #edb/ref 17592186096761 :knowledge-point/id #uuid "d27b85e4-ddae-5b5f-965a-5dff51b8449b" :knowledge-point/title "Identifying the Vertex of a Vertical Parabola Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "691136a3-c8a5-53ad-8f6d-c6b62b26d2c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-4)" :db/id #edb/ref 17592186386891} {:answer/id #uuid "4c1ff36f-0d8d-575f-a2e6-11d23df75e25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,-2)" :db/id #edb/ref 17592186386892} {:answer/id #uuid "de319e43-ff4a-5fb9-bb56-990836c287f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,-2)" :db/id #edb/ref 17592186386893} {:answer/id #uuid "c9cc895f-c91f-5a56-9fed-858ae28ad8c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,4)" :db/id #edb/ref 17592186386894} {:answer/id #uuid "c662477e-f2ce-5416-aaa2-7348143c6498" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,2)" :db/id #edb/ref 17592186386895}] :answer-field/correct {:answer/id #uuid "691136a3-c8a5-53ad-8f6d-c6b62b26d2c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-4)" :db/id #edb/ref 17592186386891} :answer-field/id #uuid "2e5e3905-c2b1-520e-a32d-31b10c414d70" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386890}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c4ff74f6-4836-56a3-8d9f-d719958e2599" :question/math-academy-id "q-11876" :question/problem "![](images/a2/a240b7c7ad19758ceaa9c2d6b90cb8308f7bd05c2e6e318bb6654ddf743d0136.png)\n\nWhat is the vertex of the parabola shown above?" :question/worked-solution "The vertex of an upward-opening parabola is the lowest point of the parabola.\n\n![](images/b6/b6394c3b265b4c49fc6e7d1284ed63c176216f755824578e6bf2d9ef4de8b2bb.png)\n\n  \n\nTherefore, the coordinates of the vertex are $(2,-4).$"}] [{:db/id #edb/ref 17592186253505 :knowledge-point/_questions [{:db/id #edb/ref 17592186105923 :knowledge-point/id #uuid "3fe1f468-9e8d-58fc-bd61-cfe1191a5a19" :knowledge-point/title "Calculating an Improper Integral With Unbounded Limits"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f1a364e-3b14-5b1e-925a-17619c3c4554" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186250954} {:answer/id #uuid "425e34a3-6e0d-5c26-9432-07697c0aa0e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186251107} {:answer/id #uuid "a31e745b-dd53-5147-a790-8537255c9700" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The integral diverges" :db/id #edb/ref 17592186251958} {:answer/id #uuid "a6581fa3-e9c8-5704-aa7c-c199f43ad4a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186251988} {:answer/id #uuid "fae68304-e087-5c8c-9cc4-675e9c2b99ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186252752}] :answer-field/correct {:answer/id #uuid "a6581fa3-e9c8-5704-aa7c-c199f43ad4a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186251988} :answer-field/id #uuid "f4fec40e-2040-58e3-9660-c87c436962eb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253237}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c8456d00-1e90-5830-966e-53837304687a" :question/math-academy-id "q-118774" :question/problem "Evaluate the integral ${\\int }_{-\\infty }^{\\infty }\\frac{2x}{{e}^{{x}^{2}}}\\,\\text{d}x.$" :question/worked-solution "We break up the integral as follows:\n\n$$\n{\\int }_{-\\infty }^{\\infty }\\frac{2x}{{e}^{{x}^{2}}}\\,\\text{d}x={\\int }_{-\\infty }^{0}\\frac{2x}{{e}^{{x}^{2}}}\\,\\text{d}x+{\\int }_{0}^{\\infty }\\frac{2x}{{e}^{{x}^{2}}}\\,\\text{d}x\n$$\n\nFirst, we calculate the antiderivative using a substitution. Let  $u={x}^{2}$,  then $\\text{d}u=2x\\text{d}x.$ Hence,\n\n$$\n\\begin{aligned}\\int \\frac{2x}{{e}^{{x}^{2}}}\\,\\text{d}x & =\\int \\frac{1}{{e}^{u}}\\,\\text{d}u \\\\  & =\\int {e}^{-u}\\,\\text{d}u \\\\  & =-{e}^{-u}+C \\\\  & =-{e}^{-{x}^{2}}+C.\\end{aligned}\n$$\n\nWe now evaluate the first of the improper integrals, as follows:\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{2x}{{e}^{{x}^{2}}}\\,\\text{d}x & ={lim}_{a\\to -\\infty }{\\int }_{a}^{0}\\frac{2x}{{e}^{{x}^{2}}}\\,\\text{d}x \\\\  & ={lim}_{a\\to -\\infty }{(-{e}^{-{x}^{2}})|}_{a}^{0} \\\\  & ={lim}_{a\\to -\\infty }(-{e}^{0}-(-{e}^{-{a}^{2}})) \\\\  & =-1+0 \\\\  & =-1\\end{aligned}\n$$\n\nNow, notice that the integrand is an **odd** function. This means that we can immediately deduce that\n\n$$\n{\\int }_{0}^{\\infty }\\frac{2x}{{e}^{{x}^{2}}}\\,\\text{d}x=1.\n$$\n\nTherefore, since both improper integrals exist, we conclude that \n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{\\infty }\\frac{2x}{{e}^{{x}^{2}}}\\,\\text{d}x & ={\\int }_{-\\infty }^{0}\\frac{2x}{{e}^{{x}^{2}}}\\,\\text{d}x+{\\int }_{0}^{\\infty }\\frac{2x}{{e}^{{x}^{2}}}\\,\\text{d}x \\\\  & =-1+1 \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253506 :knowledge-point/_questions [{:db/id #edb/ref 17592186105923 :knowledge-point/id #uuid "3fe1f468-9e8d-58fc-bd61-cfe1191a5a19" :knowledge-point/title "Calculating an Improper Integral With Unbounded Limits"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f1b0944-5746-51e3-95af-0c78d353b0b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186251078} {:answer/id #uuid "5483cc68-a72b-52f6-99ad-108af7c29b48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186251245} {:answer/id #uuid "712f686d-666e-5b50-837d-069f1c8844f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186251478} {:answer/id #uuid "831c3d8d-8d9b-5446-847d-4a9578ff7cc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186251659} {:answer/id #uuid "da79cc7e-e889-5625-9d36-6e8c5b69befe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186252473}] :answer-field/correct {:answer/id #uuid "831c3d8d-8d9b-5446-847d-4a9578ff7cc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186251659} :answer-field/id #uuid "6264318d-7488-52ce-83d2-d05d6144f903" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252983}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "64a6785a-7bbf-5956-bb67-37d306305466" :question/math-academy-id "q-118776" :question/problem "Evaluate the integral ${\\int }_{-\\infty }^{\\infty }\\frac{x}{{(3+{x}^{2})}^{2}}\\,\\text{d}x.$" :question/worked-solution "We break up the integral as follows:\n\n$$\n{\\int }_{-\\infty }^{\\infty }\\frac{x}{{(3+{x}^{2})}^{2}}\\,\\text{d}x={\\int }_{-\\infty }^{0}\\frac{x}{{(3+{x}^{2})}^{2}}\\,\\text{d}x+{\\int }_{0}^{\\infty }\\frac{x}{{(3+{x}^{2})}^{2}}\\,\\text{d}x\n$$\n\nFirst, we calculate the antiderivative using a substitution. Let  $u=3+{x}^{2}$,  then $\\text{d}u=2x\\text{d}x.$ Hence,\n\n$$\n\\begin{aligned}\\int \\frac{x}{{(3+{x}^{2})}^{2}}\\,\\text{d}x & =\\frac{1}{2}\\int \\frac{1}{{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot (-\\frac{1}{u})+C \\\\  & =-\\frac{1}{2(3+{x}^{2})}+C.\\end{aligned}\n$$\n\nWe now evaluate the first of the improper integrals, as follows:\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{x}{{(3+{x}^{2})}^{2}}\\,\\text{d}x & ={lim}_{a\\to -\\infty }{\\int }_{a}^{0}\\frac{x}{{(3+{x}^{2})}^{2}}\\,\\text{d}x \\\\  & ={lim}_{a\\to -\\infty }{(-\\frac{1}{2(3+{x}^{2})})|}_{a}^{0} \\\\  & =-{lim}_{a\\to -\\infty }(\\frac{1}{2(3+0)}-\\frac{1}{2(3+{a}^{2})}) \\\\  & =-(\\frac{1}{6}-0) \\\\  & =-\\frac{1}{6}\\end{aligned}\n$$\n\nNow, notice that the integrand is an **odd** function. This means that we can immediately deduce that\n\n$$\n{\\int }_{0}^{\\infty }\\frac{x}{{(3+{x}^{2})}^{2}}\\,\\text{d}x=\\frac{1}{6}.\n$$\n\nTherefore, since both improper integrals exist, we conclude that \n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{\\infty }\\frac{x}{{(3+{x}^{2})}^{2}}\\,\\text{d}x & ={\\int }_{-\\infty }^{0}\\frac{x}{{(3+{x}^{2})}^{2}}\\,\\text{d}x+{\\int }_{0}^{\\infty }\\frac{x}{{(3+{x}^{2})}^{2}}\\,\\text{d}x \\\\  & =-\\frac{1}{6}+\\frac{1}{6} \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253509 :knowledge-point/_questions [{:db/id #edb/ref 17592186096761 :knowledge-point/id #uuid "d27b85e4-ddae-5b5f-965a-5dff51b8449b" :knowledge-point/title "Identifying the Vertex of a Vertical Parabola Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "270439e3-e2ab-5a45-87bf-95f9becc4e56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-8,-4)" :db/id #edb/ref 17592186250889} {:answer/id #uuid "463b87ff-48d0-5886-a575-321db25afa2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(8,4)" :db/id #edb/ref 17592186251134} {:answer/id #uuid "68421f23-fdb5-513b-aad2-454ec11b2707" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,8)" :db/id #edb/ref 17592186251407} {:answer/id #uuid "6c15702c-4ffc-5fc6-bfbe-fc6f04ea6b2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,6)" :db/id #edb/ref 17592186251437} {:answer/id #uuid "88b53079-b103-5a08-a70c-3440fd7a01bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,-8)" :db/id #edb/ref 17592186251705}] :answer-field/correct {:answer/id #uuid "68421f23-fdb5-513b-aad2-454ec11b2707" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,8)" :db/id #edb/ref 17592186251407} :answer-field/id #uuid "835c1580-a670-5c3e-b1f5-64dbfd79c4e9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253026}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "acdf7c4b-4f3a-5142-ba6b-26da51bdc76a" :question/math-academy-id "q-11878" :question/problem "![](images/2b/2b78b376173589b18d5e8da73897d9552f41a00aab523c0e76892623b586eb53.png)\n\nWhat is the vertex of the parabola shown above?" :question/worked-solution "The vertex of a downward-opening parabola is the highest point of the parabola.\n\n![](images/3c/3c547f893dc1cf2e71c17022ea7c81034214d7aedabe78bf719ebd44b96da329.png)\n\n \n\nTherefore, the coordinates of the vertex are $(4,8).$"}] [{:db/id #edb/ref 17592186253510 :knowledge-point/_questions [{:db/id #edb/ref 17592186166813 :knowledge-point/id #uuid "443c0bd0-2e77-50a8-91d3-a288d4ee852b" :knowledge-point/title "Identifying the Order of an Ordinary Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18ed852c-a746-5e34-8210-a1c6c19157ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186250771} {:answer/id #uuid "36e85211-b2b9-5649-bb4b-17bb47e95e41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186251005} {:answer/id #uuid "7c9ca850-3368-5c8e-a5b8-495183e07f87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186251590} {:answer/id #uuid "9e263215-e831-5e53-a204-bd8750fe03b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186251918} {:answer/id #uuid "a7d903f5-c111-595f-8377-514289f9d574" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186251999}] :answer-field/correct {:answer/id #uuid "18ed852c-a746-5e34-8210-a1c6c19157ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186250771} :answer-field/id #uuid "0050ba89-30e8-5e34-8905-20291c552790" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252802}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "345cfcae-2112-5c63-808e-4798d18f1830" :question/math-academy-id "q-118781" :question/problem "What is the order of the ordinary differential equation $x\\frac{{\\text{d}}^{3}y}{\\text{d}{x}^{3}}-{y}^{2}\\frac{{\\text{d}}^{4}y}{\\text{d}{x}^{4}}={y}^{5}?$" :question/worked-solution "The order of an ordinary differential equation (ODE) is the order of the highest derivative in the equation.\n\nThe highest derivative in the given ODE is $\\frac{{\\text{d}}^{4}y}{\\text{d}{x}^{4}},$ which has order $4.$\n\nTherefore, the order of the ODE is $4.$"}] [{:db/id #edb/ref 17592186253518 :knowledge-point/_questions [{:db/id #edb/ref 17592186172020 :knowledge-point/id #uuid "744f58f2-59be-552a-bb2f-d0819f35c1ca" :knowledge-point/title "Calculating the Vertex of a Vertical Parabola by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31eae523-b822-58ad-84b8-24a8c8c517c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,5)" :db/id #edb/ref 17592186250975} {:answer/id #uuid "4f2b65f9-7449-55b0-b80f-012392fc3d56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,1)" :db/id #edb/ref 17592186251201} {:answer/id #uuid "9304e5c4-e8bb-560d-b6cf-ca604dd5c635" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,5)" :db/id #edb/ref 17592186251811} {:answer/id #uuid "b05869f6-7a5a-5965-a848-de17c17b0be9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-5,-1)" :db/id #edb/ref 17592186252092} {:answer/id #uuid "c38579e0-e067-5179-a6d6-769ac12fe71c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,-1)" :db/id #edb/ref 17592186252282}] :answer-field/correct {:answer/id #uuid "c38579e0-e067-5179-a6d6-769ac12fe71c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,-1)" :db/id #edb/ref 17592186252282} :answer-field/id #uuid "5ff0b7d9-f9c5-51c2-b17a-cf4bb084169d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252977}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "75271eed-aac2-5e60-97ce-6705a0cbc81a" :question/math-academy-id "q-11884" :question/problem "Calculate the coordinates of the vertex of the parabola $3{x}^{2}-30x-8y+67=0.$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^{2}=4p(y-k),\n$$\n\nwhere $p$ is constant.\n\nTo write the given equation in this form, we need to group the $x$-terms on the left-hand side and complete the square, as follows:\n\n$$\n\\begin{aligned}3{x}^{2}-30x-8y+67 & =0 \\\\ 3{x}^{2}-30x & =8y-67 \\\\ 3[{x}^{2}-10x] & =8y-67 \\\\ 3[(x-5)^{2}-25] & =8y-67 \\\\ 3(x-5)^{2}-75 & =8y-67 \\\\ 3(x-5)^{2} & =8y-67+75 \\\\ 3(x-5)^{2} & =8y+8 \\\\ 3(x-5)^{2} & =8(y+1) \\\\ (x-5)^{2} & =\\frac{8}{3}(y+1) \\\\ (x-5)^{2} & =4(\\frac{2}{3})(y+1)\\end{aligned}\n$$\n\nTherefore, the coordinates of the vertex are $(h,k)=(5,-1).$"}] [{:db/id #edb/ref 17592186253528 :knowledge-point/_questions [{:db/id #edb/ref 17592186096691 :knowledge-point/id #uuid "c015dcaa-2155-5d80-985b-21924de92b28" :knowledge-point/title "Identifying Vector Equalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7725a5ac-f12f-5a08-9999-bfd41e6696a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186251536} {:answer/id #uuid "818adf55-7f8c-555c-9930-b023b5be963f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186251644} {:answer/id #uuid "86d89318-8468-53cc-95ab-a4b946c29961" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186251688} {:answer/id #uuid "8dbca207-78b1-58b0-9bec-e769cd2a732a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186251753} {:answer/id #uuid "f97c7e07-12fe-54ca-a7e8-7b7eba160e36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186252738}] :answer-field/correct {:answer/id #uuid "818adf55-7f8c-555c-9930-b023b5be963f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186251644} :answer-field/id #uuid "1d67c074-de3d-5624-a3d0-a52f941600ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252859}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "41da8ad0-e0fc-5f39-8eb7-c4706c551e5a" :question/math-academy-id "q-118976" :question/problem "![](images/dc/dcd36221e7ad293f0aac1ab99ece80641cb077efd05adc168a552e97d86100c8.png)\n\nIn parallelogram $ABCD$ shown above, which of the following equalities are true?\n\nI. $\\overset{\\to }{AD}=\\overset{\\to }{CB}$\n\nII. $\\overset{\\to }{DC}+\\overset{\\to }{CB}=\\overset{\\to }{DB}$\n\nIII. $\\overset{\\to }{AD}+\\overset{\\to }{DF}=\\overset{\\to }{FA}$" :question/worked-solution "- Equality I is false. Indeed, $\\overset{\\to }{AD}\\ne \\overset{\\to }{CB}$ since they have the opposite directions.\n\n- Equality II is true. Indeed, $\\overset{\\to }{DC}+\\overset{\\to }{CB}=\\overset{\\to }{DB}.$\n\n- Equality III is false. Indeed, $\\overset{\\to }{AD}+\\overset{\\to }{DF}=\\overset{\\to }{AF}\\ne \\overset{\\to }{FA}$ since they have the opposite directions.\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186253529 :knowledge-point/_questions [{:db/id #edb/ref 17592186096615 :knowledge-point/id #uuid "5856f3cc-5423-5a97-b2fd-7f44e0797ec7" :knowledge-point/title "Differentiating a Logarithmic Function With a General Base"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "010fae26-d218-5d85-80be-b5da7fa03138" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{xln⁡4}" :db/id #edb/ref 17592186250562} {:answer/id #uuid "1d7274d3-9d6c-566f-8ab0-5d6dadc206db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4x}" :db/id #edb/ref 17592186250801} {:answer/id #uuid "3fea77d7-dd38-54a3-ab38-de4a5e6af670" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{xln⁡5}" :db/id #edb/ref 17592186251082} {:answer/id #uuid "90d31982-431c-5c96-9fd1-28cbe6930c37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{xln⁡4}" :db/id #edb/ref 17592186251788 :task-item/_responses [{:db/id #edb/ref 17592186409265}]} {:answer/id #uuid "e56177c0-fb1c-54a8-8c75-934ef63a1c08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{x}" :db/id #edb/ref 17592186252561}] :answer-field/correct {:answer/id #uuid "90d31982-431c-5c96-9fd1-28cbe6930c37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{xln⁡4}" :db/id #edb/ref 17592186251788} :answer-field/id #uuid "35ef16c9-7f8c-57e6-86fd-b4dbee5a6bfa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252894}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b9de855f-8e10-5bff-89a6-c3649ce380b6" :question/math-academy-id "q-11900" :question/problem "Given that $y=5{log}_{4}⁡x$, find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{xln⁡a}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(5{log}_{4}⁡x) \\\\  & =5\\frac{\\text{d}}{\\text{d}x}({log}_{4}⁡x) \\\\  & =5\\cdot \\frac{1}{xln⁡4} \\\\  & =\\frac{5}{xln⁡4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186399989 :knowledge-point/_questions [{:db/id #edb/ref 17592186096696 :knowledge-point/id #uuid "f570287d-b0e4-53bb-8fa1-37348ca9202f" :knowledge-point/title "Finding the General Solution of a Differential Equation Using Integration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73b6602d-f037-52b0-8c48-d0885dedafc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)=2(x+9{e}^{-3x})+C" :db/id #edb/ref 17592186399991} {:answer/id #uuid "30b063ed-08ab-5694-9771-9427e9a07c6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)=x-2{e}^{-3x}+C" :db/id #edb/ref 17592186399992} {:answer/id #uuid "95477359-7c43-51b4-a1ff-890600150acd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)=x+{e}^{-3x}+C" :db/id #edb/ref 17592186399993} {:answer/id #uuid "4a2d9c2f-bf87-54d1-a5c5-0103894f75e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)=x-18{e}^{-3x}+C" :db/id #edb/ref 17592186399994} {:answer/id #uuid "3694a7a7-cd54-5712-bdcb-421abc079139" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)=2(x-3{e}^{-3x})+C" :db/id #edb/ref 17592186399995}] :answer-field/correct {:answer/id #uuid "30b063ed-08ab-5694-9771-9427e9a07c6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)=x-2{e}^{-3x}+C" :db/id #edb/ref 17592186399992} :answer-field/id #uuid "8f36605a-43ff-547f-a708-ab078c73b400" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399990}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8e422fe9-fc97-5df0-b6a5-ce1fd6f9f5cf" :question/math-academy-id "q-119037" :question/problem "Find the general solution to the differential equation  ${f}^{′}(x)-6{e}^{-3x}=1.$" :question/worked-solution "First, we rearrange the equation to isolate the derivative term:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =1+6{e}^{-3x}\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =\\int (1+6{e}^{-3x})\\text{d}x \\\\  & =\\int \\text{d}x+6\\int {e}^{-3x}\\,\\text{d}x \\\\  & =x+6(-\\frac{1}{3}{e}^{-3x}) \\\\  & =x-2{e}^{-3x}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253534 :knowledge-point/_questions [{:db/id #edb/ref 17592186096697 :knowledge-point/id #uuid "192bb38b-b609-56ff-b560-becfc38ea070" :knowledge-point/title "Finding the General Solution of a Second Order Differential Equation by Integrating Twice"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "222d3811-c9d6-5e7d-b85c-95aa3edf1f5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-{e}^{-2x}+C{e}^{-x}+Dx" :db/id #edb/ref 17592186250846} {:answer/id #uuid "2aeffcd6-4797-59ec-860f-11aa268d3482" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2{e}^{-2x}+Cx+D" :db/id #edb/ref 17592186250918} {:answer/id #uuid "65573541-1d72-5f2c-8753-db5f49766c66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-2x}+C{x}^{2}+Dx" :db/id #edb/ref 17592186251383} {:answer/id #uuid "849fa2e5-06fb-57df-930c-0b02e73c0378" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2{e}^{-2x}+C{e}^{-x}+D" :db/id #edb/ref 17592186251665} {:answer/id #uuid "dd1f009d-922c-586a-8478-6e8b8c14b8c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-4{e}^{-2x}+Cx+D" :db/id #edb/ref 17592186252500}] :answer-field/correct {:answer/id #uuid "2aeffcd6-4797-59ec-860f-11aa268d3482" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2{e}^{-2x}+Cx+D" :db/id #edb/ref 17592186250918} :answer-field/id #uuid "cdcccacb-a603-583d-bd6c-044e60d286f7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253159}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "31249dfd-dd0f-51ef-9508-c411dcb82eb2" :question/math-academy-id "q-119038" :question/problem "Solve the differential equation $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=8{e}^{-2x}.$" :question/worked-solution "Integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =8\\int {e}^{-2x}\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =8(-\\frac{1}{2}{e}^{-2x})+C \\\\  & =-4{e}^{-2x}+C.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (-4{e}^{-2x}+C)\\text{d}x \\\\ y & =-4(-\\frac{1}{2}{e}^{-2x})+Cx+D \\\\  & =2{e}^{-2x}+Cx+D.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$"}] [{:db/id #edb/ref 17592186253537 :knowledge-point/_questions [{:db/id #edb/ref 17592186096697 :knowledge-point/id #uuid "192bb38b-b609-56ff-b560-becfc38ea070" :knowledge-point/title "Finding the General Solution of a Second Order Differential Equation by Integrating Twice"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23cc8ac7-5e09-54ce-b6d3-e159d67ab8ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3{x}^{4}+4{x}^{2}+Cx+D" :db/id #edb/ref 17592186250861} {:answer/id #uuid "5901205a-e2f9-52f3-b94e-a09bbbbe0521" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{{x}^{4}}{4}+\\frac{5{x}^{2}}{4}+Cx+D" :db/id #edb/ref 17592186251285} {:answer/id #uuid "60767b47-bf28-5927-9170-56b9e257c34c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3{x}^{4}-5{x}^{2}+Cx+D" :db/id #edb/ref 17592186251342} {:answer/id #uuid "cc4e1b67-45cb-51ac-a61f-ee18bbb149b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{{x}^{4}}{2}-\\frac{5{x}^{2}}{2}+Cx+D" :db/id #edb/ref 17592186252358} {:answer/id #uuid "f4155827-e220-55c0-a8b5-d48c90df5a62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{{x}^{4}}{2}-4{x}^{2}+Cx+D" :db/id #edb/ref 17592186252693}] :answer-field/correct {:answer/id #uuid "cc4e1b67-45cb-51ac-a61f-ee18bbb149b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{{x}^{4}}{2}-\\frac{5{x}^{2}}{2}+Cx+D" :db/id #edb/ref 17592186252358} :answer-field/id #uuid "aeb1d879-87da-5436-bd2a-6290c0abb0e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253110}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c5323a95-ccb4-5698-8e94-ec2b6a694be3" :question/math-academy-id "q-119043" :question/problem "Solve the differential equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+5=6{x}^{2}.\n$$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=6{x}^{2}-5.\n$$\n\nNow, integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =\\int (6{x}^{2}-5)\\text{d}x \\\\  & =6\\int {x}^{2}\\,\\text{d}x-5\\int \\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =6(\\frac{{x}^{3}}{3})-5x+C \\\\  & =2{x}^{3}-5x+C.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (2{x}^{3}-5x+C)\\text{d}x \\\\ y & =2\\int {x}^{3}\\,\\text{d}x-5\\int x\\,\\text{d}x+C\\int \\text{d}x \\\\  & =2(\\frac{{x}^{4}}{4})-5(\\frac{{x}^{2}}{2})+Cx+D \\\\  & =\\frac{{x}^{4}}{2}-\\frac{5{x}^{2}}{2}+Cx+D.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$"}] [{:db/id #edb/ref 17592186253545 :knowledge-point/_questions [{:db/id #edb/ref 17592186096699 :knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825" :knowledge-point/title "Finding the Solution of a Differential Equation With a Given Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4861751d-591d-55c3-986e-ef2a5b44047f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x-\\frac{{e}^{x/2}}{2}+\\frac{5}{2}" :db/id #edb/ref 17592186251157} {:answer/id #uuid "66412d8c-05ca-5d19-b457-71e9ce3cbc83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{2}+2{e}^{x/2}+2" :db/id #edb/ref 17592186251394} {:answer/id #uuid "73dd9002-7420-57dd-aa1f-4e2c936b2b76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x+{e}^{x/2}+1" :db/id #edb/ref 17592186251508} {:answer/id #uuid "906cd958-b4d4-5e47-8a8a-6773bb3989db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{2}+2{e}^{x/2}" :db/id #edb/ref 17592186251780} {:answer/id #uuid "f2723fb9-3ffe-529a-aa32-10cf5b96b2dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{2}+\\frac{{e}^{x/2}}{2}+\\frac{3}{2}" :db/id #edb/ref 17592186252675}] :answer-field/correct {:answer/id #uuid "906cd958-b4d4-5e47-8a8a-6773bb3989db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{2}+2{e}^{x/2}" :db/id #edb/ref 17592186251780} :answer-field/id #uuid "b2e489f5-5c3c-511b-8803-0c93ae9edf09" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253116}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d5aa7094-d36f-5005-a0c6-3e11c04ef4b9" :question/math-academy-id "q-119083" :question/problem "Find the particular solution to the differential equation ${y}^{′}-2x={e}^{x/2}$ that satisfies the condition $y(0)=2.$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n{y}^{′}=2x+{e}^{x/2}.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int {y}^{′}\\,\\text{d}x & =\\int (2x+{e}^{x/2})\\text{d}x \\\\ y & =2\\int x\\,\\text{d}x+\\int {e}^{x/2}\\,\\text{d}x \\\\  & =2\\cdot \\frac{{x}^{2}}{2}+2{e}^{x/2}+C \\\\  & ={x}^{2}+2{e}^{x/2}+C.\\end{aligned}\n$$\n\nSo our general solution is $y={x}^{2}+2{e}^{x/2}+C.$ To find a particular solution, we substitute the condition $y(0)=2$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}2 & ={0}^{2}+2{e}^{0}+C \\\\ 2 & =0+2(1)+C \\\\ C & =0.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\ny={x}^{2}+2{e}^{x/2}.\n$$"}] [{:db/id #edb/ref 17592186253546 :knowledge-point/_questions [{:db/id #edb/ref 17592186054630 :knowledge-point/id #uuid "3cbddaef-3828-5454-b892-26a3c6242ddb" :knowledge-point/title "Finding All Subsets of a Given Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b4a3183-69f6-5f5d-a9e1-c1e072a1f24c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,\\{x\\},\\{y\\},\\{z\\}\\{x,y,z\\}" :db/id #edb/ref 17592186422817} {:answer/id #uuid "6ff14b5d-188a-55a7-affd-519f5a9ab5e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,\\{x\\},\\{y\\},\\{z\\},\\{x,y\\},\\{x,z\\},\\{y,z\\}" :db/id #edb/ref 17592186422820} {:answer/id #uuid "73b56506-163b-5f00-81f1-df59bf19d5ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,\\{x\\},\\{y\\},\\{z\\}" :db/id #edb/ref 17592186422823} {:answer/id #uuid "8dba51cf-7500-588f-9ddc-13c1238ad685" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,\\{x\\},\\{y\\},\\{z\\},\\{x,y\\},\\{x,z\\},\\{y,z\\},\\{x,y,z\\}" :db/id #edb/ref 17592186422844} {:answer/id #uuid "adaade65-0ace-5c85-9f33-9af310f49494" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{x\\},\\{y\\},\\{z\\}" :db/id #edb/ref 17592186422876}] :answer-field/correct {:answer/id #uuid "8dba51cf-7500-588f-9ddc-13c1238ad685" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,\\{x\\},\\{y\\},\\{z\\},\\{x,y\\},\\{x,z\\},\\{y,z\\},\\{x,y,z\\}" :db/id #edb/ref 17592186422844} :answer-field/id #uuid "94357139-827d-5170-82dc-cc21ec831009" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253065}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4dc7abe5-6826-51d9-82bd-d471faabcb9f" :question/math-academy-id "q-1191" :question/problem "Find all of the subsets of $A=\\{x,y,z\\}.$" :question/worked-solution "To find every subset of $A,$ we list out every combination of elements within $A.$\n\nWe can use the following diagram to visualize the process:\n\n![](images/1d/1d7c11586a8fff5f63d46d936fd32c7b5fbfc33a406ddf268bfdd934fe787cdf.png)\n\nNote that we must include the empty set since it is a subset of every set.\n\nBy doing this, we get\n\n$$\n∅,\\{x\\},\\{y\\},\\{z\\},\\{x,y\\},\\{x,z\\},\\{y,z\\},\\{x,y,z\\}.\n$$"}] [{:db/id #edb/ref 17592186253547 :knowledge-point/_questions [{:db/id #edb/ref 17592186096614 :knowledge-point/id #uuid "83ce3c28-857b-5538-b362-cf52526e3688" :knowledge-point/title "Differentiating a Sum Containing a Natural Logarithm Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26bf5cf8-eaf1-5b10-8d2a-662c31b3b508" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{x}" :db/id #edb/ref 17592186250885} {:answer/id #uuid "783b0f4c-199c-5928-b08e-dcb4df838be4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+\\frac{2}{x}" :db/id #edb/ref 17592186251549} {:answer/id #uuid "89f1e417-01f6-5b82-ba77-84fd142edcc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2x}" :db/id #edb/ref 17592186251714} {:answer/id #uuid "e0afa8a6-a60b-5d30-b8a6-b2c64b3b9e85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+\\frac{1}{x}" :db/id #edb/ref 17592186252532} {:answer/id #uuid "fe2d11d8-637f-5d1f-abb2-68fd4be88574" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+\\frac{1}{x}" :db/id #edb/ref 17592186252782 :task-item/_responses [{:db/id #edb/ref 17592186409245}]}] :answer-field/correct {:answer/id #uuid "fe2d11d8-637f-5d1f-abb2-68fd4be88574" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+\\frac{1}{x}" :db/id #edb/ref 17592186252782} :answer-field/id #uuid "ef06db64-440f-52c2-ab98-0824b44d15d2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253222}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2a7a5557-d240-5298-a285-f0853a897b06" :question/math-academy-id "q-11911" :question/problem "Given that $y=2x+ln⁡x$, find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2x+ln⁡x) \\\\  & =2+\\frac{1}{x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253548 :knowledge-point/_questions [{:db/id #edb/ref 17592186096698 :knowledge-point/id #uuid "23789a74-f1e3-5e26-8678-21f84a11a12b" :knowledge-point/title "Sketching the Solution Curves of a Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ad94dc2-96d1-5f82-a763-87dd2729f0de" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/78/7832a2110292cb364cf06c24eb51e9bb1ee42fe430ac8fcc381af047a09125e4.png" :db/id #edb/ref 17592186250651} {:answer/id #uuid "104071b2-3939-5957-8b0b-115c9954484c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ce/cece096a5b267821994e9b6d8142f0d7ea684bbe8e28da7cdb01b87a73f1db4c.png" :db/id #edb/ref 17592186250695} {:answer/id #uuid "37599f90-3244-5785-b02a-3b8c6636ce9b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/96/96359fe35288b866cbf9fd929e2515af04a4ec0dc565a4cd4af9d3a8fcd20f94.png" :db/id #edb/ref 17592186251006} {:answer/id #uuid "56cfa623-a5a2-5b84-a1b7-c443f45bdc6e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d7/d7ecaa30c600519d6bfcc7a43a4275a55d6f6cc1b52b48c8e7b117e7a772343e.png" :db/id #edb/ref 17592186251263} {:answer/id #uuid "a29f2347-9127-52fe-8d0d-29d70ef13664" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8e/8ede6d26a62570f4037ecc58c377e95389ab00dbee36b60c46e6fb2021e01cea.png" :db/id #edb/ref 17592186251955}] :answer-field/correct {:answer/id #uuid "56cfa623-a5a2-5b84-a1b7-c443f45bdc6e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d7/d7ecaa30c600519d6bfcc7a43a4275a55d6f6cc1b52b48c8e7b117e7a772343e.png" :db/id #edb/ref 17592186251263} :answer-field/id #uuid "56370ecd-d3f8-58ef-b871-fb4e753f3b83" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252955}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0b17887e-edc7-5942-b62d-5bad58805bd8" :question/math-academy-id "q-119132" :question/problem "Which of the following shows some of the solution curves of the differential equation $\\frac{\\text{d}y}{\\text{d}x}=\\frac{{e}^{-x/4}}{2}?$" :question/worked-solution "Integrating the equation, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\frac{{e}^{-x/4}}{2}\\,\\text{d}x \\\\ y & =\\frac{1}{2}\\int {e}^{-x/4}\\,\\text{d}x \\\\  & =\\frac{1}{2}(-4{e}^{-x/4}) \\\\  & =-2{e}^{-x/4}+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=0,3,6.$\n\n![](images/a4/a4b534bd33daabc94aa3c86935b1fd4c0be723fafbc418ed382716541a864293.png)"}] [{:db/id #edb/ref 17592186386903 :knowledge-point/_questions [{:db/id #edb/ref 17592186096698 :knowledge-point/id #uuid "23789a74-f1e3-5e26-8678-21f84a11a12b" :knowledge-point/title "Sketching the Solution Curves of a Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cdbca57f-16aa-507a-9243-fc5de6668bda" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/4a/4acfee397d2c301aa7d005c8467319969bdfe1a487c284e51024a1851ef8a2e3.png" :db/id #edb/ref 17592186386905} {:answer/id #uuid "0e615e5e-edb5-5cf5-9379-57b9b7c05caa" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0e/0e2d84423e017f6d126ef6b997a50d62a7de30f91c24aa64f2525ce4ae33cdd3.png" :db/id #edb/ref 17592186386906} {:answer/id #uuid "da6e7a98-d892-56d4-877b-036894b8ae90" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/14/146aa5565c845f3fbfa66e6c215224236869199844cdbe51f2671c781b1c3705.png" :db/id #edb/ref 17592186386907} {:answer/id #uuid "35676c31-bad6-527d-8d41-0491046fbe5f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3e/3e93190f38d95bd30749fbd1342812c93f593a1d78243f810a3822d5d30eff82.png" :db/id #edb/ref 17592186386908} {:answer/id #uuid "c70ce449-3435-5f49-bbc8-8c5d5d34005e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/55/557708220ba3876b0ae9dbf1d265d11e8d98cf1102ad084d93419543ede35c4b.png" :db/id #edb/ref 17592186386909}] :answer-field/correct {:answer/id #uuid "da6e7a98-d892-56d4-877b-036894b8ae90" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/14/146aa5565c845f3fbfa66e6c215224236869199844cdbe51f2671c781b1c3705.png" :db/id #edb/ref 17592186386907} :answer-field/id #uuid "5dd2a4ff-6ada-5a27-9174-b3c1a697aa04" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386904}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "06acaa38-08e2-563c-a31d-7a927dbf62a2" :question/math-academy-id "q-119139" :question/problem "Which of the following shows some of the solution curves of the differential equation $\\frac{\\text{d}y}{\\text{d}x}=-4{e}^{2x}?$" :question/worked-solution "Integrating the equation, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (-4{e}^{2x})\\,\\text{d}x \\\\ y & =-4\\int {e}^{2x}\\,\\text{d}x \\\\  & =-4(\\frac{{e}^{2x}}{2}) \\\\  & =-2{e}^{2x}+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-2,0,2.$\n\n![](images/cc/cc2ee25a85be3ffdb055853f7665bd53d34003a74b96a14bb947bed39b18e83f.png)"}] [{:db/id #edb/ref 17592186386910 :knowledge-point/_questions [{:db/id #edb/ref 17592186096698 :knowledge-point/id #uuid "23789a74-f1e3-5e26-8678-21f84a11a12b" :knowledge-point/title "Sketching the Solution Curves of a Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "641c6f0c-3eaf-561b-8356-41cd00f60ef4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d5/d5f4f2b65878b9c152b5c87e1fac0473f0e76455fc5762ba10f21555d68a60c4.png" :db/id #edb/ref 17592186386912} {:answer/id #uuid "dc9f2778-f343-5bd4-8b1f-ffa35692fd8d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3e/3e475d534a8f090caa9611d865e70a9717969ddc541c55d98200e19031bffe84.png" :db/id #edb/ref 17592186386913} {:answer/id #uuid "21fe63ba-ca2a-5062-b8c9-c489ae9d0da5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a6/a65cbd746c3bb9abe495af168fd7c63e83ecf3d942c5fb478f3d7d312d140b4d.png" :db/id #edb/ref 17592186386914} {:answer/id #uuid "993af450-e9a5-57fb-a473-cf3bc2a14c65" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/95/95b3d8fc43562341f93a2bccbcbe36d2a070a2dd6687606175ab5e9580f86e2f.png" :db/id #edb/ref 17592186386915} {:answer/id #uuid "6f16a9da-248f-5eb6-9d9c-67a9d932876b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0d/0d14e369d621a6c2d06b4db1485ff43f6af4be2014e9d26564c9ca11e9bd38cd.png" :db/id #edb/ref 17592186386916}] :answer-field/correct {:answer/id #uuid "dc9f2778-f343-5bd4-8b1f-ffa35692fd8d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3e/3e475d534a8f090caa9611d865e70a9717969ddc541c55d98200e19031bffe84.png" :db/id #edb/ref 17592186386913} :answer-field/id #uuid "33aa3810-dbfd-5996-9796-56ae579de721" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386911}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a05048db-be50-5d0c-8e66-1eb6eda34260" :question/math-academy-id "q-119142" :question/problem "Which of the following shows some of the solution curves of the differential equation $\\frac{\\text{d}y}{\\text{d}x}=-\\frac{3(x-1)^{2}}{4}?$" :question/worked-solution "Integrating the equation, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (-\\frac{3(x-1)^{2}}{4})\\,\\text{d}x \\\\ y & =-\\frac{3}{4}\\int (x-1)^{2}\\,\\text{d}x \\\\  & =-\\frac{3}{4}(\\frac{(x-1)^{3}}{3}) \\\\  & =-\\frac{(x-1)^{3}}{4}+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-2,0,2.$\n\n![](images/e0/e0ff2e64925dcd8bdf298c47815f6e2982fe6091e1ff5dea042f585c67ef1721.png)"}] [{:db/id #edb/ref 17592186253551 :knowledge-point/_questions [{:db/id #edb/ref 17592186192836 :knowledge-point/id #uuid "a8a8bf54-5523-5eaa-a236-b8931d1c3dba" :knowledge-point/title "Improper Integrals Involving Arctangent Using the Second Result"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "778b9605-56f5-5801-9b37-1afd366faf02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{\\sqrt{3}}" :db/id #edb/ref 17592186251540} {:answer/id #uuid "87ad96d2-dc83-5457-9f3f-9e32968fedd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{3\\sqrt{3}}" :db/id #edb/ref 17592186251698} {:answer/id #uuid "89faada8-0f27-5ebf-91ff-42f76e4798d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186251715} {:answer/id #uuid "8fbcadc7-9fad-5324-82df-926b4ba0aa6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{6}" :db/id #edb/ref 17592186251774} {:answer/id #uuid "926f3fa9-4b12-5f2a-a81c-eccdefd843ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\pi }{2}" :db/id #edb/ref 17592186251807}] :answer-field/correct {:answer/id #uuid "87ad96d2-dc83-5457-9f3f-9e32968fedd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{3\\sqrt{3}}" :db/id #edb/ref 17592186251698} :answer-field/id #uuid "5f340d0e-66a6-54c5-a2ae-f77be864712f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252974}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "72e807f7-837a-5836-9313-38f63281c554" :question/math-academy-id "q-119199" :question/problem "${\\int }_{-\\infty }^{1}\\frac{1}{{u}^{2}+3}\\,\\text{d}u=$" :question/worked-solution "First, let's recall the following result:\n\n$$\n\\int \\frac{1}{{k}^{2}+{x}^{2}}\\,\\text{d}x=\\frac{1}{k}\\operatorname{arctan}⁡(\\frac{x}{k})+C\n$$\n\nWe proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{1}\\frac{1}{{u}^{2}+3}\\,\\text{d}u & ={lim}_{a\\to -\\infty }{\\int }_{a}^{1}\\frac{1}{{u}^{2}+3}\\,\\text{d}u \\\\  & ={lim}_{a\\to -\\infty }{\\int }_{a}^{1}\\frac{1}{{u}^{2}+{(\\sqrt{3})}^{2}}\\,\\text{d}u \\\\  & ={lim}_{a\\to -\\infty }{[\\frac{1}{\\sqrt{3}}\\cdot \\operatorname{arctan}⁡(\\frac{u}{\\sqrt{3}})]}_{a}^{1} \\\\  & =\\frac{1}{\\sqrt{3}}\\cdot {lim}_{a\\to -\\infty }[\\operatorname{arctan}⁡(\\frac{1}{\\sqrt{3}})-\\operatorname{arctan}⁡(\\frac{a}{\\sqrt{3}})] \\\\  & =\\frac{1}{\\sqrt{3}}\\cdot {lim}_{a\\to -\\infty }[\\frac{\\pi }{6}-\\operatorname{arctan}⁡(\\frac{a}{\\sqrt{3}})] \\\\  & =\\frac{\\pi }{6\\sqrt{3}}-\\frac{1}{\\sqrt{3}}\\cdot {lim}_{a\\to -\\infty }[\\operatorname{arctan}⁡(\\frac{a}{\\sqrt{3}})].\\end{aligned}\n$$\n\nNow, recall the end behavior of the function $y=\\operatorname{arctan}⁡(\\frac{x}{\\sqrt{3}}),$ shown in the graph below:\n\n- ${lim}_{x\\to -\\infty }[\\operatorname{arctan}⁡(\\frac{x}{\\sqrt{3}})]=-\\frac{\\pi }{2}$\n\n- ${lim}_{x\\to \\infty }[\\operatorname{arctan}⁡(\\frac{x}{\\sqrt{3}})]=\\frac{\\pi }{2}$\n\n![](images/11/11c74897fe914599a78c5997767bad83d13ddfb1e35ee66622d8880743688bad.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{1}\\frac{1}{{u}^{2}+3}\\,\\text{d}u & =\\frac{\\pi }{6\\sqrt{3}}-\\frac{1}{\\sqrt{3}}\\cdot {lim}_{a\\to -\\infty }[\\operatorname{arctan}⁡(\\frac{a}{\\sqrt{3}})] \\\\  & =\\frac{\\pi }{6\\sqrt{3}}-\\frac{1}{\\sqrt{3}}\\cdot (-\\frac{\\pi }{2}) \\\\  & =\\frac{2\\pi }{3\\sqrt{3}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253566 :knowledge-point/_questions [{:db/id #edb/ref 17592186059669 :knowledge-point/id #uuid "38b450bd-b43a-507c-9bbe-0aaf7a64a3ed" :knowledge-point/title "Finding a Point That Lies on a Transformed Curve Given Another Transformed Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42a70a80-9905-5343-a34c-136a375e25ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-1)" :db/id #edb/ref 17592186251108} {:answer/id #uuid "9d7c8745-888b-5fc6-9d1a-fc1686129698" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,0)" :db/id #edb/ref 17592186251913} {:answer/id #uuid "a8ce837a-8964-565e-9e2d-f825bac56dba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,2)" :db/id #edb/ref 17592186252014} {:answer/id #uuid "d6b4c14b-cbd8-5494-b7e3-3692ec97eb35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,1)" :db/id #edb/ref 17592186252455} {:answer/id #uuid "e0fa8370-7c51-5755-8595-d094b48e3a78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-3)" :db/id #edb/ref 17592186252534}] :answer-field/correct {:answer/id #uuid "9d7c8745-888b-5fc6-9d1a-fc1686129698" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,0)" :db/id #edb/ref 17592186251913} :answer-field/id #uuid "2019c876-575f-5be0-a410-079acd66193f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252863}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4d38949b-9d50-5e0f-bb63-ea8ff36967c0" :question/math-academy-id "q-119308" :question/problem "The point $(2,3)$ lies on the curve $y=f(x)-1.$ Which of the following points **must** lie on $y=-f(x)+4?$" :question/worked-solution "**Method 1**\n\nTo plot $y=-f(x)+4,$ we apply the following steps:\n\n- First, take the graph $y=f(x)-1.$\n\n- Then, we shift the graph vertically by $1$ unit up and get the graph of $y=f(x).$ After this transformation, the point $(2,3)$ will be mapped to the point\n\n$$\n(2,3+1)=(2,4).\n$$\n\n- Next, we reflect the result across the $x$-axis and get the graph of $y=-f(x).$ After this transformation, the point $(2,4)$ will be mapped  to the point\n\n$$\n(2,-(4))=(2,-4).\n$$\n\n- Finally, shift the result vertically by $4$ units up and obtain the graph of $y=-f(x)+4.$ After this transformation, the point $(2,-4)$ will be mapped to the point \n\n$$\n(2,-4+4)=(2,0).\n$$\n\n**Method 2**\n\nSince the point $(2,3)$ lies on the graph of $y=f(x)-1$, we have that \n\n$$\nf(2)-1=3\\,⟹\\,f(2)=4.\n$$\n\nNow consider the graph of $y=-f(x)+4.$ Substituting $x=2$, we get\n\n$$\n\\begin{aligned}y & =-f(2)+4 \\\\  & =-4+4 \\\\  & =0.\\end{aligned}\n$$\n\nTherefore, the point $(2,0)$ must lie on $y=-f(x)+4.$"}] [{:db/id #edb/ref 17592186253574 :knowledge-point/_questions [{:db/id #edb/ref 17592186059641 :knowledge-point/id #uuid "3332b534-bd04-5e86-995e-1e6d691d8e1b" :knowledge-point/title "Simplifying an Expression by Factoring and Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1815e8ee-c289-5f64-9f4d-5df43b4aab39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\theta +1" :db/id #edb/ref 17592186250764} {:answer/id #uuid "25423e87-2e31-52ea-9bed-9680a8ad4d75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186250872} {:answer/id #uuid "380b2f49-3850-505e-a125-48611fc7669a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186251019} {:answer/id #uuid "b6fc9b1c-0a28-54c2-82c9-b8ff1ad7eae4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186252166} {:answer/id #uuid "bb0ddaa2-dc14-5f83-8293-f70b43e52381" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡\\theta +1" :db/id #edb/ref 17592186252200}] :answer-field/correct {:answer/id #uuid "380b2f49-3850-505e-a125-48611fc7669a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186251019} :answer-field/id #uuid "a308e80e-fc90-57c9-9815-5d63c4e60f59" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253090}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1e264613-6b71-5c6c-b1c0-6da9257b1f1a" :question/math-academy-id "q-119371" :question/problem "Simplify the trigonometric expression ${sin}^{3}⁡\\theta +\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta +\\operatorname{sin}⁡\\theta .$" :question/worked-solution "First, we factor the expression:\n\n$$\n{sin}^{3}⁡\\theta +\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta +\\operatorname{sin}⁡\\theta =\\operatorname{sin}⁡\\theta ({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta )+\\operatorname{sin}⁡\\theta \n$$\n\nThen, we use ${sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta =1$ to simplify the expression in the parentheses:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡\\theta ({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta )+\\operatorname{sin}⁡\\theta  & =\\operatorname{sin}⁡\\theta \\cdot 1+\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta +\\operatorname{sin}⁡\\theta  \\\\  & =2\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n{sin}^{3}⁡\\theta +\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta +\\operatorname{sin}⁡\\theta =2\\operatorname{sin}⁡\\theta .\n$$"}] [{:db/id #edb/ref 17592186253577 :knowledge-point/_questions [{:db/id #edb/ref 17592186059642 :knowledge-point/id #uuid "868125f0-22e0-57fc-9620-f3242419a689" :knowledge-point/title "Simplifying a Rational Expression Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08ed664b-fff1-5712-ac2e-5525f9cdacef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡\\theta " :db/id #edb/ref 17592186250634} {:answer/id #uuid "3b69e247-6d23-5ff1-a976-eb6503b80dcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡\\theta +1" :db/id #edb/ref 17592186251045} {:answer/id #uuid "58c39cbe-5a9b-575c-ae8a-d7f92d34e4dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{cot}⁡\\theta " :db/id #edb/ref 17592186251282} {:answer/id #uuid "923c3e09-f2e0-5124-82ce-83280737e8aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{cot}⁡\\theta " :db/id #edb/ref 17592186251804} {:answer/id #uuid "b061ebd1-c842-5f84-80fa-eec468f6b43d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡\\theta -1" :db/id #edb/ref 17592186252093}] :answer-field/correct {:answer/id #uuid "08ed664b-fff1-5712-ac2e-5525f9cdacef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡\\theta " :db/id #edb/ref 17592186250634} :answer-field/id #uuid "89a2bbe3-2ba2-5a56-9f75-7bcd2efd08bd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253041}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e604df29-4056-5a18-af72-ee9756feedd1" :question/math-academy-id "q-119387" :question/problem "$\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{5}⁡\\theta +{sin}^{3}⁡\\theta {cos}^{2}⁡\\theta }=$" :question/worked-solution "First, we factor the denominator:\n\n$$\n\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{5}⁡\\theta +{sin}^{3}⁡\\theta {cos}^{2}⁡\\theta }=\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{3}⁡\\theta \\cdot ({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta )}\n$$\n\nNext, we use the Pythagorean identity to rewrite the expression in the parentheses, and then we simplify the resulting expression as much as possible.\n\n$$\n\\begin{aligned}\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{3}⁡\\theta \\cdot ({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta )} & =\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{3}⁡\\theta \\cdot 1} \\\\  & =\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{3}⁡\\theta } \\\\  & =\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{2}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta } \\\\  & =\\frac{\\cancel{{sin}^{2}⁡\\theta }\\operatorname{cos}⁡\\theta }{\\cancel{{sin}^{2}⁡\\theta }\\cdot \\operatorname{sin}⁡\\theta } \\\\  & =\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta } \\\\  & =\\operatorname{cot}⁡\\theta \\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{5}⁡\\theta +{sin}^{3}⁡\\theta {cos}^{2}⁡\\theta }=\\operatorname{cot}⁡\\theta .\n$$"}] [{:db/id #edb/ref 17592186253578 :knowledge-point/_questions [{:db/id #edb/ref 17592186059642 :knowledge-point/id #uuid "868125f0-22e0-57fc-9620-f3242419a689" :knowledge-point/title "Simplifying a Rational Expression Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "103f5b2e-5c31-5097-a363-9f6afaafdbb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡x+\\operatorname{csc}⁡x" :db/id #edb/ref 17592186250694} {:answer/id #uuid "4b13d84e-fa74-5321-92fd-9d3ab8999d20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡x+{sec}^{2}⁡x" :db/id #edb/ref 17592186251178} {:answer/id #uuid "53ddef33-f78b-53ce-9fde-d6f939e3fb9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡x+{csc}^{2}⁡x" :db/id #edb/ref 17592186251239} {:answer/id #uuid "a784c34d-c4aa-591d-a102-942798280f5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡x+{sec}^{2}⁡x" :db/id #edb/ref 17592186251996} {:answer/id #uuid "da6b22ed-a42d-50cf-92ea-c1fdfd820128" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡x+\\operatorname{csc}⁡x" :db/id #edb/ref 17592186252472}] :answer-field/correct {:answer/id #uuid "53ddef33-f78b-53ce-9fde-d6f939e3fb9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡x+{csc}^{2}⁡x" :db/id #edb/ref 17592186251239} :answer-field/id #uuid "f15dbfd9-4666-5a0a-a3af-8408df3d5a73" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253227}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c41ec619-a5e7-5d9c-af90-cb7a886021e8" :question/math-academy-id "q-119392" :question/problem "Simplify the trigonometric expression $\\frac{\\operatorname{cos}⁡x{sin}^{3}⁡x+\\operatorname{sin}⁡x{cos}^{3}⁡x+1}{{sin}^{2}⁡x}.$" :question/worked-solution "First, we factor $\\operatorname{cos}⁡x\\operatorname{sin}⁡x$ from the first two terms of the numerator:\n\n$$\n\\frac{\\operatorname{cos}⁡x{sin}^{3}⁡x+\\operatorname{sin}⁡x{cos}^{3}⁡x+1}{{sin}^{2}⁡x}=\\frac{\\operatorname{cos}⁡x\\operatorname{sin}⁡x({sin}^{2}⁡x+{cos}^{2}⁡x)+1}{{sin}^{2}⁡x}\n$$\n\nNext, we use the Pythagorean identity to rewrite the expression in the parentheses, and then we simplify the resulting expression as much as possible:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{cos}⁡x\\operatorname{sin}⁡x({sin}^{2}⁡x+{cos}^{2}⁡x)+1}{{sin}^{2}⁡x} & =\\frac{\\operatorname{cos}⁡x\\operatorname{sin}⁡x\\cdot 1+1}{{sin}^{2}⁡x} \\\\  & =\\frac{\\operatorname{cos}⁡x\\operatorname{sin}⁡x+1}{{sin}^{2}⁡x} \\\\  & =\\frac{\\operatorname{cos}⁡x\\operatorname{sin}⁡x}{{sin}^{2}⁡x}+\\frac{1}{{sin}^{2}⁡x} \\\\  & =\\frac{\\operatorname{cos}⁡x\\operatorname{sin}⁡x}{\\operatorname{sin}⁡x\\cdot \\operatorname{sin}⁡x}+\\frac{1}{{sin}^{2}⁡x} \\\\  & =\\frac{\\operatorname{cos}⁡x\\cancel{\\operatorname{sin}⁡x}}{\\cancel{\\operatorname{sin}⁡x}\\cdot \\operatorname{sin}⁡x}+\\frac{1}{{sin}^{2}⁡x} \\\\  & =\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}+{(\\frac{1}{\\operatorname{sin}⁡x})}^{2} \\\\  & =\\operatorname{cot}⁡x+{csc}^{2}⁡x\\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n\\frac{\\operatorname{cos}⁡x{sin}^{3}⁡x+\\operatorname{sin}⁡x{cos}^{3}⁡x+1}{{sin}^{2}⁡x}=\\operatorname{cot}⁡x+{csc}^{2}⁡x.\n$$"}] [{:db/id #edb/ref 17592186253579 :knowledge-point/_questions [{:db/id #edb/ref 17592186124512 :knowledge-point/id #uuid "e73b8bcf-79c2-5326-b396-d7d3e06badaa" :knowledge-point/title "Identifying the Standard Matrix of a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17680857-523a-56e1-8420-c08210489de4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186250760} {:answer/id #uuid "1b2349f9-546b-554c-b41a-858b240c556b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 3 \\\\ 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186250785} {:answer/id #uuid "63dd99ab-fead-531a-9761-7733e0bb2f2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 3 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186251368} {:answer/id #uuid "87876316-f8ab-5e4e-adf4-44606bad247e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 3 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186251693} {:answer/id #uuid "dd4a9ee1-81a3-52f3-91aa-ac10ad95cfc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 3 \\\\ -1 & 1\\end{aligned}]" :db/id #edb/ref 17592186252503}] :answer-field/correct {:answer/id #uuid "63dd99ab-fead-531a-9761-7733e0bb2f2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 3 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186251368} :answer-field/id #uuid "7c78b755-d795-5ba9-92eb-1cb1d5ff8158" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253020}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0145758b-88e9-57c3-9578-3a41888f61e8" :question/math-academy-id "q-11945" :question/problem "Find the standard matrix that  represents  the  linear  transformation $T$, where\n\n$$\nT:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}2x+3y \\\\ y\\end{aligned}].\n$$" :question/worked-solution "We require a $2\\times 2$ matrix $T$ such that\n    \n\n$$\nT\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}2\\cdot x+3\\cdot y \\\\ 0\\cdot x+1\\cdot y\\end{aligned}].\n$$\n\nNotice that\n    \n\n$$\n[\\begin{aligned}2 & 3 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}2x+3y \\\\ y\\end{aligned}].\n$$\n\n    Therefore, the matrix which represents the linear transformation $T$ is\n    \n\n$$\n[\\begin{aligned}2 & 3 \\\\ 0 & 1\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186253581 :knowledge-point/_questions [{:db/id #edb/ref 17592186059666 :knowledge-point/id #uuid "283415d8-47d7-5d42-8836-0c0b0c4efc85" :knowledge-point/title "Finding Exact Values Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33c614c8-e574-54c4-afe7-ea7cbe93a089" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}-\\sqrt{6}}{4}" :db/id #edb/ref 17592186250984} {:answer/id #uuid "82138ae6-184b-5b43-9d31-1dafcb47b464" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}+\\sqrt{6}}{4}" :db/id #edb/ref 17592186251649} {:answer/id #uuid "866785b4-4b0d-5ed0-ab10-df319b0d8757" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}-\\sqrt{6}}{4}" :db/id #edb/ref 17592186251680} {:answer/id #uuid "cb17904f-e9e2-5ce4-ac6b-159a7742e47c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}+\\sqrt{6}}{4}" :db/id #edb/ref 17592186252351} {:answer/id #uuid "f85fd59f-f673-55d7-9727-39ba21278ce9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}+\\sqrt{6}}{4}" :db/id #edb/ref 17592186252727}] :answer-field/correct {:answer/id #uuid "82138ae6-184b-5b43-9d31-1dafcb47b464" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}+\\sqrt{6}}{4}" :db/id #edb/ref 17592186251649} :answer-field/id #uuid "307233f6-b9b3-54e3-9937-9c7b41e5ed35" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252888}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9b9e46d2-105c-587e-ad59-8da071cc7eea" :question/math-academy-id "q-119479" :question/problem "Find the exact value of  $\\operatorname{cos}⁡{195}^{∘}.$\n\n*Hint: Use the fact that ${195}^{∘}={135}^{∘}+{60}^{∘}.$*" :question/worked-solution "Recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(x+y)=\\operatorname{cos}⁡x\\operatorname{cos}⁡y-\\operatorname{sin}⁡x\\operatorname{sin}⁡y\n$$\n\nApplying the sum formula for cosine with $x={135}^{∘}$ and $y={60}^{∘}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡({195}^{∘}) & =\\operatorname{cos}⁡({135}^{∘}+{60}^{∘}) \\\\  & =\\operatorname{cos}⁡{135}^{∘}\\operatorname{cos}⁡{60}^{∘}-\\operatorname{sin}⁡{135}^{∘}\\operatorname{sin}⁡{60}^{∘} \\\\  & =(-\\frac{\\sqrt{2}}{2})\\cdot \\frac{1}{2}-\\frac{\\sqrt{2}}{2}\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =-\\frac{\\sqrt{2}}{4}-\\frac{\\sqrt{6}}{4} \\\\  & =-\\frac{\\sqrt{2}+\\sqrt{6}}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253582 :knowledge-point/_questions [{:db/id #edb/ref 17592186059821 :knowledge-point/id #uuid "c6a58962-cb06-519a-8c64-0dfa3b9c14d7" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "046c3fff-e187-5d6d-817c-fcad26542595" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\operatorname{cos}⁡x+\\sqrt{3}\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186250586} {:answer/id #uuid "4206c502-18de-5733-a8cd-4790cc23f4b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186251105} {:answer/id #uuid "459effbf-a2af-5f96-b9e0-38a98c849e15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186251129} {:answer/id #uuid "6c93157b-2ac8-5521-831f-507d005bc1c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186251447} {:answer/id #uuid "7d8d63a7-52ee-5a72-956d-4feb52257b50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186251603}] :answer-field/correct {:answer/id #uuid "4206c502-18de-5733-a8cd-4790cc23f4b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186251105} :answer-field/id #uuid "af98a692-a950-5516-913c-d1527e2c4e36" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253111}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "24fefd74-9f51-579d-ab19-a20613b6de76" :question/math-academy-id "q-119482" :question/problem "$\\operatorname{cos}⁡(x-{30}^{∘})=$" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for cosine with $u=x$ and $v={30}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x-{30}^{∘}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡{30}^{∘}+\\operatorname{sin}⁡x\\operatorname{sin}⁡{30}^{∘} \\\\  & =\\operatorname{cos}⁡x\\cdot \\frac{\\sqrt{3}}{2}+\\operatorname{sin}⁡x\\cdot \\frac{1}{2} \\\\  & =\\frac{1}{2}(\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253590 :knowledge-point/_questions [{:db/id #edb/ref 17592186096622 :knowledge-point/id #uuid "af269509-92c0-5a82-b828-e8626f8e8eda" :knowledge-point/title "Differentiating a Quotient Using Leibniz Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b89321c-e3ba-5c4f-81cd-a7cbf23d72d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{{(9-2x)}^{2}}" :db/id #edb/ref 17592186250653} {:answer/id #uuid "0fbd81fe-3865-51f1-85e7-89c40d3f7b84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{{(9-2x)}^{2}}" :db/id #edb/ref 17592186250690} {:answer/id #uuid "3a22468e-a8b9-5374-a6b1-4af81ef69538" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4x-9}{{(9-2x)}^{2}}" :db/id #edb/ref 17592186251034} {:answer/id #uuid "bd9f93f8-6285-5333-9fbc-0e76b0bb68f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2x-9}{{(9-2x)}^{2}}" :db/id #edb/ref 17592186252231} {:answer/id #uuid "e86a868c-0137-5698-8032-3302efc36e18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4x-9}{{(9-2x)}^{2}}" :db/id #edb/ref 17592186252584}] :answer-field/correct {:answer/id #uuid "0fbd81fe-3865-51f1-85e7-89c40d3f7b84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{{(9-2x)}^{2}}" :db/id #edb/ref 17592186250690} :answer-field/id #uuid "05c220dd-0a63-5428-9d3d-76e098f2cb6c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252820}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4ae64d20-c5b4-50bb-94bc-ab5da04017e1" :question/math-academy-id "q-11969" :question/problem "Given that $y=\\frac{-x}{9-2x}$, find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "Let $u=-x$ and $v=9-2x.$ Then\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =-1\\,\\text{and}\\,\\frac{\\text{d}v}{\\text{d}x}=-2.\\end{aligned}\n$$\n\nUsing the quotient rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{v\\frac{\\text{d}u}{\\text{d}x}-u\\frac{\\text{d}v}{\\text{d}x}}{{v}^{2}} \\\\  & =\\frac{(9-2x)\\cdot (-1)-(-x)\\cdot (-2)}{{(9-2x)}^{2}} \\\\  & =\\frac{-9+2x-2x}{{(9-2x)}^{2}} \\\\  & =-\\frac{9}{{(9-2x)}^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186097026 :knowledge-point/_questions [{:db/id #edb/ref 17592186096844 :knowledge-point/id #uuid "261910cd-a1a4-5c90-8caa-238208558458" :knowledge-point/title "Calculating a Derivative Using the Chain and Quotient Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39a5acaf-0b97-5eec-b5dc-80f14127936e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6x}{{(3x+5)}^{3}}" :db/id #edb/ref 17592186251028} {:answer/id #uuid "5fc87138-62df-5eac-9d34-752a109148de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{{(3x+5)}^{4}}" :db/id #edb/ref 17592186251338} {:answer/id #uuid "794835b2-c8d2-5e60-99aa-d141cf6639aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{30x}{{(3x+5)}^{3}}" :db/id #edb/ref 17592186251559} {:answer/id #uuid "80538af1-96e8-546c-8e04-53ab4e77cd46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x}{{(3x+5)}^{4}}" :db/id #edb/ref 17592186251634} {:answer/id #uuid "e543d792-894d-58ae-966d-434f788becaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5x}{{(3x+5)}^{4}}" :db/id #edb/ref 17592186252560}] :answer-field/correct {:answer/id #uuid "794835b2-c8d2-5e60-99aa-d141cf6639aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{30x}{{(3x+5)}^{3}}" :db/id #edb/ref 17592186251559} :answer-field/id #uuid "dcc00428-34a0-5c80-bcd3-256eb4ce28ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253182}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4603accf-ccdb-5030-90b8-c9b568c4df0b" :question/math-academy-id "q-11973" :question/problem "Given that $y=\\frac{3{x}^{2}}{(3x+5)^{2}}$, find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "We use the quotient rule with the numerator $u(x)=3{x}^{2}$ and the denominator $v(x)=(3x+5)^{2}.$ \n\nDifferentiating $u(x)$ and $v(x),$ we have\n\n$$\n{u}^{′}(x)=6x,\\,{v}^{′}(x)=6(3x+5).\n$$\n\nNote that we used the chain rule to differentiate $v.$\n\nNow, applying the quotient rule and simplifying, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(6x){(3x+5)}^{2}-(3{x}^{2})\\cdot 6(3x+5)}{{((3x+5)^{2})}^{2}} \\\\  & =\\frac{6x(3x+5)(3x+5-3x)}{{(3x+5)}^{4}} \\\\  & =\\frac{6x(3x+5)(5)}{{(3x+5)}^{4}} \\\\  & =\\frac{30x}{{(3x+5)}^{3}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253599 :knowledge-point/_questions [{:db/id #edb/ref 17592186059643 :knowledge-point/id #uuid "1bc8c875-3393-5fd6-90cf-87737e16f2f2" :knowledge-point/title "Simplifying a Trigonometric Expression Using a Common Denominator and the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55eb6103-d65c-564e-8146-1b697fcf6114" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x+1" :db/id #edb/ref 17592186251257} {:answer/id #uuid "9c494cc4-f14a-523f-afab-b55ead4e2206" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186251902} {:answer/id #uuid "9cabf4a9-d334-52aa-94a3-29c1226a338c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186251905} {:answer/id #uuid "ac59de0c-94ce-555a-a9af-0f345fa9844c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186252052} {:answer/id #uuid "cdfac5b4-b918-541c-bab0-02afa81cd836" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x" :db/id #edb/ref 17592186252374}] :answer-field/correct {:answer/id #uuid "ac59de0c-94ce-555a-a9af-0f345fa9844c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186252052} :answer-field/id #uuid "5889b846-4b45-54d4-a4c7-1acb0782d3ec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252962}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8a4d16bb-7544-56af-8e64-b1dbb3f56d7c" :question/math-academy-id "q-119770" :question/problem "Simplify the trigonometric expression $\\frac{{cos}^{2}⁡x}{1+\\operatorname{sin}⁡x}+\\operatorname{sin}⁡x.$" :question/worked-solution "We put both terms over a common denominator, and combine the two fractions:\n\n$$\n\\begin{aligned}\\frac{{cos}^{2}⁡x}{1+\\operatorname{sin}⁡x}+\\operatorname{sin}⁡x & =\\frac{{cos}^{2}⁡x}{1+\\operatorname{sin}⁡x}+\\frac{\\operatorname{sin}⁡x}{1} \\\\  & =\\frac{{cos}^{2}⁡x}{1+\\operatorname{sin}⁡x}+\\frac{\\operatorname{sin}⁡x(1+\\operatorname{sin}⁡x)}{1(1+\\operatorname{sin}⁡x)} \\\\  & =\\frac{{cos}^{2}⁡x+\\operatorname{sin}⁡x(1+\\operatorname{sin}⁡x)}{1+\\operatorname{sin}⁡x}\\end{aligned}\n$$\n\nFinally, we simplify using the Pythagorean identity, as follows:\n\n$$\n\\begin{aligned}\\frac{{cos}^{2}⁡x+\\operatorname{sin}⁡x(1+\\operatorname{sin}⁡x)}{1+\\operatorname{sin}⁡x} & =\\frac{{cos}^{2}⁡x+\\operatorname{sin}⁡x+{sin}^{2}⁡x}{1+\\operatorname{sin}⁡x} \\\\  & =\\frac{({sin}^{2}⁡x+{cos}^{2}⁡x)+\\operatorname{sin}⁡x}{1+\\operatorname{sin}⁡x} \\\\  & =\\frac{1+\\operatorname{sin}⁡x}{1+\\operatorname{sin}⁡x} \\\\  & =1\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{{cos}^{2}⁡x}{2+\\operatorname{sin}⁡x}+\\operatorname{sin}⁡x=1.\n$$"}] [{:db/id #edb/ref 17592186253603 :knowledge-point/_questions [{:db/id #edb/ref 17592186096844 :knowledge-point/id #uuid "261910cd-a1a4-5c90-8caa-238208558458" :knowledge-point/title "Calculating a Derivative Using the Chain and Quotient Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "010ec989-6a70-5560-8c6d-96bcabcf07f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(1-x)^{2}}{{({x}^{2}+1)}^{2}}" :db/id #edb/ref 17592186250561} {:answer/id #uuid "185de746-f2a2-5bc0-a895-8eef91887f33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(x+1)}{{({x}^{2}+1)}^{2}}" :db/id #edb/ref 17592186250767} {:answer/id #uuid "5cf0aeab-facc-582b-9a39-b2c196aead5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(1-{x}^{2})}{{({x}^{2}+1)}^{2}}" :db/id #edb/ref 17592186251320} {:answer/id #uuid "c4f44c2b-b5c6-5adc-a37b-c3386048fc4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(1-x)}{{({x}^{2}+1)}^{2}}" :db/id #edb/ref 17592186252297} {:answer/id #uuid "e2b8be0a-88c7-5856-ade3-8586c358ec8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(1-2{x}^{2})}{{({x}^{2}+1)}^{2}}" :db/id #edb/ref 17592186252547}] :answer-field/correct {:answer/id #uuid "5cf0aeab-facc-582b-9a39-b2c196aead5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(1-{x}^{2})}{{({x}^{2}+1)}^{2}}" :db/id #edb/ref 17592186251320} :answer-field/id #uuid "910e876b-71ca-514d-ad43-ceb4c9229334" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253056}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3000a138-321d-511f-bb2f-c25bd88c5e97" :question/math-academy-id "q-11978" :question/problem "Given that $y=\\frac{(x+1)^{2}}{{x}^{2}+1},$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "We use the quotient rule with the numerator $u(x)=(x+1)^{2}$ and the denominator $v(x)={x}^{2}+1.$ \n\nDifferentiating $u(x)$ and $v(x),$ we have\n\n$$\n{u}^{′}(x)=2(x+1),\\,{v}^{′}(x)=2x.\n$$\n\nNote that we used the chain rule to differentiate $u.$\n\nNow, applying the quotient rule and simplifying, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(2(x+1))({x}^{2}+1)-((x+1)^{2})(2x)}{({x}^{2}+1)^{2}} \\\\  & =\\frac{2(x+1)({x}^{2}+1)-2x(x+1)^{2}}{({x}^{2}+1)^{2}} \\\\  & =\\frac{2(x+1)(({x}^{2}+1)-x(x+1))}{({x}^{2}+1)^{2}} \\\\  & =\\frac{2(x+1)({x}^{2}+1-{x}^{2}-x)}{({x}^{2}+1)^{2}} \\\\  & =\\frac{2(x+1)(1-x)}{({x}^{2}+1)^{2}} \\\\  & =\\frac{2(1-{x}^{2})}{({x}^{2}+1)^{2}}.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253617 :knowledge-point/_questions [{:db/id #edb/ref 17592186059652 :knowledge-point/id #uuid "b05f4be1-95d4-5137-bbaa-71c95862bb59" :knowledge-point/title "Simplifying Expressions by Factoring an Alternate Form of the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00677872-7616-5c6b-bc06-e85a41bca0b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+1" :db/id #edb/ref 17592186250553} {:answer/id #uuid "60dff4f9-0626-5330-99dd-f03bb2eb6f7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186251345} {:answer/id #uuid "a43f7607-4390-56c0-ba26-6beaa6359216" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186251971} {:answer/id #uuid "bbc2c36b-5bb0-5f2e-8ad7-e904eb5d214b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-(1+\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186252208} {:answer/id #uuid "bc732a44-7bfc-58d9-95fa-404ba29a3bd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x-1" :db/id #edb/ref 17592186252217}] :answer-field/correct {:answer/id #uuid "bbc2c36b-5bb0-5f2e-8ad7-e904eb5d214b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-(1+\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186252208} :answer-field/id #uuid "68996742-5572-5673-a555-2490c8c236c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252995}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a1b437a5-869a-5ccd-aeb4-884c52b20f38" :question/math-academy-id "q-119864" :question/problem "Simplify the expression $\\frac{{cos}^{2}⁡x}{\\operatorname{sin}⁡x-1}.$" :question/worked-solution "First, we rewrite the numerator using $1-{sin}^{2}⁡x={cos}^{2}⁡x.$\n\n$$\n\\frac{{cos}^{2}⁡x}{\\operatorname{sin}⁡x-1}=\\frac{1-{sin}^{2}⁡x}{\\operatorname{sin}⁡x-1}\n$$\n\nNext, we factor the numerator as a difference of squares, and simplify:\n\n$$\n\\begin{aligned}\\frac{1-{sin}^{2}⁡x}{\\operatorname{sin}⁡x-1} & =\\frac{(1+\\operatorname{sin}⁡x)(1-\\operatorname{sin}⁡x)}{\\operatorname{sin}⁡x-1} \\\\  & =-\\frac{(1+\\operatorname{sin}⁡x)(1-\\operatorname{sin}⁡x)}{1-\\operatorname{sin}⁡x} \\\\  & =-\\frac{(1+\\operatorname{sin}⁡x)\\cancel{(1-\\operatorname{sin}⁡x)}}{\\cancel{1-\\operatorname{sin}⁡x}} \\\\  & =-\\frac{1+\\operatorname{sin}⁡x}{1} \\\\  & =-(1+\\operatorname{sin}⁡x)\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{{cos}^{2}⁡x}{\\operatorname{sin}⁡x-1}=-(1+\\operatorname{sin}⁡x).\n$$"}] [{:db/id #edb/ref 17592186253621 :knowledge-point/_questions [{:db/id #edb/ref 17592186110560 :knowledge-point/id #uuid "35fe6748-f040-5318-84e0-f3f76c9c7250" :knowledge-point/title "Simplifying an Expression Using the Cotangent-Cosecant Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27f0a8ce-4aec-512b-a809-fe80d7a37254" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡z+2" :db/id #edb/ref 17592186250896} {:answer/id #uuid "383e056a-7d1a-580d-8144-5ce601bf73a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-2{cot}^{2}⁡z" :db/id #edb/ref 17592186251020} {:answer/id #uuid "449a0196-c334-57cc-9c6b-f43d1c3715ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{cot}^{2}⁡z" :db/id #edb/ref 17592186251123} {:answer/id #uuid "978b01e0-91fd-53a4-93a7-f12af31fb3e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cot}^{2}⁡z" :db/id #edb/ref 17592186251854} {:answer/id #uuid "d552fd33-bdd6-5221-8186-0acd1c018978" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{cot}^{2}⁡z" :db/id #edb/ref 17592186252441}] :answer-field/correct {:answer/id #uuid "978b01e0-91fd-53a4-93a7-f12af31fb3e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cot}^{2}⁡z" :db/id #edb/ref 17592186251854} :answer-field/id #uuid "f3ef446b-20ba-56ee-b042-97aed74369c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253233}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d3d698d1-fddf-50d2-9b5a-51d1e576d1b5" :question/math-academy-id "q-119904" :question/problem "Simplify ${cos}^{2}⁡z\\,({cot}^{2}⁡z+1).$" :question/worked-solution "Using the identity $1+{cot}^{2}⁡z={csc}^{2}⁡z,$ we rewrite and simplify the expression as follows:\n\n$$\n\\begin{aligned}{cos}^{2}⁡z\\,({cot}^{2}⁡z+1) & ={cos}^{2}⁡z\\cdot {csc}^{2}⁡z \\\\  & ={cos}^{2}⁡z\\cdot {(\\frac{1}{\\operatorname{sin}⁡z})}^{2} \\\\  & ={cos}^{2}⁡z\\cdot \\frac{1}{{sin}^{2}⁡z} \\\\  & =\\frac{{cos}^{2}⁡z}{{sin}^{2}⁡z} \\\\  & ={(\\frac{\\operatorname{cos}⁡z}{\\operatorname{sin}⁡z})}^{2} \\\\  & ={cot}^{2}⁡z\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253627 :knowledge-point/_questions [{:db/id #edb/ref 17592186059673 :knowledge-point/id #uuid "5f9683d9-05b9-5a42-9f81-0170a15dfac1" :knowledge-point/title "Using the Double-Angle Formula to Simplify Ratios"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0abdcc32-cc35-5670-9c83-c4cbe912eee6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{csc}⁡(\\frac{\\pi }{6})" :db/id #edb/ref 17592186250650} {:answer/id #uuid "57edb35e-9370-5374-9e06-ccc1975123a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sec}⁡(\\frac{\\pi }{6})" :db/id #edb/ref 17592186251271} {:answer/id #uuid "882f41e4-7a0d-5ac6-8538-7f29f7c131ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡(\\frac{\\pi }{6})" :db/id #edb/ref 17592186251701} {:answer/id #uuid "d69eebe4-9936-53c3-8b7b-de492f9722de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sec}⁡(\\frac{\\pi }{6})" :db/id #edb/ref 17592186252454} {:answer/id #uuid "ff3248bd-252a-5193-96ee-ea1bc9f698ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sin}⁡(\\frac{\\pi }{6})" :db/id #edb/ref 17592186252795}] :answer-field/correct {:answer/id #uuid "0abdcc32-cc35-5670-9c83-c4cbe912eee6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{csc}⁡(\\frac{\\pi }{6})" :db/id #edb/ref 17592186250650} :answer-field/id #uuid "cf9019c2-6685-5469-b58a-01ed2b00e34b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253164}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1a84df43-c63e-5997-bb62-0b42cedd5faa" :question/math-academy-id "q-120017" :question/problem "$\\operatorname{cos}⁡(\\frac{\\pi }{6})\\operatorname{csc}⁡(\\frac{\\pi }{3})=$" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n\\operatorname{sin}⁡2x=2\\operatorname{sin}⁡x\\operatorname{cos}⁡x\n$$\n\nSubstituting $x=\\frac{\\pi }{6}$ into the above, we get\n\n$$\n\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{6})=2\\operatorname{sin}⁡(\\frac{\\pi }{6})\\operatorname{cos}⁡(\\frac{\\pi }{6})\n$$\n\nwhich simplifies as\n\n$$\n\\operatorname{sin}⁡(\\frac{\\pi }{3})=2\\operatorname{sin}⁡(\\frac{\\pi }{6})\\operatorname{cos}⁡(\\frac{\\pi }{6}).\n$$\n\nRewriting the given expression using the above, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\frac{\\pi }{6})\\operatorname{csc}⁡(\\frac{\\pi }{3}) & =\\operatorname{cos}⁡(\\frac{\\pi }{6})\\cdot \\frac{1}{\\operatorname{sin}⁡(\\frac{\\pi }{3})} \\\\  & =\\operatorname{cos}⁡(\\frac{\\pi }{6})\\cdot \\frac{1}{2\\operatorname{sin}⁡(\\frac{\\pi }{6})\\operatorname{cos}⁡(\\frac{\\pi }{6})} \\\\  & =\\cancel{\\operatorname{cos}⁡(\\frac{\\pi }{6})}\\cdot \\frac{1}{2\\operatorname{sin}⁡(\\frac{\\pi }{6})\\cancel{\\operatorname{cos}⁡(\\frac{\\pi }{6})}} \\\\  & =\\frac{1}{2\\operatorname{sin}⁡(\\frac{\\pi }{6})} \\\\  & =\\frac{1}{2}\\operatorname{csc}⁡(\\frac{\\pi }{6}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253628 :knowledge-point/_questions [{:db/id #edb/ref 17592186059673 :knowledge-point/id #uuid "5f9683d9-05b9-5a42-9f81-0170a15dfac1" :knowledge-point/title "Using the Double-Angle Formula to Simplify Ratios"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "024f4b95-a6a5-5f2d-a751-2755ac5cce12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡(\\frac{\\pi }{8})" :db/id #edb/ref 17592186250575} {:answer/id #uuid "0e20a623-1450-54d0-9595-8a7aa3109a42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sin}⁡(\\frac{\\pi }{8})" :db/id #edb/ref 17592186250675} {:answer/id #uuid "3a0ea007-0dad-5df4-93e4-28082fff80d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{csc}⁡(\\frac{\\pi }{4})" :db/id #edb/ref 17592186251033} {:answer/id #uuid "8f9f6191-c575-5400-985e-09588bd93769" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡(\\frac{\\pi }{4})" :db/id #edb/ref 17592186251773} {:answer/id #uuid "adab3445-9088-5485-a515-0fc08abd7e3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{csc}⁡(\\frac{\\pi }{8})" :db/id #edb/ref 17592186252067}] :answer-field/correct {:answer/id #uuid "adab3445-9088-5485-a515-0fc08abd7e3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{csc}⁡(\\frac{\\pi }{8})" :db/id #edb/ref 17592186252067} :answer-field/id #uuid "8a4e8fb7-0cf4-569d-9a43-083899802b06" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253044}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "11defe63-9b06-5fba-87b6-5807bf8b34d3" :question/math-academy-id "q-120018" :question/problem "$\\frac{\\operatorname{cos}⁡(\\frac{\\pi }{8})}{\\operatorname{sin}⁡(\\frac{\\pi }{4})}=$" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n\\operatorname{sin}⁡2x=2\\operatorname{sin}⁡x\\operatorname{cos}⁡x\n$$\n\nSubstituting $x=\\frac{\\pi }{8}$ into the above, we get\n\n$$\n\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{8})=2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8})\n$$\n\nwhich simplifies as\n\n$$\n\\operatorname{sin}⁡(\\frac{\\pi }{4})=2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8}).\n$$\n\nTherefore, we can simplify the given expression by rewriting the $\\operatorname{sin}⁡(\\frac{\\pi }{4})$ in the denominator, as follows:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{cos}⁡(\\frac{\\pi }{8})}{\\operatorname{sin}⁡(\\frac{\\pi }{4})} & =\\frac{\\operatorname{cos}⁡(\\frac{\\pi }{8})}{2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8})} \\\\  & =\\frac{\\cancel{\\operatorname{cos}⁡(\\frac{\\pi }{8})}}{2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\cancel{\\operatorname{cos}⁡(\\frac{\\pi }{8})}} \\\\  & =\\frac{1}{2\\operatorname{sin}⁡(\\frac{\\pi }{8})} \\\\  & =\\frac{1}{2}\\operatorname{csc}⁡(\\frac{\\pi }{8}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253632 :knowledge-point/_questions [{:db/id #edb/ref 17592186059673 :knowledge-point/id #uuid "5f9683d9-05b9-5a42-9f81-0170a15dfac1" :knowledge-point/title "Using the Double-Angle Formula to Simplify Ratios"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a1adf34-b5ab-575a-b655-c479f3717df6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+\\operatorname{cos}⁡{50}^{∘}" :db/id #edb/ref 17592186250640} {:answer/id #uuid "199a6b8d-c1b5-52ec-8d2b-338601436874" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{cos}⁡{50}^{∘}" :db/id #edb/ref 17592186250776} {:answer/id #uuid "38546a08-184f-5411-80ea-0b9a2a403009" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡{50}^{∘}-1" :db/id #edb/ref 17592186251022} {:answer/id #uuid "65f52443-c286-5605-b6f6-ab3d3b725230" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cos}^{2}⁡{50}^{∘}" :db/id #edb/ref 17592186251392} {:answer/id #uuid "e2a2c78e-06dc-539e-b4e5-76443acce72b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+{cos}^{2}⁡{50}^{∘}" :db/id #edb/ref 17592186252545}] :answer-field/correct {:answer/id #uuid "0a1adf34-b5ab-575a-b655-c479f3717df6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+\\operatorname{cos}⁡{50}^{∘}" :db/id #edb/ref 17592186250640} :answer-field/id #uuid "c0d401dc-d0fa-51c1-b8e5-f54d86918a91" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253138}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "df53af64-a7fb-5920-a9ae-4765f5d7236c" :question/math-academy-id "q-120029" :question/problem "$\\frac{\\operatorname{sin}⁡{100}^{∘}\\operatorname{tan}⁡{50}^{∘}}{2-2\\operatorname{cos}⁡{50}^{∘}}=$" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n\\operatorname{sin}⁡2x=2\\operatorname{sin}⁡x\\operatorname{cos}⁡x\n$$\n\nSubstituting $x={50}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(2\\cdot {50}^{∘}) & =2\\operatorname{sin}⁡{50}^{∘}\\operatorname{cos}⁡{50}^{∘} \\\\ \\operatorname{sin}⁡({100}^{∘}) & =2\\operatorname{sin}⁡{50}^{∘}\\operatorname{cos}⁡{50}^{∘}.\\end{aligned}\n$$\n\nNow, we can rewrite the given expression using the above, as follows:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡{100}^{∘}\\operatorname{tan}⁡{50}^{∘}}{2-2\\operatorname{cos}⁡{50}^{∘}} & =\\frac{2\\operatorname{sin}⁡{50}^{∘}\\operatorname{cos}⁡{50}^{∘}\\cdot \\frac{\\operatorname{sin}⁡{50}^{∘}}{\\operatorname{cos}⁡{50}^{∘}}}{2-2\\operatorname{cos}⁡{50}^{∘}} \\\\  & =\\frac{2{sin}^{2}⁡{50}^{∘}}{2(1-\\operatorname{cos}⁡{50}^{∘})} \\\\  & =\\frac{{sin}^{2}⁡{50}^{∘}}{1-\\operatorname{cos}⁡{50}^{∘}}\\end{aligned}\n$$\n\nUsing  the Pythagorean identity ${sin}^{2}⁡{50}^{∘}=1-{cos}^{2}⁡{50}^{∘},$ we get\n\n$$\n\\begin{aligned}\\frac{{sin}^{2}⁡{50}^{∘}}{1-\\operatorname{cos}⁡{50}^{∘}} & =\\frac{1-{cos}^{2}⁡{50}^{∘}}{1-\\operatorname{cos}⁡{50}^{∘}} \\\\  & =\\frac{(1-\\operatorname{cos}⁡{50}^{∘})(1+\\operatorname{cos}⁡{50}^{∘})}{1-\\operatorname{cos}⁡{50}^{∘}} \\\\  & =\\frac{\\cancel{(1-\\operatorname{cos}⁡{50}^{∘})}(1+\\operatorname{cos}⁡{50}^{∘})}{\\cancel{1-\\operatorname{cos}⁡{50}^{∘}}} \\\\  & =1+\\operatorname{cos}⁡{50}^{∘}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386973 :knowledge-point/_questions [{:db/id #edb/ref 17592186147618 :knowledge-point/id #uuid "1233be4b-7634-5882-9ae5-3200a9da71d8" :knowledge-point/title "Calculating the Surface Area of a Polyhedron Given the Areas of the Faces: Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27a702ee-79d1-55c6-8b8d-dc8a7f0f77db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "336\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186386975} {:answer/id #uuid "3e5df382-1586-5105-af93-061d2effa30e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "324\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186386976} {:answer/id #uuid "b73a068b-a624-57c6-8f23-a62443cd2759" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "354\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186386977} {:answer/id #uuid "13ab4dd1-997e-50aa-8938-fe73f4c8d489" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "348\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186386978} {:answer/id #uuid "9f5375b8-a182-53a8-881e-1b45a8a8313f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "316\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186386979}] :answer-field/correct {:answer/id #uuid "3e5df382-1586-5105-af93-061d2effa30e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "324\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186386976} :answer-field/id #uuid "0f65bd7f-3d3f-5045-8487-612d7385d46c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386974}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2c2645ff-704d-5d0e-a816-127a2f8fd501" :question/math-academy-id "q-120078" :question/problem "![](images/8b/8b618c8e43dbe898a6e1c481f4f887a50bc2e8c658368876be11ec5ea269a50c.png)\n\nA company produces a chocolate bar that comes in an triangular-prism-shaped box. In the figure, the areas of some of the faces are displayed in a net of the prism. What is the total surface area of the box?" :question/worked-solution "The surface area of our prism consists of $2$ triangles (base and top) and $3$ rectangles (central and side faces). \n\nTherefore, we get\n\n$$\n\\begin{aligned}\\text{Surface area} & =2\\times (\\text{Area of the base})+2\\times (\\text{Area of the side faces}) \\\\  & +1\\times (\\text{Area of the central face}) \\\\  & =2\\times 36+2\\times 72+108 \\\\  & =72+144+108 \\\\  & =324\\,{\\text{cm}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186395991 :knowledge-point/_questions [{:db/id #edb/ref 17592186087746 :knowledge-point/id #uuid "d8c04b23-e341-57e9-a072-985e4b536e5a" :knowledge-point/title "Identifying Linear Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af31ad74-3d71-5216-82f4-241c0fe0d883" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186395993} {:answer/id #uuid "55344227-ef64-559d-b72e-d67580b900d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186395994} {:answer/id #uuid "8c8d3009-744a-5594-85d0-81623acfa040" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186395995} {:answer/id #uuid "1acecbea-2330-5d66-8f7e-c711b7d73ea2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186395996} {:answer/id #uuid "cabd1c0f-3241-5f02-a31b-66428bbc54cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186395997}] :answer-field/correct {:answer/id #uuid "af31ad74-3d71-5216-82f4-241c0fe0d883" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186395993} :answer-field/id #uuid "e3af571d-ad32-5475-bbe0-4ca42f82e8b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395992}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d2b3861b-a381-5b7c-bc56-9232209a631c" :question/math-academy-id "q-12008" :question/problem "Let \n$T:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}x+y \\\\ 4x+3y\\end{aligned}].$\nWhich of the following statements are true?\n\nI. $T(kv)=kT(v)$ for any real $2\\times 1$ column vector $v$ and real scalar $k$\nII. $T({v}_{1}+{v}_{2})=T({v}_{1})+T({v}_{2})$ for any real $2\\times 1$ column vectors ${v}_{1}$ and ${v}_{2}$\nIII. $T$ is a linear transformation" :question/worked-solution "A linear transformation $T$ satisfies two properties:\n\n$$\n\\begin{aligned} & T[\\begin{aligned}kx \\\\ ky\\end{aligned}]=kT[\\begin{aligned}x \\\\ y\\end{aligned}], \\\\  & T[\\begin{aligned}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{aligned}]=T[\\begin{aligned}{x}_{1} \\\\ {y}_{1}\\end{aligned}]+T[\\begin{aligned}{x}_{2} \\\\ {y}_{2}\\end{aligned}].\\end{aligned}\n$$\n\n- Checking the first condition, we have\n\n$$\n\\begin{aligned}T[\\begin{aligned}kx \\\\ ky\\end{aligned}] & =[\\begin{aligned}kx+ky \\\\ 4kx+3ky\\end{aligned}] \\\\  & =k[\\begin{aligned}x+y \\\\ 4x+3y\\end{aligned}] \\\\  & =kT[\\begin{aligned}x \\\\ y\\end{aligned}].\\,✓\\end{aligned}\n$$\n\n- Checking the second condition, we have\n\n$$\n\\begin{aligned}T[\\begin{aligned}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{aligned}] & =[\\begin{aligned}{x}_{1}+{x}_{2}+{y}_{1}+{y}_{2} \\\\ 4({x}_{1}+{x}_{2})+3({y}_{1}+{y}_{2})\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{1}+{y}_{1} \\\\ 4{x}_{1}+3{y}_{1}\\end{aligned}]+[\\begin{aligned}{x}_{2}+{y}_{2} \\\\ 4{x}_{2}+3{y}_{2}\\end{aligned}] \\\\  & =T[\\begin{aligned}{x}_{1} \\\\ {y}_{1}\\end{aligned}]+T[\\begin{aligned}{x}_{2} \\\\ {y}_{2}\\end{aligned}].\\,✓\\end{aligned}\n$$\n\nTherefore, $\\text{T}$ is a linear transformation.\n\nAs a result, all three statements are true."}] [{:db/id #edb/ref 17592186386980 :knowledge-point/_questions [{:db/id #edb/ref 17592186092220 :knowledge-point/id #uuid "c4034e61-63dc-5f72-8275-e9c81290767d" :knowledge-point/title "Identifying the Graph of a Polar Circle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf5bf024-dbf4-5632-a63b-ad467c311d60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta =\\frac{3}{2}" :db/id #edb/ref 17592186386982} {:answer/id #uuid "cdb7051a-7e16-5762-9d1a-14890aa8ba23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=\\frac{1}{3}" :db/id #edb/ref 17592186386983} {:answer/id #uuid "4dcdfefe-5c84-5826-9001-dc7bb6584180" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=\\frac{2}{3}" :db/id #edb/ref 17592186386984} {:answer/id #uuid "a1a259f4-6b6d-5a0c-b9ac-b6e251b05b5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=2" :db/id #edb/ref 17592186386985} {:answer/id #uuid "4b52ab78-d764-5838-8806-470f898532a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta =\\frac{2}{3}" :db/id #edb/ref 17592186386986}] :answer-field/correct {:answer/id #uuid "4dcdfefe-5c84-5826-9001-dc7bb6584180" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=\\frac{2}{3}" :db/id #edb/ref 17592186386984} :answer-field/id #uuid "46ad39ef-5a66-5eb0-98a2-edda8d35005f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386981}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5537c8a8-34b9-543a-94ee-574c0ca59e8d" :question/math-academy-id "q-120156" :question/problem "![](images/41/41260e982c1b7aa023a86ffd48e7ba0819e651a4c928adaffeeb2567b762236a.png)\n\nWhat is the polar equation of the curve shown above?" :question/worked-solution "Notice that the given curve is a circle of radius $\\frac{2}{3}$ centered at the origin.\n\nTherefore, its polar equation is $r=\\frac{2}{3}.$"}] [{:db/id #edb/ref 17592186386987 :knowledge-point/_questions [{:db/id #edb/ref 17592186092220 :knowledge-point/id #uuid "c4034e61-63dc-5f72-8275-e9c81290767d" :knowledge-point/title "Identifying the Grap