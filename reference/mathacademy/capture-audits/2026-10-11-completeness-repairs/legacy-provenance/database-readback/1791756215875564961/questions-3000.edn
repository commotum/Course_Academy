#{[{:db/id #edb/ref 17592186348118 :knowledge-point/_questions [{:db/id #edb/ref 17592186083299 :knowledge-point/id #uuid "223e29c9-1bb5-51ee-9ec8-4d5c15363951" :knowledge-point/title "Finding the Center of a Horizontal Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0703d799-0111-55e4-99f9-70c3eb59a8b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,-1)" :db/id #edb/ref 17592186345414} {:answer/id #uuid "40758a02-7b8c-5d72-ab58-a8d20d28afdf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,-5)" :db/id #edb/ref 17592186345905} {:answer/id #uuid "63992de9-ec6d-51ab-a206-cde915c80422" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,2)" :db/id #edb/ref 17592186346218} {:answer/id #uuid "9eb31ca7-c07d-505f-bbbb-56822f2e4ae5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,1)" :db/id #edb/ref 17592186346736} {:answer/id #uuid "f59b0784-1475-5ee1-bbd4-044ae1258144" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-5,1)" :db/id #edb/ref 17592186347528}] :answer-field/correct {:answer/id #uuid "0703d799-0111-55e4-99f9-70c3eb59a8b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,-1)" :db/id #edb/ref 17592186345414} :answer-field/id #uuid "2f2ac7a2-8856-589e-8887-844636305c61" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347683}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "209d3fb4-3f5a-5f61-958c-85386d790787" :question/math-academy-id "q-78871" :question/problem "What is the center of the hyperbola \n$2{x}^{2}-{y}^{2}-20x-2y=-47?$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}2{x}^{2}-{y}^{2}-20x-2y & =-47 \\\\ 2{x}^{2}-20x-{y}^{2}-2y & =-47 \\\\ 2[{x}^{2}-10x]-[{y}^{2}+2y] & =-47 \\\\ 2[(x-5)^{2}-25]-[(y+1)^{2}-1] & =-47 \\\\ 2(x-5)^{2}-50-(y+1)^{2}+1 & =-47 \\\\ 2(x-5)^{2}-(y+1)^{2} & =-47+50-1 \\\\ 2(x-5)^{2}-(y+1)^{2} & =2 \\\\ (x-5)^{2}-\\frac{(y+1)^{2}}{2} & =1.\\end{aligned}\n$$\n\nTherefore, the center is $(5,-1).$"}] [{:db/id #edb/ref 17592186348119 :knowledge-point/_questions [{:db/id #edb/ref 17592186083299 :knowledge-point/id #uuid "223e29c9-1bb5-51ee-9ec8-4d5c15363951" :knowledge-point/title "Finding the Center of a Horizontal Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "558cb951-da68-57b6-bdec-1037345d90f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,2)" :db/id #edb/ref 17592186346078} {:answer/id #uuid "915d78fa-7fa4-5beb-86b2-889866c152a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,-1)" :db/id #edb/ref 17592186346620} {:answer/id #uuid "9f891de3-ec98-5e85-99d5-5545ab13bfb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,-3)" :db/id #edb/ref 17592186346744} {:answer/id #uuid "a920ce4e-cebb-56de-8697-78a360623691" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-3)" :db/id #edb/ref 17592186346824} {:answer/id #uuid "e68e5f4d-846d-5c89-8067-e9e4ced423a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-2)" :db/id #edb/ref 17592186347385}] :answer-field/correct {:answer/id #uuid "558cb951-da68-57b6-bdec-1037345d90f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,2)" :db/id #edb/ref 17592186346078} :answer-field/id #uuid "9f52d572-44e7-5ab2-8a6e-0c254df7d8ab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347884}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "70880c3d-4012-5cf5-bf26-9498ab363505" :question/math-academy-id "q-78872" :question/problem "What is the center of the hyperbola \n$3{x}^{2}-2{y}^{2}-18x+8y=-13?$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}3{x}^{2}-2{y}^{2}-18x+8y & =-13 \\\\ 3{x}^{2}-18x-2{y}^{2}+8y & =-13 \\\\ 3[{x}^{2}-6x]-2[{y}^{2}-4y] & =-13 \\\\ 3[(x-3)^{2}-9]-2[(y-2)^{2}-4] & =-13 \\\\ 3(x-3)^{2}-27-2(y-2)^{2}+8 & =-13 \\\\ 3(x-3)^{2}-2(y-2)^{2} & =-13+27-8 \\\\ 3(x-3)^{2}-2(y-2)^{2} & =6 \\\\ \\frac{(x-3)^{2}}{2}-\\frac{(y-2)^{2}}{3} & =1.\\end{aligned}\n$$\n\nTherefore, the center is $(3,2).$"}] [{:db/id #edb/ref 17592186348125 :knowledge-point/_questions [{:db/id #edb/ref 17592186096639 :knowledge-point/id #uuid "384ce5b6-40da-59a0-bc87-a1d726328cc2" :knowledge-point/title "Finding the Finite Area Bounded Between a Curve and the Y-Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "688a94f7-68ae-5aea-b884-bdf89550bcc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186346259} {:answer/id #uuid "71e69b0b-7def-5650-8e27-9bb24af7e90a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186346359} {:answer/id #uuid "892e1109-ff79-534d-a849-855beda0ff40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186346541} {:answer/id #uuid "8c9e3d56-23b9-521e-b8ae-895d4452cf16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186346573} {:answer/id #uuid "f0718dd5-540c-5350-bb5b-ba0be70bea46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186347473}] :answer-field/correct {:answer/id #uuid "8c9e3d56-23b9-521e-b8ae-895d4452cf16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186346573} :answer-field/id #uuid "0c72b5e4-f49c-5a8b-a72b-54dbc4394d47" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347629}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e9ab6aec-b415-5906-90bf-de072de6dfbf" :question/math-academy-id "q-78891" :question/problem "![](images/a4/a45999ec28d309b3be249304e9b5175f66f2b862cd7f18f2c51b3182333e9a08.png)\n\nFind the area of the finite region bounded between the curve $x=2\\operatorname{cos}⁡y$ and the $y$-axis, as shown above." :question/worked-solution "First, we find the $y$-intercepts of the curve:\n\n$$\n\\begin{aligned}2\\operatorname{cos}⁡y & =0 \\\\ \\operatorname{cos}⁡y & =0 \\\\ y & =\\pm \\frac{\\pi }{2},\\pm \\frac{3\\pi }{2},…\\end{aligned}\n$$\n\nFrom the diagram, we see that we want to find the area between the curve $x=2\\operatorname{cos}⁡y$ and the $y$-axis from $y=-\\frac{\\pi }{2}$ to $y=\\frac{\\pi }{2}.$ To find the area, we compute the corresponding definite integral, as follows:\n\n$$\n\\begin{aligned}A & ={\\int }_{c}^{d}x(y)\\,\\text{d}y \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}2\\operatorname{cos}⁡y\\,\\text{d}y \\\\  & =2{\\int }_{0}^{\\pi /2}2\\operatorname{cos}⁡y\\,\\text{d}y \\\\  & =4{\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡y\\,\\text{d}y \\\\  & =4\\cdot \\operatorname{sin}⁡y{|}_{0}^{\\pi /2} \\\\  & =4(\\operatorname{sin}⁡(\\frac{\\pi }{2})-\\operatorname{sin}⁡(0)) \\\\  & =4(1-0) \\\\  & =4\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348126 :knowledge-point/_questions [{:db/id #edb/ref 17592186096639 :knowledge-point/id #uuid "384ce5b6-40da-59a0-bc87-a1d726328cc2" :knowledge-point/title "Finding the Finite Area Bounded Between a Curve and the Y-Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5bb82996-b59d-5c66-8ae3-7e85eff61477" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16}{3}" :db/id #edb/ref 17592186346135} {:answer/id #uuid "7e323b44-61d5-5333-974e-57316857f827" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{32}{3}" :db/id #edb/ref 17592186346459} {:answer/id #uuid "8d1e409e-0058-5524-91b4-51d6531acfa7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186346579} {:answer/id #uuid "a4ac7330-677f-5cdd-8873-4abad07eca98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186346785} {:answer/id #uuid "ff927d0d-e42c-593c-a01c-be3b8a497251" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{64}{3}" :db/id #edb/ref 17592186347595}] :answer-field/correct {:answer/id #uuid "5bb82996-b59d-5c66-8ae3-7e85eff61477" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16}{3}" :db/id #edb/ref 17592186346135} :answer-field/id #uuid "7b7de700-b0ca-5b01-8176-1a014422fae4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347824}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4023b711-b06f-515e-9ebc-d0cb6ae6ee32" :question/math-academy-id "q-78892" :question/problem "Find the area of the finite region bounded between the curve $x=2-\\frac{1}{2}{y}^{2}$ and the $y$-axis." :question/worked-solution "First, we find the $y$-intercepts of the curve:\n\n$$\n\\begin{aligned}2-\\frac{1}{2}{y}^{2} & =0 \\\\ \\frac{1}{2}{y}^{2} & =2 \\\\ {y}^{2} & =4 \\\\ y & =\\pm 2\\end{aligned}\n$$\n\nNext, we draw a sketch of the region:\n\n![](images/5e/5e3f9d31bc4cb5687d784097679861644cc55ce667ea1469d0d790bfe879706f.png)\n\nWe want to find the area between the curve $x=2-\\frac{1}{2}{y}^{2}$ and the $y$-axis from $y=-2$ to $y=2.$ \nTo find the area, we compute the corresponding definite integral, as follows:\n\n$$\n\\begin{aligned}A & ={\\int }_{c}^{d}x(y)\\,\\text{d}y \\\\  & ={\\int }_{-2}^{2}(2-\\frac{1}{2}{y}^{2})\\,\\text{d}y \\\\  & =2{\\int }_{0}^{2}(2-\\frac{1}{2}{y}^{2})\\,\\text{d}y \\\\  & =4{\\int }_{0}^{2}\\,\\text{d}y-{\\int }_{0}^{2}{y}^{2}\\,\\text{d}y \\\\  & =4\\cdot y{|}_{0}^{2}-{\\frac{{y}^{3}}{3}|}_{0}^{2} \\\\  & =4(2-0)-(\\frac{(2)^{3}}{3}-0) \\\\  & =8-\\frac{8}{3} \\\\  & =\\frac{16}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348127 :knowledge-point/_questions [{:db/id #edb/ref 17592186096750 :knowledge-point/id #uuid "963f66a5-f742-5b3b-8ae1-f0dbf268bff0" :knowledge-point/title "Finding the Area Bounded Between a Curve and the Y-Axis by First Rewriting the Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "679f5abf-8db9-5ba4-bc7e-f588e0e0a01b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186346256} {:answer/id #uuid "b1c7187b-4667-506c-8362-9305c8cfe980" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186346902} {:answer/id #uuid "b30ab7cc-25f1-5cfa-b08a-3ff976d12930" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186346911} {:answer/id #uuid "c2c76418-a8d5-57c5-8e67-683b4bc2685c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186347035} {:answer/id #uuid "e9ad7807-4fd8-5316-8cf8-5850d872e1ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186347414}] :answer-field/correct {:answer/id #uuid "c2c76418-a8d5-57c5-8e67-683b4bc2685c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186347035} :answer-field/id #uuid "1aa9c867-1fc7-502c-bae6-9ed5fd22e423" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347652}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "818e921a-061e-5ad5-ad48-9a51a0f6deec" :question/math-academy-id "q-78896" :question/problem "![](images/44/446dddc9ec5393005b5aa9fff9d45760c6f2e80da97fd459cdd74cf4f8575f71.png)\n\nFind the area bounded between the curve $y=\\sqrt[3]{x-1}+1,$ the $y$-axis and the lines $y=0$ and $y=1,$ as shown above." :question/worked-solution "First, we make $x$ the subject:\n\n$$\n\\begin{aligned}y & =\\sqrt[3]{x-1}+1 \\\\ y-1 & =\\sqrt[3]{x-1} \\\\ (y-1)^{3} & =x-1 \\\\ x & =(y-1)^{3}+1 \\\\ x & ={y}^{3}-3{y}^{2}+3y\\end{aligned}\n$$\n\nNow, to find the area, we compute the corresponding definite integral, as follows:\n\n$$\n\\begin{aligned}A & ={\\int }_{c}^{d}x(y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}({y}^{3}-3{y}^{2}+3y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{y}^{3}\\,\\text{d}y-3{\\int }_{0}^{1}{y}^{2}\\,\\text{d}y+3{\\int }_{0}^{1}y\\,\\text{d}y \\\\  & ={\\frac{{y}^{4}}{4}|}_{0}^{1}-3\\cdot {\\frac{{y}^{3}}{3}|}_{0}^{1}+3\\cdot {\\frac{{y}^{2}}{2}|}_{0}^{1} \\\\  & =(\\frac{1}{4}-0)-3(\\frac{1}{3}-0)+3(\\frac{1}{2}-0) \\\\  & =\\frac{1}{4}-1+\\frac{3}{2} \\\\  & =\\frac{3}{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348133 :knowledge-point/_questions [{:db/id #edb/ref 17592186068788 :knowledge-point/id #uuid "16dac5bd-acbd-51c6-8636-172e3a55aaf1" :knowledge-point/title "Finding the Second Derivative of a Parametric Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02ad9106-6449-5425-9ea8-8c4d982508a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡(2t)" :db/id #edb/ref 17592186345373} {:answer/id #uuid "45dc42bc-9e4d-55b0-9f61-b8cbcec2623e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{sec}^{2}⁡(2t)" :db/id #edb/ref 17592186345960} {:answer/id #uuid "a4b9b883-5db0-5670-b24b-baadb64f5beb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{sec}^{3}⁡(2t)" :db/id #edb/ref 17592186346787} {:answer/id #uuid "bc4fe63e-62d3-5e7b-87ef-17e62dfe7c2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{sec}⁡(2t)" :db/id #edb/ref 17592186346988} {:answer/id #uuid "e4746b2e-d4c3-51e0-b47c-2a5f28dfd1f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{sec}^{2}⁡(t)" :db/id #edb/ref 17592186347363}] :answer-field/correct {:answer/id #uuid "a4b9b883-5db0-5670-b24b-baadb64f5beb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{sec}^{3}⁡(2t)" :db/id #edb/ref 17592186346787} :answer-field/id #uuid "3bbb2f12-0ff8-5ad2-898f-75f1bc5be3b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347704}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "858cfde7-5900-59e1-9b39-5d78acc22281" :question/math-academy-id "q-78950" :question/problem "A curve is defined by the parametric equations $x=\\operatorname{sin}⁡(2t),\\,y=\\operatorname{cos}⁡(2t)-3.$ Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}.$" :question/worked-solution "To find the first derivative, we will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=2\\operatorname{cos}⁡(2t),\\,{y}^{′}(t)=-2\\operatorname{sin}⁡(2t).\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=-\\frac{2\\operatorname{sin}⁡(2t)}{2\\operatorname{cos}⁡(2t)}=-\\operatorname{tan}⁡(2t).\n$$\n\nTo compute the second derivative, we can use the formula\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(\\frac{dy}{dx})}{(\\frac{dx}{dt})}.\\end{aligned}\n$$\n\nSubstituting into the formula, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(-\\operatorname{tan}⁡(2t))}{2\\operatorname{cos}⁡(2t)} \\\\  & =-\\frac{2{sec}^{2}⁡(2t)}{2\\operatorname{cos}⁡(2t)} \\\\  & =-{sec}^{3}⁡(2t).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348134 :knowledge-point/_questions [{:db/id #edb/ref 17592186068788 :knowledge-point/id #uuid "16dac5bd-acbd-51c6-8636-172e3a55aaf1" :knowledge-point/title "Finding the Second Derivative of a Parametric Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11b139ee-f463-5a47-9c6a-a41512770e3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{csc}^{2}⁡t" :db/id #edb/ref 17592186345503} {:answer/id #uuid "19031ec8-e1ff-542a-a61e-a82e8669c57b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{sec}^{3}⁡t" :db/id #edb/ref 17592186345572} {:answer/id #uuid "1f3696a9-c1f5-5688-a685-20e48aa47576" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{csc}⁡t" :db/id #edb/ref 17592186345625} {:answer/id #uuid "d4a736b8-6f9b-5cac-8168-604e09548620" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡t" :db/id #edb/ref 17592186347219} {:answer/id #uuid "ee140afe-fb06-5d83-b607-8a7268797ff7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{csc}^{3}⁡t" :db/id #edb/ref 17592186347453}] :answer-field/correct {:answer/id #uuid "ee140afe-fb06-5d83-b607-8a7268797ff7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{csc}^{3}⁡t" :db/id #edb/ref 17592186347453} :answer-field/id #uuid "ce54c950-38e1-57f1-9dbf-c1bfdc34311a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347958}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "57251548-96ca-57aa-b00f-0da810dd66ec" :question/math-academy-id "q-78951" :question/problem "A curve is defined by the parametric equations $x=-\\operatorname{cos}⁡t+3,\\,y=2\\operatorname{sin}⁡t-1.$ Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}.$" :question/worked-solution "To find the first derivative, we will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=\\operatorname{sin}⁡t,\\,{y}^{′}(t)=2\\operatorname{cos}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{2\\operatorname{cos}⁡t}{\\operatorname{sin}⁡t}=2\\operatorname{cot}⁡t.\n$$\n\nTo compute the second derivative, we can use the formula\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(\\frac{dy}{dx})}{(\\frac{dx}{dt})}.\\end{aligned}\n$$\n\nSubstituting into the formula, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(2\\operatorname{cot}⁡t)}{\\operatorname{sin}⁡t} \\\\  & =-\\frac{2{csc}^{2}⁡t}{\\operatorname{sin}⁡t} \\\\  & =-2{csc}^{3}⁡t.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348135 :knowledge-point/_questions [{:db/id #edb/ref 17592186068778 :knowledge-point/id #uuid "8fb50541-88df-5f3f-b9e0-cf51edae401e" :knowledge-point/title "Calculating the Derivative of a Parametric Curve at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bbf0b70-eb73-5737-870e-2b2a733a604d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186345593} {:answer/id #uuid "22ea9738-c711-5104-a068-657f18af36ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14}{3}" :db/id #edb/ref 17592186345664} {:answer/id #uuid "58320d87-d5f1-5831-b7ba-1fc8e51312dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186346104} {:answer/id #uuid "7d80556e-d68c-5841-8c9b-4fac2591689a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186346449} {:answer/id #uuid "de267612-3488-5cfc-bf84-8951e79d0127" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186347305}] :answer-field/correct {:answer/id #uuid "7d80556e-d68c-5841-8c9b-4fac2591689a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186346449} :answer-field/id #uuid "eb795487-a850-5ed5-84bc-cdf04a7dfdc5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186348020}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2921b965-ad16-58ab-8156-5829abb484a7" :question/math-academy-id "q-78954" :question/problem "A curve has parametric equations $x=\\frac{{t}^{5}}{5}-2,\\,y={t}^{7}+2.$ Given that $\\frac{\\text{d}y}{\\text{d}x}=7{t}^{2},$ calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ at the point where $t=2.$" :question/worked-solution "To compute $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}},$ we can use the formula\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(\\frac{dy}{dx})}{(\\frac{dx}{dt})}.\\end{aligned}\n$$\n\nWe're given that $\\frac{dy}{dx}=7{t}^{2},$ and we can calculate $\\frac{dx}{dt}$ as follows:\n\n$$\n\\frac{dx}{dt}=\\frac{d}{dt}(\\frac{{t}^{5}}{5}-2)={t}^{4}.\n$$\n\nSubstituting into the formula, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(7{t}^{2})}{{t}^{4}} \\\\  & =\\frac{14t}{{t}^{4}} \\\\  & =\\frac{14}{{t}^{3}}.\\end{aligned}\n$$\n\nFinally, we evaluate at $t=2,$ and we get\n\n$$\n{\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{t=2}=\\frac{14}{(2)^{3}}=\\frac{14}{8}=\\frac{7}{4}.\n$$"}] [{:db/id #edb/ref 17592186348137 :knowledge-point/_questions [{:db/id #edb/ref 17592186096834 :knowledge-point/id #uuid "31a28451-005e-50dc-a7cf-5b666b1d7735" :knowledge-point/title "Using Integration by Parts to Compute an Integral Containing a Natural Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "051310d8-27d9-55b7-9973-63ffa9cb14aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9{x}^{3}\\operatorname{ln}⁡x-3{x}^{3}+C" :db/id #edb/ref 17592186345392} {:answer/id #uuid "3d4113e3-0764-5672-9891-a633856b765a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}-4{x}^{3}\\operatorname{ln}⁡x+C" :db/id #edb/ref 17592186345869} {:answer/id #uuid "ede3205e-3227-5dea-8169-7b24d8965679" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}\\operatorname{ln}⁡x-{x}^{3}+C" :db/id #edb/ref 17592186347452} {:answer/id #uuid "f1a4f59c-0e70-5bb8-a82c-7d6417df818d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}+9{x}^{3}\\operatorname{ln}⁡x+C" :db/id #edb/ref 17592186347487}] :answer-field/correct {:answer/id #uuid "ede3205e-3227-5dea-8169-7b24d8965679" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}\\operatorname{ln}⁡x-{x}^{3}+C" :db/id #edb/ref 17592186347452} :answer-field/id #uuid "482202fe-3be8-520f-b799-223ef4007503" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347723}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c32c46c2-ed3e-5d40-a351-d00d1deae676" :question/math-academy-id "q-78957" :question/problem "$\\int 9{x}^{2}\\operatorname{ln}⁡x\\,\\text{d}x=$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡x\\, & ⟹\\,{u}^{′}=\\frac{1}{x} \\\\ {v}^{′}=9{x}^{2}\\, & ⟹\\,v=\\int 9{x}^{2}\\,\\text{d}x=3{x}^{3}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 9{x}^{2}\\operatorname{ln}⁡x\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡x\\cdot 3{x}^{3}-\\int 3{x}^{3}(\\frac{1}{x})\\,\\text{d}x \\\\  & =3{x}^{3}\\operatorname{ln}⁡x-\\int 3{x}^{2}\\,\\text{d}x \\\\  & =3{x}^{3}\\operatorname{ln}⁡x-{x}^{3}+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant."}] [{:db/id #edb/ref 17592186348142 :knowledge-point/_questions [{:db/id #edb/ref 17592186096835 :knowledge-point/id #uuid "6c987d6e-0dd9-50fa-85a0-905c93e07413" :knowledge-point/title "Using Integration by Parts to Compute an Integral Containing an Arbitrary Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f0a3c73-d694-5363-81bc-b0948cc36827" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{\\operatorname{ln}⁡2}(\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186345477} {:answer/id #uuid "10faa4c0-b34f-58ce-8a70-646d8e08eb4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{\\operatorname{ln}⁡2}(5\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186345496} {:answer/id #uuid "315bd1d2-c82c-5e28-a3a9-f62be233cf86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{x}^{4}}{\\operatorname{ln}⁡2}(\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186345789} {:answer/id #uuid "8112a67b-7bc2-5014-a2dc-89459a2b9245" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{x}^{5}}{\\operatorname{ln}⁡2}(\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186346480} {:answer/id #uuid "8b431d31-904f-548e-b81b-a8484ee32adf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{x}^{5}}{\\operatorname{ln}⁡2}(5\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186346555}] :answer-field/correct {:answer/id #uuid "10faa4c0-b34f-58ce-8a70-646d8e08eb4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{\\operatorname{ln}⁡2}(5\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186345496} :answer-field/id #uuid "b237fdd7-cb5b-541e-84ab-16802e562a0e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347914}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7213d64e-5c6e-5663-8a1c-2023e1da03df" :question/math-academy-id "q-78962" :question/problem "Calculate $\\int 25{x}^{4}{log}_{2}⁡(x)\\,\\text{d}x.$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u={log}_{2}⁡(x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡2} \\\\ {v}^{′}=25{x}^{4}\\, & ⟹\\,v=\\int 25{x}^{4}\\,\\text{d}x=5{x}^{5}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 25{x}^{4}{log}_{2}⁡(x)\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & ={log}_{2}⁡(x)(5{x}^{5})-\\int \\frac{5{x}^{5}}{x\\operatorname{ln}⁡2}\\,\\text{d}x \\\\  & =5{x}^{5}{log}_{2}⁡(x)-\\frac{1}{\\operatorname{ln}⁡2}\\int 5{x}^{4}\\,\\text{d}x \\\\  & =5{x}^{5}{log}_{2}⁡(x)-\\frac{1}{\\operatorname{ln}⁡2}\\cdot {x}^{5}+C \\\\  & =\\frac{5{x}^{5}\\operatorname{ln}⁡x}{\\operatorname{ln}⁡2}-\\frac{{x}^{5}}{\\operatorname{ln}⁡2}+C \\\\  & =\\frac{{x}^{5}}{\\operatorname{ln}⁡2}(5\\operatorname{ln}⁡x-1)+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant.\n\nNote that in the above calculation we used the change of base formula ${log}_{2}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡2}.$"}] [{:db/id #edb/ref 17592186405153 :knowledge-point/_questions [{:db/id #edb/ref 17592186087659 :knowledge-point/id #uuid "a9faf6d8-0c06-5bf4-bc41-6d68d3d414c6" :knowledge-point/title "Identifying When a Circle Does Not Intersect an Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b374944-d47a-526e-b651-a9bdd179683c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The locus has no $x$-intercepts" :db/id #edb/ref 17592186405189} {:answer/id #uuid "6dc41c5f-d7b6-5d05-8b47-2e4e472399bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,0)" :db/id #edb/ref 17592186405190} {:answer/id #uuid "d443e6bd-6dee-5d3a-b69a-1e6b48338e7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1-\\sqrt{11},0)$ and $(1+\\sqrt{11},0)$" :db/id #edb/ref 17592186405191} {:answer/id #uuid "73af1a99-304f-5788-9f9f-7c5af517eb9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(2,0)$ and $(5,0)$" :db/id #edb/ref 17592186405192} {:answer/id #uuid "eec08ca2-05c0-5cfd-a7e9-7540222dfb9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{11},0)" :db/id #edb/ref 17592186405193}] :answer-field/correct {:answer/id #uuid "8b374944-d47a-526e-b651-a9bdd179683c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The locus has no $x$-intercepts" :db/id #edb/ref 17592186405189} :answer-field/id #uuid "a56e38c9-b83e-56e9-bf4c-ec09e761bb76" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186405188}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f43a31ca-f582-5ca4-a303-c0af1e9c11d4" :question/math-academy-id "q-79044" :question/problem "Calculate the $x$-intercepts of the real locus ${x}^{2}+{y}^{2}-2x+6y+12=0$" :question/worked-solution "We must have $y=0$ at the $x$-intercepts.  \n\nSo, we need to substitute $y=0$ into the equation of the locus and solve the resulting equation for $x,$ if possible:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-2x+6y+12 & =0 \\\\ {x}^{2}+{0}^{2}-2x+6\\cdot 0+12 & =0 \\\\ {x}^{2}-2x+12 & =0\\end{aligned}\n$$\n\nWe can solve this equation by completing the square, as follows:\n\n$$\n\\begin{aligned}{x}^{2}-2x+1+12 & =0+1 \\\\ (x-1)^{2}+12 & =1 \\\\ (x-1)^{2} & =-11\\end{aligned}\n$$\n\nSince $(x-1)^{2}\\ge 0$ for all values of $x,$ there is no $x$ such that $(x-1)^{2}=-11.$ Therefore, the locus has no $x$-intercepts."}] [{:db/id #edb/ref 17592186348160 :knowledge-point/_questions [{:db/id #edb/ref 17592186087700 :knowledge-point/id #uuid "a75c67e5-3469-5730-9181-54df4ec6d5b2" :knowledge-point/title "Determining the Inverse of a Larger Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37348c9a-1cca-580a-876d-f2c664a5da34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186345824} {:answer/id #uuid "37a50610-1330-582a-b2b5-974cd1ceb8e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186345829} {:answer/id #uuid "593dcbaf-fdcd-52ea-8b38-1a3a56714e6d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186346117} {:answer/id #uuid "f61dabae-a838-5c18-bd37-715b475a71a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186347534} {:answer/id #uuid "ffc05612-e5a3-549f-8dbf-07cc6363573e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186347600}] :answer-field/correct {:answer/id #uuid "37348c9a-1cca-580a-876d-f2c664a5da34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186345824} :answer-field/id #uuid "94b9401c-4707-577e-a1c6-56f80e0c7ef2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347867}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d3b65f93-463c-54d1-85ca-57a9749888f1" :question/math-academy-id "q-7905" :question/problem "Consider the matrices\n\n$$\nA=[\\begin{aligned}1 & 0 & 0 \\\\ -5 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}],\\,B=[\\begin{aligned}1 & 0 & 0 \\\\ 5 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}],\\,E=[\\begin{aligned}1 & 0 & 0 \\\\ -5 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}].\n$$\n\nWhich of the following statements are true?\n\nI. $AB=BA={I}_{3}$\n\nII. $AE=EA={I}_{3}$\n\nIII. $B={A}^{-1}$" :question/worked-solution "- First, we check whether $AB=BA={I}_{3}.$ Computing $AB$, we get\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}1 & 0 & 0 \\\\ -5 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 5 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nLikewise, computing $BA$, we get\n\n$$\n\\begin{aligned}BA & =[\\begin{aligned}1 & 0 & 0 \\\\ 5 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ -5 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nSo, statement I is true. As a result, $B={A}^{-1}$ and statement III is true too.\n\n- Now, we check whether $AE=EA={I}_{3}.$ Computing $AE$, we get\n\n$$\n\\begin{aligned}AE & =[\\begin{aligned}1 & 0 & 0 \\\\ -5 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ -5 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}∗ & ∗ & ∗ \\\\ -10 & ∗ & ∗ \\\\ ∗ & ∗ & ∗\\end{aligned}] \\\\  & \\ne {I}_{3}.\\,\\times \\end{aligned}\n$$\n\nSo, statement II is false.\n\nTherefore, the correct answer is \"I and III only\"."}] [{:db/id #edb/ref 17592186396169 :knowledge-point/_questions [{:db/id #edb/ref 17592186087702 :knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bdb0a517-2a62-5ad4-abb7-32db925dcbb8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $R$ only" :db/id #edb/ref 17592186396171} {:answer/id #uuid "378c3d9c-f434-5a36-b4c6-e35a124290f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$Q$ and $R$ only" :db/id #edb/ref 17592186396172} {:answer/id #uuid "4ccb69d4-cf84-531e-a891-dec63188d912" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$Q$ only" :db/id #edb/ref 17592186396173} {:answer/id #uuid "e1648b74-cbef-5884-9e5c-c49ee87da068" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ only" :db/id #edb/ref 17592186396174} {:answer/id #uuid "94c1155a-b3ff-59dd-b24f-e9f04aac265d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $Q$ only" :db/id #edb/ref 17592186396175}] :answer-field/correct {:answer/id #uuid "94c1155a-b3ff-59dd-b24f-e9f04aac265d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $Q$ only" :db/id #edb/ref 17592186396175} :answer-field/id #uuid "aa5359f3-29e9-58eb-b41e-ef40c0bf51eb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396170}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "17761662-c8e1-5053-be1d-f17ca1632a52" :question/math-academy-id "q-7915" :question/problem "Which of the matrices below are singular?\n\n$$\nP=[\\begin{aligned}4 & 3 \\\\ 8 & 6\\end{aligned}],\\,Q=[\\begin{aligned}1 & -1 \\\\ -1 & 1\\end{aligned}],\\,R=[\\begin{aligned}2 & -4 & 3 \\\\ 3 & -4 & 2\\end{aligned}].\n$$" :question/worked-solution "- For the matrix $P$, we have\n\n$$\ndet(P)=4\\cdot 6-8\\cdot 3=0.\n$$\n\nBecause $det(P)=0,$ we conclude that $P$ is not invertible. Since $P$ is a square matrix that is not invertible, we also say that $P$ is singular.\n\n- For the matrix $Q$, we have\n\n$$\ndet(Q)=1\\cdot 1-(-1)\\cdot (-1)=0.\n$$\n\nBecause $det(Q)=0,$ we conclude that $Q$ is not invertible. Since $Q$ is a square matrix that is not invertible, we also say that $Q$ is singular.\n\n- The matrix $R$ is a $2\\times 3$ matrix. So, it is not invertible. Since the matrix is not square, we can't say that it's singular.\n\nTherefore, only $P$ and $Q$ are singular."}] [{:db/id #edb/ref 17592186348168 :knowledge-point/_questions [{:db/id #edb/ref 17592186087743 :knowledge-point/id #uuid "0346056c-cf8e-51bf-92f3-052a0948a6fa" :knowledge-point/title "Finding the Parametric Equations of a Circle Centered at a General Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41f4c8c5-a1e0-50d2-90e3-c842b69b61a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2\\operatorname{cos}⁡\\theta +3,\\,y=2\\operatorname{sin}⁡\\theta +2" :db/id #edb/ref 17592186345916} {:answer/id #uuid "8be8bc87-925d-5a80-b272-9812c2eb7b96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2\\operatorname{sin}⁡\\theta +3,\\,y=2\\operatorname{cos}⁡\\theta +2" :db/id #edb/ref 17592186346563} {:answer/id #uuid "b024a727-8b31-5d76-a59f-dbb3e082e615" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\sqrt{2}\\operatorname{cos}⁡\\theta +3,\\,y=\\sqrt{2}\\operatorname{sin}⁡\\theta +2" :db/id #edb/ref 17592186346889} {:answer/id #uuid "fac11c48-254b-548d-81fb-bf48b11a35c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2\\operatorname{sin}⁡\\theta -2,\\,y=2\\operatorname{cos}⁡\\theta -3" :db/id #edb/ref 17592186347566} {:answer/id #uuid "fe7ffdeb-b39d-53fd-a335-3c0a492a7c63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\sqrt{2}\\operatorname{cos}⁡\\theta -3,\\,y=\\sqrt{2}\\operatorname{sin}⁡\\theta -2" :db/id #edb/ref 17592186347586}] :answer-field/correct {:answer/id #uuid "41f4c8c5-a1e0-50d2-90e3-c842b69b61a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2\\operatorname{cos}⁡\\theta +3,\\,y=2\\operatorname{sin}⁡\\theta +2" :db/id #edb/ref 17592186345916} :answer-field/id #uuid "7f4d4e4d-7b06-5451-ae6d-dff63e644b63" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347828}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e2b98504-334c-5f63-b626-52b1babf6c47" :question/math-academy-id "q-79170" :question/problem "![](images/14/1407fa82fd00d07311cb34c6a3d5f0d0c79808d321d049d74114a6f4f2e5f6a6.png)\n\nConsider the circle of radius $2$ centered at $(3,2)$, as shown above. Which of the following sets of parametric equations, defined for $\\theta \\in [0,2\\pi ),$  traverse the circle once in the counterclockwise direction starting at the point $A(5,2)?$" :question/worked-solution "The parametric equations of a circle of radius $r$ centered at the point $(a,b)$ are\n\n$$\nx=r\\operatorname{cos}⁡\\theta +a,\\,y=r\\operatorname{sin}⁡\\theta +b,\\,\\theta \\in [0,2\\pi ).\n$$\n\nUnder this parametrization, the circle is traversed once in the counterclockwise direction, starting from $(r+a,b).$\n\nIn our case, we have a circle of radius $2$ centered at the point $(3,2).$ Therefore, the parametric equations of the circle are\n\n$$\nx=2\\operatorname{cos}⁡\\theta +3,\\,y=2\\operatorname{sin}⁡\\theta +2,\\,\\theta \\in [0,2\\pi ).\n$$"}] [{:db/id #edb/ref 17592186184844 :knowledge-point/_questions [{:db/id #edb/ref 17592186184148 :knowledge-point/id #uuid "dac9c72b-c23f-56fa-b939-6e3b56d3a13b" :knowledge-point/title "Identifying the Horizontal Stretch and Vertical Shift of a Transformed Cotangent Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aad4bfcf-ac83-5c47-928b-5b1a7fc0f104" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186183674} {:answer/id #uuid "df3e3991-8f50-5de8-b75b-5960efe17e47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186183675} {:answer/id #uuid "f2572169-df3d-5c99-975a-9f3f678ee3a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186183676} {:answer/id #uuid "f28c8896-b9fe-5342-9cba-cebeee74006f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186183677} {:answer/id #uuid "095c622d-5db2-5a48-942e-b312abb3f7c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186183678}] :answer-field/id #uuid "2d980f41-06e1-5562-995c-dd718d6a8c7a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186183673} {:answer-field/choices [{:answer/id #uuid "081bfb29-fde1-5481-b123-8eac743f086f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186399099} {:answer/id #uuid "51e08aac-9339-503c-9a66-b74268d4d2f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186399100} {:answer/id #uuid "03fedd1c-29b4-5722-b1e7-b3c046e5b66c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186399101} {:answer/id #uuid "a2ce8598-f6eb-5e70-b2e5-0d95b7a5f429" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186399102} {:answer/id #uuid "6704d952-af2f-5f8a-a722-c90281d08d85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186399103}] :answer-field/correct {:answer/id #uuid "03fedd1c-29b4-5722-b1e7-b3c046e5b66c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186399101} :answer-field/id #uuid "1848e56b-8e02-510d-9f75-0f28e4f3c082" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399098}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d92d6b12-34ec-5e74-a8fa-e75755bbf55a" :question/math-academy-id "q-79188" :question/problem "![](images/ae/ae6a514e0d9cde3db3c3b1dfa94e3804b5469dd5fb99b40a94684e88b573ec38.png)\n\nThe graph above shows the function $y=\\operatorname{cot}⁡(Bx)+D,$ where $B$ and $D$ are constants. What is $B+D?$" :question/worked-solution "The period $T$ of the function is\n\n$$\nT=\\frac{\\pi }{3}.\n$$\n\nThe formula for the period $T$ of the function $y=A\\operatorname{cot}⁡(Bx+C)+D$ is given by \n\n$$\nT=\\frac{\\pi }{B}.\n$$\n\nApplying the formula of the period, we get\n\n$$\n\\frac{\\pi }{3}=\\frac{\\pi }{B}\\,⟹\\,B=\\frac{\\pi }{(\\frac{\\pi }{3})}=3.\n$$\n\nThe parameter $D$ represents the vertical shift of the cotangent function. We see that the function has been translated by $3$ units up. Hence, $D=3.$\n\nTherefore, $B+D=3+3=6.$\n\nFinally, the equation of the curve is\n\n$$\ny=\\operatorname{cot}⁡(3x)+3.\n$$"}] [{:db/id #edb/ref 17592186348170 :knowledge-point/_questions [{:db/id #edb/ref 17592186087743 :knowledge-point/id #uuid "0346056c-cf8e-51bf-92f3-052a0948a6fa" :knowledge-point/title "Finding the Parametric Equations of a Circle Centered at a General Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f11f8f5-14af-5418-a30f-2cdb361b260a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\sqrt{3}\\operatorname{cos}⁡\\theta -4,\\,y=\\sqrt{3}\\operatorname{sin}⁡\\theta +5" :db/id #edb/ref 17592186346029} {:answer/id #uuid "60d87398-f4f2-5513-9687-a427c1be6407" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=3\\operatorname{cos}⁡\\theta -4,\\,y=3\\operatorname{sin}⁡\\theta +5" :db/id #edb/ref 17592186346190} {:answer/id #uuid "6661a258-7ca8-5569-93ca-fc1dce78c2f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\sqrt{3}\\operatorname{sin}⁡\\theta +5,\\,y=\\sqrt{3}\\operatorname{cos}⁡\\theta -4" :db/id #edb/ref 17592186346245} {:answer/id #uuid "80d564fe-11e4-5e17-ae8d-364ca396dbfc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=3\\operatorname{sin}⁡\\theta -4,\\,y=3\\operatorname{cos}⁡\\theta +5" :db/id #edb/ref 17592186346476} {:answer/id #uuid "d68fa614-0fdb-5265-9177-7d915486a0ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=3\\operatorname{cos}⁡\\theta +5,\\,y=3\\operatorname{sin}⁡\\theta -4" :db/id #edb/ref 17592186347244}] :answer-field/correct {:answer/id #uuid "60d87398-f4f2-5513-9687-a427c1be6407" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=3\\operatorname{cos}⁡\\theta -4,\\,y=3\\operatorname{sin}⁡\\theta +5" :db/id #edb/ref 17592186346190} :answer-field/id #uuid "00426326-692f-5b6d-a52b-4521d86868ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347605}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5c8948ed-478d-597d-8d84-3303f297f4dd" :question/math-academy-id "q-79192" :question/problem "![](images/6b/6b77b1b8a61b5ec7306fbc0b3d70618e7fdce2237bdcbfd017c23c01b80f2979.png)\n\nConsider the circle of radius $3$ centered at $(-4,5)$, as shown above. Which of the following sets of parametric equations, defined for $\\theta \\in [0,2\\pi ),$  traverse the circle once in the counterclockwise direction starting at the point $A(-1,5)?$" :question/worked-solution "The parametric equations of a circle of radius $r$ centered at the point $(a,b)$ are\n\n$$\nx=r\\operatorname{cos}⁡\\theta +a,\\,y=r\\operatorname{sin}⁡\\theta +b,\\,\\theta \\in [0,2\\pi ).\n$$\n\nUnder this parametrization, the circle is traversed once in the counterclockwise direction, starting from $(r+a,b).$\n\nIn our case, we have a circle of radius $3$ centered at the point $(-4,5).$ Therefore, the parametric equations of the circle are\n\n$$\nx=3\\operatorname{cos}⁡\\theta -4,\\,y=3\\operatorname{sin}⁡\\theta +5,\\,\\theta \\in [0,2\\pi ).\n$$"}] [{:db/id #edb/ref 17592186403967 :knowledge-point/_questions [{:db/id #edb/ref 17592186096624 :knowledge-point/id #uuid "977a9b6e-744a-554b-92ee-0b6343041ecf" :knowledge-point/title "Identifying Points of Inflection From the Graph of the Second Derivative of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3af905d7-78cb-583f-91a3-952928d02351" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=1$ and $x=3$" :db/id #edb/ref 17592186403969} {:answer/id #uuid "3fa213f3-196c-5248-a606-169ffea1b68e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-2,$ $x=1,$ and $x=3$" :db/id #edb/ref 17592186403970} {:answer/id #uuid "c65fd885-d01e-5eac-8be3-bb11d276114f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-2,$ $x=0,$ and $x=3$" :db/id #edb/ref 17592186403971} {:answer/id #uuid "2fa641a9-38e7-574d-a6c2-87bb062caef7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-2" :db/id #edb/ref 17592186403972} {:answer/id #uuid "5934de3b-1bf6-5068-9d23-8f267b786e33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-2$ and $x=0$" :db/id #edb/ref 17592186403973}] :answer-field/correct {:answer/id #uuid "3af905d7-78cb-583f-91a3-952928d02351" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=1$ and $x=3$" :db/id #edb/ref 17592186403969} :answer-field/id #uuid "c641f013-093d-5f3b-a9f4-c35aaff48baa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403968}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b64247db-6208-5caa-b9cd-3324ac4191ed" :question/math-academy-id "q-79197" :question/problem "![](images/07/07d9d47e39d76a60fdeb7424c22d73890f37897e0d4a03da67b1b373dd2a6ace.png)\n\nThe function $f(x)$ is continuous and twice-differentiable for all $x.$ The graph $y={f}^{″}(x)$ is shown above. At what value(s) of $x$ does $f(x)$ have a point of inflection?" :question/worked-solution "First, notice that since $f(x)$ is twice-differentiable, the tangent line to the graph exists for all real $x.$\n\nInflection points occur when a graph changes concavity. In order for the graph to change concavity, the value of the second derivative ${f}^{″}(x)$ must switch signs. So, we are looking for points where the graph of ${f}^{″}(x)$ crosses the $x$-axis.\n\nWe can see that the graph $y={f}^{″}(x)$ crosses the $x$-axis at $x=1$ and $x=3.$\n\nTherefore, $f(x)$ has points of inflection at $x=1$ and $x=3.$"}] [{:db/id #edb/ref 17592186348178 :knowledge-point/_questions [{:db/id #edb/ref 17592186087786 :knowledge-point/id #uuid "3d334fa1-725c-5687-9ed2-83a5788db925" :knowledge-point/title "Finding the Cartesian Equation of a Parametrized Circle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bb599ef-8a81-52a5-8b28-084af574bb02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=14" :db/id #edb/ref 17592186345442} {:answer/id #uuid "39105a8b-6d43-5d27-870f-eea96d04d066" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=7" :db/id #edb/ref 17592186345837} {:answer/id #uuid "b51e4691-b8a5-59dd-812a-632868d6034a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-{y}^{2}=56" :db/id #edb/ref 17592186346929} {:answer/id #uuid "b869bfc2-922d-50cc-8561-1dc9c77a11db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=49" :db/id #edb/ref 17592186346955} {:answer/id #uuid "f2fac58b-c9cb-5f3e-8265-5ba360717b7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-{y}^{2}=\\sqrt{7}" :db/id #edb/ref 17592186347500}] :answer-field/correct {:answer/id #uuid "b869bfc2-922d-50cc-8561-1dc9c77a11db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=49" :db/id #edb/ref 17592186346955} :answer-field/id #uuid "2d2a1c5c-432e-561b-bbf6-4b53c4971d96" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347678}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e9c6c4b8-31e2-55b5-bdea-fe6d4fa5f314" :question/math-academy-id "q-79219" :question/problem "Calculate the Cartesian equation of the circle\n\n$$\nx=7\\operatorname{cos}⁡\\theta ,\\,y=7\\operatorname{sin}⁡\\theta ,\\,0\\le \\theta <2\\pi .\n$$" :question/worked-solution "To find the Cartesian equation of the circle, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy squaring the $x$-equation, we get\n\n$$\n\\begin{aligned}x & =7\\operatorname{cos}⁡\\theta  \\\\ {x}^{2} & =(7\\operatorname{cos}⁡\\theta )^{2} \\\\  & =49{cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy squaring the $y$-equation, we get\n\n$$\n\\begin{aligned}y & =7\\operatorname{sin}⁡\\theta  \\\\ {y}^{2} & =(7\\operatorname{sin}⁡\\theta )^{2} \\\\  & =49{sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =49{cos}^{2}⁡\\theta +49{sin}^{2}⁡\\theta  \\\\  & =49({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta ) \\\\  & =49(1) \\\\  & =49.\\end{aligned}\n$$\n\nTherefore the Cartesian equation is ${x}^{2}+{y}^{2}=49.$"}] [{:db/id #edb/ref 17592186348180 :knowledge-point/_questions [{:db/id #edb/ref 17592186087786 :knowledge-point/id #uuid "3d334fa1-725c-5687-9ed2-83a5788db925" :knowledge-point/title "Finding the Cartesian Equation of a Parametrized Circle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b2f63f3-85a4-55bf-a395-74537aff84ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+2)^{2}+(y+3)^{2}=6" :db/id #edb/ref 17592186345587} {:answer/id #uuid "35590547-774e-5b38-9b3b-c11f13078f10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+2)^{2}+(y+3)^{2}=9" :db/id #edb/ref 17592186345812} {:answer/id #uuid "97a231cb-9741-5f6d-bdb9-9a1deed0940a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-2)^{2}+(y-3)^{2}=9" :db/id #edb/ref 17592186346679} {:answer/id #uuid "c93fa12b-ab82-59d4-918f-7a96fbadc4c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+2)^{2}+(y+3)^{2}=3" :db/id #edb/ref 17592186347104} {:answer/id #uuid "cccf5f9e-fccf-5706-aeb7-33fe7e70deb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-2)^{2}+(y-3)^{2}=3" :db/id #edb/ref 17592186347143}] :answer-field/correct {:answer/id #uuid "35590547-774e-5b38-9b3b-c11f13078f10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+2)^{2}+(y+3)^{2}=9" :db/id #edb/ref 17592186345812} :answer-field/id #uuid "23c2e10e-3b72-5e83-a5e0-5d16c4723896" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347665}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "97d013bd-90fe-54ca-b491-25e886bc0e3f" :question/math-academy-id "q-79221" :question/problem "Determine the Cartesian equation of the circle\n\n$$\nx=3\\operatorname{cos}⁡\\theta -2,\\,y=3\\operatorname{sin}⁡\\theta -3,\\,0\\le \\theta <2\\pi .\n$$" :question/worked-solution "To find the Cartesian equation of the circle, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}\\frac{x+2}{3} & =\\operatorname{cos}⁡\\theta  \\\\ \\frac{(x+2)^{2}}{{3}^{2}} & ={cos}^{2}⁡\\theta  \\\\ \\frac{(x+2)^{2}}{9} & ={cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}\\frac{y+3}{3} & =\\operatorname{sin}⁡\\theta  \\\\ \\frac{(y+3)^{2}}{{3}^{2}} & ={sin}^{2}⁡\\theta  \\\\ \\frac{(y+3)^{2}}{9} & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}\\frac{(x+2)^{2}}{9}+\\frac{(y+3)^{2}}{9} & ={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta  \\\\ \\frac{(x+2)^{2}}{9}+\\frac{(y+3)^{2}}{9} & =1 \\\\ (x+2)^{2}+(y+3)^{2} & =9\\end{aligned}\n$$\n\nTherefore the Cartesian equation is $(x+2)^{2}+(y+3)^{2}=9.$"}] [{:db/id #edb/ref 17592186152803 :knowledge-point/_questions [{:db/id #edb/ref 17592186152190 :knowledge-point/id #uuid "9b51a7bc-7701-539f-9e20-dfc7f2574559" :knowledge-point/title "Parametrizing Part of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "419e0fe4-541d-575b-bd6b-074ed807c5da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta \\in [\\pi ,\\frac{3\\pi }{2}]" :db/id #edb/ref 17592186345912} {:answer/id #uuid "56731126-b0fd-5c16-b1f9-63fbaafe01ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta \\in [\\frac{\\pi }{2},\\frac{3\\pi }{2}]" :db/id #edb/ref 17592186346085} {:answer/id #uuid "948d5062-a656-50d5-97b2-6755aeff6a69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta \\in [\\frac{\\pi }{2},2\\pi ]" :db/id #edb/ref 17592186346650} {:answer/id #uuid "af68045c-5323-5bea-89e3-3895b7396107" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta \\in [\\pi ,2\\pi ]" :db/id #edb/ref 17592186346880} {:answer/id #uuid "f1040bbf-9525-5f13-9c15-51d8ca1f1512" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta \\in [0,\\pi ]" :db/id #edb/ref 17592186347479}] :answer-field/correct {:answer/id #uuid "af68045c-5323-5bea-89e3-3895b7396107" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta \\in [\\pi ,2\\pi ]" :db/id #edb/ref 17592186346880} :answer-field/id #uuid "156679d2-1a36-5aa2-99e9-ecebcc317e24" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347647}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "228da086-3823-57b7-bc11-c5027b83ec8c" :question/math-academy-id "q-79278" :question/problem "![](images/4e/4e9218dcfc77ec080139f2650ea19f78199557e0ce2d8d53c1996ec0ea6145a6.png)\n\nThe half-ellipse above is defined by the parametric equations \n\n$$\nx=3\\operatorname{cos}⁡\\theta ,\\,y=2\\operatorname{sin}⁡\\theta .\n$$\n\nWhat is the domain of the parameter $\\theta ?$" :question/worked-solution "The parametric equations of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ are\n\n$$\nx=a\\operatorname{cos}⁡\\theta ,\\,y=b\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, $a=3$ and $b=2.$ Therefore, the parametric equations of the *full* ellipse are\n\n$$\nx=3\\operatorname{cos}⁡\\theta ,\\,y=2\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nTo restrict the parameterization to a half-ellipse, we associate the parameter $\\theta $ with the central angle formed by a point $(x,y)$ on the elipse and the $x$-axis. \n\n![](images/df/dfbe843a9ad0847d7174984fa7c7c48834af48b3ee2335b5383b15f7fb826763.png)\n\nWe can see that if we restrict $\\theta $ to $[\\pi ,2\\pi ]$, we get the half-ellipse.\n\nTherefore, the parametric equations of the half-ellipse are \n\n$$\nx=3\\operatorname{cos}⁡\\theta ,\\,y=2\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [\\pi ,2\\pi ].\n$$"}] [{:db/id #edb/ref 17592186403981 :knowledge-point/_questions [{:db/id #edb/ref 17592186152187 :knowledge-point/id #uuid "db20f4a5-27a4-5fbc-aae2-2febf8f99cb1" :knowledge-point/title "The Parametric Equations of an Ellipse Centered at the Origin"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d88f68b3-79d9-5a48-a7c2-f15131e65b23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=4\\operatorname{cos}⁡\\theta ,\\,y=16\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186403983} {:answer/id #uuid "72609a03-e838-5ef4-baec-8bf52ebe1a8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=4\\operatorname{sin}⁡\\theta ,\\,y=2\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186403984} {:answer/id #uuid "db076067-80ec-504a-b6e7-bc424311aecf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2\\operatorname{sin}⁡\\theta ,\\,y=4\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186403985} {:answer/id #uuid "1666ec87-7cf6-516a-a70f-0da860b50921" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2\\operatorname{cos}⁡\\theta ,\\,y=4\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186403986} {:answer/id #uuid "8fb36cf6-f9c5-5daa-a5a9-b549f1488f69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=4\\operatorname{cos}⁡\\theta ,\\,y=2\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186403987}] :answer-field/correct {:answer/id #uuid "1666ec87-7cf6-516a-a70f-0da860b50921" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2\\operatorname{cos}⁡\\theta ,\\,y=4\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186403986} :answer-field/id #uuid "72801a88-c8c5-56f3-a725-309aa394dd69" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403982}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c9798ed5-9467-5b84-a966-140686dec581" :question/math-academy-id "q-79281" :question/problem "![](images/ac/ac2bba143473bc68e3a578c008a5de3cc36727d984bfba5d5e0da95462c08f77.png)\n\nConsider the ellipse centered at the origin with horizontal radius $2$ and vertical radius $4,$ as shown above. Which of the following sets of parametric equations, defined for $\\theta \\in [0,2\\pi ),$  traverse the ellipse once in the counterclockwise direction starting at the point $A(2,0)?$" :question/worked-solution "The parametric equations of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ are\n\n$$\nx=a\\operatorname{cos}⁡\\theta ,\\,y=b\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nUnder this parametrization, the ellipse is traversed once in the counterclockwise direction, starting from $(a,0).$\n\nIn our case, $a=2$ and $b=4.$ Therefore, the parametric equations of the ellipse are\n\n$$\nx=2\\operatorname{cos}⁡\\theta ,\\,y=4\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$"}] [{:db/id #edb/ref 17592186348195 :knowledge-point/_questions [{:db/id #edb/ref 17592186096708 :knowledge-point/id #uuid "5e182f71-db24-5c29-9c8b-2fc4b5ab5dd8" :knowledge-point/title "Calculating the Y-Intercepts of a Parabola Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f632187-9689-5dcb-8607-35b8892e2f47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186345770} {:answer/id #uuid "482f9eb4-7bcd-514b-8d01-90bf4b1be5b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186345971} {:answer/id #uuid "9a9bd68d-398a-5f81-9d3b-2d620308a60e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186346702} {:answer/id #uuid "d8491bfd-8d7f-547e-bf7c-f3bb48bb9729" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186347256} {:answer/id #uuid "f907922f-5150-5e85-afd6-29d01f5304a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186347553}] :answer-field/correct {:answer/id #uuid "482f9eb4-7bcd-514b-8d01-90bf4b1be5b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186345971} :answer-field/id #uuid "62a244fb-0550-5775-8987-a65a296a9de2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347778}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "06e8a49e-e560-5c26-89ae-564e1f5a8b5a" :question/math-academy-id "q-79294" :question/problem "![](images/40/407f89e40691ddaefd912c97dc9e8b15a08e0120ad2cf1c9a277417cd8380e98.png)\n\nWhat is the $y$-intercept of the parabola shown above?" :question/worked-solution "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(4,-4)$ and passes through the point $(7,5).$\n\nThe general standard equation of an up- or down-opening parabola with vertex at $(h,k)$ is given by\n\n$$\n(x-h)^{2}=4p(y-k),\n$$\n\nand substituting $(h,k)=(4,-4)$ into the above gives\n\n$$\n(x-4)^{2}=4p(y+4).\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(7,5),$ we substitute $x=7$ and $y=5$ into the equation and get\n\n$$\n\\begin{aligned}(7-4)^{2} & =4p(5+4) \\\\ 9 & =4p(9) \\\\ p & =\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(x-4)^{2} & =y+4.\\end{aligned}\n$$\n\nWhen the parabola intersects the $y$-axis, we must have $x=0.$ So, we substitute $x=0$ into the equation of the parabola and solve for $y:$\n\n$$\n\\begin{aligned}(0-4)^{2} & =y+4 \\\\ 16 & =y+4 \\\\ y & =16-4 \\\\ y & =12\\end{aligned}\n$$\n\nTherefore, the $y$-intercept is $12.$"}] [{:db/id #edb/ref 17592186377749 :knowledge-point/_questions [{:db/id #edb/ref 17592186096708 :knowledge-point/id #uuid "5e182f71-db24-5c29-9c8b-2fc4b5ab5dd8" :knowledge-point/title "Calculating the Y-Intercepts of a Parabola Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "adb19221-6751-5cef-8343-237e49f76b8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186377751} {:answer/id #uuid "cf2ff7e8-ce07-586f-ba77-b3cdd3b65295" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186377752} {:answer/id #uuid "042523a7-042d-5186-805a-f9d126ddff27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186377753} {:answer/id #uuid "fd12f48e-79a8-5156-a46c-4b1e32cf7d5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186377754} {:answer/id #uuid "2189c154-a254-5c78-a00c-3410a2a2fc64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186377755}] :answer-field/correct {:answer/id #uuid "fd12f48e-79a8-5156-a46c-4b1e32cf7d5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186377754} :answer-field/id #uuid "14445e32-9654-51bf-beee-75e82df1a60a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377750}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "73f63cef-323f-560b-95b0-2cf7424d4b67" :question/math-academy-id "q-79299" :question/problem "![](images/0d/0d7b5a0f5154da800e03519b56f3d66188fa14c9f1ee636ad246c32dc2234b7b.png)\n\nWhat is the $y$-intercept of the parabola shown above?" :question/worked-solution "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(-4,-4)$ and passes through the point $(2,14).$\n\nThe general standard equation of an up- or down-opening parabola with vertex at $(h,k)$ is given by\n\n$$\n(x-h)^{2}=4p(y-k),\n$$\n\nand substituting $(h,k)=(-4,-4)$ into the above gives\n\n$$\n(x+4)^{2}=4p(y+4).\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(2,14),$ we substitute $x=2$ and $y=14$ into the equation and get\n\n$$\n\\begin{aligned}(2+4)^{2} & =4p(14+4) \\\\ 36 & =4p(18) \\\\ p & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(x+4)^{2} & =2(y+4).\\end{aligned}\n$$\n\nWhen the parabola intersects the $y$-axis, we must have $x=0.$ So, we substitute $x=0$ into the equation of the parabola and solve for $y:$\n\n$$\n\\begin{aligned}(0+4)^{2} & =2(y+4) \\\\ 16 & =2(y+4) \\\\ 8 & =y+4 \\\\ y & =8-4 \\\\ y & =4\\end{aligned}\n$$\n\nTherefore, the $y$-intercept is $4.$"}] [{:db/id #edb/ref 17592186404016 :knowledge-point/_questions [{:db/id #edb/ref 17592186096708 :knowledge-point/id #uuid "5e182f71-db24-5c29-9c8b-2fc4b5ab5dd8" :knowledge-point/title "Calculating the Y-Intercepts of a Parabola Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c5102bd-f838-51a2-a43d-a2fd2a78f6ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-4$ and $3$" :db/id #edb/ref 17592186404018} {:answer/id #uuid "72c55eb1-bc22-5e56-b296-0190d78ec97b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-4$ and $2$" :db/id #edb/ref 17592186404019} {:answer/id #uuid "46477b31-f16d-5120-a625-74e00bf51669" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-5$ and $3$" :db/id #edb/ref 17592186404020} {:answer/id #uuid "eb064b01-f667-53e4-8106-1aaf96595200" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-5$ and $2$" :db/id #edb/ref 17592186404021} {:answer/id #uuid "23bd81ec-466e-5b37-9878-ddbec03eee54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-5$ and $4$" :db/id #edb/ref 17592186404022}] :answer-field/correct {:answer/id #uuid "46477b31-f16d-5120-a625-74e00bf51669" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-5$ and $3$" :db/id #edb/ref 17592186404020} :answer-field/id #uuid "6704063a-555e-57cc-88b9-c16e0fa9f2fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404017}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dc9954e3-432a-5a64-87f7-a9d25a9f95d6" :question/math-academy-id "q-79301" :question/problem "![](images/b3/b3bb8c00ab2e0ef3e7c1bc21726458e718e67897f28093321884bd1c67ca768f.png)\n\nWhat are the $y$-intercept of the parabola shown above?" :question/worked-solution "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(-4,-1)$ and passes through the point $(5,5).$\n\nThe general standard equation of a left- or right-opening parabola with vertex at $(h,k)$ is given by\n\n$$\n(y-k)^{2}=4p(x-h),\n$$\n\nand substituting $(h,k)=(-4,-1)$ into the above gives\n\n$$\n(y+1)^{2}=4p(x+4).\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(5,5),$ we substitute $x=5$ and $y=5$ into the equation and get\n\n$$\n\\begin{aligned}(5+1)^{2} & =4p(5+4) \\\\ 36 & =4p(9) \\\\ p & =1.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(y+1)^{2} & =4(x+4).\\end{aligned}\n$$\n\nWhen the parabola intersects the $y$-axis, we must have $x=0.$ So, we substitute $x=0$ into the equation of the parabola and solve for $y:$\n\n$$\n\\begin{aligned}(y+1)^{2} & =4(0+4) \\\\ (y+1)^{2} & =16 \\\\ y+1 & =\\pm 4 \\\\ y & =-5,3\\end{aligned}\n$$\n\nTherefore, the $y$-intercepts are $-5$ and $3.$"}] [{:db/id #edb/ref 17592186348212 :knowledge-point/_questions [{:db/id #edb/ref 17592186064163 :knowledge-point/id #uuid "e901ea71-aeab-5e95-939e-2401558aa708" :knowledge-point/title "Finding the Global Extrema of a Function on a Given Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33f84d54-d2bc-5c46-b2ab-d693afe8ba85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186345806} {:answer/id #uuid "5031b479-85a7-5a3e-8728-9f8cc509446c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186346035} {:answer/id #uuid "96f02c48-9437-54e5-9ae1-bf57514a64e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186346672} {:answer/id #uuid "a910f039-6ad8-5f20-b231-cfcdcff785b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186346822} {:answer/id #uuid "a96c2696-dce3-52b9-81ad-50a92e97e11b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186346829}] :answer-field/correct {:answer/id #uuid "96f02c48-9437-54e5-9ae1-bf57514a64e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186346672} :answer-field/id #uuid "fe36a5d6-6c8c-516e-b899-8edb77ba9308" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186348049}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "994781d9-56f3-563d-863d-42f598002e25" :question/math-academy-id "q-79342" :question/problem "Find the global minimum value of the function $f(x)=-{x}^{3}+3{x}^{2}-1$ on the closed interval $[-1,3].$" :question/worked-solution "Let's apply the candidates test step by step.\n\n**Step 1**: We find the critical points. Taking the derivative of $f(x)=-{x}^{3}+3{x}^{2}-1,$ we get\n\n$$\n{f}^{′}(x)=-3{x}^{2}+6x,\n$$\n\nand solving ${f}^{′}(x)=0,$ we get \n\n$$\n\\begin{aligned}-3{x}^{2}+6x & =0 \\\\ -3x(x-2) & =0 \\\\ x & =0,2.\\end{aligned}\n$$\n\nSo, the critical points are $x=0,2,$ and the endpoints $x=-1,3$ (since the derivative is not defined at the endpoints).\n\n**Step 2**: We evaluate $f(x)$ at the critical points.\n\n$$\n\\begin{aligned}f(-1) & =-(-1)^{3}+3(-1)^{2}-1=3 \\\\ f(0) & =-(0)^{3}+3(0)^{2}-1=-1 \\\\ f(2) & =-(2)^{3}+3(2)^{2}-1=3 \\\\ f(3) & =-(3)^{3}+3(3)^{2}-1=-1\\end{aligned}\n$$\n\n**Step 3**: We compare all of the values found in step $2.$\n\n- The greatest value is $f(-1)=f(2)=3,$ so the global maximum is $3.$\n\n- The smallest value is $f(0)=f(3)=-1,$ so the global minimum is $-1.$\n\n![](images/eb/ebc8acabf87ca5c3423f2f7c07637a87c5963d9cb080a4d52f9efd87846380d1.png)"}] [{:db/id #edb/ref 17592186348224 :knowledge-point/_questions [{:db/id #edb/ref 17592186100894 :knowledge-point/id #uuid "de2e3a7c-d4f0-5b0f-8014-1519fb3a9473" :knowledge-point/title "Finding Particular Solutions of Differential Equations by First Rearranging and Then Separating"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02894820-667a-5bb1-8d2d-4a0e95595d4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=3{e}^{x}-2" :db/id #edb/ref 17592186345370} {:answer/id #uuid "1d756a9d-9a70-50be-87ba-3a12ce907a55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=2{e}^{{x}^{2}}-1" :db/id #edb/ref 17592186345607} {:answer/id #uuid "4914777d-f2b5-57b0-a44a-c23834802afd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2{e}^{x}-1" :db/id #edb/ref 17592186345974} {:answer/id #uuid "b5d0bd7d-ae6a-5b73-af44-998074dd148c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{3}={e}^{{x}^{2}}" :db/id #edb/ref 17592186346935} {:answer/id #uuid "d13ddd57-da35-5009-922f-44e87553a2f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{3}=3{e}^{{x}^{2}}-2" :db/id #edb/ref 17592186347184}] :answer-field/correct {:answer/id #uuid "d13ddd57-da35-5009-922f-44e87553a2f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{3}=3{e}^{{x}^{2}}-2" :db/id #edb/ref 17592186347184} :answer-field/id #uuid "d0ce2963-49b7-5510-bb64-1ea4168634e2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347969}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "64550cf0-ae14-5b89-b54c-860d29b3d527" :question/math-academy-id "q-79425" :question/problem "Find the particular solution to the differential equation $3{y}^{2}\\frac{\\text{d}y}{\\text{d}x}-2x{y}^{3}=4x$ that satisfies $y(0)=1.$  Assume that $y>0.$" :question/worked-solution "We first find the general solution and then apply the given initial condition to find a particular solution.\n\nSeparating variables and integrating both sides with respect to $x,$ we get\n\n$$\n\\begin{aligned}3{y}^{2}\\frac{\\text{d}y}{\\text{d}x}-2x{y}^{3} & =4x \\\\ 3{y}^{2}\\frac{\\text{d}y}{\\text{d}x} & =2x(2+{y}^{3}) \\\\ \\frac{3{y}^{2}}{2+{y}^{3}}\\frac{\\text{d}y}{\\text{d}x} & =2x \\\\ \\int \\frac{3{y}^{2}}{2+{y}^{3}}\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int 2x\\,\\text{d}x \\\\ \\int \\frac{3{y}^{2}}{2+{y}^{3}}\\,\\text{d}y & ={x}^{2}+{C}_{1}.\\end{aligned}\n$$\n\nTo calculate the integral on the left-hand side of this equality, we use a substitution\n\n$$\nu=2+{y}^{3}\\,⟹\\,\\text{d}u=3{y}^{2}\\,\\text{d}y.\n$$\n\nThen  we have\n\n$$\n\\begin{aligned}\\int \\frac{3{y}^{2}}{2+{y}^{3}}\\text{d}y & =\\int \\frac{1}{2+{y}^{3}}(3{y}^{2}\\,\\text{d}y) \\\\  & =\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡|u|+{C}_{2} \\\\  & =\\operatorname{ln}⁡(2+{y}^{3})+{C}_{2},\\end{aligned}\n$$\n\nwhere we used that $y>0.$\n\nHence,\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(2+{y}^{3})+{C}_{2} & ={x}^{2}+{C}_{1} \\\\ \\operatorname{ln}⁡(2+{y}^{3}) & ={x}^{2}+{C}_{1}-{C}_{2} \\\\ {e}^{\\operatorname{ln}⁡(2+{y}^{3})} & ={e}^{{x}^{2}+{C}_{1}-{C}_{2}} \\\\ 2+{y}^{3} & =K{e}^{{x}^{2}} \\\\ {y}^{3} & =K{e}^{{x}^{2}}-2,\\end{aligned}\n$$\n\nwhere $K=\\pm {e}^{{C}_{1}-{C}_{2}}$ is an arbitrary constant. \n\nWe now apply the initial condition $y(0)=1$ to find $K:$\n\n$$\n\\begin{aligned}{1}^{3} & =K{e}^{{0}^{2}}-2 \\\\ 1 & =K-2 \\\\ K & =3\\,.\\end{aligned}\n$$\n\nSo we get the particular solution in implicit form:\n\n$$\n{y}^{3}=3{e}^{{x}^{2}}-2.\n$$"}] [{:db/id #edb/ref 17592186348233 :knowledge-point/_questions [{:db/id #edb/ref 17592186179648 :knowledge-point/id #uuid "63080bb8-7a6a-505d-813a-e6c99d337064" :knowledge-point/title "Adding and Subtracting a Number and a Rational Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "004712b6-f610-5c1b-85fc-ea7f5dac42b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3a-2}{a}" :db/id #edb/ref 17592186345356} {:answer/id #uuid "1f9c9fb7-186e-5b20-a5ae-9968ec5bb0cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(a+1)}{a}" :db/id #edb/ref 17592186345629} {:answer/id #uuid "5f647f49-d7f6-51ed-a318-7ae05732cfa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(a+2)}{a}" :db/id #edb/ref 17592186346174} {:answer/id #uuid "6edfa3c8-26af-59e1-83da-3da4f171bbe1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3a+2}{a}" :db/id #edb/ref 17592186346319} {:answer/id #uuid "8714236f-9c2b-58c3-a954-b1f5b9039774" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2-3a}{a}" :db/id #edb/ref 17592186346522}] :answer-field/correct {:answer/id #uuid "6edfa3c8-26af-59e1-83da-3da4f171bbe1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3a+2}{a}" :db/id #edb/ref 17592186346319} :answer-field/id #uuid "c86f26bc-cd60-5415-a7c8-50d3d722dac4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347952}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "381e5b72-d586-538b-b748-3282ad434825" :question/math-academy-id "q-79545" :question/problem "Write $3+\\frac{2}{a}$ as a single fraction." :question/worked-solution "Using the fact that $3=\\frac{3}{1},$ we can write the expression as\n\n$$\n\\frac{3}{1}+\\frac{2}{a}.\n$$\n\n \n\nIn order to add the two fractions, we need them to have a common denominator. So, we put both fractions over a common denominator of $a$ by multiplying the top and bottom of the first fraction by $a:$\n\n$$\n\\begin{aligned}\\frac{3}{1}+\\frac{2}{a} & = \\\\ \\frac{a}{a}\\cdot \\frac{3}{1}+\\frac{2}{a} & = \\\\ \\frac{3a}{a}+\\frac{2}{a}\\end{aligned}\n$$\n\nFinally, we add the fractions and simplify the result:\n\n$$\n\\begin{aligned}\\frac{3a}{a}+\\frac{2}{a} & = \\\\ \\frac{3a+2}{a}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348234 :knowledge-point/_questions [{:db/id #edb/ref 17592186068754 :knowledge-point/id #uuid "fb2231aa-8afa-57df-a43c-cb3add25b2cc" :knowledge-point/title "Adding Rational Expressions in Multiple Variables With Common Factors in the Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17060fa7-3524-5310-9dfd-dc07b4e8832c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3t+k}{2(k+3t)}" :db/id #edb/ref 17592186345555} {:answer/id #uuid "8e08b27c-99f7-56ac-8b9f-96e0b8ceef2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3t+2k}{2(k+3t)}" :db/id #edb/ref 17592186346586} {:answer/id #uuid "aaae7946-dd0b-5491-a675-76007cd01c9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3t+k}{k+3t}" :db/id #edb/ref 17592186346842} {:answer/id #uuid "c3dcd984-a6b9-52d2-bddf-c9136d14c8a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3t-2k}{2(k+3t)}" :db/id #edb/ref 17592186347043} {:answer/id #uuid "ce330a49-fcee-5fd6-95ef-e1da5c0f2f22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3t+2k}{k+3t}" :db/id #edb/ref 17592186347158}] :answer-field/correct {:answer/id #uuid "8e08b27c-99f7-56ac-8b9f-96e0b8ceef2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3t+2k}{2(k+3t)}" :db/id #edb/ref 17592186346586} :answer-field/id #uuid "7650f596-e2e4-5bc7-be67-53414e53752a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347815}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e830cbad-9670-547b-94f1-5280434ab395" :question/math-academy-id "q-79551" :question/problem "Simplify $\\frac{3t}{2(k+3t)}+\\frac{k}{k+3t}.$" :question/worked-solution "In order to add the two fractions, we need them to have a common denominator. Here, we can put both fractions over a common denominator of $2(k+3t)$ if we multiply the top and bottom of the second fraction by $2:$\n\n$$\n\\begin{aligned}\\frac{3t}{2(k+3t)}+\\frac{k}{k+3t} & = \\\\ \\frac{3t}{2(k+3t)}+\\frac{2}{2}\\cdot \\frac{k}{k+3t} & = \\\\ \\frac{3t}{2(k+3t)}+\\frac{2k}{2(k+3t)} & = \\\\ \\frac{3t+2k}{2(k+3t)} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393933 :knowledge-point/_questions [{:db/id #edb/ref 17592186096698 :knowledge-point/id #uuid "23789a74-f1e3-5e26-8678-21f84a11a12b" :knowledge-point/title "Sketching the Solution Curves of a Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25d0d86d-c06f-5faf-a0ed-e8ee4d8b2010" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8a/8ac5a8137dd22e9f7333315bc2f5e1120cdb46dc6fb84f938890c491563a86c7.png" :db/id #edb/ref 17592186393935} {:answer/id #uuid "7cb52152-df73-5351-900a-b8e3c2fe2eee" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f5/f59924b67013ab56263c9e58d283bd29b1869699488702fffc8f88d1de18e647.png" :db/id #edb/ref 17592186393936} {:answer/id #uuid "d01da734-6649-516c-965d-904f6eb30e75" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/41/4110727f4203228259f1ee4d95593e54c92731e986eb3bdcf9cc0692cf902aa4.png" :db/id #edb/ref 17592186393937} {:answer/id #uuid "a9ccb688-6ce7-56f2-8a91-5c430e62080a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/be/bec2fa9f6c2673fe9bc71fbdadb8f2cbf4c37ef05a38dd2486be3fac7e2b98d2.png" :db/id #edb/ref 17592186393938} {:answer/id #uuid "b8c43a80-cb88-5719-a3f8-6293badb40f6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/75/757072d5f7b2edaf1eb22e3e1a1c4135a387293396c9a4213ee3a2e213102ee6.png" :db/id #edb/ref 17592186393939}] :answer-field/correct {:answer/id #uuid "b8c43a80-cb88-5719-a3f8-6293badb40f6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/75/757072d5f7b2edaf1eb22e3e1a1c4135a387293396c9a4213ee3a2e213102ee6.png" :db/id #edb/ref 17592186393939} :answer-field/id #uuid "fe6588a4-c656-5e02-9be8-4235169132b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393934}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9720bec0-3da4-5217-8468-e4569ac0e63c" :question/math-academy-id "q-79563" :question/problem "Which of the following shows some of the solution curves of the differential equation $\\frac{\\text{d}y}{\\text{d}x}=3.$" :question/worked-solution "Integrating the equation, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =3\\int \\,\\text{d}x \\\\ y & =3x+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-2,0,2.$\n\n![](images/64/64b0962fbb38b2c64da68de01d1c6407174aa66f810b820ece7185866b7f8ff3.png)"}] [{:db/id #edb/ref 17592186348246 :knowledge-point/_questions [{:db/id #edb/ref 17592186229139 :knowledge-point/id #uuid "68148c93-9139-5deb-8a53-a05d63ec5930" :knowledge-point/title "Using Linearity Properties of Linear Differential Operators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1091a537-65da-5aab-8648-003ccae9fb8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+2x-1" :db/id #edb/ref 17592186345493} {:answer/id #uuid "2c3772cc-ee27-5a55-b8ab-bba7ce4ab8b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+x+3" :db/id #edb/ref 17592186345746} {:answer/id #uuid "931f1993-0058-5723-bf37-44a6e8a7a493" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-1" :db/id #edb/ref 17592186346639} {:answer/id #uuid "dbd686a9-aeb1-58b7-b30f-28f7511a7195" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+3" :db/id #edb/ref 17592186347276} {:answer/id #uuid "dfb28b26-67ef-5929-80d8-d33c14602dae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-x-4" :db/id #edb/ref 17592186347316}] :answer-field/correct {:answer/id #uuid "931f1993-0058-5723-bf37-44a6e8a7a493" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-1" :db/id #edb/ref 17592186346639} :answer-field/id #uuid "a411de83-915c-5063-97c9-39f2e6cb69e9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347896}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "305e47b7-08af-5f1f-8256-6dbdc2dc2a7f" :question/math-academy-id "q-79606" :question/problem "Suppose that $L$ is a linear differential operator such that $L({y}_{1})={x}^{2}+3x+5$ and $L({y}_{2})=x+2$ for some functions ${y}_{1}(x)$ and ${y}_{2}(x).$ What is $L({y}_{1}-3{y}_{2})?$" :question/worked-solution "For any linear differential operator,\n\n$$\nL(a{y}_{1}(x)+b{y}_{2}(x))=aL({y}_{1}(x))+bL({y}_{2}(x))\n$$\n\nwhere $a$ and $b$ are constants. \n\nIn our case, we have\n\n$$\n\\begin{aligned}L({y}_{1}-3{y}_{2}) & =L({y}_{1})-3L({y}_{2}) \\\\  & ={x}^{2}+3x+5-3(x+2) \\\\  & ={x}^{2}+3x+5-3x-6 \\\\  & ={x}^{2}-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348253 :knowledge-point/_questions [{:db/id #edb/ref 17592186068841 :knowledge-point/id #uuid "74b784e1-ad0e-5cf2-8b02-604a7098c6a9" :knowledge-point/title "Finding General Solutions by Rearranging Then Integrating"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d16c4a6-ec99-5254-95d5-c2498c545a1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={({x}^{3}+K)}^{2}" :db/id #edb/ref 17592186346012} {:answer/id #uuid "a9c2462b-f997-5c04-b171-95ec7c69c289" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3}{x}^{3/2}+K)}^{2}" :db/id #edb/ref 17592186346834} {:answer/id #uuid "aea245a2-f864-583c-93ae-1ffebcc63b01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{9}\\,{x}^{3/2}+K" :db/id #edb/ref 17592186346874} {:answer/id #uuid "ba319483-e1c6-5bee-ad75-c8afa87e7451" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{9}\\,{x}^{3}+K" :db/id #edb/ref 17592186346969} {:answer/id #uuid "ec814b88-7549-5acd-8292-f5bca233d961" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(3{x}^{1/2}+K)}^{2}" :db/id #edb/ref 17592186347437}] :answer-field/correct {:answer/id #uuid "a9c2462b-f997-5c04-b171-95ec7c69c289" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3}{x}^{3/2}+K)}^{2}" :db/id #edb/ref 17592186346834} :answer-field/id #uuid "798d40ee-1bd1-5a20-9b4d-e3b5e219a75d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347820}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5a2bae15-170e-5e1c-8377-f10d9fc5ad9d" :question/math-academy-id "q-79665" :question/problem "Find the general solution to the differential equation $\\frac{1}{\\sqrt{xy}}\\,{y}^{′}=1$ for $y\\ne 0.$" :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}\\frac{1}{\\sqrt{xy}}{y}^{′} & =1 \\\\ \\frac{1}{\\sqrt{xy}}\\,\\frac{\\text{d}y}{\\text{d}x} & =1 \\\\ \\frac{1}{\\sqrt{x}}\\cdot \\frac{1}{\\sqrt{y}}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =1 \\\\ \\frac{1}{\\sqrt{y}}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =\\sqrt{x}\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{y}}\\cdot \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\sqrt{x}\\,\\text{d}x \\\\ \\int \\frac{1}{\\sqrt{y}}\\,\\text{d}y & =\\int \\sqrt{x}\\,\\text{d}x \\\\ \\int {y}^{-1/2}\\,\\text{d}y & =\\int {x}^{1/2}\\,\\text{d}x \\\\ 2{y}^{1/2} & =\\frac{2}{3}{x}^{3/2}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n2{y}^{1/2}=\\frac{2}{3}{x}^{3/2}+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\n\\begin{aligned}2{y}^{1/2} & =\\frac{2}{3}{x}^{3/2}+C \\\\ {y}^{1/2} & =\\frac{1}{3}{x}^{3/2}+\\frac{C}{2} \\\\ y & ={(\\frac{1}{3}{x}^{3/2}+\\frac{C}{2})}^{2} \\\\ y & ={(\\frac{1}{3}{x}^{3/2}+K)}^{2}\\end{aligned}\n$$\n\nwhere $K=\\frac{C}{2}.$"}] [{:db/id #edb/ref 17592186348260 :knowledge-point/_questions [{:db/id #edb/ref 17592186087866 :knowledge-point/id #uuid "7de671ee-7bba-54ce-bec2-d2d6f5569f4a" :knowledge-point/title "Writing First-Order Linear ODEs in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0646fdce-fd3c-56a7-8137-632d215be116" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}-xy=2x" :db/id #edb/ref 17592186345404} {:answer/id #uuid "5a9afd84-fe8c-56a0-89e1-00f6ac764479" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}-(1+x)y=0" :db/id #edb/ref 17592186346123} {:answer/id #uuid "71040d28-62bb-5d78-b4e6-2a190574112e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}-xy={x}^{2}" :db/id #edb/ref 17592186346349} {:answer/id #uuid "d204e6a5-02d7-5404-bddf-a96974b0383d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}-y=-{x}^{2}" :db/id #edb/ref 17592186347190} {:answer/id #uuid "d895b1af-8150-5cb7-9f48-017f2ef90f34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}+xy=\\frac{1}{x}" :db/id #edb/ref 17592186347259}] :answer-field/correct {:answer/id #uuid "71040d28-62bb-5d78-b4e6-2a190574112e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}-xy={x}^{2}" :db/id #edb/ref 17592186346349} :answer-field/id #uuid "74ddf3aa-733e-5972-8973-46d76ff540e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347812}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f284d9d4-47c8-54c3-aa2b-11e7ba22d40f" :question/math-academy-id "q-79697" :question/problem "Write the following first-order linear ODE in standard form.\n\n$$\n(\\frac{1}{{x}^{2}})\\frac{\\text{d}y}{\\text{d}x}=\\frac{x+y}{x}\\,.\n$$" :question/worked-solution "A first order linear ODE is in standard form if it is written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x)\\,,\n$$\n\nwhere $P(x)$ and $Q(x)$ do not depend on $y.$\n\n$$\n\n$$\n\nWe have\n\n$$\n\\begin{aligned}(\\frac{1}{{x}^{2}})\\frac{\\text{d}y}{\\text{d}x} & =\\frac{x+y}{x} \\\\ \\frac{\\text{d}y}{\\text{d}x} & ={x}^{2}(\\frac{x+y}{x}) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =x(x+y) \\\\ \\frac{\\text{d}y}{\\text{d}x} & ={x}^{2}+xy \\\\ \\frac{\\text{d}y}{\\text{d}x}\\,+{{(-x)}_{⏟}}_{P(x)}y & ={{{x}^{2}}_{⏟}}_{Q(x)} \\\\ \\frac{\\text{d}y}{\\text{d}x}-xy & ={x}^{2}\\end{aligned}\n$$\n\nNow, the equation is written in standard form with $P(x)=-x$ and $Q(x)={x}^{2}.$"}] [{:db/id #edb/ref 17592186348264 :knowledge-point/_questions [{:db/id #edb/ref 17592186087741 :knowledge-point/id #uuid "ca7c76e6-204b-5b30-8e62-c53027b63448" :knowledge-point/title "Finding the Asymptotes of a Hyperbola Given Its Equation in Non-Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e8f461c-cd1b-5d79-9eab-431e0b86902c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\pm \\frac{3}{4}x" :db/id #edb/ref 17592186345470} {:answer/id #uuid "3bc7fc55-6417-5729-a74f-354bd73b038b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\pm \\frac{5}{2}x" :db/id #edb/ref 17592186345858} {:answer/id #uuid "62eff5cf-3541-522c-8384-a8e13cf0a9ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\pm \\frac{3}{2}x" :db/id #edb/ref 17592186346213} {:answer/id #uuid "746d66ce-5d8c-5318-84ff-4b207f4edc16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\pm \\frac{5}{4}x" :db/id #edb/ref 17592186346379} {:answer/id #uuid "9d038273-ddb3-54ae-955b-1ea96c39c476" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\pm \\frac{2}{5}x" :db/id #edb/ref 17592186346720}] :answer-field/correct {:answer/id #uuid "3bc7fc55-6417-5729-a74f-354bd73b038b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\pm \\frac{5}{2}x" :db/id #edb/ref 17592186345858} :answer-field/id #uuid "be7882be-b192-5f7c-b8f8-f377af107f4b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347939}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5f0ff752-d06a-552e-a2c4-70426d87d48f" :question/math-academy-id "q-7973" :question/problem "Calculate the asymptotes of the hyperbola $25{x}^{2}-4{y}^{2}=100.$" :question/worked-solution "The standard equation of a horizontal hyperbola centered at the origin is\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nFor a horizontal hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{b}{a}x.\n$$\n\nTo rewrite the given equation in standard form, we divide both sides of the equation by $100$ and then simplify, as follows:\n\n$$\n\\begin{aligned}25{x}^{2}-4{y}^{2} & =100 \\\\ \\frac{25{x}^{2}}{100}-\\frac{4{y}^{2}}{100} & =\\frac{100}{100} \\\\ \\frac{{x}^{2}}{4}-\\frac{{y}^{2}}{25} & =1\\end{aligned}\n$$\n\nSo, we have $a=\\sqrt{4}=2,$ and $b=\\sqrt{25}=5.$ \n\nTherefore, the asymptotes are $y=\\pm \\frac{5}{2}x.$"}] [{:db/id #edb/ref 17592186348272 :knowledge-point/_questions [{:db/id #edb/ref 17592186087741 :knowledge-point/id #uuid "ca7c76e6-204b-5b30-8e62-c53027b63448" :knowledge-point/title "Finding the Asymptotes of a Hyperbola Given Its Equation in Non-Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0334ce94-04df-58b2-a3ae-96cd7879e487" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\pm \\frac{4}{5}x" :db/id #edb/ref 17592186345378} {:answer/id #uuid "901a0f74-2b42-53f8-a0c8-81f53f26c186" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\pm \\frac{5}{2}x" :db/id #edb/ref 17592186346605} {:answer/id #uuid "df27b8df-7a8f-5ff8-ad03-3e29e3371379" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\pm \\frac{2}{5}x" :db/id #edb/ref 17592186347313} {:answer/id #uuid "ee9f596a-8dbe-569b-a202-f5c5cc32d754" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\pm \\frac{5}{4}x" :db/id #edb/ref 17592186347458} {:answer/id #uuid "fa273e26-674f-506f-a5e4-6bab9b15ea89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\pm \\frac{5}{8}x" :db/id #edb/ref 17592186347560}] :answer-field/correct {:answer/id #uuid "ee9f596a-8dbe-569b-a202-f5c5cc32d754" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\pm \\frac{5}{4}x" :db/id #edb/ref 17592186347458} :answer-field/id #uuid "11e0e288-ecac-50f7-b190-c20ba7a6fb2c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347639}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2a23dcd1-c9c5-5d5c-9924-bc34213edb45" :question/math-academy-id "q-7975" :question/problem "Find the asymptotes of the hyperbola $25{x}^{2}-16{y}^{2}=400.$" :question/worked-solution "The standard equation of a horizontal hyperbola centered at the origin is\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nFor a horizontal hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{b}{a}x.\n$$\n\nTo rewrite the given equation in standard form, we divide both sides of the equation by $400$ and then simplify, as follows:\n\n$$\n\\begin{aligned}25{x}^{2}-16{y}^{2} & =400 \\\\ \\frac{25{x}^{2}}{400}-\\frac{16{y}^{2}}{400} & =\\frac{400}{400} \\\\ \\frac{{x}^{2}}{16}-\\frac{{y}^{2}}{25} & =1\\end{aligned}\n$$\n\nSo, we have $a=\\sqrt{16}=4,$ and $b=\\sqrt{25}=5.$ \n\nTherefore, the asymptotes are $y=\\pm \\frac{5}{4}x.$"}] [{:db/id #edb/ref 17592186348276 :knowledge-point/_questions [{:db/id #edb/ref 17592186087867 :knowledge-point/id #uuid "bc50a680-dbf8-5d45-a8c3-72c3c15243f6" :knowledge-point/title "Identifying First-Order Linear ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b63f23d-3741-54dc-9da9-b5e686f502a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{y})\\frac{\\text{d}y}{\\text{d}x}=\\frac{2y+{x}^{2}}{y}" :db/id #edb/ref 17592186345735} {:answer/id #uuid "50784efb-ac52-5b2a-930e-224a3c46e1de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{y})\\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{y\\operatorname{cos}⁡x}-y" :db/id #edb/ref 17592186346039} {:answer/id #uuid "5e7e5b5f-00cc-57b5-b9a0-eabad58dd3f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{2}+3x}{y}" :db/id #edb/ref 17592186346165} {:answer/id #uuid "a42c961b-9393-58eb-a38e-3ff82db15d10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\frac{\\text{d}y}{\\text{d}x}={y}^{2}-2x" :db/id #edb/ref 17592186346775} {:answer/id #uuid "f7e532ee-210c-54c5-b6ba-20b24eb7144c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{y})\\frac{\\text{d}y}{\\text{d}x}=\\frac{y-x}{{y}^{2}}" :db/id #edb/ref 17592186347547}] :answer-field/correct {:answer/id #uuid "2b63f23d-3741-54dc-9da9-b5e686f502a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{y})\\frac{\\text{d}y}{\\text{d}x}=\\frac{2y+{x}^{2}}{y}" :db/id #edb/ref 17592186345735} :answer-field/id #uuid "b6bd8f24-231f-5b7f-ad71-f5ad51631cdd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347926}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c92a3ce0-666c-5499-94f8-c31ec02af3a5" :question/math-academy-id "q-79754" :question/problem "Which of the following is a first-order linear ordinary differential equation?" :question/worked-solution "To determine which of the following differential equations is a first-order linear ordinary differential equation, we attempt to write each option in the standard form.\n\nA first-order linear ODE is in standard form if it is written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x).\n$$\n\nLet's attempt to write $(\\frac{1}{y})\\frac{\\text{d}y}{\\text{d}x}=\\frac{2y+{x}^{2}}{y}$ in the standard form:\n\n$$\n\\begin{aligned}(\\frac{1}{y})\\frac{\\text{d}y}{\\text{d}x} & =\\frac{2y+{x}^{2}}{y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =y(\\frac{2y+{x}^{2}}{y}) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =2y+{x}^{2} \\\\ \\frac{\\text{d}y}{\\text{d}x}-2y & ={x}^{2}.\\end{aligned}\n$$\n\nThis differential equation is in standard form with  $P(x)=-2$ and $Q(x)={x}^{2}.$ Since the equation is written in standard form, we conclude that it is a first-order linear ODE.\n\nAll of the other equations cannot be written in the standard form, and therefore they are not first-order linear ODEs."}] [{:db/id #edb/ref 17592186404058 :knowledge-point/_questions [{:db/id #edb/ref 17592186152169 :knowledge-point/id #uuid "101e0c22-fbb4-5865-af5f-d669e2488d09" :knowledge-point/title "Identifying Solutions to Linear ODEs Using the Superposition Principle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cfbba14c-2f05-5726-a785-65e6001ed044" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186404060} {:answer/id #uuid "4c881cec-e1cd-5edf-9137-3cff2e33554f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186404061} {:answer/id #uuid "641040d1-65b8-5f54-96f4-8c708a40416c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186404062} {:answer/id #uuid "3591323b-6891-5cae-8d4e-c948451b3786" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186404063} {:answer/id #uuid "f99f217b-b9d6-5f00-901a-4222c7e159a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186404064}] :answer-field/correct {:answer/id #uuid "4c881cec-e1cd-5edf-9137-3cff2e33554f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186404061} :answer-field/id #uuid "ae248aa2-3ead-50b7-9e6b-de77efc79d9c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404059}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "742f0d7e-0be6-5200-afaf-b211266d03e0" :question/math-academy-id "q-79799" :question/problem "Given that ${y}_{1}(t)={e}^{-t}$ and ${y}_{2}(t)={e}^{4t}$ are solutions to the equation ${y}^{″}-3{y}^{′}-4y=0,$ which of the following must also be a solution to the equation?\n\nI. $y(t)={e}^{-t-1}$\nII. $y(t)=7{e}^{-t}-3{e}^{-4t}$\nIII. $y(t)=\\frac{{e}^{4t}}{4}$" :question/worked-solution "According to the superposition principle, if the functions ${y}_{1}(t)$ and ${y}_{2}(t)$ are solutions to a homogeneous, linear differential equation, and ${c}_{1}$ and ${c}_{2}$ are constants, then $y(t)={c}_{1}{y}_{1}(t)+{c}_{2}{y}_{2}(t)$ is also a solution to the equation.\n\nWe're given that ${y}_{1}(t)={e}^{-t}$ and ${y}_{2}(t)={e}^{4t}.$ Therefore, the following function is also a solution:\n\n$$\ny(t)={c}_{1}{e}^{-t}+{c}_{2}{e}^{4t}\n$$\n\nLet's consider each option:\n\n- The function $y(t)={e}^{-t-1}=\\frac{{e}^{-t}}{e}$ is a solution of the given equation. Here, ${c}_{1}=\\frac{1}{e},{c}_{2}=0.$\n\n- The function $y(t)=7{e}^{-t}-3{e}^{-4t}$ is **not** a solution of the given equation because ${e}^{-4t}$ is not a solution.\n\n- The function $y(t)=\\frac{{e}^{4t}}{4}$ is a solution of the given equation. Here, ${c}_{1}=0,{c}_{2}=\\frac{1}{4}.$"}] [{:db/id #edb/ref 17592186348307 :knowledge-point/_questions [{:db/id #edb/ref 17592186087745 :knowledge-point/id #uuid "d6ebe1f1-40fe-5226-8aed-b321f2e1e58b" :knowledge-point/title "Finding the Cartesian Equation of a Hyperbola Given its Parametric Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a2a75ed-57e2-5884-b50c-5bdf791a44f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{6}-\\frac{{y}^{2}}{\\sqrt{7}}=1" :db/id #edb/ref 17592186345986} {:answer/id #uuid "71a0f2da-29b3-5ae0-a966-504ff923d5e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{7}-\\frac{{y}^{2}}{36}=1" :db/id #edb/ref 17592186346356} {:answer/id #uuid "b31a1ca5-2578-50af-8c48-2a9711fbfff2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{36}-\\frac{{y}^{2}}{7}=1" :db/id #edb/ref 17592186346913} {:answer/id #uuid "c961680d-45fa-5b4b-862e-1095704f9627" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{6}-\\frac{{y}^{2}}{7}=1" :db/id #edb/ref 17592186347106} {:answer/id #uuid "f2713ff8-bdd9-5940-8318-69f69c6f4266" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{36}-\\frac{{y}^{2}}{\\sqrt{7}}=1" :db/id #edb/ref 17592186347496}] :answer-field/correct {:answer/id #uuid "b31a1ca5-2578-50af-8c48-2a9711fbfff2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{36}-\\frac{{y}^{2}}{7}=1" :db/id #edb/ref 17592186346913} :answer-field/id #uuid "f6a508fc-f6de-5a67-a859-9cb9903400ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186348039}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2ffb1927-f785-52cd-bb94-7d0e36fd51ee" :question/math-academy-id "q-7988" :question/problem "Find the Cartesian equation of the hyperbola $x=6\\operatorname{sec}⁡t,\\,y=\\sqrt{7}\\operatorname{tan}⁡t.$" :question/worked-solution "To find the Cartesian equation of the hyperbola, we need to eliminate the parameter $t.$ We can do this using the secant-tangent identity.\n\n- Isolating the $\\operatorname{sec}⁡t$ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =6\\operatorname{sec}⁡t \\\\ \\frac{x}{6} & =\\operatorname{sec}⁡t \\\\ \\frac{{x}^{2}}{{6}^{2}} & ={sec}^{2}⁡t \\\\ \\frac{{x}^{2}}{36} & ={sec}^{2}⁡t.\\end{aligned}\n$$\n\n- Isolating the $\\operatorname{tan}⁡t$ term in the $y$-equation and squaring, we get]\n\n$$\n\\begin{aligned}y & =\\sqrt{7}\\operatorname{tan}⁡t \\\\ \\frac{y}{\\sqrt{7}} & =\\operatorname{tan}⁡t \\\\ \\frac{{y}^{2}}{{(\\sqrt{7})}^{2}} & ={tan}^{2}⁡t \\\\ \\frac{{y}^{2}}{7} & ={tan}^{2}⁡t.\\end{aligned}\n$$\n\nSubstituting the two equations into the identity ${tan}^{2}⁡t+1={sec}^{2}⁡t$ and rearranging, we get\n\n$$\n\\begin{aligned}{tan}^{2}⁡t+1 & ={sec}^{2}⁡t \\\\ \\frac{{y}^{2}}{7}+1 & =\\frac{{x}^{2}}{36} \\\\ \\frac{{x}^{2}}{36}-\\frac{{y}^{2}}{7} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186088379 :knowledge-point/_questions [{:db/id #edb/ref 17592186087837 :knowledge-point/id #uuid "395f435d-473f-5dae-b215-2986556d5793" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Horizontal or Vertical Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98968c97-ac7a-5a21-a15c-99c1104ce551" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5, ± \\frac{3}{4})" :db/id #edb/ref 17592186086928} {:answer/id #uuid "d2c81096-fc68-5fca-89f7-181e6edfac06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5, ± \\frac{3}{2})" :db/id #edb/ref 17592186086929} {:answer/id #uuid "f4f21d20-7075-55f5-b4af-bfe236a4f87c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5, ± \\frac{9}{2})" :db/id #edb/ref 17592186086930} {:answer/id #uuid "0f922b48-c61f-547b-a27e-a5a544c198cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5, ± \\frac{9}{4})" :db/id #edb/ref 17592186086931} {:answer/id #uuid "4a77f2b7-4168-597c-9446-997bf8380fa5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5, ± 12)" :db/id #edb/ref 17592186086932}] :answer-field/id #uuid "db1fade0-b04b-5d11-99e3-f6ff0d2aafdf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086927} {:answer-field/choices [{:answer/id #uuid "fd6983c6-2a3a-5a74-9155-3140c3b16817" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,\\pm \\frac{3}{2})" :db/id #edb/ref 17592186395946} {:answer/id #uuid "c1fa6e68-6023-531a-88de-a62dd4b4692b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,\\pm 12)" :db/id #edb/ref 17592186395947} {:answer/id #uuid "065f5013-a6a4-59df-9c2e-0ed50e4f3f57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,\\pm \\frac{9}{4})" :db/id #edb/ref 17592186395948} {:answer/id #uuid "c143c2b9-589b-5044-8878-4be12b83a9e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,\\pm \\frac{3}{4})" :db/id #edb/ref 17592186395949} {:answer/id #uuid "6792e8d3-e7b8-5579-b7f7-7456877be5f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,\\pm \\frac{9}{2})" :db/id #edb/ref 17592186395950}] :answer-field/correct {:answer/id #uuid "065f5013-a6a4-59df-9c2e-0ed50e4f3f57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,\\pm \\frac{9}{4})" :db/id #edb/ref 17592186395948} :answer-field/id #uuid "3572ea5b-ba63-553c-87ba-5e4b8e0f9213" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395945}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2125dbf2-368d-5ee6-b919-9a772694e1b8" :question/math-academy-id "q-8005" :question/problem "Calculate the points where the hyperbola $9{x}^{2}-16{y}^{2}=144$ intersects the line $x=5.$" :question/worked-solution "To find the points where the hyperbola intersects the line $x=5,$ we substitute $x=5$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}9{x}^{2}-16{y}^{2} & =144 \\\\ 9(5)^{2}-16{y}^{2} & =144 \\\\ -16{y}^{2} & =144-225 \\\\ -16{y}^{2} & =-81 \\\\ {y}^{2} & =\\frac{81}{16} \\\\ y & =\\pm \\frac{9}{4}\\end{aligned}\n$$\n\nTherefore, the hyperbola intersects the vertical line $x=5$ at the points $(5,\\pm \\frac{9}{4}).$"}] [{:db/id #edb/ref 17592186348326 :knowledge-point/_questions [{:db/id #edb/ref 17592186087837 :knowledge-point/id #uuid "395f435d-473f-5dae-b215-2986556d5793" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Horizontal or Vertical Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02663bbe-2654-5af5-9b5b-4e8c4e1916cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\pm 3,1)" :db/id #edb/ref 17592186345369} {:answer/id #uuid "2c8a94e6-9604-515d-86fc-d1c348b467d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\pm 1,1)" :db/id #edb/ref 17592186345749} {:answer/id #uuid "3a56a2bb-8115-5c70-ac47-863f5a1b19b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-6,1)$ and $(2,1)$" :db/id #edb/ref 17592186345851} {:answer/id #uuid "6a8a58ca-7ff3-535a-805c-0eea1646f6c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\pm 2,1)" :db/id #edb/ref 17592186346274} {:answer/id #uuid "6f2db012-5162-544b-a35a-b2c61a955eb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\pm 6,1)" :db/id #edb/ref 17592186346324}] :answer-field/correct {:answer/id #uuid "02663bbe-2654-5af5-9b5b-4e8c4e1916cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\pm 3,1)" :db/id #edb/ref 17592186345369} :answer-field/id #uuid "ebdacf6a-0495-5e9a-8dad-4bfebbc2c674" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186348022}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "da37c5c2-1cf7-558e-986b-281da0d2eca6" :question/math-academy-id "q-8008" :question/problem "Calculate the points where the hyperbola \n$\\frac{{x}^{2}}{6}-\\frac{{y}^{2}}{2}=1$\nintersects the line $y=1.$" :question/worked-solution "To find the points where the hyperbola intersects the line $y=1,$ we substitute $y=1$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{6}-\\frac{{y}^{2}}{2} & =1 \\\\ \\frac{{x}^{2}}{6}-\\frac{(1)^{2}}{2} & =1 \\\\ \\frac{{x}^{2}}{6}-\\frac{1}{2} & =1 \\\\ \\frac{{x}^{2}}{6} & =\\frac{3}{2} \\\\ {x}^{2} & =9 \\\\ x & =\\pm 3\\end{aligned}\n$$\n\nTherefore, the hyperbola intersects the horizontal line $y=1$ at the points $(\\pm 3,1).$"}] [{:db/id #edb/ref 17592186348327 :knowledge-point/_questions [{:db/id #edb/ref 17592186129142 :knowledge-point/id #uuid "5dce1c69-c79d-541a-b479-8fc127352c2a" :knowledge-point/title "Identifying the Graph of a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "218cb034-3e85-59b7-a903-56bfc598b9b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the given options is correct" :db/id #edb/ref 17592186345650} {:answer/id #uuid "5f26a8c0-2af0-5bee-a1cd-0bf2f5569905" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A" :db/id #edb/ref 17592186346172} {:answer/id #uuid "6db0d065-e8ef-5454-9cf2-b8d92a429fa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B" :db/id #edb/ref 17592186346309} {:answer/id #uuid "afcb4450-4ae6-54b7-b7e5-2a45c0d057a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C" :db/id #edb/ref 17592186346883} {:answer/id #uuid "c8fffe14-90a9-51ed-b231-0b2a4af2d1c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D" :db/id #edb/ref 17592186347102}] :answer-field/correct {:answer/id #uuid "c8fffe14-90a9-51ed-b231-0b2a4af2d1c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D" :db/id #edb/ref 17592186347102} :answer-field/id #uuid "5a7510d2-2b7e-5e14-bd9b-6604c31ce57e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347762}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "de44d5ab-abd2-5362-b1b7-cef838348808" :question/math-academy-id "q-80107" :question/problem "![](images/f1/f1f31073c260d8111cca3d5de1ec6db3e0f7f76a13c9a41a71b5512acd17f704.png)\n\nWhich of the diagrams above can be the graph of the polynomial $y=-{x}^{5}+4{x}^{2}-3?$" :question/worked-solution "Let's call $P(x)$ the given polynomial:\n\n$$\nP(x)=-{x}^{5}+4{x}^{2}-3\n$$\n\nThe degree $(n=5)$ is odd and the leading coefficient $({a}_{5}=-1)$ is negative. Therefore, the polynomial has the following end behavior:\n\n- $P(x)\\to \\infty $ as $x\\to -\\infty .$\n\n- $P(x)\\to -\\infty $ as $x\\to \\infty .$\n\nOnly the graph $D$ satisfies these conditions."}] [{:db/id #edb/ref 17592186375391 :knowledge-point/_questions [{:db/id #edb/ref 17592186096607 :knowledge-point/id #uuid "3dba0779-e903-5281-bc41-01b78c31a98c" :knowledge-point/title "Finding the Amplitude for the Amplitude-Phase Form for Sine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab812d70-45cd-5fc4-977a-eb0e8d7e99b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}" :db/id #edb/ref 17592186375393} {:answer/id #uuid "5e21fe64-04a9-5db5-b1a3-726079c6936a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186375394} {:answer/id #uuid "1014778a-719a-5d01-ba8a-3e449b7d789b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186375395} {:answer/id #uuid "d54de508-bc92-58b6-8acf-80a84c8c04f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{15}" :db/id #edb/ref 17592186375396} {:answer/id #uuid "74416f3f-dbf1-5d04-9f1f-f8af7ebf44a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186375397}] :answer-field/correct {:answer/id #uuid "1014778a-719a-5d01-ba8a-3e449b7d789b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186375395} :answer-field/id #uuid "9888652c-f430-506d-ac1c-1d04f321a57a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375392}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ae98c900-47ef-535f-8f48-089b06b6849b" :question/math-academy-id "q-80126" :question/problem "Given that the expression $\\sqrt{7}\\operatorname{sin}⁡x+3\\operatorname{cos}⁡x$ can be written as $R\\operatorname{sin}⁡(x+ϕ)$ with $R>0,$ what is the value of $R?$" :question/worked-solution "The sum formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(x+ϕ) & =R(\\operatorname{sin}⁡x\\operatorname{cos}⁡ϕ+\\operatorname{cos}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡x+R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n\\sqrt{7}\\operatorname{sin}⁡x+3\\operatorname{cos}⁡x=R\\operatorname{sin}⁡(x+ϕ),\n$$\n\nwe get the following identity:\n\n$$\n\\sqrt{7}\\operatorname{sin}⁡x+3\\operatorname{cos}⁡x=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡x+(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡x\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n{\\begin{aligned}R\\operatorname{cos}⁡ϕ=\\sqrt{7} \\\\ R\\operatorname{sin}⁡ϕ=3\\end{aligned}\n$$\n\nSquaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{(R\\operatorname{cos}⁡ϕ)}^{2}+{(R\\operatorname{sin}⁡ϕ)}^{2} & =(\\sqrt{7})^{2}+{3}^{2} \\\\ {R}^{2}({cos}^{2}⁡ϕ+{sin}^{2}⁡ϕ) & =7+9 \\\\ {R}^{2} & =16 \\\\ R & =4.\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$"}] [{:db/id #edb/ref 17592186375398 :knowledge-point/_questions [{:db/id #edb/ref 17592186096607 :knowledge-point/id #uuid "3dba0779-e903-5281-bc41-01b78c31a98c" :knowledge-point/title "Finding the Amplitude for the Amplitude-Phase Form for Sine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e0fea35-a671-519d-81d8-c7fb9c55c04f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186375400} {:answer/id #uuid "f36ec5dc-5ef4-5369-ae67-2119f8c2cc77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}" :db/id #edb/ref 17592186375401} {:answer/id #uuid "1b308beb-0b5b-5f3d-85e8-35362b8afb42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186375402} {:answer/id #uuid "53326772-fe0d-5ce2-9e5b-3d118a3e64cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{17}" :db/id #edb/ref 17592186375403} {:answer/id #uuid "64500117-d7a7-5648-adf2-9d2228ee5909" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186375404}] :answer-field/correct {:answer/id #uuid "53326772-fe0d-5ce2-9e5b-3d118a3e64cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{17}" :db/id #edb/ref 17592186375403} :answer-field/id #uuid "8e2e932e-dbf3-5448-b387-d826c12c2112" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375399}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5b0d5f22-44db-5651-bca5-e49d8353b75a" :question/math-academy-id "q-80131" :question/problem "Given that the expression $4\\operatorname{sin}⁡x-\\operatorname{cos}⁡x$ can be written as $R\\operatorname{sin}⁡(x-ϕ)$ with $R>0,$ what is the value of $R?$" :question/worked-solution "The difference formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(x-ϕ) & =R(\\operatorname{sin}⁡x\\operatorname{cos}⁡ϕ-\\operatorname{cos}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡x-R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n4\\operatorname{sin}⁡x-\\operatorname{cos}⁡x=R\\operatorname{sin}⁡(x-ϕ),\n$$\n\nwe get the following identity:\n\n$$\n4\\operatorname{sin}⁡x-\\operatorname{cos}⁡x=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡x-(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡x\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n{\\begin{aligned}R\\operatorname{cos}⁡ϕ=4 \\\\ R\\operatorname{sin}⁡ϕ=1\\end{aligned}\n$$\n\nSquaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{(R\\operatorname{cos}⁡ϕ)}^{2}+{(R\\operatorname{sin}⁡ϕ)}^{2} & ={4}^{2}+{1}^{2} \\\\ {R}^{2}({cos}^{2}⁡ϕ+{sin}^{2}⁡ϕ) & =16+1 \\\\ {R}^{2} & =17 \\\\ R & =\\sqrt{17}.\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$"}] [{:db/id #edb/ref 17592186348342 :knowledge-point/_questions [{:db/id #edb/ref 17592186096606 :knowledge-point/id #uuid "74c40813-d2aa-5eff-b5dc-69a2f916f865" :knowledge-point/title "Finding the Phase for the Amplitude-Phase Form for Sine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17600165-efc3-5882-9c7a-cb635534d60a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{80}^{∘}" :db/id #edb/ref 17592186345557} {:answer/id #uuid "1ba85996-663d-5ad4-b02a-6d0bddc40c4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{45}^{∘}" :db/id #edb/ref 17592186345591} {:answer/id #uuid "37b2b4a7-6276-57d8-81aa-bd4be528f582" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{30}^{∘}" :db/id #edb/ref 17592186345830} {:answer/id #uuid "92b2d726-2dc6-525f-b4d0-e8875bc3f2e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{20}^{∘}" :db/id #edb/ref 17592186346633} {:answer/id #uuid "d529acba-b4d3-55d8-bdf2-155c9910a474" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{60}^{∘}" :db/id #edb/ref 17592186347226}] :answer-field/correct {:answer/id #uuid "1ba85996-663d-5ad4-b02a-6d0bddc40c4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{45}^{∘}" :db/id #edb/ref 17592186345591} :answer-field/id #uuid "f579af6d-d006-5c83-962e-5ae07618e854" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186348035}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7bbd6a2b-6a4a-5f26-8d86-72b22a64837d" :question/math-academy-id "q-80135" :question/problem "Given that the expression $5\\operatorname{sin}⁡x-5\\operatorname{cos}⁡x$ can be written as $R\\operatorname{sin}⁡(x-ϕ)$ with ${0}^{∘}<ϕ<{90}^{∘}$ and $R>0$, what is the value of $ϕ?$" :question/worked-solution "The difference formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(x-ϕ) & =R(\\operatorname{sin}⁡x\\operatorname{cos}⁡ϕ-\\operatorname{cos}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡x-R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡x\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n5\\operatorname{sin}⁡x-5\\operatorname{cos}⁡x=R\\operatorname{sin}⁡(x-ϕ),\n$$\n\nwe get the following identity:\n\n$$\n5\\operatorname{sin}⁡x-5\\operatorname{cos}⁡x=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡x-(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡x\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n\\{\\begin{aligned}R\\operatorname{cos}⁡ϕ=5 \\\\ R\\operatorname{sin}⁡ϕ=5\\end{aligned}\n$$\n\nDividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{R\\operatorname{sin}⁡ϕ}{R\\operatorname{cos}⁡ϕ} & =\\frac{5}{5} \\\\ \\operatorname{tan}⁡ϕ & =1 \\\\ ϕ & ={45}^{∘}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348343 :knowledge-point/_questions [{:db/id #edb/ref 17592186096606 :knowledge-point/id #uuid "74c40813-d2aa-5eff-b5dc-69a2f916f865" :knowledge-point/title "Finding the Phase for the Amplitude-Phase Form for Sine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77dc6fdd-2db7-55bf-abb5-b59442a1464c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡(2)" :db/id #edb/ref 17592186346402} {:answer/id #uuid "b477c45c-b737-549b-91b5-d1091460ac32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡(\\frac{3}{2})" :db/id #edb/ref 17592186346923} {:answer/id #uuid "d114ac37-9962-5408-9d6e-05d942670183" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡(4)" :db/id #edb/ref 17592186347182} {:answer/id #uuid "e341ede8-046b-52c2-b8b6-aa4cf9fe8ca2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡(\\frac{5}{2})" :db/id #edb/ref 17592186347350} {:answer/id #uuid "fe903f8c-2fae-5ab6-9e3a-9928ee1b850e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡(3)" :db/id #edb/ref 17592186347588}] :answer-field/correct {:answer/id #uuid "d114ac37-9962-5408-9d6e-05d942670183" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡(4)" :db/id #edb/ref 17592186347182} :answer-field/id #uuid "6df7bc06-d4ba-5a57-ab49-fe4b9ffa350a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347804}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b478a4e0-e373-5d4c-8f17-c97eaae0c7f7" :question/math-academy-id "q-80136" :question/problem "Given that the expression $2\\operatorname{sin}⁡x-8\\operatorname{cos}⁡x$ can be written as $R\\operatorname{sin}⁡(x-ϕ)$ with ${0}^{∘}<ϕ<{90}^{∘}$ and $R>0$, what is the value of $ϕ?$" :question/worked-solution "The difference formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(x-ϕ) & =R(\\operatorname{sin}⁡x\\operatorname{cos}⁡ϕ-\\operatorname{cos}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡x-R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡x\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n2\\operatorname{sin}⁡x-8\\operatorname{cos}⁡x=R\\operatorname{sin}⁡(x-ϕ),\n$$\n\nwe get the following identity:\n\n$$\n2\\operatorname{sin}⁡x-8\\operatorname{cos}⁡x=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡x-(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡x\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n\\{\\begin{aligned}R\\operatorname{cos}⁡ϕ=2 \\\\ R\\operatorname{sin}⁡ϕ=8\\end{aligned}\n$$\n\nDividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{R\\operatorname{sin}⁡ϕ}{R\\operatorname{cos}⁡ϕ} & =\\frac{8}{2} \\\\ \\operatorname{tan}⁡ϕ & =4 \\\\ ϕ & =\\operatorname{arctan}⁡(4).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348344 :knowledge-point/_questions [{:db/id #edb/ref 17592186096608 :knowledge-point/id #uuid "65b4e8e7-e558-50e7-a1ec-37a6eff77e87" :knowledge-point/title "Finding the Amplitude-Phase Form for Sine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "159c485c-001f-5031-b26e-f83f2bfeaf3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{sin}⁡(x-{45}^{∘})" :db/id #edb/ref 17592186345538} {:answer/id #uuid "8be5f15a-55d3-55ce-9ad8-ff6f91eee7c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{2}\\operatorname{sin}⁡(x-{45}^{∘})" :db/id #edb/ref 17592186346562} {:answer/id #uuid "936ec69f-b82c-51aa-b0f0-19d6eaccfe93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}\\operatorname{sin}⁡(x-{30}^{∘})" :db/id #edb/ref 17592186346640} {:answer/id #uuid "940a0cb2-9a0f-54ac-81e8-736d1cba6508" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}\\operatorname{sin}⁡(x-{60}^{∘})" :db/id #edb/ref 17592186346643} {:answer/id #uuid "ca9d53ec-b344-5b9f-8c8e-a292d0704445" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{3}\\operatorname{sin}⁡(x-{45}^{∘})" :db/id #edb/ref 17592186347118}] :answer-field/correct {:answer/id #uuid "8be5f15a-55d3-55ce-9ad8-ff6f91eee7c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{2}\\operatorname{sin}⁡(x-{45}^{∘})" :db/id #edb/ref 17592186346562} :answer-field/id #uuid "419a1eeb-4e9d-5a0c-8435-a16640782af5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347715}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c9f0ee2e-ecf1-5ebf-8f05-484d1b3df712" :question/math-academy-id "q-80138" :question/problem "$4\\operatorname{sin}⁡x-4\\operatorname{cos}⁡x=$" :question/worked-solution "The difference formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(x-ϕ) & =R(\\operatorname{sin}⁡x\\operatorname{cos}⁡ϕ-\\operatorname{cos}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡x-R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n4\\operatorname{sin}⁡x-4\\operatorname{cos}⁡x=R\\operatorname{sin}⁡(x-ϕ),\n$$\n\nwe get the following identity:\n\n$$\n4\\operatorname{sin}⁡x-4\\operatorname{cos}⁡x=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡x-(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡x\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n\\{\\begin{aligned}R\\operatorname{cos}⁡ϕ=4 \\\\ R\\operatorname{sin}⁡ϕ=4\\end{aligned}\n$$\n\nDividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{R\\operatorname{sin}⁡ϕ}{R\\operatorname{cos}⁡ϕ} & =\\frac{4}{4} \\\\ \\operatorname{tan}⁡ϕ & =1 \\\\ ϕ & =\\operatorname{arctan}⁡(1) \\\\ ϕ & ={45}^{∘}.\\end{aligned}\n$$\n\nNow, we find the amplitude $R.$ Squaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{(R\\operatorname{cos}⁡ϕ)}^{2}+{(R\\operatorname{sin}⁡ϕ)}^{2} & ={4}^{2}+{4}^{2} \\\\ {R}^{2}({cos}^{2}⁡ϕ+{sin}^{2}⁡ϕ) & =16+16 \\\\ {R}^{2} & =32 \\\\ R & =4\\sqrt{2}.\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$\n\nFinally, we can write the initial expression in amplitude-phase form as follows:\n\n$$\n4\\operatorname{sin}⁡x-4\\operatorname{cos}⁡x=4\\sqrt{2}\\operatorname{sin}⁡(x-{45}^{∘})\n$$"}] [{:db/id #edb/ref 17592186348348 :knowledge-point/_questions [{:db/id #edb/ref 17592186096608 :knowledge-point/id #uuid "65b4e8e7-e558-50e7-a1ec-37a6eff77e87" :knowledge-point/title "Finding the Amplitude-Phase Form for Sine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02915c82-8065-5e74-82a1-9495fe20c4bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{6}\\operatorname{sin}⁡(5x-0.854)" :db/id #edb/ref 17592186345371} {:answer/id #uuid "053a825a-5e0a-5eee-97c6-c642f5c2abaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{6}\\operatorname{sin}⁡(5x-0.955)" :db/id #edb/ref 17592186345397} {:answer/id #uuid "89addc54-f82c-5eac-8aae-245bc3c57ac1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{6}\\operatorname{sin}⁡(5x-0.916)" :db/id #edb/ref 17592186346545} {:answer/id #uuid "8c7af4b8-beb1-58ef-8b7a-b1c7ae4dca86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}\\operatorname{sin}⁡(5x-1.054)" :db/id #edb/ref 17592186346571} {:answer/id #uuid "90a16488-0e85-5bd0-9ee2-b77c876e71b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}\\operatorname{sin}⁡(5x-1.156)" :db/id #edb/ref 17592186346612}] :answer-field/correct {:answer/id #uuid "053a825a-5e0a-5eee-97c6-c642f5c2abaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{6}\\operatorname{sin}⁡(5x-0.955)" :db/id #edb/ref 17592186345397} :answer-field/id #uuid "f38fa9b7-ea07-551f-b484-bf242ae05284" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186348032}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b6b79f0a-30fd-5a34-a89c-78169fdf9be8" :question/math-academy-id "q-80147" :question/problem "$2\\sqrt{2}\\operatorname{sin}⁡(5x)-4\\operatorname{cos}⁡(5x)≈$" :question/worked-solution "The difference formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(5x-ϕ) & =R(\\operatorname{sin}⁡(5x)\\operatorname{cos}⁡ϕ-\\operatorname{cos}⁡(5x)\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡(5x)-R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡(5x).\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n2\\sqrt{2}\\operatorname{sin}⁡(5x)-4\\operatorname{cos}⁡(5x)=R\\operatorname{sin}⁡(5x-ϕ),\n$$\n\nwe get the following identity:\n\n$$\n2\\sqrt{2}\\operatorname{sin}⁡(5x)-4\\operatorname{cos}⁡(5x)=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡(5x)-(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡(5x)\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡(5x)$ and $\\operatorname{cos}⁡(5x),$ we get the following system of equations:\n\n$$\n\\{\\begin{aligned}R\\operatorname{cos}⁡ϕ=2\\sqrt{2} \\\\ R\\operatorname{sin}⁡ϕ=4\\end{aligned}\n$$\n\nDividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{R\\operatorname{sin}⁡ϕ}{R\\operatorname{cos}⁡ϕ} & =\\frac{4}{2\\sqrt{2}} \\\\ \\operatorname{tan}⁡ϕ & =\\sqrt{2} \\\\ ϕ & =\\operatorname{arctan}⁡(\\sqrt{2}) \\\\  & =0.955\\end{aligned}\n$$\n\nrounded to three decimal places.\n\nNow, we find the amplitude $R.$ Squaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{(R\\operatorname{cos}⁡ϕ)}^{2}+{(R\\operatorname{sin}⁡ϕ)}^{2} & =(2\\sqrt{2})^{2}+{4}^{2} \\\\ {R}^{2}({cos}^{2}⁡ϕ+{sin}^{2}⁡ϕ) & =8+16 \\\\ {R}^{2} & =24 \\\\ R & =2\\sqrt{6}.\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$\n\nFinally, we can write the initial expression in amplitude-phase form as follows:\n\n$$\n2\\sqrt{2}\\operatorname{sin}⁡(5x)-4\\operatorname{cos}⁡(5x)=2\\sqrt{6}\\operatorname{sin}⁡(5x-0.955)\n$$"}] [{:db/id #edb/ref 17592186393989 :knowledge-point/_questions [{:db/id #edb/ref 17592186115309 :knowledge-point/id #uuid "6e126b20-0507-5f22-ba34-a55157ca7fa1" :knowledge-point/title "Solving a Trigonometric Equation When the Cotangent Function Equals Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b5b028d-56fd-576d-89ee-59e91162f77f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32\\,400" :db/id #edb/ref 17592186393991} {:answer/id #uuid "dabad841-65b9-5a99-92af-ee6af4b2bb9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\,100" :db/id #edb/ref 17592186393992} {:answer/id #uuid "b4b7bd2e-cf2b-501c-a930-f8e0d6c3c9b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16\\,200" :db/id #edb/ref 17592186393993} {:answer/id #uuid "a24ed0ee-36ac-5c49-8a82-fcd6540637a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16\\,200" :db/id #edb/ref 17592186393994} {:answer/id #uuid "fb4ff660-aaf6-533d-85c7-62c6040e5245" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-24\\,300" :db/id #edb/ref 17592186393995}] :answer-field/correct {:answer/id #uuid "dabad841-65b9-5a99-92af-ee6af4b2bb9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\,100" :db/id #edb/ref 17592186393992} :answer-field/id #uuid "ec419c65-67ca-5aa8-82ad-a2c9fe852709" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393990}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "936da1a3-12b9-5773-8bc1-7b9d9679b27f" :question/math-academy-id "q-80197" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $2=2-9\\operatorname{cot}⁡x$ for $-{180}^{∘}<x<{180}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2}?$" :question/worked-solution "First, we rearrange the equation to isolate $\\operatorname{cot}⁡x:$\n\n$$\n\\begin{aligned}2 & =2-9\\operatorname{cot}⁡x \\\\ 0 & =-9\\operatorname{cot}⁡x \\\\ \\operatorname{cot}⁡x & =0\\end{aligned}\n$$\n\nWe can't find an equivalent equation involving tangent, since this would lead to us dividing by $0:$\n\n$$\n\\operatorname{tan}⁡x=\\frac{1}{0}=\\text{undefined}\n$$\n\nHowever, we can instead find an equivalent equation using the fact that $\\operatorname{cot}⁡x=\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}:$\n\n$$\n\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}=0\n$$\n\nIn this case, we can find the principal solution as follows:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡x & =0 \\\\ x & =\\operatorname{arccos}⁡0 \\\\ x & ={90}^{∘}\\end{aligned}\n$$\n\nSince this value lies inside the desired domain, our first solution is ${x}_{1}={90}^{∘}.$\n\nTo find more solutions, we subtract integer multiples of ${180}^{∘}$ as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={x}_{1}-{180}^{∘} \\\\  & ={90}^{∘}-{180}^{∘} \\\\  & =-{90}^{∘}\\end{aligned}\n$$\n\nSo, our solutions are $x=-{90}^{∘},{90}^{∘}.$\n\nFinally, the numerical value of ${x}_{1}\\cdot {x}_{2}$ is \n\n$$\n90\\cdot (-90)=-8\\,100.\n$$"}] [{:db/id #edb/ref 17592186348354 :knowledge-point/_questions [{:db/id #edb/ref 17592186124512 :knowledge-point/id #uuid "e73b8bcf-79c2-5326-b396-d7d3e06badaa" :knowledge-point/title "Identifying the Standard Matrix of a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f9ea4b3-6eb3-5082-8914-c38bee676387" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -1 \\\\ 1 & -1\\end{aligned}]" :db/id #edb/ref 17592186346600} {:answer/id #uuid "a81dd2b8-40a6-5066-9db4-1ab9177b5325" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 1 \\\\ 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186346814} {:answer/id #uuid "d900a914-eda6-5172-8d8d-8f38cd423706" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 1 \\\\ -1 & -1\\end{aligned}]" :db/id #edb/ref 17592186347264} {:answer/id #uuid "dd36e61a-1034-5c73-9d7e-707ff278bb68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186347291} {:answer/id #uuid "de5af851-d906-5d9f-a62b-f9c3421ec820" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & -1 \\\\ 3 & -1\\end{aligned}]" :db/id #edb/ref 17592186347308}] :answer-field/correct {:answer/id #uuid "8f9ea4b3-6eb3-5082-8914-c38bee676387" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -1 \\\\ 1 & -1\\end{aligned}]" :db/id #edb/ref 17592186346600} :answer-field/id #uuid "142b7324-aef0-53ea-9091-db8282ddff85" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347643}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "68c48374-0bdd-59bd-ad8a-c986ebcde36e" :question/math-academy-id "q-8027" :question/problem "Find the standard matrix that  represents  the  linear  transformation $T$, where\n\n$$\nT:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}2x-y \\\\ x-y\\end{aligned}].\n$$" :question/worked-solution "We require a $2\\times 2$ matrix $T$ such that\n    \n\n$$\nT\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}2\\cdot x+(-1)\\cdot y \\\\ 1\\cdot x+(-1)\\cdot y\\end{aligned}].\n$$\n\nNotice that\n    \n\n$$\n[\\begin{aligned}2 & -1 \\\\ 1 & -1\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}2x-y \\\\ x-y\\end{aligned}].\n$$\n\n    Therefore, the matrix which represents the linear transformation $T$ is\n    \n\n$$\n[\\begin{aligned}2 & -1 \\\\ 1 & -1\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186348357 :knowledge-point/_questions [{:db/id #edb/ref 17592186129154 :knowledge-point/id #uuid "a66188f6-3228-59e9-9766-0f9bacbe8443" :knowledge-point/title "Identifying True Statements Regarding the Graph of a Given Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b75e759-23b9-5a00-8a2f-7c0ca516d97a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186345736} {:answer/id #uuid "910cdafc-67fc-587c-87f0-bdba48190064" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186346616} {:answer/id #uuid "b75eed07-3b22-5842-aac1-37ec3c1762bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186346950} {:answer/id #uuid "c106e615-06ca-5d4a-9046-a19b20c78b0a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186347019} {:answer/id #uuid "d48896a5-f655-5550-962f-afc68a851fd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186347213}] :answer-field/correct {:answer/id #uuid "910cdafc-67fc-587c-87f0-bdba48190064" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186346616} :answer-field/id #uuid "b0b44f15-bb40-5519-8a0c-c8353afc8e01" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347910}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9e0f13e6-ba4b-56eb-b269-f07bb6ae2732" :question/math-academy-id "q-80303" :question/problem "![](images/0a/0a7b19b50822235a2dcbfcdf74984735a1e26b2b775180b24bdc2bcbf24c588b.png)\n\nThe graph of a polynomial $p(x)$ is shown above. Which of the following statements are true?\n\nI. $x=-2$ is a root of even multiplicity.\n\nII. $x=1$ is **not** a simple root.\n\nIII. $x=1$ is a root of even multiplicity." :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is false. The root $x=-2$ has an odd multiplicity because at $x=-2$ the graph passes through the $x$-axis at this point.\n\n- Statement II is true. The root $x=1$ is not a simple root because the graph crosses the $x$-axis at that point, and the curve is tangent to the $x$-axis at that point.\n\n- Statement III is false. The root $x=1$ has an odd multiplicity because at $x=1$ the graph passes through the $x$-axis at this point.\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186348369 :knowledge-point/_questions [{:db/id #edb/ref 17592186129145 :knowledge-point/id #uuid "4fc09a0f-34d3-5ca9-9964-6cb00498bfa7" :knowledge-point/title "Identifying the Factored Polynomial Shown in a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "433015c8-b02a-5d3b-9bc4-7270edca0b40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{3}(x+1)(x-2)" :db/id #edb/ref 17592186345929} {:answer/id #uuid "444cadbf-3703-59f5-bad4-46404cc1a695" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{2}(x+1){(x-2)}^{2}" :db/id #edb/ref 17592186345940} {:answer/id #uuid "654ada61-08a2-5d34-998b-5c8db9d07e87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{3}(x+1){(x-2)}^{3}" :db/id #edb/ref 17592186346234} {:answer/id #uuid "6dbb7820-ea22-5b52-910b-269aa2f0dbbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{5}{(x+1)}^{2}(x-2)" :db/id #edb/ref 17592186346310} {:answer/id #uuid "f282e323-500b-5dcf-a254-2d713e281555" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x{(x+1)}^{2}(x-2)" :db/id #edb/ref 17592186347497}] :answer-field/correct {:answer/id #uuid "654ada61-08a2-5d34-998b-5c8db9d07e87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{3}(x+1){(x-2)}^{3}" :db/id #edb/ref 17592186346234} :answer-field/id #uuid "9d5873ca-3084-51bf-9b1d-3de807002492" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347880}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ad55c8cb-7248-5482-9f28-0afc365f8908" :question/math-academy-id "q-80348" :question/problem "![](images/8b/8b086759a25af7e464c0c8be78d36cd4d8458c5c25e7c84cb6ecb28b2d59e9df.png)\n\nWhich of the following could be the equation of the polynomial curve shown above?" :question/worked-solution "First, we notice that the function has precisely three distinct roots, $x=-1$, $x=0$ and $x=2.$\n\nBased on the graph, we can make the following conclusions about the multiplicities of the roots:\n\n- Since the graph is *not* tangent to the $x$-axis at $x=-1,$ this root is a simple root (the multiplicity equals $1$).\n\n- Since the graph passes through $x=0,$ this root has odd multiplicity, and since the graph is tangent to the $x$-axis at $x=0,$ the multiplicity must be greater than one.\n\n- Since the graph passes through $x=2,$ this root has odd multiplicity, and since the graph is tangent to the $x$-axis at $x=2,$ the multiplicity must be greater than one.\n\nFrom the given options, the only possible equation is $y={x}^{3}(x+1){(x-2)}^{3}.$"}] [{:db/id #edb/ref 17592186348371 :knowledge-point/_questions [{:db/id #edb/ref 17592186129145 :knowledge-point/id #uuid "4fc09a0f-34d3-5ca9-9964-6cb00498bfa7" :knowledge-point/title "Identifying the Factored Polynomial Shown in a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b68fad9-861a-5a5d-b8d5-ff1e2fa15ab7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x(x+2)^{7}(x-1)" :db/id #edb/ref 17592186346430} {:answer/id #uuid "8724b35c-787a-52ef-80ff-eaf99f6a667a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x(x+2)^{5}(x-1)^{2}" :db/id #edb/ref 17592186346523} {:answer/id #uuid "94213796-5be7-57ae-81b2-17ed395cf18a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x(x+2)^{3}(x-1)^{3}" :db/id #edb/ref 17592186346645} {:answer/id #uuid "b2ec07fb-d5b8-585e-82ea-e6c5d87d6e70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-{x}^{3}(x+2)^{5}(x-1)" :db/id #edb/ref 17592186346910} {:answer/id #uuid "b5c1df98-76d9-50de-b003-8111fdce77bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-{x}^{2}(x+2)(x-1)^{7}" :db/id #edb/ref 17592186346933}] :answer-field/correct {:answer/id #uuid "94213796-5be7-57ae-81b2-17ed395cf18a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x(x+2)^{3}(x-1)^{3}" :db/id #edb/ref 17592186346645} :answer-field/id #uuid "db472ae2-2f21-533d-93c0-3a75b3b10cf1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347991}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0154a31e-007f-558f-af24-913ca9813ba7" :question/math-academy-id "q-80352" :question/problem "![](images/19/1956e8c684cc03538877d3ec5d1e72d3d3f48b63341f7739b9a18962b080f1e3.png)\n\nWhich of the following could be the equation of the polynomial curve shown above?" :question/worked-solution "First, we notice that the function has precisely three distinct roots, $x=-2,x=0$ and $x=1.$\n\nBased on the graph, we can make the following conclusions about the multiplicities of the roots:\n\n- Since the graph passes through $x=-2,$ this root has odd multiplicity, and since the graph is tangent to the $x$-axis at $x=-2,$ the multiplicity must be greater than one.\n\n- Since the graph is *not* tangent to the $x$-axis at $x=0,$ this root is a simple root (the multiplicity equals $1$).\n\n- Since the graph passes through $x=1,$ this root has odd multiplicity, and since the graph is tangent to the $x$-axis at $x=1,$ the multiplicity must be greater than one.\n\nFrom the given options, the only possible equation is $y=-x(x+2)^{3}(x-1)^{3}.$"}] [{:db/id #edb/ref 17592186382372 :knowledge-point/_questions [{:db/id #edb/ref 17592186124440 :knowledge-point/id #uuid "7ea31275-77bd-59c7-8e1d-96e2e4b252a4" :knowledge-point/title "Finding Mixed Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e58bf6d-3e4e-5572-9962-d490c5a3b0a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}\\operatorname{sin}⁡(1+3xy)+3x{y}^{3}\\operatorname{cos}⁡(1+3xy)" :db/id #edb/ref 17592186382374} {:answer/id #uuid "d4d8c30b-3915-553d-8991-17f87e207e0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}\\operatorname{sin}⁡(1+3xy)+3x\\operatorname{cos}⁡(1+3xy)" :db/id #edb/ref 17592186382375} {:answer/id #uuid "673a978b-9841-53b4-bef5-1b693ae22128" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}\\operatorname{sin}⁡(1+3xy)" :db/id #edb/ref 17592186382376} {:answer/id #uuid "b47f7690-45d6-5927-b4de-fbb481a6e51b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{4}\\operatorname{cos}⁡(1+3xy)" :db/id #edb/ref 17592186382377} {:answer/id #uuid "6c776c6f-3449-5764-964f-10c8b07bc334" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}\\operatorname{sin}⁡(1+3xy)+xy\\operatorname{cos}⁡(1+3xy)" :db/id #edb/ref 17592186382378}] :answer-field/correct {:answer/id #uuid "0e58bf6d-3e4e-5572-9962-d490c5a3b0a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}\\operatorname{sin}⁡(1+3xy)+3x{y}^{3}\\operatorname{cos}⁡(1+3xy)" :db/id #edb/ref 17592186382374} :answer-field/id #uuid "cbfda208-0f47-5e6c-bbd8-4a6e0990b991" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382373}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4c8f7a87-99bf-5a7c-8050-3b38476efcc1" :question/math-academy-id "q-80400" :question/problem "For the function $f(x,y),$ calculate $\\frac{{∂}^{2}f}{∂{y}^{2}}$ given that $\\frac{∂f}{∂y}={y}^{3}\\operatorname{sin}⁡(1+3xy).$" :question/worked-solution "To find $\\frac{{∂}^{2}f}{∂{y}^{2}}$ we differentiate the given first-order partial derivative $\\frac{∂f}{∂y}$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(\\frac{∂f}{∂y}) \\\\  & =\\frac{∂}{∂y}({y}^{3}\\operatorname{sin}⁡(1+3xy)) \\\\  & =3{y}^{2}\\operatorname{sin}⁡(1+3xy)+3x{y}^{3}\\operatorname{cos}⁡(1+3xy)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186097370 :knowledge-point/_questions [{:db/id #edb/ref 17592186096837 :knowledge-point/id #uuid "9688df89-056e-59d7-869e-9841715b2aea" :knowledge-point/title "Finding the Antiderivative of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0580506-5e62-5af0-b3e6-9353b6e3a483" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨t^{3},-e^{t}⟩ + C" :db/id #edb/ref 17592186096145} {:answer/id #uuid "ff40ef8b-f310-58f1-8550-e3bacbd522af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨t^{3}, e^{t}⟩ + C" :db/id #edb/ref 17592186096146} {:answer/id #uuid "078c6504-67e7-59f9-a84a-4f8effd83cd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨t^{3},-te^{t}⟩ + C" :db/id #edb/ref 17592186096147} {:answer/id #uuid "2fd4ff92-eae2-5a08-baec-0b970b9dc151" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{t^{3}}{3}, e^{t}⟩ + C" :db/id #edb/ref 17592186096148} {:answer/id #uuid "521fd3ba-e41e-5d76-b588-35b2fd32cd46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3t^{3}, te^{t}⟩ + C" :db/id #edb/ref 17592186096149}] :answer-field/id #uuid "382ef6af-e68a-5f50-9931-43fdb4f90540" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186096144} {:answer-field/choices [{:answer/id #uuid "980abdcc-03e8-5481-8470-6167a822e9b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨{t}^{3},\\,-t{e}^{t}⟩+C" :db/id #edb/ref 17592186399119} {:answer/id #uuid "57f28662-75ae-5e7c-a727-6cc70f2a946d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{{t}^{3}}{3},\\,{e}^{t}⟩+C" :db/id #edb/ref 17592186399120} {:answer/id #uuid "8625a627-3b15-58cf-ba3e-833914e69b06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3{t}^{3},\\,t{e}^{t}⟩+C" :db/id #edb/ref 17592186399121} {:answer/id #uuid "f022a8e1-f660-5e62-989c-eb808fd735df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨{t}^{3},\\,-{e}^{t}⟩+C" :db/id #edb/ref 17592186399122} {:answer/id #uuid "b1bda4bf-9a89-5c13-9d41-84a013832509" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨{t}^{3},\\,{e}^{t}⟩+C" :db/id #edb/ref 17592186399123}] :answer-field/correct {:answer/id #uuid "b1bda4bf-9a89-5c13-9d41-84a013832509" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨{t}^{3},\\,{e}^{t}⟩+C" :db/id #edb/ref 17592186399123} :answer-field/id #uuid "5f4c5d2d-c5b6-5ecd-b722-b08fb64f2522" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399118}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "22f82dbd-7046-58bc-9a39-900370a35623" :question/math-academy-id "q-80460" :question/problem "If ${F}^{′}(t)=⟨3{t}^{2},\\,{e}^{t}⟩,$ then $F(t)=$" :question/worked-solution "First, we note that \n\n$$\nF(t)=\\int {F}^{′}(t)\\,\\text{d}t=\\int ⟨3{t}^{2},\\,{e}^{t}⟩\\,\\text{d}t.\n$$\n\nTo integrate a vector-valued function, we integrate each component separately. So, we get\n\n$$\n\\begin{aligned}\\int ⟨3{t}^{2},\\,{e}^{t}⟩\\,\\text{d}t & =⟨\\int 3{t}^{2}\\,\\text{d}t,\\,\\int {e}^{t}\\,\\text{d}t⟩ \\\\  & =⟨{t}^{3}+{c}_{1},\\,{e}^{t}+{c}_{2}⟩ \\\\  & =⟨{t}^{3},\\,{e}^{t}⟩+⟨{c}_{1},\\,{c}_{2}⟩ \\\\  & =⟨{t}^{3},\\,{e}^{t}⟩+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary (vector) constant of integration."}] [{:db/id #edb/ref 17592186348391 :knowledge-point/_questions [{:db/id #edb/ref 17592186124441 :knowledge-point/id #uuid "503a0bfe-7c69-5ad0-ad1d-aa8692dae673" :knowledge-point/title "Computing Expressions Involving Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5aad536a-9197-5a8d-b50f-6327085edfae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2xy\\operatorname{sin}⁡({x}^{2}-{y}^{2})" :db/id #edb/ref 17592186346124} {:answer/id #uuid "5fd9f008-6a2e-5d2a-aa8b-3ccff5ae77e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2({x}^{2}+{y}^{2})\\operatorname{sin}⁡({x}^{2}-{y}^{2})" :db/id #edb/ref 17592186346177} {:answer/id #uuid "6c8cb727-8294-5678-8acc-e9da39627db6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{2}{y}^{2}\\operatorname{sin}⁡({x}^{2}-{y}^{2})" :db/id #edb/ref 17592186346294} {:answer/id #uuid "a77649f1-48b6-55ea-91c0-383fba6c0762" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4xy\\operatorname{sin}⁡({x}^{2}-{y}^{2})" :db/id #edb/ref 17592186346809} {:answer/id #uuid "c3cdbe3f-02f7-51f8-b1f4-0af5a098e658" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2({x}^{2}y+x{y}^{2})\\operatorname{sin}⁡({x}^{2}-{y}^{2})" :db/id #edb/ref 17592186347042}] :answer-field/correct {:answer/id #uuid "a77649f1-48b6-55ea-91c0-383fba6c0762" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4xy\\operatorname{sin}⁡({x}^{2}-{y}^{2})" :db/id #edb/ref 17592186346809} :answer-field/id #uuid "467edf27-1318-5a7e-8c0c-820295e2b8aa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347721}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3a379c4d-6975-5a4f-a1f2-d51e99e08ac7" :question/math-academy-id "q-80468" :question/problem "Find ${f}_{xy}(x,y)+{f}_{yx}(x,y)$ given that  ${f}_{x}(x,y)=x\\operatorname{cos}⁡({x}^{2}-{y}^{2})$ and ${f}_{y}(x,y)=-y\\operatorname{cos}⁡({x}^{2}-{y}^{2}).$" :question/worked-solution "To find ${f}_{xy}(x,y)$ we differentiate the given first-order partial derivative ${f}_{x}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(x\\operatorname{cos}⁡({x}^{2}-{y}^{2})) \\\\  & =x\\cdot (-\\operatorname{sin}⁡({x}^{2}-{y}^{2})\\cdot (-2y)) \\\\  & =2xy\\operatorname{sin}⁡({x}^{2}-{y}^{2})\\end{aligned}\n$$\n\nTo find ${f}_{yx}(x,y)$ we differentiate the given first-order partial derivative ${f}_{y}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{f}_{yx}(x,y) & =\\frac{∂}{∂x}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂x}(-y\\operatorname{cos}⁡({x}^{2}-{y}^{2})) \\\\  & =-y(-\\operatorname{sin}⁡({x}^{2}-{y}^{2})\\cdot 2x) \\\\  & =2xy\\operatorname{sin}⁡({x}^{2}-{y}^{2})\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y)+{f}_{yx}(x,y) & =2xy\\operatorname{sin}⁡({x}^{2}-{y}^{2})+2xy\\operatorname{sin}⁡({x}^{2}-{y}^{2}) \\\\  & =4xy\\operatorname{sin}⁡({x}^{2}-{y}^{2}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186382386 :knowledge-point/_questions [{:db/id #edb/ref 17592186124441 :knowledge-point/id #uuid "503a0bfe-7c69-5ad0-ad1d-aa8692dae673" :knowledge-point/title "Computing Expressions Involving Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef4a7ac8-061e-5af9-9fb0-ab5773165579" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{3}" :db/id #edb/ref 17592186382388} {:answer/id #uuid "c4001b21-7575-5835-8086-75b8d29921b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186382389} {:answer/id #uuid "5d0ca7b1-e77a-5b9b-b8a5-4b9e8d84089f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186382390} {:answer/id #uuid "41d02635-e49d-571a-96b0-1ac0a22b8838" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186382391} {:answer/id #uuid "6d245bf1-3343-5515-adf6-f1ffb3caa8af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{9}" :db/id #edb/ref 17592186382392}] :answer-field/correct {:answer/id #uuid "6d245bf1-3343-5515-adf6-f1ffb3caa8af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{9}" :db/id #edb/ref 17592186382392} :answer-field/id #uuid "2cf99c29-b792-5f2e-8440-d3e8129e97bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382387}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0d39e98a-42b8-56d2-88b4-63d088086c8a" :question/math-academy-id "q-80473" :question/problem "Find ${g}_{xx}(x,y)+{g}_{yy}(x,y)$ at $(1,-1)$ given that ${g}_{x}(x,y)=\\frac{2}{2x-y}$ and ${g}_{y}(x,y)=-\\frac{1}{2x-y}.$" :question/worked-solution "To find ${g}_{xx}(x,y)$ we differentiate the given first-order partial derivative ${g}_{x}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{g}_{xx}(x,y) & =\\frac{∂}{∂x}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂x}(\\frac{2}{2x-y}) \\\\  & =-\\frac{4}{(2x-y)^{2}}\\end{aligned}\n$$\n\n \n\nTo find ${g}_{yy}(x,y)$ we differentiate the given first-order partial derivative ${g}_{y}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{g}_{yy}(x,y) & =\\frac{∂}{∂y}({g}_{y}(x,y)) \\\\  & =\\frac{∂}{∂y}(-\\frac{1}{2x-y}) \\\\  & =-\\frac{1}{(2x-y)^{2}}\\end{aligned}\n$$\n\n \n\nNext, we evaluate ${g}_{xx}(x,y)$ and ${g}_{yy}(x,y)$ at $(1,-1):$\n\n$$\n\\begin{aligned}{g}_{xx}(1,-1) & =-\\frac{4}{(2(1)-(-1))^{2}}=-\\frac{4}{9} \\\\ {g}_{yy}(1,-1) & =-\\frac{1}{(2(1)-(-1))^{2}}=-\\frac{1}{9}\\end{aligned}\n$$\n\nFinally, we have\n\n$$\n{g}_{xx}(1,-1)+{g}_{yy}(1,-1)=-\\frac{4}{9}-\\frac{1}{9}=-\\frac{5}{9}.\n$$"}] [{:db/id #edb/ref 17592186348393 :knowledge-point/_questions [{:db/id #edb/ref 17592186124442 :knowledge-point/id #uuid "83724b66-0f15-5b94-9576-76e9dfd56d38" :knowledge-point/title "Finding Higher-Order Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b1ec632-4e96-5ec8-9755-034cbf78bed9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}\\operatorname{sin}⁡(xy)-xy\\operatorname{cos}⁡(xy)" :db/id #edb/ref 17592186345855} {:answer/id #uuid "6fbb559a-230e-5ef6-9064-a4ccf27a6ec7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{x}^{2}y\\operatorname{sin}⁡(xy)" :db/id #edb/ref 17592186346328} {:answer/id #uuid "c5d6fdc9-9613-5b86-8e9f-9d4aed654bc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}y\\operatorname{cos}⁡(xy)" :db/id #edb/ref 17592186347072} {:answer/id #uuid "c8cd6f20-2be4-5a6c-922e-47c33a56fed4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x\\operatorname{sin}⁡(xy)+xy\\operatorname{cos}⁡(xy)" :db/id #edb/ref 17592186347099} {:answer/id #uuid "ef2d1510-2534-5ba2-b98a-fc9a95ecf1f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x\\operatorname{sin}⁡(xy)-{x}^{2}y\\operatorname{cos}⁡(xy)" :db/id #edb/ref 17592186347462}] :answer-field/correct {:answer/id #uuid "ef2d1510-2534-5ba2-b98a-fc9a95ecf1f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x\\operatorname{sin}⁡(xy)-{x}^{2}y\\operatorname{cos}⁡(xy)" :db/id #edb/ref 17592186347462} :answer-field/id #uuid "95ebccfe-740d-5398-87d9-f0671d3c080c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347869}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "09777d76-95e6-5bbb-83f0-f307b490599a" :question/math-academy-id "q-80474" :question/problem "Calculate ${f}_{yyx}(x,y)$ given that $f(x,y)=\\operatorname{sin}⁡(xy).$" :question/worked-solution "First, we find the first-order derivative ${f}_{y}(x,y):$ \n\n$$\n\\begin{aligned}{f}_{y}(x,y) & =\\frac{∂}{∂y}(\\operatorname{sin}⁡(xy)) \\\\  & =x\\operatorname{cos}⁡(xy)\\end{aligned}\n$$\n\nNext, we find ${f}_{yy}(x,y)$ by differentiating ${f}_{y}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{yy}(x,y) & =\\frac{∂}{∂y}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂y}(x\\operatorname{cos}⁡(xy)) \\\\  & =-{x}^{2}\\operatorname{sin}⁡(xy)\\end{aligned}\n$$\n\nFinally, we find ${f}_{yyx}(x,y)$ by differentiating ${f}_{yy}(x,y)$ with respect to $x:$ \n\n$$\n\\begin{aligned}{f}_{yyx}(x,y) & =\\frac{∂}{∂x}({f}_{yy}(x,y)) \\\\  & =\\frac{∂}{∂x}(-{x}^{2}\\operatorname{sin}⁡(xy)) \\\\  & =-2x\\cdot \\operatorname{sin}⁡(xy)-{x}^{2}\\cdot \\operatorname{cos}⁡(xy)\\cdot y \\\\  & =-2x\\operatorname{sin}⁡(xy)-{x}^{2}y\\operatorname{cos}⁡(xy)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348401 :knowledge-point/_questions [{:db/id #edb/ref 17592186129170 :knowledge-point/id #uuid "ec44686a-601b-52b3-81df-e57e6708fb93" :knowledge-point/title "Evaluating a Double Integral Using the Multiplicative Property"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45813fa4-fac0-5452-9255-9d2cc5a09b20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186345956} {:answer/id #uuid "5837a18a-ae8a-5078-b71f-c3ebdbb5af5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186346106} {:answer/id #uuid "92622851-e5da-5c25-8c6c-1a4734ebd54b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186346632} {:answer/id #uuid "ac9f3b3e-4a16-5638-8f30-348e6dacf30a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186346857} {:answer/id #uuid "acd4a2a8-18a1-55b8-81a7-2cf19b948e4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186346858}] :answer-field/correct {:answer/id #uuid "45813fa4-fac0-5452-9255-9d2cc5a09b20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186345956} :answer-field/id #uuid "4b7b34a4-1322-5681-a0fb-3dfd4c852dbf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347731}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "813cfc16-7a47-56e2-b9f6-16d7ae4bba08" :question/math-academy-id "q-80507" :question/problem "Evaluate the double integral ${∬}_{R}\\frac{1}{x}\\operatorname{cos}⁡y\\,\\text{d}A$ over the rectangle $R=[1,e]\\times [0,\\frac{\\pi }{2}].$" :question/worked-solution "We apply the multiplicative property of double integrals and then evaluate each of the integrals separately:\n\n$$\n\\begin{aligned}{∬}_{R}\\frac{1}{x}\\operatorname{cos}⁡y\\,\\text{d}A & ={∬}_{R}(\\frac{1}{x})(\\operatorname{cos}⁡y)\\,\\text{d}A \\\\  & =({\\int }_{1}^{e}\\frac{1}{x}\\,\\text{d}x)({\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡y\\,\\text{d}y) \\\\  & =[\\operatorname{ln}⁡x]_{1}^{e}\\cdot [\\operatorname{sin}⁡y]_{0}^{\\pi /2} \\\\  & =(\\operatorname{ln}⁡e-\\operatorname{ln}⁡1)\\cdot (\\operatorname{sin}⁡(\\frac{\\pi }{2})-\\operatorname{sin}⁡0) \\\\  & =(1-0)\\cdot (1-0) \\\\  & =1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186396183 :knowledge-point/_questions [{:db/id #edb/ref 17592186087751 :knowledge-point/id #uuid "cf99414e-f1cf-528f-adbb-407cf6e82c4c" :knowledge-point/title "Identifying the Linear Transformation Represented by a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b95051d2-50e5-54f9-a671-a1d798db4c74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Dilation with scale factor $\\frac{1}{3}$" :db/id #edb/ref 17592186396185} {:answer/id #uuid "1a07ec2e-4723-50fa-a492-65d833fca2c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Reflection across the $y$-axis" :db/id #edb/ref 17592186396186} {:answer/id #uuid "72639a3d-6ded-5b32-8272-74477a63f9ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Dilation with scale factor $3$" :db/id #edb/ref 17592186396187} {:answer/id #uuid "e8825cd3-515a-5a66-ba2f-f64d182752ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Reflection in the line $x=3$" :db/id #edb/ref 17592186396188} {:answer/id #uuid "c2e9ced4-a3e4-50e4-8475-6ffa71f360f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Reflection in the line $y=3$" :db/id #edb/ref 17592186396189}] :answer-field/correct {:answer/id #uuid "72639a3d-6ded-5b32-8272-74477a63f9ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Dilation with scale factor $3$" :db/id #edb/ref 17592186396187} :answer-field/id #uuid "daffb22d-4d43-548d-b3e0-44a4cfce0727" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396184}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3ddcb294-a508-54d0-bd15-63145db8f082" :question/math-academy-id "q-8054" :question/problem "What linear transformation $T$ is represented by the matrix $T=[\\begin{aligned}3 & 0 \\\\ 0 & 3\\end{aligned}]?$" :question/worked-solution "Recall that a dilation of scale factor $k$ is represented by the matrix\n\n$$\n[\\begin{aligned}k & 0 \\\\ 0 & k\\end{aligned}].\n$$\n\nHere, we have $k=3.$ Therefore, the matrix represents a dilation with a scale factor of $3.$"}] [{:db/id #edb/ref 17592186382407 :knowledge-point/_questions [{:db/id #edb/ref 17592186129171 :knowledge-point/id #uuid "307bccb6-036f-51bb-99ce-327aad8dfdbe" :knowledge-point/title "Evaluating a Double Integral When the Integrand Contains Only One Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8458ae4-fafc-5a98-ab45-1adea4f03cfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186382409} {:answer/id #uuid "9addff4c-74aa-5855-b730-fe68fa5f33b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186382410} {:answer/id #uuid "e32440d6-fac7-5caf-bfd7-7612653eb6a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "39" :db/id #edb/ref 17592186382411} {:answer/id #uuid "8f95079d-845f-5ed2-b0b9-f6e1b9a61490" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "31" :db/id #edb/ref 17592186382412} {:answer/id #uuid "e93d0ef7-1d27-53c3-becc-c9dfd0fe94fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "29" :db/id #edb/ref 17592186382413}] :answer-field/correct {:answer/id #uuid "9addff4c-74aa-5855-b730-fe68fa5f33b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186382410} :answer-field/id #uuid "dc0d3863-9fe2-5bb6-8578-90c9d149b878" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382408}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "66d9f9e9-c9db-5bd9-aeae-e3f4c6b82bbb" :question/math-academy-id "q-80642" :question/problem "Evaluate the double integral ${∬}_{R}\\frac{1+y{x}^{3}}{{x}^{3}}\\,\\text{d}A$,  where $R=[1,2]\\times [0,8].$" :question/worked-solution "Using the linearity property of double integrals, we get\n\n$$\n\\begin{aligned}{∬}_{R}\\frac{1+y{x}^{3}}{{x}^{3}}\\,\\text{d}A & ={∬}_{R}(\\frac{1}{{x}^{3}}+y)\\,\\text{d}A \\\\  & ={∬}_{R}\\frac{1}{{x}^{3}}\\,\\text{d}A+{∬}_{R}y\\text{ }\\text{d}A.\\end{aligned}\n$$\n\nThe function under the first integral is independent of $y.$ So, we have \n\n$$\n\\begin{aligned}{∬}_{R}\\frac{1}{{x}^{3}}\\,\\text{d}A & =(8-0){\\int }_{1}^{2}\\frac{1}{{x}^{3}}\\,\\text{d}x \\\\  & =8\\cdot (-\\frac{1}{2{x}^{2}}{|}_{1}^{2}) \\\\  & =8\\cdot (-\\frac{1}{8}-(-\\frac{1}{2})) \\\\  & =3.\\end{aligned}\n$$\n\nThe function under the second integral is independent of $x.$ So, we have \n\n$$\n\\begin{aligned}{∬}_{R}y\\text{ }\\text{d}A & =(2-1){\\int }_{0}^{8}y\\,\\text{d}y \\\\  & =\\frac{{y}^{2}}{2}{|}_{0}^{8} \\\\  & =\\frac{{8}^{2}}{2}-\\frac{{0}^{2}}{2} \\\\  & =32.\\end{aligned}\n$$\n\nFinally, combining our results, we obtain \n\n$$\n\\begin{aligned}{∬}_{R}\\frac{1+y{x}^{3}}{{x}^{3}}\\,\\text{d}A=3+32=35.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348428 :knowledge-point/_questions [{:db/id #edb/ref 17592186124448 :knowledge-point/id #uuid "43ee40fd-e452-5593-9a35-7c46d1f0cca0" :knowledge-point/title "Finding Missing Constants in First-Order Partial Derivative Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66835d6e-3235-5c99-8876-7034e988a46d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=1,\\,b=2" :db/id #edb/ref 17592186346250} {:answer/id #uuid "91694c9d-9493-587b-966f-11a1ad36f382" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=3,\\,b=6" :db/id #edb/ref 17592186346621} {:answer/id #uuid "9a16000b-d339-5d48-b8af-aace86f516fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=2,\\,b=1" :db/id #edb/ref 17592186346697} {:answer/id #uuid "9c4d95fa-70d9-5069-b2c3-abfee58b3e0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=2,\\,b=3" :db/id #edb/ref 17592186346712} {:answer/id #uuid "c8175092-9e51-5f9d-88bd-ca080f49c847" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=3,\\,b=2" :db/id #edb/ref 17592186347093}] :answer-field/correct {:answer/id #uuid "c8175092-9e51-5f9d-88bd-ca080f49c847" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=3,\\,b=2" :db/id #edb/ref 17592186347093} :answer-field/id #uuid "2c625d5e-f791-5525-b935-c9165d2fd13e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347676}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "327ee2b7-dd3c-55c0-8e52-a02eed7e91bf" :question/math-academy-id "q-80643" :question/problem "Suppose that the function $f(x,y)$ and all of its first and second-order partial derivatives are continuous on an open set $U.$ Find the values of $a$ and $b$, if \n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =a{x}^{2}{y}^{2}+6xy+2x, \\\\ {f}_{y}(x,y) & =b{x}^{3}y+3{x}^{2}+2, \\\\ {f}_{y}(-1,1) & =3.\\end{aligned}\n$$" :question/worked-solution "First, we find the mixed partial derivatives:\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(a{x}^{2}{y}^{2}+6xy+2x) \\\\  & =2a{x}^{2}y+6x+0 \\\\  & =2a{x}^{2}y+6x \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂x}(b{x}^{3}y+3{x}^{2}+2) \\\\  & =3b{x}^{2}y+6x+0 \\\\  & =3b{x}^{2}y+6x\\end{aligned}\n$$\n\nSince the function and its first and second-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal. Hence, we have the identity\n\n$$\n\\begin{aligned}2a{x}^{2}y+6x=3b{x}^{2}y+6x.\\end{aligned}\n$$\n\nEquating the coefficients of ${x}^{2}y$, we see that $a=\\frac{3b}{2}.$ \n\nNow, since ${f}_{y}(-1,1)=3$, we get\n\n$$\n\\begin{aligned}{f}_{y}(-1,1) & =3 \\\\ b(-1)^{3}(1)+3(-1)^{2}+2 & =3 \\\\ -b+3+2 & =3 \\\\ b & =2.\\end{aligned}\n$$\n\nFinally, \n\n$$\na=\\frac{3b}{2}=3.\n$$"}] [{:db/id #edb/ref 17592186348431 :knowledge-point/_questions [{:db/id #edb/ref 17592186129188 :knowledge-point/id #uuid "8505beff-75b8-57bf-9312-e0fcf32f44fd" :knowledge-point/title "Using Additivity of Double Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "134124de-7bb5-583d-8268-6eb3bafe7fbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186345518} {:answer/id #uuid "87554a50-11a6-5b25-94e7-2006d6ccdfde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186346525} {:answer/id #uuid "a3d87198-8b27-581a-8546-b068e655ed3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186346774} {:answer/id #uuid "ecc9ffca-cda6-5a04-bd09-cdffd86a6db8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186347440} {:answer/id #uuid "f7795d31-183d-5b9e-aef1-882627d90923" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186347543}] :answer-field/correct {:answer/id #uuid "f7795d31-183d-5b9e-aef1-882627d90923" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186347543} :answer-field/id #uuid "3085ef55-d31f-5e6a-9eee-f864976c417f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347685}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dfc30ed8-539a-5f2e-be5b-7fef09f28bdd" :question/math-academy-id "q-80657" :question/problem "Given that $C$ and $D$ are finite, non-overlapping regions and that\n\n$$\n{∬}_{C}f(x,y)\\text{ }\\text{d}A=-5,\\,{∬}_{D}f(x,y)\\text{ }\\text{d}A=7,\n$$\n\nfind the value of \n\n$$\n{∬}_{C\\cup D}4f(x,y)\\text{ }\\text{d}A.\n$$" :question/worked-solution "Using the linearity and additivity of double integrals, we get the following:\n\n$$\n\\begin{aligned}{∬}_{C\\cup D}4f(x,y)\\text{ }\\text{d}A & =4{∬}_{C\\cup D}f(x,y)\\text{ }\\text{d}A \\\\  & =4({∬}_{C}f(x,y)\\text{ }\\text{d}A+{∬}_{D}f(x,y)\\text{ }\\text{d}A) \\\\  & =4(-5+7) \\\\  & =8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186394044 :knowledge-point/_questions [{:db/id #edb/ref 17592186184190 :knowledge-point/id #uuid "a832b1a2-e80e-53d0-bb64-03df0f1a209c" :knowledge-point/title "Obtaining a Higher-Order Derivative Of a Function Given its Higher-Degree Taylor Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87ce0934-02d4-5393-a820-a60747531d26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,560" :db/id #edb/ref 17592186394046} {:answer/id #uuid "55151c71-8b6d-58eb-a249-4eb4aac0d349" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "484" :db/id #edb/ref 17592186394047} {:answer/id #uuid "7f1eb3bb-51af-5134-8c24-9eaec350677e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "264" :db/id #edb/ref 17592186394048} {:answer/id #uuid "2fb5a83c-3187-5ca1-904d-ee6f8e47bd54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "312" :db/id #edb/ref 17592186394049} {:answer/id #uuid "11a52e31-0b32-5adb-9e0e-67e9944070c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,320" :db/id #edb/ref 17592186394050}] :answer-field/correct {:answer/id #uuid "87ce0934-02d4-5393-a820-a60747531d26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,560" :db/id #edb/ref 17592186394046} :answer-field/id #uuid "303ca5d2-6f56-5888-a948-198bbe7b80f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394045}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0857096a-6a9d-5a2b-a489-d085d352c19a" :question/math-academy-id "q-80722" :question/problem "The fifth-degree Taylor polynomial of $f(x)$ about $x=-2$ is given by\n\n$$\n{P}_{5}(x)=-3+5(x+2)-7(x+2)^{2}+9(x+2)^{3}-11(x+2)^{4}+13(x+2)^{5}.\n$$\n\nWhat is ${f}^{(5)}(-2)?$" :question/worked-solution "The coefficient of $(x+2)^{5}$ is given by $\\frac{{f}^{(5)}(-2)}{5!}.$ Therefore,\n\n$$\n\\begin{aligned}\\frac{{f}^{(5)}(-2)}{5!} & =13 \\\\ \\frac{{f}^{(5)}(-2)}{120} & =13 \\\\ {f}^{(5)}(-2) & =1\\,560.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106490 :knowledge-point/_questions [{:db/id #edb/ref 17592186105764 :knowledge-point/id #uuid "3105e8eb-010f-542b-9e40-12fda6ea00e7" :knowledge-point/title "Finding the Standard Matrix of a Stretch Transformation Given a Vector and its Image"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89f93f56-ac75-57b5-95c1-f90f361f5930" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186105089} {:answer/id #uuid "b33af94e-420f-5cfd-b0af-f118b8697055" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186105090} {:answer/id #uuid "bf6bae65-78c2-5856-9f0b-163e1c048ff6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186105091} {:answer/id #uuid "fd0d689b-1c5e-51c2-88cc-ac6b5d900a1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186105092} {:answer/id #uuid "2aff7b31-5277-574c-afb7-f649464edb91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186105093}] :answer-field/id #uuid "637d172d-46f4-5b21-8f12-e315dda47530" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186105088} {:answer-field/choices [{:answer/id #uuid "2c397e37-1d42-5efe-81d5-6ff323b2d323" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186394052} {:answer/id #uuid "6f6ed60d-2840-53c0-a19c-73a1c38e3ec0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186394053} {:answer/id #uuid "38883822-19a8-50c5-ac70-21dd818b00e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 3\\end{aligned}]" :db/id #edb/ref 17592186394054} {:answer/id #uuid "75955132-8432-5b46-8ff2-1f131bf31dd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186394055} {:answer/id #uuid "48d10010-6d30-5ed7-a764-671a0140e320" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186394056}] :answer-field/correct {:answer/id #uuid "6f6ed60d-2840-53c0-a19c-73a1c38e3ec0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186394053} :answer-field/id #uuid "78374675-6ad5-5e77-a243-9ee8ff3a2a6d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394051}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "85f5eecb-79b7-5107-8347-e7d15fcb457b" :question/math-academy-id "q-80726" :question/problem "A linear transformation $T$ represents a stretch along the $x$-axis or $y$-axis. Given that $v=[\\begin{aligned}3 \\\\ -2\\end{aligned}]$ and $T(v)=[\\begin{aligned}6 \\\\ -2\\end{aligned}],$ what is the standard matrix of $T?$" :question/worked-solution "First, we are told that $T$ represents a stretch along the $x$-axis or $y$-axis.\n\nComparing the $x$- and $y$-components of $v$ and $T(v),$ we note the following:\n\n- the $x$-component of $T(v)$ is $2$ times the $x$-component of $v,$ while\n\n- the $y$-components of $v$ and $T(v)$ are the same.\n\nSo, we conclude that $T$ represents a stretch of scale factor $2$ in the $x$-direction. \n\nTherefore, the standard matrix of $T$ is\n\n$$\nT=[\\begin{aligned}2 & 0 \\\\ 0 & 1\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186348444 :knowledge-point/_questions [{:db/id #edb/ref 17592186124450 :knowledge-point/id #uuid "0b15f59e-ef74-5fa2-9af9-448fdcbbbd3d" :knowledge-point/title "Identifying Possible Pairs of First-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0544bc80-1365-5632-a296-a05da1bafe03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186345398} {:answer/id #uuid "0c64741f-299e-5460-8811-c671d2a5a6d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186345448} {:answer/id #uuid "1798485b-0c6a-5572-a030-a13c598db229" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186345559} {:answer/id #uuid "274cde2d-e1fe-56af-8cd0-7813c0a484e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186345704} {:answer/id #uuid "2ed5a70b-0dfc-5371-a511-84ae013300d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186345766}] :answer-field/correct {:answer/id #uuid "0544bc80-1365-5632-a296-a05da1bafe03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186345398} :answer-field/id #uuid "cf3548ed-65ef-581d-81b0-85e927603b7e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347963}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "22141837-7250-500e-8f49-e3a949023800" :question/math-academy-id "q-80753" :question/problem "Suppose that the function $f(x,y)$ and all of its first and second-order partial derivatives are continuous on an open set $U.$ Which of the following pairs could represent the first-order partial derivatives of $f(x,y)?$\n\n- ${f}_{x}(x,y)=2x{y}^{2}-y$ and ${f}_{y}(x,y)=2{x}^{2}y-2x$\n- ${f}_{x}(x,y)=yx{e}^{x}+{y}^{2}$ and ${f}_{y}(x,y)=(x-1){e}^{x}+2xy$\n- ${f}_{x}(x,y)=x-y$ and ${f}_{y}(x,y)=\\frac{1}{\\operatorname{ln}⁡y}-x$" :question/worked-solution "Since the function and its first and second-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal, that is, ${f}_{xy}(x,y)={f}_{yx}(x,y).$ Let's check if this condition is true for each of our pairs of first-order partial derivatives.\n\n- For the first pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(2x{y}^{2}-y)=4xy-1 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(2{x}^{2}y-2x)=4xy-2.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)\\ne {f}_{yx}(x,y)$, the first pair cannot represent the first-order partial derivatives of $f(x,y).$\n\n- For the second pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(yx{e}^{x}+{y}^{2})=x{e}^{x}+2y \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}((x-1){e}^{x}+2xy)=x{e}^{x}+2y.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$, the second pair could represent the first-order partial derivatives of $f(x,y).$\n\n- For the third pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(x-y)=-1 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(\\frac{1}{\\operatorname{ln}⁡y}-x)=-1.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$,  the third pair could represent the first-order partial derivatives of $f(x,y).$\n\nTherefore, the correct answer is 'II and III only'."}] [{:db/id #edb/ref 17592186348446 :knowledge-point/_questions [{:db/id #edb/ref 17592186087735 :knowledge-point/id #uuid "01caf021-de3e-5e2a-89ce-ba289b65c0ff" :knowledge-point/title "Writing a Complex Number in Exponential Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03d37a5d-f38e-5e9f-b4c2-8557a961d8e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{17}\\,{\\text{e}}^{6.086\\,\\text{i}}" :db/id #edb/ref 17592186345385} {:answer/id #uuid "21e41ad5-4ee1-5fe7-b639-bc9b977dc4fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{17}\\,{\\text{e}}^{3.338\\,\\text{i}}" :db/id #edb/ref 17592186345653} {:answer/id #uuid "2f556611-9499-54a3-9131-95ba2cbf06c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{26}\\,{\\text{e}}^{6.086\\,\\text{i}}" :db/id #edb/ref 17592186345767} {:answer/id #uuid "a3665dd9-b15a-5d76-8f3c-92d873804b55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{26}\\,{\\text{e}}^{3.338\\,\\text{i}}" :db/id #edb/ref 17592186346766} {:answer/id #uuid "d8ae151a-4d90-50cb-ad3c-f2ecfc64dcc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{26}\\,{\\text{e}}^{4.989\\,\\text{i}}" :db/id #edb/ref 17592186347261}] :answer-field/correct {:answer/id #uuid "2f556611-9499-54a3-9131-95ba2cbf06c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{26}\\,{\\text{e}}^{6.086\\,\\text{i}}" :db/id #edb/ref 17592186345767} :answer-field/id #uuid "e647b151-d969-5d70-9827-bf43ae96b615" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186348007}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0a752e22-d98b-55fa-871d-a83c493259aa" :question/math-academy-id "q-8076" :question/problem "Write the complex number $z=5-\\text{i}$ in the form $r{e}^{\\text{i}\\theta },$ giving $\\theta $ in radians to $3$ decimal places." :question/worked-solution "To write our complex number in the form $z=r{\\text{e}}^{\\text{i}\\theta },$ where $r=|z|$ and $\\theta =\\operatorname{arg}⁡(z),$ we first calculate $r:$\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{5}^{2}+(-1)^{2}} \\\\  & =\\sqrt{26}\\end{aligned}\n$$\n\nNow, since $z$ lies in the fourth quadrant, we can find the angle $\\theta $ as\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =2\\pi -|\\operatorname{arctan}⁡(\\frac{y}{x})| \\\\  & =2\\pi -|\\operatorname{arctan}⁡(\\frac{-1}{5})| \\\\  & =2\\pi -|\\operatorname{arctan}⁡(-\\frac{1}{5})| \\\\  & ≈2\\pi -0.197\\,39… \\\\  & ≈6.086.\\end{aligned}\n$$\n\nFinally, substituting $r=\\sqrt{26}$ and $\\theta =6.086$ into $z=r{e}^{\\text{i}\\theta },$ we get\n\n$$\nz=\\sqrt{26}\\,{\\text{e}}^{6.086\\,\\text{i}}.\n$$"}] [{:db/id #edb/ref 17592186373250 :knowledge-point/_questions [{:db/id #edb/ref 17592186087735 :knowledge-point/id #uuid "01caf021-de3e-5e2a-89ce-ba289b65c0ff" :knowledge-point/title "Writing a Complex Number in Exponential Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d7e6bee-930b-58e5-9902-60f3461386bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{2}\\,{\\text{e}}^{7\\pi \\text{i}/4}" :db/id #edb/ref 17592186373252} {:answer/id #uuid "4c342a2b-d916-53f7-a9d8-c2ab2e7c2311" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{2}\\,{\\text{e}}^{5\\pi \\text{i}/4}" :db/id #edb/ref 17592186373253} {:answer/id #uuid "b81c73e2-cfb2-59ad-a7d9-25f41eadbcc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\sqrt{2}\\,{\\text{e}}^{\\pi \\text{i}/4}" :db/id #edb/ref 17592186373254} {:answer/id #uuid "e2330104-a769-597a-b5ae-98ab87dc43b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\sqrt{2}\\,{\\text{e}}^{7\\pi \\text{i}/4}" :db/id #edb/ref 17592186373255} {:answer/id #uuid "5579d141-794d-5790-8ca2-1a59cd2b9529" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\sqrt{2}\\,{\\text{e}}^{5\\pi \\text{i}/4}" :db/id #edb/ref 17592186373256}] :answer-field/correct {:answer/id #uuid "e2330104-a769-597a-b5ae-98ab87dc43b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\sqrt{2}\\,{\\text{e}}^{7\\pi \\text{i}/4}" :db/id #edb/ref 17592186373255} :answer-field/id #uuid "03f91cb2-48b9-5a8d-938e-53bc25c6e30a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373251}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4b29385a-7bac-596f-b9c2-4aa83fc8914b" :question/math-academy-id "q-8077" :question/problem "Write the complex number $z=2-2\\text{i}$ in exponential form." :question/worked-solution "To write our complex number in the form $z=r{\\text{e}}^{\\text{i}\\theta },$ where $r=|z|$ and $\\theta =\\operatorname{arg}⁡(z),$ we first calculate $r:$\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{2}^{2}+(-2)^{2}} \\\\  & =\\sqrt{8}=2\\sqrt{2}\\end{aligned}\n$$\n\nNow, since $z$ lies in the fourth quadrant, we can find the angle $\\theta $ as\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =2\\pi -|\\operatorname{arctan}⁡(\\frac{y}{x})| \\\\  & =2\\pi -|\\operatorname{arctan}⁡(\\frac{-2}{2})| \\\\  & =2\\pi -|\\operatorname{arctan}⁡(-1)| \\\\  & =2\\pi -\\frac{\\pi }{4} \\\\  & =\\frac{7\\pi }{4}.\\end{aligned}\n$$\n\nFinally, substituting $r=2\\sqrt{2}$ and $\\theta =\\frac{7\\pi }{4}$ into $z=r{e}^{\\text{i}\\theta },$ we get\n\n$$\nz=2\\sqrt{2}\\,{\\text{e}}^{7\\pi \\text{i}/4}.\n$$"}] [{:db/id #edb/ref 17592186348450 :knowledge-point/_questions [{:db/id #edb/ref 17592186129179 :knowledge-point/id #uuid "16f4bd05-1f30-576c-a538-a0ac4d533b7a" :knowledge-point/title "Finding a Tangent Plane of a Surface Given Implicitly Using the Gradient Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "055ca543-5d57-5d9e-a2d2-381ab5780193" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186345399} {:answer/id #uuid "606d26e9-38fb-5406-81c6-bbbc70b87d52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186346185} {:answer/id #uuid "8e4a5312-9c03-5d11-93e6-1b83c3444d97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186346589} {:answer/id #uuid "c345d148-9371-50cb-bc70-e50fb33e6977" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186347038} {:answer/id #uuid "dcdb03f8-d803-5843-ae32-5f7feed10058" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186347286}] :answer-field/correct {:answer/id #uuid "c345d148-9371-50cb-bc70-e50fb33e6977" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186347038} :answer-field/id #uuid "38edd513-af3d-5da1-9d87-d229b9ce95f5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347701}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "581af8f1-8855-519d-a20e-429c65cef0c0" :question/math-academy-id "q-80778" :question/problem "Consider the surface ${2}^{3{z}^{2}+2xy}=2.$ Given that $n=⟨a,b,c⟩$ is a non-zero normal vector to the surface at the point $(1,-1,1),$ what is the value of $\\frac{c}{b}?$" :question/worked-solution "Let's define  $f(x,y,z)={2}^{3{z}^{2}+2xy}.$ Then, our surface can be viewed as the level surface $f(x,y,z)=2.$  \n\nNow, we find the gradient of $f(x,y,z)$ and evaluate it at $(1,-1,1):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =\\frac{∂}{∂x}({2}^{3{z}^{2}+2xy})i+\\frac{∂}{∂y}({2}^{3{z}^{2}+2xy})j+\\frac{∂}{∂z}({2}^{3{z}^{2}+2xy})k \\\\  & =({2}^{3{z}^{2}+2xy}\\cdot 2y\\operatorname{ln}⁡2)i+({2}^{3{z}^{2}+2xy}\\cdot 2x\\operatorname{ln}⁡2)j+({2}^{3{z}^{2}+2xy}\\cdot 6z\\operatorname{ln}⁡2)k \\\\  & =2\\operatorname{ln}⁡2(y\\,\\text{ }{2}^{3{z}^{2}+2xy}\\text{ }i+x\\,\\text{ }{2}^{3{z}^{2}+2xy}\\text{ }j+3z\\,\\text{ }{2}^{3{z}^{2}+2xy}\\text{ }k) \\\\ ∇f(1,-1,1) & =2\\operatorname{ln}⁡2((-1)\\cdot \\text{ }{2}^{3(1)^{2}+2\\cdot 1\\cdot (-1)}\\text{ }i+1\\cdot \\,\\text{ }{2}^{3(1)^{2}+2\\cdot 1\\cdot (-1)}\\text{ }j+3(1)\\cdot {2}^{3(1)^{2}+2\\cdot 1\\cdot (-1)}\\text{ }k) \\\\  & =2\\operatorname{ln}⁡2(-{2}^{1}\\text{ }i+{2}^{1}\\text{ }j+3\\cdot {2}^{1}\\text{ }k) \\\\  & =4\\operatorname{ln}⁡2(-i+j+3\\text{ }k) \\\\  & =⟨-4\\operatorname{ln}⁡2,\\,4\\operatorname{ln}⁡2,\\,12\\operatorname{ln}⁡2⟩\\end{aligned}\n$$\n\nTherefore, our normal vector is $n=⟨a,b,c⟩=⟨-4\\operatorname{ln}⁡2,\\,4\\operatorname{ln}⁡2,\\,12\\operatorname{ln}⁡2⟩.$\n\nFinally, $\\frac{c}{b}=\\frac{12\\operatorname{ln}⁡2}{4\\operatorname{ln}⁡2}=3.$"}] [{:db/id #edb/ref 17592186348451 :knowledge-point/_questions [{:db/id #edb/ref 17592186087735 :knowledge-point/id #uuid "01caf021-de3e-5e2a-89ce-ba289b65c0ff" :knowledge-point/title "Writing a Complex Number in Exponential Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "125a7499-daea-5b5a-bef6-ea8655c63411" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=6\\,{\\text{e}}^{2\\pi \\text{i}/3}" :db/id #edb/ref 17592186345509} {:answer/id #uuid "12b079a4-9cf6-57d5-b910-bde76a8fe294" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=6\\,{\\text{e}}^{\\pi \\text{i}/3}" :db/id #edb/ref 17592186345512} {:answer/id #uuid "447bc679-763d-5ae0-afdc-316c890e6827" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=4\\,{\\text{e}}^{\\pi \\text{i}/3}" :db/id #edb/ref 17592186345942} {:answer/id #uuid "92dc2963-35f2-5f74-93b5-e7c999f47bb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=6\\,{\\text{e}}^{\\pi \\text{i}/6}" :db/id #edb/ref 17592186346636} {:answer/id #uuid "f0ff8f7c-6d0e-56a7-ba0f-b776d57b7c1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=4\\,{\\text{e}}^{\\pi \\text{i}/6}" :db/id #edb/ref 17592186347478}] :answer-field/correct {:answer/id #uuid "92dc2963-35f2-5f74-93b5-e7c999f47bb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=6\\,{\\text{e}}^{\\pi \\text{i}/6}" :db/id #edb/ref 17592186346636} :answer-field/id #uuid "2c00a6f3-3bb4-556d-900d-ebc65c30a86b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347674}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c929adfb-38d7-5819-8554-7aa009ddd6f8" :question/math-academy-id "q-8078" :question/problem "Write the complex number $z=3\\sqrt{3}+3\\text{i}$ in exponential form." :question/worked-solution "To write $z$ in the form $z=r{\\text{e}}^{\\text{i}\\theta },$ where $r=|z|$ and $\\theta =\\operatorname{arg}⁡(z),$ we first calculate $r:$\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(3\\sqrt{3})^{2}+{3}^{2}} \\\\  & =\\sqrt{36}=6\\end{aligned}\n$$\n\nSince $z$ lies in the first quadrant of the complex plane, we have\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =\\operatorname{arctan}⁡(\\frac{y}{x}) \\\\  & =\\operatorname{arctan}⁡(\\frac{3}{3\\sqrt{3}}) \\\\  & =\\operatorname{arctan}⁡(\\frac{1}{\\sqrt{3}}) \\\\  & =\\frac{\\pi }{6}.\\end{aligned}\n$$\n\nFinally, substituting $r=6$ and $\\theta =\\frac{\\pi }{6}$ into $z=r{e}^{\\text{i}\\theta },$ we get\n\n$$\nz=6\\,{\\text{e}}^{\\pi \\text{i}/6}.\n$$"}] [{:db/id #edb/ref 17592186351158 :knowledge-point/_questions [{:db/id #edb/ref 17592186054630 :knowledge-point/id #uuid "3cbddaef-3828-5454-b892-26a3c6242ddb" :knowledge-point/title "Finding All Subsets of a Given Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8560767a-af4e-5ac9-984b-0d56ecc22cf9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,\\{-\\pi \\},\\{\\pi \\}" :db/id #edb/ref 17592186422838} {:answer/id #uuid "a581296f-1ffd-5680-83b4-0a132fb259d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,\\{-\\pi \\},\\{\\pi \\},\\{-\\pi ,\\pi \\}" :db/id #edb/ref 17592186422869} {:answer/id #uuid "a7e833ed-7b92-5b0e-ac1a-b54703f7a2bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-\\pi \\},\\{\\pi \\},\\{-\\pi ,\\pi \\}" :db/id #edb/ref 17592186422873} {:answer/id #uuid "cceb7cd8-d3cb-5022-80c1-91cc18c492dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-\\pi \\},\\{\\pi \\}" :db/id #edb/ref 17592186422897} {:answer/id #uuid "d6a266a0-5552-509f-ae6b-32ef2b01771f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,\\{-\\pi ,\\pi \\}" :db/id #edb/ref 17592186422905}] :answer-field/correct {:answer/id #uuid "a581296f-1ffd-5680-83b4-0a132fb259d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,\\{-\\pi \\},\\{\\pi \\},\\{-\\pi ,\\pi \\}" :db/id #edb/ref 17592186422869} :answer-field/id #uuid "ef510875-8ddb-5754-836a-118c96470baf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351128}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5ade80e9-fb10-5f67-9c65-ab5d8d98adbc" :question/math-academy-id "q-80809" :question/problem "Find all of the subsets of $U=\\{-\\pi ,\\pi \\}.$" :question/worked-solution "To find every subset of $U,$ we list out every combination of elements within $U.$ \n\nWe can use the following diagram to visualize the process:\n\n![](images/b0/b0e483a2d10cba17fb2bd3bf0e78d7b4d2fc07b22dbb5c492564b998bbfce6fc.png)\n\nNote that we must include the empty set since it is a subset of every set.\n\nBy doing this, we get\n\n$$\n∅,\\{-\\pi \\},\\{\\pi \\},\\{-\\pi ,\\pi \\}.\n$$"}] [{:db/id #edb/ref 17592186351163 :knowledge-point/_questions [{:db/id #edb/ref 17592186087734 :knowledge-point/id #uuid "9be02ade-3dd2-5ec3-a532-78d1151dc89f" :knowledge-point/title "Writing a Complex Number Shown on an Argand Diagram in Exponential Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5bd8fff4-79c1-5e30-9ce6-337b2a20b872" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{5}\\,{\\text{e}}^{7\\pi \\,\\text{i}/6}" :db/id #edb/ref 17592186349292} {:answer/id #uuid "79b311bf-65c7-58fc-b381-6bee661fc901" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\sqrt{5}\\,{\\text{e}}^{3.605\\,\\text{i}}" :db/id #edb/ref 17592186349569} {:answer/id #uuid "7ecd9ca2-c07f-5373-8dc5-c59dfe7aa36b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{5}\\,{\\text{e}}^{3.605\\,\\text{i}}" :db/id #edb/ref 17592186349609} {:answer/id #uuid "aa9d3205-d44e-57ec-95f3-fb33fbb6e446" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\sqrt{5}\\,{\\text{e}}^{2.678\\,\\text{i}}" :db/id #edb/ref 17592186349963} {:answer/id #uuid "f769ac7b-dfab-556e-af9c-c783920eee8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{5}\\,{\\text{e}}^{2.678\\,\\text{i}}" :db/id #edb/ref 17592186350614}] :answer-field/correct {:answer/id #uuid "79b311bf-65c7-58fc-b381-6bee661fc901" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\sqrt{5}\\,{\\text{e}}^{3.605\\,\\text{i}}" :db/id #edb/ref 17592186349569} :answer-field/id #uuid "10320074-e8c3-5c1b-828c-3f9b61cfea74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350736}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "92d2189e-bd4e-5b46-a533-1fb76600704b" :question/math-academy-id "q-8082" :question/problem "![](images/18/18dd1668d0e9eaeb1be7919821707bbf1d472b22b00acf68a921a3522b2f5f7f.png)\n\nWrite the complex number $z$, shown on the Argand diagram above, in the form $r{e}^{\\text{i}\\theta },$ giving $\\theta $ in radians to three decimal places." :question/worked-solution "The complex number shown in the Argand diagram can be written as\n\n$$\n\\begin{aligned}z & =x+\\text{i}y \\\\  & =-4-2\\text{i}.\\end{aligned}\n$$\n\nTo write it in the form $z=r{\\text{e}}^{\\text{i}\\theta },$ where $r=|z|$ and $\\theta =\\operatorname{arg}⁡(z),$ we first calculate $r:$\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(-4)^{2}+(-2)^{2}} \\\\  & =\\sqrt{20} \\\\  & =2\\sqrt{5}\\end{aligned}\n$$\n\nNow, since $z$ lies in the third quadrant, we can find the angle $\\theta $ as\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =\\pi +|\\operatorname{arctan}⁡(\\frac{y}{x})| \\\\  & =\\pi +|\\operatorname{arctan}⁡(\\frac{-2}{-4})| \\\\  & =\\pi +|\\operatorname{arctan}⁡(\\frac{1}{2})| \\\\  & ≈\\pi +0.463\\,64… \\\\  & ≈3.605.\\end{aligned}\n$$\n\nFinally, substituting $r=2\\sqrt{5}$ and $\\theta =3.605$ into $z=r{e}^{\\text{i}\\theta },$ we get \n\n$$\nz=2\\sqrt{5}\\,{\\text{e}}^{3.605\\,\\text{i}}\\,.\n$$"}] [{:db/id #edb/ref 17592186351167 :knowledge-point/_questions [{:db/id #edb/ref 17592186087734 :knowledge-point/id #uuid "9be02ade-3dd2-5ec3-a532-78d1151dc89f" :knowledge-point/title "Writing a Complex Number Shown on an Argand Diagram in Exponential Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14b78753-dd95-5e18-b9cb-44a50490b52c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{5}\\,{\\text{e}}^{2.897\\,\\text{i}}" :db/id #edb/ref 17592186348623} {:answer/id #uuid "2b1be51e-00c9-59da-a547-1eda2b241518" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{17}\\,{\\text{e}}^{0.245\\,\\text{i}}" :db/id #edb/ref 17592186348830} {:answer/id #uuid "4e7f73b8-5d42-525c-b8a7-323292ac35dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{13}\\,{\\text{e}}^{5\\pi \\text{i}/6}" :db/id #edb/ref 17592186349157} {:answer/id #uuid "bf88e169-2503-549a-a4f9-99913a4b0da9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{5}\\,{\\text{e}}^{0.245\\,\\text{i}}" :db/id #edb/ref 17592186350149} {:answer/id #uuid "ec47cf81-ba67-5092-ae53-df29d699c071" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{17}\\,{\\text{e}}^{2.897\\,\\text{i}}" :db/id #edb/ref 17592186350507}] :answer-field/correct {:answer/id #uuid "ec47cf81-ba67-5092-ae53-df29d699c071" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{17}\\,{\\text{e}}^{2.897\\,\\text{i}}" :db/id #edb/ref 17592186350507} :answer-field/id #uuid "b61f2103-bcfa-5a6f-b9b9-b1c1d999714f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351022}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e23c3a32-b3bb-5338-8832-25e8c14f3ac5" :question/math-academy-id "q-8083" :question/problem "![](images/83/83c490278bec718da1338f8926e9d67d2f72909487b9a85bbd386cbf72def2bb.png)\n\nWrite the complex number $z$, shown on the Argand diagram above, in the form $r{e}^{\\text{i}\\theta },$ giving $\\theta $ in radians to $3$ decimal places." :question/worked-solution "The complex number shown in the Argand diagram can be written as\n\n$$\n\\begin{aligned}z & =x+\\text{i}y \\\\  & =-4+\\text{i}.\\end{aligned}\n$$\n\nTo write it in the form $z=r{\\text{e}}^{\\text{i}\\theta },$ where $r=|z|$ and $\\theta =\\operatorname{arg}⁡(z),$ we first calculate $r:$\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(-4)^{2}+{1}^{2}} \\\\  & =\\sqrt{17}\\end{aligned}\n$$\n\nSince $z$ lies in the second quadrant of the complex plane, we have\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =\\pi -|\\operatorname{arctan}⁡(\\frac{y}{x})| \\\\  & =\\pi -|\\operatorname{arctan}⁡(-\\frac{1}{4})| \\\\  & ≈2.897.\\end{aligned}\n$$\n\nFinally, substituting $r=\\sqrt{17}$ and $\\theta =2.897$ into $z=r{e}^{\\text{i}\\theta },$ we get\n\n$$\nz=\\sqrt{17}\\,{\\text{e}}^{2.897\\,\\text{i}}.\n$$"}] [{:db/id #edb/ref 17592186351176 :knowledge-point/_questions [{:db/id #edb/ref 17592186157285 :knowledge-point/id #uuid "67e90c94-5018-582f-8692-a1155f41f7c7" :knowledge-point/title "Finding Differences of Sets Given Verbally"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a284a9a8-2c8b-5360-8862-5fa84376ab51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186349897} {:answer/id #uuid "1eee49b7-7d23-57d3-be48-80546786725e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{10,20,30,40,50,60,70,…\\}" :db/id #edb/ref 17592186422755} {:answer/id #uuid "3656c7be-564a-5dca-b523-f1cf8ca9939f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{5,10,15,20,25,30,35,40,45,50,55,60,65,70,75,…\\}" :db/id #edb/ref 17592186422775} {:answer/id #uuid "d54904e8-c3f4-50ab-b94b-312c9c80dbb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{15,30,45,60,75,…\\}" :db/id #edb/ref 17592186422904} {:answer/id #uuid "e8c1a6ce-e81b-50b5-825e-bab71ce12858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{5,15,25,35,45,55,65,75,…\\}" :db/id #edb/ref 17592186422916}] :answer-field/correct {:answer/id #uuid "a284a9a8-2c8b-5360-8862-5fa84376ab51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186349897} :answer-field/id #uuid "adc8c03c-2db7-556e-a6d7-5bf3ef6dc447" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351004}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1076728a-78e3-5cde-ae2f-0952fd39a682" :question/math-academy-id "q-80876" :question/problem "Let $C$  be the set of all multiples of $10$ greater than $0$ and let $D$  be the the set of all multiples of $5$ greater than $0.$ What is $C∖D?$" :question/worked-solution "The multiples of $10$ that are greater than $0$ are\n\n$$\nC=\\{10,20,30,40,50,60,70,…\\}.\n$$\n\nLikewise, multiples of $5$ that are greater than $0$ are\n\n$$\nD=\\{5,10,15,20,25,30,35,40,45,50,55,60,65,70,75,…\\}.\n$$\n\nNow, $C∖D$ is the *difference* of $C$ and $D,$ which means that we want to find the elements that are in $C$ but *not* in $D.$\n\nThe elements of $C$ that are also in $D$ are $10,20,30,40,$ and so on (i.e. multiples of $10$). So, we must remove these elements from $C.$ Therefore, we have\n\n$$\n\\begin{aligned}C∖D & =C-D \\\\  & =\\{10,20,30,40,50,60,70,…\\}-\\{5,10,15,20,25,30,35,40,45,50,55,60,65,70,75,…\\} \\\\  & =∅.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186351183 :knowledge-point/_questions [{:db/id #edb/ref 17592186105766 :knowledge-point/id #uuid "c36ce626-1562-51f8-b3fd-d7dc7ce8659c" :knowledge-point/title "Identifying a Shear or Stretch Transformation Represented by a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fedbbfe-52e4-5191-86d8-a6cb8a427195" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A stretch of scale factor $5$ in the $y$-direction" :db/id #edb/ref 17592186348723} {:answer/id #uuid "3485994a-6471-5a88-99f7-ec1f6bbb3a34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A vertical shear with a shear factor of $\\frac{1}{2}$" :db/id #edb/ref 17592186348918} {:answer/id #uuid "57264c7e-7bfb-5b58-bd90-d6c855bb7d54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A stretch of scale factor $5$ in the $x$-direction" :db/id #edb/ref 17592186349246} {:answer/id #uuid "8ff996eb-42bc-56b2-98ef-999dd09415ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A horizontal shear with a shear factor of $5$" :db/id #edb/ref 17592186349739} {:answer/id #uuid "edd6a605-e9a9-5469-9059-3317b846a296" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A vertical shear with a shear factor of $5$" :db/id #edb/ref 17592186350524}] :answer-field/correct {:answer/id #uuid "1fedbbfe-52e4-5191-86d8-a6cb8a427195" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A stretch of scale factor $5$ in the $y$-direction" :db/id #edb/ref 17592186348723} :answer-field/id #uuid "214dc178-e873-5596-9c82-a5599e5bf56f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350766}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a4ea07e2-2b18-5ed4-ac42-77d3595de881" :question/math-academy-id "q-8090" :question/problem "What linear transformation $T$ is represented by the following matrix\n$[\\begin{aligned}1 & 0 \\\\ 0 & 5\\end{aligned}]?$" :question/worked-solution "We can find the images of the standard basis vectors $i$ and $j$ under the action of  $T,$ as follows:\n\n$$\n\\begin{aligned}T(i) & =[\\begin{aligned}1 & 0 \\\\ 0 & 5\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}1 \\\\ 0\\end{aligned}]=i \\\\ T(j) & =[\\begin{aligned}1 & 0 \\\\ 0 & 5\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}0 \\\\ 5\\end{aligned}]=5j\\end{aligned}\n$$\n\nTherefore, the matrix represents a stretch of scale factor $5$ in the $y$-direction."}] [{:db/id #edb/ref 17592186394085 :knowledge-point/_questions [{:db/id #edb/ref 17592186087750 :knowledge-point/id #uuid "7c9849b9-397b-5fb9-bb4b-01f3d013c5c2" :knowledge-point/title "Computing the Image of a Polygon Under the Action of a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e5878e4-f118-5e48-9f1f-25b06f4e11bc" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/46/4672e5a5e616c8c6f4d40d1f29a2a8794da4e8d61c8bab09b7483ec292a91410.png" :db/id #edb/ref 17592186394087} {:answer/id #uuid "785d13cd-3fdd-5848-9cdb-db6e373bbb4a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0f/0f5bf56cb4e4546079d89fd97b9533676116d4cff5435cbc926b925af5d3f637.png" :db/id #edb/ref 17592186394088} {:answer/id #uuid "9770d4f6-dde0-5f7a-aeb2-5671a5981656" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/54/54496f08a7d4d6b5d37713ffe6d4bc903d48da90def0b273c114fb3b27e32bc9.png" :db/id #edb/ref 17592186394089} {:answer/id #uuid "6ec43ec3-b120-5bf6-bbac-590a300de61a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3c/3caf43c4c62614f0c38b2f32c12892820ab4ae732669767b0d50104c85eee605.png" :db/id #edb/ref 17592186394090} {:answer/id #uuid "027e492d-1183-5ffe-8e93-74878e08032d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/cb/cb590309256b4836583132f707ceb405472d104908f5df45a0d41dfa18c84a30.png" :db/id #edb/ref 17592186394091}] :answer-field/correct {:answer/id #uuid "6ec43ec3-b120-5bf6-bbac-590a300de61a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3c/3caf43c4c62614f0c38b2f32c12892820ab4ae732669767b0d50104c85eee605.png" :db/id #edb/ref 17592186394090} :answer-field/id #uuid "18abe65c-6c5d-58b2-9bd6-68ded8dd9d89" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394086}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "620f4a44-3dbc-5f00-8f93-44670447e38b" :question/math-academy-id "q-8093" :question/problem "![](images/36/369dde2e95b52356b71972b8f1103430e0a840d3d0478626dc5a78cba0f51a41.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}1 & -1 \\\\ 1 & 1\\end{aligned}].\n$$\n\nThe quadrilateral $ABCD$ is shown above. Which of the following is ${A}^{′}{B}^{′}{C}^{′}{D}^{′},$ the image of $ABCD$ under the action of $T?$" :question/worked-solution "To find the image of $T$ under the action of $T$, we first create a matrix $X$ containing all of the vertices of $ABCD:$\n\n$$\nX=[\\begin{aligned}1 & 3 & 4 & 2 \\\\ 2 & 3 & 4 & 3\\end{aligned}]\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}1 & -1 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}1 & 3 & 4 & 2 \\\\ 2 & 3 & 4 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 0 & 0 & -1 \\\\ 3 & 6 & 8 & 5\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${A}^{′}{B}^{′}{C}^{′}{D}^{′}$ are $(-1,3),(0,6),(0,8),(-1,5)$, as shown below.\n\n![](images/3c/3caf43c4c62614f0c38b2f32c12892820ab4ae732669767b0d50104c85eee605.png)"}] [{:db/id #edb/ref 17592186351212 :knowledge-point/_questions [{:db/id #edb/ref 17592186184188 :knowledge-point/id #uuid "fce4cd5a-537a-5eb4-a610-59d2bad95a89" :knowledge-point/title "Deducing the Second-Degree Taylor Polynomial Given the Graph of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "166e70d6-9c1d-51c0-981a-b67958187b1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6-4(x+1)-5(x+1)^{2}" :db/id #edb/ref 17592186348632} {:answer/id #uuid "167f01c6-9d3a-58e2-abba-53477d431952" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6+4(x+1)+5(x+1)^{2}" :db/id #edb/ref 17592186348634} {:answer/id #uuid "2e47ce6a-3481-570b-ae11-84c963ac15fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6-4(x+1)+5(x+1)^{2}" :db/id #edb/ref 17592186348857} {:answer/id #uuid "3854f836-00e3-58ef-b79a-c3be5283a8f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6+4(x+1)-5(x+1)^{2}" :db/id #edb/ref 17592186348956} {:answer/id #uuid "a2919153-4efc-5baf-a122-ae6d0d56fa9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6+4(x+1)-5(x+1)^{2}" :db/id #edb/ref 17592186349898}] :answer-field/correct {:answer/id #uuid "a2919153-4efc-5baf-a122-ae6d0d56fa9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6+4(x+1)-5(x+1)^{2}" :db/id #edb/ref 17592186349898} :answer-field/id #uuid "2201af6a-d73e-5d90-98e9-6603edde20a5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350771}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0d3ec608-2690-560e-ab12-4c63cb591926" :question/math-academy-id "q-81064" :question/problem "![](images/18/185b5924c542bb9f396fe826aac141256a13b967c45c47afc87ca07445df062f.png)\n\nThe figure above shows the graph of a function $y=f(x).$ Which of the following could be the second-degree Taylor polynomial for $f$ about $x=-1?$" :question/worked-solution "The second-degree Taylor polynomial for $f(x)$ about $x=-1$ is \n\n$$\n{P}_{2}(x)=f(-1)+{f}^{′}(-1)(x+1)+\\frac{{f}^{″}(-1)}{2}(x+1)^{2}.\n$$\n\nFrom the graph, we observe:\n\n- $f(-1)>0.$ Therefore, the first term of the Taylor polynomial must be positive.\n\n- ${f}^{′}(-1)>0,$ because the slope of the tangent at $x=-1$ is positive. Therefore, the coefficient of the second term in the Taylor polynomial must be positive.\n\n- ${f}^{″}(-1)<0,$ because the graph is concave down at $x=-1.$ Therefore, the coefficient of the third term in the Taylor polynomial must be negative.\n\nThe only option that meets the above criteria is\n\n$$\n{P}_{2}(x)=6+4(x+1)-5(x+1)^{2}.\n$$"}] [{:db/id #edb/ref 17592186106492 :knowledge-point/_questions [{:db/id #edb/ref 17592186105924 :knowledge-point/id #uuid "d083b53b-8c39-5785-a250-5649001e822b" :knowledge-point/title "Finding the Area of an Unbounded Region"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22eb12d2-be27-5318-b9b5-bc8ce441dbe5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186348745} {:answer/id #uuid "2a801a9c-0cd9-58b7-b0af-ec07ab01bce9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186348823} {:answer/id #uuid "611e3655-dcef-5c9f-9d62-abf777e0d5f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186349335} {:answer/id #uuid "61bd2f38-b4df-525a-aa67-e6f20882523f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186349340} {:answer/id #uuid "b8d744db-c771-557f-b1c1-75b48e05d552" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186350081}] :answer-field/correct {:answer/id #uuid "22eb12d2-be27-5318-b9b5-bc8ce441dbe5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186348745} :answer-field/id #uuid "5b5b24bf-e5bc-5b1b-b79e-6343f5a2672f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350859}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a815879d-3333-5bf0-a2f7-1d630f329248" :question/math-academy-id "q-81168" :question/problem "![](images/47/478ea8a880f959248ae2885776ca3c2b3774935f96ddb64ce531adc6fc5b3ef7.png)\n\nFind the total area of the region bounded by the graph of the curve $y=\\frac{1}{9+{x}^{2}}$ and the $x$-axis, as shown above." :question/worked-solution "We find the area of the region bounded by the graph of the curve and the $x$-axis by calculating the integral\n\n$$\nA={\\int }_{-\\infty }^{\\infty }\\frac{1}{9+{x}^{2}}\\,\\text{d}x.\n$$\n\nWe break up the integral as follows:\n\n$$\n{\\int }_{-\\infty }^{\\infty }\\frac{1}{9+{x}^{2}}\\,\\text{d}x={\\int }_{-\\infty }^{0}\\frac{1}{9+{x}^{2}}\\,\\text{d}x+{\\int }_{0}^{\\infty }\\frac{1}{9+{x}^{2}}\\,\\text{d}x.\n$$\n\nEvaluating the first of these integrals, we get\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{1}{9+{x}^{2}}\\,\\text{d}x & ={lim}_{a\\to -\\infty }{\\int }_{a}^{0}\\frac{1}{9+{x}^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{3}{lim}_{a\\to -\\infty }{\\int }_{a}^{0}\\frac{3}{9+{x}^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{3}{lim}_{a\\to -\\infty }({\\operatorname{arctan}⁡\\frac{x}{3}|}_{a}^{0}) \\\\  & =\\frac{1}{3}{lim}_{a\\to -\\infty }(\\operatorname{arctan}⁡0-\\operatorname{arctan}⁡\\frac{a}{3}) \\\\  & =-\\frac{1}{3}{lim}_{a\\to -\\infty }\\operatorname{arctan}⁡\\frac{a}{3} \\\\  & =-\\frac{1}{3}\\cdot (-\\frac{\\pi }{2}) \\\\  & =\\frac{\\pi }{6}.\\end{aligned}\n$$\n\nNow, notice that the integrand is an **even** function. This means that we can immediately deduce that\n\n$$\n{\\int }_{0}^{\\infty }\\frac{1}{9+{x}^{2}}\\,\\text{d}x=\\frac{\\pi }{6}.\n$$\n\nTherefore, since both improper integrals exist, we conclude that \n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{\\infty }\\frac{1}{9+{x}^{2}}\\,\\text{d}x & ={\\int }_{-\\infty }^{0}\\frac{1}{9+{x}^{2}}\\,\\text{d}x+{\\int }_{0}^{\\infty }\\frac{1}{9+{x}^{2}}\\,\\text{d}x \\\\  & =\\frac{\\pi }{6}+\\frac{\\pi }{6} \\\\  & =\\frac{\\pi }{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186351254 :knowledge-point/_questions [{:db/id #edb/ref 17592186175930 :knowledge-point/id #uuid "4ad17d11-325f-5888-a5cd-61ee27f7a103" :knowledge-point/title "Finding Two Linearly Independent Complex Eigenvectors of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d2186bf-8e2a-5919-9a57-038da8a95f1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\text{i}" :db/id #edb/ref 17592186348703} {:answer/id #uuid "26d28bf2-ab2d-51f7-8f6f-0c8c6e7be356" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\text{i}" :db/id #edb/ref 17592186348781} {:answer/id #uuid "4c2889e3-22ba-50e5-b821-5781818d3ea5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186349144} {:answer/id #uuid "b92afd2c-cf06-5a2f-8e02-280de77a1dee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186350088} {:answer/id #uuid "f2754a64-6295-5716-8000-3005cae0cb02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186350571}] :answer-field/correct {:answer/id #uuid "4c2889e3-22ba-50e5-b821-5781818d3ea5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186349144} :answer-field/id #uuid "71561c41-3170-56ee-aacf-b2d7928f8574" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350902}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d7d8a5d1-5161-58c0-bd9b-fe0499d92ff6" :question/math-academy-id "q-81190" :question/problem "Let ${v}_{1}=[\\begin{aligned}{a}_{1} \\\\ {b}_{1}\\end{aligned}]$ and ${v}_{2}=[\\begin{aligned}{a}_{2} \\\\ {b}_{2}\\end{aligned}]$ be linearly independent eigenvectors of the matrix\n$A=[\\begin{aligned}-1 & 5 \\\\ -2 & 1\\end{aligned}].$\nGiven that ${\\lambda }_{1}=3\\text{i}$ is an eigenvalue of $A,$ find the value of $\\frac{{a}_{1}{a}_{2}}{{b}_{1}{b}_{2}}.$" :question/worked-solution "To compute the eigenvectors of a matrix, we need to find non-zero solutions of the matrix equation \n\n$$\n(A-\\lambda I)\\text{x}=0.\n$$\n\n \n\nIn our case, we have $\\,{\\lambda }_{1}=3\\text{i}$ and\n\n$$\n\\begin{aligned}A-{\\lambda }_{1}I & =[\\begin{aligned}-1 & 5 \\\\ -2 & 1\\end{aligned}]-[\\begin{aligned}3\\text{i} & 0 \\\\ 0 & 3\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}-1-3\\text{i} & 5 \\\\ -2 & 1-3\\text{i}\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the homogeneous system of linear equations\n\n$$\n\\{\\begin{aligned}(-1-3\\text{i}){x}_{1}+5{x}_{2}=0 \\\\ -2{x}_{1}+(1-3\\text{i}){x}_{2}=0.\\end{aligned}\n$$\n\nNow, since the matrix $A-3\\text{i}I$ is singular, the system above must have a non-zero solution. This means that one equation of the system is a multiple of another. As a result, we can drop one of the rows and take one of the variables as the free variable. For example, from the first equation, we get\n\n$$\n{x}_{2}=\\frac{1}{5}(1+3\\text{i}){x}_{1}\n$$\n\nHence, the general solution is given by\n\n$$\n[\\begin{aligned}{x}_{1} \\\\ \\frac{1}{5}(1+3\\text{i}){x}_{1}\\end{aligned}],\\,{x}_{1}\\in C.\n$$\n\nSetting ${x}_{1}=5,$ we get the eigenvector\n\n$$\n{v}_{1}=[\\begin{aligned}5 \\\\ 1+3\\text{i}\\end{aligned}].\n$$\n\n \n\nOn the other hand, since ${\\lambda }_{1}=3\\text{i}$ is a complex eigenvalue of $A,$ the second eigenvalue of $A$ must be the  complex conjugate of ${\\lambda }_{1}.$ Therefore, \n\n$$\n{\\lambda }_{2}=\\overset{―}{{\\lambda }_{1}}=-3\\text{i}.\n$$\n\nMoreover, the corresponding eigenvector to ${\\lambda }_{2}$ is\n\n$$\n{v}_{2}={\\overset{―}{v}}_{1}=[\\begin{aligned}5 \\\\ 1-3\\text{i}\\end{aligned}].\n$$\n\nTherefore, we obtain\n\n$$\n\\frac{{a}_{1}{a}_{2}}{{b}_{1}{b}_{2}}=\\frac{(5)(5)}{(1+3\\text{i})(1-3\\text{i})}=\\frac{5}{2}.\n$$"}] [{:db/id #edb/ref 17592186351258 :knowledge-point/_questions [{:db/id #edb/ref 17592186157287 :knowledge-point/id #uuid "9a55a708-abb0-5e23-8862-153561d022c8" :knowledge-point/title "Finding the Complement of a Set Without a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ae8da4d-49d1-5d59-b5f2-9ba7fac1a5ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{1,3,6,9\\}" :db/id #edb/ref 17592186422748} {:answer/id #uuid "32175474-2a33-5edd-82d1-ca23fe06b582" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{1,3,5,7,9\\}" :db/id #edb/ref 17592186422773} {:answer/id #uuid "5b05c18c-16d7-52fb-815b-13f340ae470d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{1,2,3,4,5,6,7,8,9\\}" :db/id #edb/ref 17592186422809} {:answer/id #uuid "62686a45-f9e0-5352-8bd0-280e32a4a7dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{3,5,7,9\\}" :db/id #edb/ref 17592186422811} {:answer/id #uuid "8e2a7810-134a-59c6-95e0-9e32883d711d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{0,3,6,9\\}" :db/id #edb/ref 17592186422845}] :answer-field/correct {:answer/id #uuid "32175474-2a33-5edd-82d1-ca23fe06b582" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{1,3,5,7,9\\}" :db/id #edb/ref 17592186422773} :answer-field/id #uuid "21188bb3-7c29-56d5-bce0-52b90aee9ec7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350765}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "35334f88-cecb-5c05-827d-5c2f77f4118a" :question/math-academy-id "q-81203" :question/problem "If $U=\\{1,2,3,…,10\\}$ is the universal set and $A=\\{2,4,6,8,10\\},$ then the complement of $A$ is" :question/worked-solution "The complement of $A,$ denoted $\\overset{―}{A},$ consists of every element in the universal set $U$ that is not in the set $A.$\n\nThe elements of $U$ that are not in $A$ are $1,$ $3,$ $5,$ $7,$ and $9.$\n\nTherefore, the complement of $A$ is\n\n$$\n\\overset{―}{A}=\\{1,3,5,7,9\\}.\n$$"}] [{:db/id #edb/ref 17592186351259 :knowledge-point/_questions [{:db/id #edb/ref 17592186157288 :knowledge-point/id #uuid "49251196-c06b-5718-82e6-5ed9450301af" :knowledge-point/title "Finding the Complement of a Set Given Using Ellipsis Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16477003-cf0b-5c83-86c6-010a4fd01ccd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-18,-14,-10,-6,-2,2,6,10,14,18\\}" :db/id #edb/ref 17592186422749} {:answer/id #uuid "1f9b53a9-1ace-522a-a982-9f2273e85246" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-16,-14,-12,-10,…,16\\}" :db/id #edb/ref 17592186422756} {:answer/id #uuid "3943ae65-9d1c-52ad-ac6f-f19c4854ec2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-18,-16,-14,-12,…,18\\}" :db/id #edb/ref 17592186422779} {:answer/id #uuid "92200749-20dc-58fb-8a4b-402b623d1530" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-20,-16,-12,-8,-4,0,4,8,12,16\\}" :db/id #edb/ref 17592186422850} {:answer/id #uuid "aca7987c-36a3-5372-90f4-1bc62f2eb30e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-18,-12,-6,0,6,12,18\\}" :db/id #edb/ref 17592186422875}] :answer-field/correct {:answer/id #uuid "16477003-cf0b-5c83-86c6-010a4fd01ccd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-18,-14,-10,-6,-2,2,6,10,14,18\\}" :db/id #edb/ref 17592186422749} :answer-field/id #uuid "a2ba48f4-bfb9-53b1-b63c-347212329c4e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350983}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "99c47e36-6326-59cd-8a70-c88572cc5f54" :question/math-academy-id "q-81205" :question/problem "If $U=\\{-20,-18,-16,-14,…,20\\}$ is the universal set and $A=\\{-20,-16,-12,-8,…,20\\},$ then $\\overset{―}{A}=$" :question/worked-solution "The complement of $A,$ denoted $\\overset{―}{A},$ consists of every element in the universal set $U$ that is not in the set $A.$\n\nThe universal set $U$ consists of the even integers $-20$ through $20,$ while the set $A$ consists of the multiples of $4$ from $-20$ through $20.$\n\nSo, the only elements of $U$ that are not in $A$ are the even integers from $-18$ through $18$ that are not multiples of $4.$\n\nTherefore, the complement of $A$ is\n\n$$\n\\overset{―}{A}=\\{-18,-14,-10,-6,-2,2,6,10,14,18\\}.\n$$"}] [{:db/id #edb/ref 17592186351268 :knowledge-point/_questions [{:db/id #edb/ref 17592186092273 :knowledge-point/id #uuid "386a4f1a-4ee5-5bf7-aff2-e190c83f4529" :knowledge-point/title "Finding the Cartesian Coordinates of a Point Using a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a38cdd4-2914-5fbf-af5a-f896fca82487" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\frac{11}{2},-4\\sqrt{2})" :db/id #edb/ref 17592186348534} {:answer/id #uuid "46388f94-0b9a-5819-926f-46042d3247f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-6,-4\\sqrt{2})" :db/id #edb/ref 17592186349085} {:answer/id #uuid "46e780ae-e427-5db3-9e7b-87fd979da562" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,-5\\sqrt{3})" :db/id #edb/ref 17592186349091} {:answer/id #uuid "de7003e9-ed40-536d-a5eb-03ffaab61707" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-5,-5\\sqrt{3})" :db/id #edb/ref 17592186350392} {:answer/id #uuid "e8f16d9b-438b-5abd-801a-9c54b0392c42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-5,-4\\sqrt{6})" :db/id #edb/ref 17592186350488}] :answer-field/correct {:answer/id #uuid "de7003e9-ed40-536d-a5eb-03ffaab61707" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-5,-5\\sqrt{3})" :db/id #edb/ref 17592186350392} :answer-field/id #uuid "07393c80-442e-58d3-986a-670d473a0e30" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350717}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ebfe6ff0-a2a2-5246-ac85-4546ec479cc9" :question/math-academy-id "q-81224" :question/problem "![](images/a6/a615f7a80b81f89fccd8c82bf65d65e3a4a65958ec8a6fbc746ae68749949a87.png)\n\nThe diagram above shows a circle of radius $r$ centered at the origin. If the polar coordinates of the point $A$ are $(10,\\frac{\\pi }{3})$ and $m∠AOB=\\pi ,$ what are the Cartesian coordinates of $B?$" :question/worked-solution "First, since $A$ has polar coordinates $(10,\\frac{\\pi }{3}),$ we must have $r=10.$ Also, since the points $A$ and $B$ both lie on a circle of radius $10,$ the $r$-coordinate of $B$ must also be $10.$\n\nNotice that one must traverse the circle counterclockwise to move from the point $A$ to point $B.$ Since the $\\theta $-coordinate of $A$ is $\\frac{\\pi }{3},$ the $\\theta $-coordinate of $B$ must be\n\n$$\n{\\theta }_{B}=\\frac{\\pi }{3}+\\pi =\\frac{4\\pi }{3}.\n$$\n\nSo, the polar coordinates of $B$ are $(10,\\frac{4\\pi }{3})$\n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =10\\operatorname{cos}⁡(\\frac{4\\pi }{3}) \\\\  & =10(-\\frac{1}{2}) \\\\  & =-5\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =10\\operatorname{sin}⁡(\\frac{4\\pi }{3}) \\\\  & =10(-\\frac{\\sqrt{3}}{2}) \\\\  & =-5\\sqrt{3}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(-5,-5\\sqrt{3}).$"}] [{:db/id #edb/ref 17592186382448 :knowledge-point/_questions [{:db/id #edb/ref 17592186129171 :knowledge-point/id #uuid "307bccb6-036f-51bb-99ce-327aad8dfdbe" :knowledge-point/title "Evaluating a Double Integral When the Integrand Contains Only One Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51a89715-7a54-5300-819b-fa080b061464" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186382450} {:answer/id #uuid "56fb164e-39a3-5e17-815d-ec81eaeb5642" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186382451} {:answer/id #uuid "a9cb3d91-b5e5-5157-8a43-6dd0b3fbf045" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186382452} {:answer/id #uuid "8cf0027f-33d6-5dec-9265-dd1640066c6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186382453} {:answer/id #uuid "5f806e22-cdeb-5e59-8750-426e910009d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186382454}] :answer-field/correct {:answer/id #uuid "5f806e22-cdeb-5e59-8750-426e910009d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186382454} :answer-field/id #uuid "d2ffc185-1273-5e29-8ff4-7540cee84426" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382449}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c9713fa5-57af-5823-80a4-91a27fbe3a41" :question/math-academy-id "q-81244" :question/problem "Calculate ${∬}_{R}({x}^{2}-y+1)\\,\\text{d}A$,  where $R=[-3,0]\\times [0,4].$" :question/worked-solution "Using the linearity property of double integrals, we can write\n\n$$\n\\begin{aligned}{∬}_{R}({x}^{2}-y+1)\\,\\text{d}A & ={∬}_{R}{x}^{2}\\text{ }\\text{d}A-{∬}_{R}y\\text{ }\\text{d}A+{∬}_{R}\\text{d}A.\\end{aligned}\n$$\n\nThe function under the first integral is independent of $y.$ So, we have \n\n$$\n\\begin{aligned}{∬}_{R}{x}^{2}\\text{ }\\text{d}A & =(4-0){\\int }_{-3}^{0}{x}^{2}\\,\\text{d}x \\\\  & =4[\\frac{{x}^{3}}{3}]_{-3}^{0} \\\\  & =4(\\frac{{0}^{3}}{3}-\\frac{(-3)^{3}}{3}) \\\\  & =36.\\end{aligned}\n$$\n\nThe function under the second integral is independent of $x.$ So, we have \n\n$$\n\\begin{aligned}{∬}_{R}y\\text{ }\\text{d}A & =(0-(-3)){\\int }_{0}^{4}y\\,\\text{d}y \\\\  & =3[\\frac{{y}^{2}}{2}]_{0}^{4} \\\\  & =3(\\frac{{4}^{2}}{2}-\\frac{{0}^{2}}{2}) \\\\  & =24.\\end{aligned}\n$$\n\nThe third integral is the double integral of unity:\n\n$$\n\\begin{aligned}{∬}_{R}\\text{d}A=\\text{Area}(R)=3\\cdot 4=12\\end{aligned}\n$$\n\n \n\nFinally, combining our results, we obtain\n\n$$\n\\begin{aligned}{∬}_{R}({x}^{2}-y+1)\\,\\text{d}A=36-24+12=24.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186382462 :knowledge-point/_questions [{:db/id #edb/ref 17592186129172 :knowledge-point/id #uuid "8059a197-e9fb-5306-8eed-62c0cea88f33" :knowledge-point/title "Evaluating a Double Integral Using the Additivity Over a Rectangular Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "424c1725-f6be-557b-8ba1-de6cd2c48a82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186382464} {:answer/id #uuid "ad38cb99-0e64-5f96-baca-e7d0549cba5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186382465} {:answer/id #uuid "1e089d84-f069-5f2c-83fa-ebc8d830878a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186382466} {:answer/id #uuid "c6fc8d95-fed9-543b-84f8-e46cb703d09b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186382467} {:answer/id #uuid "9f1aadd1-ba01-5e68-a02a-c2ed4e7c1f65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186382468}] :answer-field/correct {:answer/id #uuid "ad38cb99-0e64-5f96-baca-e7d0549cba5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186382465} :answer-field/id #uuid "d86e0dfb-0f1e-5397-8c0c-93b6e0bbf141" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382463}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "265058e2-39b1-59f9-b955-fd7951910713" :question/math-academy-id "q-81253" :question/problem "Evaluate the double integral ${∬}_{R}f(x,y)\\,\\text{d}A$, where\n\n$$\nf(x,y)={\\begin{aligned}\\operatorname{cos}⁡y,\\, & \\text{if}\\,-1<x<1,\\,0<y<\\pi , \\\\ x\\operatorname{sin}⁡y,\\, & \\text{if}\\,1<x<2,\\,0<y<\\pi ,\\end{aligned}\n$$\n\nand  $R$ is the domain of $f.$" :question/worked-solution "First, notice that we have $R={R}_{1}\\cup {R}_{2}$, where ${R}_{1}=(-1,1)\\times (0,\\pi )$ and ${R}_{2}=(1,2)\\times (0,\\pi ).$ So, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A= & ={∬}_{{R}_{1}}f(x,y)\\,\\text{d}A+{∬}_{{R}_{2}}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{{R}_{1}}\\operatorname{cos}⁡y\\,\\text{d}A+{∬}_{{R}_{2}}x\\operatorname{sin}⁡y\\,\\text{d}A \\\\  & =(1-(-1)){\\int }_{0}^{\\pi }\\operatorname{cos}⁡y\\,\\text{d}y+({\\int }_{1}^{2}x\\,\\text{d}x)({\\int }_{0}^{\\pi }\\operatorname{sin}⁡y\\,\\text{d}y) \\\\  & =2[\\operatorname{sin}⁡y]_{0}^{\\pi }+[\\frac{{x}^{2}}{2}]_{1}^{2}\\cdot [-\\operatorname{cos}⁡y]_{0}^{\\pi } \\\\  & =2(0)+(2-\\frac{1}{2})\\cdot (-(-1)+1) \\\\  & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186385755 :knowledge-point/_questions [{:db/id #edb/ref 17592186129187 :knowledge-point/id #uuid "d56cec4a-6121-5988-aaea-478fb6048a6d" :knowledge-point/title "Finding the Jacobian Determinant of a Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "564d868a-9fde-5394-a0a7-ee34c0c4d724" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2({u}^{2}-{v}^{2})" :db/id #edb/ref 17592186385757} {:answer/id #uuid "a85952d3-86d1-5ecc-ad78-7dcdecf1e567" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{u}^{2}-uv+{v}^{2}" :db/id #edb/ref 17592186385758} {:answer/id #uuid "ff785874-5a5d-5b25-b151-f49876d09835" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8uv" :db/id #edb/ref 17592186385759} {:answer/id #uuid "832628ab-7157-5368-b5e4-55126e572f4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4(u-v)" :db/id #edb/ref 17592186385760} {:answer/id #uuid "e3966b05-dcec-5f9b-b1c6-e7031cf3e401" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186385761}] :answer-field/correct {:answer/id #uuid "ff785874-5a5d-5b25-b151-f49876d09835" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8uv" :db/id #edb/ref 17592186385759} :answer-field/id #uuid "38071234-9bc0-5b00-b590-cccd8d7c31d8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385756}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "defe61a0-21a4-5ecd-abfb-89db5317a74b" :question/math-academy-id "q-81264" :question/problem "Find the Jacobian determinant of the transformation $T,$ defined as\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}{u}^{2}-{v}^{2} \\\\ {u}^{2}+{v}^{2}\\end{aligned}].\n$$" :question/worked-solution "Given a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]\\to [\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}|.\\end{aligned}\n$$\n\n \n\nHere, we have $x(u,v)={u}^{2}-{v}^{2}$ and $y(u,v)={u}^{2}+{v}^{2}.$  \n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =2u & \\,\\frac{∂x}{∂v} & =-2v \\\\ \\frac{∂y}{∂u} & =2u & \\,\\frac{∂y}{∂v} & =2v\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}2u & -2v \\\\ 2u & 2v\\end{aligned}| \\\\  & =2u\\cdot 2v-(-2v)\\cdot 2u \\\\  & =4uv+4uv \\\\  & =8uv.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186404156 :knowledge-point/_questions [{:db/id #edb/ref 17592186198360 :knowledge-point/id #uuid "bf5e8b36-38f0-5dd9-8b76-82392e593b73" :knowledge-point/title "Determining the Critical Points of a Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a499ca4-07df-5c8d-b83c-a9910cc2fe6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The critical points lie on the lines $u=v$ and $u=-v.$" :db/id #edb/ref 17592186404158} {:answer/id #uuid "2cf255f1-3d51-5826-98c1-93901517d605" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The critical points lie on the lines $u=0$ and $u=v.$" :db/id #edb/ref 17592186404159} {:answer/id #uuid "5da5054c-581f-5f31-9886-dad4f588043d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The critical points lie on the parabola $u={v}^{2}.$" :db/id #edb/ref 17592186404160} {:answer/id #uuid "6060e83f-92e8-5d62-986a-7a4aa49b2792" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The critical points lie on the lines $u=0$ and $u=-v.$" :db/id #edb/ref 17592186404161} {:answer/id #uuid "1669bc78-1efd-58f9-91e9-a08a66025cf0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The critical points lie on the line $u=0$ and on the parabola $u=4{v}^{2}.$" :db/id #edb/ref 17592186404162}] :answer-field/correct {:answer/id #uuid "1669bc78-1efd-58f9-91e9-a08a66025cf0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The critical points lie on the line $u=0$ and on the parabola $u=4{v}^{2}.$" :db/id #edb/ref 17592186404162} :answer-field/id #uuid "3dd706ed-a6fa-5777-8fba-b9aa9ded06db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404157}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "82fb995e-103e-58b4-a8e9-4c6b2963c1a3" :question/math-academy-id "q-81273" :question/problem "Find the locations of all of the critical points of $T,$ where $T$ is defined as\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}{u}^{2}\\,\\,v \\\\ u+{v}^{2}\\end{aligned}].\n$$" :question/worked-solution "Given a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]\\to [\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}|.\\end{aligned}\n$$\n\n \n\nTo find the locations of the critical points of $T,$ we need to solve \n\n$$\n\\frac{∂(x,y)}{∂(u,v)}=0.\n$$\n\nHere, we have $x(u,v)={u}^{2}\\,\\,v$ and $y(u,v)=u+{v}^{2}.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =2uv & \\,\\frac{∂x}{∂v} & ={u}^{2} \\\\ \\frac{∂y}{∂u} & =1 & \\,\\frac{∂y}{∂v} & =2v\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}2uv & {u}^{2} \\\\ 1 & 2v\\end{aligned}| \\\\  & =2uv\\cdot 2v-{u}^{2}\\cdot 1 \\\\  & =4u{v}^{2}-{u}^{2} \\\\  & =u(4{v}^{2}-u).\\end{aligned}\n$$\n\nThe function has critical points when $\\frac{∂(x,y)}{∂(u,v)}=0.$ So, we obtain \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =0 \\\\ u(4{v}^{2}-u) & =0.\\end{aligned}\n$$\n\n \n\nThe equation $u(4{v}^{2}-u)=0$ defines a pair of intersecting curves in the $uv$-plane: the line $u=0$ and the parabola $u=4{v}^{2}.$"}] [{:db/id #edb/ref 17592186382469 :knowledge-point/_questions [{:db/id #edb/ref 17592186133839 :knowledge-point/id #uuid "2ccbe70d-24f4-5e9c-8536-9ccab99f571b" :knowledge-point/title "Representing a Double Integral as a Repeated Integral When the Limits are Not Given"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30f8c876-47b6-583b-bc51-873ad08aaa4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{2-{y}^{2}}^{1}[{\\int }_{0}^{y}\\sqrt{xy}\\,dx]dy" :db/id #edb/ref 17592186382471} {:answer/id #uuid "43aa91a3-8faf-5141-8e2f-c2789e7ee8e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2-{y}^{2}}[{\\int }_{y}^{1}\\sqrt{xy}\\,dx]dy" :db/id #edb/ref 17592186382472} {:answer/id #uuid "0a69f1d9-8cf2-5d1a-9734-5045baecb942" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{y}^{2-{y}^{2}}[{\\int }_{0}^{1}\\sqrt{xy}\\,dx]dy" :db/id #edb/ref 17592186382473} {:answer/id #uuid "eeb9803f-07df-5b66-a8ba-395885864219" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}[{\\int }_{y}^{2-{y}^{2}}\\sqrt{xy}\\,dx]dy" :db/id #edb/ref 17592186382474} {:answer/id #uuid "71a497ac-5a14-50ea-98b9-0192365daa3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{y}[{\\int }_{1}^{2-{y}^{2}}\\sqrt{xy}\\,dx]dy" :db/id #edb/ref 17592186382475}] :answer-field/correct {:answer/id #uuid "eeb9803f-07df-5b66-a8ba-395885864219" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}[{\\int }_{y}^{2-{y}^{2}}\\sqrt{xy}\\,dx]dy" :db/id #edb/ref 17592186382474} :answer-field/id #uuid "5ea6301e-440a-536f-94cb-ed133c18b3f5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382470}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d0f1b3ae-a98d-5236-bbd8-feaf8fc303a3" :question/math-academy-id "q-81294" :question/problem "![](images/79/79bbf4ae3d1a28eee2cbbbadc72dde1098bbd3dce42390feaeab591e162dfee6.png)\n\nIf $D$ is the finite region enclosed by the lines $x=y,\\,$ $x=2-{y}^{2},$ and $y=0,$ as shown above, then ${∬}_{D}\\sqrt{xy}\\,dA=$" :question/worked-solution "First, let's represent $D$ as a type II region. \n\n- To determine the $y$-limits, we need to find the $y$-coordinates of the points at which the curves intersect. So, we set the following equation and solve it for $y:$\n\n$$\n\\begin{aligned}y & =2-{y}^{2} \\\\ {y}^{2}+y-2 & =0 \\\\ {y}^{2}-y+2y-2 & =0 \\\\ y(y-1)+2(y-1) & =0 \\\\ (y+2)(y-1) & =0\\end{aligned}\n$$\n\nSo, $y$-limits are \n$0\\le y\\le 1.$\n\n- To determine the left and right functions, we draw a horizontal arrow from left to right through the region, as usual.\n\n![](images/4e/4eae7bc6756ef5df750bc98431f9e20c9c23869d5ede7f623e79bf7cbb1785c1.png)\n\nAs a result, we get\n\n$$\nD={(x,y)\\,:\\,0\\le y\\le 1,\\,y\\le x\\le 2-{y}^{2}}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}\\sqrt{xy}\\,dA & ={\\int }_{0}^{1}{\\int }_{y}^{2-{y}^{2}}\\sqrt{xy}\\,dx\\,dy \\\\  & ={\\int }_{0}^{1}[{\\int }_{y}^{2-{y}^{2}}\\sqrt{xy}\\,dx]dy\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186351284 :knowledge-point/_questions [{:db/id #edb/ref 17592186129302 :knowledge-point/id #uuid "503a2d0a-ba6c-5529-9f26-b83c769a26a2" :knowledge-point/title "Finding the Domain of a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07cf5972-f40e-5217-8db4-af4d714d0f29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,5)\\cup (5,\\infty )" :db/id #edb/ref 17592186348511} {:answer/id #uuid "4ff5e665-aaa0-5a32-9ee9-f1bfeace33e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-3)\\cup (-3,\\infty )" :db/id #edb/ref 17592186349171} {:answer/id #uuid "86623a7d-5813-5d35-94af-16d6fb07a0e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,\\frac{1}{5})\\cup (\\frac{1}{5},\\infty )" :db/id #edb/ref 17592186349673} {:answer/id #uuid "c3ecf398-d445-5f07-9e39-0e0872bbfc4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186350178} {:answer/id #uuid "e061e2c5-0620-5228-ad52-cedd9b116361" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-\\frac{1}{3})\\cup (-\\frac{1}{3},\\infty )" :db/id #edb/ref 17592186350417}] :answer-field/correct {:answer/id #uuid "86623a7d-5813-5d35-94af-16d6fb07a0e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,\\frac{1}{5})\\cup (\\frac{1}{5},\\infty )" :db/id #edb/ref 17592186349673} :answer-field/id #uuid "0a944731-6928-5c95-9932-5dd54d8c5f7b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350725}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f524ac1c-6637-5a2f-a68c-7f9c181d3393" :question/math-academy-id "q-81297" :question/problem "What is the domain of the function $f(x)=\\frac{3x+1}{5x-1}?$" :question/worked-solution "A reciprocal function is defined for all values of $x$ except for those that make the denominator zero. So, to find the domain, we must exclude all values of $x$ that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}5x-1 & =0 \\\\ 5x & =1 \\\\ x & =\\frac{1}{5}.\\end{aligned}\n$$\n\nTherefore, the domain is $x\\in (-\\infty ,\\frac{1}{5})\\cup (\\frac{1}{5},\\infty ).$"}] [{:db/id #edb/ref 17592186351285 :knowledge-point/_questions [{:db/id #edb/ref 17592186129303 :knowledge-point/id #uuid "bd0aa5fc-79de-525e-a688-a8a2d2fcf858" :knowledge-point/title "Solving for an Unknown Constant in a Transformed Reciprocal Function Given the Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f8d2777-c68c-5bac-b02b-e76ea7832227" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186348585} {:answer/id #uuid "4440720a-4b25-56ac-acfb-e35454aaf42f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186349068} {:answer/id #uuid "aa03c041-3060-57a7-9832-43fc7a4091d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186349958} {:answer/id #uuid "b607c09a-ead1-5f9f-8366-b91cefea5b3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186350056} {:answer/id #uuid "fe48bdf6-69b4-58e6-ab4b-56b33ca29990" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186350684}] :answer-field/correct {:answer/id #uuid "aa03c041-3060-57a7-9832-43fc7a4091d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186349958} :answer-field/id #uuid "96ab50f6-ff51-5cc2-a2e4-1ac35c1df983" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350965}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "69d362d8-5140-5de9-97ea-ddf053c6a1b5" :question/math-academy-id "q-81306" :question/problem "The domain of the function $f(x)=\\frac{3x-7}{kx-4}$ is $(-\\infty ,\\frac{4}{5})\\cup (\\frac{4}{5},\\infty ).$ What is the value of $k?$" :question/worked-solution "A reciprocal function is defined for all values of $x$ except for those that make the denominator zero. So, to find the domain, we must exclude all values that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}kx-4 & =0 \\\\ kx & =4 \\\\ x & =\\frac{4}{k}.\\end{aligned}\n$$\n\nSo, the point that must be excluded from the domain is $x=\\frac{4}{k}.$ \n\nOn the other hand, we can see that $x=\\frac{4}{5}$ is excluded from the domain. Equating this to $\\frac{4}{k},$ we get\n\n$$\n\\begin{aligned}\\frac{4}{k} & =\\frac{4}{5} \\\\ \\frac{1}{k} & =\\frac{1}{5} \\\\ k & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186404170 :knowledge-point/_questions [{:db/id #edb/ref 17592186105765 :knowledge-point/id #uuid "be42e4b3-4b15-589c-a7e1-23cc07083aff" :knowledge-point/title "Identifying a Shear or Stretch Transformation Given the Images of the Standard Basis Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cbca2a4-5302-5621-923e-847f18587e7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A vertical shear with a shear factor of $\\frac{1}{2}$" :db/id #edb/ref 17592186404172} {:answer/id #uuid "686c83f8-b2ff-5446-a69b-a6dca4ee631b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A horizontal shear with a shear factor of $\\frac{1}{2}$" :db/id #edb/ref 17592186404173} {:answer/id #uuid "f3e87b1e-635e-59bb-a8b0-e23b7a0b0aa4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A stretch of scale factor $2$ in the $x$-direction" :db/id #edb/ref 17592186404174} {:answer/id #uuid "1c87caa4-7f94-5398-b1e3-967d57492e14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A stretch of scale factor $\\frac{1}{2}$ in the $x$-direction" :db/id #edb/ref 17592186404175} {:answer/id #uuid "2280b79f-4cae-53e8-ad6b-44654f7eae72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A stretch of scale factor $\\frac{1}{2}$ in the $y$-direction" :db/id #edb/ref 17592186404176}] :answer-field/correct {:answer/id #uuid "1c87caa4-7f94-5398-b1e3-967d57492e14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A stretch of scale factor $\\frac{1}{2}$ in the $x$-direction" :db/id #edb/ref 17592186404175} :answer-field/id #uuid "a2dd7953-8b90-52cd-be66-71f8f16406ff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404171}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5883242f-b44f-5ff7-9fa7-30bcd180241a" :question/math-academy-id "q-81324" :question/problem "Consider the standard basis $\\{i,j\\}$ of ${R}^{2}.$ If $T$ is a linear transformation such that $T(i)=\\frac{1}{2}i$ and $T(j)=j,$ then what is the geometric interpretation of the transformation $T?$" :question/worked-solution "First, let's consider the unit square spanned by the vectors $i$ and  $j.$\n\n![](images/34/34c82826da26290fc890671734c354fbfd9c253f1cfaca38de1ea615434e6766.png)\n\nNow, using the fact that $T(i)=\\frac{1}{2}i$ and $T(j)=j,$ we can draw the image of the square under the transformation $T:$\n\n![](images/02/02470083dea4808af1854e9ed88ab496828a429c593af780209d8a6d4b15a6b1.png)\n\nTherefore, the linear transformation $T$ represents a stretch with a scale factor $\\frac{1}{2}$ in the $x$-direction."}] [{:db/id #edb/ref 17592186382483 :knowledge-point/_questions [{:db/id #edb/ref 17592186133835 :knowledge-point/id #uuid "a28c4320-e2dd-5195-81ac-b910c2328691" :knowledge-point/title "Evaluating a Repeated Integral Defined Over a Type I Region"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a77e132b-a21c-5306-8cc2-7d72cc0ddb23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186382485} {:answer/id #uuid "546cf7f2-fd7a-54c1-9ffb-8e980b3d6416" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186382486} {:answer/id #uuid "e176f616-3bdf-56d9-9617-1d44a38c0810" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186382487} {:answer/id #uuid "36404f64-c367-57f8-a0eb-0e2ae00c4c4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186382488} {:answer/id #uuid "56d1c106-0b9a-58f0-95c1-ecdf33e4b50c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186382489}] :answer-field/correct {:answer/id #uuid "a77e132b-a21c-5306-8cc2-7d72cc0ddb23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186382485} :answer-field/id #uuid "4f16d658-a7eb-5019-b040-5f1ae39482a6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382484}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0d02ca31-dbbf-5ccb-a3a9-765cf6ace512" :question/math-academy-id "q-81355" :question/problem "Calculate ${\\int }_{0}^{1}{\\int }_{{x}^{2}}^{2-{x}^{2}}x\\,dy\\,dx.$" :question/worked-solution "The integral is defined over a type I region.\n\nFirst, we evaluate the inner integral by integrating with respect to $y$, treating $x$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{{x}^{2}}^{2-{x}^{2}}x\\,dy\\,dx & ={\\int }_{0}^{1}x[{\\int }_{{x}^{2}}^{2-{x}^{2}}dy]\\,dx \\\\  & ={\\int }_{0}^{1}x[y]_{{x}^{2}}^{2-{x}^{2}}\\,dx \\\\  & ={\\int }_{0}^{1}x(2-{x}^{2}-{x}^{2})\\,dx \\\\  & =2{\\int }_{0}^{1}(x-{x}^{3})\\,dx\\end{aligned}\n$$\n\nThen, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}2{\\int }_{0}^{1}(x-{x}^{3})\\,dx & =2{[\\frac{{x}^{2}}{2}-\\frac{{x}^{4}}{4}]}_{0}^{1} \\\\  & =2(\\frac{1}{2}-\\frac{1}{4}-0) \\\\  & =\\frac{1}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186394161 :knowledge-point/_questions [{:db/id #edb/ref 17592186105767 :knowledge-point/id #uuid "69bac3fa-d409-5c16-87b2-383423e8d754" :knowledge-point/title "Finding the Image of a Square Under a Shear or Stretch Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35ad3ac6-648a-5594-bcb1-e1c6cfa23bbd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1d/1d25632f24abfc3176f515ba41a763e166d8c9c3101d07732a1efb183a2e9d75.png" :db/id #edb/ref 17592186394163} {:answer/id #uuid "222c72ce-1fbf-561c-88e0-10fe8e99adb1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a6/a64061e8714d38748ef4907cbdedf873355c64814ef3966d872494e84bcacfbd.png" :db/id #edb/ref 17592186394164} {:answer/id #uuid "25424b64-9590-5703-89ba-952c8395fabf" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/52/52bb468dfeaae8b4c47cb08a7bb08e671e898467e4130e2e243936b599f51704.png" :db/id #edb/ref 17592186394165} {:answer/id #uuid "3cef1ad9-c2db-5b41-9454-daa475d866fa" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/6a/6a5da4ecc4dc4cb550649d229f0c7c9d64bd713f901084a937785ea93df86eb1.png" :db/id #edb/ref 17592186394166} {:answer/id #uuid "5c5661e2-607d-5c8e-9f4c-71b76bbda105" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9d/9d140b11016d68a8372623e997abdc588633ee02b56a8edee61c8cb269fd4c20.png" :db/id #edb/ref 17592186394167}] :answer-field/correct {:answer/id #uuid "3cef1ad9-c2db-5b41-9454-daa475d866fa" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/6a/6a5da4ecc4dc4cb550649d229f0c7c9d64bd713f901084a937785ea93df86eb1.png" :db/id #edb/ref 17592186394166} :answer-field/id #uuid "ebdb8c5b-096b-57f2-b6b3-1e02772f7b4a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394162}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e7cd28c9-29e0-5184-9921-9c2ab31af8ab" :question/math-academy-id "q-81413" :question/problem "![](images/61/611f958a7bd7475e37f743ef86affde7754195fe2c9ad414e628c17a09d47e38.png)\n\nLet $T=[\\begin{aligned}\\frac{3}{2} & 0 \\\\ 0 & 1\\end{aligned}]$ be the standard matrix of the linear transformation $T.$ What is the image of the square $R$ (shown above) under the action of $T?$" :question/worked-solution "Looking at the matrix $T$, we can see that $T$ represents a stretch in the $x$-direction of scale factor $\\frac{3}{2}.$ Therefore, the image of the square $R$ under $T$ is\n\n![](images/72/72c88d1df90c3462d7f1f186c06b9a7acf30c071f5ba8bbf722ee125fee0e616.png)\n\n**Alternative method:**\n\nWe can check that the vertices of $R$ are mapped to the vertices of the rectangle shown above as follows:\n\n$$\n\\begin{aligned}T([\\begin{aligned}0 \\\\ 0\\end{aligned}]) & =[\\begin{aligned}\\frac{3}{2} & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 0\\end{aligned}]=[\\begin{aligned}0 \\\\ 0\\end{aligned}] \\\\ T([\\begin{aligned}2 \\\\ 0\\end{aligned}]) & =[\\begin{aligned}\\frac{3}{2} & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}2 \\\\ 0\\end{aligned}]=[\\begin{aligned}3 \\\\ 0\\end{aligned}] \\\\ T([\\begin{aligned}2 \\\\ 2\\end{aligned}]) & =[\\begin{aligned}\\frac{3}{2} & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}2 \\\\ 2\\end{aligned}]=[\\begin{aligned}3 \\\\ 2\\end{aligned}] \\\\ T([\\begin{aligned}0 \\\\ 2\\end{aligned}]) & =[\\begin{aligned}\\frac{3}{2} & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 2\\end{aligned}]=[\\begin{aligned}0 \\\\ 2\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186129876 :knowledge-point/_questions [{:db/id #edb/ref 17592186129304 :knowledge-point/id #uuid "66d82fa3-d576-5c42-9dca-4e1b76473424" :knowledge-point/title "Finding the Range of a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e75273e-f9fe-5904-9b97-df326138bc4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186348572} {:answer/id #uuid "56bde1c1-ec8e-5414-abd3-cf3a35ed829d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,-1)\\cup (1,\\infty )" :db/id #edb/ref 17592186349240} {:answer/id #uuid "70ec2a49-c0cb-50b3-96d0-78c9ed276005" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,1)\\cup (1,\\infty )" :db/id #edb/ref 17592186349486} {:answer/id #uuid "710ec1a0-ca77-5baf-9aea-64447273a88e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,-6)\\cup (1,\\infty )" :db/id #edb/ref 17592186349487} {:answer/id #uuid "76603cce-9fe2-582e-98c8-b6b5dfe79841" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,6)\\cup (6,\\infty )" :db/id #edb/ref 17592186349534}] :answer-field/correct {:answer/id #uuid "70ec2a49-c0cb-50b3-96d0-78c9ed276005" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,1)\\cup (1,\\infty )" :db/id #edb/ref 17592186349486} :answer-field/id #uuid "2d01f1a9-302b-5e9b-a9b7-f275dfb86ddd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350788}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d6996c90-1b1f-5226-b63d-1aa92068c6b3" :question/math-academy-id "q-81416" :question/problem "What is the range of $f(x)=\\frac{1}{x-6}+1?$" :question/worked-solution "A transformed reciprocal function of the form\n\n$$\nf(x)=\\frac{a}{bx+c}+d\n$$\n\nhas the horizontal asymptote $y=d,$ and therefore, its range is\n\n$$\nf(x)\\in (-\\infty ,d)\\cup (d,\\infty ).\n$$\n\nIn our case, $d=1.$ Therefore, the horizontal asymptote is $y=1,$ and the range of the function is\n\n$$\nf(x)\\in (-\\infty ,1)\\cup (1,\\infty ).\n$$\n\nThe graph $y=f(x)$ is shown below.\n\n![](images/f6/f6b1316dd9c7f2a40c23de08dde63cbc6402593c6209d99384279a7c1ae29da6.png)"}] [{:db/id #edb/ref 17592186351313 :knowledge-point/_questions [{:db/id #edb/ref 17592186175952 :knowledge-point/id #uuid "be9ac99c-424e-5e90-b26f-c26e4da704d7" :knowledge-point/title "Finding the Final Position of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23dce36f-61ba-5015-8efe-10f5e58c37e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186348754} {:answer/id #uuid "33cc441d-205f-5f43-93b6-2ecef88de694" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186348911} {:answer/id #uuid "36156b9a-2d25-558c-9ab8-4629169c5f62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186348933} {:answer/id #uuid "e060bf48-f76f-5437-8da3-75acd9dc4f37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186350416} {:answer/id #uuid "fecdefff-5446-5487-8fea-206fa2f01600" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186350689}] :answer-field/correct {:answer/id #uuid "e060bf48-f76f-5437-8da3-75acd9dc4f37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186350416} :answer-field/id #uuid "93100b95-ae42-53dc-b4eb-19f8569529d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350958}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "62741b76-bd79-5cef-9d76-2003787fe433" :question/math-academy-id "q-81506" :question/problem "A particle $P$ moves along the $x$-axis and its velocity at time $t\\ge 0$ is given by $v(t)=\\operatorname{cos}⁡(t-\\frac{\\pi }{6}).$ At time $t=0$ the particle is located at the position $x=3.$ What is the position of the particle at time $t=\\frac{\\pi }{6}?$" :question/worked-solution "The position of the particle at $t=\\frac{\\pi }{6}$ is equal to its position at $t=0$ plus the total displacement over $t\\in [0,\\frac{\\pi }{6}].$ Therefore, we can calculate it as follows:\n\n$$\nx(\\frac{\\pi }{6})=x(0)+{\\int }_{0}^{\\pi /6}v(t)\\,\\text{d}t\n$$\n\nCarrying out the computations, we get\n\n$$\n\\begin{aligned}x(\\frac{\\pi }{6}) & =\\frac{7}{2}+{\\int }_{0}^{\\pi /6}\\operatorname{cos}⁡(t-\\frac{\\pi }{6})\\,\\text{d}t \\\\  & =3+{[\\operatorname{sin}⁡(t-\\frac{\\pi }{6})]}_{0}^{\\pi /6} \\\\  & =3+([\\operatorname{sin}⁡(\\frac{\\pi }{6}-\\frac{\\pi }{6})]-[\\operatorname{sin}⁡(0-\\frac{\\pi }{6})]) \\\\  & =3+(\\operatorname{sin}⁡(0)-\\operatorname{sin}⁡(-\\frac{\\pi }{6})) \\\\  & =3+(0-(-\\frac{1}{2})) \\\\  & =3+\\frac{1}{2} \\\\  & =\\frac{7}{2}\\end{aligned}\n$$\n\nSo the position of the particle at $t=\\frac{\\pi }{6}$ is $x=\\frac{7}{2}.$"}] [{:db/id #edb/ref 17592186380152 :knowledge-point/_questions [{:db/id #edb/ref 17592186175952 :knowledge-point/id #uuid "be9ac99c-424e-5e90-b26f-c26e4da704d7" :knowledge-point/title "Finding the Final Position of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c0f7071e-e880-50a1-b41b-47c04933ff07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e+2" :db/id #edb/ref 17592186380154} {:answer/id #uuid "bc42fe0b-d4bc-5317-873c-bb9c54c446c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e-1" :db/id #edb/ref 17592186380155} {:answer/id #uuid "48372c19-809b-5e15-b482-d692d029f471" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e-1" :db/id #edb/ref 17592186380156} {:answer/id #uuid "ca907147-09ae-592f-ba53-ca6eba5e1387" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3e-2" :db/id #edb/ref 17592186380157} {:answer/id #uuid "b32cd262-e877-50f6-bdd1-cef434bb1fb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e+2" :db/id #edb/ref 17592186380158}] :answer-field/correct {:answer/id #uuid "bc42fe0b-d4bc-5317-873c-bb9c54c446c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e-1" :db/id #edb/ref 17592186380155} :answer-field/id #uuid "0ba49fa9-38f4-52ac-9992-6b404563f314" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186380153}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "dfa9f5d6-79ff-5f17-8761-60660e8e1882" :question/math-academy-id "q-81507" :question/problem "A particle $P$ moves along the $x$-axis and its velocity at time $t>0$ is given by $v(t)={e}^{2-t}.$ At time $t=1$ the particle is located at the position $x=e.$ What is the position of the particle at time $t=2?$" :question/worked-solution "The position of the particle at $t=2$ is equal to its position at $t=1$ plus the total displacement over $t\\in [1,2].$ Therefore, we can calculate it as follows:\n\n$$\nx(2)=x(1)+{\\int }_{1}^{2}v(t)\\,\\text{d}t\n$$\n\nCarrying out the computations, we get\n\n$$\n\\begin{aligned}x(2) & =e+{\\int }_{1}^{2}{e}^{2-t}\\,\\text{d}t \\\\  & =e+{[-{e}^{2-t}]}_{1}^{2} \\\\  & =e+([-{e}^{2-2}]-[-{e}^{2-1}]) \\\\  & =e+([-{e}^{0}]-[-{e}^{1}]) \\\\  & =e+(-1+e) \\\\  & =2e-1\\end{aligned}\n$$\n\nSo the position of the particle at $t=2$ is $x=2e-1.$"}] [{:db/id #edb/ref 17592186351314 :knowledge-point/_questions [{:db/id #edb/ref 17592186175953 :knowledge-point/id #uuid "089120d4-b37b-5936-8ea4-b68848290606" :knowledge-point/title "Finding the Final Position of a Particle Given a Velocity-Time Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23e86c23-69e4-5054-bfd9-ff741ad78921" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186348756} {:answer/id #uuid "3f9fe541-7946-55bd-b996-7238be85c720" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186349028} {:answer/id #uuid "569f8e3c-04dc-57a5-b360-29100d1a4347" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186349239} {:answer/id #uuid "6f0fcf52-3f7b-5bcf-8cef-eaf7735235e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186349464} {:answer/id #uuid "f6182643-d871-51db-bd91-465f1d38b375" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186350601}] :answer-field/correct {:answer/id #uuid "569f8e3c-04dc-57a5-b360-29100d1a4347" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186349239} :answer-field/id #uuid "94863109-0680-5a9f-9970-b99f84cfb958" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350960}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e37efc81-0ba0-5f97-8805-6da54651e48c" :question/math-academy-id "q-81509" :question/problem "![](images/b8/b8e6f6b7ab2081595723002737bcb73bbced52bfea0f8cfeb91b1201adab0160.png)\n\nThe graph above shows the velocity of an object moving in a straight line along the $x$-axis. At time $t=0$ the particle is located at the position $x=-2.$ What is the position of the particle at time $t=6?$" :question/worked-solution "The position of the particle at $t=6$ is equal to its position at $t=0$ plus the total displacement over $t\\in [0,6].$ Therefore, we can calculate it as follows:\n\n$$\nx(6)=x(0)+{\\int }_{0}^{6}v(t)\\,\\text{d}t\n$$\n\nWe are told that $x(0)=-2$, and we can compute the integral ${\\int }_{0}^{6}v(t)\\,\\text{d}t$ by finding the signed area under the graph from $t=0$ to $t=6.$ Computing the signed area, we get\n\n$$\n{\\int }_{0}^{6}v(t)\\,\\text{d}t=9.\n$$\n\nTherefore,\n\n$$\nx(6)=-2+9=7\n$$\n\nSo the position of the particle at $t=6$ is $x=7.$"}] [{:db/id #edb/ref 17592186176577 :knowledge-point/_questions [{:db/id #edb/ref 17592186175953 :knowledge-point/id #uuid "089120d4-b37b-5936-8ea4-b68848290606" :knowledge-point/title "Finding the Final Position of a Particle Given a Velocity-Time Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8656bc5c-89b7-5faa-8e9a-d4cf5489a133" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186175601} {:answer/id #uuid "ecfe37b6-348a-58dc-bd12-be8195dd4179" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186175602} {:answer/id #uuid "ee1a6f05-7b76-5b87-b2a4-545260f49a5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186175603} {:answer/id #uuid "fe7d6fb4-c3a2-5a7d-8a35-c55219fd1ffe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186175604} {:answer/id #uuid "4cbe59bf-9aa6-53f5-b2af-bf84d5cc8d46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186175605}] :answer-field/id #uuid "05c91bec-14bb-507d-8d12-a179ce71164a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186175600} {:answer-field/choices [{:answer/id #uuid "0f248ece-f5c5-5ed8-ab7d-967e7ea36c47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186394195} {:answer/id #uuid "8f87cb36-4235-5d45-bd33-008c6a1dad19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186394196} {:answer/id #uuid "55b08794-9f6c-5b49-b3a5-084214adcce5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186394197} {:answer/id #uuid "4b9d1066-b4d2-54ba-9fde-63bd43ffbf37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186394198} {:answer/id #uuid "9913365f-f26a-52ae-8034-5c419d5e03a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186394199}] :answer-field/correct {:answer/id #uuid "55b08794-9f6c-5b49-b3a5-084214adcce5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186394197} :answer-field/id #uuid "6c20df92-a1f9-5d53-b4a0-8adba3ef4f48" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394194}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c28570f9-857d-5ff0-823f-c8f4501357d9" :question/math-academy-id "q-81515" :question/problem "![](images/6c/6c0f74fa4820cd8e6945666ab90e0eafac4cc1ada7578fb5a053f197adf08084.png)\n\nThe graph above shows the velocity of an object moving in a straight line along the $x$-axis. At time $t=1$ the particle is located at the position $x=2.$ What is the position of the particle at time $t=7?$" :question/worked-solution "The position of the particle at $t=7$ is equal to its position at $t=1$ plus the total displacement over $t\\in [1,7].$ Therefore, we can calculate it as follows:\n\n$$\nx(7)=x(1)+{\\int }_{1}^{7}v(t)\\,\\text{d}t\n$$\n\nWe are told that $x(1)=2$, and we can compute the integral ${\\int }_{1}^{7}v(t)\\,\\text{d}t$ by finding the signed area under the graph from $t=1$ to $t=7.$ Computing the signed area, we get\n\n$$\n{\\int }_{1}^{7}v(t)\\,\\text{d}t=0.\n$$\n\nTherefore,\n\n$$\nx(7)=2+0=2\n$$\n\nSo the position of the particle at $t=7$ is $x=2.$"}] [{:db/id #edb/ref 17592186351320 :knowledge-point/_questions [{:db/id #edb/ref 17592186203962 :knowledge-point/id #uuid "37ff20d1-fa3d-50aa-90d1-7bcb848ee460" :knowledge-point/title "Maxima of Transformed Sine or Cosine Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "808a85c2-ca4a-542f-8886-908783750d8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{16}+n\\cdot \\frac{\\pi }{4}" :db/id #edb/ref 17592186349626} {:answer/id #uuid "8cd3458d-3fcd-5615-89ef-119fa3a75163" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{16}+n\\cdot \\frac{\\pi }{2}" :db/id #edb/ref 17592186349718} {:answer/id #uuid "99b11afc-eea4-51cc-90b6-2bcc44f1ccd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{2}+n\\pi " :db/id #edb/ref 17592186349822} {:answer/id #uuid "ec838bdb-4a1f-5b1a-b168-73687add9f3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{8}+n\\pi " :db/id #edb/ref 17592186350513} {:answer/id #uuid "f0d92b5e-622a-5e98-8d37-c85026582415" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{8}+n\\cdot \\frac{\\pi }{16}" :db/id #edb/ref 17592186350555}] :answer-field/correct {:answer/id #uuid "8cd3458d-3fcd-5615-89ef-119fa3a75163" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{16}+n\\cdot \\frac{\\pi }{2}" :db/id #edb/ref 17592186349718} :answer-field/id #uuid "e6fff443-d103-5115-9f6d-56a670c1f10e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351113}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8dc88ce5-1862-53d4-934e-e04fef66ce16" :question/math-academy-id "q-81532" :question/problem "Consider the function $f(x)=\\operatorname{sin}⁡(4x+\\frac{\\pi }{4}).$ Which expression gives all of the values of $x$ at which $f(x)$ attains its maximum value? Assume that $n$ is an integer." :question/worked-solution "First, let's start by defining a new variable $X$ as\n\n$$\nX=4x+\\frac{\\pi }{4}.\n$$\n\nSo, we need to calculate $X$-values at the maxima of\n\n$$\ny=\\operatorname{sin}⁡X.\n$$\n\n \n\nThe $X$-values at the maxima are given by the following expression:\n\n$$\nX=\\frac{\\pi }{2}+2n\\pi \n$$\n\nwhere $n$ is an integer.\n\nTo find the $x$-values at the maxima of our original function, we rewrite $X$ in terms of the original variable $x$ and solve the resulting equation for $x:$\n\n$$\n\\begin{aligned}X & =\\frac{\\pi }{2}+2n\\pi  \\\\ 4x+\\frac{\\pi }{4} & =\\frac{\\pi }{2}+2n\\pi  \\\\ 4x & =\\frac{\\pi }{4}+2n\\pi  \\\\ x & =\\frac{\\pi }{16}+n\\cdot \\frac{\\pi }{2}\\end{aligned}\n$$\n\nWe conclude that the values of $x$ that maximize $f(x)$ are given by $x=\\frac{\\pi }{16}+n\\cdot \\frac{\\pi }{2},$ where $n$ is an integer."}] [{:db/id #edb/ref 17592186351322 :knowledge-point/_questions [{:db/id #edb/ref 17592186203963 :knowledge-point/id #uuid "75e981a4-ba75-5db2-81ab-b321953cc225" :knowledge-point/title "Minima of Transformed Sine or Cosine Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a08b123-1007-51d0-9626-6957cea1cbdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{4\\pi }{3}+3\\pi n" :db/id #edb/ref 17592186348819} {:answer/id #uuid "57b185da-3c33-5e53-b896-4c58bbe65ab3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{15\\pi }{4}+6\\pi n" :db/id #edb/ref 17592186349253} {:answer/id #uuid "65cf0fb8-b80b-5dd5-873d-133d51e5ed5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pi +2\\pi n" :db/id #edb/ref 17592186349378} {:answer/id #uuid "d17b82e0-699f-5810-bbfd-d8426a2e29ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{4}+6\\pi n" :db/id #edb/ref 17592186350286} {:answer/id #uuid "e029609d-c698-570a-9c3e-6c5b9a4f3d4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pi +3\\pi n" :db/id #edb/ref 17592186350415}] :answer-field/correct {:answer/id #uuid "57b185da-3c33-5e53-b896-4c58bbe65ab3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{15\\pi }{4}+6\\pi n" :db/id #edb/ref 17592186349253} :answer-field/id #uuid "8380bcb3-1b34-51e5-86b8-2bf85dedf899" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350935}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c0891f6b-b8f3-59bf-bdab-23a45deeee45" :question/math-academy-id "q-81536" :question/problem "Consider the function $f(x)=\\operatorname{cos}⁡(\\frac{x}{3}-\\frac{\\pi }{4}).$ Which expression gives all of the values of $x$ at which $f(x)$ attains its minimum value? Assume that $n$ is an integer." :question/worked-solution "First, let's start by defining a new variable $X$ as\n\n$$\nX=\\frac{x}{3}-\\frac{\\pi }{4}.\n$$\n\nSo, we need to calculate $X$-values at the minima of\n\n$$\nf(x)=\\operatorname{cos}⁡X.\n$$\n\nThe $X$-values at the minima are given by the following expression:\n\n$$\nX=(2n+1)\\pi \n$$\n\nwhere $n$ is an integer.\n\nTo find the $x$-values at the minima of our original function, we rewrite $X$ in terms of the original variable $x$ and solve the resulting equation for $x:$\n\n$$\n\\begin{aligned}X & =(2n+1)\\pi  \\\\ \\frac{x}{3}-\\frac{\\pi }{4} & =\\pi +2\\pi n \\\\ \\frac{x}{3} & =\\frac{5\\pi }{4}+2\\pi n \\\\ x & =\\frac{15\\pi }{4}+6\\pi n\\end{aligned}\n$$\n\nWe conclude that the values of $x$ that minimize $f(x)$ are given by $x=\\frac{15\\pi }{4}+6\\pi n,$ where $n$ is an integer."}] [{:db/id #edb/ref 17592186351324 :knowledge-point/_questions [{:db/id #edb/ref 17592186129100 :knowledge-point/id #uuid "fabd8865-cc14-508a-aa81-4ba147f7f8d4" :knowledge-point/title "Finding a General Expression for the Zeros of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03ee5a37-5407-5f2c-b35d-818c7b51de99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{n\\pi }{4}" :db/id #edb/ref 17592186348485} {:answer/id #uuid "a96ee961-091c-5bc7-94e9-4fc2414a6608" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{n\\pi }{2}" :db/id #edb/ref 17592186349955} {:answer/id #uuid "c965a8db-cf91-5534-9a2e-b2b2d81d2a6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi n" :db/id #edb/ref 17592186350220} {:answer/id #uuid "f934958a-918e-544c-9c79-ee9005be989f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{n\\pi }{8}" :db/id #edb/ref 17592186350636} {:answer/id #uuid "ff59dfe4-69fc-5f06-a333-183188f57b0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\pi n" :db/id #edb/ref 17592186350697}] :answer-field/correct {:answer/id #uuid "a96ee961-091c-5bc7-94e9-4fc2414a6608" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{n\\pi }{2}" :db/id #edb/ref 17592186349955} :answer-field/id #uuid "e9569062-abe3-5fbf-aea5-b41339436a91" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351120}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "483db40e-99c9-5ee4-bf30-82e490a0ea46" :question/math-academy-id "q-81542" :question/problem "Which of the following expressions gives all of the zeros of the function $f(x)=\\operatorname{tan}⁡(2x)?$ Assume that $n$ is an integer." :question/worked-solution "The zeros of $y=\\operatorname{tan}⁡x$ are given by\n\n$$\nx=n\\pi ,\n$$\n\nwhere $n$ is an integer.\n\nTo find the zeros of $f(x)=\\operatorname{tan}⁡(2x),$ we replace the $x$ on the left-hand side of the above with $(2x).$ This gives\n\n$$\n2x=n\\pi .\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}2x & =n\\pi  \\\\ x & =\\frac{n\\pi }{2}.\\end{aligned}\n$$\n\nTherefore, we conclude that the zeros are $x=\\frac{n\\pi }{2},$ where $n$ is an integer."}] [{:db/id #edb/ref 17592186351326 :knowledge-point/_questions [{:db/id #edb/ref 17592186129100 :knowledge-point/id #uuid "fabd8865-cc14-508a-aa81-4ba147f7f8d4" :knowledge-point/title "Finding a General Expression for the Zeros of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bdbc89b-3531-5aca-8ba9-f97488020ae6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}+6n\\pi " :db/id #edb/ref 17592186348987} {:answer/id #uuid "4113848c-c05d-566b-b1dc-5db84a4d0393" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}+3n\\pi " :db/id #edb/ref 17592186349038} {:answer/id #uuid "5d7a3fae-b9d5-5b5e-bd0f-dcd4106b4c3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{n\\pi }{6}" :db/id #edb/ref 17592186349305} {:answer/id #uuid "7bb5e873-76c9-58bf-8d7a-7e75030cf3fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}+\\frac{n\\pi }{6}" :db/id #edb/ref 17592186349581} {:answer/id #uuid "abfe1148-d014-58cf-9667-7f0d1e092c7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6n\\pi " :db/id #edb/ref 17592186349971}] :answer-field/correct {:answer/id #uuid "5d7a3fae-b9d5-5b5e-bd0f-dcd4106b4c3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{n\\pi }{6}" :db/id #edb/ref 17592186349305} :answer-field/id #uuid "6f6083aa-ab96-52a6-8f56-aa3dc31b367b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350896}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "57be2016-4f15-558e-8c73-c2bdbd52fe97" :question/math-academy-id "q-81546" :question/problem "Which of the following expressions gives all of the zeros of the function $f(x)=\\operatorname{cot}⁡(6x+\\frac{\\pi }{2})?$ Assume that $n$ is an integer." :question/worked-solution "The zeros of $y=\\operatorname{cot}⁡x$ are given by \n\n$$\nx=\\frac{\\pi }{2}+n\\pi ,\n$$\n\nwhere $n$ is an integer.\n\nTo find the zeros of $f(x)=\\operatorname{cot}⁡(6x+\\frac{\\pi }{2}),$ we replace the $x$ on the left-hand side of the above with $(6x+\\frac{\\pi }{2}).$ This gives\n\n$$\n6x+\\frac{\\pi }{2}=\\frac{\\pi }{2}+n\\pi .\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}6x+\\frac{\\pi }{2} & =\\frac{\\pi }{2}+n\\pi  \\\\ 6x & =n\\pi  \\\\ x & =\\frac{n\\pi }{6}.\\end{aligned}\n$$\n\nTherefore, we conclude that the zeros are $x=\\frac{n\\pi }{6},$ where $n$ is an integer."}] [{:db/id #edb/ref 17592186351332 :knowledge-point/_questions [{:db/id #edb/ref 17592186083154 :knowledge-point/id #uuid "a8dbb426-dd34-5686-bde9-3ef9d246b5e5" :knowledge-point/title "Finding the Range of a Transformed Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e3e445b-242f-5183-8134-e1a2873f586c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,-4]\\cup [4,\\infty )" :db/id #edb/ref 17592186348570} {:answer/id #uuid "29c5d455-ea88-583b-878a-5b2da6e2eca5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,3]\\cup [5,\\infty )" :db/id #edb/ref 17592186348815} {:answer/id #uuid "87848d38-9a7f-500f-8ee0-d03c8430c2a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,0]\\cup [4,\\infty )" :db/id #edb/ref 17592186349681} {:answer/id #uuid "c66561f4-bc83-5fd5-927f-843045ce31e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,-3]\\cup [5,\\infty )" :db/id #edb/ref 17592186350193} {:answer/id #uuid "c6d22d26-f36a-5676-9a92-d9439050a127" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,-5]\\cup [-3,\\infty )" :db/id #edb/ref 17592186350197}] :answer-field/correct {:answer/id #uuid "29c5d455-ea88-583b-878a-5b2da6e2eca5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,3]\\cup [5,\\infty )" :db/id #edb/ref 17592186348815} :answer-field/id #uuid "05d872cb-4071-5344-a1bc-bda53e5bcc36" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350715}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e7bdacc5-30cf-5786-b5bc-164c930bb79b" :question/math-academy-id "q-81567" :question/problem "Find the range of the function $f(x)=\\operatorname{sec}⁡(2x-1)+4.$" :question/worked-solution "The range of $\\operatorname{sec}⁡x$ consists of two intervals:\n\n$$\n\\operatorname{sec}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty )\n$$\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n\\operatorname{sec}⁡(2x-1)\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nWe can split this into two inequalities:\n\n$$\n\\operatorname{sec}⁡(2x-1)\\le -1,\\,\\operatorname{sec}⁡(2x-1)\\ge 1\n$$\n\nTo find the range of $f(x),$ we consider both intervals separately.\n\n- If we add $4$ to the first interval, we get\n\n$$\n\\begin{aligned} & \\operatorname{sec}⁡(2x-1)\\le -1 \\\\  & \\operatorname{sec}⁡(2x-1)+4\\le -1+4 \\\\  & \\operatorname{sec}⁡(2x-1)+4\\le 3 \\\\  & f(x)\\le 3.\\end{aligned}\n$$\n\n- If we add $4$ to the second interval, we get\n\n$$\n\\begin{aligned} & \\operatorname{sec}⁡(2x-1)\\ge 1 \\\\  & \\operatorname{sec}⁡(2x-1)+4\\ge 1+4 \\\\  & \\operatorname{sec}⁡(2x-1)+4\\ge 5 \\\\  & f(x)\\ge 5.\\end{aligned}\n$$\n\nCombining both inequalities, we get\n\n$$\nf(x)\\le 3,\\,f(x)\\ge 5.\n$$\n\nTherefore, we conclude that the range is $f(x)\\in (-\\infty ,3]\\cup [5,\\infty ).$"}]}
