swer/id #uuid "a6a9d072-36c0-5de9-8c2a-721aab34dd27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$M$ only" :db/id #edb/ref 17592186396164} {:answer/id #uuid "610851d8-2303-56fb-9fc0-aefe88bab851" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$K$ and $L$ only" :db/id #edb/ref 17592186396165} {:answer/id #uuid "25f771aa-b7d7-5d86-a28a-ca24f26dc2ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L$ and $M$ only" :db/id #edb/ref 17592186396166} {:answer/id #uuid "151edfbf-fc56-54ae-9bf2-3f2f8dc0b2de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L$ only" :db/id #edb/ref 17592186396167} {:answer/id #uuid "eeb96d3c-a223-5810-9d7d-8755c8adf510" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$K$ and $M$ only" :db/id #edb/ref 17592186396168}] :answer-field/correct {:answer/id #uuid "25f771aa-b7d7-5d86-a28a-ca24f26dc2ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L$ and $M$ only" :db/id #edb/ref 17592186396166} :answer-field/id #uuid "8f553809-f578-5b97-b742-22d7fa6d05fb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396163}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7ba95bcc-83a0-57ed-9254-81c22af4a048" :question/math-academy-id "q-7835" :question/problem "Which of the following are square matrices?\n\n$$\nK=[\\begin{aligned}3 & 1 & 1 \\\\ 0 & 0 & 0\\end{aligned}],\\,L=[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}],\\,M=[\\begin{aligned}2 & 3 & 0 & 1 \\\\ 0 & 0 & 0 & 0 \\\\ 7 & 1 & 1 & 4 \\\\ 0 & 0 & 0 & 8\\end{aligned}]\n$$" :question/worked-solution "- $K$ is *not* a square matrix since the numbers of rows and columns are not the same. It has $2$ rows and $3$ columns, so it's a $2\\times 3$ matrix.\n\n- $L$ is a square matrix since it has the same number of rows and columns. It has $2$ rows and $2$ columns, so it is a $2\\times 2$ matrix.\n\n- $M$ is a square matrix since it has the same number of rows and columns. It has $4$ rows and $4$ columns, so it is a $4\\times 4$ matrix.\n\nTherefore, only $L$ and $M$ are square matrices."}] [{:db/id #edb/ref 17592186348077 :knowledge-point/_questions [{:db/id #edb/ref 17592186083206 :knowledge-point/id #uuid "345d6df7-2ada-5c2e-8146-7c779afae3af" :knowledge-point/title "Finding the Center of a Vertical Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41d6c920-989f-5ce5-a8d5-c2abc399051f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,3)" :db/id #edb/ref 17592186345915} {:answer/id #uuid "5b65b5d5-07d7-5975-9ee4-291d6b399353" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-2)" :db/id #edb/ref 17592186346130} {:answer/id #uuid "9e973f9e-81b5-5854-88b0-98066c9a699d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6,9)" :db/id #edb/ref 17592186346735} {:answer/id #uuid "b2220b9a-c972-5a58-a399-44ce9b253549" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,-3)" :db/id #edb/ref 17592186346905} {:answer/id #uuid "fbfc5434-346a-59f7-b3db-0e599e3994ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,6)" :db/id #edb/ref 17592186347572}] :answer-field/correct {:answer/id #uuid "41d6c920-989f-5ce5-a8d5-c2abc399051f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,3)" :db/id #edb/ref 17592186345915} :answer-field/id #uuid "13539e3e-82b2-55bb-b37b-e5e32ff876f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347641}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8280a162-8b28-5252-92be-7c19e3ebbf0c" :question/math-academy-id "q-78379" :question/problem "What is the center of the hyperbola \n$-3{x}^{2}+2{y}^{2}+12x-12y=12?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}-3{x}^{2}+2{y}^{2}+12x-12y & =12 \\\\ 2{y}^{2}-12y-3{x}^{2}+12x & =12 \\\\ 2[{y}^{2}-6y]-3[{x}^{2}-4x] & =12 \\\\ 2[(y-3)^{2}-9]-3[(x-2)^{2}-4] & =12 \\\\ 2(y-3)^{2}-18-3(x-2)^{2}+12 & =12 \\\\ 2(y-3)^{2}-3(x-2)^{2} & =12+18-12 \\\\ 2(y-3)^{2}-3(x-2)^{2} & =18 \\\\ \\frac{(y-3)^{2}}{9}-\\frac{(x-2)^{2}}{6} & =1.\\end{aligned}\n$$\n\nHence, the center is $(2,3).$"}] [{:db/id #edb/ref 17592186393856 :knowledge-point/_questions [{:db/id #edb/ref 17592186092187 :knowledge-point/id #uuid "5d0cda54-4a4b-5255-b375-ce5e7b604dff" :knowledge-point/title "Solving a Matrix Equation Using Algebraic Manipulation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "366c6653-367a-59a7-84cb-6ee9c7105259" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=BA\\,d" :db/id #edb/ref 17592186393858} {:answer/id #uuid "7cdfd0ed-3fe5-5b86-87d3-32bcacf5d620" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={B}^{-1}\\,d\\,{A}^{-1}" :db/id #edb/ref 17592186393859} {:answer/id #uuid "14be786b-6205-5224-9e4e-5339226f55dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={A}^{-1}{B}^{-1}\\,d" :db/id #edb/ref 17592186393860} {:answer/id #uuid "5efc90ca-87fe-57c3-ba7c-64fc159ed6b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={B}^{-1}{A}^{-1}\\,d" :db/id #edb/ref 17592186393861} {:answer/id #uuid "3969bfd8-042f-5db5-aa6d-bb90db966f17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={A}^{-1}\\,d\\,B" :db/id #edb/ref 17592186393862}] :answer-field/correct {:answer/id #uuid "5efc90ca-87fe-57c3-ba7c-64fc159ed6b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={B}^{-1}{A}^{-1}\\,d" :db/id #edb/ref 17592186393861} :answer-field/id #uuid "0e367af9-44e1-5186-9afd-a825a6fad5d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393857}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ecb9056c-9932-5a89-8f17-1df1e929dfe8" :question/math-academy-id "q-78445" :question/problem "Consider a matrix equation $AB\\,x=d,$ where $A$ and $B$ are $4\\times 4$ non-singular matrices, while $x$ and $d$ are $4\\times 1$ column vectors. Solve the equation for $x.$" :question/worked-solution "Since $A$ is not singular, it must have an inverse ${A}^{-1}.$ Now, pre-multiplying both sides of the equation $AB\\,x=d$ by ${A}^{-1},$ we obtain\n\n$$\n\\begin{aligned}AB\\,x & =d \\\\ {A}^{-1}AB\\,x & ={A}^{-1}\\,d \\\\ {I}_{4}B\\,x & ={A}^{-1}\\,d \\\\ B\\,x & ={A}^{-1}\\,d.\\end{aligned}\n$$\n\nSince $B$ is not singular, it must have an inverse ${B}^{-1}.$ Now, pre-multiplying both sides of the equation $B\\,x={A}^{-1}\\,d$ by ${B}^{-1},$ we obtain\n\n$$\n\\begin{aligned}B\\,x & ={A}^{-1}\\,d \\\\ {B}^{-1}B\\,x & ={B}^{-1}{A}^{-1}\\,d \\\\ {I}_{4}\\,x & ={B}^{-1}{A}^{-1}\\,d \\\\ x & ={B}^{-1}{A}^{-1}\\,d.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348085 :knowledge-point/_questions [{:db/id #edb/ref 17592186078497 :knowledge-point/id #uuid "908ce57e-7ca8-5e5f-bdcb-0d2ef79f10ea" :knowledge-point/title "Calculating the Range of Values of a Parameter for Which a Geometric Series Converges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59a27ae7-7c57-54e7-b03e-9fbdacd374c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k<0" :db/id #edb/ref 17592186346118} {:answer/id #uuid "5bf92d0c-6f00-5421-9e59-486b9104a848" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k>5" :db/id #edb/ref 17592186346136} {:answer/id #uuid "848cef78-b991-5da0-869f-d697a30cac16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k>0" :db/id #edb/ref 17592186346507} {:answer/id #uuid "a478cb86-21b0-5f14-9d49-520709495b48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k<6" :db/id #edb/ref 17592186346780} {:answer/id #uuid "abfbffad-dd3b-50fa-9486-91574e2fb7e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k>6" :db/id #edb/ref 17592186346852}] :answer-field/correct {:answer/id #uuid "abfbffad-dd3b-50fa-9486-91574e2fb7e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k>6" :db/id #edb/ref 17592186346852} :answer-field/id #uuid "a1d14c1f-bb28-5566-b0d5-5be361b027e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347890}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "99e56538-c134-5d33-a767-559703eb3b5b" :question/math-academy-id "q-78490" :question/problem "For which values of $k$ does the series ${\\sum }_{n=1}^{\\infty }{(\\frac{64}{{2}^{k}})}^{n}$ converge?" :question/worked-solution "We see that this is a geometric series with a common ratio of $r=\\frac{64}{{2}^{k}}.$ \n\nFor the series to converge, we require $|r|<1.$ Therefore, we have\n\n$$\n\\begin{aligned}|\\frac{64}{{2}^{k}}| & <1 \\\\ \\frac{64}{{2}^{k}} & <1 \\\\ 64 & <{2}^{k} \\\\ {2}^{k} & >64.\\end{aligned}\n$$\n\nNotice that we could remove the absolute value bars because $\\frac{64}{{2}^{k}}$ is always positive.\n\nThe equation ${2}^{k}=64$ has the solution $k=6.$ Now, since ${2}^{k}$ increases as $k$ increases, the solution to ${2}^{k}>64$ must be $k>6.$"}] [{:db/id #edb/ref 17592186393863 :knowledge-point/_questions [{:db/id #edb/ref 17592186115229 :knowledge-point/id #uuid "82e970fe-cff8-50e3-9b94-67ad97b03da7" :knowledge-point/title "Finding a Power of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d718e860-d9b8-5907-8e53-05046524911e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 12 \\\\ 14 & 9\\end{aligned}]" :db/id #edb/ref 17592186393865} {:answer/id #uuid "0b2da8db-419b-5fc2-a2f6-c5d25d2ee8d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 2 \\\\ 4 & 9\\end{aligned}]" :db/id #edb/ref 17592186393866} {:answer/id #uuid "6f8c7ef1-9d5b-59ed-9bfc-b71aaba92cbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 12 \\\\ 4 & 19\\end{aligned}]" :db/id #edb/ref 17592186393867} {:answer/id #uuid "41965806-1f4e-5183-9b81-5ddeff998ace" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}8 & 12 \\\\ 1 & 9\\end{aligned}]" :db/id #edb/ref 17592186393868} {:answer/id #uuid "ba1e5569-d116-55e7-87e8-e2b89abc51e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 12 \\\\ 4 & 19\\end{aligned}]" :db/id #edb/ref 17592186393869}] :answer-field/correct {:answer/id #uuid "ba1e5569-d116-55e7-87e8-e2b89abc51e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 12 \\\\ 4 & 19\\end{aligned}]" :db/id #edb/ref 17592186393869} :answer-field/id #uuid "22d67059-f6d7-5521-9126-3196f2ed6789" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393864}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "88934d15-ae66-5c80-a236-6a63bba3d33b" :question/math-academy-id "q-78497" :question/problem "If $F=[\\begin{aligned}0 & 3 \\\\ 1 & 4\\end{aligned}]$, then ${F}^{2}=$" :question/worked-solution "To find ${F}^{2},$ we multiply $F$ by itself:\n\n$$\n\\begin{aligned}{F}^{2} & =F\\cdot F \\\\  & =[\\begin{aligned}0 & 3 \\\\ 1 & 4\\end{aligned}]\\cdot [\\begin{aligned}0 & 3 \\\\ 1 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 12 \\\\ 4 & 19\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393870 :knowledge-point/_questions [{:db/id #edb/ref 17592186184159 :knowledge-point/id #uuid "cc8dc1a1-9606-5b67-942e-219ab2ddfc1c" :knowledge-point/title "Finding a Power of a Nilpotent Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46eb92c2-7586-5474-8de1-8f3018443d1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 & 0 \\\\ 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186393872} {:answer/id #uuid "533dd821-5655-5510-a57f-8493e82642af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 0 \\\\ -3 & 0\\end{aligned}]" :db/id #edb/ref 17592186393873} {:answer/id #uuid "aef19fc2-859f-59e3-8cd0-62db907c84bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186393874} {:answer/id #uuid "d5c8ed65-2963-576c-8a72-8223e203e5ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 & 16 \\\\ -1 & 4\\end{aligned}]" :db/id #edb/ref 17592186393875} {:answer/id #uuid "d00a9629-7e88-5d9d-aadb-bf40609cc5bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & -16 \\\\ 1 & -4\\end{aligned}]" :db/id #edb/ref 17592186393876}] :answer-field/correct {:answer/id #uuid "aef19fc2-859f-59e3-8cd0-62db907c84bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186393874} :answer-field/id #uuid "52a06aef-9285-5bae-89f6-500d7ffcb21a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393871}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1700d4e7-644c-5246-9a39-552cdcd23dbb" :question/math-academy-id "q-78534" :question/problem "If $K=[\\begin{aligned}-4 & 16 \\\\ -1 & 4\\end{aligned}]$, then ${K}^{6}=$" :question/worked-solution "Computing ${K}^{2},$ we have\n\n$$\n\\begin{aligned}{K}^{2} & =K\\cdot K \\\\  & =[\\begin{aligned}-4 & 16 \\\\ -1 & 4\\end{aligned}]\\cdot [\\begin{aligned}-4 & 16 \\\\ -1 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}] \\\\  & =O.\\end{aligned}\n$$\n\nNotice that, since ${K}^{2}=O,$ the matrix $K$ is a nilpotent matrix of index $2.$ \n\nWe can use this fact to compute ${K}^{6}$ quickly, as follows:\n\n$$\n\\begin{aligned}{K}^{6} & ={K}^{2}\\cdot {K}^{4} \\\\  & =O\\cdot {K}^{4} \\\\  & =O\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{K}^{6}=[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186348092 :knowledge-point/_questions [{:db/id #edb/ref 17592186133956 :knowledge-point/id #uuid "7dffa987-022c-52a2-bc21-cdace7455eab" :knowledge-point/title "Determining the Number of Solutions Given a Table of Values of a Continuous Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a513028-7494-52ef-ad77-c476ad1110db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186345582} {:answer/id #uuid "4f653602-ed65-5294-8d6c-a6ef40f95a14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186346030} {:answer/id #uuid "5f729d70-c219-5012-b6a4-33000a396e60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186346175} {:answer/id #uuid "7de2999b-8a5b-506d-ad8d-ee40e381570c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186346453} {:answer/id #uuid "c5ab31d1-2bed-5320-91a1-aa82ac71d5a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186347069}] :answer-field/correct {:answer/id #uuid "7de2999b-8a5b-506d-ad8d-ee40e381570c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186346453} :answer-field/id #uuid "01a7db5c-f3b0-55a6-bffd-8b68714c8c17" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347608}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ae2fb37c-3d07-5853-b99d-9e361dcd461b" :question/math-academy-id "q-78542" :question/problem "The function $g(x)$ is continuous over $x\\in [-1,2].$ Some values of $g(x)$ are given in the table below. \n\n| $x$ | $-1$ | $1$ | $2$ |\n| --- | --- | --- | --- |\n| $g(x)$ | $2$ | $0$ | $3$ |\n\nWhat is the smallest possible number of solutions to the equation $g(x)=1?$" :question/worked-solution "Since $g$ is a continuous function on $[-1,2]$, we can apply the intermediate value theorem (IVT) in any subinterval of $[-1,2].$\n\nWe will go through each subinterval of $[-1,2]$ and check if the IVT guarantees a solution to the equation $g(x)=1$ on this interval.\n\n- On the subinterval $[-1,1],$ we have $g(-1)=2$ and $g(1)=0.$ Since $1\\in [0,2],$ the IVT *does* guarantee a solution to the equation $g(x)=1$ on this subinterval.\n\n- On the subinterval $[1,2],$ we have $g(1)=0$ and $g(2)=3.$ Since $1\\in [0,3],$ the IVT  *does* guarantee a solution to the equation $g(x)=1$ on this subinterval.\n\nThe IVT guarantees solutions to $g(x)=1$ on the subintervals $[-1,1]$ and $[1,2].$ Therefore, $g(x)=1$ has at least two solutions."}] [{:db/id #edb/ref 17592186393877 :knowledge-point/_questions [{:db/id #edb/ref 17592186092185 :knowledge-point/id #uuid "12637b1d-ca03-568f-b1fc-6a626eec88de" :knowledge-point/title "Solving a 3x3 System of Equations Given the Inverse of the Coefficient Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e5fd665-92c8-5de9-a962-94e1f5665e2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186393879} {:answer/id #uuid "b49b5346-149e-5688-b4e3-abd91ac82b0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186393880} {:answer/id #uuid "dde44d62-1c85-5ae3-b2b1-d15a071a6e4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186393881} {:answer/id #uuid "86f61021-d77c-5497-9ea7-8d2d27863b89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186393882} {:answer/id #uuid "6286448b-0a3f-5139-a73d-05652685e000" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186393883}] :answer-field/correct {:answer/id #uuid "6286448b-0a3f-5139-a73d-05652685e000" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186393883} :answer-field/id #uuid "4352c172-b7da-52e6-b834-2727aa018a4d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393878}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c98c808b-049b-59b0-8d36-61df2339933c" :question/math-academy-id "q-78549" :question/problem "Consider the following system of linear equations:\n\n$$\n\\{\\begin{aligned}x+2y+4z=-2 \\\\ x+3y+9z=0 \\\\ y+6z=3\\end{aligned}\n$$\n\nThe system above has the matrix representation $Ax=b.$ Given that $x=⟨x,y,z⟩$ is unique, what is the value of $x+y+z?$ \n\n*Hint: The inverse of the coefficient matrix is given by*\n\n$$\n\\,{A}^{-1}=[\\begin{aligned}9 & -8 & 6 \\\\ -6 & 6 & -5 \\\\ 1 & -1 & 1\\end{aligned}].\n$$" :question/worked-solution "First, let's write our system in matrix form as follows:\n\n$$\n\\begin{aligned}Ax & =b \\\\ [\\begin{aligned}1 & 2 & 4 \\\\ 1 & 3 & 9 \\\\ 0 & 1 & 6\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-2 \\\\ 0 \\\\ 3\\end{aligned}]\\end{aligned}\n$$\n\nRecall that the solution to $Ax=b$ is given by $x={A}^{-1}b.$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =[\\begin{aligned}9 & -8 & 6 \\\\ -6 & 6 & -5 \\\\ 1 & -1 & 1\\end{aligned}][\\begin{aligned}-2 \\\\ 0 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ -3 \\\\ 1\\end{aligned}].\\end{aligned}\n$$\n\nSo, the solution is $x=0,y=-3,z=1.$\n\nFinally, $x+y+z=0+(-3)+1=-2.$"}] [{:db/id #edb/ref 17592186393884 :knowledge-point/_questions [{:db/id #edb/ref 17592186092185 :knowledge-point/id #uuid "12637b1d-ca03-568f-b1fc-6a626eec88de" :knowledge-point/title "Solving a 3x3 System of Equations Given the Inverse of the Coefficient Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d740f60-2523-5646-9a92-3c0d339e8fc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186393886} {:answer/id #uuid "b7f32d4d-f862-5218-b3d1-078edcdfe213" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186393887} {:answer/id #uuid "12eac5a8-05a9-5828-8db5-751459d1b149" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186393888} {:answer/id #uuid "5af9cd45-f4f1-5692-8de2-840ab3c6c7fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186393889} {:answer/id #uuid "44860cb9-5129-5c07-80fe-7caff5e9aed0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186393890}] :answer-field/correct {:answer/id #uuid "b7f32d4d-f862-5218-b3d1-078edcdfe213" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186393887} :answer-field/id #uuid "b5d59287-5dfe-56f3-93e2-54429b0c04b7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393885}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "07f12953-92a4-55d6-afcb-39fb0f43a712" :question/math-academy-id "q-78552" :question/problem "Consider the following system of linear equations:\n\n$$\n\\{\\begin{aligned}4x-3y+2z=-4 \\\\ -4x+4y-3z=7 \\\\ x-y+z=-2\\end{aligned}\n$$\n\nThe system above has the matrix representation $Ax=b.$ Given that $x=⟨x,y,z⟩$ is unique, what is the value of $x+y+z?$ \n\n*Hint: The inverse of the coefficient matrix is given by*\n\n$$\n\\,{A}^{-1}=[\\begin{aligned}1 & 1 & 1 \\\\ 1 & 2 & 4 \\\\ 0 & 1 & 4\\end{aligned}].\n$$" :question/worked-solution "First, let's write our system in matrix form as follows:\n\n$$\n\\begin{aligned}Ax & =b \\\\ [\\begin{aligned}4 & -3 & 2 \\\\ -4 & 4 & -3 \\\\ 1 & -1 & 1\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-4 \\\\ 7 \\\\ -2\\end{aligned}]\\end{aligned}\n$$\n\nRecall that the solution to $Ax=b$ is given by $x={A}^{-1}b.$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =[\\begin{aligned}1 & 1 & 1 \\\\ 1 & 2 & 4 \\\\ 0 & 1 & 4\\end{aligned}][\\begin{aligned}-4 \\\\ 7 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}].\\end{aligned}\n$$\n\nSo, the solution is $x=1,y=2,z=-1.$\n\nFinally, $x+y+z=1+2+(-1)=2.$"}] [{:db/id #edb/ref 17592186403947 :knowledge-point/_questions [{:db/id #edb/ref 17592186092187 :knowledge-point/id #uuid "5d0cda54-4a4b-5255-b375-ce5e7b604dff" :knowledge-point/title "Solving a Matrix Equation Using Algebraic Manipulation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53d8f566-865b-5d1d-968f-ffc7aeaaf0b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${D}^{-1}$ and ${I}_{n}$" :db/id #edb/ref 17592186403949} {:answer/id #uuid "6898f8cf-ef60-599d-b703-aeb35e14e141" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$D$ and ${I}_{n}$" :db/id #edb/ref 17592186403950} {:answer/id #uuid "0329ed6f-dee9-5205-b238-18984ed73972" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${D}^{-1}$ and $D$" :db/id #edb/ref 17592186403951} {:answer/id #uuid "a15466de-3c65-5970-8e36-5b25e21ca209" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${D}^{-1}$ and ${D}^{-1}$" :db/id #edb/ref 17592186403952} {:answer/id #uuid "daabc2d4-f4ce-50f8-9f41-a9e7585ac6e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$D$ and $z$" :db/id #edb/ref 17592186403953}] :answer-field/correct {:answer/id #uuid "53d8f566-865b-5d1d-968f-ffc7aeaaf0b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${D}^{-1}$ and ${I}_{n}$" :db/id #edb/ref 17592186403949} :answer-field/id #uuid "4cf7d7a2-cf8f-5d79-a5a3-2c7fb6abb055" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403948}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "863bd08e-01cd-5a69-b3ce-bacc176f8b4b" :question/math-academy-id "q-78559" :question/problem "Consider a system of $n$ linear equations in $n$ variables, written in matrix form as $D\\,z=c.$ Here, $D$ is the non-singular coefficient matrix of the system, $z$ is the column vector containing the variables, and $c$ is the column vector containing the constants. The unique solution of the system can be found using the method shown below:\n\n$$\n\\begin{aligned}D\\,z & =c \\\\ {D}^{-1}D\\,z & =\\bbox[2pt,lightgray]{\\color{blue}{\\phantom{{D}^{-1}}}}c \\\\ \\bbox[2pt,lightgray]{\\color{blue}{\\phantom{{I}_{n}}}}z & ={D}^{-1}\\,c \\\\ z & ={D}^{-1}\\,c\\end{aligned}\n$$\n\nFrom top to bottom and right to left, what are the missing parts of the derivation?" :question/worked-solution "Since $D$ is not singular, it must have an inverse ${D}^{-1}.$ Now, pre-multiplying both sides of the equation $D\\,z=c$ by ${D}^{-1},$ we obtain the following:\n\n$$\n\\begin{aligned}D\\,z & =c \\\\ {D}^{-1}D\\,z & ={D}^{-1}c \\\\ {I}_{n}\\,z & ={D}^{-1}\\,c \\\\ z & ={D}^{-1}\\,c\\end{aligned}\n$$\n\nTherefore, the missing parts are ${D}^{-1}$ and ${I}_{n}.$"}] [{:db/id #edb/ref 17592186403954 :knowledge-point/_questions [{:db/id #edb/ref 17592186092187 :knowledge-point/id #uuid "5d0cda54-4a4b-5255-b375-ce5e7b604dff" :knowledge-point/title "Solving a Matrix Equation Using Algebraic Manipulation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f916d57-a48d-5f42-a1e6-2cc8f554dc1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${D}^{-1}$ and $q$" :db/id #edb/ref 17592186403956} {:answer/id #uuid "a2636cd7-9981-5e94-8ce6-ffc7ac605d47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${D}^{-1}$ and $t$" :db/id #edb/ref 17592186403957} {:answer/id #uuid "cd887cdb-1f42-5d46-bc3e-089ab176ac9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$D$ and ${I}_{n}$" :db/id #edb/ref 17592186403958} {:answer/id #uuid "e14838e1-6770-514b-a8d3-264fece5dc27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${D}^{-1}$ and $D$" :db/id #edb/ref 17592186403959} {:answer/id #uuid "45769dbd-ae3d-5976-b913-0ac9c72c7a88" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$D$ and $q$" :db/id #edb/ref 17592186403960}] :answer-field/correct {:answer/id #uuid "7f916d57-a48d-5f42-a1e6-2cc8f554dc1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${D}^{-1}$ and $q$" :db/id #edb/ref 17592186403956} :answer-field/id #uuid "96efe5ef-8066-599a-a9a3-934df32a5fcd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403955}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ecf8e0a5-c1dd-5243-9116-de59a516e7ec" :question/math-academy-id "q-78561" :question/problem "Consider a system of $n$ linear equations in $n$ variables, written in matrix form as $D\\,t=q.$ Here, $D$ is the non-singular coefficient matrix of the system, $t$ is the column vector containing the variables, and $q$ is the column vector containing the constants. The unique solution of the system can be found using the method shown below:\n\n$$\n\\begin{aligned}D\\,t & =q \\\\ \\bbox[2pt,lightgray]{\\color{blue}{\\phantom{{D}^{-1}}}}D\\,t & ={D}^{-1}\\,q \\\\ {I}_{n}\\,t & ={D}^{-1}\\,\\bbox[2pt,lightgray]{\\color{blue}{\\phantom{\\mathbf{q}}}} \\\\ t & ={D}^{-1}\\,q\\end{aligned}\n$$\n\nFrom top to bottom and left to right, what are the missing parts of the derivation?" :question/worked-solution "Since $D$ is not singular, it must have an inverse ${D}^{-1}.$ Now, pre-multiplying both sides of the equation $D\\,t=q$ by ${D}^{-1},$ we obtain the following:\n\n$$\n\\begin{aligned}D\\,t & =q \\\\ {D}^{-1}D\\,t & ={D}^{-1}\\,q \\\\ {I}_{n}\\,t & ={D}^{-1}\\,q \\\\ t & ={D}^{-1}\\,q\\end{aligned}\n$$\n\nTherefore, the missing parts are ${D}^{-1}$ and $q.$"}] [{:db/id #edb/ref 17592186393905 :knowledge-point/_questions [{:db/id #edb/ref 17592186092187 :knowledge-point/id #uuid "5d0cda54-4a4b-5255-b375-ce5e7b604dff" :knowledge-point/title "Solving a Matrix Equation Using Algebraic Manipulation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ccb6862b-40a4-553e-b127-875a257430ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=BA\\,d" :db/id #edb/ref 17592186393907} {:answer/id #uuid "c37e5a61-c2eb-538b-99a7-23642c14b38b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={A}^{-1}B\\,d" :db/id #edb/ref 17592186393908} {:answer/id #uuid "8ee481b4-326b-5845-a01e-35c02639b453" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=B\\,d\\,A" :db/id #edb/ref 17592186393909} {:answer/id #uuid "8395c955-c031-5153-8925-7f64e907dff2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={B}^{-1}{A}^{-1}\\,d" :db/id #edb/ref 17592186393910} {:answer/id #uuid "85a30c66-8a0b-5199-9181-20081d9e024c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=B{A}^{-1}\\,d" :db/id #edb/ref 17592186393911}] :answer-field/correct {:answer/id #uuid "85a30c66-8a0b-5199-9181-20081d9e024c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=B{A}^{-1}\\,d" :db/id #edb/ref 17592186393911} :answer-field/id #uuid "fd860ae1-dad5-535f-9702-2f27d023f02d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393906}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "434e4ac4-2d0e-5134-b4d8-984f36cd5b9a" :question/math-academy-id "q-78568" :question/problem "Consider a matrix equation $A{B}^{-1}\\,x=d,$ where $A$ and $B$ are $5\\times 5$ non-singular matrices, while $x$ and $d$ are $5\\times 1$ column vectors. Solve the equation for $x.$" :question/worked-solution "Since $A$ is not singular, it must have an inverse ${A}^{-1}.$ Now, pre-multiplying both sides of the equation $A{B}^{-1}\\,x=d$ by ${A}^{-1},$ we obtain\n\n$$\n\\begin{aligned}A{B}^{-1}\\,x & =d \\\\ {A}^{-1}A{B}^{-1}\\,x & ={A}^{-1}\\,d \\\\ {I}_{5}{B}^{-1}\\,x & ={A}^{-1}\\,d \\\\ {B}^{-1}\\,x & ={A}^{-1}\\,d.\\end{aligned}\n$$\n\nNow, pre-multiplying both sides of the equation ${B}^{-1}\\,x={A}^{-1}\\,d$ by $B,$ we obtain\n\n$$\n\\begin{aligned}{B}^{-1}\\,x & ={A}^{-1}\\,d \\\\ B{B}^{-1}\\,x & =B{A}^{-1}\\,d \\\\ {I}_{5}\\,x & =B{A}^{-1}\\,d \\\\ x & =B{A}^{-1}\\,d.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393912 :knowledge-point/_questions [{:db/id #edb/ref 17592186184160 :knowledge-point/id #uuid "b51e8ff1-247b-5efd-a684-8fca6c064e1e" :knowledge-point/title "Finding a Power of an Idempotent Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d0b2a5a8-67e7-5639-9d41-6b6082af0189" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186393914} {:answer/id #uuid "6cf33cc7-55a2-56b0-9243-826fe4617b79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -6 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186393915} {:answer/id #uuid "b56078f5-e9a2-54d5-b4dc-d6536dec2e4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ -6 & 0\\end{aligned}]" :db/id #edb/ref 17592186393916} {:answer/id #uuid "6198d7ae-e34d-53ed-983e-2b4492d3825c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 1 \\\\ -6 & 0\\end{aligned}]" :db/id #edb/ref 17592186393917} {:answer/id #uuid "90b66a89-a532-5756-b976-d72f2602a6b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -6 \\\\ 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186393918}] :answer-field/correct {:answer/id #uuid "b56078f5-e9a2-54d5-b4dc-d6536dec2e4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ -6 & 0\\end{aligned}]" :db/id #edb/ref 17592186393916} :answer-field/id #uuid "12ef64bb-d65e-5cfd-b87f-976d076e6e82" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393913}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f92da47c-e719-5f4d-aa7e-be4e5edae187" :question/math-academy-id "q-78577" :question/problem "If $Z=[\\begin{aligned}1 & 0 \\\\ -6 & 0\\end{aligned}]$, then ${Z}^{5}=$" :question/worked-solution "First, we compute ${Z}^{2}$ as follows:\n\n$$\n\\begin{aligned}{Z}^{2} & =Z\\cdot Z \\\\  & =[\\begin{aligned}1 & 0 \\\\ -6 & 0\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 \\\\ -6 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ -6 & 0\\end{aligned}] \\\\  & =Z\\end{aligned}\n$$\n\nNotice that ${Z}^{2}=Z,$ so $Z$ is an idempotent matrix. \n\nWe can use this fact to compute ${Z}^{5}$ quickly, as follows:\n\n$$\n\\begin{aligned}{Z}^{5} & ={Z}^{2}\\cdot {Z}^{2}\\cdot Z \\\\  & =Z\\cdot Z\\cdot Z \\\\  & ={Z}^{2}\\cdot Z \\\\  & =Z\\cdot Z \\\\  & ={Z}^{2} \\\\  & =Z\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{Z}^{5}=[\\begin{aligned}1 & 0 \\\\ -6 & 0\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186152797 :knowledge-point/_questions [{:db/id #edb/ref 17592186152190 :knowledge-point/id #uuid "9b51a7bc-7701-539f-9e20-dfc7f2574559" :knowledge-point/title "Parametrizing Part of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "493b8640-4fdd-5d60-946f-939751c8af46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta \\in [0,2\\pi )" :db/id #edb/ref 17592186345977} {:answer/id #uuid "b84f1666-210b-572b-9813-7c6c6f7b754f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta \\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}]" :db/id #edb/ref 17592186346954} {:answer/id #uuid "d511cf0c-a77c-5137-a47d-1d8bab162656" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta \\in [0,\\frac{\\pi }{2}]" :db/id #edb/ref 17592186347224} {:answer/id #uuid "dc209651-386a-5003-b530-70073c38acc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta \\in [-\\pi ,\\pi ]" :db/id #edb/ref 17592186347281} {:answer/id #uuid "de89c853-d675-5aa5-9c59-7044975ffc83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta \\in [0,\\pi ]" :db/id #edb/ref 17592186347309}] :answer-field/correct {:answer/id #uuid "d511cf0c-a77c-5137-a47d-1d8bab162656" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta \\in [0,\\frac{\\pi }{2}]" :db/id #edb/ref 17592186347224} :answer-field/id #uuid "e4dbd66c-fb32-5276-886f-b616e04250fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186348005}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "158a895e-0de7-58b3-a9d1-1bc720ae5d4d" :question/math-academy-id "q-78682" :question/problem "![](images/e5/e5f0d56383e7cdc7bece094bb3a770695bf87f6d2bf6c4dce5876f4432b56803.png)\n\nThe quarter-ellipse above is defined by the parametric equations \n\n$$\nx=3\\operatorname{cos}⁡\\theta ,\\,y=2\\operatorname{sin}⁡\\theta .\n$$\n\nWhat is the domain of the parameter $\\theta ?$" :question/worked-solution "The parametric equations of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ are\n\n$$\nx=a\\operatorname{cos}⁡\\theta ,\\,y=b\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, $a=3$ and $b=2.$ Therefore, the parametric equations of the *full* ellipse are\n\n$$\nx=3\\operatorname{cos}⁡\\theta ,\\,y=2\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nTo restrict the parameterization to a quarter-ellipse, we associate the parameter $\\theta $ with the central angle formed by a point $(x,y)$ on the elipse and the $x$-axis. \n\n![](images/0b/0b38ee461b8895898a73f2b2120e1dac9823b1bf19b46924786c5c27c9beae74.png)\n\nWe can see that if we restrict $\\theta $ to $[0,\\frac{\\pi }{2}]$, we get the quarter-ellipse.\n\nTherefore, the parametric equations of the quarter-ellipse are \n\n$$\nx=3\\operatorname{cos}⁡\\theta ,\\,y=2\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,\\frac{\\pi }{2}].\n$$"}] [{:db/id #edb/ref 17592186348110 :knowledge-point/_questions [{:db/id #edb/ref 17592186087663 :knowledge-point/id #uuid "603badf5-1f56-581f-833a-ec08fbedf777" :knowledge-point/title "Finding the Equation of a Circle Given a Line Covering a Diameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c188ab8-7f65-5508-ac35-de5a92d33bc5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x-2)}^{2}+(y-2)^{2}=2" :db/id #edb/ref 17592186346007} {:answer/id #uuid "501178e7-b9b5-597d-994c-32c73ce9c7c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x-2)}^{2}+(y-2)^{2}=4" :db/id #edb/ref 17592186346034} {:answer/id #uuid "846e43be-9cad-5753-b6e8-686acb08e6f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x-2)}^{2}+(y-1)^{2}=2" :db/id #edb/ref 17592186346504} {:answer/id #uuid "8e3542ed-2818-5666-a951-48c6f1c6f1f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x-1)}^{2}+(y-2)^{2}=4" :db/id #edb/ref 17592186346587} {:answer/id #uuid "e4f19542-3d11-5d9c-8d07-03583b7ec7f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x-1)}^{2}+(y-1)^{2}=2" :db/id #edb/ref 17592186347367}] :answer-field/correct {:answer/id #uuid "e4f19542-3d11-5d9c-8d07-03583b7ec7f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x-1)}^{2}+(y-1)^{2}=2" :db/id #edb/ref 17592186347367} :answer-field/id #uuid "b8fcf680-b615-5eca-9196-3aa41cde11b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347929}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4ff0f8ae-2b5e-562b-95c7-79105f4de0c9" :question/math-academy-id "q-78784" :question/problem "![](images/36/36e373800d2bd917e38bec197fbb5add2ae785270c68ddb4daf740ad678d4ece.png)\n\nThe line $x+y=2$ intercepts the $x$- and $y$-axes at points $A$ and $B$, respectively. If the segment $\\overset{―}{AB}$ is a diameter of the circle, find the equation of the circle." :question/worked-solution "To find the $x$-coordinate of $A$, we set $y=0$ in the equation of the line and solve for $x:$ \n\n$$\n\\begin{aligned}x+0 & =2 \\\\ x & =2.\\end{aligned}\n$$\n\nSimilarly, to find the $y$-coordinate of $B$, we set $x=0$ and solve for $y$:\n\n$$\n\\begin{aligned}0+y & =2 \\\\ y & =2.\\end{aligned}\n$$\n\nSo, $A$ and $B$ have the  coordinates $(2,0)$ and $(0,2)$, respectively.\n\nIf the segment $\\overset{―}{AB}$ is a diameter of the circle, then the midpoint must be the center of the circle. Using the midpoint formula, we find that the center of the circle is at\n\n$$\n(\\frac{2+0}{2},\\frac{0+2}{2})=(1,1).\n$$\n\nNow, to find the radius of the circle, we compute the distance between the center $(1,1)$ and a point on the circle, say $A(2,0),$ as follows:\n\n$$\n\\begin{aligned}r & =\\sqrt{(1-2)^{2}+(1-0)^{2}} \\\\  & =\\sqrt{(-1)^{2}+{1}^{2}} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, since the circle has center $(1,1)$ and radius $r=\\sqrt{2},$ the equation of the circle is\n\n$$\n\\begin{aligned}{(x-1)}^{2}+(y-1)^{2} & ={(\\sqrt{2})}^{2} \\\\ {(x-1)}^{2}+(y-1)^{2} & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393919 :knowledge-point/_questions [{:db/id #edb/ref 17592186083298 :knowledge-point/id #uuid "cdab0134-e416-51cf-89fa-73ad4a2c2eb9" :knowledge-point/title "Finding the Center of a Vertical Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa18f118-2355-5b8c-9df1-5f07fa9cc4f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,-1)" :db/id #edb/ref 17592186393921} {:answer/id #uuid "681939e0-c1b8-5584-a552-56270ef2dd23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186393922} {:answer/id #uuid "37ac268f-53b5-5cd5-9571-d82a60590c63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,3)" :db/id #edb/ref 17592186393923} {:answer/id #uuid "309ef034-c0ce-5427-8824-f29131d83f9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,-4)" :db/id #edb/ref 17592186393924} {:answer/id #uuid "0970d9aa-cec4-5e99-88f9-692ea5e6391f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,4)" :db/id #edb/ref 17592186393925}] :answer-field/correct {:answer/id #uuid "309ef034-c0ce-5427-8824-f29131d83f9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,-4)" :db/id #edb/ref 17592186393924} :answer-field/id #uuid "e2f3f837-c3a4-566c-878d-4d0d80082f5f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393920}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "de6c6396-07c7-5951-af5e-8977842d4648" :question/math-academy-id "q-78866" :question/problem "What is the center of the hyperbola $\\frac{(y+4)^{2}}{3}-\\frac{(x+1)^{2}}{2}=1?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nNote that the given equation can be rewritten as follows:\n\n$$\n\\frac{(y-(-4))^{2}}{3}-\\frac{(x-(-1))^{2}}{2}=1\n$$\n\nIn this case, we have $h=-1$ and $k=-4.$\n\nTherefore, the center of the hyperbola is $(-1,-4).$"}] [{:db/id #edb/ref 17592186348115 :knowledge-point/_questions [{:db/id #edb/ref 17592186083298 :knowledge-point/id #uuid "cdab0134-e416-51cf-89fa-73ad4a2c2eb9" :knowledge-point/title "Finding the Center of a Vertical Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "113957f6-98d3-5920-b987-662f39480b14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,9)" :db/id #edb/ref 17592186345499} {:answer/id #uuid "42ccdf29-573d-5d54-a358-8947455a7adf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(7,-4)" :db/id #edb/ref 17592186345924} {:answer/id #uuid "514b7146-0014-5e80-a80c-7d4d12db96e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,-7)" :db/id #edb/ref 17592186346046} {:answer/id #uuid "9a506926-0044-5e16-97a3-1b03a73944b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,7)" :db/id #edb/ref 17592186346699} {:answer/id #uuid "c018bd19-a38e-52a0-b1a2-f2b2bbb7f4d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(9,1)" :db/id #edb/ref 17592186347013}] :answer-field/correct {:answer/id #uuid "9a506926-0044-5e16-97a3-1b03a73944b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,7)" :db/id #edb/ref 17592186346699} :answer-field/id #uuid "2f06a6e4-666d-59fd-9d46-e1fec5643209" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347682}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ae7439d1-42c0-5944-9cc2-0c2fbe360160" :question/math-academy-id "q-78868" :question/problem "What is the center of the hyperbola $\\frac{(y-7)^{2}}{9}-(x+4)^{2}=1?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nNote that the given equation can be rewritten as follows:\n\n$$\n\\frac{(y-7)^{2}}{9}-\\frac{(x-(-4))^{2}}{1}=1\n$$\n\nIn this case, we have $h=-4$ and $k=7.$\n\nTherefore, the center of the hyperbola is $(-4,7).$"}]}
