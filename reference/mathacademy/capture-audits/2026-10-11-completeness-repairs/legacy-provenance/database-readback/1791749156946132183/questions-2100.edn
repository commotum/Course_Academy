db/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395596}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "66873f54-8262-5038-8a99-c1ca86d4153d" :question/math-academy-id "q-99114" :question/problem "Which of the following is the graph of  $y={2}^{x-3}-2?$" :question/worked-solution "To plot the given function, we follow these steps:\n\n- First, we plot the graph of $y={2}^{x}.$\n\n![](images/4f/4fa685525f4f08d801ff25bd0d7dc2ed94ca35b54424531a5a7d5568562234c4.png)\n\n- To plot $y={2}^{x-3},$ we shift the graph of $y={2}^{x}$ horizontally by $3$ units to the right. The $y$-intercept moves from $(0,1)$ to $(3,1),$ but the horizontal asymptote stays at $y=0.$\n\n![](images/3c/3c39774191845f83c6bfc1462771b9122ecde89ae0b33b550603d1d5007095db.png)\n\n- To plot ${2}^{x-3}-2,$ we shift the graph of $y={2}^{x-3}$ vertically by $2$ units down. The point $(3,1)$ moves to $(3,-1)$ and the horizontal asymptote moves from $y=0$ to $y=-2.$\n\n![](images/ff/ff047be1b3289b16e4c64bafe256e42b1deebdd07c24694d0e5bcaba81710826.png)"}] [{:db/id #edb/ref 17592186395602 :knowledge-point/_questions [{:db/id #edb/ref 17592186217152 :knowledge-point/id #uuid "5fa86dd3-3bb3-54d5-8940-5dc07ae4c99f" :knowledge-point/title "Exponential Growth Functions With Horizontal and Vertical Shifts"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae6f22bf-baa7-590b-a966-46ead3e6ca03" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ae/ae3dc56985e60f0f7e87ccfa3d0e1740220f956367915d98dceb5ceae2f6f9c0.png" :db/id #edb/ref 17592186395604} {:answer/id #uuid "f876397d-fb5f-58f2-b586-e9951756cd76" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/4f/4f15654853012441572bbeaa571e06b4252f16567fdf2fd2de07e780d78e313f.png" :db/id #edb/ref 17592186395605} {:answer/id #uuid "efbfe314-5f43-58a3-a49a-084a4815843a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/6c/6c318f5bfa16ce2152d6cc8bc8321ccb0b5bd5d280a3d2ed8195e9a68ad8eaf8.png" :db/id #edb/ref 17592186395606} {:answer/id #uuid "f52be45f-71ce-5c0a-980c-09153bcd905f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ae/ae9e3767f5de41881a728c5b7e3caaf242852e7e92f57ecc949787d6176d10d8.png" :db/id #edb/ref 17592186395607} {:answer/id #uuid "31b0ddaa-fadc-5543-a76d-dd6399c7e5a7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/21/21b54d5a2d87951c298840f99b69f872c64879ad38d7a1ca8736fbbb5aba9c3f.png" :db/id #edb/ref 17592186395608}] :answer-field/correct {:answer/id #uuid "31b0ddaa-fadc-5543-a76d-dd6399c7e5a7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/21/21b54d5a2d87951c298840f99b69f872c64879ad38d7a1ca8736fbbb5aba9c3f.png" :db/id #edb/ref 17592186395608} :answer-field/id #uuid "e292889b-68f9-5688-ac04-95c1887e9aaa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395603}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3e221163-d337-5112-9abe-1a301062750e" :question/math-academy-id "q-99119" :question/problem "Which of the following is the graph of $y={6}^{x-2}+3?$" :question/worked-solution "To plot the given function, we follow these steps:\n\n- First, we plot the graph of $y={6}^{x}.$\n\n![](images/56/565fbb4450ba8feb0b1184cb18442ca00f9ce24d42d3d3243cfcc9aa82b62d23.png)\n\n- To plot $y={6}^{x-2},$ we shift the graph of $y={6}^{x}$ horizontally by $2$ units to the right. The $y$-intercept moves from $(0,1)$ to $(2,1),$ but the horizontal asymptote stays at $y=0.$\n\n![](images/06/0656969561de20752caa691f247f95f1daa743bb8bf167470e98c5d739b82b64.png)\n\n- To plot $y={6}^{x-2}+3,$ we shift the graph of $y={6}^{x-2}$ vertically by $3$ units up. The point $(2,1)$ moves to $(2,4)$ and the horizontal asymptote moves from $y=0$ to $y=3.$\n\n![](images/cf/cf548121c884efcd7a36bc3282ae64d696f9de2da64b954bc2fa962376819477.png)"}] [{:db/id #edb/ref 17592186396237 :knowledge-point/_questions [{:db/id #edb/ref 17592186059849 :knowledge-point/id #uuid "ab642ad6-d9e0-5734-83b4-81627b9132eb" :knowledge-point/title "Solving for an Unknown Given the Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48ffa317-1b68-57e4-8682-58b3f2cf3610" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-2$ and $2$ only" :db/id #edb/ref 17592186396239} {:answer/id #uuid "43dbf530-ae59-578a-b191-6ba7d2edf47b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0$ only" :db/id #edb/ref 17592186396240} {:answer/id #uuid "c1c887a0-8c33-5ac9-b8f5-287ee0622dd9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-2$ and $0$ only" :db/id #edb/ref 17592186396241} {:answer/id #uuid "0a134bc9-3211-56a8-ba64-b5d8b1f67691" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0$ and $2$ only" :db/id #edb/ref 17592186396242} {:answer/id #uuid "c63b5ccb-5750-5b73-bc77-0f7d019725ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-2$ only" :db/id #edb/ref 17592186396243}] :answer-field/correct {:answer/id #uuid "0a134bc9-3211-56a8-ba64-b5d8b1f67691" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0$ and $2$ only" :db/id #edb/ref 17592186396242} :answer-field/id #uuid "0631763f-bf07-54e2-9810-4d0b16208a88" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396238}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "11af43ea-89bf-58ea-b458-4433226aa764" :question/math-academy-id "q-9913" :question/problem "Find the possible values of the constant $k$ given that the matrix  $[\\begin{aligned}k & 0 & 0 \\\\ 0 & 3 & 1 \\\\ 0 & 6 & k\\end{aligned}]$ is singular." :question/worked-solution "First, let's use our formula to find an expression for the determinant in terms of $k:$\n\n$$\n\\begin{aligned}|\\begin{aligned}k & 0 & 0 \\\\ 0 & 3 & 1 \\\\ 0 & 6 & k\\end{aligned}| & =k|\\begin{aligned}3 & 1 \\\\ 6 & k\\end{aligned}|+0|\\begin{aligned}0 & 1 \\\\ 0 & k\\end{aligned}|+0|\\begin{aligned}0 & 3 \\\\ 0 & 6\\end{aligned}| \\\\  & =k(3k-6)+0+0 \\\\  & =k(3k-6)\\end{aligned}\n$$\n\nSince the matrix is singular, the determinant is $0.$ So,  we have:\n\n \n\n$$\n\\begin{aligned}k(3k-6) & =0 \\\\ 3k(k-2) & =0 \\\\ k & =0,2\\end{aligned}\n$$\n\nTherefore, the solutions are $k=0$ and $k=2.$"}] [{:db/id #edb/ref 17592186362355 :knowledge-point/_questions [{:db/id #edb/ref 17592186105849 :knowledge-point/id #uuid "4974097a-95c9-5835-ba1d-46480efab66b" :knowledge-point/title "Computing the Limit at Infinity of a Power Function With an Even Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77040257-dfcd-57ee-adef-b30d8720c7f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186361366} {:answer/id #uuid "9d480512-a430-5168-bbb8-6f7b524ac9a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186361541} {:answer/id #uuid "adc98796-c457-5bfd-aea7-8955623c63fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186361604} {:answer/id #uuid "c65c7ecc-22dc-5be5-9e4e-a8fb9fd39891" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186361734} {:answer/id #uuid "d0b72881-45d9-5283-802c-9ab4aa1511b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186361769}] :answer-field/correct {:answer/id #uuid "77040257-dfcd-57ee-adef-b30d8720c7f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186361366} :answer-field/id #uuid "8e92819f-13f4-5b8a-81f5-2ab190207cd8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362110}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b0160257-6d01-50d3-a643-02b7249aff4d" :question/math-academy-id "q-99275" :question/problem "Find ${lim}_{x\\to \\infty }(8{x}^{12}).$" :question/worked-solution "The graph $y={x}^{12}$ looks similar to an upward parabola, so\n\n$$\n{lim}_{x\\to \\infty }{x}^{12}=\\infty .\n$$\n\nMultiplication by the positive constant $8$ does not affect the limit at infinity. So, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }(8{x}^{12})={lim}_{x\\to \\infty }({x}^{12})=\\infty .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186362357 :knowledge-point/_questions [{:db/id #edb/ref 17592186105857 :knowledge-point/id #uuid "fc04f720-28f3-55ab-8e89-582db57672a4" :knowledge-point/title "Computing the Limit at Infinity of a General Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "080f7f99-7e30-5db1-a311-8dd2bab89a15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186360868} {:answer/id #uuid "3048cc45-930c-59d5-9872-c4f4510b8b64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186361054} {:answer/id #uuid "636a02d1-7a9c-509b-8ecd-ee6f16645c2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186361287} {:answer/id #uuid "b05c4f07-8af8-5005-bdb4-60776213caf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186361619} {:answer/id #uuid "dbcf4636-8858-52ab-84c1-7c4a2c7b2d8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186361818}] :answer-field/correct {:answer/id #uuid "dbcf4636-8858-52ab-84c1-7c4a2c7b2d8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186361818} :answer-field/id #uuid "00522d44-c6e2-512f-9f2e-1c42504d99d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186361979}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f4e88c3a-1837-567e-aaf3-80262168b8a0" :question/math-academy-id "q-99300" :question/problem "Evaluate ${lim}_{t\\to \\infty }{({t}^{2}+1)}^{4}.$" :question/worked-solution "We identify the leading term and compute its limit. In this case, we raise the main term of the base polynomial to the given power.\n\n$$\n\\begin{aligned}{lim}_{t\\to \\infty }({t}^{2}+1)^{4} & ={lim}_{t\\to \\infty }({t}^{2})^{4} \\\\  & ={lim}_{t\\to \\infty }{t}^{8} \\\\  & =\\infty \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186395630 :knowledge-point/_questions [{:db/id #edb/ref 17592186096838 :knowledge-point/id #uuid "53fca396-4ade-5180-9c9b-a73f24f5b5b8" :knowledge-point/title "Integrating a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f9abb18-03db-5798-a0a5-008c413ff8cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨t{e}^{t},\\,-2\\operatorname{cos}⁡2t⟩+C" :db/id #edb/ref 17592186395632} {:answer/id #uuid "cdd0606e-6950-55d9-8f67-97852e598336" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨e,\\,2+\\operatorname{cos}⁡2t⟩+C" :db/id #edb/ref 17592186395633} {:answer/id #uuid "d4c48833-eee2-55d3-871c-819c80a63cec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨{e}^{t},\\,2-\\operatorname{cos}⁡2t⟩+C" :db/id #edb/ref 17592186395634} {:answer/id #uuid "bb4ef401-3b3e-5e40-9514-8b90f315a927" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨{e}^{t},\\,-2\\operatorname{cos}⁡2t⟩+C" :db/id #edb/ref 17592186395635} {:answer/id #uuid "b2f6733e-81a3-5833-bd62-45bba158a64c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨{e}^{t},\\,-2\\operatorname{sin}⁡2t⟩+C" :db/id #edb/ref 17592186395636}] :answer-field/correct {:answer/id #uuid "bb4ef401-3b3e-5e40-9514-8b90f315a927" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨{e}^{t},\\,-2\\operatorname{cos}⁡2t⟩+C" :db/id #edb/ref 17592186395635} :answer-field/id #uuid "2a1dc022-14a7-5d30-8e7e-1cdcc62ca9c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395631}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7f24cce4-3316-593f-909a-7953ae6cdae1" :question/math-academy-id "q-99350" :question/problem "Find $\\int ⟨{e}^{t},\\,4\\operatorname{sin}⁡2t⟩\\,\\text{d}t.$" :question/worked-solution "To integrate a vector-valued function, we integrate each component separately:\n\n$$\n\\begin{aligned}\\int ⟨{e}^{t},\\,4\\operatorname{sin}⁡2t⟩\\text{d}t=⟨\\int {e}^{t}\\,\\text{d}t,\\,\\int 4\\operatorname{sin}⁡2t\\,\\text{d}t⟩.\\end{aligned}\n$$\n\n- For $x(t)={e}^{t},$ we have\n\n$$\n\\begin{aligned}\\int x(t)\\,\\text{d}t=\\int {e}^{t}\\text{d}t={e}^{t}+{c}_{1}.\\end{aligned}\n$$\n\n- For $y(t)=4\\operatorname{sin}⁡2t,$ we calculate its integral using substitution. So, we let $u=2t.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}t}=2\\,⟹\\,\\text{d}t=\\frac{1}{2}\\text{d}u.\n$$\n\nTherefore,  we have\n\n$$\n\\begin{aligned}\\int y(t)\\,\\text{d}t & =\\int 4\\operatorname{sin}⁡2t\\,\\text{d}t \\\\  & =\\int 4\\operatorname{sin}⁡u\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{4}{2}\\int \\operatorname{sin}⁡u\\,\\text{d}u \\\\  & =2(-\\operatorname{cos}⁡u)+{c}_{2} \\\\  & =-2\\operatorname{cos}⁡2t+{c}_{2}.\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}\\int ⟨{e}^{t},\\,4\\operatorname{sin}⁡2t⟩\\text{d}t & =⟨{e}^{t}+{c}_{1},\\,-2\\operatorname{cos}⁡2t+{c}_{2}⟩ \\\\  & =⟨{e}^{t},\\,-2\\operatorname{cos}⁡2t⟩+⟨{c}_{1},\\,{c}_{2}⟩ \\\\  & =⟨{e}^{t},\\,-2\\operatorname{cos}⁡2t⟩+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186395637 :knowledge-point/_questions [{:db/id #edb/ref 17592186096839 :knowledge-point/id #uuid "3081ffe7-c448-5e0d-8dd1-808d23199a7f" :knowledge-point/title "Finding the Definite Integral of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66b455d9-9dcf-5eb5-8c79-f1c4b2c17a8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,\\,\\sqrt{2}⟩" :db/id #edb/ref 17592186395639} {:answer/id #uuid "e94dd2e1-84d5-5f65-9fcb-29972b9c2104" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-2\\sqrt{2},\\,-1⟩" :db/id #edb/ref 17592186395640} {:answer/id #uuid "19fb725c-dfdb-554b-9ee0-5ea47a6fa6d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,\\,1⟩" :db/id #edb/ref 17592186395641} {:answer/id #uuid "4f175d91-95fe-5e94-86f8-2c07fa5e2233" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\sqrt{2},\\,1⟩" :db/id #edb/ref 17592186395642} {:answer/id #uuid "ac22ded7-29b9-55aa-a4fc-490f512ab8f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2\\sqrt{2},\\,-1⟩" :db/id #edb/ref 17592186395643}] :answer-field/correct {:answer/id #uuid "19fb725c-dfdb-554b-9ee0-5ea47a6fa6d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,\\,1⟩" :db/id #edb/ref 17592186395641} :answer-field/id #uuid "734ada2e-fef2-5740-8c5f-7c0d921da24b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395638}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ce4de9d0-a35b-5282-8a54-5ba3b82cc5ab" :question/math-academy-id "q-99366" :question/problem "${\\int }_{0}^{\\pi /4}⟨\\sqrt{2}\\operatorname{cos}⁡t,\\,{sec}^{2}⁡t⟩\\text{d}t=$" :question/worked-solution "To integrate a vector-valued function, we integrate each componentt separately:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /4}⟨\\sqrt{2}\\operatorname{cos}⁡t,\\,{sec}^{2}⁡t⟩\\text{d}t & =⟨{\\int }_{0}^{\\pi /4}\\sqrt{2}\\operatorname{cos}⁡t\\,\\text{d}t,{\\int }_{0}^{\\pi /4}{sec}^{2}⁡t\\,\\text{d}t⟩ \\\\  & =⟨\\sqrt{2}\\operatorname{sin}⁡t\\,\\,{|}_{0}^{\\pi /4},\\,\\operatorname{tan}⁡t\\,\\,{|}_{0}^{\\pi /4}⟩ \\\\  & =⟨\\text{ }\\sqrt{2}\\operatorname{sin}⁡(\\pi /4)-\\sqrt{2}\\operatorname{sin}⁡(0),\\,\\operatorname{tan}⁡(\\pi /4)-\\operatorname{tan}⁡(0)⟩ \\\\  & =⟨\\text{ }\\sqrt{2}\\cdot \\frac{\\sqrt{2}}{2}-0,\\,1-0⟩ \\\\  & =⟨1,\\,1⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186362377 :knowledge-point/_questions [{:db/id #edb/ref 17592186096840 :knowledge-point/id #uuid "8dd18a5b-d7a1-5590-ae70-f47ff5b464b1" :knowledge-point/title "Finding the Antiderivative of a Vector-Valued Function That Satisfies a Given Initial Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f6a92e5-06a3-51e9-8167-edbd52254e35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨{(t-1)}^{4}+1,\\,\\frac{{t}^{4}}{4}-4⟩" :db/id #edb/ref 17592186360970} {:answer/id #uuid "4c699e9a-4c7c-5372-ab41-4ee37a0b5c1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨{t}^{3}+2,\\,{t}^{4}{-}^{2}⟩" :db/id #edb/ref 17592186361168} {:answer/id #uuid "50088413-2b6e-57d5-92e1-38d62697eb1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨{(t-1)}^{3}+1,\\,\\frac{{t}^{5}}{5}-1⟩" :db/id #edb/ref 17592186361189} {:answer/id #uuid "522d7f1c-8ea5-59ac-a6ad-3660e2ebf1aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨{(t-1)}^{3}+1,\\,{t}^{4}-t+1⟩" :db/id #edb/ref 17592186361198} {:answer/id #uuid "e5497629-245f-51c7-91ea-a50b29444551" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨{t}^{3}+1,\\,{t}^{4}-t+1⟩" :db/id #edb/ref 17592186361861}] :answer-field/correct {:answer/id #uuid "522d7f1c-8ea5-59ac-a6ad-3660e2ebf1aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨{(t-1)}^{3}+1,\\,{t}^{4}-t+1⟩" :db/id #edb/ref 17592186361198} :answer-field/id #uuid "9500d5e4-0226-5a18-a04d-62d9f37d571e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362119}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d68c695f-2c41-537c-9ad8-b7156433decc" :question/math-academy-id "q-99517" :question/problem "If ${F}^{′}(t)=⟨3(t-1)^{2},4\\,{t}^{3}-1⟩$ and $F(1)=⟨1,\\,1⟩,$ then $F(t)=$" :question/worked-solution "First, we note that \n\n$$\nF(t)=\\int {F}^{′}(t)\\,\\text{d}t=\\int ⟨3(t-1)^{2},\\,4{t}^{3}-1⟩\\text{d}t\n$$\n\nTo integrate a vector-valued function, we integrate each component separately. So, we have\n\n$$\n\\begin{aligned}\\int ⟨3(t-1)^{2},\\,4{t}^{3}-1⟩\\text{d}t & =⟨\\int 3(t-1)^{2}\\,\\text{d}t,\\int (4{t}^{3}-1)\\text{d}t⟩ \\\\  & =⟨{(t-1)}^{3}+{c}_{1},\\,{t}^{4}-t+{c}_{2}⟩.\\end{aligned}\n$$\n\n  \n\nThe initial condition $F(1)=⟨1,\\,1⟩$ gives \n\n$$\n\\begin{aligned}F(1)=⟨{((1)-1)}^{3}+{c}_{1},\\,(1)^{4}-(1)+{c}_{2}⟩ & =⟨1,\\,1⟩ \\\\ ⟨{c}_{1},\\,{c}_{2}⟩ & =⟨1,\\,1⟩.\\end{aligned}\n$$\n\nTherefore, ${c}_{1}=1$ and ${c}_{2}=1.$ Consequently\n\n$$\nF(t)=⟨{(t-1)}^{3}+1,\\,{t}^{4}-t+1⟩.\n$$"}] [{:db/id #edb/ref 17592186362399 :knowledge-point/_questions [{:db/id #edb/ref 17592186100980 :knowledge-point/id #uuid "c4014376-4dae-56f1-b981-b35d3afab874" :knowledge-point/title "Solving for a Constant Such that the Limit of a Piecewise Function Exists"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34173332-1136-51d2-ad93-db9a5f0081d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186361066} {:answer/id #uuid "39b179d3-adc5-52f1-9971-aeb3689d65e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186361099} {:answer/id #uuid "6fded49b-49d5-5c26-843c-cbd878559ab6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186361333} {:answer/id #uuid "b34e9597-e0e0-563c-8baf-9c56f04d22d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186361634} {:answer/id #uuid "c8a3bfd1-3853-55dd-bb31-f2042e3f4297" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186361743}] :answer-field/correct {:answer/id #uuid "6fded49b-49d5-5c26-843c-cbd878559ab6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186361333} :answer-field/id #uuid "04aab6fa-9c89-5b73-9ae9-58f17e202d24" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186361984}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "91708f0d-366e-5441-a87d-7b80b150a761" :question/math-academy-id "q-99961" :question/problem "For the piecewise function \n\n$$\nf(x)={\\begin{aligned}-x\\, & \\text{ for }\\,x\\le -1 \\\\ x+c\\, & \\text{ for }\\,x>-1\\end{aligned}\n$$\n\nit is known that ${lim}_{x\\to -1}f(x)=1.$ What is the value of the constant $c?$" :question/worked-solution "In order for ${lim}_{x\\to -1}f(x)$ to be equal to $1,$ the left and right-sided limits must both exist and be equal to $1.$\n\n- Approaching from the left, we have $x<-1,$ so we use the expression $f(x)=-x.$ We get \n\n$$\n\\begin{aligned}{lim}_{x\\to (-1)^{-}}f(x) & ={lim}_{x\\to (-1)^{-}}(-x) \\\\  & =-(-1) \\\\  & =1.\\end{aligned}\n$$\n\n- Approaching from the right, we have $x>-1,$ so we use the expression $f(x)=x+c.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to (-1)^{+}}f(x) & ={lim}_{x\\to (-1)^{+}}(x+c) \\\\  & =-1+c.\\end{aligned}\n$$\n\nFinally, since the left and right-sided limits must be equal, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (-1)^{-}}f(x) & ={lim}_{x\\to (-1)^{+}}f(x) \\\\ 1 & =-1+c \\\\ c & =2.\\end{aligned}\n$$"}]}
