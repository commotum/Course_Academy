culty/easy} :question/id #uuid "ea8e67f7-a331-5a5a-8338-679b56a16346" :question/math-academy-id "q-48080" :question/problem "![](images/37/374abcb470bfde0688def89290c8c1d639bf025afde150ccb9dd848c1fcc9a0f.png)\n\nWhat are the points of discontinuity of the function plotted above?" :question/worked-solution "The graph breaks at $x=-2$ and $x=0$ meaning that we can't draw the plot without taking our pencil off of the paper when passing through these points.\n\nTherefore, the correct answer is $x=-2$ and $x=0.$"}] [{:db/id #edb/ref 17592186392615 :knowledge-point/_questions [{:db/id #edb/ref 17592186068695 :knowledge-point/id #uuid "6cd6c125-ecaf-5847-a802-ec1b3594a15c" :knowledge-point/title "Determining Whether a Function Is Continuous at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5cffd7b-e09a-5e8f-9bc6-d30e9bf80623" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c6/c6f0914f0b218164bc99fdefe7d83dffe4591a6b704e2243013d05c2b117ef17.png" :db/id #edb/ref 17592186392617} {:answer/id #uuid "3ba0ee0f-2ced-5835-84e5-0ed53e1549d3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c2/c2f85d1a2becc7bfe6f71d7f6fcb178f4707f4b41956015eabb38610de95feca.png" :db/id #edb/ref 17592186392618} {:answer/id #uuid "d5853982-4adc-5148-b192-1f951c92f732" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/14/14349b3dee80a6d451efedc55b91b5e709139f1a93fabf539d605843513f6141.png" :db/id #edb/ref 17592186392619} {:answer/id #uuid "a3c69f46-c3ba-5974-ae7f-6acba3a9675b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/30/3073f651e0194c8675629f8fc52d45694a64680e3208b8fd7ef066e38d715033.png" :db/id #edb/ref 17592186392620} {:answer/id #uuid "b9c4e630-276e-54fd-922f-6f7389462a61" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c9/c95d9944eb569c36d0b546257b5fde5a2d8c2aa8984eb98d553df832c2b1989f.png" :db/id #edb/ref 17592186392621}] :answer-field/correct {:answer/id #uuid "e5cffd7b-e09a-5e8f-9bc6-d30e9bf80623" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c6/c6f0914f0b218164bc99fdefe7d83dffe4591a6b704e2243013d05c2b117ef17.png" :db/id #edb/ref 17592186392617} :answer-field/id #uuid "9780e3c9-7665-5af4-99ca-1678d1cb66a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392616}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6b614a15-6e39-5d82-8606-db6fffa56cff" :question/math-academy-id "q-48082" :question/problem "Select the function that is continuous at $x=0.$" :question/worked-solution "The correct answer is shown below.  Indeed, despite the fact that the function has a discontinuity at $x=2$, the graph can be drawn in a neighborhood of $x=0$ without taking our pencil off of the paper.\n\n![](images/90/90c2fbe99d0b202e09244084d2501608018e030e6660a225f708cbc6b462dccd.png)\n\n   \n\nAll the other given graphs contain breaks at $x=0$ and it would be impossible to draw them in a neighborhood of $x=0$ without taking the pencil off of the paper."}] [{:db/id #edb/ref 17592186396673 :knowledge-point/_questions [{:db/id #edb/ref 17592186068696 :knowledge-point/id #uuid "31eacf5a-75a5-5b38-8c24-4b1598ecf3a7" :knowledge-point/title "Identifying Points of Discontinuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f8cb089-6505-515d-b264-99e427a1221e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-3$ and $x=0$" :db/id #edb/ref 17592186396675} {:answer/id #uuid "c08b5c35-a5d7-5069-b56f-c620adb60e5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ and $x=2$" :db/id #edb/ref 1759218