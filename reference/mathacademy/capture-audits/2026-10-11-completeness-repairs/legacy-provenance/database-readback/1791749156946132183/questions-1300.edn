 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186327673} {:answer/id #uuid "5c302237-b94a-5fe0-81b1-2587947f173d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e+5" :db/id #edb/ref 17592186327742} {:answer/id #uuid "86671781-4a8f-573e-8fe7-aaff83f7332d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡(5)}{e}+5" :db/id #edb/ref 17592186328093} {:answer/id #uuid "ad75e9f7-6e31-5997-8593-a8ef1838747e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186328440} {:answer/id #uuid "d3b4ca71-189f-58de-8fcc-5367fa284f35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186328793}] :answer-field/correct {:answer/id #uuid "ad75e9f7-6e31-5997-8593-a8ef1838747e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186328440} :answer-field/id #uuid "314cef58-95bb-572e-a378-8e9c798f6f07" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329275}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fb78782d-135f-57ce-a3ed-0b840f2e8d22" :question/math-academy-id "q-48212" :question/problem "Evaluate ${lim}_{x\\to \\infty }(\\operatorname{ln}⁡(5x){e}^{-x}+5).$" :question/worked-solution "Notice that we can rewrite the first term as\n\n$$\n\\operatorname{ln}⁡(5x){e}^{-x}=\\frac{\\operatorname{ln}⁡(5x)}{{e}^{x}}.\n$$\n\nBoth the numerator and denominator approach $\\infty $ as $x\\to \\infty .$ However, since ${e}^{x}≫\\operatorname{ln}⁡(5x)$ for large values of $x,$ the denominator is growing much faster than the numerator. Consequently, we conclude that\n\n$$\n{lim}_{x\\to \\infty }\\frac{\\operatorname{ln}⁡(5x)}{{e}^{x}}=0.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }(\\operatorname{ln}⁡(5x){e}^{-x}+5) & ={lim}_{x\\to \\infty }(\\frac{\\operatorname{ln}⁡(5x)}{{e}^{x}}+5) \\\\  & =0+5 \\\\  & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329877 :knowledge-point/_questions [{:db/id #edb/ref 17592186078617 :knowledge-point/id #uuid "433ac237-32ff-591c-ab0d-e271f5beda30" :knowledge-point/title "Comparing a Polynomial Function and a Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "385935e5-40b2-5cdf-a2a7-ac3e7865d543" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186327426} {:answer/id #uuid "814d202d-efc4-5b86-b450-3050ed558ec6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186328048} {:answer/id #uuid "afe78bc0-6b9b-58bb-a6b3-3d1ea65b8862" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186328457} {:answer/id #uuid "c4ec75bd-d3c7-56b5-bdc5-8279661cd6b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186328661} {:answer/id #uuid "ce0d5a69-6971-5c5e-a390-2198a2dca682" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e" :db/id #edb/ref 17592186328747}] :answer-field/correct {:answer/id #uuid "c4ec75bd-d3c7-56b5-bdc5-8279661cd6b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186328661} :answer-field/id #uuid "cb10680a-018f-52f0-b403-c06d277bbed2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329543}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7379d9b9-6a40-5061-b0c2-16e66