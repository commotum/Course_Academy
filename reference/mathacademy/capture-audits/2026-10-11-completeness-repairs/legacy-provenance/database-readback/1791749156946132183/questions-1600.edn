#{[{:db/id #edb/ref 17592186335997 :knowledge-point/_questions [{:db/id #edb/ref 17592186171957 :knowledge-point/id #uuid "9c976b6a-4523-51e1-a243-27aa8937db25" :knowledge-point/title "Expressing the Relationship Between the Rows of Pascal's Triangle in Terms of Binomial Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b721169-a8ab-596b-9d53-705dd170fa20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{2}{1})" :db/id #edb/ref 17592186333240} {:answer/id #uuid "261e704c-5c81-5e8e-9e2c-39e233a847ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{1}{0})" :db/id #edb/ref 17592186333341} {:answer/id #uuid "2ca9234b-392d-5566-be68-20191fd4b757" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{3}{2})" :db/id #edb/ref 17592186333409} {:answer/id #uuid "4b7ba5f2-3d36-58e7-b87a-f05bac67b549" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{3}{3})" :db/id #edb/ref 17592186333681} {:answer/id #uuid "dc7add29-7727-5c85-b917-5a71d390e52c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{4}{2})" :db/id #edb/ref 17592186334915}] :answer-field/correct {:answer/id #uuid "dc7add29-7727-5c85-b917-5a71d390e52c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{4}{2})" :db/id #edb/ref 17592186334915} :answer-field/id #uuid "2c583ccd-e39b-5f87-b176-cd54f01092c2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335325}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "eb247bc9-e7ac-50b3-bef5-cf1b5de8accd" :question/math-academy-id "q-69726" :question/problem "Which expression is missing in the following equation?\n\n$$\n(\\genfrac{}{}{0pt}{}{5}{3})=[]+(\\genfrac{}{}{0pt}{}{4}{3})\n$$" :question/worked-solution "To find $(\\genfrac{}{}{0pt}{}{5}{3}),$ we need to find the number that is located in row $5$ and position $3$ of Pascal's triangle. \n\n**Important**: When counting the rows and positions in Pascal's triangle, we always start counting from zero! Remember:\n\n- The top row of Pascal's triangle is row $0.$\n\n- The first position of each row (the one of the left) is position number $0.$\n\nThe location of $(\\genfrac{}{}{0pt}{}{5}{3})$ in Pascal's triangle is highlighted below.\n\n$$\n\\begin{aligned} &  &  &  &  &  &  &  & (\\genfrac{}{}{0pt}{}{0}{0}) \\\\  &  &  &  &  &  &  & (\\genfrac{}{}{0pt}{}{1}{0}) &  & (\\genfrac{}{}{0pt}{}{1}{1}) \\\\  &  &  &  &  &  & (\\genfrac{}{}{0pt}{}{2}{0}) &  & (\\genfrac{}{}{0pt}{}{2}{1}) &  & (\\genfrac{}{}{0pt}{}{2}{2}) \\\\  &  &  &  &  & (\\genfrac{}{}{0pt}{}{3}{0}) &  & (\\genfrac{}{}{0pt}{}{3}{1}) &  & (\\genfrac{}{}{0pt}{}{3}{2}) &  & (\\genfrac{}{}{0pt}{}{3}{3}) \\\\  &  &  &  & (\\genfrac{}{}{0pt}{}{4}{0}) &  & (\\genfrac{}{}{0pt}{}{4}{1}) &  & (\\genfrac{}{}{0pt}{}{4}{2}) &  & (\\genfrac{}{}{0pt}{}{4}{3}) &  & (\\genfrac{}{}{0pt}{}{4}{4}) \\\\  &  &  & (\\genfrac{}{}{0pt}{}{5}{0}) &  & (\\genfrac{}{}{0pt}{}{5}{1}) &  & (\\genfrac{}{}{0pt}{}{5}{2}) &  & (\\genfrac{}{}{0pt}{}{5}{3}) &  & (\\genfrac{}{}{0pt}{}{5}{4}) &  & (\\genfrac{}{}{0pt}{}{5}{5}) \\\\  &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nNow, $(\\genfrac{}{}{0pt}{}{5}{3})$ is the sum of the two closest numbers located in the previous row. So,\n\n$$\n(\\genfrac{}{}{0pt}{}{5}{3})=(\\genfrac{}{}{0pt}{}{4}{2})+(\\genfrac{}{}{0pt}{}{4}{3})\n$$\n\nTherefore, the missing expression is $(\\genfrac{}{}{0pt}{}{4}{2}).$"}] [{:db/id #edb/ref 17592186336000 :knowledge-point/_questions [{:db/id #edb/ref 17592186096683 :knowledge-point/id #uuid "7e66d7cf-1a4b-51e6-9c78-f70a8c0555df" :knowledge-point/title "Expressing a Rational Function With Three Linear Factors as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01bb0cfd-f340-5338-b76b-4c4f4ba8b10c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{(x-3)}+\\frac{4}{(x-1)}-\\frac{1}{(x+5)}" :db/id #edb/ref 17592186333004} {:answer/id #uuid "4d39b519-4a7d-516c-8620-3d486078099f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{(x-3)}-\\frac{2}{(x-1)}+\\frac{2}{(x+5)}" :db/id #edb/ref 17592186333700} {:answer/id #uuid "9d0df981-01fe-547e-8f70-3111d540038a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{(x-3)}+\\frac{3}{(x-1)}+\\frac{2}{(x+5)}" :db/id #edb/ref 17592186334373} {:answer/id #uuid "ec73531d-aa85-5b18-ae0d-73c68cc22b08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{(x-3)}+\\frac{2}{(x-1)}-\\frac{1}{(x+5)}" :db/id #edb/ref 17592186335059} {:answer/id #uuid "fdf9ea5e-a5aa-518c-9713-cf0e929dbf1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{(x-3)}-\\frac{2}{(x-1)}-\\frac{1}{(x+5)}" :db/id #edb/ref 17592186335224}] :answer-field/correct {:answer/id #uuid "fdf9ea5e-a5aa-518c-9713-cf0e929dbf1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{(x-3)}-\\frac{2}{(x-1)}-\\frac{1}{(x+5)}" :db/id #edb/ref 17592186335224} :answer-field/id #uuid "557213b3-8872-5c2f-ad92-6742f1eb32b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335407}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cf3dc505-513f-5168-a2c4-4f0ef6cf4f8d" :question/math-academy-id "q-69751" :question/problem "Express $\\frac{12x+12}{(x-3)(x-1)(x+5)}$ as a sum of partial fractions." :question/worked-solution "Our task is to find $A,$ $B$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{12x+12}{(x-3)(x-1)(x+5)} & =\\frac{A}{(x-3)}+\\frac{B}{(x-1)}+\\frac{C}{(x+5)}.\\end{aligned}\n$$\n\nMultiplying both sides by $(x-3)(x-1)(x+5)$ gives\n\n$$\n12x+12=A(x-1)(x+5)+B(x-3)(x+5)+C(x-3)(x-1).\n$$\n\nFor $x=3$, we get \n\n$$\n\\begin{aligned}12(3)+12 & =A(3-1)(3+5) \\\\  & \\,+B(3-3)(3+5) \\\\  & \\,+C(3-3)(3-1) \\\\ 36+12 & =A(2)(8) \\\\ A & =\\frac{48}{16} \\\\ A & =3.\\end{aligned}\n$$\n\nFor $x=1$, we get \n\n$$\n\\begin{aligned}12(1)+12 & =A(1-1)(1+5) \\\\  & \\,+B(1-3)(1+5) \\\\  & \\,+C(1-3)(1-1) \\\\ 12+12 & =B(-2)(6) \\\\ B & =\\frac{24}{-12} \\\\ B & =-2.\\end{aligned}\n$$\n\nFor $x=-5$, we get \n\n$$\n\\begin{aligned}12(-5)+12 & =A(-5-1)(-5+5) \\\\  & \\,+B(-5-3)(-5+5) \\\\  & \\,+C(-5-3)(-5-1) \\\\ -60+12 & =C(-8)(-6) \\\\ C & =\\frac{-48}{48} \\\\ C & =-1.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\frac{12x+12}{(x-3)(x-1)(x+5)}=\\frac{3}{(x-3)}-\\frac{2}{(x-1)}-\\frac{1}{(x+5)}.\n$$"}] [{:db/id #edb/ref 17592186336002 :knowledge-point/_questions [{:db/id #edb/ref 17592186059752 :knowledge-point/id #uuid "1ff88785-9281-5431-86d8-95fd89866787" :knowledge-point/title "Calculating a Minor in a 3x3 Matrix With Variable Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29db2e07-4b6d-54f8-ba95-10bee51c961c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{x}^{2}" :db/id #edb/ref 17592186333378} {:answer/id #uuid "49cfa5a1-6e00-5b05-8d7d-58210b470e27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}" :db/id #edb/ref 17592186333668} {:answer/id #uuid "d05791d8-db4c-54b4-87ee-40f1ccfb77ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-2{y}^{2}" :db/id #edb/ref 17592186334809} {:answer/id #uuid "de3475d0-f75a-5f97-a2bd-86534ad2f83e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}" :db/id #edb/ref 17592186334927} {:answer/id #uuid "e33ee508-1b50-57be-80b5-8cb3e0a56b21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}-2{x}^{2}" :db/id #edb/ref 17592186334968}] :answer-field/correct {:answer/id #uuid "de3475d0-f75a-5f97-a2bd-86534ad2f83e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}" :db/id #edb/ref 17592186334927} :answer-field/id #uuid "854d2d06-6a07-53ba-a693-f3251576dae9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335492}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "63ee1edc-0af6-5ae3-b7c6-a4e20a5d93bd" :question/math-academy-id "q-69760" :question/problem "What is the minor of ${t}_{33}$ in the matrix\n$T=[\\begin{aligned}y-x & x & {y}^{2} \\\\ -x & y+x & 1 \\\\ {x}^{2} & {y}^{2} & {x}^{2}\\end{aligned}]?$" :question/worked-solution "First, we remove the third row and third column:\n\n$$\nT=[\\begin{aligned}y-x & x & ∗ \\\\ -x & y+x & ∗ \\\\ ∗ & ∗ & {x}^{2}\\end{aligned}]\n$$\n\nNext, we calculate the determinant:\n\n$$\n\\begin{aligned}det[\\begin{aligned}y-x & x \\\\ -x & y+x\\end{aligned}] & =|\\begin{aligned}y-x & x \\\\ -x & y+x\\end{aligned}| \\\\  & =(y-x)\\cdot (y+x)-x\\cdot (-x) \\\\  & ={y}^{2}-{x}^{2}+{x}^{2} \\\\  & ={y}^{2}-\\cancel{{x}^{2}}+\\cancel{{x}^{2}} \\\\  & ={y}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186336006 :knowledge-point/_questions [{:db/id #edb/ref 17592186096683 :knowledge-point/id #uuid "7e66d7cf-1a4b-51e6-9c78-f70a8c0555df" :knowledge-point/title "Expressing a Rational Function With Three Linear Factors as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3eb6ce64-206d-5c49-9758-aab85d9dbcfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{(4x-1)}-\\frac{4}{(x+3)}+\\frac{3}{(x+1)}" :db/id #edb/ref 17592186333581} {:answer/id #uuid "4cc83462-f743-5a31-a878-586134f09bdd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{(4x-1)}-\\frac{1}{(x+3)}-\\frac{2}{(x+1)}" :db/id #edb/ref 17592186333696} {:answer/id #uuid "8e45fd15-a700-53e7-af9d-1e68321c0c82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{(4x-1)}-\\frac{6}{(x+3)}+\\frac{3}{(x+1)}" :db/id #edb/ref 17592186334260} {:answer/id #uuid "b1405896-e848-5a48-a42b-fcc5e198319b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{(4x-1)}-\\frac{4}{(x+3)}-\\frac{2}{(x+1)}" :db/id #edb/ref 17592186334545} {:answer/id #uuid "db4473c1-24e2-509c-87f1-abaa53777db0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{(4x-1)}+\\frac{6}{(x+3)}+\\frac{1}{(x+1)}" :db/id #edb/ref 17592186334907}] :answer-field/correct {:answer/id #uuid "3eb6ce64-206d-5c49-9758-aab85d9dbcfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{(4x-1)}-\\frac{4}{(x+3)}+\\frac{3}{(x+1)}" :db/id #edb/ref 17592186333581} :answer-field/id #uuid "20d9cbeb-76f4-5a13-95f0-cb183cadc1c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335300}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fdf4b6e8-9579-5ff0-a940-fe50fbaf31e3" :question/math-academy-id "q-69820" :question/problem "Express $\\frac{-2{x}^{2}+29x+1}{(4x-1)(x+3)(x+1)}$ as a sum of partial fractions." :question/worked-solution "Our task is to find $A,$ $B$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{-2{x}^{2}+29x+1}{(4x-1)(x+3)(x+1)} & =\\frac{A}{(4x-1)}+\\frac{B}{(x+3)}+\\frac{C}{(x+1)}.\\end{aligned}\n$$\n\nMultiplying both sides by $(4x-1)(x+3)(x+1)$ gives\n\n$$\n-2{x}^{2}+29x+1=A(x+3)(x+1)+B(4x-1)(x+1)+C(4x-1)(x+3).\n$$\n\nFor $x=\\frac{1}{4}$, we get \n\n$$\n\\begin{aligned}-2{(\\frac{1}{4})}^{2}+29(\\frac{1}{4})+1 & =A(\\frac{1}{4}+3)(\\frac{1}{4}+1) \\\\  & \\,+B(4(\\frac{1}{4})-1)(\\frac{1}{4}+1) \\\\  & \\,+C(4(\\frac{1}{4})-1)(\\frac{1}{4}+3) \\\\ -\\frac{1}{8}+\\frac{29}{4}+1 & =A(\\frac{65}{16}) \\\\ \\frac{65}{8} & =A(\\frac{65}{16}) \\\\ A & =\\frac{16}{8} \\\\ A & =2.\\end{aligned}\n$$\n\nFor $x=-3$, we get \n\n$$\n\\begin{aligned}-2(-3)^{2}+29(-3)+1 & =A(-3+3)(-3+1) \\\\  & \\,+B(4(-3)-1)(-3+1) \\\\  & \\,+C(4(-3)-1)(-3+3) \\\\ -18-87+1 & =B(-13)(-2) \\\\ B & =\\frac{-104}{26} \\\\ B & =-4.\\end{aligned}\n$$\n\nFor $x=-1$, we get \n\n$$\n\\begin{aligned}-2(-1)^{2}+29(-1)+1 & =A(-1+3)(-1+1) \\\\  & \\,+B(4(-1)-1)(-1+1) \\\\  & \\,+C(4(-1)-1)(-1+3) \\\\ -2-29+1 & =C(-5)(2) \\\\ C & =\\frac{-30}{-10} \\\\ C & =3.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\frac{-2{x}^{2}+29x+1}{(4x-1)(x+3)(x+1)}=\\frac{2}{(4x-1)}-\\frac{4}{(x+3)}+\\frac{3}{(x+1)}.\n$$"}] [{:db/id #edb/ref 17592186336010 :knowledge-point/_questions [{:db/id #edb/ref 17592186105731 :knowledge-point/id #uuid "f7b1b8dc-bb50-59b4-8716-bdd6fbeada4f" :knowledge-point/title "Finding the Angle Between Two Vectors Given Three Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "321940d9-bd6b-529f-b36b-52de6034ea1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{120}^{∘}" :db/id #edb/ref 17592186333452} {:answer/id #uuid "47c034fd-ff2c-563e-807c-0bd209a7f45d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{30}^{∘}" :db/id #edb/ref 17592186333653} {:answer/id #uuid "5d29e042-7c4a-5adf-9528-5bd45b78ba7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{60}^{∘}" :db/id #edb/ref 17592186333842} {:answer/id #uuid "7fc9f4bc-7a23-5d72-9079-6503dce5faa4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{45}^{∘}" :db/id #edb/ref 17592186334126} {:answer/id #uuid "c99908af-2c65-5635-a798-8ecd8753f621" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{90}^{∘}" :db/id #edb/ref 17592186334743}] :answer-field/correct {:answer/id #uuid "7fc9f4bc-7a23-5d72-9079-6503dce5faa4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{45}^{∘}" :db/id #edb/ref 17592186334126} :answer-field/id #uuid "e443c3bb-f95f-5b04-a2c2-a7d665f716b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335635}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1615350f-44ad-5e4b-849c-6c410f4c58d1" :question/math-academy-id "q-69833" :question/problem "Find $∠XZY$ given the points $X(-1,0,3)$, $Y(-2,2,3)$, and $Z(-2,-1,3).$" :question/worked-solution "Note that the position vectors of the points $X$, $Y$, $Z$ are\n\n$$\n\\begin{aligned}x=⟨-1,0,3⟩,\\,y=⟨-2,2,3⟩,\\,z=⟨-2,-1,3⟩.\\end{aligned}\n$$\n\nThe $△XYZ$ is shown (schematically) in the diagram below, where we denote $∠XZY=\\theta .$ \n\n![](images/87/87453fecb9da6b9e673ab5a85a289a3fac73f4fb90fc8f1b33e7c0a80b1ea77f.png)\n\nFirst, we find the components of $\\overset{\\to }{ZX}$ and $\\overset{\\to }{ZY}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{ZX} & =x-z \\\\  & =⟨-1,0,3⟩-⟨-2,-1,3⟩ \\\\  & =⟨1,1,0⟩ \\\\ \\overset{\\to }{ZY} & =y-z \\\\  & =⟨-2,2,3⟩-⟨-2,-1,3⟩ \\\\  & =⟨0,3,0⟩\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overset{\\to }{ZX}$ and $\\overset{\\to }{ZY}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{ZX}\\cdot \\overset{\\to }{ZY}}{|\\overset{\\to }{ZX}||\\overset{\\to }{ZY}|} \\\\  & =\\frac{1\\cdot 0+1\\cdot 3+0\\cdot 0}{\\sqrt{{1}^{2}+{1}^{2}+{0}^{2}}\\sqrt{{0}^{2}+{3}^{2}+{0}^{2}}} \\\\  & =\\frac{3}{\\sqrt{2}\\cdot \\sqrt{9}} \\\\  & =\\frac{1}{\\sqrt{2}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{1}{\\sqrt{2}})={45}^{∘}.\n$$"}] [{:db/id #edb/ref 17592186403335 :knowledge-point/_questions [{:db/id #edb/ref 17592186059848 :knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4785662b-0e80-5d82-a4b6-65ed19a1e5b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186403337} {:answer/id #uuid "67f02759-121c-50a3-ba4c-f3f827ec1037" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186403338} {:answer/id #uuid "2757e4c4-8529-58e9-af0a-851f146d1b34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186403339} {:answer/id #uuid "c536ca24-85a3-52eb-b210-bc09f11e7748" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186403340} {:answer/id #uuid "817109bb-c334-57d7-996b-d026c9e54f89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186403341}] :answer-field/correct {:answer/id #uuid "2757e4c4-8529-58e9-af0a-851f146d1b34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186403339} :answer-field/id #uuid "05d568df-a773-5610-b6f1-a54dd33cdd03" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403336}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0582f249-3bf5-5079-8fe1-8ed6df521a52" :question/math-academy-id "q-69835" :question/problem "Which of the following statements are true regarding the matrix $T$ given below?\n\nI. $T$ is a singular matrix\nII. $det(T)=-3$\nIII. $T$ is **not** a singular matrix\n\n \n\n$$\nT=[\\begin{aligned}4 & 2 & -1 \\\\ 1 & 2 & 3 \\\\ -2 & -1 & 1\\end{aligned}]\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:  \n\n$$\n\\begin{aligned}det(T) & =|\\begin{aligned}4 & 2 & -1 \\\\ 1 & 2 & 3 \\\\ -2 & -1 & 1\\end{aligned}| \\\\  & =4|\\begin{aligned}2 & 3 \\\\ -1 & 1\\end{aligned}|-2|\\begin{aligned}1 & 3 \\\\ -2 & 1\\end{aligned}|-1|\\begin{aligned}1 & 2 \\\\ -2 & -1\\end{aligned}| \\\\  & =4(2+3)-2(1+6)-1(-1+4) \\\\  & =4\\cdot 5-2\\cdot 7-1\\cdot 3 \\\\  & =20-14-3 \\\\  & =3\\end{aligned}\n$$\n\n \n\nSince $det(T)=3\\ne 0$, the matrix is **not** singular. \n\nTherefore, only statement III is true."}] [{:db/id #edb/ref 17592186336013 :knowledge-point/_questions [{:db/id #edb/ref 17592186087839 :knowledge-point/id #uuid "f88c1deb-cd11-5b68-b90b-2d8edfae2469" :knowledge-point/title "Determining the Equation of a Wide Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20394717-12ca-5041-b23f-416aa83995b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{1}+\\frac{{y}^{2}}{3}=1" :db/id #edb/ref 17592186333278} {:answer/id #uuid "45f72ead-a726-5b03-9e54-669f062a7bc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{1}+\\frac{{y}^{2}}{9}=1" :db/id #edb/ref 17592186333636} {:answer/id #uuid "5efc1e85-e466-5527-bfee-b216fc63bee3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{1}=1" :db/id #edb/ref 17592186333854} {:answer/id #uuid "6f183c3b-27ac-5c2a-91b0-f1eac914fd3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{3}+\\frac{{y}^{2}}{1}=1" :db/id #edb/ref 17592186334001} {:answer/id #uuid "7c2e1340-0645-5d50-95ed-65fc11a6a4ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{1}=1" :db/id #edb/ref 17592186334099}] :answer-field/correct {:answer/id #uuid "5efc1e85-e466-5527-bfee-b216fc63bee3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{1}=1" :db/id #edb/ref 17592186333854} :answer-field/id #uuid "2a765e3d-d8c0-512a-9934-b557f6c6eeaf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335316}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e2872275-2ccf-570a-873b-56e8f9665a65" :question/math-academy-id "q-69891" :question/problem "![](images/9e/9eb144bd4109846f3e1af4fb7d8ed70d2d8a29c3804547b89238d6437c4258d8.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=3$ and the vertical radius has length $b=1.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{3}^{2}}+\\frac{{y}^{2}}{{1}^{2}} & =1 \\\\ \\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{1} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186336014 :knowledge-point/_questions [{:db/id #edb/ref 17592186087840 :knowledge-point/id #uuid "de557d1d-5f27-50e3-bcba-22b21f83267f" :knowledge-point/title "Determining the Equation of a Tall Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10b3bb62-33b0-5fec-8deb-ae6cde1bb204" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+\\frac{{y}^{2}}{8}=1" :db/id #edb/ref 17592186333142} {:answer/id #uuid "57b12094-7cc6-57f1-9a04-7d107daa9163" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+\\frac{{y}^{2}}{2}=1" :db/id #edb/ref 17592186333789} {:answer/id #uuid "723d2d46-f03f-5f70-9a86-d1649d7ce1a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2}+{y}^{2}=1" :db/id #edb/ref 17592186334024} {:answer/id #uuid "c1a9b15c-1941-5024-81d9-ee6347a6b3e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+{y}^{2}=1" :db/id #edb/ref 17592186334669} {:answer/id #uuid "ff431699-49d9-55e7-9957-c34cb6f5df16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186335235}] :answer-field/correct {:answer/id #uuid "ff431699-49d9-55e7-9957-c34cb6f5df16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186335235} :answer-field/id #uuid "bfa364a8-de07-5a0a-aec8-fc0fb7bebdf9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335590}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "daa08063-18f2-5c3f-bfa5-03e9e47d2153" :question/math-academy-id "q-69892" :question/problem "![](images/1a/1acc2d6b8387947ff7186322796e273bcec366810ad73ac0025494ab627e06b2.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=1$ and the vertical radius has length $b=2.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{1}^{2}}+\\frac{{y}^{2}}{{2}^{2}} & =1 \\\\ {x}^{2}+\\frac{{y}^{2}}{4} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186336015 :knowledge-point/_questions [{:db/id #edb/ref 17592186087840 :knowledge-point/id #uuid "de557d1d-5f27-50e3-bcba-22b21f83267f" :knowledge-point/title "Determining the Equation of a Tall Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01216287-0f50-583c-9086-c9c0e4cc5138" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{25}=1" :db/id #edb/ref 17592186332999} {:answer/id #uuid "308f5905-a1ef-5cd4-bcbf-93f14e467471" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{25}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186333438} {:answer/id #uuid "853926c0-f101-5e2d-baf4-3a46b814eb53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2}+\\frac{{y}^{2}}{5}=1" :db/id #edb/ref 17592186334174} {:answer/id #uuid "8ca9f7c3-1c08-5f19-869f-2b8bb488f6c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{5}+\\frac{{y}^{2}}{2}=1" :db/id #edb/ref 17592186334242} {:answer/id #uuid "e9a37e6e-54ed-5aa9-98f6-bcb6e68f2dab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{10}=1" :db/id #edb/ref 17592186335034}] :answer-field/correct {:answer/id #uuid "01216287-0f50-583c-9086-c9c0e4cc5138" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{25}=1" :db/id #edb/ref 17592186332999} :answer-field/id #uuid "34c562ed-e50c-5f34-9608-c043330e7886" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335341}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cc59b788-b5c5-5dc7-bac3-9ab39eac60d6" :question/math-academy-id "q-69893" :question/problem "![](images/be/be8468d84e3820bd1e9181d31aa3a1b7d1a85c743020a69cb67fc3f601a88363.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=2$ and the vertical radius has length $b=5.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{2}^{2}}+\\frac{{y}^{2}}{{5}^{2}} & =1 \\\\ \\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{25} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186336017 :knowledge-point/_questions [{:db/id #edb/ref 17592186179649 :knowledge-point/id #uuid "3db20b82-9561-5c54-8e12-8914bb6747c3" :knowledge-point/title "Adding and Subtracting Rational Expressions With No Common Factors in the Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0703c3c1-459d-50d7-ae97-4466396092e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{x(1+z)}" :db/id #edb/ref 17592186333057} {:answer/id #uuid "3334b96f-93c5-5446-89b4-8c611161320e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3-x}{3x(1+z)}" :db/id #edb/ref 17592186333462} {:answer/id #uuid "5f927104-1757-5d9a-893b-46eec86e0319" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6x(1+z)}" :db/id #edb/ref 17592186333860} {:answer/id #uuid "8dfe0c6a-6bfb-5c98-ab01-cb0ded3487dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{6(1+z)}" :db/id #edb/ref 17592186334255} {:answer/id #uuid "ba2ce306-4a2c-5866-8f62-5a669e403864" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6+x}{3x(1+z)}" :db/id #edb/ref 17592186334615}] :answer-field/correct {:answer/id #uuid "ba2ce306-4a2c-5866-8f62-5a669e403864" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6+x}{3x(1+z)}" :db/id #edb/ref 17592186334615} :answer-field/id #uuid "73717a39-fe43-53a9-bb55-c55faa6dd3e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335460}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "45828168-91a4-5191-ae19-572992805b62" :question/math-academy-id "q-69903" :question/problem "$\\frac{2}{x(1+z)}+\\frac{1}{3(1+z)}=$" :question/worked-solution "In this case, we need to put the fractions over a common denominator of $3x(1+z),$ since there are no common factors in either denominator that we can exploit.\n\nTo do this, we multiply the top and bottom of the first fraction by $3$, and the top and bottom of the second fraction by $x:$\n\n$$\n\\begin{aligned}\\frac{2}{x(1+z)}+\\frac{1}{3(1+z)} & = \\\\ \\frac{3}{3}\\cdot \\frac{2}{x(1+z)}+\\frac{x}{x}\\cdot \\frac{1}{3(1+z)} & = \\\\ \\frac{6}{3x(1+z)}+\\frac{x}{3x(1+z)} & = \\\\ \\frac{6+x}{3x(1+z)} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069500 :knowledge-point/_questions [{:db/id #edb/ref 17592186068759 :knowledge-point/id #uuid "f149f8ef-dd7f-5f65-928e-534e1541f9b2" :knowledge-point/title "Dividing Rational Expressions with a Single Common Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24bbde06-85b1-5835-9118-e127a4019b04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7b}{5}" :db/id #edb/ref 17592186333330} {:answer/id #uuid "42fbbef0-4b70-5b42-8357-7aecc460bb5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{35b}{2}" :db/id #edb/ref 17592186333613} {:answer/id #uuid "4bb39d13-026c-54ab-86bc-606fda5a4191" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{35}{2}" :db/id #edb/ref 17592186333683} {:answer/id #uuid "d4b44540-ed26-5dc1-8ff7-01bb46c12f1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5b}{7}" :db/id #edb/ref 17592186334852} {:answer/id #uuid "e320734a-e597-5264-b68c-21d22b8f7138" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{35{b}^{2}}{2}" :db/id #edb/ref 17592186334965}] :answer-field/correct {:answer/id #uuid "42fbbef0-4b70-5b42-8357-7aecc460bb5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{35b}{2}" :db/id #edb/ref 17592186333613} :answer-field/id #uuid "e7f3ec3c-3fa1-5f9e-863c-f9a4e8ad93d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335642}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "17f8926a-edda-5159-87e5-d53ce755ff9a" :question/math-academy-id "q-69924" :question/problem "$\\frac{5{b}^{2}}{2}÷\\frac{b}{7}=$" :question/worked-solution "To compute\n\n$$\n\\frac{5{b}^{2}}{2}÷\\frac{b}{7},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{5{b}^{2}}{2}÷\\frac{b}{7} & = \\\\ \\frac{5{b}^{2}}{2}\\cdot \\frac{7}{b} & = \\\\ \\frac{35{b}^{2}}{2b} & = \\\\ \\frac{35{b}^{\\cancel{2}}}{2\\cancel{b}} & = \\\\ \\frac{35b}{2} & \\end{aligned}\n$$\n\nNote that in the final step, we canceled out a common factor of $b$ in the numerator and denominator."}] [{:db/id #edb/ref 17592186336022 :knowledge-point/_questions [{:db/id #edb/ref 17592186100879 :knowledge-point/id #uuid "0272b8d6-8400-5a6d-b51d-fc6ca84bd166" :knowledge-point/title "Calculating the Area of the Parallelogram Spanned by Two Parallel Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "474d82fd-4c67-54d6-8d3f-40eb39058824" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}+3" :db/id #edb/ref 17592186333646} {:answer/id #uuid "49db276c-4bf9-5c1e-9330-90217989e008" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt{5}" :db/id #edb/ref 17592186333669} {:answer/id #uuid "696b517e-5aa5-5f77-b932-9cc47db196e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186333953} {:answer/id #uuid "965585a1-1920-5fe4-a63d-71b477e8389e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186334327} {:answer/id #uuid "c9515ac2-b691-57ca-b9cc-54080af888f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{5}" :db/id #edb/ref 17592186334739}] :answer-field/correct {:answer/id #uuid "696b517e-5aa5-5f77-b932-9cc47db196e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186333953} :answer-field/id #uuid "dd1cf5aa-9059-5a91-8014-fa9172134ff5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335629}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2ec973be-811c-5c98-ab7e-a27196c22154" :question/math-academy-id "q-69941" :question/problem "Calculate the area of the parallelogram spanned by $\\text{u}=[\\begin{aligned}3 \\\\ 0\\end{aligned}]$ and $\\text{v}=[\\begin{aligned}\\frac{\\sqrt{5}}{3} \\\\ 0\\end{aligned}].$" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}3 & \\frac{\\sqrt{5}}{3} \\\\ 0 & 0\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}3 & \\frac{\\sqrt{5}}{3} \\\\ 0 & 0\\end{aligned}| \\\\  & =3\\cdot 0-\\frac{\\sqrt{5}}{3}\\cdot 0 \\\\  & =0\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|\\,0\\,|=0\n$$"}] [{:db/id #edb/ref 17592186336023 :knowledge-point/_questions [{:db/id #edb/ref 17592186100879 :knowledge-point/id #uuid "0272b8d6-8400-5a6d-b51d-fc6ca84bd166" :knowledge-point/title "Calculating the Area of the Parallelogram Spanned by Two Parallel Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14b2d06b-3284-5a66-b19f-0ef1487efd55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186333169} {:answer/id #uuid "59481f19-f93f-54e7-a387-8489d37d3666" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186333807} {:answer/id #uuid "721fbb4a-b7a4-57c9-85d5-fcb362a99666" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186334022} {:answer/id #uuid "bea8278f-ff07-5579-807d-e7f81a1533c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186334640} {:answer/id #uuid "cc1fb416-02c1-53e8-b9db-4fbb6440bf06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186334769}] :answer-field/correct {:answer/id #uuid "cc1fb416-02c1-53e8-b9db-4fbb6440bf06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186334769} :answer-field/id #uuid "fe804b3c-eb9b-5f42-827e-0f83f2544867" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335685}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a101db17-b08e-5c17-8786-6539ae6cbc0e" :question/math-academy-id "q-69943" :question/problem "Calculate the area of the parallelogram spanned by $\\text{u}=[\\begin{aligned}4 \\\\ \\frac{1}{3}\\end{aligned}]$ and $\\text{v}=[\\begin{aligned}6 \\\\ \\frac{1}{2}\\end{aligned}].$" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}4 & 6 \\\\ \\frac{1}{3} & \\frac{1}{2}\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}4 & 6 \\\\ \\frac{1}{3} & \\frac{1}{2}\\end{aligned}| \\\\  & =4\\cdot \\frac{1}{2}-6\\cdot \\frac{1}{3} \\\\  & =2-2 \\\\  & =0\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|\\,0\\,|=0\n$$"}] [{:db/id #edb/ref 17592186336024 :knowledge-point/_questions [{:db/id #edb/ref 17592186100879 :knowledge-point/id #uuid "0272b8d6-8400-5a6d-b51d-fc6ca84bd166" :knowledge-point/title "Calculating the Area of the Parallelogram Spanned by Two Parallel Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07d0c55c-300e-541b-9c31-0795f27c6911" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186333065} {:answer/id #uuid "723312a8-cb00-5166-9da5-9ccb03edca58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186334023} {:answer/id #uuid "791da30c-20af-5d83-b23a-e51fad1056b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186334077} {:answer/id #uuid "acfdc006-65c8-5dc9-a413-a8865a1fa6ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186334511} {:answer/id #uuid "ff177131-3521-57ad-889d-79da13e8ee08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186335233}] :answer-field/correct {:answer/id #uuid "791da30c-20af-5d83-b23a-e51fad1056b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186334077} :answer-field/id #uuid "58998a66-3732-5515-a658-7040cd93b92f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335415}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "92767c82-7016-540a-a963-df010d8da1b2" :question/math-academy-id "q-69945" :question/problem "Calculate the area of the parallelogram spanned by $\\text{u}=⟨-1,-2⟩$ and $\\text{v}=⟨3,6⟩.$" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}-1 & 3 \\\\ -2 & 6\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}-1 & 3 \\\\ -2 & 6\\end{aligned}| \\\\  & =(-1)\\cdot 6-3\\cdot (-2) \\\\  & =-6+6 \\\\  & =0\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|\\,0\\,|=0\n$$"}] [{:db/id #edb/ref 17592186336028 :knowledge-point/_questions [{:db/id #edb/ref 17592186087720 :knowledge-point/id #uuid "4d1ea5c4-2700-5c03-a22e-de5439f47c36" :knowledge-point/title "Expressing a Quotient of Complex Numbers in Polar Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b94c9b6-5a65-514c-8c57-8a32c5352b1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{5}}{5}(\\operatorname{cos}⁡(5.381)+\\text{i}\\operatorname{sin}⁡(5.381))" :db/id #edb/ref 17592186333682} {:answer/id #uuid "61306afb-39b1-55fe-940d-c895a219866a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{5}}{5}(\\operatorname{cos}⁡(5.176)+\\text{i}\\operatorname{sin}⁡(5.176))" :db/id #edb/ref 17592186333873} {:answer/id #uuid "96c4c078-1d80-57b1-a631-8e1db6092f4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{5}(\\operatorname{cos}⁡(4.381)+\\text{i}\\operatorname{sin}⁡(4.381))" :db/id #edb/ref 17592186334332} {:answer/id #uuid "c496a847-8027-5fcd-afe4-d23fd213b900" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{5}(\\operatorname{cos}⁡(3.107)+\\text{i}\\operatorname{sin}⁡(3.107))" :db/id #edb/ref 17592186334693} {:answer/id #uuid "cd5f1dfc-0f11-5087-ab8d-bd8e85c01e76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}(\\operatorname{cos}⁡(4.914)+\\text{i}\\operatorname{sin}⁡(4.914))" :db/id #edb/ref 17592186334782}] :answer-field/correct {:answer/id #uuid "61306afb-39b1-55fe-940d-c895a219866a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{5}}{5}(\\operatorname{cos}⁡(5.176)+\\text{i}\\operatorname{sin}⁡(5.176))" :db/id #edb/ref 17592186333873} :answer-field/id #uuid "9159f624-aea2-5058-8642-6d5fa9463a5f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335515}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2ba9feb4-93ae-58b8-887d-a3260d202f9b" :question/math-academy-id "q-69966" :question/problem "Express $z=\\frac{4}{1+2\\text{i}}$ in the form $r(\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta ).$ Give $\\theta $ in radians to three decimal places." :question/worked-solution "First, we express the given complex number in the form $z=x+y\\text{i}.$ To do this, we remove $\\text{i}$ from the denominator by multiplying the numerator and denominator of $z$ by the complex conjugate of the denominator, which is $1-2\\text{i}:$\n\n$$\n\\begin{aligned}z & =\\frac{4}{1+2\\text{i}} \\\\  & =\\frac{4(1-2\\text{i})}{(1+2\\text{i})(1-2\\text{i})} \\\\  & =\\frac{4(1-2\\text{i})}{{1}^{2}-(2\\text{i})^{2}} \\\\  & =\\frac{4(1-2\\text{i})}{1+4} \\\\  & =\\frac{4}{5}-\\frac{8}{5}\\text{i}.\\end{aligned}\n$$\n\nIn polar form, $r$ represents the magnitude $|z|.$ For a complex number $z=x+y\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{x}^{2}+{y}^{2}}.\n$$\n\nSo, for $z=\\frac{4}{5}-\\frac{8}{5}\\text{i},$ the magnitude is\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{(\\frac{4}{5})}^{2}+{(-\\frac{8}{5})}^{2}} \\\\  & =\\sqrt{\\frac{{4}^{2}+{8}^{2}}{{5}^{2}}} \\\\  & =\\sqrt{\\frac{80}{25}} \\\\  & =\\sqrt{\\frac{16\\cdot 5}{25}} \\\\  & =\\frac{4\\sqrt{5}}{5}.\\end{aligned}\n$$\n\nIn polar form, $\\theta $  represents the argument $\\operatorname{arg}⁡(z).$ Since $x=\\frac{4}{5}$ is positive and $y=-\\frac{8}{5}$ is negative, $z$ lies in the fourth quadrant. So, we can find $\\theta $ as follows:\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =2\\pi -\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =2\\pi -\\operatorname{arctan}⁡|\\frac{(-\\frac{8}{5})}{(\\frac{4}{5})}| \\\\  & =2\\pi -\\operatorname{arctan}⁡2 \\\\  & ≈5.176,\\end{aligned}\n$$\n\nrounded to three decimal places. \n\nFinally, we write the complex number $z$ in polar form:\n\n$$\nz=\\frac{4\\sqrt{5}}{5}(\\operatorname{cos}⁡(5.176)+\\text{i}\\operatorname{sin}⁡(5.176)).\n$$"}] [{:db/id #edb/ref 17592186172597 :knowledge-point/_questions [{:db/id #edb/ref 17592186171958 :knowledge-point/id #uuid "e5c108c0-f32a-5725-af3b-c3e747da09f2" :knowledge-point/title "Calculating Binomial Coefficients Using the Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3618fd79-f0c1-53a0-b20b-bf0280ed08cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186336534} {:answer/id #uuid "36ae7c44-7232-5952-b259-bdaf331f39df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186336539} {:answer/id #uuid "3bf072b8-b834-5e0d-9291-5d6fb97a7eaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186336595} {:answer/id #uuid "51c40090-fd0a-51ec-8b6e-5b7aa442897d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186336782} {:answer/id #uuid "c4a10ed2-5449-5a0c-843f-2dc2c8a063ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186337780}] :answer-field/correct {:answer/id #uuid "3618fd79-f0c1-53a0-b20b-bf0280ed08cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186336534} :answer-field/id #uuid "19882423-8f67-5d12-b858-160ced9098e3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338320}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d568b68b-4ef8-5cbc-887c-db423254aeb5" :question/math-academy-id "q-69994" :question/problem "Determine the value of $(\\genfrac{}{}{0pt}{}{4}{2}).$" :question/worked-solution "The binomial coefficient $(\\genfrac{}{}{0pt}{}{n}{r})$ is given by the formula\n\n$$\n(\\genfrac{}{}{0pt}{}{n}{r})=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nIn this case, we have $n=4$ and $r=2.$ Therefore,\n\n$$\n\\begin{aligned}(\\genfrac{}{}{0pt}{}{4}{2}) & =\\frac{4!}{(4-2)!\\cdot 2!} \\\\  & =\\frac{4\\cdot 3\\cdot 2!}{2!\\cdot 2!} \\\\  & =\\frac{4\\cdot 3\\cdot \\cancel{2!}}{2\\cdot \\cancel{2!}} \\\\  & =\\frac{12}{2} \\\\  & =6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338755 :knowledge-point/_questions [{:db/id #edb/ref 17592186179648 :knowledge-point/id #uuid "63080bb8-7a6a-505d-813a-e6c99d337064" :knowledge-point/title "Adding and Subtracting a Number and a Rational Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5814e0b7-0ac9-59db-960b-eb5c79335b2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2-x}{1-x}" :db/id #edb/ref 17592186336839} {:answer/id #uuid "74309adc-6c11-5cfd-a570-a95cbfdb9eb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+2x}{1-x}" :db/id #edb/ref 17592186337076} {:answer/id #uuid "9fd9e3ae-b8c4-5c59-a1b5-25bfd718f1c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3+x}{x-1}" :db/id #edb/ref 17592186337478} {:answer/id #uuid "da8b81fd-0d53-5cbf-b83c-fadc867edb5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3-2x}{x-1}" :db/id #edb/ref 17592186337934} {:answer/id #uuid "dcb9177f-5ce8-5398-8896-38d38de967f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5-3x}{1-x}" :db/id #edb/ref 17592186337951}] :answer-field/correct {:answer/id #uuid "dcb9177f-5ce8-5398-8896-38d38de967f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5-3x}{1-x}" :db/id #edb/ref 17592186337951} :answer-field/id #uuid "600ab3ea-f61f-50d6-bb10-99d9f1f962c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338444}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6cd17734-31bb-55e9-99cc-517d86a68855" :question/math-academy-id "q-70147" :question/problem "Write $2+\\frac{3-x}{1-x}$ as a single fraction." :question/worked-solution "Using the fact that $2=\\frac{2}{1},$ we can write the expression as\n\n$$\n\\frac{2}{1}+\\frac{3-x}{1-x}.\n$$\n\n \n\nIn order to add the two fractions, we need them to have a common denominator. So, we put both fractions over a common denominator of $1-x$ by multiplying the top and bottom of the first fraction by $1-x:$\n\n$$\n\\begin{aligned}\\frac{2}{1}+\\frac{3-x}{1-x} & = \\\\ \\frac{1-x}{1-x}\\cdot \\frac{2}{1}+\\frac{3-x}{1-x} & = \\\\ \\frac{2(1-x)}{1-x}+\\frac{3-x}{1-x} & \\end{aligned}\n$$\n\nFinally, we add the fractions and simplify the result:\n\n$$\n\\begin{aligned}\\frac{2(1-x)}{1-x}+\\frac{3-x}{1-x} & = \\\\ \\frac{2(1-x)+(3-x)}{1-x} & = \\\\ \\frac{2-2x+3-x}{1-x} & = \\\\ \\frac{5-3x}{1-x}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186235581 :knowledge-point/_questions [{:db/id #edb/ref 17592186235285 :knowledge-point/id #uuid "58a49d00-cc58-5228-af38-9369cf31d8c8" :knowledge-point/title "Finding a Scalar Factor When Direction Reverses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "202648e4-1ed8-51ca-8741-ad33c02bbbbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.5" :db/id #edb/ref 17592186234597} {:answer/id #uuid "28fcad39-0558-51c0-81b5-8737afc77511" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1.5" :db/id #edb/ref 17592186234609} {:answer/id #uuid "c93d8a53-26a7-5744-b10b-5b8f0da3c405" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2.5" :db/id #edb/ref 17592186234861} {:answer/id #uuid "da616d4e-0a1e-55df-a589-db736030d4b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186234889} {:answer/id #uuid "e79cd088-e254-50a4-9040-d34103eae50a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186234910}] :answer-field/correct {:answer/id #uuid "c93d8a53-26a7-5744-b10b-5b8f0da3c405" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2.5" :db/id #edb/ref 17592186234861} :answer-field/id #uuid "9706ed72-1b58-5bbe-8976-330e0740d99e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186235155}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a9d1dc6a-3cc4-5a49-870f-4f180b06cd63" :question/math-academy-id "q-70148" :question/problem "![](images/d3/d3f77b108decdfe95fe06d1ace87ee7f844a4f937f8b67a9f14e750a09ae4d57.png)\n\nConsider the picture above. Given that $c=\\lambda a-b,$ find $\\lambda .$" :question/worked-solution "To find $\\lambda ,$ we want to match the expression\n\n$$\nc=\\lambda a-b.\n$$\n\nWe are given that one of the components is $-b.$ So, we first draw the vector $-b$ from the origin. Then we complete the path to the point $C.$\n\n![](images/7f/7f29124776f69f370b3129313fd1c2fa850924f446c6f086dcacd170f1ca6d24.png)\n\nLet $P$ be the endpoint of the vector $-b.$ Then\n\n$$\nc=\\overset{\\to }{OP}+\\overset{\\to }{PC}.\n$$\n\nIn $△OPC,$ we have:\n\n- $PC=2.5|a|$\n\n- $\\overset{\\to }{PC}$ and $a$ have opposite directions\n\nHence, $\\overset{\\to }{PC}=-2.5a.$\n\nAdditionally,\n\n$$\n\\begin{aligned}c & =\\overset{\\to }{OP}+\\overset{\\to }{PC} \\\\  & =-b-2.5a.\\end{aligned}\n$$\n\nConsequently, $c=\\lambda a-b=-2.5a-b.$\n\nSince $a∦b,$ the linear combination can only be written in one way. Equating the coefficients of $a,$ we get:\n\n$$\n\\lambda =-2.5\n$$"}] [{:db/id #edb/ref 17592186403342 :knowledge-point/_questions [{:db/id #edb/ref 17592186087724 :knowledge-point/id #uuid "6381faa4-5dfd-58fa-ace7-411fd2a97e98" :knowledge-point/title "Calculating the x-Intercepts of an Ellipse By Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c1bbae5-ee9d-5107-904f-6970a8ac3118" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\pm 6\\sqrt{2},0)" :db/id #edb/ref 17592186403344} {:answer/id #uuid "8465821e-9ea7-5368-9666-8f226d3419ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There is no $x$-intercept" :db/id #edb/ref 17592186403345} {:answer/id #uuid "25ff9425-9a2f-590b-afc0-b4d1c3a9a722" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2-6\\sqrt{2},0)" :db/id #edb/ref 17592186403346} {:answer/id #uuid "ce1f047f-812c-57ba-bcb0-cbcaa0662d30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-6\\sqrt{2},0)" :db/id #edb/ref 17592186403347} {:answer/id #uuid "fd29b37b-8dc3-5dc5-a940-4e57bf4082c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2\\pm 6\\sqrt{2},0)" :db/id #edb/ref 17592186403348}] :answer-field/correct {:answer/id #uuid "8465821e-9ea7-5368-9666-8f226d3419ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There is no $x$-intercept" :db/id #edb/ref 17592186403345} :answer-field/id #uuid "9e096da9-0f95-5ade-b790-a678ba6390cc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403343}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "59316311-32d9-5b38-a573-15e21c936803" :question/math-academy-id "q-70184" :question/problem "Calculate the points where the ellipse ${x}^{2}+9{y}^{2}+4x+54y+76=0$ intercepts the $x$-axis." :question/worked-solution "To calculate the $x$-intercepts, we need to substitute $y=0$ into the equation of the ellipse and solve the resulting equation for $x.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}{x}^{2}+9{y}^{2}+4x+54y+76 & =0 \\\\ {x}^{2}+9\\cdot {0}^{2}+4x+54\\cdot 0+76 & =0 \\\\ {x}^{2}+4x+76 & =0 \\\\ (x+2)^{2}-4+76 & =0 \\\\ (x+2)^{2}+72 & =0 \\\\ (x+2)^{2} & =-72.\\end{aligned}\n$$\n\nSince $(x+2)^{2}\\ge 0$, there is no $x$ such that $(x+2)^{2}=-72.$ Therefore, the ellipse has no $x$-intercepts, meaning that it does not intercept the $x$-axis at any point."}] [{:db/id #edb/ref 17592186392980 :knowledge-point/_questions [{:db/id #edb/ref 17592186100867 :knowledge-point/id #uuid "3beceaa9-f8b5-5b98-a4a3-2ececba067e0" :knowledge-point/title "Multiplying a 3x3 Matrix by a Column Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e8178ab3-c9f7-5d8c-8117-4f1f74b1ab49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 \\\\ 17 \\\\ -16\\end{aligned}]" :db/id #edb/ref 17592186392982} {:answer/id #uuid "410ab9be-7cc7-54f3-a784-da1b9a30bfde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 \\\\ 17 \\\\ 16\\end{aligned}]" :db/id #edb/ref 17592186392983} {:answer/id #uuid "40de1131-c500-5140-8c7e-271d3572a65b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 \\\\ -17 \\\\ -16\\end{aligned}]" :db/id #edb/ref 17592186392984} {:answer/id #uuid "2a7cd954-5b67-5cac-8093-3f7017db6934" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 \\\\ 17 \\\\ -16\\end{aligned}]" :db/id #edb/ref 17592186392985} {:answer/id #uuid "75a2f729-1c8d-5690-ae16-63c6281a2c59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 \\\\ -17 \\\\ -16\\end{aligned}]" :db/id #edb/ref 17592186392986}] :answer-field/correct {:answer/id #uuid "e8178ab3-c9f7-5d8c-8117-4f1f74b1ab49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 \\\\ 17 \\\\ -16\\end{aligned}]" :db/id #edb/ref 17592186392982} :answer-field/id #uuid "288f911c-4b7f-5104-b845-ad8fb1649020" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392981}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "91918c10-0bb0-5694-a610-fb8455554519" :question/math-academy-id "q-70190" :question/problem "Find $Lz$ if \n$L=[\\begin{aligned}1 & 0 & 4 \\\\ 1 & 3 & -2 \\\\ 2 & 0 & -5\\end{aligned}]$\nand\n$z=[\\begin{aligned}-3 \\\\ 8 \\\\ 2\\end{aligned}].$" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product:\n\n$$\n\\begin{aligned}Lz & =[\\begin{aligned}1 & 0 & 4 \\\\ 1 & 3 & -2 \\\\ 2 & 0 & -5\\end{aligned}][\\begin{aligned}-3 \\\\ 8 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}1\\cdot (-3)+0\\cdot 8+4\\cdot 2 \\\\ 1\\cdot (-3)+3\\cdot 8+(-2)\\cdot 2 \\\\ 2\\cdot (-3)+0\\cdot 8+(-5)\\cdot 2\\end{aligned}] \\\\  & =[\\begin{aligned}-3+0+8 \\\\ -3+24-4 \\\\ -6+0-10\\end{aligned}] \\\\  & =[\\begin{aligned}5 \\\\ 17 \\\\ -16\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338760 :knowledge-point/_questions [{:db/id #edb/ref 17592186059800 :knowledge-point/id #uuid "a827b0d0-faa2-521f-b166-e13873b1da00" :knowledge-point/title "Finding an Entry of the Product of Two Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19fe701a-247d-5d86-9db0-38387dc81bc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186336272} {:answer/id #uuid "1c04f170-66ce-5cab-ac19-815547c98051" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186336294} {:answer/id #uuid "700df25f-bddf-598d-8139-fa9f31d68d71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186337025} {:answer/id #uuid "90b02077-646f-592c-b648-7044d4e3acbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186337345} {:answer/id #uuid "c0da2936-a49d-5ded-8eb9-ed2fe5657444" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186337744}] :answer-field/correct {:answer/id #uuid "19fe701a-247d-5d86-9db0-38387dc81bc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186336272} :answer-field/id #uuid "d5785910-958c-59d0-876f-2c3067bdb107" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338652}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bc5ecc6b-0e22-5096-9770-11e967093ff4" :question/math-academy-id "q-70194" :question/problem "Let $F=GH.$ What is the value of ${f}_{12}$, if\n\n$$\nG=[\\begin{aligned}2 & 3 \\\\ 4 & -2\\end{aligned}],\\,H=[\\begin{aligned}-1 & 3 \\\\ 6 & 5\\end{aligned}]?\n$$" :question/worked-solution "Multiplying the $1$st row in $G$ by the $2$nd column in $H$, we get\n\n$$\n\\begin{aligned}{f}_{12} & =[\\begin{aligned}2 & 3\\end{aligned}][\\begin{aligned}3 \\\\ 5\\end{aligned}] \\\\  & =2\\cdot 3+3\\cdot 5 \\\\  & =6+15 \\\\  & =21.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338768 :knowledge-point/_questions [{:db/id #edb/ref 17592186078415 :knowledge-point/id #uuid "15cd299b-c720-5bf6-814c-2bef2c839e48" :knowledge-point/title "Finding the Inverse of a Linear Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38d74e2a-5c9e-5968-8c1b-e26086ff083a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{-x+5}{4}" :db/id #edb/ref 17592186336563} {:answer/id #uuid "4005f56c-d613-5bab-b96d-45434786ce9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=-5x+4" :db/id #edb/ref 17592186336635} {:answer/id #uuid "79c016eb-c950-5495-8f5f-d194fb1654b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x-5}{4}" :db/id #edb/ref 17592186337128} {:answer/id #uuid "db025474-ab56-5474-a9b2-68799aa2f6b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=5x-4" :db/id #edb/ref 17592186337941} {:answer/id #uuid "f27f220f-02d5-520b-ae41-e8da949a18b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{-x+3}{2}" :db/id #edb/ref 17592186338156}] :answer-field/correct {:answer/id #uuid "38d74e2a-5c9e-5968-8c1b-e26086ff083a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{-x+5}{4}" :db/id #edb/ref 17592186336563} :answer-field/id #uuid "43892178-57b0-5a5c-aeb7-840696571bc3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338399}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cbd9a061-09c2-52d4-9a2f-d9bac924c805" :question/math-academy-id "q-7026" :question/problem "For the function $f(x)$ defined by $f(x)=-4x+5,$ find ${f}^{-1}(x).$" :question/worked-solution "To find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y$:\n\n$$\ny=-4x+5\n$$\n\n**Step 2:** Swap $x$ and $y$:\n\n$$\nx=-4y+5\n$$\n\n**Step 3:** Solve for $y$:\n\n$$\n\\begin{aligned}x & =-4y+5 \\\\ 4y & =-x+5 \\\\ y & =\\frac{-x+5}{4}\\end{aligned}\n$$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x)$:\n\n$$\n{f}^{-1}(x)=\\frac{-x+5}{4}\n$$"}] [{:db/id #edb/ref 17592186403356 :knowledge-point/_questions [{:db/id #edb/ref 17592186110718 :knowledge-point/id #uuid "b504a10e-4bf8-5cda-91b2-3c0d6557b499" :knowledge-point/title "Elementary Quadratic Inequalities with No Solutions or All Real Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29a157f2-652d-55a0-aad5-e517b09b93fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The inequality has no solution" :db/id #edb/ref 17592186403358} {:answer/id #uuid "e9367b1b-79cd-5d1f-a504-3955a2d66624" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\sqrt{7},\\sqrt{7})" :db/id #edb/ref 17592186403359} {:answer/id #uuid "3105f9dc-2265-56e6-8608-a2999b3c574b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-7)\\cup (7,\\infty )" :db/id #edb/ref 17592186403360} {:answer/id #uuid "017b7280-932a-5008-9665-752610dd30a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-\\sqrt{7})\\cup (\\sqrt{7},\\infty )" :db/id #edb/ref 17592186403361} {:answer/id #uuid "0b32b5dc-b953-5546-ba0c-feb2943b578d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-7,7)" :db/id #edb/ref 17592186403362}] :answer-field/correct {:answer/id #uuid "29a157f2-652d-55a0-aad5-e517b09b93fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The inequality has no solution" :db/id #edb/ref 17592186403358} :answer-field/id #uuid "9bea2c77-c31d-5076-ab19-60ac635f4abf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403357}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "84c48822-db58-5782-9ad8-c8f639b2189d" :question/math-academy-id "q-70275" :question/problem "Solve the inequality ${x}^{2}<-7.$" :question/worked-solution "We can solve this inequality using either of the two methods described below.\n\n**Method 1 - Solving an Absolute Value Inequality**\n\nWe know that the square of *any* real number is greater than or equal to zero. Therefore, it is impossible for the square of a real number to be smaller than $-7.$\n\nSo, the inequality ${x}^{2}<-7$ has no solutions.\n\n**Method 2 - Picturing a Quadratic Curve**\n\nLet's bring all the terms to the left-hand side,\n\n$$\n{x}^{2}+7<0,\n$$\n\nand then plot the parabola $y={x}^{2}+7.$ The desired inequality ($y<0$) is never satisfied, so there are no solutions.\n\n![](images/65/65e1586fe54b49aec11d04a859c2d88dc95304528facf4b450b46fdf9fc76537.png)"}] [{:db/id #edb/ref 17592186403363 :knowledge-point/_questions [{:db/id #edb/ref 17592186184333 :knowledge-point/id #uuid "cbe80595-c807-506c-a356-566f1edb3402" :knowledge-point/title "Solving Less Than (Or Equal To) Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "798285f8-4214-5be2-876f-0698e80dc714" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x<-3$ or $x>1$" :db/id #edb/ref 17592186403365} {:answer/id #uuid "ea90ba45-b382-5878-894e-6d2b701695cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3<x<0" :db/id #edb/ref 17592186403366} {:answer/id #uuid "cf10abb2-8d0e-5e29-acad-727c25b8e9c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3<x<3" :db/id #edb/ref 17592186403367} {:answer/id #uuid "ae90ac31-b861-5670-bffe-a751c0cdc4aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<x<3" :db/id #edb/ref 17592186403368} {:answer/id #uuid "6065b36c-7607-5669-843f-5ad769e41a2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x<0$ or $x>3$" :db/id #edb/ref 17592186403369}] :answer-field/correct {:answer/id #uuid "798285f8-4214-5be2-876f-0698e80dc714" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x<-3$ or $x>1$" :db/id #edb/ref 17592186403365} :answer-field/id #uuid "39da93ce-5e0c-51dc-bb47-cc9906b65efc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403364}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7ab8c812-0c5a-5955-8938-c9f15da2c8e5" :question/math-academy-id "q-70303" :question/problem "Find the solution of $-{x}^{2}-2x+3<0.$" :question/worked-solution "To solve the inequality \n\n$$\n-{x}^{2}-2x+3<0,\n$$\n\nwe need to find the values of $x$ for which the parabola \n\n$$\ny=-{x}^{2}-2x+3\n$$\n\nlies *below* the $x$-axis.\n\nFirst, let's find the roots of the parabola:\n\n$$\n\\begin{aligned}-{x}^{2}-2x+3 & =0 \\\\ -(x-1)(x+3) & =0\\end{aligned}\n$$\n\nSo, the roots are $x=-3$ and $x=1,$ and we can graph the parabola as follows:\n\n![](images/28/289eed0e3b3047987dfbc729d0c22af32d1297ed2fb2d564ec725868b92a39c1.png)\n\nThe values marked in blue show all $x$-values where the parabola lies *below* the axis.\n\nSo, the solution to the inequality is $x<-3$ or $x>1.$"}] [{:db/id #edb/ref 17592186338775 :knowledge-point/_questions [{:db/id #edb/ref 17592186171958 :knowledge-point/id #uuid "e5c108c0-f32a-5725-af3b-c3e747da09f2" :knowledge-point/title "Calculating Binomial Coefficients Using the Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25ea4cbf-0894-516c-bf8c-05148d678c1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186336386} {:answer/id #uuid "27194d89-8b8a-5d73-8b51-ca6d6eccaee4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186336398} {:answer/id #uuid "51ea90c5-27e9-53cb-8edd-dadfb34f7ad7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186336785} {:answer/id #uuid "88fe60b9-36f4-5648-a0b1-af2642542fc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186337267} {:answer/id #uuid "d3343b78-6038-5226-bd2d-41776d274a57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186337878}] :answer-field/correct {:answer/id #uuid "88fe60b9-36f4-5648-a0b1-af2642542fc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186337267} :answer-field/id #uuid "7258f46a-6506-5da9-bc1c-9bf1c603fa00" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338470}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dabc6d34-49c0-50c3-bc0f-93f36f621824" :question/math-academy-id "q-70306" :question/problem "Determine the value of $(\\genfrac{}{}{0pt}{}{5}{3}).$" :question/worked-solution "The binomial coefficient $(\\genfrac{}{}{0pt}{}{n}{r})$ is given by the formula\n\n$$\n(\\genfrac{}{}{0pt}{}{n}{r})=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nIn this case, we have $n=5$ and $r=3.$ Therefore,\n\n$$\n\\begin{aligned}(\\genfrac{}{}{0pt}{}{5}{3}) & =\\frac{5!}{(5-3)!\\cdot 3!} \\\\  & =\\frac{5\\cdot 4\\cdot 3!}{2!\\cdot 3!} \\\\  & =\\frac{5\\cdot 4\\cdot \\cancel{3!}}{2\\cdot \\cancel{3!}} \\\\  & =\\frac{20}{2} \\\\  & =10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338778 :knowledge-point/_questions [{:db/id #edb/ref 17592186171958 :knowledge-point/id #uuid "e5c108c0-f32a-5725-af3b-c3e747da09f2" :knowledge-point/title "Calculating Binomial Coefficients Using the Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ebfcb38-4cb6-5c83-bdec-ad8fa047e2a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186336622} {:answer/id #uuid "45019d5e-11bf-59ef-b990-5879fea0d3d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186336676} {:answer/id #uuid "858a3a2f-85e4-58e5-b34d-aeafa8b8e47a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186337236} {:answer/id #uuid "ab67609f-8361-56e4-b608-52ff06468fbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186337579} {:answer/id #uuid "e327c069-e407-509a-b4d8-eb31daa60b3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "56" :db/id #edb/ref 17592186338011}] :answer-field/correct {:answer/id #uuid "45019d5e-11bf-59ef-b990-5879fea0d3d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186336676} :answer-field/id #uuid "68291bac-dd62-5812-bf94-4a9db091ec30" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338459}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4aeaab53-de20-5455-adda-be4ee5c60bdb" :question/math-academy-id "q-70313" :question/problem "Determine the value of $(\\frac{7}{4}).$" :question/worked-solution "The binomial coefficient $(\\frac{n}{r})$ is given by the formula\n\n$$\n(\\frac{n}{r})=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nIn this case, we have $n=7$ and $r=4.$ Therefore,\n\n$$\n\\begin{aligned}(\\frac{7}{4}) & =\\frac{7!}{(7-4)!\\cdot 4!} \\\\  & =\\frac{7\\cdot 6\\cdot 5\\cdot 4!}{3!\\cdot 4!} \\\\  & =\\frac{7\\cdot \\cancel{6}\\cdot 5\\cdot \\cancel{4!}}{\\cancel{6}\\cdot \\cancel{4!}} \\\\  & =7\\cdot 5 \\\\  & =35.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338783 :knowledge-point/_questions [{:db/id #edb/ref 17592186179649 :knowledge-point/id #uuid "3db20b82-9561-5c54-8e12-8914bb6747c3" :knowledge-point/title "Adding and Subtracting Rational Expressions With No Common Factors in the Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4060e178-e30c-5dea-89ab-da86ffb67f14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x+3}{2x-1}" :db/id #edb/ref 17592186336637} {:answer/id #uuid "856d433f-dddd-5b78-8889-ef8c68f65cf0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{2x-1}" :db/id #edb/ref 17592186337233} {:answer/id #uuid "a39ad23d-588c-5939-b295-38e0e8452424" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x-3}{x(2x-1)}" :db/id #edb/ref 17592186337514} {:answer/id #uuid "b2da2292-5e26-5da4-b4ac-a5a162e326d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{x(2x-1)}" :db/id #edb/ref 17592186337628} {:answer/id #uuid "b52dbffb-bfae-5071-a585-1ad66ff30a96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+6}{x(2x-1)}" :db/id #edb/ref 17592186337643}] :answer-field/correct {:answer/id #uuid "b2da2292-5e26-5da4-b4ac-a5a162e326d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{x(2x-1)}" :db/id #edb/ref 17592186337628} :answer-field/id #uuid "8b8e8763-f6d1-53d3-93eb-54e35d42b73c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338532}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7bf0fd6f-ebf3-5cf5-b64a-a6ca2a7901f7" :question/math-academy-id "q-70359" :question/problem "$\\frac{6}{2x-1}-\\frac{3}{x}=$" :question/worked-solution "In this case, we need to put the fractions over a common denominator of $x(2x-1),$ since there are no common factors in either denominator that we can exploit. \n\nTo do this, we multiply the top and bottom of the first fraction by $x,$ and the top and bottom of the second fraction by $2x-1:$ \n\n$$\n\\begin{aligned}\\frac{6}{2x-1}-\\frac{3}{x} & = \\\\ \\frac{x}{x}\\cdot \\frac{6}{2x-1}-\\frac{2x-1}{2x-1}\\cdot \\frac{3}{x} & = \\\\ \\frac{6x}{x(2x-1)}-\\frac{3(2x-1)}{x(2x-1)} & = \\\\ \\frac{6x-3(2x-1)}{x(2x-1)} & = \\\\ \\frac{6x-6x+3}{x(2x-1)} & = \\\\ \\frac{3}{x(2x-1)}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338785 :knowledge-point/_questions [{:db/id #edb/ref 17592186105727 :knowledge-point/id #uuid "d766de83-9394-57be-84a4-bb88f5ddf792" :knowledge-point/title "Calculating the Magnitude of a Vector Given in Component Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bc04d89-ece5-5be6-a803-1db9ba1964e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{101}" :db/id #edb/ref 17592186336142} {:answer/id #uuid "1eb36512-67ff-5791-88e8-8bcea42430a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186336314} {:answer/id #uuid "37209ee5-6cc5-5448-ad42-c313b1df4926" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{102}" :db/id #edb/ref 17592186336544} {:answer/id #uuid "87679902-47de-5be7-81bd-44ed92337ad4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{103}" :db/id #edb/ref 17592186337254} {:answer/id #uuid "e0c69efe-b7fb-5232-be83-79ef8a9c8411" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{11}" :db/id #edb/ref 17592186337995}] :answer-field/correct {:answer/id #uuid "0bc04d89-ece5-5be6-a803-1db9ba1964e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{101}" :db/id #edb/ref 17592186336142} :answer-field/id #uuid "234bb490-73fa-55bb-8a77-4faf31aca618" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338345}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2df701ef-0156-5eae-96d7-020e27b60572" :question/math-academy-id "q-70425" :question/problem "Let $A(2,1,0)$ and $B(1,3,-3).$ Find $|a+2b|,$ where $a$ and $b$ are position vectors of $A$ and $B$, respectively." :question/worked-solution "We have \n\n$$\n\\begin{aligned} & \\overset{\\to }{OA}=a=2i+j, \\\\  & \\overset{\\to }{OB}=b=i+3j-3k.\\end{aligned}\n$$\n\nComputing the coordinates of $a+2b$, we obtain:\n\n$$\n\\begin{aligned}a+2b & =(2i+j)+2(i+3j-3k) \\\\  & =4i+7j-6k\\end{aligned}\n$$\n\nNow, using the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|a+2b| & =\\sqrt{(4)^{2}+(7)^{2}+(-6)^{2}} \\\\  & =\\sqrt{16+49+36} \\\\  & =\\sqrt{101}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338789 :knowledge-point/_questions [{:db/id #edb/ref 17592186087832 :knowledge-point/id #uuid "19d1448c-d5fd-5615-b657-ff4d66867834" :knowledge-point/title "Determining the Equation of a Wide Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00afcea9-6214-53d5-8d89-421df8f628ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+1)^{2}+\\frac{(y-1)^{2}}{9}=1" :db/id #edb/ref 17592186336036} {:answer/id #uuid "0b90da10-4e96-59c4-935c-af4cbabe39b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+1)^{2}}{9}+(y-1)^{2}=1" :db/id #edb/ref 17592186336140} {:answer/id #uuid "2fb796ae-9d41-5a84-b20d-236953b91f53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+1)^{2}}{9}+(y+1)^{2}=1" :db/id #edb/ref 17592186336489} {:answer/id #uuid "81e9076a-bd1d-56c6-9987-1db33bec0455" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-1)^{2}}{3}+(y+1)^{2}=1" :db/id #edb/ref 17592186337213} {:answer/id #uuid "caa57bd4-e436-5533-850a-b24ed3806e6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+1)^{2}}{3}+(y-1)^{2}=1" :db/id #edb/ref 17592186337816}] :answer-field/correct {:answer/id #uuid "0b90da10-4e96-59c4-935c-af4cbabe39b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+1)^{2}}{9}+(y-1)^{2}=1" :db/id #edb/ref 17592186336140} :answer-field/id #uuid "42347800-ae0e-56fb-aea2-1fd762b33301" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338396}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bf6c95be-632e-518e-8dd0-3d83f244d677" :question/math-academy-id "q-70479" :question/problem "![](images/69/69bcf48e0a8838dd981ae2b9727465016e74a321034cddd1f00f9384202feffb.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the ellipse is centered at $(-1,1),$ the horizontal radius has length $a=3,$ and the vertical radius has length $b=1.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}} & =1 \\\\ \\frac{(x-(-1))^{2}}{{3}^{2}}+\\frac{(y-1)^{2}}{{1}^{2}} & =1 \\\\ \\frac{(x+1)^{2}}{9}+(y-1)^{2} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338791 :knowledge-point/_questions [{:db/id #edb/ref 17592186064343 :knowledge-point/id #uuid "3ca13570-d504-53e6-8e02-0f1e85047a3e" :knowledge-point/title "Calculating the Slope of a Tangent Line of a Curve With Fractional Powers at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14183076-e4e9-584e-85d9-0fab9fcaf7c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186336222} {:answer/id #uuid "416a71dd-2646-5a15-8c7b-e8a83a098192" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{2}" :db/id #edb/ref 17592186336647} {:answer/id #uuid "52ec3a1a-c5fa-5960-b678-90f06671ff4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{13}{2}" :db/id #edb/ref 17592186336797} {:answer/id #uuid "977a6ce2-aa5c-58cc-90c8-0039b34bef55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{2}" :db/id #edb/ref 17592186337415} {:answer/id #uuid "b8fe1893-7cc5-52a3-9333-bf2bf2cd5d48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186337672}] :answer-field/correct {:answer/id #uuid "977a6ce2-aa5c-58cc-90c8-0039b34bef55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{2}" :db/id #edb/ref 17592186337415} :answer-field/id #uuid "fa4297b1-164a-5f37-8ca3-7680334615bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338719}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d3a3c2de-1ea3-53e2-8e76-3b3c148c99ef" :question/math-academy-id "q-70535" :question/problem "What is the slope of the tangent to the curve $y={x}^{2}-3x+6\\sqrt{x}$ at the point $(4,16)?$" :question/worked-solution "This time, we'll use $\\frac{\\text{d}y}{\\text{d}x}$ notation. First, we compute the derivative, which gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}-3x+6\\sqrt{x}) \\\\  & =2\\cdot x-3+\\frac{1}{2}\\cdot 6{x}^{-1/2} \\\\  & =2x-3+3{x}^{-1/2}.\\end{aligned}\n$$\n\nEvaluating at $x=4$ gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=4} & =2(4)-3+3(4{)}^{-1/2} \\\\  & =8-3+\\frac{3}{2} \\\\  & =\\frac{13}{2}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent to the curve is $\\frac{13}{2}.$"}] [{:db/id #edb/ref 17592186338794 :knowledge-point/_questions [{:db/id #edb/ref 17592186176052 :knowledge-point/id #uuid "ce45704e-ecea-5c67-bb40-a413f8a0d72e" :knowledge-point/title "Utilizing the Periodicity Property of the Secant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34aed7c6-b6dd-5388-93f4-39154e4a8fc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}" :db/id #edb/ref 17592186336528} {:answer/id #uuid "362010b6-9ff1-5a1d-8c4d-5d78f4ec160e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186336535} {:answer/id #uuid "57b96cb2-f4c7-54de-878d-b19b56c5c836" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186336836} {:answer/id #uuid "952a06a3-7332-5e39-996f-d3c838db3863" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186337394} {:answer/id #uuid "a12cfcb9-b0f4-5a33-98e8-2ded150757bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186337490}] :answer-field/correct {:answer/id #uuid "a12cfcb9-b0f4-5a33-98e8-2ded150757bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186337490} :answer-field/id #uuid "5f2a36f5-e442-5e0f-94f3-dcde26c324b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338442}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dff5ff0a-6830-5639-9a6f-e199fd0937d1" :question/math-academy-id "q-70612" :question/problem "If $\\operatorname{sec}⁡x=\\sqrt{2},$ then what is $\\operatorname{sec}⁡(x+6\\pi )?$" :question/worked-solution "The period of $y=\\operatorname{sec}⁡x$ is $2\\pi .$ Therefore, for integer $n$ we have\n\n$$\n\\operatorname{sec}⁡x=\\operatorname{sec}⁡(x+2n\\pi ).\n$$\n\nSubstituting $n=3$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}\\operatorname{sec}⁡x=\\operatorname{sec}⁡(x+2\\cdot 3\\cdot \\pi )=\\operatorname{sec}⁡(x+6\\pi ).\\end{aligned}\n$$\n\nTherefore, if $\\operatorname{sec}⁡x=\\sqrt{2},$ then $\\operatorname{sec}⁡(x+6\\pi )=\\sqrt{2}.$"}] [{:db/id #edb/ref 17592186338800 :knowledge-point/_questions [{:db/id #edb/ref 17592186176047 :knowledge-point/id #uuid "542df339-5020-5680-a39c-a1ae161083e7" :knowledge-point/title "Describing Properties of the Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19e1f0f6-cdd9-56b4-a97c-62ec04052296" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186336270} {:answer/id #uuid "55a003f4-6613-50bf-8dc5-00b12c062d6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186336819} {:answer/id #uuid "65829911-343f-5184-8bfd-a51d9cbc6ccc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186336938} {:answer/id #uuid "857b0866-840f-5787-8f25-33109f144e38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186337235} {:answer/id #uuid "dbb894de-3d54-53ec-a8ac-6af5ea4bb2f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186337945}] :answer-field/correct {:answer/id #uuid "19e1f0f6-cdd9-56b4-a97c-62ec04052296" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186336270} :answer-field/id #uuid "d460533e-ecf9-527d-9c80-5091452ea8df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338651}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "24b90149-221d-555e-91aa-b1d1cb7cb1c0" :question/math-academy-id "q-70667" :question/problem "Which of the following statements regarding the graph of $y=cos⁡x$ are true?\n\n- The graph intersects the $y$-axis at $y=1$\n- The function has a minimum value at $x=-\\pi .$\n- The range of the function is $[-\\pi ,\\pi ].$" :question/worked-solution "Let's plot the graph of $y=cos⁡x.$\n\n![](images/88/88378ece5b1721cdc533d07d69c004901539c7f8fda9a5a3e5c5648ed32905c5.png)\n\nLet's go through each statement.\n\n- Statement I is true. The $y$-intercepts of the function is $y=1.$\n\n- Statement II is true. The function at $x=-\\pi $ has a minimum value.\n\n- Statement III is false. The minimum value is $-1$, the maximum value is $1$, and so the range is $[-1,1].$"}] [{:db/id #edb/ref 17592186338801 :knowledge-point/_questions [{:db/id #edb/ref 17592186176055 :knowledge-point/id #uuid "6a18aadb-3e8a-54d7-a5d7-e78208e77675" :knowledge-point/title "Describing Properties of the Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15129ab1-4c46-56cd-9295-d5604da9b82a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186336232} {:answer/id #uuid "1f18694d-3bfc-5660-9cf9-33f02dcb9fa6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186336319} {:answer/id #uuid "605f040a-a7b3-52da-b5bf-64a199155157" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186336904} {:answer/id #uuid "72fb3c80-d6b2-5e94-bae7-692fa5b792c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186337067} {:answer/id #uuid "ea50c4ab-53d3-59d3-915e-68d350aa77ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186338077}] :answer-field/correct {:answer/id #uuid "72fb3c80-d6b2-5e94-bae7-692fa5b792c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186337067} :answer-field/id #uuid "614d9852-d75d-56d9-af20-89203dd46a06" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338447}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4a752d35-73b8-55ea-bb50-4d11f60be65b" :question/math-academy-id "q-70669" :question/problem "Which of the following statements are true regarding the function $y=cot⁡x?$ Assume $n$ is an integer.\n\n- The function has no minimum value. $$\n- $x=-4\\pi $ is in the domain of the function. $$\n- $x=-\\frac{3\\pi }{2}$ is a zero of the function." :question/worked-solution "Let's plot the graph of $y=cot⁡x.$\n\n![](images/8b/8bc549c68a3bc5b7989ac1835e4bb58183066c7797264b8cccd4f3fd2c895056.png)\n\nNow, let's go through each statement.\n\n- Statement I is true. The function has no minimum or maximum value. $$\n\n- Statement II is false. The function is defined for all real numbers except the values $n\\pi $ for any integer $n$, thus it is not defined for $x=-4\\pi .$\n\n- Statement III is true. The zeros of $y=cot⁡x$ occur at $\\frac{\\pi }{2}+n\\pi ,$ for any integer $n.$ Therefore, $x=-\\frac{3\\pi }{2}$ is a zero of the function."}] [{:db/id #edb/ref 17592186338803 :knowledge-point/_questions [{:db/id #edb/ref 17592186176048 :knowledge-point/id #uuid "1c25c3a0-083a-55d5-b688-7347bfafaa9e" :knowledge-point/title "Utilizing the Periodicity Property of the Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c81bece-db23-58d8-bb4c-a4ec954ab3a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186336150} {:answer/id #uuid "11454d75-ea49-5be3-97d8-331be00c105f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}+2\\pi " :db/id #edb/ref 17592186336195} {:answer/id #uuid "180fc6bd-ead7-54b4-bbdc-eccc651de809" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{3}+16\\pi " :db/id #edb/ref 17592186336255} {:answer/id #uuid "aa67f4b1-dac9-5c08-9fd9-fcd2b26eb1d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186337568} {:answer/id #uuid "e2a95a14-3cbb-500b-8ddd-ebf38336d4d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}+16\\pi " :db/id #edb/ref 17592186338005}] :answer-field/correct {:answer/id #uuid "0c81bece-db23-58d8-bb4c-a4ec954ab3a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186336150} :answer-field/id #uuid "c49b55a2-50e7-5337-b7ac-4eaf751dacaa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338629}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6abcc021-8010-5554-b152-291688c68aef" :question/math-academy-id "q-70672" :question/problem "If $cos⁡x=\\frac{\\sqrt{3}}{3}$ for some $x$, then $cos⁡(x+16\\pi )=$" :question/worked-solution "The period of $y=cos⁡x$ is $2\\pi .$ Therefore, for any integer $n$ we have\n\n$$\ncos⁡x=cos⁡(x+2n\\pi ).\n$$\n\nSubstituting $n=8$ into the right-hand-side gives\n\n$$\n\\begin{aligned}cos⁡x=cos⁡(x+16\\pi ).\\end{aligned}\n$$\n\nTherefore, if $cos⁡x=\\frac{\\sqrt{3}}{3},$ then $cos⁡(x+16\\pi )=\\frac{\\sqrt{3}}{3}.$"}] [{:db/id #edb/ref 17592186398940 :knowledge-point/_questions [{:db/id #edb/ref 17592186110573 :knowledge-point/id #uuid "039f58e5-0f98-58b1-b2f7-9f0ee33ed075" :knowledge-point/title "Identifying Values in the Domain of the Inverse Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1232b735-89b7-5947-a6f2-9d6d99908747" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186398942} {:answer/id #uuid "049750a5-b730-53e5-9a90-66f768ec6769" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186398943} {:answer/id #uuid "5863fe1f-7500-5834-8f94-d351db947a13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186398944} {:answer/id #uuid "a50da1c4-1e08-58b2-a1b8-d4cdf6ba07e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186398945} {:answer/id #uuid "6bc2cd8d-8acd-5b17-b36e-a38c9841d994" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186398946}] :answer-field/correct {:answer/id #uuid "1232b735-89b7-5947-a6f2-9d6d99908747" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186398942} :answer-field/id #uuid "00f1fbc5-ce36-5de0-b6ee-9d073e797654" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398941}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8e77e511-a545-50af-975e-802c98ad3a19" :question/math-academy-id "q-70743" :question/problem "Which of the following values is in the domain of $y=\\operatorname{arccos}⁡x?$" :question/worked-solution "Let's recall the graph of $y=\\operatorname{arccos}⁡x.$\n\n![](images/9d/9dcc5a116c2a564547283783a7df7b1cd3a9ab3b76ac24dc2695c4cb367796d5.png)\n\nNote that:\n\n- The domain of the function is $[-1,1].$\n\nTherefore, of the given values, only $x=\\frac{2}{3}$ is in the domain of $y=\\operatorname{arccos}⁡x.$"}] [{:db/id #edb/ref 17592186403377 :knowledge-point/_questions [{:db/id #edb/ref 17592186110575 :knowledge-point/id #uuid "af0b18ca-54a2-5a24-a670-faa311096abc" :knowledge-point/title "Determining Points that Lie on the Curve of the Inverse Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f6ed4e6-674a-582a-a23b-375ebe06e8c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186403379} {:answer/id #uuid "89701089-790b-5af5-b05f-fbbc42e2e82d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186403380} {:answer/id #uuid "79b59ff2-8782-539d-b7b2-9e27c2434930" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186403381} {:answer/id #uuid "de1fd64c-6769-5600-82b0-74265db69c4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186403382} {:answer/id #uuid "1f943f61-7e15-537e-b353-88fa859393bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186403383}] :answer-field/correct {:answer/id #uuid "89701089-790b-5af5-b05f-fbbc42e2e82d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186403380} :answer-field/id #uuid "5374ccff-1aaf-5e15-ac23-13d1d380d377" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403378}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3692464e-f017-5c85-befd-6c0f45c59ad9" :question/math-academy-id "q-70769" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arccos}⁡x?$\n\nI. $(\\frac{\\sqrt{3}}{2},\\frac{\\pi }{6})$\nII. $(\\frac{\\sqrt{3}}{2},-\\frac{\\pi }{6})$\nIII. $(1,\\frac{\\pi }{3})$" :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arccos}⁡x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{cos}⁡x.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arccos}⁡x,$ which is $y\\in [0,\\pi ].$\n\nWith this in mind, let's check each of the points. \n\n- First, we consider the point $(\\frac{\\sqrt{3}}{2},\\frac{\\pi }{6}).$ We note the following:\n\n- The point $(\\frac{\\pi }{6},\\frac{\\sqrt{3}}{2})$ lies on the graph of $y=\\operatorname{cos}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arccos}⁡x$ is $y\\in [0,\\pi ],$ and $y=\\frac{\\pi }{6}$ lies within this range. $\\,✓$\n\nTherefore, the point $(\\frac{\\sqrt{3}}{2},\\frac{\\pi }{6})$ lies on the graph of $y=\\operatorname{arccos}⁡x.$\n\n- Next, we consider the point $(\\frac{\\sqrt{3}}{2},-\\frac{\\pi }{6}).$ We note the following:\n\n- The point $(-\\frac{\\pi }{6},\\frac{\\sqrt{3}}{2})$ lies on the graph of $y=\\operatorname{cos}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arccos}⁡x$ is $y\\in [0,\\pi ],$ and $y=-\\frac{\\pi }{6}$ does **not** lie within this range.   $\\,\\times $\n\nTherefore, the point $(\\frac{\\sqrt{3}}{2},-\\frac{\\pi }{6})$ does **not** lie on the graph of $y=\\operatorname{arccos}⁡x.$\n\n- Finally, we consider the point $(1,\\frac{\\pi }{3}).$ We note the following:\n\n- The point $(\\frac{\\pi }{3},1)$ does **not** lie on the graph of $y=\\operatorname{cos}⁡x.$  $\\,\\times $\n\nTherefore, the point $(1,\\frac{\\pi }{3})$ does **not** lie on the graph of $y=\\operatorname{arccos}⁡x.$"}] [{:db/id #edb/ref 17592186403384 :knowledge-point/_questions [{:db/id #edb/ref 17592186110587 :knowledge-point/id #uuid "5b834b64-9679-56c2-b5e9-ee26a54b5e13" :knowledge-point/title "Identifying Values in the Domain of the Inverse Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c683d19b-cb88-5f86-95bd-0eefac4287ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186403386} {:answer/id #uuid "ba202067-eb38-59d1-b49f-3460dc21b816" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186403387} {:answer/id #uuid "719204f6-c78a-5597-b9a6-44d1aba458ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186403388} {:answer/id #uuid "fc70ae3d-3044-5bdb-90e5-456d5910ff9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186403389} {:answer/id #uuid "c24acb25-6133-50d7-898a-c49b833d51ff" :answer/typ