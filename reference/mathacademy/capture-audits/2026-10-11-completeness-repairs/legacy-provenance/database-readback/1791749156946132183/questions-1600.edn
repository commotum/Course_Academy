ef 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186336833} {:answer/id #uuid "6be22397-4f50-5e4b-b55c-d77190fffe2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{4}" :db/id #edb/ref 17592186336985} {:answer/id #uuid "f8e69242-5c49-57c1-af8e-4e1ded3930c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{2}" :db/id #edb/ref 17592186338213}] :answer-field/correct {:answer/id #uuid "6be22397-4f50-5e4b-b55c-d77190fffe2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{4}" :db/id #edb/ref 17592186336985} :answer-field/id #uuid "a34bb09a-c6c7-5257-8f81-4016661cd1bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338579}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "48094d2b-48d8-590b-b5c9-768ebbea8c83" :question/math-academy-id "q-70780" :question/problem "Which of the following values is in the range of $y=\\operatorname{arctan}⁡x?$" :question/worked-solution "Let's recall the graph of $y=\\operatorname{arctan}⁡x.$\n\n![](images/d7/d7984b9098d02bfc2b1e9a422aef919533abce54fbb94117e709c7613b0870a3.png)\n\nNote that:\n\n- The range of the function is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}).$\n\nTherefore, of the given values, only $y=-\\frac{\\pi }{4}$ is in the range of the function."}] [{:db/id #edb/ref 17592186403391 :knowledge-point/_questions [{:db/id #edb/ref 17592186110588 :knowledge-point/id #uuid "7f045b43-4785-5989-8b5a-dcb8401d1bb3" :knowledge-point/title "Determining Points that Lie on the Graph of the Inverse Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e83630fb-381e-5d0a-90c8-894b9f4456de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186403393} {:answer/id #uuid "2d7d34ce-fe27-52b9-8e75-660de0d01c04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186403394} {:answer/id #uuid "1a706caa-176e-5b8c-8e49-0cc199d3daaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186403395} {:answer/id #uuid "98eb390a-41f6-5a18-a404-4e6234a630f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186403396} {:answer/id #uuid "4cd14ed4-11a8-52da-90e1-aab9af05d891" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186403397}] :answer-field/correct {:answer/id #uuid "2d7d34ce-fe27-52b9-8e75-660de0d01c04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186403394} :answer-field/id #uuid "2833baad-d98b-5c32-835d-c98b36e21086" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403392}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4f72c98d-40b3-587a-b743-ac6b3ce0ce19" :question/math-academy-id "q-70788" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arctan}⁡x?$\n\nI. $(\\sqrt{3},\\frac{\\pi }{3})$\nII. $(0,\\frac{\\pi }{6})$\nIII. $(-\\sqrt{3},\\frac{2\\pi }{3})$" :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arctan}⁡x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{tan}⁡x.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arctan}⁡x,$ which is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}).$\n\nWith this in mind, let's check each of the points.  \n\n- First,  we consider the point $(\\sqrt{3},\\frac{\\pi }{3}).$ We note the following:\n\n- The point $(\\frac{\\pi }{3},\\sqrt{3})$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=\\frac{\\pi }{3}$ lies within this range. $\\,✓$\n\nTherefore, the point $(\\sqrt{3},\\frac{\\pi }{3})$ lies on the graph of $y=\\operatorname{arctan}⁡x.$\n\n- Next, we consider the point $(0,\\frac{\\pi }{6}).$ We note the following:\n\n- The point $(\\frac{\\pi }{6},0)$ does **not** lie on the graph of $y=\\operatorname{tan}⁡x.$  $\\,\\times $\n\nTherefore, the point $(0,\\frac{\\pi }{6})$ does **not** lie on the graph of $y=\\operatorname{arctan}⁡x.$\n\n- Finally, we consider the point $(-\\sqrt{3},\\frac{2\\pi }{3}).$ We note the following:\n\n- The point $(\\frac{2\\pi }{3},-\\sqrt{3})$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=\\frac{2\\pi }{3}$ does **not** lie within this range. $\\,\\times $\n\nTherefore, the point $(-\\sqrt{3},\\frac{2\\pi }{3})$ does **not** lie on the graph of $y=\\operatorname{arctan}⁡x.$"}] [{:db/id #edb/ref 17592186403398 :knowledge-point/_questions [{:db/id #edb/ref 17592186110588 :knowledge-point/id #uuid "7f045b43-4785-5989-8b5a-dcb8401d1bb3" :knowledge-point/title "Determining Points that Lie on the Graph of the Inverse Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21e308bb-4252-5397-bb95-a177968aaf79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186403400} {:answer/id #uuid "f003f44c-4653-5d72-bf69-b4a8a7046c73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186403401} {:answer/id #uuid "3d46f360-9b88-567b-81cd-855d15e9c6f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186403402} {:answer/id #uuid "93673f45-8795-5fce-80cc-5e36a03c6c3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186403403} {:answer/id #uuid "1f14bcc5-7caf-58b7-a713-889a84745ec4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186403404}] :answer-field/correct {:answer/id #uuid "3d46f360-9b88-567b-81cd-855d15e9c6f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186403402} :answer-field/id #uuid "9f01cf64-abf9-51a3-ae00-a669b4af396f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403399}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6ccce5ac-e354-5171-bb2f-8fada7bebdd8" :question/math-academy-id "q-70789" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arctan}⁡x?$\n\nI. $(-\\sqrt{3},-\\frac{\\pi }{3})$\nII. $(-\\frac{1}{\\sqrt{3}},-\\frac{\\pi }{6})$\nIII. $(-1,\\frac{\\pi }{4})$" :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arctan}⁡x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{tan}⁡x.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arctan}⁡x,$ which is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}).$\n\nWith this in mind, let's check each of the points.  \n\n- First,  we consider the point $(-\\sqrt{3},-\\frac{\\pi }{3}).$ We note the following:\n\n- The point $(-\\frac{\\pi }{3},-\\sqrt{3})$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=-\\frac{\\pi }{3}$ lies within this range. $\\,✓$\n\nTherefore, the point $(-\\sqrt{3},-\\frac{\\pi }{3})$ lies on the graph of $y=\\operatorname{arctan}⁡x.$\n\n- Next, we consider the point $(-\\frac{1}{\\sqrt{3}},-\\frac{\\pi }{6}).$ We note the following:\n\n- The point $(-\\frac{\\pi }{6},-\\frac{1}{\\sqrt{3}})$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=-\\frac{\\pi }{6}$ lies within this range. $\\,✓$\n\nTherefore, the point $(-\\frac{1}{\\sqrt{3}},-\\frac{\\pi }{6})$ does lie on the graph of $y=\\operatorname{arctan}⁡x.$\n\n- Finally, we consider the point $(-1,\\frac{\\pi }{4}).$ We note the following:\n\n- The point $(\\frac{\\pi }{4},-1)$ does **not** lie on the graph of $y=\\operatorname{tan}⁡x.$  $\\,\\times $\n\nTherefore, the point $(-1,\\frac{\\pi }{4})$ does **not** lie on the graph of $y=\\operatorname{arctan}⁡x.$"}] [{:db/id #edb/ref 17592186403405 :knowledge-point/_questions [{:db/id #edb/ref 17592186087733 :knowledge-point/id #uuid "e6efb5f8-86df-5825-9645-9017d942899d" :knowledge-point/title "Finding the Complex Conjugate of a Real Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f84880b-5911-5406-ad95-6099ea3fec0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{z}=-8-\\text{i}" :db/id #edb/ref 17592186403407} {:answer/id #uuid "0030259a-04f4-5ca1-a70f-24d9bb2f9179" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{z}=-8\\text{i}" :db/id #edb/ref 17592186403408} {:answer/id #uuid "b2cf456a-9a66-5383-9e97-5414b0704221" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{z}=8+\\text{i}" :db/id #edb/ref 17592186403409} {:answer/id #uuid "a6c2ffb6-7920-5753-a435-1312967cec6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{z}=8" :db/id #edb/ref 17592186403410} {:answer/id #uuid "592cd0c3-7591-51e3-a88a-bdd43d0782fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{z}=-8" :db/id #edb/ref 17592186403411}] :answer-field/correct {:answer/id #uuid "592cd0c3-7591-51e3-a88a-bdd43d0782fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{z}=-8" :db/id #edb/ref 17592186403411} :answer-field/id #uuid "08e22fe2-f723-50fe-bebd-13b95cf25f8f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403406}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4756a526-323c-5723-b76a-e6e75bf42a0d" :question/math-academy-id "q-70851" :question/problem "What is the complex conjugate of $z=-8?$" :question/worked-solution "The number $z=-8$ is a real number, and the complex conjugate of any real number is just the number itself.\n\nSo here, the complex conjugate is $\\overset{―}{z}=z=-8.$"}] [{:db/id #edb/ref 17592186338839 :knowledge-point/_questions [{:db/id #edb/ref 17592186100993 :knowledge-point/id #uuid "92d68c23-6a62-538d-adf1-3a20a474f107" :knowledge-point/title "Determining the Center of a Circle on the Coordinate Plane Using the Midpoint Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "374a13e0-c4ef-55b7-a551-043ef5e6474d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,1)" :db/id #edb/ref 17592186336546} {:answer/id #uuid "412ae379-c8c4-50d9-b5ed-6066e31855b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,3)" :db/id #edb/ref 17592186336642} {:answer/id #uuid "486f65b6-6152-5938-9ae4-da3b0048ebd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,3)" :db/id #edb/ref 17592186336707} {:answer/id #uuid "5c5c5f68-305b-5bce-bd41-324c8e1cafd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,4)" :db/id #edb/ref 17592186336869} {:answer/id #uuid "6a915de0-a52d-596f-a356-93586ed8d331" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,1)" :db/id #edb/ref 17592186336974}] :answer-field/correct {:answer/id #uuid "486f65b6-6152-5938-9ae4-da3b0048ebd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,3)" :db/id #edb/ref 17592186336707} :answer-field/id #uuid "f00e91bc-800b-5e3e-a78d-eac50ba0e44a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338696}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a0db1afa-11c8-5fa4-a567-ed18544e7394" :question/math-academy-id "q-70868" :question/problem "![](images/53/537e4113338eebfe5ee318d35fb43ea2952bdc48b4f02f68b5ef097626b5d2c0.png)\n\nFind the coordinates $(h,k)$ of the center of the circle above given that the points $(0,2)$ and $(8,4)$ lie on a diameter of the circle." :question/worked-solution "The center of the circle is located at the midpoint of the diameter. Therefore, we can calculate it using the midpoint formula:\n\n$$\n\\begin{aligned}(h,k) & =(\\frac{{x}_{1}+{x}_{2}}{2},\\frac{{y}_{1}+{y}_{2}}{2}) \\\\  & =(\\frac{0+8}{2},\\frac{2+4}{2}) \\\\  & =(\\frac{8}{2},\\frac{6}{2}) \\\\  & =(4,3).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338841 :knowledge-point/_questions [{:db/id #edb/ref 17592186115193 :knowledge-point/id #uuid "7995b377-1de4-5126-aa29-8cc30b4918f8" :knowledge-point/title "Finding the Slope of the Tangent at a Point of a Function Involving Reciprocal Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20324c7d-2431-5dbf-89ba-4a62fbbbbdeb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-\\frac{3}{\\pi }" :db/id #edb/ref 17592186336333} {:answer/id #uuid "2d601842-f51f-5a34-901c-3c87ed74673e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{\\pi }-2" :db/id #edb/ref 17592186336467} {:answer/id #uuid "c6ecc1e0-b453-5588-a3e8-923b6e7ebcab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi -2" :db/id #edb/ref 17592186337797} {:answer/id #uuid "ec9d4934-d293-54d1-9eb4-aaf1a8bf5781" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{\\pi }" :db/id #edb/ref 17592186338096} {:answer/id #uuid "ef4a666c-1131-5d8c-a6c2-62062090c6e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{\\pi }+2" :db/id #edb/ref 17592186338125}] :answer-field/correct {:answer/id #uuid "2d601842-f51f-5a34-901c-3c87ed74673e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{\\pi }-2" :db/id #edb/ref 17592186336467} :answer-field/id #uuid "743b193f-17c2-5199-b0eb-adc69b1674c6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338476}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b4b4054a-401d-511c-ba0c-65722b1ecab6" :question/math-academy-id "q-70874" :question/problem "Find the slope of $y=f(x)$ at $x=\\frac{\\pi }{3}$ if $f(x)=ln⁡x+3csc⁡x.$" :question/worked-solution "First, we calculate the derivative using the sum rule:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(ln⁡x+3csc⁡x) \\\\  & =\\frac{1}{x}+3(-csc⁡xcot⁡x) \\\\  & =\\frac{1}{x}-3csc⁡xcot⁡x\\end{aligned}\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{3}$ in the derivative and get\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(\\frac{\\pi }{3}) & =\\frac{1}{(\\frac{\\pi }{3})}-3csc⁡(\\frac{\\pi }{3})cot⁡(\\frac{\\pi }{3}) \\\\  & =\\frac{3}{\\pi }-3(\\frac{2}{\\sqrt{3}})(\\frac{1}{\\sqrt{3}}) \\\\  & =\\frac{3}{\\pi }-3(\\frac{2}{3}) \\\\  & =\\frac{3}{\\pi }-2.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338844 :knowledge-point/_questions [{:db/id #edb/ref 17592186087655 :knowledge-point/id #uuid "82d6988b-3220-578f-ba1c-cd86b9e3dbf9" :knowledge-point/title "Finding the Equation of a Circle Given the Center and the Radius"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5fbf4e0c-e58b-5108-bbb0-4fd59e0d8f51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+1)^{2}+(y-2)^{2}=25" :db/id #edb/ref 17592186336899} {:answer/id #uuid "716b6ec9-6172-5328-9d80-1420c737a11d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-2)^{2}+(y-1)^{2}=25" :db/id #edb/ref 17592186337047} {:answer/id #uuid "a2353a98-7f3f-5dcb-8a84-2f6b9edb5c4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-1)^{2}+(y-2)^{2}=25" :db/id #edb/ref 17592186337504} {:answer/id #uuid "cd350b86-92f1-5b47-8195-38e00e0239ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+1)^{2}+(y+2)^{2}=25" :db/id #edb/ref 17592186337831} {:answer/id #uuid "feac2e41-7550-5e75-ab07-0ad3fc367bb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+2)^{2}+(y+1)^{2}=25" :db/id #edb/ref 17592186338266}] :answer-field/correct {:answer/id #uuid "a2353a98-7f3f-5dcb-8a84-2f6b9edb5c4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-1)^{2}+(y-2)^{2}=25" :db/id #edb/ref 17592186337504} :answer-field/id #uuid "b8cce04b-83c9-5250-85c8-d53e40d3c24a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338613}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4b58a709-693d-534f-9bbe-586e11704f18" :question/math-academy-id "q-70896" :question/problem "![](images/ba/baa279bad56527ad959b2923f25df848396ffc7060c612469d637d4e614117b5.png)\n\nWhat is the equation of the circle given above?" :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is \n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nFrom the picture, we see that our circle is centered at $C(1,2)$ and the radius of the circle is $r=5.$ Therefore, the equation of the circle is\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x-1)^{2}+(y-2)^{2} & ={5}^{2} \\\\ (x-1)^{2}+(y-2)^{2} & =25.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186403412 :knowledge-point/_questions [{:db/id #edb/ref 17592186096616 :knowledge-point/id #uuid "cef7fc21-23f4-5d6a-a208-9963ef23c784" :knowledge-point/title "Calculating the Slope of the Tangent Line of a Logarithmic Function at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c631962-dd2a-53db-b827-84d94e8f7e53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{\\operatorname{ln}⁡10}-3" :db/id #edb/ref 17592186403414} {:answer/id #uuid "8f33e14e-f91d-5c5f-9b34-7c61ede2d34c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{ln}⁡10}+27" :db/id #edb/ref 17592186403415} {:answer/id #uuid "33140677-5da7-59ef-8215-135fba67dffb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3\\operatorname{ln}⁡10}+3" :db/id #edb/ref 17592186403416} {:answer/id #uuid "7fefc24f-ce9e-58b5-aba2-9f2cb372222e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{ln}⁡10}-9" :db/id #edb/ref 17592186403417} {:answer/id #uuid "cc3a5a72-8cb5-5f5c-812b-2114a27a36be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{\\operatorname{ln}⁡10}+9" :db/id #edb/ref 17592186403418}] :answer-field/correct {:answer/id #uuid "8f33e14e-f91d-5c5f-9b34-7c61ede2d34c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{ln}⁡10}+27" :db/id #edb/ref 17592186403415} :answer-field/id #uuid "1fcab4c2-5aab-5cee-8699-609d2431de61" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403413}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ddfac57c-89c4-597b-b080-b0ac4a48d4c1" :question/math-academy-id "q-70903" :question/problem "Given that $y=3\\operatorname{log}⁡x+{x}^{3}-4$, find the slope of the tangent at $x=3.$" :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{3}{x\\operatorname{ln}⁡10}+3{x}^{2}\\,.\n$$\n\nTherefore, the slope of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=3} & ={(\\frac{3}{x\\operatorname{ln}⁡10}+3{x}^{2})|}_{x=3} \\\\  & =\\frac{3}{3\\cdot \\operatorname{ln}⁡10}+3\\cdot {3}^{2} \\\\  & =\\frac{1}{\\operatorname{ln}⁡10}+27\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393050 :knowledge-point/_questions [{:db/id #edb/ref 17592186087656 :knowledge-point/id #uuid "89462485-2e28-5727-82c7-7afd0cac6d77" :knowledge-point/title "Finding the Center and Radius of a Circle Given Its Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "414d2687-cf0f-5475-b4de-9ae0e2a91b57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(-1,-6)$ and radius is $4$" :db/id #edb/ref 17592186393052} {:answer/id #uuid "b904b162-87b0-576b-9c8a-3c647aa88565" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(-1,-6)$ and radius is $16$" :db/id #edb/ref 17592186393053} {:answer/id #uuid "e0376e6b-94e1-5393-8f70-58f85be3025d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(1,6)$ and radius is $4$" :db/id #edb/ref 17592186393054} {:answer/id #uuid "a1fe974f-7739-5447-8c15-65e11281c360" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(1,-6)$ and radius is $4$" :db/id #edb/ref 17592186393055} {:answer/id #uuid "1a4bb814-df36-50ef-990c-594eb222e321" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(1,6)$ and radius is $16$" :db/id #edb/ref 17592186393056}] :answer-field/correct {:answer/id #uuid "414d2687-cf0f-5475-b4de-9ae0e2a91b57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(-1,-6)$ and radius is $4$" :db/id #edb/ref 17592186393052} :answer-field/id #uuid "85727bd6-7f77-5807-aa8a-f0686b43c486" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393051}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fed78696-d1d3-57b4-8aa2-ab1ef29e5f93" :question/math-academy-id "q-70933" :question/problem "What is the center and radius of the circle with equation $(x+1)^{2}+(y+6)^{2}=16?$" :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is \n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nLet's compare the general equation to our equation side-by-side as follows:\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x+1)^{2}+(y+6)^{2} & =16 \\\\ (x-(-1))^{2}+(y-(-6))^{2} & ={4}^{2}.\\end{aligned}\n$$\n\nWe see that $a=-1,$ $b=-6,$ and $r=4.$ \n\nTherefore, the circle is centered at $(-1,-6)$ and its radius is $4.$"}] [{:db/id #edb/ref 17592186338856 :knowledge-point/_questions [{:db/id #edb/ref 17592186100873 :knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd" :knowledge-point/title "Finding an Entry of the Product of Two Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "108d6bbd-0580-5e01-b5da-7d66c9de2677" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "58" :db/id #edb/ref 17592186336189} {:answer/id #uuid "23395dc3-a44d-5e00-8ded-065282a293f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186336360} {:answer/id #uuid "473ce54b-c3d5-51fb-9d6b-a1bfee206728" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186336693} {:answer/id #uuid "6503e9be-0e27-5e84-8fd2-9a826704f72c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186336935} {:answer/id #uuid "ffcf5573-0517-5ba5-b572-8c6b996ce926" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186338275}] :answer-field/correct {:answer/id #uuid "23395dc3-a44d-5e00-8ded-065282a293f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186336360} :answer-field/id #uuid "5d203bbd-ae08-54f5-b289-51a54374a681" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338438}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "01084ebc-a27f-547f-baec-04fae1ac84bf" :question/math-academy-id "q-70958" :question/problem "Let $R=PQ.$ What is the value of ${r}_{25}$, if\n\n$$\nP=[\\begin{aligned}1 & -2 \\\\ 3 & -4 \\\\ 4 & -6 \\\\ 1 & -8 \\\\ 3 & -9\\end{aligned}],\\,Q=[\\begin{aligned}0 & 1 & 2 & -1 & 10 \\\\ 2 & 0 & 5 & -2 & 7\\end{aligned}]?\n$$" :question/worked-solution "Multiplying the $2$nd row of $P$ by the $5$th column of $Q$, we get\n\n$$\n\\begin{aligned}{r}_{25} & =[\\begin{aligned}1 & -2 \\\\ 3 & -4 \\\\ 4 & -6 \\\\ 1 & -8 \\\\ 3 & -9\\end{aligned}][\\begin{aligned}0 & 1 & 2 & -1 & 10 \\\\ 2 & 0 & 5 & -2 & 7\\end{aligned}] \\\\  & =[\\begin{aligned}3 & -4\\end{aligned}][\\begin{aligned}10 \\\\ 7\\end{aligned}] \\\\  & =3\\cdot 10+(-4)\\cdot 7 \\\\  & =30-28 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338867 :knowledge-point/_questions [{:db/id #edb/ref 17592186087657 :knowledge-point/id #uuid "47863922-b0d5-5a0b-8a01-ffefe3b3c929" :knowledge-point/title "Finding the Equation of a Circle Given the Endpoints of a Diameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "301aa6a7-5ee2-5a20-9033-4674a143461b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+3)^{2}+(y+3)^{2}=4" :db/id #edb/ref 17592186336492} {:answer/id #uuid "64b4c7ae-6592-5435-9dcf-3efafb11647a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-3)^{2}+(y-3)^{2}=16" :db/id #edb/ref 17592186336934} {:answer/id #uuid "7faacc68-2956-5fc6-9e73-4fc524688331" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+3)^{2}-(y+3)^{2}=4" :db/id #edb/ref 17592186337190} {:answer/id #uuid "8864933a-7a46-5b44-8a98-d9f22b098b5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-3)^{2}+(y-3)^{2}=4" :db/id #edb/ref 17592186337262} {:answer/id #uuid "ed738468-0ab1-5dc7-96f4-55c16f6a1c9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+3)^{2}+(y+3)^{2}=16" :db/id #edb/ref 17592186338104}] :answer-field/correct {:answer/id #uuid "64b4c7ae-6592-5435-9dcf-3efafb11647a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-3)^{2}+(y-3)^{2}=16" :db/id #edb/ref 17592186336934} :answer-field/id #uuid "a6d043a5-1717-5a07-aecc-41e08ef6bda7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338587}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0ffdebd9-641e-5fc7-a83b-a3474a188cc9" :question/math-academy-id "q-70987" :question/problem "![](images/b6/b6a4e9a8f4a1c6dcaaad453b843896f3fc56ae22a37d481dcb4cfe54cc53361d.png)\n\nThe line segment $\\overset{―}{XY}$ is a diameter of a circle. Given that $X$ and $Y$ have coordinates $(7,3)$ and $(-1,3)$, respectively, what is the equation of the circle?" :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is  \n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nUsing the distance formula to compute the distance between the points $X(7,3)$ and $Y(-1,3),$ we find that the length of the diameter is \n\n$$\n\\begin{aligned}XY & =\\sqrt{{(7-(-1))}^{2}+{(3-3)}^{2}} \\\\  & =\\sqrt{{8}^{2}+{0}^{2}} \\\\  & =\\sqrt{64} \\\\  & =8.\\end{aligned}\n$$\n\nSo the radius of the circle is \n\n$$\nr=\\frac{8}{2}=4.\n$$\n\nSince the center of a circle is the midpoint of the diameter, to find the center we use the midpoint formula as follows:\n\n$$\n(\\frac{{x}_{1}+{x}_{2}}{2},\\frac{{y}_{1}+{y}_{2}}{2})=(\\frac{7+(-1)}{2},\\frac{3+3}{2})=(3,3)\n$$\n\nSo our circle has radius $r=4$ and center $(a,b)=(3,3),$ and therefore it is represented by the following equation:\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x-3)^{2}+(y-3)^{2} & ={4}^{2} \\\\ (x-3)^{2}+(y-3)^{2} & =16\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338869 :knowledge-point/_questions [{:db/id #edb/ref 17592186176050 :knowledge-point/id #uuid "eed0c7c3-0bb5-56eb-a9ca-9ec4dc7b3efe" :knowledge-point/title "Utilizing the Periodicity Property of the Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37934bed-1f9a-50c5-9a8d-e5b0b59e71a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5-5\\pi " :db/id #edb/ref 17592186336549} {:answer/id #uuid "4b39580e-c808-5289-b894-51d8505df304" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\pi " :db/id #edb/ref 17592186336729} {:answer/id #uuid "5de9a8b6-2bf6-5e41-98c3-3ffaa96e81dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186336881} {:answer/id #uuid "81ac5deb-9cc0-5543-8625-93f7cbf3fed8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186337211} {:answer/id #uuid "b2061940-30fc-5eef-a2d6-609b6aeedec0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186337622}] :answer-field/correct {:answer/id #uuid "b2061940-30fc-5eef-a2d6-609b6aeedec0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186337622} :answer-field/id #uuid "0ab98c3a-7c21-528d-8351-dfb2882c1ded" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338295}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "35b95266-3a2f-569f-acd3-81fb0b0052f7" :question/math-academy-id "q-70998" :question/problem "If $tan⁡x=3,$ for some $x$, find the value of $tan⁡(x+5\\pi )+2.$" :question/worked-solution "The period of $y=tan⁡x$ is $\\pi .$ Therefore, for integer $n$ we have\n\n$$\ntan⁡x=tan⁡(x+n\\pi ).\n$$\n\nSubstituting $n=5$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}tan⁡x=tan⁡(x+5\\cdot \\pi )=tan⁡(x+5\\pi ).\\end{aligned}\n$$\n\nTherefore, if $tan⁡x=3,$ we get that $tan⁡(x+5\\pi )=3.$\n\nFinally, then\n\n$$\ntan⁡(x+5\\pi )+2=(3)+2=5.\n$$"}] [{:db/id #edb/ref 17592186338888 :knowledge-point/_questions [{:db/id #edb/ref 17592186064318 :knowledge-point/id #uuid "70029065-69c3-585d-a6a1-cc9d2485a60a" :knowledge-point/title "Applying the Definition of Continuity to Evaluate a Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "144aa466-fc47-529b-95bd-84f4d3861d51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186336223} {:answer/id #uuid "1b9d7eef-900c-52cb-b1c7-b63f1efceae9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186336289} {:answer/id #uuid "93ed488f-6935-56e6-be2e-80f5fbe53a43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186337383} {:answer/id #uuid "a7b36ae3-d363-5e51-90f6-5648576ae0d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186337549} {:answer/id #uuid "faa555a1-33e5-5b0d-9db8-9add99459918" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186338231}] :answer-field/correct {:answer/id #uuid "1b9d7eef-900c-52cb-b1c7-b63f1efceae9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186336289} :answer-field/id #uuid "e590fe1f-5e64-5f83-9bfa-dbf4e8777a47" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338682}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "05c16066-c0df-52d0-bb6d-c89ff088cac5" :question/math-academy-id "q-71070" :question/problem "If $f(x)$ is continuous at $x=0$ and $f(0)=2,$ then what is the value of\n\n$$\n{lim}_{x\\to {0}^{+}}{({(f(x))}^{2}-3)}^{2}\\,?\n$$" :question/worked-solution "We're told that $f(x)$ is continuous at $x=0.$ According to the definition of continuity, this means that ${lim}_{x\\to 0}f(x)$ exists, and\n\n$$\n{lim}_{x\\to {0}^{+}}f(x)=f(0)=2.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}{({(f(x))}^{2}-3)}^{2} & ={({2}^{2}-3)}^{2}={1}^{2}=1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338889 :knowledge-point/_questions [{:db/id #edb/ref 17592186064318 :knowledge-point/id #uuid "70029065-69c3-585d-a6a1-cc9d2485a60a" :knowledge-point/title "Applying the Definition of Continuity to Evaluate a Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ebd0c10-a6d6-5cc9-a5c9-ddcd47d050cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186336759} {:answer/id #uuid "507f8e57-664f-5400-bbd8-d4a57da67ea3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186336770} {:answer/id #uuid "6645f6bd-0246-5646-be59-dcadbe943286" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186336944} {:answer/id #uuid "85e73ccf-7925-5618-8951-5d04909c6605" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186337242} {:answer/id #uuid "8b5a9a94-cb73-580d-9c82-f44e0061dd54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186337294}] :answer-field/correct {:answer/id #uuid "6645f6bd-0246-5646-be59-dcadbe943286" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186336944} :answer-field/id #uuid "6565ac07-4add-5790-8623-4f26a36b8a37" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338457}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e4f90488-b0ea-572b-b9cc-768b8c7e07c2" :question/math-academy-id "q-71071" :question/problem "If $f(x)$ is continuous at $x=4$ and $f(4)=2,$ then what is ${lim}_{x\\to 4}{({x}^{2}-6f(x))}^{2}?$" :question/worked-solution "We're told that $f(x)$ is continuous at $x=4.$ According to the definition of continuity, this means that ${lim}_{x\\to 4}f(x)$ exists, and\n\n$$\n{lim}_{x\\to 4}f(x)=f(4)=2.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to 4}{({x}^{2}-6f(x))}^{2} & ={({4}^{2}-6(2))}^{2} \\\\  & ={(16-12)}^{2} \\\\  & ={4}^{2} \\\\  & =16.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338891 :knowledge-point/_questions [{:db/id #edb/ref 17592186064317 :knowledge-point/id #uuid "fa1ddb40-3494-541c-b23e-b15dd98bf669" :knowledge-point/title "Identifying the Reason for a Discontinuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53623a55-b77d-5351-9fc2-d973dfa306f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(-1)$ does not exist" :db/id #edb/ref 17592186336802} {:answer/id #uuid "79c71031-97e9-5e1d-a6ba-e74f9e41cc73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to (-1)}f(x)\\ne f(-1)" :db/id #edb/ref 17592186337129} {:answer/id #uuid "976f1ad0-705e-5259-a60b-4f7ca8ac9ef3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${lim}_{x\\to (-1)^{-}}f(x)$ does not exist" :db/id #edb/ref 17592186337413} {:answer/id #uuid "aaa26b4e-cfda-5c6f-8638-0760a72b3b60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${lim}_{x\\to (-1)^{+}}f(x)$ does not exist" :db/id #edb/ref 17592186337570} {:answer/id #uuid "fb13ed6b-6c19-5ee0-9d99-95a01f90eaeb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${lim}_{x\\to (-1)}f(x)$ does not exist" :db/id #edb/ref 17592186338236}] :answer-field/correct {:answer/id #uuid "79c71031-97e9-5e1d-a6ba-e74f9e41cc73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to (-1)}f(x)\\ne f(-1)" :db/id #edb/ref 17592186337129} :answer-field/id #uuid "af56593a-6a9e-589a-b62d-3c3c78f2abea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338599}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c90a0801-6b26-5a6a-b72a-693261024597" :question/math-academy-id "q-71079" :question/problem "For what reason does the function $f(x)$ given below have a discontinuity at $x=-1?$\n\n$$\nf(x)={\\begin{aligned}\\frac{{x}^{2}+1}{2}, & x<-1 \\\\ 2, & x=-1 \\\\ \\frac{2}{{x}^{2}+1}, & x>-1\\end{aligned}\n$$" :question/worked-solution "Let's check the conditions necessary for $f(x)$ to be continuous at $x=-1.$\n\n- $f(-1)=2,$ so $f(-1)$ exists. $✓$\n\n- We calculate the one-sided limits and check if they coincide:\n\n$$\n\\begin{aligned}{lim}_{x\\to (-1)^{-}}f(x) & ={lim}_{x\\to (-1)^{-}}(\\frac{{x}^{2}+1}{2}) \\\\  & =\\frac{(-1)^{2}+1}{2} \\\\  & =\\frac{1+1}{2} \\\\  & =1, \\\\ {lim}_{x\\to (-1)^{+}}f(x) & ={lim}_{x\\to (-1)^{+}}(\\frac{2}{{x}^{2}+1}) \\\\  & =\\frac{2}{(-1)^{2}+1} \\\\  & =\\frac{2}{1+1} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the overall limit exists and ${lim}_{x\\to (-1)}f(x)=1$ $✓$\n\n- The limit of the function is not equal to the function value: ${lim}_{x\\to (-1)}f(x)=1,$ while $f(-1)=2.$ $\\,\\,\\times $\n\nTherefore, the function $f(x)$ has a discontinuity at $x=-1$ because ${lim}_{x\\to (-1)}f(x)\\ne f(-1).$"}] [{:db/id #edb/ref 17592186338897 :knowledge-point/_questions [{:db/id #edb/ref 17592186064263 :knowledge-point/id #uuid "43e68991-37f0-543e-a4da-b78b395a8494" :knowledge-point/title "Determining the Position of a Particle Given Its Acceleration, Initial Velocity and Initial Position"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2aefedc4-27d9-54a2-8573-f51f9d7f581c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)={t}^{2}+{t}^{3}+4t+2." :db/id #edb/ref 17592186336434} {:answer/id #uuid "64a7cf2e-743a-5ae9-a3b3-39dd959007fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)=\\frac{1}{2}{t}^{2}-{t}^{3}+4t+2" :db/id #edb/ref 17592186336933} {:answer/id #uuid "664f4703-f165-5d27-b633-1b56ff447e32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)={t}^{2}-{t}^{3}+2t+2." :db/id #edb/ref 17592186336945} {:answer/id #uuid "72c9134b-e660-5c5c-bc37-f07120bfc930" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)=\\frac{1}{2}{t}^{2}-{t}^{3}+6t." :db/id #edb/ref 17592186337064} {:answer/id #uuid "c1585c37-ef87-5746-8692-9db319d1ee04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)=\\frac{1}{2}{t}^{2}+{t}^{3}+6t-2." :db/id #edb/ref 17592186337750}] :answer-field/correct {:answer/id #uuid "64a7cf2e-743a-5ae9-a3b3-39dd959007fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)=\\frac{1}{2}{t}^{2}-{t}^{3}+4t+2" :db/id #edb/ref 17592186336933} :answer-field/id #uuid "52dd2f56-1deb-5ef5-bceb-35cca96b6e4b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338420}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ba22cd98-5399-5a26-89d7-865b0c3ece95" :question/math-academy-id "q-7111" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with acceleration $a(t)=1-6t,$ where $t\\ge 0$ is the time. If the particle has position $x=2$ and velocity $v=4$ when $t=0,$ calculate the position $x$ of the particle at time $t>0.$" :question/worked-solution "We start by integrating the acceleration to get the velocity $v(t):$\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int (1-6t)\\,\\text{d}t \\\\  & =t-3{t}^{2}+C\\end{aligned}\n$$\n\nTo determine $C,$ we use the fact that $v(0)=4.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}4 & =(0)-3(0)^{2}+C \\\\ C & =4.\\end{aligned}\n$$\n\nSo the velocity is given by $v(t)=t-3{t}^{2}+4.$\n\nNow, we integrate the velocity to get $x(t):$\n\n$$\n\\begin{aligned}x(t) & =\\int v(t)\\,\\text{d}t \\\\  & =\\int (t-3{t}^{2}+4)\\,\\text{d}t \\\\  & =\\frac{1}{2}{t}^{2}-{t}^{3}+4t+K\\end{aligned}\n$$\n\nTo determine $K,$ we use the fact that $x(0)=2.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}2 & =\\frac{1}{2}(0)^{2}-(0)^{3}+4(0)+K \\\\ K & =2.\\end{aligned}\n$$\n\nTherefore, the position $x$ of the particle at time $t$ is \n\n$$\nx(t)=\\frac{1}{2}{t}^{2}-{t}^{3}+4t+2.\n$$"}] [{:db/id #edb/ref 17592186338904 :knowledge-point/_questions [{:db/id #edb/ref 17592186105734 :knowledge-point/id #uuid "9331987e-8676-5bdb-b4ce-2129b1b09a8c" :knowledge-point/title "Calculating the Altitude of a Triangle Given Its Vertices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f3c7d45-2508-558a-a671-704a2f709aa7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186336627} {:answer/id #uuid "733fefab-043d-5fe4-93ed-cf5c6a3298cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt{2}" :db/id #edb/ref 17592186337070} {:answer/id #uuid "ca0454d2-6cd6-50e2-9a7f-17ac15f3a137" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{6}" :db/id #edb/ref 17592186337812} {:answer/id #uuid "d3fb8394-0a4f-5554-bef2-b4565678aeac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186337886} {:answer/id #uuid "f7adc41f-f450-52b1-9898-009b7b23875a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186338203}] :answer-field/correct {:answer/id #uuid "d3fb8394-0a4f-5554-bef2-b4565678aeac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186337886} :answer-field/id #uuid "c1e3142c-b7af-51c6-a353-db8d28d28403" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338622}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6da0a984-327a-597f-9055-73fa298d90dc" :question/math-academy-id "q-71128" :question/problem "Calculate the length of the altitude $DH$ of the $△\\,DMA$, if $D(-1,2,1)$, $M(-1,0,-1)$, $A(1,-2,1).$" :question/worked-solution "Note that the length of the altitude $DH$ can be related to the area of $△\\,DMA$ as follows:\n\n$$\n{A}_{△}=\\frac{1}{2}DH\\cdot MA\n$$\n\nSo, to find $DH,$ we first find ${A}_{△}.$ To start, we find the vectors $\\overset{\\to }{MD}$ and $\\overset{\\to }{MA}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{MD} & =d-m \\\\  & =(-i+2j+k)-(-i-k) \\\\  & =2j+2k \\\\  & =⟨0,2,2⟩ \\\\ \\overset{\\to }{MA} & =a-m \\\\  & =(i-2j+k)-(-i-k) \\\\  & =2i-2j+2k \\\\  & =⟨2,-2,2⟩\\end{aligned}\n$$\n\nNow, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{MD}\\times \\overset{\\to }{MA} & =|\\begin{aligned}i & j & k \\\\ 0 & 2 & 2 \\\\ 2 & -2 & 2\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 2 \\\\ -2 & 2\\end{aligned}|i-|\\begin{aligned}0 & 2 \\\\ 2 & 2\\end{aligned}|j+|\\begin{aligned}0 & 2 \\\\ 2 & -2\\end{aligned}|k \\\\  & =(2\\cdot 2-(-2)\\cdot 2)i-(0\\cdot 2-2\\cdot 2)j+(0\\cdot (-2)-2\\cdot 2)k \\\\  & =8i+4j-4k \\\\  & =⟨8,4,-4⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{MD}$ and $\\overset{\\to }{MA}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{MD}\\times \\overset{\\to }{MA}| \\\\  & =\\sqrt{{8}^{2}+{4}^{2}+(-4)^{2}} \\\\  & =\\sqrt{96} \\\\  & =4\\sqrt{6}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,DMA$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{4\\sqrt{6}}{2}=2\\sqrt{6}.\n$$\n\nLet's also compute $MA$ since it appears in the formula:\n\n$$\n\\begin{aligned}MA & =|\\overset{\\to }{MA}| \\\\  & =\\sqrt{{2}^{2}+(-2)^{2}+{2}^{2}} \\\\  & =\\sqrt{12} \\\\  & =2\\sqrt{3}.\\end{aligned}\n$$\n\n \n\nFinally, using the formula ${A}_{△}=\\frac{1}{2}DH\\cdot MA,$ we get\n\n$$\n\\begin{aligned}{A}_{△} & =\\frac{1}{2}DH\\cdot MA \\\\ 2\\sqrt{6} & =\\frac{1}{2}DH\\cdot 2\\sqrt{3} \\\\ 2\\sqrt{6} & =DH\\cdot \\sqrt{3} \\\\ DH & =\\frac{2\\sqrt{6}}{\\sqrt{3}} \\\\ DH & =2\\sqrt{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186176559 :knowledge-point/_questions [{:db/id #edb/ref 17592186175952 :knowledge-point/id #uuid "be9ac99c-424e-5e90-b26f-c26e4da704d7" :knowledge-point/title "Finding the Final Position of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62be3c05-a4ae-5efb-9948-679341242985" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "92" :db/id #edb/ref 17592186336919} {:answer/id #uuid "8405c10d-b8b6-5c71-8189-17737f465d6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "105" :db/id #edb/ref 17592186337224} {:answer/id #uuid "88db8cb5-299e-5069-9bcf-7be99175abe6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186337266} {:answer/id #uuid "8a915290-5bd6-518d-95de-cb51f1f093a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "97" :db/id #edb/ref 17592186337282} {:answer/id #uuid "bea68b0e-1b25-5071-ad8e-8a44fba3ec1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "93" :db/id #edb/ref 17592186337727}] :answer-field/correct {:answer/id #uuid "8405c10d-b8b6-5c71-8189-17737f465d6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "105" :db/id #edb/ref 17592186337224} :answer-field/id #uuid "740967d6-ac89-5f9b-b1f3-bcaa5e18f367" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338475}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f38c2d58-f071-5d09-92ca-36e11adfb46f" :question/math-academy-id "q-7113" :question/problem "A particle $P$ moves along the $x$-axis and its velocity at time $t>0$ is given by $v(t)=4t+3{t}^{2}.$ At time $t=1$ the particle is located at the position $x=12.$ What is the position of the particle at time $t=4?$" :question/requires-calculator true :question/worked-solution "The position of the particle at $t=4$ is equal to its position at $t=1$ plus the total displacement over $t\\in [1,4].$ Therefore, we can calculate it as follows:\n\n$$\nx(4)=x(1)+{\\int }_{1}^{4}v(t)\\,\\text{d}t\n$$\n\nCarrying out the computations, we get\n\n$$\n\\begin{aligned}x(4) & =12+{\\int }_{1}^{4}(4t+3{t}^{2})\\text{d}t \\\\  & =12+[2{t}^{2}+{t}^{3}]_{1}^{4} \\\\  & =12+([2(4)^{2}+{4}^{3}]-[2(1)^{2}+{1}^{3}]) \\\\  & =12+([32+64]-[2+1]) \\\\  & =12+(96-3) \\\\  & =12+93 \\\\  & =105\\end{aligned}\n$$\n\nSo the position of the particle at $t=4$ is $x=105.$"}] [{:db/id #edb/ref 17592186403461 :knowledge-point/_questions [{:db/id #edb/ref 17592186068900 :knowledge-point/id #uuid "66ade855-4b16-514b-b44a-1d6b9d61ef28" :knowledge-point/title "Identifying the Shift Applied to an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8efb215-a4e3-57a5-9c28-aeceec68ab3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}+2" :db/id #edb/ref 17592186403463} {:answer/id #uuid "dc7c1d24-77af-5b22-8748-eb78e3181bee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}-3" :db/id #edb/ref 17592186403464} {:answer/id #uuid "ac8a280a-f3e5-57ca-a313-b4a7d3f28178" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}" :db/id #edb/ref 17592186403465} {:answer/id #uuid "2e259bca-b084-538c-98c1-c8f9fb1db908" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}+3" :db/id #edb/ref 17592186403466} {:answer/id #uuid "54400882-3ae8-5fef-9856-f37d1e3a6878" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}-2" :db/id #edb/ref 17592186403467}] :answer-field/correct {:answer/id #uuid "d8efb215-a4e3-57a5-9c28-aeceec68ab3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}+2" :db/id #edb/ref 17592186403463} :answer-field/id #uuid "153448b6-9533-5575-9ff3-816d932b2ca7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403462}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d28d182e-64fa-5ae5-be71-7e9fd891464e" :question/math-academy-id "q-7124" :question/problem "![](images/1a/1a54cae748796775b76ade4d9060d4eafe6bb84fd45ce725bd516a7db2681ba9.png)\n\nThe graph above shows the curve $y={(\\frac{1}{3})}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={(\\frac{1}{3})}^{x}$ is $y=0.$ \n\nThe vertical translation $y={(\\frac{1}{3})}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=2.$ Therefore, $c=2.$"}] [{:db/id #edb/ref 17592186338954 :knowledge-point/_questions [{:db/id #edb/ref 17592186087859 :knowledge-point/id #uuid "30bb1401-f704-520c-a23e-5a238e44960e" :knowledge-point/title "Finding the Equation of a Circle Given a Description"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f9ae437-1d85-50ec-958b-e8760b5b0e64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=125" :db/id #edb/ref 17592186336328} {:answer/id #uuid "308f53c4-2ae7-55da-984b-1a65d78f95cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=25" :db/id #edb/ref 17592186336497} {:answer/id #uuid "73254016-15bc-578d-98b1-e2110dfab2dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=75" :db/id #edb/ref 17592186337068} {:answer/id #uuid "90833b0d-0556-5041-9d09-6af44e6c3d8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=5" :db/id #edb/ref 17592186337342} {:answer/id #uuid "a58f261c-1656-5a28-9ad6-6ecc994c1001" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=10" :db/id #edb/ref 17592186337535}] :answer-field/correct {:answer/id #uuid "308f53c4-2ae7-55da-984b-1a65d78f95cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=25" :db/id #edb/ref 17592186336497} :answer-field/id #uuid "064b2f2d-b064-5112-8c60-48e6b84edd0a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338286}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e777ee84-35c1-5291-bae1-8ca4f484b4c9" :question/math-academy-id "q-71506" :question/problem "Which equation describes the set of all points $(x,y)$ in the coordinate plane that are $5$ units away from the origin?" :question/worked-solution "The set of all points $(x,y)$ that are a distance $5$ from the origin defines a circle with radius $r=5$ centered at the origin, as shown below.\n\n![](images/39/398adead10233d1af61cd9aa44f14d51eba9c195d30c9d6b16015a3391403908.png)\n\nSo, the required equation is\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & ={r}^{2} \\\\ {x}^{2}+{y}^{2} & ={5}^{2} \\\\ {x}^{2}+{y}^{2} & =25.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083920 :knowledge-point/_questions [{:db/id #edb/ref 17592186083254 :knowledge-point/id #uuid "646467d1-f764-5a3c-b03b-7d74e588611d" :knowledge-point/title "Calculating the Speed of a Particle at a Given Time"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28186592-08bc-549e-9c22-c79ee3ea6745" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186336408} {:answer/id #uuid "3025f42b-c5db-534a-b7db-5eb1874e4c83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186336493} {:answer/id #uuid "61f846a2-1971-5874-84e8-c682412f989c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186336914} {:answer/id #uuid "7bbd7131-4a34-5bb1-b11e-243d31511be7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{5}" :db/id #edb/ref 17592186337150} {:answer/id #uuid "a724f86f-6e25-582e-8cc1-02e5086a17ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}" :db/id #edb/ref 17592186337545}] :answer-field/correct {:answer/id #uuid "61f846a2-1971-5874-84e8-c682412f989c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186336914} :answer-field/id #uuid "3f0ed294-f84f-5efe-be0c-4f49c2d7af7f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338389}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6995c088-70db-5fcb-a926-3a5bb8ce6736" :question/math-academy-id "q-7151" :question/problem "The position vector $r$ of a particle $P$ (relative to a fixed origin $O$) at time $t$ is given by\n\n$$\nr=⟨\\frac{{t}^{2}}{2},\\,3t+7⟩,\\,t>0.\n$$\n\nCalculate the speed of the particle at time $t=4.$" :question/worked-solution "First, we calculate the velocity vector $v.$ Differentiating the position vector, we get\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(\\frac{{t}^{2}}{2}),\\frac{\\text{d}}{\\text{d}t}(3t+7)⟩ \\\\  & =⟨t,3⟩.\\end{aligned}\n$$\n\nTo find the velocity when $t=4,$ we substitute in the above:\n\n$$\nv=⟨4,3⟩\n$$\n\nTo find the speed at $t=4$ we calculate the magnitude of $v(4),$ and we get\n\n$$\n\\begin{aligned}|v(4)| & =\\sqrt{{4}^{2}+{3}^{2}} \\\\  & =\\sqrt{16+9} \\\\  & =\\sqrt{25} \\\\  & =5.\\end{aligned}\n$$\n\nSo, the speed when $t=4$ is $5.$"}] [{:db/id #edb/ref 17592186338957 :knowledge-point/_questions [{:db/id #edb/ref 17592186092384 :knowledge-point/id #uuid "4a05f6c0-98ab-5197-922e-8e8dff1d4302" :knowledge-point/title "Calculating the Slope of a Normal Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "105a0ee2-ecfe-5f6b-abf3-c2b8990ff5e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186336186} {:answer/id #uuid "8afbf511-93b1-574c-aea0-f719ed534072" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186337288} {:answer/id #uuid "9b55a9ee-2b2e-5710-b96a-5529ce814f84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186337440} {:answer/id #uuid "b83a05a7-995d-5078-bf9a-4b58abb10a90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186337665} {:answer/id #uuid "e2cfabde-266f-53a5-a5bf-2a8c9659561a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186338007}] :answer-field/correct {:answer/id #uuid "105a0ee2-ecfe-5f6b-abf3-c2b8990ff5e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186336186} :answer-field/id #uuid "fb39a159-1af8-51a3-9955-b31d00f03bbf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338721}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0b93f0c3-f4cf-5391-8374-d4b6970c54ae" :question/math-academy-id "q-71524" :question/problem "Find the slope of the normal line to the curve $y={x}^{2}-5$ at the point $(2,-1).$" :question/worked-solution "Let $f(x)={x}^{2}-5.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}({x}^{2}-5)=2x\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(2,-1):$\n\n$$\n\\begin{aligned}m={f}^{′}(2)=2(2)=4\\end{aligned}\n$$\n\nTherefore, the slope of the normal line ${m}^{′}$ is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{4}.\n$$"}] [{:db/id #edb/ref 17592186088284 :knowledge-point/_questions [{:db/id #edb/ref 17592186087763 :knowledge-point/id #uuid "9ec9e0af-bbdc-5a29-bdbb-602e4d1f016a" :knowledge-point/title "Finding the Acceleration Vector of a Particle Given Its Velocity Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94c87ef4-516b-5fd3-946b-8f9c62c98016" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a = ⟨5, 2t⟩" :db/id #edb/ref 17592186086359} {:answer/id #uuid "9e58aea6-19dc-5488-bc80-93d7632e221f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a = ⟨ - 8, 4⟩" :db/id #edb/ref 17592186086360} {:answer/id #uuid "39afe4ac-830b-58c4-b06b-d3fb4983f0bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a = ⟨5t, 2t^{2}⟩" :db/id #edb/ref 17592186086361} {:answer/id #uuid "5f00365e-8d58-5b9f-b448-aa58586fbb31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a = ⟨5, 4t⟩" :db/id #edb/ref 17592186086362} {:answer/id #uuid "6586d8bf-7a12-561b-af59-2bdb282646dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a = ⟨5, 2⟩" :db/id #edb/ref 17592186086363}] :answer-field/id #uuid "c8eeedcb-7380-5490-8e80-bea8245eee54" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086358} {:answer-field/choices [{:answer/id #uuid "2ed876eb-e8b1-58fc-a7c7-49ce58aab2a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=⟨-8,\\,4⟩" :db/id #edb/ref 17592186393148} {:answer/id #uuid "6c9432b2-20cf-5e0d-b627-365bf8bb517b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=⟨5t,\\,2{t}^{2}⟩" :db/id #edb/ref 17592186393149} {:answer/id #uuid "5aeefe63-a288-5b47-85c7-d2a2775613d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=⟨5,\\,2t⟩" :db/id #edb/ref 17592186393150} {:answer/id #uuid "ee5fa715-a949-54b8-a77a-babd9c98996a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=⟨5,\\,4t⟩" :db/id #edb/ref 17592186393151} {:answer/id #uuid "5f894125-91dc-5e2c-bd9f-0d467b5542d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=⟨5,\\,2⟩" :db/id #edb/ref 17592186393152}] :answer-field/correct {:answer/id #uuid "ee5fa715-a949-54b8-a77a-babd9c98996a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=⟨5,\\,4t⟩" :db/id #edb/ref 17592186393151} :answer-field/id #uuid "78dfd377-d2e6-5c1a-8aa3-e854870d70f7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393147}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fca59699-e72b-5149-821a-1daf54baaef5" :question/math-academy-id "q-7156" :question/problem "The velocity vector $v=⟨u,v⟩$ of a particle $P$ at time $t$ is given by\n\n$$\nv=⟨5t-8,\\,2{t}^{2}+4⟩.\n$$\n\nCalculate the acceleration vector $a.$" :question/worked-solution "To compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(5t-8),\\,\\frac{\\text{d}}{\\text{d}t}(2{t}^{2}+4)⟩ \\\\  & =⟨5,\\,4t⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393160 :knowledge-point/_questions [{:db/id #edb/ref 17592186087764 :knowledge-point/id #uuid "380357c3-4914-5137-9449-0e02076cb248" :knowledge-point/title "Finding the Acceleration Vector of a Particle Given Its Position Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5bb87f44-9e54-547c-bf05-ae2ff892adc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=⟨4{t}^{3},\\,6⟩" :db/id #edb/ref 17592186393162} {:answer/id #uuid "9e4c5bec-76b9-51aa-955d-d6d64eddf07d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=⟨6{t}^{3},\\,4⟩" :db/id #edb/ref 17592186393163} {:answer/id #uuid "783f3cce-1dea-53dc-8a90-43631ed18539" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=⟨{t}^{4},\\,3t⟩" :db/id #edb/ref 17592186393164} {:answer/id #uuid "08c13741-b540-5324-ade7-9e8d1017f6ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=⟨{t}^{3},\\,3⟩" :db/id #edb/ref 17592186393165} {:answer/id #uuid "beb86fd9-f93a-555f-a0ac-cfee71d85783" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=⟨4{t}^{3},\\,6t⟩" :db/id #edb/ref 17592186393166}] :answer-field/correct {:answer/id #uuid "5bb87f44-9e54-547c-bf05-ae2ff892adc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=⟨4{t}^{3},\\,6⟩" :db/id #edb/ref 17592186393162} :answer-field/id #uuid "f76bc762-0563-53c1-a43e-9693c4d41279" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393161}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "018374cc-40c9-5d0d-a1b9-641708c13290" :question/math-academy-id "q-7165" :question/problem "The position vector $r$ of a particle $P$ (relative to a fixed origin $O$) at time $t$ is given by\n\n$$\nr=⟨\\frac{{t}^{5}}{5},\\,3{t}^{2}-1⟩.\n$$\n\nCalculate the acceleration vector $a.$" :question/worked-solution "To compute the acceleration vector, we need to differentiate the velocity vector. So first, we need to compute the velocity vector, which we can do this by differentiating the position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(\\frac{{t}^{5}}{5}),\\,\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}-1)⟩ \\\\  & =⟨{t}^{4},\\,6t⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{4}),\\,\\frac{\\text{d}}{\\text{d}t}(6t)⟩ \\\\  & =⟨4{t}^{3},\\,6⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393167 :knowledge-point/_questions [{:db/id #edb/ref 17592186105702 :knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f" :knowledge-point/title "Calculating a Vector Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b3a993e-29b5-59cb-99e5-ded901d8bd0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,0,0⟩" :db/id #edb/ref 17592186393169} {:answer/id #uuid "c7002ec2-9546-5f0e-821c-ebe64ba0bd6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{4}{19},\\frac{12}{19},-\\frac{12}{19}⟩" :db/id #edb/ref 17592186393170} {:answer/id #uuid "7366fd93-b330-5afb-bffc-fc0a9d70dc12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{1}{5},\\frac{2}{5},-\\frac{1}{5}⟩" :db/id #edb/ref 17592186393171} {:answer/id #uuid "3da3af95-6571-5bb0-ac07-5accef6e0a78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186393172} {:answer/id #uuid "736a78cf-613a-5d25-a09d-d0901781721f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{3}{17},\\frac{1}{17},\\frac{1}{17}⟩" :db/id #edb/ref 17592186393173}] :answer-field/correct {:answer/id #uuid "c7002ec2-9546-5f0e-821c-ebe64ba0bd6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{4}{19},\\frac{12}{19},-\\frac{12}{19}⟩" :db/id #edb/ref 17592186393170} :answer-field/id #uuid "81ed75df-1ce1-5ebc-81a9-b722c6382e6e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393168}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4a5f805d-9915-543e-b3c6-5d61cd49da57" :question/math-academy-id "q-71662" :question/problem "Let $c=[\\begin{aligned}1 \\\\ 2 \\\\ 1\\end{aligned}]$ and $d=[\\begin{aligned}1 \\\\ 3 \\\\ -3\\end{aligned}].$ Find the vector projection of $c$ onto $d.$" :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{d}\\,c & =\\frac{c\\cdot d}{d\\cdot d}d \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}d \\\\  & =\\frac{1\\cdot 1+2\\cdot 3+1\\cdot (-3)}{{1}^{2}+{3}^{2}+(-3)^{2}}d \\\\  & =\\frac{4}{19}⟨1,3,-3⟩ \\\\  & =⟨\\frac{4}{19},\\frac{12}{19},-\\frac{12}{19}⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338970 :knowledge-point/_questions [{:db/id #edb/ref 17592186064181 :knowledge-point/id #uuid "9836abbe-e172-5c2f-8b19-145ef6d5c02d" :knowledge-point/title "Integrating Cosecant Squared"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b98751b-5a6f-5701-a079-66efabd0c54e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3tan⁡y+C" :db/id #edb/ref 17592186336591} {:answer/id #uuid "6c064b7d-ae95-54c0-99a2-5b48ab4e6e2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3cot⁡y+C" :db/id #edb/ref 17592186336987} {:answer/id #uuid "898bc83c-2d65-5f25-8fe3-14152653f4f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3tan⁡y+C" :db/id #edb/ref 17592186337272} {:answer/id #uuid "bab226dc-1012-58ab-b0e7-c57b6031dacd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3cot⁡y+C" :db/id #edb/ref 17592186337686} {:answer/id #uuid "fe8ec3ab-b777-58b0-80b5-c49a97bea68f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3csc⁡ycot⁡y+C" :db/id #edb/ref 17592186338265}] :answer-field/correct {:answer/id #uuid "6c064b7d-ae95-54c0-99a2-5b48ab4e6e2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3cot⁡y+C" :db/id #edb/ref 17592186336987} :answer-field/id #uuid "0033f394-fd38-57df-b724-8ce5cc5ff702" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338279}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2e4929ca-7804-5d00-ada3-f06fc525c774" :question/math-academy-id "q-71663" :question/problem "$\\int -3{csc}^{2}⁡y\\,\\text{d}y=$" :question/worked-solution "Recall that \n\n$$\n\\int {csc}^{2}⁡y\\,\\text{d}y=-cot⁡y+C\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int -3{csc}^{2}⁡y\\,\\text{d}y & =-3\\int {csc}^{2}⁡y\\,\\text{d}y \\\\  & =-3(-cot⁡y)+C \\\\  & =3cot⁡y+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338971 :knowledge-point/_questions [{:db/id #edb/ref 17592186064181 :knowledge-point/id #uuid "9836abbe-e172-5c2f-8b19-145ef6d5c02d" :knowledge-point/title "Integrating Cosecant Squared"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29f94094-a13e-59d3-8e01-6476ad259936" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sec⁡ytan⁡y+C" :db/id #edb/ref 17592186336421} {:answer/id #uuid "4bbf7e18-db54-5ad4-94b3-6740e294fa86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "tan⁡y+C" :db/id #edb/ref 17592186336736} {:answer/id #uuid "5a246749-d6a8-5b61-ab0c-eb37e92ba4e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-tan⁡y+C" :db/id #edb/ref 17592186336853} {:answer/id #uuid "7eef5879-dbe7-5b97-97a6-26e4a74a9d5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cot⁡y+C" :db/id #edb/ref 17592186337182} {:answer/id #uuid "cbbba5ec-56d3-5218-abf9-36a5e07211a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-cot⁡y+C" :db/id #edb/ref 17592186337821}] :answer-field/correct {:answer/id #uuid "7eef5879-dbe7-5b97-97a6-26e4a74a9d5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cot⁡y+C" :db/id #edb/ref 17592186337182} :answer-field/id #uuid "709f437f-6931-5254-8a8a-e5df59c326ec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338469}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e6d46060-4d10-5e18-98aa-e065865069a6" :question/math-academy-id "q-71664" :question/problem "$\\int -{csc}^{2}⁡y\\,\\text{d}y=$" :question/worked-solution "Recall that \n\n$$\n\\int {csc}^{2}⁡y\\,\\text{d}y=-cot⁡y+C\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int -{csc}^{2}⁡y\\,\\text{d}y & =-\\int {csc}^{2}⁡y\\,\\text{d}y \\\\  & =-(-cot⁡y)+C \\\\  & =cot⁡y+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064946 :knowledge-point/_questions [{:db/id #edb/ref 17592186064371 :knowledge-point/id #uuid "45b380ed-1974-5876-8c88-a45773741b48" :knowledge-point/title "Calculating the Speed of a Particle at a Particular Moment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "899c0898-cc24-5360-b626-1256d90ee17e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.5cm/s" :db/id #edb/ref 17592186063733} {:answer/id #uuid "c6aaecc1-1a6e-5ad3-9010-833d1cbbb472" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.0cm/s" :db/id #edb/ref 17592186063734} {:answer/id #uuid "d2a83fe4-2550-5f4e-bded-f0e0495d3bad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5cm/s" :db/id #edb/ref 17592186063735} {:answer/id #uuid "1db5a007-393b-5b2a-820b-7b0e9ee282a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.0cm/s" :db/id #edb/ref 17592186063736} {:answer/id #uuid "3d517248-0d79-5d46-92c9-c67e3e69e7db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.0cm/s" :db/id #edb/ref 17592186063737}] :answer-field/id #uuid "1533643d-1ad3-5fcd-8671-813502553b72" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186063732} {:answer-field/choices [{:answer/id #uuid "309fb741-f2ee-5d42-a410-6d3722af473d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.5\\,\\text{cm/s}" :db/id #edb/ref 17592186393175} {:answer/id #uuid "0ba94734-6539-5f8b-b9fa-953023f4379c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5\\,\\text{cm/s}" :db/id #edb/ref 17592186393176} {:answer/id #uuid "827e042d-b06c-59c7-b91a-f5e840050abb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.0\\,\\text{cm/s}" :db/id #edb/ref 17592186393177} {:answer/id #uuid "dafb3fc0-f6a1-5617-964a-36080cd6f04c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.0\\,\\text{cm/s}" :db/id #edb/ref 17592186393178} {:answer/id #uuid "577baa3c-ff60-5e2e-9451-c051fd6e20b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.0\\,\\text{cm/s}" :db/id #edb/ref 17592186393179}] :answer-field/correct {:answer/id #uuid "0ba94734-6539-5f8b-b9fa-953023f4379c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5\\,\\text{cm/s}" :db/id #edb/ref 17592186393176} :answer-field/id #uuid "89bc4a65-3fa0-525a-8a5b-ebdeb649b1a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393174}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c20eb755-854c-51a7-aed2-16e438744a82" :question/math-academy-id "q-7175" :question/problem "The position $s(t)$ of a particle (in centimeters) at time $t$ seconds is given by \n\n$$\ns(t)=\\frac{5t-10}{t},\\,t>0.\n$$\n\nCalculate the speed of the particle when $t=2\\,\\text{s}.$" :question/requires-calculator true :question/worked-solution "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{5t-10}{t}) \\\\  & =\\frac{10}{{t}^{2}}\\end{aligned}\n$$\n\nWhen $t=2,$ the velocity is\n\n$$\nv(2)=\\frac{10}{(2)^{2}}=\\frac{10}{4}=2.5.\n$$\n\nTherefore, the speed is $|2.5|=2.5\\,\\text{cm/s}.$"}] [{:db/id #edb/ref 17592186338983 :knowledge-point/_questions [{:db/id #edb/ref 17592186064182 :knowledge-point/id #uuid "90033e91-fdb2-5aa0-8cce-76762a38ffd2" :knowledge-point/title "Integrating Using Arcsine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "753fa037-4869-57bb-ac4a-0f8226e93dce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{x}^{2}-\\operatorname{arccos}⁡x+C" :db/id #edb/ref 17592186337088} {:answer/id #uuid "7de44454-c056-5b46-a5ff-feadd65645cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{2}-\\operatorname{arcsin}⁡x+C" :db/id #edb/ref 17592186337171} {:answer/id #uuid "af75991e-fe31-5097-bab1-f9f7833dfa8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{2}-\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186337609} {:answer/id #uuid "cddee891-ba94-5bd0-9d64-b60f3812c423" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{x}^{2}-\\operatorname{arcsin}⁡x+C" :db/id #edb/ref 17592186337835} {:answer/id #uuid "f64bcadb-6519-5fea-93f7-63aa02c92d1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{2}-\\operatorname{arccos}⁡x+C" :db/id #edb/ref 17592186338190}] :answer-field/correct {:answer/id #uuid "7de44454-c056-5b46-a5ff-feadd65645cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{2}-\\operatorname{arcsin}⁡x+C" :db/id #edb/ref 17592186337171} :answer-field/id #uuid "f6a689b3-7d92-5c9d-b9a2-6c4b6c753f86" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338710}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f5352827-e02f-55d1-bc3e-a103f93321ab" :question/math-academy-id "q-71761" :question/problem "$\\int (8x-\\frac{1}{\\sqrt{1-{x}^{2}}})\\text{d}x=$" :question/worked-solution "Recall that \n\n$$\n\\int \\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x=\\operatorname{arcsin}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (8x-\\frac{1}{\\sqrt{1-{x}^{2}}})\\text{d}x & =\\int 8x\\,\\text{d}x-\\int \\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =8\\int x\\,\\text{d}x-\\int \\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =4{x}^{2}-\\operatorname{arcsin}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338984 :knowledge-point/_questions [{:db/id #edb/ref 17592186064183 :knowledge-point/id #uuid "d7256d2e-7105-5a4e-8d0a-5e00dfc1e311" :knowledge-point/title "Integrating Using Arctangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c05b9ce-0e54-531e-9602-9aa81d5949a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{5}+7\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186336447} {:answer/id #uuid "627ef198-a214-5417-80e9-b45a792ad5f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{5}+7\\text{ arcsec }x+C" :db/id #edb/ref 17592186336916} {:answer/id #uuid "71c35c47-7b7b-5fef-b294-b9cb841b489c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{x}^{5}+7\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186337048} {:answer/id #uuid "bb6f9d28-d3e5-53a1-a5e5-29186ee63437" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{5}+7\\text{ arccot }x+C" :db/id #edb/ref 17592186337694} {:answer/id #uuid "edeaae97-ac2c-562a-abdb-dd6daecb94ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{x}^{5}+7\\operatorname{arcsin}⁡x+C" :db/id #edb/ref 17592186338111}] :answer-field/correct {:answer/id #uuid "2c05b9ce-0e54-531e-9602-9aa81d5949a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{5}+7\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186336447} :answer-field/id #uuid "31ce09db-263d-5513-8b14-b7d2cd24d8f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338372}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8482c878-eb98-5b38-8c38-4c3a4a08ab5b" :question/math-academy-id "q-71768" :question/problem "If ${f}^{′}(x)=5{x}^{4}+\\frac{7}{1+{x}^{2}},$ then $f(x)=$" :question/worked-solution "Recall that \n\n$$\n\\int \\frac{1}{1+{x}^{2}}\\text{d}x=\\operatorname{arctan}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(x)=\\int {f}^{′}(x)\\,\\text{d}x & =\\int (5{x}^{4}+\\frac{7}{1+{x}^{2}})\\text{d}x \\\\  & =\\int 5{x}^{4}\\,\\text{d}x+\\int \\frac{7}{1+{x}^{2}}\\,\\text{d}x \\\\  & =5\\int {x}^{4}\\,\\text{d}x+7\\int \\frac{1}{1+{x}^{2}}\\,\\text{d}x \\\\  & =5\\cdot \\frac{{x}^{5}}{5}+7\\operatorname{arctan}⁡x+C \\\\  & ={x}^{5}+7\\operatorname{arctan}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393180 :knowledge-point/_questions [{:db/id #edb/ref 17592186087889 :knowledge-point/id #uuid "e0cdcbc5-c10b-5dd1-af9a-410d2d44a4c5" :knowledge-point/title "Calculating the Acceleration of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89cf84e6-fa60-5c64-b93b-865747b163cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a(t)=1+\\frac{1}{{t}^{2}}" :db/id #edb/ref 17592186393182} {:answer/id #uuid "ce91f5ac-68b0-5d12-b408-5805719d5633" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a(t)=1-\\frac{1}{{t}^{2}}" :db/id #edb/ref 17592186393183} {:answer/id #uuid "9153eb0d-2401-550a-8773-be6e4eb8e8c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a(t)=\\frac{1}{{t}^{2}}" :db/id #edb/ref 17592186393184} {:answer/id #uuid "adae588b-ff36-562f-b371-73f948870d37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a(t)=t+\\frac{1}{t}" :db/id #edb/ref 17592186393185} {:answer/id #uuid "d5256482-56c1-5d4e-a0c1-dc867d2591d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a(t)=t-\\frac{1}{t}" :db/id #edb/ref 17592186393186}] :answer-field/correct {:answer/id #uuid "89cf84e6-fa60-5c64-b93b-865747b163cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a(t)=1+\\frac{1}{{t}^{2}}" :db/id #edb/ref 17592186393182} :answer-field/id #uuid "0524bc50-6e64-5c83-9e81-cb4394c0bfc4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393181}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2e5248e4-d160-51d4-9bba-1d38c3c5aabb" :question/math-academy-id "q-7186" :question/problem "The velocity $v$ of a particle at time $t$ is given by $v(t)=\\frac{{t}^{2}-1}{t}.$ Calculate the acceleration of the particle at time $t.$" :question/worked-solution "We differentiate $v(t)$ to calculate $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{{t}^{2}-1}{t}) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t-\\frac{1}{t}) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t-{t}^{-1}) \\\\  & =1-(-{t}^{-2}) \\\\  & =1+\\frac{1}{{t}^{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339007 :knowledge-point/_questions [{:db/id #edb/ref 17592186087700 :knowledge-point/id #uuid "a75c67e5-3469-5730-9181-54df4ec6d5b2" :knowledge-point/title "Determining the Inverse of a Larger Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43339e1d-1bfa-55d0-b3c2-c8e4ad7e48be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186336667} {:answer/id #uuid "7483dbfb-2a05-5002-b015-71ac4bbb50b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186337079} {:answer/id #uuid "9bc56d9f-7969-5603-8164-402febf66e59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186337442} {:answer/id #uuid "b2a235c2-3d22-5e37-8f24-ef0a23a374c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186337626} {:answer/id #uuid "cf0d9494-e399-55f1-8b32-0a285f986f3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186337843}] :answer-field/correct {:answer/id #uuid "b2a235c2-3d22-5e37-8f24-ef0a23a374c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186337626} :answer-field/id #uuid "0b488541-8354-522a-b07d-347ec327f286" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338298}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8aec4565-777c-5fd0-95ff-9f5ced653b55" :question/math-academy-id "q-71879" :question/problem "Consider the matrices\n\n$$\nA=[\\begin{aligned}0 & -1 & -1 \\\\ 0 & 1 & 0 \\\\ 1 & 1 & 1\\end{aligned}],\\,B=[\\begin{aligned}1 & 0 & 1 \\\\ 0 & 2 & 0 \\\\ -1 & -1 & 0\\end{aligned}],\\,C=[\\begin{aligned}0 & -\\frac{1}{2} & -1 \\\\ 0 & \\frac{1}{2} & 0 \\\\ 1 & \\frac{1}{2} & 1\\end{aligned}].\n$$\n\nWhich of the following statements are true?\n\n- $AB=BA={I}_{3}$\n- $BC=CB={I}_{3}$\n- $A={B}^{-1}$" :question/worked-solution "- First, we check whether $AB=BA={I}_{3}.$ Computing $AB$, we get\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}0 & -1 & -1 \\\\ 0 & 1 & 0 \\\\ 1 & 1 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 1 \\\\ 0 & 2 & 0 \\\\ -1 & -1 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}∗ & -1 & ∗ \\\\ ∗ & ∗ & ∗ \\\\ ∗ & ∗ & ∗\\end{aligned}] \\\\  & \\ne {I}_{3}.\\,\\times \\end{aligned}\n$$\n\nSo, statement I is false. As a result, $A\\ne {B}^{-1}$ and statement III is false too.\n\n- Now, we check whether $BC=CB={I}_{3}.$ Computing $BC$, we get\n\n$$\n\\begin{aligned}BC & =[\\begin{aligned}1 & 0 & 1 \\\\ 0 & 2 & 0 \\\\ -1 & -1 & 0\\end{aligned}][\\begin{aligned}0 & -\\frac{1}{2} & -1 \\\\ 0 & \\frac{1}{2} & 0 \\\\ 1 & \\frac{1}{2} & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nLikewise, computing $CB$, we get\n\n$$\n\\begin{aligned}CB & =[\\begin{aligned}0 & -\\frac{1}{2} & -1 \\\\ 0 & \\frac{1}{2} & 0 \\\\ 1 & \\frac{1}{2} & 1\\end{aligned}][\\begin{aligned}1 & 0 & 1 \\\\ 0 & 2 & 0 \\\\ -1 & -1 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nSo, statement II is true.\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186403502 :knowledge-point/_questions [{:db/id #edb/ref 17592186176099 :knowledge-point/id #uuid "bee6d4bf-79da-5eb3-a214-8c045dbce5bd" :knowledge-point/title "Calculating the Velocity of a Particle at the Moment When Its Acceleration is Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e800b9e5-7a04-5a52-83f0-e3afcf5ec850" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=4,\\,v=10.75" :db/id #edb/ref 17592186403504} {:answer/id #uuid "353897c1-d771-528a-9201-b28cc593f791" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=4.5,\\,v=27.5" :db/id #edb/ref 17592186403505} {:answer/id #uuid "351b1c52-f2f1-52fc-bd66-0b6482b93763" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=4.5,\\,v=12" :db/id #edb/ref 17592186403506} {:answer/id #uuid "e50e1c45-ecbd-5feb-9363-3cbef9942625" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=3.5,\\,v=26.5" :db/id #edb/ref 17592186403507} {:answer/id #uuid "61d395f2-5e29-597d-bed3-c8a2e676c54f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=4,\\,v=22.5" :db/id #edb/ref 17592186403508}] :answer-field/correct {:answer/id #uuid "353897c1-d771-528a-9201-b28cc593f791" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=4.5,\\,v=27.5" :db/id #edb/ref 17592186403505} :answer-field/id #uuid "f245a54a-e7b7-5958-90da-5850b106775b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403503}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e823f661-78ed-5c49-931f-9f7b092bd2fe" :question/math-academy-id "q-7188" :question/problem "A particle $P$ is traveling along the $x$-axis with displacement $s(t)$ from a fixed origin $O$ given by\n\n$$\ns(t)=-\\frac{2}{9}{t}^{3}+3{t}^{2}+14t+17,\\,t\\ge 0.\n$$\n\nFind the time at which the acceleration is zero, and find the value of the velocity at this moment." :question/worked-solution "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(-\\frac{2}{9}{t}^{3}+3{t}^{2}+14t+17) \\\\  & =-\\frac{2}{3}{t}^{2}+6t+14\\end{aligned}\n$$\n\n \n\nNow, we differentiate $v(t)$ to find $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(-\\frac{2}{3}{t}^{2}+6t+14) \\\\  & =-\\frac{4}{3}t+6\\end{aligned}\n$$\n\nNext, we put $a=0$ to find the time when the acceleration is zero:\n\n$$\n\\begin{aligned}0 & =-\\frac{4}{3}t+6 \\\\ \\frac{4}{3}t & =6 \\\\ t & =4.5\\end{aligned}\n$$\n\nSo the acceleration is zero when $t=4.5.$ To find the velocity at this moment, we substitute this back into $v(t)$ to get\n\n$$\nv(4.5)=-\\frac{2}{3}(4.5)^{2}+6(4.5)+14=27.5.\n$$"}] [{:db/id #edb/ref 17592186339009 :knowledge-point/_questions [{:db/id #edb/ref 17592186064171 :knowledge-point/id #uuid "3f9548e6-28ef-5a97-ab04-dfb1b6e23c16" :knowledge-point/title "Integrating the Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23784fc4-3a90-53e4-89bb-df7f53cf6d59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{x}+C" :db/id #edb/ref 17592186336365} {:answer/id #uuid "2c3c2a30-99f8-537b-8508-e5713aa27c9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{2x}+C" :db/id #edb/ref 17592186336450} {:answer/id #uuid "67383a40-44c5-5a00-bfa0-07f13c0dcbe6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{x}+C" :db/id #edb/ref 17592186336953} {:answer/id #uuid "b945ae93-7849-5d6e-b645-1e8c14a1d6cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{1/2x}+C" :db/id #edb/ref 17592186337675} {:answer/id #uuid "fbb744da-ccfd-5f44-8169-07909ef53f32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{x}+C" :db/id #edb/ref 17592186338242}] :answer-field/correct {:answer/id #uuid "23784fc4-3a90-53e4-89bb-df7f53cf6d59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{x}+C" :db/id #edb/ref 17592186336365} :answer-field/id #uuid "f9fc2e0f-aa1f-50b5-8ba0-74df5403bd7c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338718}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7119fae9-f265-530e-8dcf-9a8fd6ab825e" :question/math-academy-id "q-71900" :question/problem "$\\int \\frac{1}{2}{e}^{x}\\,\\text{d}x=$" :question/worked-solution "Factoring out the constant $\\frac{1}{2}$ and calculating the resulting integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{1}{2}{e}^{x}\\,\\text{d}x & =\\frac{1}{2}\\int {e}^{x}\\,\\text{d}x \\\\  & =\\frac{1}{2}{e}^{x}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339023 :knowledge-point/_questions [{:db/id #edb/ref 17592186096843 :knowledge-point/id #uuid "0a312840-0d35-50bb-94b3-b04778f4efc3" :knowledge-point/title "Differentiating a Function Using the Chain Rule and Prime Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d2f6517-e258-513a-b912-2250e7c54e17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15(2+5x{)}^{2}" :db/id #edb/ref 17592186336461} {:answer/id #uuid "3b2c8729-231c-5b49-a873-246a32aa4645" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15(2-5x{)}^{3}" :db/id #edb/ref 17592186336588} {:answer/id #uuid "77d335ef-89db-5392-8e96-2e5663d37f72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15(2+5x{)}^{2}" :db/id #edb/ref 17592186337111} {:answer/id #uuid "84c34e15-f7f7-51bd-91ad-be1849bcac42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15(2-5x{)}^{2}" :db/id #edb/ref 17592186337229} {:answer/id #uuid "ba6755f1-59bc-5601-b289-66317d2b0d63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15(2-5x{)}^{2}" :db/id #edb/ref 17592186337682}] :answer-field/correct {:answer/id #uuid "ba6755f1-59bc-5601-b289-66317d2b0d63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15(2-5x{)}^{2}" :db/id #edb/ref 17592186337682} :answer-field/id #uuid "20dca297-5492-547a-957c-959f9e7520f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338339}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ccad926b-6344-5bec-99bc-507d50cda1e3" :question/math-academy-id "q-71956" :question/problem "Given that $f(x)={(2-5x)}^{3},$ find ${f}^{′}(x).$" :question/worked-solution "Let $g(x)=2-5x$ and $f(g(x))=g(x{)}^{3}.$ \n\nDifferentiating, we have\n\n$$\n\\begin{aligned}{f}^{′}(g(x)) & =({g}^{3}{)}^{′}=3{g}^{2}, \\\\ {g}^{′}(x) & =(2-5x{)}^{′}=-5.\\end{aligned}\n$$\n\nThen, using the chain rule, \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={f}^{′}(g(x))\\cdot {g}^{′}(x) \\\\  & =3{g}^{2}\\cdot (-5) \\\\  & =-15(2-5x{)}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339030 :knowledge-point/_questions [{:db/id #edb/ref 17592186087703 :knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01" :knowledge-point/title "Solving for a Variable in a Singular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f062ffd-0731-5c9d-b5df-1e280483ad62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=-\\frac{3}{4}" :db/id #edb/ref 17592186336623} {:answer/id #uuid "87e8b87b-9219-5612-bc47-0727af4eb0b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186337259} {:answer/id #uuid "9d1a9b12-eb65-52f2-be17-471977096571" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=5" :db/id #edb/ref 17592186337454} {:answer/id #uuid "db1521d6-6365-5c27-8635-662375c34db6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=-5" :db/id #edb/ref 17592186337942} {:answer/id #uuid "e0112779-824d-50fa-a23d-b42b80a0e397" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{3}{4}" :db/id #edb/ref 17592186337989}] :answer-field/correct {:answer/id #uuid "87e8b87b-9219-5612-bc47-0727af4eb0b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186337259} :answer-field/id #uuid "82b667e3-83f0-533b-abd1-94355475f197" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338510}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "35c7dc25-96f0-5d9f-9d6a-dfbf5fcfb320" :question/math-academy-id "q-71969" :question/problem "If $M=[\\begin{aligned}t & 4 \\\\ t & 10\\end{aligned}]$ is a singular matrix, calculate the value of $t.$" :question/worked-solution "The matrix $M$ is singular if and only if $det(M)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(M) & =t\\cdot 10-t\\cdot 4 \\\\  & =10t-4t \\\\  & =6t\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $t:$\n\n$$\n\\begin{aligned}6t & =0 \\\\ t & =0\\end{aligned}\n$$\n\nTherefore, the value of $t$ is $t=0.$"}] [{:db/id #edb/ref 17592186339038 :knowledge-point/_questions [{:db/id #edb/ref 17592186087846 :knowledge-point/id #uuid "37a4168b-1425-5f3a-a577-4b5884906a52" :knowledge-point/title "Calculating the Sum of a Complex Number and Its Conjugate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "131e439a-9165-56c6-8fdd-b21c8dea91e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8+14\\text{i}" :db/id #edb/ref 17592186336212} {:answer/id #uuid "1b6aa3b5-1f23-581f-bd0e-52f0682b50a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186336285} {:answer/id #uuid "1e6f5eb4-3b18-507b-9c32-4ce046ab8046" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186336313} {:answer/id #uuid "d95dea67-8da9-5f2b-8c58-9a5fb247332b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\text{i}" :db/id #edb/ref 17592186337923} {:answer/id #uuid "f90cfae7-9eea-5dc8-8b18-628804095bea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186338215}] :answer-field/correct {:answer/id #uuid "1b6aa3b5-1f23-581f-bd0e-52f0682b50a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186336285} :answer-field/id #uuid "bd3178b7-71a4-5c4f-9b23-601af5c49da4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338617}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "568e1d1c-4c3e-536f-acb0-c6800da06527" :question/math-academy-id "q-71986" :question/problem "If $z=4+7\\text{i}$, calculate $z+\\overset{―}{z}.$" :question/worked-solution "**Method 1**\n\nWhen we add a complex number and its conjugate, the result is always twice the real part of the complex number.\n\nFor the given complex number $z=4+7\\text{i},$ the real part is $Re(z)=4,$ so we have\n\n$$\n\\begin{aligned}z+\\overset{―}{z} & =2\\text{Re}(z) \\\\  & =2(4) \\\\  & =8.\\end{aligned}\n$$\n\n**Method 2**\n\nAlternatively, we can actually carry out the process of adding the complex number and its conjugate.\n\nTo obtain the conjugate of the complex number $z=4+7\\text{i},$ we flip the sign of the imaginary part and get $\\overset{―}{z}=4-7\\text{i}.$\n\nAdding, we get\n\n$$\n\\begin{aligned}z+\\overset{―}{z} & =(4+7\\text{i})+(4-7\\text{i}) \\\\  & =(4+4)+\\text{i}(7-7) \\\\  & =8+\\text{i}0 \\\\  & =8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064947 :knowledge-point/_questions [{:db/id #edb/ref 17592186064272 :knowledge-point/id #uuid "fa38f112-466c-50e9-ac08-be72b6f53782" :knowledge-point/title "Relating a Derivative to a Rate of Change"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "148eb00f-3a9c-5cde-b11e-4aa6e5df5baf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N(t)=r(t)" :db/id #edb/ref 17592186336227} {:answer/id #uuid "3ce9ccdf-1421-5fcb-b41e-795e91107452" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N(t)={r}^{′}(t)" :db/id #edb/ref 17592186336606} {:answer/id #uuid "3d4ac506-d0f2-599b-b8f3-e6dce6983161" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{N}^{′}(t)=r(t)" :db/id #edb/ref 17592186336611} {:answer/id #uuid "80a522d2-bd93-5515-9735-bcaf1eb17692" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N(t)=-{r}^{′}(t)" :db/id #edb/ref 17592186337197} {:answer/id #uuid "e3743113-4ad5-561d-af41-cbb9230afbba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{N}^{′}(t)=-r(t)" :db/id #edb/ref 17592186338017}] :answer-field/correct {:answer/id #uuid "3d4ac506-d0f2-599b-b8f3-e6dce6983161" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{N}^{′}(t)=r(t)" :db/id #edb/ref 17592186336611} :answer-field/id #uuid "874c5434-9157-538e-be59-176244d35d61" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338525}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "97f8f938-0d50-59f5-922b-f7bea8bb44f7" :question/math-academy-id "q-72004" :question/problem "Jason, a biologist, is measuring the growth of bacteria in a Petri dish by recording the following two numbers for different values of $t,$ where $t$ is the time, in hours, since he started his observations:\n\n- $N(t)$ - the number of bacteria in the dish.\n\n- $r(t)$ - the rate at which the number of bacteria in the dish is increasing.\n\nWhat is the relationship between $N(t)$ and $r(t)?$" :question/worked-solution "The function $N(t)$ gives the number of bacteria inside the dish after $t$ hours. Then,\n\n$$\n{N}^{′}(t)=\\frac{\\text{d}N(t)}{\\text{d}t}=\\frac{\\text{Change in }N}{\\text{Change in }t}.\n$$\n\nThus, ${N}^{′}(t)$ gives the rate at which the number of bacteria is increasing at time $t$, which is the same as $r(t).$ Therefore, the relationship between $N(t)$ and $r(t)$ is ${N}^{′}(t)=r(t).$"}] [{:db/id #edb/ref 17592186339052 :knowledge-point/_questions [{:db/id #edb/ref 17592186105715 :knowledge-point/id #uuid "cf98ee24-7774-5674-8a1e-63f4f6d225c0" :knowledge-point/title "Integrating a Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f88c79e-e25c-5fcd-a473-3f9adb3d4e9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{7}}{7}ln⁡|x|+C" :db/id #edb/ref 17592186336327} {:answer/id #uuid "58b493c2-73d3-5db1-af15-0200a2937632" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{7}}{ln⁡|x|}+C" :db/id #edb/ref 17592186336844} {:answer/id #uuid "daf20704-2d65-5753-af90-f6e026c52e12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{7}ln⁡|x|+C" :db/id #edb/ref 17592186337940} {:answer/id #uuid "ec4261ce-b5b3-5551-9fbd-56937e1eea24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{\\sqrt{7}}ln⁡|x|+C" :db/id #edb/ref 17592186338091} {:answer/id #uuid "f7a97ce9-ff10-5758-b496-1ffe87d0bb3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-ln⁡|\\sqrt{7}x|+C" :db/id #edb/ref 17592186338202}] :answer-field/correct {:answer/id #uuid "1f88c79e-e25c-5fcd-a473-3f9adb3d4e9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{7}}{7}ln⁡|x|+C" :db/id #edb/ref 17592186336327} :answer-field/id #uuid "f930863c-55bb-55cc-bd9d-51b8ae4abea3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338715}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d9daecf1-e255-5c0c-a433-fdc798f551aa" :question/math-academy-id "q-72059" :question/problem "Calculate $\\int -\\frac{1}{\\sqrt{7}x}\\,\\text{d}x.$" :question/worked-solution "First, we apply the constant factor rule and take the coefficient $-\\frac{1}{\\sqrt{7}}=-\\frac{1}{\\sqrt{7}}\\frac{\\sqrt{7}}{\\sqrt{7}}=-\\frac{\\sqrt{7}}{7}$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int -\\frac{1}{\\sqrt{7}x}\\,\\text{d}x & =-\\frac{1}{\\sqrt{7}}\\int \\frac{1}{x}\\,\\,\\text{d}x \\\\  & =-\\frac{\\sqrt{7}}{7}ln⁡|x|+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339059 :knowledge-point/_questions [{:db/id #edb/ref 17592186064152 :knowledge-point/id #uuid "159b4d58-b34d-52cd-aad2-2c058f772ad2" :knowledge-point/title "Interpreting the Derivative of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08f73173-53b3-594c-9f00-73f6211f3aba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The rate at which the perimeter changes as each side changes" :db/id #edb/ref 17592186336106} {:answer/id #uuid "2f86ab33-c24f-513c-9f78-18726fd0321b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The rate at which the area changes as each side changes" :db/id #edb/ref 17592186336488} {:answer/id #uuid "8526b1a3-6e9c-580f-9c0b-82c5736c43b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The rate at which each side changes as the perimeter changes" :db/id #edb/ref 17592186337231} {:answer/id #uuid "95ba1001-8463-59e2-bed5-38495c9afaab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The rate at which the perimeter changes as the area changes" :db/id #edb/ref 17592186337400} {:answer/id #uuid "eddb83ed-12b2-59b9-8dd1-0e4ed245941a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The rate at which each side changes as the area changes" :db/id #edb/ref 17592186338109}] :answer-field/correct {:answer/id #uuid "08f73173-53b3-594c-9f00-73f6211f3aba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The rate at which the perimeter changes as each side changes" :db/id #edb/ref 17592186336106} :answer-field/id #uuid "aa385052-bba0-5f25-abff-7baf2aaa746f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338590}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c47d8541-4bf8-5eff-901b-cba03fe2cd37" :question/math-academy-id "q-72104" :question/problem "Consider a regular pentagon such that the length $s$ of each side varies. What is the best interpretation of ${P}^{′}(s)$ if $P$ is the perimeter of the pentagon?" :question/worked-solution "The function $P(s)$ gives the perimeter of a pentagon with side $s.$ So,\n\n$$\n{P}^{′}(s)=\\frac{\\text{d}P}{\\text{d}s}=\\frac{\\text{Change in }P}{\\text{Change in }s}.\n$$\n\nTherefore, ${P}^{′}(s)$ is the rate at which the perimeter changes as each side changes."}] [{:db/id #edb/ref 17592186339060 :knowledge-point/_questions [{:db/id #edb/ref 17592186064272 :knowledge-point/id #uuid "fa38f112-466c-50e9-ac08-be72b6f53782" :knowledge-point/title "Relating a Derivative to a Rate of Change"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bd3314e-09b5-5ed6-b34d-9c8eb2cd078f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{A}^{′}(t)=r(t)" :db/id #edb/ref 17592186336291} {:answer/id #uuid "5f89b95a-dc2f-5355-a891-5f7ad0897f2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A(t)=-{r}^{′}(t)" :db/id #edb/ref 17592186336898} {:answer/id #uuid "d84adbce-e1e5-541f-ae42-248e49f85aef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{A}^{′}(t)=-r(t)" :db/id #edb/ref 17592186337909} {:answer/id #uuid "eb90804a-9cb1-5c0e-93ff-93893405ab87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A(t)={r}^{′}(t)" :db/id #edb/ref 17592186338088} {:answer/id #uuid "f843d514-c114-567f-8b4e-d0d7f91897e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A(t)=r(t)" :db/id #edb/ref 17592186338207}] :answer-field/correct {:answer/id #uuid "1bd3314e-09b5-5ed6-b34d-9c8eb2cd078f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{A}^{′}(t)=r(t)" :db/id #edb/ref 17592186336291} :answer-field/id #uuid "27c52aef-834f-5c1c-9709-b11a313c17d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338353}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4da77317-b047-59f4-8384-7a00ca57d0df" :question/math-academy-id "q-72105" :question/problem "Douglas, a pilot, is flying a plane. The plane's control systems record two measurements for different values of $t,$ where $t$ is the time, in minutes, since take off. The two measurements are:\n\n- $A(t)$ - the altitude (height) of the plane\n\n- $r(t)$ the rate at which the altitude is increasing\n\nWhat is the relationship between $A(t)$ and $r(t)?$" :question/worked-solution "The function $A(t)$ gives the altitude of the plane after $t$ hours. Then,\n\n$$\n{A}^{′}(t)=\\frac{\\text{d}A(t)}{\\text{d}t}=\\frac{\\text{Change in }A}{\\text{Change in }t}.\n$$\n\nThus, ${A}^{′}(t)$ gives the rate at which the altitude is increasing at time $t$, which is the same as $r(t).$ Therefore, the relationship between $A(t)$ and $r(t)$ is ${A}^{′}(t)=r(t).$"}] [{:db/id #edb/ref 17592186339064 :knowledge-point/_questions [{:db/id #edb/ref 17592186064283 :knowledge-point/id #uuid "3ec11481-cea2-514b-aa78-707fcf8838cc" :knowledge-point/title "Differentiating a Power of a Trigonometric Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b52aa7c5-0426-5772-8576-0d06507ee246" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-28\\operatorname{cos}⁡x{sin}^{6}⁡x" :db/id #edb/ref 17592186337642} {:answer/id #uuid "bca0ac11-5889-590d-b18f-dc821e5d6c5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-28{cos}^{6}⁡x\\operatorname{sin}⁡x" :db/id #edb/ref 17592186337708} {:answer/id #uuid "ec2962a1-647e-5d8b-9492-8e3b141a6e17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-28{sin}^{6}⁡x" :db/id #edb/ref 17592186338090} {:answer/id #uuid "f9f6bad8-7c0c-55c3-aec1-1f849a332783" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{cos}⁡x{sin}^{6}⁡x" :db/id #edb/ref 17592186338224} {:answer/id #uuid "ff8e2ee2-8bc8-5f48-a816-f19ea88144d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{cos}^{6}⁡x" :db/id #edb/ref 17592186338274}] :answer-field/correct {:answer/id #uuid "bca0ac11-5889-590d-b18f-dc821e5d6c5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-28{cos}^{6}⁡x\\operatorname{sin}⁡x" :db/id #edb/ref 17592186337708} :answer-field/id #uuid "05250791-7660-5c5c-b045-5bac1563c939" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338283}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6e3f0d37-02ff-5992-af83-461909d51264" :question/math-academy-id "q-72157" :question/problem "Find ${f}^{′}(x)$ when $f(x)=4{cos}^{7}⁡(x).$" :question/worked-solution "First, we express\n\n$$\nf(x)=4(\\operatorname{cos}⁡x)^{7}.\n$$\n\nNow, we see that $f(x)$ can be expressed as the composite function\n\n$$\nf=4{u}^{7},\\,u=\\operatorname{cos}⁡x.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=28{u}^{6},\\,\\frac{\\text{d}u}{\\text{d}x}=-\\operatorname{sin}⁡x.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =28{u}^{6}\\cdot (-\\operatorname{sin}⁡x) \\\\  & =28(\\operatorname{cos}⁡x)^{6}(-\\operatorname{sin}⁡x) \\\\  & =-28{cos}^{6}⁡x\\operatorname{sin}⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339066 :knowledge-point/_questions [{:db/id #edb/ref 17592186064284 :knowledge-point/id #uuid "a483e892-90f2-51f4-80cd-2b1200cd0c37" :knowledge-point/title "Differentiating a Composition of Trigonometric Functions Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35d0b5a0-960c-537b-b36b-f81b09719172" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{sec}⁡x\\operatorname{tan}⁡(-\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186336532} {:answer/id #uuid "8659cf38-7f28-521b-9eb6-a1f4bb5d55a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{sin}⁡x\\operatorname{sec}⁡(-\\operatorname{sin}⁡x)\\operatorname{tan}⁡(-\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186337248} {:answer/id #uuid "cf2b4496-4d43-50c5-b8f4-50cbe3748941" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{cos}⁡x\\operatorname{sec}⁡(\\operatorname{cos}⁡x)\\operatorname{tan}⁡(\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186337845} {:answer/id #uuid "e5a21dd0-44ef-54d6-bc1c-1c98a20cbcd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{sin}⁡x\\operatorname{sec}⁡x\\operatorname{tan}⁡(\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186338037} {:answer/id #uuid "f7b439b8-4fb4-5bd2-b82d-c5283f54f75b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\operatorname{sin}⁡x\\operatorname{sec}⁡(\\operatorname{cos}⁡x)\\operatorname{tan}⁡(\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186338204}] :answer-field/correct {:answer/id #uuid "f7b439b8-4fb4-5bd2-b82d-c5283f54f75b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\operatorname{sin}⁡x\\operatorname{sec}⁡(\\operatorname{cos}⁡x)\\operatorname{tan}⁡(\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186338204} :answer-field/id #uuid "76164faf-c99c-514d-8f55-17d4f55b16c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338480}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bdadc1fd-0dca-59ce-bd49-88a477cdb0a0" :question/math-academy-id "q-72173" :question/problem "Find the derivative of $y=3\\operatorname{sec}⁡(\\operatorname{cos}⁡x).$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=3\\operatorname{sec}⁡u,\\,u=\\operatorname{cos}⁡x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=3\\operatorname{sec}⁡u\\operatorname{tan}⁡u,\\,\\frac{\\text{d}u}{\\text{d}x}=-\\operatorname{sin}⁡x.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =3\\operatorname{sec}⁡u\\operatorname{tan}⁡u\\cdot (-\\operatorname{sin}⁡x) \\\\  & =-3\\operatorname{sin}⁡x\\operatorname{sec}⁡(\\operatorname{cos}⁡x)\\operatorname{tan}⁡(\\operatorname{cos}⁡x).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339074 :knowledge-point/_questions [{:db/id #edb/ref 17592186054677 :knowledge-point/id #uuid "619182bf-107d-5217-a306-ec4f7c1109eb" :knowledge-point/title "Finding the Derivative of a Function Given in Implicit Form Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a0fc10a-2cbd-5633-bb2f-ea7aaaa841c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}+\\operatorname{sin}⁡(y)}{x\\operatorname{sin}⁡(y)+3{y}^{2}}" :db/id #edb/ref 17592186336123} {:answer/id #uuid "16292cbd-8350-5bd3-96d9-795ef552cf0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}-\\operatorname{sin}⁡(y)}{x\\operatorname{cos}⁡(y)+3{y}^{2}}" :db/id #edb/ref 17592186336240} {:answer/id #uuid "1e57b365-540c-5e8a-8331-f6790e70b06d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}-\\operatorname{sin}⁡(y)}{x\\operatorname{cos}⁡(y)+2{y}^{3}}" :db/id #edb/ref 17592186336311} {:answer/id #uuid "23a544b4-0d38-57bb-983c-e904eb2a25c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}+\\operatorname{sin}⁡(y)}{x\\operatorname{cos}⁡(y)+{y}^{2}}" :db/id #edb/ref 17592186336367} {:answer/id #uuid "ee47ac7c-c346-5761-8902-7e42ed6ca55e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}+\\operatorname{sin}⁡(y)}{x\\operatorname{cos}⁡(y)+3{y}^{2}}" :db/id #edb/ref 17592186338116}] :answer-field/correct {:answer/id #uuid "16292cbd-8350-5bd3-96d9-795ef552cf0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}-\\operatorname{sin}⁡(y)}{x\\operatorname{cos}⁡(y)+3{y}^{2}}" :db/id #edb/ref 17592186336240} :answer-field/id #uuid "f6bf4581-0ffc-537f-82d9-87405f04b109" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338711}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "454b7cf5-7862-57c7-a910-8dbc0dac1fcc" :question/math-academy-id "q-72213" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $x\\operatorname{sin}⁡(y)+{y}^{3}=2{x}^{3}.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\nNote that to differentiate the $x\\operatorname{sin}⁡y$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}x\\operatorname{sin}⁡(y)+{y}^{3}=2{x}^{3} \\\\ \\frac{\\text{d}}{\\text{d}x}(x\\operatorname{sin}⁡(y)+{y}^{3}) & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}) \\\\ \\frac{\\text{d}}{\\text{d}x}(x\\operatorname{sin}⁡(y))+\\frac{\\text{d}}{\\text{d}x}({y}^{3}) & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}) \\\\ [x(\\operatorname{cos}⁡(y)\\cdot \\frac{\\text{d}y}{\\text{d}x})+\\operatorname{sin}⁡(y)]+3{y}^{2}\\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2} \\\\ x\\operatorname{cos}⁡(y)\\frac{\\text{d}y}{\\text{d}x}+\\operatorname{sin}⁡(y)+3{y}^{2}\\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2}\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}x\\operatorname{cos}⁡(y)\\frac{\\text{d}y}{\\text{d}x}+3{y}^{2}\\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2}-\\operatorname{sin}⁡(y) \\\\ \\frac{\\text{d}y}{\\text{d}x}(x\\operatorname{cos}⁡(y)+3{y}^{2}) & =6{x}^{2}-\\operatorname{sin}⁡(y) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{6{x}^{2}-\\operatorname{sin}⁡(y)}{x\\operatorname{cos}⁡(y)+3{y}^{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339078 :knowledge-point/_questions [{:db/id #edb/ref 17592186087833 :knowledge-point/id #uuid "57e19ee3-db9a-58d7-8ca3-4e8801aee656" :knowledge-point/title "Determining the Equation of a Tall Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d360012-b71b-5e3d-a5ed-050551fedc08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+2)^{2}}{6}+\\frac{(y+2)^{2}}{8}=1" :db/id #edb/ref 17592186336156} {:answer/id #uuid "363d6738-eccc-55d0-b37d-dc6eeb5492c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-2)^{2}}{9}+\\frac{(y+2)^{2}}{16}=1" :db/id #edb/ref 17592186336536} {:answer/id #uuid "799fad89-4775-5c00-9f34-a99bb77a3ae6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-2)^{2}}{8}+\\frac{(y-2)^{2}}{6}=1" :db/id #edb/ref 17592186337125} {:answer/id #uuid "975b13c5-78a1-50ac-8fca-df15265468b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+2)^{2}}{9}+\\frac{(y+2)^{2}}{16}=1" :db/id #edb/ref 17592186337411} {:answer/id #uuid "a0e5af31-ccd8-5042-a136-b3b71e9698e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-2)^{2}}{9}+\\frac{(y-2)^{2}}{16}=1" :db/id #edb/ref 17592186337486}] :answer-field/correct {:answer/id #uuid "975b13c5-78a1-50ac-8fca-df15265468b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+2)^{2}}{9}+\\frac{(y+2)^{2}}{16}=1" :db/id #edb/ref 17592186337411} :answer-field/id #uuid "e195d8c3-ee86-56e6-9272-e56918978464" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338674}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "82c10773-d500-51bb-9b6a-76b40d3c3844" :question/math-academy-id "q-72252" :question/problem "![](images/28/28079ead5ebb4649900653172d11c25f3ff489c6b34772094a1ba947c18ef3e1.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the ellipse is centered at $(-2,-2),$ the horizontal radius has length $a=3,$ and the vertical radius has length $b=4.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}} & =1 \\\\ \\frac{(x-(-2))^{2}}{{3}^{2}}+\\frac{(y-(-2))^{2}}{{4}^{2}} & =1 \\\\ \\frac{(x+2)^{2}}{9}+\\frac{(y+2)^{2}}{16} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339079 :knowledge-point/_questions [{:db/id #edb/ref 17592186054677 :knowledge-point/id #uuid "619182bf-107d-5217-a306-ec4f7c1109eb" :knowledge-point/title "Finding the Derivative of a Function Given in Implicit Form Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b322d9c-37ab-52f7-9c7e-158b2aad5a2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}-2xy}{{x}^{2}+4}" :db/id #edb/ref 17592186336727} {:answer/id #uuid "4fa8641b-f12e-5282-8639-b287c9ca081d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{6x-xy}{{x}^{2}+4}" :db/id #edb/ref 17592186336764} {:answer/id #uuid "778b8f44-4e6f-5e84-b5d0-3856a65b2fcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6-2xy}{{x}^{2}+4}" :db/id #edb/ref 17592186337107} {:answer/id #uuid "8e0a7e37-7922-5237-be4e-0d4daf2edd15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6x-2y}{{x}^{2}+4}" :db/id #edb/ref 17592186337313} {:answer/id #uuid "d8ffdd28-a653-5368-a470-1763333eed55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6x+2xy}{{x}^{2}-4}" :db/id #edb/ref 17592186337920}] :answer-field/correct {:answer/id #uuid "4b322d9c-37ab-52f7-9c7e-158b2aad5a2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}-2xy}{{x}^{2}+4}" :db/id #edb/ref 17592186336727} :answer-field/id #uuid "f8ea9a9d-1024-53db-ae2f-47b539ab86b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338714}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3b84d5b9-93df-56c4-be18-4346c8b72764" :question/math-academy-id "q-72260" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for ${x}^{2}y+4y=2{x}^{3}.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\nNote that to differentiate the ${x}^{2}y$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}{x}^{2}y+4y & =2{x}^{3} \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2}y+4y) & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2}y)+\\frac{\\text{d}}{\\text{d}x}(4y) & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}) \\\\ [{x}^{2}\\frac{\\text{d}y}{\\text{d}x}+y\\cdot 2x]+4\\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2} \\\\ {x}^{2}\\frac{\\text{d}y}{\\text{d}x}+2xy+4\\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2}\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}{x}^{2}\\frac{\\text{d}y}{\\text{d}x}+4\\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2}-2xy \\\\ \\frac{\\text{d}y}{\\text{d}x}({x}^{2}+4) & =6{x}^{2}-2xy \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{6{x}^{2}-2xy}{{x}^{2}+4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186403550 :knowledge-point/_questions [{:db/id #edb/ref 17592186087822 :knowledge-point/id #uuid "79daf9dd-814d-562b-b3bc-b066bd2dfb90" :knowledge-point/title "Identifying the Shift Applied to an Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93a712bc-5c5d-5646-9703-82e77d69b46e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-3({3}^{x})" :db/id #edb/ref 17592186403552} {:answer/id #uuid "c63beba4-7686-58ae-845d-111254d3e6ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={3}^{x}-1" :db/id #edb/ref 17592186403553} {:answer/id #uuid "5996d30b-a352-5547-9b35-f09224ff8616" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={3}^{x}-3" :db/id #edb/ref 17592186403554} {:answer/id #uuid "e2d5db3c-106b-5a20-8512-215f226e23f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={3}^{x}-2" :db/id #edb/ref 17592186403555} {:answer/id #uuid "3d9e24e9-f8f1-50d2-a309-392b65ff2168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2({3}^{x})" :db/id #edb/ref 17592186403556}] :answer-field/correct {:answer/id #uuid "e2d5db3c-106b-5a20-8512-215f226e23f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={3}^{x}-2" :db/id #edb/ref 17592186403555} :answer-field/id #uuid "7f6e4f21-8993-51e5-a1c9-737356240b0e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403551}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bbca085f-0b60-5f9a-bdc1-1da6491170fe" :question/math-academy-id "q-7230" :question/problem "![](images/87/8764149ca0000522277d48bf48f4ef14ba06f7e4793ba1a58ef639ff7af3a3b9.png)\n\nThe graph above shows the curve $y={3}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={3}^{x}$ is $y=0.$ The vertical translation $y={3}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=-2.$ Therefore, $c=-2.$"}] [{:db/id #edb/ref 17592186403557 :knowledge-point/_questions [{:db/id #edb/ref 17592186087822 :knowledge-point/id #uuid "79daf9dd-814d-562b-b3bc-b066bd2dfb90" :knowledge-point/title "Identifying the Shift Applied to an Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "760d4f2f-67c3-578b-90ce-e44b5cc0e475" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={2}^{x}-2" :db/id #edb/ref 17592186403559} {:answer/id #uuid "a42ff124-ce1b-58ec-a4c4-728cb4b536df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-3({2}^{x})" :db/id #edb/ref 17592186403560} {:answer/id #uuid "9bb95f56-7efa-56a4-ab5b-5f4220d4b140" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={2}^{x}-3" :db/id #edb/ref 17592186403561} {:answer/id #uuid "840799e0-019f-5e56-960e-e4dce9f6a43e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={3}^{x}-4" :db/id #edb/ref 17592186403562} {:answer/id #uuid "97c4002b-68c4-5b92-bb46-3a3c52c7bbac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3({2}^{x})" :db/id #edb/ref 17592186403563}] :answer-field/correct {:answer/id #uuid "9bb95f56-7efa-56a4-ab5b-5f4220d4b140" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={2}^{x}-3" :db/id #edb/ref 17592186403561} :answer-field/id #uuid "117f36b7-d2dd-58cf-81f2-744857f29ebf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403558}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bb2d08ab-7e1f-579d-8314-e037ebc00133" :question/math-academy-id "q-7232" :question/problem "![](images/2a/2ad72b3df34f32d6a76f79f6801887bd6fe1d762fefd74071517a754b1890ac2.png)\n\nThe graph above shows the curve $y={2}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={2}^{x}$ is $y=0.$ The vertical translation $y={2}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=-3.$ Therefore, $c=-3.$"}] [{:db/id #edb/ref 17592186339090 :knowledge-point/_questions [{:db/id #edb/ref 17592186068690 :knowledge-point/id #uuid "9f29435f-b112-5999-b0ca-9003d9e622e1" :knowledge-point/title "Calculating an Indeterminate Limit of the Form Infinity Divided by Infinity Using L'Hopital's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2905b3c7-5120-5928-8659-ab7cf49215cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186336415} {:answer/id #uuid "9c9f02de-6945-5986-9bd6-77c4fda53a38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186337447} {:answer/id #uuid "c4c17bce-f321-5a5a-b8a2-e2f57aa0f0a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186337781} {:answer/id #uuid "d1424795-2c4b-569b-984c-33e713fb9a2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186337866} {:answer/id #uuid "f3baaf2a-856c-5b97-ba7e-56d8806079c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186338162}] :answer-field/correct {:answer/id #uuid "f3baaf2a-856c-5b97-ba7e-56d8806079c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186338162} :answer-field/id #uuid "1d342821-bbce-5fd1-b3bb-822b8446cf81" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338330}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "83ace1c9-0a10-59aa-bb99-7a86a6dbfa17" :question/math-academy-id "q-72333" :question/problem "Evaluate ${lim}_{x\\to {0}^{+}}\\frac{\\operatorname{ln}⁡x}{{e}^{1/x}}.$" :question/worked-solution "Here the limits of the numerator and denominator are ${lim}_{x\\to {0}^{+}}\\operatorname{ln}⁡x=-\\infty $ and ${lim}_{x\\to {0}^{+}}{e}^{1/x}=\\infty ,$ respectively, so we have the case $\\frac{-\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}\\frac{\\operatorname{ln}⁡x}{{e}^{1/x}} & ={lim}_{x\\to {0}^{+}}\\frac{[\\operatorname{ln}⁡x]^{′}}{[{e}^{1/x}]^{′}} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{(\\frac{1}{x})}{{e}^{1/x}(-\\frac{1}{{x}^{2}})} \\\\  & =-{lim}_{x\\to {0}^{+}}\\frac{{x}^{-1}}{{e}^{1/x}\\cdot {x}^{-2}} \\\\  & =-{lim}_{x\\to {0}^{+}}\\frac{x}{{e}^{1/x}} \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339092 :knowledge-point/_questions [{:db/id #edb/ref 17592186068690 :knowledge-point/id #uuid "9f29435f-b112-5999-b0ca-9003d9e622e1" :knowledge-point/title "Calculating an Indeterminate Limit of the Form Infinity Divided by Infinity Using L'Hopital's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dd6dd70-5f78-54b6-ac97-950f2f384aef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186336473} {:answer/id #uuid "4e08260e-b4f6-5c7a-ad2d-8294f523a3ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186336757} {:answer/id #uuid "5b538add-4209-5721-8b56-652729cc391f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186336862} {:answer/id #uuid "7d7564a4-f738-5faf-a2c3-bdd625a0ef99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186337163} {:answer/id #uuid "bb83b45c-700e-5a49-955e-7ea35708e865" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186337697}] :answer-field/correct {:answer/id #uuid "4e08260e-b4f6-5c7a-ad2d-8294f523a3ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186336757} :answer-field/id #uuid "64250102-7382-5959-9fea-4e5f4501809d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338454}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d0dae206-0030-50d7-a470-3e9d541986a9" :question/math-academy-id "q-72336" :question/problem "Evaluate ${lim}_{x\\to 0}\\frac{(\\frac{1}{{x}^{2}})}{(\\frac{1}{{x}^{4}}-1)}.$" :question/worked-solution "Here the limits of the numerator and denominator are ${lim}_{x\\to 0}\\frac{1}{{x}^{2}}=\\infty $ and ${lim}_{x\\to 0}(\\frac{1}{{x}^{4}}-1)=\\infty ,$ respectively, so we have the case $\\frac{\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{(\\frac{1}{{x}^{2}})}{(\\frac{1}{{x}^{4}}-1)} & ={lim}_{x\\to 0}\\frac{{[\\frac{1}{{x}^{2}}]}^{′}}{{[\\frac{1}{{x}^{4}}-1]}^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{(-\\frac{2}{{x}^{3}})}{(-\\frac{4}{{x}^{5}})} \\\\  & ={lim}_{x\\to 0}\\frac{2{x}^{-3}}{4{x}^{-5}} \\\\  & ={lim}_{x\\to 0}\\frac{{x}^{2}}{2} \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069507 :knowledge-point/_questions [{:db/id #edb/ref 17592186068690 :knowledge-point/id #uuid "9f29435f-b112-5999-b0ca-9003d9e622e1" :knowledge-point/title "Calculating an Indeterminate Limit of the Form Infinity Divided by Infinity Using L'Hopital's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c029288-0577-53f2-b622-20d182eb4958" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186336446} {:answer/id #uuid "537b5f65-839c-5501-a32d-7c7e7a49a12b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186336806} {:answer/id #uuid "77455b1e-3f23-5bec-b73a-1b6c9dc86ab2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186337106} {:answer/id #uuid "9e26fb10-c993-50f5-8b93-429253440f15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186337463} {:answer/id #uuid "e2592f07-77fc-5726-895f-b9958ca63d12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186338000}] :answer-field/correct {:answer/id #uuid "e2592f07-77fc-5726-895f-b9958ca63d12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186338000} :answer-field/id #uuid "d7f9d37f-e6cb-53f6-b39d-a73c1eb6742f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338656}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8a9948ce-563f-5b0f-bd31-1937130137d2" :question/math-academy-id "q-72339" :question/problem "Evaluate ${lim}_{x\\to {0}^{+}}\\frac{\\operatorname{ln}⁡(\\operatorname{sin}⁡x)}{\\operatorname{csc}⁡x}.$" :question/worked-solution "Here the limits of the numerator and denominator are ${lim}_{x\\to {0}^{+}}\\operatorname{ln}⁡(\\operatorname{sin}⁡x)=-\\infty $ and ${lim}_{x\\to {0}^{+}}\\operatorname{csc}⁡x=\\infty ,$ respectively, so we have the case $\\frac{-\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}\\frac{\\operatorname{ln}⁡(\\operatorname{sin}⁡x)}{\\operatorname{csc}⁡x} & ={lim}_{x\\to {0}^{+}}\\frac{{[\\operatorname{ln}⁡(\\operatorname{sin}⁡x)]}^{′}}{[\\operatorname{csc}⁡x]^{′}} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{\\operatorname{cot}⁡x}{-\\operatorname{csc}⁡x\\operatorname{cot}⁡x} \\\\  & =-{lim}_{x\\to {0}^{+}}\\frac{\\cancel{\\operatorname{cot}⁡x}}{\\operatorname{csc}⁡x\\cancel{\\operatorname{cot}⁡x}} \\\\  & =-{lim}_{x\\to {0}^{+}}\\frac{1}{\\operatorname{csc}⁡x} \\\\  & =-{lim}_{x\\to {0}^{+}}\\operatorname{sin}⁡x \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339100 :knowledge-point/_questions [{:db/id #edb/ref 17592186068722 :knowledge-point/id #uuid "b89c50f3-2181-5b61-96cb-386ef88d2035" :knowledge-point/title "Integrating an Expression Involving a Power Function Multiplied by Its Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "181818f9-ee5d-570b-8805-3453bec6da26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{(1+{x}^{5})^{3}}+C" :db/id #edb/ref 17592186336257} {:answer/id #uuid "324b72d3-41e0-5026-af58-5b34dc0551ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{1+{x}^{5}}+C" :db/id #edb/ref 17592186336509} {:answer/id #uuid "601c5f25-3385-59f3-b9ec-6f4783410687" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{1+{x}^{5}}}{2}+C" :db/id #edb/ref 17592186336901} {:answer/id #uuid "d13e9d9a-a682-5a93-b274-9657dd12c702" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x\\sqrt{1+{x}^{5}}+C" :db/id #edb/ref 17592186337864} {:answer/id #uuid "e2d6ab9a-d942-55d2-8674-766bbfa15318" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{(1+{x}^{5})^{3}}}{2}+C" :db/id #edb/ref 17592186338008}] :answer-field/correct {:answer/id #uuid "324b72d3-41e0-5026-af58-5b34dc0551ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{1+{x}^{5}}+C" :db/id #edb/ref 17592186336509} :answer-field/id #uuid "1287170e-aae1-5d7e-9ef3-ec229bb6713f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338307}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "94a2c36c-7f20-5b89-950f-742f856d9127" :question/math-academy-id "q-72382" :question/problem "Calculate $\\int \\frac{5{x}^{4}}{\\sqrt{1+{x}^{5}}}\\,\\text{d}x.$" :question/worked-solution "We note that $5{x}^{4}$ is the derivative of the quantity in the radical. So we make a substitution\n\n$$\nu=1+{x}^{5}.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =5{x}^{4}\\,⟹\\,\\text{d}u=5{x}^{4}\\,\\text{d}x,\\end{aligned}\n$$\n\nand rewriting our integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{5{x}^{4}}{\\sqrt{1+{x}^{5}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{1+{x}^{5}}}\\,5{x}^{4}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =\\int \\frac{1}{{u}^{1/2}}\\,\\text{d}u \\\\  & =\\int {u}^{-1/2}\\,\\text{d}u.\\end{aligned}\n$$\n\nWe can now solve the integral using the power rule:\n\n$$\n\\begin{aligned}\\int {u}^{-1/2}\\,\\text{d}u & =\\frac{{u}^{1/2}}{(\\frac{1}{2})}+C \\\\  & =2{u}^{1/2}+C \\\\  & =2\\sqrt{u}+C\\end{aligned}\n$$\n\nLastly, we substitute $u=1+{x}^{5}$ back in the expression. So the final result is\n\n$$\n\\begin{aligned}\\int \\frac{5{x}^{4}}{\\sqrt{1+{x}^{5}}}\\,\\text{d}x & =2\\sqrt{1+{x}^{5}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339103 :knowledge-point/_questions [{:db/id #edb/ref 17592186087824 :knowledge-point/id #uuid "0b70a3b7-90a7-5a83-b71f-304f7f25c4ef" :knowledge-point/title "Identifying the Shift and Stretch Applied to an Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "121b16a2-0458-5600-9a6f-f4f6e552fd5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3({2}^{x})-2" :db/id #edb/ref 17592186336202} {:answer/id #uuid "4c671da3-c302-5f3c-9ea5-2dc6dac2cc6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3({2}^{x})+2" :db/id #edb/ref 17592186336742} {:answer/id #uuid "6fed05ea-acde-5be8-b414-01135dc6f042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3({2}^{x})-1" :db/id #edb/ref 17592186337023} {:answer/id #uuid "826ab4ce-caa8-5db7-9188-f1b3cd74a9bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={2}^{x}-1" :db/id #edb/ref 17592186337218} {:answer/id #uuid "9cf95245-48b9-524a-917b-0ba71da5cdb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2({2}^{x})-1" :db/id #edb/ref 17592186337452}] :answer-field/correct {:answer/id #uuid "6fed05ea-acde-5be8-b414-01135dc6f042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3({2}^{x})-1" :db/id #edb/ref 17592186337023} :answer-field/id #uuid "0eab9c10-198f-58c5-918e-000cc777273e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338303}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9f0333a8-0cc0-5b0c-9999-f5175286f364" :question/math-academy-id "q-7239" :question/problem "![](images/1c/1ca11413bbce2ff307e494fb5a79028535b76cff24619e6921620f88c3e274ec.png)\n\nThe graph above shows $y=k({2}^{x})+c.$  Determine the values of $k$ and $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of the curve $y=k({2}^{x})+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=-1,$ so $c=-1.$\n\nTherefore, our function takes the form\n\n$$\ny=k({2}^{x})-1.\n$$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ The labeled point on the graph is $(0,2),$ so we substitute $x=0$ and $y=2$ into the function and solve for $k:$\n\n$$\n\\begin{aligned}y & =k({2}^{x})-1 \\\\ 2 & =k({2}^{0})-1 \\\\ 2 & =k(1)-1 \\\\ 2 & =k-1 \\\\ 3 & =k\\end{aligned}\n$$\n\nTherefore, the curve is $y=3({2}^{x})-1.$"}] [{:db/id #edb/ref 17592186339109 :knowledge-point/_questions [{:db/id #edb/ref 17592186087824 :knowledge-point/id #uuid "0b70a3b7-90a7-5a83-b71f-304f7f25c4ef" :knowledge-point/title "Identifying the Shift and Stretch Applied to an Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49005b9e-8885-518c-a503-38932dbc77f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1.5({2}^{x})+4" :db/id #edb/ref 17592186336710} {:answer/id #uuid "a7777608-b4d4-5368-84cb-c7a407165b82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1.5({2}^{x})+3" :db/id #edb/ref 17592186337546} {:answer/id #uuid "ba7873cf-81b9-5aaf-8051-9f548d554ab8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0.5({2}^{x})+4" :db/id #edb/ref 17592186337684} {:answer/id #uuid "c3ad9d29-36d5-5b4e-bad4-d6181862fae0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1.5({2}^{x})+5" :db/id #edb/ref 17592186337768} {:answer/id #uuid "e97102d4-c948-5475-a8f4-3282b09cc04f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0.5({2}^{x})+5" :db/id #edb/ref 17592186338069}] :answer-field/correct {:answer/id #uuid "49005b9e-8885-518c-a503-38932dbc77f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1.5({2}^{x})+4" :db/id #edb/ref 17592186336710} :answer-field/id #uuid "08a06ece-0b13-5c0a-9459-301060485f8d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338290}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5a92c523-6f37-5b9d-8ed7-2c5b4d7360ee" :question/math-academy-id "q-7241" :question/problem "![](images/3a/3a78c4fc61bbf60e1cdfdba6303ecc1a9d5e09caa21d0879556106893a931a09.png)\n\nThe graph above shows $y=k({2}^{x})+c.$  Determine the values of $k$ and $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of the curve $y=k({2}^{x})+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=4,$ so $c=4.$\n\nTherefore, our function takes the form\n\n$$\ny=k({2}^{x})+4.\n$$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ The labeled point on the graph is $(0,5.5),$ so we substitute $x=0$ and $y=5.5$ into the function and solve for $k:$\n\n$$\n\\begin{aligned}y & =k({2}^{x})+4 \\\\ 5.5 & =k({2}^{0})+4 \\\\ 5.5 & =k(1)+4 \\\\ 5.5 & =k+4 \\\\ 1.5 & =k\\end{aligned}\n$$\n\nTherefore, the curve is $y=1.5({2}^{x})+4.$"}] [{:db/id #edb/ref 17592186398961 :knowledge-point/_questions [{:db/id #edb/ref 17592186064203 :knowledge-point/id #uuid "e2b47545-fdf1-5e6a-b0bb-bbbecb8067cc" :knowledge-point/title "Integrating an Algebraic Function With Positive Integer Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6058cb14-4722-5ae2-982a-1d1d72759305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-(7-2x)^{8}+C" :db/id #edb/ref 17592186398963} {:answer/id #uuid "615ab3c3-1cc9-56db-a561-9ade7641ace4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}(7-2x)^{8}+C" :db/id #edb/ref 17592186398964} {:answer/id #uuid "2b200597-1f86-5ecd-b8bc-18b09c132aad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(7-2x)^{8}+C" :db/id #edb/ref 17592186398965} {:answer/id #uuid "13a3fa38-b420-5956-8a4b-2194f2d8ef30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}(7-2x)^{8}+C" :db/id #edb/ref 17592186398966} {:answer/id #uuid "5674f007-df38-5b04-ac90-1342c70182a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(7-2x)^{8}+C" :db/id #edb/ref 17592186398967}] :answer-field/correct {:answer/id #uuid "6058cb14-4722-5ae2-982a-1d1d72759305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-(7-2x)^{8}+C" :db/id #edb/ref 17592186398963} :answer-field/id #uuid "6ee57767-a470-5ed2-888e-e7479cb9accb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398962}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8c75bb9c-44e2-5f73-9a68-3c296ae237a7" :question/math-academy-id "q-72424" :question/problem "$\\int 16(7-2x)^{7}\\,\\text{d}x=$" :question/worked-solution "Let $u=7-2x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-2\\,⟹\\,\\text{d}x=-\\frac{1}{2}\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $x$ at the very end:\n\n$$\n\\begin{aligned}\\int 16(7-2x)^{7}\\,\\text{d}x & =\\int 16{u}^{7}\\cdot (-\\frac{1}{2})\\,\\text{d}u \\\\  & =16\\int {u}^{7}\\cdot (-\\frac{1}{2})\\,\\text{d}u \\\\  & =16\\cdot (-\\frac{1}{2})\\int {u}^{7}\\,\\text{d}u \\\\  & =-8\\cdot \\frac{{u}^{8}}{8}+C \\\\  & =-{u}^{8}+C \\\\  & =-(7-2x)^{8}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[-(7-2x)^{8}+C] & =-\\frac{\\text{d}}{\\text{d}x}[(7-2x)^{8}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =-8(7-2x)^{7}\\cdot \\frac{\\text{d}}{\\text{d}x}(7-2x)+0 \\\\  & =-8(7-2x)^{7}\\cdot (-2) \\\\  & =16(7-2x)^{7}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339116 :knowledge-point/_questions [{:db/id #edb/ref 17592186064207 :knowledge-point/id #uuid "bdbfa506-08a1-5e43-b958-2ae373df775d" :knowledge-point/title "Integrating a Linear Rational Function and Simplifying the Arbitrary Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ea8c3ea-0518-506a-9945-ef3bf2bf7936" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{ln}⁡(K|7-x|)" :db/id #edb/ref 17592186336171} {:answer/id #uuid "6ae31738-7e11-5b61-bda5-73b51a186dc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{7}\\operatorname{ln}⁡(K|7-x|)" :db/id #edb/ref 17592186336978} {:answer/id #uuid "9dd74f15-1558-5167-ae1a-0738b496e927" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|7-x|)" :db/id #edb/ref 17592186337459} {:answer/id #uuid "afeaa9dd-27fb-515f-9b9a-a9fc160293f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(K|7-x|)" :db/id #edb/ref 17592186337612} {:answer/id #uuid "c8d07741-d286-59ef-b0bc-34120b2124b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{7}\\operatorname{ln}⁡(K|7-x|)" :db/id #edb/ref 17592186337807}] :answer-field/correct {:answer/id #uuid "0ea8c3ea-0518-506a-9945-ef3bf2bf7936" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{ln}⁡(K|7-x|)" :db/id #edb/ref 17592186336171} :answer-field/id #uuid "14072edb-e48a-597d-a3df-afce4caaaa51" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338311}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b16baf99-001c-5b72-bc61-2ffc6c75b449" :question/math-academy-id "q-72445" :question/problem "Calculate $\\int \\frac{1}{7-x}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "First, let $u=7-x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-1\\,⟹\\,\\text{d}x=-\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{7-x}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot (-1)\\,\\text{d}u \\\\  & =-\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\operatorname{ln}⁡|u|+C \\\\  & =-\\operatorname{ln}⁡|7-x|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=-\\operatorname{ln}⁡K$ for another arbitrary constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}-\\operatorname{ln}⁡|7-x|+C & =-\\operatorname{ln}⁡|7-x|-\\operatorname{ln}⁡K \\\\  & =-(\\operatorname{ln}⁡|7-x|+\\operatorname{ln}⁡K) \\\\  & =-\\operatorname{ln}⁡(K|7-x|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{1}{7-x}\\,\\text{d}x=-\\operatorname{ln}⁡(K|7-x|).\n$$"}] [{:db/id #edb/ref 17592186339117 :knowledge-point/_questions [{:db/id #edb/ref 17592186064207 :knowledge-point/id #uuid "bdbfa506-08a1-5e43-b958-2ae373df775d" :knowledge-point/title "Integrating a Linear Rational Function and Simplifying the Arbitrary Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07b76063-8fda-596f-8106-cbb57f2ef69a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186336093} {:answer/id #uuid "86f6a2e9-4d29-5e23-9617-09660280aaa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186337252} {:answer/id #uuid "b4ead48b-c59a-570e-a7de-39bcbc22b8fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186337638} {:answer/id #uuid "bec88b66-0b15-559a-8f7c-3341c51c2ee0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186337729} {:answer/id #uuid "f6322442-f9d7-5f7c-ac2d-896d214f1436" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186338188}] :answer-field/correct {:answer/id #uuid "bec88b66-0b15-559a-8f7c-3341c51c2ee0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186337729} :answer-field/id #uuid "209f233a-25a9-55a5-ab33-40122ec3bf02" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338337}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2d475585-492e-5142-bfa4-12e97136e061" :question/math-academy-id "q-72446" :question/problem "Calculate $\\int \\frac{1}{5-2x}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "First, let $u=5-2x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-2\\,⟹\\,\\text{d}x=-\\frac{1}{2}\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{5-2x}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot (-\\frac{1}{2})\\,\\text{d}u \\\\  & =-\\frac{1}{2}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡|u|+C \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡|5-2x|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=-\\frac{1}{2}\\operatorname{ln}⁡K$ for another arbitrary constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}-\\frac{1}{2}\\operatorname{ln}⁡|5-2x|+C & =-\\frac{1}{2}\\operatorname{ln}⁡|5-2x|-\\frac{1}{2}\\operatorname{ln}⁡K \\\\  & =-\\frac{1}{2}(\\operatorname{ln}⁡|5-2x|+\\operatorname{ln}⁡K) \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{1}{5-2x}\\text{d}x=-\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|).\n$$"}] [{:db/id #edb/ref 17592186339119 :knowledge-point/_questions [{:db/id #edb/ref 17592186064208 :knowledge-point/id #uuid "af32f07f-fa65-5ede-a506-735dc2d3a5ef" :knowledge-point/title "Integrating a Combination of Linear Rational Functions Using the General Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f5cd12b-daf8-57b4-a508-5b25997dfab6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|(2x+1)(2x-1)|)" :db/id #edb/ref 17592186336323} {:answer/id #uuid "4b0ccfc1-4a8e-5fe1-b80c-9d8713467d76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(K|\\frac{2x+1}{2x-1}|)" :db/id #edb/ref 17592186336723} {:answer/id #uuid "4e0854d1-efd5-57d5-ad92-34e8d95cd84e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(K|(2x+1)(2x-1)|)" :db/id #edb/ref 17592186336758} {:answer/id #uuid "89828476-cdcf-5b30-b125-067c9a0a1d66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(K|\\frac{2x+1}{2x-1}|)" :db/id #edb/ref 17592186337271} {:answer/id #uuid "8e9493db-04ea-5567-b436-e98702a20a0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|\\frac{2x+1}{2x-1}|)" :db/id #edb/ref 17592186337316}] :answer-field/correct {:answer/id #uuid "1f5cd12b-daf8-57b4-a508-5b25997dfab6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|(2x+1)(2x-1)|)" :db/id #edb/ref 17592186336323} :answer-field/id #uuid "dd143701-6720-5620-9d38-200cfec896ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338665}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b89e488e-b744-5dec-bdcd-c1a1eb5f6a8b" :question/math-academy-id "q-72449" :question/problem "Calculate $\\int (\\frac{1}{2x+1}+\\frac{1}{2x-1})\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "Let's solve this using the general formula:\n\n$$\n\\begin{aligned}\\int (\\frac{1}{2x+1}+\\frac{1}{2x-1})\\,\\text{d}x & =\\int \\frac{1}{2x+1}\\,\\text{d}x+\\int \\frac{1}{2x-1}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|2x+1|+\\frac{1}{2}\\operatorname{ln}⁡|2x-1|+C \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|(2x+1)(2x-1)|+\\frac{1}{2}\\text{ }\\operatorname{ln}⁡K \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(K|(2x+1)(2x-1)|)\\end{aligned}\n$$\n\nNotice that we used the laws of logarithms to write the result as a single logarithm."}] [{:db/id #edb/ref 17592186339123 :knowledge-point/_questions [{:db/id #edb/ref 17592186068723 :knowledge-point/id #uuid "8fe2a279-0b92-561e-b17d-b902f43725ac" :knowledge-point/title "Integrating an Expression Involving a Power Function Multiplied by a Constant Multiple of Its Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e59935f-f93b-599b-9816-d15f61104595" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186336167} {:answer/id #uuid "1ccce204-ca7a-5eee-bc02-3fcc7e16e632" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186336299} {:answer/id #uuid "4b5b5f53-8881-5e03-8cde-ddfcc41895a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186336732} {:answer/id #uuid "75e7362c-a6a5-5145-bf5d-1527db0f317d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186337095} {:answer/id #uuid "7bc5cfb0-4b70-528a-a0e4-e88e561188b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186337152}] :answer-field/correct {:answer/id #uuid "75e7362c-a6a5-5145-bf5d-1527db0f317d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186337095} :answer-field/id #uuid "80b5679a-f4f7-56bb-9b5b-253ee5665aec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338504}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "de70203f-dd05-5f0d-9800-283717012618" :question/math-academy-id "q-72467" :question/problem "Calculate $\\int x\\sqrt{{x}^{2}-5}\\,\\text{d}x.$" :question/worked-solution "In this case, the $x$ that's outside the square root isn't quite the derivative of $({x}^{2}-5).$ But the derivative is $2x,$ so we're only out by a constant factor.\n\nSo we make the substitution\n\n$$\nu={x}^{2}-5.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x,\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\begin{aligned}\\int x\\sqrt{{x}^{2}-5}\\,\\text{d}x & =\\int \\sqrt{{x}^{2}-5}\\cdot x\\,\\text{d}x \\\\  & =\\int \\sqrt{u}\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{1}{2}\\int {u}^{1/2}\\,\\text{d}u\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}\\frac{1}{2}\\int {u}^{1/2}\\,\\text{d}u & =\\frac{1}{2}\\cdot \\frac{{u}^{3/2}}{(\\frac{3}{2})}+C \\\\  & =\\frac{1}{2}\\cdot \\frac{2}{3}\\cdot {u}^{3/2}+C \\\\  & =\\frac{1}{3}{u}^{3/2}+C \\\\  & =\\frac{1}{3}\\sqrt{{u}^{3}}+C \\\\  & =\\frac{1}{3}\\sqrt{({x}^{2}-5)^{3}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186111390 :knowledge-point/_questions [{:db/id #edb/ref 17592186110669 :knowledge-point/id #uuid "34645eb8-3624-5ff3-817d-28f8d0cee4ba" :knowledge-point/title "Identifying the Scaling Constant From a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dc7ed7d-8822-50d6-adbe-ad3f4f94cc16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186336309} {:answer/id #uuid "2855b2b9-6a8b-51fc-bc86-192bc1d62f6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186336410} {:answer/id #uuid "62f307be-5f4b-5771-b9ee-77edd782e456" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186336922} {:answer/id #uuid "75294229-d638-5281-9b75-127f796a0330" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186337087} {:answer/id #uuid "a40c3d37-1f3e-56af-9259-897cf2fc43fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186337522}] :answer-field/correct {:answer/id #uuid "1dc7ed7d-8822-50d6-adbe-ad3f4f94cc16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186336309} :answer-field/id #uuid "dfe47395-e6a4-5174-8bac-b9841d8af59f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338671}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7ca56a13-e2a8-587b-a791-0b4526ed9f52" :question/math-academy-id "q-7249" :question/problem "![](images/db/db4c6694a3bc172aea8a47f1a828eac8235286b7ce6b7e327574790a6c31c270.png)\n\nThe graph above shows $y=k{(\\frac{1}{3})}^{x}.$ What is the value of $k?$" :question/worked-solution "To plot the graph of $y=k{(\\frac{1}{3})}^{x}$ we take the graph of $y={(\\frac{1}{3})}^{x}$ and stretch it vertically by a scale factor of  $k.$ Under the action of this transformation, the $y$-intercept is mapped from $(0,1)$ to $(0,k).$\n\nComparing the point $(0,3)$ on the graph to $(0,k),$ we see that we must have $k=3.$"}] [{:db/id #edb/ref 17592186339129 :knowledge-point/_questions [{:db/id #edb/ref 17592186110599 :knowledge-point/id #uuid "29005c66-9f30-5862-926f-8a09320d404c" :knowledge-point/title "Determining Whether Two Lines in Slope-Intercept Form are Perpendicular"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad7f19f7-5593-5372-821e-d1252d3b8446" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x" :db/id #edb/ref 17592186337587} {:answer/id #uuid "c0e66778-1d33-59c9-9c63-84193616625d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2x-3" :db/id #edb/ref 17592186337745} {:answer/id #uuid "cf4a56a8-6d0c-5363-9d42-b65beb462d50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{x}{2}x+5" :db/id #edb/ref 17592186337846} {:answer/id #uuid "cf58d7b6-9e04-5b2a-b15f-7c5224686dfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{x}{2}x-1" :db/id #edb/ref 17592186337847} {:answer/id #uuid "f9e1b841-fe74-5a6f-9da0-dd60389da801" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x+19" :db/id #edb/ref 17592186338222}] :answer-field/correct {:answer/id #uuid "f9e1b841-fe74-5a6f-9da0-dd60389da801" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x+19" :db/id #edb/ref 17592186338222} :answer-field/id #uuid "833a989b-8bb1-589d-92ce-6ba9062090a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338511}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cdd0bbdf-150a-52db-a038-e888ce1f0809" :question/math-academy-id "q-72524" :question/problem "Which of the following lines is perpendicular to $y=-\\frac{x}{2}+7?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nThe line $y=-\\frac{x}{2}+7$ is in slope-intercept form, and its slope is $-\\frac{1}{2}.$\n\nLooking at the answer choices, the line $y=2x+19$ has a slope of $2.$\n\nMultiplying the slopes together, we have\n\n$$\n-\\frac{1}{2}\\cdot 2=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=2x+19$ is perpendicular to the given line."}] [{:db/id #edb/ref 17592186403592 :knowledge-point/_questions [{:db/id #edb/ref 17592186068900 :knowledge-point/id #uuid "66ade855-4b16-514b-b44a-1d6b9d61ef28" :knowledge-point/title "Identifying the Shift Applied to an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "128902a2-01ba-574b-8cb8-9e24d91588d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{2})}^{x}+3" :db/id #edb/ref 17592186403594} {:answer/id #uuid "d421b62c-91bc-51bd-9a1e-dcb674541fa2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{2})}^{x}" :db/id #edb/ref 17592186403595} {:answer/id #uuid "89b95e28-4bdc-577f-9fef-39eb015deed9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{2})}^{x}-1" :db/id #edb/ref 17592186403596} {:answer/id #uuid "1f9a6792-46dd-54a0-852a-c3ce900255d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{2})}^{x}+1" :db/id #edb/ref 17592186403597} {:answer/id #uuid "cdf02042-68e8-57bc-821d-c4e709f6e6d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{2})}^{x}+2" :db/id #edb/ref 17592186403598}] :answer-field/correct {:answer/id #uuid "1f9a6792-46dd-54a0-852a-c3ce900255d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{2})}^{x}+1" :db/id #edb/ref 17592186403597} :answer-field/id #uuid "86226cb6-da89-5070-bdaf-be3482566831" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403593}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c80543b3-4997-5175-82f2-660b5af23e52" :question/math-academy-id "q-7253" :question/problem "![](images/50/50be1f4a894e86b5f06fba18655caca163c3d4c7a3423d2ecf159aa49975eb8c.png)\n\nThe graph above shows the curve $y={(\\frac{1}{2})}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={(\\frac{1}{2})}^{x}$ is $y=0.$\n\nThe vertical translation $y={(\\frac{1}{2})}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=1.$ Therefore, $c=1.$"}] [{:db/id #edb/ref 17592186069509 :knowledge-point/_questions [{:db/id #edb/ref 17592186068724 :knowledge-point/id #uuid "18ce1807-3a09-5ebd-b3cd-a91db8d2b4a8" :knowledge-point/title "Integrating a Rational Function Using Natural Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a56f775-026e-59fc-b647-34d85fe8bf61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|3{x}^{2}-1|+C" :db/id #edb/ref 17592186336275} {:answer/id #uuid "a1728457-38ba-5bbb-927c-7282a90dc1b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|{x}^{3}-1|+C" :db/id #edb/ref 17592186337496} {:answer/id #uuid "b51f8e66-052a-5029-8ff7-97299bdc0642" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|{x}^{3}-x|+C" :db/id #edb/ref 17592186337639} {:answer/id #uuid "f743a007-0c6c-5682-a772-447548f069d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|3{x}^{2}-x|+C" :db/id #edb/ref 17592186338200} {:answer/id #uuid "f9436168-b71c-5730-9e91-324b6cdb60f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|\\frac{1}{{x}^{3}-1}|+C" :db/id #edb/ref 17592186338217}] :answer-field/correct {:answer/id #uuid "b51f8e66-052a-5029-8ff7-97299bdc0642" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|{x}^{3}-x|+C" :db/id #edb/ref 17592186337639} :answer-field/id #uuid "e9839270-94f7-5e94-999d-41a70f88e25f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338685}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "604f6b09-192e-50e6-8477-dce586313508" :question/math-academy-id "q-72566" :question/problem "$\\int \\frac{3{x}^{2}-1}{{x}^{3}-x}\\,\\text{d}x=$" :question/worked-solution "Let $u={x}^{3}-x.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}-1\\,⟹\\,\\text{d}u=(3{x}^{2}-1)\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{3{x}^{2}-1}{{x}^{3}-x}\\,\\text{d}x & =\\int \\frac{1}{{x}^{3}-x}\\cdot (3{x}^{2}-1)\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡|{x}^{3}-x|+C\\end{aligned}\n$$"}]}
