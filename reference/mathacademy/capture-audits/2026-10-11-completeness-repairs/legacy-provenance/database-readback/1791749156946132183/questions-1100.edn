#{[{:db/id #edb/ref 17592186297157 :knowledge-point/_questions [{:db/id #edb/ref 17592186115284 :knowledge-point/id #uuid "66534e01-fdc6-522f-b90a-59a8118bc67b" :knowledge-point/title "Finding the Second Complex Root of a Quadratic Equation Given the First Root"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "074e1768-bc8a-50d9-b53c-43bd12be6b05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-2-7\\text{i}}{-2}" :db/id #edb/ref 17592186295303} {:answer/id #uuid "26f0903e-3e78-51bc-b188-e2eb5a092c40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2-7\\text{i}}{2}" :db/id #edb/ref 17592186295479} {:answer/id #uuid "d6e89224-8057-5f39-9fb8-31f4cb3fe5a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-7-2\\text{i}}{2}" :db/id #edb/ref 17592186296398} {:answer/id #uuid "da9cbed8-b43d-563e-851e-a996cab9c5de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-2-7\\text{i}}{2}" :db/id #edb/ref 17592186296420} {:answer/id #uuid "f9b95dbe-7364-5af0-8a0d-dc48365dde9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-7+2\\text{i}}{2}" :db/id #edb/ref 17592186296593}] :answer-field/correct {:answer/id #uuid "da9cbed8-b43d-563e-851e-a996cab9c5de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-2-7\\text{i}}{2}" :db/id #edb/ref 17592186296420} :answer-field/id #uuid "49a20f34-443b-55d2-af98-8273be8b8ace" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296771}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "179b51f5-6286-53a0-bd97-91549ab321d7" :question/math-academy-id "q-28519" :question/problem "A quadratic equation with real coefficients has a root $x=\\frac{-2+7\\text{i}}{2}.$ What is the other root?" :question/worked-solution "We're given that the quadratic equation has real coefficients and that $x=\\frac{-2+7\\text{i}}{2}=-1+\\frac{7}{2}\\text{i}$ is a root. Therefore, its complex conjugate $x=-1-\\frac{7}{2}\\text{i}=\\frac{-2-7\\text{i}}{2}$ is also a root."}] [{:db/id #edb/ref 17592186115693 :knowledge-point/_questions [{:db/id #edb/ref 17592186115285 :knowledge-point/id #uuid "0db14c2a-b6c3-5550-8ff6-c1a9e2b4ea5d" :knowledge-point/title "Finding a Quadratic Equation Given an Imaginary Root and Its Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bad7587-7ec6-57a4-a5f4-b297e751b2e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}+4=0" :db/id #edb/ref 17592186295331} {:answer/id #uuid "651357c3-155d-5e2b-8229-a2f0c8d73b99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}+12=0" :db/id #edb/ref 17592186295843} {:answer/id #uuid "afeb9aa0-d6c7-567a-841d-74f1e5863e87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}-12=0" :db/id #edb/ref 17592186296194} {:answer/id #uuid "bdeabb6f-d608-5568-a961-832dfff28339" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}+6=0" :db/id #edb/ref 17592186296268} {:answer/id #uuid "f775651a-d43f-5122-bc88-ae7cb6a50b17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}-4=0" :db/id #edb/ref 17592186296582}] :answer-field/correct {:answer/id #uuid "651357c3-155d-5e2b-8229-a2f0c8d73b99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}+12=0" :db/id #edb/ref 17592186295843} :answer-field/id #uuid "5098eb42-9a92-5a11-971d-950db7f70c28" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296791}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d6f01fd2-19c8-5c6d-b91d-8da801444f5f" :question/math-academy-id "q-28523" :question/problem "A quadratic equation in the variable $x$ with real coefficients has a root $x=2\\text{i}.$ Given that the coefficient of ${x}^{2}$ in the equation is $3$, find the equation." :question/worked-solution "Since the quadratic equation has real coefficients and  $x=2\\text{i}$ is a root, its conjugate  $x=-2\\text{i}$ must also be a root. Therefore, using the zero product property, we can write a quadratic equation with the required roots as follows:\n\n$$\n(x-2\\text{i})(x+2\\text{i})=0\n$$\n\nMultiplying out the parentheses and simplifying gives\n\n$$\n\\begin{aligned}{x}^{2}-(2\\text{i})^{2} & =0 \\\\ {x}^{2}-4(-1) & =0 \\\\ {x}^{2}+4 & =0.\\end{aligned}\n$$\n\nThis equation has roots $x=\\pm 2\\text{i},$ but the coefficient of ${x}^{2}$ is not $3.$ Therefore, to find the desired equation, we multiply the equation above by $3.$ This gives\n\n$$\n\\begin{aligned}3({x}^{2}+4) & =0 \\\\ 3{x}^{2}+12 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115694 :knowledge-point/_questions [{:db/id #edb/ref 17592186115285 :knowledge-point/id #uuid "0db14c2a-b6c3-5550-8ff6-c1a9e2b4ea5d" :knowledge-point/title "Finding a Quadratic Equation Given an Imaginary Root and Its Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d747e8f-1516-5356-a68e-3242c2e0b5c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}^{2}+1=0" :db/id #edb/ref 17592186295712} {:answer/id #uuid "86d21581-634d-520e-8cb4-2207578681e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}^{2}+x-2=0" :db/id #edb/ref 17592186295990} {:answer/id #uuid "9d8e57d3-8e34-5211-9924-d6901cc31ecc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}^{2}-1=0" :db/id #edb/ref 17592186296109} {:answer/id #uuid "ac9ffb89-8c4c-5fe6-8e49-f98e29efbb0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}^{2}-2=0" :db/id #edb/ref 17592186296177} {:answer/id #uuid "ff61b11b-058e-5e5d-bffb-2f5d498f1498" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}^{2}+x-4=0" :db/id #edb/ref 17592186296632}] :answer-field/correct {:answer/id #uuid "ac9ffb89-8c4c-5fe6-8e49-f98e29efbb0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}^{2}-2=0" :db/id #edb/ref 17592186296177} :answer-field/id #uuid "c9184891-8e98-571c-9abe-4db062243382" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297049}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ca36dd1b-a9c8-5277-83cd-01acbe618070" :question/math-academy-id "q-28524" :question/problem "A quadratic equation in the variable $x$ with real coefficients has a root $x=-\\text{i}.$ Given that the coefficient of ${x}^{2}$ in the equation is $-2$, find the equation." :question/worked-solution "Since the quadratic equation has real coefficients and  $x=-\\text{i}$ is a root, its conjugate  $x=\\text{i}$ must also be a root. Therefore, using the zero product property, we can write a quadratic equation with the required roots as follows:\n\n$$\n(x-\\text{i})(x+\\text{i})=0\n$$\n\nMultiplying out the parentheses and simplifying gives\n\n$$\n\\begin{aligned}{x}^{2}-(\\text{i})^{2} & =0 \\\\ {x}^{2}-(-1) & =0 \\\\ {x}^{2}+1 & =0.\\end{aligned}\n$$\n\nThis equation has roots $x=\\pm \\text{i},$ but the coefficient of ${x}^{2}$ is not $-2.$ Therefore, to find the desired equation, we multiply the equation above by $-2.$ This gives\n\n$$\n\\begin{aligned}-2({x}^{2}+1) & =0 \\\\ -2{x}^{2}-2 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297159 :knowledge-point/_questions [{:db/id #edb/ref 17592186059677 :knowledge-point/id #uuid "89f65f58-bd3d-5c3f-b9e0-462d74d75b59" :knowledge-point/title "Computing Second Order Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b268833-a892-5a14-ab75-38558f16bc57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186295511} {:answer/id #uuid "bf7be3a8-94b4-5a24-adb6-b753140ab093" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186296278} {:answer/id #uuid "d19d31e7-9654-53a0-8391-14a1f9103d85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186296372} {:answer/id #uuid "d427a2bc-12c0-5bdc-b3d1-7a4dbeb358d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186296383} {:answer/id #uuid "edf73d42-1443-5359-8707-64a0a6a850c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "75" :db/id #edb/ref 17592186296527}] :answer-field/correct {:answer/id #uuid "d427a2bc-12c0-5bdc-b3d1-7a4dbeb358d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186296383} :answer-field/id #uuid "e0375b64-7629-58c5-bdc5-3b40af6de210" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297096}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "88cefa50-35a4-5398-bbcf-d41d22641c1f" :question/math-academy-id "q-28556" :question/problem "Find ${g}^{″}(4)$ if $g(x)=4{x}^{2}\\sqrt{x}-2x+7.$" :question/worked-solution "Computing the first derivative, we have\n\n$$\n\\begin{aligned}{g}^{′}(x) & ={(4{x}^{2}\\sqrt{x}-2x+7)}^{′} \\\\  & ={(4{x}^{5/2}-2x+7)}^{′} \\\\  & =4(\\frac{5}{2}){x}^{3/2}-2+0 \\\\  & =10{x}^{3/2}-2.\\end{aligned}\n$$\n\nComputing the second derivative, we have\n\n$$\n\\begin{aligned}{g}^{″}(x) & ={(10{x}^{3/2}-2)}^{′} \\\\  & =10(\\frac{3}{2}){x}^{1/2}-0 \\\\  & =15{x}^{1/2} \\\\  & =15\\sqrt{x}.\\end{aligned}\n$$\n\nFinally, evaluating the second derivative at $x=4$, we obtain\n\n$$\n\\begin{aligned}{g}^{″}(4) & =15\\sqrt{4} \\\\  & =15(2) \\\\  & =30.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186390565 :knowledge-point/_questions [{:db/id #edb/ref 17592186217153 :knowledge-point/id #uuid "b4b5807f-a10a-518a-84fa-907bf699884c" :knowledge-point/title "Exponential Functions With Vertical Reflections and Horizontal Shifts"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4654041-212f-58fc-a04c-d501e2de17cc" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/01/01cc790392c233d00b4ab30e939230a0e7ac31708a0f568557a3e36e2cf04d67.png" :db/id #edb/ref 17592186390567} {:answer/id #uuid "7f249571-f46d-5f5e-8ba5-21a7346da5bf" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b8/b83ad0f69e6d4a61227c77b3dede3632accdceaa59c1bf63da8ca8bc3fe5a7f9.png" :db/id #edb/ref 17592186390568} {:answer/id #uuid "27020075-3047-50b4-b5b4-e09fd55e5be8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/be/be39498e5ad2c3148b254844722af707d721d7447a393a2341c6c0f6690c603e.png" :db/id #edb/ref 17592186390569} {:answer/id #uuid "ba442e50-a7b9-57fb-81af-102c16ff13ef" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2e/2ebda1ba75caec9c62a9758696d2c4c45b452c29088e3811edfacd03acf3cd70.png" :db/id #edb/ref 17592186390570} {:answer/id #uuid "0daced82-677b-5026-9394-ec442ba5f4f7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/28/28e24035715baa30e89392408359033dc402264c0fdcdc5968addaa615aedf81.png" :db/id #edb/ref 17592186390571}] :answer-field/correct {:answer/id #uuid "7f249571-f46d-5f5e-8ba5-21a7346da5bf" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b8/b83ad0f69e6d4a61227c77b3dede3632accdceaa59c1bf63da8ca8bc3fe5a7f9.png" :db/id #edb/ref 17592186390568} :answer-field/id #uuid "72c70cfb-3f20-5e8d-948c-ddc2a3a7f35d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390566}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3efff02b-520d-5e70-beb3-91f843801d1a" :question/math-academy-id "q-28595" :question/problem "Which of the following is the graph of $y=-{e}^{x}+5?$" :question/worked-solution "To plot the given function, we follow these steps:\n\n- We take the curve $y={e}^{x}.$\n\n![](images/f5/f5983db4731c3fde0899ffc7afd602c7c82502f581742b62e69e8e6cf2d99e93.png)\n\n \n\n- Reflect it on the $x$-axis to give $y=-{e}^{x}.$ The $y$-intercept moves from $(0,1)$ to $(0,-1)$ but the horizontal asymptote stays at $y=0.$\n\n![](images/84/844a32e9d3640f9244b867c7411241171902c848defa0bf653b3820c3850238d.png)\n\n \n\n- Then, vertically shift it by $5$ units up to give $y=-{e}^{x}+5.$ The point $(0,-1)$ moves to $(0,4)$ and the horizontal asymptote moves from from $y=0$ to $y=5.$\n\n![](images/c4/c4cd8597702179629617890fce31272aa447a3227b74231e787a61eb4e770589.png)"}] [{:db/id #edb/ref 17592186111134 :knowledge-point/_questions [{:db/id #edb/ref 17592186110720 :knowledge-point/id #uuid "c6cd2f04-e0d5-5df0-8e74-ea737501cdf8" :knowledge-point/title "Solving For an Unknown Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16ca1cf7-eae8-588f-b62e-92e2eed7ae06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186295403} {:answer/id #uuid "5f7c70a7-d1b8-56a0-9961-6101a0fea82a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186295813} {:answer/id #uuid "89099718-058c-53aa-ac2e-3dc7b59c4b5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186296004} {:answer/id #uuid "a1cb3a02-6977-565b-8c6f-64a04e91a8d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186296129} {:answer/id #uuid "fcf45a98-a317-5ebe-a0ee-d58863e54e01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186296613}] :answer-field/correct {:answer/id #uuid "16ca1cf7-eae8-588f-b62e-92e2eed7ae06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186295403} :answer-field/id #uuid "78f9540e-726b-5906-87cd-68bbcee4ccc9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296880}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "573bc8f1-012d-5d7e-834a-c6ec17bb0b63" :question/math-academy-id "q-287970" :question/problem "Consider the equation\n\n$$\n2px=3x\n$$\n\nwhere $p$ is a constant. Given that this equation has infinitely many solutions, what is the value of $p?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=bx\n$$\n\nwhere $a$ and $b$ are constants. If $a=b,$ then the equation has infinitely many solutions.\n\nNotice that this equation is in the form $ax=bx.$ In this case, \n\n$$\na=2p,\\,b=3.\n$$\n\nTherefore, the equation has infinitely many solutions if\n\n$$\n2p=3.\n$$\n\nSolving this for $p,$ we get\n\n$$\np=\\frac{3}{2}.\n$$"}] [{:db/id #edb/ref 17592186297178 :knowledge-point/_questions [{:db/id #edb/ref 17592186204090 :knowledge-point/id #uuid "c0e7426e-553d-5f20-811f-15f3a5ea0056" :knowledge-point/title "Solving For an Unknown Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a9cd574-87f6-5684-a4a2-52f23dcc4f6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186295323} {:answer/id #uuid "4512c30d-0418-5d1a-a9a4-5767ffaddbf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186295659} {:answer/id #uuid "4e445b8e-50d5-51d4-9056-86f12aba889d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186295718} {:answer/id #uuid "967246bb-eb10-50c8-9141-55173f83e32f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186296068} {:answer/id #uuid "b2ae615f-ae70-595f-a21b-63e9d4cc1379" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186296210}] :answer-field/correct {:answer/id #uuid "b2ae615f-ae70-595f-a21b-63e9d4cc1379" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186296210} :answer-field/id #uuid "078b8df7-1fda-503a-8213-ba030a04d1b7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296656}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9d84e977-5f76-5e6a-86a0-a01877993e64" :question/math-academy-id "q-288143" :question/problem "Consider the equation in the variable $x,$ given by\n\n$$\n-3(q+4)x=6\n$$\n\nwhere $q$ is a constant. Given that this equation has no solution, what is the value of $q?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=b\n$$\n\nwhere $a$ and $b$ are constants, and $b\\ne 0.$ If $a=0,$ then the equation has no solution.\n\nNotice that this equation is in the form $ax=b.$ In this case, \n\n$$\na=-3(q+4),\\,b=6.\n$$\n\nTherefore, the equation has no solution if\n\n$$\n-3(q+4)=0.\n$$\n\nSolving this for $q,$ we get\n\n$$\n\\begin{aligned}-3(q+4) & =0 \\\\ \\frac{-3(q+4)}{-3} & =\\frac{0}{-3} \\\\ q+4 & =0 \\\\ q & =-4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297180 :knowledge-point/_questions [{:db/id #edb/ref 17592186213003 :knowledge-point/id #uuid "5cf64df7-0abb-5b42-bed6-b3664c2de89a" :knowledge-point/title "Matching a Single Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "381c6cc6-b38f-5f53-b305-453281ca3851" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186295581} {:answer/id #uuid "60e8b5fe-246c-568f-92d9-946f0504fb9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186295824} {:answer/id #uuid "77d2ee40-a49f-5b7b-8c75-007236a13614" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186295922} {:answer/id #uuid "93a6f32e-a6a3-5689-96e3-737573f92b3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186296057} {:answer/id #uuid "c4c8bcbd-fd03-58ad-896a-0505d8219e4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186296304}] :answer-field/correct {:answer/id #uuid "c4c8bcbd-fd03-58ad-896a-0505d8219e4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186296304} :answer-field/id #uuid "a549f3f8-6e62-5582-a6e8-36a320f44157" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296984}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7d2e83b2-fdb4-5969-995c-ff8567f8cf5b" :question/math-academy-id "q-288406" :question/problem "The following equation is true for all values of $x.$\n\n$$\n-5{x}^{2}+mx-6=-5{x}^{2}-3x-6\n$$\n\nWhat is the value of the constant $m?$" :question/worked-solution "Since the equation is true for all values of $x,$ the expressions on both sides must be exactly the same. That means the coefficients of the matching powers of $x$ must be equal.\n\nWe compare the linear terms on both sides. On the left-hand side, the coefficient of $x$ is $m.$ On the right-hand side, the coefficient of $x$ is $-3.$\n\nSo, we have\n\n$$\nm=-3.\n$$"}] [{:db/id #edb/ref 17592186297183 :knowledge-point/_questions [{:db/id #edb/ref 17592186110720 :knowledge-point/id #uuid "c6cd2f04-e0d5-5df0-8e74-ea737501cdf8" :knowledge-point/title "Solving For an Unknown Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45491d55-84a5-5641-85ee-02ca1a1e90b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186295660} {:answer/id #uuid "7b982f8e-1429-5175-9e47-06c33c917451" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186295944} {:answer/id #uuid "9130ffb1-ff3d-56f6-b44a-a46263f888e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186296047} {:answer/id #uuid "9540e0f1-3b23-5210-976d-85a05ecc13df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186296063} {:answer/id #uuid "f61f19b9-1bc9-5327-81ed-c1e60a23106f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186296576}] :answer-field/correct {:answer/id #uuid "9540e0f1-3b23-5210-976d-85a05ecc13df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186296063} :answer-field/id #uuid "057a3936-10b0-5e7b-83aa-558ff78363fc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296650}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "556d6e5b-c151-55e9-9606-63f27cad6bd7" :question/math-academy-id "q-288436" :question/problem "Consider the equation\n\n$$\n5px=10x\n$$\n\nwhere $p$ is a constant. Given that this equation has infinitely many solutions, what is the value of $p?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=bx\n$$\n\nwhere $a$ and $b$ are constants. If $a=b,$ then the equation has infinitely many solutions.\n\nNotice that this equation is in the form $ax=bx.$ In this case, \n\n$$\na=5p,\\,b=10.\n$$\n\nTherefore, the equation has infinitely many solutions if\n\n$$\n5p=10.\n$$\n\nSolving this for $p,$ we get\n\n$$\np=2.\n$$"}] [{:db/id #edb/ref 17592186297189 :knowledge-point/_questions [{:db/id #edb/ref 17592186213004 :knowledge-point/id #uuid "b2caeb2c-39cf-595a-8105-67d11bf0e45e" :knowledge-point/title "Solving for Two Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a121ddd-d30b-57ab-802c-d2a28aedc332" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186295598} {:answer/id #uuid "3d2d0db4-00f9-5688-a436-3938b8bbd7af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186295617} {:answer/id #uuid "902f311b-9a33-5eca-947d-790debf8ade1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186296040} {:answer/id #uuid "93583915-e4a1-5ab4-acc2-719563e5af95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186296056} {:answer/id #uuid "bf2391b3-6270-5d08-8a37-4f5e7d3097e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186296276}] :answer-field/correct {:answer/id #uuid "3a121ddd-d30b-57ab-802c-d2a28aedc332" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186295598} :answer-field/id #uuid "8913da08-c2a3-53da-a58d-4cb84b000f0c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296916}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "12cdfe66-5367-5a52-9239-ea7358c10305" :question/math-academy-id "q-288452" :question/problem "The equation\n\n$$\n{x}^{2}+nx+d={x}^{2}-12x-8\n$$\n\nis true for all values of $x,$ where $n$ and $d$ are constants. What is the value of $n+d?$" :question/worked-solution "Since the equation is true for all values of $x,$ the expressions on both sides must be exactly the same. That means the coefficients of the matching powers of $x$ must be equal.\n\nLet's compare the coefficients:\n\n- The coefficient of $x$ on the left-hand side is $n,$ and on the right-hand side it is $-12.$ So, we have \n\n$$\nn=-12.\n$$\n\n- The constant term on the left-hand side is $d,$ and on the right-hand side it is $-8.$ So, we have \n\n$$\nd=-8.\n$$\n\nNow, we compute the sum:\n\n$$\n\\begin{aligned}n+d & =-12+(-8) \\\\  & =-12-8 \\\\  & =-20\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297193 :knowledge-point/_questions [{:db/id #edb/ref 17592186213005 :knowledge-point/id #uuid "46822f28-8863-5150-a420-09c61a5c28b1" :knowledge-point/title "Comparing Factored Forms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02184017-3e72-54aa-bfde-e944921a8b7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186295273} {:answer/id #uuid "16eb5901-201a-51bf-b087-292957bc4fd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186295404} {:answer/id #uuid "6c4db019-1fa9-5008-a1ff-18e087f00500" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186295869} {:answer/id #uuid "afa15348-38f9-5b8f-840e-cdf2428bbe13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186296192} {:answer/id #uuid "e425cd77-1bed-5dc0-8e91-a77932df18a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186296485}] :answer-field/correct {:answer/id #uuid "afa15348-38f9-5b8f-840e-cdf2428bbe13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186296192} :answer-field/id #uuid "1f05b554-7726-5f32-a015-9268ca6b0c9e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296692}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "58c900de-ded0-51c6-94b4-0ca8530168c9" :question/math-academy-id "q-288468" :question/problem "The equation\n\n$$\nt(2{x}^{2}-3x+1)=-6{x}^{2}+9x-3\n$$\n\nis true for all values of $x,$ where $t$ is a constant. What is the value of $t?$" :question/worked-solution "Since the equation is true for all values of $x,$ the expressions on both sides must be exactly the same. That means that after distributing $t$ on the left-hand side, the coefficients of the matching powers of $x$ must be equal.\n\nLet's expand the left-hand side:\n\n$$\nt(2{x}^{2}-3x+1)=2t{x}^{2}-3tx+t\n$$\n\nThis must equal the right-hand side. So, we have\n\n$$\n2t{x}^{2}-3tx+t=-6{x}^{2}+9x-3.\n$$\n\nNow, we compare the coefficients of corresponding terms. \n\nComparing the ${x}^{2}$ terms, we have\n\n$$\n2t=-6\\,⇒\\,t=-3.\n$$\n\nLet's verify that value $t=-3$ produces the correct linear coefficient and constant term:\n\n- $-3t=(-3)(-3)=9\\,✓$\n\n- $t=-3\\,✓$\n\nSo, our solution is valid."}] [{:db/id #edb/ref 17592186297197 :knowledge-point/_questions [{:db/id #edb/ref 17592186204090 :knowledge-point/id #uuid "c0e7426e-553d-5f20-811f-15f3a5ea0056" :knowledge-point/title "Solving For an Unknown Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "298bad1f-9367-5a05-95d2-933a09daee2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186295501} {:answer/id #uuid "3dad73b7-975d-5246-83b7-9657d612712e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186295623} {:answer/id #uuid "a52921f6-35e3-5fd6-831b-5c76a68fe597" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186296138} {:answer/id #uuid "c10c0188-b833-5221-be57-af73a4dae17b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186296286} {:answer/id #uuid "f34978c9-f088-5aab-b438-960ba47ee1ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186296559}] :answer-field/correct {:answer/id #uuid "a52921f6-35e3-5fd6-831b-5c76a68fe597" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186296138} :answer-field/id #uuid "aab0add4-30b0-59ee-8400-8a7cc1beaf29" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296994}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1328ee8c-fdcc-59c5-a877-6291af207d84" :question/math-academy-id "q-288596" :question/problem "Consider the equation in the variable $y,$ given by\n\n$$\n(q+9)y=-6\n$$\n\nwhere $q$ is a constant. Given that this equation has no solution, what is the value of $q?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=b\n$$\n\nwhere $a$ and $b$ are constants, and $b\\ne 0.$ If $a=0,$ then the equation has no solution.\n\nNotice that this equation is in the form $ay=b.$ In this case,\n\n$$\na=q+9,\\,b=-6.\n$$\n\nTherefore, the equation has no solution if\n\n$$\nq+9=0.\n$$\n\nSolving this for $q,$ we get\n\n$$\n\\begin{aligned}q+9 & =0 \\\\ q & =-9.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297198 :knowledge-point/_questions [{:db/id #edb/ref 17592186110721 :knowledge-point/id #uuid "4b1fd794-f42b-5316-80e9-0698cb1f8b87" :knowledge-point/title "Solving a General Equation With Infinitely Many Solutions For Unknown Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26dea449-5daa-571d-bc24-21b16885571b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186295478} {:answer/id #uuid "46ff9640-80f1-5703-b7a0-6219bb604868" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186295672} {:answer/id #uuid "7f368c30-e2fd-5534-8546-adacd3bdc62c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186295955} {:answer/id #uuid "bb0e5e07-5208-59c1-8031-79b63eb57a08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186296248} {:answer/id #uuid "e8efa7fd-e32d-5724-96bb-c481dd8ea2c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186296507}] :answer-field/correct {:answer/id #uuid "46ff9640-80f1-5703-b7a0-6219bb604868" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186295672} :answer-field/id #uuid "049c5b1b-3107-5777-ad7f-5a1a5ac925c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296646}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "afc322c5-285c-5560-a114-d1da26bf18af" :question/math-academy-id "q-288622" :question/problem "Consider the equation\n\n$$\n(m+2)x+5n=7x+15\n$$\n\nwhere $m$ and $n$ are constants. Given that this equation has infinitely many solutions, what is the value of $m+n?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax+b=cx+d\n$$\n\nwhere $a,b,c,$ and $d$ are constants. This equation has infinitely many solutions if \n\n$$\na=c\\,\\text{and}\\,b=d.\n$$\n\nTo determine the values of $m$ and $n$ such that the equation\n\n$$\n(m+2)x+5n=7x+15\n$$\n\nhas infinitely many solutions, we equate the coefficients of $x,$ and we equate the constants:\n\n- Equating the coefficients of $x,$ we have\n\n$$\nm+2=7.\n$$\n\nSolving this equation for $m,$ we get\n\n$$\n\\begin{aligned}m & =5.\\end{aligned}\n$$\n\n- Equating the constants, we have\n\n$$\n5n=15.\n$$\n\nSolving this equation for $n,$ we get\n\n$$\n\\begin{aligned}n & =3.\\end{aligned}\n$$\n\nFinally, since $m=5$ and $n=3,$ we have\n\n$$\nm+n=5+3=8.\n$$"}] [{:db/id #edb/ref 17592186297200 :knowledge-point/_questions [{:db/id #edb/ref 17592186110721 :knowledge-point/id #uuid "4b1fd794-f42b-5316-80e9-0698cb1f8b87" :knowledge-point/title "Solving a General Equation With Infinitely Many Solutions For Unknown Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28da790f-20c9-5875-b417-1be764fa2aeb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186295496} {:answer/id #uuid "8db21277-c307-578a-8ebf-d5c8733da1ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186296020} {:answer/id #uuid "c24c121c-9aae-5ae4-989f-173c011f7cdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186296294} {:answer/id #uuid "c7c8cfa6-04bf-59ad-b50b-09698209ddbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186296316} {:answer/id #uuid "e7994d65-33f9-5bec-9e19-0969a17a2b2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186296497}] :answer-field/correct {:answer/id #uuid "8db21277-c307-578a-8ebf-d5c8733da1ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186296020} :answer-field/id #uuid "a71ebbc6-abec-50c8-b8f1-d671ed8c0cf9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296986}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9f55693d-3dd0-5310-a538-5dcb7f69af97" :question/math-academy-id "q-288627" :question/problem "Consider the equation\n\n$$\n\\frac{p}{2}x+q=4x+20\n$$\n\nwhere $p$ and $q$ are constants. Given that this equation has infinitely many solutions, what is the value of $p+q?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax+b=cx+d\n$$\n\nwhere $a,b,c,$ and $d$ are constants. This equation has infinitely many solutions if \n\n$$\na=c\\,\\text{and}\\,b=d.\n$$\n\nTo determine the values of $p$ and $q$ such that the equation\n\n$$\n\\frac{p}{2}x+q=4x+20\n$$\n\nhas infinitely many solutions, we equate the coefficients of $x,$ and we equate the constants:\n\n- Equating the coefficients of $x,$ we have\n\n$$\n\\frac{p}{2}=4.\n$$\n\nSolving this equation for $p,$ we get\n\n$$\n\\begin{aligned}p & =8.\\end{aligned}\n$$\n\n- Equating the constants, we get\n\n$$\nq=20.\n$$\n\nFinally, since $p=8$ and $q=20,$ we have\n\n$$\np+q=8+20=28.\n$$"}] [{:db/id #edb/ref 17592186233744 :knowledge-point/_questions [{:db/id #edb/ref 17592186083388 :knowledge-point/id #uuid "c16a30bc-0c1a-54f2-95d6-47edb0c85736" :knowledge-point/title "Determining the Product of the Roots of a Quadratic Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "119dc29c-b137-50a6-9c2e-9ac8d5e9af59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{7}" :db/id #edb/ref 17592186295367} {:answer/id #uuid "3082a4a4-01f9-5e69-8589-4ae793f7d894" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186295545} {:answer/id #uuid "60e31fc5-d679-52f0-8403-e834f9c90e53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186295823} {:answer/id #uuid "e3fabf97-650c-5f20-8a3e-869f773274b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{7}" :db/id #edb/ref 17592186296483} {:answer/id #uuid "eb5f880e-5916-5bea-a034-1eba1b1f15a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186296519}] :answer-field/correct {:answer/id #uuid "60e31fc5-d679-52f0-8403-e834f9c90e53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186295823} :answer-field/id #uuid "888fe82e-2f83-5273-a943-a23e7c4d783d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296915}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8ed9536d-f38c-5295-8805-abb310c76773" :question/math-academy-id "q-288814" :question/problem "Consider the quadratic equation\n\n$$\n7{x}^{2}-5x-14=0.\n$$\n\n**Without** solving the equation, determine the product of its solutions." :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na=7,\\,b=-5,\\,c=-14.\n$$\n\nTherefore, the product of the solutions is\n\n$$\n\\begin{aligned}\\frac{c}{a} & =\\frac{(-14)}{7}=-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083649 :knowledge-point/_questions [{:db/id #edb/ref 17592186083388 :knowledge-point/id #uuid "c16a30bc-0c1a-54f2-95d6-47edb0c85736" :knowledge-point/title "Determining the Product of the Roots of a Quadratic Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00d74572-6c12-570d-b5b4-46d60457646d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{9}" :db/id #edb/ref 17592186295271} {:answer/id #uuid "19213a87-0bbb-5148-95b8-feaba74b4642" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{9}" :db/id #edb/ref 17592186295415} {:answer/id #uuid "411e71ab-c2ca-55a2-b282-fec52773fc0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186295640} {:answer/id #uuid "d5ca4c2e-cc61-5e4f-9b7c-53692845d61c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186296390} {:answer/id #uuid "daf7dbe6-df28-5cec-bd96-e118b9a97488" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{9}" :db/id #edb/ref 17592186296423}] :answer-field/correct {:answer/id #uuid "d5ca4c2e-cc61-5e4f-9b7c-53692845d61c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186296390} :answer-field/id #uuid "0b1e993e-30b6-5f0e-8d28-4a1411fe2c2b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296663}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2145d449-33d6-569e-b25a-b8ddea914c99" :question/math-academy-id "q-288815" :question/problem "Consider the quadratic equation\n\n$$\n9{x}^{2}+7x-27=0.\n$$\n\n**Without** solving the equation, determine the product of its solutions." :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na=9,\\,b=7,\\,c=-27.\n$$\n\nTherefore, the product of the solutions is\n\n$$\n\\begin{aligned}\\frac{c}{a} & =\\frac{(-27)}{9}=-3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297213 :knowledge-point/_questions [{:db/id #edb/ref 17592186083388 :knowledge-point/id #uuid "c16a30bc-0c1a-54f2-95d6-47edb0c85736" :knowledge-point/title "Determining the Product of the Roots of a Quadratic Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79894418-732c-58c9-9ddb-c28b8aa917f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{6}" :db/id #edb/ref 17592186295931} {:answer/id #uuid "c7374353-ec78-5263-b05c-f6719c421c59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186296313} {:answer/id #uuid "dcff367f-1190-560a-bb1e-d83c05126b52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186296439} {:answer/id #uuid "fb46df49-667f-5745-8cbf-7537238ae05d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{6}" :db/id #edb/ref 17592186296604} {:answer/id #uuid "fef8aec2-f84b-51b7-bcb0-0ca5c486d888" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186296625}] :answer-field/correct {:answer/id #uuid "fef8aec2-f84b-51b7-bcb0-0ca5c486d888" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186296625} :answer-field/id #uuid "d1dc5883-eb26-5861-aa29-b6e4365854e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297070}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f379d5ac-6fe2-5ce8-b120-ae7f8d1580fe" :question/math-academy-id "q-288816" :question/problem "Consider the quadratic equation\n\n$$\n6{x}^{2}-17x-30=0.\n$$\n\n**Without** solving the equation, determine the product of its solutions." :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na=6,\\,b=-17,\\,c=-30.\n$$\n\nTherefore, the product of the solutions is\n\n$$\n\\begin{aligned}\\frac{c}{a} & =\\frac{(-30)}{6}=-5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186390572 :knowledge-point/_questions [{:db/id #edb/ref 17592186083388 :knowledge-point/id #uuid "c16a30bc-0c1a-54f2-95d6-47edb0c85736" :knowledge-point/title "Determining the Product of the Roots of a Quadratic Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a1d95b8-6f28-5ebe-ae92-d043359fa511" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,395" :db/id #edb/ref 17592186390574} {:answer/id #uuid "eed1e1d6-f081-50ba-9a0f-960b330272be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2)\\cdot 8\\,395" :db/id #edb/ref 17592186390575} {:answer/id #uuid "28190f64-9c46-5f7f-af80-807614a00568" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{146}{2}" :db/id #edb/ref 17592186390576} {:answer/id #uuid "6125f799-589f-5f34-b51a-3dae9be8eba0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\,395" :db/id #edb/ref 17592186390577} {:answer/id #uuid "9b4ae3e2-672a-57a7-8dcb-1c4b9825daed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-8\\,395}{146}" :db/id #edb/ref 17592186390578}] :answer-field/correct {:answer/id #uuid "6125f799-589f-5f34-b51a-3dae9be8eba0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\,395" :db/id #edb/ref 17592186390577} :answer-field/id #uuid "e368a500-4f4d-5598-bf19-014504f88343" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390573}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a60a042a-0631-504b-9c2c-28fdb04eadac" :question/math-academy-id "q-288819" :question/problem "Consider the quadratic equation\n\n$$\n{x}^{2}+146x-8\\,395=0.\n$$\n\n**Without** solving the equation, determine the product of its solutions." :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na=1,\\,b=146,\\,c=-8\\,395.\n$$\n\nTherefore, the product of the solutions is\n\n$$\n\\begin{aligned}\\frac{c}{a} & =\\frac{(-8\\,395)}{1}=-8\\,395.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297216 :knowledge-point/_questions [{:db/id #edb/ref 17592186083388 :knowledge-point/id #uuid "c16a30bc-0c1a-54f2-95d6-47edb0c85736" :knowledge-point/title "Determining the Product of the Roots of a Quadratic Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2567084b-b026-5eb4-b95e-0227a0635f61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "391" :db/id #edb/ref 17592186295471} {:answer/id #uuid "32c4576b-1351-5ac7-8694-de0426c7c366" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-391" :db/id #edb/ref 17592186295554} {:answer/id #uuid "71a3851f-e88d-5f38-b01f-fcaaad95d68b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-391}{41}" :db/id #edb/ref 17592186295893} {:answer/id #uuid "922397a2-e0b6-58f1-bde5-54e22966b2c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2)\\cdot 391" :db/id #edb/ref 17592186296054} {:answer/id #uuid "abf37a1f-02b7-5b10-aaaf-f70acb95ee5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{41}{2}" :db/id #edb/ref 17592186296172}] :answer-field/correct {:answer/id #uuid "32c4576b-1351-5ac7-8694-de0426c7c366" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-391" :db/id #edb/ref 17592186295554} :answer-field/id #uuid "29b0ff42-3a4a-57e5-b225-3f319bf73f19" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296715}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "edeac1f1-6a23-50a2-b07f-f8b62b91f0ee" :question/math-academy-id "q-288825" :question/problem "Consider the quadratic equation\n\n$$\n{x}^{2}+41x-391=0.\n$$\n\n**Without** solving the equation, determine the product of its solutions." :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na=1,\\,b=41,\\,c=-391.\n$$\n\nTherefore, the product of the solutions is\n\n$$\n\\begin{aligned}\\frac{c}{a} & =\\frac{(-391)}{1}=-391.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297221 :knowledge-point/_questions [{:db/id #edb/ref 17592186115179 :knowledge-point/id #uuid "ec3e2ddd-4937-5837-a03a-b7568bff9b87" :knowledge-point/title "Solving a Trigonometric Equation Involving Secant with Special Angles"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b7eb7a0-9e0b-5f24-9b6e-32d423c91838" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{4}" :db/id #edb/ref 17592186295328} {:answer/id #uuid "23b932bc-94d0-5090-8141-409a5663c61e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{4}" :db/id #edb/ref 17592186295461} {:answer/id #uuid "4b71a211-d079-5dee-8bfc-012004c98779" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{9}" :db/id #edb/ref 17592186295696} {:answer/id #uuid "a88803b8-c592-548a-a2d0-3411a63af750" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{3}" :db/id #edb/ref 17592186296152} {:answer/id #uuid "fb317109-fe2c-5752-aced-8c8fe96089ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{9}" :db/id #edb/ref 17592186296603}] :answer-field/correct {:answer/id #uuid "4b71a211-d079-5dee-8bfc-012004c98779" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{9}" :db/id #edb/ref 17592186295696} :answer-field/id #uuid "36407ae9-d72f-5658-821c-790738a7cf02" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296733}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b48b10b3-0d9d-5485-bda2-3198c7563d19" :question/math-academy-id "q-28902" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $2\\operatorname{sec}⁡x-1=3$ for $0\\le x<2\\pi ,$ what is ${x}_{1}\\cdot {x}_{2}?$" :question/worked-solution "First, we rearrange the equation, isolating $\\operatorname{sec}⁡x:$\n\n$$\n\\begin{aligned}2\\operatorname{sec}⁡x-1 & =3 \\\\ 2\\operatorname{sec}⁡x & =4 \\\\ \\operatorname{sec}⁡x & =2\\end{aligned}\n$$\n\nRecall that $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{cos}⁡x=\\frac{1}{2}.\n$$\n\nFirst, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arccos}⁡(\\frac{1}{2})=\\frac{\\pi }{3}\\end{aligned}\n$$\n\nSince $\\frac{\\pi }{3}$ lies inside the required domain, our first solution is ${x}_{1}=\\frac{\\pi }{3}.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}=\\frac{\\pi }{3}.$ Since $\\operatorname{cos}⁡x>0,$ the second solution must lie in the fourth quadrant, and it also has a reference angle ${\\theta }_{R}=\\frac{\\pi }{3}.$\n\n![](images/31/318eba038feb091d6e3adb80ddf325de6039bb331a7713cf1e2c02171a6388d4.png)\n\nSince the second solution ${x}_{2}$ lies in the $4$th quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =2\\pi -{\\theta }_{R} \\\\  & =2\\pi -\\frac{\\pi }{3} \\\\  & =\\frac{5\\pi }{3}\\end{aligned}\n$$\n\nSo, the solutions are $x=\\frac{\\pi }{3},\\frac{5\\pi }{3}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{\\pi }{3}\\cdot \\frac{5\\pi }{3}=\\frac{5{\\pi }^{2}}{9}.\n$$"}] [{:db/id #edb/ref 17592186111141 :knowledge-point/_questions [{:db/id #edb/ref 17592186110667 :knowledge-point/id #uuid "ce7ef1dd-58cc-57f5-9ff9-fc997f4280ee" :knowledge-point/title "Identifying True Statements Regarding an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14d716c0-c74a-57f6-833b-a5816bf99cd8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186295386} {:answer/id #uuid "67139bf8-96d1-5cee-b658-3ffcabbeb7f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186295848} {:answer/id #uuid "68c9ab76-11b5-597a-b277-a022ff7d7ce0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186295856} {:answer/id #uuid "8406301a-c3a9-5c90-b099-4f4b2c78ba3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186295973} {:answer/id #uuid "c5a38ae3-a755-5134-b132-4a013f680737" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186296308}] :answer-field/correct {:answer/id #uuid "14d716c0-c74a-57f6-833b-a5816bf99cd8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186295386} :answer-field/id #uuid "3cc8c0d6-c061-513b-98bf-4315a1ac025c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296752}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c4102b2c-f2ad-56ac-9dd6-7dd59719b972" :question/math-academy-id "q-28973" :question/problem "Which of the following statements are true in relation to the function $f(x)={(\\frac{2}{7})}^{x}?$\n\n- Its domain is $x\\in (-\\infty ,\\infty )$\n- Its range is $y\\in (0,\\infty )$\n- It is a decreasing function" :question/worked-solution "Let's start by recalling the graph of ${(\\frac{2}{7})}^{x}.$\n\n![](images/c1/c1bbffed32708d30355ed3592deae845d1a84cd1f1772ef1d0fae7ac39518295.png)\n\nLet's go through the statements one by one.\n\n- Statement I is true. The function $f(x)={(\\frac{2}{7})}^{x}$ is defined for all input values $x.$\n\n- Statement II is true. The set of possible outputs of $f(x)={(\\frac{2}{7})}^{x}$ consists of all the positive numbers.\n\n- Statement III is true. For $x\\in (-\\infty ,\\infty ),$ the graph of $y=f(x)$ falls. Therefore, $y=f(x)$ is a decreasing function.\n\nIn conclusion, statements I, II, and III are true."}] [{:db/id #edb/ref 17592186297222 :knowledge-point/_questions [{:db/id #edb/ref 17592186110667 :knowledge-point/id #uuid "ce7ef1dd-58cc-57f5-9ff9-fc997f4280ee" :knowledge-point/title "Identifying True Statements Regarding an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d7bb9f1-b157-599d-93ed-6607f6670caf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186295620} {:answer/id #uuid "57f33323-a574-5d3a-9709-4eb09849a56b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186295774} {:answer/id #uuid "a8d54f7c-6d02-5810-afd3-16ba3cfaf37c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186296154} {:answer/id #uuid "bba10e7d-2cc2-5341-a2f3-b9fb123d6f6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186296250} {:answer/id #uuid "e870b774-8e7e-5746-ab82-10ba9e3d3195" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186296503}] :answer-field/correct {:answer/id #uuid "3d7bb9f1-b157-599d-93ed-6607f6670caf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186295620} :answer-field/id #uuid "543e005e-a445-5e44-847a-061f1c3bcb23" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296804}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7c7808ae-1f8f-5217-b026-8ee08973156b" :question/math-academy-id "q-28981" :question/problem "Which of the following statements are true in relation to the function $f(x)=(0.08)^{x}?$\n\n- Its range is $y>0$\n- It is an increasing function\n- $f(x)\\to 0$ as $x\\to \\infty $" :question/worked-solution "Let's start by recalling the graph of ${(0.08)}^{x}.$\n\n![](images/b4/b4e3b5119c92d02bbceb786fefd238182c7c84ca0f4abc85a19f2df86a6ba267.png)\n\nLet's go through the statements one by one.\n\n- Statement I is true. The set of possible outputs of $f(x)={(0.08)}^{x}$ consists of all the positive numbers.\n\n- Statement II is false. For $x\\in (-\\infty ,\\infty ),$ the graph of $y=f(x)$ falls. Therefore, $y=f(x)$ is a decreasing function.\n\n- Statement III is true. As $x$ increases, the function value gets smaller and smaller, approaching zero. Therefore $f(x)\\to 0$ as $x\\to \\infty .$\n\nIn conclusion, only statements I and III are true."}] [{:db/id #edb/ref 17592186115701 :knowledge-point/_questions [{:db/id #edb/ref 17592186115182 :knowledge-point/id #uuid "145bdcf2-b1d5-54a8-bd95-4b054d7a33f0" :knowledge-point/title "Solving Trigonometric Equations Involving Cosecant with Special Angles"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1368cfff-7db3-5254-96f3-07c2d868775c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{9}" :db/id #edb/ref 17592186295373} {:answer/id #uuid "5d31a2e7-f845-5d6f-84d8-734c7f9fdf5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{\\pi }^{2}}{9}" :db/id #edb/ref 17592186295805} {:answer/id #uuid "6430dd94-cdd6-5b7c-a6ed-698e9ed44979" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{\\pi }^{2}}{3}" :db/id #edb/ref 17592186295838} {:answer/id #uuid "b6bfc3d8-2c65-5bf3-b9cc-a536405604d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{\\pi }^{2}}{9}" :db/id #edb/ref 17592186296226} {:answer/id #uuid "dc4268bd-fe81-503e-a2c7-155bbc6c537d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{3}" :db/id #edb/ref 17592186296436}] :answer-field/correct {:answer/id #uuid "5d31a2e7-f845-5d6f-84d8-734c7f9fdf5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{\\pi }^{2}}{9}" :db/id #edb/ref 17592186295805} :answer-field/id #uuid "52eff59e-5bce-5d06-bed1-69123a95aebf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296802}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "710ba61e-2523-50bc-83d0-e27883d20d99" :question/math-academy-id "q-29004" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{csc}⁡x=\\frac{2\\sqrt{3}}{3}$ for $0\\le x<2\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2}?$" :question/requires-calculator true :question/worked-solution "Recall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x},$ therefore the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=\\frac{3}{2\\sqrt{3}}=\\frac{\\sqrt{3}}{2}.\n$$\n\nFirst, we find the principal value:\n\n$$\nx=\\text{arcsin}(\\frac{\\sqrt{3}}{2})=\\frac{\\pi }{3}.\n$$\n\nSince $\\frac{\\pi }{3}$ lies inside the required domain, our first solution is ${x}_{1}=\\frac{\\pi }{3}.$\n\nOur first solution lies in the  first quadrant and has a reference angle of ${\\theta }_{R}=\\frac{\\pi }{3}.$ Since $\\operatorname{sin}⁡x>0,$ the second solution must lie in the second quadrant, and it also has a reference angle ${\\theta }_{R}=\\frac{\\pi }{3}.$\n\n![](images/4c/4cbf970747a9eddbcffe6fd3ba46d13c43e5f17ca56e52747c797229dbc74d48.png)\n\nSince the second solution ${x}_{2}$ lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =\\pi -{\\theta }_{R} \\\\  & =\\pi -\\frac{\\pi }{3} \\\\  & =\\frac{2\\pi }{3}\\end{aligned}\n$$\n\nSo, the solutions are $x=\\frac{\\pi }{3},\\frac{2\\pi }{3}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{\\pi }{3}\\cdot \\frac{2\\pi }{3}=\\frac{2{\\pi }^{2}}{9}.\n$$"}] [{:db/id #edb/ref 17592186204605 :knowledge-point/_questions [{:db/id #edb/ref 17592186203961 :knowledge-point/id #uuid "58c7cd44-30a9-5f61-822c-13640ad41c93" :knowledge-point/title "Finding the Zeros of a Transformed Sine or Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b1117d8-3922-58c9-9530-2863e9f66fdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-{45}^{∘}+n\\cdot {180}^{∘}" :db/id #edb/ref 17592186295326} {:answer/id #uuid "1bf04524-d8f1-5e7a-91a7-879af77ff5ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={45}^{∘}" :db/id #edb/ref 17592186295431} {:answer/id #uuid "3c4a9f04-2536-5359-9635-1fd6075b188e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=n\\cdot {180}^{∘}" :db/id #edb/ref 17592186295612} {:answer/id #uuid "94fd6bb9-96bf-57e3-9aa7-5130e61029b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={90}^{∘}+n\\cdot {360}^{∘}" :db/id #edb/ref 17592186296062} {:answer/id #uuid "d478ba2a-8dd5-55b8-a559-1c7c60934547" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={45}^{∘}+n\\cdot {180}^{∘}" :db/id #edb/ref 17592186296386}] :answer-field/correct {:answer/id #uuid "d478ba2a-8dd5-55b8-a559-1c7c60934547" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={45}^{∘}+n\\cdot {180}^{∘}" :db/id #edb/ref 17592186296386} :answer-field/id #uuid "a9270dcb-2a83-5da1-b03e-a2f7992cae9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296992}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6cc77154-ecae-5ece-8bcc-9eb3f418b440" :question/math-academy-id "q-29132" :question/problem "Which expression gives all of the zeros of $y=3\\operatorname{cos}⁡(x+{45}^{∘})?$ Assume that $n$ is an integer." :question/worked-solution "First, let's start by defining a new variable $X$ as\n\n$$\nX=x+{45}^{∘}.\n$$\n\nSo, we need to calculate the zeros of \n\n$$\ny=3\\operatorname{cos}⁡X.\n$$\n\nThe zeros of this function are given by the following expression:\n\n$$\nX={90}^{∘}+n\\cdot {180}^{∘}\n$$\n\nwhere $n$ is an integer.\n\nTo find the zeros of our original function, we rewrite $X$ in terms of the original variable $x$ and solve the resulting equation for $x:$\n\n$$\n\\begin{aligned}X & ={90}^{∘}+n\\cdot {180}^{∘} \\\\ x+{45}^{∘} & ={90}^{∘}+n\\cdot {180}^{∘} \\\\ x+{45}^{∘}-{45}^{∘} & ={90}^{∘}+n\\cdot {180}^{∘}-{45}^{∘} \\\\ x & ={45}^{∘}+n\\cdot {180}^{∘}\\end{aligned}\n$$\n\nTherefore, we conclude that the zeros are $x={45}^{∘}+n\\cdot {180}^{∘},$ where $n$ is any integer."}] [{:db/id #edb/ref 17592186115705 :knowledge-point/_questions [{:db/id #edb/ref 17592186115181 :knowledge-point/id #uuid "a9a3d8db-a6e0-5c96-9c75-415d4a75cf4d" :knowledge-point/title "Identifying Equations With No Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f6d89388-dd26-59c2-b62c-aef3350e1be1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186113197} {:answer/id #uuid "11d216c9-6d94-57de-b115-a304334c27d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186113198} {:answer/id #uuid "2dfd62a7-b472-54ac-a2ee-4b72cf5d625f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186113199} {:answer/id #uuid "3d0a8a4e-9945-5e0d-aa15-36e66b5ab94e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186113200} {:answer/id #uuid "5bf0683d-0d8a-5267-b81d-502d2a83be7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186113201}] :answer-field/id #uuid "4977aa86-5719-5551-a348-c70c6f677e2a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113196} {:answer-field/choices [{:answer/id #uuid "6e366677-1acc-548b-9d8a-043caa67d076" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186401923} {:answer/id #uuid "34c4cf88-6a77-5dc4-9298-de12464e93a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186401924} {:answer/id #uuid "fc388d3c-f7de-526c-bae0-44297aa5c1a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186401925} {:answer/id #uuid "8e52e4ac-f6da-59c1-9b6c-569b5c0f46d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186401926} {:answer/id #uuid "87f49733-d7a3-52db-ba58-c47681214494" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186401927}] :answer-field/correct {:answer/id #uuid "fc388d3c-f7de-526c-bae0-44297aa5c1a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186401925} :answer-field/id #uuid "ae9fdfce-f210-5819-a39f-6d6ef14bee25" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401922}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fcb31a9b-9679-5d24-8bf7-7929bd2e8a6c" :question/math-academy-id "q-29163" :question/problem "Which of the following equations has no solutions for $0\\le x<2\\pi ?$\n\nI. $\\operatorname{sec}⁡x=1$\nII. $\\operatorname{sec}⁡x=2$\nIII. $\\operatorname{sec}⁡x=\\frac{1}{2}$" :question/worked-solution "Recall that the range of $\\operatorname{sec}⁡x$ for $0\\le x<2\\pi $ is given by\n\n$$\n\\operatorname{sec}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{sec}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equation III has no solutions."}] [{:db/id #edb/ref 17592186115707 :knowledge-point/_questions [{:db/id #edb/ref 17592186115180 :knowledge-point/id #uuid "28062dbf-815b-5221-ae86-1050e106c5ea" :knowledge-point/title "Solving a Trigonometric Equation Involving Secant Under a Modified Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88a2376c-dc19-5dd0-a77a-56366a05b81d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12000" :db/id #edb/ref 17592186113209} {:answer/id #uuid "c5a28036-b367-589e-9512-aab611b56f04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36000" :db/id #edb/ref 17592186113210} {:answer/id #uuid "d3998ecb-9d96-51bb-a80c-b98dba07a111" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18000" :db/id #edb/ref 17592186113211} {:answer/id #uuid "1afc57e2-95e9-5005-8244-a42d7d643df9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18000" :db/id #edb/ref 17592186113212} {:answer/id #uuid "64c56874-5776-54fe-a57b-179c6f752f5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12000" :db/id #edb/ref 17592186113213}] :answer-field/id #uuid "4e1aae67-1413-5c52-92c2-e130fc7ee0d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113208} {:answer-field/choices [{:answer/id #uuid "b0c131ae-15e2-51d9-b981-699dd3822a8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36\\,000" :db/id #edb/ref 17592186390580} {:answer/id #uuid "4abb149a-acd5-5b9b-b236-51b85d318980" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18\\,000" :db/id #edb/ref 17592186390581} {:answer/id #uuid "ea956b89-f42b-52b5-a970-4a7cbdfbbbcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12\\,000" :db/id #edb/ref 17592186390582} {:answer/id #uuid "b1c1bdc4-e73b-5851-82fe-a8e4df60d98d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18\\,000" :db/id #edb/ref 17592186390583} {:answer/id #uuid "ea082471-0a98-54a0-9c3f-4a9fcbd75fcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,000" :db/id #edb/ref 17592186390584}] :answer-field/correct {:answer/id #uuid "b1c1bdc4-e73b-5851-82fe-a8e4df60d98d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18\\,000" :db/id #edb/ref 17592186390583} :answer-field/id #uuid "974b5aa7-9854-5922-a33e-647715b7b09b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390579}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "20eb540b-84ee-5a09-81e9-e0f110dad1d7" :question/math-academy-id "q-29179" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{sec}⁡x=2$ for $-{360}^{∘}\\le x<{0}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2}?$" :question/requires-calculator true :question/worked-solution "Recall that $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{cos}⁡x=\\frac{1}{2}.\n$$\n\nFirst, we find the principal value:\n\n$$\nx=\\operatorname{arccos}⁡(\\frac{1}{2})={60}^{∘}\n$$\n\nNote that $x={60}^{∘}$ is not in the domain $-{360}^{∘}\\le x<{0}^{∘}.$ To get a solution within the required domain, we subtract ${360}^{∘}:$\n\n$$\n\\begin{aligned}{x}_{1} & ={60}^{∘}-{360}^{∘}=-{300}^{∘}\\end{aligned}\n$$\n\n \n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}={60}^{∘}.$ Since $\\operatorname{cos}⁡x>0,$ the second solution must lie in the fouth quadrant, and it also has a reference angle ${\\theta }_{R}={60}^{∘}.$\n\n![](images/9c/9c8adbb0a1594ae5bacfab7f1f92993c67659839599e10ab46d5cf98896e3ec7.png)\n\nA second solution $X$ lies in the $4$th quadrant, and we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}X & ={360}^{∘}-{\\theta }_{R} \\\\  & ={360}^{∘}-{60}^{∘} \\\\  & ={300}^{∘}\\end{aligned}\n$$\n\nNote that $X={300}^{∘}$ is not in the domain $-{360}^{∘}\\le x<{0}^{∘}.$ To get a solution within the required domain, we subtract ${360}^{∘}:$\n\n$$\n\\begin{aligned}{x}_{3} & ={300}^{∘}-{360}^{∘}=-{60}^{∘}\\end{aligned}\n$$\n\n \n\nTherefore, the solutions are $x=-{60}^{∘},-{300}^{∘}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=-60\\cdot (-300)=18\\,000\n$$"}] [{:db/id #edb/ref 17592186390585 :knowledge-point/_questions [{:db/id #edb/ref 17592186115180 :knowledge-point/id #uuid "28062dbf-815b-5221-ae86-1050e106c5ea" :knowledge-point/title "Solving a Trigonometric Equation Involving Secant Under a Modified Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b21c9bca-5889-5378-95f5-dc19174253a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,600" :db/id #edb/ref 17592186390587} {:answer/id #uuid "5637088d-2110-5861-a9e4-5418d97814d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\,175" :db/id #edb/ref 17592186390588} {:answer/id #uuid "98625043-9024-52ca-9b27-4d102460e169" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\,900" :db/id #edb/ref 17592186390589} {:answer/id #uuid "a3127733-14dd-544e-9920-fd0e17095202" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15\\,150" :db/id #edb/ref 17592186390590} {:answer/id #uuid "510c63c8-8440-585e-ac63-db0b2b6359b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18\\,000" :db/id #edb/ref 17592186390591}] :answer-field/correct {:answer/id #uuid "98625043-9024-52ca-9b27-4d102460e169" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\,900" :db/id #edb/ref 17592186390589} :answer-field/id #uuid "c557a89c-b4c6-5e67-988d-6c588aefa937" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390586}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "23dbd8da-da31-5df7-bb91-fad8d1a7bceb" :question/math-academy-id "q-29182" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{sec}⁡x=\\frac{2}{\\sqrt{3}}$ for $-{360}^{∘}\\le x<{0}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2}?$" :question/worked-solution "Recall that $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{cos}⁡x=\\frac{\\sqrt{3}}{2}.\n$$\n\nFirst, we find the principal value:\n\n$$\nx=\\operatorname{arccos}⁡(\\frac{\\sqrt{3}}{2})={30}^{∘}\n$$\n\nNote that $x={30}^{∘}$ is not in the domain $-{360}^{∘}\\le x<{0}^{∘}.$ To get a solution within the required domain, we subtract ${360}^{∘}:$\n\n$$\n\\begin{aligned}{x}_{1} & ={30}^{∘}-{360}^{∘}=-{330}^{∘}\\end{aligned}\n$$\n\n \n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}={30}^{∘}.$ Since $\\operatorname{cos}⁡x>0,$ the second solution must lie in the fouth quadrant, and it also has a reference angle ${\\theta }_{R}={30}^{∘}.$\n\n![](images/8c/8c6e3ae6bdbfb1c66aee719f77225453992fffe6f3c6e3dfdc3f1ff92c59863a.png)\n\nA second solution $X$ lies in the $4$th quadrant, and we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}X & ={360}^{∘}-{\\theta }_{R} \\\\  & ={360}^{∘}-{30}^{∘} \\\\  & ={330}^{∘}\\end{aligned}\n$$\n\nNote that $X={330}^{∘}$ is not in the domain $-{360}^{∘}\\le x<{0}^{∘}.$ To get a solution within the required dommain, we subtract ${360}^{∘}:$\n\n$$\n\\begin{aligned}{x}_{2} & ={330}^{∘}-{360}^{∘}=-{30}^{∘}\\end{aligned}\n$$\n\n \n\nTherefore, the solutions are $x=-{30}^{∘},-{330}^{∘}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=-30\\cdot (-330)=9\\,900\n$$"}] [{:db/id #edb/ref 17592186297228 :knowledge-point/_questions [{:db/id #edb/ref 17592186115184 :knowledge-point/id #uuid "ba963ded-e9ff-5324-9d22-acb6b7a85e10" :knowledge-point/title "Solving a Trigonometric Equation Involving Cotangent with Special Angles"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "285b16e3-c1a0-528c-aa3c-6503ddc7d9c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{4}" :db/id #edb/ref 17592186295491} {:answer/id #uuid "87b96519-0b71-53f7-a2a8-38e23e3ed540" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7{\\pi }^{2}}{4}" :db/id #edb/ref 17592186295998} {:answer/id #uuid "8dc605ec-311a-5e45-aa11-fa47080ee6c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{16}" :db/id #edb/ref 17592186296021} {:answer/id #uuid "a73b3e93-a76c-5d8c-952d-0ca55c712a69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{\\pi }^{2}}{16}" :db/id #edb/ref 17592186296147} {:answer/id #uuid "dbc07055-c07b-591e-bb1f-6c27db9c5cff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{16}" :db/id #edb/ref 17592186296429}] :answer-field/correct {:answer/id #uuid "8dc605ec-311a-5e45-aa11-fa47080ee6c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{16}" :db/id #edb/ref 17592186296021} :answer-field/id #uuid "38ba5974-6a88-54e6-877e-8ae9daa987cd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296741}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2e82d568-df50-578f-b07c-119397489f57" :question/math-academy-id "q-29207" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{cot}⁡x=1$ for $0\\le x<2\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2}?$" :question/worked-solution "Recall that $\\operatorname{cot}⁡x=\\frac{1}{\\operatorname{tan}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{tan}⁡x=1\n$$\n\nFirst, we find the principal value:\n\n$$\n\\begin{aligned}x=\\text{arctan}(1)=\\frac{\\pi }{4}\\end{aligned}\n$$\n\nSince $\\frac{\\pi }{4}$ lies inside the given domain, our first solution is ${x}_{1}=\\frac{\\pi }{4}.$\n\nTo generate more solutions, we add integer multiples of $\\pi .$ Hence,\n\n$$\n\\begin{aligned}{x}_{2}=\\pi +\\frac{\\pi }{4}=\\frac{5\\pi }{4}.\\end{aligned}\n$$\n\nSo, the solutions are $x=\\frac{\\pi }{4},\\frac{5\\pi }{4}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{\\pi }{4}\\cdot \\frac{5\\pi }{4}=\\frac{5{\\pi }^{2}}{16}.\n$$"}] [{:db/id #edb/ref 17592186297232 :knowledge-point/_questions [{:db/id #edb/ref 17592186129101 :knowledge-point/id #uuid "8854eaba-96c7-5ea8-a071-7ff7c954f943" :knowledge-point/title "Finding a General Expression for the Asymptotes of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8266d9da-29ef-5142-889c-67032e696941" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={30}^{∘}+n\\cdot {180}^{∘}" :db/id #edb/ref 17592186295969} {:answer/id #uuid "8f36dd3b-18aa-5423-9a63-6be24cb45a5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={60}^{∘}+n\\cdot {45}^{∘}" :db/id #edb/ref 17592186296030} {:answer/id #uuid "b9a3b5aa-10fe-59e1-8b60-91383fc7c7a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={45}^{∘}+n\\cdot {90}^{∘}" :db/id #edb/ref 17592186296242} {:answer/id #uuid "ce3fe793-587a-5cb1-82ef-b60494e08387" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={90}^{∘}+n\\cdot {180}^{∘}" :db/id #edb/ref 17592186296347} {:answer/id #uuid "f5728d81-5718-5a99-b836-93226b4b6cc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=n\\cdot {180}^{∘}" :db/id #edb/ref 17592186296569}] :answer-field/correct {:answer/id #uuid "b9a3b5aa-10fe-59e1-8b60-91383fc7c7a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={45}^{∘}+n\\cdot {90}^{∘}" :db/id #edb/ref 17592186296242} :answer-field/id #uuid "3d308903-8122-5b47-a276-3957b8fde22e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296754}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "493ac61e-d5aa-548d-a691-2dfa99e52431" :question/math-academy-id "q-29349" :question/problem "Which of the following expressions gives all of the vertical asymptotes of the function $y=\\operatorname{tan}⁡(2x)-2,$ where $x$ is measured in degrees? Assume that $n$ is an integer." :question/worked-solution "The asymptotes of $y=\\operatorname{tan}⁡x$ are given by the following expression:\n\n$$\nx={90}^{∘}+n\\cdot {180}^{∘}\n$$\n\nTo find the asymptotes of $\\operatorname{tan}⁡(2x)-2,$ we replace the $x$ on the left-hand side of the above with $(2x).$ This gives:\n\n$$\n2x={90}^{∘}+n\\cdot {180}^{∘}\n$$\n\nSolving this for $x$ gives:\n\n$$\n\\begin{aligned}x & ={45}^{∘}+n\\cdot {90}^{∘}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401928 :knowledge-point/_questions [{:db/id #edb/ref 17592186110652 :knowledge-point/id #uuid "a258070e-5c3c-595e-81d6-3e0f9b9a5daf" :knowledge-point/title "Working With Systems Containing Mixed Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c28cb971-d849-577e-9682-a8890d4ae773" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\le x+2 \\\\ y>-x+1\\end{aligned}" :db/id #edb/ref 17592186401930} {:answer/id #uuid "d4c91422-9ef9-5a21-a3cd-6168971db223" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\ge x+2 \\\\ y\\ge -x+1\\end{aligned}" :db/id #edb/ref 17592186401931} {:answer/id #uuid "928ea34b-f94c-5914-8894-15d7edbe4d92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y>x+2 \\\\ y\\ge -x+1\\end{aligned}" :db/id #edb/ref 17592186401932} {:answer/id #uuid "129beb51-d7c5-5a45-86b1-53f54c6e7926" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\ge x+2 \\\\ y<-x+1\\end{aligned}" :db/id #edb/ref 17592186401933} {:answer/id #uuid "1f5ea53c-6d9f-56de-99b0-c8f54f45ac23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\le x+2 \\\\ y<-x+1\\end{aligned}" :db/id #edb/ref 17592186401934}] :answer-field/correct {:answer/id #uuid "928ea34b-f94c-5914-8894-15d7edbe4d92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y>x+2 \\\\ y\\ge -x+1\\end{aligned}" :db/id #edb/ref 17592186401932} :answer-field/id #uuid "210acf01-110f-53da-bf3c-8725abe1a7d8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401929}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5cb8229e-2a6a-582b-a6c3-627b88cf6816" :question/math-academy-id "q-29384" :question/problem "![](images/a7/a740aafbb9f74e2681506d3027f848fa92e7eea2bac3e08ccaf3fc7e0acf8fa1.png)\n\nWhich of the following systems of inequalities defines the shaded region shown in the graph above?" :question/worked-solution "Consider the line $y=x+2.$ Since the line is dashed, the inequality is strict. Also, since the shaded region lies *above* the line, the inequality is a \"greater than\" inequality. So the corresponding inequality is\n\n$$\ny>x+2.\n$$\n\n    \n\nNow consider the line $y=-x+1.$ Since the line is solid, the inequality is an \"or equal to\" inequality. Also, since the shaded region lies *above* the line, the inequality is a \"greater than\" inequality. So the corresponding inequality is\n\n$$\ny\\ge -x+1.\n$$\n\nTherefore, the system of inequalities that defines the shaded region is\n\n$$\n{\\begin{aligned}y>x+2 \\\\ y\\ge -x+1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297236 :knowledge-point/_questions [{:db/id #edb/ref 17592186129100 :knowledge-point/id #uuid "fabd8865-cc14-508a-aa81-4ba147f7f8d4" :knowledge-point/title "Finding a General Expression for the Zeros of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64fab536-011b-5495-af75-b22e97ee61ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{5\\pi }{6}+n\\pi " :db/id #edb/ref 17592186295842} {:answer/id #uuid "87e9cce5-fd91-5d27-9de1-74ed14eca40d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{5\\pi }{3}+n\\pi " :db/id #edb/ref 17592186296000} {:answer/id #uuid "a1e90731-2073-5376-a7f3-d74585469490" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{5\\pi }{6}+2n\\pi " :db/id #edb/ref 17592186296130} {:answer/id #uuid "d917947c-0694-5b63-b083-5660cef98161" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{6}+n\\pi " :db/id #edb/ref 17592186296412} {:answer/id #uuid "fe2df703-693b-5e97-a3f0-fa4ca9c37fb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{3}+n\\pi " :db/id #edb/ref 17592186296620}] :answer-field/correct {:answer/id #uuid "64fab536-011b-5495-af75-b22e97ee61ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{5\\pi }{6}+n\\pi " :db/id #edb/ref 17592186295842} :answer-field/id #uuid "ae41aa8c-95fb-5956-b88c-4aa3ce7bb65c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297000}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "97f191d4-6a4f-5a4f-8505-bbd4c324e609" :question/math-academy-id "q-29438" :question/problem "Which of the following expressions gives all of the zeros of the function $f(x)=2\\operatorname{cot}⁡(x-\\frac{\\pi }{3})?$ Assume that $n$ is an integer." :question/worked-solution "The zeros of $y=\\operatorname{cot}⁡x$ are given by\n\n$$\nx=\\frac{\\pi }{2}+n\\pi ,\n$$\n\nwhere $n$ is an integer.\n\nTo find the zeros of $f(x)=2\\operatorname{cot}⁡(x-\\frac{\\pi }{3}),$ we replace the $x$ on the left-hand side of the above with $(x-\\frac{\\pi }{3}).$ This gives\n\n$$\nx-\\frac{\\pi }{3}=\\frac{\\pi }{2}+n\\pi .\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}x-\\frac{\\pi }{3} & =\\frac{\\pi }{2}+n\\pi  \\\\ x & =\\frac{\\pi }{2}+n\\pi +\\frac{\\pi }{3} \\\\ x & =\\frac{5\\pi }{6}+n\\pi .\\end{aligned}\n$$\n\nTherefore, we conclude that the zeros are $x=\\frac{5\\pi }{6}+n\\pi ,$ where $n$ is an integer."}] [{:db/id #edb/ref 17592186401948 :knowledge-point/_questions [{:db/id #edb/ref 17592186115222 :knowledge-point/id #uuid "80449399-3ae4-593f-8c3b-00bcdcc99727" :knowledge-point/title "Solving Trigonometric Equations Outside of the Range of Cosecant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b53db17c-c360-5669-8f88-e93f4bdbd8fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186401950} {:answer/id #uuid "25dcd0ff-82e2-5596-97c0-808147eeda5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186401951} {:answer/id #uuid "c06a013e-9247-5fe8-9462-4797376bce04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186401952} {:answer/id #uuid "5d5c203d-08c8-5beb-ba1e-76f154f20aea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186401953} {:answer/id #uuid "12121f61-eccf-5393-b245-c6404140579b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186401954}] :answer-field/correct {:answer/id #uuid "25dcd0ff-82e2-5596-97c0-808147eeda5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186401951} :answer-field/id #uuid "8895f00a-eea4-5d81-b69d-a26ada8cb409" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401949}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2c11092b-9e53-51e1-b299-c5287bf677e1" :question/math-academy-id "q-29477" :question/problem "Which of the following equations has no solutions for $0\\le x<2\\pi ?$\n\nI. $\\operatorname{csc}⁡x=\\frac{1}{3}$\nII. $\\operatorname{csc}⁡x=3$\nIII. $\\operatorname{csc}⁡x=1$" :question/worked-solution "Recall that the range of $\\operatorname{csc}⁡x$ for $0\\le x<2\\pi $ is given by\n\n$$\n\\operatorname{csc}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{csc}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equation I has no solutions."}] [{:db/id #edb/ref 17592186297237 :knowledge-point/_questions [{:db/id #edb/ref 17592186129100 :knowledge-point/id #uuid "fabd8865-cc14-508a-aa81-4ba147f7f8d4" :knowledge-point/title "Finding a General Expression for the Zeros of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53c921c9-46e0-5bef-95de-0f5b588ebca5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{6}+\\frac{n\\pi }{2}" :db/id #edb/ref 17592186295749} {:answer/id #uuid "85d07a4f-56af-578a-a679-6e632e293884" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{12}+n\\pi " :db/id #edb/ref 17592186295983} {:answer/id #uuid "8c7e58fb-f78c-5c59-97d6-77d4f59a186a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{4}+\\frac{n\\pi }{2}" :db/id #edb/ref 17592186296016} {:answer/id #uuid "ab14ced1-375e-5455-909c-7a3ced2bd998" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{12}+\\frac{n\\pi }{2}" :db/id #edb/ref 17592186296164} {:answer/id #uuid "ee73340c-4d12-5b82-9ec4-7452a202940f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{6}+n\\pi " :db/id #edb/ref 17592186296533}] :answer-field/correct {:answer/id #uuid "ab14ced1-375e-5455-909c-7a3ced2bd998" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{12}+\\frac{n\\pi }{2}" :db/id #edb/ref 17592186296164} :answer-field/id #uuid "79362fdd-d341-5e89-bee7-6cb695806517" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296881}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "670b4725-4f5f-5e5b-81ee-7bebf6dbdf85" :question/math-academy-id "q-29556" :question/problem "Which of the following expressions gives all of the zeros of the function $f(x)=2\\operatorname{tan}⁡(2x-\\frac{\\pi }{6})?$ Assume that $n$ is an integer." :question/worked-solution "The zeros of $y=\\operatorname{tan}⁡x$ are given by\n\n$$\nx=n\\pi ,\n$$\n\nwhere $n$ is an integer.\n\nTo find the zeros of $f(x)=2\\operatorname{tan}⁡(2x-\\frac{\\pi }{6}),$ we replace the $x$ on the left-hand side of the above with $(2x-\\frac{\\pi }{6}).$ This gives\n\n$$\n2x-\\frac{\\pi }{6}=n\\pi .\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}2x-\\frac{\\pi }{6} & =n\\pi  \\\\ 2x & =n\\pi +\\frac{\\pi }{6} \\\\ x & =\\frac{\\pi }{12}+\\frac{n\\pi }{2}.\\end{aligned}\n$$\n\nTherefore, we conclude that the zeros are $x=\\frac{\\pi }{12}+\\frac{n\\pi }{2},$ where $n$ is an integer."}] [{:db/id #edb/ref 17592186297238 :knowledge-point/_questions [{:db/id #edb/ref 17592186176049 :knowledge-point/id #uuid "4241c7bd-4a2b-556f-be9f-8a884addebb9" :knowledge-point/title "Describing Properties of the Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "064a647e-d06a-50bb-9cbc-0f17389eca42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186295298} {:answer/id #uuid "1066d92d-62c9-5dad-8b4c-dbbe71386d05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186295362} {:answer/id #uuid "3f3a0291-6ad9-5566-9fd5-0de08933b4a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186295630} {:answer/id #uuid "8e8ba8e5-5fce-5a75-b9a3-f9b2aab87da3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186296026} {:answer/id #uuid "bb2ff4e9-ee34-51e6-b267-06c09d19013f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186296249}] :answer-field/correct {:answer/id #uuid "8e8ba8e5-5fce-5a75-b9a3-f9b2aab87da3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186296026} :answer-field/id #uuid "b1618392-44be-533c-81a8-efd84eeee3ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297006}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c5a3a079-0ec8-5b33-84d2-568517288149" :question/math-academy-id "q-29608" :question/problem "Which of the following statements are true regarding the function $y=tan⁡x?$ Assume that $n$ represents any integer.\n\n- The function has asymptotes at $x=n\\pi .$\n- $tan⁡(x)=tan⁡(x+2n\\pi ).$\n- The range of the function is $[-1,1].$" :question/worked-solution "Let's recall the graph of $y=tan⁡x.$\n\n![](images/31/31b430f003171dcc04a8f17402d6035fbbc305c244d3676bbf5da83fa447bd50.png)\n\nLet's examine each statement.\n\n- Statement I is false. The function $y=tan⁡x$ has asymptotes at $x=\\frac{\\pi }{2}+\\pi n.$\n\n- Statement II is true. The function has period $\\pi .$ So, $tan⁡(x+2n\\pi )=tan⁡(x+n\\pi +n\\pi )=tan⁡(x+n\\pi )=tan⁡(x).$\n\n- Statement III is false. The range of $y=tan⁡x$ is $(-\\infty ,+\\infty ).$"}] [{:db/id #edb/ref 17592186395804 :knowledge-point/_questions [{:db/id #edb/ref 17592186115185 :knowledge-point/id #uuid "74c9c0f6-034c-5d9c-935a-ca27dec1a648" :knowledge-point/title "Solving a Trigonometric Equation Involving Cotangent Under a Modified Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35051668-a56c-5024-9510-5bb50d0360fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\,741" :db/id #edb/ref 17592186395806} {:answer/id #uuid "9c07c6a6-5b40-55a4-9250-674b5ab51617" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\,731" :db/id #edb/ref 17592186395807} {:answer/id #uuid "0d4cbb58-b903-5380-9c08-172acb79c3a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\,631" :db/id #edb/ref 17592186395808} {:answer/id #uuid "6fbfb4e9-a306-5d6f-a040-1f5b9ed69042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\,851" :db/id #edb/ref 17592186395809} {:answer/id #uuid "8c3be72d-8de9-5e24-a778-ee5537402bbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\,561" :db/id #edb/ref 17592186395810}] :answer-field/correct {:answer/id #uuid "35051668-a56c-5024-9510-5bb50d0360fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\,741" :db/id #edb/ref 17592186395806} :answer-field/id #uuid "4440a234-4417-5c7c-aab8-361ac22515f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395805}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0fa4866c-44a3-53be-9ea4-1b3c073da31b" :question/math-academy-id "q-29664" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{cot}⁡x=-\\frac{3}{4}$ for $-{180}^{∘}<x<{180}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2},$ rounded to the nearest integer?" :question/worked-solution "Recall that $\\operatorname{cot}⁡x=\\frac{1}{\\operatorname{tan}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{tan}⁡x=-\\frac{4}{3}\n$$\n\nNow, we find the principal value:\n\n$$\n\\begin{aligned}x & =\\operatorname{arctan}⁡(-\\frac{4}{3})=(-53.130\\,1…)^{∘}≈-{53.130}^{∘}\\end{aligned}\n$$\n\nSince $-{53.130}^{∘}$ lies inside the given domain, our first solution is ${x}_{1}=-{53.130}^{∘}.$\n\nTo generate more solutions, we add and subtract integer multiples of ${180}^{∘}.$ Hence,\n\n$$\n\\begin{aligned}{x}_{2} & ={180}^{∘}+x={180}^{∘}-{53.130}^{∘}={126.870}^{∘}.\\end{aligned}\n$$\n\nSo, the solutions are $x=-{53.130}^{∘},{126.870}^{∘}.$\n\nFinally, the numerical value of ${x}_{1}\\cdot {x}_{2}$ is \n\n$$\n-53.130\\cdot 126.870≈-6\\,741\n$$\n\nrounded to the nearest integer."}] [{:db/id #edb/ref 17592186297239 :knowledge-point/_questions [{:db/id #edb/ref 17592186064198 :knowledge-point/id #uuid "1113b2b6-ac10-5599-9e94-5bbed95e32a5" :knowledge-point/title "Evaluating the Definite Integral of a Radical Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "144a6036-1a43-5c55-bd4d-8c3b921ab81d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4-\\sqrt{2}}{6}" :db/id #edb/ref 17592186295382} {:answer/id #uuid "1a4bc189-56e8-506b-afae-8c32583fd169" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4+\\sqrt{2}}{6}" :db/id #edb/ref 17592186295423} {:answer/id #uuid "4809f8aa-d435-582b-a813-64757ceea05b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4-\\sqrt{2}}{3}" :db/id #edb/ref 17592186295678} {:answer/id #uuid "598e8e48-0407-5a12-b4c7-8a90c76b22d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2+\\sqrt{2}}{3}" :db/id #edb/ref 17592186295784} {:answer/id #uuid "addb0989-293c-52f5-817b-1eac8428806e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4+\\sqrt{2}}{6}" :db/id #edb/ref 17592186296181}] :answer-field/correct {:answer/id #uuid "144a6036-1a43-5c55-bd4d-8c3b921ab81d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4-\\sqrt{2}}{6}" :db/id #edb/ref 17592186295382} :answer-field/id #uuid "f0a2dd69-37ef-5e8e-92ea-d1b66a49d028" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297125}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "380886ef-0fbf-54bc-9579-e4e21dd4f7ae" :question/math-academy-id "q-29673" :question/problem "${\\int }_{1}^{2}\\frac{1}{\\sqrt{{x}^{5}}}\\,\\text{d}x=$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}\\frac{1}{\\sqrt{{x}^{5}}}\\,\\text{d}x & ={\\int }_{1}^{2}{x}^{-5/2}\\,\\text{d}x \\\\  & =\\frac{{x}^{-5/2+1}}{-\\frac{5}{2}+1}{|}_{1}^{2} \\\\  & =-\\frac{2}{3}{x}^{-3/2}{|}_{1}^{2} \\\\  & =-\\frac{2}{3}\\cdot \\frac{1}{{(\\sqrt{x})}^{3}}{|}_{1}^{2} \\\\  & =-\\frac{2}{3}(\\frac{1}{(\\sqrt{2})^{3}}-\\frac{1}{(\\sqrt{1})^{3}}) \\\\  & =-\\frac{2}{3}(\\frac{\\sqrt{2}}{4}-1) \\\\  & =-\\frac{2}{3}(\\frac{\\sqrt{2}-4}{4}) \\\\  & =\\frac{4-\\sqrt{2}}{6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297242 :knowledge-point/_questions [{:db/id #edb/ref 17592186078597 :knowledge-point/id #uuid "ec980fcb-97ed-5c60-94de-0521d9d7df27" :knowledge-point/title "Calculating the Definite Integral of a Piecewise Continuous Function Given the Function Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c9d9c4e-2687-5a00-b777-4684cc0de27f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186295338} {:answer/id #uuid "3ffdef35-a30a-5f30-99b8-4a995eac8ffb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-500" :db/id #edb/ref 17592186295632} {:answer/id #uuid "a6bb394a-fe2f-5d30-b8bc-9546189fbccc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186296144} {:answer/id #uuid "c0eee9c9-1fa3-56af-a61c-95a972738e2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-50" :db/id #edb/ref 17592186296285} {:answer/id #uuid "e36988ba-6cfe-5f34-b0a1-f31a0c88f51b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "500" :db/id #edb/ref 17592186296479}] :answer-field/correct {:answer/id #uuid "c0eee9c9-1fa3-56af-a61c-95a972738e2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-50" :db/id #edb/ref 17592186296285} :answer-field/id #uuid "e17078ea-5afe-5ed2-9a45-a07ca7d4a2b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297099}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7ee241ee-6c9b-581f-8e3e-00ecaf1e5967" :question/math-academy-id "q-29734" :question/problem "The function $f(x)$ is defined below. What is the value of \n${\\int }_{0}^{10}f(x)\\,\\text{d}x\\,?$\n\n$$\nf(x)={\\begin{aligned}x-9, & x<5 \\\\ \\frac{x}{5}-5, & x\\ge 5\\end{aligned}\n$$" :question/worked-solution "By the additive property of the definite integral, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{10}f(x)\\,\\text{d}x & ={\\int }_{0}^{5}(x-9)\\,\\text{d}x+{\\int }_{5}^{10}(\\frac{x}{5}-5)\\,\\text{d}x \\\\  & ={(\\frac{{x}^{2}}{2}-9x)|}_{0}^{5}+{(\\frac{{x}^{2}}{10}-5x)|}_{5}^{10} \\\\  & =[\\frac{(5)^{2}}{2}-9(5)-\\frac{(0)^{2}}{2}+9(0)]+[\\frac{(10)^{2}}{10}-5(10)-\\frac{(5)^{2}}{10}+5(5)] \\\\  & =[\\frac{25}{2}-45]+[10-50-\\frac{25}{10}+25] \\\\  & =-50.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297244 :knowledge-point/_questions [{:db/id #edb/ref 17592186078597 :knowledge-point/id #uuid "ec980fcb-97ed-5c60-94de-0521d9d7df27" :knowledge-point/title "Calculating the Definite Integral of a Piecewise Continuous Function Given the Function Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "021675ce-f69e-5717-beee-62f1b55fe9a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186295272} {:answer/id #uuid "3e46952e-9cec-5cb5-af26-701cae6d5879" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-33" :db/id #edb/ref 17592186295626} {:answer/id #uuid "6dcb4361-9b61-51c7-9aaf-35ffbda245cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-48" :db/id #edb/ref 17592186295875} {:answer/id #uuid "e3676b27-8ef7-5622-91a9-2bca7ef2dc81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186296478} {:answer/id #uuid "fd2022c7-8746-55e0-8d32-73482f73ca68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186296614}] :answer-field/correct {:answer/id #uuid "e3676b27-8ef7-5622-91a9-2bca7ef2dc81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186296478} :answer-field/id #uuid "66c909a9-c1e8-56c3-a557-6fc2fdb9e1a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296847}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "598039da-8879-5b3c-ab71-e359f8b00731" :question/math-academy-id "q-29742" :question/problem "The function $f(x)$ is defined below. What is the value of \n${\\int }_{0}^{6}f(x)\\,\\text{d}x\\,?$\n\n$$\nf(x)={\\begin{aligned}3x-9, & x<3 \\\\ \\frac{x}{3}-1, & x\\ge 3\\end{aligned}\n$$" :question/worked-solution "By the additive property of the definite integral, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{6}f(x)\\,\\text{d}x & ={\\int }_{0}^{3}(3x-9)\\,\\text{d}x+{\\int }_{3}^{6}(\\frac{x}{3}-1)\\,\\text{d}x \\\\  & ={(\\frac{3{x}^{2}}{2}-9x)|}_{0}^{3}+{(\\frac{{x}^{2}}{6}-x)|}_{3}^{6} \\\\  & =[\\frac{3(3)^{2}}{2}-9(3)-\\frac{3(0)^{2}}{2}+9(0)]+[\\frac{(6)^{2}}{6}-6-\\frac{(3)^{2}}{6}+3] \\\\  & =[\\frac{27}{2}-27]+[6-6-\\frac{3}{2}+3] \\\\  & =-\\frac{27}{2}+\\frac{3}{2} \\\\  & =-12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064716 :knowledge-point/_questions [{:db/id #edb/ref 17592186064196 :knowledge-point/id #uuid "67bbd172-1940-5a1e-82f8-ffc73058f009" :knowledge-point/title "Evaluating the Definite Integral of a Polynomial Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a6f3f8e-0c5f-5742-981c-efe44d651035" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "189" :db/id #edb/ref 17592186295321} {:answer/id #uuid "7306755f-204c-5784-9675-85e4c40d4fec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "63" :db/id #edb/ref 17592186295896} {:answer/id #uuid "97ff1ca8-cab0-5552-a6be-a28c36723d02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{125}{3}" :db/id #edb/ref 17592186296080} {:answer/id #uuid "9cbdd0be-cf59-5728-817c-107e52a30f10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{189}{2}" :db/id #edb/ref 17592186296104} {:answer/id #uuid "ce989bf2-91f9-5cfb-894e-5fff41cce741" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{64}{3}" :db/id #edb/ref 17592186296349}] :answer-field/correct {:answer/id #uuid "7306755f-204c-5784-9675-85e4c40d4fec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "63" :db/id #edb/ref 17592186295896} :answer-field/id #uuid "29935fac-8196-589a-b966-f9c10dd6483e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296714}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1ea9ad4a-c4e1-5eef-bc95-8f5cd98ebf22" :question/math-academy-id "q-29744" :question/problem "Evaluate  ${\\int }_{-5}^{4}{x}^{2}\\,\\text{d}x.$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{-5}^{4}{x}^{2}\\,\\text{d}x & =\\frac{{x}^{2+1}}{2+1}{|}_{-5}^{4} \\\\  & =\\frac{{x}^{3}}{3}{|}_{-5}^{4} \\\\  & =\\frac{{4}^{3}}{3}-\\frac{(-5)^{3}}{3} \\\\  & =\\frac{64}{3}+\\frac{125}{3} \\\\  & =63.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297247 :knowledge-point/_questions [{:db/id #edb/ref 17592186115212 :knowledge-point/id #uuid "66c5a147-0100-5f4b-a221-25b8674b2115" :knowledge-point/title "Evaluating the Integral of a Sum of Two Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ac468f7-459a-524a-906d-0b77ce69c347" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "54" :db/id #edb/ref 17592186295509} {:answer/id #uuid "3866e65f-5a6b-5139-971d-78279fa95a54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{128}{5}" :db/id #edb/ref 17592186295585} {:answer/id #uuid "3d776cfc-e9b5-5e0f-a90c-6c72a5495162" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{268}" :db/id #edb/ref 17592186295619} {:answer/id #uuid "4cdc102e-c773-5605-aa07-bee1b412e617" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186295706} {:answer/id #uuid "d67385d1-7806-5881-a583-0cce0325b5ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{268}{5}" :db/id #edb/ref 17592186296394}] :answer-field/correct {:answer/id #uuid "d67385d1-7806-5881-a583-0cce0325b5ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{268}{5}" :db/id #edb/ref 17592186296394} :answer-field/id #uuid "55e2b20e-f764-56d3-b81b-879a2eeacf48" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296806}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "953eaea1-7562-55f0-8e7b-723ba8d5e0ae" :question/math-academy-id "q-29780" :question/problem "Evaluate ${\\int }_{0}^{4}(2\\sqrt{{x}^{3}}+3x+1)\\,\\text{d}x.$" :question/worked-solution "First, we rewrite the integral as\n\n$$\n{\\int }_{0}^{4}(2\\sqrt{{x}^{3}}+3x+1)\\,\\text{d}x={\\int }_{0}^{4}(2{x}^{3/2}+3x+1)\\,\\text{d}x.\n$$\n\nThen, we split the integral into the difference of three integrals and factor out the constants. We get\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{0}^{4}(2{x}^{3/2}+3x+1)\\,\\text{d}x & =2{\\int }_{0}^{4}{x}^{3/2}\\,\\text{d}x+3{\\int }_{0}^{4}x\\,\\text{d}x+{\\int }_{0}^{4}1\\,\\text{d}x \\\\  & =2\\cdot \\frac{2}{5}{x}^{5/2}{|}_{0}^{4}+3\\cdot \\frac{{x}^{2}}{2}{|}_{0}^{4}+x\\,{|}_{0}^{4} \\\\  & =\\frac{4}{5}{x}^{5/2}{|}_{0}^{4}+\\frac{3}{2}{x}^{2}{|}_{0}^{4}+x\\,{|}_{0}^{4} \\\\  & =\\frac{4}{5}({4}^{5/2}-{0}^{5/2})+\\frac{3}{2}({4}^{2}-{0}^{2})+(4-0) \\\\  & =\\frac{4}{5}\\cdot 32+\\frac{3}{2}\\cdot 16+4 \\\\  & =\\frac{128}{5}+28 \\\\  & =\\frac{268}{5}.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297248 :knowledge-point/_questions [{:db/id #edb/ref 17592186105715 :knowledge-point/id #uuid "cf98ee24-7774-5674-8a1e-63f4f6d225c0" :knowledge-point/title "Integrating a Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "155da407-c8ba-5fa2-9127-413d6bff8d2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3ln⁡x+C" :db/id #edb/ref 17592186295391} {:answer/id #uuid "2ca76ff5-0227-56f5-94be-d80b462a5d45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{ln⁡x}+C" :db/id #edb/ref 17592186295528} {:answer/id #uuid "5c5899f6-d895-5413-bfee-0587b9cf1149" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3ln⁡|x|+C" :db/id #edb/ref 17592186295802} {:answer/id #uuid "705c2710-b928-5586-a10e-67ac7d7acb16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3ln⁡|x|+C" :db/id #edb/ref 17592186295884} {:answer/id #uuid "bd595728-5d66-5fce-842a-829a9bf9e495" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-3}{ln⁡|x|}+C" :db/id #edb/ref 17592186296265}] :answer-field/correct {:answer/id #uuid "705c2710-b928-5586-a10e-67ac7d7acb16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3ln⁡|x|+C" :db/id #edb/ref 17592186295884} :answer-field/id #uuid "d6439f4c-9689-5960-aa2c-ca05e0a5ed1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297080}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f3f7435c-4593-5eb7-979c-b6475dc0ac4f" :question/math-academy-id "q-29831" :question/problem "Calculate $\\int -\\frac{3}{x}\\,\\text{d}x=$" :question/worked-solution "First, we apply the constant factor rule and take the coefficient $-3$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int -\\frac{3}{x}\\,\\text{d}x & =-3\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =-3ln⁡|x|+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297249 :knowledge-point/_questions [{:db/id #edb/ref 17592186105720 :knowledge-point/id #uuid "df7dddc6-a4fd-5b1b-9b73-8528e5224ca9" :knowledge-point/title "Integrating a Reciprocal Function and Simplifying the Arbitrary Constant Using the Laws of Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b9f3ccb-57a5-54e7-9651-cd8e38e071bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}ln⁡(5K|x|)" :db/id #edb/ref 17592186295330} {:answer/id #uuid "137963fa-e7bf-5b99-b97d-16a6e2b83b62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}ln⁡(K|x|)" :db/id #edb/ref 17592186295376} {:answer/id #uuid "3ba78d99-70e5-5576-9ab3-f6f5d63e5557" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}ln⁡(K|x|)" :db/id #edb/ref 17592186295610} {:answer/id #uuid "ab6cacd1-8561-54df-98e0-e7424109595d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-ln⁡(\\frac{5}{2}K|x|)" :db/id #edb/ref 17592186296168} {:answer/id #uuid "e35e2f64-0c17-5dfe-a27c-81e2452e3e98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}ln⁡(|x|+K)" :db/id #edb/ref 17592186296477}] :answer-field/correct {:answer/id #uuid "3ba78d99-70e5-5576-9ab3-f6f5d63e5557" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}ln⁡(K|x|)" :db/id #edb/ref 17592186295610} :answer-field/id #uuid "c450e82f-bb3f-51ae-bbf9-78580de51634" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297036}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eec65b66-7ead-5d6e-b179-5aacd453b9d8" :question/math-academy-id "q-29834" :question/problem "What is the antiderivative of $-\\frac{5}{2x}?$" :question/worked-solution "First, we apply the constant factor rule and take the coefficient $-\\frac{5}{2}$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int -\\frac{5}{2x}\\,\\text{d}x & =-\\frac{5}{2}\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =-\\frac{5}{2}ln⁡|x|+C.\\end{aligned}\n$$\n\nLastly, let's rewrite the constant so that we can combine it with the natural logarithm. For any constant $C,$ we can always write $C=-\\frac{5}{2}ln⁡K$ where $K$ is some other positive constant. Doing this allows us to combine the constant with $-\\frac{5}{2}ln⁡|x|$ term, and we get\n\n$$\n\\begin{aligned}\\int -\\frac{5}{2x}\\,\\text{d}x & =-\\frac{5}{2}ln⁡|x|-\\frac{5}{2}ln⁡K \\\\  & =-\\frac{5}{2}(ln⁡|x|+ln⁡K) \\\\  & =-\\frac{5}{2}ln⁡(K|x|).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297251 :knowledge-point/_questions [{:db/id #edb/ref 17592186105716 :knowledge-point/id #uuid "3c865ec2-5bed-5892-966b-a586097be923" :knowledge-point/title "Integrating the Sum of a Reciprocal Function and a Power Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "298a44ce-4517-57c9-8784-5136e6d9c6af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{5}{x}^{11/3}+\\sqrt{5}\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186295500} {:answer/id #uuid "2e55410d-693f-527e-b63c-efdd8027016a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{5}{x}^{4/3}+2\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186295534} {:answer/id #uuid "91074ff5-3842-537b-b69c-20abfee3093d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\operatorname{ln}⁡x}{5}{x}^{5/3}+\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186296046} {:answer/id #uuid "ae484638-462d-55ee-b006-7e7f7e36be1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{5}{x}^{7/3}+\\sqrt{3}\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186296183} {:answer/id #uuid "d6b38dca-ffa5-5659-aa91-113d55a9cced" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}{x}^{5/3}+\\sqrt{2}\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186296395}] :answer-field/correct {:answer/id #uuid "d6b38dca-ffa5-5659-aa91-113d55a9cced" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}{x}^{5/3}+\\sqrt{2}\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186296395} :answer-field/id #uuid "d4ea97da-7b64-5d03-a1a8-9448f2925fe1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297075}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a9a35970-b3a0-5bae-b863-30b3731d8d68" :question/math-academy-id "q-29885" :question/problem "Calculate $\\int ({x}^{2/3}+\\frac{\\sqrt{2}}{x})\\,\\text{d}x.$" :question/worked-solution "First, we apply the sum rule and get\n\n$$\n\\int ({x}^{2/3}+\\frac{\\sqrt{2}}{x})\\,\\text{d}x=\\int {x}^{2/3}\\,\\text{d}x+\\sqrt{2}\\int \\frac{1}{x}\\,\\text{d}x\n$$\n\nNow, using the power rule in the first term, and taking out the coefficient in the second term, we get\n\n$$\n\\begin{aligned}\\int {x}^{2/3}\\,\\text{d}x+\\sqrt{2}\\int \\frac{1}{x}\\,\\text{d}x & =\\frac{{x}^{2/3+1}}{\\frac{2}{3}+1}+\\sqrt{2}\\operatorname{ln}⁡|x|+C \\\\  & =\\frac{3}{5}{x}^{5/3}+\\sqrt{2}\\operatorname{ln}⁡|x|+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297254 :knowledge-point/_questions [{:db/id #edb/ref 17592186105716 :knowledge-point/id #uuid "3c865ec2-5bed-5892-966b-a586097be923" :knowledge-point/title "Integrating the Sum of a Reciprocal Function and a Power Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0abba1e8-07a5-5982-8931-920e2b54ed11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5ln⁡|x|+C" :db/id #edb/ref 17592186295324} {:answer/id #uuid "14c3a82a-71bb-5b22-a1d7-5d3ffaa433a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4ln⁡|x|+C" :db/id #edb/ref 17592186295384} {:answer/id #uuid "218a6eff-a0a2-5775-878d-fb334d854a63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4ln⁡|x|+C" :db/id #edb/ref 17592186295454} {:answer/id #uuid "5203ee4a-c762-565e-a1e7-1c414c5d786d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6x+C" :db/id #edb/ref 17592186295738} {:answer/id #uuid "e96a5e23-083b-5d3f-bddc-50fd9a0aed8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x+C" :db/id #edb/ref 17592186296509}] :answer-field/correct {:answer/id #uuid "14c3a82a-71bb-5b22-a1d7-5d3ffaa433a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4ln⁡|x|+C" :db/id #edb/ref 17592186295384} :answer-field/id #uuid "65380cf5-c8c6-595a-9584-e99d721414af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296843}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "77e80b12-44f5-5ee6-b586-d6d7898a0c32" :question/math-academy-id "q-29915" :question/problem "Find the integral of $\\frac{\\sqrt{{x}^{3}}}{\\sqrt{{x}^{5}}}-5{x}^{-1}$ with respect to $x.$" :question/worked-solution "Simplifying the exponents and applying the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int (\\frac{\\sqrt{{x}^{3}}}{\\sqrt{{x}^{5}}}-5{x}^{-1})\\text{d}x & =\\int \\frac{1}{{x}^{5/2-3/2}}\\,\\text{d}x-5\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =\\int \\frac{1}{x}\\,\\text{d}x-5\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =-4\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =-4ln⁡|x|+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186395811 :knowledge-point/_questions [{:db/id #edb/ref 17592186115183 :knowledge-point/id #uuid "65e15de1-ee72-55ea-accb-1124f3a0ac0c" :knowledge-point/title "Solving Trigonometric Equations Involving Cosecant Under a Modified Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab6f005d-5267-58e5-84bf-a80272331a4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,176" :db/id #edb/ref 17592186395813} {:answer/id #uuid "7e3a07e3-abf9-52a3-90a9-53487e034b7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,641" :db/id #edb/ref 17592186395814} {:answer/id #uuid "ce65e29e-1b9d-54dc-94af-379795c62563" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,741" :db/id #edb/ref 17592186395815} {:answer/id #uuid "198aafc0-07ef-5e53-9034-41f2a9658b0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,746" :db/id #edb/ref 17592186395816} {:answer/id #uuid "21c0594d-dee0-5fde-9687-2438c3bda33b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,764" :db/id #edb/ref 17592186395817}] :answer-field/correct {:answer/id #uuid "ce65e29e-1b9d-54dc-94af-379795c62563" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,741" :db/id #edb/ref 17592186395815} :answer-field/id #uuid "d68ef59f-9eeb-59d5-b977-da3a30f3eafc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395812}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fa37b599-4ad5-59f0-a1aa-7677947192cf" :question/math-academy-id "q-29938" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{csc}⁡x=\\frac{5}{4}$ for $-{180}^{∘}\\le x<{180}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2},$ rounded to the nearest integer?" :question/worked-solution "Recall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x},$ therefore the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=\\frac{4}{5}.\n$$\n\nNow, we have to find the principal value:\n\n$$\nx=\\operatorname{arcsin}⁡(\\frac{4}{5})=(53.130\\,1…)^{∘}≈{53.130}^{∘}\n$$\n\nSince ${53.130}^{∘}$ lies inside the given domain, our first solution is ${x}_{1}={53.130}^{∘}.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}={53.130}^{∘}.$ Since $\\operatorname{sin}⁡x>0,$ the second solution must lie in the second quadrant, and it also has a reference angle ${\\theta }_{R}={53.130}^{∘}.$\n\n![](images/60/605af77803fb027c09833b50801fe4b8e6a42a2b623af94a732d0f2f222f9f4a.png)\n\nSince the second solution ${x}_{2}$ lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={180}^{∘}-{\\theta }_{R} \\\\  & ={180}^{∘}-{53.130}^{∘} \\\\  & ={126.870}^{∘}\\end{aligned}\n$$\n\nTherefore, the solutions are $x={53.130}^{∘},{126.870}^{∘}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}≈53.130\\cdot 126.870≈6\\,741.\n$$\n\nrounded to the nearest integer."}] [{:db/id #edb/ref 17592186297256 :knowledge-point/_questions [{:db/id #edb/ref 17592186068760 :knowledge-point/id #uuid "f7614a05-f221-5fda-b491-6893f44a1a5f" :knowledge-point/title "Dividing Rational Expressions with Multiple Common Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c4f1d16-78b3-5045-8bb5-5579fec4543a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11(k+2)}{{y}^{2}}" :db/id #edb/ref 17592186295613} {:answer/id #uuid "4d3602d9-f3c5-5344-8c7b-288df52749cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11{y}^{2}}{k+4}" :db/id #edb/ref 17592186295709} {:answer/id #uuid "93b20eed-4388-595a-84d8-977910934218" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{k+4}{{y}^{2}}" :db/id #edb/ref 17592186296058} {:answer/id #uuid "aa7ed919-742c-5a4c-b988-a4265e3f6f06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{44(k+2)}" :db/id #edb/ref 17592186296162} {:answer/id #uuid "e8492be0-a6b9-5d09-afa1-2e0f3bbeb2cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{22(k+2)}{{y}^{2}}" :db/id #edb/ref 17592186296502}] :answer-field/correct {:answer/id #uuid "e8492be0-a6b9-5d09-afa1-2e0f3bbeb2cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{22(k+2)}{{y}^{2}}" :db/id #edb/ref 17592186296502} :answer-field/id #uuid "17d9d487-4676-539c-9b1c-0c3a024bdb73" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296680}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "964f86e1-4f13-55f4-a1ab-8caf3da2db2d" :question/math-academy-id "q-29970" :question/problem "If $\\frac{2(k+2)}{121y}\\cdot Y=\\frac{4(k+2)^{2}}{11{y}^{3}},$ then what is $Y?$" :question/worked-solution "Since $\\frac{2(k+2)}{121y}\\cdot Y=\\frac{4(k+2)^{2}}{11{y}^{3}},$ we have\n\n$$\nY=\\frac{4(k+2)^{2}}{11{y}^{3}}÷\\frac{2(k+2)}{121y}.\n$$\n\nTo compute this quotient, we just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{4(k+2)^{2}}{11{y}^{3}}÷\\frac{2(k+2)}{121y} & = \\\\ \\frac{4(k+2)^{2}}{11{y}^{3}}\\cdot \\frac{121y}{2(k+2)} & = \\\\ \\frac{2\\cdot 2(k+2)\\cdot (k+2)}{11y\\cdot {y}^{2}}\\cdot \\frac{11\\cdot 11y}{2(k+2)} & = \\\\ \\frac{2\\cdot \\cancel{2(k+2)}\\cdot (k+2)}{\\cancel{11y}\\cdot {y}^{2}}\\cdot \\frac{11\\cdot \\cancel{11y}}{\\cancel{2(k+2)}} & = \\\\ \\frac{2(k+2)}{{y}^{2}}\\cdot 11 & = \\\\ \\frac{22(k+2)}{{y}^{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069217 :knowledge-point/_questions [{:db/id #edb/ref 17592186068860 :knowledge-point/id #uuid "9d78ba1c-5297-5540-afdc-d419d33e0cf7" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Rational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9253c945-96c0-5170-ab31-77a3ad0f24d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p + q = 7, x_{1} + x_{2} = 4" :db/id #edb/ref 17592186066485} {:answer/id #uuid "a2710526-3439-5d45-a3cb-b94809df5d4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p + q = 9, x_{1} + x_{2} = 4" :db/id #edb/ref 17592186066486} {:answer/id #uuid "b5eac8af-989a-5812-82cd-e6e80a244860" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p + q = 7, x_{1} + x_{2} =-4" :db/id #edb/ref 17592186066487} {:answer/id #uuid "cec6266a-38e0-5082-ae2c-0c20a9b251e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p + q = 7, x_{1} + x_{2} = 6" :db/id #edb/ref 17592186066488} {:answer/id #uuid "d0b0d285-5968-53b9-b5b2-00fcaf5e3048" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p + q =-11x_{1} + x_{2} = 4" :db/id #edb/ref 17592186066489}] :answer-field/id #uuid "d792d360-b68f-53ea-add1-82615c19183b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186066484} {:answer-field/choices [{:answer/id #uuid "76d7ebef-b52d-5f30-ac74-d49866c8f6a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=7\\,,\\,\\,{x}_{1}+{x}_{2}=4" :db/id #edb/ref 17592186401956} {:answer/id #uuid "d00f8b18-cb37-5c31-961a-3438330ad683" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=7\\,,\\,\\,{x}_{1}+{x}_{2}=6" :db/id #edb/ref 17592186401957} {:answer/id #uuid "ae0444d5-a369-5e49-89bd-c5ebc8c0237a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=-11\\,\\,\\,{x}_{1}+{x}_{2}=4" :db/id #edb/ref 17592186401958} {:answer/id #uuid "44f7e400-b932-5f1e-a0ab-bdb9a22e3846" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=7\\,,\\,\\,{x}_{1}+{x}_{2}=-4" :db/id #edb/ref 17592186401959} {:answer/id #uuid "7d8857d6-881c-5549-bde0-3f1a4f61d2d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=9\\,,\\,\\,{x}_{1}+{x}_{2}=4" :db/id #edb/ref 17592186401960}] :answer-field/correct {:answer/id #uuid "76d7ebef-b52d-5f30-ac74-d49866c8f6a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=7\\,,\\,\\,{x}_{1}+{x}_{2}=4" :db/id #edb/ref 17592186401956} :answer-field/id #uuid "b5fa6494-6274-595a-88b0-e033638de4a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401955}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c02e0e4e-c511-5b9e-9632-6db46dfe1bf6" :question/math-academy-id "q-30052" :question/problem "The equation ${x}^{2}-4x+4=9$ can be written in the form $(x+p)^{2}=q.$ Find $\\,p+q,$ and the sum of the roots ${x}_{1}+{x}_{2}.$" :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-4x+4 & =9 \\\\ {x}^{2}-4x & =5 \\\\ {x}^{2}-2\\cdot 2\\cdot x & =5 \\\\ {x}^{2}-2\\cdot 2\\cdot x+{2}^{2}-{2}^{2} & =5 \\\\ ({x}^{2}-2\\cdot 2\\cdot x+{2}^{2})-4 & =5 \\\\ (x-2)^{2}-4 & =5\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(x-2)^{2}-4 & =5 \\\\ (x-2)^{2} & =9\\end{aligned}\n$$\n\nSo, $p=-2,q=9,$ and $p+q=7.$\n\nNow, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(x-2)^{2} & =9 \\\\ \\sqrt{(x-2)^{2}} & =\\sqrt{9} \\\\ x-2 & =\\pm 3 \\\\ x & =2\\pm 3\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =2+3=5 \\\\ {x}_{2} & =2-3=-1\\end{aligned}\n$$\n\nSo, the solutions are ${x}_{1}=-1$ and ${x}_{2}=5.$ Thus, the sum is $4.$"}] [{:db/id #edb/ref 17592186401961 :knowledge-point/_questions [{:db/id #edb/ref 17592186068860 :knowledge-point/id #uuid "9d78ba1c-5297-5540-afdc-d419d33e0cf7" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Rational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f24ab63d-b4d8-50ae-8389-5045b51319bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=0\\,$ and $\\,{x}_{1}+{x}_{2}=2$" :db/id #edb/ref 17592186401963} {:answer/id #uuid "6c1507f7-b1b3-56e3-a38c-1b563d660137" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=1$" :db/id #edb/ref 17592186401964} {:answer/id #uuid "b2d7f47d-c746-5735-9e9f-835593e46fab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=2$" :db/id #edb/ref 17592186401965} {:answer/id #uuid "aa922213-ad7d-513f-ad50-36362f5e8cc5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=1\\,$ and $\\,{x}_{1}+{x}_{2}=2$" :db/id #edb/ref 17592186401966} {:answer/id #uuid "b9d50863-24e6-52af-928c-18cf82d1862f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=-1$" :db/id #edb/ref 17592186401967}] :answer-field/correct {:answer/id #uuid "b2d7f47d-c746-5735-9e9f-835593e46fab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=2$" :db/id #edb/ref 17592186401965} :answer-field/id #uuid "5f724395-4532-5650-9bbb-1b5a58b225fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401962}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "85741874-6828-5db4-a1ab-e8bb9b524df8" :question/math-academy-id "q-30055" :question/problem "The equation ${x}^{2}-2x+1=1$ can be written in the form $(x+p)^{2}=q.$ Find $\\,pq\\,,$ and the sum of the roots ${x}_{1}+{x}_{2}.$" :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-2x+1 & =1 \\\\ {x}^{2}-2x & =0 \\\\ {x}^{2}-2\\cdot x\\cdot 1+{1}^{2}-{1}^{2} & =0 \\\\ (x-1)^{2}-{1}^{2} & =0 \\\\ (x-1)^{2} & =1\\end{aligned}\n$$\n\nHence, $p=-1$ and $q=1.$ Thus, $pq=-1.$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-1)^{2} & =1 \\\\ \\sqrt{(x-1)^{2}} & =\\sqrt{1} \\\\ |x-1| & =1 \\\\ x-1 & =\\pm 1 \\\\ x & =1\\pm 1\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =1-1=0 \\\\ {x}_{2} & =1+1=2\\end{aligned}\n$$\n\nTherefore, the sum is ${x}_{1}+{x}_{2}=2.$"}] [{:db/id #edb/ref 17592186297279 :knowledge-point/_questions [{:db/id #edb/ref 17592186087823 :knowledge-point/id #uuid "40eeb5a8-3ffe-54d2-b263-f2b1c41fed93" :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0265ab4b-e69c-58cd-bb39-877b73f3298f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,11.5)" :db/id #edb/ref 17592186295275} {:answer/id #uuid "6ab493a4-b37f-5582-a8b9-4570920c001f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(10.5,0)" :db/id #edb/ref 17592186295861} {:answer/id #uuid "a1678182-8bd9-5b40-83a4-560b3c92dfe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,10.5)" :db/id #edb/ref 17592186296126} {:answer/id #uuid "ecdd579a-68d8-530f-aec2-948295be5064" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,5.5)" :db/id #edb/ref 17592186296522} {:answer/id #uuid "f541b6c1-d1ab-5c71-9e34-c29b7b48861a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5.5,0)" :db/id #edb/ref 17592186296566}] :answer-field/correct {:answer/id #uuid "a1678182-8bd9-5b40-83a4-560b3c92dfe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,10.5)" :db/id #edb/ref 17592186296126} :answer-field/id #uuid "b0972749-6df3-5836-b156-61b2f017bcaf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297005}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "91d38446-45fe-5f55-b13c-726fa96fa8c7" :question/math-academy-id "q-30269" :question/problem "For the curve $y=2.5({1.5}^{x})+8$, find the point of intersection with the $y-$axis." :question/worked-solution "**Method 1**\n\n- For the curve $y={1.5}^{x},$ the point of intersection with the $y$-axis is $(0,1).$\n\n- For the scaled function $y=2.5({1.5}^{x}),$ the $y$-coordinate becomes\n\n$$\ny=2.5\\cdot 1=2.5.\n$$\n\n- Finally, after a vertical shift of $8$ units up, we get a point with the $y$-coordinate\n\n$$\ny=2.5+8=10.5.\n$$\n\n**Method 2** \n\nTo find the $y$-intercept, we substitute $x=0$ into the equation of the curve:\n\n$$\n\\begin{aligned}y & =2.5({1.5}^{0})+8 \\\\  & =2.5\\cdot 1+8 \\\\  & =2.5+8 \\\\  & =10.5\\end{aligned}\n$$\n\nTherefore, $y=2.5({1.5}^{x})+8$ intercepts the $y$-axis at $(0,10.5).$"}] [{:db/id #edb/ref 17592186297286 :knowledge-point/_questions [{:db/id #edb/ref 17592186064207 :knowledge-point/id #uuid "bdbfa506-08a1-5e43-b958-2ae373df775d" :knowledge-point/title "Integrating a Linear Rational Function and Simplifying the Arbitrary Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dbf09c3-18df-50a3-84f7-e6f47d2ef7a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\operatorname{ln}⁡(K|3x+4|)" :db/id #edb/ref 17592186295347} {:answer/id #uuid "6e3b22d0-1d8f-5569-b6bf-7b7599fb5580" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡(K|3x+4|)" :db/id #edb/ref 17592186295876} {:answer/id #uuid "962c31da-ae4b-5022-8358-2aec9b89c95b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(K|3x+4|)" :db/id #edb/ref 17592186296067} {:answer/id #uuid "b8e4ad65-9186-54e0-8792-0e53759b7716" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡(K|3x+4|)" :db/id #edb/ref 17592186296235} {:answer/id #uuid "fa999cda-1369-5935-898a-85571f00711c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}\\operatorname{ln}⁡(K|3x+4|)" :db/id #edb/ref 17592186296595}] :answer-field/correct {:answer/id #uuid "b8e4ad65-9186-54e0-8792-0e53759b7716" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡(K|3x+4|)" :db/id #edb/ref 17592186296235} :answer-field/id #uuid "6dfec598-1f66-5fc7-8005-3949a52a7718" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296863}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "60fb4a8e-0b44-516d-9ebb-a8d91494c67e" :question/math-academy-id "q-30368" :question/problem "Calculate $\\int \\frac{1}{3x+4}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "First, let $u=3x+4.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{3x+4}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡|3x+4|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=\\frac{1}{3}\\operatorname{ln}⁡K$ for another arbitrary constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}\\frac{1}{3}\\operatorname{ln}⁡|3x+4|+C & =\\frac{1}{3}\\operatorname{ln}⁡|3x+4|+\\frac{1}{3}\\operatorname{ln}⁡K \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡(K|3x+4|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{1}{3x+4}\\,\\text{d}x=\\frac{1}{3}\\operatorname{ln}⁡(K|3x+4|).\n$$"}] [{:db/id #edb/ref 17592186297298 :knowledge-point/_questions [{:db/id #edb/ref 17592186078438 :knowledge-point/id #uuid "cf94b5cf-6407-5931-92df-9f87818e8a71" :knowledge-point/title "Applying the Second Fundamental Theorem of Calculus"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "045a1df2-5456-559d-b823-6c723a28a7f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}+3{x}^{2}+1" :db/id #edb/ref 17592186295287} {:answer/id #uuid "58c766c3-0cc8-5b0f-adf2-345d1dfda737" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a{x}^{3}+b{x}^{2}+1" :db/id #edb/ref 17592186295781} {:answer/id #uuid "6ea8dabc-09b8-5bbd-b06a-3504111d8ae3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a{x}^{3}+{x}^{2}+1" :db/id #edb/ref 17592186295878} {:answer/id #uuid "ca41a65d-8d27-5fce-9087-4e74a76cce77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}+b{x}^{2}+1" :db/id #edb/ref 17592186296327} {:answer/id #uuid "e219f4dd-c8b7-5276-9ab5-d9d79f733318" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}+2{x}^{2}+1" :db/id #edb/ref 17592186296470}] :answer-field/correct {:answer/id #uuid "58c766c3-0cc8-5b0f-adf2-345d1dfda737" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a{x}^{3}+b{x}^{2}+1" :db/id #edb/ref 17592186295781} :answer-field/id #uuid "5b8778a9-6009-5602-aa9a-0b08ab64dd87" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296820}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "be6bd7f3-2e23-5861-b95e-2eb6ae25ed99" :question/math-academy-id "q-30627" :question/problem "Calculate\n$\\frac{\\text{d}}{\\text{d}x}{\\int }_{-5}^{x}(a{s}^{3}+b{s}^{2}+1)\\,\\text{d}s$\nfor $x>-5,$ where $a$ and $b$ are constants." :question/worked-solution "The function $a{s}^{3}+b{s}^{2}+1$ is continuous on $[-5,x],$ where $x>-5.$ So, FTC II applies, and we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}{\\int }_{-5}^{x}(a{s}^{3}+b{s}^{2}+1)\\text{ }\\,\\text{d}t & =a{x}^{3}+b{x}^{2}+1.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297301 :knowledge-point/_questions [{:db/id #edb/ref 17592186101022 :knowledge-point/id #uuid "55fab3ac-cad3-54bd-b07b-9159554b634c" :knowledge-point/title "Finding the Average Value of a Function Over a Given Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "095165cd-68cc-5092-a541-017374c5c841" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186295315} {:answer/id #uuid "391a79ba-1514-5b3d-a0fb-45581aae517b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186295593} {:answer/id #uuid "5a9c65aa-a057-5380-ab7e-6c41fff6e617" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186295789} {:answer/id #uuid "841eb217-bc22-5ed1-82f6-7e5a037937c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186295974} {:answer/id #uuid "beb18a80-31c2-5374-bb9e-11f4d64b5d4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186296272}] :answer-field/correct {:answer/id #uuid "841eb217-bc22-5ed1-82f6-7e5a037937c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186295974} :answer-field/id #uuid "3276f9cb-f55b-5959-8434-6aaa7aa3a121" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296727}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "72cc8fee-c912-578c-b6ad-a221076e3800" :question/math-academy-id "q-30776" :question/problem "Find the average value of the function $g(x)=2{x}^{3}-x-1$ on the interval $[-2,0].$" :question/worked-solution "Applying the average value formula, we find that the average value of the function is\n\n$$\n\\begin{aligned}{g}_{\\text{avg}} & =\\frac{1}{b-a}{\\int }_{a}^{b}g(x)\\,\\text{d}x \\\\  & =\\frac{1}{0-(-2)}{\\int }_{-2}^{0}(2{x}^{3}-x-1)\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{-2}^{0}(2{x}^{3}-x-1)\\,\\text{d}x \\\\  & ={\\frac{1}{2}(\\frac{1}{2}{x}^{4}-\\frac{1}{2}{x}^{2}-x)|}_{-2}^{0} \\\\  & =\\frac{1}{2}[(\\frac{1}{2}\\cdot {0}^{4}-\\frac{1}{2}\\cdot {0}^{2}-0)-(\\frac{1}{2}\\cdot (-2)^{4}-\\frac{1}{2}\\cdot (-2)^{2}-(-2))] \\\\  & =\\frac{1}{2}(0-(8-2+2)) \\\\  & =\\frac{1}{2}(-8) \\\\  & =-4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297305 :knowledge-point/_questions [{:db/id #edb/ref 17592186087823 :knowledge-point/id #uuid "40eeb5a8-3ffe-54d2-b263-f2b1c41fed93" :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e5493f0-49e5-5ac0-a64b-444f26facf5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-10)" :db/id #edb/ref 17592186295811} {:answer/id #uuid "cedf3ffd-b468-57c5-a1fb-5644942d8367" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,7)" :db/id #edb/ref 17592186296352} {:answer/id #uuid "d228956c-dabb-5adf-b1f0-eea00077c044" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-7)" :db/id #edb/ref 17592186296375} {:answer/id #uuid "e5e90daa-a470-5b92-aeb7-f90fc7f25a72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-6)" :db/id #edb/ref 17592186296492} {:answer/id #uuid "ec3169b4-14de-5f3c-837e-5d327959c0c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,10)" :db/id #edb/ref 17592186296521}] :answer-field/correct {:answer/id #uuid "d228956c-dabb-5adf-b1f0-eea00077c044" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-7)" :db/id #edb/ref 17592186296375} :answer-field/id #uuid "9ef5eb88-b39d-569b-bc4c-949ed152d723" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296969}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5fda2bca-a959-55aa-9acd-07aede112347" :question/math-academy-id "q-30873" :question/problem "For the curve $y=1.5({10}^{x})-8.5$, find the point of intersection with the $y-$axis." :question/worked-solution "**Method 1**\n\n- For the curve $y={10}^{x},$ the point of intersection with the $y$-axis is $(0,1).$\n\n- For the scaled function $y=1.5({10}^{x}),$ the $y$-coordinate becomes\n\n$$\ny=1.5\\cdot 1=1.5.\n$$\n\n- Finally, after a vertical shift of $8.5$ units down, we get a point with the $y$-coordinate\n\n$$\ny=1.5-8.5=-7.\n$$\n\n**Method 2** \n\nTo find the $y$-intercept, we substitute $x=0$ into the equation of the curve:\n\n$$\n\\begin{aligned}y & =1.5({10}^{0})-8.5 \\\\  & =1.5\\cdot 1-8.5 \\\\  & =1.5-8.5 \\\\  & =-7\\end{aligned}\n$$\n\nTherefore, $y=1.5({10}^{x})-8.5$ intercepts the $y$-axis at $(0,-7).$"}] [{:db/id #edb/ref 17592186297314 :knowledge-point/_questions [{:db/id #edb/ref 17592186096656 :knowledge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9" :knowledge-point/title "Integrating a General Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02b95ba0-8776-5e87-8a07-fb4dd6e251e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{728}{\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186295276} {:answer/id #uuid "36229afc-ab9a-5470-be3f-a37b681ee81b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{364}{3}" :db/id #edb/ref 17592186295571} {:answer/id #uuid "43ef6c71-98a2-5c12-8945-04c4d08e3cc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{364}{\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186295649} {:answer/id #uuid "72e3fae5-ccad-59b0-8fc0-ac0e46bfbfb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{364}{3\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186295895} {:answer/id #uuid "8fc47e71-ee79-5542-acba-c30ea159db79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{121}{\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186296034}] :answer-field/correct {:answer/id #uuid "72e3fae5-ccad-59b0-8fc0-ac0e46bfbfb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{364}{3\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186295895} :answer-field/id #uuid "dcf773c9-a379-54a1-a3f0-7de93b756309" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297089}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "34a4e0e2-73c5-54dc-8277-4607c07e4179" :question/math-academy-id "q-30973" :question/problem "Evaluate the integral ${\\int }_{0}^{1}{3}^{6x}\\,\\text{d}x.$" :question/worked-solution "If we let $u=6x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6\\,⟹\\,\\frac{1}{6}\\,\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $0$ | $6$ |\n\nThen, we can write the integral in terms of  $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{3}^{6x}\\,\\text{d}x & ={\\int }_{0}^{6}{3}^{u}\\cdot \\frac{1}{6}\\,\\text{d}u \\\\  & =\\frac{1}{6}{\\int }_{0}^{6}{3}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{6}(\\frac{{3}^{u}}{\\operatorname{ln}⁡3}){|}_{0}^{6} \\\\  & =\\frac{1}{6\\operatorname{ln}⁡3}(729-1) \\\\  & =\\frac{728}{6\\operatorname{ln}⁡3} \\\\  & =\\frac{364}{3\\operatorname{ln}⁡3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069230 :knowledge-point/_questions [{:db/id #edb/ref 17592186068823 :knowledge-point/id #uuid "3eec195c-6549-5de2-b3f0-0417e5f518e7" :knowledge-point/title "Solving a \"Greater Than\" Inequality Given the Graph of the Corresponding Parabola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3924a0d6-844d-5dc6-83c6-7db4a2fb4e17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x<2$ or $x>4$" :db/id #edb/ref 17592186295594} {:answer/id #uuid "440955b3-6ad7-5734-9cd2-e9f88aa0e954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2<x<4" :db/id #edb/ref 17592186295651} {:answer/id #uuid "77034500-21c2-52e9-9478-7a3d41623c6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x<-4$ or $x>-2$" :db/id #edb/ref 17592186295916} {:answer/id #uuid "7798a310-53c1-5f5f-8d13-7e74a6c7123a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4<x<-2" :db/id #edb/ref 17592186295919} {:answer/id #uuid "ef80a80c-3c32-544a-b833-12476f1cf9e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x>2" :db/id #edb/ref 17592186296540}] :answer-field/correct {:answer/id #uuid "440955b3-6ad7-5734-9cd2-e9f88aa0e954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2<x<4" :db/id #edb/ref 17592186295651} :answer-field/id #uuid "41198266-3a32-5b6f-aeaf-82b61bfcb718" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296757}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8b9f08f5-9d21-5599-bebd-c942241b0925" :question/math-academy-id "q-31015" :question/problem "![](images/11/1126d885ff5000b4afdadffef7b47dec3b2932322dfa7b75d16bc00993218a0e.png)\n\nGiven the graph above, solve the inequality $-(x-2)(x-4)>0.$" :question/worked-solution "Notice that our inequality\n\n$$\n-(x-2)(x-4)>0,\n$$\n\nis a \"*greater than*\" inequality. Therefore, we need to find the values of $x$ for which the parabola \n\n$$\ny=-(x-2)(x-4)\n$$\n\nis *above* the $x$-axis. We mark these values of $x$ in blue in the diagram below.\n\n![](images/dc/dc39c970e292e38519e609367c9f4a3d810aaca99e7040bb6227ff45401b2efc.png)\n\nSo, the solution to the inequality is $2<x<4.$"}] [{:db/id #edb/ref 17592186390592 :knowledge-point/_questions [{:db/id #edb/ref 17592186068829 :knowledge-point/id #uuid "5bb394c3-cd7c-523d-88df-b1306d9d528f" :knowledge-point/title "Identifying a Vertically Shifted Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c95a3fca-97ff-5e46-ad67-42c5b5b68ef4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bc/bc4c0c21c45fc3ed02d88150facf89718896a3e2992105f5a8a5d89b0355f9e0.png" :db/id #edb/ref 17592186390594} {:answer/id #uuid "73326b1a-1067-5996-991e-bb9d853a4e78" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e6/e6edb90966ce90a141e3fa4ee1a9eb3cf9c7131e3121e45f56b16bc4395076d5.png" :db/id #edb/ref 17592186390595} {:answer/id #uuid "e7a74885-a855-53a6-a12b-5c1f9db59688" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/06/062274f402396a61c76fae3a47c54de80ad31deac970c746f3f8f4627ce535f1.png" :db/id #edb/ref 17592186390596} {:answer/id #uuid "dbeafe1a-8a14-5f3a-8d70-6e398d0ebc6b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b3/b3f96cf981a9c127dd0e3c0fa3b73f548db8c640bbc4f0e048b4576356b69532.png" :db/id #edb/ref 17592186390597} {:answer/id #uuid "44eec2a2-c1e5-5830-a6f1-3345cbd3b0c0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b4/b48f88ac53107fddece776c81d91fc5684c7d6f06ea3b862fb99cd973eae2dc3.png" :db/id #edb/ref 17592186390598}] :answer-field/correct {:answer/id #uuid "73326b1a-1067-5996-991e-bb9d853a4e78" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e6/e6edb90966ce90a141e3fa4ee1a9eb3cf9c7131e3121e45f56b16bc4395076d5.png" :db/id #edb/ref 17592186390595} :answer-field/id #uuid "a5e7cf18-216c-59ac-8255-427849d7152c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390593}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f6a50d86-9c2e-59fc-b26e-b4043bba0c39" :question/math-academy-id "q-31146" :question/problem "Which of the following is the graph of  $y={(\\frac{1}{12})}^{x}-4?$" :question/worked-solution "First we plot the graph of $y={(\\frac{1}{12})}^{x}:$\n\n![](images/e2/e2f13711ca62a8a4a698e23bdfe78caca6df44d88ded27b88c517219dffbb866.png)\n\nNext, we shift this graph $4$ units down. \nThe horizontal asymptote under such a transformation becomes $y=-4,$ the $y$-intercept becomes $(0,-3).$\nThe resulting graph of $y={(\\frac{1}{12})}^{x}-4$ is shown below.\n\n![](images/dc/dc7f93220ac18ac5671b7b41de141940ca5296139b836d56755fdccf6164ed26.png)"}] [{:db/id #edb/ref 17592186390599 :knowledge-point/_questions [{:db/id #edb/ref 17592186068768 :knowledge-point/id #uuid "ee633017-5c17-575f-bdab-5f12b7319355" :knowledge-point/title "Expressing the Area Between Two Curves as an Integral Given the Limits of Integration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d1c39ec3-887e-50dc-8edd-3cdaf54b45c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-1/2}^{1}(x-1+2{x}^{2})\\,\\text{d}x" :db/id #edb/ref 17592186390601} {:answer/id #uuid "37a1fcc8-9234-5641-b7e1-5e7f084efe44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-1/2}^{1}(x+1-2{x}^{2})\\,\\text{d}x" :db/id #edb/ref 17592186390602} {:answer/id #uuid "2654cacd-7b30-583d-bda0-799991c8b3bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-1/2}^{1}(2{x}^{2}-x-1)\\,\\text{d}x" :db/id #edb/ref 17592186390603} {:answer/id #uuid "9c69b59d-0c96-50b5-ba49-1c3d2aa4e633" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-1/2}^{1}(2{x}^{2}+x-1)\\,\\text{d}x" :db/id #edb/ref 17592186390604} {:answer/id #uuid "ab719555-3b8a-5291-ac4c-1377d5597894" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-1/2}^{1}(x-1-2{x}^{2})\\,\\text{d}x" :db/id #edb/ref 17592186390605}] :answer-field/correct {:answer/id #uuid "37a1fcc8-9234-5641-b7e1-5e7f084efe44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-1/2}^{1}(x+1-2{x}^{2})\\,\\text{d}x" :db/id #edb/ref 17592186390602} :answer-field/id #uuid "199eb7c0-d99d-5255-b218-c8c2cfb6234c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390600}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c69be2ea-7b70-598d-bb9a-251384a82770" :question/math-academy-id "q-3121" :question/problem "![](images/9a/9a87ae2b230e66b685051ee7d13987f5f68690a07a67ade9e7af0eb870f6224f.png)\n\nWhich integral gives the area of the finite region bounded by $y=2{x}^{2}$ and $y=x+1,$ as shown above?\n\n*(Note: Figure not drawn to scale)*" :question/worked-solution "The diagram shows that the intersection points between the two graphs occur when $x=-\\frac{1}{2}$ and $x=1.$ So these will be our limits of integration.\n\nTo determine which is the lower function and which is the upper, let's draw our vertical arrow.\n\n![](images/e7/e77170aac6d81b1cfd0e93804b0c59802f28089d24aeaff065da04cabc44c172.png)\n\nThe vertical line \n\n- *enters* the region through the lower function $y=2{x}^{2},$ and\n\n- *leaves* through the upper function $y=x+1.$\n\nTherefore, the integral that gives our area is\n\n$$\n\\begin{aligned}A & ={\\int }_{-1/2}^{1}[\\,(\\text{upper function})-(\\text{lower function})\\,]\\,\\text{d}x \\\\  & ={\\int }_{-1/2}^{1}[\\,(x+1)-(2{x}^{2})\\,]\\,\\text{d}x \\\\  & ={\\int }_{-1/2}^{1}(x+1-2{x}^{2})\\,\\text{d}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186097218 :knowledge-point/_questions [{:db/id #edb/ref 17592186096624 :knowledge-point/id #uuid "977a9b6e-744a-554b-92ee-0b6343041ecf" :knowledge-point/title "Identifying Points of Inflection From the Graph of the Second Derivative of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a59a296c-f26b-57d2-9f66-3089d690018b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x =-6$ and $x =-2$" :db/id #edb/ref 17592186095238} {:answer/id #uuid "448169d1-793a-5de6-ab93-2ab928cd2db5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x =-4$ and $x = 4$" :db/id #edb/ref 17592186095239} {:answer/id #uuid "4959333a-5e8c-57af-a996-2eb528af419a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = 0" :db/id #edb/ref 17592186095240} {:answer/id #uuid "645b2ac0-0d2d-51c4-983b-5d9739a24c18" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x = 0$ and $x = 4$" :db/id #edb/ref 17592186095241} {:answer/id #uuid "7efb67cf-1659-5361-bf87-0b82d0524c62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x =-4$, $x = 0$, and $x = 4$" :db/id #edb/ref 17592186095242}] :answer-field/id #uuid "d1936dc6-d067-5933-92a7-774acfe3f044" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186095237} {:answer-field/choices [{:answer/id #uuid "0a3b2c4a-a63b-5807-aacc-5245a5e6b02f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-4$ and $x=4$" :db/id #edb/ref 17592186401969} {:answer/id #uuid "46b9e8a3-14f5-5f69-831f-e7e0d797a1ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ and $x=4$" :db/id #edb/ref 17592186401970} {:answer/id #uuid "c082a9b0-d023-52a6-be52-56d8828805a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-6$ and $x=-2$" :db/id #edb/ref 17592186401971} {:answer/id #uuid "ea3248ac-1443-5057-98d3-f07c503f35c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=0" :db/id #edb/ref 17592186401972} {:answer/id #uuid "6e0e922d-f9cb-5465-99c6-9d8aecf68d80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-4,$ $x=0,$ and $x=4$" :db/id #edb/ref 17592186401973}] :answer-field/correct {:answer/id #uuid "46b9e8a3-14f5-5f69-831f-e7e0d797a1ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ and $x=4$" :db/id #edb/ref 17592186401970} :answer-field/id #uuid "9ff50305-88e5-5409-b5ae-8fb7fea82cf0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401968}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "05af1cea-c88c-5fcc-8838-0055bd7f29aa" :question/math-academy-id "q-31213" :question/problem "![](images/19/19e9763d62ca7818024bf49522a127a48dd04f76d1175c93e060a1043b6a5795.png)\n\nThe function $f(x)$ is continuous and twice-differentiable for all $x.$ The graph $y={f}^{″}(x)$ is shown above. At what value(s) of $x$ does $f(x)$ have a point of inflection?" :question/worked-solution "First, notice that since $f(x)$ is twice-differentiable, the tangent line to the graph exists for all real $x.$\n\nInflection points occur when a graph changes concavity. In order for the graph to change concavity, the value of the second derivative ${f}^{″}(x)$ must switch sign. So, we are looking for points where the graph of ${f}^{″}(x)$ crosses the $x$-axis.\n\nWe can see that the graph $y={f}^{″}(x)$ crosses the $x$-axis at $x=0$ and $x=4.$ \n\nTherefore, $f(x)$ has points of inflection at $x=0$ and $x=4.$"}] [{:db/id #edb/ref 17592186184743 :knowledge-point/_questions [{:db/id #edb/ref 17592186184152 :knowledge-point/id #uuid "d1b60735-9dae-5c23-991d-0241c208b1b7" :knowledge-point/title "Determining the Intervals of Concavity Given the Graph of the Second Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2125528a-4464-51f1-a6cf-1a62208a5272" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-\\infty ,-4)$ and $(0,4)$" :db/id #edb/ref 17592186295453} {:answer/id #uuid "2bd57e48-e096-5a21-9e35-d893d06eff4c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-4,0)$ only" :db/id #edb/ref 17592186295520} {:answer/id #uuid "8815930d-5d3e-5b84-bba5-2121ddcd2334" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-4,0)$ and $(4,\\infty )$" :db/id #edb/ref 17592186296001} {:answer/id #uuid "b4b8440e-84c6-5661-8c06-2d43e89202e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-4,0)$ and $(0,4)$" :db/id #edb/ref 17592186296217} {:answer/id #uuid "bc781f14-e709-5a2a-be21-fc63c1ca70ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,4)$ only" :db/id #edb/ref 17592186296259}] :answer-field/correct {:answer/id #uuid "bc781f14-e709-5a2a-be21-fc63c1ca70ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,4)$ only" :db/id #edb/ref 17592186296259} :answer-field/id #uuid "8006db89-19e4-548d-9078-4a9c40044888" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296895}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f627add3-7eef-5ed1-b10b-a3822778f5e1" :question/math-academy-id "q-31214" :question/problem "![](images/9f/9fe57341b631d34a9dfa41619a29f816b00b41b3b07f450fd333808230835e2c.png)\n\nThe graph of the second derivative $y={f}^{″}(x)$ of the function $f(x)$ is shown above. \nFind the intervals on which the function $f(x)$ is concave up." :question/worked-solution "A function $f(x)$ is concave up over an interval $(a,b)$ if ${f}^{″}(x)>0$ for all $x\\in (a,b).$\n\nOn the given graph of $y={f}^{″}(x),$ we can see that ${f}^{″}(x)>0$ on the interval $(0,4)$ only. \n\nTherefore, the function $f(x)$ is concave up on the interval $(0,4)$ only."}] [{:db/id #edb/ref 17592186297334 :knowledge-point/_questions [{:db/id #edb/ref 17592186184152 :knowledge-point/id #uuid "d1b60735-9dae-5c23-991d-0241c208b1b7" :knowledge-point/title "Determining the Intervals of Concavity Given the Graph of the Second Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41ccdca2-40a0-51dd-83ba-2344bbec440f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-4,-2)$ only" :db/id #edb/ref 17592186295642} {:answer/id #uuid "8fc84882-5388-58ec-a566-fb30b7f6ab42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-2,2)$ only" :db/id #edb/ref 17592186296035} {:answer/id #uuid "b149287d-31cb-5f98-b59f-e2b247461334" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-\\infty ,-4)$ and $(-2,2)$" :db/id #edb/ref 17592186296201} {:answer/id #uuid "cfcfc15c-184c-56e4-9509-e3be8619bae2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-4,-2)$ and $(2,\\infty )$" :db/id #edb/ref 17592186296357} {:answer/id #uuid "fad2dba1-d0ca-5773-8549-1415bbf003a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-2,2)$ and $(2,\\infty )$" :db/id #edb/ref 17592186296596}] :answer-field/correct {:answer/id #uuid "41ccdca2-40a0-51dd-83ba-2344bbec440f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-4,-2)$ only" :db/id #edb/ref 17592186295642} :answer-field/id #uuid "fba441ab-ea13-5287-b1e0-537ff6daa6c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297150}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e2faeba0-b737-514d-8d25-1eceee0628d8" :question/math-academy-id "q-31228" :question/problem "![](images/30/305fa76994ff0be3c43894226eaa82d3d9e016c6add11cd48d80486c50643ed0.png)\n\nThe graph above shows $y={f}^{″}(x).$ Find the intervals on which the function $f(x)$ is concave down." :question/worked-solution "A function $f(x)$ is concave down over an interval $(a,b)$ if ${f}^{″}(x)<0$ for all $x\\in (a,b).$\n\nOn the given graph of $y={f}^{″}(x)$, we can see that ${f}^{″}(x)<0$ on the interval $(-4,-2)$ only. Therefore, the function $f(x)$ is concave down on the interval $(-4,-2)$ only."}] [{:db/id #edb/ref 17592186064731 :knowledge-point/_questions [{:db/id #edb/ref 17592186064171 :knowledge-point/id #uuid "3f9548e6-28ef-5a97-ab04-dfb1b6e23c16" :knowledge-point/title "Integrating the Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cfff078-9fb4-5b67-bb26-7811957a40b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{e}^{ln⁡x}+C" :db/id #edb/ref 17592186295341} {:answer/id #uuid "36c4e4d8-ea74-510a-8195-fcca114fa7c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{e}^{x}}{2}+C" :db/id #edb/ref 17592186295573} {:answer/id #uuid "4d71c1ee-dea6-5890-90dd-6cf50a8cd3a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-2x}+C" :db/id #edb/ref 17592186295711} {:answer/id #uuid "bc3c34e1-3b8b-568c-889c-57fe85dd59ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{e}^{x}+C" :db/id #edb/ref 17592186296256} {:answer/id #uuid "cd13943f-d3e1-5920-9b15-4d7240e4db43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{{e}^{x}}+C" :db/id #edb/ref 17592186296342}] :answer-field/correct {:answer/id #uuid "bc3c34e1-3b8b-568c-889c-57fe85dd59ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{e}^{x}+C" :db/id #edb/ref 17592186296256} :answer-field/id #uuid "b94705d1-73b6-521f-a07d-12831457766a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297018}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f474ed40-025d-552e-9e67-da66415ffc42" :question/math-academy-id "q-31245" :question/problem "$\\int -2{e}^{x}\\,\\text{d}x=$" :question/worked-solution "Factoring out the constant $-2$ and calculating the resulting integral, we get\n\n$$\n\\begin{aligned}\\int -2{e}^{x}\\,\\text{d}x & =-2\\int {e}^{x}\\,\\text{d}x \\\\  & =-2{e}^{x}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297342 :knowledge-point/_questions [{:db/id #edb/ref 17592186064177 :knowledge-point/id #uuid "980bb2fb-4bb5-5cbb-aea8-87010493c013" :knowledge-point/title "Integrating a Sum of Exponential Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ddda862-700e-5259-8a9b-324825fe885d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{x}+\\frac{{3}^{x}}{ln⁡2}+\\frac{{x}^{2}}{3}+C" :db/id #edb/ref 17592186295436} {:answer/id #uuid "3b3aafd2-10f8-5647-aeef-217f0b123766" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{x}-\\frac{{3}^{x}}{ln⁡3}+\\frac{{x}^{3}}{3}+C" :db/id #edb/ref 17592186295606} {:answer/id #uuid "4aaae1a6-c031-5bc5-a104-23401003f961" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{3}^{x}}{ln⁡3}+{x}^{2}+{e}^{x}+C" :db/id #edb/ref 17592186295691} {:answer/id #uuid "531024e5-c103-583c-92eb-e4200ac7a6df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{3x}-\\frac{{3}^{2x}}{ln⁡x}+\\frac{{x}^{2}}{2}+C" :db/id #edb/ref 17592186295744} {:answer/id #uuid "56637843-7c20-5243-80d5-7c1405ee9de3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{2}^{x}}{ln⁡2}+\\frac{{x}^{2}}{2}-3{e}^{x}+C" :db/id #edb/ref 17592186295769}] :answer-field/correct {:answer/id #uuid "3b3aafd2-10f8-5647-aeef-217f0b123766" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{x}-\\frac{{3}^{x}}{ln⁡3}+\\frac{{x}^{3}}{3}+C" :db/id #edb/ref 17592186295606} :answer-field/id #uuid "32505d16-6c49-5e59-9ed0-fdcb1b385a52" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296726}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "42f6b48b-f5fd-5245-b823-ea76a025e943" :question/math-academy-id "q-31252" :question/problem "$\\int (2{e}^{x}-{3}^{x}+{x}^{2})\\,\\text{d}x=$" :question/worked-solution "Here, we combine the sum rule and our exponential rules to get\n\n$$\n\\begin{aligned}\\int (2{e}^{x}-{3}^{x}+{x}^{2})\\,\\text{d}x & =2\\int {e}^{x}\\,\\text{d}x-\\int {3}^{x}\\,\\text{d}x+\\int {x}^{2}\\,\\text{d}x \\\\  & =2{e}^{x}-\\frac{{3}^{x}}{ln⁡3}+\\frac{{x}^{3}}{3}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115727 :knowledge-point/_questions [{:db/id #edb/ref 17592186115190 :knowledge-point/id #uuid "bbb56f0a-ead0-5794-9e33-7fe0e1f87dc6" :knowledge-point/title "Differentiating Expressions Involving the Cosecant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "136ad750-eb9e-5055-a26a-c8cda8dba5ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+6csc⁡xcot⁡x" :db/id #edb/ref 17592186295374} {:answer/id #uuid "1cce689b-d66b-5419-b42f-1c935770579a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-6csc⁡xcot⁡x" :db/id #edb/ref 17592186295433} {:answer/id #uuid "4c7cbd2b-769e-5c2a-8198-1408890da6d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2+6csc⁡xcot⁡x" :db/id #edb/ref 17592186295702} {:answer/id #uuid "be094b01-e8a4-5075-a548-43ad86b83a02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+6csc⁡xcot⁡x" :db/id #edb/ref 17592186296269} {:answer/id #uuid "e0c1681e-054f-5ee6-ac7d-f24a14f0c567" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+6csc⁡xcot⁡x" :db/id #edb/ref 17592186296463}] :answer-field/correct {:answer/id #uuid "e0c1681e-054f-5ee6-ac7d-f24a14f0c567" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+6csc⁡xcot⁡x" :db/id #edb/ref 17592186296463} :answer-field/id #uuid "ed22d9b2-1f65-5896-a2a0-0c98a0de1f14" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297120}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "683c5003-d2ff-5388-892e-f05923834b32" :question/math-academy-id "q-31283" :question/problem "Find ${f}^{′}(x)$ if $f(x)={x}^{2}-6csc⁡x.$" :question/worked-solution "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}-6csc⁡x) \\\\  & =2x-6(-csc⁡xcot⁡x) \\\\  & =2x+6csc⁡xcot⁡x\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186101371 :knowledge-point/_questions [{:db/id #edb/ref 17592186100817 :knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "097bf9be-35d0-5117-aeeb-185f65a4e444" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3\\cdot \\frac{{log}_{2}⁡x}{2}+C" :db/id #edb/ref 17592186295316} {:answer/id #uuid "0c595f3e-4a64-5335-bfee-ef4f9c199d44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡x\\cdot \\frac{{log}_{2}^{2}⁡x}{2}+C" :db/id #edb/ref 17592186295335} {:answer/id #uuid "3a9d8072-eeac-5190-ac53-423bbc5c0d15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\cdot \\frac{{log}_{2}⁡x}{2}+C" :db/id #edb/ref 17592186295602} {:answer/id #uuid "7c854fd3-91d0-5ade-bfec-4aa656855a88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡x\\cdot \\frac{{log}_{2}^{2}⁡x}{x}+C" :db/id #edb/ref 17592186295948} {:answer/id #uuid "943f1ef0-98c7-561c-8c98-1ab90aa0f4c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\cdot \\frac{{log}_{2}^{2}⁡x}{2}+C" :db/id #edb/ref 17592186296059}] :answer-field/correct {:answer/id #uuid "943f1ef0-98c7-561c-8c98-1ab90aa0f4c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\cdot \\frac{{log}_{2}^{2}⁡x}{2}+C" :db/id #edb/ref 17592186296059} :answer-field/id #uuid "94521d82-e55e-520c-aa39-65e9dae6d07e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296944}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bc1950d7-cc9c-5e9a-8f86-5dcc05de2e91" :question/math-academy-id "q-31329" :question/problem "$\\int \\frac{{log}_{2}⁡x}{x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{2}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡2}\\,⟹\\,\\operatorname{ln}⁡2\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{2}⁡x}{x}\\,\\text{d}x & =\\int {log}_{2}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int u\\cdot \\operatorname{ln}⁡2\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2\\int u\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\operatorname{ln}⁡2\\cdot \\frac{{log}_{2}^{2}⁡x}{2}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297368 :knowledge-point/_questions [{:db/id #edb/ref 17592186064282 :knowledge-point/id #uuid "8ef81a0d-5a3a-5d7c-83e9-7d9ed0e8c5c6" :knowledge-point/title "Differentiating a Reciprocal Trigonometric Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "074a9ec9-6bfa-51c3-b293-a2e6c7634c3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186295302} {:answer/id #uuid "3b8e6cf9-9f11-5e02-a08b-b0ce3fd9f2b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186295608} {:answer/id #uuid "64d5cac3-e49f-55a4-a517-b40d5927cff8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186295841} {:answer/id #uuid "748fff53-6b97-5ddb-a2b7-7573ce8fffb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186295904} {:answer/id #uuid "c09b0310-1b57-58cd-bbcf-bbf81a785509" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186296283}] :answer-field/correct {:answer/id #uuid "3b8e6cf9-9f11-5e02-a08b-b0ce3fd9f2b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186295608} :answer-field/id #uuid "67494433-5316-509e-bbfc-ae0d8a99e4af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296848}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8d5db746-ab9b-5b5a-bc25-31e21fc4632d" :question/math-academy-id "q-31338" :question/problem "Find the slope of $f(x)=\\operatorname{cot}⁡(2\\pi -3x)$ at $x=\\frac{\\pi }{2}.$" :question/worked-solution "The slope of $y=f(x)$ at $x=\\frac{\\pi }{2}$ is given by ${f}^{′}(\\frac{\\pi }{2}).$\n\nWe will calculate ${f}^{′}(x)$ using the chain rule. First, we express $f(x)$ as the composite function\n\n$$\nf=\\operatorname{cot}⁡u,\\,u=2\\pi -3x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=-{csc}^{2}⁡u\\,\\text{and}\\,\\frac{\\text{d}u}{\\text{d}x}=-3.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-{csc}^{2}⁡u\\cdot (-3) \\\\  & =3{csc}^{2}⁡(2\\pi -3x).\\end{aligned}\n$$\n\nEvaluating at $x=\\frac{\\pi }{2},$ we find\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(\\frac{\\pi }{2}) & =3{csc}^{2}⁡(2\\pi -\\frac{3\\pi }{2}) \\\\  & =3{csc}^{2}⁡(\\frac{\\pi }{2}) \\\\  & =3\\cdot {1}^{2} \\\\  & =3.\\end{aligned}\\end{aligned}\n$$\n\nTherefore, the slope of $y=f(x)$ at $x=\\frac{\\pi }{2}$ is $3.$"}] [{:db/id #edb/ref 17592186297371 :knowledge-point/_questions [{:db/id #edb/ref 17592186096742 :knowledge-point/id #uuid "f3ee0d5d-0821-5f6b-b613-6b814e65df50" :knowledge-point/title "Calculating a Derivative Using Multiple Instances of the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "143d951a-1e7a-598c-ab01-6ac4eebb972d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20{cot}^{3}⁡1{csc}^{2}⁡1" :db/id #edb/ref 17592186295381} {:answer/id #uuid "80ac022d-2fa2-5312-b6bb-20edccc427c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{cot}^{3}⁡1{sec}^{2}⁡1" :db/id #edb/ref 17592186295959} {:answer/id #uuid "cfd53f52-57a0-58c2-84e5-51e7836dcaa8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4{cot}^{2}⁡1{csc}^{2}⁡1" :db/id #edb/ref 17592186296358} {:answer/id #uuid "df819a99-e827-5e8d-8038-4bdc1f81e2b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20\\operatorname{cot}⁡1{sec}^{2}⁡1" :db/id #edb/ref 17592186296451} {:answer/id #uuid "f7c37201-fff5-5a86-9be9-3c9d741d2eaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4{cot}^{3}⁡1{csc}^{2}⁡1" :db/id #edb/ref 17592186296584}] :answer-field/correct {:answer/id #uuid "143d951a-1e7a-598c-ab01-6ac4eebb972d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20{cot}^{3}⁡1{csc}^{2}⁡1" :db/id #edb/ref 17592186295381} :answer-field/id #uuid "c18783dd-cacf-52c8-94df-17f7aaad8258" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297033}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "60550674-e8b4-5f20-9b57-5b71c82e6894" :question/math-academy-id "q-31361" :question/problem "Find ${f}^{′}(0)$ when $f(x)={cot}^{4}⁡(5x-1).$" :question/worked-solution "First, we express $f$ as the composite function\n\n$$\nf={u}^{4},\\,u=\\operatorname{cot}⁡v,\\,v=5x-1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=4{u}^{3},\\,\\frac{\\text{d}u}{\\text{d}v}=-{csc}^{2}⁡v,\\,\\frac{\\text{d}v}{\\text{d}x}=5.\n$$\n\nApplying now the chain rule twice, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}v}\\cdot \\frac{\\text{d}v}{\\text{d}x} \\\\  & =4{u}^{3}\\cdot (-{csc}^{2}⁡v)\\cdot 5 \\\\  & =4(\\operatorname{cot}⁡(5x-1))^{3}\\cdot (-{csc}^{2}⁡(5x-1))\\cdot 5 \\\\  & =-20{cot}^{3}⁡(5x-1){csc}^{2}⁡(5x-1)\\end{aligned}\n$$\n\nNow we compute ${f}^{′}(0):$\n\n$$\n\\begin{aligned}{f}^{′}(0) & =-20{cot}^{3}⁡(5(0)-1){csc}^{2}⁡(5(0)-1) \\\\  & =-20{cot}^{3}⁡(-1){csc}^{2}⁡(-1) \\\\  & =-20(-{cot}^{3}⁡1){csc}^{2}⁡1 \\\\  & =20{cot}^{3}⁡1{csc}^{2}⁡1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297382 :knowledge-point/_questions [{:db/id #edb/ref 17592186100816 :knowledge-point/id #uuid "41b7d83f-3b9b-556c-9e49-13df9c3b597e" :knowledge-point/title "Integrating Functions Containing the Natural Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dae15a2-1ee3-5e1c-9740-88dbcb27308a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}{ln}^{2}⁡x+C" :db/id #edb/ref 17592186295346} {:answer/id #uuid "21c52b8f-99f3-501e-b48b-11fa940e47fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{9}\\sqrt{{ln}^{3}⁡x}+C" :db/id #edb/ref 17592186295455} {:answer/id #uuid "8339edfa-ac01-5a35-ba61-f72d13beb9e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{9}\\sqrt{\\operatorname{ln}⁡x}+C" :db/id #edb/ref 17592186295971} {:answer/id #uuid "afde279f-b6c5-5153-a7ee-1486db54540c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{9}{ln}^{3}⁡x+C" :db/id #edb/ref 17592186296193} {:answer/id #uuid "eaf9ca14-d6e0-59ec-bd95-95f8ca1bf1d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}\\sqrt{{ln}^{3}⁡x}+C" :db/id #edb/ref 17592186296516}] :answer-field/correct {:answer/id #uuid "21c52b8f-99f3-501e-b48b-11fa940e47fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{9}\\sqrt{{ln}^{3}⁡x}+C" :db/id #edb/ref 17592186295455} :answer-field/id #uuid "15bc6d3f-2f78-5fec-acf5-1f972668822a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296677}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7cf9e06a-68e3-56b4-9085-33ef355832a1" :question/math-academy-id "q-31398" :question/problem "Calculate the integral $\\int \\frac{\\sqrt{\\operatorname{ln}⁡x}}{3x}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{\\sqrt{\\operatorname{ln}⁡x}}{3x}\\,\\text{d}x & =\\frac{1}{3}\\int \\sqrt{\\operatorname{ln}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{3}\\int \\sqrt{u}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\int {u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\cdot \\frac{2{u}^{3/2}}{3}+C \\\\  & =\\frac{2}{9}{u}^{3/2}+C \\\\  & =\\frac{2}{9}\\sqrt{{ln}^{3}⁡x}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186101374 :knowledge-point/_questions [{:db/id #edb/ref 17592186100817 :knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27327c99-efb7-58e8-a74e-787cf861a36a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2{log}_{2}^{2}⁡({x}^{2})}{4}+C" :db/id #edb/ref 17592186295482} {:answer/id #uuid "87c24d2f-2c74-5040-90ac-f36195ad44b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡3{log}_{3}^{2}⁡({x}^{2})}{4}+C" :db/id #edb/ref 17592186295999} {:answer/id #uuid "9bd76f53-ed5e-50ea-9b0a-4825cbde5b04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡x{log}_{3}^{2}⁡x}{4}+C" :db/id #edb/ref 17592186296097} {:answer/id #uuid "cee39ee1-4f54-5380-b841-9cb4997a9fd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡({x}^{2}){log}_{3}^{2}⁡({x}^{2})}{2}+C" :db/id #edb/ref 17592186296353} {:answer/id #uuid "e80a0ef7-8043-5002-b2dc-df0cdf73346a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡3{log}_{3}^{2}⁡({x}^{2})}{2}+C" :db/id #edb/ref 17592186296500}] :answer-field/correct {:answer/id #uuid "87c24d2f-2c74-5040-90ac-f36195ad44b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡3{log}_{3}^{2}⁡({x}^{2})}{4}+C" :db/id #edb/ref 17592186295999} :answer-field/id #uuid "91e8e1d5-6ca1-583b-a916-cb7fac5a8d3c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296934}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d8e9ea16-ddaf-5f82-ac82-079325b04f6b" :question/math-academy-id "q-31401" :question/problem "$\\int \\frac{{log}_{3}⁡({x}^{2})}{x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{3}⁡({x}^{2}).$Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{2}{x\\operatorname{ln}⁡3}\\,⟹\\,\\frac{\\operatorname{ln}⁡3}{2}\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{3}⁡({x}^{2})}{x}\\,\\text{d}x & =\\int {log}_{3}⁡({x}^{2})\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int u\\cdot (\\frac{\\operatorname{ln}⁡3}{2}\\,\\text{d}u) \\\\  & =\\frac{\\operatorname{ln}⁡3}{2}\\int u\\cdot \\text{d}u \\\\  & =\\frac{\\operatorname{ln}⁡3}{2}\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\frac{\\operatorname{ln}⁡3{log}_{3}^{2}⁡({x}^{2})}{4}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297386 :knowledge-point/_questions [{:db/id #edb/ref 17592186100817 :knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26cf2f12-d9f3-59fd-be22-70990f0c064c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡({x}^{3})|+C" :db/id #edb/ref 17592186295477} {:answer/id #uuid "32474011-c0eb-5c98-b028-863b8f17da19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3\\operatorname{ln}⁡|{log}_{5}⁡x|+C" :db/id #edb/ref 17592186295550} {:answer/id #uuid "8b40389e-34eb-5524-b04f-3adc8016457b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡({x}^{5})\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186296008} {:answer/id #uuid "a5006fea-9435-5ebd-a15e-7ec4fb282356" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡5}{5}\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186296137} {:answer/id #uuid "e0893163-fbac-5102-8d54-6ed75f43ac2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186296461}] :answer-field/correct {:answer/id #uuid "e0893163-fbac-5102-8d54-6ed75f43ac2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186296461} :answer-field/id #uuid "c59c5853-4a44-56f0-94bb-09e77fa03053" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297042}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f906b7ab-49ff-57e2-8ffb-323870b5ae05" :question/math-academy-id "q-31402" :question/problem "$\\int \\frac{2}{x{log}_{5}⁡(3x)}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{5}⁡(3x).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡5}\\,⟹\\,\\operatorname{ln}⁡5\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{2}{x{log}_{5}⁡(3x)}\\,\\text{d}x & =2\\int \\frac{1}{{log}_{5}⁡(3x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =2\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡5\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡5\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =2\\operatorname{ln}⁡5\\operatorname{ln}⁡|u|+C \\\\  & =2\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297389 :knowledge-point/_questions [{:db/id #edb/ref 17592186096656 :knowledge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9" :knowledge-point/title "Integrating a General Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e3c76b3-9a7e-5c31-b43e-02f9be81294d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{5}^{-x}}{\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186295533} {:answer/id #uuid "4ee811f8-8af9-53fa-be26-778f4f77cd67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{5}^{-x}+C" :db/id #edb/ref 17592186295722} {:answer/id #uuid "57a67b0f-0c05-5b5a-b5ea-792d6c56a440" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{5}^{x}}{\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186295773} {:answer/id #uuid "5de84312-4ff6-5203-8c07-5a2dbc5c4c3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{5}^{-x}}{\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186295809} {:answer/id #uuid "c521dc80-7e50-540f-93b7-e321d21cdb8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{5}^{x}}{\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186296307}] :answer-field/correct {:answer/id #uuid "2e3c76b3-9a7e-5c31-b43e-02f9be81294d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{5}^{-x}}{\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186295533} :answer-field/id #uuid "4944a858-6895-5891-aed1-aabff8de8a8c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296769}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "91e61cac-e373-57ad-92b8-00ce9bccf78c" :question/math-academy-id "q-31412" :question/problem "$\\int {5}^{-x}\\,\\text{d}x=$" :question/worked-solution "If we let $u=-x$, then \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-1\\,⟹\\,-\\text{d}u=\\text{d}x.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {5}^{-x}\\,\\text{d}x & =\\int {5}^{u}\\cdot (-1)\\,\\text{d}u \\\\  & =-\\int {5}^{u}\\,\\text{d}u \\\\  & =-\\frac{{5}^{u}}{\\operatorname{ln}⁡5}+C \\\\  & =-\\frac{{5}^{-x}}{\\operatorname{ln}⁡5}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297396 :knowledge-point/_questions [{:db/id #edb/ref 17592186096656 :knowledge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9" :knowledge-point/title "Integrating a General Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1277c0e2-5004-5ee3-b7fe-7022e68c6a19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{6}^{x}}{3\\operatorname{ln}⁡6}+C" :db/id #edb/ref 17592186295368} {:answer/id #uuid "7cdefd48-2695-5a38-8f5d-ed070355571e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{6}^{x/3}}{3\\operatorname{ln}⁡6}+C" :db/id #edb/ref 17592186295950} {:answer/id #uuid "cd384b9e-3f21-5c93-8eef-f209d288044d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\cdot {6}^{x/3}}{\\operatorname{ln}⁡6}+C" :db/id #edb/ref 17592186296343} {:answer/id #uuid "d8ca43b4-033c-5cd0-a8a6-8ea7eb292ebc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\cdot {6}^{x}}{\\operatorname{ln}⁡3}+C" :db/id #edb/ref 17592186296410} {:answer/id #uuid "e19fa8a4-2ede-5cc9-a74c-dbb6cdba1380" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{6}^{x/3}}{\\operatorname{ln}⁡3}+C" :db/id #edb/ref 17592186296468}] :answer-field/correct {:answer/id #uuid "cd384b9e-3f21-5c93-8eef-f209d288044d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\cdot {6}^{x/3}}{\\operatorname{ln}⁡6}+C" :db/id #edb/ref 17592186296343} :answer-field/id #uuid "1db9f319-6a3e-51d1-bbc2-fd789260b0da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296690}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4a2ea8a4-727a-5496-81cd-8ee505de6239" :question/math-academy-id "q-31417" :question/problem "$\\int {6}^{x/3}\\,\\text{d}x=$" :question/worked-solution "If we let $u=\\frac{x}{3},$ then,\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3}\\,⟹\\,\\text{d}x=3\\text{d}u.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {6}^{x/3}\\,\\text{d}x & =\\int {6}^{u}\\cdot 3\\,\\text{d}u \\\\  & =3\\int {6}^{u}\\,\\text{d}u \\\\  & =3\\frac{{6}^{u}}{\\operatorname{ln}⁡6}+C \\\\  & =\\frac{3\\cdot {6}^{x/3}}{\\operatorname{ln}⁡6}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184746 :knowledge-point/_questions [{:db/id #edb/ref 17592186184350 :knowledge-point/id #uuid "e8720b44-317d-590e-a251-bfcec97e0513" :knowledge-point/title "Integrating Products Containing Other Exponential Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82507a0e-9640-5f91-baac-ab6e9c5da3e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{8}^{3x}}{2\\operatorname{ln}⁡8}+C" :db/id #edb/ref 17592186295968} {:answer/id #uuid "90098dd5-289f-547e-b363-0c0f0a9af66e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{8}^{3{x}^{2}}}{\\operatorname{ln}⁡8}+C" :db/id #edb/ref 17592186296038} {:answer/id #uuid "b0881961-d42a-52bd-baff-db91f2644d0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{8}^{3{x}^{2}}}{3\\operatorname{ln}⁡8}+C" :db/id #edb/ref 17592186296198} {:answer/id #uuid "bd10d05c-0dcf-50d3-bed0-8065b29b1c8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x{8}^{3{x}^{2}}}{6\\operatorname{ln}⁡8}+C" :db/id #edb/ref 17592186296263} {:answer/id #uuid "ddd37029-5f4f-5d4c-b32f-36f0f45b0933" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{8}^{3{x}^{2}}}{6\\operatorname{ln}⁡8}+C" :db/id #edb/ref 17592186296446}] :answer-field/correct {:answer/id #uuid "ddd37029-5f4f-5d4c-b32f-36f0f45b0933" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{8}^{3{x}^{2}}}{6\\operatorname{ln}⁡8}+C" :db/id #edb/ref 17592186296446} :answer-field/id #uuid "f130d306-f973-5ac4-a801-416349e0b6ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297127}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a383a3e5-774c-580f-ac7a-6d64870e5f9c" :question/math-academy-id "q-31420" :question/problem "Calculate the integral $\\int x{8}^{3{x}^{2}}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u=3{x}^{2}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6x\\,⟹\\,\\frac{1}{6}\\text{d}u=x\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int x{8}^{3{x}^{2}}\\,\\text{d}x & =\\int {8}^{3{x}^{2}}\\cdot x\\,\\text{d}x \\\\  & =\\int {8}^{u}\\cdot \\frac{1}{6}\\,\\text{d}u \\\\  & =\\frac{1}{6}\\int {8}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{6}\\frac{{8}^{u}}{\\operatorname{ln}⁡8}+C \\\\  & =\\frac{{8}^{3{x}^{2}}}{6\\operatorname{ln}⁡8}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069235 :knowledge-point/_questions [{:db/id #edb/ref 17592186068830 :knowledge-point/id #uuid "617f0fe6-7998-5d77-b11f-55a0eca11440" :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84ebbe2d-74ec-5380-9a07-702d026d313d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/73/73590d55299fc519582252723f34bfa143818da7f03a16f7aeb8d208217ee3d4.png" :db/id #edb/ref 17592186066589} {:answer/id #uuid "00accd83-f7f9-57bb-aa6e-78f38f349bb6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b5/b53396e5736d8e09a11acef07594950ee50a0c027e190f0c8eb85880cf721494.png" :db/id #edb/ref 17592186066590} {:answer/id #uuid "0e7e45dc-8e5a-5e38-a11e-07a10f544e45" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c8/c8652694c97439511e4098e2b8f3d9d1e9727d9953d32348164c3ff7f741f22c.png" :db/id #edb/ref 17592186066591} {:answer/id #uuid "319a2339-b438-5f58-b459-e90c8e2d9866" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a8/a84109a9d68fe4b185ede5ab47c8ea2c07acd609367b629b594ab0b8e415bc82.png" :db/id #edb/ref 17592186066592} {:answer/id #uuid "7941c9a0-4881-5921-a1a9-38e914122b39" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7e/7e457f65868b58c9246d17744317ad6f76a96c8bd3b024f4fe2d37523a6490fa.png" :db/id #edb/ref 17592186066593}] :answer-field/id #uuid "375a8c1c-ecfc-5e8e-99de-762874c0a19a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186066588} {:answer-field/choices [{:answer/id #uuid "f871c9fe-ce5c-57e0-b3ab-1c1c8b065a12" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b5/b53396e5736d8e09a11acef07594950ee50a0c027e190f0c8eb85880cf721494.png" :db/id #edb/ref 17592186390607} {:answer/id #uuid "3dfaa41c-4be2-5d25-a838-46703edf0110" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a8/a84109a9d68fe4b185ede5ab47c8ea2c07acd609367b629b594ab0b8e415bc82.png" :db/id #edb/ref 17592186390608} {:answer/id #uuid "857c287c-8899-5fbc-b5f9-5a9ea6523a2e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7e/7e457f65868b58c9246d17744317ad6f76a96c8bd3b024f4fe2d37523a6490fa.png" :db/id #edb/ref 17592186390609} {:answer/id #uuid "b422f31c-7ac6-593f-9a66-3623920a036a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/73/73590d55299fc519582252723f34bfa143818da7f03a16f7aeb8d208217ee3d4.png" :db/id #edb/ref 17592186390610} {:answer/id #uuid "e921280b-88b6-51bc-a473-f6af4ac53ca8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c8/c8652694c97439511e4098e2b8f3d9d1e9727d9953d32348164c3ff7f741f22c.png" :db/id #edb/ref 17592186390611}] :answer-field/correct {:answer/id #uuid "e921280b-88b6-51bc-a473-f6af4ac53ca8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c8/c8652694c97439511e4098e2b8f3d9d1e9727d9953d32348164c3ff7f741f22c.png" :db/id #edb/ref 17592186390611} :answer-field/id #uuid "3f6f078f-4b80-5f34-98d4-3100f6b4d2cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390606}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3af553bc-4342-536e-bf61-1a65d8389d56" :question/math-academy-id "q-31424" :question/problem "Which of the following is the graph of $y=4{(\\frac{1}{2})}^{x}-2?$" :question/worked-solution "First, we plot the graph of $y={(\\frac{1}{2})}^{x}:$\n\n![](images/41/4100e1298857ca36288dc390501fc69dfa68fd13303101d21691d3b056f3365e.png)\n\nNext, we plot the graph of $y=4{(\\frac{1}{2})}^{x}.$ To do this, we scale the graph above by a factor of $4.$ The $y$-intercept moves from $(0,1)$ to $(0,4)$ but the horizontal asymptote stays at $y=0.$\n\n![](images/37/37bb36e82a659fc52e02f2fe2aa3bdfdc11737af467db62b4694c9b63ee4ae6e.png)\n\nFinally, we plot the graph of $y=4{(\\frac{1}{2})}^{x}-2.$ To do this, we shift the above graph $2$ units down. The $y$-intercept moves from $(0,4)$ to $(0,2)$ and the horizontal asymptote moves from $y=0$ to $y=-2.$\n\n![](images/c8/c8652694c97439511e4098e2b8f3d9d1e9727d9953d32348164c3ff7f741f22c.png)"}] [{:db/id #edb/ref 17592186297401 :knowledge-point/_questions [{:db/id #edb/ref 17592186068831 :knowledge-point/id #uuid "cc402a1d-e538-5510-8a6f-79dd1626ff1f" :knowledge-point/title "Identifying the Shift and Stretch Applied to an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a1c47f7-5b8c-5177-997f-9c9709da23dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186295599} {:answer/id #uuid "4e3cb064-2eaf-5f92-9194-de89c9125599" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186295717} {:answer/id #uuid "7b75ed7d-abd8-526c-8c58-6405c2b625a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186295942} {:answer/id #uuid "d96c6138-85f4-575a-bbd3-c78b6c063670" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186296413} {:answer/id #uuid "f51945cd-cb43-5802-a043-9d995443a3f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186296565}] :answer-field/correct {:answer/id #uuid "3a1c47f7-5b8c-5177-997f-9c9709da23dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186295599} :answer-field/id #uuid "c9d0e6b0-fcd1-5675-b95f-02f242a5a3ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297051}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7b52cd54-7f7c-57a1-892c-73badca0d5f6" :question/math-academy-id "q-31435" :question/problem "![](images/01/016286e82482af83783f0eef6361591861b564643d4d9f010f2b82999fcaad27.png)\n\nThe graph above shows $y=k{(\\frac{1}{3})}^{x}+c.$ Find the value of $k-c.$" :question/worked-solution "The horizontal asymptote of the curve $y=k{(\\frac{1}{3})}^{x}+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=-4.$ Hence, $c=-4.$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ The labeled point on the graph is $(0,-2),$ so we substitute $x=0$ and $y=-2$ into the function and solve for $k:$\n\n$$\n\\begin{aligned}k{(\\frac{1}{3})}^{x}+c & =y \\\\ k{(\\frac{1}{3})}^{x}-4 & =y \\\\ k{(\\frac{1}{3})}^{0}-4 & =-2 \\\\ k-4 & =-2 \\\\ k & =2\\end{aligned}\n$$\n\nTherefore,\n\n$$\nk-c=2-(-4)=6.\n$$\n\nThe equation of the curve is $y=2{(\\frac{1}{3})}^{x}-4.$"}] [{:db/id #edb/ref 17592186297402 :knowledge-point/_questions [{:db/id #edb/ref 17592186068769 :knowledge-point/id #uuid "8fa1bebf-4af0-5a5c-962c-8a88f8392776" :knowledge-point/title "Calculating the Area Between Two Curves Expressed as Functions of X"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18309ac9-f513-556f-b337-ba3a246cb6cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186295410} {:answer/id #uuid "54af7204-8617-58c0-b99c-62cceb31ce44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186295756} {:answer/id #uuid "73a3360c-ea84-5190-b608-15da107f4283" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{27}{2}" :db/id #edb/ref 17592186295900} {:answer/id #uuid "8ead18ad-43a0-5380-bd6e-cfbd3694845f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{2}" :db/id #edb/ref 17592186296027} {:answer/id #uuid "d796e37b-e7df-5f38-be96-9b9936b222a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186296403}] :answer-field/correct {:answer/id #uuid "18309ac9-f513-556f-b337-ba3a246cb6cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186295410} :answer-field/id #uuid "06900e27-2400-5334-ba59-9c36ba5a30cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296653}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "96033acd-67cd-543b-8482-d4f4d5a08b94" :question/math-academy-id "q-3146" :question/problem "![](images/c6/c61d9140e5b8e57c8f75b532c6e26e22faa073e6631984a8f6a7b6f4280882e3.png)\n\nFind the area of the finite region enclosed between $y={x}^{2}+4x$ and $y=x,$ shown above.\n\n*(Note: Figure not drawn to scale)*" :question/worked-solution "First, we want to determine the limits of integration. To do this, we equate the two functions and solve for $x:$\n\n$$\n\\begin{aligned}{x}^{2}+4x & =x \\\\ {x}^{2}+3x & =0 \\\\ x(x+3) & =0\\end{aligned}\n$$\n\nHence, we need to integrate from $x=-3$ to $x=0.$\n\nTo determine which is the lower function and which is the upper, we draw our vertical arrow.\n\n![](images/6b/6b2232d5a2853b22c731c317b365822e371f3d419bfcb3e528a07f211a372553.png)\n\nThe vertical line \n\n- *enters* the region through the lower function $y={x}^{2}+4x,$ and\n\n- *leaves* through the upper function $y=x.$\n\nTherefore, the integral that gives our area is\n\n$$\n\\begin{aligned}A & ={\\int }_{-3}^{0}[\\,(\\text{upper function})-(\\text{lower function})\\,]\\text{d}x \\\\  & ={\\int }_{-3}^{0}[\\,(x)-({x}^{2}+4x)\\,]\\,\\text{d}x \\\\  & ={\\int }_{-3}^{0}(-{x}^{2}-3x)\\,\\text{d}x \\\\  & ={(-\\frac{1}{3}{x}^{3}-\\frac{3}{2}{x}^{2})|}_{-3}^{0} \\\\  & =[-\\frac{1}{3}\\cdot {0}^{3}-\\frac{3}{2}\\cdot {0}^{2}]-[-\\frac{1}{3}\\cdot (-3)^{3}-\\frac{3}{2}\\cdot (-3)^{2}] \\\\  & =(0)-(9-\\frac{27}{2}) \\\\  & =\\frac{9}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186390612 :knowledge-point/_questions [{:db/id #edb/ref 17592186217152 :knowledge-point/id #uuid "5fa86dd3-3bb3-54d5-8940-5dc07ae4c99f" :knowledge-point/title "Exponential Growth Functions With Horizontal and Vertical Shifts"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a493a343-cedc-5d8f-9bbe-1e7273fa7dfd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bc/bc5062f2d2417f9be862cf10e152080370413daa34b28965a8f5ac597e3608a1.png" :db/id #edb/ref 17592186390614} {:answer/id #uuid "07209a50-0363-5ab2-a02e-e6fe06b321ca" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/11/1127119b14566e32135f9e36f0d5835f7413a6643fb2c2732df8dde8a0d23155.png" :db/id #edb/ref 17592186390615} {:answer/id #uuid "26ff6fbb-9297-546a-a4e0-d5027677f3a1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b6/b669aa5f756a95886182ef6d71c06fc3322192d52f18755603ef3dead48ee309.png" :db/id #edb/ref 17592186390616} {:answer/id #uuid "0438fb29-1028-5793-87c0-c7136ac83426" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/4c/4c65c1b20467750125f3e25eb598544d4134d353c72e8bd60b48556d995fa2c7.png" :db/id #edb/ref 17592186390617} {:answer/id #uuid "7931e126-f2fe-5703-b148-0ffbf0470e2b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/55/559d2a03eeafc73b1ed1c8e98cb7380ea4ed0e956addfee31ed7412632133e80.png" :db/id #edb/ref 17592186390618}] :answer-field/correct {:answer/id #uuid "a493a343-cedc-5d8f-9bbe-1e7273fa7dfd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bc/bc5062f2d2417f9be862cf10e152080370413daa34b28965a8f5ac597e3608a1.png" :db/id #edb/ref 17592186390614} :answer-field/id #uuid "03c22286-7565-5727-9f06-a11ad4db1ba3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390613}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3271be04-4d4e-529b-98e8-aeb7a846817c" :question/math-academy-id "q-31468" :question/problem "Which of the following is the graph of $y={3}^{x+5}-4?$" :question/worked-solution "To plot the given function, we follow these steps:\n\n- First, we plot the graph of $y={3}^{x}.$\n\n![](images/56/56f4446a00c12419f722dfd008e3cde785e759aa037fedd47911f0a783f4dfed.png)\n\n- To plot $y={3}^{x+5},$ we shift the graph of $y={3}^{x}$ horizontally by $5$ units to the left. The $y$-intercept moves from $(0,1)$ to $(-5,1),$ but the horizontal asymptote stays at $y=0.$\n\n![](images/87/871fe4053ba868f475ded7f0722ab7df20636a4db743f10c7631dede279715f1.png)\n\n- To plot $y={3}^{x+5}-4,$ we shift the graph of $y={3}^{x+5}$ vertically by $4$ units down. The point $(-5,1)$ moves to $(-5,-3)$ and the horizontal asymptote moves from $y=0$ to $y=-4.$\n\n![](images/32/3278d9e3e73ffee57ece6d0abf3343f8315c729e694f111dacef0e759dbe4ab4.png)"}] [{:db/id #edb/ref 17592186297410 :knowledge-point/_questions [{:db/id #edb/ref 17592186184351 :knowledge-point/id #uuid "ed3b6c3d-b840-50ef-9e6b-584bf14877b3" :knowledge-point/title "More Complex Cases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "398d7153-dd3c-5a82-b5a4-cae2a584156a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5x}{\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186295595} {:answer/id #uuid "4ca4abb9-0851-5c3b-9177-0dd90d8d8845" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡({5}^{x}+1)}{\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186295704} {:answer/id #uuid "7a287bc3-0892-5d93-8218-78604cf894d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\operatorname{ln}⁡({5}^{x}+1)}{\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186295934} {:answer/id #uuid "7ef3b95e-bd1a-57ef-8fe5-5cd8afb14244" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{5}^{x}\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186295954} {:answer/id #uuid "af23df45-3861-5a0d-ac36-df9c438d8eb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡({5}^{x}+1)}{5\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186296190}] :answer-field/correct {:answer/id #uuid "4ca4abb9-0851-5c3b-9177-0dd90d8d8845" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡({5}^{x}+1)}{\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186295704} :answer-field/id #uuid "04a5f69b-9de4-5df4-950b-038dd6a88814" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296647}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cb025f0b-ba4d-525b-a215-9bdb02362821" :question/math-academy-id "q-31478" :question/problem "Calculate the integral $\\int \\frac{{5}^{x}}{{5}^{x}+1}\\,\\text{d}x.$" :question/worked-solution "Notice that the numerator is proportional to the derivative of the denominator. So, we introduce the new variable $u={5}^{x}+1.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}={5}^{x}\\operatorname{ln}⁡5\\,⟹\\,\\frac{1}{\\operatorname{ln}⁡5}\\,\\text{d}u={5}^{x}\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{{5}^{x}}{{5}^{x}+1}\\,\\text{d}x & =\\int \\frac{1}{{5}^{x}+1}\\cdot {5}^{x}\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\cdot \\frac{1}{\\operatorname{ln}⁡5}\\,\\text{d}u \\\\  & =\\frac{1}{\\operatorname{ln}⁡5}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{\\operatorname{ln}⁡5}\\cdot \\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{\\operatorname{ln}⁡5}\\cdot \\operatorname{ln}⁡|{5}^{x}+1|+C \\\\  & =\\frac{\\operatorname{ln}⁡({5}^{x}+1)}{\\operatorname{ln}⁡5}+C.\\end{aligned}\n$$\n\nNotice that, in the last step, we used the fact that ${5}^{x}+1>0$ for all $x.$"}] [{:db/id #edb/ref 17592186297411 :knowledge-point/_questions [{:db/id #edb/ref 17592186184351 :knowledge-point/id #uuid "ed3b6c3d-b840-50ef-9e6b-584bf14877b3" :knowledge-point/title "More Complex Cases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07618f82-80dd-5c73-b8a4-2164bc070f03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡({4}^{x})}{\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186295304} {:answer/id #uuid "7fabc313-b7ec-5fea-8e37-3c5a06d43177" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{4}^{x}\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186295957} {:answer/id #uuid "872590b5-df6d-5e6e-9dc4-79994e14eb92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡({4}^{x}+2)}{4\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186295994} {:answer/id #uuid "ac13f248-7d32-5d3e-b31a-bf1601844a70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡({4}^{x}+2)}{\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186296173} {:answer/id #uuid "b29969af-ede3-53c4-a306-057c9ce68656" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\operatorname{ln}⁡({4}^{x}+2)}{\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186296208}] :answer-field/correct {:answer/id #uuid "ac13f248-7d32-5d3e-b31a-bf1601844a70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡({4}^{x}+2)}{\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186296173} :answer-field/id #uuid "7f35bb0c-6a4b-5fe9-b22b-03be76e5104e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296892}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fa16c83a-9f14-57ce-8cd3-45bb3a59d16f" :question/math-academy-id "q-31480" :question/problem "Calculate the integral $\\int \\frac{{4}^{x}}{{4}^{x}+2}\\,\\text{d}x.$" :question/worked-solution "Notice that the numerator is proportional to the derivative of the denominator. So, we introduce the new variable $u={4}^{x}+2.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}={4}^{x}\\operatorname{ln}⁡4\\,⟹\\,\\frac{1}{\\operatorname{ln}⁡4}\\,\\text{d}u={4}^{x}\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{{4}^{x}}{{4}^{x}+2}\\,\\text{d}x & =\\int \\frac{1}{{4}^{x}+2}\\cdot {4}^{x}\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\cdot \\frac{1}{\\operatorname{ln}⁡4}\\,\\text{d}u \\\\  & =\\frac{1}{\\operatorname{ln}⁡4}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{\\operatorname{ln}⁡4}\\cdot \\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{\\operatorname{ln}⁡4}\\cdot \\operatorname{ln}⁡|{4}^{x}+2|+C \\\\  & =\\frac{\\operatorname{ln}⁡({4}^{x}+2)}{\\operatorname{ln}⁡4}+C.\\end{aligned}\n$$\n\nNotice that, in the last step, we used the fact that ${4}^{x}+2>0$ for all $x.$"}] [{:db/id #edb/ref 17592186297417 :knowledge-point/_questions [{:db/id #edb/ref 17592186068691 :knowledge-point/id #uuid "aeebf57f-21dc-558a-bec5-4e97a5b26de4" :knowledge-point/title "Calculating a Limit at Positive or Negative Infinity Using L'Hopital's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "169ba8d5-e22c-50d2-9733-e76f465346c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186295401} {:answer/id #uuid "358520ce-be66-5f40-8a5d-895602d02530" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186295568} {:answer/id #uuid "38549704-6a61-553b-a029-2c376582ae9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186295584} {:answer/id #uuid "6986393b-a4fa-50a9-8106-363feaca3624" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186295859} {:answer/id #uuid "7f9c92c9-e91d-5425-a408-be18f6225423" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186295956}] :answer-field/correct {:answer/id #uuid "169ba8d5-e22c-50d2-9733-e76f465346c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186295401} :answer-field/id #uuid "7f3a5154-fd03-5ed7-b3ff-94e6906bb61f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296893}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6c446587-25a8-5d97-80ba-a22c604d7eae" :question/math-academy-id "q-31517" :question/problem "${lim}_{x\\to \\infty }\\frac{x\\operatorname{ln}⁡x}{{e}^{x}}=$" :question/worked-solution "In this case, we have an indeterminate form of type $\\frac{\\infty }{\\infty },$ so applying  L'Hopital's rule yields\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{x\\operatorname{ln}⁡x}{{e}^{x}} & ={lim}_{x\\to \\infty }\\frac{[x\\operatorname{ln}⁡x]^{′}}{[{e}^{x}]^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{\\operatorname{ln}⁡x+1}{{e}^{x}}.\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{\\infty }{\\infty }.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{x\\operatorname{ln}⁡x}{{e}^{x}} & ={lim}_{x\\to \\infty }\\frac{\\operatorname{ln}⁡x+1}{{e}^{x}} \\\\  & ={lim}_{x\\to \\infty }\\frac{[\\operatorname{ln}⁡x+1]^{′}}{[{e}^{x}]^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{1}{x})}{{e}^{x}} \\\\  & ={lim}_{x\\to \\infty }\\frac{1}{x{e}^{x}} \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297433 :knowledge-point/_questions [{:db/id #edb/ref 17592186068689 :knowledge-point/id #uuid "8a41d750-ffd9-5226-9bd7-b763575870c1" :knowledge-point/title "Calculating a Limit Using L'Hopital's Rule Twice"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46f99c12-e2f9-5bbc-804a-fa6dbea402f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186295671} {:answer/id #uuid "a7fd8836-9ef9-50e6-ab47-8bc75a539eff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186296149} {:answer/id #uuid "dbac7023-de8d-5f5e-b480-a33d75ec67c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186296428} {:answer/id #uuid "dd1b19fb-47bf-5919-90be-4861012ba575" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186296440} {:answer/id #uuid "efd30ef0-92ff-547d-a344-ece6965c1205" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186296544}] :answer-field/correct {:answer/id #uuid "a7fd8836-9ef9-50e6-ab47-8bc75a539eff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186296149} :answer-field/id #uuid "90913f38-64a8-546f-a20c-a3107409ac5e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296931}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dc410ce1-0fb1-54b6-a7ff-4bcc2c871ce4" :question/math-academy-id "q-31585" :question/problem "${lim}_{x\\to 0}\\frac{{e}^{x}-x-1}{\\operatorname{cos}⁡x-1}=$" :question/worked-solution "If we plug in $x=0$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{e}^{x}-x-1}{\\operatorname{cos}⁡x-1} & ={lim}_{x\\to 0}\\frac{[{e}^{x}-x-1]^{′}}{[\\operatorname{cos}⁡x-1]^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{{e}^{x}-1}{-\\operatorname{sin}⁡x} \\\\  & =-{lim}_{x\\to 0}\\frac{{e}^{x}-1}{\\operatorname{sin}⁡x}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{e}^{x}-x-1}{\\operatorname{cos}⁡x-1} & =-{lim}_{x\\to 0}\\frac{{e}^{x}-1}{\\operatorname{sin}⁡x} \\\\  & =-{lim}_{x\\to 0}\\frac{[{e}^{x}-1]^{′}}{[\\operatorname{sin}⁡x]^{′}} \\\\  & =-{lim}_{x\\to 0}\\frac{{e}^{x}}{\\operatorname{cos}⁡x} \\\\  & =-\\frac{{e}^{0}}{\\operatorname{cos}⁡0} \\\\  & =-\\frac{1}{1} \\\\  & =-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297438 :knowledge-point/_questions [{:db/id #edb/ref 17592186068688 :knowledge-point/id #uuid "33f9c59a-257d-52f2-ab08-6986d283c94a" :knowledge-point/title "Calculating a Limit Using L'Hopital's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43669ea8-4439-5c52-932e-09963c9aed69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186295646} {:answer/id #uuid "68ac4fcc-e9cd-56f7-9ba5-512586a67a7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186295855} {:answer/id #uuid "90f6ca85-5f26-52db-bbfc-d1f9279260bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186296045} {:answer/id #uuid "b0e455bc-7676-59e0-8421-fc92303b6dec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186296199} {:answer/id #uuid "f0c847f9-8cd7-5aad-ae9b-9ef397a14e1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186296549}] :answer-field/correct {:answer/id #uuid "f0c847f9-8cd7-5aad-ae9b-9ef397a14e1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186296549} :answer-field/id #uuid "fe39cd51-4508-5a79-ba59-d1e9f1443e16" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297155}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e847ac9b-6147-5e36-9747-365456716188" :question/math-academy-id "q-31600" :question/problem "${lim}_{x\\to -1}\\frac{x\\operatorname{ln}⁡(x+2)}{{x}^{2}+3x+2}=$" :question/worked-solution "Note that plugging in $x=-1$ gives the indeterminate form $\\frac{0}{0}.$ However, we can use L'Hopital's rule to find this limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to -1}\\frac{x\\operatorname{ln}⁡(x+2)}{{x}^{2}+3x+2} & ={lim}_{x\\to -1}\\frac{[x\\operatorname{ln}⁡(x+2)]^{′}}{[{x}^{2}+3x+2]^{′}} \\\\  & ={lim}_{x\\to -1}\\frac{(\\operatorname{ln}⁡(x+2)+\\frac{x}{x+2})}{2x+3} \\\\  & =\\frac{(\\operatorname{ln}⁡(-1+2)+\\frac{-1}{-1+2})}{2(-1)+3} \\\\  & =\\frac{\\operatorname{ln}⁡(1)-1}{1} \\\\  & =-1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186390632 :knowledge-point/_questions [{:db/id #edb/ref 17592186129218 :knowledge-point/id #uuid "798800a5-255a-5738-91d2-21c2a78e4fb5" :knowledge-point/title "Identifying Quadrants Where a Function Is Positive or Negative Using a Sign Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9182a711-51cf-5310-bbf4-9cbe0a46a666" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186390634} {:answer/id #uuid "d9f189a3-37d9-5f7b-aa21-52160e9dd0fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186390635}] :answer-field/correct {:answer/id #uuid "9182a711-51cf-5310-bbf4-9cbe0a46a666" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186390634} :answer-field/id #uuid "0b6bf6f3-b28f-52a9-806c-d0b8cedb752a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186390633} {:answer-field/choices [{:answer/id #uuid "a30adbe1-cdd5-59f5-8eff-7c4058bf0143" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186390637} {:answer/id #uuid "79a8e18e-8aaf-5800-a6dc-c9a7f0807e38" :answer/type {:db/id #edb/ref 1