#{[{:db/id #edb/ref 17592186241073 :knowledge-point/_questions [{:db/id #edb/ref 17592186096806 :knowledge-point/id #uuid "36b05580-d22b-5ac4-b8a3-cd8d9629ef74" :knowledge-point/title "Computing the Derivative of a Product of Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "080fed9c-929c-5717-bee1-46db05abc300" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186238140} {:answer/id #uuid "16890c65-02ef-5dc0-af14-ca916235e5d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186238247} {:answer/id #uuid "4fe486bc-17b6-5479-b54e-6adc5f5c233d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186238743} {:answer/id #uuid "e471e0be-e17d-5034-8948-49f1509aa1aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186240060} {:answer/id #uuid "ee5b1560-81ea-50c9-b2a3-16754308d458" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186240155}] :answer-field/correct {:answer/id #uuid "4fe486bc-17b6-5479-b54e-6adc5f5c233d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186238743} :answer-field/id #uuid "2a8819ed-6e85-58b5-a0d5-1b1bd2ebd056" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240406}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "14a411a4-cb36-5f96-a4f0-a43da2d8c9ab" :question/math-academy-id "q-105502" :question/problem "![](images/7b/7b44dcfdfef91ada119ea7346b59f337a82bc8cca1e364fd6ea29c9eead5a2fd.png)\n\nThe graphs of the functions $y=f(x)$ and $y=g(x)$ are given above. Find ${h}^{′}(-3)$ where $h(x)=f(x)g(x).$" :question/worked-solution "The product rule for derivatives gives\n\n$$\n{h}^{′}(x)={f}^{′}(x)\\cdot g(x)+f(x)\\cdot {g}^{′}(x).\n$$\n\nAs a result, we have that\n\n$$\n{h}^{′}(-3)={f}^{′}(-3)\\cdot g(-3)+f(-3)\\cdot {g}^{′}(-3).\n$$\n\nFrom the graphs above, we obtain that $f(-3)=-2$ and $g(-3)=0.$\n\nAdditionally,\n\n- The slope of $f(x)$ on $x\\in (-4,2)$ equals $1.$ So, ${f}^{′}(-3)=1.$\n\n- The slope of $g(x)$ on $x\\in (-4,-2)$ equals $3.$ So, ${g}^{′}(-3)=3.$\n\nTherefore,\n\n$$\n\\begin{aligned}{h}^{′}(-3) & ={f}^{′}(-3)\\cdot g(-3)+f(-3)\\cdot {g}^{′}(-3) \\\\  & =1\\cdot 0+(-2)\\cdot 3 \\\\  & =-6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186241109 :knowledge-point/_questions [{:db/id #edb/ref 17592186096833 :knowledge-point/id #uuid "fe5822b4-c5d4-59a8-bd72-a41d3074e4e6" :knowledge-point/title "Integrating Trigonometric Expressions With Linear Arguments Using the Pythagorean Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11d650c1-149f-5757-9587-2d05e7bdf855" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{x}^{4}-\\frac{7}{3}\\operatorname{cot}⁡(3x-2\\pi )+C" :db/id #edb/ref 17592186238205} {:answer/id #uuid "5335d16f-a84e-5b3e-b354-de02ea150c39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}+\\frac{7}{3}\\operatorname{cot}⁡(3x-2\\pi )+C" :db/id #edb/ref 17592186238772} {:answer/id #uuid "64681e8d-39d1-5faf-ac7f-a604c349e91c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}-\\frac{3}{5}\\operatorname{cot}⁡(3x-2\\pi )+C" :db/id #edb/ref 17592186238936} {:answer/id #uuid "940d2c4d-f823-5543-85bc-88a7957dace4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}-\\frac{7}{5}\\operatorname{cot}⁡(3x-2\\pi )+C" :db/id #edb/ref 17592186239336} {:answer/id #uuid "cb9d2f46-656b-5f67-8740-d57524fe0094" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}-\\frac{7}{3}\\operatorname{cot}⁡(3x-2\\pi )+C" :db/id #edb/ref 17592186239840}] :answer-field/correct {:answer/id #uuid "cb9d2f46-656b-5f67-8740-d57524fe0094" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}-\\frac{7}{3}\\operatorname{cot}⁡(3x-2\\pi )+C" :db/id #edb/ref 17592186239840} :answer-field/id #uuid "cb055678-80b5-562a-bc4a-fd37fcc7ea2c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240686}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f79178f2-ea4e-568f-a26a-8eda65a5b236" :question/math-academy-id "q-10567" :question/problem "$\\int (7+4{x}^{3}+7{cot}^{2}⁡(3x-2\\pi ))\\,\\text{d}x=$" :question/worked-solution "From the identity $1+{cot}^{2}⁡\\theta ={csc}^{2}⁡\\theta $ with $\\theta =3x-2\\pi ,$ we get \n\n$$\n\\begin{aligned}1+{cot}^{2}⁡(3x-2\\pi ) & ={csc}^{2}⁡(3x-2\\pi ).\\end{aligned}\n$$\n\nSubstituting the above into our integral gives\n\n$$\n\\begin{aligned}\\int (7+4{x}^{3}+7{cot}^{2}⁡(3x-2\\pi ))\\,\\text{d}x & =\\int (4{x}^{3}+7+7{cot}^{2}⁡(3x-2\\pi ))\\,\\text{d}x \\\\  & =\\int (4{x}^{3}+7[1+{cot}^{2}⁡(3x-2\\pi )])\\,\\text{d}x \\\\  & =\\int (4{x}^{3}+7{csc}^{2}⁡(3x-2\\pi ))\\,\\text{d}x \\\\  & =4\\cdot \\frac{{x}^{4}}{4}+7(-\\frac{1}{3}\\operatorname{cot}⁡(3x-2\\pi ))+C \\\\  & ={x}^{4}-\\frac{7}{3}\\operatorname{cot}⁡(3x-2\\pi )+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083480 :knowledge-point/_questions [{:db/id #edb/ref 17592186083383 :knowledge-point/id #uuid "f4f0aabf-5329-59e7-a5e8-6db979b8699c" :knowledge-point/title "Solving for Displacement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "517093bd-421a-53c7-a2db-3302bb28b60f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "44.1\\,\\text{m}" :db/id #edb/ref 17592186238759} {:answer/id #uuid "6c731f24-b7ec-5572-9cd0-c170e3c18f95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14.7\\,\\text{m}" :db/id #edb/ref 17592186238991} {:answer/id #uuid "a913d655-670f-5bfe-9609-0b5a6de845ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.08\\,\\text{m}" :db/id #edb/ref 17592186239534} {:answer/id #uuid "ed3bc61b-0071-5549-8f4d-3e0c791aa6ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "29.4\\,\\text{m}" :db/id #edb/ref 17592186240141} {:answer/id #uuid "ffa16265-189f-58ef-a1a1-9da3c1a4a4c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "88.2\\,\\text{m}" :db/id #edb/ref 17592186240325}] :answer-field/correct {:answer/id #uuid "517093bd-421a-53c7-a2db-3302bb28b60f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "44.1\\,\\text{m}" :db/id #edb/ref 17592186238759} :answer-field/id #uuid "8c7688cd-7ee4-58c7-b31e-a3fa3a717384" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240579}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4e3ddfe5-6a0f-5dd6-97e4-c3a65ef84d31" :question/math-academy-id "q-10586" :question/problem "A ball is dropped from a height and hits the ground in $3$ seconds. Find the distance the ball covered during its fall. \n\n*Hint: The acceleration due to gravity is $9.8\\,{\\text{m/s}}^{2}.$*" :question/requires-calculator true :question/worked-solution "To solve this problem, we use the formula\n\n$$\ns=ut+\\frac{1}{2}g{t}^{2},\n$$\n\nwhere $s$ is the displacement, measured from the starting position in the direction of the initial motion, $u$ is the initial velocity, $t$ is the time since the beginning of the motion, and $g$ is the acceleration due to gravity.\n\nLet's summarize the information we have:\n\n- The initial velocity of the ball is $u=0\\,\\text{m/s}.$\n\n- The ball falls for $t=3\\,\\text{s}.$\n\n- The acceleration due to gravity is $g=9.8\\,{\\text{m/s}}^{2}.$\n\nSubstituting these values into the formula, we obtain the following:\n\n$$\n\\begin{aligned}s & =ut+\\frac{1}{2}g{t}^{2} \\\\  & =(0)(3)+\\frac{1}{2}(9.8)(3)^{2} \\\\  & =0+4.9(9) \\\\  & =44.1\\end{aligned}\n$$\n\nTherefore, the distance is $44.1\\,\\text{m}.$"}] [{:db/id #edb/ref 17592186386182 :knowledge-point/_questions [{:db/id #edb/ref 17592186054650 :knowledge-point/id #uuid "95627f8c-4151-5565-8803-7558bd674acb" :knowledge-point/title "Adding Non-Square Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a55932ce-3f50-5b73-858f-cb76f12c3587" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-12 & -12 & 1 \\\\ -1 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186386184} {:answer/id #uuid "15d52a5c-027a-512d-9f40-5eed9dc914ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-12 & -12 & 1 \\\\ 1 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186386185} {:answer/id #uuid "c534b1fe-2ec4-554b-8341-0c38ee03d056" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-12 & 12 & 1 \\\\ 1 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186386186} {:answer/id #uuid "49ccf434-d5d9-541f-a931-72a94a342247" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-12 & -12 & 1 \\\\ 1 & 1 & -17\\end{aligned}]" :db/id #edb/ref 17592186386187} {:answer/id #uuid "9143ce0c-958c-5996-b37e-3c51ef20ca74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-12 & 12 & 1 \\\\ 1 & -1 & 1\\end{aligned}]" :db/id #edb/ref 17592186386188}] :answer-field/correct {:answer/id #uuid "15d52a5c-027a-512d-9f40-5eed9dc914ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-12 & -12 & 1 \\\\ 1 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186386185} :answer-field/id #uuid "b026c447-2f5b-5963-aace-757189b51481" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386183}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c2549bb3-62b2-5d71-b2ff-f2d99c30a636" :question/math-academy-id "q-106" :question/problem "Calculate $M+N,$ where\n\n$$\nM=[\\begin{aligned}3 & -6 & 14 \\\\ 2 & 9 & -13\\end{aligned}],\\,N=[\\begin{aligned}-15 & -6 & -13 \\\\ -1 & -8 & 14\\end{aligned}].\n$$" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}M+N & =[\\begin{aligned}3 & -6 & 14 \\\\ 2 & 9 & -13\\end{aligned}]+[\\begin{aligned}-15 & -6 & -13 \\\\ -1 & -8 & 14\\end{aligned}] \\\\  & =[\\begin{aligned}3+(-15) & -6+(-6) & 14+(-13) \\\\ 2+(-1) & 9+(-8) & -13+14\\end{aligned}] \\\\  & =[\\begin{aligned}-12 & -12 & 1 \\\\ 1 & 1 & 1\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186241150 :knowledge-point/_questions [{:db/id #edb/ref 17592186087742 :knowledge-point/id #uuid "7703063b-658d-50a5-8ac3-747b7f029bb3" :knowledge-point/title "Finding the Parametric Equations of a Circle Centered at the Origin"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8423035f-a5a5-5c6b-84df-93fa66043e10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186239203} {:answer/id #uuid "b001d813-7987-5c68-9466-9de6ccb68bd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\sqrt{\\frac{1}{2}}\\operatorname{cos}⁡\\theta ,\\,y=\\sqrt{\\frac{1}{2}}\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186239584} {:answer/id #uuid "c0c2d72f-f92d-59fc-8d72-ef4098955ac2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2\\operatorname{cos}⁡\\theta ,\\,y=2\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186239736} {:answer/id #uuid "c597485d-f992-5ec7-957e-38171d3cdea7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{4}\\operatorname{cos}⁡\\theta ,\\,y=\\frac{1}{4}\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186239793} {:answer/id #uuid "d652b090-492a-59ad-9d6c-3c66c3e3286e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}\\operatorname{cos}⁡\\theta ,\\,y=\\frac{1}{2}\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186239928}] :answer-field/correct {:answer/id #uuid "d652b090-492a-59ad-9d6c-3c66c3e3286e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}\\operatorname{cos}⁡\\theta ,\\,y=\\frac{1}{2}\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186239928} :answer-field/id #uuid "f65cb3a9-d2ec-5669-ac2a-dd0da3b31a0d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240764}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c548914b-7c42-51b7-ab54-c723baf0506a" :question/math-academy-id "q-106032" :question/problem "Which of the following parametric equations, defined for $\\theta \\in [0,2\\pi ),$ generate a circle of radius $\\frac{1}{2}$ centered at the origin?" :question/worked-solution "The parametric equations of a circle  of radius $r$  centered at  the origin are\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, the radius $r=\\frac{1}{2}.$ Therefore, the parametric equations of the circle are \n\n$$\nx=\\frac{1}{2}\\operatorname{cos}⁡\\theta ,\\,y=\\frac{1}{2}\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$"}] [{:db/id #edb/ref 17592186399496 :knowledge-point/_questions [{:db/id #edb/ref 17592186087743 :knowledge-point/id #uuid "0346056c-cf8e-51bf-92f3-052a0948a6fa" :knowledge-point/title "Finding the Parametric Equations of a Circle Centered at a General Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "146d3b28-8e29-5eb2-9b1c-13a2a90ec385" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2\\operatorname{cos}⁡\\theta +2,\\,y=\\operatorname{sin}⁡\\theta +1" :db/id #edb/ref 17592186399498} {:answer/id #uuid "d4d5787b-b5bd-5b27-a033-31a126fb604a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2\\operatorname{cos}⁡\\theta +2,\\,y=2\\operatorname{sin}⁡\\theta +1" :db/id #edb/ref 17592186399499} {:answer/id #uuid "ebd95806-d79f-5932-8502-3d798b511be9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2\\operatorname{cos}⁡\\theta +1,\\,y=2\\operatorname{sin}⁡\\theta +2" :db/id #edb/ref 17592186399500} {:answer/id #uuid "c7286f56-415b-5975-9965-cac2f25bbe61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2\\operatorname{cos}⁡\\theta -1,\\,y=2\\operatorname{sin}⁡\\theta -2" :db/id #edb/ref 17592186399501} {:answer/id #uuid "4df757e2-103b-56a4-a77e-0738b69bd499" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2\\operatorname{cos}⁡\\theta -2,\\,y=2\\operatorname{sin}⁡\\theta -1" :db/id #edb/ref 17592186399502}] :answer-field/correct {:answer/id #uuid "d4d5787b-b5bd-5b27-a033-31a126fb604a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2\\operatorname{cos}⁡\\theta +2,\\,y=2\\operatorname{sin}⁡\\theta +1" :db/id #edb/ref 17592186399499} :answer-field/id #uuid "05f37ecc-6d85-5118-a9aa-9f9f01af2578" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399497}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "656ebe17-b886-53ff-b069-a7253f396457" :question/math-academy-id "q-106049" :question/problem "![](images/21/2135f70f6703878d5f82d3524c890af08e194d7fdfbe92e97a5305d142f73779.png)\n\nConsider the circle of radius $2$ centered at $(2,1)$, as shown above. Which of the following sets of parametric equations, defined for $\\theta \\in [0,2\\pi ),$  traverse the circle once in the counterclockwise direction starting at the point $A(4,1)?$" :question/worked-solution "The parametric equations of a circle of radius $r$ centered at the point $(a,b)$ are\n\n$$\nx=r\\operatorname{cos}⁡\\theta +a,\\,y=r\\operatorname{sin}⁡\\theta +b,\\,\\theta \\in [0,2\\pi ).\n$$\n\nUnder this parametrization, the circle is traversed once in the counterclockwise direction, starting from $(r+a,b).$\n\nIn our case, we have a circle of radius $2$ centered at the point $(2,1).$ Therefore, the parametric equations of the circle are\n\n$$\nx=2\\operatorname{cos}⁡\\theta +2,\\,y=2\\operatorname{sin}⁡\\theta +1,\\,\\theta \\in [0,2\\pi ).\n$$"}] [{:db/id #edb/ref 17592186397836 :knowledge-point/_questions [{:db/id #edb/ref 17592186087784 :knowledge-point/id #uuid "1d81c7ff-8459-5559-bfae-c2a9c3bc739e" :knowledge-point/title "Parametrizing Part of a Circle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "232441c2-f7f1-5f16-bc4b-60b09c0b1593" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\frac{\\pi }{2},\\frac{3\\pi }{2}]" :db/id #edb/ref 17592186397838} {:answer/id #uuid "82fba5c9-0131-541c-8948-a25c0d8eae2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[0,\\frac{\\pi }{2}]" :db/id #edb/ref 17592186397839} {:answer/id #uuid "ef45acfd-4144-56f2-98cf-f241f28d614f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\frac{\\pi }{2},\\pi ]" :db/id #edb/ref 17592186397840} {:answer/id #uuid "0f87d6d3-3c3b-5273-849d-9b1476a53757" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[0,\\pi ]" :db/id #edb/ref 17592186397841} {:answer/id #uuid "c5222c9f-23b7-5ec8-b93f-57e76ab64107" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\frac{\\pi }{2},2\\pi )" :db/id #edb/ref 17592186397842}] :answer-field/correct {:answer/id #uuid "ef45acfd-4144-56f2-98cf-f241f28d614f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\frac{\\pi }{2},\\pi ]" :db/id #edb/ref 17592186397840} :answer-field/id #uuid "dad99554-fa4d-57b5-9d6d-0148f288e880" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186397837}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "da600baa-a9d3-5724-9a5b-8920df8b8600" :question/math-academy-id "q-106293" :question/problem "![](images/d6/d698646baac96e15db7f447c0e1af6dbc0cb03cae50084fbfbb6cab15eabf565.png)\n\nThe quarter-circle above is defined by the parametric equations \n\n$$\nx=2\\operatorname{cos}⁡\\theta ,\\,y=2\\operatorname{sin}⁡\\theta .\n$$\n\nWhat is the domain of the parameter $\\theta ?$" :question/worked-solution "The parametric equations of a circle  of radius $r$  centered at  the origin are\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, the radius $r=2.$ So, the parametric equations of the *full* circle are \n\n$$\nx=2\\operatorname{cos}⁡\\theta ,\\,y=2\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nTo restrict the parameterization to a quarter-circle, we associate the parameter $\\theta $ with the central angle formed by a point $(x,y)$ on the circle and the $x$-axis. \n\n![](images/b7/b76043921a3f9399049d6c3b4f557c7263da4d38a070c66a2dd444dbe2806c8e.png)\n\nWe can see that if we restrict $\\theta $ to $[\\frac{\\pi }{2},\\pi ]$, we get the required quarter-circle.\n\nTherefore, the parametric equations of the quarter-circle are \n\n$$\nx=2\\operatorname{cos}⁡\\theta ,\\,y=2\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [\\frac{\\pi }{2},\\pi ].\n$$"}] [{:db/id #edb/ref 17592186241173 :knowledge-point/_questions [{:db/id #edb/ref 17592186152188 :knowledge-point/id #uuid "6e75170b-1e28-52c1-b0ab-f50ffde6c262" :knowledge-point/title "The Cartesian Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0363f299-ebce-5cd3-a3d9-6edbee6ef1d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}{(x-2)}^{2}+\\frac{1}{4}{(y-3)}^{2}=1" :db/id #edb/ref 17592186238110} {:answer/id #uuid "09798478-efa7-5adb-b8d0-a50d61788683" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{(x-2)}^{2}-4{(y-3)}^{2}=1" :db/id #edb/ref 17592186238149} {:answer/id #uuid "117cba79-f965-5374-92ac-bc6e684c94b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{(x-3)}^{2}+4{(y-2)}^{2}=1" :db/id #edb/ref 17592186238201} {:answer/id #uuid "ae1fc9c6-aa5a-5af7-8fe4-228cbf131588" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}{(x-2)}^{2}-\\frac{1}{4}{(y-3)}^{2}=1" :db/id #edb/ref 17592186239567} {:answer/id #uuid "d42beaa6-50c5-5dd1-9084-6b775db8f4aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{(x-2)}^{2}+4{(y-3)}^{2}=1" :db/id #edb/ref 17592186239919}] :answer-field/correct {:answer/id #uuid "d42beaa6-50c5-5dd1-9084-6b775db8f4aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{(x-2)}^{2}+4{(y-3)}^{2}=1" :db/id #edb/ref 17592186239919} :answer-field/id #uuid "57eda148-ff6d-5235-8674-30b291d678a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240493}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f6811d7d-6469-50eb-bfd3-5c7960859395" :question/math-academy-id "q-106408" :question/problem "Calculate the Cartesian equation of the ellipse\n\n$$\nx=\\frac{1}{2}\\operatorname{cos}⁡\\theta +2,\\,y=\\frac{1}{2}\\operatorname{sin}⁡\\theta +3,\\,0\\le \\theta <2\\pi .\n$$" :question/worked-solution "To find the Cartesian equation of the ellipse, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =\\frac{1}{2}\\operatorname{cos}⁡\\theta +2 \\\\ x-2 & =\\frac{1}{2}\\operatorname{cos}⁡\\theta  \\\\ 2(x-2) & =\\operatorname{cos}⁡\\theta  \\\\ 4{(x-2)}^{2} & ={cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}y & =\\frac{1}{2}\\operatorname{sin}⁡\\theta +3 \\\\ y-3 & =\\frac{1}{2}\\operatorname{sin}⁡\\theta  \\\\ 2(y-3) & =\\operatorname{sin}⁡\\theta  \\\\ 4{(y-3)}^{2} & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\n \n\nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}4{(x-2)}^{2}+4{(y-3)}^{2} & ={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1.\\end{aligned}\n$$\n\nSo the Cartesian equation of the ellipse is\n\n$$\n4{(x-2)}^{2}+4{(y-3)}^{2}=1.\n$$"}] [{:db/id #edb/ref 17592186241174 :knowledge-point/_questions [{:db/id #edb/ref 17592186087800 :knowledge-point/id #uuid "7511fb86-dea4-5206-9ccd-69628a59473e" :knowledge-point/title "Parametrizing a Vertical Parabola Whose Vertex Is at the Origin"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75998071-befb-5489-be0c-bbf3e1494aea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=t,\\,\\,y=\\frac{1}{2}{t}^{2}" :db/id #edb/ref 17592186239070} {:answer/id #uuid "88eea04a-d8a1-51c3-97d8-6e529bd9b97e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{1}{2}t,\\,\\,y=-{t}^{2}" :db/id #edb/ref 17592186239247} {:answer/id #uuid "a4ecb594-d2f1-55cd-8617-ef560cc14075" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}t,\\,\\,y={t}^{2}" :db/id #edb/ref 17592186239488} {:answer/id #uuid "c123727a-d48d-5583-8a9c-797904a46c03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-t,\\,\\,y=-\\frac{1}{2}{t}^{2}" :db/id #edb/ref 17592186239743} {:answer/id #uuid "c7df434f-7524-5eb1-9b00-8cdfa267e631" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-2t,\\,\\,y=-{t}^{2}" :db/id #edb/ref 17592186239814}] :answer-field/correct {:answer/id #uuid "c123727a-d48d-5583-8a9c-797904a46c03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-t,\\,\\,y=-\\frac{1}{2}{t}^{2}" :db/id #edb/ref 17592186239743} :answer-field/id #uuid "336c67f8-b80c-57f5-b2fd-845c6ff24aed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240425}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f65595d4-58fb-5ba2-ab22-c9fc4bc25274" :question/math-academy-id "q-106412" :question/problem "![](images/c4/c42f5aac98d31b7a66a60eebae34b5e83cb62f3ba4801595a81dd9bb57706384.png)\n\nWhich of the following sets of parametric equations, defined for $t\\in (-\\infty ,\\infty ),$ generate the parabola shown above?" :question/worked-solution "The diagram shows that the parabola is vertical, has its vertex at $(0,0),$ and passes through the point $(4,-8).$\n\nThe parametric equations of a vertical parabola that has its vertex at $(0,0)$ are\n\n$$\nx=2pt,\\,y=p{t}^{2},\n$$\n\nwhere $p$ is constant.\n\nSince the parabola passes through $(4,-8),$ we can substitute $x=4$ and $y=-8$ into the standard parametric equations to obtain a system of equations. This gives\n\n$$\n{\\begin{aligned}4=2pt \\\\ -8=p{t}^{2}.\\end{aligned}\n$$\n\nSolving the first equation for $t,$ we have\n\n$$\n\\begin{aligned}4 & =2pt \\\\ 2 & =pt \\\\ t & =\\frac{2}{p}.\\end{aligned}\n$$\n\nSubstituting this into the second equation and solving for $p,$ we get\n\n$$\n\\begin{aligned}-8 & =p{(\\frac{2}{p})}^{2} \\\\ -8 & =p\\cdot \\frac{4}{{p}^{2}} \\\\ -8 & =\\frac{4}{p} \\\\ p & =-\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx=2(-\\frac{1}{2})t,\\,y=(-\\frac{1}{2}){t}^{2},\n$$\n\nwhich simplify to\n\n$$\nx=-t,\\,y=-\\frac{1}{2}{t}^{2}.\n$$"}] [{:db/id #edb/ref 17592186241176 :knowledge-point/_questions [{:db/id #edb/ref 17592186087801 :knowledge-point/id #uuid "c41ffe1b-e741-58bf-9844-83fbc6bc7030" :knowledge-point/title "Parametrizing a Horizontal Parabola Whose Vertex Is at the Origin"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "082d9b69-7bd9-59db-aca5-ae91bb865beb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=8t,\\,\\,y=4{t}^{2}" :db/id #edb/ref 17592186238142} {:answer/id #uuid "22e52eec-0a07-5262-b1c6-aaee0d10b4a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2{t}^{2},\\,\\,y=4t" :db/id #edb/ref 17592186238360} {:answer/id #uuid "5f84549e-68e6-560a-976d-ffaa5598d008" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=8{t}^{2},\\,\\,y=8t" :db/id #edb/ref 17592186238887} {:answer/id #uuid "b8d672fd-3b0d-501e-bbf6-eaa03bac86e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=4t,\\,\\,y=4{t}^{2}" :db/id #edb/ref 17592186239663} {:answer/id #uuid "d00dc5db-0c0e-50b1-8baf-1cca067e5312" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=4{t}^{2},\\,\\,y=8t" :db/id #edb/ref 17592186239876}] :answer-field/correct {:answer/id #uuid "d00dc5db-0c0e-50b1-8baf-1cca067e5312" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=4{t}^{2},\\,\\,y=8t" :db/id #edb/ref 17592186239876} :answer-field/id #uuid "49f1bb43-b236-5d8d-81b5-2401e4943b45" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240457}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "68bb81dd-055f-5068-9ecd-903a999b9ca6" :question/math-academy-id "q-106421" :question/problem "Which of the following sets of parametric equations, defined for $t\\in (-\\infty ,\\infty ),$ generate the horizontal parabola given by the Cartesian equation ${y}^{2}=16x?$" :question/worked-solution "The parametric equations of a horizontal parabola ${y}^{2}=4px$ that has its vertex at $(0,0)$ are\n\n$$\nx=p{t}^{2},\\,y=2pt,\n$$\n\nwhere $p$ is constant.\n\nComparing the given Cartesian equation with the general case ${y}^{2}=4px$ and solving for $p,$ we get\n\n$$\n\\begin{aligned}4px & =16x \\\\ 4p & =16 \\\\ p & =4.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx=(4){t}^{2},\\,y=2(4)t,\n$$\n\nwhich simplify to\n\n$$\nx=4{t}^{2},\\,y=8t.\n$$"}] [{:db/id #edb/ref 17592186241177 :knowledge-point/_questions [{:db/id #edb/ref 17592186087802 :knowledge-point/id #uuid "4ccc7f71-d2e0-5f35-80a5-042a53eda2da" :knowledge-point/title "Finding the Cartesian Equation of a Parabola Given Its Parametric Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c3fbccc-901c-57b0-9988-6f723ef84ab7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=y" :db/id #edb/ref 17592186238713} {:answer/id #uuid "6dc5609b-2aa7-577e-8ca8-e3c677d4774b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=\\frac{1}{4}y" :db/id #edb/ref 17592186238998} {:answer/id #uuid "72ab017e-5892-5f23-a41e-d964cd88398e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=\\frac{1}{2}y" :db/id #edb/ref 17592186239037} {:answer/id #uuid "a5fef148-16ca-57f6-9973-15c2d7ca67f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=-\\frac{1}{4}y" :db/id #edb/ref 17592186239494} {:answer/id #uuid "a9d73e3e-0200-5470-be2b-26f481b4839e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=-y" :db/id #edb/ref 17592186239542}] :answer-field/correct {:answer/id #uuid "a9d73e3e-0200-5470-be2b-26f481b4839e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=-y" :db/id #edb/ref 17592186239542} :answer-field/id #uuid "41723f97-6bef-5b88-aa67-216ec7059ea0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240443}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ff3b94a0-936d-5385-88ce-05fc23ae4390" :question/math-academy-id "q-106438" :question/problem "Find the Cartesian equation of the parabola defined by the parametric equations\n\n$$\nx=-\\frac{1}{2}t,\\,y=-\\frac{1}{4}{t}^{2},\\,t\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "First, let's make $t$ the subject of the parametric equations. This gives\n\n$$\n\\begin{aligned}t & =-2x,\\,{t}^{2}=-4y.\\end{aligned}\n$$\n\nSquaring both sides of the first equation, we have\n\n$$\n\\begin{aligned}{t}^{2} & =4{x}^{2}.\\end{aligned}\n$$\n\nWe can now eliminate the parameter $t$ by substituting the above into the equation ${t}^{2}=-4y$ and rearranging to find the Cartesian equation of the parabola, as follows:\n\n$$\n\\begin{aligned}4{x}^{2} & =-4y \\\\ {x}^{2} & =-y\\end{aligned}\n$$\n\nTherefore, the Cartesian equation of the parabola is ${x}^{2}=-y.$"}] [{:db/id #edb/ref 17592186241178 :knowledge-point/_questions [{:db/id #edb/ref 17592186157303 :knowledge-point/id #uuid "61e9c047-0bbf-560d-b803-87703164db5b" :knowledge-point/title "Parametrizing a Vertical Parabola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01ae9f63-6af5-5a84-a916-c7136c71812f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+1=\\frac{1}{2}t,\\,\\,y-2=\\frac{1}{2}{t}^{2}" :db/id #edb/ref 17592186238093} {:answer/id #uuid "8f37eba5-4cd0-5732-ae8e-d1ad135f3c01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-1=t,\\,\\,y-2=\\frac{1}{2}{t}^{2}" :db/id #edb/ref 17592186239303} {:answer/id #uuid "d12f983a-1b18-54f5-8284-f89b521e5668" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+1=t,\\,\\,y-2={t}^{2}" :db/id #edb/ref 17592186239888} {:answer/id #uuid "d8b4c884-481d-5883-899d-991540722a6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+1=2t,\\,\\,y-2=\\frac{1}{2}{t}^{2}" :db/id #edb/ref 17592186239947} {:answer/id #uuid "e9cbf3ff-7697-5769-9290-35fdcd784b4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+1=t,\\,\\,y-2=\\frac{1}{2}{t}^{2}" :db/id #edb/ref 17592186240112}] :answer-field/correct {:answer/id #uuid "e9cbf3ff-7697-5769-9290-35fdcd784b4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+1=t,\\,\\,y-2=\\frac{1}{2}{t}^{2}" :db/id #edb/ref 17592186240112} :answer-field/id #uuid "b5b4838b-8cd7-57f0-a4f3-f65d787298e0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240646}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9977732a-3153-5e0c-bb69-50c046885f9a" :question/math-academy-id "q-106447" :question/problem "![](images/4a/4ac7f5cd3405e3839b829edc19c440c973521a0263f1aaa0a2f8245697779561.png)\n\nWhich of the following sets of parametric equations, defined for $t\\in (-\\infty ,\\infty ),$ generate the parabola shown above?" :question/worked-solution "The diagram shows that the parabola is vertical, has its vertex at $(-1,2),$ and passes through the point $(1,4).$\n\nThe parametric equations of a vertical parabola that has its vertex at $(h,k)$ are\n\n$$\nx-h=2pt,\\,y-k=p{t}^{2},\n$$\n\nwhere $p$ is constant.\n\nIn our case, $(h,k)=(-1,2),$ and so we have\n\n$$\nx+1=2pt,\\,y-2=p{t}^{2}.\n$$\n\nSince the parabola passes through $(1,4),$ we can substitute $x=1$ and $y=4$ into the parametric equations to obtain a system of equations. This gives\n\n$$\n{\\begin{aligned}2=2pt \\\\ 2=p{t}^{2}.\\end{aligned}\n$$\n\nSolving the first equation for $t,$ we have\n\n$$\n\\begin{aligned}2 & =2pt \\\\ 1 & =pt \\\\ t & =\\frac{1}{p}.\\end{aligned}\n$$\n\nSubstituting this into the second equation and solving for $p,$ we get\n\n$$\n\\begin{aligned}2 & =p{(\\frac{1}{p})}^{2} \\\\ 2 & =p\\cdot \\frac{1}{{p}^{2}} \\\\ 2 & =\\frac{1}{p} \\\\ p & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx+1=2(\\frac{1}{2})t,\\,y-2=(\\frac{1}{2}){t}^{2},\n$$\n\nwhich simplify to\n\n$$\nx+1=t,\\,y-2=\\frac{1}{2}{t}^{2}.\n$$"}] [{:db/id #edb/ref 17592186241179 :knowledge-point/_questions [{:db/id #edb/ref 17592186157303 :knowledge-point/id #uuid "61e9c047-0bbf-560d-b803-87703164db5b" :knowledge-point/title "Parametrizing a Vertical Parabola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "197f740e-e51c-586a-9de1-a51303b4bf82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+2=5t,\\,\\,y+3=\\frac{5}{2}{t}^{2}" :db/id #edb/ref 17592186238266} {:answer/id #uuid "7cba0acb-f4d5-5356-9aae-f6b41b25e383" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+2=5t,\\,\\,y+3=-2{t}^{2}" :db/id #edb/ref 17592186239134} {:answer/id #uuid "7d15632a-23cf-5219-ac0e-c737bf375b1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+2=-10t,\\,\\,y+3=-5{t}^{2}" :db/id #edb/ref 17592186239136} {:answer/id #uuid "dcd090d3-e2a2-5591-b158-3189d26a2627" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+2=-5t,\\,\\,y+3=-\\frac{5}{2}{t}^{2}" :db/id #edb/ref 17592186239984} {:answer/id #uuid "e08e80c5-bb76-53c3-abae-23501d970ef6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+2=-\\frac{5}{2}t,\\,\\,y+3=-\\frac{5}{2}{t}^{2}" :db/id #edb/ref 17592186240024}] :answer-field/correct {:answer/id #uuid "dcd090d3-e2a2-5591-b158-3189d26a2627" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+2=-5t,\\,\\,y+3=-\\frac{5}{2}{t}^{2}" :db/id #edb/ref 17592186239984} :answer-field/id #uuid "3381ca1b-3b5a-5935-a443-b7a1f878342b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240426}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fc08a2c7-414a-5909-a99f-88078655463f" :question/math-academy-id "q-106452" :question/problem "![](images/0c/0c37bb9e010bdb19de2afc8707b6cf1cef69638c9f4721c407c1593f3a387b87.png)\n\nWhich of the following sets of parametric equations, defined for $t\\in (-\\infty ,\\infty ),$ generate the parabola shown above?" :question/worked-solution "The diagram shows that the parabola is vertical, has its vertex at $(-2,-3),$ and passes through the point $(-12,-13).$\n\nThe parametric equations of a vertical parabola that has its vertex at $(h,k)$ are\n\n$$\nx-h=2pt,\\,y-k=p{t}^{2},\n$$\n\nwhere $p$ is constant.\n\nIn our case, $(h,k)=(-2,-3),$ and so we have\n\n$$\nx+2=2pt,\\,y+3=p{t}^{2}.\n$$\n\nSince the parabola passes through $(-12,-13),$ we can substitute $x=-12$ and $y=-13$ into the parametric equations to obtain a system of equations. This gives\n\n$$\n{\\begin{aligned}-10=2pt \\\\ -10=p{t}^{2}.\\end{aligned}\n$$\n\nSolving the first equation for $t,$ we have\n\n$$\n\\begin{aligned}-10 & =2pt \\\\ -5 & =pt \\\\ t & =-\\frac{5}{p}.\\end{aligned}\n$$\n\nSubstituting this into the second equation and solving for $p,$ we get\n\n$$\n\\begin{aligned}-10 & =p{(-\\frac{5}{p})}^{2} \\\\ -10 & =p\\cdot \\frac{25}{{p}^{2}} \\\\ -10 & =\\frac{25}{p} \\\\ p & =-\\frac{5}{2}.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx+2=2(-\\frac{5}{2})t,\\,y+3=(-\\frac{5}{2}){t}^{2},\n$$\n\nwhich simplify to\n\n$$\nx+2=-5t,\\,y+3=-\\frac{5}{2}{t}^{2}.\n$$"}] [{:db/id #edb/ref 17592186241181 :knowledge-point/_questions [{:db/id #edb/ref 17592186157304 :knowledge-point/id #uuid "337be080-59df-51bf-b0d5-14dba139b9c0" :knowledge-point/title "Parametrizing a Horizontal Parabola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "146d60fa-eb3e-519e-a6dc-bd88e4c1fb74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+2=-2{t}^{2},\\,\\,y-3=-4t" :db/id #edb/ref 17592186238225} {:answer/id #uuid "54501e83-b289-5a7c-8ad6-664b9f45cc55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+2=4{t}^{2},\\,\\,y-3=2t" :db/id #edb/ref 17592186238781} {:answer/id #uuid "5e0dda9f-c8a8-52c2-afe9-540f16390a60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-3=4t,\\,\\,y+2=2{t}^{2}" :db/id #edb/ref 17592186238875} {:answer/id #uuid "df241766-aff1-5cd7-8959-878e1800bc59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-2=2{t}^{2},\\,\\,y+3=4t" :db/id #edb/ref 17592186240004} {:answer/id #uuid "fcec1763-9650-53ae-aa26-02a366780f73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+2=2{t}^{2},\\,\\,y-3=4t" :db/id #edb/ref 17592186240288}] :answer-field/correct {:answer/id #uuid "fcec1763-9650-53ae-aa26-02a366780f73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+2=2{t}^{2},\\,\\,y-3=4t" :db/id #edb/ref 17592186240288} :answer-field/id #uuid "9eac83ad-b516-5eb4-8f51-5d524050e132" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240612}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7ada4fca-3977-5aa2-9367-6587a8a4d441" :question/math-academy-id "q-106459" :question/problem "![](images/0e/0e7558b9858668e619e3f7750efd76043981e2b833bcda7c7e462f6ecda1aa10.png)\n\nWhich of the following sets of parametric equations, defined for $t\\in (-\\infty ,\\infty ),$ generate the parabola shown above?" :question/worked-solution "The diagram shows that the parabola is horizontal, has its vertex at $(-2,3),$ and passes through the point $(6,11).$\n\nThe parametric equations of a horizontal parabola that has its vertex at $(h,k)$ are\n\n$$\nx-h=p{t}^{2},\\,y-k=2pt,\n$$\n\nwhere $p$ is constant.\n\nIn our case, $(h,k)=(-2,3),$ and so we have\n\n$$\nx+2=p{t}^{2},\\,y-3=2pt.\n$$\n\nSince the parabola passes through $(6,11),$ we can substitute $x=6$ and $y=11$ into the parametric equations to obtain a system of equations. This gives\n\n$$\n{\\begin{aligned}8=p{t}^{2} \\\\ 8=2pt.\\end{aligned}\n$$\n\nSolving the second equation for $t,$ we have\n\n$$\n\\begin{aligned}8 & =2pt \\\\ 4 & =pt \\\\ t & =\\frac{4}{p}.\\end{aligned}\n$$\n\nSubstituting this into the first equation and solving for $p,$ we get\n\n$$\n\\begin{aligned}8 & =p{(\\frac{4}{p})}^{2} \\\\ 8 & =p\\cdot \\frac{16}{{p}^{2}} \\\\ 8 & =\\frac{16}{p} \\\\ p & =\\frac{16}{8} \\\\ p & =2.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx+2=(2){t}^{2},\\,y-3=2(2)t,\n$$\n\nwhich simplify to\n\n$$\nx+2=2{t}^{2},\\,y-3=4t.\n$$"}] [{:db/id #edb/ref 17592186241185 :knowledge-point/_questions [{:db/id #edb/ref 17592186157304 :knowledge-point/id #uuid "337be080-59df-51bf-b0d5-14dba139b9c0" :knowledge-point/title "Parametrizing a Horizontal Parabola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c416e9a-7d8a-5552-8632-d76acfb50f11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+2=-3{t}^{2},\\,\\,y-5=-6t" :db/id #edb/ref 17592186238166} {:answer/id #uuid "4064d8f0-ff26-5dec-afd4-062446b81b74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-2=-{t}^{2},\\,\\,y+5=-2t" :db/id #edb/ref 17592186238611} {:answer/id #uuid "53f5051c-1625-5048-bde4-8f70ba045d3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-5=-6t,\\,\\,y+2=-3{t}^{2}" :db/id #edb/ref 17592186238775} {:answer/id #uuid "6c5a07db-ccb0-55cc-b0cf-480092fec75e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-2=-3{t}^{2},\\,\\,y+5=-6t" :db/id #edb/ref 17592186238988} {:answer/id #uuid "79a969bc-d964-5eee-b868-8b3861660793" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-5=-3{t}^{2},\\,\\,y+2=-6t" :db/id #edb/ref 17592186239103}] :answer-field/correct {:answer/id #uuid "6c5a07db-ccb0-55cc-b0cf-480092fec75e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-2=-3{t}^{2},\\,\\,y+5=-6t" :db/id #edb/ref 17592186238988} :answer-field/id #uuid "1627a8a9-7bda-5a25-8009-d0c968bae916" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240363}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2c1fa3a1-2262-505d-b748-5b5e506d8699" :question/math-academy-id "q-106463" :question/problem "![](images/d7/d7a5a3f962080fe457e5d35a581ee1340f1603f0c3bc64be4de6e7553f4402e1.png)\n\nWhich of the following sets of parametric equations, defined for $t\\in (-\\infty ,\\infty ),$ generate the parabola shown above?" :question/worked-solution "The diagram shows that the parabola is horizontal, has its vertex at $(2,-5),$ and passes through the point $(-5,-7).$\n\nThe parametric equations of a horizontal parabola that has its vertex at $(h,k)$ are\n\n$$\nx-h=p{t}^{2},\\,y-k=2pt,\n$$\n\nwhere $p$ is constant.\n\nIn our case, $(h,k)=(2,-5),$ and so we have\n\n$$\nx-2=p{t}^{2},\\,y+5=2pt.\n$$\n\nSince the parabola passes through $(-10,7),$ we can substitute $x=-10$ and $y=7$ into the parametric equations to obtain a system of equations. This gives\n\n$$\n{\\begin{aligned}-12=p{t}^{2} \\\\ 12=2pt.\\end{aligned}\n$$\n\nSolving the second equation for $t,$ we have\n\n$$\n\\begin{aligned}12 & =2pt \\\\ 6 & =pt \\\\ t & =\\frac{6}{p}.\\end{aligned}\n$$\n\nSubstituting this into the first equation and solving for $p,$ we get\n\n$$\n\\begin{aligned}-12 & =p{(\\frac{6}{p})}^{2} \\\\ -12 & =p\\cdot \\frac{36}{{p}^{2}} \\\\ -12 & =\\frac{36}{p} \\\\ p & =-3.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx-2=(-3){t}^{2},\\,y+5=2(-3)t,\n$$\n\nwhich simplify to\n\n$$\nx-2=-3{t}^{2},\\,y+5=-6t.\n$$"}] [{:db/id #edb/ref 17592186243886 :knowledge-point/_questions [{:db/id #edb/ref 17592186157304 :knowledge-point/id #uuid "337be080-59df-51bf-b0d5-14dba139b9c0" :knowledge-point/title "Parametrizing a Horizontal Parabola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15217aeb-b0a8-5570-afb7-520cf3b0e307" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-5=\\frac{1}{2}{t}^{2},\\,\\,y-2=t" :db/id #edb/ref 17592186241361} {:answer/id #uuid "7c463308-caac-526d-a3d6-e2d661da7cc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-5=t,\\,\\,y-2=\\frac{1}{2}{t}^{2}" :db/id #edb/ref 17592186242271} {:answer/id #uuid "a9a5796d-109d-5ae4-a9f2-79f02f281bdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-2=\\frac{1}{2}{t}^{2},\\,\\,y-5=t" :db/id #edb/ref 17592186242668} {:answer/id #uuid "ef7c1721-7679-51aa-b822-ef6bd2b34b06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+2=\\frac{1}{2}{t}^{2},\\,\\,y+5=t" :db/id #edb/ref 17592186243304} {:answer/id #uuid "fee37514-8084-577d-8b83-b4d58c9bafe6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-2=\\frac{1}{2}{t}^{2},\\,\\,y-5=2t" :db/id #edb/ref 17592186243424}] :answer-field/correct {:answer/id #uuid "a9a5796d-109d-5ae4-a9f2-79f02f281bdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-2=\\frac{1}{2}{t}^{2},\\,\\,y-5=t" :db/id #edb/ref 17592186242668} :answer-field/id #uuid "d4e9e769-2a67-59af-8392-5751bcdf5353" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243809}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ab3c3b80-a498-5921-8e28-4f84e8be9a6a" :question/math-academy-id "q-106464" :question/problem "Which of the following sets of parametric equations, defined for $t\\in (-\\infty ,\\infty ),$ generate the horizontal parabola given by the Cartesian equation $(y-5)^{2}=2(x-2)?$" :question/worked-solution "The parametric equations of a horizontal parabola $(y-k)^{2}=4p(x-h)$ that has its vertex at $(h,k)$ are\n\n$$\nx-h=p{t}^{2},\\,y-k=2pt,\n$$\n\nwhere $p$ is constant.\n\nComparing the given Cartesian equation with the general case $(y-k)^{2}=4p(x-h),$ we see that the parabola has its vertex at $(h,k)=(2,5).$ So we have\n\n$$\nx-2=p{t}^{2},\\,y-5=2pt.\n$$\n\nNow, comparing the right-hand sides of the given Cartesian equation and the general case, then solving for $p,$ we get\n\n$$\n\\begin{aligned}4p(x-h) & =2(x-2) \\\\ 4p(x-2) & =2(x-2) \\\\ 4p & =2 \\\\ p & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx-2=(\\frac{1}{2}){t}^{2},\\,y-5=2(\\frac{1}{2})t,\n$$\n\nwhich simplify to\n\n$$\nx-2=\\frac{1}{2}{t}^{2},\\,y-5=t.\n$$"}] [{:db/id #edb/ref 17592186243931 :knowledge-point/_questions [{:db/id #edb/ref 17592186124663 :knowledge-point/id #uuid "ee15db10-b92c-5f48-8983-e602068c7e08" :knowledge-point/title "Identifying the Horizontal Asymptote of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "347b1d00-e093-5df8-b0bb-241d2df72d9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-3" :db/id #edb/ref 17592186241640} {:answer/id #uuid "3b40e80b-3473-51b2-9674-9060ca0ed6dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-1" :db/id #edb/ref 17592186241707} {:answer/id #uuid "9644ad6e-c2da-5691-b74a-464d8cb96445" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186242499} {:answer/id #uuid "9ae96f64-5462-56ef-a273-ca1737d10932" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1" :db/id #edb/ref 17592186242536} {:answer/id #uuid "bde0195a-caf8-5f42-9afb-97d1fd2ca750" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186242848}] :answer-field/correct {:answer/id #uuid "3b40e80b-3473-51b2-9674-9060ca0ed6dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-1" :db/id #edb/ref 17592186241707} :answer-field/id #uuid "5a567200-b104-587e-98b2-cc2ac2aaba52" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243618}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1d3780ea-9bd6-553b-af0e-868098039a4e" :question/math-academy-id "q-106705" :question/problem "What is the horizontal asymptote of $y=f(x)$ for $x>0$ with $f(x)=\\frac{|{x}^{3}-5|}{2-{x}^{3}}?$" :question/worked-solution "For large positive values of $x,$ we have $|{x}^{3}-5|=({x}^{3}-5).$ Consequently, for $x\\to \\infty ,$ we get\n\n$$\n{lim}_{x\\to \\infty }\\frac{|{x}^{3}-5|}{2-{x}^{3}}={lim}_{x\\to \\infty }\\frac{{x}^{3}-5}{2-{x}^{3}}.\n$$\n\nThe horizontal asymptote for $x>0$ is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{3}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{{x}^{3}-5}{2-{x}^{3}} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{{x}^{3}}{{x}^{3}}-\\frac{5}{{x}^{3}})}{(\\frac{2}{{x}^{3}}-\\frac{{x}^{3}}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(1-\\frac{5}{{x}^{3}})}{(\\frac{2}{{x}^{3}}-1)} \\\\  & =\\frac{1-0}{0-1} \\\\  & =-1.\\end{aligned}\n$$\n\n \n\nTherefore, the horizontal asymptote is $y=-1.$"}] [{:db/id #edb/ref 17592186399531 :knowledge-point/_questions [{:db/id #edb/ref 17592186152189 :knowledge-point/id #uuid "6d82541c-40ca-5df9-aa17-c20b201fadd4" :knowledge-point/title "The Parametric Equations of an Ellipse Centered at a General Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b497d42e-bb82-5ad8-b534-e2c147e1ff42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=36\\operatorname{cos}⁡\\theta -2,\\,y=16\\operatorname{sin}⁡\\theta +3" :db/id #edb/ref 17592186399533} {:answer/id #uuid "0713f8eb-12ff-5fe2-9526-65877bb581ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=6\\operatorname{cos}⁡\\theta +3,\\,y=4\\operatorname{sin}⁡\\theta -2" :db/id #edb/ref 17592186399534} {:answer/id #uuid "3969d63a-a2eb-506f-beb7-6cde82a0d05c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=12\\operatorname{cos}⁡\\theta +2,\\,y=8\\operatorname{sin}⁡\\theta -3" :db/id #edb/ref 17592186399535} {:answer/id #uuid "9a825ff3-cad9-54b1-8ffe-6c0d2f47c301" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=12\\operatorname{cos}⁡\\theta -3,\\,y=8\\operatorname{sin}⁡\\theta +2" :db/id #edb/ref 17592186399536} {:answer/id #uuid "da3c9fdb-6c6a-55f0-8a89-dc38f3583e7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=6\\operatorname{cos}⁡\\theta -3,\\,y=4\\operatorname{sin}⁡\\theta +2" :db/id #edb/ref 17592186399537}] :answer-field/correct {:answer/id #uuid "da3c9fdb-6c6a-55f0-8a89-dc38f3583e7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=6\\operatorname{cos}⁡\\theta -3,\\,y=4\\operatorname{sin}⁡\\theta +2" :db/id #edb/ref 17592186399537} :answer-field/id #uuid "031319c8-f560-5ad6-9024-95c6acad5a42" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399532}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "df313a83-5c0b-5be0-b850-d3d38af97ca0" :question/math-academy-id "q-106706" :question/problem "![](images/b7/b77fa9e3a398cf9f6cc3a3ea163b83cb75f1e5c9ea98aa1ae34730616c47977c.png)\n\nWhich of the following sets of parametric equations, defined for $\\theta \\in [0,2\\pi ),$ generate the ellipse shown above?" :question/worked-solution "The parametric equations of an ellipse centered at the point $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ are\n\n$$\nx=a\\operatorname{cos}⁡\\theta +h,\\,y=b\\operatorname{sin}⁡\\theta +k,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, the ellipse is centered at the point $(-3,2),$ $a=6$ and $b=4.$ Therefore, the parametric equations of the ellipse are\n\n$$\nx=6\\operatorname{cos}⁡\\theta -3,\\,y=4\\operatorname{sin}⁡\\theta +2,\\,\\theta \\in [0,2\\pi ).\n$$"}] [{:db/id #edb/ref 17592186243933 :knowledge-point/_questions [{:db/id #edb/ref 17592186152190 :knowledge-point/id #uuid "9b51a7bc-7701-539f-9e20-dfc7f2574559" :knowledge-point/title "Parametrizing Part of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27e26f54-0545-533f-b436-b187695ffb99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta \\in [0,\\frac{\\pi }{2}]" :db/id #edb/ref 17592186241527} {:answer/id #uuid "41e65854-bc6f-5943-80a0-131a575e4339" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta \\in [\\frac{\\pi }{2},2\\pi ]" :db/id #edb/ref 17592186241770} {:answer/id #uuid "b99b23a2-5fb6-528b-a3a0-8cd47d7beec2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta \\in [\\pi ,\\frac{3\\pi }{2}]" :db/id #edb/ref 17592186242809} {:answer/id #uuid "dffbd024-6452-5872-b010-95e850431a12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta \\in [\\frac{\\pi }{2},\\frac{3\\pi }{2}]" :db/id #edb/ref 17592186243171} {:answer/id #uuid "fa6861c8-02be-5144-bb3f-cb952060d258" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta \\in [\\frac{3\\pi }{2},2\\pi ]" :db/id #edb/ref 17592186243387}] :answer-field/correct {:answer/id #uuid "fa6861c8-02be-5144-bb3f-cb952060d258" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta \\in [\\frac{3\\pi }{2},2\\pi ]" :db/id #edb/ref 17592186243387} :answer-field/id #uuid "53ba7a39-59bd-58bf-8f95-ac81f5fdfa4d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243602}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8c82fb7c-60f3-5ec6-bb6a-1161e86d2f27" :question/math-academy-id "q-106711" :question/problem "![](images/84/8498bb189b51954a79f8ca6638631d6acd0a3d4fe86f6f4cecb2de77ee370f94.png)\n\nThe quarter-ellipse above is defined by the parametric equations \n\n$$\nx=4\\operatorname{cos}⁡\\theta ,\\,y=2\\operatorname{sin}⁡\\theta .\n$$\n\nWhat is the domain of the parameter $\\theta ?$" :question/worked-solution "The parametric equations of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ are\n\n$$\nx=a\\operatorname{cos}⁡\\theta ,\\,y=b\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, $a=4$ and $b=2.$ Therefore, the parametric equations of the *full* ellipse are\n\n$$\nx=4\\operatorname{cos}⁡\\theta ,\\,y=2\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nTo restrict the parameterization to a quarter-ellipse, we associate the parameter $\\theta $ with the central angle formed by a point $(x,y)$ on the ellipse and the $x$-axis. \n\n![](images/fb/fb686f7295c2c6ac3058361ecc0438ae56d650950833185b17ec959d654cc511.png)\n\nWe can see that if we restrict $\\theta $ to $[\\frac{3\\pi }{2},2\\pi ]$, we get the quarter-ellipse.\n\nTherefore, the parametric equations of the quarter-ellipse are \n\n$$\nx=4\\operatorname{cos}⁡\\theta ,\\,y=2\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [\\frac{3\\pi }{2},2\\pi ].\n$$"}] [{:db/id #edb/ref 17592186243936 :knowledge-point/_questions [{:db/id #edb/ref 17592186078623 :knowledge-point/id #uuid "579373bc-38b3-584c-a118-84be7dfc9074" :knowledge-point/title "Comparing the Relative Magnitude of a Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "239937b2-42e0-5623-a141-a945bd09f480" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186241489} {:answer/id #uuid "340018e8-8775-5de6-91c9-f5928068173a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186241638} {:answer/id #uuid "3ef0a508-dd2f-5d42-9768-b657f0958f14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186241742} {:answer/id #uuid "870a28d7-ad0a-50e1-8684-658cfec2ef79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186242362} {:answer/id #uuid "a464e34e-99b1-555a-9fe8-3179122c1fd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186242623}] :answer-field/correct {:answer/id #uuid "340018e8-8775-5de6-91c9-f5928068173a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186241638} :answer-field/id #uuid "2e447a1f-e474-5ad1-a31c-09184eb24383" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243524}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9ec04ce8-c2fc-55aa-9357-bfe8bb93a396" :question/math-academy-id "q-106727" :question/problem "Evaluate ${lim}_{x\\to \\infty }\\frac{3\\operatorname{sin}⁡x}{2-{x}^{2}}.$" :question/worked-solution "First, we rewrite the limit as\n\n$$\n{lim}_{x\\to \\infty }\\frac{3\\operatorname{sin}⁡x}{2-{x}^{2}}={lim}_{x\\to \\infty }\\frac{-3\\operatorname{sin}⁡x}{{x}^{2}-2}.\n$$\n\nThe numerator here is a bounded, oscillating function with\n\n$$\n|-3\\operatorname{sin}⁡x|\\le 3.\n$$\n\nHowever, the denominator ${x}^{2}-2$ grows without bound as $x\\to \\infty .$ So the denominator is growing much faster than the numerator, and we conclude that\n\n$$\n{lim}_{x\\to \\infty }\\frac{3\\operatorname{sin}⁡x}{2-{x}^{2}}={lim}_{x\\to \\infty }\\frac{-3\\operatorname{sin}⁡x}{{x}^{2}-2}=0.\n$$\n\nWe can see this from the graph of $y=\\frac{3\\operatorname{sin}⁡x}{2-{x}^{2}},$ shown below:\n\n![](images/9f/9fade66030e2e416f92138d787999d3ca3a7dd4788ad39cf29dd07ff944038da.png)"}] [{:db/id #edb/ref 17592186243940 :knowledge-point/_questions [{:db/id #edb/ref 17592186129304 :knowledge-point/id #uuid "66d82fa3-d576-5c42-9dca-4e1b76473424" :knowledge-point/title "Finding the Range of a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ecfb844-f4f1-556c-987d-832292fbec49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,\\frac{5}{2})\\cup (\\frac{5}{2},\\infty )" :db/id #edb/ref 17592186241450} {:answer/id #uuid "1f0a31a2-5a13-565a-a464-3f0914bf9ba9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,0)\\cup (0,\\infty )" :db/id #edb/ref 17592186241453} {:answer/id #uuid "69f5576d-090f-5074-8d93-27f0b35b2326" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,-1)\\cup (-1,\\infty )" :db/id #edb/ref 17592186242133} {:answer/id #uuid "81e21516-bcf4-522f-bcb2-115a49c0c898" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,2)\\cup (2,\\infty )" :db/id #edb/ref 17592186242319} {:answer/id #uuid "93bfca5f-5c07-5241-bbc3-62792fedc0a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,-2)\\cup (-2,\\infty )" :db/id #edb/ref 17592186242476}] :answer-field/correct {:answer/id #uuid "93bfca5f-5c07-5241-bbc3-62792fedc0a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,-2)\\cup (-2,\\infty )" :db/id #edb/ref 17592186242476} :answer-field/id #uuid "477827b9-3e44-560c-8518-8d469641fc9e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243573}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "dee89207-4330-5745-b12b-28c3a1d92f86" :question/math-academy-id "q-106736" :question/problem "What is the range of $f(x)=-\\frac{3}{5-2x}-2?$" :question/worked-solution "A transformed reciprocal function of the form\n\n$$\nf(x)=\\frac{a}{bx+c}+d\n$$\n\nhas the horizontal asymptote $y=d,$ and therefore, its range is\n\n$$\nf(x)\\in (-\\infty ,d)\\cup (d,\\infty ).\n$$\n\nIn our case, $d=-2.$ Therefore, the horizontal asymptote is $y=-2,$ and the range of the function is\n\n$$\nf(x)\\in (-\\infty ,-2)\\cup (-2,\\infty ).\n$$\n\nThe graph $y=f(x)$ is shown below.\n\n![](images/51/51bdabd83a57cce915c284a27699aa200712b259257c371d9e1f19a4b60fa790.png)"}] [{:db/id #edb/ref 17592186243960 :knowledge-point/_questions [{:db/id #edb/ref 17592186078623 :knowledge-point/id #uuid "579373bc-38b3-584c-a118-84be7dfc9074" :knowledge-point/title "Comparing the Relative Magnitude of a Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07f972ff-a620-557f-9034-6ea42bab0740" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186241245} {:answer/id #uuid "33635954-a851-5e18-b110-259edf76f9a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186241633} {:answer/id #uuid "5fd4879c-90a2-5599-8da2-ef4dbc732343" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186242040} {:answer/id #uuid "999ede88-960a-5796-96f2-7b361f514088" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186242521} {:answer/id #uuid "de4f8b10-fb5e-539e-8885-d99a21bcc073" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186243156}] :answer-field/correct {:answer/id #uuid "999ede88-960a-5796-96f2-7b361f514088" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186242521} :answer-field/id #uuid "db660612-31be-51bd-a109-d184b3b2649e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243819}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cfa56d21-de83-52ed-897a-8430dcba3cd1" :question/math-academy-id "q-106830" :question/problem "Evaluate ${lim}_{x\\to \\infty }\\frac{5\\operatorname{cos}⁡x}{3-2x}.$" :question/worked-solution "First, we rewrite the limit as\n\n$$\n{lim}_{x\\to \\infty }\\frac{5\\operatorname{cos}⁡x}{3-2x}={lim}_{x\\to \\infty }\\frac{-5\\operatorname{cos}⁡x}{2x-3}.\n$$\n\nThe numerator here is a bounded, oscillating function with\n\n$$\n|-5\\operatorname{cos}⁡x|\\le 5.\n$$\n\nHowever, the denominator $2x-3$ grows without bound as $x\\to \\infty .$ So the denominator is growing much faster than the numerator, and we conclude that\n\n$$\n{lim}_{x\\to \\infty }\\frac{5\\operatorname{cos}⁡x}{3-2x}={lim}_{x\\to \\infty }\\frac{-5\\operatorname{cos}⁡x}{2x-3}=0.\n$$\n\nWe can see this from the graph of $y=\\frac{5\\operatorname{cos}⁡x}{3-2x},$ shown below:\n\n![](images/ab/ab3f7928be50c25689a99751cd180e585d749bf0a5c253c8662f9b820bbf4bb7.png)"}] [{:db/id #edb/ref 17592186244015 :knowledge-point/_questions [{:db/id #edb/ref 17592186119956 :knowledge-point/id #uuid "231604dc-fe8f-59be-90fe-37af7a1bb648" :knowledge-point/title "Identifying When a Rational Function has no Vertical Asymptotes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b96b5ae-6ce9-5fbd-b829-c0f4f0d789ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-4" :db/id #edb/ref 17592186241568} {:answer/id #uuid "62fb6837-045c-5c5f-817c-39764aa13a87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=0,2" :db/id #edb/ref 17592186242070} {:answer/id #uuid "8730e05f-e09f-5912-b238-023b41d1d32f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No vertical asymptotes" :db/id #edb/ref 17592186242364} {:answer/id #uuid "d94c6f55-f877-5f3f-8d3e-f700d1ec6a57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=0" :db/id #edb/ref 17592186243114} {:answer/id #uuid "f6287792-bc7c-58bb-8ec6-d36156cc7771" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-4,0" :db/id #edb/ref 17592186243359}] :answer-field/correct {:answer/id #uuid "8730e05f-e09f-5912-b238-023b41d1d32f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No vertical asymptotes" :db/id #edb/ref 17592186242364} :answer-field/id #uuid "dbe03a30-9948-5f9d-ada7-d263c82687bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243821}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f19b56f7-fcd0-5225-aa53-5eaa01302c57" :question/math-academy-id "q-107068" :question/problem "Find the vertical asymptotes of $f(x)=\\frac{(x+4)({x}^{3}+3{x}^{2}-5x)}{{x}^{2}+4x}.$" :question/worked-solution "Let's simplify the expression by factoring both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(x+4)({x}^{3}+3{x}^{2}-5x)}{{x}^{2}+4x} & =\\frac{x(x+4)({x}^{2}+3x-5)}{x(x+4)} \\\\  & =\\frac{\\cancel{x(x+4)}({x}^{2}+3x-5)}{\\cancel{x(x+4)}} \\\\  & ={x}^{2}+3x-5\\end{aligned}\n$$\n\nSince the denominator is never zero, we conclude that this function has no vertical asymptotes. A plot of the function is below. Note that it is not defined at $x=-4$ and $x=0.$\n\n![](images/a1/a10cef51ad5955f6065fbf4deaccbab1cda1f576db96310236ea976bb8d8eb8b.png)"}] [{:db/id #edb/ref 17592186244016 :knowledge-point/_questions [{:db/id #edb/ref 17592186119956 :knowledge-point/id #uuid "231604dc-fe8f-59be-90fe-37af7a1bb648" :knowledge-point/title "Identifying When a Rational Function has no Vertical Asymptotes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53a8f94c-d857-5f69-9d64-9c022922856f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=5" :db/id #edb/ref 17592186241927} {:answer/id #uuid "5bd55a37-b2c7-5909-98ed-61bd29967cfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1" :db/id #edb/ref 17592186242010} {:answer/id #uuid "9b30da48-9249-54f7-b9d0-431df35dc0f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=0,5" :db/id #edb/ref 17592186242537} {:answer/id #uuid "cf23feaa-5fcc-5e43-9727-de468ddced90" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No vertical asymptotes" :db/id #edb/ref 17592186243006} {:answer/id #uuid "d9f425cb-fabc-51ea-abea-517010cad372" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1,5" :db/id #edb/ref 17592186243123}] :answer-field/correct {:answer/id #uuid "cf23feaa-5fcc-5e43-9727-de468ddced90" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No vertical asymptotes" :db/id #edb/ref 17592186243006} :answer-field/id #uuid "46b35552-dbd9-5f3e-9b3d-6ca7561f7fcb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243572}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4b4e976b-d186-5092-b020-75ea01bef954" :question/math-academy-id "q-107070" :question/problem "Find the vertical asymptotes of $f(x)=\\frac{(x-5)({x}^{3}+1)}{{x}^{2}-4x-5}.$" :question/worked-solution "Let's simplify the expression by factoring both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(x-5)({x}^{3}+1)}{{x}^{2}-4x-5} & =\\frac{(x-5)(x+1)({x}^{2}-x+1)}{(x-5)(x+1)} \\\\  & =\\frac{\\cancel{(x-5)(x+1)}({x}^{2}-x+1)}{\\cancel{(x-5)(x+1)}} \\\\  & ={x}^{2}-x+1\\end{aligned}\n$$\n\nSince the denominator is never zero, we conclude that this function has no vertical asymptotes. A plot of the function is below. Note that it is not defined at $x=-1,$ and $x=5.$\n\n![](images/bc/bca412e444ba3f3126cc88394ea466c48c2dcb60916dcf42ffb0abecb2c5ad48.png)"}] [{:db/id #edb/ref 17592186244017 :knowledge-point/_questions [{:db/id #edb/ref 17592186119957 :knowledge-point/id #uuid "68ba4c5d-8b91-57bc-b98b-0e9f8d8f1f67" :knowledge-point/title "Determining the Vertical Asymptotes for the Sum of Two Rational Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0220b710-5b90-53ff-8425-62500cb4eb79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No vertical asymptotes" :db/id #edb/ref 17592186241202} {:answer/id #uuid "2a077280-c20c-5c77-86ac-bb178f9de397" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=\\sqrt{3}$ and $x=\\frac{1}{2}$" :db/id #edb/ref 17592186241550} {:answer/id #uuid "846c7b7d-f2dd-5c75-bcf0-fceeb8394c0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}" :db/id #edb/ref 17592186242338} {:answer/id #uuid "d2d03c5d-27d3-5e41-8fd3-b73e336e3d85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\sqrt{2}" :db/id #edb/ref 17592186243037} {:answer/id #uuid "f5b5b232-6478-5750-9c4b-26a86b00d899" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-\\sqrt{2}$ and $x=\\sqrt{2}$" :db/id #edb/ref 17592186243352}] :answer-field/correct {:answer/id #uuid "0220b710-5b90-53ff-8425-62500cb4eb79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No vertical asymptotes" :db/id #edb/ref 17592186241202} :answer-field/id #uuid "7a49c91f-801c-5ea3-bc82-c6c034f4bde1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243675}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c0ab6a53-bb8a-5513-8636-6d49828c6cf2" :question/math-academy-id "q-107074" :question/problem "Find the vertical asymptotes of $f(x)=\\frac{1}{{x}^{2}+3}-\\frac{1}{2{x}^{2}+1}.$" :question/worked-solution "First, let's put the two terms over a common denominator:\n\n$$\n\\begin{aligned}\\frac{1}{{x}^{2}+3}-\\frac{1}{2{x}^{2}+1} & =\\frac{(2{x}^{2}+1)-({x}^{2}+3)}{({x}^{2}+3)(2{x}^{2}+1)}=\\frac{{x}^{2}-2}{({x}^{2}+3)(2{x}^{2}+1)}\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we proceed to set the denominator equal to zero and get\n\n$$\n({x}^{2}+3)(2{x}^{2}+1)=0.\n$$\n\nThis equation has no real solutions, therefore $f(x)$ has no vertical asymptotes."}] [{:db/id #edb/ref 17592186244041 :knowledge-point/_questions [{:db/id #edb/ref 17592186096843 :knowledge-point/id #uuid "0a312840-0d35-50bb-94b3-b04778f4efc3" :knowledge-point/title "Differentiating a Function Using the Chain Rule and Prime Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b70de32-5fa9-5056-93ca-35a9463faadb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5(3x+4{)}^{4}" :db/id #edb/ref 17592186241712} {:answer/id #uuid "3ec14f92-c87e-5787-a89f-47a342d4236d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(3x+4{)}^{5}" :db/id #edb/ref 17592186241739} {:answer/id #uuid "5d608479-e85c-5eaa-9d74-3ea2e83804de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20(3x+4{)}^{4}" :db/id #edb/ref 17592186242022} {:answer/id #uuid "8a1ebdf8-e7b7-53d7-92ca-ae1bc7bccfdd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9(3x+4{)}^{4}" :db/id #edb/ref 17592186242395} {:answer/id #uuid "9a91c92b-ab22-552d-a427-31624937e728" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15(3x+4{)}^{4}" :db/id #edb/ref 17592186242530}] :answer-field/correct {:answer/id #uuid "9a91c92b-ab22-552d-a427-31624937e728" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15(3x+4{)}^{4}" :db/id #edb/ref 17592186242530} :answer-field/id #uuid "2cdfb9ab-5d97-59c1-90d9-2ac765b9ee1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243521}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5ffe447f-f2a2-5d58-986c-0fb23858e18e" :question/math-academy-id "q-107293" :question/problem "Given that $f(x)={(3x+4)}^{5},$ find ${f}^{′}(x).$" :question/worked-solution "Let $g(x)=3x+4$ and $f(g(x))=g(x{)}^{5}.$ \n\nDifferentiating, we have\n\n$$\n\\begin{aligned}{f}^{′}(g(x)) & =({g}^{5}{)}^{′}=5{g}^{4}, \\\\ {g}^{′}(x) & =(3x+4{)}^{′}=3.\\end{aligned}\n$$\n\nThen, using the chain rule, \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={f}^{′}(g(x))\\cdot {g}^{′}(x) \\\\  & =5{g}^{4}\\cdot 3 \\\\  & =15(3x+4{)}^{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244056 :knowledge-point/_questions [{:db/id #edb/ref 17592186092263 :knowledge-point/id #uuid "107eaf98-be8c-5fb1-ac4c-948b1e00df0a" :knowledge-point/title "Differentiating an Exponential Function with a Nonlinear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "100855dc-01a1-54eb-889b-5c5849671fed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}{e}^{{x}^{2}-2x}" :db/id #edb/ref 17592186241318} {:answer/id #uuid "412016b5-7fcf-5318-88ca-74a5337fd439" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{{x}^{2}-2x}" :db/id #edb/ref 17592186241764} {:answer/id #uuid "b3c2451f-e77c-598c-a29b-975bfafc93b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2x+2){e}^{{x}^{2}-2x}" :db/id #edb/ref 17592186242750} {:answer/id #uuid "e6242e2c-3c54-5534-b3c3-9e6ba73a9681" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2x-2){e}^{{x}^{2}-2x}" :db/id #edb/ref 17592186243224} {:answer/id #uuid "e95fa722-682a-5996-bbc5-42651cbf8584" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x{e}^{{x}^{2}-2x}" :db/id #edb/ref 17592186243242}] :answer-field/correct {:answer/id #uuid "e6242e2c-3c54-5534-b3c3-9e6ba73a9681" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2x-2){e}^{{x}^{2}-2x}" :db/id #edb/ref 17592186243224} :answer-field/id #uuid "666980b0-ea06-5cc6-8aba-d89d9e6e8dd9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243640}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "30a7e2e3-900c-5659-9ff0-e1c7283ea786" :question/math-academy-id "q-107445" :question/problem "Given that $y={e}^{{x}^{2}-2x},$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={e}^{u},\\,u={x}^{2}-2x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=2x-2.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (2x-2) \\\\  & =(2x-2){e}^{u} \\\\  & =(2x-2){e}^{{x}^{2}-2x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244058 :knowledge-point/_questions [{:db/id #edb/ref 17592186092263 :knowledge-point/id #uuid "107eaf98-be8c-5fb1-ac4c-948b1e00df0a" :knowledge-point/title "Differentiating an Exponential Function with a Nonlinear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f51954f-ef10-5b61-8e64-a3c5da15b5b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186241888} {:answer/id #uuid "561e1348-b169-5b7b-9445-b0635e9a11e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186241956} {:answer/id #uuid "662b5321-520e-54cd-9509-03f4e29b7113" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186242102} {:answer/id #uuid "d763b1fc-ea11-5f90-95d1-e07b6b76e1cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186243092} {:answer/id #uuid "ea081c7f-fadb-5983-817c-316ec3dc87d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186243251}] :answer-field/correct {:answer/id #uuid "ea081c7f-fadb-5983-817c-316ec3dc87d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186243251} :answer-field/id #uuid "4a8beb4d-3f02-544b-a522-4d1a06ffa730" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243581}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f0b47caa-0fc0-55c4-b8be-d17c35ea6d3b" :question/math-academy-id "q-107452" :question/problem "Find the slope of the tangent to the curve $y={e}^{{x}^{3}-4x}$ at the point where $x=2.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={e}^{u},\\,u={x}^{3}-4x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}-4.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (3{x}^{2}-4) \\\\  & =(3{x}^{2}-4){e}^{{x}^{3}-4x}.\\end{aligned}\n$$\n\nFinally, to find the slope of the tangent to the curve at $x=2$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=2} & ={(3{x}^{2}-4){e}^{{x}^{3}-4x}\\,|}_{x=2} \\\\  & =(3(2)^{2}-4){e}^{{2}^{3}-4(2)} \\\\  & =8\\cdot {e}^{0} \\\\  & =8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244060 :knowledge-point/_questions [{:db/id #edb/ref 17592186092261 :knowledge-point/id #uuid "2f4bfd24-dafd-57b3-940a-154a6e0acf3d" :knowledge-point/title "Differentiating a General Exponential Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "530546dd-8877-5ee4-a9a9-4e6037256c79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186241920} {:answer/id #uuid "600e2c77-5502-5a78-b78c-316c9d3b0309" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186242042} {:answer/id #uuid "a399353b-dcb8-5ce5-8226-adfa95834745" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186242614} {:answer/id #uuid "a3a4777f-04c7-56f8-9d79-a2692ed255c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186242615} {:answer/id #uuid "f5f46ff0-e8a9-5bfe-82dc-8df71e3e5cb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-24\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186243356}] :answer-field/correct {:answer/id #uuid "a3a4777f-04c7-56f8-9d79-a2692ed255c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186242615} :answer-field/id #uuid "cfbbf656-26a0-5730-8af0-76fb3508854c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243802}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a0d30f56-0d1c-5b77-92c9-4ebf415c4add" :question/math-academy-id "q-107461" :question/problem "If $f(x)={6}^{1-4x},$ find ${f}^{′}(x).$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf={6}^{u},\\,u=1-4x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={6}^{u}ln⁡6,\\,\\frac{\\text{d}u}{\\text{d}x}=-4.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={6}^{u}ln⁡6\\cdot (-4) \\\\  & =-4\\cdot {6}^{u}ln⁡6 \\\\  & =-4\\cdot {6}^{1-4x}ln⁡6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244061 :knowledge-point/_questions [{:db/id #edb/ref 17592186087720 :knowledge-point/id #uuid "4d1ea5c4-2700-5c03-a22e-de5439f47c36" :knowledge-point/title "Expressing a Quotient of Complex Numbers in Polar Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32fe7f10-2655-59bb-82ce-08ad3fdc8a05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\sqrt{2}(\\operatorname{cos}⁡(\\frac{3\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{3\\pi }{4}))" :db/id #edb/ref 17592186241630} {:answer/id #uuid "88a190b9-7d2b-5bcd-9378-d2b0286a8cba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{2}(\\operatorname{cos}⁡(\\frac{\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{4}))" :db/id #edb/ref 17592186242381} {:answer/id #uuid "99be3e20-4ed2-5652-9e1c-b2df33c244c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{2}(\\operatorname{cos}⁡(\\frac{3\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{3\\pi }{4}))" :db/id #edb/ref 17592186242522} {:answer/id #uuid "ab0a0151-cb92-5657-b7d0-81ffeb455502" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=4(\\operatorname{cos}⁡(\\frac{\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{4}))" :db/id #edb/ref 17592186242677} {:answer/id #uuid "f1256db1-73b6-5040-8e72-39c158686864" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\sqrt{2}(\\operatorname{cos}⁡(\\frac{\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{4}))" :db/id #edb/ref 17592186243320}] :answer-field/correct {:answer/id #uuid "f1256db1-73b6-5040-8e72-39c158686864" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\sqrt{2}(\\operatorname{cos}⁡(\\frac{\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{4}))" :db/id #edb/ref 17592186243320} :answer-field/id #uuid "9d26e50a-4924-502d-a4d6-d0b50c2e526a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243730}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a3fb5688-f4d7-5d45-9532-04de911faa48" :question/math-academy-id "q-107478" :question/problem "Express $z=\\frac{4}{1-\\text{i}}$ in the form $r(\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta ).$" :question/worked-solution "First, we express the given complex number in the form $z=x+y\\text{i}.$ To do this, we remove $\\text{i}$ from the denominator by multiplying the numerator and denominator of $z$ by the complex conjugate of the denominator, which is $1+\\text{i}:$\n\n$$\n\\begin{aligned}z & =\\frac{4}{1-\\text{i}} \\\\  & =\\frac{4(1+\\text{i})}{(1-\\text{i})(1+\\text{i})} \\\\  & =\\frac{4(1+\\text{i})}{{1}^{2}-{\\text{i}}^{2}} \\\\  & =\\frac{4(1+\\text{i})}{1+1} \\\\  & =2(1+\\text{i}) \\\\  & =2+2\\text{i}\\end{aligned}\n$$\n\n \n\nIn polar form, $r$ represents the magnitude $|z|.$ For a complex number $z=x+y\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{x}^{2}+{y}^{2}}.\n$$\n\nSo, for $z=2+2\\text{i},$ the magnitude is \n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{2}^{2}+{2}^{2}} \\\\  & =2\\sqrt{2}.\\end{aligned}\n$$\n\n    \n\nIn polar form, $\\theta $  represents the argument $\\operatorname{arg}⁡(z).$ Since $x=2$ and $y=2$ are both positive, $z$ lies in the first quadrant. So, we can find $\\theta $ as follows:\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =\\operatorname{arctan}⁡(\\frac{y}{x}) \\\\  & =\\operatorname{arctan}⁡(\\frac{2}{2}) \\\\  & =\\operatorname{arctan}⁡1 \\\\  & =\\frac{\\pi }{4}\\end{aligned}\n$$\n\nFinally, we write the complex number $z$ in polar form:\n\n$$\nz=2\\sqrt{2}(\\operatorname{cos}⁡(\\frac{\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{4}))\n$$"}] [{:db/id #edb/ref 17592186244062 :knowledge-point/_questions [{:db/id #edb/ref 17592186171913 :knowledge-point/id #uuid "7da9cbe0-e57b-5289-be33-c21af3f68ee7" :knowledge-point/title "Finding Primary Roots of Unity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18bf6ee4-13cb-5e29-aa00-72802f147b3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{\\pi \\text{i}/22}" :db/id #edb/ref 17592186241396} {:answer/id #uuid "2b7c8ad0-2732-50f1-9354-cd1cb2cf58a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{3\\pi \\text{i}/22}" :db/id #edb/ref 17592186241565} {:answer/id #uuid "4f5e3872-0c2d-5000-9375-cf6192a10587" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2\\pi \\text{i}/11}" :db/id #edb/ref 17592186241890} {:answer/id #uuid "a46896c1-0d7c-56eb-b85f-c14eec446f8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{3\\pi \\text{i}/11}" :db/id #edb/ref 17592186242624} {:answer/id #uuid "a6980e6c-5cbd-5b95-bcfb-2ebbd81d5080" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{\\pi \\text{i}/11}" :db/id #edb/ref 17592186242648}] :answer-field/correct {:answer/id #uuid "a6980e6c-5cbd-5b95-bcfb-2ebbd81d5080" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{\\pi \\text{i}/11}" :db/id #edb/ref 17592186242648} :answer-field/id #uuid "91424deb-1037-5137-b17e-259f9cd3cf8a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243710}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8ea7f0d9-052f-5889-bddf-db77ecf1910d" :question/math-academy-id "q-107494" :question/problem "Find the principal $22$th root of unity." :question/worked-solution "Let $z$ be a $22$th root of unity. This means that \n\n$$\n{z}^{22}=1.\n$$\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{22}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/22}={e}^{k\\pi \\text{i}/11}.\\end{aligned}\n$$\n\nThe principal root corresponds to $k=1,$ and is therefore equal to ${e}^{\\pi \\text{i}/11}.$"}] [{:db/id #edb/ref 17592186244065 :knowledge-point/_questions [{:db/id #edb/ref 17592186087720 :knowledge-point/id #uuid "4d1ea5c4-2700-5c03-a22e-de5439f47c36" :knowledge-point/title "Expressing a Quotient of Complex Numbers in Polar Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04f9de1f-4f25-5b06-9fe7-00d80cb7f25e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2(\\operatorname{cos}⁡(\\frac{\\pi }{6})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{6}))" :db/id #edb/ref 17592186241220} {:answer/id #uuid "55a97a63-06b0-52a4-8dc3-397e3cdd5675" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\operatorname{cos}⁡(\\frac{\\pi }{6})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{6})" :db/id #edb/ref 17592186241950} {:answer/id #uuid "8664ea7d-0c52-5b8c-8536-00cd1890171a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\operatorname{cos}⁡(\\frac{\\pi }{3})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{3})" :db/id #edb/ref 17592186242357} {:answer/id #uuid "a18e07c2-0be9-58ca-a916-ebd1e6f4c4a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2(\\operatorname{cos}⁡(\\frac{\\pi }{3})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{3}))" :db/id #edb/ref 17592186242594} {:answer/id #uuid "c1da9973-1d45-5b2a-9d0e-4d2db6f0629a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{2}(\\operatorname{cos}⁡(\\frac{\\pi }{6})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{6}))" :db/id #edb/ref 17592186242880}] :answer-field/correct {:answer/id #uuid "55a97a63-06b0-52a4-8dc3-397e3cdd5675" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\operatorname{cos}⁡(\\frac{\\pi }{6})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{6})" :db/id #edb/ref 17592186241950} :answer-field/id #uuid "d14dc245-a2a8-5495-902f-1ed1045d160d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243806}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2e9181ee-25b9-5957-9828-d0262363192c" :question/math-academy-id "q-107509" :question/problem "Express $z=\\frac{1+\\sqrt{3}\\,\\text{i}}{\\sqrt{3}+\\text{i}}$ in the form $r(\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta ).$" :question/worked-solution "First, we express the given complex number in the form $z=x+y\\text{i}.$ To do this, we remove $\\text{i}$ from the denominator by multiplying the numerator and denominator of $z$ by the complex conjugate of the denominator, which is $\\sqrt{3}-\\text{i}:$ \n\n$$\n\\begin{aligned}z & =\\frac{1+\\sqrt{3}\\,\\text{i}}{\\sqrt{3}+\\text{i}} \\\\  & =\\frac{(1+\\sqrt{3}\\,\\text{i})(\\sqrt{3}-\\text{i})}{(\\sqrt{3}+\\text{i})(\\sqrt{3}-\\text{i})} \\\\  & =\\frac{2\\sqrt{3}+2\\text{i}}{(\\sqrt{3})^{2}-{\\text{i}}^{2}} \\\\  & =\\frac{2(\\sqrt{3}+\\text{i})}{3+1} \\\\  & =\\frac{\\sqrt{3}+\\text{i}}{2} \\\\  & =\\frac{\\sqrt{3}}{2}+\\frac{\\text{i}}{2}\\end{aligned}\n$$\n\nIn polar form, $r$ represents the magnitude $|z|.$ For a complex number $z=x+y\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{x}^{2}+{y}^{2}}.\n$$\n\nSo, for $z=\\frac{\\sqrt{3}}{2}+\\frac{\\text{i}}{2},$ the magnitude is\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{(\\frac{\\sqrt{3}}{2})}^{2}+{(\\frac{1}{2})}^{2}} \\\\  & =\\sqrt{\\frac{3}{4}+\\frac{1}{4}} \\\\  & =1.\\end{aligned}\n$$\n\n    \n\nIn polar form, $\\theta $  represents the argument $\\operatorname{arg}⁡(z).$ Since $x=\\frac{\\sqrt{3}}{2}$ and $y=\\frac{1}{2}$ are both positive, $z$ lies in the first quadrant. So, we can find $\\theta $ as follows: \n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =\\operatorname{arctan}⁡(\\frac{y}{x}) \\\\  & =\\operatorname{arctan}⁡(\\frac{(\\frac{1}{2})}{(\\frac{\\sqrt{3}}{2})}) \\\\  & =\\operatorname{arctan}⁡(\\frac{1}{\\sqrt{3}}) \\\\  & =\\frac{\\pi }{6}\\end{aligned}\n$$\n\nFinally, we write the complex number $z$ in polar form:\n\n$$\nz=\\operatorname{cos}⁡(\\frac{\\pi }{6})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{6})\n$$"}] [{:db/id #edb/ref 17592186092504 :knowledge-point/_questions [{:db/id #edb/ref 17592186092383 :knowledge-point/id #uuid "84c8ba29-95c9-5494-be0b-9b67bee6e45c" :knowledge-point/title "Determining where a Tangent Line Intersects an Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d43d514-056c-5460-a3af-d849e852963f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{26}{15},0)" :db/id #edb/ref 17592186241726} {:answer/id #uuid "62bc42d2-5179-562d-98c4-3bdc3ecbb73c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{15}{26},0)" :db/id #edb/ref 17592186242064} {:answer/id #uuid "6989371f-d3e2-5899-88b0-040b8420dc5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{6}{5},0)" :db/id #edb/ref 17592186242127} {:answer/id #uuid "bb13d610-b21e-5707-86ce-445aaa0a4fb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-52,0)" :db/id #edb/ref 17592186242821} {:answer/id #uuid "d8ae9e16-54c5-576c-9c1a-d34f12e925fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{13}{14},0)" :db/id #edb/ref 17592186243107}] :answer-field/correct {:answer/id #uuid "3d43d514-056c-5460-a3af-d849e852963f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{26}{15},0)" :db/id #edb/ref 17592186241726} :answer-field/id #uuid "dd47966b-6ae5-5788-91db-22f167d38ce2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243823}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9bc53eba-4d4e-5f8c-8a22-7a4a98405447" :question/math-academy-id "q-10752" :question/problem "Find where the tangent to the curve $y=5{x}^{2}-7$ at the point $(3,38)$ intersects the $x$-axis." :question/worked-solution "Let $f(x)=5{x}^{2}-7.$ Let's first calculate the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(5{x}^{2}-7)=10x\\end{aligned}\n$$\n\nSo, the slope of the tangent at our point is\n\n$$\n\\begin{aligned}m={f}^{′}(3)=10(3)=30.\\end{aligned}\n$$\n\nTherefore, the equation of the tangent is\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(38) & =30(x-3) \\\\ y & =30x-90+38 \\\\ y & =30x-52.\\end{aligned}\n$$\n\nTo find where the tangent line intercepts the $x$-axis, we set $y=0$ and solve:\n\n$$\n\\begin{aligned}0 & =30x-52 \\\\ x & =\\frac{26}{15}\\end{aligned}\n$$\n\nTherefore, the point of intersection is $(\\frac{26}{15},0).$"}] [{:db/id #edb/ref 17592186244067 :knowledge-point/_questions [{:db/id #edb/ref 17592186083239 :knowledge-point/id #uuid "1ee21c78-209f-564b-a005-86f58699a3be" :knowledge-point/title "Factoring a Quadratic Polynomial With Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1aa1f7b8-69bb-5f92-911a-dfb947dda4d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u-(1-2\\text{i})" :db/id #edb/ref 17592186241408} {:answer/id #uuid "37dd6105-495e-5bc8-8f54-17c0607d9d86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u-(3+2\\text{i})" :db/id #edb/ref 17592186241677} {:answer/id #uuid "47519c28-b9c9-50e2-b491-06a371b5156c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u-(1+4\\text{i})" :db/id #edb/ref 17592186241824} {:answer/id #uuid "8eb02fe6-113c-5c7d-8f1f-8c0f62782555" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u-(-1-2\\text{i})" :db/id #edb/ref 17592186242434} {:answer/id #uuid "ca92570a-2cd1-5069-94df-4f6b752e31c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u-(2+\\text{i})" :db/id #edb/ref 17592186242965}] :answer-field/correct {:answer/id #uuid "1aa1f7b8-69bb-5f92-911a-dfb947dda4d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u-(1-2\\text{i})" :db/id #edb/ref 17592186241408} :answer-field/id #uuid "dcf6565b-a7a3-593b-b552-d4db9de85e31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243822}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3d969355-1e15-5d5c-8178-ddac8fee50cd" :question/math-academy-id "q-107523" :question/problem "Which of the following is a factor of ${u}^{2}-2u+5?$" :question/worked-solution "First, we let $f(u)={u}^{2}-2u+5.$\n\nNext, we solve $f(u)=0$ by completing the square, as follows:\n\n$$\n\\begin{aligned}f(u) & =0 \\\\ {u}^{2}-2u+5 & =0 \\\\ ({u}^{2}-2\\cdot u+{1}^{2})-{1}^{2}+5 & =0 \\\\ (u-1)^{2}+4 & =0 \\\\ (u-1)^{2} & =-4 \\\\ (u-1)^{2} & =4{\\text{i}}^{2} \\\\ (u-1)^{2} & =(2\\text{i})^{2} \\\\ u-1 & =\\pm 2\\text{i} \\\\ u & =1\\pm 2\\text{i}\\end{aligned}\n$$\n\nSince our quadratic equation has roots ${u}_{1}=1+2\\text{i}$ and ${u}_{2}=1-2\\text{i},$ and the coefficient of the quadratic term is $a=1,$ the expression ${u}^{2}-2u+5$ can be written as\n\n$$\n\\begin{aligned}{u}^{2}-2u+5 & =a(u-{u}_{1})(u-{u}_{2}) \\\\  & =(u-(1+2\\text{i}))(u-(1-2\\text{i})).\\end{aligned}\n$$\n\nTherefore, among the given options, only $u-(1-2\\text{i})$ is a factor of ${u}^{2}-2u+5.$"}] [{:db/id #edb/ref 17592186244071 :knowledge-point/_questions [{:db/id #edb/ref 17592186087813 :knowledge-point/id #uuid "517f2054-008e-54eb-89dd-5f0a09e1f881" :knowledge-point/title "Finding a Cubic Polynomial Given Three Real Roots and a Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d8f15ce-980c-5786-87e2-db801547f886" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}-{x}^{2}-32x-40" :db/id #edb/ref 17592186241431} {:answer/id #uuid "3a201c6e-0650-5612-9eca-579ff4d1f2e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}-2{x}^{2}-32x-40" :db/id #edb/ref 17592186241698} {:answer/id #uuid "b71e0ec4-9c2b-5f4c-bd1b-c9460ea1e68e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}-2{x}^{2}-16x-35" :db/id #edb/ref 17592186242783} {:answer/id #uuid "ba362533-32c2-5437-91f1-46adfc35ffc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}-{x}^{2}-16x-20" :db/id #edb/ref 17592186242812} {:answer/id #uuid "cd94af0b-75e7-529c-958b-c661f153bc88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}^{3}+2{x}^{2}+32x-20" :db/id #edb/ref 17592186242989}] :answer-field/correct {:answer/id #uuid "3a201c6e-0650-5612-9eca-579ff4d1f2e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}-2{x}^{2}-32x-40" :db/id #edb/ref 17592186241698} :answer-field/id #uuid "8668f950-2b23-5b8f-924d-1d0caf181aaf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243693}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "131faea4-07a6-56a1-b953-1246fa04fdd6" :question/math-academy-id "q-107538" :question/problem "The cubic polynomial $P(x)$ has roots ${x}_{1}={x}_{2}=-2,{x}_{3}=5,$ and the coefficient of the cubic term is $2.$ Find $P(x).$" :question/worked-solution "Since our cubic polynomial has roots ${x}_{1}={x}_{2}=-2$ and ${x}_{3}=5,$ and the coefficient of the cubic term is $a=2,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) & =2(x-(-2))(x-(-2))(x-5) \\\\  & =2(x+2)(x+2)(x-5)\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}2(x+2)(x+2)(x-5) & =2({x}^{2}+4x+4)(x-5) \\\\  & =2({x}^{3}+4{x}^{2}-5{x}^{2}+4x-20x-20) \\\\  & =2({x}^{3}-{x}^{2}-16x-20) \\\\  & =2{x}^{3}-2{x}^{2}-32x-40.\\end{aligned}\n$$\n\nTherefore, $P(x)=2{x}^{3}-2{x}^{2}-32x-40.$"}] [{:db/id #edb/ref 17592186244073 :knowledge-point/_questions [{:db/id #edb/ref 17592186087813 :knowledge-point/id #uuid "517f2054-008e-54eb-89dd-5f0a09e1f881" :knowledge-point/title "Finding a Cubic Polynomial Given Three Real Roots and a Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "017685bd-cc42-5e91-b6f9-7139f1ca45a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}-4{x}^{2}-30x" :db/id #edb/ref 17592186241199} {:answer/id #uuid "164a4c8b-7300-5e8d-87cb-bd18cd95b083" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}+8{x}^{2}+60x" :db/id #edb/ref 17592186241371} {:answer/id #uuid "378cc4ba-e822-53c1-a956-f59db104e64c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}-4x-15" :db/id #edb/ref 17592186241670} {:answer/id #uuid "72f9c508-c6db-58c5-bb2e-6d95c1e546b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}-2{x}^{2}-30" :db/id #edb/ref 17592186242200} {:answer/id #uuid "e38adfb7-ad96-53f8-82d2-3ba154311b00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}+4{x}^{2}+15x" :db/id #edb/ref 17592186243208}] :answer-field/correct {:answer/id #uuid "017685bd-cc42-5e91-b6f9-7139f1ca45a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}-4{x}^{2}-30x" :db/id #edb/ref 17592186241199} :answer-field/id #uuid "e510555a-7bca-5d00-b10d-361fdddaa9f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243834}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cb676cef-b96e-5e0e-9b97-6d918ab0faa9" :question/math-academy-id "q-107540" :question/problem "The cubic polynomial $P(x)$ has roots ${x}_{1}=-3,$ ${x}_{2}=0,$ and ${x}_{3}=5,$ and the coefficient of the cubic term is $2.$ Find $P(x).$" :question/worked-solution "Since our cubic equation has roots ${x}_{1}=-3,$ ${x}_{2}=0,$ and ${x}_{3}=5,$ and the coefficient of the cubic term is $a=2,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) & =2(x-(-3))(x-0)(x-5) \\\\  & =2x(x+3)(x-5)\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}2x(x+3)(x-5) & =2x({x}^{2}-2x-15) \\\\  & =2({x}^{3}-2{x}^{2}-15x) \\\\  & =2{x}^{3}-4{x}^{2}-30x.\\end{aligned}\n$$\n\nTherefore, $P(x)=2{x}^{3}-4{x}^{2}-30x.$"}] [{:db/id #edb/ref 17592186386250 :knowledge-point/_questions [{:db/id #edb/ref 17592186087719 :knowledge-point/id #uuid "31e4455a-9f8f-5c12-8c96-bb6735691591" :knowledge-point/title "Converting From Polar Form to Cartesian Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "769304c9-536f-5bee-ad3f-bfee22337ef1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=-\\sqrt{2}+\\sqrt{2}\\,\\text{i}" :db/id #edb/ref 17592186386252} {:answer/id #uuid "9d261cb9-dabf-53f3-b9e1-0752b9983369" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=-1+\\text{i}" :db/id #edb/ref 17592186386253} {:answer/id #uuid "1ab818a5-54de-587e-b8d4-5ad252d7561d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=1+\\text{i}" :db/id #edb/ref 17592186386254} {:answer/id #uuid "713083e0-6e29-5103-b88f-240c9a29bb2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=-1-\\sqrt{2}\\,\\text{i}" :db/id #edb/ref 17592186386255} {:answer/id #uuid "80290119-b3e9-5290-a6fd-17312d831faa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=1-\\text{i}" :db/id #edb/ref 17592186386256}] :answer-field/correct {:answer/id #uuid "9d261cb9-dabf-53f3-b9e1-0752b9983369" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=-1+\\text{i}" :db/id #edb/ref 17592186386253} :answer-field/id #uuid "95ae8fbb-49b5-5680-9cdb-3e54b97c6d37" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386251}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "02d6fd52-a861-5d95-bf24-0c758b7ad072" :question/math-academy-id "q-107551" :question/problem "Express $z=\\sqrt{2}(\\operatorname{cos}⁡(\\frac{3\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{3\\pi }{4}))$ in the form $z=x+\\text{i}y.$" :question/worked-solution "To express the number in Cartesian form, we expand the parentheses and substitute the values of the cosine and sine.\n\nFirst, we find $\\operatorname{cos}⁡(\\frac{3\\pi }{4})$ and $\\operatorname{sin}⁡(\\frac{3\\pi }{4}):$\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\frac{3\\pi }{4}) & =-\\operatorname{cos}⁡(\\frac{\\pi }{4}) \\\\  & =-\\frac{\\sqrt{2}}{2}\\,,\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\frac{3\\pi }{4}) & =\\operatorname{sin}⁡(\\frac{\\pi }{4}) \\\\  & =\\frac{\\sqrt{2}}{2}\\,.\\end{aligned}\n$$\n\nNow, we substitute the values and expand the parentheses:\n\n$$\n\\begin{aligned}z & =\\sqrt{2}(\\operatorname{cos}⁡(\\frac{3\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{3\\pi }{4})) \\\\  & =\\sqrt{2}(-\\frac{\\sqrt{2}}{2}+\\text{i}\\frac{\\sqrt{2}}{2}) \\\\  & =-1+\\text{i}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244085 :knowledge-point/_questions [{:db/id #edb/ref 17592186087719 :knowledge-point/id #uuid "31e4455a-9f8f-5c12-8c96-bb6735691591" :knowledge-point/title "Converting From Polar Form to Cartesian Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "161529f2-330e-5067-a4a2-2c598f4e23cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\text{i}" :db/id #edb/ref 17592186241370} {:answer/id #uuid "1b901e84-2519-5cca-b073-7b6c62e3635b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\text{i}" :db/id #edb/ref 17592186241417} {:answer/id #uuid "2cb57ed9-def7-56b0-a186-f45699c1da79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186241578} {:answer/id #uuid "5806f7a9-da41-59ff-8ae9-a8eb44809d76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\text{i}" :db/id #edb/ref 17592186241977} {:answer/id #uuid "6925961a-23a0-592b-85f0-a2355690ee78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2+\\text{i}" :db/id #edb/ref 17592186242125}] :answer-field/correct {:answer/id #uuid "2cb57ed9-def7-56b0-a186-f45699c1da79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186241578} :answer-field/id #uuid "60d90934-60c0-50e8-a41d-f6ab25c17a62" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243626}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "25fdd1e0-dadc-5981-8079-26e2d85c4830" :question/math-academy-id "q-107567" :question/problem "Express $z=2(\\operatorname{cos}⁡(\\pi )+\\text{i}\\operatorname{sin}⁡(\\pi ))$ in the form $z=x+\\text{i}y.$" :question/worked-solution "To express the number in Cartesian form, we expand the parentheses and substitute the values of the cosine and sine.\n\nSince $\\operatorname{cos}⁡(\\pi )=-1$ and $\\operatorname{sin}⁡(\\pi )=0,$ we have\n\n$$\n\\begin{aligned}z & =2(\\operatorname{cos}⁡(\\pi )+\\text{i}\\operatorname{sin}⁡(\\pi )) \\\\  & =2(-1+\\text{i}\\cdot 0) \\\\  & =-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244087 :knowledge-point/_questions [{:db/id #edb/ref 17592186096608 :knowledge-point/id #uuid "65b4e8e7-e558-50e7-a1ec-37a6eff77e87" :knowledge-point/title "Finding the Amplitude-Phase Form for Sine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fdcb2bf-8345-5e1b-882c-bf6e4b7d33af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{5}\\operatorname{sin}⁡(x-{45}^{∘})" :db/id #edb/ref 17592186241316} {:answer/id #uuid "18b631c1-613b-593f-b662-0a358baf67b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}\\operatorname{sin}⁡(x-{60}^{∘})" :db/id #edb/ref 17592186241395} {:answer/id #uuid "25bb4c0b-c018-5544-b1e8-e12b2244067e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}\\operatorname{sin}⁡(x-{45}^{∘})" :db/id #edb/ref 17592186241504} {:answer/id #uuid "c9bc19ce-1933-5942-9c00-cd53cf354ffd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}\\operatorname{sin}⁡(x-{30}^{∘})" :db/id #edb/ref 17592186242958} {:answer/id #uuid "ee2dba2c-bb4d-57ec-8b76-7eedaf1d151b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{5}\\operatorname{sin}⁡(x-{30}^{∘})" :db/id #edb/ref 17592186243291}] :answer-field/correct {:answer/id #uuid "25bb4c0b-c018-5544-b1e8-e12b2244067e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}\\operatorname{sin}⁡(x-{45}^{∘})" :db/id #edb/ref 17592186241504} :answer-field/id #uuid "88598f20-c925-534c-af55-d6bf9e3c545c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243696}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e33547cc-9eda-5fa2-ada1-bbe7653d7d33" :question/math-academy-id "q-107570" :question/problem "$\\sqrt{5}\\operatorname{sin}⁡x-\\sqrt{5}\\operatorname{cos}⁡x=$" :question/worked-solution "The difference formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(x-ϕ) & =R(\\operatorname{sin}⁡x\\operatorname{cos}⁡ϕ-\\operatorname{cos}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡x-R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n\\sqrt{5}\\operatorname{sin}⁡x-\\sqrt{5}\\operatorname{cos}⁡x=R\\operatorname{sin}⁡(x-ϕ),\n$$\n\nwe get the following identity:\n\n$$\n\\sqrt{5}\\operatorname{sin}⁡x-\\sqrt{5}\\operatorname{cos}⁡x=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡x-(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡x\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n{\\begin{aligned}R\\operatorname{cos}⁡ϕ=\\sqrt{5} \\\\ R\\operatorname{sin}⁡ϕ=\\sqrt{5}\\end{aligned}\n$$\n\nDividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{R\\operatorname{sin}⁡ϕ}{R\\operatorname{cos}⁡ϕ} & =\\frac{\\sqrt{5}}{\\sqrt{5}} \\\\ \\operatorname{tan}⁡ϕ & =1 \\\\ ϕ & =\\operatorname{arctan}⁡1 \\\\  & ={45}^{∘}.\\end{aligned}\n$$\n\nNow, we find the amplitude $R.$ Squaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{(R\\operatorname{cos}⁡ϕ)}^{2}+{(R\\operatorname{sin}⁡ϕ)}^{2} & =(\\sqrt{5})^{2}+(\\sqrt{5})^{2} \\\\ {R}^{2}({cos}^{2}⁡ϕ+{sin}^{2}⁡ϕ) & =5+5 \\\\ {R}^{2} & =10 \\\\ R & =\\sqrt{10}.\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$\n\nFinally, we can write the initial expression in amplitude-phase form as follows:\n\n$$\n\\sqrt{5}\\operatorname{sin}⁡x-\\sqrt{5}\\operatorname{cos}⁡x=\\sqrt{10}\\operatorname{sin}⁡(x-{45}^{∘})\n$$"}] [{:db/id #edb/ref 17592186244089 :knowledge-point/_questions [{:db/id #edb/ref 17592186096608 :knowledge-point/id #uuid "65b4e8e7-e558-50e7-a1ec-37a6eff77e87" :knowledge-point/title "Finding the Amplitude-Phase Form for Sine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cdc0764-c704-5f4c-8900-21357c4cc0a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{sin}⁡(x+0.730)" :db/id #edb/ref 17592186241721} {:answer/id #uuid "4b4c9039-c2fb-5ec2-94bc-d45cd5379b7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{5}\\operatorname{sin}⁡(x+0.841)" :db/id #edb/ref 17592186241858} {:answer/id #uuid "786d7e6b-a9ac-5d0e-ae28-08ad63146c2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{7}\\operatorname{sin}⁡(x+0.741)" :db/id #edb/ref 17592186242240} {:answer/id #uuid "870281f1-0101-507d-854d-e412a542cbbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{sin}⁡(x+0.841)" :db/id #edb/ref 17592186242361} {:answer/id #uuid "bbc5f724-7da5-5411-9f8c-9ba0486c21de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{5}\\operatorname{sin}⁡(x+0.730)" :db/id #edb/ref 17592186242824}] :answer-field/correct {:answer/id #uuid "3cdc0764-c704-5f4c-8900-21357c4cc0a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{sin}⁡(x+0.730)" :db/id #edb/ref 17592186241721} :answer-field/id #uuid "9923f324-3fc1-5d64-bb7b-b26016552565" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243724}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e19c29ed-ca08-5b08-881a-c2cea1937130" :question/math-academy-id "q-107574" :question/problem "$\\sqrt{5}\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x≈$" :question/worked-solution "The sum formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(x+ϕ) & =R(\\operatorname{sin}⁡x\\operatorname{cos}⁡ϕ+\\operatorname{cos}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡x+R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n\\sqrt{5}\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x=R\\operatorname{sin}⁡(x+ϕ),\n$$\n\nwe get the following identity:\n\n$$\n\\sqrt{5}\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡x+(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡x\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n{\\begin{aligned}R\\operatorname{cos}⁡ϕ=\\sqrt{5} \\\\ R\\operatorname{sin}⁡ϕ=2\\end{aligned}\n$$\n\nDividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{R\\operatorname{sin}⁡ϕ}{R\\operatorname{cos}⁡ϕ} & =\\frac{2}{\\sqrt{5}} \\\\ \\operatorname{tan}⁡ϕ & =\\frac{2\\sqrt{5}}{5} \\\\ ϕ & =\\operatorname{arctan}⁡(\\frac{2\\sqrt{5}}{5}) \\\\ ϕ & ≈0.730\\,\\text{rad}\\end{aligned}\n$$\n\nrounded to three decimal places.\n\nNow, we find the amplitude $R.$ Squaring the first and the second equations of the system and adding the results together, we get: \n\n$$\n\\begin{aligned}{R}^{2}{cos}^{2}⁡ϕ+{R}^{2}{sin}^{2}⁡ϕ & =(\\sqrt{5})^{2}+{2}^{2} \\\\ {R}^{2}({cos}^{2}⁡ϕ+{sin}^{2}⁡ϕ) & =5+4 \\\\ {R}^{2} & =9 \\\\ R & =3\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$\n\nFinally, we can write the initial expression in amplitude-phase form as follows:\n\n$$\n\\sqrt{5}\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x≈3\\operatorname{sin}⁡(x+0.730)\n$$"}] [{:db/id #edb/ref 17592186244092 :knowledge-point/_questions [{:db/id #edb/ref 17592186096609 :knowledge-point/id #uuid "f12d8028-2520-5706-ba49-d67935036af6" :knowledge-point/title "Finding the Amplitude-Phase Form for Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13ef2485-088a-59e5-a9d3-d6d81ac05af0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186241351} {:answer/id #uuid "4579478f-975c-5a82-9cbc-e216916864ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186241804} {:answer/id #uuid "a47542a8-9b3c-5c1f-a990-6c080eb2c3cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{8}" :db/id #edb/ref 17592186242627} {:answer/id #uuid "b9c37fb5-15bc-5c9c-ac02-81147abd5673" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{12}" :db/id #edb/ref 17592186242810} {:answer/id #uuid "ee8cf53f-c6cd-5298-a246-3f874d8397d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186243295}] :answer-field/correct {:answer/id #uuid "13ef2485-088a-59e5-a9d3-d6d81ac05af0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186241351} :answer-field/id #uuid "76907d51-a76b-59d2-814f-949dc43b9da2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243669}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b5b0b758-0715-5d36-8c00-3c3db2730695" :question/math-academy-id "q-107579" :question/problem "Given that the expression $2\\sqrt{6}\\operatorname{cos}⁡x+2\\sqrt{2}\\operatorname{sin}⁡x$ can be written as $R\\operatorname{cos}⁡(x-ϕ)$ with $0<ϕ<\\frac{\\pi }{2}$ and $R>0$, what is the value of $ϕ?$" :question/worked-solution "The difference formula for cosine gives \n\n$$\n\\begin{aligned}R\\operatorname{cos}⁡(x-ϕ) & =R(\\operatorname{cos}⁡x\\operatorname{cos}⁡ϕ+\\operatorname{sin}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{cos}⁡x+R\\operatorname{sin}⁡ϕ\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n2\\sqrt{6}\\operatorname{cos}⁡x+2\\sqrt{2}\\operatorname{sin}⁡x=R\\operatorname{cos}⁡(x-ϕ),\n$$\n\nwe get the following identity:\n\n$$\n2\\sqrt{6}\\operatorname{cos}⁡x+2\\sqrt{2}\\operatorname{sin}⁡x=(R\\operatorname{cos}⁡ϕ)\\operatorname{cos}⁡x+(R\\operatorname{sin}⁡ϕ)\\operatorname{sin}⁡x\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n{\\begin{aligned}R\\operatorname{cos}⁡ϕ=2\\sqrt{6} \\\\ R\\operatorname{sin}⁡ϕ=2\\sqrt{2}\\end{aligned}\n$$\n\nDividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{R\\operatorname{sin}⁡ϕ}{R\\operatorname{cos}⁡ϕ} & =\\frac{2\\sqrt{2}}{2\\sqrt{6}} \\\\ \\operatorname{tan}⁡ϕ & =\\frac{1}{\\sqrt{3}} \\\\ ϕ & =\\operatorname{arctan}⁡(\\frac{1}{\\sqrt{3}}) \\\\ ϕ & =\\frac{\\pi }{6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244101 :knowledge-point/_questions [{:db/id #edb/ref 17592186083237 :knowledge-point/id #uuid "4b0262c8-c029-5a72-846b-1b4f4f3306ba" :knowledge-point/title "Finding a Quadratic Polynomial Given a Double Root and a Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e8c00cb-26d5-59e0-8910-feec13fe31f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}-8y+16" :db/id #edb/ref 17592186241446} {:answer/id #uuid "5f505ca2-b236-5af2-bed3-aa7db90c63d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}-4y+24" :db/id #edb/ref 17592186242037} {:answer/id #uuid "9217d3d4-bb7b-5264-a4c6-604779d301bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}-12y+32" :db/id #edb/ref 17592186242464} {:answer/id #uuid "d5542f30-67ed-51e5-a31d-ece57cb3139a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}-24y+48" :db/id #edb/ref 17592186243067} {:answer/id #uuid "dcedd8c7-8fcd-5751-a804-3a5e38543271" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}-3y+96" :db/id #edb/ref 17592186243146}] :answer-field/correct {:answer/id #uuid "d5542f30-67ed-51e5-a31d-ece57cb3139a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}-24y+48" :db/id #edb/ref 17592186243067} :answer-field/id #uuid "b695e0a3-38d4-54b7-b117-4a2899a77bd3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243760}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e58cf3f2-d831-56b3-ae64-968d9ec9277c" :question/math-academy-id "q-107695" :question/problem "The quadratic polynomial $P(y)$ has the double root ${y}_{1}={y}_{2}=4,$ and the coefficient of the quadratic term is $a=3.$ Find $P(y).$" :question/worked-solution "Since our quadratic polynomial has the double root ${y}_{1}={y}_{2}=4,$ and the coefficient of the quadratic term is $a=3,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(y-{y}_{1})^{2} & =3{(y-4)}^{2}\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}3{(y-4)}^{2} & =3({y}^{2}-8y+16) \\\\  & =3{y}^{2}-24y+48.\\end{aligned}\n$$\n\nTherefore, $P(y)=3{y}^{2}-24y+48.$"}] [{:db/id #edb/ref 17592186244103 :knowledge-point/_questions [{:db/id #edb/ref 17592186083239 :knowledge-point/id #uuid "1ee21c78-209f-564b-a005-86f58699a3be" :knowledge-point/title "Factoring a Quadratic Polynomial With Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "639c201d-2539-547c-a951-b41231217d88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z-(4-3\\text{i})" :db/id #edb/ref 17592186242078} {:answer/id #uuid "740c17ab-70ea-5787-a71f-b338b6753386" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z-(7-2\\text{i})" :db/id #edb/ref 17592186242208} {:answer/id #uuid "9117853e-19e7-5845-be3b-865b6d77d448" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z-(2-\\text{i})" :db/id #edb/ref 17592186242452} {:answer/id #uuid "ac101540-88cf-5369-a012-1117eed63915" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z-(3-4\\text{i})" :db/id #edb/ref 17592186242684} {:answer/id #uuid "baac76e2-9dd7-5385-b16a-2fb696e39435" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z-(1-2\\text{i})" :db/id #edb/ref 17592186242817}] :answer-field/correct {:answer/id #uuid "639c201d-2539-547c-a951-b41231217d88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z-(4-3\\text{i})" :db/id #edb/ref 17592186242078} :answer-field/id #uuid "94c0c5e4-aaf8-55fc-84eb-5f459c0b34ce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243717}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "08fb3447-ef6d-5299-8ee8-8365ce0ff2df" :question/math-academy-id "q-107697" :question/problem "Which of the following is a factor of $3{z}^{2}-24z+75?$" :question/worked-solution "First, we let $f(z)=3{z}^{2}-24z+75.$\n\nNext, we solve $f(z)=0$ by completing the square, as follows:\n\n$$\n\\begin{aligned}f(z) & =0 \\\\ 3{z}^{2}-24z+75 & =0 \\\\ {z}^{2}-8z+25 & =0 \\\\ ({z}^{2}-2\\cdot 4\\cdot z+{4}^{2})-{4}^{2}+25 & =0 \\\\ (z-4)^{2}-16+25 & =0 \\\\ (z-4)^{2}+9 & =0 \\\\ (z-4)^{2} & =-9 \\\\ (z-4)^{2} & =9{\\text{i}}^{2} \\\\ (z-4)^{2} & =(3\\text{i})^{2} \\\\ z-4 & =\\pm 3\\text{i} \\\\ z & =4\\pm 3\\text{i}\\end{aligned}\n$$\n\nSince our quadratic equation has roots ${z}_{1}=4+3\\text{i}$ and ${z}_{2}=4-3\\text{i},$ and the coefficient of the quadratic term is $a=3,$ the expression $3{z}^{2}-24z+75$ can be written as\n\n$$\n\\begin{aligned}3{z}^{2}-24z+75 & =a(z-{z}_{1})(z-{z}_{2}) \\\\  & =3(z-(4+3\\text{i}))(z-(4-3\\text{i})).\\end{aligned}\n$$\n\nTherefore, among the given options, only $z-(4-3\\text{i})$ is a factor of $3{z}^{2}-24z+75.$"}] [{:db/id #edb/ref 17592186092506 :knowledge-point/_questions [{:db/id #edb/ref 17592186092382 :knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172" :knowledge-point/title "Calculating the Equation of a Tangent Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4449ae41-4745-5b6f-b350-f2f97023e8a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-13x" :db/id #edb/ref 17592186241795} {:answer/id #uuid "55bb886a-92cb-557e-8876-f77d513accdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=13x+16" :db/id #edb/ref 17592186241951} {:answer/id #uuid "9bfa2fa6-5ff0-56df-82ea-dc60dc378c34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-13x+16" :db/id #edb/ref 17592186242543} {:answer/id #uuid "d2301dcd-3f98-562b-b394-4b8c11213afb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-13x-16" :db/id #edb/ref 17592186243033} {:answer/id #uuid "ddb04a3b-265b-566c-82e8-caa20465742b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=13x" :db/id #edb/ref 17592186243153}] :answer-field/correct {:answer/id #uuid "9bfa2fa6-5ff0-56df-82ea-dc60dc378c34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-13x+16" :db/id #edb/ref 17592186242543} :answer-field/id #uuid "9cf77461-8081-57bc-9334-b34732f1f93f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243728}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6a853078-a18d-5836-8fe8-22fab4093858" :question/math-academy-id "q-10832" :question/problem "Find the equation of the tangent to the curve $y=\\frac{4}{{x}^{3}}-x$ at the point $(1,3).$" :question/worked-solution "Let $f(x)=\\frac{4}{{x}^{3}}-x.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & =-12{x}^{-4}-1.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(1)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(1)=-12(1)^{-4}-1=-13.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=-13$ and the coordinates of our point $(1,3),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(3) & =-13(x-1) \\\\ y & =-13x+13+3 \\\\ y & =-13x+16.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244126 :knowledge-point/_questions [{:db/id #edb/ref 17592186092382 :knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172" :knowledge-point/title "Calculating the Equation of a Tangent Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "462f21c8-a32c-5cda-84b7-37744e22718b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=16x-8" :db/id #edb/ref 17592186241815} {:answer/id #uuid "4b650713-54c4-53ad-9158-64cadb27ca27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5x-2" :db/id #edb/ref 17592186241859} {:answer/id #uuid "5726209a-7467-583c-a028-1f93390b638f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=16x-12" :db/id #edb/ref 17592186241970} {:answer/id #uuid "a96129cb-4819-5b81-9f60-2fc2160dba34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5x-13" :db/id #edb/ref 17592186242665} {:answer/id #uuid "dda5ca10-115e-5cb5-bc36-7f1acf094d5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x-12" :db/id #edb/ref 17592186243151}] :answer-field/correct {:answer/id #uuid "462f21c8-a32c-5cda-84b7-37744e22718b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=16x-8" :db/id #edb/ref 17592186241815} :answer-field/id #uuid "ae01ef85-57dd-5226-8116-895f71485c74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243751}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d0e5b8a4-9dc2-5fdd-9f7d-f9d1860644a8" :question/math-academy-id "q-10835" :question/problem "Find the equation of the tangent to the curve  $y=2{x}^{2}+8x$ at the point $(2,24).$" :question/worked-solution "Let $f(x)=2{x}^{2}+8x.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{2}+8x)=4x+8.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(2)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(2)=4(2)+8=16\\,.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=16$ and the coordinates of our point $(2,24),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(24) & =16(x-2) \\\\ y & =16x-32+24 \\\\ y & =16x-8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244128 :knowledge-point/_questions [{:db/id #edb/ref 17592186092382 :knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172" :knowledge-point/title "Calculating the Equation of a Tangent Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "167d2601-a153-5f76-a657-ca8a9d1514cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=7x+5" :db/id #edb/ref 17592186241373} {:answer/id #uuid "1a460d87-b01b-5994-a872-d9d2d63d990e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x-14" :db/id #edb/ref 17592186241406} {:answer/id #uuid "5cef4fad-b362-5fb0-9d61-adeb769f3eba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=14x-5" :db/id #edb/ref 17592186242018} {:answer/id #uuid "99e8f71d-5a67-5472-92fa-2f862e281d67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=7x-5" :db/id #edb/ref 17592186242525} {:answer/id #uuid "ec8b1ec7-7686-54d6-b158-98e7a4da2198" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=14x-6" :db/id #edb/ref 17592186243272}] :answer-field/correct {:answer/id #uuid "5cef4fad-b362-5fb0-9d61-adeb769f3eba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=14x-5" :db/id #edb/ref 17592186242018} :answer-field/id #uuid "f4591678-2345-5cd5-86ed-0af81cfe1bff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243862}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8e99979c-2ce7-5d29-8201-3e59e8d5c01e" :question/math-academy-id "q-10837" :question/problem "Find the equation of the tangent to the curve $y=5{x}^{2}+4x$ at the point $(1,9).$" :question/worked-solution "Let $f(x)=5{x}^{2}+4x.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(5{x}^{2}+4x)=10x+4.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(1)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(1)=10(1)+4=14\\,.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=14$ and the coordinates of our point $(1,9),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(9) & =14(x-1) \\\\ y & =14x-14+9 \\\\ y & =14x-5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244129 :knowledge-point/_questions [{:db/id #edb/ref 17592186092382 :knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172" :knowledge-point/title "Calculating the Equation of a Tangent Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4126f706-48df-568c-b158-3997506d4eed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=6x-2" :db/id #edb/ref 17592186241765} {:answer/id #uuid "610cb095-d0ad-5b8e-bec8-a14ee91baff4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-7x-4" :db/id #edb/ref 17592186242053} {:answer/id #uuid "6ba8b659-34e4-5d07-b800-54a6ae18926d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x-2" :db/id #edb/ref 17592186242148} {:answer/id #uuid "77df9ea1-4e2d-5e4c-8c89-27e3cf5f41be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-7x+4" :db/id #edb/ref 17592186242237} {:answer/id #uuid "cf34a8a7-7deb-53a6-96fb-1f57b08518d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=6x+2" :db/id #edb/ref 17592186243008}] :answer-field/correct {:answer/id #uuid "610cb095-d0ad-5b8e-bec8-a14ee91baff4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-7x-4" :db/id #edb/ref 17592186242053} :answer-field/id #uuid "0eec1ce0-0929-54cc-9812-bce7469c03cd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243464}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ac2b6c08-7044-5ff0-8a22-7d7df849af22" :question/math-academy-id "q-10839" :question/problem "Find the equation of the tangent to the curve $y={x}^{2}-3x$ at the point $(-2,10).$" :question/worked-solution "Let $f(x)={x}^{2}-3x.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}({x}^{2}-3x)=2x-3.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(-2)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(-2)=2(-2)-3=-7.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=-7$ and the coordinates of our point $(-2,10),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(10) & =-7(x-(-2)) \\\\ y-10 & =-7(x+2) \\\\ y & =-7x-14+10 \\\\ y & =-7x-4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244132 :knowledge-point/_questions [{:db/id #edb/ref 17592186138476 :knowledge-point/id #uuid "916e6da9-a2d1-5bf9-9777-ce4ca4858b96" :knowledge-point/title "Finding the Units of Acceleration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20f0ba03-3840-54b7-a1a8-f54a5ca90a75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\text{in}}^{2}}{\\text{min}}" :db/id #edb/ref 17592186241466} {:answer/id #uuid "375a6fdc-beb9-5fea-8870-47349f6456cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{in}}{{\\text{min}}^{3}}" :db/id #edb/ref 17592186241666} {:answer/id #uuid "8ddddf09-2bf6-5611-aeb6-401c12d61d1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{in}}{{\\text{min}}^{2}}" :db/id #edb/ref 17592186242428} {:answer/id #uuid "91cbfff9-e708-53e4-8ab6-f2c2dd10b472" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\text{in}}^{2}}{{\\text{min}}^{2}}" :db/id #edb/ref 17592186242462} {:answer/id #uuid "96445467-8dbd-5a24-a81e-77382a985908" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{in}}{\\text{min}}" :db/id #edb/ref 17592186242498}] :answer-field/correct {:answer/id #uuid "8ddddf09-2bf6-5611-aeb6-401c12d61d1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{in}}{{\\text{min}}^{2}}" :db/id #edb/ref 17592186242428} :answer-field/id #uuid "8b586ba0-77a9-5c27-a7e9-af8c3c02ecb8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243700}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "74f37dee-395d-5c55-b0ce-e5d3a65d3713" :question/math-academy-id "q-108448" :question/problem "If the speed of a rabbit is measured in $\\text{in/min},$ what are the units of its acceleration?" :question/worked-solution "We can find the acceleration of an object by computing the slope of its speed-time graph. So, let's draw an example of a speed-time graph where the speed is measured in $\\text{in/min}$ and the time is measured in $\\text{min}.$\n\n![](images/ec/ecdd2f132499a6be0c1d8fa48f021713e2019ed9e6660af041853f7e30766091.png)\n\nIn this case, the slope is computed as\n\n$$\nm=\\frac{\\text{change in speed}}{\\text{change in time}},\n$$\n\nand so the units of the slope are as follows:\n\n$$\n\\frac{\\text{units of speed}}{\\text{units of time}}=\\frac{\\text{in/min}}{\\text{min}}=\\frac{\\text{in}}{\\text{min}}\\cdot \\frac{1}{\\text{min}}=\\frac{\\text{in}}{{\\text{min}}^{2}}\n$$\n\nTherefore, the units of acceleration are $\\frac{\\text{in}}{{\\text{min}}^{2}}.$"}] [{:db/id #edb/ref 17592186399643 :knowledge-point/_questions [{:db/id #edb/ref 17592186138478 :knowledge-point/id #uuid "8f4e3599-287a-56a3-8f1b-9e7033803e0a" :knowledge-point/title "Identifying Acceleration on a Speed-Time Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46f114a5-8479-5ab2-898f-e1a0d9b64d84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "From $20\\,\\text{s}$ to $40\\,\\text{s}$" :db/id #edb/ref 17592186399645} {:answer/id #uuid "8bfd7b7f-f09a-57f0-9cdf-fa0624b62f8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "From $30\\,\\text{s}$ to $60\\,\\text{s}$" :db/id #edb/ref 17592186399646} {:answer/id #uuid "bbf8f966-bf45-522b-9a34-c98c57a6aa01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "From $0\\,\\text{s}$ to $60\\,\\text{s}$" :db/id #edb/ref 17592186399647} {:answer/id #uuid "2463de37-8db5-51e1-909c-4ac15ec53855" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "From $10\\,\\text{s}$ to $50\\,\\text{s}$" :db/id #edb/ref 17592186399648} {:answer/id #uuid "8f078bce-f94d-54cc-ae41-aea8efc48b13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "From $0\\,\\text{s}$ to $30\\,\\text{s}$" :db/id #edb/ref 17592186399649}] :answer-field/correct {:answer/id #uuid "8bfd7b7f-f09a-57f0-9cdf-fa0624b62f8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "From $30\\,\\text{s}$ to $60\\,\\text{s}$" :db/id #edb/ref 17592186399646} :answer-field/id #uuid "6d62422f-d84e-5e31-bc10-667678bf2be5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399644}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c47c1778-9762-5608-84e1-7206031f9c36" :question/math-academy-id "q-108462" :question/problem "![](images/31/31e0e843eb581f01cdc7ebb5273398a3c0f32d2949b9e36cd28423295d7b76e8.png)\n\nThe speed-time graph shown above represents the motion of a $250\\text{cc}$ motorcycle. At what times is the motorcycle accelerating?" :question/worked-solution "The motorcycle is accelerating when its acceleration is positive. In a speed-time graph, the acceleration is given by the slope of the line. So, we need to find the times for which the slope is positive.\n\nWe see from the graph that the slope is positive from $t=30\\,\\text{s}$ to $t=60\\,\\text{s}.$ Therefore, the $250\\text{cc}$ motorcycle is accelerating in this time interval."}] [{:db/id #edb/ref 17592186244141 :knowledge-point/_questions [{:db/id #edb/ref 17592186054845 :knowledge-point/id #uuid "9bf25f86-6b27-5eaa-b1a1-1104478b290a" :knowledge-point/title "Finding the Derivative of a Function Given in Implicit Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e436aa9-1f27-528c-9b27-85ed3f247f85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{y}+1}{2-{e}^{y}}" :db/id #edb/ref 17592186241442} {:answer/id #uuid "aa8e1e52-332d-5342-9c48-ba0f24733d9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2-{e}^{y}}" :db/id #edb/ref 17592186242671} {:answer/id #uuid "bb3b068a-44ff-5d2f-a0c9-b5478e80da18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x{e}^{y}-1}{2-{e}^{y}}" :db/id #edb/ref 17592186242822} {:answer/id #uuid "d2124168-f20b-59e2-b795-fe1b9c41f12c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{y}+2}{1+y{e}^{y}}" :db/id #edb/ref 17592186243031} {:answer/id #uuid "fe8d9684-f50a-5be7-ae59-410c9f9af558" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y{e}^{y}+1}{2+{e}^{y}}" :db/id #edb/ref 17592186243420}] :answer-field/correct {:answer/id #uuid "aa8e1e52-332d-5342-9c48-ba0f24733d9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2-{e}^{y}}" :db/id #edb/ref 17592186242671} :answer-field/id #uuid "56334162-ef15-56a1-bf2b-a790116276b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243610}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7ce22a4d-4733-52a4-87c2-c2e0529b4bfc" :question/math-academy-id "q-108506" :question/problem "Given that  ${e}^{y}=2y-x,$ calculate $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({e}^{y}) & =\\frac{\\text{d}}{\\text{d}x}(2y-x) \\\\ {e}^{y}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}(2y)}{\\text{d}x}-\\frac{\\text{d}(x)}{\\text{d}x} \\\\ {e}^{y}\\frac{\\text{d}y}{\\text{d}x} & =2\\frac{\\text{d}y}{\\text{d}x}-1\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}{e}^{y}\\frac{\\text{d}y}{\\text{d}x} & =2\\frac{\\text{d}y}{\\text{d}x}-1 \\\\ \\frac{\\text{d}y}{\\text{d}x}(2-{e}^{y}) & =1 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2-{e}^{y}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386282 :knowledge-point/_questions [{:db/id #edb/ref 17592186138479 :knowledge-point/id #uuid "88580aff-e043-58ea-a8ca-1ce32026428f" :knowledge-point/title "Constructing the Speed-Time Graph for a Real-Life Scenario"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "085fe59d-4891-5783-a3dc-e512a6c66398" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/17/170dea566e8c74e1c3df3c087c6565c85dd03c0703c4dbec1be594ca653c6aa1.png" :db/id #edb/ref 17592186386284} {:answer/id #uuid "39a73eee-b69a-5a6a-a85b-7c1d22da0949" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0c/0c89f7f469830ff7c505d22677f6ea612f1fff396c73aba325b4e87f6f61ae42.png" :db/id #edb/ref 17592186386285} {:answer/id #uuid "258ed6c0-b4dd-5cf0-90d1-01a6e4322f93" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a3/a3fb0b9ebb6ef907a77c3d8ce139802dbd72fab04ea0bfc5db57e9f028c263b9.png" :db/id #edb/ref 17592186386286} {:answer/id #uuid "d191d1ef-4285-5a17-92b3-a9aefa6e1e2c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/12/1280bba15fdb6ada20f6d6f2ea4cfeeb39e9366939d72a06059062cc2abedc8d.png" :db/id #edb/ref 17592186386287} {:answer/id #uuid "3cdbb3a8-0531-5672-b68a-760d458dd965" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8d/8dd2eefb2c2397f10d4c07853ef819b8682e448824bf6e26302d4a16bc02183c.png" :db/id #edb/ref 17592186386288}] :answer-field/correct {:answer/id #uuid "258ed6c0-b4dd-5cf0-90d1-01a6e4322f93" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a3/a3fb0b9ebb6ef907a77c3d8ce139802dbd72fab04ea0bfc5db57e9f028c263b9.png" :db/id #edb/ref 17592186386286} :answer-field/id #uuid "c342a9a6-0c8f-53d9-8bfc-52d1954443be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386283}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0e2fe401-8d6a-539f-989f-5022eb0fe1eb" :question/math-academy-id "q-108567" :question/problem "A particle accelerates from rest with a constant acceleration of $1\\,{\\text{km/h}}^{2}$ for the first $3$ hours of its motion. It then travels at a constant speed for the next $3$ hours before accelerating with a constant acceleration of $0.5\\,{\\text{km/h}}^{2}$ for other $3$ hours. Which graph represents the described motion?" :question/worked-solution "We start the first line from the point $(0,0),$ since the particle starts from rest. Then, because the acceleration is $1\\,{\\text{km/h}}^{2},$ we draw a line with slope $1.$ \n\nHowever, because the particle is only accelerating for the first $3$ hours, we stop the line at $t=3.$ At this time, the particle's speed has increased by $1\\cdot 3=3\\,\\text{km/h}.$ So, the first line segment goes from $(0,0)$ to $(3,3).$\n\n![](images/7a/7a9fd32e5705860064e597fcf9308fee457063e060d3adede260f109ca488201.png)\n\nThe particle then travels at a constant speed for the next $3$ hours. So, the speed remains at $3\\,\\text{km/h}$ for the next $3$ hours, until $t=3+3=6.$\n\n![](images/e4/e4c7e47150bf1c205c243c6fa1d0f0e24b7a69f27a8461791d495eb7487cf4f3.png)\n\nAfter $t=3,$ the particle has an acceleration of $0.5\\,{\\text{km/h}}^{2},$ so the slope of the third line segment is $0.5.$ The third line segment stops after $3$ hours. To figure out the velocity at this moment, we need to find the equation for the third line segment.\n\nSince the third line segment passes through the point $(6,3)$ and has a slope of $0.5,$ we can use point-slope form to write the equation of the line:\n\n$$\n\\begin{aligned}v-{v}_{1} & =m(t-{t}_{1}) \\\\ v-3 & =0.5(t-6) \\\\ v-3 & =0.5t-3 \\\\ v & =0.5t\\end{aligned}\n$$\n\nThe third line segment stops when $t=6+3=9$ hours, and the velocity at this moment is\n\n$$\n\\begin{aligned}v & =0.5t \\\\ v & =0.5(9) \\\\ v & =4.5\\end{aligned}\n$$\n\nSo, the third line segment stops at the point $(9,4.5).$ The final graph is\n\n![](images/a3/a3fb0b9ebb6ef907a77c3d8ce139802dbd72fab04ea0bfc5db57e9f028c263b9.png)"}] [{:db/id #edb/ref 17592186244145 :knowledge-point/_questions [{:db/id #edb/ref 17592186078548 :knowledge-point/id #uuid "9d7a21aa-f2e3-5461-81a6-5cbd0f63c03d" :knowledge-point/title "Finding the First Term of an Arithmetic Series Given the Last Term and the Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1272bcc9-43df-533a-bc65-2d16399361ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186241337} {:answer/id #uuid "6e0a2ba2-2d46-513b-91a2-e9980fdf2686" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186242162} {:answer/id #uuid "7add10bb-d34e-535b-84b3-00b79f22245c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{4}" :db/id #edb/ref 17592186242261} {:answer/id #uuid "ead072d4-85c6-5d9e-b6c0-2fd1d3f8de19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186243259} {:answer/id #uuid "edd27017-a9fb-5e5a-b333-6489d23db53d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186243288}] :answer-field/correct {:answer/id #uuid "ead072d4-85c6-5d9e-b6c0-2fd1d3f8de19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186243259} :answer-field/id #uuid "63581573-341c-52b9-86e9-ce3da7abe0fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243631}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7347742e-0cd7-5f1f-96ab-5609f6a91cbf" :question/math-academy-id "q-108630" :question/problem "If the sum of the first $36$ terms of an arithmetic series is ${S}_{36}=\\frac{225}{2},$ and the last term is ${a}_{36}=\\frac{11}{2},$ what is the first term of the series?" :question/worked-solution "We are given the last term of our series. So, to find the first term, we use the formula for the sum of an arithmetic series in the form\n\n$$\n{S}_{N}=\\frac{N}{2}({a}_{1}+{a}_{N}),\n$$\n\nwhere ${a}_{1}$ is the first term, ${a}_{N}$ is the last term, and $N$ is the number of terms.\n\nSubstituting ${a}_{36}=\\frac{11}{2}$, $N=36$, and ${S}_{N}=\\frac{225}{2}$ into the formula above and solving for ${a}_{1}$, we get\n\n$$\n\\begin{aligned}\\frac{225}{2} & =\\frac{36}{2}({a}_{1}+\\frac{11}{2}) \\\\ \\frac{225}{36} & ={a}_{1}+\\frac{11}{2} \\\\ \\frac{25}{4} & ={a}_{1}+\\frac{11}{2} \\\\ {a}_{1} & =\\frac{25}{4}-\\frac{11}{2} \\\\ {a}_{1} & =\\frac{3}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244149 :knowledge-point/_questions [{:db/id #edb/ref 17592186054677 :knowledge-point/id #uuid "619182bf-107d-5217-a306-ec4f7c1109eb" :knowledge-point/title "Finding the Derivative of a Function Given in Implicit Form Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38abdefd-3252-574c-ad83-da30c6b82e9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8x-7{x}^{3}{y}^{2}}{7{x}^{2}{y}^{3}-2y}" :db/id #edb/ref 17592186241685} {:answer/id #uuid "bb545dae-a3c6-5bfb-9023-948c37103acf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8x-{x}^{2}{y}^{3}}{7{x}^{3}{y}^{2}+{y}^{2}}" :db/id #edb/ref 17592186242823} {:answer/id #uuid "c5136acb-020b-505c-a4e7-1cfbfb2cc0de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8x-7{x}^{2}{y}^{3}}{7{x}^{3}{y}^{2}+2y}" :db/id #edb/ref 17592186242917} {:answer/id #uuid "cdcd5ecf-e29d-52a6-8e4f-06c8bd373504" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-{x}^{3}{y}^{2}}{7{x}^{3}{y}^{2}+2y}" :db/id #edb/ref 17592186242992} {:answer/id #uuid "d32818a8-5eed-5b07-a7ac-495f052b994d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-{x}^{2}{y}^{3}}{{x}^{3}{y}^{2}+y}" :db/id #edb/ref 17592186243042}] :answer-field/correct {:answer/id #uuid "c5136acb-020b-505c-a4e7-1cfbfb2cc0de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8x-7{x}^{2}{y}^{3}}{7{x}^{3}{y}^{2}+2y}" :db/id #edb/ref 17592186242917} :answer-field/id #uuid "4934faa7-2c01-504f-90c9-b63344c5db8e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243577}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "82a0f4a1-b7fe-533e-9033-fcc9236329fd" :question/math-academy-id "q-108655" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $7{x}^{3}{y}^{3}+3{y}^{2}=12{x}^{2}.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\nNote that to differentiate the $7{x}^{3}{y}^{3}$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}7{x}^{3}{y}^{3}+3{y}^{2} & =12{x}^{2} \\\\ \\frac{\\text{d}}{\\text{d}x}(7{x}^{3}{y}^{3}+3{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(12{x}^{2}) \\\\ \\frac{\\text{d}}{\\text{d}x}(7{x}^{3}{y}^{3})+\\frac{\\text{d}}{\\text{d}x}(3{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(12{x}^{2}) \\\\ [21{x}^{3}{y}^{2}\\frac{\\text{d}y}{\\text{d}x}+21{x}^{2}{y}^{3}]+6y\\frac{\\text{d}y}{\\text{d}x} & =24x \\\\ 21{x}^{3}{y}^{2}\\frac{\\text{d}y}{\\text{d}x}+21{x}^{2}{y}^{3}+6y\\frac{\\text{d}y}{\\text{d}x} & =24x\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}21{x}^{3}{y}^{2}\\frac{\\text{d}y}{\\text{d}x}+6y\\frac{\\text{d}y}{\\text{d}x} & =24x-21{x}^{2}{y}^{3} \\\\ \\frac{\\text{d}y}{\\text{d}x}(21{x}^{3}{y}^{2}+6y) & =24x-21{x}^{2}{y}^{3} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{8x-7{x}^{2}{y}^{3}}{7{x}^{3}{y}^{2}+2y}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244152 :knowledge-point/_questions [{:db/id #edb/ref 17592186054846 :knowledge-point/id #uuid "2311a895-587e-5609-8a9f-9963b8cae372" :knowledge-point/title "Finding the Slope of the Tangent Line to a Curve Given in Implicit Form at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45ce074c-f5ee-5790-955f-744688452a51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186241807} {:answer/id #uuid "7e670689-9386-512c-80a1-9ffb0405857d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186242290} {:answer/id #uuid "a4fe8801-fc93-5cb1-b234-3374bb79395a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{4}" :db/id #edb/ref 17592186242633} {:answer/id #uuid "d4b24f33-d38a-5c21-a5c3-2817021cafc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186243063} {:answer/id #uuid "de835654-3bb0-5b6e-95d2-3def6a996d9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186243159}] :answer-field/correct {:answer/id #uuid "45ce074c-f5ee-5790-955f-744688452a51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186241807} :answer-field/id #uuid "504aa2d6-12d2-5a6b-8911-82cd37da7948" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243594}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ffb47def-243e-5613-87da-6b6ae8fdf163" :question/math-academy-id "q-108674" :question/problem "Find the slope of the tangent at the point $(\\frac{\\pi }{3},\\,2)$ for the curve $y\\operatorname{cos}⁡(x)=1.$" :question/worked-solution "To find the slope at a point, we use implicit differentiation to calculate the derivative of the curve, assuming that $y=y(x).$\n\nNote that to differentiate the $y\\operatorname{cos}⁡(x)$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(y\\operatorname{cos}⁡(x)) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ y\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cos}⁡(x))+\\operatorname{cos}⁡x\\frac{\\text{d}}{\\text{d}x}(y) & =0 \\\\ y(-\\operatorname{sin}⁡(x))+\\operatorname{cos}⁡(x)\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ \\operatorname{cos}⁡(x)\\frac{\\text{d}y}{\\text{d}x} & =y\\operatorname{sin}⁡(x) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{y\\operatorname{sin}⁡(x)}{\\operatorname{cos}⁡(x)}\\end{aligned}\n$$\n\nThe slope of the tangent at the point $(\\frac{\\pi }{3},\\,2)$ is then given by\n\n$$\n\\begin{aligned}m & ={(\\frac{\\text{d}y}{\\text{d}x})}_{(\\pi /3,\\,2)} \\\\  & ={(\\frac{y\\operatorname{sin}⁡(x)}{\\operatorname{cos}⁡(x)})}_{(\\pi /3,\\,2)} \\\\  & =\\frac{2\\cdot \\operatorname{sin}⁡(\\frac{\\pi }{3})}{\\operatorname{cos}⁡(\\frac{\\pi }{3})} \\\\  & =\\frac{2\\cdot (\\frac{\\sqrt{3}}{2})}{(\\frac{1}{2})} \\\\  & =2\\sqrt{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244153 :knowledge-point/_questions [{:db/id #edb/ref 17592186054846 :knowledge-point/id #uuid "2311a895-587e-5609-8a9f-9963b8cae372" :knowledge-point/title "Finding the Slope of the Tangent Line to a Curve Given in Implicit Form at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e607f78-385d-53f6-ab41-74ac877a5a71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186241591} {:answer/id #uuid "32897127-ad14-5eef-9a81-301deb3e2a1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186241624} {:answer/id #uuid "d18a655d-56b1-5123-a490-d7bf85825ed6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186243025} {:answer/id #uuid "dc7ba673-b558-5e38-9cf1-92dadf966d68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{2}" :db/id #edb/ref 17592186243142} {:answer/id #uuid "fd113b97-7abf-5d30-9cb0-076358176a03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186243411}] :answer-field/correct {:answer/id #uuid "32897127-ad14-5eef-9a81-301deb3e2a1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186241624} :answer-field/id #uuid "52dfb695-349e-5936-9fe3-1ad1eeda4511" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243598}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "85cec444-2f0a-598c-bff4-89c6e3584a08" :question/math-academy-id "q-108679" :question/problem "Find the slope of the tangent at the point $(4,\\,4)$ for the curve $\\sqrt{x}+\\sqrt{y}=4.$" :question/worked-solution "To find the slope at a point, we use implicit differentiation to calculate the derivative of the curve, assuming that $y=y(x).$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}+\\sqrt{y}) & =\\frac{\\text{d}}{\\text{d}x}(4) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{1/2}+{y}^{1/2}) & =\\frac{\\text{d}}{\\text{d}x}(4) \\\\ \\frac{1}{2}{x}^{-1/2}+\\frac{1}{2}{y}^{-1/2}(\\frac{\\text{d}y}{\\text{d}x}) & =0 \\\\ \\frac{1}{2}{y}^{-1/2}(\\frac{\\text{d}y}{\\text{d}x}) & =-\\frac{1}{2}{x}^{-1/2} \\\\ \\frac{1}{2\\sqrt{y}}(\\frac{\\text{d}y}{\\text{d}x}) & =-\\frac{1}{2\\sqrt{x}} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{\\sqrt{y}}{\\sqrt{x}}\\end{aligned}\n$$\n\nThe slope of the tangent at the point $(4,\\,4)$ is then given by\n\n$$\n\\begin{aligned}m & ={(\\frac{\\text{d}y}{\\text{d}x})}_{(4,\\,4)} \\\\  & =-{\\frac{\\sqrt{y}}{\\sqrt{x}}}_{(4,\\,4)} \\\\  & =-\\frac{\\sqrt{4}}{\\sqrt{4}} \\\\  & =-\\frac{2}{2} \\\\  & =-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186092507 :knowledge-point/_questions [{:db/id #edb/ref 17592186092385 :knowledge-point/id #uuid "3ba61258-92a9-511e-891f-9e6adce2edb0" :knowledge-point/title "Determining the Intercepts of a Normal Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17dbb435-0cbf-53b0-b774-95a09e5dd5e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,0)" :db/id #edb/ref 17592186241384} {:answer/id #uuid "52de3f96-3021-5e86-a521-dd5eaf2b4c3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,0)" :db/id #edb/ref 17592186241918} {:answer/id #uuid "7aaf9455-fc42-5674-a140-8638e322d2c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,0)" :db/id #edb/ref 17592186242258} {:answer/id #uuid "8b234896-b4c5-57ed-a626-2274af12bce9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(16,0)" :db/id #edb/ref 17592186242411} {:answer/id #uuid "aecf5e6b-c2d8-5faf-a09d-6ece73a85a07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{16}{5},0)" :db/id #edb/ref 17592186242704}] :answer-field/correct {:answer/id #uuid "8b234896-b4c5-57ed-a626-2274af12bce9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(16,0)" :db/id #edb/ref 17592186242411} :answer-field/id #uuid "562461af-5947-5911-b5fb-04453b8765df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243609}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a8debb9f-1a0f-5757-8884-2cca273ae3ea" :question/math-academy-id "q-10871" :question/problem "Find where the normal line to the curve $f(x)=2{x}^{2}+x$ at the point $(1,3)$ intersects the $x$-axis." :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{2}+x)=4x+1.\\end{aligned}\n$$\n\nSo the slope of the tangent line is\n\n$$\nm={f}^{′}(1)=4(1)+1=5,\n$$\n\nand therefore the slope of the normal line is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{5}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-3 & =-\\frac{1}{5}(x-1) \\\\ y & =-\\frac{1}{5}x+\\frac{1}{5}+3 \\\\ y & =-\\frac{1}{5}x+\\frac{16}{5}.\\end{aligned}\n$$\n\nLastly, we find the point of intersection with the $x$-axis by setting $y=0$ and solving the resulting equation. We get\n\n$$\n\\begin{aligned}-\\frac{1}{5}x+\\frac{16}{5} & =0 \\\\ x & =16.\\end{aligned}\n$$\n\nTherefore, the normal line intersects the $x$-axis at $(16,0).$"}] [{:db/id #edb/ref 17592186244174 :knowledge-point/_questions [{:db/id #edb/ref 17592186059677 :knowledge-point/id #uuid "89f65f58-bd3d-5c3f-b9e0-462d74d75b59" :knowledge-point/title "Computing Second Order Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0937fb22-de20-5285-adfe-fb134454e739" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24{x}^{2}-24" :db/id #edb/ref 17592186241260} {:answer/id #uuid "4ade996e-8565-5999-b8b9-37a0812a3215" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{{x}^{5}}}+10" :db/id #edb/ref 17592186241854} {:answer/id #uuid "890e01dc-717c-5668-ab27-67a47e021472" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{{x}^{3}}}+10" :db/id #edb/ref 17592186242385} {:answer/id #uuid "c17a783f-f9eb-533a-858b-97da81489721" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{{x}^{3}}}-10" :db/id #edb/ref 17592186242874} {:answer/id #uuid "e29f5fcc-b099-589c-9900-89b9765edee7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{{x}^{5}}}+10" :db/id #edb/ref 17592186243194}] :answer-field/correct {:answer/id #uuid "890e01dc-717c-5668-ab27-67a47e021472" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{{x}^{3}}}+10" :db/id #edb/ref 17592186242385} :answer-field/id #uuid "4cfdea00-47d2-5a4e-be1a-28b9c2503425" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243586}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2dffb4d9-bf1b-5b2c-8ebe-2cdd8aa443db" :question/math-academy-id "q-10883" :question/problem "Find ${f}^{″}(x)$ for $f(x)=4\\sqrt{x}+5{x}^{2}+x.$" :question/worked-solution "Computing the first derivative, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={(4\\sqrt{x}+5{x}^{2}+x)}^{′} \\\\  & ={(4{x}^{1/2}+5{x}^{2}+x)}^{′} \\\\  & =\\frac{1}{2}\\cdot 4{x}^{-1/2}+2\\cdot 5x+1 \\\\  & =2{x}^{-1/2}+10x+1\\,.\\end{aligned}\n$$\n\nComputing the second derivative, we have\n\n$$\n\\begin{aligned}{f}^{″}(x) & ={(2{x}^{-1/2}+10x+1)}^{′} \\\\  & =-\\frac{1}{2}\\cdot 2{x}^{-3/2}+10+0 \\\\  & =-{x}^{-3/2}+10 \\\\  & =-\\frac{1}{\\sqrt{{x}^{3}}}+10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244185 :knowledge-point/_questions [{:db/id #edb/ref 17592186078435 :knowledge-point/id #uuid "822ee6ad-d15c-518d-b798-1aa2ba84ca20" :knowledge-point/title "Calculating the Number of Terms in an Arithmetic Series Using the Formula for the Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1668a5c1-ce44-5253-9139-e2bc63105e14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186241372} {:answer/id #uuid "5468b1e4-3930-510e-8909-679f6a1139f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186241936} {:answer/id #uuid "546b5cb9-810b-5bb5-9685-ffb7dfce18df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186241937} {:answer/id #uuid "65b96f90-dbd8-59bf-b55b-5cc8a7dd21d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186242095} {:answer/id #uuid "ae907482-607f-575e-93b2-831b50732e9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186242702}] :answer-field/correct {:answer/id #uuid "546b5cb9-810b-5bb5-9685-ffb7dfce18df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186241937} :answer-field/id #uuid "09cccd67-65bb-5607-8ef3-8e4c5b24e99e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243455}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "800f0768-2cd2-5060-956e-d2760762a123" :question/math-academy-id "q-108898" :question/problem "The first term of an arithmetic series is ${a}_{1}=1,$ the common difference is $d=\\frac{1}{2},$ and the sum of the series is ${S}_{N}=52.$ Find the number of terms $N$ in the series." :question/worked-solution "To find the number of terms, we can use the following formula:\n\n$$\n{S}_{N}=\\frac{N}{2}(2{a}_{1}+(N-1)d).\n$$\n\nWe substitute ${a}_{1}=1,$ $d=\\frac{1}{2}$ and ${S}_{N}=52$ into the above and solve for $N$, as follows: \n\n$$\n\\begin{aligned}{S}_{N} & =\\frac{N}{2}(2{a}_{1}+(N-1)d) \\\\ 52 & =\\frac{N}{2}(2\\cdot 1+(N-1)\\cdot \\frac{1}{2}) \\\\ 104 & =N(2+\\frac{N}{2}-\\frac{1}{2}) \\\\ 104 & =\\frac{{N}^{2}}{2}+\\frac{3}{2}N \\\\ {N}^{2}+3N-208 & =0\\end{aligned}\n$$\n\nFor the equation above, the quadratic formula gives:\n\n$$\n\\begin{aligned}N & =\\frac{-3\\pm \\sqrt{{3}^{2}-4\\cdot 1\\cdot (-208)}}{2\\cdot 1} \\\\  & =\\frac{-3\\pm \\sqrt{841}}{2} \\\\  & =\\frac{-3\\pm 29}{2}\\end{aligned}\n$$\n\nHence, $N=13$ or $N=-16.$ We disregard the negative solution since $N$ must be positive.\n\nTherefore, our series has $N=13$ terms."}] [{:db/id #edb/ref 17592186244188 :knowledge-point/_questions [{:db/id #edb/ref 17592186078433 :knowledge-point/id #uuid "df6ae15d-7005-5a93-9432-c4814dc9573d" :knowledge-point/title "Calculating the Number of Terms in an Arithmetic Series Given the Pattern and the Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "228cbcd7-75c6-5292-a55c-93495c591c0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186241479} {:answer/id #uuid "4f72d840-529f-50af-ade3-ec1d004f9f53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186241891} {:answer/id #uuid "8878cc45-2b72-502b-9a3f-1b66b0697af3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "47" :db/id #edb/ref 17592186242379} {:answer/id #uuid "bd5b32da-40f4-5880-b27d-cb00a128a752" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "61" :db/id #edb/ref 17592186242844} {:answer/id #uuid "c11d598f-1556-5751-8870-5240c9000b4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "33" :db/id #edb/ref 17592186242872}] :answer-field/correct {:answer/id #uuid "228cbcd7-75c6-5292-a55c-93495c591c0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186241479} :answer-field/id #uuid "d0127a7b-9cd6-56c9-8f52-6f4a37eb6257" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243805}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "631970bc-7173-5c6f-8c08-2b5a8924de2b" :question/math-academy-id "q-108904" :question/problem "Calculate the number of terms in the following arithmetic series.\n\n$$\n2+2.5+3+…=470\n$$" :question/worked-solution "To solve this problem, we use the formula for the sum of an arithmetic series:\n\n$$\n{S}_{N}=\\frac{N}{2}(2{a}_{1}+(N-1)d)\\,\\,\n$$\n\nWe have been given the sum ${S}_{N}=470,$ and the first term ${a}_{1}=2.$ Our goal is to find $N,$ the number of terms.\n\nThe common difference $d$ can be found, as follows:\n\n$$\n\\begin{aligned}d & ={a}_{2}-{a}_{1} \\\\  & =2.5-2 \\\\  & =0.5\\end{aligned}\n$$\n\nSubstituting these values into the formula for the sum of an arithmetic series, we have:\n\n$$\n\\begin{aligned}{S}_{N} & =\\frac{N}{2}(2{a}_{1}+(N-1)d) \\\\ 470 & =\\frac{N}{2}(2(2)+(N-1)(0.5)) \\\\ 940 & =N(4+0.5N-0.5) \\\\ 940 & =N(0.5N+3.5) \\\\ 940 & =0.5{N}^{2}+3.5N \\\\ 0.5{N}^{2}+3.5N-940 & =0 \\\\ {N}^{2}+7N-1\\,880 & =0\\end{aligned}\n$$\n\nFor the equation above, the quadratic formula gives:\n\n$$\n\\begin{aligned}N & =\\frac{-7\\pm \\sqrt{(-7)^{2}-4\\cdot 1\\cdot (-1\\,880)}}{2\\cdot 1} \\\\  & =\\frac{-7\\pm \\sqrt{7\\,569}}{2} \\\\  & =\\frac{-7\\pm 87}{2}\\end{aligned}\n$$\n\nHence, $N=40$ or $N=-47.$ We disregard the negative solution since $N$ must be positive.\n\nTherefore, our series has $N=40$ terms."}] [{:db/id #edb/ref 17592186244197 :knowledge-point/_questions [{:db/id #edb/ref 17592186078434 :knowledge-point/id #uuid "5b23f178-4161-56d3-98e0-00b3181417e2" :knowledge-point/title "Calculating the Number of Terms in an Arithmetic Series Given Two Terms and the Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "378d2847-7ad2-5a12-9850-47b25579a9f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186241671} {:answer/id #uuid "42646d11-10a8-5a63-8da2-3a558121ded2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186241776} {:answer/id #uuid "57f3b6ea-0be7-58bf-91c2-5ab29f5e24c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186241976} {:answer/id #uuid "d84297cb-155e-5323-b0ab-48e29cf60eb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186243103} {:answer/id #uuid "d8adbf92-d80c-56ae-b029-da2918a6c9de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186243106}] :answer-field/correct {:answer/id #uuid "d8adbf92-d80c-56ae-b029-da2918a6c9de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186243106} :answer-field/id #uuid "67ee6136-7c75-5b1b-bb3a-e9d5e1c03e2e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243643}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ee6eaf1a-ba17-5552-a200-48d6ea0ebb7b" :question/math-academy-id "q-108928" :question/problem "An arithmetic series has the first term ${a}_{1}=-3,$ the second term is ${a}_{2}=0,$ and the sum of the series is ${S}_{N}=27.$ Find the number of terms $N$ in the series." :question/worked-solution "To solve this problem, we use the formula for the sum of an arithmetic series.\n\n$$\n{S}_{N}=\\frac{N}{2}(2{a}_{1}+(N-1)d)\n$$\n\nSince we know the first two terms of the arithmetic series, we can find its common difference, as follows:\n\n$$\n\\begin{aligned}d & ={a}_{2}-{a}_{1}=3\\end{aligned}\n$$\n\nNow, substituting ${a}_{1}=-3,$ $d=3,$ and ${S}_{N}=27$ into the formula for the sum of an arithmetic series, we have:\n\n$$\n\\begin{aligned}{S}_{N} & =\\frac{N}{2}(2{a}_{1}+(N-1)d) \\\\ 27 & =\\frac{N}{2}(2(-3)+(N-1)(3)) \\\\ 54 & =N(-6+3N-3) \\\\ 54 & =N(3N-9) \\\\ 54 & =3{N}^{2}-9N\\end{aligned}\n$$\n\nFactoring the above equation gives:\n\n$$\n\\begin{aligned}3{N}^{2}-9N-54 & =0 \\\\ {N}^{2}-3N-18 & =0 \\\\ (N-6)(N+3) & =0 \\\\ N & =6\\end{aligned}\n$$\n\nNotice that we take the positive solution because $N$ can't be negative."}] [{:db/id #edb/ref 17592186386329 :knowledge-point/_questions [{:db/id #edb/ref 17592186064369 :knowledge-point/id #uuid "81d5fa54-0b80-52c1-97d7-6f8fb231f692" :knowledge-point/title "Calculating the Velocity of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ba0f630-2f65-5ebb-9ef9-7e215b9a8e6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(t)=\\frac{t+1}{({t}^{2}+1)^{2}}" :db/id #edb/ref 17592186386331} {:answer/id #uuid "f67a34cc-bdd7-5109-9e49-3aa73823a730" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(t)=\\frac{t+2}{{t}^{2}+1}" :db/id #edb/ref 17592186386332} {:answer/id #uuid "c13cdfa8-c254-5851-9c01-b69045d39098" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(t)=\\frac{2{t}^{2}}{{t}^{2}+1}" :db/id #edb/ref 17592186386333} {:answer/id #uuid "fb33e651-cb52-5f09-b8c1-872e7acf356e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(t)=\\frac{2t}{({t}^{2}+1)^{2}}" :db/id #edb/ref 17592186386334} {:answer/id #uuid "c61cc750-e5d1-5559-b9f2-17126e07ceef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(t)=\\frac{2}{{t}^{2}+1}" :db/id #edb/ref 17592186386335}] :answer-field/correct {:answer/id #uuid "fb33e651-cb52-5f09-b8c1-872e7acf356e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(t)=\\frac{2t}{({t}^{2}+1)^{2}}" :db/id #edb/ref 17592186386334} :answer-field/id #uuid "3e7b11db-5579-5d23-8dd0-1d60abf80b79" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386330}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "68190923-09f1-522b-b256-54bea9ce1f9c" :question/math-academy-id "q-109000" :question/problem "The position $x$ of a particle at time $t$ is given by $x(t)=\\frac{{t}^{2}}{{t}^{2}+1}.$ Calculate the velocity at time $t.$" :question/worked-solution "The velocity is the derivative of the position function $x(t)$ with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}x}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{{t}^{2}}{{t}^{2}+1}) \\\\  & =\\frac{2t({t}^{2}+1)-{t}^{2}(2t)}{({t}^{2}+1)^{2}} \\\\  & =\\frac{2{t}^{3}+2t-2{t}^{3}}{({t}^{2}+1)^{2}} \\\\  & =\\frac{2t}{({t}^{2}+1)^{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386336 :knowledge-point/_questions [{:db/id #edb/ref 17592186064371 :knowledge-point/id #uuid "45b380ed-1974-5876-8c88-a45773741b48" :knowledge-point/title "Calculating the Speed of a Particle at a Particular Moment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ad1c91f-8f94-5d43-a015-0df4347e3b34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\text{miles/h}" :db/id #edb/ref 17592186386338} {:answer/id #uuid "310152fb-5481-5acf-b0d8-91619d3b8169" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\,\\text{miles/h}" :db/id #edb/ref 17592186386339} {:answer/id #uuid "adcedacc-6f21-533a-91b1-d246d25b6c18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\,\\text{miles/h}" :db/id #edb/ref 17592186386340} {:answer/id #uuid "a069c0c1-7f30-50e9-827f-c04f4b7ee402" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}\\,\\text{miles/h}" :db/id #edb/ref 17592186386341} {:answer/id #uuid "ea1abc4d-2e9f-52d6-8953-d8678f00178e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,\\text{miles/h}" :db/id #edb/ref 17592186386342}] :answer-field/correct {:answer/id #uuid "310152fb-5481-5acf-b0d8-91619d3b8169" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\,\\text{miles/h}" :db/id #edb/ref 17592186386339} :answer-field/id #uuid "2ab55df5-5342-5b9d-ac07-93197546e743" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386337}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d585be43-c802-5898-9f5b-2c2fe6d06f55" :question/math-academy-id "q-109012" :question/problem "The position $s(t)$ of a particle (in miles) at time $t$ hours is given by \n\n$$\ns(t)=\\frac{3}{t},\\,t>0.\n$$\n\nCalculate the speed of the particle when $t=3\\,\\text{h}.$" :question/worked-solution "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{3}{t}) \\\\  & =-\\frac{3}{{t}^{2}}\\end{aligned}\n$$\n\nWhen $t=3,$ the velocity is\n\n$$\nv(3)=-\\frac{3}{{3}^{2}}=-\\frac{1}{3}.\n$$\n\nTherefore, the speed is $|-\\frac{1}{3}|=\\frac{1}{3}\\,\\text{miles/h}.$"}] [{:db/id #edb/ref 17592186059986 :knowledge-point/_questions [{:db/id #edb/ref 17592186059678 :knowledge-point/id #uuid "6afb4058-908a-5983-9c1e-78ee3fbadf44" :knowledge-point/title "Computing Second Order Derivatives Using Leibnitz Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23efc5ef-2690-54f2-bee2-55957c887e24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60{x}^{2}+12" :db/id #edb/ref 17592186241494} {:answer/id #uuid "540b13bd-f4ff-5df5-a485-37254ae4135c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60{x}^{2}+8" :db/id #edb/ref 17592186241934} {:answer/id #uuid "864b257c-04a1-57df-ba29-1fda8aa650a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60{x}^{2}+8x" :db/id #edb/ref 17592186242356} {:answer/id #uuid "c9c4addb-f175-5120-8653-b40175f4b448" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30{x}^{2}+8" :db/id #edb/ref 17592186242960} {:answer/id #uuid "cd2989ae-1b63-5358-ae2f-b0968d4a0f14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60{x}^{3}+8" :db/id #edb/ref 17592186242985}] :answer-field/correct {:answer/id #uuid "540b13bd-f4ff-5df5-a485-37254ae4135c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60{x}^{2}+8" :db/id #edb/ref 17592186241934} :answer-field/id #uuid "17955a33-082e-5b39-af43-2edeaac25d20" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243479}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b7a8a2be-ff9a-5f4a-96bd-e383a3bb4443" :question/math-academy-id "q-10903" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y=5{x}^{4}+4{x}^{2}.$" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(5{x}^{4}+4{x}^{2}) \\\\  & =4\\cdot 5{x}^{3}+2\\cdot 4x \\\\  & =20{x}^{3}+8x\\,.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(20{x}^{3}+8x) \\\\  & =3\\cdot 20{x}^{2}+8 \\\\  & =60{x}^{2}+8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244250 :knowledge-point/_questions [{:db/id #edb/ref 17592186059751 :knowledge-point/id #uuid "2e1b4442-eca7-5283-9d5d-5bcbd1d67975" :knowledge-point/title "Calculating a Minor in a 3x3 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a9ee733-0369-5383-98cf-d57199634ade" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186241275} {:answer/id #uuid "40bf570b-0c28-5b93-a302-1dc3fb653a1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186241758} {:answer/id #uuid "7d689186-2be7-5416-bc98-d1d5fe22acb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186242279} {:answer/id #uuid "942ccf7d-5d78-5f28-9073-6d9a3b731eee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-42" :db/id #edb/ref 17592186242480} {:answer/id #uuid "abbf1cc6-5ea9-587f-9f60-4f1101db2fc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186242680}] :answer-field/correct {:answer/id #uuid "7d689186-2be7-5416-bc98-d1d5fe22acb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186242279} :answer-field/id #uuid "783ab98e-8260-54c9-b8b7-0c860e9b9a51" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243670}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "926e7b3c-e48b-52a2-9640-544759dee372" :question/math-academy-id "q-1092" :question/problem "Calculate the minor of the entry ${b}_{22}$ in the matrix\n$B=[\\begin{aligned}3 & 13 & -6 \\\\ 2 & 7 & 0 \\\\ 5 & 0 & 4\\end{aligned}].$" :question/worked-solution "The minor of ${b}_{22}=7$ (second row, second column) is the determinant of the remaining entries when the column and row containing $7$ are removed: \n\n$$\nB=[\\begin{aligned}3 & ∗ & -6 \\\\ ∗ & 7 & ∗ \\\\ 5 & ∗ & 4\\end{aligned}]\n$$\n\n \n\nSo, the minor of ${b}_{22}=7$ is\n\n$$\n\\begin{aligned}\\text{det}[\\begin{aligned}3 & -6 \\\\ 5 & 4\\end{aligned}] & =|\\begin{aligned}3 & -6 \\\\ 5 & 4\\end{aligned}| \\\\  & =3\\cdot 4-(-6)\\cdot 5 \\\\  & =12-(-30) \\\\  & =42.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244264 :knowledge-point/_questions [{:db/id #edb/ref 17592186176096 :knowledge-point/id #uuid "e21f194e-fb5d-5c90-af38-18d8c75582a9" :knowledge-point/title "Finding a Moment in Time When a Particle is Stationary"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a8a3d75-29ea-5726-b242-46493c581fe1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=1\\,\\text{s}" :db/id #edb/ref 17592186241557} {:answer/id #uuid "300df47b-b9e0-5957-8f13-b778f88e3b41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{1}{2}\\,\\text{s}" :db/id #edb/ref 17592186241609} {:answer/id #uuid "458e6df8-c4b8-5e51-a675-25da3ce4e6be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=3\\,\\text{s}" :db/id #edb/ref 17592186241805} {:answer/id #uuid "7f046870-004c-57c6-8028-e12381de9387" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=2\\,\\text{s}" :db/id #edb/ref 17592186242297} {:answer/id #uuid "d4624b7d-a819-5b66-9c7d-9ee3dc8ad598" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{3}{2}\\,\\text{s}" :db/id #edb/ref 17592186243058}] :answer-field/correct {:answer/id #uuid "458e6df8-c4b8-5e51-a675-25da3ce4e6be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=3\\,\\text{s}" :db/id #edb/ref 17592186241805} :answer-field/id #uuid "6c21b487-70f8-58fd-9e35-6199acee103a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243651}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "86745f4a-9b3a-5cb4-90c7-0e4ceefd13ac" :question/math-academy-id "q-109275" :question/problem "The position $s(t)$ of a particle (in meters) at time $t$ seconds is given by \n\n$$\ns(t)=\\operatorname{ln}⁡({t}^{2}-6t+10),\\,t\\ge 0.\n$$\n\nCalculate the time at which the particle is stationary." :question/worked-solution "The particle is stationary when its velocity is zero. So first, we need to calculate the velocity function. We can do that by taking the derivative of the position function, as follows:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡({t}^{2}-6t+10)) \\\\  & =\\frac{2t-6}{{t}^{2}-6t+10} \\\\  & =\\frac{2(t-3)}{{t}^{2}-6t+10}\\end{aligned}\n$$\n\nThe particle is stationary when $v=0\\,\\text{m/s}.$ So, we set $v=0$ and solve for $t:$\n\n$$\n\\begin{aligned}\\frac{2(t-3)}{{t}^{2}-6t+10} & =0 \\\\ 2(t-3) & =0 \\\\ t & =3\\end{aligned}\n$$\n\nTherefore, the particle is stationary at $t=3\\,\\text{s}.$"}] [{:db/id #edb/ref 17592186244267 :knowledge-point/_questions [{:db/id #edb/ref 17592186175939 :knowledge-point/id #uuid "f8f3989e-bde0-5b3a-8d45-08f34d330c3f" :knowledge-point/title "Determining Intervals of Increasing or Decreasing Displacement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5491f591-d1f5-5096-bb5a-362b607a745d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{{e}^{2}},\\infty )" :db/id #edb/ref 17592186241940} {:answer/id #uuid "59724b05-5748-5ef6-8e67-bfdc7ae500d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,e)" :db/id #edb/ref 17592186241986} {:answer/id #uuid "9ddbbecb-379e-5707-a279-ee668273978e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(e,\\infty )" :db/id #edb/ref 17592186242559} {:answer/id #uuid "b3001024-ad85-5df3-9361-f47fa75ca379" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\frac{1}{{e}^{2}})" :db/id #edb/ref 17592186242737} {:answer/id #uuid "b5c50f32-5bbb-538d-a220-076d076e5442" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\frac{2}{e})" :db/id #edb/ref 17592186242769}] :answer-field/correct {:answer/id #uuid "b3001024-ad85-5df3-9361-f47fa75ca379" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\frac{1}{{e}^{2}})" :db/id #edb/ref 17592186242737} :answer-field/id #uuid "1cb803c2-293d-5947-803b-a292a21a42c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243495}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8de2ca9e-4b83-5dd2-84c1-5e6128a2ad43" :question/math-academy-id "q-109289" :question/problem "The displacement $s,$ in meters, relative to a fixed origin $O$ of a particle moving in a straight line along the $x$-axis is given by $s(t)=\\sqrt{t}\\,\\operatorname{ln}⁡t,$ where $t>0$ is the time measured in seconds. Determine the time intervals in which the particle is moving in the direction of decreasing $x.$" :question/worked-solution "If the particle moves in the direction of decreasing $x,$ then its velocity is negative. \n\nFirst, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\sqrt{t}\\,\\operatorname{ln}⁡t) \\\\  & =\\frac{\\operatorname{ln}⁡t}{2\\sqrt{t}}+\\frac{\\sqrt{t}}{t} \\\\  & =\\frac{\\operatorname{ln}⁡t}{2\\sqrt{t}}+\\frac{1}{\\sqrt{t}} \\\\  & =\\frac{\\operatorname{ln}⁡t+2}{2\\sqrt{t}}\\end{aligned}\n$$\n\nTo calculate time intervals in which the particle is moving in the direction of decreasing $x$, we solve the inequality $v(t)<0:$\n\n$$\n\\begin{aligned}v(t) & <0 \\\\ \\frac{\\operatorname{ln}⁡t+2}{2\\sqrt{t}} & <0 \\\\ \\operatorname{ln}⁡t+2 & <0 \\\\ \\operatorname{ln}⁡t & <-2 \\\\ t & <{e}^{-2} \\\\ t & <\\frac{1}{{e}^{2}}\\end{aligned}\n$$\n\nTherefore, the time interval in which the particle is moving to the direction of decreasing $x$ is $t\\in (0,\\frac{1}{{e}^{2}}).$"}] [{:db/id #edb/ref 17592186399664 :knowledge-point/_questions [{:db/id #edb/ref 17592186176099 :knowledge-point/id #uuid "bee6d4bf-79da-5eb3-a214-8c045dbce5bd" :knowledge-point/title "Calculating the Velocity of a Particle at the Moment When Its Acceleration is Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5103ad76-a94a-5286-8ba5-a77f53f60465" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=1,\\,v=\\frac{15}{2}" :db/id #edb/ref 17592186399666} {:answer/id #uuid "8436223b-700a-5cfc-999b-c15dd1c4967a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{3}{2},\\,v=-\\frac{21}{2}" :db/id #edb/ref 17592186399667} {:answer/id #uuid "48bbfde1-4a90-5800-90a2-a13b81b7ffae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=1,\\,v=-7" :db/id #edb/ref 17592186399668} {:answer/id #uuid "dbee7bb0-5392-5018-a5d9-d29c6d9994e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{3}{2},\\,v=9" :db/id #edb/ref 17592186399669} {:answer/id #uuid "9445423e-a521-575c-b99b-639347c58fec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{1}{2},\\,v=-\\frac{8}{3}" :db/id #edb/ref 17592186399670}] :answer-field/correct {:answer/id #uuid "8436223b-700a-5cfc-999b-c15dd1c4967a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{3}{2},\\,v=-\\frac{21}{2}" :db/id #edb/ref 17592186399667} :answer-field/id #uuid "689f3bd0-df18-5a92-92e6-a4a5162ad010" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399665}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6414dac4-9443-5e38-b246-ae2ca315e478" :question/math-academy-id "q-109302" :question/problem "A particle $P$ is traveling along the $x$-axis with displacement $s(t)$ from a fixed origin $O$ given by\n\n$$\ns(t)=2{t}^{3}-9{t}^{2}+3t-2,\\,t\\ge 0.\n$$\n\nFind the time at which the acceleration is zero, and find the value of the velocity at this moment." :question/worked-solution "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2{t}^{3}-9{t}^{2}+3t-2) \\\\  & =6{t}^{2}-18t+3\\end{aligned}\n$$\n\nNow, we differentiate $v(t)$ to find $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(6{t}^{2}-18t+3) \\\\  & =12t-18\\end{aligned}\n$$\n\nNext, we put $a=0$ to find the time when the acceleration is zero:\n\n$$\n\\begin{aligned}12t-18 & =0 \\\\ t & =\\frac{18}{12} \\\\ t & =\\frac{3}{2}\\end{aligned}\n$$\n\nNow, the acceleration is zero when $t=\\frac{3}{2}.$ To find the velocity at this moment, we substitute this back into $v(t)$ to get\n\n$$\n\\begin{aligned}v(\\frac{3}{2}) & =6{(\\frac{3}{2})}^{2}-18(\\frac{3}{2})+3 \\\\  & =6(\\frac{9}{4})-27+3 \\\\  & =\\frac{27}{2}-27+3 \\\\  & =-\\frac{21}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186399671 :knowledge-point/_questions [{:db/id #edb/ref 17592186176099 :knowledge-point/id #uuid "bee6d4bf-79da-5eb3-a214-8c045dbce5bd" :knowledge-point/title "Calculating the Velocity of a Particle at the Moment When Its Acceleration is Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1f8e3ed-64ac-534b-9097-97dd33f2545d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{3}{2},\\,v=-\\frac{9}{2}" :db/id #edb/ref 17592186399673} {:answer/id #uuid "106f9321-de03-58f4-8540-f31885a755c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=2,\\,v=-4" :db/id #edb/ref 17592186399674} {:answer/id #uuid "084bda93-d0d6-514b-b8c7-73ce821b2053" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{7}{3},\\,v=\\frac{49}{3}" :db/id #edb/ref 17592186399675} {:answer/id #uuid "367c159c-f8cf-54ab-9cdc-cfddc4ed2a5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=2,\\,v=6" :db/id #edb/ref 17592186399676} {:answer/id #uuid "212ea060-615f-5258-8e09-ac350ea1ca59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{7}{3},\\,v=\\frac{15}{6}" :db/id #edb/ref 17592186399677}] :answer-field/correct {:answer/id #uuid "084bda93-d0d6-514b-b8c7-73ce821b2053" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{7}{3},\\,v=\\frac{49}{3}" :db/id #edb/ref 17592186399675} :answer-field/id #uuid "1669c4fe-448a-5ecd-96c2-60941d083824" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399672}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7704a427-55d1-5f8e-bf57-d941d8544127" :question/math-academy-id "q-109307" :question/problem "A particle $P$ is traveling along the $x$-axis with displacement $s(t)$ from a fixed origin $O$ given by\n\n$$\ns(t)=7{t}^{2}-{t}^{3},\\,t\\ge 0.\n$$\n\nFind the time at which the acceleration is zero, and find the value of the velocity at this moment." :question/worked-solution "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(7{t}^{2}-{t}^{3}) \\\\  & =14t-3{t}^{2}\\end{aligned}\n$$\n\nNow, we differentiate $v(t)$ to find $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(14t-3{t}^{2}) \\\\  & =14-6t\\end{aligned}\n$$\n\nNext, we put $a=0$ to find the time when the acceleration is zero:\n\n$$\n\\begin{aligned}14-6t & =0 \\\\ -6t & =-14 \\\\ t & =\\frac{7}{3}\\end{aligned}\n$$\n\nNow, the acceleration is zero when $t=\\frac{7}{3}.$ To find the velocity at this moment, we substitute this back into $v(t)$ to get\n\n$$\n\\begin{aligned}v(\\frac{7}{3}) & =14(\\frac{7}{3})-3{(\\frac{7}{3})}^{2} \\\\  & =\\frac{98}{3}-\\frac{49}{3} \\\\  & =\\frac{49}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247047 :knowledge-point/_questions [{:db/id #edb/ref 17592186096756 :knowledge-point/id #uuid "96967f25-565a-5338-878e-00fd30055772" :knowledge-point/title "Calculating the Area Bounded Below a Curve and Above the X-Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c99c79c-7899-501c-aa44-8e028899ea3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{19}{6}" :db/id #edb/ref 17592186245273} {:answer/id #uuid "84dd79d9-148d-56b1-b230-e49870bdeafb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{6}" :db/id #edb/ref 17592186245486} {:answer/id #uuid "966fea7b-7981-584d-9f83-ee03b91e4ea3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{27}{2}" :db/id #edb/ref 17592186245640} {:answer/id #uuid "9e9c6db4-7556-54fb-9a9d-10994687003e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{6}" :db/id #edb/ref 17592186245729} {:answer/id #uuid "d16bb5fe-bb92-5361-9748-3bb2cfa9f2fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{19}{6}" :db/id #edb/ref 17592186246178}] :answer-field/correct {:answer/id #uuid "9e9c6db4-7556-54fb-9a9d-10994687003e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{6}" :db/id #edb/ref 17592186245729} :answer-field/id #uuid "a9b4af2b-1c9c-51fa-b90d-538ea68ce074" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246851}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9331fa0c-5003-5d00-8a98-a52c36a44bdd" :question/math-academy-id "q-10978" :question/problem "![](images/09/09482b1e9903bff25b16b2239975831e6d54440a8f8ea78f5739b0eafee3d9e8.png)\n\nFind the area between the curve $y=-2{x}^{2}-x+3$, the $x$-axis and the $y$-axis, shown above." :question/worked-solution "To find the area, we just need to compute the corresponding definite integral:\n\n$$\n\\begin{aligned}A & ={\\int }_{a}^{b}y(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}(-2{x}^{2}-x+3)\\,\\text{d}x \\\\  & =-2{\\int }_{0}^{1}{x}^{2}\\,\\text{d}x-1{\\int }_{0}^{1}x\\,\\text{d}x+3{\\int }_{0}^{1}\\,\\text{d}x \\\\  & =-2\\cdot {\\frac{{x}^{3}}{3}|}_{0}^{1}-1\\cdot {\\frac{{x}^{2}}{2}|}_{0}^{1}+3x{|}_{0}^{1} \\\\  & =-2(\\frac{1}{3}-0)-1(\\frac{1}{2}-0)+3(1-0) \\\\  & =-\\frac{2}{3}-\\frac{1}{2}+3 \\\\  & =\\frac{11}{6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247055 :knowledge-point/_questions [{:db/id #edb/ref 17592186096683 :knowledge-point/id #uuid "7e66d7cf-1a4b-51e6-9c78-f70a8c0555df" :knowledge-point/title "Expressing a Rational Function With Three Linear Factors as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41194700-a88a-5de8-9f24-f3c32143a64f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{(3-x)}-\\frac{5}{(2-x)}+\\frac{1}{(x+1)}" :db/id #edb/ref 17592186244885} {:answer/id #uuid "4e422a04-18f2-59e2-a393-df7b6a8004be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{(3-x)}+\\frac{1}{(2-x)}-\\frac{6}{(x+1)}" :db/id #edb/ref 17592186245007} {:answer/id #uuid "9c91ab1d-3d06-53b3-b5e5-8f8fe8bb4e69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{(3-x)}+\\frac{10}{(2-x)}-\\frac{2}{(x+1)}" :db/id #edb/ref 17592186245704} {:answer/id #uuid "b74f8f7b-03ab-5c30-a84d-e353f0aaedcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{(3-x)}+\\frac{2}{(2-x)}-\\frac{5}{(x+1)}" :db/id #edb/ref 17592186245951} {:answer/id #uuid "db943c38-ecc5-5aae-b0af-de25da6bb882" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{(3-x)}-\\frac{4}{(2-x)}+\\frac{9}{(x+1)}" :db/id #edb/ref 17592186246262}] :answer-field/correct {:answer/id #uuid "b74f8f7b-03ab-5c30-a84d-e353f0aaedcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{(3-x)}+\\frac{2}{(2-x)}-\\frac{5}{(x+1)}" :db/id #edb/ref 17592186245951} :answer-field/id #uuid "98e9c5d2-341d-5db4-a4e2-54315de20ea2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246814}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "400ab8c9-505d-514d-9b8b-a37c002e9bd9" :question/math-academy-id "q-10986" :question/problem "Express $\\frac{22x-38}{(3-x)(2-x)(x+1)}$ as a sum of partial fractions." :question/worked-solution "Our task is to find $A,$ $B$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{22x-38}{(3-x)(2-x)(x+1)} & =\\frac{A}{(3-x)}+\\frac{B}{(2-x)}+\\frac{C}{(x+1)}.\\end{aligned}\n$$\n\nMultiplying both sides by $(3-x)(2-x)(x+1)$ gives\n\n$$\n22x-38=A(2-x)(x+1)+B(3-x)(x+1)+C(3-x)(2-x).\n$$\n\nFor $x=3$, we get \n\n$$\n\\begin{aligned}22(3)-38 & =A(2-3)(3+1) \\\\  & \\,+B(3-3)(3+1) \\\\  & \\,+C(3-3)(2-3) \\\\ 66-38 & =A(-4) \\\\ A & =\\frac{28}{-4} \\\\ A & =-7.\\end{aligned}\n$$\n\nFor $x=2$, we get \n\n$$\n\\begin{aligned}22(2)-38 & =A(2-2)(2+1) \\\\  & \\,+B(3-2)(2+1) \\\\  & \\,+C(3-2)(2-2) \\\\ 44-38 & =B(3) \\\\ B & =\\frac{6}{3} \\\\ B & =2.\\end{aligned}\n$$\n\nFor $x=-1$, we get \n\n$$\n\\begin{aligned}22(-1)-38 & =A(2-(-1))(-1+1) \\\\  & \\,+B(3-(-1))(-1+1) \\\\  & \\,+C(3-(-1))(2-(-1)) \\\\ -22-38 & =C(12) \\\\ C & =\\frac{-60}{12} \\\\ C & =-5.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\frac{22x-38}{(3-x)(2-x)(x+1)}=-\\frac{7}{(3-x)}+\\frac{2}{(2-x)}-\\frac{5}{(x+1)}.\n$$"}] [{:db/id #edb/ref 17592186247056 :knowledge-point/_questions [{:db/id #edb/ref 17592186096683 :knowledge-point/id #uuid "7e66d7cf-1a4b-51e6-9c78-f70a8c0555df" :knowledge-point/title "Expressing a Rational Function With Three Linear Factors as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fc1086c-ae6d-5627-a9bf-0594bb709ade" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186244742} {:answer/id #uuid "b2d0c3be-0fd6-5bf4-bf9e-8621adbd759c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186245906} {:answer/id #uuid "bdfb317b-c63e-55f3-a734-4593cadb4bb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186246006} {:answer/id #uuid "cae876a4-e90f-5e79-9cf3-81a298ccd0f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186246119} {:answer/id #uuid "e971006f-f0a6-5a44-9eee-63de0ba56858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186246383}] :answer-field/correct {:answer/id #uuid "e971006f-f0a6-5a44-9eee-63de0ba56858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186246383} :answer-field/id #uuid "c2cbe5ea-38be-5f8f-ad09-74a001ac8e73" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246898}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "eed23ce3-ed2f-59db-8baa-f9c235e009f0" :question/math-academy-id "q-10988" :question/problem "Given that\n\n$$\n\\frac{13{x}^{2}-19x-16}{(3x+2)(x-3)(x+1)}=\\frac{A}{(3x+2)}+\\frac{B}{(x-3)}+\\frac{C}{(x+1)},\n$$\n\nwhere $A,$ $B$ and $C$ are real constants, calculate $A+B+C.$" :question/worked-solution "Our task is to find $A,$ $B$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{13{x}^{2}-19x-16}{(3x+2)(x-3)(x+1)}=\\frac{A}{(3x+2)}+\\frac{B}{(x-3)}+\\frac{C}{(x+1)}.\\end{aligned}\n$$\n\nMultiplying both sides by $(3x+2)(x-3)(x+1)$ gives\n\n$$\n13{x}^{2}-19x-16=A(x-3)(x+1)+B(3x+2)(x+1)+C(3x+2)(x-3).\n$$\n\nFor $x=-\\frac{2}{3}$, we get \n\n$$\n\\begin{aligned}13{(-\\frac{2}{3})}^{2}-19(-\\frac{2}{3})-16 & =A(-\\frac{2}{3}-3)(-\\frac{2}{3}+1) \\\\  & \\,+B(3(-\\frac{2}{3})+2)(-\\frac{2}{3}+1) \\\\  & \\,+C(3(-\\frac{2}{3})+1)(-\\frac{2}{3}-3) \\\\ \\frac{52}{9}+\\frac{38}{3}-16 & =A(\\frac{(-11)(1)}{9}) \\\\ \\frac{52+114-144}{9} & =A(-\\frac{11}{9}) \\\\ A & =-\\frac{22}{11} \\\\ A & =-2.\\end{aligned}\n$$\n\nFor $x=3$, we obtain\n\n$$\n\\begin{aligned}13(3)^{2}-19(3)-16 & =A(3-3)(3+1) \\\\  & \\,+B(3(3)+2)(3+1) \\\\  & \\,+C(3(3)+2)(3-3) \\\\ 117-57-16 & =B(44) \\\\ B & =\\frac{44}{44} \\\\ B & =1.\\end{aligned}\n$$\n\nFor $x=-1$, we get \n\n$$\n\\begin{aligned}13(-1)^{2}-19(-1)-16 & =A(-1-3)(-1+1) \\\\  & \\,+B(3(-1)+2)(-1+1) \\\\  & \\,+C(3(-1)+2)(-1-3) \\\\ 13+19-16 & =C(4) \\\\ C & =\\frac{16}{4} \\\\ C & =4.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\begin{aligned}A+B+C & =(-2)+1+4=3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386494 :knowledge-point/_questions [{:db/id #edb/ref 17592186184137 :knowledge-point/id #uuid "7c9ceefc-3aa8-5c13-90a1-e4a084f720cc" :knowledge-point/title "Identifying the Graph of a Strict Inequality Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d272ed1-e481-5274-b5b3-9ee482390899" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1e/1e408923db2c7223715b9f82a2777a411e2c79b3614320975c237f2f503f2368.png" :db/id #edb/ref 17592186386496} {:answer/id #uuid "314c8fa8-fac6-5a5a-8685-cfb75d2ef5b2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/45/458a5dd519867a662237d7b52e44627d1867f25dcceeea446203a42571f91a00.png" :db/id #edb/ref 17592186386497} {:answer/id #uuid "54171b3e-5c85-5a7c-99c4-2b8f08fab4bb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/06/0668624761edfaf6f67a69d6059e7b0c54acd87042ec9f7400f1d4c2dfc5ff0b.png" :db/id #edb/ref 17592186386498} {:answer/id #uuid "888d0751-57e8-58b8-90b7-d9a53cbba2c3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/eb/ebf7fd57f5d07afebc22899418ce34d14e59dcdb2a01087950de675b7086f405.png" :db/id #edb/ref 17592186386499} {:answer/id #uuid "a3ceb939-864d-5395-af79-c1a55b359002" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a1/a16d99b349797e305083d8295ef098fbfbe3ea82970b5a48606ea5c678e08262.png" :db/id #edb/ref 17592186386500}] :answer-field/correct {:answer/id #uuid "a3ceb939-864d-5395-af79-c1a55b359002" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a1/a16d99b349797e305083d8295ef098fbfbe3ea82970b5a48606ea5c678e08262.png" :db/id #edb/ref 17592186386500} :answer-field/id #uuid "56cf31dd-5756-5666-b3b0-415b7baf39bd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386495}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3626480d-f8b9-54d9-af65-fe6ef10bb1f3" :question/math-academy-id "q-109942" :question/problem "Which of the following shaded areas describes the region bounded by the inequality $5x-10y<-20?$" :question/worked-solution "First, we convert the inequality into slope-intercept form:\n\n$$\n\\begin{aligned}5x-10y & <-20 \\\\ -10y & <-5x-20 \\\\ 10y & >5x+20 \\\\ y & >\\frac{1}{2}x+2\\end{aligned}\n$$\n\nNow, we proceed as usual. We start by drawing the corresponding straight line $y=\\frac{1}{2}x+2.$ Since the inequality involves a 'strictly greater than' sign, the line $y=\\frac{1}{2}x+2$ itself is *not* part of the solution. Therefore, we draw a dashed line.\n\nThen, we need to decide whether to shade above or below the line. The inequality $y>\\frac{1}{2}x+2$ refers to the $y$-values that are *greater than* those on the line $y=\\frac{1}{2}x+2,$ so we shade *above* the line.\n\n![](images/35/351bb4b4324432e2cc747e67dac22100da3c9e5318339832efa046f504394c35.png)"}] [{:db/id #edb/ref 17592186247067 :knowledge-point/_questions [{:db/id #edb/ref 17592186096818 :knowledge-point/id #uuid "c30dc350-d0c9-5a4d-87a0-4e2ebb1bb221" :knowledge-point/title "Calculating a Three-Term Partial Fraction Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "016d575c-9081-57b4-bc08-75eca4d55fd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{x+7}-\\frac{2}{(x+7)^{2}}+\\frac{2}{x-3}" :db/id #edb/ref 17592186244321} {:answer/id #uuid "1fb63833-17e5-50c3-9e6a-d4d5100a43f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{x+7}+\\frac{4}{(x+7)^{2}}+\\frac{2}{x-3}" :db/id #edb/ref 17592186244594} {:answer/id #uuid "6149c2b7-cb65-56f0-9ed7-b239ad10c444" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{x+7}+\\frac{4}{(x+7)^{2}}+\\frac{2}{x-3}" :db/id #edb/ref 17592186245162} {:answer/id #uuid "8da28e65-e1f3-5260-b060-5b17b3b2e13d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{x+7}-\\frac{2}{(x+7)^{2}}-\\frac{4}{x-3}" :db/id #edb/ref 17592186245553} {:answer/id #uuid "cfac0ef7-8b50-5c6d-a5bf-75a8af09617f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{x+7}+\\frac{4}{(x+7)^{2}}-\\frac{4}{x-3}" :db/id #edb/ref 17592186246167}] :answer-field/correct {:answer/id #uuid "6149c2b7-cb65-56f0-9ed7-b239ad10c444" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{x+7}+\\frac{4}{(x+7)^{2}}+\\frac{2}{x-3}" :db/id #edb/ref 17592186245162} :answer-field/id #uuid "4f9ef799-ff43-5ebd-af86-0243a466e65c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246686}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b9c7f12f-f5f3-522f-8863-2127e54d4ac8" :question/math-academy-id "q-10995" :question/problem "Express $\\frac{-{x}^{2}+20x+149}{(x+7)^{2}(x-3)}$ as a sum of partial     fractions." :question/worked-solution "Our task is to find $A,$ $B$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{-{x}^{2}+20x+149}{(x+7)^{2}(x-3)} & =\\frac{A}{x+7}+\\frac{B}{(x+7)^{2}}+\\frac{C}{x-3}.\\end{aligned}\n$$\n\nMultiplying both sides by $(x+7)^{2}(x-3)$ gives\n\n$$\n-{x}^{2}+20x+149=A(x+7)(x-3)+B(x-3)+C(x+7)^{2}.\n$$\n\nFor $x=-7$, we get \n\n$$\n\\begin{aligned}-(-7)^{2}+20(-7)+149 & =A(-7+7)(-7-3)+B(-7-3)+C(-7+7)^{2} \\\\ -49-140+149 & =B(-10) \\\\ B & =\\frac{-40}{-10} \\\\ B & =4.\\end{aligned}\n$$\n\nFor $x=3$, we get \n\n$$\n\\begin{aligned}-(3)^{2}+20(3)+149 & =A(3+7)(3-3)+B(3-3)+C(3+7)^{2} \\\\ -9+60+149 & =C{(10)}^{2} \\\\ C & =\\frac{200}{100} \\\\ C & =2.\\end{aligned}\n$$\n\nFor $x=0$, we get\n\n$$\n\\begin{aligned}-({0}^{2})+20(0)+149 & =A(0+7)(0-3)+B(0-3)+C(0+7)^{2} \\\\ 149 & =-21A-3B+49C \\\\ 149 & =-21A-3(4)+49(2) \\\\ 149 & =-21A+86 \\\\ 21A & =-63 \\\\ A & =-3.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\frac{-{x}^{2}+20x+149}{(x+7)^{2}(x-3)}=-\\frac{3}{x+7}+\\frac{4}{(x+7)^{2}}+\\frac{2}{x-3}.\n$$"}] [{:db/id #edb/ref 17592186247074 :knowledge-point/_questions [{:db/id #edb/ref 17592186064271 :knowledge-point/id #uuid "0fa5bdf9-4b27-5565-9ee1-ecb9f9db4791" :knowledge-point/title "Determining the Units of a Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a9d1daa-4262-5139-a82a-fa3e67db2278" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "squared hours" :db/id #edb/ref 17592186244405} {:answer/id #uuid "14b30c62-666a-59b5-8d86-70c3aaa84281" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "hours per minute" :db/id #edb/ref 17592186244504} {:answer/id #uuid "266712ff-2378-5f67-aec9-f0527b04aad3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "minutes" :db/id #edb/ref 17592186244654} {:answer/id #uuid "b676b7d4-a1ba-50cd-8d9e-e05b06adc11f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "hours" :db/id #edb/ref 17592186245944} {:answer/id #uuid "f0f28c2d-9b38-50b8-86c4-fef300c2b50e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "minutes per hour" :db/id #edb/ref 17592186246441}] :answer-field/correct {:answer/id #uuid "14b30c62-666a-59b5-8d86-70c3aaa84281" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "hours per minute" :db/id #edb/ref 17592186244504} :answer-field/id #uuid "05a9c882-cc73-506a-8893-344eaeecc41b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246562}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "986c7828-ebef-5b92-b3ca-04f414e27f95" :question/math-academy-id "q-110042" :question/problem "A battery lasts $L(t)$ hours when it is charged for $t$ minutes. What are the units of $\\frac{\\text{d}L}{\\text{d}t}?$" :question/worked-solution "We have that the battery duration $L(t)$ is measured in hours and the charging time is measured in minutes. \n\n$$\n\\begin{aligned}L(t): & \\text{hours} \\\\ t: & \\text{minutes}\\end{aligned}\n$$\n\nThe derivative $\\frac{\\text{d}L}{\\text{d}t}$ measures a change in $L(t)$ over a change in $t.$ So, it represents a ratio of the units:\n\n$$\n\\begin{aligned}\\frac{\\text{d}L}{\\text{d}t}: & \\frac{\\text{hours}}{\\text{minute}}\\end{aligned}\n$$\n\nIn other words, $\\frac{\\text{d}L}{\\text{d}t}$ is measured in \"hours per minute\"."}] [{:db/id #edb/ref 17592186247076 :knowledge-point/_questions [{:db/id #edb/ref 17592186119978 :knowledge-point/id #uuid "8c0b7d95-c699-5762-aa44-449712f035c7" :knowledge-point/title "Calculating the Derivative of the Inverse of a Polynomial Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22d5a040-390d-5203-8b75-acae075b4ef7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{48({h}^{-1}(x))^{5}+16({h}^{-1}(x))^{3}+9({h}^{-1}(x))^{2}}" :db/id #edb/ref 17592186244620} {:answer/id #uuid "606e6f5c-a0c2-5ab3-b6f4-ca7928c4cf0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{48({h}^{-1}(x))^{4}-16({h}^{-1}(x))^{3}+9({h}^{-1}(x))}" :db/id #edb/ref 17592186245156} {:answer/id #uuid "87f7c660-b074-5d37-94fa-798224cccd85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{48({h}^{-1}(x))^{5}+16({h}^{-1}(x))^{3}-3({h}^{-1}(x))^{2}}" :db/id #edb/ref 17592186245511} {:answer/id #uuid "8b212f51-2b53-522a-9e75-fc421f3a1d5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{24({h}^{-1}(x))^{5}+16({h}^{-1}(x))^{4}-8({h}^{-1}(x))^{2}}" :db/id #edb/ref 17592186245534} {:answer/id #uuid "8caeeaeb-5412-5ee4-b370-4b018fd33946" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8({h}^{-1}(x))^{5}+8({h}^{-1}(x))^{3}+9({h}^{-1}(x))^{2}}" :db/id #edb/ref 17592186245546}] :answer-field/correct {:answer/id #uuid "22d5a040-390d-5203-8b75-acae075b4ef7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{48({h}^{-1}(x))^{5}+16({h}^{-1}(x))^{3}+9({h}^{-1}(x))^{2}}" :db/id #edb/ref 17592186244620} :answer-field/id #uuid "c1a4b7dc-7531-523a-bb3b-ca16c0d54cab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246896}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9ec5b530-744d-5a5f-a929-bac31f33d7bf" :question/math-academy-id "q-110046" :question/problem "If $h(x)=8{x}^{6}+4{x}^{4}+3{x}^{3}-12,$ find ${({h}^{-1})}^{′}(x)$ as a function of ${h}^{-1}(x).$" :question/worked-solution "**Step 1:** First, we write the inverse function implicitly. The given function is $y=8{x}^{6}+4{x}^{4}+3{x}^{3}-12,$ and to write the inverse function implicitly, we swap $x$ and $y$ as follows:\n\n$$\nx=8{y}^{6}+4{y}^{4}+3{y}^{3}-12\n$$\n\nNote that in the equation above, we have $y={h}^{-1}(x).$\n\n**Step 2:** Next, we differentiate. The overall goal is to find $\\frac{\\text{d}y}{\\text{d}x},$ but the equation is already solved for $x,$ so we compute $\\frac{\\text{d}x}{\\text{d}y}$ and then take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(8{y}^{6}+4{y}^{4}+3{y}^{3}-12) \\\\ \\frac{\\text{d}x}{\\text{d}y} & =48{y}^{5}+16{y}^{3}+9{y}^{2} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{48{y}^{5}+16{y}^{3}+9{y}^{2}}\\end{aligned}\n$$\n\n**Step 3:** Lastly, we write the result in terms of ${h}^{-1}(x).$ Since $y={h}^{-1}(x),$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[{h}^{-1}(x)] & =\\frac{1}{48({h}^{-1}(x))^{5}+16({h}^{-1}(x))^{3}+9({h}^{-1}(x))^{2}} \\\\ {({h}^{-1})}^{′}(x) & =\\frac{1}{48({h}^{-1}(x))^{5}+16({h}^{-1}(x))^{3}+9({h}^{-1}(x))^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247081 :knowledge-point/_questions [{:db/id #edb/ref 17592186096684 :knowledge-point/id #uuid "d10c4317-f4b3-5846-8376-c7d382fc0ba3" :knowledge-point/title "Expressing Rational Functions as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07727d7f-2c55-5c5c-b6bf-023798916eda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4x+1}{({x}^{2}+11)}+\\frac{1}{(x-5)}" :db/id #edb/ref 17592186244373} {:answer/id #uuid "304ce17a-85e2-591d-89e0-8e6f154201c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x+5}{({x}^{2}+11)}-\\frac{7}{(x-5)}" :db/id #edb/ref 17592186244747} {:answer/id #uuid "72f881ba-150a-5750-bb32-d48934ef96fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+2}{({x}^{2}+11)}-\\frac{3}{(x-5)}" :db/id #edb/ref 17592186245342} {:answer/id #uuid "80f84e2b-243f-5712-a4cd-ff9a8411e827" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5x+3}{({x}^{2}+11)}-\\frac{4}{(x-5)}" :db/id #edb/ref 17592186245453} {:answer/id #uuid "c5c81f0c-ed8f-5c9b-af84-836ee910ecdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3x+2}{({x}^{2}+11)}+\\frac{2}{(x-5)}" :db/id #edb/ref 17592186246069}] :answer-field/correct {:answer/id #uuid "80f84e2b-243f-5712-a4cd-ff9a8411e827" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5x+3}{({x}^{2}+11)}-\\frac{4}{(x-5)}" :db/id #edb/ref 17592186245453} :answer-field/id #uuid "7426eb8b-dbe6-5c90-bab6-297b47683a95" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246748}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d0fd4da8-2774-540b-8642-c6079728ee7a" :question/math-academy-id "q-11007" :question/problem "Express $\\frac{{x}^{2}-22x-59}{({x}^{2}+11)(x-5)}$ as a sum of partial fractions." :question/worked-solution "Our task is to find $A,$ $B,$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{{x}^{2}-22x-59}{({x}^{2}+11)(x-5)} & =\\frac{Ax+B}{({x}^{2}+11)}+\\frac{C}{(x-5)}.\\end{aligned}\n$$\n\nNote that since ${x}^{2}+11$ is an irreducible quadratic factor, we must use a linear term $Ax+B$ in the numerator.\n\nWe multiply both sides by $({x}^{2}+11)(x-5)$ and get\n\n$$\n{x}^{2}-22x-59=(Ax+B)(x-5)+C({x}^{2}+11).\n$$\n\nPlugging in $x=5$ eliminates $A$ and $B$ and allows us to solve for $C.$ We get \n\n$$\n\\begin{aligned}{5}^{2}-22(5)-59 & =(A(5)+B)(5-5)+C({5}^{2}+11) \\\\ 25-110-59 & =36C \\\\ C & =-\\frac{144}{36} \\\\ C & =-4.\\end{aligned}\n$$\n\nPlugging in $x=0$ eliminates the $A$ term, and using our result for $C$ allows us to solve for $B.$ We get \n\n$$\n\\begin{aligned}(0)^{2}-22(0)-59 & =(A(0)+B)(0-5)+C({0}^{2}+11) \\\\ -59 & =-5B+11C \\\\ -59 & =-5B+11(-4) \\\\ 5B & =-44+59 \\\\ B & =\\frac{15}{5} \\\\ B & =3.\\end{aligned}\n$$\n\nFinally, to solve for $A,$ we choose $x=1$ and use our results for $B$ and $C.$ We get\n\n$$\n\\begin{aligned}(1)^{2}-22(1)-59 & =(A(1)+B)(1-5)+C({1}^{2}+11) \\\\ 1-22-59 & =-4A-4B+12C \\\\ -80 & =-4A-4(3)+12(-4) \\\\ 4A & =-12-48+80 \\\\ A & =\\frac{20}{4} \\\\ A & =5.\\end{aligned}\n$$\n\nSo we have $A=5,$ $B=3,$ and $C=-4.$ Therefore, our final result is\n\n$$\n\\frac{{x}^{2}-22x-59}{({x}^{2}+11)(x-5)}=\\frac{5x+3}{({x}^{2}+11)}-\\frac{4}{(x-5)}.\n$$"}] [{:db/id #edb/ref 17592186399685 :knowledge-point/_questions [{:db/id #edb/ref 17592186110653 :knowledge-point/id #uuid "42525832-e186-538f-baf8-bb4418e9820b" :knowledge-point/title "Working With Systems Containing Inequalities Presented in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84a02541-33c6-5f69-a920-35696f66c170" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x+2y\\le -8 \\\\ y\\ge \\frac{1}{2}x+1\\end{aligned}" :db/id #edb/ref 17592186399687} {:answer/id #uuid "5eb29637-b617-5711-9aa5-c2814f5eceb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x+2y>-8 \\\\ y>\\frac{1}{2}x+1\\end{aligned}" :db/id #edb/ref 17592186399688} {:answer/id #uuid "0642a65f-b668-5a8d-b6f2-b2575f8c1362" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x+2y\\ge -8 \\\\ y\\ge \\frac{1}{2}x+1\\end{aligned}" :db/id #edb/ref 17592186399689} {:answer/id #uuid "f8ff8a6d-ad42-5c71-989f-6bb5f699155a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x+2y\\le -8 \\\\ y\\le \\frac{1}{2}x+1\\end{aligned}" :db/id #edb/ref 17592186399690} {:answer/id #uuid "f8efb9aa-532e-55ae-9077-3bedc400e006" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x+2y\\ge -8 \\\\ y\\le \\frac{1}{2}x+1\\end{aligned}" :db/id #edb/ref 17592186399691}] :answer-field/correct {:answer/id #uuid "f8efb9aa-532e-55ae-9077-3bedc400e006" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x+2y\\ge -8 \\\\ y\\le \\frac{1}{2}x+1\\end{aligned}" :db/id #edb/ref 17592186399691} :answer-field/id #uuid "fce68956-d8ec-5373-80c1-0576c6b35476" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399686}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b9a72356-7e05-5f10-b6ac-a2418c3b4fa6" :question/math-academy-id "q-110078" :question/problem "![](images/39/3905dacc3977857933a48ced329fc245b357f732aec520e67998efc0b5d7cdab.png)\n\nWhich of the following systems of inequalities defines the shaded region shown above?" :question/worked-solution "Consider the line $x+2y=-8.$ Since the line is solid, the inequality is an \"or equal to\" inequality. Writing the equation of this line in slope-intercept form, we have\n\n$$\ny=-\\frac{1}{2}x-4.\n$$\n\nNow, since the shaded region lies *above* the line, the inequality is a \"greater than\" inequality. So the corresponding inequality is\n\n$$\ny\\ge -\\frac{1}{2}x-4,\n$$\n\n    \n\nwhich we can rewrite as\n\n$$\nx+2y\\ge -8.\n$$\n\nNow consider the line $y=\\frac{1}{2}x+1.$ Since the line is solid, the inequality is an \"or equal to\" inequality. Also, since the shaded region lies *below* the line, the inequality is a \"less than\" inequality. So the corresponding inequality is\n\n$$\ny\\le \\frac{1}{2}x+1.\n$$\n\nTherefore, the system of inequalities that defines the shaded region is\n\n$$\n{\\begin{aligned}x+2y\\ge -8 \\\\ y\\le \\frac{1}{2}x+1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186096950 :knowledge-point/_questions [{:db/id #edb/ref 17592186096684 :knowledge-point/id #uuid "d10c4317-f4b3-5846-8376-c7d382fc0ba3" :knowledge-point/title "Expressing Rational Functions as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40f3ff82-6f77-549d-a624-5debcc99a8d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3x+1}{({x}^{2}+2x+3)}+\\frac{2}{(x-1)}" :db/id #edb/ref 17592186244883} {:answer/id #uuid "6a5c70ee-90d2-5687-b3ef-c971b9f60b46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+3}{({x}^{2}+2x+3)}+\\frac{2}{(x-1)}" :db/id #edb/ref 17592186245256} {:answer/id #uuid "88b2fe13-efa4-5d72-a479-ed5d91e3729f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+2}{({x}^{2}+2x+3)}+\\frac{3}{(x-1)}" :db/id #edb/ref 17592186245512} {:answer/id #uuid "c5e65d48-58e0-5c74-85e0-8eaade6131a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+3}{({x}^{2}+2x+3)}-\\frac{2}{(x-1)}" :db/id #edb/ref 17592186246071} {:answer/id #uuid "cb9bc7f1-3946-5b24-a66f-3a730e714c0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x+1}{({x}^{2}+2x+3)}-\\frac{3}{(x-1)}" :db/id #edb/ref 17592186246126}] :answer-field/correct {:answer/id #uuid "40f3ff82-6f77-549d-a624-5debcc99a8d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3x+1}{({x}^{2}+2x+3)}+\\frac{2}{(x-1)}" :db/id #edb/ref 17592186244883} :answer-field/id #uuid "0e133db9-6266-5cab-9b3a-996ed74e5d30" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246575}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5ed7374e-1891-5f2a-9591-44dae68b363d" :question/math-academy-id "q-11014" :question/problem "Express $\\frac{5{x}^{2}+2x+5}{({x}^{2}+2x+3)(x-1)}$ as a sum of partial fractions." :question/requires-calculator true :question/worked-solution "Our task is to find $A,$ $B,$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{5{x}^{2}+2x+5}{({x}^{2}+2x+3)(x-1)} & =\\frac{Ax+B}{({x}^{2}+2x+3)}+\\frac{C}{(x-1)}.\\end{aligned}\n$$\n\nNote that since ${x}^{2}+2x+3$ is an irreducible quadratic factor, we must use a linear term $Ax+B$ in the numerator.\n\nWe multiply both sides by $({x}^{2}+2x+3)(x-1)$ and get\n\n$$\n5{x}^{2}+2x+5=(Ax+B)(x-1)+C({x}^{2}+2x+3).\n$$\n\nPlugging in $x=1$ eliminates the $A$ and $B$ terms and allows us to solve for $C.$ We get \n\n$$\n\\begin{aligned}5(1)^{2}+2(1)+5 & =(A(1)+B)(1-1)+C((1)^{2}+2(1)+3) \\\\ 5+2+5 & =6C \\\\ C & =\\frac{12}{6} \\\\ C & =2.\\end{aligned}\n$$\n\nPlugging in $x=0$ eliminates the $A$ term, and using our result for $C$ allows us to solve for $B.$ We get \n\n$$\n\\begin{aligned}5({0}^{2})+2(0)+5 & =(A(0)+B)(0-1)+C({0}^{2}+2(0)+3) \\\\ 5 & =-B+3C \\\\ 5 & =-B+3(2) \\\\ B & =6-5 \\\\ B & =1.\\end{aligned}\n$$\n\nFinally, to solve for $A,$ we choose $x=2$ and use our results for $B$ and $C.$ We get\n\n$$\n\\begin{aligned}5(2)^{2}+2(2)+5 & =(A(2)+B)(2-1)+C({2}^{2}+2(2)+3) \\\\ 29 & =2A+B+11C \\\\ 29 & =2A+(1)+11(2) \\\\ 2A & =29-23 \\\\ A & =\\frac{6}{2} \\\\ A & =3.\\end{aligned}\n$$\n\nSo we have $A=3,B=1,$ and $C=2.$ Therefore, our final result is\n\n$$\n\\frac{5{x}^{2}+2x+5}{({x}^{2}+2x+3)(x-1)}=\\frac{3x+1}{({x}^{2}+2x+3)}+\\frac{2}{(x-1)}.\n$$"}] [{:db/id #edb/ref 17592186247089 :knowledge-point/_questions [{:db/id #edb/ref 17592186110602 :knowledge-point/id #uuid "a6fee8d5-e1f7-599d-a74c-abc44d973065" :knowledge-point/title "Finding Equations of Perpendicular Horizontal and Vertical Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cad6201-010a-539b-a233-a3a596a28dc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1" :db/id #edb/ref 17592186244428} {:answer/id #uuid "2c55774a-a3f7-5f2a-9db4-822399b469f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2" :db/id #edb/ref 17592186244707} {:answer/id #uuid "5809a7c4-dbcc-51e9-a678-5bee1fdb700f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1" :db/id #edb/ref 17592186245092} {:answer/id #uuid "6ff5dd77-50b2-599d-bae1-c332e1f63976" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=4" :db/id #edb/ref 17592186245314} {:answer/id #uuid "ac2f7b12-1531-5623-b56b-f9c9386acf29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4" :db/id #edb/ref 17592186245854}] :answer-field/correct {:answer/id #uuid "ac2f7b12-1531-5623-b56b-f9c9386acf29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4" :db/id #edb/ref 17592186245854} :answer-field/id #uuid "e4b2b10b-4212-561e-9c28-87b5d79c2cdb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246954}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "08d4aa7d-7a62-5d6f-bf6f-63a5dddd841b" :question/math-academy-id "q-110140" :question/problem "Find the equation of the line that is perpendicular to $x=2$ and passes through the point $(1,4).$" :question/worked-solution "Since the line $x=2$ is a vertical line, a perpendicular line would need to be horizontal. So, the perpendicular line must take the form $y=k$ for some value of $k.$\n\nThe perpendicular line needs to go through the point $(1,4),$ which has a $y$-coordinate of $4.$ So, the perpendicular line is $y=4.$"}] [{:db/id #edb/ref 17592186247095 :knowledge-point/_questions [{:db/id #edb/ref 17592186119941 :knowledge-point/id #uuid "4ff302ba-5a3f-599b-b038-7417af1dca71" :knowledge-point/title "Finding the Equation of a Tangent Line Using dx/dy"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62979e92-45e9-5dc6-8f39-99cc2e9d96b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{x}{8}-\\frac{8}{7}" :db/id #edb/ref 17592186245178} {:answer/id #uuid "805e2500-01e2-50d2-a506-5c198597c2e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{x}{28}+\\frac{1}{7}" :db/id #edb/ref 17592186245444} {:answer/id #uuid "844ac3c9-57f1-5fd5-8d04-85a9a8a1b2b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{x}{18}-\\frac{7}{8}" :db/id #edb/ref 17592186245480} {:answer/id #uuid "d811f8f1-2ef1-5c53-a599-574d0712abf3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{x}{28}+\\frac{16}{7}" :db/id #edb/ref 17592186246237} {:answer/id #uuid "f5245542-2c39-5d0f-b0a9-ba2de27c7518" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{x}{28}+\\frac{8}{7}" :db/id #edb/ref 17592186246476}] :answer-field/correct {:answer/id #uuid "f5245542-2c39-5d0f-b0a9-ba2de27c7518" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{x}{28}+\\frac{8}{7}" :db/id #edb/ref 17592186246476} :answer-field/id #uuid "5234f73d-f7a9-51e5-9340-f6c76b65f21c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246691}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "00d18bd8-cfc3-5c89-ac8d-72f20b70464f" :question/math-academy-id "q-110192" :question/problem "Given a curve $x=5{y}^{3}-8{y}^{2}+16,$ what is the equation of the tangent to the curve at the point $(24,2)?$" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(5{y}^{3}-8{y}^{2}+16) \\\\  & =5\\frac{\\text{d}}{\\text{d}y}({y}^{3})-8\\frac{\\text{d}}{\\text{d}y}({y}^{2})+16\\frac{\\text{d}}{\\text{d}y}(1) \\\\  & =5\\cdot (3{y}^{2})-8\\cdot (2y)+0 \\\\  & =15{y}^{2}-16y.\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{1}{15{y}^{2}-16y}.\n$$\n\nThe slope of the tangent to the curve at the point $(24,2)$ is\n\n$$\n\\begin{aligned}m & =\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(24,2)} \\\\  & =\\frac{1}{15\\cdot {2}^{2}-16\\cdot 2} \\\\  & =\\frac{1}{28}.\\end{aligned}\n$$\n\nUsing the point-slope formula for a tangent line, we get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-2 & =\\frac{1}{28}(x-24) \\\\ y & =\\frac{x}{28}-\\frac{6}{7}+2 \\\\ y & =\\frac{x}{28}+\\frac{8}{7}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247096 :knowledge-point/_questions [{:db/id #edb/ref 17592186064251 :knowledge-point/id #uuid "4270c31c-80f1-5b5d-bca8-e16a47206c2b" :knowledge-point/title "Calculating the Derivative of an Inverse Function From a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19748f7d-bb3c-5578-815a-2c40f268fd48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186244541} {:answer/id #uuid "245e0993-1c09-56ea-a369-0117d5ee5974" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186244637} {:answer/id #uuid "2f2e6757-a78e-5338-abcf-b4cc049dfd1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186244738} {:answer/id #uuid "6f36eba8-2e78-54af-916b-61cedc572d7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186245301} {:answer/id #uuid "721e29cf-a6f9-513b-8aa0-cf84cb7826ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186245332}] :answer-field/correct {:answer/id #uuid "19748f7d-bb3c-5578-815a-2c40f268fd48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186244541} :answer-field/id #uuid "517e252a-aac0-56a3-81dc-672a79260cc6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246688}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c68b15f6-2538-56cf-b4b4-1738b9f449cf" :question/math-academy-id "q-110198" :question/problem "![](images/ba/ba762e13c4015b43b99f9038ee63a247584345cd535e12b80c1f3b0d9e50e70b.png)\n\nThe figure above shows the graph of a piecewise linear function $y=f(x).$ The point $A$ has coordinates $(1,0)$ and lies on $y=f(x).$ Given that $(0,1)$ lies on $y={f}^{-1}(x),$ what is $({f}^{-1})^{′}(0)?$" :question/worked-solution "Since $(0,1)$ lies on ${f}^{-1},$ we have ${f}^{-1}(0)=1.$ \nThe slope of the tangent to $f(x)$ for $x\\in [0,2]$ is $-2$, hence, ${f}^{′}(1)=-2.$\n\nThe formula for the derivative of the inverse function is \n\n$$\n({f}^{-1})^{′}(x)=\\frac{1}{{f}^{′}({f}^{-1}(x))}.\n$$\n\nEvaluating at $x=0,$ we have\n\n$$\n\\begin{aligned}({f}^{-1})^{′}(0) & =\\frac{1}{{f}^{′}({f}^{-1}(0))} \\\\  & =\\frac{1}{{f}^{′}(1)} \\\\  & =\\frac{1}{-2} \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247135 :knowledge-point/_questions [{:db/id #edb/ref 17592186087691 :knowledge-point/id #uuid "10095048-0db6-5b4e-889f-303f07449367" :knowledge-point/title "Finding Solutions to Exponential Equations when Rearrangement is Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "248c560a-5504-5344-ba06-31ff881f4228" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "ln⁡(2)-1" :db/id #edb/ref 17592186244640} {:answer/id #uuid "453ad4e8-fc91-5dc6-a9a5-3321c0d9dc49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "ln⁡(2)+1" :db/id #edb/ref 17592186244926} {:answer/id #uuid "a51377ae-5388-50fe-83c3-7ef69418daf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2ln⁡(2)-1" :db/id #edb/ref 17592186245796} {:answer/id #uuid "f8312b64-ab69-53ae-90e8-b700b7b53c1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2ln⁡(2)+1" :db/id #edb/ref 17592186246497} {:answer/id #uuid "faecbb4c-e0f8-59a8-a3d7-92a5f5e02711" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2ln⁡(2)" :db/id #edb/ref 17592186246516}] :answer-field/correct {:answer/id #uuid "a51377ae-5388-50fe-83c3-7ef69418daf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2ln⁡(2)-1" :db/id #edb/ref 17592186245796} :answer-field/id #uuid "8a081fae-877e-5e2e-acae-a2b3a4e290d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246787}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "48d44085-8aaf-5ed5-9d45-53625f178071" :question/math-academy-id "q-110536" :question/problem "Given that ${e}^{y+1}-1=3,$ then $y=$" :question/worked-solution "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}{e}^{y+1}-1 & =3 \\\\ {e}^{y+1} & =4\\end{aligned}\n$$\n\nThen, we find the natural logarithm $(ln)$ of both sides of the equation and solve for $y:$\n\n$$\n\\begin{aligned}{e}^{y+1} & =4 \\\\ ln⁡({e}^{y+1}) & =ln⁡(4) \\\\ y+1 & =2ln⁡(2) \\\\ y & =2ln⁡(2)-1\\end{aligned}\n$$\n\nTherefore, the solution is $y=2ln⁡(2)-1.$"}] [{:db/id #edb/ref 17592186247137 :knowledge-point/_questions [{:db/id #edb/ref 17592186115219 :knowledge-point/id #uuid "a8eebff2-97ca-599b-a819-04ff34f0c1c4" :knowledge-point/title "Solving Exponential Equations Containing Different Bases by Rewriting Two Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5590a848-eae9-5089-bdc1-7f789ac62064" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186245065} {:answer/id #uuid "5f338793-8672-5f89-9124-424dc680305c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186245150} {:answer/id #uuid "a0029015-9d7a-5b76-8132-425f8e5b1369" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186245736} {:answer/id #uuid "caf954cd-bb67-553d-8e8c-ae5436312352" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186246122} {:answer/id #uuid "f2f19e3a-8e8b-5a89-b39e-a28325288d1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186246459}] :answer-field/correct {:answer/id #uuid "5590a848-eae9-5089-bdc1-7f789ac62064" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186245065} :answer-field/id #uuid "5d24b5a0-aff5-5beb-bda9-0451317c58e5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246711}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6b4f9a18-294f-593c-86d1-c0d405dcd6de" :question/math-academy-id "q-110544" :question/problem "Solve for $y$ where ${81}^{y}={27}^{y+5}.$" :question/worked-solution "To solve this equation, we need both exponential terms to have a common base. To do this, we rewrite the equation using $81={3}^{4}$ and $27={3}^{3},$ as follows:\n\n$$\n{({3}^{4})}^{y}={({3}^{3})}^{y+5}\n$$\n\nThen, we apply the power rule of exponents. This gives:\n\n$$\n\\begin{aligned}{3}^{4y}={3}^{3(y+5)}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(3),$ we equate the exponents and solve for $y:$\n\n$$\n\\begin{aligned}4y & =3(y+5) \\\\ 4y & =3y+15 \\\\ y & =15\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247151 :knowledge-point/_questions [{:db/id #edb/ref 17592186064366 :knowledge-point/id #uuid "93a44f44-0998-5857-9b12-de8998e370fd" :knowledge-point/title "Differentiating an Inverse Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09ee8a3a-aff1-5329-ab62-d486c9340be5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5-\\frac{4}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186244398} {:answer/id #uuid "89609260-8cd9-5ba1-b619-2fc1bd29c3eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5+\\frac{4}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186245517} {:answer/id #uuid "8d8724d8-cb92-559c-84a5-0132b5fbd151" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5-\\frac{4x}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186245551} {:answer/id #uuid "962ee919-f8a1-5686-b7b2-8aaf7083525a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x+\\frac{4}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186245636} {:answer/id #uuid "d758ea7b-694a-526b-a30b-4e618f038f63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4-\\frac{5}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186246230}] :answer-field/correct {:answer/id #uuid "09ee8a3a-aff1-5329-ab62-d486c9340be5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5-\\frac{4}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186244398} :answer-field/id #uuid "5935a167-843e-514d-9aca-7a9d8403bae1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246704}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e8030974-10cb-5204-836f-a9b8dc5afc64" :question/math-academy-id "q-110625" :question/problem "Calculate ${f}^{′}(x)$  for $f(x)=5x+4\\operatorname{arccos}⁡x.$" :question/worked-solution "The formula for the derivative of arccosine is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccos}⁡x)=-\\frac{1}{\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the formula above, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(5x+4\\operatorname{arccos}⁡x) \\\\  & =5+4\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccos}⁡x) \\\\  & =5+4(-\\frac{1}{\\sqrt{1-{x}^{2}}}) \\\\  & =5-\\frac{4}{\\sqrt{1-{x}^{2}}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247152 :knowledge-point/_questions [{:db/id #edb/ref 17592186064366 :knowledge-point/id #uuid "93a44f44-0998-5857-9b12-de8998e370fd" :knowledge-point/title "Differentiating an Inverse Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14063917-2f5c-53ac-a1be-a84525cdd48b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8+\\frac{15}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186244495} {:answer/id #uuid "3bbb79dc-d168-5e6c-967d-301ffb7b9bec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8x-\\frac{15}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186244839} {:answer/id #uuid "ac0b8241-b7f9-55f9-8dd0-032a83734e86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15-\\frac{8}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186245852} {:answer/id #uuid "c978eae8-643b-508b-8afb-0d9a95c8c8ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8-\\frac{15}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186246098} {:answer/id #uuid "caebc49d-d3db-5490-82b2-efb3f04c7f5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8+\\frac{15x}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186246120}] :answer-field/correct {:answer/id #uuid "c978eae8-643b-508b-8afb-0d9a95c8c8ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8-\\frac{15}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186246098} :answer-field/id #uuid "cf16ad5d-42c4-5764-9634-f695fe575fed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246919}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7680792c-1905-5073-9b89-1803e3b68661" :question/math-academy-id "q-110626" :question/problem "Calculate ${f}^{′}(x)$  for $f(x)=15\\operatorname{arccos}⁡x+8x.$" :question/worked-solution "The formula for the derivative of arccosine is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccos}⁡x)=-\\frac{1}{\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the formula above, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(15\\operatorname{arccos}⁡x+8x) \\\\  & =15\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccos}⁡x)+8 \\\\  & =15(-\\frac{1}{\\sqrt{1-{x}^{2}}})+8 \\\\  & =8-\\frac{15}{\\sqrt{1-{x}^{2}}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247161 :knowledge-point/_questions [{:db/id #edb/ref 17592186064367 :knowledge-point/id #uuid "c5582e8b-3870-5a32-b15e-62b8f8306ce6" :knowledge-point/title "Differentiating Inverse Trigonometric Functions Using the Product or Quotient Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "149dcaee-a842-584c-9fc7-09c4da3304aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}+3{x}^{5}\\operatorname{arctan}⁡({x}^{3})}{({x}^{6}+1)^{2}}" :db/id #edb/ref 17592186244503} {:answer/id #uuid "768d48e2-8c95-5280-ba0c-8ed707947487" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}-6{x}^{6}\\operatorname{arctan}⁡({x}^{3})}{({x}^{6}+1)^{2}}" :db/id #edb/ref 17592186245367} {:answer/id #uuid "80e24ca9-2891-539c-a111-b07fb4ce033f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{3}-6{x}^{5}\\operatorname{arctan}⁡({x}^{3})}{({x}^{6}+1)^{2}}" :db/id #edb/ref 17592186245451} {:answer/id #uuid "8759d4f9-38b4-5c69-b25c-92f362595b22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{x}^{2}-6{x}^{5}\\operatorname{arctan}⁡({x}^{3})}{({x}^{6}+1)^{2}}" :db/id #edb/ref 17592186245505} {:answer/id #uuid "ef4377e7-ae39-50b4-a1fe-882b741bc63b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{x}^{2}+{x}^{6}\\operatorname{arctan}⁡({x}^{3})}{({x}^{6}+1)^{2}}" :db/id #edb/ref 17592186246431}] :answer-field/correct {:answer/id #uuid "8759d4f9-38b4-5c69-b25c-92f362595b22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{x}^{2}-6{x}^{5}\\operatorname{arctan}⁡({x}^{3})}{({x}^{6}+1)^{2}}" :db/id #edb/ref 17592186245505} :answer-field/id #uuid "c6b18822-cc1c-50af-9989-8e193167758f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246905}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2888c71d-c895-59c2-afdb-577636636ba4" :question/math-academy-id "q-110762" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{\\operatorname{arctan}⁡({x}^{3})}{{x}^{6}+1}.$" :question/worked-solution "Applying the quotient rule, using the formula for the derivative of $\\operatorname{arctan}⁡x$ and applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\operatorname{arctan}⁡({x}^{3})}{{x}^{6}+1}) \\\\  & =\\frac{({x}^{6}+1)\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arctan}⁡({x}^{3}))-\\operatorname{arctan}⁡({x}^{3})\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{6}+1)}{({x}^{6}+1)^{2}} \\\\  & =\\frac{({x}^{6}+1)\\cdot \\frac{1}{{x}^{6}+1}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{3})-\\operatorname{arctan}⁡({x}^{3})\\cdot 6{x}^{5}}{({x}^{6}+1)^{2}} \\\\  & =\\frac{\\frac{({x}^{6}+1)(3{x}^{2})}{{x}^{6}+1}-6{x}^{5}\\operatorname{arctan}⁡({x}^{3})}{({x}^{6}+1)^{2}} \\\\  & =\\frac{3{x}^{2}-6{x}^{5}\\operatorname{arctan}⁡({x}^{3})}{({x}^{6}+1)^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247163 :knowledge-point/_questions [{:db/id #edb/ref 17592186064367 :knowledge-point/id #uuid "c5582e8b-3870-5a32-b15e-62b8f8306ce6" :knowledge-point/title "Differentiating Inverse Trigonometric Functions Using the Product or Quotient Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22a2e63d-ce23-5f94-b43c-fe498a90aeef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{e}^{x}\\sqrt{1-{x}^{2}}}-\\frac{\\operatorname{arccos}⁡x}{{e}^{x}}" :db/id #edb/ref 17592186244617} {:answer/id #uuid "5d4c6d81-2c16-5cd7-b161-403eb27b5d97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{e}^{x}\\sqrt{1-{x}^{2}}}-\\frac{\\operatorname{arcsin}⁡x}{{e}^{x}}" :db/id #edb/ref 17592186245137} {:answer/id #uuid "646d492b-7b50-5a66-b9d1-b587fee404cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{e}^{x}}{\\sqrt{1-{x}^{2}}}+\\frac{\\operatorname{arccos}⁡x}{{e}^{x}}" :db/id #edb/ref 17592186245197} {:answer/id #uuid "aca6fa25-92b4-55d1-9de0-7256742207ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}}{\\sqrt{1-{x}^{2}}}-\\frac{\\operatorname{arcsin}⁡x}{{e}^{x}}" :db/id #edb/ref 17592186245855} {:answer/id #uuid "f3bf57b6-e50e-5557-a8b2-a49cf3d68351" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{1-{x}^{2}}}+\\frac{\\operatorname{arcsin}⁡x}{{e}^{x}}" :db/id #edb/ref 17592186246464}] :answer-field/correct {:answer/id #uuid "5d4c6d81-2c16-5cd7-b161-403eb27b5d97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{e}^{x}\\sqrt{1-{x}^{2}}}-\\frac{\\operatorname{arcsin}⁡x}{{e}^{x}}" :db/id #edb/ref 17592186245137} :answer-field/id #uuid "1df422f0-6fd5-5d06-9f9a-8e3773d8232b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246598}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fce053b7-4dd3-554f-bea5-f458f557cfe3" :question/math-academy-id "q-110777" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{\\operatorname{arcsin}⁡x}{{e}^{x}}.$" :question/worked-solution "Applying the quotient rule and using the formula for the derivative of $\\operatorname{arcsin}⁡x,$  we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{\\operatorname{arcsin}⁡x}{{e}^{x}}) & =\\frac{{e}^{x}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsin}⁡x)-\\operatorname{arcsin}⁡x\\cdot \\frac{\\text{d}}{\\text{d}x}({e}^{x})}{{({e}^{x})}^{2}} \\\\  & =\\frac{{e}^{x}\\cdot \\frac{1}{\\sqrt{1-{x}^{2}}}-\\operatorname{arcsin}⁡x\\cdot {e}^{x}}{{e}^{2x}} \\\\  & =\\frac{(\\frac{1}{\\sqrt{1-{x}^{2}}}-\\operatorname{arcsin}⁡x)}{{e}^{x}} \\\\  & =\\frac{1}{{e}^{x}\\sqrt{1-{x}^{2}}}-\\frac{\\operatorname{arcsin}⁡x}{{e}^{x}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386571 :knowledge-point/_questions [{:db/id #edb/ref 17592186157437 :knowledge-point/id #uuid "3758cf02-ba4b-539a-bc61-8c2030ff6f6f" :knowledge-point/title "Solving an Exponential Equation by Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "745439dc-de09-51c8-bbdb-eedea4d0f155" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186386573} {:answer/id #uuid "617f1c2d-99ac-5b8a-931f-683ccf1893b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186386574} {:answer/id #uuid "db8e533b-8461-5017-a4f6-47771a90f0b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186386575} {:answer/id #uuid "e510aa7f-7425-5853-824c-91e79e70849b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186386576} {:answer/id #uuid "2d786935-adc1-5afa-a4cc-25f126fdd263" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186386577}] :answer-field/correct {:answer/id #uuid "e510aa7f-7425-5853-824c-91e79e70849b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186386576} :answer-field/id #uuid "50a99769-405d-5ab0-ad5f-e1bf8543c410" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386572}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "11afc858-764d-5d9d-a321-3ddf5528f806" :question/math-academy-id "q-110801" :question/problem "What is the product of solutions of the equation ${x}^{2}\\cdot {7}^{2-x}-{7}^{2-x}=0?$" :question/worked-solution "First, we factor the equation:\n\n$$\n\\begin{aligned}{x}^{2}\\cdot {7}^{2-x}-{7}^{2-x} & =0 \\\\ ({x}^{2}-1)\\cdot {7}^{2-x} & =0\\end{aligned}\n$$\n\n \n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n{x}^{2}-1=0\\,\\text{and}\\,{7}^{2-x}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation ${x}^{2}-1=0$ can be factored as\n\n$$\n(x+1)(x-1)=0,\n$$\n\nwhich leads to the solutions $x=-1,1.$\n\n- The equation ${7}^{2-x}=0$ has no solutions because ${7}^{2-x}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=-1,1,$ and their product is $-1\\cdot 1=-1.$"}] [{:db/id #edb/ref 17592186386578 :knowledge-point/_questions [{:db/id #edb/ref 17592186157438 :knowledge-point/id #uuid "8aaf12cf-8596-5960-bc68-5ca3eb5fab0f" :knowledge-point/title "Solving an Exponential Equation by Rearranging the Equation and Then Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83cca658-4075-5016-8fbe-e5612324db1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186386580} {:answer/id #uuid "bb580306-8e14-5c41-83ea-3c1ee2e8cdf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186386581} {:answer/id #uuid "c11a3bed-2998-59a1-97a6-f48556210e01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186386582} {:answer/id #uuid "e3957c19-6d34-5546-aa5e-4ed5649688c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186386583} {:answer/id #uuid "7ddd09f0-bf49-52e2-98a4-7a4a058d7c69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186386584}] :answer-field/correct {:answer/id #uuid "e3957c19-6d34-5546-aa5e-4ed5649688c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186386583} :answer-field/id #uuid "e20ce4da-f186-5091-a95d-1d090861a47d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386579}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1ddd6b32-1ad1-5a92-b6ca-5f243dfcc079" :question/math-academy-id "q-110803" :question/problem "What is the product of solutions of the equation ${x}^{2}{10}^{2-x}={10}^{2-x}?$" :question/worked-solution "First, we factor the equation:\n\n$$\n\\begin{aligned}{x}^{2}{10}^{2-x} & ={10}^{2-x} \\\\ {x}^{2}{10}^{2-x}-{10}^{2-x} & =0 \\\\ ({x}^{2}-1){10}^{2-x} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n{x}^{2}-1=0\\,\\text{and}\\,{10}^{2-x}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation ${x}^{2}-1=0$ can be factored as\n\n$$\n(x+1)(x-1)=0,\n$$\n\nwhich leads to the solutions $x=-1,1.$\n\n- The equation ${10}^{2-x}=0$ has no solutions because ${10}^{2-x}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=-1,1,$ and their product is $(-1)\\cdot 1=-1.$"}] [{:db/id #edb/ref 17592186247169 :knowledge-point/_questions [{:db/id #edb/ref 17592186115399 :knowledge-point/id #uuid "20a5f15e-8a26-57af-a867-8f8ae02a91c1" :knowledge-point/title "Differentiating Inverse Reciprocal Trigonometric Functions Using the Quotient Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d6a9bcf-5b72-54d9-a128-8bd6ee36de0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x+4}{arccscx}+\\frac{{x}^{2}+4x}{\\sqrt{{x}^{2}-1}\\cdot {arccsc}^{2}x}" :db/id #edb/ref 17592186244573} {:answer/id #uuid "3a12daab-bb88-55ce-a334-ad69cb782225" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+4}{arccscx}-\\frac{{x}^{2}+4x}{|x|\\sqrt{{x}^{2}-1}\\cdot {arccsc}^{2}x}" :db/id #edb/ref 17592186244829} {:answer/id #uuid "734eb1e5-5d2c-548c-a909-d144450435b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4x+2}{arcsecx}+\\frac{{x}^{2}+4x}{|x|\\sqrt{{x}^{2}-1}\\cdot {arccsc}^{2}x}" :db/id #edb/ref 17592186245345} {:answer/id #uuid "d5f3b612-bac7-5a34-a41e-8ffc73c0c464" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x+4}{arccscx}+\\frac{{x}^{2}+4x}{|x|\\sqrt{{x}^{2}-1}\\cdot {arccsc}^{2}x}" :db/id #edb/ref 17592186246219} {:answer/id #uuid "f484b6c9-af99-5523-b72f-2c18bf53b1b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}+4}{arccscx}-\\frac{2x+4x}{|x|\\sqrt{{x}^{2}-1}\\cdot {arccsc}^{2}x}" :db/id #edb/ref 17592186246471}] :answer-field/correct {:answer/id #uuid "d5f3b612-bac7-5a34-a41e-8ffc73c0c464" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x+4}{arccscx}+\\frac{{x}^{2}+4x}{|x|\\sqrt{{x}^{2}-1}\\cdot {arccsc}^{2}x}" :db/id #edb/ref 17592186246219} :answer-field/id #uuid "f6a0c5df-079e-53e1-9ee0-47a76e0ae5a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246987}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "698df1fd-5fd3-5825-8b74-4170ba6ffbf1" :question/math-academy-id "q-110834" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{{x}^{2}+4x}{arccscx}.$" :question/worked-solution "Here, we let $u(x)={x}^{2}+4x$ and $v(x)=arccscx,$ and apply the quotient rule.\n\nWe use the formulae\n\n$$\n{u}^{′}(x)=2x+4\\,\\text{and}\\,{v}^{′}(x)=-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(2x+4)\\cdot arccscx-({x}^{2}+4x)\\cdot (-\\frac{1}{|x|\\sqrt{{x}^{2}-1}})}{{arccsc}^{2}x} \\\\  & =\\frac{2x+4}{arccscx}+\\frac{{x}^{2}+4x}{|x|\\sqrt{{x}^{2}-1}\\cdot {arccsc}^{2}x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247230 :knowledge-point/_questions [{:db/id #edb/ref 17592186152116 :knowledge-point/id #uuid "db871222-7398-5fea-8097-bcf669751a40" :knowledge-point/title "Finding the LCM of Two Polynomials that Differ by a Constant Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e8d13e1-a99f-5ab7-a526-b7cfba5e8813" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9(z-4)^{2}" :db/id #edb/ref 17592186244444} {:answer/id #uuid "0ea68ebf-9255-53a8-a395-205c70267496" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14(z-4)^{2}" :db/id #edb/ref 17592186244446} {:answer/id #uuid "7c28feb1-7589-5e8d-9418-28850a614574" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28(z-4)^{4}" :db/id #edb/ref 17592186245401} {:answer/id #uuid "a73784f2-2fb7-5100-b1a9-c95f9187984f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28(z-4)^{2}" :db/id #edb/ref 17592186245812} {:answer/id #uuid "f54ce985-d718-578e-8921-d62dfebbfd89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14(z-4)^{4}" :db/id #edb/ref 17592186246478}] :answer-field/correct {:answer/id #uuid "0ea68ebf-9255-53a8-a395-205c70267496" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14(z-4)^{2}" :db/id #edb/ref 17592186244446} :answer-field/id #uuid "b7db519b-b493-5c2a-b1f8-3f09714be182" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246881}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1022040b-f64c-5ed6-9959-011542bf6e8b" :question/math-academy-id "q-111582" :question/problem "Find the least common multiple of $2(z-4)^{2}$ and $7(z-4)^{2}.$" :question/worked-solution "To find the least common multiple ($\\text{LCM}$) of two polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of the variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(2,7):$\n\n- Multiples of $2:$ $\\,2,\\,4,…,\\,12,\\,14,16,…$\n\n- Multiples of $7:$ $\\,7,\\,14,\\,21,…$\n\nSo, $\\text{LCM}(2,7)=14.$\n\nSince the variable part is the same in the expressions, we have\n\n$$\n\\text{LCM}((z-4)^{2},\\,(z-4)^{2})=(z-4)^{2}.\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\text{LCM}(2(z-4)^{2},\\,7(z-4)^{2})=14\\cdot (z-4)^{2}=14(z-4)^{2}.\n$$"}] [{:db/id #edb/ref 17592186247239 :knowledge-point/_questions [{:db/id #edb/ref 17592186129142 :knowledge-point/id #uuid "5dce1c69-c79d-541a-b479-8fc127352c2a" :knowledge-point/title "Identifying the Graph of a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1936865a-0f4e-52f9-91d5-746d678fde4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D" :db/id #edb/ref 17592186244539} {:answer/id #uuid "6a2c32d0-0d87-5f9d-a922-71f4c277c5e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C" :db/id #edb/ref 17592186245254} {:answer/id #uuid "9c38f3d9-2abb-52d7-862f-ac3326faabc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B" :db/id #edb/ref 17592186245699} {:answer/id #uuid "9db779f5-dbcf-55a9-a973-1dad55349d1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the given options is correct" :db/id #edb/ref 17592186245719} {:answer/id #uuid "ec748b7b-f501-5ca3-adaf-ebbcea9f3b55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A" :db/id #edb/ref 17592186246405}] :answer-field/correct {:answer/id #uuid "ec748b7b-f501-5ca3-adaf-ebbcea9f3b55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A" :db/id #edb/ref 17592186246405} :answer-field/id #uuid "636cbec4-06e4-5b40-9927-087ffb75e1a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246721}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "521eada5-fcae-5914-a56b-54aece215449" :question/math-academy-id "q-112076" :question/problem "![](images/83/83b8d9a8d8f1cd9cc79fb10964e0d34c38204cc518a1e5175ac9a826127cd548.png)\n\nWhich of the above could be the graph of $y={x}^{3}-4x?$" :question/worked-solution "Let's call $P(x)$ the given polynomial:\n\n$$\nP(x)={x}^{3}-4x\n$$\n\nThe degree $(n=3)$ is odd and the leading coefficient $({a}_{3}=1)$ is positive. Therefore, the polynomial has the following end behavior:\n\n- $P(x)\\to -\\infty $ as $x\\to -\\infty .$\n\n- $P(x)\\to \\infty $ as $x\\to \\infty .$\n\nOnly the graph $A$ satisfies these conditions."}] [{:db/id #edb/ref 17592186247246 :knowledge-point/_questions [{:db/id #edb/ref 17592186096638 :knowledge-point/id #uuid "d707bc81-53a8-55c5-a545-e9ccdeedaa86" :knowledge-point/title "Finding the Area Bounded by a Curve, the y-Axis, and Two Horizontal Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2199b6f3-f149-5677-ba9b-eeb67a83523d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186244607} {:answer/id #uuid "398256b0-f316-5b99-b5c7-57042c56dd06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186244822} {:answer/id #uuid "5ba73ad3-a645-5037-b2c1-218f2723a59e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186245118} {:answer/id #uuid "9ffe9786-abbf-5d17-99af-e5ed34a846f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{4}" :db/id #edb/ref 17592186245735} {:answer/id #uuid "fa4fb547-a557-57f0-8e84-68e53531cd2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{19}{6}" :db/id #edb/ref 17592186246510}] :answer-field/correct {:answer/id #uuid "2199b6f3-f149-5677-ba9b-eeb67a83523d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186244607} :answer-field/id #uuid "9e856a2c-576f-50ef-8a52-8e2f3e79440a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246824}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2742531e-a0c1-549c-b37f-4b5ab715a95d" :question/math-academy-id "q-11216" :question/problem "![](images/b4/b4408c4dc92d7145fef94603269f2cc54ceeb3bb38703401ff46004a2428dd3f.png)\n\nFind the area bounded between the curve $x=-{y}^{5}+1,$ the $y$-axis, and the lines $y=0$ and $y=1,$ as shown above." :question/worked-solution "To find the area, we compute the corresponding definite integral, as follows:\n\n$$\n\\begin{aligned}A & ={\\int }_{c}^{d}x(y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}(-{y}^{5}+1)\\,\\text{d}y \\\\  & =-{\\int }_{0}^{1}{y}^{5}\\,\\text{d}y+{\\int }_{0}^{1}\\,\\text{d}y \\\\  & =-{\\frac{{y}^{6}}{6}|}_{0}^{1}+y{|}_{0}^{1} \\\\  & =-(\\frac{1}{6}-0)+(1-0) \\\\  & =-\\frac{1}{6}+1 \\\\  & =\\frac{5}{6}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247258 :knowledge-point/_questions [{:db/id #edb/ref 17592186171956 :knowledge-point/id #uuid "be11193b-a241-5812-a1c1-54d233ae9ddd" :knowledge-point/title "Determining the Value of a Binomial Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d834456-fd92-55f5-941e-3eb305dec713" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186244722} {:answer/id #uuid "3cc1b262-e0bb-5f32-9ca5-acaaad5a8816" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186244848} {:answer/id #uuid "3ef8a6f0-3f3d-54ea-aad2-d48b15ce196e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186244868} {:answer/id #uuid "61851206-c16f-5bde-bcf9-39ad15b3a54e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186245165} {:answer/id #uuid "84f31bc7-e7cd-53ed-9cce-1c536d30a70e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186245487}] :answer-field/correct {:answer/id #uuid "84f31bc7-e7cd-53ed-9cce-1c536d30a70e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186245487} :answer-field/id #uuid "ec673f44-f9b5-558a-81c0-2ead76584e8f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246970}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f22cfc7d-e4da-562f-9d3d-9e3613fd5a63" :question/math-academy-id "q-112325" :question/problem "Use Pascal's triangle to determine the value of $(\\frac{3}{3}).$" :question/worked-solution "To find the value of $(\\frac{3}{3}),$ we need to find the number that is located in row $3$ and position $3$ of Pascal's triangle. \n\n**Important**: When counting the rows and positions in Pascal's triangle, we always start counting from zero! Remember:\n\n- The top row of Pascal's triangle is row $0.$\n\n- The first position of each row (the one of the left) is position number $0.$\n\nThe value located in row $3$ and position $3$ is highlighted below.\n\n$$\n\\begin{aligned} &  &  &  &  &  & 1 \\\\  &  &  &  &  & 1 &  & 1 \\\\  &  &  &  & 1 &  & 2 &  & 1 \\\\  &  &  & 1 &  & 3 &  & 3 &  & 1 \\\\  &  & 1 &  & 4 &  & 6 &  & 4 &  & 1 \\\\  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nTherefore, $(\\frac{3}{3})=1.$"}] [{:db/id #edb/ref 17592186247263 :knowledge-point/_questions [{:db/id #edb/ref 17592186064154 :knowledge-point/id #uuid "c7df31c9-b27a-5ce2-93c8-178ba96da000" :knowledge-point/title "Determining a Rate of Change"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04171382-cbfa-5f10-92fb-22e5c7a6e6de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$20$ percent per hour" :db/id #edb/ref 17592186244346} {:answer/id #uuid "284bf059-1884-5e2d-a5c3-731890221cc7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ percent per hour" :db/id #edb/ref 17592186244669} {:answer/id #uuid "51d5b6bd-e195-5c6e-bf88-1a79c021dc21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ percent per hour" :db/id #edb/ref 17592186245038} {:answer/id #uuid "6d228c5d-7d6a-5f80-841c-f0172b125cc3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$40$ percent per hour" :db/id #edb/ref 17592186245278} {:answer/id #uuid "7452c71d-92bf-59ad-847f-f7ba52f5ece7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ percent per hour" :db/id #edb/ref 17592186245349}] :answer-field/correct {:answer/id #uuid "04171382-cbfa-5f10-92fb-22e5c7a6e6de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$20$ percent per hour" :db/id #edb/ref 17592186244346} :answer-field/id #uuid "4de83a2e-a171-5c7c-a155-600eb37ea0f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246677}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "524d3949-c8de-5ba0-b1ba-ea4e8e41e832" :question/math-academy-id "q-112383" :question/problem "After charging the battery of a PC, the percentage of charge decreases at a rate of $c(t)=100\\cdot {5}^{-0.2t}$ percent per hour, where $t$ is the time, in hours, since the battery had completed its charge. What will be the rate of decrease after $5$ hours?" :question/worked-solution "Since we want to determine the rate of decrease in the amount of charge after $5$ hours, we have $t=5.$\n\nThus, the rate of decrease of the amount of charge after $5$ hours will be\n\n$$\n\\begin{aligned}c(5) & =100\\cdot {5}^{-0.2(5)} \\\\  & =100\\cdot {5}^{-1} \\\\  & =\\frac{100}{5} \\\\  & =20.\\end{aligned}\n$$\n\nTherefore, the rate of decrease will be $20$ percent per hour."}] [{:db/id #edb/ref 17592186399739 :knowledge-point/_questions [{:db/id #edb/ref 17592186068860 :knowledge-point/id #uuid "9d78ba1c-5297-5540-afdc-d419d33e0cf7" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Rational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88f1c5a8-42ee-5523-84ec-f29f28e0ac2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=-264\\,$ and $\\,{t}_{1}+{t}_{2}=-14$" :db/id #edb/ref 17592186399741} {:answer/id #uuid "eb2399df-9166-5676-8f9c-a51959d4ab11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=343\\,$ and $\\,{t}_{1}+{t}_{2}=-14$" :db/id #edb/ref 17592186399742} {:answer/id #uuid "dff389cf-80e0-5f10-b6f2-86dcbc11e52c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=-14\\,$ and $\\,{t}_{1}+{t}_{2}=49$" :db/id #edb/ref 17592186399743} {:answer/id #uuid "c14d9b4a-b38e-5fab-ad4f-cb09b4aea808" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=-343\\,$ and $\\,{t}_{1}+{t}_{2}=-14$" :db/id #edb/ref 17592186399744} {:answer/id #uuid "7dec2dec-aebb-5a50-befe-935b17a9002a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=-343\\,$ and $\\,{t}_{1}+{t}_{2}=14$" :db/id #edb/ref 17592186399745}] :answer-field/correct {:answer/id #uuid "7dec2dec-aebb-5a50-befe-935b17a9002a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=-343\\,$ and $\\,{t}_{1}+{t}_{2}=14$" :db/id #edb/ref 17592186399745} :answer-field/id #uuid "9feed68a-3a5e-5bf8-a32b-19c5c668ac59" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399740}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fac39442-17f5-5ace-9954-931f61698611" :question/math-academy-id "q-112457" :question/problem "The equation ${t}^{2}-14t+5=5$ can be written in the form $(t+p{)}^{2}=q.$ Find $\\,pq\\,,$ and the sum of the roots ${t}_{1}+{t}_{2}.$" :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{t}^{2}-14t+5 & =5 \\\\ {t}^{2}-14t & =0 \\\\ {t}^{2}-2\\cdot t\\cdot 7+{7}^{2}-{7}^{2} & =0 \\\\ (t-7{)}^{2}-{7}^{2} & =0 \\\\ (t-7{)}^{2} & =49\\end{aligned}\n$$\n\nHence, $p=-7$ and $q=49.$ Thus, $pq=-343.$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(t-7{)}^{2} & =49 \\\\ \\sqrt{(t-7{)}^{2}} & =\\sqrt{49} \\\\ |t-7| & =7 \\\\ t-7 & =\\pm 7 \\\\ t & =7\\pm 7\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}{t}_{1} & =7-7=0 \\\\ {t}_{2} & =7+7=14\\end{aligned}\n$$\n\nTherefore, the sum is ${t}_{1}+{t}_{2}=14.$"}] [{:db/id #edb/ref 17592186399746 :knowledge-point/_questions [{:db/id #edb/ref 17592186068861 :knowledge-point/id #uuid "a7f04ab7-f6f6-5d01-bfcf-b667e37e4f0b" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Irrational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c39a0e2e-7b56-5be7-b30b-746a3a4150cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=12,\\,m=-4\\pm 2\\sqrt{2}" :db/id #edb/ref 17592186399748} {:answer/id #uuid "015db316-4ebb-5b1d-99f9-48da4423ea95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=10,\\,m=-2\\pm \\sqrt{2}" :db/id #edb/ref 17592186399749} {:answer/id #uuid "6bce9687-7b54-57ab-bfdf-8d118e548ef3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=8,\\,m=4\\pm 2\\sqrt{2}" :db/id #edb/ref 17592186399750} {:answer/id #uuid "b47af5b9-db68-5705-87ff-a810d0b94396" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=10,\\,m=4\\pm 2\\sqrt{3}" :db/id #edb/ref 17592186399751} {:answer/id #uuid "51890425-293e-58e0-898f-8746f49fa609" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=14,\\,m=-4\\pm 2\\sqrt{3}" :db/id #edb/ref 17592186399752}] :answer-field/correct {:answer/id #uuid "c39a0e2e-7b56-5be7-b30b-746a3a4150cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=12,\\,m=-4\\pm 2\\sqrt{2}" :db/id #edb/ref 17592186399748} :answer-field/id #uuid "1d4fba57-c484-5fd0-a729-550a53e648f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399747}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6d70e8a4-cad6-5c6f-b225-88fe32f8d423" :question/math-academy-id "q-112487" :question/problem "The equation ${m}^{2}+8=-8m$ can be written in the form $(m+p)^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "First, we move the constant term to the right-hand side, the $-8m$ term to the left-hand side, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}{m}^{2}+8 & =-8m \\\\ {m}^{2}+8m & =-8 \\\\ {m}^{2}+2\\cdot 4\\cdot m & =-8 \\\\ {m}^{2}+2\\cdot 4\\cdot m+{4}^{2}-{4}^{2} & =-8 \\\\ (m+4)^{2}-{4}^{2} & =-8\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(m+4)^{2}-{4}^{2} & =-8 \\\\ (m+4)^{2} & =8\\end{aligned}\n$$\n\nSo, $p=4,q=8,$ and $p+q=12.$\n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(m+4)^{2} & =8 \\\\ \\sqrt{(m+4)^{2}} & =\\sqrt{8} \\\\ |m+4| & =\\sqrt{8} \\\\ m+4 & =\\pm 2\\sqrt{2} \\\\ m & =-4\\pm 2\\sqrt{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186399760 :knowledge-point/_questions [{:db/id #edb/ref 17592186184191 :knowledge-point/id #uuid "257b907c-70c1-5bbd-a6d2-297d51325d1f" :knowledge-point/title "Solving a Quadratic Equation With a Positive Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b361b7f6-2975-5ed2-b3d6-cb981bcbc5f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=6" :db/id #edb/ref 17592186399762} {:answer/id #uuid "af436aca-c25b-50d1-ae25-749ecc05a446" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=12" :db/id #edb/ref 17592186399763} {:answer/id #uuid "ef4e5843-97cc-5c3b-b643-9e3130891ce7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=4" :db/id #edb/ref 17592186399764} {:answer/id #uuid "04e15661-c522-5a93-a20e-dafb0bf87524" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=10" :db/id #edb/ref 17592186399765} {:answer/id #uuid "ab45afe2-3455-59a3-8889-5adbe62eaacf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=8" :db/id #edb/ref 17592186399766}] :answer-field/correct {:answer/id #uuid "ab45afe2-3455-59a3-8889-5adbe62eaacf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=8" :db/id #edb/ref 17592186399766} :answer-field/id #uuid "b5f1bfdb-7442-5063-835b-afe41546d21e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399761}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eaa71aa3-e92b-5db0-96a6-7043b42bf47f" :question/math-academy-id "q-112524" :question/problem "The equation $4{x}^{2}+6x-5=0$ can be written in the form $4(x+p)^{2}=q.$ Find $p+q.$" :question/worked-solution "First, we move the constant term to the right-hand side, factor the coefficient of the quadratic term, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}4{x}^{2}+6x-5 & =0 \\\\ 4{x}^{2}+6x & =5 \\\\ 4({x}^{2}+\\frac{3}{2}x) & =5 \\\\ 4[{x}^{2}+2\\cdot \\frac{3}{4}\\cdot x+{(\\frac{3}{4})}^{2}-{(\\frac{3}{4})}^{2}] & =5 \\\\ 4[{(x+\\frac{3}{4})}^{2}-{(\\frac{3}{4})}^{2}] & =5 \\\\ 4[{(x+\\frac{3}{4})}^{2}-\\frac{9}{16}] & =5\\end{aligned}\n$$\n\nNext, we expand the brackets, and write the equation in the required form:\n\n$$\n\\begin{aligned}4{(x+\\frac{3}{4})}^{2}-4\\cdot \\frac{9}{16} & =5 \\\\ 4{(x+\\frac{3}{4})}^{2}-\\frac{9}{4} & =5 \\\\ 4{(x+\\frac{3}{4})}^{2} & =\\frac{29}{4}\\end{aligned}\n$$\n\nTherefore, $p=\\frac{3}{4}$ and $q=\\frac{29}{4}.$ Finally,\n\n$$\np+q=\\frac{3}{4}+\\frac{29}{4}=\\frac{32}{4}=8.\n$$"}] [{:db/id #edb/ref 17592186247286 :knowledge-point/_questions [{:db/id #edb/ref 17592186096784 :knowledge-point/id #uuid "f7578c48-cc9e-5170-8ffe-5ebee6580677" :knowledge-point/title "Solving a System Containing Decimals in One Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6ebfd06-d7c9-57b4-b164-23f6c520852b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186245809} {:answer/id #uuid "ae0c5246-8ce2-595b-ad3a-db2ecfd1e47e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186245867} {:answer/id #uuid "c4fb152b-7d3f-5c08-a1e9-825a6063554e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186246063} {:answer/id #uuid "d2cb50da-f2c1-5202-9d6c-9c29e5314403" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186246188} {:answer/id #uuid "e8a51a07-fd3f-5ae5-ae01-d02b470db8e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186246373}] :answer-field/correct {:answer/id #uuid "c4fb152b-7d3f-5c08-a1e9-825a6063554e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186246063} :answer-field/id #uuid "e99cf02c-5f10-549e-80cb-8624ae42aa3b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246962}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "67d9ca65-c314-5c48-b66e-c63d3eedec32" :question/math-academy-id "q-112561" :question/problem "Let $(x,y)$ be the solution of the following system. What is the value of $x+y?$\n\n$$\n{\\begin{aligned}x+3y=7 \\\\ 0.5x+0.4y=0.2\\end{aligned}\n$$" :question/worked-solution "To get rid of the decimals, we multiply the second equation by $10,$ as follows:\n\n$$\n{\\begin{aligned}x+3y=7 &  \\\\ 0.5x+0.4y=0.2 & |\\,\\times 10\\end{aligned}\\,⟹\\,{\\begin{aligned}x+3y=7 \\\\ 5x+4y=2\\end{aligned}\n$$\n\nNotice that if we multiply the  first equation by $-5,$ then we will get a $-5x$ term that can cancel with the $5x$ term in the second equation:\n\n$$\n{\\begin{aligned}x+3y=7 & |\\,\\times (-5) \\\\ 5x+4y=2\\end{aligned}\\,⟹\\,{\\begin{aligned}-5x-15y=-35 \\\\ 5x+4y=2\\end{aligned}\n$$\n\nAdding the two equations eliminates the $x$-variable and allows us to solve for $y:$\n\n$$\n\\begin{aligned}\\begin{aligned}-\\cancel{5x}-15y & =-35 \\\\ \\cancel{5x}+4y & =2 \\\\ (-15y+4y) & =(-33) \\\\ -11y & =-33 \\\\ y & =3\\end{aligned}\\end{aligned}\n$$\n\nFinally, we can substitute $y=3$ into the equation $x+3y=7$ to solve for $x:$\n\n$$\n\\begin{aligned}\\begin{aligned}x+3y & =7 \\\\ x+3(3) & =7 \\\\ x+9 & =7 \\\\ x & =-2\\end{aligned}\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x=-2,\\,y=3.$ So,\n\n$$\nx+y=(-2)+(3)=1.\n$$"}] [{:db/id #edb/ref 17592186247293 :knowledge-point/_questions [{:db/id #edb/ref 17592186129145 :knowledge-point/id #uuid "4fc09a0f-34d3-5ca9-9964-6cb00498bfa7" :knowledge-point/title "Identifying the Factored Polynomial Shown in a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f558239-f4a4-5855-9197-acc15e505249" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x(x+2)(x+3{)}^{3}" :db/id #edb/ref 17592186244588} {:answer/id #uuid "3725f8b4-55f3-5d89-94d0-703eea9f7ae1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{3}(x+2{)}^{3}(x+3{)}^{2}" :db/id #edb/ref 17592186244802} {:answer/id #uuid "9272bb35-cb93-5c03-9095-56d3bf0f34e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{4}x(x+2)(x-3)" :db/id #edb/ref 17592186245590} {:answer/id #uuid "b34d6675-f629-5fa4-8fd7-539940bd8f9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5{x}^{3}(x+2{)}^{2}(x-3{)}^{3}" :db/id #edb/ref 17592186245912} {:answer/id #uuid "d04fc1cd-f13a-5132-a1fa-779918c80d88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{5}{x}^{3}(x+2)(x-3)" :db/id #edb/ref 17592186246172}] :answer-field/correct {:answer/id #uuid "d04fc1cd-f13a-5132-a1fa-779918c80d88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{5}{x}^{3}(x+2)(x-3)" :db/id #edb/ref 17592186246172} :answer-field/id #uuid "aef2415b-6234-5ebf-b592-60e406e41efb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246866}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ac9b5d16-e129-5bbc-9ccb-344cad0daab4" :question/math-academy-id "q-112596" :question/problem "![](images/84/849535b983a64c97b4cf06afcc7da7598349dc3f14f771cd3ae20db2c0742e8b.png)\n\nWhich of the following could be the equation of the polynomial curve shown above?" :question/worked-solution "First, we notice that the function has precisely three distinct roots, $x=-2,$ $x=0$ and $x=3.$\n\nBased on the graph, we can make the following conclusions about the multiplicities of the roots:\n\n- Since the graph is *not* tangent to the $x$-axis at $x=-2,$ this root is a simple root (the multiplicity equals $1$).\n\n- Since the graph passes through $x=0,$ this root has odd multiplicity, and since the graph is tangent to the $x$-axis at $x=0,$ the multiplicity must be greater than one.\n\n- Since the graph is *not* tangent to the $x$-axis at $x=3,$ this root is a simple root (the multiplicity equals $1$).\n\nTherefore, the only possible equation is $y=\\frac{1}{5}{x}^{3}(x+2)(x-3).$"}]}
