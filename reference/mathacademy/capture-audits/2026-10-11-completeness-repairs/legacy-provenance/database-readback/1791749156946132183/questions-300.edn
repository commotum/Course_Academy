#{[{:db/id #edb/ref 17592186250326 :knowledge-point/_questions [{:db/id #edb/ref 17592186068921 :knowledge-point/id #uuid "98a67346-c2c9-5d22-8adf-479fea81eaa2" :knowledge-point/title "Computing the Integral of a Logarithmic Expression Using Integration by Parts Twice"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01c50259-96ff-5091-b6d8-d010aabcd87a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{e}^{2}-3}{4{ln}^{2}⁡2}" :db/id #edb/ref 17592186247435} {:answer/id #uuid "5b1b58be-7936-591f-a3c9-e22825f21d58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{2}+3" :db/id #edb/ref 17592186248249} {:answer/id #uuid "602d95a8-3c49-5628-a5fc-26ae6d4442af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{e}^{3}-1" :db/id #edb/ref 17592186248293} {:answer/id #uuid "ae45cdbd-b5db-5833-8170-fccfe8733b9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{e}^{3}-2}{3{ln}^{2}⁡2}" :db/id #edb/ref 17592186248981} {:answer/id #uuid "f16fc0ad-7654-55ab-873b-8984cf712d78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{3}-1}{{ln}^{2}⁡2}" :db/id #edb/ref 17592186249543}] :answer-field/correct {:answer/id #uuid "ae45cdbd-b5db-5833-8170-fccfe8733b9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{e}^{3}-2}{3{ln}^{2}⁡2}" :db/id #edb/ref 17592186248981} :answer-field/id #uuid "46bceeef-1e66-56f1-87c4-0b40ebcc4c53" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249799}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c7237523-38ec-5167-93d0-30747905ffb7" :question/math-academy-id "q-114942" :question/problem "Evaluate ${\\int }_{1}^{e}9{x}^{2}({log}_{2}⁡x)^{2}\\,\\text{d}x.$" :question/worked-solution "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=({log}_{2}⁡x)^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2{log}_{2}⁡x}{x\\operatorname{ln}⁡2} \\\\ \\frac{\\text{d}v}{\\text{d}x}=9{x}^{2}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int 9{x}^{2}\\,\\text{d}x=3{x}^{3}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 9{x}^{2}({log}_{2}⁡x)^{2}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={({log}_{2}⁡x)}^{2}(3{x}^{3})-\\int (3{x}^{3})(\\frac{2{log}_{2}⁡x}{x\\operatorname{ln}⁡2})\\,\\text{d}x \\\\  & =3{x}^{3}{({log}_{2}⁡x)}^{2}-\\frac{6}{\\operatorname{ln}⁡2}\\int {x}^{2}{log}_{2}⁡x\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate  $\\int {x}^{2}{log}_{2}⁡x\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u={log}_{2}⁡x\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡2} \\\\ \\frac{\\text{d}v}{\\text{d}x}={x}^{2}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int {x}^{2}\\,\\text{d}x=\\frac{{x}^{3}}{3}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int {x}^{2}{log}_{2}⁡x\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =({log}_{2}⁡x)(\\frac{{x}^{3}}{3})-\\int (\\frac{{x}^{3}}{3})(\\frac{1}{x\\operatorname{ln}⁡2})\\,\\text{d}x \\\\  & =\\frac{{x}^{3}{log}_{2}⁡x}{3}-\\frac{1}{3\\operatorname{ln}⁡2}\\int {x}^{2}\\,\\text{d}x \\\\  & =\\frac{{x}^{3}{log}_{2}⁡x}{3}-\\frac{{x}^{3}}{9\\operatorname{ln}⁡2}+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant.\n\nSo we have\n\n$$\n\\begin{aligned}\\int 9{x}^{2}({log}_{2}⁡x)^{2}\\,\\text{d}x & =3{x}^{3}{({log}_{2}⁡x)}^{2}-\\frac{6}{\\operatorname{ln}⁡2}(\\frac{{x}^{3}{log}_{2}⁡x}{3}-\\frac{{x}^{3}}{9\\operatorname{ln}⁡2}+D) \\\\  & =3{x}^{3}{({log}_{2}⁡x)}^{2}-\\frac{2{x}^{3}{log}_{2}⁡x}{\\operatorname{ln}⁡2}+\\frac{2{x}^{3}}{3{ln}^{2}⁡2}+C \\\\  & =\\frac{3{x}^{3}{ln}^{2}⁡x}{{ln}^{2}⁡2}-\\frac{2{x}^{3}\\operatorname{ln}⁡x}{{ln}^{2}⁡2}+\\frac{2{x}^{3}}{3{ln}^{2}⁡2}+C \\\\  & =\\frac{{x}^{3}}{{ln}^{2}⁡2}(3{ln}^{2}⁡x-2\\operatorname{ln}⁡x+\\frac{2}{3})+C.\\end{aligned}\n$$\n\nwhere $C=-\\frac{6D}{\\operatorname{ln}⁡2}.$\n\nNote that in the above calculation we used the change of base formula ${log}_{2}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡2}.$\n\nFinally then, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}9{x}^{2}({log}_{2}⁡x)^{2}\\,\\text{d}x & ={[\\frac{{x}^{3}}{{ln}^{2}⁡2}(3{ln}^{2}⁡x-2\\operatorname{ln}⁡x+\\frac{2}{3})]}_{1}^{e} \\\\  & =\\frac{{e}^{3}}{{ln}^{2}⁡2}(3{ln}^{2}⁡e-2\\operatorname{ln}⁡e+\\frac{2}{3})-\\frac{{1}^{3}}{{ln}^{2}⁡2}(3{ln}^{2}⁡1-2\\operatorname{ln}⁡1+\\frac{2}{3}) \\\\  & =\\frac{{e}^{3}}{{ln}^{2}⁡2}(3-2+\\frac{2}{3})-\\frac{1}{{ln}^{2}⁡2}(0-0+\\frac{2}{3}) \\\\  & =\\frac{5{e}^{3}}{3{ln}^{2}⁡2}-\\frac{2}{3{ln}^{2}⁡2} \\\\  & =\\frac{5{e}^{3}-2}{3{ln}^{2}⁡2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250327 :knowledge-point/_questions [{:db/id #edb/ref 17592186068921 :knowledge-point/id #uuid "98a67346-c2c9-5d22-8adf-479fea81eaa2" :knowledge-point/title "Computing the Integral of a Logarithmic Expression Using Integration by Parts Twice"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f84bc89-0f5f-5174-b311-6b1ac207d432" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4e-8}{{ln}^{2}⁡3}" :db/id #edb/ref 17592186248845} {:answer/id #uuid "acd12eca-de9b-50f1-ae82-10635e26c184" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e-6}{{ln}^{2}⁡3}" :db/id #edb/ref 17592186248968} {:answer/id #uuid "f04115a5-6b2e-5bc2-9ed5-4e7dbb828a37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{2}+6" :db/id #edb/ref 17592186249532} {:answer/id #uuid "f2594c73-abaa-58dd-995b-af12abd8461c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{e}^{2}-2" :db/id #edb/ref 17592186249549} {:answer/id #uuid "f538ac92-7bb7-5776-a593-eda1db9ee897" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4e+3}{{ln}^{2}⁡3}" :db/id #edb/ref 17592186249565}] :answer-field/correct {:answer/id #uuid "9f84bc89-0f5f-5174-b311-6b1ac207d432" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4e-8}{{ln}^{2}⁡3}" :db/id #edb/ref 17592186248845} :answer-field/id #uuid "6b1851a2-09ca-5e98-9283-451c4f3c0948" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249855}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ee94ab2f-1f66-5795-8930-e1ab98c8dab8" :question/math-academy-id "q-114944" :question/problem "Evaluate ${\\int }_{1}^{e}{({log}_{3}⁡({x}^{2}))}^{2}\\,\\text{d}x.$" :question/worked-solution "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u={({log}_{3}⁡({x}^{2}))}^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{4{log}_{3}⁡({x}^{2})}{x\\operatorname{ln}⁡3} \\\\ \\frac{\\text{d}v}{\\text{d}x}=1\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\,\\text{d}x=x.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int {({log}_{3}⁡({x}^{2}))}^{2}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =x{({log}_{3}⁡({x}^{2}))}^{2}-\\int (x)(\\frac{4{log}_{3}⁡({x}^{2})}{x\\operatorname{ln}⁡3})\\,\\text{d}x \\\\  & =x{({log}_{3}⁡({x}^{2}))}^{2}-\\frac{4}{\\operatorname{ln}⁡3}\\int {log}_{3}⁡({x}^{2})\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate  $\\int {log}_{3}⁡({x}^{2})\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u={log}_{3}⁡({x}^{2})\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2}{x\\operatorname{ln}⁡3} \\\\ \\frac{\\text{d}v}{\\text{d}x}=1\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\,\\text{d}x=x.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int {log}_{3}⁡({x}^{2})\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =({log}_{3}⁡({x}^{2}))(x)-\\int (x)(\\frac{2}{x\\operatorname{ln}⁡3})\\,\\text{d}x \\\\  & =x{log}_{3}⁡({x}^{2})-\\frac{2}{\\operatorname{ln}⁡3}\\int \\,\\text{d}x \\\\  & =x{log}_{3}⁡({x}^{2})-\\frac{2x}{\\operatorname{ln}⁡3}+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant.\n\nSo we have\n\n$$\n\\begin{aligned}\\int {({log}_{3}⁡({x}^{2}))}^{2}\\,\\text{d}x & =x{({log}_{3}⁡({x}^{2}))}^{2}-\\frac{4}{\\operatorname{ln}⁡3}(x{log}_{3}⁡({x}^{2})-\\frac{2x}{\\operatorname{ln}⁡3}+D) \\\\  & =x{({log}_{3}⁡({x}^{2}))}^{2}-\\frac{4x{log}_{3}⁡({x}^{2})}{\\operatorname{ln}⁡3}+\\frac{8x}{{ln}^{2}⁡3}+C \\\\  & =\\frac{x{ln}^{2}⁡({x}^{2})}{{ln}^{2}⁡3}-\\frac{4x\\operatorname{ln}⁡({x}^{2})}{{ln}^{2}⁡3}+\\frac{8x}{{ln}^{2}⁡3}+C \\\\  & =\\frac{x}{{ln}^{2}⁡3}({ln}^{2}⁡({x}^{2})-4\\operatorname{ln}⁡({x}^{2})+8)+C.\\end{aligned}\n$$\n\nwhere $C=-\\frac{4D}{\\operatorname{ln}⁡3}.$\n\nNote that in the above calculation we used the change of base formula ${log}_{3}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡3}.$\n\nFinally then, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}{({log}_{3}⁡({x}^{2}))}^{2}\\,\\text{d}x & ={[\\frac{x}{{ln}^{2}⁡3}({ln}^{2}⁡({x}^{2})-4\\operatorname{ln}⁡({x}^{2})+8)]}_{1}^{e} \\\\  & =\\frac{e}{{ln}^{2}⁡3}({ln}^{2}⁡({e}^{2})-4\\operatorname{ln}⁡({e}^{2})+8)-\\frac{1}{{ln}^{2}⁡3}({ln}^{2}⁡({1}^{2})-4\\operatorname{ln}⁡({1}^{2})+8) \\\\  & =\\frac{e}{{ln}^{2}⁡3}(4-8+8)-\\frac{1}{{ln}^{2}⁡3}(0-0+8) \\\\  & =\\frac{4e-8}{{ln}^{2}⁡3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250332 :knowledge-point/_questions [{:db/id #edb/ref 17592186068734 :knowledge-point/id #uuid "df0c3b59-7667-53e9-84d3-bba30ea116fb" :knowledge-point/title "Integrating a Logarithmic Expression Using Cyclic Integration by Parts"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c0432af-5e36-5fda-8917-32b349683fe4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}" :db/id #edb/ref 17592186247816} {:answer/id #uuid "38592cbc-383b-5e42-b2c1-16c799f4dac1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186247927} {:answer/id #uuid "472b2169-b73e-52b2-a759-79ee2c0017dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186248056} {:answer/id #uuid "a124094c-2198-56e3-a44a-8e218a714881" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{18}" :db/id #edb/ref 17592186248864} {:answer/id #uuid "c2c76c8f-f2d8-5896-8bd2-98aa7de77cc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{40}" :db/id #edb/ref 17592186249157}] :answer-field/correct {:answer/id #uuid "c2c76c8f-f2d8-5896-8bd2-98aa7de77cc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{40}" :db/id #edb/ref 17592186249157} :answer-field/id #uuid "dfceba82-e7c8-58e8-a6e1-6dbed0dd06ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250056}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "aafbcc52-b05c-5248-b40a-c0ce083a128b" :question/math-academy-id "q-114999" :question/problem "Evaluate ${\\int }_{1}^{e}\\frac{{ln}^{9}⁡x}{4x}\\,\\text{d}x$ using integration by parts." :question/worked-solution "Let's denote the indefinite integral by $I=\\int \\frac{{ln}^{9}⁡x}{4x}\\,\\text{d}x.$\n\nTo use integration by parts, let's suppose that\n\n$$\n\\begin{aligned}u={ln}^{9}⁡x & \\,⇒\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{9{ln}^{8}⁡x}{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{4x} & \\,⇒\\,v=\\int \\frac{1}{4x}\\text{d}x=\\frac{\\operatorname{ln}⁡x}{4}\\,.\\end{aligned}\n$$\n\nUsing the integration by parts formula, we get\n\n$$\n\\begin{aligned}I & =\\int \\frac{{ln}^{9}⁡x}{4x}\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =({ln}^{9}⁡x)(\\frac{\\operatorname{ln}⁡x}{4})-\\int (\\frac{\\operatorname{ln}⁡x}{4})(\\frac{9{ln}^{8}⁡x}{x})\\,\\text{d}x \\\\  & =\\frac{{ln}^{10}⁡x}{4}-9\\int \\frac{{ln}^{9}⁡x}{4x}\\,\\text{d}x \\\\  & =\\frac{{ln}^{10}⁡x}{4}-9I.\\end{aligned}\n$$\n\nNow, we solve for $I.$ We can ignore the constant of integration in this case, because it is insignificant for further evaluation of the definite integral.\n\n$$\n\\begin{aligned}I & =\\frac{{ln}^{10}⁡x}{4}-9I \\\\ 10I & =\\frac{{ln}^{10}⁡x}{4} \\\\ I & =\\frac{{ln}^{10}⁡x}{40}\\end{aligned}\n$$\n\nFinally, we evaluate our definite integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}\\frac{{ln}^{9}⁡x}{4x}\\,\\text{d}x & =\\frac{1}{40}({ln}^{10}⁡x){|}_{1}^{e} \\\\  & =\\frac{1}{40}({ln}^{10}⁡(e)-{ln}^{10}⁡(1)) \\\\  & =\\frac{1}{40}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250333 :knowledge-point/_questions [{:db/id #edb/ref 17592186157442 :knowledge-point/id #uuid "bf6a3dbb-52b3-5384-b640-0fbf29a6cc98" :knowledge-point/title "Solving an Inequality Involving a Cube Root"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f66da87-fd41-50fb-b1c2-717ae0591859" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le 13" :db/id #edb/ref 17592186247850} {:answer/id #uuid "2ffb2392-7201-5c3f-88bc-392e23cd505a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le 3" :db/id #edb/ref 17592186247855} {:answer/id #uuid "32b16bed-d3ba-546b-bd37-eb68ce75789b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge -10" :db/id #edb/ref 17592186247885} {:answer/id #uuid "4204141e-6e99-5199-acf5-81445a1bf4ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge \\frac{1}{5}" :db/id #edb/ref 17592186248012} {:answer/id #uuid "659e5468-e099-55eb-a4ef-9a48327cdd3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le -\\frac{1}{2}" :db/id #edb/ref 17592186248339}] :answer-field/correct {:answer/id #uuid "2f66da87-fd41-50fb-b1c2-717ae0591859" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le 13" :db/id #edb/ref 17592186247850} :answer-field/id #uuid "b9dadf63-5d8c-56c1-8844-878ea2a7844a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249993}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9ed9bfbd-adb2-54e5-bf5d-6caa34443565" :question/math-academy-id "q-115031" :question/problem "Solve the inequality $\\sqrt[3]{2x+1}-1\\le 2.$" :question/worked-solution "Isolating the cubic term, we find\n\n$$\n\\begin{aligned}\\sqrt[3]{2x+1}-1 & \\le 2 \\\\ \\sqrt[3]{2x+1} & \\le 3.\\end{aligned}\n$$\n\nThen, we cube both sides and get\n\n$$\n\\begin{aligned}{(\\sqrt[3]{2x+1})}^{3} & \\le {3}^{3} \\\\ 2x+1 & \\le 27 \\\\ 2x & \\le 26 \\\\ x & \\le 13.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250336 :knowledge-point/_questions [{:db/id #edb/ref 17592186157444 :knowledge-point/id #uuid "b9003081-7cf6-5a99-accf-6a69b65db47c" :knowledge-point/title "Solving an Inequality Involving a Square Root Compared to a Positive Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3564e2a5-ba18-58e3-9497-d50cc0692004" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 2" :db/id #edb/ref 17592186247906} {:answer/id #uuid "60fa415e-863e-52e6-8c9d-8d42097785cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<4" :db/id #edb/ref 17592186248303} {:answer/id #uuid "650ebc5e-e2e2-5ca5-b151-05ddd64dd8c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x>2" :db/id #edb/ref 17592186248337} {:answer/id #uuid "a41f2bde-3993-51d4-8882-317d4fbb8c8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\le x<2" :db/id #edb/ref 17592186248889} {:answer/id #uuid "f34c118a-b3d6-5aab-95f6-8be27be10205" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2<x\\le 4" :db/id #edb/ref 17592186249553}] :answer-field/correct {:answer/id #uuid "650ebc5e-e2e2-5ca5-b151-05ddd64dd8c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x>2" :db/id #edb/ref 17592186248337} :answer-field/id #uuid "892a9195-75ee-52b8-9233-5dc3d86faed5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249908}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6c2efa64-c4bf-59c9-a9ea-6f12963b4810" :question/math-academy-id "q-115060" :question/problem "Solve the inequality $\\sqrt{x+2}-4>-2.$" :question/worked-solution "First, we isolate the square root:\n\n$$\n\\begin{aligned}\\sqrt{x+2}-4 & >-2 \\\\ \\sqrt{x+2} & >2\\end{aligned}\n$$\n\nIn this inequality, the square root is being compared to a non-negative number $(2).$ So, we can square both sides of the inequality:\n\n$$\n\\begin{aligned}{(\\sqrt{x+2})}^{2} & >{2}^{2} \\\\ x+2 & >4 \\\\ x & >2\\end{aligned}\n$$\n\nNow, we must only keep the solutions that are in the domain of the square root. To find the domain of the square root, we recall that the argument of the square root must be greater than or equal to zero:\n\n$$\n\\begin{aligned}x+2 & \\ge 0 \\\\ x & \\ge -2\\end{aligned}\n$$\n\nOur solution is $x>2,$ which can be expressed as $(2,\\infty ).$ The domain of the square root is $x\\ge -2,$ which can be expressed as $[-2,\\infty ).$ To find the solutions that are in the domain of the square root, we take the intersection:\n\n$$\n(2,\\infty )\\cap [-2,\\infty )=(2,\\infty )\n$$\n\nTherefore, the solution is $x\\in (2,\\infty ),$ which can also be written as $x>2.$"}] [{:db/id #edb/ref 17592186250341 :knowledge-point/_questions [{:db/id #edb/ref 17592186096816 :knowledge-point/id #uuid "0f247351-8c81-595e-bb30-26630159819c" :knowledge-point/title "Calculating a Missing Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "486cff62-01d3-5049-9232-7e6b8711ae02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186248073} {:answer/id #uuid "735df79d-ddb4-5640-bc31-d30cdbd2b16c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186248433} {:answer/id #uuid "a517b323-5082-5ab0-976c-3adc8f5377c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186248898} {:answer/id #uuid "ba0187fb-9d9a-5be9-8904-397388709c9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186249085} {:answer/id #uuid "beede94a-cbfc-5628-8c7c-ee54767e0e85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186249121}] :answer-field/correct {:answer/id #uuid "735df79d-ddb4-5640-bc31-d30cdbd2b16c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186248433} :answer-field/id #uuid "1d4f1ea4-5984-59d1-8aad-4caa825a8331" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249721}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "76685609-49ea-56b3-87fb-774aa7271a5f" :question/math-academy-id "q-115101" :question/problem "Given that \n\n$$\n\\frac{5x-22}{(x-4)^{2}}=\\frac{5}{x-4}+\\frac{B}{(x-4)^{2}},\n$$\n\nwhat is the value of $B?$" :question/worked-solution "Multiplying both sides of the given equality by $(x-4)^{2}$ gives\n\n$$\n\\begin{aligned}5x-22 & =5(x-4)+B.\\end{aligned}\n$$\n\nLetting $x=4$  gives\n\n$$\n\\begin{aligned}5(4)-22 & =5(4-4)+B \\\\ -2 & =0+B \\\\ B & =-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250347 :knowledge-point/_questions [{:db/id #edb/ref 17592186087840 :knowledge-point/id #uuid "de557d1d-5f27-50e3-bcba-22b21f83267f" :knowledge-point/title "Determining the Equation of a Tall Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "153668da-d780-523a-8e26-48e058715b79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{36}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186247615} {:answer/id #uuid "3d9dc02d-1da3-5526-af85-e13cc50a7c05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{12}=1" :db/id #edb/ref 17592186247968} {:answer/id #uuid "750c26fb-43a5-5a41-8361-58c46e0b0804" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{36}=1" :db/id #edb/ref 17592186248452} {:answer/id #uuid "a1d902f3-35d6-5d0d-ac8b-52610f9c819b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2}+\\frac{{y}^{2}}{6}=1" :db/id #edb/ref 17592186248870} {:answer/id #uuid "a8569992-7633-5a8b-9630-e609ef25ddfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186248919}] :answer-field/correct {:answer/id #uuid "750c26fb-43a5-5a41-8361-58c46e0b0804" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{36}=1" :db/id #edb/ref 17592186248452} :answer-field/id #uuid "106279dc-5bad-5b89-83c9-6a40e4f9b6f8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249697}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "522f5175-a019-5a90-95ed-58cc045a0980" :question/math-academy-id "q-115124" :question/problem "![](images/76/764f25a4b18f3f28110c0ce3345402bf183d61cac350832663e221b0de9852a5.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=2$ and the vertical radius has length $b=6.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{2}^{2}}+\\frac{{y}^{2}}{{6}^{2}} & =1 \\\\ \\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{36} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186399850 :knowledge-point/_questions [{:db/id #edb/ref 17592186087841 :knowledge-point/id #uuid "4e43e393-8752-58bc-b87c-b72f679cbfd9" :knowledge-point/title "Determining the Lengths of the Major and Minor Axes Given the Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4ffa0ff-df0b-5bc5-b896-3f6772a35019" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$28$ and $24$" :db/id #edb/ref 17592186399852} {:answer/id #uuid "e8f1177f-3e11-593f-ad9c-dda3299fba50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$24.5$ and $18$" :db/id #edb/ref 17592186399853} {:answer/id #uuid "e59ee665-26a4-5d2e-8c55-26143f2480d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$14$ and $12$" :db/id #edb/ref 17592186399854} {:answer/id #uuid "ee829b75-97f1-545e-8cf4-3704340f4ba1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$49$ and $36$" :db/id #edb/ref 17592186399855} {:answer/id #uuid "f8e390e1-9f85-5321-a954-3f147b97e82b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7$ and $6$" :db/id #edb/ref 17592186399856}] :answer-field/correct {:answer/id #uuid "e59ee665-26a4-5d2e-8c55-26143f2480d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$14$ and $12$" :db/id #edb/ref 17592186399854} :answer-field/id #uuid "44102d96-20a4-51fc-add2-7a7a026df6ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399851}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3113828e-6ca6-530b-804d-2cdc91aade73" :question/math-academy-id "q-115134" :question/problem "What are the lengths of the major and minor axes of an ellipse with equation \n$\\frac{{x}^{2}}{49}+\\frac{{y}^{2}}{36}=1?$" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have ${a}^{2}=49$ and ${b}^{2}=36.$\n\n- Since ${a}^{2}=49,$ the length of the horizontal radius must be $a=\\sqrt{49}=7.$\n\n- Since ${b}^{2}=36,$ the length of the vertical radius must be $b=\\sqrt{36}=6.$\n\nThus, the semi-major axis has length $a=7,$ and the semi-minor axis has length $b=6.$\n\nTherefore, the major axis has length $2a=2\\cdot 7=14,$ and the minor axis has length $2b=2\\cdot 6=12.$"}] [{:db/id #edb/ref 17592186250352 :knowledge-point/_questions [{:db/id #edb/ref 17592186157429 :knowledge-point/id #uuid "04309d45-2991-5d4b-9dc9-b75422610ab6" :knowledge-point/title "Solving an Inequality When the Base of the Exponential is Greater Than One"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02bdd76d-fa8d-58df-b8b1-e545dd5c28a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<2" :db/id #edb/ref 17592186247444} {:answer/id #uuid "5f8022bf-d528-51f6-a8fe-a1a2f2edfe97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<\\operatorname{ln}⁡(1+e)+3" :db/id #edb/ref 17592186248288} {:answer/id #uuid "72f0f4a1-3bd5-58b1-99bb-22f7c3a5d087" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<2-e" :db/id #edb/ref 17592186248429} {:answer/id #uuid "7b638bf8-7756-522e-9993-bf13fac41704" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<\\operatorname{ln}⁡(1+e)-1" :db/id #edb/ref 17592186248508} {:answer/id #uuid "e798bb82-b211-5b83-b9ba-7f365819f211" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<-1" :db/id #edb/ref 17592186249468}] :answer-field/correct {:answer/id #uuid "02bdd76d-fa8d-58df-b8b1-e545dd5c28a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<2" :db/id #edb/ref 17592186247444} :answer-field/id #uuid "f6d28fe8-a9db-5ee3-a3b6-13de7bfcbfad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250106}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5c7e7d0e-6a38-575b-b57f-c4b68672e279" :question/math-academy-id "q-115205" :question/problem "Solve the inequality $2{e}^{x-2}+1<3.$" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}2{e}^{x-2}+1 & <3 \\\\ 2{e}^{x-2} & <2 \\\\ {e}^{x-2} & <1.\\end{aligned}\n$$\n\nThen, taking the natural logarithm of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({e}^{x-2}) & <\\operatorname{ln}⁡1 \\\\ x-2 & <0 \\\\ x & <2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250353 :knowledge-point/_questions [{:db/id #edb/ref 17592186083303 :knowledge-point/id #uuid "1894719c-d398-515d-9a7b-6af74727106c" :knowledge-point/title "Identifying Improper Integrals of the Second Kind"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1331863b-a302-58b4-9558-bc6c0b781ddd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186247597} {:answer/id #uuid "36fe5dcf-5d70-5ccd-8b3b-8661bcaea147" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186247921} {:answer/id #uuid "92955910-edae-5a7a-b65c-edd5d27d9121" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186248725} {:answer/id #uuid "dcb4ad55-4197-5c67-b00c-1c2e28d99060" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186249378} {:answer/id #uuid "fd61f6bd-4d20-5f39-9c6d-c8955e640d47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186249640}] :answer-field/correct {:answer/id #uuid "fd61f6bd-4d20-5f39-9c6d-c8955e640d47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186249640} :answer-field/id #uuid "94eeb897-d52c-516d-8260-943991a2821b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249937}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2a47dc9e-71f1-5fb5-bcb1-b46747ed60f1" :question/math-academy-id "q-115206" :question/problem "Which of the following is an improper integral of the second kind?\n\n- ${\\int }_{-1}^{1}\\frac{\\text{d}x}{{x}^{2}-4}\\,$  II. ${\\int }_{-\\infty }^{-3}\\frac{\\text{d}x}{{x}^{2}-4}\\,$  III. ${\\int }_{-2}^{1}\\frac{\\text{d}x}{{x}^{2}-4}$" :question/worked-solution "Let's examine each of the given integrals.\n\n- Integral I is not an improper integral since it has finite limits and the function under the integral is finite at every point $x\\in [-1,1].$\n\n- Integral II is an improper integral over an *infinite* domain since its lower limit is infinite.\n\n- Integral III is an improper integral of the second kind since it has finite limits, and \n\n$$\nf(x)=\\frac{1}{{x}^{2}-4}\\to -\\infty \\,\\text{as}\\,x\\to (-2)^{+}.\n$$\n\nTherefore, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186250356 :knowledge-point/_questions [{:db/id #edb/ref 17592186096819 :knowledge-point/id #uuid "9e9c4ef2-0491-5b42-8679-4fe7dfbd7b00" :knowledge-point/title "Finding a Partial Fraction Decomposition With Higher Order Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3dbca64e-b64c-56ce-8eb6-ecc6fa7d24a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186247969} {:answer/id #uuid "7dcc2019-801d-5716-bfaf-80f9a09a03a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186248526} {:answer/id #uuid "8a2be079-dea0-55fc-b357-78c9dfb9a15a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186248655} {:answer/id #uuid "8eeafaf3-5a99-5006-982b-a9ce701b9d8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186248693} {:answer/id #uuid "b8ebd06e-cdc5-52a8-b4dd-4e79454aff1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186249077}] :answer-field/correct {:answer/id #uuid "8a2be079-dea0-55fc-b357-78c9dfb9a15a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186248655} :answer-field/id #uuid "9f468e2b-e0a3-5878-a496-8f74d00ba6ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249949}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1a9eca33-ce1c-5c81-8c1b-83778e94422b" :question/math-academy-id "q-115214" :question/problem "Given that \n\n$$\n\\frac{{x}^{2}-6x+9}{(x-2)^{3}}=\\frac{A}{x-2}+\\frac{B}{(x-2)^{2}}+\\frac{C}{(x-2)^{3}},\n$$\n\nwhere $A$, $B$ and $C$ are real constants, find the value of $A\\cdot B\\cdot C.$" :question/worked-solution "Multiplying both sides of the given equality by $(x-2)^{3}$ gives\n\n$$\n\\begin{aligned}{x}^{2}-6x+9 & =A(x-2)^{2}+B(x-2)+C.\\end{aligned}\n$$\n\nLetting $x=2$  gives\n\n$$\n\\begin{aligned}{2}^{2}-6(2)+9 & =A(2-2)^{2}+B(2-2)+C \\\\ 1 & =A(0)+B(0)+C \\\\ C & =1.\\end{aligned}\n$$\n\nLetting $x=0$ and using our value for $C$ gives\n\n$$\n\\begin{aligned}{0}^{2}-6(0)+9 & =A(0-2)^{2}+B(0-2)+1 \\\\ 9 & =4A-2B+1 \\\\ 0 & =4A-2B-8 \\\\ 0 & =2A-B-4 \\\\ B & =2A-4.\\,\\,(1)\\end{aligned}\n$$\n\nNow, letting $x=1$ and using our value for $C$ gives\n\n$$\n\\begin{aligned}{1}^{2}-6(1)+9 & =A(1-2)^{2}+B(1-2)+1 \\\\ 4 & =A-B+1 \\\\ 0 & =A-B-3 \\\\ B & =A-3.\\,\\,(2)\\end{aligned}\n$$\n\nFrom $(1)$ and $(2)$ we have\n\n$$\n\\begin{aligned}2A-4 & =A-3 \\\\ 2A-A & =-3+4 \\\\ A & =1.\\end{aligned}\n$$\n\nNow we substitute the value of $A$ into $(2)$  to get the value of $B:$\n\n$$\n\\begin{aligned}B & =A-3=-2\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}A\\cdot B\\cdot C & =1\\cdot (-2)\\cdot 1=-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250363 :knowledge-point/_questions [{:db/id #edb/ref 17592186157431 :knowledge-point/id #uuid "a114450f-bfcd-5db3-9060-fcd067c606fa" :knowledge-point/title "Solving an Inequality When the Exponential is Compared to Zero or a Negative Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8bdffb0b-c92f-5db5-9e16-6a3a24c0abd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "all real numbers" :db/id #edb/ref 17592186248676} {:answer/id #uuid "e6f077c7-5e76-5947-a22b-b6009f1fd675" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge \\frac{12\\operatorname{ln}⁡0.72+7}{3}" :db/id #edb/ref 17592186249458} {:answer/id #uuid "e7f9e7c7-c57e-5eff-8f9d-5369d8005008" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le 7-12\\operatorname{ln}⁡0.72" :db/id #edb/ref 17592186249473} {:answer/id #uuid "f4b4cb88-3f73-51d9-8cf2-e22028d822b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le 12" :db/id #edb/ref 17592186249563} {:answer/id #uuid "f9c7af93-9f26-5f0f-a636-8636e12184c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186249600}] :answer-field/correct {:answer/id #uuid "f9c7af93-9f26-5f0f-a636-8636e12184c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186249600} :answer-field/id #uuid "f1a6f05f-9154-583e-9c93-e25bd8295455" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250091}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8c4c4542-894b-5890-9a4c-cece675d50b3" :question/math-academy-id "q-115230" :question/problem "Solve the inequality $\\frac{1}{2}(0.72)^{3x-7}+2\\le -4.$" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}\\frac{1}{2}(0.72)^{3x-7}+2 & \\le -4 \\\\ \\frac{1}{2}(0.72)^{3x-7} & \\le -6 \\\\ (0.72)^{3x-7} & \\le -12.\\end{aligned}\n$$\n\nBecause a power of a positive number is always greater than $0,$ we must have\n\n$$\n(0.72)^{3x-7}>0\n$$\n\nfor all values of $x.$\n\nTherefore, the inequality $(0.72)^{3x-7}\\le -12$ has no solutions."}] [{:db/id #edb/ref 17592186250370 :knowledge-point/_questions [{:db/id #edb/ref 17592186157432 :knowledge-point/id #uuid "29435c7e-2913-51cb-b1ca-bb88c5109d0a" :knowledge-point/title "Solving an Inequality with Exponential Functions on Both Sides"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e749b95-3859-5caf-bfd8-c834793e8ed4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<5\\operatorname{ln}⁡2+3" :db/id #edb/ref 17592186247694} {:answer/id #uuid "40bebdef-ae8a-5d9e-ac28-6228e738db2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x>\\frac{\\operatorname{ln}⁡5-\\operatorname{ln}⁡2}{2\\operatorname{ln}⁡5}" :db/id #edb/ref 17592186247995} {:answer/id #uuid "49f23bbb-2f76-5966-bbae-3c9d22acc9ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<\\frac{\\operatorname{ln}⁡5-2\\operatorname{ln}⁡2}{\\operatorname{ln}⁡5-\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186248082} {:answer/id #uuid "b99ff983-b6ef-5e58-8aa0-af927de0b3fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x>2\\operatorname{ln}⁡5-3" :db/id #edb/ref 17592186249083} {:answer/id #uuid "f6b0c71b-a6be-59ae-b32b-dde21ce862fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<2\\operatorname{ln}⁡5-3" :db/id #edb/ref 17592186249578}] :answer-field/correct {:answer/id #uuid "49f23bbb-2f76-5966-bbae-3c9d22acc9ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<\\frac{\\operatorname{ln}⁡5-2\\operatorname{ln}⁡2}{\\operatorname{ln}⁡5-\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186248082} :answer-field/id #uuid "7730106b-6087-572a-9b32-b26564608b47" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249875}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1c08f0a1-4fee-59ab-b31f-f6a9816dc7a4" :question/math-academy-id "q-115250" :question/problem "Solve the inequality ${5}^{x-1}<{(\\frac{1}{2})}^{2-x}.$" :question/worked-solution "Taking the natural logarithm of both sides and applying the laws of logarithms, we get the following: \n\n$$\n\\begin{aligned}{5}^{x-1} & <{(\\frac{1}{2})}^{2-x} \\\\ \\operatorname{ln}⁡({5}^{x-1}) & <\\operatorname{ln}⁡[{(\\frac{1}{2})}^{2-x}] \\\\ (x-1)\\operatorname{ln}⁡5 & <(2-x)\\operatorname{ln}⁡(\\frac{1}{2}) \\\\ (x-1)\\operatorname{ln}⁡5 & <(2-x)(\\operatorname{ln}⁡1-\\operatorname{ln}⁡2) \\\\ (x-1)\\operatorname{ln}⁡5 & <(2-x)(0-\\operatorname{ln}⁡2) \\\\ (x-1)\\operatorname{ln}⁡5 & <(x-2)\\operatorname{ln}⁡2 \\\\ x\\operatorname{ln}⁡5-\\operatorname{ln}⁡5 & <x\\operatorname{ln}⁡2-2\\operatorname{ln}⁡2 \\\\ x\\operatorname{ln}⁡5-x\\operatorname{ln}⁡2 & <\\operatorname{ln}⁡5-2\\operatorname{ln}⁡2 \\\\ x(\\operatorname{ln}⁡5-\\operatorname{ln}⁡2) & <\\operatorname{ln}⁡5-2\\operatorname{ln}⁡2 \\\\ x & <\\frac{\\operatorname{ln}⁡5-2\\operatorname{ln}⁡2}{\\operatorname{ln}⁡5-\\operatorname{ln}⁡2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186405009 :knowledge-point/_questions [{:db/id #edb/ref 17592186078568 :knowledge-point/id #uuid "9f542453-9758-55e6-93c6-6bfd2139ec45" :knowledge-point/title "Computing a Tangent Line Approximation and Classifying it as an Underestimate or Overestimate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "827d4a3d-b6ab-53b6-bb12-f25faa0e6566" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)$ is concave down in the neighborhood of $x=\\sqrt{2}$" :db/id #edb/ref 17592186405011} {:answer/id #uuid "383467c9-40c4-5db5-8d12-a8601454a694" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)$ has a local minimum at $x=\\sqrt{2}$" :db/id #edb/ref 17592186405012} {:answer/id #uuid "7e4d8f11-3750-50df-8e99-85f1b881ad96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)$ has a global minimum at $x=\\sqrt{2}$" :db/id #edb/ref 17592186405013} {:answer/id #uuid "9fcfcbd6-75df-589e-b6e8-48082215ad4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)$ is concave up in the neighborhood of $x=\\sqrt{2}$" :db/id #edb/ref 17592186405014} {:answer/id #uuid "ffd3cc61-fa12-54a5-8dfc-015b9b476459" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)$ is a linear function" :db/id #edb/ref 17592186405015}] :answer-field/correct {:answer/id #uuid "827d4a3d-b6ab-53b6-bb12-f25faa0e6566" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)$ is concave down in the neighborhood of $x=\\sqrt{2}$" :db/id #edb/ref 17592186405011} :answer-field/id #uuid "76a1b764-1da7-5a71-9954-47bcc426429c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186405010}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1aea0f50-2894-540a-8561-3e930ff1c7d7" :question/math-academy-id "q-115261" :question/problem "Given that the tangent line approximation to a differentiable function $f(x)$ at every point in an open interval containing $x=\\sqrt{2}$ strictly overestimates the values of the function at every other point in that interval, which of the following must be true?" :question/worked-solution "Since the tangent line approximation of $f(x)$ at every point $a$ in the given neighborhood strictly overestimates the values of the function at every other point, we have\n\n$$\nL_a(x)>f(x)\\quad (x\\ne a),\n$$\n\nthat is, each tangent line $L_a(x)$ lies above the graph of $f(x)$ throughout the neighborhood, with equality only at $x=a.$ A differentiable function whose graph lies below each of its tangent lines on an interval is concave down on that interval.\n\nTherefore, the function must be concave down in the neighborhood of $x=\\sqrt{2}.$"}] [{:db/id #edb/ref 17592186250385 :knowledge-point/_questions [{:db/id #edb/ref 17592186068823 :knowledge-point/id #uuid "3eec195c-6549-5de2-b3f0-0417e5f518e7" :knowledge-point/title "Solving a \"Greater Than\" Inequality Given the Graph of the Corresponding Parabola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10b832b4-be06-5538-a94b-59818cb45058" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7<x<0" :db/id #edb/ref 17592186247571} {:answer/id #uuid "14b511b3-c177-5a70-857b-b7eb87042c71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1<x<7" :db/id #edb/ref 17592186247610} {:answer/id #uuid "9502705b-7b3a-50f1-ba5b-ab33c1d821fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x<-1$ or $x>7$" :db/id #edb/ref 17592186248748} {:answer/id #uuid "aa53455f-6c45-505a-ba7b-d31e4ed8c1fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x<-7$ or $x>1$" :db/id #edb/ref 17592186248940} {:answer/id #uuid "c91c552a-e3ed-5137-931f-0e712dfaf92f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7<x<1" :db/id #edb/ref 17592186249214}] :answer-field/correct {:answer/id #uuid "c91c552a-e3ed-5137-931f-0e712dfaf92f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7<x<1" :db/id #edb/ref 17592186249214} :answer-field/id #uuid "f1df4b5a-1a4a-56c9-9f2c-02ac2d39edd0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250093}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8e9f024f-9fc0-58af-9612-031b9867fc38" :question/math-academy-id "q-115287" :question/problem "![](images/bb/bb57d377a05a6e169c32f2442e02c3926391d62bff7cb24cf3201fb0289b59a4.png)\n\nGiven the graph above, solve the inequality $7-6x-{x}^{2}>0.$" :question/worked-solution "Notice that our inequality\n\n$$\n7-6x-{x}^{2}>0,\n$$\n\nis a \"*greater than*\" inequality. Therefore, we need to find the values of $x$ for which the parabola  \n\n$$\ny=7-6x-{x}^{2}\n$$\n\nis *above* the $x$-axis. We mark these values of $x$ in blue in the diagram below.\n\n![](images/8e/8e12975187d46b6dc408e21234309e33654a24503db65ed075e32990de8ed654.png)\n\nSo, the solution to the inequality is $-7<x<1.$"}] [{:db/id #edb/ref 17592186250390 :knowledge-point/_questions [{:db/id #edb/ref 17592186087834 :knowledge-point/id #uuid "a5028940-be34-56b7-8947-6129252f06a7" :knowledge-point/title "Determining the Center and Lengths of the Major and Minor Axes Given the Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dc8d6fa-6312-5332-b890-b96f8ba86d34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,2)" :db/id #edb/ref 17592186247690} {:answer/id #uuid "2f504533-dba5-5a4f-8e8e-d571f324bc13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186247849} {:answer/id #uuid "5337ac8c-87dc-5ed1-9732-75915073f600" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-3)" :db/id #edb/ref 17592186248174} {:answer/id #uuid "6a7cb839-e5f3-5581-9fe8-bb0945fd74b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,3)" :db/id #edb/ref 17592186248373} {:answer/id #uuid "7f7020d4-fe3f-50f8-bd90-be3c6e4d9e72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,3)" :db/id #edb/ref 17592186248543}] :answer-field/correct {:answer/id #uuid "7f7020d4-fe3f-50f8-bd90-be3c6e4d9e72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,3)" :db/id #edb/ref 17592186248543} :answer-field/id #uuid "54c42180-98c9-5c11-b93b-3fa148651bca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249826}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1dd86485-ed9c-5475-8932-90607bb9958e" :question/math-academy-id "q-115308" :question/problem "What is the center of the ellipse $\\frac{(x+2)^{2}}{3}+\\frac{(y-3)^{2}}{9}=1?$" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have $h=-2$ and $k=3,$ so the center is located at $(-2,3).$"}] [{:db/id #edb/ref 17592186399871 :knowledge-point/_questions [{:db/id #edb/ref 17592186087834 :knowledge-point/id #uuid "a5028940-be34-56b7-8947-6129252f06a7" :knowledge-point/title "Determining the Center and Lengths of the Major and Minor Axes Given the Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53855cff-bcca-509b-8df4-37d79e809e7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$25$ and $6$" :db/id #edb/ref 17592186399873} {:answer/id #uuid "17302a0c-db71-5e47-9f9c-7d55635451b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ and $2$" :db/id #edb/ref 17592186399874} {:answer/id #uuid "a6aed6ae-4085-506e-b702-8b9d95570e9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ and $2\\sqrt{6}$" :db/id #edb/ref 17592186399875} {:answer/id #uuid "f17c689d-e9fa-5fd9-b2ff-5ea750ce8ac4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ and $\\sqrt{6}$" :db/id #edb/ref 17592186399876} {:answer/id #uuid "d786fe68-0f02-5397-bafb-ab8b7df3332f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$12.5$ and $3$" :db/id #edb/ref 17592186399877}] :answer-field/correct {:answer/id #uuid "a6aed6ae-4085-506e-b702-8b9d95570e9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ and $2\\sqrt{6}$" :db/id #edb/ref 17592186399875} :answer-field/id #uuid "632f4b79-0b5d-599f-9a9d-155f44ffca58" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399872}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6821b43a-88ac-5b4b-9151-2f35f973a4c0" :question/math-academy-id "q-115313" :question/problem "For the ellipse $\\frac{(x+5)^{2}}{25}+\\frac{(y-2)^{2}}{6}=1$, find the lengths of its major and minor axes." :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have $h=-5$ and $k=2,$ so the center is located at $(-5,2).$\n\nIn the given equation, we also have ${a}^{2}=25$ and ${b}^{2}=6.$\n\n- Since ${a}^{2}=25,$ the length of the horizontal radius must be $a=\\sqrt{25}=5.$\n\n- Since ${b}^{2}=6,$ the length of the vertical radius must be $b=\\sqrt{6}.$\n\nSo the semi-major axis has length $a=5,$ and the semi-minor axis has length $b=\\sqrt{6}.$\n\nTherefore, the major axis has length $2a=2\\cdot 5=10,$ and the minor axis has length $2b=2\\cdot \\sqrt{6}=2\\sqrt{6}.$"}] [{:db/id #edb/ref 17592186399878 :knowledge-point/_questions [{:db/id #edb/ref 17592186078568 :knowledge-point/id #uuid "9f542453-9758-55e6-93c6-6bfd2139ec45" :knowledge-point/title "Computing a Tangent Line Approximation and Classifying it as an Underestimate or Overestimate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d0f6466d-f440-58c1-8723-cde1e85101c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(\\sqrt{2})≈5,$ an underestimate" :db/id #edb/ref 17592186399880} {:answer/id #uuid "1906a013-62f9-568e-95ae-98c68b274de9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(\\sqrt{2})≈6,$ an underestimate" :db/id #edb/ref 17592186399881} {:answer/id #uuid "261b2021-339d-51c1-a9b8-1c77073b9824" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(\\sqrt{2})≈6,$ an overestimate" :db/id #edb/ref 17592186399882} {:answer/id #uuid "d631bbed-d22a-5f68-8054-c6e4993d2296" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(\\sqrt{2})≈\\frac{1}{2\\sqrt{2}},$ an overestimate" :db/id #edb/ref 17592186399883} {:answer/id #uuid "87b365d2-efb1-55b5-ba28-a027ed309d15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(\\sqrt{2})≈5,$ an overestimate" :db/id #edb/ref 17592186399884}] :answer-field/correct {:answer/id #uuid "261b2021-339d-51c1-a9b8-1c77073b9824" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(\\sqrt{2})≈6,$ an overestimate" :db/id #edb/ref 17592186399882} :answer-field/id #uuid "4547a518-52cd-55fa-a5a7-64752ebe189c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399879}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a7b7e632-32b9-5dd9-98c7-3b49b8d1e749" :question/math-academy-id "q-115348" :question/problem "The graph of the function $y=f(x)$ passes through $(0,5)$ and is concave down on the interval $(-\\pi ,\\pi ).$ If ${f}^{′}(0)=\\frac{1}{\\sqrt{2}},$ estimate the value of $f(\\sqrt{2})$ using the tangent line approximation of $f(x)$ at $x=0$ and determine whether the approximation is an underestimate or overestimate." :question/worked-solution "The tangent line approximation of $f(x)$ at the point $a=0$ is \n\n$$\n\\begin{aligned}L(x) & =f(a)+{f}^{′}(a)(x-a) \\\\  & =f(0)+{f}^{′}(0)(x-0).\\end{aligned}\n$$\n\nThe function passes through the point $(0,5),$ so we have $f(0)=5.$ Also, we're told that ${f}^{′}(0)=\\frac{1}{\\sqrt{2}},$ so we get\n\n$$\n\\begin{aligned}L(x) & =5+\\frac{1}{\\sqrt{2}}(x-0) \\\\  & =5+\\frac{x}{\\sqrt{2}}.\\end{aligned}\n$$\n\nWe can approximate $f(\\sqrt{2})$ by evaluating the tangent line approximation at $x=\\sqrt{2}.$ We get\n\n$$\n\\begin{aligned}f(\\sqrt{2}) & ≈L(\\sqrt{2}) \\\\  & =5+\\frac{\\sqrt{2}}{\\sqrt{2}} \\\\  & =5+1 \\\\  & =6.\\end{aligned}\n$$\n\nFinally, since the function is concave down on the interval $(-\\pi ,\\pi ),$ the linear approximation $L(x)$ is above the graph near $x=0,$ and therefore we have an overestimate."}] [{:db/id #edb/ref 17592186250399 :knowledge-point/_questions [{:db/id #edb/ref 17592186083202 :knowledge-point/id #uuid "cf1d89ed-0d2a-5759-9e6e-354957f7dabc" :knowledge-point/title "Evaluating an Improper Integral of the Second Kind"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "104a37e8-f6cc-5ec9-a48f-51d64001ade6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186247566} {:answer/id #uuid "3c3b391a-eaaf-5545-921e-ba51e2369aa0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The integral is divergent" :db/id #edb/ref 17592186247957} {:answer/id #uuid "6e7c2c19-862f-595f-8097-e427b65885c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186248403} {:answer/id #uuid "eed826b1-26bf-5b30-8634-29ffd3b2cf85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186249520} {:answer/id #uuid "fcc8360c-bc00-5182-82d5-a3b8baeeed0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186249633}] :answer-field/correct {:answer/id #uuid "3c3b391a-eaaf-5545-921e-ba51e2369aa0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The integral is divergent" :db/id #edb/ref 17592186247957} :answer-field/id #uuid "3f44352e-bdd6-5788-932e-ae381b870850" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249783}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3a17cc8d-0938-5ad1-ae94-e242754caed6" :question/math-academy-id "q-115353" :question/problem "${\\int }_{2/3}^{2}\\frac{3}{(3x-2)^{5}}\\,\\text{d}x=$" :question/worked-solution "First, let's rewrite the integral using a substitution. Let $u=3x-2.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}u=3\\,\\text{d}x.\n$$\n\nWe use the table below to change the limits:\n\n| $x$ | $\\frac{2}{3}$ | $2$ |\n| --- | --- | --- |\n| $u$ | $0$ | $4$ |\n\nCarrying out the change of variable, we have\n\n$$\n\\begin{aligned}{\\int }_{2/3}^{2}\\frac{3\\,\\text{d}x}{(3x-2)^{5}} & ={\\int }_{0}^{4}\\frac{\\text{d}u}{{u}^{5}}.\\end{aligned}\n$$\n\nThis is an improper integral of the second kind because the function under the integral is unbounded at the *lower* limit of integration.\n\n$$\nf(u)=\\frac{1}{{u}^{5}}\\to \\infty \\,\\text{ as }\\,u\\to {0}^{+}.\n$$\n\nNonetheless, it is possible to calculate the integral by setting the *lower* bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to {0}^{+}.$\n\n$$\n\\begin{aligned}{\\int }_{0}^{4}\\frac{\\text{d}u}{{u}^{5}} & ={lim}_{a\\to {0}^{+}}{\\int }_{a}^{4}\\frac{\\text{d}u}{{u}^{5}} \\\\  & ={lim}_{a\\to {0}^{+}}{\\int }_{a}^{4}{u}^{-5}\\,\\text{d}u \\\\  & ={lim}_{a\\to {0}^{+}}{(-\\frac{1}{4}\\,{u}^{-4})|}_{a}^{4} \\\\  & =-\\frac{1}{4}\\cdot {lim}_{a\\to {0}^{+}}{\\frac{1}{{u}^{4}}|}_{a}^{4} \\\\  & =-\\frac{1}{4}\\cdot {lim}_{a\\to {0}^{+}}[\\frac{1}{256}-\\frac{1}{{a}^{4}}] \\\\  & =\\infty \\end{aligned}\n$$\n\nTherefore, we conclude that the integral is divergent."}] [{:db/id #edb/ref 17592186250400 :knowledge-point/_questions [{:db/id #edb/ref 17592186100994 :knowledge-point/id #uuid "8e9df1ae-8176-555b-987d-94773c27d435" :knowledge-point/title "Finding the Radius of a Circle on the Coordinate Plane Using the Distance Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2172b8f7-3593-5571-b2f3-7d7267020abd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186247720} {:answer/id #uuid "39cf299f-3302-568e-80c6-f68f90479350" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186247934} {:answer/id #uuid "5fb4096d-f189-5fca-82c4-8803e1e12ee4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186248291} {:answer/id #uuid "6c0f207e-3753-5536-ba31-32a146709a0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186248381} {:answer/id #uuid "dca5ff4b-c86a-5b8a-b547-f8671207d2f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186249377}] :answer-field/correct {:answer/id #uuid "6c0f207e-3753-5536-ba31-32a146709a0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186248381} :answer-field/id #uuid "cffa1467-5032-5c7c-8355-c1c0efa2e0bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250030}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6fa395af-9563-5dd6-b788-298fc3edabb7" :question/math-academy-id "q-115360" :question/problem "The points $A$ and $B$ have coordinates $(-3,-4)$ and $(0,-4)$, respectively, and the segment $\\overset{―}{AB}$ is a diameter of a circle. Find the radius of the circle." :question/worked-solution "The diameter can be calculated using the distance formula: \n\n$$\n\\begin{aligned}d & =\\sqrt{{({x}_{1}-{x}_{2})}^{2}+{({y}_{1}-{y}_{2})}^{2}} \\\\  & =\\sqrt{(-3-0)^{2}+(-4-(-4))^{2}} \\\\  & =\\sqrt{(-3)^{2}+(0)^{2}} \\\\  & =\\sqrt{9+0} \\\\  & =\\sqrt{9} \\\\  & =3\\end{aligned}\n$$\n\nThe radius is half the diameter:\n\n$$\nr=\\frac{d}{2}=\\frac{3}{2}\n$$"}] [{:db/id #edb/ref 17592186399885 :knowledge-point/_questions [{:db/id #edb/ref 17592186100995 :knowledge-point/id #uuid "52384502-66c5-5089-b38f-d46b94877430" :knowledge-point/title "Determining the Center and Radius of a Circle on the Coordinate Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8fa6bba-8366-50e3-bd6e-0487665ca2c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(0,3)$ and the radius is $2$" :db/id #edb/ref 17592186399887} {:answer/id #uuid "0fba675a-9578-5d7e-86a6-668cee3df4ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(0,4)$ and the radius is $1$" :db/id #edb/ref 17592186399888} {:answer/id #uuid "73d0aee8-773e-58fb-89a9-36098d20a922" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(0,4)$ and the radius is $2$" :db/id #edb/ref 17592186399889} {:answer/id #uuid "d14d98e0-0f4f-5aa7-b716-c80926e97a57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(0,3)$ and the radius is $1$" :db/id #edb/ref 17592186399890} {:answer/id #uuid "4de2cf95-13f1-5b1b-8916-4cd2aebe378f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(0,3)$ and the radius is $\\sqrt{2}$" :db/id #edb/ref 17592186399891}] :answer-field/correct {:answer/id #uuid "4de2cf95-13f1-5b1b-8916-4cd2aebe378f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(0,3)$ and the radius is $\\sqrt{2}$" :db/id #edb/ref 17592186399891} :answer-field/id #uuid "6a898ac5-9ac8-57ea-9a3a-e0a38e6b53ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399886}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a02e3599-0d24-591c-985f-c45e9f652ee9" :question/math-academy-id "q-115364" :question/problem "![](images/3a/3af3101fd7a103e8382755177ca1ebab9bc1cdf48aebd34af8ac7cc92991387c.png)\n\nGiven that the points $(-1,2)$ and $(1,4)$ lie on a diameter of a circle, what are the center and radius of the circle?" :question/worked-solution "The center of the circle is located at the midpoint of the diameter. So, we can calculate the coordinates of the center using the midpoint formula:\n\n$$\n\\begin{aligned}(h,k) & =(\\frac{{x}_{1}+{x}_{2}}{2},\\frac{{y}_{1}+{y}_{2}}{2}) \\\\  & =(\\frac{-1+1}{2},\\frac{2+4}{2}) \\\\  & =(\\frac{0}{2},\\frac{6}{2}) \\\\  & =(0,3)\\end{aligned}\n$$\n\nThe radius can be found by calculating the distance between the center $(0,3)$ and a point on the circle, such as $(-1,2):$\n\n$$\n\\begin{aligned}r & =\\sqrt{{({x}_{1}-{x}_{2})}^{2}+{({y}_{1}-{y}_{2})}^{2}} \\\\  & =\\sqrt{{(-1-0)}^{2}+{(2-3)}^{2}} \\\\  & =\\sqrt{(-1)^{2}+(-1)^{2}} \\\\  & =\\sqrt{1+1} \\\\  & =\\sqrt{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250403 :knowledge-point/_questions [{:db/id #edb/ref 17592186157327 :knowledge-point/id #uuid "f15241dd-898f-5f1c-9c1c-469a4af1fb80" :knowledge-point/title "Solving a Factored Inequality Involving an Exponential Function and a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "739fbca6-c5ac-5e11-a97f-2eba4b298bdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x>0" :db/id #edb/ref 17592186248437} {:answer/id #uuid "8464474a-8bd6-5f2d-83de-6741da424564" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2<x<2" :db/id #edb/ref 17592186248597} {:answer/id #uuid "86c8128d-5983-52f9-a186-7392ed567cbf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186248630} {:answer/id #uuid "aff3a020-a81c-516a-8df3-f8954a7a30f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<-2" :db/id #edb/ref 17592186249005} {:answer/id #uuid "ba139211-d064-5344-9759-1452980dee90" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "all real numbers" :db/id #edb/ref 17592186249087}] :answer-field/correct {:answer/id #uuid "8464474a-8bd6-5f2d-83de-6741da424564" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2<x<2" :db/id #edb/ref 17592186248597} :answer-field/id #uuid "276cc39b-c80f-50e7-80a9-b6d1136e5921" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249745}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8e9422d6-b5d0-523a-afb2-aabcc6793fd0" :question/math-academy-id "q-115410" :question/problem "Solve the inequality $\\frac{({x}^{2}-4)^{3}}{(0.6)^{3x-2}}<0.$" :question/worked-solution "When we have an inequality involving an exponential function with a positive base, we're allowed to multiply or divide both sides by the exponential function.\n\nMultiplying both sides of the given inequality by $(0.6)^{3x-2},$ we get\n\n$$\n\\begin{aligned}\\frac{({x}^{2}-4)^{3}}{(0.6)^{3x-2}} & <0 \\\\ (0.6)^{3x-2}\\cdot \\frac{({x}^{2}-4)^{3}}{(0.6)^{3x-2}} & <(0.6)^{3x-2}\\cdot 0 \\\\ ({x}^{2}-4)^{3} & <0.\\end{aligned}\n$$\n\nNow, we can solve the inequality using familiar methods:\n\n$$\n\\begin{aligned}\\sqrt[3]{({x}^{2}-4)^{3}} & <\\sqrt[3]{0} \\\\ {x}^{2}-4 & <0 \\\\ {x}^{2} & <4 \\\\ \\sqrt{{x}^{2}} & <\\sqrt{4} \\\\ |x| & <2\\end{aligned}\n$$\n\nTherefore, the solution to the inequality is $-2<x<2.$"}] [{:db/id #edb/ref 17592186250406 :knowledge-point/_questions [{:db/id #edb/ref 17592186054753 :knowledge-point/id #uuid "7de7d614-76c9-5133-a4df-95f079467cb9" :knowledge-point/title "Solving a Quadratic Inequality With No Constant Term Using the Sign Table Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "826552d3-c4e0-538c-9196-4afb18110140" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (0,13)" :db/id #edb/ref 17592186248579} {:answer/id #uuid "9bf08c39-e90f-5ba4-9229-d2ffff374c6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-13)\\cup (0,\\infty )" :db/id #edb/ref 17592186248811} {:answer/id #uuid "9fb2522e-32d2-56e6-ac37-54a4312dd677" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,0)\\cup (13,\\infty )" :db/id #edb/ref 17592186248847} {:answer/id #uuid "af81a493-1449-5b36-ab97-412b7aebe26d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-13)\\cup (13,\\infty )" :db/id #edb/ref 17592186248998} {:answer/id #uuid "ce1caebc-93ec-52f4-b0af-a5dbfeb7b5b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-13,0)" :db/id #edb/ref 17592186249251}] :answer-field/correct {:answer/id #uuid "ce1caebc-93ec-52f4-b0af-a5dbfeb7b5b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-13,0)" :db/id #edb/ref 17592186249251} :answer-field/id #uuid "faa7acea-63e1-5f4b-ad99-c211d52b1202" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250113}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f2bb17ed-6922-578d-aad8-d1768d7a7b6f" :question/math-academy-id "q-115426" :question/problem "For which values of $x$ is ${x}^{2}+13x<0?$" :question/worked-solution "First, let's factor the left-hand side of the inequality:\n\n$$\n\\begin{aligned}{x}^{2}+13x & <0 \\\\ x(x+13) & <0\\end{aligned}\n$$\n\nNext, we find the roots of the corresponding equation $x(x+13)=0.$ The roots are $x=-13$ and $x=0,$ and they split the number line into the $3$ intervals $(-\\infty ,-13),$ $(-13,0),$ and $(0,\\infty ).$\n\nNow, we construct a sign table with the list of the intervals on the top and the list of factors on the left. Filling in the sign table using the usual method, we get the following result:\n\n|  | $(-\\infty ,-13)$ | $(-13,0)$ | $(0,\\infty )$ |\n| --- | --- | --- | --- |\n| $x+13$ | $-$ | $+$ | $+$ |\n| $x$ | $-$ | $-$ | $+$ |\n| $x(x+13)$ | $(-)\\cdot (-)=+$ | $(+)\\cdot (-)=-$ | $(+)\\cdot (+)=+$ |\n\nFinally, to solve the quadratic inequality $x(x+13)<0,$ we look at the bottom row to find out where the expression $x(x+13)$ is negative.\n\nWe see that the expression is negative on the interval $(-13,0).$ \n\nTherefore, we conclude that ${x}^{2}+13x<0$ for all $x\\in (-13,0).$"}] [{:db/id #edb/ref 17592186250407 :knowledge-point/_questions [{:db/id #edb/ref 17592186157328 :knowledge-point/id #uuid "479e5736-efe1-5e94-929f-3dcd6d13a733" :knowledge-point/title "Solving an Inequality Involving Exponential Functions with the Same Exponents and a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52b71b32-6829-5f59-8006-3f8137b70103" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge -2" :db/id #edb/ref 17592186248168} {:answer/id #uuid "9fdb5b7d-e273-5971-bba0-42626540ee95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge \\frac{7}{2}" :db/id #edb/ref 17592186248848} {:answer/id #uuid "bf8e8e8c-1bf9-5cb4-8480-9d8297972ac3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge \\frac{5}{4}" :db/id #edb/ref 17592186249125} {:answer/id #uuid "de97ae07-1bb8-5333-8b3a-2d918f3c578b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge -\\frac{6}{5}" :db/id #edb/ref 17592186249397} {:answer/id #uuid "e9aa5491-e4e7-5a0f-8697-e8db3ab58d88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 7" :db/id #edb/ref 17592186249487}] :answer-field/correct {:answer/id #uuid "de97ae07-1bb8-5333-8b3a-2d918f3c578b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge -\\frac{6}{5}" :db/id #edb/ref 17592186249397} :answer-field/id #uuid "278f2265-95b5-5d8f-a6d8-5dae9da20709" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249746}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bffeaf0e-fd8d-5920-b105-3b02ab9ca007" :question/math-academy-id "q-115429" :question/problem "Solve the inequality $5x\\cdot {7}^{2x+3}+4\\cdot {7}^{2x+3}\\ge -2\\cdot {7}^{2x+3}.$" :question/worked-solution "First, we move all the terms to the left side of the inequality and factor:\n\n$$\n\\begin{aligned}5x\\cdot {7}^{2x+3}+4\\cdot {7}^{2x+3} & \\ge -2\\cdot {7}^{2x+3} \\\\ 5x\\cdot {7}^{2x+3}+4\\cdot {7}^{2x+3}+2\\cdot {7}^{2x+3} & \\ge 0 \\\\ (5x+4+2){7}^{2x+3} & \\ge 0 \\\\ (5x+6){7}^{2x+3} & \\ge 0\\end{aligned}\n$$\n\nNow, we divide both sides by ${7}^{2x+3}$ and solve the resulting inequality using familiar techniques:\n\n$$\n\\begin{aligned}5x+6 & \\ge 0 \\\\ 5x & \\ge -6 \\\\ x & \\ge -\\frac{6}{5}\\end{aligned}\n$$\n\nThe solution to the inequality above is $x\\ge -\\frac{6}{5}.$"}] [{:db/id #edb/ref 17592186250409 :knowledge-point/_questions [{:db/id #edb/ref 17592186157328 :knowledge-point/id #uuid "479e5736-efe1-5e94-929f-3dcd6d13a733" :knowledge-point/title "Solving an Inequality Involving Exponential Functions with the Same Exponents and a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "851e4134-35eb-5aba-af36-3a20acece3c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1<x<3" :db/id #edb/ref 17592186248607} {:answer/id #uuid "bbdeea24-8996-5a8a-9621-e6e5c2208625" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<\\frac{3}{5}" :db/id #edb/ref 17592186249101} {:answer/id #uuid "e01adf57-6985-572b-aada-39a2aa33bbcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<3" :db/id #edb/ref 17592186249408} {:answer/id #uuid "e9024c6a-ad8d-5098-b257-1d46c71f544f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<x<\\frac{3}{5}" :db/id #edb/ref 17592186249483} {:answer/id #uuid "ee39fa29-afdd-55b1-9376-d893ed61e355" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<\\frac{5}{8}" :db/id #edb/ref 17592186249514}] :answer-field/correct {:answer/id #uuid "e01adf57-6985-572b-aada-39a2aa33bbcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<3" :db/id #edb/ref 17592186249408} :answer-field/id #uuid "8ed08cce-32e9-540d-b350-8dcc26fcf558" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249921}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "acf6ef6d-0331-57a6-8919-a62e7cb25503" :question/math-academy-id "q-115431" :question/problem "Solve the inequality $3x\\cdot {5}^{x+6}-{5}^{x+6}<8\\cdot {5}^{x+6}.$" :question/worked-solution "First, we move all the terms to the left side of the inequality and factor:\n\n$$\n\\begin{aligned}3x\\cdot {5}^{x+6}-{5}^{x+6} & <8\\cdot {5}^{x+6} \\\\ 3x\\cdot {5}^{x+6}-{5}^{x+6}-8\\cdot {5}^{x+6} & <0 \\\\ (3x-1-8){5}^{x+6} & <0 \\\\ (3x-9){5}^{x+6} & <0\\end{aligned}\n$$\n\nNow, we divide both sides by ${5}^{x+6}$ and solve the resulting inequality using familiar techniques:\n\n$$\n\\begin{aligned}3x-9 & <0 \\\\ 3x & <9 \\\\ x & <3\\end{aligned}\n$$\n\nThe solution to the inequality above is $x<3.$"}] [{:db/id #edb/ref 17592186250410 :knowledge-point/_questions [{:db/id #edb/ref 17592186096693 :knowledge-point/id #uuid "281514e9-6e16-5b21-ba4e-503991d811c2" :knowledge-point/title "Determining the Equation of a Parabola Passing Through a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80063ee4-5a2e-54d5-a7c0-7f53301ee070" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=\\frac{1}{4}y" :db/id #edb/ref 17592186248547} {:answer/id #uuid "942c6f19-e871-5efb-bc84-cc274cf8d7e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=y" :db/id #edb/ref 17592186248741} {:answer/id #uuid "aa477baf-669c-5ca1-9535-44663ae87ada" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=16y" :db/id #edb/ref 17592186248939} {:answer/id #uuid "c1d8ef81-1c40-56e6-b62a-55e8bb45c5f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=4y" :db/id #edb/ref 17592186249148} {:answer/id #uuid "f0990477-9c09-5cd5-b650-146fa848ec1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=-y" :db/id #edb/ref 17592186249537}] :answer-field/correct {:answer/id #uuid "c1d8ef81-1c40-56e6-b62a-55e8bb45c5f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=4y" :db/id #edb/ref 17592186249148} :answer-field/id #uuid "0fc0ca73-8e47-548c-a716-86b46758af6f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249695}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "88252d6a-eb99-5de5-8ab4-de1f72848e55" :question/math-academy-id "q-115432" :question/problem "Find the equation of the upward-opening parabola that has its vertex at $(0,0)$ and which passes through the point $(2,1).$" :question/worked-solution "We know that for any upward or downward-opening parabola whose vertex is $(0,0),$ the general standard equation is given by\n\n$$\n{x}^{2}=4py\n$$\n\nwhere $p$ is a constant.\n\nWe're told that the given parabola passes through the point $(2,1),$ so we can substitute $x=2$ and $y=1$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ {2}^{2} & =4p(1) \\\\ 4 & =4p \\\\ p & =1.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ {x}^{2} & =4(1)y \\\\ {x}^{2} & =4y.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250411 :knowledge-point/_questions [{:db/id #edb/ref 17592186096693 :knowledge-point/id #uuid "281514e9-6e16-5b21-ba4e-503991d811c2" :knowledge-point/title "Determining the Equation of a Parabola Passing Through a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "094e6092-339d-5805-b65a-0ba9ea32fcb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=-\\frac{4}{5}y" :db/id #edb/ref 17592186247504} {:answer/id #uuid "14563ff8-ab85-58f1-81f8-f36ec51e3961" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=\\frac{25}{8}y" :db/id #edb/ref 17592186247607} {:answer/id #uuid "469c754e-d524-520c-ab78-58d1d9ef15b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=\\frac{5}{2}y" :db/id #edb/ref 17592186248054} {:answer/id #uuid "47e57771-259b-5a0d-b6b3-ea895b0566e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=\\frac{25}{2}y" :db/id #edb/ref 17592186248067} {:answer/id #uuid "d4402dbe-cb92-590e-ba46-520899873150" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=-\\frac{1}{5}y" :db/id #edb/ref 17592186249304}] :answer-field/correct {:answer/id #uuid "47e57771-259b-5a0d-b6b3-ea895b0566e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=\\frac{25}{2}y" :db/id #edb/ref 17592186248067} :answer-field/id #uuid "4d41aa6b-e2d8-5876-b623-7e5b4a1547b0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249812}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b0c85b4b-81a1-52fc-99a2-07f13ad067d3" :question/math-academy-id "q-115434" :question/problem "Find the equation of the upward-opening parabola that has its vertex at $(0,0)$ and which passes through the point $(-5,2).$" :question/worked-solution "We know that for any upward or downward-opening parabola whose vertex is $(0,0),$ the general standard equation is given by\n\n$$\n{x}^{2}=4py\n$$\n\nwhere $p$ is a constant.\n\nWe're told that the given parabola passes through the point $(-5,2),$ so we can substitute $x=-5$ and $y=2$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ (-5)^{2} & =4p(2) \\\\ 25 & =8p \\\\ p & =\\frac{25}{8}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ {x}^{2} & =4(\\frac{25}{8})y \\\\ {x}^{2} & =\\frac{25}{2}y.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250415 :knowledge-point/_questions [{:db/id #edb/ref 17592186096694 :knowledge-point/id #uuid "a991a3b1-6de7-5978-9dd6-cb9eb3f183a6" :knowledge-point/title "Determining the Equation of a Parabola With Non-Origin Vertex Given its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c5ff86e-cbd2-5244-bd7e-fa7501ce1356" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-2)^{2}=2(y-1)" :db/id #edb/ref 17592186247533} {:answer/id #uuid "6d01c7a7-ed12-581a-857f-30f616b9ef99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-2)^{2}=\\frac{1}{2}(y-1)" :db/id #edb/ref 17592186248388} {:answer/id #uuid "711453e3-73f9-5722-820f-ac643ba5fcb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+2)^{2}=\\frac{1}{2}(y+1)" :db/id #edb/ref 17592186248413} {:answer/id #uuid "8d999a07-30ce-573b-8c2d-fa8220991104" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-2)^{2}=4(y-1)" :db/id #edb/ref 17592186248686} {:answer/id #uuid "d6aed572-9d95-5182-8bd1-9ea1faa87eca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+2)^{2}=(y-1)" :db/id #edb/ref 17592186249322}] :answer-field/correct {:answer/id #uuid "0c5ff86e-cbd2-5244-bd7e-fa7501ce1356" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-2)^{2}=2(y-1)" :db/id #edb/ref 17592186247533} :answer-field/id #uuid "242c488e-b1d2-5f9b-924c-0c83035c9cef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249734}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "af2d74a7-36e3-5f6f-95f7-10b5d7e5decf" :question/math-academy-id "q-115451" :question/problem "![](images/97/970db64a0ddd325993323511ad4ae754ce64f64d591877bfa0ac908874e2393f.png)\n\nWhat is the equation of the parabola shown above?" :question/worked-solution "We know that for any upward or downward-opening parabola with its vertex at $(h,k),$ the general standard equation is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nHere, the vertex has coordinates $(h,k)=(2,1).$ Substituting these into the general standard equation, we get\n\n$$\n(x-2)^{2}=4p(y-1).\n$$\n\nWe are left to find the value of $p.$ We know that the given parabola also passes through the point $(4,3),$ so we can substitute $x=4$ and $y=3$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}(x-2)^{2} & =4p(y-1) \\\\ (4-2)^{2} & =4p(3-1) \\\\ 4 & =8p \\\\ p & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}(x-2)^{2} & =4p(y-1) \\\\ (x-2)^{2} & =4(\\frac{1}{2})(y-1) \\\\ (x-2)^{2} & =2(y-1).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250419 :knowledge-point/_questions [{:db/id #edb/ref 17592186096694 :knowledge-point/id #uuid "a991a3b1-6de7-5978-9dd6-cb9eb3f183a6" :knowledge-point/title "Determining the Equation of a Parabola With Non-Origin Vertex Given its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "448f46ef-d3ea-5129-b534-69738ce2bf22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+2)^{2}=12(y+1)" :db/id #edb/ref 17592186248036} {:answer/id #uuid "61d14d47-1b22-5269-bf65-c45079b61a8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-2)^{2}=-12(y-1)" :db/id #edb/ref 17592186248307} {:answer/id #uuid "96e2c46f-fcee-5729-87c3-3a89d53c7346" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-2)^{2}=-3(y-1)" :db/id #edb/ref 17592186248769} {:answer/id #uuid "c2981009-de70-58f9-bf1b-475e3952da5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-2)^{2}=-\\frac{4}{5}(y-1)" :db/id #edb/ref 17592186249154} {:answer/id #uuid "d1808623-7ad0-5bda-a910-99c16db5520e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-2)^{2}=-\\frac{16}{5}(y-1)" :db/id #edb/ref 17592186249281}] :answer-field/correct {:answer/id #uuid "61d14d47-1b22-5269-bf65-c45079b61a8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-2)^{2}=-12(y-1)" :db/id #edb/ref 17592186248307} :answer-field/id #uuid "7857cb4e-c7be-5b90-8d5b-a7a24b7b056d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249876}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d3ec34c5-8643-5bc8-b96a-2dfe405443a2" :question/math-academy-id "q-115502" :question/problem "![](images/c6/c6b336b55e48a68dcad83efc4a8acd7659225b8f8e29faf8ea176c2cead29901.png)\n\nWhat is the equation of the parabola shown above?" :question/worked-solution "We know that for any upward or downward-opening parabola with its vertex at $(h,k),$ the general standard equation is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nHere, the vertex has coordinates $(h,k)=(2,1).$ Substituting these into the general standard equation, we get\n\n$$\n(x-2)^{2}=4p(y-1).\n$$\n\nWe are left to find the value of $p.$ We know that the given parabola also passes through the point $(-4,-2),$ so we can substitute $x=-4$ and $y=-2$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}(x-2)^{2} & =4p(y-1) \\\\ (-4-2)^{2} & =4p(-2-1) \\\\ 36 & =-12p \\\\ p & =-3.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}(x-2)^{2} & =4p(y-1) \\\\ (x-2)^{2} & =4(-3)(y-1) \\\\ (x-2)^{2} & =-12(y-1).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250422 :knowledge-point/_questions [{:db/id #edb/ref 17592186096695 :knowledge-point/id #uuid "29e2083d-fe76-5a35-9c3a-7e6ad19ff968" :knowledge-point/title "Determining the Equation of a Parabola With Non-Origin Vertex Passing Through a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00a986a9-dc99-5796-9957-e44b0b8d9b54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-4)^{2}=-y" :db/id #edb/ref 17592186247416} {:answer/id #uuid "3af46962-42bf-52d0-9044-0ca1c67c1f83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-4)^{2}=-9y" :db/id #edb/ref 17592186247946} {:answer/id #uuid "40f40afb-bd2f-53ad-bfee-4cedf94cb572" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=-4(y-4)" :db/id #edb/ref 17592186248000} {:answer/id #uuid "dd8a6a65-91c8-5dc8-8832-b63911bb283a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-4)^{2}=-\\frac{9}{4}y" :db/id #edb/ref 17592186249388} {:answer/id #uuid "ee0b7d8e-f5b6-5077-a852-7535675aef4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+4)^{2}=-\\frac{9}{16}y" :db/id #edb/ref 17592186249511}] :answer-field/correct {:answer/id #uuid "dd8a6a65-91c8-5dc8-8832-b63911bb283a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-4)^{2}=-\\frac{9}{4}y" :db/id #edb/ref 17592186249388} :answer-field/id #uuid "a77272b0-ce4e-560d-9231-c7789014a60c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249963}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "55c7e4a7-0bdd-5125-954e-1f3a2bdbf235" :question/math-academy-id "q-115513" :question/problem "Find the equation of the downward-opening parabola that has its vertex at $(4,0)$ and which passes through the point $(1,-4).$" :question/worked-solution "For any upward or downward-opening parabola with its vertex at $(h,k),$ the general standard equation is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nHere, the vertex has coordinates $(h,k)=(4,0).$ Substituting these into the general standard equation, we get\n\n$$\n\\begin{aligned}(x-4)^{2} & =4py.\\end{aligned}\n$$\n\nWe are left to find the value of $p.$ We know that the given parabola also passes through the point $(1,-4),$ so we can substitute $x=1$ and $y=-4$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}(x-4)^{2} & =4py \\\\ (1-4)^{2} & =4p(-4) \\\\ 9 & =-16p \\\\ p & =-\\frac{9}{16}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}(x-4)^{2} & =4py \\\\ (x-4)^{2} & =4(-\\frac{9}{16})y \\\\ (x-4)^{2} & =-\\frac{9}{4}y.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250428 :knowledge-point/_questions [{:db/id #edb/ref 17592186068690 :knowledge-point/id #uuid "9f29435f-b112-5999-b0ca-9003d9e622e1" :knowledge-point/title "Calculating an Indeterminate Limit of the Form Infinity Divided by Infinity Using L'Hopital's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b693811-a16b-53ed-9611-68583bdf136e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186247672} {:answer/id #uuid "2d4b941c-69b2-577b-a723-cb390aecaad2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186247825} {:answer/id #uuid "52a8d6c1-c802-52b6-9422-b177b1c39eeb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186248165} {:answer/id #uuid "644a1b11-e2aa-55cd-ba47-d5a074cd81d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186248329} {:answer/id #uuid "7e0fcf86-6e40-5292-948f-778a8f8317e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186248531}] :answer-field/correct {:answer/id #uuid "644a1b11-e2aa-55cd-ba47-d5a074cd81d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186248329} :answer-field/id #uuid "6fb56519-add1-5a22-b89f-f23b73f9e1db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249861}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f0b7651b-eacd-5715-8331-dab57a1d4302" :question/math-academy-id "q-115526" :question/problem "Evaluate ${lim}_{x\\to {0}^{+}}\\frac{\\operatorname{ln}⁡(\\operatorname{sin}⁡x)}{\\operatorname{cot}⁡x}.$" :question/worked-solution "Here the limits of the numerator and denominator are ${lim}_{x\\to {0}^{+}}\\operatorname{ln}⁡(\\operatorname{sin}⁡x)=-\\infty $ and ${lim}_{x\\to {0}^{+}}\\operatorname{cot}⁡x=\\infty ,$ respectively, so we have the case $\\frac{-\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}\\frac{\\operatorname{ln}⁡(\\operatorname{sin}⁡x)}{\\operatorname{cot}⁡x} & ={lim}_{x\\to {0}^{+}}\\frac{{[\\operatorname{ln}⁡(\\operatorname{sin}⁡x)]}^{′}}{[\\operatorname{cot}⁡x]^{′}} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{(\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x})}{-{csc}^{2}⁡x} \\\\  & =-{lim}_{x\\to {0}^{+}}\\frac{(\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x})}{(\\frac{1}{{sin}^{2}⁡x})} \\\\  & =-{lim}_{x\\to {0}^{+}}\\frac{\\operatorname{cos}⁡x{sin}^{2}⁡x}{\\operatorname{sin}⁡x} \\\\  & =-{lim}_{x\\to {0}^{+}}\\operatorname{cos}⁡x\\operatorname{sin}⁡x \\\\  & =-\\operatorname{cos}⁡0\\operatorname{sin}⁡0 \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250430 :knowledge-point/_questions [{:db/id #edb/ref 17592186068691 :knowledge-point/id #uuid "aeebf57f-21dc-558a-bec5-4e97a5b26de4" :knowledge-point/title "Calculating a Limit at Positive or Negative Infinity Using L'Hopital's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d037599-07ed-5ba7-83e9-f8c1efa482f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186247821} {:answer/id #uuid "31ae4547-e21a-58af-ba30-0bdc4c6faf8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186247874} {:answer/id #uuid "88431084-d59b-514f-a06a-1a663f1974b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186248641} {:answer/id #uuid "d2dfa8ec-c233-56f4-9f06-28d24d2fad3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186249296} {:answer/id #uuid "f67649d3-0d90-50b6-8568-82074b23672e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186249574}] :answer-field/correct {:answer/id #uuid "d2dfa8ec-c233-56f4-9f06-28d24d2fad3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186249296} :answer-field/id #uuid "38f9bf5f-e290-5c3d-ab0c-661753693c04" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249771}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e116ffff-24eb-5f64-952b-b5d8dd36f71b" :question/math-academy-id "q-115530" :question/problem "Evaluate ${lim}_{x\\to \\infty }\\frac{\\sqrt{x}}{{ln}^{2}⁡x}.$" :question/worked-solution "Here the limits of the numerator and denominator are ${lim}_{x\\to \\infty }\\sqrt{x}=\\infty $ and ${lim}_{x\\to \\infty }{ln}^{2}⁡x=\\infty ,$ respectively, so we have the case $\\frac{\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{\\sqrt{x}}{{ln}^{2}⁡x} & ={lim}_{x\\to \\infty }\\frac{[\\sqrt{x}]^{′}}{{[{ln}^{2}⁡x]}^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{1}{2\\sqrt{x}})}{(\\frac{2\\operatorname{ln}⁡x}{x})} \\\\  & ={lim}_{x\\to \\infty }\\frac{x}{4\\sqrt{x}\\operatorname{ln}⁡x} \\\\  & ={lim}_{x\\to \\infty }\\frac{\\sqrt{x}}{4\\operatorname{ln}⁡x}.\\end{aligned}\n$$\n\nThe resulting limit still gives the indeterminate form $\\frac{\\infty }{\\infty }.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{\\sqrt{x}}{{ln}^{2}⁡x} & ={lim}_{x\\to \\infty }\\frac{\\sqrt{x}}{4\\operatorname{ln}⁡x} \\\\  & ={lim}_{x\\to \\infty }\\frac{[\\sqrt{x}]^{′}}{[4\\operatorname{ln}⁡x]^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{1}{2\\sqrt{x}})}{(\\frac{4}{x})} \\\\  & ={lim}_{x\\to \\infty }\\frac{x}{8\\sqrt{x}} \\\\  & =\\frac{1}{8}{lim}_{x\\to \\infty }\\sqrt{x} \\\\  & =\\infty .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250437 :knowledge-point/_questions [{:db/id #edb/ref 17592186078567 :knowledge-point/id #uuid "1b0dd714-5bf1-573f-9ff9-11802622ce92" :knowledge-point/title "Estimating the Value of a Function at a Point Given its Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51c49e73-7167-5ae2-801d-f837455bee06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12.5" :db/id #edb/ref 17592186248160} {:answer/id #uuid "8a551a90-50be-592f-a782-fd4c8d2310c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4.5" :db/id #edb/ref 17592186248657} {:answer/id #uuid "cedce07a-75c0-5bad-8a4e-05968db673a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186249258} {:answer/id #uuid "e7d6c707-7ff2-5d23-9be6-0d25d141ecd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186249472} {:answer/id #uuid "ea123406-a78c-5622-b6e1-572fe445793f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-14.5" :db/id #edb/ref 17592186249490}] :answer-field/correct {:answer/id #uuid "8a551a90-50be-592f-a782-fd4c8d2310c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4.5" :db/id #edb/ref 17592186248657} :answer-field/id #uuid "4408b536-f4b5-5616-a973-2a22a6024d6c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249792}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3f055be2-bdc1-5b7a-ac96-2209c3dd80d8" :question/math-academy-id "q-115608" :question/problem "Let $f$ be a function such that ${f}^{′}(x)={x}^{2}(4x-9)$ and $f(1)=-2.$ Use the tangent line approximation of $f(x)$ at $x=1$ to estimate the value of $f(1.5).$" :question/worked-solution "The tangent line approximation of $f(x)$ at the point $a=1$ is\n\n$$\n\\begin{aligned}L(x) & =f(a)+{f}^{′}(a)(x-a) \\\\  & =f(1)+{f}^{′}(1)(x-1).\\end{aligned}\n$$\n\nWe're told that $f(1)=-2,$ and since ${f}^{′}(x)={x}^{2}(4x-9),$ then ${f}^{′}(1)={1}^{2}(4\\cdot 1-9)=-5.$ So, the tangent line approximation is given by\n\n$$\nL(x)=-2-5(x-1).\n$$\n\nNow, we can approximate $f(1.5)$ by evaluating the tangent line approximation at $x=1.5.$ We get\n\n$$\n\\begin{aligned}f(1.5) & ≈L(1.5) \\\\  & =-2-5(1.5-1) \\\\  & =-2-5(0.5) \\\\  & =-2-2.5 \\\\  & =-4.5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250443 :knowledge-point/_questions [{:db/id #edb/ref 17592186096703 :knowledge-point/id #uuid "17099881-d7b9-54d9-a29a-4f5f28561cd3" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola with Vertex at the Origin Given Another Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "417457e2-f527-590e-8a52-cfbea734e890" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=-\\frac{1}{2}y" :db/id #edb/ref 17592186248006} {:answer/id #uuid "59f803eb-398e-554f-959f-407e6aa234ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=4x" :db/id #edb/ref 17592186248236} {:answer/id #uuid "772d4b5c-5e0b-5e8c-8d75-4a2c540051b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-2x" :db/id #edb/ref 17592186248474} {:answer/id #uuid "ad0eb5d3-7444-55f0-9242-f2645d848a25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=2y" :db/id #edb/ref 17592186248973} {:answer/id #uuid "ddf395d3-b5c3-56fe-82d5-f51343d8cd57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-\\frac{1}{2}x" :db/id #edb/ref 17592186249390}] :answer-field/correct {:answer/id #uuid "772d4b5c-5e0b-5e8c-8d75-4a2c540051b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-2x" :db/id #edb/ref 17592186248474} :answer-field/id #uuid "3b8e70aa-72f7-5f54-9fef-39805521c959" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249774}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "34ce73b1-4d1a-5e32-8244-a4c68ffbd052" :question/math-academy-id "q-115633" :question/problem "Find the equation of the left-opening parabola that has its vertex at $(0,0)$ and passes through the point $(-2,-2).$" :question/worked-solution "The general standard equation of a parabola whose vertex is $(0,0)$ and whose arms open right or left is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSince we know the given parabola passes through the point $(-2,-2),$ we can substitute $x=-2$ and $y=-2$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ (-2)^{2} & =4p(-2) \\\\ 4 & =-8p \\\\ p & =-\\frac{1}{2}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {y}^{2} & =4(-\\frac{1}{2})x \\\\ {y}^{2} & =-2x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250444 :knowledge-point/_questions [{:db/id #edb/ref 17592186096703 :knowledge-point/id #uuid "17099881-d7b9-54d9-a29a-4f5f28561cd3" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola with Vertex at the Origin Given Another Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45166553-bf16-5fa9-8f50-1ec180cc0491" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-\\frac{1}{16}x" :db/id #edb/ref 17592186248043} {:answer/id #uuid "869aa896-1386-5aa1-acd0-77b1926c3156" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-4x" :db/id #edb/ref 17592186248625} {:answer/id #uuid "b1716195-2d70-5b16-8e29-18c8d7c74eb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-16x" :db/id #edb/ref 17592186249013} {:answer/id #uuid "cad70ee1-b661-5e1b-8e0a-c2d157b64a12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=4y" :db/id #edb/ref 17592186249231} {:answer/id #uuid "d07d22e0-e6d0-514f-92c9-e09c9996024c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=-\\frac{1}{4}y" :db/id #edb/ref 17592186249272}] :answer-field/correct {:answer/id #uuid "b1716195-2d70-5b16-8e29-18c8d7c74eb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-16x" :db/id #edb/ref 17592186249013} :answer-field/id #uuid "f2c6191f-54f1-5592-9add-c8743f8cc4c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250094}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "07da239d-b796-56b0-87bd-44779be7e860" :question/math-academy-id "q-115634" :question/problem "Find the equation of the left-opening parabola that has its vertex at $(0,0)$ and passes through the point $(-1,-4).$" :question/worked-solution "The general standard equation of a parabola whose vertex is $(0,0)$ and whose arms open right or left is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSince we know the given parabola passes through the point $(-1,-4),$ we can substitute $x=-1$ and $y=-4$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ (-4)^{2} & =4p(-1) \\\\ 16 & =-4p \\\\ p & =-4\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {y}^{2} & =4(-4)x \\\\ {y}^{2} & =-16x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250447 :knowledge-point/_questions [{:db/id #edb/ref 17592186096704 :knowledge-point/id #uuid "dc86c375-c2c4-56b7-a207-0abfc9709f6a" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2674032e-cd4e-5e8a-803c-317914ccae04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+2)^{2}=\\frac{1}{3}(x-1)" :db/id #edb/ref 17592186247762} {:answer/id #uuid "839ff22d-c37d-5d91-9333-174668c3261a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+2)^{2}=-\\frac{9}{4}(x-1)" :db/id #edb/ref 17592186248587} {:answer/id #uuid "ba27305a-d65b-5604-aaff-169ce339bb7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-1)^{2}=-\\frac{1}{3}(y+2)" :db/id #edb/ref 17592186249088} {:answer/id #uuid "c6443236-97c8-5e59-91fe-9a22a7cec2f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+2)^{2}=9(x-1)" :db/id #edb/ref 17592186249186} {:answer/id #uuid "dc878183-0dd0-5e61-ae12-26bab8ba8369" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-2)^{2}=\\frac{1}{12}(x+1)" :db/id #edb/ref 17592186249374}] :answer-field/correct {:answer/id #uuid "2674032e-cd4e-5e8a-803c-317914ccae04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+2)^{2}=\\frac{1}{3}(x-1)" :db/id #edb/ref 17592186247762} :answer-field/id #uuid "53f52642-018d-53e4-af4e-c4f058d871f5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249824}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fff1310e-72c2-5e26-9574-a4434ee14fd6" :question/math-academy-id "q-115642" :question/problem "![](images/8e/8ea1ad85f30978bed681f48e02f4af2f401a1f561390bee09683ead252fc1d7d.png)\n\nWhat is the equation of the parabola shown above?" :question/worked-solution "From the diagram we see that the arms of the parabola open to the right. The parabola has its vertex at $(1,-2)$ and passes through the point $(4,-3).$\n\nThe general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(1,-2),$ we substitute $h=1$ and $k=-2$ into the equation above and get\n\n$$\n\\begin{aligned}(y+2)^{2} & =4p(x-1).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(4,-3),$ so we can substitute $x=4$ and $y=-3$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}(y+2)^{2} & =4p(x-1) \\\\ (-3+2)^{2} & =4p(4-1) \\\\ 1 & =12p \\\\ p & =\\frac{1}{12}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}(y+2)^{2} & =4p(x-1) \\\\ (y+2)^{2} & =4(\\frac{1}{12})(x-1) \\\\ (y+2)^{2} & =\\frac{1}{3}(x-1).\\end{aligned}\n$$\n\nNotice that the arms of the parabola open to the right since $p=\\frac{1}{12}$ is positive."}] [{:db/id #edb/ref 17592186250449 :knowledge-point/_questions [{:db/id #edb/ref 17592186096705 :knowledge-point/id #uuid "783ca59b-0242-584c-ae47-004a0eb03817" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola Given the Vertex and Another Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1250a4f0-3718-52c9-9904-980960e90f58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+1)^{2}=-(y-1)" :db/id #edb/ref 17592186247590} {:answer/id #uuid "2ef0ec03-c73b-5bdb-afad-8cb320620573" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+1)^{2}=x-1" :db/id #edb/ref 17592186247845} {:answer/id #uuid "9501f1cc-1079-55a6-ae61-087d9b006e30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-1)^{2}=4(x+1)" :db/id #edb/ref 17592186248747} {:answer/id #uuid "e72f2ce1-958b-58a2-8358-7d53986a1a3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+1)^{2}=4(x-1)" :db/id #edb/ref 17592186249460} {:answer/id #uuid "f753f4ac-c307-5fb5-a501-f7cc4a07aeb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-1)^{2}=-4(x+1)" :db/id #edb/ref 17592186249584}] :answer-field/correct {:answer/id #uuid "e72f2ce1-958b-58a2-8358-7d53986a1a3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+1)^{2}=4(x-1)" :db/id #edb/ref 17592186249460} :answer-field/id #uuid "07d422bf-e80a-5532-a92f-ce3f3b453131" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249684}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4025b5ab-d584-549e-8e48-80f0cd57c2e9" :question/math-academy-id "q-115644" :question/problem "Find the equation of the right-opening parabola that has its vertex at $(1,-1)$ and passes through the point $(2,1).$" :question/worked-solution "The general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(1,-1),$ we substitute $h=1$ and $k=-1$ into the equation above and get\n\n$$\n\\begin{aligned}(y+1)^{2} & =4p(x-1).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(2,1),$ so we can substitute $x=2$ and $y=1$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}(y+1)^{2} & =4p(x-1) \\\\ (1+1)^{2} & =4p(2-1) \\\\ 4 & =4p \\\\ p & =1\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}(y+1)^{2} & =4p(x-1) \\\\ (y+1)^{2} & =4(1)(x-1) \\\\ (y+1)^{2} & =4(x-1).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250456 :knowledge-point/_questions [{:db/id #edb/ref 17592186068747 :knowledge-point/id #uuid "11647cdd-6315-5718-9425-88f4fb93faa7" :knowledge-point/title "Integrating a Rational Functions With a Repeated Factor of Degree Higher Than Two"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06d510ad-e4c6-5b08-97e2-145c27b946b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{x+8}+\\frac{2}{(x+8)^{2}}+K" :db/id #edb/ref 17592186247487} {:answer/id #uuid "359169cf-7dfa-5fd2-b41b-65dfb064eccf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡|x+8|-\\frac{2}{x+8}+\\frac{3}{(x+8)^{2}}+K" :db/id #edb/ref 17592186247908} {:answer/id #uuid "6b603583-9558-5345-9f72-ac375dd8cd32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{x+8}-\\frac{10}{(x+8)^{2}}+K" :db/id #edb/ref 17592186248378} {:answer/id #uuid "9ee712ae-afa4-548d-a83e-6f57e098e203" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|x+8|-\\frac{1}{x+8}+\\frac{5}{(x+8)^{2}}+K" :db/id #edb/ref 17592186248837} {:answer/id #uuid "f310db86-e9eb-5f4c-9d1c-94714b2a79a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{x+8}+\\frac{5}{(x+8)^{2}}+K" :db/id #edb/ref 17592186249552}] :answer-field/correct {:answer/id #uuid "f310db86-e9eb-5f4c-9d1c-94714b2a79a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{x+8}+\\frac{5}{(x+8)^{2}}+K" :db/id #edb/ref 17592186249552} :answer-field/id #uuid "8c3b99d3-685d-5960-9262-fdb7cc5ba128" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249917}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6058468b-fca6-572c-b924-db85b67482b1" :question/math-academy-id "q-115662" :question/problem "$\\int \\frac{x-2}{(x+8)^{3}}\\,\\text{d}x=$" :question/worked-solution "First, we must convert the integrand into a sum of partial fractions:\n\n$$\n\\frac{x-2}{(x+8)^{3}}=\\frac{A}{x+8}+\\frac{B}{(x+8)^{2}}+\\frac{C}{(x+8)^{3}}\n$$\n\nTo determine the coefficients $A,B,$ and $C,$ we first multiply both sides of the above equation by $(x+8)^{3}$ and get\n\n$$\nx-2=A(x+8)^{2}+B(x+8)+C.\n$$\n\nPlugging in $x=-8,$ we can eliminate $A$ and $B$ and solve for $C:$\n\n$$\n\\begin{aligned}(-8)-2 & =A(-8+8)^{2}+B(-8+8)+C \\\\ -10 & =C\\end{aligned}\n$$\n\nNow, plugging in $x=-7$ and substituting the known value of $C,$ we get an equation relating $A$ and $B:$\n\n$$\n\\begin{aligned}(-7)-2 & =A(-7+8)^{2}+B(-7+8)+C \\\\ -9 & =A+B-10 \\\\ A+B & =1\\end{aligned}\n$$\n\nSimilarly, plugging in $x=-9$ and substituting the known value of $C,$ we get an equation relating $A$ and $B:$\n\n$$\n\\begin{aligned}(-9)-2 & =A(-9+8)^{2}+B(-9+8)+C \\\\ -11 & =A-B-10 \\\\ A-B & =-1\\end{aligned}\n$$\n\nAdding the equations $A-B=-1$ and $A+B=1,$ we get\n\n$$\n\\begin{aligned}2A & =-1+1 \\\\ 2A & =0 \\\\ A & =0,\\end{aligned}\n$$\n\nand substituting back into $A+B=1,$ we get\n\n$$\n\\begin{aligned}0+B & =1 \\\\ B & =1.\\end{aligned}\n$$\n\nTherefore, we can write the integrand as the partial sum:\n\n$$\n\\frac{x-2}{(x+8)^{3}}=\\frac{1}{(x+8)^{2}}-\\frac{10}{(x+8)^{3}}.\n$$\n\nFinally, we integrate this expression term by term to get\n\n$$\n\\begin{aligned}\\int \\frac{x-2}{(x+8)^{3}}\\,\\text{d}x & =\\int (\\frac{1}{(x+8)^{2}}-\\frac{10}{(x+8)^{3}})\\,\\text{d}x \\\\  & =\\int \\frac{1}{(x+8)^{2}}\\,\\text{d}x-10\\int \\frac{1}{(x+8)^{3}}\\,\\text{d}x \\\\  & =-\\frac{1}{x+8}+\\frac{5}{(x+8)^{2}}+K,\\end{aligned}\n$$\n\nwhere $K$ is an integral constant."}] [{:db/id #edb/ref 17592186250460 :knowledge-point/_questions [{:db/id #edb/ref 17592186068804 :knowledge-point/id #uuid "a78860ea-192f-5df9-aca9-4f67ec6ffefe" :knowledge-point/title "Integrating a Rational Function Given Part Of the Partial Fraction Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cf1b20f-3f1e-5d39-b833-924bd37ace5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡({x}^{2}+20)+\\sqrt{5}\\operatorname{arctan}⁡(\\frac{\\sqrt{5}x}{10})+2\\operatorname{ln}⁡|x+1|+C" :db/id #edb/ref 17592186247541} {:answer/id #uuid "1778ff91-6f16-5705-8283-db705faace3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡({x}^{2}+20)-\\frac{7\\sqrt{5}}{10}\\operatorname{arctan}⁡(\\frac{\\sqrt{5}x}{10})-\\operatorname{ln}⁡|x+1|+C" :db/id #edb/ref 17592186247636} {:answer/id #uuid "30031e73-eda6-5628-a936-a4c56fda636b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡({x}^{2}+20)-\\frac{7}{5}\\operatorname{arctan}⁡(\\frac{x}{5})-\\operatorname{ln}⁡|x+1|+C" :db/id #edb/ref 17592186247857} {:answer/id #uuid "ca0be9ab-d229-5515-9f4f-676bfd0e8f41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡({x}^{2}+20)-\\frac{\\sqrt{5}}{5}\\operatorname{arctan}⁡(\\frac{\\sqrt{5}x}{5})+C" :db/id #edb/ref 17592186249222} {:answer/id #uuid "e64b227d-d62e-52ef-8489-7acf21e9c49e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡({x}^{2}+20)-\\frac{\\sqrt{5}}{10}\\operatorname{arctan}⁡(\\frac{\\sqrt{5}x}{10})+C" :db/id #edb/ref 17592186249453}] :answer-field/correct {:answer/id #uuid "1778ff91-6f16-5705-8283-db705faace3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡({x}^{2}+20)-\\frac{7\\sqrt{5}}{10}\\operatorname{arctan}⁡(\\frac{\\sqrt{5}x}{10})-\\operatorname{ln}⁡|x+1|+C" :db/id #edb/ref 17592186247636} :answer-field/id #uuid "26f2bda8-8928-56d1-a14f-bbe51de1a1c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249744}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "aa383850-ed95-5745-b056-448c57db2176" :question/math-academy-id "q-115673" :question/problem "Given that \n\n$$\n\\frac{{x}^{2}-5x-27}{(x+1)({x}^{2}+20)}=\\frac{2x+B}{{x}^{2}+20}-\\frac{1}{x+1},\n$$\n\nwhere $B$ is a constant to be found, calculate $\\int \\frac{{x}^{2}-5x-27}{(x+1)({x}^{2}+20)}\\,\\text{d}x.$" :question/worked-solution "First, we find the constant $B.$ Multiplying both sides of the given equality by $(x+1)({x}^{2}+20)$ gives\n\n$$\n\\begin{aligned}{x}^{2}-5x-27 & =(2x+B)(x+1)-({x}^{2}+20).\\end{aligned}\n$$\n\nSubstituting $x=0$  into the above gives\n\n$$\n\\begin{aligned}{0}^{2}-5(0)-27 & =(2(0)+B)(0+1)-({0}^{2}+20) \\\\ -27 & =B-20 \\\\ B & =-7.\\end{aligned}\n$$\n\n \n\nWe now integrate this function term by term, adding the constant of integration at the very end.\n\n$$\n\\begin{aligned}\\int \\frac{{x}^{2}-5x-27}{(x+1)({x}^{2}+20)}\\,\\text{d}x & =\\int (\\frac{2x-7}{{x}^{2}+20}-\\frac{1}{x+1})\\text{d}x \\\\  & =\\int \\frac{2x}{{x}^{2}+20}\\,\\text{d}x-7\\int \\frac{1}{{x}^{2}+20}\\,\\text{d}x-\\int \\frac{1}{x+1}\\text{d}x\\end{aligned}\n$$\n\nFor the first integral, we use the substitution ${x}^{2}+20=u.$ Then, $2x\\,\\text{d}x=\\text{d}u,$ and we get \n\n$$\n\\begin{aligned}\\int \\frac{2x}{{x}^{2}+20}\\,\\text{d}x & =\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡|u| \\\\  & =\\operatorname{ln}⁡({x}^{2}+20).\\end{aligned}\n$$\n\nFor the second integral, we use the fact that $\\int \\frac{1}{{x}^{2}+{a}^{2}}\\,\\text{d}x=\\frac{1}{a}\\operatorname{arctan}⁡(\\frac{x}{a}),$ which results in\n\n$$\n\\begin{aligned}7\\int \\frac{1}{{x}^{2}+20}\\,\\text{d}x & =7\\int \\frac{1}{{x}^{2}+(2\\sqrt{5})^{2}}\\,\\text{d}x \\\\  & =7\\cdot \\frac{1}{2\\sqrt{5}}\\operatorname{arctan}⁡(\\frac{x}{2\\sqrt{5}}) \\\\  & =\\frac{7\\sqrt{5}}{10}\\operatorname{arctan}⁡(\\frac{\\sqrt{5}x}{10}).\\end{aligned}\n$$\n\nFinally, for the third integral, we get\n\n$$\n\\int \\frac{1}{x+1}\\text{d}x=\\operatorname{ln}⁡|x+1|.\n$$\n\nSo, we get the following result:\n\n$$\n\\begin{aligned}\\int \\frac{{x}^{2}-5x-27}{(x+1)({x}^{2}+20)}\\,\\text{d}x & =\\operatorname{ln}⁡({x}^{2}+20)-\\frac{7\\sqrt{5}}{10}\\operatorname{arctan}⁡(\\frac{\\sqrt{5}x}{10})-\\operatorname{ln}⁡|x+1|+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250463 :knowledge-point/_questions [{:db/id #edb/ref 17592186059747 :knowledge-point/id #uuid "9c7a77cf-163a-542a-b4a3-4274344b9cf8" :knowledge-point/title "Multiplying 3x3 Square Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a311bb5-3182-5198-a152-bc200f70be62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}11 & -2 & 7 \\\\ -1 & 3 & 2 \\\\ 10 & 2 & -8\\end{aligned}]" :db/id #edb/ref 17592186248372} {:answer/id #uuid "93e14b07-a873-5463-ab6a-2c7bc9069278" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}11 & -2 & 7 \\\\ 1 & 3 & 2 \\\\ 10 & 2 & 8\\end{aligned}]" :db/id #edb/ref 17592186248739} {:answer/id #uuid "a450ea4a-394f-5c90-bf03-56556c7878ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}11 & -2 & 7 \\\\ -1 & 3 & 2 \\\\ 10 & 2 & 8\\end{aligned}]" :db/id #edb/ref 17592186248890} {:answer/id #uuid "af58b380-5f76-5bbb-a820-5f4b83135e20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}10 & -2 & 7 \\\\ -1 & 3 & 2 \\\\ 10 & 2 & 8\\end{aligned}]" :db/id #edb/ref 17592186248996} {:answer/id #uuid "f0734682-f5a2-5e21-a23e-5f8cb703cff0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}11 & -2 & 7 \\\\ -1 & 3 & 2 \\\\ 10 & -2 & 8\\end{aligned}]" :db/id #edb/ref 17592186249534}] :answer-field/correct {:answer/id #uuid "a450ea4a-394f-5c90-bf03-56556c7878ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}11 & -2 & 7 \\\\ -1 & 3 & 2 \\\\ 10 & 2 & 8\\end{aligned}]" :db/id #edb/ref 17592186248890} :answer-field/id #uuid "c9354821-08c3-542c-978e-86f64daf4fdf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250015}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9c07fc8a-7bd0-54d4-b86d-f5ce5f6701b1" :question/math-academy-id "q-11568" :question/problem "Find $ST$,  if  $S=[\\begin{aligned}1 & 0 & 4 \\\\ 0 & -5 & 2 \\\\ 2 & 0 & 2\\end{aligned}]$ and $T=[\\begin{aligned}3 & 2 & 3 \\\\ 1 & -1 & 0 \\\\ 2 & -1 & 1\\end{aligned}].$" :question/worked-solution "Multiplying each row in the first matrix by each column in the second, we get\n\n$$\n\\begin{aligned}ST & =[\\begin{aligned}1 & 0 & 4 \\\\ 0 & -5 & 2 \\\\ 2 & 0 & 2\\end{aligned}][\\begin{aligned}3 & 2 & 3 \\\\ 1 & -1 & 0 \\\\ 2 & -1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}3+0+8 & 2+0-4 & 3+0+4 \\\\ 0-5+4 & 0+5-2 & 0-0+2 \\\\ 6+0+4 & 4-0-2 & 6+0+2\\end{aligned}] \\\\  & =[\\begin{aligned}11 & -2 & 7 \\\\ -1 & 3 & 2 \\\\ 10 & 2 & 8\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250467 :knowledge-point/_questions [{:db/id #edb/ref 17592186068716 :knowledge-point/id #uuid "3c22b8e9-049a-5574-86c9-35788c410421" :knowledge-point/title "Integrating a Rational Function With an Irreducible Binomial Quadratic Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a06faf40-267a-585a-a698-8d1c4a8418b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{ln}⁡({x}^{2}+3)+\\sqrt{3}\\operatorname{arctan}⁡(\\frac{\\sqrt{3}x}{3})+3\\operatorname{ln}⁡|x+4|+K" :db/id #edb/ref 17592186248857} {:answer/id #uuid "b11b9a13-576c-58f2-b1fa-068e66f1591c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡({x}^{2}+3)-\\sqrt{3}\\operatorname{arctan}⁡(\\frac{\\sqrt{3}x}{3})+K" :db/id #edb/ref 17592186249010} {:answer/id #uuid "c3c1daa1-28ba-5945-bf62-2d01df1e7ac3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡({x}^{2}+3)-\\frac{\\sqrt{3}}{3}\\operatorname{arctan}⁡(\\frac{\\sqrt{3}x}{3})+3\\operatorname{ln}⁡|x+4|+K" :db/id #edb/ref 17592186249162} {:answer/id #uuid "e31429d4-0443-599a-a3a4-365a3f4492c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡({x}^{2}+3)-3\\sqrt{3}\\operatorname{arctan}⁡(\\frac{\\sqrt{3}x}{3})+\\operatorname{ln}⁡|x+4|+K" :db/id #edb/ref 17592186249430} {:answer/id #uuid "ebec7c76-3253-5217-8050-0e4ee5b66e82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡({x}^{2}+3)-\\sqrt{3}\\operatorname{arctan}⁡(\\frac{\\sqrt{3}x}{3})+\\operatorname{ln}⁡|x+4|+K" :db/id #edb/ref 17592186249496}] :answer-field/correct {:answer/id #uuid "ebec7c76-3253-5217-8050-0e4ee5b66e82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡({x}^{2}+3)-\\sqrt{3}\\operatorname{arctan}⁡(\\frac{\\sqrt{3}x}{3})+\\operatorname{ln}⁡|x+4|+K" :db/id #edb/ref 17592186249496} :answer-field/id #uuid "4adf0cfe-17c4-56d0-b154-4a4709b2b3f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249808}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b36c8e07-4439-57ae-b9d1-276ef485c6ec" :question/math-academy-id "q-115693" :question/problem "Evaluate $\\int \\frac{3{x}^{2}+5x-9}{({x}^{2}+3)(x+4)}\\,\\text{d}x.$" :question/worked-solution "The quadratic factor ${x}^{2}+3$ is irreducible, so we proceed with the following partial fraction decomposition:\n\n$$\n\\begin{aligned}\\frac{3{x}^{2}+5x-9}{({x}^{2}+3)(x+4)} & =\\frac{Ax+B}{{x}^{2}+3}+\\frac{C}{x+4}\\end{aligned}\n$$\n\nTo determine the coefficients $A,B,$ and $C,$ we first multiply both sides of the above equation by $({x}^{2}+3)(x+4),$ and we get\n\n$$\n\\begin{aligned}3{x}^{2}+5x-9 & =(Ax+B)(x+4)+C({x}^{2}+3).\\end{aligned}\n$$\n\nSolving for the unknown constants using the usual methods, we get $A=2,B=-3,$ and $C=1.$ Therefore,\n\n$$\n\\begin{aligned}\\frac{3{x}^{2}+5x-9}{({x}^{2}+3)(x+4)} & =\\frac{2x-3}{{x}^{2}+3}+\\frac{1}{x+4}\\end{aligned}\n$$\n\nWe now integrate this function term by term, adding the constant of integration at the very end.\n\n$$\n\\begin{aligned}\\int \\frac{3{x}^{2}+5x-9}{({x}^{2}+3)(x+4)}\\,\\text{d}x & =\\int (\\frac{2x-3}{{x}^{2}+3}+\\frac{1}{x+4})\\text{d}x \\\\  & =\\int \\frac{2x}{{x}^{2}+3}\\,\\text{d}x-3\\int \\frac{1}{{x}^{2}+3}\\,\\text{d}x+\\int \\frac{1}{x+4}\\,\\text{d}x\\end{aligned}\n$$\n\nFor the first integral, we use the substitution $u={x}^{2}+3.$ Then $\\text{d}u=2x\\,\\text{d}x,$ and we get\n\n$$\n\\begin{aligned}\\int \\frac{2x}{{x}^{2}+3}\\,\\text{d}x & =\\int \\frac{1}{u}\\text{d}u \\\\  & =\\operatorname{ln}⁡|u| \\\\  & =\\operatorname{ln}⁡|{x}^{2}+3| \\\\  & =\\operatorname{ln}⁡({x}^{2}+3).\\end{aligned}\n$$\n\nFor the second integral, we use the fact that $\\int \\frac{1}{{x}^{2}+{a}^{2}}\\,\\text{d}x=\\frac{1}{a}\\operatorname{arctan}⁡(\\frac{x}{a}),$ which results in\n\n$$\n\\begin{aligned}3\\int \\frac{1}{{x}^{2}+3}\\,\\text{d}x & =3\\cdot \\frac{1}{\\sqrt{3}}\\cdot \\operatorname{arctan}⁡(\\frac{x}{\\sqrt{3}}) \\\\  & =\\sqrt{3}\\operatorname{arctan}⁡(\\frac{\\sqrt{3}x}{3}).\\end{aligned}\n$$\n\nFinally, for the third integral, we have\n\n$$\n\\int \\frac{1}{x+4}\\,\\text{d}x=\\operatorname{ln}⁡|x+4|.\n$$\n\nSo, we get the following result:\n\n$$\n\\begin{aligned}\\int \\frac{3{x}^{2}+5x-9}{({x}^{2}+3)(x+4)}\\,\\text{d}x & =\\int \\frac{2x}{{x}^{2}+3}\\,\\text{d}x-3\\int \\frac{1}{{x}^{2}+3}\\,\\text{d}x+\\int \\frac{1}{x+4}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡({x}^{2}+3)-\\sqrt{3}\\operatorname{arctan}⁡(\\frac{\\sqrt{3}x}{3})+\\operatorname{ln}⁡|x+4|+K\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386778 :knowledge-point/_questions [{:db/id #edb/ref 17592186105815 :knowledge-point/id #uuid "ad9b9344-1711-5ff4-b489-f6ef2a0bd2eb" :knowledge-point/title "Determining Whether a Right Riemann Sum is an Overestimate or Underestimate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6df8ccbf-f61f-5045-b190-82195e9bc94d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bd/bd25af02c775675398a93df167cce72fa3ec50efe7bddb5c92bc7176571ee4dc.png" :db/id #edb/ref 17592186386780} {:answer/id #uuid "7e0d779f-0f2a-522b-8b63-800759166d10" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bd/bd21ae5295ae8d6c22d242f730f8b3b821cab8668d3d79f3b56a0ba0cb42797c.png" :db/id #edb/ref 17592186386781} {:answer/id #uuid "9761ba46-a7ff-5daf-94b2-b9b40fcdd4da" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b2/b20771fe256aba4c1ea20f5014230eb8868b0aacda8e57a79d5b5263ff9f2259.png" :db/id #edb/ref 17592186386782} {:answer/id #uuid "54d47529-92a8-5eb2-8c0b-23c71c8eafb4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f0/f03ac639e6c013d192c41dcf4c28774e13080a109dd767990745745b17b97231.png" :db/id #edb/ref 17592186386783} {:answer/id #uuid "af39a169-8aa8-50de-8011-3094507f72da" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/92/926dad6d4a567eeaebf5393a0b624f7d79c84b5a1b9d2409c26a3a7eaf2d4d38.png" :db/id #edb/ref 17592186386784}] :answer-field/correct {:answer/id #uuid "6df8ccbf-f61f-5045-b190-82195e9bc94d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bd/bd25af02c775675398a93df167cce72fa3ec50efe7bddb5c92bc7176571ee4dc.png" :db/id #edb/ref 17592186386780} :answer-field/id #uuid "9180e894-b9a8-54ae-a60b-1936c00eb91e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386779}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "aee1bfcf-98f5-58b0-a49f-a73ed36f1b35" :question/math-academy-id "q-115698" :question/problem "A right Riemann sum is used to approximate the area under the curve $y=f(x)$ between $x=-1$ and $x=1$ for each of the functions below. For which function does the Riemann sum give an *underestimate* of the area?" :question/worked-solution "The right Riemann sum underestimates the area under the respective curve if the function is decreasing over the given interval. \n\nOf the given options, the only function that is decreasing over $x\\in [-1,1]$ is as follows.\n\n![](images/bd/bd25af02c775675398a93df167cce72fa3ec50efe7bddb5c92bc7176571ee4dc.png)"}] [{:db/id #edb/ref 17592186386785 :knowledge-point/_questions [{:db/