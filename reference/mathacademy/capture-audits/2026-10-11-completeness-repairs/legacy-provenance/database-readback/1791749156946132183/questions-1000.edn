-5b31-8a05-aac895b8e8a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186293868}] :answer-field/correct {:answer/id #uuid "5ca36bf8-ba4f-5b39-a9a3-69579e0327a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186293306} :answer-field/id #uuid "97c9536e-46f9-5cd5-9342-46511da7345e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186294472}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b62a3ee1-92b6-5cd1-8a67-1ee93c23fffd" :question/math-academy-id "q-278486" :question/problem "What are the missing entries in the sign table below?\n\n|  | $(-\\infty ,-5)$ | $(-5,1)$ | $(1,\\infty )$ |\n| --- | --- | --- | --- |\n| $x+5$ | $-$ | {{field-1}} | $+$ |\n| $x-1$ | $-$ | {{field-2}} | $+$ |\n| $(x+5)(x-1)$ | $+$ | {{field-3}} | $+$ |" :question/worked-solution "On the interval $(-5,1),$ we can choose a test point ${x}_{1}=0.$ Then we have\n\n$$\n\\begin{aligned}x+5 & =0+5=(+), \\\\ x-1 & =0-1=(-), \\\\ (x+5)(x-1) & =(+)\\times (-)=(-),\\end{aligned}\n$$\n\nand we fill in the table as follows:\n\n|  | $(-\\infty ,-5)$ | $(-5,1)$ | $(1,\\infty )$ |\n| --- | --- | --- | --- |\n| $x+5$ | $-$ | $+$ | $+$ |\n| $x-1$ | $-$ | $-$ | $+$ |\n| $(x+5)(x-1)$ | $+$ | $-$ | $+$ |"}] [{:db/id #edb/ref 17592186295220 :knowledge-point/_questions [{:db/id #edb/ref 17592186083238 :knowledge-point/id #uuid "70c149d8-3739-564c-97c5-6636860ad0c4" :knowledge-point/title "Finding a Quadratic Polynomial Given Two Imaginary or Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fc3c4bb-149f-5ffc-97a4-e605c569a112" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-36" :db/id #edb/ref 17592186293002} {:answer/id #uuid "7c847aab-bc5d-5c8a-bb64-e369f3e92041" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-16" :db/id #edb/ref 17592186293431} {:answer/id #uuid "891b7b21-3dd3-5a5b-a070-71b374f714a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+6x" :db/id #edb/ref 17592186293465} {:answer/id #uuid "c769df52-89b1-54df-9eee-1096ad11021a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+36" :db/id #edb/ref 17592186293704} {:answer/id #uuid "f3affec0-5e08-51d1-8608-2d04df1b9df5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+6" :db/id #edb/ref 17592186293884}] :answer-field/correct {:answer/id #uuid "c769df52-89b1-54df-9eee-1096ad11021a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+36" :db/id #edb/ref 17592186293704} :answer-field/id #uuid "6e0f07fa-3f4d-54bc-a756-d828cde31d9f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294314}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5595fbd6-585b-5625-b1c7-99ec2edfefea" :question/math-academy-id "q-28185" :question/problem "The quadratic polynomial $f(x)$ has real coefficients, has roots ${x}_{1}=6\\text{i}$ and ${x}_{2}=-6\\text{i},$ and the coefficient of the quadratic term is $1.$ Find $f(x).$" :question/worked-solution "Since our quadratic polynomial has roots ${x}_{1}=6\\text{i}$ and ${x}_{2}=-6\\text{i},$ and the coefficient of the quadratic term is $a=1,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(x-{x}_{1})(x-{x}_{2}) & =(1)(x-6\\text{i})(x-(-6\\text{i})) \\\\  & =(x-6\\text{i})(x+6\\text{i})\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}(x-6\\text{i})(x+6\\text{i}) & ={x}^{2}-(6\\text{i})^{2} \\\\  & ={x}^{2}-36{\\text{i}}^{2} \\\\  & ={x}^{2}+36.\\end{aligned}\n$$\n\nTherefore, $f(x)={x}^{2}+36.$"}] [{:db/id #edb/ref 17592186115669 :knowledge-point/_questions [{:db/id #edb/ref 17592186115286 :knowledge-point/id #uuid "0236acfd-59d1-5bc8-9e60-1c76ddc536f5" :knowledge-point/title "Finding a Quadratic Equation Given a Complex Root and Its Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09b58c2a-9453-5ba0-8e30-d7ef6f50f331" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-2x=0" :db/id #edb/ref 17592186292973} {:answer/id #uuid "1fe3b0ab-4035-5215-83f4-f675f25dae49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+2x+2=0" :db/id #edb/ref 17592186293065} {:answer/id #uuid "990cf70d-51d7-5d57-8f12-e3cb78178131" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-x+1=0" :db/id #edb/ref 17592186293536} {:answer/id #uuid "c3e7310d-cf13-5cce-ad72-793eca71cfde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+2=0" :db/id #edb/ref 17592186293693} {:answer/id #uuid "cf236c96-ad3b-54fe-bf77-4c695ec85331" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+x-2=0" :db/id #edb/ref 17592186293734}] :answer-field/correct {:answer/id #uuid "1fe3b0ab-4035-5215-83f4-f675f25dae49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+2x+2=0" :db/id #edb/ref 17592186293065} :answer-field/id #uuid "e5b5aedb-f997-5a0b-816b-7a74825693b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294742}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8b3e3d2a-46f3-5327-8b01-7846488f9aea" :question/math-academy-id "q-28215" :question/problem "A quadratic equation in the variable $x$ with real coefficients has a root $x=-1+\\text{i}.$ Given that the coefficient of ${x}^{2}$ in the equation is $1,$ find the equation." :question/worked-solution "Since the quadratic equation has real coefficients and $x=-1+\\text{i}$ is a root, its conjugate $x=-1-\\text{i}$ must also be a root. Therefore, using the zero product property, we can write a quadratic equation with the required roots as follows:\n\n$$\n(x-(-1+\\text{i}))(x-(-1-\\text{i}))=0\n$$\n\nBy expanding the parentheses, we can write the equation in standard form as follows:\n\n$$\n\\begin{aligned}{x}^{2}-x(-1+\\text{i})-x(-1-\\text{i})+(-1+\\text{i})(-1-\\text{i}) & =0 \\\\ {x}^{2}+x-x\\text{i}+x+x\\text{i}+1-{\\text{i}}^{2} & =0 \\\\ {x}^{2}+2x+1+1 & =0 \\\\ {x}^{2}+2x+2 & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295233 :knowledge-point/_questions [{:db/id #edb/ref 17592186115286 :knowledge-point/id #uuid "0236acfd-59d1-5bc8-9e60-1c76ddc536f5" :knowledge-point/title "Finding a Quadratic Equation Given a Complex Root and Its Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bb60b0b-3bce-5f93-b41e-299f9f8e1c0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}+8x-10=0" :db/id #edb/ref 17592186293045} {:answer/id #uuid "2390c3f2-91e2-5b1e-a4af-01ff2490072a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-4x+5=0" :db/id #edb/ref 17592186293082} {:answer/id #uuid "49105bbc-e18b-5eaf-bb6d-2ca97cfe4526" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-8x+5=0" :db/id #edb/ref 17592186293232} {:answer/id #uuid "8b67390d-4d7d-5202-a4d0-85bdb5b66a87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-2x+10=0" :db/id #edb/ref 17592186293472} {:answer/id #uuid "e6d7eed6-b78d-5f9a-88c7-01cb6601a943" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-8x+10=0" :db/id #edb/ref 17592186293835}] :answer-field/correct {:answer/id #uuid "e6d7eed6-b78d-5f9a-88c7-01cb6601a943" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-8x+10=0" :db/id #edb/ref 17592186293835} :answer-field/id #uuid "163732be-245a-5974-a487-877ec7f851b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294000}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1863d55d-bd95-51d5-93ce-914cc34a24ab" :question/math-academy-id "q-28219" :question/problem "A quadratic equation in the variable $x$ with real coefficients has a root $x=2-\\text{i}.$ Given that the coefficient of ${x}^{2}$ in the equation is $2$, find the equation." :question/worked-solution "Since the quadratic equation has real coefficients and $x=2-\\text{i}$ is a root, its conjugate $x=2+\\text{i}$ must also be a root. Therefore, using the zero product property, we can write a quadratic equation with the required roots as follows:\n\n$$\n(x-(2-\\text{i}))(x-(2+\\text{i}))=0\n$$\n\nBy expanding the parentheses, we can write the equation in standard form as follows:\n\n$$\n\\begin{aligned}{x}^{2}-x(2+\\text{i})-x(2-\\text{i})+(2-\\text{i})(2+\\text{i}) & =0 \\\\ {x}^{2}-2x-x\\text{i}-2x+x\\text{i}+4-{\\text{i}}^{2} & =0 \\\\ {x}^{2}-4x+4+1 & =0 \\\\ {x}^{2}-4x+5 & =0\\end{aligned}\n$$\n\nThis equation has roots $x=2\\pm \\text{i},$ but the coefficient of ${x}^{2}$ is not $2.$ Therefore, to find the desired equation, we multiply the equation above by $2.$ This gives\n\n$$\n\\begin{aligned}2({x}^{2}-4x+5) & =0 \\\\ 2{x}^{2}-8x+10 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115676 :knowledge-point/_questions [{:db/id #edb/ref 17592186115358 :knowledge-point/id #uuid "51739685-2d53-5c9b-870b-b557ffdf2768" :knowledge-point/title "Finding the Area of a Triangle by Solving for a Variable Given a Trigonometric Ratio of One Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1757e5f4-54b5-5159-9ab2-49bce96f3df1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186293023} {:answer/id #uuid "9cbbe909-d185-59d0-b912-c153b5d3e71b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186293549} {:answer/id #uuid "a10e5fb3-4c1c-5b66-89cd-0598cd19bb77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186293566} {:answer/id #uuid "a838bda5-a5e8-5f6a-a576-b0a05239ea5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186293599} {:answer/id #uuid "ac38d79d-d749-555c-aea9-60b199533b57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186293606}] :answer-field/correct {:answer/id #uuid "1757e5f4-54b5-5159-9ab2-49bce96f3df1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186293023} :answer-field/id #uuid "331c0849-08b7-58b1-a991-ead4ea6bc11c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294107}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f0a77aee-e012-5d50-a91c-7eccfeb5ef38" :question/math-academy-id "q-28266" :question/problem "![](images/48/48cb6a248ab3ce706f26dc2e84e2feb337d509041c8b9756ea32fb3817aa097f.png)\n\nGiven that $\\operatorname{tan}⁡(m∠A)=5,$ calculate the area (in square units) of $△ABC$ shown above." :question/worked-solution "In this case, the area of the right triangle is\n\n$$\nA=\\frac{1}{2}AC\\cdot BC.\n$$\n\nWe are given that $\\operatorname{tan}⁡(m∠A)=5.$ Notice that relative to $∠A,$ we have expressions for the lengths of the opposite side $\\overset{―}{BC}$ and adjacent side $\\overset{―}{AC}.$ Hence, we can use the tangent ratio to solve for $x:$\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡(m∠A) & =\\frac{BC}{AC} \\\\ 5 & =\\frac{2x+4}{x-1} \\\\ 5(x-1) & =2x+4 \\\\ 5x-5 & =2x+4 \\\\ 3x & =9 \\\\ x & =3\\end{aligned}\n$$\n\nSo, the side lengths are\n\n$$\n\\begin{aligned}BC & =2x+4=2(3)+4=10, \\\\ AC & =x-1=3-1=2.\\end{aligned}\n$$\n\nTherefore, the area of $△ABC$ is\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}AC\\cdot BC \\\\  & =\\frac{1}{2}\\cdot 2\\cdot 10 \\\\  & =10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115677 :knowledge-point/_questions [{:db/id #edb/ref 17592186115360 :knowledge-point/id #uuid "fe83dedc-3034-5e3a-b546-dd57c0ccc6e8" :knowledge-point/title "Finding the Area of a Triangle by Solving for a Variable Given an Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62fd2e1e-c894-56ff-bdad-a3d722d754fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.8" :db/id #edb/ref 17592186293336} {:answer/id #uuid "a43f1763-d348-5fc3-86bb-5b3eb6a7220d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.2" :db/id #edb/ref 17592186293576} {:answer/id #uuid "adfca619-4c50-55cf-bc35-84d9301f25e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.7" :db/id #edb/ref 17592186293613} {:answer/id #uuid "c6b3bb07-e05e-5205-a1c1-5734a8c0a9eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.3" :db/id #edb/ref 17592186293701} {:answer/id #uuid "f997b95f-a99a-5b77-b147-99948a12e498" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.3" :db/id #edb/ref 17592186293913}] :answer-field/correct {:answer/id #uuid "a43f1763-d348-5fc3-86bb-5b3eb6a7220d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.2" :db/id #edb/ref 17592186293576} :answer-field/id #uuid "4675c8e0-ebf4-57e8-b4fe-9fcb51121df9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294179}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e988752b-e095-56b3-bad9-106f43a3e05c" :question/math-academy-id "q-28271" :question/problem "![](images/7d/7dc806c646f1e9f5edbfef789fbdc9dfca2745c637906bd61eccb8072440e8c0.png)\n\nIn square units rounded to one decimal place, find the area of $△ABC$ shown above." :question/requires-calculator true :question/worked-solution "In this case, the area of the right triangle is\n\n$$\nA=\\frac{1}{2}AC\\cdot BC.\n$$\n\nWe are given that $m∠A={63}^{∘}.$ Notice that relative to $∠A,$ we have expressions for the lengths of the opposite side $\\overset{―}{BC}$ and adjacent side $\\overset{―}{AC}.$ Hence, we can use the tangent ratio to solve for $x:$\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡(m∠A) & =\\frac{BC}{AC} \\\\ \\operatorname{tan}⁡({63}^{∘}) & =\\frac{3x+2}{3x} \\\\ 3x\\cdot \\operatorname{tan}⁡({63}^{∘}) & =3x+2 \\\\ 3x\\cdot \\operatorname{tan}⁡({63}^{∘})-3x & =2 \\\\ 3x(\\operatorname{tan}⁡({63}^{∘})-1) & =2 \\\\ x & =\\frac{2}{3(\\operatorname{tan}⁡({63}^{∘})-1)} \\\\ x & =0.692\\,5…\\end{aligned}\n$$\n\nSo, the side lengths are \n\n$$\n\\begin{aligned}BC & =3x+2=3(0.692\\,5…)+2=4.077\\,6…, \\\\ AC & =3x=3(0.692\\,5…)=2.077\\,6….\\end{aligned}\n$$\n\nTherefore, the area of $△ABC$ is\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}(2.077\\,6…)(4.077\\,6…) \\\\  & =4.236\\,0… \\\\  & ≈4.2,\\end{aligned}\n$$\n\nrounded to the one decimal place."}] [{:db/id #edb/ref 17592186295248 :knowledge-point/_questions [{:db/id #edb/ref 17592186115286 :knowledge-point/id #uuid "0236acfd-59d1-5bc8-9e60-1c76ddc536f5" :knowledge-point/title "Finding a Quadratic Equation Given a Complex Root and Its Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31d81fe9-d8bf-5033-a531-4c38c16343bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{2}+16x-8=0" :db/id #edb/ref 17592186293143} {:answer/id #uuid "51e57fe8-9a16-5417-bb16-0d24dc3d0496" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{2}-2x-16=0" :db/id #edb/ref 17592186293263} {:answer/id #uuid "a7fc5ffa-e73f-568f-8fcc-6c7ef5303257" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{2}+8x+16=0" :db/id #edb/ref 17592186293596} {:answer/id #uuid "cc23f64d-4c7f-5fcd-bb63-861fe1040ea8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{2}-16x-8=0" :db/id #edb/ref 17592186293721} {:answer/id #uuid "f7afe0ce-d392-5bc0-8fdd-9a850ab8beec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{2}-2x+4=0" :db/id #edb/ref 17592186293900}] :answer-field/correct {:answer/id #uuid "a7fc5ffa-e73f-568f-8fcc-6c7ef5303257" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{2}+8x+16=0" :db/id #edb/ref 17592186293596} :answer-field/id #uuid "7ced79ac-f453-56c8-9912-7f811ed8d885" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294370}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "132a855d-cb67-58ff-b1b4-66591e373ee1" :question/math-academy-id "q-28273" :question/problem "A quadratic equation in the variable $x$ with real coefficients has a root $x=-1+\\sqrt{3}\\text{i}.$ Given that the coefficient of ${x}^{2}$ in the equation is $4$, find the equation." :question/worked-solution "Since the quadratic equation has real coefficients and $x=-1+\\sqrt{3}\\text{i}$ is a root, its conjugate $x=-1-\\sqrt{3}\\text{i}$ must also be a root. Therefore, using the zero product property, we can write a quadratic equation with the required roots as follows:\n\n$$\n(x-(-1+\\sqrt{3}\\text{i}))(x-(-1-\\sqrt{3}\\text{i}))=0\n$$\n\nBy expanding the parentheses, we can write the equation in standard form as follows:\n\n$$\n\\begin{aligned}{x}^{2}-x(-1-\\sqrt{3}\\text{i})-x(-1+\\sqrt{3}\\text{i})+(-1-\\sqrt{3}\\text{i})(-1+\\sqrt{3}\\text{i}) & =0 \\\\ {x}^{2}+x+\\sqrt{3}x\\text{i}+x-\\sqrt{3}x\\text{i}+1-3{\\text{i}}^{2} & =0 \\\\ {x}^{2}+2x+1+3 & =0 \\\\ {x}^{2}+2x+4 & =0\\end{aligned}\n$$\n\nThis equation has roots $x=-1\\pm \\sqrt{3}\\text{i},$ but the coefficient of ${x}^{2}$ is not $4.$ Therefore, to find the desired equation, we multiply the equation above by $4.$ This gives\n\n$$\n\\begin{aligned}4({x}^{2}+2x+4) & =0 \\\\ 4{x}^{2}+8x+16 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295268 :knowledge-point/_questions [{:db/id #edb/ref 17592186110601 :knowledge-point/id #uuid "6f3d7d62-686b-59c4-9ea1-695c6be3180b" :knowledge-point/title "Determining Unknown Parameters Given Two Perpendicular Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55f88508-da2b-5f50-bc9a-a9d26b49e411" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186293282} {:answer/id #uuid "a5105cfc-01bb-5d42-a770-d43d047ecbd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186293581} {:answer/id #uuid "c8156b99-af7d-5f7b-b0a7-f383c4b1a5c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{15}" :db/id #edb/ref 17592186293707} {:answer/id #uuid "c91b613b-66f6-5d95-9a11-12d165d11100" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186293713} {:answer/id #uuid "f1ecb80b-49f9-59d8-9960-66dfad7c060e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{15}" :db/id #edb/ref 17592186293875}] :answer-field/correct {:answer/id #uuid "c8156b99-af7d-5f7b-b0a7-f383c4b1a5c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{15}" :db/id #edb/ref 17592186293707} :answer-field/id #uuid "e2a93840-02de-536d-9650-a5ee63bece85" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294727}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fe99c4a9-356e-5f86-a2a8-a7dd24fba9f7" :question/math-academy-id "q-28328" :question/problem "Given that the lines $y=5qx+9$ and $y=-3x-8$ are perpendicular, what is the value of $q?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nBoth lines are slope-intercept form, and the slope is the $x$-coefficient. \n\n- The slope of the line $y=5qx+9$ is $5q.$\n\n- The slope of the line $y=-3x-8$ is $-3.$\n\nMultiplying the slopes together, we have\n\n$$\n5q\\cdot (-3)=-1\\,⟹\\,q=\\frac{1}{15}.\n$$"}] [{:db/id #edb/ref 17592186295269 :knowledge-point/_questions [{:db/id #edb/ref 17592186110600 :knowledge-point/id #uuid "e732f270-1d6f-5ff8-8792-d9b329ea858d" :knowledge-point/title "Determining Whether Two Lines in Standard Form are Perpendicular"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96da5639-b1ab-5764-ba59-7e12ce5f9525" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{2}{5}x+4" :db/id #edb/ref 17592186293524} {:answer/id #uuid "c3c3ebe1-76b4-534e-ac97-16940002c63a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{2}{5}x-\\frac{3}{2}" :db/id #edb/ref 17592186293692} {:answer/id #uuid "d426e426-55ae-5a3a-aa02-c573670e3364" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{5}{2}x-4" :db/id #edb/ref 17592186293751} {:answer/id #uuid "d741d61c-f686-5e74-9421-30cd24022c0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{2}x+\\frac{16}{5}" :db/id #edb/ref 17592186293765} {:answer/id #uuid "fcbe027c-6c76-580a-9173-eaad9074aa07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{5}{2}x+\\frac{12}{5}" :db/id #edb/ref 17592186293920}] :answer-field/correct {:answer/id #uuid "d426e426-55ae-5a3a-aa02-c573670e3364" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{5}{2}x-4" :db/id #edb/ref 17592186293751} :answer-field/id #uuid "9c87e56a-6a3b-50b2-a894-d68a942d6fc2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294494}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7542d07b-ac7a-53fd-84e7-5ac011364c8c" :question/math-academy-id "q-28338" :question/problem "Which of the following lines is perpendicular to $4x+10y=20?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nTo find the slope of the given line $4x+10y=20,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}4x+10y & =20 \\\\ 10y & =-4x+20 \\\\ y & =-\\frac{4}{10}x+\\frac{20}{10} \\\\ y & =-\\frac{2}{5}x+2\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope of the given line is $-\\frac{2}{5}.$\n\nLooking at the answer choices, the line $y=\\frac{5}{2}x-4$ has a slope of $\\frac{5}{2}.$\n\nMultiplying the slopes together, we have\n\n$$\n(-\\frac{2}{5})\\cdot \\frac{5}{2}=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=\\frac{5}{2}x-4$ is perpendicular to the given line."}]}
