30a6ec1f877e0f2add2bf109bc54506e4b6c9e44a7b5019d2.png" :db/id #edb/ref 17592186390523} {:answer/id #uuid "fd28d0fd-5ee9-586e-ade7-f559ef7573ec" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bb/bbdfe3e538e840385c082f16ca2cdfd07a7731c561d05cab6e7a25f487cdf463.png" :db/id #edb/ref 17592186390524} {:answer/id #uuid "be9702e6-d21c-5c09-a96e-1267b5361dc9" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/cd/cd11656e3dae8a4976b1051a135b4bead1e5afc4beb21fa7541571892a037500.png" :db/id #edb/ref 17592186390525} {:answer/id #uuid "35b1a419-9084-5fab-a034-b69305bdd882" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/66/6674add26b7a15f5b09c53a832d649979484f0ffd41b440069dd5230cd9a5187.png" :db/id #edb/ref 17592186390526} {:answer/id #uuid "724df295-2359-5b8b-ab62-27d9d0e10f5e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a3/a30938f3d3af2fd70a0ee9498d7d99973d5386f062f22aaa8a028e9e18b3fb57.png" :db/id #edb/ref 17592186390527}] :answer-field/correct {:answer/id #uuid "be9702e6-d21c-5c09-a96e-1267b5361dc9" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/cd/cd11656e3dae8a4976b1051a135b4bead1e5afc4beb21fa7541571892a037500.png" :db/id #edb/ref 17592186390525} :answer-field/id #uuid "9cb7b8b6-ddf5-57db-b6c9-dfd64245bb49" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390522}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5100b042-b82c-5834-8756-fafba09daf0e" :question/math-academy-id "q-26815" :question/problem "Which of the following is the graph of $y={6}^{x}-0.75?$" :question/worked-solution "First, we plot the graph of $y={6}^{x}:$\n\n![](images/29/29d270676a48f4cf40625ef3ec50b0323c9c99389b2a7d080881727eda28de56.png)\n\nTo sketch the graph of $y={6}^{x}-0.75,$ we take the graph of $y={6}^{x}$ and shift it $0.75$ units down. The $y$-intercept moves from $(0,1)$ to $(0,0.25),$ and the horizontal asymptote moves from $y=0$ to $y=-0.75.$\n\n![](images/3b/3b141be99e5c01c70d6f6f04f4adf06741f1dc0fcef80c73b52e3dba1ae44a87.png)"}] [{:db/id #edb/ref 17592186292685 :knowledge-point/_questions [{:db/id #edb/ref 17592186059674 :knowledge-point/id #uuid "4c898bbf-004c-5905-a0a0-761adefc8bd8" :knowledge-point/title "Finding Exact Value of a Trigonometric Expression Using the Double-Angle Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "078b25eb-c753-58c4-a8bb-c23711fdad11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186290671} {:answer/id #uuid "7908b470-d7ec-55b9-b4ab-b86372edd49a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186291145} {:answer/id #uuid "820532c3-42ff-5bba-a8ac-2af534fa5f77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186291181} {:answer/id #uuid "9fdbc26c-f0b1-58b7-b55e-4663ee54eccb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186291327} {:answer/id #uuid "fcc2c5b1-4056-55a7-8817-839d1d89caec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2+\\sqrt{3}}{2}" :db/id #edb/ref 17592186291707}] :answer-field/correct {:answer/id #uuid "820532c3-42ff-5bba-a8ac-2af534fa5f77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186291181} :answer-field/id #uuid "d670500b-2a4c-531d-a949-3190b98d3ea6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292387}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "83f3d502-62d9-5e1b-a7be-52d9144a4c16" :question/math-academy-id "q-26907" :question/problem "Find the exact value of ${(\\operatorname{sin}⁡({105}^{∘})+\\operatorname{cos}⁡({105}^{∘}))}^{2}.$" :question/worked-solution "First, we expand the parenthesis and use the Pythagorean identity.\n\n$$\n\\begin{aligned}{(\\operatorname{sin}⁡({105}^{∘})+\\operatorname{cos}⁡({105}^{∘}))}^{2} & ={sin}^{2}⁡({105}^{∘})+2\\operatorname{sin}⁡({105}^{∘})\\operatorname{cos}⁡({105}^{∘})+{cos}^{2}⁡({105}^{∘}) \\\\  & =[{sin}^{2}⁡({105}^{∘})+{cos}^{2}⁡({105}^{∘})]+2\\operatorname{sin}⁡({105}^{∘})\\operatorname{cos}⁡({105}^{∘}) \\\\  & =1+2\\operatorname{sin}⁡({105}^{∘})\\operatorname{cos}⁡({105}^{∘})\\end{aligned}\n$$\n\nNow, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x={105}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡({105}^{∘})\\operatorname{cos}⁡({105}^{∘}) & =\\operatorname{sin}⁡(2\\cdot {105}^{∘}) \\\\  & =\\operatorname{sin}⁡({210}^{∘}) \\\\  & =\\operatorname{sin}⁡({180}^{∘}+{30}^{∘}) \\\\  & =-\\operatorname{sin}⁡({30}^{∘}) \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$\n\nHence, we obtain\n\n$$\n1+2\\operatorname{sin}⁡({105}^{∘})\\operatorname{cos}⁡({105}^{∘})=1-\\frac{1}{2}=\\frac{1}{2}.\n$$\n\nTherefore, we conclude that\n\n$$\n{(\\operatorname{sin}⁡({105}^{∘})+\\operatorname{cos}⁡({105}^{∘}))}^{2}=\\frac{1}{2}.\n$$"}] [{:db/id #edb/ref 17592186292696 :knowledge-point/_questions [{:db/id #edb/ref 17592186176047 :knowledge-point/id #uuid "542df339-5020-5680-a39c-a1ae161083e7" :knowledge-point/title "Describing Properties of the Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "043c68c8-e391-5780-a3ff-6d80dc52b081" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186290656} {:answer/id #uuid "931ab8d4-be2c-5e4d-92d6-fc6433eec3f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186291265} {:answer/id #uuid "9767e111-d1e9-5924-9dc2-6f58d60a1d5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186291290} {:answer/id #uuid "bb01b60e-6bb3-5d81-89d4-9256edcd3ff6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186291443} {:answer/id #uuid "d869766d-8d2f-5348-b322-4dd0c0dc459d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186291536}] :answer-field/correct {:answer/id #uuid "043c68c8-e391-5780-a3ff-6d80dc52b081" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186290656} :answer-field/id #uuid "c15b4588-e9b5-5b8e-af3b-02394e3239c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292328}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "69137884-05b3-53be-9c7c-95b53b1ed329" :question/math-academy-id "q-27009" :question/problem "Which of the following statements are true regarding the function $y=cos⁡x?$ \n\n- The function intersects the $x$-axis at $x=\\frac{\\pi }{2}.$\n- The function has a minimum value at  $x=2\\pi .$\n- The function intersects the $y$-axis at $y=0.$" :question/worked-solution "Let's plot the graph of $y=cos⁡x.$\n\n![](images/9c/9c77bec4ebb04668fbff5176418ed9c09143a8660879fdf523a158c5f109006c.png)\n\nLet's go through each statement.\n\n- Statement I is true. At $x=\\frac{\\pi }{2}$ the function intersects the $x$-axis.\n\n- Statement II is false. The function has a maximum at $x=2\\pi .$\n\n- Statement III is false. The function intersects the $y$-axis at $y=1.$"}] [{:db/id #edb/ref 17592186292697 :knowledge-point/_questions [{:db/id #edb/ref 17592186068855 :knowledge-point/id #uuid "db6e4cf3-803a-5942-9ce0-7047942e078a" :knowledge-point/title "Computing an Arcsine Integral by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1377c96f-21fc-51fb-8305-3bcbd43e0831" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\pi " :db/id #edb/ref 17592186290712} {:answer/id #uuid "1a0db884-e2e8-5bb9-91dd-6d41ae5f204f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{3}" :db/id #edb/ref 17592186290741} {:answer/id #uuid "50ebd29b-208a-5d56-90e2-e4954122c36c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186290978} {:answer/id #uuid "8ffa1fa3-01fa-5458-83f4-d55488f88570" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\pi " :db/id #edb/ref 17592186291250} {:answer/id #uuid "c89344f3-53f2-5536-af33-917ad134ae7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186291494}] :answer-field/correct {:answer/id #uuid "8ffa1fa3-01fa-5458-83f4-d55488f88570" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\pi " :db/id #edb/ref 17592186291250} :answer-field/id #uuid "1e1f01e4-776e-5a83-8671-70533062147c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291848}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b1a15b56-fccd-50eb-8563-117b4ea3220a" :question/math-academy-id "q-270103" :question/problem "Evaluate the integral ${\\int }_{-6-\\sqrt{6}}^{-6+\\sqrt{6}}\\frac{15}{\\sqrt{-12-x(x+12)}}\\,\\text{d}x.$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}-12-x(x+12) & =-12-({x}^{2}+12x) \\\\  & =-12-({x}^{2}+12x+36-36) \\\\  & =-12-((x+6)^{2}-36) \\\\  & =24-(x+6)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\begin{aligned}{\\int }_{-6-\\sqrt{6}}^{-6+\\sqrt{6}}\\frac{15}{\\sqrt{-12-x(x+12)}}\\,\\text{d}x & ={\\int }_{-6-\\sqrt{6}}^{-6+\\sqrt{6}}\\frac{15}{\\sqrt{24-(x+6)^{2}}}\\,\\text{d}x \\\\  & ={\\int }_{-6-\\sqrt{6}}^{-6+\\sqrt{6}}\\frac{15}{\\sqrt{24(1-(x+6)^{2}/24)}}\\,\\text{d}x \\\\  & ={\\int }_{-6-\\sqrt{6}}^{-6+\\sqrt{6}}\\frac{15}{\\sqrt{24}\\cdot \\sqrt{1-(x+6)^{2}/(2\\sqrt{6})^{2}}}\\,\\text{d}x \\\\  & =\\frac{15}{2\\sqrt{6}}{\\int }_{-6-\\sqrt{6}}^{-6+\\sqrt{6}}\\frac{1}{\\sqrt{1-((x+6)/2\\sqrt{6})^{2}}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse sine:\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(\\frac{x+6}{2\\sqrt{6}}).$\n\nSo, let's perform the substitution\n\n$$\nu=\\frac{x+6}{2\\sqrt{6}}.\n$$\n\nDifferentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2\\sqrt{6}}\\,⟹\\,\\text{d}x=2\\sqrt{6}\\,\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $-6-\\sqrt{6}$ | $-6+\\sqrt{6}$ |\n| --- | --- | --- |\n| $u$ | $-\\frac{1}{2}$ | $\\frac{1}{2}$ |\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-6-\\sqrt{6}}^{-6+\\sqrt{6}}\\frac{15}{\\sqrt{-12-x(x+12)}}\\,\\text{d}x & =\\frac{15}{2\\sqrt{6}}{\\int }_{-6-\\sqrt{6}}^{-6+\\sqrt{6}}\\frac{1}{\\sqrt{1-((x+6)/2\\sqrt{6})^{2}}}\\,\\text{d}x \\\\  & =\\frac{15}{2\\sqrt{6}}{\\int }_{-1/2}^{1/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot 2\\sqrt{6}\\,\\text{d}u. \\\\  & =15{\\int }_{-1/2}^{1/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =15\\operatorname{arcsin}⁡u\\,{|}_{-1/2}^{1/2} \\\\  & =15(\\operatorname{arcsin}⁡(\\frac{1}{2})-\\operatorname{arcsin}⁡(-\\frac{1}{2})) \\\\  & =15(\\frac{\\pi }{6}-(-\\frac{\\pi }{6})) \\\\  & =5\\pi .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186055187 :knowledge-point/_questions [{:db/id #edb/ref 17592186054754 :knowledge-point/id #uuid "a186b166-928c-5bad-a996-3bdf6af419f5" :knowledge-point/title "Solving a Quadratic Inequality Using the Sign Table Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6edce2b1-4a27-55cc-b790-5b7035f56f10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-5)\\cup (2,\\infty )" :db/id #edb/ref 17592186291108} {:answer/id #uuid "8e6aca7e-2c26-5ac1-ad8f-f26fea188d58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,2)\\cup (5,\\infty )" :db/id #edb/ref 17592186291244} {:answer/id #uuid "a0fcb44c-262e-57ad-8f5a-95eb76595b87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-2,5)" :db/id #edb/ref 17592186291334} {:answer/id #uuid "c0e240d4-f67f-53a1-917a-1652485d6081" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-2)\\cup (5,\\infty )" :db/id #edb/ref 17592186291462} {:answer/id #uuid "da78814f-36ea-5458-8651-4b37fc6c9f9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-5,2)" :db/id #edb/ref 17592186291546}] :answer-field/correct {:answer/id #uuid "c0e240d4-f67f-53a1-917a-1652485d6081" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-2)\\cup (5,\\infty )" :db/id #edb/ref 17592186291462} :answer-field/id #uuid "204f716b-5c4a-54ac-ac8d-6cc04dca8468" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291854}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7824abae-ac0a-561f-a7e4-242996de64c9" :question/math-academy-id "q-27068" :question/problem "For which values of $x$ is ${x}^{2}-3x-10>0?$" :question/worked-solution "First, let's factor the left-hand side of the inequality:\n\n$$\n\\begin{aligned}{x}^{2}-3x-10 & >0 \\\\ (x+2)(x-5) & >0\\end{aligned}\n$$\n\nNext, we find the roots of the corresponding equation $(x+2)(x-5)=0.$ The roots are $x=-2$ and $x=5,$ and they split the number line into the $3$ intervals $(-\\infty ,-2),$ $(-2,5),$ and $(5,\\infty ).$\n\nNow, we construct a sign table with the list of the intervals on the top and the list of factors on the left. Filling in the sign table using the usual method, we get the following result:\n\n|  | $(-\\infty ,-2)$ | $(-2,5)$ | $(5,\\infty )$ |\n| --- | --- | --- | --- |\n| $x+2$ | $-$ | $+$ | $+$ |\n| $x-5$ | $-$ | $-$ | $+$ |\n| $(x+2)(x-5)$ | $(-)\\cdot (-)=+$ | $(+)\\cdot (-)=-$ | $(+)\\cdot (+)=+$ |\n\nFinally, to solve the quadratic inequality $(x+2)(x-5)>0,$ we look at the bottom row to find out where the expression $(x+2)(x-5)$ is positive.\n\nWe see that the expression is positive on the intervals $(-\\infty ,-2)\\cup (5,\\infty ).$ \n\nTherefore, we conclude that ${x}^{2}-3x-10>0$ for all $x\\in (-\\infty ,-2)\\cup (5,\\infty ).$"}] [{:db/id #edb/ref 17592186055189 :knowledge-point/_questions [{:db/id #edb/ref 17592186054754 :knowledge-point/id #uuid "a186b166-928c-5bad-a996-3bdf6af419f5" :knowledge-point/title "Solving a Quadratic Inequality Using the Sign Table Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31b90582-7492-541f-a422-a2ab4f6931f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-3,4]" :db/id #edb/ref 17592186290833} {:answer/id #uuid "4d187d1c-3040-5dd4-8232-8928c0010654" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-3]\\cup [4,\\infty )" :db/id #edb/ref 17592186290959} {:answer/id #uuid "62cd106e-503e-5f0f-a812-7e330a9b4ac9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [3,4]" :db/id #edb/ref 17592186291054} {:answer/id #uuid "b69c52f4-8b11-5492-9898-5b48aeef799f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-4,3]" :db/id #edb/ref 17592186291421} {:answer/id #uuid "ce74bdfc-ed7d-5aed-ac88-c87e81a912a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,3]\\cup [4,\\infty )" :db/id #edb/ref 17592186291508}] :answer-field/correct {:answer/id #uuid "31b90582-7492-541f-a422-a2ab4f6931f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-3,4]" :db/id #edb/ref 17592186290833} :answer-field/id #uuid "1252b4f0-0f19-5e91-821d-a4efb9cf7cf5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291797}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3d81bc42-8840-5c1f-ae63-83e13f8b6083" :question/math-academy-id "q-27071" :question/problem "For which values of $x$ is $3{x}^{2}-3x-36\\le 0?$" :question/worked-solution "First, let's factor the left-hand side of the inequality:\n\n$$\n\\begin{aligned}3{x}^{2}-3x-36 & \\le 0 \\\\ 3({x}^{2}-x-12) & \\le 0 \\\\ 3(x+3)(x-4) & \\le 0\\end{aligned}\n$$\n\nNext, we find the roots of the corresponding equation $(x+3)(x-4)=0.$ The roots are $x=-3$ and $x=4,$ and they split the number line into the $3$ subintervals $(-\\infty ,-3),$ $(-3,4),$ and $(4,\\infty ).$\n\nNow, we construct a sign table with the list of the intervals on the top and the list of factors on the left. Filling in the sign table using the usual method, we get the following result:\n\n|  | $(-\\infty ,-3)$ | $(-3,4)$ | $(4,\\infty )$ |\n| --- | --- | --- | --- |\n| $x+3$ | $-$ | $+$ | $+$ |\n| $x-4$ | $-$ | $-$ | $+$ |\n| $(x+3)(x-4)$ | $(-)\\cdot (-)=+$ | $(+)\\cdot (-)=-$ | $(+)\\cdot (+)=+$ |\n\nFinally, to solve the quadratic inequality $3(x+3)(x-4)\\le 0,$ we look at the bottom row to find out where the expression $3(x+3)(x-4)$ is zero or negative.\n\nWe see that the expression is negative on the interval $(-3,4).$ Also, we know that the expression equals $0$ at the points $x=-3$ and $x=4.$\n\nTherefore, we conclude that $(x+3)(x-4)\\le 0$ for all $x\\in [-3,4].$"}] [{:db/id #edb/ref 17592186292705 :knowledge-point/_questions [{:db/id #edb/ref 17592186054755 :knowledge-point/id #uuid "dc018e0e-60bc-59bd-a3f6-8ae2b68f8cfb" :knowledge-point/title "Solving an Inequality by Rearranging Terms and Using the Sign Table Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b599f1e-71ef-5dac-88a7-d7a6b8c88246" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-5]\\cup [2,\\infty )" :db/id #edb/ref 17592186290686} {:answer/id #uuid "5983021d-f7e6-5a87-8334-04f37b819ac3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-5]\\cup [-2,\\infty )" :db/id #edb/ref 17592186291013} {:answer/id #uuid "5ece811e-cbe1-5481-a31c-64331b0fbbd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-2,5]" :db/id #edb/ref 17592186291037} {:answer/id #uuid "b9450f33-d113-5ab4-ada4-d129af5dc260" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-5,2]" :db/id #edb/ref 17592186291435} {:answer/id #uuid "f1fc084f-3385-55c7-b348-c2cb4cc3ba37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,2]\\cup [5,\\infty )" :db/id #edb/ref 17592186291650}] :answer-field/correct {:answer/id #uuid "0b599f1e-71ef-5dac-88a7-d7a6b8c88246" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-5]\\cup [2,\\infty )" :db/id #edb/ref 17592186290686} :answer-field/id #uuid "51429ea0-f26a-52cb-9d46-1c28f1950ae2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291986}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "28268741-19ff-50b9-9cfe-fa406e7a681a" :question/math-academy-id "q-27073" :question/problem "For which values of $x$ is $5{x}^{2}+25x-53\\ge 10x-3?$" :question/worked-solution "First, we rewrite the given inequality so that the right-hand side equals zero. Then, we factor the left-hand side:\n\n$$\n\\begin{aligned}5{x}^{2}+25x-53 & \\ge 10x-3 \\\\ 5{x}^{2}+15x-50 & \\ge 0 \\\\ 5({x}^{2}+3x-10) & \\ge 0 \\\\ 5(x+5)(x-2) & \\ge 0\\end{aligned}\n$$\n\nNext, we find the roots of the corresponding equation $5(x+5)(x-2)=0.$ The roots are $x=-5$ and $x=2,$ and they split the number line into $3$ subintervals $(-\\infty ,-5),$ $(-5,2),$ and $(2,\\infty ).$\n\nNow, we construct a sign table with the list of the intervals on the top and the list of factors on the left. Filling in the sign table using the usual method, we get the following result:\n\n|  | $(-\\infty ,-5)$ | $(-5,2)$ | $(2,\\infty )$ |\n| --- | --- | --- | --- |\n| $x+5$ | $-$ | $+$ | $+$ |\n| $x-2$ | $-$ | $-$ | $+$ |\n| $5(x+5)(x-2)$ | $+$ | $-$ | $+$ |\n\nFinally, to solve the quadratic inequality $5(x+5)(x-2)\\ge 0,$ we look at the bottom row to find out where the expression $5(x+5)(x-2)$ is zero or positive.\n\nWe see that the expression is positive on the intervals $(-\\infty ,-5)$ and $(2,\\infty ).$ Also, we know that the expression equals $0$ at the points $x=-5$ and $x=2.$\n\nTherefore, we conclude that $5{x}^{2}+25x-53\\ge 10x-3$ for all $x\\in (-\\infty ,-5]\\cup [2,\\infty ).$"}] [{:db/id #edb/ref 17592186390531 :knowledge-point/_questions [{:db/id #edb/ref 17592186068829 :knowledge-point/id #uuid "5bb394c3-cd7c-523d-88df-b1306d9d528f" :knowledge-point/title "Identifying a Vertically Shifted Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5145dde8-60d2-54b7-ad8d-2892ff5d3963" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a4/a4161037f51b8c4d95037c3ff28d7e6afecb354d4e0fabc22e5dd819bb65b6cc.png" :db/id #edb/ref 17592186390533} {:answer/id #uuid "6680ac81-034b-5243-a46f-e14b15ca391f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a4/a4511ffac1899bdeb512b0b50b50b6a121477f486ef7e2efc83697fd9dddb8d2.png" :db/id #edb/ref 17592186390534} {:answer/id #uuid "2d7b451c-b477-571c-b8f0-b6b471ddf99b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/95/953bb642696a6b9c934627f978d150d27adbc7f73779a3d017c2ba714ff0835e.png" :db/id #edb/ref 17592186390535} {:answer/id #uuid "6fd2d67a-323e-5832-a842-a36b0a6fce73" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d6/d6034af21a31fdfdbaff6760ab5dd97bb227d0538a475aef9e5c14a1559e16b1.png" :db/id #edb/ref 17592186390536} {:answer/id #uuid "3fbecea5-be5b-5a1e-bd55-ff4ec8267187" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/df/df2b0819dabd55db60af06fecb52e19a013b471ab632484d4066ef5e011ccfe5.png" :db/id #edb/ref 17592186390537}] :answer-field/correct {:answer/id #uuid "3fbecea5-be5b-5a1e-bd55-ff4ec8267187" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/df/df2b0819dabd55db60af06fecb52e19a013b471ab632484d4066ef5e011ccfe5.png" :db/id #edb/ref 17592186390537} :answer-field/id #uuid "fe628ffa-6fae-5342-9742-f9cf2475f662" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390532}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4cf19722-da75-5d66-8864-81b9e6bc4f1a" :question/math-academy-id "q-27477" :question/problem "Which of the following is the graph of  $y={(\\frac{1}{10})}^{x}-\\frac{1}{10}?$" :question/worked-solution "First we plot the graph of $y={(\\frac{1}{10})}^{x}:$\n\n![](images/f0/f02afa6dd2d1c107fd72b1221fddb7f6c698506deb834cad0dc11af1bebb18e6.png)\n\nNext, we shift this graph $\\frac{1}{10}$ units down. \nThe horizontal asymptote under such a transformation becomes $y=-\\frac{1}{10},$ the $y$-intercept becomes $(0,\\frac{9}{10}).$\nThe resulting graph of $y={(\\frac{1}{10})}^{x}-\\frac{1}{10}$ is shown below.\n\n![](images/57/57539870ff45bae449d3ad7c11580d9c8068cfe76ac98c2f849ee38494288036.png)"}] [{:db/id #edb/ref 17592186401915 :knowledge-point/_questions [{:db/id #edb/ref 17592186068900 :knowledge-point/id #uuid "66ade855-4b16-514b-b44a-1d6b9d61ef28" :knowledge-point/title "Identifying the Shift Applied to an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c3666f3-ba98-51a9-b678-f25e043d3a37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}+3.5" :db/id #edb/ref 17592186401917} {:answer/id #uuid "e8039e0c-f293-5ce4-b395-a4064a0685bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}-2.5" :db/id #edb/ref 17592186401918} {:answer/id #uuid "a5f24666-89d0-5332-bb2a-21f966094be5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}-3.5" :db/id #edb/ref 17592186401919} {:answer/id #uuid "a479a80c-f0e1-5b4f-9f67-06b99cd086bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}+1.5" :db/id #edb/ref 17592186401920} {:answer/id #uuid "266f8f59-63e6-5980-a4b9-749b4fb8201c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}+2.5" :db/id #edb/ref 17592186401921}] :answer-field/correct {:answer/id #uuid "266f8f59-63e6-5980-a4b9-749b4fb8201c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}+2.5" :db/id #edb/ref 17592186401921} :answer-field/id #uuid "828a7f8a-1289-571e-8aa4-3a396be14d44" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401916}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6948e752-4360-51fe-b06f-c6885f4f282f" :question/math-academy-id "q-27482" :question/problem "![](images/c0/c091fc5d742ddca3090725974f00ff7da77b1530d601bb82e288518b27970b0a.png)\n\nThe graph above shows the curve $y={(\\frac{1}{9})}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={(\\frac{1}{9})}^{x}$ is $y=0.$\n\nThe vertical translation $y={(\\frac{1}{9})}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=2.5.$ Therefore, $c=2.5.$"}] [{:db/id #edb/ref 17592186292804 :knowledge-point/_questions [{:db/id #edb/ref 17592186064163 :knowledge-point/id #uuid "e901ea71-aeab-5e95-939e-2401558aa708" :knowledge-point/title "Finding the Global Extrema of a Function on a Given Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2225758d-8dde-578c-a547-500b65f253b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186290778} {:answer/id #uuid "3d7ed184-a058-5189-a723-395001836891" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186290887} {:answer/id #uuid "5a80c147-1f17-5590-baeb-78228c37c97c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186291023} {:answer/id #uuid "7bb02329-a57e-526d-989d-b162a90d0227" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186291154} {:answer/id #uuid "db46b9ef-b0f7-5c48-b877-de4aa36c374a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186291549}] :answer-field/correct {:answer/id #uuid "7bb02329-a57e-526d-989d-b162a90d0227" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186291154} :answer-field/id #uuid "26b8e670-86de-53ef-b5db-4451381e1cb4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291869}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2a126432-a7f1-5215-9a02-985aac25ece8" :question/math-academy-id "q-2751" :question/problem "Find the global maximum value of the function $f(x)=\\sqrt{x}$ on the closed interval $4\\le x\\le 9.$" :question/worked-solution "Let's apply the candidates test step by step.\n\n**Step 1**: We find the critical points. Taking the derivative of $f(x)=\\sqrt{x},$ we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{1}{2\\sqrt{x}}.\\end{aligned}\n$$\n\nWe can see that ${f}^{′}(x)>0$ for all $x>0.$ So there is no solution for ${f}^{′}(x)=0.$\n\nSo, the only critical points are the endpoints $x=4,9$ (since the derivative is not defined at the endpoints).\n\n**Step 2**: We evaluate $f(x)$ at the critical points.\n\n$$\n\\begin{aligned}f(4) & =\\sqrt{4}=2 \\\\ f(9) & =\\sqrt{9}=3\\end{aligned}\n$$\n\n**Step 3**: We compare all of the values found in step $2.$\n\n- The greatest value is $f(9)=3,$ so the global maximum is $3.$\n\n- The least value is $f(4)=2,$ so the global minimum is $2.$\n\n![](images/c8/c8badccb8144447b5b57157308b5614293a54569f8247320a358dd20650d91a1.png)"}] [{:db/id #edb/ref 17592186390538 :knowledge-point/_questions [{:db/id #edb/ref 17592186068830 :knowledge-point/id #uuid "617f0fe6-7998-5d77-b11f-55a0eca11440" :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11991a9d-264d-57e7-9fdd-da7348694651" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/77/77ddeefbcbd24c80f6ed0bb7a29d2a43e3151436b0a60b56686b1c67ca31c738.png" :db/id #edb/ref 17592186390540} {:answer/id #uuid "f32fd0b0-49ce-539d-9672-8d020e261fbb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f7/f73be44a90c4a240b316bcf7ac5586b54ed1ca4cdedfac42f055cd39086ffe2d.png" :db/id #edb/ref 17592186390541} {:answer/id #uuid "407fad6c-67c3-5a63-bb5b-a49d0b7c8b56" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f4/f405cfe76e1d69d7ecad35e96ced1c76c1b64130a118d881d331bcb0b119068c.png" :db/id #edb/ref 17592186390542} {:answer/id #uuid "a9519e6c-79f2-5f62-a983-2670eb2a7aba" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/33/33f78e0590a7039f0e2e17d5bc871e0503dd3526d282b5fb76e4ef0f3b78cc28.png" :db/id #edb/ref 17592186390543} {:answer/id #uuid "29d4d4e8-fe84-544d-8606-3bfce7839133" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9d/9d332fa8d3d8ef65daaf34bf906c5ca7cd7e2edaf562386ed4e0ebc4555b0a64.png" :db/id #edb/ref 17592186390544}] :answer-field/correct {:answer/id #uuid "29d4d4e8-fe84-544d-8606-3bfce7839133" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9d/9d332fa8d3d8ef65daaf34bf906c5ca7cd7e2edaf562386ed4e0ebc4555b0a64.png" :db/id #edb/ref 17592186390544} :answer-field/id #uuid "49a74683-a726-5cb6-b2c2-b253e72cf78d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390539}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b5e7ffcf-d49d-5dfe-9c73-ca9c0369ba7d" :question/math-academy-id "q-27538" :question/problem "Which of the following is the graph of  $y=3{(\\frac{1}{6})}^{x}-1?$" :question/worked-solution "We start with plotting the graph of $y={(\\frac{1}{6})}^{x}:$\n\n![](images/4c/4cdc9e4fa78513bca01fa10242ba6c3f12b31c262448a8edf350c76e84b188b8.png)\n\nNext, we plot the graph of $y=3{(\\frac{1}{6})}^{x}.$ To do this, we scale the graph above by a factor of $3.$ The $y$-intercept moves from $(0,1)$ to $(0,3)$ but the horizontal asymptote stays at $y=0.$\n\n![](images/8e/8e7d6c5eb931f55a9f94ac33382c0e1ec9e9e49f50b3ab538d9848d6a77be665.png)\n\nFinally, we plot the graph of $y=3{(\\frac{1}{6})}^{x}-1.$ To do this, we shift the above graph $1$ unit down. The $y$-intercept moves from $(0,3)$ to $(0,2)$ and the horizontal asymptote moves from $y=0$ to $y=-1.$\n\n![](images/9d/9d332fa8d3d8ef65daaf34bf906c5ca7cd7e2edaf562386ed4e0ebc4555b0a64.png)"}] [{:db/id #edb/ref 17592186390545 :knowledge-point/_questions [{:db/id #edb/ref 17592186068830 :knowledge-point/id #uuid "617f0fe6-7998-5d77-b11f-55a0eca11440" :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f70e31a-a6d8-57be-8930-fe9e46798cf1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e5/e545a84145ac0a139ee5ecdf9692c20837d211f9a70fd79ad33dd13f60c856f7.png" :db/id #edb/ref 17592186390547} {:answer/id #uuid "3dd43261-0c67-5dec-abd5-e030f8c694d1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f6/f63e49a2e8f4a0702841eb132093bf6f69b8405af25719ea8f5abbf2bd691122.png" :db/id #edb/ref 17592186390548} {:answer/id #uuid "c08648ea-dc6d-5578-89fa-a0be944fb62c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c6/c64e79b7c0069aaf7d4393a6879612f58f48103247b1ba7efef3531dc3986b93.png" :db/id #edb/ref 17592186390549} {:answer/id #uuid "84311dad-8f82-5f9c-ab3a-b304e0b27aae" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/57/571e2268e6b7f41e80b71c8764d321c298fe58232e5b4c5a84ce309fa0dd3530.png" :db/id #edb/ref 17592186390550} {:answer/id #uuid "8b546f29-cf64-542e-8f37-af2b900bcda8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3d/3d7af2718ba7c30956218a00da51e77db950183bd2a85dbe74107e493fd5f03b.png" :db/id #edb/ref 17592186390551}] :answer-field/correct {:answer/id #uuid "0f70e31a-a6d8-57be-8930-fe9e46798cf1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e5/e545a84145ac0a139ee5ecdf9692c20837d211f9a70fd79ad33dd13f60c856f7.png" :db/id #edb/ref 17592186390547} :answer-field/id #uuid "b29207c3-5e76-521f-8c52-fed97e9cf151" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390546}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ab17c05b-3a04-5ac4-9de0-6246c2badd83" :question/math-academy-id "q-27540" :question/problem "Which of the following is the graph of $y=\\frac{1}{2}{(\\frac{1}{4})}^{x}-3?$" :question/worked-solution "We start with plotting the graph of $y={(\\frac{1}{4})}^{x}:$\n\n![](images/e6/e648e3a5f0c844d6596d4848629c3e6749647228116bcc5da6fce250895141d5.png)\n\nNext, we plot the graph of $y=\\frac{1}{2}{(\\frac{1}{4})}^{x}.$ To do this, we scale the graph above by a factor of $\\frac{1}{2}.$ The $y$-intercept moves from $(0,1)$ to $(0,\\frac{1}{2})$ but the horizontal asymptote stays at $y=0.$\n\n![](images/37/378016bbd17371e3dfee1e80934e76b1357139d405cb320ac5befa252da82b28.png)\n\nFinally, we plot the graph of $y=\\frac{1}{2}{(\\frac{1}{4})}^{x}-3.$ To do this, we shift the above graph $3$ units down. The $y$-intercept moves from $(0,\\frac{1}{2})$ to $(0,-\\frac{5}{2})$ and the horizontal asymptote moves from $y=0$ to $y=-3.$\n\n![](images/e5/e545a84145ac0a139ee5ecdf9692c20837d211f9a70fd79ad33dd13f60c856f7.png)"}] [{:db/id #edb/ref 17592186292928 :knowledge-point/_questions [{:db/id #edb/ref 17592186184334 :knowledge-point/id #uuid "d88d6dd3-9da2-5bad-a373-7c62c3004b8b" :knowledge-point/title "Solving Quadratic “Or Equal To” Inequalities That Require Rearrangement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54d12cb1-0a5a-5c38-97b8-4d54f5aa860d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-1]\\cup [\\frac{3}{2},\\infty )" :db/id #edb/ref 17592186290995} {:answer/id #uuid "5cd78dac-f955-5375-bb59-91aaa1c937a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-\\frac{5}{2},1]" :db/id #edb/ref 17592186291028} {:answer/id #uuid "5fd6265f-10b4-537d-9516-c33843fa420f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-\\frac{3}{2}]\\cup [1,\\infty )" :db/id #edb/ref 17592186291040} {:answer/id #uuid "92c88b41-d059-5525-9e1c-d910a3361572" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-1,\\frac{3}{2}]" :db/id #edb/ref 17592186291262} {:answer/id #uuid "a4a4b0f4-a605-5247-974e-025a7c5f9ade" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-\\frac{5}{2},\\frac{3}{2}]" :db/id #edb/ref 17592186291351}] :answer-field/correct {:answer/id #uuid "92c88b41-d059-5525-9e1c-d910a3361572" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-1,\\frac{3}{2}]" :db/id #edb/ref 17592186291262} :answer-field/id #uuid "757c6c46-429b-5897-854b-5908ad50a2ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292100}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6f9899c6-d34d-5a73-a0f2-23d88f582629" :question/math-academy-id "q-276407" :question/problem "Find the solution of $x+3\\ge 2{x}^{2}.$" :question/worked-solution "To solve this inequality using the graphical method, we first need to move all of the numbers to the left-hand side so that the right-hand side is $0.$ \n\n$$\n\\begin{aligned}x+3 & \\ge 2{x}^{2} \\\\ -2{x}^{2}+x+3 & \\ge 0.\\end{aligned}\n$$\n\nSo, we want to find the values of $x$ for which the parabola $y=-2{x}^{2}+x+3$ lies **above** the $x$-axis or touches this axis. Let's find the roots of the parabola by factoring:\n\n$$\n\\begin{aligned}-2{x}^{2}+x+3 & =0 \\\\ 2{x}^{2}-x-3 & =0 \\\\ (2{x}^{2}-3x)+(2x-3) & =0 \\\\ x(2x-3)+(2x-3) & =0 \\\\ (x+1)(2x-3) & =0 \\\\ 2(x+1)(x-\\frac{3}{2}) & =0\\end{aligned}\n$$\n\nWe see that the roots are $x=-1$ and $x=\\frac{3}{2},$ and we can graph the parabola as follows:\n\n![](images/86/86d7fbea75961bdb83c014ca9febb735e6a1745f71e8e094de416998b2072630.png)\n\nSince we are interested in solving \n\n$$\n-2{x}^{2}+x+3\\ge 0,\n$$\n\n \nwe look for the part of the parabola that is **above** the $x$-axis or touches this axis. \n\nBased on the graph, the solution is $-1\\le x\\le \\frac{3}{2}.$\n\nUsing interval notation, we write $x\\in [-1,\\frac{3}{2}].$"}] [{:db/id #edb/ref 17592186294980 :knowledge-point/_questions [{:db/id #edb/ref 17592186115336 :knowledge-point/id #uuid "6a916099-a237-5612-b7f1-3679b7ff069d" :knowledge-point/title "Calculating an Unknown Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "250975f6-1855-51d4-855b-4756eab86379" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{30}^{∘}" :db/id #edb/ref 17592186293090} {:answer/id #uuid "74682fc2-217c-57f5-ab98-c931310e5466" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{18}^{∘}" :db/id #edb/ref 17592186293411} {:answer/id #uuid "7d0ac39b-3059-5c95-9035-fede9601ced2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{15}^{∘}" :db/id #edb/ref 17592186293433} {:answer/id #uuid "c8f82474-ac34-5dcf-9935-8a82efc05435" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{20}^{∘}" :db/id #edb/ref 17592186293712} {:answer/id #uuid "e390ae5f-9602-5bc0-bd7b-333ec91cd6ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{25}^{∘}" :db/id #edb/ref 17592186293825}] :answer-field/correct {:answer/id #uuid "c8f82474-ac34-5dcf-9935-8a82efc05435" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{20}^{∘}" :db/id #edb/ref 17592186293712} :answer-field/id #uuid "5dff0f5f-38be-5491-8c48-4be6dc5f48b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294264}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "94753d7f-95e4-5b39-9c21-ede7ecea7547" :question/math-academy-id "q-27832" :question/problem "![](images/66/6665784a8ce048fd26fbd97038346e8e6fdf6800d645ea0488f1c18986f5864b.png)\n\nConsider the triangle $△ABC$ shown above. The line segment $\\overset{―}{CH}$ is the altitude corresponding to $\\overset{―}{AB}.$ If $m∠BAC={110}^{∘},$ calculate $m∠HCA.$" :question/worked-solution "Since the straight angle must have a measure of ${180}^{∘},$ we have\n\n$$\n\\begin{aligned}m∠HAC+m∠BAC & ={180}^{∘} \\\\ m∠HAC+{110}^{∘} & ={180}^{∘} \\\\ m∠HAC & ={70}^{∘}.\\end{aligned}\n$$\n\nNote that $△ACH$ is a right triangle. Since its interior angles must sum to ${180}^{∘},$ we have\n\n$$\n\\begin{aligned}m∠HCA+m∠HAC+m∠AHC & ={180}^{∘} \\\\ m∠HCA+{70}^{∘}+{90}^{∘} & ={180}^{∘} \\\\ m∠HCA+{160}^{∘} & ={180}^{∘} \\\\ m∠HCA & ={20}^{∘}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295017 :knowledge-point/_questions [{:db/id #edb/ref 17592186054752 :knowledge-point/id #uuid "4b23c4da-7a8d-5076-a4e9-8bcde40bc088" :knowledge-point/title "Completing a Table of Signs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "106fb349-820a-5251-96ec-f4b08bb679f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186293004} {:answer/id #uuid "2343b405-bae0-509d-a49e-904f44bca880" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186293081}] :answer-field/correct {:answer/id #uuid "2343b405-bae0-509d-a49e-904f44bca880" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186293081} :answer-field/id #uuid "08b8eff7-0142-5b4f-9af9-4d3f76d36f53" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186293952} {:answer-field/choices [{:answer/id #uuid "037bdf92-391c-5583-ae6c-87ba5fc0121d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186292948} {:answer/id #uuid "c528fbff-0cfb-59b0-9361-4227766dbcbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186293698}] :answer-field/correct {:answer/id #uuid "c528fbff-0cfb-59b0-9361-4227766dbcbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 1759