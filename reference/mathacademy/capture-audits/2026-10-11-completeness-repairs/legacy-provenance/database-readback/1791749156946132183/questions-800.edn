17592186279034} {:answer/id #uuid "381d375a-d282-5558-af67-c3f309ae7ea8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{2}+n\\pi " :db/id #edb/ref 17592186279080} {:answer/id #uuid "64e63cbb-8403-5bbf-a00e-fae8cd3dad71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=n\\frac{\\pi }{2}" :db/id #edb/ref 17592186279509} {:answer/id #uuid "e0ad06ee-b6ca-5ac4-b103-4ef2e8096fc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{2}+2n\\pi " :db/id #edb/ref 17592186280579}] :answer-field/correct {:answer/id #uuid "e0ad06ee-b6ca-5ac4-b103-4ef2e8096fc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{2}+2n\\pi " :db/id #edb/ref 17592186280579} :answer-field/id #uuid "f7af4244-b19c-5140-981a-ed78c0638c37" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281275}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d9834690-2d79-5a22-9e52-3ff6dc17940f" :question/math-academy-id "q-16227" :question/problem "What is the general solution to the equation $\\operatorname{sin}⁡x=1?$ Assume that $n$ is an integer." :question/worked-solution "First, we find the principal value:\n\n$$\n{x}_{1}=\\operatorname{arcsin}⁡(1)=\\frac{\\pi }{2}\n$$\n\nThe sine function has a period of $2\\pi .$ Hence, the general solution for the given equation is\n\n$$\nx=\\frac{\\pi }{2}+2n\\pi .\n$$"}] [{:db/id #edb/ref 17592186389284 :knowledge-point/_questions [{:db/id #edb/ref 17592186087788 :knowledge-point/id #uuid "ffddeaa7-a247-54b0-af4b-a29d9bbeee6a" :knowledge-point/title "Finding the Maclaurin Expansion of a Sum of Functions Using Standard Maclaurin Expansions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "124f214f-d111-5270-8f5a-99d12cd7c085" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(2x)+\\operatorname{cos}⁡(x)=1+2x-2{x}^{2}-\\frac{4{x}^{3}}{3}+⋯" :db/id #edb/ref 17592186389286} {:answer/id #uuid "a3f8991a-ae24-560d-aaad-e0f0da3a2a44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(2x)+\\operatorname{cos}⁡(x)=1+2x-\\frac{{x}^{2}}{2}-\\frac{8{x}^{3}}{3}+⋯" :db/id #edb/ref 17592186389287} {:answer/id #uuid "a3ffedca-2ff3-52db-bf69-7683ee3d3b9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(2x)+\\operatorname{cos}⁡(x)=1+4x-\\frac{{x}^{2}}{2}-\\frac{4{x}^{3}}{3}+⋯" :db/id #edb/ref 17592186389288} {:answer/id #uuid "2557177c-b9c2-5021-9849-d0b2d282ff54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(2x)+\\operatorname{cos}⁡(x)=1+2x-2{x}^{2}-\\frac{8{x}^{3}}{3}+⋯" :db/id #edb/ref 17592186389289} {:answer/id #uuid "ab5f74b7-8408-5d07-a163-73944c92bf19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(2x)+\\operatorname{cos}⁡(x)=1+2x-\\frac{{x}^{2}}{2}-\\frac{4{x}^{3}}{3}+⋯" :db/id #edb/ref 17592186389290}] :answer-field/correct {:answer/id #uuid "ab5f74b7-8408-5d07-a163-73944c92bf19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(2x)+\\operatorname{cos}⁡(x)=1+2x-\\frac{{x}^{2}}{2}-\\frac{4{x}^{3}}{3}+⋯" :db/id #edb/ref 17592186389290} :answer-field/id #uuid "9eadffca-ae05-5f18-bf56-b5c8a1797f1e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389285}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a566bf55-85d0-5a70-9fbb-f45650b09aa0" :question/math-academy-id "q-16230" :question/problem "Find the first four non-zero terms of the Maclaurin expansion of $\\operatorname{sin}⁡(2x)+\\operatorname{cos}⁡(x).$" :question/worked-solution "The Maclaurin expansion of $\\operatorname{sin}⁡(x)$ is\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x) & =x-\\frac{{x}^{3}}{3!}+\\frac{{x}^{5}}{5!}-⋯.\\end{aligned}\n$$\n\nReplacing $x$ with $2x$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(2x) & =(2x)-\\frac{(2x)^{3}}{3!}+\\frac{(2x)^{5}}{5!}-⋯ \\\\  & =2x-\\frac{{2}^{3}{x}^{3}}{6}+\\frac{{2}^{5}{x}^{5}}{120}-⋯ \\\\  & =2x-\\frac{4{x}^{3}}{3}+\\frac{4{x}^{5}}{15}-⋯.\\end{aligned}\n$$\n\nThe Maclaurin expansion of $\\operatorname{cos}⁡x$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡x & =1-\\frac{{x}^{2}}{2!}+\\frac{{x}^{4}}{4!}-⋯.\\end{aligned}\n$$\n\nAdding the expansions for $\\operatorname{sin}⁡(2x)$ and $\\operatorname{cos}⁡(x),$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(2x)+\\operatorname{cos}⁡(x) & =(2x-\\frac{4{x}^{3}}{3}+\\frac{4{x}^{5}}{15}-⋯)+(1-\\frac{{x}^{2}}{2!}+\\frac{{x}^{4}}{4!}-⋯) \\\\  & =1+2x-\\frac{{x}^{2}}{2}-\\frac{4{x}^{3}}{3}+⋯.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186389291 :knowledge-point/_questions [{:db/id #edb/ref 17592186171914 :knowledge-point/id #uuid "0c2c755c-59e0-5048-b20c-507f13fce441" :knowledge-point/title "Geometric Interpretation of the Roots of Unity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36267af7-3b1c-53e8-8254-4652eb19b61b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/51/51ac4ad5bbc626c58ddbb6efd8c06bb665ef0849591dd846dd959756ea6e41b6.png" :db/id #edb/ref 17592186389293} {:answer/id #uuid "ae188fc3-ca39-5ffc-ab80-585fcf2025f0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/73/73ac4fabf63cec9e0639bd2213bf2c4df4030ae0c143e0747ebde469418459d6.png" :db/id #edb/ref 17592186389294} {:answer/id #uuid "c2b96a31-29a9-5690-9d1f-f4a0e63422a3" :answer/type {: