d #edb/ref 17592186176059 :knowledge-point/id #uuid "d4b378b0-30e5-59a8-b9f7-882b5e226a2e" :knowledge-point/title "Utilizing the Evenness Property of the Secant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "038a1bc6-e647-59b6-aaa7-d35e90993bc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{8}" :db/id #edb/ref 17592186266176} {:answer/id #uuid "1d7c73d5-90cc-5170-965c-525cdbc8308d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186266399} {:answer/id #uuid "3a3b8949-b671-5cf2-bbef-476092a89eb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186266656} {:answer/id #uuid "bdb40afd-ce8b-5929-b1b9-111a96d60fa4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186267848} {:answer/id #uuid "f750f91c-c511-5f89-913b-c6b563802807" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186268335}] :answer-field/correct {:answer/id #uuid "f750f91c-c511-5f89-913b-c6b563802807" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186268335} :answer-field/id #uuid "e028f60d-3a78-5cef-a248-395baca88d6e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268803}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a2a3460c-5045-59bc-aae3-13b2bea30fac" :question/math-academy-id "q-136631" :question/problem "If $sec⁡a=-8,$ then $sec⁡(-a)=$" :question/worked-solution "First, let's recall the graph of $y=sec⁡x.$\n\n![](images/fb/fbf6ef1ca91f998ab4dc2dda1890ffc8a713f2eeff19e5569351b2466256d63a.png)\n\nNotice that our graph is symmetric about the $y$-axis. If we reflect the graph about the $y$-axis, we get the same picture. This means that $sec⁡x$ is an *even* function, and we have\n\n$$\nsec⁡(-x)=sec⁡x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}sec⁡(-a) & =sec⁡a \\\\  & =-8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186269132 :knowledge-point/_questions [{:db/id #edb/ref 17592186176058 :knowledge-point/id #uuid "66a1733a-d7bb-5c86-a154-9e54422053a7" :knowledge-point/title "Utilizing the Oddness Property of the Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "378e1e66-9bf4-50e3-a7c1-262bf4e92781" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186266624} {:answer/id #uuid "3ef10c28-e626-5937-ba80-feb997f872b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186266707} {:answer/id #uuid "4b3e15ed-e7b6-5ea7-b9ed-17bf737d8274" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{5}" :db/id #edb/ref 17592186266811} {:answer/id #uuid "c3857dc6-9f35-5def-8ee2-c64c55acc069" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}" :db/id #edb/ref 17592186267889} {:answer/id #uuid "d30ef100-9315-5778-b153-4a1a0a22e9d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{5}" :db/id #edb/ref 17592186268026}] :answer-field/correct {:answer/id #uuid "4b3e15ed-e7b6-5ea7-b9ed-17bf737d8274" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{5}" :db/id #edb/ref 17592186266811} :answer-field/id #uuid "d4a81cb7-756d-567d-b8be-538028bb5ed2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268787}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b5606ff1-4177-5d4b-892b-30b0ba862cf3" :question/math-academy-id "q-136639" :question/problem "If $tan⁡a=\\frac{4}{5},$ then $tan⁡(-a)=$" :question/worked-solution "First, let's recall the graph of $y=tan⁡x.$\n\n![](images/df/df1aba3f5ff980de82a74dde8170ad708e379caf2188873bcddc83177e87c7a6.png)\n\nOur graph has rotational symmetry of order $2$ about the origin. If we rotate the graph ${180}^{∘}$ around the origin, we get the same picture. This means that $tan⁡x$ is an *odd* function, and we have\n\n$$\ntan⁡(-x)=-tan⁡x.\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}tan⁡(-a) & =-tan⁡a \\\\  & =-\\frac{4}{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184471 :knowledge-point/_questions [{:db/id #edb/ref 17592186184352 :knowledge-point/id #uuid "114e3660-63d9-511d-b89c-e71081ffa1e5" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "037f04c8-ba6f-5b6c-8fa9-0c6883765bb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15}{2}" :db/id #edb/ref 17592186266175} {:answer/id #uuid "4d76620b-4c1e-5237-a48c-f056d6dc9063" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186266833} {:answer/id #uuid "5079f712-46dd-55b7-8b26-77e72f0df867" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡3" :db/id #edb/ref 17592186266859} {:answer/id #uuid "50f90dfe-d802-574a-8ed8-759b5057b926" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186266869} {:answer/id #uuid "57c0df91-f04f-5221-8066-bed8410acb39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3" :db/id #edb/ref 17592186266928}] :answer-field/correct {:answer/id #uuid "50f90dfe-d802-574a-8ed8-759b5057b926" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186266869} :answer-field/id #uuid "db7fea76-3c9e-5620-891f-f29f43564753" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268797}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8b4cba33-ddfb-53fe-af87-4270187c1909" :question/math-academy-id "q-13751" :question/problem "Evaluate the integral ${\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡3}}5x{e}^{{x}^{2}}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u={x}^{2}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $\\sqrt{\\operatorname{ln}⁡3}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\operatorname{ln}⁡3$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡3}}5x{e}^{{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡3}}5{e}^{{x}^{2}}\\cdot x\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\operatorname{ln}⁡3}5{e}^{u}\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{5}{2}{\\int }_{0}^{\\operatorname{ln}⁡3}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{5}{2}{e}^{u}\\,{|}_{0}^{\\operatorname{ln}⁡3} \\\\  & =\\frac{5}{2}({e}^{\\operatorname{ln}⁡3}-{e}^{0}) \\\\  & =\\frac{5}{2}(3-1) \\\\  & =\\frac{5}{2}(2) \\\\  & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186101141 :knowledge-point/_questions [{:db/id #edb/ref 17592186100875 :knowledge-point/id #uuid "1f2f5234-df9c-5269-8702-30b4dde9a2ca" :knowledge-point/title "Multiplying a Matrix by the Identity Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8561cf7d-5905-51f0-afa8-dfa160c2a666" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The product is undefined" :db/id #edb/ref 17592186098182} {:answer/id #uuid "9d75e31c-6d5f-5ff7-bfb7-9af46b05c952" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 0 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186098183} {:answer/id #uuid "b04ab11c-1e23-5a8a-ace9-0a5b7e812fa6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & -3 \\\\ -1 & -2\\end{bmatrix}" :db/id #edb/ref 17592186098184} {:answer/id #uuid "d9147d52-f2e7-5bda-9f5b-fe0aae8f7137" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186098185} {:answer/id #uuid "730c731f-1318-55a0-8381-b58852458731" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 3 \\\\ 1 & 2\\end{bmatrix}" :db/id #edb/ref 17592186098186}] :answer-field/id #uuid "eb3b92a3-f788-5f9e-bc32-c27df022209b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186098181} {:answer-field/choices [{:answer/id #uuid "a3819a4e-2124-51a9-966d-a232f795727b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & -3 \\\\ -1 & -2\\end{aligned}]" :db/id #edb/ref 17592186388506} {:answer/id #uuid "e5497e19-b13b-5352-a486-89ae75f2fe36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 3 \\\\ 1 & 2\\end{aligned}]" :db/id #edb/ref 17592186388507} {:answer/id #uuid "1524532d-303c-57e8-baaa-e00f625a908a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186388508} {:answer/id #uuid "f505e5ac-8344-5745-ab05-6ca6bf802e47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The product is undefined" :db/id #edb/ref 17592186388509} {:answer/id #uuid "5e6230bd-503c-59b4-8461-692f556f4ea7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 0 \\\\ 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186388510}] :answer-field/correct {:answer/id #uuid "e5497e19-b13b-5352-a486-89ae75f2fe36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 3 \\\\ 1 & 2\\end{aligned}]" :db/id #edb/ref 17592186388507} :answer-field/id #uuid "4bf67a40-3ab5-50a6-9561-e2ee6d875a8b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388505}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "612ed9a2-f644-5c99-b797-cab8e5ee69a6" :question/math-academy-id "q-13762" :question/problem "Calculate the product ${I}_{2}B$ given that ${I}_{2}$ is the $2\\times 2$ identity matrix and\n$B=[\\begin{aligned}2 & 3 \\\\ 1 & 2\\end{aligned}].$" :question/worked-solution "Any matrix, when multiplied by an identity matrix, remains unchanged (assuming that the multiplication is well defined).\n\nThe matrix ${I}_{2}$ is a $2\\times 2$ matrix and $B$ is a $2\\times 2$ matrix too. \n\nTherefore, the multiplication is well defined and \n\n$$\n{I}_{2}\\cdot B=B=[\\begin{aligned}2 & 3 \\\\ 1 & 2\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186269150 :knowledge-point/_questions [{:db/id #edb/ref 17592186096655 :knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e" :knowledge-point/title "Integrating the Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fbe1e45-425c-5d24-9a2e-b0d2bc2b4422" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{100}{9}" :db/id #edb/ref 17592186266423} {:answer/id #uuid "222530ab-2dcc-5d51-9809-57c96320b41e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{100}{81}" :db/id #edb/ref 17592186266449} {:answer/id #uuid "5f41e2cc-d2de-56ef-80d2-9ac7568a671c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10}{27}" :db/id #edb/ref 17592186266986} {:answer/id #uuid "7daa41e8-6e90-5e70-8402-bd9770caa41f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{80}{9}" :db/id #edb/ref 17592186267255} {:answer/id #uuid "a3c299e5-a721-5088-944a-c9d0c0bc8ecf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{40}{81}" :db/id #edb/ref 17592186267617}] :answer-field/correct {:answer/id #uuid "222530ab-2dcc-5d51-9809-57c96320b41e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{100}{81}" :db/id #edb/ref 17592186266449} :answer-field/id #uuid "a01b2373-b791-524c-ae21-c98d1b57c90b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268689}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6e36897b-696c-54c5-85d9-3c04b5f56902" :question/math-academy-id "q-13786" :question/problem "${\\int }_{0}^{\\operatorname{ln}⁡3}5{e}^{-4x}\\,\\text{d}x=$" :question/worked-solution "If we let $u=-4x,$ then, \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-4\\,⟹\\,-\\frac{1}{4}\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $\\operatorname{ln}⁡3$ |\n| --- | --- | --- |\n| $u$ | $0$ | $-4\\operatorname{ln}⁡3$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\operatorname{ln}⁡3}5{e}^{-4x}\\,\\text{d}x & =5{\\int }_{0}^{\\operatorname{ln}⁡3}{e}^{-4x}\\,\\text{d}x \\\\  & =5{\\int }_{0}^{-4\\operatorname{ln}⁡3}{e}^{u}(-\\frac{1}{4})\\text{d}u \\\\  & =-\\frac{5}{4}{\\int }_{0}^{\\operatorname{ln}⁡({3}^{-4})}{e}^{u}\\text{d}u \\\\  & =-\\frac{5}{4}({e}^{u}){|}_{0}^{\\operatorname{ln}⁡({3}^{-4})} \\\\  & =-\\frac{5}{4}({e}^{\\operatorname{ln}⁡({3}^{-4})}-{e}^{0}) \\\\  & =-\\frac{5}{4}({3}^{-4}-1) \\\\  & =-\\frac{5}{4}(\\frac{1}{{3}^{4}}-1) \\\\  & =-\\frac{5}{4}(\\frac{1}{81}-1) \\\\  & =-\\frac{5}{4}(-\\frac{80}{81}) \\\\  & =\\frac{100}{81}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186269177 :knowledge-point/_questions [{:db/id #edb/ref 17592186100928 :knowledge-point/id #uuid "33159d0b-24b5-587e-89e1-b545c2be59c4" :knowledge-point/title "Finding the Second-Degree Taylor Polynomial of a Given Function About a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3dee08bf-73dd-52cc-b1a6-b41970eb1bda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-2{e}^{-1}(x-1)+{e}^{-1}(x-1)^{2}" :db/id #edb/ref 17592186266694} {:answer/id #uuid "5514914b-ead8-5c54-a2fd-a9482f1ab5d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-1}+{e}^{-1}(x-1)-2{e}^{-1}(x-1)^{2}" :db/id #edb/ref 17592186266904} {:answer/id #uuid "5a11e1a6-16e2-5029-903d-276eb5136785" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-1}-2{e}^{-1}(x-1)+{e}^{-1}(x-1)^{2}" :db/id #edb/ref 17592186266944} {:answer/id #uuid "7bba411e-075b-535f-b3eb-a968ad5458b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1+2{e}^{-1}(x-1)+4{e}^{-1}(x-1)^{2}" :db/id #edb/ref 17592186267239} {:answer/id #uuid "ad79cdf4-a151-5c68-bdab-124f9cbba034" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-1}+{e}^{-1}(x-1)+4{e}^{-1}(x-1)^{2}" :db/id #edb/ref 17592186267712}] :answer-field/correct {:answer/id #uuid "5a11e1a6-16e2-5029-903d-276eb5136785" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-1}-2{e}^{-1}(x-1)+{e}^{-1}(x-1)^{2}" :db/id #edb/ref 17592186266944} :answer-field/id #uuid "cfe3be36-04c4-5d6e-8e8f-15e4a6fc0497" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268778}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "682db2a3-d3d2-54b6-8a78-578de1c6ac8a" :question/math-academy-id "q-13817" :question/problem "The second-degree Taylor polynomial of $f(x)={e}^{-{x}^{2}}$ about $x=1$ is" :question/worked-solution "To find the second-degree Taylor polynomial about $x=1,$ we plug $a=1$ into the general formula to give\n\n$$\n{P}_{2}(x)=f(1)+{f}^{′}(1)(x-1)+\\frac{1}{2}{f}^{″}(1)(x-1)^{2}.\n$$\n\nSo, we need to work out $f(1),$ ${f}^{′}(1),$ and ${f}^{″}(1):$ \n\n$$\n\\begin{aligned}f(x) & ={e}^{-{x}^{2}} & ⟹ &  & f(1) & ={e}^{-1} \\\\ {f}^{′}(x) & =-\\,2x{e}^{-{x}^{2}} & ⟹ &  & {f}^{′}(1) & =-2{e}^{-1} \\\\ {f}^{″}(x) & =(4{x}^{2}-2){e}^{-{x}^{2}} & ⟹ &  & {f}^{″}(1) & =2{e}^{-1}\\end{aligned}\n$$\n\nWe now plug the results for $f(1),$ ${f}^{′}(1),$ and ${f}^{″}(1)$ into our second-degree Taylor polynomial. This gives\n\n$$\n\\begin{aligned}{P}_{2}(x) & ={e}^{-1}+(-2{e}^{-1})\\cdot (x-1)+(2{e}^{-1})\\cdot \\frac{1}{2}(x-1)^{2} \\\\  & ={e}^{-1}-2{e}^{-1}(x-1)+{e}^{-1}(x-1)^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186269182 :knowledge-point/_questions [{:db/id #edb/ref 17592186100818 :knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7148b847-d982-5ea4-b057-c5e42788f937" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}\\operatorname{ln}⁡(\\operatorname{ln}⁡4)" :db/id #edb/ref 17592186267138} {:answer/id #uuid "78b9a284-7918-5a48-9b63-09d2dbf15a7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186267206} {:answer/id #uuid "c324f604-f021-5ec4-97d6-e46d27f5780b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}\\operatorname{ln}⁡4" :db/id #edb/ref 17592186267886} {:answer/id #uuid "f349a50e-2135-5759-85b8-7bfb21768dc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{ln}⁡(\\operatorname{ln}⁡4)" :db/id #edb/ref 17592186268308} {:answer/id #uuid "f3e8bc1f-2171-58ab-a46f-699ee9e27a89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(\\operatorname{ln}⁡4)" :db/id #edb/ref 17592186268311}] :answer-field/correct {:answer/id #uuid "7148b847-d982-5ea4-b057-c5e42788f937" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}\\operatorname{ln}⁡(\\operatorname{ln}⁡4)" :db/id #edb/ref 17592186267138} :answer-field/id #uuid "a5268c76-ac42-5d62-8149-d9e09487a8d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268701}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ed857a50-0096-5fa3-bea2-e4ec1bd8cccb" :question/math-academy-id "q-13845" :question/problem "What is the value of ${\\int }_{1}^{e/4}\\frac{1}{4x\\operatorname{ln}⁡(4x)}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(4x).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{4x}\\cdot 4=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $e/4$ |\n| --- | --- | --- |\n| $u$ | $\\operatorname{ln}⁡4$ | $1$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e/4}\\frac{1}{4x\\operatorname{ln}⁡(4x)}\\,\\text{d}x & =\\frac{1}{4}{\\int }_{1}^{e/4}\\frac{1}{\\operatorname{ln}⁡(4x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{4}{\\int }_{\\operatorname{ln}⁡4}^{1}\\frac{1}{u}\\cdot \\text{d}u \\\\  & =\\frac{1}{4}(\\operatorname{ln}⁡|u|){|}_{\\operatorname{ln}⁡4}^{1} \\\\  & =\\frac{1}{4}(\\operatorname{ln}⁡1-\\operatorname{ln}⁡(\\operatorname{ln}⁡4)) \\\\  & =\\frac{1}{4}(0-\\operatorname{ln}⁡(\\operatorname{ln}⁡4)) \\\\  & =-\\frac{1}{4}\\operatorname{ln}⁡(\\operatorname{ln}⁡4)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186400750 :knowledge-point/_questions [{:db/id #edb/ref 17592186059736 :knowledge-point/id #uuid "733eab11-2a26-5402-8df5-bba50c9beaf9" :knowledge-point/title "Calculating the Cross Product Using Determinants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86f43fbb-95b7-541f-8b6c-884210699c13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨10,-2,30⟩" :db/id #edb/ref 17592186400752} {:answer/id #uuid "3b6022ff-41cc-5e6f-94c9-3fc31db2cbb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨10,14,30⟩" :db/id #edb/ref 17592186400753} {:answer/id #uuid "45ff73b4-62a8-5ce3-88c9-d43c398f4a6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-10,2,30⟩" :db/id #edb/ref 17592186400754} {:answer/id #uuid "904fd9b0-d482-5093-afb0-55078a667399" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨10,-14,30⟩" :db/id #edb/ref 17592186400755} {:answer/id #uuid "f884e2c3-8624-5ca1-87bf-175fa491b5ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨10,2,30⟩" :db/id #edb/ref 17592186400756}] :answer-field/correct {:answer/id #uuid "86f43fbb-95b7-541f-8b6c-884210699c13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨10,-2,30⟩" :db/id #edb/ref 17592186400752} :answer-field/id #uuid "6f171d5e-1ede-583a-b2ab-a54f8c858c3a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400751}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f2ea4789-04ff-53b9-83f0-42f591cf2261" :question/math-academy-id "q-1393" :question/problem "Let $u=⟨4,5,-1⟩$ and $v=⟨-6,0,2⟩.$ Find $u\\times v.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =|\\begin{aligned}i & j & k \\\\ 4 & 5 & -1 \\\\ -6 & 0 & 2\\end{aligned}| \\\\  & =|\\begin{aligned}5 & -1 \\\\ 0 & 2\\end{aligned}|i-|\\begin{aligned}4 & -1 \\\\ -6 & 2\\end{aligned}|j+|\\begin{aligned}4 & 5 \\\\ -6 & 0\\end{aligned}|k \\\\  & =(5\\cdot 2-(-1)\\cdot 0)i-(4\\cdot 2-(-1)\\cdot (-6))j+(4\\cdot 0-5\\cdot (-6))k \\\\  & =(10-0)i-(8-6)j+(0-(-30))k \\\\  & =10i-2j+30k.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186269219 :knowledge-point/_questions [{:db/id #edb/ref 17592186100878 :knowledge-point/id #uuid "288e49b0-f706-54de-86b7-a17248fe2408" :knowledge-point/title "Calculating the Area of the Parallelogram Spanned by Two Non-Parallel Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "186ee2ac-da11-5516-b903-e3b5e9480103" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186266346} {:answer/id #uuid "303f5039-136f-57c4-95b6-e45427ec1075" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186266570} {:answer/id #uuid "3d1f355e-f850-51c9-9c2a-fb7bc5bbb357" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186266684} {:answer/id #uuid "92a8e1d3-8eda-5c2f-9bb2-70ec28082ba2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186267452} {:answer/id #uuid "a686bd68-cab0-5c69-85ea-bad821967fe1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186267650}] :answer-field/correct {:answer/id #uuid "303f5039-136f-57c4-95b6-e45427ec1075" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186266570} :answer-field/id #uuid "ad50c151-5c0e-566c-ac0d-79838b4014d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268718}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cad6730b-4b4a-5d91-acf2-b03ce7ce4d8e" :question/math-academy-id "q-13944" :question/problem "![](images/7a/7a70285258e584708a7296a2a008536dec9c97750b48e5fe0eb2f8cb7761bed1.png)\n\nCalculate the area of the parallelogram in the figure." :question/worked-solution "From the diagram, we get the vectors\n\n$$\n\\text{u}=⟨3,2⟩,\\,\\text{v}=⟨2,-2⟩.\n$$\n\nFirst, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}3 & 2 \\\\ 2 & -2\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}3 & 2 \\\\ 2 & -2\\end{aligned}| \\\\  & =3\\cdot (-2)-2\\cdot 2 \\\\  & =-10\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|-10\\,|=10\n$$"}] [{:db/id #edb/ref 17592186269232 :knowledge-point/_questions [{:db/id #edb/ref 17592186100878 :knowledge-point/id #uuid "288e49b0-f706-54de-86b7-a17248fe2408" :knowledge-point/title "Calculating the Area of the Parallelogram Spanned by Two Non-Parallel Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d768a08-43a7-50f3-bc2c-9d0aec2d145d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "38" :db/id #edb/ref 17592186266547} {:answer/id #uuid "49c440bd-ae95-5742-ba82-03be224e0b41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186266798} {:answer/id #uuid "650a0407-08e2-55ea-afa8-98afe8bbc506" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186267039} {:answer/id #uuid "7b1ac682-0ef5-54bf-9790-851d28380cff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186267230} {:answer/id #uuid "dba30746-1bcd-5e32-976d-2a26e890257c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186268088}] :answer-field/correct {:answer/id #uuid "49c440bd-ae95-5742-ba82-03be224e0b41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186266798} :answer-field/id #uuid "d0ea674a-8479-5833-a353-9cc54ecf9166" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268781}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "19e02ca3-a6f7-5909-838c-8df1ebb7ea40" :question/math-academy-id "q-13951" :question/problem "Calculate the area of the parallelogram spanned by $\\text{u}=[\\begin{aligned}1 \\\\ -4\\end{aligned}]$ and $\\text{v}=[\\begin{aligned}5 \\\\ 3\\end{aligned}].$" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}1 & 5 \\\\ -4 & 3\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}1 & 5 \\\\ -4 & 3\\end{aligned}| \\\\  & =1\\cdot 3-5\\cdot (-4) \\\\  & =23\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|\\,23\\,|=23\n$$"}] [{:db/id #edb/ref 17592186271964 :knowledge-point/_questions [{:db/id #edb/ref 17592186087819 :knowledge-point/id #uuid "10ca3efc-7d23-5bc1-ab41-f785bed69986" :knowledge-point/title "Matrices for Route Planning"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "257b433d-960b-5602-9139-f0a08f725b10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186269602} {:answer/id #uuid "2912ecc2-b82b-545b-a134-0f849b9f6f10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186269638} {:answer/id #uuid "a28f67e7-b07f-5e99-99f1-6ef0ca27df71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186270719} {:answer/id #uuid "ab496260-2eb5-5f24-b36a-b5c83e218fef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186270799} {:answer/id #uuid "cee52816-3d9a-5a2d-bf35-0841387ab28c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186271084}] :answer-field/correct {:answer/id #uuid "2912ecc2-b82b-545b-a134-0f849b9f6f10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186269638} :answer-field/id #uuid "2a50b6d4-0ed8-59a9-bfe9-13d431937f58" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271588}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cf86f867-a1a5-56dc-89e8-e2255e71399b" :question/math-academy-id "q-139689" :question/problem "![](images/6c/6c52f315d079b82fb729c4ab47f210ec4bf2683d0dfe1adfe79c94db9fbc5f63.png)\n\nThe diagram above shows train routes between three stations, where nodes represent the stations and arrows represent the directed routes between them. The (incomplete) route matrix below represents information about the number of routes between each of the three stations. Find the value of $a+b+c.$\n\n|  |  | To: |  |  |\n| --- | --- | --- | --- | --- |\n|  |  | **A** | **B** | **C** |\n| From: | **A** | $1$ | $a$ | $0$ |\n| **B** | $0$ | $b$ | $2$ |  |\n| **C** | $c$ | $1$ | $0$ |  |" :question/worked-solution "Let's examine our diagram.\n\n- There is $1$ arrow starting at Station A and ending at Station B. So, there is only one route from $A$ to $B,$ and so $a=1.$\n\n- There is $1$ arrow starting at Station B and ending at Station B. So, there is only one route from $B$ to $B,$ and so $b=1.$\n\n- There are no arrows starting at Station C and ending at Station A. So, there are no routes from $C$ to $A,$ and so $c=0.$\n\nAs a result, our route matrix is the following:\n\n|  |  | To: |  |  |\n| --- | --- | --- | --- | --- |\n|  |  | **A** | **B** | **C** |\n| From: | **A** | $1$ | $1$ | $0$ |\n| **B** | $0$ | $1$ | $2$ |  |\n| **C** | $0$ | $1$ | $0$ |  |\n\nTherefore, \n\n$$\na+b+c=1+1+0=2.\n$$"}] [{:db/id #edb/ref 17592186060044 :knowledge-point/_questions [{:db/id #edb/ref 17592186059851 :knowledge-point/id #uuid "09aeb7f5-31e0-5b2d-9e2a-8eace54a6665" :knowledge-point/title "Calculating the Cross Product of Two Vectors Whose Angle Is a Non-Special Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60742969-581c-5973-8fa9-78e77a0bf094" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36n" :db/id #edb/ref 17592186270120} {:answer/id #uuid "622b545e-1af8-5ad8-944d-8f87481ebdc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27n" :db/id #edb/ref 17592186270133} {:answer/id #uuid "7cbbc011-0ab5-5321-8b62-8396249479da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "29n" :db/id #edb/ref 17592186270362} {:answer/id #uuid "84e582c4-e0ad-504a-9f91-14756ec4390b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "43n" :db/id #edb/ref 17592186270417} {:answer/id #uuid "b177a505-8449-5d54-8746-4506cea92190" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "34n" :db/id #edb/ref 17592186270854}] :answer-field/correct {:answer/id #uuid "7cbbc011-0ab5-5321-8b62-8396249479da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "29n" :db/id #edb/ref 17592186270362} :answer-field/id #uuid "ba0ffccc-6715-58cf-bae1-c7df2b05cefa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271847}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6fb7d87a-bb90-5349-a9b4-58de72e66222" :question/math-academy-id "q-1400" :question/problem "The vector $a$ has magnitude $9,$ the vector $b$ has magnitude $5,$ the angle between $a$ and $b$ is ${140}^{∘}$ and $n$ is the unit vector that points in the direction of $a\\times b.$ Find $a\\times b$ in terms of $n.$ Round your final answer to the nearest integer where appropriate." :question/requires-calculator true :question/worked-solution "We use the formula for the cross product and obtain\n\n$$\n\\begin{aligned}a\\times b & =|a|\\cdot |b|\\cdot \\operatorname{sin}⁡\\theta \\cdot n \\\\  & =9\\cdot 5\\cdot \\operatorname{sin}⁡{140}^{∘}\\cdot n \\\\  & =45\\cdot (0.642…)\\cdot n \\\\  & =(28.925…)\\cdot n \\\\  & ≈29n.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272044 :knowledge-point/_questions [{:db/id #edb/ref 17592186068874 :knowledge-point/id #uuid "bf9b812d-0dbf-5a67-9d45-3cc5e373b2b1" :knowledge-point/title "Completing the Square When the Perfect Square is Isolated: Negative Linear Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1de2e53b-3e5a-515c-aeb7-08b2b37df9ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-5{)}^{2}+1" :db/id #edb/ref 17592186269517} {:answer/id #uuid "2044f8ba-a526-5264-9c8b-279475bc6079" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+5{)}^{2}+1" :db/id #edb/ref 17592186269538} {:answer/id #uuid "4ef60e4f-a72a-5357-acf3-4233e5a280e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-25{)}^{2}+1" :db/id #edb/ref 17592186269981} {:answer/id #uuid "d1396c9b-3b30-5a34-9af3-bb9767985973" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-10{)}^{2}+1" :db/id #edb/ref 17592186271110} {:answer/id #uuid "e97a70aa-76d8-5b9c-aa63-ecd9752ccf4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+10{)}^{2}+1" :db/id #edb/ref 17592186271312}] :answer-field/correct {:answer/id #uuid "1de2e53b-3e5a-515c-aeb7-08b2b37df9ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-5{)}^{2}+1" :db/id #edb/ref 17592186269517} :answer-field/id #uuid "501bcbfe-9b64-5b29-8ec4-43efe59a3a60" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271656}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0a5ade6b-92c1-5055-8b0b-c80cbaff9d2f" :question/math-academy-id "q-140281" :question/problem "Rewrite the expression $({x}^{2}-10x+25)+1$ as the sum of a perfect square and a constant." :question/worked-solution "First, we recall the following formula:\n\n$$\n{x}^{2}-2ax+{a}^{2}=(x-a{)}^{2}\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{x}^{2}-10x+25 & = \\\\ {x}^{2}-10x+{5}^{2} & = \\\\ {x}^{2}-2\\cdot 5x+{5}^{2} & = \\\\ (x-5{)}^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({x}^{2}-10x+25)+1 & = \\\\ (x-5{)}^{2}+1 & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272045 :knowledge-point/_questions [{:db/id #edb/ref 17592186068874 :knowledge-point/id #uuid "bf9b812d-0dbf-5a67-9d45-3cc5e373b2b1" :knowledge-point/title "Completing the Square When the Perfect Square is Isolated: Negative Linear Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "098366e9-6bbf-557f-8b0b-c28f1f5c5d06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+12{)}^{2}-4" :db/id #edb/ref 17592186269356} {:answer/id #uuid "229c01ab-0ea9-5605-90a1-1d5a7751e77a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-11{)}^{2}-4" :db/id #edb/ref 17592186269568} {:answer/id #uuid "9d389434-bcbe-5f2b-ab97-000df772d7d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-12{)}^{2}-4" :db/id #edb/ref 17592186270659} {:answer/id #uuid "aa8a2c46-7cb2-59b0-9203-35410fcdd6dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-22{)}^{2}-4" :db/id #edb/ref 17592186270793} {:answer/id #uuid "b0f56343-9654-51c6-8939-85100071b4dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+11{)}^{2}-4" :db/id #edb/ref 17592186270849}] :answer-field/correct {:answer/id #uuid "229c01ab-0ea9-5605-90a1-1d5a7751e77a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-11{)}^{2}-4" :db/id #edb/ref 17592186269568} :answer-field/id #uuid "90eb344c-2847-58a2-8769-e020f945532e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271768}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ff51e775-e2b4-585e-a683-f90782853abe" :question/math-academy-id "q-140283" :question/problem "Rewrite the expression $({x}^{2}-22x+121)-4$ as the difference between a perfect square and a constant." :question/worked-solution "First, we recall the following formula:\n\n$$\n{x}^{2}-2ax+{a}^{2}=(x-a{)}^{2}\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{x}^{2}-22x+121 & = \\\\ {x}^{2}-22x+{11}^{2} & = \\\\ {x}^{2}-2\\cdot 11x+{11}^{2} & = \\\\ (x-11{)}^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({x}^{2}-22x+121)-4 & = \\\\ (x-11{)}^{2}-4 & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272058 :knowledge-point/_questions [{:db/id #edb/ref 17592186184322 :knowledge-point/id #uuid "2a85fece-e40f-543c-b3c3-ae43a5175808" :knowledge-point/title "Completing the Square When the Leading Coefficient is Negative One: Odd Linear Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "071c98e7-f045-5699-97e6-8ca98ff4c425" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{89}{4}-{(x+14)}^{2}" :db/id #edb/ref 17592186269336} {:answer/id #uuid "0b6551d7-ff9d-5fcb-9ba8-47eb76d9737a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}-{(x+\\frac{7}{2})}^{2}" :db/id #edb/ref 17592186269367} {:answer/id #uuid "92214c5a-0fb3-5f9c-b2fd-8c3a954013bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "59-{(x+14)}^{2}" :db/id #edb/ref 17592186270546} {:answer/id #uuid "b1f6b651-8575-5bc8-a027-fe8e7ce11c40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}-{(x+\\frac{7}{2})}^{2}" :db/id #edb/ref 17592186270861} {:answer/id #uuid "d730e81c-c1fd-5d3a-9ed2-255c3dad533b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{49}{4}-{(x+\\frac{7}{2})}^{2}" :db/id #edb/ref 17592186271160}] :answer-field/correct {:answer/id #uuid "0b6551d7-ff9d-5fcb-9ba8-47eb76d9737a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}-{(x+\\frac{7}{2})}^{2}" :db/id #edb/ref 17592186269367} :answer-field/id #uuid "9e101ba8-4e79-5217-9a66-13f1e2c2b19e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271788}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5f049fbc-7296-56e3-bb5f-3d51d2204d7a" :question/math-academy-id "q-140330" :question/problem "Rewrite $-({x}^{2}+7x+10)$ by completing the square." :question/worked-solution "We begin by completing the square for the expression inside the parentheses:\n\n$$\n{x}^{2}+7x+10\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}+2\\cdot \\frac{7}{2}x+10\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{7}{2})}^{2},$ writing the constant term $10$ last:\n\n$$\n{{x}^{2}+2\\cdot \\frac{7}{2}x+{(\\frac{7}{2})}^{2}}_{⏟}-{(\\frac{7}{2})}^{2}+10\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(x+\\frac{7}{2})}^{2}-{(\\frac{7}{2})}^{2}+10\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(x+\\frac{7}{2})}^{2}-\\frac{9}{4}.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-({x}^{2}+7x+10) & =-({(x+\\frac{7}{2})}^{2}-\\frac{9}{4}) \\\\  & =-{(x+\\frac{7}{2})}^{2}+\\frac{9}{4} \\\\  & =\\frac{9}{4}-{(x+\\frac{7}{2})}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272060 :knowledge-point/_questions [{:db/id #edb/ref 17592186184322 :knowledge-point/id #uuid "2a85fece-e40f-543c-b3c3-ae43a5175808" :knowledge-point/title "Completing the Square When the Leading Coefficient is Negative One: Odd Linear Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e0b9d03-98ee-5f65-8899-eb0ca3293f69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}-{(y+\\frac{9}{2})}^{2}" :db/id #edb/ref 17592186269682} {:answer/id #uuid "51675449-e3ed-5d32-a5a1-dc181d745b38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{161}{4}-{(y-\\frac{9}{2})}^{2}" :db/id #edb/ref 17592186269997} {:answer/id #uuid "64001e55-d244-54a8-918a-a1c0059b44a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}-{(y+\\frac{9}{2})}^{2}" :db/id #edb/ref 17592186270154} {:answer/id #uuid "88d86ace-1240-59e6-93cf-c53adca2f146" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "61-{(y+18)}^{2}" :db/id #edb/ref 17592186270450} {:answer/id #uuid "e002a466-5bda-58b6-b497-ea8df55b4790" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}-{(y+\\frac{9}{2})}^{2}" :db/id #edb/ref 17592186271234}] :answer-field/correct {:answer/id #uuid "2e0b9d03-98ee-5f65-8899-eb0ca3293f69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}-{(y+\\frac{9}{2})}^{2}" :db/id #edb/ref 17592186269682} :answer-field/id #uuid "19597342-b978-5e00-8333-b2a8755a3138" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271554}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6187e130-749f-5a82-add1-d28e2491c294" :question/math-academy-id "q-140333" :question/problem "Rewrite $-({y}^{2}+9y+20)$ by completing the square." :question/worked-solution "We begin by completing the square for the expression inside the parentheses:\n\n$$\n{y}^{2}+9y+20\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}+2\\cdot \\frac{9}{2}y+20\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{9}{2})}^{2},$ writing the constant term $20$ last:\n\n$$\n{{y}^{2}+2\\cdot \\frac{9}{2}y+{(\\frac{9}{2})}^{2}}_{⏟}-{(\\frac{9}{2})}^{2}+20\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(y+\\frac{9}{2})}^{2}-{(\\frac{9}{2})}^{2}+20\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(y+\\frac{9}{2})}^{2}-\\frac{1}{4}.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-({y}^{2}+9y+20) & =-({(y+\\frac{9}{2})}^{2}-\\frac{1}{4}) \\\\  & =-{(y+\\frac{9}{2})}^{2}+\\frac{1}{4} \\\\  & =\\frac{1}{4}-{(y+\\frac{9}{2})}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184484 :knowledge-point/_questions [{:db/id #edb/ref 17592186184212 :knowledge-point/id #uuid "3202d7cc-541b-553b-8ec1-d4ea85dd0590" :knowledge-point/title "Completing the Square on an Expression With a Negative Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2441e55c-3656-5b9c-9444-a562a3ff3b87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{(z-\\frac{1}{3})}^{2}+10" :db/id #edb/ref 17592186269586} {:answer/id #uuid "4f3faa2d-7189-540c-8002-572e91da81bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{(z+\\frac{1}{3})}^{2}+5" :db/id #edb/ref 17592186269984} {:answer/id #uuid "82317f98-eb55-5a2a-84b7-c0fc441aa39a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{(z-\\frac{1}{3})}^{2}-8" :db/id #edb/ref 17592186270394} {:answer/id #uuid "ca440db9-063c-5ec8-89e2-7e47d8b1e800" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{(z+\\frac{1}{3})}^{2}+10" :db/id #edb/ref 17592186271044} {:answer/id #uuid "f37d3db7-779c-579c-a14f-a3675bd5b658" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{(z+\\frac{1}{3})}^{2}+8" :db/id #edb/ref 17592186271404}] :answer-field/correct {:answer/id #uuid "ca440db9-063c-5ec8-89e2-7e47d8b1e800" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{(z+\\frac{1}{3})}^{2}+10" :db/id #edb/ref 17592186271044} :answer-field/id #uuid "02be3ebb-ff12-5196-b096-96eac16ef254" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271509}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2495fc0b-8e76-56e1-bf72-c223c52c4fc2" :question/math-academy-id "q-140378" :question/problem "Rewrite $-9{z}^{2}-6z+9$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $-9.$ So, we take out a factor of $-9$ from the entire expression:\n\n$$\n-9({z}^{2}+\\frac{2}{3}z-1)\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{z}^{2}+\\frac{2}{3}z-1\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{z}^{2}+2\\cdot \\frac{1}{3}\\cdot z-1\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{1}{3})}^{2},$ writing the constant term $1$ last:\n\n$$\n{{z}^{2}+2\\cdot \\frac{1}{3}\\cdot z+{(\\frac{1}{3})}^{2}}_{⏟}-{(\\frac{1}{3})}^{2}-1\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(z+\\frac{1}{3})}^{2}-{(\\frac{1}{3})}^{2}-1\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(z+\\frac{1}{3})}^{2}-\\frac{10}{9}.\n$$\n\nFinally, we substitute this result back into our original expression::\n\n$$\n\\begin{aligned}-9({z}^{2}+\\frac{2}{3}z-1) & =-9({(z+\\frac{1}{3})}^{2}-\\frac{10}{9}) \\\\  & =-9{(z+\\frac{1}{3})}^{2}+(-9)\\cdot (-\\frac{10}{9}) \\\\  & =-9{(z+\\frac{1}{3})}^{2}+10\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272081 :knowledge-point/_questions [{:db/id #edb/ref 17592186184322 :knowledge-point/id #uuid "2a85fece-e40f-543c-b3c3-ae43a5175808" :knowledge-point/title "Completing the Square When the Leading Coefficient is Negative One: Odd Linear Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d854445-4b9d-5457-8fdd-3e9aafaf84c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{45}{4}-{(y-10)}^{2}" :db/id #edb/ref 17592186269970} {:answer/id #uuid "6c18b098-7360-5163-a283-eff16352c701" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{4}-{(y-\\frac{5}{2})}^{2}" :db/id #edb/ref 17592186270231} {:answer/id #uuid "89f2f572-b7c1-5dea-a169-978a09aab668" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}+{(y-\\frac{5}{2})}^{2}" :db/id #edb/ref 17592186270461} {:answer/id #uuid "aa2bcef6-9c81-5bea-950e-d8b1ddb76848" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20-{(y-10)}^{2}" :db/id #edb/ref 17592186270787} {:answer/id #uuid "ed555ea6-dfea-51d4-876e-75d752688105" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}-{(y-\\frac{5}{2})}^{2}" :db/id #edb/ref 17592186271354}] :answer-field/correct {:answer/id #uuid "ed555ea6-dfea-51d4-876e-75d752688105" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}-{(y-\\frac{5}{2})}^{2}" :db/id #edb/ref 17592186271354} :answer-field/id #uuid "880bee47-a8c3-50a6-937c-697f411c6825" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271749}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "afc8b4da-a3f1-5590-a7d5-e7a094b395bd" :question/math-academy-id "q-140410" :question/problem "Rewrite $-{y}^{2}+5y-5$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $-1.$ So, we take out a factor of $-1$ from the entire expression:\n\n$$\n-({y}^{2}-5y+5)\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{y}^{2}-5y+5\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}-2\\cdot \\frac{5}{2}y+5\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{5}{2})}^{2},$ writing the constant term $5$ last:\n\n$$\n{{y}^{2}-2\\cdot \\frac{5}{2}y+{(\\frac{5}{2})}^{2}}_{⏟}-{(\\frac{5}{2})}^{2}+5\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(y-\\frac{5}{2})}^{2}-{(\\frac{5}{2})}^{2}+5\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(y-\\frac{5}{2})}^{2}-\\frac{5}{4}.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-{y}^{2}+5y-5 & =-({(y-\\frac{5}{2})}^{2}-\\frac{5}{4}) \\\\  & =\\frac{5}{4}-{(y-\\frac{5}{2})}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272085 :knowledge-point/_questions [{:db/id #edb/ref 17592186096611 :knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0884ad38-9d14-5f8e-b665-d8b35b5af237" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e+4" :db/id #edb/ref 17592186269346} {:answer/id #uuid "0db0ac08-c4ce-5d3f-845f-d38358413506" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e+8" :db/id #edb/ref 17592186269388} {:answer/id #uuid "2934301c-7684-5c1f-b910-d7819431eba3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e" :db/id #edb/ref 17592186269640} {:answer/id #uuid "7789397b-7630-5bd8-9c80-42e72f128cee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e+8" :db/id #edb/ref 17592186270328} {:answer/id #uuid "81639cc6-e903-5cd2-bc14-50bfc72b4d70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e+4" :db/id #edb/ref 17592186270388}] :answer-field/correct {:answer/id #uuid "7789397b-7630-5bd8-9c80-42e72f128cee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e+8" :db/id #edb/ref 17592186270328} :answer-field/id #uuid "c7c2979c-8072-5209-9ca0-20ccbaf77003" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271876}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d2ffa4af-5dbe-569b-8d78-f233584a8913" :question/math-academy-id "q-140431" :question/problem "Given that $f(x)=2{e}^{x}+4{x}^{2}-3$, find the slope of the tangent at $x=1.$" :question/worked-solution "First, using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2{e}^{x}+4{x}^{2}-3) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(4{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(-3) \\\\  & =2\\frac{\\text{d}}{\\text{d}x}({e}^{x})+4\\frac{\\text{d}}{\\text{d}x}({x}^{2})+0 \\\\  & =2{e}^{x}+8x.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=1} & ={(2{e}^{x}+8x)\\,|}_{x=1} \\\\  & =2\\cdot {e}^{1}+8\\cdot 1 \\\\  & =2e+8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186396052 :knowledge-point/_questions [{:db/id #edb/ref 17592186096706 :knowledge-point/id #uuid "8c990d69-54da-5541-948f-0d5eff96feb5" :knowledge-point/title "Calculating the X-Intercepts of a Parabola Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fbcf88a3-1e20-5a4c-bb86-1fe1bdaa1963" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$8$ and $-1$" :db/id #edb/ref 17592186396054} {:answer/id #uuid "ae0d6ea0-c5ed-5e7f-9687-ab98aef0c28b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7$ and $-1$" :db/id #edb/ref 17592186396055} {:answer/id #uuid "c4dc7a4e-aacb-5122-89ac-d5eb5d04a7da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$9$ and $-2$" :db/id #edb/ref 17592186396056} {:answer/id #uuid "950ec668-d2b7-5d89-8e4f-1d349b1209a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7$ and $-2$" :db/id #edb/ref 17592186396057} {:answer/id #uuid "2789771c-579f-5375-8680-854defcdf4d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$8$ and $-3$" :db/id #edb/ref 17592186396058}] :answer-field/correct {:answer/id #uuid "ae0d6ea0-c5ed-5e7f-9687-ab98aef0c28b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7$ and $-1$" :db/id #edb/ref 17592186396055} :answer-field/id #uuid "1984d219-413d-5333-ac39-1acd7d9d0ec5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396053}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1270303e-0109-58be-ac65-6aecbfb8540f" :question/math-academy-id "q-14050" :question/problem "![](images/04/0470661491c0d9d44ecbbc3c87af70d4ff334f1ffd2ca56b68bd4c126f3d88de.png)\n\nWhat are the $x$-intercepts of the parabola shown above?" :question/worked-solution "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(3,-4)$ and passes through the point $(0,-\\frac{7}{4}).$\n\nThe general standard equation of an up- or down-opening parabola with vertex $(h,k)$ is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nSubstituting $(h,k)=(3,-4)$ into the above gives\n\n$$\n\\begin{aligned}(x-3)^{2} & =4p(y+4).\\end{aligned}\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(0,-\\frac{7}{4}),$ we substitute $x=0$ and $y=-\\frac{7}{4}$ into the equation and get\n\n$$\n\\begin{aligned}(0-3)^{2} & =4p(-\\frac{7}{4}+4) \\\\ 9 & =4p(\\frac{9}{4}) \\\\ p & =1.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(x-3)^{2} & =4(y+4).\\end{aligned}\n$$\n\nWhen the parabola intersects the $x$-axis, we must have $y=0.$ So, we substitute $y=0$ into the equation of the parabola and solve for $x:$\n\n$$\n\\begin{aligned}(x-3)^{2} & =4(0+4) \\\\ (x-3)^{2} & =16 \\\\ x-3 & =\\pm 4 \\\\ x & =\\pm 4+3\\end{aligned}\n$$\n\nTherefore, the $x$-intercepts are $7$ and $-1.$"}] [{:db/id #edb/ref 17592186388771 :knowledge-point/_questions [{:db/id #edb/ref 17592186110583 :knowledge-point/id #uuid "18cd52a9-1524-5099-b1d8-858345328bad" :knowledge-point/title "Constructing an Integral That Gives the Area Bounded by a Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed59c0fa-145a-58c6-9183-7a618b9935a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186388773} {:answer/id #uuid "3b2b15db-3e26-5206-ac2f-5ed2fb6e032f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186388774} {:answer/id #uuid "ec6c7690-6ae3-52da-bc3d-2f05754b1818" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186388775} {:answer/id #uuid "66ed0fb5-f500-5d8a-908f-f603def527e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186388776} {:answer/id #uuid "ef7a63c1-cb03-5469-bed3-2e5a4974c10b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186388777}] :answer-field/correct {:answer/id #uuid "3b2b15db-3e26-5206-ac2f-5ed2fb6e032f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186388774} :answer-field/id #uuid "15b97b39-9214-5cd5-be06-dad9c9ec0e0b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388772}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cb68cdd3-2757-5be6-bde1-043b15f42f06" :question/math-academy-id "q-140583" :question/problem "![](images/8b/8b729d243b344df6b26757773bf0521dea80da34fc727541d24babd3732563cf.png)\n\nThe total area $A$ of the region between the curve $y=4-\\frac{1}{4}{x}^{4}$ and the $x$-axis from $x=-1$ to $x=\\frac{5}{2}$ is given by the integral expression below. What is the value of $a?$\n\n$$\nA={\\int }_{-1}^{a}(4-\\frac{1}{4}{x}^{4})\\text{d}x-{\\int }_{a}^{5/2}(4-\\frac{1}{4}{x}^{4})\\text{d}x.\n$$" :question/worked-solution "To determine the missing limit of integration, we need to find the $x$-intercept of the curve $y=4-\\frac{1}{4}{x}^{4}.$ So, we set $y=0$ and solve for $x$ as follows:\n\n$$\n\\begin{aligned}4-\\frac{1}{4}{x}^{4} & =0 \\\\ -\\frac{1}{4}{x}^{4} & =-4 \\\\ {x}^{4} & =16 \\\\ \\sqrt[4]{{x}^{4}} & =\\pm \\sqrt[4]{16} \\\\ x & =\\pm \\sqrt[4]{{2}^{4}} \\\\ x & =\\pm 2\\end{aligned}\n$$\n\nThe only solution between $x=-1$ and $x=\\frac{5}{2}$ is $x=2.$\n\nSince $2\\in [-1,\\frac{5}{2}],$ we have two regions:\n\n- The area between the curve and the $x$-axis from $x=-1$ to $x=2.$\n\n- The area between the curve and the $x$-axis from $x=2$ to $x=\\frac{5}{2}.$\n\nSo, $a=2$ and the final expression will be\n\n$$\nA={\\int }_{-1}^{2}(4-\\frac{1}{4}{x}^{4})\\text{d}x+{\\int }_{2}^{5/2}(4-\\frac{1}{4}{x}^{4})\\text{d}x.\n$$"}] [{:db/id #edb/ref 17592186272145 :knowledge-point/_questions [{:db/id #edb/ref 17592186110582 :knowledge-point/id #uuid "262a1469-0920-565f-9268-28f0e5f1faf5" :knowledge-point/title "Finding the Total Area Bounded Between the X-Axis and a Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "195e65d7-eb26-529e-a9d4-45e8bc648f9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{2}" :db/id #edb/ref 17592186269480} {:answer/id #uuid "41ad119b-3f99-5798-aae3-071313ac3489" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186269862} {:answer/id #uuid "47b8eb5f-5809-5a9f-b0ac-610e2f2052e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16}{3}" :db/id #edb/ref 17592186269920} {:answer/id #uuid "a590499c-1376-53a0-949e-dc6b356ceac6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186270750} {:answer/id #uuid "d8fb2498-f4bf-5bc2-bb68-e36780b0ba17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{31}{6}" :db/id #edb/ref 17592186271173}] :answer-field/correct {:answer/id #uuid "d8fb2498-f4bf-5bc2-bb68-e36780b0ba17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{31}{6}" :db/id #edb/ref 17592186271173} :answer-field/id #uuid "f97e4b6d-a04e-5384-9abd-8a860b5c1c0e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271939}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "04b86384-ff85-50f1-b5ea-5fd29d41b106" :question/math-academy-id "q-140607" :question/problem "Find the total area of the region between the curve $y=3x-{x}^{2}$ and the $x$-axis from $x=1$ to $x=4.$" :question/worked-solution "First, we find the intersections of the curve with the $x$-axis:\n\n$$\n\\begin{aligned}3x-{x}^{2} & =0 \\\\ x(3-x) & =0 \\\\ x & =0,\\,3\\end{aligned}\n$$\n\nSince $3\\in [1,4],$ we have two regions: \n\n- The area between the curve and the $x$-axis from $x=1$ to $x=3.$\n\n- The area between the curve and the $x$-axis from $x=3$ to $x=4.$\n\n![](images/21/219d7aa5b976c97d47a96d0c94c3d61d139d5ddddc55b82d0df68f19ad6d5149.png)\n\nNotice that the region for $x\\in [3,4]$ lies completely below the $x$-axis. Hence, the value of\n\n$$\n{\\int }_{a}^{b}y(x)\\,\\text{d}x={\\int }_{3}^{4}(3x-{x}^{2})\\,\\text{d}x\n$$\n\nwill be negative. Therefore, the area that we want is given by\n\n$$\n\\begin{aligned}{A}_{1} & ={\\int }_{1}^{3}(3x-{x}^{2})\\,\\text{d}x \\\\  & =3{\\int }_{1}^{3}x\\,\\text{d}x-{\\int }_{1}^{3}{x}^{2}\\,\\text{d}x \\\\  & =\\frac{3}{2}{x}^{2}\\,{|}_{1}^{3}-\\frac{1}{3}{x}^{3}\\,{|}_{1}^{3} \\\\  & =\\frac{3}{2}[{3}^{2}-{1}^{2}]-\\frac{1}{3}[{3}^{3}-{1}^{3}] \\\\  & =\\frac{3}{2}[9-1]-\\frac{1}{3}[27-1] \\\\  & =12-\\frac{26}{3} \\\\  & =\\frac{10}{3}.\\end{aligned}\n$$\n\nFor $x\\in [3,4],$ we have\n\n$$\n\\begin{aligned}{A}_{2} & =-{\\int }_{3}^{4}(3x-{x}^{2})\\,\\text{d}x \\\\  & =-3{\\int }_{3}^{4}x\\,\\text{d}x+{\\int }_{3}^{4}{x}^{2}\\,\\text{d}x \\\\  & =-\\frac{3}{2}{x}^{2}\\,{|}_{3}^{4}+\\frac{1}{3}{x}^{3}\\,{|}_{3}^{4} \\\\  & =-\\frac{3}{2}[{4}^{2}-{3}^{2}]+\\frac{1}{3}[{4}^{3}-{3}^{3}] \\\\  & =-\\frac{3}{2}[16-9]+\\frac{1}{3}[64-27] \\\\  & =-\\frac{21}{2}+\\frac{37}{3} \\\\  & =\\frac{11}{6}.\\end{aligned}\n$$\n\nFinally, the total area is\n\n$$\nA={A}_{1}+{A}_{2}=\\frac{10}{3}+\\frac{11}{6}=\\frac{31}{6}.\n$$"}] [{:db/id #edb/ref 17592186373785 :knowledge-point/_questions [{:db/id #edb/ref 17592186100951 :knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60b15d99-5f73-5d71-a0a0-49f9be9df65d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186373787} {:answer/id #uuid "3cefcde2-3aa5-51a2-8f0c-24c6172e631c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186373788} {:answer/id #uuid "243ba24f-c088-5741-b1dc-797cc0c88bb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186373789} {:answer/id #uuid "3ab4b002-dd36-598f-8102-522b7e368735" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186373790} {:answer/id #uuid "4a73df82-8e85-5bb1-90fc-89e5be58e836" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186373791}] :answer-field/correct {:answer/id #uuid "3cefcde2-3aa5-51a2-8f0c-24c6172e631c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186373788} :answer-field/id #uuid "e02b7c91-76ce-53ed-b342-163951d05f8f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373786}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8abc10be-3eb5-5e2c-9a94-244a431b287a" :question/math-academy-id "q-141112" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-\\frac{y}{x},\\,y(-2)=-1.\n$$\n\nYou're given that $y=\\frac{A}{x}$ is the solution to this initial value problem. What is the value of the constant $A?$" :question/worked-solution "We're given that $y=\\frac{A}{x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(-2)=-1.$\n\nSubstituting the initial condition $y(-2)=-1$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =\\frac{A}{x} \\\\ -1 & =\\frac{A}{(-2)} \\\\ A & =2.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=\\frac{2}{x}.\n$$"}] [{:db/id #edb/ref 17592186398452 :knowledge-point/_questions [{:db/id #edb/ref 17592186100951 :knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89027aec-d449-5dca-8830-9b39f9c5fbba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e+1" :db/id #edb/ref 17592186398454} {:answer/id #uuid "d1591666-636c-5480-9f22-08f9eeec3613" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e-1" :db/id #edb/ref 17592186398455} {:answer/id #uuid "b092bcb2-de91-5a2a-9a1c-b1cf1cdf0b26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186398456} {:answer/id #uuid "4f0a5d44-77c5-5b01-9db7-d212e6e5f858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e-1" :db/id #edb/ref 17592186398457} {:answer/id #uuid "408ad86d-b3e2-50fe-ba49-d6d10e8b89e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186398458}] :answer-field/correct {:answer/id #uuid "4f0a5d44-77c5-5b01-9db7-d212e6e5f858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e-1" :db/id #edb/ref 17592186398457} :answer-field/id #uuid "5f0f43ae-19bf-5c26-8ca2-6e01020ad358" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398453}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e96414b2-2fe9-598e-bc15-f2c64a7b0633" :question/math-academy-id "q-141115" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={e}^{-y},\\,y(1)=1.\n$$\n\nYou're given that $y=\\operatorname{ln}⁡(A+x)$ is the solution to this initial value problem. What is the value of the constant $A?$" :question/worked-solution "We're given that $y=\\operatorname{ln}⁡(A+x)$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(1)=1.$\n\nSubstituting the initial condition $y(1)=1$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =\\operatorname{ln}⁡(A+x) \\\\ 1 & =\\operatorname{ln}⁡(A+1) \\\\ {e}^{1} & ={e}^{\\operatorname{ln}⁡(A+1)} \\\\ e & =A+1 \\\\ A & =e-1.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=\\operatorname{ln}⁡(e-1+x).\n$$"}] [{:db/id #edb/ref 17592186398459 :knowledge-point/_questions [{:db/id #edb/ref 17592186100951 :knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dcefcd7-21a2-550b-82e1-cdf9e8efcbda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186398461} {:answer/id #uuid "4b4230d9-c571-50ea-9f01-98df054d2c1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186398462} {:answer/id #uuid "d47c7e95-9d5a-515c-9902-a9d88176c6d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186398463} {:answer/id #uuid "89f9fe65-61ad-531c-91e5-0d74f2e05f24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186398464} {:answer/id #uuid "86af0317-94e9-53ec-8661-5ce6b18962d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186398465}] :answer-field/correct {:answer/id #uuid "d47c7e95-9d5a-515c-9902-a9d88176c6d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186398463} :answer-field/id #uuid "9f0c471e-3bc9-5406-b7a8-dfcd6f763630" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398460}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ea6ff592-81a4-59f3-84d6-c97bdc2e3a4f" :question/math-academy-id "q-141116" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-{y}^{2},\\,y(0)=\\frac{1}{2}.\n$$\n\nYou're given that $y=\\frac{1}{A+x}$ is the solution to this initial value problem. What is the value of the constant $A?$" :question/worked-solution "We're given that $y=\\frac{1}{A+x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(0)=\\frac{1}{2}.$\n\nSubstituting the initial condition $y(0)=\\frac{1}{2}$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =\\frac{1}{A+x} \\\\ \\frac{1}{2} & =\\frac{1}{A+0} \\\\ \\frac{1}{2} & =\\frac{1}{A} \\\\ A & =2.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=\\frac{1}{2+x}.\n$$"}] [{:db/id #edb/ref 17592186400909 :knowledge-point/_questions [{:db/id #edb/ref 17592186129253 :knowledge-point/id #uuid "4d48e2a0-1a76-5eec-a98c-4a7eb16f70cb" :knowledge-point/title "Identifying Multiplicity of a Root Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3559bdb9-c007-500b-83db-63f2d91cd407" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-3$ is a multiple root of odd multiplicity" :db/id #edb/ref 17592186400911} {:answer/id #uuid "f1984a87-93e4-523e-80b4-a37c28b7dc5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-3$ is a multiple root of even multiplicity" :db/id #edb/ref 17592186400912} {:answer/id #uuid "3f15fef9-83c3-50e8-980b-72c67ab596d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-3$ is a simple root of even multiplicity" :db/id #edb/ref 17592186400913} {:answer/id #uuid "f52c0001-2df6-56e0-ae3c-2dca7d79a58b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-3$ is not a root of $p(x)$" :db/id #edb/ref 17592186400914} {:answer/id #uuid "d7950f6f-fd87-5dac-ba8c-650fe8a19888" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-3$ is a simple root" :db/id #edb/ref 17592186400915}] :answer-field/correct {:answer/id #uuid "d7950f6f-fd87-5dac-ba8c-650fe8a19888" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-3$ is a simple root" :db/id #edb/ref 17592186400915} :answer-field/id #uuid "5806f142-c711-5da8-b1d4-68c8001a3f1f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400910}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6ab70a1a-e04b-524f-9866-e86f88144126" :question/math-academy-id "q-141140" :question/problem "![](images/b3/b362831ba2248e03537551c412ae7537646dcd09f0d00a598905f0d52a258da9.png)\n\nA part of the graph of a polynomial $p(x)$ is given above. Which of the following statements is true?" :question/worked-solution "| Multiplicity | Sketch | Sketch |\n| --- | --- | --- |\n| $1$ \n\n (Simple Root) | ![](images/5a/5a0221f93c65a1eeb4503604a558a6da81c4c7af81c2c52cc35ecf3d189fe99f.png) | ![](images/d5/d556b4edf39181eebb7ec87c344d6f657a6875ecd2745405eaf5351ccaff6f96.png) |\n| $>1$ \n\n (Multiple Root) \n\n Even | ![](images/9d/9d14c2588da2ee9c9f5bbc32a70791146bed609ea0d6d5912aeaa2edab02e2d7.png) | ![](images/28/28ad9248a9a509e3a44937d0438fb2366f550a22360d01b9b6a29bcac41357e8.png) |\n| $>1$ \n\n (Multiple Root) \n\n Odd | ![](images/3a/3ae81378cb3c918dd5b7730519eb5a91e949f88eef9f03f4910f4ab8fb3cd5a9.png) | ![](images/95/9506a7ce4031f1f6244c0110c3235f66ea5652bb53548a032732869cf21f5997.png) |\n\nIt's possible to determine information regarding the multiplicities of the roots of a polynomial from its graph.\n\n- If the graph intersects the $x$-axis but is *not* tangent to the $x$-axis at $x=a,$ we have a *simple* root $x=a.$\n\n- If the graph is *tangent* to the $x$-axis at $x=a,$ we have a *multiple* root $x=a.$ Furthermore:\n\n- If the graph touches the $x$-axis and reverses direction at $x=a,$ the multiplicity of a root $x=a$ is *even*.\n\n- If the graph crosses the $x$-axis at $x=a,$ the multiplicity of a root $x=a$ is *odd*.\n\nIn our case, the graph is *not* tangent to the $x$-axis at $x=-3.$ Therefore, $x=-3$ is a *simple* root."}] [{:db/id #edb/ref 17592186272221 :knowledge-point/_questions [{:db/id #edb/ref 17592186129253 :knowledge-point/id #uuid "4d48e2a0-1a76-5eec-a98c-4a7eb16f70cb" :knowledge-point/title "Identifying Multiplicity of a Root Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a762869-8c41-5b99-945a-904933273d75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=6$ is a simple root" :db/id #edb/ref 17592186270354} {:answer/id #uuid "8e0792d1-d0d7-58d4-acd0-2928fe61d064" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=6$ is a multiple root of odd multiplicity" :db/id #edb/ref 17592186270498} {:answer/id #uuid "a19bd95b-bbd6-55a2-9a46-010b458abb4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=6$ is not a root of $p(x)$" :db/id #edb/ref 17592186270704} {:answer/id #uuid "c3b75751-2d73-5678-8386-167ce0d8f782" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=6$ is a simple root of even multiplicity" :db/id #edb/ref 17592186270997} {:answer/id #uuid "f84b8666-1809-58bd-bfe6-8ab9488eb61f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=6$ is a multiple root of even multiplicity" :db/id #edb/ref 17592186271447}] :answer-field/correct {:answer/id #uuid "f84b8666-1809-58bd-bfe6-8ab9488eb61f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=6$ is a multiple root of even multiplicity" :db/id #edb/ref 17592186271447} :answer-field/id #uuid "eb90200a-e2bb-5eaf-ba24-af1df789d82c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271925}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "86545112-71e2-5627-8c9c-5a320524ae07" :question/math-academy-id "q-141144" :question/problem "![](images/40/4092c0852a573a0add69c6fb7b55f393d0767a5b6a2282a10194ea27cb1be9c4.png)\n\nA part of the graph of a polynomial $p(x)$ is shown above. Which of the following statements is true?" :question/worked-solution "| Multiplicity | Sketch | Sketch |\n| --- | --- | --- |\n| $1$ \n\n (Simple Root) | ![](images/5a/5a0221f93c65a1eeb4503604a558a6da81c4c7af81c2c52cc35ecf3d189fe99f.png) | ![](images/d5/d556b4edf39181eebb7ec87c344d6f657a6875ecd2745405eaf5351ccaff6f96.png) |\n| $>1$ \n\n (Multiple Root) \n\n Even | ![](images/9d/9d14c2588da2ee9c9f5bbc32a70791146bed609ea0d6d5912aeaa2edab02e2d7.png) | ![](images/28/28ad9248a9a509e3a44937d0438fb2366f550a22360d01b9b6a29bcac41357e8.png) |\n| $>1$ \n\n (Multiple Root) \n\n Odd | ![](images/3a/3ae81378cb3c918dd5b7730519eb5a91e949f88eef9f03f4910f4ab8fb3cd5a9.png) | ![](images/95/9506a7ce4031f1f6244c0110c3235f66ea5652bb53548a032732869cf21f5997.png) |\n\nIt's possible to determine information regarding the multiplicities of the roots of a polynomial from its graph.\n\n- If the graph intersects the $x$-axis but is *not* tangent to the $x$-axis at $x=a,$ we have a *simple* root $x=a.$\n\n- If the graph is *tangent* to the $x$-axis at $x=a,$ we have a *multiple* root $x=a.$ Furthermore:\n\n- If the graph touches the $x$-axis and reverses direction at $x=a,$ the multiplicity of a root $x=a$ is *even*.\n\n- If the graph crosses the $x$-axis at $x=a,$ the multiplicity of a root $x=a$ is *odd*.\n\nIn our case, the graph is *tangent* to the $x$-axis at $x=6.$ So, $x=6$ is a *multiple* root. \n\nFurthermore, the graph touches the $x$-axis and reverses direction at $x=6.$ So, $x=6$ has *even* multiplicity.\n\nTherefore, $x=6$ is a multiple root of even multiplicity."}] [{:db/id #edb/ref 17592186400916 :knowledge-point/_questions [{:db/id #edb/ref 17592186068825 :knowledge-point/id #uuid "fc419917-fe34-5bf9-8bf0-1b022fce11ff" :knowledge-point/title "Solving a \"Less Than\" Inequality Given the Graph of the Corresponding Parabola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c694a7cb-1273-5aef-bab1-b00405cb06a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5<x<1" :db/id #edb/ref 17592186400918} {:answer/id #uuid "19263d22-de7b-5ef3-9798-b98080320005" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x<-5$ or    $x>-1$" :db/id #edb/ref 17592186400919} {:answer/id #uuid "ee071af0-120e-5c4a-b72d-0c54e26d3687" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x>5" :db/id #edb/ref 17592186400920} {:answer/id #uuid "395b066b-730c-5a11-889e-cc63987fd8a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x<-1$ or    $x>5$" :db/id #edb/ref 17592186400921} {:answer/id #uuid "3271e9c8-ddaf-5be7-852f-5b3fd22e072b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1<x<5" :db/id #edb/ref 17592186400922}] :answer-field/correct {:answer/id #uuid "19263d22-de7b-5ef3-9798-b98080320005" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x<-5$ or    $x>-1$" :db/id #edb/ref 17592186400919} :answer-field/id #uuid "7f3297c0-8b61-583d-8e5e-b17352fc3208" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400917}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "66cebf22-0b82-5cf0-a87d-5c8eaa25290f" :question/math-academy-id "q-141187" :question/problem "![](images/46/46edcf2265f41b8fac7931802875e1b9849006834b3509a186ffc7acb510959f.png)\n\nGiven the graph above, solve the inequality $(-x-5)(x+1)<0.$" :question/worked-solution "Notice that our inequality\n\n$$\n(-x-5)(x+1)<0,\n$$\n\nis a \"*less than*\" inequality. Therefore, we need to find the values of $x$ for which the parabola  \n\n$$\ny=(-x-5)(x+1)\n$$\n\n  \n\nis *below* the $x$-axis. We mark these values of $x$ in blue in the diagram below.\n\n![](images/e8/e830af773829b1712c6a87955e74411b6ad9921ae1aea58029ca968ab354c0f1.png)\n\n \n\nSo, the solution to the inequality is $x<-5$ or    $x>-1.$"}] [{:db/id #edb/ref 17592186272254 :knowledge-point/_questions [{:db/id #edb/ref 17592186059662 :knowledge-point/id #uuid "69e91ce7-259a-5a11-bb79-7e6ad7ea86d4" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12266a51-a7c9-5483-94da-be9664d1b481" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186269429} {:answer/id #uuid "18eff7de-8c89-5305-88dc-9781c493dbed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{sin}⁡x-\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186269477} {:answer/id #uuid "9784d4b6-191f-5d3c-bfd0-0ff7a24f4c76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\operatorname{sin}⁡x+\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186270602} {:answer/id #uuid "b5aefcfb-4daa-5443-aaa4-83730b1b02a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡x-\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186270882} {:answer/id #uuid "f3d99ef5-ddef-5389-82d4-95a6ce517307" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186271407}] :answer-field/correct {:answer/id #uuid "9784d4b6-191f-5d3c-bfd0-0ff7a24f4c76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\operatorname{sin}⁡x+\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186270602} :answer-field/id #uuid "a0f40e9a-9d94-55f1-89bf-5ae1a4030b7c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271801}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b6e1f817-7c7e-51c8-bd09-e888759f9be3" :question/math-academy-id "q-141275" :question/problem "$\\operatorname{sin}⁡(x-{120}^{∘})=$" :question/worked-solution "Recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(u-v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for sine with $u=x$ and $v={120}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x-{120}^{∘}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡{120}^{∘}-\\operatorname{cos}⁡x\\operatorname{sin}⁡{120}^{∘} \\\\  & =\\operatorname{sin}⁡x\\cdot (-\\frac{1}{2})-\\operatorname{cos}⁡x\\cdot (\\frac{\\sqrt{3}}{2}) \\\\  & =-\\frac{\\operatorname{sin}⁡x}{2}-\\frac{\\sqrt{3}\\operatorname{cos}⁡x}{2} \\\\  & =-\\frac{\\operatorname{sin}⁡x+\\sqrt{3}\\operatorname{cos}⁡x}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272256 :knowledge-point/_questions [{:db/id #edb/ref 17592186059662 :knowledge-point/id #uuid "69e91ce7-259a-5a11-bb79-7e6ad7ea86d4" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "012c6c54-c102-5db4-8d24-caf1dec68123" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186269269} {:answer/id #uuid "55dd97d3-3e02-5362-84db-9281bfaf98c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x" :db/id #edb/ref 17592186270029} {:answer/id #uuid "60c3ef61-d3ea-5891-85a9-bc3230333d6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186270123} {:answer/id #uuid "7837e062-26e0-54eb-9c88-937b73a56868" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186270334} {:answer/id #uuid "9974f52a-a24a-58ca-913f-99e237c9a5bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186270618}] :answer-field/correct {:answer/id #uuid "9974f52a-a24a-58ca-913f-99e237c9a5bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186270618} :answer-field/id #uuid "bea83195-85b8-5a62-ae80-a9df9097b16d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271856}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dd3a924d-681c-501c-bf69-7fbcdc5b6418" :question/math-academy-id "q-141278" :question/problem "$\\operatorname{sin}⁡(x-{180}^{∘})=$" :question/worked-solution "Recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(u-v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for sine with $u=x$ and $v={180}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x-{180}^{∘}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡{180}^{∘}-\\operatorname{cos}⁡x\\operatorname{sin}⁡{180}^{∘} \\\\  & =\\operatorname{sin}⁡x\\cdot (-1)-\\operatorname{cos}⁡x\\cdot (0) \\\\  & =-\\operatorname{sin}⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272257 :knowledge-point/_questions [{:db/id #edb/ref 17592186059820 :knowledge-point/id #uuid "4b12a7b7-1df3-5203-934e-8820604de3de" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0da8bceb-5536-5271-8827-e5da61eb6060" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186269387} {:answer/id #uuid "3ef50584-86f1-5b31-a1a6-a37093aa3120" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186269846} {:answer/id #uuid "42fbd17c-de86-5394-814e-0ac710c28aed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186269872} {:answer/id #uuid "ced45233-a48f-5d9c-bc03-580cf170e7ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186271083} {:answer/id #uuid "d6ebddae-329f-55c0-89d1-c5bb4c99e094" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x" :db/id #edb/ref 17592186271157}] :answer-field/correct {:answer/id #uuid "3ef50584-86f1-5b31-a1a6-a37093aa3120" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186269846} :answer-field/id #uuid "e714385a-3268-5f76-bbf9-458125ace391" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271919}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "78f7a073-b897-5930-bd54-7d5e600e42be" :question/math-academy-id "q-141284" :question/problem "$\\operatorname{sin}⁡(x-\\frac{\\pi }{2})=$" :question/worked-solution "Recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(u-v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for sine with $u=x$ and $v=\\frac{\\pi }{2},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x-\\frac{\\pi }{2}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡(\\frac{\\pi }{2})-\\operatorname{cos}⁡x\\operatorname{sin}⁡(\\frac{\\pi }{2}) \\\\  & =\\operatorname{sin}⁡x\\cdot (0)-\\operatorname{cos}⁡x\\cdot (1) \\\\  & =-\\operatorname{cos}⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186400923 :knowledge-point/_questions [{:db/id #edb/ref 17592186184180 :knowledge-point/id #uuid "c023b634-e106-5fbc-a8ff-197f3aa4869d" :knowledge-point/title "Determining Whether a Geometric Sequence Converges Given the General Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d912e9d9-60dd-53f8-84b5-6a01262be9b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $0$" :db/id #edb/ref 17592186400925} {:answer/id #uuid "5e69372e-e868-57ad-81a9-235542604c47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $3$" :db/id #edb/ref 17592186400926} {:answer/id #uuid "ad3cf5dc-1a5e-5ca5-bb04-89cb5648d292" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $\\frac{2}{3}$" :db/id #edb/ref 17592186400927} {:answer/id #uuid "a6f4c2df-fdff-5c81-86c1-ed79a5590ca1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $-\\frac{2}{3}$" :db/id #edb/ref 17592186400928} {:answer/id #uuid "ee524a7c-b00b-54ff-b0db-1379d3f0eb87" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186400929}] :answer-field/correct {:answer/id #uuid "d912e9d9-60dd-53f8-84b5-6a01262be9b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $0$" :db/id #edb/ref 17592186400925} :answer-field/id #uuid "a83cb541-9ba7-558c-804e-5b78b4a327b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400924}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7c5b5131-1801-5dfb-aff8-f50ca940df15" :question/math-academy-id "q-141310" :question/problem "Does the sequence ${a}_{n}=\\frac{3{(4)}^{n}}{{(-6)}^{n}}$ for $n\\ge 1$ converge or diverge? If it converges, what is its limit?" :question/worked-solution "Suppose we have a geometric sequence with the first term ${a}_{1}$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r|<1,$ the sequence is convergent and converges to $0$\n\n- if $|r|>1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to ${a}_{1}$\n\n- if $r=-1,$ the sequence is divergent\n\nFirst, we rewrite the sequence in the form ${a}_{n}=a\\cdot {r}^{n},$ as follows:\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{3{(4)}^{n}}{{(-6)}^{n}} \\\\  & =3\\cdot \\frac{{(4)}^{n}}{{(-6)}^{n}} \\\\  & =3{(-\\frac{4}{6})}^{n} \\\\  & =3{(-\\frac{2}{3})}^{n}\\end{aligned}\n$$\n\nWe can now see that this is the geometric sequence with $r=-\\frac{2}{3}.$ \n\nSince $|r|<1,$ the sequence converges to $0.$"}] [{:db/id #edb/ref 17592186272260 :knowledge-point/_questions [{:db/id #edb/ref 17592186184180 :knowledge-point/id #uuid "c023b634-e106-5fbc-a8ff-197f3aa4869d" :knowledge-point/title "Determining Whether a Geometric Sequence Converges Given the General Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30847f0b-0b4b-5f36-a3b0-37f3dad54553" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $0$" :db/id #edb/ref 17592186269706} {:answer/id #uuid "545f1118-43f6-5a00-8098-f3be2988683a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $1$" :db/id #edb/ref 17592186270021} {:answer/id #uuid "578fba5d-47fa-5591-9315-034b97234804" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186270042} {:answer/id #uuid "78b7a0e1-7f04-5430-9f17-d26da04c9f66" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $\\frac{11}{9}$" :db/id #edb/ref 17592186270339} {:answer/id #uuid "edad3d6a-2c87-516e-bac4-fb514407d70c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Converges to $8$" :db/id #edb/ref 17592186271357}] :answer-field/correct {:answer/id #uuid "578fba5d-47fa-5591-9315-034b97234804" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186270042} :answer-field/id #uuid "f78976ba-707b-5d42-8224-1405db058378" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271937}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "385046ae-9549-5d03-b987-27cdd162ac0c" :question/math-academy-id "q-141314" :question/problem "Does the sequence ${a}_{n}=\\frac{8\\cdot {11}^{n}}{{9}^{n}}$ for $n\\ge 1$ converge or diverge? If it converges, what is its limit?" :question/worked-solution "Suppose we have a geometric sequence with the first term ${a}_{1}$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r|<1,$ the sequence is convergent and converges to $0$\n\n- if $|r|>1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to ${a}_{1}$\n\n- if $r=-1,$ the sequence is divergent\n\nFirst, we rewrite the sequence in the form ${a}_{n}=a\\cdot {r}^{n},$ as follows:\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{8\\cdot {11}^{n}}{{9}^{n}} \\\\  & =8\\cdot \\frac{{11}^{n}}{{9}^{n}} \\\\  & =8{(\\frac{11}{9})}^{n}\\end{aligned}\n$$\n\nWe can now see that this is the geometric sequence with $r=\\frac{11}{9}.$ \n\nSince $|r|>1,$ the sequence diverges."}] [{:db/id #edb/ref 17592186272262 :knowledge-point/_questions [{:db/id #edb/ref 17592186184181 :knowledge-point/id #uuid "126485fb-1b7f-5602-bc8d-05908ac6f37c" :knowledge-point/title "Determining Values for Which a Geometric Sequence Converges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e082063-0bec-52c0-9abb-ccfd65629060" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 2" :db/id #edb/ref 17592186269835} {:answer/id #uuid "73fdf72c-3fcc-55d7-b59a-2a42f091f341" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 4" :db/id #edb/ref 17592186270293} {:answer/id #uuid "97e6d079-ff4a-5073-8f18-1ff573cc25fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<x\\le 4" :db/id #edb/ref 17592186270606} {:answer/id #uuid "ecd06048-2d47-53ef-85a1-abd7a31133d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x>0" :db/id #edb/ref 17592186271349} {:answer/id #uuid "ff1b5d28-56a1-52d2-aca2-940b6a405673" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<x\\le 2" :db/id #edb/ref 17592186271499}] :answer-field/correct {:answer/id #uuid "ff1b5d28-56a1-52d2-aca2-940b6a405673" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<x\\le 2" :db/id #edb/ref 17592186271499} :answer-field/id #uuid "89bbb705-bc82-52a8-990a-0598294a9982" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271752}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cba8d40e-9ff0-576c-b4c2-5a73d8552590" :question/math-academy-id "q-141322" :question/problem "Consider the sequence ${a}_{n}=8{(\\frac{{x}^{2}}{4})}^{n},$ where $x$ is a positive real number and $n\\ge 1.$ What are the values of $x$ for which the sequence converges?" :question/worked-solution "Suppose we have a geometric sequence with the first term ${a}_{1}$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r|<1,$ the sequence is convergent and converges to $0$\n\n- if $|r|>1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to ${a}_{1}$\n\n- if $r=-1,$ the sequence is divergent\n\nThis given sequence is a geometric sequence with common ratio $r=\\frac{{x}^{2}}{4}.$ Since ${x}^{2}$ is positive, $r$ is also positive, So, the convergence condition is $0<r\\le 1.$ \n\nTherefore, the  sequence converges if \n\n$$\n0<\\frac{{x}^{2}}{4}\\le 1\\,⟹\\,0<{x}^{2}\\le 4.\n$$\n\nTaking into account the fact that $x$ is positive, we get\n\n$$\n0<x\\le 2.\n$$"}] [{:db/id #edb/ref 17592186272263 :knowledge-point/_questions [{:db/id #edb/ref 17592186184181 :knowledge-point/id #uuid "126485fb-1b7f-5602-bc8d-05908ac6f37c" :knowledge-point/title "Determining Values for Which a Geometric Sequence Converges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "145b8ac2-e119-5bb5-97b4-57b7f6c36df8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 8" :db/id #edb/ref 17592186269448} {:answer/id #uuid "23b49514-142c-5ec7-b618-4ff74f034103" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<x\\le 1" :db/id #edb/ref 17592186269582} {:answer/id #uuid "83d2c3b6-5dd1-5ee8-9fca-f3e5a69a70d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge \\frac{1}{8}" :db/id #edb/ref 17592186270407} {:answer/id #uuid "c10a13ae-f2e1-5b81-ac68-d491a279c9dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 1" :db/id #edb/ref 17592186270980} {:answer/id #uuid "cfef26a9-ce94-5d52-8b32-42f376028599" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<x\\le 8" :db/id #edb/ref 17592186271093}] :answer-field/correct {:answer/id #uuid "145b8ac2-e119-5bb5-97b4-57b7f6c36df8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 8" :db/id #edb/ref 17592186269448} :answer-field/id #uuid "be528d01-eb38-5742-aef2-18fc25b51ab4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271855}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "342f5e64-a399-5f8b-a691-0fd529d174f8" :question/math-academy-id "q-141323" :question/problem "Consider the geometric sequence ${a}_{n}=\\frac{x}{4}{(\\frac{8}{x})}^{n},$ where $x$ is a positive real number and $n\\ge 1.$ What are the values of $x$ for which the sequence converges?" :question/worked-solution "Suppose we have a geometric sequence with the first term ${a}_{1}$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r|<1,$ the sequence is convergent and converges to $0$\n\n- if $|r|>1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to ${a}_{1}$\n\n- if $r=-1,$ the sequence is divergent\n\nThe given sequence is a geometric sequence with the common ratio $r=\\frac{8}{x}.$ \nSince $x$ is positive,  $r$ is also positive, So, the convergence condition is $0<r\\le 1.$ \n\nTherefore, the  sequence converges for \n\n$$\n0<\\frac{8}{x}\\le 1\\,⟹\\,x\\ge 8.\n$$"}] [{:db/id #edb/ref 17592186272265 :knowledge-point/_questions [{:db/id #edb/ref 17592186184181 :knowledge-point/id #uuid "126485fb-1b7f-5602-bc8d-05908ac6f37c" :knowledge-point/title "Determining Values for Which a Geometric Sequence Converges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c76b1f7-d307-5022-b523-2a9d701df0bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge \\sqrt{2}" :db/id #edb/ref 17592186269821} {:answer/id #uuid "458f17d5-ae3c-5206-88da-0f8f9e8c40ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<x\\le 1" :db/id #edb/ref 17592186269904} {:answer/id #uuid "95ddf996-8bf3-5861-ba6b-942a4fee4bbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 1" :db/id #edb/ref 17592186270585} {:answer/id #uuid "b185b23a-d4dd-5aaa-ab15-5d137417fe8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 2" :db/id #edb/ref 17592186270856} {:answer/id #uuid "e1b0195a-a623-51e6-b397-aa476e1870d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<x\\le \\frac{1}{2}" :db/id #edb/ref 17592186271250}] :answer-field/correct {:answer/id #uuid "3c76b1f7-d307-5022-b523-2a9d701df0bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge \\sqrt{2}" :db/id #edb/ref 17592186269821} :answer-field/id #uuid "9037fd3f-bf8c-5555-9427-c1f893b2831d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271764}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "df355f69-884b-5a24-91f1-5877dbb36e55" :question/math-academy-id "q-141332" :question/problem "Consider the geometric sequence ${a}_{n}=\\frac{x}{2}{(\\frac{2}{{x}^{2}})}^{n},$ where $x$ is a positive real number and $n\\ge 1.$ What are the values of $x$ for which the sequence converges?" :question/worked-solution "Suppose we have a geometric sequence with the first term ${a}_{1}$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r|<1,$ the sequence is convergent and converges to $0$\n\n- if $|r|>1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to ${a}_{1}$\n\n- if $r=-1,$ the sequence is divergent\n\nThe given sequence is a geometric sequence with the common ratio $r=\\frac{2}{{x}^{2}}.$ \nSince ${x}^{2}$ is positive,  $r$ is also positive, So, the convergence condition is $0<r\\le 1.$ \n\nTherefore, the  sequence converges for \n\n$$\n0<\\frac{2}{{x}^{2}}\\le 1\\,⟹\\,{x}^{2}\\ge 2.\n$$\n\n \n\nTaking into account the fact that $x$ is positive, we get\n\n$$\nx\\ge \\sqrt{2}.\n$$"}] [{:db/id #edb/ref 17592186272270 :knowledge-point/_questions [{:db/id #edb/ref 17592186059821 :knowledge-point/id #uuid "c6a58962-cb06-519a-8c64-0dfa3b9c14d7" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25783b4f-f3f1-5cc2-84df-24e666b31d94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)}{2}" :db/id #edb/ref 17592186269600} {:answer/id #uuid "6ffdb6d7-6d98-5836-9d05-4da7a12f0aac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186270259} {:answer/id #uuid "84074aaa-f06b-558f-bcf0-aa133aa7738a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186270409} {:answer/id #uuid "c08bd8f7-a322-5e2b-8ce7-5315830bd7b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)}{2}" :db/id #edb/ref 17592186270974} {:answer/id #uuid "fc967a21-6b7e-51a5-8070-4d6aaad3f36a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x-\\sqrt{3}\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186271480}] :answer-field/correct {:answer/id #uuid "84074aaa-f06b-558f-bcf0-aa133aa7738a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186270409} :answer-field/id #uuid "4424e579-c28d-53af-bbb7-f1ff4f62f6c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271634}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b5eb1983-1627-51b5-a21b-a1c11d629a2e" :question/math-academy-id "q-141364" :question/problem "$\\operatorname{cos}⁡(x+{30}^{∘})=$" :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u+v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the sum formula for cosine with $u=x$ and $v={30}^{∘}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x+{30}^{∘}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡{30}^{∘}-\\operatorname{sin}⁡x\\operatorname{sin}⁡{30}^{∘} \\\\  & =\\operatorname{cos}⁡x\\cdot \\frac{\\sqrt{3}}{2}-\\operatorname{sin}⁡x\\cdot \\frac{1}{2} \\\\  & =\\frac{\\sqrt{3}\\operatorname{cos}⁡x}{2}-\\frac{\\operatorname{sin}⁡x}{2} \\\\  & =\\frac{\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272271 :knowledge-point/_questions [{:db/id #edb/ref 17592186059821 :knowledge-point/id #uuid "c6a58962-cb06-519a-8c64-0dfa3b9c14d7" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58fed7da-cc9f-5247-8790-595e7762d159" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x+\\sqrt{3}\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186270054} {:answer/id #uuid "73b132a3-1b01-5bd1-b120-eb314773c1dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186270291} {:answer/id #uuid "9e9f46a2-7866-51fb-a0a2-148a048c473d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x-\\sqrt{3}\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186270673} {:answer/id #uuid "b706b99b-e2bf-5192-9d1b-0550db1e6cb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)}{2}" :db/id #edb/ref 17592186270890} {:answer/id #uuid "d26b41fd-cb0c-55ab-b391-1f87a7808d7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)}{2}" :db/id #edb/ref 17592186271121}] :answer-field/correct {:answer/id #uuid "9e9f46a2-7866-51fb-a0a2-148a048c473d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x-\\sqrt{3}\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186270673} :answer-field/id #uuid "1c41cbbf-00d6-55e7-a081-545195af6cce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271560}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "48b60017-29fb-5b57-99c2-0a9425be35c5" :question/math-academy-id "q-141365" :question/problem "$\\operatorname{cos}⁡(x+{60}^{∘})=$" :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u+v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the sum formula for cosine with $u=x$ and $v={60}^{∘}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x+{60}^{∘}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡{60}^{∘}-\\operatorname{sin}⁡x\\operatorname{sin}⁡{60}^{∘} \\\\  & =\\operatorname{cos}⁡x\\cdot \\frac{1}{2}-\\operatorname{sin}⁡x\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =\\frac{\\operatorname{cos}⁡x}{2}-\\frac{\\sqrt{3}\\operatorname{sin}⁡x}{2} \\\\  & =\\frac{\\operatorname{cos}⁡x-\\sqrt{3}\\operatorname{sin}⁡x}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272273 :knowledge-point/_questions [{:db/id #edb/ref 17592186059821 :knowledge-point/id #uuid "c6a58962-cb06-519a-8c64-0dfa3b9c14d7" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1aff4cbe-6fe4-5b7e-818d-a180abe9eb18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186269488} {:answer/id #uuid "1ebb1f5f-41ff-5401-ad84-cc41307a79d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186269527} {:answer/id #uuid "38362095-3b1c-5bfd-9cc4-30473fe3b5bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186269776} {:answer/id #uuid "4003a8ec-c9e7-5741-ba8f-90325c814912" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡x-\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186269851} {:answer/id #uuid "ea19c52e-9497-565a-b200-4435179ca96d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186271320}] :answer-field/correct {:answer/id #uuid "4003a8ec-c9e7-5741-ba8f-90325c814912" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡x-\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186269851} :answer-field/id #uuid "fcc5eb38-7a7e-586b-9f31-c5ca7c948e10" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271946}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c98a2195-4ec8-5e2a-a4f5-76fb1079c255" :question/math-academy-id "q-141374" :question/problem "$\\operatorname{cos}⁡(x-{150}^{∘})=$" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for cosine with $u=x$ and $v={150}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x-{150}^{∘}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡{150}^{∘}+\\operatorname{sin}⁡x\\operatorname{sin}⁡{150}^{∘} \\\\  & =\\operatorname{cos}⁡x\\cdot (-\\frac{\\sqrt{3}}{2})+\\operatorname{sin}⁡x\\cdot \\frac{1}{2} \\\\  & =-\\frac{\\sqrt{3}\\operatorname{cos}⁡x}{2}+\\frac{\\operatorname{sin}⁡x}{2} \\\\  & =\\frac{\\operatorname{sin}⁡x-\\sqrt{3}\\operatorname{cos}⁡x}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272275 :knowledge-point/_questions [{:db/id #edb/ref 17592186059665 :knowledge-point/id #uuid "831f9aa0-099e-5e0c-8a9d-c4828b629f64" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b931fa1-ee52-5db3-bac9-497efc06f498" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)}{2}" :db/id #edb/ref 17592186269370} {:answer/id #uuid "2342b124-c9e0-58c0-a580-8d4f8695808a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186269577} {:answer/id #uuid "69b15b7b-0cac-5374-93f1-818c8990768a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186270207} {:answer/id #uuid "a358caaa-5c57-5746-b54c-5548bfb79b9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x-\\sqrt{3}\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186270725} {:answer/id #uuid "dff6ea96-0ee2-5bc4-80b8-7b9f1617a512" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡x-\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186271232}] :answer-field/correct {:answer/id #uuid "0b931fa1-ee52-5db3-bac9-497efc06f498" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)}{2}" :db/id #edb/ref 17592186269370} :answer-field/id #uuid "3f2bd73b-78d1-5e9e-92ad-582b63f4ea0e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271623}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "308956a9-f5f0-59d1-8748-67ba18adb1f8" :question/math-academy-id "q-141381" :question/problem "$\\operatorname{cos}⁡(x+\\frac{3\\pi }{4})=$" :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u+v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the sum formula for cosine with $u=x$ and $v=\\frac{3\\pi }{4},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x+\\frac{3\\pi }{4}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡(\\frac{3\\pi }{4})-\\operatorname{sin}⁡x\\operatorname{sin}⁡(\\frac{3\\pi }{4}) \\\\  & =\\operatorname{cos}⁡x\\cdot (-\\frac{\\sqrt{2}}{2})-\\operatorname{sin}⁡x\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =-\\frac{\\sqrt{2}\\operatorname{cos}⁡x}{2}-\\frac{\\sqrt{2}\\operatorname{sin}⁡x}{2} \\\\  & =-\\frac{\\sqrt{2}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272277 :knowledge-point/_questions [{:db/id #edb/ref 17592186059665 :knowledge-point/id #uuid "831f9aa0-099e-5e0c-8a9d-c4828b629f64" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a22d57d-9107-5ef5-9e1a-664d1e481595" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x+\\sqrt{3}\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186269651} {:answer/id #uuid "2e7bf421-a5a6-51a7-bbde-dcaec6ed4724" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186269688} {:answer/id #uuid "8a0c5476-651b-5c29-aaf7-9c8b4495a59a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)}{2}" :db/id #edb/ref 17592186270462} {:answer/id #uuid "8a8eb468-d843-5e6f-a576-53b1846a95f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x-\\sqrt{3}\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186270466} {:answer/id #uuid "ca8ff2c0-77a5-54e0-af66-4eb8ca206ccd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)}{2}" :db/id #edb/ref 17592186271048}] :answer-field/correct {:answer/id #uuid "2a22d57d-9107-5ef5-9e1a-664d1e481595" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x+\\sqrt{3}\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186269651} :answer-field/id #uuid "64d9c7cb-8c90-5531-a052-3b459d3163b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271688}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "bedf2d85-2b35-59e9-bfbf-70576d25817c" :question/math-academy-id "q-141386" :question/problem "$\\operatorname{cos}⁡(x-\\frac{\\pi }{3})=$" :question/worked-solution "First, we recall  the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for cosine with $u=x$ and $v=\\frac{\\pi }{3},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x-\\frac{\\pi }{3}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡(\\frac{\\pi }{3})+\\operatorname{sin}⁡x\\operatorname{sin}⁡(\\frac{\\pi }{3}) \\\\  & =\\operatorname{cos}⁡x\\cdot \\frac{1}{2}+\\operatorname{sin}⁡x\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =\\frac{\\operatorname{cos}⁡x}{2}+\\frac{\\sqrt{3}\\operatorname{sin}⁡x}{2} \\\\  & =\\frac{\\operatorname{cos}⁡x+\\sqrt{3}\\operatorname{sin}⁡x}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083535 :knowledge-point/_questions [{:db/id #edb/ref 17592186083232 :knowledge-point/id #uuid "1b5f9ee9-a489-5048-8346-0116a19e9b4a" :knowledge-point/title "Counting the Number of Possible Rational Roots of a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "311f9529-efb3-578e-8744-809e1101f04a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186269712} {:answer/id #uuid "6d3730b5-4247-558a-bff6-c3d95ce3ec3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186270236} {:answer/id #uuid "83f3968d-ef3f-53f0-ba78-c6e9d8fb524c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186270408} {:answer/id #uuid "86ca815b-5e6f-55e6-91c6-bd46a039a85f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186270438} {:answer/id #uuid "b1319d66-f133-598f-a450-27c576b92f22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186270851}] :answer-field/correct {:answer/id #uuid "b1319d66-f133-598f-a450-27c576b92f22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186270851} :answer-field/id #uuid "9ca9f1ac-2135-555e-8f76-360ce0db72a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271787}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "aeb1ad5f-0910-5dea-b64a-e03889cc2cc5" :question/math-academy-id "q-14145" :question/problem "For the polynomial $f(x)=10{x}^{6}-52{x}^{2}+50x-8,$ how many *potential* roots are given by the rational roots theorem?" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial:\n\n- The constant term is $-8,$ and its factors are $\\pm 1,$ $\\pm 2,$ $\\pm 4,$ and $\\pm 8.$\n\n- The leading coefficient is $10,$ and its factors are $\\pm 1,$ $\\pm 2,$ $\\pm 5,$ and $\\pm 10.$\n\nFirst, we list out all the possibilities for the numerator and denominator:\n\n$$\n\\begin{aligned}\\pm \\frac{1}{1}, & \\pm \\frac{1}{2}, & \\pm \\frac{1}{5}, & \\pm \\frac{1}{10}, \\\\ \\pm \\frac{2}{1}, & \\pm \\frac{2}{2}, & \\pm \\frac{2}{5}, & \\pm \\frac{2}{10}, \\\\ \\pm \\frac{4}{1}, & \\pm \\frac{4}{2}, & \\pm \\frac{4}{5}, & \\pm \\frac{4}{10}, \\\\ \\pm \\frac{8}{1}, & \\pm \\frac{8}{2}, & \\pm \\frac{8}{5}, & \\pm \\frac{8}{10}.\\end{aligned}\n$$\n\nNext, we reduce the fractions to lowest terms:\n\n$$\n\\begin{aligned}\\pm 1, & \\pm \\frac{1}{2}, & \\pm \\frac{1}{5}, & \\pm \\frac{1}{10}, \\\\ \\pm 2, & \\pm 1, & \\pm \\frac{2}{5}, & \\pm \\frac{1}{5}, \\\\ \\pm 4, & \\pm 2, & \\pm \\frac{4}{5}, & \\pm \\frac{2}{5}, \\\\ \\pm 8, & \\pm 4, & \\pm \\frac{8}{5}, & \\pm \\frac{4}{5}.\\end{aligned}\n$$\n\nNotice that several potential roots are duplicates (shown above in red). Removing these duplicates, and listing those remaining in order from least to greatest in absolute value, we have\n\n$$\n\\pm \\frac{1}{10},\\,\\pm \\frac{1}{5},\\,\\pm \\frac{2}{5},\\,\\pm \\frac{1}{2},\\,\\pm \\frac{4}{5},\\,\\pm 1,\\,\\pm \\frac{8}{5},\\,\\pm 2,\\,\\pm 4,\\,\\pm 8.\n$$\n\nThis makes a total of $20$ potential roots. (Remember that each $\\pm $ sign accounts for $2$ roots, and $2\\cdot 10=20.$)"}] [{:db/id #edb/ref 17592186272292 :knowledge-point/_questions [{:db/id #edb/ref 17592186068873 :knowledge-point/id #uuid "f10e4a34-a512-5ff4-abbc-66e6830d63d0" :knowledge-point/title "Completing the Square When the Perfect Square is Isolated"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "110ee8cd-e830-5bb3-bab0-f16cb26fe2b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+4{)}^{2}-3" :db/id #edb/ref 17592186269421} {:answer/id #uuid "13e31713-81cb-5dec-8652-93d586dd34fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-3{)}^{2}-3" :db/id #edb/ref 17592186269445} {:answer/id #uuid "29d7d2be-f02c-521d-b752-bf360c856fdf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+3{)}^{2}-3" :db/id #edb/ref 17592186269648} {:answer/id #uuid "5eb20cc7-de16-5bcf-8e1b-43826770ca5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-6{)}^{2}-3" :db/id #edb/ref 17592186270109} {:answer/id #uuid "f84d763b-739b-535d-8995-04b2349046b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+6{)}^{2}-3" :db/id #edb/ref 17592186271448}] :answer-field/correct {:answer/id #uuid "f84d763b-739b-535d-8995-04b2349046b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+6{)}^{2}-3" :db/id #edb/ref 17592186271448} :answer-field/id #uuid "ee48d03a-569e-51f8-be78-887782d15f39" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271927}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "48f5b61f-2f3f-5cda-a551-c1e861cdd220" :question/math-academy-id "q-141513" :question/problem "Rewrite the expression $({y}^{2}+12y+{6}^{2})-3$ as the difference between a perfect square and a constant." :question/worked-solution "First, we recall the following formula:\n\n$$\n{y}^{2}+2ay+{a}^{2}=(y+a{)}^{2}\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{y}^{2}+12y+{6}^{2} & = \\\\ {y}^{2}+2\\cdot 6y+{6}^{2} & = \\\\ (y+6{)}^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({y}^{2}+12y+{6}^{2})-3 & = \\\\ (y+6{)}^{2}-3 & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272294 :knowledge-point/_questions [{:db/id #edb/ref 17592186184169 :knowledge-point/id #uuid "ec6076ff-1538-5bc0-973d-33d908b0b4d2" :knowledge-point/title "Completing the Square on a Quadratic Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31012e79-2696-578b-952b-a385f9bb0eb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(y+\\frac{11}{2})}^{2}-\\frac{21}{4}" :db/id #edb/ref 17592186269711} {:answer/id #uuid "80e62b24-0b58-586c-ab5e-10a92a99e5ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(y+\\frac{11}{2})}^{2}-5" :db/id #edb/ref 17592186270386} {:answer/id #uuid "8e8982a4-a551-5a56-96cc-144410267cb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(y+\\frac{11}{2})}^{2}-\\frac{25}{4}" :db/id #edb/ref 17592186270506} {:answer/id #uuid "94a242c2-81bc-53a1-99fc-de5cfa4e26aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(y+\\frac{11}{4})}^{2}-\\frac{21}{2}" :db/id #edb/ref 17592186270571} {:answer/id #uuid "eaa96b06-cbed-595d-86c7-fdb048fe292f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(y+\\frac{11}{4})}^{2}-5" :db/id #edb/ref 17592186271324}] :answer-field/correct {:answer/id #uuid "31012e79-2696-578b-952b-a385f9bb0eb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(y+\\frac{11}{2})}^{2}-\\frac{21}{4}" :db/id #edb/ref 17592186269711} :answer-field/id #uuid "40dc7a0f-2584-5d4a-b845-07be3a13c2db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271628}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b17fd33d-fef8-5118-8c44-b94f68ba1d49" :question/math-academy-id "q-141527" :question/problem "Complete the square on the quadratic expression ${y}^{2}+11y+25.$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}+2\\cdot \\frac{11}{2}y+25\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${(\\frac{11}{2})}^{2},$ writing the constant term $25$ last:\n\n$$\n{{y}^{2}+2\\cdot \\frac{11}{2}y+{(\\frac{11}{2})}^{2}}_{⏟}-{(\\frac{11}{2})}^{2}+25\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(y+\\frac{11}{2})}^{2}-{(\\frac{11}{2})}^{2}+25\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n{(y+\\frac{11}{2})}^{2}-\\frac{21}{4}.\n$$"}] [{:db/id #edb/ref 17592186272295 :knowledge-point/_questions [{:db/id #edb/ref 17592186184169 :knowledge-point/id #uuid "ec6076ff-1538-5bc0-973d-33d908b0b4d2" :knowledge-point/title "Completing the Square on a Quadratic Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20d0ce94-71f7-556b-a0d7-7b5e20af96e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(y+\\frac{7}{2})}^{2}-\\frac{49}{4}" :db/id #edb/ref 17592186269547} {:answer/id #uuid "5c56dfc4-4aef-5331-872d-da2b2274bae2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(y+\\frac{7}{2})}^{2}-\\frac{7}{4}" :db/id #edb/ref 17592186270094} {:answer/id #uuid "bbd458c1-82ff-5e70-925e-2f5ec028580c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(y+\\frac{7}{2})}^{2}-7" :db/id #edb/ref 17592186270924} {:answer/id #uuid "ca96e8bc-27e6-5cce-ac58-a15424f3db5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(y+\\frac{7}{4})}^{2}-7" :db/id #edb/ref 17592186271049} {:answer/id #uuid "e14d5b9e-029a-5589-8dcb-8d46977be99b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(y+\\frac{7}{4})}^{2}-\\frac{7}{2}" :db/id #edb/ref 17592186271248}] :answer-field/correct {:answer/id #uuid "20d0ce94-71f7-556b-a0d7-7b5e20af96e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(y+\\frac{7}{2})}^{2}-\\frac{49}{4}" :db/id #edb/ref 17592186269547} :answer-field/id #uuid "4b5ddc0f-2757-59e8-9e14-a04b8fd5611f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271648}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f6ca9c1a-eab9-55fb-98fa-ee3277281e1b" :question/math-academy-id "q-141536" :question/problem "Complete the square on the quadratic expression ${y}^{2}+7y.$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}+2\\cdot \\frac{7}{2}y\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${(\\frac{7}{2})}^{2}:$\n\n$$\n{{y}^{2}+2\\cdot \\frac{7}{2}y+{(\\frac{7}{2})}^{2}}_{⏟}-{(\\frac{7}{2})}^{2}\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(y+\\frac{7}{2})}^{2}-{(\\frac{7}{2})}^{2}\n$$\n\nFinally, evaluating the last term, we get\n\n$$\n{(y+\\frac{7}{2})}^{2}-\\frac{49}{4}.\n$$"}] [{:db/id #edb/ref 17592186272296 :knowledge-point/_questions [{:db/id #edb/ref 17592186068875 :knowledge-point/id #uuid "366b36a5-c909-5ea5-a05d-a6052fcd41d7" :knowledge-point/title "Completing the Square on a Quadratic Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "129c0ce9-31d0-501f-9253-202530581425" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+5{)}^{2}+10" :db/id #edb/ref 17592186269432} {:answer/id #uuid "1e413b35-35e1-5ce6-a283-f4ff4b83d4f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+10{)}^{2}-5" :db/id #edb/ref 17592186269522} {:answer/id #uuid "395d3e65-bf9a-53cf-a730-73e30942c7aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+5{)}^{2}-9" :db/id #edb/ref 17592186269789} {:answer/id #uuid "899c0f97-acdd-567e-ab3c-221326e9fa7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+5{)}^{2}+12" :db/id #edb/ref 17592186270456} {:answer/id #uuid "d9c19f26-9f49-5230-b707-0daae3af6b9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+5{)}^{2}-7" :db/id #edb/ref 17592186271177}] :answer-field/correct {:answer/id #uuid "395d3e65-bf9a-53cf-a730-73e30942c7aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+5{)}^{2}-9" :db/id #edb/ref 17592186269789} :answer-field/id #uuid "12b561ff-d7d5-56bf-bd70-881cdbd1aea3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271540}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c7d3420b-3f28-5142-8868-756f1394ea88" :question/math-academy-id "q-141537" :question/problem "Complete the square on the quadratic expression ${x}^{2}+10x+16.$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}+2\\cdot 5x+16\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${5}^{2},$ writing the constant term $16$ last:\n\n$$\n{{x}^{2}+2\\cdot 5x+{5}^{2}}_{⏟}-\\,{5}^{2}+16\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(x+5{)}^{2}-{5}^{2}+16\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n(x+5{)}^{2}-9.\n$$"}] [{:db/id #edb/ref 17592186400930 :knowledge-point/_questions [{:db/id #edb/ref 17592186068875 :knowledge-point/id #uuid "366b36a5-c909-5ea5-a05d-a6052fcd41d7" :knowledge-point/title "Completing the Square on a Quadratic Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4bc4897-6558-52b5-bb24-657fa38a810c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=6,\\,q=8" :db/id #edb/ref 17592186400932} {:answer/id #uuid "62f6fb47-ecea-56a8-9070-83fc55e7254f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=3,\\,q=-5" :db/id #edb/ref 17592186400933} {:answer/id #uuid "3d43940b-e27a-5dff-9dca-bf6857baf92f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=3,\\,q=5" :db/id #edb/ref 17592186400934} {:answer/id #uuid "bdeaea36-9352-52ca-8483-6b276a77d472" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=6,\\,q=7" :db/id #edb/ref 17592186400935} {:answer/id #uuid "bfc66d56-1a8c-5626-b30a-e9774929570d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=3,\\,q=-4" :db/id #edb/ref 17592186400936}] :answer-field/correct {:answer/id #uuid "3d43940b-e27a-5dff-9dca-bf6857baf92f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=3,\\,q=5" :db/id #edb/ref 17592186400934} :answer-field/id #uuid "95bbc964-13ea-55a0-9065-a7c49f46fb65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400931}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bd1c73ef-6818-5b51-baee-cca065c2f0da" :question/math-academy-id "q-141539" :question/problem "If the expression ${x}^{2}+6x+14$ is written as $(x+p{)}^{2}+q,$ then what are the values of $p$ and $q?$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}+2\\cdot 3x+14\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${3}^{2},$ writing the constant term $14$ last:\n\n$$\n{{x}^{2}+2\\cdot 3x+{3}^{2}}_{⏟}-\\,{3}^{2}+14\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(x+3{)}^{2}-{3}^{2}+14\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n(x+3{)}^{2}+5.\n$$\n\nTherefore, $p=3$ and $q=5.$"}] [{:db/id #edb/ref 17592186272300 :knowledge-point/_questions [{:db/id #edb/ref 17592186184170 :knowledge-point/id #uuid "1481d4a2-64b4-590a-9dbb-c39d3364bb59" :knowledge-point/title "Expressions Containing a Negative Linear Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2209d435-198d-515f-b8b4-60c9562f6bdd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x+\\frac{11}{2})}^{2}-\\frac{9}{2}" :db/id #edb/ref 17592186269560} {:answer/id #uuid "273798d5-f257-5699-8aa9-4f4c2f307f49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x+\\frac{11}{2})}^{2}-\\frac{7}{2}" :db/id #edb/ref 17592186269613} {:answer/id #uuid "3692e43f-c9b5-5ffd-8fc6-a562924ff89c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x-\\frac{11}{2})}^{2}-\\frac{15}{4}" :db/id #edb/ref 17592186269764} {:answer/id #uuid "7a671224-3dde-5038-92af-e145da2474b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x-\\frac{11}{2})}^{2}-\\frac{11}{4}" :db/id #edb/ref 17592186270352} {:answer/id #uuid "8e191cef-1fcc-5bb8-9ab2-aa4afff1bdaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x-\\frac{11}{2})}^{2}-\\frac{21}{4}" :db/id #edb/ref 17592186270499}] :answer-field/correct {:answer/id #uuid "8e191cef-1fcc-5bb8-9ab2-aa4afff1bdaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x-\\frac{11}{2})}^{2}-\\frac{21}{4}" :db/id #edb/ref 17592186270499} :answer-field/id #uuid "1f9eedf2-2e58-52db-8e06-a9079bb28565" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271567}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b33c0ce6-8797-5117-a675-fc9bb0069eae" :question/math-academy-id "q-141552" :question/problem "Complete the square on the quadratic expression ${x}^{2}-11x+25.$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}-2\\cdot \\frac{11}{2}x+25\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${(\\frac{11}{2})}^{2},$ writing the constant term $25$ last:\n\n$$\n{{x}^{2}-2\\cdot \\frac{11}{2}x+{(\\frac{11}{2})}^{2}}_{⏟}-{(\\frac{11}{2})}^{2}+25\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(x-\\frac{11}{2})}^{2}-{(\\frac{11}{2})}^{2}+25\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n{(x-\\frac{11}{2})}^{2}-\\frac{21}{4}.\n$$"}] [{:db/id #edb/ref 17592186272304 :knowledge-point/_questions [{:db/id #edb/ref 17592186068876 :knowledge-point/id #uuid "08c6d8d6-3d86-5074-bf99-0cb744c9412a" :knowledge-point/title "Completing the Square on a Quadratic Expression with a Negative Linear Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b8b2afd-fb57-5e61-8b75-209b9cfb00a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-4{)}^{2}+1" :db/id #edb/ref 17592186269948} {:answer/id #uuid "56189019-79f9-5478-aff6-fce083001fda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-2{)}^{2}-4" :db/id #edb/ref 17592186270032} {:answer/id #uuid "5b5b5397-8f7e-5320-893a-7dfa34d502d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-2{)}^{2}+3" :db/id #edb/ref 17592186270081} {:answer/id #uuid "b8a21ffd-56c6-5136-bf66-bc5dc8d6441d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-2{)}^{2}+6" :db/id #edb/ref 17592186270901} {:answer/id #uuid "e1c6894a-0f18-540f-812c-d0d96b4ec938" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-4{)}^{2}+5" :db/id #edb/ref 17592186271252}] :answer-field/correct {:answer/id #uuid "b8a21ffd-56c6-5136-bf66-bc5dc8d6441d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-2{)}^{2}+6" :db/id #edb/ref 17592186270901} :answer-field/id #uuid "072e8659-a896-55fe-8d54-28d07c46a912" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271518}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7c43e9bd-a43d-5cc8-ba55-c5e66008e58c" :question/math-academy-id "q-141612" :question/problem "Complete the square on the quadratic expression ${y}^{2}-4y+10.$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}-2\\cdot 2y+10\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${2}^{2},$ writing the constant term $10$ last:\n\n$$\n{{y}^{2}-2\\cdot 2y+{2}^{2}}_{⏟}-\\,{2}^{2}+10\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(y-2{)}^{2}-{2}^{2}+10\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n(y-2{)}^{2}+6.\n$$"}] [{:db/id #edb/ref 17592186400937 :knowledge-point/_questions [{:db/id #edb/ref 17592186068876 :knowledge-point/id #uuid "08c6d8d6-3d86-5074-bf99-0cb744c9412a" :knowledge-point/title "Completing the Square on a Quadratic Expression with a Negative Linear Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d53fe67-7a37-5135-9bda-59dc26da7eba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=-5,\\text{ }q=10" :db/id #edb/ref 17592186400939} {:answer/id #uuid "9b5c7488-0854-5209-9e72-78867a6a1be6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=5,\\text{ }q=5" :db/id #edb/ref 17592186400940} {:answer/id #uuid "a2ec775e-a603-50a4-a821-b02cc8bdf4a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=-10,\\text{ }q=5" :db/id #edb/ref 17592186400941} {:answer/id #uuid "91f01cc1-7dda-5a0a-a09b-a1edcdb5224f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=-5,\\text{ }q=5" :db/id #edb/ref 17592186400942} {:answer/id #uuid "c0e81c67-49e3-5deb-9f3d-4bfdd5f4f433" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=5,\\text{ }q=-5" :db/id #edb/ref 17592186400943}] :answer-field/correct {:answer/id #uuid "91f01cc1-7dda-5a0a-a09b-a1edcdb5224f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=-5,\\text{ }q=5" :db/id #edb/ref 17592186400942} :answer-field/id #uuid "c559c184-d951-52c2-ae9b-1fd6b5cd4853" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400938}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a81398bc-73ed-504a-b8b3-ef512650d7f6" :question/math-academy-id "q-141622" :question/problem "If the expression ${y}^{2}-10y+30$ is written as $(y+p{)}^{2}+q,$ then what are the values of $p$ and $q?$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}-2\\cdot 5y+30\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${5}^{2},$ writing the constant term $30$ last:\n\n$$\n{{y}^{2}-2\\cdot 5y+{5}^{2}}_{⏟}-\\,{5}^{2}+30\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(y-5{)}^{2}-{5}^{2}+30\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n(y-5{)}^{2}+5.\n$$\n\nTherefore, $p=-5$ and $q=5.$"}] [{:db/id #edb/ref 17592186400944 :knowledge-point/_questions [{:db/id #edb/ref 17592186064312 :knowledge-point/id #uuid "3bd5c660-b216-59b4-b2bb-df83ef864b2a" :knowledge-point/title "Determining Concave Up and Concave Down Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52634bca-83b3-54b7-95a5-9e44e545d6f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186400946} {:answer/id #uuid "01dbf8ef-0546-56c6-8042-b514ff678457" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186400947} {:answer/id #uuid "13883436-b2ee-5552-ac8d-52c81b763494" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186400948} {:answer/id #uuid "b001b5b2-84bb-5ff9-8a1e-ad85dd8dd376" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186400949} {:answer/id #uuid "34858f57-efb3-57e6-9b45-36ddb2034af5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186400950}] :answer-field/correct {:answer/id #uuid "34858f57-efb3-57e6-9b45-36ddb2034af5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186400950} :answer-field/id #uuid "fc09fe3d-b285-5568-9b7d-7d325bd277b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400945}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9955f0fd-f850-5637-ae70-443f1b225d5d" :question/math-academy-id "q-141738" :question/problem "![](images/7d/7d2f7497d6a11b4ceb994755498ef49bf0ce414601ab812dc55555c769a076ec.png)\n\nWhich of the curves above are concave up?" :question/worked-solution "The concavity of a function refers to the direction in which its graph curves.\n\n- If the graph curves upward, like a \"smile\" ($⌣$), then the graph is said to be *concave up*.\n\n- If the graph curves downward, like a \"frown\" ($⌢$), then the graph is said to be *concave down*.\n\nIt's helpful to remember the mnemonic \"concave down like a frown.\"\n\nOnly graph II curves upward (like a \"smile\") among the given graphs."}] [{:db/id #edb/ref 17592186400951 :knowledge-point/_questions [{:db/id #edb/ref 17592186064312 :knowledge-point/id #uuid "3bd5c660-b216-59b4-b2bb-df83ef864b2a" :knowledge-point/title "Determining Concave Up and Concave Down Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f7059f97-c797-51ad-be0a-f96acec895ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186400953} {:answer/id #uuid "1e18716e-efdf-5322-a98c-f7741d67d8d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186400954} {:answer/id #uuid "028c6bbc-5127-5736-b3ba-9f94a0f28ed4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186400955} {:answer/id #uuid "3daa75bf-f787-56ff-9dca-1b80759e9c6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186400956} {:answer/id #uuid "d4912560-949d-5a8e-9911-c20ce554555e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186400957}] :answer-field/correct {:answer/id #uuid "1e18716e-efdf-5322-a98c-f7741d67d8d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186400954} :answer-field/id #uuid "b71eae7c-91a7-5647-b98b-5b82bc79007f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400952}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8be6241f-30ce-53dd-8d31-e6a859245baf" :question/math-academy-id "q-141740" :question/problem "![](images/2f/2f07f2751398a101b41bc2c923fcdd7f6a5144da00008904297c36b2d8d44a30.png)\n\nWhich of the curves above are concave up?" :question/worked-solution "The concavity of a function refers to the direction in which its graph curves.\n\n- If the graph curves upward, like a \"smile\" ($⌣$), then the graph is said to be *concave up*.\n\n- If the graph curves downward, like a \"frown\" ($⌢$), then the graph is said to be *concave down*.\n\nIt's helpful to remember the mnemonic \"concave down like a frown.\"\n\nOnly graphs I and III curve upward (like a \"smile\") among the given graphs."}] [{:db/id #edb/ref 17592186388841 :knowledge-point/_questions [{:db/id #edb/ref 17592186184232 :knowledge-point/id #uuid "c872e855-895e-5369-8a79-cbdf21133548" :knowledge-point/title "Solving a Quadratic Equation Given a Corresponding Perfect Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c9dab48-f4ec-50d5-997f-66003dcb0d90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{1}{2},\\,\\frac{3}{2}" :db/id #edb/ref 17592186388843} {:answer/id #uuid "78463560-21e0-5b25-866c-e90cd7340bbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-3\\pm \\frac{1}{\\sqrt{2}}" :db/id #edb/ref 17592186388844} {:answer/id #uuid "b9db4f34-08d3-52b7-b130-1953818d1cdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{11}{2},\\,\\frac{3}{2}" :db/id #edb/ref 17592186388845} {:answer/id #uuid "ef8898ba-df5f-5bff-a12b-8e45e358e308" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{11}{2},\\,-\\frac{1}{2}" :db/id #edb/ref 17592186388846} {:answer/id #uuid "cdcc5cac-e58c-525f-92e0-44013ae6b5ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-3\\pm \\frac{5}{\\sqrt{2}}" :db/id #edb/ref 17592186388847}] :answer-field/correct {:answer/id #uuid "ef8898ba-df5f-5bff-a12b-8e45e358e308" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{11}{2},\\,-\\frac{1}{2}" :db/id #edb/ref 17592186388846} :answer-field/id #uuid "32deee12-64c9-53b5-a191-c9595d854af8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388842}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6cd3a3fd-0ec4-5982-bdba-cd236ee44004" :question/math-academy-id "q-141811" :question/problem "Solve the equation $4{x}^{2}+24x=-11.$ \n\n*Hint: Use the fact that ${x}^{2}+6x+9$ is a perfect square.*" :question/worked-solution "Using the hint, we have\n\n$$\n{x}^{2}+6x+9=(x+3)^{2}.\n$$\n\nFirst, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}4{x}^{2}+24x & =-11 \\\\ 4({x}^{2}+6x) & =-11 \\\\ 4({x}^{2}+2\\cdot 3x) & =-11 \\\\ 4({x}^{2}+2\\cdot 3x+{3}^{2}-{3}^{2}) & =-11 \\\\ 4[(x+3)^{2}-{3}^{2}] & =-11 \\\\ 4[(x+3)^{2}-9] & =-11 \\\\ 4(x+3)^{2}-36 & =-11\\end{aligned}\n$$\n\nIsolating the perfect square by adding $36$ to both sides and then dividing by $4,$ we get\n\n$$\n\\begin{aligned}4(x+3)^{2}-36 & =-11 \\\\ 4(x+3)^{2}-36+36 & =-11+36 \\\\ 4(x+3)^{2} & =25 \\\\ (x+3)^{2} & =\\frac{25}{4}.\\end{aligned}\n$$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x+3)^{2} & =\\frac{25}{4} \\\\ \\sqrt{(x+3)^{2}} & =\\sqrt{\\frac{25}{4}} \\\\ |x+3| & =\\frac{5}{2} \\\\ x+3 & =\\pm \\frac{5}{2} \\\\ x & =-3\\pm \\frac{5}{2} \\\\ x & =-\\frac{11}{2},\\,-\\frac{1}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272309 :knowledge-point/_questions [{:db/id #edb/ref 17592186068827 :knowledge-point/id #uuid "c3e24f9c-d383-5b77-a22a-8e142a072f0a" :knowledge-point/title "Solving a Quadratic Equation Given a Corresponding Perfect Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33162c16-a26a-585b-b93a-caff202d8543" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186269736} {:answer/id #uuid "472c723c-83ab-5626-ad0b-8949bf5249de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186269915} {:answer/id #uuid "929563b1-603a-55ce-b34f-10a3c1c67754" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "104" :db/id #edb/ref 17592186270550} {:answer/id #uuid "dbafdf59-1e66-5dce-9f48-65bc473487a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186271191} {:answer/id #uuid "f1de299d-a3c5-5ebc-80da-bb0051f2d8ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "109" :db/id #edb/ref 17592186271392}] :answer-field/correct {:answer/id #uuid "929563b1-603a-55ce-b34f-10a3c1c67754" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "104" :db/id #edb/ref 17592186270550} :answer-field/id #uuid "16c6ad9b-646e-5a06-a5b2-bcae2f52ebb1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271547}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f0de10d9-8ebd-58e0-b040-9c2f5e59c9c7" :question/math-academy-id "q-141812" :question/problem "Let ${x}_{1}$ and ${x}_{2}$ be the solutions of the equation ${x}^{2}-8x=20.$ Find the value ${x}_{1}^{2}+{x}_{2}^{2}.$ \n\n*Hint: Use the fact that ${x}^{2}-8x+16$ is a perfect square.*" :question/worked-solution "Using the hint, we have\n\n$$\n{x}^{2}-8x+16=(x-4{)}^{2}.\n$$\n\nFirst, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-8x & =20 \\\\ {x}^{2}-2\\cdot 4\\cdot x & =20 \\\\ {x}^{2}-2\\cdot 4\\cdot x+{4}^{2}-{4}^{2} & =20 \\\\ (x-4{)}^{2}-16 & =20\\end{aligned}\n$$\n\nNext, we isolate the perfect square by adding $16$ to both sides:\n\n$$\n\\begin{aligned}(x-4{)}^{2}-16+16 & =20+16 \\\\ (x-4{)}^{2} & =36\\end{aligned}\n$$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-4{)}^{2} & =36 \\\\ \\sqrt{(x-4{)}^{2}} & =\\sqrt{36} \\\\ |x-4| & =6 \\\\ x-4 & =\\pm 6 \\\\ x & =4\\pm 6\\end{aligned}\n$$\n\nFinally, we simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =4-6=-2 \\\\ {x}_{2} & =4+6=10\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{x}_{1}^{2}+{x}_{2}^{2}=(-2{)}^{2}+{10}^{2}=104.\n$$"}] [{:db/id #edb/ref 17592186272310 :knowledge-point/_questions [{:db/id #edb/ref 17592186184232 :knowledge-point/id #uuid "c872e855-895e-5369-8a79-cbdf21133548" :knowledge-point/title "Solving a Quadratic Equation Given a Corresponding Perfect Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "241b1404-c2aa-575d-8065-ec106981f5a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-4\\pm \\frac{\\sqrt{2}}{5}" :db/id #edb/ref 17592186269585} {:answer/id #uuid "7919a728-b543-536d-8054-0a184713c2b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2\\pm \\frac{\\sqrt{5}}{2}" :db/id #edb/ref 17592186270341} {:answer/id #uuid "c82102a0-f740-5514-9212-0b3cd8c1d0c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4\\pm \\frac{2}{\\sqrt{5}}" :db/id #edb/ref 17592186271031} {:answer/id #uuid "e3105ac8-37d5-5739-abc9-4ef7c2fc18d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4\\pm \\frac{5}{\\sqrt{2}}" :db/id #edb/ref 17592186271267} {:answer/id #uuid "f25bf37e-9c95-5124-b37f-32e6744d69d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2\\pm \\frac{2}{\\sqrt{5}}" :db/id #edb/ref 17592186271399}] :answer-field/correct {:answer/id #uuid "c82102a0-f740-5514-9212-0b3cd8c1d0c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4\\pm \\frac{2}{\\sqrt{5}}" :db/id #edb/ref 17592186271031} :answer-field/id #uuid "fbe18474-5ded-5269-8f07-0ba5488b85e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271944}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7c3581b3-19ec-58f3-879c-94addceac5e6" :question/math-academy-id "q-141817" :question/problem "Solve the equation $5{y}^{2}-40y=-76.$ \n\n*Hint: Use the fact that ${y}^{2}-8y+16$ is a perfect square.*" :question/worked-solution "Using the hint, we have\n\n$$\n{y}^{2}-8y+16=(y-4)^{2}.\n$$\n\nFirst, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}5{y}^{2}-40y & =-76 \\\\ 5({y}^{2}-8y) & =-76 \\\\ 5({y}^{2}-2\\cdot 4y) & =-76 \\\\ 5({y}^{2}-2\\cdot 4y+{4}^{2}-{4}^{2}) & =-76 \\\\ 5[(y-4)^{2}-{4}^{2}] & =-76 \\\\ 5[(y-4)^{2}-16] & =-76 \\\\ 5(y-4)^{2}-80 & =-76\\end{aligned}\n$$\n\nIsolating the perfect square by adding $80$ to both sides and then dividing by $5,$ we get\n\n$$\n\\begin{aligned}5(y-4)^{2}-80 & =-76 \\\\ 5(y-4)^{2}-80+80 & =-76+80 \\\\ 5(y-4)^{2} & =4 \\\\ (y-4)^{2} & =\\frac{4}{5}.\\end{aligned}\n$$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(y-4)^{2} & =\\frac{4}{5} \\\\ \\sqrt{(y-4)^{2}} & =\\sqrt{\\frac{4}{5}} \\\\ |y-4| & =\\frac{2}{\\sqrt{5}} \\\\ y-4 & =\\pm \\frac{2}{\\sqrt{5}} \\\\ y & =4\\pm \\frac{2}{\\sqrt{5}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272314 :knowledge-point/_questions [{:db/id #edb/ref 17592186096707 :knowledge-point/id #uuid "ddc6c4b1-b4c4-52f8-9f25-feda3130e358" :knowledge-point/title "Calculating the Intercepts of a Parabola Given Its Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05c261f4-b523-5e38-b911-79bebe41075e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(21,0)" :db/id #edb/ref 17592186269321} {:answer/id #uuid "b0e7353a-2dd4-5608-ac70-fe6d8e0291e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,21)" :db/id #edb/ref 17592186270848} {:answer/id #uuid "bbe132bb-0af0-51c8-afe2-8c3302082c29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-21,0)" :db/id #edb/ref 17592186270925} {:answer/id #uuid "bc901ce9-1a00-525b-a2cd-700e1bd17ebd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-12,0)" :db/id #edb/ref 17592186270928} {:answer/id #uuid "c301dd7e-cbc1-5a8b-80c7-f2bfe83da7ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(12,0)" :db/id #edb/ref 17592186270994}] :answer-field/correct {:answer/id #uuid "05c261f4-b523-5e38-b911-79bebe41075e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(21,0)" :db/id #edb/ref 17592186269321} :answer-field/id #uuid "7e2b396b-77e2-5134-94df-60067b3ce9c0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271732}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "08773f73-4575-52a7-9948-7d0d1e95d791" :question/math-academy-id "q-14185" :question/problem "Find the point of intersection of the parabola ${y}^{2}-x+10y+21=0$ with the $x$-axis." :question/worked-solution "When the parabola intersects the $x$-axis, we must have $y=0.$ So, we set $y=0$ and solve the resulting equation for $x:$\n\n$$\n\\begin{aligned}{y}^{2}-x+10y+21 & =0 \\\\ (0)^{2}-x+10(0)+21 & =0 \\\\ -x+21 & =0 \\\\ x & =21\\end{aligned}\n$$\n\nTherefore, the parabola intersects the $x$-axis at $(21,0).$"}] [{:db/id #edb/ref 17592186272318 :knowledge-point/_questions [{:db/id #edb/ref 17592186064285 :knowledge-point/id #uuid "51c15d7a-cd9c-58df-a750-97df0b695c64" :knowledge-point/title "Determining Intervals of Concavity From the Graph of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "591bd29b-f88e-5bec-aeeb-18b7f495581c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-3,-2)$ and $(-1,0)$" :db/id #edb/ref 17592186270056} {:answer/id #uuid "6d007451-1012-551a-a1a2-6cd3617e7a88" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-2,-1)$ and $(-1,0)$" :db/id #edb/ref 17592186270235} {:answer/id #uuid "8924c245-63c5-593a-ac04-35ad4e886a52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-1,0)$ only" :db/id #edb/ref 17592186270451} {:answer/id #uuid "d6dcb6bb-a92a-5a25-976f-4cbc5392b851" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-2,-1)$ only" :db/id #edb/ref 17592186271155} {:answer/id #uuid "e526b157-5281-503f-a120-9b2f67b7b748" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-3,-2)$ only" :db/id #edb/ref 17592186271289}] :answer-field/correct {:answer/id #uuid "6d007451-1012-551a-a1a2-6cd3617e7a88" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-2,-1)$ and $(-1,0)$" :db/id #edb/ref 17592186270235} :answer-field/id #uuid "0a4abf10-6ff0-5441-9d67-0a97db0614ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271523}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "81b50d75-05a1-5fec-ae6a-c17be8793e34" :question/math-academy-id "q-141937" :question/problem "![](images/58/583cde62650a6940389d807eee0ffeabdafcbb0da7b8d416af88e3c4d1b7bd71.png)\n\nThe graph above shows the function $y=f(x),$ defined on $[-3,0].$ Find the intervals on which the function $f(x)$ is concave down." :question/worked-solution "The concavity of a function refers to the direction in which its graph curves.\n\n- If the graph curves upward, like a \"smile\" ($⌣$), then the graph is said to be *concave up*.\n\n- If the graph curves downward, like a \"frown\" ($⌢$), then the graph is said to be *concave down*.\n\nIt's helpful to remember the mnemonic \"concave down like a frown.\"\n\nWe can see that the function is curved downwards like a frown ($⌢$) over the intervals $(-2,-1)$ and $(-1,0)$\n\n![](images/ce/ce57fc818eebd0cc5007e80a54b49d613eeb2823eefc98e946862ff9f7b68e0b.png)"}] [{:db/id #edb/ref 17592186398466 :knowledge-point/_questions [{:db/id #edb/ref 17592186184148 :knowledge-point/id #uuid "dac9c72b-c23f-56fa-b939-6e3b56d3a13b" :knowledge-point/title "Identifying the Horizontal Stretch and Vertical Shift of a Transformed Cotangent Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "accd213e-a18c-57f9-a2cf-0e3297615ffe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186398468} {:answer/id #uuid "bd8269e6-822d-57d9-a7d5-81b77feea90f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186398469} {:answer/id #uuid "b6d90684-6641-5156-b37c-32b02b1bdd9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186398470} {:answer/id #uuid "21d7fa3c-5da8-50fa-8d80-231c8289856a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186398471} {:answer/id #uuid "70cad25b-cabf-5869-8148-7ca6a521ce0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186398472}] :answer-field/correct {:answer/id #uuid "bd8269e6-822d-57d9-a7d5-81b77feea90f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186398469} :answer-field/id #uuid "412e6109-4d77-5424-95b6-1257add5ac9c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398467}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b85652aa-105e-56e5-bee4-742b27b9d838" :question/math-academy-id "q-141999" :question/problem "![](images/8b/8b237f9e857b1ed87de447aa79c14d359429e71d8afe7ab8eab201eba7ffb6af.png)\n\nThe graph above shows the function $y=\\operatorname{cot}⁡(Bx)+D,$ where $B$ and $D$ are constants. What is  $B+2D?$" :question/worked-solution "The period $T$ of the function is $\\frac{\\pi }{2}.$\n\nThe formula for the period $T$ of the function $y=A\\operatorname{cot}⁡(Bx+C)+D$ is given by \n\n$$\nT=\\frac{\\pi }{B}.\n$$\n\nApplying the formula of the period, we get\n\n$$\n\\frac{\\pi }{2}=\\frac{\\pi }{B}\\,⟹\\,B=\\frac{\\pi }{(\\frac{\\pi }{2})}=2.\n$$\n\nThe parameter $D$ represents the vertical shift of the cotangent function. We see that the function has been translated by $1$ unit up. Therefore, $D=1.$\n\nTherefore, $B+2D=2+2\\cdot (1)=2+2=4.$  \n\nFinally, the equation of the curve is\n\n$$\ny=\\operatorname{cot}⁡(2x)+1.\n$$"}] [{:db/id #edb/ref 17592186272321 :knowledge-point/_questions [{:db/id #edb/ref 17592186068827 :knowledge-point/id #uuid "c3e24f9c-d383-5b77-a22a-8e142a072f0a" :knowledge-point/title "Solving a Quadratic Equation Given a Corresponding Perfect Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08658d01-89d0-5f4d-8f01-ca95f49a8f8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "68" :db/id #edb/ref 17592186269345} {:answer/id #uuid "91635a34-3072-5810-bbe9-632fc13648c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "58" :db/id #edb/ref 17592186270534} {:answer/id #uuid "b63daf1b-11dc-55f7-bcdf-962180261257" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186270887} {:answer/id #uuid "c16cb9a6-c3c8-5125-ae28-f529c2244338" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186270983} {:answer/id #uuid "f5121dc9-a221-5173-bccc-27c79eacbf3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186271416}] :answer-field/correct {:answer/id #uuid "91635a34-3072-5810-bbe9-632fc13648c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "58" :db/id #edb/ref 17592186270534} :answer-field/id #uuid "3f3ef694-6ed8-54b6-8d68-ea9692dda819" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271625}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "36afe386-dcce-5814-bb16-64bd8f39ae6b" :question/math-academy-id "q-142015" :question/problem "Let ${x}_{1}$ and ${x}_{2}$ be the solutions of the equation ${x}^{2}-10x=-21.$ Find the value ${x}_{1}^{2}+{x}_{2}^{2}.$ \n\n*Hint: Use the fact that ${x}^{2}-10x+25$ is a perfect square.*" :question/worked-solution "Using the hint, we have\n\n$$\n{x}^{2}-10x+25=(x-5{)}^{2}.\n$$\n\nFirst, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-10x & =-21 \\\\ {x}^{2}-2\\cdot 5\\cdot x & =-21 \\\\ {x}^{2}-2\\cdot 5\\cdot x+{5}^{2}-{5}^{2} & =-21 \\\\ (x-5{)}^{2}-25 & =-21\\end{aligned}\n$$\n\nNext, we isolate the perfect square by adding $25$ to both sides: \n\n$$\n\\begin{aligned}(x-5{)}^{2}-25+25 & =-21+25 \\\\ (x-5{)}^{2} & =4\\end{aligned}\n$$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-5{)}^{2} & =4 \\\\ \\sqrt{(x-5{)}^{2}} & =\\sqrt{4} \\\\ |x-5| & =2 \\\\ x-5 & =\\pm 2 \\\\ x & =5\\pm 2\\end{aligned}\n$$\n\nFinally, we simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =5-2=3 \\\\ {x}_{2} & =5+2=7\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{x}_{1}^{2}+{x}_{2}^{2}={3}^{2}+{7}^{2}=58.\n$$"}] [{:db/id #edb/ref 17592186272323 :knowledge-point/_questions [{:db/id #edb/ref 17592186059820 :knowledge-point/id #uuid "4b12a7b7-1df3-5203-934e-8820604de3de" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06722ca7-474e-5595-bf36-153b1775fd3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186269327} {:answer/id #uuid "1f9a8511-de08-55eb-a39b-8c1d7fb3526d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x" :db/id #edb/ref 17592186269532} {:answer/id #uuid "35238dad-241f-56ad-8d8f-e9b4f0502e53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡x-\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186269755} {:answer/id #uuid "e79b8881-98bb-524f-b8e6-1f50afbbbdee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186271294} {:answer/id #uuid "eb7b137e-47ec-5070-a46e-9c1151db82e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-\\sqrt{3}\\operatorname{sin}⁡x-\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186271335}] :answer-field/correct {:answer/id #uuid "eb7b137e-47ec-5070-a46e-9c1151db82e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-\\sqrt{3}\\operatorname{sin}⁡x-\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186271335} :answer-field/id #uuid "c897889a-b632-5109-a8b5-b76c95145861" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271878}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "81ad9fc7-9d0e-5199-bbb4-6a03531ef9d2" :question/math-academy-id "q-142026" :question/problem "$\\operatorname{sin}⁡(x+\\frac{7\\pi }{6})=$" :question/worked-solution "Recall the sum formula for sine:\n\n$$\n\\operatorname{sin}⁡(u+v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v+\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the sum formula for sine with $u=x$ and $v=\\frac{7\\pi }{6},$ we get \n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x+\\frac{7\\pi }{6}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡(\\frac{7\\pi }{6})+\\operatorname{cos}⁡x\\operatorname{sin}⁡(\\frac{7\\pi }{6}) \\\\  & =\\operatorname{sin}⁡x\\cdot (\\frac{-\\sqrt{3}}{2})+\\operatorname{cos}⁡x\\cdot (\\frac{-1}{2}) \\\\  & =\\frac{-\\sqrt{3}\\operatorname{sin}⁡x-\\operatorname{cos}⁡x}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272324 :knowledge-point/_questions [{:db/id #edb/ref 17592186064313 :knowledge-point/id #uuid "a67f347a-30a5-5169-af2c-9a800be84e46" :knowledge-point/title "Determining Concavity and the Sign of the Derivative at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1add8174-ecc0-5924-a357-a237227abb93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=e" :db/id #edb/ref 17592186269484} {:answer/id #uuid "1e6527fb-28b3-591d-9a68-37bb2ed8eb3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=d" :db/id #edb/ref 17592186269523} {:answer/id #uuid "4923a1f4-3c21-5dc4-832a-0c5c1f4015d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=b" :db/id #edb/ref 17592186269936} {:answer/id #uuid "bd09ad0b-d0b2-5249-a22f-07c77761d468" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=c" :db/id #edb/ref 17592186270936} {:answer/id #uuid "c9efdfa7-fd05-551d-98ac-d8d9b12ea4f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=a" :db/id #edb/ref 17592186271042}] :answer-field/correct {:answer/id #uuid "bd09ad0b-d0b2-5249-a22f-07c77761d468" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=c" :db/id #edb/ref 17592186270936} :answer-field/id #uuid "999b90ee-3fc3-56da-b03e-7304992bbc26" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271783}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0bb121bf-9e48-5785-a2df-744a4832e310" :question/math-academy-id "q-142031" :question/problem "![](images/47/47b3d021487b88f0a335fc070bfd4846a0ea54dd137f6a0db165db5b27180d45.png)\n\nThe graph of $y=f(x)$ is shown above. For which of the following values of $x$ is $f(x)$ concave up *and* ${f}^{′}(x)=0?$" :question/worked-solution "The derivative ${f}^{′}(x)$ is zero when $x$ is a stationary point (the tangent line is horizontal).\n\nFrom the given graph, we see that only $x=c$ and $x=e$ are stationary points.\n\n![](images/89/899cb5979c943b1d385f9015ffa57bf97d4a47b10fb2be4e653272ed16494d73.png)\n\nThe concavity of a function refers to the direction in which its graph curves.\n\n- If the graph curves upward, like a \"smile\" ($⌣$), then the graph is said to be *concave up*.\n\n- If the graph curves downward, like a \"frown\" ($⌢$), then the graph is said to be *concave down*.\n\nIt's helpful to remember the mnemonic \"concave down like a frown.\"\n\nOf the points $x=c$ and $x=e,$ the graph is concave up ($⌣$) at $x=c$ only."}] [{:db/id #edb/ref 17592186272327 :knowledge-point/_questions [{:db/id #edb/ref 17592186064313 :knowledge-point/id #uuid "a67f347a-30a5-5169-af2c-9a800be84e46" :knowledge-point/title "Determining Concavity and the Sign of the Derivative at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62401300-96d1-56d5-9ee8-f9c4a7c3bc6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=d" :db/id #edb/ref 17592186270134} {:answer/id #uuid "70626190-f544-5b0c-bdad-970c1bd574c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=a" :db/id #edb/ref 17592186270263} {:answer/id #uuid "73fd380b-5896-5429-8b75-1a92ef994916" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=c" :db/id #edb/ref 17592186270292} {:answer/id #uuid "beb805c3-9735-51f3-8d7b-56423fc172c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=e" :db/id #edb/ref 17592186270955} {:answer/id #uuid "cdd55e37-172c-5e0b-8352-3139633aa32c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=b" :db/id #edb/ref 17592186271074}] :answer-field/correct {:answer/id #uuid "70626190-f544-5b0c-bdad-970c1bd574c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=a" :db/id #edb/ref 17592186270263} :answer-field/id #uuid "aff788ec-47ea-5d3c-a323-f22a2955dff8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271829}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a51e757c-6a44-5439-956b-057bca4d2d78" :question/math-academy-id "q-142069" :question/problem "![](images/8d/8dbc36f0b404c1704e9add4b668b257703d6d163f825695b9404a33633da3ea7.png)\n\nThe graph of $y=f(x)$ is shown above. For which of the following values of $x$ is $f(x)$ concave down *and* ${f}^{′}(x)>0?$" :question/worked-solution "The derivative ${f}^{′}(x)$ is positive when $f(x)$ is increasing. From the given graph, we see that only $x=a$ and $x=e$ are on increasing parts of the graph.\n\n![](images/7f/7f42ed4bdb45d14497c70b0e2e98af95442d9bf8e6aaa577766dec1c5df2b31f.png)\n\nThe concavity of a function refers to the direction in which its graph curves.\n\n- If the graph curves upward, like a \"smile\" ($⌣$), then the graph is said to be *concave up*.\n\n- If the graph curves downward, like a \"frown\" ($⌢$), then the graph is said to be *concave down*.\n\nIt's helpful to remember the mnemonic \"concave down like a frown.\"\n\nOf the points $x=a$ and $x=e,$ the graph is concave  down ($⌢$) at $x=a$ only."}] [{:db/id #edb/ref 17592186388848 :knowledge-point/_questions [{:db/id #edb/ref 17592186184137 :knowledge-point/id #uuid "7c9ceefc-3aa8-5c13-90a1-e4a084f720cc" :knowledge-point/title "Identifying the Graph of a Strict Inequality Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18e4d2de-99a8-5c5a-bcd7-bfbf63902855" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/14/1497c291a9a068a414503d3081f52c5df56019d496a3f6c16cc905e6a20b97fe.png" :db/id #edb/ref 17592186388850} {:answer/id #uuid "a1177d92-f4ff-58b1-ae15-c2d12bba3b8d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9e/9e6af7aceed6e31bccd5f568d50ac1c897b98cc568d383ea559a8b61abc203e7.png" :db/id #edb/ref 17592186388851} {:answer/id #uuid "a935f1aa-2e46-5432-9942-28834f14200a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1c/1cc25938438d7ef2ad77bd5047a1417e5c0dba609e630bde7c3dee9dffa205ba.png" :db/id #edb/ref 17592186388852} {:answer/id #uuid "184cb15f-141c-5d51-b648-0f352aa708e0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/07/07de9cd8bb359093767ba2dfe9e762ca602d97dbe7b1217541fe4b5017675162.png" :db/id #edb/ref 17592186388853} {:answer/id #uuid "98de12f6-db2b-5f19-b507-54a7283acb15" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9f/9febb7b2ffb18d3d4d1ea5976fb0de6ee164689d01d82cf89dfb83000febffb1.png" :db/id #edb/ref 17592186388854}] :answer-field/correct {:answer/id #uuid "184cb15f-141c-5d51-b648-0f352aa708e0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/07/07de9cd8bb359093767ba2dfe9e762ca602d97dbe7b1217541fe4b5017675162.png" :db/id #edb/ref 17592186388853} :answer-field/id #uuid "a9a641e6-d96d-56ee-a09e-0f810a98dfec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388849}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1cee14fe-e375-5314-aab5-fe2b10bd1948" :question/math-academy-id "q-142097" :question/problem "Which of the following shaded areas describes the region bounded by the inequality $4x-2y<6?$" :question/worked-solution "First, we convert the inequality into slope-intercept form:\n\n$$\n\\begin{aligned}4x-2y & <6 \\\\ -2y & <-4x+6 \\\\ 2y & >4x-6 \\\\ y & >2x-3\\end{aligned}\n$$\n\nNow, we proceed as usual. We start by drawing the corresponding straight line \n\n$$\ny=2x-3.\n$$\n\n Since the inequality involves a 'strictly greater than' sign, the line $y=2x-3$ itself is *not* part of the solution. Therefore, we draw a **dashed line**.\n\nThen, we need to decide whether to shade above or below the line. The inequality \n\n$$\ny>2x-3\n$$\n\n refers to the $y$-values that are *greater than* those on the line $y=2x-3,$ so we shade *above* the line.\n\n![](images/2f/2fe69dace2487c1b6dc73fcd122fd358513d8ac9528b3195d2075f8b62c75b4a.png)"}] [{:db/id #edb/ref 17592186388855 :knowledge-point/_questions [{:db/id #edb/ref 17592186184138 :knowledge-point/id #uuid "031f0fd6-385d-56b8-9e8e-b264e6e89ed3" :knowledge-point/title "Identifying the Graph of a Non-Strict Inequality Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a831251-1892-5348-acb0-08de00fc7410" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ec/ec99abbe475fc356cfd36415012fe1a6e8e611895452b8e7b0f3f1b8457d61d7.png" :db/id #edb/ref 17592186388857} {:answer/id #uuid "0b0f6713-300a-5873-adfe-ba515b646bf0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/80/801b9576f2c9840eac75479d8983eb8b12a8a1138da7bb361f417c14ffad6823.png" :db/id #edb/ref 17592186388858} {:answer/id #uuid "0d3375a7-8226-5fcc-9260-c5266d4a00a0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b6/b68f8b6a6f5b72bbc9c11ca7c1af87965330cc72d5f9700486c80a4d22a08849.png" :db/id #edb/ref 17592186388859} {:answer/id #uuid "bd596374-4a82-557d-9a74-1dcda7c6daf1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bc/bce1f17aa0fde89c6373bdc4499a1e2bb2c976f41b38d97568f7e73ed8d57dd8.png" :db/id #edb/ref 17592186388860} {:answer/id #uuid "8dcb4582-ca85-526e-b94c-668fb6055ac4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1a/1a8b3896667e3401eb610625ee71607c221ad7cdaf2d4ccea79bdbe54665ec7e.png" :db/id #edb/ref 17592186388861}] :answer-field/correct {:answer/id #uuid "7a831251-1892-5348-acb0-08de00fc7410" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ec/ec99abbe475fc356cfd36415012fe1a6e8e611895452b8e7b0f3f1b8457d61d7.png" :db/id #edb/ref 17592186388857} :answer-field/id #uuid "6ed07d46-b98a-5fa7-9c22-1b406322df54" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388856}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "60ebcac8-bc59-5dde-9394-be5d3c916d93" :question/math-academy-id "q-142112" :question/problem "Which of the following shaded areas describes the region bounded by the inequality $x+2y\\le 4?$" :question/worked-solution "First, we convert the inequality into slope-intercept form:\n\n$$\n\\begin{aligned}x+2y & \\le 4 \\\\ 2y & \\le -x+4 \\\\ y & \\le -\\frac{1}{2}x+2\\end{aligned}\n$$\n\nNow, we proceed as usual. We start by drawing the corresponding straight line \n\n$$\ny=-\\frac{1}{2}x+2.\n$$\n\n Since the inequality involves a 'less than *or equal to*' sign, the line $y=-\\frac{1}{2}x+2$ itself is part of the solution. Therefore, we draw a **solid line**. \n\nThen, we need to decide whether to shade above or below the line. The inequality \n\n$$\ny\\le -\\frac{1}{2}x+2\n$$\n\n refers to the $y$-values that are *less than* or equal to those on the line $y=-\\frac{1}{2}x+2,$ so we shade *below* the line. \n\n![](images/8b/8b906cf167528f484109528a93732dc2b8d73558bb02f454bb520af87efde3c5.png)"}] [{:db/id #edb/ref 17592186272331 :knowledge-point/_questions [{:db/id #edb/ref 17592186059821 :knowledge-point/id #uuid "c6a58962-cb06-519a-8c64-0dfa3b9c14d7" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "090d142f-f7f9-5a7b-b72e-52a078df1eaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}(\\sqrt{3}\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186269350} {:answer/id #uuid "1d201ccd-85fb-549a-9e9c-531394fc50aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186269507} {:answer/id #uuid "76ee6731-902a-5dee-b46b-c4380fed56c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}(\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186270319} {:answer/id #uuid "b75c049c-a748-56a4-b205-01a20869b559" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{3}\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186270893} {:answer/id #uuid "c3f5c1f2-a0ab-5100-8db9-3071ee8511c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{3}\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186271000}] :answer-field/correct {:answer/id #uuid "76ee6731-902a-5dee-b46b-c4380fed56c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}(\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186270319} :answer-field/id #uuid "a8980b78-b788-5d75-b585-9a0b63595d13" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271815}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a1de0aea-4bea-5c0c-94bb-b2903c951763" :question/math-academy-id "q-142142" :question/problem "$\\operatorname{cos}⁡(x-{210}^{∘})=$" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for cosine with $u=x$ and $v={210}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x-{210}^{∘}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡{210}^{∘}+\\operatorname{sin}⁡x\\operatorname{sin}⁡{210}^{∘} \\\\  & =\\operatorname{cos}⁡x\\cdot (-\\frac{\\sqrt{3}}{2})+\\operatorname{sin}⁡x\\cdot (-\\frac{1}{2}) \\\\  & =-\\frac{1}{2}(\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272333 :knowledge-point/_questions [{:db/id #edb/ref 17592186184332 :knowledge-point/id #uuid "ef5d4f19-5602-54a9-96ea-4e42054ff5c8" :knowledge-point/title "Solving Greater Than (Or Equal To) Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05d289c8-f2ba-5e7d-8df2-ac922b653604" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3<x<6" :db/id #edb/ref 17592186269322} {:answer/id #uuid "2045997a-c29b-5682-9690-d4803b53e48a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x\\le 3$ or $x\\ge 6$" :db/id #edb/ref 17592186269539} {:answer/id #uuid "6dc78030-e11b-505d-8b3b-a395364a5a14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\le x\\le 6" :db/id #edb/ref 17592186270244} {:answer/id #uuid "87c0387a-3b4b-5646-9b8f-6715f8f992c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x<3$ or $x>6$" :db/id #edb/ref 17592186270444} {:answer/id #uuid "9d893273-9034-5596-9c94-9cfc2b550725" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x\\le -6$ or $x\\ge -3$" :db/id #edb/ref 17592186270664}] :answer-field/correct {:answer/id #uuid "6dc78030-e11b-505d-8b3b-a395364a5a14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\le x\\le 6" :db/id #edb/ref 17592186270244} :answer-field/id #uuid "b45e81b5-1cf8-5dd9-bed8-268515bde3f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271840}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "503c0efb-79c2-51f6-ad5d-0c4262a2faa4" :question/math-academy-id "q-142180" :question/problem "Find the solution of $-{x}^{2}+9x-18\\ge 0.$" :question/worked-solution "To solve the inequality \n\n$$\n-{x}^{2}+9x-18\\ge 0,\n$$\n\nwe need to find the values of $x$ for which the parabola \n\n$$\ny=-{x}^{2}+9x-18\n$$\n\nlies *above* the $x$-axis or touches this axis.\n\nFirst, let's find the roots of the parabola:\n\n$$\n\\begin{aligned}-{x}^{2}+9x-18 & =0 \\\\ -({x}^{2}-9x+18) & =0 \\\\ -(x-3)(x-6) & =0\\end{aligned}\n$$\n\nSo, the roots are $x=3$ and $x=6,$ and we can graph the parabola as follows:\n\n![](images/d4/d4c28d26425c3c5bfc95dece73c8d8cb74f395f2de04a2c2ee1b1fd69f8433ed.png)\n\nThe values marked in blue show all $x$-values where the parabola lies *above* the axis or touches the $x$-axis. \n\nSo, the solution to the inequality is $3\\le x\\le 6.$"}] [{:db/id #edb/ref 17592186400958 :knowledge-point/_questions [{:db/id #edb/ref 17592186184333 :knowledge-point/id #uuid "cbe80595-c807-506c-a356-566f1edb3402" :knowledge-point/title "Solving Less Than (Or Equal To) Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bb10726b-626d-526b-b3f9-de6bad9f3f38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1\\le x\\le 5" :db/id #edb/ref 17592186400960} {:answer/id #uuid "a7f8c3f4-5711-584d-9263-fed31acf6c29" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x\\le -6$ or $x\\ge 1$" :db/id #edb/ref 17592186400961} {:answer/id #uuid "bce75758-abe3-5789-8de5-5d18996c87a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x\\le 1$ or $x\\ge 5$" :db/id #edb/ref 17592186400962} {:answer/id #uuid "cf8d0e9c-0806-580a-b031-8a01a725abe9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5\\le x\\le -1" :db/id #edb/ref 17592186400963} {:answer/id #uuid "a4a43c47-c698-531e-a0a3-0b2da98a2630" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x\\le -5$ or $x\\ge 1$" :db/id #edb/ref 17592186400964}] :answer-field/correct {:answer/id #uuid "bce75758-abe3-5789-8de5-5d18996c87a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x\\le 1$ or $x\\ge 5$" :db/id #edb/ref 17592186400962} :answer-field/id #uuid "8b2ce6b8-4640-53b8-b17b-3464a0fe587d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400959}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f59dad02-8b17-598a-a754-71bfff242018" :question/math-academy-id "q-142315" :question/problem "Find the solution of $-{x}^{2}+6x-5\\le 0.$" :question/worked-solution "To solve the inequality \n\n$$\n-{x}^{2}+6x-5\\le 0,\n$$\n\nwe need to find the values of $x$ for which the parabola \n\n$$\ny=-{x}^{2}+6x-5\n$$\n\nlies *below* the $x$-axis or touches this axis.\n\nFirst, let's find the roots of the parabola:\n\n$$\n\\begin{aligned}-{x}^{2}+6x-5 & =0 \\\\ -({x}^{2}-6x+5) & =0 \\\\ -(x-1)(x-5) & =0\\end{aligned}\n$$\n\nSo, the roots are $x=1$ and $x=5,$ and we can graph the parabola as follows:\n\n![](images/7c/7cfa66b5aa6a3f29e7154e329926a47bbbb0eb45dce3251148986785f09ee383.png)\n\nThe values marked in blue show all $x$-values where the parabola lies *below* the $x$-axis or touches this axis.\n\nSo, the solution to the inequality is $x\\le 1$ or $x\\ge 5.$"}] [{:db/id #edb/ref 17592186272341 :knowledge-point/_questions [{:db/id #edb/ref 17592186083343 :knowledge-point/id #uuid "a83d52a4-6f69-5607-8753-e96c13bd7209" :knowledge-point/title "Rewriting One of the Limits of an Improper Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "064f38a9-6565-5259-b73e-38e9a5bf6ce7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{a\\to {2}^{+}}({\\int }_{a}^{4}\\frac{1}{\\sqrt{{x}^{2}-1}}\\,\\text{d}x)" :db/id #edb/ref 17592186269324} {:answer/id #uuid "29fc075b-1f90-5ba4-b267-72126324de52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{a\\to {4}^{+}}({\\int }_{1}^{a}\\frac{1}{\\sqrt{{x}^{2}-1}}\\,\\text{d}x)" :db/id #edb/ref 17592186269650} {:answer/id #uuid "5e30c8ba-7321-5f29-b158-fcfc42391f59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{a\\to -\\infty }({\\int }_{a}^{4}\\frac{1}{\\sqrt{{x}^{2}-1}}\\,\\text{d}x)" :db/id #edb/ref 17592186270105} {:answer/id #uuid "d23cf462-84fa-5c02-955c-f8bbd06dc2fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{a\\to +\\infty }({\\int }_{a}^{4}\\frac{1}{\\sqrt{{x}^{2}-1}}\\,\\text{d}x)" :db/id #edb/ref 17592186271118} {:answer/id #uuid "f23df302-0072-5c0a-9e7f-b2913dca9ced" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{a\\to {1}^{+}}({\\int }_{a}^{4}\\frac{1}{\\sqrt{{x}^{2}-1}}\\,\\text{d}x)" :db/id #edb/ref 17592186271397}] :answer-field/correct {:answer/id #uuid "f23df302-0072-5c0a-9e7f-b2913dca9ced" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{a\\to {1}^{+}}({\\int }_{a}^{4}\\frac{1}{\\sqrt{{x}^{2}-1}}\\,\\text{d}x)" :db/id #edb/ref 17592186271397} :answer-field/id #uuid "1ac4203d-ddee-5a21-9768-4c4a3a7f55f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271557}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "693a32b1-39ba-5f91-9f8b-21a365f10248" :question/math-academy-id "q-142389" :question/problem "Which of the following is equivalent to \n${\\int }_{1}^{4}\\frac{\\text{d}x}{\\sqrt{{x}^{2}-1}}?$" :question/worked-solution "This is an improper integral of the second kind because the function under the integral is unbounded as we approach the *lower* integration limit from any point that lies in the interval $x\\in (1,4):$\n\n$$\nf(x)=\\frac{1}{\\sqrt{{x}^{2}-1}}\\to \\infty \\,\\text{as}\\,x\\to {1}^{+}\n$$\n\nWe can attempt to evaluate this integral by integrating $f(x)$ over the interval $x\\in [a,4]$ and taking the limit as $a\\to {1}^{+}:$\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}\\frac{1}{\\sqrt{{x}^{2}-1}}\\,\\text{d}x & ={lim}_{a\\to {1}^{+}}({\\int }_{a}^{4}\\frac{1}{\\sqrt{{x}^{2}-1}}\\,\\text{d}x)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186396059 :knowledge-point/_questions [{:db/id #edb/ref 17592186096708 :knowledge-point/id #uuid "5e182f71-db24-5c29-9c8b-2fc4b5ab5dd8" :knowledge-point/title "Calculating the Y-Intercepts of a Parabola Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9aad8bda-3338-5a30-9437-cc3702c58311" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ and $7$" :db/id #edb/ref 17592186396061} {:answer/id #uuid "327b2ad5-797c-54cc-89ed-97281f8970bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ and $6$" :db/id #edb/ref 17592186396062} {:answer/id #uuid "bef389b0-e3ae-5a1a-8b87-cc5f8f7fe4f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$ and $6$" :db/id #edb/ref 17592186396063} {:answer/id #uuid "16f5c998-e55d-56ad-a2e1-414b9c779c8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$ and $5$" :db/id #edb/ref 17592186396064} {:answer/id #uuid "f30933e4-e411-5b64-94cc-db4bc0952b99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$ and $7$" :db/id #edb/ref 17592186396065}] :answer-field/correct {:answer/id #uuid "327b2ad5-797c-54cc-89ed-97281f8970bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ and $6$" :db/id #edb/ref 17592186396062} :answer-field/id #uuid "402f8b77-e682-57ca-9212-0a3e5c1ad08a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396060}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0ecc876e-1e30-5d04-b02b-e0d45341e6f7" :question/math-academy-id "q-14241" :question/problem "![](images/9b/9b7acbd4f24b6bbd20dd00fc042405324c069d28db0102c2cd7dd49e6b3bbccd.png)\n\nWhat are the $y$-intercepts of the parabola shown above?" :question/worked-solution "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(2,4)$ and passes through the point $(-6,8).$\n\nThe general standard equation of a left- or right-opening parabola with vertex at $(h,k)$ is given by\n\n$$\n(y-k)^{2}=4p(x-h),\n$$\n\nand substituting $(h,k)=(2,4)$ into the above gives\n\n$$\n(y-4)^{2}=4p(x-2).\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(-6,8),$ we substitute $x=-6$ and $y=8$ into the equation and get\n\n$$\n\\begin{aligned}(8-4)^{2} & =4p(-6-2) \\\\ 16 & =4p(-8) \\\\ p & =-\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(y-4)^{2} & =-2(x-2).\\end{aligned}\n$$\n\nWhen the parabola intersects the $y$-axis, we must have $x=0.$ So, we substitute $x=0$ into the equation of the parabola and solve for $y:$\n\n$$\n\\begin{aligned}(y-4)^{2} & =-2(0-2) \\\\ (y-4)^{2} & =4 \\\\ y-4 & =\\pm 2 \\\\ y & =\\pm 2+4 \\\\ y & =2,6\\end{aligned}\n$$\n\nTherefore, the $y$-intercepts are $2$ and  $6.$"}] [{:db/id #edb/ref 17592186097119 :knowledge-point/_questions [{:db/id #edb/ref 17592186096708 :knowledge-point/id #uuid "5e182f71-db24-5c29-9c8b-2fc4b5ab5dd8" :knowledge-point/title "Calculating the Y-Intercepts of a Parabola Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cd47d40-053d-580f-8ef6-d1b7dea8bc51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186269823} {:answer/id #uuid "91dfe027-7e34-5fbb-ac22-0eeedb6cc380" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186270540} {:answer/id #uuid "af17243f-34c3-59ab-bed7-fdbf3855bc97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186270824} {:answer/id #uuid "c75cf06a-ada1-577c-8303-4d49a0383776" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186271024} {:answer/id #uuid "ed6d6f40-a766-55c2-b6fc-5cc3ee90b932" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186271355}] :answer-field/correct {:answer/id #uuid "3cd47d40-053d-580f-8ef6-d1b7dea8bc51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186269823} :answer-field/id #uuid "81440e2a-2d3e-59d0-8785-f957ed0391b9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271736}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f14aa2fa-d615-53a6-833b-93cabfaae0ee" :question/math-academy-id "q-14248" :question/problem "![](images/ca/cac89f66c8c1e5e0ac6a9857cb7db48d3ca6edc2a83fb2ba3a63b0809cfe6ab0.png)\n\nWhat is the $y$-intercept of the parabola shown above?" :question/worked-solution "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(5,-4)$ and passes through the point $(2,5).$\n\nThe general standard equation of an up- or down-opening parabola with vertex at $(h,k)$ is given by\n\n$$\n(x-h)^{2}=4p(y-k),\n$$\n\nand substituting $(h,k)=(5,-4)$ into the above gives\n\n$$\n(x-5)^{2}=4p(y+4).\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(2,5),$ we substitute $x=2$ and $y=5$ into the equation and get\n\n$$\n\\begin{aligned}(2-5)^{2} & =4p(5+4) \\\\ 9 & =4p(9) \\\\ p & =\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(x-5)^{2} & =y+4.\\end{aligned}\n$$\n\nWhen the parabola intersects the $y$-axis, we must have $x=0.$ So, we substitute $x=0$ into the equation of the parabola and solve for $y:$\n\n$$\n\\begin{aligned}(0-5)^{2} & =y+4 \\\\ 25 & =y+4 \\\\ y & =25-4 \\\\ y & =21\\end{aligned}\n$$\n\nTherefore, the $y$-intercept is $21.$"}] [{:db/id #edb/ref 17592186272362 :knowledge-point/_questions [{:db/id #edb/ref 17592186100894 :knowledge-point/id #uuid "de2e3a7c-d4f0-5b0f-8014-1519fb3a9473" :knowledge-point/title "Finding Particular Solutions of Differential Equations by First Rearranging and Then Separating"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a4171c5-a734-541a-8466-69b56ce0d873" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\operatorname{ln}⁡(1+{e}^{x})" :db/id #edb/ref 17592186269359} {:answer/id #uuid "38ecd45c-ba43-5032-b302-2a4db3f68db3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\operatorname{ln}⁡(1+x+{e}^{x})" :db/id #edb/ref 17592186269785} {:answer/id #uuid "b0aa3d76-7de4-57d1-9a49-fedf8212ceab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\operatorname{ln}⁡(x+{e}^{x})" :db/id #edb/ref 17592186270846} {:answer/id #uuid "b2780b36-6d65-5d14-9b03-a066bbecba37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\operatorname{ln}⁡(3-2x-{e}^{x})" :db/id #edb/ref 17592186270864} {:answer/id #uuid "bcf951d6-95fc-5d3d-8bf4-6811a7297a18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\operatorname{ln}⁡(3-{e}^{x})" :db/id #edb/ref 17592186270934}] :answer-field/correct {:answer/id #uuid "bcf951d6-95fc-5d3d-8bf4-6811a7297a18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\operatorname{ln}⁡(3-{e}^{x})" :db/id #edb/ref 17592186270934} :answer-field/id #uuid "c146e3ac-1df2-5b81-bf01-9382213bcac9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271861}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4a8c132a-a85d-5f19-bf08-0d6e90b34efd" :question/math-academy-id "q-14267" :question/problem "Find the specific solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}={e}^{x+y}$ given that  $\\,y(0)=-\\operatorname{ln}⁡2.$" :question/worked-solution "We first find the general solution and then apply the given initial condition to find a particular solution.\n\nSeparating variables and integrating both sides with respect to $x,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & ={e}^{x+y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & ={e}^{x}{e}^{y} \\\\ {e}^{-y}\\,\\frac{\\text{d}y}{\\text{d}x} & ={e}^{x} \\\\ \\int {e}^{-y}\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int {e}^{x}\\,\\text{d}x \\\\ \\int {e}^{-y}\\,\\text{d}y & =\\int {e}^{x}\\,\\text{d}x \\\\ -{e}^{-y} & ={e}^{x}+{C}_{1} \\\\ {e}^{-y} & =-{e}^{x}+C\\end{aligned}\n$$\n\nApplying the natural logarithm to both sides, we find the general solution:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({e}^{-y}) & =\\operatorname{ln}⁡(-{e}^{x}+C) \\\\ -y & =\\operatorname{ln}⁡(C-{e}^{x}) \\\\ y & =-\\operatorname{ln}⁡(C-{e}^{x}).\\end{aligned}\n$$\n\nWe now apply the condition $y(0)=-\\operatorname{ln}⁡2$ to find $C:$\n\n$$\n\\begin{aligned}y(0) & =-\\operatorname{ln}⁡2 \\\\ -\\operatorname{ln}⁡(C-{e}^{0}) & =-\\operatorname{ln}⁡2 \\\\ \\operatorname{ln}⁡(C-1) & =\\operatorname{ln}⁡2 \\\\ C-1 & =2 \\\\ C & =3\\end{aligned}\n$$\n\nThus the particular solution of $\\frac{\\text{d}y}{\\text{d}x}={e}^{x+y}$ that satisfies the condition $y(0)=-\\operatorname{ln}⁡2$ is\n\n$$\ny=-\\operatorname{ln}⁡(3-{e}^{x}).\n$$"}] [{:db/id #edb/ref 17592186272366 :knowledge-point/_questions [{:db/id #edb/ref 17592186110553 :knowledge-point/id #uuid "03491655-9b81-5fc0-bf20-e4f74a9c72ad" :knowledge-point/title "Simplifying an Expression Using the Secant-Tangent Identity: Replacing a Squared Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d148a20-6732-5181-8bc1-8502aefbed4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{sec}^{2}⁡\\theta +2" :db/id #edb/ref 17592186269961} {:answer/id #uuid "8c4f6e86-481a-56ab-9316-dbe29ee9a431" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{sec}^{3}⁡\\theta " :db/id #edb/ref 17592186270484} {:answer/id #uuid "a1948bb4-ba66-523b-85c0-dc26ae8fc9fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sec}⁡\\theta +1" :db/id #edb/ref 17592186270703} {:answer/id #uuid "a5d68be5-ce6f-591b-8232-480ac7934752" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{sec}^{2}⁡\\theta " :db/id #edb/ref 17592186270753} {:answer/id #uuid "d82cd36e-e05b-529e-bdd4-c33af7e11490" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{sec}^{3}⁡\\theta " :db/id #edb/ref 17592186271167}] :answer-field/correct {:answer/id #uuid "d82cd36e-e05b-529e-bdd4-c33af7e11490" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{sec}^{3}⁡\\theta " :db/id #edb/ref 17592186271167} :answer-field/id #uuid "13271a5c-0f37-525d-add3-244c00c711ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271541}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2d7d6733-f73e-5b97-aa59-836de3d2a188" :question/math-academy-id "q-142764" :question/problem "$\\operatorname{sec}⁡\\theta {tan}^{2}⁡\\theta +\\operatorname{sec}⁡\\text{ }\\theta =$" :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+{tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta \n$$\n\nWe rewrite the given expression using the secant-tangent identity as follows:\n\n$$\n\\begin{aligned}\\operatorname{sec}⁡\\theta {tan}^{2}⁡\\theta +\\operatorname{sec}⁡\\text{ }\\theta  & =\\operatorname{sec}⁡\\theta \\text{ }\\,({tan}^{2}⁡\\theta +1) \\\\  & =\\operatorname{sec}⁡\\theta \\text{ }\\,({sec}^{2}⁡\\theta ) \\\\  & ={sec}^{3}⁡\\theta \\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\operatorname{sec}⁡\\theta {tan}^{2}⁡\\theta +\\operatorname{sec}⁡\\text{ }\\theta ={sec}^{3}⁡\\theta .\n$$"}] [{:db/id #edb/ref 17592186272371 :knowledge-point/_questions [{:db/id #edb/ref 17592186110666 :knowledge-point/id #uuid "7640012b-79f9-5f6b-a26b-a7f4fe8c0e7b" :knowledge-point/title "Simplifying an Expression Using the Secant-Tangent Identity: Replacing a Squared Secant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e50294c-f2fb-5493-b386-188a5e5c6454" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+\\operatorname{tan}⁡x" :db/id #edb/ref 17592186269396} {:answer/id #uuid "10c68d72-483e-5e6f-bc5d-9a17b61d2b2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{tan}^{2}⁡x" :db/id #edb/ref 17592186269418} {:answer/id #uuid "8e8a5799-d4bb-5fa0-acc3-0994f9a11a15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+{tan}^{2}⁡x" :db/id #edb/ref 17592186270507} {:answer/id #uuid "c15bb409-c8b2-5599-90d8-2cde8b83b9b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-\\operatorname{tan}⁡x" :db/id #edb/ref 17592186270981} {:answer/id #uuid "d3274d62-cd90-5dd9-a3e7-e8835fdd2082" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{tan}^{2}⁡x+1" :db/id #edb/ref 17592186271128}] :answer-field/correct {:answer/id #uuid "8e8a5799-d4bb-5fa0-acc3-0994f9a11a15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+{tan}^{2}⁡x" :db/id #edb/ref 17592186270507} :answer-field/id #uuid "b35fc1c6-91c7-5f33-8f19-88ce55beb8ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271838}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c559d29c-6df4-58e1-9d14-484afb67e84e" :question/math-academy-id "q-142822" :question/problem "${(\\operatorname{sec}⁡x+1)}^{2}-2\\operatorname{sec}⁡x=$" :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+{tan}^{2}⁡x={sec}^{2}⁡x\n$$\n\nWe rewrite the given expression using the secant-tangent identity as follows:\n\n$$\n\\begin{aligned}{(\\operatorname{sec}⁡x+1)}^{2}-2\\operatorname{sec}⁡x & ={sec}^{2}⁡x+2\\operatorname{sec}⁡x+1-2\\operatorname{sec}⁡x \\\\  & =1+{tan}^{2}⁡x+2\\operatorname{sec}⁡x+1-2\\operatorname{sec}⁡x \\\\  & =2+{tan}^{2}⁡x\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{(\\operatorname{sec}⁡x+1)}^{2}-2\\operatorname{sec}⁡x=2+{tan}^{2}⁡x.\n$$"}] [{:db/id #edb/ref 17592186272378 :knowledge-point/_questions [{:db/id #edb/ref 17592186110666 :knowledge-point/id #uuid "7640012b-79f9-5f6b-a26b-a7f4fe8c0e7b" :knowledge-point/title "Simplifying an Expression Using the Secant-Tangent Identity: Replacing a Squared Secant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2126811f-3b88-5a05-8d43-1c3d5a25748d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186269550} {:answer/id #uuid "245b36c0-1e9b-57d0-9e2d-fc22550ca369" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+2\\operatorname{tan}⁡x" :db/id #edb/ref 17592186269587} {:answer/id #uuid "47859517-03d4-5347-b3fc-8eb75caf4a24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{tan}⁡x" :db/id #edb/ref 17592186269918} {:answer/id #uuid "588d09e2-68fa-54ff-bf72-7d34fe995945" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186270050} {:answer/id #uuid "68e67ac2-4980-5f8d-a7d2-7bf6639ac014" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186270199}] :answer-field/correct {:answer/id #uuid "2126811f-3b88-5a05-8d43-1c3d5a25748d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186269550} :answer-field/id #uuid "5f999d6d-ac4b-5c87-8b1f-35a5c4564bbc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271681}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cbc5e1b2-87c4-5246-9d7e-ecb257cc934a" :question/math-academy-id "q-142835" :question/problem "$\\frac{2{sec}^{2}⁡x-1}{1+2{tan}^{2}⁡x}=$" :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+{tan}^{2}⁡x={sec}^{2}⁡x\n$$\n\nWe rewrite the given expression using the secant-tangent identity as follows:\n\n$$\n\\begin{aligned}\\frac{2\\,{sec}^{2}⁡x-1}{1+2{tan}^{2}⁡x} & =\\frac{2\\,(1+{tan}^{2}⁡x)-1}{1+2{tan}^{2}⁡x} \\\\  & =\\frac{2+2{tan}^{2}⁡x-1}{1+2{tan}^{2}⁡x} \\\\  & =\\frac{1+2{tan}^{2}⁡x}{1+2{tan}^{2}⁡x} \\\\  & =\\frac{\\cancel{1+2{tan}^{2}⁡x}}{\\cancel{1+2{tan}^{2}⁡x}} \\\\  & =1\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{2{sec}^{2}⁡x-1}{1+2{tan}^{2}⁡x}=1.\n$$"}] [{:db/id #edb/ref 17592186272380 :knowledge-point/_questions [{:db/id #edb/ref 17592186110666 :knowledge-point/id #uuid "7640012b-79f9-5f6b-a26b-a7f4fe8c0e7b" :knowledge-point/title "Simplifying an Expression Using the Secant-Tangent Identity: Replacing a Squared Secant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "304dde44-20c4-5678-a462-a143bc700873" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186269703} {:answer/id #uuid "5f4d7ccb-6a93-5802-9236-ce06491ed8c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{tan}⁡x" :db/id #edb/ref 17592186270113} {:answer/id #uuid "a402cd41-72cf-556c-91b9-7acf338994ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+\\operatorname{tan}⁡x" :db/id #edb/ref 17592186270734} {:answer/id #uuid "c912289d-9629-527c-9f02-70c6112b4b91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+\\operatorname{tan}⁡x" :db/id #edb/ref 17592186271034} {:answer/id #uuid "fb01e43c-7b1f-5d18-ad5c-c9badf476f9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{tan}⁡x" :db/id #edb/ref 17592186271462}] :answer-field/correct {:answer/id #uuid "5f4d7ccb-6a93-5802-9236-ce06491ed8c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{tan}⁡x" :db/id #edb/ref 17592186270113} :answer-field/id #uuid "fea27859-5aac-55b2-ac2f-7db0b1bf734f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271953}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c7824f8f-c1b4-50c2-a8cc-85b1111053c3" :question/math-academy-id "q-142839" :question/problem "$\\frac{1-{sec}^{2}⁡x}{\\operatorname{tan}⁡x}=$" :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+{tan}^{2}⁡x={sec}^{2}⁡x\n$$\n\nWe rewrite the given expression using the secant-tangent identity as follows:\n\n$$\n\\begin{aligned}\\frac{1-{sec}^{2}⁡x}{\\operatorname{tan}⁡x} & =\\frac{1-(1+{tan}^{2}⁡x)}{\\operatorname{tan}⁡x} \\\\  & =\\frac{-{tan}^{2}⁡x}{\\operatorname{tan}⁡x} \\\\  & =-\\frac{\\operatorname{tan}⁡x\\cdot \\operatorname{tan}⁡x}{\\operatorname{tan}⁡x} \\\\  & =-\\frac{\\operatorname{tan}⁡x\\cdot \\cancel{\\operatorname{tan}⁡x}}{\\cancel{\\operatorname{tan}⁡x}} \\\\  & =-\\operatorname{tan}⁡x\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{1-{sec}^{2}⁡x}{\\operatorname{tan}⁡x}=-\\operatorname{tan}⁡x.\n$$"}] [{:db/id #edb/ref 17592186272382 :knowledge-point/_questions [{:db/id #edb/ref 17592186110665 :knowledge-point/id #uuid "91100afb-9a36-57c0-9f30-4692cfef0b93" :knowledge-point/title "Simplifying an Expression Using the Secant-Tangent and Other Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53a1afef-ab20-5945-b76e-734ddce1d287" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+2{sin}^{2}⁡x" :db/id #edb/ref 17592186270013} {:answer/id #uuid "640b4baa-bd5a-5438-8ead-3ad792f8ca79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-2{sin}^{2}⁡x" :db/id #edb/ref 17592186270156} {:answer/id #uuid "9f59147e-3b45-5292-abf8-9bd74860dab6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186270682} {:answer/id #uuid "dcc3cba1-26e2-5c14-abf1-4ce11a76db7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-{sin}^{2}⁡x" :db/id #edb/ref 17592186271204} {:answer/id #uuid "f7d608dc-7308-59e2-ad6e-96afa80f19bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186271442}] :answer-field/correct {:answer/id #uuid "640b4baa-bd5a-5438-8ead-3ad792f8ca79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-2{sin}^{2}⁡x" :db/id #edb/ref 17592186270156} :answer-field/id #uuid "bb5b09ad-bc1f-512d-8096-60f9e316d665" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271850}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fc757669-b204-5044-83d4-679ef2bca4ac" :question/math-academy-id "q-142871" :question/problem "${cos}^{2}⁡x\\text{ }\\,({sec}^{2}⁡x-2{tan}^{2}⁡x)=$" :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+{tan}^{2}⁡x={sec}^{2}⁡x\n$$\n\nWe rewrite the given expression using the secant-tangent identity as follows:\n\n$$\n\\begin{aligned}{cos}^{2}⁡x\\text{ }\\,({sec}^{2}⁡x-2{tan}^{2}⁡x) & ={cos}^{2}⁡x\\text{ }\\,(1+{tan}^{2}⁡x-2{tan}^{2}⁡x) \\\\  & ={cos}^{2}⁡x(1-{tan}^{2}⁡x) \\\\  & ={cos}^{2}⁡x-{cos}^{2}⁡x\\cdot {tan}^{2}⁡x\\end{aligned}\n$$\n\nNext, we recall the identities:\n\n$$\n\\operatorname{tan}⁡x=\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x},\\,{cos}^{2}⁡x=1-{sin}^{2}⁡x\n$$\n\n \n\nUsing the above identities, we can further simplify our expression as follows:\n\n$$\n\\begin{aligned}{cos}^{2}⁡x-{cos}^{2}⁡x\\cdot {tan}^{2}⁡x & ={cos}^{2}⁡x-{cos}^{2}⁡x\\cdot \\frac{{sin}^{2}⁡x}{{cos}^{2}⁡x} \\\\  & ={cos}^{2}⁡x-\\cancel{{cos}^{2}⁡x}\\cdot \\frac{{sin}^{2}⁡x}{\\cancel{{cos}^{2}⁡x}} \\\\  & ={cos}^{2}⁡x-{sin}^{2}⁡x \\\\  & =1-{sin}^{2}⁡x-{sin}^{2}⁡x \\\\  & =1-2{sin}^{2}⁡x\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{cos}^{2}⁡x\\text{ }\\,({sec}^{2}⁡x-2{tan}^{2}⁡x)=1-2{sin}^{2}⁡x.\n$$"}] [{:db/id #edb/ref 17592186275092 :knowledge-point/_questions [{:db/id #edb/ref 17592186129254 :knowledge-point/id #uuid "344f1838-a027-5fd5-82da-17e9b4fcac2b" :knowledge-point/title "Further Translating Problems With Proportional Rates of Change Into Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e30876c-8768-5be2-abca-f8273b7ba63b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}G}{\\text{d}t}=-kt,\\,\\,k>0" :db/id #edb/ref 17592186273466} {:answer/id #uuid "b3b36db2-757c-5a3e-9eb9-b55db12f94b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}G}{\\text{d}t}=k{t}^{2},\\,\\,k>0" :db/id #edb/ref 17592186273941} {:answer/id #uuid "dbc68f16-4f88-50b6-b5db-742e6f79fff2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}G}{\\text{d}t}=-\\frac{k}{{t}^{2}},\\,\\,k>0" :db/id #edb/ref 17592186274315} {:answer/id #uuid "eb92fb2d-95fc-51ec-bd0c-d112e6d05c8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}G}{\\text{d}t}=\\frac{k}{{t}^{2}},\\,\\,k>0" :db/id #edb/ref 17592186274467} {:answer/id #uuid "eb9c53e8-6bf7-5496-9457-1814ec2ca534" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}G}{\\text{d}t}=-k{t}^{2},\\,\\,k>0" :db/id #edb/ref 17592186274468}] :answer-field/correct {:answer/id #uuid "b3b36db2-757c-5a3e-9eb9-b55db12f94b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}G}{\\text{d}t}=k{t}^{2},\\,\\,k>0" :db/id #edb/ref 17592186273941} :answer-field/id #uuid "5fd626aa-9b19-5cf8-b1df-605d1f0a01c1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274800}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "71b2100f-b8f1-5ebd-9167-ed6423aec448" :question/math-academy-id "q-143035" :question/problem "During a certain chemical reaction, the volume of gas $G$ increases with time. The rate of change of the volume of gas is proportional to the square of the time $t,$ in seconds, since the reaction started. What differential equation describes the rate of change of the volume of gas at time $t?$" :question/worked-solution "Let's highlight the important words in the given statement:\n\n*During a certain chemical reaction, the **volume** of gas $G$ **increases** with time. The **rate** of change of the volume of gas is **proportional** to the **square of the time** $t,$ in seconds.  *\n\nWe note the following:\n\n- The question describes the *rate* at which the *volume of gas* varies. Therefore, this is a statement about the quantity \n\n$$\n\\frac{\\text{d}G}{\\text{d}t}.\n$$\n\n- We're told that $\\frac{\\text{d}G}{\\text{d}t}$ is *proportional to* the *square of the time.* In other words,\n\n$$\n\\frac{\\text{d}G}{\\text{d}t}∝{t}^{2}.\n$$\n\nRecall that $∝$ means \"is proportional to.\"\n\n- Finally, we want to replace the proportionality symbol with an equality symbol. Let $k$ be a positive constant. Since the volume of gas *increases* with time, our derivative should be *positive*. Therefore, we can rewrite our proportionality statement as\n\n$$\n\\frac{\\text{d}G}{\\text{d}t}=k{t}^{2}.\n$$"}] [{:db/id #edb/ref 17592186400986 :knowledge-point/_questions [{:db/id #edb/ref 17592186129254 :knowledge-point/id #uuid "344f1838-a027-5fd5-82da-17e9b4fcac2b" :knowledge-point/title "Further Translating Problems With Proportional Rates of Change Into Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e3609cc0-6b67-5266-9b4a-2f29d8232471" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}H}{\\text{d}t}=-k\\sqrt{H},\\,\\,k>0" :db/id #edb/ref 17592186400988} {:answer/id #uuid "ef6cd918-68d8-52d0-9155-4d41f4fd2598" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}H}{\\text{d}t}=k{H}^{2},\\,\\,k>0" :db/id #edb/ref 17592186400989} {:answer/id #uuid "add74caf-c6d7-5a05-a30c-9b03f535871e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}H}{\\text{d}t}=\\frac{k}{{H}^{2}},\\,\\,k>0" :db/id #edb/ref 17592186400990} {:answer/id #uuid "e048b22c-334e-593c-a1bb-448f1e70ae12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}H}{\\text{d}t}=-kH,\\,\\,k>0" :db/id #edb/ref 17592186400991} {:answer/id #uuid "1b08abf8-2a85-5a9c-9728-5bed51d13ad2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}H}{\\text{d}t}=-k{H}^{2},\\,\\,k>0" :db/id #edb/ref 17592186400992}] :answer-field/correct {:answer/id #uuid "1b08abf8-2a85-5a9c-9728-5bed51d13ad2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}H}{\\text{d}t}=-k{H}^{2},\\,\\,k>0" :db/id #edb/ref 17592186400992} :answer-field/id #uuid "5afc3f62-82b2-5ca2-8452-04ff173cc875" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400987}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ae491dc9-9063-5d70-aa00-00c9f3a98d29" :question/math-academy-id "q-143037" :question/problem "Construction waste stored in a large pile is taken to a landfill. The height $H$ of the pile decreases with time. The rate of change of the pile's height is proportional to the square of the height. What differential equation describes the rate of change of the height at time $t?$" :question/worked-solution "Let's highlight the important words in the given statement:\n\n*The **height** $H$ of the pile **decreases** with time. The **rate** of change of the pile's height is **proportional** to the **square of the height**.  *\n\nWe note the following:\n\n- The question describes the *rate* at which the *height* varies. Therefore, this is a statement about the quantity \n\n$$\n\\frac{\\text{d}H}{\\text{d}t}.\n$$\n\n- We're told that $\\frac{\\text{d}H}{\\text{d}t}$ is *proportional to* the *height squared.* In other words,\n\n$$\n\\frac{\\text{d}H}{\\text{d}t}∝{H}^{2}.\n$$\n\nRecall that $∝$ means \"is proportional to.\"\n\n- Finally, we want to replace the proportionality symbol with an equality symbol. Let $k$ be a positive constant. Since the height *decreases* with time, our derivative should be *negative*. Therefore, we can rewrite our proportionality statement as\n\n$$\n\\frac{\\text{d}H}{\\text{d}t}=-k{H}^{2}.\n$$"}] [{:db/id #edb/ref 17592186275097 :knowledge-point/_questions [{:db/id #edb/ref 17592186129255 :knowledge-point/id #uuid "0d6e417b-e2a7-57f1-8dcd-4de5ff5d7e6b" :knowledge-point/title "Translating Problems With Inversely Proportional Rates of Change Into Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2436f27f-1634-55ef-aead-d778e11c2cc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}H}{\\text{d}t}=\\frac{k}{t},\\,k>0" :db/id #edb/ref 17592186272702} {:answer/id #uuid "4455951a-0157-5f6a-a005-7674c71e934f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}H}{\\text{d}t}=kH,\\,k>0" :db/id #edb/ref 17592186272969} {:answer/id #uuid "4570ec55-77f2-53e8-9a0c-02dd9a42b532" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}H}{\\text{d}t}=-\\frac{k}{H},\\,k>0" :db/id #edb/ref 17592186272982} {:answer/id #uuid "667e7288-797c-556c-9789-84e3a5cb5869" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}H}{\\text{d}t}=\\frac{k}{H},\\,k>0" :db/id #edb/ref 17592186273266} {:answer/id #uuid "afff6121-6ec7-50a7-a15b-8d1bf26b38bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}H}{\\text{d}t}=-kH,\\,k>0" :db/id #edb/ref 17592186273911}] :answer-field/correct {:answer/id #uuid "667e7288-797c-556c-9789-84e3a5cb5869" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}H}{\\text{d}t}=\\frac{k}{H},\\,k>0" :db/id #edb/ref 17592186273266} :answer-field/id #uuid "9907c20c-faae-5465-84a3-710fbb1f5157" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274903}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "84b0c1a4-e271-5034-a361-66c829b30871" :question/math-academy-id "q-143058" :question/problem "The height $H$ of a tree increases at a rate that's inversely proportional to the tree's height at that moment.\nWhat differential equation describes the rate of change of the height $H?$" :question/worked-solution "Let's highlight the important words in the given statement:\n\n*The **height** $H$ of a tree **increases** at a rate that's **inversely proportional** to the **tree's height** $H$ at that moment. *\n\nWe note the following:\n\n- The question describes the *rate* at which the *height* varies. Therefore, this is a statement about the quantity \n\n$$\n\\frac{\\text{d}H}{\\text{d}t}.\n$$\n\n- We're told that $\\frac{\\text{d}H}{\\text{d}t}$ is *inversely proportional to* the *tree's height.* In other words,\n\n$$\n\\frac{\\text{d}H}{\\text{d}t}∝\\frac{1}{H}.\n$$\n\nRecall that $∝$ means \"is proportional to.\"\n\n- Finally, we want to replace the proportionality symbol with an equality symbol. Let $k$ be a positive constant. Since the height *increases* with time, our derivative should be *positive*. Therefore, we can rewrite our proportionality statement as\n\n$$\n\\frac{\\text{d}H}{\\text{d}t}=\\frac{k}{H}.\n$$"}] [{:db/id #edb/ref 17592186275100 :knowledge-point/_questions [{:db/id #edb/ref 17592186129255 :knowledge-point/id #uuid "0d6e417b-e2a7-57f1-8dcd-4de5ff5d7e6b" :knowledge-point/title "Translating Problems With Inversely Proportional Rates of Change Into Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "133f844a-4312-5bd2-ab69-68d1351f226d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}I}{\\text{d}t}=\\frac{k}{{I}^{2}},\\,k>0" :db/id #edb/ref 17592186272560} {:answer/id #uuid "76433e0e-b6f1-50c6-b680-b5d9442470ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}I}{\\text{d}t}=k{d}^{2},\\,k>0" :db/id #edb/ref 17592186273393} {:answer/id #uuid "7c021777-6381-5415-9262-3a00a2f839df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}I}{\\text{d}t}=\\frac{k}{{d}^{2}},\\,k>0" :db/id #edb/ref 17592186273452} {:answer/id #uuid "9e6bb2c6-7f7d-52d4-83f1-dd98077dee58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}I}{\\text{d}t}=-\\frac{k}{{d}^{2}},\\,k>0" :db/id #edb/ref 17592186273755} {:answer/id #uuid "b48dddd5-60c2-51e7-9744-1a56ea937f63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}I}{\\text{d}t}=-k{I}^{2},\\,k>0" :db/id #edb/ref 17592186273952}] :answer-field/correct {:answer/id #uuid "7c021777-6381-5415-9262-3a00a2f839df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}I}{\\text{d}t}=\\frac{k}{{d}^{2}},\\,k>0" :db/id #edb/ref 17592186273452} :answer-field/id #uuid "2390a578-69f1-59f6-ac10-8dcc9a873d0c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274701}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "08dff106-f96a-56cf-a1c9-2c911e731dc2" :question/math-academy-id "q-143078" :question/problem "The intensity $I$ of a light source with a motion sensor increases at a rate that's inversely proportional to the square of the distance $d$ from the source to the object detected by the sensor. What differential equation describes the rate of change of the intensity of the light source $I?$" :question/worked-solution "Let's highlight the important words in the given statement:\n\n*The **intensity** $I$ of a light source with a motion sensor **increases** at a rate that's **inversely proportional** to the **square of the distance** $d$ from the source to the object detected by the sensor.*\n\nWe note the following:\n\n- The question describes the *rate* at which the *intensity* varies. Therefore, this is a statement about the quantity \n\n$$\n\\frac{\\text{d}I}{\\text{d}t}.\n$$\n\n- We're told that $\\frac{\\text{d}I}{\\text{d}t}$ is *inversely proportional to* the *square of the distance.* In other words,\n\n$$\n\\frac{\\text{d}I}{\\text{d}t}∝\\frac{1}{{d}^{2}}.\n$$\n\nRecall that $∝$ means \"is proportional to.\"\n\n- Finally, we want to replace the proportionality symbol with an equality symbol. Let $k$ be a positive constant. Since the intensity *increases* with time, our derivative should be *positive*. Therefore, we can rewrite our proportionality statement as\n\n$$\n\\frac{\\text{d}I}{\\text{d}t}=\\frac{k}{{d}^{2}}.\n$$"}] [{:db/id #edb/ref 17592186275102 :knowledge-point/_questions [{:db/id #edb/ref 17592186129255 :knowledge-point/id #uuid "0d6e417b-e2a7-57f1-8dcd-4de5ff5d7e6b" :knowledge-point/title "Translating Problems With Inversely Proportional Rates of Change Into Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "582e1cd2-f74b-5140-8610-669309748a9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}S}{\\text{d}t}=-\\frac{k}{{t}^{2}},\\,k>0" :db/id #edb/ref 17592186273143} {:answer/id #uuid "64d17f1a-01b3-5d0c-9bf7-d48e4f4b49d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}S}{\\text{d}t}=\\frac{k}{{S}^{2}},\\,k>0" :db/id #edb/ref 17592186273248} {:answer/id #uuid "b7e69931-037e-50c1-a916-7e9c71b4fcb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}S}{\\text{d}t}=-\\frac{k}{{S}^{2}},\\,k>0" :db/id #edb/ref 17592186273981} {:answer/id #uuid "baedb316-fcf8-5290-b8ec-4e82047b2ff1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}S}{\\text{d}t}=\\frac{k}{t},\\,k>0" :db/id #edb/ref 17592186274008} {:answer/id #uuid "d0dfa4da-4682-5111-a617-33c1c5f82bdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}S}{\\text{d}t}=-k{t}^{2},\\,k>0" :db/id #edb/ref 17592186274206}] :answer-field/correct {:answer/id #uuid "582e1cd2-f74b-5140-8610-669309748a9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}S}{\\text{d}t}=-\\frac{k}{{t}^{2}},\\,k>0" :db/id #edb/ref 17592186273143} :answer-field/id #uuid "5eaa6e8b-669c-5938-b2d7-bde9b42bcf0d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274798}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0594774f-7b3e-5278-854b-b5d417c6c3ae" :question/math-academy-id "q-143094" :question/problem "The speed $S$ of an object decreases at a rate that's inversely proportional to the square of the travel time $t.$ What differential equation describes the rate of change of the speed $S?$" :question/worked-solution "Let's highlight the important words in the given statement:\n\n*The **speed** $S$ of an object **decreases** at a rate that's **inversely proportional** to the **square of the travel time** $t.$*\n\nWe note the following:\n\n- The question describes the *rate* at which the *speed* varies. Therefore, this is a statement about the quantity \n\n$$\n\\frac{\\text{d}S}{\\text{d}t}.\n$$\n\n- We're told that $\\frac{\\text{d}S}{\\text{d}t}$ is *inversely proportional to* the *square of the travel time.* In other words,\n\n$$\n\\frac{\\text{d}S}{\\text{d}t}∝\\frac{1}{{t}^{2}}.\n$$\n\nRecall that $∝$ means \"is proportional to.\"\n\n- Finally, we want to replace the proportionality symbol with an equality symbol. Let $k$ be a positive constant. Since the speed *decreases* with time, our derivative should be *negative*. Therefore, we can rewrite our proportionality statement as\n\n$$\n\\frac{\\text{d}S}{\\text{d}t}=-\\frac{k}{{t}^{2}}.\n$$"}] [{:db/id #edb/ref 17592186388876 :knowledge-point/_questions [{:db/id #edb/ref 17592186184138 :knowledge-point/id #uuid "031f0fd6-385d-56b8-9e8e-b264e6e89ed3" :knowledge-point/title "Identifying the Graph of a Non-Strict Inequality Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5d1ab9e-6505-5ada-bb33-19f9bd4b6196" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f1/f18b75a1d71e01bd898e14a66bbec923abd988c72a8e9d69451c8edf1d16fc72.png" :db/id #edb/ref 17592186388878} {:answer/id #uuid "31235479-4830-5e58-9e6a-edbce55b30c2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/41/418e4724130ac11b03ea2b293f36e81d712a5364ed5addf70ae2900ef196d650.png" :db/id #edb/ref 17592186388879} {:answer/id #uuid "1531163f-68b6-5905-887d-2355ab556c8e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/74/7433238f7537aeb303f9a8bd595266a9525d286c1e162cd5b228eb0b861e382b.png" :db/id #edb/ref 17592186388880} {:answer/id #uuid "19ffdb9e-fbc8-562f-a75b-7b78615f6a3b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ae/ae74be6af41cbfd239e15f7bb2e2e09504dbb718c3f308ab41157a6251daad01.png" :db/id #edb/ref 17592186388881} {:answer/id #uuid "1bb9fd78-57ff-5323-aa10-946351508419" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/6b/6bc89797cabfa5cc5e1baec5bf576fd81e4dd48fb9ff646009bd6cdad7e42c73.png" :db/id #edb/ref 17592186388882}] :answer-field/correct {:answer/id #uuid "31235479-4830-5e58-9e6a-edbce55b30c2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/41/418e4724130ac11b03ea2b293f36e81d712a5364ed5addf70ae2900ef196d650.png" :db/id #edb/ref 17592186388879} :answer-field/id #uuid "e5ab8004-673e-5920-a0af-c5b35bc2a73c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388877}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ea4847f7-e663-5fb5-abcf-705c57877607" :question/math-academy-id "q-143098" :question/problem "Which of the following shaded areas describes the region bounded by the inequality $3x-2y\\ge 6?$" :question/worked-solution "First, we convert the inequality into slope-intercept form:\n\n$$\n\\begin{aligned}3x-2y & \\ge 6 \\\\ -2y & \\ge -3x+6 \\\\ y & \\le \\frac{3}{2}x-3\\end{aligned}\n$$\n\nNow, we proceed as usual. We start by drawing the corresponding straight line \n\n$$\ny=\\frac{3}{2}x-3.\n$$\n\n Since the inequality involves a 'less than *or equal to*' sign, the line $y=\\frac{3}{2}x-3$ itself is part of the solution. Therefore, we draw a **solid line**.\n\nThen, we need to decide whether to shade above or below the line. The inequality \n\n$$\ny\\le \\frac{3}{2}x-3\n$$\n\n refers to the $y$-values that are *less than* or equal to those on the line $y=\\frac{3}{2}x-3,$ so we shade *below* the line.\n\n![](images/ea/ea12ed8d62304ecdc90859d5cd206045cef852522ce16c67a9307ddbd755b3dc.png)"}] [{:db/id #edb/ref 17592186398480 :knowledge-point/_questions [{:db/id #edb/ref 17592186184148 :knowledge-point/id #uuid "dac9c72b-c23f-56fa-b939-6e3b56d3a13b" :knowledge-point/title "Identifying the Horizontal Stretch and Vertical Shift of a Transformed Cotangent Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f9abc86-74e1-5d19-8f4f-0f0e7a56d821" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186398482} {:answer/id #uuid "ab992999-a43c-5b0c-874e-f97040b58cc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186398483} {:answer/id #uuid "d0aa5750-a42b-5232-a712-34850cd9b3f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{2}" :db/id #edb/ref 17592186398484} {:answer/id #uuid "91869c0b-2488-53b8-980c-0c2c402ce0f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{2}" :db/id #edb/ref 17592186398485} {:answer/id #uuid "9e0d1de6-b1c8-5a40-bc71-a155680b07fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{2}" :db/id #edb/ref 17592186398486}] :answer-field/correct {:answer/id #uuid "9e0d1de6-b1c8-5a40-bc71-a155680b07fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{2}" :db/id #edb/ref 17592186398486} :answer-field/id #uuid "a33bc7f4-158e-59b4-b555-27008daa9757" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398481}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d39218d1-1972-5152-bee8-516235be3a28" :question/math-academy-id "q-143669" :question/problem "![](images/f8/f86984919b15283134e1b3a9479ff8c79ec8dfacc84975e82f88704b7b26dd3a.png)\n\nThe graph above shows the function $y=\\operatorname{cot}⁡(Bx)+D,$ where $B$ and $D$ are constants. What is  $B-2D?$" :question/worked-solution "The period $T$ of the function is\n\n$$\nT=\\frac{\\pi }{4}.\n$$\n\nThe formula for the period $T$ of the function $y=A\\operatorname{cot}⁡(Bx+C)+D$ is given by \n\n$$\nT=\\frac{\\pi }{B}.\n$$\n\nApplying the formula of the period, we get\n\n$$\n\\frac{\\pi }{4}=\\frac{\\pi }{B}\\,⟹\\,B=\\frac{\\pi }{(\\frac{\\pi }{4})}=4.\n$$\n\nThe parameter $D$ represents the vertical shift of the cotangent function. We see that the function has been translated by $\\frac{9}{4}$ unit down. Therefore, $D=-\\frac{9}{4}.$\n\nTherefore, $B-2D=4-2\\cdot (-\\frac{9}{4})=4+\\frac{9}{2}=\\frac{17}{2}.$  \n\nFinally, the equation of the curve is\n\n$$\ny=\\operatorname{cot}⁡(4x)-\\frac{9}{4}.\n$$"}]}
