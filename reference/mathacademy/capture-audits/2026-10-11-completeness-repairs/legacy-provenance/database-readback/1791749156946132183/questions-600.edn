alue "y=-\\frac{6}{7}x+8" :db/id #edb/ref 17592186266261} {:answer/id #uuid "222179f7-b6d3-5bda-ba3b-3ad5ca6b0879" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{2}{3}x+9" :db/id #edb/ref 17592186266448} {:answer/id #uuid "676d808b-15b5-5614-89b0-8e029be3a390" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{6}{7}x+9" :db/id #edb/ref 17592186267061} {:answer/id #uuid "a05574d9-4140-5362-b547-5792491d39de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{5}{7}x+9" :db/id #edb/ref 17592186267591} {:answer/id #uuid "a5de5494-8c30-5f08-bbb3-f4fedda8e8dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{5}{7}x+8" :db/id #edb/ref 17592186267644}] :answer-field/correct {:answer/id #uuid "676d808b-15b5-5614-89b0-8e029be3a390" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{6}{7}x+9" :db/id #edb/ref 17592186267061} :answer-field/id #uuid "90a152be-2b26-5653-9dda-9d79bf62f9af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268659}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cb94748a-2270-55c2-8da9-a11e4005f88b" :question/math-academy-id "q-134019" :question/problem "![](images/31/31394106551498e7fd3a5cf57773f11ae31c7bc80c9a12272e95033bdcfd462e.png)\n\nDetermine the equation of the trend line shown above." :question/worked-solution "Notice that the trend line passes through the points $({x}_{1},{y}_{1})=(0,9)$ and $({x}_{2},{y}_{2})=(7,3).$\n\nWe will write the equation of the line in the slope-intercept form \n\n$$\ny=mx+b.\n$$\n\nFirst, we compute the slope $m$ of the line, as follows:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{3-9}{7-0} \\\\  & =\\frac{-6}{7} \\\\  & =-\\frac{6}{7}\\end{aligned}\n$$\n\nSubstituting $m=-\\frac{6}{7}$ into the slope-intercept form above, we get\n\n$$\ny=-\\frac{6}{7}x+b.\n$$\n\nWe now need to find the $y$-intercept $b.$ We can find this by substituting the coordinates of a point on the line. Any point will do, so let's substitute $(0,9):$\n\n$$\n\\begin{aligned}y & =-\\frac{6}{7}x+b \\\\ 9 & =-\\frac{6}{7}(0)+b \\\\ 9 & =0+b \\\\ b & =9\\end{aligned}\n$$\n\nTherefore, the equation of the line is \n\n$$\ny=-\\frac{6}{7}x+9.\n$$"}] [{:db/id #edb/ref 17592186268954 :knowledge-point/_questions [{:db/id #edb/ref 17592186152237 :knowledge-point/id #uuid "63426ad7-4275-5ac3-854d-e91ec00dcbe3" :knowledge-point/title "Determining the Equation of a Trendline"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3800c633-4663-5a7c-977b-4d0c6dda0f87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{7}{5}x-\\frac{3}{5}" :db/id #edb/ref 17592186266629} {:answer/id #uuid "53efa526-eb5e-5256-af09-1eec2833abff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{7}{5}x-\\frac{2}{5}" :db/id #edb/ref 17592186266895} {:answer/id #uuid "aba8afc3-be94-5f08-8b22-73af4c6b41c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{6}{5}x-\\frac{2}{5}" :db/id #edb/ref 17592186267693} {:answer/id #uuid "ef8916a0-dcf5-50b0-b591-84f24b525679" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{8}{5}x-\\frac{3}{5}" :db/id #edb/ref 17592186268274} {:answer/id #uuid "f31ff6ea-86e9-5bba-a3ed-309adf564a34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{6}{5}x-\\frac{3}{5}" :db/id #edb/ref 17592186268306}] :answer-field/correct {:answer/id #uuid "aba8afc3-be94-5f08-8b22-73af4c6b41c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{6}{5}x-\\frac{2}{5}" :db/id #edb/ref 17592186267693} :answer-field/id #uuid "d9d24660-a466-52cd-ab29-3ad82a1272ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268793}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1c42b7eb-86b2-59d5-8ce6-728291f9e718" :question/math-academy-id "q-134023" :question/problem "![](images/1c/1c9f30692222eaaed4cda6b608dcc1ccb01eefd6b5fa7730b5b8bb29c9f528b1.png)\n\nDetermine the equation of the trend line shown above." :question/worked-solution "Notice that the trend line passes through the points $({x}_{1},{y}_{1})=(2,2)$ and $({x}_{2},{y}_{2})=(7,8).$\n\nWe will write the equation of the line in the slope-intercept form \n\n$$\ny=mx+b.\n$$\n\nFirst, we compute the slope $m$ of the line, as follows:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{8-2}{7-2} \\\\  & =\\frac{6}{5}\\end{aligned}\n$$\n\nSubstituting $m=\\frac{6}{5}$ into the slope-intercept form above, we get\n\n$$\ny=\\frac{6}{5}x+b.\n$$\n\nWe now need to find the $y$-intercept $b.$ We can find this by substituting the coordinates of a point on the line. Any point will do, so let's substitute $(2,2):$\n\n$$\n\\begin{aligned}y & =\\frac{6}{5}x+b \\\\ 2 & =\\frac{6}{5}(2)+b \\\\ 2 & =\\frac{12}{5}+b \\\\ 10 & =12+5b \\\\ -2 & =5b \\\\ b & =-\\frac{2}{5}\\end{aligned}\n$$\n\nTherefore, the equation of the line is \n\n$$\ny=\\frac{6}{5}x-\\frac{2}{5}.\n$$"}] [{:db/id #edb/ref 17592186268955 :knowledge-point/_questions [{:db/id #edb/ref 17592186152238 :knowledge-point/id #uuid "890526df-fd1a-5340-8732-efc0c1a1b0ae" :knowledge-point/title "Estimating the Equation of a Trendline"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f69d6d6-f65d-5ba2-a0d2-ec96450b904c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1.5" :db/id #edb/ref 17592186266563} {:answer/id #uuid "5d2b2005-e668-56d9-b3b4-b2d1d38ff629" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186266964} {:answer/id #uuid "99a06ebc-ac19-5f94-a156-eb204f48255f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.5" :db/id #edb/ref 17592186267534} {:answer/id #uuid "a5340cd2-a9ed-55b6-9b11-313ff0af8372" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2.5" :db/id #edb/ref 17592186267633} {:answer/id #uuid "e72106a0-7ad8-5146-bba3-a4016a76a043" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.5" :db/id #edb/ref 17592186268193}] :answer-field/correct {:answer/id #uuid "2f69d6d6-f65d-5ba2-a0d2-ec96450b904c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1.5" :db/id #edb/ref 17592186266563} :answer-field/id #uuid "a41ee374-e612-55c4-a15d-7afecd007c01" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268699}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fec0ce3a-bf15-5c41-9f72-214fd8c31558" :question/math-academy-id "q-134025" :question/problem "![](images/c8/c8f6d0161777412704a9a80c0336af04a6968454d421913055024b6d0cf11c71.png)\n\nEstimate the slope of the trend line for the scatter plot above. Round your answer to the nearest $0.5.$" :question/worked-solution "First, let's draw an approximate trend line for our scatter plot:\n\n![](images/b5/b50fd1636cc2e1bb9d150eaba9cc25a3ccedff77e607bf22853004332a7c4ddc.png)\n\nIt seems that the trend line passes through $({x}_{1},{y}_{1})≈(3,6)$ and $({x}_{2},{y}_{2})≈(5,3).$\n\nTherefore, we estimate the slope $m$ of the line as follows:\n\n$$\n\\begin{aligned}m & ≈\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{3-6}{5-3} \\\\  & =\\frac{-3}{2} \\\\  & =-1.5\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268957 :knowledge-point/_questions [{:db/id #edb/ref 17592186152238 :knowledge-point/id #uuid "890526df-fd1a-5340-8732-efc0c1a1b0ae" :knowledge-point/title "Estimating the Equation of a Trendline"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85e950e4-4f31-56d6-b780-7f613d916580" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-0.5x+7" :db/id #edb/ref 17592186267323} {:answer/id #uuid "95835b8d-412b-5f8f-ad13-bd0cceeefc76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-1.5x+6" :db/id #edb/ref 17592186267479} {:answer/id #uuid "e9f40f28-45a1-51e8-91ce-8332e573ca21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x+5" :db/id #edb/ref 17592186268230} {:answer/id #uuid "fa3381b5-606e-57ef-aa88-1eeb423ceab7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-0.5x+5" :db/id #edb/ref 17592186268360} {:answer/id #uuid "fa94c930-a716-5697-abac-a07e0bafa0ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x+7" :db/id #edb/ref 17592186268362}] :answer-field/correct {:answer/id #uuid "fa94c930-a716-5697-abac-a07e0bafa0ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x+7" :db/id #edb/ref 17592186268362} :answer-field/id #uuid "202555d8-a079-561f-a3ef-02ab11a55efb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268456}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cd67326e-eade-5de0-b602-784a91831a0b" :question/math-academy-id "q-134031" :question/problem "![](images/11/111833881cf8e939d896f23a5ab7ca436f9265e7b8fd66c099eb118eab8fd6b0.png)\n\nEstimate the equation of the trend line for the scatter plot above. Round both the slope and the $y$-intercept to the nearest $0.5.$" :question/worked-solution "First, let's draw an approximate trend line for our scatter plot:\n\n![](images/fd/fdad2c939372e14617ba4e393037d7f5852cd8114467aa914ccb8963c0eacfeb.png)\n\nIt seems that the trend line passes through $({x}_{1},{y}_{1})≈(2,5)$ and $({x}_{2},{y}_{2})≈(6,1).$\n\nWe will write the equation of the line in the slope-intercept form \n\n$$\ny=mx+b.\n$$\n\nFirst, we estimate the slope $m$ of the line as follows:\n\n$$\n\\begin{aligned}m & ≈\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{1-5}{6-2} \\\\  & =\\frac{-4}{4} \\\\  & =-1\\end{aligned}\n$$\n\nSubstituting $m=-1$ into the slope-intercept form above, we get\n\n$$\ny=-x+b.\n$$\n\nWe now need to estimate the $y$-intercept $b.$ We can do this by substituting the coordinates of a point on the line. Any point will do, so let's substitute $(2,5):$\n\n$$\n\\begin{aligned}y & =-x+b \\\\ 5 & =-2+b \\\\ 7 & =b \\\\ b & =7\\end{aligned}\n$$\n\nTherefore, the equation of the line is \n\n$$\ny=-x+7.\n$$"}] [{:db/id #edb/ref 17592186268961 :knowledge-point/_questions [{:db/id #edb/ref 17592186152235 :knowledge-point/id #uuid "7f99f2aa-f977-5d6e-ae62-a826a897ba9b" :knowledge-point/title "Reading a Scatter Plot"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93b0f7b8-b781-54c4-a185-a692da720e33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90%" :db/id #edb/ref 17592186267467} {:answer/id #uuid "93c6b873-1244-55dd-a5d0-7e953959f130" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "85%" :db/id #edb/ref 17592186267468} {:answer/id #uuid "ba35ff19-d85c-5142-84b2-93a8f390294b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70%" :db/id #edb/ref 17592186267815} {:answer/id #uuid "ce9bdb9f-cdf1-552b-86b5-3b68d3b691fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "75%" :db/id #edb/ref 17592186267992} {:answer/id #uuid "da1adb01-9156-561a-b4db-38e2dc065dd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80%" :db/id #edb/ref 17592186268075}] :answer-field/correct {:answer/id #uuid "93c6b873-1244-55dd-a5d0-7e953959f130" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "85%" :db/id #edb/ref 17592186267468} :answer-field/id #uuid "0c7565e4-dc8a-5b42-b83a-83fc7e504012" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268431}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "43fcfab7-3240-5e37-8741-3769fb9bd3d5" :question/math-academy-id "q-134043" :question/problem "![](images/80/80d08441967f6c1a4026fe9ca0d2bdfdde8fac57a2ae0a7b8d6b34889f3469bd.png)\n\nThe scatter plot above shows the relationship between hours of study per week and the overall percentage obtained by students in a math class. What was the overall percentage obtained by the student who studied, on average,  $7$ hours each week?" :question/worked-solution "![](images/39/39e7370f9cf517a7a139fecf71561041a9b1470150e0fa333d3fff679f77882d.png)\n\n    \n\nTo determine the overall percentage obtained by the student who studied $7$ hours each week, we locate $7$ on the horizontal axis and move in the vertical direction until we find some points, as shown above.\n\nThe highlighted point has coordinates $(7,85).$ Therefore, the student who studied $7$ hours each week obtained an overall percentage of $85%.$"}] [{:db/id #edb/ref 17592186398382 :knowledge-point/_questions [{:db/id #edb/ref 17592186152235 :knowledge-point/id #uuid "7f99f2aa-f977-5d6e-ae62-a826a897ba9b" :knowledge-point/title "Reading a Scatter Plot"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b931d3b-ada2-5b04-a7ba-3e5388b9aa35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186398384} {:answer/id #uuid "ce0bbf2c-bd3b-5933-b107-38c36abe9e06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186398385} {:answer/id #uuid "1275d8d1-87ea-51ac-80ba-d13b5b0d06d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186398386} {:answer/id #uuid "c0d3ff95-8a16-5335-b1eb-84d2fbc5830f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186398387} {:answer/id #uuid "cf078eaa-4e8e-529e-aeaf-cf7c18b72b3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186398388}] :answer-field/correct {:answer/id #uuid "1275d8d1-87ea-51ac-80ba-d13b5b0d06d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186398386} :answer-field/id #uuid "c816f258-3ddf-536d-ab66-8610e4b22204" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398383}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6b5dde64-1d37-5f32-890c-5a590a1188e6" :question/math-academy-id "q-134085" :question/problem "![](images/55/551ed1182231e19a08653c86ffb7b117c2dc9497b6927f6287ffcd10651b5f56.png)\n\nThe scatter plot above shows the relationship between the number of absences in a month and the size of a class. How many absences were there in a class whose size is $20$ students?" :question/worked-solution "![](images/80/8088e41a66b4aba259d95f3099f71d5777caf876e9278e6b7f11c865ab12f7e0.png)\n\nTo determine the number of absences there were in a class whose size is $20$ students, we locate $20$ on the horizontal axis and move in the vertical direction until we find some points, as shown above.\n\nThe highlighted point has coordinates $(20,6).$ Therefore, there was a total of $6$ absences in the month for the class with $20$ students."}] [{:db/id #edb/ref 17592186268969 :knowledge-point/_questions [{:db/id #edb/ref 17592186175936 :knowledge-point/id #uuid "a2ac0065-9315-547a-a9cf-c6a5abea1aed" :knowledge-point/title "Computing Covariance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "311e284a-a84b-5e7f-b5a1-e35c8f0d5168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186266576} {:answer/id #uuid "64ccf930-ce1a-5735-bf79-470826f036dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186267036} {:answer/id #uuid "76132fbf-5e71-5e70-90ec-a505fc2186fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186267185} {:answer/id #uuid "853262fc-b92a-5438-baec-a53e6c209102" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186267317} {:answer/id #uuid "a31cd77b-6b2c-52dc-a626-7500d351a1a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186267611}] :answer-field/correct {:answer/id #uuid "311e284a-a84b-5e7f-b5a1-e35c8f0d5168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186266576} :answer-field/id #uuid "aca651ef-8c84-5b8a-8875-73fe007986c0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268716}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1d0e8ef1-dbd3-5d5d-b9cb-f3092550c8dd" :question/math-academy-id "q-134155" :question/problem "Consider the following data sets:\n\n$$\nx={4,\\,6,\\,8,\\,2},\\,y={2,\\,4,\\,10,\\,8}\n$$\n\nYou're given that $\\overset{―}{x}=5$ and $\\overset{―}{y}=6.$ Calculate $\\text{Cov}(x,y).$" :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(4-5)(2-6)+(6-5)(4-6)+(8-5)(10-6)+(2-5)(8-6)] \\\\  & =\\frac{1}{4}[(-1)(-4)+(1)(-2)+(3)(4)+(-3)(2)] \\\\  & =\\frac{1}{4}[4-2+12-6] \\\\  & =\\frac{1}{4}\\cdot 8 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268973 :knowledge-point/_questions [{:db/id #edb/ref 17592186175936 :knowledge-point/id #uuid "a2ac0065-9315-547a-a9cf-c6a5abea1aed" :knowledge-point/title "Computing Covariance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c96926a-f4ac-5a4a-bb28-483eebe3a042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186267101} {:answer/id #uuid "92bb008b-73e2-5f57-aaf9-b1c9670bb361" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186267454} {:answer/id #uuid "98e29162-e94e-5e48-a63c-803330198e5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186267522} {:answer/id #uuid "de2ab8f0-3c69-58b4-9838-f8a533c7f98f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186268105} {:answer/id #uuid "f2efc021-dda9-5c9f-ba17-5d373e53d90c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186268303}] :answer-field/correct {:answer/id #uuid "de2ab8f0-3c69-58b4-9838-f8a533c7f98f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186268105} :answer-field/id #uuid "69377ba2-c0ef-5769-b77b-40c99fa0f34c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268596}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4cf798d3-99fb-51d5-934b-1e9180edf066" :question/math-academy-id "q-134159" :question/problem "Consider the following data sets:\n\n$$\nx={-1,\\,6,\\,2,\\,5},\\,y={-2,\\,5,\\,7,\\,6}\n$$\n\nYou're given that $\\overset{―}{x}=3$ and $\\overset{―}{y}=4.$ Calculate $\\text{Cov}(x,y).$" :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(-1-3)(-2-4)+(6-3)(5-4)+(2-3)(7-4)+(5-3)(6-4)] \\\\  & =\\frac{1}{4}[(-4)(-6)+(3)(1)+(-1)(3)+(2)(2)] \\\\  & =\\frac{1}{4}[24+3-3+4] \\\\  & =\\frac{1}{4}\\cdot 28 \\\\  & =7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268975 :knowledge-point/_questions [{:db/id #edb/ref 17592186176030 :knowledge-point/id #uuid "88babe91-d8bf-53ba-8d72-35ad35f9253e" :knowledge-point/title "Calculating the Speed of an Object"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "048cab5e-bbd5-5811-a4d0-8ca8f85ee145" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ feet per second" :db/id #edb/ref 17592186266183} {:answer/id #uuid "1cf5c97b-a06e-5922-ae8a-d7e195b65387" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$14$ feet per second" :db/id #edb/ref 17592186266390} {:answer/id #uuid "b717b37d-f4d7-5f70-ac90-3365030a3801" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$280$ feet per second" :db/id #edb/ref 17592186267783} {:answer/id #uuid "de613ffe-4f41-5a9b-bffe-1b7387734d36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$40$ feet per second" :db/id #edb/ref 17592186268107} {:answer/id #uuid "f9712262-c406-555b-85c5-19c0f9652329" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$70$ feet per second" :db/id #edb/ref 17592186268355}] :answer-field/correct {:answer/id #uuid "048cab5e-bbd5-5811-a4d0-8ca8f85ee145" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ feet per second" :db/id #edb/ref 17592186266183} :answer-field/id #uuid "aa305f49-8c63-5967-8dbe-bb8cee6aab2a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268711}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "363ac4b8-fa48-5948-b74e-bd2bdaf627fa" :question/math-academy-id "q-134164" :question/problem "A canoe traveled $280$ feet in $70$ seconds at a constant rate.  What is the speed of the canoe?" :question/worked-solution "Speed is a special unit rate applied to moving objects. It is defined as *the distance traveled per unit of time*:\n\n$$\n\\text{speed}=\\frac{\\text{distance}}{\\text{time}}\n$$\n\nTo find the speed (in feet per second), we divide the number of feet, $280,$ by the number of seconds, $70.$ This gives,\n\n$$\n\\frac{280}{70}=280÷70=4.\n$$\n\nTherefore, the speed of the canoe is $4$ feet per second."}] [{:db/id #edb/ref 17592186268976 :knowledge-point/_questions [{:db/id #edb/ref 17592186175936 :knowledge-point/id #uuid "a2ac0065-9315-547a-a9cf-c6a5abea1aed" :knowledge-point/title "Computing Covariance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1734a15f-874d-52cb-8d30-537856adcf27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186266335} {:answer/id #uuid "309a7988-0056-5a91-9b26-9a7b3519e0b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.5" :db/id #edb/ref 17592186266573} {:answer/id #uuid "3ec15ade-734f-5f08-ba36-35c627ef7aaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186266703} {:answer/id #uuid "705e7a42-43a7-5e4c-a8c2-9f9d96502073" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186267134} {:answer/id #uuid "e61a6207-fc30-52f4-95a9-3b512b98a5eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186268185}] :answer-field/correct {:answer/id #uuid "e61a6207-fc30-52f4-95a9-3b512b98a5eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186268185} :answer-field/id #uuid "c8753d47-2823-5959-a5f0-f5cdc3afcd3c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268766}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a837e578-9d21-592b-8de3-2aa17ce381f9" :question/math-academy-id "q-134165" :question/problem "Consider the following data sets:\n\n$$\nx={1,\\,4,\\,7,\\,12},\\,y={2,\\,4,\\,2,\\,8}\n$$\n\nYou're given that $\\overset{―}{x}=6$ and $\\overset{―}{y}=4.$ Calculate $\\text{Cov}(x,y).$" :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(1-6)(2-4)+(4-6)(4-4)+(7-6)(2-4)+(12-6)(8-4)] \\\\  & =\\frac{1}{4}[(-5)(-2)+(-2)(0)+(1)(-2)+(6)(4)] \\\\  & =\\frac{1}{4}[10+0-2+24] \\\\  & =\\frac{1}{4}\\cdot 32 \\\\  & =8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268979 :knowledge-point/_questions [{:db/id #edb/ref 17592186175936 :knowledge-point/id #uuid "a2ac0065-9315-547a-a9cf-c6a5abea1aed" :knowledge-point/title "Computing Covariance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "441b2c8e-dbaf-594e-9f26-8da9b148397f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186266751} {:answer/id #uuid "e5ea4787-26d6-5c8e-aa9d-ebc03249189b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186268180} {:answer/id #uuid "e5fd8492-13b4-5fa1-a203-4c2b1a8f2b15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186268182} {:answer/id #uuid "fb8685e4-075d-5c33-9c2e-d13e809a6745" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186268368} {:answer/id #uuid "fccdee25-35d1-5ea4-b1da-a4668ce1fbe4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186268374}] :answer-field/correct {:answer/id #uuid "441b2c8e-dbaf-594e-9f26-8da9b148397f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186266751} :answer-field/id #uuid "923f23dc-8259-592b-ae04-9981fc36c9d3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268661}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8776d2b8-cc6d-5825-8f19-b2c66c611b9a" :question/math-academy-id "q-134170" :question/problem "Calculate $\\text{Cov}(x,y)$ for the following data sets:\n\n$$\nx={4,\\,-2,\\,5,\\,1},\\,y={-7,\\,5,\\,4,\\,-2}\n$$" :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nFirst, we need to compute the means:\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{4}\\cdot (4+(-2)+5+1) \\\\  & =\\frac{1}{4}\\cdot 8 \\\\  & =2 \\\\ \\overset{―}{y} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i} \\\\  & =\\frac{1}{4}\\cdot ((-7)+5+4+(-2)) \\\\  & =\\frac{1}{4}\\cdot 0 \\\\  & =0\\end{aligned}\n$$\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(4-2)(-7-0)+(-2-2)(5-0)+(5-2)(4-0)+(1-2)(-2-0)] \\\\  & =\\frac{1}{4}[(2)(-7)+(-4)(5)+(3)(4)+(-1)(-2)] \\\\  & =\\frac{1}{4}[-14-20+12+2] \\\\  & =\\frac{1}{4}\\cdot (-20) \\\\  & =-5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268980 :knowledge-point/_questions [{:db/id #edb/ref 17592186176030 :knowledge-point/id #uuid "88babe91-d8bf-53ba-8d72-35ad35f9253e" :knowledge-point/title "Calculating the Speed of an Object"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "388381c6-d3f3-5ce8-9343-272755a4a1de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$145$ feet per minute" :db/id #edb/ref 17592186266636} {:answer/id #uuid "8f5968e7-47fd-59f2-84a5-9faaa2be9ff9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$150.5$ feet per minute" :db/id #edb/ref 17592186267423} {:answer/id #uuid "9918aa8c-9fab-5e35-b660-6a295161995a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$132.5$ feet per minute" :db/id #edb/ref 17592186267525} {:answer/id #uuid "a388233f-9461-523b-bf1c-23eb098cf553" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$301$ feet per minute" :db/id #edb/ref 17592186267615} {:answer/id #uuid "b60499d9-26b2-5a0d-b9b8-bf12fdf4495e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$75$ feet per minute" :db/id #edb/ref 17592186267770}] :answer-field/correct {:answer/id #uuid "8f5968e7-47fd-59f2-84a5-9faaa2be9ff9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$150.5$ feet per minute" :db/id #edb/ref 17592186267423} :answer-field/id #uuid "ed694b78-5bc8-5345-8197-6311533e4009" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268820}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9150e0d7-03db-545b-ba25-add48de4f78e" :question/math-academy-id "q-134172" :question/problem "An elevator covers $602$ feet in $4$ minutes, moving at a constant rate. What is the speed of the elevator?" :question/worked-solution "Speed is a special unit rate applied to moving objects. It is defined as *the distance traveled per unit of time*:\n\n$$\n\\text{speed}=\\frac{\\text{distance}}{\\text{time}}\n$$\n\nTo find the speed in feet per minute, we divide the number of feet, $602,$ by the number of minutes, $4.$ This gives,\n\n$$\n\\begin{aligned}\\frac{602}{4} & =\\frac{602÷2}{4÷2} \\\\  & =\\frac{301}{2} \\\\  & =301÷2 \\\\  & =150.5.\\end{aligned}\n$$\n\nTherefore, the speed of the elevator is $150.5$ feet per minute."}] [{:db/id #edb/ref 17592186268981 :knowledge-point/_questions [{:db/id #edb/ref 17592186175937 :knowledge-point/id #uuid "cee807c1-dd86-5b0e-a595-5c5754c47e4c" :knowledge-point/title "Computing Covariance in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88b47b3a-e1eb-56e3-8e5d-f4a75117a124" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186267359} {:answer/id #uuid "939eb21e-65d9-50c2-9f13-2a9c5beb9a7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186267466} {:answer/id #uuid "d0ce4537-3c51-5a6d-afe7-2fec5be72a5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186268011} {:answer/id #uuid "e9e26f0a-1b74-5e94-b5a5-bc4046928faa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.5" :db/id #edb/ref 17592186268228} {:answer/id #uuid "fec05032-593e-5492-9092-712f5a38fa46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.5" :db/id #edb/ref 17592186268386}] :answer-field/correct {:answer/id #uuid "939eb21e-65d9-50c2-9f13-2a9c5beb9a7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186267466} :answer-field/id #uuid "0c10a926-37e1-5762-a3bc-8007b371df78" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268430}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0a871439-561a-57b5-a2c7-bd992bf74497" :question/math-academy-id "q-134173" :question/problem "| **Time Spent Practicing, \nin hours ($x$)** | $4$ | $5$ | $7$ | $8$ |\n| --- | --- | --- | --- | --- |\n| **Points Scored ($y$)** | $4$ | $8$ | $12$ | $16$ |\n\nThe table above shows Mary's time practicing her jump shot each week and the number of points she scores in the Friday varsity basketball game. Compute the covariance of the data sets given that the means are $\\overset{―}{x}=6$ and $\\overset{―}{y}=10.$" :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(4-6)(4-10)+(5-6)(8-10)+(7-6)(12-10)+(8-6)(16-10)] \\\\  & =\\frac{1}{4}[(-2)(-6)+(-1)(-2)+(1)(2)+(2)(6)] \\\\  & =\\frac{1}{4}[12+2+2+12] \\\\  & =\\frac{1}{4}\\cdot 28 \\\\  & =7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268990 :knowledge-point/_questions [{:db/id #edb/ref 17592186176032 :knowledge-point/id #uuid "6570253a-b05a-5721-9108-5fddab2b5388" :knowledge-point/title "Calculating Time Given Distance and Speed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cab5046-233a-5880-a03b-503b0856d91c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6.5$ minutes" :db/id #edb/ref 17592186266680} {:answer/id #uuid "e325a324-10a4-5f82-b231-fa3bd706ffd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7.5$ minutes" :db/id #edb/ref 17592186268151} {:answer/id #uuid "e83770ff-718f-52f9-990d-ade35dfa8b0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6$ minutes" :db/id #edb/ref 17592186268205} {:answer/id #uuid "e91f6d7c-f724-5d0a-abea-83d4d6399631" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ minutes" :db/id #edb/ref 17592186268215} {:answer/id #uuid "ef6e5bd5-073f-5a36-96f8-f3263a6b14de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7$ minutes" :db/id #edb/ref 17592186268273}] :answer-field/correct {:answer/id #uuid "e83770ff-718f-52f9-990d-ade35dfa8b0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6$ minutes" :db/id #edb/ref 17592186268205} :answer-field/id #uuid "51bb6fb1-a3cf-54cb-9a80-1e8569ed6784" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268553}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "27bf74aa-5d79-5da2-ae74-80f3b8309260" :question/math-academy-id "q-134220" :question/problem "A jet ski traveled $3\\,960$ meters at a constant speed of $660$ meters per minute. For how long was the jet ski in motion?" :question/worked-solution "The speed is $660$ meters per minute. To find the time it took the jet ski to cover $3\\,960$ meters, we divide the distance by $660.$ This gives\n\n$$\n\\begin{aligned}\\text{time} & =\\frac{\\text{distance}}{\\text{speed}} \\\\  & =\\frac{3\\,960}{660} \\\\  & =\\frac{3\\,960÷60}{660÷60} \\\\  & =\\frac{66}{11} \\\\  & =66÷11 \\\\  & =6.\\end{aligned}\n$$\n\nTherefore, the jet ski was in motion for $6$ minutes."}] [{:db/id #edb/ref 17592186268991 :knowledge-point/_questions [{:db/id #edb/ref 17592186175937 :knowledge-point/id #uuid "cee807c1-dd86-5b0e-a595-5c5754c47e4c" :knowledge-point/title "Computing Covariance in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f92a789-d109-50a4-95bb-321fbf167553" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186266275} {:answer/id #uuid "3a4fc0c3-7987-5650-a6c4-15357f0a2e40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186266658} {:answer/id #uuid "81b8fc0f-c491-5c9d-b014-a4dd49ed0618" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186267287} {:answer/id #uuid "8feb198f-42a2-5fd7-a65e-3cb6ba4e1c4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.5" :db/id #edb/ref 17592186267425} {:answer/id #uuid "9f77bdcd-8fd8-5c39-a664-6aabddb6169f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2.5" :db/id #edb/ref 17592186267585}] :answer-field/correct {:answer/id #uuid "0f92a789-d109-50a4-95bb-321fbf167553" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186266275} :answer-field/id #uuid "0a27bb6c-7a78-5c39-ae3a-526cec46f622" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268424}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fd4f8095-844e-57fc-88d9-718d41a408a6" :question/math-academy-id "q-134221" :question/problem "| **Age, in years ($x$)** | $7$ | $9$ | $11$ | $13$ |\n| --- | --- | --- | --- | --- |\n| **Shoe Size (USA) ($y$)** | $7$ | $8$ | $9$ | $8$ |\n\nMr. Damon recorded the age and shoe size of four tennis players at his academy. The table above shows the information he collected. Compute the covariance of the data sets given that the means are $\\overset{―}{x}=10$ and $\\overset{―}{y}=8.$" :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(7-10)(7-8)+(9-10)(8-8)+(11-10)(9-8)+(13-10)(8-8)] \\\\  & =\\frac{1}{4}[(-3)(-1)+(-1)(0)+(1)(1)+(3)(0)] \\\\  & =\\frac{1}{4}[3+0+1+0] \\\\  & =\\frac{1}{4}\\cdot 4 \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268994 :knowledge-point/_questions [{:db/id #edb/ref 17592186176032 :knowledge-point/id #uuid "6570253a-b05a-5721-9108-5fddab2b5388" :knowledge-point/title "Calculating Time Given Distance and Speed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02f258e3-8882-5aeb-8740-3e42cb6e7994" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$40$ seconds" :db/id #edb/ref 17592186266171} {:answer/id #uuid "5d95a249-fc05-50ac-9d04-c408a09025da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$44$ seconds" :db/id #edb/ref 17592186266970} {:answer/id #uuid "60a9d8c4-203b-5e3f-8e27-11c1d3cd6d57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$50$ seconds" :db/id #edb/ref 17592186266996} {:answer/id #uuid "640b8046-055f-5a66-8042-59ab2cf08bbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$52$ seconds" :db/id #edb/ref 17592186267026} {:answer/id #uuid "ab5026ed-6705-5518-8ad4-b09d2651f5d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$38$ seconds" :db/id #edb/ref 17592186267691}] :answer-field/correct {:answer/id #uuid "5d95a249-fc05-50ac-9d04-c408a09025da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$44$ seconds" :db/id #edb/ref 17592186266970} :answer-field/id #uuid "9d55d2b0-ddd8-553b-a7e3-cf16362be09c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268682}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "92c13e99-67cb-5a62-9173-697230856fc4" :question/math-academy-id "q-134241" :question/problem "It takes $35$ seconds for a dolphin to swim $315$ meters at a constant pace. How long does it take for the dolphin to swim $396$ meters?" :question/worked-solution "Speed is a special unit rate applied to moving objects. It is defined as *the distance traveled per unit of time*:\n\n$$\n\\text{speed}=\\frac{\\text{distance}}{\\text{time}}\n$$\n\nTo find the speed, in meters per second, we divide the number of meters, which is $315,$ by the number of seconds, $35.$ This gives,\n\n$$\n\\begin{aligned}\\frac{315}{35} & =\\frac{315÷5}{35÷5} \\\\  & =\\frac{63}{7} \\\\  & =63÷7 \\\\  & =9.\\end{aligned}\n$$\n\nSo, the speed of the dolphin is $9$ meters per second. \n\nTo find the time it takes the dolphin to cover $396$ meters, we divide the distance by $9.$ This gives\n\n$$\n\\begin{aligned}\\text{time} & =\\frac{\\text{distance}}{\\text{speed}} \\\\  & =\\frac{396}{9} \\\\  & =396÷9 \\\\  & =44.\\end{aligned}\n$$\n\nTherefore, it takes the dolphin $44$ seconds to travel $396$ meters."}] [{:db/id #edb/ref 17592186268995 :knowledge-point/_questions [{:db/id #edb/ref 17592186176031 :knowledge-point/id #uuid "534de76f-d4bc-55b5-858e-2b594f63b7bc" :knowledge-point/title "Calculating Distance Given Speed and Time"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40131a28-43ac-50cf-8d52-39f12b620ee7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$90$ centimeters" :db/id #edb/ref 17592186266722} {:answer/id #uuid "886f2ab6-77f8-5a47-b00c-148f635dc0f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$81$ centimeters" :db/id #edb/ref 17592186267351} {:answer/id #uuid "a3488564-1ffd-543a-9e83-a3e4de6a4a55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$72$ centimeters" :db/id #edb/ref 17592186267612} {:answer/id #uuid "a5f5d571-924e-5ad6-9047-abd7a0db08a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$64$ centimeters" :db/id #edb/ref 17592186267647} {:answer/id #uuid "eeb2d178-478e-56b8-97e6-0ffe587c1d6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$15$ centimeters" :db/id #edb/ref 17592186268268}] :answer-field/correct {:answer/id #uuid "886f2ab6-77f8-5a47-b00c-148f635dc0f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$81$ centimeters" :db/id #edb/ref 17592186267351} :answer-field/id #uuid "6f1172ab-eeb3-5cad-a411-b983f6dd952a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268610}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "12110187-5a54-55e6-a927-228b7377faf9" :question/math-academy-id "q-134243" :question/problem "It takes $30$ minutes for a slug to crawl $135$ centimeters when moving at a constant pace. Find the distance this slug covers in $18$ minutes." :question/worked-solution "Speed is a special unit rate applied to moving objects. It is defined as *the distance traveled per unit of time*:\n\n$$\n\\text{speed}=\\frac{\\text{distance}}{\\text{time}}\n$$\n\nTo find the speed in centimeters per minute, we divide the number of centimeters, $135,$ by the number of minutes, $30.$ This gives,\n\n$$\n\\begin{aligned}\\frac{135}{30} & =135÷30 \\\\  & =\\frac{135÷15}{30÷15} \\\\  & =\\frac{9}{2} \\\\  & =9÷2 \\\\  & =4.5.\\end{aligned}\n$$\n\nSo, the speed of the slug is $4.5$ centimeters per minute. \n\nTo find the distance covered in $18$ minutes, we multiply the speed by $18.$ This gives\n\n$$\n\\begin{aligned}\\text{distance} & =\\text{speed}\\times \\text{time} \\\\  & =4.5\\times 18 \\\\  & =81.\\end{aligned}\n$$\n\nTherefore, the slug covers $81$ centimeters in $18$ minutes."}] [{:db/id #edb/ref 17592186395748 :knowledge-point/_questions [{:db/id #edb/ref 17592186100988 :knowledge-point/id #uuid "8d783281-8364-5597-a804-a4ea0d76bec8" :knowledge-point/title "Finding an Entry of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c13c60e5-0749-5b32-b12e-a8ade2bfafa4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No such entry" :db/id #edb/ref 17592186395750} {:answer/id #uuid "934f3147-a632-5a7a-90a4-6abb01c749b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186395751} {:answer/id #uuid "75f10e54-f429-5034-a07c-5f3a477a96f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186395752} {:answer/id #uuid "fc409e78-b2db-5c05-a2e5-b9108d710f88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186395753} {:answer/id #uuid "42e84e66-ce19-5239-8a81-e70ab0d7a064" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186395754}] :answer-field/correct {:answer/id #uuid "42e84e66-ce19-5239-8a81-e70ab0d7a064" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186395754} :answer-field/id #uuid "009a80b9-eba7-5f26-9519-cf720d746fee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395749}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d09f8217-b119-5565-bb4f-2ae4305acd87" :question/math-academy-id "q-13497" :question/problem "Find the entry ${c}_{24}$ of the matrix $C$, where \n\n$$\nC=[\\begin{aligned}0 & 1 & 2 & 4 \\\\ -1 & 2 & -3 & 5 \\\\ 2 & 1 & -3 & 4\\end{aligned}].\n$$" :question/worked-solution "The entry ${c}_{24}$ should lie at the intersection of the $2$nd row and $4$th column. Therefore, ${c}_{24}=5.$\n\n$$\nC=[\\begin{aligned}0 & 1 & 2 & 4 \\\\ -1 & 2 & -3 & 5 \\\\ 2 & 1 & -3 & 4\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186400702 :knowledge-point/_questions [{:db/id #edb/ref 17592186100990 :knowledge-point/id #uuid "1cc70bda-40cf-5860-9a47-25f290c71041" :knowledge-point/title "Describing an Entry of a Matrix in Index Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53bc7c4a-ec03-5241-b616-ab551e2b27cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{21}" :db/id #edb/ref 17592186400704} {:answer/id #uuid "3b70af93-f0df-596a-b13f-d4cefebb16dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{13}" :db/id #edb/ref 17592186400705} {:answer/id #uuid "710c1a23-9554-5a6a-91ac-2f16e51847e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{43}" :db/id #edb/ref 17592186400706} {:answer/id #uuid "64372579-911a-5351-8eec-53ed6b8d3b83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{22}" :db/id #edb/ref 17592186400707} {:answer/id #uuid "437a5fab-d07b-5f08-b95c-d799c5a714f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{34}" :db/id #edb/ref 17592186400708}] :answer-field/correct {:answer/id #uuid "437a5fab-d07b-5f08-b95c-d799c5a714f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{34}" :db/id #edb/ref 17592186400708} :answer-field/id #uuid "d6c4d5fd-03ba-51d6-8190-92d4e4a4e499" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400703}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "76f61515-4e83-5716-8dff-d44543d61f70" :question/math-academy-id "q-13499" :question/problem "Consider the highlighted entry of the matrix $A$ given below. Describe it in terms of ${a}_{ij}.$\n\n$$\nA=[\\begin{aligned}3 & 5 & 10 & 6 \\\\ 6 & 14 & 8 & 1 \\\\ 9 & 17 & 9 & 0\\end{aligned}]\n$$" :question/worked-solution "The entry lies at the intersection of the $3$rd row and $4$th column. Hence, we have ${a}_{34}=0.$"}] [{:db/id #edb/ref 17592186269011 :knowledge-point/_questions [{:db/id #edb/ref 17592186083383 :knowledge-point/id #uuid "f4f0aabf-5329-59e7-a5e8-6db979b8699c" :knowledge-point/title "Solving for Displacement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f8655ef-1398-5af2-950d-86e2d66b9f02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49.5\\,\\text{m}" :db/id #edb/ref 17592186266273} {:answer/id #uuid "21589f7f-d65d-5b07-8c4d-7a58858d8aeb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "205.5\\,\\text{m}" :db/id #edb/ref 17592186266441} {:answer/id #uuid "55250c42-2129-5ad8-a825-45e36c162fb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "74.0\\,\\text{m}" :db/id #edb/ref 17592186266906} {:answer/id #uuid "c1732452-ba86-5b66-9d0f-8ecb8ef36ef6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "147.5\\,\\text{m}" :db/id #edb/ref 17592186267870} {:answer/id #uuid "dad302c2-78ab-5cef-8a01-c1ccfe0f5687" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "270.0\\,\\text{m}" :db/id #edb/ref 17592186268082}] :answer-field/correct {:answer/id #uuid "c1732452-ba86-5b66-9d0f-8ecb8ef36ef6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "147.5\\,\\text{m}" :db/id #edb/ref 17592186267870} :answer-field/id #uuid "cc78480b-f21a-58e1-ae11-97412bfc6d2e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268773}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3e15d21c-4fa7-50e9-9890-e404c2c7a6c8" :question/math-academy-id "q-135099" :question/problem "A marble is projected vertically downward from a building with a velocity of $0.3\\,\\text{km/min}.$  It takes the marble $5\\,\\text{s}$ to hit the ground. What is the height of the building? \n\n*Hint: The acceleration due to gravity is $9.8\\,{\\text{m/s}}^{2}.$*" :question/worked-solution "To solve this problem, we use the formula\n\n$$\ns=ut+\\frac{1}{2}g{t}^{2},\n$$\n\nwhere $s$ is the displacement, measured from the starting position in the direction of the initial motion, $u$ is the initial velocity, $t$ is the time since the beginning of the motion, and $g$ is the acceleration due to gravity.\n\nLet's summarize the information we have:\n\n- We can find the initial velocity of the marble in meters per second as follows:\n\n$$\n\\begin{aligned}u & =0.3\\,\\frac{\\text{km}}{\\text{min}} \\\\  & =0.3\\,\\frac{\\text{km}}{\\text{min}}\\cdot \\frac{1\\,000\\,\\text{m}}{\\text{km}}\\cdot \\frac{\\text{min}}{60\\,\\text{s}} \\\\  & =0.3\\,\\frac{\\cancel{\\text{km}}}{\\cancel{\\text{min}}}\\cdot \\frac{1\\,000\\,\\text{m}}{\\cancel{\\text{km}}}\\cdot \\frac{\\cancel{\\text{min}}}{60\\,\\text{s}} \\\\  & =0.3\\cdot \\frac{1000\\,\\text{m}}{60\\,\\text{s}} \\\\  & =5\\,\\text{m/s}\\end{aligned}\n$$\n\n- The marble falls for $t=5\\,\\text{s}.$\n\n- The acceleration due to gravity is $g=9.8\\,{\\text{m/s}}^{2}.$\n\nSubstituting these values into the formula, we obtain the following:\n\n$$\n\\begin{aligned}s & =ut+\\frac{1}{2}g{t}^{2} \\\\  & =(5)(5)+\\frac{1}{2}\\cdot (9.8)(5)^{2} \\\\  & =25+(4.9)(25) \\\\  & =147.5\\end{aligned}\n$$\n\nTherefore, the building is $147.5\\,\\text{m}$ high."}] [{:db/id #edb/ref 17592186398389 :knowledge-point/_questions [{:db/id #edb/ref 17592186083384 :knowledge-point/id #uuid "6c3fb8a8-343a-5046-afce-83db17ec1039" :knowledge-point/title "Solving for Initial Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c5bb798-cec3-5a92-9d75-11208ba367e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "61.2\\,\\text{m/s}" :db/id #edb/ref 17592186398391} {:answer/id #uuid "4d938cd5-a02b-597a-b438-1708be6fb7f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80.2\\,\\text{m/s}" :db/id #edb/ref 17592186398392} {:answer/id #uuid "577131db-9008-56b9-a467-51c63bcf9b9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "67\\,\\text{m/s}" :db/id #edb/ref 17592186398393} {:answer/id #uuid "af98f4ef-a70e-5c69-9cbd-4bc71919c6e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "75.1\\,\\text{m/s}" :db/id #edb/ref 17592186398394} {:answer/id #uuid "ea7e78d9-3274-5840-9bbb-71ef4bb5921d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70.6\\,\\text{m/s}" :db/id #edb/ref 17592186398395}] :answer-field/correct {:answer/id #uuid "ea7e78d9-3274-5840-9bbb-71ef4bb5921d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70.6\\,\\text{m/s}" :db/id #edb/ref 17592186398395} :answer-field/id #uuid "f3a5589d-c173-52b7-aa4e-ec8dcdd731a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398390}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "04947b95-8a1f-567f-948f-2de5de86130e" :question/math-academy-id "q-135105" :question/problem "An object is projected vertically down from a height of $0.6\\,\\text{km}$ and hits the ground in $6\\,\\text{s}.$ What was the initial velocity of the object?\n\n*Hint: The acceleration due to gravity is $9.8\\,{\\text{m/s}}^{2}.$*" :question/worked-solution "To solve this problem, we use the formula\n\n$$\ns=ut+\\frac{1}{2}g{t}^{2},\n$$\n\nwhere $s$ is the displacement, measured from the starting position in the direction of the initial motion, $u$ is the initial velocity, $t$ is the time since the beginning of the motion, and $g$ is the acceleration due to gravity.\n\nLet's summarize the information we have:\n\n- The object falls for $t=6\\,\\text{s}.$\n\n- We can find the distance the object falls in meters as follows:\n\n$$\n\\begin{aligned}s & =0.6\\,\\text{km} \\\\  & =0.6\\,\\text{km}\\cdot \\frac{1\\,000\\,\\text{m}}{\\text{km}} \\\\  & =0.6\\,\\cancel{\\text{km}}\\cdot \\frac{1\\,000\\,\\text{m}}{\\cancel{\\text{km}}} \\\\  & =0.6\\cdot 1\\,000\\,\\text{m} \\\\  & =600\\,\\text{m}\\end{aligned}\n$$\n\n- The acceleration due to gravity is $g=9.8\\,{\\text{m/s}}^{2}.$\n\nSubstituting these values into the formula and solving for $u,$ we obtain the following:\n\n$$\n\\begin{aligned}s & =ut+\\frac{1}{2}g{t}^{2} \\\\ (600) & =u(6)+\\frac{1}{2}(9.8)(6)^{2} \\\\ 600 & =6u+176.4 \\\\ 423.6 & =6u \\\\ u & =70.6\\end{aligned}\n$$\n\nTherefore, the initial velocity of the object was $u=70.6\\,\\text{m/s}.$"}] [{:db/id #edb/ref 17592186269013 :knowledge-point/_questions [{:db/id #edb/ref 17592186083384 :knowledge-point/id #uuid "6c3fb8a8-343a-5046-afce-83db17ec1039" :knowledge-point/title "Solving for Initial Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "65978ce6-df64-5de6-aeab-42de7c34421a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.4\\,\\text{m/s}" :db/id #edb/ref 17592186267045} {:answer/id #uuid "90f37520-bdc0-5101-8fa8-e439c6fa8a96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.2\\,\\text{m/s}" :db/id #edb/ref 17592186267434} {:answer/id #uuid "ac8cdabb-612d-5de7-9682-d99f1ee7ee7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.1\\,\\text{m/s}" :db/id #edb/ref 17592186267700} {:answer/id #uuid "b5fca792-de9a-5fdb-86b8-014ceb5d535a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.2\\,\\text{m/s}" :db/id #edb/ref 17592186267769} {:answer/id #uuid "c5aa12e3-0532-503a-a1f6-9c28ecc980d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7.6\\,\\text{m/s}" :db/id #edb/ref 17592186267916}] :answer-field/correct {:answer/id #uuid "b5fca792-de9a-5fdb-86b8-014ceb5d535a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.2\\,\\text{m/s}" :db/id #edb/ref 17592186267769} :answer-field/id #uuid "176f199d-1d63-5478-9d6f-26b21b3cd994" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268443}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "59f994d9-de97-52de-9c5c-2b1ac143f4bb" :question/math-academy-id "q-135223" :question/problem "A coin is projected vertically down from a skyscraper with a height of $720\\,\\text{m}.$ It takes $12\\,\\text{s}$ to hit the ground. What was the initial velocity of the coin?\n\n*Hint: The acceleration due to gravity is $9.8\\,{\\text{m/s}}^{2}.$*" :question/worked-solution "To solve this problem, we use the formula\n\n$$\ns=ut+\\frac{1}{2}g{t}^{2},\n$$\n\nwhere $s$ is the displacement, measured from the starting position in the direction of the initial motion, $u$ is the initial velocity, $t$ is the time since the beginning of the motion, and $g$ is the acceleration due to gravity.\n\nLet's summarize the information we have:\n\n- The coin falls for $t=12\\,\\text{s}.$\n\n- The coin covers the distance of $s=720\\,\\text{m}.$\n\n- The acceleration due to gravity is $g=9.8\\,{\\text{m/s}}^{2}.$\n\nSubstituting these values into the formula and solving for $u,$ we obtain the following:\n\n$$\n\\begin{aligned}s & =ut+\\frac{1}{2}g{t}^{2} \\\\ (720) & =u(12)+\\frac{1}{2}(9.8)(12)^{2} \\\\ 720 & =12u+705.6 \\\\ 14.4 & =12u \\\\ u & =1.2\\end{aligned}\n$$\n\nTherefore, the initial velocity of the coin was $1.2\\,\\text{m/s}.$"}] [{:db/id #edb/ref 17592186400709 :knowledge-point/_questions [{:db/id #edb/ref 17592186083385 :knowledge-point/id #uuid "d441155e-dbcb-598d-afc7-949ee4eddbee" :knowledge-point/title "Solving for Time"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c8857b7-5f5d-5457-8dd6-2b4309d575d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\text{s}" :db/id #edb/ref 17592186400711} {:answer/id #uuid "c0f420ae-7985-53ba-8421-2ceb6b4b4f17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,\\text{s}" :db/id #edb/ref 17592186400712} {:answer/id #uuid "57bed31e-8ef7-54da-8f39-982e238c1dd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\text{s}" :db/id #edb/ref 17592186400713} {:answer/id #uuid "5fdee401-1c5c-5788-8574-ed2dd56862ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,\\text{s}" :db/id #edb/ref 17592186400714} {:answer/id #uuid "75082212-5bbc-5f18-98d7-7d1fb55b442b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\,\\text{s}" :db/id #edb/ref 17592186400715}] :answer-field/correct {:answer/id #uuid "57bed31e-8ef7-54da-8f39-982e238c1dd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\text{s}" :db/id #edb/ref 17592186400713} :answer-field/id #uuid "106db307-f502-5d2c-ad7c-d17a4f3844ab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400710}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "183a141f-bd68-52b7-ae90-0aa68787bc11" :question/math-academy-id "q-135228" :question/problem "A marble is projected vertically downward from a height of $245\\,\\text{m}$ with an initial velocity of $24.5\\,\\text{m/s}.$ How long will it take for the marble to hit the ground? \n\n*Hint: The acceleration due to gravity is $9.8\\,{\\text{m/s}}^{2}.$*" :question/worked-solution "To solve this problem, we use the formula\n\n$$\ns=ut+\\frac{1}{2}g{t}^{2},\n$$\n\nwhere $s$ is the displacement, measured from the starting position in the direction of the initial motion, $u$ is the initial velocity, $t$ is the time since the beginning of the motion, and $g$ is the acceleration due to gravity.\n\nLet's summarize the information we have:\n\n- The initial velocity of the marble is $u=24.5\\,\\text{m/s}.$\n\n- The marble covers the distance of $s=245\\,\\text{m}.$\n\n- The acceleration due to gravity is $g=9.8\\,{\\text{m/s}}^{2}.$\n\nSubstituting these values into the formula and solving for $t,$ we obtain the following:\n\n$$\n\\begin{aligned}s & =ut+\\frac{1}{2}g{t}^{2} \\\\ 245 & =(24.5)t+\\frac{1}{2}(9.8){t}^{2} \\\\ 245 & =24.5t+4.9{t}^{2} \\\\ 50(4.9) & =5(4.9)t+4.9{t}^{2} \\\\ 50\\cancel{(4.9)} & =5\\cancel{(4.9)}t+\\cancel{(4.9)}{t}^{2} \\\\ 50 & =5t+{t}^{2} \\\\ {t}^{2}+5t-50 & =0 \\\\ (t+10)(t-5) & =0 \\\\ t & =-10,\\,5\\end{aligned}\n$$\n\nWe disregard the negative solution. Therefore, the marble hits the ground after $t=5$ seconds."}] [{:db/id #edb/ref 17592186269033 :knowledge-point/_questions [{:db/id #edb/ref 17592186068917 :knowledge-point/id #uuid "d359337c-4ec2-5100-bdac-d0858619db3b" :knowledge-point/title "Integrating Products Containing Trigonometric Functions Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bba42d0-4d22-55d1-bf2a-5afa7f154545" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186266532} {:answer/id #uuid "6f0dba1e-ebd9-58df-9ff0-a39f534c6156" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186267118} {:answer/id #uuid "9a78f2b9-be60-5dd9-a1b2-d3dae91c37e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186267540} {:answer/id #uuid "a54496d0-737c-5f0e-b323-1106d3723e9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186267634} {:answer/id #uuid "da3d8464-42f7-59e9-bbc9-ba3a5c255583" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186268077}] :answer-field/correct {:answer/id #uuid "2bba42d0-4d22-55d1-bf2a-5afa7f154545" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186266532} :answer-field/id #uuid "464dd787-aac1-5fd3-8b68-a426f70499c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268525}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5d3c5f6c-be88-5a7d-88c2-f5f9124aa97d" :question/math-academy-id "q-13533" :question/problem "${\\int }_{0}^{\\sqrt{\\pi /2}}5x\\operatorname{cos}⁡(2{x}^{2})\\,\\text{d}x=$" :question/worked-solution "Let $u=2{x}^{2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4x\\,⟹\\,\\frac{1}{4}\\text{d}u=x\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $0$ | $\\sqrt{\\pi /2}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\pi $ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\pi /2}}5x\\operatorname{cos}⁡(2{x}^{2})\\,\\text{d}x & ={\\int }_{0}^{\\sqrt{\\pi /2}}5\\operatorname{cos}⁡(2{x}^{2})\\cdot x\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi }5\\operatorname{cos}⁡u\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & =\\frac{5}{4}{\\int }_{0}^{\\pi }\\operatorname{cos}⁡u\\,\\text{d}u \\\\  & =\\frac{5}{4}\\operatorname{sin}⁡u{|}_{0}^{\\pi } \\\\  & =\\frac{5}{4}(\\operatorname{sin}⁡(\\pi )-\\operatorname{sin}⁡(0)) \\\\  & =\\frac{5}{4}(0) \\\\  & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186101131 :knowledge-point/_questions [{:db/id #edb/ref 17592186100992 :knowledge-point/id #uuid "16e62b0e-adda-5d35-aeb9-961057dce8f0" :knowledge-point/title "Calculating the Sum or Difference of Three or More Matrices Using Distributivity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9d0d5b8b-4428-5073-8c81-ebd4d03f5e11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 2 \\\\ 2 & 3\\end{bmatrix}" :db/id #edb/ref 17592186098122} {:answer/id #uuid "04d70404-4b26-53f0-9c5c-5e44fe5b9647" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 7 \\\\ 4 & 5\\end{bmatrix}" :db/id #edb/ref 17592186098123} {:answer/id #uuid "39e8426c-e203-5fdf-a93f-111238c8159f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186098124} {:answer/id #uuid "71f20d62-7872-5e37-97e9-a23e08aef59f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 7 \\\\ 7 & 5\\end{bmatrix}" :db/id #edb/ref 17592186098125} {:answer/id #uuid "75cc67b5-2545-59dc-9edf-f9e64c9bb09e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 1 \\\\ 6 & 8\\end{bmatrix}" :db/id #edb/ref 17592186098126}] :answer-field/id #uuid "11b67b69-785c-5ae0-bd01-ea693dbbfc6c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186098121} {:answer-field/choices [{:answer/id #uuid "8f88e9a5-8759-5e71-b262-00b079bef50f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186388343} {:answer/id #uuid "f2609425-f61f-5689-a1b2-ad1766ba4f2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 1 \\\\ 6 & 8\\end{aligned}]" :db/id #edb/ref 17592186388344} {:answer/id #uuid "065fbb44-49f9-5677-ae45-0db8eae4e9ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 7 \\\\ 7 & 5\\end{aligned}]" :db/id #edb/ref 17592186388345} {:answer/id #uuid "6d7d6d9c-e6a7-5790-92dd-e8b2bca71761" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & 7 \\\\ 4 & 5\\end{aligned}]" :db/id #edb/ref 17592186388346} {:answer/id #uuid "b7fb0aa4-9a2d-5c94-a1be-3f68d1da0be1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 2 \\\\ 2 & 3\\end{aligned}]" :db/id #edb/ref 17592186388347}] :answer-field/correct {:answer/id #uuid "6d7d6d9c-e6a7-5790-92dd-e8b2bca71761" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & 7 \\\\ 4 & 5\\end{aligned}]" :db/id #edb/ref 17592186388346} :answer-field/id #uuid "aefbe9b4-2591-5f99-bd99-dce5ef9f6719" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388342}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "60ff0898-484c-5468-ab70-2a2b8951960b" :question/math-academy-id "q-13536" :question/problem "Find $(A+B)-C-(B-C)$, if\n\n$$\nA=[\\begin{aligned}6 & 7 \\\\ 4 & 5\\end{aligned}],\\,B=[\\begin{aligned}3 & 2 \\\\ 2 & 3\\end{aligned}],\\,C=[\\begin{aligned}5 & 1 \\\\ 6 & 8\\end{aligned}].\n$$" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses:\n\n$$\n\\begin{aligned}(A+B)-C-(B-C) & =A+B-C-B+C \\\\  & =A+\\cancel{B}-\\cancel{C}-\\cancel{B}+\\cancel{C} \\\\  & =A\\end{aligned}\n$$\n\nWe are left with a single matrix. So, the result is \n\n$$\n\\begin{aligned}A & =[\\begin{aligned}6 & 7 \\\\ 4 & 5\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186388403 :knowledge-point/_questions [{:db/id #edb/ref 17592186100868 :knowledge-point/id #uuid "8451e22a-247e-51dd-8fb1-9ce9b212dc65" :knowledge-point/title "Multiplying a Matrix With Variable Entries by a Column Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6dac886f-ec90-5d08-838c-5a59cf7394ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-7b \\\\ -7c\\end{aligned}]" :db/id #edb/ref 17592186388405} {:answer/id #uuid "5a12801a-3fc5-59fe-a868-0dd7454f9d59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7c \\\\ 7c\\end{aligned}]" :db/id #edb/ref 17592186388406} {:answer/id #uuid "9c65430b-d3c0-5549-805e-9c2f4dc62591" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7b \\\\ 7c\\end{aligned}]" :db/id #edb/ref 17592186388407} {:answer/id #uuid "2ca00378-b5c5-5906-96a7-630208843a2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7b \\\\ 7b\\end{aligned}]" :db/id #edb/ref 17592186388408} {:answer/id #uuid "b66bb36e-56a0-54a6-bcba-44591ba41152" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7c \\\\ 7b\\end{aligned}]" :db/id #edb/ref 17592186388409}] :answer-field/correct {:answer/id #uuid "9c65430b-d3c0-5549-805e-9c2f4dc62591" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7b \\\\ 7c\\end{aligned}]" :db/id #edb/ref 17592186388407} :answer-field/id #uuid "00031ac6-c3f2-5a96-85f9-1258053acaf3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388404}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "89271958-955e-55b3-a956-b8c8b5250728" :question/math-academy-id "q-13556" :question/problem "Find $By$  if \n$B=[\\begin{aligned}b & b \\\\ c & c\\end{aligned}]$\nand\n$y=[\\begin{aligned}3 \\\\ 4\\end{aligned}].$" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product: \n\n$$\n\\begin{aligned}By & =[\\begin{aligned}b & b \\\\ c & c\\end{aligned}][\\begin{aligned}3 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}b\\cdot 3+b\\cdot 4 \\\\ c\\cdot 3+c\\cdot 4\\end{aligned}] \\\\  & =[\\begin{aligned}3b+4b \\\\ 3c+4c\\end{aligned}] \\\\  & =[\\begin{aligned}7b \\\\ 7c\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186101136 :knowledge-point/_questions [{:db/id #edb/ref 17592186100866 :knowledge-point/id #uuid "ff414112-3be2-5b9c-9ded-5025ea05c2b4" :knowledge-point/title "Multiplying a 2x2 Matrix by a Column Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91719962-a9c9-5473-af93-ea01ef1b4602" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186098152} {:answer/id #uuid "efdc264d-beb8-5142-9bc0-cfe6ee14fd5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186098153} {:answer/id #uuid "300c52bd-1c58-5163-a5c0-19ae05be86e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186098154} {:answer/id #uuid "3a610c49-d9ef-5021-9d2e-f11037ff20cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186098155} {:answer/id #uuid "7eb70040-131f-5161-adab-840651894fb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186098156}] :answer-field/id #uuid "da02eab7-5575-5dba-bf83-14a67bd5b414" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186098151} {:answer-field/choices [{:answer/id #uuid "5ce47e15-8a71-5a0e-877b-8161ee17ff71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186388418} {:answer/id #uuid "84d4840e-ffea-5fc0-bd15-47e2b8b3ee8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186388419} {:answer/id #uuid "a052459a-e452-5bfb-9115-9b9d15dcfb91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186388420} {:answer/id #uuid "b4829af7-c55a-5072-9da4-2384966bfee9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186388421} {:answer/id #uuid "f605914a-ff93-5823-885b-2509f3adee21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186388422}] :answer-field/correct {:answer/id #uuid "f605914a-ff93-5823-885b-2509f3adee21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186388422} :answer-field/id #uuid "ef949d1a-3425-5215-bdb0-047bedfe1e0b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388417}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c6f60840-c1ce-5025-8b9b-ed8f00fe0d5e" :question/math-academy-id "q-13564" :question/problem "Find $Ax$ if \n$A=[\\begin{aligned}-6 & 4 \\\\ 8 & -5\\end{aligned}]$\nand\n$x=[\\begin{aligned}2 \\\\ 4\\end{aligned}].$" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product. Multiplying the first row, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}-6 & 4 \\\\ 8 & -5\\end{aligned}][\\begin{aligned}2 \\\\ 4\\end{aligned}] & =[\\begin{aligned}(-6)\\cdot 2+4\\cdot 4 \\\\ ∗\\end{aligned}]=[\\begin{aligned}4 \\\\ ∗\\end{aligned}].\\end{aligned}\n$$\n\nMultiplying the second row, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}-6 & 4 \\\\ 8 & -5\\end{aligned}][\\begin{aligned}2 \\\\ 4\\end{aligned}] & =[\\begin{aligned}4 \\\\ 8\\cdot 2+(-5)\\cdot 4\\end{aligned}]=[\\begin{aligned}4 \\\\ -4\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, \n$Ax=[\\begin{aligned}4 \\\\ -4\\end{aligned}].$"}] [{:db/id #edb/ref 17592186101139 :knowledge-point/_questions [{:db/id #edb/ref 17592186100954 :knowledge-point/id #uuid "29896622-4bcb-5ad2-91d0-47c5911a619e" :knowledge-point/title "Finding the First Few Terms of an Expansion With Negative Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0284f84c-f34c-5607-8e55-7544c6b2c95b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "256-128x-64{x}^{2}+⋯" :db/id #edb/ref 17592186266164} {:answer/id #uuid "12e978b7-4b66-5dc5-8101-2e3babbf88dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "256-256x+256{x}^{2}+⋯" :db/id #edb/ref 17592186266309} {:answer/id #uuid "48326ff2-e13b-56f8-a28e-cfa0ae75b1f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "256-96x+96{x}^{2}+⋯" :db/id #edb/ref 17592186266790} {:answer/id #uuid "8526b00b-6806-517b-88da-86e8036d8c54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "256-256x+96{x}^{2}+⋯" :db/id #edb/ref 17592186267316} {:answer/id #uuid "89bcf6d0-feb7-5baa-ae47-4747d7dd88c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "256-64x+32{x}^{2}+⋯" :db/id #edb/ref 17592186267369}] :answer-field/correct {:answer/id #uuid "8526b00b-6806-517b-88da-86e8036d8c54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "256-256x+96{x}^{2}+⋯" :db/id #edb/ref 17592186267316} :answer-field/id #uuid "009d2dab-65c9-551e-b36d-afa61dd97fff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268401}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1580f8d4-9b2d-526c-a1a3-3117f94565e4" :question/math-academy-id "q-135896" :question/problem "$(4-x)^{4}=$" :question/worked-solution "The binomial theorem states that for any positive integer $n,$ we have\n\n \n\n$$\n(a+b)^{n}=(\\frac{n}{0}){a}^{n}{b}^{0}+(\\frac{n}{1}){a}^{n-1}{b}^{1}+(\\frac{n}{2}){a}^{n-2}{b}^{2}+⋯+(\\frac{n}{n}){a}^{0}{b}^{n}.\n$$\n\nIn the case of $(4-x)^{4},$ we have  $a=4,$ $b=-x,$ $n=4.$ \n\nTherefore, the first three terms of $(4-x)^{4}$ are as follows:\n\n$$\n\\begin{aligned}{(4-x)}^{4} & =(\\frac{4}{0}){(4)}^{4}{(-x)}^{0}+(\\frac{4}{1}){(4)}^{4-1}{(-x)}^{1}+(\\frac{4}{2}){(4)}^{4-2}{(-x)}^{2}+… \\\\  & =1{(4)}^{4}+4{(4)}^{3}{(-x)}^{1}+6{(4)}^{2}{(-x)}^{2}+… \\\\  & =256-256x+96{x}^{2}+⋯\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186269091 :knowledge-point/_questions [{:db/id #edb/ref 17592186184325 :knowledge-point/id #uuid "9f3ba60a-8c09-563f-ae02-8183bb55e359" :knowledge-point/title "Expanding a Binomial With Negative Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0806406c-4a21-56ec-9a7b-330100d5f875" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{14k}{3}+\\frac{29{k}^{2}}{3}+⋯" :db/id #edb/ref 17592186266215} {:answer/id #uuid "2dcae794-1e06-5fd9-8d66-06082a38384f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{14k}{3}+9{k}^{2}+⋯" :db/id #edb/ref 17592186266549} {:answer/id #uuid "8e55eb77-3bf2-5874-b05d-8ab2dc5703ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{14k}{3}+30{k}^{2}+⋯" :db/id #edb/ref 17592186267411} {:answer/id #uuid "9b259559-d03d-524f-8b06-c704737b069c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{14k}{3}+\\frac{28{k}^{2}}{3}+⋯" :db/id #edb/ref 17592186267544} {:answer/id #uuid "c2546cf8-923a-5e94-8518-b15ebe81c057" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{14k}{3}+\\frac{25{k}^{2}}{3}+⋯" :db/id #edb/ref 17592186267876}] :answer-field/correct {:answer/id #uuid "9b259559-d03d-524f-8b06-c704737b069c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{14k}{3}+\\frac{28{k}^{2}}{3}+⋯" :db/id #edb/ref 17592186267544} :answer-field/id #uuid "9a9e356d-28ac-5e01-9dcb-b6af995d2e23" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268679}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1e2921e3-3663-532f-adb3-94884fb8e499" :question/math-academy-id "q-135995" :question/problem "${(1-\\frac{2k}{3})}^{7}=$" :question/worked-solution "The first three terms of the binomial expansion for $(1+x)^{n}$ are given by\n\n$$\n{(1+x)}^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nBy substituting $x=-\\frac{2k}{3}$ and $n=7$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1-\\frac{2k}{3})}^{7} & =1+7\\cdot (-\\frac{2k}{3})+\\frac{7(7-1)}{2!}\\cdot {(-\\frac{2k}{3})}^{2}+⋯ \\\\  & =1-\\frac{14k}{3}+\\frac{7\\cdot 6}{2}\\cdot \\frac{4{k}^{2}}{9}+⋯ \\\\  & =1-\\frac{14k}{3}+21\\cdot \\frac{4{k}^{2}}{9}+⋯ \\\\  & =1-\\frac{14k}{3}+\\frac{28{k}^{2}}{3}+⋯.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186269092 :knowledge-point/_questions [{:db/id #edb/ref 17592186184325 :knowledge-point/id #uuid "9f3ba60a-8c09-563f-ae02-8183bb55e359" :knowledge-point/title "Expanding a Binomial With Negative Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "716dbd7f-7de8-51f4-b87e-f79504dc016a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+15c+125{c}^{2}+⋯" :db/id #edb/ref 17592186267140} {:answer/id #uuid "b3d47936-3bb8-5dc3-a618-b3411e1ad9bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-15c+\\frac{375{c}^{2}}{4}+⋯" :db/id #edb/ref 17592186267749} {:answer/id #uuid "d03dcef0-d300-5ad5-949f-0b9ca5f0ba63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-15c+\\frac{475{c}^{2}}{2}+⋯" :db/id #edb/ref 17592186268007} {:answer/id #uuid "d455a471-f3ed-5dbf-9faa-02b04821afb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-15c+\\frac{365{c}^{2}}{4}+⋯" :db/id #edb/ref 17592186268039} {:answer/id #uuid "f5a74e83-e891-5e21-a171-e3a88f7f511f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+15c+\\frac{375{c}^{2}}{2}+⋯" :db/id #edb/ref 17592186268321}] :answer-field/correct {:answer/id #uuid "b3d47936-3bb8-5dc3-a618-b3411e1ad9bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-15c+\\frac{375{c}^{2}}{4}+⋯" :db/id #edb/ref 17592186267749} :answer-field/id #uuid "bf9615e1-ed11-5f87-ab84-7b75bb90a532" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268748}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "826c8bb8-d166-5c58-b07f-9be615cefc9a" :question/math-academy-id "q-135997" :question/problem "${(1-\\frac{5c}{2})}^{6}=$" :question/worked-solution "The first three terms of the binomial expansion for $(1+x)^{n}$ are given by\n\n$$\n{(1+x)}^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nBy substituting $x=-\\frac{5c}{2}$ and $n=6$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1-\\frac{5c}{2})}^{6} & =1+6\\cdot (-\\frac{5c}{2})+\\frac{6(6-1)}{2!}\\cdot {(-\\frac{5c}{2})}^{2}+⋯ \\\\  & =1-15c+\\frac{6\\cdot 5}{2}\\cdot \\frac{25{c}^{2}}{4}+⋯ \\\\  & =1-15c+15\\cdot \\frac{25{c}^{2}}{4}+⋯ \\\\  & =1-15c+\\frac{375{c}^{2}}{4}+⋯.\\end{aligned}\n$$"}]}
