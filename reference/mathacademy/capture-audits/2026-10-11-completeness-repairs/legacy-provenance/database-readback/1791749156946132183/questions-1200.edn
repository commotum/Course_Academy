#{[{:db/id #edb/ref 17592186302313 :knowledge-point/_questions [{:db/id #edb/ref 17592186119940 :knowledge-point/id #uuid "0305491f-5ac7-5ba4-9a80-1a9a79b964f0" :knowledge-point/title "Calculating dy/dx at a Point Using dx/dy"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cef3621-5613-513a-9ad2-ffc03e43c43c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "43" :db/id #edb/ref 17592186300002} {:answer/id #uuid "5bfd641e-3cf0-5617-9544-a0f533f5a594" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{29}" :db/id #edb/ref 17592186300436} {:answer/id #uuid "985e6095-ccee-5477-87cb-a76744f1ba5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{83}" :db/id #edb/ref 17592186300727} {:answer/id #uuid "ed6f600f-2b91-50be-b4b5-c60afa2e0489" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "83" :db/id #edb/ref 17592186301135} {:answer/id #uuid "faa1af03-8de5-5be0-9ed5-7a51ee805bbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{43}" :db/id #edb/ref 17592186301201}] :answer-field/correct {:answer/id #uuid "985e6095-ccee-5477-87cb-a76744f1ba5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{83}" :db/id #edb/ref 17592186300727} :answer-field/id #uuid "83bae099-06f3-570f-b2ec-8dfaf4c3aae4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301643}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8588e3b0-fa4a-5436-801f-7b47fb73e332" :question/math-academy-id "q-32706" :question/problem "If $x={y}^{5}+3y-5,$ find $\\frac{\\text{d}y}{\\text{d}x}$ at the point $(33,2).$" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}({y}^{5}+3y-5) \\\\  & =\\frac{\\text{d}}{\\text{d}y}({y}^{5})+3\\frac{\\text{d}}{\\text{d}y}(y)-5\\frac{\\text{d}}{\\text{d}y}(1) \\\\  & =5{y}^{4}+3(1)+0 \\\\  & =5{y}^{4}+3.\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{1}{5{y}^{4}+3}.\n$$\n\nFinally, substituting the point $(33,2),$ we find\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(33,2)} & =\\frac{1}{5\\cdot {2}^{4}+3}=\\frac{1}{83}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186101380 :knowledge-point/_questions [{:db/id #edb/ref 17592186101023 :knowledge-point/id #uuid "41bedcde-cbc1-5634-8846-eb58ffda32e2" :knowledge-point/title "Finding an Interval Given the Average Value of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7279328c-5005-5738-b635-464f69e0beb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186303152} {:answer/id #uuid "93b654ad-f996-520f-a174-860a20c80da1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186303373} {:answer/id #uuid "d6161692-a75b-599c-a518-fe8235c34eef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186303784} {:answer/id #uuid "d65358e5-c70b-5790-904f-f95c66f85282" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186303789} {:answer/id #uuid "f184b873-352a-5c0e-8935-8582c50d6ad5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186303968}] :answer-field/correct {:answer/id #uuid "f184b873-352a-5c0e-8935-8582c50d6ad5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186303968} :answer-field/id #uuid "e0a06460-1a11-59ee-86bb-125fd2dc2d57" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304686}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7eacf291-9083-5337-9223-5109e18f5b01" :question/math-academy-id "q-3293" :question/problem "Find the number $c>0$ such that the average value of $f(x)=9+8x-3{x}^{2}$ on the interval $[0,c]$ is equal to $-3.$" :question/worked-solution "To solve for $c,$ we apply the average value formula:\n\n$$\n\\begin{aligned}{f}_{\\text{avg}} & =\\frac{1}{b-a}\\,{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\ -3 & =\\frac{1}{c-0}\\,{\\int }_{0}^{c}(9+8x-3{x}^{2})\\,\\text{d}x \\\\ -3 & =\\frac{1}{c}(9x+4{x}^{2}-{x}^{3}){|}_{0}^{c} \\\\ -3 & =\\frac{1}{c}[(9c+4{c}^{2}-{c}^{3})-(0)] \\\\ -3 & =9+4c-{c}^{2} \\\\ {c}^{2}-4c-12 & =0 \\\\ (c+2)(c-6) & =0 \\\\ c & =-2,\\,6\\end{aligned}\n$$\n\nNow, since $c>0,$ we conclude that $c=6$ only."}] [{:db/id #edb/ref 17592186304802 :knowledge-point/_questions [{:db/id #edb/ref 17592186119978 :knowledge-point/id #uuid "8c0b7d95-c699-5762-aa44-449712f035c7" :knowledge-point/title "Calculating the Derivative of the Inverse of a Polynomial Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ad77982-9d97-5298-9445-aa2f29bc75ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({g}^{-1}(x))^{2}+12" :db/id #edb/ref 17592186302529} {:answer/id #uuid "3d2f1231-6fab-51a9-b30c-1f9c29aba694" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12({g}^{-1}(x))^{2}+2}" :db/id #edb/ref 17592186302837} {:answer/id #uuid "89a7c6b9-61e0-5fa5-b9cf-bcfa192e6661" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{12({g}^{-1}(x))^{2}+1}" :db/id #edb/ref 17592186303314} {:answer/id #uuid "97905197-8f84-5b48-bca4-efd82fb4afb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{({g}^{-1}(x))^{2}+2}" :db/id #edb/ref 17592186303397} {:answer/id #uuid "eba8ac9e-26d2-5904-bec3-e057833f71f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12({g}^{-1}(x))^{2}+2" :db/id #edb/ref 17592186303931}] :answer-field/correct {:answer/id #uuid "3d2f1231-6fab-51a9-b30c-1f9c29aba694" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12({g}^{-1}(x))^{2}+2}" :db/id #edb/ref 17592186302837} :answer-field/id #uuid "67848d2d-ef17-55d4-8334-d4361a471cbe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304355}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "54994de7-137e-54bf-80bb-ec8f86707073" :question/math-academy-id "q-3300" :question/problem "Find ${({g}^{-1})}^{′}(x)$  as a function of ${g}^{-1}(x),$ if $g(x)=4{x}^{3}+2x+6.$" :question/worked-solution "**Step 1:** First, we write the inverse function implicitly. The given function is $y=4{x}^{3}+2x+6,$ and to write the inverse function implicitly, we swap $x$ and $y$ as follows:\n\n$$\nx=4{y}^{3}+2y+6\n$$\n\nNote that in the equation above, we have $y={g}^{-1}(x).$\n\n**Step 2:** Next, we differentiate. The overall goal is to find $\\frac{\\text{d}y}{\\text{d}x},$ but the equation is already solved for $x,$ so we compute $\\frac{\\text{d}x}{\\text{d}y}$ and then take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(4{y}^{3}+2y+6) \\\\ \\frac{\\text{d}x}{\\text{d}y} & =12{y}^{2}+2 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{12{y}^{2}+2}\\end{aligned}\n$$\n\n**Step 3:** Lastly, we write the result in terms of ${g}^{-1}(x).$ Since $y={g}^{-1}(x),$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[{g}^{-1}(x)] & =\\frac{1}{12({g}^{-1}(x))^{2}+2} \\\\ {({g}^{-1})}^{′}(x) & =\\frac{1}{12({g}^{-1}(x))^{2}+2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186060270 :knowledge-point/_questions [{:db/id #edb/ref 17592186059685 :knowledge-point/id #uuid "993c8fe4-dae9-5dc4-9f94-5012f905e0ee" :knowledge-point/title "Finding the Correct Quadrant for Negative Angles that Contain More Than One Full Rotation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "252d775f-77ed-511b-95ad-524d7bb4cd39" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "IV" :db/id #edb/ref 17592186315326} {:answer/id #uuid "6bcab351-5c37-5d1b-99d8-985db29eacd6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II" :db/id #edb/ref 17592186315726} {:answer/id #uuid "969cb243-da0c-5f4c-8e30-aedc2baa4e6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Between quadrants III and IV" :db/id #edb/ref 17592186315954} {:answer/id #uuid "ae942c7b-d556-576d-99b4-c2d5e0d5ad8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I" :db/id #edb/ref 17592186316110} {:answer/id #uuid "e7b0d548-2819-5f8e-b792-8ccfa0fb789c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III" :db/id #edb/ref 17592186316400}] :answer-field/correct {:answer/id #uuid "969cb243-da0c-5f4c-8e30-aedc2baa4e6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Between quadrants III and IV" :db/id #edb/ref 17592186315954} :answer-field/id #uuid "e94ae561-6bac-5708-8ab7-f7ca8354b9fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186317100}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8483a20c-9e8e-5588-94ee-dd0e0014806e" :question/math-academy-id "q-34325" :question/problem "The angle $\\theta =-{450}^{∘}$ is represented in the coordinate plane in the usual way. In which quadrant does it lie?" :question/worked-solution "First, we find an angle that's coterminal with $-{450}^{∘}$ by *adding* integer multiples of ${360}^{∘}$ until we get an angle that lies in the range $[{0}^{∘},{360}^{∘}).$\n\n- $-{450}^{∘}+{360}^{∘}=-90$\n\n- $-{450}^{∘}+2\\cdot {360}^{∘}={270}^{∘}\\,✓$\n\nSo the angle ${270}^{∘}$ is coterminal with $-{450}^{∘}.$ Let's draw this coterminal angle in the coordinate plane.\n\n![](images/35/35b9783c9ac87b0a8d177e7bdf340b48513146404b7c768a8532da59b6ec7948.png)\n\nWe see that ${270}^{∘}$ lies between quadrants III and IV. Therefore, $-{450}^{∘}$ also lies between these quadrants."}] [{:db/id #edb/ref 17592186069268 :knowledge-point/_questions [{:db/id #edb/ref 17592186068861 :knowledge-point/id #uuid "a7f04ab7-f6f6-5d01-bfcf-b667e37e4f0b" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Irrational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "824db7a0-468b-5b7c-bdd3-7bd19185dd56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p + q = 80, z =-5 ± 5\\sqrt{3}" :db/id #edb/ref 17592186066779} {:answer/id #uuid "f44af2a5-1591-5f5e-93ba-40c0ddd584b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p + q = 80, z =-8 ± 3" :db/id #edb/ref 17592186066780} {:answer/id #uuid "30dfca08-4199-59da-8d02-2600e0f2122b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p + q = 75, z = 5 ± 5\\sqrt{3}" :db/id #edb/ref 17592186066781} {:answer/id #uuid "4a3b9749-a33c-5c57-89ac-26939f855dba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p + q = 80, z = 5 ± 5\\sqrt{3}" :db/id #edb/ref 17592186066782} {:answer/id #uuid "6d135e5e-ebb4-5c27-84bf-0be68ee6c029" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p + q =-70, z = ± \\sqrt{3}" :db/id #edb/ref 17592186066783}] :answer-field/id #uuid "988361f0-82f8-5fa0-bce8-8775fead2e27" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186066778} {:answer-field/choices [{:answer/id #uuid "9eb9e11c-6e9c-5d9f-85b6-41a705579cde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=80,\\,z=-5\\pm 5\\sqrt{3}" :db/id #edb/ref 17592186402357} {:answer/id #uuid "23289d14-87e9-57fb-bbda-cdd305eb9ab6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=-70,\\,z=\\pm \\sqrt{3}" :db/id #edb/ref 17592186402358} {:answer/id #uuid "691a3cdd-d3d5-50e7-a708-646cfa31e0a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=80,\\,z=-8\\pm 3" :db/id #edb/ref 17592186402359} {:answer/id #uuid "823c0a9e-ef4b-5a9d-a5eb-0fe274767e74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=75,\\,z=5\\pm 5\\sqrt{3}" :db/id #edb/ref 17592186402360} {:answer/id #uuid "ee362d99-5b0e-55c5-83d5-a9a8872163ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=80,\\,z=5\\pm 5\\sqrt{3}" :db/id #edb/ref 17592186402361}] :answer-field/correct {:answer/id #uuid "9eb9e11c-6e9c-5d9f-85b6-41a705579cde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=80,\\,z=-5\\pm 5\\sqrt{3}" :db/id #edb/ref 17592186402357} :answer-field/id #uuid "0174c191-2a23-5d0f-b8d7-9880c6f7ee41" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402356}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5c0076f5-08a5-5d4c-9789-196650ab8295" :question/math-academy-id "q-3435" :question/problem "The equation ${z}^{2}-50=-10z$ can be written in the form $(z+p{)}^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "First, we move the constant term to the right-hand side, the $-10z$ term to the left-hand side, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}{z}^{2}-50 & =-10z \\\\ {z}^{2}+10z & =50 \\\\ {z}^{2}+2\\cdot 5\\cdot z & =50 \\\\ {z}^{2}+2\\cdot 5\\cdot z+{5}^{2}-{5}^{2} & =50 \\\\ (z+5{)}^{2}-{5}^{2} & =50\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(z+5{)}^{2}-{5}^{2} & =50 \\\\ (z+5{)}^{2} & =75\\end{aligned}\n$$\n\nSo, $p=5,q=75,$ and $p+q=80.$\n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(z+5{)}^{2} & =75 \\\\ \\sqrt{(z+5{)}^{2}} & =\\sqrt{75} \\\\ |z+5| & =\\sqrt{75} \\\\ z+5 & =\\pm 5\\sqrt{3} \\\\ z & =-5\\pm 5\\sqrt{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186060272 :knowledge-point/_questions [{:db/id #edb/ref 17592186059685 :knowledge-point/id #uuid "993c8fe4-dae9-5dc4-9f94-5012f905e0ee" :knowledge-point/title "Finding the Correct Quadrant for Negative Angles that Contain More Than One Full Rotation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f1000f1-7874-54ec-a25c-a6fdd4c99c19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I" :db/id #edb/ref 17592186058255} {:answer/id #uuid "3d05c2d3-5f8b-520c-9698-93cd44016078" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Between quadrants II and III" :db/id #edb/ref 17592186058256} {:answer/id #uuid "3e675e47-ccc8-5f07-88dd-4486ea14690b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "IV" :db/id #edb/ref 17592186058257} {:answer/id #uuid "4077c45f-7284-5f8a-b112-9435133409d5" :answer/type {:db/id #edb/ref 17592