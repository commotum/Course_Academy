#{[{:db/id #edb/ref 17592186332704 :knowledge-point/_questions [{:db/id #edb/ref 17592186064235 :knowledge-point/id #uuid "236f51c2-22ad-551f-afb4-62fd6de6d21e" :knowledge-point/title "Integrating a Quotient of Linear Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39877dcd-c15f-5b42-9992-628fd69aa8c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x+5\\operatorname{ln}⁡|x+2|+C" :db/id #edb/ref 17592186330466} {:answer/id #uuid "4d37ea75-59a6-53b7-8119-27c921f17e61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x-\\operatorname{ln}⁡|x+2|+C" :db/id #edb/ref 17592186330649} {:answer/id #uuid "78fde374-d249-56e5-8ed2-413b17b19765" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x+7\\operatorname{ln}⁡|x+2|+C" :db/id #edb/ref 17592186331025} {:answer/id #uuid "bde7299b-9c7d-563b-a909-63879e3087e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x-3\\operatorname{ln}⁡|x+2|+C" :db/id #edb/ref 17592186331631} {:answer/id #uuid "fae341a7-c701-5ce9-8756-3f3183adee01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x+2\\operatorname{ln}⁡|x+2|+C" :db/id #edb/ref 17592186332153}] :answer-field/correct {:answer/id #uuid "bde7299b-9c7d-563b-a909-63879e3087e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x-3\\operatorname{ln}⁡|x+2|+C" :db/id #edb/ref 17592186331631} :answer-field/id #uuid "cd8664ab-82c6-5935-885b-4704ea3140b0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332559}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ec1f8b08-73c8-5230-ba02-f32931218a96" :question/math-academy-id "q-49354" :question/problem "$\\int \\frac{5x+7}{x+2}\\,\\text{d}x=$" :question/worked-solution "The denominator of the integrand doesn't divide the numerator exactly, so we need to decompose it into its quotient and remainder. For this, we can use synthetic division.\n\nWe start by drawing up our synthetic division table:\n\n$$\n\\begin{aligned} & x & {x}^{0} \\\\ -2 & 5 & 7 \\\\  & ↓ & -10 \\\\  & 5 & -3\\end{aligned}\n$$\n\nSo from the synthetic division, we get that\n\n$$\n\\frac{5x+7}{x+2}=5-\\frac{3}{x+2}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{5x+7}{x+5}\\,\\text{d}x & =\\int (5-\\frac{3}{x+2})\\text{d}x \\\\  & =5\\int \\text{d}x-3\\int \\frac{1}{x+2}\\,\\text{d}x \\\\  & =5x-3\\operatorname{ln}⁡|x+2|+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332706 :knowledge-point/_questions [{:db/id #edb/ref 17592186064208 :knowledge-point/id #uuid "af32f07f-fa65-5ede-a506-735dc2d3a5ef" :knowledge-point/title "Integrating a Combination of Linear Rational Functions Using the General Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "228ee8e3-4cbc-54ca-86e0-41d6984f52f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(K|(1+x)(1-x)|)" :db/id #edb/ref 17592186330248} {:answer/id #uuid "415b24a1-a0a1-566e-804a-10c3a545d297" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(K|(1+x)(1-x)|)" :db/id #edb/ref 17592186330529} {:answer/id #uuid "4af1094c-11cd-5b21-a560-c386722e9007" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(K|\\frac{1+x}{1-x}|)" :db/id #edb/ref 17592186330628} {:answer/id #uuid "5e33cd57-a4d3-57fa-af23-86332f408cbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(K|\\frac{1+x}{1-x}|)" :db/id #edb/ref 17592186330791} {:answer/id #uuid "86a4a011-da14-5843-825b-84a1ae516e62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(K|\\frac{1+x}{1-x}|)" :db/id #edb/ref 17592186331147}] :answer-field/correct {:answer/id #uuid "86a4a011-da14-5843-825b-84a1ae516e62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(K|\\frac{1+x}{1-x}|)" :db/id #edb/ref 17592186331147} :answer-field/id #uuid "d573eb9f-5b4a-5c4d-be89-c86d1a19944c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332577}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1dc5a85a-4afe-5495-af86-22c90f6982a7" :question/math-academy-id "q-49360" :question/problem "Calculate $\\int (\\frac{1}{1+x}+\\frac{1}{1-x})\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "Let's solve this using the general formula:\n\n$$\n\\begin{aligned}\\int (\\frac{1}{1+x}+\\frac{1}{1-x})\\,\\text{d}x & =\\int \\frac{1}{1+x}\\,\\text{d}x+\\int \\frac{1}{1-x}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡|1+x|-\\operatorname{ln}⁡|1-x|+C \\\\  & =\\operatorname{ln}⁡|\\frac{1+x}{1-x}|+\\operatorname{ln}⁡K \\\\  & =\\operatorname{ln}⁡(K|\\frac{1+x}{1-x}|)\\end{aligned}\n$$\n\nNotice that we used the laws of logarithms to write the result as a single logarithm."}] [{:db/id #edb/ref 17592186398869 :knowledge-point/_questions [{:db/id #edb/ref 17592186064205 :knowledge-point/id #uuid "0ae5760b-9277-596c-8546-dca4fd985bd7" :knowledge-point/title "Integrating an Algebraic Function With Fractional Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "739b7d37-465f-53a0-92fd-a46f218e891c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{9}\\sqrt{(1-9z)^{3}}+C" :db/id #edb/ref 17592186398871} {:answer/id #uuid "c966cc5b-2f5d-56fa-94a2-562519ed3dc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt{1-9z}+C" :db/id #edb/ref 17592186398872} {:answer/id #uuid "570962e4-656c-562b-b969-b8505698bd15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{9}\\sqrt{1-9z}+C" :db/id #edb/ref 17592186398873} {:answer/id #uuid "bede226b-b6b5-5601-a51f-99f2392a59d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\sqrt{1-9z}+C" :db/id #edb/ref 17592186398874} {:answer/id #uuid "c91eab72-8ce7-50be-b8c3-3258720d8056" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{(1-9z)^{3}}+C" :db/id #edb/ref 17592186398875}] :answer-field/correct {:answer/id #uuid "570962e4-656c-562b-b969-b8505698bd15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{9}\\sqrt{1-9z}+C" :db/id #edb/ref 17592186398873} :answer-field/id #uuid "f1f41607-89e1-5a62-888e-441db9b42ea9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398870}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "78d0396e-82eb-542b-a43f-b6df87f217ac" :question/math-academy-id "q-49431" :question/problem "Calculate $\\int \\frac{1}{\\sqrt{1-9z}}\\,\\text{d}z.$" :question/worked-solution "First, we rewrite the integral as\n\n$$\n\\int (1-9z)^{-1/2}\\,\\text{d}z.\n$$\n\nNow, we let $u=1-9z.$ Then differentiating with respect to $z$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}z}=-9\\,⟹\\,\\text{d}z=-\\frac{1}{9}\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $u$ at the very end:\n\n$$\n\\begin{aligned}\\int (1-9z)^{-1/2}\\,\\text{d}z & =\\int {u}^{-1/2}\\cdot (-\\frac{1}{9}\\text{d}u) \\\\  & =-\\frac{1}{9}\\int {u}^{-1/2}\\,\\text{d}u \\\\  & =-\\frac{1}{9}\\frac{1}{(1/2)}{u}^{1/2}+C \\\\  & =-\\frac{2}{9}{u}^{1/2}+C \\\\  & =-\\frac{2}{9}(1-9z)^{1/2}+C \\\\  & =-\\frac{2}{9}\\sqrt{1-9z}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}z}[-\\frac{2}{9}\\sqrt{1-9z}+C] & =-\\frac{2}{9}\\cdot \\frac{\\text{d}}{\\text{d}z}[\\sqrt{1-9z}]+\\frac{\\text{d}}{\\text{d}z}(C) \\\\  & =-\\frac{2}{9}\\cdot \\frac{\\text{d}}{\\text{d}z}[(1-9z)^{1/2}]+\\frac{\\text{d}}{\\text{d}z}(C) \\\\  & =-\\frac{2}{9}\\cdot \\frac{1}{2}(1-9z)^{-1/2}\\cdot \\frac{\\text{d}}{\\text{d}z}(1-9z)+0 \\\\  & =-\\frac{1}{9}\\cdot (1-9z)^{-1/2}\\cdot (-9) \\\\  & =(1-9z)^{-1/2} \\\\  & =\\frac{1}{\\sqrt{1-9z}}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186398876 :knowledge-point/_questions [{:db/id #edb/ref 17592186064205 :knowledge-point/id #uuid "0ae5760b-9277-596c-8546-dca4fd985bd7" :knowledge-point/title "Integrating an Algebraic Function With Fractional Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70657675-2db0-5a10-9cf9-052f05edf016" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{11}\\sqrt[4]{(x-100)^{11}}+C" :db/id #edb/ref 17592186398878} {:answer/id #uuid "3909aff4-3810-5b83-850f-f988be7ba4f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[4]{(x-100)^{11}}+C" :db/id #edb/ref 17592186398879} {:answer/id #uuid "4061afb3-02dc-5f4e-ae19-437ea14959c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11\\sqrt[4]{(x-100)^{11}}+C" :db/id #edb/ref 17592186398880} {:answer/id #uuid "3295113f-e7ef-59d3-92a7-66e977a1b12b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[4]{(x-100)^{9}}+C" :db/id #edb/ref 17592186398881} {:answer/id #uuid "732c775a-c5f4-5d4e-91c3-0fdfab8cfb52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{9}\\sqrt[4]{(x-100)^{9}}+C" :db/id #edb/ref 17592186398882}] :answer-field/correct {:answer/id #uuid "70657675-2db0-5a10-9cf9-052f05edf016" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{11}\\sqrt[4]{(x-100)^{11}}+C" :db/id #edb/ref 17592186398878} :answer-field/id #uuid "cad56171-faf0-523d-b089-53ed18731d86" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398877}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "61d8dd43-99c6-5162-9111-9fc96bb88dcd" :question/math-academy-id "q-49439" :question/problem "Calculate the integral $\\int \\sqrt[4]{(x-100)^{7}}\\,\\text{d}x.$" :question/worked-solution "First, we rewrite the integral as\n\n$$\n\\int (x-100)^{7/4}\\,\\text{d}x.\n$$\n\nNow, we let  $u=x-100.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $u$ at the very end:\n\n$$\n\\begin{aligned}\\int (x-100)^{7/4}\\,\\text{d}x & =\\int {u}^{7/4}\\,\\text{d}u \\\\  & =\\frac{{u}^{11/4}}{11/4}+C \\\\  & =\\frac{4}{11}(x-100)^{11/4}+C \\\\  & =\\frac{4}{11}\\sqrt[4]{(x-100)^{11}}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[\\frac{4}{11}\\sqrt[4]{(x-100)^{11}}+C] & =\\frac{4}{11}\\cdot \\frac{\\text{d}}{\\text{d}x}[\\sqrt[4]{(x-100)^{11}}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =\\frac{4}{11}\\cdot \\frac{\\text{d}}{\\text{d}x}[(x-100)^{11/4}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =\\frac{4}{11}\\cdot \\frac{11}{4}(x-100)^{7/4}\\cdot \\frac{\\text{d}}{\\text{d}x}(x-100)+0 \\\\  & =(x-100)^{7/4}\\cdot 1 \\\\  & =\\sqrt[4]{(x-100)^{7}}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186097279 :knowledge-point/_questions [{:db/id #edb/ref 17592186096830 :knowledge-point/id #uuid "19a857ac-d36b-5753-a532-4f2a75612d85" :knowledge-point/title "Integrating Using the Pythagorean Trigonometric Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "108a7ce4-2fbf-516f-a9ee-b0a3967d1ebb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\pi +25{\\pi }^{4}" :db/id #edb/ref 17592186330097} {:answer/id #uuid "47bebd14-566b-5a48-8dbc-247b8097cc88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\pi -{\\pi }^{3}" :db/id #edb/ref 17592186330597} {:answer/id #uuid "60ddca83-6f18-5dc0-95bb-2dc02a3ce78b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\pi -{\\pi }^{4}" :db/id #edb/ref 17592186330809} {:answer/id #uuid "c27ccaf5-3c10-5e24-8068-3a5fefe8b53c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi -5{\\pi }^{4}" :db/id #edb/ref 17592186331679} {:answer/id #uuid "e52dff9e-56c4-5804-958b-c767f612d3a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi -{\\pi }^{4}" :db/id #edb/ref 17592186331969}] :answer-field/correct {:answer/id #uuid "60ddca83-6f18-5dc0-95bb-2dc02a3ce78b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\pi -{\\pi }^{4}" :db/id #edb/ref 17592186330809} :answer-field/id #uuid "5bb69ecc-629f-586f-a88d-4e843428cff3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332379}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d7b11093-5b5a-58f1-bca1-3927cf2df9a7" :question/math-academy-id "q-49447" :question/problem "${\\int }_{0}^{\\pi }(10{cos}^{2}⁡x-4{x}^{3}+10{sin}^{2}⁡x)\\text{d}x=$" :question/worked-solution "We use the Pythagorean identity:\n\n$$\n{cos}^{2}⁡x+{sin}^{2}⁡x=1\n$$\n\nUsing the above, we compute the given integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi }(10{cos}^{2}⁡x-4{x}^{3}+10{sin}^{2}⁡x)\\text{d}x & ={\\int }_{0}^{\\pi }(10({sin}^{2}⁡x+{cos}^{2}⁡x)-4{x}^{3})\\text{d}x \\\\  & ={\\int }_{0}^{\\pi }(10\\cdot 1-4{x}^{3})\\text{d}x \\\\  & ={\\int }_{0}^{\\pi }(10-4{x}^{3})\\text{d}x \\\\  & =(10x-{x}^{4}){|}_{0}^{\\pi } \\\\  & =[10\\pi -{\\pi }^{4}]-[10\\cdot 0-{0}^{4}] \\\\  & =10\\pi -{\\pi }^{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332718 :knowledge-point/_questions [{:db/id #edb/ref 17592186068724 :knowledge-point/id #uuid "18ce1807-3a09-5ebd-b3cd-a91db8d2b4a8" :knowledge-point/title "Integrating a Rational Function Using Natural Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b8b60ab-4072-5f31-94dd-75c493f8372d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡({x}^{2}+1)+C" :db/id #edb/ref 17592186330332} {:answer/id #uuid "7e6534ec-42dc-57fa-b80f-40c681fa5d3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡({x}^{2}+1)+C" :db/id #edb/ref 17592186331061} {:answer/id #uuid "ad30acb9-e2fc-5534-870a-032790c3f83f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{({x}^{2}+1)^{2}}+C" :db/id #edb/ref 17592186331484} {:answer/id #uuid "e1762878-a949-5466-848b-82eaa3555015" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡({x}^{2}+1)+C" :db/id #edb/ref 17592186331941} {:answer/id #uuid "f51b2f83-41fe-5b84-b9cb-eee7ef105dd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{({x}^{2}+1)^{2}}+C" :db/id #edb/ref 17592186332106}] :answer-field/correct {:answer/id #uuid "e1762878-a949-5466-848b-82eaa3555015" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡({x}^{2}+1)+C" :db/id #edb/ref 17592186331941} :answer-field/id #uuid "1f3093a8-9026-569a-a294-190db04689b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332247}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "503a6da2-cd33-5244-b696-2a607d8e13a7" :question/math-academy-id "q-49451" :question/problem "$\\int \\frac{4x}{{x}^{2}+1}\\,\\text{d}x=$" :question/worked-solution "Let $u={x}^{2}+1.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{4x}{{x}^{2}+1}\\,\\text{d}x & =4\\int \\frac{1}{{x}^{2}+1}\\cdot x\\,\\text{d}x \\\\  & =4\\int \\frac{1}{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =2\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡|u|+C \\\\  & =2\\operatorname{ln}⁡({x}^{2}+1)+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332720 :knowledge-point/_questions [{:db/id #edb/ref 17592186064206 :knowledge-point/id #uuid "fc4294d6-3d60-5c9e-a862-863e1d129049" :knowledge-point/title "Integrating a Linear Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a085972-1baf-5648-867f-fa22e0ba0ea8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡|x+4|+C" :db/id #edb/ref 17592186330175} {:answer/id #uuid "333a8449-f54e-51ed-9268-4a29c687d042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡|x+4|+C" :db/id #edb/ref 17592186330401} {:answer/id #uuid "903c6656-2cfe-57a6-9d04-bf4558a5f1f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|x+4|+C" :db/id #edb/ref 17592186331233} {:answer/id #uuid "b84ce15d-f916-5272-a13b-c0e2002f591a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\operatorname{ln}⁡|x+4|+C" :db/id #edb/ref 17592186331578} {:answer/id #uuid "c7f98b80-b189-5486-9209-b6f6b685306a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}\\operatorname{ln}⁡|x+4|+C" :db/id #edb/ref 17592186331720}] :answer-field/correct {:answer/id #uuid "333a8449-f54e-51ed-9268-4a29c687d042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡|x+4|+C" :db/id #edb/ref 17592186330401} :answer-field/id #uuid "e906895e-8048-51d8-952c-ac1ed3e3bf3a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332609}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f7ef9efb-7fe5-57f8-b97b-c7d8ad3002b1" :question/math-academy-id "q-49453" :question/problem "Calculate $\\int \\frac{3}{x+4}\\,\\text{d}x.$" :question/worked-solution "First, let $u=x+4.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{3}{x+4}\\,\\text{d}x & =3\\int \\frac{1}{x+4}\\,\\text{d}x \\\\  & =3\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡|u|+C \\\\  & =3\\operatorname{ln}⁡|x+4|+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332722 :knowledge-point/_questions [{:db/id #edb/ref 17592186064236 :knowledge-point/id #uuid "f110daa3-fd31-5e34-8a88-0e002c2e418a" :knowledge-point/title "Integrating a Rational Function Whose Denominator is Linear"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38ad2ded-1acd-5d0f-9482-ff2d40cddfe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}{x}^{3}-3x-2\\operatorname{ln}⁡|x-3|+C" :db/id #edb/ref 17592186330459} {:answer/id #uuid "6a0ce5c3-0e37-5bf1-b40e-9f1752a34f46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}+x+2\\operatorname{ln}⁡|x-3|+C" :db/id #edb/ref 17592186330901} {:answer/id #uuid "7c615908-c6e2-5115-bb4e-9bf4a5d0c8ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}-9{x}^{2}+x+\\operatorname{ln}⁡|x-3|+C" :db/id #edb/ref 17592186331043} {:answer/id #uuid "9fda2557-86c6-5fb7-959b-9fbd45ed4623" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}{x}^{3}-3{x}^{2}+2x-\\operatorname{ln}⁡|x-3|+C" :db/id #edb/ref 17592186331387} {:answer/id #uuid "f5494940-6b67-5796-a605-3c01ce2a03d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}{x}^{3}-\\frac{9}{2}{x}^{2}+\\frac{1}{2}x-3\\operatorname{ln}⁡|x-3|+C" :db/id #edb/ref 17592186332108}] :answer-field/correct {:answer/id #uuid "6a0ce5c3-0e37-5bf1-b40e-9f1752a34f46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}+x+2\\operatorname{ln}⁡|x-3|+C" :db/id #edb/ref 17592186330901} :answer-field/id #uuid "78373e7d-b109-554d-afe9-f989789a365a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332419}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "67660e4b-92f2-5ae6-aaa9-23b06f12a0c2" :question/math-academy-id "q-49456" :question/problem "Calculate $\\int \\frac{3{x}^{3}-9{x}^{2}+x-1}{x-3}\\,\\text{d}x.$" :question/worked-solution "We first need to decompose the integrand into its quotient and remainder parts, which we can do using synthetic division.\n\nWe draw up a synthetic division table:\n\n$$\n\\begin{aligned} & {x}^{3} & {x}^{2} & {x}^{1} & {x}^{0} \\\\ 3 & 3 & -9 & 1 & -1 \\\\  & ↓ & 9 & 0 & 3 \\\\  & 3 & 0 & 1 & 2\\end{aligned}\n$$\n\nSo from the synthetic division, we get that\n\n$$\n\\frac{3{x}^{3}-9{x}^{2}+x-1}{x-3}=3{x}^{2}+1+\\frac{2}{x-3}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{3{x}^{3}-9{x}^{2}+x-1}{x-3}\\,\\text{d}x & =\\int (3{x}^{2}+1+\\frac{2}{x-3})\\text{d}x \\\\  & =3\\int {x}^{2}\\,\\text{d}x+\\int \\text{d}x+2\\int \\frac{1}{x-3}\\,\\text{d}x \\\\  & ={x}^{3}+x+2\\operatorname{ln}⁡|x-3|+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186398883 :knowledge-point/_questions [{:db/id #edb/ref 17592186064205 :knowledge-point/id #uuid "0ae5760b-9277-596c-8546-dca4fd985bd7" :knowledge-point/title "Integrating an Algebraic Function With Fractional Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64f1bb19-f6a2-538a-8094-300b1e55cc31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sqrt[5]{{(s+1)}^{3}}+C" :db/id #edb/ref 17592186398885} {:answer/id #uuid "ef8f42a5-cc05-5072-93b3-0b55ad819b57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt[5]{{(s+1)}^{2}}+C" :db/id #edb/ref 17592186398886} {:answer/id #uuid "1c531862-1246-5d33-83db-faf2c5f53bfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[5]{{(s+1)}^{2}}+C" :db/id #edb/ref 17592186398887} {:answer/id #uuid "eeef3e88-28df-595f-88f1-2280a46131c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\sqrt[5]{{(s+1)}^{3}}+C" :db/id #edb/ref 17592186398888} {:answer/id #uuid "c04d34f3-85b9-5e8c-b8f6-dc61a84a62ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}\\sqrt[5]{{(s+1)}^{2}}+C" :db/id #edb/ref 17592186398889}] :answer-field/correct {:answer/id #uuid "c04d34f3-85b9-5e8c-b8f6-dc61a84a62ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}\\sqrt[5]{{(s+1)}^{2}}+C" :db/id #edb/ref 17592186398889} :answer-field/id #uuid "69629315-77cc-510c-b6be-75d926e5d966" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398884}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2058ea27-d95b-5f37-8b22-5c724bfe6f2c" :question/math-academy-id "q-49468" :question/problem "$\\int \\frac{1}{\\sqrt[5]{{(s+1)}^{3}}}\\,\\text{d}s=$" :question/worked-solution "First, we rewrite the integral as\n\n$$\n\\int {(s+1)}^{-3/5}\\,\\text{d}s.\n$$\n\nNow, we let  $u=s+1.$ Then differentiating with respect to $s$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}s}=1\\,⟹\\,\\text{d}s=\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $u$ at the very end:\n\n$$\n\\begin{aligned}\\int {(s+1)}^{-3/5}\\,\\text{d}s & =\\int {u}^{-3/5}\\,\\text{d}u \\\\  & =\\frac{1}{2/5}{u}^{2/5}+C \\\\  & =\\frac{5}{2}{u}^{2/5}+C \\\\  & =\\frac{5}{2}{(s+1)}^{2/5}+C \\\\  & =\\frac{5}{2}\\sqrt[5]{{(s+1)}^{2}}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}s}[\\frac{5}{2}\\sqrt[5]{{(s+1)}^{2}}+C] & =\\frac{5}{2}\\cdot \\frac{\\text{d}}{\\text{d}s}[\\sqrt[5]{{(s+1)}^{2}}]+\\frac{\\text{d}}{\\text{d}s}(C) \\\\  & =\\frac{5}{2}\\cdot \\frac{\\text{d}}{\\text{d}s}[{(s+1)}^{2/5}]+\\frac{\\text{d}}{\\text{d}s}(C) \\\\  & =\\frac{5}{2}\\cdot \\frac{2}{5}{(s+1)}^{-3/5}\\cdot \\frac{\\text{d}}{\\text{d}s}(s+1)+0 \\\\  & ={(s+1)}^{-3/5}\\cdot 1 \\\\  & =\\frac{1}{\\sqrt[5]{{(s+1)}^{3}}}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332733 :knowledge-point/_questions [{:db/id #edb/ref 17592186064209 :knowledge-point/id #uuid "94ad8efa-33ee-5451-b6b9-c99cb81a9ba2" :knowledge-point/title "Calculating Definite Integrals of Algebraic Functions Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d32797f-9d7a-5b52-8960-235626e6cc66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{1}^{5}({u}^{1/2}+{u}^{-1/2})\\text{d}u" :db/id #edb/ref 17592186330067} {:answer/id #uuid "16e90fc0-413f-571e-9234-9c9d29c6bffe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{1}^{3}\\sqrt{u}\\,\\text{d}u" :db/id #edb/ref 17592186330146} {:answer/id #uuid "7c647bff-6963-5d64-a559-cc69b3e75a2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{1}^{3}({u}^{3/2}+{u}^{1/2})\\text{d}u" :db/id #edb/ref 17592186331044} {:answer/id #uuid "ed05fcfb-bb70-599b-838c-5723fd5d7864" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}{\\int }_{1}^{5}({u}^{3/2}+{u}^{1/2})\\text{d}u" :db/id #edb/ref 17592186332028} {:answer/id #uuid "f80a4b5a-7c6a-584d-ab83-e74c1159cbd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}{\\int }_{1}^{5}\\sqrt{u}\\,\\text{d}u" :db/id #edb/ref 17592186332129}] :answer-field/correct {:answer/id #uuid "ed05fcfb-bb70-599b-838c-5723fd5d7864" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}{\\int }_{1}^{5}({u}^{3/2}+{u}^{1/2})\\text{d}u" :db/id #edb/ref 17592186332028} :answer-field/id #uuid "c96e4fa0-68d1-58eb-a210-73f341888124" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332553}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d2063239-3a6f-54f6-9552-f4b8aed0756c" :question/math-academy-id "q-49529" :question/problem "Given that $u=2x-1$, which integral is equivalent to ${\\int }_{1}^{3}x\\sqrt{2x-1}\\,\\text{d}x?$" :question/worked-solution "Since $u=2x-1$, then we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\text{d}x=\\frac{1}{2}\\text{d}u.\n$$\n\nWe also note that $x=\\frac{u+1}{2}.$ \n\nComputing our limits of integration, we get\n\n| **$x$** | $1$ | $3$ |\n| --- | --- | --- |\n| **$u$** | $1$ | $5$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}x\\sqrt{2x-1}\\,\\text{d}x & ={\\int }_{1}^{5}\\frac{u+1}{2}\\cdot \\sqrt{u}\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{1}{4}{\\int }_{1}^{5}(u+1){u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{1}{4}{\\int }_{1}^{5}({u}^{3/2}+{u}^{1/2})\\text{d}u\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332739 :knowledge-point/_questions [{:db/id #edb/ref 17592186064219 :knowledge-point/id #uuid "227abe29-6e31-5afd-b0ca-3b8ed7d8c287" :knowledge-point/title "Calculating Indefinite Integrals Using Substitution with Inverse Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0218ebee-f46b-52a3-af27-002bd2e16fdd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}⁡(\\frac{x}{8})}{4}+C" :db/id #edb/ref 17592186329977} {:answer/id #uuid "2d0a098d-fa78-5f98-bfe7-2e76cd1fe7ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(\\frac{x}{4})}{4}+C" :db/id #edb/ref 17592186330349} {:answer/id #uuid "3e1c856a-d31e-5281-a2a6-f20cbee86a40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}⁡(8x)}{8}+C" :db/id #edb/ref 17592186330499} {:answer/id #uuid "6da04d85-0964-58d1-bd80-e9e62694fa8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(\\frac{x}{8})}{4}+C" :db/id #edb/ref 17592186330930} {:answer/id #uuid "e57ddc07-4a02-59ea-b4b1-dd526c6b3d82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(\\frac{x}{8})}{8}+C" :db/id #edb/ref 17592186331971}] :answer-field/correct {:answer/id #uuid "6da04d85-0964-58d1-bd80-e9e62694fa8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(\\frac{x}{8})}{4}+C" :db/id #edb/ref 17592186330930} :answer-field/id #uuid "d448c3a1-6bd6-56fc-a1f7-e15ec5601f57" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332573}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e79ee700-e1a2-5377-9595-991fdfcefa49" :question/math-academy-id "q-49551" :question/problem "$\\int \\frac{2}{64+{x}^{2}}\\,\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{2}{64+{x}^{2}}\\,\\text{d}x & =\\int \\frac{2}{64\\cdot (1+{x}^{2}/64)}\\,\\text{d}x \\\\  & =\\frac{2}{64}\\int \\frac{1}{1+{x}^{2}/64}\\,\\text{d}x \\\\  & =\\frac{1}{32}\\int \\frac{1}{1+(x/8)^{2}}\\,\\text{d}x\\end{aligned}\n$$\n\n \n\nThis integral resembles the basic integral for inverse tangent\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{8})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{8}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{8}\\,⟹\\,\\text{d}x=8\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{2}{64+{x}^{2}}\\,\\text{d}x & =\\frac{1}{32}\\int \\frac{1}{1+(x/8)^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{32}\\int \\frac{1}{1+{u}^{2}}\\cdot (8\\,\\text{d}u) \\\\  & =\\frac{1}{4}\\int \\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =\\frac{1}{4}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{1}{4}\\operatorname{arctan}⁡(\\frac{x}{8})+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332745 :knowledge-point/_questions [{:db/id #edb/ref 17592186184228 :knowledge-point/id #uuid "abad9fa9-b426-50aa-aaa7-d472ea974f98" :knowledge-point/title "Determining Values for Which a Geometric Sequence Converges: Rearrangement Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01fdd384-a572-5724-9364-8acb408f2ae5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<x\\le 3" :db/id #edb/ref 17592186329976} {:answer/id #uuid "40ccecfa-a656-5109-b074-472b0a8ab1cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<x\\le \\frac{1}{3}" :db/id #edb/ref 17592186330526} {:answer/id #uuid "5a4aa74e-0e4c-5d1a-93ae-9302fd3645d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 3" :db/id #edb/ref 17592186330757} {:answer/id #uuid "b994301b-7078-571a-b444-f5890625ea4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x>0" :db/id #edb/ref 17592186331590} {:answer/id #uuid "e6504bdb-2c3c-5430-a7f9-f5f85facc1ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge \\frac{1}{3}" :db/id #edb/ref 17592186331976}] :answer-field/correct {:answer/id #uuid "01fdd384-a572-5724-9364-8acb408f2ae5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<x\\le 3" :db/id #edb/ref 17592186329976} :answer-field/id #uuid "28c2b40b-2f58-56ca-bd6c-3ed7effb446f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332263}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "82a7ff27-052c-59e7-b715-3cb92743a1e7" :question/math-academy-id "q-49570" :question/problem "Consider the sequence ${a}_{n}=\\frac{{x}^{n+3}}{{3}^{n}\\cdot x},$ where $x$ is a positive real number and $n\\ge 1.$ What are the values of $x$ for which the sequence converges?" :question/worked-solution "Suppose we have a geometric sequence with the first term ${a}_{1}$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r|<1,$ the sequence is convergent and converges to $0$\n\n- if $|r|>1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to ${a}_{1}$\n\n- if $r=-1,$ the sequence is divergent\n\nFirst, we rewrite the sequence in the form ${a}_{n}=a\\cdot {r}^{n},$ as follows:\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{{x}^{n+3}}{{3}^{n}\\cdot x} \\\\  & =\\frac{{x}^{n}\\cdot {x}^{3}}{{3}^{n}\\cdot x} \\\\  & ={x}^{2}\\cdot {(\\frac{x}{3})}^{n}\\end{aligned}\n$$\n\n \n\nWe see that this is a geometric sequence with the common ratio $r=\\frac{x}{3}.$ Since $x$ is positive,  $r$ is also positive. So, the convergence condition is $0<r\\le 1.$ \n\nTherefore, the  sequence converges for \n\n$$\n0<\\frac{x}{3}\\le 1\\,⟹\\,0<x\\le 3.\n$$"}] [{:db/id #edb/ref 17592186101451 :knowledge-point/_questions [{:db/id #edb/ref 17592186100818 :knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f44a31c-8f02-517f-a3ff-76a016ef1103" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{ln}^{2}⁡2" :db/id #edb/ref 17592186330368} {:answer/id #uuid "3b888702-3835-5e64-a746-f342b2add188" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "68" :db/id #edb/ref 17592186330480} {:answer/id #uuid "55e0e2dc-0727-59f1-ab88-5104534b5eae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186330719} {:answer/id #uuid "570539a7-4903-5aaa-8ab5-396b0db3ecbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡4" :db/id #edb/ref 17592186330727} {:answer/id #uuid "fe377b72-3be3-5386-8d19-dd14073a8aa9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\operatorname{ln}⁡2" :db/id #edb/ref 17592186332189}] :answer-field/correct {:answer/id #uuid "55e0e2dc-0727-59f1-ab88-5104534b5eae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186330719} :answer-field/id #uuid "41c0ce28-8066-581a-a24f-804e0ab448c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332311}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "131ef8ba-67f1-5c9d-a9d6-716f27012aa1" :question/math-academy-id "q-49605" :question/problem "What is the value of ${\\int }_{{e}^{2}}^{{e}^{4}}\\frac{8\\operatorname{ln}⁡x}{x}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then  we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$  gives the following:\n\n| $x$ | ${e}^{2}$ | ${e}^{4}$ |\n| --- | --- | --- |\n| $u$ | $2$ | $4$ |\n\nWe now substitute and evaluate, as follows:\n\n$$\n\\begin{aligned}{\\int }_{{e}^{2}}^{{e}^{4}}\\frac{8\\operatorname{ln}⁡x}{x}\\,\\text{d}x & =8{\\int }_{{e}^{2}}^{{e}^{4}}\\operatorname{ln}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =8{\\int }_{2}^{4}u\\,\\text{d}u \\\\  & =8\\cdot {\\frac{{u}^{2}}{2}|}_{2}^{4} \\\\  & =4\\cdot {u}^{2}{|}_{2}^{4} \\\\  & =4\\cdot (16-4) \\\\  & =48\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332751 :knowledge-point/_questions [{:db/id #edb/ref 17592186068735 :knowledge-point/id #uuid "b428331b-4916-5b2c-8aa6-89a2358cdef0" :knowledge-point/title "Finding the Indefinite Integral of a Exponential-Trigonometric Expression Using Integration by Parts"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "258ec5da-ec83-55fd-a7fe-8f38d4ead2a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{2x}}{5}(\\operatorname{cos}⁡x-2\\operatorname{sin}⁡x)+C" :db/id #edb/ref 17592186330272} {:answer/id #uuid "28087732-5391-5b65-ae41-76ed0de34484" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{2x}}{5}(\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)+C" :db/id #edb/ref 17592186330307} {:answer/id #uuid "82583c9b-6934-531e-bb06-247d73a3e2ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{2x}}{5}(\\operatorname{sin}⁡x-2\\operatorname{cos}⁡x)+C" :db/id #edb/ref 17592186331101} {:answer/id #uuid "9c8ba72c-b7fe-5fd5-bdca-da017f4acd19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{2x}}{5}(\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x)+C" :db/id #edb/ref 17592186331350} {:answer/id #uuid "cff74fb2-4786-5e4f-9c0a-839e99bc59dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{e}^{2x}}{5}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)+C" :db/id #edb/ref 17592186331792}] :answer-field/correct {:answer/id #uuid "9c8ba72c-b7fe-5fd5-bdca-da017f4acd19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{2x}}{5}(\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x)+C" :db/id #edb/ref 17592186331350} :answer-field/id #uuid "4f49af48-cb5e-5a12-81ec-da6258d149ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332346}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "353a67b7-0856-52c7-a290-d3c8b2b07314" :question/math-academy-id "q-49609" :question/problem "Calculate $\\int {e}^{2x}\\operatorname{cos}⁡x\\,\\text{d}x.$" :question/worked-solution "To use integration by parts, let's suppose that\n\n$$\n\\begin{aligned}u={e}^{2x}\\, & ⇒\\,\\frac{\\text{d}u}{\\text{d}x}=2{e}^{2x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡x\\, & ⇒\\,v=\\int \\operatorname{cos}⁡x\\,\\text{d}x=\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nThen, using the formula of integration by parts, we get\n\n$$\n\\begin{aligned}I & =\\int {e}^{2x}\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={e}^{2x}\\operatorname{sin}⁡x-\\int (\\operatorname{sin}⁡x)(2{e}^{2x})\\text{d}x \\\\  & ={e}^{2x}\\operatorname{sin}⁡x-2\\int {e}^{2x}\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & ={e}^{2x}\\operatorname{sin}⁡x-2J.\\end{aligned}\n$$\n\nAgain, we can use integration by parts to evaluate\n\n$$\nJ=\\int {e}^{2x}\\operatorname{sin}⁡x\\,\\text{d}x.\n$$\n\nTo do this, let's suppose that\n\n$$\n\\begin{aligned}u={e}^{2x}\\, & ⇒\\,\\frac{\\text{d}u}{\\text{d}x}=2{e}^{2x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡x\\, & ⇒\\,v=\\int \\operatorname{sin}⁡x\\,\\text{d}x=-\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}J & =\\int {e}^{2x}\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={e}^{2x}(-\\operatorname{cos}⁡x)-\\int (-\\operatorname{cos}⁡x)(2{e}^{2x})\\text{d}x \\\\  & =-{e}^{2x}\\operatorname{cos}⁡x+2\\int {e}^{2x}\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =-{e}^{2x}\\operatorname{cos}⁡x+2I.\\end{aligned}\n$$\n\nFinally, substituting this back into our equation for $I,$ we can subsequently solve for $I.$ We remember to add a constant of integration $C$ at the end.\n\n$$\n\\begin{aligned}I & ={e}^{2x}\\operatorname{sin}⁡x-2J \\\\ I & ={e}^{2x}\\operatorname{sin}⁡x-2(-{e}^{2x}\\operatorname{cos}⁡x+2I) \\\\ I & ={e}^{2x}\\operatorname{sin}⁡x+2{e}^{2x}\\operatorname{cos}⁡x-4I \\\\ 5I & ={e}^{2x}\\operatorname{sin}⁡x+2{e}^{2x}\\operatorname{cos}⁡x \\\\ I & =\\frac{{e}^{2x}}{5}(\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x)+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332754 :knowledge-point/_questions [{:db/id #edb/ref 17592186064253 :knowledge-point/id #uuid "b492068c-2bd2-5611-baab-780959d24c3d" :knowledge-point/title "Calculating the Derivative of an Inverse Function Using a Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10e50061-c0cd-514f-8589-ebd50e9d1e12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186330101} {:answer/id #uuid "15d95872-0f46-51e2-b153-2442cc2ccf56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186330132} {:answer/id #uuid "99340278-5d40-5f93-b26f-a88c525e06b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186331320} {:answer/id #uuid "b6603c76-d9c0-5622-8266-b3996ec50863" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186331559} {:answer/id #uuid "b6a90fb1-443f-5acc-8cf7-2a64602260da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186331562}] :answer-field/correct {:answer/id #uuid "99340278-5d40-5f93-b26f-a88c525e06b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186331320} :answer-field/id #uuid "2509a479-fd42-562e-8cab-f44c6d32a5f9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332252}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "67f65475-64ee-5851-9243-07c4ff50e013" :question/math-academy-id "q-4962" :question/problem "The following table gives the values of functions $g(x)$ and ${g}^{′}(x)$ at some points. Find $({g}^{-1})^{′}(-2).$\n\n| **$x$** | $g(x)$ | ${g}^{′}(x)$ |\n| --- | --- | --- |\n| $-2$ | $4$ | $3$ |\n| $0$ | $1$ | $6$ |\n| $1$ | $-2$ | $8$ |" :question/worked-solution "The formula for the derivative of the inverse is\n\n$$\n({g}^{-1})^{′}(x)=\\frac{1}{{g}^{′}({g}^{-1}(x))}.\n$$\n\nSubstituting $x=-2,$ we have\n\n$$\n({g}^{-1})^{′}(-2)=\\frac{1}{{g}^{′}({g}^{-1}(-2))}.\n$$\n\nFrom the table, we obtain ${g}^{-1}(-2)=1$ and ${g}^{′}(1)=8.$ Therefore,\n\n$$\n\\begin{aligned}({g}^{-1})^{′}(-2) & =\\frac{1}{{g}^{′}({g}^{-1}(-2))} \\\\  & =\\frac{1}{{g}^{′}(1)} \\\\  & =\\frac{1}{8}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332755 :knowledge-point/_questions [{:db/id #edb/ref 17592186100874 :knowledge-point/id #uuid "9dcde3b5-5cdf-5266-9392-0835053a7ded" :knowledge-point/title "Calculating a Definite Integral of Function Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "455c1245-c286-51ee-8b71-5df8dd0ec3a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}(3\\sqrt{3}-1)" :db/id #edb/ref 17592186330575} {:answer/id #uuid "71fe6547-c7cf-54d3-bc02-4090b59215ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}(3\\sqrt{3}-1)" :db/id #edb/ref 17592186330974} {:answer/id #uuid "9d056934-52b2-5970-b8ce-f04c50502ec0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}(3\\sqrt{3})" :db/id #edb/ref 17592186331356} {:answer/id #uuid "b02c3a52-f4b9-5722-9302-2760583bc78e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(3\\sqrt{3}+1)" :db/id #edb/ref 17592186331510} {:answer/id #uuid "d1587f6b-b870-5469-993d-ac5199f2ca89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{7}-1)" :db/id #edb/ref 17592186331805}] :answer-field/correct {:answer/id #uuid "71fe6547-c7cf-54d3-bc02-4090b59215ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}(3\\sqrt{3}-1)" :db/id #edb/ref 17592186330974} :answer-field/id #uuid "872a381f-94df-5ea3-9ade-45bc07d0d4ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332437}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "51462d31-1f9f-535d-b34a-3d3333f0fc53" :question/math-academy-id "q-49622" :question/problem "Evaluate the definite integral ${\\int }_{0}^{1/4}\\sqrt{8x+1}\\,\\text{d}x.$" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & =8x+1 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =8 \\\\ \\text{d}u & =8\\,\\text{d}x \\\\ \\frac{1}{8}\\text{d}u & =\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u=8x+1.$\n\n$$\n\\begin{aligned}x & 0 & \\frac{1}{4} \\\\ u & 1 & 3\\end{aligned}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{0}^{1/4}\\sqrt{8x+1}\\,\\text{d}x={\\int }_{1}^{3}\\sqrt{u}\\,\\cdot \\frac{1}{8}\\,\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}\\sqrt{u}\\,\\cdot \\frac{1}{8}\\,\\text{d}u & =\\frac{1}{8}{\\int }_{1}^{3}{u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{1}{8}\\cdot {\\frac{2}{3}{u}^{3/2}|}_{1}^{3} \\\\  & =\\frac{1}{8}\\cdot \\frac{2}{3}({3}^{3/2}-{1}^{3/2}) \\\\  & =\\frac{1}{12}({({3}^{3})}^{1/2}-1) \\\\  & =\\frac{1}{12}(3\\sqrt{3}-1).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332758 :knowledge-point/_questions [{:db/id #edb/ref 17592186064274 :knowledge-point/id #uuid "d3aaba0a-3b86-58c3-bbc8-22ced09bc8a8" :knowledge-point/title "Computing a Definite Integral Using Integration by Parts"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25e03bb2-38fd-590c-a711-0f08ab8bba0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1+{e}^{2}" :db/id #edb/ref 17592186330278} {:answer/id #uuid "9cfe119c-4c83-5685-9e72-3d7e3a36aafe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-3{e}^{2}" :db/id #edb/ref 17592186331355} {:answer/id #uuid "b81ff5e8-6e1a-5415-a73c-95423efd63bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2-{e}^{2}" :db/id #edb/ref 17592186331574} {:answer/id #uuid "d88e6b38-60e3-55a1-b267-396d75df9e52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1-{e}^{2}" :db/id #edb/ref 17592186331872} {:answer/id #uuid "e8104679-8097-5d99-8871-6a598728a76b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+{e}^{2}" :db/id #edb/ref 17592186331985}] :answer-field/correct {:answer/id #uuid "d88e6b38-60e3-55a1-b267-396d75df9e52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1-{e}^{2}" :db/id #edb/ref 17592186331872} :answer-field/id #uuid "a2900df1-3dd3-5e4a-bcd5-28bec34e44ec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332486}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "105b4be6-43d2-5e3c-baa6-177cc086c196" :question/math-academy-id "q-49660" :question/problem "Evaluate ${\\int }_{-2}^{0}x{e}^{-x}\\,\\text{d}x.$" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=x & ⇒ & {u}^{′}=1 \\\\ {v}^{′}={e}^{-x} & ⇒ & v=-{e}^{-x}.\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot {e}^{-x}\\,\\text{d}x & =x\\cdot (-{e}^{-x})-\\int (-{e}^{-x})\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{-2}^{0}x{e}^{-x}\\,\\text{d}x & =-x{e}^{-x}{|}_{-2}^{0}+{\\int }_{-2}^{0}{e}^{-x}\\,\\text{d}x \\\\  & =-x{e}^{-x}{|}_{-2}^{0}-{e}^{-x}{|}_{-2}^{0} \\\\  & =[-0{e}^{-0}-2{e}^{2}]-[{e}^{0}-{e}^{2}] \\\\  & =-2{e}^{2}-1+{e}^{2} \\\\  & =-1-{e}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332760 :knowledge-point/_questions [{:db/id #edb/ref 17592186064274 :knowledge-point/id #uuid "d3aaba0a-3b86-58c3-bbc8-22ced09bc8a8" :knowledge-point/title "Computing a Definite Integral Using Integration by Parts"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ac416bd-1ef2-598d-9769-0fc6af1898a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{3}" :db/id #edb/ref 17592186330183} {:answer/id #uuid "92f021d2-f657-568a-9458-97dc25ae2244" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186331255} {:answer/id #uuid "b1f49c5b-b91f-5372-945d-fd51d107045f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186331524} {:answer/id #uuid "bc706a10-6660-59a2-b283-dfcba28564b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186331611} {:answer/id #uuid "f6ff4fa6-edc2-533d-88c9-09406c898508" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186332119}] :answer-field/correct {:answer/id #uuid "b1f49c5b-b91f-5372-945d-fd51d107045f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186331524} :answer-field/id #uuid "e116d325-1e59-5f3b-b1ef-e63b4cf776b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332598}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b7d1b926-6342-572b-ba02-f2edcfbab3a9" :question/math-academy-id "q-49674" :question/problem "${\\int }_{-\\pi /4}^{\\pi /4}x\\operatorname{cos}⁡(2x)\\,\\text{d}x=$" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=x & ⇒ & {u}^{′}=1 \\\\ {v}^{′}=\\operatorname{cos}⁡(2x) & ⇒ & v=\\frac{\\operatorname{sin}⁡(2x)}{2}.\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot \\operatorname{cos}⁡(2x)\\,\\text{d}x & =x\\cdot \\frac{\\operatorname{sin}⁡(2x)}{2}-\\int (\\frac{\\operatorname{sin}⁡(2x)}{2})\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{-\\pi /4}^{\\pi /4}x\\operatorname{cos}⁡(2x)\\,\\text{d}x & ={\\frac{x\\operatorname{sin}⁡(2x)}{2}|}_{-\\pi /4}^{\\pi /4}-{\\int }_{-\\pi /4}^{\\pi /4}\\frac{\\operatorname{sin}⁡(2x)}{2}\\,\\text{d}x \\\\  & ={\\frac{1}{2}x\\operatorname{sin}⁡(2x)|}_{-\\pi /4}^{\\pi /4}+\\frac{1}{4}\\operatorname{cos}⁡(2x){|}_{-\\pi /4}^{\\pi /4} \\\\  & =\\frac{1}{2}[\\frac{\\pi }{4}\\operatorname{sin}⁡(\\frac{\\pi }{2})+\\frac{\\pi }{4}\\operatorname{sin}⁡(-\\frac{\\pi }{2})]+\\frac{1}{4}[\\operatorname{cos}⁡(\\frac{\\pi }{2})-\\operatorname{cos}⁡(-\\frac{\\pi }{2})] \\\\  & =\\frac{1}{2}[\\frac{\\pi }{4}-\\frac{\\pi }{4}]+\\frac{1}{4}[0-0] \\\\  & =\\frac{1}{2}[0]+0 \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332762 :knowledge-point/_questions [{:db/id #edb/ref 17592186064274 :knowledge-point/id #uuid "d3aaba0a-3b86-58c3-bbc8-22ced09bc8a8" :knowledge-point/title "Computing a Definite Integral Using Integration by Parts"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ecbfbfa-cec6-5df3-a0c9-e11c1f67b71c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e+1}{4}" :db/id #edb/ref 17592186330075} {:answer/id #uuid "4f85b6ee-800b-57ab-a844-ec6e2709c11a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e}{2}+1" :db/id #edb/ref 17592186330672} {:answer/id #uuid "80f169d6-295c-563d-8914-8d2bd9999054" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e}{4}" :db/id #edb/ref 17592186331093} {:answer/id #uuid "ba59d7eb-18ba-53f2-95b6-75daba77e7da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186331594} {:answer/id #uuid "dc1d4456-3d28-5aa2-8934-92baec9cfff7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186331900}] :answer-field/correct {:answer/id #uuid "ba59d7eb-18ba-53f2-95b6-75daba77e7da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186331594} :answer-field/id #uuid "6a4db82c-4c9f-5857-a947-4a090d21993d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332395}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "622f5ee2-fdb3-59b2-9462-4de78b4bcda0" :question/math-academy-id "q-49677" :question/problem "Evaluate the integral  ${\\int }_{0}^{1/2}x{e}^{2x}\\,\\text{d}x.$" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=x & ⇒ & {u}^{′}=1 \\\\ {v}^{′}={e}^{2x} & ⇒ & v=\\frac{{e}^{2x}}{2}.\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot {e}^{2x}\\,\\text{d}x & =x\\cdot \\frac{{e}^{2x}}{2}-\\int \\frac{{e}^{2x}}{2}\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1/2}x{e}^{2x}\\,\\text{d}x & =\\frac{1}{2}(x{e}^{2x}){|}_{0}^{1/2}-\\frac{1}{2}{\\int }_{0}^{1/2}{e}^{2x}\\,\\text{d}x \\\\  & =\\frac{1}{2}(x{e}^{2x}){|}_{0}^{1/2}-\\frac{{e}^{2x}}{4}{|}_{0}^{1/2} \\\\  & =\\frac{1}{2}[\\frac{1}{2}{e}^{2(1/2)}-0\\cdot {e}^{2\\cdot 0}]-\\frac{1}{4}[{e}^{2(1/2)}-{e}^{2\\cdot 0}] \\\\  & =\\frac{1}{2}[\\frac{e}{2}-0]-\\frac{1}{4}[e-1] \\\\  & =\\frac{e}{4}-\\frac{e-1}{4} \\\\  & =\\frac{e-e+1}{4} \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332767 :knowledge-point/_questions [{:db/id #edb/ref 17592186096627 :knowledge-point/id #uuid "5c6490a5-4923-58e8-99c3-d568a033800e" :knowledge-point/title "Computing Coefficients in a Partial Fractions Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "330a0cea-faa6-57bb-b3e5-4969b5fdd1ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186330400} {:answer/id #uuid "3da03412-73b5-594f-afec-f4a655d69911" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186330493} {:answer/id #uuid "b2d3c0c4-2856-57fa-aeac-55834fa98d0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186331527} {:answer/id #uuid "de661295-33a7-50e8-bac7-466fd0056a16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186331917} {:answer/id #uuid "f85114ff-ac41-57f6-b9d8-b2aed5a7c88c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186332132}] :answer-field/correct {:answer/id #uuid "f85114ff-ac41-57f6-b9d8-b2aed5a7c88c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186332132} :answer-field/id #uuid "6cf40983-719d-5db1-8eb8-1d9071961167" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332401}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "55b8112f-d856-573e-9f5b-c1d8db09874e" :question/math-academy-id "q-49723" :question/problem "Given that\n\n$$\n\\frac{7x}{({x}^{2}+3)(x-2)}=\\frac{Ax+B}{{x}^{2}+3}+\\frac{C}{x-2},\n$$\n\nwhere $A,$ $B$ and $C$ are real constants, determine the value of $A+B+C.$" :question/worked-solution "We multiply both sides of the given equality by $({x}^{2}+3)(x-2)$ and get\n\n$$\n7x=(Ax+B)(x-2)+C({x}^{2}+3).\n$$\n\nPlugging in $x=2$ eliminates the $A$ and $B$ terms and allows us to solve for $C.$ We get\n\n$$\n\\begin{aligned}7(2) & =(A(2)+B)(2-2)+C({2}^{2}+3) \\\\ 14 & =7C \\\\ C & =2.\\end{aligned}\n$$\n\nPlugging in $x=0$ eliminates the $A$ term, and using our result for $C$ allows us to solve for $B.$ We get\n\n$$\n\\begin{aligned}7(0) & =(A(0)+B)(0-2)+(2)({0}^{2}+3) \\\\ 0 & =-2B+6 \\\\ 2B & =6 \\\\ B & =3.\\end{aligned}\n$$\n\nFinally, to solve for $A,$ we choose $x=1$ and use our results for $B$ and $C.$ We get\n\n$$\n\\begin{aligned}7(1) & =(A(1)+3)(1-2)+(2)({1}^{2}+3) \\\\ 7 & =(A+3)(-1)+8 \\\\ 7 & =-A+5 \\\\ A & =-2.\\end{aligned}\n$$\n\nSo we have $A=-2,$ $B=3,$ and $C=2.$ Therefore, our final result is\n\n$$\nA+B+C=-2+3+2=3.\n$$"}] [{:db/id #edb/ref 17592186332769 :knowledge-point/_questions [{:db/id #edb/ref 17592186100917 :knowledge-point/id #uuid "37e00ff7-a91e-5b56-9f3a-24e7318cf004" :knowledge-point/title "Determining the Convergence Sequences Containing Power and Logarithmic Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3600375c-6616-5cea-9dbb-06d93d322153" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186330432} {:answer/id #uuid "4f160d4c-6ac6-5cb3-9501-4b70dae49244" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186330668} {:answer/id #uuid "874bf0d8-e732-5738-a6f8-43214bd49daa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186331158} {:answer/id #uuid "a2d1fbe3-8070-5dff-b33a-01d398ee45e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186331411} {:answer/id #uuid "c89fa789-fa91-5256-b87a-54f50dc91609" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186331726}] :answer-field/correct {:answer/id #uuid "a2d1fbe3-8070-5dff-b33a-01d398ee45e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186331411} :answer-field/id #uuid "717b7e5f-5a3f-51d8-bc85-2eb60331d441" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332408}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "35ad8649-a1a5-5a33-9485-b718f80b516f" :question/math-academy-id "q-49727" :question/problem "What is the limit of the sequence ${a}_{n}=\\frac{{log}_{2}⁡n}{n+2}$ for $n\\ge 1?$" :question/worked-solution "Recall that for large values of $n,$ we have\n\n$$\nn!≫{e}^{n}≫{n}^{m}≫\\operatorname{ln}⁡(n),\n$$\n\nwhere $≫$ means \"much greater than,\" and $m>0.$\n\nWe calculate the limit of the sequence as $n$ approaches at infinity,\n\n$$\n{lim}_{n\\to \\infty }{a}_{n}={lim}_{n\\to \\infty }\\frac{{log}_{2}⁡n}{n+2}.\n$$\n\nBoth the numerator and denominator approach infinity as $n\\to \\infty .$ However, the denominator is growing much faster than the numerator, and we conclude that\n\n$$\n{lim}_{n\\to \\infty }\\frac{{log}_{2}⁡n}{n+2}=0.\n$$\n\nTherefore, the sequence converges,  and its limit is $0.$"}] [{:db/id #edb/ref 17592186069392 :knowledge-point/_questions [{:db/id #edb/ref 17592186068770 :knowledge-point/id #uuid "e016cedd-0206-555c-8934-c6d19566d547" :knowledge-point/title "Expressing the Area Between Two Curves as an Integral by First Solving For the Limits of Integration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15767782-c1d6-56ec-af3c-2af319686c92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-5}^{2}(2-{x}^{2}-4x)\\text{d}x" :db/id #edb/ref 17592186330120} {:answer/id #uuid "462296a9-9e1d-5085-a0bb-1300fc95aa23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{2/5}(2-{x}^{2}-4x)\\text{d}x" :db/id #edb/ref 17592186330582} {:answer/id #uuid "49a442a4-907a-5786-a7be-8734fb8e39a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{2/5}(-5{x}^{2}-3x+2)\\text{d}x" :db/id #edb/ref 17592186330610} {:answer/id #uuid "5a3529e2-0165-5f03-afeb-ceacbcfcc974" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-5}^{2}(4{x}^{2}-x)\\text{d}x" :db/id #edb/ref 17592186330756} {:answer/id #uuid "a3120433-297a-57fc-bcc7-752c0cd6cd99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{2/5}(4{x}^{2}-x)\\text{d}x" :db/id #edb/ref 17592186331412}] :answer-field/correct {:answer/id #uuid "49a442a4-907a-5786-a7be-8734fb8e39a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{2/5}(-5{x}^{2}-3x+2)\\text{d}x" :db/id #edb/ref 17592186330610} :answer-field/id #uuid "0fa2bf10-dcb3-5e3c-8f33-8c714e66943e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332219}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d663ded3-4e3e-5b80-80de-bcbc2d02a27f" :question/math-academy-id "q-49885" :question/problem "Which integral gives the area of the finite region bounded by $y=4{x}^{2}-x$ and $y=2-{x}^{2}-4x?$" :question/requires-calculator true :question/worked-solution "First, let's draw a sketch of the two functions.\n\n![](images/91/913ec93445f3ed571fcf98ad762eba2a1bc657dce7442c8e48fc4d5f36817def.png)\n\n*(Note: Figure not drawn to scale)*\n\nNow, we want to determine the limits of integration. To do this, we equate the two functions and solve for $x:$\n\n$$\n\\begin{aligned}4{x}^{2}-x & =2-{x}^{2}-4x \\\\ 5{x}^{2}+3x-2 & =0 \\\\ x & =\\frac{-3\\pm \\sqrt{{3}^{2}-4\\cdot 5\\cdot (-2)}}{2\\cdot 5} \\\\  & =\\frac{-3\\pm 7}{10}\\end{aligned}\n$$\n\nHence, we need to integrate from $x=-1$ to $x=\\frac{2}{5}.$\n\nTo determine which is the lower function and which is the upper, let's draw our vertical arrow.\n\n![](images/77/77493917a13269c78acef8ff6fe57b5f350020542805e316f82f7a17dabedd24.png)\n\nThe vertical line \n\n- *enters* the region through the lower function $y=4{x}^{2}-x,$ and\n\n- *leaves* through the upper function $y=2-{x}^{2}-4x.$\n\nTherefore, the integral that gives our area is\n\n$$\n\\begin{aligned}A & ={\\int }_{-1}^{2/5}[\\,(\\text{upper function})-(\\text{lower function})\\,]\\,\\text{d}x \\\\  & ={\\int }_{-1}^{2/5}[\\,(2-{x}^{2}-4x)-(4{x}^{2}-x)\\,]\\text{d}x \\\\  & ={\\int }_{-1}^{2/5}(-5{x}^{2}-3x+2)\\text{d}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332784 :knowledge-point/_questions [{:db/id #edb/ref 17592186068743 :knowledge-point/id #uuid "05dd17d8-4170-5392-89e7-7547184b8556" :knowledge-point/title "Integrating Rational Functions With Repeated Factors of Degree Two"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bb523f6-337d-517c-a2e0-1ae2643cab5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{ln}⁡3+6" :db/id #edb/ref 17592186330192} {:answer/id #uuid "475c65c1-db8e-5275-9e24-86f4e13e330a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\operatorname{ln}⁡2-2" :db/id #edb/ref 17592186330593} {:answer/id #uuid "8a7c503b-c042-5870-ab52-c9e84dc594fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡2+4" :db/id #edb/ref 17592186331180} {:answer/id #uuid "9a0ffc0e-686f-5268-9425-c55b0fcb8ffd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\operatorname{ln}⁡5+4" :db/id #edb/ref 17592186331332} {:answer/id #uuid "c8512e2d-a2c6-5eea-98b8-e618ad907ddf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3-1" :db/id #edb/ref 17592186331722}] :answer-field/correct {:answer/id #uuid "8a7c503b-c042-5870-ab52-c9e84dc594fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡2+4" :db/id #edb/ref 17592186331180} :answer-field/id #uuid "110a7998-6b53-557c-88e4-37cc3407f3a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332220}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e05f40f4-bb40-5adb-aa19-6a15bedeece9" :question/math-academy-id "q-49902" :question/problem "Evaluate ${\\int }_{3}^{4}\\frac{4x}{(x-2)^{2}}\\text{d}x.$" :question/worked-solution "First, we convert the integrand into a sum of partial fractions:\n\n$$\n\\begin{aligned}\\frac{4x}{(x-2)^{2}} & =\\frac{A}{(x-2)}+\\frac{B}{(x-2)^{2}}\\end{aligned}\n$$\n\nTo determine the coefficients $A,$ and $B,$ we first multiply both sides of the above equation by $(x-2)^{2}$ and get\n\n$$\n4x=A(x-2)+B.\n$$\n\nPlugging in $x=2,$ we can eliminate $A$ and solve for $B:$\n\n$$\n\\begin{aligned}4(2) & =A(2-2)+B \\\\ 8 & =0+B \\\\ B & =8\\end{aligned}\n$$\n\nNow, plugging in $x=0$ and substituting the known value of $B,$ we can solve for $A:$\n\n$$\n\\begin{aligned}4(0) & =A(0-2)+B \\\\ 0 & =-2A+B \\\\ 0 & =-2A+8 \\\\ A & =\\frac{8}{2} \\\\ A & =4\\end{aligned}\n$$\n\nTherefore, we can write the integrand as the partial sum\n\n$$\n\\frac{4x}{(x-2)^{2}}=\\frac{4}{(x-2)}+\\frac{8}{(x-2)^{2}}.\n$$\n\nFinally, we integrate this expression term by term to get\n\n$$\n\\begin{aligned}{\\int }_{3}^{4}\\frac{4x}{(x-2)^{2}}\\,\\text{d}x & ={\\int }_{3}^{4}(\\frac{4}{(x-2)}+\\frac{8}{(x-2)^{2}})\\,\\text{d}x \\\\  & =4{\\int }_{3}^{4}\\frac{1}{x-2}\\,\\text{d}x+8{\\int }_{3}^{4}\\frac{1}{(x-2)^{2}}\\,\\text{d}x \\\\  & =4\\operatorname{ln}⁡|x-2|{|}_{3}^{4}+8(-\\frac{1}{x-2}){|}_{3}^{4} \\\\  & =4(\\operatorname{ln}⁡|4-2|-\\operatorname{ln}⁡|3-2|)+8(-\\frac{1}{4-2}+\\frac{1}{3-2}) \\\\  & =4(\\operatorname{ln}⁡|4-2|-\\operatorname{ln}⁡|3-2|)+8(\\frac{1}{2}) \\\\  & =4\\operatorname{ln}⁡2+4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069397 :knowledge-point/_questions [{:db/id #edb/ref 17592186068716 :knowledge-point/id #uuid "3c22b8e9-049a-5574-86c9-35788c410421" :knowledge-point/title "Integrating a Rational Function With an Irreducible Binomial Quadratic Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18cf8091-e95f-5a3e-91c9-637550a5d656" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{ln}⁡|x-1|-\\frac{1}{4}\\operatorname{ln}⁡({x}^{2}+1)+\\operatorname{arctan}⁡x+K" :db/id #edb/ref 17592186330160} {:answer/id #uuid "307c0655-7046-513b-9027-a26e8a039b85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|x-1|-\\operatorname{ln}⁡({x}^{2}+1)+K" :db/id #edb/ref 17592186330376} {:answer/id #uuid "7ed5de4a-6322-595e-96d5-d08a99d6bcb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡|x-1|+\\operatorname{ln}⁡({x}^{2}+1)+\\operatorname{arctan}⁡x+K" :db/id #edb/ref 17592186331068} {:answer/id #uuid "819a7980-eb5f-5144-bd32-35450b9696a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{ln}⁡|x-1|+2\\operatorname{ln}⁡({x}^{2}+1)-\\operatorname{arctan}⁡x+K" :db/id #edb/ref 17592186331097} {:answer/id #uuid "f00ee12b-a02d-5cce-975e-e9d0c11771ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|x-1|-\\frac{1}{2}\\operatorname{ln}⁡({x}^{2}+1)-\\operatorname{arctan}⁡x+K" :db/id #edb/ref 17592186332061}] :answer-field/correct {:answer/id #uuid "f00ee12b-a02d-5cce-975e-e9d0c11771ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|x-1|-\\frac{1}{2}\\operatorname{ln}⁡({x}^{2}+1)-\\operatorname{arctan}⁡x+K" :db/id #edb/ref 17592186332061} :answer-field/id #uuid "ab9021bd-ffa0-5426-993e-de80eba89205" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332499}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d605be2d-ae71-5e50-9bf1-07465ceead87" :question/math-academy-id "q-49919" :question/problem "Evaluate $\\int \\frac{2}{(x-1)({x}^{2}+1)}\\,\\text{d}x.$" :question/requires-calculator true :question/worked-solution "The quadratic factor ${x}^{2}+1$ is irreducible, so we proceed with the following partial fraction decomposition:\n\n$$\n\\frac{2}{(x-1)({x}^{2}+1)}=\\frac{A}{x-1}+\\frac{Bx+C}{{x}^{2}+1}.\n$$\n\nTo determine the coefficients $A,B,$ and $C,$ we first multiply both sides of the above equation by $(x-1)({x}^{2}+1),$ and we get\n\n$$\n2=A({x}^{2}+1)+(Bx+C)(x-1).\n$$\n\nSolving for the unknown constants using the usual methods, we get $A=1,B=-1,$ and $C=-1.$ Therefore,\n\n$$\n\\frac{2}{(x-1)({x}^{2}+1)}=\\frac{1}{x-1}+\\frac{-x-1}{{x}^{2}+1}.\n$$\n\nWe now integrate this function term by term, adding the constant of integration at the very end.\n\n$$\n\\begin{aligned}\\int \\frac{2}{(x-1)({x}^{2}+1)}\\,\\text{d}x & =\\int (\\frac{1}{x-1}+\\frac{-x-1}{{x}^{2}+1})\\,\\text{d}x \\\\  & =\\int \\frac{1}{x-1}\\,\\text{d}x-\\int \\frac{x}{{x}^{2}+1}\\,\\text{d}x-\\int \\frac{1}{{x}^{2}+1}\\,\\text{d}x\\end{aligned}\n$$\n\nFor the first integral, we have\n\n$$\n\\int \\frac{1}{x-1}\\,\\text{d}x=\\operatorname{ln}⁡|x-1|.\n$$\n\nFor the second integral, we use the substitution $u={x}^{2}+1.$ Then $\\text{d}u=2x\\,\\text{d}x,$ and we get\n\n$$\n\\begin{aligned}\\int \\frac{x}{{x}^{2}+1}\\,\\text{d}x & =\\int (\\frac{1}{u})\\frac{\\text{d}u}{2} \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|u| \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|{x}^{2}+1| \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡({x}^{2}+1)\\,.\\end{aligned}\n$$\n\nFinally, for the third integral, we use the fact that $\\int \\frac{1}{{x}^{2}+{a}^{2}}\\,\\text{d}x=\\frac{1}{a}\\operatorname{arctan}⁡(\\frac{x}{a}),$ which results in\n\n$$\n\\int \\frac{1}{{x}^{2}+1}\\,\\text{d}x=\\operatorname{arctan}⁡x.\n$$\n\nSo, we get the following result:\n\n$$\n\\begin{aligned}\\int \\frac{2}{(x-1)({x}^{2}+1)}\\,\\text{d}x & =\\int \\frac{1}{x-1}\\,\\text{d}x-\\int \\frac{x}{{x}^{2}+1}\\,\\text{d}x-\\int \\frac{1}{{x}^{2}+1}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡|x-1|-\\frac{1}{2}\\operatorname{ln}⁡({x}^{2}+1)-\\operatorname{arctan}⁡x+K\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332789 :knowledge-point/_questions [{:db/id #edb/ref 17592186068855 :knowledge-point/id #uuid "db6e4cf3-803a-5942-9ce0-7047942e078a" :knowledge-point/title "Computing an Arcsine Integral by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35ceb9bc-32d1-5e15-a733-fddde56fa205" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{arcsin}⁡(\\frac{x-3}{\\sqrt{11}})+C" :db/id #edb/ref 17592186330430} {:answer/id #uuid "3814f410-4692-533f-ab4d-9fc4e28c8766" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{3}}\\operatorname{arcsin}⁡(\\frac{x+3}{11})+C" :db/id #edb/ref 17592186330449} {:answer/id #uuid "402c58c4-6fc4-5b10-b233-048c89f390b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{33}}\\operatorname{arcsin}⁡(x+3)+C" :db/id #edb/ref 17592186330522} {:answer/id #uuid "4edd4e6d-9d85-570a-818c-e40797a3d8e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{3}}\\operatorname{arcsin}⁡(\\frac{x+3}{\\sqrt{11}})+C" :db/id #edb/ref 17592186330666} {:answer/id #uuid "6fcef366-c806-5aba-853e-73a4a9c9ca91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{11}\\operatorname{arcsin}⁡(\\frac{x+11}{\\sqrt{3}})+C" :db/id #edb/ref 17592186330953}] :answer-field/correct {:answer/id #uuid "4edd4e6d-9d85-570a-818c-e40797a3d8e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{3}}\\operatorname{arcsin}⁡(\\frac{x+3}{\\sqrt{11}})+C" :db/id #edb/ref 17592186330666} :answer-field/id #uuid "3df9f5da-1d1a-5b9b-a71c-2f5dea7ce56e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332305}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9d8b04a6-d5ee-5401-b693-4f822d6507a5" :question/math-academy-id "q-49934" :question/problem "$\\int \\frac{1}{\\sqrt{-3{x}^{2}-18x+6}}\\,\\text{d}x=$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}-3{x}^{2}-18x+6 & =-3({x}^{2}+6x-2) \\\\  & =-3({x}^{2}+2\\cdot 3x+[{3}^{2}-{3}^{2}]-2) \\\\  & =-3({(x+3)}^{2}-11) \\\\  & =3(11-{(x+3)}^{2})\\end{aligned}\n$$\n\nSubstituting the above in the given integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{-3{x}^{2}-18x+6}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{3(11-{(x+3)}^{2})}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{33(1-(x+3)^{2}/11)}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{33}\\cdot \\sqrt{1-(x+3)^{2}/11}}\\,\\text{d}x \\\\  & =\\frac{1}{\\sqrt{33}}\\int \\frac{1}{\\sqrt{1-((x+3)/\\sqrt{11})^{2}}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse sine:\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(\\frac{x+3}{\\sqrt{11}}).$  \n\nSo, let's perform the substitution\n\n$$\nu=\\frac{x+3}{\\sqrt{11}}.\n$$\n\nDifferentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{\\sqrt{11}}\\,⟹\\,\\text{d}x=\\sqrt{11}\\,\\text{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{-3{x}^{2}-18x+6}}\\,\\text{d}x & =\\frac{1}{\\sqrt{33}}\\int \\frac{1}{\\sqrt{1-((x+3)/\\sqrt{11})^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{\\sqrt{33}}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot \\sqrt{11}\\,\\text{d}u \\\\  & =\\frac{1}{\\sqrt{3}}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\frac{1}{\\sqrt{3}}\\operatorname{arcsin}⁡u+C \\\\  & =\\frac{1}{\\sqrt{3}}\\operatorname{arcsin}⁡(\\frac{x+3}{\\sqrt{11}})+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332792 :knowledge-point/_questions [{:db/id #edb/ref 17592186068801 :knowledge-point/id #uuid "d1da25ef-5d1b-588f-b1cc-121562ff98ea" :knowledge-point/title "Finding the Definite Integral of a Exponential-Trigonometric Expression Using Integration by Parts"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "022ef44a-f614-5f77-b7e2-557109b501db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10({e}^{6\\pi }-1)" :db/id #edb/ref 17592186329981} {:answer/id #uuid "8742e199-0ed1-50dc-9302-78ef51c46417" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{6\\pi }-1" :db/id #edb/ref 17592186331156} {:answer/id #uuid "8d92ec7b-74b7-5c7d-9500-11ccb93e48fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2\\pi }+1" :db/id #edb/ref 17592186331206} {:answer/id #uuid "c3b81776-68f2-5cff-99ae-6539316265be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{10}({e}^{6\\pi }-1)" :db/id #edb/ref 17592186331688} {:answer/id #uuid "f9bc2eda-c095-51f8-ae6e-c8565f7e54e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}({e}^{6\\pi }+1)" :db/id #edb/ref 17592186332142}] :answer-field/correct {:answer/id #uuid "c3b81776-68f2-5cff-99ae-6539316265be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{10}({e}^{6\\pi }-1)" :db/id #edb/ref 17592186331688} :answer-field/id #uuid "1154688a-787f-51c1-bf1f-2ddfd1ba7f5f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332221}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d7c6d678-a2a1-540c-89d9-058ea3cefa9f" :question/math-academy-id "q-49967" :question/problem "Evaluate ${\\int }_{0}^{2\\pi }{e}^{3x}\\operatorname{cos}⁡x\\,\\text{d}x.$" :question/worked-solution "Let's denote the indefinite integral by $I=\\int {e}^{3x}\\operatorname{cos}⁡x\\,\\text{d}x.$\n\nTo use integration by parts, let's suppose that \n\n$$\n\\begin{aligned}u={e}^{3x}\\, & ⇒\\,\\frac{\\text{d}u}{\\text{d}x}=3{e}^{3x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡x\\, & ⇒\\,v=\\int \\operatorname{cos}⁡x\\,\\text{d}x=\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nThen, using the formula of integration by parts, we get\n\n$$\n\\begin{aligned}I & =\\int {e}^{3x}\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={e}^{3x}\\operatorname{sin}⁡x-\\int (\\operatorname{sin}⁡x)(3{e}^{3x})\\text{d}x \\\\  & ={e}^{3x}\\operatorname{sin}⁡x-3\\int {e}^{3x}\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & ={e}^{3x}\\operatorname{sin}⁡x-3J.\\end{aligned}\n$$\n\nAgain, we can use integration by parts to evaluate\n\n$$\nJ=\\int {e}^{3x}\\operatorname{sin}⁡x\\,\\text{d}x.\n$$\n\nTo do this, let's suppose that\n\n$$\n\\begin{aligned}u={e}^{3x}\\, & ⇒\\,\\frac{\\text{d}u}{\\text{d}x}=3{e}^{3x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡x\\, & ⇒\\,v=\\int \\operatorname{sin}⁡x\\,\\text{d}x=-\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}J & =\\int {e}^{3x}\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={e}^{3x}(-\\operatorname{cos}⁡x)-\\int (-\\operatorname{cos}⁡x)(3{e}^{3x})\\text{d}x \\\\  & =-{e}^{3x}\\operatorname{cos}⁡x+3\\int {e}^{3x}\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =-{e}^{3x}\\operatorname{cos}⁡x+3I.\\end{aligned}\n$$\n\nSo, substituting this into our equation for $I,$ we can subsequently solve for $I:$\n\n$$\n\\begin{aligned}I & ={e}^{3x}\\operatorname{sin}⁡x-3J \\\\ I & ={e}^{3x}\\operatorname{sin}⁡x-3(-{e}^{3x}\\operatorname{cos}⁡x+3I) \\\\ I & ={e}^{3x}\\operatorname{sin}⁡x+3{e}^{3x}\\operatorname{cos}⁡x-9I \\\\ 10I & ={e}^{3x}\\operatorname{sin}⁡x+3{e}^{3x}\\operatorname{cos}⁡x \\\\ I & =\\frac{{e}^{3x}(\\operatorname{sin}⁡x+3\\operatorname{cos}⁡x)}{10}\\end{aligned}\n$$\n\nFinally, we evaluate our definite integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2\\pi }{e}^{3x}\\operatorname{cos}⁡x\\,\\text{d}x & =(\\frac{{e}^{3x}(\\operatorname{sin}⁡x+3\\operatorname{cos}⁡x)}{10}){|}_{0}^{2\\pi } \\\\  & =\\frac{{e}^{3(2\\pi )}(\\operatorname{sin}⁡(2\\pi )+3\\operatorname{cos}⁡(2\\pi ))}{10}-\\frac{{e}^{3(0)}(\\operatorname{sin}⁡(0)+3\\operatorname{cos}⁡(0))}{10} \\\\  & =\\frac{3{e}^{6\\pi }}{10}-\\frac{3}{10} \\\\  & =\\frac{3}{10}({e}^{6\\pi }-1)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332794 :knowledge-point/_questions [{:db/id #edb/ref 17592186068778 :knowledge-point/id #uuid "8fb50541-88df-5f3f-b9e0-cf51edae401e" :knowledge-point/title "Calculating the Derivative of a Parametric Curve at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "341bbdfc-0958-57c4-a8fc-adcfd2832b27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186330412} {:answer/id #uuid "3a4eb11e-164a-505d-8222-3a3c8cc2aa8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186330473} {:answer/id #uuid "5173e85f-be65-57f7-b4ad-50a4243824a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186330686} {:answer/id #uuid "900d9ce2-2884-5941-890f-cca5011570ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186331231} {:answer/id #uuid "e1a39abd-a637-559d-b40e-9331517387e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186331945}] :answer-field/correct {:answer/id #uuid "e1a39abd-a637-559d-b40e-9331517387e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186331945} :answer-field/id #uuid "99a69d51-520e-57bf-a0e9-67ec91b1dca0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332471}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "defadd51-e009-5740-8eb4-1acd4e92eb56" :question/math-academy-id "q-50018" :question/problem "A curve has parametric equations $x=2\\operatorname{cos}⁡(2t),\\,y=\\operatorname{sin}⁡(2t).$ Given that $\\frac{\\text{d}y}{\\text{d}x}=-\\frac{1}{2}\\operatorname{cot}⁡(2t),$ calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ at the point where $t=\\frac{\\pi }{12}.$" :question/worked-solution "To compute $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}},$ we can use the formula\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(\\frac{dy}{dx})}{(\\frac{dx}{dt})}.\\end{aligned}\n$$\n\nWe're given that $\\frac{dy}{dx}=-\\frac{1}{2}\\operatorname{cot}⁡(2t),$ and we can calculate $\\frac{dx}{dt}$ as follows:\n\n$$\n\\frac{dx}{dt}=\\frac{d}{dt}(2\\operatorname{cos}⁡(2t))=-4\\operatorname{sin}⁡(2t).\n$$\n\nSubstituting into the formula, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(-\\frac{1}{2}\\operatorname{cot}⁡(2t))}{-4\\operatorname{sin}⁡(2t)} \\\\  & =\\frac{{csc}^{2}⁡(2t)}{-4\\operatorname{sin}⁡(2t)} \\\\  & =-\\frac{1}{4}{csc}^{3}⁡(2t).\\end{aligned}\n$$\n\nFinally, we evaluate at $t=\\frac{\\pi }{12},$ and we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}{|}_{t=\\pi /12} & =-\\frac{1}{4}{csc}^{3}⁡(2\\cdot \\frac{\\pi }{12}) \\\\  & =-\\frac{1}{4{sin}^{3}⁡(\\frac{\\pi }{6})} \\\\  & =-\\frac{1}{4\\cdot {(\\frac{1}{2})}^{3}} \\\\  & =-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186392702 :knowledge-point/_questions [{:db/id #edb/ref 17592186096838 :knowledge-point/id #uuid "53fca396-4ade-5180-9c9b-a73f24f5b5b8" :knowledge-point/title "Integrating a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b57c80e-0581-56ac-b708-9d57640b62b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-{e}^{-t},\\,\\operatorname{tan}⁡t⟩+C" :db/id #edb/ref 17592186392704} {:answer/id #uuid "845c34dc-7482-5f11-87ee-30901151f31a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-{e}^{-t},\\,\\operatorname{sec}⁡t⟩+C" :db/id #edb/ref 17592186392705} {:answer/id #uuid "bc3ea727-3517-5f04-8d7e-464c04d8e2d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨{e}^{t},\\,-\\operatorname{tan}⁡t⟩+C" :db/id #edb/ref 17592186392706} {:answer/id #uuid "dffcd8da-e6c6-5ed5-9fd1-ef8f09f0306d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨{e}^{-t},\\,\\operatorname{csc}⁡t⟩+C" :db/id #edb/ref 17592186392707} {:answer/id #uuid "6ad47653-1321-5c97-9829-ac76a6e58608" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨{e}^{t},\\,\\operatorname{sec}⁡t⟩+C" :db/id #edb/ref 17592186392708}] :answer-field/correct {:answer/id #uuid "845c34dc-7482-5f11-87ee-30901151f31a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-{e}^{-t},\\,\\operatorname{sec}⁡t⟩+C" :db/id #edb/ref 17592186392705} :answer-field/id #uuid "2c12cc4e-2a47-547f-be95-4a730c2736b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392703}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a4e000d9-7155-5530-bc95-f9ed61c5c6a7" :question/math-academy-id "q-50078" :question/problem "$\\int ⟨{e}^{-t},\\operatorname{tan}⁡t\\operatorname{sec}⁡t⟩\\,\\text{d}t=$" :question/worked-solution "To integrate a vector-valued function, we integrate each component separately:\n\n$$\n\\begin{aligned}\\int ⟨{e}^{-t},\\operatorname{tan}⁡t\\operatorname{sec}⁡t⟩\\,\\text{d}t & =⟨\\int {e}^{-t}\\,\\text{d}t,\\int \\operatorname{tan}⁡t\\operatorname{sec}⁡t\\,\\text{d}t⟩ \\\\  & =⟨-{e}^{-t}+{c}_{1},\\,\\operatorname{sec}⁡t+{c}_{2}⟩ \\\\  & =⟨-{e}^{-t},\\,\\operatorname{sec}⁡t⟩+⟨{c}_{1},\\,{c}_{2}⟩ \\\\  & =⟨-{e}^{-t},\\,\\operatorname{sec}⁡t⟩+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069406 :knowledge-point/_questions [{:db/id #edb/ref 17592186068857 :knowledge-point/id #uuid "d59ccd52-63db-5d28-b78b-2df7caf52ad0" :knowledge-point/title "Evaluating a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39e6432f-a463-5ebb-bb92-52799b1a0f59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨4,\\,24⟩" :db/id #edb/ref 17592186330470} {:answer/id #uuid "4613b143-151f-5134-8b3e-f177db13f1ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186330579} {:answer/id #uuid "b9ac4627-dbb1-5487-93b8-0fed200bbc4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨4,\\,16⟩" :db/id #edb/ref 17592186331591} {:answer/id #uuid "d1fde79d-cd27-583d-ba31-3b60f8bec0ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨4,\\,8⟩" :db/id #edb/ref 17592186331812} {:answer/id #uuid "eabdbf2a-8d6e-51a4-8a70-2c9eb803c83e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨4,\\,12⟩" :db/id #edb/ref 17592186332007}] :answer-field/correct {:answer/id #uuid "39e6432f-a463-5ebb-bb92-52799b1a0f59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨4,\\,24⟩" :db/id #edb/ref 17592186330470} :answer-field/id #uuid "a20b574a-7226-5977-8872-108f615b7c6e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332483}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a3b2939c-ae68-5c6a-8f8f-be58968873ca" :question/math-academy-id "q-50083" :question/problem "Given that $r(t)=⟨{t}^{2},\\,3{t}^{3}⟩,$ calculate $r(2).$" :question/worked-solution "We  substitute $t=2$ into our function, and we get\n\n$$\n\\begin{aligned}r(2) & =⟨{2}^{2},\\,3\\cdot {2}^{3}⟩ \\\\  & =⟨4,\\,24⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186097299 :knowledge-point/_questions [{:db/id #edb/ref 17592186096696 :knowledge-point/id #uuid "f570287d-b0e4-53bb-8fa1-37348ca9202f" :knowledge-point/title "Finding the General Solution of a Differential Equation Using Integration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07a181c2-eaa7-54a0-8890-e935b4d4ff1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2{e}^{2x}-2{x}^{2}+C" :db/id #edb/ref 17592186330015} {:answer/id #uuid "15c676e1-03b3-5352-b3b8-1386a7ac7b2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2{e}^{2x}-{x}^{2}+C" :db/id #edb/ref 17592186330129 :task-item/_responses [{:db/id #edb/ref 17592186409303}]} {:answer/id #uuid "c78be5e7-440c-5080-aede-7717891b5955" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-{e}^{2x}-{x}^{2}+C" :db/id #edb/ref 17592186331715} {:answer/id #uuid "cdb467dd-d851-57e6-ba23-4d6c40542276" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-{e}^{2x}-2{x}^{2}+C" :db/id #edb/ref 17592186331773} {:answer/id #uuid "fd0ac1c2-8887-5016-9ea9-5bc26155b0dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-4{e}^{2x}-2{x}^{2}+C" :db/id #edb/ref 17592186332172}] :answer-field/correct {:answer/id #uuid "15c676e1-03b3-5352-b3b8-1386a7ac7b2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2{e}^{2x}-{x}^{2}+C" :db/id #edb/ref 17592186330129} :answer-field/id #uuid "7491e487-3ec6-578a-921d-573211c3741a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332412}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cb82aa2f-3e4a-523a-94c2-c95aa3cb8ffa" :question/math-academy-id "q-50136" :question/problem "Solve the differential equation $\\frac{\\text{d}y}{\\text{d}x}+4{e}^{2x}=-2x.$" :question/worked-solution "First, we rearrange the equation to isolate the derivative term:\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-4{e}^{2x}-2x.\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (-4{e}^{2x}-2x)\\,\\text{d}x \\\\ y & =\\int (-4{e}^{2x}-2x)\\,\\text{d}x\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}\\begin{aligned}y & =\\int (-4{e}^{2x}-2x)\\,\\text{d}x \\\\  & =-4\\int {e}^{2x}\\,\\text{d}x-2\\int x\\,\\text{d}x \\\\  & =-2{e}^{2x}-{x}^{2}+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186097300 :knowledge-point/_questions [{:db/id #edb/ref 17592186096697 :knowledge-point/id #uuid "192bb38b-b609-56ff-b560-becfc38ea070" :knowledge-point/title "Finding the General Solution of a Second Order Differential Equation by Integrating Twice"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89aee0c2-41c4-50d9-95e7-d07999f8e43b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = 5x^{2} + Cx + D" :db/id #edb/ref 17592186095725} {:answer/id #uuid "a8264bab-88eb-5c1b-8cf6-4b5658e50c5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = Cx^{2} + 10x + D" :db/id #edb/ref 17592186095726} {:answer/id #uuid "c8066636-9a63-5ade-85aa-07f7e0be5cab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y =-5x^{2} + Cx + D" :db/id #edb/ref 17592186095727} {:answer/id #uuid "0a099fae-b25d-5abb-a50a-c5dc1eda7e34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y =-5x^{2} + D" :db/id #edb/ref 17592186095728} {:answer/id #uuid "1a40f9c2-33a9-5233-bec8-c51acd272979" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y =-5x^{2} + Cx" :db/id #edb/ref 17592186095729}] :answer-field/id #uuid "8c860608-75a8-5451-a1a7-a0683cdbc84f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186095724} {:answer-field/choices [{:answer/id #uuid "29a4235d-41c9-5a0e-b658-3ec6b027584e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-5{x}^{2}+Cx" :db/id #edb/ref 17592186398891} {:answer/id #uuid "4b317621-35b4-53d1-939d-fab67d8f1031" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-5{x}^{2}+Cx+D" :db/id #edb/ref 17592186398892 :task-item/_responses [{:db/id #edb/ref 17592186409306}]} {:answer/id #uuid "6dcf3415-556b-53c7-ac6f-21a5ddefd845" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-5{x}^{2}+D" :db/id #edb/ref 17592186398893} {:answer/id #uuid "a552a9bb-4de8-5448-90ec-372d3554e55d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5{x}^{2}+Cx+D" :db/id #edb/ref 17592186398894} {:answer/id #uuid "fa85c5fe-d852-5230-88fd-53d91e4bcd53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=C{x}^{2}+10x+D" :db/id #edb/ref 17592186398895}] :answer-field/correct {:answer/id #uuid "4b317621-35b4-53d1-939d-fab67d8f1031" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-5{x}^{2}+Cx+D" :db/id #edb/ref 17592186398892} :answer-field/id #uuid "b1789600-f409-5b68-8f83-26b29073f519" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398890}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "17751a3b-ed4b-5966-a450-330460c02715" :question/math-academy-id "q-50139" :question/problem "Solve the differential equation $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=-10.$" :question/worked-solution "Integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =-10\\int \\,\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-10x+C.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (-10x+C)\\text{d}x \\\\ y & =-10\\cdot \\frac{{x}^{2}}{2}+Cx+D \\\\  & =-5{x}^{2}+Cx+D.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$"}] [{:db/id #edb/ref 17592186097305 :knowledge-point/_questions [{:db/id #edb/ref 17592186096837 :knowledge-point/id #uuid "9688df89-056e-59d7-869e-9841715b2aea" :knowledge-point/title "Finding the Antiderivative of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80530319-a6b8-55b9-b731-4ad7a4a59618" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :