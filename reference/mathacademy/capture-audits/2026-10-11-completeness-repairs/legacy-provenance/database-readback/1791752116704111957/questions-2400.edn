 :answer/value "(0,-\\frac{\\pi }{2})" :db/id #edb/ref 17592186334676}] :answer-field/correct {:answer/id #uuid "7262f216-ccfa-5635-b302-e4493b0b8636" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,-\\frac{\\pi }{2})" :db/id #edb/ref 17592186334025} :answer-field/id #uuid "54658ae4-3198-5451-9590-4d7e2f837531" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335405}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4df808a2-0480-51da-bd5f-20bfa62f671d" :question/math-academy-id "q-65811" :question/problem "Which of the following gives the coordinates of the minimum point of the function $y=\\operatorname{arcsin}⁡x?$" :question/worked-solution "Let's recall the graph of $y=\\operatorname{arcsin}⁡x.$\n\n![](images/df/df22eea4331c47da3047381ca672fd80ebf75118054316fe88c0e2d96dae0d34.png)\n\nFrom the graph, we see that the minimum of the function is $-\\frac{\\pi }{2}$ and it is reached at $x=-1.$ Therefore, the coordinates of the minimum point of the function are $(-1,-\\frac{\\pi }{2}).$"}] [{:db/id #edb/ref 17592186111361 :knowledge-point/_questions [{:db/id #edb/ref 17592186110575 :knowledge-point/id #uuid "af0b18ca-54a2-5a24-a670-faa311096abc" :knowledge-point/title "Determining Points that Lie on the Curve of the Inverse Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b0fd68b-2206-5d60-9ed8-d020751c3e83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186109892} {:answer/id #uuid "a82e4653-fbbf-5d31-bff0-08f83d38ba2a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186109893} {:answer/id #uuid "278b7fd9-fea1-53da-adca-6737f493d980" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answe