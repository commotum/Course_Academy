#{[{:db/id #edb/ref 17592186332944 :knowledge-point/_questions [{:db/id #edb/ref 17592186138477 :knowledge-point/id #uuid "31de0804-798f-5962-84dc-f40d7bdb60bb" :knowledge-point/title "Computing Acceleration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24c28cf4-b5b7-52cb-a45d-72857697bff0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{\\text{ m/s}}^{2}" :db/id #edb/ref 17592186330264} {:answer/id #uuid "3dea9751-df74-5528-8050-a41594d1a7cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{\\text{ m/s}}^{2}" :db/id #edb/ref 17592186330494} {:answer/id #uuid "4b74c204-c852-519b-ae6f-302a8567e082" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10{\\text{ m/s}}^{2}" :db/id #edb/ref 17592186330634} {:answer/id #uuid "7483d780-0f8b-502a-b4fe-11a9c703e398" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{\\text{ m/s}}^{2}" :db/id #edb/ref 17592186330996} {:answer/id #uuid "e4954f34-a85f-507d-be27-35ebafc23730" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1{\\text{ m/s}}^{2}" :db/id #edb/ref 17592186331966}] :answer-field/correct {:answer/id #uuid "24c28cf4-b5b7-52cb-a45d-72857697bff0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{\\text{ m/s}}^{2}" :db/id #edb/ref 17592186330264} :answer-field/id #uuid "27a93e68-1c3c-5cf0-bf57-5a399ebe9ba1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332258}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ade17a93-3fe2-5788-a89b-af5d7f29f8fa" :question/math-academy-id "q-59502" :question/problem "A cyclist accelerates with constant acceleration from $0\\,\\text{m/s}$ to $20\\,\\text{m/s}$ in $10$ seconds. Find their acceleration." :question/worked-solution "We can find the acceleration of an object by computing the slope of its speed-time graph.  To plot a speed-time graph, we need two points.\n\n- The cyclist starts at a speed of $0\\,\\text{m/s}.$ This corresponds to the point $(0,0).$\n\n- In $10$ seconds, the cyclist reaches a speed of $20\\,\\text{m/s}.$ This corresponds to the point $(10,20).$\n\nSince the acceleration is constant, we plot the two points and draw a line through them as follows:\n\n![](images/e6/e60d9d6898bd8d49fb32860c439cb022c25850ff609b80ee486e71b48203b5fc.png)\n\nThe slope of the cyclist's speed-time graph gives its acceleration. The slope of this line is\n\n$$\n\\begin{aligned}m & =\\frac{20\\text{ m/s}-0\\text{ m/s}}{10\\text{ s}-0\\text{ s}} \\\\  & =\\frac{20\\text{ m/s}}{10\\text{ s}} \\\\  & =2\\,\\frac{\\text{m}}{{\\text{s}}^{2}}.\\end{aligned}\n$$\n\nTherefore, the cyclist's acceleration is $2\\,{\\text{m/s}}^{2}.$"}] [{:db/id #edb/ref 17592186332947 :knowledge-point/_questions [{:db/id #edb/ref 17592186138476 :knowledge-point/id #uuid "916e6da9-a2d1-5bf9-9777-ce4ca4858b96" :knowledge-point/title "Finding the Units of Acceleration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "284d5cdc-9d8b-5a32-9f21-799308cda688" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\text{m}}^{2}}{\\text{s}}" :db/id #edb/ref 17592186330310} {:answer/id #uuid "46175877-b036-5886-893f-0af8ddc3bf63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\text{m}}^{3}}{{\\text{s}}^{2}}" :db/id #edb/ref 17592186330581} {:answer/id #uuid "4fe0d05c-4bc4-59c5-9296-94f9940d9e57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{m}}{\\text{s}}" :db/id #edb/ref 17592186330678} {:answer/id #uuid "6295ca72-9831-5ca1-8c01-91d2607edab9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{m}}{{\\text{s}}^{2}}" :db/id #edb/ref 17592186330834} {:answer/id #uuid "beef7588-c3f1-5d71-a92c-c50d71a9a436" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\text{m}}^{2}}{{\\text{s}}^{2}}" :db/id #edb/ref 17592186331641}] :answer-field/correct {:answer/id #uuid "6295ca72-9831-5ca1-8c01-91d2607edab9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{m}}{{\\text{s}}^{2}}" :db/id #edb/ref 17592186330834} :answer-field/id #uuid "f6433ffa-9d79-5c31-a05b-36220395af6d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332634}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1876a249-f62a-521a-8a2d-c53c86945f25" :question/math-academy-id "q-59709" :question/problem "If the speed of a surfer is measured in $\\text{m/s},$ what are the units of its acceleration?" :question/worked-solution "We can find the acceleration of an object by computing the slope of its speed-time graph. So, let's draw an example of a speed-time graph where the speed is measured in $\\text{m/s}$ and the time is measured in $\\text{s}.$\n\n![](images/4d/4d419f405914437764e854b63682ddb6fa4c371730a2ec1cf4263b0afd2a847e.png)\n\nIn this case, the slope is computed as\n\n$$\nm=\\frac{\\text{change in speed}}{\\text{change in time}},\n$$\n\nand so the units of the slope are as follows:\n\n$$\n\\frac{\\text{units of speed}}{\\text{units of time}}=\\frac{\\text{m/s}}{\\text{s}}=\\frac{\\text{m}}{\\text{s}}\\cdot \\frac{1}{\\text{s}}=\\frac{\\text{m}}{{\\text{s}}^{2}}\n$$\n\nTherefore, the units of acceleration are $\\frac{\\text{m}}{{\\text{s}}^{2}}.$"}] [{:db/id #edb/ref 17592186403065 :knowledge-point/_questions [{:db/id #edb/ref 17592186138478 :knowledge-point/id #uuid "8f4e3599-287a-56a3-8f1b-9e7033803e0a" :knowledge-point/title "Identifying Acceleration on a Speed-Time Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1719b7cb-bb0a-512e-b4d0-2db46619b09d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "From $70\\,\\text{s}$ to $80\\,\\text{s}$" :db/id #edb/ref 17592186403067} {:answer/id #uuid "538466f6-26ea-5ceb-93d4-bf50e00e92bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "From $30\\,\\text{s}$ to $80\\,\\text{s}$" :db/id #edb/ref 17592186403068} {:answer/id #uuid "0140ed8a-92fd-5826-aecd-2f790dfa3107" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "From $30\\,\\text{s}$ to $70\\,\\text{s}$" :db/id #edb/ref 17592186403069} {:answer/id #uuid "dfc348c6-96de-5702-89fd-0eab3b40e299" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "From $0\\,\\text{s}$ to $70\\,\\text{s}$" :db/id #edb/ref 17592186403070} {:answer/id #uuid "3b6efc88-a3cc-5c91-8eab-852285448c53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "From $0\\,\\text{s}$ to $30\\,\\text{s}$" :db/id #edb/ref 17592186403071}] :answer-field/correct {:answer/id #uuid "3b6efc88-a3cc-5c91-8eab-852285448c53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "From $0\\,\\text{s}$ to $30\\,\\text{s}$" :db/id #edb/ref 17592186403071} :answer-field/id #uuid "f193901b-aa88-5598-b883-d5711c39904d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403066}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cca94ba1-21b2-5b66-81e8-07381d34c86b" :question/math-academy-id "q-59711" :question/problem "![](images/40/40143c20622029d70a978310a7d38bc41d7b8411151d3d5f61a3b280e5807841.png)\n\nThe speed-time graph shown above represents the motion of an object. At what times is the object accelerating?" :question/worked-solution "The object is accelerating when its acceleration is positive. In a speed-time graph, the acceleration is given by the slope of the line. So, we need to find the times for which the slope is positive.\n\nWe see from the graph that the slope is positive from $t=0\\,\\text{s}$ to $t=30\\,\\text{s}.$ Therefore, the object is accelerating in this time interval."}] [{:db/id #edb/ref 17592186332950 :knowledge-point/_questions [{:db/id #edb/ref 17592186138477 :knowledge-point/id #uuid "31de0804-798f-5962-84dc-f40d7bdb60bb" :knowledge-point/title "Computing Acceleration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34f9a758-2f18-5136-b512-ad6d3413bbfd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.5\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186330416} {:answer/id #uuid "8b611514-c66a-50a3-b836-cc30af5b78b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186331188} {:answer/id #uuid "d7a64283-8704-5c27-b888-b9766c1d0096" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186331858} {:answer/id #uuid "e43a7a43-a9c4-59e6-b4af-0dfc9667f7fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186331964} {:answer/id #uuid "efc33d93-eb52-509f-8d2b-2b744b1a011e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186332055}] :answer-field/correct {:answer/id #uuid "e43a7a43-a9c4-59e6-b4af-0dfc9667f7fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186331964} :answer-field/id #uuid "8b3831e8-ac25-5438-80c3-2935fc9d7560" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332445}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6b44397d-30e7-56c7-bab3-ed376b9676c9" :question/math-academy-id "q-59749" :question/problem "A cyclist accelerates with a constant acceleration from $2\\,\\text{m/s}$ to $12\\,\\text{m/s}$ in $4$ seconds. Find their acceleration." :question/worked-solution "We can find the acceleration of an object by computing the slope of its speed-time graph.  To plot a speed-time graph, we need two points.\n\n- The cyclist starts at a speed of $2\\,\\text{m/s}.$ This corresponds to the point $(0,2).$\n\n- In $4$ seconds, the cyclist reaches a speed of $12\\,\\text{m/s}.$ This corresponds to the point $(4,12).$\n\nSince the acceleration is constant, we plot the two points and draw a line through them as follows:\n\n![](images/d1/d1a813ebcbfa04b42729d60b73bc439a2060aafae8430c60984ba1772e940364.png)\n\nThe slope of the cyclist's speed-time graph gives their acceleration. The slope of this line is\n\n$$\n\\begin{aligned}m & =\\frac{12\\text{ m/s}-2\\text{ m/s}}{4\\text{s}-0\\text{s}} \\\\  & =\\frac{10\\text{ m/s}}{4\\text{ s}} \\\\  & =2.5\\,\\frac{\\text{m}}{{\\text{s}}^{2}}.\\end{aligned}\n$$\n\nTherefore, the cyclist's acceleration is $2.5\\,{\\text{m/s}}^{2}.$"}] [{:db/id #edb/ref 17592186392777 :knowledge-point/_questions [{:db/id #edb/ref 17592186138479 :knowledge-point/id #uuid "88580aff-e043-58ea-a8ca-1ce32026428f" :knowledge-point/title "Constructing the Speed-Time Graph for a Real-Life Scenario"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f8831562-bcba-5d5e-86bd-bd2156c1e48a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7c/7c3e6680c0a158181e11b473a94fa43b1a2afb3ea5c6206244801f4830bafff8.png" :db/id #edb/ref 17592186392779} {:answer/id #uuid "8e0a8238-9f58-50ad-9590-85298b9c467a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/11/11691073c02c80a9c4400623a8ee648d8a9405faab89ac8ce4fdbb7dbdd61baa.png" :db/id #edb/ref 17592186392780} {:answer/id #uuid "76325543-0212-5f9d-8b9d-4de0bdfd65f6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d1/d1123b8a9a86288380e084f8001ef5ebcc160d5647c83f3878a3d7b357087a9a.png" :db/id #edb/ref 17592186392781} {:answer/id #uuid "6258ba45-43e7-5c96-b19f-b0486d5d81c2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ec/ec8ff99395b5f33f531303acd91c58ada3b7f71213a5af5c76c86dae62d277e9.png" :db/id #edb/ref 17592186392782} {:answer/id #uuid "19c2e144-25c8-5914-9f81-2dab848d8fc1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fa/fae4c7d8cfc79dd70041ebd697226408a5cdd0676ad2ddfaad1500ea1ba0a76e.png" :db/id #edb/ref 17592186392783}] :answer-field/correct {:answer/id #uuid "19c2e144-25c8-5914-9f81-2dab848d8fc1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fa/fae4c7d8cfc79dd70041ebd697226408a5cdd0676ad2ddfaad1500ea1ba0a76e.png" :db/id #edb/ref 17592186392783} :answer-field/id #uuid "238dbbfc-eaba-5eb7-9c11-94c48e0f1e4d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392778}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3482860b-89cd-5fe9-aa14-3b6ba9d6957f" :question/math-academy-id "q-59760" :question/problem "A particle accelerates from rest with a constant acceleration of $5\\,{\\text{km/h}}^{2}$ for the first $4$ hours of its motion. It then travels at a constant speed for the next $6$ hours. Which graph represents the described motion?" :question/worked-solution "We start the first line from the point $(0,0),$ since the particle starts from rest. Then, because the acceleration is $5\\,{\\text{km/h}}^{2},$ we draw a line with slope $5.$ \n\nHowever, because the particle is only accelerating for the first $4$ hours, we stop the line at $t=4.$ At this time, the particle's speed has increased by $4\\cdot 5=20\\text{ km/h}.$ So, the first line segment goes from $(0,0)$ to $(4,20).$\n\n![](images/cf/cf0471f38486963f4237b4fab7c1cd109d02cc2d7ac3e30990831654f04c5b11.png)\n\nThe particle then travels at a constant speed for the next $6$ hours. So, the speed remains at $20\\,\\text{km/h}$ for the next $6$ hours, until $t=4+6=10.$\n\nSo, the second line segment stops at the point $(10,20).$ The final graph is\n\n![](images/fa/fae4c7d8cfc79dd70041ebd697226408a5cdd0676ad2ddfaad1500ea1ba0a76e.png)"}] [{:db/id #edb/ref 17592186332955 :knowledge-point/_questions [{:db/id #edb/ref 17592186083205 :knowledge-point/id #uuid "f87bc14d-5e68-5a5e-bec8-f1b5b21c02e8" :knowledge-point/title "Calculating the Arc Length of a Smooth Curve Using the Arc Length Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b84836a-ca31-58d6-b3e2-bc84634c7bfd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}\\operatorname{ln}⁡4-\\operatorname{ln}⁡4" :db/id #edb/ref 17592186330050} {:answer/id #uuid "5ca803f0-f909-58d7-8a28-df1502e421ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡4+\\frac{15}{8}" :db/id #edb/ref 17592186330776} {:answer/id #uuid "616b33a2-ce09-5c06-9b8e-ef3c61426219" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡4}{4}+2\\operatorname{ln}⁡4" :db/id #edb/ref 17592186330814} {:answer/id #uuid "a2b289a5-5962-5488-974c-2b1a270d6ece" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14}{29}" :db/id #edb/ref 17592186331409} {:answer/id #uuid "dcbf98e9-e55f-57f8-a960-4aadf1dd3b22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡4-2" :db/id #edb/ref 17592186331906}] :answer-field/correct {:answer/id #uuid "5ca803f0-f909-58d7-8a28-df1502e421ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡4+\\frac{15}{8}" :db/id #edb/ref 17592186330776} :answer-field/id #uuid "5764c719-ca7d-564b-ae7d-1279ae7c6a02" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332368}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ad1bb041-4b79-50a3-a98c-f0ec7b875169" :question/math-academy-id "q-5998" :question/problem "Compute the arc length of $y=\\frac{1}{8}{x}^{2}-\\operatorname{ln}⁡x$ for $x\\in [1,4].$" :question/worked-solution "The arc length of a curve $y=f(x)$ between $x=a$ and $x=b$ can be found using the formula\n\n$$\nL={\\int }_{a}^{b}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=\\frac{1}{8}{x}^{2}-\\operatorname{ln}⁡x,$ $a=1,$ and $b=4.$\n\nFirst, we find the derivative of $f(x):$\n\n$$\n{f}^{′}(x)=\\frac{1}{4}x-\\frac{1}{x}\n$$\n\nNow, let's compute $\\sqrt{1+[{f}^{′}(x)]^{2}}:$\n\n$$\n\\begin{aligned}\\sqrt{1+[{f}^{′}(x)]^{2}} & =\\sqrt{1+{(\\frac{1}{4}x-\\frac{1}{x})}^{2}} \\\\  & =\\sqrt{1+\\frac{1}{16}{x}^{2}+\\frac{1}{{x}^{2}}-\\frac{1}{2}} \\\\  & =\\sqrt{\\frac{1}{16}{x}^{2}+\\frac{1}{{x}^{2}}+\\frac{1}{2}} \\\\  & =\\frac{1}{4}\\sqrt{{x}^{2}+\\frac{16}{{x}^{2}}+8} \\\\  & =\\frac{1}{4}\\sqrt{{(\\frac{{x}^{2}+4}{x})}^{2}} \\\\  & =\\frac{{x}^{2}+4}{4x}.\\end{aligned}\n$$\n\nSubstituting $\\sqrt{1+[{f}^{′}(x)]^{2}}=\\frac{{x}^{2}+4}{4x}$ into the arc length formula, we get\n\n$$\n\\begin{aligned}L & ={\\int }_{1}^{4}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{4}\\frac{{x}^{2}+4}{4x}\\,\\text{d}x \\\\  & ={\\int }_{1}^{4}\\frac{x}{4}+\\frac{1}{x}\\,\\text{d}x \\\\  & ={(\\operatorname{ln}⁡x+\\frac{1}{8}{x}^{2})|}_{1}^{4} \\\\  & =[\\operatorname{ln}⁡(4)+\\frac{1}{8}(4)^{2}]-[\\operatorname{ln}⁡(1)+\\frac{1}{8}(1)^{2}] \\\\  & =\\operatorname{ln}⁡4+2-\\operatorname{ln}⁡1-\\frac{1}{8} \\\\  & =\\operatorname{ln}⁡4+\\frac{15}{8}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186392784 :knowledge-point/_questions [{:db/id #edb/ref 17592186083302 :knowledge-point/id #uuid "965026e6-db46-5930-8844-c423e6ea795a" :knowledge-point/title "Finding an Integral Representation For an Arc Length"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "130902b7-518f-5bff-b4c6-70ec10669ed6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{1}^{e}\\sqrt{{ln}^{2}⁡x+2\\operatorname{ln}⁡x+2}\\,\\text{d}x" :db/id #edb/ref 17592186392786} {:answer/id #uuid "2e9dc4bc-d4d3-5b8e-abbf-e99a3aff279c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{1}^{e}\\sqrt{2{ln}^{2}⁡x+\\operatorname{ln}⁡x+2}\\,\\text{d}x" :db/id #edb/ref 17592186392787} {:answer/id #uuid "c337a131-ba2b-58de-bb8a-9bc3f5b91c72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{1}^{e}\\sqrt{\\operatorname{ln}⁡x+2}\\,\\text{d}x" :db/id #edb/ref 17592186392788} {:answer/id #uuid "104a11b9-60b8-543e-98fa-97a1a9ca9dd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{1}^{e}\\sqrt{2{ln}^{2}⁡x+\\operatorname{ln}⁡x+1}\\,\\text{d}x" :db/id #edb/ref 17592186392789} {:answer/id #uuid "c97ec70f-712d-5261-a2ad-b13ddf434c3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{1}^{e}\\operatorname{ln}⁡x+1\\,\\text{d}x" :db/id #edb/ref 17592186392790}] :answer-field/correct {:answer/id #uuid "130902b7-518f-5bff-b4c6-70ec10669ed6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{1}^{e}\\sqrt{{ln}^{2}⁡x+2\\operatorname{ln}⁡x+2}\\,\\text{d}x" :db/id #edb/ref 17592186392786} :answer-field/id #uuid "e8ab54e5-e3ae-5c28-96df-43d45b975ac9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392785}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1018367e-83ad-5af3-99ec-2abf57016cee" :question/math-academy-id "q-6001" :question/problem "The length of the curve $y=x\\operatorname{ln}⁡x$ on $[1,e]$ is given by" :question/worked-solution "The arc length of a curve $y=f(x)$ between $x=a$ and $x=b$ can be found using the formula\n\n$$\nL={\\int }_{a}^{b}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=x\\operatorname{ln}⁡x,$ $a=1,$ and $b=e.$\n\nFirst, we find the derivative of $f(x):$\n\n$$\n{f}^{′}(x)=\\operatorname{ln}⁡x+x\\cdot \\frac{1}{x}=\\operatorname{ln}⁡x+1\n$$\n\nSubstituting ${f}^{′}(x)=\\operatorname{ln}⁡x+1$ into the arc length formula, we get\n\n$$\n\\begin{aligned}L & ={\\int }_{1}^{e}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{e}\\sqrt{1+{(\\operatorname{ln}⁡x+1)}^{2}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{e}\\sqrt{{ln}^{2}⁡x+2\\operatorname{ln}⁡x+2}\\,\\text{d}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332958 :knowledge-point/_questions [{:db/id #edb/ref 17592186083207 :knowledge-point/id #uuid "55f783c4-25d6-5855-877e-31bed16b12c4" :knowledge-point/title "Identifying a Possible Curve Given Its Arc Length As an Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "260f6f6f-4b97-5bce-b735-d20663155851" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\sqrt{2-x}+\\sqrt{2}" :db/id #edb/ref 17592186330282} {:answer/id #uuid "2b92251f-f974-5117-bc90-133ccc831cee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\sqrt{1-{x}^{2}}+\\sqrt{3}" :db/id #edb/ref 17592186330333} {:answer/id #uuid "7c9be02d-aeaa-5fa4-becc-22e93b3e5dae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2\\sqrt{4-{x}^{2}}-x+1" :db/id #edb/ref 17592186331047} {:answer/id #uuid "c8b4dda3-dc9f-56a0-bbba-3790a8a3d65a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\sqrt{4-{x}^{2}}+\\sqrt{3}" :db/id #edb/ref 17592186331727} {:answer/id #uuid "e187eb7e-4f45-57a2-ad61-ab4f80fd444d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-3\\sqrt{2-x}-\\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186331942}] :answer-field/correct {:answer/id #uuid "c8b4dda3-dc9f-56a0-bbba-3790a8a3d65a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\sqrt{4-{x}^{2}}+\\sqrt{3}" :db/id #edb/ref 17592186331727} :answer-field/id #uuid "c6a4ee23-964a-57c5-8394-826143a4e0ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332546}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "abe3d8a9-d2e1-5184-aae8-cfbea17c4028" :question/math-academy-id "q-6003" :question/problem "The length of a curve $y=f(x)$ is given by ${\\int }_{-1}^{1}\\sqrt{1+\\frac{{x}^{2}}{4-{x}^{2}}}\\,\\text{d}x.$ Which of the following could be  an equation for this curve?" :question/worked-solution "The arc length of a curve $y=f(x)$ between $x=a$ and $x=b$ can be found using the formula\n\n$$\nL={\\int }_{a}^{b}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x.\n$$\n\nWe're given that \n\n$$\nL={\\int }_{-1}^{1}\\sqrt{1+\\frac{{x}^{2}}{4-{x}^{2}}}\\,\\text{d}x.\n$$\n\nComparing the above with the arc length formula, we see that we must have\n\n$$\n[{f}^{′}(x)]^{2}=\\frac{{x}^{2}}{4-{x}^{2}}\\,⟹\\,{f}^{′}(x)=\\pm \\frac{x}{\\sqrt{4-{x}^{2}}}.\n$$\n\nIntegrating the above equation with respect to $x,$ we get\n\n$$\n\\begin{aligned}f(x) & =\\pm \\int \\frac{x}{\\sqrt{4-{x}^{2}}}\\text{ d}x \\\\  & =\\pm (-\\sqrt{4-{x}^{2}})+C \\\\  & =\\pm \\sqrt{4-{x}^{2}}+C.\\end{aligned}\n$$\n\nFrom the given options, the only one that has the required form is $y=-\\sqrt{4-{x}^{2}}+\\sqrt{3}.$"}] [{:db/id #edb/ref 17592186332959 :knowledge-point/_questions [{:db/id #edb/ref 17592186179817 :knowledge-point/id #uuid "0e44aa33-0aca-5cb2-8c89-6391240beed8" :knowledge-point/title "Calculating an Amount Given a Ratio"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2017ff24-0581-50a6-a0e4-897c730b1b05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "58" :db/id #edb/ref 17592186330223} {:answer/id #uuid "39e19669-c003-5b81-804b-0508b1684a64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "62" :db/id #edb/ref 17592186330469} {:answer/id #uuid "7301049a-cded-5985-8144-7a673af44c49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "66" :db/id #edb/ref 17592186330985} {:answer/id #uuid "8b8cf9cd-ccd6-560f-bcac-033dc77df751" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186331190} {:answer/id #uuid "c1b091f7-dcf4-5b11-8f44-fd1a1d60d02a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "55" :db/id #edb/ref 17592186331671}] :answer-field/correct {:answer/id #uuid "c1b091f7-dcf4-5b11-8f44-fd1a1d60d02a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "55" :db/id #edb/ref 17592186331671} :answer-field/id #uuid "dfe8cef3-8694-5862-a34e-cf2a94036fcd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332596}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "46da9d15-27a6-531e-bac7-0a77b34580ce" :question/math-academy-id "q-60139" :question/problem "One day, $20$ adults and some children attended a music festival at Beethoven Park. If the ratio of adults to children was $4:7$, how many people attended the park that day?" :question/worked-solution "We start with the ratio $4:7$ and write it as a fraction:\n\n$$\n\\frac{4}{7}\n$$\n\nIn this fraction, the numerator represents the number of adults and the denominator represents the number of children.\n\nWe can make a numerator of $20$ by multiplying the numerator and denominator by $5:$\n\n$$\n\\frac{4\\times 5}{7\\times 5}=\\frac{20}{35}\n$$\n\nTherefore, $20$ adults and $35$ children attended that day. Thus, the total number of people who went to the park that day was\n\n$$\n20+35=55.\n$$"}] [{:db/id #edb/ref 17592186403072 :knowledge-point/_questions [{:db/id #edb/ref 17592186184192 :knowledge-point/id #uuid "3996c79f-9281-5b9d-9b33-8863f10adc33" :knowledge-point/title "Solving a Quadratic Equation With a Negative Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5408298f-7273-5f8e-b08d-eb9052a72e9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q=4,\\,x=2\\pm \\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186403074} {:answer/id #uuid "55c297c3-ce19-541b-8f15-0e1cff269acc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q=4,\\,x=\\frac{3}{4}\\pm \\frac{\\sqrt{5}}{2}" :db/id #edb/ref 17592186403075} {:answer/id #uuid "18ad6631-816d-504b-86a5-d5fe74a70d5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q=4,\\,x=\\frac{3}{2}\\pm \\frac{\\sqrt{5}}{5}" :db/id #edb/ref 17592186403076} {:answer/id #uuid "fcc7cd2a-4140-5747-8785-3c2be9dddaf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q=2,\\,x=3\\pm \\frac{\\sqrt{5}}{5}" :db/id #edb/ref 17592186403077} {:answer/id #uuid "ef782508-1876-5861-8688-45bcea667f16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q=2,\\,x=\\frac{3}{2}\\pm \\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186403078}] :answer-field/correct {:answer/id #uuid "18ad6631-816d-504b-86a5-d5fe74a70d5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q=4,\\,x=\\frac{3}{2}\\pm \\frac{\\sqrt{5}}{5}" :db/id #edb/ref 17592186403076} :answer-field/id #uuid "838eec31-f001-5f3e-95ff-aee58026f6f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403073}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a1ac9dcc-ee5b-5438-8680-0a3c7af8b759" :question/math-academy-id "q-60145" :question/problem "The equation $-20{x}^{2}+60x-41=0$ can be written in the form $20(x+p)^{2}=q.$ Find $q,$ and solve the equation." :question/worked-solution "First, we multiply the equation by $-1$:\n\n$$\n\\begin{aligned}(-1)\\cdot (-20{x}^{2}+60x-41) & =(-1)\\cdot 0 \\\\ 20{x}^{2}-60x+41 & =0\\end{aligned}\n$$\n\nNow, we move the constant term to the right-hand side, factor the coefficient of the quadratic term, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}20{x}^{2}-60x+41 & =0 \\\\ 20{x}^{2}-60x & =-41 \\\\ 20({x}^{2}-3x) & =-41 \\\\ 20[{x}^{2}-2\\cdot \\frac{3}{2}x+{(\\frac{3}{2})}^{2}-{(\\frac{3}{2})}^{2}] & =-41 \\\\ 20[{(x-\\frac{3}{2})}^{2}-\\frac{9}{4}] & =-41\\end{aligned}\n$$\n\nNext, we expand the brackets, and write the equation in the required form:\n\n$$\n\\begin{aligned}20{(x-\\frac{3}{2})}^{2}-20\\cdot \\frac{9}{4} & =-41 \\\\ 20{(x-\\frac{3}{2})}^{2}-45 & =-41 \\\\ 20{(x-\\frac{3}{2})}^{2} & =45-41 \\\\ 20{(x-\\frac{3}{2})}^{2} & =4\\end{aligned}\n$$\n\nTherefore, $q=4.$ We now solve the equation using the square root method:\n\n$$\n\\begin{aligned}20{(x-\\frac{3}{2})}^{2} & =4 \\\\ {(x-\\frac{3}{2})}^{2} & =\\frac{4}{20} \\\\ {(x-\\frac{3}{2})}^{2} & =\\frac{1}{5} \\\\ \\sqrt{{(x-\\frac{3}{2})}^{2}} & =\\sqrt{\\frac{1}{5}} \\\\ |x-\\frac{3}{2}| & =\\sqrt{\\frac{1}{5}} \\\\ x-\\frac{3}{2} & =\\pm \\frac{1}{\\sqrt{5}} \\\\ x-\\frac{3}{2} & =\\pm \\frac{\\sqrt{5}}{5} \\\\ x & =\\frac{3}{2}\\pm \\frac{\\sqrt{5}}{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332961 :knowledge-point/_questions [{:db/id #edb/ref 17592186083201 :knowledge-point/id #uuid "dc6d9b69-0459-515a-ba7b-c62cab96ca00" :knowledge-point/title "Identifying Divergent Improper Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36b26abc-59e4-5f26-a879-c88bd9674a2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{ln}⁡(6)}" :db/id #edb/ref 17592186330441} {:answer/id #uuid "5930fa44-50f4-5443-816a-d851a83c93bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\operatorname{ln}⁡(6)" :db/id #edb/ref 17592186330749} {:answer/id #uuid "7cf921ac-f569-5c86-91ea-21e2d7197b21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(6)" :db/id #edb/ref 17592186331051} {:answer/id #uuid "a448ae0d-5a00-5f30-af7e-73eeb7091140" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The integral diverges" :db/id #edb/ref 17592186331425} {:answer/id #uuid "dea4729f-fa01-5b4a-98f1-da79364f0332" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{6}" :db/id #edb/ref 17592186331918}] :answer-field/correct {:answer/id #uuid "a448ae0d-5a00-5f30-af7e-73eeb7091140" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The integral diverges" :db/id #edb/ref 17592186331425} :answer-field/id #uuid "18eb5fcf-2f7e-55f1-9f7e-384542e03025" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332237}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4d9a9729-71fc-57cb-8bba-051918208f5f" :question/math-academy-id "q-6034" :question/problem "Evaluate ${\\int }_{6}^{\\infty }\\frac{\\text{d}z}{z}.$" :question/worked-solution "We proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{6}^{\\infty }\\frac{\\text{d}z}{z} & ={lim}_{a\\to \\infty }{\\int }_{6}^{a}\\frac{\\text{d}z}{z} \\\\  & ={lim}_{a\\to \\infty }{[\\operatorname{ln}⁡z]}_{6}^{a} \\\\  & ={lim}_{a\\to \\infty }(\\operatorname{ln}⁡a-\\operatorname{ln}⁡6) \\\\  & =\\infty -\\operatorname{ln}⁡6 \\\\  & =\\infty .\\end{aligned}\n$$\n\nTherefore, the integral is divergent."}] [{:db/id #edb/ref 17592186403079 :knowledge-point/_questions [{:db/id #edb/ref 17592186184192 :knowledge-point/id #uuid "3996c79f-9281-5b9d-9b33-8863f10adc33" :knowledge-point/title "Solving a Quadratic Equation With a Negative Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae3561cc-7a36-53c3-8463-a08b60f2e422" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q-p=-6" :db/id #edb/ref 17592186403081} {:answer/id #uuid "9c0c8fbf-a096-54ef-a916-0cf279874a62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q-p=5" :db/id #edb/ref 17592186403082} {:answer/id #uuid "84b429b9-e24f-5b71-bb06-7a7076b1bd11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q-p=\\frac{20}{3}" :db/id #edb/ref 17592186403083} {:answer/id #uuid "c808c746-284d-54ac-ab48-93af25059dd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q-p=\\frac{17}{3}" :db/id #edb/ref 17592186403084} {:answer/id #uuid "06498b0f-3db5-5fe1-b4f1-27d65e29f54e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q-p=6" :db/id #edb/ref 17592186403085}] :answer-field/correct {:answer/id #uuid "06498b0f-3db5-5fe1-b4f1-27d65e29f54e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q-p=6" :db/id #edb/ref 17592186403085} :answer-field/id #uuid "5281993a-3636-5f8e-a209-1d71b7850d4e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403080}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a7884f70-6bc5-5884-9b9e-474178b4363b" :question/math-academy-id "q-60356" :question/problem "The equation $-3{x}^{2}-2x+6=0$ can be written in the form $3(x+p)^{2}=q.$ Find $q-p.$" :question/worked-solution "First, we multiply the equation by $-1$:\n\n$$\n\\begin{aligned}(-1)\\cdot (-3{x}^{2}-2x+6) & =(-1)\\cdot 0 \\\\ 3{x}^{2}+2x-6 & =0\\end{aligned}\n$$\n\nNow, we move the constant term to the right-hand side, factor the coefficient of the quadratic term, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}3{x}^{2}+2x-6 & =0 \\\\ 3{x}^{2}+2x & =6 \\\\ 3[{x}^{2}+\\frac{2}{3}x] & =6 \\\\ 3[{x}^{2}+2\\cdot \\frac{1}{3}x+{(\\frac{1}{3})}^{2}-{(\\frac{1}{3})}^{2}] & =6 \\\\ 3[{(x+\\frac{1}{3})}^{2}-\\frac{1}{9}] & =6\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}3{(x+\\frac{1}{3})}^{2}-3\\cdot \\frac{1}{9} & =6 \\\\ 3{(x+\\frac{1}{3})}^{2}-\\frac{1}{3} & =6 \\\\ 3{(x+\\frac{1}{3})}^{2} & =6+\\frac{1}{3} \\\\ 3{(x+\\frac{1}{3})}^{2} & =\\frac{19}{3}\\end{aligned}\n$$\n\nTherefore, $p=\\frac{1}{3}$, $q=\\frac{19}{3}.$ Finally,\n\n$$\nq-p=\\frac{19}{3}-\\frac{1}{3}=\\frac{18}{3}=6.\n$$"}] [{:db/id #edb/ref 17592186184815 :knowledge-point/_questions [{:db/id #edb/ref 17592186184191 :knowledge-point/id #uuid "257b907c-70c1-5bbd-a6d2-297d51325d1f" :knowledge-point/title "Solving a Quadratic Equation With a Positive Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82072ee0-13f5-5686-82b1-ae2000b3312f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q =-1, x = 1 ± \\sqrt{\\frac{11}{2}}" :db/id #edb/ref 17592186183500} {:answer/id #uuid "92fce56f-5163-5f74-bfab-b2b7fd956c29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q =-1, x = 1 ± \\sqrt{22}" :db/id #edb/ref 17592186183501} {:answer/id #uuid "c70de482-14f4-5806-bb6e-7e2b7620519b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q = 11, x =-1 ± \\sqrt{\\frac{11}{2}}" :db/id #edb/ref 17592186183502} {:answer/id #uuid "0f68b0e9-0392-527a-bc03-1df0c43ae5f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q = 11, x = 1 ± \\sqrt{\\frac{11}{2}}" :db/id #edb/ref 17592186183503} {:answer/id #uuid "3a33f08d-733e-5fc5-a89e-856cabe406e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q = 11, x = 1 ± \\sqrt{22}" :db/id #edb/ref 17592186183504}] :answer-field/id #uuid "9790c489-8408-5721-a9a9-6746e95691ec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186183499} {:answer-field/choices [{:answer/id #uuid "4729e5c5-d121-5071-90ac-905326cae80d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q=-1,\\,x=1\\pm \\sqrt{\\frac{11}{2}}" :db/id #edb/ref 17592186403087} {:answer/id #uuid "148ab9f1-4a75-549b-80f9-e24ca927be0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q=11,\\,x=-1\\pm \\sqrt{\\frac{11}{2}}" :db/id #edb/ref 17592186403088} {:answer/id #uuid "a69056b8-e131-5a3d-920b-99466a245297" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q=11,\\,x=1\\pm \\sqrt{\\frac{11}{2}}" :db/id #edb/ref 17592186403089} {:answer/id #uuid "0a32de8d-323c-57e3-a4c6-10f2b23289bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q=11,\\,x=1\\pm \\sqrt{22}" :db/id #edb/ref 17592186403090} {:answer/id #uuid "f0a7de99-c75b-55c2-bfe2-679645b43eb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q=-1,\\,x=1\\pm \\sqrt{22}" :db/id #edb/ref 17592186403091}] :answer-field/correct {:answer/id #uuid "a69056b8-e131-5a3d-920b-99466a245297" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q=11,\\,x=1\\pm \\sqrt{\\frac{11}{2}}" :db/id #edb/ref 17592186403089} :answer-field/id #uuid "08090f79-b14c-5148-89c6-fad864772e14" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403086}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "404aac0a-c4f3-5720-8a82-6f8114d49cae" :question/math-academy-id "q-60360" :question/problem "The equation $2{x}^{2}-4x-9=0$ can be written in the form $2(x+p)^{2}=q.$ Find $q,$ and solve the equation." :question/worked-solution "First, we move the constant term to the right-hand side, factor the coefficient of the quadratic term, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}2{x}^{2}-4x-9 & =0 \\\\ 2{x}^{2}-4x & =9 \\\\ 2({x}^{2}-2x) & =9 \\\\ 2[{x}^{2}-2\\cdot 1\\cdot x+{(1)}^{2}-{(1)}^{2}] & =9 \\\\ 2[{(x-1)}^{2}-1] & =9\\end{aligned}\n$$\n\nNext, we expand the brackets, and write the equation in the required form:\n\n$$\n\\begin{aligned}2{(x-1)}^{2}-2\\cdot 1 & =9 \\\\ 2{(x-1)}^{2}-2 & =9 \\\\ 2{(x-1)}^{2} & =9+2 \\\\ 2{(x-1)}^{2} & =11\\end{aligned}\n$$\n\nSo, $q=11.$\n\nNext, we solve the equation using the square root method:\n\n$$\n\\begin{aligned}2{(x-1)}^{2} & =11 \\\\ {(x-1)}^{2} & =\\frac{11}{2} \\\\ \\sqrt{{(x-1)}^{2}} & =\\sqrt{\\frac{11}{2}} \\\\ |x-1| & =\\sqrt{\\frac{11}{2}} \\\\ x-1 & =\\pm \\sqrt{\\frac{11}{2}} \\\\ x & =1\\pm \\sqrt{\\frac{11}{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186193369 :knowledge-point/_questions [{:db/id #edb/ref 17592186192836 :knowledge-point/id #uuid "a8a8bf54-5523-5eaa-a236-b8931d1c3dba" :knowledge-point/title "Improper Integrals Involving Arctangent Using the Second Result"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00a9fb3d-28bf-564b-a3ba-7e478e769d13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{3}" :db/id #edb/ref 17592186329959} {:answer/id #uuid "1bdba1a4-572b-5ff5-98ad-ba8d4cb42573" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186330196} {:answer/id #uuid "272adadc-dc60-5df6-b12a-607b5737505f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{2}" :db/id #edb/ref 17592186330296} {:answer/id #uuid "9907c739-9ee7-5ae0-a552-1008c61ffa45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The integral diverges" :db/id #edb/ref 17592186331317} {:answer/id #uuid "ab81ca8d-9891-5577-a8bc-ca291c0278e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186331470}] :answer-field/correct {:answer/id #uuid "ab81ca8d-9891-5577-a8bc-ca291c0278e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186331470} :answer-field/id #uuid "f19ed891-559a-5317-88f9-73b293b6effe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332627}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f451acc7-5bcc-5cdc-a9bd-08b863789689" :question/math-academy-id "q-6037" :question/problem "Evaluate the integral ${\\int }_{0}^{\\infty }\\frac{2}{{z}^{2}+9}\\,\\text{d}z.$" :question/worked-solution "First, let's recall the following result:\n\n$$\n\\int \\frac{1}{{k}^{2}+{x}^{2}}\\,\\text{d}x=\\frac{1}{k}\\operatorname{arctan}⁡(\\frac{x}{k})+C\n$$\n\nWe proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{2}{{z}^{2}+9}\\,\\text{d}z & =2\\cdot {lim}_{a\\to \\infty }{\\int }_{0}^{a}\\frac{1}{{z}^{2}+9}\\,\\text{d}z \\\\  & =2\\cdot {lim}_{a\\to \\infty }{\\int }_{0}^{a}\\frac{1}{{z}^{2}+{3}^{2}}\\,\\text{d}z \\\\  & =2\\cdot {lim}_{a\\to \\infty }{[\\frac{1}{3}\\operatorname{arctan}⁡(\\frac{z}{3})]}_{0}^{a} \\\\  & =\\frac{2}{3}\\cdot {lim}_{a\\to \\infty }(\\operatorname{arctan}⁡(\\frac{a}{3})-\\operatorname{arctan}⁡0) \\\\  & =\\frac{2}{3}\\cdot {lim}_{a\\to \\infty }[\\operatorname{arctan}⁡(\\frac{a}{3})]\\end{aligned}\n$$\n\nNow, recall the end behavior of the function $y=\\operatorname{arctan}⁡(\\frac{x}{3}),$ shown in the graph below:\n\n- ${lim}_{x\\to -\\infty }[\\operatorname{arctan}⁡(\\frac{x}{3})]=-\\frac{\\pi }{2}$\n\n- ${lim}_{x\\to \\infty }[\\operatorname{arctan}⁡(\\frac{x}{3})]=\\frac{\\pi }{2}$\n\n![](images/24/2465f099a94aa966dbf33eb89aa00973e692fa97c887a9b79baff8260f5d31cd.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{2}{{z}^{2}+9}\\,\\text{d}z & =\\frac{2}{3}\\cdot {lim}_{a\\to \\infty }[\\operatorname{arctan}⁡(\\frac{a}{3})] \\\\  & =\\frac{2}{3}\\cdot \\frac{\\pi }{2} \\\\  & =\\frac{\\pi }{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186392791 :knowledge-point/_questions [{:db/id #edb/ref 17592186147622 :knowledge-point/id #uuid "947eb2bb-0443-5740-9d45-847c70877270" :knowledge-point/title "Calculating the Surface Area of a Polyhedron Given Some Lengths"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fd2cc1f4-4180-5121-81ee-6ce90dc3ab03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "112\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186392793} {:answer/id #uuid "c0f0316f-1f80-5555-873b-bb68be412b12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186392794} {:answer/id #uuid "b093fa83-8105-5eda-a415-434ce5770775" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186392795} {:answer/id #uuid "61e1f5e1-0d03-55f3-aeeb-7124734a0c8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "128\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186392796} {:answer/id #uuid "9edb4e16-4920-586e-a93a-7fa6823134a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "96\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186392797}] :answer-field/correct {:answer/id #uuid "9edb4e16-4920-586e-a93a-7fa6823134a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "96\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186392797} :answer-field/id #uuid "9f2893cb-ce4a-55a0-b185-2a569f1674bd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392792}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f6441de6-8de3-5bac-a175-59bb496af580" :question/math-academy-id "q-61906" :question/problem "![](images/58/586b2c9d3409b68436f16715937b7a4bf0abdf8c1a05c628ccafdc49cf6d641d.png)\n\nWhat is the total surface area of the cube above if it is $4\\,\\text{cm}$ long, $4\\,\\text{cm}$ wide, and $4\\,\\text{cm}$ tall?" :question/worked-solution "First, let's consider the net of our plank.\n\n![](images/2c/2c8a118f8f3c3ccba67e25ae09096ef1ec0cf15fc6a5e7f9de68f797b7105c80.png)\n\n$$\n\n$$\n\nFrom the diagram, we have squares only.\n\nThe squares are $4\\,\\text{cm}$ long and $4\\,\\text{cm}$ high. So, the area of one square is:\n\n$$\n\\text{Area of the square}=4\\times 4=16\\,{\\text{cm}}^{2}.\n$$\n\nFinally, the surface area of the cube consists of $6$ squares. \n\nTherefore, we get:\n\n$$\n\\begin{aligned}\\text{Surface area} & =6\\times (\\text{Area of the square}) \\\\  & =6\\times 16 \\\\  & =96\\,{\\text{cm}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186392798 :knowledge-point/_questions [{:db/id #edb/ref 17592186147622 :knowledge-point/id #uuid "947eb2bb-0443-5740-9d45-847c70877270" :knowledge-point/title "Calculating the Surface Area of a Polyhedron Given Some Lengths"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d7c7996b-19b7-5eb7-84a5-17cf5d9e6167" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "125\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186392800} {:answer/id #uuid "edcc69bf-98aa-5035-96a7-755c3f2d413b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "175\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186392801} {:answer/id #uuid "cf607e4d-7a99-5fe8-8f93-6dbd45209478" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "200\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186392802} {:answer/id #uuid "1e1baad8-edab-507a-9ec5-c266a0e0dc81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "150\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186392803} {:answer/id #uuid "079063e4-8fc3-5c8e-919a-c94bf423e9d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186392804}] :answer-field/correct {:answer/id #uuid "1e1baad8-edab-507a-9ec5-c266a0e0dc81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "150\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186392803} :answer-field/id #uuid "d2c09b90-906a-56bc-b30d-a59eaa276027" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392799}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e80ccdcb-f8a7-5672-8914-73b42c8ccce6" :question/math-academy-id "q-61907" :question/problem "![](images/d4/d480892817efecf5ebea6860bece7cbae8127a9840e94ece34f9e83313abd5e5.png)\n\nWhat is the total surface area of the cube above if it is $5\\,\\text{cm}$ long, $5\\,\\text{cm}$ wide, and $5\\,\\text{cm}$ tall?" :question/worked-solution "First, let's consider the net of our plank.\n\n![](images/ef/efca24e18b188363ec3698ff4deaa5d5bd4ec1bdb5075138f925573a407c1f79.png)\n\n$$\n\n$$\n\nFrom the diagram, we have squares only.\n\nThe squares are $5\\,\\text{cm}$ long and $5\\,\\text{cm}$ high. So, the area of one square is:\n\n$$\n\\text{Area of the square}=5\\times 5=25\\,{\\text{cm}}^{2}.\n$$\n\nFinally, the surface area of the cube consists of $6$ squares. \n\nTherefore, we get:\n\n$$\n\\begin{aligned}\\text{Surface area} & =6\\times (\\text{Area of the square}) \\\\  & =6\\times 25 \\\\  & =150\\,{\\text{cm}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186147953 :knowledge-point/_questions [{:db/id #edb/ref 17592186147618 :knowledge-point/id #uuid "1233be4b-7634-5882-9ae5-3200a9da71d8" :knowledge-point/title "Calculating the Surface Area of a Polyhedron Given the Areas of the Faces: Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a372cabe-863d-5655-b130-b77c289b8b45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25ft^{2}" :db/id #edb/ref 17592186145473} {:answer/id #uuid "fa5b27af-4a59-5e8d-bf88-2cf72f89bfbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32ft^{2}" :db/id #edb/ref 17592186145474} {:answer/id #uuid "43de98f0-c6fb-5850-b8b3-142ca5894921" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40ft^{2}" :db/id #edb/ref 17592186145475} {:answer/id #uuid "4d105580-4448-5844-89d9-c1da675148f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24ft^{2}" :db/id #edb/ref 17592186145476} {:answer/id #uuid "669394dd-617c-5e43-8e2e-945a929b4660" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36ft^{2}" :db/id #edb/ref 17592186145477}] :answer-field/id #uuid "7c970f91-3016-5244-9680-fa47b3d9ad8e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186145472} {:answer-field/choices [{:answer/id #uuid "0c62a915-4276-57db-8a63-27f35610e126" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36\\,{\\text{ft}}^{2}" :db/id #edb/ref 17592186392806} {:answer/id #uuid "0bfef42c-d56a-5722-b2d8-f7b49fa0bfcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40\\,{\\text{ft}}^{2}" :db/id #edb/ref 17592186392807} {:answer/id #uuid "fbadcc5d-ef99-5cdf-90c9-7093b52691c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24\\,{\\text{ft}}^{2}" :db/id #edb/ref 17592186392808} {:answer/id #uuid "276a0529-d987-5db6-83be-2028c8e08e75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32\\,{\\text{ft}}^{2}" :db/id #edb/ref 17592186392809} {:answer/id #uuid "36fd2e7a-ea93-51ed-a558-c240ada5c964" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25\\,{\\text{ft}}^{2}" :db/id #edb/ref 17592186392810}] :answer-field/correct {:answer/id #uuid "276a0529-d987-5db6-83be-2028c8e08e75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32\\,{\\text{ft}}^{2}" :db/id #edb/ref 17592186392809} :answer-field/id #uuid "4bd9e8a6-49c6-5c2b-8193-1c3fddac210a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392805}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "afc6c730-43c5-56ca-913e-065a04d0dcda" :question/math-academy-id "q-62051" :question/problem "![](images/9e/9e36e33a8d00ff486762e0eafad6e1420fab27f8721c7bdd1d1d6c6062cd1332.png)\n\nDave unfolds a cardboard box and gets the net shown above. In the figure, the areas of two of its faces are shown. What is the total surface area of the box?" :question/worked-solution "The net shown corresponds to a rectangular prism. The surface area of our prism consists of $2$ squares (base and top) and $4$ rectangles (side faces). \n\nTherefore, we get\n\n$$\n\\begin{aligned}\\text{Surface area} & =2\\times (\\text{Area of the base})+4\\times (\\text{Area of the side}) \\\\  & =2\\times 4+4\\times 6 \\\\  & =8+24 \\\\  & =32\\,{\\text{ft}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186392811 :knowledge-point/_questions [{:db/id #edb/ref 17592186147618 :knowledge-point/id #uuid "1233be4b-7634-5882-9ae5-3200a9da71d8" :knowledge-point/title "Calculating the Surface Area of a Polyhedron Given the Areas of the Faces: Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c6756b1-9c04-53c2-8988-fd64ed444bc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "154\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186392813} {:answer/id #uuid "7246bc39-a4f1-5b94-ba1f-daa3ed6f35e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "172\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186392814} {:answer/id #uuid "71f3b47c-ea13-5d62-a2a5-da4411c368b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "124\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186392815} {:answer/id #uuid "a9dabb67-2280-5ff5-83a3-c11aa82bd237" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "148\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186392816} {:answer/id #uuid "ba34adbb-d578-5bbf-8efa-797cfd602cd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "192\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186392817}] :answer-field/correct {:answer/id #uuid "ba34adbb-d578-5bbf-8efa-797cfd602cd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "192\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186392817} :answer-field/id #uuid "1d067699-acd4-5aa2-807d-ab608abdb9a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392812}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7ddd59ad-58ff-5804-a895-8e6dabf22244" :question/math-academy-id "q-62069" :question/problem "![](images/b9/b9668f2d9988488c64e2bb7edb55ae94b1b84b947e249fbc96c506b1c5095d4d.png)\n\nA manufacturer produces a triangular prism-shaped box to hold chocolate candies. In the figure, the areas of some of the faces are displayed in a net of the prism. What is the total surface area of the box?" :question/requires-calculator true :question/worked-solution "The surface area of our prism consists of $2$ triangles (base and top) and $3$ rectangles (central and side faces). \n\nTherefore, we get\n\n$$\n\\begin{aligned}\\text{Surface area} & =2\\times (\\text{Area of the base})+2\\times (\\text{Area of the side faces}) \\\\  & +1\\times (\\text{Area of the central face}) \\\\  & =2\\times 24+2\\times 45+54 \\\\  & =48+90+54 \\\\  & =192\\,{\\text{cm}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186392818 :knowledge-point/_questions [{:db/id #edb/ref 17592186147622 :knowledge-point/id #uuid "947eb2bb-0443-5740-9d45-847c70877270" :knowledge-point/title "Calculating the Surface Area of a Polyhedron Given Some Lengths"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b7d05a27-bc22-599f-9521-686cccb47526" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16\\,{\\text{m}}^{2}" :db/id #edb/ref 17592186392820} {:answer/id #uuid "b463f199-15d4-5666-95e5-3d376c7e7264" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15\\,{\\text{m}}^{2}" :db/id #edb/ref 17592186392821} {:answer/id #uuid "94740290-e368-5fc3-b155-957695497127" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24\\,{\\text{m}}^{2}" :db/id #edb/ref 17592186392822} {:answer/id #uuid "dda83309-31a3-50ae-8a59-56d809fefee1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18\\,{\\text{m}}^{2}" :db/id #edb/ref 17592186392823} {:answer/id #uuid "950ae5a7-059d-5882-b91e-7d6c0833c44d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,{\\text{m}}^{2}" :db/id #edb/ref 17592186392824}] :answer-field/correct {:answer/id #uuid "dda83309-31a3-50ae-8a59-56d809fefee1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18\\,{\\text{m}}^{2}" :db/id #edb/ref 17592186392823} :answer-field/id #uuid "56ae08df-7b65-5143-b632-e7f82228c84e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392819}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "17e99f21-4a32-5f31-9b6f-4f7bf7f5a533" :question/math-academy-id "q-62107" :question/problem "![](images/24/248ccfcbb3de8ab63622cfaf4c823ae1c1734742f5f8c9f14b1dfae0ff79eed2.png)\n\nWhat is the surface area of the box shown above knowing that  it is $4\\,\\text{m}$ long, $1\\,\\text{m}$ wide, and $1\\,\\text{m}$ tall?" :question/worked-solution "First, let's consider the net of our box.\n\n \n\n![](images/c3/c35bb0f7b049baa569a06532b516436afaf310e28870cfbd4790467d36e54809.png)\n\n$$\n\n$$\n\n \n\nFrom the diagram, we have squares and rectangles.\n\nThe rectangles are $4\\,\\text{m}$ long and $1\\,\\text{m}$ high. So, the area of one rectangle is:\n\n$$\n\\text{Area of the rectangle}=4\\times 1=4\\,{\\text{m}}^{2}.\n$$\n\nThe squares has the side equal to $1\\,\\text{m}.$ Hence, the area of one square is:\n\n$$\n\\text{Area of the square}=1\\times 1=1\\,{\\text{m}}^{2}.\n$$\n\nFinally, the surface area of the box consists of $4$ rectangles and $2$ squares. \n\nTherefore, we get:\n\n$$\n\\begin{aligned}\\text{Surface area} & =4\\times (\\text{Area of the rectangle})+2\\times (\\text{Area of the square}) \\\\  & =4\\times 4+2\\times 1 \\\\  & =16+2 \\\\  & =18\\,{\\text{m}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186147974 :knowledge-point/_questions [{:db/id #edb/ref 17592186147622 :knowledge-point/id #uuid "947eb2bb-0443-5740-9d45-847c70877270" :knowledge-point/title "Calculating the Surface Area of a Polyhedron Given Some Lengths"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b72c2893-dc79-5d0c-af44-8e390dc5bf37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4m^{2}" :db/id #edb/ref 17592186145599} {:answer/id #uuid "bc789964-1f69-55eb-9191-c482bbcea801" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "46m^{2}" :db/id #edb/ref 17592186145600} {:answer/id #uuid "1892b670-32c9-55f6-be01-11e797f24bd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40m^{2}" :db/id #edb/ref 17592186145601} {:answer/id #uuid "4d985f82-1ee8-5b77-a22f-b66745397ac8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36m^{2}" :db/id #edb/ref 17592186145602} {:answer/id #uuid "6309f5f5-662d-5e37-8fbd-11c5b3cbfd7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9m^{2}" :db/id #edb/ref 17592186145603}] :answer-field/id #uuid "0d492551-a431-5a60-82e0-a324c877337e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186145598} {:answer-field/choices [{:answer/id #uuid "f5eac203-93f5-57be-af67-8a783ae0e862" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,{\\text{m}}^{2}" :db/id #edb/ref 17592186392826} {:answer/id #uuid "a641a258-af1f-5702-ad18-89ae178498fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "46\\,{\\text{m}}^{2}" :db/id #edb/ref 17592186392827} {:answer/id #uuid "7749a61c-cb07-5313-b6a7-d0b15011e79c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36\\,{\\text{m}}^{2}" :db/id #edb/ref 17592186392828} {:answer/id #uuid "9132f443-bda0-529f-ad02-e2d4be29dfab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40\\,{\\text{m}}^{2}" :db/id #edb/ref 17592186392829} {:answer/id #uuid "622ce365-406e-57b1-ab9a-397d4b72cb7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\,{\\text{m}}^{2}" :db/id #edb/ref 17592186392830}] :answer-field/correct {:answer/id #uuid "9132f443-bda0-529f-ad02-e2d4be29dfab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40\\,{\\text{m}}^{2}" :db/id #edb/ref 17592186392829} :answer-field/id #uuid "4f220997-6704-5639-ac49-71df6da3aa3c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392825}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8ce742b5-57f4-53b1-882f-51d5011e4a65" :question/math-academy-id "q-62256" :question/problem "![](images/54/54212c293853632fd46716b6216a74c3579bf89349e8b2c5cefafe80e40e42cf.png)\n\nAssuming that all side faces have the same height of $9\\,\\text{m}$, find the total surface area of the square pyramid above using its net." :question/worked-solution "The net of our pyramid is the following.\n\n![](images/09/09eff98ca31b4bb350e2d793dcfa6e6972de25bb3b613c898533068c36fe9a78.png)\n\n$$\n\n$$\n\nFirst, notice that the base of the pyramid is a square with a side equal to $2\\,\\text{m}.$ Hence:\n\n$$\n\\text{Area of the square}=2\\times 2=4\\,{\\text{m}}^{2}.\n$$\n\n \n\nEach side face of our solid is triangle, where the base is $2\\,\\text{m}$ and the height is $9\\,\\text{m}.$ Therefore:\n\n$$\n\\text{Area of the triangle}=\\frac{1}{2}\\times 2\\times 9=9\\,{\\text{m}}^{2}.\n$$\n\nFinally, the surface area of the pyramid consists of $1$ square (base) and $4$ triangles (side faces). \n\nTherefore, we get:\n\n$$\n\\begin{aligned}\\text{Surface area} & =(\\text{Area of the square})+4\\times (\\text{Area of the triangle}) \\\\  & =4+4\\times 9 \\\\  & =4+36 \\\\  & =40\\,{\\text{m}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332975 :knowledge-point/_questions [{:db/id #edb/ref 17592186105924 :knowledge-point/id #uuid "d083b53b-8c39-5785-a250-5649001e822b" :knowledge-point/title "Finding the Area of an Unbounded Region"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26e3e9b2-30da-5e19-b120-8248e1afcbda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186330290} {:answer/id #uuid "45ec2f15-6ebc-5e50-8712-992ca19f1a56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186330577} {:answer/id #uuid "4da25218-ad7f-51ed-b048-045e8346c737" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186330657} {:answer/id #uuid "e22e919d-43dc-5827-8d4a-fc247bc14fb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186331951} {:answer/id #uuid "fc6abdcc-8ab8-5a15-a02c-3eee1e702f2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{3}" :db/id #edb/ref 17592186332168}] :answer-field/correct {:answer/id #uuid "4da25218-ad7f-51ed-b048-045e8346c737" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186330657} :answer-field/id #uuid "90c1b685-9855-5d36-b2a1-699d8820687f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332454}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9e903f6e-202d-503e-bb32-791a5351bf40" :question/math-academy-id "q-6302" :question/problem "Find the total area of the region bounded by the graph of the curve $y=\\frac{{e}^{x}}{{e}^{2x}+1}$ and the $x$-axis." :question/worked-solution "We find the area of the region bounded by the graph of the curve and the $x$-axis by calculating the integral\n\n$$\nA={\\int }_{-\\infty }^{\\infty }\\frac{{e}^{x}}{{e}^{2x}+1}\\,\\text{d}x.\n$$\n\nWe break up the integral as follows:\n\n$$\n{\\int }_{-\\infty }^{\\infty }\\frac{{e}^{x}}{{e}^{2x}+1}\\,\\text{d}x={\\int }_{-\\infty }^{0}\\frac{{e}^{x}}{{e}^{2x}+1}\\,\\text{d}x+{\\int }_{0}^{\\infty }\\frac{{e}^{x}}{{e}^{2x}+1}\\,\\text{d}x\n$$\n\nFirst, we calculate the antiderivative using a substitution. Let  $u={e}^{x}$,  then $\\text{d}u={e}^{x}\\text{d}x.$ Hence,\n\n$$\n\\begin{aligned}\\int \\frac{{e}^{x}}{{e}^{2x}+1}\\,\\text{d}x & =\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =\\operatorname{arctan}⁡u+C \\\\  & =\\operatorname{arctan}⁡{e}^{x}+C.\\end{aligned}\n$$\n\nWe now evaluate the first of the improper integrals, as follows:\n\n$$\n\\begin{aligned}{lim}_{a\\to -\\infty }{\\int }_{a}^{0}\\frac{{e}^{x}}{{e}^{2x}+1}\\,\\text{d}x & ={lim}_{a\\to -\\infty }(\\operatorname{arctan}⁡{e}^{x}){|}_{a}^{0} \\\\  & ={lim}_{a\\to -\\infty }(\\operatorname{arctan}⁡{e}^{0}-\\operatorname{arctan}⁡{e}^{a}) \\\\  & =\\frac{\\pi }{4}-0 \\\\  & =\\frac{\\pi }{4}\\end{aligned}\n$$\n\nNow, notice that the integrand is an **even** function.  Indeed,\n\n$$\n\\begin{aligned}f(-x) & =\\frac{{e}^{-x}}{{e}^{-2x}+1} \\\\  & =\\frac{{e}^{2x}\\cdot {e}^{-x}}{{e}^{2x}\\cdot ({e}^{-2x}+1)} \\\\  & =\\frac{{e}^{x}}{1+{e}^{2x}} \\\\  & =f(x).\\end{aligned}\n$$\n\nThis means that we can immediately deduce that\n\n$$\n{\\int }_{0}^{\\infty }\\frac{{e}^{x}}{{e}^{2x}+1}\\,\\text{d}x=\\frac{\\pi }{4}.\n$$\n\nTherefore, since both improper integrals exist, we conclude that \n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{\\infty }\\frac{{e}^{x}}{{e}^{2x}+1}\\,\\text{d}x & ={\\int }_{-\\infty }^{0}\\frac{{e}^{x}}{{e}^{2x}+1}\\,\\text{d}x+{\\int }_{0}^{\\infty }\\frac{{e}^{x}}{{e}^{2x}+1}\\,\\text{d}x \\\\  & =\\frac{\\pi }{4}+\\frac{\\pi }{4} \\\\  & =\\frac{\\pi }{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332978 :knowledge-point/_questions [{:db/id #edb/ref 17592186179660 :knowledge-point/id #uuid "644b7f09-7f66-50f2-8eba-ef6e009429d0" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient With Many Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ca8c3e7-5ae3-5ac3-bc24-67a492e9b43f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{k}{k+1}" :db/id #edb/ref 17592186331049} {:answer/id #uuid "8020a45c-ebf0-550e-9a75-94ab3c826586" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{k}{k-1}" :db/id #edb/ref 17592186331082} {:answer/id #uuid "b8baf416-dd0e-52f3-9be4-0a07be18cadd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{k}^{2}-1" :db/id #edb/ref 17592186331584} {:answer/id #uuid "ce389467-5889-5de3-a149-3a729b6009e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{k-1}" :db/id #edb/ref 17592186331779} {:answer/id #uuid "f3ff1eff-d4a1-5aab-8a6b-ab663f84363d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{k}{{k}^{2}+1}" :db/id #edb/ref 17592186332099}] :answer-field/correct {:answer/id #uuid "7ca8c3e7-5ae3-5ac3-bc24-67a492e9b43f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{k}{k+1}" :db/id #edb/ref 17592186331049} :answer-field/id #uuid "8cb63b68-5189-5bfc-8303-6f0056f66a6f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332448}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5d87d965-7a80-5703-a7a1-223e8710478a" :question/math-academy-id "q-6398" :question/problem "Given that $k\\ge 1$ is an integer, simplify $\\frac{{k}^{2}(k-1)!}{(k+1)k!}.$" :question/worked-solution "First, we notice that\n\n$$\nk!=k(k-1)!\n$$\n\nThen, we can cancel the $k(k-1)!$ that occurs in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{{k}^{2}(k-1)!}{(k+1)k!} & =\\frac{k\\cdot k(k-1)!}{(k+1)\\cdot k(k-1)!} \\\\  & =\\frac{k\\cdot \\cancel{k(k-1)!}}{(k+1)\\cdot \\cancel{k(k-1)!}} \\\\  & =\\frac{k}{k+1}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186403144 :knowledge-point/_questions [{:db/id #edb/ref 17592186059685 :knowledge-point/id #uuid "993c8fe4-dae9-5dc4-9f94-5012f905e0ee" :knowledge-point/title "Finding the Correct Quadrant for Negative Angles that Contain More Than One Full Rotation"}] :question/answ