#{[{:db/id #edb/ref 17592186396087 :knowledge-point/_questions [{:db/id #edb/ref 17592186087658 :knowledge-point/id #uuid "8b022811-fdd6-56a1-92ee-388e7ea53a4c" :knowledge-point/title "Calculating the Intersection of a Circle With the X-Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b6302339-3d66-5e7b-88a3-48ff6e08f3e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-5,0)$ and $(8,0)$" :db/id #edb/ref 17592186396089} {:answer/id #uuid "bd167719-ad84-5223-8f5d-835bbaa95ad2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-5.5,0)$ and $(7.5,0)$" :db/id #edb/ref 17592186396090} {:answer/id #uuid "30ea2584-387d-5bad-8718-caaee9f8c176" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-6,0)$ and $(8,0)$" :db/id #edb/ref 17592186396091} {:answer/id #uuid "0bca8a34-0b3e-5171-929c-8b379129db00" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-5,0)$ and $(7,0)$" :db/id #edb/ref 17592186396092} {:answer/id #uuid "2d1c78a6-2f99-5181-bd25-00d1a3010a31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-6,0)$ and $(7,0)$" :db/id #edb/ref 17592186396093}] :answer-field/correct {:answer/id #uuid "0bca8a34-0b3e-5171-929c-8b379129db00" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-5,0)$ and $(7,0)$" :db/id #edb/ref 17592186396092} :answer-field/id #uuid "d7f39783-8476-55ac-a74e-97c264bb6280" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396088}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1d50f11f-d6f2-5605-88f1-8c45f7404cb9" :question/math-academy-id "q-15684" :question/problem "![](images/c6/c6d356b443128da569a6b60065769cdb56e2e0059db7b146a3c4035d18a32228.png)\n\nFind the $x$-intercepts of the circle $(x-1)^{2}+(y-3)^{2}=45,$ shown above." :question/worked-solution "We must have $y=0$ at the $x$-intercepts. \n\nSo, we need to substitute $y=0$ into the equation of the circle and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}(x-1)^{2}+(y-3)^{2} & =45 \\\\ (x-1)^{2}+(0-3)^{2} & =45 \\\\ (x-1)^{2}+9 & =45 \\\\ (x-1)^{2} & =36 \\\\ x-1 & =\\pm \\sqrt{36} \\\\ x & =1\\pm 6\\end{aligned}\n$$\n\nTherefore, the $x$-intercepts occur at the points $(-5,0)$ and $(7,0).$"}] [{:db/id #edb/ref 17592186275368 :knowledge-point/_questions [{:db/id #edb/ref 17592186192763 :knowledge-point/id #uuid "522fc628-3f81-566b-b7ce-10c75b626c0e" :knowledge-point/title "Calculating a Related Rate From an Implicitly Defined Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a9d2d74-21f1-5eff-8662-2a7f8e4c946f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186272484} {:answer/id #uuid "14c9cbdc-f441-5f3f-8a3a-2ffd96e7ba7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186272573} {:answer/id #uuid "2fcb4519-42d0-5018-a189-aa12683f2339" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186272812} {:answer/id #uuid "8bff881f-47fa-5929-8b8c-4f7faaecc5e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186273593} {:answer/id #uuid "e795795c-c3d6-55ee-8c95-3f35bcec5a18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186274434}] :answer-field/correct {:answer/id #uuid "14c9cbdc-f441-5f3f-8a3a-2ffd96e7ba7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186272573} :answer-field/id #uuid "5041d469-2bed-5cea-90d1-b2b72ee13c37" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274770}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c693b8ab-204b-5009-870a-6017f0d9a57f" :question/math-academy-id "q-156854" :question/problem "Consider the parabola ${x}^{2}-8y=0.$ Given that $x=x(t),$ $y=y(t),$ and that $\\frac{\\text{d}y}{\\text{d}t}=\\frac{1}{8}$ on the curve at the point $(4,2),$ find the value of  $\\frac{\\text{d}x}{\\text{d}t}$ at that point." :question/worked-solution "Differentiating the given relation with respect to $t$ using implicit differentiation, we get\n\n$$\n\\begin{aligned}{x}^{2}-8y & =0 \\\\ \\frac{\\text{d}}{\\text{d}t}({x}^{2}-8y) & =\\frac{\\text{d}}{\\text{d}t}(0) \\\\ \\frac{\\text{d}}{\\text{d}t}({x}^{2})-\\frac{\\text{d}}{\\text{d}t}(8y) & =0 \\\\ \\frac{\\text{d}x}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{2})-\\frac{\\text{d}y}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}y}(8y) & =0 \\\\ \\frac{\\text{d}x}{\\text{d}t}\\cdot (2x)-\\frac{\\text{d}y}{\\text{d}t}\\cdot 8 & =0.\\end{aligned}\n$$\n\nNow, we substitute the given information $\\frac{\\text{d}y}{\\text{d}t}=\\frac{1}{8},$ $x=4,$ and $y=2,$ and solve $\\frac{\\text{d}x}{\\text{d}t}.$ We get \n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t}\\cdot (2\\cdot (4))-(\\frac{1}{8})\\cdot 8 & =0 \\\\ 8\\cdot \\frac{\\text{d}x}{\\text{d}t}-1 & =0 \\\\ 8\\cdot \\frac{\\text{d}x}{\\text{d}t} & =1 \\\\ \\frac{\\text{d}x}{\\text{d}t} & =\\frac{1}{8}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401076 :knowledge-point/_questions [{:db/id #edb/ref 17592186087660 :knowledge-point/id #uuid "e6f0c89e-fe19-5aaf-9f85-b5f0ff7a344e" :knowledge-point/title "Calculating the Intersection of a Circle With the Y-Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d256b930-0dee-50c4-bd81-41d64217fa7f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,4-\\sqrt{3})$ and $(0,4+\\sqrt{3})$" :db/id #edb/ref 17592186401078} {:answer/id #uuid "2759b4ff-6fe0-5744-9043-700096ff43f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,6-\\sqrt{3})$ and $(0,6+\\sqrt{3})$" :db/id #edb/ref 17592186401079} {:answer/id #uuid "0e3a7f86-7353-5871-ab3c-151f2b4eb6c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,5-\\sqrt{3})$ and $(0,5+\\sqrt{3})$" :db/id #edb/ref 17592186401080} {:answer/id #uuid "4fc673dc-55ce-532c-a658-37120012f1ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,5-\\sqrt{5})$ and $(0,5+\\sqrt{5})$" :db/id #edb/ref 17592186401081} {:answer/id #uuid "01d470c7-780c-5f9a-a462-fc902c6b68dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,4-\\sqrt{5})$ and $(0,4+\\sqrt{5})$" :db/id #edb/ref 17592186401082}] :answer-field/correct {:answer/id #uuid "01d470c7-780c-5f9a-a462-fc902c6b68dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,4-\\sqrt{5})$ and $(0,4+\\sqrt{5})$" :db/id #edb/ref 17592186401082} :answer-field/id #uuid "62252cab-6046-5d37-8592-a5f805f44339" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401077}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b39c00d5-06a8-557a-8fa0-abcc975f62c0" :question/math-academy-id "q-15692" :question/problem "![](images/18/185393f07b920bf9b72799f1c17c4245017b500ff1ca92a0104fe95ce621bde4.png)\n\nFind the $y$-intercepts of the circle $(x-2)^{2}+(y-4)^{2}=9,$ shown above." :question/worked-solution "We must have $x=0$ at the $y$-intercepts. \n\nSo, we need to substitute $x=0$ into the equation of the circle and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}(x-2)^{2}+(y-4)^{2} & =9 \\\\ (0-2)^{2}+(y-4)^{2} & =9 \\\\ 4+(y-4)^{2} & =9 \\\\ (y-4)^{2} & =9-4 \\\\ (y-4)^{2} & =5 \\\\ y-4 & =\\pm \\sqrt{5} \\\\ y & =4\\pm \\sqrt{5}\\end{aligned}\n$$\n\nTherefore, the $y$-intercepts occur at the points $(0,4-\\sqrt{5})$ and $(0,4+\\sqrt{5}).$"}] [{:db/id #edb/ref 17592186064521 :knowledge-point/_questions [{:db/id #edb/ref 17592186064206 :knowledge-point/id #uuid "fc4294d6-3d60-5c9e-a862-863e1d129049" :knowledge-point/title "Integrating a Linear Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "074cbeeb-ceea-5d3a-b261-66c040d68ae2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡|x+1|+C" :db/id #edb/ref 17592186272451} {:answer/id #uuid "55a8292a-df16-5981-a5ea-00451577d189" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡|x+1|+C" :db/id #edb/ref 17592186273116} {:answer/id #uuid "c05838da-c78f-5df1-9575-655f840fa6b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{ln}⁡|x+1|+C" :db/id #edb/ref 17592186274053} {:answer/id #uuid "d783c2de-76be-5361-adef-4dddf883917b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{ln}⁡|x+1|+C" :db/id #edb/ref 17592186274273} {:answer/id #uuid "fb4ef98e-f7e7-56cd-950d-8eb83c1a8061" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|x+1|+C" :db/id #edb/ref 17592186274591}] :answer-field/correct {:answer/id #uuid "55a8292a-df16-5981-a5ea-00451577d189" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡|x+1|+C" :db/id #edb/ref 17592186273116} :answer-field/id #uuid "b72a5c10-3eed-5cd1-8364-3fce07a4be90" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274951}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0fe299cc-e2f3-5032-a27f-6865f6c34c09" :question/math-academy-id "q-15707" :question/problem "$\\int \\frac{2}{x+1}\\,\\text{d}x=$" :question/worked-solution "First, let $u=x+1.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}u=\\text{d}x.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{2}{x+1}\\,\\text{d}x & =2\\int \\frac{1}{x+1}\\,\\text{d}x \\\\  & =2\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡|u|+C \\\\  & =2\\operatorname{ln}⁡|x+1|+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275372 :knowledge-point/_questions [{:db/id #edb/ref 17592186192762 :knowledge-point/id #uuid "1acdfb7b-9e3d-5475-bb07-d5e2944294f2" :knowledge-point/title "Using an Implicitly Defined Curve to Determine a Second Coordinate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09cbcb39-9eb8-5b56-adb4-186c0eb4eae9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186272471} {:answer/id #uuid "62d1aaeb-7c84-5017-b231-33f2a2d056c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186273237} {:answer/id #uuid "6cd4b224-c54a-584f-8e1a-ea2ba00f21a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186273329} {:answer/id #uuid "cabcf74b-392e-5d77-a869-9fd1b15b7f06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186274153} {:answer/id #uuid "fd358105-b4a1-5413-9d3f-a35e3c4b6864" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186274611}] :answer-field/correct {:answer/id #uuid "fd358105-b4a1-5413-9d3f-a35e3c4b6864" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186274611} :answer-field/id #uuid "68d19f0e-89f4-5c95-ad74-a8cd159160db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274814}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5b7b2d65-3545-5cd8-ae15-df2b127811fa" :question/math-academy-id "q-157100" :question/problem "Consider the curve ${x}^{3}-4{y}^{2}-2y=2.$ Given that $x=x(t),$   $y=y(t),$  and that $\\frac{\\text{d}y}{\\text{d}t}=2$ on the curve at the point where $y=1,$ find the value of $\\frac{\\text{d}x}{\\text{d}t}$ at that point." :question/worked-solution "Differentiating the given relation with respect to $t$ using implicit differentiation, we get\n\n$$\n\\begin{aligned}{x}^{3}-4{y}^{2}-2y & =2 \\\\ \\frac{\\text{d}}{\\text{d}t}({x}^{3}-4{y}^{2}-2y) & =\\frac{\\text{d}}{\\text{d}t}(2) \\\\ \\frac{\\text{d}}{\\text{d}t}({x}^{3})-\\frac{\\text{d}}{\\text{d}t}(4{y}^{2}+2y) & =0 \\\\ \\frac{\\text{d}x}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{3})-\\frac{\\text{d}y}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}y}(4{y}^{2}+2y) & =0 \\\\ \\frac{\\text{d}x}{\\text{d}t}\\cdot (3{x}^{2})-\\frac{\\text{d}y}{\\text{d}t}\\cdot (8y+2) & =0.\\end{aligned}\n$$\n\nNow, we substitute the given information $\\frac{\\text{d}y}{\\text{d}t}=2$ and $y=1.$ We get \n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t}\\cdot (3{x}^{2})-2\\cdot 10 & =0.\\end{aligned}\n$$\n\nWe also want to substitute for $x,$ but we are not given this value. However, we can find it by substituting $y=1$ into the equation of the curve.\n\nAt the point where $y=1,$ we have \n\n$$\n\\begin{aligned}{x}^{3}-4\\cdot {1}^{2}-2\\cdot 1 & =2 \\\\ {x}^{3}-6 & =2 \\\\ {x}^{3} & =8 \\\\ x & =2.\\end{aligned}\n$$\n\nFinally, substituting $x=2,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t}\\cdot 3\\cdot {2}^{2}-20 & =0 \\\\ 12\\frac{\\text{d}x}{\\text{d}t} & =20 \\\\ \\frac{\\text{d}x}{\\text{d}t} & =\\frac{5}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275380 :knowledge-point/_questions [{:db/id #edb/ref 17592186192774 :knowledge-point/id #uuid "05dd2261-9fbc-5f6c-8c75-357e656b6e6d" :knowledge-point/title "Using the Equation of a Conic Section to Determine a Second Coordinate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c0c1f6d-c802-52ec-adf3-79b1baa316b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186272779} {:answer/id #uuid "3b4ccb19-50a0-5538-b298-7a9078f8d551" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186272902} {:answer/id #uuid "62e05012-262f-5f12-9ac2-87ebd378b6fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186273238} {:answer/id #uuid "d45f2565-f459-5237-b0c0-3b502a8c085d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186274248} {:answer/id #uuid "fd794b1b-a0ef-5e8b-895b-78e13b5031c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186274616}] :answer-field/correct {:answer/id #uuid "fd794b1b-a0ef-5e8b-895b-78e13b5031c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186274616} :answer-field/id #uuid "d3c261ba-12ef-5eb6-9e1c-42124dad2c45" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275009}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "45953a6e-269b-5deb-849d-0e21825340c6" :question/math-academy-id "q-157223" :question/problem "Consider the section of the parabola ${x}^{2}-4y=4$ that lies in the first quadrant.  Given that $x=x(t),$ $y=y(t),$  and that $\\frac{\\text{d}y}{\\text{d}t}=3$ on the parabola at the point where $y=3,$ find the value of $\\frac{\\text{d}x}{\\text{d}t}$ at that point." :question/worked-solution "Differentiating the given relation with respect to $t$ using implicit differentiation, we get\n\n$$\n\\begin{aligned}{x}^{2}-4y & =4 \\\\ \\frac{\\text{d}}{\\text{d}t}({x}^{2}-4y) & =\\frac{\\text{d}}{\\text{d}t}(4) \\\\ \\frac{\\text{d}}{\\text{d}t}({x}^{2})-\\frac{\\text{d}}{\\text{d}t}(4y) & =0 \\\\ \\frac{\\text{d}x}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{2})-\\frac{\\text{d}y}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}y}(4y) & =0 \\\\ \\frac{\\text{d}x}{\\text{d}t}\\cdot (2x)-\\frac{\\text{d}y}{\\text{d}t}\\cdot 4 & =0.\\end{aligned}\n$$\n\n \n\nNow, we substitute the given information $\\frac{\\text{d}y}{\\text{d}t}=3$ and $y=3.$ We get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t}\\cdot (2x)-(3)\\cdot 4 & =0 \\\\ 2x\\cdot \\frac{\\text{d}x}{\\text{d}t}-12 & =0.\\end{aligned}\n$$\n\nWe also want to substitute for $x,$ but we are not given this value. However, we can find it by substituting $y=3$ into the equation of  the parabola.  \n\nAt the point where $y=3,$ we have \n\n$$\n\\begin{aligned}{x}^{2}-4y & =4 \\\\ {x}^{2}-4\\cdot (3) & =4 \\\\ {x}^{2}-12 & =4 \\\\ {x}^{2} & =16 \\\\ x & =4.\\end{aligned}\n$$\n\nNote that we used $x>0$ since we're only interested in the  first  quadrant. \n\nFinally, substituting $x=4,$ we get \n\n$$\n\\begin{aligned}2x\\cdot \\frac{\\text{d}x}{\\text{d}t}-12 & =0 \\\\ 8\\cdot \\frac{\\text{d}x}{\\text{d}t} & =12 \\\\ \\frac{\\text{d}x}{\\text{d}t} & =\\frac{12}{8} \\\\ \\frac{\\text{d}x}{\\text{d}t} & =\\frac{3}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186101209 :knowledge-point/_questions [{:db/id #edb/ref 17592186100890 :knowledge-point/id #uuid "78dbecb4-68d4-53b0-b47f-f37ce92da896" :knowledge-point/title "Finding the Cartesian Equation of a Curve Defined Parametrically With Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d7810ca-e33f-5d3f-8f99-cc35e16c36f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{y}{2})}^{2}-{(\\frac{x}{3})}^{2}=2\\pi " :db/id #edb/ref 17592186272648} {:answer/id #uuid "8e37f2c5-9169-53fe-b71d-d0dfd5d3531e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{(\\frac{y}{3})}^{2}+{(\\frac{x}{2})}^{2}=1" :db/id #edb/ref 17592186273615} {:answer/id #uuid "c4037945-4011-53b4-b0b4-00e87ba49959" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=6" :db/id #edb/ref 17592186274088} {:answer/id #uuid "e44ee7b9-47c6-5cb0-a376-c176b5ec298d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{y}{3})}^{2}+{(\\frac{x}{2})}^{2}=1" :db/id #edb/ref 17592186274406} {:answer/id #uuid "ebf8aa37-6b95-5381-b808-fe4e44945127" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{y}{2})}^{2}-{(\\frac{x}{3})}^{2}=1" :db/id #edb/ref 17592186274471}] :answer-field/correct {:answer/id #uuid "e44ee7b9-47c6-5cb0-a376-c176b5ec298d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{y}{3})}^{2}+{(\\frac{x}{2})}^{2}=1" :db/id #edb/ref 17592186274406} :answer-field/id #uuid "070cfa41-26cd-55dc-a980-842b8db620c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274648}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0582dce7-ef1a-5cfc-9ee5-447a325b4a34" :question/math-academy-id "q-15752" :question/problem "Find the Cartesian equation of the curve defined parametrically as\n\n$$\nx=2\\operatorname{cos}⁡t,\\,\\,\\,y=3\\operatorname{sin}⁡t,\\,t\\in [0,2\\pi ).\n$$" :question/worked-solution "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=2\\operatorname{cos}⁡t\\, & ⇒\\,\\operatorname{cos}⁡t=\\frac{x}{2} \\\\ y=3\\operatorname{sin}⁡t\\, & ⇒\\,\\operatorname{sin}⁡t=\\frac{y}{3}.\\end{aligned}\n$$\n\nUsing the Pythagorean identity ${sin}^{2}⁡t+{cos}^{2}⁡t=1,$ we get\n\n$$\n\\begin{aligned}{(\\frac{y}{3})}^{2}+{(\\frac{x}{2})}^{2}=1.\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is ${(\\frac{y}{3})}^{2}+{(\\frac{x}{2})}^{2}=1.$"}] [{:db/id #edb/ref 17592186275406 :knowledge-point/_questions [{:db/id #edb/ref 17592186068841 :knowledge-point/id #uuid "74b784e1-ad0e-5cf2-8b02-604a7098c6a9" :knowledge-point/title "Finding General Solutions by Rearranging Then Integrating"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e906697-63fe-5f9c-9695-47b9d1159642" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=K{e}^{1/\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186272921} {:answer/id #uuid "491e2dd7-2197-5bca-8669-100af83cb2d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=K{e}^{\\operatorname{arcsin}⁡x}" :db/id #edb/ref 17592186273009} {:answer/id #uuid "4a2b0b18-1859-5892-ace0-8191af79d18f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=K{e}^{\\operatorname{arctan}⁡x}" :db/id #edb/ref 17592186273016} {:answer/id #uuid "92ec8453-5e27-5368-9ac0-a98e23834e02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=K{e}^{\\operatorname{sin}⁡x}" :db/id #edb/ref 17592186273663} {:answer/id #uuid "b8730d08-4ef6-5d55-ade2-a86a1a24e46f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=K{e}^{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186273986}] :answer-field/correct {:answer/id #uuid "491e2dd7-2197-5bca-8669-100af83cb2d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=K{e}^{\\operatorname{arcsin}⁡x}" :db/id #edb/ref 17592186273009} :answer-field/id #uuid "115fa6bc-8cbf-507c-a94a-1255297d1654" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274666}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6f88ec76-892c-5986-98b6-3866ba9a8457" :question/math-academy-id "q-158010" :question/problem "Find the general solution to the differential equation $\\sqrt{1-{x}^{2}}\\,{y}^{′}-y=0$ for $y\\ne 0$ and $|x|<1.$" :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}\\sqrt{1-{x}^{2}}\\,{y}^{′}-y & =0 \\\\ \\sqrt{1-{x}^{2}}\\,\\frac{\\text{d}y}{\\text{d}x}-y & =0 \\\\ \\sqrt{1-{x}^{2}}\\,\\frac{\\text{d}y}{\\text{d}x} & =y \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{\\sqrt{1-{x}^{2}}}\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\text{d}y & =\\int \\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\ \\operatorname{ln}⁡|y| & =\\operatorname{arcsin}⁡x+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\operatorname{ln}⁡|y|=\\operatorname{arcsin}⁡x+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡|y| & =\\operatorname{arcsin}⁡x+C \\\\ |y| & ={e}^{\\operatorname{arcsin}⁡x+C} \\\\ |y| & ={e}^{\\operatorname{arcsin}⁡x}\\cdot {e}^{C} \\\\ |y| & =K{e}^{\\operatorname{arcsin}⁡x}\\end{aligned}\n$$\n\nwhere $K={e}^{C}$ and $K>0.$\n\nWe can drop the absolute value bars by allowing $K$ to be either positive or negative. Therefore, the most general solution is\n\n$$\n\\begin{aligned}y & =K{e}^{\\operatorname{arcsin}⁡x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275407 :knowledge-point/_questions [{:db/id #edb/ref 17592186068840 :knowledge-point/id #uuid "16f0876a-33f0-5c6b-9195-8b9a0a550655" :knowledge-point/title "Finding a General Solution in Explicit Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46c59991-7a2a-5f22-a893-e1cd23ff3aae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\sqrt[3]{{x}^{2}+C}" :db/id #edb/ref 17592186272993} {:answer/id #uuid "5cc9c947-fac1-5eb0-93a8-ce473b0e579a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\sqrt[3]{2x+C}" :db/id #edb/ref 17592186273185} {:answer/id #uuid "6a59d67a-5461-5f00-bbb9-b66319e8bd0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{2}{3}x+C" :db/id #edb/ref 17592186273304} {:answer/id #uuid "71bcc40b-d574-5391-8487-43c9455497a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=({x}^{2}+C)^{3}" :db/id #edb/ref 17592186273364} {:answer/id #uuid "e4680ae6-1495-57dd-a494-1cc9894aadf3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=(\\sqrt[3]{x}+C)^{2}" :db/id #edb/ref 17592186274408}] :answer-field/correct {:answer/id #uuid "46c59991-7a2a-5f22-a893-e1cd23ff3aae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\sqrt[3]{{x}^{2}+C}" :db/id #edb/ref 17592186272993} :answer-field/id #uuid "4ab142bb-121a-5834-81c7-b4ae5d3fdcbd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274761}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "088db977-5f34-5d61-a165-97cdc5e6df38" :question/math-academy-id "q-158012" :question/problem "Find the general solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}=\\frac{2x}{3{y}^{2}}.$" :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{2x}{3{y}^{2}} \\\\ 3{y}^{2}\\,\\frac{\\text{d}y}{\\text{d}x} & =2x\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int 3{y}^{2}\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int 2x\\,\\text{d}x \\\\ \\int 3{y}^{2}\\,\\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int 2x\\,\\text{d}x \\\\ \\int 3{y}^{2}\\,\\text{d}y & =\\int 2x\\,\\text{d}x \\\\ {y}^{3} & ={x}^{2}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n{y}^{3}={x}^{2}+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\ny=\\sqrt[3]{{x}^{2}+C}.\n$$"}] [{:db/id #edb/ref 17592186275409 :knowledge-point/_questions [{:db/id #edb/ref 17592186068840 :knowledge-point/id #uuid "16f0876a-33f0-5c6b-9195-8b9a0a550655" :knowledge-point/title "Finding a General Solution in Explicit Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18e3c6b0-0e58-5c33-8744-40f2dcdff54e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=K{e}^{\\operatorname{sin}⁡x}" :db/id #edb/ref 17592186272603} {:answer/id #uuid "78f4f93b-be8f-5c4d-a519-6d99d4fba770" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=K{e}^{-2\\operatorname{sin}⁡x}" :db/id #edb/ref 17592186273424} {:answer/id #uuid "8883ebfa-4000-5edd-9354-c90407ee9c40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-\\operatorname{cos}⁡x}+K" :db/id #edb/ref 17592186273559} {:answer/id #uuid "952e6dd1-43ff-54f6-9de1-fd7289574d4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=K{e}^{\\operatorname{cos}⁡x}" :db/id #edb/ref 17592186273685} {:answer/id #uuid "e21a3412-a805-5477-baaf-507c3b52c7c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{\\operatorname{sin}⁡x}+K" :db/id #edb/ref 17592186274386}] :answer-field/correct {:answer/id #uuid "18e3c6b0-0e58-5c33-8744-40f2dcdff54e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=K{e}^{\\operatorname{sin}⁡x}" :db/id #edb/ref 17592186272603} :answer-field/id #uuid "379ffcc8-e905-5697-a128-ee6a8efb7a2d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274732}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2c6ab8c9-fca1-56b1-82a8-98c4fa9f8c2c" :question/math-academy-id "q-158014" :question/problem "Find the general solution to the differential equation ${y}^{′}=y\\operatorname{cos}⁡x$ for $y\\ne 0.$" :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}{y}^{′} & =y\\operatorname{cos}⁡x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =y\\operatorname{cos}⁡x \\\\ \\frac{1}{y}\\,\\frac{\\text{d}y}{\\text{d}x} & =\\operatorname{cos}⁡x\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{y}\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\text{d}y & =\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\ \\operatorname{ln}⁡|y| & =\\operatorname{sin}⁡x+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\operatorname{ln}⁡|y|=\\operatorname{sin}⁡x+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\n\\begin{aligned}{e}^{\\operatorname{ln}⁡|y|} & ={e}^{\\operatorname{sin}⁡x+C} \\\\ |y| & ={e}^{\\operatorname{sin}⁡x+C} \\\\ |y| & ={e}^{\\operatorname{sin}⁡x}\\cdot {e}^{C} \\\\ |y| & =K{e}^{\\operatorname{sin}⁡x},\\end{aligned}\n$$\n\nwhere $K={e}^{C}$ and $K>0.$\n\nWe can drop the absolute value bars by allowing $K$ to be either positive or negative. Therefore, the most general solution is\n\n$$\ny=K{e}^{\\operatorname{sin}⁡x}.\n$$"}] [{:db/id #edb/ref 17592186275414 :knowledge-point/_questions [{:db/id #edb/ref 17592186068842 :knowledge-point/id #uuid "c0d908f1-591e-5cb6-afc5-fa7ec44ec326" :knowledge-point/title "Separating the Variables in a Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "494ae645-dd79-56e3-beb4-47a6995c7d8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\cdot \\frac{\\text{d}y}{\\text{d}x}={e}^{x}" :db/id #edb/ref 17592186273011} {:answer/id #uuid "531a24d3-1d14-5b43-9a4f-2e858901dbc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-x}}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x}=1" :db/id #edb/ref 17592186273093} {:answer/id #uuid "6dd02c4a-ba52-56b7-a30a-66ebd3e84513" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-x}\\cdot \\frac{\\text{d}y}{\\text{d}x}=y" :db/id #edb/ref 17592186273339} {:answer/id #uuid "98601ac4-2a74-546e-8308-acabc08e7566" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{x}\\cdot \\frac{\\text{d}y}{\\text{d}x}=y" :db/id #edb/ref 17592186273709} {:answer/id #uuid "a8ffb26a-9163-59ae-8b17-526b2d86e380" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x}={e}^{x}" :db/id #edb/ref 17592186273847}] :answer-field/correct {:answer/id #uuid "a8ffb26a-9163-59ae-8b17-526b2d86e380" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x}={e}^{x}" :db/id #edb/ref 17592186273847} :answer-field/id #uuid "21ba5489-b345-5d21-a343-3f8e76c8cf24" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274699}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4c68a380-7f42-5c23-811b-3bce1cfeb2f0" :question/math-academy-id "q-158022" :question/problem "Separate the variables in the following differential equation: \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=y{e}^{x}\n$$" :question/worked-solution "A differentiable equation is *separable* if it can be written in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=h(x)g(y).\n$$\n\nIf an equation is separable, we say that the variables are *separated* when it is written in the form\n\n$$\n\\frac{1}{g(y)}\\cdot \\frac{\\text{d}y}{\\text{d}x}=h(x).\n$$\n\nNotice that our differentiable equation is separable since it can be written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={e}^{x}\\cdot y.\n$$\n\nTherefore, we separate the variables as follows:\n\n$$\n\\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x}={e}^{x}\n$$"}] [{:db/id #edb/ref 17592186275429 :knowledge-point/_questions [{:db/id #edb/ref 17592186176059 :knowledge-point/id #uuid "d4b378b0-30e5-59a8-b9f7-882b5e226a2e" :knowledge-point/title "Utilizing the Evenness Property of the Secant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5853255d-444b-562b-bf17-f13ce1a296c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{7}}{7}" :db/id #edb/ref 17592186273145} {:answer/id #uuid "60d72189-d83a-5207-899f-d9efeb80163a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186273223} {:answer/id #uuid "9e8ce348-c0e6-5db4-aad5-d94aea1f6bd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{7}" :db/id #edb/ref 17592186273756} {:answer/id #uuid "a7a91683-6c61-50b8-ad58-3b8483a81bb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186273838} {:answer/id #uuid "e066a281-d3ca-591f-b3a6-a1f3553eab86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186274368}] :answer-field/correct {:answer/id #uuid "60d72189-d83a-5207-899f-d9efeb80163a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186273223} :answer-field/id #uuid "29c0579e-93c1-5f6a-b530-c6c2b74ddb44" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274707}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dc90373f-5a39-5101-be93-517f135c4a77" :question/math-academy-id "q-158049" :question/problem "If $\\operatorname{sec}⁡a=\\sqrt{7},$ then $\\operatorname{sec}⁡(-a+20\\pi )=$" :question/worked-solution "First, let's recall the graph of $y=\\operatorname{sec}⁡x.$\n\n![](images/fb/fbf6ef1ca91f998ab4dc2dda1890ffc8a713f2eeff19e5569351b2466256d63a.png)\n\nFrom the graph, we note the following:\n\n- The period of $\\operatorname{sec}⁡x$ is $2\\pi .$\n\n- Our graph is symmetric about the $y$-axis. This means that $\\operatorname{sec}⁡x$ is an *even* function, and we have\n\n$$\n\\operatorname{sec}⁡(-x)=\\operatorname{sec}⁡x.\n$$\n\nLet's now evaluate our expression:\n\n- Firstly, using the periodicity of $\\operatorname{sec}⁡x,$ we have\n\n$$\n\\begin{aligned}\\operatorname{sec}⁡(-a+20\\pi ) & =\\operatorname{sec}⁡(-a+2\\pi \\cdot 10) \\\\  & =\\operatorname{sec}⁡(-a).\\end{aligned}\n$$\n\n- Secondly, using the evenness of $\\operatorname{sec}⁡x,$ we have\n\n$$\n\\begin{aligned}\\operatorname{sec}⁡(-a) & =\\operatorname{sec}⁡a \\\\  & =\\sqrt{7}.\\end{aligned}\n$$\n\nTherefore, $\\operatorname{sec}⁡(-a+20\\pi )=\\sqrt{7}.$"}] [{:db/id #edb/ref 17592186401104 :knowledge-point/_questions [{:db/id #edb/ref 17592186087782 :knowledge-point/id #uuid "e44305e5-b7e3-5ae2-925c-9329f37823b8" :knowledge-point/title "Finding the Points of Intersection of a Circle with a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21c893f0-7ed9-50d0-9479-4bfb6c5c6906" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-4,-2)$ and $(1,0)$" :db/id #edb/ref 17592186401106} {:answer/id #uuid "5e681a2e-8cd8-5ca9-b5d3-8777f4728c3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-4,-2)$ and $(2,0)$" :db/id #edb/ref 17592186401107} {:answer/id #uuid "075c1360-2993-54ea-a5ab-60fe6486955e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-3,-1)$ and $(1,0)$" :db/id #edb/ref 17592186401108} {:answer/id #uuid "fa1e5ed6-4c6c-5020-bbc5-7c83a63fb116" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-3,-1)$ and $(2,0)$" :db/id #edb/ref 17592186401109} {:answer/id #uuid "d396b6f8-3098-5eff-a463-bdfe23d65067" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-4,-1)$ and $(2,0)$" :db/id #edb/ref 17592186401110}] :answer-field/correct {:answer/id #uuid "5e681a2e-8cd8-5ca9-b5d3-8777f4728c3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-4,-2)$ and $(2,0)$" :db/id #edb/ref 17592186401107} :answer-field/id #uuid "0c104c61-200a-5174-998d-683d5dd55c83" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401105}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cfa05974-d33e-5f3c-90f3-bf0b329bfc3f" :question/math-academy-id "q-15805" :question/problem "![](images/de/de12c0b5be8318cc21c62615d24125998c22d55d37abafdee37c103c3840cb71.png)\n\nFind the points where the circle ${x}^{2}+(y+4)^{2}=20$ intersects the line $x-3y=2$ (sketched above)." :question/worked-solution "First, we rearrange the equation $x-3y=2,$ as follows:\n\n$$\ny=\\frac{x}{3}-\\frac{2}{3}\n$$\n\nTo find $x$-coordinates of the intersection points, we need to substitute $y=\\frac{x}{3}-\\frac{2}{3}$ into the equation of the circle and solve the resulting equation for $x:$ \n\n$$\n\\begin{aligned}{x}^{2}+(y+4)^{2} & =20 \\\\ {x}^{2}+{(\\frac{x}{3}-\\frac{2}{3}+4)}^{2} & =20 \\\\ {x}^{2}+{(\\frac{x}{3}+\\frac{10}{3})}^{2} & =20 \\\\ {x}^{2}+\\frac{{x}^{2}}{9}+\\frac{20x}{9}+\\frac{100}{9} & =20 \\\\ \\frac{10{x}^{2}}{9}+\\frac{20x}{9}+\\frac{100}{9} & =20 \\\\ {x}^{2}+2x+10 & =18 \\\\ {x}^{2}+2x-8 & =0 \\\\ (x+4)(x-2) & =0 \\\\ x & =-4,2.\\end{aligned}\n$$\n\nTo find the $y$-coordinates of the intersection points, we need to substitute $x=-4,2$ into the equation of the line and compute $y$-values. Start with $x=-4$:\n\n$$\n\\begin{aligned}y & =\\frac{x}{3}-\\frac{2}{3} \\\\  & =-\\frac{4}{3}-\\frac{2}{3} \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, the first intersection point is $(-4,-2).$ Next, we plug in $x=2$:\n\n$$\n\\begin{aligned}y & =\\frac{x}{3}-\\frac{2}{3} \\\\  & =\\frac{2}{3}-\\frac{2}{3} \\\\  & =0.\\end{aligned}\n$$\n\nSo, the second intersection point is $(2,0).$\n\nTherefore, the line $x-3y=2$ intersects the circle ${x}^{2}+(y+4)^{2}=20$ at the points $(-4,-2)$ and $(2,0).$"}] [{:db/id #edb/ref 17592186275432 :knowledge-point/_questions [{:db/id #edb/ref 17592186176061 :knowledge-point/id #uuid "b0251566-4dfc-5786-b00a-ce609e5b2698" :knowledge-point/title "Utilizing the Oddness Property of the Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1308c252-3f5f-5a02-be87-52593ac89917" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186272558} {:answer/id #uuid "33cb8823-ce66-5677-84d7-89e4c81c03e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{5}" :db/id #edb/ref 17592186272846} {:answer/id #uuid "9ccbdf46-9ee5-5738-a68a-6a4c7e94d746" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186273746} {:answer/id #uuid "c35f06e3-925e-57a7-8e44-c7ad3fa649fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186274082} {:answer/id #uuid "e42382ea-4217-5fb3-b74a-833c31fad439" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186274404}] :answer-field/correct {:answer/id #uuid "e42382ea-4217-5fb3-b74a-833c31fad439" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186274404} :answer-field/id #uuid "d811a9a8-c409-5b01-851f-64933cb4d3b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275015}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0221b117-6ad9-5a2f-80bb-79e143dc5ca6" :question/math-academy-id "q-158055" :question/problem "If $cot⁡x=\\frac{5}{2},$ then $cot⁡(-x)=$" :question/worked-solution "First, let's recall the graph of $y=cot⁡x.$\n\n![](images/6e/6eb672fe024f024f20c7c3c80947d1b47bade8f998e705d6f411ae3f298ecde2.png)\n\nOur graph has rotational symmetry of order $2$ about the origin. If we rotate the graph ${180}^{∘}$ around the origin, we get the same picture. This means that $cot⁡x$ is an *odd* function, and we have\n\n$$\ncot⁡(-x)=-cot⁡x.\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}cot⁡(-x) & =-cot⁡x \\\\  & =-\\frac{5}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275434 :knowledge-point/_questions [{:db/id #edb/ref 17592186176057 :knowledge-point/id #uuid "94645507-186a-54a7-a96b-ccfb0fb1f769" :knowledge-point/title "Utilizing the Evenness Property of the Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "275f4184-6614-5fb5-b945-c0a925615360" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186272735} {:answer/id #uuid "8a7df9b3-60b6-5ef6-8973-d6465d2aa3e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi -\\frac{1}{2}" :db/id #edb/ref 17592186273582} {:answer/id #uuid "8f1e5805-1c6c-5d57-b929-84303eb5f147" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186273626} {:answer/id #uuid "ae068c2c-1302-562e-8e3f-5924d2a8dd0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186273888} {:answer/id #uuid "b395db12-bd50-557e-ae1c-0cff707eab03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186273938}] :answer-field/correct {:answer/id #uuid "b395db12-bd50-557e-ae1c-0cff707eab03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186273938} :answer-field/id #uuid "ea032dc8-afc8-5574-9882-b42bbb63200d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275047}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a595d8eb-425e-5670-9569-3c6cc685c869" :question/math-academy-id "q-158059" :question/problem "If $cos⁡x=0,$ then $\\pi cos⁡(-x+18\\pi )-\\frac{1}{2}=$" :question/worked-solution "First, let's recall the graph of $y=cos⁡x.$\n\n![](images/23/2373daf4b5fd26f098bf90e998e2685db6a8b793e94ac9d80b08ea423cb535c0.png)\n\nFrom the graph, we note the following:\n\n- The period of $cos⁡x$ is $2\\pi .$\n\n- Our graph is symmetric over the $y$-axis. This means that $cos⁡x$ is an *even* function, and we have\n\n$$\ncos⁡(-x)=cos⁡x.\n$$\n\nLet's now evaluate our expression:\n\n- Firstly, using the periodicity of $cos⁡x,$ we have\n\n$$\n\\begin{aligned}cos⁡(-x+18\\pi ) & =cos⁡(-x+2\\pi \\cdot 9) \\\\  & =cos⁡(-x).\\end{aligned}\n$$\n\n- Secondly, using the evenness of $cos⁡x,$ we have\n\n$$\n\\begin{aligned}cos⁡(-x) & =cos⁡x \\\\  & =0.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\pi cos⁡(-x+18\\pi )-\\frac{1}{2} & =\\pi \\cdot 0-\\frac{1}{2} \\\\  & =0-\\frac{1}{2} \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275436 :knowledge-point/_questions [{:db/id #edb/ref 17592186176061 :knowledge-point/id #uuid "b0251566-4dfc-5786-b00a-ce609e5b2698" :knowledge-point/title "Utilizing the Oddness Property of the Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b4110e0-8cbe-509f-8768-e57ad22b3e55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186272490} {:answer/id #uuid "0dfc4511-a4c7-5555-89b3-9b7095440042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186272509} {:answer/id #uuid "8fd51020-1a5c-56db-8c08-63b63d83c079" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186273636} {:answer/id #uuid "bf721ced-4517-5626-a108-41e175743956" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186274043} {:answer/id #uuid "e6d362da-9dbc-5d76-bebd-946b5b66ed7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186274426}] :answer-field/correct {:answer/id #uuid "0dfc4511-a4c7-5555-89b3-9b7095440042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186272509} :answer-field/id #uuid "2b3c6ee6-6e94-558d-95c0-4e54abe1c6d9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274710}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2a79aaf7-1dcc-57ab-a0b7-6d93a2b468da" :question/math-academy-id "q-158064" :question/problem "If $cot⁡x=-6,$ then $\\frac{1}{2}cot⁡(-x+15\\pi )+7=$" :question/worked-solution "First, let's recall the graph of $y=cot⁡x.$\n\n![](images/6e/6eb672fe024f024f20c7c3c80947d1b47bade8f998e705d6f411ae3f298ecde2.png)\n\nFrom the graph, we note the following:\n\n- The period of $cot⁡x$ is $\\pi .$\n\n- Our graph has rotational symmetry of order $2$ about the origin. This means that $cot⁡x$ is an *odd* function, and we have\n\n$$\ncot⁡(-x)=-cot⁡x.\n$$\n\nLet's now evaluate our expression:\n\n- Firstly, using the periodicity of $cot⁡x,$ we have\n\n$$\n\\begin{aligned}cot⁡(-x+15\\pi ) & =cot⁡(-x+\\pi \\cdot 15) \\\\  & =cot⁡(-x).\\end{aligned}\n$$\n\n- Secondly, using the oddness of $cot⁡x,$ we have\n\n$$\n\\begin{aligned}cot⁡(-x) & =-cot⁡x \\\\  & =-(-6) \\\\  & =6.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{2}cot⁡(-x+15\\pi )+7 & =\\frac{1}{2}\\cdot 6+7 \\\\  & =\\frac{6}{2}+7 \\\\  & =3+7 \\\\  & =10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275437 :knowledge-point/_questions [{:db/id #edb/ref 17592186176060 :knowledge-point/id #uuid "48a710f9-fed1-5fdb-b4c0-fd3ae2d4d8a4" :knowledge-point/title "Utilizing the Oddness Property of the Cosecant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c7814cb-8a14-543c-b191-090e1d7ec186" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186272638} {:answer/id #uuid "912d0bf4-9153-5eaf-8129-ed93f063eca1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{11}" :db/id #edb/ref 17592186273648} {:answer/id #uuid "979f59c9-f61f-5d15-890f-5f7e912c17f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{4}" :db/id #edb/ref 17592186273701} {:answer/id #uuid "e9c841e0-0d84-5ffb-afef-0ed443247d86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{4}" :db/id #edb/ref 17592186274456} {:answer/id #uuid "fb39b869-1aff-5ccd-a39a-e66bfc83a392" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{4}" :db/id #edb/ref 17592186274590}] :answer-field/correct {:answer/id #uuid "e9c841e0-0d84-5ffb-afef-0ed443247d86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{4}" :db/id #edb/ref 17592186274456} :answer-field/id #uuid "ca6a7db3-5479-511f-aa28-280da1724856" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274989}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "990fed19-47aa-5e1c-b060-215e7bc1b3ed" :question/math-academy-id "q-158065" :question/problem "If $\\operatorname{csc}⁡a=\\frac{11}{4},$ then $\\operatorname{csc}⁡(-a)=$" :question/worked-solution "First, let's recall the graph of $y=\\operatorname{csc}⁡x.$\n\n![](images/a8/a8e7894ea970c539ca59a73713fa15450f4361b3fc8bc22183e3fe84946411bd.png)\n\nOur graph has rotational symmetry of order $2$ about the origin. If we rotate the graph ${180}^{∘}$ around the origin, we get the same picture. This means that $\\operatorname{csc}⁡x$ is an *odd* function, and we have\n\n$$\n\\operatorname{csc}⁡(-x)=-\\operatorname{csc}⁡x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{csc}⁡(-a) & =-\\operatorname{csc}⁡a \\\\  & =-\\frac{11}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275440 :knowledge-point/_questions [{:db/id #edb/ref 17592186176060 :knowledge-point/id #uuid "48a710f9-fed1-5fdb-b4c0-fd3ae2d4d8a4" :knowledge-point/title "Utilizing the Oddness Property of the Cosecant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ce714d8-554b-5354-a70c-c88220f6cb42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{3}" :db/id #edb/ref 17592186273331} {:answer/id #uuid "a1025211-77b5-5b03-8606-c8562215708e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186273783} {:answer/id #uuid "a5e066f7-00a4-56e3-bec2-634660c4b3dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{3}" :db/id #edb/ref 17592186273822} {:answer/id #uuid "cf0b140a-f05b-50c4-992b-d9f86cd91f5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186274189} {:answer/id #uuid "ed579fc1-af8b-5a45-be91-452681696d91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{6}" :db/id #edb/ref 17592186274486}] :answer-field/correct {:answer/id #uuid "6ce714d8-554b-5354-a70c-c88220f6cb42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{3}" :db/id #edb/ref 17592186273331} :answer-field/id #uuid "cbe91a72-b803-5369-bdce-e9dc3475245a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274992}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "52fb1c00-a770-5c09-ab79-cdf019b59f0c" :question/math-academy-id "q-158071" :question/problem "If $\\operatorname{csc}⁡x=\\frac{7}{6},$ then $4\\operatorname{csc}⁡(-x+6\\pi )+1=$" :question/worked-solution "First, let's recall the graph of $y=\\operatorname{csc}⁡x.$\n\n![](images/a8/a8e7894ea970c539ca59a73713fa15450f4361b3fc8bc22183e3fe84946411bd.png)\n\nFrom the graph, we note the following:\n\n- The period of $\\operatorname{csc}⁡x$ is $2\\pi .$\n\n- Our graph has rotational symmetry of order $2$ about the origin. This means that $\\operatorname{csc}⁡x$ is an *odd* function, and we have\n\n$$\n\\operatorname{csc}⁡(-x)=-\\operatorname{csc}⁡x.\n$$\n\nLet's now evaluate our expression:\n\n- Firstly, using the periodicity of $\\operatorname{csc}⁡x,$ we have\n\n$$\n\\begin{aligned}\\operatorname{csc}⁡(-x+6\\pi ) & =\\operatorname{csc}⁡(-x+2\\pi \\cdot 3) \\\\  & =\\operatorname{csc}⁡(-x).\\end{aligned}\n$$\n\n- Secondly, using the oddness of $\\operatorname{csc}⁡x,$ we have\n\n$$\n\\begin{aligned}\\operatorname{csc}⁡(-x) & =-\\operatorname{csc}⁡x \\\\  & =-\\frac{7}{6}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}4\\operatorname{csc}⁡(-x+6\\pi )+1 & =4(-\\frac{7}{6})+1 \\\\  & =-\\frac{14}{3}+1 \\\\  & =-\\frac{11}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275446 :knowledge-point/_questions [{:db/id #edb/ref 17592186119932 :knowledge-point/id #uuid "3118d2af-771f-54c9-b18e-5196b87b6dca" :knowledge-point/title "Computing the Volume of an N-Dimensional Parallelepiped"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d8d63a0-e6e8-5621-b14e-0a6afb7468b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "112" :db/id #edb/ref 17592186272792} {:answer/id #uuid "4e356ba3-0766-580b-b544-969b6db926d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "93" :db/id #edb/ref 17592186273046} {:answer/id #uuid "6a9af943-2e3a-56aa-a3d4-69f1c9aa6ac3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "105" :db/id #edb/ref 17592186273306} {:answer/id #uuid "7b178126-366e-5772-8fae-0734a917447f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186273443} {:answer/id #uuid "e3683848-ab39-5f23-91ed-e22f1d4d80fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186274398}] :answer-field/correct {:answer/id #uuid "6a9af943-2e3a-56aa-a3d4-69f1c9aa6ac3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "105" :db/id #edb/ref 17592186273306} :answer-field/id #uuid "16f94c49-7116-5254-8071-00edbc36756c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274676}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "32e6e8c1-9b26-5825-ac5f-18dfd683a674" :question/math-academy-id "q-158108" :question/problem "Calculate the volume of the $4$-dimensional parallelepiped spanned by the vectors\n\n$$\na=[\\begin{aligned}7 \\\\ -2 \\\\ 5 \\\\ 3\\end{aligned}],\\,b=[\\begin{aligned}0 \\\\ 3 \\\\ 4 \\\\ -2\\end{aligned}],\\,c=[\\begin{aligned}0 \\\\ 0 \\\\ -1 \\\\ 2\\end{aligned}],\\,d=[\\begin{aligned}0 \\\\ 0 \\\\ 0 \\\\ 5\\end{aligned}].\n$$" :question/worked-solution "First, let's construct the matrix $M,$ whose columns are the coordinates of our vectors $a,$ $b,$ $c,$ and  $d:$\n\n$$\nM=[\\begin{aligned}7 & 0 & 0 & 0 \\\\ -2 & 3 & 0 & 0 \\\\ 5 & 4 & -1 & 0 \\\\ 3 & -2 & 2 & 5\\end{aligned}]\n$$\n\nThe volume of the parallelepiped spanned by these vectors equals the absolute value of the determinant of $M:$\n\n$$\nV=|det(M)|\n$$\n\nThe determinant of a triangular matrix is equal to the product of the entries on the main diagonal. So, we have\n\n$$\ndet(M)=[\\begin{aligned}7 & 0 & 0 & 0 \\\\ -2 & 3 & 0 & 0 \\\\ 5 & 4 & -1 & 0 \\\\ 3 & -2 & 2 & 5\\end{aligned}]=7\\cdot 3\\cdot (-1)\\cdot 5=-105.\n$$\n\nTherefore, the volume is\n\n$$\nV=|det(M)|=|-105|=105.\n$$"}] [{:db/id #edb/ref 17592186275456 :knowledge-point/_questions [{:db/id #edb/ref 17592186124637 :knowledge-point/id #uuid "9e4fd256-a726-523c-84dc-f62d4e2711cc" :knowledge-point/title "Sketching the Domain of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2af093ec-bae8-5f02-ba64-69ec4eb07e90" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/30/3070e936fea02f7c02b2e6bc780534b80108db28836c4c4615954e8063590867.png" :db/id #edb/ref 17592186272766} {:answer/id #uuid "a256b260-fed0-59a9-a2a1-4c844aa7d23c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/45/45c170dbe0048816d6490ff39c6144d3ac42298dff9c2fa71cb22217d358ce1a.png" :db/id #edb/ref 17592186273792} {:answer/id #uuid "b3c94091-efa3-5941-be60-4cf65defa0fe" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2d/2ddf4edfd91b14835e7b14ca8cebf08b82b8585d9fd18972c8b065d6153a62f0.png" :db/id #edb/ref 17592186273944} {:answer/id #uuid "d9e66f66-040b-5940-b7d6-5c2fb64af2da" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f0/f04a668ae876db9e3a26f8ce7cc8bfcaac1149ee221622c22343483fd89f7f44.png" :db/id #edb/ref 17592186274289} {:answer/id #uuid "f48cab61-19c1-5819-88f0-cfed8ebe8ac6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b4/b49f91c2047e8ce566bc50febf7a3e445c26938a3869247ad1dc3ff5a60215ed.png" :db/id #edb/ref 17592186274547}] :answer-field/correct {:answer/id #uuid "f48cab61-19c1-5819-88f0-cfed8ebe8ac6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b4/b49f91c2047e8ce566bc50febf7a3e445c26938a3869247ad1dc3ff5a60215ed.png" :db/id #edb/ref 17592186274547} :answer-field/id #uuid "7b28e1b1-75de-5680-8cd3-ceafe25f75a4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274846}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a90460ca-8a09-5a2d-bb95-26ae2a0e2a46" :question/math-academy-id "q-158198" :question/problem "Which of the following shaded regions corresponds to the domain of the function $f(x,y)=\\sqrt{{x}^{2}-{y}^{2}}?$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression under the square root is non-negative.\n\nAs a result, the points in the domain must satisfy the following inequalities:\n\n$$\n{x}^{2}-{y}^{2}\\ge 0\\,⟹\\,{y}^{2}\\le {x}^{2}\\,⟹\\,-|x|\\le y\\le |x|\n$$\n\nTherefore, the domain is\n\n$$\nD={(x,y)\\in {R}^{2}\\,:\\,-|x|\\le y\\le |x|}.\n$$\n\nSince the inequality involves the $\\le $ sign, the curves are part of the domain. Therefore, we draw the solid curves $y=-|x|$ and $y=|x|,$ and shade the area *below* the curve $y=|x|,$ and *above* the curve $y=-|x|.$\n\nThe resulting domain is as follows:\n\n![](images/95/95f187d2857973e4fea83eedf47bd54c153ce2a77f278cfb992b222de2d91ab8.png)"}] [{:db/id #edb/ref 17592186388981 :knowledge-point/_questions [{:db/id #edb/ref 17592186124637 :knowledge-point/id #uuid "9e4fd256-a726-523c-84dc-f62d4e2711cc" :knowledge-point/title "Sketching the Domain of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c5fbd44c-edf5-56b4-9863-36a35f3b9ad3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9f/9f4dd7da9adf7ec5580f4e866fdf094e90e87425ce435feae6dc41488e6518bf.png" :db/id #edb/ref 17592186388983} {:answer/id #uuid "dce09265-cac3-50b1-9938-d4e109c7378c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3e/3e55fa4f75253935fb3f372dd82612b241d1133aceaa51666fdb0513decba8ea.png" :db/id #edb/ref 17592186388984} {:answer/id #uuid "6e38f214-36b2-5226-88a7-d7314eed1c5a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/64/6431427a27685248942ae4ac998feeb8f38d210b63e7f4c429ce3a5bf9afd1e5.png" :db/id #edb/ref 17592186388985} {:answer/id #uuid "aea45356-e834-5306-9e4b-0c712e35b96f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/04/04b8028809192321180e05f2e86c5e149b4870ddb0adea7e3191e2db33f12133.png" :db/id #edb/ref 17592186388986} {:answer/id #uuid "283aafa9-a98b-5196-ab68-7113c77960e4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/91/91094f3f8fc9b21724e4e6d0f33e2ec0dc18782b3cc0aa1d4b1e4226e4bb93bc.png" :db/id #edb/ref 17592186388987}] :answer-field/correct {:answer/id #uuid "dce09265-cac3-50b1-9938-d4e109c7378c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3e/3e55fa4f75253935fb3f372dd82612b241d1133aceaa51666fdb0513decba8ea.png" :db/id #edb/ref 17592186388984} :answer-field/id #uuid "c35e8875-bbf9-5e5f-bc9a-34467a284be5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388982}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ddc33dd3-a1a1-567c-a9d1-d5d15d54e87f" :question/math-academy-id "q-158200" :question/problem "Which of the following shaded regions corresponds to the domain of the function $g(x,y)=\\frac{y}{2-x}?$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n2-x\\ne 0\\,⟹\\,x\\ne 2\n$$\n\nTherefore, the domain is\n\n$$\nD={(x,y)\\in {R}^{2}\\,:\\,x\\ne 2}.\n$$\n\nSince the expression involves the $\\ne $ sign, the line is *not* part of the domain. Therefore, we draw the dashed line $x=2$ and shade *right* and *left* the line.\n\nThe resulting domain is as follows:\n\n![](images/23/2371c9724d66e0f7d74c45e173f9625a986615185c10d55c029976baa82d0877.png)"}] [{:db/id #edb/ref 17592186275457 :knowledge-point/_questions [{:db/id #edb/ref 17592186059651 :knowledge-point/id #uuid "23637774-8d69-500d-8cb0-5e41a0207542" :knowledge-point/title "Simplifying Rational Expressions Using an Alternate Form of the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43fdec51-bb15-58a1-ac35-a4628bdaa895" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186272966} {:answer/id #uuid "7bc399b8-24ed-566b-807a-98321753ba77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186273449} {:answer/id #uuid "c672699b-78d4-5fd4-9230-acc5ec657314" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186274108} {:answer/id #uuid "e7b57a70-f0e5-5f77-8a9c-b1e730d2744a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186274436} {:answer/id #uuid "e9793388-0d77-54db-82ac-a9919ac4db9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186274452}] :answer-field/correct {:answer/id #uuid "43fdec51-bb15-58a1-ac35-a4628bdaa895" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186272966} :answer-field/id #uuid "80c6b84b-18ea-5a42-80cf-65bc4466c515" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274854}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d8d55196-4015-578e-afc9-4c54361316e6" :question/math-academy-id "q-1583" :question/problem "$\\frac{1}{{cos}^{2}⁡A}-\\frac{1}{{cot}^{2}⁡A}=$" :question/worked-solution "First, we use the definition of $\\operatorname{cot}⁡A$ to rewrite the second term:\n\n$$\n\\begin{aligned}\\frac{1}{{cos}^{2}⁡A}-\\frac{1}{{cot}^{2}⁡A} & =\\frac{1}{{cos}^{2}⁡A}-{tan}^{2}⁡A \\\\  & =\\frac{1}{{cos}^{2}⁡A}-\\frac{{sin}^{2}⁡A}{{cos}^{2}⁡A} \\\\  & =\\frac{1-{sin}^{2}⁡A}{{cos}^{2}⁡A}\\end{aligned}\n$$\n\nNow, we can use the identity $1-{sin}^{2}⁡A={cos}^{2}⁡A$:\n\n$$\n\\begin{aligned}\\frac{1-{sin}^{2}⁡A}{{cos}^{2}⁡A} & =\\frac{{cos}^{2}⁡A}{{cos}^{2}⁡A}=1\\end{aligned}\n$$\n\nTherefore, we conclude that:\n\n$$\n\\frac{1}{{cos}^{2}⁡A}-\\frac{1}{{cot}^{2}⁡A}=1\n$$"}] [{:db/id #edb/ref 17592186369845 :knowledge-point/_questions [{:db/id #edb/ref 17592186119932 :knowledge-point/id #uuid "3118d2af-771f-54c9-b18e-5196b87b6dca" :knowledge-point/title "Computing the Volume of an N-Dimensional Parallelepiped"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ca3fc2b-bad0-5b4b-bc00-408085561cc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186369847} {:answer/id #uuid "a6c7791b-9b12-5dd6-9d19-547ef87dd6a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186369848} {:answer/id #uuid "c232025a-ca14-5a4a-9e9f-a8ff81b74a6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186369849} {:answer/id #uuid "9e6c71c2-2201-52f2-abf4-3b33cdc6feea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186369850} {:answer/id #uuid "1571cd95-16d4-5e7a-a516-2378f040ff5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186369851}] :answer-field/correct {:answer/id #uuid "4ca3fc2b-bad0-5b4b-bc00-408085561cc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186369847} :answer-field/id #uuid "10725161-b676-53dc-8bff-5c967c1e8dfa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369846}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9fc304b0-a53d-5a62-b8cd-1ca341a43179" :question/math-academy-id "q-158367" :question/problem "Calculate the volume of the $4$-dimensional parallelepiped spanned by the vectors\n\n$$\na=[\\begin{aligned}4 \\\\ -5 \\\\ 2 \\\\ 0\\end{aligned}],\\,b=[\\begin{aligned}5 \\\\ 7 \\\\ -2 \\\\ -1\\end{aligned}],\\,c=[\\begin{aligned}0 \\\\ 3 \\\\ 2 \\\\ 0\\end{aligned}],\\,d=[\\begin{aligned}0 \\\\ 0 \\\\ 1 \\\\ 0\\end{aligned}].\n$$" :question/worked-solution "First, let's construct the matrix $M,$ whose columns are the coordinates of our vectors $a,$ $b,$ $c,$ and  $d:$\n\n$$\nM=[\\begin{aligned}4 & 5 & 0 & 0 \\\\ -5 & 7 & 3 & 0 \\\\ 2 & -2 & 2 & 1 \\\\ 0 & -1 & 0 & 0\\end{aligned}]\n$$\n\nThe volume of the parallelepiped spanned by these vectors equals the absolute value of the determinant of $M:$\n\n$$\nV=|det(M)|\n$$\n\nNotice that the $4$th row of the determinant contains three zeros. So, using Laplace expansion along the $4$th row, we have\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}4 & 5 & 0 & 0 \\\\ -5 & 7 & 3 & 0 \\\\ 2 & -2 & 2 & 1 \\\\ 0 & -1 & 0 & 0\\end{aligned}| \\\\  & =-1\\cdot (-1)^{4+2}|\\begin{aligned}4 & 0 & 0 \\\\ -5 & 3 & 0 \\\\ 2 & 2 & 1\\end{aligned}| \\\\  & =-|\\begin{aligned}4 & 0 & 0 \\\\ -5 & 3 & 0 \\\\ 2 & 2 & 1\\end{aligned}|.\\end{aligned}\n$$\n\nThe determinant of a triangular matrix is equal to the product of the entries on the main diagonal. Therefore, we have\n\n$$\n\\begin{aligned}det(M) & =-|\\begin{aligned}4 & 0 & 0 \\\\ -5 & 3 & 0 \\\\ 2 & 2 & 1\\end{aligned}| \\\\  & =-1\\cdot 4\\cdot 3\\cdot 1 \\\\  & =-12\\end{aligned}\n$$\n\nTherefore, the volume is\n\n$$\nV=|det(M)|=|-12|=12.\n$$"}] [{:db/id #edb/ref 17592186275470 :knowledge-point/_questions [{:db/id #edb/ref 17592186119932 :knowledge-point/id #uuid "3118d2af-771f-54c9-b18e-5196b87b6dca" :knowledge-point/title "Computing the Volume of an N-Dimensional Parallelepiped"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cb8b630-1858-5675-a8ea-afd745123540" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186272641} {:answer/id #uuid "25136c9e-920f-566e-a408-ea4a7af1ef37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "352" :db/id #edb/ref 17592186272712} {:answer/id #uuid "28f41079-6423-5124-b7dd-2b748bc5ac50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186272753} {:answer/id #uuid "37c41e9d-c90b-5532-80b8-70fb57bf191a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "176" :db/id #edb/ref 17592186272875} {:answer/id #uuid "39e96dc4-16ab-55e3-b742-85d0597e033b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "128" :db/id #edb/ref 17592186272890}] :answer-field/correct {:answer/id #uuid "39e96dc4-16ab-55e3-b742-85d0597e033b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "128" :db/id #edb/ref 17592186272890} :answer-field/id #uuid "2a3f55ee-40e6-566b-9375-89a8f6437390" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274708}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "94fb05dd-7b6c-5fef-becd-0abc3ccf0dc9" :question/math-academy-id "q-158371" :question/problem "Calculate the volume of the $4$-dimensional parallelepiped spanned by the vectors\n\n$$\na=[\\begin{aligned}0 \\\\ -2 \\\\ 0 \\\\ -3\\end{aligned}],\\,b=[\\begin{aligned}2 \\\\ 7 \\\\ 5 \\\\ 5\\end{aligned}],\\,c=[\\begin{aligned}0 \\\\ 10 \\\\ 0 \\\\ 7\\end{aligned}],\\,d=[\\begin{aligned}0 \\\\ 3 \\\\ 4 \\\\ 2\\end{aligned}].\n$$" :question/worked-solution "First, let's construct the matrix $M,$ whose columns are the coordinates of our vectors $a,$ $b,$ $c,$ and  $d:$\n\n$$\nM=[\\begin{aligned}0 & 2 & 0 & 0 \\\\ -2 & 7 & 10 & 3 \\\\ 0 & 5 & 0 & 4 \\\\ -3 & 5 & 7 & 2\\end{aligned}]\n$$\n\nThe volume of the parallelepiped spanned by these vectors equals the absolute value of the determinant of $M:$\n\n$$\nV=|det(M)|\n$$\n\nNotice that the $1$st row of the determinant contains three zeros. So, using Laplace expansion along the $1$st row, we have\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}0 & 2 & 0 & 0 \\\\ -2 & 7 & 10 & 3 \\\\ 0 & 5 & 0 & 4 \\\\ -3 & 5 & 7 & 2\\end{aligned}| \\\\  & =2\\cdot (-1)^{1+2}|\\begin{aligned}-2 & 10 & 3 \\\\ 0 & 0 & 4 \\\\ -3 & 7 & 2\\end{aligned}| \\\\  & =-2|\\begin{aligned}-2 & 10 & 3 \\\\ 0 & 0 & 4 \\\\ -3 & 7 & 2\\end{aligned}|.\\end{aligned}\n$$\n\nNow, notice that the $2$nd row of the $3\\times 3$ determinant contains two zeros. So, using Laplace expansion along the $2$nd row, we have\n\n$$\n\\begin{aligned}det(M) & =-2|\\begin{aligned}-2 & 10 & 3 \\\\ 0 & 0 & 4 \\\\ -3 & 7 & 2\\end{aligned}| \\\\  & =-2\\cdot 4\\cdot (-1)^{2+3}|\\begin{aligned}-2 & 10 \\\\ -3 & 7\\end{aligned}| \\\\  & =8|\\begin{aligned}-2 & 10 \\\\ -3 & 7\\end{aligned}| \\\\  & =8(-14+30) \\\\  & =128.\\end{aligned}\n$$\n\nTherefore, the volume is\n\n$$\nV=|det(M)|=|128|=128.\n$$"}] [{:db/id #edb/ref 17592186278183 :knowledge-point/_questions [{:db/id #edb/ref 17592186152188 :knowledge-point/id #uuid "6e75170b-1e28-52c1-b0ab-f50ffde6c262" :knowledge-point/title "The Cartesian Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "044aa764-a402-587b-9d4c-b41637dfa030" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{36}-\\frac{{x}^{2}}{4}=1" :db/id #edb/ref 17592186275516} {:answer/id #uuid "8324a325-41e1-54bc-8b74-1c52b4799e1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{36}=1" :db/id #edb/ref 17592186276657} {:answer/id #uuid "c4127d31-6dc3-521f-8215-809b40a67775" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}=1" :db/id #edb/ref 17592186277220} {:answer/id #uuid "d2c6cd3a-dd09-5f85-a646-0e12c483a833" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}-\\frac{{y}^{2}}{36}=1" :db/id #edb/ref 17592186277337} {:answer/id #uuid "e2c3aad5-29e3-5b96-b737-92612b8b8109" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{36}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186277461}] :answer-field/correct {:answer/id #uuid "e2c3aad5-29e3-5b96-b737-92612b8b8109" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{36}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186277461} :answer-field/id #uuid "17b8f849-09df-52e8-a517-f7b406de368f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277767}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "48febb37-71be-5629-b005-ff375ac1902f" :question/math-academy-id "q-15843" :question/problem "Determine the Cartesian equation of the ellipse\n\n$$\nx=6\\operatorname{cos}⁡\\theta ,\\,y=2\\operatorname{sin}⁡\\theta ,\\,0\\le \\theta <2\\pi .\n$$" :question/worked-solution "To find the Cartesian equation of the ellipse, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =6\\operatorname{cos}⁡\\theta  \\\\ \\frac{x}{6} & =\\operatorname{cos}⁡\\theta  \\\\ \\frac{{x}^{2}}{{6}^{2}} & ={cos}^{2}⁡\\theta  \\\\ \\frac{{x}^{2}}{36} & ={cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}y & =2\\operatorname{sin}⁡\\theta  \\\\ \\frac{y}{2} & =\\operatorname{sin}⁡\\theta  \\\\ \\frac{{y}^{2}}{{2}^{2}} & ={sin}^{2}⁡\\theta  \\\\ \\frac{{y}^{2}}{4} & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\n \nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{36}+\\frac{{y}^{2}}{4} & ={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1.\\end{aligned}\n$$\n\nSo the Cartesian equation of the ellipse is\n\n$$\n\\frac{{x}^{2}}{36}+\\frac{{y}^{2}}{4}=1.\n$$"}] [{:db/id #edb/ref 17592186106055 :knowledge-point/_questions [{:db/id #edb/ref 17592186105886 :knowledge-point/id #uuid "f59bd7df-afa9-5dcf-9dab-fc7f3cf291fa" :knowledge-point/title "Determining the Value of an Unknown Constant Given a PDF"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21af3edc-3323-554a-bca0-c25456bef3a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186275782} {:answer/id #uuid "570dae43-0ab0-58ae-84d9-65901a7c41b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186276255} {:answer/id #uuid "900dc292-41a8-5398-9c59-94c9060331f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186276780} {:answer/id #uuid "9fe329c6-b978-58eb-96d6-ef0bb8c82ee6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186276918} {:answer/id #uuid "b3f3da64-a53b-5cfa-890d-f8da21171141" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186277087}] :answer-field/correct {:answer/id #uuid "570dae43-0ab0-58ae-84d9-65901a7c41b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186276255} :answer-field/id #uuid "73f910f0-310b-59fc-93fc-e2425f5aa705" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277929}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3535bc96-e0a2-5dcb-9a5f-4a6bf759302b" :question/math-academy-id "q-158437" :question/problem "Solve for $k$ given that the following function is a probability density function:\n\n$$\nf(x)={\\begin{aligned}\\frac{{x}^{2}}{4}+k,\\, & 0<x<2, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a function $f(x)$ to be a valid probability density function on a set $S,$ it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- ${\\int }_{S}f(x)\\,\\text{d}x=1$\n\nFor the given function, the second condition states that\n\n$$\n{\\int }_{0}^{2}(\\frac{{x}^{2}}{4}+k)\\,\\text{d}x=1.\n$$\n\nComputing the integral on the left-hand side, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}(\\frac{{x}^{2}}{4}+k)\\,\\text{d}x & ={[\\frac{1}{12}{x}^{3}+kx]}_{0}^{2} \\\\  & =[\\frac{8}{12}+2k]-[0+0] \\\\  & =\\frac{2}{3}+2k.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{2}{3}+2k=1\\,⟹\\,k=\\frac{1}{6}.\n$$"}] [{:db/id #edb/ref 17592186124808 :knowledge-point/_questions [{:db/id #edb/ref 17592186124640 :knowledge-point/id #uuid "88f2bc84-03e8-5921-81e2-683a09195279" :knowledge-point/title "The Domain of a Function Containing Exponential, Logarithmic, and Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "587f5542-5a27-517a-84b1-e66f5d47860c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}<1}" :db/id #edb/ref 17592186276271} {:answer/id #uuid "5a4ffc4d-b07e-549b-a751-a3d91ba357d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}>0}" :db/id #edb/ref 17592186276289} {:answer/id #uuid "77583919-d19f-5129-8df8-e7e6b74fea75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}>1}" :db/id #edb/ref 17592186276559} {:answer/id #uuid "7efc28bb-059b-500e-87f9-668f0875eb75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy$-plane" :db/id #edb/ref 17592186276629} {:answer/id #uuid "f617ba46-61de-54bf-a41e-c0e566ae9f74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x\\ne y}" :db/id #edb/ref 17592186277631}] :answer-field/correct {:answer/id #uuid "7efc28bb-059b-500e-87f9-668f0875eb75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy$-plane" :db/id #edb/ref 17592186276629} :answer-field/id #uuid "f77abaf8-7358-5457-b8b2-4285d46b13bf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278159}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "80d6d429-d2f8-586a-b19e-c50b52dbc8e3" :question/math-academy-id "q-158438" :question/problem "Find the domain of the function $f(x,y)={e}^{{x}^{2}-{y}^{2}}.$" :question/worked-solution "Notice that\n\n- ${x}^{2}-{y}^{2}$ is defined for all $x$ and $y,$ and\n\n- ${e}^{g(x,y)}$ is defined if $g(x,y)$ is defined.\n\nAs a result, ${e}^{{x}^{2}-{y}^{2}}$ is defined for all values of $x$ and $y.$ This means that the domain of $f$ is the entire $xy$-plane."}] [{:db/id #edb/ref 17592186369859 :knowledge-point/_questions [{:db/id #edb/ref 17592186105886 :knowledge-point/id #uuid "f59bd7df-afa9-5dcf-9dab-fc7f3cf291fa" :knowledge-point/title "Determining the Value of an Unknown Constant Given a PDF"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5fa62dd2-b0c7-5d84-9d22-decbfe7c3d62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186369861} {:answer/id #uuid "9a2809d5-b0a6-5909-8b19-67d21b2cf85d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186369862} {:answer/id #uuid "5acf1a1f-a6ef-514f-8acc-ff08cda8690f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186369863} {:answer/id #uuid "a4fd4552-6bd6-501b-be53-4c059be4aaf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186369864} {:answer/id #uuid "9ea75817-ef2f-5f2f-9943-1818c631b13b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186369865}] :answer-field/correct {:answer/id #uuid "9ea75817-ef2f-5f2f-9943-1818c631b13b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186369865} :answer-field/id #uuid "527d4c6b-012b-5461-8a47-41cb9dad1d47" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369860}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4be0ea46-3e0b-59c9-8186-85d4514aa6ab" :question/math-academy-id "q-158440" :question/problem "Solve for $k$ given that the following function is a probability density function:\n\n$$\nf(x)={\\begin{aligned}\\frac{{x}^{3}}{k},\\, & 0\\le x<2, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a function $f(x)$ to be a valid probability density function on a set $S,$ it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- ${\\int }_{S}f(x)\\,\\text{d}x=1$\n\nFor the given function, the second condition states that\n\n$$\n{\\int }_{0}^{2}\\frac{{x}^{3}}{k}\\,\\text{d}x=1.\n$$\n\nComputing the integral on the left-hand side, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}\\frac{{x}^{3}}{k}\\,\\text{d}x & ={[\\frac{{x}^{4}}{4k}]}_{0}^{2} \\\\  & =(\\frac{16}{4k}-0) \\\\  & =\\frac{4}{k}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{4}{k}=1\\,⟹\\,k=4.\n$$"}] [{:db/id #edb/ref 17592186278191 :knowledge-point/_questions [{:db/id #edb/ref 17592186105886 :knowledge-point/id #uuid "f59bd7df-afa9-5dcf-9dab-fc7f3cf291fa" :knowledge-point/title "Determining the Value of an Unknown Constant Given a PDF"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d46a99b-9aed-5723-ae0f-4c64551e3f94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186275588} {:answer/id #uuid "47db744f-f0b3-5760-896a-049544b6375a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186276112} {:answer/id #uuid "7a49c651-4a95-5c0c-b6a3-3b8cdc26b296" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186276587} {:answer/id #uuid "8415d956-a817-53c4-8f60-93416a12acc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186276662} {:answer/id #uuid "9f3492e5-9010-5a95-8437-b5d792b01884" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186276909}] :answer-field/correct {:answer/id #uuid "7a49c651-4a95-5c0c-b6a3-3b8cdc26b296" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186276587} :answer-field/id #uuid "86517bcb-97bd-5ba9-8706-7572bc681126" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277964}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c1741b28-dd7a-521f-bff9-3881fb7d5bb4" :question/math-academy-id "q-158447" :question/problem "Solve for $k$ given that the following function is a probability density function:\n\n$$\nf(x)={\\begin{aligned}\\frac{{x}^{2}+1}{k},\\, & 1<x<4, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a function $f(x)$ to be a valid probability density function on a set $S,$ it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- ${\\int }_{S}f(x)\\,\\text{d}x=1$\n\nFor the given function, the second condition states that\n\n$$\n{\\int }_{1}^{4}\\frac{{x}^{2}+1}{k}\\,\\text{d}x=1.\n$$\n\nComputing the integral on the left-hand side, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}\\frac{{x}^{2}+1}{k}\\,\\text{d}x & =\\frac{1}{k}{\\int }_{1}^{4}({x}^{2}+1)\\,\\text{d}x \\\\  & =\\frac{1}{k}{[\\frac{{x}^{3}}{3}+x]}_{1}^{4} \\\\  & =\\frac{1}{k}([\\frac{64}{3}+4]-[\\frac{1}{3}+1]) \\\\  & =\\frac{1}{k}(21+3) \\\\  & =\\frac{24}{k}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{24}{k}=1\\,⟹\\,k=24.\n$$"}] [{:db/id #edb/ref 17592186378780 :knowledge-point/_questions [{:db/id #edb/ref 17592186124636 :knowledge-point/id #uuid "0e593685-f5ca-5501-94bf-7cb4d49e935b" :knowledge-point/title "The Domain of a Function Involving Reciprocals and Radicals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b856f2fe-9b4f-5951-916a-b4d19c357b08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x\\ne -2}" :db/id #edb/ref 17592186378782} {:answer/id #uuid "95be0e3e-e128-579b-b71f-de9310a30a7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x>-2}" :db/id #edb/ref 17592186378783} {:answer/id #uuid "222f06f9-0369-5850-a115-1a00d293c72a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy-$plane" :db/id #edb/ref 17592186378784} {:answer/id #uuid "9830c844-b778-546b-88b6-640c2ad92084" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x\\ge -2}" :db/id #edb/ref 17592186378785} {:answer/id #uuid "0f86fae6-db40-56f5-beae-fae3b622dcc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x>-2,\\,y=0}" :db/id #edb/ref 17592186378786}] :answer-field/correct {:answer/id #uuid "95be0e3e-e128-579b-b71f-de9310a30a7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x>-2}" :db/id #edb/ref 17592186378783} :answer-field/id #uuid "fedade10-2b0e-5184-8ff4-3f0fcf478542" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378781}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7c169bcc-a581-55f9-b4fe-8fe294bcd657" :question/math-academy-id "q-158559" :question/problem "Find the domain of the function $z=\\frac{{x}^{2}+3y}{\\sqrt{x+2}}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression in the denominator is not equal to zero, and\n\n- the expression under the square root is non-negative.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\nx+2>0\\,⟹\\,x>-2\n$$\n\nTherefore, the domain is\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,x>-2}.\n$$"}] [{:db/id #edb/ref 17592186378787 :knowledge-point/_questions [{:db/id #edb/ref 17592186124636 :knowledge-point/id #uuid "0e593685-f5ca-5501-94bf-7cb4d49e935b" :knowledge-point/title "The Domain of a Function Involving Reciprocals and Radicals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "186ffedd-8963-5331-8dee-228ee0b2bf5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy-$plane" :db/id #edb/ref 17592186378789} {:answer/id #uuid "a664ed89-b412-50db-9336-b5a981dbd51f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y<-2,\\,y\\ne 2{x}^{3}}" :db/id #edb/ref 17592186378790} {:answer/id #uuid "04de4494-092a-59be-bf41-05a523518384" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y\\ge 2,\\,y>2{x}^{3}}" :db/id #edb/ref 17592186378791} {:answer/id #uuid "2a3506b2-6406-50dd-b036-ea7413383d2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y\\ge -2,\\,y\\ne 2{x}^{3}}" :db/id #edb/ref 17592186378792} {:answer/id #uuid "7299cc62-a05d-5895-ac7d-c3f9ab0cf70f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y\\ge -2,\\,y>2{x}^{3}}" :db/id #edb/ref 17592186378793}] :answer-field/correct {:answer/id #uuid "2a3506b2-6406-50dd-b036-ea7413383d2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y\\ge -2,\\,y\\ne 2{x}^{3}}" :db/id #edb/ref 17592186378792} :answer-field/id #uuid "d18fb94b-0aa1-5189-9b62-680a65bf7d2f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378788}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "44bfd95c-9ee8-5b8e-91af-f8c6e58bbec3" :question/math-academy-id "q-158563" :question/problem "Find the domain of the function $z=\\frac{\\sqrt{y+2}}{2{x}^{3}-y}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression in the denominator is not equal to zero, and\n\n- the expression under the square root is non-negative.\n\nAs a result, the points in the domain must satisfy the following inequalities:\n\n$$\n{\\begin{aligned}y+2\\ge 0 \\\\ 2{x}^{3}-y\\ne 0\\end{aligned}\\,⟹\\,{\\begin{aligned}y\\ge -2 \\\\ y\\ne 2{x}^{3}\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,y\\ge -2,\\,y\\ne 2{x}^{3}}.\n$$"}] [{:db/id #edb/ref 17592186401123 :knowledge-point/_questions [{:db/id #edb/ref 17592186124640 :knowledge-point/id #uuid "88f2bc84-03e8-5921-81e2-683a09195279" :knowledge-point/title "The Domain of a Function Containing Exponential, Logarithmic, and Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d17359d3-8c16-5f6a-b127-4635699145de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y\\ne 2x}" :db/id #edb/ref 17592186401125} {:answer/id #uuid "723d1468-5b49-57b7-aca8-480bc0d17b3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y<2x}" :db/id #edb/ref 17592186401126} {:answer/id #uuid "3ee0d3a5-a4a1-5cee-a062-442dab6411d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y>2x}" :db/id #edb/ref 17592186401127} {:answer/id #uuid "ab4e594f-0e4b-5943-92bb-bf8c40588e8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy$-plane" :db/id #edb/ref 17592186401128} {:answer/id #uuid "20fdbcce-ba79-5860-9e27-a2583b78aa49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y\\ge 2x}" :db/id #edb/ref 17592186401129}] :answer-field/correct {:answer/id #uuid "ab4e594f-0e4b-5943-92bb-bf8c40588e8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The domain is the entire $xy$-plane" :db/id #edb/ref 17592186401128} :answer-field/id #uuid "2a4d4ae3-6796-52c1-a3b7-76a9cd48622e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401124}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d3d7c34b-eed1-5181-a45d-9a598cc7cc31" :question/math-academy-id "q-158569" :question/problem "Find the domain of the function $f(x,y)={2}^{y-2x}.$" :question/worked-solution "Notice that\n\n- $y-2x$ is defined for all $x$ and $y,$ and\n\n- ${2}^{g(x,y)}$ is defined if $g(x,y)$ is defined.\n\nAs a result, ${2}^{y-2x}$ is defined for all values of $x$ and $y.$ This means that the domain of $f$ is the entire $xy$-plane."}] [{:db/id #edb/ref 17592186278213 :knowledge-point/_questions [{:db/id #edb/ref 17592186124638 :knowledge-point/id #uuid "f9289c4d-4f7f-5704-a2cb-272f92d8fef3" :knowledge-point/title "Evaluating a Two-Variable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10745616-0602-5d0a-b702-ddf953b4fd38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186275623} {:answer/id #uuid "2eacecbd-7897-59d9-bb65-2d0a2e156dd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186275896} {:answer/id #uuid "49f2e092-d9b4-56d8-a57b-65f1230599e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186276129} {:answer/id #uuid "6c46acf3-b068-5e7a-af82-06cfd2ae6fd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186276450} {:answer/id #uuid "8db0cfa0-69d5-5323-bda4-d39822ec80f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186276761}] :answer-field/correct {:answer/id #uuid "10745616-0602-5d0a-b702-ddf953b4fd38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186275623} :answer-field/id #uuid "36c223f0-1ac5-50b8-bc16-df19662b3923" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277808}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d225e24f-f8fc-5851-bdaa-9e7972c2ed2f" :question/math-academy-id "q-158574" :question/problem "Evaluate $z=x\\operatorname{ln}⁡y-1$ at the point $(3,{e}^{2}).$" :question/worked-solution "To evaluate our multivariable function at the point $(3,{e}^{2}),$ we substitute $x=3$ and $y={e}^{2}$ into the function expression:\n\n$$\n\\begin{aligned}z\\,{|}_{(3,{e}^{2})} & =(x\\operatorname{ln}⁡y-1){|}_{(3,{e}^{2})} \\\\  & =3\\operatorname{ln}⁡({e}^{2})-1 \\\\  & =3(2\\operatorname{ln}⁡e)-1 \\\\  & =3(2)-1 \\\\  & =6-1 \\\\  & =5\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278217 :knowledge-point/_questions [{:db/id #edb/ref 17592186124638 :knowledge-point/id #uuid "f9289c4d-4f7f-5704-a2cb-272f92d8fef3" :knowledge-point/title "Evaluating a Two-Variable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d179e7e-f303-5e43-9e54-e88411ae105b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186275744} {:answer/id #uuid "46e40daf-130d-5c56-b7c2-fc096cd4aed1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186276104} {:answer/id #uuid "b2806a77-e40d-5b69-bab9-8967e1d6fe69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186277077} {:answer/id #uuid "b68d0a3c-5c93-53b8-8605-a4d0414d525a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186277100} {:answer/id #uuid "fd305dd5-1d3f-5453-8e82-323421970570" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\sqrt{2}" :db/id #edb/ref 17592186277696}] :answer-field/correct {:answer/id #uuid "b68d0a3c-5c93-53b8-8605-a4d0414d525a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186277100} :answer-field/id #uuid "c5402d2d-2d55-5783-b6ed-20607de2fef0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278072}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "64dcbd76-8d54-5023-881a-a57cc6e8bf6c" :question/math-academy-id "q-158592" :question/problem "The function $f(x,y)$ is defined as \n\n$$\nf(x,y)=x\\operatorname{sin}⁡y.\n$$\n\nEvaluate this function at the point $(-6,-\\frac{\\pi }{4}).$" :question/worked-solution "To evaluate our multivariable function at the point $(-6,-\\frac{\\pi }{4}),$ we substitute $x=-6$ and $y=-\\frac{\\pi }{4}$ into the function expression:\n\n$$\n\\begin{aligned}f(-6,-\\frac{\\pi }{4}) & =x\\operatorname{sin}⁡y\\,{|}_{(-6,-\\pi /4)} \\\\  & =-6\\operatorname{sin}⁡(-\\frac{\\pi }{4}) \\\\  & =-6(-\\frac{\\sqrt{2}}{2}) \\\\  & =3\\sqrt{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278230 :knowledge-point/_questions [{:db/id #edb/ref 17592186124643 :knowledge-point/id #uuid "59c3f441-0499-575c-af10-b597d61e6e35" :knowledge-point/title "Partial Derivatives as Limits of Difference Quotients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "383e0bc9-03cf-5a8c-863c-225af3392d9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{\\operatorname{log}⁡(x-h+3y)+\\operatorname{log}⁡(x+3y)}{h})" :db/id #edb/ref 17592186275974} {:answer/id #uuid "7945ffd3-5f05-5457-a797-f97318f811fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{h\\operatorname{log}⁡(x+3y)-\\operatorname{log}⁡(x+3y)}{h})" :db/id #edb/ref 17592186276578} {:answer/id #uuid "b0c9179d-e8b2-536c-b20f-6906f6eca321" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{\\operatorname{log}⁡(x+3h+3y)-\\operatorname{log}⁡(x+3y)}{h})" :db/id #edb/ref 17592186277058} {:answer/id #uuid "c35e4727-2498-5dca-8178-4436cb00df14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{\\operatorname{log}⁡(x+h+3y)-\\operatorname{log}⁡(x+3y)}{h})" :db/id #edb/ref 17592186277214} {:answer/id #uuid "dda4715e-bd12-5ebe-bfef-6060557727a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{\\operatorname{log}⁡(xh+3y)-\\operatorname{log}⁡(x+3y)}{h})" :db/id #edb/ref 17592186277419}] :answer-field/correct {:answer/id #uuid "c35e4727-2498-5dca-8178-4436cb00df14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{\\operatorname{log}⁡(x+h+3y)-\\operatorname{log}⁡(x+3y)}{h})" :db/id #edb/ref 17592186277214} :answer-field/id #uuid "c4ece284-f8fe-594e-b804-399bb52c5e8b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278071}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fdf020b6-22cb-53d4-9f16-5ef52a2ed3d5" :question/math-academy-id "q-159579" :question/problem "Given that $f(x,y)=\\operatorname{log}⁡(x+3y),$ then $\\frac{∂f}{∂x}=$" :question/worked-solution "The partial derivative of $f$ with respect to $x$ is given by the limit \n\n$$\n\\frac{∂f}{∂x}={lim}_{h\\to 0}(\\frac{f(x+h,y)-f(x,y)}{h}).\n$$\n\nSince $f(x)=\\operatorname{log}⁡(x+3y),$  we have that \n\n$$\nf(x+h,y)=\\operatorname{log}⁡(x+h+3y).\n$$\n\nTherefore,\n\n$$\n\\frac{∂f}{∂x}={lim}_{h\\to 0}(\\frac{\\operatorname{log}⁡(x+h+3y)-\\operatorname{log}⁡(x+3y)}{h}).\n$$"}] [{:db/id #edb/ref 17592186381181 :knowledge-point/_questions [{:db/id #edb/ref 17592186124644 :knowledge-point/id #uuid "facdd9e7-8fcb-5ad1-b9c1-82c0f753df1a" :knowledge-point/title "Evaluating a Partial Derivative at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2383a34d-6e32-5f0f-87b8-e7ec3d81fb75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186381183} {:answer/id #uuid "f18943a3-6ebe-57f1-9bae-7fc754040e67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186381184} {:answer/id #uuid "062115ff-ad39-57f6-a416-c53bab27effc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186381185} {:answer/id #uuid "b69cec9b-5a43-5293-af5f-d7b292e1fc03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186381186} {:answer/id #uuid "5f7541dc-dac5-5424-9421-52ce964411eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186381187}] :answer-field/correct {:answer/id #uuid "b69cec9b-5a43-5293-af5f-d7b292e1fc03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186381186} :answer-field/id #uuid "7d6eafe7-491c-520d-9960-7135619c340c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381182}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "83c38041-fc9b-546f-afa6-2d3c332d1b5a" :question/math-academy-id "q-159587" :question/problem "For the function $f(x,y)={y}^{2}\\sqrt{x}+\\frac{x}{y},$ evaluate $\\frac{∂f}{∂y}$ at the point $(4,2).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}({y}^{2}\\sqrt{x}+\\frac{x}{y}) \\\\  & =\\frac{∂}{∂y}({y}^{2}\\sqrt{x}+x{y}^{-1}) \\\\  & =\\frac{∂}{∂y}({y}^{2}\\sqrt{x})+\\frac{∂}{∂y}(x{y}^{-1}) \\\\  & =\\sqrt{x}\\cdot \\frac{∂}{∂y}({y}^{2})+x\\cdot \\frac{∂}{∂y}({y}^{-1}) \\\\  & =\\sqrt{x}\\cdot (2y)+x\\cdot (-{y}^{-2}) \\\\  & =2y\\sqrt{x}-x{y}^{-2}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(4,2):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}{|}_{(4,2)} & =2\\cdot 2\\cdot \\sqrt{4}-4\\cdot {2}^{-2} \\\\  & =8-1 \\\\  & =7\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278232 :knowledge-point/_questions [{:db/id #edb/ref 17592186124643 :knowledge-point/id #uuid "59c3f441-0499-575c-af10-b597d61e6e35" :knowledge-point/title "Partial Derivatives as Limits of Difference Quotients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17151a6a-94bf-55a7-a13b-683abbbb3201" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}[\\frac{1}{h}(\\frac{{x}^{2}}{(y-h+2)^{3}}+\\frac{{x}^{2}}{(y+2)^{3}})]" :db/id #edb/ref 17592186275693} {:answer/id #uuid "88bb8931-3ab4-597f-ac73-5223c606f67e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}[\\frac{1}{h}(\\frac{(x+h)^{2}}{(y+h+2)^{3}}-\\frac{{x}^{2}}{(y+2)^{3}})]" :db/id #edb/ref 17592186276712} {:answer/id #uuid "8b258731-5747-557a-bf41-f3eb922a6546" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}[\\frac{1}{h}(\\frac{{x}^{2}}{(y+h+2)^{3}}-\\frac{{x}^{2}}{(y+2)^{3}})]" :db/id #edb/ref 17592186276738} {:answer/id #uuid "c9b7a87b-e2a5-587c-b8eb-c96fc0270fe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}[\\frac{1}{h}(\\frac{{x}^{2}}{(y+2h)^{3}}-\\frac{{x}^{2}}{(y+2)^{3}})]" :db/id #edb/ref 17592186277269} {:answer/id #uuid "d7dbfd03-ca32-5bda-a9d7-8c6f0318343c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}[\\frac{1}{h}(\\frac{(x+h)^{2}}{(y+2)^{3}}-\\frac{{x}^{2}}{(y+2)^{3}})]" :db/id #edb/ref 17592186277376}] :answer-field/correct {:answer/id #uuid "8b258731-5747-557a-bf41-f3eb922a6546" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}[\\frac{1}{h}(\\frac{{x}^{2}}{(y+h+2)^{3}}-\\frac{{x}^{2}}{(y+2)^{3}})]" :db/id #edb/ref 17592186276738} :answer-field/id #uuid "a188f0c3-15f8-5c12-aa43-1dce2bcf1a25" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278010}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "31a26b77-cde2-5225-9c1c-15176a7705f8" :question/math-academy-id "q-159589" :question/problem "Given that $f(x,y)=\\frac{{x}^{2}}{(y+2)^{3}},$ then $\\frac{∂f}{∂y}=$" :question/worked-solution "The derivative of $f$ with respect to $y$ is given by the limit \n\n$$\n\\frac{∂f}{∂y}={lim}_{h\\to 0}(\\frac{f(x,y+h)-f(x,y)}{h}).\n$$\n\nSince $f(x)=\\frac{{x}^{2}}{(y+2)^{3}},$  we have that \n\n$$\nf(x,y+h)=\\frac{{x}^{2}}{(y+h+2)^{3}}.\n$$\n\nTherefore,\n\n$$\n\\frac{∂f}{∂y}={lim}_{h\\to 0}[\\frac{1}{h}(\\frac{{x}^{2}}{(y+h+2)^{3}}-\\frac{{x}^{2}}{(y+2)^{3}})].\n$$"}] [{:db/id #edb/ref 17592186381195 :knowledge-point/_questions [{:db/id #edb/ref 17592186124644 :knowledge-point/id #uuid "facdd9e7-8fcb-5ad1-b9c1-82c0f753df1a" :knowledge-point/title "Evaluating a Partial Derivative at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cb46f74-a6ac-51dd-9716-053467775795" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186381197} {:answer/id #uuid "7c752b1e-3494-58b3-91b3-bc63d9070f67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186381198} {:answer/id #uuid "ba33d251-da28-523a-a29f-e0b6420aeb9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186381199} {:answer/id #uuid "57c21eba-c639-589d-a590-6b2758f94e7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186381200} {:answer/id #uuid "437f7400-06af-5d12-8795-82aceaaa029f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186381201}] :answer-field/correct {:answer/id #uuid "ba33d251-da28-523a-a29f-e0b6420aeb9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186381199} :answer-field/id #uuid "3bc66302-048f-5b61-a77f-e57947059d3c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381196}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "85a0874e-f8e3-58ee-a763-3ef7eef71825" :question/math-academy-id "q-159600" :question/problem "For the function $f(x,y)=2x\\sqrt{y}-4y\\sqrt{x},$ evaluate $\\frac{∂f}{∂x}$ at the point $(1,4).$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(2x\\sqrt{y}-4y\\sqrt{x}) \\\\  & =\\frac{∂}{∂x}(2x\\sqrt{y})-\\frac{∂}{∂x}(4y\\sqrt{x}) \\\\  & =2\\sqrt{y}\\cdot \\frac{∂}{∂x}(x)-4y\\cdot \\frac{∂}{∂x}(\\sqrt{x}) \\\\  & =2\\sqrt{y}\\cdot (1)-4y\\cdot (\\frac{1}{2\\sqrt{x}}) \\\\  & =2\\sqrt{y}-\\frac{2y}{\\sqrt{x}}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(1,4):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}{|}_{(1,4)} & =2\\sqrt{4}-\\frac{2\\cdot 4}{\\sqrt{1}} \\\\  & =4-8 \\\\  & =-4\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186381223 :knowledge-point/_questions [{:db/id #edb/ref 17592186124639 :knowledge-point/id #uuid "53c5d5d7-40d4-5210-8794-428cffc1f3f9" :knowledge-point/title "Finding Partial Derivatives of Two-Variable Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cc01c4d-160a-5eea-af63-34bb0d6f5cfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5-2\\operatorname{cos}⁡x" :db/id #edb/ref 17592186381225} {:answer/id #uuid "c56e8f59-813f-5140-bc33-6355f2e8c8f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5-2\\operatorname{sin}⁡x" :db/id #edb/ref 17592186381226} {:answer/id #uuid "f4c320e0-173a-55b6-b2fe-6e2df1ef3a1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡x" :db/id #edb/ref 17592186381227} {:answer/id #uuid "23510347-ad72-510f-9453-61fb93eb4c94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5y-2\\operatorname{sin}⁡x" :db/id #edb/ref 17592186381228} {:answer/id #uuid "e9546bf2-57cd-503b-97b1-de16a6c90894" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{cos}⁡x" :db/id #edb/ref 17592186381229}] :answer-field/correct {:answer/id #uuid "e9546bf2-57cd-503b-97b1-de16a6c90894" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{cos}⁡x" :db/id #edb/ref 17592186381229} :answer-field/id #uuid "107fee59-5ae8-5849-9751-9c38f3f036ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381224}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a343ea27-2d89-5c6e-9038-e851b2a44521" :question/math-academy-id "q-159614" :question/problem "Find $\\frac{∂f}{∂x}$ given that $f(x,y)=5y-2\\operatorname{sin}⁡x.$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(5y-2\\operatorname{sin}⁡x) \\\\  & =\\frac{∂}{∂x}(5y)-\\frac{∂}{∂x}(2\\operatorname{sin}⁡x) \\\\  & =5\\cdot \\frac{∂}{∂x}(y)-2\\cdot \\frac{∂}{∂x}(\\operatorname{sin}⁡x) \\\\  & =5\\cdot (0)-2\\cdot (\\operatorname{cos}⁡x) \\\\  & =-2\\operatorname{cos}⁡x\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186381230 :knowledge-point/_questions [{:db/id #edb/ref 17592186124639 :knowledge-point/id #uuid "53c5d5d7-40d4-5210-8794-428cffc1f3f9" :knowledge-point/title "Finding Partial Derivatives of Two-Variable Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42294efd-0726-56da-9ff2-aacaa739035d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4{x}^{3}}{{y}^{5}}+6x" :db/id #edb/ref 17592186381232} {:answer/id #uuid "e692a74c-4360-52d2-9a3b-14b7bb724d4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12{x}^{2}}{{y}^{4}}+6" :db/id #edb/ref 17592186381233} {:answer/id #uuid "e8ed405c-d0bb-58ec-9cb0-db66e314a0e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{x}^{3}}{{y}^{5}}+6y" :db/id #edb/ref 17592186381234} {:answer/id #uuid "8e0ae37b-c8dd-5e79-8516-1915e55fc497" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{x}^{2}}{{y}^{4}}+6y" :db/id #edb/ref 17592186381235} {:answer/id #uuid "1c43e727-621e-5491-9269-e9a7064dc12d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{12{x}^{2}}{{y}^{5}}+6" :db/id #edb/ref 17592186381236}] :answer-field/correct {:answer/id #uuid "8e0ae37b-c8dd-5e79-8516-1915e55fc497" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{x}^{2}}{{y}^{4}}+6y" :db/id #edb/ref 17592186381235} :answer-field/id #uuid "88fa3ce5-5c28-5db2-ada3-b42ead245d4c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381231}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "55f3a1d2-cb7d-5965-acea-2992a42840fe" :question/math-academy-id "q-159618" :question/problem "Find ${f}_{x}(x,y)$ for $f(x,y)=\\frac{{x}^{3}}{{y}^{4}}+6xy.$" :question/worked-solution "The notation ${f}_{x}$ denotes the partial derivative of $f$ with respect to $x.$\n\nWe differentiate the given function with respect to $x,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(\\frac{{x}^{3}}{{y}^{4}}+6xy) \\\\  & =\\frac{∂}{∂x}(\\frac{{x}^{3}}{{y}^{4}})+\\frac{∂}{∂x}(6xy) \\\\  & =\\frac{1}{{y}^{4}}\\frac{∂}{∂x}({x}^{3})+6y\\cdot \\frac{∂}{∂x}(x) \\\\  & =\\frac{1}{{y}^{4}}\\cdot 3{x}^{2}+6y\\cdot 1 \\\\  & =\\frac{3{x}^{2}}{{y}^{4}}+6y\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278244 :knowledge-point/_questions [{:db/id #edb/ref 17592186192790 :knowledge-point/id #uuid "14cc6590-c2fd-5395-9481-0e5c0d9b8b8b" :knowledge-point/title "Applying the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4008d421-bcc4-541e-b6d1-6f911e6c8d66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\operatorname{sin}⁡(\\sqrt{2xy-1})}{2x\\sqrt{2xy-1}}" :db/id #edb/ref 17592186276034} {:answer/id #uuid "430b88eb-d781-5955-bdd4-cba096425762" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x\\operatorname{sin}⁡(\\sqrt{2xy-1})}{\\sqrt{2xy-1}}" :db/id #edb/ref 17592186276071} {:answer/id #uuid "4fccdda9-5259-5b0d-9374-c4a4d5a9b18d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡(\\sqrt{2xy-1})}{\\sqrt{2xy-1}}" :db/id #edb/ref 17592186276193} {:answer/id #uuid "ba43033d-0504-5559-9fb4-0a81d932ee52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x\\operatorname{cos}⁡(\\sqrt{2xy-1})}{\\sqrt{2xy-1}}" :db/id #edb/ref 17592186277130} {:answer/id #uuid "f142f4cb-083a-5c32-9524-ba93f1707e6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2x\\operatorname{cos}⁡(\\sqrt{2xy-1})}{\\sqrt{2xy-1}}" :db/id #edb/ref 17592186277595}] :answer-field/correct {:answer/id #uuid "430b88eb-d781-5955-bdd4-cba096425762" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x\\operatorname{sin}⁡(\\sqrt{2xy-1})}{\\sqrt{2xy-1}}" :db/id #edb/ref 17592186276071} :answer-field/id #uuid "05705cd0-c421-54fa-8117-fe18fa6f3bc3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277737}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0833bc78-75ed-516b-b7f3-7df11e162117" :question/math-academy-id "q-159658" :question/problem "Find ${f}_{y}(x,y)$ for $f(x,y)=\\operatorname{cos}⁡(\\sqrt{2xy-1}).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nFirst, we use the chain rule: \n\n$$\n\\begin{aligned}{f}_{y}(x,y) & =\\frac{∂}{∂y}(\\operatorname{cos}⁡(\\sqrt{2xy-1})) \\\\  & =-\\operatorname{sin}⁡(\\sqrt{2xy-1})\\cdot \\frac{∂}{∂y}(\\sqrt{2xy-1}) \\\\  & =-\\operatorname{sin}⁡(\\sqrt{2xy-1})\\cdot \\frac{1}{2\\sqrt{2xy-1}}\\cdot \\frac{∂}{∂y}(2xy-1)\\end{aligned}\n$$\n\nNow, we use the sum and the constant multiple rules for differentiation:\n\n$$\n\\begin{aligned}-\\operatorname{sin}⁡(\\sqrt{2xy-1})\\cdot \\frac{1}{2\\sqrt{2xy-1}}\\cdot \\frac{∂}{∂y}(2xy-1) & =-\\frac{\\operatorname{sin}⁡(\\sqrt{2xy-1})}{2\\sqrt{2xy-1}}(2x\\cdot \\frac{∂}{∂y}(y)-\\frac{∂}{∂y}(1)) \\\\  & =-\\frac{\\operatorname{sin}⁡(\\sqrt{2xy-1})}{2\\sqrt{2xy-1}}\\cdot (2x\\cdot 1-0) \\\\  & =-\\frac{x\\operatorname{sin}⁡(\\sqrt{2xy-1})}{\\sqrt{2xy-1}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186381251 :knowledge-point/_questions [{:db/id #edb/ref 17592186192790 :knowledge-point/id #uuid "14cc6590-c2fd-5395-9481-0e5c0d9b8b8b" :knowledge-point/title "Applying the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bbc2a41c-8b46-55d8-8633-185639106579" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{x+{x}^{3}y}" :db/id #edb/ref 17592186381253} {:answer/id #uuid "b53ff0ab-76f0-50e1-b576-7d4bec199596" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+3{x}^{2}y}{\\operatorname{ln}⁡(x+{x}^{3}y)}" :db/id #edb/ref 17592186381254} {:answer/id #uuid "7aeb7858-5a4c-5e37-baac-5e1b09598456" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+3{x}^{2}y}{x+{x}^{3}y}" :db/id #edb/ref 17592186381255} {:answer/id #uuid "75c5ac00-44da-5d0f-bc6a-05231039cb36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{x}^{2}y}{x+{x}^{3}y}" :db/id #edb/ref 17592186381256} {:answer/id #uuid "891569ad-a562-5cb2-8249-28d2b2b8e614" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+{x}^{2}y}{1+{x}^{3}y}" :db/id #edb/ref 17592186381257}] :answer-field/correct {:answer/id #uuid "7aeb7858-5a4c-5e37-baac-5e1b09598456" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+3{x}^{2}y}{x+{x}^{3}y}" :db/id #edb/ref 17592186381255} :answer-field/id #uuid "16d337f9-2d19-54ee-833d-730d6117510a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381252}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6cc4635c-e2d0-54e1-a8b8-18c5b785e7cf" :question/math-academy-id "q-159659" :question/problem "Find ${f}_{x}(x,y)$ for $f(x,y)=\\operatorname{ln}⁡(x+{x}^{3}y).$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nFirst, we use the chain rule:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(x+{x}^{3}y)) \\\\  & =\\frac{1}{x+{x}^{3}y}\\cdot \\frac{∂}{∂x}(x+{x}^{3}y)\\end{aligned}\n$$\n\nNow, we use the sum and constant multiple rules for differentiation:\n\n$$\n\\begin{aligned}\\frac{1}{x+{x}^{3}y}\\cdot \\frac{∂}{∂x}(x+{x}^{3}y) & =\\frac{1}{x+{x}^{3}y}\\cdot (\\frac{∂}{∂x}(x)+y\\cdot \\frac{∂}{∂x}({x}^{3})) \\\\  & =\\frac{1}{x+{x}^{3}y}\\cdot (1+y\\cdot 3{x}^{2}) \\\\  & =\\frac{1+3{x}^{2}y}{x+{x}^{3}y}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186381258 :knowledge-point/_questions [{:db/id #edb/ref 17592186192794 :knowledge-point/id #uuid "35c6e3db-073b-5867-8137-1d8660b20887" :knowledge-point/title "Applying the Quotient Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "764fe799-f9d4-56fc-8786-768351e90b2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186381260} {:answer/id #uuid "af40a1cc-fcdd-5d82-88f1-afb1cb810dc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186381261} {:answer/id #uuid "238d2bb5-2057-5938-92cb-490c8fd1d052" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186381262} {:answer/id #uuid "007df772-538e-5628-b388-eb1493c3de4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186381263} {:answer/id #uuid "e31f346f-c25e-5e5e-9897-5f3acda1e293" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186381264}] :answer-field/correct {:answer/id #uuid "af40a1cc-fcdd-5d82-88f1-afb1cb810dc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186381261} :answer-field/id #uuid "33cf4f0d-d3ae-5f4a-af95-43db53f9c0fe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381259}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ba29a24e-25aa-5034-8849-e753260af75f" :question/math-academy-id "q-159706" :question/problem "For the function $f(x,y)=\\frac{\\operatorname{cos}⁡x+\\operatorname{sin}⁡y}{\\operatorname{cos}⁡x-\\operatorname{sin}⁡y},$ evaluate $\\frac{∂f}{∂y}$ at the point $(\\pi ,-\\pi ).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nFirst, we use the quotient rule:\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(\\frac{\\operatorname{cos}⁡x+\\operatorname{sin}⁡y}{\\operatorname{cos}⁡x-\\operatorname{sin}⁡y}) & =\\frac{\\frac{∂}{∂y}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡y)\\cdot (\\operatorname{cos}⁡x-\\operatorname{sin}⁡y)-(\\operatorname{cos}⁡x+\\operatorname{sin}⁡y)\\cdot \\frac{∂}{∂y}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡y)}{(\\operatorname{cos}⁡x-\\operatorname{sin}⁡y)^{2}} \\\\  & =\\frac{\\operatorname{cos}⁡y\\cdot (\\operatorname{cos}⁡x-\\operatorname{sin}⁡y)-(\\operatorname{cos}⁡x+\\operatorname{sin}⁡y)\\cdot (-\\operatorname{cos}⁡y)}{(\\operatorname{cos}⁡x-\\operatorname{sin}⁡y)^{2}} \\\\  & =\\frac{\\operatorname{cos}⁡y\\operatorname{cos}⁡x-\\operatorname{cos}⁡y\\operatorname{sin}⁡y+\\operatorname{cos}⁡x\\operatorname{cos}⁡y+\\operatorname{sin}⁡y\\operatorname{cos}⁡y}{(\\operatorname{cos}⁡x-\\operatorname{sin}⁡y)^{2}} \\\\  & =\\frac{2\\operatorname{cos}⁡x\\operatorname{cos}⁡y}{(\\operatorname{cos}⁡x-\\operatorname{sin}⁡y)^{2}}\\end{aligned}\n$$\n\n \n\nFinally, we evaluate the partial derivative at the point $(\\pi ,-\\pi ):$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}{|}_{(\\pi ,-\\pi )} & =\\frac{2\\operatorname{cos}⁡\\pi \\operatorname{cos}⁡(-\\pi )}{(\\operatorname{cos}⁡\\pi -\\operatorname{sin}⁡(-\\pi ))^{2}} \\\\  & =\\frac{2(-1)(-1)}{(-1-0)^{2}} \\\\  & =\\frac{2}{1} \\\\  & =2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186381265 :knowledge-point/_questions [{:db/id #edb/ref 17592186192794 :knowledge-point/id #uuid "35c6e3db-073b-5867-8137-1d8660b20887" :knowledge-point/title "Applying the Quotient Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8367eed8-8db9-5b16-8030-4fb1d45343f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{2}" :db/id #edb/ref 17592186381267} {:answer/id #uuid "c3f7d926-4b2e-5a47-a964-89bbf3409d2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{{e}^{2}}" :db/id #edb/ref 17592186381268} {:answer/id #uuid "c0684d01-ce2e-5d72-b7c5-5083711bc071" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-e" :db/id #edb/ref 17592186381269} {:answer/id #uuid "3e29fb6f-8142-5709-a889-a0d7208a0ba2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186381270} {:answer/id #uuid "20723cc1-5581-5f10-b006-0cc5888b60c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186381271}] :answer-field/correct {:answer/id #uuid "8367eed8-8db9-5b16-8030-4fb1d45343f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{2}" :db/id #edb/ref 17592186381267} :answer-field/id #uuid "c43d33af-7b21-5589-9d8f-5fccd66d3600" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381266}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6f6e1b67-30d1-5d26-980f-cea342aa0dc8" :question/math-academy-id "q-159707" :question/problem "For the function $f(x,y)=\\frac{{x}^{2}-{y}^{2}}{{e}^{y-x}},$ evaluate $\\frac{∂f}{∂x}$ at the point $(1,-1).$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nFirst, we use the quotient and chain rules:\n\n$$\n\\begin{aligned}\\frac{∂}{∂x}(\\frac{{x}^{2}-{y}^{2}}{{e}^{y-x}}) & =\\frac{\\frac{∂}{∂x}({x}^{2}-{y}^{2})\\cdot {e}^{y-x}-({x}^{2}-{y}^{2})\\cdot \\frac{∂}{∂x}({e}^{y-x})}{{({e}^{y-x})}^{2}} \\\\  & =\\frac{2x\\cdot {e}^{y-x}-({x}^{2}-{y}^{2})\\cdot {e}^{y-x}\\cdot \\frac{∂}{∂x}(y-x)}{{({e}^{y-x})}^{2}} \\\\  & =\\frac{2x{e}^{y-x}-({x}^{2}-{y}^{2})\\cdot {e}^{y-x}\\cdot (-1)}{{({e}^{y-x})}^{2}} \\\\  & =\\frac{(2x+{x}^{2}-{y}^{2}){e}^{y-x}}{{({e}^{y-x})}^{2}} \\\\  & =\\frac{2x+{x}^{2}-{y}^{2}}{{e}^{y-x}}\\end{aligned}\n$$\n\n \n\nFinally, we evaluate the partial derivative at the point $(1,-1):$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}{|}_{(1,-1)} & =\\frac{2(1)+{1}^{2}-(-1)^{2}}{{e}^{-1-1}} \\\\  & =\\frac{2+1-1}{{e}^{-2}} \\\\  & =2{e}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186381286 :knowledge-point/_questions [{:db/id #edb/ref 17592186192785 :knowledge-point/id #uuid "e960f6d1-5006-5ddc-ada2-59b46924bf73" :knowledge-point/title "Applying the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3c1021c-0885-5bf7-b3e5-6327c277df4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}+2\\pi }{4}" :db/id #edb/ref 17592186381288} {:answer/id #uuid "110927d7-7b2d-5c08-bf3d-0346fca0acbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}+4\\pi }{8}" :db/id #edb/ref 17592186381289} {:answer/id #uuid "60bf5676-3040-5ff2-acf5-f790c6a36101" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\pi +1}{8}" :db/id #edb/ref 17592186381290} {:answer/id #uuid "92b9f3d2-b458-5615-b4f0-1138a3573da6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}+4}{2}" :db/id #edb/ref 17592186381291} {:answer/id #uuid "d23a20cb-a2b4-58ef-a4f6-d0f3bb9feba1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{4}" :db/id #edb/ref 17592186381292}] :answer-field/correct {:answer/id #uuid "110927d7-7b2d-5c08-bf3d-0346fca0acbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}+4\\pi }{8}" :db/id #edb/ref 17592186381289} :answer-field/id #uuid "9a23d4f6-a890-5ca9-9d9c-0ca9c46113c6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381287}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "39e99179-93fc-5477-adbb-fdfcbcd0de54" :question/math-academy-id "q-159753" :question/problem "For the function $f(x,y)={x}^{2}\\operatorname{tan}⁡(x{y}^{2}),$ evaluate ${f}_{x}(\\frac{\\pi }{4},1)$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nFirst, we use the product rule:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}({x}^{2}\\operatorname{tan}⁡(x{y}^{2})) \\\\  & =\\frac{∂}{∂x}({x}^{2})\\cdot \\operatorname{tan}⁡(x{y}^{2})+{x}^{2}\\cdot \\frac{∂}{∂x}(\\operatorname{tan}⁡(x{y}^{2}))\\end{aligned}\n$$\n\nThen, we use the chain and the constant multiple rules:\n\n$$\n\\begin{aligned}\\frac{∂}{∂x}({x}^{2})\\cdot \\operatorname{tan}⁡(x{y}^{2})+{x}^{2}\\cdot \\frac{∂}{∂x}(\\operatorname{tan}⁡(x{y}^{2})) & =(2x)\\cdot \\operatorname{tan}⁡(x{y}^{2})+{x}^{2}\\cdot {sec}^{2}⁡(x{y}^{2})\\frac{∂}{∂x}(x{y}^{2}) \\\\  & =2x\\operatorname{tan}⁡(x{y}^{2})+{x}^{2}{sec}^{2}⁡(x{y}^{2})\\cdot {y}^{2}\\cdot \\frac{∂}{∂x}(x) \\\\  & =2x\\operatorname{tan}⁡(x{y}^{2})+{x}^{2}{sec}^{2}⁡(x{y}^{2})\\cdot {y}^{2}\\cdot (1) \\\\  & =2x\\operatorname{tan}⁡(x{y}^{2})+{x}^{2}{y}^{2}{sec}^{2}⁡(x{y}^{2})\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(\\frac{\\pi }{4},1):$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}{|}_{(\\pi /4,1)} & =2\\cdot \\frac{\\pi }{4}\\cdot \\operatorname{tan}⁡(\\frac{\\pi }{4}\\cdot {1}^{2})+{(\\frac{\\pi }{4})}^{2}\\cdot {1}^{2}\\cdot {sec}^{2}⁡(\\frac{\\pi }{4}\\cdot {1}^{2}) \\\\  & =2\\cdot \\frac{\\pi }{4}\\cdot 1+\\frac{{\\pi }^{2}}{16}\\cdot (\\sqrt{2})^{2} \\\\  & =\\frac{\\pi }{2}+\\frac{{\\pi }^{2}}{8} \\\\  & =\\frac{{\\pi }^{2}+4\\pi }{8}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278255 :knowledge-point/_questions [{:db/id #edb/ref 17592186087846 :knowledge-point/id #uuid "37a4168b-1425-5f3a-a577-4b5884906a52" :knowledge-point/title "Calculating the Sum of a Complex Number and Its Conjugate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d79f35b-9c6f-5ea0-bc36-b70cf365f94b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\text{i}" :db/id #edb/ref 17592186276011} {:answer/id #uuid "7f0ddcf9-5550-54e5-b71a-85b4e14d8483" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186276631} {:answer/id #uuid "93cec608-e557-5ec2-a838-72d1783b34ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186276815} {:answer/id #uuid "9dd9f428-0306-5272-8687-ba40f9700e5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18\\text{i}" :db/id #edb/ref 17592186276894} {:answer/id #uuid "ccc78b51-a3ef-5a56-85ea-de62572a4123" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186277297}] :answer-field/correct {:answer/id #uuid "ccc78b51-a3ef-5a56-85ea-de62572a4123" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186277297} :answer-field/id #uuid "227bfbb7-c8a5-52a9-9c16-7187fd6462d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277784}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2e339dfa-5444-5946-8701-7661eae41839" :question/math-academy-id "q-159757" :question/problem "If $z=-9-\\text{i}$, calculate $z+\\overset{―}{z}.$" :question/worked-solution "**Method 1**\n\nWhen we add a complex number and its conjugate, the result is always twice the real part of the complex number.\n\nFor the given complex number $z=-9-\\text{i},$ the real part is $Re(z)=-9,$ so we have\n\n$$\n\\begin{aligned}z+\\overset{―}{z} & =2\\text{Re}(z) \\\\  & =2(-9) \\\\  & =-18.\\end{aligned}\n$$\n\n**Method 2**\n\nAlternatively, we can actually carry out the process of adding the complex number and its conjugate.\n\nTo obtain the conjugate of the complex number $z=-9-\\text{i},$ we flip the sign of the imaginary part and get $\\overset{―}{z}=-9+\\text{i}.$\n\nAdding, we get\n\n$$\n\\begin{aligned}z+\\overset{―}{z} & =(-9-\\text{i})+(-9+\\text{i}) \\\\  & =(-9+(-9))+\\text{i}(-1+1) \\\\  & =-18+\\text{i}\\cdot 0 \\\\  & =-18.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278256 :knowledge-point/_questions [{:db/id #edb/ref 17592186087847 :knowledge-point/id #uuid "64cd3ef1-6d41-50c6-b09d-cb709d89281f" :knowledge-point/title "Calculating the Product of a Complex Number and Its Conjugate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ad4c242-5100-5001-bbf2-14af7ad8a88e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186276136} {:answer/id #uuid "67bacfa4-b2c2-5dbf-ad5b-83815a9bf78a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186276405} {:answer/id #uuid "68f08005-6fd5-5cb7-985f-df65b93a27a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186276421} {:answer/id #uuid "9755f0c3-83bf-5c35-8244-3f96fda89a5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\text{i}" :db/id #edb/ref 17592186276837} {:answer/id #uuid "eb1e92ef-5e38-51fa-88c2-36429f6dcafd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18\\text{i}" :db/id #edb/ref 17592186277531}] :answer-field/correct {:answer/id #uuid "4ad4c242-5100-5001-bbf2-14af7ad8a88e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186276136} :answer-field/id #uuid "02caf819-53ad-50d7-90fb-0558ee92f886" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277729}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ba737df7-5524-50ff-9af1-1507a3bfabf5" :question/math-academy-id "q-159758" :question/problem "Given that $z=9+3\\text{i},$ calculate $z\\overset{―}{z}.$" :question/worked-solution "**Method 1**\n\nWhen we multiply a complex number and its conjugate, the result is always the sum of squares of the real part and the imaginary part.\n\nFor the given complex number $z=9+3\\text{i},$ the real part is $\\text{Re}(z)=9,$ and the imaginary part is $\\text{Im}(z)=3,$ so we have\n\n$$\n\\begin{aligned}z\\overset{―}{z} & =(\\text{Re}(z))^{2}+(\\text{Im}(z))^{2} \\\\  & ={9}^{2}+{3}^{2} \\\\  & =81+9 \\\\  & =90.\\end{aligned}\n$$\n\n**Method 2**\n\nAlternatively, we can actually carry out the process of multiplying the complex number and its conjugate.\n\nTo obtain the conjugate of the complex number $z=9+3\\text{i},$ we flip the sign of the imaginary part and get $\\overset{―}{z}=9-3\\text{i}.$\n\nMultiplying, we get\n\n$$\n\\begin{aligned}z\\overset{―}{z} & =(9+3\\text{i})(9-3\\text{i}) \\\\  & ={9}^{2}+(9)(3)\\text{i}+(-3)(9)\\text{i}-{\\text{i}}^{2}(3)^{2} \\\\  & =81+27\\text{i}-27\\text{i}-(-1)(9) \\\\  & =81+9 \\\\  & =90.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278259 :knowledge-point/_questions [{:db/id #edb/ref 17592186192785 :knowledge-point/id #uuid "e960f6d1-5006-5ddc-ada2-59b46924bf73" :knowledge-point/title "Applying the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "279e76f9-f9f0-5564-ae7c-148de9a68761" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{6}" :db/id #edb/ref 17592186275840} {:answer/id #uuid "4db3fc28-5e05-5ec0-9cc6-98a0f4ab9c44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186276163} {:answer/id #uuid "55ba531b-b121-55b8-9aa2-75e80c2df8e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14}{3}" :db/id #edb/ref 17592186276239} {:answer/id #uuid "9ad34d84-aa0e-5791-b041-c5ef3f6d8bab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186276864} {:answer/id #uuid "f1d1bcdc-b7ea-5e71-b840-58edcde3907f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186277602}] :answer-field/correct {:answer/id #uuid "55ba531b-b121-55b8-9aa2-75e80c2df8e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14}{3}" :db/id #edb/ref 17592186276239} :answer-field/id #uuid "57d1b1f3-769f-55bc-82da-be45d6d73f43" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277882}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3f9cc492-b3ba-556f-a019-182cbc410bcf" :question/math-academy-id "q-159766" :question/problem "For the function $f(x,y)=y\\sqrt{{x}^{2}+{y}^{2}},$ evaluate ${f}_{y}(2,\\sqrt{5}).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nFirst, we use the product rule:\n\n$$\n\\begin{aligned}{f}_{y}(x,y) & =\\frac{∂}{∂y}(y\\sqrt{{x}^{2}+{y}^{2}}) \\\\  & =\\frac{∂}{∂y}(y)\\cdot \\sqrt{{x}^{2}+{y}^{2}}+y\\cdot \\frac{∂}{∂y}(\\sqrt{{x}^{2}+{y}^{2}})\\end{aligned}\n$$\n\nThen, we use the chain, the sum, and the constant multiple rules:\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(y)\\cdot \\sqrt{{x}^{2}+{y}^{2}}+y\\cdot \\frac{∂}{∂y}(\\sqrt{{x}^{2}+{y}^{2}}) & =1\\cdot \\sqrt{{x}^{2}+{y}^{2}}+y\\cdot \\frac{1}{2\\sqrt{{x}^{2}+{y}^{2}}}\\cdot \\frac{∂}{∂y}({x}^{2}+{y}^{2}) \\\\  & =\\sqrt{{x}^{2}+{y}^{2}}+\\frac{y}{2\\sqrt{{x}^{2}+{y}^{2}}}\\cdot ({x}^{2}\\cdot \\frac{∂}{∂y}(1)+\\frac{∂}{∂y}({y}^{2})) \\\\  & =\\sqrt{{x}^{2}+{y}^{2}}+\\frac{y}{2\\sqrt{{x}^{2}+{y}^{2}}}\\cdot ({x}^{2}\\cdot 0+2y) \\\\  & =\\sqrt{{x}^{2}+{y}^{2}}+\\frac{{y}^{2}}{\\sqrt{{x}^{2}+{y}^{2}}}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(2,\\sqrt{5}):$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}{|}_{(2,\\sqrt{5})} & =\\sqrt{{2}^{2}+{(\\sqrt{5})}^{2}}+\\frac{{(\\sqrt{5})}^{2}}{\\sqrt{{2}^{2}+{(\\sqrt{5})}^{2}}} \\\\  & =\\sqrt{4+5}+\\frac{5}{\\sqrt{4+5}} \\\\  & =3+\\frac{5}{3} \\\\  & =\\frac{14}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278262 :knowledge-point/_questions [{:db/id #edb/ref 17592186087750 :knowledge-point/id #uuid "7c9849b9-397b-5fb9-bb4b-01f3d013c5c2" :knowledge-point/title "Computing the Image of a Polygon Under the Action of a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2938b900-5a10-5191-b4e3-0c2006782d08" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/02/02b7a778b46085876e5269e0b088dde52293d5230cd0312459ec21c8b2600f71.png" :db/id #edb/ref 17592186275849} {:answer/id #uuid "8db7805c-42d8-5800-a53d-d307b137bae7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/98/98150e2e7b7cb55643f588b885c3f57a34da186834dcbebd2cb7b35151317519.png" :db/id #edb/ref 17592186276763} {:answer/id #uuid "ac27feea-e70f-5759-9b05-555bf6691eda" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/54/5485aedcf92aca355118c8bd051f16a1436d5f955a0dde65c85eaa0398eb03b8.png" :db/id #edb/ref 17592186277025} {:answer/id #uuid "b3c5df52-e9e1-5791-b57d-7d0c965e423e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/77/77829a2aeb4fd7209a5ab5abfe2f84ab2225fc37f1a84fd25a4883647cff5fe1.png" :db/id #edb/ref 17592186277085} {:answer/id #uuid "b4dd1b77-bf7b-5095-a2d8-db7122088c6f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/4c/4c43c4c793924d4fde32b59c93b7a19be0109a389b126665868396b4c06d721e.png" :db/id #edb/ref 17592186277091}] :answer-field/correct {:answer/id #uuid "b4dd1b77-bf7b-5095-a2d8-db7122088c6f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/4c/4c43c4c793924d4fde32b59c93b7a19be0109a389b126665868396b4c06d721e.png" :db/id #edb/ref 17592186277091} :answer-field/id #uuid "9d6eb348-74a0-5d55-93c9-930e4913eaa7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278005}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1333855f-29ce-5600-8e32-dc2d38172ec9" :question/math-academy-id "q-159801" :question/problem "![](images/d9/d9ec98b03009d1023668aa12de88ed5515f0ea6df058d1b5d17804bf42082c5c.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}1 & 2 \\\\ 2 & 0\\end{aligned}].\n$$\n\nThe triangle $△ABC$ is shown above. Which of the following is $△{A}^{′}{B}^{′}{C}^{′},$ the image of $△ABC$ under the action of $T?$" :question/worked-solution "To find the image of $T$ under the action of $T$, we first create a matrix $X$ containing all of the vertices of $△ABC:$\n\n$$\nX=[\\begin{aligned}2 & -3 & 1 \\\\ 2 & 2 & -2\\end{aligned}]\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}1 & 2 \\\\ 2 & 0\\end{aligned}][\\begin{aligned}2 & -3 & 1 \\\\ 2 & 2 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}6 & 1 & -3 \\\\ 4 & -6 & 2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of $△{A}^{′}{B}^{′}{C}^{′}$ are $(6,4),(1,-6),(-3,2)$, as shown below.\n\n![](images/4c/4c43c4c793924d4fde32b59c93b7a19be0109a389b126665868396b4c06d721e.png)"}] [{:db/id #edb/ref 17592186389016 :knowledge-point/_questions [{:db/id #edb/ref 17592186092225 :knowledge-point/id #uuid "d4daa6bc-1c9a-5c23-8032-4d70435d9388" :knowledge-point/title "Calculating a Vector Given Its Image Under a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e6e33f13-bf32-57fc-9e33-1c3365d2b549" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}8 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186389018} {:answer/id #uuid "45edddc3-4ab5-5f20-b063-71b14cfab775" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}8 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186389019} {:answer/id #uuid "a609d06b-6fba-58d1-ac0c-77b3c30ee67f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186389020} {:answer/id #uuid "27df9d1e-2610-5e00-b40d-bca3d5157238" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ 8\\end{aligned}]" :db/id #edb/ref 17592186389021} {:answer/id #uuid "428468dc-0f82-5095-b6bf-387fc8aa1e4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ 8\\end{aligned}]" :db/id #edb/ref 17592186389022}] :answer-field/correct {:answer/id #uuid "428468dc-0f82-5095-b6bf-387fc8aa1e4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ 8\\end{aligned}]" :db/id #edb/ref 17592186389022} :answer-field/id #uuid "991862b1-972b-5127-a2c8-a89e2bc72fa1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389017}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ede69c8f-2758-5c85-a62b-6b678eca588f" :question/math-academy-id "q-159976" :question/problem "The vector $v$ in the plane is mapped to the vector $[\\begin{aligned}4 \\\\ 0\\end{aligned}]$ under the action of the linear transformation $T$ whose matrix $T$ is given by\n\n$$\nT=[\\begin{aligned}3 & -1 \\\\ 4 & -2\\end{aligned}].\n$$\n\nWhat is the original vector $v?$" :question/worked-solution "From the given information, we have \n\n$$\nT\\cdot v=[\\begin{aligned}4 \\\\ 0\\end{aligned}].\n$$\n\nWe need to reverse the action of the matrix $T.$ So, we multiply the above equation by ${T}^{-1},$ and we get\n\n$$\n\\begin{aligned}{T}^{-1}\\cdot T\\cdot v & ={T}^{-1}\\cdot [\\begin{aligned}4 \\\\ 0\\end{aligned}] \\\\ v & ={T}^{-1}\\cdot [\\begin{aligned}4 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nNow, we need to calculate the inverse of $T$, which is\n\n$$\n\\begin{aligned}{T}^{-1} & =\\frac{1}{-6-(-4)}[\\begin{aligned}-2 & 1 \\\\ -4 & 3\\end{aligned}] \\\\  & =\\frac{1}{-2}[\\begin{aligned}-2 & 1 \\\\ -4 & 3\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}2 & -1 \\\\ 4 & -3\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the original vector is\n\n$$\n\\begin{aligned}v & ={T}^{-1}\\cdot [\\begin{aligned}4 \\\\ 0\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}2 & -1 \\\\ 4 & -3\\end{aligned}][\\begin{aligned}4 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ 8\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278269 :knowledge-point/_questions [{:db/id #edb/ref 17592186115286 :knowledge-point/id #uuid "0236acfd-59d1-5bc8-9e60-1c76ddc536f5" :knowledge-point/title "Finding a Quadratic Equation Given a Complex Root and Its Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "262c67b0-9dc3-5bb9-b23e-c4843109b272" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}+8x+7=0" :db/id #edb/ref 17592186275823} {:answer/id #uuid "36536e52-de9d-5a68-88f6-2b843d2e1785" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-8x+14=0" :db/id #edb/ref 17592186275961} {:answer/id #uuid "960f5340-28b7-5541-85b8-e2062d1ddc56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-4x+7=0" :db/id #edb/ref 17592186276827} {:answer/id #uuid "b1006f97-c825-512d-9ba5-921bfa86cefa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-16x-14=0" :db/id #edb/ref 17592186277060} {:answer/id #uuid "c7ed3c1e-e5be-511c-9f4e-523ee7d6271f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}+16x+14=0" :db/id #edb/ref 17592186277252}] :answer-field/correct {:answer/id #uuid "36536e52-de9d-5a68-88f6-2b843d2e1785" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-8x+14=0" :db/id #edb/ref 17592186275961} :answer-field/id #uuid "50d21184-0537-5f99-9ad1-5d14ed806095" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277862}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f58c3018-1078-5b3f-8bb8-2a1e7347605d" :question/math-academy-id "q-160008" :question/problem "A quadratic equation in the variable $x$ with real coefficients has a root $x=2+\\sqrt{3}\\text{i}.$ Given that the coefficient of ${x}^{2}$ in the equation is $2$, find the equation." :question/worked-solution "Since the quadratic equation has real coefficients and $x=2+\\sqrt{3}\\text{i}$ is a root, its conjugate $x=2-\\sqrt{3}\\text{i}$ must also be a root. Therefore, using the zero product property, we can write a quadratic equation with the required roots as follows:\n\n$$\n(x-(2+\\sqrt{3}\\text{i}))(x-(2-\\sqrt{3}\\text{i}))=0\n$$\n\nBy expanding the parentheses, we can write the equation in standard form as follows:\n\n$$\n\\begin{aligned}{x}^{2}-x(2-\\sqrt{3}\\text{i})-x(2+\\sqrt{3}\\text{i})+(2+\\sqrt{3}\\text{i})(2-\\sqrt{3}\\text{i}) & =0 \\\\ {x}^{2}-2x+\\sqrt{3}x\\text{i}-2x-\\sqrt{3}x\\text{i}+4-(\\sqrt{3}\\text{i})^{2} & =0 \\\\ {x}^{2}-4x+4+3 & =0 \\\\ {x}^{2}-4x+7 & =0\\end{aligned}\n$$\n\nThis equation has roots $x=2\\pm \\sqrt{3}\\text{i},$ but the coefficient of ${x}^{2}$ is not $2.$ Therefore, to find the desired equation, we multiply the equation above by $2.$ This gives\n\n$$\n\\begin{aligned}2({x}^{2}-4x+7) & =0 \\\\ 2{x}^{2}-8x+14 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401151 :knowledge-point/_questions [{:db/id #edb/ref 17592186059799 :knowledge-point/id #uuid "1fe5d8aa-8a79-5de4-8566-1432a640d78f" :knowledge-point/title "Equating Real and Imaginary Parts of a Complex Number to Solve For an Unknown Quantity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b234a49-b204-5ed4-bfaa-41d6080ef1a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=\\frac{3}{4},b=\\frac{\\sqrt{3}}{4}" :db/id #edb/ref 17592186401153} {:answer/id #uuid "ee6d77b0-4258-5c91-8afc-7ef838e14fcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=\\sqrt{3},b=-\\frac{3}{4}" :db/id #edb/ref 17592186401154} {:answer/id #uuid "d2159356-f202-541b-9892-eebd1e60d1be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=\\frac{3}{4},b=-\\sqrt{3}" :db/id #edb/ref 17592186401155} {:answer/id #uuid "d6145a7d-35ad-5386-85f1-fee66f6da6b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=\\sqrt{3},b=\\frac{3}{4}" :db/id #edb/ref 17592186401156} {:answer/id #uuid "5360b829-a541-532f-8d6c-81155ed6dcd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=\\frac{3}{4},b=\\sqrt{3}" :db/id #edb/ref 17592186401157}] :answer-field/correct {:answer/id #uuid "5360b829-a541-532f-8d6c-81155ed6dcd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=\\frac{3}{4},b=\\sqrt{3}" :db/id #edb/ref 17592186401157} :answer-field/id #uuid "76c64cb5-e76d-53eb-a0e8-6195df2d94ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401152}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "78111624-f670-5df8-b6e2-bb5a5dde19ff" :question/math-academy-id "q-160013" :question/problem "Given that $\\frac{3}{4}+\\sqrt{3}\\text{i}=a+b\\text{i}$, calculate the value of $a$ and the value of $b.$" :question/worked-solution "First, we equate the real parts:\n\n$$\n\\begin{aligned}\\frac{3}{4} & =a\\end{aligned}\n$$\n\nThen, we equate the imaginary parts:\n\n$$\n\\begin{aligned}\\sqrt{3} & =b\\end{aligned}\n$$\n\nTherefore, $a=\\frac{3}{4}$ and $b=\\sqrt{3}.$"}] [{:db/id #edb/ref 17592186278271 :knowledge-point/_questions [{:db/id #edb/ref 17592186115305 :knowledge-point/id #uuid "b346e7e1-b641-5a97-9677-84a0ff6ab2dc" :knowledge-point/title "Finding Missing Values in a Data Set Given the Mean"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ed36547-96e7-5784-9a0e-cef5f230e794" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186275755} {:answer/id #uuid "60b2eba2-e4ea-55fb-b0a5-7949921702ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186276344} {:answer/id #uuid "90863935-708d-5d8a-9767-701612197aa6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186276786} {:answer/id #uuid "a7774b83-c8c2-533c-9b91-ea243dc329ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186276988} {:answer/id #uuid "b652cf44-f298-51b1-9814-ea015f204d32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186277099}] :answer-field/correct {:answer/id #uuid "a7774b83-c8c2-533c-9b91-ea243dc329ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186276988} :answer-field/id #uuid "bba5517c-87f3-5296-8e79-3699c931499e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278056}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "88fbb37a-350b-51de-9b64-f5ff2acb9c93" :question/math-academy-id "q-160026" :question/problem "Given that the mean of the following data set is $10,$ find the value of $b:$ \n\n$$\nb,\\,1,\\,b,\\,1,\\,b\n$$" :question/worked-solution "If we have a data set that consists of the points ${x}_{1},{x}_{2},…,{x}_{n},$ then the mean is denoted by $\\overset{―}{x}$ and is given by the following formula:\n\n$$\n\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}\n$$\n\nHere, there are $n=5$ data points. Adding up all the points in the data set, we get\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{5}{x}_{i} & =b+1+b+1+b \\\\  & =2+3b.\\end{aligned}\n$$\n\nTherefore, the mean is given by the expression\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{5}\\cdot (2+3b) \\\\  & =\\frac{2+3b}{5}.\\end{aligned}\n$$\n\nFinally, since we're told that $\\overset{―}{x}=10,$ we have\n\n$$\n\\begin{aligned}10 & =\\frac{2+3b}{5} \\\\ 50 & =2+3b \\\\ 48 & =3b \\\\ b & =16.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278272 :knowledge-point/_questions [{:db/id #edb/ref 17592186115305 :knowledge-point/id #uuid "b346e7e1-b641-5a97-9677-84a0ff6ab2dc" :knowledge-point/title "Finding Missing Values in a Data Set Given the Mean"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b5e32c7-6b89-5822-855f-1dfb6a5a9745" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186275870} {:answer/id #uuid "2d86a5a3-7293-5268-b8e4-2c73a0117d10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186275888} {:answer/id #uuid "4248bdf2-7c80-5f67-8d39-490fc7fd9035" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186276057} {:answer/id #uuid "6a4c24fa-3a89-5653-8566-bcbe05f0a9ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186276432} {:answer/id #uuid "ff2ae68b-d06f-52a1-8b62-ccf349b47446" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186277719}] :answer-field/correct {:answer/id #uuid "ff2ae68b-d06f-52a1-8b62-ccf349b47446" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186277719} :answer-field/id #uuid "fe8dea39-9fe7-5d93-8b7f-3596ae2988dd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278175}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2ae95412-5543-5cd6-a29d-d4219b71ef9a" :question/math-academy-id "q-160028" :question/problem "Given that the mean of the following data set is $11,$ find the value of $c:$ \n\n$$\n(c-3),\\,6,\\,3,\\,c,\\,10,\\,20\n$$" :question/worked-solution "If we have a data set that consists of the points ${x}_{1},{x}_{2},…,{x}_{n},$ then the mean is denoted by $\\overset{―}{x}$ and is given by the following formula:\n\n$$\n\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}\n$$\n\nHere, there are $n=6$ data points. Adding up all the points in the data set, we get\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{6}{x}_{i} & =(c-3)+6+3+c+10+20 \\\\  & =36+2c\\end{aligned}\n$$\n\nTherefore, the mean is given by the expression\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{6}\\cdot (36+2c) \\\\  & =\\frac{36+2c}{6}.\\end{aligned}\n$$\n\nFinally, since we're told that $\\overset{―}{x}=11,$ we have\n\n$$\n\\begin{aligned}11 & =\\frac{36+2c}{6} \\\\ 66 & =36+2c \\\\ 30 & =2c \\\\ c & =15.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401158 :knowledge-point/_questions [{:db/id #edb/ref 17592186059801 :knowledge-point/id #uuid "1bbe2fe7-b69c-54f3-9f1c-3369e3f1395d" :knowledge-point/title "Solving for Unknowns By Computing a Product and Equating Real and Imaginary Parts"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71361279-b548-5a5f-a16d-dcbf0424a5e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p=2$, $q=3$" :db/id #edb/ref 17592186401160} {:answer/id #uuid "76723f95-9757-537d-ba64-6f70bb2a0084" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p=8$, $q=2$" :db/id #edb/ref 17592186401161} {:answer/id #uuid "2783fb88-e21b-5c34-a806-1f0e4be8a043" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p=-4$, $q=2$" :db/id #edb/ref 17592186401162} {:answer/id #uuid "f9389cd2-410b-5bd7-bb2d-afd430456c2a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p=-3$, $q=2$" :db/id #edb/ref 17592186401163} {:answer/id #uuid "6176aa1c-2946-59f3-b638-214d03147fc2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p=2$, $q=1$" :db/id #edb/ref 17592186401164}] :answer-field/correct {:answer/id #uuid "76723f95-9757-537d-ba64-6f70bb2a0084" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p=8$, $q=2$" :db/id #edb/ref 17592186401161} :answer-field/id #uuid "e20e0aba-a96a-54f7-bcde-ebba07a66ed9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401159}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2bd6d81b-eb1e-5f54-9fb0-b04584c1dccf" :question/math-academy-id "q-160037" :question/problem "Given that $3+5\\text{i}=\\frac{p+\\text{i}q}{1-\\text{i}},$ calculate $p$ and $q.$" :question/worked-solution "First, we multiply both sides of the equation by $1-\\text{i}$ to get rid of the fraction and isolate the variables:\n\n$$\n\\begin{aligned}3+5\\text{i} & =\\frac{p+\\text{i}q}{1-\\text{i}} \\\\ (3+5\\text{i})(1-\\text{i}) & =p+\\text{i}q \\\\ 3-3\\text{i}+5\\text{i}-5{\\text{i}}^{2} & =p+\\text{i}q \\\\ 3+5+2\\text{i} & =p+\\text{i}q \\\\ 8+2\\text{i} & =p+\\text{i}q\\end{aligned}\n$$\n\nNow, we can equate the real parts and the imaginary parts separately.\n\n- Equating the real parts, we get\n\n$$\n8=p.\n$$\n\n- Equating the imaginary parts, we get\n\n$$\n\\begin{aligned}2 & =q.\\end{aligned}\n$$\n\nTherefore, $p=8$ and $q=2.$"}] [{:db/id #edb/ref 17592186401165 :knowledge-point/_questions [{:db/id #edb/ref 17592186059802 :knowledge-point/id #uuid "c9f40a0e-83f3-5814-b9a1-8b1265fe93cc" :knowledge-point/title "Solving for Unknowns By Computing a Quotient and Equating Real and Imaginary Parts"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f1d54338-26b9-548b-83c0-2a886b9ea3a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=-\\frac{3}{2},q=\\frac{3}{5}" :db/id #edb/ref 17592186401167} {:answer/id #uuid "3d44482d-1c30-5ad6-854c-691cae820272" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=\\frac{3}{2},q=-\\frac{3}{5}" :db/id #edb/ref 17592186401168} {:answer/id #uuid "1b7850c0-574e-58be-a128-8a2349e114cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=\\frac{3}{5},q=-\\frac{3}{2}" :db/id #edb/ref 17592186401169} {:answer/id #uuid "e5144ebf-c2b3-5349-b8ce-5873d55100c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=\\frac{2}{5},q=-\\frac{1}{2}" :db/id #edb/ref 17592186401170} {:answer/id #uuid "930309ca-50d5-5254-aa8c-b2c15baae0ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=\\frac{3}{2},q=-\\frac{1}{2}" :db/id #edb/ref 17592186401171}] :answer-field/correct {:answer/id #uuid "930309ca-50d5-5254-aa8c-b2c15baae0ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=\\frac{3}{2},q=-\\frac{1}{2}" :db/id #edb/ref 17592186401171} :answer-field/id #uuid "56ae83c2-5ded-53be-a27e-61769cd01afe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401166}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "050685d3-106a-556e-94cf-f2ab6b33d435" :question/math-academy-id "q-160049" :question/problem "Given that $5=(p+q\\text{i})(3+\\text{i})$, calculate $p$ and $q.$" :question/worked-solution "First, we divide both sides of the equation by $3+\\text{i}$ to isolate the variables:\n\n$$\n\\begin{aligned}5 & =(p+q\\text{i})(3+\\text{i}) \\\\ \\frac{5}{3+\\text{i}} & =p+q\\text{i}\\end{aligned}\n$$\n\nNow, to simplify the fraction on the left-hand side, we multiply the numerator and denominator by the conjugate of the denominator:\n\n$$\n\\begin{aligned}\\frac{(5)(3-\\text{i})}{(3+\\text{i})(3-\\text{i})} & =p+q\\text{i} \\\\ \\frac{15-5\\text{i}}{{3}^{2}-(\\text{i})^{2}} & =p+q\\text{i} \\\\ \\frac{15-5\\text{i}}{9+1} & =p+q\\text{i} \\\\ \\frac{15-5\\text{i}}{10} & =p+q\\text{i} \\\\ \\frac{3}{2}-\\frac{1}{2}\\text{i} & =p+q\\text{i}\\end{aligned}\n$$\n\nNow, we can equate the real parts and the imaginary parts separately.\n\n- Equating the real parts, we get $\\frac{3}{2}=p.$\n\n- Equating the imaginary parts, we get $-\\frac{1}{2}=q.$\n\nTherefore, $p=\\frac{3}{2}$ and $q=-\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186278276 :knowledge-point/_questions [{:db/id #edb/ref 17592186115304 :knowledge-point/id #uuid "adfc527d-4347-5741-a81c-fa91c50d5d74" :knowledge-point/title "Computing the Mean of a Data Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5be0bc62-d602-5b32-8a2e-36d125dbe0bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186276301} {:answer/id #uuid "c0a1d8a5-8c5d-5e57-a888-62ddebfefa97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186277188} {:answer/id #uuid "e71d3129-f92a-5c5b-837b-240366c795c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9.5" :db/id #edb/ref 17592186277496} {:answer/id #uuid "faed2406-8996-50c6-b0ef-9ef87571e4b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11.5" :db/id #edb/ref 17592186277675} {:answer/id #uuid "fcb5e3e3-e49d-5444-9e56-c411ae1a8e1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186277691}] :answer-field/correct {:answer/id #uuid "c0a1d8a5-8c5d-5e57-a888-62ddebfefa97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186277188} :answer-field/id #uuid "ad91c49c-4a4d-571c-acb9-c533b9863422" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278024}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b4975910-186b-51eb-8386-78fc12db0a69" :question/math-academy-id "q-160052" :question/problem "A college basketball player scored the following number of points in the last five games he played:\n\n$$\n9,\\,11,\\,12,\\,8,\\,10\n$$\n\nWhat is the mean of these scores?" :question/worked-solution "If we have a data set that consists of the points ${x}_{1},{x}_{2},…,{x}_{n},$ then the mean is denoted by $\\overset{―}{x}$ and is given by the following formula:\n\n$$\n\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}\n$$\n\nHere, there are $n=5$ data points. Adding up all the points in the data set, we get\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{5}{x}_{i} & =9+11+12+8+10 \\\\  & =50.\\end{aligned}\n$$\n\nTherefore, the mean is\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{5}\\cdot 50 \\\\  & =10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278277 :knowledge-point/_questions [{:db/id #edb/ref 17592186115304 :knowledge-point/id #uuid "adfc527d-4347-5741-a81c-fa91c50d5d74" :knowledge-point/title "Computing the Mean of a Data Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e67b2a5-0f28-5b12-888c-9ffba56fdcc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186275597} {:answer/id #uuid "53c635b2-f846-551d-b578-e72691826950" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186276220} {:answer/id #uuid "67146a85-6286-573e-a37d-2c1c8f8de67c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.5" :db/id #edb/ref 17592186276398} {:answer/id #uuid "c72cf84a-4573-550f-a9d6-4a4ad1b52ddf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186277247} {:answer/id #uuid "e5554f5b-a5a2-59e4-88ec-a1c9997632f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.8" :db/id #edb/ref 17592186277480}] :answer-field/correct {:answer/id #uuid "53c635b2-f846-551d-b578-e72691826950" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186276220} :answer-field/id #uuid "23112a7c-974e-57c0-ab45-efd0be8b2843" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277785}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ac9d78d0-acf8-5125-b9f8-810932b0249e" :question/math-academy-id "q-160054" :question/problem "A car salesman has sold the following quantities of a particular model of car in the last few weeks:\n\n$$\n3,\\,5,\\,6,\\,8,\\,5,\\,3\n$$\n\nWhat is the mean of these figures?" :question/worked-solution "If we have a data set that consists of the points ${x}_{1},{x}_{2},…,{x}_{n},$ then the mean is denoted by $\\overset{―}{x}$ and is given by the following formula:\n\n$$\n\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}\n$$\n\nHere, there are $n=6$ data points. Adding up all the points in the data set, we get\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{6}{x}_{i} & =3+5+6+8+5+3 \\\\  & =30.\\end{aligned}\n$$\n\nTherefore, the mean is\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{6}\\cdot 30 \\\\  & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278291 :knowledge-point/_questions [{:db/id #edb/ref 17592186129263 :knowledge-point/id #uuid "ab643519-92a4-5ccf-b826-fb2a68b36534" :knowledge-point/title "Evaluating a Jacobian Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b2ac211-6ede-500a-9363-0c90ed1326ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186275729} {:answer/id #uuid "241de261-1031-55ca-a058-00911568c512" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186275796} {:answer/id #uuid "54f35b13-d77e-5a66-b2b8-4f7e13bf0284" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186276233} {:answer/id #uuid "b3da8c48-0f97-556c-90bd-47b71461d13c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186277086} {:answer/id #uuid "c49fcad0-5cc2-5449-8be5-a58c6c177d96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186277224}] :answer-field/correct {:answer/id #uuid "1b2ac211-6ede-500a-9363-0c90ed1326ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186275729} :answer-field/id #uuid "795a7cef-1005-511a-9200-2ed1ac91ad82" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277938}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2443aa6d-e746-5170-93b3-e30684a9a33b" :question/math-academy-id "q-160402" :question/problem "For the transformation $T,$ defined as\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}{e}^{u-v} \\\\ \\operatorname{ln}⁡(uv)\\end{aligned}].\n$$\n\ncompute the value of the Jacobian determinant at the point where $[\\begin{aligned}u \\\\ v\\end{aligned}]=[\\begin{aligned}1 \\\\ 1\\end{aligned}].$" :question/worked-solution "Given a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]\\to [\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}|.\\end{aligned}\n$$\n\nHere, we have $x(u,v)={e}^{u-v}$ and $y(u,v)=\\operatorname{ln}⁡(uv).$  \n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & ={e}^{u-v} & \\,\\frac{∂x}{∂v} & =-{e}^{u-v} \\\\ \\frac{∂y}{∂u} & =\\frac{1}{u} & \\,\\frac{∂y}{∂v} & =\\frac{1}{v}\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}{e}^{u-v} & -{e}^{u-v} \\\\ \\frac{1}{u} & \\frac{1}{v}\\end{aligned}| \\\\  & ={e}^{u-v}\\cdot (\\frac{1}{v})-(-{e}^{u-v})\\cdot \\frac{1}{u} \\\\  & =\\frac{{e}^{u-v}}{v}+\\frac{{e}^{u-v}}{u}.\\end{aligned}\n$$\n\nFinally, when $[\\begin{aligned}u \\\\ v\\end{aligned}]=[\\begin{aligned}1 \\\\ 1\\end{aligned}],$ the value of our Jacobian determinant is\n\n$$\n{\\frac{∂(x,y)}{∂(u,v)}|}_{(1,1)}=\\frac{{e}^{(1)-(1)}}{(1)}+\\frac{{e}^{(1)-(1)}}{(1)}=2.\n$$"}] [{:db/id #edb/ref 17592186383508 :knowledge-point/_questions [{:db/id #edb/ref 17592186129187 :knowledge-point/id #uuid "d56cec4a-6121-5988-aaea-478fb6048a6d" :knowledge-point/title "Finding the Jacobian Determinant of a Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "edb38347-2e82-5d17-ad40-6a0e81c54f68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{u+v}(u+v)" :db/id #edb/ref 17592186383510} {:answer/id #uuid "838ab111-2c3c-527c-8408-c8c361dfef0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{u+v}(u+v)" :db/id #edb/ref 17592186383511} {:answer/id #uuid "2e4c3726-e2bb-58c5-a4ce-829f4ad3a100" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{u+v}(uv)" :db/id #edb/ref 17592186383512} {:answer/id #uuid "a7595bc5-8856-5a45-a98a-43e423b6db07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{u+v}(v-u)" :db/id #edb/ref 17592186383513} {:answer/id #uuid "85fd7556-d652-5f2d-a0d4-cf974f4ae8fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{u+v}(u-v)" :db/id #edb/ref 17592186383514}] :answer-field/correct {:answer/id #uuid "a7595bc5-8856-5a45-a98a-43e423b6db07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{u+v}(v-u)" :db/id #edb/ref 17592186383513} :answer-field/id #uuid "b727cda1-e9ad-5bca-9a2b-b11956b21803" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383509}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dd9f0081-13ed-51ab-acfe-3bfbc0b818a1" :question/math-academy-id "q-160406" :question/problem "Find the Jacobian determinant of the transformation $T([\\begin{aligned}u \\\\ v\\end{aligned}])=[\\begin{aligned}{e}^{u+v} \\\\ {u}^{2}+{v}^{2}\\end{aligned}].$" :question/worked-solution "Given a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]\\to [\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}|.\\end{aligned}\n$$\n\nHere, we have $x={e}^{u+v}$ and $y={u}^{2}+{v}^{2}.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & ={e}^{u+v} & \\,\\frac{∂x}{∂v} & ={e}^{u+v} \\\\ \\frac{∂y}{∂u} & =2u & \\,\\frac{∂y}{∂v} & =2v\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}{e}^{u+v} & {e}^{u+v} \\\\ \\,\\text{ }2u\\, & \\,\\text{ }2v\\end{aligned}| \\\\  & ={e}^{u+v}\\cdot 2v-{e}^{u+v}\\cdot 2u \\\\  & =2{e}^{u+v}(v-u).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278300 :knowledge-point/_questions [{:db/id #edb/ref 17592186129263 :knowledge-point/id #uuid "ab643519-92a4-5ccf-b826-fb2a68b36534" :knowledge-point/title "Evaluating a Jacobian Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "201b5adb-fe9e-56a4-a103-cfa7fd40fca9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186275775} {:answer/id #uuid "6b7b2609-013a-5fdd-ad02-4411dd975fa7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186276441} {:answer/id #uuid "7c015757-c6cd-5661-8772-840f2ddff2cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186276607} {:answer/id #uuid "803b5ba9-187d-5e4c-a266-d33068d508bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186276640} {:answer/id #uuid "af79779a-7d08-51aa-a7a1-413703ca604d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186277048}] :answer-field/correct {:answer/id #uuid "af79779a-7d08-51aa-a7a1-413703ca604d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186277048} :answer-field/id #uuid "ed0e005f-2ede-5db6-90a3-c44e813e721d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278140}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4f68c62f-9f11-5647-83b4-1238f13388b9" :question/math-academy-id "q-160440" :question/problem "For the transformation $T,$ defined as\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}\\operatorname{cos}⁡u \\\\ \\operatorname{sin}⁡v\\end{aligned}]\n$$\n\ncompute the value of the Jacobian determinant at the point where $[\\begin{aligned}u \\\\ v\\end{aligned}]=[\\begin{aligned}\\pi /6 \\\\ 0\\end{aligned}].$" :question/worked-solution "Given a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]\\to [\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}|.\\end{aligned}\n$$\n\nHere, we have $x(u,v)=\\operatorname{cos}⁡u$ and $y(u,v)=\\operatorname{sin}⁡v.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =-\\operatorname{sin}⁡u & \\,\\frac{∂x}{∂v} & =0 \\\\ \\frac{∂y}{∂u} & =0 & \\,\\frac{∂y}{∂v} & =\\operatorname{cos}⁡v\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}-\\operatorname{sin}⁡u & 0 \\\\ 0 & \\operatorname{cos}⁡v\\end{aligned}| \\\\  & =(-\\operatorname{sin}⁡u)\\cdot \\operatorname{cos}⁡v-0\\cdot 0 \\\\  & =-\\operatorname{sin}⁡u\\operatorname{cos}⁡v.\\end{aligned}\n$$\n\nFinally, when $[\\begin{aligned}u \\\\ v\\end{aligned}]=[\\begin{aligned}\\pi /6 \\\\ 0\\end{aligned}],$ the value of our Jacobian determinant is\n\n$$\n{\\frac{∂(x,y)}{∂(u,v)}|}_{(\\frac{\\pi }{6},0)}=-\\operatorname{sin}⁡(\\frac{\\pi }{6})\\operatorname{cos}⁡(0)=-\\frac{1}{2}.\n$$"}] [{:db/id #edb/ref 17592186401179 :knowledge-point/_questions [{:db/id #edb/ref 17592186198360 :knowledge-point/id #uuid "bf5e8b36-38f0-5dd9-8b76-82392e593b73" :knowledge-point/title "Determining the Critical Points of a Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dfe7ddf8-1d90-5732-b4e0-9b6cb53cfed7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The critical points lie on the line $u=-2v.$" :db/id #edb/ref 17592186401181} {:answer/id #uuid "6b355cde-9299-54ff-9082-f28b3a088a6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The critical points lie on the line $v=-2u.$" :db/id #edb/ref 17592186401182} {:answer/id #uuid "a417c7cf-6062-5b00-9bc3-e0de419c5534" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The critical points lie on the line $v=2u.$" :db/id #edb/ref 17592186401183} {:answer/id #uuid "ac39e8c8-f1ca-5eec-9d60-f35deacbe886" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The critical points lie on the line $u=-v.$" :db/id #edb/ref 17592186401184} {:answer/id #uuid "0f39009f-2aaf-5fb6-b951-14bb531af992" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The critical points lie on the line $u=v.$" :db/id #edb/ref 17592186401185}] :answer-field/correct {:answer/id #uuid "0f39009f-2aaf-5fb6-b951-14bb531af992" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The critical points lie on the line $u=v.$" :db/id #edb/ref 17592186401185} :answer-field/id #uuid "003d00c4-a45e-580b-a2b2-1a8ab41f3386" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401180}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6940edb0-4ff9-5079-afa0-d099bcae85dd" :question/math-academy-id "q-160465" :question/problem "Find the locations of all of the critical points of $T,$ where $T$ is defined as\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}{e}^{u+v} \\\\ {u}^{2}+{v}^{2}\\end{aligned}].\n$$" :question/worked-solution "Given a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]\\to [\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}|.\\end{aligned}\n$$\n\nTo find the locations of the critical points of $T,$ we need to solve \n\n$$\n\\frac{∂(x,y)}{∂(u,v)}=0.\n$$\n\nHere, we have $x(u,v)={e}^{u+v}$ and $y(u,v)={u}^{2}+{v}^{2}.$ \n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & ={e}^{u+v} & \\,\\frac{∂x}{∂v} & ={e}^{u+v} \\\\ \\frac{∂y}{∂u} & =2u & \\,\\frac{∂y}{∂v} & =2v\\end{aligned}\n$$\n\n \n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}{e}^{u+v} & {e}^{u+v} \\\\ 2u & 2v\\end{aligned}| \\\\  & ={e}^{u+v}\\cdot 2v-{e}^{u+v}\\cdot 2u \\\\  & =2{e}^{u+v}(v-u).\\end{aligned}\n$$\n\n \n\nThe function has critical points when $\\frac{∂(x,y)}{∂(u,v)}=0.$ So, we obtain \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =0 \\\\ 2{e}^{u+v}(v-u) & =0 \\\\ v-u & =0 \\\\ u & =v.\\end{aligned}\n$$\n\nThe equation $u=v$ defines a line in the $uv$-plane."}] [{:db/id #edb/ref 17592186278314 :knowledge-point/_questions [{:db/id #edb/ref 17592186198370 :knowledge-point/id #uuid "2fe16334-8f63-56ed-bd58-95e095993b9f" :knowledge-point/title "Jacobian Determinants of Inverse Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b7b11e3-ec58-5e4e-af9c-4b27fe57afa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186275572} {:answer/id #uuid "1b48c506-a496-56c6-9f38-211be2533d9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186275730} {:answer/id #uuid "877b2e30-bb6d-567a-a22b-1e9d08ebe6b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186276699} {:answer/id #uuid "c92b975d-bcee-5cb4-8f7c-c5b62dcd4759" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{5}" :db/id #edb/ref 17592186277263} {:answer/id #uuid "d27bbf8b-f7d8-58e5-a38d-897bd7f54bb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{10}" :db/id #edb/ref 17592186277335}] :answer-field/correct {:answer/id #uuid "d27bbf8b-f7d8-58e5-a38d-897bd7f54bb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{10}" :db/id #edb/ref 17592186277335} :answer-field/id #uuid "9b872a64-713f-5527-a8d1-f8a1304b926e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278002}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ed8207bc-4d78-5a97-b503-5177675ffb34" :question/math-academy-id "q-160581" :question/problem "Consider the transformation $T:(u,v)\\to (x(u,v),y(u,v)).$ The inverse transformation ${T}^{-1}(x,y)\\to (u(x,y),v(x,y))$ is given by\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}-x+7y \\\\ x+3y\\end{aligned}].\n$$\n\nFind the Jacobian determinant of $T.$" :question/worked-solution "Given a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]\\to [\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}|.\\end{aligned}\n$$\n\nIn this case, we're only given ${T}^{-1}.$ So, we compute the Jacobian determinant of $T$ as follows:\n\n- First, we compute $\\frac{∂(u,v)}{∂(x,y)},$ the Jacobian determinant of ${T}^{-1}.$\n\n- Then, we will compute the Jacobian determinant of $T$ using the relation\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}.\n$$\n\nHere, we have $u(x,y)=-x+7y$ and $v(x,y)=3x-y.$ \n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂u}{∂x} & =-1 & \\,\\frac{∂u}{∂y} & =7 \\\\ \\frac{∂v}{∂x} & =1 & \\,\\frac{∂v}{∂y} & =3\\end{aligned}\n$$\n\nTherefore, the Jacobian determinant of ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{aligned}| \\\\  & =|\\begin{aligned}-1 & 7 \\\\ 1 & 3\\end{aligned}| \\\\  & =(-1)\\cdot 3-7\\cdot 1 \\\\  & =-10.\\end{aligned}\n$$\n\n \n\nFinally, we take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & ={(\\frac{∂(u,v)}{∂(x,y)})}^{-1} \\\\  & =-\\frac{1}{10}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278316 :knowledge-point/_questions [{:db/id #edb/ref 17592186198370 :knowledge-point/id #uuid "2fe16334-8f63-56ed-bd58-95e095993b9f" :knowledge-point/title "Jacobian Determinants of Inverse Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2141fe03-5609-506c-ae00-264723dbff1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{v}" :db/id #edb/ref 17592186275778} {:answer/id #uuid "60c950bb-e6b5-566d-a83e-c5ddb2dd1bf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2u" :db/id #edb/ref 17592186276346} {:answer/id #uuid "90a0356c-7c2b-5475-809e-f584e2ea2afa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2u}" :db/id #edb/ref 17592186276788} {:answer/id #uuid "9e509876-60c7-502b-a36b-eb375b31d6f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2uv" :db/id #edb/ref 17592186276900} {:answer/id #uuid "c0e144d9-a262-5093-84e5-e89abb2f6f04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2v}" :db/id #edb/ref 17592186277192}] :answer-field/correct {:answer/id #uuid "c0e144d9-a262-5093-84e5-e89abb2f6f04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2v}" :db/id #edb/ref 17592186277192} :answer-field/id #uuid "e88fdffa-ff8d-5cae-a661-8b8827ff078f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278133}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "bcef19dc-e0d9-5a18-86b4-519865d6c64e" :question/math-academy-id "q-160599" :question/problem "Consider all non-critical points of the transformation $T:(u,v)\\to (x(u,v),y(u,v)).$ The inverse transformation ${T}^{-1}(x,y)\\to (u(x,y),v(x,y))$ is given by\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}xy \\\\ \\frac{x}{y}\\end{aligned}].\n$$\n\nFind the Jacobian determinant of $T$ in terms of $u$ and $v.$" :question/worked-solution "Given a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]\\to [\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}|.\\end{aligned}\n$$\n\nIn this case, we're only given ${T}^{-1}.$ So, we compute the Jacobian determinant of $T$ as follows:\n\n- First, we compute $\\frac{∂(u,v)}{∂(x,y)},$ the Jacobian determinant of ${T}^{-1}.$\n\n- Then, we will compute the Jacobian determinant of $T$ using the relation\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}.\n$$\n\n \nHere, we have $u(x,y)=xy$ and $v(x,y)=\\frac{x}{y}.$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂u}{∂x} & =y & \\,\\frac{∂u}{∂y} & =x \\\\ \\frac{∂v}{∂x} & =\\frac{1}{y} & \\,\\frac{∂v}{∂y} & =-\\frac{x}{{y}^{2}}\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{aligned}| \\\\  & =|\\begin{aligned}y & x \\\\ \\frac{1}{y} & -\\frac{x}{{y}^{2}}\\end{aligned}| \\\\  & =y\\cdot (-\\frac{x}{{y}^{2}})-x\\cdot \\frac{1}{y} \\\\  & =-\\frac{2x}{y} \\\\  & =-2v.\\end{aligned}\n$$\n\nFinally, we take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & ={(\\frac{∂(u,v)}{∂(x,y)})}^{-1} \\\\  & =-\\frac{1}{2v}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278322 :knowledge-point/_questions [{:db/id #edb/ref 17592186092274 :knowledge-point/id #uuid "b4df33ff-e04e-55ec-b273-9eceff7db53b" :knowledge-point/title "Identifying Rotation Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "049a038d-3516-5ec2-be1b-4e635ba4b278" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ba/ba328088ca187ea28b241a302a486da1145a51c7e134d8d4f529f5f4a916ddc1.png" :db/id #edb/ref 17592186275520} {:answer/id #uuid "14ebb756-3759-5271-b48e-6794e5fdec4a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ef/efb79fc1071f79597c81a0a974e7f6b21d361ac046f728625e2fe1c02bb507eb.png" :db/id #edb/ref 17592186275674} {:answer/id #uuid "743d0195-2c36-5bee-ab97-eb5a706e4262" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2d/2da0ffb873eb230718aab29c7dd09e015a0801b7ecb3b7dea91102f30b3e8816.png" :db/id #edb/ref 17592186276527} {:answer/id #uuid "7c566f0e-0800-5761-9b82-b362366c548c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/48/489bc530fc35e2e740038264f2be05bffb90214249ec5602591623d457325db3.png" :db/id #edb/ref 17592186276611} {:answer/id #uuid "c89d8c25-ddbe-5e3d-9e44-1ee0e28ea7dd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5b/5bd4d8cc2643767b82acc0e61d168f5b387be67a7ff96634604e0d6828cc288b.png" :db/id #edb/ref 17592186277262}] :answer-field/correct {:answer/id #uuid "049a038d-3516-5ec2-be1b-4e635ba4b278" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ba/ba328088ca187ea28b241a302a486da1145a51c7e134d8d4f529f5f4a916ddc1.png" :db/id #edb/ref 17592186275520} :answer-field/id #uuid "7489f911-b3ed-5658-95a0-34d33dc19d87" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277931}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ecda41b1-c814-51d0-b755-d1273a4b443b" :question/math-academy-id "q-160619" :question/problem "![](images/f3/f3e31d1c15a97adea32790eafe75ad1bc9f70c854b516b98de6648ec8d7bcb87.png)\n\nConsider the vector $v$ shown above. Find the vector $Av$ given that \n\n$$\nA=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}].\n$$" :question/worked-solution "Consider the standard basis ${i,j}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors. Computing the images of ${i,j}$ under $A$, we get the following:\n\n$$\n\\begin{aligned}{i}^{′} & =A(i)=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0\\end{aligned}]=-i \\\\ {j}^{′} & =A(j)=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}0 \\\\ -1\\end{aligned}]=-j\\end{aligned}\n$$\n\nAs a result, we obtain the following diagram:\n\n![](images/9f/9fae3ec0ada3008937d88e4e76374a56da4369b1821cfee072c90d88b562df46.png)\n\nSo, the matrix represents a rotation of $\\pi $ radians (counterclockwise or clockwise) about the origin.\n\nTherefore, in order to find $Av$, we need to rotate $v$ (counterclockwise or clockwise) by an angle of $\\pi $ radians, as shown below.\n\n![](images/ae/ae800b271848948b5f60f5cd7c1cecd163c2aa7399e9a87e2a52d158857c6a42.png)"}] [{:db/id #edb/ref 17592186389042 :knowledge-point/_questions [{:db/id #edb/ref 17592186092274 :knowledge-point/id #uuid "b4df33ff-e04e-55ec-b273-9eceff7db53b" :knowledge-point/title "Identifying Rotation Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87084364-abe0-5ffb-9ed0-31fcedec776e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/05/05963ad5c8caadae06a2dd07faaf217f7927d0698eaff91a219837a4171e4de8.png" :db/id #edb/ref 17592186389044} {:answer/id #uuid "f8720d56-2e77-5486-97d7-955b4f4b682c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/63/63d73b449ca97cfad5b54cad11e53b77554da361dbe3e33c5b6f58b23b802fec.png" :db/id #edb/ref 17592186389045} {:answer/id #uuid "a1071b7a-73e9-5844-9e1c-3d9330374aee" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/80/805c480c5341b6fbf3e8d5720187fead535db2a651939572a3a9faf453726087.png" :db/id #edb/ref 17592186389046} {:answer/id #uuid "41953237-f9fc-559c-82aa-b62b7ee3907a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/db/db5060bb186aee7860ad69d8a5c4516aa3e01e43c8f42b98f2cf260eb606357e.png" :db/id #edb/ref 17592186389047} {:answer/id #uuid "b1243d75-3778-5b5c-9522-8c36c581f9c8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ba/ba328088ca187ea28b241a302a486da1145a51c7e134d8d4f529f5f4a916ddc1.png" :db/id #edb/ref 17592186389048}] :answer-field/correct {:answer/id #uuid "a1071b7a-73e9-5844-9e1c-3d9330374aee" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/80/805c480c5341b6fbf3e8d5720187fead535db2a651939572a3a9faf453726087.png" :db/id #edb/ref 17592186389046} :answer-field/id #uuid "e6a0e1aa-f1db-5de6-9ec9-bf93b2ab6a7b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389043}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c94ecad8-4e36-5921-9c83-d90975b4539d" :question/math-academy-id "q-160626" :question/problem "![](images/c3/c32886c161e347daa9bf6fa7215f8a09abc4334632c33020c31ade6dfc4e7315.png)\n\nConsider the vector $v$ shown above. Find the vector $Av$ given that \n\n$$\nA=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}].\n$$" :question/worked-solution "Consider the standard basis ${i,j}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors. Computing the images of ${i,j}$ under $A$, we get the following:\n\n$$\n\\begin{aligned}{i}^{′} & =Ai=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}0 \\\\ 1\\end{aligned}]=j \\\\ {j}^{′} & =Aj=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0\\end{aligned}]=-i\\end{aligned}\n$$\n\nAs a result, we obtain the following diagram:\n\n![](images/f1/f154267ed0a528b1e9fbec40064b090560410fe76dab00070e13fb3d1978b59c.png)\n\nSo, the matrix represents a rotation of $\\frac{\\pi }{2}$ radians counterclockwise about the origin.\n\nTherefore, in order to find $Av$, we need to rotate $v$ counterclockwise by an angle of $\\frac{\\pi }{2}$ radians, as shown below.\n\n \n\n![](images/26/266af89426f86d22bc634a231c46a5ad89be14d06bc300a5fa20597998c826fd.png)"}] [{:db/id #edb/ref 17592186389049 :knowledge-point/_questions [{:db/id #edb/ref 17592186092274 :knowledge-point/id #uuid "b4df33ff-e04e-55ec-b273-9eceff7db53b" :knowledge-point/title "Identifying Rotation Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8867d91-bcda-5489-8280-49d891cc31ab" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ea/ead70b80d9256e1211addc404613f2dfe4a19baf822cbd77f429572ffc9a3a6d.png" :db/id #edb/ref 17592186389051} {:answer/id #uuid "48a91081-fad4-5761-a448-423550b39ed7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/70/70dfc0c8412bfae3bdbb7128fc021199f11d63d6f4ee264bea20da70dd18316c.png" :db/id #edb/ref 17592186389052} {:answer/id #uuid "3faab04f-ba07-5e75-a43f-8198da358c66" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5a/5a1923eec2b66ef4eb861ec42b00ea48a3285aaaf3255c42d12c001c9cde32f8.png" :db/id #edb/ref 17592186389053} {:answer/id #uuid "fe51163e-7d12-5501-9934-728d90d9412d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/09/09b2ae9333118de0621a5f29610b6a83689fadaeb9c05e7a30b2799b12a1bd58.png" :db/id #edb/ref 17592186389054} {:answer/id #uuid "7c87cd81-f329-516d-8bf5-dc6b1dc8dca3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/23/23f63717c8d356c698137359824112511b0bbd5ec04c59e47d22500d842d03b6.png" :db/id #edb/ref 17592186389055}] :answer-field/correct {:answer/id #uuid "48a91081-fad4-5761-a448-423550b39ed7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/70/70dfc0c8412bfae3bdbb7128fc021199f11d63d6f4ee264bea20da70dd18316c.png" :db/id #edb/ref 17592186389052} :answer-field/id #uuid "328c6cdb-dc56-550a-b1a6-60351bc4df59" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389050}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "04e79ef7-7090-527f-95f0-0f13ae5b3650" :question/math-academy-id "q-160627" :question/problem "![](images/0b/0bd98626bc49cc3c58e503d5a7373b6af0fcce721cfdf82ff372eaa57d157dda.png)\n\nConsider the vector $v$ shown above. Find the vector $Av$ given that \n\n$$\nA=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}].\n$$" :question/worked-solution "Consider the standard basis ${i,j}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors. Computing the images of ${i,j}$ under $A$, we get the following:\n\n$$\n\\begin{aligned}{i}^{′} & =Ai=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}0 \\\\ -1\\end{aligned}]=-j \\\\ {j}^{′} & =Aj=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}1 \\\\ 0\\end{aligned}]=i\\end{aligned}\n$$\n\nAs a result, we obtain the following diagram:\n\n![](images/77/77936c4115b37d79ae301a93b218ecd23114ae4ad42d8298b8f058c1f50e82a2.png)\n\nSo, the matrix represents a rotation of $\\frac{\\pi }{2}$ radians **clockwise** about the origin.\n\nTherefore, in order to find $Av$, we need to rotate $v$ **clockwise** by an angle of $\\frac{\\pi }{2}$ radians, as shown below.\n\n![](images/d5/d5ff1c1a7c99b08d04d2ac58d9f8195ee29c8b564873a9abfb2635e93cec1968.png)"}] [{:db/id #edb/ref 17592186115511 :knowledge-point/_questions [{:db/id #edb/ref 17592186115354 :knowledge-point/id #uuid "461c0f55-cb85-511e-b8cb-be11f8a3c250" :knowledge-point/title "Domains of Functions With Reciprocal and Radical Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b7c26a5-b179-5fa4-80bf-1c61cfe73961" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\in (-\\infty ,-1)\\cup (-1,\\infty )" :db/id #edb/ref 17592186276744} {:answer/id #uuid "9c4d8231-1900-5e4d-93ea-adbad23077ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\in (-2,3)\\cup (3,\\infty )" :db/id #edb/ref 17592186276880} {:answer/id #uuid "9cee549a-9a5f-5b5c-aa7a-2efb2ed679d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\in [-2,\\infty )" :db/id #edb/ref 17592186276887} {:answer/id #uuid "b52d3969-61c1-5058-85b1-1855191dad4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\in (-2,-1)\\cup (-1,\\infty )" :db/id #edb/ref 17592186277093} {:answer/id #uuid "c4e8c438-f45e-5188-b4c6-b57b88aeeefe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\in (-\\infty ,-3)\\cup (-3,-2)" :db/id #edb/ref 17592186277229}] :answer-field/correct {:answer/id #uuid "9cee549a-9a5f-5b5c-aa7a-2efb2ed679d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\in [-2,\\infty )" :db/id #edb/ref 17592186276887} :answer-field/id #uuid "f859f300-1c35-5cef-a858-4e363615bbec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278163}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a468193a-ad5b-5942-ba5c-e4d6c31b221a" :question/math-academy-id "q-160771" :question/problem "Find the domain of the vector-valued function $f(t)=\\sqrt{2+t}\\,i+\\frac{1}{3+t}\\,j+(1+{t}^{2})\\,k.$" :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component $\\sqrt{2+t}$ is $t\\in [-2,\\infty ).$\n\n- The domain of the 2nd component $\\frac{1}{3+t}$ is $t\\in (-\\infty ,-3)\\cup (-3,\\infty ).$\n\n- The domain of the 3rd component $1+{t}^{2}$ is $t\\in (-\\infty ,\\infty ).$\n\nThe intersection is illustrated in the diagram below.\n\n![](images/01/01998bcc54d297275af928b2467e7bcc077c84fd595567f5b3ff5bf89d38ec7b.png)\n\nTherefore, the domain of the vector-valued function $f(t)$ is $t\\in [-2,\\infty ).$"}] [{:db/id #edb/ref 17592186115512 :knowledge-point/_questions [{:db/id #edb/ref 17592186115355 :knowledge-point/id #uuid "74a1499c-080d-5008-bcc3-492ef469d3dc" :knowledge-point/title "Domains of Functions With Exponential and Logarithmic Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32535c3f-61ed-5f25-8197-6617098257db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\in (1,\\infty )" :db/id #edb/ref 17592186275922} {:answer/id #uuid "4b297d62-5e2b-5010-8a9c-255e9fc26f83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\in [-2,1)" :db/id #edb/ref 17592186276139} {:answer/id #uuid "7bd173d4-cbe6-5f62-8a8b-e79daafb4955" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\in [2,\\infty )" :db/id #edb/ref 17592186276604} {:answer/id #uuid "a3e764d0-8597-5499-b3f2-c0d13b658393" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\in (1,2]" :db/id #edb/ref 17592186276956} {:answer/id #uuid "fb100b03-5314-5d26-a423-fff6e2e8f76f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\in [-2,\\infty )" :db/id #edb/ref 17592186277678}] :answer-field/correct {:answer/id #uuid "a3e764d0-8597-5499-b3f2-c0d13b658393" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\in (1,2]" :db/id #edb/ref 17592186276956} :answer-field/id #uuid "ce14a927-c42a-513a-aaf5-9957db497289" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278087}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bb7e3a68-e14a-5c87-8890-f72233849744" :question/math-academy-id "q-160773" :question/problem "Find the domain of the vector-valued function $f(t)=\\sqrt{4-{t}^{2}}\\,i+\\operatorname{ln}⁡(t-1)\\,j+{e}^{t}\\,k.$" :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component $\\sqrt{4-{t}^{2}}$ is $t\\in [-2,2].$\n\n- The domain of the 2nd component $\\operatorname{ln}⁡(t-1)$ is $t\\in (1,\\infty ).$\n\n- The domain of the 3rd component ${e}^{t}$ is $t\\in (-\\infty ,\\infty ).$\n\nThe intersection is illustrated in the diagram below.\n\n![](images/d4/d43c856bf43fb3783a7ee34b2553879fdb99a791587f1c1e466bc135c868052d.png)\n\nTherefore, the domain of the vector-valued function $f(t)$ is $t\\in (1,2].$"}] [{:db/id #edb/ref 17592186278335 :knowledge-point/_questions [{:db/id #edb/ref 17592186068859 :knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "097dd637-ab1a-5934-879d-2dd76c1232d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,i+2\\,j+16\\,k" :db/id #edb/ref 17592186275558} {:answer/id #uuid "1cb2f958-aaa0-5019-a603-03c2e90484e8" :answer/type {:db/id #edb/ref 