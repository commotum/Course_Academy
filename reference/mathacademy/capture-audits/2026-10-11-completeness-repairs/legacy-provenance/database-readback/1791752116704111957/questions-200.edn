answer.type/math} :answer/value "t=3\\,\\text{s}" :db/id #edb/ref 17592186241805} {:answer/id #uuid "7f046870-004c-57c6-8028-e12381de9387" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=2\\,\\text{s}" :db/id #edb/ref 17592186242297} {:answer/id #uuid "d4624b7d-a819-5b66-9c7d-9ee3dc8ad598" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{3}{2}\\,\\text{s}" :db/id #edb/ref 17592186243058}] :answer-field/correct {:answer/id #uuid "458e6df8-c4b8-5e51-a675-25da3ce4e6be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=3\\,\\text{s}" :db/id #edb/ref 17592186241805} :answer-field/id #uuid "6c21b487-70f8-58fd-9e35-6199acee103a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243651}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "86745f4a-9b3a-5cb4-90c7-0e4ceefd13ac" :question/math-academy-id "q-109275" :question/problem "The position $s(t)$ of a particle (in meters) at time $t$ seconds is given by \n\n$$\ns(t)=\\operatorname{ln}⁡({t}^{2}-6t+10),\\,t\\ge 0.\n$$\n\nCalculate the time at which the particle is stationary." :question/worked-solution "The particle is stationary when its velocity is zero. So first, we need to calculate the velocity function. We can do that by taking the derivative of the position function, as follows:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡({t}^{2}-6t+10)) \\\\  & =\\frac{2t-6}{{t}^{2}-6t+10} \\\\  & =\\frac{2(t-3)}{{t}^{2}-6t+10}\\end{aligned}\n$$\n\nThe particle is stationary when $v=0\\,\\text{m/s}.$ So, we set $v=0$ and solve for $t:$\n\n$$\n\\begin{aligned}\\frac{2(t-3)}{{t}^{2}-6t+10} & =0 \\\\ 2(t-3) & =0 \\\\ t & =3\\end{aligned}\n$$\n\nTherefore, the particle is stationary at $t=3\\,\\text{s}.$"}] [{:db/id #edb/ref 17592186244267 :knowledge-point/_questions [{:db/id #edb/ref 17592186175939 :knowledge-point/id #uuid "f8f3989e-bde0-5b3a-8d45-08f34d330c3f" :knowledge-point/title "Determining Intervals of Increasing or Decreasing Displacement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5491f591-d1f5-5096-bb5a-362b607a745d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{{e}^{2}},\\infty )" :db/id #edb/ref 17592186241940} {:answer/id #uuid "59724b05-5748-5ef6-8e67-bfdc7ae500d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,e)" :db/id #edb/ref 17592186241986} {:answer/id #uuid "9ddbbecb-379e-5707-a279-ee668273978e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(e,\\infty )" :db/id #edb/ref 17592186242559} {:answer/id #uuid "b3001024-ad85-5df3-9361-f47fa75ca379" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\frac{1}{{e}^{2}})" :db/id #edb/ref 17592186242737} {:answer/id #uuid "b5c50f32-5bbb-538d-a220-076d076e5442" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\frac{2}{e})" :db/id #edb/ref 17592186242769}] :answer-field/correct {:answer/id #uuid "b3001024-ad85-5df3-9361-f47fa75ca379" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\frac{1}{{e}^{2}})" :db/id #edb/ref 17592186242737} :answer-field/id #uuid "1cb803c2-293d-5947-803b-a292a21a42c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243495}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8de2ca9e-4b83-5dd2-84c1-5e6128a2ad43" :question/math-academy-id "q-109289" :question/problem "The displacement $s,$ in meters, relative to a fixed origin $O$ of a particle moving in a straight line along the $x$-axis is given by $s(t)=\\sqrt{t}\\,\\operatorname{ln}⁡t,$ where $t>0$ is the time measured in seconds. Determine the time intervals in which the particle is moving in the direction of decreasing $x.$" :question/worked-solution "If the particle moves in the direction of decreasing $x,$ then its velocity is negative. \n\nFirst, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\sqrt{t}\\,\\operatorname{ln}⁡t) \\\\  & =\\frac{\\operatorname{ln}⁡t}{2\\sqrt{t}}+\\frac{\\sqrt{t}}{t} \\\\  & =\\frac{\\operatorname{ln}⁡t}{2\\sqrt{t}}+\\frac{1}{\\sqrt{t}} \\\\  & =\\frac{\\operatorname{ln}⁡t+2}{2\\sqrt{t}}\\end{aligned}\n$$\n\nTo calculate time intervals in which the particle is moving in the direction of decreasing $x$, we solve the inequality $v(t)<0:$\n\n$$\n\\begin{aligned}v(t) & <0 \\\\ \\frac{\\operatorname{ln}⁡t+2}{2\\sqrt{t}} & <0 \\\\ \\operatorname{ln}⁡t+2 & <0 \\\\ \\operatorname{ln}⁡t & <-2 \\\\ t & <{e}^{-2} \\\\ t & <\\frac{1}{{e}^{2}}\\end{aligned}\n$$\n\nTherefore, the time interval in which the particle is moving to the direction of decreasing $x$ is $t\\in (0,\\frac{1}{{e}^{2}}).$"}] [{:db/id #edb/ref 17592186399664 :knowledge-point/_questions [{:db/id #edb/ref 17592186176099 :knowledge-point/id #uuid "bee6d4bf-79da-5eb3-a214-8c045dbce5bd" :knowledge-point/title "Calculating the Velocity of a Particle at the Moment When Its Acceleration is Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5103ad76-a94a-5286-8ba5-a77f53f60465" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=1,\\,v=\\frac{15}{2}" :db/id #edb/ref 17592186399666} {:answer/id #uuid "8436223b-700a-5cfc-999b-c15dd1c4967a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{3}{2},\\,v=-\\frac{21}{2}" :db/id #edb/ref 17592186399667} {:answer/id #uuid "48bbfde1-4a90-5800-90a2-a13b81b7ffae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=1,\\,v=-7" :db/id #edb/ref 17592186399668} {:answer/id #uuid "dbee7bb0-5392-5018-a5d9-d29c6d9994e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{3}{2},\\,v=9" :db/id #edb/ref 17592186399669} {:answer/id #uuid "9445423e-a521-575c-b99b-639347c58fec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{1}{2},\\,v=-\\frac{8}{3}" :db/id #edb/ref 17592186399670}] :answer-field/correct {:answer/id #uuid "8436223b-700a-5cfc-999b-c15dd1c4967a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{3}{2},\\,v=-\\frac{21}{2}" :db/id #edb/ref 17592186399667} :answer-field/id #uuid "689f3bd0-df18-5a92-92e6-a4a5162ad010" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399665}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6414dac4-9443-5e38-b246-ae2ca315e478" :question/math-academy-id "q-109302" :question/problem "A particle $P$ is traveling along the $x$-axis with displacement $s(t)$ from a fixed origin $O$ given by\n\n$$\ns(t)=2{t}^{3}-9{t}^{2}+3t-2,\\,t\\ge 0.\n$$\n\nFind the time at which the acceleration is zero, and find the value of the velocity at this moment." :question/worked-solution "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2{t}^{3}-9{t}^{2}+3t-2) \\\\  & =6{t}^{2}-18t+3\\end{aligned}\n$$\n\nNow, we differentiate $v(t)$ to find $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(6{t}^{2}-18t+3) \\\\  & =12t-18\\end{aligned}\n$$\n\nNext, we put $a=0$ to find the time when the acceleration is zero:\n\n$$\n\\begin{aligned}12t-18 & =0 \\\\ t & =\\frac{18}{12} \\\\ t & =\\frac{3}{2}\\end{aligned}\n$$\n\nNow, the acceleration is zero when $t=\\frac{3}{2}.$ To find the velocity at this moment, we substitute this back into $v(t)$ to get\n\n$$\n\\begin{aligned}v(\\frac{3}{2}) & =6{(\\frac{3}{2})}^{2}-18(\\frac{3}{2})+3 \\\\  & =6(\\frac{9}{4})-27+3 \\\\  & =\\frac{27}{2}-27+3 \\\\  & =-\\frac{21}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186399671 :knowledge-point/_questions [{:db/id #edb/ref 17592186176099 :knowledge-point/id #uuid "bee6d4bf-79da-5eb3-a214-8c045dbce5bd" :knowledge-point/title "Calculating the Velocity of a Particle at the Moment When Its Acceleration is Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1f8e3ed-64ac-534b-9097-97dd33f2545d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{3}{2},\\,v=-\\frac{9}{2}" :db/id #edb/ref 17592186399673} {:answer/id #uuid "106f9321-de03-58f4-8540-f31885a755c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=2,\\,v=-4" :db/id #edb/ref 17592186399674} {:answer/id #uuid "084bda93-d0d6-514b-b8c7-73ce821b2053" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{7}{3},\\,v=\\frac{49}{3}" :db/id #edb/ref 17592186399675} {:answer/id #uuid "367c159c-f8cf-54ab-9cdc-cfddc4ed2a5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=2,\\,v=6" :db/id #edb/ref 17592186399676} {:answer/id #uuid "212ea060-615f-5258-8e09-ac350ea1ca59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{7}{3},\\,v=\\frac{15}{6}" :db/id #edb/ref 17592186399677}] :answer-field/correct {:answer/id #uuid "084bda93-d0d6-514b-b8c7-73ce821b2053" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{7}{3},\\,v=\\frac{49}{3}" :db/id #edb/ref 17592186399675} :answer-field/id #uuid "1669c4fe-448a-5ecd-96c2-60941d083824" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399672}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7704a427-55d1-5f8e-bf57-d941d8544127" :question/math-academy-id "q-109307" :question/problem "A particle $P$ is traveling along the $x$-axis with displacement $s(t)$ from a fixed origin $O$ given by\n\n$$\ns(t)=7{t}^{2}-{t}^{3},\\,t\\ge 0.\n$$\n\nFind the time at which the acceleration is zero, and find the value of the velocity at this moment." :question/worked-solution "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(7{t}^{2}-{t}^{3}) \\\\  & =14t-3{t}^{2}\\end{aligned}\n$$\n\nNow, we differentiate $v(t)$ to find $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(14t-3{t}^{2}) \\\\  & =14-6t\\end{aligned}\n$$\n\nNext, we put $a=0$ to find the time when the acceleration is zero:\n\n$$\n\\begin{aligned}14-6t & =0 \\\\ -6t & =-14 \\\\ t & =\\frac{7}{3}\\end{aligned}\n$$\n\nNow, the acceleration is zero when $t=\\frac{7}{3}.$ To find the velocity at this moment, we substitute this back into $v(t)$ to get\n\n$$\n\\begin{aligned}v(\\frac{7}{3}) & =14(\\frac{7}{3})-3{(\\frac{7}{3})}^{2} \\\\  & =\\frac{98}{3}-\\frac{49}{3} \\\\  & =\\frac{49}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186366966 :knowledge-point/_questions [{:db/id #edb/ref 17592186175958 :knowledge-point/id #uuid "33fca834-0063-5252-832f-5efb4be6e599" :knowledge-point/title "Simplifying Expressions Using the Properties of Expected Value"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a10dc86-ff23-520f-bb7d-01f1fd3f0df3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "85" :db/id #edb/ref 17592186366968} {:answer/id #uuid "1fc419e1-dffb-57bd-b9fd-e94cd7418761" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186366969} {:answer/id #uuid "c2754698-c613-52e6-9337-078ae2cfe4ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "65" :db/id #edb/ref 17592186366970} {:answer/id #uuid "f5dd9e61-2fcd-565e-ab2d-fed246da90e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186366971} {:answer/id #uuid "84d408b6-fb2f-5e94-bf0c-cd3e2a2e1732" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "75" :db/id #edb/ref 17592186366972}] :answer-field/correct {:answer/id #uuid "84d408b6-fb2f-5e94-bf0c-cd3e2a2e1732" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "75" :db/id #edb/ref 17592186366972} :answer-field/id #uuid "d36c8e92-fcb7-5e3d-ab55-73609d8a55a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366967}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "98aa85f0-c464-533a-b818-b008c56bd4cf" :question/math-academy-id "q-109312" :question/problem "Compute $\\text{E}[X(3X-2)+4]$ if $\\text{E}[{X}^{2}]=27$ and $\\text{E}[X]=5.$" :question/worked-solution "Expanding out the product inside the expected value, using the properties of the expected value, and substituting in the given information, we get\n\n$$\n\\begin{aligned}\\text{E}[X(3X-2)+4] & =\\text{E}[3{X}^{2}-2X+4] \\\\  & =3\\text{E}[{X}^{2}]-2\\text{E}[X]+\\text{E}[4] \\\\  & =3\\text{E}[{X}^{2}]-2\\text{E}[X]+4 \\\\  & =3(27)-2(5)+4 \\\\  & =75.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186162281 :knowledge-point/_questions [{:db/id #edb/ref 17592186162073 :knowledge-point/id #uuid "c0e20c64-85be-5cb5-acde-17ffd8b6aff5" :knowledge-point/title "Calculating a Joint Probability From a Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56352e44-4639-5ce2-8328-40cc245942bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186241958} {:answer/id #uuid "73c013ff-8b9b-5f1a-89bb-56a1e287ff55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.25" :db/id #edb/ref 17592186242205} {:answer/id #uuid "8b64b2e8-7565-5ccf-9be9-aeac850d33c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.35" :db/id #edb/ref 17592186242413} {:answer/id #uuid "cedf53aa-fb6e-50da-822f-9f8ac28954d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.7" :db/id #edb/ref 17592186243002} {:answer/id #uuid "fe55b789-4f11-5c45-b6a8-452a8e54a7b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.4" :db/id #edb/ref 17592186243419}] :answer-field/correct {:answer/id #uuid "cedf53aa-fb6e-50da-822f-9f8ac28954d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.7" :db/id #edb/ref 17592186243002} :answer-field/id #uuid "75a7a904-5ab0-5c44-a2ce-c9e4ea26385a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243668}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "982b31fd-731a-56a2-a3eb-b1749eaecfdc" :question/math-academy-id "q-109335" :question/problem "|  | $Y=2$ | $Y=4$ | $Y=6$ |\n| --- | --- | --- | --- |\n| $X=1$ | $0.1$ | $0.25$ | $0.25$ |\n| $X=2$ | $0.05$ | $0.15$ | $0.2$ |\n\nCompute $P((X,Y)\\in {(1,4),(1,6),(2,6)})$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." :question/worked-solution "Using the values in the table, we have\n\n$$\n\\begin{aligned}P((X,Y)\\in {(1,4),(1,6),(2,6)}) & =P((X,Y)=(1,4)) \\\\  & +P((X,Y)=(1,6)) \\\\  & +P((X,Y)=(2,6)) \\\\  & =f(1,4)+f(1,6)+f(2,6) \\\\  & =0.25+0.25+0.2 \\\\  & =0.7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059987 :knowledge-point/_questions [{:db/id #edb/ref 17592186059751 :knowledge-point/id #uuid "2e1b4442-eca7-5283-9d5d-5bcbd1d67975" :knowledge-point/title "Calculating a Minor in a 3x3 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3483de1a-1f65-5553-adea-5c1f86b3e57c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186241641} {:answer/id #uuid "5eee975d-4bfb-507e-be00-76be487d029e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186242033} {:answer/id #uuid "6b31fbe0-f8ff-5f08-9a26-caf4d911af3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186242143} {:answer/id #uuid "a528f703-fb11-59ec-ad99-43d1904c252b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186242634} {:answer/id #uuid "f3a4905a-bcb6-5d72-aad1-aa967ac93c4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186243339}] :answer-field/correct {:answer/id #uuid "5eee975d-4bfb-507e-be00-76be487d029e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186242033} :answer-field/id #uuid "23210561-cf23-5be2-bbb6-5445ea1b8741" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243505}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "367551dc-32de-5040-981b-1232c513fd73" :question/math-academy-id "q-1094" :question/problem "Calculate the minor of the entry ${y}_{13}$ in the matrix\n$Y=[\\begin{aligned}15 & 8 & 9 \\\\ 7 & 1 & 2 \\\\ 0 & -1 & 2\\end{aligned}].$" :question/worked-solution "The minor of ${y}_{13}=9$ (first row, third column) is the determinant of the remaining entries when the column and row containing $9$ are removed: \n\n$$\nY=[\\begin{aligned}∗ & ∗ & 9 \\\\ 7 & 1 & ∗ \\\\ 0 & -1 & ∗\\end{aligned}]\n$$\n\nSo, the minor of ${y}_{13}=9$ is\n\n$$\n\\begin{aligned}det[\\begin{aligned}7 & 1 \\\\ 0 & -1\\end{aligned}] & =|\\begin{aligned}7 & 1 \\\\ 0 & -1\\end{aligned}| \\\\  & =7\\cdot (-1)-1\\cdot 0 \\\\  & =-7-0 \\\\  & =-7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186162292 :knowledge-point/_questions [{:db/id #edb/ref 17592186162073 :knowledge-point/id #uuid "c0e20c64-85be-5cb5-acde-17ffd8b6aff5" :knowledge-point/title "Calculating a Joint Probability From a Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10ee530b-2730-515a-b04d-3424a3f4859e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186244472} {:answer/id #uuid "3f77508a-a2ab-557b-af51-8d85ce09e6a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186244870} {:answer/id #uuid "6e022677-bb73-5354-9b11-25e791f132ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186245287} {:answer/id #uuid "97748e9b-aea5-5774-bd58-a4b1fb3d5773" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}" :db/id #edb/ref 17592186245647} {:answer/id #uuid "eb22594f-fd8a-5c8c-a817-b6845d93e452" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186246399}] :answer-field/correct {:answer/id #uuid "10ee530b-2730-515a-b04d-3424a3f4859e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186244472} :answer-field/id #uuid "e39c6d6e-2868-5d8c-ab9d-2b8cc0c4279f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246950}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3b94d2fe-04a5-5a10-9bc3-43bdb999a3a4" :question/math-academy-id "q-109686" :question/problem "|  | $Y=0$ | $Y=1$ |\n| --- | --- | --- |\n| $X=0$ | $\\frac{1}{4}$ | $\\frac{1}{2}$ |\n| $X=1$ | $\\frac{1}{8}$ | $\\frac{1}{8}$ |\n\nCalculate $P(X=0,Y=1)$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." :question/worked-solution "Using the table, we have\n\n$$\nP(X=0,Y=1)=f(0,1)=\\frac{1}{2}.\n$$"}] [{:db/id #edb/ref 17592186247047 :knowledge-point/_questions [{:db/id #edb/ref 17592186096756 :knowledge-point/id #uuid "96967f25-565a-5338-878e-00fd30055772" :knowledge-point/title "Calculating the Area Bounded Below a Curve and Above the X-Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c99c79c-7899-501c-aa44-8e028899ea3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{19}{6}" :db/id #edb/ref 17592186245273} {:answer/id #uuid "84dd79d9-148d-56b1-b230-e49870bdeafb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{6}" :db/id #edb/ref 17592186245486} {:answer/id #uuid "966fea7b-7981-584d-9f83-ee03b91e4ea3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{27}{2}" :db/id #edb/ref 17592186245640} {:answer/id #uuid "9e9c6db4-7556-54fb-9a9d-10994687003e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{6}" :db/id #edb/ref 17592186245729} {:answer/id #uuid "d16bb5fe-bb92-5361-9748-3bb2cfa9f2fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{19}{6}" :db/id #edb/ref 17592186246178}] :answer-field/correct {:answer/id #uuid "9e9c6db4-7556-54fb-9a9d-10994687003e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{6}" :db/id #edb/ref 17592186245729} :answer-field/id #uuid "a9b4af2b-1c9c-51fa-b90d-538ea68ce074" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246851}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9331fa0c-5003-5d00-8a98-a52c36a44bdd" :question/math-academy-id "q-10978" :question/problem "![](images/09/09482b1e9903bff25b16b2239975831e6d54440a8f8ea78f5739b0eafee3d9e8.png)\n\nFind the area between the curve $y=-2{x}^{2}-x+3$, the $x$-axis and the $y$-axis, shown above." :question/worked-solution "To find the area, we just need to compute the corresponding definite integral:\n\n$$\n\\begin{aligned}A & ={\\int }_{a}^{b}y(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}(-2{x}^{2}-x+3)\\,\\text{d}x \\\\  & =-2{\\int }_{0}^{1}{x}^{2}\\,\\text{d}x-1{\\int }_{0}^{1}x\\,\\text{d}x+3{\\int }_{0}^{1}\\,\\text{d}x \\\\  & =-2\\cdot {\\frac{{x}^{3}}{3}|}_{0}^{1}-1\\cdot {\\frac{{x}^{2}}{2}|}_{0}^{1}+3x{|}_{0}^{1} \\\\  & =-2(\\frac{1}{3}-0)-1(\\frac{1}{2}-0)+3(1-0) \\\\  & =-\\frac{2}{3}-\\frac{1}{2}+3 \\\\  & =\\frac{11}{6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247055 :knowledge-point/_questions [{:db/id #edb/ref 17592186096683 :knowledge-point/id #uuid "7e66d7cf-1a4b-51e6-9c78-f70a8c0555df" :knowledge-point/title "Expressing a Rational Function With Three Linear Factors as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41194700-a88a-5de8-9f24-f3c32143a64f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{(3-x)}-\\frac{5}{(2-x)}+\\frac{1}{(x+1)}" :db/id #edb/ref 17592186244885} {:answer/id #uuid "4e422a04-18f2-59e2-a393-df7b6a8004be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{(3-x)}+\\frac{1}{(2-x)}-\\frac{6}{(x+1)}" :db/id #edb/ref 17592186245007} {:answer/id #uuid "9c91ab1d-3d06-53b3-b5e5-8f8fe8bb4e69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{(3-x)}+\\frac{10}{(2-x)}-\\frac{2}{(x+1)}" :db/id #edb/ref 17592186245704} {:answer/id #uuid "b74f8f7b-03ab-5c30-a84d-e353f0aaedcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{(3-x)}+\\frac{2}{(2-x)}-\\frac{5}{(x+1)}" :db/id #edb/ref 17592186245951} {:answer/id #uuid "db943c38-ecc5-5aae-b0af-de25da6bb882" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{(3-x)}-\\frac{4}{(2-x)}+\\frac{9}{(x+1)}" :db/id #edb/ref 17592186246262}] :answer-field/correct {:answer/id #uuid "b74f8f7b-03ab-5c30-a84d-e353f0aaedcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{(3-x)}+\\frac{2}{(2-x)}-\\frac{5}{(x+1)}" :db/id #edb/ref 17592186245951} :answer-field/id #uuid "98e9c5d2-341d-5db4-a4e2-54315de20ea2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246814}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "400ab8c9-505d-514d-9b8b-a37c002e9bd9" :question/math-academy-id "q-10986" :question/problem "Express $\\frac{22x-38}{(3-x)(2-x)(x+1)}$ as a sum of partial fractions." :question/worked-solution "Our task is to find $A,$ $B$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{22x-38}{(3-x)(2-x)(x+1)} & =\\frac{A}{(3-x)}+\\frac{B}{(2-x)}+\\frac{C}{(x+1)}.\\end{aligned}\n$$\n\nMultiplying both sides by $(3-x)(2-x)(x+1)$ gives\n\n$$\n22x-38=A(2-x)(x+1)+B(3-x)(x+1)+C(3-x)(2-x).\n$$\n\nFor $x=3$, we get \n\n$$\n\\begin{aligned}22(3)-38 & =A(2-3)(3+1) \\\\  & \\,+B(3-3)(3+1) \\\\  & \\,+C(3-3)(2-3) \\\\ 66-38 & =A(-4) \\\\ A & =\\frac{28}{-4} \\\\ A & =-7.\\end{aligned}\n$$\n\nFor $x=2$, we get \n\n$$\n\\begin{aligned}22(2)-38 & =A(2-2)(2+1) \\\\  & \\,+B(3-2)(2+1) \\\\  & \\,+C(3-2)(2-2) \\\\ 44-38 & =B(3) \\\\ B & =\\frac{6}{3} \\\\ B & =2.\\end{aligned}\n$$\n\nFor $x=-1$, we get \n\n$$\n\\begin{aligned}22(-1)-38 & =A(2-(-1))(-1+1) \\\\  & \\,+B(3-(-1))(-1+1) \\\\  & \\,+C(3-(-1))(2-(-1)) \\\\ -22-38 & =C(12) \\\\ C & =\\frac{-60}{12} \\\\ C & =-5.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\frac{22x-38}{(3-x)(2-x)(x+1)}=-\\frac{7}{(3-x)}+\\frac{2}{(2-x)}-\\frac{5}{(x+1)}.\n$$"}] [{:db/id #edb/ref 17592186247056 :knowledge-point/_questions [{:db/id #edb/ref 17592186096683 :knowledge-point/id #uuid "7e66d7cf-1a4b-51e6-9c78-f70a8c0555df" :knowledge-point/title "Expressing a Rational Function With Three Linear Factors as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fc1086c-ae6d-5627-a9bf-0594bb709ade" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186244742} {:answer/id #uuid "b2d0c3be-0fd6-5bf4-bf9e-8621adbd759c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186245906} {:answer/id #uuid "bdfb317b-c63e-55f3-a734-4593cadb4bb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186246006} {:answer/id #uuid "cae876a4-e90f-5e79-9cf3-81a298ccd0f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186246119} {:answer/id #uuid "e971006f-f0a6-5a44-9eee-63de0ba56858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186246383}] :answer-field/correct {:answer/id #uuid "e971006f-f0a6-5a44-9eee-63de0ba56858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186246383} :answer-field/id #uuid "c2cbe5ea-38be-5f8f-ad09-74a001ac8e73" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246898}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "eed23ce3-ed2f-59db-8baa-f9c235e009f0" :question/math-academy-id "q-10988" :question/problem "Given that\n\n$$\n\\frac{13{x}^{2}-19x-16}{(3x+2)(x-3)(x+1)}=\\frac{A}{(3x+2)}+\\frac{B}{(x-3)}+\\frac{C}{(x+1)},\n$$\n\nwhere $A,$ $B$ and $C$ are real constants, calculate $A+B+C.$" :question/worked-solution "Our task is to find $A,$ $B$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{13{x}^{2}-19x-16}{(3x+2)(x-3)(x+1)}=\\frac{A}{(3x+2)}+\\frac{B}{(x-3)}+\\frac{C}{(x+1)}.\\end{aligned}\n$$\n\nMultiplying both sides by $(3x+2)(x-3)(x+1)$ gives\n\n$$\n13{x}^{2}-19x-16=A(x-3)(x+1)+B(3x+2)(x+1)+C(3x+2)(x-3).\n$$\n\nFor $x=-\\frac{2}{3}$, we get \n\n$$\n\\begin{aligned}13{(-\\frac{2}{3})}^{2}-19(-\\frac{2}{3})-16 & =A(-\\frac{2}{3}-3)(-\\frac{2}{3}+1) \\\\  & \\,+B(3(-\\frac{2}{3})+2)(-\\frac{2}{3}+1) \\\\  & \\,+C(3(-\\frac{2}{3})+1)(-\\frac{2}{3}-3) \\\\ \\frac{52}{9}+\\frac{38}{3}-16 & =A(\\frac{(-11)(1)}{9}) \\\\ \\frac{52+114-144}{9} & =A(-\\frac{11}{9}) \\\\ A & =-\\frac{22}{11} \\\\ A & =-2.\\end{aligned}\n$$\n\nFor $x=3$, we obtain\n\n$$\n\\begin{aligned}13(3)^{2}-19(3)-16 & =A(3-3)(3+1) \\\\  & \\,+B(3(3)+2)(3+1) \\\\  & \\,+C(3(3)+2)(3-3) \\\\ 117-57-16 & =B(44) \\\\ B & =\\frac{44}{44} \\\\ B & =1.\\end{aligned}\n$$\n\nFor $x=-1$, we get \n\n$$\n\\begin{aligned}13(-1)^{2}-19(-1)-16 & =A(-1-3)(-1+1) \\\\  & \\,+B(3(-1)+2)(-1+1) \\\\  & \\,+C(3(-1)+2)(-1-3) \\\\ 13+19-16 & =C(4) \\\\ C & =\\frac{16}{4} \\\\ C & =4.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\begin{aligned}A+B+C & =(-2)+1+4=3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186367033 :knowledge-point/_questions [{:db/id #edb/ref 17592186175991 :knowledge-point/id #uuid "0c105dd8-6739-5889-a529-9182ea814d76" :knowledge-point/title "Calculating the Second Moment of a Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c7c60cd-5024-55ec-bf55-90bd345a929c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.25" :db/id #edb/ref 17592186367035} {:answer/id #uuid "c49e6e93-c3f2-58c1-92b0-733c5d41c113" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.35" :db/id #edb/ref 17592186367036} {:answer/id #uuid "1ab5a0bc-628f-5ae7-831c-d5508a0a1f85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.15" :db/id #edb/ref 17592186367037} {:answer/id #uuid "d9fcb953-2f03-5b92-9bf5-317b36a3dd49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.05" :db/id #edb/ref 17592186367038} {:answer/id #uuid "cd838446-e1b8-57fd-8acd-4ca7e59a67df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.5" :db/id #edb/ref 17592186367039}] :answer-field/correct {:answer/id #uuid "2c7c60cd-5024-55ec-bf55-90bd345a929c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.25" :db/id #edb/ref 17592186367035} :answer-field/id #uuid "a4d04a46-0303-5f29-a8c8-dcf06401b445" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186367034}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ec979561-b575-51a4-9424-43f803a93ac7" :question/math-academy-id "q-109886" :question/problem "A random variable $X$ has the probability distribution given below.\n\n| $x$ | $0$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $0.05$ | $0.4$ | $0.1$ | $0.25$ | $0.2$ |\n\nCalculate $\\text{E}[{X}^{2}].$" :question/worked-solution "If $X$ is a discrete random variable with probability mass function $f(x)$ and sample space $S,$ the expected value of ${X}^{2}$ is given by\n\n$$\n\\text{E}[{X}^{2}]={\\sum }_{x\\in S}{x}^{2}\\cdot f(x).\n$$\n\nSumming up the products of each squared value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\sum }_{x\\in S}{x}^{2}\\cdot f(x) \\\\  & ={0}^{2}\\cdot 0.05+{1}^{2}\\cdot 0.4+{2}^{2}\\cdot 0.1+{3}^{2}\\cdot 0.25+{4}^{2}\\cdot 0.2 \\\\  & =0\\cdot 0.05+1\\cdot 0.4+4\\cdot 0.1+9\\cdot 0.25+16\\cdot 0.2 \\\\  & =6.25.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386494 :knowledge-point/_questions [{:db/id #edb/ref 17592186184137 :knowledge-point/id #uuid "7c9ceefc-3aa8-5c13-90a1-e4a084f720cc" :knowledge-point/title "Identifying the Graph of a Strict Inequality Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d272ed1-e481-5274-b5b3-9ee482390899" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1e/1e408923db2c7223715b9f82a2777a411e2c79b3614320975c237f2f503f2368.png" :db/id #edb/ref 17592186386496} {:answer/id #uuid "314c8fa8-fac6-5a5a-8685-cfb75d2ef5b2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/45/458a5dd519867a662237d7b52e44627d1867f25dcceeea446203a42571f91a00.png" :db/id #edb/ref 17592186386497} {:answer/id #uuid "54171b3e-5c85-5a7c-99c4-2b8f08fab4bb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/06/0668624761edfaf6f67a69d6059e7b0c54acd87042ec9f7400f1d4c2dfc5ff0b.png" :db/id #edb/ref 17592186386498} {:answer/id #uuid "888d0751-57e8-58b8-90b7-d9a53cbba2c3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/eb/ebf7fd57f5d07afebc22899418ce34d14e59dcdb2a01087950de675b7086f405.png" :db/id #edb/ref 17592186386499} {:answer/id #uuid "a3ceb939-864d-5395-af79-c1a55b359002" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a1/a16d99b349797e305083d8295ef098fbfbe3ea82970b5a48606ea5c678e08262.png" :db/id #edb/ref 17592186386500}] :answer-field/correct {:answer/id #uuid "a3ceb939-864d-5395-af79-c1a55b359002" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a1/a16d99b349797e305083d8295ef098fbfbe3ea82970b5a48606ea5c678e08262.png" :db/id #edb/ref 17592186386500} :answer-field/id #uuid "56cf31dd-5756-5666-b3b0-415b7baf39bd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386495}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3626480d-f8b9-54d9-af65-fe6ef10bb1f3" :question/math-academy-id "q-109942" :question/problem "Which of the following shaded areas describes the region bounded by the inequality $5x-10y<-20?$" :question/worked-solution "First, we convert the inequality into slope-intercept form:\n\n$$\n\\begin{aligned}5x-10y & <-20 \\\\ -10y & <-5x-20 \\\\ 10y & >5x+20 \\\\ y & >\\frac{1}{2}x+2\\end{aligned}\n$$\n\nNow, we proceed as usual. We start by drawing the corresponding straight line $y=\\frac{1}{2}x+2.$ Since the inequality involves a 'strictly greater than' sign, the line $y=\\frac{1}{2}x+2$ itself is *not* part of the solution. Therefore, we draw a dashed line.\n\nThen, we need to decide whether to shade above or below the line. The inequality $y>\\frac{1}{2}x+2$ refers to the $y$-values that are *greater than* those on the line $y=\\frac{1}{2}x+2,$ so we shade *above* the line.\n\n![](images/35/351bb4b4324432e2cc747e67dac22100da3c9e5318339832efa046f504394c35.png)"}] [{:db/id #edb/ref 17592186247067 :knowledge-point/_questions [{:db/id #edb/ref 17592186096818 :knowledge-point/id #uuid "c30dc350-d0c9-5a4d-87a0-4e2ebb1bb221" :knowledge-point/title "Calculating a Three-Term Partial Fraction Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "016d575c-9081-57b4-bc08-75eca4d55fd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{x+7}-\\frac{2}{(x+7)^{2}}+\\frac{2}{x-3}" :db/id #edb/ref 17592186244321} {:answer/id #uuid "1fb63833-17e5-50c3-9e6a-d4d5100a43f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{x+7}+\\frac{4}{(x+7)^{2}}+\\frac{2}{x-3}" :db/id #edb/ref 17592186244594} {:answer/id #uuid "6149c2b7-cb65-56f0-9ed7-b239ad10c444" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{x+7}+\\frac{4}{(x+7)^{2}}+\\frac{2}{x-3}" :db/id #edb/ref 17592186245162} {:answer/id #uuid "8da28e65-e1f3-5260-b060-5b17b3b2e13d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{x+7}-\\frac{2}{(x+7)^{2}}-\\frac{4}{x-3}" :db/id #edb/ref 17592186245553} {:answer/id #uuid "cfac0ef7-8b50-5c6d-a5bf-75a8af09617f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{x+7}+\\frac{4}{(x+7)^{2}}-\\frac{4}{x-3}" :db/id #edb/ref 17592186246167}] :answer-field/correct {:answer/id #uuid "6149c2b7-cb65-56f0-9ed7-b239ad10c444" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{x+7}+\\frac{4}{(x+7)^{2}}+\\frac{2}{x-3}" :db/id #edb/ref 17592186245162} :answer-field/id #uuid "4f9ef799-ff43-5ebd-af86-0243a466e65c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246686}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b9c7f12f-f5f3-522f-8863-2127e54d4ac8" :question/math-academy-id "q-10995" :question/problem "Express $\\frac{-{x}^{2}+20x+149}{(x+7)^{2}(x-3)}$ as a sum of partial     fractions." :question/worked-solution "Our task is to find $A,$ $B$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{-{x}^{2}+20x+149}{(x+7)^{2}(x-3)} & =\\frac{A}{x+7}+\\frac{B}{(x+7)^{2}}+\\frac{C}{x-3}.\\end{aligned}\n$$\n\nMultiplying both sides by $(x+7)^{2}(x-3)$ gives\n\n$$\n-{x}^{2}+20x+149=A(x+7)(x-3)+B(x-3)+C(x+7)^{2}.\n$$\n\nFor $x=-7$, we get \n\n$$\n\\begin{aligned}-(-7)^{2}+20(-7)+149 & =A(-7+7)(-7-3)+B(-7-3)+C(-7+7)^{2} \\\\ -49-140+149 & =B(-10) \\\\ B & =\\frac{-40}{-10} \\\\ B & =4.\\end{aligned}\n$$\n\nFor $x=3$, we get \n\n$$\n\\begin{aligned}-(3)^{2}+20(3)+149 & =A(3+7)(3-3)+B(3-3)+C(3+7)^{2} \\\\ -9+60+149 & =C{(10)}^{2} \\\\ C & =\\frac{200}{100} \\\\ C & =2.\\end{aligned}\n$$\n\nFor $x=0$, we get\n\n$$\n\\begin{aligned}-({0}^{2})+20(0)+149 & =A(0+7)(0-3)+B(0-3)+C(0+7)^{2} \\\\ 149 & =-21A-3B+49C \\\\ 149 & =-21A-3(4)+49(2) \\\\ 149 & =-21A+86 \\\\ 21A & =-63 \\\\ A & =-3.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\frac{-{x}^{2}+20x+149}{(x+7)^{2}(x-3)}=-\\frac{3}{x+7}+\\frac{4}{(x+7)^{2}}+\\frac{2}{x-3}.\n$$"}] [{:db/id #edb/ref 17592186382915 :knowledge-point/_questions [{:db/id #edb/ref 17592186175958 :knowledge-point/id #uuid "33fca834-0063-5252-832f-5efb4be6e599" :knowledge-point/title "Simplifying Expressions Using the Properties of Expected Value"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "559489de-91da-5602-8ae0-ffe8f892e620" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "220" :db/id #edb/ref 17592186382917} {:answer/id #uuid "d382e63a-841a-5a24-979c-17c23437dcc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "223" :db/id #edb/ref 17592186382918} {:answer/id #uuid "1af1adfd-7445-552d-a7b7-9caeee0d9343" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "210" :db/id #edb/ref 17592186382919} {:answer/id #uuid "dd2c5e47-bc4c-59c0-8129-cf16788fa2a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "212" :db/id #edb/ref 17592186382920} {:answer/id #uuid "dd06ccea-da94-5c4b-aa3c-965ccce11b7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "221" :db/id #edb/ref 17592186382921}] :answer-field/correct {:answer/id #uuid "dd06ccea-da94-5c4b-aa3c-965ccce11b7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "221" :db/id #edb/ref 17592186382921} :answer-field/id #uuid "01dfe550-1a8e-57ee-a7d3-d654e56a9e0c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382916}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "56770b15-4a0d-5167-b017-aef3a0af4cd0" :question/math-academy-id "q-110009" :question/problem "Compute $\\text{E}[(5Y-1)^{2}]$ if $\\text{E}[{Y}^{2}]=10$ and $\\text{E}[Y]=3.$" :question/worked-solution "Expanding out the square inside the expected value, using the properties of the expected value, and substituting in the given information, we get\n\n$$\n\\begin{aligned}\\text{E}[(5Y-1)^{2}] & =\\text{E}[25{Y}^{2}-10Y+1] \\\\  & =25\\text{E}[{Y}^{2}]-10\\text{E}[Y]+\\text{E}[1] \\\\  & =25\\text{E}[{Y}^{2}]-10\\text{E}[Y]+1 \\\\  & =25(10)-10(3)+1 \\\\  & =221.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186367061 :knowledge-point/_questions [{:db/id #edb/ref 17592186175958 :knowledge-point/id #uuid "33fca834-0063-5252-832f-5efb4be6e599" :knowledge-point/title "Simplifying Expressions Using the Properties of Expected Value"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "731bcb55-0ca1-5b0a-a179-b008b1fd9f62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186367063} {:answer/id #uuid "9e75ac44-18b0-5c6a-b46e-28e02a663c83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "46" :db/id #edb/ref 17592186367064} {:answer/id #uuid "87786e89-7293-55e5-a71c-952724c76ef4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186367065} {:answer/id #uuid "f3f4f66a-0854-52ec-b00d-f15c3faf1d00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186367066} {:answer/id #uuid "122cf90f-5bbe-5112-a195-784d781c642d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186367067}] :answer-field/correct {:answer/id #uuid "122cf90f-5bbe-5112-a195-784d781c642d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186367067} :answer-field/id #uuid "73f57246-158a-5d2f-9ec2-9042aba97d56" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186367062}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "26890fb4-88b9-5839-a1c9-c4e1304b8fae" :question/math-academy-id "q-110011" :question/problem "Compute $\\text{E}[(2Y-8)^{2}]$ if $\\text{E}[{Y}^{2}]=4$ and $\\text{E}[Y]=1.$" :question/worked-solution "Expanding out the square inside the expected value, using the properties of the expected value, and substituting in the given information, we get\n\n$$\n\\begin{aligned}\\text{E}[(2Y-8)^{2}] & =\\text{E}[4{Y}^{2}-32Y+64] \\\\  & =4\\text{E}[{Y}^{2}]-32\\text{E}[Y]+\\text{E}[64] \\\\  & =4\\text{E}[{Y}^{2}]-32\\text{E}[Y]+64 \\\\  & =4(4)-32(1)+64 \\\\  & =48.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247074 :knowledge-point/_questions [{:db/id #edb/ref 17592186064271 :knowledge-point/id #uuid "0fa5bdf9-4b27-5565-9ee1-ecb9f9db4791" :knowledge-point/title "Determining the Units of a Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a9d1daa-4262-5139-a82a-fa3e67db2278" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "squared hours" :db/id #edb/ref 17592186244405} {:answer/id #uuid "14b30c62-666a-59b5-8d86-70c3aaa84281" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "hours per minute" :db/id #edb/ref 17592186244504} {:answer/id #uuid "266712ff-2378-5f67-aec9-f0527b04aad3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "minutes" :db/id #edb/ref 17592186244654} {:answer/id #uuid "b676b7d4-a1ba-50cd-8d9e-e05b06adc11f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "hours" :db/id #edb/ref 17592186245944} {:answer/id #uuid "f0f28c2d-9b38-50b8-86c4-fef300c2b50e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "minutes per hour" :db/id #edb/ref 17592186246441}] :answer-field/correct {:answer/id #uuid "14b30c62-666a-59b5-8d86-70c3aaa84281" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "hours per minute" :db/id #edb/ref 17592186244504} :answer-field/id #uuid "05a9c882-cc73-506a-8893-344eaeecc41b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246562}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "986c7828-ebef-5b92-b3ca-04f414e27f95" :question/math-academy-id "q-110042" :question/problem "A battery lasts $L(t)$ hours when it is charged for $t$ minutes. What are the units of $\\frac{\\text{d}L}{\\text{d}t}?$" :question/worked-solution "We have that the battery duration $L(t)$ is measured in hours and the charging time is measured in minutes. \n\n$$\n\\begin{aligned}L(t): & \\text{hours} \\\\ t: & \\text{minutes}\\end{aligned}\n$$\n\nThe derivative $\\frac{\\text{d}L}{\\text{d}t}$ measures a change in $L(t)$ over a change in $t.$ So, it represents a ratio of the units:\n\n$$\n\\begin{aligned}\\frac{\\text{d}L}{\\text{d}t}: & \\frac{\\text{hours}}{\\text{minute}}\\end{aligned}\n$$\n\nIn other words, $\\frac{\\text{d}L}{\\text{d}t}$ is measured in \"hours per minute\"."}] [{:db/id #edb/ref 17592186247076 :knowledge-point/_questions [{:db/id #edb/ref 17592186119978 :knowledge-point/id #uuid "8c0b7d95-c699-5762-aa44-449712f035c7" :knowledge-point/title "Calculating the Derivative of the Inverse of a Polynomial Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22d5a040-390d-5203-8b75-acae075b4ef7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{48({h}^{-1}(x))^{5}+16({h}^{-1}(x))^{3}+9({h}^{-1}(x))^{2}}" :db/id #edb/ref 17592186244620} {:answer/id #uuid "606e6f5c-a0c2-5ab3-b6f4-ca7928c4cf0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{48({h}^{-1}(x))^{4}-16({h}^{-1}(x))^{3}+9({h}^{-1}(x))}" :db/id #edb/ref 17592186245156} {:answer/id #uuid "87f7c660-b074-5d37-94fa-798224cccd85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{48({h}^{-1}(x))^{5}+16({h}^{-1}(x))^{3}-3({h}^{-1}(x))^{2}}" :db/id #edb/ref 17592186245511} {:answer/id #uuid "8b212f51-2b53-522a-9e75-fc421f3a1d5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{24({h}^{-1}(x))^{5}+16({h}^{-1}(x))^{4}-8({h}^{-1}(x))^{2}}" :db/id #edb/ref 17592186245534} {:answer/id #uuid "8caeeaeb-5412-5ee4-b370-4b018fd33946" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8({h}^{-1}(x))^{5}+8({h}^{-1}(x))^{3}+9({h}^{-1}(x))^{2}}" :db/id #edb/ref 17592186245546}] :answer-field/correct {:answer/id #uuid "22d5a040-390d-5203-8b75-acae075b4ef7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{48({h}^{-1}(x))^{5}+16({h}^{-1}(x))^{3}+9({h}^{-1}(x))^{2}}" :db/id #edb/ref 17592186244620} :answer-field/id #uuid "c1a4b7dc-7531-523a-bb3b-ca16c0d54cab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246896}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9ec5b530-744d-5a5f-a929-bac31f33d7bf" :question/math-academy-id "q-110046" :question/problem "If $h(x)=8{x}^{6}+4{x}^{4}+3{x}^{3}-12,$ find ${({h}^{-1})}^{′}(x)$ as a function of ${h}^{-1}(x).$" :question/worked-solution "**Step 1:** First, we write the inverse function implicitly. The given function is $y=8{x}^{6}+4{x}^{4}+3{x}^{3}-12,$ and to write the inverse function implicitly, we swap $x$ and $y$ as follows:\n\n$$\nx=8{y}^{6}+4{y}^{4}+3{y}^{3}-12\n$$\n\nNote that in the equation above, we have $y={h}^{-1}(x).$\n\n**Step 2:** Next, we differentiate. The overall goal is to find $\\frac{\\text{d}y}{\\text{d}x},$ but the equation is already solved for $x,$ so we compute $\\frac{\\text{d}x}{\\text{d}y}$ and then take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(8{y}^{6}+4{y}^{4}+3{y}^{3}-12) \\\\ \\frac{\\text{d}x}{\\text{d}y} & =48{y}^{5}+16{y}^{3}+9{y}^{2} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{48{y}^{5}+16{y}^{3}+9{y}^{2}}\\end{aligned}\n$$\n\n**Step 3:** Lastly, we write the result in terms of ${h}^{-1}(x).$ Since $y={h}^{-1}(x),$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[{h}^{-1}(x)] & =\\frac{1}{48({h}^{-1}(x))^{5}+16({h}^{-1}(x))^{3}+9({h}^{-1}(x))^{2}} \\\\ {({h}^{-1})}^{′}(x) & =\\frac{1}{48({h}^{-1}(x))^{5}+16({h}^{-1}(x))^{3}+9({h}^{-1}(x))^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247081 :knowledge-point/_questions [{:db/id #edb/ref 17592186096684 :knowledge-point/id #uuid "d10c4317-f4b3-5846-8376-c7d382fc0ba3" :knowledge-point/title "Expressing Rational Functions as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07727d7f-2c55-5c5c-b6bf-023798916eda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4x+1}{({x}^{2}+11)}+\\frac{1}{(x-5)}" :db/id #edb/ref 17592186244373} {:answer/id #uuid "304ce17a-85e2-591d-89e0-8e6f154201c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x+5}{({x}^{2}+11)}-\\frac{7}{(x-5)}" :db/id #edb/ref 17592186244747} {:answer/id #uuid "72f881ba-150a-5750-bb32-d48934ef96fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+2}{({x}^{2}+11)}-\\frac{3}{(x-5)}" :db/id #edb/ref 17592186245342} {:answer/id #uuid "80f84e2b-243f-5712-a4cd-ff9a8411e827" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5x+3}{({x}^{2}+11)}-\\frac{4}{(x-5)}" :db/id #edb/ref 17592186245453} {:answer/id #uuid "c5c81f0c-ed8f-5c9b-af84-836ee910ecdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3x+2}{({x}^{2}+11)}+\\frac{2}{(x-5)}" :db/id #edb/ref 17592186246069}] :answer-field/correct {:answer/id #uuid "80f84e2b-243f-5712-a4cd-ff9a8411e827" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5x+3}{({x}^{2}+11)}-\\frac{4}{(x-5)}" :db/id #edb/ref 17592186245453} :answer-field/id #uuid "7426eb8b-dbe6-5c90-bab6-297b47683a95" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246748}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d0fd4da8-2774-540b-8642-c6079728ee7a" :question/math-academy-id "q-11007" :question/problem "Express $\\frac{{x}^{2}-22x-59}{({x}^{2}+11)(x-5)}$ as a sum of partial fractions." :question/worked-solution "Our task is to find $A,$ $B,$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{{x}^{2}-22x-59}{({x}^{2}+11)(x-5)} & =\\frac{Ax+B}{({x}^{2}+11)}+\\frac{C}{(x-5)}.\\end{aligned}\n$$\n\nNote that since ${x}^{2}+11$ is an irreducible quadratic factor, we must use a linear term $Ax+B$ in the numerator.\n\nWe multiply both sides by $({x}^{2}+11)(x-5)$ and get\n\n$$\n{x}^{2}-22x-59=(Ax+B)(x-5)+C({x}^{2}+11).\n$$\n\nPlugging in $x=5$ eliminates $A$ and $B$ and allows us to solve for $C.$ We get \n\n$$\n\\begin{aligned}{5}^{2}-22(5)-59 & =(A(5)+B)(5-5)+C({5}^{2}+11) \\\\ 25-110-59 & =36C \\\\ C & =-\\frac{144}{36} \\\\ C & =-4.\\end{aligned}\n$$\n\nPlugging in $x=0$ eliminates the $A$ term, and using our result for $C$ allows us to solve for $B.$ We get \n\n$$\n\\begin{aligned}(0)^{2}-22(0)-59 & =(A(0)+B)(0-5)+C({0}^{2}+11) \\\\ -59 & =-5B+11C \\\\ -59 & =-5B+11(-4) \\\\ 5B & =-44+59 \\\\ B & =\\frac{15}{5} \\\\ B & =3.\\end{aligned}\n$$\n\nFinally, to solve for $A,$ we choose $x=1$ and use our results for $B$ and $C.$ We get\n\n$$\n\\begin{aligned}(1)^{2}-22(1)-59 & =(A(1)+B)(1-5)+C({1}^{2}+11) \\\\ 1-22-59 & =-4A-4B+12C \\\\ -80 & =-4A-4(3)+12(-4) \\\\ 4A & =-12-48+80 \\\\ A & =\\frac{20}{4} \\\\ A & =5.\\end{aligned}\n$$\n\nSo we have $A=5,$ $B=3,$ and $C=-4.$ Therefore, our final result is\n\n$$\n\\frac{{x}^{2}-22x-59}{({x}^{2}+11)(x-5)}=\\frac{5x+3}{({x}^{2}+11)}-\\frac{4}{(x-5)}.\n$$"}] [{:db/id #edb/ref 17592186399685 :knowledge-point/_questions [{:db/id #edb/ref 17592186110653 :knowledge-point/id #uuid "42525832-e186-538f-baf8-bb4418e9820b" :knowledge-point/title "Working With Systems Containing Inequalities Presented in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84a02541-33c6-5f69-a920-35696f66c170" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x+2y\\le -8 \\\\ y\\ge \\frac{1}{2}x+1\\end{aligned}" :db/id #edb/ref 17592186399687} {:answer/id #uuid "5eb29637-b617-5711-9aa5-c2814f5eceb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x+2y>-8 \\\\ y>\\frac{1}{2}x+1\\end{aligned}" :db/id #edb/ref 17592186399688} {:answer/id #uuid "0642a65f-b668-5a8d-b6f2-b2575f8c1362" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x+2y\\ge -8 \\\\ y\\ge \\frac{1}{2}x+1\\end{aligned}" :db/id #edb/ref 17592186399689} {:answer/id #uuid "f8ff8a6d-ad42-5c71-989f-6bb5f699155a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x+2y\\le -8 \\\\ y\\le \\frac{1}{2}x+1\\end{aligned}" :db/id #edb/ref 17592186399690} {:answer/id #uuid "f8efb9aa-532e-55ae-9077-3bedc400e006" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x+2y\\ge -8 \\\\ y\\le \\frac{1}{2}x+1\\end{aligned}" :db/id #edb/ref 17592186399691}] :answer-field/correct {:answer/id #uuid "f8efb9aa-532e-55ae-9077-3bedc400e006" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x+2y\\ge -8 \\\\ y\\le \\frac{1}{2}x+1\\end{aligned}" :db/id #edb/ref 17592186399691} :answer-field/id #uuid "fce68956-d8ec-5373-80c1-0576c6b35476" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399686}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b9a72356-7e05-5f10-b6ac-a2418c3b4fa6" :question/math-academy-id "q-110078" :question/problem "![](images/39/3905dacc3977857933a48ced329fc245b357f732aec520e67998efc0b5d7cdab.png)\n\nWhich of the following systems of inequalities defines the shaded region shown above?" :question/worked-solution "Consider the line $x+2y=-8.$ Since the line is solid, the inequality is an \"or equal to\" inequality. Writing the equation of this line in slope-intercept form, we have\n\n$$\ny=-\\frac{1}{2}x-4.\n$$\n\nNow, since the shaded region lies *above* the line, the inequality is a \"greater than\" inequality. So the corresponding inequality is\n\n$$\ny\\ge -\\frac{1}{2}x-4,\n$$\n\n    \n\nwhich we can rewrite as\n\n$$\nx+2y\\ge -8.\n$$\n\nNow consider the line $y=\\frac{1}{2}x+1.$ Since the line is solid, the inequality is an \"or equal to\" inequality. Also, since the shaded region lies *below* the line, the inequality is a \"less than\" inequality. So the corresponding inequality is\n\n$$\ny\\le \\frac{1}{2}x+1.\n$$\n\nTherefore, the system of inequalities that defines the shaded region is\n\n$$\n{\\begin{aligned}x+2y\\ge -8 \\\\ y\\le \\frac{1}{2}x+1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186096950 :knowledge-point/_questions [{:db/id #edb/ref 17592186096684 :knowledge-point/id #uuid "d10c4317-f4b3-5846-8376-c7d382fc0ba3" :knowledge-point/title "Expressing Rational Functions as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40f3ff82-6f77-549d-a624-5debcc99a8d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3x+1}{({x}^{2}+2x+3)}+\\frac{2}{(x-1)}" :db/id #edb/ref 17592186244883} {:answer/id #uuid "6a5c70ee-90d2-5687-b3ef-c971b9f60b46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+3}{({x}^{2}+2x+3)}+\\frac{2}{(x-1)}" :db/id #edb/ref 17592186245256} {:answer/id #uuid "88b2fe13-efa4-5d72-a479-ed5d91e3729f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+2}{({x}^{2}+2x+3)}+\\frac{3}{(x-1)}" :db/id #edb/ref 17592186245512} {:answer/id #uuid "c5e65d48-58e0-5c74-85e0-8eaade6131a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+3}{({x}^{2}+2x+3)}-\\frac{2}{(x-1)}" :db/id #edb/ref 17592186246071} {:answer/id #uuid "cb9bc7f1-3946-5b24-a66f-3a730e714c0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x+1}{({x}^{2}+2x+3)}-\\frac{3}{(x-1)}" :db/id #edb/ref 17592186246126}] :answer-field/correct {:answer/id #uuid "40f3ff82-6f77-549d-a624-5debcc99a8d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3x+1}{({x}^{2}+2x+3)}+\\frac{2}{(x-1)}" :db/id #edb/ref 17592186244883} :answer-field/id #uuid "0e133db9-6266-5cab-9b3a-996ed74e5d30" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246575}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5ed7374e-1891-5f2a-9591-44dae68b363d" :question/math-academy-id "q-11014" :question/problem "Express $\\frac{5{x}^{2}+2x+5}{({x}^{2}+2x+3)(x-1)}$ as a sum of partial fractions." :question/requires-calculator true :question/worked-solution "Our task is to find $A,$ $B,$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{5{x}^{2}+2x+5}{({x}^{2}+2x+3)(x-1)} & =\\frac{Ax+B}{({x}^{2}+2x+3)}+\\frac{C}{(x-1)}.\\end{aligned}\n$$\n\nNote that since ${x}^{2}+2x+3$ is an irreducible quadratic factor, we must use a linear term $Ax+B$ in the numerator.\n\nWe multiply both sides by $({x}^{2}+2x+3)(x-1)$ and get\n\n$$\n5{x}^{2}+2x+5=(Ax+B)(x-1)+C({x}^{2}+2x+3).\n$$\n\nPlugging in $x=1$ eliminates the $A$ and $B$ terms and allows us to solve for $C.$ We get \n\n$$\n\\begin{aligned}5(1)^{2}+2(1)+5 & =(A(1)+B)(1-1)+C((1)^{2}+2(1)+3) \\\\ 5+2+5 & =6C \\\\ C & =\\frac{12}{6} \\\\ C & =2.\\end{aligned}\n$$\n\nPlugging in $x=0$ eliminates the $A$ term, and using our result for $C$ allows us to solve for $B.$ We get \n\n$$\n\\begin{aligned}5({0}^{2})+2(0)+5 & =(A(0)+B)(0-1)+C({0}^{2}+2(0)+3) \\\\ 5 & =-B+3C \\\\ 5 & =-B+3(2) \\\\ B & =6-5 \\\\ B & =1.\\end{aligned}\n$$\n\nFinally, to solve for $A,$ we choose $x=2$ and use our results for $B$ and $C.$ We get\n\n$$\n\\begin{aligned}5(2)^{2}+2(2)+5 & =(A(2)+B)(2-1)+C({2}^{2}+2(2)+3) \\\\ 29 & =2A+B+11C \\\\ 29 & =2A+(1)+11(2) \\\\ 2A & =29-23 \\\\ A & =\\frac{6}{2} \\\\ A & =3.\\end{aligned}\n$$\n\nSo we have $A=3,B=1,$ and $C=2.$ Therefore, our final result is\n\n$$\n\\frac{5{x}^{2}+2x+5}{({x}^{2}+2x+3)(x-1)}=\\frac{3x+1}{({x}^{2}+2x+3)}+\\frac{2}{(x-1)}.\n$$"}] [{:db/id #edb/ref 17592186247089 :knowledge-point/_questions [{:db/id #edb/ref 17592186110602 :knowledge-point/id #uuid "a6fee8d5-e1f7-599d-a74c-abc44d973065" :knowledge-point/title "Finding Equations of Perpendicular Horizontal and Vertical Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cad6201-010a-539b-a233-a3a596a28dc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1" :db/id #edb/ref 17592186244428} {:answer/id #uuid "2c55774a-a3f7-5f2a-9db4-822399b469f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2" :db/id #edb/ref 17592186244707} {:answer/id #uuid "5809a7c4-dbcc-51e9-a678-5bee1fdb700f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1" :db/id #edb/ref 17592186245092} {:answer/id #uuid "6ff5dd77-50b2-599d-bae1-c332e1f63976" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=4" :db/id #edb/ref 17592186245314} {:answer/id #uuid "ac2f7b12-1531-5623-b56b-f9c9386acf29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4" :db/id #edb/ref 17592186245854}] :answer-field/correct {:answer/id #uuid "ac2f7b12-1531-5623-b56b-f9c9386acf29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4" :db/id #edb/ref 17592186245854} :answer-field/id #uuid "e4b2b10b-4212-561e-9c28-87b5d79c2cdb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246954}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "08d4aa7d-7a62-5d6f-bf6f-63a5dddd841b" :question/math-academy-id "q-110140" :question/problem "Find the equation of the line that is perpendicular to $x=2$ and passes through the point $(1,4).$" :question/worked-solution "Since the line $x=2$ is a vertical line, a perpendicular line would need to be horizontal. So, the perpendicular line must take the form $y=k$ for some value of $k.$\n\nThe perpendicular line needs to go through the point $(1,4),$ which has a $y$-coordinate of $4.$ So, the perpendicular line is $y=4.$"}] [{:db/id #edb/ref 17592186176255 :knowledge-point/_questions [{:db/id #edb/ref 17592186175998 :knowledge-point/id #uuid "18abaef5-2dc8-5961-bd2a-e6cc52cce7bb" :knowledge-point/title "Calculating a Probability Involving a Squared Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a0c54b7-4603-5e43-9e4a-f59bd3524461" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.04" :db/id #edb/ref 17592186173789} {:answer/id #uuid "aebdd59d-12de-5843-b3a9-3420244afd7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.3" :db/id #edb/ref 17592186173790} {:answer/id #uuid "c7264fdf-a78e-5d7e-a6ed-0fb1a7682325" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.05" :db/id #edb/ref 17592186173791} {:answer/id #uuid "3a19e6a9-ea07-5d80-959c-127aea7c8be1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1" :db/id #edb/ref 17592186173792} {:answer/id #uuid "6c26b720-78d6-58d8-8b46-e57c7dee8282" :answer/type {:db/id #edb/ref 17592186045498 :db/id