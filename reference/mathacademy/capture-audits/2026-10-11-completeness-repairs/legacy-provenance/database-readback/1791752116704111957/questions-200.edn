#{[{:db/id #edb/ref 17592186244056 :knowledge-point/_questions [{:db/id #edb/ref 17592186092263 :knowledge-point/id #uuid "107eaf98-be8c-5fb1-ac4c-948b1e00df0a" :knowledge-point/title "Differentiating an Exponential Function with a Nonlinear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "100855dc-01a1-54eb-889b-5c5849671fed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}{e}^{{x}^{2}-2x}" :db/id #edb/ref 17592186241318} {:answer/id #uuid "412016b5-7fcf-5318-88ca-74a5337fd439" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{{x}^{2}-2x}" :db/id #edb/ref 17592186241764} {:answer/id #uuid "b3c2451f-e77c-598c-a29b-975bfafc93b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2x+2){e}^{{x}^{2}-2x}" :db/id #edb/ref 17592186242750} {:answer/id #uuid "e6242e2c-3c54-5534-b3c3-9e6ba73a9681" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2x-2){e}^{{x}^{2}-2x}" :db/id #edb/ref 17592186243224} {:answer/id #uuid "e95fa722-682a-5996-bbc5-42651cbf8584" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x{e}^{{x}^{2}-2x}" :db/id #edb/ref 17592186243242}] :answer-field/correct {:answer/id #uuid "e6242e2c-3c54-5534-b3c3-9e6ba73a9681" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2x-2){e}^{{x}^{2}-2x}" :db/id #edb/ref 17592186243224} :answer-field/id #uuid "666980b0-ea06-5cc6-8aba-d89d9e6e8dd9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243640}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "30a7e2e3-900c-5659-9ff0-e1c7283ea786" :question/math-academy-id "q-107445" :question/problem "Given that $y={e}^{{x}^{2}-2x},$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={e}^{u},\\,u={x}^{2}-2x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=2x-2.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (2x-2) \\\\  & =(2x-2){e}^{u} \\\\  & =(2x-2){e}^{{x}^{2}-2x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244058 :knowledge-point/_questions [{:db/id #edb/ref 17592186092263 :knowledge-point/id #uuid "107eaf98-be8c-5fb1-ac4c-948b1e00df0a" :knowledge-point/title "Differentiating an Exponential Function with a Nonlinear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f51954f-ef10-5b61-8e64-a3c5da15b5b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186241888} {:answer/id #uuid "561e1348-b169-5b7b-9445-b0635e9a11e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186241956} {:answer/id #uuid "662b5321-520e-54cd-9509-03f4e29b7113" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186242102} {:answer/id #uuid "d763b1fc-ea11-5f90-95d1-e07b6b76e1cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186243092} {:answer/id #uuid "ea081c7f-fadb-5983-817c-316ec3dc87d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186243251}] :answer-field/correct {:answer/id #uuid "ea081c7f-fadb-5983-817c-316ec3dc87d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186243251} :answer-field/id #uuid "4a8beb4d-3f02-544b-a522-4d1a06ffa730" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243581}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f0b47caa-0fc0-55c4-b8be-d17c35ea6d3b" :question/math-academy-id "q-107452" :question/problem "Find the slope of the tangent to the curve $y={e}^{{x}^{3}-4x}$ at the point where $x=2.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={e}^{u},\\,u={x}^{3}-4x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}-4.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (3{x}^{2}-4) \\\\  & =(3{x}^{2}-4){e}^{{x}^{3}-4x}.\\end{aligned}\n$$\n\nFinally, to find the slope of the tangent to the curve at $x=2$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=2} & ={(3{x}^{2}-4){e}^{{x}^{3}-4x}\\,|}_{x=2} \\\\  & =(3(2)^{2}-4){e}^{{2}^{3}-4(2)} \\\\  & =8\\cdot {e}^{0} \\\\  & =8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244060 :knowledge-point/_questions [{:db/id #edb/ref 17592186092261 :knowledge-point/id #uuid "2f4bfd24-dafd-57b3-940a-154a6e0acf3d" :knowledge-point/title "Differentiating a General Exponential Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "530546dd-8877-5ee4-a9a9-4e6037256c79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186241920} {:answer/id #uuid "600e2c77-5502-5a78-b78c-316c9d3b0309" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186242042} {:answer/id #uuid "a399353b-dcb8-5ce5-8226-adfa95834745" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186242614} {:answer/id #uuid "a3a4777f-04c7-56f8-9d79-a2692ed255c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186242615} {:answer/id #uuid "f5f46ff0-e8a9-5bfe-82dc-8df71e3e5cb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-24\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186243356}] :answer-field/correct {:answer/id #uuid "a3a4777f-04c7-56f8-9d79-a2692ed255c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186242615} :answer-field/id #uuid "cfbbf656-26a0-5730-8af0-76fb3508854c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243802}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a0d30f56-0d1c-5b77-92c9-4ebf415c4add" :question/math-academy-id "q-107461" :question/problem "If $f(x)={6}^{1-4x},$ find ${f}^{′}(x).$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf={6}^{u},\\,u=1-4x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={6}^{u}ln⁡6,\\,\\frac{\\text{d}u}{\\text{d}x}=-4.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={6}^{u}ln⁡6\\cdot (-4) \\\\  & =-4\\cdot {6}^{u}ln⁡6 \\\\  & =-4\\cdot {6}^{1-4x}ln⁡6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244061 :knowledge-point/_questions [{:db/id #edb/ref 17592186087720 :knowledge-point/id #uuid "4d1ea5c4-2700-5c03-a22e-de5439f47c36" :knowledge-point/title "Expressing a Quotient of Complex Numbers in Polar Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32fe7f10-2655-59bb-82ce-08ad3fdc8a05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\sqrt{2}(\\operatorname{cos}⁡(\\frac{3\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{3\\pi }{4}))" :db/id #edb/ref 17592186241630} {:answer/id #uuid "88a190b9-7d2b-5bcd-9378-d2b0286a8cba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{2}(\\operatorname{cos}⁡(\\frac{\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{4}))" :db/id #edb/ref 17592186242381} {:answer/id #uuid "99be3e20-4ed2-5652-9e1c-b2df33c244c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{2}(\\operatorname{cos}⁡(\\frac{3\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{3\\pi }{4}))" :db/id #edb/ref 17592186242522} {:answer/id #uuid "ab0a0151-cb92-5657-b7d0-81ffeb455502" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=4(\\operatorname{cos}⁡(\\frac{\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{4}))" :db/id #edb/ref 17592186242677} {:answer/id #uuid "f1256db1-73b6-5040-8e72-39c158686864" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\sqrt{2}(\\operatorname{cos}⁡(\\frac{\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{4}))" :db/id #edb/ref 17592186243320}] :answer-field/correct {:answer/id #uuid "f1256db1-73b6-5040-8e72-39c158686864" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\sqrt{2}(\\operatorname{cos}⁡(\\frac{\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{4}))" :db/id #edb/ref 17592186243320} :answer-field/id #uuid "9d26e50a-4924-502d-a4d6-d0b50c2e526a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243730}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a3fb5688-f4d7-5d45-9532-04de911faa48" :question/math-academy-id "q-107478" :question/problem "Express $z=\\frac{4}{1-\\text{i}}$ in the form $r(\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta ).$" :question/worked-solution "First, we express the given complex number in the form $z=x+y\\text{i}.$ To do this, we remove $\\text{i}$ from the denominator by multiplying the numerator and denominator of $z$ by the complex conjugate of the denominator, which is $1+\\text{i}:$\n\n$$\n\\begin{aligned}z & =\\frac{4}{1-\\text{i}} \\\\  & =\\frac{4(1+\\text{i})}{(1-\\text{i})(1+\\text{i})} \\\\  & =\\frac{4(1+\\text{i})}{{1}^{2}-{\\text{i}}^{2}} \\\\  & =\\frac{4(1+\\text{i})}{1+1} \\\\  & =2(1+\\text{i}) \\\\  & =2+2\\text{i}\\end{aligned}\n$$\n\n \n\nIn polar form, $r$ represents the magnitude $|z|.$ For a complex number $z=x+y\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{x}^{2}+{y}^{2}}.\n$$\n\nSo, for $z=2+2\\text{i},$ the magnitude is \n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{2}^{2}+{2}^{2}} \\\\  & =2\\sqrt{2}.\\end{aligned}\n$$\n\n    \n\nIn polar form, $\\theta $  represents the argument $\\operatorname{arg}⁡(z).$ Since $x=2$ and $y=2$ are both positive, $z$ lies in the first quadrant. So, we can find $\\theta $ as follows:\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =\\operatorname{arctan}⁡(\\frac{y}{x}) \\\\  & =\\operatorname{arctan}⁡(\\frac{2}{2}) \\\\  & =\\operatorname{arctan}⁡1 \\\\  & =\\frac{\\pi }{4}\\end{aligned}\n$$\n\nFinally, we write the complex number $z$ in polar form:\n\n$$\nz=2\\sqrt{2}(\\operatorname{cos}⁡(\\frac{\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{4}))\n$$"}] [{:db/id #edb/ref 17592186244062 :knowledge-point/_questions [{:db/id #edb/ref 17592186171913 :knowledge-point/id #uuid "7da9cbe0-e57b-5289-be33-c21af3f68ee7" :knowledge-point/title "Finding Primary Roots of Unity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18bf6ee4-13cb-5e29-aa00-72802f147b3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{\\pi \\text{i}/22}" :db/id #edb/ref 17592186241396} {:answer/id #uuid "2b7c8ad0-2732-50f1-9354-cd1cb2cf58a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{3\\pi \\text{i}/22}" :db/id #edb/ref 17592186241565} {:answer/id #uuid "4f5e3872-0c2d-5000-9375-cf6192a10587" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2\\pi \\text{i}/11}" :db/id #edb/ref 17592186241890} {:answer/id #uuid "a46896c1-0d7c-56eb-b85f-c14eec446f8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{3\\pi \\text{i}/11}" :db/id #edb/ref 17592186242624} {:answer/id #uuid "a6980e6c-5cbd-5b95-bcfb-2ebbd81d5080" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{\\pi \\text{i}/11}" :db/id #edb/ref 17592186242648}] :answer-field/correct {:answer/id #uuid "a6980e6c-5cbd-5b95-bcfb-2ebbd81d5080" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{\\pi \\text{i}/11}" :db/id #edb/ref 17592186242648} :answer-field/id #uuid "91424deb-1037-5137-b17e-259f9cd3cf8a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243710}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8ea7f0d9-052f-5889-bddf-db77ecf1910d" :question/math-academy-id "q-107494" :question/problem "Find the principal $22$th root of unity." :question/worked-solution "Let $z$ be a $22$th root of unity. This means that \n\n$$\n{z}^{22}=1.\n$$\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{22}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/22}={e}^{k\\pi \\text{i}/11}.\\end{aligned}\n$$\n\nThe principal root corresponds to $k=1,$ and is therefore equal to ${e}^{\\pi \\text{i}/11}.$"}] [{:db/id #edb/ref 17592186244065 :knowledge-point/_questions [{:db/id #edb/ref 17592186087720 :knowledge-point/id #uuid "4d1ea5c4-2700-5c03-a22e-de5439f47c36" :knowledge-point/title "Expressing a Quotient of Complex Numbers in Polar Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04f9de1f-4f25-5b06-9fe7-00d80cb7f25e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2(\\operatorname{cos}⁡(\\frac{\\pi }{6})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{6}))" :db/id #edb/ref 17592186241220} {:answer/id #uuid "55a97a63-06b0-52a4-8dc3-397e3cdd5675" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\operatorname{cos}⁡(\\frac{\\pi }{6})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{6})" :db/id #edb/ref 17592186241950} {:answer/id #uuid "8664ea7d-0c52-5b8c-8536-00cd1890171a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\operatorname{cos}⁡(\\frac{\\pi }{3})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{3})" :db/id #edb/ref 17592186242357} {:answer/id #uuid "a18e07c2-0be9-58ca-a916-ebd1e6f4c4a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2(\\operatorname{cos}⁡(\\frac{\\pi }{3})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{3}))" :db/id #edb/ref 17592186242594} {:answer/id #uuid "c1da9973-1d45-5b2a-9d0e-4d2db6f0629a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{2}(\\operatorname{cos}⁡(\\frac{\\pi }{6})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{6}))" :db/id #edb/ref 17592186242880}] :answer-field/correct {:answer/id #uuid "55a97a63-06b0-52a4-8dc3-397e3cdd5675" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\operatorname{cos}⁡(\\frac{\\pi }{6})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{6})" :db/id #edb/ref 17592186241950} :answer-field/id #uuid "d14dc245-a2a8-5495-902f-1ed1045d160d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243806}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2e9181ee-25b9-5957-9828-d0262363192c" :question/math-academy-id "q-107509" :question/problem "Express $z=\\frac{1+\\sqrt{3}\\,\\text{i}}{\\sqrt{3}+\\text{i}}$ in the form $r(\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta ).$" :question/worked-solution "First, we express the given complex number in the form $z=x+y\\text{i}.$ To do this, we remove $\\text{i}$ from the denominator by multiplying the numerator and denominator of $z$ by the complex conjugate of the denominator, which is $\\sqrt{3}-\\text{i}:$ \n\n$$\n\\begin{aligned}z & =\\frac{1+\\sqrt{3}\\,\\text{i}}{\\sqrt{3}+\\text{i}} \\\\  & =\\frac{(1+\\sqrt{3}\\,\\text{i})(\\sqrt{3}-\\text{i})}{(\\sqrt{3}+\\text{i})(\\sqrt{3}-\\text{i})} \\\\  & =\\frac{2\\sqrt{3}+2\\text{i}}{(\\sqrt{3})^{2}-{\\text{i}}^{2}} \\\\  & =\\frac{2(\\sqrt{3}+\\text{i})}{3+1} \\\\  & =\\frac{\\sqrt{3}+\\text{i}}{2} \\\\  & =\\frac{\\sqrt{3}}{2}+\\frac{\\text{i}}{2}\\end{aligned}\n$$\n\nIn polar form, $r$ represents the magnitude $|z|.$ For a complex number $z=x+y\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{x}^{2}+{y}^{2}}.\n$$\n\nSo, for $z=\\frac{\\sqrt{3}}{2}+\\frac{\\text{i}}{2},$ the magnitude is\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{(\\frac{\\sqrt{3}}{2})}^{2}+{(\\frac{1}{2})}^{2}} \\\\  & =\\sqrt{\\frac{3}{4}+\\frac{1}{4}} \\\\  & =1.\\end{aligned}\n$$\n\n    \n\nIn polar form, $\\theta $  represents the argument $\\operatorname{arg}⁡(z).$ Since $x=\\frac{\\sqrt{3}}{2}$ and $y=\\frac{1}{2}$ are both positive, $z$ lies in the first quadrant. So, we can find $\\theta $ as follows: \n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =\\operatorname{arctan}⁡(\\frac{y}{x}) \\\\  & =\\operatorname{arctan}⁡(\\frac{(\\frac{1}{2})}{(\\frac{\\sqrt{3}}{2})}) \\\\  & =\\operatorname{arctan}⁡(\\frac{1}{\\sqrt{3}}) \\\\  & =\\frac{\\pi }{6}\\end{aligned}\n$$\n\nFinally, we write the complex number $z$ in polar form:\n\n$$\nz=\\operatorname{cos}⁡(\\frac{\\pi }{6})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{6})\n$$"}] [{:db/id #edb/ref 17592186092504 :knowledge-point/_questions [{:db/id #edb/ref 17592186092383 :knowledge-point/id #uuid "84c8ba29-95c9-5494-be0b-9b67bee6e45c" :knowledge-point/title "Determining where a Tangent Line Intersects an Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d43d514-056c-5460-a3af-d849e852963f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{26}{15},0)" :db/id #edb/ref 17592186241726} {:answer/id #uuid "62bc42d2-5179-562d-98c4-3bdc3ecbb73c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{15}{26},0)" :db/id #edb/ref 17592186242064} {:answer/id #uuid "6989371f-d3e2-5899-88b0-040b8420dc5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{6}{5},0)" :db/id #edb/ref 17592186242127} {:answer/id #uuid "bb13d610-b21e-5707-86ce-445aaa0a4fb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-52,0)" :db/id #edb/ref 17592186242821} {:answer/id #uuid "d8ae9e16-54c5-576c-9c1a-d34f12e925fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{13}{14},0)" :db/id #edb/ref 17592186243107}] :answer-field/correct {:answer/id #uuid "3d43d514-056c-5460-a3af-d849e852963f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{26}{15},0)" :db/id #edb/ref 17592186241726} :answer-field/id #uuid "dd47966b-6ae5-5788-91db-22f167d38ce2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243823}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9bc53eba-4d4e-5f8c-8a22-7a4a98405447" :question/math-academy-id "q-10752" :question/problem "Find where the tangent to the curve $y=5{x}^{2}-7$ at the point $(3,38)$ intersects the $x$-axis." :question/worked-solution "Let $f(x)=5{x}^{2}-7.$ Let's first calculate the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(5{x}^{2}-7)=10x\\end{aligned}\n$$\n\nSo, the slope of the tangent at our point is\n\n$$\n\\begin{aligned}m={f}^{′}(3)=10(3)=30.\\end{aligned}\n$$\n\nTherefore, the equation of the tangent is\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(38) & =30(x-3) \\\\ y & =30x-90+38 \\\\ y & =30x-52.\\end{aligned}\n$$\n\nTo find where the tangent line intercepts the $x$-axis, we set $y=0$ and solve:\n\n$$\n\\begin{aligned}0 & =30x-52 \\\\ x & =\\frac{26}{15}\\end{aligned}\n$$\n\nTherefore, the point of intersection is $(\\frac{26}{15},0).$"}] [{:db/id #edb/ref 17592186244067 :knowledge-point/_questions [{:db/id #edb/ref 17592186083239 :knowledge-point/id #uuid "1ee21c78-209f-564b-a005-86f58699a3be" :knowledge-point/title "Factoring a Quadratic Polynomial With Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1aa1f7b8-69bb-5f92-911a-dfb947dda4d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u-(1-2\\text{i})" :db/id #edb/ref 17592186241408} {:answer/id #uuid "37dd6105-495e-5bc8-8f54-17c0607d9d86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u-(3+2\\text{i})" :db/id #edb/ref 17592186241677} {:answer/id #uuid "47519c28-b9c9-50e2-b491-06a371b5156c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u-(1+4\\text{i})" :db/id #edb/ref 17592186241824} {:answer/id #uuid "8eb02fe6-113c-5c7d-8f1f-8c0f62782555" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u-(-1-2\\text{i})" :db/id #edb/ref 17592186242434} {:answer/id #uuid "ca92570a-2cd1-5069-94df-4f6b752e31c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u-(2+\\text{i})" :db/id #edb/ref 17592186242965}] :answer-field/correct {:answer/id #uuid "1aa1f7b8-69bb-5f92-911a-dfb947dda4d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u-(1-2\\text{i})" :db/id #edb/ref 17592186241408} :answer-field/id #uuid "dcf6565b-a7a3-593b-b552-d4db9de85e31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243822}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3d969355-1e15-5d5c-8178-ddac8fee50cd" :question/math-academy-id "q-107523" :question/problem "Which of the following is a factor of ${u}^{2}-2u+5?$" :question/worked-solution "First, we let $f(u)={u}^{2}-2u+5.$\n\nNext, we solve $f(u)=0$ by completing the square, as follows:\n\n$$\n\\begin{aligned}f(u) & =0 \\\\ {u}^{2}-2u+5 & =0 \\\\ ({u}^{2}-2\\cdot u+{1}^{2})-{1}^{2}+5 & =0 \\\\ (u-1)^{2}+4 & =0 \\\\ (u-1)^{2} & =-4 \\\\ (u-1)^{2} & =4{\\text{i}}^{2} \\\\ (u-1)^{2} & =(2\\text{i})^{2} \\\\ u-1 & =\\pm 2\\text{i} \\\\ u & =1\\pm 2\\text{i}\\end{aligned}\n$$\n\nSince our quadratic equation has roots ${u}_{1}=1+2\\text{i}$ and ${u}_{2}=1-2\\text{i},$ and the coefficient of the quadratic term is $a=1,$ the expression ${u}^{2}-2u+5$ can be written as\n\n$$\n\\begin{aligned}{u}^{2}-2u+5 & =a(u-{u}_{1})(u-{u}_{2}) \\\\  & =(u-(1+2\\text{i}))(u-(1-2\\text{i})).\\end{aligned}\n$$\n\nTherefore, among the given options, only $u-(1-2\\text{i})$ is a factor of ${u}^{2}-2u+5.$"}] [{:db/id #edb/ref 17592186244071 :knowledge-point/_questions [{:db/id #edb/ref 17592186087813 :knowledge-point/id #uuid "517f2054-008e-54eb-89dd-5f0a09e1f881" :knowledge-point/title "Finding a Cubic Polynomial Given Three Real Roots and a Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d8f15ce-980c-5786-87e2-db801547f886" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}-{x}^{2}-32x-40" :db/id #edb/ref 17592186241431} {:answer/id #uuid "3a201c6e-0650-5612-9eca-579ff4d1f2e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}-2{x}^{2}-32x-40" :db/id #edb/ref 17592186241698} {:answer/id #uuid "b71e0ec4-9c2b-5f4c-bd1b-c9460ea1e68e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}-2{x}^{2}-16x-35" :db/id #edb/ref 17592186242783} {:answer/id #uuid "ba362533-32c2-5437-91f1-46adfc35ffc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}-{x}^{2}-16x-20" :db/id #edb/ref 17592186242812} {:answer/id #uuid "cd94af0b-75e7-529c-958b-c661f153bc88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}^{3}+2{x}^{2}+32x-20" :db/id #edb/ref 17592186242989}] :answer-field/correct {:answer/id #uuid "3a201c6e-0650-5612-9eca-579ff4d1f2e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}-2{x}^{2}-32x-40" :db/id #edb/ref 17592186241698} :answer-field/id #uuid "8668f950-2b23-5b8f-924d-1d0caf181aaf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243693}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "131faea4-07a6-56a1-b953-1246fa04fdd6" :question/math-academy-id "q-107538" :question/problem "The cubic polynomial $P(x)$ has roots ${x}_{1}={x}_{2}=-2,{x}_{3}=5,$ and the coefficient of the cubic term is $2.$ Find $P(x).$" :question/worked-solution "Since our cubic polynomial has roots ${x}_{1}={x}_{2}=-2$ and ${x}_{3}=5,$ and the coefficient of the cubic term is $a=2,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) & =2(x-(-2))(x-(-2))(x-5) \\\\  & =2(x+2)(x+2)(x-5)\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}2(x+2)(x+2)(x-5) & =2({x}^{2}+4x+4)(x-5) \\\\  & =2({x}^{3}+4{x}^{2}-5{x}^{2}+4x-20x-20) \\\\  & =2({x}^{3}-{x}^{2}-16x-20) \\\\  & =2{x}^{3}-2{x}^{2}-32x-40.\\end{aligned}\n$$\n\nTherefore, $P(x)=2{x}^{3}-2{x}^{2}-32x-40.$"}] [{:db/id #edb/ref 17592186244073 :knowledge-point/_questions [{:db/id #edb/ref 17592186087813 :knowledge-point/id #uuid "517f2054-008e-54eb-89dd-5f0a09e1f881" :knowledge-point/title "Finding a Cubic Polynomial Given Three Real Roots and a Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "017685bd-cc42-5e91-b6f9-7139f1ca45a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}-4{x}^{2}-30x" :db/id #edb/ref 17592186241199} {:answer/id #uuid "164a4c8b-7300-5e8d-87cb-bd18cd95b083" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}+8{x}^{2}+60x" :db/id #edb/ref 17592186241371} {:answer/id #uuid "378cc4ba-e822-53c1-a956-f59db104e64c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}-4x-15" :db/id #edb/ref 17592186241670} {:answer/id #uuid "72f9c508-c6db-58c5-bb2e-6d95c1e546b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}-2{x}^{2}-30" :db/id #edb/ref 17592186242200} {:answer/id #uuid "e38adfb7-ad96-53f8-82d2-3ba154311b00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}+4{x}^{2}+15x" :db/id #edb/ref 17592186243208}] :answer-field/correct {:answer/id #uuid "017685bd-cc42-5e91-b6f9-7139f1ca45a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}-4{x}^{2}-30x" :db/id #edb/ref 17592186241199} :answer-field/id #uuid "e510555a-7bca-5d00-b10d-361fdddaa9f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243834}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cb676cef-b96e-5e0e-9b97-6d918ab0faa9" :question/math-academy-id "q-107540" :question/problem "The cubic polynomial $P(x)$ has roots ${x}_{1}=-3,$ ${x}_{2}=0,$ and ${x}_{3}=5,$ and the coefficient of the cubic term is $2.$ Find $P(x).$" :question/worked-solution "Since our cubic equation has roots ${x}_{1}=-3,$ ${x}_{2}=0,$ and ${x}_{3}=5,$ and the coefficient of the cubic term is $a=2,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) & =2(x-(-3))(x-0)(x-5) \\\\  & =2x(x+3)(x-5)\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}2x(x+3)(x-5) & =2x({x}^{2}-2x-15) \\\\  & =2({x}^{3}-2{x}^{2}-15x) \\\\  & =2{x}^{3}-4{x}^{2}-30x.\\end{aligned}\n$$\n\nTherefore, $P(x)=2{x}^{3}-4{x}^{2}-30x.$"}] [{:db/id #edb/ref 17592186386250 :knowledge-point/_questions [{:db/id #edb/ref 17592186087719 :knowledge-point/id #uuid "31e4455a-9f8f-5c12-8c96-bb6735691591" :knowledge-point/title "Converting From Polar Form to Cartesian Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "769304c9-536f-5bee-ad3f-bfee22337ef1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=-\\sqrt{2}+\\sqrt{2}\\,\\text{i}" :db/id #edb/ref 17592186386252} {:answer/id #uuid "9d261cb9-dabf-53f3-b9e1-0752b9983369" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=-1+\\text{i}" :db/id #edb/ref 17592186386253} {:answer/id #uuid "1ab818a5-54de-587e-b8d4-5ad252d7561d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=1+\\text{i}" :db/id #edb/ref 17592186386254} {:answer/id #uuid "713083e0-6e29-5103-b88f-240c9a29bb2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=-1-\\sqrt{2}\\,\\text{i}" :db/id #edb/ref 17592186386255} {:answer/id #uuid "80290119-b3e9-5290-a6fd-17312d831faa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=1-\\text{i}" :db/id #edb/ref 17592186386256}] :answer-field/correct {:answer/id #uuid "9d261cb9-dabf-53f3-b9e1-0752b9983369" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=-1+\\text{i}" :db/id #edb/ref 17592186386253} :answer-field/id #uuid "95ae8fbb-49b5-5680-9cdb-3e54b97c6d37" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386251}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "02d6fd52-a861-5d95-bf24-0c758b7ad072" :question/math-academy-id "q-107551" :question/problem "Express $z=\\sqrt{2}(\\operatorname{cos}⁡(\\frac{3\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{3\\pi }{4}))$ in the form $z=x+\\text{i}y.$" :question/worked-solution "To express the number in Cartesian form, we expand the parentheses and substitute the values of the cosine and sine.\n\nFirst, we find $\\operatorname{cos}⁡(\\frac{3\\pi }{4})$ and $\\operatorname{sin}⁡(\\frac{3\\pi }{4}):$\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\frac{3\\pi }{4}) & =-\\operatorname{cos}⁡(\\frac{\\pi }{4}) \\\\  & =-\\frac{\\sqrt{2}}{2}\\,,\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\frac{3\\pi }{4}) & =\\operatorname{sin}⁡(\\frac{\\pi }{4}) \\\\  & =\\frac{\\sqrt{2}}{2}\\,.\\end{aligned}\n$$\n\nNow, we substitute the values and expand the parentheses:\n\n$$\n\\begin{aligned}z & =\\sqrt{2}(\\operatorname{cos}⁡(\\frac{3\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{3\\pi }{4})) \\\\  & =\\sqrt{2}(-\\frac{\\sqrt{2}}{2}+\\text{i}\\frac{\\sqrt{2}}{2}) \\\\  & =-1+\\text{i}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244085 :knowledge-point/_questions [{:db/id #edb/ref 17592186087719 :knowledge-point/id #uuid "31e4455a-9f8f-5c12-8c96-bb6735691591" :knowledge-point/title "Converting From Polar Form to Cartesian Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "161529f2-330e-5067-a4a2-2c598f4e23cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\text{i}" :db/id #edb/ref 17592186241370} {:answer/id #uuid "1b901e84-2519-5cca-b073-7b6c62e3635b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\text{i}" :db/id #edb/ref 17592186241417} {:answer/id #uuid "2cb57ed9-def7-56b0-a186-f45699c1da79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186241578} {:answer/id #uuid "5806f7a9-da41-59ff-8ae9-a8eb44809d76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\text{i}" :db/id #edb/ref 17592186241977} {:answer/id #uuid "6925961a-23a0-592b-85f0-a2355690ee78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2+\\text{i}" :db/id #edb/ref 17592186242125}] :answer-field/correct {:answer/id #uuid "2cb57ed9-def7-56b0-a186-f45699c1da79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186241578} :answer-field/id #uuid "60d90934-60c0-50e8-a41d-f6ab25c17a62" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243626}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "25fdd1e0-dadc-5981-8079-26e2d85c4830" :question/math-academy-id "q-107567" :question/problem "Express $z=2(\\operatorname{cos}⁡(\\pi )+\\text{i}\\operatorname{sin}⁡(\\pi ))$ in the form $z=x+\\text{i}y.$" :question/worked-solution "To express the number in Cartesian form, we expand the parentheses and substitute the values of the cosine and sine.\n\nSince $\\operatorname{cos}⁡(\\pi )=-1$ and $\\operatorname{sin}⁡(\\pi )=0,$ we have\n\n$$\n\\begin{aligned}z & =2(\\operatorname{cos}⁡(\\pi )+\\text{i}\\operatorname{sin}⁡(\\pi )) \\\\  & =2(-1+\\text{i}\\cdot 0) \\\\  & =-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244087 :knowledge-point/_questions [{:db/id #edb/ref 17592186096608 :knowledge-point/id #uuid "65b4e8e7-e558-50e7-a1ec-37a6eff77e87" :knowledge-point/title "Finding the Amplitude-Phase Form for Sine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fdcb2bf-8345-5e1b-882c-bf6e4b7d33af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{5}\\operatorname{sin}⁡(x-{45}^{∘})" :db/id #edb/ref 17592186241316} {:answer/id #uuid "18b631c1-613b-593f-b662-0a358baf67b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}\\operatorname{sin}⁡(x-{60}^{∘})" :db/id #edb/ref 17592186241395} {:answer/id #uuid "25bb4c0b-c018-5544-b1e8-e12b2244067e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}\\operatorname{sin}⁡(x-{45}^{∘})" :db/id #edb/ref 17592186241504} {:answer/id #uuid "c9bc19ce-1933-5942-9c00-cd53cf354ffd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}\\operatorname{sin}⁡(x-{30}^{∘})" :db/id #edb/ref 17592186242958} {:answer/id #uuid "ee2dba2c-bb4d-57ec-8b76-7eedaf1d151b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{5}\\operatorname{sin}⁡(x-{30}^{∘})" :db/id #edb/ref 17592186243291}] :answer-field/correct {:answer/id #uuid "25bb4c0b-c018-5544-b1e8-e12b2244067e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}\\operatorname{sin}⁡(x-{45}^{∘})" :db/id #edb/ref 17592186241504} :answer-field/id #uuid "88598f20-c925-534c-af55-d6bf9e3c545c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243696}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e33547cc-9eda-5fa2-ada1-bbe7653d7d33" :question/math-academy-id "q-107570" :question/problem "$\\sqrt{5}\\operatorname{sin}⁡x-\\sqrt{5}\\operatorname{cos}⁡x=$" :question/worked-solution "The difference formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(x-ϕ) & =R(\\operatorname{sin}⁡x\\operatorname{cos}⁡ϕ-\\operatorname{cos}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡x-R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n\\sqrt{5}\\operatorname{sin}⁡x-\\sqrt{5}\\operatorname{cos}⁡x=R\\operatorname{sin}⁡(x-ϕ),\n$$\n\nwe get the following identity:\n\n$$\n\\sqrt{5}\\operatorname{sin}⁡x-\\sqrt{5}\\operatorname{cos}⁡x=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡x-(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡x\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n{\\begin{aligned}R\\operatorname{cos}⁡ϕ=\\sqrt{5} \\\\ R\\operatorname{sin}⁡ϕ=\\sqrt{5}\\end{aligned}\n$$\n\nDividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{R\\operatorname{sin}⁡ϕ}{R\\operatorname{cos}⁡ϕ} & =\\frac{\\sqrt{5}}{\\sqrt{5}} \\\\ \\operatorname{tan}⁡ϕ & =1 \\\\ ϕ & =\\operatorname{arctan}⁡1 \\\\  & ={45}^{∘}.\\end{aligned}\n$$\n\nNow, we find the amplitude $R.$ Squaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{(R\\operatorname{cos}⁡ϕ)}^{2}+{(R\\operatorname{sin}⁡ϕ)}^{2} & =(\\sqrt{5})^{2}+(\\sqrt{5})^{2} \\\\ {R}^{2}({cos}^{2}⁡ϕ+{sin}^{2}⁡ϕ) & =5+5 \\\\ {R}^{2} & =10 \\\\ R & =\\sqrt{10}.\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$\n\nFinally, we can write the initial expression in amplitude-phase form as follows:\n\n$$\n\\sqrt{5}\\operatorname{sin}⁡x-\\sqrt{5}\\operatorname{cos}⁡x=\\sqrt{10}\\operatorname{sin}⁡(x-{45}^{∘})\n$$"}] [{:db/id #edb/ref 17592186244089 :knowledge-point/_questions [{:db/id #edb/ref 17592186096608 :knowledge-point/id #uuid "65b4e8e7-e558-50e7-a1ec-37a6eff77e87" :knowledge-point/title "Finding the Amplitude-Phase Form for Sine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cdc0764-c704-5f4c-8900-21357c4cc0a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{sin}⁡(x+0.730)" :db/id #edb/ref 17592186241721} {:answer/id #uuid "4b4c9039-c2fb-5ec2-94bc-d45cd5379b7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{5}\\operatorname{sin}⁡(x+0.841)" :db/id #edb/ref 17592186241858} {:answer/id #uuid "786d7e6b-a9ac-5d0e-ae28-08ad63146c2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{7}\\operatorname{sin}⁡(x+0.741)" :db/id #edb/ref 17592186242240} {:answer/id #uuid "870281f1-0101-507d-854d-e412a542cbbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{sin}⁡(x+0.841)" :db/id #edb/ref 17592186242361} {:answer/id #uuid "bbc5f724-7da5-5411-9f8c-9ba0486c21de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{5}\\operatorname{sin}⁡(x+0.730)" :db/id #edb/ref 17592186242824}] :answer-field/correct {:answer/id #uuid "3cdc0764-c704-5f4c-8900-21357c4cc0a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{sin}⁡(x+0.730)" :db/id #edb/ref 17592186241721} :answer-field/id #uuid "9923f324-3fc1-5d64-bb7b-b26016552565" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243724}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e19c29ed-ca08-5b08-881a-c2cea1937130" :question/math-academy-id "q-107574" :question/problem "$\\sqrt{5}\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x≈$" :question/worked-solution "The sum formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(x+ϕ) & =R(\\operatorname{sin}⁡x\\operatorname{cos}⁡ϕ+\\operatorname{cos}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡x+R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n\\sqrt{5}\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x=R\\operatorname{sin}⁡(x+ϕ),\n$$\n\nwe get the following identity:\n\n$$\n\\sqrt{5}\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡x+(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡x\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n{\\begin{aligned}R\\operatorname{cos}⁡ϕ=\\sqrt{5} \\\\ R\\operatorname{sin}⁡ϕ=2\\end{aligned}\n$$\n\nDividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{R\\operatorname{sin}⁡ϕ}{R\\operatorname{cos}⁡ϕ} & =\\frac{2}{\\sqrt{5}} \\\\ \\operatorname{tan}⁡ϕ & =\\frac{2\\sqrt{5}}{5} \\\\ ϕ & =\\operatorname{arctan}⁡(\\frac{2\\sqrt{5}}{5}) \\\\ ϕ & ≈0.730\\,\\text{rad}\\end{aligned}\n$$\n\nrounded to three decimal places.\n\nNow, we find the amplitude $R.$ Squaring the first and the second equations of the system and adding the results together, we get: \n\n$$\n\\begin{aligned}{R}^{2}{cos}^{2}⁡ϕ+{R}^{2}{sin}^{2}⁡ϕ & =(\\sqrt{5})^{2}+{2}^{2} \\\\ {R}^{2}({cos}^{2}⁡ϕ+{sin}^{2}⁡ϕ) & =5+4 \\\\ {R}^{2} & =9 \\\\ R & =3\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$\n\nFinally, we can write the initial expression in amplitude-phase form as follows:\n\n$$\n\\sqrt{5}\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x≈3\\operatorname{sin}⁡(x+0.730)\n$$"}] [{:db/id #edb/ref 17592186244092 :knowledge-point/_questions [{:db/id #edb/ref 17592186096609 :knowledge-point/id #uuid "f12d8028-2520-5706-ba49-d67935036af6" :knowledge-point/title "Finding the Amplitude-Phase Form for Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13ef2485-088a-59e5-a9d3-d6d81ac05af0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186241351} {:answer/id #uuid "4579478f-975c-5a82-9cbc-e216916864ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186241804} {:answer/id #uuid "a47542a8-9b3c-5c1f-a990-6c080eb2c3cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{8}" :db/id #edb/ref 17592186242627} {:answer/id #uuid "b9c37fb5-15bc-5c9c-ac02-81147abd5673" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{12}" :db/id #edb/ref 17592186242810} {:answer/id #uuid "ee8cf53f-c6cd-5298-a246-3f874d8397d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186243295}] :answer-field/correct {:answer/id #uuid "13ef2485-088a-59e5-a9d3-d6d81ac05af0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186241351} :answer-field/id #uuid "76907d51-a76b-59d2-814f-949dc43b9da2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243669}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b5b0b758-0715-5d36-8c00-3c3db2730695" :question/math-academy-id "q-107579" :question/problem "Given that the expression $2\\sqrt{6}\\operatorname{cos}⁡x+2\\sqrt{2}\\operatorname{sin}⁡x$ can be written as $R\\operatorname{cos}⁡(x-ϕ)$ with $0<ϕ<\\frac{\\pi }{2}$ and $R>0$, what is the value of $ϕ?$" :question/worked-solution "The difference formula for cosine gives \n\n$$\n\\begin{aligned}R\\operatorname{cos}⁡(x-ϕ) & =R(\\operatorname{cos}⁡x\\operatorname{cos}⁡ϕ+\\operatorname{sin}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{cos}⁡x+R\\operatorname{sin}⁡ϕ\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n2\\sqrt{6}\\operatorname{cos}⁡x+2\\sqrt{2}\\operatorname{sin}⁡x=R\\operatorname{cos}⁡(x-ϕ),\n$$\n\nwe get the following identity:\n\n$$\n2\\sqrt{6}\\operatorname{cos}⁡x+2\\sqrt{2}\\operatorname{sin}⁡x=(R\\operatorname{cos}⁡ϕ)\\operatorname{cos}⁡x+(R\\operatorname{sin}⁡ϕ)\\operatorname{sin}⁡x\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n{\\begin{aligned}R\\operatorname{cos}⁡ϕ=2\\sqrt{6} \\\\ R\\operatorname{sin}⁡ϕ=2\\sqrt{2}\\end{aligned}\n$$\n\nDividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{R\\operatorname{sin}⁡ϕ}{R\\operatorname{cos}⁡ϕ} & =\\frac{2\\sqrt{2}}{2\\sqrt{6}} \\\\ \\operatorname{tan}⁡ϕ & =\\frac{1}{\\sqrt{3}} \\\\ ϕ & =\\operatorname{arctan}⁡(\\frac{1}{\\sqrt{3}}) \\\\ ϕ & =\\frac{\\pi }{6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244101 :knowledge-point/_questions [{:db/id #edb/ref 17592186083237 :knowledge-point/id #uuid "4b0262c8-c029-5a72-846b-1b4f4f3306ba" :knowledge-point/title "Finding a Quadratic Polynomial Given a Double Root and a Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e8c00cb-26d5-59e0-8910-feec13fe31f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}-8y+16" :db/id #edb/ref 17592186241446} {:answer/id #uuid "5f505ca2-b236-5af2-bed3-aa7db90c63d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}-4y+24" :db/id #edb/ref 17592186242037} {:answer/id #uuid "9217d3d4-bb7b-5264-a4c6-604779d301bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}-12y+32" :db/id #edb/ref 17592186242464} {:answer/id #uuid "d5542f30-67ed-51e5-a31d-ece57cb3139a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}-24y+48" :db/id #edb/ref 17592186243067} {:answer/id #uuid "dcedd8c7-8fcd-5751-a804-3a5e38543271" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}-3y+96" :db/id #edb/ref 17592186243146}] :answer-field/correct {:answer/id #uuid "d5542f30-67ed-51e5-a31d-ece57cb3139a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}-24y+48" :db/id #edb/ref 17592186243067} :answer-field/id #uuid "b695e0a3-38d4-54b7-b117-4a2899a77bd3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243760}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e58cf3f2-d831-56b3-ae64-968d9ec9277c" :question/math-academy-id "q-107695" :question/problem "The quadratic polynomial $P(y)$ has the double root ${y}_{1}={y}_{2}=4,$ and the coefficient of the quadratic term is $a=3.$ Find $P(y).$" :question/worked-solution "Since our quadratic polynomial has the double root ${y}_{1}={y}_{2}=4,$ and the coefficient of the quadratic term is $a=3,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(y-{y}_{1})^{2} & =3{(y-4)}^{2}\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}3{(y-4)}^{2} & =3({y}^{2}-8y+16) \\\\  & =3{y}^{2}-24y+48.\\end{aligned}\n$$\n\nTherefore, $P(y)=3{y}^{2}-24y+48.$"}] [{:db/id #edb/ref 17592186244103 :knowledge-point/_questions [{:db/id #edb/ref 17592186083239 :knowledge-point/id #uuid "1ee21c78-209f-564b-a005-86f58699a3be" :knowledge-point/title "Factoring a Quadratic Polynomial With Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "639c201d-2539-547c-a951-b41231217d88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z-(4-3\\text{i})" :db/id #edb/ref 17592186242078} {:answer/id #uuid "740c17ab-70ea-5787-a71f-b338b6753386" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z-(7-2\\text{i})" :db/id #edb/ref 17592186242208} {:answer/id #uuid "9117853e-19e7-5845-be3b-865b6d77d448" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z-(2-\\text{i})" :db/id #edb/ref 17592186242452} {:answer/id #uuid "ac101540-88cf-5369-a012-1117eed63915" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z-(3-4\\text{i})" :db/id #edb/ref 17592186242684} {:answer/id #uuid "baac76e2-9dd7-5385-b16a-2fb696e39435" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z-(1-2\\text{i})" :db/id #edb/ref 17592186242817}] :answer-field/correct {:answer/id #uuid "639c201d-2539-547c-a951-b41231217d88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z-(4-3\\text{i})" :db/id #edb/ref 17592186242078} :answer-field/id #uuid "94c0c5e4-aaf8-55fc-84eb-5f459c0b34ce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243717}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "08fb3447-ef6d-5299-8ee8-8365ce0ff2df" :question/math-academy-id "q-107697" :question/problem "Which of the following is a factor of $3{z}^{2}-24z+75?$" :question/worked-solution "First, we let $f(z)=3{z}^{2}-24z+75.$\n\nNext, we solve $f(z)=0$ by completing the square, as follows:\n\n$$\n\\begin{aligned}f(z) & =0 \\\\ 3{z}^{2}-24z+75 & =0 \\\\ {z}^{2}-8z+25 & =0 \\\\ ({z}^{2}-2\\cdot 4\\cdot z+{4}^{2})-{4}^{2}+25 & =0 \\\\ (z-4)^{2}-16+25 & =0 \\\\ (z-4)^{2}+9 & =0 \\\\ (z-4)^{2} & =-9 \\\\ (z-4)^{2} & =9{\\text{i}}^{2} \\\\ (z-4)^{2} & =(3\\text{i})^{2} \\\\ z-4 & =\\pm 3\\text{i} \\\\ z & =4\\pm 3\\text{i}\\end{aligned}\n$$\n\nSince our quadratic equation has roots ${z}_{1}=4+3\\text{i}$ and ${z}_{2}=4-3\\text{i},$ and the coefficient of the quadratic term is $a=3,$ the expression $3{z}^{2}-24z+75$ can be written as\n\n$$\n\\begin{aligned}3{z}^{2}-24z+75 & =a(z-{z}_{1})(z-{z}_{2}) \\\\  & =3(z-(4+3\\text{i}))(z-(4-3\\text{i})).\\end{aligned}\n$$\n\nTherefore, among the given options, only $z-(4-3\\text{i})$ is a factor of $3{z}^{2}-24z+75.$"}] [{:db/id #edb/ref 17592186244104 :knowledge-point/_questions [{:db/id #edb/ref 17592186087814 :knowledge-point/id #uuid "7a64d73a-2983-5d05-9aa0-4582b2e7aee1" :knowledge-point/title "Finding a Quartic Polynomial Given Four Real Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "283dd8ef-971d-59dc-8c22-a57da8f4fb18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}-3{x}^{3}-13{x}^{2}+24x-32" :db/id #edb/ref 17592186241530} {:answer/id #uuid "9d585d13-77f3-51dc-82cb-8f0097e25c40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}-3{x}^{3}-14{x}^{2}+48x-32" :db/id #edb/ref 17592186242553} {:answer/id #uuid "db18a8d9-67d3-5baa-a082-6d6111cd3c7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}-5{x}^{3}-4{x}^{2}+8x-32" :db/id #edb/ref 17592186243127} {:answer/id #uuid "e9e0c3b0-f1ba-5576-ad78-b76515c27328" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}+5{x}^{3}-14{x}^{2}+12x" :db/id #edb/ref 17592186243248} {:answer/id #uuid "fd7285ab-6e81-559e-8df6-98667c1a4131" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}-4{x}^{3}+6x-32" :db/id #edb/ref 17592186243413}] :answer-field/correct {:answer/id #uuid "9d585d13-77f3-51dc-82cb-8f0097e25c40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}-3{x}^{3}-14{x}^{2}+48x-32" :db/id #edb/ref 17592186242553} :answer-field/id #uuid "29bac376-f135-50a7-8d7c-66cb593ebe4c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243513}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1f1849e7-d472-55dd-8262-ff8adf785460" :question/math-academy-id "q-107795" :question/problem "The quartic polynomial $P(x)$ has roots ${x}_{1}=1,{x}_{2}=2,{x}_{3}=-4$ and ${x}_{4}=4$ and the coefficient of the quartic term is $1.$ Find $P(x).$" :question/worked-solution "Since our quartic polynomial has roots ${x}_{1}=1,{x}_{2}=2,$ ${x}_{3}=-4,$ and ${x}_{4}=4,$ and the coefficient of the quartic term is $a=1,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3})(x-{x}_{4}) & =1(x-1)(x-2)(x-(-4))(x-4) \\\\  & =(x-1)(x-2)(x+4)(x-4)\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}(x-1)(x-2)(x+4)(x-4) & =({x}^{2}-3x+2)({x}^{2}-16) \\\\  & ={x}^{4}-16{x}^{2}-3{x}^{3}+48x+2{x}^{2}-32 \\\\  & ={x}^{4}-3{x}^{3}-14{x}^{2}+48x-32.\\end{aligned}\n$$\n\nTherefore, $P(x)={x}^{4}-3{x}^{3}-14{x}^{2}+48x-32.$"}] [{:db/id #edb/ref 17592186244107 :knowledge-point/_questions [{:db/id #edb/ref 17592186105770 :knowledge-point/id #uuid "b7f5608f-a9f5-5e6a-b308-540ed8b29259" :knowledge-point/title "Determining the Value of an Unknown Given an Eigenvalue and Eigenvector of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1acbfa7e-1097-5f7d-83e6-c2b9ac3e982f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186241410} {:answer/id #uuid "2c6761a4-5b41-5bee-afea-b8bc7e3ff850" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186241574} {:answer/id #uuid "357cbcbd-820d-57b0-98af-1f34bcfbd25f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186241647} {:answer/id #uuid "8bd21a75-41a6-5ee5-a109-306cccd713be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186242419} {:answer/id #uuid "9f9da265-adb2-52ac-a03f-18c2bc64d1e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186242577}] :answer-field/correct {:answer/id #uuid "2c6761a4-5b41-5bee-afea-b8bc7e3ff850" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186241574} :answer-field/id #uuid "320e84bc-9f0a-5f6c-a0c9-8582a9a6e1f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243531}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e548fde0-64fe-56ce-a880-74d36f5eace9" :question/math-academy-id "q-107837" :question/problem "An eigenvector of $A=[\\begin{aligned}11 & -6 \\\\ -12 & 25\\end{aligned}]$ corresponding to the eigenvalue $\\lambda =7$ is  $v=[\\begin{aligned}c+1 \\\\ c\\end{aligned}].$ Determine the value of $c.$" :question/worked-solution "Remember that the eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ So, we have\n\n$$\n\\begin{aligned}Av & =\\lambda v \\\\ [\\begin{aligned}11 & -6 \\\\ -12 & 25\\end{aligned}][\\begin{aligned}c+1 \\\\ c\\end{aligned}] & =7[\\begin{aligned}c+1 \\\\ c\\end{aligned}] \\\\ [\\begin{aligned}5c+11 \\\\ 13c-12\\end{aligned}] & =[\\begin{aligned}7c+7 \\\\ 7c\\end{aligned}].\\end{aligned}\n$$\n\nThis gives us the following system of linear equations:\n\n$$\n{\\begin{aligned}5c+11=7c+7 \\\\ 13c-12=7c\\end{aligned}\n$$\n\n- Solving for $c$ in the first equation, we get\n\n$$\n5c+11=7c+7\\,⟹\\,c=2.\n$$\n\n- Solving for $c$ in the second equation, we get\n\n$$\n13c-12=7c\\,⟹\\,c=2.\n$$\n\nTherefore, the solution of the system is $c=2.$"}] [{:db/id #edb/ref 17592186167067 :knowledge-point/_questions [{:db/id #edb/ref 17592186166853 :knowledge-point/id #uuid "25214773-e6cb-5663-95fe-a04408844902" :knowledge-point/title "Finding a Differential Equation That Relates the Velocity and Displacement of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "956a2a68-a066-5d9b-99c4-1ffdab50a6c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}v^{2}\\frac{dv}{dx} = 4x^{2}" :db/id #edb/ref 17592186163481} {:answer/id #uuid "f06249ca-353d-5c5c-aac0-700c2abf2c77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v^{2}\\frac{dv}{dx} = 4x^{2}" :db/id #edb/ref 17592186163482} {:answer/id #uuid "187ad1a9-4758-51ce-bc58-282e7ecd3b91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v\\frac{dv}{dx} = 4x^{2}" :db/id #edb/ref 17592186163483} {:answer/id #uuid "413bb140-de62-5a16-9c14-2aea7a9922d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{v}\\frac{dv}{dx} = 4x^{2}" :db/id #edb/ref 17592186163484} {:answer/id #uuid "6ff73680-3743-5d57-90d1-3587578c0f5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dv}{dx} = 4x^{2}" :db/id #edb/ref 17592186163485}] :answer-field/id #uuid "39280676-c935-5a69-9075-d31a70d69db8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186163480} {:answer-field/choices [{:answer/id #uuid "421852f4-4f42-5b1c-bf9e-1abfb03a3d74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{v}\\frac{\\text{d}v}{\\text{d}x}=4{x}^{2}" :db/id #edb/ref 17592186375709} {:answer/id #uuid "f5ad6f5f-5a30-5e2d-bf32-8da8b862cd80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}v}{\\text{d}x}=4{x}^{2}" :db/id #edb/ref 17592186375710} {:answer/id #uuid "ebe84925-988d-521e-8297-13f2aa128cd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{v}^{2}\\frac{\\text{d}v}{\\text{d}x}=4{x}^{2}" :db/id #edb/ref 17592186375711} {:answer/id #uuid "2dc293e9-bbda-5d87-8b09-2a737ba5a341" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{v}^{2}\\frac{\\text{d}v}{\\text{d}x}=4{x}^{2}" :db/id #edb/ref 17592186375712} {:answer/id #uuid "7667ef6e-cc23-5c48-9b96-ca442081c5c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v\\frac{\\text{d}v}{\\text{d}x}=4{x}^{2}" :db/id #edb/ref 17592186375713}] :answer-field/correct {:answer/id #uuid "7667ef6e-cc23-5c48-9b96-ca442081c5c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v\\frac{\\text{d}v}{\\text{d}x}=4{x}^{2}" :db/id #edb/ref 17592186375713} :answer-field/id #uuid "58d8638f-e495-5f20-b9d1-2a666c70bb7b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375708}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f1d3a897-4665-5a3c-93ac-66ae33ab4d78" :question/math-academy-id "q-107998" :question/problem "A particle $P$ moves along the $x$-axis. When the displacement of $P$ from the origin $O$ is $x$ meters, its velocity is $v\\,m/s$ and its acceleration is $4{x}^{2}\\,{m/s}^{2}.$ Which differential equation describes this motion?" :question/worked-solution "![](images/88/888a2f1f537f7381379a6f85dc850f29b42193eb53938832be8ede47fbe8264a.png)\n\nSince the acceleration of the particle $P$ is $4{x}^{2}\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=4{x}^{2}.\n$$\n\nUsing the chain rule for differentiation, we can rewrite this equation as\n\n$$\n\\frac{\\text{d}v}{\\text{d}x}\\cdot \\frac{\\text{d}x}{\\text{d}t}=4{x}^{2}.\n$$\n\nNow, since $v=\\frac{\\text{d}x}{\\text{d}t},$ we obtain the differential equation\n\n$$\nv\\frac{\\text{d}v}{\\text{d}x}=4{x}^{2}.\n$$"}] [{:db/id #edb/ref 17592186167068 :knowledge-point/_questions [{:db/id #edb/ref 17592186166854 :knowledge-point/id #uuid "1320d414-11eb-58a9-b59f-a6f760e87578" :knowledge-point/title "Solving a Differential Equation That Relates the Velocity and Displacement of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0efc57f9-3b68-505a-890f-a6fd6cf1e109" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(x)=2\\sqrt{{x}^{2}+1}" :db/id #edb/ref 17592186241307} {:answer/id #uuid "19cd3def-04bb-529a-b9f2-db87808c05c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(x)=2\\sqrt{{x}^{2}+12}" :db/id #edb/ref 17592186241401} {:answer/id #uuid "38da12bd-ce5e-5d20-9221-a12ebc51f6c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(x)=2{x}^{2}" :db/id #edb/ref 17592186241690} {:answer/id #uuid "3b5bb1c2-0cb4-50aa-a486-98783cd32800" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(x)={x}^{2}+4" :db/id #edb/ref 17592186241709} {:answer/id #uuid "cbee714a-7515-5c91-aef2-65b895acf095" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(x)=\\frac{8}{5}\\sqrt{{x}^{2}+21}" :db/id #edb/ref 17592186242972}] :answer-field/correct {:answer/id #uuid "19cd3def-04bb-529a-b9f2-db87808c05c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(x)=2\\sqrt{{x}^{2}+12}" :db/id #edb/ref 17592186241401} :answer-field/id #uuid "920a508d-c801-5105-8257-5f6f6e4caa7f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243713}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cfc6326b-3536-5d27-a880-335a706849db" :question/math-academy-id "q-107999" :question/problem "A particle $P$ moves along the $x$-axis in the direction of increasing $x.$ When the displacement of $P$ from the origin $O$ is $x\\,m,$ its velocity is $v\\,m/s$ and its acceleration is $4x\\,{m/s}^{2}.$ If $P$ has a displacement of $2\\,m$ when its velocity is $8\\,m/s,$ find $v$ in terms of $x.$" :question/requires-calculator true :question/worked-solution "![](images/01/017463f3ac8abac9c2b00c4d9a715a4109a5f4bc1b070e0a12c4d3a7bac64351.png)\n\nSince the acceleration of the particle $P$ is $4x\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=4x.\n$$\n\nUsing the fact that \n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2}),\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=4x.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\,\\text{d}x=\\int 4x\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=2{x}^{2}+C.\n$$\n\nNow, since $x=2\\,\\text{m}$ when $v=8\\,\\text{m/s},$ we can find the value of the constant $C$, as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =2{x}^{2}+C \\\\ \\frac{1}{2}(8)^{2} & =2(2)^{2}+C \\\\ C & =32-8 \\\\ C & =24\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =2{x}^{2}+24 \\\\ {v}^{2} & =4{x}^{2}+48 \\\\ {v}^{2} & =4({x}^{2}+12) \\\\ v & =\\pm 2\\sqrt{{x}^{2}+12}.\\end{aligned}\n$$\n\nFinally, since the particle is moving in the direction of increasing  $x,$ we have that $v(x)>0,$ so we can discard the negative square root. Therefore,\n\n$$\nv(x)=2\\sqrt{{x}^{2}+12}.\n$$"}] [{:db/id #edb/ref 17592186092506 :knowledge-point/_questions [{:db/id #edb/ref 17592186092382 :knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172" :knowledge-point/title "Calculating the Equation of a Tangent Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4449ae41-4745-5b6f-b350-f2f97023e8a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-13x" :db/id #edb/ref 17592186241795} {:answer/id #uuid "55bb886a-92cb-557e-8876-f77d513accdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=13x+16" :db/id #edb/ref 17592186241951} {:answer/id #uuid "9bfa2fa6-5ff0-56df-82ea-dc60dc378c34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-13x+16" :db/id #edb/ref 17592186242543} {:answer/id #uuid "d2301dcd-3f98-562b-b394-4b8c11213afb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-13x-16" :db/id #edb/ref 17592186243033} {:answer/id #uuid "ddb04a3b-265b-566c-82e8-caa20465742b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=13x" :db/id #edb/ref 17592186243153}] :answer-field/correct {:answer/id #uuid "9bfa2fa6-5ff0-56df-82ea-dc60dc378c34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-13x+16" :db/id #edb/ref 17592186242543} :answer-field/id #uuid "9cf77461-8081-57bc-9334-b34732f1f93f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243728}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6a853078-a18d-5836-8fe8-22fab4093858" :question/math-academy-id "q-10832" :question/problem "Find the equation of the tangent to the curve $y=\\frac{4}{{x}^{3}}-x$ at the point $(1,3).$" :question/worked-solution "Let $f(x)=\\frac{4}{{x}^{3}}-x.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & =-12{x}^{-4}-1.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(1)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(1)=-12(1)^{-4}-1=-13.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=-13$ and the coordinates of our point $(1,3),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(3) & =-13(x-1) \\\\ y & =-13x+13+3 \\\\ y & =-13x+16.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244126 :knowledge-point/_questions [{:db/id #edb/ref 17592186092382 :knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172" :knowledge-point/title "Calculating the Equation of a Tangent Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "462f21c8-a32c-5cda-84b7-37744e22718b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=16x-8" :db/id #edb/ref 17592186241815} {:answer/id #uuid "4b650713-54c4-53ad-9158-64cadb27ca27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5x-2" :db/id #edb/ref 17592186241859} {:answer/id #uuid "5726209a-7467-583c-a028-1f93390b638f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=16x-12" :db/id #edb/ref 17592186241970} {:answer/id #uuid "a96129cb-4819-5b81-9f60-2fc2160dba34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5x-13" :db/id #edb/ref 17592186242665} {:answer/id #uuid "dda5ca10-115e-5cb5-bc36-7f1acf094d5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x-12" :db/id #edb/ref 17592186243151}] :answer-field/correct {:answer/id #uuid "462f21c8-a32c-5cda-84b7-37744e22718b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=16x-8" :db/id #edb/ref 17592186241815} :answer-field/id #uuid "ae01ef85-57dd-5226-8116-895f71485c74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243751}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d0e5b8a4-9dc2-5fdd-9f7d-f9d1860644a8" :question/math-academy-id "q-10835" :question/problem "Find the equation of the tangent to the curve  $y=2{x}^{2}+8x$ at the point $(2,24).$" :question/worked-solution "Let $f(x)=2{x}^{2}+8x.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{2}+8x)=4x+8.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(2)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(2)=4(2)+8=16\\,.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=16$ and the coordinates of our point $(2,24),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(24) & =16(x-2) \\\\ y & =16x-32+24 \\\\ y & =16x-8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244128 :knowledge-point/_questions [{:db/id #edb/ref 17592186092382 :knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172" :knowledge-point/title "Calculating the Equation of a Tangent Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "167d2601-a153-5f76-a657-ca8a9d1514cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=7x+5" :db/id #edb/ref 17592186241373} {:answer/id #uuid "1a460d87-b01b-5994-a872-d9d2d63d990e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x-14" :db/id #edb/ref 17592186241406} {:answer/id #uuid "5cef4fad-b362-5fb0-9d61-adeb769f3eba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=14x-5" :db/id #edb/ref 17592186242018} {:answer/id #uuid "99e8f71d-5a67-5472-92fa-2f862e281d67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=7x-5" :db/id #edb/ref 17592186242525} {:answer/id #uuid "ec8b1ec7-7686-54d6-b158-98e7a4da2198" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=14x-6" :db/id #edb/ref 17592186243272}] :answer-field/correct {:answer/id #uuid "5cef4fad-b362-5fb0-9d61-adeb769f3eba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=14x-5" :db/id #edb/ref 17592186242018} :answer-field/id #uuid "f4591678-2345-5cd5-86ed-0af81cfe1bff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243862}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8e99979c-2ce7-5d29-8201-3e59e8d5c01e" :question/math-academy-id "q-10837" :question/problem "Find the equation of the tangent to the curve $y=5{x}^{2}+4x$ at the point $(1,9).$" :question/worked-solution "Let $f(x)=5{x}^{2}+4x.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(5{x}^{2}+4x)=10x+4.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(1)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(1)=10(1)+4=14\\,.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=14$ and the coordinates of our point $(1,9),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(9) & =14(x-1) \\\\ y & =14x-14+9 \\\\ y & =14x-5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244129 :knowledge-point/_questions [{:db/id #edb/ref 17592186092382 :knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172" :knowledge-point/title "Calculating the Equation of a Tangent Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4126f706-48df-568c-b158-3997506d4eed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=6x-2" :db/id #edb/ref 17592186241765} {:answer/id #uuid "610cb095-d0ad-5b8e-bec8-a14ee91baff4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-7x-4" :db/id #edb/ref 17592186242053} {:answer/id #uuid "6ba8b659-34e4-5d07-b800-54a6ae18926d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x-2" :db/id #edb/ref 17592186242148} {:answer/id #uuid "77df9ea1-4e2d-5e4c-8c89-27e3cf5f41be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-7x+4" :db/id #edb/ref 17592186242237} {:answer/id #uuid "cf34a8a7-7deb-53a6-96fb-1f57b08518d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=6x+2" :db/id #edb/ref 17592186243008}] :answer-field/correct {:answer/id #uuid "610cb095-d0ad-5b8e-bec8-a14ee91baff4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-7x-4" :db/id #edb/ref 17592186242053} :answer-field/id #uuid "0eec1ce0-0929-54cc-9812-bce7469c03cd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243464}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ac2b6c08-7044-5ff0-8a22-7d7df849af22" :question/math-academy-id "q-10839" :question/problem "Find the equation of the tangent to the curve $y={x}^{2}-3x$ at the point $(-2,10).$" :question/worked-solution "Let $f(x)={x}^{2}-3x.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}({x}^{2}-3x)=2x-3.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(-2)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(-2)=2(-2)-3=-7.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=-7$ and the coordinates of our point $(-2,10),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(10) & =-7(x-(-2)) \\\\ y-10 & =-7(x+2) \\\\ y & =-7x-14+10 \\\\ y & =-7x-4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244132 :knowledge-point/_questions [{:db/id #edb/ref 17592186138476 :knowledge-point/id #uuid "916e6da9-a2d1-5bf9-9777-ce4ca4858b96" :knowledge-point/title "Finding the Units of Acceleration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20f0ba03-3840-54b7-a1a8-f54a5ca90a75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\text{in}}^{2}}{\\text{min}}" :db/id #edb/ref 17592186241466} {:answer/id #uuid "375a6fdc-beb9-5fea-8870-47349f6456cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{in}}{{\\text{min}}^{3}}" :db/id #edb/ref 17592186241666} {:answer/id #uuid "8ddddf09-2bf6-5611-aeb6-401c12d61d1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{in}}{{\\text{min}}^{2}}" :db/id #edb/ref 17592186242428} {:answer/id #uuid "91cbfff9-e708-53e4-8ab6-f2c2dd10b472" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\text{in}}^{2}}{{\\text{min}}^{2}}" :db/id #edb/ref 17592186242462} {:answer/id #uuid "96445467-8dbd-5a24-a81e-77382a985908" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{in}}{\\text{min}}" :db/id #edb/ref 17592186242498}] :answer-field/correct {:answer/id #uuid "8ddddf09-2bf6-5611-aeb6-401c12d61d1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{in}}{{\\text{min}}^{2}}" :db/id #edb/ref 17592186242428} :answer-field/id #uuid "8b586ba0-77a9-5c27-a7e9-af8c3c02ecb8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243700}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "74f37dee-395d-5c55-b0ce-e5d3a65d3713" :question/math-academy-id "q-108448" :question/problem "If the speed of a rabbit is measured in $\\text{in/min},$ what are the units of its acceleration?" :question/worked-solution "We can find the acceleration of an object by computing the slope of its speed-time graph. So, let's draw an example of a speed-time graph where the speed is measured in $\\text{in/min}$ and the time is measured in $\\text{min}.$\n\n![](images/ec/ecdd2f132499a6be0c1d8fa48f021713e2019ed9e6660af041853f7e30766091.png)\n\nIn this case, the slope is computed as\n\n$$\nm=\\frac{\\text{change in speed}}{\\text{change in time}},\n$$\n\nand so the units of the slope are as follows:\n\n$$\n\\frac{\\text{units of speed}}{\\text{units of time}}=\\frac{\\text{in/min}}{\\text{min}}=\\frac{\\text{in}}{\\text{min}}\\cdot \\frac{1}{\\text{min}}=\\frac{\\text{in}}{{\\text{min}}^{2}}\n$$\n\nTherefore, the units of acceleration are $\\frac{\\text{in}}{{\\text{min}}^{2}}.$"}] [{:db/id #edb/ref 17592186399643 :knowledge-point/_questions [{:db/id #edb/ref 17592186138478 :knowledge-point/id #uuid "8f4e3599-287a-56a3-8f1b-9e7033803e0a" :knowledge-point/title "Identifying Acceleration on a Speed-Time Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46f114a5-8479-5ab2-898f-e1a0d9b64d84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "From $20\\,\\text{s}$ to $40\\,\\text{s}$" :db/id #edb/ref 17592186399645} {:answer/id #uuid "8bfd7b7f-f09a-57f0-9cdf-fa0624b62f8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "From $30\\,\\text{s}$ to $60\\,\\text{s}$" :db/id #edb/ref 17592186399646} {:answer/id #uuid "bbf8f966-bf45-522b-9a34-c98c57a6aa01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "From $0\\,\\text{s}$ to $60\\,\\text{s}$" :db/id #edb/ref 17592186399647} {:answer/id #uuid "2463de37-8db5-51e1-909c-4ac15ec53855" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "From $10\\,\\text{s}$ to $50\\,\\text{s}$" :db/id #edb/ref 17592186399648} {:answer/id #uuid "8f078bce-f94d-54cc-ae41-aea8efc48b13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "From $0\\,\\text{s}$ to $30\\,\\text{s}$" :db/id #edb/ref 17592186399649}] :answer-field/correct {:answer/id #uuid "8bfd7b7f-f09a-57f0-9cdf-fa0624b62f8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "From $30\\,\\text{s}$ to $60\\,\\text{s}$" :db/id #edb/ref 17592186399646} :answer-field/id #uuid "6d62422f-d84e-5e31-bc10-667678bf2be5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399644}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c47c1778-9762-5608-84e1-7206031f9c36" :question/math-academy-id "q-108462" :question/problem "![](images/31/31e0e843eb581f01cdc7ebb5273398a3c0f32d2949b9e36cd28423295d7b76e8.png)\n\nThe speed-time graph shown above represents the motion of a $250\\text{cc}$ motorcycle. At what times is the motorcycle accelerating?" :question/worked-solution "The motorcycle is accelerating when its acceleration is positive. In a speed-time graph, the acceleration is given by the slope of the line. So, we need to find the times for which the slope is positive.\n\nWe see from the graph that the slope is positive from $t=30\\,\\text{s}$ to $t=60\\,\\text{s}.$ Therefore, the $250\\text{cc}$ motorcycle is accelerating in this time interval."}] [{:db/id #edb/ref 17592186244141 :knowledge-point/_questions [{:db/id #edb/ref 17592186054845 :knowledge-point/id #uuid "9bf25f86-6b27-5eaa-b1a1-1104478b290a" :knowledge-point/title "Finding the Derivative of a Function Given in Implicit Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e436aa9-1f27-528c-9b27-85ed3f247f85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{y}+1}{2-{e}^{y}}" :db/id #edb/ref 17592186241442} {:answer/id #uuid "aa8e1e52-332d-5342-9c48-ba0f24733d9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2-{e}^{y}}" :db/id #edb/ref 17592186242671} {:answer/id #uuid "bb3b068a-44ff-5d2f-a0c9-b5478e80da18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x{e}^{y}-1}{2-{e}^{y}}" :db/id #edb/ref 17592186242822} {:answer/id #uuid "d2124168-f20b-59e2-b795-fe1b9c41f12c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{y}+2}{1+y{e}^{y}}" :db/id #edb/ref 17592186243031} {:answer/id #uuid "fe8d9684-f50a-5be7-ae59-410c9f9af558" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y{e}^{y}+1}{2+{e}^{y}}" :db/id #edb/ref 17592186243420}] :answer-field/correct {:answer/id #uuid "aa8e1e52-332d-5342-9c48-ba0f24733d9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2-{e}^{y}}" :db/id #edb/ref 17592186242671} :answer-field/id #uuid "56334162-ef15-56a1-bf2b-a790116276b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243610}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7ce22a4d-4733-52a4-87c2-c2e0529b4bfc" :question/math-academy-id "q-108506" :question/problem "Given that  ${e}^{y}=2y-x,$ calculate $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({e}^{y}) & =\\frac{\\text{d}}{\\text{d}x}(2y-x) \\\\ {e}^{y}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}(2y)}{\\text{d}x}-\\frac{\\text{d}(x)}{\\text{d}x} \\\\ {e}^{y}\\frac{\\text{d}y}{\\text{d}x} & =2\\frac{\\text{d}y}{\\text{d}x}-1\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}{e}^{y}\\frac{\\text{d}y}{\\text{d}x} & =2\\frac{\\text{d}y}{\\text{d}x}-1 \\\\ \\frac{\\text{d}y}{\\text{d}x}(2-{e}^{y}) & =1 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2-{e}^{y}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386282 :knowledge-point/_questions [{:db/id #edb/ref 17592186138479 :knowledge-point/id #uuid "88580aff-e043-58ea-a8ca-1ce32026428f" :knowledge-point/title "Constructing the Speed-Time Graph for a Real-Life Scenario"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "085fe59d-4891-5783-a3dc-e512a6c66398" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/17/170dea566e8c74e1c3df3c087c6565c85dd03c0703c4dbec1be594ca653c6aa1.png" :db/id #edb/ref 17592186386284} {:answer/id #uuid "39a73eee-b69a-5a6a-a85b-7c1d22da0949" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0c/0c89f7f469830ff7c505d22677f6ea612f1fff396c73aba325b4e87f6f61ae42.png" :db/id #edb/ref 17592186386285} {:answer/id #uuid "258ed6c0-b4dd-5cf0-90d1-01a6e4322f93" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a3/a3fb0b9ebb6ef907a77c3d8ce139802dbd72fab04ea0bfc5db57e9f028c263b9.png" :db/id #edb/ref 17592186386286} {:answer/id #uuid "d191d1ef-4285-5a17-92b3-a9aefa6e1e2c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/12/1280bba15fdb6ada20f6d6f2ea4cfeeb39e9366939d72a06059062cc2abedc8d.png" :db/id #edb/ref 17592186386287} {:answer/id #uuid "3cdbb3a8-0531-5672-b68a-760d458dd965" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8d/8dd2eefb2c2397f10d4c07853ef819b8682e448824bf6e26302d4a16bc02183c.png" :db/id #edb/ref 17592186386288}] :answer-field/correct {:answer/id #uuid "258ed6c0-b4dd-5cf0-90d1-01a6e4322f93" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a3/a3fb0b9ebb6ef907a77c3d8ce139802dbd72fab04ea0bfc5db57e9f028c263b9.png" :db/id #edb/ref 17592186386286} :answer-field/id #uuid "c342a9a6-0c8f-53d9-8bfc-52d1954443be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386283}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0e2fe401-8d6a-539f-989f-5022eb0fe1eb" :question/math-academy-id "q-108567" :question/problem "A particle accelerates from rest with a constant acceleration of $1\\,{\\text{km/h}}^{2}$ for the first $3$ hours of its motion. It then travels at a constant speed for the next $3$ hours before accelerating with a constant acceleration of $0.5\\,{\\text{km/h}}^{2}$ for other $3$ hours. Which graph represents the described motion?" :question/worked-solution "We start the first line from the point $(0,0),$ since the particle starts from rest. Then, because the acceleration is $1\\,{\\text{km/h}}^{2},$ we draw a line with slope $1.$ \n\nHowever, because the particle is only accelerating for the first $3$ hours, we stop the line at $t=3.$ At this time, the particle's speed has increased by $1\\cdot 3=3\\,\\text{km/h}.$ So, the first line segment goes from $(0,0)$ to $(3,3).$\n\n![](images/7a/7a9fd32e5705860064e597fcf9308fee457063e060d3adede260f109ca488201.png)\n\nThe particle then travels at a constant speed for the next $3$ hours. So, the speed remains at $3\\,\\text{km/h}$ for the next $3$ hours, until $t=3+3=6.$\n\n![](images/e4/e4c7e47150bf1c205c243c6fa1d0f0e24b7a69f27a8461791d495eb7487cf4f3.png)\n\nAfter $t=3,$ the particle has an acceleration of $0.5\\,{\\text{km/h}}^{2},$ so the slope of the third line segment is $0.5.$ The third line segment stops after $3$ hours. To figure out the velocity at this moment, we need to find the equation for the third line segment.\n\nSince the third line segment passes through the point $(6,3)$ and has a slope of $0.5,$ we can use point-slope form to write the equation of the line:\n\n$$\n\\begin{aligned}v-{v}_{1} & =m(t-{t}_{1}) \\\\ v-3 & =0.5(t-6) \\\\ v-3 & =0.5t-3 \\\\ v & =0.5t\\end{aligned}\n$$\n\nThe third line segment stops when $t=6+3=9$ hours, and the velocity at this moment is\n\n$$\n\\begin{aligned}v & =0.5t \\\\ v & =0.5(9) \\\\ v & =4.5\\end{aligned}\n$$\n\nSo, the third line segment stops at the point $(9,4.5).$ The final graph is\n\n![](images/a3/a3fb0b9ebb6ef907a77c3d8ce139802dbd72fab04ea0bfc5db57e9f028c263b9.png)"}] [{:db/id #edb/ref 17592186244145 :knowledge-point/_questions [{:db/id #edb/ref 17592186078548 :knowledge-point/id #uuid "9d7a21aa-f2e3-5461-81a6-5cbd0f63c03d" :knowledge-point/title "Finding the First Term of an Arithmetic Series Given the Last Term and the Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1272bcc9-43df-533a-bc65-2d16399361ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186241337} {:answer/id #uuid "6e0a2ba2-2d46-513b-91a2-e9980fdf2686" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186242162} {:answer/id #uuid "7add10bb-d34e-535b-84b3-00b79f22245c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{4}" :db/id #edb/ref 17592186242261} {:answer/id #uuid "ead072d4-85c6-5d9e-b6c0-2fd1d3f8de19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186243259} {:answer/id #uuid "edd27017-a9fb-5e5a-b333-6489d23db53d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186243288}] :answer-field/correct {:answer/id #uuid "ead072d4-85c6-5d9e-b6c0-2fd1d3f8de19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186243259} :answer-field/id #uuid "63581573-341c-52b9-86e9-ce3da7abe0fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243631}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7347742e-0cd7-5f1f-96ab-5609f6a91cbf" :question/math-academy-id "q-108630" :question/problem "If the sum of the first $36$ terms of an arithmetic series is ${S}_{36}=\\frac{225}{2},$ and the last term is ${a}_{36}=\\frac{11}{2},$ what is the first term of the series?" :question/worked-solution "We are given the last term of our series. So, to find the first term, we use the formula for the sum of an arithmetic series in the form\n\n$$\n{S}_{N}=\\frac{N}{2}({a}_{1}+{a}_{N}),\n$$\n\nwhere ${a}_{1}$ is the first term, ${a}_{N}$ is the last term, and $N$ is the number of terms.\n\nSubstituting ${a}_{36}=\\frac{11}{2}$, $N=36$, and ${S}_{N}=\\frac{225}{2}$ into the formula above and solving for ${a}_{1}$, we get\n\n$$\n\\begin{aligned}\\frac{225}{2} & =\\frac{36}{2}({a}_{1}+\\frac{11}{2}) \\\\ \\frac{225}{36} & ={a}_{1}+\\frac{11}{2} \\\\ \\frac{25}{4} & ={a}_{1}+\\frac{11}{2} \\\\ {a}_{1} & =\\frac{25}{4}-\\frac{11}{2} \\\\ {a}_{1} & =\\frac{3}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244147 :knowledge-point/_questions [{:db/id #edb/ref 17592186078549 :knowledge-point/id #uuid "9f9251ee-4d19-5074-a2a3-07e13149260f" :knowledge-point/title "Finding the First Term of an Arithmetic Series Given the Common Difference and the Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05a2311e-18e7-5113-971f-2b522819e922" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186241226} {:answer/id #uuid "377165d9-847c-5e0b-8161-73ba159b514a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186241668} {:answer/id #uuid "5c6fc430-b7f6-5860-9bc6-f537f9f529e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186242013} {:answer/id #uuid "9ec3f5d6-c0ee-50ec-9327-3fc7782b7910" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186242571} {:answer/id #uuid "acd8443d-84d8-5126-9fa2-4a78e29505a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186242689}] :answer-field/correct {:answer/id #uuid "5c6fc430-b7f6-5860-9bc6-f537f9f529e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186242013} :answer-field/id #uuid "a1f21cfc-8a2d-58bc-85dc-1cde3c3f79ec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243736}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "efe44e24-3349-54e3-ae25-0cd4ad9b52a1" :question/math-academy-id "q-108637" :question/problem "What is the first term of an arithmetic series if the common difference is $d=\\frac{5}{7},$ and the sum of the first $50$ terms is ${S}_{50}=1\\,125?$" :question/worked-solution "We are given the common difference of the series. So, to find the first term, we use the formula for the sum of an arithmetic series in the form\n\n$$\n{S}_{N}=\\frac{N}{2}(2{a}_{1}+(N-1)d),\n$$\n\nwhere ${a}_{1}$ is the first term, $d$ is the common difference, and $N$ is the number of terms.\n\nSubstituting $N=50$, $d=\\frac{5}{7}$, and ${S}_{N}=1\\,125$ into the formula above, we have\n\n$$\n\\begin{aligned}1\\,125 & =\\frac{50}{2}(2{a}_{1}+(50-1)(\\frac{5}{7})) \\\\ 1\\,125 & =25(2{a}_{1}+35) \\\\ 45 & =2{a}_{1}+35 \\\\ 10 & =2{a}_{1} \\\\ {a}_{1} & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244149 :knowledge-point/_questions [{:db/id #edb/ref 17592186054677 :knowledge-point/id #uuid "619182bf-107d-5217-a306-ec4f7c1109eb" :knowledge-point/title "Finding the Derivative of a Function Given in Implicit Form Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38abdefd-3252-574c-ad83-da30c6b82e9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8x-7{x}^{3}{y}^{2}}{7{x}^{2}{y}^{3}-2y}" :db/id #edb/ref 17592186241685} {:answer/id #uuid "bb545dae-a3c6-5bfb-9023-948c37103acf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8x-{x}^{2}{y}^{3}}{7{x}^{3}{y}^{2}+{y}^{2}}" :db/id #edb/ref 17592186242823} {:answer/id #uuid "c5136acb-020b-505c-a4e7-1cfbfb2cc0de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8x-7{x}^{2}{y}^{3}}{7{x}^{3}{y}^{2}+2y}" :db/id #edb/ref 17592186242917} {:answer/id #uuid "cdcd5ecf-e29d-52a6-8e4f-06c8bd373504" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-{x}^{3}{y}^{2}}{7{x}^{3}{y}^{2}+2y}" :db/id #edb/ref 17592186242992} {:answer/id #uuid "d32818a8-5eed-5b07-a7ac-495f052b994d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-{x}^{2}{y}^{3}}{{x}^{3}{y}^{2}+y}" :db/id #edb/ref 17592186243042}] :answer-field/correct {:answer/id #uuid "c5136acb-020b-505c-a4e7-1cfbfb2cc0de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8x-7{x}^{2}{y}^{3}}{7{x}^{3}{y}^{2}+2y}" :db/id #edb/ref 17592186242917} :answer-field/id #uuid "4934faa7-2c01-504f-90c9-b63344c5db8e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243577}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "82a0f4a1-b7fe-533e-9033-fcc9236329fd" :question/math-academy-id "q-108655" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $7{x}^{3}{y}^{3}+3{y}^{2}=12{x}^{2}.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\nNote that to differentiate the $7{x}^{3}{y}^{3}$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}7{x}^{3}{y}^{3}+3{y}^{2} & =12{x}^{2} \\\\ \\frac{\\text{d}}{\\text{d}x}(7{x}^{3}{y}^{3}+3{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(12{x}^{2}) \\\\ \\frac{\\text{d}}{\\text{d}x}(7{x}^{3}{y}^{3})+\\frac{\\text{d}}{\\text{d}x}(3{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(12{x}^{2}) \\\\ [21{x}^{3}{y}^{2}\\frac{\\text{d}y}{\\text{d}x}+21{x}^{2}{y}^{3}]+6y\\frac{\\text{d}y}{\\text{d}x} & =24x \\\\ 21{x}^{3}{y}^{2}\\frac{\\text{d}y}{\\text{d}x}+21{x}^{2}{y}^{3}+6y\\frac{\\text{d}y}{\\text{d}x} & =24x\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}21{x}^{3}{y}^{2}\\frac{\\text{d}y}{\\text{d}x}+6y\\frac{\\text{d}y}{\\text{d}x} & =24x-21{x}^{2}{y}^{3} \\\\ \\frac{\\text{d}y}{\\text{d}x}(21{x}^{3}{y}^{2}+6y) & =24x-21{x}^{2}{y}^{3} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{8x-7{x}^{2}{y}^{3}}{7{x}^{3}{y}^{2}+2y}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244152 :knowledge-point/_questions [{:db/id #edb/ref 17592186054846 :knowledge-point/id #uuid "2311a895-587e-5609-8a9f-9963b8cae372" :knowledge-point/title "Finding the Slope of the Tangent Line to a Curve Given in Implicit Form at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45ce074c-f5ee-5790-955f-744688452a51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186241807} {:answer/id #uuid "7e670689-9386-512c-80a1-9ffb0405857d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186242290} {:answer/id #uuid "a4fe8801-fc93-5cb1-b234-3374bb79395a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{4}" :db/id #edb/ref 17592186242633} {:answer/id #uuid "d4b24f33-d38a-5c21-a5c3-2817021cafc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186243063} {:answer/id #uuid "de835654-3bb0-5b6e-95d2-3def6a996d9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186243159}] :answer-field/correct {:answer/id #uuid "45ce074c-f5ee-5790-955f-744688452a51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186241807} :answer-field/id #uuid "504aa2d6-12d2-5a6b-8911-82cd37da7948" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243594}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ffb47def-243e-5613-87da-6b6ae8fdf163" :question/math-academy-id "q-108674" :question/problem "Find the slope of the tangent at the point $(\\frac{\\pi }{3},\\,2)$ for the curve $y\\operatorname{cos}⁡(x)=1.$" :question/worked-solution "To find the slope at a point, we use implicit differentiation to calculate the derivative of the curve, assuming that $y=y(x).$\n\nNote that to differentiate the $y\\operatorname{cos}⁡(x)$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(y\\operatorname{cos}⁡(x)) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ y\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cos}⁡(x))+\\operatorname{cos}⁡x\\frac{\\text{d}}{\\text{d}x}(y) & =0 \\\\ y(-\\operatorname{sin}⁡(x))+\\operatorname{cos}⁡(x)\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ \\operatorname{cos}⁡(x)\\frac{\\text{d}y}{\\text{d}x} & =y\\operatorname{sin}⁡(x) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{y\\operatorname{sin}⁡(x)}{\\operatorname{cos}⁡(x)}\\end{aligned}\n$$\n\nThe slope of the tangent at the point $(\\frac{\\pi }{3},\\,2)$ is then given by\n\n$$\n\\begin{aligned}m & ={(\\frac{\\text{d}y}{\\text{d}x})}_{(\\pi /3,\\,2)} \\\\  & ={(\\frac{y\\operatorname{sin}⁡(x)}{\\operatorname{cos}⁡(x)})}_{(\\pi /3,\\,2)} \\\\  & =\\frac{2\\cdot \\operatorname{sin}⁡(\\frac{\\pi }{3})}{\\operatorname{cos}⁡(\\frac{\\pi }{3})} \\\\  & =\\frac{2\\cdot (\\frac{\\sqrt{3}}{2})}{(\\frac{1}{2})} \\\\  & =2\\sqrt{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244153 :knowledge-point/_questions [{:db/id #edb/ref 17592186054846 :knowledge-point/id #uuid "2311a895-587e-5609-8a9f-9963b8cae372" :knowledge-point/title "Finding the Slope of the Tangent Line to a Curve Given in Implicit Form at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e607f78-385d-53f6-ab41-74ac877a5a71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186241591} {:answer/id #uuid "32897127-ad14-5eef-9a81-301deb3e2a1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186241624} {:answer/id #uuid "d18a655d-56b1-5123-a490-d7bf85825ed6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186243025} {:answer/id #uuid "dc7ba673-b558-5e38-9cf1-92dadf966d68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{2}" :db/id #edb/ref 17592186243142} {:answer/id #uuid "fd113b97-7abf-5d30-9cb0-076358176a03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186243411}] :answer-field/correct {:answer/id #uuid "32897127-ad14-5eef-9a81-301deb3e2a1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186241624} :answer-field/id #uuid "52dfb695-349e-5936-9fe3-1ad1eeda4511" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243598}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "85cec444-2f0a-598c-bff4-89c6e3584a08" :question/math-academy-id "q-108679" :question/problem "Find the slope of the tangent at the point $(4,\\,4)$ for the curve $\\sqrt{x}+\\sqrt{y}=4.$" :question/worked-solution "To find the slope at a point, we use implicit differentiation to calculate the derivative of the curve, assuming that $y=y(x).$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}+\\sqrt{y}) & =\\frac{\\text{d}}{\\text{d}x}(4) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{1/2}+{y}^{1/2}) & =\\frac{\\text{d}}{\\text{d}x}(4) \\\\ \\frac{1}{2}{x}^{-1/2}+\\frac{1}{2}{y}^{-1/2}(\\frac{\\text{d}y}{\\text{d}x}) & =0 \\\\ \\frac{1}{2}{y}^{-1/2}(\\frac{\\text{d}y}{\\text{d}x}) & =-\\frac{1}{2}{x}^{-1/2} \\\\ \\frac{1}{2\\sqrt{y}}(\\frac{\\text{d}y}{\\text{d}x}) & =-\\frac{1}{2\\sqrt{x}} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{\\sqrt{y}}{\\sqrt{x}}\\end{aligned}\n$$\n\nThe slope of the tangent at the point $(4,\\,4)$ is then given by\n\n$$\n\\begin{aligned}m & ={(\\frac{\\text{d}y}{\\text{d}x})}_{(4,\\,4)} \\\\  & =-{\\frac{\\sqrt{y}}{\\sqrt{x}}}_{(4,\\,4)} \\\\  & =-\\frac{\\sqrt{4}}{\\sqrt{4}} \\\\  & =-\\frac{2}{2} \\\\  & =-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186092507 :knowledge-point/_questions [{:db/id #edb/ref 17592186092385 :knowledge-point/id #uuid "3ba61258-92a9-511e-891f-9e6adce2edb0" :knowledge-point/title "Determining the Intercepts of a Normal Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17dbb435-0cbf-53b0-b774-95a09e5dd5e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,0)" :db/id #edb/ref 17592186241384} {:answer/id #uuid "52de3f96-3021-5e86-a521-dd5eaf2b4c3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,0)" :db/id #edb/ref 17592186241918} {:answer/id #uuid "7aaf9455-fc42-5674-a140-8638e322d2c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,0)" :db/id #edb/ref 17592186242258} {:answer/id #uuid "8b234896-b4c5-57ed-a626-2274af12bce9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(16,0)" :db/id #edb/ref 17592186242411} {:answer/id #uuid "aecf5e6b-c2d8-5faf-a09d-6ece73a85a07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{16}{5},0)" :db/id #edb/ref 17592186242704}] :answer-field/correct {:answer/id #uuid "8b234896-b4c5-57ed-a626-2274af12bce9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(16,0)" :db/id #edb/ref 17592186242411} :answer-field/id #uuid "562461af-5947-5911-b5fb-04453b8765df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243609}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a8debb9f-1a0f-5757-8884-2cca273ae3ea" :question/math-academy-id "q-10871" :question/problem "Find where the normal line to the curve $f(x)=2{x}^{2}+x$ at the point $(1,3)$ intersects the $x$-axis." :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{2}+x)=4x+1.\\end{aligned}\n$$\n\nSo the slope of the tangent line is\n\n$$\nm={f}^{′}(1)=4(1)+1=5,\n$$\n\nand therefore the slope of the normal line is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{5}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-3 & =-\\frac{1}{5}(x-1) \\\\ y & =-\\frac{1}{5}x+\\frac{1}{5}+3 \\\\ y & =-\\frac{1}{5}x+\\frac{16}{5}.\\end{aligned}\n$$\n\nLastly, we find the point of intersection with the $x$-axis by setting $y=0$ and solving the resulting equation. We get\n\n$$\n\\begin{aligned}-\\frac{1}{5}x+\\frac{16}{5} & =0 \\\\ x & =16.\\end{aligned}\n$$\n\nTherefore, the normal line intersects the $x$-axis at $(16,0).$"}] [{:db/id #edb/ref 17592186244174 :knowledge-point/_questions [{:db/id #edb/ref 17592186059677 :knowledge-point/id #uuid "89f65f58-bd3d-5c3f-b9e0-462d74d75b59" :knowledge-point/title "Computing Second Order Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0937fb22-de20-5285-adfe-fb134454e739" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24{x}^{2}-24" :db/id #edb/ref 17592186241260} {:answer/id #uuid "4ade996e-8565-5999-b8b9-37a0812a3215" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{{x}^{5}}}+10" :db/id #edb/ref 17592186241854} {:answer/id #uuid "890e01dc-717c-5668-ab27-67a47e021472" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{{x}^{3}}}+10" :db/id #edb/ref 17592186242385} {:answer/id #uuid "c17a783f-f9eb-533a-858b-97da81489721" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{{x}^{3}}}-10" :db/id #edb/ref 17592186242874} {:answer/id #uuid "e29f5fcc-b099-589c-9900-89b9765edee7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{{x}^{5}}}+10" :db/id #edb/ref 17592186243194}] :answer-field/correct {:answer/id #uuid "890e01dc-717c-5668-ab27-67a47e021472" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{{x}^{3}}}+10" :db/id #edb/ref 17592186242385} :answer-field/id #uuid "4cfdea00-47d2-5a4e-be1a-28b9c2503425" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243586}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2dffb4d9-bf1b-5b2c-8ebe-2cdd8aa443db" :question/math-academy-id "q-10883" :question/problem "Find ${f}^{″}(x)$ for $f(x)=4\\sqrt{x}+5{x}^{2}+x.$" :question/worked-solution "Computing the first derivative, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={(4\\sqrt{x}+5{x}^{2}+x)}^{′} \\\\  & ={(4{x}^{1/2}+5{x}^{2}+x)}^{′} \\\\  & =\\frac{1}{2}\\cdot 4{x}^{-1/2}+2\\cdot 5x+1 \\\\  & =2{x}^{-1/2}+10x+1\\,.\\end{aligned}\n$$\n\nComputing the second derivative, we have\n\n$$\n\\begin{aligned}{f}^{″}(x) & ={(2{x}^{-1/2}+10x+1)}^{′} \\\\  & =-\\frac{1}{2}\\cdot 2{x}^{-3/2}+10+0 \\\\  & =-{x}^{-3/2}+10 \\\\  & =-\\frac{1}{\\sqrt{{x}^{3}}}+10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244185 :knowledge-point/_questions [{:db/id #edb/ref 17592186078435 :knowledge-point/id #uuid "822ee6ad-d15c-518d-b798-1aa2ba84ca20" :knowledge-point/title "Calculating the Number of Terms in an Arithmetic Series Using the Formula for the Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1668a5c1-ce44-5253-9139-e2bc63105e14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186241372} {:answer/id #uuid "5468b1e4-3930-510e-8909-679f6a1139f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186241936} {:answer/id #uuid "546b5cb9-810b-5bb5-9685-ffb7dfce18df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186241937} {:answer/id #uuid "65b96f90-dbd8-59bf-b55b-5cc8a7dd21d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186242095} {:answer/id #uuid "ae907482-607f-575e-93b2-831b50732e9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186242702}] :answer-field/correct {:answer/id #uuid "546b5cb9-810b-5bb5-9685-ffb7dfce18df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186241937} :answer-field/id #uuid "09cccd67-65bb-5607-8ef3-8e4c5b24e99e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243455}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "800f0768-2cd2-5060-956e-d2760762a123" :question/math-academy-id "q-108898" :question/problem "The first term of an arithmetic series is ${a}_{1}=1,$ the common difference is $d=\\frac{1}{2},$ and the sum of the series is ${S}_{N}=52.$ Find the number of terms $N$ in the series." :question/worked-solution "To find the number of terms, we can use the following formula:\n\n$$\n{S}_{N}=\\frac{N}{2}(2{a}_{1}+(N-1)d).\n$$\n\nWe substitute ${a}_{1}=1,$ $d=\\frac{1}{2}$ and ${S}_{N}=52$ into the above and solve for $N$, as follows: \n\n$$\n\\begin{aligned}{S}_{N} & =\\frac{N}{2}(2{a}_{1}+(N-1)d) \\\\ 52 & =\\frac{N}{2}(2\\cdot 1+(N-1)\\cdot \\frac{1}{2}) \\\\ 104 & =N(2+\\frac{N}{2}-\\frac{1}{2}) \\\\ 104 & =\\frac{{N}^{2}}{2}+\\frac{3}{2}N \\\\ {N}^{2}+3N-208 & =0\\end{aligned}\n$$\n\nFor the equation above, the quadratic formula gives:\n\n$$\n\\begin{aligned}N & =\\frac{-3\\pm \\sqrt{{3}^{2}-4\\cdot 1\\cdot (-208)}}{2\\cdot 1} \\\\  & =\\frac{-3\\pm \\sqrt{841}}{2} \\\\  & =\\frac{-3\\pm 29}{2}\\end{aligned}\n$$\n\nHence, $N=13$ or $N=-16.$ We disregard the negative solution since $N$ must be positive.\n\nTherefore, our series has $N=13$ terms."}] [{:db/id #edb/ref 17592186244188 :knowledge-point/_questions [{:db/id #edb/ref 17592186078433 :knowledge-point/id #uuid "df6ae15d-7005-5a93-9432-c4814dc9573d" :knowledge-point/title "Calculating the Number of Terms in an Arithmetic Series Given the Pattern and the Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "228cbcd7-75c6-5292-a55c-93495c591c0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186241479} {:answer/id #uuid "4f72d840-529f-50af-ade3-ec1d004f9f53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186241891} {:answer/id #uuid "8878cc45-2b72-502b-9a3f-1b66b0697af3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "47" :db/id #edb/ref 17592186242379} {:answer/id #uuid "bd5b32da-40f4-5880-b27d-cb00a128a752" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "61" :db/id #edb/ref 17592186242844} {:answer/id #uuid "c11d598f-1556-5751-8870-5240c9000b4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "33" :db/id #edb/ref 17592186242872}] :answer-field/correct {:answer/id #uuid "228cbcd7-75c6-5292-a55c-93495c591c0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186241479} :answer-field/id #uuid "d0127a7b-9cd6-56c9-8f52-6f4a37eb6257" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243805}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "631970bc-7173-5c6f-8c08-2b5a8924de2b" :question/math-academy-id "q-108904" :question/problem "Calculate the number of terms in the following arithmetic series.\n\n$$\n2+2.5+3+…=470\n$$" :question/worked-solution "To solve this problem, we use the formula for the sum of an arithmetic series:\n\n$$\n{S}_{N}=\\frac{N}{2}(2{a}_{1}+(N-1)d)\\,\\,\n$$\n\nWe have been given the sum ${S}_{N}=470,$ and the first term ${a}_{1}=2.$ Our goal is to find $N,$ the number of terms.\n\nThe common difference $d$ can be found, as follows:\n\n$$\n\\begin{aligned}d & ={a}_{2}-{a}_{1} \\\\  & =2.5-2 \\\\  & =0.5\\end{aligned}\n$$\n\nSubstituting these values into the formula for the sum of an arithmetic series, we have:\n\n$$\n\\begin{aligned}{S}_{N} & =\\frac{N}{2}(2{a}_{1}+(N-1)d) \\\\ 470 & =\\frac{N}{2}(2(2)+(N-1)(0.5)) \\\\ 940 & =N(4+0.5N-0.5) \\\\ 940 & =N(0.5N+3.5) \\\\ 940 & =0.5{N}^{2}+3.5N \\\\ 0.5{N}^{2}+3.5N-940 & =0 \\\\ {N}^{2}+7N-1\\,880 & =0\\end{aligned}\n$$\n\nFor the equation above, the quadratic formula gives:\n\n$$\n\\begin{aligned}N & =\\frac{-7\\pm \\sqrt{(-7)^{2}-4\\cdot 1\\cdot (-1\\,880)}}{2\\cdot 1} \\\\  & =\\frac{-7\\pm \\sqrt{7\\,569}}{2} \\\\  & =\\frac{-7\\pm 87}{2}\\end{aligned}\n$$\n\nHence, $N=40$ or $N=-47.$ We disregard the negative solution since $N$ must be positive.\n\nTherefore, our series has $N=40$ terms."}] [{:db/id #edb/ref 17592186244189 :knowledge-point/_questions [{:db/id #edb/ref 17592186078433 :knowledge-point/id #uuid "df6ae15d-7005-5a93-9432-c4814dc9573d" :knowledge-point/title "Calculating the Number of Terms in an Arithmetic Series Given the Pattern and the Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "013d478a-2bd3-5798-8338-0e32d6fc42b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "33" :db/id #edb/ref 17592186241196} {:answer/id #uuid "213c9b25-cb52-5676-8b08-9ff3cce2d50f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186241469} {:answer/id #uuid "221e3409-9671-5de1-adfd-97e648a9c7c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186241475} {:answer/id #uuid "9acd73ec-5e34-5bb9-9a05-3e8721780f7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186242535} {:answer/id #uuid "a183e495-f8f4-5f03-9c9b-cb73ad190e8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186242592}] :answer-field/correct {:answer/id #uuid "a183e495-f8f4-5f03-9c9b-cb73ad190e8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186242592} :answer-field/id #uuid "21df0410-20ea-582c-95cd-a8b92ed7636a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243502}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a6487f23-2be0-5df1-92f0-34bd73e7850d" :question/math-academy-id "q-108909" :question/problem "Calculate the number of terms in the following arithmetic series. \n\n$$\n4.2+4.7+5.2+...=139.4\n$$" :question/worked-solution "To solve this problem, we use the formula for the sum of an arithmetic series:\n\n$$\n{S}_{N}=\\frac{N}{2}(2{a}_{1}+(N-1)d)\n$$\n\nWe have been given the sum ${S}_{N}=139.4,$ and the first term ${a}_{1}=4.2.$ Our goal is to find $N,$ the number of terms.\n\nThe common difference $d$ can be found, as follows:\n\n$$\n\\begin{aligned}d & ={a}_{2}-{a}_{1} \\\\  & =4.7-4.2 \\\\  & =0.5\\end{aligned}\n$$\n\nSubstituting into the formula for ${S}_{N}$ gives\n\n$$\n\\begin{aligned}{S}_{N} & =\\frac{N}{2}(2{a}_{1}+(N-1)d) \\\\ 139.4 & =\\frac{N}{2}(2(4.2)+(N-1)(0.5)) \\\\ 278.8 & =N(8.4+0.5N-0.5) \\\\ 278.8 & =N(7.9+0.5N) \\\\ 278.8 & =7.9N+0.5{N}^{2} \\\\ 0.5{N}^{2}+7.9N-278.8 & =0\\end{aligned}\n$$\n\nFor the equation above, the quadratic formula gives:\n\n$$\n\\begin{aligned}N & =\\frac{-7.9\\pm \\sqrt{(-7.9)^{2}-4\\cdot 0.5\\cdot (-278.8)}}{2\\cdot 0.5} \\\\  & =\\frac{-7.9\\pm 24.9}{1}\\end{aligned}\n$$\n\nHence, $N=17$ or $N=-32.8.$ We disregard the negative solution since $N$ must be positive and integer.\n\nTherefore, our series has $N=17$ terms."}] [{:db/id #edb/ref 17592186244197 :knowledge-point/_questions [{:db/id #edb/ref 17592186078434 :knowledge-point/id #uuid "5b23f178-4161-56d3-98e0-00b3181417e2" :knowledge-point/title "Calculating the Number of Terms in an Arithmetic Series Given Two Terms and the Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "378d2847-7ad2-5a12-9850-47b25579a9f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186241671} {:answer/id #uuid "42646d11-10a8-5a63-8da2-3a558121ded2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186241776} {:answer/id #uuid "57f3b6ea-0be7-58bf-91c2-5ab29f5e24c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186241976} {:answer/id #uuid "d84297cb-155e-5323-b0ab-48e29cf60eb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186243103} {:answer/id #uuid "d8adbf92-d80c-56ae-b029-da2918a6c9de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186243106}] :answer-field/correct {:answer/id #uuid "d8adbf92-d80c-56ae-b029-da2918a6c9de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186243106} :answer-field/id #uuid "67ee6136-7c75-5b1b-bb3a-e9d5e1c03e2e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243643}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ee6eaf1a-ba17-5552-a200-48d6ea0ebb7b" :question/math-academy-id "q-108928" :question/problem "An arithmetic series has the first term ${a}_{1}=-3,$ the second term is ${a}_{2}=0,$ and the sum of the series is ${S}_{N}=27.$ Find the number of terms $N$ in the series." :question/worked-solution "To solve this problem, we use the formula for the sum of an arithmetic series.\n\n$$\n{S}_{N}=\\frac{N}{2}(2{a}_{1}+(N-1)d)\n$$\n\nSince we know the first two terms of the arithmetic series, we can find its common difference, as follows:\n\n$$\n\\begin{aligned}d & ={a}_{2}-{a}_{1}=3\\end{aligned}\n$$\n\nNow, substituting ${a}_{1}=-3,$ $d=3,$ and ${S}_{N}=27$ into the formula for the sum of an arithmetic series, we have:\n\n$$\n\\begin{aligned}{S}_{N} & =\\frac{N}{2}(2{a}_{1}+(N-1)d) \\\\ 27 & =\\frac{N}{2}(2(-3)+(N-1)(3)) \\\\ 54 & =N(-6+3N-3) \\\\ 54 & =N(3N-9) \\\\ 54 & =3{N}^{2}-9N\\end{aligned}\n$$\n\nFactoring the above equation gives:\n\n$$\n\\begin{aligned}3{N}^{2}-9N-54 & =0 \\\\ {N}^{2}-3N-18 & =0 \\\\ (N-6)(N+3) & =0 \\\\ N & =6\\end{aligned}\n$$\n\nNotice that we take the positive solution because $N$ can't be negative."}] [{:db/id #edb/ref 17592186162265 :knowledge-point/_questions [{:db/id #edb/ref 17592186162058 :knowledge-point/id #uuid "85388f7d-b2ee-520b-b711-a7721c6f620c" :knowledge-point/title "Computing the Variance of a Transformed Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81112c49-d7fa-55a9-946c-978c6c3212eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "139" :db/id #edb/ref 17592186158793} {:answer/id #uuid "8de51e22-8258-5379-944d-6cb851e7e860" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186158794} {:answer/id #uuid "f163dc54-51b6-5751-8e17-08f55b22091f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "131" :db/id #edb/ref 17592186158795} {:answer/id #uuid "2ca27abd-9a2f-53ad-a3b3-9d3f3cde1f41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186158796} {:answer/id #uuid "4b974675-408a-596f-8ca9-a1850668c726" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "128" :db/id #edb/ref 17592186158797}] :answer-field/id #uuid "6dccd697-7f86-52a5-8fd7-5f0b81534171" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186158792} {:answer-field/choices [{:answer/id #uuid "20456ca3-2576-5d3b-b0b7-bfae85c3a126" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "139" :db/id #edb/ref 17592186369031} {:answer/id #uuid "e1367430-79a3-57af-af35-e2aa921c1809" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "128" :db/id #edb/ref 17592186369032} {:answer/id #uuid "0276b1bd-ad2b-5abb-be75-93d07e392a47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186369033} {:answer/id #uuid "0d48b444-fd58-504f-8a6d-c7488ed2823a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "131" :db/id #edb/ref 17592186369034} {:answer/id #uuid "5313dab0-94a0-5482-8e37-9cb5b552e8f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186369035}] :answer-field/correct {:answer/id #uuid "e1367430-79a3-57af-af35-e2aa921c1809" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "128" :db/id #edb/ref 17592186369032} :answer-field/id #uuid "b2c164d4-a2e3-5420-877a-25744a548c7e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369030}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9acf412d-3c51-5e59-8e90-cbe1dabb790a" :question/math-academy-id "q-108940" :question/problem "If $\\text{Var}[X]=8,$ calculate $\\text{Var}[4X+3].$" :question/requires-calculator true :question/worked-solution "Recall that for any random variable $X$ and constants $a$ and $b,$ we have\n\n$$\n\\text{Var}[aX+b]={a}^{2}\\cdot \\text{Var}[X].\n$$\n\nIn our case, $a=4$ and $b=3.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[4X+3] & ={4}^{2}\\cdot \\text{Var}[X] \\\\  & =16\\cdot 8 \\\\  & =128.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386329 :knowledge-point/_questions [{:db/id #edb/ref 17592186064369 :knowledge-point/id #uuid "81d5fa54-0b80-52c1-97d7-6f8fb231f692" :knowledge-point/title "Calculating the Velocity of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ba0f630-2f65-5ebb-9ef9-7e215b9a8e6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(t)=\\frac{t+1}{({t}^{2}+1)^{2}}" :db/id #edb/ref 17592186386331} {:answer/id #uuid "f67a34cc-bdd7-5109-9e49-3aa73823a730" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(t)=\\frac{t+2}{{t}^{2}+1}" :db/id #edb/ref 17592186386332} {:answer/id #uuid "c13cdfa8-c254-5851-9c01-b69045d39098" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(t)=\\frac{2{t}^{2}}{{t}^{2}+1}" :db/id #edb/ref 17592186386333} {:answer/id #uuid "fb33e651-cb52-5f09-b8c1-872e7acf356e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(t)=\\frac{2t}{({t}^{2}+1)^{2}}" :db/id #edb/ref 17592186386334} {:answer/id #uuid "c61cc750-e5d1-5559-b9f2-17126e07ceef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(t)=\\frac{2}{{t}^{2}+1}" :db/id #edb/ref 17592186386335}] :answer-field/correct {:answer/id #uuid "fb33e651-cb52-5f09-b8c1-872e7acf356e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(t)=\\frac{2t}{({t}^{2}+1)^{2}}" :db/id #edb/ref 17592186386334} :answer-field/id #uuid "3e7b11db-5579-5d23-8dd0-1d60abf80b79" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386330}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "68190923-09f1-522b-b256-54bea9ce1f9c" :question/math-academy-id "q-109000" :question/problem "The position $x$ of a particle at time $t$ is given by $x(t)=\\frac{{t}^{2}}{{t}^{2}+1}.$ Calculate the velocity at time $t.$" :question/worked-solution "The velocity is the derivative of the position function $x(t)$ with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}x}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{{t}^{2}}{{t}^{2}+1}) \\\\  & =\\frac{2t({t}^{2}+1)-{t}^{2}(2t)}{({t}^{2}+1)^{2}} \\\\  & =\\frac{2{t}^{3}+2t-2{t}^{3}}{({t}^{2}+1)^{2}} \\\\  & =\\frac{2t}{({t}^{2}+1)^{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386336 :knowledge-point/_questions [{:db/id #edb/ref 17592186064371 :knowledge-point/id #uuid "45b380ed-1974-5876-8c88-a45773741b48" :knowledge-point/title "Calculating the Speed of a Particle at a Particular Moment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ad1c91f-8f94-5d43-a015-0df4347e3b34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\text{miles/h}" :db/id #edb/ref 17592186386338} {:answer/id #uuid "310152fb-5481-5acf-b0d8-91619d3b8169" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\,\\text{miles/h}" :db/id #edb/ref 17592186386339} {:answer/id #uuid "adcedacc-6f21-533a-91b1-d246d25b6c18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\,\\text{miles/h}" :db/id #edb/ref 17592186386340} {:answer/id #uuid "a069c0c1-7f30-50e9-827f-c04f4b7ee402" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}\\,\\text{miles/h}" :db/id #edb/ref 17592186386341} {:answer/id #uuid "ea1abc4d-2e9f-52d6-8953-d8678f00178e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,\\text{miles/h}" :db/id #edb/ref 17592186386342}] :answer-field/correct {:answer/id #uuid "310152fb-5481-5acf-b0d8-91619d3b8169" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\,\\text{miles/h}" :db/id #edb/ref 17592186386339} :answer-field/id #uuid "2ab55df5-5342-5b9d-ac07-93197546e743" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386337}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d585be43-c802-5898-9f5b-2c2fe6d06f55" :question/math-academy-id "q-109012" :question/problem "The position $s(t)$ of a particle (in miles) at time $t$ hours is given by \n\n$$\ns(t)=\\frac{3}{t},\\,t>0.\n$$\n\nCalculate the speed of the particle when $t=3\\,\\text{h}.$" :question/worked-solution "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{3}{t}) \\\\  & =-\\frac{3}{{t}^{2}}\\end{aligned}\n$$\n\nWhen $t=3,$ the velocity is\n\n$$\nv(3)=-\\frac{3}{{3}^{2}}=-\\frac{1}{3}.\n$$\n\nTherefore, the speed is $|-\\frac{1}{3}|=\\frac{1}{3}\\,\\text{miles/h}.$"}] [{:db/id #edb/ref 17592186059986 :knowledge-point/_questions [{:db/id #edb/ref 17592186059678 :knowledge-point/id #uuid "6afb4058-908a-5983-9c1e-78ee3fbadf44" :knowledge-point/title "Computing Second Order Derivatives Using Leibnitz Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23efc5ef-2690-54f2-bee2-55957c887e24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60{x}^{2}+12" :db/id #edb/ref 17592186241494} {:answer/id #uuid "540b13bd-f4ff-5df5-a485-37254ae4135c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60{x}^{2}+8" :db/id #edb/ref 17592186241934} {:answer/id #uuid "864b257c-04a1-57df-ba29-1fda8aa650a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60{x}^{2}+8x" :db/id #edb/ref 17592186242356} {:answer/id #uuid "c9c4addb-f175-5120-8653-b40175f4b448" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30{x}^{2}+8" :db/id #edb/ref 17592186242960} {:answer/id #uuid "cd2989ae-1b63-5358-ae2f-b0968d4a0f14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60{x}^{3}+8" :db/id #edb/ref 17592186242985}] :answer-field/correct {:answer/id #uuid "540b13bd-f4ff-5df5-a485-37254ae4135c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60{x}^{2}+8" :db/id #edb/ref 17592186241934} :answer-field/id #uuid "17955a33-082e-5b39-af43-2edeaac25d20" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243479}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b7a8a2be-ff9a-5f4a-96bd-e383a3bb4443" :question/math-academy-id "q-10903" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y=5{x}^{4}+4{x}^{2}.$" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(5{x}^{4}+4{x}^{2}) \\\\  & =4\\cdot 5{x}^{3}+2\\cdot 4x \\\\  & =20{x}^{3}+8x\\,.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(20{x}^{3}+8x) \\\\  & =3\\cdot 20{x}^{2}+8 \\\\  & =60{x}^{2}+8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186369050 :knowledge-point/_questions [{:db/id #edb/ref 17592186162056 :knowledge-point/id #uuid "405984cd-1e1b-54c6-bc75-268e127b9812" :knowledge-point/title "Computing the Variance of a Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d79f1952-bf8a-52b1-872a-a76dbce24aee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({c}^{4}-4c)^{2}" :db/id #edb/ref 17592186369052} {:answer/id #uuid "839570a9-1ebc-55fb-8dd6-1a97d1617488" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186369053} {:answer/id #uuid "f18d9f23-0bbd-5f18-882c-50fb5339764e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186369054} {:answer/id #uuid "62512e18-69cb-57de-9a9b-3c334bf9d2ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{c}^{4}-4c" :db/id #edb/ref 17592186369055} {:answer/id #uuid "a6df3166-e673-5bd3-8ed1-b5c079ab4d46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186369056}] :answer-field/correct {:answer/id #uuid "a6df3166-e673-5bd3-8ed1-b5c079ab4d46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186369056} :answer-field/id #uuid "bf24bd6c-13e2-5fdc-8cf1-7567436c4487" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369051}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2b36ffa1-c285-5323-8976-54860cfaba66" :question/math-academy-id "q-109048" :question/problem "Calculate $\\text{Var}[{c}^{4}-4c]$ where $c$ is a constant." :question/worked-solution "Recall that for any constant $a,$ we have\n\n$$\n\\text{Var}[a]=0.\n$$\n\nTherefore, since $c$ is a constant, we have\n\n$$\n\\text{Var}[{c}^{4}-4c]=0.\n$$"}] [{:db/id #edb/ref 17592186369057 :knowledge-point/_questions [{:db/id #edb/ref 17592186162056 :knowledge-point/id #uuid "405984cd-1e1b-54c6-bc75-268e127b9812" :knowledge-point/title "Computing the Variance of a Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35fc10d6-8e43-59a3-8656-378a890dce76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186369059} {:answer/id #uuid "506f0b67-07d9-5eb9-8374-224d1159067e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186369060} {:answer/id #uuid "d6732677-9335-5d18-95ea-d12aa2c4ea7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186369061} {:answer/id #uuid "251d2080-4bf0-5d44-8518-a06fec0c6738" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186369062} {:answer/id #uuid "237f5dc5-b2f1-5a3f-b35c-5cecea03548c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{25}" :db/id #edb/ref 17592186369063}] :answer-field/correct {:answer/id #uuid "d6732677-