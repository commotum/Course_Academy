r/id #uuid "8970fd7b-4bde-51ef-8375-2b3301cc513f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186380536} :answer-field/id #uuid "4bf77f7d-53e1-5ad0-8737-7665a358011a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186380532}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a883d5ae-1a08-5ef1-891f-fbc577bb18db" :question/math-academy-id "q-109084" :question/problem "If $\\text{Var}[X]=2,$ calculate $\\text{Var}[\\sqrt{3}X-5].$" :question/worked-solution "Recall that for any random variable $X$ and constants $a$ and $b,$ we have\n\n$$\n\\text{Var}[aX+b]={a}^{2}\\cdot \\text{Var}[X].\n$$\n\nIn our case, $a=\\sqrt{3}$ and $b=-5.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[\\sqrt{3}X-5] & ={(\\sqrt{3})}^{2}\\cdot \\text{Var}[X] \\\\  & =3\\cdot 2 \\\\  & =6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244227 :knowledge-point/_questions [{:db/id #edb/ref 17592186162058 :knowledge-point/id #uuid "85388f7d-b2ee-520b-b711-a7721c6f620c" :knowledge-point/title "Computing the Variance of a Transformed Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "643b59ab-e862-5975-86dd-7355eed4cca6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186242081} {:answer/id #uuid "6e1ac25e-ba63-509b-9370-23e96efe4ebd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{5}}{5}" :db/id #edb/ref 17592186242163} {:answer/id #uuid "bac7e8e7-11c4-554e-b61e-02f375d7783a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186242819} {:answer/id #uuid "dc315568-edd6-5abe-b917-d1c33d5e4173" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{5}}{5}+4" :db/id #edb/ref 17592186243136} {:answer/id #uuid "e1fe8786-4596-56fa-ad58-012b52d63167" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186243186}] :answer-field/correct {:answer/id #uuid "e1fe8786-4596-56fa-ad58-012b52d63167" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186243186} :answer-field/id #uuid "718f5cfd-3b86-5662-9124-8b1ae998dc61" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243660}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7bc237e8-7011-5d1b-897c-e565fd160016" :question/math-academy-id "q-109090" :question/problem "The probability distribution of the random variable $X$ is given below. Given that $\\text{E}[X]=0,$ calculate $\\text{Var}[\\sqrt{5}X+4].$ \n\n| $x$ | $-1$ | $0$ | $1$ |\n| --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{5}$ | $\\frac{3}{5}$ | $\\frac{1}{5}$ |" :question/worked-solution "Recall that for any random variable $X$ and constants $a$ and $b,$ we have\n\n$$\n\\text{Var}[aX+b]={a}^{2}\\cdot \\text{Var}[X].\n$$\n\nIn our case, $a=\\sqrt{5}$ and $b=4.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[\\sqrt{5}X+4] & ={(\\sqrt{5})}^{2}\\cdot \\text{Var}[X] \\\\  & =5\\cdot \\text{Var}[X].\\end{aligned}\n$$\n\nWe can compute the variance of $X$ using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\nAdditionally, we're given that $\\text{E}[X]=0.$ \n\nWe start by computing $\\text{E}[{X}^{2}].$ Summing up the products of each value of ${X}^{2}$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & =(-1)^{2}\\cdot f(-1)+{0}^{2}\\cdot f(0)+{1}^{2}\\cdot f(1) \\\\  & =\\frac{1}{5}+\\frac{1}{5} \\\\  & =\\frac{2}{5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{2}{5}-{0}^{2} \\\\  & =\\frac{2}{5}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[\\sqrt{5}X+4] & =5\\cdot \\text{Var}[X] \\\\  & =5\\cdot \\frac{2}{5} \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244228 :knowledge-point/_questions [{:db/id #edb/ref 17592186059751 :knowledge-point/id #uuid "2e1b4442-eca7-5283-9d5d-5bcbd1d67975" :knowledge-point/title "Calculating a Minor in a 3x3 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45a5c220-8bb4-5d90-96d5-a3289aaa3fe5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-33" :db/id #edb/ref 17592186241806} {:answer/id #uuid "723b864a-b21a-5740-935e-36c4d2fd1371" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186242192} {:answer/id #uuid "84760970-9daa-5581-a617-c92ddc0d5e96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186242339} {:answer/id #uuid "b1078590-db32-5bf5-a0d2-0868f68eb185" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "77" :db/id #edb/ref 17592186242721} {:answer/id #uuid "e3c626cd-177c-5211-a76a-27d448efdb4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "82" :db/id #edb/ref 17592186243209}] :answer-field/correct {:answer/id #uuid "45a5c220-8bb4-5d90-96d5-a3289aaa3fe5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-33" :db/id #edb/ref 17592186241806} :answer-field/id #uuid "f7e9dd1b-0004-5244-841f-6b5ebc608972" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243871}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e8368bac-9938-5997-ba50-764e8ba7ddb9" :question/math-academy-id "q-1091" :question/problem "Calculate the minor of the entry ${x}_{21}$ in the matrix\n$X=[\\begin{aligned}9 & -3 & 0 \\\\ -2 & 8 & 6 \\\\ -1 & 0 & 11\\end{aligned}].$" :question/worked-solution "The minor of ${x}_{21}=-2$ (second row, first column) is the determinant of the remaining entries when the column and row containing $-2$ are removed: \n\n$$\nX=[\\begin{aligned}∗ & -3 & 0 \\\\ -2 & ∗ & ∗ \\\\ ∗ & 0 & 11\\end{aligned}]\n$$\n\nSo, the minor of ${x}_{21}=-2$ is\n\n$$\n\\begin{aligned}\\text{det}[\\begin{aligned}-3 & 0 \\\\ 0 & 11\\end{aligned}] & =|\\begin{aligned}-3 & 0 \\\\ 0 & 11\\end{aligned}| \\\\  & =-3\\cdot 11-0\\cdot 0 \\\\  & =-33-0 \\\\  & =-33.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244250 :knowledge-point/_questions [{:db/id #edb/ref 17592186059751 :knowledge-point/id #uuid "2e1b4442-eca7-5283-9d5d-5bcbd1d67975" :knowledge-point/title "Calculating a Minor in a 3x3 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a9ee733-0369-5383-98cf-d57199634ade" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186241275} {:answer/id #uuid "40bf570b-0c28-5b93-a302-1dc3fb653a1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186241758} {:answer/id #uuid "7d689186-2be7-5416-bc98-d1d5fe22acb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186242279} {:answer/id #uuid "942ccf7d-5d78-5f28-9073-6d9a3b731eee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-42" :db/id #edb/ref 17592186242480} {:answer/id #uuid "abbf1cc6-5ea9-587f-9f60-4f1101db2fc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186242680}] :answer-field/correct {:answer/id #uuid "7d689186-2be7-5416-bc98-d1d5fe22acb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186242279} :answer-field/id #uuid "783ab98e-8260-54c9-b8b7-0c860e9b9a51" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243670}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "926e7b3c-e48b-52a2-9640-544759dee372" :question/math-academy-id "q-1092" :question/problem "Calculate the minor of the entry ${b}_{22}$ in the matrix\n$B=[\\begin{aligned}3 & 13 & -6 \\\\ 2 & 7 & 0 \\\\ 5 & 0 & 4\\end{aligned}].$" :question/worked-solution "The minor of ${b}_{22}=7$ (second row, second column) is the determinant of the remaining entries when the column and row containing $7$ are removed: \n\n$$\nB=[\\begin{aligned}3 & ∗ & -6 \\\\ ∗ & 7 & ∗ \\\\ 5 & ∗ & 4\\end{aligned}]\n$$\n\n \n\nSo, the minor of ${b}_{22}=7$ is\n\n$$\n\\begin{aligned}\\text{det}[\\begin{aligned}3 & -6 \\\\ 5 & 4\\end{aligned}] & =|\\begin{aligned}3 & -6 \\\\ 5 & 4\\end{aligned}| \\\\  & =3\\cdot 4-(-6)\\cdot 5 \\\\  & =12-(-30) \\\\  & =42.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186366896 :knowledge-point/_questions [{:db/id #edb/ref 17592186157302 :knowledge-point/id #uuid "866ac63c-b20a-55fd-a1b5-29400355f195" :knowledge-point/title "Computing the Expected Value of a Scaled Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68807861-fff0-5b83-9ea7-9978b824f710" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3.75" :db/id #edb/ref 17592186366898} {:answer/id #uuid "52742c0c-6d61-5fcc-b2d3-dff26ad9f55b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.65" :db/id #edb/ref 17592186366899} {:answer/id #uuid "5aa46547-4955-5b06-ac6d-c59a58be1288" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3.25" :db/id #edb/ref 17592186366900} {:answer/id #uuid "3903faec-1a02-573d-af20-050fd40ae60b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3.5" :db/id #edb/ref 17592186366901} {:answer/id #uuid "0965c5a5-ed0c-5e17-8cf2-bca26a760487" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.55" :db/id #edb/ref 17592186366902}] :answer-field/correct {:answer/id #uuid "3903faec-1a02-573d-af20-050fd40ae60b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3.5" :db/id #edb/ref 17592186366901} :answer-field/id #uuid "d55542c2-675e-5cf6-b6c2-4465657debbb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366897}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f88e2ecd-00fb-5a62-8cc9-1ae40ef74834" :question/math-academy-id "q-109221" :question/problem "A random variable $X$ has the probability distribution given below.\n\n| $x$ | $0$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $0.35$ | $0.15$ | $0.15$ | $0.1$ | $0.25$ |\n\nCalculate $\\text{E}[-2X].$" :question/worked-solution "First, let's find $\\text{E}[X].$ \n\nThe expected value of a discrete random variable $X$ with probability mass function $f(x)$ and sample space $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nSumming up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\sum }_{x\\in S}x\\cdot f(x) \\\\  & =0\\cdot 0.35+1\\cdot 0.15+2\\cdot 0.15+3\\cdot 0.1+4\\cdot 0.25 \\\\  & =1.75.\\end{aligned}\n$$\n\nHence, we have \n\n$$\n\\begin{aligned}\\text{E}[-2X] & =-2\\text{E}[X] \\\\  & =-2\\cdot 1.75 \\\\  & =-3.5.\\end{aligned}\n$$"}] [{:db/