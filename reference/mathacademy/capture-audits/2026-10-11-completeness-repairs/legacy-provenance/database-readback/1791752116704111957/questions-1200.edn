:db/id #edb/ref 17592186119784 :knowledge-point/id #uuid "e69a4aee-6e92-598b-99b5-1d830b6dea54" :knowledge-point/title "Identifying Correct Statements About a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12389f18-052b-519d-9a2a-b2d04cff0ce4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186266299} {:answer/id #uuid "522bdf1e-83a7-5e64-a119-0ea3f50e57df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186266877} {:answer/id #uuid "86da3a70-ff02-5856-bfe6-bfd52e0aa79a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186267335} {:answer/id #uuid "8a4628c9-3834-5295-8683-2196b83efb01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186267376} {:answer/id #uuid "9368856a-1f6b-5077-95c9-62f7f1fdb0de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186267464}] :answer-field/correct {:answer/id #uuid "522bdf1e-83a7-5e64-a119-0ea3f50e57df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186266877} :answer-field/id #uuid "c7383b10-7ab3-525c-8800-3eda85c0e909" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268763}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ccdf19a6-45a3-5b56-b00e-b00d25e501ba" :question/math-academy-id "q-13771" :question/problem "Consider the matrix \n$A=[\\begin{aligned}8 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 3\\end{aligned}].$\nWhich of the following statements are true?\n\n- $A$ is upper triangular\n- $A$ is lower triangular\n- ${A}^{T}+A$ is lower triangular" :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is true, since all the entries below the main diagonal are zeros:\n\n$$\nA=[\\begin{aligned}8 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 3\\end{aligned}]\n$$\n\n- Statement II is true, since all the entries above the main diagonal are zeros:\n\n$$\nA=[\\begin{aligned}8 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 3\\end{aligned}]\n$$\n\n- Statement III is true, since the result of $A+{A}^{T}$ has all the entries above the main diagonal equal to zero: \n\n$$\n{A}^{T}+A=[\\begin{aligned}16 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 6\\end{aligned}]\n$$\n\nTherefore, the correct answer is \"I, II, and III\"."}] [{:db/id #edb/ref 17592186269150 :knowledge-point/_questions [{:db/id #edb/ref 17592186096655 :knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e" :knowledge-point/title "Integrating the Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fbe1e45-425c-5d24-9a2e-b0d2bc2b4422" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{100}{9}" :db/id #edb/ref 17592186266423} {:answer/id #uuid "222530ab-2dcc-5d51-9809-57c96320b41e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{100}{81}" :db/id #edb/ref 17592186266449} {:answer/id #uuid "5f41e2cc-d2de-56ef-80d2-9ac7568a671c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10}{27}" :db/id #edb/ref 17592186266986} {:answer/id #uuid "7daa41e8-6e90-5e70-8402-bd9770caa41f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{80}{9}" :db/id #edb/ref 17592186267255} {:answer/id #uuid "a3c299e5-a721-5088-944a-c9d0c0bc8ecf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{40}{81}" :db/id #edb/ref 17592186267617}] :answer-field/correct {:answer/id #uuid "222530ab-2dcc-5d51-9809-57c96320b41e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{100}{81}" :db/id #edb/ref 17592186266449} :answer-field/id #uuid "a01b2373-b791-524c-ae21-c98d1b57c90b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268689}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6e36897b-696c-54c5-85d9-3c04b5f56902" :question/math-academy-id "q-13786" :question/problem "${\\int }_{0}^{\\operatorname{ln}⁡3}5{e}^{-4x}\\,\\text{d}x=$" :question/worked-solution "If we let $u=-4x,$ then, \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-4\\,⟹\\,-\\frac{1}{4}\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $\\operatorname{ln}⁡3$ |\n| --- | --- | --- |\n| $u$ | $0$ | $-4\\operatorname{ln}⁡3$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\operatorname{ln}⁡3}5{e}^{-4x}\\,\\text{d}x & =5{\\int }_{0}^{\\operatorname{ln}⁡3}{e}^{-4x}\\,\\text{d}x \\\\  & =5{\\int }_{0}^{-4\\operatorname{ln}⁡3}{e}^{u}(-\\frac{1}{4})\\text{d}u \\\\  & =-\\frac{5}{4}{\\int }_{0}^{\\operatorname{ln}⁡({3}^{-4})}{e}^{u}\\text{d}u \\\\  & =-\\frac{5}{4}({e}^{u}){|}_{0}^{\\operatorname{ln}⁡({3}^{-4})} \\\\  & =-\\frac{5}{4}({e}^{\\operatorname{ln}⁡({3}^{-4})}-{e}^{0}) \\\\  & =-\\frac{5}{4}({3}^{-4}-1) \\\\  & =-\\frac{5}{4}(\\frac{1}{{3}^{4}}-1) \\\\  & =-\\frac{5}{4}(\\frac{1}{81}-1) \\\\  & =-\\frac{5}{4}(-\\frac{80}{81}) \\\\  & =\\frac{100}{81}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186269177 :knowledge-point/_questions [{:db/id #edb/ref 17592186100928 :knowledge-point/id #uuid "33159d0b-24b5-587e-89e1-b545c2be59c4" :knowledge-point/title "Finding the Second-Degree Taylor Polynomial of a Given Function About a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3dee08bf-73dd-52cc-b1a6-b41970eb1bda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-2{e}^{-1}(x-1)+{e}^{-1}(x-1)^{2}" :db/id #edb/ref 17592186266694} {:answer/id #uuid "5514914b-ead8-5c54-a2fd-a9482f1ab5d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-1}+{e}^{-1}(x-1)-2{e}^{-1}(x-1)^{2}" :db/id #edb/ref 17592186266904} {:answer/id #uuid "5a11e1a6-16e2-5029-903d-276eb5136785" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-1}-2{e}^{-1}(x-1)+{e}^{-1}(x-1)^{2}" :db/id #edb/ref 17592186266944} {:answer/id #uuid "7bba411e-075b-535f-b3eb-a968ad5458b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1+2{e}^{-1}(x-1)+4{e}^{-1}(x-1)^{2}" :db/id #edb/ref 17592186267239} {:answer/id #uuid "ad79cdf4-a151-5c68-bdab-124f9cbba034" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-1}+{e}^{-1}(x-1)+4{e}^{-1}(x-1)^{2}" :db/id #edb/ref 17592186267712}] :answer-field/correct {:answer/id #uuid "5a11e1a6-16e2-5029-903d-276eb5136785" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-1}-2{e}^{-1}(x-1)+{e}^{-1}(x-1)^{2}" :db/id #edb/ref 17592186266944} :answer-field/id #uuid "cfe3be36-04c4-5d6e-8e8f-15e4a6fc0497" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268778}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "682db2a3-d3d2-54b6-8a78-578de1c6ac8a" :question/math-academy-id "q-13817" :question/problem "The second-degree Taylor polynomial of $f(x)={e}^{-{x}^{2}}$ about $x=1$ is" :question/worked-solution "To find the second-degree Taylor polynomial about $x=1,$ we plug $a=1$ into the general formula to give\n\n$$\n{P}_{2}(x)=f(1)+{f}^{′}(1)(x-1)+\\frac{1}{2}{f}^{″}(1)(x-1)^{2}.\n$$\n\nSo, we need to work out $f(1),$ ${f}^{′}(1),$ and ${f}^{″}(1):$ \n\n$$\n\\begin{aligned}f(x) & ={e}^{-{x}^{2}} & ⟹ &  & f(1) & ={e}^{-1} \\\\ {f}^{′}(x) & =-\\,2x{e}^{-{x}^{2}} & ⟹ &  & {f}^{′}(1) & =-2{e}^{-1} \\\\ {f}^{″}(x) & =(4{x}^{2}-2){e}^{-{x}^{2}} & ⟹ &  & {f}^{″}(1) & =2{e}^{-1}\\end{aligned}\n$$\n\nWe now plug the results for $f(1),$ ${f}^{′}(1),$ and ${f}^{″}(1)$ into our second-degree Taylor polynomial. This gives\n\n$$\n\\begin{aligned}{P}_{2}(x) & ={e}^{-1}+(-2{e}^{-1})\\cdot (x-1)+(2{e}^{-1})\\cdot \\frac{1}{2}(x-1)^{2} \\\\  & ={e}^{-1}-2{e}^{-1}(x-1)+{e}^{-1}(x-1)^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186269182 :knowledge-point/_questions [{:db/id #edb/ref 17592186100818 :knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7148b847-d982-5ea4-b057-c5e42788f937" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}\\operatorname{ln}⁡(\\operatorname{ln}⁡4)" :db/id #edb/ref 17592186267138} {:answer/id #uuid "78b9a284-7918-5a48-9b63-09d2dbf15a7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186267206} {:answer/id #uuid "c324f604-f021-5ec4-97d6-e46d27f5780b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}\\operatorname{ln}⁡4" :db/id #edb/ref 17592186267886} {:answer/id #uuid "f349a50e-2135-5759-85b8-7bfb21768dc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{ln}⁡(\\operatorname{ln}⁡4)" :db/id #edb/ref 17592186268308} {:answer/id #uuid "f3e8bc1f-2171-58ab-a46f-699ee9e27a89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(\\operatorname{ln}⁡4)" :db/id #edb/ref 17592186268311}] :answer-field/correct {:answer/id #uuid "7148b847-d982-5ea4-b057-c5e42788f937" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}\\operatorname{ln}⁡(\\operatorname{ln}⁡4)" :db/id #edb/ref 17592186267138} :answer-field/id #uuid "a5268c76-ac42-5d62-8149-d9e09487a8d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268701}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ed857a50-0096-5fa3-bea2-e4ec1bd8cccb" :question/math-academy-id "q-13845" :question/problem "What is the value of ${\\int }_{1}^{e/4}\\frac{1}{4x\\operatorname{ln}⁡(4x)}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(4x).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{4x}\\cdot 4=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $e/4$ |\n| --- | --- | --- |\n| $u$ | $\\operatorname{ln}⁡4$ | $1$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e/4}\\frac{1}{4x\\operatorname{ln}⁡(4x)}\\,\\text{d}x & =\\frac{1}{4}{\\int }_{1}^{e/4}\\frac{1}{\\operatorname{ln}⁡(4x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{4}{\\int }_{\\operatorname{ln}⁡4}^{1}\\frac{1}{u}\\cdot \\text{d}u \\\\  & =\\frac{1}{4}(\\operatorname{ln}⁡|u|){|}_{\\operatorname{ln}⁡4}^{1} \\\\  & =\\frac{1}{4}(\\operatorname{ln}⁡1-\\operatorname{ln}⁡(\\operatorname{ln}⁡4)) \\\\  & =\\frac{1}{4}(0-\\operatorname{ln}⁡(\\operatorname{ln}⁡4)) \\\\  & =-\\frac{1}{4}\\operatorname{ln}⁡(\\operatorname{ln}⁡4)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083528 :knowledge-point/_questions [{:db/id #edb/ref 17592186083342 :knowledge-point/id #uuid "7f79d9ff-425b-5f2e-8380-23435a01a5b4" :knowledge-point/title "Identifying Data Sets That Could Be Normally Distributed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8fa31037-44ef-5261-8775-57dea5d4b13e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/47/47d0812e7cb8b459df66a9d8f153232d10b5cd4532da4787dab0629b7ac0a1a3.png" :db/id #edb/ref 17592186080064} {:answer/id #uuid "ee2db0d3-e7ef-5209-ae1a-a5840baaf6f9" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/60/60b78b17a9fcad64ad3ec66ab29fe4da750740af4a1258b269597d0500488cc5.png" :db/id #edb/ref 17592186080065} {:answer/id #uuid "f3ddb6ca-634f-50bb-be7d-4f70f15b69c7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/99/9969bd82c4b8c2e07acb41cea190ce56c93880a16dc5e4f118f6a7413585906a.png" :db/id #edb/ref 17592186080066} {:answer/id #uuid "011a9a4e-038d-540d-b262-c8358f98da89" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3a/3a73e3c8343526ceb755d6a0b44ba83d816265c5893a94d82a87f8f04ad4969a.png" :db/id #edb/ref 17592186080067} {:answer/id #uuid "76b5ed90-5a35-5bc0-9f5f-d7e6dcb9fc89" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f2/f24b8b76970891cd8a3b8f797f608ff916dd6f05e5e8afddbb5575778b024be7.png" :db/id #edb/ref 17592186080068}] :answer-field/id #uuid "9255444d-b840-571d-a6ff-ceafd8548631" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186080063} {:answer-field/choices [{:answer/id #uuid "e2567e0e-29b0-57bd-848a-32c7d8078a31" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/99/9969bd82c4b8c2e07acb41cea190ce56c93880a16dc5e4f118f6a7413585906a.png" :db/id #edb/ref 17592186388607} {:answer/id #uuid "10c3aec0-6688-53cc-8287-5794de7509f0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "ima