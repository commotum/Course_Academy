efore, further tests on the data are required to confirm whether the underlying distribution is normal."}] [{:db/id #edb/ref 17592186083529 :knowledge-point/_questions [{:db/id #edb/ref 17592186083342 :knowledge-point/id #uuid "7f79d9ff-425b-5f2e-8380-23435a01a5b4" :knowledge-point/title "Identifying Data Sets That Could Be Normally Distributed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c8cd0ef-9a01-5404-b0bb-8134259f8b74" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bb/bb1d2422671ea08909f8e167f2e258f4a03a77b1e74fadab29d75df589deea68.png" :db/id #edb/ref 17592186080070} {:answer/id #uuid "1e889f73-2643-5f46-b2e0-5efbb8514492" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/02/020677400e505321bc70752b4039c1c90ba5b4f31caeb269532d210431f460fd.png" :db/id #edb/ref 17592186080071} {:answer/id #uuid "37f4bd60-f41d-5a44-b684-266c5ff3b0ff" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/83/83b825f4caba86ad351c7c9b8e8b5915dfd4c3e60220188eec68749a33f8b82d.png" :db/id #edb/ref 17592186080072} {:answer/id #uuid "3a2b64bc-a88b-5d4f-824e-32b151d749d5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fe/fea86f08dfe527e4ff931e24ace90fcf863fb7d1573f03328d49304f55a8e0d2.png" :db/id #edb/ref 17592186080073} {:answer/id #uuid "501af8d8-3fe4-551b-8d98-33a4585d22e9" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f6/f67b0306fc2a1d9de89beeaa1db1670d9c32c664bdaeb3690ee91561c7acdd0c.png" :db/id #edb/ref 17592186080074}] :answer-field/id #uuid "4efb1c77-89b0-579d-93be-6922aa6e1ddc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186080069} {:answer-field/choices [{:answer/id #uuid "8c480524-46a9-5adc-836f-5c31aaab1316" :answer/type 