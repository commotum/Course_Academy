[{:answer-field/choices [{:answer/id #uuid "1345d968-20d1-5ac9-bbfe-3c46ce781861" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186351732} {:answer/id #uuid "967290dc-71b3-501d-8605-16ee088f7c19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,0)" :db/id #edb/ref 17592186352870} {:answer/id #uuid "a4389b55-ae83-53e1-9f8d-a4182b6742a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\frac{5}{4})" :db/id #edb/ref 17592186352968} {:answer/id #uuid "c15bc970-f051-5dfb-a7f1-db97122d6816" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{5}{4},0)" :db/id #edb/ref 17592186353237} {:answer/id #uuid "ded0b80c-41d3-53a3-9730-fea5f6f67367" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,5)" :db/id #edb/ref 17592186353502}] :answer-field/correct {:answer/id #uuid "1345d968-20d1-5ac9-bbfe-3c46ce781861" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186351732} :answer-field/id #uuid "e7c729ab-9ef7-56a2-b67a-e30b58f4144d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354210}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4a3d9a2c-1761-5baf-9e5d-4958b26130d5" :question/math-academy-id "q-84954" :question/problem "What are the coordinates of the vertex of the parabola ${x}^{2}=5y?$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at the origin is\n\n$$\n{x}^{2}=4py,\n$$\n\nwhere $p$ is a constant.\n\nWe can rewrite the given equation as \n\n$$\n{x}^{2}=4(\\frac{5}{4})y.\n$$\n\nIt is now clear that our equation is of the standard type with $p=\\frac{5}{4}.$ Therefore, our parabola has its vertex at $(0,0).$"}] [{:db/id #edb/ref 17592186354368 :knowledge-point/_questions [{:db/id #edb/ref 17592186083225 :knowledge-point/id #uuid "120f626e-dd00-537a-8948-d8f81850d696" :knowledge-point/title "Calculating the Number of Combinations of Objects Chosen From a Group Fewer Than Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "260ee64b-60f9-577f-b9cd-899af296d9b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "84" :db/id #edb/ref 17592186351917} {:answer/id #uuid "73b8b006-61f8-5c7a-906f-a83360295df8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186352580} {:answer/id #uuid "b91e1eea-f224-503d-85e7-b2faa41fc99d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186353149} {:answer/id #uuid "ca9be550-efdd-5dc5-80d3-353296eb9f18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "243" :db/id #edb/ref 17592186353327} {:answer/id #uuid "ef9b644a-cfec-5d4f-922b-5a3e24daabe5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186353654}] :answer-field/correct {:answer/id #uuid "260ee64b-60f9-577f-b9cd-899af296d9b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "84" :db/id #edb/ref 17592186351917} :answer-field/id #uuid "fcee7007-39c0-575f-87b4-92eaeeb2b54a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354257}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a9b3fff3-7ca8-5a05-bacf-2186c0ce6253" :question/math-academy-id "q-84956" :question/problem "A pizzeria has nine different toppings from which to choose. How many different pizzas can be made using only three toppings?" :question/worked-solution "The number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nThere are $9$ toppings, so $n=9.$ We want to select $3$ of those toppings for each of the pizzas, so we have $r=3.$\n\nTherefore, the number of different pizzas is\n\n$$\n\\begin{aligned}{}_{9}{C}_{3} & =\\frac{9!}{(9-3)!\\,3!} \\\\  & =\\frac{9!}{6!3!} \\\\  & =\\frac{9\\cdot 8\\cdot 7\\cdot \\cancel{6!}}{\\cancel{6!}3!} \\\\  & =\\frac{9\\cdot 8\\cdot 7}{3\\cdot 2\\cdot 1} \\\\  & =\\frac{504}{6} \\\\  & =84.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186354369 :knowledge-point/_questions [{:db/id #edb/ref 17592186083225 :knowledge-point/id #uuid "120f626e-dd00-537a-8948-d8f81850d696" :knowledge-point/title "Calculating the Number of Combinations of Objects Chosen From a Group Fewer Than Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1755d2b2-8ef2-5841-967a-37231874078e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "154" :db/id #edb/ref 17592186351776} {:answer/id #uuid "22aa46f6-d9f6-52a0-921d-e699a6fdabc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "82" :db/id #edb/ref 17592186351880} {:answer/id #uuid "aefddd11-ffea-5b50-af77-6441d3546955" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "102" :db/id #edb/ref 17592186353052} {:answer/id #uuid "d8ef2388-0f72-5871-b0be-8276cb5fe915" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186353453} {:answer/id #uuid "debdfcd2-ba10-5c33-a152-32714bf2926b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "126" :db/id #edb/ref 17592186353500}] :answer-field/correct {:answer/id #uuid "debdfcd2-ba10-5c33-a152-32714bf2926b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "126" :db/id #edb/ref 17592186353500} :answer-field/id #uuid "bb52f3bb-59b4-5a00-86e6-1550bcc92127" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354137}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "44e1ceb1-ad30-5708-98e7-b7ac9be19ae7" :question/math-academy-id "q-84959" :question/problem "Sara has a box of $9$ colored pencils. In how many ways can Sara pick a set of $4$ different pencils from the box?" :question/worked-solution "The number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nThere are $9$ pencils in the box, so $n=9.$ We want to select $4$ of those pencils, so we have $r=4.$\n\nTherefore, the number of different potential sets of four pencils is\n\n$$\n\\begin{aligned}{}_{9}{C}_{4} & =\\frac{9!}{(9-4)!\\,4!} \\\\  & =\\frac{9!}{5!4!} \\\\  & =\\frac{9\\cdot 8\\cdot 7\\cdot 6\\cdot \\cancel{5!}}{\\cancel{5!}4!} \\\\  & =\\frac{9\\cdot 8\\cdot 7\\cdot 6}{4\\cdot 3\\cdot 2\\cdot 1} \\\\  & =\\frac{3\\,024}{24} \\\\  & =126.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186354371 :knowledge-point/_questions [{:db/id #edb/ref 17592186083225 :knowledge-point/id #uuid "120f626e-dd00-537a-8948-d8f81850d696" :knowledge-point/title "Calculating the Number of Combinations of Objects Chosen From a Group Fewer Than Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e930c14-7407-53e8-ac84-31d7b250449f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186352544} {:answer/id #uuid "b52289e0-c35b-55ea-bb6c-8d9b85ecdd4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186353114} {:answer/id #uuid "be45fc23-d089-5e1e-8141-82c146916a58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186353192} {:answer/id #uuid "d674dad4-60ae-5a18-b33c-d0228e2d1e2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186353424} {:answer/id #uuid "e1026acb-201d-5cef-afeb-3adf4233a361" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186353520}] :answer-field/correct {:answer/id #uuid "b52289e0-c35b-55ea-bb6c-8d9b85ecdd4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186353114} :answer-field/id #uuid "1fc1d491-e28d-5249-b404-4f835405e6a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353866}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a3962390-93bb-5eee-a524-e14f0426b20f" :question/math-academy-id "q-84964" :question/problem "Given any two points in a plane, there is a unique line that passes through both points. Given six points in a plane, what is the maximum number of unique  lines that can be made using these points?" :question/worked-solution "The number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nThere are $6$ points, so $n=6.$ We want to select $2$ of those points for each of the lines, so we have $r=2.$\n\nTherefore, the maximum number of unique lines is\n\n$$\n\\begin{aligned}{}_{6}{C}_{2} & =\\frac{6!}{(6-2)!\\,2!} \\\\  & =\\frac{6!}{4!2!} \\\\  & =\\frac{6\\cdot 5\\cdot \\cancel{4!}}{\\cancel{4!}2!} \\\\  & =\\frac{6\\cdot 5}{2\\cdot 1} \\\\  & =\\frac{30}{2} \\\\  & =15.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186354373 :knowledge-point/_questions [{:db/id #edb/ref 17592186096762 :knowledge-point/id #uuid "67455965-c9d3-5ae8-8b56-2a58af95df0a" :knowledge-point/title "Stating the Vertex of a Vertical Parabola Given Its Equation in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "454a079a-3b5d-5568-a29d-6f2901c3f216" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186352210} {:answer/id #uuid "66130b54-d958-5449-b32e-e09731f751e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-3)" :db/id #edb/ref 17592186352466} {:answer/id #uuid "72d2ceff-58e4-5cc6-ae01-b9e7dcc9c275" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,5)" :db/id #edb/ref 17592186352571} {:answer/id #uuid "75807951-bdad-56c4-9ac3-85b96c3b3874" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,0)" :db/id #edb/ref 17592186352599} {:answer/id #uuid "bf82ba33-b385-51d9-aff0-7b68257c69a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,5)" :db/id #edb/ref 17592186353211}] :answer-field/correct {:answer/id #uuid "75807951-bdad-56c4-9ac3-85b96c3b3874" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,0)" :db/id #edb/ref 17592186352599} :answer-field/id #uuid "46991009-d0a6-523f-9684-9c96c88c491a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353940}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f2eb1bd6-8295-533c-aa8b-65d0d7da5480" :question/math-academy-id "q-84967" :question/problem "What are the coordinates of the vertex of the parabola $(x+3)^{2}=5y?$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^{2}=4p(y-k),\n$$\n\nwhere $p$ is constant.\n\nWe can rewrite the given equation as\n\n$$\n\\begin{aligned}(x+3)^{2} & =4(\\frac{5}{4})(y-0).\\end{aligned}\n$$\n\nIt is now clear that our equation is of the standard type with $p=\\frac{5}{4}.$\n\nComparing our equation with the standard equation, we can see that we have $h=-3$ and $k=0.$ Therefore, the coordinates of the vertex of the parabola are $(-3,0).$"}] [{:db/id #edb/ref 17592186394606 :knowledge-point/_questions [{:db/id #edb/ref 17592186096762 :knowledge-point/id #uuid "67455965-c9d3-5ae8-8b56-2a58af95df0a" :knowledge-point/title "Stating the Vertex of a Vertical Parabola Given Its Equation in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04cf7aa5-821b-5194-92ee-e163b789c16b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,1)" :db/id #edb/ref 17592186394608} {:answer/id #uuid "f5095fef-4c48-532f-8c2f-2dbad3334078" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-1)" :db/id #edb/ref 17592186394609} {:answer/id #uuid "b88c860e-59c0-5bcb-89d6-977dd41d5914" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,3)" :db/id #edb/ref 17592186394610} {:answer/id #uuid "8a3bca0d-585e-516e-b263-78ef85a7326a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-12)" :db/id #edb/ref 17592186394611} {:answer/id #uuid "9a34a799-9e17-5662-be75-0e26c84da6fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,-12)" :db/id #edb/ref 17592186394612}] :answer-field/correct {:answer/id #uuid "f5095fef-4c48-532f-8c2f-2dbad3334078" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-1)" :db/id #edb/ref 17592186394609} :answer-field/id #uuid "e80047bb-6a0d-59e5-a218-fc77682c7230" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394607}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "945fd642-939e-5d6f-b944-14a3501dfb6d" :question/math-academy-id "q-84971" :question/problem "What are the coordinates of the vertex of the parabola $(x-2)^{2}=12(y+1)?$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^{2}=4p(y-k),\n$$\n\nwhere $p$ is constant.\n\nWe can rewrite the given equation as\n\n$$\n\\begin{aligned}(x-2)^{2} & =4(3)(y+1).\\end{aligned}\n$$\n\nIt is now clear that our equation is of the standard type with $p=3.$\n\nComparing our equation with the standard equation, we can see that we have $h=2$ and $k=-1.$ Therefore, the coordinates of the vertex of the parabola are $(2,-1).$"}] [{:db/id #edb/ref 17592186394613 :knowledge-point/_questions [{:db/id #edb/ref 17592186096763 :knowledge-point/id #uuid "9e302810-8b14-5c8c-8bbb-245386a66b7c" :knowledge-point/title "Stating the Vertex of a Horizontal Parabola Given Its Equation in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dc4323e-c33f-535a-afd4-6c18fb62876c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{4},-2)" :db/id #edb/ref 17592186394615} {:answer/id #uuid "2c600d3d-c6b3-5497-b45a-7300868b4cbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,-2)" :db/id #edb/ref 17592186394616} {:answer/id #uuid "e2b5c9f8-a768-5571-978b-75dd487db682" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\frac{1}{4},-5)" :db/id #edb/ref 17592186394617} {:answer/id #uuid "22da317e-ddf5-5200-804d-bd894039dd72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,-\\frac{1}{4})" :db/id #edb/ref 17592186394618} {:answer/id #uuid "272006fd-58b0-5a2a-a77c-5f9c24478703" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-5)" :db/id #edb/ref 17592186394619}] :answer-field/correct {:answer/id #uuid "272006fd-58b0-5a2a-a77c-5f9c24478703" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-5)" :db/id #edb/ref 17592186394619} :answer-field/id #uuid "e066a708-3818-5b25-a57a-0121fdb30598" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394614}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4a1a945b-79bd-54e9-8bd1-4a820e9e7516" :question/math-academy-id "q-84974" :question/problem "What are the coordinates of the vertex of the parabola $(y+5)^{2}=-(x-2)?$" :question/worked-solution "The standard equation of a left- or right-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(y-k)^{2}=4p(x-h),\n$$\n\nwhere $p$ is constant.\n\nWe can rewrite the given equation as \n\n$$\n(y+5)^{2}=4(-\\frac{1}{4})(x-2).\n$$\n\nIt is now clear that our equation is of the standard type with $p=-\\frac{1}{4}.$ \n\nComparing our equation with the standard equation, we can see that we have $h=2$ and $k=-5.$ Therefore, the coordinates of the vertex of the parabola are $(2,-5).$"}]}
