Inverse Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e789a15-0f6c-5c6c-88ae-c3ebce2478cd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7f/7f3982453612117ab6837967905b341040d3ecdda60733b259e749aa2ab28a75.png" :db/id #edb/ref 17592186386857} {:answer/id #uuid "1e395ea6-d157-54a7-8c92-fbc0a15c7181" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/df/df22eea4331c47da3047381ca672fd80ebf75118054316fe88c0e2d96dae0d34.png" :db/id #edb/ref 17592186386858} {:answer/id #uuid "2c6be4be-71f2-5a3e-9a40-6589e5a70583" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/4e/4edede1c41fed040afa30a608b70d1631101020172593b57611d3a38e457cfe2.png" :db/id #edb/ref 17592186386859} {:answer/id #uuid "9c5c303b-5da6-56d6-9a0e-3817ff000f74" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b2/b24637d9e613b6f9649658c620406a687faac19153bd37b671a078e9530ee1bd.png" :db/id #edb/ref 17592186386860} {:answer/id #uuid "39d3b40a-6f53-5ea6-a900-eb0b5df73621" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9d/9dcc5a116c2a564547283783a7df7b1cd3a9ab3b76ac24dc2695c4cb367796d5.png" :db/id #edb/ref 17592186386861}] :answer-field/correct {:answer/id #uuid "39d3b40a-6f53-5ea6-a900-eb0b5df73621" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9d/9dcc5a116c2a564547283783a7df7b1cd3a9ab3b76ac24dc2695c4cb367796d5.png" :db/id #edb/ref 17592186386861} :answer-field/id #uuid "7d0d9645-b4ee-51dd-bd9f-a79061fa442c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386856}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "09fe6ea5-caba-5eab-b3bb-4b7e28bffdb4" :question/math-academy-id "q-117141" :question/problem "What is the graph of $y=\\operatorname{arccos}⁡x?$" :question/worked-solution "Let's recall some of the basic properties of $y=\\operatorname{arccos}⁡x:$\n\n- The domain of the function is $x\\in [-1,1].$\n\n- The range of the function is $y\\in [0,\\pi ].$\n\n- Its minimum value occurs at $x=1.$\n\n- Its maximum value occurs at $x=-1.$\n\n- Its $y$-intercept is $y=\\frac{\\pi }{2}.$\n\n- The function is strictly decreasing on its entire domain.\n\nOf the given functions, the only one that has all of these properties is as follows:\n\n![](images/9d/9dcc5a116c2a564547283783a7df7b1cd3a9ab3b76ac24dc2695c4cb367796d5.png)"}] [{:db/id #edb/ref 17592186253312 :knowledge-point/_questions [{:db/id #edb/ref 17592186087703 :knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01" :knowledge-point/title "Solving for a Variable in a Singular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "097794a2-c7ca-5ecf-bd92-2d6b9637edf2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\pm 3" :db/id #edb/ref 17592186250639} {:answer/id #uuid "87862fd4-0b9f-5398-911d-63cce6d1b136" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=-3" :db/id #edb/ref 17592186251692} {:answer/id #uuid "c745fe31-0cba-5f79-a40c-985ece6242bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=2" :db/id #edb/ref 17592186252314} {:answer/id #uuid "d2e5419b-2e45-5470-ad3f-325c6e4e71dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=3" :db/id #edb/ref 17592186252419} {:answer/id #uuid "e279ed19-5a71-5d13-9f8d-6703bfc76869" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\pm 2" :db/id #edb/ref 17592186252544}] :answer-field/correct {:answer/id #uuid "097794a2-c7ca-5ecf-bd92-2d6b9637edf2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\pm 3" :db/id #edb/ref 17592186250639} :answer-field/id #uuid "886a0983-97da-5781-96e9-27635821fd09" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253038}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "18e87006-2d52-52b3-8fdf-cef524aa5a2c" :question/math-academy-id "q-11719" :question/problem "If $F=[\\begin{aligned}3 & t \\\\ t & 3\\end{aligned}]$ is a singular matrix, calculate the value(s) of $t.$" :question/worked-solution "The matrix $F$ is singular if and only if $det(F)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(F) & =3\\cdot 3-t\\cdot t \\\\  & =9-{t}^{2}.\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $t:$\n\n$$\n\\begin{aligned}9-{t}^{2} & =0 \\\\ {t}^{2} & =9 \\\\ t & =\\pm 3\\end{aligned}\n$$\n\nTherefore, the values of $t$ are $t=\\pm 3.$"}] [{:db/id #edb/ref 17592186253313 :knowledge-point/_questions [{:db/id #edb/ref 17592186087703 :knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01" :knowledge-point/title "Solving for a Variable in a Singular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57d016cc-b32a-556a-872a-d9d9454755e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{2}{3}" :db/id #edb/ref 17592186251269} {:answer/id #uuid "7f24ab14-2022-5d0d-aa61-084ff480fc31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2" :db/id #edb/ref 17592186251621} {:answer/id #uuid "ac0e0abc-a204-57f0-a0ca-d651601dc526" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=0" :db/id #edb/ref 17592186252047} {:answer/id #uuid "e207ec5b-404c-50f6-acae-784dfe8e282b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-2" :db/id #edb/ref 17592186252541} {:answer/id #uuid "f8fa13d3-a4d7-5bb5-8a44-96e5e778acbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{3}{2}" :db/id #edb/ref 17592186252733}] :answer-field/correct {:answer/id #uuid "ac0e0abc-a204-57f0-a0ca-d651601dc526" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=0" :db/id #edb/ref 17592186252047} :answer-field/id #uuid "a9e9e596-1625-5316-9294-354fbe58edae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253103}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e6398e19-0166-5ea2-9ff8-a93fab46629b" :question/math-academy-id "q-11721" :question/problem "If $Q=[\\begin{aligned}3 & 6 \\\\ x & x\\end{aligned}]$ is a singular matrix, calculate the value of $x.$" :question/worked-solution "The matrix $Q$ is singular if and only if $det(Q)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(Q) & =3\\cdot x-x\\cdot 6 \\\\  & =3x-6x \\\\  & =-3x\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $x:$\n\n$$\n\\begin{aligned}-3x & =0 \\\\ x & =0\\end{aligned}\n$$\n\nTherefore, the value of $x$ is $x=0.$"}] [{:db/id #edb/ref 17592186398158 :knowledge-point/_questions [{:db/id #edb/ref 17592186110573 :knowledge-point/id #uuid "039f58e5-0f98-58b1-b2f7-9f0ee33ed075" :knowledge-point/title "Identifying Values in the Domain of the Inverse Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a40c0d41-ab7a-5106-8e75-bfa7c1713fdd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186398160} {:answer/id #uuid "05d63814-3721-5df1-9ee4-ce7b9124f4b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{6}" :db/id #edb/ref 17592186398161} {:answer/id #uuid "e57920a0-525b-55ec-9484-f65f17f5b566" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{2}" :db/id #edb/ref 17592186398162} {:answer/id #uuid "dc1d7c12-42bb-563d-9070-eb5fa55f3bd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}" :db/id #edb/ref 17592186398163} {:answer/id #uuid "f4890513-3435-5119-84b3-3f92b4c14b12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{10}" :db/id #edb/ref 17592186398164}] :answer-field/correct {:answer/id #uuid "e57920a0-525b-55ec-9484-f65f17f5b566" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{2}" :db/id #edb/ref 17592186398162} :answer-field/id #uuid "1a8182c3-02a5-5e68-9327-d52d8bf2cc84" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398159}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0090932a-f451-563b-921a-c105fc8ef9ed" :question/math-academy-id "q-117212" :question/problem "Which of the following values is **not** in the domain of $y=\\operatorname{arccos}⁡x?$" :question/worked-solution "Let's recall the graph of $y=\\operatorname{arccos}⁡x.$\n\n![](images/d2/d2677563c82c37fd1672a806a18524c97ea5ec17cb4f8ef6d8df23b827ba5e81.png)\n\nNote that:\n\n- The domain of the function is $[-1,1].$\n\nTherefore, the value $x=-\\frac{\\pi }{2}$ is not in the domain of $y=\\operatorname{arccos}⁡x.$"}] [{:db/id #edb/ref 17592186253317 :knowledge-point/_questions [{:db/id #edb/ref 17592186110574 :knowledge-point/id #uuid "2df217d3-d1d2-54cd-8c93-7925225bfdf3" :knowledge-point/title "Identifying Values in the Range of the Inverse Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "142b7263-1d0d-5f98-9223-e213a8c55b40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{5}" :db/id #edb/ref 17592186250727} {:answer/id #uuid "3f66a74b-e10b-5bc8-a386-9628f0d38772" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186251079} {:answer/id #uuid "90d1d3f2-9966-56b9-9994-3a1f0abfd5e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186251787} {:answer/id #uuid "95032b88-a192-5259-bc74-3d725778c2bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186251832} {:answer/id #uuid "9baee5d0-bd8c-5bc1-b6f8-e0394b534b01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186251896}] :answer-field/correct {:answer/id #uuid "95032b88-a192-5259-bc74-3d725778c2bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186251832} :answer-field/id #uuid "2eaf0b8e-d288-5d0b-bf74-c0a503925436" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252884}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1bf0a7be-9fd8-54b8-9e4e-418e2d997e20" :question/math-academy-id "q-117221" :question/problem "Which of the following values is in the range of $y=\\operatorname{arccos}⁡x?$" :question/worked-solution "Let's recall the graph of $y=\\operatorname{arccos}⁡x.$\n\n![](images/9d/9dcc5a116c2a564547283783a7df7b1cd3a9ab3b76ac24dc2695c4cb367796d5.png)\n\nNote that:\n\n- The range of the function is $[0,\\pi ].$\n\nTherefore, of the given values, only $2$ is in the range of the function."}] [{:db/id #edb/ref 17592186399947 :knowledge-point/_questions [{:db/id #edb/ref 17592186087782 :knowledge-point/id #uuid "e44305e5-b7e3-5ae2-925c-9329f37823b8" :knowledge-point/title "Finding the Points of Intersection of a Circle with a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "738c53f5-f5c8-5fab-bbb8-24d62bfe2a2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(2,2)$ and $(-\\frac{3}{2},\\frac{5}{6})$" :db/id #edb/ref 17592186399949} {:answer/id #uuid "32676595-fa5b-5541-bdb9-a9971fe141be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(3,\\frac{7}{3})$ and $(-1,1)$" :db/id #edb/ref 17592186399950} {:answer/id #uuid "f3d5a1de-738c-52d2-83a4-ee63afd539ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(\\frac{3}{2},\\frac{5}{6})$ and $(-\\frac{1}{4},\\frac{5}{4})$" :db/id #edb/ref 17592186399951} {:answer/id #uuid "d94ef636-d502-57eb-a2ff-477e7a72cf1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(2,2)$ and $(-1,1)$" :db/id #edb/ref 17592186399952} {:answer/id #uuid "3ba0a14c-37f3-5fb2-874e-33cf3105a4d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(3,\\frac{7}{3})$ and $(-\\frac{3}{2},\\frac{5}{6})$" :db/id #edb/ref 17592186399953}] :answer-field/correct {:answer/id #uuid "d94ef636-d502-57eb-a2ff-477e7a72cf1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(2,2)$ and $(-1,1)$" :db/id #edb/ref 17592186399952} :answer-field/id #uuid "709ede91-db66-5be7-a01a-f474f7dacadb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399948}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f9516424-4bd5-5885-82ea-4588d28a4cdd" :question/math-academy-id "q-117247" :question/problem "![](images/51/5180dfe04f31f43fdcdfa8bd720951df0c6fb0d73cd2db3912b37e172f714131.png)\n\nFind the points where the circle $(x-1)^{2}+{y}^{2}=5$ intersects the line $x-3y=-4$ (sketched above)." :question/worked-solution "First, we rearrange the equation $x-3y=-4,$ as follows:\n\n$$\ny=\\frac{x}{3}+\\frac{4}{3}.\n$$\n\nTo find $x$-coordinates of the intersection points, we need to substitute $y=\\frac{x}{3}+\\frac{4}{3}$ into the equation of the circle and solve the resulting equation for $x:$\n\n$$\n\\begin{aligned}(x-1)^{2}+{y}^{2}=5 \\\\ (x-1)^{2}+{(\\frac{x}{3}+\\frac{4}{3})}^{2} & =5 \\\\ {x}^{2}-2x+1+\\frac{{x}^{2}}{9}+\\frac{8x}{9}+\\frac{16}{9} & =5 \\\\ \\frac{10{x}^{2}}{9}-\\frac{10x}{9}+\\frac{25}{9} & =\\frac{45}{9} \\\\ \\frac{10{x}^{2}}{9}-\\frac{10x}{9}-\\frac{20}{9} & =0 \\\\ {x}^{2}-x-2 & =0 \\\\ (x+1)(x-2) & =0 \\\\ x & =-1,2.\\end{aligned}\n$$\n\nTo find the $y$-coordinates of the intersection points, we need to substitute $x=-1,2$ into the equation of the line and compute $y$-values. Start with $x=-1:$\n\n$$\n\\begin{aligned}y & =\\frac{x}{3}+\\frac{4}{3} \\\\  & =-\\frac{1}{3}+\\frac{4}{3} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the first intersection point is $(-1,1).$ Next, we plug in $x=2:$\n\n$$\n\\begin{aligned}y & =\\frac{x}{3}+\\frac{4}{3} \\\\  & =\\frac{2}{3}+\\frac{4}{3} \\\\  & =2.\\end{aligned}\n$$\n\nSo, the second intersection point is $(2,2).$\n\nTherefore, the line $x-3y=-4$ intersects the circle $(x-1)^{2}+{y}^{2}=5$ at the points $(2,2)$ and $(-1,1).$"}] [{:db/id #edb/ref 17592186253320 :knowledge-point/_questions [{:db/id #edb/ref 17592186087703 :knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01" :knowledge-point/title "Solving for a Variable in a Singular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "783db2fd-7825-5c2a-a37c-ecf12e9a46b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n=-4" :db/id #edb/ref 17592186251550} {:answer/id #uuid "78c0bab0-9b03-5269-8dab-8e7ea4106e4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n=\\pm 4" :db/id #edb/ref 17592186251554} {:answer/id #uuid "8c394e4f-1154-5d85-9535-8a7a4b1a9b74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n=-2" :db/id #edb/ref 17592186251736} {:answer/id #uuid "9180c1c8-1f7c-540a-8d44-d585577c0e83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n=4" :db/id #edb/ref 17592186251795} {:answer/id #uuid "c3f59c7d-fd33-58d7-ae00-8babf85da183" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n=\\pm 2" :db/id #edb/ref 17592186252288}] :answer-field/correct {:answer/id #uuid "78c0bab0-9b03-5269-8dab-8e7ea4106e4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n=\\pm 4" :db/id #edb/ref 17592186251554} :answer-field/id #uuid "e38d674a-89c9-50fe-9a20-d74c11c871f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253196}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0c7b9ea7-cded-56a3-a2f3-1334f92c0300" :question/math-academy-id "q-11726" :question/problem "If $P=[\\begin{aligned}n & -8 \\\\ -2 & n\\end{aligned}]$ is a singular matrix, calculate the value(s) of $n.$" :question/worked-solution "The matrix $P$ is singular if and only if $det(P)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(P) & =n\\cdot n-(-2)\\cdot (-8) \\\\  & ={n}^{2}-16.\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $n:$\n\n$$\n\\begin{aligned}{n}^{2}-16 & =0 \\\\ {n}^{2} & =16 \\\\ n & =\\pm 4\\end{aligned}\n$$\n\nTherefore, the values of $n$ are $n=\\pm 4.$"}] [{:db/id #edb/ref 17592186386862 :knowledge-point/_questions [{:db/id #edb/ref 17592186110585 :knowledge-point/id #uuid "46e1513d-0944-5c09-8a7e-e1d9ae81bae5" :knowledge-point/title "Graphing the Inverse Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "096a914e-ca68-5949-a34e-4616044de5bb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d7/d7984b9098d02bfc2b1e9a422aef919533abce54fbb94117e709c7613b0870a3.png" :db/id #edb/ref 17592186386864} {:answer/id #uuid "f1e55806-d3c8-548e-80c6-b1e30766315a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/39/395d29ade9c150fc9f6eb4674bfb650004c3379524c321851cc4d2dd32bf7bc1.png" :db/id #edb/ref 17592186386865} {:answer/id #uuid "6e736289-c884-532d-8c00-be2ea9bbb9f9" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/03/0328f3c8c1866f2103857cd9769a01a0d5cd7ec24b7a3585a394f6e9590dd107.png" :db/id #edb/ref 17592186386866} {:answer/id #uuid "2f8a703e-82ef-5233-a9c5-a0fdd0b287fd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f8/f850e9468f4ea2e02625ff0d729a9222e8744e5b5fc8e38621b9465255bb2266.png" :db/id #edb/ref 17592186386867} {:answer/id #uuid "bed70265-c376-5aeb-8052-6193b067a494" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/4b/4bef0bf8fd764126db5583ac90ea96fb02db567f2f75c4fa787440ab94adf901.png" :db/id #edb/ref 17592186386868}] :answer-field/correct {:answer/id #uuid "096a914e-ca68-5949-a34e-4616044de5bb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d7/d7984b9098d02bfc2b1e9a422aef919533abce54fbb94117e709c7613b0870a3.png" :db/id #edb/ref 17592186386864} :answer-field/id #uuid "70ec79cf-e993-5024-9997-bd354c43672a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386863}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "869b4f2f-e699-55cc-9df6-f84ca27a773c" :question/math-academy-id "q-117265" :question/problem "What is the graph of $y=\\operatorname{arctan}⁡x?$" :question/worked-solution "Let's recall some of the basic properties of $y=\\operatorname{arctan}⁡x:$\n\n- The domain is all real numbers.\n\n- There is a zero at $x=0.$\n\n- The function is negative over $(-\\infty ,0)$ and positive over $(0,\\infty ).$\n\n- The function is strictly increasing in its entire domain.\n\n- $y\\to -\\frac{\\pi }{2}$ (from above) as $x\\to -\\infty .$\n\n- $y\\to \\frac{\\pi }{2}$ (from below) as $x\\to \\infty .$\n\n- The lines $y=\\pm \\frac{\\pi }{2}$ are horizontal asymptotes of the function.\n\nOf the given functions, the only one that has all of these properties is as follows:\n\n![](images/d7/d7984b9098d02bfc2b1e9a422aef919533abce54fbb94117e709c7613b0870a3.png)"}] [{:db/id #edb/ref 17592186253324 :knowledge-point/_questions [{:db/id #edb/ref 17592186078441 :knowledge-point/id #uuid "a0f285ec-4f37-5d0d-a65c-be3ca48c740f" :knowledge-point/title "Applying the Second Fundamental Theorem of Calculus With Two Variable Limits"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "178238d9-e0d1-5777-b3cf-766b12d670d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186250761} {:answer/id #uuid "229202ef-99c0-5de5-8945-e3c5a7eb006f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{8}" :db/id #edb/ref 17592186250847} {:answer/id #uuid "911d51bd-b9f6-5cb4-82f6-2441b4de6b77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}" :db/id #edb/ref 17592186251790} {:answer/id #uuid "e6e556a6-bb11-5ba5-a261-04fe9a60f028" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186252573} {:answer/id #uuid "e963bf4d-65b7-5ce4-8bd3-da7c8dac957c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186252596}] :answer-field/correct {:answer/id #uuid "229202ef-99c0-5de5-8945-e3c5a7eb006f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{8}" :db/id #edb/ref 17592186250847} :answer-field/id #uuid "194878cb-3d94-5092-8cec-b3676b597b31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252853}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "59cdd50b-76d3-5bd3-b113-bd6f2cfed6e1" :question/math-academy-id "q-117289" :question/problem "Find ${f}^{′}(1)$ if $f(x)={\\int }_{x}^{\\sqrt{x}}\\frac{1}{{t}^{4}+3}\\,\\text{d}t.$" :question/worked-solution "Here, both the lower and upper limits contain a variable. However, to apply FTC II, we need the variable to be on the upper limit only. So, we can split the integral into two integrals, and rewrite them so that in both cases the variable is on the upper limit. We get\n\n$$\n\\begin{aligned}{\\int }_{x}^{\\sqrt{x}}\\frac{1}{{t}^{4}+3}\\,\\text{d}t & ={\\int }_{x}^{a}\\frac{1}{{t}^{4}+3}\\,\\text{d}t+{\\int }_{a}^{\\sqrt{x}}\\frac{1}{{t}^{4}+3}\\,\\text{d}t \\\\  & =-{\\int }_{a}^{x}\\frac{1}{{t}^{4}+3}\\,\\text{d}t+{\\int }_{a}^{\\sqrt{x}}\\frac{1}{{t}^{4}+3}\\,\\text{d}t,\\end{aligned}\n$$\n\nwhere $a$ is any constant number between $x$ and $\\sqrt{x}.$\n\nThe integrand $\\frac{1}{{t}^{4}+3}$ is continuous for all $t,$ so applying the FTC II gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(-{\\int }_{a}^{x}\\frac{1}{{t}^{4}+3}\\,\\text{d}t+{\\int }_{a}^{\\sqrt{x}}\\frac{1}{{t}^{4}+3}\\,\\text{d}t) \\\\  & =-\\frac{\\text{d}}{\\text{d}x}({\\int }_{a}^{x}\\frac{1}{{t}^{4}+3}\\,\\text{d}t)+\\frac{\\text{d}}{\\text{d}x}({\\int }_{a}^{\\sqrt{x}}\\frac{1}{{t}^{4}+3}\\,\\text{d}t) \\\\  & =-\\frac{1}{{x}^{4}+3}+\\frac{\\text{d}u}{\\text{d}x}\\frac{\\text{d}}{\\text{d}u}({\\int }_{a}^{u}\\frac{1}{{t}^{4}+3}\\,\\text{d}t) \\\\  & =-\\frac{1}{{x}^{4}+3}+\\frac{1}{2\\sqrt{x}}\\cdot \\frac{1}{{u}^{4}+3} \\\\  & =-\\frac{1}{{x}^{4}+3}+\\frac{1}{2\\sqrt{x}((\\sqrt{x})^{4}+3)} \\\\  & =\\frac{1}{2\\sqrt{x}({x}^{2}+3)}-\\frac{1}{{x}^{4}+3}.\\end{aligned}\n$$\n\nNote that we used the substitution $u=\\sqrt{x}.$\n\nFinally, we can compute ${f}^{′}(1).$ We get\n\n$$\n\\begin{aligned}{f}^{′}(1) & =\\frac{1}{2\\sqrt{1}({1}^{2}+3)}-\\frac{1}{{1}^{4}+3} \\\\  & =\\frac{1}{8}-\\frac{1}{4} \\\\  & =-\\frac{1}{8}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253325 :knowledge-point/_questions [{:db/id #edb/ref 17592186078441 :knowledge-point/id #uuid "a0f285ec-4f37-5d0d-a65c-be3ca48c740f" :knowledge-point/title "Applying the Second Fundamental Theorem of Calculus With Two Variable Limits"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fede3ab-03ba-569b-bc73-b40000997af0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186250823} {:answer/id #uuid "27da4a10-7106-529e-afc0-bd91fc3f3b49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3-4{e}^{2}" :db/id #edb/ref 17592186250894} {:answer/id #uuid "42f42797-7b5d-5144-b16e-6c1575823d99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186251114} {:answer/id #uuid "7de54d6e-8542-5a9a-85c4-d974c2a7462d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-e" :db/id #edb/ref 17592186251609} {:answer/id #uuid "80b26266-a183-516d-b9da-db708dac8ad9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+5e" :db/id #edb/ref 17592186251636}] :answer-field/correct {:answer/id #uuid "7de54d6e-8542-5a9a-85c4-d974c2a7462d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-e" :db/id #edb/ref 17592186251609} :answer-field/id #uuid "52011555-7d4c-59cd-aa5f-137a92984e86" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252949}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c930269f-7d7b-579b-a107-b0f3bde563e2" :question/math-academy-id "q-117291" :question/problem "Find ${f}^{′}(0)$ if $f(x)={\\int }_{x}^{\\operatorname{cos}⁡x}{e}^{1-{t}^{2}}\\,\\text{d}t.$" :question/worked-solution "Here, both the lower and upper limits contain a variable. However, to apply FTC II, we need the variable to be on the upper limit only. So, we can split the integral into two integrals, and rewrite them so that in both cases the variable is on the upper limit. We get\n\n$$\n\\begin{aligned}{\\int }_{x}^{\\operatorname{cos}⁡x}{e}^{1-{t}^{2}}\\,\\text{d}t & ={\\int }_{x}^{a}{e}^{1-{t}^{2}}\\,\\text{d}t+{\\int }_{a}^{\\operatorname{cos}⁡x}{e}^{1-{t}^{2}}\\,\\text{d}t \\\\  & =-{\\int }_{a}^{x}{e}^{1-{t}^{2}}\\,\\text{d}t+{\\int }_{a}^{\\operatorname{cos}⁡x}{e}^{1-{t}^{2}}\\,\\text{d}t,\\end{aligned}\n$$\n\nwhere $a$ is any constant number between $x$ and $\\operatorname{cos}⁡x.$\n\nThe integrand ${e}^{1-{t}^{2}}$ is continuous for all $t,$ so applying the FTC II gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(-{\\int }_{a}^{x}{e}^{1-{t}^{2}}\\,\\text{d}t+{\\int }_{a}^{\\operatorname{cos}⁡x}{e}^{1-{t}^{2}}\\,\\text{d}t) \\\\  & =-\\frac{\\text{d}}{\\text{d}x}({\\int }_{a}^{x}{e}^{1-{t}^{2}}\\,\\text{d}t)+\\frac{\\text{d}}{\\text{d}x}({\\int }_{a}^{\\operatorname{cos}⁡x}{e}^{1-{t}^{2}}\\,\\text{d}t) \\\\  & =-{e}^{1-{x}^{2}}+\\frac{\\text{d}u}{\\text{d}x}\\frac{\\text{d}}{\\text{d}u}({\\int }_{a}^{u}{e}^{1-{t}^{2}}\\,\\text{d}t) \\\\  & =-{e}^{1-{x}^{2}}+(-\\operatorname{sin}⁡x){e}^{1-{u}^{2}} \\\\  & =-{e}^{1-{x}^{2}}-{e}^{1-{cos}^{2}⁡x}\\operatorname{sin}⁡x \\\\  & =-{e}^{1-{x}^{2}}-{e}^{{sin}^{2}⁡x}\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nNote that we used the substitution $u=\\operatorname{cos}⁡x.$\n\nFinally, we can compute ${f}^{′}(0).$ We get\n\n$$\n\\begin{aligned}{f}^{′}(0) & =-{e}^{1-{0}^{2}}-{e}^{{sin}^{2}⁡0}\\operatorname{sin}⁡0 \\\\  & =-{e}^{1-0}-0 \\\\  & =-e.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186399954 :knowledge-point/_questions [{:db/id #edb/ref 17592186110587 :knowledge-point/id #uuid "5b834b64-9679-56c2-b5e9-ee26a54b5e13" :knowledge-point/title "Identifying Values in the Domain of the Inverse Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14166b42-bca6-56b8-a07e-797022314072" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186399956} {:answer/id #uuid "2da35c27-dccd-5d0a-8f1d-bbcd8c3eaa3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186399957} {:answer/id #uuid "ac90911c-f7a1-5220-a212-3c6d63800029" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186399958} {:answer/id #uuid "39c54159-c7fd-51f6-9853-fcc01f522381" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186399959} {:answer/id #uuid "9ca824dd-135f-51ed-b6ac-7c3e15e12daf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186399960}] :answer-field/correct {:answer/id #uuid "14166b42-bca6-56b8-a07e-797022314072" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186399956} :answer-field/id #uuid "3edbdcf6-2d84-595e-a82e-d4a8c761ebf2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399955}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fb40c498-010d-593d-917c-a780159dec3f" :question/math-academy-id "q-117329" :question/problem "Which of the following values lies in the domain of $y=\\operatorname{arctan}⁡x?$\n\nI. $-10\\,000$\nII. $\\frac{1}{16}$\nIII. $\\frac{\\sqrt{\\pi }}{6}$" :question/worked-solution "Let's recall the graph of $y=\\operatorname{arctan}⁡x.$\n\n![](images/d7/d7984b9098d02bfc2b1e9a422aef919533abce54fbb94117e709c7613b0870a3.png)\n\nNote that:\n\n- The function is defined for all real numbers.\n\nTherefore, all the given values are in the domain of $y=\\operatorname{arctan}⁡x.$"}] [{:db/id #edb/ref 17592186253330 :knowledge-point/_questions [{:db/id #edb/ref 17592186110586 :knowledge-point/id #uuid "1587e39e-c7bf-5385-b726-a1b497f7c772" :knowledge-point/title "Identifying Values in the Range of the Inverse Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2217da09-6925-529f-a47e-fd42bf90ef04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{6}" :db/id #edb/ref 17592186250844} {:answer/id #uuid "45ac8701-cd2f-526f-9ebd-a915c88cd734" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186251130} {:answer/id #uuid "8d540679-4d39-51d3-a6dc-4648abcea14f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186251748} {:answer/id #uuid "b2b80351-56c5-523b-aca4-c1c6f8888cdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{3}" :db/id #edb/ref 17592186252116} {:answer/id #uuid "fd6871dc-a56c-5f61-876e-28ff32cdd63a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3\