ee3581dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186399964} {:answer/id #uuid "d51ba212-184c-5759-8461-dffee9f36c0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "72.5" :db/id #edb/ref 17592186399965} {:answer/id #uuid "6365eea9-1bba-56eb-bc53-b9734f86d4ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "84.5" :db/id #edb/ref 17592186399966} {:answer/id #uuid "d5f4da11-8df3-5c32-9ef0-645590937087" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "169" :db/id #edb/ref 17592186399967}] :answer-field/correct {:answer/id #uuid "6365eea9-1bba-56eb-bc53-b9734f86d4ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "84.5" :db/id #edb/ref 17592186399966} :answer-field/id #uuid "564afc56-93e1-5116-bc1b-3a39fadf5bbd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399962}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3b82680f-f801-5d98-98f5-3b30c67dd0ca" :question/math-academy-id "q-117347" :question/problem "![](images/4a/4aa952124ddaaa1dc2a54ebb4601255ae42346a9e02f02391c05453a81542505.png)\n\nWhat is the area of the right triangle $ABC$ shown above?" :question/worked-solution "Since $m∠A=m∠C={45}^{∘}$ and $AB=BC,$ we have an isosceles right triangle. \n\n![](images/67/670afdec3633984b2fb493706e762740062348ccbdd0f56df14e3add3d4bbd23.png)\n\nTherefore, the area of the triangle is\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}AB\\cdot BC \\\\  & =\\frac{1}{2}\\cdot {13}^{2} \\\\  & =\\frac{1}{2}\\cdot 169 \\\\  & =84.5\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253334 :knowledge-point/_questions [{:db/id #edb/ref 17592186096612 :knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3232bdcf-d781-5e59-bb5b-56c10f0d7fa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10{x}^{2}+6x" :db/id #edb/ref 17592186250976} {:answer/id #uuid "37865371-b061-54aa-9810-81e59d0b835b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}-10{x}^{2}+6x-19" :db/id #edb/ref 17592186251009} {:answer/id #uuid "3d09661f-ce26-5e19-a8b8-2ae50263662e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10x+6" :db/id #edb/ref 17592186251060 :task-item/_responses [{:db/id #edb/ref 17592186409262}]} {:answer/id #uuid "9007950f-ce55-5f0c-a1f6-d3963f0294f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}-10x+6" :db/id #edb/ref 17592186251775} {:answer/id #uuid "bbf32e0c-8341-5060-b67e-c44870ab4cd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10{x}^{2}+6x-19" :db/id #edb/ref 17592186252214}] :answer-field/correct {:answer/id #uuid "3d09661f-ce26-5e19-a8b8-2ae50263662e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10x+6" :db/id #edb/ref 17592186251060} :answer-field/id #uuid "e849ca6e-9bda-5244-a669-0f22826facaa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253210}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "50678a5c-afcb-522f-98fb-80e9680afca6" :question/math-academy-id "q-11735" :question/problem "Given that $f(x)={6}^{x}-5{x}^{2}+6x-19$, find ${f}^{′}(x).$" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({6}^{x}-5{x}^{2}+6x-19) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})-\\frac{\\text{d}}{\\text{d}x}(5{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(6x)-\\frac{\\text{d}}{\\text{d}x}(19) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})-5\\frac{\\text{d}}{\\text{d}x}({x}^{2})+6\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(19) \\\\  & =ln⁡6\\cdot {6}^{x}-5(2x)+6(1)-0 \\\\  & ={6}^{x}ln⁡6-10x+6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386869 :knowledge-point/_questions [{:db/id #edb/ref 17592186105872 :knowledge-point/id #uuid "a7656d23-06c9-5d22-b62a-3636bca66ab6" :knowledge-point/title "Finding the Base or the Height of a Triangle Given Its Area"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85c1f01f-96af-5f7c-96aa-279c3ec7396b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11\\,\\text{m}" :db/id #edb/ref 17592186386871} {:answer/id #uuid "2997f072-b449-5713-9807-6a5f2600c14b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\,\\text{m}" :db/id #edb/ref 17592186386872} {:answer/id #uuid "8fb6c5c4-f4a0-508f-836c-123e77528fc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\text{m}" :db/id #edb/ref 17592186386873} {:answer/id #uuid "1fee1997-ce6c-5947-a48e-604fe553cb79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,\\text{m}" :db/id #edb/ref 17592186386874} {:answer/id #uuid "f0514960-ea4a-54b8-90e9-aaff6e94282c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16\\,\\text{m}" :db/id #edb/ref 17592186386875}] :answer-field/correct {:answer/id #uuid "8fb6c5c4-f4a0-508f-836c-123e77528fc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\text{m}" :db/id #edb/ref 17592186386873} :answer-field/id #uuid "a7d95cca-e9e0-5148-9e42-b90b4a803ca8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386870}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4303d1bd-0440-58eb-a5d5-e6551f7a6e46" :question/math-academy-id "q-117356" :question/problem "![](images/10/10b6f63df56c789d0d28cd14caad0a2588e247ba4a60239f4cb0dd5a32777daf.png)\n\nFind $AM$ given that the area of $△ABC$ is $64\\,{m}^{2},$ $MC=11\\,m,$ and $BM=8\\,m.$}\n\n(Figure not drawn to scale)" :question/worked-solution "The area of the triangle is defined as \n\n$$\nA=\\frac{b\\cdot h}{2},\n$$\n\n where $b$ is a base and $h$ is the corresponding height.\n\nFrom the diagram, we see that the base is $b=AC,$ and the corresponding height is \n\n$$\nh=BM=8\\,m.\n$$\n\nTherefore, using the formula for the area, we can solve for the base as follows:\n\n$$\n\\begin{aligned}A & =\\frac{b\\cdot h}{2} \\\\ 64 & =\\frac{b\\cdot 8}{2} \\\\ 128 & =b\\cdot 8 \\\\ b & =\\frac{128}{8} \\\\ b & =16\\,m\\end{aligned}\n$$\n\nAs a result, $AC=16\\,m$ and hence, we have\n\n$$\nAM=AC-MC=16-11=5\\,\\text{m}.\n$$"}] [{:db/id #edb/ref 17592186399968 :knowledge-point/_questions [{:db/id #edb/ref 17592186110588 :knowledge-point/id #uuid "7f045b43-4785-5989-8b5a-dcb8401d1bb3" :knowledge-point/title "Determining Points that Lie on the Graph of the Inverse Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa719b7d-d1ee-5649-b870-8f8a3d1177c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186399970} {:answer/id #uuid "18dee54a-fce8-5dc3-a798-772a50cd8901" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186399971} {:answer/id #uuid "730c0a62-4f76-5705-9e0b-4a00253a74f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186399972} {:answer/id #uuid "11d81d17-4b55-5d20-91dc-2a09540e3557" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186399973} {:answer/id #uuid "5bafb7b5-e251-5b4a-b330-592196d2fd1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186399974}] :answer-field/correct {:answer/id #uuid "5bafb7b5-e251-5b4a-b330-592196d2fd1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186399974} :answer-field/id #uuid "f2f8be92-1eeb-51f2-9522-8aecb4bbebb3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399969}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d42d29a1-7ec6-555e-8ef7-3216eb563375" :question/math-academy-id "q-117369" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arctan}⁡x?$\n\nI. $(-1,-\\frac{\\pi }{4})$\nII. $(\\sqrt{3},\\frac{\\pi }{3})$\nIII. $(\\frac{\\pi }{4},1)$" :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arctan}⁡x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{tan}⁡x.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arctan}⁡x,$ which is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}).$\n\nWith this in mind, let's check each of the points. \n\n- First,  we consider the point $(-1,-\\frac{\\pi }{4}).$ We note the following:\n\n- The point $(-\\frac{\\pi }{4},-1)$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=-\\frac{\\pi }{4}$ lies within this range. $\\,✓$\n\nTherefore, the point $(-1,-\\frac{\\pi }{4})$ lies on the graph of $y=\\operatorname{arctan}⁡x.$\n\n- Next, we consider the point $(\\sqrt{3},\\frac{\\pi }{3}).$ We note the following:\n\n- The point $(\\frac{\\pi }{3},\\sqrt{3})$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=\\frac{\\pi }{3}$ lies within this range. $\\,✓$\n\nTherefore, the point $(\\sqrt{3},\\frac{\\pi }{3})$ lies on the graph of $y=\\operatorname{arctan}⁡x.$\n\n- Finally, we consider the point $(\\frac{\\pi }{4},1).$ We note the following:\n\n- The point $(1,\\frac{\\pi }{4})$ does **not** lie on the graph of $y=\\operatorname{tan}⁡x.$  $\\,\\times $\n\nTherefore, the point $(\\frac{\\pi }{4},1)$ does **not** lie on the graph of $y=\\operatorname{arctan}⁡x.$"}] [{:db/id #edb/ref 17592186253343 :knowledge-point/_questions [{:db/id #edb/ref 17592186110582 :knowledge-point/id #uuid "262a1469-0920-565f-9268-28f0e5f1faf5" :knowledge-point/title "Finding the Total Area Bounded Between the X-Axis and a Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "629f362a-07cf-5131-b149-b6fc1e0c58ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186251357} {:answer/id #uuid "700c2728-d3d3-5572-94d5-b40f2ae63720" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186251468} {:answer/id #uuid "d2032432-4b16-5cf7-abdd-e24558719f30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186252408} {:answer/id #uuid "de546f21-a506-5006-8322-3cbc1cd3fca5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186252510} {:answer/id #uuid "df83d57c-1c50-571c-b518-d9250cbcdcca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186252525}] :answer-field/correct {:answer/id #uuid "df83d57c-1c50-571c-b518-d9250cbcdcca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186252525} :answer-field/id #uuid "b7bf2c88-b79f-50e2-9458-7e7d4dea41cc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253124}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "09dc5170-6e81-5e4c-903a-ed41666f4efc" :question/math-academy-id "q-117441" :question/problem "Find the total area of the region between the curve $y={x}^{3}-1$ and the $x$-axis from $x=-1$ to $x=3.$" :question/worked-solution "First, we find the intersections of the curve with the $x$-axis:\n\n$$\n\\begin{aligned}{x}^{3}-1 & =0 \\\\ {x}^{3} & =1 \\\\ x & =1\\end{aligned}\n$$\n\nSince $1\\in [-1,3]$, we have two regions: \n\n- The area between the curve and the $x$-axis from $x=-1$ to $x=1.$\n\n- The area between the curve and the $x$-axis from $x=1$ to $x=3.$\n\n![](images/0d/0d7fcf48509464cdd6c22962b11c3db4fe24a08fa285adeeb9e30114c9667f49.png)\n\nNotice that the region for $x\\in [-1,1]$ lies completely below the $x$-axis. Hence, the value of\n\n$$\n{\\int }_{a}^{b}y(x)\\,\\text{d}x={\\int }_{-1}^{1}({x}^{3}-1)\\,\\text{d}x\n$$\n\nwill be negative. Therefore, the area that we want is given by\n\n$$\n\\begin{aligned}{A}_{1} & =-{\\int }_{-1}^{1}({x}^{3}-1)\\,\\text{d}x \\\\  & =-{(\\frac{{x}^{4}}{4}-x)|}_{-1}^{1} \\\\  & =-([\\frac{1}{4}-1]-[\\frac{1}{4}+1]) \\\\  & =-(-\\frac{3}{4}-\\frac{5}{4}) \\\\  & =2.\\end{aligned}\n$$\n\nFor $x\\in [1,3],$ we have\n\n$$\n\\begin{aligned}{A}_{2} & ={\\int }_{a}^{b}y(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}({x}^{3}-1)\\,\\text{d}x \\\\  & ={(\\frac{{x}^{4}}{4}-x)|}_{1}^{3} \\\\  & =[\\frac{81}{4}-3]-[\\frac{1}{4}-1] \\\\  & =\\frac{69}{4}+\\frac{3}{4} \\\\  & =18.\\end{aligned}\n$$\n\nFinally, the total area is\n\n$$\nA={A}_{1}+{A}_{2}=2+18=20.\n$$"}] [{:db/id #edb/ref 17592186253345 :knowledge-point/_questions [{:db/id #edb/ref 17592186110584 :knowledge-point/id #uuid "7d89ba41-6d24-548a-bd97-66830b752ba9" :knowledge-point/title "Finding the Total Area Bounded By a Curve When It Crosses the X-Axis Several Times"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05f30d4f-ecb8-52ae-8866-b6d2b7a98d71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186250600} {:answer/id #uuid "253502e5-6b38-5479-8901-deb361427879" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "54" :db/id #edb/ref 17592186250871} {:answer/id #uuid "64cd272b-9535-5134-a77d-f5ca15ed964f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186251379} {:answer/id #uuid "b0dbd45d-8af9-5745-946c-4090c6b37a67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186252100} {:answer/id #uuid "d1bb503b-b594-53e7-a3c7-deb02b9ead9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186252404}] :answer-field/correct {:answer/id #uuid "d1bb503b-b594-53e7-a3c7-deb02b9ead9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186252404} :answer-field/id #uuid "659756fd-4676-5210-826a-b2127de62911" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252989}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5e2fabcc-cfa7-5343-adee-3a4f628a6015" :question/math-academy-id "q-117444" :question/problem "Find the total area of the region between the curve $y=9-{x}^{2}$ and the $x$-axis from $x=-3$ to $x=6.$" :question/worked-solution "First, we find the intersections of the curve with the $x$-axis:\n\n$$\n\\begin{aligned}9-{x}^{2} & =0 \\\\ (x-3)(x+3) & =0.\\end{aligned}\n$$\n\nTherefore, $x=-3$ and $x=3$ are our real solutions. Since $3\\in [-3,6]$, we have two regions: \n\n- The area between the curve and the $x$-axis from $x=-3$ to $x=3.$\n\n- The area between the curve and the $x$-axis from $x=3$ to $x=6.$\n\n![](images/70/70df9534ea4f69993871888a5f751ecd6aea9d1e0aaaf128d55442d9913b3dd5.png)\n\nFor $x\\in [-3,3]$, we obtain\n\n$$\n\\begin{aligned}{A}_{1} & ={\\int }_{a}^{b}y(x)\\,\\text{d}x \\\\  & ={\\int }_{-3}^{3}(9-{x}^{2})\\,\\text{d}x \\\\  & =9{\\int }_{-3}^{3}\\,\\text{d}x-{\\int }_{-3}^{3}{x}^{2}\\,\\text{d}x \\\\  & =9x{|}_{-3}^{3}-\\frac{{x}^{3}}{3}{|}_{-3}^{3} \\\\  & =[9(3)-9(-3)]-[\\frac{(3)^{3}}{3}-\\frac{(-3)^{3}}{3}] \\\\  & =54-18 \\\\  & =36.\\end{aligned}\n$$\n\nNotice that for $x\\in [3,6]$ the region lies completely below the $x$-axis. Hence, the value of\n\n$$\n{\\int }_{a}^{b}y(x)\\,\\text{d}x={\\int }_{-3}^{6}(9-{x}^{2})\\,\\text{d}x\n$$\n\nwill be negative. Therefore, the area that we want is given by\n\n$$\n\\begin{aligned}{A}_{2} & =-{\\int }_{-3}^{6}(9-{x}^{2})\\,\\text{d}x \\\\  & =-9{\\int }_{3}^{6}\\,\\text{d}x+{\\int }_{3}^{6}{x}^{2}\\,\\text{d}x \\\\  & =-9x{|}_{3}^{6}+\\frac{{x}^{3}}{3}{|}_{3}^{6} \\\\  & =-9[6-3]+[\\frac{(6)^{3}}{3}-\\frac{(3)^{3}}{3}] \\\\  & =-27+63 \\\\  & =36.\\end{aligned}\n$$\n\nFinally, the total area is\n\n$$\nA={A}_{1}+{A}_{2}=36+36=72.\n$$"}] [{:db/id #edb/ref 17592186253348 :knowledge-point/_questions [{:db/id #edb/ref 17592186059811 :knowledge-point/id #uuid "3878b5fa-fd5e-5984-8516-96ee17bf137b" :knowledge-point/title "Evaluating Arctangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a3316c1-4ac0-5c26-8476-d80c86af1184" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{0}^{∘}" :db/id #edb/ref 17592186250641} {:answer/id #uuid "34291d97-a586-5122-b35e-8159702623e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{45}^{∘}" :db/id #edb/ref 17592186250987} {:answer/id #uuid "92bf6b94-6bae-5b84-abbd-103b1968cf6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{60}^{∘}" :db/id #edb/ref 17592186251809} {:answer/id #uuid "edc66e35-74d5-5ef3-a497-ac870dbdfef6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{90}^{∘}" :db/id #edb/ref 17592186252633} {:answer/id #uuid "f80558ee-ad94-5b8a-b0f5-b99d360b4424" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{30}^{∘}" :db/id #edb/ref 17592186252722}] :answer-field/correct {:answer/id #uuid "34291d97-a586-5122-b35e-8159702623e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{45}^{∘}" :db/id #edb/ref 17592186250987} :answer-field/id #uuid "5f29f15e-e05d-50f4-b161-d85ef74d8576" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252973}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "be230990-e06e-5511-a145-0fc0b52f3652" :question/math-academy-id "q-117456" :question/problem "$\\operatorname{arctan}⁡(1)=$" :question/worked-solution "The range of $\\theta =\\operatorname{arctan}⁡x$ is given by\n\n$$\n-{90}^{∘}<\\theta <{90}^{∘}.\n$$\n\nNote that the angle $\\theta $ spans the first and fourth quadrants.\n\nSince $1$ is positive, our answer is an angle that lies in the first quadrant, where the tangent is positive.\n\nFrom the special values of the trigonometric functions, we know that \n\n$$\n\\operatorname{tan}⁡({45}^{∘})=1.\n$$\n\nSince ${45}^{∘}$ is an angle in the first quadrant that lies within the range of $arctan,$ we conclude that\n\n$$\n\\operatorname{arctan}⁡(1)={45}^{∘}.\n$$"}] [{:db/id #edb/ref 17592186253352 :knowledge-point/_questions [{:db/id #edb/ref 17592186059811 :knowledge-point/id #uuid "3878b5fa-fd5e-5984-8516-96ee17bf137b" :knowledge-point/title "Evaluating Arctangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "091dfe6d-dbcd-5dc8-908f-031833bf5679" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{3}" :db/id #edb/ref 17592186250636} {:answer/id #uuid "37d5087b-6859-5f3e-8798-9a0961309a86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{3}" :db/id #edb/ref 17592186251014} {:answer/id #uuid "690726ad-749f-5890-8274-26648cc3d209" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\pi " :db/id #edb/ref 17592186251420} {:answer/id #uuid "b1e69f0d-76ca-5918-8497-cea75026a9d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186252108} {:answer/id #uuid "b5c9e48f-2c4b-51db-b2d5-abde59af8121" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186252151}] :answer-field/correct {:answer/id #uuid "37d5087b-6859-5f3e-8798-9a0961309a86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{3}" :db/id #edb/ref 17592186251014} :answer-field/id #uuid "938dd839-cb93-5473-921d-1230977f6699" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253061}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "faf88325-d673-5e64-a0a2-e5898606cfcf" :question/math-academy-id "q-117461" :question/problem "$-2\\operatorname{arctan}⁡(-\\sqrt{3})=$" :question/worked-solution "First, note that the range of $\\theta =\\operatorname{arctan}⁡x$ is given by\n\n$$\n-\\frac{\\pi }{2}<\\theta <\\frac{\\pi }{2}.\n$$\n\nNote that the angle $\\theta $ spans the first and fourth quadrants.\n\nSince $-\\sqrt{3}$ is negative, our answer is an angle that lies in the fourth quadrant, where the tangent is negative.\n\nFrom the special values of the trigonometric functions and the oddness of the tangent function, we know that \n\n$$\n\\operatorname{tan}⁡(-\\frac{\\pi }{3})=-\\operatorname{tan}⁡(\\frac{\\pi }{3})=-\\sqrt{3}.\n$$\n\nSince $-\\frac{\\pi }{3}$ is an angle in the fourth quadrant that lies within the range of $arctan,$ we conclude that\n\n$$\n\\operatorname{arctan}⁡(-\\sqrt{3})=-\\frac{\\pi }{3}.\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}-2\\operatorname{arctan}⁡(-\\sqrt{3}) & =(-2)\\cdot (-\\frac{\\pi }{3}) \\\\  & =\\frac{2\\pi }{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253353 :knowledge-point/_questions [{:db/id #edb/ref 17592186059811 :knowledge-point/id #uuid "3878b5fa-fd5e-5984-8516-96ee17bf137b" :knowledge-point/title "Evaluating Arctangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37ecc819-acb1-5df5-9748-8605bfca9317" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\pi " :db/id #edb/ref 17592186251015} {:answer/id #uuid "68a0f002-cae4-5c37-8a69-4b724f88ce62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2\\pi }{3}" :db/id #edb/ref 17592186251413} {:answer/id #uuid "81c81ed5-e80c-5c65-a8b3-082014a382f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{2}" :db/id #edb/ref 17592186251648} {:answer/id #uuid "990be92e-936a-5c07-9036-ee48d86256d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\pi " :db/id #edb/ref 17592186251868} {:answer/id #uuid "ce85ac4a-bc9b-5c3a-8299-d9d1ea40fe39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4\\pi }{3}" :db/id #edb/ref 17592186252379}] :answer-field/correct {:answer/id #uuid "68a0f002-cae4-5c37-8a69-4b724f88ce62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2\\pi }{3}" :db/id #edb/ref 17592186251413} :answer-field/id #uuid "ac16ee52-49d1-5b8b-9170-ffd9df8262f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253104}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "24e984a2-585a-5608-b3a2-5f94b69b88d9" :question/math-academy-id "q-117462" :question/problem "$4\\operatorname{arctan}⁡(-\\frac{1}{\\sqrt{3}})=$" :question/worked-solution "The range of $\\theta =\\operatorname{arctan}⁡x$ is given by\n\n$$\n-\\frac{\\pi }{2}<\\theta <\\frac{\\pi }{2}.\n$$\n\nNote that the angle $\\theta $ spans the first and fourth quadrants.\n\nSince $-\\frac{1}{\\sqrt{3}}$ is negative, our answer is an angle that lies in the fourth quadrant, where the tangent is negative.\n\nFrom the special values of the trigonometric functions and the oddness of the tangent function, we know that \n\n$$\n\\operatorname{tan}⁡(-\\frac{\\pi }{6})=-\\operatorname{tan}⁡(\\frac{\\pi }{6})=-\\frac{1}{\\sqrt{3}}.\n$$\n\nSince $-\\frac{\\pi }{6}$ is an angle in the fourth quadrant that lies within the range of $arctan,$ we conclude that\n\n$$\n\\operatorname{arctan}⁡(-\\frac{1}{\\sqrt{3}})=-\\frac{\\pi }{6}.\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}4\\operatorname{arctan}⁡(-\\frac{1}{\\sqrt{3}}) & =4\\cdot (-\\frac{\\pi }{6}) \\\\  & =-\\frac{2\\pi }{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253354 :knowledge-point/_questions [{:db/id #edb/ref 17592186100815 :knowledge-point/id #uuid "90a673b6-4025-5075-9a8a-120b90bc4f45" :knowledge-point/title "The Shortest Distance Between a Point and a Perpendicular Bisector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05263274-8a30-5b9e-99c8-bc4632800973" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{7}{2},6)" :db/id #edb/ref 17592186250593} {:answer/id #uuid "26c93fc6-e7c9-527e-b808-8e8ae2deae84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6,4)" :db/id #edb/ref 17592186250886} {:answer/id #uuid "622a263a-6ba2-5b98-88d5-099953d3f597" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6,3)" :db/id #edb/ref 17592186251350} {:answer/id #uuid "8e5a5357-7eb2-5b78-bbad-edc691df5fc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,\\frac{7}{2})" :db/id #edb/ref 17592186251758} {:answer/id #uuid "fd9086da-236a-59d4-9d03-b14bbfe51a27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6,\\frac{7}{2})" :db/id #edb/ref 17592186252777}] :answer-field/correct {:answer/id #uuid "fd9086da-236a-59d4-9d03-b14bbfe51a27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6,\\frac{7}{2})" :db/id #edb/ref 17592186252777} :answer-field/id #uuid "49dfe913-70a3-528c-b8ca-29e7f976f6c6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252935}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b8647f1c-5367-5a91-bc69-e78441ce9412" :question/math-academy-id "q-117463" :question/problem "Use calculus to find the closest point to $P(6,7)$ that is equidistant to the points $A(0,1)$ and $B(0,6).$" :question/worked-solution "Let's sketch the situation.\n\n![](images/c4/c4fd419e12879af4910e5d8364426c14342c3dadb970d8bbc43d31213a6ff947.png)\n\nNote the following:\n\n- The dotted line is the *perpendicular bisector* of the segment $\\overset{―}{AB}.$\n\n- All the points on this perpendicular bisector are equidistant to $A$ and $B.$\n\n- Our task is to find the point $Q$ on this line that's closest to $P.$\n\nFirst, we create a function $S$ which represents the *squared* distance between the point $P(6,7)$ and a general point $Q(x,y),$ as follows:\n\n$$\n\\begin{aligned}S(x,y) & =(x-6)^{2}+(y-7)^{2} \\\\  & ={x}^{2}+{y}^{2}-12x-14y+85\\end{aligned}\n$$\n\nThe required point $Q(x,y)$ is equidistant to the points $A(0,1)$ and $B(0,6).$ So, by writing down $(QA)^{2}=(QB)^{2},$ we have the following constraint equation:\n\n$$\n\\begin{aligned}{{(x-0)^{2}+(y-1)^{2}}_{⏟}}_{(QA)^{2}} & ={{(x-0)^{2}+(y-6)^{2}}_{⏟}}_{(QB)^{2}}\\end{aligned}\n$$\n\nWe make $y$ the subject in the constraint equation, as follows:\n\n$$\n\\begin{aligned}(x-0)^{2}+(y-1)^{2} & =(x-0)^{2}+(y-6)^{2} \\\\ {x}^{2}+{y}^{2}-2y+1 & ={x}^{2}+{y}^{2}-12y+36 \\\\ \\cancel{{x}^{2}}+\\cancel{{y}^{2}}-2y+1 & =\\cancel{{x}^{2}}+\\cancel{{y}^{2}}-12y+36 \\\\ 10y & =35 \\\\ y & =\\frac{7}{2}\\end{aligned}\n$$\n\nSubstituting the above into our expression for $S(x,y),$ we get\n\n$$\n\\begin{aligned}S(x) & ={x}^{2}+{y}^{2}-12x-14y+85 \\\\  & ={x}^{2}+{(\\frac{7}{2})}^{2}-12x-14(\\frac{7}{2})+85 \\\\  & ={x}^{2}-12x+\\frac{193}{4}.\\end{aligned}\n$$\n\nNow, we calculate the first derivative,\n\n$$\n\\begin{aligned}{S}^{′}(x) & =2x-12,\\end{aligned}\n$$\n\nand solve ${S}^{′}(x)=0$ to find the stationary point:\n\n$$\n\\begin{aligned}{S}^{′}(x) & =0 \\\\ 2x-12 & =0 \\\\ x & =6\\end{aligned}\n$$\n\nLet's verify that this stationary point is a minimum. Taking the second derivative, we find\n\n$$\n{S}^{″}(6)=2>0.\n$$\n\nWe conclude that the stationary point $x=6$ indeed minimizes the squared distance. \n\nFinally, the $y$-coordinate is\n\n$$\ny=\\frac{7}{2}.\n$$\n\nTherefore, the required point is $(6,\\frac{7}{2}).$"}] [{:db/id #edb/ref 17592186253355 :knowledge-point/_questions [{:db/id #edb/ref 17592186096639 :knowledge-point/id #uuid "384ce5b6-40da-59a0-bc87-a1d726328cc2" :knowledge-point/title "Finding the Finite Area Bounded Between a Curve and the Y-Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32673930-9f4a-5254-90a4-683608db94ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{256}{5}" :db/id #edb/ref 17592186250980} {:answer/id #uuid "37c42776-909b-5ef6-815f-da6db5453064" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{128}{5}" :db/id #edb/ref 17592186251013} {:answer/id #uuid "6c7d65b5-ff3c-5cc0-b550-7efd3f240b02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "51" :db/id #edb/ref 17592186251445} {:answer/id #uuid "73bee433-2d27-51f0-8ea6-e77da9e58d39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{64}{5}" :db/id #edb/ref 17592186251506} {:answer/id #uuid "fe3a4e96-192d-564f-90fd-dca29f7f969c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{512}{5}" :db/id #edb/ref 17592186252783}] :answer-field/correct {:answer/id #uuid "32673930-9f4a-5254-90a4-683608db94ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{256}{5}" :db/id #edb/ref 17592186250980} :answer-field/id #uuid "be90ed80-3fb6-5d21-8795-61bcc98ca73e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253130}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4ff20307-ce27-5015-aa4b-6179740ecdbd" :question/math-academy-id "q-117482" :question/problem "Find the area of the finite region bounded between the curve $x=16-{y}^{4}$ and the $y$-axis." :question/worked-solution "First, we find the $y$-intercepts of the curve:\n\n$$\n\\begin{aligned}16-{y}^{4} & =0 \\\\ {y}^{4} & =16 \\\\ y & =\\pm 2\\end{aligned}\n$$\n\nNext, we draw a sketch of the region:\n\n![](images/48/488788313bd32999611a520ec26e4ba6fd68a56e0333a7252a0faaf7107cad90.png)\n\nWe want to find the area between the curve $x=16-{y}^{4}$ and the $y$-axis from  $y=-2$ to $y=2.$ \nTo find the area, we compute the corresponding definite integral, as follows:\n\n$$\n\\begin{aligned}A & ={\\int }_{c}^{d}x(y)\\,\\text{d}y \\\\  & ={\\int }_{-2}^{2}(16-{y}^{4})\\,\\text{d}y \\\\  & =16{\\int }_{-2}^{2}\\,\\text{d}y-{\\int }_{-2}^{2}{y}^{4}\\,\\text{d}y \\\\  & =16\\cdot y{|}_{-2}^{2}-{\\frac{{y}^{5}}{5}|}_{-2}^{2} \\\\  & =16\\cdot (2-(-2))-(\\frac{{2}^{5}}{5}-\\frac{(-2)^{5}}{5}) \\\\  & =64-\\frac{64}{5} \\\\  & =\\frac{256}{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253356 :knowledge-point/_questions [{:db/id #edb/ref 17592186096639 :knowledge-point/id #uuid "384ce5b6-40da-59a0-bc87-a1d726328cc2" :knowledge-point/title "Finding the Finite Area Bounded Between a Curve and the Y-Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13908070-27e4-55b6-b9d8-747ae31aa53b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186250723} {:answer/id #uuid "6092f928-5d89-5252-a2d6-19742c141c00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186251343} {:answer/id #uuid "c7ef3c84-c861-5040-a544-3c158c2fb43a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{81}{2}" :db/id #edb/ref 17592186252325} {:answer/id #uuid "c9504c0c-6404-571e-91b7-9add25bffd0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{81}{4}" :db/id #edb/ref 17592186252334} {:answer/id #uuid "e081921a-0bfa-5de5-8331-106f7bdc3b90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{27}{2}" :db/id #edb/ref 17592186252531}] :answer-field/correct {:answer/id #uuid "c9504c0c-6404-571e-91b7-9add25bffd0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{81}{4}" :db/id #edb/ref 17592186252334} :answer-field/id #uuid "2d15094c-346d-5dd8-beeb-65fe9070d24a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252882}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ad970949-6b8c-5c6c-9a59-687628bd497c" :question/math-academy-id "q-117485" :question/problem "Find the area of the finite region bounded between the curve $x=9y-{y}^{3}$ and the $y$-axis for $y\\ge 0.$" :question/worked-solution "First, we find the $y$-intercepts of the curve:\n\n$$\n\\begin{aligned}9y-{y}^{3} & =0 \\\\ y(9-{y}^{2}) & =0 \\\\ y & =0,\\pm 3\\end{aligned}\n$$\n\nNext, we draw a sketch of the region:\n\n![](images/bb/bbcf218e7b6181c861ba4c804357cc53ae6004453914259a9fe98ad5f09ac4d4.png)\n\nWe want to find the area between the curve $x=9y-{y}^{3}$ and the $y$-axis from  $y=0$ to $y=3.$ \nTo find the area, we compute the corresponding definite integral, as follows:\n\n$$\n\\begin{aligned}A & ={\\int }_{c}^{d}x(y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{3}(9y-{y}^{3})\\,\\text{d}y \\\\  & =9{\\int }_{0}^{3}y\\,\\text{d}y-{\\int }_{0}^{3}{y}^{3}\\,\\text{d}y \\\\  & =9\\cdot {\\frac{{y}^{2}}{2}|}_{0}^{3}-{\\frac{{y}^{4}}{4}|}_{0}^{3} \\\\  & =9\\cdot (\\frac{(3)^{2}}{2}-0)-(\\frac{(3)^{4}}{4}-0) \\\\  & =\\frac{81}{2}-\\frac{81}{4} \\\\  & =\\frac{81}{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253359 :knowledge-point/_questions [{:db/id #edb/ref 17592186096703 :knowledge-point/id #uuid "17099881-d7b9-54d9-a29a-4f5f28561cd3" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola with Vertex at the Origin Given Another Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9083a1ff-c8ef-5afc-828e-a8cec3a76262" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-4x" :db/id #edb/ref 17592186251782} {:answer/id #uuid "c1ed0205-2219-53c5-93db-3e51870d2e3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-8x" :db/id #edb/ref 17592186252263} {:answer/id #uuid "d036e7d8-bfd8-564c-9d05-2f00cd59df97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=6x" :db/id #edb/ref 17592186252392} {:answer/id #uuid "e6a241de-2088-5ff5-b151-6babb797b063" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=8x" :db/id #edb/ref 17592186252572} {:answer/id #uuid "f5a4b633-74e0-5ab4-bef8-b8ea2b20ff28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-6x" :db/id #edb/ref 17592186252703}] :answer-field/correct {:answer/id #uuid "c1ed0205-2219-53c5-93db-3e51870d2e3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-8x" :db/id #edb/ref 17592186252263} :answer-field/id #uuid "230f8ef2-ddf5-5d6c-b9d9-e998a0e4bf9e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252868}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ecb5a0f2-ba13-55c2-8466-28d0f08c1c9a" :question/math-academy-id "q-11751" :question/problem "Find the equation of the left-opening parabola that has its vertex at $(0,0)$ and passes through the point $(-8,8).$" :question/worked-solution "The general standard equation of a parabola whose vertex is $(0,0)$ and whose arms open right or left is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSince we know the given parabola passes through the point $(-8,8),$ we can substitute $x=-8$ and $y=8$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {8}^{2} & =4p(-8) \\\\ 64 & =-32p \\\\ p & =-2.\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {y}^{2} & =4(-2)x \\\\ {y}^{2} & =-8x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253360 :knowledge-point/_questions [{:db/id #edb/ref 17592186096703 :knowledge-point/id #uuid "17099881-d7b9-54d9-a29a-4f5f28561cd3" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola with Vertex at the Origin Given Another Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79b4f2fe-61fe-595e-9afc-66fee93d0af6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-4x" :db/id #edb/ref 17592186251565} {:answer/id #uuid "99d6d289-0be0-5b5b-a332-7709c8440710" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-2x" :db/id #edb/ref 17592186251875} {:answer/id #uuid "a110bdeb-4b4c-5c86-a664-7f5138d2c1f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=2x" :db/id #edb/ref 17592186251943} {:answer/id #uuid "ac5205e0-26dd-5e9a-ba86-f903d4f49d2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=6x" :db/id #edb/ref 17592186252050} {:answer/id #uuid "cd1632aa-3461-5d5c-a789-47a490ec4b2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=4x" :db/id #edb/ref 17592186252362}] :answer-field/correct {:answer/id #uuid "a110bdeb-4b4c-5c86-a664-7f5138d2c1f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=2x" :db/id #edb/ref 17592186251943} :answer-field/id #uuid "01ac0480-1bc1-5114-8725-a56fa87f797d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252809}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "52486dc2-a5ad-5323-887e-ec059a62d92e" :question/math-academy-id "q-11753" :question/problem "Find the equation of the right-opening parabola that has its vertex at  $(0,0)$ and passes through the point $(8,4).$" :question/worked-solution "The general standard equation of a parabola whose vertex is $(0,0)$ and whose arms open right or left is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSince we know the given parabola passes through the point $(8,4),$ we can substitute $x=8$ and $y=4$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {4}^{2} & =4p(8) \\\\ 16 & =32p \\\\ p & =\\frac{1}{2}.\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {y}^{2} & =4(\\frac{1}{2})x \\\\ {y}^{2} & =2x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186096995 :knowledge-point/_questions [{:db/id #edb/ref 17592186096702 :knowledge-point/id #uuid "75fd35db-6b4e-5820-b6ac-925d24a0f117" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola with Vertex at the Origin Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "059aa299-ef4d-5d9e-89fb-eb28384533c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=\\frac{8}{3}x" :db/id #edb/ref 17592186250597} {:answer/id #uuid "583d81d4-b1f4-5ad9-9cd3-2232b14d4025" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=2x" :db/id #edb/ref 17592186251275} {:answer/id #uuid "8117bad0-2535-5fe3-966b-bf698bce7f0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=4x" :db/id #edb/ref 17592186251641} {:answer/id #uuid "bad0d7d9-889c-5b4c-8599-b8db9ed11b35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=\\frac{16}{3}x" :db/id #edb/ref 17592186252197} {:answer/id #uuid "c8f07a14-50c2-5b49-92c1-066157f2308e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=\\frac{4}{3}x" :db/id #edb/ref 17592186252330}] :answer-field/correct {:answer/id #uuid "c8f07a14-50c2-5b49-92c1-066157f2308e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=\\frac{4}{3}x" :db/id #edb/ref 17592186252330} :answer-field/id #uuid "46732a7b-c2df-54b6-985e-3918b0cefa7a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252927}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e658f76e-d8f1-5fc3-aee3-15b3559d9455" :question/math-academy-id "q-11754" :question/problem "![](images/01/0119821efe6d06a4d43278f09ab7ba4b471a59ffca94d1fe5d3bf67fd71c44a0.png)\n\nWhat is the equation of the parabola shown above?" :question/worked-solution "From the diagram we see that the arms of the parabola open to the right. The parabola has its vertex at $(0,0)$ and passes through the point $(12,4).$\n\nThe general standard equation of a parabola whose vertex is $(0,0)$ and whose arms open right or left is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSince we know the given parabola passes through the point $(12,4),$ we can substitute $x=12$ and $y=4$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {4}^{2} & =4p(12) \\\\ 16 & =48p \\\\ p & =\\frac{1}{3}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {y}^{2} & =4(\\frac{1}{3})x \\\\ {y}^{2} & =\\frac{4}{3}x.\\end{aligned}\n$$\n\nNotice that the arms of the parabola open to the right since $p=\\frac{1}{3}$ is positive."}] [{:db/id #edb/ref 17592186253361 :knowledge-point/_questions [{:db/id #edb/ref 17592186087661 :knowledge-point/id #uuid "ff002e26-f100-5b44-9175-a363d0808f9d" :knowledge-point/title "Finding a Single Point of Intersection of a Circle with a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0811fee7-a77b-579d-891f-08084b713ce0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2.5,-3.5)" :db/id #edb/ref 17592186250621} {:answer/id #uuid "15ab3750-872e-5c4e-bf5b-5f5b36936075" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-2)" :db/id #edb/ref 17592186250740} {:answer/id #uuid "4a3bafe8-c05e-5431-ae37-838bd1502a9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,-5)" :db/id #edb/ref 17592186251171} {:answer/id #uuid "7a984c78-7a48-5e9f-8082-80889b9fe81b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,1)" :db/id #edb/ref 17592186251573} {:answer/id #uuid "b27d74d8-aa06-5463-b3f2-b05fec97e1c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1.5,-6.5)" :db/id #edb/ref 17592186252112}] :answer-field/correct {:answer/id #uuid "15ab3750-872e-5c4e-bf5b-5f5b36936075" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-2)" :db/id #edb/ref 17592186250740} :answer-field/id #uuid "dc36b38a-f06c-5b7e-85ee-e8b056c29768" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253181}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a2e5f12e-d95e-505c-bfdb-3a5f6be1539e" :question/math-academy-id "q-117542" :question/problem "![](images/a3/a3a9751a19c9a853c425b81ce63ccb76b4cd4350f152df3dbe00a1cdb0f8cdab.png)\n\nFind the point where the line $y=-3x-11$ intersects the circle ${x}^{2}+(y+1)^{2}=10.$" :question/worked-solution "To find $x$-coordinate of the intersection point, we need to substitute $y=-3x-11$ into the equation of the circle and solve the resulting equation for $x:$\n\n$$\n\\begin{aligned}{x}^{2}+(y+1)^{2} & =10 \\\\ {x}^{2}+(-3x-11+1)^{2} & =10 \\\\ {x}^{2}+(-3x-10)^{2} & =10 \\\\ {x}^{2}+9{x}^{2}+60x+100 & =10 \\\\ 10{x}^{2}+60x+100 & =10 \\\\ 10{x}^{2}+60x+90 & =0 \\\\ {x}^{2}+6x+9 & =0 \\\\ (x+3)^{2} & =0 \\\\ x+3 & =0 \\\\ x & =-3\\end{aligned}\n$$\n\nTo find $y$-coordinate of the intersection point, we need to substitute $x=-3$ into the equation of the line and compute $y$-value, as follows:\n\n$$\n\\begin{aligned}y & =-3x-11 \\\\  & =-3(-3)-11 \\\\  & =-2\\end{aligned}\n$$\n\nTherefore, the line $y=-3x-11$ intersects the circle ${x}^{2}+(y+1)^{2}=10$ at the point $(-3,-2).$"}] [{:db/id #edb/ref 17592186253362 :knowledge-point/_questions [{:db/id #edb/ref 17592186087661 :knowledge-point/id #uuid "ff002e26-f100-5b44-9175-a363d0808f9d" :knowledge-point/title "Finding a Single Point of Intersection of a Circle with a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e407b00-43bc-5c4b-a5e5-3d9577735776" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186250950} {:answer/id #uuid "63f0aa4a-c55d-5a18-ae5c-ee4005c1d0a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186251372} {:answer/id #uuid "8b04dd44-f950-53dd-94a1-6d2dbab90f6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186251727} {:answer/id #uuid "a3bbe0dc-3bc8-5d52-a74d-a21a13f5efad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186251966} {:answer/id #uuid "fdb36857-b59b-51ca-ac72-b2c0438fb869" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186252779}] :answer-field/correct {:answer/id #uuid "8b04dd44-f950-53dd-94a1-6d2dbab90f6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186251727} :answer-field/id #uuid "2015087a-90cf-5c25-aabe-d7944268845d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252862}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "277bb7fd-8284-514b-90e8-ffc120633d0d" :question/math-academy-id "q-117546" :question/problem "![](images/91/91ead412d3e333fd4bfbcce785813a530e66ca39858ca108e9920d349443bb53.png)\n\nFind the $x$-coordinate of the point where the line $-2x+3y=12$ intersects the circle $(x+1)^{2}+(y+1)^{2}=13$ (sketched above)." :question/worked-solution "First, we rearrange the equation $-2x+3y=12,$ as follows:\n\n$$\ny=\\frac{2x}{3}+4\n$$\n\nTo find $x$-coordinates of the intersection points, we need to substitute $y=\\frac{2x}{3}+4$ into the equation of the circle and solve the resulting equation for $x:$\n\n$$\n\\begin{aligned}(x+1)^{2}+(y+1)^{2} & =13 \\\\ (x+1)^{2}+{(\\frac{2x}{3}+4+1)}^{2} & =13 \\\\ (x+1)^{2}+{(\\frac{2x}{3}+5)}^{2} & =13 \\\\ {x}^{2}+2x+1+\\frac{4{x}^{2}}{9}+\\frac{20x}{3}+25 & =13 \\\\ \\frac{13{x}^{2}}{9}+\\frac{26x}{3}+13 & =0 \\\\ {x}^{2}+6x+9 & =0 \\\\ (x+3)^{2} & =0 \\\\ x+3 & =0 \\\\ x & =-3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253363 :knowledge-point/_questions [{:db/id #edb/ref 17592186096702 :knowledge-point/id #uuid "75fd35db-6b4e-5820-b6ac-925d24a0f117" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola with Vertex at the Origin Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "133fede6-e6b3-5934-9ab6-600b897e76c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-2x" :db/id #edb/ref 17592186250719} {:answer/id #uuid "7bb9ca10-8ea3-5cda-814e-af155fd838bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-x" :db/id #edb/ref 17592186251583} {:answer/id #uuid "c8c06d53-55cc-51d9-bc54-73807258d08f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=x" :db/id #edb/ref 17592186252328} {:answer/id #uuid "d7c2b286-9473-5923-a0df-50419f5281e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-3x" :db/id #edb/ref 17592186252465} {:answer/id #uuid "ef673879-992e-531a-9cc6-362a14d4f889" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=2x" :db/id #edb/ref 17592186252648}] :answer-field/correct {:answer/id #uuid "7bb9ca10-8ea3-5cda-814e-af155fd838bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-x" :db/id #edb/ref 17592186251583} :answer-field/id #uuid "8f1d9cb5-e489-5d90-befc-482609c96a6c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253053}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5b52b18c-f18d-51d2-9931-b8f3ebe75944" :question/math-academy-id "q-11756" :question/problem "![](images/58/58c92cc542f027ec882191d2b4631f9fcf3704820b2825a18f30dbdc3f59d07b.png)\n\nWhat is the equation of the parabola shown above?" :question/worked-solution "From the diagram we see that the arms of the parabola open to the left. The parabola has its vertex at $(0,0)$ and passes through the point $(-4,2).$\n\nThe general standard equation of a parabola whose vertex is $(0,0)$ and whose arms open right or left is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSince we know the given parabola passes through the point $(-4,2),$ we can substitute $x=-4$ and $y=2$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {2}^{2} & =4p(-4) \\\\ 4 & =-16p \\\\ p & =-\\frac{1}{4}.\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {y}^{2} & =4(-\\frac{1}{4})x \\\\ {y}^{2} & =-x.\\end{aligned}\n$$\n\nNotice that the arms of the parabola open to the left since $p=-\\frac{1}{4}$ is negative."}] [{:db/id #edb/ref 17592186253366 :knowledge-point/_questions [{:db/id #edb/ref 17592186129121 :knowledge-point/id #uuid "7f8fa2b3-ccaa-5390-89fa-03e338cf8690" :knowledge-point/title "Determining the Amplitude of a Transformed Sinusoidal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42d9acc7-d7bc-5ee0-a5fe-5e4dd49f1b24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186251112} {:answer/id #uuid "62a72008-6a6e-556c-809d-015ca2b2740f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186251358} {:answer/id #uuid "d1881db5-b1bc-59b9-9956-32e11311533c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186252402} {:answer/id #uuid "f784db78-b2a6-5828-92f9-43c51bb6371d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186252716} {:answer/id #uuid "fdfe367d-16eb-5c43-87a8-b57680a82f9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186252780}] :answer-field/correct {:answer/id #uuid "f784db78-b2a6-5828-92f9-43c51bb6371d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186252716} :answer-field/id #uuid "e24beebb-313f-5175-ae17-e942cb6940f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253192}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1489edd6-f3f4-5ab1-9410-746b5fd6547f" :question/math-academy-id "q-117570" :question/problem "What is the amplitude of the function $f(x)=4\\operatorname{cos}⁡(2x+3)?$" :question/worked-solution "Given a function in the form $f(x)=A\\operatorname{cos}⁡(Bx+C)+D,$ the amplitude is $|A|.$\n\nSince $A=4,$ we have that the amplitude is $|A|=|4|=4.$"}] [{:db/id #edb/ref 17592186253369 :knowledge-point/_questions [{:db/id #edb/ref 17592186129122 :knowledge-point/id #uuid "1eeb42af-74ee-53d7-af9f-be171f77968f" :knowledge-point/title "Calculating the Period of a Transformed Sinusoidal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4161544d-5503-509c-a919-47b75546d693" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{2}" :db/id #edb/ref 17592186251094} {:answer/id #uuid "ab0b8f2d-8bf9-5548-96dd-fe899f5d298f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\pi }{3}" :db/id #edb/ref 17592186252036} {:answer/id #uuid "ba23df8f-a679-5d5c-bde8-2b7238d24224" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186252191} {:answer/id #uuid "c9834705-9dcd-5c24-afb6-f095959807d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8\\pi }{3}" :db/id #edb/ref 17592186252335} {:answer/id #uuid "f25fe0b5-3a2d-5c1e-b5a3-425fbf7a30c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186252674}] :answer-field/correct {:answer/id #uuid "c9834705-9dcd-5c24-afb6-f095959807d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8\\pi }{3}" :db/id #edb/ref 17592186252335} :answer-field/id #uuid "918ffa31-2155-56a2-9928-59d9d880148e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253057}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "53685d44-d788-5019-bc63-97c441bd2453" :question/math-academy-id "q-117578" :question/problem "What is the period of the function $f(x)=-3\\operatorname{sin}⁡(\\frac{3x}{4}+\\frac{\\pi }{3})?$" :question/worked-solution "Given a function in the form $y=A\\operatorname{sin}⁡(Bx+C)+D,$ the period is $\\frac{2\\pi }{B}.$\n\nIn our case, we have that $B=\\frac{3}{4}.$ Therefore, the period is $\\frac{2\\pi }{(\\frac{3}{4})}=\\frac{8\\pi }{3}.$"}] [{:db/id #edb/ref 17592186253372 :knowledge-point/_questions [{:db/id #edb/ref 17592186203961 :knowledge-point/id #uuid "58c7cd44-30a9-5f61-822c-13640ad41c93" :knowledge-point/title "Finding the Zeros of a Transformed Sine or Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d740ebb-367e-5b13-abb3-4aaa7aaffcc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{6}+\\frac{n\\pi }{2}" :db/id #edb/ref 17592186251327} {:answer/id #uuid "76a2175d-f7a4-5539-8d5c-3821bd16c125" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{12}+\\frac{n\\pi }{6}" :db/id #edb/ref 17592186251531} {:answer/id #uuid "a02621c3-5f65-5847-b218-aabe23216fce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{6}+\\frac{n\\pi }{3}" :db/id #edb/ref 17592186251935} {:answer/id #uuid "cce190ce-0319-5382-a9e1-b39ca5b6c857" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{12}+\\frac{n\\pi }{3}" :db/id #edb/ref 17592186252359} {:answer/id #uuid "e26fda5d-8dbd-578f-ba57-15366c54f032" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{12}+\\frac{n\\pi }{4}" :db/id #edb/ref 17592186252543}] :answer-field/correct {:answer/id #uuid "cce190ce-0319-5382-a9e1-b39ca5b6c857" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{12}+\\frac{n\\pi }{3}" :db/id #edb/ref 17592186252359} :answer-field/id #uuid "b25237fb-1e27-5e8c-8801-00721dc99e4b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253115}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e6c40bb9-f96b-5776-9878-956cda7f4ab8" :question/math-academy-id "q-117602" :question/problem "Which expression gives all of the zeros of $y=\\operatorname{sin}⁡(3x-\\frac{\\pi }{4})?$  Assume that $n$ is an integer." :question/worked-solution "First, let's start by defining a new variable $X$ as\n\n$$\nX=3x-\\frac{\\pi }{4}.\n$$\n\nSo, we need to calculate the zeros of \n\n$$\ny=\\operatorname{sin}⁡X.\n$$\n\nThe zeros of this function are given by the following expression:\n\n$$\nX=n\\pi \n$$\n\nwhere $n$ is an integer.\n\nTo find the zeros of our original function, we rewrite $X$ in terms of the original variable $x$ and solve the resulting equation for $x:$\n\n$$\n\\begin{aligned}X & =n\\pi  \\\\ 3x-\\frac{\\pi }{4} & =n\\pi  \\\\ 3x & =\\frac{\\pi }{4}+n\\pi  \\\\ x & =\\frac{\\pi }{12}+\\frac{n\\pi }{3}\\end{aligned}\n$$\n\nTherefore, we conclude that the zeros are $x=\\frac{\\pi }{12}+\\frac{n\\pi }{3},$ where $n$ is any integer."}] [{:db/id #edb/ref 17592186253374 :knowledge-point/_questions [{:db/id #edb/ref 17592186203963 :knowledge-point/id #uuid "75e981a4-ba75-5db2-81ab-b321953cc225" :knowledge-point/title "Minima of Transformed Sine or Cosine Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a6315d9-4c5b-52e3-98df-900d3c444852" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{10}+\\frac{n\\pi }{5}" :db/id #edb/ref 17592186250644} {:answer/id #uuid "50caab44-146e-5114-bb63-a98abf44bbf0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{5}+\\frac{n\\pi }{5}" :db/id #edb/ref 17592186251216} {:answer/id #uuid "7d8a89f1-cd1e-5d53-97df-4d4822adf932" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\pi }{5}+\\frac{2n\\pi }{5}" :db/id #edb/ref 17592186251602} {:answer/id #uuid "8cef8dea-f51e-5b0b-821f-4305afcb5ffc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{2\\pi }{5}+\\frac{2n\\pi }{5}" :db/id #edb/ref 17592186251744} {:answer/id #uuid "a7938484-56c7-5ea3-8eac-d9b734d000ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\pi }{10}+2n\\pi " :db/id #edb/ref 17592186251997}] :answer-field/correct {:answer/id #uuid "7d8a89f1-cd1e-5d53-97df-4d4822adf932" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\pi }{5}+\\frac{2n\\pi }{5}" :db/id #edb/ref 17592186251602} :answer-field/id #uuid "f788a829-1171-5925-a3c0-50bd4a554edb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253243}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "21457735-cc06-5dc4-85da-719f77cfb1e9" :question/math-academy-id "q-117609" :question/problem "Consider the function $f(x)=3\\operatorname{sin}⁡(5x+\\frac{\\pi }{2}).$ Which expression gives all of the values of $x$ at which $f(x)$ attains its minimum value? Assume that $n$ is an integer." :question/worked-solution "First, let's start by defining a new variable $X$ as\n\n$$\nX=5x+\\frac{\\pi }{2}.\n$$\n\nSo, we need to calculate $X$-values at the minima of\n\n$$\nf(x)=3\\operatorname{sin}⁡X.\n$$\n\nThe $X$-values at the minima are given by the following expression:\n\n$$\nX=-\\frac{\\pi }{2}+2n\\pi \n$$\n\nwhere $n$ is an integer.\n\nTo find the $x$-values at the minima of our original function, we rewrite $X$ in terms of the original variable $x$ and solve the resulting equation for $x:$\n\n$$\n\\begin{aligned}X & =-\\frac{\\pi }{2}+2n\\pi  \\\\ 5x+\\frac{\\pi }{2} & =-\\frac{\\pi }{2}+2n\\pi  \\\\ 5x & =-\\pi +2n\\pi  \\\\ x & =-\\frac{\\pi }{5}+\\frac{2n\\pi }{5}\\end{aligned}\n$$\n\nWe conclude that the values of $x$ that minimize $f(x)$ are given by $x=-\\frac{\\pi }{5}+\\frac{2n\\pi }{5},$ where $n$ is any integer."}] [{:db/id #edb/ref 17592186373687 :knowledge-point/_questions [{:db/id #edb/ref 17592186096703 :knowledge-point/id #uuid "17099881-d7b9-54d9-a29a-4f5f28561cd3" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola with Vertex at the Origin Given Another Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "872a2269-3052-5ab5-95d0-5097d1a25948" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-\\frac{8}{3}x" :db/id #edb/ref 17592186373689} {:answer/id #uuid "9ae9ebc1-cccc-5e27-aed5-8977b108561d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=\\frac{4}{3}x" :db/id #edb/ref 17592186373690} {:answer/id #uuid "ff8da08a-86de-5e75-b358-78c4bd37ae62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-\\frac{16}{3}x" :db/id #edb/ref 17592186373691} {:answer/id #uuid "30891f3a-3a59-5735-a045-d3f3eaf7cb5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=\\frac{16}{3}x" :db/id #edb/ref 17592186373692} {:answer/id #uuid "74827790-27dc-531a-a346-fa5981e4aed8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=\\frac{8}{3}x" :db/id #edb/ref 17592186373693}] :answer-field/correct {:answer/id #uuid "30891f3a-3a59-5735-a045-d3f3eaf7cb5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=\\frac{16}{3}x" :db/id #edb/ref 17592186373692} :answer-field/id #uuid "479619fd-ab15-53a4-bc46-fa419417a436" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373688}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "90908d5a-75b7-57fc-8984-a4085f0697b4" :question/math-academy-id "q-11765" :question/problem "Find the equation of the right-opening parabola that has its vertex at $(0,0)$ and passes through the point $(12,8).$" :question/worked-solution "The general standard equation of a parabola whose vertex is $(0,0)$ and whose arms open right or left is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSince we know the given parabola passes through the point $(12,8),$ we can substitute $x=12$ and $y=8$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {8}^{2} & =4p(12) \\\\ 64 & =48p \\\\ p & =\\frac{4}{3}.\\end{aligned}\n$$\n\nHence, the equation of the parabola is \n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {y}^{2} & =4(\\frac{4}{3})x \\\\ {y}^{2} & =\\frac{16}{3}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253384 :knowledge-point/_questions [{:db/id #edb/ref 17592186129099 :knowledge-point/id #uuid "6506f7e3-4c69-5352-a09d-262adee65e59" :knowledge-point/title "Determining the Period of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a24ca73-da2f-5891-880a-ef75f6b9593c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186250779} {:answer/id #uuid "7150f51b-e3ac-5d81-a7f7-48ee5bc0bba5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\pi " :db/id #edb/ref 17592186251481} {:answer/id #uuid "78cfaed6-e561-54a3-bf1b-803861939fec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186251555} {:answer/id #uuid "8a4ab11c-2641-522c-977a-0adc46be731f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\pi " :db/id #edb/ref 17592186251718} {:answer/id #uuid "f94e9a48-ac9c-5839-8dce-557d1258a588" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186252735}] :answer-field/correct {:answer/id #uuid "1a24ca73-da2f-5891-880a-ef75f6b9593c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186250779} :answer-field/id #uuid "adab447b-5cdd-5271-ba5a-532032cbadc6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253107}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7daa9d90-3598-5b04-bfa2-8fabe3b59b76" :question/math-academy-id "q-117659" :question/problem "Calculate the period of the function $f(x)=\\operatorname{tan}⁡(3x)+6.$" :question/worked-solution "Given a function of the form $y=A\\operatorname{tan}⁡(Bx+C)+D,$ the period is $\\frac{\\pi }{B}.$\n\nIn our case, we have that $B=3.$ Therefore, the period is $\\frac{\\pi }{3}.$"}] [{:db/id #edb/ref 17592186253386 :knowledge-point/_questions [{:db/id #edb/ref 17592186129099 :knowledge-point/id #uuid "6506f7e3-4c69-5352-a09d-262adee65e59" :knowledge-point/title "Determining the Period of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2430686f-6354-5ae3-a56a-86797016a196" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186250867} {:answer/id #uuid "84c30401-b464-5d98-8a9b-267f533cca26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\pi " :db/id #edb/ref 17592186251667} {:answer/id #uuid "97869399-0a57-5928-b446-b55279c01911" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186251853} {:answer/id #uuid "a5606c09-671a-5dc4-abd2-15172f36984e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186251979} {:answer/id #uuid "ab67f75e-df9d-5d97-89f6-287ab3d2483f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{8}" :db/id #edb/ref 17592186252038}] :answer-field/correct {:answer/id #uuid "97869399-0a57-5928-b446-b55279c01911" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186251853} :answer-field/id #uuid "5f5b3662-7c4a-554a-a3fa-0abb3a6d9754" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252975}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dc8f3fd2-a7ad-59ae-81ee-947a33e17f52" :question/math-academy-id "q-117661" :question/problem "Calculate the period of the function $f(x)=-3\\operatorname{tan}⁡(\\frac{8x-\\pi }{4}).$" :question/worked-solution "Given a function of the form $y=A\\operatorname{tan}⁡(Bx+C)+D,$ the period is $\\frac{\\pi }{B}.$\n\nIn our case, we have that\n\n$$\nf(x)=-3\\operatorname{tan}⁡(\\frac{8x-\\pi }{4})=-3\\operatorname{tan}⁡(2x-\\frac{\\pi }{4}).\n$$\n\nTherefore, $B=2,$ and so the period is $\\frac{\\pi }{2}.$"}] [{:db/id #edb/ref 17592186253388 :knowledge-point/_questions [{:db/id #edb/ref 17592186078597 :knowledge-point/id #uuid "ec980fcb-97ed-5c60-94de-0521d9d7df27" :knowledge-point/title "Calculating the Definite Integral of a Piecewise Continuous Function Given the Function Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d4a48c7-18c0-5b27-a8e0-623931f72950" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186250797} {:answer/id #uuid "2a26043f-1a74-5d46-ab72-245ac72a1903" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186250913} {:answer/id #uuid "713355a4-0b80-5592-878a-5c71e15597d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186251479} {:answer/id #uuid "776895cf-ed45-5d0b-b027-d5f1e4d9bb87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "84" :db/id #edb/ref 17592186251539} {:answer/id #uuid "a41c5694-141e-57eb-ad49-4156e0170d9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "62" :db/id #edb/ref 17592186251969}] :answer-field/correct {:answer/id #uuid "776895cf-ed45-5d0b-b027-d5f1e4d9bb87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "84" :db/id #edb/ref 17592186251539} :answer-field/id #uuid "411941eb-2465-5aee-b349-c0c0a6d7e2b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252916}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "444a864a-4329-515b-a5d7-ab51253bb56b" :question/math-academy-id "q-117666" :question/problem "The function $f(x)$ is defined below. What is the value of \n${\\int }_{-5}^{1}f(x)\\,\\text{d}x?$\n\n$$\nf(x)={\\begin{aligned}7-3x, & x<-1 \\\\ 10, & x\\ge -1\\end{aligned}\n$$" :question/worked-solution "By the additive property of the definite integral, we have\n\n$$\n\\begin{aligned}{\\int }_{-5}^{1}f(x)\\,\\text{d}x & ={\\int }_{-5}^{-1}(7-3x)\\,\\text{d}x+{\\int }_{-1}^{1}10\\,\\text{d}x \\\\  & =(7x-3\\frac{{x}^{2}}{2}){|}_{-5}^{-1}+10x{|}_{-1}^{1} \\\\  & =[7(-1)-3\\frac{(-1)^{2}}{2}-7(-5)+3\\frac{(-5)^{2}}{2}]+10[(1)-(-1)] \\\\  & =[28+36]+10[2] \\\\  & =64+20 \\\\  & =84.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253397 :knowledge-point/_questions [{:db/id #edb/ref 17592186129101 :knowledge-point/id #uuid "8854eaba-96c7-5ea8-a071-7ff7c954f943" :knowledge-point/title "Finding a General Expression for the Asymptotes of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16b544f9-45ed-52b5-8a10-492ef7f4a669" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=n\\cdot {30}^{∘}" :db/id #edb/ref 17592186250750} {:answer/id #uuid "54f09443-1da3-52d4-89f7-68f073373233" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=n\\cdot {20}^{∘}" :db/id #edb/ref 17592186251250} {:answer/id #uuid "87855055-3d0a-5377-8e83-180ea0f68c3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=n\\cdot {120}^{∘}" :db/id #edb/ref 17592186251691} {:answer/id #uuid "9325c435-93c8-5008-832e-ae2119d01416" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=n\\cdot {90}^{∘}" :db/id #edb/ref 17592186251814} {:answer/id #uuid "eb2ec20d-773b-513c-b262-9a0a45f8791c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=n\\cdot {60}^{∘}" :db/id #edb/ref 17592186252614}] :answer-field/correct {:answer/id #uuid "eb2ec20d-773b-513c-b262-9a0a45f8791c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=n\\cdot {60}^{∘}" :db/id #edb/ref 17592186252614} :answer-field/id #uuid "b3f9041f-2602-5a62-b684-748173858460" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253118}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "41c041cc-5fd3-5771-8502-8b1349fc86e0" :question/math-academy-id "q-117692" :question/problem "Which of the following expressions gives all of the vertical asymptotes of the function  $f(x)=2\\operatorname{cot}⁡(3x)-5,$  where \n$x$ is measured in degrees? Assume that $n$ is an integer." :question/worked-solution "The asymptotes of $y=\\operatorname{cot}⁡x$ are given by the expression\n\n$$\nx=n\\cdot {180}^{∘},\n$$\n\nwhere $n$ is an integer.\n\nTo find the asymptotes of $2\\operatorname{cot}⁡(3x)-5,$ we replace the $x$ on the left-hand side of the above with $(3x).$ This gives\n\n$$\n3x=n\\cdot {180}^{∘}.\n$$\n\nSolving for $x,$ we get \n\n$$\n\\begin{aligned}3x & =n\\cdot {180}^{∘} \\\\ x & =\\frac{n\\cdot {180}^{∘}}{3} \\\\ x & =n\\cdot {60}^{∘}.\\end{aligned}\n$$\n\nTherefore, we conclude that the expression giving all the vertical asymptotes is $x=n\\cdot {60}^{∘},$ where $n$ is an integer."}] [{:db/id #edb/ref 17592186253398 :knowledge-point/_questions [{:db/id #edb/ref 17592186129101 :knowledge-point/id #uuid "8854eaba-96c7-5ea8-a071-7ff7c954f943" :knowledge-point/title "Finding a General Expression for the Asymptotes of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "192cc94d-2bdc-5aa5-8395-3038aa3ee599" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{8}+\\frac{n\\pi }{8}" :db/id #edb/ref 17592186250773} {:answer/id #uuid "4831ea5f-e09b-527b-af85-515fffa0b3b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{16}+\\frac{n\\pi }{16}" :db/id #edb/ref 17592186251154} {:answer/id #uuid "5214d5d3-d621-543f-8d56-e6f7af5a61c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{4}+\\frac{n\\pi }{4}" :db/id #edb/ref 17592186251225} {:answer/id #uuid "65c18de8-50f1-510b-be3e-67e3e14593c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{16}+\\frac{n\\pi }{4}" :db/id #edb/ref 17592186251389} {:answer/id #uuid "9ee22af7-fed1-5570-8b02-e7f32f959eaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{4}+\\frac{n\\pi }{8}" :db/id #edb/ref 17592186251923}] :answer-field/correct {:answer/id #uuid "65c18de8-50f1-510b-be3e-67e3e14593c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{16}+\\frac{n\\pi }{4}" :db/id #edb/ref 17592186251389} :answer-field/id #uuid "9c602f0c-b42d-53d5-bc8e-aa3b17f2cc1f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253080}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1a30a0cb-a192-58f4-b341-cb115dd8b12f" :question/math-academy-id "q-117698" :question/problem "Which of the following expressions gives all of the vertical asymptotes of the function $f(x)=\\operatorname{tan}⁡(4x+\\frac{\\pi }{4})?$ Assume that $n$ is an integer." :question/worked-solution "The asymptotes of $y=\\operatorname{tan}⁡x$ are given by the expression\n\n$$\nx=\\frac{\\pi }{2}+n\\pi ,\n$$\n\nwhere $n$ is an integer.\n\nTo find the asymptotes of $\\operatorname{tan}⁡(4x+\\frac{\\pi }{4}),$ we replace the $x$ on the left-hand side of the above with $(4x+\\frac{\\pi }{4}).$ This gives\n\n$$\n4x+\\frac{\\pi }{4}=\\frac{\\pi }{2}+n\\pi .\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}4x+\\frac{\\pi }{4} & =\\frac{\\pi }{2}+n\\pi  \\\\ 4x & =\\frac{\\pi }{2}+n\\pi -\\frac{\\pi }{4} \\\\ 4x & =\\frac{\\pi }{4}+n\\pi  \\\\ x & =\\frac{\\pi }{16}+\\frac{n\\pi }{4}.\\end{aligned}\n$$\n\nTherefore, we conclude that the expression giving all the vertical asymptotes is $x=\\frac{\\pi }{16}+\\frac{n\\pi }{4},$ where $n$ is an integer."}] [{:db/id #edb/ref 17592186253405 :knowledge-point/_questions [{:db/id #edb/ref 17592186078598 :knowledge-point/id #uuid "c4abe11e-febf-5461-96ee-bca8a7713bdf" :knowledge-point/title "Calculating the Definite Integral of a Piecewise Linear Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00a25b06-d824-5579-bf60-2d2c4e45d9a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.5" :db/id #edb/ref 17592186250556} {:answer/id #uuid "7e767a49-c1bd-5566-8a4d-80d682dab01f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186251615} {:answer/id #uuid "97a511f7-2a8d-5737-948b-58070b8fd816" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186251856} {:answer/id #uuid "b356ac98-e823-5f19-b0ba-a27840a19fb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1.5" :db/id #edb/ref 17592186252123} {:answer/id #uuid "dcfb57c0-e3ea-50c7-b3dc-b1dba4050fe2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186252499}] :answer-field/correct {:answer/id #uuid "00a25b06-d824-5579-bf60-2d2c4e45d9a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.5" :db/id #edb/ref 17592186250556} :answer-field/id #uuid "5a13fb81-d7bb-5742-9e3c-de58bdbfcea7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252965}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b8467112-b8ce-58b8-acef-c1b741ea25db" :question/math-academy-id "q-117712" :question/problem "![](images/45/45e506d3b6d3a2ca1a9b16a061f5c081e10b8c578796d7d4a1dfab6e6f793520.png)\n\nThe graph of $y=f(x),$ shown above, consists of three line segments. Find the value of ${\\int }_{-5}^{4}f(x)\\,\\text{d}x.$" :question/worked-solution "We divide the interval of integration into $4$ regions: the line segment for $x\\in [-5,-3],$ the line segment for $x\\in [-3,-1],$ the line segment for $x\\in (-1,1),$ and the line segment for $x\\in [1,4].$ Therefore, we can write the required integral as follows:\n\n$$\n{\\int }_{-5}^{4}f(x)\\,\\text{d}x={{{\\int }_{-5}^{-3}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{1}}+{{{\\int }_{-3}^{-1}f(x)\\,\\text{d}x}_{⏟}}_{-{A}_{2}}+{{{\\int }_{-1}^{1}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{3}}+{{{\\int }_{1}^{4}f(x)\\,\\text{d}x}_{⏟}}_{-{A}_{4}}\n$$\n\n- The $1$st integral represents the signed area between the curve and the $x$-axis, where $x\\in [-5,-3].$ The corresponding region is a right triangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{1} & =\\frac{1}{2}(bh) \\\\  & =\\frac{1}{2}(2\\cdot 2) \\\\  & =2.\\end{aligned}\n$$\n\n- The $2$nd integral represents the signed area between the curve and the $x$-axis, where $x\\in [-3,-1].$ The corresponding region is a right triangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{2} & =\\frac{1}{2}(bh) \\\\  & =\\frac{1}{2}(2\\cdot 2) \\\\  & =2.\\end{aligned}\n$$\n\nSince the region lies below the $x$-axis, we have\n\n$$\n{\\int }_{-4}^{-1}f(x)\\,\\text{d}x=-{A}_{2}=-2.\n$$\n\n- The $3$rd integral represents the signed area between the curve and the $x$-axis, where $x\\in (-1,1).$ The corresponding region is a square, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{3} & ={s}^{2} \\\\  & ={2}^{2} \\\\  & =4.\\end{aligned}\n$$\n\n- The $4$th integral represents the signed area between the curve and the $x$-axis, where $x\\in [1,4].$ The corresponding region is a triangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{4} & =\\frac{1}{2}(bh) \\\\  & =\\frac{1}{2}(3\\cdot 3) \\\\  & =4.5.\\end{aligned}\n$$\n\nSince the region lies below the $x$-axis, we have\n\n$$\n{\\int }_{1}^{4}f(x)\\,\\text{d}x=-{A}_{4}=-4.5.\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-5}^{4}f(x)\\,\\text{d}x & ={A}_{1}-{A}_{2}+{A}_{3}-{A}_{4} \\\\  & =2-2+4-4.5 \\\\  & =-0.5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253406 :knowledge-point/_questions [{:db/id #edb/ref 17592186096703 :knowledge-point/id #uuid "17099881-d7b9-54d9-a29a-4f5f28561cd3" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola with Vertex at the Origin Given Another Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0768a482-1a2f-5a34-8c85-9a34c76622bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-3x" :db/id #edb/ref 17592186250614} {:answer/id #uuid "2808b25a-1672-5fbc-8379-8016452a80f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=5x" :db/id #edb/ref 17592186250897} {:answer/id #uuid "91bb1123-01ba-56c5-beca-b049f55736e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-5x" :db/id #edb/ref 17592186251798} {:answer/id #uuid "abfb8433-1bf6-509a-aa93-e166d63ab29f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=7x" :db/id #edb/ref 17592186252045} {:answer/id #uuid "af0b99cf-a018-507e-a035-e93e9ec63d7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-7x" :db/id #edb/ref 17592186252078}] :answer-field/correct {:answer/id #uuid "af0b99cf-a018-507e-a035-e93e9ec63d7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-7x" :db/id #edb/ref 17592186252078} :answer-field/id #uuid "ef8a9cff-d5bd-58c8-adc0-f7db16811aa1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253224}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4e14f2af-b637-53ee-90cb-4edef45fef4f" :question/math-academy-id "q-11772" :question/problem "Find the equation of the left-opening parabola that has its vertex at $(0,0)$ and passes through the point $(-7,-7).$" :question/worked-solution "The general standard equation of a parabola whose vertex is $(0,0)$ and whose arms open right or left is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSince we know the given parabola passes through the point $(-7,-7),$ we can substitute $x=-7$ and $y=-7$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ (-7)^{2} & =4p(-7) \\\\ 49 & =-28p \\\\ p & =-\\frac{7}{4}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {y}^{2} & =4(-\\frac{7}{4})x \\\\ {y}^{2} & =-7x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186399975 :knowledge-point/_questions [{:db/id #edb/ref 17592186087662 :knowledge-point/id #uuid "0d0e48e3-39ca-551a-80a4-dc7ff7855197" :knowledge-point/title "Identifying When a Circle Does Not Intersect with a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1712079f-0724-55c4-bcf9-4a641811e473" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$ only" :db/id #edb/ref 17592186399977} {:answer/id #uuid "964eca01-2ae2-551e-a658-79835ac5c947" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ only" :db/id #edb/ref 17592186399978} {:answer/id #uuid "784750f3-6750-5c52-9edd-ecd848bdea7f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-1$ and $3$" :db/id #edb/ref 17592186399979} {:answer/id #uuid "c7cac279-8da9-592d-88fb-73f8fe0b7a5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The circle and the line do not intersect" :db/id #edb/ref 17592186399980} {:answer/id #uuid "83bfd300-7ebf-55e8-b278-1ff27d7a64f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-2$ and $4$" :db/id #edb/ref 17592186399981}] :answer-field/correct {:answer/id #uuid "c7cac279-8da9-592d-88fb-73f8fe0b7a5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The circle and the line do not intersect" :db/id #edb/ref 17592186399980} :answer-field/id #uuid "d47ad7cb-b24b-5fa1-931d-75679414940e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399976}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "61ffdc01-8414-55ad-b1b4-42608bbe9957" :question/math-academy-id "q-117737" :question/problem "Find the $x$-coordinates of the points where the circle ${x}^{2}+{y}^{2}=1$ intersects the line $x+2y=4$" :question/worked-solution "First, we rearrange the equation $x+2y=4,$ as follows:\n\n$$\ny=-\\frac{1}{2}x+2\n$$\n\nTo find $x$-coordinates of the intersection points, we need to substitute $y=-\\frac{1}{2}x+2$ into the equation of the circle and solve the resulting equation for $x,$ if possible:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =1 \\\\ {x}^{2}+{(-\\frac{1}{2}x+2)}^{2} & =1 \\\\ {x}^{2}+\\frac{{x}^{2}}{4}-2x+4 & =1 \\\\ \\frac{5{x}^{2}}{4}-2x+3 & =0\\end{aligned}\n$$\n\nIf we compute the discriminant $D$ of the above quadratic equation, then we get\n\n$$\n\\begin{aligned}D & ={2}^{2}-4\\cdot \\frac{5}{4}\\cdot 3 \\\\  & =4-15 \\\\  & =-11.\\end{aligned}\n$$\n\nSince $D=-11<0$, there are no real solutions to the equation $\\frac{5{x}^{2}}{4}-2x+3=0.$\n\nHence, we conclude that the circle ${x}^{2}+{y}^{2}=1$ does not intersect the line $x+2y=4$ at any point.\n\nThe corresponding diagram is shown below.\n\n![](images/40/400b997f9f1e83d6d2dd6c34b68a01ad4de5b352e40de2401eb516ca181f3163.png)"}] [{:db/id #edb/ref 17592186253410 :knowledge-point/_questions [{:db/id #edb/ref 17592186083152 :knowledge-point/id #uuid "0b19d6e0-8a12-525d-8c80-ac2de8080830" :knowledge-point/title "The Period of a Transformed Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2935cc2d-27c9-58b3-96a6-79c8386f3a29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186250904} {:answer/id #uuid "54137cf8-14cc-55d2-a3b0-586abb911a1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\pi " :db/id #edb/ref 17592186251241} {:answer/id #uuid "80c578dc-923e-50b4-8174-f24b0bd436b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186251638} {:answer/id #uuid "92a04e97-de9c-5fe7-b1bc-3c133f09c650" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\pi " :db/id #edb/ref 17592186251808} {:answer/id #uuid "a1ed5eb0-3633-589d-acca-01d3eccf8929" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{12}" :db/id #edb/ref 17592186251948}] :answer-field/correct {:answer/id #uuid "92a04e97-de9c-5fe7-b1bc-3c133f09c650" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\pi " :db/id #edb/ref 17592186251808} :answer-field/id #uuid "27623253-c44d-540a-b82d-ad67ac207865" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252877}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b44fb065-7fc5-53f5-aa2b-171c7b74a7ad" :question/math-academy-id "q-117752" :question/problem "Calculate the period of the function $y=-5\\operatorname{csc}⁡(\\frac{x}{6}-\\frac{\\pi }{4}).$" :question/worked-solution "Given a function of the form $y=A\\operatorname{csc}⁡(Bx+C)+D,$ the period is $\\frac{2\\pi }{B}.$\n\nIn our case, we have that $B=\\frac{1}{6}.$ Therefore, the period is $\\frac{2\\pi }{(\\frac{1}{6})}=12\\pi .$"}] [{:db/id #edb/ref 17592186253411 :knowledge-point/_questions [{:db/id #edb/ref 17592186096692 :knowledge-point/id #uuid "e9a34b79-65ff-5f7b-a8ee-5f19424fd9b4" :knowledge-point/title "Determining the Equation of a Parabola Given its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "018b900e-eac6-5ee8-98ca-c0981f9c358a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=\\frac{4}{3}y" :db/id #edb/ref 17592186250568} {:answer/id #uuid "36b69884-e0f8-5a35-a86f-6504c958fffb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=-\\frac{16}{3}y" :db/id #edb/ref 17592186251003} {:answer/id #uuid "6c61d383-b5d6-55e5-89aa-69e7219ae6e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=\\frac{8}{3}y" :db/id #edb/ref 17592186251442} {:answer/id #uuid "9c25fc1b-e751-5f4d-a4ea-2c79ebdd5611" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=-\\frac{8}{3}y" :db/id #edb/ref 17592186251901} {:answer/id #uuid "b600ef2d-7430-52c3-9a6b-33649cc4dade" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=-\\frac{4}{3}y" :db/id #edb/ref 17592186252153}] :answer-field/correct {:answer/id #uuid "b600ef2d-7430-52c3-9a6b-33649cc4dade" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=-\\frac{4}{3}y" :db/id #edb/ref 17592186252153} :answer-field/id #uuid "56c419e4-fed3-5638-9bd2-e528284bfe38" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252958}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4844153a-cf84-57ba-8cb5-907264c75fda" :question/math-academy-id "q-11779" :question/problem "![](images/b0/b09f63373bba1bb796f1832a4c7aa33ec220186e75bb84ccc79dcc46b662636e.png)\n\nWhat is the equation of the parabola shown above?" :question/worked-solution "From the diagram we see that the parabola is downward-opening has its vertex at $(0,0),$ and passes through the point $(4,-12).$\n\nFor any upward or downward-opening parabola whose vertex is $(0,0),$ the general standard equation is given by\n\n$$\n{x}^{2}=4py\n$$\n\nwhere $p$ is a constant.\n\nWe know that the given parabola passes through the point $(4,-12),$ so we can substitute $x=4$ and $y=-12$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ {4}^{2} & =4p(-12) \\\\ 16 & =-48p \\\\ p & =-\\frac{1}{3}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ {x}^{2} & =4(-\\frac{1}{3})y \\\\ {x}^{2} & =-\\frac{4}{3}y.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186398165 :knowledge-point/_questions [{:db/id #edb/ref 17592186184236 :knowledge-point/id #uuid "af228cc4-8be2-5c16-8537-4e5dab4e2ff4" :knowledge-point/title "Identifying the Horizontal Stretch and Vertical Shift of a Transformed Tangent Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34eca68d-7384-5ac4-aae3-9fd3ad9100c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186398167} {:answer/id #uuid "ebf81549-b73c-5aa8-ae6f-2eb529e3d650" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186398168} {:answer/id #uuid "4b365ba9-edc9-5d4f-9d0c-a4e1280cad8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186398169} {:answer/id #uuid "95065041-df6a-55e2-ba59-eb39e1ef3c42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186398170} {:answer/id #uuid "4041d9b8-a50e-5114-a489-9911977efeb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186398171}] :answer-field/correct {:answer/id #uuid "ebf81549-b73c-5aa8-ae6f-2eb529e3d650" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186398168} :answer-field/id #uuid "b20222d5-4d8b-5ef3-b5e6-cdd257fd9b17" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398166}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5ecbe368-922d-5a9f-956d-5a27886e10df" :question/math-academy-id "q-117796" :question/problem "![](images/92/9278723975d70fec73e313d0e164908ddd339231cb74f75b07c2edce14680111.png)\n\nThe graph above shows the function $y=\\operatorname{tan}⁡(Bx)+D,$ where $B$ and $D$ are constants. What is $B+D?$" :question/worked-solution "The period $T$ of the function is\n\n$$\nT=\\frac{2\\pi }{5}-(-\\frac{2\\pi }{5})=\\frac{4\\pi }{5}.\n$$\n\nThe formula for the period $T$ of the function $y=A\\operatorname{tan}⁡(Bx+C)+D$ is given by \n\n$$\nT=\\frac{\\pi }{B}.\n$$\n\nApplying the formula of the period, we get\n\n$$\n\\frac{4\\pi }{5}=\\frac{\\pi }{B}\\,⟹\\,B=\\frac{\\pi }{(\\frac{4\\pi }{5})}=\\frac{5}{4}.\n$$\n\nThe parameter $D$ represents the vertical shift of the tangent function. We see that the function has been translated by $\\frac{1}{2}$ unit up. Hence, $D=\\frac{1}{2}.$\n\nTherefore, $B+D=\\frac{5}{4}+\\frac{1}{2}=\\frac{7}{4}.$\n\nFinally, the equation of the curve is\n\n$$\ny=\\operatorname{tan}⁡(\\frac{5x}{4})+\\frac{1}{2}.\n$$"}] [{:db/id #edb/ref 17592186398172 :knowledge-point/_questions [{:db/id #edb/ref 17592186184148 :knowledge-point/id #uuid "dac9c72b-c23f-56fa-b939-6e3b56d3a13b" :knowledge-point/title "Identifying the Horizontal Stretch and Vertical Shift of a Transformed Cotangent Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dd86b80a-f69a-5bee-9e25-9498124a3b56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186398174} {:answer/id #uuid "ae4cbf13-3436-5ca9-a85e-d79666e97f91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186398175} {:answer/id #uuid "a192845d-5444-593f-a294-b8369a05e099" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{4}" :db/id #edb/ref 17592186398176} {:answer/id #uuid "e570139b-a17c-5e71-8fdc-ac883bda1ab2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186398177} {:answer/id #uuid "c337dc59-1dd1-5197-98b9-3c6fcbf08e62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186398178}] :answer-field/correct {:answer/id #uuid "a192845d-5444-593f-a294-b8369a05e099" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{4}" :db/id #edb/ref 17592186398176} :answer-field/id #uuid "4b387afd-4a67-578b-8db3-0662089f213d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398173}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "554b2923-f03c-51dd-9817-6e0a2f8280b5" :question/math-academy-id "q-117799" :question/problem "![](images/c9/c9ed24a7fa07d6c29e4125c8428fb61a42fc969b99f101c4737bdedf9bf036ff.png)\n\nThe graph above shows the function $y=\\operatorname{cot}⁡(Bx)+D,$ where $B$ and $D$ are constants. What is $B+D?$" :question/worked-solution "The period $T$ of the function is\n\n$$\nT=\\frac{4\\pi }{3}-0=\\frac{4\\pi }{3}.\n$$\n\nThe formula for the period $T$ of the function $y=A\\operatorname{cot}⁡(Bx+C)+D$ is given by \n\n$$\nT=\\frac{\\pi }{B}.\n$$\n\nApplying the formula of the period, we get\n\n$$\n\\frac{4\\pi }{3}=\\frac{\\pi }{B}\\,⟹\\,B=\\frac{\\pi }{(\\frac{4\\pi }{3})}=\\frac{3}{4}.\n$$\n\nThe parameter $D$ represents the vertical shift of the cotangent function. We see that the function has been translated by $3$ units down. Hence, $D=-3.$\n\nTherefore, $B+D=\\frac{3}{4}+(-3)=-\\frac{9}{4}.$\n\nFinally, the equation of the curve is\n\n$$\ny=\\operatorname{cot}⁡(\\frac{3x}{4})-3.\n$$"}] [{:db/id #edb/ref 17592186253417 :knowledge-point/_questions [{:db/id #edb/ref 17592186083155 :knowledge-point/id #uuid "5085a30f-a347-5ba8-80fd-102e4e0f37ce" :knowledge-point/title "Finding Local Extrema of a Transformed Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08ef0ad4-504c-5ff5-b6b1-d2d3e980875f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186250635} {:answer/id #uuid "298bec1a-ff16-5540-a476-6b3fca320aa8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186250908} {:answer/id #uuid "2dc5b675-6831-54be-906b-a9a1b71d2899" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186250944} {:answer/id #uuid "885e749a-e263-5b04-8671-ccd884576931" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186251703} {:answer/id #uuid "a365c952-0f98-5c32-87e5-0e635c62c1d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186251962}] :answer-field/correct {:answer/id #uuid "2dc5b675-6831-54be-906b-a9a1b71d2899" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186250944} :answer-field/id #uuid "94db1709-d36e-5a1b-b01a-c474544f7620" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253067}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "97fbbd90-72d5-5259-afd8-7a25639443c6" :question/math-academy-id "q-117805" :question/problem "What is the value of $f(x)=4\\operatorname{sec}⁡(x-\\frac{\\pi }{4})+1$ at its local maximum points?" :question/worked-solution "On a negative branch of the graph of $y=\\operatorname{sec}⁡x,$ we have\n\n$$\n\\operatorname{sec}⁡x\\le -1.\n$$\n\nThe points where $\\operatorname{sec}⁡x=-1$ are local maximums of the graph of $y=\\operatorname{sec}⁡x.$ \n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n\\operatorname{sec}⁡(x-\\frac{\\pi }{4})\\le -1.\n$$\n\nMultiplying the above inequality by $4$ and adding $1$, we get\n\n$$\n\\begin{aligned} & \\operatorname{sec}⁡(x-\\frac{\\pi }{4})\\le -1 \\\\  & 4\\operatorname{sec}⁡(x-\\frac{\\pi }{4})\\le -4 \\\\  & 4\\operatorname{sec}⁡(x-\\frac{\\pi }{4})+1\\le -4+1 \\\\  & f(x)\\le -3.\\end{aligned}\n$$\n\nTherefore, $f(x)=-3$ at the local maximum points."}] [{:db/id #edb/ref 17592186253420 :knowledge-point/_questions [{:db/id #edb/ref 17592186096692 :knowledge-point/id #uuid "e9a34b79-65ff-5f7b-a8ee-5f19424fd9b4" :knowledge-point/title "Determining the Equation of a Parabola Given its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d74283e-5ccb-5927-b7c2-7b6dc7348729" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=-\\frac{8}{3}y" :db/id #edb/ref 17592186250940} {:answer/id #uuid "49d88741-afb9-5f1a-89bc-fa72f184e234" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=\\frac{4}{3}y" :db/id #edb/ref 17592186251167} {:answer/id #uuid "53cc6df8-4837-502d-9577-0769a855428d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=\\frac{2}{3}y" :db/id #edb/ref 17592186251238} {:answer/id #uuid "d2e45b1d-95f4-5298-b7f6-badd3269cd0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=-\\frac{4}{3}y" :db/id #edb/ref 17592186252418} {:answer/id #uuid "dcaf0ab8-8236-5a51-9644-727fd4c758d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=\\frac{8}{3}y" :db/id #edb/ref 17592186252495}] :answer-field/correct {:answer/id #uuid "dcaf0ab8-8236-5a51-9644-727fd4c758d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=\\frac{8}{3}y" :db/id #edb/ref 17592186252495} :answer-field/id #uuid "bf9081df-efa4-55bb-b2fa-1ac432b3fbd4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253137}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "73e0be4b-b8c0-5d2c-baec-36cb996c3031" :question/math-academy-id "q-11781" :question/problem "![](images/e5/e588a9250583251ba2fd85b789eb3a856970fb6e7044289257a4ed97e3bbf1a0.png)\n\nWhat is the equation of the parabola shown above?" :question/worked-solution "From the diagram we see that the parabola is upward-opening, has its vertex at $(0,0),$ and passes through the point $(4,6).$\n\nFor any upward or downward-opening parabola whose vertex is $(0,0),$ the general standard equation is given by\n\n$$\n{x}^{2}=4py\n$$\n\nwhere $p$ is a constant.\n\nWe know that the given parabola passes through the point $(4,6),$ so we can substitute $x=4$ and $y=6$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ {4}^{2} & =4p(6) \\\\ 16 & =24p \\\\ p & =\\frac{2}{3}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ {x}^{2} & =4(\\frac{2}{3})y \\\\ {x}^{2} & =\\frac{8}{3}y.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253424 :knowledge-point/_questions [{:db/id #edb/ref 17592186087663 :knowledge-point/id #uuid "603badf5-1f56-581f-833a-ec08fbedf777" :knowledge-point/title "Finding the Equation of a Circle Given a Line Covering a Diameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "220f1f72-5993-5355-928d-610445b3ed08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-4)^{2}+(y+6)^{2}=13" :db/id #edb/ref 17592186250843} {:answer/id #uuid "3be885d3-e88e-54bb-a8e6-482e123cc00c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-2)^{2}+(y+3)^{2}=13" :db/id #edb/ref 17592186251054} {:answer/id #uuid "e6174268-79ef-50fb-8545-ca02d9f8549f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-2)^{2}+(y+3)^{2}=52" :db/id #edb/ref 17592186252568} {:answer/id #uuid "e9904d8b-ac81-5503-a083-08837b2b1210" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-2)^{2}+(y+3)^{2}=2\\sqrt{13}" :db/id #edb/ref 17592186252598} {:answer/id #uuid "efacbdff-57eb-5f3d-aa57-648622f32e15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-4)^{2}+(y+6)^{2}=52" :db/id #edb/ref 17592186252650}] :answer-field/correct {:answer/id #uuid "efacbdff-57eb-5f3d-aa57-648622f32e15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-4)^{2}+(y+6)^{2}=52" :db/id #edb/ref 17592186252650} :answer-field/id #uuid "39e62144-043a-5e64-91ce-e18508447330" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252900}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7c63574e-df7e-5af6-a537-b5b20d65f6d2" :question/math-academy-id "q-117859" :question/problem "![](images/c1/c100b27df3e4d9b23846961ad5d168fbe6f0eecd94ab8a9b99f51e82bca064a3.png)\n\nThe line $2y-3x=-24$ intercepts the $x$- and $y$-axes at points $A$ and $B$, respectively. If the segment $\\overset{―}{AB}$ is a diameter of a circle, find the equation of the circle." :question/worked-solution "To find the $x$-coordinate of $A$, we set $y=0$ in the equation of the line and solve for $x:$ \n\n$$\n\\begin{aligned}2(0)-3x & =-24 \\\\ -3x & =-24 \\\\ x & =8.\\end{aligned}\n$$\n\nSimilarly, to find the $y$-coordinate of $B$, we set $x=0$ and solve for $y$:\n\n$$\n\\begin{aligned}2y-3(0) & =-24 \\\\ 2y & =-24 \\\\ y & =-12.\\end{aligned}\n$$\n\nSo, $A$ and $B$ have the coordinates $(8,0)$ and $(0,-12)$, respectively.\n\nIf the segment $\\overset{―}{AB}$ is a diameter of the circle, then the midpoint must be the center of the circle. Using the midpoint formula, we find that the center of the circle is at\n\n$$\n(\\frac{8+0}{2},\\frac{0-12}{2})=(4,-6).\n$$\n\nNow, to find the radius of the circle, we compute the distance between the center $(4,-6)$ and a point on the circle, say $A(8,0),$ as follows:\n\n$$\n\\begin{aligned}r & =\\sqrt{{(4-8)}^{2}+(-6-0)^{2}} \\\\  & =\\sqrt{16+36} \\\\  & =\\sqrt{52} \\\\  & =2\\sqrt{13}\\end{aligned}\n$$\n\n \n\nTherefore, since the circle has center $(4,-6)$ and radius $r=2\\sqrt{13},$ the equation of the circle is\n\n$$\n\\begin{aligned}(x-4)^{2}+(y-(-6))^{2} & ={(2\\sqrt{13})}^{2} \\\\ (x-4)^{2}+(y+6)^{2} & =52.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253425 :knowledge-point/_questions [{:db/id #edb/ref 17592186184149 :knowledge-point/id #uuid "84355770-5926-5be6-9b9f-c13bb05599ae" :knowledge-point/title "Identifying the Horizontal Shift of a Horizontally Stretched Tangent or Cotangent Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1382a0da-6af2-58cd-a188-1d157bd20cd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{14}" :db/id #edb/ref 17592186250722} {:answer/id #uuid "255f49c4-fc05-50ed-8b6d-c7d105680f5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{14}" :db/id #edb/ref 17592186250875} {:answer/id #uuid "70d6cf7f-09b3-54e7-91e5-21216ebc3505" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{7}" :db/id #edb/ref 17592186251475} {:answer/id #uuid "8f7c0e22-c4ef-5f16-9e47-d3a2ab3e0908" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2\\pi }{7}" :db/id #edb/ref 17592186251770} {:answer/id #uuid "958902e2-d4fc-583d-abca-b3667fecc3aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{7}" :db/id #edb/ref 17592186251838}] :answer-field/correct {:answer/id #uuid "958902e2-d4fc-583d-abca-b3667fecc3aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{7}" :db/id #edb/ref 17592186251838} :answer-field/id #uuid "0dd471e5-3d02-59ea-ae43-9700669b6052" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252832}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3de18967-1c79-524e-b070-80260fcd64fd" :question/math-academy-id "q-117888" :question/problem "![](images/58/5819e0605dacfb190c2767c4f50a671eb592832aa6a3a1970a8bcdff2790fd19.png)\n\nThe graph above shows the function $y=\\operatorname{tan}⁡(3x+C),$ where $C$ is a constant. Given that $-\\frac{\\pi }{2}<C<\\frac{\\pi }{2},$ what is the value of $C?$" :question/worked-solution "The parameter $C$ represents a horizontal shift of the function.\n\nFirst, we rewrite the function by factoring the horizontal stretch factor, as follows:\n\n$$\n\\begin{aligned}y & =\\operatorname{tan}⁡(3x+C) \\\\  & =\\operatorname{tan}⁡(3(x+\\frac{C}{3}))\\end{aligned}\n$$\n\nThe factor $x+\\frac{C}{3}$ indicates that the graph of $y=\\operatorname{tan}⁡(3(x+\\frac{C}{3}))$ is a horizontal translation of $y=\\operatorname{tan}⁡(3x).$ Comparing the two graphs below allows us to determine the amount of this shift.\n\n![](images/ad/ad5bf0001a37cf5bebf3288ffbf1fa6bb69747f28f8a81d08d0ffab8223e1707.png)\n\nFrom the diagram, we see that our curve has been obtained by shifting $y=\\operatorname{tan}⁡(3x)$ by $\\frac{\\pi }{21}-0=\\frac{\\pi }{21}$ units to the right. Therefore\n\n$$\n\\frac{C}{3}=-\\frac{\\pi }{21}\\,⟹\\,C=-\\frac{\\pi }{7}.\n$$\n\nSince $-\\frac{\\pi }{2}<C<\\frac{\\pi }{2}$ and $-\\frac{\\pi }{7}$ is in this interval, the value of $C$ is $-\\frac{\\pi }{7}.$"}] [{:db/id #edb/ref 17592186253430 :knowledge-point/_questions [{:db/id #edb/ref 17592186096693 :knowledge-point/id #uuid "281514e9-6e16-5b21-ba4e-503991d811c2" :knowledge-point/title "Determining the Equation of a Parabola Passing Through a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29bfd946-372a-5444-a539-b716d9cbb951" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=5y" :db/id #edb/ref 17592186250911} {:answer/id #uuid "315d3443-669e-53c8-825c-4dd3c15813b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=y" :db/id #edb/ref 17592186250972} {:answer/id #uuid "7a6adb72-8b7c-5af0-8717-9d8ed3666c4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=-3y" :db/id #edb/ref 17592186251572} {:answer/id #uuid "96e517f3-26bc-5e99-8b69-bc21a87de470" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=-5y" :db/id #edb/ref 17592186251847} {:answer/id #uuid "97998a1b-9445-5245-b410-a419f925511e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=3y" :db/id #edb/ref 17592186251855}] :answer-field/correct {:answer/id #uuid "29bfd946-372a-5444-a539-b716d9cbb951" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=5y" :db/id #edb/ref 17592186250911} :answer-field/id #uuid "4d6c6253-24f7-571b-b3ec-a0a27c5878db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252942}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e0b80741-e06b-5c43-b887-c4210becc6d2" :question/math-academy-id "q-11792" :question/problem "Find the equation of the upward-opening parabola that has its vertex at $(0,0)$ and which passes through the point $(-5,5).$" :question/worked-solution "We know that for any upward or downward-opening parabola whose vertex is $(0,0),$ the general standard equation is given by\n\n$$\n{x}^{2}=4py\n$$\n\nwhere $p$ is a constant.\n\nWe're told that the given parabola passes through the point $(-5,5),$ so we can substitute $x=-5$ and $y=5$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ (-5)^{2} & =4p(5) \\\\ 25 & =20p \\\\ p & =\\frac{5}{4}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ {x}^{2} & =4(\\frac{5}{4})y \\\\ {x}^{2} & =5y.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186097004 :knowledge-point/_questions [{:db/id #edb/ref 17592186096704 :knowledge-point/id #uuid "dc86c375-c2c4-56b7-a207-0abfc9709f6a" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "007e5875-12bb-5469-bee2-9e308d1913ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-2)^{2}=8(x+2)" :db/id #edb/ref 17592186250555} {:answer/id #uuid "7cbb2c97-6267-5a4e-ad5c-4eecd966ac12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-2)^{2}=-4(x+2)" :db/id #edb/ref 17592186251593} {:answer/id #uuid "9adbb64e-58b5-520b-a756-8c681f0041b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-2)^{2}=4(x+2)" :db/id #edb/ref 17592186251883} {:answer/id #uuid "c7eb3c43-5a45-5db8-8e81-b8791ebc8549" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+2)^{2}=8(x-2)" :db/id #edb/ref 17592186252323} {:answer/id #uuid "fd5df63c-eb61-59d1-b092-73a48046cece" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-2)^{2}=-8(x+2)" :db/id #edb/ref 17592186252773}] :answer-field/correct {:answer/id #uuid "007e5875-12bb-5469-bee2-9e308d1913ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-2)^{2}=8(x+2)" :db/id #edb/ref 17592186250555} :answer-field/id #uuid "deee0397-808f-5aa4-bf00-34e759fcff77" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253185}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bbd1ed97-ed69-50ed-938c-aebfe4625b89" :question/math-academy-id "q-11793" :question/problem "![](images/9e/9eb2efa6d60dc4bd1d7915900e60be8a891f824799ed6ada8f2753fa71bb01c6.png)\n\nWhat is the equation of the parabola shown above?" :question/worked-solution "From the diagram we see that the arms of the parabola open to the left. The parabola has its vertex at $(-2,2)$ and passes through the point $(6,10).$\n\nThe general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(-2,2),$ we substitute $h=-2$ and $k=2$ into the equation above and get\n\n$$\n\\begin{aligned}(y-2)^{2} & =4p(x+2).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(6,10),$ so we can substitute $x=6$ and $y=10$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}(y-2)^{2} & =4p(x+2) \\\\ (10-2)^{2} & =4p(6+2) \\\\ 64 & =32p \\\\ p & =2\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}(y-2)^{2} & =4p(x+2) \\\\ (y-2)^{2} & =4(2)(x+2) \\\\ (y-2)^{2} & =8(x+2).\\end{aligned}\n$$\n\nNotice that the arms of the parabola open to the right since $p=2$ is positive."}] [{:db/id #edb/ref 17592186253431 :knowledge-point/_questions [{:db/id #edb/ref 17592186096705 :knowledge-point/id #uuid "783ca59b-0242-584c-ae47-004a0eb03817" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola Given the Vertex and Another Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "067eb9b1-51de-5ef8-b70e-3b3e8cda0c87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-4)^{2}=4(x-1)" :db/id #edb/ref 17592186250606} {:answer/id #uuid "13e8d2d2-417b-57ab-9155-6e7000efdb81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-4)^{2}=-8(x-1)" :db/id #edb/ref 17592186250725} {:answer/id #uuid "33afd160-c8ab-5044-8b0b-8f8d3675e347" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-1)^{2}=-8(x-4)" :db/id #edb/ref 17592186250983} {:answer/id #uuid "abc58071-d220-590e-a965-1da2251fffb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-4)^{2}=-4(x-1)" :db/id #edb/ref 17592186252041} {:answer/id #uuid "b0209be0-b337-582a-a85e-98717e955cd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-4)^{2}=8(x-1)" :db/id #edb/ref 17592186252090}] :answer-field/correct {:answer/id #uuid "13e8d2d2-417b-57ab-9155-6e7000efdb81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-4)^{2}=-8(x-1)" :db/id #edb/ref 17592186250725} :answer-field/id #uuid "26ea5a01-cd1c-58e7-985e-fe58df8c683e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252875}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f5a78323-0f8e-5b1d-8bfd-600ef8cd7e86" :question/math-academy-id "q-11794" :question/problem "Find the equation of the left-opening parabola that has its vertex at $(1,4)$ and passes through the point $(-1,8).$" :question/worked-solution "The general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(1,4),$ we substitute $h=1$ and $k=4$ into the equation above and get\n\n$$\n\\begin{aligned}(y-4)^{2} & =4p(x-1).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(-1,8),$ so we can substitute $x=-1$ and $y=8$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}(y-4)^{2} & =4p(x-1) \\\\ (8-4)^{2} & =4p(-1-1) \\\\ 16 & =-8p \\\\ p & =-2\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}(y-4)^{2} & =4p(x-1) \\\\ (y-4)^{2} & =4(-2)(x-1) \\\\ (y-4)^{2} & =-8(x-1).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253433 :knowledge-point/_questions [{:db/id #edb/ref 17592186175921 :knowledge-point/id #uuid "e367aafb-2474-5dfc-a45f-be3a5ea76942" :knowledge-point/title "Approximating the Solution to an Initial Value Problem Using Euler's Method With Two Steps"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39db5d0b-282e-51f5-ba10-f632141269a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186251030} {:answer/id #uuid "3ebebed7-1156-50dd-b495-b103e7023a2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186251076} {:answer/id #uuid "4c013829-c4ae-5437-9bf0-99f40f9385a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186251182} {:answer/id #uuid "52d065ca-e0ac-5430-9852-489865f7ecbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186251229} {:answer/id #uuid "c7ef0794-a68a-5b8b-99e8-2aa6c12731f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186252324}] :answer-field/correct {:answer/id #uuid "c7ef0794-a68a-5b8b-99e8-2aa6c12731f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186252324} :answer-field/id #uuid "0b9357f7-8572-5aa9-ae8a-d0c001dbf416" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252830}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "af0427a6-d3d0-5efe-950b-968ece9492c2" :question/math-academy-id "q-117942" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=\\frac{{y}^{2}x}{2},\\,y(0)=2\n$$\n\nUse Euler's method with two steps of equal size to approximate $y(2).$" :question/worked-solution "First, note that we are given $y(0)$ and asked to find $y(2).$ The distance from $x=0$ to $x=2$ is $2,$ and since we are asked to use two steps of equal size, our step size must be \n\n$$\nΔx=\\frac{2-0}{2}=\\frac{2}{2}=1.\n$$\n\nNow, let's proceed with Euler's method. We'll start by creating a table that includes the initial condition data $y(0)=2.$\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,Δy\\,$ |\n| --- | --- | --- | --- |\n| $0$ | $2$ | $$ | $$ |\n\n \n\n**Step 1.** We compute ${y}^{′}$ and $Δy$ (using the values of $x$ and $y$ in the first row) and the values of ${x}_{\\text{new}}$ and ${y}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{{y}^{2}x}{2}=\\frac{{2}^{2}\\cdot 0}{2}=0 \\\\ Δy & ={y}^{′}\\cdot Δx=0\\cdot 1=0 \\\\ {x}_{\\text{new}} & =x+Δx=0+1=1 \\\\ {y}_{\\text{new}} & =y+Δy=2+0=2\\end{aligned}\n$$\n\nWe add this data to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,Δy\\,$ |\n| --- | --- | --- | --- |\n| $0$ | $2$ | $0$ | $0$ |\n| $1$ | $2$ | $$ | $$ |\n\n**Step 2.** We compute ${y}^{′}$ and $Δy$ (using the values of $x$ and $y$ in the second row) and new values of ${x}_{\\text{new}}$ and ${y}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{{y}^{2}x}{2}=\\frac{{2}^{2}\\cdot 1}{2}=2 \\\\ Δy & ={y}^{′}\\cdot Δx=2\\cdot 1=2 \\\\ {x}_{\\text{new}} & =x+Δx=1+1=2 \\\\ {y}_{\\text{new}} & =y+Δy=2+2=4\\end{aligned}\n$$\n\nWe add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,Δy\\,$ |\n| --- | --- | --- | --- |\n| $0$ | $2$ | $0$ | $0$ |\n| $1$ | $2$ | $2$ | $2$ |\n| $2$ | $4$ | $$ | $$ |\n\n \n\nTherefore, we conclude that $y(2)≈4.$"}] [{:db/id #edb/ref 17592186253435 :knowledge-point/_questions [{:db/id #edb/ref 17592186176017 :knowledge-point/id #uuid "16629348-2577-5c39-8c8c-0f24dbb52c87" :knowledge-point/title "Approximating the Solution to an Initial Value Problem Using Euler's Method With Three Steps"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f2dee6f-2d5c-5e3c-9438-c3b33fa575d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186250820} {:answer/id #uuid "2988ff8c-10b2-5ccf-b8c7-fe91b23c855d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186250907} {:answer/id #uuid "80b488de-9140-5bdd-9cb9-ce9c1c2b4e14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186251637} {:answer/id #uuid "98ed02db-1bb1-5d06-a662-8442f335353e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "29" :db/id #edb/ref 17592186251867} {:answer/id #uuid "9fb88431-375c-5c66-8aff-114d8977db36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186251928}] :answer-field/correct {:answer/id #uuid "9fb88431-375c-5c66-8aff-114d8977db36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186251928} :answer-field/id #uuid "cfdef5b1-58c3-50c1-9085-50bbda99147d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253165}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "93e82da0-a467-55d7-b28b-8eba4a30a375" :question/math-academy-id "q-117952" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}={y}^{2}-{x}^{2},\\,y(0)=1\n$$\n\nUse Euler's method with three steps of equal size to approximate $y(3).$" :question/worked-solution "First, note that we are given $y(0)$ and asked to find $y(3).$ The distance from $x=0$ and $x=3$ is $3,$ and since we are asked to use three steps of equal size, our step size must be\n\n$$\nΔx=\\frac{3-0}{3}=\\frac{3}{3}=1.\n$$\n\nNow, let's proceed with Euler's method. We'll start by creating a table that includes the initial condition data $y(0)=1.$\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,Δy\\,$ |\n| --- | --- | --- | --- |\n| $0$ | $1$ | $$ | $$ |\n\n**Step 1.** We compute ${y}^{′}$ and $Δy$ (using the values of $x$ and $y$ in the first row) and the values of ${x}_{\\text{new}}$ and ${y}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & ={y}^{2}-{x}^{2}={1}^{2}-{0}^{2}=1 \\\\ Δy & ={y}^{′}\\cdot Δx=1\\cdot 1=1 \\\\ {x}_{\\text{new}} & =x+Δx=0+1=1 \\\\ {y}_{\\text{new}} & =y+Δy=1+1=2\\end{aligned}\n$$\n\nWe add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,Δy\\,$ |\n| --- | --- | --- | --- |\n| $0$ | $1$ | $1$ | $1$ |\n| $1$ | $2$ | $$ | $$ |\n\n**Step 2.** We compute ${y}^{′}$ and $Δy$ (using the values of $x$ and $y$ in the second row) and new values of ${x}_{\\text{new}}$ and ${y}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & ={y}^{2}-{x}^{2}={2}^{2}-{1}^{2}=3 \\\\ Δy & ={y}^{′}\\cdot Δx=3\\cdot 1=3 \\\\ {x}_{\\text{new}} & =x+Δx=1+1=2 \\\\ {y}_{\\text{new}} & =y+Δy=2+3=5\\end{aligned}\n$$\n\nWe add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,Δy\\,$ |\n| --- | --- | --- | --- |\n| $0$ | $1$ | $1$ | $1$ |\n| $1$ | $2$ | $3$ | $3$ |\n| $2$ | $5$ | $$ | $$ |\n\n**Step 3.** We compute ${y}^{′}$ and $Δy$ (using the values of $x$ and $y$ in the third row) and new values of ${x}_{\\text{new}}$ and ${y}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & ={y}^{2}-{x}^{2}={5}^{2}-{2}^{2}=21 \\\\ Δy & ={y}^{′}\\cdot Δx=21\\cdot 1=21 \\\\ {x}_{\\text{new}} & =x+Δx=2+1=3 \\\\ {y}_{\\text{new}} & =y+Δy=5+21=26\\end{aligned}\n$$\n\nWe add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,Δy\\,$ |\n| --- | --- | --- | --- |\n| $0$ | $1$ | $1$ | $1$ |\n| $1$ | $2$ | $3$ | $3$ |\n| $2$ | $5$ | $21$ | $21$ |\n| $3$ | $26$ |  |  |\n\nTherefore, we conclude that $y(3)≈26.$"}] [{:db/id #edb/ref 17592186253443 :knowledge-point/_questions [{:db/id #edb/ref 17592186096705 :knowledge-point/id #uuid "783ca59b-0242-584c-ae47-004a0eb03817" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola Given the Vertex and Another Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00eabfa3-cbd8-5d06-b474-2130cea60e32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-1)^{2}=\\frac{4}{3}(x-5)" :db/id #edb/ref 17592186250558} {:answer/id #uuid "2b0a6616-b04e-5277-9ba6-2b86840c5e11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-1)^{2}=-\\frac{8}{3}(x-5)" :db/id #edb/ref 17592186250920} {:answer/id #uuid "5ae9419c-4622-5326-9759-7bf6e6f53229" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-1)^{2}=-\\frac{4}{3}(x-5)" :db/id #edb/ref 17592186251304} {:answer/id #uuid "5bebc376-58df-5442-bba6-b167bd6045ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-1)^{2}=\\frac{8}{3}(x-5)" :db/id #edb/ref 17592186251311} {:answer/id #uuid "7ec8aee3-46a8-5db4-a234-1e0983fb9ed7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-5)^{2}=-\\frac{8}{3}(x-1)" :db/id #edb/ref 17592186251616}] :answer-field/correct {:answer/id #uuid "2b0a6616-b04e-5277-9ba6-2b86840c5e11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-1)^{2}=-\\frac{8}{3}(x-5)" :db/id #edb/ref 17592186250920} :answer-field/id #uuid "dfb9c786-7275-567d-8803-668e5cc54126" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253186}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b010d0fe-74c1-571a-98b5-1a828c1293c0" :question/math-academy-id "q-11802" :question/problem "Find the equation of the left-opening parabola that has its vertex at $(5,1)$ and passes through the point $(-1,5).$" :question/worked-solution "The general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(5,1),$ we substitute $h=5$ and $k=1$ into the equation above and get\n\n$$\n\\begin{aligned}(y-1)^{2} & =4p(x-5).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(-1,5),$ so we can substitute $x=-1$ and $y=5$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}(y-1)^{2} & =4p(x-5) \\\\ (5-1)^{2} & =4p(-1-5) \\\\ 16 & =-24p \\\\ p & =-\\frac{2}{3}\\end{aligned}\n$$\n\nSo, the equation of the parabola is\n\n$$\n\\begin{aligned}(y-1)^{2} & =4p(x-5) \\\\ (y-1)^{2} & =4(-\\frac{2}{3})(x-5) \\\\ (y-1)^{2} & =-\\frac{8}{3}(x-5).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253446 :knowledge-point/_questions [{:db/id #edb/ref 17592186096704 :knowledge-point/id #uuid "dc86c375-c2c4-56b7-a207-0abfc9709f6a" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d8acb62-1689-516f-9882-4c9dda55e1c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=2(x+4)" :db/id #edb/ref 17592186251328} {:answer/id #uuid "77de82a0-e73e-5de8-a117-54e53271cdb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-3(x+4)" :db/id #edb/ref 17592186251544} {:answer/id #uuid "7a6921a9-f376-5914-8a9e-5b2f42ba5a37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+4)^{2}=3x" :db/id #edb/ref 17592186251571} {:answer/id #uuid "95781b19-83eb-5875-9326-f078ecb9c39d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=3(x+4)" :db/id #edb/ref 17592186251837} {:answer/id #uuid "fc5538d8-0f12-5dc5-a2c9-99178bd82c8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-2(x+4)" :db/id #edb/ref 17592186252764}] :answer-field/correct {:answer/id #uuid "95781b19-83eb-5875-9326-f078ecb9c39d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=3(x+4)" :db/id #edb/ref 17592186251837} :answer-field/id #uuid "9bf11644-eb3c-55f3-8b1b-a01c321a67d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253078}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "157ae011-ca8e-518d-b6fc-d2c2017281bc" :question/math-academy-id "q-11805" :question/problem "![](images/a1/a16f3f2ba78b5aef180c4331d1dd99f37340d2c6d842c1596e35445f1dbf34c5.png)\n\nWhat is the equation of the parabola shown above?" :question/worked-solution "From the diagram we see that the arms of the parabola open to the right. The parabola has its vertex at $(-4,0)$ and passes through the point $(8,6).$\n\nThe general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(-4,0),$ we substitute $h=-4$ and $k=0$ into the equation above and get\n\n$$\n\\begin{aligned}{y}^{2} & =4p(x+4).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(8,6),$ so we can substitute $x=8$ and $y=6$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}{y}^{2} & =4p(x+4) \\\\ {6}^{2} & =4p(8+4) \\\\ 36 & =48p \\\\ p & =\\frac{3}{4}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}{y}^{2} & =4p(x+4) \\\\ {y}^{2} & =4(\\frac{3}{4})(x+4) \\\\ {y}^{2} & =3(x+4).\\end{aligned}\n$$\n\nNotice that the arms of the parabola open to the right since $p=\\frac{3}{4}$ is positive."}] [{:db/id #edb/ref 17592186253452 :knowledge-point/_questions [{:db/id #edb/ref 17592186096704 :knowledge-point/id #uuid "dc86c375-c2c4-56b7-a207-0abfc9709f6a" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "531adca8-60bb-50a4-8900-a46ffe6dc0af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+6)^{2}=9x" :db/id #edb/ref 17592186251231} {:answer/id #uuid "6f0a7535-d9b3-5d12-a834-77b7f828e0a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=9(x+6)" :db/id #edb/ref 17592186251458} {:answer/id #uuid "8b12f5d5-879c-51b4-b347-73615cacbb41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-6(x+6)" :db/id #edb/ref 17592186251728} {:answer/id #uuid "abda7147-8065-57e1-81d4-1ed5f2cb4f24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-9(x+6)" :db/id #edb/ref 17592186252043} {:answer/id #uuid "c16cc020-1c53-5f88-9dce-79606ba3537c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=6(x+6)" :db/id #edb/ref 17592186252259}] :answer-field/correct {:answer/id #uuid "6f0a7535-d9b3-5d12-a834-77b7f828e0a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=9(x+6)" :db/id #edb/ref 17592186251458} :answer-field/id #uuid "e2aeb479-547c-5991-8f8f-b20a9eb96bd7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253194}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "582e0262-2ff0-53cf-8f18-89d0545d5f0a" :question/math-academy-id "q-11809" :question/problem "![](images/8a/8a48fcacc437d1dca41df82e24984507a92d686f80f4517c6682e8b14b694f0e.png)\n\nWhat is the equation of the parabola shown above?" :question/worked-solution "From the diagram we see that the arms of the parabola open to the right. The parabola has its vertex at $(-6,0)$ and passes through the point $(-2,6).$\n\nThe general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(-6,0),$ we substitute $h=-6$ and $k=0$ into the equation above and get\n\n$$\n\\begin{aligned}{y}^{2} & =4p(x+6).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(-2,6),$ so we can substitute $x=-2$ and $y=6$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}{y}^{2} & =4p(x+6) \\\\ {6}^{2} & =4p(-2+6) \\\\ 36 & =16p \\\\ p & =\\frac{9}{4}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}{y}^{2} & =4p(x+6) \\\\ {y}^{2} & =4(\\frac{9}{4})(x+6) \\\\ {y}^{2} & =9(x+6).\\end{aligned}\n$$\n\nNotice that the arms of the parabola open to the right since $p=\\frac{9}{4}$ is positive."}] [{:db/id #edb/ref 17592186253453 :knowledge-point/_questions [{:db/id #edb/ref 17592186152229 :knowledge-point/id #uuid "31c3dfc6-edf9-5b4a-96f6-17090b07c732" :knowledge-point/title "Evaluating a Limit Using the Limit Definition of Euler's Number: Limits Containing Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37725244-8e7d-5075-80ef-7b6bf5a1dbe3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "exy" :db/id #edb/ref 17592186251008} {:answer/id #uuid "41fc7021-61fd-56c8-ab99-39ebabdfa3ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{x+y}" :db/id #edb/ref 17592186251103} {:answer/id #uuid "65870a10-fa73-5bb3-af78-9443d90fc53e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{e}^{y}" :db/id #edb/ref 17592186251384} {:answer/id #uuid "90a56f2b-351b-5999-81f1-fd801ab32d03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{xy}" :db/id #edb/ref 17592186251785} {:answer/id #uuid "af2f2a35-38fb-52eb-bdd2-a7e8e12a28f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y{e}^{x}" :db/id #edb/ref 17592186252080}] :answer-field/correct {:answer/id #uuid "90a56f2b-351b-5999-81f1-fd801ab32d03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{xy}" :db/id #edb/ref 17592186251785} :answer-field/id #uuid "6fefafe4-59ed-50f7-b86d-1c6cade14c91" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253004}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "24044cb0-a390-54f5-a384-3ba8bf4f52b0" :question/math-academy-id "q-118090" :question/problem "${lim}_{n\\to \\infty }{(1+\\frac{1}{n})}^{nxy}=$" :question/worked-solution "Recall the following special limit: \n\n$$\ne={lim}_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}\n$$\n\nNow, we rewrite the given limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}{lim}_{n\\to \\infty }{(1+\\frac{1}{n})}^{nxy} & ={lim}_{n\\to \\infty }{[{(1+\\frac{1}{n})}^{n}]}^{xy} \\\\  & ={[{lim}_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}]}^{xy} \\\\  & ={e}^{xy}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253454 :knowledge-point/_questions [{:db/id #edb/ref 17592186096704 :knowledge-point/id #uuid "dc86c375-c2c4-56b7-a207-0abfc9709f6a" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08b7a1e2-2234-5972-a128-08fb39f06dbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-4)^{2}=5(x-6)" :db/id #edb/ref 17592186250630} {:answer/id #uuid "b60bb7a8-52f6-584f-a4bf-3e844e94e661" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-4)^{2}=3(x-6)" :db/id #edb/ref 17592186252154} {:answer/id #uuid "c52f456e-d64e-5f46-a9e4-84edfe0766c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-6)^{2}=-5(x-4)" :db/id #edb/ref 17592186252299} {:answer/id #uuid "d7e3e02b-032b-5e7e-9f66-142cdfdd6a61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-4)^{2}=-3(x-6)" :db/id #edb/ref 17592186252466} {:answer/id #uuid "fb3d962a-57d2-545b-a36a-897c8ba80fcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-4)^{2}=-5(x-6)" :db/id #edb/ref 17592186252756}] :answer-field/correct {:answer/id #uuid "fb3d962a-57d2-545b-a36a-897c8ba80fcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-4)^{2}=-5(x-6)" :db/id #edb/ref 17592186252756} :answer-field/id #uuid "3f980315-6664-5b6c-9a9a-9c681494e4b7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252914}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fa256900-e0ea-52f1-985a-4c3b8bdded9a" :question/math-academy-id "q-11811" :question/problem "![](images/ec/ecf128d341a8a568ade4abaa2a59e1083d2c436fdb3d2a0b4b642fb7e85cee63.png)\n\nWhat is the equation of the parabola shown above?" :question/worked-solution "From the diagram we see that the arms of the parabola open to the left. The parabola has its vertex at $(6,4)$ and passes through the point $(1,9).$\n\nThe general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(6,4),$ we substitute $h=6$ and $k=4$ into the equation above and get\n\n$$\n\\begin{aligned}(y-4)^{2} & =4p(x-6).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(1,9),$ so we can substitute $x=1$ and $y=9$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}(y-4)^{2} & =4p(x-6) \\\\ (9-4)^{2} & =4p(1-6) \\\\ 25 & =-20p \\\\ p & =-\\frac{5}{4}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}(y-4)^{2} & =4p(x-6) \\\\ (y-4)^{2} & =4(-\\frac{5}{4})(x-6) \\\\ (y-4)^{2} & =-5(x-6).\\end{aligned}\n$$\n\nNotice that the arms of the parabola open to the left since $p=-\\frac{5}{4}$ is negative."}] [{:db/id #edb/ref 17592186253456 :knowledge-point/_questions [{:db/id #edb/ref 17592186083241 :knowledge-point/id #uuid "89dc22a6-dd98-544c-8232-5043fac2bd3d" :knowledge-point/title "Solving a Rational Equations by Factoring a Quadratic Denominator With No Constant Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18683fc1-6e6f-552f-b3d8-1a598e647afe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "d=\\frac{3}{2}" :db/id #edb/ref 17592186250768} {:answer/id #uuid "afd8104c-d61b-5874-bc43-96a15275c763" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "d=-2" :db/id #edb/ref 17592186252087} {:answer/id #uuid "b3372c5e-1b3d-526f-a2ff-bdb9fc2ba5f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "d=5" :db/id #edb/ref 17592186252121} {:answer/id #uuid "c7189c96-8126-52ba-9ab5-81ef9869fbe6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No solutions" :db/id #edb/ref 17592186252312} {:answer/id #uuid "db77b71c-5ce2-5ae9-9c3c-53b2ac47a7d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "d=4" :db/id #edb/ref 17592186252480}] :answer-field/correct {:answer/id #uuid "c7189c96-8126-52ba-9ab5-81ef9869fbe6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No solutions" :db/id #edb/ref 17592186252312} :answer-field/id #uuid "485e4678-0882-55ac-8cb1-e26d4e0dafbf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252933}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8477c0d3-7e97-5832-b4f8-9e356450f509" :question/math-academy-id "q-118114" :question/problem "Solve the equation $\\frac{4}{d}+\\frac{6}{{d}^{2}-3d}=\\frac{2}{d-3}.$" :question/worked-solution "First, we factor the quadratic denominator, giving us the equation\n\n$$\n\\frac{4}{d}+\\frac{6}{d(d-3)}=\\frac{2}{d-3}.\n$$\n\nWe now make the following observations:\n\n- The least common denominator of our equation is given by\n\n$$\n\\text{LCM}(d,\\,d(d-3),\\,d-3)=d(d-3).\n$$\n\n- The values $d=0$ and $d=3$ cannot be solutions to our equation. These values make at least one denominator in our original equation equal zero, and division by zero is undefined.\n\nNow, multiplying both sides of the equation by the least common denominator, we can simplify it as follows:\n\n$$\n\\begin{aligned}\\frac{4}{d}+\\frac{6}{d(d-3)} & =\\frac{2}{d-3} \\\\ d(d-3)\\cdot (\\frac{4}{d}+\\frac{6}{d(d-3)}) & =d(d-3)\\cdot \\frac{2}{d-3} \\\\ \\frac{4d(d-3)}{d}+\\frac{6d(d-3)}{d(d-3)} & =\\frac{2d(d-3)}{d-3} \\\\ \\frac{4\\cdot \\cancel{d}\\cdot (d-3)}{\\cancel{d}}+\\frac{6\\cdot \\cancel{d(d-3)}}{\\cancel{d(d-3)}} & =\\frac{2d\\cdot \\cancel{(d-3)}}{\\cancel{d-3}} \\\\ 4(d-3)+6 & =2d\\end{aligned}\n$$\n\nSolving this equation for $d,$ we get the following:\n\n$$\n\\begin{aligned}4(d-3)+6 & =2d \\\\ 4d-6 & =2d \\\\ 2d & =6 \\\\ d & =3\\end{aligned}\n$$\n\nHowever, since $d=3$  is not a valid solution, our equation has no solutions."}] [{:db/id #edb/ref 17592186253457 :knowledge-point/_questions [{:db/id #edb/ref 17592186083241 :knowledge-point/id #uuid "89dc22a6-dd98-544c-8232-5043fac2bd3d" :knowledge-point/title "Solving a Rational Equations by Factoring a Quadratic Denominator With No Constant Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0801c677-febc-5048-b4a9-bd16e29096aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v=-3" :db/id #edb/ref 17592186250620} {:answer/id #uuid "259a4b59-97e1-5b2a-ae19-ec0054e36543" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v=\\frac{1}{4}" :db/id #edb/ref 17592186250878} {:answer/id #uuid "9b65b064-032f-5a74-8b4d-b5fd5feeec61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v=2" :db/id #edb/ref 17592186251892} {:answer/id #uuid "def82426-7548-5608-afb8-c119d37b39c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No solutions" :db/id #edb/ref 17592186252518} {:answer/id #uuid "f83cbd43-a1c5-5373-b93c-4ff388a4a312" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v=-\\frac{2}{3}" :db/id #edb/ref 17592186252725}] :answer-field/correct {:answer/id #uuid "def82426-7548-5608-afb8-c119d37b39c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No solutions" :db/id #edb/ref 17592186252518} :answer-field/id #uuid "6942e994-071a-50b2-a350-0106e069e5db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252997}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "686ef7d4-296f-572a-a3ca-d6455dccd76c" :question/math-academy-id "q-118117" :question/problem "Solve the equation $\\frac{6}{v+4}+\\frac{12}{{v}^{2}+4v}=\\frac{3}{v}.$" :question/worked-solution "First, we factor the quadratic denominator, giving us the equation\n\n$$\n\\frac{6}{v+4}+\\frac{12}{v(v+4)}=\\frac{3}{v}.\n$$\n\nWe now make the following observations:\n\n- The least common denominator of our equation is given by\n\n$$\n\\text{LCM}(v+4,\\,v(v+4),\\,v)=v(v+4).\n$$\n\n- The values $v=0$ and $v=-4$ cannot be solutions to our equation. These values make at least one denominator in our original equation equal zero, and division by zero is undefined.\n\nNow, multiplying both sides of the equation by the least common denominator, we can simplify it as follows:\n\n$$\n\\begin{aligned}\\frac{6}{v+4}+\\frac{12}{v(v+4)} & =\\frac{3}{v} \\\\ v(v+4)\\cdot (\\frac{6}{v+4}+\\frac{12}{v(v+4)}) & =v(v+4)\\cdot \\frac{3}{v} \\\\ \\frac{6v(v+4)}{v+4}+\\frac{12v(v+4)}{v(v+4)} & =\\frac{3v(v+4)}{v} \\\\ \\frac{6v\\cdot \\cancel{(v+4)}}{\\cancel{v+4}}+\\frac{12\\cdot \\cancel{v(v+4)}}{\\cancel{v(v+4)}} & =\\frac{3\\cdot \\cancel{v}\\cdot (v+4)}{\\cancel{v}} \\\\ 6v+12 & =3(v+4)\\end{aligned}\n$$\n\nSolving this equation for $v,$ we get the following:\n\n$$\n\\begin{aligned}6v+12 & =3(v+4) \\\\ 6v+12 & =3v+12 \\\\ 3v & =0 \\\\ v & =0\\end{aligned}\n$$\n\nHowever, since $v=0$  is not a valid solution, our equation has no solutions."}] [{:db/id #edb/ref 17592186253458 :knowledge-point/_questions [{:db/id #edb/ref 17592186096705 :knowledge-point/id #uuid "783ca59b-0242-584c-ae47-004a0eb03817" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola Given the Vertex and Another Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d3096b9-f658-5a5e-a9ee-05a065a40ec2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+3)^{2}=5(x+4)" :db/id #edb/ref 17592186250669} {:answer/id #uuid "3b6a4707-c77a-57ee-bf7d-6d66af5d99f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+3)^{2}=-5(x+4)" :db/id #edb/ref 17592186251046} {:answer/id #uuid "41a25de4-34c7-58f7-a526-4821b209bb8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+4)^{2}=5(x+3)" :db/id #edb/ref 17592186251100} {:answer/id #uuid "8d7596d2-dcc4-5089-8930-3276299bf88f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+3)^{2}=2(x+4)" :db/id #edb/ref 17592186251749} {:answer/id #uuid "c0392c91-bd09-5f41-835e-33d8a1926611" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+3)^{2}=-2(x+4)" :db/id #edb/ref 17592186252251}] :answer-field/correct {:answer/id #uuid "0d3096b9-f658-5a5e-a9ee-05a065a40ec2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+3)^{2}=5(x+4)" :db/id #edb/ref 17592186250669} :answer-field/id #uuid "61d9ebf6-042f-5415-8e18-1294497ab7e0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252980}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7d7e628d-39ea-5461-9b3a-d34dcc6784ed" :question/math-academy-id "q-11812" :question/problem "Find the equation of the right-opening parabola that has its vertex at $(-4,-3)$ and passes through the point $(1,2).$" :question/worked-solution "The general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(-4,-3),$ we substitute $h=-4$ and $k=-3$ into the equation above and get\n\n$$\n\\begin{aligned}(y+3)^{2} & =4p(x+4).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(1,2),$ so we can substitute $x=1$ and $y=2$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}(y+3)^{2} & =4p(x+4) \\\\ (2+3)^{2} & =4p(1+4) \\\\ 25 & =20p \\\\ p & =\\frac{5}{4}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}(y+3)^{2} & =4p(x+4) \\\\ (y+3)^{2} & =4(\\frac{5}{4})(x+4) \\\\ (y+3)^{2} & =5(x+4).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253461 :knowledge-point/_questions [{:db/id #edb/ref 17592186152228 :knowledge-point/id #uuid "16ad6bbc-b8c4-52f6-9f24-0d8494d83b94" :knowledge-point/title "Applying the Limit Definition of the Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f142a76-4d04-574a-bc79-9b28e54825e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{x{y}^{2}}" :db/id #edb/ref 17592186250819} {:answer/id #uuid "5cd26283-aa09-5df2-bcfb-0f251b2ae79a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{xy}" :db/id #edb/ref 17592186251319} {:answer/id #uuid "adca2f0d-7b9d-5fa8-980e-f84a089cabaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-2xy}" :db/id #edb/ref 17592186252069} {:answer/id #uuid "c2b660df-bb9d-5e08-8d34-d4abdc70a0f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{{y}^{2}}" :db/id #edb/ref 17592186252272} {:answer/id #uuid "fe67d913-7242-5271-84e6-a5e3389f5b0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{{x}^{2}}" :db/id #edb/ref 17592186252785}] :answer-field/correct {:answer/id #uuid "1f142a76-4d04-574a-bc79-9b28e54825e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{x{y}^{2}}" :db/id #edb/ref 17592186250819} :answer-field/id #uuid "39053875-9fea-557a-861d-a496f21ad81b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252898}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "620596ff-d0c1-5ad6-bffe-e964c03d3a0b" :question/math-academy-id "q-118135" :question/problem "${lim}_{n\\to \\infty }{(1+\\frac{x}{n})}^{n{y}^{2}}=$" :question/worked-solution "Recall the following special limit: \n\n$$\n{e}^{x}={lim}_{n\\to \\infty }{(1+\\frac{x}{n})}^{n}\n$$\n\nNow, we rewrite the given limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}{lim}_{n\\to \\infty }{(1+\\frac{x}{n})}^{n{y}^{2}} & ={lim}_{n\\to \\infty }{[{(1+\\frac{x}{n})}^{n}]}^{{y}^{2}} \\\\  & ={[{lim}_{n\\to \\infty }{(1+\\frac{x}{n})}^{n}]}^{{y}^{2}} \\\\  & ={({e}^{x})}^{{y}^{2}} \\\\  & ={e}^{x{y}^{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253466 :knowledge-point/_questions [{:db/id #edb/ref 17592186096695 :knowledge-point/id #uuid "29e2083d-fe76-5a35-9c3a-7e6ad19ff968" :knowledge-point/title "Determining the Equation of a Parabola With Non-Origin Vertex Passing Through a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "169c4d0d-a974-5ab0-ab10-ece44e9bf719" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+1)^{2}=4(y+4)" :db/id #edb/ref 17592186250749} {:answer/id #uuid "27b81da8-ffe4-5749-9d5c-518f42d88756" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+4)^{2}=2(y+1)" :db/id #edb/ref 17592186250893} {:answer/id #uuid "34c9b005-e169-5610-83db-29fce1448453" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+1)^{2}=2(y+4)" :db/id #edb/ref 17592186250995} {:answer/id #uuid "7bee81ac-628e-5cc9-9189-39eb038e571c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+1)^{2}=-2(y+4)" :db/id #edb/ref 17592186251585} {:answer/id #uuid "d5bedb93-90d7-53ff-82ed-889cadbd470e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+1)^{2}=-4(y+4)" :db/id #edb/ref 17592186252446}] :answer-field/correct {:answer/id #uuid "34c9b005-e169-5610-83db-29fce1448453" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+1)^{2}=2(y+4)" :db/id #edb/ref 17592186250995} :answer-field/id #uuid "72c319bd-e1d9-5c37-820b-e6a962767d54" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253008}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ca3b7f51-a5a6-56e7-8463-29fa6d537419" :question/math-academy-id "q-11822" :question/problem "Find the equation of the upward-opening parabola that has its vertex at $(-1,-4)$ and which passes through the point $(1,-2).$" :question/worked-solution "For any upward or downward-opening parabola with its vertex at $(h,k),$ the general standard equation is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nHere, the vertex has coordinates $(h,k)=(-1,-4).$ Substituting these into the general standard equation, we get\n\n$$\n\\begin{aligned}(x-(-1))^{2} & =4p(y-(-4)) \\\\ (x+1)^{2} & =4p(y+4).\\end{aligned}\n$$\n\nWe are left to find the value of $p.$ We know that the given parabola also passes through the point $(1,-2),$ so we can substitute $x=1$ and $y=-2$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}(x+1)^{2} & =4p(y+4) \\\\ (1+1)^{2} & =4p(-2+4) \\\\ 4 & =8p \\\\ p & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}(x+1)^{2} & =4p(y+4) \\\\ (x+1)^{2} & =4(\\frac{1}{2})(y+4) \\\\ (x+1)^{2} & =2(y+4).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253467 :knowledge-point/_questions [{:db/id #edb/ref 17592186096845 :knowledge-point/id #uuid "1c269944-636a-50f2-bfc9-c32a7b2e7ca3" :knowledge-point/title "Calculating a Derivative Using the Chain and Product Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46092d6a-5809-530b-96aa-d18ca741a149" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(9x+1){e}^{9x}" :db/id #edb/ref 17592186251132} {:answer/id #uuid "9449d2c4-40c8-5886-a8f8-d377e92abd71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(9x+10){e}^{9x}" :db/id #edb/ref 17592186251828} {:answer/id #uuid "9fcc1d83-99af-5f5a-b373-703da0e18e92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+1){e}^{9x}" :db/id #edb/ref 17592186251929} {:answer/id #uuid "a8022752-cd20-552c-942e-08b64f288227" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9x{e}^{9x}" :db/id #edb/ref 17592186252002} {:answer/id #uuid "af7653ed-b253-50e2-9a68-8c72c94c9870" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9(x+1){e}^{9x}" :db/id #edb/ref 17592186252083}] :answer-field/correct {:answer/id #uuid "9449d2c4-40c8-5886-a8f8-d377e92abd71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(9x+10){e}^{9x}" :db/id #edb/ref 17592186251828} :answer-field/id #uuid "2531d2a5-3c0e-51d6-8cfe-475ebfb26445" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252873}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ab66beff-1db7-5265-a536-ea4d30aeb123" :question/math-academy-id "q-11824" :question/problem "Given that $y=(x+1){e}^{9x},$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "This question requires the product rule. Let $u(x)=x+1$ and $v(x)={e}^{9x}.$ Then\n\n$$\n{u}^{′}(x)=1,\\,{v}^{′}(x)=9{e}^{9x}.\n$$\n\nNote that we used the chain rule to differentiate $v.$\n\nNow, applying the product rule and simplifying, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(1)({e}^{9x})+(x+1)(9{e}^{9x}) \\\\  & ={e}^{9x}+9(x+1){e}^{9x} \\\\  & =(1+9(x+1)){e}^{9x} \\\\  & =(9x+10){e}^{9x}.\\end{aligned}\n$$"}]}
