type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186374482} {:answer/id #uuid "bb60e137-34a0-5ef3-abdb-08f2da979d45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186374483} {:answer/id #uuid "780ff5d8-866a-5aee-924b-e10858d57391" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186374484}] :answer-field/correct {:answer/id #uuid "da53ca8e-a69a-52fc-b090-2ce4f140771b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186374482} :answer-field/id #uuid "852ea0e3-2448-5d7b-ab53-0dbf10533be7" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186374479}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6c5b2d74-698c-58cf-808c-b4cad536b3ae" :question/math-academy-id "q-181805" :question/problem "![](images/40/40f8e6728cd7108f5026bd87debfbf60b616965686065c8e60f0d3ab741e52e4.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n{(x,y)\\in {{field-1}}\\,:\\,{{field-2}}\\le x\\le {{field-3}},\\,{{field-4}}\\le y\\le {{field-5}}}\n$$" :question/worked-solution "A point $P(x,y)$ lies inside or on the rectangle's edges if the following conditions are satisfied:\n\n$$\n\\begin{aligned}1\\le x\\le 6,\\,3\\le y\\le 5\\end{aligned}\n$$\n\nMoreover, since *every* real value in these intervals is included, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write our set as follows:\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,1\\le x\\le 6,\\,3\\le y\\le 5}\n$$"}] [{:db/id #edb/ref 17592186389902 :knowledge-point/_questions [{:db/id #edb/ref 17592186054633 :knowledge-point/id #uuid "b304527c-5cdc-57df-b118-e555f6f8fa5c" :knowledge-poin