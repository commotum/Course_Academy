edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389798}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "60baa69f-bbf2-5905-831d-ab5e879fa2f0" :question/math-academy-id "q-177648" :question/problem "Let $I=[0,1]⊂R$ and ${X}_{i}=[0,i]\\times [0,1].$ Which of the following represents ${⋂}_{i\\in I}{X}_{i}?$" :question/worked-solution "Recall that the intersection of a family of indexed sets consists of those elements that belong to *all* the sets:\n\n$$\n{⋂}_{i\\in I}{A}_{i}={x\\,:\\,x\\in {A}_{k}\\,\\,\\text{for all}\\,\\,k\\in I}\n$$\n\nLet's now write down one of our indexed sets. For example, if $i=0.5,$ we have \n\n$$\n{X}_{0.5}=[0,0.5]\\times [0,1]={(a,b)\\,:\\,a\\in [0,0.5],b\\in [0,1]}.\n$$\n\nThis represents a rectangle whose vertices are at $(0,0),$ $(0.5,0),$ $(0.5,1),$ and $(0,1)$ in the coordinate plane, as shown below.\n\n![](images/5b/5b882f3fb0e7b44eb2df3a510260574e5c4a4d85842a9c0d65515f1a40894756.png)\n\nIn general,\n\n$$\n{X}_{i}=[0,i]\\times [0,1]={(a,b)\\,:\\,a\\in [0,i],b\\in [0,1]}\n$$\n\nis the rectangle whose vertices are at $(0,0),$ $(i,0),$ $(i,1),$ and $(0,1).$\n\n![](images/cb/cb530698591dbd71a8058d9faa0c60b636dc654f21e92d65ec8295aeaa67355a.png)\n\nThe intersection of all these rectangles is the line segment ${0}\\times [0,1]:$\n\n![](images/70/704f8f6f0666d09bb2b8a25eab0548c3eb808e2c9d394d2ae873de35cb0112d1.png)"}] [{:db/id #edb/ref 17592186389811 :knowledge-point/_questions [{:db/id #edb/ref 17592186198274 :knowledge-point/id #uuid "6290e701-b4ea-5a86-ab7e-7371c5bdc11e" :knowledge-point/title "Visualizing Unions of Uncountable Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af8829ea-eabd-5fae-9578-d03488cfc3af" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/26/26e4af1684065b2127b0d9ec33632128f62a3b2b3aa772b48062ed23708b1b7d.png" :db/id #edb/ref 17592186389813} {:answer/id #uuid "1a0a9aea-b6fe-56e1-a8a9-e3ac81332f35" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2f/2f3d6fcce069f0b7b7918481b4cda68ba16fbb94dbf3ebe6b6841256470b84ea.png" :db/id #edb/ref 17592186389814} {:answer/id #uuid "a269d017-1375-58cf-b810-de5eeec9412c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/db/db4bea7c2f08abb66318443c88a0504bbfdc3d9597b3f42a8808795ebc78b172.png" :db/id #edb/ref 17592186389815} {:answer/id #uuid "e387bc96-400f-584b-a615-edb0551b66e6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3b/3b3cefa03d71d99e4b7f3b6852ed36512d2a841a37c558034eac5c4b6870799c.png" :db/id #edb/ref 17592186389816} {:answer/id #uuid "fcb67f6a-535a-53df-a825-cfba0db7f11b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a1/a156cbc15d6841b1d661b77c3b2cf7e6459246e20653da5e461cc6446aded4c6.png" :db/id #edb/ref 17592186389817}] :answer-field/correct {:answer/id #uuid "e387bc96-400f-584b-a615-edb0551b66e6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3b/3b3cefa03d71d99e4b7f3b6852ed36512d2a841a37c558034eac5c4b6870799c.png" :db/id #edb/ref 17592186389816} :answer-field/id #uuid "6201decc-d007-5bcc-852b-b1b8b5bc7b28" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389812}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f0ade82f-e346-52ab-87f9-cb9aa1c85b6d" :question/math-academy-id "q-177651" :question/problem "Let $I=[0,1]⊂R$ and ${X}_{i}=[-i,i]\\times {2i}.$ Which of the following represents ${⋃}_{i\\in I}{X}_{i}?$" :question/worked-solution "Recall that the union of a family of indexed sets consists of those elements that belong to *at least one* set:\n\n$$\n{⋃}_{i\\in I}{A}_{i}={x\\,:\\,x\\in {A}_{k}\\,\\,\\text{for at least one}\\,\\,k\\in I}\n$$\n\nLet's now write down one of our indexed sets. For example, if $i=0.5,$ we have \n\n$$\n{X}_{0.5}=[-0.5,0.5]\\times {1}={(k,1)\\,:\\,k\\in [-0.5,0.5]}.\n$$\n\nThis represents a horizontal line segment from the point $(-0.5,1)$ to the point $(0.5,1)$ in the coordinate plane, as shown below.\n\n![](images/6c/6c6aafd9ea78868e953340eaab3862491d275972d690e2ceb27c213dadbcaea6.png)\n\nIn general,\n\n$$\n{X}_{i}=[-i,i]\\times {2i}={(k,2i)\\,:\\,k\\in [-i,i]}\n$$\n\nis the horizontal line segment from the point $(-i,2i)$ to the point $(i,2i).$ \n\n![](images/02/02c8f93a25d7b510d3e238e6d4a974d6ccc2e83f3ac01fe92ce4535fbb4dce48.png)\n\nAs $i$ runs over $I,$ these line segments sweep the following triangle that represents the union ${⋃}_{i\\in I}{X}_{i}:$\n\n![](images/3b/3b3cefa03d71d99e4b7f3b6852ed36512d2a841a37c558034eac5c4b6870799c.png)"}] [{:db/id #edb/ref 17592186389818 :knowledge-point/_questions [{:db/id #edb/ref 17592186083224 :knowledge-point/id #uuid "d22726fc-8e6b-5e22-80c8-fbc2aa245217" :knowledge-point/title "Calculating the Number of Combinations of Objects Chosen From a Group of at Least Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cec59a22-5d6d-5de8-9f8a-45ef6bb808a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,957\\,920" :db/id #edb/ref 17592186389820} {:answer/id #uuid "afeaf0f3-14db-58e7-8c72-651f40583589" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,581\\,580" :db/id #edb/ref 17592186389821} {:answer/id #uuid "ceb700f8-9524-59c1-89ab-917235da5475" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,209\\,112" :db/id #edb/ref 17592186389822} {:answer/id #uuid "6cc04816-e879-5d68-b950-f374a65870ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,662\\,100" :db/id #edb/ref 17592186389823} {:answer/id #uuid "c82b7429-84d6-539e-b5c5-1835b7badc17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "750\\,020" :db/id #edb/ref 17592186389824}] :answer-field/correct {:answer/id #uuid "afeaf0f3-14db-58e7-8c72-651f40583589" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,581\\,580" :db/id #edb/ref 17592186389821} :answer-field/id #uuid "0c7c9200-9af1-5711-bd23-c6a6abc5a745" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389819}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4bfaea9e-ab13-55ff-a72c-f7e351269ac2" :question/math-academy-id "q-1781" :question/problem "How many different ways can a group of four be made from a room of eighty people?" :question/worked-solution "In general, the number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nThere are $80$ people, so $n=80.$ We want to select $4$ of those people for each group, so we have $r=4.$\n\nTherefore, the number of different potential groups of four is\n\n$$\n\\begin{aligned}{}_{80}{C}_{4} & =\\frac{80!}{(80-4)!\\,4!} \\\\  & =\\frac{80!}{76!4!} \\\\  & =\\frac{80\\cdot 79\\cdot 78\\cdot 77\\cdot \\cancel{76!}}{\\cancel{76!}4!} \\\\  & =\\frac{80\\cdot 79\\cdot 78\\cdot 77}{4\\cdot 3\\cdot 2\\cdot 1} \\\\  & =\\frac{37\\,957\\,920}{24} \\\\  & =1\\,581\\,580.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186398638 :knowledge-point/_questions [{:db/id #edb/ref 17592186054751 :knowledge-point/id #uuid "ca7f6e86-a083-5dcd-beaa-8c3eae151bf1" :knowledge-point/title "Determining the Multiplicity of a Root of a Cubic Polynomial Using Grouping"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49f83912-5796-573a-b936-a61ffb603ff7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-5,\\,5" :db/id #edb/ref 17592186398640} {:answer/id #uuid "b6a7c8bb-09ff-5a0f-b690-cf0f292ac7ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=5" :db/id #edb/ref 17592186398641} {:answer/id #uuid "d012c549-4023-5194-9620-c38392bb0ca8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{5}" :db/id #edb/ref 17592186398642} {:answer/id #uuid "1ca07054-2359-5a47-9068-5f524310351e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{1}{5}" :db/id #edb/ref 17592186398643} {:answer/id #uuid "d7f9a8cc-12c2-5db4-9c8e-f8300024f0d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-5" :db/id #edb/ref 17592186398644}] :answer-field/correct {:answer/id #uuid "b6a7c8bb-09ff-5a0f-b690-cf0f292ac7ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=5" :db/id #edb/ref 17592186398641} :answer-field/id #uuid "7a80fbe4-dbfb-530c-af35-e0f30a4a5542" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398639}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d601c130-3a93-5630-8b35-93cbbfae4d1b" :question/math-academy-id "q-178256" :question/problem "Which root(s) of the polynomial $p(x)={x}^{3}-5{x}^{2}-25x+125$ have multiplicity $2?$" :question/worked-solution "First, we need to factor the polynomial. For this polynomial, we can factor by grouping:\n\n$$\n\\begin{aligned}p(x) & ={x}^{3}-5{x}^{2}-25x+125 \\\\  & ={x}^{2}(x-5)-25(x-5) \\\\  & =({x}^{2}-25)(x-5) \\\\  & =(x+5)(x-5)(x-5) \\\\  & =(x-5{)}^{2}(x+5)\\end{aligned}\n$$\n\nTo find the roots and their multiplicities, we look at the factors:\n\n- The factor $(x-5)$ has an exponent of $2$ in the factored form of $p(x).$ So the root $x=5$ has multiplicity $2.$\n\n- The factor $(x+5)$ has an exponent of $1$ in the factored form of $p(x).$ So the root $x=-5$ has multiplicity $1.$\n\nIn conclusion, only the root $x=5$ has multiplicity $2.$"}] [{:db/id #edb/ref 17592186398645 :knowledge-point/_questions [{:db/id #edb/ref 17592186100997 :knowledge-point/id #uuid "13e430ab-a814-5613-a45d-d8cdd3c14a0f" :knowledge-point/title "Approximating Powers of Numbers Close to Unity: Case With Alternating Signs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bb84096-c5db-5ab5-b2a4-918374d6c439" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.832\\,0" :db/id #edb/ref 17592186398647} {:answer/id #uuid "f40f63d2-b3e6-582d-ab41-031f7f8b7c5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.072\\,1" :db/id #edb/ref 17592186398648} {:answer/id #uuid "0d50c999-6318-51fc-8223-55176a4e0bc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.067\\,9" :db/id #edb/ref 17592186398649} {:answer/id #uuid "e7336544-f099-55c7-9031-17018a6d0ad9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.067\\,9" :db/id #edb/ref 17592186398650} {:answer/id #uuid "03ddf302-e9ba-5f7d-ae52-a4a59258a81b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.932\\,1" :db/id #edb/ref 17592186398651}] :answer-field/correct {:answer/id #uuid "03ddf302-e9ba-5f7d-ae52-a4a59258a81b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.932\\,1" :db/id #edb/ref 17592186398651} :answer-field/id #uuid "64422b03-65b9-5eba-85ad-d054b042f1a5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398646}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1dd05574-640c-5b9b-a9a5-c23bbe5e5973" :question/math-academy-id "q-178288" :question/problem "Use the first three terms of the binomial expansion of $(1+x)^{7}$ in ascending powers of $x$ to approximate $(0.99)^{7}.$ Give your answer to four decimal places." :question/worked-solution "Recall that when $n$ is a positive integer, \n\n$$\n(1+x)^{n}=1+nx+\\frac{1}{2!}n(n-1){x}^{2}+⋯+{x}^{n}.\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{(1+x)}^{7} & =1+7x+\\frac{1}{2}\\cdot 7\\cdot 6\\cdot {x}^{2}+⋯+{x}^{7} \\\\  & =1+7x+21{x}^{2}+⋯+{x}^{7}.\\end{aligned}\n$$\n\nSo, for small $x,$ we have\n\n$$\n{(1+x)}^{7}≈1+7x+21{x}^{2}.\n$$\n\nFinally, we substitute $x=-0.01$ into the above approximation of $(1+x)^{7}:$ \n\n$$\n\\begin{aligned}(0.99)^{7} & =(1+(-0.01))^{7} \\\\  & ≈1+7(-0.01)+21(-0.01)^{2} \\\\  & =1-7(0.01)+21(0.000\\,1) \\\\  & =1-0.07+0.002\\,1 \\\\  & =0.932\\,1,\\end{aligned}\n$$\n\nto four decimal places."}] [{:db/id #edb/ref 17592186083571 :knowledge-point/_questions [{:db/id #edb/ref 17592186083223 :knowledge-point/id #uuid "e7c35604-c9f9-5077-bddc-fe9446ac45e6" :knowledge-point/title "Calculating a Permutation Given Using Alternate Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "daa96f5a-272a-5083-ae18-a2f45cfbf76f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "51820" :db/id #edb/ref 17592186080322} {:answer/id #uuid "2a2fb398-d1ed-525d-9632-00d79ce48ad0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28410" :db/id #edb/ref 17592186080323} {:answer/id #uuid "4383fd96-dd22-5ba3-a4c3-ab91aaa47551" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186080324} {:answer/id #uuid "43aa67da-0d77-5881-b514-101862547f73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1365" :db/id #edb/ref 175921