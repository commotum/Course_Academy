er."}] [{:db/id #edb/ref 17592186396673 :knowledge-point/_questions [{:db/id #edb/ref 17592186068696 :knowledge-point/id #uuid "31eacf5a-75a5-5b38-8c24-4b1598ecf3a7" :knowledge-point/title "Identifying Points of Discontinuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f8cb089-6505-515d-b264-99e427a1221e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-3$ and $x=0$" :db/id #edb/ref 17592186396675} {:answer/id #uuid "c08b5c35-a5d7-5069-b56f-c620adb60e5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ and $x=2$" :db/id #edb/ref 17592186396676} {:answer/id #uuid "86dd1c08-dfcc-5440-8ed6-a1599aed6c51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm 2" :db/id #edb/ref 17592186396677} {:answer/id #uuid "c8a54622-a441-5f4f-8a9d-6f28f972e33c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-3$ only" :db/id #edb/ref 17592186396678} {:answer/id #uuid "50484ca8-86cd-5313-806f-14cb83956a21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=1$ only" :db/id #edb/ref 17592186396679}] :answer-field/correct {:answer/id #uuid "0f8cb089-6505-515d-b264-99e427a1221e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-3$ and $x=0$" :db/id #edb/ref 17592186396675} :answer-field/id #uuid "7d5e1e7b-8e38-5b41-953d-3eb5f39cc12b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396674}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f6e088c5-8b59-5061-af03-e9b40ee3d2a4" :question/math-academy-id "q-48088" :question/problem "![](images/e1/e111be8806fd5351b873219d9a790b71ca862a8fdef8b15df6477265cbb7ddea.png)\n\nWhat are the points of discontinuity of the function plotted above?" :question/worked-solution "The graph breaks at $x=-3$ and $x=0$ meaning that we can't draw the plot without taking our pencil off of the paper when passing through these points.\n\nTherefore, the correct answer is $x=-3$ and $x=0.$"}] [{:db/id #edb/ref 17592186329876 :knowledge-point/_questions [{:db/id #edb/ref 17592186078618 :knowledge-point/id #uuid "c538b0a9-a084-5a83-a5fa-eca4e0270a93" :knowledge-point/title "Comparing an Exponential Function and a Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5591b8c8-3047-562b-8ef4-8361d55d25b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186327673} {:answer/id #uuid "5c302237-b94a-5fe0-81b1-2587947f173d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e+5" :db/id #edb/ref 17592186327742} {:answer/id #uuid "86671781-4a8f-573e-8fe7-aaff83f7332d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡(5)}{e}+5" :db/id #edb/ref 17592186328093} {:answer/id #uuid "ad75e9f7-6e31-5997-8593-a8ef1838747e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186328440} {:answer/id #uuid "d3b4ca71-189f-58de-8fcc-5367fa284f35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186328793}] :answer-field/correct {:answer/id #uuid "ad75e9f7-6e31-5997-8593-a8ef1838747e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186328440} :answer-field/id #uuid "314cef58-95bb-572e-a378-8e9c798f6f07" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329275}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fb78782d-135f-57ce-a3ed-0b840f2e8d22" :question/math-academy-id "q-48212" :question/problem "Evaluate ${lim}_{x\\to \\infty }(\\operatorname{ln}⁡(5x){e}^{-x}+5).$" :question/worked-solution "Notice that we can rewrite the first term as\n\n$$\n\\operatorname{ln}⁡(5x){e}^{-x}=\\frac{\\operatorname{ln}⁡(5x)}{{e}^{x}}.\n$$\n\nBoth the numerator and denominator approach $\\infty $ as $x\\to \\infty .$ However, since ${e}^{x}≫\\operatorname{ln}⁡(5x)$ for large values of $x,$ the denominator is growing much faster than the numerator. Consequently, we conclude that\n\n$$\n{lim}_{x\\to \\infty }\\frac{\\operatorname{ln}⁡(5x)}{{e}^{x}}=0.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }(\\operatorname{ln}⁡(5x){e}^{-x}+5) & ={lim}_{x\\to \\infty }(\\frac{\\operatorname{ln}⁡(5x)}{{e}^{x}}+5) \\\\  & =0+5 \\\\  & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329877 :knowledge-point/_questions [{:db/id #edb/ref 17592186078617 :knowledge-point/id #uuid "433ac237-32ff-591c-ab0d-e271f5beda30" :knowledge-point/title "Comparing a Polynomial Function and a Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "385935e5-40b2-5cdf-a2a7-ac3e7865d543" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186327426} {:answer/id #uuid "814d202d-efc4-5b86-b450-3050ed558ec6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186328048} {:answer/id #uuid "afe78bc0-6b9b-58bb-a6b3-3d1ea65b8862" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186328457} {:answer/id #uuid "c4ec75bd-d3c7-56b5-bdc5-8279661cd6b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186328661} {:answer/id #uuid "ce0d5a69-6971-5c5e-a390-2198a2dca682" :answer/type {:db/i