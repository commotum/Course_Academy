#{[{:db/id #edb/ref 17592186329806 :knowledge-point/_questions [{:db/id #edb/ref 17592186115372 :knowledge-point/id #uuid "6835b52b-adaa-5c66-9f6d-d32591864659" :knowledge-point/title "Evaluating Infinite Limits Using the Laws of Exponents and the Algebra of Limits"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17028eac-4ec5-5412-a437-179e2341db73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186327136} {:answer/id #uuid "699925f0-6e8c-5f1a-b77d-e1c6f323fb8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186327842} {:answer/id #uuid "aa0370f2-56b3-5cc8-a52d-9b4a98865995" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186328406} {:answer/id #uuid "cdfe3a0e-970e-5bb9-8a35-e018230647f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186328745} {:answer/id #uuid "f5621511-1f8d-5799-9acc-c62ea19974de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186329079}] :answer-field/correct {:answer/id #uuid "cdfe3a0e-970e-5bb9-8a35-e018230647f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186328745} :answer-field/id #uuid "1f990210-b8a8-5e34-9486-0ad7ae987df5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329237}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "66cb54a9-7be0-554a-a6fe-eb1aaa1b6f8b" :question/math-academy-id "q-47073" :question/problem "${lim}_{x\\to -\\infty }{2}^{3x-8}=$" :question/worked-solution "We can use the laws of exponents and the algebra of limits to rewrite the given limit, as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }{2}^{3x-8} & ={lim}_{x\\to -\\infty }{2}^{3x}\\cdot {2}^{-8} \\\\  & ={lim}_{x\\to -\\infty }{({2}^{3})}^{x}\\cdot {2}^{-8} \\\\  & ={lim}_{x\\to -\\infty }{8}^{x}\\cdot (\\frac{1}{256}) \\\\  & =(\\frac{1}{256})\\cdot {lim}_{x\\to -\\infty }{8}^{x}\\end{aligned}\n$$\n\nNext, we recall the graph of $y={8}^{x}.$\n\n![](images/85/85319605a7c7b57d4c7ed29b8d409e3169f3331775580b91b70e2be99fef7986.png)\n\nFrom the graph, we see that the function decreases to zero as $x$ decreases. Therefore,\n\n$$\n{lim}_{x\\to -\\infty }{8}^{x}=0.\n$$\n\nSo, we conclude that \n\n$$\n(\\frac{1}{256})\\cdot {lim}_{x\\to -\\infty }{8}^{x}=(\\frac{1}{256})\\cdot 0=0\n$$"}] [{:db/id #edb/ref 17592186392582 :knowledge-point/_questions [{:db/id #edb/ref 17592186092240 :knowledge-point/id #uuid "55a323ba-f2a7-5a49-abd4-a9812518ef8c" :knowledge-point/title "Determining the Equation of a Normal Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10131252-4695-56ed-8c59-747e545f594c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "71" :db/id #edb/ref 17592186392584} {:answer/id #uuid "e6984861-e3cb-5365-9e9e-1ecd4311dcb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "61" :db/id #edb/ref 17592186392585} {:answer/id #uuid "859687f9-c59b-551f-aaa5-e7e3c04ba6c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-81" :db/id #edb/ref 17592186392586} {:answer/id #uuid "95424aa7-6153-5c48-9071-e6e5ac4c3b4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186392587} {:answer/id #uuid "41016988-d005-506a-b687-2940e1c88cd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-71" :db/id #edb/ref 17592186392588}] :answer-field/correct {:answer/id #uuid "95424aa7-6153-5c48-9071-e6e5ac4c3b4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186392587} :answer-field/id #uuid "c9549a2f-75a6-5fa7-b3e3-19c27b3b484f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392583}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "414ee72f-747c-573a-9cad-a9cbdad6101a" :question/math-academy-id "q-47410" :question/problem "The equation of the normal line to the curve $y=3{x}^{2}+4x$ at the point $(1,7)$ is given by $x+py=q$ where $p$ and $q$ are constants. Find the value of $p+q.$" :question/worked-solution "Let $f(x)=3{x}^{2}+4x.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(3{x}^{2}+4x)=6x+4\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(1,7):$\n\n$$\n\\begin{aligned}m={f}^{′}(1)=6(1)+4=10\\end{aligned}\n$$\n\nTherefore, the slope of the normal line ${m}^{′}$ is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{10}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-(7) & =-\\frac{1}{10}(x-1) \\\\ 10y-70 & =-x+1 \\\\ x+10y & =71.\\end{aligned}\n$$\n\nTherefore, $p+q=10+71=81.$"}] [{:db/id #edb/ref 17592186329815 :knowledge-point/_questions [{:db/id #edb/ref 17592186092384 :knowledge-point/id #uuid "4a05f6c0-98ab-5197-922e-8e8dff1d4302" :knowledge-point/title "Calculating the Slope of a Normal Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "298a6c80-4207-50f6-8a34-1d93a5f89fed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186327287} {:answer/id #uuid "307e57c3-1572-5e33-a5f9-3472b90bf91f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186327363} {:answer/id #uuid "e1ee7da7-a08a-5f34-86ea-f3f106a5f98c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186328912} {:answer/id #uuid "e33c1589-993a-5e15-9743-78a5a9f95009" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186328926} {:answer/id #uuid "fb9c839b-8755-5fd8-b8d8-b4929a06d14c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186329142}] :answer-field/correct {:answer/id #uuid "fb9c839b-8755-5fd8-b8d8-b4929a06d14c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186329142} :answer-field/id #uuid "197f2e71-4c00-5a81-830b-269b6b29fd90" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329228}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "704dafc6-9839-55e3-9683-dc5e275270d6" :question/math-academy-id "q-47449" :question/problem "Find the slope of the normal line to the curve $y={x}^{2}+x$ at the point $(1,2).$" :question/worked-solution "Let $f(x)={x}^{2}+x.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}+x) \\\\  & =2x+1\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(1,2):$\n\n$$\nm={f}^{′}(1)=2(1)+1=3\n$$\n\nTherefore, the slope of the normal line ${m}^{′}$ is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{3}.\n$$"}] [{:db/id #edb/ref 17592186329816 :knowledge-point/_questions [{:db/id #edb/ref 17592186176051 :knowledge-point/id #uuid "0e2a8cf2-64db-5b2f-b0f7-0c727cf492a9" :knowledge-point/title "Describing Properties of the Secant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "029e14a6-a3da-5d56-bd50-24aa3841ff59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II" :db/id #edb/ref 17592186326964} {:answer/id #uuid "09838c12-324b-5f86-b8eb-b9a50a5b99f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186327012} {:answer/id #uuid "58d2b82d-ca43-5016-b810-dc807085c710" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186327713} {:answer/id #uuid "d9fe1f38-597e-53c5-aa82-041838d9bba1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III" :db/id #edb/ref 17592186328838} {:answer/id #uuid "ed61f5fa-bf44-559a-b259-d059d2ed706f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186329011}] :answer-field/correct {:answer/id #uuid "ed61f5fa-bf44-559a-b259-d059d2ed706f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186329011} :answer-field/id #uuid "dc0b4dd2-5359-5754-b6be-a086a2742846" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329570}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4ce070dc-f77b-529a-a508-4630f3613570" :question/math-academy-id "q-47455" :question/problem "Which of the following statements are true regarding the function $y=sec⁡x?$\n\n- The period of the function is $\\pi .$\n- The function is increasing in the interval $(-\\frac{\\pi }{2},0].$\n- The function has no zeros." :question/worked-solution "Let's plot the graph of $y=sec⁡x.$\n\n![](images/77/779d7a31646a229492a8165c8212a5c83ad7d37d843c1c1b3b36766a74bc5124.png)\n\nLet's go through each statement.\n\n- Statement I is false. The period of the function is $2\\pi .$\n\n- Statement II is false. The function $y=sec⁡x$ is decreasing on $(-\\frac{\\pi }{2},0].$\n\n- Statement III is true. The function has no zeros."}] [{:db/id #edb/ref 17592186329841 :knowledge-point/_questions [{:db/id #edb/ref 17592186096621 :knowledge-point/id #uuid "3c547746-49c8-5a4a-85fe-c6b75493a354" :knowledge-point/title "Differentiating a Quotient Containing Other Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24cdb15d-92a4-57bb-b3ae-70ee6398efed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}sin⁡x-cos⁡x}{{sin}^{2}⁡x}" :db/id #edb/ref 17592186327252} {:answer/id #uuid "28cffc72-f500-56eb-b62d-297789e3d352" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}(cos⁡x+sin⁡x)}{{cos}^{2}⁡x}" :db/id #edb/ref 17592186327280} {:answer/id #uuid "537f4f22-dc76-5ecc-941c-28735a7fbb3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}sin⁡x-cos⁡x}{{cos}^{2}⁡x}" :db/id #edb/ref 17592186327658} {:answer/id #uuid "6cb04a5b-8198-547f-9f85-6d03684ff103" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}(sin⁡x-cos⁡x)}{cos⁡x}" :db/id #edb/ref 17592186327873} {:answer/id #uuid "6ebf154b-78ed-5323-9bc6-5af4e4ce0e17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}(sin⁡x-cos⁡x)}{{cos}^{2}⁡x}" :db/id #edb/ref 17592186327893}] :answer-field/correct {:answer/id #uuid "28cffc72-f500-56eb-b62d-297789e3d352" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}(cos⁡x+sin⁡x)}{{cos}^{2}⁡x}" :db/id #edb/ref 17592186327280} :answer-field/id #uuid "1139e71c-df1c-5f00-8bad-e71886ea7ae5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329215}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5ace0fb1-1a71-5cfd-952c-d11857b972c9" :question/math-academy-id "q-47943" :question/problem "If $f(x)=\\frac{{e}^{x}}{cos⁡x},$ find ${f}^{′}(x).$" :question/worked-solution "In this case, the expression for $f(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)={e}^{x}$ and $v(x)=cos⁡x.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{({e}^{x})^{′}\\cdot cos⁡x-{e}^{x}\\cdot (cos⁡x)^{′}}{(cos⁡x)^{2}} \\\\  & =\\frac{{e}^{x}cos⁡x+{e}^{x}sin⁡x}{(cos⁡x)^{2}} \\\\  & =\\frac{{e}^{x}(cos⁡x+sin⁡x)}{{cos}^{2}⁡x}\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329845 :knowledge-point/_questions [{:db/id #edb/ref 17592186059676 :knowledge-point/id #uuid "711f198b-26b4-5185-812a-102329d49313" :knowledge-point/title "Finding the Derivative of an Expression With the Tangent Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "026a56b8-1115-5684-ac6e-ef1630e64970" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+\\sqrt{x}{sec}^{2}⁡x}{2\\sqrt{x}}" :db/id #edb/ref 17592186326960} {:answer/id #uuid "0393bd6c-c00c-5794-bb05-1c8299be09b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+2{sec}^{2}⁡\\sqrt{x}}{2\\sqrt{x}}" :db/id #edb/ref 17592186326972} {:answer/id #uuid "25ff194a-cfcd-58a0-adba-8bc91fdf1efe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+2x{sec}^{2}⁡x}{2\\sqrt{x}}" :db/id #edb/ref 17592186327262} {:answer/id #uuid "44d191be-38a4-500e-8cfb-76a9d83fe2e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+2\\sqrt{x}sec⁡x}{2\\sqrt{x}}" :db/id #edb/ref 17592186327534} {:answer/id #uuid "9336f84c-bb60-54b1-ba79-495700d341f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+2\\sqrt{x}{sec}^{2}⁡x}{2\\sqrt{x}}" :db/id #edb/ref 17592186328218}] :answer-field/correct {:answer/id #uuid "9336f84c-bb60-54b1-ba79-495700d341f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+2\\sqrt{x}{sec}^{2}⁡x}{2\\sqrt{x}}" :db/id #edb/ref 17592186328218} :answer-field/id #uuid "39c98579-7ff9-5677-8870-c03daabb35df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329297}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "db3973ed-197d-5377-b8db-60e027e16ad0" :question/math-academy-id "q-47983" :question/problem "Find the derivative of $y=\\sqrt{x}+tan⁡x.$" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(tan⁡x)={sec}^{2}⁡x.$ Applying this formula, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}+tan⁡x) \\\\  & =\\frac{1}{2\\sqrt{x}}+{sec}^{2}⁡x \\\\  & =\\frac{1+2\\sqrt{x}{sec}^{2}⁡x}{2\\sqrt{x}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329846 :knowledge-point/_questions [{:db/id #edb/ref 17592186059675 :knowledge-point/id #uuid "0de0627b-2568-5c02-8928-d14344df5a2f" :knowledge-point/title "Finding the Derivative of an Expression With Sine or Cosine Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58178d4f-4abd-58b7-80f3-235da8563710" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2sin⁡x-2{x}^{-1}" :db/id #edb/ref 17592186327707} {:answer/id #uuid "6e8ba3a3-8163-54a7-a89c-617f3758ea02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2sin⁡x-2{x}^{-3}" :db/id #edb/ref 17592186327890} {:answer/id #uuid "abf48582-4f98-5a96-ba7c-6645540d8053" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2sin⁡x-2{x}^{-3}" :db/id #edb/ref 17592186328424} {:answer/id #uuid "b8c3ad30-bf9c-5740-9f1f-85721ef68822" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2sin⁡x+2{x}^{-3}" :db/id #edb/ref 17592186328543} {:answer/id #uuid "fb5d65e6-8cdc-5871-afa6-4d5b3c079a97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2sin⁡x-2{x}^{-2}" :db/id #edb/ref 17592186329139}] :answer-field/correct {:answer/id #uuid "abf48582-4f98-5a96-ba7c-6645540d8053" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2sin⁡x-2{x}^{-3}" :db/id #edb/ref 17592186328424} :answer-field/id #uuid "fa72fd76-960d-5bcb-9cf5-7f47b8602241" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329616}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f32d0b6b-0338-505d-81ba-ba8c8d1669de" :question/math-academy-id "q-47985" :question/problem "Find the derivative of $y=-2cos⁡x+{x}^{-2}.$" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(cos⁡x)=-sin⁡x.$ Applying this formula, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-2cos⁡x+{x}^{-2}) \\\\  & =-2(-sin⁡x)+(-2){x}^{-2-1} \\\\  & =2sin⁡x-2{x}^{-3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329849 :knowledge-point/_questions [{:db/id #edb/ref 17592186096621 :knowledge-point/id #uuid "3c547746-49c8-5a4a-85fe-c6b75493a354" :knowledge-point/title "Differentiating a Quotient Containing Other Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d04b0f4-3b5e-5a83-ab7c-fadd2fae0aa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{xcos⁡x+2sin⁡x}{{x}^{3}}" :db/id #edb/ref 17592186327753} {:answer/id #uuid "79438a62-c77a-5744-9802-65b0e97ef42c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{cos⁡x-2xsin⁡x}{{x}^{4}}" :db/id #edb/ref 17592186327973} {:answer/id #uuid "85f38040-e7a5-59fd-a359-c862f85f6a27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{xcos⁡x-2sin⁡x}{{x}^{3}}" :db/id #edb/ref 17592186328088} {:answer/id #uuid "a8c4ce4c-f609-552a-9123-d8fd254ccab0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2xcos⁡x-xsin⁡x}{{x}^{3}}" :db/id #edb/ref 17592186328396} {:answer/id #uuid "c0e8be1f-f487-5a62-b564-e74b12097ed9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{xsin⁡x-2cos⁡x}{{x}^{4}}" :db/id #edb/ref 17592186328619}] :answer-field/correct {:answer/id #uuid "85f38040-e7a5-59fd-a359-c862f85f6a27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{xcos⁡x-2sin⁡x}{{x}^{3}}" :db/id #edb/ref 17592186328088} :answer-field/id #uuid "9f86cadc-4440-532f-bf1a-6161f5f6bfb9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329450}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b3c4b5b5-b682-57e6-baf5-0601260b1ed0" :question/math-academy-id "q-47998" :question/problem "If $f(x)=\\frac{sin⁡x}{{x}^{2}},$ find ${f}^{′}(x).$" :question/worked-solution "In this case, the expression for $f(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)=sin⁡x$ and $v(x)={x}^{2}.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(sin⁡x)^{′}\\cdot {x}^{2}-sin⁡x\\cdot ({x}^{2})^{′}}{({x}^{2})^{2}} \\\\  & =\\frac{{x}^{2}cos⁡x-2xsin⁡x}{{x}^{4}} \\\\  & =\\frac{x(xcos⁡x-2sin⁡x)}{{x}^{4}} \\\\  & =\\frac{xcos⁡x-2sin⁡x}{{x}^{3}}\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329850 :knowledge-point/_questions [{:db/id #edb/ref 17592186092260 :knowledge-point/id #uuid "a83f86ab-a008-5487-b118-f1495a0fe4d6" :knowledge-point/title "Differentiating an Exponential Function with a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "016b59fa-7dd1-5430-8a0d-9d17b256b87e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8{e}^{4x-1}+3" :db/id #edb/ref 17592186326950} {:answer/id #uuid "1a09b33b-87d5-53a9-afee-f8e02962d4c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{4x-1}" :db/id #edb/ref 17592186327160} {:answer/id #uuid "35f572ac-b945-560e-89f5-d45ed6858e1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{e}^{4x-1}+3" :db/id #edb/ref 17592186327403} {:answer/id #uuid "bab77687-86e3-5b97-960a-d832566921c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8{e}^{4x-2}" :db/id #edb/ref 17592186328563} {:answer/id #uuid "bfa829b5-29ee-5ba4-a1c8-72e5faa0588a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8{e}^{4x-1}" :db/id #edb/ref 17592186328611}] :answer-field/correct {:answer/id #uuid "bfa829b5-29ee-5ba4-a1c8-72e5faa0588a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8{e}^{4x-1}" :db/id #edb/ref 17592186328611} :answer-field/id #uuid "a2f4dd66-f6d3-5f50-8ce9-b004c416733f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329462}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dd0c521a-06b7-559f-8b78-1152ec8cbcd7" :question/math-academy-id "q-48007" :question/problem "Calculate ${f}^{′}(x)$ if $f(x)=-2{e}^{4x-1}+3.$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf=-2{e}^{u}+3,\\,u=4x-1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=-2{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=4.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-2{e}^{u}\\cdot 4 \\\\  & =-8{e}^{u} \\\\  & =-8{e}^{4x-1}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186392602 :knowledge-point/_questions [{:db/id #edb/ref 17592186068696 :knowledge-point/id #uuid "31eacf5a-75a5-5b38-8c24-4b1598ecf3a7" :knowledge-point/title "Identifying Points of Discontinuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d495799e-2f9d-5146-a399-506d9d32ad84" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c9/c9ba1e63c665ad63597c822828fdf26ec0fefade083df5ea828f57a49d3aa149.png" :db/id #edb/ref 17592186392604} {:answer/id #uuid "c796e42f-5eb7-5d3a-900e-6d5fb58916e3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fc/fc1d428500558ed62fbf5f7e0c13604cbc759629cedb63a8f9c2f7fc0b412480.png" :db/id #edb/ref 17592186392605} {:answer/id #uuid "742220de-47f9-5f30-8679-f64626ac489f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d9/d9185fb471c9806d490133c6ea5a54ef69878f89ca0e0be66008ec3626bfe346.png" :db/id #edb/ref 17592186392606} {:answer/id #uuid "11ce7ab1-ca48-5c69-b7f7-b7ff62f3ea3d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/49/49e7b3c3cd4e6410b95a307f74c90079ec61c2d3540f86a357db88c77039ca44.png" :db/id #edb/ref 17592186392607} {:answer/id #uuid "c37ded1b-1a1e-52ed-a977-31d60b87248f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bd/bd662a57e07bf3f0319a00a15dc5c520a172d59672eae24f7999a4535da0b9ee.png" :db/id #edb/ref 17592186392608}] :answer-field/correct {:answer/id #uuid "c796e42f-5eb7-5d3a-900e-6d5fb58916e3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fc/fc1d428500558ed62fbf5f7e0c13604cbc759629cedb63a8f9c2f7fc0b412480.png" :db/id #edb/ref 17592186392605} :answer-field/id #uuid "ac8479b0-0f39-5a85-82ad-a7d9ee04b2a6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392603}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c3d5f3e1-0f7f-56ba-9eea-f720be7a7122" :question/math-academy-id "q-48038" :question/problem "Select the function that has a discontinuity at $x=1.$" :question/worked-solution "The correct answer is shown below. Notice that the function contains a break exactly at $x=1$ and it's impossible to draw its graph without taking our pencil off of the paper.\n\n![](images/3c/3c8a198c1ec835590a3d755b964929ef9ac9a30e4268b2fdc80dacdb394899d8.png)\n\nAll the other given graphs can be plotted without taking the pencil off of the paper."}] [{:db/id #edb/ref 17592186329854 :knowledge-point/_questions [{:db/id #edb/ref 17592186068697 :knowledge-point/id #uuid "3f92e521-e7ab-56ba-8eac-0484b140b1a2" :knowledge-point/title "Determining the Behavior of a Function in the Neighborhood of a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ee867b9-645a-512d-9f99-f3aa8226ad71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186327063} {:answer/id #uuid "4558acbf-a492-5e1c-acde-0aa26d25d7f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186327540} {:answer/id #uuid "a58a5f87-8e65-5592-8409-a19f0dfcd0ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186328364} {:answer/id #uuid "b013ab09-8aad-54e4-9a17-87cdc1aa5d04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186328460} {:answer/id #uuid "c6636203-3372-5d9c-9639-986cdeaf7e30" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186328677}] :answer-field/correct {:answer/id #uuid "0ee867b9-645a-512d-9f99-f3aa8226ad71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186327063} :answer-field/id #uuid "e45de7c6-c5ce-5b9d-a7b8-ea5254d09158" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329581}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "96069899-bca3-51de-b64c-6e29072ea13e" :question/math-academy-id "q-48062" :question/problem "![](images/d9/d9db7f2a491ae3065dbe8434a71d378c4fed8fec16c82e2fd76dcb209c786809.png)\n\nThe graph of $y=f(x)$ is shown above. Which of the following statements are true? \n\n- $f(x)$ is defined at $x=1$\n- ${lim}_{x\\to \\,1}f(x)$ exists\n- $f(x)$ is continuous at $x=1$" :question/worked-solution "By inspecting the graph, we can conclude the following:\n\n- Statement I is false. From the graph we can see that no value has been assigned to $f(x)$ at $x=1.$\n\n- Statement II is true. Indeed, \n\n$$\n\\begin{aligned}{lim}_{x\\to \\,{1}^{-}}f(x) & =1, \\\\ {lim}_{x\\to \\,{1}^{+}}f(x) & =1.\\end{aligned}\n$$\n\nHence, \n${lim}_{x\\to \\,1}f(x)=1.$\n\n- Statement III is false. The function is not even defined at $x=1.$ The graph contains a break at $x=1.$ It's impossible to draw the graph of $f(x)$ without taking our pencil off of the paper."}] [{:db/id #edb/ref 17592186329855 :knowledge-point/_questions [{:db/id #edb/ref 17592186068697 :knowledge-point/id #uuid "3f92e521-e7ab-56ba-8eac-0484b140b1a2" :knowledge-point/title "Determining the Behavior of a Function in the Neighborhood of a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f05bd8f-eb2f-57d7-ae18-c11817bd78b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186327620} {:answer/id #uuid "83335e31-f97c-5df4-863a-ef88150fb6f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186328065} {:answer/id #uuid "9a9a91aa-3ed8-5151-bcb5-e59ccd13d6bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186328272} {:answer/id #uuid "ce9e8871-1f30-5744-8374-042f56698b0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186328750} {:answer/id #uuid "d6472410-aa22-5e41-a0c0-09e47c3fb93c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186328811}] :answer-field/correct {:answer/id #uuid "83335e31-f97c-5df4-863a-ef88150fb6f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186328065} :answer-field/id #uuid "23e84077-b88d-5119-bcf7-6c45cbfd0278" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329249}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1e01edc7-98f4-52fe-bf43-cb1e05ae0d4a" :question/math-academy-id "q-48065" :question/problem "![](images/fa/fa15192923f9fd7370818fcb6b05b24b3bb6901dfbf90dd53539d71fd0f8b0bf.png)\n\nThe graph of $y=f(x)$ is shown above. Which of the following statements are true? \n\n- $f(x)$ is defined at $x=2$\n- ${lim}_{x\\to \\,2}f(x)=f(2)$\n- $f(x)$ is continuous at $x=2$" :question/worked-solution "By inspecting the graph, we can conclude the following:\n\n- Statement I is true. Indeed, $f(x)$ is defined at $x=2$ and $f(2)=1.$\n\n- Statement II is true. Indeed, from the graph we see that\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,{2}^{-}}f(x) & =1, \\\\ {lim}_{x\\to \\,{2}^{+}}f(x) & =1.\\end{aligned}\n$$\n\nHence, ${lim}_{x\\to \\,2}f(x)=1=f(2).$\n\n- Statement III is true. The graph of $f(x)$ can be drawn without taking our pencil off of the paper in the neighborhood of $x=2.$"}] [{:db/id #edb/ref 17592186329858 :knowledge-point/_questions [{:db/id #edb/ref 17592186092382 :knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172" :knowledge-point/title "Calculating the Equation of a Tangent Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02cb37f5-2f1d-5582-9b0a-ba3d5ae84781" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x-12" :db/id #edb/ref 17592186326967} {:answer/id #uuid "12f35963-b5fb-5ee8-a217-7821558518c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4x-3" :db/id #edb/ref 17592186327097} {:answer/id #uuid "29f970a0-530a-5098-9cef-2daea001ef9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4x-1" :db/id #edb/ref 17592186327295} {:answer/id #uuid "39dad4a5-4110-5374-97bc-fe41c7c0f5d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5x-5" :db/id #edb/ref 17592186327440} {:answer/id #uuid "83d0f077-ab57-54f6-80e1-8b63e8a4c95e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5x-2" :db/id #edb/ref 17592186328072}] :answer-field/correct {:answer/id #uuid "83d0f077-ab57-54f6-80e1-8b63e8a4c95e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5x-2" :db/id #edb/ref 17592186328072} :answer-field/id #uuid "324d4519-c59d-5772-95b5-cc69664e41ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329278}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a5a7a5a2-50a1-5b97-8ac0-810e9082e127" :question/math-academy-id "q-4807" :question/problem "Find the equation of the tangent to the curve $y=2{x}^{2}+x$ at the point $(1,3).$" :question/worked-solution "Let $f(x)=2{x}^{2}+x.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{2}+x)=4x+1.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(1)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(1)=4(1)+1=5\\,.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=5$ and the coordinates of our point $(1,3),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(3) & =5(x-1) \\\\ y & =5x-5+3 \\\\ y & =5x-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186392615 :knowledge-point/_questions [{:db/id #edb/ref 17592186068695 :knowledge-point/id #uuid "6cd6c125-ecaf-5847-a802-ec1b3594a15c" :knowledge-point/title "Determining Whether a Function Is Continuous at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5cffd7b-e09a-5e8f-9bc6-d30e9bf80623" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c6/c6f0914f0b218164bc99fdefe7d83dffe4591a6b704e2243013d05c2b117ef17.png" :db/id #edb/ref 17592186392617} {:answer/id #uuid "3ba0ee0f-2ced-5835-84e5-0ed53e1549d3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c2/c2f85d1a2becc7bfe6f71d7f6fcb178f4707f4b41956015eabb38610de95feca.png" :db/id #edb/ref 17592186392618} {:answer/