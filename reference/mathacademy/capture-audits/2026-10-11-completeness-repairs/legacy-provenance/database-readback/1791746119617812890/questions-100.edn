6251832} :answer-field/id #uuid "2eaf0b8e-d288-5d0b-bf74-c0a503925436" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252884}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1bf0a7be-9fd8-54b8-9e4e-418e2d997e20" :question/math-academy-id "q-117221" :question/problem "Which of the following values is in the range of $y=\\operatorname{arccos}⁡x?$" :question/worked-solution "Let's recall the graph of $y=\\operatorname{arccos}⁡x.$\n\n![](images/9d/9dcc5a116c2a564547283783a7df7b1cd3a9ab3b76ac24dc2695c4cb367796d5.png)\n\nNote that:\n\n- The range of the function is $[0,\\pi ].$\n\nTherefore, of the given values, only $2$ is in the range of the function."}] [{:db/id #edb/ref 17592186386862 :knowledge-point/_questions [{:db/id #edb/ref 17592186110585 :knowledge-point/id #uuid "46e1513d-0944-5c09-8a7e-e1d9ae81bae5" :knowledge-point/title "Graphing the Inverse Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "096a914e-ca68-5949-a34e-4616044de5bb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d7/d7984b9098d02bfc2b1e9a422aef919533abce54fbb94117e709c7613b0870a3.png" :db/id #edb/ref 17592186386864} {:answer/id #uuid "f1e55806-d3c8-548e-80c6-b1e30766315a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/39/395d29ade9c150fc9f6eb4674bfb650004c3379524c321851cc4d2dd32bf7bc1.png" :db/id #edb/ref 17592186386865} {:answer/id #uuid "6e736289-c884-532d-8c00-be2ea9bbb9f9" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/03/0328f3c8c1866f2103857cd9769a01a0d5cd7ec24b7a3585a394f6e9590dd107.png" :db/id #edb/ref 17592186386866} {:answer/id #uuid "2f8a703e-82ef-5233-a9c5-a0fdd0b287fd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f8/f850e9468f4ea2e02625ff0d729a9222e8744e5b5fc8e38621b9465255bb2266.png" :db/id #edb/ref 17592186386867} {:answer/id #uuid "bed70265-c376-5aeb-8052-6193b067a494" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/4b/4bef0bf8fd764126db5583ac90ea96fb02db567f2f75c4fa787440ab94adf901.png" :db/id #edb/ref 17592186386868}] :answer-field/correct {:answer/id #uuid "096a914e-ca68-5949-a34e-4616044de5bb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d7/d7984b9098d02bfc2b1e9a422aef919533abce54fbb94117e709c7613b0870a3.png" :db/id #edb/ref 17592186386864} :answer-field/id #uuid "70ec79cf-e993-5024-9997-bd354c43672a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386863}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "869b4f2f-e699-55cc-9df6-f84ca27a773c" :question/math-academy-id "q-117265" :question/problem "What is the graph of $y=\\operatorname{arctan}⁡x?$" :question/worked-solution "Let's recall some of the basic properties of $y=\\operatorname{arctan}⁡x:$\n\n- The domain is all real numbers.\n\n- There is a zero at $x=0.$\n\n- The function is negative over $(-\\infty ,0)$ and positive over $(0,\\infty ).$\n\n- The function is strictly increasing in its entire domain.\n\n- $y\\to -\\frac{\\pi }{2}$ (from above) as $x\\to -\\infty .$\n\n- $y\\to \\frac{\\pi }{2}$ (from below) as $x\\to \\infty .$\n\n- The lines $y=\\pm \\frac{\\pi }{2}$ are horizontal asymptotes of the function.\n\nOf the given functions, the only one that has all of these properties is as follows:\n\n![](images/d7/d7984b9098d02bfc2b1e9a422aef919533abce54fbb94117e709c7613b0870a3.png)"}] [{:db/id #edb/ref 17592186399954 :knowledge-point/_questions [{:db/id #edb/ref 17592186110587 :knowledge-point/id #uuid "5b834b64-9679-56c2-b5e9-ee26a54b5e13" :knowledge-point/title "Identifying Values in the Domain of the Inverse Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14166b42-bca6-56b8-a07e-797022314072" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186399956} {:answer/id #uuid "2da35c27-dccd-5d0a-8f1d-bbcd8c3eaa3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186399957} {:answer/id #uuid "ac90911c-f7a1-5220-a212-3c6d63800029" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186399958} {:answer/id #uuid "39c54159-c7fd-51f6-9853-fcc01f522381" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186399959} {:answer/id #uuid "9ca824dd-135f-51ed-b6ac-7c3e15e12daf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186399960}] :answer-field/correct {:answer/id #uuid "14166b42-bca6-56b8-a07e-797022314072" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186399956} :answer-field/id #uuid "3edbdcf6-2d84-595e-a82e-d4a8c761ebf2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399955}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fb40c498-010d-593d-917c-a780159dec3f" :question/math-academy-id "q-117329" :question/problem "Which of the following values lies in the domain of $y=\\operatorname{arctan}⁡x?$\n\nI. $-10\\,000$\nII. $\\frac{1}{16}$\nIII. $\\frac{\\sqrt{\\pi }}{6}$" :question/worked-solution "Let's recall the graph of $y=\\operatorname{arctan}⁡x.$\n\n![](images/d7/d7984b9098d02bfc2b1e9a422aef919533abce54fbb94117e709c7613b0870a3.png)\n\nNote that:\n\n- The function is defined for all real numbers.\n\nTherefore, all the given values are in the domain of $y=\\operatorname{arctan}⁡x.$"}] [{:db/id #edb/ref 17592186253330 :knowledge-point/_questions [{:db/id #edb/ref 17592186110586 :knowledge-point/id #uuid "1587e39e-c7bf-5385-b726-a1b497f7c772" :knowledge-point/title "Identifying Values in the Range of the Inverse Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2217da09-6925-529f-a47e-fd42bf90ef04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{6}" :db/id #edb/ref 17592186250844} {:answer/id #uuid "45ac8701-cd2f-526f-9ebd-a915c88cd734" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186251130} {:answer/id #uuid "8d540679-4d39-51d3-a6dc-4648abcea14f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186251748} {:answer/id #uuid "b2b80351-56c5-523b-aca4-c1c6f8888cdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{3}" :db/id #edb/ref 17592186252116} {:answer/id #uuid "fd6871dc-a56c-5f61-876e-28ff32cdd63a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3\\pi }{4}" :db/id #edb/ref 17592186252775}] :answer-field/correct {:answer/id #uuid "b2b80351-56c5-523b-aca4-c1c6f8888cdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{3}" :db/id #edb/ref 17592186252116} :answer-field/id #uuid "01e9f462-0c94-5801-b600-a9497a75e105" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252810}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8386e6c5-c0be-5d00-a9a0-00a17c58167d" :question/math-academy-id "q-117334" :question/problem "Which of the following values is in the range of $y=\\operatorname{arctan}⁡x?$" :question/worked-solution "Let's recall the graph of $y=\\operatorname{arctan}⁡x.$\n\n![](images/d7/d7984b9098d02bfc2b1e9a422aef919533abce54fbb94117e709c7613b0870a3.png)\n\nNote that:\n\n- The range of the function is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}).$\n\nTherefore, of the given values, only $y=-\\frac{\\pi }{3}$ is in the range of the function."}] [{:db/id #edb/ref 17592186399961 :knowledge-point/_questions [{:db/id #edb/ref 17592186105871 :knowledge-point/id #uuid "6445834c-7788-5427-a72c-30b06cc8e6ab" :knowledge-point/title "Calculating the Area of an Isosceles Right Triangle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e208d2b-dec6-562a-a378-e1098ccc8637" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "113" :db/id #edb/ref 17592186399963} {:answer/id #uuid "95086ebb-7581-57b3-a760-1b80ee3581dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186399964} {:answer/id #uuid "d51ba212-184c-5759-8461-dffee9f36c0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "72.5" :db/id #edb/ref 17592186399965} {:answer/id #uuid "6365eea9-1bba-56eb-bc53-b9734f86d4ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "84.5" :db/id #edb/ref 17592186399966} {:answer/id #uuid "d5f4da11-8df3-5c32-9ef0-645590937087" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "169" :db/id #edb/ref 17592186399967}] :answer-field/correct {:answer/id #uuid "6365eea9-1bba-56eb-bc53-b9734f86d4ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "84.5" :db/id #edb/ref 17592186399966} :answer-field/id #uuid "564afc56-93e1-5116-bc1b-3a39fadf5bbd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399962}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3b82680f-f801-5d98-98f5-3b30c67dd0ca" :question/math-academy-id "q-117347" :question/problem "![](images/4a/4aa952124ddaaa1dc2a54ebb4601255ae42346a9e02f02391c05453a81542505.png)\n\nWhat is the area of the right triangle $ABC$ shown above?" :question/worked-solution "Since $m∠A=m∠C={45}^{∘}$ and $AB=BC,$ we have an isosceles right triangle. \n\n![](images/67/670afdec3633984b2fb493706e762740062348ccbdd0f56df14e3add3d4bbd23.png)\n\nTherefore, the area of the triangle is\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}AB\\cdot BC \\\\  & =\\frac{1}{2}\\cdot {13}^{2} \\\\  & =\\frac{1}{2}\\cdot 169 \\\\  & =84.5\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253334 :knowledge-point/_questions [{:db/id #edb/ref 17592186096612 :knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3232bdcf-d781-5e59-bb5b-56c10f0d7fa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10{x}^{2}+6x" :db/id #edb/ref 17592186250976} {:answer/id #uuid "37865371-b061-54aa-9810-81e59d0b835b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}-10{x}^{2}+6x-19" :db/id #edb/ref 17592186251009} {:answer/id #uuid "3d09661f-ce26-5e19-a8b8-2ae50263662e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10x+6" :db/id #edb/ref 17592186251060 :task-item/_responses [{:db/id #edb/ref 17592186409262}]} {:answer/id #uuid "9007950f-ce55-5f0c-a1f6-d3963f0294f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}-10x+6" :db/id #edb/ref 17592186251775} {:answer/id #uuid "bbf32e0c-8341-5060-b67e-c44870ab4cd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10{x}^{2}+6x-19" :db/id #edb/ref 17592186252214}] :answer-field/correct {:answer/id #uuid "3d09661f-ce26-5e19-a8b8-2ae50263662e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10x+6" :db/id #edb/ref 17592186251060} :answer-field/id #uuid "e849ca6e-9bda-5244-a669-0f22826facaa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253210}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "50678a5c-afcb-522f-98fb-80e9680afca6" :question/math-academy-id "q-11735" :question/problem "Given that $f(x)={6}^{x}-5{x}^{2}+6x-19$, find ${f}^{′}(x).$" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({6}^{x}-5{x}^{2}+6x-19) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})-\\frac{\\text{d}}{\\text{d}x}(5{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(6x)-\\frac{\\text{d}}{\\text{d}x}(19) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})-5\\frac{\\text{d}}{\\text{d}x}({x}^{2})+6\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(19) \\\\  & =ln⁡6\\cdot {6}^{x}-5(2x)+6(1)-0 \\\\  & ={6}^{x}ln⁡6-10x+6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386869 :knowledge-point/_questions [{:db/id #edb/ref 17592186105872 :knowledge-point/id #uuid "a7656d23-06c9-5d22-b62a-3636bca66ab6" :knowledge-point/title "Finding the Base or the Height of a Triangle Given Its Area"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85c1f01f-96af-5f7c-96aa-279c3ec7396b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11\\,\\text{m}" :db/id #edb/ref 17592186386871} {:answer/id #uuid "2997f072-b449-5713-9807-6a5f2600c14b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\,\\text{m}" :db/id #edb/ref 17592186386872} {:answer/id #uuid "8fb6c5c4-f4a0-508f-836c-123e77528fc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\text{m}" :db/id #edb/ref 17592186386873} {:answer/id #uuid "1fee1997-ce6c-5947-a48e-604fe553cb79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,\\text{m}" :db/id #edb/ref 17592186386874} {:answer/id #uuid "f0514960-ea4a-54b8-90e9-aaff6e94282c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16\\,\\text{m}" :db/id #edb/ref 17592186386875}] :answer-field/correct {:answer/id #uuid "8fb6c5c4-f4a0-508f-836c-123e77528fc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\text{m}" :db/id #edb/ref 17592186386873} :answer-field/id #uuid "a7d95cca-e9e0-5148-9e42-b90b4a803ca8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386870}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4303d1bd-0440-58eb-a5d5-e6551f7a6e46" :question/math-academy-id "q-117356" :question/problem "![](images/10/10b6f63df56c789d0d28cd14caad0a2588e247ba4a60239f4cb0dd5a32777daf.png)\n\nFind $AM$ given that the area of $△ABC$ is $64\\,{m}^{2},$ $MC=11\\,m,$ and $BM=8\\,m.$}\n\n(Figure not drawn to scale)" :question/worked-solution "The area of the triangle is defined as \n\n$$\nA=\\frac{b\\cdot h}{2},\n$$\n\n where $b$ is a base and $h$ is the corresponding height.\n\nFrom the diagram, we see that the base is $b=AC,$ and the corresponding height is \n\n$$\nh=BM=8\\,m.\n$$\n\nTherefore, using the formula for the area, we can solve for the base as follows:\n\n$$\n\\begin{aligned}A & =\\frac{b\\cdot h}{2} \\\\ 64 & =\\frac{b\\cdot 8}{2} \\\\ 128 & =b\\cdot 8 \\\\ b & =\\frac{128}{8} \\\\ b & =16\\,m\\end{aligned}\n$$\n\nAs a result, $AC=16\\,m$ and hence, we have\n\n$$\nAM=AC-MC=16-11=5\\,\\text{m}.\n$$"}] [{:db/id #edb/ref 17592186399968 :knowledge-point/_questions [{:db/id #edb/ref 17592186110588 :knowledge-point/id #uuid "7f045b43-4785-5989-8b5a-dcb8401d1bb3" :knowledge-point/title "Determining Points that Lie on the Graph of the Inverse Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa719b7d-d1ee-5649-b870-8f8a3d1177c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186399970} {:answer/id #uuid "18dee54a-fce8-5dc3-a798-772a50cd8901" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186399971} {:answer/id #uuid "730c0a62-4f76-5705-9e0b-4a00253a74f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186399972} {:answer/id #uuid "11d81d17-4b55-5d20-91dc-2a09540e3557" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186399973} {:answer/id #uuid "5bafb7b5-e251-5b4a-b330-592196d2fd1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186399974}] :answer-field/correct {:answer/id #uuid "5bafb7b5-e251-5b4a-b330-592196d2fd1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186399974} :answer-field/id #uuid "f2f8be92-1eeb-51f2-9522-8aecb4bbebb3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399969}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d42d29a1-7ec6-555e-8ef7-3216eb563375" :question/math-academy-id "q-117369" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arctan}⁡x?$\n\nI. $(-1,-\\frac{\\pi }{4})$\nII. $(\\sqrt{3},\\frac{\\pi }{3})$\nIII. $(\\frac{\\pi }{4},1)$" :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arctan}⁡x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{tan}⁡x.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arctan}⁡x,$ which is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}).$\n\nWith this in mind, let's check each of the points. \n\n- First,  we consider the point $(-1,-\\frac{\\pi }{4}).$ We note the following:\n\n- The point $(-\\frac{\\pi }{4},-1)$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=-\\frac{\\pi }{4}$ lies within this range. $\\,✓$\n\nTherefore, the point $(-1,-\\frac{\\pi }{4})$ lies on the graph of $y=\\operatorname{arctan}⁡x.$\n\n- Next, we consider the point $(\\sqrt{3},\\frac{\\pi }{3}).$ We note the following:\n\n- The point $(\\frac{\\pi }{3},\\sqrt{3})$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=\\frac{\\pi }{3}$ lies within this range. $\\,✓$\n\nTherefore, the point $(\\sqrt{3},\\frac{\\pi }{3})$ lies on the graph of $y=\\operatorname{arctan}⁡x.$\n\n- Finally, we consider the point $(\\frac{\\pi }{4},1).$ We note the following:\n\n- The point $(1,\\frac{\\pi }{4})$ does **not** lie on the graph of $y=\\operatorname{tan}⁡x.$  $\\,\\times $\n\nTherefore, the point $(\\frac{\\pi }{4},1)$ does **not** lie on the graph of $y=\\operatorname{arctan}⁡x.$"}] [{:db/id #edb/ref 17592186253352 :knowledge-point/_questions [{:db/id #edb/ref 17592186059811 :knowledge-point/id #uuid "3878b5fa-fd5e-5984-8516-96ee17bf137b" :knowledge-point/title "Evaluating Arctangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "091dfe6d-dbcd-5dc8-908f-031833bf5679" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{3}" :db/id #edb/ref 17592186250636} {:answer/id #uuid "37d5087b-6859-5f3e-8798-9a0961309a86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{3}" :db/id #edb/ref 17592186251014} {:answer/id #uuid "690726ad-749f-5890-8274-26648cc3d209" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\pi " :db/id #edb/ref 17592186251420} {:answer/id #uuid "b1e69f0d-76ca-5918-8497-cea75026a9d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186252108} {:answer/id #uuid "b5c9e48f-2c4b-51db-b2d5-abde59af8121" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186252151}] :answer-field/correct {:answer/id #uuid "37d5087b-6859-5f3e-8798-9a0961309a86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{3}" :db/id #edb/ref 17592186251014} :answer-field/id #uuid "938dd839-cb93-5473-921d-1230977f6699" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253061}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "faf88325-d673-5e64-a0a2-e5898606cfcf" :question/math-academy-id "q-117461" :question/problem "$-2\\operatorname{arctan}⁡(-\\sqrt{3})=$" :question/worked-solution "First, note that the range of $\\theta =\\operatorname{arctan}⁡x$ is given by\n\n$$\n-\\frac{\\pi }{2}<\\theta <\\frac{\\pi }{2}.\n$$\n\nNote that the angle $\\theta $ spans the first and fourth quadrants.\n\nSince $-\\sqrt{3}$ is negative, our answer is an angle that lies in the fourth quadrant, where the tangent is negative.\n\nFrom the special values of the trigonometric functions and the oddness of the tangent function, we know that \n\n$$\n\\operatorname{tan}⁡(-\\frac{\\pi }{3})=-\\operatorname{tan}⁡(\\frac{\\pi }{3})=-\\sqrt{3}.\n$$\n\nSince $-\\frac{\\pi }{3}$ is an angle in the fourth quadrant that lies within the range of $arctan,$ we conclude that\n\n$$\n\\operatorname{arctan}⁡(-\\sqrt{3})=-\\frac{\\pi }{3}.\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}-2\\operatorname{arctan}⁡(-\\sqrt{3}) & =(-2)\\cdot (-\\frac{\\pi }{3}) \\\\  & =\\frac{2\\pi }{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253353 :knowledge-point/_questions [{:db/id #edb/ref 17592186059811 :knowledge-point/id #uuid "3878b5fa-fd5e-5984-8516-96ee17bf137b" :knowledge-point/title "Evaluating Arctangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37ecc819-acb1-5df5-9748-8605bfca9317" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\pi " :db/id #edb/ref 17592186251015} {:answer/id #uuid "68a0f002-cae4-5c37-8a69-4b724f88ce62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2\\pi }{3}" :db/id #edb/ref 17592186251413} {:answer/id #uuid "81c81ed5-e80c-5c65-a8b3-082014a382f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{2}" :db/id #edb/ref 17592186251648} {:answer/id #uuid "990be92e-936a-5c07-9036-ee48d86256d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\pi " :db/id #edb/ref 17592186251868} {:answer/id #uuid "ce85ac4a-bc9b-5c3a-8299-d9d1ea40fe39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4\\pi }{3}" :db/id #edb/ref 17592186252379}] :answer-field/correct {:answer/id #uuid "68a0f002-cae4-5c37-8a69-4b724f88ce62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2\\pi }{3}" :db/id #edb/ref 17592186251413} :answer-field/id #uuid "ac16ee52-49d1-5b8b-9170-ffd9df8262f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253104}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "24e984a2-585a-5608-b3a2-5f94b69b88d9" :question/math-academy-id "q-117462" :question/problem "$4\\operatorname{arctan}⁡(-\\frac{1}{\\sqrt{3}})=$" :question/worked-solution "The range of $\\theta =\\operatorname{arctan}⁡x$ is given by\n\n$$\n-\\frac{\\pi }{2}<\\theta <\\frac{\\pi }{2}.\n$$\n\nNote that the angle $\\theta $ spans the first and fourth quadrants.\n\nSince $-\\frac{1}{\\sqrt{3}}$ is negative, our answer is an angle that lies in the fourth quadrant, where the tangent is negative.\n\nFrom the special values of the trigonometric functions and the oddness of the tangent function, we know that \n\n$$\n\\operatorname{tan}⁡(-\\frac{\\pi }{6})=-\\operatorname{tan}⁡(\\frac{\\pi }{6})=-\\frac{1}{\\sqrt{3}}.\n$$\n\nSince $-\\frac{\\pi }{6}$ is an angle in the fourth quadrant that lies within the range of $arctan,$ we conclude that\n\n$$\n\\operatorname{arctan}⁡(-\\frac{1}{\\sqrt{3}})=-\\frac{\\pi }{6}.\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}4\\operatorname{arctan}⁡(-\\frac{1}{\\sqrt{3}}) & =4\\cdot (-\\frac{\\pi }{6}) \\\\  & =-\\frac{2\\pi }{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253359 :knowledge-point/_questions [{:db/id #edb/ref 17592186096703 :knowledge-point/id #uuid "17099881-d7b9-54d9-a29a-4f5f28561cd3" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola with Vertex at the Origin Given Another Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9083a1ff-c8ef-5afc-828e-a8cec3a76262" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-4x" :db/id #edb/ref 17592186251782} {:answer/id #uuid "c1ed0205-2219-53c5-93db-3e51870d2e3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-8x" :db/id #edb/ref 17592186252263} {:answer/id #uuid "d036e7d8-bfd8-564c-9d05-2f00cd59df97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=6x" :db/id #edb/ref 17592186252392} {:answer/id #uuid "e6a241de-2088-5ff5-b151-6babb797b063" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=8x" :db/id #edb/ref 17592186252572} {:answer/id #uuid "f5a4b633-74e0-5ab4-bef8-b8ea2b20ff28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-6x" :db/id #edb/ref 17592186252703}] :answer-field/correct {:answer/id #uuid "c1ed0205-2219-53c5-93db-3e51870d2e3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-8x" :db/id #edb/ref 17592186252263} :answer-field/id #uuid "230f8ef2-ddf5-5d6c-b9d9-e998a0e4bf9e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252868}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ecb5a0f2-ba13-55c2-8466-28d0f08c1c9a" :question/math-academy-id "q-11751" :question/problem "Find the equation of the left-opening parabola that has its vertex at $(0,0)$ and passes through the point $(-8,8).$" :question/worked-solution "The general standard equation of a parabola whose vertex is $(0,0)$ and whose arms open right or left is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSince we know the given parabola passes through the point $(-8,8),$ we can substitute $x=-8$ and $y=8$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {8}^{2} & =4p(-8) \\\\ 64 & =-32p \\\\ p & =-2.\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {y}^{2} & =4(-2)x \\\\ {y}^{2} & =-8x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186096995 :knowledge-point/_questions [{:db/id #edb/ref 17592186096702 :knowledge-point/id #uuid "75fd35db-6b4e-5820-b6ac-925d24a0f117" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola with Vertex at the Origin Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "059aa299-ef4d-5d9e-89fb-eb28384533c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=\\frac{8}{3}x" :db/id #edb/ref 17592186250597} {:answer/id #uuid "583d81d4-b1f4-5ad9-9cd3-2232b14d4025" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=2x" :db/id #edb/ref 17592186251275} {:answer/id #uuid "8117bad0-2535-5fe3-966b-bf698bce7f0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=4x" :db/id #edb/ref 17592186251641} {:answer/id #uuid "bad0d7d9-889c-5b4c-8599-b8db9ed11b35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=\\frac{16}{3}x" :db/id #edb/ref 17592186252197} {:answer/id #uuid "c8f07a14-50c2-5b49-92c1-066157f2308e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=\\frac{4}{3}x" :db/id #edb/ref 17592186252330}] :answer-field/correct {:answer/id #uuid "c8f07a14-50c2-5b49-92c1-066157f2308e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=\\frac{4}{3}x" :db/id #edb/ref 17592186252330} :answer-field/id #uuid "46732a7b-c2df-54b6-985e-3918b0cefa7a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252927}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e658f76e-d8f1-5fc3-aee3-15b3559d9455" :question/math-academy-id "q-11754" :question/problem "![](images/01/0119821efe6d06a4d43278f09ab7ba4b471a59ffca94d1fe5d3bf67fd71c44a0.png)\n\nWhat is the equation of the parabola shown above?" :question/worked-solution "From the diagram we see that the arms of the parabola open to the right. The parabola has its vertex at $(0,0)$ and passes through the point $(12,4).$\n\nThe general standard equation of a parabola whose vertex is $(0,0)$ and whose arms open right or left is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSince we know the given parabola passes through the point $(12,4),$ we can substitute $x=12$ and $y=4$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {4}^{2} & =4p(12) \\\\ 16 & =48p \\\\ p & =\\frac{1}{3}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {y}^{2} & =4(\\frac{1}{3})x \\\\ {y}^{2} & =\\frac{4}{3}x.\\end{aligned}\n$$\n\nNotice that the arms of the parabola open to the right since $p=\\frac{1}{3}$ is positive."}] [{:db/id #edb/ref 17592186253363 :knowledge-point/_questions [{:db/id #edb/ref 17592186096702 :knowledge-point/id #uuid "75fd35db-6b4e-5820-b6ac-925d24a0f117" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola with Vertex at the Origin Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "133fede6-e6b3-5934-9ab6-600b897e76c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-2x" :db/id #edb/ref 17592186250719} {:answer/id #uuid "7bb9ca10-8ea3-5cda-814e-af155fd838bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-x" :db/id #edb/ref 17592186251583} {:answer/id #uuid "c8c06d53-55cc-51d9-bc54-73807258d08f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=x" :db/id #edb/ref 17592186252328} {:answer/id #uuid "d7c2b286-9473-5923-a0df-50419f5281e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-3x" :db/id #edb/ref 17592186252465} {:answer/id #uuid "ef673879-992e-531a-9cc6-362a14d4f889" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=2x" :db/id #edb/ref 17592186252648}] :answer-field/correct {:answer/id #uuid "7bb9ca10-8ea3-5cda-814e-af155fd838bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-x" :db/id #edb/ref 17592186251583} :answer-field/id #uuid "8f1d9cb5-e489-5d90-befc-482609c96a6c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253053}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5b52b18c-f18d-51d2-9931-b8f3ebe75944" :question/math-academy-id "q-11756" :question/problem "![](images/58/58c92cc542f027ec882191d2b4631f9fcf3704820b2825a18f30dbdc3f59d07b.png)\n\nWhat is the equation of the parabola shown above?" :question/worked-solution "From the diagram we see that the arms of the parabola open to the left. The parabola has its vertex at $(0,0)$ and passes through the point $(-4,2).$\n\nThe general standard equation of a parabola whose vertex is $(0,0)$ and whose arms open right or left is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSince we know the given parabola passes through the point $(-4,2),$ we can substitute $x=-4$ and $y=2$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {2}^{2} & =4p(-4) \\\\ 4 & =-16p \\\\ p & =-\\frac{1}{4}.\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {y}^{2} & =4(-\\frac{1}{4})x \\\\ {y}^{2} & =-x.\\end{aligned}\n$$\n\nNotice that the arms of the parabola open to the left since $p=-\\frac{1}{4}$ is negative."}] [{:db/id #edb/ref 17592186253366 :knowledge-point/_questions [{:db/id #edb/ref 17592186129121 :knowledge-point/id #uuid "7f8fa2b3-ccaa-5390-89fa-03e338cf8690" :knowledge-point/title "Determining the Amplitude of a Transformed Sinusoidal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42d9acc7-d7bc-5ee0-a5fe-5e4dd49f1b24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186251112} {:answer/id #uuid "62a72008-6a6e-556c-809d-015ca2b2740f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186251358} {:answer/id #uuid "d1881db5-b1bc-59b9-9956-32e11311533c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186252402} {:answer/id #uuid "f784db78-b2a6-5828-92f9-43c51bb6371d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186252716} {:answer/id #uuid "fdfe367d-16eb-5c43-87a8-b57680a82f9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186252780}] :answer-field/correct {:answer/id #uuid "f784db78-b2a6-5828-92f9-43c51bb6371d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186252716} :answer-field/id #uuid "e24beebb-313f-5175-ae17-e942cb6940f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253192}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1489edd6-f3f4-5ab1-9410-746b5fd6547f" :question/math-academy-id "q-117570" :question/problem "What is the amplitude of the function $f(x)=4\\operatorname{cos}⁡(2x+3)?$" :question/worked-solution "Given a function in the form $f(x)=A\\operatorname{cos}⁡(Bx+C)+D,$ the amplitude is $|A|.$\n\nSince $A=4,$ we have that the amplitude is $|A|=|4|=4.$"}] [{:db/id #edb/ref 17592186253369 :knowledge-point/_questions [{:db/id #edb/ref 17592186129122 :knowledge-point/id #uuid "1eeb42af-74ee-53d7-af9f-be171f77968f" :knowledge-point/title "Calculating the Period of a Transformed Sinusoidal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4161544d-5503-509c-a919-47b75546d693" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{2}" :db/id #edb/ref 17592186251094} {:answer/id #uuid "ab0b8f2d-8bf9-5548-96dd-fe899f5d298f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\pi }{3}" :db/id #edb/ref 17592186252036} {:answer/id #uuid "ba23df8f-a679-5d5c-bde8-2b7238d24224" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186252191} {:answer/id #uuid "c9834705-9dcd-5c24-afb6-f095959807d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8\\pi }{3}" :db/id #edb/ref 17592186252335} {:answer/id #uuid "f25fe0b5-3a2d-5c1e-b5a3-425fbf7a30c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186252674}] :answer-field/correct {:answer/id #uuid "c9834705-9dcd-5c24-afb6-f095959807d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8\\pi }{3}" :db/id #edb/ref 17592186252335} :answer-field/id #uuid "918ffa31-2155-56a2-9928-59d9d880148e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253057}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "53685d44-d788-5019-bc63-97c441bd2453" :question/math-academy-id "q-117578" :question/problem "What is the period of the function $f(x)=-3\\operatorname{sin}⁡(\\frac{3x}{4}+\\frac{\\pi }{3})?$" :question/worked-solution "Given a function in the form $y=A\\operatorname{sin}⁡(Bx+C)+D,$ the period is $\\frac{2\\pi }{B}.$\n\nIn our case, we have that $B=\\frac{3}{4}.$ Therefore, the period is $\\frac{2\\pi }{(\\frac{3}{4})}=\\frac{8\\pi }{3}.$"}] [{:db/id #edb/ref 17592186253372 :knowledge-point/_questions [{:db/id #edb/ref 17592186203961 :knowledge-point/id #uuid "58c7cd44-30a9-5f61-822c-13640ad41c93" :knowledge-point/title "Finding the Zeros of a Transformed Sine or Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d740ebb-367e-5b13-abb3-4aaa7aaffcc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{6}+\\frac{n\\pi }{2}" :db/id #edb/ref 17592186251327} {:answer/id #uuid "76a2175d-f7a4-5539-8d5c-3821bd16c125" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{12}+\\frac{n\\pi }{6}" :db/id #edb/ref 17592186251531} {:answer/id #uuid "a02621c3-5f65-5847-b218-aabe23216fce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{6}+\\frac{n\\pi }{3}" :db/id #edb/ref 17592186251935} {:answer/id #uuid "cce190ce-0319-5382-a9e1-b39ca5b6c857" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{12}+\\frac{n\\pi }{3}" :db/id #edb/ref 17592186252359} {:answer/id #uuid "e26fda5d-8dbd-578f-ba57-15366c54f032" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{12}+\\frac{n\\pi }{4}" :db/id #edb/ref 17592186252543}] :answer-field/correct {:answer/id #uuid "cce190ce-0319-5382-a9e1-b39ca5b6c857" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{12}+\\frac{n\\pi }{3}" :db/id #edb/ref 17592186252359} :answer-field/id #uuid "b25237fb-1e27-5e8c-8801-00721dc99e4b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253115}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e6c40bb9-f96b-5776-9878-956cda7f4ab8" :question/math-academy-id "q-117602" :question/problem "Which expression gives all of the zeros of $y=\\operatorname{sin}⁡(3x-\\frac{\\pi }{4})?$  Assume that $n$ is an integer." :question/worked-solution "First, let's start by defining a new variable $X$ as\n\n$$\nX=3x-\\frac{\\pi }{4}.\n$$\n\nSo, we need to calculate the zeros of \n\n$$\ny=\\operatorname{sin}⁡X.\n$$\n\nThe zeros of this function are given by the following expression:\n\n$$\nX=n\\pi \n$$\n\nwhere $n$ is an integer.\n\nTo find the zeros of our original function, we rewrite $X$ in terms of the original variable $x$ and solve the resulting equation for $x:$\n\n$$\n\\begin{aligned}X & =n\\pi  \\\\ 3x-\\frac{\\pi }{4} & =n\\pi  \\\\ 3x & =\\frac{\\pi }{4}+n\\pi  \\\\ x & =\\frac{\\pi }{12}+\\frac{n\\pi }{3}\\end{aligned}\n$$\n\nTherefore, we conclude that the zeros are $x=\\frac{\\pi }{12}+\\frac{n\\pi }{3},$ where $n$ is any integer."}] [{:db/id #edb/ref 17592186253374 :knowledge-point/_questions [{:db/id #edb/ref 17592186203963 :knowledge-point/id #uuid "75e981a4-ba75-5db2-81ab-b321953cc225" :knowledge-point/title "Minima of Transformed Sine or Cosine Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a6315d9-4c5b-52e3-98df-900d3c444852" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{10}+\\frac{n\\pi }{5}" :db/id #edb/ref 17592186250644} {:answer/id #uuid "50caab44-146e-5114-bb63-a98abf44bbf0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{5}+\\frac{n\\pi }{5}" :db/id #edb/ref 17592186251216} {:answer/id #uuid "7d8a89f1-cd1e-5d53-97df-4d4822adf932" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\pi }{5}+\\frac{2n\\pi }{5}" :db/id #edb/ref 17592186251602} {:answer/id #uuid "8cef8dea-f51e-5b0b-821f-4305afcb5ffc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{2\\pi }{5}+\\frac{2n\\pi }{5}" :db/id #edb/ref 17592186251744} {:answer/id #uuid "a7938484-56c7-5ea3-8eac-d9b734d000ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\pi }{10}+2n\\pi " :db/id #edb/ref 17592186251997}] :answer-field/correct {:answer/id #uuid "7d8a89f1-cd1e-5d53-97df-4d4822adf932" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\pi }{5}+\\frac{2n\\pi }{5}" :db/id #edb/ref 17592186251602} :answer-field/id #uuid "f788a829-1171-5925-a3c0-50bd4a554edb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253243}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "21457735-cc06-5dc4-85da-719f77cfb1e9" :question/math-academy-id "q-117609" :question/problem "Consider the function $f(x)=3\\operatorname{sin}⁡(5x+\\frac{\\pi }{2}).$ Which expression gives all of the values of $x$ at which $f(x)$ attains its minimum value? Assume that $n$ is an integer." :question/worked-solution "First, let's start by defining a new variable $X$ as\n\n$$\nX=5x+\\frac{\\pi }{2}.\n$$\n\nSo, we need to calculate $X$-values at the minima of\n\n$$\nf(x)=3\\operatorname{sin}⁡X.\n$$\n\nThe $X$-values at the minima are given by the following expression:\n\n$$\nX=-\\frac{\\pi }{2}+2n\\pi \n$$\n\nwhere $n$ is an integer.\n\nTo find the $x$-values at the minima of our original function, we rewrite $X$ in terms of the original variable $x$ and solve the resulting equation for $x:$\n\n$$\n\\begin{aligned}X & =-\\frac{\\pi }{2}+2n\\pi  \\\\ 5x+\\frac{\\pi }{2} & =-\\frac{\\pi }{2}+2n\\pi  \\\\ 5x & =-\\pi +2n\\pi  \\\\ x & =-\\frac{\\pi }{5}+\\frac{2n\\pi }{5}\\end{aligned}\n$$\n\nWe conclude that the values of $x$ that minimize $f(x)$ are given by $x=-\\frac{\\pi }{5}+\\frac{2n\\pi }{5},$ where $n$ is any integer."}] [{:db/id #edb/ref 17592186253384 :knowledge-point/_questions [{:db/id #edb/ref 17592186129099 :knowledge-point/id #uuid "6506f7e3-4c69-5352-a09d-262adee65e59" :knowledge-point/title "Determining the Period of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a24ca73-da2f-5891-880a-ef75f6b9593c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186250779} {:answer/id #uuid "7150f51b-e3ac-5d81-a7f7-48ee5bc0bba5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\pi " :db/id #edb/ref 17592186251481} {:answer/id #uuid "78cfaed6-e561-54a3-bf1b-803861939fec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186251555} {:answer/id #uuid "8a4ab11c-2641-522c-977a-0adc46be731f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\pi " :db/id #edb/ref 17592186251718} {:answer/id #uuid "f94e9a48-ac9c-5839-8dce-557d1258a588" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186252735}] :answer-field/correct {:answer/id #uuid "1a24ca73-da2f-5891-880a-ef75f6b9593c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186250779} :answer-field/id #uuid "adab447b-5cdd-5271-ba5a-532032cbadc6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253107}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7daa9d90-3598-5b04-bfa2-8fabe3b59b76" :question/math-academy-id "q-117659" :question/problem "Calculate the period of the function $f(x)=\\operatorname{tan}⁡(3x)+6.$" :question/worked-solution "Given a function of the form $y=A\\operatorname{tan}⁡(Bx+C)+D,$ the period is $\\frac{\\pi }{B}.$\n\nIn our case, we have that $B=3.$ Therefore, the period is $\\frac{\\pi }{3}.$"}] [{:db/id #edb/ref 17592186253386 :knowledge-point/_questions [{:db/id #edb/ref 17592186129099 :knowledge-point/id #uuid "6506f7e3-4c69-5352-a09d-262adee65e59" :knowledge-point/title "Determining the Period of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2430686f-6354-5ae3-a56a-86797016a196" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186250867} {:answer/id #uuid "84c30401-b464-5d98-8a9b-267f533cca26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\pi " :db/id #edb/ref 17592186251667} {:answer/id #uuid "97869399-0a57-5928-b446-b55279c01911" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186251853} {:answer/id #uuid "a5606c09-671a-5dc4-abd2-15172f36984e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186251979} {:answer/id #uuid "ab67f75e-df9d-5d97-89f6-287ab3d2483f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{8}" :db/id #edb/ref 17592186252038}] :answer-field/correct {:answer/id #uuid "97869399-0a57-5928-b446-b55279c01911" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186251853} :answer-field/id #uuid "5f5b3662-7c4a-554a-a3fa-0abb3a6d9754" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252975}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dc8f3fd2-a7ad-59ae-81ee-947a33e17f52" :question/math-academy-id "q-117661" :question/problem "Calculate the period of the function $f(x)=-3\\operatorname{tan}⁡(\\frac{8x-\\pi }{4}).$" :question/worked-solution "Given a function of the form $y=A\\operatorname{tan}⁡(Bx+C)+D,$ the period is $\\frac{\\pi }{B}.$\n\nIn our case, we have that\n\n$$\nf(x)=-3\\operatorname{tan}⁡(\\frac{8x-\\pi }{4})=-3\\operatorname{tan}⁡(2x-\\frac{\\pi }{4}).\n$$\n\nTherefore, $B=2,$ and so the period is $\\frac{\\pi }{2}.$"}] [{:db/id #edb/ref 17592186253398 :knowledge-point/_questions [{:db/id #edb/ref 17592186129101 :knowledge-point/id #uuid "8854eaba-96c7-5ea8-a071-7ff7c954f943" :knowledge-point/title "Finding a General Expression for the Asymptotes of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "192cc94d-2bdc-5aa5-8395-3038aa3ee599" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{8}+\\frac{n\\pi }{8}" :db/id #edb/ref 17592186250773} {:answer/id #uuid "4831ea5f-e09b-527b-af85-515fffa0b3b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{16}+\\frac{n\\pi }{16}" :db/id #edb/ref 17592186251154} {:answer/id #uuid "5214d5d3-d621-543f-8d56-e6f7af5a61c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{4}+\\frac{n\\pi }{4}" :db/id #edb/ref 17592186251225} {:answer/id #uuid "65c18de8-50f1-510b-be3e-67e3e14593c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{16}+\\frac{n\\pi }{4}" :db/id #edb/ref 17592186251389} {:answer/id #uuid "9ee22af7-fed1-5570-8b02-e7f32f959eaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{4}+\\frac{n\\pi }{8}" :db/id #edb/ref 17592186251923}] :answer-field/correct {:answer/id #uuid "65c18de8-50f1-510b-be3e-67e3e14593c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{16}+\\frac{n\\pi }{4}" :db/id #edb/ref 17592186251389} :answer-field/id #uuid "9c602f0c-b42d-53d5-bc8e-aa3b17f2cc1f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253080}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1a30a0cb-a192-58f4-b341-cb115dd8b12f" :question/math-academy-id "q-117698" :question/problem "Which of the following expressions gives all of the vertical asymptotes of the function $f(x)=\\operatorname{tan}⁡(4x+\\frac{\\pi }{4})?$ Assume that $n$ is an integer." :question/worked-solution "The asymptotes of $y=\\operatorname{tan}⁡x$ are given by the expression\n\n$$\nx=\\frac{\\pi }{2}+n\\pi ,\n$$\n\nwhere $n$ is an integer.\n\nTo find the asymptotes of $\\operatorname{tan}⁡(4x+\\frac{\\pi }{4}),$ we replace the $x$ on the left-hand side of the above with $(4x+\\frac{\\pi }{4}).$ This gives\n\n$$\n4x+\\frac{\\pi }{4}=\\frac{\\pi }{2}+n\\pi .\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}4x+\\frac{\\pi }{4} & =\\frac{\\pi }{2}+n\\pi  \\\\ 4x & =\\frac{\\pi }{2}+n\\pi -\\frac{\\pi }{4} \\\\ 4x & =\\frac{\\pi }{4}+n\\pi  \\\\ x & =\\frac{\\pi }{16}+\\frac{n\\pi }{4}.\\end{aligned}\n$$\n\nTherefore, we conclude that the expression giving all the vertical asymptotes is $x=\\frac{\\pi }{16}+\\frac{n\\pi }{4},$ where $n$ is an integer."}] [{:db/id #edb/ref 17592186253410 :knowledge-point/_questions [{:db/id #edb/ref 17592186083152 :knowledge-point/id #uuid "0b19d6e0-8a12-525d-8c80-ac2de8080830" :knowledge-point/title "The Period of a Transformed Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2935cc2d-27c9-58b3-96a6-79c8386f3a29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186250904} {:answer/id #uuid "54137cf8-14cc-55d2-a3b0-586abb911a1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\pi " :db/id #edb/ref 17592186251241} {:answer/id #uuid "80c578dc-923e-50b4-8174-f24b0bd436b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186251638} {:answer/id #uuid "92a04e97-de9c-5fe7-b1bc-3c133f09c650" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\pi " :db/id #edb/ref 17592186251808} {:answer/id #uuid "a1ed5eb0-3633-589d-acca-01d3eccf8929" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{12}" :db/id #edb/ref 17592186251948}] :answer-field/correct {:answer/id #uuid "92a04e97-de9c-5fe7-b1bc-3c133f09c650" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\pi " :db/id #edb/ref 17592186251808} :answer-field/id #uuid "27623253-c44d-540a-b82d-ad67ac207865" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252877}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b44fb065-7fc5-53f5-aa2b-171c7b74a7ad" :question/math-academy-id "q-117752" :question/problem "Calculate the period of the function $y=-5\\operatorname{csc}⁡(\\frac{x}{6}-\\frac{\\pi }{4}).$" :question/worked-solution "Given a function of the form $y=A\\operatorname{csc}⁡(Bx+C)+D,$ the period is $\\frac{2\\pi }{B}.$\n\nIn our case, we have that $B=\\frac{1}{6}.$ Therefore, the period is $\\frac{2\\pi }{(\\frac{1}{6})}=12\\pi .$"}] [{:db/id #edb/ref 17592186253411 :knowledge-point/_questions [{:db/id #edb/ref 17592186096692 :knowledge-point/id #uuid "e9a34b79-65ff-5f7b-a8ee-5f19424fd9b4" :knowledge-point/title "Determining the Equation of a Parabola Given its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "018b900e-eac6-5ee8-98ca-c0981f9c358a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=\\frac{4}{3}y" :db/id #edb/ref 17592186250568} {:answer/id #uuid "36b69884-e0f8-5a35-a86f-6504c958fffb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=-\\frac{16}{3}y" :db/id #edb/ref 17592186251003} {:answer/id #uuid "6c61d383-b5d6-55e5-89aa-69e7219ae6e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=\\frac{8}{3}y" :db/id #edb/ref 17592186251442} {:answer/id #uuid "9c25fc1b-e751-5f4d-a4ea-2c79ebdd5611" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=-\\frac{8}{3}y" :db/id #edb/ref 17592186251901} {:answer/id #uuid "b600ef2d-7430-52c3-9a6b-33649cc4dade" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=-\\frac{4}{3}y" :db/id #edb/ref 17592186252153}] :answer-field/correct {:answer/id #uuid "b600ef2d-7430-52c3-9a6b-33649cc4dade" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=-\\frac{4}{3}y" :db/id #edb/ref 17592186252153} :answer-field/id #uuid "56c419e4-fed3-5638-9bd2-e528284bfe38" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252958}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4844153a-cf84-57ba-8cb5-907264c75fda" :question/math-academy-id "q-11779" :question/problem "![](images/b0/b09f63373bba1bb796f1832a4c7aa33ec220186e75bb84ccc79dcc46b662636e.png)\n\nWhat is the equation of the parabola shown above?" :question/worked-solution "From the diagram we see that the parabola is downward-opening has its vertex at $(0,0),$ and passes through the point $(4,-12).$\n\nFor any upward or downward-opening parabola whose vertex is $(0,0),$ the general standard equation is given by\n\n$$\n{x}^{2}=4py\n$$\n\nwhere $p$ is a constant.\n\nWe know that the given parabola passes through the point $(4,-12),$ so we can substitute $x=4$ and $y=-12$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ {4}^{2} & =4p(-12) \\\\ 16 & =-48p \\\\ p & =-\\frac{1}{3}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ {x}^{2} & =4(-\\frac{1}{3})y \\\\ {x}^{2} & =-\\frac{4}{3}y.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186398165 :knowledge-point/_questions [{:db/id #edb/ref 17592186184236 :knowledge-point/id #uuid "af228cc4-8be2-5c16-8537-4e5dab4e2ff4" :knowledge-point/title "Identifying the Horizontal Stretch and Vertical Shift of a Transformed Tangent Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34eca68d-7384-5ac4-aae3-9fd3ad9100c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186398167} {:answer/id #uuid "ebf81549-b73c-5aa8-ae6f-2eb529e3d650" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186398168} {:answer/id #uuid "4b365ba9-edc9-5d4f-9d0c-a4e1280cad8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186398169} {:answer/id #uuid "95065041-df6a-55e2-ba59-eb39e1ef3c42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186398170} {:answer/id #uuid "4041d9b8-a50e-5114-a489-9911977efeb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186398171}] :answer-field/correct {:answer/id #uuid "ebf81549-b73c-5aa8-ae6f-2eb529e3d650" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186398168} :answer-field/id #uuid "b20222d5-4d8b-5ef3-b5e6-cdd257fd9b17" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398166}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5ecbe368-922d-5a9f-956d-5a27886e10df" :question/math-academy-id "q-117796" :question/problem "![](images/92/9278723975d70fec73e313d0e164908ddd339231cb74f75b07c2edce14680111.png)\n\nThe graph above shows the function $y=\\operatorname{tan}⁡(Bx)+D,$ where $B$ and $D$ are constants. What is $B+D?$" :question/worked-solution "The period $T$ of the function is\n\n$$\nT=\\frac{2\\pi }{5}-(-\\frac{2\\pi }{5})=\\frac{4\\pi }{5}.\n$$\n\nThe formula for the period $T$ of the function $y=A\\operatorname{tan}⁡(Bx+C)+D$ is given by \n\n$$\nT=\\frac{\\pi }{B}.\n$$\n\nApplying the formula of the period, we get\n\n$$\n\\frac{4\\pi }{5}=\\frac{\\pi }{B}\\,⟹\\,B=\\frac{\\pi }{(\\frac{4\\pi }{5})}=\\frac{5}{4}.\n$$\n\nThe parameter $D$ represents the vertical shift of the tangent function. We see that the function has been translated by $\\frac{1}{2}$ unit up. Hence, $D=\\frac{1}{2}.$\n\nTherefore, $B+D=\\frac{5}{4}+\\frac{1}{2}=\\frac{7}{4}.$\n\nFinally, the equation of the curve is\n\n$$\ny=\\operatorname{tan}⁡(\\frac{5x}{4})+\\frac{1}{2}.\n$$"}] [{:db/id #edb/ref 17592186253417 :knowledge-point/_questions [{:db/id #edb/ref 17592186083155 :knowledge-point/id #uuid "5085a30f-a347-5ba8-80fd-102e4e0f37ce" :knowledge-point/title "Finding Local Extrema of a Transformed Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08ef0ad4-504c-5ff5-b6b1-d2d3e980875f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186250635} {:answer/id #uuid "298bec1a-ff16-5540-a476-6b3fca320aa8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186250908} {:answer/id #uuid "2dc5b675-6831-54be-906b-a9a1b71d2899" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186250944} {:answer/id #uuid "885e749a-e263-5b04-8671-ccd884576931" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186251703} {:answer/id #uuid "a365c952-0f98-5c32-87e5-0e635c62c1d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186251962}] :answer-field/correct {:answer/id #uuid "2dc5b675-6831-54be-906b-a9a1b71d2899" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186250944} :answer-field/id #uuid "94db1709-d36e-5a1b-b01a-c474544f7620" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253067}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "97fbbd90-72d5-5259-afd8-7a25639443c6" :question/math-academy-id "q-117805" :question/problem "What is the value of $f(x)=4\\operatorname{sec}⁡(x-\\frac{\\pi }{4})+1$ at its local maximum points?" :question/worked-solution "On a negative branch of the graph of $y=\\operatorname{sec}⁡x,$ we have\n\n$$\n\\operatorname{sec}⁡x\\le -1.\n$$\n\nThe points where $\\operatorname{sec}⁡x=-1$ are local maximums of the graph of $y=\\operatorname{sec}⁡x.$ \n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n\\operatorname{sec}⁡(x-\\frac{\\pi }{4})\\le -1.\n$$\n\nMultiplying the above inequality by $4$ and adding $1$, we get\n\n$$\n\\begin{aligned} & \\operatorname{sec}⁡(x-\\frac{\\pi }{4})\\le -1 \\\\  & 4\\operatorname{sec}⁡(x-\\frac{\\pi }{4})\\le -4 \\\\  & 4\\operatorname{sec}⁡(x-\\frac{\\pi }{4})+1\\le -4+1 \\\\  & f(x)\\le -3.\\end{aligned}\n$$\n\nTherefore, $f(x)=-3$ at the local maximum points."}] [{:db/id #edb/ref 17592186253420 :knowledge-point/_questions [{:db/id #edb/ref 17592186096692 :knowledge-point/id #uuid "e9a34b79-65ff-5f7b-a8ee-5f19424fd9b4" :knowledge-point/title "Determining the Equation of a Parabola Given its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d74283e-5ccb-5927-b7c2-7b6dc7348729" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=-\\frac{8}{3}y" :db/id #edb/ref 17592186250940} {:answer/id #uuid "49d88741-afb9-5f1a-89bc-fa72f184e234" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=\\frac{4}{3}y" :db/id #edb/ref 17592186251167} {:answer/id #uuid "53cc6df8-4837-502d-9577-0769a855428d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=\\frac{2}{3}y" :db/id #edb/ref 17592186251238} {:answer/id #uuid "d2e45b1d-95f4-5298-b7f6-badd3269cd0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=-\\frac{4}{3}y" :db/id #edb/ref 17592186252418} {:answer/id #uuid "dcaf0ab8-8236-5a51-9644-727fd4c758d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=\\frac{8}{3}y" :db/id #edb/ref 17592186252495}] :answer-field/correct {:answer/id #uuid "dcaf0ab8-8236-5a51-9644-727fd4c758d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=\\frac{8}{3}y" :db/id #edb/ref 17592186252495} :answer-field/id #uuid "bf9081df-efa4-55bb-b2fa-1ac432b3fbd4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253137}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "73e0be4b-b8c0-5d2c-baec-36cb996c3031" :question/math-academy-id "q-11781" :question/problem "![](images/e5/e588a9250583251ba2fd85b789eb3a856970fb6e7044289257a4ed97e3bbf1a0.png)\n\nWhat is the equation of the parabola shown above?" :question/worked-solution "From the diagram we see that the parabola is upward-opening, has its vertex at $(0,0),$ and passes through the point $(4,6).$\n\nFor any upward or downward-opening parabola whose vertex is $(0,0),$ the general standard equation is given by\n\n$$\n{x}^{2}=4py\n$$\n\nwhere $p$ is a constant.\n\nWe know that the given parabola passes through the point $(4,6),$ so we can substitute $x=4$ and $y=6$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ {4}^{2} & =4p(6) \\\\ 16 & =24p \\\\ p & =\\frac{2}{3}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ {x}^{2} & =4(\\frac{2}{3})y \\\\ {x}^{2} & =\\frac{8}{3}y.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253430 :knowledge-point/_questions [{:db/id #edb/ref 17592186096693 :knowledge-point/id #uuid "281514e9-6e16-5b21-ba4e-503991d811c2" :knowledge-point/title "Determining the Equation of a Parabola Passing Through a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29bfd946-372a-5444-a539-b716d9cbb951" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=5y" :db/id #edb/ref 17592186250911} {:answer/id #uuid "315d3443-669e-53c8-825c-4dd3c15813b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=y" :db/id #edb/ref 17592186250972} {:answer/id #uuid "7a6adb72-8b7c-5af0-8717-9d8ed3666c4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=-3y" :db/id #edb/ref 17592186251572} {:answer/id #uuid "96e517f3-26bc-5e99-8b69-bc21a87de470" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=-5y" :db/id #edb/ref 17592186251847} {:answer/id #uuid "97998a1b-9445-5245-b410-a419f925511e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=3y" :db/id #edb/ref 17592186251855}] :answer-field/correct {:answer/id #uuid "29bfd946-372a-5444-a539-b716d9cbb951" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=5y" :db/id #edb/ref 17592186250911} :answer-field/id #uuid "4d6c6253-24f7-571b-b3ec-a0a27c5878db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252942}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e0b80741-e06b-5c43-b887-c4210becc6d2" :question/math-academy-id "q-11792" :question/problem "Find the equation of the upward-opening parabola that has its vertex at $(0,0)$ and which passes through the point $(-5,5).$" :question/worked-solution "We know that for any upward or downward-opening parabola whose vertex is $(0,0),$ the general standard equation is given by\n\n$$\n{x}^{2}=4py\n$$\n\nwhere $p$ is a constant.\n\nWe're told that the given parabola passes through the point $(-5,5),$ so we can substitute $x=-5$ and $y=5$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ (-5)^{2} & =4p(5) \\\\ 25 & =20p \\\\ p & =\\frac{5}{4}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ {x}^{2} & =4(\\frac{5}{4})y \\\\ {x}^{2} & =5y.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253431 :knowledge-point/_questions [{:db/id #edb/ref 17592186096705 :knowledge-point/id #uuid "783ca59b-0242-584c-ae47-004a0eb03817" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola Given the Vertex and Another Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "067eb9b1-51de-5ef8-b70e-3b3e8cda0c87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-4)^{2}=4(x-1)" :db/id #edb/ref 17592186250606} {:answer/id #uuid "13e8d2d2-417b-57ab-9155-6e7000efdb81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-4)^{2}=-8(x-1)" :db/id #edb/ref 17592186250725} {:answer/id #uuid "33afd160-c8ab-5044-8b0b-8f8d3675e347" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-1)^{2}=-8(x-4)" :db/id #edb/ref 17592186250983} {:answer/id #uuid "abc58071-d220-590e-a965-1da2251fffb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-4)^{2}=-4(x-1)" :db/id #edb/ref 17592186252041} {:answer/id #uuid "b0209be0-b337-582a-a85e-98717e955cd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-4)^{2}=8(x-1)" :db/id #edb/ref 17592186252090}] :answer-field/correct {:answer/id #uuid "13e8d2d2-417b-57ab-9155-6e7000efdb81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-4)^{2}=-8(x-1)" :db/id #edb/ref 17592186250725} :answer-field/id #uuid "26ea5a01-cd1c-58e7-985e-fe58df8c683e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252875}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f5a78323-0f8e-5b1d-8bfd-600ef8cd7e86" :question/math-academy-id "q-11794" :question/problem "Find the equation of the left-opening parabola that has its vertex at $(1,4)$ and passes through the point $(-1,8).$" :question/worked-solution "The general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(1,4),$ we substitute $h=1$ and $k=4$ into the equation above and get\n\n$$\n\\begin{aligned}(y-4)^{2} & =4p(x-1).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(-1,8),$ so we can substitute $x=-1$ and $y=8$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}(y-4)^{2} & =4p(x-1) \\\\ (8-4)^{2} & =4p(-1-1) \\\\ 16 & =-8p \\\\ p & =-2\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}(y-4)^{2} & =4p(x-1) \\\\ (y-4)^{2} & =4(-2)(x-1) \\\\ (y-4)^{2} & =-8(x-1).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253446 :knowledge-point/_questions [{:db/id #edb/ref 17592186096704 :knowledge-point/id #uuid "dc86c375-c2c4-56b7-a207-0abfc9709f6a" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d8acb62-1689-516f-9882-4c9dda55e1c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=2(x+4)" :db/id #edb/ref 17592186251328} {:answer/id #uuid "77de82a0-e73e-5de8-a117-54e53271cdb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-3(x+4)" :db/id #edb/ref 17592186251544} {:answer/id #uuid "7a6921a9-f376-5914-8a9e-5b2f42ba5a37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+4)^{2}=3x" :db/id #edb/ref 17592186251571} {:answer/id #uuid "95781b19-83eb-5875-9326-f078ecb9c39d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=3(x+4)" :db/id #edb/ref 17592186251837} {:answer/id #uuid "fc5538d8-0f12-5dc5-a2c9-99178bd82c8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=-2(x+4)" :db/id #edb/ref 17592186252764}] :answer-field/correct {:answer/id #uuid "95781b19-83eb-5875-9326-f078ecb9c39d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}=3(x+4)" :db/id #edb/ref 17592186251837} :answer-field/id #uuid "9bf11644-eb3c-55f3-8b1b-a01c321a67d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253078}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "157ae011-ca8e-518d-b6fc-d2c2017281bc" :question/math-academy-id "q-11805" :question/problem "![](images/a1/a16f3f2ba78b5aef180c4331d1dd99f37340d2c6d842c1596e35445f1dbf34c5.png)\n\nWhat is the equation of the parabola shown above?" :question/worked-solution "From the diagram we see that the arms of the parabola open to the right. The parabola has its vertex at $(-4,0)$ and passes through the point $(8,6).$\n\nThe general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(-4,0),$ we substitute $h=-4$ and $k=0$ into the equation above and get\n\n$$\n\\begin{aligned}{y}^{2} & =4p(x+4).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(8,6),$ so we can substitute $x=8$ and $y=6$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}{y}^{2} & =4p(x+4) \\\\ {6}^{2} & =4p(8+4) \\\\ 36 & =48p \\\\ p & =\\frac{3}{4}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}{y}^{2} & =4p(x+4) \\\\ {y}^{2} & =4(\\frac{3}{4})(x+4) \\\\ {y}^{2} & =3(x+4).\\end{aligned}\n$$\n\nNotice that the arms of the parabola open to the right since $p=\\frac{3}{4}$ is positive."}] [{:db/id #edb/ref 17592186253456 :knowledge-point/_questions [{:db/id #edb/ref 17592186083241 :knowledge-point/id #uuid "89dc22a6-dd98-544c-8232-5043fac2bd3d" :knowledge-point/title "Solving a Rational Equations by Factoring a Quadratic Denominator With No Constant Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18683fc1-6e6f-552f-b3d8-1a598e647afe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "d=\\frac{3}{2}" :db/id #edb/ref 17592186250768} {:answer/id #uuid "afd8104c-d61b-5874-bc43-96a15275c763" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "d=-2" :db/id #edb/ref 17592186252087} {:answer/id #uuid "b3372c5e-1b3d-526f-a2ff-bdb9fc2ba5f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "d=5" :db/id #edb/ref 17592186252121} {:answer/id #uuid "c7189c96-8126-52ba-9ab5-81ef9869fbe6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No solutions" :db/id #edb/ref 17592186252312} {:answer/id #uuid "db77b71c-5ce2-5ae9-9c3c-53b2ac47a7d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "d=4" :db/id #edb/ref 17592186252480}] :answer-field/correct {:answer/id #uuid "c7189c96-8126-52ba-9ab5-81ef9869fbe6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No solutions" :db/id #edb/ref 17592186252312} :answer-field/id #uuid "485e4678-0882-55ac-8cb1-e26d4e0dafbf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252933}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8477c0d3-7e97-5832-b4f8-9e356450f509" :question/math-academy-id "q-118114" :question/problem "Solve the equation $\\frac{4}{d}+\\frac{6}{{d}^{2}-3d}=\\frac{2}{d-3}.$" :question/worked-solution "First, we factor the quadratic denominator, giving us the equation\n\n$$\n\\frac{4}{d}+\\frac{6}{d(d-3)}=\\frac{2}{d-3}.\n$$\n\nWe now make the following observations:\n\n- The least common denominator of our equation is given by\n\n$$\n\\text{LCM}(d,\\,d(d-3),\\,d-3)=d(d-3).\n$$\n\n- The values $d=0$ and $d=3$ cannot be solutions to our equation. These values make at least one denominator in our original equation equal zero, and division by zero is undefined.\n\nNow, multiplying both sides of the equation by the least common denominator, we can simplify it as follows:\n\n$$\n\\begin{aligned}\\frac{4}{d}+\\frac{6}{d(d-3)} & =\\frac{2}{d-3} \\\\ d(d-3)\\cdot (\\frac{4}{d}+\\frac{6}{d(d-3)}) & =d(d-3)\\cdot \\frac{2}{d-3} \\\\ \\frac{4d(d-3)}{d}+\\frac{6d(d-3)}{d(d-3)} & =\\frac{2d(d-3)}{d-3} \\\\ \\frac{4\\cdot \\cancel{d}\\cdot (d-3)}{\\cancel{d}}+\\frac{6\\cdot \\cancel{d(d-3)}}{\\cancel{d(d-3)}} & =\\frac{2d\\cdot \\cancel{(d-3)}}{\\cancel{d-3}} \\\\ 4(d-3)+6 & =2d\\end{aligned}\n$$\n\nSolving this equation for $d,$ we get the following:\n\n$$\n\\begin{aligned}4(d-3)+6 & =2d \\\\ 4d-6 & =2d \\\\ 2d & =6 \\\\ d & =3\\end{aligned}\n$$\n\nHowever, since $d=3$  is not a valid solution, our equation has no solutions."}] [{:db/id #edb/ref 17592186253467 :knowledge-point/_questions [{:db/id #edb/ref 17592186096845 :knowledge-point/id #uuid "1c269944-636a-50f2-bfc9-c32a7b2e7ca3" :knowledge-point/title "Calculating a Derivative Using the Chain and Product Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46092d6a-5809-530b-96aa-d18ca741a149" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(9x+1){e}^{9x}" :db/id #edb/ref 17592186251132} {:answer/id #uuid "9449d2c4-40c8-5886-a8f8-d377e92abd71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(9x+10){e}^{9x}" :db/id #edb/ref 17592186251828} {:answer/id #uuid "9fcc1d83-99af-5f5a-b373-703da0e18e92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+1){e}^{9x}" :db/id #edb/ref 17592186251929} {:answer/id #uuid "a8022752-cd20-552c-942e-08b64f288227" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9x{e}^{9x}" :db/id #edb/ref 17592186252002} {:answer/id #uuid "af7653ed-b253-50e2-9a68-8c72c94c9870" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9(x+1){e}^{9x}" :db/id #edb/ref 17592186252083}] :answer-field/correct {:answer/id #uuid "9449d2c4-40c8-5886-a8f8-d377e92abd71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(9x+10){e}^{9x}" :db/id #edb/ref 17592186251828} :answer-field/id #uuid "2531d2a5-3c0e-51d6-8cfe-475ebfb26445" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252873}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ab66beff-1db7-5265-a536-ea4d30aeb123" :question/math-academy-id "q-11824" :question/problem "Given that $y=(x+1){e}^{9x},$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "This question requires the product rule. Let $u(x)=x+1$ and $v(x)={e}^{9x}.$ Then\n\n$$\n{u}^{′}(x)=1,\\,{v}^{′}(x)=9{e}^{9x}.\n$$\n\nNote that we used the chain rule to differentiate $v.$\n\nNow, applying the product rule and simplifying, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(1)({e}^{9x})+(x+1)(9{e}^{9x}) \\\\  & ={e}^{9x}+9(x+1){e}^{9x} \\\\  & =(1+9(x+1)){e}^{9x} \\\\  & =(9x+10){e}^{9x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253471 :knowledge-point/_questions [{:db/id #edb/ref 17592186096695 :knowledge-point/id #uuid "29e2083d-fe76-5a35-9c3a-7e6ad19ff968" :knowledge-point/title "Determining the Equation of a Parabola With Non-Origin Vertex Passing Through a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0204d1a4-979b-5e5a-91e8-16da198d96f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+1)^{2}=-7(y+1)" :db/id #edb/ref 17592186250572} {:answer/id #uuid "03bd375b-9e1f-597d-b5e9-e0b4bc54bc30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-1)^{2}=7(y-1)" :db/id #edb/ref 17592186250582} {:answer/id #uuid "12e32eca-626a-5a03-9f08-308e2110d81a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-1)^{2}=-3(y-1)" :db/id #edb/ref 17592186250714} {:answer/id #uuid "7de8efb9-9a5f-5339-a2b1-15a8967978ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-1)^{2}=-7(y-1)" :db/id #edb/ref 17592186251610} {:answer/id #uuid "efdf1fa1-0772-50d6-9d54-6cbe5ab65088" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-1)^{2}=3(y-1)" :db/id #edb/ref 17592186252652}] :answer-field/correct {:answer/id #uuid "7de8efb9-9a5f-5339-a2b1-15a8967978ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-1)^{2}=-7(y-1)" :db/id #edb/ref 17592186251610} :answer-field/id #uuid "8ee73095-9b6e-56be-abd4-9d4c75590945" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253052}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6128a71e-f744-5ae8-9df3-81f671cec4ad" :question/math-academy-id "q-11833" :question/problem "Find the equation of the downward-opening parabola that has its vertex at $(1,1)$ and which passes through the point $(-6,-6).$" :question/worked-solution "For any upward or downward-opening parabola with its vertex at $(h,k),$ the general standard equation is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nHere, the vertex has coordinates $(h,k)=(1,1).$ Substituting these into the general standard equation, we get\n\n$$\n\\begin{aligned}(x-1)^{2} & =4p(y-1).\\end{aligned}\n$$\n\nWe are left to find the value of $p.$ We know that the given parabola also passes through the point $(-6,-6),$ so we can substitute $x=-6$ and $y=-6$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}(x-1)^{2} & =4p(y-1) \\\\ (-6-1)^{2} & =4p(-6-1) \\\\ 49 & =-28p \\\\ p & =-\\frac{7}{4}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}(x-1)^{2} & =4p(y-1) \\\\ (x-1)^{2} & =4(-\\frac{7}{4})(y-1) \\\\ (x-1)^{2} & =-7(y-1).\\end{aligned}\n$$"}]}
