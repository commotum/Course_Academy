#{[{:db/id #edb/ref 17592186247313 :knowledge-point/_questions [{:db/id #edb/ref 17592186083306 :knowledge-point/id #uuid "a75b47ec-8d5a-545e-b915-daca92320322" :knowledge-point/title "Identifying Non-Roots of a Polynomial Using the Rational Roots Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c017070-88fd-5d41-924a-dd54f0531459" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186244703} {:answer/id #uuid "4ac6a7f4-b7e5-5aab-882f-f2ec82413511" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186244981} {:answer/id #uuid "7d3708f5-187e-5b74-bb7c-fb6773b51adf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186245410} {:answer/id #uuid "b691b5c9-8cce-5aa4-9d4c-8759d0a10381" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186245946} {:answer/id #uuid "bb2dabbb-0466-5a5e-8205-efb8aaaa4a25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186245985}] :answer-field/correct {:answer/id #uuid "4ac6a7f4-b7e5-5aab-882f-f2ec82413511" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186244981} :answer-field/id #uuid "3a0be498-1922-5ad5-b70c-3159737e4b82" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246646}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b6b933a9-c0e8-5275-ae25-ac03d96707b1" :question/math-academy-id "q-112875" :question/problem "According to the rational roots theorem, which of the following **cannot** be a root of the polynomial $f(x)=2{x}^{3}-3{x}^{2}+6x-4?$" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial $f(x),$ the constant term is $-4$ and the leading coefficient is $2.$ So, any rational roots of $f(x)$ must take the form\n\n$$\n\\pm \\frac{\\text{factor of }-4}{\\text{factor of }2}.\n$$\n\nOf the given answer choices, only $-3$ does not take the above form. The value $-3$ can be interpreted as a fraction $-\\frac{3}{1},$ and the numerator $(3)$ is not a factor of $-4.$"}] [{:db/id #edb/ref 17592186247314 :knowledge-point/_questions [{:db/id #edb/ref 17592186083306 :knowledge-point/id #uuid "a75b47ec-8d5a-545e-b915-daca92320322" :knowledge-point/title "Identifying Non-Roots of a Polynomial Using the Rational Roots Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00cd694f-d390-52d9-a78d-058dcf78eb8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186244313} {:answer/id #uuid "152de8ab-d160-5e90-b2ca-ff89c3d91bfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186244509} {:answer/id #uuid "17313f34-dcb5-5781-b39d-796b35a3916f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186244528} {:answer/id #uuid "a5040499-a863-56b9-8a63-e98888aa5234" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186245794} {:answer/id #uuid "eea69027-2f10-55d7-b23d-3db9cf55ae48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{21}" :db/id #edb/ref 17592186246425}] :answer-field/correct {:answer/id #uuid "eea69027-2f10-55d7-b23d-3db9cf55ae48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{21}" :db/id #edb/ref 17592186246425} :answer-field/id #uuid "f324f8a5-9844-5e6d-9c1c-d5cb8449a00a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246983}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "aa7f9c70-0361-57e7-9796-46db5368f8ef" :question/math-academy-id "q-112876" :question/problem "According to the rational roots theorem, which of the following **cannot** be a root of the polynomial $f(x)=14{x}^{4}+3{x}^{2}-x-7?$" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial $f(x),$ the constant term is $-7$ and the leading coefficient is $14.$ So, any rational roots of $f(x)$ must take the form\n\n$$\n\\pm \\frac{\\text{factor of }-7}{\\text{factor of }14}.\n$$\n\nOf the given answer choices, only $\\frac{1}{21}$ does not take the above form. The denominator $(21)$ is not a factor of $14.$"}] [{:db/id #edb/ref 17592186247315 :knowledge-point/_questions [{:db/id #edb/ref 17592186083306 :knowledge-point/id #uuid "a75b47ec-8d5a-545e-b915-daca92320322" :knowledge-point/title "Identifying Non-Roots of a Polynomial Using the Rational Roots Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bdc5f64-cc65-540a-b355-123212f724a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186244560} {:answer/id #uuid "bed83593-683b-546b-bab1-d01fe899f6a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186246017} {:answer/id #uuid "c9d3bb43-fec1-56df-afc1-989bac7cecd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186246101} {:answer/id #uuid "ca89315e-0250-5749-b30e-2df535002d85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186246110} {:answer/id #uuid "ed290edf-cb24-5f1b-b56c-d0812c7e8baf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{6}" :db/id #edb/ref 17592186246410}] :answer-field/correct {:answer/id #uuid "1bdc5f64-cc65-540a-b355-123212f724a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186244560} :answer-field/id #uuid "c78daab4-3bc4-5ac1-8d58-c8d47a3e136b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246907}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "20875202-2f78-5deb-8279-48996bbf9d5a" :question/math-academy-id "q-112877" :question/problem "According to the rational roots theorem, which of the following **cannot** be a root of the polynomial $f(x)=-6{x}^{3}+{x}^{2}-9x+9?$" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial $f(x),$ the constant term is $9$ and the leading coefficient is $-6.$ So, any rational roots of $f(x)$ must take the form\n\n$$\n\\pm \\frac{\\text{factor of }9}{\\text{factor of }-6}.\n$$\n\nOf the given answer choices, only $-2$ does not take the above form. The value $-2$ can be interpreted as a fraction $\\frac{2}{-1},$ and the numerator $(2)$ is not a factor of $9.$"}] [{:db/id #edb/ref 17592186247319 :knowledge-point/_questions [{:db/id #edb/ref 17592186083232 :knowledge-point/id #uuid "1b5f9ee9-a489-5048-8346-0116a19e9b4a" :knowledge-point/title "Counting the Number of Possible Rational Roots of a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "606072b8-1571-53f5-8358-b985e1d8ceae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186245154} {:answer/id #uuid "9439af27-061f-5a51-9ce4-101131c1c895" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186245609} {:answer/id #uuid "b3ce193a-e790-539c-a55d-4caa8a112d35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186245914} {:answer/id #uuid "d1f2fa8e-fdb5-5e9e-a57e-65611f8056d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186246181} {:answer/id #uuid "dc1acaaa-6000-547c-bdb2-862487dabd47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186246268}] :answer-field/correct {:answer/id #uuid "9439af27-061f-5a51-9ce4-101131c1c895" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186245609} :answer-field/id #uuid "68b65d4b-12e9-5cb7-b679-73b65f162679" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246729}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "86a67078-b75c-5a5d-bcb6-0d3741c7e938" :question/math-academy-id "q-112964" :question/problem "For the polynomial $f(x)=20{x}^{5}-7{x}^{4}+x-4,$ how many *potential* roots are given by the rational roots theorem?" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial:\n\n- The constant term is $-4,$ and its factors are $\\pm 1,$ $\\pm 2$ and $\\pm 4.$\n\n- The leading coefficient is $20,$ and its factors are $\\pm 1,$ $\\pm 2,$ $\\pm 4,$ $\\pm 5,$ $\\pm 10$ and $\\pm 20.$\n\nFirst, we list out all the possibilities for the numerator and denominator:\n\n$$\n\\begin{aligned}\\pm \\frac{1}{1}, & \\pm \\frac{1}{2}, & \\pm \\frac{1}{4}, & \\pm \\frac{1}{5}, & \\pm \\frac{1}{10}, & \\pm \\frac{1}{20}, \\\\ \\pm \\frac{2}{1}, & \\pm \\frac{2}{2}, & \\pm \\frac{2}{4}, & \\pm \\frac{2}{5}, & \\pm \\frac{2}{10}, & \\pm \\frac{2}{20}, \\\\ \\pm \\frac{4}{1}, & \\pm \\frac{4}{2}, & \\pm \\frac{4}{4}, & \\pm \\frac{4}{5}, & \\pm \\frac{4}{10}, & \\pm \\frac{4}{20}.\\end{aligned}\n$$\n\nNext, we reduce the fractions to the lowest terms:\n\n$$\n\\begin{aligned}\\pm 1, & \\pm \\frac{1}{2}, & \\pm \\frac{1}{4}, & \\pm \\frac{1}{5}, & \\pm \\frac{1}{10}, & \\pm \\frac{1}{20}, \\\\ \\pm 2, & \\pm 1, & \\pm \\frac{1}{2}, & \\pm \\frac{2}{5}, & \\pm \\frac{1}{5}, & \\pm \\frac{1}{10}, \\\\ \\pm 4, & \\pm 2, & \\pm 1, & \\pm \\frac{4}{5}, & \\pm \\frac{2}{5}, & \\pm \\frac{1}{5}.\\end{aligned}\n$$\n\nNotice that several potential roots are duplicates (shown above in red). Removing these duplicates, and listing those remaining in order from least to greatest in absolute value, we have\n\n$$\n\\pm \\frac{1}{20},\\,\\pm \\frac{1}{10},\\,\\pm \\frac{1}{5},\\,\\pm \\frac{1}{4},\\,\\pm \\frac{2}{5},\\,\\pm \\frac{1}{2},\\,\\pm \\frac{4}{5},\\,\\pm 1,\\,\\pm 2,\\,\\pm 4.\n$$\n\nThis makes a total of $20$ potential roots. (Remember that each $\\pm $ sign accounts for $2$ roots, and $2\\cdot 10=20.$)"}] [{:db/id #edb/ref 17592186247331 :knowledge-point/_questions [{:db/id #edb/ref 17592186179648 :knowledge-point/id #uuid "63080bb8-7a6a-505d-813a-e6c99d337064" :knowledge-point/title "Adding and Subtracting a Number and a Rational Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b25ac5b-cbcc-57ea-af98-36cbf2debd6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{p-5}{p}" :db/id #edb/ref 17592186244417} {:answer/id #uuid "2835dbf8-8dfd-5b11-9840-111aa89d7e47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2p-5}{p}" :db/id #edb/ref 17592186244668} {:answer/id #uuid "3e3d761c-0e4f-53bc-9bc6-dd4223070293" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(p+5)}{p}" :db/id #edb/ref 17592186244861} {:answer/id #uuid "72ffb2d8-d1e6-5411-9428-219a615ab1ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2p+5}{p}" :db/id #edb/ref 17592186245343} {:answer/id #uuid "b2cd2d36-c9bd-5a3c-ac47-c6f5b8d1b85a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{p+5}{p}" :db/id #edb/ref 17592186245905}] :answer-field/correct {:answer/id #uuid "72ffb2d8-d1e6-5411-9428-219a615ab1ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2p+5}{p}" :db/id #edb/ref 17592186245343} :answer-field/id #uuid "3900ea01-ab69-50df-9eb2-9740cea656bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246643}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "db256712-a567-5c31-aac9-855b317092f8" :question/math-academy-id "q-113217" :question/problem "Write $3+\\frac{5-p}{p}$ as a single fraction." :question/worked-solution "Using the fact that $3=\\frac{3}{1},$ we can write the expression as\n\n$$\n\\frac{3}{1}+\\frac{5-p}{p}.\n$$\n\n \n\nIn order to add the two fractions, we need them to have a common denominator. So, we put both fractions over a common denominator of $p$ by multiplying the top and bottom of the first fraction by $p:$\n\n$$\n\\begin{aligned}\\frac{3}{1}+\\frac{5-p}{p} & = \\\\ \\frac{p}{p}\\cdot \\frac{3}{1}+\\frac{5-p}{p} & = \\\\ \\frac{3p}{p}+\\frac{5-p}{p}\\end{aligned}\n$$\n\nFinally, we add the fractions and simplify the result:\n\n$$\n\\begin{aligned}\\frac{3p}{p}+\\frac{5-p}{p} & = \\\\ \\frac{3p+5-p}{p} & = \\\\ \\frac{2p+5}{p}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247333 :knowledge-point/_questions [{:db/id #edb/ref 17592186179648 :knowledge-point/id #uuid "63080bb8-7a6a-505d-813a-e6c99d337064" :knowledge-point/title "Adding and Subtracting a Number and a Rational Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "165183aa-3273-5868-996d-bf72842cf7e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(2h+1)}{h}" :db/id #edb/ref 17592186244519} {:answer/id #uuid "4270531d-a040-562e-b202-75ec50fead69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(2h-1)}{h}" :db/id #edb/ref 17592186244895} {:answer/id #uuid "9220ca4b-6d7c-5b14-9adf-33f3030837cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2h-1}{h}" :db/id #edb/ref 17592186245586} {:answer/id #uuid "d60d60b4-9436-5997-b763-9f4ab2aa9c33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{h-3}{h}" :db/id #edb/ref 17592186246220} {:answer/id #uuid "fc805e18-0d87-57e6-a207-15782a97edad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2h+1}{h}" :db/id #edb/ref 17592186246523}] :answer-field/correct {:answer/id #uuid "4270531d-a040-562e-b202-75ec50fead69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(2h-1)}{h}" :db/id #edb/ref 17592186244895} :answer-field/id #uuid "c644fa58-4381-548f-9a70-2fdfff8866ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246903}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "896043de-6bd3-58d0-93eb-3b6444623304" :question/math-academy-id "q-113219" :question/problem "Write $5+\\frac{h-3}{h}$ as a single fraction." :question/worked-solution "Using the fact that $5=\\frac{5}{1},$ we can write the expression as\n\n$$\n\\frac{5}{1}+\\frac{h-3}{h}.\n$$\n\n \n\nIn order to add the two fractions, we need them to have a common denominator. So, we put both fractions over a common denominator of $h$ by multiplying the top and bottom of the first fraction by $h:$\n\n$$\n\\begin{aligned}\\frac{5}{1}+\\frac{h-3}{h} & = \\\\ \\frac{h}{h}\\cdot \\frac{5}{1}+\\frac{h-3}{h} & = \\\\ \\frac{5h}{h}+\\frac{h-3}{h}\\end{aligned}\n$$\n\nFinally, we add the fractions and simplify the result:\n\n$$\n\\begin{aligned}\\frac{5h}{h}+\\frac{h-3}{h} & = \\\\ \\frac{5h+h-3}{h} & = \\\\ \\frac{6h-3}{h} & = \\\\ \\frac{3(2h-1)}{h}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186399788 :knowledge-point/_questions [{:db/id #edb/ref 17592186087830 :knowledge-point/id #uuid "a9c8c1d8-2662-5c15-b084-084f9e930141" :knowledge-point/title "Solving a Quadratic Equation With Complex Roots by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac5d4b19-8c81-5ba1-996a-70b59878a1fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=-28,\\,x=3\\pm 5\\,\\text{i}" :db/id #edb/ref 17592186399790} {:answer/id #uuid "6512548c-dca0-5e35-9fae-cb9552f71f4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=22,\\,x=3\\pm 5\\,\\text{i}" :db/id #edb/ref 17592186399791} {:answer/id #uuid "ea660700-9472-591c-8a60-b82ac1eb0a78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=-28,\\,x=5\\pm 3\\,\\text{i}" :db/id #edb/ref 17592186399792} {:answer/id #uuid "aa2d981b-ddf0-5166-b28f-034d57bae937" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=22,\\,x=5\\pm 3\\,\\text{i}" :db/id #edb/ref 17592186399793} {:answer/id #uuid "282a88ee-2e7c-579c-b7aa-4a73cb82ac9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=-28,\\,x=3\\pm 3\\,\\text{i}" :db/id #edb/ref 17592186399794}] :answer-field/correct {:answer/id #uuid "ac5d4b19-8c81-5ba1-996a-70b59878a1fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=-28,\\,x=3\\pm 5\\,\\text{i}" :db/id #edb/ref 17592186399790} :answer-field/id #uuid "abb7896d-c7f4-5b7b-a55d-ac98d8904d0e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399789}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ed379096-4def-51e1-8cd6-e568b470e309" :question/math-academy-id "q-113245" :question/problem "The equation ${x}^{2}-6x+34=0$ can be written in the form $(x+p)^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "We first move the constant to the right-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-6x+34 & =0 \\\\ {x}^{2}-6x & =-34\\end{aligned}\n$$\n\nNext, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-6x & =-34 \\\\ {x}^{2}-2\\cdot 3x+{3}^{2}-{3}^{2} & =-34 \\\\ (x-3)^{2}-9 & =-34 \\\\ (x-3)^{2} & =-25\\end{aligned}\n$$\n\nTherefore, $p=-3,\\,q=-25,$ and $p+q=-28.$\n\nFinally, we solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-3)^{2} & =-25 \\\\ x-3 & =\\pm \\sqrt{-25} \\\\ x-3 & =\\pm 5\\,\\text{i} \\\\ x & =3\\pm 5\\,\\text{i}\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=3+5\\,\\text{i}$ and $x=3-5\\,\\text{i}.$"}] [{:db/id #edb/ref 17592186247339 :knowledge-point/_questions [{:db/id #edb/ref 17592186068753 :knowledge-point/id #uuid "8058df30-04de-555c-adfa-61fbf2b0ff31" :knowledge-point/title "Adding Rational Expressions in One Variable With Common Factors in the Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0af04033-a6ba-55b9-a3cf-e88062146da2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3+8v}{3+2v}" :db/id #edb/ref 17592186244413} {:answer/id #uuid "22c65f9d-8809-5b40-a4ac-12894dc5fb71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(2-v)}{2(3+2v)}" :db/id #edb/ref 17592186244619} {:answer/id #uuid "590e2778-3be8-5b98-82cb-b429232a3edf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3-8v}{2(3+2v)}" :db/id #edb/ref 17592186245100} {:answer/id #uuid "68f4011e-d001-588c-8473-c4e6ecca6ef6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5-8v}{2(3+2v)}" :db/id #edb/ref 17592186245240} {:answer/id #uuid "74a2e865-4b12-53b0-9d9d-023142d8fc7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(3+v)}{3+2v}" :db/id #edb/ref 17592186245352}] :answer-field/correct {:answer/id #uuid "22c65f9d-8809-5b40-a4ac-12894dc5fb71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(2-v)}{2(3+2v)}" :db/id #edb/ref 17592186244619} :answer-field/id #uuid "4f65e550-213e-5735-8350-553dfc51c9ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246685}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "77efbc7d-72cb-5364-b916-b8865a568a34" :question/math-academy-id "q-113296" :question/problem "Given that $\\frac{7v}{2(3+2v)}=t$ and $\\frac{3-5v}{3+2v}=r,$ what is $t+r?$" :question/worked-solution "We wish to add the following fractions:\n\n$$\nt+r=\\frac{7v}{2(3+2v)}+\\frac{3-5v}{3+2v}\n$$\n\nIn order to add the two fractions, we need them to have a common denominator. Here, we can put both fractions over a common denominator of $2(3+2v)$ if we multiply the top and bottom of the second fraction by $2:$\n\n$$\n\\begin{aligned}\\frac{7v}{2(3+2v)}+\\frac{3-5v}{3+2v} & = \\\\ \\frac{7v}{2(3+2v)}+\\frac{2}{2}\\cdot \\frac{3-5v}{3+2v} & = \\\\ \\frac{7v}{2(3+2v)}+\\frac{2(3-5v)}{2(3+2v)} & = \\\\ \\frac{7v+2(3-5v)}{2(3+2v)} & = \\\\ \\frac{7v+6-10v}{2(3+2v)} & = \\\\ \\frac{6-3v}{2(3+2v)} & = \\\\ \\frac{3(2-v)}{2(3+2v)}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247340 :knowledge-point/_questions [{:db/id #edb/ref 17592186068754 :knowledge-point/id #uuid "fb2231aa-8afa-57df-a43c-cb3add25b2cc" :knowledge-point/title "Adding Rational Expressions in Multiple Variables With Common Factors in the Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01b8b770-6c21-56e3-b336-b5d95a1f29e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2g}{2-h}" :db/id #edb/ref 17592186244324} {:answer/id #uuid "025ab6a7-c175-5bda-a5ae-71435f2b411c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5g-3}{2-h}" :db/id #edb/ref 17592186244327} {:answer/id #uuid "31851e6a-ae53-558a-abeb-21c73e270e9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{g-8}{g(2-h)}" :db/id #edb/ref 17592186244756} {:answer/id #uuid "6ca976fc-984c-5548-a93e-3086a908c594" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5g-3}{g(2-h)}" :db/id #edb/ref 17592186245274} {:answer/id #uuid "baae5de1-50ed-564b-82ed-9a3209161644" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2g}{g(2-h)}" :db/id #edb/ref 17592186245981}] :answer-field/correct {:answer/id #uuid "6ca976fc-984c-5548-a93e-3086a908c594" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5g-3}{g(2-h)}" :db/id #edb/ref 17592186245274} :answer-field/id #uuid "a59a56f0-3a08-5ffd-bb0c-f4cdd17dbade" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246841}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d446f78d-7f19-5904-b8b0-ee54e70de00c" :question/math-academy-id "q-113303" :question/problem "Simplify $\\frac{5}{2-h}-\\frac{3}{g(2-h)}.$" :question/worked-solution "In order to subtract the two fractions, we need them to have a common denominator. Here, we can put both fractions over a common denominator of $g(2-h)$ if we multiply the top and bottom of the first fraction by $g:$\n\n$$\n\\begin{aligned}\\frac{5}{2-h}-\\frac{3}{g(2-h)} & = \\\\ \\frac{g}{g}\\cdot \\frac{5}{2-h}-\\frac{3}{g(2-h)} & = \\\\ \\frac{5g}{g(2-h)}-\\frac{3}{g(2-h)} & = \\\\ \\frac{5g-3}{g(2-h)} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386654 :knowledge-point/_questions [{:db/id #edb/ref 17592186068813 :knowledge-point/id #uuid "ea2f1348-55bf-5313-8d5e-a5a097231e97" :knowledge-point/title "Graphing a Stretched Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22044db0-b676-5a41-8839-2fb6643aef6c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ee/eeb158823a32a215dcf72d67bd27b8ad5df238ee44af535afd5850a15f9d17c0.png" :db/id #edb/ref 17592186386656} {:answer/id #uuid "5cc5cd0e-29d2-5786-8b2b-2a6c87539104" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fd/fdc3e5ca668f2e66df09049bfa51fbc156160c091164dafa5f217be1bfbb4c27.png" :db/id #edb/ref 1