#{[{:db/id #edb/ref 17592186268973 :knowledge-point/_questions [{:db/id #edb/ref 17592186175936 :knowledge-point/id #uuid "a2ac0065-9315-547a-a9cf-c6a5abea1aed" :knowledge-point/title "Computing Covariance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c96926a-f4ac-5a4a-bb28-483eebe3a042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186267101} {:answer/id #uuid "92bb008b-73e2-5f57-aaf9-b1c9670bb361" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186267454} {:answer/id #uuid "98e29162-e94e-5e48-a63c-803330198e5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186267522} {:answer/id #uuid "de2ab8f0-3c69-58b4-9838-f8a533c7f98f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186268105} {:answer/id #uuid "f2efc021-dda9-5c9f-ba17-5d373e53d90c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186268303}] :answer-field/correct {:answer/id #uuid "de2ab8f0-3c69-58b4-9838-f8a533c7f98f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186268105} :answer-field/id #uuid "69377ba2-c0ef-5769-b77b-40c99fa0f34c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268596}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4cf798d3-99fb-51d5-934b-1e9180edf066" :question/math-academy-id "q-134159" :question/problem "Consider the following data sets:\n\n$$\nx={-1,\\,6,\\,2,\\,5},\\,y={-2,\\,5,\\,7,\\,6}\n$$\n\nYou're given that $\\overset{―}{x}=3$ and $\\overset{―}{y}=4.$ Calculate $\\text{Cov}(x,y).$" :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(-1-3)(-2-4)+(6-3)(5-4)+(2-3)(7-4)+(5-3)(6-4)] \\\\  & =\\frac{1}{4}[(-4)(-6)+(3)(1)+(-1)(3)+(2)(2)] \\\\  & =\\frac{1}{4}[24+3-3+4] \\\\  & =\\frac{1}{4}\\cdot 28 \\\\  & =7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268975 :knowledge-point/_questions [{:db/id #edb/ref 17592186176030 :knowledge-point/id #uuid "88babe91-d8bf-53ba-8d72-35ad35f9253e" :knowledge-point/title "Calculating the Speed of an Object"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "048cab5e-bbd5-5811-a4d0-8ca8f85ee145" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ feet per second" :db/id #edb/ref 17592186266183} {:answer/id #uuid "1cf5c97b-a06e-5922-ae8a-d7e195b65387" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$14$ feet per second" :db/id #edb/ref 17592186266390} {:answer/id #uuid "b717b37d-f4d7-5f70-ac90-3365030a3801" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$280$ feet per second" :db/id #edb/ref 17592186267783} {:answer/id #uuid "de613ffe-4f41-5a9b-bffe-1b7387734d36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$40$ feet per second" :db/id #edb/ref 17592186268107} {:answer/id #uuid "f9712262-c406-555b-85c5-19c0f9652329" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$70$ feet per second" :db/id #edb/ref 17592186268355}] :answer-field/correct {:answer/id #uuid "048cab5e-bbd5-5811-a4d0-8ca8f85ee145" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ feet per second" :db/id #edb/ref 17592186266183} :answer-field/id #uuid "aa305f49-8c63-5967-8dbe-bb8cee6aab2a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268711}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "363ac4b8-fa48-5948-b74e-bd2bdaf627fa" :question/math-academy-id "q-134164" :question/problem "A canoe traveled $280$ feet in $70$ seconds at a constant rate.  What is the speed of the canoe?" :question/worked-solution "Speed is a special unit rate applied to moving objects. It is defined as *the distance traveled per unit of time*:\n\n$$\n\\text{speed}=\\frac{\\text{distance}}{\\text{time}}\n$$\n\nTo find the speed (in feet per second), we divide the number of feet, $280,$ by the number of seconds, $70.$ This gives,\n\n$$\n\\frac{280}{70}=280÷70=4.\n$$\n\nTherefore, the speed of the canoe is $4$ feet per second."}] [{:db/id #edb/ref 17592186268979 :knowledge-point/_questions [{:db/id #edb/ref 17592186175936 :knowledge-point/id #uuid "a2ac0065-9315-547a-a9cf-c6a5abea1aed" :knowledge-point/title "Computing Covariance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "441b2c8e-dbaf-594e-9f26-8da9b148397f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186266751} {:answer/id #uuid "e5ea4787-26d6-5c8e-aa9d-ebc03249189b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186268180} {:answer/id #uuid "e5fd8492-13b4-5fa1-a203-4c2b1a8f2b15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186268182} {:answer/id #uuid "fb8685e4-075d-5c33-9c2e-d13e809a6745" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186268368} {:answer/id #uuid "fccdee25-35d1-5ea4-b1da-a4668ce1fbe4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186268374}] :answer-field/correct {:answer/id #uuid "441b2c8e-dbaf-594e-9f26-8da9b148397f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186266751} :answer-field/id #uuid "923f23dc-8259-592b-ae04-9981fc36c9d3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268661}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8776d2b8-cc6d-5825-8f19-b2c66c611b9a" :question/math-academy-id "q-134170" :question/problem "Calculate $\\text{Cov}(x,y)$ for the following data sets:\n\n$$\nx={4,\\,-2,\\,5,\\,1},\\,y={-7,\\,5,\\,4,\\,-2}\n$$" :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nFirst, we need to compute the means:\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{4}\\cdot (4+(-2)+5+1) \\\\  & =\\frac{1}{4}\\cdot 8 \\\\  & =2 \\\\ \\overset{―}{y} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i} \\\\  & =\\frac{1}{4}\\cdot ((-7)+5+4+(-2)) \\\\  & =\\frac{1}{4}\\cdot 0 \\\\  & =0\\end{aligned}\n$$\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(4-2)(-7-0)+(-2-2)(5-0)+(5-2)(4-0)+(1-2)(-2-0)] \\\\  & =\\frac{1}{4}[(2)(-7)+(-4)(5)+(3)(4)+(-1)(-2)] \\\\  & =\\frac{1}{4}[-14-20+12+2] \\\\  & =\\frac{1}{4}\\cdot (-20) \\\\  & =-5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268980 :knowledge-point/_questions [{:db/id #edb/ref 17592186176030 :knowledge-point/id #uuid "88babe91-d8bf-53ba-8d72-35ad35f9253e" :knowledge-point/title "Calculating the Speed of an Object"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "388381c6-d3f3-5ce8-9343-272755a4a1de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$145$ feet per minute" :db/id #edb/ref 17592186266636} {:answer/id #uuid "8f5968e7-47fd-59f2-84a5-9faaa2be9ff9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$150.5$ feet per minute" :db/id #edb/ref 17592186267423} {:answer/id #uuid "9918aa8c-9fab-5e35-b660-6a295161995a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$132.5$ feet per minute" :db/id #edb/ref 17592186267525} {:answer/id #uuid "a388233f-9461-523b-bf1c-23eb098cf553" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$301$ feet per minute" :db/id #edb/ref 17592186267615} {:answer/id #uuid "b60499d9-26b2-5a0d-b9b8-bf12fdf4495e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$75$ feet per minute" :db/id #edb/ref 17592186267770}] :answer-field/correct {:answer/id #uuid "8f5968e7-47fd-59f2-84a5-9faaa2be9ff9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$150.5$ feet per minute" :db/id #edb/ref 17592186267423} :answer-field/id #uuid "ed694b78-5bc8-5345-8197-6311533e4009" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268820}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9150e0d7-03db-545b-ba25-add48de4f78e" :question/math-academy-id "q-134172" :question/problem "An elevator covers $602$ feet in $4$ minutes, moving at a constant rate. What is the speed of the elevator?" :question/worked-solution "Speed is a special unit rate applied to moving objects. It is defined as *the distance traveled per unit of time*:\n\n$$\n\\text{speed}=\\frac{\\text{distance}}{\\text{time}}\n$$\n\nTo find the speed in feet per minute, we divide the number of feet, $602,$ by the number of minutes, $4.$ This gives,\n\n$$\n\\begin{aligned}\\frac{602}{4} & =\\frac{602÷2}{4÷2} \\\\  & =\\frac{301}{2} \\\\  & =301÷2 \\\\  & =150.5.\\end{aligned}\n$$\n\nTherefore, the speed of the elevator is $150.5$ feet per minute."}] [{:db/id #edb/ref 17592186268990 :knowledge-point/_questions [{:db/id #edb/ref 17592186176032 :knowledge-point/id #uuid "6570253a-b05a-5721-9108-5fddab2b5388" :knowledge-point/title "Calculating Time Given Distance and Speed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cab5046-233a-5880-a03b-503b0856d91c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6.5$ minutes" :db/id #edb/ref 17592186266680} {:answer/id #uuid "e325a324-10a4-5f82-b231-fa3bd706ffd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7.5$ minutes" :db/id #edb/ref 17592186268151} {:answer/id #uuid "e83770ff-718f-52f9-990d-ade35dfa8b0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6$ minutes" :db/id #edb/ref 17592186268205} {:answer/id #uuid "e91f6d7c-f724-5d0a-abea-83d4d6399631" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ minutes" :db/id #edb/ref 17592186268215} {:answer/id #uuid "ef6e5bd5-073f-5a36-96f8-f3263a6b14de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7$ minutes" :db/id #edb/ref 17592186268273}] :answer-field/correct {:answer/id #uuid "e83770ff-718f-52f9-990d-ade35dfa8b0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6$ minutes" :db/id #edb/ref 17592186268205} :answer-field/id #uuid "51bb6fb1-a3cf-54cb-9a80-1e8569ed6784" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268553}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "27bf74aa-5d79-5da2-ae74-80f3b8309260" :question/math-academy-id "q-134220" :question/problem "A jet ski traveled $3\\,960$ meters at a constant speed of $660$ meters per minute. For how long was the jet ski in motion?" :question/worked-solution "The speed is $660$ meters per minute. To find the time it took the jet ski to cover $3\\,960$ meters, we divide the distance by $660.$ This gives\n\n$$\n\\begin{aligned}\\text{time} & =\\frac{\\text{distance}}{\\text{speed}} \\\\  & =\\frac{3\\,960}{660} \\\\  & =\\frac{3\\,960÷60}{660÷60} \\\\  & =\\frac{66}{11} \\\\  & =66÷11 \\\\  & =6.\\end{aligned}\n$$\n\nTherefore, the jet ski was in motion for $6$ minutes."}] [{:db/id #edb/ref 17592186268991 :knowledge-point/_questions [{:db/id #edb/ref 17592186175937 :knowledge-point/id #uuid "cee807c1-dd86-5b0e-a595-5c5754c47e4c" :knowledge-point/title "Computing Covariance in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f92a789-d109-50a4-95bb-321fbf167553" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186266275} {:answer/id #uuid "3a4fc0c3-7987-5650-a6c4-15357f0a2e40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186266658} {:answer/id #uuid "81b8fc0f-c491-5c9d-b014-a4dd49ed0618" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186267287} {:answer/id #uuid "8feb198f-42a2-5fd7-a65e-3cb6ba4e1c4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.5" :db/id #edb/ref 17592186267425} {:answer/id #uuid "9f77bdcd-8fd8-5c39-a664-6aabddb6169f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2.5" :db/id #edb/ref 17592186267585}] :answer-field/correct {:answer/id #uuid "0f92a789-d109-50a4-95bb-321fbf167553" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186266275} :answer-field/id #uuid "0a27bb6c-7a78-5c39-ae3a-526cec46f622" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268424}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fd4f8095-844e-57fc-88d9-718d41a408a6" :question/math-academy-id "q-134221" :question/problem "| **Age, in years ($x$)** | $7$ | $9$ | $11$ | $13$ |\n| --- | --- | --- | --- | --- |\n| **Shoe Size (USA) ($y$)** | $7$ | $8$ | $9$ | $8$ |\n\nMr. Damon recorded the age and shoe size of four tennis players at his academy. The table above shows the information he collected. Compute the covariance of the data sets given that the means are $\\overset{―}{x}=10$ and $\\overset{―}{y}=8.$" :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(7-10)(7-8)+(9-10)(8-8)+(11-10)(9-8)+(13-10)(8-8)] \\\\  & =\\frac{1}{4}[(-3)(-1)+(-1)(0)+(1)(1)+(3)(0)] \\\\  & =\\frac{1}{4}[3+0+1+0] \\\\  & =\\frac{1}{4}\\cdot 4 \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268994 :knowledge-point/_questions [{:db/id #edb/ref 17592186176032 :knowledge-point/id #uuid "6570253a-b05a-5721-9108-5fddab2b5388" :knowledge-point/title "Calculating Time Given Distance and Speed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02f258e3-8882-5aeb-8740-3e42cb6e7994" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$40$ seconds" :db/id #edb/ref 17592186266171} {:answer/id #uuid "5d95a249-fc05-50ac-9d04-c408a09025da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$44$ seconds" :db/id #edb/ref 17592186266970} {:answer/id #uuid "60a9d8c4-203b-5e3f-8e27-11c1d3cd6d57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$50$ seconds" :db/id #edb/ref 17592186266996} {:answer/id #uuid "640b8046-055f-5a66-8042-59ab2cf08bbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$52$ seconds" :db/id #edb/ref 17592186267026} {:answer/id #uuid "ab5026ed-6705-5518-8ad4-b09d2651f5d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$38$ seconds" :db/id #edb/ref 17592186267691}] :answer-field/correct {:answer/id #uuid "5d95a249-fc05-50ac-9d04-c408a09025da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$44$ seconds" :db/id #edb/ref 17592186266970} :answer-field/id #uuid "9d55d2b0-ddd8-553b-a7e3-cf16362be09c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268682}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "92c13e99-67cb-5a62-9173-697230856fc4" :question/math-academy-id "q-134241" :question/problem "It takes $35$ seconds for a dolphin to swim $315$ meters at a constant pace. How long does it take for the dolphin to swim $396$ meters?" :question/worked-solution "Speed is a special unit rate applied to moving objects. It is defined as *the distance traveled per unit of time*:\n\n$$\n\\text{speed}=\\frac{\\text{distance}}{\\text{time}}\n$$\n\nTo find the speed, in meters per second, we divide the number of meters, which is $315,$ by the number of seconds, $35.$ This gives,\n\n$$\n\\begin{aligned}\\frac{315}{35} & =\\frac{315÷5}{35÷5} \\\\  & =\\frac{63}{7} \\\\  & =63÷7 \\\\  & =9.\\end{aligned}\n$$\n\nSo, the speed of the dolphin is $9$ meters per second. \n\nTo find the time it takes the dolphin to cover $396$ meters, we divide the distance by $9.$ This gives\n\n$$\n\\begin{aligned}\\text{time} & =\\frac{\\text{distance}}{\\text{speed}} \\\\  & =\\frac{396}{9} \\\\  & =396÷9 \\\\  & =44.\\end{aligned}\n$$\n\nTherefore, it takes the dolphin $44$ seconds to travel $396$ meters."}] [{:db/id #edb/ref 17592186268995 :knowledge-point/_questions [{:db/id #edb/ref 17592186176031 :knowledge-point/id #uuid "534de76f-d4bc-55b5-858e-2b594f63b7bc" :knowledge-point/title "Calculating Distance Given Speed and Time"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40131a28-43ac-50cf-8d52-39f12b620ee7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$90$ centimeters" :db/id #edb/ref 17592186266722} {:answer/id #uuid "886f2ab6-77f8-5a47-b00c-148f635dc0f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$81$ centimeters" :db/id #edb/ref 17592186267351} {:answer/id #uuid "a3488564-1ffd-543a-9e83-a3e4de6a4a55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$72$ centimeters" :db/id #edb/ref 17592186267612} {:answer/id #uuid "a5f5d571-924e-5ad6-9047-abd7a0db08a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$64$ centimeters" :db/id #edb/ref 17592186267647} {:answer/id #uuid "eeb2d178-478e-56b8-97e6-0ffe587c1d6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$15$ centimeters" :db/id #edb/ref 17592186268268}] :answer-field/correct {:answer/id #uuid "886f2ab6-77f8-5a47-b00c-148f635dc0f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$81$ centimeters" :db/id #edb/ref 17592186267351} :answer-field/id #uuid "6f1172ab-eeb3-5cad-a411-b983f6dd952a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268610}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "12110187-5a54-55e6-a927-228b7377faf9" :question/math-academy-id "q-134243" :question/problem "It takes $30$ minutes for a slug to crawl $135$ centimeters when moving at a constant pace. Find the distance this slug covers in $18$ minutes." :question/worked-solution "Speed is a special unit rate applied to moving objects. It is defined as *the distance traveled per unit of time*:\n\n$$\n\\text{speed}=\\frac{\\text{distance}}{\\text{time}}\n$$\n\nTo find the speed in centimeters per minute, we divide the number of centimeters, $135,$ by the number of minutes, $30.$ This gives,\n\n$$\n\\begin{aligned}\\frac{135}{30} & =135÷30 \\\\  & =\\frac{135÷15}{30÷15} \\\\  & =\\frac{9}{2} \\\\  & =9÷2 \\\\  & =4.5.\\end{aligned}\n$$\n\nSo, the speed of the slug is $4.5$ centimeters per minute. \n\nTo find the distance covered in $18$ minutes, we multiply the speed by $18.$ This gives\n\n$$\n\\begin{aligned}\\text{distance} & =\\text{speed}\\times \\text{time} \\\\  & =4.5\\times 18 \\\\  & =81.\\end{aligned}\n$$\n\nTherefore, the slug covers $81$ centimeters in $18$ minutes."}] [{:db/id #edb/ref 17592186269103 :knowledge-point/_questions [{:db/id #edb/ref 17592186083306 :knowledge-point/id #uuid "a75b47ec-8d5a-545e-b915-daca92320322" :knowledge-point/title "Identifying Non-Roots of a Polynomial Using the Rational Roots Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1482f361-3b1e-543f-870b-a26dcf92d2ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186266319} {:answer/id #uuid "2870d2f6-a4e4-5d62-a218-0e3e5a8a8827" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186266504} {:answer/id #uuid "447ea00c-4d69-5351-8ae6-7fb524a5e59a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186266757} {:answer/id #uuid "ab240971-126a-51ed-95e8-caf2152e97e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186267690} {:answer/id #uuid "fda09780-5082-5dc7-9e43-74a04e529440" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186268378}] :answer-field/correct {:answer/id #uuid "fda09780-5082-5dc7-9e43-74a04e529440" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186268378} :answer-field/id #uuid "466acc84-20e7-58f4-bf70-73eea0fa85ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268526}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "54404730-020a-547b-8cd2-8751476ed4d0" :question/math-academy-id "q-13613" :question/problem "According to the rational roots theorem, which of the following **cannot** be a root of the polynomial $f(x)=3{x}^{3}+10{x}^{2}-23x+10?$" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial $f(x),$ the constant term is $10$ and the leading coefficient is $3.$ So, any rational roots of $f(x)$ must take the form\n\n$$\n\\pm \\frac{\\text{factor of }10}{\\text{factor of }3}.\n$$\n\nOf the given answer choices, only $3$ does not take the above form. The value $3$ can be interpreted as a fraction $\\frac{3}{1},$ and the numerator $(3)$ is not a factor of $10.$"}] [{:db/id #edb/ref 17592186176347 :knowledge-point/_questions [{:db/id #edb/ref 17592186176058 :knowledge-point/id #uuid "66a1733a-d7bb-5c86-a154-9e54422053a7" :knowledge-point/title "Utilizing the Oddness Property of the Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19df7d47-b87b-5e46-8360-7533c525ec2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186266358} {:answer/id #uuid "3c2908b8-2ead-5a77-be9f-804bc07bb7fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186266672} {:answer/id #uuid "6ccc1b1b-9a04-5bb8-a591-9f5cc4c7efc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186267102} {:answer/id #uuid "8b14d04b-7661-55d9-a6d2-74ec1e93a05a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186267392} {:answer/id #uuid "a5bfc5ef-972c-5d0d-9011-6abdfdf11b45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186267642}] :answer-field/correct {:answer/id #uuid "19df7d47-b87b-5e46-8360-7533c525ec2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186266358} :answer-field/id #uuid "a6737d96-a059-592e-9cfb-df4b5f79acd2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268703}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ccd7ae50-1c4e-5bcc-8b8b-d405f5154f0b" :question/math-academy-id "q-136548" :question/problem "If $tan⁡a=-2,$ then $tan⁡(-a)=$" :question/worked-solution "First, let's recall the graph of $y=tan⁡x.$\n\n![](images/df/df1aba3f5ff980de82a74dde8170ad708e379caf2188873bcddc83177e87c7a6.png)\n\nOur graph has rotational symmetry of order $2$ about the origin. If we rotate the graph ${180}^{∘}$ around the origin, we get the same picture. This means that $tan⁡x$ is an *odd* function, and we have\n\n$$\ntan⁡(-x)=-tan⁡x.\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}tan⁡(-a) & =-tan⁡a \\\\  & =-(-2) \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186269128 :knowledge-point/_questions [{:db/id #edb/ref 17592186176059 :knowledge-point/id #uuid "d4b378b0-30e5-59a8-b9f7-882b5e226a2e" :knowledge-point/title "Utilizing the Evenness Property of the Secant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04ba9a98-d418-5054-94e5-129c6b76bfac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186266186} {:answer/id #uuid "19edb75b-03b9-59e8-bc8e-e9f768d59cb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186266360} {:answer/id #uuid "5e2ed2c4-f432-5dc5-84ad-45be5e6c0e95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186266975} {:answer/id #uuid "5e32262d-72d6-5e5a-894e-153eb250705f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{12}" :db/id #edb/ref 17592186266977} {:answer/id #uuid "f0b9b848-8717-52db-b148-c872c7061d08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186268284}] :answer-field/correct {:answer/id #uuid "04ba9a98-d418-5054-94e5-129c6b76bfac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186266186} :answer-field/id #uuid "aa7bd887-2e1e-5f25-8630-dbf79ed567a6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268713}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b8cc1f5d-680d-525d-9686-5ade22a43012" :question/math-academy-id "q-136627" :question/problem "If $sec⁡a=-12,$ then $sec⁡(-a)=$" :question/worked-solution "First, let's recall the graph of $y=sec⁡x.$\n\n![](images/fb/fbf6ef1ca91f998ab4dc2dda1890ffc8a713f2eeff19e5569351b2466256d63a.png)\n\nNotice that our graph is symmetric about the $y$-axis. If we reflect the graph about the $y$-axis, we get the same picture. This means that $sec⁡x$ is an *even* function, and we have\n\n$$\nsec⁡(-x)=sec⁡x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}sec⁡(-a) & =sec⁡a \\\\  & =-12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186269129 :knowledge-point/_questions [{:db/id #edb/ref 17592186176057 :knowledge-point/id #uuid "94645507-186a-54a7-a96b-ccfb0fb1f769" :knowledge-point/title "Utilizing the Evenness Property of the Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a49b518-1242-5538-88d2-11c15ad409a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{10}" :db/id #edb/ref 17592186266511} {:answer/id #uuid "47bd735c-d78a-5fa1-af23-606d585fec22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{10}" :db/id #edb/ref 17592186266785} {:answer/id #uuid "d7848761-d53a-5319-b2fc-3092efadcb6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186268060} {:answer/id #uuid "f7519539-e4d9-5d01-ab39-32fa53d98166" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{10}" :db/id #edb/ref 17592186268336} {:answer/id #uuid "fb6c5ae7-fa41-560e-9dd3-471731162c02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{91}}{10}" :db/id #edb/ref 17592186268367}] :answer-field/correct {:answer/id #uuid "f7519539-e4d9-5d01-ab39-32fa53d98166" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{10}" :db/id #edb/ref 17592186268336} :answer-field/id #uuid "8efb648d-3ab0-5adb-a826-86d01fca5115" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268658}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4dcab682-c7ea-5000-bb2e-9cbc57f39eb0" :question/math-academy-id "q-136629" :question/problem "If $cos⁡x=-\\frac{3}{10},$ then $cos⁡(-x)=$" :question/worked-solution "First, let's recall the graph of $y=cos⁡x.$\n\n![](images/23/2373daf4b5fd26f098bf90e998e2685db6a8b793e94ac9d80b08ea423cb535c0.png)\n\nNotice that our graph is symmetric about the $y$-axis. If we reflect the graph over the $y$-axis, we get the same picture. This means that $cos⁡x$ is an *even* function, and we have\n\n$$\ncos⁡(-x)=cos⁡x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}cos⁡(-x) & =cos⁡x \\\\  & =-\\frac{3}{10}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186269131 :knowledge-point/_questions [{:db/id #edb/ref 17592186176059 :knowledge-point/id #uuid "d4b378b0-30e5-59a8-b9f7-8