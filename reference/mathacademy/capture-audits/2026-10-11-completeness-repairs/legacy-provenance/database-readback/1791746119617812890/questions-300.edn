8-52b5-bb24-657fa38a810c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=6,\\,q=8" :db/id #edb/ref 17592186400932} {:answer/id #uuid "62f6fb47-ecea-56a8-9070-83fc55e7254f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=3,\\,q=-5" :db/id #edb/ref 17592186400933} {:answer/id #uuid "3d43940b-e27a-5dff-9dca-bf6857baf92f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=3,\\,q=5" :db/id #edb/ref 17592186400934} {:answer/id #uuid "bdeaea36-9352-52ca-8483-6b276a77d472" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=6,\\,q=7" :db/id #edb/ref 17592186400935} {:answer/id #uuid "bfc66d56-1a8c-5626-b30a-e9774929570d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=3,\\,q=-4" :db/id #edb/ref 17592186400936}] :answer-field/correct {:answer/id #uuid "3d43940b-e27a-5dff-9dca-bf6857baf92f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=3,\\,q=5" :db/id #edb/ref 17592186400934} :answer-field/id #uuid "95bbc964-13ea-55a0-9065-a7c49f46fb65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400931}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bd1c73ef-6818-5b51-baee-cca065c2f0da" :question/math-academy-id "q-141539" :question/problem "If the expression ${x}^{2}+6x+14$ is written as $(x+p{)}^{2}+q,$ then what are the values of $p$ and $q?$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}+2\\cdot 3x+14\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${3}^{2},$ writing the constant term $14$ last:\n\n$$\n{{x}^{2}+2\\cdot 3x+{3}^{2}}_{⏟}-\\,{3}^{2}+14\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(x+3{)}^{2}-{3}^{2}+14\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n(x+3{)}^{2}+5.\n$$\n\nTherefore, $p=3$ and $q=5.$"}] [{:db/id #edb/ref 17592186272300 :knowledge-point/_questions [{:db/id #edb/ref 17592186184170 :knowledge-point/id #uuid "1481d4a2-64b4-590a-9dbb-c39d3364bb59" :knowledge-point/title "Expressions Containing a Negative Linear Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2209d435-198d-515f-b8b4-60c9562f6bdd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x+\\frac{11}{2})}^{2}-\\frac{9}{2}" :db/id #edb/ref 17592186269560} {:answer/id #uuid "273798d5-f257-5699-8aa9-4f4c2f307f49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x+\\frac{11}{2})}^{2}-\\frac{7}{2}" :db/id #edb/ref 17592186269613} {:answer/id #uuid "3692e43f-c9b5-5ffd-8fc6-a562924ff89c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x-\\frac{11}{2})}^{2}-\\frac{15}{4}" :db/id #edb/ref 17592186269764} {:answer/id #uuid "7a671224-3dde-5038-92af-e145da2474b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x-\\frac{11}{2})}^{2}-\\frac{11}{4}" :db/id #edb/ref 17592186270352} {:answer/id #uuid "8e191cef-1fcc-5bb8-9ab2-aa4afff1bdaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x-\\frac{11}{2})}^{2}-\\frac{21}{4}" :db/id #edb/ref 17592186270499}] :answer-field/correct {:answer/id #uuid "8e191cef-1fcc-5bb8-9ab2-aa4afff1bdaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x-\\frac{11}{2})}^{2}-\\frac{21}{4}" :db/id #edb/ref 17592186270499} :answer-field/id #uuid "1f9eedf2-2e58-52db-8e06-a9079bb28565" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271567}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b33c0ce6-8797-5117-a675-fc9bb0069eae" :question/math-academy-id "q-141552" :question/problem "Complete the square on the quadratic expression ${x}^{2}-11x+25.$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}-2\\cdot \\frac{11}{2}x+25\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${(\\frac{11}{2})}^{2},$ writing the constant term $25$ last:\n\n$$\n{{x}^{2}-2\\cdot \\frac{11}{2}x+{(\\frac{11}{2})}^{2}}_{⏟}-{(\\frac{11}{2})}^{2}+25\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(x-\\frac{11}{2})}^{2}-{(\\frac{11}{2})}^{2}+25\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n{(x-\\frac{11}{2})}^{2}-\\frac{21}{4}.\n$$"}] [{:db/id #edb/ref 17592186272304 :knowledge-point/_questions [{:db/id #edb/ref 17592186068876 :knowledge-point/id #uuid "08c6d8d6-3d86-5074-bf99-0cb744c9412a" :knowledge-point/title "Completing the Square on a Quadratic Expression with a Negative Linear Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b8b2afd-fb57-5e61-8b75-209b9cfb00a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-4{)}^{2}+1" :db/id #edb/ref 17592186269948} {:answer/id #uuid "56189019-79f9-5478-aff6-fce083001fda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-2{)}^{2}-4" :db/id #edb/ref 17592186270032} {:answer/id #uuid "5b5b5397-8f7e-5320-893a-7dfa34d502d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-2{)}^{2}+3" :db/id #edb/ref 17592186270081} {:answer/id #uuid "b8a21ffd-56c6-5136-bf66-bc5dc8d6441d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-2{)}^{2}+6" :db/id #edb/ref 17592186270901} {:answer/id #uuid "e1c6894a-0